#!/usr/bin/env bash
# ───────────────────────────────────────────────────────────────
# COMPONENT: Prepare-Commit-Msg Hook — Machine Trailer Stamper
# ───────────────────────────────────────────────────────────────
# Mints a repository-wide ordinal through the sk-git allocator and appends the
# machine trailer paragraph: `Commit-Id:` always, and `Spec:` only when the
# environment supplies the packet. An amend keeps its existing id, a
# cherry-pick re-mints a fresh one, and a repository that does not ship the
# allocator is left alone.
#
# The hook never blocks a commit: every failure path exits 0, and the commit-msg
# hook still validates whatever the message contains.
#
# Bypass: SPECKIT_SKIP_PREPARE_COMMIT_MSG=1 git commit ...
# Spec:   SPECKIT_COMMIT_SPEC=<track>/<packet>[/<phase>] git commit ...
# Install: bash .opencode/scripts/install-git-hooks.sh
# Uninstall: bash .opencode/scripts/install-git-hooks.sh --uninstall
#
# Exit Codes:
#   0 - Always; a failed stamp must never block the commit

set -euo pipefail

# ───────────────────────────────────────────────────────────────
# 1. GUARDS
# ───────────────────────────────────────────────────────────────

if [[ "${SPECKIT_SKIP_PREPARE_COMMIT_MSG:-0}" = "1" ]]; then
  exit 0
fi

MESSAGE_FILE="${1:-}"
SOURCE="${2:-}"

if [[ -z "$MESSAGE_FILE" || ! -f "$MESSAGE_FILE" ]]; then
  exit 0
fi

# The hook is symlinked machine-wide through the operator's global hooksPath,
# so repository identity decides: only the checkout that ships the allocator is
# stamped, and every other repository exits untouched.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
  exit 0
fi

# >>> source-root selection (identical in every hook script)
# The source tree sits under .skilled or .opencode, and a checkout may carry both, one,
# or an empty placeholder of either. The authored sentinel inside the tree decides,
# never a directory existing, and .skilled wins when both carry it. These scripts run
# for every repository on the machine, so a missing file means either this repository
# ships no toolchain or its install is broken, and the same sentinel tells them apart.
SOURCE_ROOT="$REPO_ROOT/.skilled"
[[ -f "$SOURCE_ROOT/skills/system-spec-kit/SKILL.md" ]] || SOURCE_ROOT="$REPO_ROOT/.opencode"
_in_toolchain_repo() {
  [[ -n "$REPO_ROOT" && -f "$SOURCE_ROOT/skills/system-spec-kit/SKILL.md" ]]
}
# <<< source-root selection
# >>> hook trust (identical in every global hook script)
# These scripts are installed once for every repository on the machine, and the block
# above picks the source tree from the repository the hook fires in. A cloned repository
# controls that tree, so its scripts run only when it shares a git common dir with the
# checkout these hooks live in (that checkout or one of its worktrees), or when its local
# config sets skilled.trustRepoHooks=true. Local config is never cloned, and command-line
# or environment config does not count, so a repository cannot opt itself in. An
# untrusted repository is treated as one without the toolchain.
_trust_self="${BASH_SOURCE[0]}"
while [[ -L "$_trust_self" ]]; do
  _trust_link="$(readlink "$_trust_self")"
  case "$_trust_link" in /*) _trust_self="$_trust_link" ;; *) _trust_self="$(dirname "$_trust_self")/$_trust_link" ;; esac
done
_hook_common="$(cd "$(dirname "$_trust_self")" 2>/dev/null && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
_repo_common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [[ -n "$REPO_ROOT" && ( -z "$_hook_common" || "$_hook_common" != "$_repo_common" ) ]] \
  && [[ "$(git config --local --bool skilled.trustRepoHooks 2>/dev/null || true)" != "true" ]]; then
  SOURCE_ROOT="$REPO_ROOT/.skilled-untrusted"
fi
# <<< hook trust

ALLOCATOR="$SOURCE_ROOT/skills/sk-git/scripts/commit-id-naming.sh"
if [[ ! -f "$ALLOCATOR" ]]; then
  if _in_toolchain_repo; then
    printf 'prepare-commit-msg: allocator is missing: %s; leaving the message unstamped.\n' "$ALLOCATOR" >&2
  fi
  exit 0
fi

# A cherry-pick copies an id that already belongs to the picked commit. git keeps
# CHERRY_PICK_HEAD while a pick is pending, and passes source "message" for a clean
# pick and "merge" when a conflicted pick is continued, so it is checked first.
CHERRY_PICK=0
if git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then
  CHERRY_PICK=1
fi

# Git generates merge and squash messages itself; they stay untouched. A continued
# cherry-pick also arrives as "merge" and is re-addressed below.
case "$SOURCE" in
  merge|squash)
    (( CHERRY_PICK == 1 )) || exit 0
    ;;
esac

# ───────────────────────────────────────────────────────────────
# 2. MESSAGE ANALYSIS
# ───────────────────────────────────────────────────────────────

# Trailing comment lines move below the trailer block. core.commentChar can
# replace the default '#', and 'auto' lets git pick one, where '#' stays safe.
COMMENT_CHAR="$(git config --get core.commentChar 2>/dev/null || true)"
case "$COMMENT_CHAR" in
  ""|auto)
    COMMENT_CHAR="#"
    ;;
esac

# git drops comment lines only when it opened an editor, whose hint block always
# carries a line holding just the comment character, or when commit.cleanup is
# strip. A -m or -F message keeps them, so there they are body text, not comments.
CLEANUP="$(git config --get commit.cleanup 2>/dev/null || true)"

# `git commit -v` appends the diff below a scissors line. That region is git's
# scratch space, so it must stay below the stamped paragraph; appending past it
# would let the cleanup step discard the keys together with the diff.
SCISSORS_LINE="$COMMENT_CHAR ------------------------ >8 ------------------------"

# Attribution keys a runtime can append to the pending message. The hook drops
# these lines before it stamps, so no commit object receives one, and says so.
# Nothing else is removed: any other line naming the vendor stays, and the
# commit-msg validator reports it with a reason the author can act on.
# The list mirrors attribution.forbiddenKeys in the sk-git commit template. The
# hook stays node-free, so it cannot read the template; message-contract.test.mjs
# fails when the two lists differ.
FORBIDDEN_KEY_RE='^(Co-Authored-By|Claude-Session):'

LINES=()
while IFS= read -r line || [[ -n "$line" ]]; do
  LINES[${#LINES[@]}]="$line"
done < "$MESSAGE_FILE"
LINE_COUNT=${#LINES[@]}

TAIL_START="$LINE_COUNT"
index=0
while (( index < LINE_COUNT )); do
  if [[ "${LINES[$index]}" = "$SCISSORS_LINE" ]]; then
    TAIL_START="$index"
    break
  fi
  index=$((index + 1))
done

STRIP_COMMENTS=0
case "$CLEANUP" in
  strip)
    STRIP_COMMENTS=1
    ;;
  ""|default)
    index=0
    while (( index < LINE_COUNT )); do
      if [[ "${LINES[$index]}" = "$COMMENT_CHAR" || "${LINES[$index]}" = "$SCISSORS_LINE" ]]; then
        STRIP_COMMENTS=1
        break
      fi
      index=$((index + 1))
    done
    ;;
esac

COMMENT_START="$TAIL_START"
while (( STRIP_COMMENTS == 1 && COMMENT_START > 0 )); do
  previous=$((COMMENT_START - 1))
  if [[ "${LINES[$previous]}" = "$COMMENT_CHAR"* ]]; then
    COMMENT_START="$previous"
  else
    break
  fi
done

# Trailing blank lines are dropped here and re-added as the separator below.
REAL_END="$COMMENT_START"
while (( REAL_END > 0 )); do
  previous=$((REAL_END - 1))
  if [[ -z "${LINES[$previous]//[[:space:]]/}" ]]; then
    REAL_END="$previous"
  else
    break
  fi
done

# A message that is empty apart from comments is left alone; git aborts it.
if (( REAL_END == 0 )); then
  exit 0
fi

# Cherry-pick copies are re-addressed: drop every copied id from the real body.
# Attribution a runtime appended is dropped here too, before anything is stamped.
REAL=()
REAL_COUNT=0
FORBIDDEN_FOUND=0
index=0
while (( index < REAL_END )); do
  line="${LINES[$index]}"
  if (( CHERRY_PICK == 1 )) && [[ "$line" = Commit-Id:* ]]; then
    index=$((index + 1))
    continue
  fi
  # The subject line is never attribution, whatever it starts with.
  if (( index > 0 )) && [[ "$line" =~ $FORBIDDEN_KEY_RE ]]; then
    FORBIDDEN_FOUND=1
    printf 'prepare-commit-msg: removed attribution line: %s\n' "$line" >&2
    index=$((index + 1))
    continue
  fi
  REAL[REAL_COUNT]="$line"
  REAL_COUNT=$((REAL_COUNT + 1))
  index=$((index + 1))
done

# Dropping copied ids can expose blank lines that no longer separate anything.
while (( REAL_COUNT > 0 )); do
  previous=$((REAL_COUNT - 1))
  if [[ -z "${REAL[$previous]//[[:space:]]/}" ]]; then
    REAL_COUNT=$((REAL_COUNT - 1))
  else
    break
  fi
done

# ───────────────────────────────────────────────────────────────
# 3. STAMPING DECISION
# ───────────────────────────────────────────────────────────────

HAS_SPEC=0
HAS_COMMIT_ID=0
index=0
while (( index < REAL_COUNT )); do
  case "${REAL[$index]}" in
    Spec:*)
      HAS_SPEC=1
      ;;
    Commit-Id:*)
      HAS_COMMIT_ID=1
      ;;
  esac
  index=$((index + 1))
done

REQUIRE_ID=0
if (( CHERRY_PICK == 1 || HAS_COMMIT_ID == 0 )); then
  REQUIRE_ID=1
fi

# Nothing guesses a packet: Spec is stamped only when the environment provides
# its value and the message does not carry one already.
REQUIRE_SPEC=0
if [[ -n "${SPECKIT_COMMIT_SPEC:-}" && "$HAS_SPEC" -eq 0 ]]; then
  # The value lands on a trailer line verbatim, so it must be one packet path and
  # nothing that could open a second line or a second key.
  if [[ "$SPECKIT_COMMIT_SPEC" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
    REQUIRE_SPEC=1
  else
    printf 'prepare-commit-msg: SPECKIT_COMMIT_SPEC is not a packet path; Spec not stamped.\n' >&2
  fi
fi

if (( REQUIRE_ID == 0 && REQUIRE_SPEC == 0 && FORBIDDEN_FOUND == 0 )); then
  exit 0
fi

NEW_ID=""
if (( REQUIRE_ID == 1 )); then
  if ! NEW_ID="$(bash "$ALLOCATOR" allocate 2>/dev/null)"; then
    printf 'prepare-commit-msg: allocator failed; leaving the message unstamped.\n' >&2
    exit 0
  fi
fi

# ───────────────────────────────────────────────────────────────
# 4. REWRITE
# ───────────────────────────────────────────────────────────────

# A trailing run of machine keys is the existing trailer paragraph: append to
# it. Anything else is prose that needs exactly one blank line of separation.
BLOCK_START="$REAL_COUNT"
while (( BLOCK_START > 0 )); do
  previous=$((BLOCK_START - 1))
  case "${REAL[$previous]}" in
    Spec:*|Commit-Id:*)
      BLOCK_START="$previous"
      ;;
    *)
      break
      ;;
  esac
done

NEEDS_BLANK=0
if (( REAL_COUNT > 0 && BLOCK_START == REAL_COUNT )); then
  NEEDS_BLANK=1
fi

TMP_MESSAGE="$(mktemp "${MESSAGE_FILE}.stamp.XXXXXX" 2>/dev/null || true)"
if [[ -z "$TMP_MESSAGE" ]]; then
  printf 'prepare-commit-msg: could not create a temporary file; leaving the message unstamped.\n' >&2
  exit 0
fi

# Write the stamped message beside the original and swap it in, so a write
# failure never leaves a half-written commit message behind.
write_stamped_message() {
  local position

  position=0
  while (( position < BLOCK_START )); do
    printf '%s\n' "${REAL[$position]}" >> "$TMP_MESSAGE" || return 1
    position=$((position + 1))
  done

  if (( NEEDS_BLANK == 1 )); then
    printf '\n' >> "$TMP_MESSAGE" || return 1
  fi

  if (( REQUIRE_SPEC == 1 )); then
    printf 'Spec: %s\n' "$SPECKIT_COMMIT_SPEC" >> "$TMP_MESSAGE" || return 1
  fi

  while (( position < REAL_COUNT )); do
    printf '%s\n' "${REAL[$position]}" >> "$TMP_MESSAGE" || return 1
    position=$((position + 1))
  done

  if (( REQUIRE_ID == 1 )); then
    printf 'Commit-Id: %s\n' "$NEW_ID" >> "$TMP_MESSAGE" || return 1
  fi

  position="$COMMENT_START"
  while (( position < TAIL_START )); do
    printf '%s\n' "${LINES[$position]}" >> "$TMP_MESSAGE" || return 1
    position=$((position + 1))
  done

  position="$TAIL_START"
  while (( position < LINE_COUNT )); do
    printf '%s\n' "${LINES[$position]}" >> "$TMP_MESSAGE" || return 1
    position=$((position + 1))
  done

  return 0
}

if write_stamped_message && mv -f "$TMP_MESSAGE" "$MESSAGE_FILE"; then
  exit 0
fi

rm -f "$TMP_MESSAGE" 2>/dev/null || true
printf 'prepare-commit-msg: could not write the stamped message; leaving it unstamped.\n' >&2
exit 0
