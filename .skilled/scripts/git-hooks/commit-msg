#!/usr/bin/env bash
# ───────────────────────────────────────────────────────────────
# COMPONENT: Commit-Msg Hook — Template Contract Gate
# ───────────────────────────────────────────────────────────────
# Blocks a commit whose message breaks the rules the repository's own commit
# template declares. The rules are not in this file: they live in the
# "Enforced rules" JSON block of the repository's commit-message-template.md,
# and validate-message.mjs reads that block for whichever repository is being
# committed to. Editing the template changes what is enforced here.
#
# The hook is symlinked machine-wide through the global hooksPath, so the
# validator is found next to this script, never inside the target repository,
# unless the target is a linked worktree of the hook's own repository.
# A repository whose templates declare no rules block is not checked.
#
# There is no bypass switch. `git commit --no-verify` skips every hook, which no
# hook can prevent, so the pre-push hook and CI re-check each pushed commit.
#
# Install: bash .opencode/scripts/install-git-hooks.sh
# Uninstall: bash .opencode/scripts/install-git-hooks.sh --uninstall
#
# Exit Codes:
#   0 - message passes, or the repository declares no commit rules
#   1 - message breaks the contract, or the contract cannot be read

set -euo pipefail

MESSAGE_FILE="${1:-}"
if [[ -z "$MESSAGE_FILE" || ! -f "$MESSAGE_FILE" ]]; then
  printf 'BLOCKED: commit-msg hook received no readable message file.\n' >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
  exit 0
fi

# ───────────────────────────────────────────────────────────────
# 1. LOCATE THE VALIDATOR
# ───────────────────────────────────────────────────────────────

# The global hooks dir links each hook here, so the helpers and the validator
# resolve beside the real script.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link="$(readlink "$_self")"
  case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
done
HOOK_DIR="$(cd "$(dirname "$_self")" && pwd -P)"

if [[ ! -f "$HOOK_DIR/lib/message-contract-gate.sh" ]]; then
  printf 'BLOCKED: commit-msg helpers are missing at %s/lib; re-run: bash .opencode/scripts/install-git-hooks.sh\n' "$HOOK_DIR" >&2
  exit 1
fi
# shellcheck source=lib/message-contract-gate.sh
. "$HOOK_DIR/lib/message-contract-gate.sh"
VALIDATOR="$(mcg_validator_path "$HOOK_DIR" "$REPO_ROOT")"

# The stamper never blocks, so a failed or skipped stamp would otherwise reach
# history unnoticed. A real merge, the one commit git leaves MERGE_HEAD for, is
# exempt as the stamper leaves it alone.
if [[ ! -f "$HOOK_DIR/lib/commit-id-policy.sh" ]]; then
  printf 'BLOCKED: commit-msg helpers are missing at %s/lib; re-run: bash .opencode/scripts/install-git-hooks.sh\n' "$HOOK_DIR" >&2
  exit 1
fi
# shellcheck source=lib/commit-id-policy.sh
. "$HOOK_DIR/lib/commit-id-policy.sh"
if cip_repo_wants_ids "$REPO_ROOT" \
   && ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 \
   && ! cip_message_has_id "$MESSAGE_FILE"; then
  printf 'BLOCKED: this repository requires a Commit-Id trailer, and the prepare-commit-msg hook did not stamp one.\n' >&2
  printf 'Its message above says why. Commit again once that is fixed; never type the id by hand.\n' >&2
  printf 'To exempt this repository: git config --local skilled.commitId false\n' >&2
  exit 1
fi

# Without node or the validator the rules cannot be read. That only matters in a
# repository that declares rules, so the block is limited to those.
UNAVAILABLE="$(mcg_unavailable_reason "$VALIDATOR")"
if [[ -n "$UNAVAILABLE" ]]; then
  if mcg_repo_declares_rules "$REPO_ROOT" commit-message-template.md; then
    printf 'BLOCKED: this repository declares commit rules, but %s.\n' "$UNAVAILABLE" >&2
    printf 'Install Node 20+ or re-run: bash .opencode/scripts/install-git-hooks.sh\n' >&2
    exit 1
  fi
  exit 0
fi

# ───────────────────────────────────────────────────────────────
# 2. VALIDATE
# ───────────────────────────────────────────────────────────────

if node "$VALIDATOR" --repo "$REPO_ROOT" --commit "$MESSAGE_FILE"; then
  exit 0
fi
exit 1
