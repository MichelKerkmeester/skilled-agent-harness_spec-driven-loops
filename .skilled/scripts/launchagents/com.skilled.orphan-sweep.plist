<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Orphan MCP sweeper LaunchAgent - TEMPLATE ONLY.

	  This file is NOT installed or loaded by default. It lives in-repo as a
	  reviewable template. To activate (operator-approved rollout only, AFTER
	  reviewing dry-run output on this machine), copy it from the repository
	  root while filling in the two path placeholders, then load the copy:

	    sed -e "s#/absolute/path/to/repo#$(git rev-parse --show-toplevel)#g" \
	        -e "s#/absolute/path/to/home#$HOME#g" \
	        .opencode/scripts/launchagents/com.skilled.orphan-sweep.plist \
	        > ~/Library/LaunchAgents/com.skilled.orphan-sweep.plist
	    launchctl load ~/Library/LaunchAgents/com.skilled.orphan-sweep.plist

	  This template runs the sweeper in --dry-run mode, so loading it as-is is
	  non-destructive: it logs the kill/remove decisions it WOULD make without
	  killing any PID or deleting any /tmp file. To make it actually reap, an
	  operator must remove the <string>--dry-run</string> entry below.

	  /absolute/path/to/repo and /absolute/path/to/home are placeholders for the
	  repository root and the home directory. launchd requires absolute paths
	  (no ~ or $HOME expansion in plists), so the installed copy must carry real
	  ones.
	-->

	<key>Label</key>
	<string>com.skilled.orphan-sweep</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/absolute/path/to/repo/.opencode/scripts/orphan-mcp-sweeper.sh</string>
		<string>--dry-run</string>
		<string>--verbose</string>
		<string>--log-path</string>
		<string>/absolute/path/to/home/.local/share/orphan-sweeper.log</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/absolute/path/to/repo</string>

	<!-- Run every 600 seconds, matching the documented template cadence. -->
	<key>StartInterval</key>
	<integer>600</integer>

	<!-- Template posture: do not fire on load; operator activates deliberately. -->
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>/absolute/path/to/home/.local/share/orphan-sweeper.launchd.out.log</string>

	<key>StandardErrorPath</key>
	<string>/absolute/path/to/home/.local/share/orphan-sweeper.launchd.err.log</string>

	<!-- Low-impact background scheduling for a periodic maintenance sweep. -->
	<key>ProcessType</key>
	<string>Background</string>

	<key>LowPriorityIO</key>
	<true/>

	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
