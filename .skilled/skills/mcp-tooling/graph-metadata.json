    "depends_on": [
      {
        "target": "mcp-code-mode",
        "weight": 0.7,
        "context": "External cross-skill dependency: mcp-code-mode is the shared execution substrate for the nine Code Mode-backed members (mcp-chrome-devtools, mcp-click-up, mcp-obsidian, mcp-aside-devtools, mcp-notion, mcp-figma, mcp-refero, mcp-mobbin, and mcp-magicpath). mcp-code-mode serves consumers beyond this hub and is not a hub member."
      }
    ],
    "enhances": [
      {
        "target": "sk-code",
        "weight": 0.5,
        "context": "Union of all nine mode contributions to sk-code implementation: browser debugging from mcp-chrome-devtools, task-management context from mcp-click-up, Obsidian vault and markdown-note context from mcp-obsidian, agentic-browser evidence from mcp-aside-devtools, Notion workspace and data-source context from mcp-notion, Figma exports from mcp-figma, and real-app UI reference research from mcp-refero and mcp-mobbin. mcp-magicpath supplies read-only component and design-system evidence."
      }
    ],
    "siblings": [
      {
        "target": "sk-design",
        "weight": 0.45,
        "context": "Cross-hub sibling: mcp-figma reads design context from Figma Desktop while sk-design's EXTRACT mode sources from live URLs, with DESIGN.md output overlap."
      },
      {
        "target": "cli-orca",
        "weight": 0.4,
        "context": "Orca owns its runtime transport while this hub owns external MCP bridges"
      }
