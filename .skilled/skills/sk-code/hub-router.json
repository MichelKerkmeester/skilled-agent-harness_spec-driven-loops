{
  "skill": "sk-code",
  "version": "2.4.0.0",
  "routerPolicy": {
    "defaultMode": null,
    "ambiguityDelta": 1,
    "tieBreak": ["sk-code-quality", "sk-code-review", "sk-code-ci", "sk-code-skilled"],
    "outcomes": {
      "single": "one dominant code intent routes to one workflow mode",
      "orderedBundle": "clearly separate code intents route to an ordered workflow-mode list",
      "surfaceBundle": "one workflow mode primary plus zero-or-more surface packets as read-only evidence, workflow ordered first then surfaces",
      "defer": "unclear or contradictory code intent asks for disambiguation"
    },
    "defaultResource": ["shared/README.md"],
    "defaultResourceSemantics": "fallback-only",
    "defaultResourceContract": "A scored route assembles exactly the selected mode's declared resources. defaultResource is consulted only when no mode scores (zero-signal branch), and then only as the defer-time suggestion offered with the disambiguation checklist. It is a distinct concept from the stage-two DEFAULT_RESOURCE preamble ROUTER.md declares: this array is the zero-signal fallback, that one is the always-loaded preamble.",
    "discoveryClasses": ["hub-identity"],
    "discoveryClassesContract": "Classes listed here are hub discovery/defer evidence only. They are intentionally referenced by NO mode's scoring classes: hub-identity vocabulary describes the router itself, so a prompt carrying only it scores zero modes and defers instead of bundling every workflow mode and surface at once."
  },
  "routerSignals": {
    "sk-code-quality": {
      "weight": 4,
      "classes": ["quality-aliases", "quality-gates", "quality-restraint"],
      "resources": ["sk-code-quality/SKILL.md"]
    },
    "sk-code-review": {
      "weight": 4,
      "classes": ["code-review-aliases", "code-review-findings", "code-review-security", "code-review-pr"],
      "resources": ["sk-code-review/SKILL.md"]
    },
    "sk-code-skilled": {
      "weight": 4,
      "classes": ["code-skilled-aliases", "code-skilled-runtime", "code-skilled-authoring"],
      "resources": ["sk-code-skilled/SKILL.md"]
    },
    "sk-code-ci": {
      "weight": 4,
      "classes": ["code-ci-aliases", "code-ci-runtime"],
      "resources": ["sk-code-ci/SKILL.md"]
    }
  },
  "vocabularyClasses": {
