{
  "name": "@utcp/code-mode-mcp",
  "version": "1.0.9",
  "description": "Model Context Protocol (MCP) server for UTCP Code Mode - Execute TypeScript code with direct tool access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-bridge": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "postinstall": "node scripts/check-node.cjs"
  },
  "keywords": [
    "utcp",
    "mcp",
    "code-mode",
    "typescript",
    "model-context-protocol",
    "universal-tool-calling-protocol",
    "bridge",
    "tools",
    "ai",
    "code-execution"
  ],
  "author": "UTCP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/universal-tool-calling-protocol/utcp-mcp.git"
  },
  "homepage": "https://github.com/universal-tool-calling-protocol/utcp-mcp#readme",
  "bugs": {
    "url": "https://github.com/universal-tool-calling-protocol/utcp-mcp/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "hono": "^4.13.5",
    "@hono/node-server": "^1.19.13",
    "path-to-regexp": "^8.4.0",
    "axios": "^1.15.0",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@utcp/cli": "^1.0.12",
    "@utcp/code-mode": "^1.0.5",
    "@utcp/dotenv-loader": "^1.0.0",
    "@utcp/file": "^1.0.0",
    "@utcp/http": "^1.0.13",
    "@utcp/mcp": "^1.0.16",
    "@utcp/sdk": "^1.0.16",
    "@utcp/text": "^1.0.12",
    "dotenv": "^16.0.0",
    "zod": "^3.22.0"
  }
}
