{
  "skill": "cli-classifier",
  "version": "0.8.9.0",
  "routerPolicy": {
    "defaultMode": null,
    "ambiguityDelta": 1,
    "tieBreak": ["cli-jev"],
    "outcomes": {
      "single": "a dominant Jev judgment intent routes to the cli-jev transport",
      "orderedBundle": "the hub currently registers one mode; a future classifier can join as a new mode with explicit bundle rules",
      "defer": "unclear or contradictory intent asks for disambiguation"
    },
    "defaultResource": ["ROUTER.md", "mode-registry.json"],
    "bundleRules": []
  },
  "routerSignals": {
    "cli-jev": {
      "weight": 4,
      "classes": ["cli-jev-aliases", "jev-dispatch"],
      "resources": ["cli-jev/SKILL.md"]
    }
  },
  "vocabularyClasses": {
    "cli-jev-aliases": {
      "keywords": [
        "jev cli",
        "jev judgment",
        "typesafe jev",
        "type-safe jev",
        "cli-jev",
        "cli jev",
        "cli-usage",
        "jev probability judgment",
        "typed judgment cli"
      ]
    },
    "jev-dispatch": {
      "keywords": [
        "jev dispatch",
        "jev noul",
        "jev choice",
        "jev score",
        "jev urgency check",
        "jev yes or no",
        "jev probability",
        "jev run",
        "jev mcp",
        "expose jev",
        "jev judgment call",
        "run jev",
        "ask jev",
        "use jev",
        "with jev",
        "through jev",
        "does jev use",
        "jev provider",
        "jev openrouter",
        "jev model",
        "jev auth",
        "jev question",
        "jev pick one",
        "jev options",
        "jev batch"
      ]
    }
  }
}
