#!/usr/bin/env bash
# Compatibility helper retained for direct legacy invocations.
# The installed Git hook is .opencode/scripts/git-hooks/pre-commit.
# Blocks commits that add ephemeral-artifact pointers to code comments.
# See: .opencode/skills/sk-code/shared/references/universal/code-style-guide.md §4
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# >>> source-root selection (identical in every hook script)
# The source tree sits under .skilled or .opencode, and a checkout may carry both, one,
# or an empty placeholder of either. The authored sentinel inside the tree decides,
# never a directory existing, and .skilled wins when both carry it. These scripts run
# for every repository on the machine, so a missing file means either this repository
# ships no toolchain or its install is broken, and the same sentinel tells them apart.
SOURCE_ROOT="$REPO_ROOT/.skilled"
[[ -f "$SOURCE_ROOT/skills/system-spec-kit/SKILL.md" ]] || SOURCE_ROOT="$REPO_ROOT/.opencode"
_in_toolchain_repo() {
  [[ -n "$REPO_ROOT" && -f "$SOURCE_ROOT/skills/system-spec-kit/SKILL.md" ]]
}
# <<< source-root selection

# shared hook kill-switch (master + per-concern); fail-open if guard absent
if [ -n "$REPO_ROOT" ] && [ -r "$SOURCE_ROOT/hooks/shared/hook-flags.sh" ]; then
  . "$SOURCE_ROOT/hooks/shared/hook-flags.sh"
  hook_enabled git-commit-hooks || exit 0
fi

CHECKER_PATH="$SOURCE_ROOT/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh"

if [[ ! -x "$CHECKER_PATH" ]]; then
  if _in_toolchain_repo; then
    echo "BLOCKED: comment hygiene checker is missing or not executable: $CHECKER_PATH" >&2
    exit 1
  fi
  echo "WARNING: comment hygiene checker not found at $CHECKER_PATH — skipping check" >&2
  exit 0
fi

# The staged blobs go to one checker run, with NUL-separated names, so a fix left
# unstaged cannot hide a violation and a path with non-ASCII bytes is not skipped.
HYGIENE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/comment-hygiene.XXXXXX")"
trap 'rm -rf "$HYGIENE_DIR"' EXIT
HYGIENE_FILES=()
while IFS= read -r -d '' file; do
  mkdir -p "$HYGIENE_DIR/$(dirname "$file")"
  if ! git show ":$file" > "$HYGIENE_DIR/$file" 2>/dev/null; then
    # A submodule entry has no blob to read. Any other unreadable file must not pass unchecked.
    [[ "$(git ls-files -s -- "$file" | cut -c1-6)" == "160000" ]] && continue
    echo "BLOCKED [gate:comment-hygiene]: could not read the staged content of $file" >&2
    exit 1
  fi
  HYGIENE_FILES+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACM)
CHECKER_RC=0
if [[ "${#HYGIENE_FILES[@]}" -gt 0 ]]; then
  (cd "$HYGIENE_DIR" && "$CHECKER_PATH" "${HYGIENE_FILES[@]}" 2>/dev/null) || CHECKER_RC=$?
fi
rm -rf "$HYGIENE_DIR"

if [[ $CHECKER_RC -eq 1 ]]; then
  echo ""
  echo "BLOCKED: staged files contain ephemeral-artifact pointers in code comments."
  echo "See: .opencode/skills/sk-code/shared/references/universal/code-style-guide.md §4"
  echo "Fix: replace the pointer with the durable WHY. Escape: add '// hygiene-ok' to exempt a line."
  exit 1
fi

# Exit 2 means no staged file was checkable. Anything above it is the checker itself
# failing, and a check that did not run is not a clean commit.
if [[ $CHECKER_RC -gt 2 ]]; then
  echo "" >&2
  echo "BLOCKED: the comment hygiene checker failed (exit $CHECKER_RC): $CHECKER_PATH" >&2
  echo "Fix the checker, then commit again." >&2
  exit 1
fi

# Agent mirror-sync gate (independent of comment hygiene)
# Agents are authored in .opencode/agents/ and mirrored to .claude.
# Block a commit that desyncs the mirrors. Only STAGED agent files are checked,
# so commits that touch no agents are never affected by this gate.
MIRROR_CHECKER="$SOURCE_ROOT/skills/system-deep-loop/deep-improvement/scripts/check-agent-mirror-sync.cjs"

STAGED_AGENTS=()
while IFS= read -r file; do
  [[ -n "$file" ]] && STAGED_AGENTS+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMD | grep -E '^\.(opencode|skilled|claude)/agents/' || true)

if [[ ${#STAGED_AGENTS[@]} -gt 0 ]]; then
  if [[ ! -f "$MIRROR_CHECKER" ]] && _in_toolchain_repo; then
    echo "BLOCKED: agent mirror-sync checker is missing: $MIRROR_CHECKER" >&2
    exit 1
  elif ! command -v node >/dev/null 2>&1 || [[ ! -f "$MIRROR_CHECKER" ]]; then
    echo "WARNING: node or agent mirror-sync checker unavailable — skipping mirror gate" >&2
  elif ! node "$MIRROR_CHECKER" "${STAGED_AGENTS[@]}"; then
    echo ""
    echo "BLOCKED: staged agent files desync the .opencode / .claude mirrors."
    echo "Fix: re-sync the mirrors so each agent body matches, then re-stage."
    exit 1
  fi
fi

exit 0
