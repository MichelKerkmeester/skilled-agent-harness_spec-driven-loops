# Hook kill-switch config — copy to hook-flags.env and uncomment what you want OFF.
#
#   cp .opencode/hooks/hook-flags.env.example .opencode/hooks/hook-flags.env
#
# Every hook is ON by default. Setting a flag to a truthy value (1 / true / yes / on,
# case-insensitive) disables that hook. hook-flags.env is gitignored, so your
# choices stay local. A real environment variable overrides the file, so you can
# re-enable a file-disabled hook for one session with e.g. SYSTEM_SKILL_ADVISOR_DISABLED=0.
#
# Read by .opencode/hooks/shared/hook-flags.{cjs,mjs,ts,sh}. The canonical index of
# every concern and flag lives in .opencode/hooks/README.md.

# ── Master switch — disables ALL repo-authored hooks at once ──
# SYSTEM_HOOKS_DISABLED=1

# ── Per-concern switches (alphabetical) ──
# CODEX_WATCHDOG_DISABLED=1        # codex hooks watchdog
# SYSTEM_COMPLETION_DISABLED=1            # completion-evidence checks + sentinel
# SYSTEM_DIRECTIVE_LIFECYCLE_DISABLED=1   # directive lifecycle boundary
# SYSTEM_DISPATCH_DISABLED=1              # CLI dispatch audit trail
# SYSTEM_DIST_FRESHNESS_DISABLED=1        # compiled dist staleness check
# SYSTEM_GIT_COMMIT_HOOKS_DISABLED=1      # pre-commit chain EMERGENCY off (also bypasses mass-deletion guard + comment-hygiene)
# SYSTEM_GIT_HOOKS_CHECK_DISABLED=1       # git hook symlink validity check
# SK_GIT_PREFLIGHT_DISABLED=1         # git preflight advisory
# OPENCODE_GOAL_DISABLED=1                  # session goal tracking
# SYSTEM_HOOK_INSTALL_DISABLED=1          # codex hook installer
# SYSTEM_LIVE_FOLLOW_DISABLED=1           # live-sync IDE follower auto-start
# SYSTEM_LIVE_SYNC_DISABLED=1             # whole live-sync loop (publish + auto-follow + self-heal install)
# MCP_ROUTE_GUARD_DISABLED=1       # MCP route guard
# SYSTEM_PERMISSION_POLICY_DISABLED=1     # devin permission-request policy
# SK_CODE_POST_EDIT_QUALITY_DISABLED=1     # post-edit quality checks on writes
# SYSTEM_SESSION_CLEANUP_DISABLED=1       # stop-hook orphan/session cleanup
# SYSTEM_SESSION_LIFECYCLE_DISABLED=1     # session start/stop/compact lifecycle hooks
# SYSTEM_SKILL_ADVISOR_DISABLED=1         # skill-advisor brief on your prompts
# SYSTEM_SPEC_GATE_DISABLED=1             # spec-folder Gate-3 prompt (deny is separately scoped by SYSTEM_SPEC_GATE_ENFORCE)
# SYSTEM_TASK_DISPATCH_DISABLED=1         # deep-loop / task dispatch guard
# SYSTEM_GIT_WORKTREE_GUARD_DISABLED=1    # shared-checkout worktree warning (pre-rename alias: SYSTEM_WORKTREE_GUARD_DISABLED)
