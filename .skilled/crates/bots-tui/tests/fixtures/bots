#!/usr/bin/env bash
# Fake bots CLI for the crate's tests.
#
# Prints canned payloads instead of reading a real index, so a test never
# needs the runtime, a state folder or a live schedule. The payloads sit in
# the payloads folder beside this script.
#
# A chat send appends to chat-appended.jsonl beside the log, and the transcript
# reads it back, so a test sees what it sent on the next call.
#
# Usage:
#   bash bots [--fixture-log FILE] [--fixture-scenario NAME] VERB [ARGS...]
#
# Scenarios:
#   ok                answer normally, the default
#   slow              sleep two seconds then answer normally
#   hold-answer       answer logs how its stdout and stderr are open, sleeps two seconds, then answers
#   slow-hold-answer  reads sleep two seconds first, answer as in hold-answer
#   fail-VERB         exit 1 with "bots: index locked" for that one verb
#   refuse-REASON     exit 4 with "bots: REASON" when the verb is answer
#   empty             the four read verbs print empty payloads
#   warn              inbox prints its payload plus a did-not-read warning
#   chat-empty        chat --transcript prints the empty transcript
#   chat-refuse-REASON  chat --message exits 4 with "bots: REASON"
#   chat-usage        chat --message exits 2 with an empty-message error
#   chat-sleep        chat --message sleeps a minute then answers
#   chat-slow         chat --message sleeps two seconds then answers
#   chat-park         chat --message appends a needs-you reply and exits 5
#   chat-fail         chat --message appends a failed reply and exits 1
#
# Any other scenario name answers normally.

set -u

LOG=""
SCENARIO="ok"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --fixture-log|--fixture-scenario)
      if [ "$#" -lt 2 ]; then
        break
      fi
      if [ "$1" = "--fixture-log" ]; then
        LOG="$2"
      else
        SCENARIO="$2"
      fi
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

VERB="${1-}"

# Record the call before anything can fail or stall, so a test still sees
# what was asked for.
if [ -n "$LOG" ]; then
  printf '%s\n' "$*" >> "$LOG"
fi

PAYLOADS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/payloads"

ok_answer() {
  case "$VERB" in
    status)
      cat "$PAYLOADS/status.json"
      ;;
    activity)
      cat "$PAYLOADS/activity.json"
      ;;
    inbox)
      cat "$PAYLOADS/inbox.json"
      ;;
    routines)
      cat "$PAYLOADS/routines.json"
      ;;
    answer)
      printf 'bots: answered\n'
      ;;
    *)
      printf 'bots: unknown verb: %s\n' "$VERB" >&2
      exit 2
      ;;
  esac
  exit 0
}

if [ "$SCENARIO" = "hold-answer" ] || [ "$SCENARIO" = "slow-hold-answer" ]; then
  if [ "$VERB" = "answer" ]; then
    # Tested on the fd itself, never inside a command substitution, which would
    # make stdout a pipe of its own.
    if [ /dev/fd/1 -ef /dev/null ]; then OUT_FD="null"; else OUT_FD="open"; fi
    if [ /dev/fd/2 -ef /dev/null ]; then ERR_FD="null"; else ERR_FD="open"; fi
    if [ -n "$LOG" ]; then
      printf 'fixture-fds stdout=%s stderr=%s\n' "$OUT_FD" "$ERR_FD" >> "$LOG"
      printf 'fixture-answer-started\n' >> "$LOG"
    fi
    sleep 2
    if [ -n "$LOG" ]; then
      printf 'fixture-answer-done\n' >> "$LOG"
    fi
    printf 'bots: answered\n'
    exit 0
  fi
  if [ "$SCENARIO" = "slow-hold-answer" ]; then
    sleep 2
  fi
  SCENARIO="ok"
fi

if [ "$SCENARIO" = "slow" ]; then
  sleep 2
  SCENARIO="ok"
fi

if [ "$SCENARIO" = "fail-$VERB" ]; then
  printf 'bots: index locked\n' >&2
  exit 1
fi

if [ "${SCENARIO#refuse-}" != "$SCENARIO" ] && [ "$VERB" = "answer" ]; then
  printf 'bots: %s\n' "${SCENARIO#refuse-}" >&2
  exit 4
fi

if [ "$SCENARIO" = "empty" ]; then
  case "$VERB" in
    status)
      printf '%s\n' '{"version":1,"indexPath":"/tmp/bots-tui-fixture/status.sqlite","builtAt":null,"updatedAt":null,"stale":false,"staleIdentities":[],"rows":[],"duplicateRoots":[],"notes":[]}'
      exit 0
      ;;
    activity)
      printf '%s\n' '{"version":1,"groups":[]}'
      exit 0
      ;;
    inbox)
      printf '%s\n' '{"version":1,"items":[]}'
      exit 0
      ;;
    routines)
      printf '%s\n' '{"version":1,"routines":[]}'
      exit 0
      ;;
  esac
fi

if [ "$SCENARIO" = "warn" ] && [ "$VERB" = "inbox" ]; then
  cat "$PAYLOADS/inbox.json"
  printf 'bots: item 20261124T090000Z-0badf00d did not read\n' >&2
  exit 0
fi

# A chat send appends to chat-appended.jsonl beside the log, and the transcript
# reads it back, so a test sees what it sent on the next call.
if [ "$VERB" = "chat" ]; then
  CHAT_SHAPE=""
  CHAT_BOT=""
  CHAT_AFTER_DASH=0
  for ARG in "$@"; do
    case "$ARG" in
      --transcript|--message)
        CHAT_SHAPE="$ARG"
        ;;
      --)
        CHAT_AFTER_DASH=1
        ;;
      *)
        if [ "$CHAT_AFTER_DASH" = "1" ] && [ -z "$CHAT_BOT" ]; then
          CHAT_BOT="$ARG"
        fi
        ;;
    esac
  done
  CHAT_STATE=""
  if [ -n "$LOG" ]; then
    CHAT_STATE="$(dirname "$LOG")/chat-appended.jsonl"
  fi

  if [ "$CHAT_SHAPE" = "--transcript" ]; then
    if [ "$SCENARIO" = "empty" ] || [ "$SCENARIO" = "chat-empty" ]; then
      cat "$PAYLOADS/chat-empty.json"
      exit 0
    fi
    if [ -n "$CHAT_STATE" ] && [ -s "$CHAT_STATE" ]; then
      CHAT_LINES="$(wc -l < "$PAYLOADS/chat-transcript.json")"
      head -n $((CHAT_LINES - 2)) "$PAYLOADS/chat-transcript.json"
      while IFS= read -r CHAT_LINE; do
        printf ',\n    %s' "$CHAT_LINE"
      done < "$CHAT_STATE"
      printf '\n  ]\n}\n'
    else
      cat "$PAYLOADS/chat-transcript.json"
    fi
    exit 0
  fi

  if [ "$CHAT_SHAPE" = "--message" ]; then
    if [ -n "$LOG" ]; then
      CHAT_PGID="$(ps -o pgid= -p $$ | tr -d ' ')"
      printf 'fixture-chat-pgid %s %s\n' "$CHAT_PGID" "$$" >> "$LOG"
      # Tested on the fd itself, never inside a command substitution, which would
      # make stdout a pipe of its own.
      if [ /dev/fd/1 -ef /dev/null ]; then CHAT_OUT="null"; else CHAT_OUT="open"; fi
      printf 'fixture-chat-fds stdout=%s\n' "$CHAT_OUT" >> "$LOG"
    fi
    CHAT_TEXT=""
    IFS= read -r CHAT_TEXT || true
    if [ -n "$LOG" ]; then
      printf 'fixture-chat-stdin %s\n' "$CHAT_TEXT" >> "$LOG"
    fi

    case "$SCENARIO" in
      chat-refuse-*)
        printf 'bots: %s\n' "${SCENARIO#chat-refuse-}" >&2
        exit 4
        ;;
      chat-usage)
        printf 'bots: chat: the message is empty\n' >&2
        exit 2
        ;;
      chat-sleep)
        sleep 60
        ;;
      chat-slow)
        sleep 2
        ;;
    esac

    CHAT_REPLY="fixture reply"
    CHAT_EXIT=0
    case "$SCENARIO" in
      chat-park)
        CHAT_REPLY="needs you: Ship the release? (item 20261125T211204Z-7c1e9a40)"
        CHAT_EXIT=5
        ;;
      chat-fail)
        CHAT_REPLY="failed: executor exited 1"
        CHAT_EXIT=1
        ;;
    esac

    if [ -n "$CHAT_STATE" ]; then
      CHAT_N=0
      if [ -f "$CHAT_STATE" ]; then
        CHAT_N="$(wc -l < "$CHAT_STATE" | tr -d ' ')"
      fi
      CHAT_ESCAPED="${CHAT_TEXT//\\/\\\\}"
      CHAT_ESCAPED="${CHAT_ESCAPED//\"/\\\"}"
      printf '{"schemaVersion":1,"id":"msg-fixture-h%s","conversationId":"%s","botId":"%s","role":"human","text":"%s","at":"2026-11-25T21:14:04.000Z","runId":null,"by":"ada"}\n' "$CHAT_N" "$CHAT_BOT" "$CHAT_BOT" "$CHAT_ESCAPED" >> "$CHAT_STATE"
      printf '{"schemaVersion":1,"id":"msg-fixture-b%s","conversationId":"%s","botId":"%s","role":"bot","text":"%s","at":"2026-11-25T21:14:05.000Z","runId":"20261125T211404Z-0f1e2d3c","by":"bot"}\n' "$CHAT_N" "$CHAT_BOT" "$CHAT_BOT" "$CHAT_REPLY" >> "$CHAT_STATE"
    fi

    if [ "$CHAT_EXIT" = "1" ]; then
      printf 'bots: executor exited 1\n' >&2
    fi
    if [ "$SCENARIO" = "chat-slow" ] && [ -n "$LOG" ]; then
      printf 'fixture-chat-done\n' >> "$LOG"
    fi
    exit "$CHAT_EXIT"
  fi
fi

ok_answer
