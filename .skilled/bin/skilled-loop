#!/usr/bin/env bash
# ───────────────────────────────────────────────────────────────
# COMPONENT: SKILLED LOOP
# ───────────────────────────────────────────────────────────────
# Relaunch a supported runtime with a fresh handoff seed when state is armed.
# Exit codes preserve the runtime result, except invalid relaunch state returns 1, and
# so does a clean exit whose manual command cannot repeat the launch options.
set -euo pipefail

resolve_script_path() {
  local source_path=${BASH_SOURCE[0]}
  local source_dir
  local link_target

  while [[ -h "$source_path" ]]; do
    source_dir=$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)
    link_target=$(readlink "$source_path")
    if [[ "$link_target" = /* ]]; then
      source_path=$link_target
    else
      source_path=$source_dir/$link_target
    fi
  done

  source_dir=$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)
  printf '%s/%s\n' "$source_dir" "$(basename "$source_path")"
}

script_path=$(resolve_script_path)
script_directory=$(dirname "$script_path")
relaunch_cli="$script_directory/../hooks/session-relaunch/bin/session-relaunch.cjs"
relaunch_core="$script_directory/../hooks/session-relaunch/lib/relaunch-core.cjs"
manual_handoff_token='@@HANDOFF@@'
manual_template_conflict=''
consumed_record_json=''

# Prints the manual claim command on stdout, as the CLI does: it is the result an
# operator copies, and stderr stays for diagnostics. The core fills the template, so the
# escape set and each runtime's seed form have one owner and cannot drift from the
# command a session prints in-band. Returns 1 when no faithful command can be printed.
print_manual_command() {
  local handoff_path="$1"
  local spec_folder="${2:-}"
  local command_form=template
  local manual_command

  if [[ -n "$manual_template_conflict" ]]; then
    printf '%s %s %s\n' \
      "error: the carried option value $manual_template_conflict contains the" \
      "$manual_handoff_token placeholder, so the manual command cannot repeat your" \
      'launch options; the plain command follows and they must be added back by hand' \
      >&2
    command_form=plain
  fi
  if ! manual_command=$(
    node -e '
      const [corePath, runtime, handoffPath, specFolder, commandForm] =
        process.argv.slice(1);
      if (commandForm === "plain") delete process.env.SKILLED_LOOP_MANUAL_TEMPLATE;
      const { manualClaimCommand } = require(corePath);
      process.stdout.write(manualClaimCommand(runtime, handoffPath, specFolder));
    ' -- "$relaunch_core" "$runtime" "$handoff_path" "$spec_folder" "$command_form"
  ); then
    printf '%s\n' 'error: could not build the manual claim command' >&2
    return 1
  fi
  printf '%s\n' "$manual_command"
  [[ "$command_form" == 'template' ]]
}

consume_record() {
  if consumed_record_json=$(node "$relaunch_cli" consume --loop-id "$SKILLED_LOOP_ID"); then
    return 0
  fi
  consumed_record_json=''
  printf '%s\n' 'warning: could not consume the relaunch record' >&2
  return 0
}

# Records the hand-over once the wrapper is about to relaunch, in a call of its own, so a
# consume whose output could not be read never leaves a line for a hop the wrapper declined.
# The history is a record for the operator: its status never holds the relaunch back.
record_hand_over() {
  local handoff_path="$1"
  local hop="$2"

  node "$relaunch_cli" hand-over --handoff "$handoff_path" --hop "$hop" --runtime "$runtime" \
    >/dev/null || true
}

# Prints the consumed note state, or nothing when consume failed or printed no JSON.
consumed_note_state() {
  local note_state=''
  if [[ -n "$consumed_record_json" ]]; then
    note_state=$(node -e '
      const fs = require("node:fs");
      const record = JSON.parse(fs.readFileSync(0, "utf8"));
      process.stdout.write(typeof record.note === "string" ? record.note : "");
    ' <<< "$consumed_record_json" 2>/dev/null) || note_state=''
  fi
  printf '%s' "$note_state"
}

consumed_spec_folder() {
  local spec_folder=''
  if [[ -n "$consumed_record_json" ]]; then
    spec_folder=$(node -e '
      const fs = require("node:fs");
      const record = JSON.parse(fs.readFileSync(0, "utf8"));
      process.stdout.write(
        typeof record.spec_folder === "string" ? record.spec_folder : "",
      );
    ' <<< "$consumed_record_json") || spec_folder=''
  fi
  printf '%s' "$spec_folder"
}

# Prints the goal packet consume reported, or nothing. The CLI applies the goal switch and
# the packet checks, so an empty answer covers a switch that is off as well as no goal.
consumed_goal_packet() {
  local goal_packet=''
  if [[ -n "$consumed_record_json" ]]; then
    goal_packet=$(node -e '
      const fs = require("node:fs");
      const record = JSON.parse(fs.readFileSync(0, "utf8"));
      process.stdout.write(
        typeof record.goal_packet === "string" ? record.goal_packet : "",
      );
    ' <<< "$consumed_record_json") || goal_packet=''
  fi
  printf '%s' "$goal_packet"
}

# Prints the note's state through the core, so the wrapper judges a note exactly as a
# claim and a should-relaunch decision would.
handoff_note_state() {
  local handoff_path="$1"
  local note_state=''
  note_state=$(node -e '
    const [corePath, handoffPath] = process.argv.slice(1);
    const { noteState } = require(corePath);
    process.stdout.write(noteState(handoffPath));
  ' -- "$relaunch_core" "$handoff_path" 2>/dev/null) || note_state=''
  printf '%s' "$note_state"
}

has_line_break() {
  local value="$1"
  [[ "$value" == *$'\r'* || "$value" == *$'\n'* ]]
}

# The core owns the suffix text, so the relaunch seed and the manual command cannot drift.
spec_folder_suffix() {
  local spec_folder="$1"
  local suffix
  if suffix=$(
    node -e '
      const [corePath, specFolder] = process.argv.slice(1);
      const { specFolderSuffix } = require(corePath);
      process.stdout.write(specFolderSuffix(specFolder));
    ' -- "$relaunch_core" "$spec_folder"
  ); then
    printf '%s' "$suffix"
  else
    printf '%s\n' 'warning: could not build the spec-folder suffix; relaunching without it' >&2
  fi
}

resolve_pi_extension_path() {
  local extension_path="$1"
  local extension_directory
  local extension_name

  case "$extension_path" in
    builtin:*|/*)
      printf '%s\n' "$extension_path"
      ;;
    */*)
      extension_directory="${extension_path%/*}"
      extension_name="${extension_path##*/}"
      if [[ -z "$extension_directory" ]]; then
        extension_directory='.'
      fi
      if extension_directory=$(
        cd -- "$start_directory/$extension_directory" 2>/dev/null && pwd -P
      ); then
        printf '%s/%s\n' "$extension_directory" "$extension_name"
      else
        printf '%s/%s\n' "$start_directory" "$extension_path"
      fi
      ;;
    *)
      printf '%s/%s\n' "$start_directory" "$extension_path"
      ;;
  esac
}

shell_quote_argument() {
  local value="$1"
  local quoted="'"
  local index
  local character

  for ((index = 0; index < ${#value}; index++)); do
    character=${value:index:1}
    if [[ "$character" == "'" ]]; then
      quoted+="'\\''"
    else
      quoted+="$character"
    fi
  done
  quoted+="'"
  printf '%s' "$quoted"
}

build_relaunch_arguments() {
  local seed="$1"
  launch_arguments=()
  case "$runtime" in
    claude)
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(--model "$SKILLED_LOOP_MODEL")
      fi
      launch_arguments+=("$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      if [[ -n "${SKILLED_LOOP_NAME:-}" ]]; then
        launch_arguments+=(--name "$SKILLED_LOOP_NAME")
      fi
      ;;
    pi)
      if [[ -n "${SKILLED_LOOP_PROVIDER:-}" ]]; then
        launch_arguments+=(--provider "$SKILLED_LOOP_PROVIDER")
      fi
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(--model "$SKILLED_LOOP_MODEL")
      fi
      if ((pi_extension_arguments_set == 1)); then
        launch_arguments+=("${pi_extension_arguments[@]}")
      fi
      if [[ -n "${SKILLED_LOOP_NAME:-}" ]]; then
        launch_arguments+=(--name "$SKILLED_LOOP_NAME")
      fi
      launch_arguments+=("$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      ;;
    opencode)
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(-m "$SKILLED_LOOP_MODEL")
      fi
      launch_arguments+=(--prompt "$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      ;;
    codex)
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(-m "$SKILLED_LOOP_MODEL")
      fi
      launch_arguments+=("$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      ;;
    cursor)
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(--model "$SKILLED_LOOP_MODEL")
      fi
      launch_arguments+=("$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      ;;
    hermes)
      launch_arguments=(chat)
      if [[ -n "${SKILLED_LOOP_PROVIDER:-}" ]]; then
        launch_arguments+=(--provider "$SKILLED_LOOP_PROVIDER")
      fi
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(-m "$SKILLED_LOOP_MODEL")
      fi
      launch_arguments+=(-q "$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      ;;
    devin)
      if [[ -n "${SKILLED_LOOP_MODEL:-}" ]]; then
        launch_arguments+=(--model "$SKILLED_LOOP_MODEL")
      fi
      launch_arguments+=(-- "$seed")
      relaunch_seed_index=$((${#launch_arguments[@]} - 1))
      ;;
  esac
}

build_manual_command_template() {
  local manual_seed="[session-relaunch] claim and continue handoff $manual_handoff_token"
  local template="skilled-loop $runtime"
  local index
  local argument
  local quoted_argument

  build_relaunch_arguments "$manual_seed"
  for ((index = 0; index < ${#launch_arguments[@]}; index++)); do
    argument=${launch_arguments[$index]}
    template+=' '
    if ((index == relaunch_seed_index)); then
      template+="\"$manual_seed\""
    else
      quoted_argument=$(shell_quote_argument "$argument")
      template+="$quoted_argument"
    fi
  done
  printf '%s' "$template"
}

# Prints the first carried option value holding the placeholder. The core fills only a
# template with exactly one placeholder, so such a value makes the template unusable.
find_manual_template_conflict() {
  local index

  build_relaunch_arguments "$manual_handoff_token"
  for ((index = 0; index < ${#launch_arguments[@]}; index++)); do
    if ((index != relaunch_seed_index)) \
      && [[ "${launch_arguments[$index]}" == *"$manual_handoff_token"* ]]; then
      printf '%s' "${launch_arguments[$index]}"
      return 0
    fi
  done
}

if [[ ! -f "$relaunch_cli" ]]; then
  printf '%s\n' 'session-relaunch CLI was not found beside this wrapper' >&2
  exit 1
fi

start_directory=$(pwd -P)
runtime=claude
runtime_command=claude
if [[ $# -gt 0 ]]; then
  case "$1" in
    claude|pi|opencode|codex|hermes|devin)
      runtime="$1"
      runtime_command="$1"
      shift
      ;;
    cursor)
      runtime=cursor
      runtime_command=cursor-agent
      shift
      ;;
  esac
fi

original_arguments=("$@")
original_argument_count=$#
launch_arguments=()
pi_extension_arguments=()
pi_extension_arguments_set=0
pi_no_extensions_seen=0
codex_no_daemon_seen=0
# The packet belongs to one hop, so a value from an outer session never reaches a first launch.
unset SKILLED_LOOP_NAME SKILLED_LOOP_MODEL SKILLED_LOOP_PROVIDER SESSION_RELAUNCH_GOAL_PACKET
index=0
option_scan_stopped=0
skip_next_option=0
while ((index < original_argument_count)); do
  argument="${original_arguments[$index]}"
  next_argument=''
  if ((index + 1 < original_argument_count)); then
    next_argument="${original_arguments[$((index + 1))]}"
  fi
  if ((option_scan_stopped == 0)); then
    if ((skip_next_option == 1)); then
      skip_next_option=0
    else
      case "$argument" in
        --)
          option_scan_stopped=1
          ;;
        -n|--name)
          if ((index + 1 < original_argument_count)) && [[ "$next_argument" != -* ]]; then
            SKILLED_LOOP_NAME="$next_argument"
            export SKILLED_LOOP_NAME
            skip_next_option=1
          fi
          ;;
        --name=*)
          if [[ "${argument#--name=}" != -* ]]; then
            SKILLED_LOOP_NAME="${argument#--name=}"
            export SKILLED_LOOP_NAME
          fi
          ;;
      esac

      case "$runtime:$argument" in
        claude:--model|pi:--model|opencode:--model|opencode:-m|\
          codex:-m|codex:--model|cursor:--model|hermes:-m|hermes:--model|\
          devin:--model)
          if ((index + 1 < original_argument_count)) && [[ "$next_argument" != -* ]]; then
            SKILLED_LOOP_MODEL="$next_argument"
            export SKILLED_LOOP_MODEL
            skip_next_option=1
          fi
          ;;
        claude:--model=*|pi:--model=*|opencode:--model=*|\
          codex:--model=*|cursor:--model=*|hermes:--model=*|devin:--model=*)
          if [[ "${argument#--model=}" != -* ]]; then
            SKILLED_LOOP_MODEL="${argument#--model=}"
            export SKILLED_LOOP_MODEL
          fi
          ;;
        pi:--provider|hermes:--provider)
          if ((index + 1 < original_argument_count)) && [[ "$next_argument" != -* ]]; then
            SKILLED_LOOP_PROVIDER="$next_argument"
            export SKILLED_LOOP_PROVIDER
            skip_next_option=1
          fi
          ;;
        pi:--provider=*|hermes:--provider=*)
          if [[ "${argument#--provider=}" != -* ]]; then
            SKILLED_LOOP_PROVIDER="${argument#--provider=}"
            export SKILLED_LOOP_PROVIDER
          fi
          ;;
        codex:--no-daemon)
          codex_no_daemon_seen=1
          ;;
        pi:-ne|pi:--no-extensions)
          if ((pi_no_extensions_seen == 0)); then
            pi_extension_arguments+=(-ne)
            pi_extension_arguments_set=1
            pi_no_extensions_seen=1
          fi
          ;;
        pi:-e|pi:--extension)
          if ((index + 1 < original_argument_count)) && [[ "$next_argument" != -* ]]; then
            extension_path=$(resolve_pi_extension_path "$next_argument")
            pi_extension_arguments+=(-e "$extension_path")
            pi_extension_arguments_set=1
            skip_next_option=1
          fi
          ;;
        pi:--extension=*)
          extension_path="${argument#--extension=}"
          if [[ -n "$extension_path" && "$extension_path" != -* ]]; then
            extension_path=$(resolve_pi_extension_path "$extension_path")
            pi_extension_arguments+=(-e "$extension_path")
            pi_extension_arguments_set=1
          fi
          ;;
      esac
    fi
  fi
  launch_arguments+=("$argument")
  index=$((index + 1))
done

if [[ "$runtime" == 'codex' && "$codex_no_daemon_seen" == 0 ]]; then
  if ((original_argument_count > 0)); then
    launch_arguments=(--no-daemon "${launch_arguments[@]}")
  else
    launch_arguments=(--no-daemon)
  fi
fi

SKILLED_LOOP_MANUAL_TEMPLATE=$(build_manual_command_template)
export SKILLED_LOOP_MANUAL_TEMPLATE
manual_template_conflict=$(find_manual_template_conflict)
export SKILLED_LOOP_ID="$$"
export SKILLED_LOOP_RUNTIME="$runtime"
SKILLED_LOOP_HOPS=${SKILLED_LOOP_HOPS:-0}
if [[ ! "$SKILLED_LOOP_HOPS" =~ ^[0-9]+$ ]]; then
  printf '%s\n' 'SKILLED_LOOP_HOPS must be a non-negative integer' >&2
  exit 1
fi
export SKILLED_LOOP_HOPS

# The note a relaunch seeded and its spec folder, kept so a later decline can name the
# note that session was handed and never claimed.
relaunched_handoff=''
relaunched_spec_folder=''

while true; do
  # Keep the wrapper alive so it can inspect relaunch state after the runtime exits.
  # The guarded expansion keeps empty arguments safe under Bash 3.2 with nounset.
  if "$runtime_command" "${launch_arguments[@]+"${launch_arguments[@]}"}"; then
    runtime_exit=0
  else
    runtime_exit=$?
  fi

  if decision_json=$(node "$relaunch_cli" should-relaunch --loop-id "$SKILLED_LOOP_ID"); then
    decision_status=0
  else
    decision_status=$?
  fi

  case "$decision_status" in
    0)
      exec 3< <(
        node -e '
          const fs = require("node:fs");
          const record = JSON.parse(fs.readFileSync(0, "utf8"));
          const cwd = typeof record.cwd === "string" ? record.cwd : "";
          const handoff = typeof record.handoff === "string" ? record.handoff : "";
          process.stdout.write(cwd + "\0" + handoff + "\0");
        ' <<< "$decision_json" 2>/dev/null
      )
      if ! IFS= read -r -d '' relaunch_cwd <&3; then
        exec 3<&-
        printf '%s\n' 'warning: could not read the relaunch record' >&2
        consume_record
        exit 1
      fi
      if ! IFS= read -r -d '' handoff_path <&3; then
        exec 3<&-
        printf '%s\n' 'warning: could not read the relaunch record' >&2
        consume_record
        exit 1
      fi
      exec 3<&-

      if [[ -z "$handoff_path" ]]; then
        printf '%s\n' 'warning: could not read the relaunch record' >&2
        consume_record
        exit 1
      fi
      if [[ -z "$relaunch_cwd" ]] \
        || has_line_break "$relaunch_cwd" \
        || has_line_break "$handoff_path"; then
        consume_record
        spec_folder=$(consumed_spec_folder)
        print_manual_command "$handoff_path" "$spec_folder" || true
        exit 1
      fi
      if ! cd -- "$relaunch_cwd"; then
        consume_record
        spec_folder=$(consumed_spec_folder)
        print_manual_command "$handoff_path" "$spec_folder" || true
        exit 1
      fi

      if ((runtime_exit == 130)); then
        consume_record
        spec_folder=$(consumed_spec_folder)
        print_manual_command "$handoff_path" "$spec_folder" || true
        exit 130
      fi
      consume_record
      # A seed for a note that is not open, or one that lost its Gate 3 answer because
      # consume failed, sends the fresh session into a claim that cannot succeed.
      note_state=$(consumed_note_state)
      if [[ "$note_state" != 'open' ]]; then
        if [[ -z "$note_state" ]]; then
          printf '%s\n' \
            'warning: could not read the consumed relaunch record; not relaunching' >&2
        else
          printf 'warning: the handoff note is %s; not relaunching\n' "$note_state" >&2
        fi
        # A claim throws on a claimed, done or missing note, so a command for one could
        # never work. An invalid note can be repaired and an unread state may hide an open
        # note, so those two keep the command.
        case "$note_state" in
          ''|invalid)
            spec_folder=$(consumed_spec_folder)
            print_manual_command "$handoff_path" "$spec_folder" || true
            ;;
        esac
        exit 1
      fi
      SKILLED_LOOP_HOPS=$((10#$SKILLED_LOOP_HOPS + 1))
      export SKILLED_LOOP_HOPS
      record_hand_over "$handoff_path" "$SKILLED_LOOP_HOPS"

      spec_folder=$(consumed_spec_folder)
      # A hop without a goal must not inherit the previous hop's packet.
      goal_packet=$(consumed_goal_packet)
      if [[ -n "$goal_packet" ]]; then
        export SESSION_RELAUNCH_GOAL_PACKET="$goal_packet"
      else
        unset SESSION_RELAUNCH_GOAL_PACKET
      fi
      relaunched_handoff="$handoff_path"
      relaunched_spec_folder="$spec_folder"
      seed="[session-relaunch] claim and continue handoff $handoff_path"
      seed+=$(spec_folder_suffix "$spec_folder")
      build_relaunch_arguments "$seed"
      if [[ "$runtime" == 'codex' ]]; then
        launch_arguments=(--no-daemon "${launch_arguments[@]}")
      fi
      ;;
    1)
      exec 3< <(
        node -e '
          const fs = require("node:fs");
          const record = JSON.parse(fs.readFileSync(0, "utf8"));
          const reason = typeof record.reason === "string" ? record.reason : "";
          const handoff = typeof record.handoff === "string" ? record.handoff : "";
          process.stdout.write(reason + "\0" + handoff + "\0");
        ' <<< "$decision_json" 2>/dev/null
      )
      decision_reason=''
      handoff_path=''
      if IFS= read -r -d '' decision_reason <&3 && IFS= read -r -d '' handoff_path <&3; then
        :
      else
        printf '%s\n' 'warning: could not read the relaunch record' >&2
      fi
      exec 3<&-
      consume_record
      manual_command_printed=0
      if has_line_break "$handoff_path"; then
        printf '%s\n' \
          'warning: the handoff path contains a line break; no manual command printed' >&2
      elif [[ -n "$handoff_path" ]]; then
        case "$decision_reason" in
          withdrawn)
            # The session called the hand-over off and kept working, so no claim command
            # applies: its note describes work that came before.
            printf 'warning: the prepared hand-over was withdrawn in the session; %s stays open and out of date\n' \
              "$handoff_path" >&2
            # The line above already says what happened to this note, so the unclaimed-note
            # warning for it would contradict it. A different note the relaunched session
            # was seeded with is still open and keeps its warning. Both paths come from
            # the same absolute form the prepare step records.
            if [[ "$handoff_path" == "$relaunched_handoff" ]]; then
              manual_command_printed=1
            fi
            ;;
          not-armed|stale|hop-cap|incomplete-record)
            spec_folder=$(consumed_spec_folder)
            # A clean exit must not read as success when the printed command is not the
            # one the operator launched with.
            if ! print_manual_command "$handoff_path" "$spec_folder" \
              && ((runtime_exit == 0)); then
              runtime_exit=1
            fi
            manual_command_printed=1
            ;;
        esac
      fi
      # An interrupted relaunch leaves an open note that only the operator can pick up now.
      if ((manual_command_printed == 0)) && [[ -n "$relaunched_handoff" ]] \
        && [[ "$(handoff_note_state "$relaunched_handoff")" == 'open' ]]; then
        printf 'warning: the relaunched session ended before claiming %s; its handoff note was not claimed\n' \
          "$relaunched_handoff" >&2
        print_manual_command "$relaunched_handoff" "$relaunched_spec_folder" || true
      fi
      exit "$runtime_exit"
      ;;
    *)
      consume_record
      printf 'warning: should-relaunch failed with status %s; preserving runtime exit %s\n' \
        "$decision_status" "$runtime_exit" >&2
      exit "$runtime_exit"
      ;;
  esac
done
