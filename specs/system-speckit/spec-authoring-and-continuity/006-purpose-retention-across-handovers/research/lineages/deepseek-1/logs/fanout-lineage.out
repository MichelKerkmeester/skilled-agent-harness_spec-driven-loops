'MEMORY_015' : 'MEMORY_016';\n1043:      'open_questions and answered_questions must be disjoint',\n1054:    recent_action: record.recent_action,\n1055:    next_safe_action: record.next_safe_action,\n1061:  if (!compactOptionalFields || record.key_files.length > 0) {\n1062:    ordered.key_files = record.key_files;\n1084:  if (!compactOptionalFields || record.open_questions.length > 0) {\n1085:    ordered.open_questions = record.open_questions;\n1116:    key_files: record.key_files.slice(-3),\n1200:  const recentAction = normalizeCompactField(input.recent_action, 'recent_action', options, errors);\n1201:  const nextSafeAction = normalizeCompactField(input.next_safe_action, 'next_safe_action', options, errors);\n1203:  const keyFiles = normalizeCompactList(input.key_files, 'key_files', errors);\n1204:  const openQuestions = normalizeQuestionSet(input.open_questions, 'open_questions', errors);\n=== RENDER ===\n307:export function renderContinuityFacets(facets: ContinuityFacets): string {\n308-  const labels: Array<[ContinuityFacetName, string]> = [\n309-    ['goal', 'Goal'],\n310-    ['decision', 'Decision'],\n311-    ['progress', 'Progress'],\n312-    ['gotcha', 'Gotcha'],\n313-  ];\n314-\n315-  return labels\n316-    .map(([key, label]) => {\n317-      const items = facets[key];\n318-      if (items.length === 0) {\n319-        return `### ${label}\\n- None restored`;\n320-      }\n321-      return `### ${label}\\n${items.map((item) => `- ${item}`).join('\\n')}`;\n322-    })\n323-    .join('\\n\\n');\n324-}\n325-\n326-function looksCompactNarrativeViolation(value: string): boolean {\n327-  if (!value) {\n328-    return false;\n329-  }\n330-\n331-  if (value.includes('\\n') || value.includes('\\r')) {\n332-    return true;\n333-  }\n334-\n335-  if (LIST_PREFIX_RE.test(value) || MARKDOWN_STRUCTURE_RE.test(value) || URL_RE.test(value)) {\n336-    return true;\n337-  }\n338-\n339-  const sentenceTerminators = value.match(/[.!?]/g) ?? [];\n340-  if (sentenceTerminators.le