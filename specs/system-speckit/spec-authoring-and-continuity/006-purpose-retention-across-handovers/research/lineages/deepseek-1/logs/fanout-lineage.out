{"type":"tool_result","callId":"chatcmpl-tool-bfc339cda69c1170","status":"completed","result":"    2539 .skilled/commands/deep/assets/deep-research-auto.yaml\n# ─────────────────────────────────────────────────────────────────\n# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# YAML PREDICATE GRAMMAR CONTRACT:\n# - This asset does not currently use typed BooleanExpr predicates under\n#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n#   `on_restart`, etc.). Retain the existing shape.\n# - `after:` carries prose timing / narrative notes if needed; `when:` in\n#   this file is reserved for future typed predicates and must NOT carry\n#   free-form narrative prose.\n# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n#   for the canonical BooleanExpr grammar.\n#\n# GATE 3 CLASSIFICATION:\n# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n#   and JSONL state-log appends. The workflow classifies resume as\n#   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n#   extraction can surface resume correctly rather than false-negative.\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Research Loop Manager\npurpose: Iterative deep research with convergence detection\naction: Run deep-research loop from initialization through synthesis\noperating_mode:\n  workflow: iterative_loop\n  workflow_compliance: MANDATORY\n  workflow_execution: autonomous\n  approvals: none\n  tracking: progressive_research_state\n  validation: convergence_detection\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING PRINCIPLES\n# ─────────────────────────────────────────────────────────────────\noperating_principles:\n  core: \"Fresh context per iteration + externalized state = no context degradation\"\n  approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n  mandate: \"Never hold findings in memory; write everything to files\"\n\n# ─────────────────────────────────────────────────────────────────\n# USER INPUTS (from setup phase)\n# ─────────────────────────────────────────────────────────────────\nuser_inputs:\n  research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n  spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n  max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n  convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n  convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n  stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n\n# ─────────────────────────────────────────────────────────────────\n# CONTEXT LOADING\n# ─────────────────────────────────────────────────────────────────\ncontext_loading:\n  trigger: \"At workflow START, before phase_init\"\n  purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n  retrieval:\n    mechanism: \"continuity-ladder-then-ripgrep\"\n    note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n    ladder:\n      - \"{spec_folder}/handover.md when present\"\n      - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n      - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n    free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n    recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n    exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n    ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n  behavior:\n    if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n    if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n\n# ─────────────────────────────────────────────────────────────────\n# SKILL REFERENCE\n# ─────────────────────────────────────────────────────────────────\nskill_reference:\n  skill: system-deep-loop\n  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n  references:\n    loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n    spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n    state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n    convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n  templates:\n    config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n    strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n\n# ─────────────────────────────────────────────────────────────────\n# AGENT CONFIGURATION\n# ─────────────────────────────────────────────────────────────────\nagent_config:\n  agent: deep-research\n  agent_file: \".skilled/agents/deep-research.md\"\n  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n  model: opus\n  leaf_only: true\n  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n  mcp_servers: []\n  tool_call_budget: { target: 12, max: 24 }\n\n# ─────────────────────────────────────────────────────────────────\n# STATE FILE PATHS\n# ─────────────────────────────────────────────────────────────────\n# ─────────────────────────────────────────────────────────────────\n# CANONICAL STATE WRITE MECHANISM\n# ────────────────────────────────────────────────────────────","truncated":true}
