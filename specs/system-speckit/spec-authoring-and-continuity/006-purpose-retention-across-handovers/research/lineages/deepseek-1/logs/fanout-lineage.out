>';\nconst SNAPSHOT_END = '<!-- SPECKIT_CONTINUITY_SNAPSHOT_END -->';\n\n// ───────────────────────────────────────────────────────────────────\n// 4. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction formatIsoSeconds(date: Date): string {\n"}
