{"type":"tool_result","callId":"chatcmpl-tool-95021c891352d876","status":"completed","result":"35:export type ResumeLadderSource = 'handover' | 'continuity' | 'spec-docs' | 'none';\n68:  freshnessWinner: 'handover' | 'continuity' | 'spec-docs' | null;\n133:interface ResumeSignal {\n134:  source: 'handover' | 'continuity' | 'spec-docs';\n178:export function followPhaseParentRedirect(\n209:export function resolvePhaseParentPointerHop(\n280:function normalizeSpecFolder(specFolder: string | null | undefined): string | null {\n296:function parseIsoMs(value: string | null | undefined): number | null {\n305:function stableSha256(content: Buffer): string {\n309:function extractFrontmatter(markdown: string): string {\n313:function stripFrontmatter(markdown: string): string {\n317:function stripQuotes(value: string): string {\n328:function extractTopLevelField(frontmatter: string, field: string): string | null {\n337:function extractContinuityBlock(frontmatter: string): string | null {\n368:function extractContinuityField(block: string, field: string): string | null {\n379:function extractNestedContinuityField(block: string, parentField: string, childField: string): string | null {\n400:function extractHeadingTitle(markdownBody: string): string | null {\n405:function collectSummaryLines(markdownBody: string, maxLines = 3): string[] {\n419:function extractLabeledValue(markdownBody: string, labels: string[]): string | null {\n435:function splitInlineList(value: string | null): string[] {\n446:function uniqueStrings(values: Array<string | null | undefined>): string[] {\n467:function pushPanelCandidate(\n484:function buildRestoredFacets(restored: ResumeRestorePanelItem[]): ContinuityFacets {\n499:function enforceMarkdownBudget(markdown: string, maxChars: number): string {\n507:function buildRestorePanel(params: {\n543:      source: document.type === 'spec-doc' ? 'spec-docs' : document.type,\n590:function getPriorityIndex(basename: string): number {\n595:function readStableMarkdownDocument(filePath: string, workspacePath: string): StableDocumentSnapshot {\n619:function toResumeDocument(\n632:function parseHandoverSignal(snapshot: StableDocumentSnapshot): ResumeSignal | null {\n677:function parseContinuitySignal(snapshot: StableDocumentSnapshot): ResumeSignal | null {\n715:function extractHandoverBinding(content: string): { packetPointer: string | null; fingerprint: string | null } {\n738:function handoverBindingVerifies(\n758:function parseSpecDocumentSignal(snapshots: StableDocumentSnapshot[]): ResumeSignal | null {\n783:    source: 'spec-docs',\n794:function buildPhaseParentContext(params: {\n849:function synthesizeResult(params: {\n850:  primary: ResumeSignal;\n851:  secondary?: ResumeSignal | null;\n907:function buildNoRecoveryResult(\n939:function isPathWithinRoot(candidatePath: string, rootPath: string): boolean {\n949:function resolveFromFolderPath(workspacePath: string, folderPath: string): string | null {\n967:function resolveSpecFolder(options: ResumeLadderOptions, workspacePath: string): ResumeLadderResolution {\n1058:export function buildResumeLadder(options: ResumeLadderOptions = {}): ResumeLadderResult {\n1083:  let specDocPaths = findSpecDocuments(workspacePath, { specFolder: resolution.resolvedSpecFolder })\n1085:  if (specDocPaths.length === 0) {\n1086:    specDocPaths = SPEC_DOC_PRIORITY\n1093:  let handoverSignal: ResumeSignal | null = null;\n1098:      handoverSignal = parseHandoverSignal(handoverSnapshot);\n1104:  let continuitySignal: ResumeSignal | null = null;\n1109:      continuitySignal = parseContinuitySignal(continuitySnapshot);\n1110:      if (!continuitySignal) {\n1122:    && continuitySignal?.packetPointer\n1123:    && normalizeSpecFolder(continuitySignal.packetPointer) !== resolution.resolvedSpecFolder\n1128:  const specDocSnapshots: StableDocumentSnapshot[] = [];\n1129:  for (const docPath of specDocPaths) {\n1135:      specDocSnapshots.push(readStableMarkdownDocument(docPath, workspacePath));\n1141:  const specDocSignal = parseSpecDocumentSignal(specDocSnapshots);\n1143:  if (handoverSignal && continuitySignal) {\n1152:      ? (continuitySignal.updatedAtMs > handoverSignal.updatedAtMs ? continuitySignal : handoverSignal)\n1153:      : continuitySignal;\n1154:    const secondary = primary === handoverSignal ? continuitySignal : handoverSignal;\n1167:  if (handoverSignal) {\n1169:      primary: handoverSignal,\n1170:      secondary: continuitySignal,\n1177:  if (continuitySignal) {\n1179:      primary: continuitySignal,\n1180:      secondary: specDocSignal,\n1187:  if (specDocSignal) {\n1189:      primary: specDocSignal,\n"}
