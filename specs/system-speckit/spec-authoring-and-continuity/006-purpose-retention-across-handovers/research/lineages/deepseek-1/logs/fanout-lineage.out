{"type":"tool_result","callId":"chatcmpl-tool-89cb695e31a04dd8","status":"completed","result":"34:/** Which authored surface a resume ladder ultimately drew its context from. */\n35:export type ResumeLadderSource = 'handover' | 'continuity' | 'spec-docs' | 'none';\n37:/** One document the resume ladder read, with its content fingerprint and modification time. */\n38:export interface ResumeLadderDocument {\n39:  type: 'handover' | 'continuity' | 'spec-doc';\n46:/** How the target spec folder for a resume ladder was resolved. */\n47:export interface ResumeLadderResolution {\n55:/** The built resume ladder: recovered context, source documents, and the restore panel. */\n56:export interface ResumeLadderResult {\n68:  freshnessWinner: 'handover' | 'continuity' | 'spec-docs' | null;\n73:export interface ResumeLadderPhaseParentChild {\n79:/** Phase-parent redirect context attached to a resume ladder result. */\n80:export interface ResumeLadderPhaseParentContext {\n89:export interface ResumeRestorePanelItem {\n97:export interface ResumeRestorePanelOmission {\n104:export interface ResumeRestorePanel {\n117:export interface ResumeLadderOptions {\n123:interface StableDocumentSnapshot {\n133:interface ResumeSignal {\n134:  source: 'handover' | 'continuity' | 'spec-docs';\n152:  'spec.md',\n158:  'handover.md',\n203: * The resume ladder walks these steps to find where work lives, and the save\n271:    && (fs.existsSync(path.join(childPath, 'spec.md')) || fs.existsSync(path.join(childPath, 'description.json')));\n343:  const memoryIndex = lines.findIndex((line) => /^_memory:\\s*$/u.test(line));\n376: * mapping key). Used only by the handover packet-binding check, which reads\n377: * an optional `_memory.continuity` block a handover is not required to carry.\n484:function buildRestoredFacets(restored: ResumeRestorePanelItem[]): ContinuityFacets {\n507:function buildRestorePanel(params: {\n652:  // 'updated' covers handover files that use the shorter alias; the continuity-block\n653:  // lookup handles last_updated_at written as an indented child of _memory.continuity\n666:    source: 'handover',\n673:    documents: [toResumeDocument(snapshot, 'handover')],\n686:  // through a manual field extraction that skips the same checks. The ladder\n708: * A handover's optional packet-identity binding: a `_memory.continuity`\n710: * The standard handover template never authors this block, so both are\n711: * usually absent; when present, they let a handover claim it was written\n728: * True only when a handover declares a packet pointer matching the resolved\n733: * narrow escape hatch the trust ranking keeps open: a handover authored against a\n738:function handoverBindingVerifies(\n"}
