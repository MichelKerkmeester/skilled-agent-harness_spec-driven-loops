\" \"debug delegation\" \"${debug_delegation_template_default_phrases[@]}\"\n    seed_template_document \"$folder_path/research/research.md\" \"$slug_phrase\" \"research\" \"${research_template_default_phrases[@]}\"\n    seed_template_document \"$folder_path/timeline.md\" \"$slug_phrase\" \"timeline\" \"${timeline_template_default_phrases[@]}\"\n    seed_template_document \"$folder_path/review/review-report.md\" \"$slug_phrase\" \"review report\" \"${review_report_template_default_phrases[@]}\"\n    seed_template_document \"$folder_path/goal.md\" \"$slug_phrase\" \"goal\" \"${goal_template_default_phrases[@]}\"\n\n    return 0\n}\n\nrequested_lazy_addon_docs() {\n    local contract_json=\"$1\"\n    node - \"$contract_json\" <<'NODE'\nconst contract = JSON.parse(process.argv[2]);\nconst requested = ['timeline.md', 'decision-record.md'];\n=== placeholder rule ===\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:749:// (YOUR_VALUE_HERE + NEEDS_CLARIFICATION underscore/space). Mustache `{{...}}`\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:752:const PLACEHOLDER_MARKER_RE = /<YOUR_VALUE_HERE:|\\[YOUR_VALUE_HERE:|\\[NEEDS_CLARIFICATION:|\\[NEEDS CLARIFICATION:/u;\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:819:const PLACEHOLDER_MARKERS_ALL_RE = /<YOUR_VALUE_HERE:|\\[YOUR_VALUE_HERE:|\\[NEEDS_CLARIFICATION:|\\[NEEDS CLARIFICATION:/gu;\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:867:        if (!title && draftPacket && markers.every((marker) => marker === '[YOUR_VALUE_HERE:')) {\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:889:    return entry('PLACEHOLDER_FILLED', 'error', `${findings.length} placeholder(s) found`, findings);\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:893:      'PLACEHOLDER_FILLED',\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts:899:  return entry('PLACEHOLDER_FILLED', 'pa