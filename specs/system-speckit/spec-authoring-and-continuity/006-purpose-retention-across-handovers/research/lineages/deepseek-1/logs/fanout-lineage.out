{"type":"tool_result","callId":"chatcmpl-tool-95960c8d02b055e5","status":"completed","result":"function logFailure(ctx, error) {\n  try {\n    ctx.logger.warn(`repo-guards session-start-context: ${String(error)}`);\n  } catch {\n    return undefined;\n  }\n  return undefined;\n}\n\nasync function makeNotice(text) {\n  const { createUserMessage } = await loadDshLlm();\n  return createUserMessage({\n    content: [{ type: 'text', text }],\n    source: { kind: 'repo-guards' },\n  });\n}\n\n/**\n * Run the shared session-prime hook and return the context it prints.\n *\n * @param {{sessionId: string, projectDir: string, source: string}} input - Session identity and start source.\n * @param {Function} [spawn] - Synchronous spawner, replaced in tests.\n * @returns {string} The trimmed context, empty when the hook has nothing to add.\n */\nexport function runSessionPrime({ sessionId, projectDir, source }, spawn = spawnSync) {\n  const result = spawn(process.execPath, [SESSION_PRIME_PATH], {\n    cwd: projectDir,\n    encoding: 'utf8',\n    input: JSON.stringify({ session_id: sessionId, cwd: projectDir, source }),\n    maxBuffer: MAX_BUFFER_BYTES,\n    timeout: TIMEOUT_MS,\n  });\n  if (result.error) throw result.error;\n  if (result.status !== 0) {\n    throw new Error(`session-prime exited with status ${String(result.status)}`);\n  }\n  return (result.stdout ?? '').trim();\n}\n\nfunction lifecycleEnabled(isEnabled) {\n  try {\n    return isEnabled('session-lifecycle') !== false;\n  } catch {\n    return true;\n  }\n}\n\n/** Register session-prime context on the DSH agent creation event. */\nexport function registerSessionStartContext(ctx, {\n  core = { runSessionPrime },\n  isEnabled = isHookEnabled,\n"}
