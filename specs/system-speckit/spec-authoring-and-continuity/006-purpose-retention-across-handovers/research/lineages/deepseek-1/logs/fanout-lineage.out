{"type":"tool_call","callId":"chatcmpl-tool-a3adcb0b3207d560","tool":"bash","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/371-purpose-retention-research && node <<'NODE'\nconst fs=require('fs'), path=require('path');\nfunction purposeOf(f){ const t=fs.readFileSync(f,'utf8'); const m=t.match(/<!--\\s*ANCHOR:problem\\s*-->([\\s\\S]*?)<!--\\s*\\/ANCHOR:problem\\s*-->/); if(!m) return null; const pm=m[1].match(/###\\s*Purpose\\s*\\n([\\s\\S]*?)(?=\\n#{2,3}\\s|\\n<!--|$)/); return pm?pm[1].trim().replace(/\\s+/g,' '):null; }\nconst parent='specs/system-speckit/runtime-and-release/001-system-speckit-v4';\nconst pp=purposeOf(path.join(parent,'spec.md'));\nconsole.log('PARENT purpose len',pp?pp.length:null,'::',pp?pp.slice(0,160):null);\nconst kids=fs.readdirSync(parent,{withFileTypes:true}).filter(e=>e.isDirectory()&&/^\\d{3}-/.test(e.name)).map(e=>e.name);\nlet kidWithSpec=0, kidPurposes=[];\nfor(const k of kids){ const sp=path.join(parent,k,'spec.md'); if(fs.existsSync(sp)){ kidWithSpec++; const p=purposeOf(sp); if(p) kidPurposes.push([k,p]); } }\nconsole.log('children:',kids.length,'with spec.md:',kidWithSpec,'with purpose text:',kidPurposes.length);\nconst pwords=new Set((pp||'').toLowerCase().match(/[a-z]{5,}/g)||[]);\nlet shared=0, maxShared=0, examples=[];\nfor(const [k,p] of kidPurposes){ const w=new Set(p.toLowerCase().match(/[a-z]{5,}/g)||[]); let c=0; for(const x of w) if(pwords.has(x)) c++; if(c>=3) shared++; if(c>maxShared) maxShared=c; if(examples.length<3) examples.push([k,c,p.slice(0,110)]); }\nconsole.log('children sharing >=3 significant words with parent purpose:',shared,'max shared:',maxShared);\nfor(const e of examples) console.log(' -',e[0],'shared',e[1],'::',e[2]);\nNODE","description":"Measure phase-parent to child purpose drift"}}
