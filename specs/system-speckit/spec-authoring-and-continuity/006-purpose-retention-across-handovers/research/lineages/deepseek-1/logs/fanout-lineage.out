n    \"sessionId\": \"dr-1794603751398\",\n    \"parentSessionId\": null,\n    \"lineageMode\": \"new\",\n    \"allowedModes\": [\n      \"new\",\n      \"resume\",\n      \"restart\"\n    ],\n    \"deferredModes\": [\n      \"fork\",\n      \"completed-continue\"\n    ],\n    \"generation\": 1,\n    \"continuedFromRun\": null\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"version\": \"1.0\",\n    \"registryFile\": \"research/findings-registry.json\",\n    \"dashboardFile\": \"research/deep-research-dashboard.md\",\n    \"strategyFile\": \"research/deep-research-strategy.md\",\n    \"machineOwnedSections\": [\n      \"key-questions\",\n      \"answered-questions\",\n      \"what-worked\",\n      \"what-failed\",\n      \"exhausted-approaches\",\n      \"ruled-out-directions\",\n      \"divergence-frontier\",\n      \"next-focus\"\n    ]\n  },\n  \"capabilityMatrixPath\": \".skilled/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json\",\n  \"capabilityMatrixDocPath\": \".skilled/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md\",\n  \"runtimeCapabilityResolver\": \".skilled/skills/system-deep-loop/deep-research/scripts/runtime-capabilities.cjs\",\n  \"reducerScriptPath\": \".skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs\",\n  \"pauseSentinelPath\": \"research/.deep-research-pause\",\n  \"archiveRoot\": \"research_archive\",\n  \"migrationWindowDays\": 28,\n  \"fileProtection\": {\n    \"deep-research-config.json\": \"immutable\",\n    \"deep-research-state.jsonl\": \"append-only\",\n    \"deep-research-strategy.md\": \"mutable\",\n    \"deep-research-dashboard.md\": \"auto-generated\",\n    \"findings-registry.json\": \"auto-generated\",\n    \"iteration-*.md\": \"write-once\",\n    \"research/research.md\": \"mutable\"\n  },\n  \"_optimizerManaged\": {\n    \"description\": \"Fields managed by the offline loop optimizer (042.004). See optimizer-manifest.json for the canonical tunable/locked field registry.\",\n    \"manifestPath\": \".skilled/skills/system-spec-kit/runtime/cli/optimizer/optimizer-manifest.json\",\n    \"tunableFields\": [\n      \"convergenceThreshold\",\n      \"stuckThreshold\",\n      \"maxIterations\"\n    ],\n    \"lockedFields\": [\n      \"lineage\",\n      \"reducer\",\n      \"fileProtection\",\n      \"sessionId\",\n      \"status\",\n      \"antiConvergence.convergenceMode\",\n      \"antiConvergence.stopPolicy\"\n    ],\n    \"promotionMode\": \"advisory-only\"\n  },\n  \"stopPolicy\": \"max-iterations\",\n  \"resource_map\": {\n    \"emit\": true\n  },\n  \"fanout\": {\n    \"executors\": [\n      {\n        \"kind\": \"cli-deepseek-harness\",\n        \"model\": \"deepseek-v4.1-flash-1017\",\n        \"reasoningEffort\": \"max\",\n        \"agentPersona\": \"deep-research\",\n        \"label\": \"deepseek\",\n        \"count\": 2,\n        \"iterations\": 5,\n        \"timeoutSeconds\": 1800\n      }\n    ],\n    \"concurrency\": 2\n  }\n}\n---STATUS---\n{\"event\":\"started\",\"label\":\"deepseek-1\",\"index\":0,\"attempt\":1,\"at\":\"2026-11-13T21:02:39.693Z\",\"gauges\":{\"lag\":2,\"pending\":1,\"failed\":0,\"oldest_pending_lag_ms\":1}}\n{\"event\":\"started\",\"label\":\"deepseek-2\",\"index\":1,\"attempt\":1,\"at\":\"2026-11-13T21:02:39.753Z\",\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"spawned\",\"label\":\"deepseek-1\",\"attempt\":1,\"pid\":35494,\"at\":\"2026-11-13T21:02:44.187Z\",\"status\":\"running\"}\n{\"event\":\"spawned\",\"label\":\"deepseek-2\",\"attempt\":1,\"pid\":35496,\"at\":\"2026-11-13T21:02:44.189Z\",\"status\":\"running\"}\n"}
