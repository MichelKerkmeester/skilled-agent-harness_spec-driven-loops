{"type":"tool_call","callId":"chatcmpl-tool-bacf0b542213897d","tool":"bash","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/371-purpose-retention-research && python3 - <<'EOF'\nimport os,re,glob\ndef purpose(t):\n    m=re.search(r'###\\s+Purpose\\s*\\n+(.+?)(?:\\n#|\\n>|\\n---|\\Z)',t,re.S|re.I)\n    return re.sub(r'\\s+',' ',m.group(1)).strip() if m else ''\nspecs=[f for f in glob.glob('specs/**/spec.md',recursive=True) if not any(x in f for x in ('research_archive','containment','z_archive','node_modules','/scratch'))]\nrows=[]\nfor f in specs:\n    p=purpose(open(f,encoding='utf-8',errors='ignore').read())\n    if not p or '[One-sentence' in p or 'YOUR_VALUE_HERE' in p: continue\n    d=os.path.dirname(f); im=os.path.join(d,'implementation-summary.md')\n    if not os.path.exists(im): continue\n    it=re.sub(r'\\s+',' ',open(im,encoding='utf-8',errors='ignore').read())\n    # exact sentence in summary?\n    probe=p[:80]\n    exact=probe in it\n    has_heading=bool(re.search(r'^#{2,3}\\s+.*\\bpurpose\\b',it,re.I|re.M))\n    rows.append((exact,has_heading))\nprint('packets:',len(rows))\nprint('exact first-80-chars restated in impl-summary:',sum(1 for r in rows if r[0]))\nprint('impl-summary has a Purpose heading:',sum(1 for r in rows if r[1]))\nprint('either:',sum(1 for r in rows if r[0] or r[1]))\nEOF","description":"Measure exact purpose restatement in summaries"}}
