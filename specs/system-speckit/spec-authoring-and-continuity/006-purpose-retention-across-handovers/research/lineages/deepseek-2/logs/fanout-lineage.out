{"type":"tool_result","callId":"chatcmpl-tool-891c097bb1ad4867","status":"completed","result":"# ─────────────────────────────────────────────────────────────────\n# CONTEXT LOADING\n# ─────────────────────────────────────────────────────────────────\ncontext_loading_priority:\n  order: [\"Primary: handover.md (<24h old)\", \"Primary: _memory.continuity in implementation-summary.md\", \"Primary: supporting spec docs (tasks/plan/decision-record/resource-map)\", \"Secondary: graph-metadata.json packet hints\", \"Secondary: the packet-scoped ripgrep context recipe (retrieval-conventions.md section 2.4) for a named gap\"]\n  note: \"Recover from the canonical packet first: handover, then _memory.continuity, then supporting spec docs. The ripgrep recipe fills a named gap only. Nothing here needs a background service.\"\n\npacket_graph_metadata:\n  role: \"secondary packet hint\"\n  allowed_signals: [\"dependencies\", \"supersession\", \"related packets\", \"key files\"]\n  constraint: \"Never replace the canonical handover/continuity/spec-doc recovery ladder.\"\n\nmemory_loading:\n  mode: automatic\n  behavior: \"Auto-load handover.md (<24h) first, else walk the continuity ladder without prompting; stop as soon as one safe next action can be named\"\n  selection: most_recent\n  max_files: 1\n  continuity_ladder:\n    note: \"Read the packet's own files in order. No background service is involved.\"\n    order:\n      - \"Read {spec_folder_path}/handover.md when present and recent\"\n      - \"Read the _memory.continuity frontmatter block in {spec_folder_path}/implementation-summary.md\"\n      - \"Read the packet-first canonical spec docs: spec.md, plan.md, tasks.md, acceptance-criteria.md, decision-record.md, resource-map.md\"\n      - \"Only for a still-missing named gap, run the context recipe from .skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md section 2.4 with {spec_folder_path} as the search root\"\n    unsupported: \"Semantic paraphrase, vector and BM25 fusion, decay, access tracking and session dedup are not available. Recovery is lexical and file-local; a miss is a clean no-hit reported as such, never an inferred session state.\"\n\nsmart_memory_logic:\n  objective: \"Recover enough state to continue safely, not every detail from prior sessions\"\n  essentials: [\"current phase or task\", \"last confirmed action\", \"next safe action\", \"blockers or none\", \"relevant artifact or file\"]\n  sufficiency_rule: \"Stop once next safe action is known plus any two supporting essentials\"\n  gap_fill_order:\n    - \"If current phase or task is missing, inspect tasks.md/acceptance-criteria.md/handover.md\"\n    - \"If next safe action is missing, read `_memory.continuity`, then run the packet-scoped ripgrep context recipe on next-steps/state anchors\"\n    - \"If blockers are missing, target blockers/summary\"\n    - \"If a concrete starting point is missing, use tasks.md or implementation-summary.md before loading more memory\"\n    - \"If ambiguity remains, surface uncertainty instead of guessing\"\n\nstale_session_detection:\n  check: \"last_modified > 7 days\"\n  autonomous_behavior: \"Warn about stale context but continue\"\n\n# ─────────────────────────────────────────────────────────────────\n# CONFIDENCE & CLARIFICATION FRAMEWORK\n# ─────────────────────────────────────────────────────────────────\nconfidence_framework:\n  thresholds:\n    high: { range: \"80-100%\", action: \"Proceed with context loading and resume\" }\n    medium: { range: \"40-79%\", action: \"Proceed but warn about potential context staleness\" }\n    low: { range: \"0-39%\", action: \"Warn user about context reliability issues and avoid guessing the next step\" }\n  scoring_weights: { session_recency: 0.40, artifact_completeness: 0.30, memory_availability: 0.20, codebase_changes: 0.10 }\n  reply_format: [\"Confidence: NN%\", \"Context source: handover|memory\", \"Now\", \"Last confirmed\", \"Next safe action\"]\n  escalation: { timebox_minutes: 5, failed_threshold: 2 }\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n  step_1_session_detection:\n    purpose: Detect active session from CLI argument or recent canonical spec artifacts\n    activities:\n      - Check CLI argument for spec folder\n      - If no argument, build deterministic candidates from `specs/` and `.opencode/specs/`\n      - Canonicalize aliases and filter archive/test/fixture/scratch paths\n      - Rank candidates deterministically with stable tie-breakers\n      - If low confidence in autonomous mode, fall through safely and request explicit path\n      - If no ranked candidate, continue to semantic/MCP fallback\n      - Validate resolved spec folder exists\n    outputs: { spec_folder: detected_path, detection_method: argument_or_memory }\n    validation: session_detected\n\n  step_2_load_memory:\n    purpose: Load context using handover first, then recover only the missing essentials needed for a useful resume\n    activities:\n      - Check for handover.md in spec_folder (<24h old)\n      - If recent handover exists, load as primary context\n      - If handover is absent or insufficient, read `_memory.continuity` from implementation-summary.md\n      - Read supporting spec docs (`tasks.md`, `acceptance-criteria.md`, `plan.md`, `decision-record.md`, `resource-map.md`) before running any search\n      - If the canonical packet is still insufficient, run the packet-scoped context recipe (retrieval-conventions.md section 2.4) against the resolved spec folder\n      - Extract Resume Essentials (current phase/task, last confirmed action, next safe action, blockers, relevant artifact/file)\n      - If specific essentials are still missing, run the anchor recipe (retrieval-conventions.md section 2.4) for those anchors instead of broad loading\n      - If ambiguity remains after targeted gap filling, mark confidence low instead of inventing state\n    context_priority: [\"handover.md\", \"_memory.continuity\", \"supporting spec docs\", \"packet-scoped ripgrep context recipe\", \"packet-scoped ripgrep anchor recipe\"]\n    retrieval_recipe:\n      reference: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n      note: \"Use it only after the canonical packet is still thin, scoped to {detected_spec_folder}. Exit 1 is a clean no-hit and is reported as such; exit 2 or higher is an error with stderr attached, never reported as no-hit.\"\n      command: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- 'resume previous work continue session' {detected_spec_folder}\"\n    outputs: { memory_loaded: true, context_source: \"handover|continuity|spec_docs|ripgrep_context|ripgrep_anchor\", context_summary: extracted_context, resume_packet: \"now|last|next|blockers|artifact\" }\n    validation: context_loaded\n\n  step_3_calculate_progress:\n    purpose: Calculate task and checklist progress\n    activities: [Parse tasks.md for completion status, Parse acceptance-criteria.md rows and the tasks.md verification checklist, Calculate percentages, Identify pending items]\n    outputs: { tasks_progress: percentage, checklist_progress: percentage, pending_items: list }\n"}
