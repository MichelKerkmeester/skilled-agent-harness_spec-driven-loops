{"type":"tool_result","callId":"chatcmpl-tool-9b271e2f8a32b0db","status":"completed","result":"    2539 .skilled/commands/deep/assets/deep-research-auto.yaml\n54:  trigger: \"At workflow START, before phase_init\"\n147:  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n179:  step_resolve_artifact_root:\n197:  step_bind_reducer_artifact_arg:\n207:  step_fanout_spawn:\n208:    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n217:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n218:      phase_main_loop entirely (those are the single-executor path). The merge step in\n219:      phase_synthesis will consolidate results across all lineages.\n221:      step_fanout_spawn_cli:\n240:  phase_init:\n244:      step_preflight_contract:\n253:      step_create_directories:\n257:      step_detect_resource_map:\n268:      step_resolve_canonical_names:\n282:          note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n284:      step_acquire_lock:\n290:        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n293:          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n302:      step_classify_session:\n322:          skip_to: phase_loop\n331:          skip_to: step_create_config\n343:      step_resolve_session_id:\n355:      step_create_config:\n387:      step_create_state_log:\n444:      step_create_strategy:\n456:      step_create_registry:\n461:      step_enrich_strategy_context:\n467:      step_enrich_strategy_resource_map:\n472:      step_detect_spec_present:\n487:      step_preinit_spec_branch:\n530:      step_validate_preinit_spec_doc:\n536:      step_telemetry_heartbeat_started:\n584:      step_init_complete:\n591:  phase_loop:\n597:      step_refresh_lock:\n602:      step_record_artifact_migration:\n608:      step_read_state:\n657:      step_run_now_check:\n736:      step_check_pause_sentinel:\n746:      step_validate_convergence_config:\n758:      step_graph_convergence:\n771:      step_check_convergence:\n780:               step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.\n844:      step_emit_min_iterations_guard_pass:\n850:      step_emit_blocked_stop:\n860:      step_handle_convergence:\n871:              step_prepare_divergent_pivot:\n923:              step_dispatch_pivot_seat_001:\n933:                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n942:              step_record_pivot_seat_001:\n956:              step_dispatch_pivot_seat_002:\n966:                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n975:              step_record_pivot_seat_002:\n989:              step_dispatch_pivot_seat_003:\n999:                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1008:              step_record_pivot_seat_003:\n1022:              step_finalize_divergent_pivot:\n1034:              step_resolve_divergent_pivot_result:\n1040:              step_apply_divergent_pivot_result:\n1050:                  proceed_to: step_rejected_pattern_cache\n1053:                  skip_to: phase_synthesis\n1056:              skip_to: phase_synthesis\n1059:            skip_to: phase_synthesis\n1068:      step_rejected_pattern_cache:\n1111:      step_ideas_backlog_lifecycle:\n1133:      step_normalize_pause_events:\n1143:      step_marker_scan:\n1163:      step_dispatch_iteration:\n1848:            redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1865:      step_run_now_restore_check:\n1921:      step_check_executor_unavailable:\n1935:      step_reduce_state:\n1956:      step_graph_upsert:\n2005:              nodes.push({ ...event, name: event.label ?? event.name ?? event.id });\n2041:      step_refresh_lineage_context:\n2047:        source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n2049:          - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n2057:      step_evaluate_results:\n2086:      step_telemetry_heartbeat_progress:\n"}
