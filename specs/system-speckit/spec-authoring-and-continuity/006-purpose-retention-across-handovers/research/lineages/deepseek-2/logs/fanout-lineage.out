{"type":"tool_call","callId":"chatcmpl-tool-90afb00fd0987b78","tool":"bash","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/371-purpose-retention-research && python3 - <<'EOF'\nimport glob,re,os\n# For packets with goal.md, does goal.md's Objective overlap the spec Purpose?\ndef purpose(t):\n    m=re.search(r'###\\s+Purpose\\s*\\n+(.+?)(?:\\n#|\\n>|\\n---|\\Z)',t,re.S|re.I)\n    return re.sub(r'\\s+',' ',m.group(1)).strip() if m else ''\ndef words(s): return set(re.findall(r'[a-z]{4,}',s.lower()))\nn=0; ov=[]\nfor g in glob.glob('specs/**/goal.md',recursive=True):\n    if any(x in g for x in ('research_archive','containment','z_archive','node_modules')): continue\n    s=os.path.join(os.path.dirname(g),'spec.md')\n    if not os.path.exists(s): continue\n    gt=open(g,encoding='utf-8',errors='ignore').read()\n    m=re.search(r'\\*\\*Objective:\\*\\*\\s*(.+)',gt)\n    if not m or 'YOUR_VALUE_HERE' in m.group(1): continue\n    p=purpose(open(s,encoding='utf-8',errors='ignore').read())\n    if not p or 'YOUR_VALUE_HERE' in p or '[One-sentence' in p: continue\n    gw,pw=words(m.group(1)),words(p)\n    if gw|pw: ov.append(len(gw&pw)/len(gw|pw)); n+=1\nov.sort()\nprint('pairs',n,'median objective/purpose overlap:',round(ov[len(ov)//2],3) if ov else None)\nprint('pairs below 0.10:',sum(1 for x in ov if x<0.10))\nEOF","description":"Compare goal Objective with spec Purpose"}}
