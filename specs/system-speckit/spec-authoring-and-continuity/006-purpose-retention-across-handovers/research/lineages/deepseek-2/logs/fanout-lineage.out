{"type":"tool_call","callId":"chatcmpl-tool-b474f4aeca98c45c","tool":"bash","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/371-purpose-retention-research && python3 - <<'EOF'\nimport os,re\nfrom itertools import islice\n\ndef purpose(path):\n    try: t=open(path,encoding='utf-8',errors='ignore').read()\n    except: return ''\n    m=re.search(r'###\\s+Purpose\\s*\\n+(.+?)(?:\\n#|\\n>|\\n---|\\Z)',t,re.S|re.I)\n    if m: return re.sub(r'\\s+',' ',m.group(1)).strip()\n    m=re.search(r'##\\s+2\\.\\s+PROBLEM & PURPOSE(.+?)(?:\\n##|\\Z)',t,re.S|re.I)\n    if m:\n        m2=re.search(r'###\\s+Purpose\\s*\\n+(.+)',m.group(1),re.S|re.I)\n        if m2: return re.sub(r'\\s+',' ',m2.group(1)).strip()\n    return ''\n\ndef words(s): return set(re.findall(r'[a-z]{4,}',s.lower()))\n\nrows=[]\nfor dirpath,dirnames,filenames in os.walk('specs'):\n    if any(x in dirpath for x in ('research_archive','containment','z_archive','node_modules','/scratch')): continue\n    if 'spec.md' not in filenames: continue\n    kids=[d for d in dirnames if re.match(r'^\\d{3}-[a-z0-9][a-z0-9-]*$',d) and (os.path.exists(os.path.join(dirpath,d,'spec.md')) or os.path.exists(os.path.join(dirpath,d,'description.json')))]\n    if not kids: continue\n    pp=purpose(os.path.join(dirpath,'spec.md'))\n    if not pp: continue\n    for k in kids[:6]:\n        kp=purpose(os.path.join(dirpath,k,'spec.md'))\n        if not kp: continue\n        pw,kw=words(pp),words(kp)\n        jac=len(pw&kw)/len(pw|kw) if (pw|kw) else 0\n        rows.append((jac,dirpath,k,pp,kp))\nrows.sort()\nprint('child specs compared:',len(rows))\nprint('overlap median:',sorted(r[0] for r in rows)[len(rows)//2] if rows else None)\nprint('overlap < 0.10:',sum(1 for r in rows if r[0]<0.10),'of',len(rows))\nfor r in rows[:3]+rows[-2:]:\n    print('\\nJ=%.2f %s -> %s'%(r[0],r[1],r[2]))\n    print('  parent:',r[3][:180])\n    print('  child :',r[4][:180])\nEOF","description":"Measure parent-child purpose overlap"}}
