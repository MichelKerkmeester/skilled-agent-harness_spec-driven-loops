: \"Technical Context\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Overview The\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Pattern Single\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Key Components\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Data Flow\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Task Format\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Task Notation\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Level Recommendation Algorithm\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Verification Summary\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Completion Criteria\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Acceptance Criteria\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"acceptance-criteria.md\",\n        \"source\": \"derived\"\n      }\n    ],\n    \"causal_summary\": \"recommend-level.sh always prints its full scored report, so a caller that needs only the level has to parse the block\",\n    \"created_at\": \"2026-10-26T14:08:47Z\",\n    \"last_save_at\": \"2026-1