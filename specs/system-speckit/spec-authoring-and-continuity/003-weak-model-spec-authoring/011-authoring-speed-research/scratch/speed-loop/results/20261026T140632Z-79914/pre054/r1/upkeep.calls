      \"name\": \"Recommended Level\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Purpose Add\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Implementation Plan\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Technical Context\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Overview The\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Pattern Single\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Key Components\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Data Flow\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"plan.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Task Format\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Task Notation\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Level Recommendation Algorithm\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Verification Summary\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Completion Criteria\",\n        \"kind\": \"proper_