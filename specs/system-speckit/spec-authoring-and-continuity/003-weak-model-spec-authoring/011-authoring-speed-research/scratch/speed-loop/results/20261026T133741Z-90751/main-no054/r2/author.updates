path\\\",\\n        \\\"options\\\": \\\"--json, --strict, --verbose, --quiet\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Pass/warn/fail status\\\", \\\"JSON report (with --json)\\\"],\\n      \\\"gate\\\": \\\"Completion Verification\\\",\\n      \\\"version\\\": \\\"2.0.0\\\",\\n      \\\"dependencies\\\": [\\\"rules/*.sh\\\", \\\"lib/shell-common.sh\\\"]\\n    },\\n    {\\n      \\\"name\\\": \\\"check-completion\\\",\\n      \\\"path\\\": \\\"runtime/cli/spec/check-completion.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Completion Verification Rule enforcement - verify checklist items are complete before claiming done\\\",\\n      \\\"trigger\\\": [\\\"check completion\\\", \\\"verify complete\\\", \\\"claiming done\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Completion Verification Rule\\\"],\\n      \\\"essential\\\": true,\\n      \\\"inputs\\\": {\\n        \\\"required\\\": \\\"Spec folder path\\\",\\n        \\\"options\\\": \\\"--json, --strict, --quiet\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Pass/fail status\\\", \\\"Incomplete items list\\\"],\\n      \\\"gate\\\": \\\"Completion Verification Rule\\\",\\n      \\\"version\\\": \\\"1.0.0\\\",\\n      \\\"dependencies\\\": []\\n    },\\n    {\\n      \\\"name\\\": \\\"upgrade-level\\\",\\n      \\\"path\\\": \\\"runtime/cli/spec/upgrade-level.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Upgrade existing spec folders to higher documentation levels with backup and rollback. Post-upgrade: AI must auto-populate injected placeholder content from existing spec context\\\",\\n      \\\"trigger\\\": [\\\"upgrade level\\\", \\\"level upgrade\\\", \\\"promote spec level\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Developer\\\"],\\n      \\\"essential\\\": true,\\n      \\\"inputs\\\": {\\n        \\\"required\\\": \\\"Spec folder path, --to <2|3|3+>\\\",\\n        \\\"options\\\": \\\"--dry-run, --verbose, --json, --keep-backups\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Upgraded spec docs\\\", \\\"Backup directory\\\", \\\"JSON result with --json\\\"],\\n      \\\"gate\\\": \\\"Documentation Level Upgrade\\\",\\n      \\\"version\\\": \\\"1.0.0\\\",\\n      \\\"dependencies\\\": [\\\"runtime/cli/lib/shell-common.sh\\\", \\\"templates/\\\"]\\n    },\\n    {\\n      \\\"name\\\": \\\"check-prerequisites\\\",\\n      \\\"path\\\": \\\"runtime/cli/setup/check-prerequisites.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Validate spec folder exists and contains required files for its level\\\",\\n      \\\"trigger\\\": [\\\"check prerequisites\\\", \\\"verify files\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Implementation Phase\\\"],\\n      \\\"essential\\\": true,\\n      \\\"inputs\\\": {\\n        \\\"options\\\": \\\"--json, --require-tasks, --include-tasks, --paths-only\\\"\\n      },\\n      \\\"outputs\\\": [\\\"FEATURE_DIR path\\\", \\\"AVAILABLE_DOCS list\\\"],\\n      \\\"gate\\\": null,\\n      \\\"version\\\": \\\"2.0.0\\\",\\n      \\\"dependencies\\\": []\\n    },\\n    {\\n      \\\"name\\\": \\\"calculate-completeness\\\",\\n      \\\"path\\\": \\\"runtime/cli/spec/calculate-completeness.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Calculate percentage of template placeholders replaced with real content\\\",\\n      \\\"trigger\\\": [\\\"calculate progress\\\", \\\"completeness\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Progress Tracking\\\"],\\n      \\\"essential\\\": false,\\n      \\\"inputs\\\": {\\n        \\\"required\\\": \\\"Spec folder path\\\",\\n        \\\"options\\\": \\\"--verbose, --json, --file <path>, --quality\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Completeness percentage\\\", \\\"Per-file breakdown (with --verbose)\\\"],\\n      \\\"gate\\\": null,\\n      \\\"version\\\": \\\"1.0.0\\\",\\n      \\\"dependencies\\\": []\\n    },\\n    {\\n      \\\"name\\\": \\\"test-validation\\\",\\n      \\\"path\\\": \\\"runtime/cli/tests/test-validation.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Test runner for validate-spec.sh against fixture spec folders\\\",\\n      \\\"trigger\\\": [\\\"test validation\\\", \\\"run tests\\\"],\\n      \\\"calledBy\\\": [\\\"Developer\\\", \\\"CI/CD Pipeline\\\"],\\n      \\\"essential\\\": false,\\n      \\\"inputs\\\": {\\n        \\\"options\\\": \\\"-v (verbose), -t NAME (single test), -c CATEGORY, -l (list), -h (help)\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Test pass/fail results\\\", \\\"Coverage report\\\"],\\n      \\\"gate\\\": null,\\n      \\\"version\\\": \\\"2.0.0\\\",\\n      \\\"dependencies\\\": [\\\"validate-spec.sh\\\", \\\"test-fixtures/\\\"]\\n    },\\n    {\\n      \\\"name\\\": \\\"create-spec-folder\\\",\\n      \\\"path\\\": \\\"runtime/cli/spec/create.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Create new spec folders with appropriate templates based on documentation level\\\",\\n      \\\"trigger\\\": [\\\"create spec\\\", \\\"new spec folder\\\", \\\"Option B\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Gate 3 (Option B)\\\"],\\n      \\\"essential\\\": true,\\n      \\\"inputs\\\": {\\n        \\\"required\\\": \\\"Feature description\\\",\\n        \\\"options\\\": \\\"--short-name, --level (1/2/3), --number, --skip-branch, --sharded, --subfolder\\\"\\n      },\\n      \\\"outputs\\\": [\\\"New spec folder with templates\\\", \\\"Git branch (optional)\\\"],\\n      \\\"gate\\\": \\\"Gate 3 (Spec Folder Creation)\\\",\\n      \\\"version\\\": \\\"2.0.0\\\",\\n      \\\"dependencies\\\": [\\\"templates/\\\"]\\n    },\\n    {\\n      \\\"name\\\": \\\"generate-nested-changelog\\\",\\n      \\\"path\\\": \\\"runtime/cli/dist/spec-folder/nested-changelog.js\\\",\\n      \\\"type\\\": \\\"node\\\",\\n      \\\"description\\\": \\\"Generate packet-local changelog content for a root spec folder or a nested phase child\\\",\\n      \\\"trigger\\\": [\\\"nested changelog\\\", \\\"packet changelog\\\", \\\"phase changelog\\\", \\\"spec changelog\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Completion workflows\\\", \\\"Create changelog command\\\"],\\n      \\\"essential\\\": false,\\n      \\\"inputs\\\": {\\n        \\\"required\\\": \\\"Spec folder path\\\",\\n        \\\"options\\\": \\\"--json, --write, --mode <auto|root|phase>, --output <path>\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Rendered markdown\\\", \\\"Nested changelog payload\\\", \\\"packet-local changelog file (with --write)\\\"],\\n      \\\"gate\\\": \\\"Completion workflow\\\",\\n      \\\"version\\\": \\\"1.0.0\\\",\\n      \\\"dependencies\\\": [\\\"runtime/cli/spec-folder/*.ts\\\", \\\"templates/changelog/\\\"]\\n    },\\n    {\\n      \\\"name\\\": \\\"recommend-level\\\",\\n      \\\"path\\\": \\\"runtime/cli/spec/recommend-level.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Recommend documentation level based on task complexity factors\\\",\\n      \\\"trigger\\\": [\\\"recommend level\\\", \\\"what level\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Gate 3\\\"],\\n      \\\"essential\\\": false,\\n      \\\"inputs\\\": {\\n        \\\"options\\\": \\\"--loc <number>, --files <number>, --auth, --api, --db, --architectural, --json\\\"\\n      },\\n      \\\"outputs\\\": [\\\"Recommended level (0-3)\\\", \\\"Score breakdown\\\"],\\n      \\\"gate\\\": null,\\n      \\\"version\\\": \\\"1.0.0\\\",\\n      \\\"dependencies\\\": []\\n    },\\n    {\\n      \\\"name\\\": \\\"archive-spec\\\",\\n      \\\"path\\\": \\\"runtime/cli/spec/archive.sh\\\",\\n      \\\"type\\\": \\\"bash\\\",\\n      \\\"description\\\": \\\"Move completed spec folders to archive, keeping specs/ directory clean\\\",\\n      \\\"trigger\\\": [\\\"archive spec\\\", \\\"move to archive\\\"],\\n      \\\"calledBy\\\": [\\\"AI Assistant\\\