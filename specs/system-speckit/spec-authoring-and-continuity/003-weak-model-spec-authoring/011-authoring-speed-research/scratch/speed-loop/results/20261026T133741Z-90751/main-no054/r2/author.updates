r\\\",\\n251:       \\\"essential\\\": true,\\n252:       \\\"version\\\": \\\"1.0.0\\\"\\n253:     },\\n254:     {\\n255:       \\\"name\\\": \\\"check-frontmatter\\\",\\n256:       \\\"path\\\": \\\"runtime/cli/rules/check-frontmatter.sh\\\",\\n257:       \\\"type\\\": \\\"bash\\\",\\n258:       \\\"description\\\": \\\"FRONTMATTER_VALID rule - validates YAML frontmatter structure\\\",\\n259:       \\\"severity\\\": \\\"warning\\\",\\n260:       \\\"essential\\\": false,\\n261:       \\\"version\\\": \\\"1.0.0\\\"\\n262:     },\\n263:     {\\n264:       \\\"name\\\": \\\"check-placeholders\\\",\\n265:       \\\"path\\\": \\\"runtime/cli/rules/check-placeholders.sh\\\",\\n266:       \\\"type\\\": \\\"bash\\\",\\n267:       \\\"description\\\": \\\"PLACEHOLDER_FILLED rule - detects unfilled [TODO:], [TBD], {{mustache}} placeholders\\\",\\n268:       \\\"severity\\\": \\\"warning\\\",\\n269:       \\\"essential\\\": false,\\n270:       \\\"version\\\": \\\"1.0.0\\\"\\n271:     },\\n272:     {\\n273:       \\\"name\\\": \\\"check-level\\\",\\n274:       \\\"path\\\": \\\"runtime/cli/rules/check-level.sh\\\",\\n275:       \\\"type\\\": \\\"bash\\\",\\n276:       \\\"description\\\": \\\"LEVEL_DECLARED rule - checks if documentation level was explicitly declared\\\",\\n277:       \\\"severity\\\": \\\"info\\\",\\n278:       \\\"essential\\\": false,\\n279:       \\\"version\\\": \\\"1.0.0\\\"\\n280:     },\\n281:     {\\n282:       \\\"name\\\": \\\"check-complexity\\\",\\n283:       \\\"path\\\": \\\"runtime/cli/rules/check-complexity.sh\\\",\\n284:       \\\"type\\\": \\\"bash\\\",\\n285:       \\\"description\\\": \\\"COMPLEXITY_MATCH rule - validates declared complexity matches actual content metrics\\\",\\n286:       \\\"severity\\\": \\\"warning\\\",\\n287:       \\\"essential\\\": false,\\n288:       \\\"version\\\": \\\"1.0.0\\\"\\n289:     },\\n290:     {\\n291:       \\\"name\\\": \\\"check-ai-protocols\\\",\\n292:       \\\"path\\\": \\\"runtime/cli/rules/check-ai-protocols.sh\\\",\\n293:       \\\"type\\\": \\\"bash\\\",\\n294:       \\\"description\\\": \\\"AI_PROTOCOL rule - validates AI execution protocols present for Level 3+\\\",\\n295:       \\\"severity\\\": \\\"warning\\\",\\n296:       \\\"essential\\\": false,\\n297:       \\\"version\\\": \\\"1.0.0\\\"\\n298:     },\\n299:     {\\n300:       \\\"name\\\": \\\"check-level-match\\\",\\n301:       \\\"path\\\": \\\"runtime/cli/rules/check-level-match.sh\\\",\\n302:       \\\"type\\\": \\\"bash\\\",\\n303:       \\\"description\\\": \\\"LEVEL_MATCH rule - validates level consistency across all spec folder files\\\",\\n304:       \\\"severity\\\": \\\"error\\\",\\n305:       \\\"essential\\\": true,\\n306:       \\\"version\\\": \\\"1.0.0\\\"\\n307:     },\\n308:     {\\n309:       \\\"name\\\": \\\"check-toc-policy\\\",\\n310:       \\\"path\\\": \\\"runtime/cli/rules/check-toc-policy.sh\\\",\\n311:       \\\"type\\\": \\\"bash\\\",\\n312:       \\\"description\\\": \\\"TOC_POLICY rule - allows ToC only in research/research.md and rejects ToC in standard spec artifacts\\\",\\n313:       \\\"severity\\\": \\\"error\\\",\\n314:       \\\"essential\\\": true,\\n315:       \\\"version\\\": \\\"1.0.0\\\"\\n316:     }\\n317:   ],\\n318:   \\\"libraries\\\": {\\n319:     \\\"shell\\\": [\\n320:       {\\n321:         \\\"name\\\": \\\"shell-common\\\",\\n322:         \\\"path\\\": \\\"runtime/cli/lib/shell-common.sh\\\",\\n323:         \\\"description\\\": \\\"Shared shell utilities (colors, logging, result tracking)\\\"\\n324:       },\\n325:       {\\n326:         \\\"name\\\": \\\"git-branch\\\",\\n327:         \\\"path\\\": \\\"runtime/cli/lib/git-branch.sh\\\",\\n328:         \\\"description\\\": \\\"Git branch utilities\\\"\\n329:       },\\n330:       {\\n331:         \\\"name\\\": \\\"template-utils\\\",\\n332:         \\\"path\\\": \\\"runtime/cli/lib/template-utils.sh\\\",\\n333:         \\\"description\\\": \\\"Template processing helpers\\\"\\n334:       }\