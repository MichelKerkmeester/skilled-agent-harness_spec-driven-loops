ime/cli/spec/validate.sh\\\",\\n27:       \\\"type\\\": \\\"bash\\\",\\n28:       \\\"description\\\": \\\"Validate spec folder contents against documentation level requirements\\\",\\n29:       \\\"trigger\\\": [\\\"validate spec\\\", \\\"check spec\\\"],\\n30:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"CI/CD Pipeline\\\", \\\"Pre-commit Hook\\\"],\\n31:       \\\"essential\\\": true,\\n32:       \\\"inputs\\\": {\\n33:         \\\"required\\\": \\\"Spec folder path\\\",\\n34:         \\\"options\\\": \\\"--json, --strict, --verbose, --quiet\\\"\\n35:       },\\n36:       \\\"outputs\\\": [\\\"Pass/warn/fail status\\\", \\\"JSON report (with --json)\\\"],\\n37:       \\\"gate\\\": \\\"Completion Verification\\\",\\n38:       \\\"version\\\": \\\"2.0.0\\\",\\n39:       \\\"dependencies\\\": [\\\"rules/*.sh\\\", \\\"lib/shell-common.sh\\\"]\\n40:     },\\n41:     {\\n42:       \\\"name\\\": \\\"check-completion\\\",\\n43:       \\\"path\\\": \\\"runtime/cli/spec/check-completion.sh\\\",\\n44:       \\\"type\\\": \\\"bash\\\",\\n45:       \\\"description\\\": \\\"Completion Verification Rule enforcement - verify checklist items are complete before claiming done\\\",\\n46:       \\\"trigger\\\": [\\\"check completion\\\", \\\"verify complete\\\", \\\"claiming done\\\"],\\n47:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Completion Verification Rule\\\"],\\n48:       \\\"essential\\\": true,\\n49:       \\\"inputs\\\": {\\n50:         \\\"required\\\": \\\"Spec folder path\\\",\\n51:         \\\"options\\\": \\\"--json, --strict, --quiet\\\"\\n52:       },\\n53:       \\\"outputs\\\": [\\\"Pass/fail status\\\", \\\"Incomplete items list\\\"],\\n54:       \\\"gate\\\": \\\"Completion Verification Rule\\\",\\n55:       \\\"version\\\": \\\"1.0.0\\\",\\n56:       \\\"dependencies\\\": []\\n57:     },\\n58:     {\\n59:       \\\"name\\\": \\\"upgrade-level\\\",\\n60:       \\\"path\\\": \\\"runtime/cli/spec/upgrade-level.sh\\\",\\n61:       \\\"type\\\": \\\"bash\\\",\\n62:       \\\"description\\\": \\\"Upgrade existing spec folders to higher documentation levels with backup and rollback. Post-upgrade: AI must auto-populate injected placeholder content from existing spec context\\\",\\n63:       \\\"trigger\\\": [\\\"upgrade level\\\", \\\"level upgrade\\\", \\\"promote spec level\\\"],\\n64:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Developer\\\"],\\n65:       \\\"essential\\\": true,\\n66:       \\\"inputs\\\": {\\n67:         \\\"required\\\": \\\"Spec folder path, --to <2|3|3+>\\\",\\n68:         \\\"options\\\": \\\"--dry-run, --verbose, --json, --keep-backups\\\"\\n69:       },\\n70:       \\\"outputs\\\": [\\\"Upgraded spec docs\\\", \\\"Backup directory\\\", \\\"JSON result with --json\\\"],\\n71:       \\\"gate\\\": \\\"Documentation Level Upgrade\\\",\\n72:       \\\"version\\\": \\\"1.0.0\\\",\\n73:       \\\"dependencies\\\": [\\\"scripts/lib/shell-common.sh\\\", \\\"templates/\\\"]\\n74:     },\\n75:     {\\n76:       \\\"name\\\": \\\"check-prerequisites\\\",\\n77:       \\\"path\\\": \\\"runtime/cli/setup/check-prerequisites.sh\\\",\\n78:       \\\"type\\\": \\\"bash\\\",\\n79:       \\\"description\\\": \\\"Validate spec folder exists and contains required files for its level\\\",\\n80:       \\\"trigger\\\": [\\\"check prerequisites\\\", \\\"verify files\\\"],\\n81:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Implementation Phase\\\"],\\n82:       \\\"essential\\\": true,\\n83:       \\\"inputs\\\": {\\n84:         \\\"options\\\": \\\"--json, --require-tasks, --include-tasks, --paths-only\\\"\\n85:       },\\n86:       \\\"outputs\\\": [\\\"FEATURE_DIR path\\\", \\\"AVAILABLE_DOCS list\\\"],\\n87:       \\\"gate\\\": null,\\n88:       \\\"version\\\": \\\"2.0.0\\\",\\n89:       \\\"dependencies\\\": []\\n90:     },\\n91:     {\\n92:       \\\"name\\\": \\\"calculate-completeness\\\",\\n93:       \\\"path\\\": \\\"runtime/cli/spec/calculate-completeness.sh\\\",\\n94:       \\\"type\\\": \\\"bash\\\",\\n95:       \\\"description\\\": \\\"Calculate percentage of template placeholders replaced with real content\\\",\\n96:       \\\"trigger\\\": [\\\"calculate progress\\\", \\\"completeness\\\"],\\n97:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Progress Tracking\\\"],\\n98:       \\\"essential\\\": false,\\n99:       \\\"inputs\\\": {\\n100:         \\\"required\\\": \\\"Spec folder path\\\",\\n101:         \\\"options\\\": \\\"--verbose, --json, --file <path>, --quality\\\"\\n102:       },\\n103:       \\\"outputs\\\": [\\\"Completeness percentage\\\", \\\"Per-file breakdown (with --verbose)\\\"],\\n104:       \\\"gate\\\": null,\\n105:       \\\"version\\\": \\\"1.0.0\\\",\\n106:       \\\"dependencies\\\": []\\n107:     },\\n108:     {\\n109:       \\\"name\\\": \\\"test-validation\\\",\\n110:       \\\"path\\\": \\\"runtime/cli/tests/test-validation.sh\\\",\\n111:       \\\"type\\\": \\\"bash\\\",\\n112:       \\\"description\\\": \\\"Test runner for validate-spec.sh against fixture spec folders\\\",\\n113:       \\\"trigger\\\": [\\\"test validation\\\", \\\"run tests\\\"],\\n114:       \\\"calledBy\\\": [\\\"Developer\\\", \\\"CI/CD Pipeline\\\"],\\n115:       \\\"essential\\\": false,\\n116:       \\\"inputs\\\": {\\n117:         \\\"options\\\": \\\"-v (verbose), -t NAME (single test), -c CATEGORY, -l (list), -h (help)\\\"\\n118:       },\\n119:       \\\"outputs\\\": [\\\"Test pass/fail results\\\", \\\"Coverage report\\\"],\\n120:       \\\"gate\\\": null,\\n121:       \\\"version\\\": \\\"2.0.0\\\",\\n122:       \\\"dependencies\\\": [\\\"validate-spec.sh\\\", \\\"test-fixtures/\\\"]\\n123:     },\\n124:     {\\n125:       \\\"name\\\": \\\"create-spec-folder\\\",\\n126:       \\\"path\\\": \\\"runtime/cli/spec/create.sh\\\",\\n127:       \\\"type\\\": \\\"bash\\\",\\n128:       \\\"description\\\": \\\"Create new spec folders with appropriate templates based on documentation level\\\",\\n129:       \\\"trigger\\\": [\\\"create spec\