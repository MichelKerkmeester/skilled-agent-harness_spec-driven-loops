on\\\": \\\"1.0.0\\\",\\n73:       \\\"dependencies\\\": [\\\"runtime/cli/lib/shell-common.sh\\\", \\\"templates/\\\"]\\n74:     },\\n75:     {\\n76:       \\\"name\\\": \\\"check-prerequisites\\\",\\n77:       \\\"path\\\": \\\"runtime/cli/setup/check-prerequisites.sh\\\",\\n78:       \\\"type\\\": \\\"bash\\\",\\n79:       \\\"description\\\": \\\"Validate spec folder exists and contains required files for its level\\\",\\n80:       \\\"trigger\\\": [\\\"check prerequisites\\\", \\\"verify files\\\"],\\n81:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Implementation Phase\\\"],\\n82:       \\\"essential\\\": true,\\n83:       \\\"inputs\\\": {\\n84:         \\\"options\\\": \\\"--json, --require-tasks, --include-tasks, --paths-only\\\"\\n85:       },\\n86:       \\\"outputs\\\": [\\\"FEATURE_DIR path\\\", \\\"AVAILABLE_DOCS list\\\"],\\n87:       \\\"gate\\\": null,\\n88:       \\\"version\\\": \\\"2.0.0\\\",\\n89:       \\\"dependencies\\\": []\\n90:     },\\n91:     {\\n92:       \\\"name\\\": \\\"calculate-completeness\\\",\\n93:       \\\"path\\\": \\\"runtime/cli/spec/calculate-completeness.sh\\\",\\n94:       \\\"type\\\": \\\"bash\\\",\\n95:       \\\"description\\\": \\\"Calculate percentage of template placeholders replaced with real content\\\",\\n96:       \\\"trigger\\\": [\\\"calculate progress\\\", \\\"completeness\\\"],\\n97:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Progress Tracking\\\"],\\n98:       \\\"essential\\\": false,\\n99:       \\\"inputs\\\": {\\n100:         \\\"required\\\": \\\"Spec folder path\\\",\\n101:         \\\"options\\\": \\\"--verbose, --json, --file <path>, --quality\\\"\\n102:       },\\n103:       \\\"outputs\\\": [\\\"Completeness percentage\\\", \\\"Per-file breakdown (with --verbose)\\\"],\\n104:       \\\"gate\\\": null,\\n105:       \\\"version\\\": \\\"1.0.0\\\",\\n106:       \\\"dependencies\\\": []\\n107:     },\\n108:     {\\n109:       \\\"name\\\": \\\"test-validation\\\",\\n110:       \\\"path\\\": \\\"runtime/cli/tests/test-validation.sh\\\",\\n111:       \\\"type\\\": \\\"bash\\\",\\n112:       \\\"description\\\": \\\"Test runner for validate-spec.sh against fixture spec folders\\\",\\n113:       \\\"trigger\\\": [\\\"test validation\\\", \\\"run tests\\\"],\\n114:       \\\"calledBy\\\": [\\\"Developer\\\", \\\"CI/CD Pipeline\\\"],\\n115:       \\\"essential\\\": false,\\n116:       \\\"inputs\\\": {\\n117:         \\\"options\\\": \\\"-v (verbose), -t NAME (single test), -c CATEGORY, -l (list), -h (help)\\\"\\n118:       },\\n119:       \\\"outputs\\\": [\\\"Test pass/fail results\\\", \\\"Coverage report\\\"],\\n120:       \\\"gate\\\": null,\\n121:       \\\"version\\\": \\\"2.0.0\\\",\\n122:       \\\"dependencies\\\": [\\\"validate-spec.sh\\\", \\\"test-fixtures/\\\"]\\n123:     },\\n124:     {\\n125:       \\\"name\\\": \\\"create-spec-folder\\\",\\n126:       \\\"path\\\": \\\"runtime/cli/spec/create.sh\\\",\\n127:       \\\"type\\\": \\\"bash\\\",\\n128:       \\\"description\\\": \\\"Create new spec folders with appropriate templates based on documentation level\\\",\\n129:       \\\"trigger\\\": [\\\"create spec\\\", \\\"new spec folder\\\", \\\"Option B\\\"],\\n130:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Gate 3 (Option B)\\\"],\\n131:       \\\"essential\\\": true,\\n132:       \\\"inputs\\\": {\\n133:         \\\"required\\\": \\\"Feature description\\\",\\n134:         \\\"options\\\": \\\"--short-name, --level (1/2/3), --number, --skip-branch, --sharded, --subfolder\\\"\\n135:       },\\n136:       \\\"outputs\\\": [\\\"New spec folder with templates\\\", \\\"Git branch (optional)\\\"],\\n137:       \\\"gate\\\": \\\"Gate 3 (Spec Folder Creation)\\\",\\n138:       \\\"version\\\": \\\"2.0.0\\\",\\n139:       \\\"dependencies\\\": [\\\"templates/\\\"]\\n140:     },\\n141:     {\\n142:       \\\"name\\\": \\\"generate-nested-changelog\\\",\\n143:       \\\"path\\\": \\\"runtime/cli/dist/spec-folder/nested-changelog.js\\\",\\n144:       \\\"type\\\": \\\"node\\\",\\n145:       \\\"description\\\": \\\"Generate packet-local changelog content for a root spec folder or a nested phase child\\\",\\n146:       \\\"trigger\\\": [\\\"nested changelog\\\", \\\"packet changelog\\\", \\\"phase changelog\\\", \\\"spec changelog\\\"],\\n147:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Completion workflows\\\", \\\"Create changelog command\\\"],\\n148:       \\\"essential\\\": false,\\n149:       \\\"inputs\\\": {\\n150:         \\\"required\\\": \\\"Spec folder path\\\",\\n151:         \\\"options\\\": \\\"--json, --write, --mode <auto|root|phase>, --output <path>\\\"\\n152:       },\\n153:       \\\"outputs\\\": [\\\"Rendered markdown\\\", \\\"Nested changelog payload\\\", \\\"packet-local changelog file (with --write)\\\"],\\n154:       \\\"gate\\\": \\\"Completion workflow\\\",\\n155:       \\\"version\\\": \\\"1.0.0\\\",\\n156:       \\\"dependencies\\\": [\\\"runtime/cli/spec-folder/*.ts\\\", \\\"templates/changelog/\\\"]\\n157:     },\\n158:     {\\n159:       \\\"name\\\": \\\"recommend-level\\\",\\n160:       \\\"path\\\": \\\"runtime/cli/spec/recommend-level.sh\\\",\\n161:       \\\"type\\\": \\\"bash\\\",\\n162:       \\\"description\\\": \\\"Recommend documentation level based on task complexity factors\\\",\\n163:       \\\"trigger\\\": [\\\"recommend level\\\", \\\"what level\\\"],\\n164:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Gate 3\\\"],\\n165:       \\\"essential\\\": false,\\n166:       \\\"inputs\\\": {\\n167:         \\\"options\\\": \\\"--loc <number>, --files <number>, --auth, --api, --db, --architectural, --json\\\"\\n168:       },\\n169:       \\\"outputs\\\": [\\\"Recommended level (0-3)\\\", \\\"Score breakdown\\\"],\\n170:       \\\"gate\\\": null,\\n171:       \\\"version\\\": \\\"1.0.0\\\",\\n172:       \\\"dependencies\\\": []\\n173:     },\\n174:     {\\n175:       \\\"name\\\": \\\"archive-spec\\\",\\n176:       \\\"path\\\": \\\"runtime/cli/spec/archive.sh\\\",\\n177:       \\\"type\\\": \\\"bash\\\",\\n178:       \\\"description\\\": \\\"Move completed spec folders to archive, keeping specs/ directory clean\\\",\\n179:       \\\"trigger\\\": [\\\"archive spec\\\", \\\"move to archive\\\"],\\n180:       \\\"calledBy\\\": [\\\"AI Assistant\\\", \\\"Cleanup\\\"],\\n181:       \\\"essential\\\": false,\\n182:       \\\"inputs\\\": {\\n183:         \\\"required\\\": \\\"Spec folder path\\\",\\n184:         \\\"options\\\": \\\"--list, --restore <archived-folder>\\\"\\n185:       },\\n186:       \\\"outputs\\\": [\\\"Archived folder path\\\", \\\"Archive listing (with --list)\\\"],\\n187:       \\\"gate\\\": null,\\n188:       \\\"version\\\": \\\"1.0.0\\\",\\n189:       \\\"dependencies\\\": [\\\"calculate-completeness.sh\\\"]\\n190:     },\\n191:     {\\n192:       \\\"name\\\": \\\"common\\\",\\n193:       \\\"path\\\": \\\"runtime/cli/common.sh\\\",\\n194:       \\\"type\\\": \\\"bash\\\",\\n195:       \\\"description\\\": \\\"Repository and branch utilities - get_repo_root(), get_current_branch()\\\",\\n196:       \\\"trigger\\\": [],\\n197:       \\\"calledBy\\\": [\\\"Other scripts\\\"],\\n198:       \\\"essential\\\": true,\\n199:       \\\"inputs\\\": {},\\n200:       \\\"outputs\\\": [\\\"Utility functions\\\"],\\n201:       \\\"gate\\\": null,\\n202:       \\\"version\\\": \\\"2.0.0\\\",\\n203:       \\\"dependencies\\\": [],\\n204:       \\\"isLibrary\\\": true\\n205:     },\\n206:     {\\n207:       \\\"name\\\": \\\"test-embeddings-factory\\\",\\n208:       \\\"path\\\": \\\"runtime/cli/tests/test-embeddings-factory.cjs\\\",\\n209:       \\\"type\\\": \\\"node\\\",\\n210:       \\\"description\\\": \\\"Test and verify embedding provider configuration\\\",\\n211:       \\\"trigger\\\": [\\\"test embeddings\\\", \\\"verify provider\\\"],\\n212:       \\\"calledBy\\\": [\\\"Developer\\\", \\\"Debugging\\\"],\\n213:       \\\"essential\\\": false,\\n214:       \\\"inputs\\\": {},\\n215:       \\\"outputs\\\"