{"toolCallId":"call_345e400fc64046d1bed2528e96813d83","status":"completed","content":[{"type":"content","content":{"type":"text","text":"FILE_EXISTS | error |  | rules/check-files.sh\nPLACEHOLDER_FILLED | error |  | rules/check-placeholders.sh\nCOMMENT_HYGIENE_MARKER | error |  | rules/check-comment-hygiene.sh\nSCAFFOLD_NEVER_TOUCHED | error |  | rules/check-scaffold-never-touched.sh\nSTATUS_CROSS_DOC_CONSISTENCY | error |  | rules/check-status-cross-doc-consistency.sh\nLEVEL_DECLARED | info |  | rules/check-level.sh\nAC_COVERAGE | info |  | rules/check-ac-coverage.sh\nAC_CLOSURE | error |  | rules/check-ac-closure.sh\nANCHORS_VALID | error |  | native:orchestrator\nFRONTMATTER_MEMORY_BLOCK | error |  | ts:spec-doc-structure\nMERGE_LEGALITY | error |  | ts:spec-doc-structure\nSPEC_DOC_SUFFICIENCY | error |  | ts:spec-doc-structure\nCROSS_ANCHOR_CONTAMINATION | error |  | ts:spec-doc-structure\nPOST_SAVE_FINGERPRINT | error |  | ts:spec-doc-structure\nTOC_POLICY | error |  | rules/check-toc-policy.sh\nAI_PROTOCOLS | error |  | rules/check-ai-protocols.sh\nCOMPLEXITY_MATCH | error |  | rules/check-complexity.sh\nFOLDER_NAMING | error |  | rules/check-folder-naming.sh\nFRONTMATTER_VALID | error |  | rules/check-frontmatter.sh\nFRONTMATTER_VALUES | warn |  | rules/check-frontmatter-values.sh\nSOURCE_TAGS | warn |  | rules/check-source-tags.sh\nGREP_CONVENTION | error |  | rules/check-grep-convention.sh\nLEVEL_MATCH | error |  | rules/check-level-match.sh\nGRAPH_METADATA_PRESENT | warn |  | rules/check-graph-metadata.sh\nGRAPH_METADATA_CHILD_DRIFT | warn |  | rules/check-graph-metadata-child-drift.sh\nGRAPH_METADATA_CHILD_IDENTITY | error |  | rules/check-graph-metadata-child-identity.sh\nGRAPH_METADATA_SHAPE | warn |  | rules/check-graph-metadata-shape.sh\nMETADATA_DISK_PATH_CONSISTENCY | error |  | rules/check-metadata-disk-consistency.sh\nDESCRIPTION_SHAPE | warn |  | rules/check-description-shape.sh\nNORMALIZER_LINT | error |  | rules/check-normalizer-lint.sh\nSPEC_DOC_INTEGRITY | error |  | rules/check-spec-doc-integrity.sh\nTEMPLATE_SOURCE | error |  | rules/check-template-source.sh\nCANONICAL_SAVE_ROOT_SPEC_REQUIRED | error |  | rules/check-canonical-save-root-spec.sh\nCANONICAL_SAVE_SOURCE_DOCS_REQUIRED | error |  | rules/check-canonical-save-source-docs.sh\nCANONICAL_SAVE_LINEAGE_REQUIRED | error |  | rules/check-canonical-save-lineage.sh\nCANONICAL_SAVE_PACKET_IDENTITY_NORMALIZED | error |  | rules/check-canonical-save-packet-identity.sh\nCANONICAL_SAVE_DESCRIPTION_GRAPH_FRESHNESS | error |  | rules/check-canonical-save-description-graph-freshness.sh\nCONTINUITY_FRESHNESS | error | STRICT | validation/continuity-freshness.ts\nGENERATED_METADATA_INTEGRITY | error | STRICT | validation/generated-metadata-integrity.ts\nGENERATED_METADATA_DRIFT | error | STRICT | validation/generated-metadata-drift.ts\nLINKS_VALID | warn |  | rules/check-links.sh\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w8f3d32b7e3/tree","terminal_exit":{"terminal_id":"078369","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
