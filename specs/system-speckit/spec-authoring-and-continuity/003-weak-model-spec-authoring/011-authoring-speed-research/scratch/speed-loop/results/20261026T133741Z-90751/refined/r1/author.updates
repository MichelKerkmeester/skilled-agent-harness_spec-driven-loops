{"toolCallId":"call_759ca7028b00446f8ef39c72add4f1e3","status":"completed","content":[{"type":"content","content":{"type":"text","text":"25:  | 'SPEC_DOC_SUFFICIENCY'\n127:  'SPEC_DOC_SUFFICIENCY',\n152:  SPEC_DOC_SUFFICIENCY: [\n218: * anchor-sufficiency gates. The numbered levels list research/research.md as a\n320:  const lines = rawBlock.split('\\n');\n321:  for (let index = 0; index < lines.length; index += 1) {\n322:    const line = lines[index];\n338:  for (let index = 0; index < lines.length; index += 1) {\n339:    if (/^_memory:\\s*$/.test(lines[index])) {\n351:    const blockLines = [lines[memoryStart]];\n353:    for (; index < lines.length; index += 1) {\n354:      const line = lines[index];\n408:  const lines = block.split('\\n');\n409:  if (!/^_memory:\\s*(?:#.*)?$/.test(lines[0] ?? '')) {\n413:  for (let index = 0; index < lines.length; index += 1) {\n414:    const line = lines[index];\n591:  const lines = content.replace(/\\r\\n/g, '\\n').split('\\n');\n595:  for (let index = 0; index < lines.length; index += 1) {\n596:    const line = lines[index];\n808:    // pointer against the real folder leaf, so a two-segment minimum adds nothing.\n1166:    // Anchor-parse failures must cause SPEC_DOC_SUFFICIENCY to fail.\n1169:    // documents with corrupt anchor structure pass sufficiency validation.\n1257:    'SPEC_DOC_SUFFICIENCY',\n1259:    'All targeted spec-doc anchors meet the sufficiency baseline',\n1415:    case 'SPEC_DOC_SUFFICIENCY':\n1498:      'Usage: spec-doc-structure.ts --folder <path> --level <level> --rule <FRONTMATTER_MEMORY_BLOCK|MERGE_LEGALITY|SPEC_DOC_SUFFICIENCY|CROSS_ANCHOR_CONTAMINATION|POST_SAVE_FINGERPRINT> [--merge-plan-json <json>] [--contamination-json <json>] [--post-save-json <json>] [--output tsv|json]',\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w8f3d32b7e3/tree","terminal_exit":{"terminal