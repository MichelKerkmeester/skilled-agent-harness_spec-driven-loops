{"toolCallId":"call_34294cec983b49b89da2633d9dcaedb3","status":"completed","content":[{"type":"content","content":{"type":"text","text":"22:    'SPEC_DOC_SUFFICIENCY',\n46:    SPEC_DOC_SUFFICIENCY: [\n47:        'SPECDOC_SUFFICIENCY_001',\n48:        'SPECDOC_SUFFICIENCY_002',\n49:        'SPECDOC_SUFFICIENCY_003',\n50:        'SPECDOC_SUFFICIENCY_004',\n51:        'SPECDOC_SUFFICIENCY_005',\n52:        'SPECDOC_SUFFICIENCY_006',\n112: * anchor-sufficiency gates. The numbered levels list research/research.md as a\n880:                code: 'SPECDOC_SUFFICIENCY_005',\n897:                code: 'SPECDOC_SUFFICIENCY_006',\n961:        // Anchor-parse failures must cause SPEC_DOC_SUFFICIENCY to fail.\n964:        // documents with corrupt anchor structure pass sufficiency validation.\n968:                    code: 'SPECDOC_SUFFICIENCY_001',\n980:                        code: 'SPECDOC_SUFFICIENCY_001',\n990:                    code: 'SPECDOC_SUFFICIENCY_001',\n999:                code: 'SPECDOC_SUFFICIENCY_002',\n1007:                code: 'SPECDOC_SUFFICIENCY_002',\n1021:                    code: 'SPECDOC_SUFFICIENCY_004',\n1034:                        code: 'SPECDOC_SUFFICIENCY_003',\n1042:    return createResult('SPEC_DOC_SUFFICIENCY', diagnostics, 'All targeted spec-doc anchors meet the sufficiency baseline');\n1158:        case 'SPEC_DOC_SUFFICIENCY':\n1226:        throw new Error('Usage: spec-doc-structure.ts --folder <path> --level <level> --rule <FRONTMATTER_MEMORY_BLOCK|MERGE_LEGALITY|SPEC_DOC_SUFFICIENCY|CROSS_ANCHOR_CONTAMINATION|POST_SAVE_FINGERPRINT> [--merge-plan-json <json>] [--contamination-json <json>] [--post-save-json <json>] [--output tsv|json]');\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"98cec4","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
