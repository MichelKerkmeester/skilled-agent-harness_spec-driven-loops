[features]
hooks = true

# This server cannot run on just any Node: it bundles
# isolated-vm, which has no Node 25+ build and segfaults at isolate creation
# there. A segfault cannot be caught, so a wrong interpreter kills the whole MCP
# connection on the first tool call rather than failing at startup. The launcher
# reads the required range from the server's own package manifest and refuses to
# start when the host cannot satisfy it, which keeps the requirement with the
# package instead of with one machine's filesystem.
[mcp_servers.code_mode]
command = "node"
args = [".skilled/bin/mcp-code-mode-launcher.cjs"]

[mcp_servers.code_mode.env]
UTCP_CONFIG_FILE = ".utcp_config.json"

