+/** The decision-record exports this CLI needs, named so a source-run tree can supply them. */
+interface DecisionRecordWriterModule {
+  writeDecisionRecord: typeof writeDecisionRecord;
+  recordConsumedKeys: typeof recordConsumedKeys;
+  DecisionRecordWriteError: typeof DecisionRecordWriteError;
+}
+
+/**
+ * The runtime package builds its public barrel separately from this CLI. A source
+ * checkout can therefore hold a dist that predates a barrel export this CLI already
+ * imports; loading the writer's own module keeps a source-run save working there. A
+ * built install resolves the barrel export and never reaches the fallback.
+ */
+async function loadDecisionRecordWriter(): Promise<DecisionRecordWriterModule> {
+  if (typeof writeDecisionRecord === 'function') {
+    return { writeDecisionRecord, recordConsumedKeys, DecisionRecordWriteError };
+  }
+  return import('../../lib/continuity/decision-record-writer.js');
+}
+
