: string }>,\n805-): string {\n806-  const projected = docs\n807-    .map((doc) => projectDocForFingerprint(doc.relativePath, doc.content))\n808-    .sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0));\n809-  const hash = crypto.createHash('sha256').update(JSON.stringify(projected)).digest('hex');\n810-  return `sha256:${hash}`;\n811-}\n812-\n813-/**\n814- * Re-derive the source fingerprint for a spec folder by reading its canonical docs.\n815- *\n816- * Used by the strict read path that has only a folder path. It reads the same canonical doc\n817- * set the generator reads, so the re-derived fingerprint matches the stored one when the\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"e485ec","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
