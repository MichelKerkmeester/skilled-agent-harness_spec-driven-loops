{"toolCallId":"call_bb5df287c27e4ba59eb98fd74ff88758","status":"completed","content":[{"type":"content","content":{"type":"text","text":"16:// Dry by default; --apply writes. Everything --apply will write is named by the\n118:const USAGE = 'Usage: repair-derived.cjs [--folder <packet>]... [--roots <dir>] [--apply]';\n121:// exit code counts it. Carries no apply(): the re-derive is a child process the\n123:const REDERIVE_STEP = Object.freeze({ what: 're-derive graph metadata' });\n377:    apply: () => {\n401:        apply: () => {\n425:        apply: () => {\n451:        apply: () => {\n469:      what: `packet pointer -> ${pointer}`,\n470:      apply: () => {\n474:          throw new Error('the packet pointer left the frontmatter between the report and the write');\n500:async function repairFolder(folder, apply) {\n532:  if (!apply || planned.length === 0) return { folder, planned, authored, beyond };\n538:      edit.apply();\n605:  const options = { apply: false, folders: [], roots: 'specs' };\n608:    if (token === '--apply') {\n609:      options.apply = true;\n620:      // turn a dropped flag name — `repair-derived.cjs specs/one --apply` —\n670:  const { apply, folders: folderArgs, roots: rootsArg } = parseArgs(process.argv.slice(2));\n673:  const required = apply ? [VALIDATE, BACKFILL] : [VALIDATE];\n704:        result = await repairFolder(folder, apply);\n707:        // leave an --apply run without the account of what it already wrote.\n731:      } else if (apply) {\n736:        lines.push(`would repair ${folder}`);\n746:  process.stdout.write(`\\ninspected=${targets.length} ${apply ? `repaired=${repaired}` : `repairable=${pending}`} failed=${failed}\\n`);\n766:  if (!apply && pending > 0) {\n770:    process.stdout.write(`\\nTo apply these repairs:\\n  node ${path.relative(REPO, __filename)} ${scope} --apply\\n`);\n777:  process.exitCode = failed ? 2 : (!apply && pending > 0 ? 1 : 0);\n     795 .skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\