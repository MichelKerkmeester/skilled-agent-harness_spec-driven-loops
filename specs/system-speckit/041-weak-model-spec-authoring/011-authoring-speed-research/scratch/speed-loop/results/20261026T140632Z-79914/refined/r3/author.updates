{"toolCallId":"call_0a49151e34c24b5c8b1e6da24a49ed0f","status":"completed","content":[{"type":"content","content":{"type":"text","text":"935:function validateAnchorIntegrity(folder: string, level: SpecKitLevel): ValidationEntry {\n936-  // A phase parent carries a lean document set by design and has always been\n937-  // exempt here. Widening the check to cover it is a separate decision from\n938-  // reducing what the check asserts, so it keeps the exemption it had.\n939-  if (level === 'phase' && isPhaseParent(folder)) {\n940-    return entry('ANCHORS_VALID', 'pass', 'Phase parent lean document set accepted');\n941-  }\n942-\n943-  const findings: string[] = [];\n944-  const nestingFindings: string[] = [];\n945-  let checked = 0;\n946-\n947-  for (const docName of validationDocsForLevel(folder, level)) {\n948-    if (FREEFORM_WORKFLOW_DOCS.has(docName)) continue;\n949-    const actual = readIfExists(path.join(folder, docName));\n950-    if (!actual) continue;\n951-    // A document is expected to carry anchors only where its own template\n952-    // defines them. Some templated documents are deliberately free-form, and\n953-    // demanding an anchored surface they never had is inventing a requirement.\n954-    const template = renderedTemplate(level, docName);\n955-    if (template === null || anchors(template).length === 0) continue;\n956-    checked += 1;\n957-    const body = stripFences(actual);\n958-\n959-    const opens = [...body.matchAll(/<!--\\s*ANCHOR:([a-z0-9-]+)\\s*-->/gu)].map((m) => m[1]);\n960-    const closes = [...body.matchAll(/<!--\\s*\\/ANCHOR:([a-z0-9-]+)\\s*-->/gu)].map((m) => m[1]);\n961-\n962-    // Retrieval chunks by anchor and generated content is merged into one, so a\n963-    // document carrying none cannot participate in either.\n964-    if (opens.length === 0) findings.push(`${docName}: no anchors found`);\n965-\n966-    const seen = new Set<string>();\n967-    for (const id of opens) {\n968-      if (seen.has(id)) findings.push(`${docName}: duplicate anchor '${id}'`);\n969-      seen.add(id);\n970-    }\n971-    for (const id of opens) {\n972-      if (!closes.includes(id)) findings.push(`${docName}: anchor '${id}' is never closed`);\n973-    }\n974-    for (const id of closes) {\n975-      if (!opens.includes(id)) findings.push(`${docName}: anchor '${id}' is closed but never opened`);\n976-    }\n977-\n978-    // A stray closer ends its region early for retrieval and merging.\n979-    const openCounts = new Map<string, number>();\n980-    for (const id of opens) openCounts.set(id, (openCounts.get(id) ?? 0) + 1);\n981-    const closeCounts = new Map<string, number>();\n982-    for (const id of closes) closeCounts.set(id, (closeCounts.get(id) ?? 0) + 1);\n983-    for (const [id, closeCount] of closeCounts) {\n984-      const openCount = openCounts.get(id) ?? 0;\n985-      if (openCount > 0 && closeCount > openCount) {\n986-        findings.push(`${docName}: anchor '${id}' is closed more times than it is opened`);\n987-      }\n988-    }\n989-\n990-    // A v2.3 doc must keep every section its template requires, or a packet\n991-    // with a whole section deleted still passes. Older docs keep the\n992-    // integrity-only check they always had.\n993-    if (carriesTokenGateStamp(actual)) {\n994-      for (const section of requiredTemplateSections(level, docName)) {\n995-        if (!opens.includes(section.id)) {\n996-          findings.push(`${docName}: required anchor '${section.id}' is missing. Restore the '## ${section.heading}' section from the template`);\n997-        }\n998-      }\n999-    }\n1000-\n1001-    // Quoted marker syntax is documentation, not structure: an example in\n1002-    // backticks must not read as a real nested anchor.\n1003-    nestingFindings.push(...anchorNestingFindings(docName, stripInlineCode(body)));\n1004-  }\n1005-\n1006-  // A nested anchor makes retrieval return the wrong region, so nesting is an\n1007-  // error alongside the other integrity findings.\n1008-  const issueCount = findings.length + nestingFindings.length;\n1009-  if (issueCount > 0) {\n1010-    return entry('ANCHORS_VALID', 'error', `${issueCount} anchor integrity issue(s) found`, [\n1011-      ...findings,\n1012-      ...nestingFindings,\n1013-    ]);\n1014-  }\n1015-  return entry('ANCHORS_VALID', 'pass', `Anchors well formed in ${checked} file(s)`);\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"1e6445","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_0c644952ad6147b4949499e28cec7d2a","status":"completed","content":[{"type":"content","content":{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Canonical Save Description Graph Freshness\n// ───────────────────────────────────────────────────────────────────\n// Description and graph timestamps must stay within the slack window.\n\n'use strict';\n\nconst fs = require('fs');\nconst { CANONICAL_SAVE_CUTOFF, CANONICAL_SAVE_FRESHNESS_SLACK_MS, normalizePacketId, readContinuityPacketPointer, runRule } = require('./check-canonical-save-shared.cjs');\n\nrunRule('CANONICAL_SAVE_DESCRIPTION_GRAPH_FRESHNESS', (context, emit) => {\n  const descriptionTimestamp = context.description?.lastUpdated;\n  const graphTimestamp = context.graph?.derived?.last_save_at;\n  if (typeof descriptionTimestamp !== 'string' || typeof graphTimestamp !== 'string') {\n    emit('pass', 'Canonical-save freshness-skew check not applicable to this folder');\n    return;\n  }\n  const deltaMs = Date.parse(descriptionTimestamp) - Date.parse(graphTimestamp);\n  if (Number.isNaN(deltaMs) || deltaMs <= CANONICAL_SAVE_FRESHNESS_SLACK_MS) {\n    emit('pass', 'Description and graph freshness stay within the canonical-save slack window');\n    return;\n  }\n  emit(\n    'pass',\n    'Description and graph freshness skew detected (soft detector)',\n    [\n      `context.description.lastUpdated=${descriptionTimestamp}`,\n      `context.graph.derived.last_save_at=${graphTimestamp}`,\n      `deltaMs=${deltaMs}`,\n    ],\n  );\n});\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"a4a6e9","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
