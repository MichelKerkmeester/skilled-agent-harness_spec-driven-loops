 metadata: 'metadata_only',\n  metadata_only: 'metadata_only',\n  drop: 'drop',\n};\n\n// ───────────────────────────────────────────────────────────────────\n// 4. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction normalizeRuleName(raw: string | undefined): SpecDocRuleName {\n  const normalized = (raw ?? '')\n    .trim()\n    .toUpperCase()\n    .replace(/-/g, '_');\n\n  if (!SPEC_DOC_RULE_ORDER.includes(normalized as SpecDocRuleName)) {\n    throw new Error(`Unknown spec-doc rule: ${raw ?? '(empty)'}`);\n  }\n\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"174410","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
