{"toolCallId":"call_c44059a3902248fa92ae4e933f1e6ce2","status":"completed","content":[{"type":"content","content":{"type":"text","text":".skilled/skills/system-spec-kit/templates/core/spec.md.tmpl\n---\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:72:<!-- ANCHOR:metadata -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:94:<!-- /ANCHOR:metadata -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:98:<!-- ANCHOR:problem -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:107:<!-- /ANCHOR:problem -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:111:<!-- ANCHOR:scope -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:129:<!-- /ANCHOR:scope -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:133:<!-- ANCHOR:requirements -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:166:<!-- /ANCHOR:requirements -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:170:<!-- ANCHOR:success-criteria -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:176:<!-- /ANCHOR:success-criteria -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:180:<!-- ANCHOR:risks -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:188:<!-- /ANCHOR:risks -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:197:<!-- ANCHOR:nfr -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:200:<!-- /ANCHOR:nfr -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:243:<!-- ANCHOR:edge-cases -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:246:<!-- /ANCHOR:edge-cases -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:276:<!-- ANCHOR:complexity -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:300:<!-- /ANCHOR:complexity -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:316:<!-- ANCHOR:questions -->\n.skilled/skills/system-spec-kit/templates/core/spec.md.tmpl:322:<!-- /AN