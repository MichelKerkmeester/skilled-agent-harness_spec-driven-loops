{"toolCallId":"call_b42663143b964f829a85c03a61ad719e","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1159:function validateSpecDocSufficiency(folder: string, level: string): RuleResult {\n1160-  const diagnostics: RuleDiagnostic[] = [];\n1161-  const contract = resolveLevelContract(normalizeSpecKitLevel(level));\n1162-\n1163-  for (const document of collectDocuments(folder, level)) {\n1164-    const parsed = parseAnchors(document.content);\n1165-\n1166-    // Anchor-parse failures must cause SPEC_DOC_SUFFICIENCY to fail.\n1167-    // Previously, parse errors were silently ignored and the function would\n1168-    // continue checking whatever anchors were partially parsed, letting\n1169-    // documents with corrupt anchor structure pass sufficiency validation.\n1170-    if (parsed.errors.length > 0) {\n1171-      for (const error of parsed.errors) {\n1172-        diagnostics.push({\n1173-          code: 'SPECDOC_SUFFICIENCY_001',\n1174-          severity: 'error',\n1175-          detail: `${document.basename}: anchor parse failure: ${error}`,\n1176-        });\n1177-      }\n1178-    }\n1179-\n1180-    const anchorMap = new Map(parsed.anchors.map((anchor) => [anchor.id, anchor]));\n1181-\n1182-    if (LAZY_DOCS_WITH_STATIC_ANCHORS.has(document.basename)) {\n1183-      const expectedAnchors = contract.sectionGatesByDocument.get(document.basename);\n1184-      for (const anchorId of expectedAnchors?.keys() ?? []) {\n1185-        if (!anchorMap.has(anchorId)) {\n1186-          diagnostics.push({\n1187-            code: 'SPECDOC_SUFFICIENCY_001',\n1188-            severity: 'error',\n1189-            detail: `${document.basename}: missing required anchor '${anchorId}'`,\n1190-          });\n1191-        }\n1192-      }\n1193-    }\n1194-\n1195-    for (const anchor of parsed.anchors) {\n1196-      if (anchor.body.trim().length === 0) {\n1197-        diagnostics.push({\n1198-          code: 'SPECDOC_SUFFICIENCY_001',\n1199-          severity: 'error',\n1200-          detail: `${document.basename}:${anchor.id} is empty`,\n1201-        });\n1202-      }\n1203-    }\n1204-\n1205-    const whatBuilt = anchorMap.get('what-built');\n1206-    if (whatBuilt && !/(?:`[^`]+`|\\[[^\\]]+\\]\\([^)]+\\)|[A-Za-z0-9._/-]+\\.(?:ts|tsx|js|md|sh))/m.test(whatBuilt.body)) {\n1207-      diagnostics.push({\n1208-        code: 'SPECDOC_SUFFICIENCY_002',\n1209-        severity: 'warning',\n1210-        detail: `${document.basename}:what-built is missing a concrete file, code, or artifact citation`,\n1211-      });\n1212-    }\n1213-\n1214-    const verification = anchorMap.get('verification');\n1215-    if (verification && !/(?:`[^`]+`|\\bPASS\\b|\\bEVIDENCE\\b|\\bvitest\\b|\\bvalidate\\.sh\\b|\\bnpm\\b|\\bcoverage\\b|\\btested\\b)/i.test(verification.body)) {\n1216-      diagnostics.push({\n1217-        code: 'SPECDOC_SUFFICIENCY_002',\n1218-        severity: 'warning',\n1219-        detail: `${document.basename}:verification is missing a concrete command or verification artifact`,\n1220-      });\n1221-    }\n1222-\n1223-    if (/research(?:\\/research)?\\.md$/.test(document.basename)) {\n1224-      // Generated research artifacts carry citations in plain prose rather than\n1225-      // anchor blocks, so an anchor-only scan reports every one of them as\n1226-      // uncited. Fall back to the document body when no anchors are present.\n1227-      const citedResearch = parsed.anchors.length > 0\n1228-        ? parsed.anchors.some((anchor) => looksLikeCitation(anchor.body))\n1229-        : looksLikeCitation(document.content);\n1230-      if (!citedResearch) {\n1231-        diagnostics.push({\n1232-          code: 'SPECDOC_SUFFICIENCY_004',\n1233-          severity: 'warning',\n1234-          detail: `${document.basename}: research content is missing a citation`,\n1235-        });\n1236-      }\n1237-    }\n1238-\n1239-    if (document.basename === GOAL_DOC) {\n1240-      validateGoalDocument(folder, level, document.content, diagnostics);\n1241-    }\n1242-\n1243-    if (document.basename === 'decision-record.md') {\n1244-      for (const anchor of parsed.anchors.filter((entry) => entry.id.startsWith('adr-'))) {\n1245-        if (/-(?:decision|alternatives|consequences)$/.test(anchor.id) && anchor.body.trim().length < 24) {\n1246-          diagnostics.push({\n1247-            code: 'SPECDOC_SUFFICIENCY_003',\n1248-            severity: 'warning',\n1249-            detail: `${document.basename}:${anchor.id} looks incomplete for ADR content`,\n1250-          });\n1251-        }\n1252-      }\n1253-    }\n1254-  }\n1255-\n1256-  return createResult(\n1257-    'SPEC_DOC_SUFFICIENCY',\n1258-    diagnostics,\n1259-    'All targeted spec-doc anchors meet the sufficiency baseline',\n1260-  );\n1261-}\n1262-\n1263-function inferCategory(text: string): string {\n1264-  const normalized = text.trim();\n1265-  if (!normalized) {\n1266-    return 'drop';\n1267-  }\n1268-  if (/CONVERSATION_LOG|toolCalls?|assistant:|user:|system:/i.test(normalized)) {\n1269-    return 'drop';\n1270-  }\n1271-  if (/^-\\s+\\[[ xX]\\]|\\bT\\d{3}\\b|\\bCHK-\\d{3}\\b/m.test(normalized)) {\n1272-    return 'task_update';\n1273-  }\n1274-  if (/_memory|packet_pointer:|fingerprint:|session_dedup|completion_pct|open_questions:/i.test(normalized)) {\n1275-    return 'metadata_only';\n1276-  }\n1277-  if (/\\bADR-\\d+\\b|\\bwe chose\\b|\\bdecision\\b/i.test(normalized)) {\n1278-    return 'decision_log';\n1279-  }\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"42522d","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
