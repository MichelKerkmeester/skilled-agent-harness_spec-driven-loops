"deferred\": [],\n43:     \"blocked\": [],\n44:     \"graphCoverageMode\": \"graphless_fallback\"\n45:   },\n46:   \"traceability\": {\n47:     \"summary\": {\n48:       \"required\": 2,\n49:       \"executed\": 0,\n50:       \"pass\": 0,\n51:       \"partial\": 0,\n52:       \"fail\": 0,\n53:       \"blocked\": 0,\n54:       \"notApplicable\": 0,\n55:       \"gatingFailures\": 0\n56:     },\n57:     \"results\": []\n58:   },\n59:   \"divergence\": {\n60:     \"started\": [],\n61:     \"completed\": [],\n62:     \"failed\": [],\n63:     \"overrides\": [],\n64:     \"saturatedDirections\": [],\n65:     \"remainingFrontier\": [],\n66:     \"currentFocus\": \"\"\n67:   },\n68:   \"fieldWarnings\": [],\n69:   \"corruptionWarnings\": []\n70: }\n\n(End of file - total 70 lines)\n</content>","metadata":{"preview":"{\n  \"sessionId\": \"fanout-luna-opencode-1791264733860-t333md\",\n  \"generation\": 1,\n  \"lineageMode\": \"new\",\n  \"openFindings\": [],\n  \"resolvedFindings\": [],\n  \"blockedStopHistory\": [],\n  \"persistentSameSeverity\": [],\n  \"severityChanged\": [],\n  \"repeatedFindings\": [],\n  \"dimensionCoverage\": {\n    \"correctness\": false,\n    \"security\": false,\n    \"traceability\": false,\n    \"maintainability\": false\n  },\n  \"findingsBySeverity\": {\n    \"P0\": 0,\n    \"P1\": 0,\n    \"P2\": 0","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/090-deep-review-okf-adoption/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode/deep-review-findings-registry.json","text":"{\n  \"sessionId\": \"fanout-luna-opencode-1791264733860-t333md\",\n  \"generation\": 1,\n  \"lineageMode\": \"new\",\n  \"openFindings\": [],\n  \"resolvedFindings\": [],\n  \"blockedStopHistory\": [],\n  \"persistentSameSeverity\": [],\n  \"severityChanged\": [],\n  \"repeatedFindings\": [],\n  \"dimensionCoverage\": {\n    \