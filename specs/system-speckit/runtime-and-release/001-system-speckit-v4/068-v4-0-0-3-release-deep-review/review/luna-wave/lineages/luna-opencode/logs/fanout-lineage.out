e allowed write surface","status":"pending","priority":"high"}],"truncated":false},"title":"4 todos","time":{"start":1791271189795,"end":1791271189799}},"metadata":{"openai":{"itemId":"fc_075cde0f88a81593016ac4a1153da887d2b50ca5c782f04314"}},"id":"prt_110153bda001kHUqyTG8KnXDiB","sessionID":"ses_eefeb8112ffeSAe808XV03S3PD","messageID":"msg_110150783001DToKvaZINsJLPn"}}
