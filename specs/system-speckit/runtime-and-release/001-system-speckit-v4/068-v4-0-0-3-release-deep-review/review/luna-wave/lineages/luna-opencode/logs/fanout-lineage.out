pecs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/lineages/deepseek-flash-max/deep-review-state.jsonl\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/090-deep-review-okf-adoption/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode/containment/baseline/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/lineages/deepseek-flash-max/deep-review-dashboard.md\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/090-deep-review-okf-adoption/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode/containment/quarantine/1/content/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/lineages/swe2-max/deep-review-audit-ledger/frames/0000000000000012.frame\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/090-deep-review-okf-adoption/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode/containment/quarantine/1/content/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/lineages/swe2-max/deep-review-audit-ledger/frames/0000000000000010.frame\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/090-deep-review-okf-adoption/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode/containment/quarantine/1/content/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/lineages/swe2-max/deep-review-audit-ledger/frames/0000000000000009.frame\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/090-deep-review-okf-adoption/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode/containment/quarantine/1/content/specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/lineages/swe2-max/deep-review-audit-ledger/frames/0000000000000011.frame\n\n(Results are truncated: showing first 100 results. Consider using a more specific path or pattern.)","metadata":{"count":100,"truncated":true},"title":"specs/system-speckit/033-system-speckit-v4/068-v4-0-0-3-release-deep-review/review/luna-wave/lineages/luna-opencode","time":{"start":1791271233160,"end":1791271233173}},"metadata":{"openai":{"itemId":"fc_07194c283c321859016ac4a13fb64087d2b3ff43698c6172cf"}},"id":"prt_11015e629001DdLuwO1aC6YdAv","sessionID":"ses_eefeb8112ffeSAe808XV03S3PD","messageID":"msg_1101587df0017oVC7OpL7AyxPV"}}
