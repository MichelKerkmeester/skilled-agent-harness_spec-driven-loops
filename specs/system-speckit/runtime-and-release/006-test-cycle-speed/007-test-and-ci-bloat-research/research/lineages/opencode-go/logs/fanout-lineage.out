see FAIL lines above).\" >&2\n      echo \"Fix: keep each fact in its one canonical home and point to it; see\" >&2\n      echo \"     .opencode/skills/sk-prompt/assets/cli-prompt-quality-card.md.\" >&2\n      echo \"Bypass: SPECKIT_SKIP_CARD_SYNC=1 git commit ...\" >&2\n      exit 1\n    fi\n  fi\nfi\n\n# --- MCP mutation-class gate (blocking) ---\n# When an mcp-* install/doctor script, the install-doctor workflow or the guard's\n# mutation-class manifest is staged,\n# enforce the read-only / mutating contract: a \"read-only\" doctor that grows an\n# unguarded mutation or unbounded network call (or a missing manifest label)\n# fails the commit. Guards against the doctor-that-connected-to-all-servers and\n# the installer-that-wiped-a-global-cache regressions.\n# Bypass: SPECKIT_SKIP_MCP_MUTATION_CLASS=1 git commit ...\nif [[ \"${SPECKIT_SKIP_MCP_MUTATION_CLASS:-0}\" != \"1\" ]]; then\n  MUTCLASS_GUARD=\"${SOURCE_ROOT}/commands/doctor/scripts/check-mcp-mutation-class.sh\"\n  if git_bounded diff --cached --name-only --diff-filter=ACM \\\n       | grep -Eq '^\\.(opencode|skilled)/(skills/(mcp-tooling/)?mcp-[a-z-]+/(scripts/(doctor|install)[a-z.-]*\\.sh|mcp-servers/[^/]+/setup\\.sh)|commands/doctor/assets/(doctor-mcp-install|mcp-mutation-class-manifest)\\.yaml)$'; then\n    if [[ ! -f \"$MUTCLASS_GUARD\" ]]; then\n      if _in_toolchain_repo; then\n        echo \"\" >&2\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/MEGA/Development/Skilled && grep -nE '_ENGINE=|_CHECKER=|_SCRIPT=|_LINTER=|_SIGNALS=|_CARD=|_CLASS=|LEAF=|DOCTOR=|SIGNALS=|CARD=|MCP=|_GATE=|_CHECK=|_TOOL=' .skilled/scripts/git-hooks/pre-commit | head -30; echo \\\"=== 480-640 heads\\\"; sed -n 480,500p .skilled/scripts/git-hooks/pre-commit; sed -n 584,625p .skilled/scripts/git-hooks/pre-commit\"}"},"time":{"start":1794468813128,"end":1794468814068}}}}
