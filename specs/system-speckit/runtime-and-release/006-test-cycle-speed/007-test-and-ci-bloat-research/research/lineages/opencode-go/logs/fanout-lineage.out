ep -E '\\\\.(test|spec|vitest)\\\\.(ts|js|mjs|cjs|tsx)$|_test\\\\.py$|test_.*\\\\.py$|\\\\.bats$|\\\\.test\\\\.sh$' | sed -E 's/.*\\\\.((test|spec|vitest)\\\\.[a-z]+|py|sh|bats)$/\\\\1/' | sort | uniq -c | sort -rn; echo \\\"--- doctor test file types\\\"; ls .skilled/commands/doctor/scripts/tests/ | sed -E 's/.*\\\\.([a-z]+)$/\\\\1/' | sort | uniq -c\"}"},"time":{"start":1794469405833,"end":1794469407082}}}}
