{"type":"tool_use","timestamp":1794468810249,"sessionID":"ses_e3154f688fferuJUyllFRey6r8","part":{"partID":"prt_1cead09c4002RmBh7bWUAD0uTL","sessionID":"ses_e3154f688fferuJUyllFRey6r8","messageID":"msg_1ceacfec3001clWADIQfdqqRDn","type":"tool","id":"call_00_88sm62feqhji4hxwbdb6mrcz","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled && sed -n 95,150p .skilled/scripts/git-hooks/pre-commit; echo \"=== vars\"; grep -nE '^(HYGIENE_FLAG_HELPER|PHRASE_LINTER|MIRROR_CHECKER|DOCV_ENGINE|MIRROR_SCRIPT|LEAF|DOCTOR|SIGNALS|CARD|MCP|AGENT_[A-Z_]+|COMMENT_CHECKER)=|^[A-Z_]+=\"\\$SOURCE_ROOT' .skilled/scripts/git-hooks/pre-commit | head -40"},"output":"if [[ -r \"$_bounded_git_lib\" ]]; then\n  # shellcheck source=lib/bounded-git.sh\n  . \"$_bounded_git_lib\"\n  git_bound_arm\nelse\n  echo \"WARNING [gate:git-timeout]: $_bounded_git_lib is missing, so git calls here run without a time bound.\" >&2\n  git_bounded() { git -c core.fsmonitor=false \"$@\"; }\n  git_bound_finish() { exit \"$1\"; }\nfi\n_pre_commit_exit() {\n  local rc=$?\n  rm -rf \"${HYGIENE_DIR:-}\"\n  git_bound_finish \"$rc\"\n}\ntrap _pre_commit_exit EXIT\n\n# Mass-deletion guard: retained at pre-push only. A local commit is reversible with\n# git reset; a push reaches other machines and the live-branch autosync.\n\n# The doc-model reference validator moved to CI. It scanned the whole tree on every\n# commit for output that was advisory and could not block, which made it the single\n# most expensive thing here for no enforcement in return.\n\n# --- Private skill guard (blocking) ---\n# A private skill belongs to the operator, not to this repository: staging one\n# publishes a file that exists only on this machine. Names are read NUL-separated,\n# so a path with a space or non-ASCII bytes is refused rather than skipped, and\n# --diff-filter=ACMRT ignores a staged deletion, which publishes nothing, while a\n# type change still counts because the new blob is published. The match\n# is on the path name, so a renamed copy is not caught; a content match would need\n# a manifest of private bytes to compare against, and this guard owns no such\n# manifest. There is no bypass variable and no gate-config row: staging a private\n# skill is never correct.\n# A local-* command is private the same way: its router, its assets folder and\n# the mirror each runtime generator derives from it all carry the local- name.\nPRIVATE_SKILL_RE='^\\.(skilled|opencode|claude|pi|devin|codex|cursor)/skills/local-[^/]+(/|$)'\nPRIVATE_COMMAND_RE='^\\.(skilled|opencode|claude|cursor)/commands/(assets/)?local-[^/]+(/|$)|^\\.(codex|pi)/prompts/local-[^/]+(/|$)'\nPRIVATE_STAGED=()\nwhile IFS= read -r -d '' PRIVATE_PATH; do\n  if [[ \"$PRIVATE_PATH\" =~ $PRIVATE_SKILL_RE || \"$PRIVATE_PATH\" =~ $PRIVATE_COMMAND_RE ]]; then\n    PRIVATE_STAGED+=(\"$PRIVATE_PATH\")\n  fi\ndone < <(git_bounded diff --cached --name-only -z --diff-filter=ACMRT)\nif [[ \"${#PRIVATE_STAGED[@]}\" -gt 0 ]]; then\n  echo \"BLOCKED [gate:private-skill]: a private skill or command is staged and would be published:\" >&2\n  for PRIVATE_PATH in \"${PRIVATE_STAGED[@]}\"; do\n    echo \"  $PRIVATE_PATH\" >&2\n    echo \"  Fix: git rm --cached -r -- \\\"$PRIVATE_PATH\\\"\" >&2\n  done\n  exit 1\nfi\n\n# --- Comment hygiene gate (blocking) ---\n# Blocks commits that add ephemeral-artifact pointers in code comment lines.\n# Bypass: SPECKIT_SKIP_COMMENT_HYGIENE=1 git commit ...\n# See: .opencode/skills/sk-code/sk-code-quality/references/code-style-guide.md §4\n=== vars\n151:COMMENT_CHECKER=\"${SOURCE_ROOT}/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh\"\n226:PHRASE_LINTER=\"$SOURCE_ROOT/skills/system-spec-kit/runtime/cli/spec/template-phrase-lint.mjs\"\n244:MIRROR_CHECKER=\"$SOURCE_ROOT/bin/check-agent-mirror-sync.cjs\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"if [[ -r \"$_bounded_git_lib\" ]]; then\n  # shellcheck source=lib/bounded-git.sh\n  . \"$_bounded_git_lib\"\n  git_bound_arm\nelse\n  echo \"WARNING [gate:git-timeout]: $_bounded_git_lib is missing, so git calls here run without a time bound.\" >&2\n  git_bounded() { git -c core.fsmonitor=false \"$@\"; }\n  git_bound_finish() { exit \"$1\"; }\nfi\n_pre_commit_exit() {\n  local rc=$?\n  rm -rf \"${HYGIENE_DIR:-}\"\n  git_bound_finish \"$rc\"\n}\ntrap _pre_commit_exit EXIT\n\n# Mass-deletion guard: retained at pre-push only. A local commit is reversible with\n# git reset; a push reaches other machines and the live-branch autosync.\n\n# The doc-model reference validator moved to CI. It scanned the whole tree on every\n# commit for output that was advisory and could not block, which made it the single\n# most expensive thing here for no enforcement in return.\n\n# --- Private skill guard (blocking) ---\n# A private skill belongs to the operator, not to this repository: staging one\n# publishes a file that exists only on this machine. Names are read NUL-separated,\n# so a path with a space or non-ASCII bytes is refused rather than skipped, and\n# --diff-filter=ACMRT ignores a staged deletion, which publishes nothing, while a\n# type change still counts because the new blob is published. The match\n# is on the path name, so a renamed copy is not caught; a content match would need\n# a manifest of private bytes to compare against, and this guard owns no such\n# manifest. There is no bypass variable and no gate-config row: staging a private\n# skill is never correct.\n# A local-* command is private the same way: its router, its assets folder and\n# the mirror each runtime generator derives from it all carry the local- name.\nPRIVATE_SKILL_RE='^\\.(skilled|opencode|claude|pi|devin|codex|cursor)/skills/local-[^/]+(/|$)'\nPRIVATE_COMMAND_RE='^\\.(skilled|opencode|claude|cursor)/commands/(assets/)?local-[^/]+(/|$)|^\\.(codex|pi)/prompts/local-[^/]+(/|$)'\nPRIVATE_STAGED=()\nwhile IFS= read -r -d '' PRIVATE_PATH; do\n  if [[ \"$PRIVATE_PATH\" =~ $PRIVATE_SKILL_RE || \"$PRIVATE_PATH\" =~ $PRIVATE_COMMAND_RE ]]; then\n    PRIVATE_STAGED+=(\"$PRIVATE_PATH\")\n  fi\ndone < <(git_bounded diff --cached --name-only -z --diff-filter=ACMRT)\nif [[ \"${#PRIVATE_STAGED[@]}\" -gt 0 ]]; then\n  echo \"BLOCKED [gate:private-skill]: a private skill or command is staged and would be published:\" >&2\n  for PRIVATE_PATH in \"${PRIVATE_STAGED[@]}\"; do\n    echo \"  $PRIVATE_PATH\" >&2\n    echo \"  Fix: git rm --cached -r -- \\\"$PRIVATE_PATH\\\"\" >&2\n  done\n  exit 1\nfi\n\n# --- Comment hygiene gate (blocking) ---\n# Blocks commits that add ephemeral-artifact pointers in code comment lines.\n# Bypass: SPECKIT_SKIP_COMMENT_HYGIENE=1 git commit ...\n# See: .opencode/skills/sk-code/sk-code-quality/references/code-style-guide.md §4\n=== vars\n151:COMMENT_CHECKER=\"${SOURCE_ROOT}/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh\"\n226:PHRASE_LINTER=\"$SOURCE_ROOT/skills/system-spec-kit/runtime/cli/spec/template-phrase-lint.mjs\"\n244:MIRROR_CHECKER=\"$SOURCE_ROOT/bin/check-agent-mirror-sync.cjs\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/MEGA/Development/Skilled && sed -n 95,150p .skilled/scripts/git-hooks/pre-commit; echo \\\"=== vars\\\"; grep -nE '^(HYGIENE_FLAG_HELPER|PHRASE_LINTER|MIRROR_CHECKER|DOCV_ENGINE|MIRROR_SCRIPT|LEAF|DOCTOR|SIGNALS|CARD|MCP|AGENT_[A-Z_]+|COMMENT_CHECKER)=|^[A-Z_]+=\\\"\\\\$SOURCE_ROOT' .skilled/scripts/git-hooks/pre-commit | head -40\"}"},"time":{"start":1794468809156,"end":1794468810249}}}}
