   813	    const closeCounts = new Map<string, number>();
   814	    for (const id of closes) closeCounts.set(id, (closeCounts.get(id) ?? 0) + 1);
   815	    for (const [id, closeCount] of closeCounts) {
   816	      const openCount = openCounts.get(id) ?? 0;
   817	      if (openCount > 0 && closeCount > openCount) {
   818	        findings.push(`${docName}: anchor '${id}' is closed more times than it is opened`);
   819	      }
   820	    }
   821	
   822	    // Quoted marker syntax is documentation, not structure: an example in
