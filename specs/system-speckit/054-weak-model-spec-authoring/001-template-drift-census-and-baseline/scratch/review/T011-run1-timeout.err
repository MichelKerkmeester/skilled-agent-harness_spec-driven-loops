   247	function parseCliArgs(args: string[]): { level: RenderLevel; outDir?: string; filePaths: string[] } | { error: string } | null {
   248	  const levelIndex = args.indexOf('--level');
   249	  const outDirIndex = args.indexOf('--out-dir');
   250	  const valueIndexes = new Set<number>();
   251	  if (levelIndex >= 0) valueIndexes.add(levelIndex + 1);
   252	  if (outDirIndex >= 0) valueIndexes.add(outDirIndex + 1);
   253	  // A token that follows --level or --out-dir is that option's value even when it
   254	  // starts with --, so only tokens in option position can be unknown options.
   255	  const unknownOption = args.find(
   256	    (arg, index) => arg.startsWith('--') && arg !== '--level' && arg !== '--out-dir' && !valueIndexes.has(index),
   257	  );
   258	  if (unknownOption) {
   259	    return { error: unknownOption };
   260	  }
   261	  if (levelIndex === -1 || !args[levelIndex + 1]) {
   262	    return null;
   263	  }
   264	  const level = args[levelIndex + 1] as RenderLevel;
   265	  const outDir = outDirIndex >= 0 ? args[outDirIndex + 1] : undefined;
   266	  if (outDirIndex >= 0 && !outDir) {
   267	    return null;
   268	  }
   269	  const filePaths = args.filter((arg, index) => {
   270	    if (index === levelIndex || index === levelIndex + 1) return false;
   271	    if (outDirIndex >= 0 && (index === outDirIndex || index === outDirIndex + 1)) return false;
   272	    return !arg.startsWith('--');
   273	  });
   274	  return { level, outDir, filePaths };
   275	}
   276	
   277	async function readStdin(): Promise<string> {
   278	  const chunks: Buffer[] = [];
   279	  for await (const chunk of process.stdin) {
   280	    chunks.push(Buffer.from(chunk));
   281	  }
   282	  return Buffer.concat(chunks).toString('utf8');
   283	}
