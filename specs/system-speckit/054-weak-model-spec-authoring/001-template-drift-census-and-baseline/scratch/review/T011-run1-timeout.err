   761	// Anchors are load-bearing: merging generated content into a document, chunking
   762	// it for retrieval, and search metadata all read them. What those consumers need
   763	// is that anchors exist and are well formed — not that a document's anchor set
   764	// matches whatever the template says this week. Diffing against a template that
   765	// is edited weekly regraded the whole corpus on every template commit, which is
   766	// a moving target masquerading as a contract.
   767	function validateAnchorIntegrity(folder: string, level: SpecKitLevel): ValidationEntry {
   768	  // A phase parent carries a lean document set by design and has always been
   769	  // exempt here. Widening the check to cover it is a separate decision from
   770	  // reducing what the check asserts, so it keeps the exemption it had.
   771	  if (level === 'phase' && isPhaseParent(folder)) {
   772	    return entry('ANCHORS_VALID', 'pass', 'Phase parent lean document set accepted');
   773	  }
   774	
   775	  const findings: string[] = [];
   776	  const nestingFindings: string[] = [];
   777	  let checked = 0;
   778	
   779	  for (const docName of validationDocsForLevel(folder, level)) {
   780	    if (FREEFORM_WORKFLOW_DOCS.has(docName)) continue;
   781	    const actual = readIfExists(path.join(folder, docName));
   782	    if (!actual) continue;
   783	    // A document is expected to carry anchors only where its own template
   784	    // defines them. Some templated documents are deliberately free-form, and
   785	    // demanding an anchored surface they never had is inventing a requirement.
   786	    const template = renderedTemplate(level, docName);
   787	    if (template === null || anchors(template).length === 0) continue;
   788	    checked += 1;
   789	    const body = stripFences(actual);
   790	
   791	    const opens = [...body.matchAll(/<!--\s*ANCHOR:([a-z0-9-]+)\s*-->/gu)].map((m) => m[1]);
   792	    const closes = [...body.matchAll(/<!--\s*\/ANCHOR:([a-z0-9-]+)\s*-->/gu)].map((m) => m[1]);
   793	
   794	    // Retrieval chunks by anchor and generated content is merged into one, so a
   795	    // document carrying none cannot participate in either.
   796	    if (opens.length === 0) findings.push(`${docName}: no anchors found`);
   797	
   798	    const seen = new Set<string>();
   799	    for (const id of opens) {
   800	      if (seen.has(id)) findings.push(`${docName}: duplicate anchor '${id}'`);
   801	      seen.add(id);
   802	    }
   803	    for (const id of opens) {
   804	      if (!closes.includes(id)) findings.push(`${docName}: anchor '${id}' is never closed`);
   805	    }
   806	    for (const id of closes) {
   807	      if (!opens.includes(id)) findings.push(`${docName}: anchor '${id}' is closed but never opened`);
   808	    }
