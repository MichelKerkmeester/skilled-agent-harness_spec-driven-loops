{"toolCallId":"call_faf99ab71848456d8cd41f232625fe69","status":"completed","content":[{"type":"content","content":{"type":"text","text":"    readErrors,\n  };\n}\n\n/**\n * Resolve a drift report into a single validation status given the rollout mode.\n *\n * Under grandfather report mode any drift resolves to a non-blocking `info`, so a legacy folder\n * reports but does not fail strict during the migration window. With grandfather off it resolves\n * to `error` so the gate is enforced. A clean or unchecked folder always passes.\n *\n * @param report - The drift report to resolve\n * @param opts - Whether grandfather report mode is active\n * @returns The resolved rule status, message and detail lines\n */\nexport function resolveGeneratedMetadataDrift(\n  report: GeneratedMetadataDriftReport,\n  opts: { grandfather: boolean },\n): ResolvedDriftStatus {\n  if (!report.checked) {\n    return {\n      rule: GENERATED_METADATA_DRIFT_RULE,\n      status: 'pass',\n      message: 'No generated metadata and source doc pair present to compare',\n      details: [],\n    };\n  }\n\n  const hasFindings = report.driftedFields.length > 0 || report.readErrors.length > 0;\n  if (!hasFindings) {\n    const note = report.ungraded ? ' (ungraded, no source_doc_hashes yet)' : '';\n    return {\n      rule: GENERATED_METADATA_DRIFT_RULE,\n      status: 'pass',\n      message: `Generated synopsis fields match the current docs${note}`,\n      details: [],\n    };\n  }\n\n  const details = [\n    ...report.driftedFields.map(\n      (drift) => `${drift.field}: stored '${drift.stored}' drifted from fresh '${drift.fresh}'`,\n    ),\n    ...report.readErrors,\n  ];\n  const mode = opts.grandfather ? 'grandfather report mode' : 'enforced';\n  return {\n    rule: GENERATED_METADATA_DRIFT_RULE,\n    status: opts.grandfather ? 'info' : 'error',\n    message: `Generated metadata drift found ${report.driftedFields.length} drifted field(s) (${mode})`,\n    details,\n  };\n}\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"49dbef","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_ffc269bb6ec7443e96a3a236798d813a","status":"completed","content":[{"type":"content","content":{"type":"text","text":"21:  derivePacketSynopsis,\n22-  type SynopsisField,\n23-} from '../description/packet-synopsis.js';\n24-\n25-// ───────────────────────────────────────────────────────────────────\n26-// 2. CONSTANTS\n27-// ───────────────────────────────────────────────────────────────────\n28-\n29-/** Validation rule id reported for the generated-metadata drift gate. */\n30-export const GENERATED_METADATA_DRIFT_RULE = 'GENERATED_METADATA_DRIFT' as const;\n31-\n32-// The packet docs whose content the synopsis can read. spec.md is the one the precedence\n33-// derives from; the rest round out an honest freshness key so any source edit moves a hash.\n34-// Conservative by design: a hash change that is not a synopsis change only triggers a re-derive,\n35-// it never hides one.\n36-const SYNOPSIS_SOURCE_DOCS = [\n37-  'spec.md',\n38-  'plan.md',\n39-  'tasks.md',\n40-  'decision-record.md',\n41-  'implementation-summary.md',\n42-  path.join('research', 'research.md'),\n43-  'research.md',\n44-  'handover.md',\n45-  'resource-map.md',\n46-] as const;\n47-\n48-// ───────────────────────────────────────────────────────────────────\n49-// 3. TYPE DEFINITIONS\n50-// ───────────────────────────────────────────────────────────────────\n51-\n52-/** One generated synopsis field whose stored value no longer matches a fresh re-derivation. */\n53-export interface DriftedSynopsisField {\n54-  field: SynopsisField;\n55-  stored: string;\n56-  fresh: string;\n57-}\n58-\n59-/** Result of comparing a spec folder's stored synopsis fields against a fresh re-derivation. */\n60-export interface GeneratedMetadataDriftReport {\n61-  rule: typeof GENERATED_METADATA_DRIFT_RULE;\n62-  /** Whether a generated field plus a readable spec.md were present to compare. */\n63-  checked: boolean;\n64-  driftedFields: DriftedSynopsisField[];\n65-  /** Whether the persisted source_doc_hashes differ from the current source docs. */\n66-  hashDrift: boolean;\n67-  /** True when the folder predates the hash key, so it is reported as ungraded not in-sync. */\n68-  ungraded: boolean;\n69-  readErrors: string[];\n70-}\n71-\n72-/** A drift report resolved to a validator-consumable pass/error/info status and message. */\n73-export interface ResolvedDriftStatus {\n74-  rule: typeof GENERATED_METADATA_DRIFT_RULE;\n75-  status: 'pass' | 'error' | 'info';\n76-  message: string;\n77-  details: string[];\n78-}\n79-\n80-// ───────────────────────────────────────────────────────────────────\n81-// 4. HELPERS\n--\n270:    const fresh = derivePacketSynopsis(specContent, 'description');\n271-    if (fresh !== storedDescription) {\n272-      driftedFields.push({ field: 'description', stored: storedDescription, fresh });\n273-    }\n274-  }\n275-\n276-  const storedCausalSummary = graph ? readStoredCausalSummary(graph) : null;\n277-  if (storedCausalSummary !== null) {\n278:    const fresh = derivePacketSynopsis(specContent, 'causal_summary');\n279-    if (fresh !== storedCausalSummary) {\n280-      driftedFields.push({ field: 'causal_summary', stored: storedCausalSummary, fresh });\n281-    }\n282-  }\n283-\n284-  return {\n285-    rule: GENERATED_METADATA_DRIFT_RULE,\n286-    checked: true,\n287-    driftedFields,\n288-    hashDrift,\n289-    ungraded,\n290-    readErrors,\n291-  };\n292-}\n293-\n294-/**\n295- * Resolve a drift report into a single validation status given the rollout mode.\n296- *\n297- * Under grandfather report mode any drift resolves to a non-blocking `info`, so a legacy folder\n298- * reports but does not fail strict during the migration window. With grandfather off it resolves\n299- * to `error` so the gate is enforced. A clean or unchecked folder always passes.\n300- *\n301- * @param report - The drift report to resolve\n302- * @param opts - Whether grandfather report mode is active\n303- * @returns The resolved rule status, message and detai