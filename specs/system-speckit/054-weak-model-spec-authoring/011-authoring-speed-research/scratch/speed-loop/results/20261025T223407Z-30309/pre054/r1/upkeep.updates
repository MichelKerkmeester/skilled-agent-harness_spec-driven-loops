     {\n        \"name\": \"Task Notation\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Completion Criteria\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      }\n    ],\n    \"causal_summary\": \"`recommend-level.sh` prints a level, a score, a confidence figure, a four-line breakdown and a phase section\",\n    \"created_at\": \"2026-10-25T22:34:18Z\",\n    \"last_save_at\": \"2026-10-25T22:38:03.121Z\",\n    \"save_lineage\": \"graph_only\",\n    \"last_accessed_at\": null,\n    \"source_docs\": [\n      \"spec.md\",\n      \"plan.md\",\n      \"tasks.md\",\n      \"acceptance-criteria.md\",\n      \"implementation-summary.md\"\n    ],\n    \"source_fingerprint\": \"sha256:f7d5f53988a359c2aabd86909f4794b86c75cc2bd1d2aa3e82286bc15da7e743\",\n    \"source_fingerprint_docset\": 3,\n    \"source_doc_hashes\": {\n      \"spec.md\": \"a602acd677bccaa527ac8eff750320fac50dc9ba6f42436b4b2d65ff067e64f5\",\n      \"plan.md\": \"5128621035159cf74269827aa91a6fa864dd9929f9bff62fed3d5858f475dcde\",\n      \"tasks.md\": \"8debf3fc38b7eb7b95ef9e1e1ee33846904d8c5e47f3e6741d9abed9f1bf5629\",\n      \"implementation-summary.md\": \"98507dc0af99888d60f755473ff7ca51c29a1e37d29ffbe4826d8106f7b3dd68\"\n    },\n    \"last_active_at\": null\n  }\n}\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"1c5625","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
