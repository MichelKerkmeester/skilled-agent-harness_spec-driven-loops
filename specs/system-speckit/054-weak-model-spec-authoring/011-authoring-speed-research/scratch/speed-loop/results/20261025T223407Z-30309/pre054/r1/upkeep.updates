{"toolCallId":"call_d9e947fc1df846cf9a1d0e462621d316","status":"completed","content":[{"type":"content","content":{"type":"text","text":"135:/** Options for {@link refreshGraphMetadataForSpecFolder}. */\n136-export interface GraphMetadataRefreshOptions {\n137-  now?: Date | string;\n138-  statusOverride?: string | null;\n139-  saveLineage?: SaveLineage;\n140-  prune?: boolean;\n141-}\n142-\n143-/** Result of refreshing a spec folder's graph-metadata.json: where it was written and whether it was newly created. */\n144-export interface GraphMetadataRefreshResult {\n145-  filePath: string;\n146-  metadata: GraphMetadata;\n147-  created: boolean;\n148-}\n149-\n150-/** A children_ids entry that no longer resolves to a folder on disk, flagged for pruning. */\n151-export interface GraphMetadataPruneCandidate {\n152-  childId: string;\n153-  targetPath: string;\n154-  existsOnDisk: boolean;\n155-}\n156-\n157-type GraphMetadataDocReadResult =\n158-  | { status: 'found'; content: string }\n159-  | { status: 'missing' }\n160-  | { status: 'unknown'; error: string };\n161-\n162-interface CollectedPacketDocs {\n163-  docs: ParsedSpecDoc[];\n164-  availability: Map<string, GraphMetadataDocReadResult['status']>;\n165-}\n166-\n167-interface LegacyGraphMetadataParseResult {\n168-  metadata: GraphMetadata;\n169-  fabricatedFields: string[];\n170-}\n171-\n172-// ───────────────────────────────────────────────────────────────────\n173-// 4. HELPERS\n174-// ───────────────────────────────────────────────────────────────────\n175-\n176-function toIsoString(value?: Date | string | null): string {\n177-  if (value instanceof Date) {\n178-    return value.toISOString();\n179-  }\n180-  if (typeof value === 'string' && ISO_DATE_RE.test(value)) {\n181-    return value;\n182-  }\n183-  return new Date().toISOString();\n184-}\n185-\n186-function parseJsonObject(content: string): unknown {\n187-  return JSON.parse(content) as unknown;\n188-}\n189-\n190-function parseDelimitedValues(raw: string | null | undefined): string[] {\n191-  if (!raw || typeof raw !== 'string') {\n192-    return [];\n193-  }\n194-\n195-  return raw\n--\n1894:export function refreshGraphMetadataForSpecFolder(\n1895-  specFolderPath: string,\n1896-  options: GraphMetadataRefreshOptions = {},\n1897-): GraphMetadataRefreshResult {\n1898-  const resolvedSpecFolderPath = path.resolve(specFolderPath);\n1899-  let canonicalSpecFolderPath: string;\n1900-  try {\n1901-    canonicalSpecFolderPath = fs.realpathSync(resolvedSpecFolderPath);\n1902-  } catch {\n1903-    throw new Error(`Spec folder path is invalid or contains a broken symlink: ${resolvedSpecFolderPath}`);\n1904-  }\n1905-\n1906-  if (!canClassifyAsGraphMetadataPath(path.join(canonicalSpecFolderPath, GRAPH_METADATA_FILENAME))) {\n1907-    throw new Error(`Spec folder is not under a supported specs root: ${canonicalSpecFolderPath}`);\n1908-  }\n1909-\n1910-  const filePath = path.join(canonicalSpecFolderPath, GRAPH_METADATA_FILENAME);\n1911-  const existing = loadGraphMetadata(filePath);\n1912-  const refreshed = deriveGraphMetadata(canonicalSpecFolderPath, existing, {\n1913-    ...options,\n1914-    saveLineage: options.saveLineage ?? 'graph_only',\n1915-  });\n1916-  const mergeInput = options.prune\n1917-    ? preserveExistingChildrenOnDisk(canonicalSpecFolderPath, existing, refreshed)\n1918-    : refreshed;\n1919-  const merged = mergeGraphMetadata(existing, mergeInput, { prune: options.prune });\n1920-\n1921-  // Idempotent write: when a re-derive produced no content change (only last_save_at\n1922-  // would move), skip the write entirely. Without this, every save rewrites this\n1923-  // packet's last_save_at, and a broad re-index churns hundreds of files' timestamps\n1924-  // with no real delta, burying genuine changes in working-tree noise. A no-op\n1925-  // re-derive has no new state worth stamping, so returning the existing payload is\n1926-  // correct. Any real change still writes (and still bumps last_save_at).\n1927-  if (existing && graphMetadataEqualIgnoringVolatile(existing, merged)) {\n1928-    return {\n1929-      filePath,\n1930-      metadata: existing,\n1931-      created: false,\n1932-    };\n1933-  }\n1934-\n1935-  writeGraphMetadataFile(filePath, merged);\n1936-\n1937-  return {\n1938-    filePath,\n1939-    metadata: merged,\n1940-    created: existing === null,\n1941-  };\n1942-}\n1943-\n1944:/** Alias for {@link refreshGraphMetadataForSpecFolder}, taking an already-resolved folder path. */\n1945-export function refreshGraphMetadata(\n1946-  specFolderPath: string,\n1947-  options: GraphMetadataRefreshOptions = {},\n1948-): GraphMetadataRefreshResult {\n1949:  return refreshGraphMetadataForSpecFolder(specFolderPath, options);\n1950-}\n1951-\n1952-/**\n1953- * Convert graph metadata into a searchable text block for indexing.\n1954- *\n1955- * @param metadata - Metadata payload to flatten into indexable text\n1956- * @returns Plain-text summary containing packet relationships and derived fields\n1957- */\n1958-export function graphMetadataToIndexableText(metadata: GraphMetadata): string {\n1959-  const lines = [\n1960-    `Packet: ${metadata.packet_id}`,\n1961-    `Spec Folder: ${metadata.spec_folder}`,\n1962-    `Status: ${metadata.derived.status}`,\n1963-    `Importance Tier: ${metadata.derived.importance_tier}`,\n1964-    `Summary: ${metadata.derived.causal_summary}`,\n1965-  ];\n1966-\n1967-  if (metadata.parent_id) {\n1968-    lines.push(`Parent: ${metadata.parent_id}`);\n1969-  }\n1970-  if (metadata.migrated) {\n1971-    lines.push('Migrated: true');\n1972-    lines.push(`Migration Source: ${metadata.migration_source ?? 'legacy'}`);\n1973-  }\n1974-  if (metadata.children_ids.length > 0) {\n1975-    lines.push(`Children: ${metadata.children_ids.join(', ')}`);\n1976-  }\n1977-  if (metadata.derived.trigger_phrases.length > 0) {\n1978-    lines.push(`Trigger Phrases: ${metadata.derived.trigger_phrases.join(', ')}`);\n1979-  }\n1980-  if (metadata.derived.key_topics.length > 0) {\n1981-    lines.push(`Key Topics: ${metadata.derived.key_topics.join(', ')}`);\n1982-  }\n1983-  if (metadata.derived.key_files.length > 0) {\n1984-    lines.push(`Key Files: ${metadata.derived.key_files.join(', ')}`);\n1985-  }\n1986-  if (metadata.manual.depends_on.length > 0) {\n1987-    lines.push(`Depends On: ${metadata.manual.depends_on.map((ref) => ref.packet_id).join(', ')}`);\n1988-  }\n1989-  if (metadata.manual.supersedes.length > 0) {\n1990-    lines.push(`Supersedes: ${metadata.manual.supersedes.map((ref) => ref.packet_id).join(', ')}`);\n1991-  }\n1992-  if (metadata.manual.related_to.length > 0) {\n1993-    lines.push(`Related To: ${metadata.manual.related_to.map((ref) => ref.packet_id).join(', ')}`);\n1994-  }\n1995-  if (metadata.derived.source_docs.length > 0) {\n1996-    lines.push(`Source Docs: ${metadata.derived.source_docs.join(', ')}`);\n1997-  }\n1998-\n1999-  return `${lines.join('\\n')}\\n`;\n2000-}\n2001-\n2002-/**\n2003- * Convert packet references into causal-link buckets used by indexing.\n2004- *\n2005- * @param manual - Manual relationship section from graph metadata\n2006- * @returns Packet IDs grouped by causal-link relation\n2007- */\n2008-export function packetReferencesToCausalLinks(manual: GraphMetadataManual): Record<string, string[]> {\n2009-  return {\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"6c1967","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
