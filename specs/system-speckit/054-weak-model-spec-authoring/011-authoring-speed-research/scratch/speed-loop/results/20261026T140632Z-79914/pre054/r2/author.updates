raph = JSON.parse(fs.readFileSync(graphPath, 'utf8')) as { derived: { ln: string } };\n.skilled/skills/system-spec-kit/runtime/cli/tests/create-root-numbering.vitest.ts:    expect(graph.derived.ln).toBe('Phase 3: third-step');\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/079-anchors-adr-allowance/graph-metadata.json:    \"ln\": \"Validator regression fixtures must remain valid as the template contract evolves\",\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:// description and the ln from one precedence over the same spec.md, each honoring\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:const DRIFT_GATE_FLAG = 'SPECKIT_ln_GATE';\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:  // stored ln comes from the shared extractor and source_doc_hashes are persisted.\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:    const causalSummary = derivePacketSynopsis(content, 'ln');\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:    expect(causalSummary.length).toBeLessThanOrEqual(SYNOPSIS_FIELD_LIMITS.ln);\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:    const causalBefore = derivePacketSynopsis(before, 'ln');\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:    const causalAfter = derivePacketSynopsis(after, 'ln');\n.skilled/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts:    expect(driftedFields).toEqual(['ln', 'description']);\n.skilled/skills/system-spec-kit/runtime/cli/tests/track-roots.vitest.ts:    derived: { trigger_phrases: [], key_topics: [name], ln: `Track folder for ${name}.` },\n.skilled/skills/system-spec-kit/runtime/cli/tests/graph-metadata-refresh.vitest.ts:        ln: 'Phase-parent root with stale-identity children to prune.',\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/002-valid-level1/graph-metadata.json:    \"ln\": \"A tiny fixture feature that exports one note to a text file for validation baseline checks\",\n.skilled/skills/system-spec-kit/runtime/cli/tests/spec-root-phase-pointer.vitest.ts:        ln: '',\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/063-template-compliant-level3/graph-metadata.json:    \"ln\": \"Validator regression fixtures must remain valid as the template contract evolves\",\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"7e8eff","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
