{"toolCallId":"call_1d6656941e914db897a967479a76f9ed","status":"completed","content":[{"type":"content","content":{"type":"text","text":".skilled/skills/system-spec-kit/runtime/cli/tests/check-ac-closure.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/check-ac-coverage.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/check-graph-metadata-child-drift.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/check-graph-metadata-shape-last-active-child.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/fingerprint-docset-generation.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/graph-metadata-write-containment.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-dist-freshness.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-system.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-upgrade-level.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-validation-extended.sh\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-validation.sh\n---\n#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: Test Upgrade Level\n# ───────────────────────────────────────────────────────────────\n# Tests regression coverage for upgrade-level.sh\n# Covers the regression surface: shell-common guard, dry-run, level detection,\n# input validation, already-at-target, and a missing spec.md.\n# COMPATIBILITY: bash 3.2+ (macOS default)\n\nset -euo pipefail\n\n# ───────────────────────────────────────────────────────────────\n# 1. CONFIGURATION\n# ───────────────────────────────────────────────────────────────\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nUPGRADE_SCRIPT=\"$SCRIPT_DIR/../spec/upgrade-level.sh\"\nSHELL_COMMON=\"$SCRIPT_DIR/../lib/shell-common.sh\"\n\n# Test counters\nPASS=0; FAIL=0; SKIP=0; TOTAL=0\n\npass() { PASS=$((PASS+1)); TOTAL=$((TOTAL+1)); echo \"  PASS: $1\"; }\nfail() { FAIL=$((FAIL+1)); TOTAL=$((TOTAL+1)); echo \"  FAIL: $1\"; }\nskip() { SKIP=$((SKIP+1)); TOTAL=$((TOTAL+1)); echo \"  SKIP: $1\"; }\nbegin_category() { echo \"\"; echo \"── $1 ──\"; }\n\n# Cleanup tracking\nCLEANUP_DIRS=()\n\ncleanup_all() {\n    local i=0\n    while [[ $i -lt ${#CLEANUP_DIRS[@]} ]]; do\n        [[ -d \"${CLEANUP_DIRS[$i]}\" ]] && rm -rf \"${CLEANUP_DIRS[$i]}\"\n        i=$((i + 1))\n    done\n}\ntrap cleanup_all EXIT\n\nmake_temp_dir() {\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"13b1ef","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
