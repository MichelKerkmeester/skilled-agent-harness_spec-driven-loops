{"toolCallId":"call_a18c2a3f9e884de9bbe427b7cff1218a","status":"completed","content":[{"type":"content","content":{"type":"text","text":"10:// --prune-report writes .backfill-graph-metadata-prune-report.json under the\n103:  // the current docs. Populated from a read-only re-derive, never a write side effect.\n207: * specs root, so a link at the destination is refused rather than followed: a write\n211: * of receiving the write.\n213:export function writePruneReportArtifact(\n234:    fs.writeFileSync(descriptor, content, 'utf-8');\n241:      try { fs.closeSync(descriptor); } catch { /* The original write error is more useful. */ }\n244:      try { fs.rmSync(temporary, { force: true }); } catch { /* The original write error is more useful. */ }\n361: * write generated metadata into both.\n374: * Validate a scoped target through the supported-root checks before any write.\n377: * outside a supported specs root, and a graph-metadata path the writer rules\n403:    return { ok: false, error: `target graph-metadata path fails the writer rules: ${graphPath}` };\n635:  // reviews equals what apply writes: stale-identity entries are never retained.\n654: * graph-metadata path fails the writer rules is skipped, and one corrupt\n691:    // Match the writer rules so a candidate the writer would reject never\n694:      summary.skipped.push({ specFolder: specFolderPath, reason: 'writer_rule' });\n748:      // Surface synopsis drift as a read-only report. The check never writes, so it holds in\n778:/** Execute the report/confirm gate before delegating to the metadata writer. */\n805:    writePruneReportArtifact(reportPath, artifact);\n842:    process.stderr.write(`backfill-graph-metadata: ${plan.error}\\n`);\n849:    process.stderr.write(`backfill-graph-metadata: root outside the repository: ${plan.options.root}\\n`);\n855:    process.stderr.write(`backfill-graph-metadata: ${result.error}\\n`);\n859:  process.stdout.write(`${JSON.stringify(result.summary, null, 2)}\\n`);\n"}}],"_m