{"toolCallId":"call_3d2d9a87cdf34f0385d50a28a4067fe4","status":"completed","content":[{"type":"content","content":{"type":"text","text":"12:// which cannot be derived from anything and must be written by whoever did the\n41:const BACKFILL = '.skilled/skills/system-spec-kit/runtime/cli/graph/backfill-graph-metadata.ts';\n67://   GRAPH_METADATA_SHAPE is structural and included, because the re-derive\n85:// The subset a re-derive can actually settle, because they are assertions about\n86:// graph-metadata.json itself. The others describe description.json contents and\n87:// in-document reference paths, which a re-derive does not write; planning one\n106:// Mirrors SPEC_FOLDER_RE in backfill-graph-metadata.ts.\n118:const USAGE = 'Usage: repair-derived.cjs [--folder <packet>]... [--roots <dir>] [--apply]';\n121:// exit code counts it. Carries no apply(): the re-derive is a child process the\n123:const REDERIVE_STEP = Object.freeze({ what: 're-derive graph metadata' });\n241:const REWRITE_TARGETS = ['description.json', 'graph-metadata.json', ...DOCS];\n248:// Measured set: the packet files the re-derive child opened through planted links. Mirrors the packet document lists of the graph parser, the drift check and folder discovery.\n259:  'description.json',\n279:// Re-derive imports packet documents, so a link must resolve within the same packet.\n280:function linkedRederiveInputs(folder) {\n326:    fs.writeFileSync(descriptor, text, 'utf8');\n347:  const file = path.join(folder, 'description.json');\n369:  // the scaffold level kept a derived number its own documents disagree with,\n376:    what: `description level ${verb} -> ${level}`,\n411:  const description = path.join(folder, 'description.json');\n412:  const descriptionText = readIfPresent(description);\n413:  if (descriptionText !== null) {\n416:      data = JSON.parse(descriptionText);\n423:        file: description,\n424:        what: `description specFolder -> ${pointer}`,\n426:          const current = JSON.parse(readForWrite(description));\n428:          writeAtomic(description, `${JSON.stringify(current, null, 2)}\\n`);\n435:  // not one, and a re-derive computes null. The graph merge keeps a stored\n436:  // parent over a null re-derive and flags it for review, so after a move the\n438:  const graph = path.join(folder, 'graph-metadata.json');\n439:  const graphText = path.basename(path.dirname(path.resolve(REPO, folder))) === 'z_archive' ? readIfPresent(graph) : null;\n440:  if (graphText !== null) {\n443:      data = JSON.parse(graphText);\n445:      // A graph file that cannot be read is the re-derive's to report.\n449:        file: graph,\n450:        what: `graph parent ${data.parent_id} -> none, the packet is archived`,\n452:          const current = JSON.parse(readForWrite(graph));\n455:          writeAtomic(graph, `${JSON.stringify(current, null, 2)}\\n`);\n483:async function rederive(folder) {\n514:  // re-derive is part of the repair rather than a follow-up; skipping it swaps\n519:  // re-derive into a packet whose graph file is a link would replace the link with a\n520:  // regular file. A linked graph file is therefore never re-derived, and the dry run\n522:  const graphIsLink = isSymbolicLink(path.join(folder, 'graph-metadata.json'));\n523:  const rederiveNeeded = !graphIsLink && (edits.length > 0 || staleMetadata);\n524:  const planned = rederiveNeeded ? [...edits, REDERIVE_STEP] : [...edits];\n545:  // Re-derive after a partial failure too: the edits that did land have already\n547:  // step exists to prevent. A linked graph file is the one case where it cannot\n549:  if (!graphIsLink && (wrote > 0 || staleMetadata)) {\n550:    // A link among the re-derive's inputs is refused here, whether it was present at planning or\n553:    const linked = linkedRederiveInputs(folder);\n554:    const reason = linked.length > 0 ? `${linked[0]}: ${SYMLINK_REFUSAL}` : await rederive(folder);\n555:    if (reason && !failure) failure = `re-derive: ${reason}`;\n620:      // turn a dropped flag name — `repair-derived.cjs specs/one --apply` —\n793:  else process.stderr.write(`repair-derived failed: ${(err && err.stack) || err}\\n`);\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"43fcd6","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_4b42c333108e42218d78065ea812fe91","status":"completed","content":[{"type":"content","content":{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Generated Metadata Drift Gate\n// ───────────────────────────────────────────────────────────────────\n// Re-derives one spec folder and compares the two stored synopsis fields against a fresh\n// derivation, so a description.json or graph-metadata.json that fell out of sync with the docs\n// it summarizes is provable rather than silently stale. The gate reads and reports only: it\n// never writes the folder, so it cannot churn the very files it exists to keep clean. Severity\n// resolution is left to the caller so the same check backs both the grandfather report rollout\n// and the enforced run. It pairs with source_doc_hashes, a cheap freshness key so a strict run\n// can skip the re-derive on a folder whose source docs are unchanged.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport crypto from 'node:crypto';\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nimport {\n  derivePacketSynopsis,\n  type SynopsisField,\n} from '../description/packet-synopsis.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n/** Validation rule id reported for the generated-metadata drift gate. */\nexport const GENERATED_METADATA_DRIFT_RULE = 'GENERATED_METADATA_DRIFT' as const;\n\n// The packet docs whose content the synopsis can read. spec.md is the one the precedence\n// derives from; the rest round out an honest freshness key so any source edit moves a hash.\n// Conservative by design: a hash change that is not a synopsis change only triggers a re-derive,\n// it never hides one.\nconst SYNOPSIS_SOURCE_DOCS = [\n  'spec.md',\n  'plan.md',\n  'tasks.md',\n  'decision-record.md',\n  'implementation-summary.md',\n  path.join('research', 'research.md'),\n  'research.md',\n  'handover.md',\n  'resource-map.md',\n] as const;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** One generated synopsis field whose stored value no longer matches a fresh re-derivation. */\nexport interface DriftedSynopsisField {\n  field: SynopsisField;\n  stored: string;\n  fresh: string;\n}\n\n/** Result of comparing a spec folder's stored synopsis fields against a fresh re-derivation. */\nexport interface GeneratedMetadataDriftReport {\n  rule: typeof GENERATED_METADATA_DRIFT_RULE;\n  /** Whether a generated field plus a readable spec.md were present to compare. */\n  checked: boolean;\n  driftedFields: DriftedSynopsisField[];\n  /** Whether the persisted source_doc_hashes differ from the current source docs. */\n  hashDrift: boolean;\n  /** True when the folder predates the hash key, so it is reported as ungraded not in-sync. */\n  ungraded: boolean;\n  readErrors: string[];\n}\n\n/** A drift report resolved to a validator-consumable pass/error/info status and message. */\nexport interface ResolvedDriftStatus {\n  rule: typeof GENERATED_METADATA_DRIFT_RULE;\n  status: 'pass' | 'error' | 'info';\n  message: string;\n  details: string[];\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\n/**\n * Hash the source docs the synopsis derives from, keyed by their packet-relative path.\n *\n * A doc edit changes its hash, giving the drift gate a cheap freshness key it can compare\n * before paying for a re-derive. Only present docs are hashed, so an absent doc carries no key\n * rather than a hash of empty content.\n *\n * @param folderPath - Absolute or relative path to the spec folder\n * @returns A map of relative doc path to sha256 hex digest for each present source doc\n */\nexport function computeSourceDocHashes(folderPath: string): Record<string, string> {\n  const folder = path.resolve(folderPath);\n  const hashes: Record<string, string> = {};\n  for (const relativePath of SYNOPSIS_SOURCE_DOCS) {\n    const docPath = path.join(folder, relativePath);\n    let content: string;\n    try {\n      // A linked parent can expose another packet's source, so hash only local targets.\n      if (!isWithinPacketFolder(docPath, folder)) continue;\n      content = fs.readFileSync(docPath, 'utf-8');\n    } catch {\n      continue;\n    }\n    hashes[relativePath.replace(/\\\\/g, '/')] = crypto.createHash('sha256').update(content).digest('hex');\n  }\n  return hashes;\n}\n\nfunction isWithinPacketFolder(filePath: string, packetFolderPath: string): boolean {\n  try {\n    const realPacketFolderPath = fs.realpathSync(packetFolderPath);\n    const realFilePath = fs.realpathSync(filePath);\n    const relativePath = path.relative(realPacketFolderPath, realFilePath);\n    return relativePath === '' || (\n      relativePath !== '..'\n      && !relativePath.startsWith(`..${path.sep}`)\n      && !path.isAbsolute(relativePath)\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"539292","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
