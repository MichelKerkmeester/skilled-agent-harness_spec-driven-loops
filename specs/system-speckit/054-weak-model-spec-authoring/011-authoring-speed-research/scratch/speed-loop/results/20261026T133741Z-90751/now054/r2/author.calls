{"toolCallId":"call_5ec8f8d757114149a87ae3d9c007b65d","title":"Read lines 60-220 in ./.skilled/skills/system-spec-kit/runtime/cli/rules/check-spec-doc-integrity.sh","kind":"execute","content":[{"type":"content","content":{"type":"resource","resource":{"mimeType":"text/x-shellscript","text":"sed -n '60,220p' .skilled/skills/system-spec-kit/runtime/cli/rules/check-spec-doc-integrity.sh","uri":"tool://preview"},"_meta":{"cognition.ai/preview_is_shell_command":true}}}],"rawInput":{"command":"sed -n '60,220p' .skilled/skills/system-spec-kit/runtime/cli/rules/check-spec-doc-integrity.sh"},"_meta":{"cognition.ai/commandNames":["sed"],"cognition.ai/inferenceToolName":"exec"}}
