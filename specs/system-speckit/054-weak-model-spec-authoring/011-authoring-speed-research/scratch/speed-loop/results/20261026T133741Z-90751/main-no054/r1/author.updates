{"toolCallId":"call_f39d9110d5c142bcac2d1769f3c3c36a","status":"completed","content":[{"type":"content","content":{"type":"text","text":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: Phase System Tests                                            ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Validate phase recommendation and phase-map append workflows.   ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\nimport { createRequire } from 'node:module';\nimport { fileURLToPath } from 'node:url';\n\nconst require = createRequire(import.meta.url);\nconst __filename = fileURLToPath(import.meta.url);\nconst fs = require('fs');\nconst os = require('os');\nconst path = require('path');\nconst { execFileSync } = require('child_process');\nconst __dirname = path.dirname(__filename);\n\nconst REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..', '..');\nconst SKILL_ROOT = path.join(REPO_ROOT, '.skilled', 'skills', 'system-spec-kit');\nconst CREATE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'create.sh');\nconst RECOMMEND_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'recommend-level.sh');\n\n// create.sh takes its root from `git rev-parse --show-toplevel` in the working\n// directory, so every call runs inside a throwaway repository instead of the\n// checkout. It also reads its templates relative to that root, so the sandbox\n// gets a copy.\nconst SANDBOX_REPO = createSandboxRepo('speckit-phase-system-');\nconst ALLOWED_SPECS_ROOT = path.join(SANDBOX_REPO, 'specs');\n\nfunction createSandboxRepo(prefix) {\n  const repo = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)));\n  execFileSync('git', ['init', '--quiet'], { cwd: repo });\n  const sandboxSkill = path.join(repo, '.skilled', 'skills', 'system-spec-kit');\n  fs.cpSync(path.join(SKILL_ROOT, 'templates'), path.join(sandboxSkill, 'templates'), { recursive: true });\n  fs.mkdirSync(path.join(sandboxSkill, 'runtime', 'cli', 'templates'), { recursive: true });\n  fs.copyFileSync(\n    path.join(SKILL_ROOT, 'runtime', 'cli', 'templates', 'inline-gate-renderer.sh'),\n    path.join(sandboxSkill, 'runtime', 'cli', 'templates', 'inline-gate-renderer.sh')\n---\n14:  \"scripts\": {\n15-    \"clean\": \"node -e \\\"require('node:fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n16-    \"prepare-build\": \"node cli/lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime --entry default && node cli/lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime --entry validation-orchestrator\",\n17-    \"build\": \"npm run prepare-build && tsc --build && node scripts/finalize-dist.mjs\",\n18-    \"rebuild\": \"npm run clean && npm run build\",\n19-    \"typecheck\": \"tsc --noEmit --composite false -p tsconfig.json\",\n20-    \"check\": \"npm run lint && npx tsc --noEmit\",\n21-    \"check:full\": \"npm run check && npm run test\",\n22-    \"lint\": \"eslint . --ext .ts\",\n23-    \"test\": \"node scripts/run-tests.mjs\",\n24-    \"test:spec-validation\": \"node cli/tests/test-validation-system.cjs && bash cli/tests/test-validation.sh && bash cli/tests/test-validation-extended.sh\",\n25-    \"test:core\": \"vitest run\",\n26-    \"test:council\": \"vitest run tests/multi-ai-council-runtime-parity.vitest.ts tests/multi-ai-council-permission-scope.vitest.ts tests/multi-ai-council-audit-trail.vitest.ts tests/multi-ai-council-rollback.vitest.ts ../../system-deep-loop/runtime/tests/integration/council-graph-script.vitest.ts ../../system-deep-loop/runtime/tests/integration/council-graph-value-scenarios.vitest.ts tests/council-playbook-anchor-integrity.vitest.ts tests/council-helpers-smoke.vitest.ts cli/tests/multi-ai-council-persist-artifacts.vitest.ts\",\n27-    \"test:council:full\": \"bash cli/test-council-matrix.sh\",\n28-    \"test:task-enrichment\": \"npx vitest run cli/tests/task-enrichment.vitest.ts --config ../vitest.config.ts\",\n29-    \"test:watch\": \"vitest\",\n30-    \"typecheck:tests\": \"tsc --noEmit --composite false -p tsconfig.tests.json\",\n31-    \"test:sharded\": \"node scripts/run-tests-sharded.mjs\"\n32-  },\n33-  \"keywords\": [\n34-    \"spec-kit\",\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w904a7ae601/tree","terminal_exit":{"terminal_id":"6503ac","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
