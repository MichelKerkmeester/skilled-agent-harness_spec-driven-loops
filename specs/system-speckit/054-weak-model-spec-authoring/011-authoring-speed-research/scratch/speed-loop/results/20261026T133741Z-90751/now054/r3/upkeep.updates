flags.ts\n.skilled/skills/system-spec-kit/runtime/lib/graph/generated-metadata-drift.ts\n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\n.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\n.skilled/skills/system-spec-kit/runtime/lib/validation/generated-metadata-integrity.ts\n.skilled/skills/system-spec-kit/runtime/api/index.ts\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"3cd553","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
