{"toolCallId":"call_71562f33e13447b8987edbb20354c5f3","status":"completed","content":[{"type":"content","content":{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Packet Synopsis Extractor\n// ───────────────────────────────────────────────────────────────────\n// One shared synopsis extractor for the two generated fields that summarize a spec\n// folder: the description in description.json and the causal_summary in graph-metadata.json.\n// Both fields previously ran two divergent local extractors, so they could drift from the\n// same spec.md even when nothing was stale. This helper applies one explicit precedence over\n// the same source doc and exposes a per-field length limit, so the two fields move together\n// and a reader can trust they describe the same thing.\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\nimport { stripYamlFrontmatter } from '../parsing/content-normalizer.js';\n// ───────────────────────────────────────────────────────────────────\n// 3. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n// Field-specific length limits. The short description is a one-line label, the causal_summary\n// carries the longer overview a reader scans before opening the packet. Same precedence,\n// different ceiling, so a longer source produces a fuller causal_summary while the description\n// stays terse.\nexport const SYNOPSIS_FIELD_LIMITS = {\n    description: 150,\n    causal_summary: 600,\n};\nconst OVERVIEW_SECTION_RE = /###\\s+Overview\\s*\\n([\\s\\S]*?)(?:\\n###|\\n##|\\n<!--|$)/i;\nconst PROBLEM_HEADING_RE = /^#{1,4}\\s+(problem\\s+(statement|&\\s*purpose|and\\s+purpose)|purpose)/i;\nconst FRONTMATTER_DESCRIPTION_RE = /^\\s*description:\\s*(.+?)\\s*$/im;\n// ───────────────────────────────────────────────────────────────────\n// 4. HELPERS\n// ───────────────────────────────────────────────────────────────────\nfunction stripInlineMarkers(line) {\n    return line.replace(/\\*+/g, '').replace(/_+/g, '').replace(/^[-*>]\\s+/, '').trim();\n}\nfunction firstSentence(text) {\n    return text.split(/\\.\\s/)[0].trim().replace(/\\.$/, '');\n}\nfunction sentenceBoundaryWithinLimit(text, limit) {\n    let bestBoundary = -1;\n    const sentenceEndRe = /[.!?](?=\\s|$)/g;\n    let match;\n    while ((match = sentenceEndRe.exec(text)) !== null) {\n        const boundary = match.index + 1;\n        if (boundary > limit) {\n            break;\n        }\n        bestBoundary = boundary;\n    }\n    return bestBoundary;\n}\n// Regex on purpose: a synopsis source may carry a BOM or a leading HTML\n// comment before the fence, which the strict shared parser rejects.\nfunction extractFrontmatterDescription(raw) {\n    const match = raw.match(/^(?:﻿)?(?:\\s*<!--[\\s\\S]*?-->\\s*)*---\\s*\\r?\\n([\\s\\S]*?)\\r?\\n---/);\n    if (!match) {\n        return null;\n    }\n    const fmMatch = match[1].match(FRONTMATTER_DESCRIPTION_RE);\n    if (!fmMatch) {\n        return null;\n    }\n    const value = fmMatch[1].trim().replace(/^['\"]|['\"]$/g, '').trim();\n    return value.length > 0 ? value : null;\n}\nfunction extractOverviewParagraph(body) {\n    const match = body.match(OVERVIEW_SECTION_RE);\n    if (!match?.[1]) {\n        return null;\n    }\n    const normalized = match[1]\n        .split('\\n')\n        .map((line) => line.trim())\n        .filter((line) => line.length > 0 && !line.startsWith('<!--'))\n        .join(' ')\n        .trim();\n    return normalized.length > 0 ? normalized : null;\n}\nfunction extractProblemSentence(lines) {\n    for (let i = 0; i < lines.length; i += 1) {\n        if (!PROBLEM_HEADING_RE.test(lines[i])) {\n            continue;\n        }\n        for (let j = i + 1; j < lines.length && j < i + 10; j += 1) {\n            const candidate = lines[j];\n            if (candidate.length === 0)\n                continue;\n            if (candidate.startsWith('#'))\n                break;\n            const clean = stripInlineMarkers(candidate);\n            if (clean.length > 0) {\n                return firstSentence(clean);\n            }\n        }\n    }\n    return null;\n}\nfunction extractTitleHeading(lines) {\n    for (const line of lines) {\n        if (line.startsWith('# ')) {\n            const title = line.replace(/^#+\\s+/, '').trim();\n            if (title.length > 0) {\n                return title;\n            }\n        }\n    }\n    return null;\n}\nfunction extractFirstBodyLine(lines) {\n    for (const line of lines) {\n        if (line.startsWith('#') || line.length === 0)\n            continue;\n        const clean = stripInlineMarkers(line);\n        if (clean.length > 0) {\n            return firstSentence(clean);\n        }\n    }\n    return null;\n}\n// ───────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ───────────────────────────────────────────────────────────────────\n/**\n * Clamp a generated synopsis to a length limit without cutting the final word when possible.\n *\n * @param synopsis - Candidate synopsis text\n * @param limit - Maximum character length\n * @returns The original string when at or below the limit, otherwise a word-boundary clamp\n */\nexport function truncateSynopsisAtWordBoundary(synopsis, limit) {\n    if (synopsis.length <= limit) {\n        return synopsis;\n    }\n    const sentenceBoundary = sentenceBoundaryWithinLimit(synopsis, limit);\n    if (sentenceBoundary > 0) {\n        return synopsis.slice(0, sentenceBoundary).trim();\n    }\n    const truncated = synopsis.slice(0, limit);\n    const nextChar = synopsis[limit];\n    if (nextChar === undefined || /\\s/.test(nextChar)) {\n        return truncated.trim();\n    }\n    const boundary = truncated.search(/\\s+\\S*$/);\n    if (boundary > 0) {\n        return truncated.slice(0, boundary).trim();\n    }\n    return truncated.trim();\n}\n/**\n * Derive a packet synopsis from spec.md content with one shared precedence.\n *\n * Precedence (first match wins): the Overview section paragraph, the Problem/Purpose first\n * sentence, the frontmatter description, the title heading, then the first body line. The two\n * generated fields call this with their own `field`, so they derive from the same precedence\n * over the same source doc and only the length ceiling differs.\n *\n * @param specContent - Raw spec.md content (frontmatter included)\n * @param field - Which generated field is being derived, selects the length limit\n * @returns The synopsis trimmed to the field limit, or empty string when nothing extractable\n */\nexport function derivePacketSynopsis(specContent, field) {\n    const limit = SYNOPSIS_FIELD_LIMITS[field];\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"7d0d1a","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_73239f89a999404da1659372304bf168","status":"completed","content":[{"type":"content","content":{"type":"text","text":"FILE_EXISTS\terror\t\tValidates required spec documents for the declared documentation level.\nPLACEHOLDER_FILLED\terror\t\tRejects unfilled template placeholders in authored spec documents.\nCOMMENT_HYGIENE_MARKER\terror\t\tRejects ephemeral finding markers inside HTML comments in authored spec documents.\nSCAFFOLD_NEVER_TOUCHED\terror\t\tRejects scaffold-signature markers in required docs when spec.md claims Complete status.\nSTATUS_CROSS_DOC_CONSISTENCY\terror\t\tAdvisory-by-default check that spec.md and implementation-summary.md status fields classify to the same delivery state.\nLEVEL_DECLARED\tinfo\t\tReports whether the documentation level was declared or inferred.\nAC_COVERAGE\tinfo\t\tDefault-on advisory (non-blocking) scan for acceptance-criteria traceability coverage; set SPECKIT_AC_COVERAGE=false to opt out.\nAC_CLOSURE\terror\t\tGates packet closure on acceptance-criteria.md at Levels 2, 3 and 3+; unmet criteria block a completion claim and a waiver must cite an ADR \nANCHORS_VALID\terror\t\tChecks anchors in each spec doc whose template defines them, ignoring fenced code; a phase parent is exempt, and research/research.md and re\nFRONTMATTER_MEMORY_BLOCK\terror\t\tValidates canonical _memory continuity frontmatter blocks.\nMERGE_LEGALITY\terror\t\tValidates generated merge payloads against target anchor shape.\nSPEC_DOC_SUFFICIENCY\terror\t\tChecks implementation-summary sufficiency after save/write flows.\nCROSS_ANCHOR_CONTAMINATION\terror\t\tDetects route/category mismatches before generated content is merged.\nPOST_SAVE_FINGERPRINT\terror\t\tVerifies post-save fingerprints for generated writes.\nTOC_POLICY\terror\t\tEnforces table-of-contents placement policy.\nAI_PROTOCOLS\terror\t\tValidates AI execution protocol sections in high-governance specs.\nCOMPLEXITY_MATCH\terror\t\tChecks declared level against content complexity signals.\nFOLDER_NAMING\terror\t\tValidates numbered spec-folder naming conventions.\nFRONTMATTER_VALID\terror\t\tValidates YAML frontmatter structure and required semantic values.\nFRONTMATTER_VALUES\twarn\t\tWarns when a packet document's contextType or importance_tier is outside the shared list in sk-doc/sk-create-frontmatter/assets/frontmatter-\nSOURCE_TAGS\twarn\t\tWarns when a path:line citation inside a [SOURCE: ...] tag in a packet's research or review artifacts names a gone file, a moved file or a l\nGREP_CONVENTION\terror\t\tChecks every markdown document in a spec folder against the greppable-corpus convention: frontmatter variant, trigger phrase quality, anchor\nLEVEL_MATCH\terror\t\tChecks required files match the declared documentation level.\nGRAPH_METADATA_PRESENT\twarn\t\tChecks generated description and graph metadata are present.\nGRAPH_METADATA_CHILD_DRIFT\twarn\t\tFlags graph-metadata.json children_ids missing on-disk phase children the writer would add (advisory unless SPECKIT_CHILD_DRIFT_ENFORCE=true\nGRAPH_METADATA_CHILD_IDENTITY\terror\t\tFlags graph-metadata.json children_ids entries whose leading path identity is not the packet's own current identity (stale rename residue th\nGRAPH_METADATA_SHAPE\twarn\t\tValidates graph-metadata.json shape: required packet/derived blocks, last_active_child_id pointer integrity for phase parents.\nMETADATA_DISK_PATH_CONSISTENCY\terror\t\tAdvisory-by-default check that description.json, graph-metadata.json, and continuity ids match the real on-disk spec-folder path.\nDESCRIPTION_SHAPE\twarn\t\tValidates description.json shape: required name/description/level keys present and well-typed.\nNORMALIZER_LINT\terror\t\tStrict-only lint for duplicated runtime normalizer helpers.\nSPEC_DOC_INTEGRITY\terror\t\tVerifies inline markdown references resolve within spec docs.\nTEMPLATE_SOURCE\terror\t\tChecks SPECKIT_TEMPLATE_SOURCE provenance markers.\nCANONICAL_SAVE_ROOT_SPEC_REQUIRED\terror\t\tEnsures canonical saves include a root spec reference.\nCANONICAL_SAVE_SOURCE_DOCS_REQUIRED\terror\t\tEnsures canonical saves include source document references.\nCANONICAL_SAVE_LINEAGE_REQUIRED\terror\t\tEnsures canonical save lineage metadata is present.\nCANONICAL_SAVE_PACKET_IDENTITY_NORMALIZED\terror\t\tChecks canonical save packet identity normalization.\nCANONICAL_SAVE_DESCRIPTION_GRAPH_FRESHNESS\terror\t\tChecks generated description/graph freshness for canonical saves.\nCONTINUITY_FRESHNESS\terror\tstrict\tStrict-mode freshness check for continuity frontmatter. The rule reports warn by default and escalates to fail under SPECKIT_COMPLETION_FRES\nGENERATED_METADATA_INTEGRITY\terror\tstrict\tValidates description.json and graph-metadata.json through the shared schemas plus path-prefix and status-enum invariants, error under stric\nGENERATED_METADATA_DRIFT\terror\tstrict\tRe-derives a folder and reports drift between the stored description/causal_summary and the current docs, read-only, error under strict only\nLINKS_VALID\twarn\t\tScans the system-spec-kit skill's own markdown for wikilinks whose target file does not exist. The target is always this skill, never the va\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"7c6855","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_7dfc5f7935724c2590d164b20b7ca9d1","status":"completed","content":[{"type":"content","content":{"type":"text","text":"\nSpec Folder Validation v3.0.0\n\n  Folder: /private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree/specs/zz-bench-authoring/001-recommend-level-quiet-flag\n  Level:  3\n  Engine: orchestrator\n\n+ FILE_EXISTS: All required files present for Level 3\n! PLACEHOLDER_FILLED: 6 unfilled value token(s) in a Draft packet. Fill each one before the status leaves Draft\n    - implementation-summary.md:50: [YOUR_VALUE_HERE: Opening hook: 2-3 sentences on what changed and why it matters. Lead with impact.]\n    - implementation-summary.md:61: | [YOUR_VALUE_HERE: path] | [YOUR_VALUE_HERE: Created/Modified/Deleted] | [YOUR_VALUE_HERE: What this change accomplishe\n    - implementation-summary.md:70: [YOUR_VALUE_HERE: How was this tested, verified and shipped? What was the rollout approach?]\n    - implementation-summary.md:81: | [YOUR_VALUE_HERE: What was decided] | [YOUR_VALUE_HERE: Active-voice rationale with specific reasoning] |\n    - implementation-summary.md:92: | [YOUR_VALUE_HERE: Validation, lint, tests, manual check] | [YOUR_VALUE_HERE: PASS/FAIL with specifics] |\n    - implementation-summary.md:101: 1. **[YOUR_VALUE_HERE: Limitation]** [YOUR_VALUE_HERE: Specific detail with workaround if one exists.]\n+ TEMPLATE_SOURCE: Template source headers present\n+ ANCHORS_VALID: Anchors well formed in 5 file(s)\n+ FRONTMATTER_VALID: Frontmatter continuity basics present\n+ FRONTMATTER_MEMORY_BLOCK: All spec-doc frontmatter memory blocks are structurally valid\n+ SPEC_DOC_SUFFICIENCY: All targeted spec-doc anchors meet the sufficiency baseline\n+ MERGE_LEGALITY: No merge plan supplied; legality check skipped\n+ CROSS_ANCHOR_CONTAMINATION: No routing payload supplied; contamination check skipped\n+ POST_SAVE_FINGERPRINT: No post-save payload supplied; fingerprint check skipped\n+ GRAPH_METADATA_PRESENT: Graph metadata checked\nx GENERATED_METADATA_INTEGRITY: Generated metadata integrity found 1 violation(s) (enforced)\n    - graph-metadata.json: SOURCE_FINGERPRINT_MISMATCH: source_fingerprint does not match a re-derive of the current source docs, the stored derived fields may be stale\nx GENERATED_METADATA_DRIFT: Generated metadata drift found 1 drifted field(s) (enforced)\n    - description: stored 'Add a quiet flag to recommend-level.sh' drifted from fresh 'The script prints 16 lines for `--loc 500 --files 15` and 36 lines for `--json`, both measured against the current file'\n+ COMMENT_HYGIENE_MARKER: No ephemeral comment-hygiene markers found\n+ SCAFFOLD_NEVER_TOUCHED: Spec status is 'Draft', not Complete; scaffold markers are allowed\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"e8e526","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
