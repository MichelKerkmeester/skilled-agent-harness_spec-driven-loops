{"toolCallId":"call_d4b2c6d75b9b41eaa818c5ad2851eacf","status":"completed","content":[{"type":"content","content":{"type":"text","text":"29:COMPLETENESS_SCRIPT=\"$SCRIPT_DIR/calculate-completeness.sh\"\n30-MIN_COMPLETENESS=90\n31-\n32-# ───────────────────────────────────────────────────────────────\n33-# 2. COLORS\n34-# ───────────────────────────────────────────────────────────────\n35-\n36-if [[ -t 1 ]]; then\n37-  RED='\\033[0;31m'\n38-  GREEN='\\033[0;32m'\n39-  YELLOW='\\033[1;33m'\n40-  BLUE='\\033[0;34m'\n41-  NC='\\033[0m'\n42-  BOLD='\\033[1m'\n43-else\n44-  RED='' GREEN='' YELLOW='' BLUE='' NC='' BOLD=''\n45-fi\n46-\n47-# ───────────────────────────────────────────────────────────────\n48-# 3. HELPER FUNCTIONS\n49-# ───────────────────────────────────────────────────────────────\n50-\n51-show_help() {\n52-    cat << 'EOF'\n53-archive-spec.sh - Archive completed spec folders\n54-\n55-USAGE:\n56-    archive-spec.sh <spec-folder>\n57-    archive-spec.sh --list\n58-    archive-spec.sh --restore <archived-folder>\n59-\n--\n266:    if [[ ! -x \"$COMPLETENESS_SCRIPT\" ]]; then\n267:        log_warning \"Completeness script not found: $COMPLETENESS_SCRIPT\"\n268-        echo \"0\"\n269-        return\n270-    fi\n271-\n272-    local json_output\n273:    json_output=$(\"$COMPLETENESS_SCRIPT\" --json \"$spec_folder\" 2>/dev/null || echo '{}')\n274-\n275-    local completeness\n276-    completeness=$(echo \"$json_output\" | grep -o '\"overall_completion\": [0-9]*' | grep -o '[0-9]*' || echo \"0\")\n277-\n278-    # Default to 100 if calculation fails\n279-    [[ -z \"$completeness\" ]] && completeness=100\n280-\n281-    echo \"$completeness\"\n282-}\n283-\n284-# The archive beside a packet home. A symlink is refused before anything is created\n285-# through it, since a link can point anywhere and a packet belongs only in a real\n286-# archive folder. The resolved path and the containment check are a second guard,\n287-# and every write uses the returned path. The path is the only thing written to\n288-# stdout, so the caller can capture it.\n289-resolve_archive_root() {\n290-    local archive_root=\"$1\"\n291-    local specs_root=\"$2\"\n292-    local resolved\n293-    if [[ -L \"$archive_root\" ]]; then\n294-        log_error \"Archive directory is a symbolic link, not followed, and is refused: $archive_root\"\n295-        return 1\n296-    fi\n297-    if ! mkdir -p \"$archive_root\"; then\n298-        log_error \"Archive directory not accessible: $archive_root\"\n299-        return 1\n300-    fi\n301-    if ! resolved=\"$(resolve_existing_dir \"$archive_root\")\"; then\n302-        log_error \"Archive directory is not a directory: $archive_root\"\n303-        return 1\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wa3f8a76d29/tree","terminal_exit":{"terminal_id":"8840a1","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
