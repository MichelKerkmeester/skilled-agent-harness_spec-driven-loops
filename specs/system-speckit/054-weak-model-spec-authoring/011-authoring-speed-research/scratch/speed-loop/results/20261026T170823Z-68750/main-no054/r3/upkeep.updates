{"toolCallId":"call_d4dd580a1dc64d7689b2e4b5f4797a43","status":"completed","content":[{"type":"content","content":{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Devin PostToolUse Quality Check\n// ───────────────────────────────────────────────────────────────────\n// STATUS: hooks fire live under `devin -p` with the documented top-level event\n// arrays and nested matcher groups in .devin/hooks.v1.json.\n//\n// PostToolUse quality-check hook for Devin CLI -- the Devin sibling of the\n// Codex/Claude post-edit quality hook. Reads the hook's stdin JSON, resolves the\n// edited file's checker via the shared post-edit-router core, and runs it under\n// the hook budget; separately preserves the dist-staleness coverage. Warn-only,\n// fail-open: a checker bug, a missing binary, or a malformed payload must never\n// block the tool call this hook observes.\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst router = require('../lib/post-edit-router.cjs');\nconst { isHookEnabled } = require('../../shared/hook-flags.cjs');\nconst { readStdin } = require('../../shared/hook-adapter-shared.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// Devin's file-mutating tools: edit patches a file, write creates or overwrites one.\nconst DEVIN_EDIT_TOOLS = new Set(['edit', 'write']);\n\n// The file-path aliases a payload may use, in the order they are trusted.\nconst FILE_PATH_FIELDS = ['file_path', 'filePath', 'path'];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction remainingMs(startedAt, budgetMs) {\n  return budgetMs - (Date.now() - startedAt);\n}\n\nfunction filePathFrom(toolInput) {\n  if (!toolInput || typeof toolInput !== 'object') return undefined;\n  // The first string alias wins, not the first truthy one: a non-string\n  // file_path (a number, an object) is not a path at all, and letting it\n  // shadow the alias order would silently drop a valid filePath or path.\n  for (const field of FILE_PATH_FIELDS) {\n    const candidate = toolInput[field];\n    if (typeof candidate === 'string' && candidate) return candidate;\n  }\n  return undefined;\n}\n\nfunction buildCommentHygieneFinding(finding, filePath) {\n  const lines = [\n    '',\n    'COMMENT HYGIENE WARNING: ephemeral-artifact pointers found in code comments.',\n    'These references are unstable and will rot. Replace each with the durable WHY.',\n    `Violations in ${filePath}:`,\n  ];\n  for (const line of String(finding.stdout || '').split('\\n')) {\n    if (line.trim()) lines.push(`  ${line}`);\n  }\n  lines.push(\n    'See: .skilled/skills/sk-code/shared/references/universal/code-style-guide.md §4',\n    \"Escape: add 'hygiene-ok' to a comment line to suppress the warning for that line.\",\n    '',\n  );\n  return lines.join('\\n');\n}\n\nfunction buildGenericFinding(finding, filePath) {\n  const lines = [\n    '',\n    `POST-EDIT QUALITY WARNING [${finding.label}] for ${filePath}:`,\n  ];\n  for (const line of String(finding.stdout || '').split('\\n')) {\n    if (line.trim()) lines.push(`  ${line}`);\n  }\n  lines.push('');\n  return lines.join('\\n');\n}\n\nfunction buildFindings(findings, filePath) {\n  if (!Array.isArray(findings) || findings.length === 0) return '';\n  let text = '';\n  for (const finding of findings) {\n    if (finding.label === 'comment-hygiene') text += buildCommentHygieneFinding(finding, filePath);\n    else text += buildGenericFinding(finding, filePath);\n  }\n  return text;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. MAIN\n// ─────────────────────────────────────────────────────────────────────────────\n\nasync function main() {\n  const startedAt = Date.now();\n  if (!isHookEnabled('post-edit-quality')) return; // kill-switch: full no-op\n\n  let payload;\n  try {\n    const raw = await readStdin();\n    payload = raw.trim() ? JSON.parse(raw) : {};\n  } catch (_) {\n    return; // malformed stdin -- fail-open\n  }\n  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return;\n\n  if (!DEVIN_EDIT_TOOLS.has(String(payload.tool_name || '').toLowerCase())) return;\n\n  const toolInput = payload.tool_input && typeof payload.tool_input === 'object'\n    ? payload.tool_input\n    : {};\n  const projectDir = typeof payload.cwd === 'string' && payload.cwd\n    ? payload.cwd\n    : (process.env.DEVIN_PROJECT_DIR || process.cwd());\n\n  let filePath = filePathFrom(toolInput);\n  if (typeof filePath !== 'string' || !filePath) return;\n  if (!path.isAbsolute(filePath)) filePath = path.join(projectDir, filePath);\n\n  let fileExists = false;\n  try {\n    fileExists = fs.existsSync(filePath);\n  } catch (_) {\n    fileExists = false;\n  }\n  if (!fileExists) return;\n\n  let advisory = '';\n  try {\n    const entries = router.resolveDispatch(filePath, projectDir);\n    const checksBudget = remainingMs(startedAt, router.CLAUDE_HOOK_BUDGET_MS);\n    const findings = router.runChecks(entries, checksBudget, {\n      perChildTimeoutMs: router.CLAUDE_CHECKER_TIMEOUT_MS,\n      minCheckerMs: router.CLAUDE_MIN_CHECKER_MS,\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wff82223311/tree","terminal_exit":{"terminal_id":"16e159","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_e49b01bcdaed4801a12d519dc0f31a23","status":"completed","content":[{"type":"content","content":{"type":"text","text":"{\n  \"specFolder\": \"zz-bench-authoring/001-completeness-min-percent\",\n  \"description\": \"Add a min-percent option to calculate-completeness.sh\",\n  \"keywords\": [\n    \"min-percent\",\n    \"option\",\n    \"calculate-completeness\"\n  ],\n  \"lastUpdated\": \"2026-10-26T17:18:05.738Z\",\n  \"specId\": \"001\",\n  \"folderSlug\": \"completeness-min-percent\",\n  \"parentChain\": [\n    \"zz-bench-authoring\"\n  ],\n  \"memorySequence\": 0,\n  \"memoryNameHistory\": [],\n  \"level\": \"1\"\n}---GRAPH---\n{\n  \"causal_summary\": \"`calculate-completeness.sh` measures placeholder burn-down and prints `Overall Completion: <N>%`, but the script ends with an unconditional `exit 0`\",\n  \"source_fingerprint\": \"sha256:ad100f0b7267ee7c5f8c52104adcff031133d1701f44b89f9b3080e878b590af\",\n  \"docset\": 3,\n  \"hashes\": {\n    \"spec.md\": \"e3e6eceeddb8eb6c0c70b0edd60186de6c6751f2564b2e8ca769b302e0726991\",\n    \"plan.md\": \"c4e89181ff62ca0069e55914560b18184c8c49d3ea31e35ccbc224df5fb4d9a3\",\n    \"tasks.md\": \"d590899d591863ef72a728ae9a9fe439cca9d101067790a6735f25f55c15ba6a\",\n    \"implementation-summary.md\": \"434cf18f10488fda4ebeda8330730f842f2f349ac16a444d0e9da0beaeb41986\"\n  }\n}\n---REQ---\n80:| REQ-001 | `--min-percent <N>` is accepted in any argument position relative to the spec folder, and it never alters the completion report. | `calculate-completeness.sh --min-percent 90 <folder>` and `calculate-completeness.sh <folder>` produce byte-identical stdout; `diff` between the two captures reports no difference. |\n81:| REQ-002 | When the reported `Overall Completion` is below `N`, the script exits 3. When it is equal to or above `N`, the script exits 0. | On a packet whose report reads 64 percent, `--min-percent 90` exits 3 and `--min-percent 50` exits 0, confirmed with `echo $?` after each run. |\n82:| REQ-003 | Without `--min-percent`, the script's output and exit status are unchanged. | A run with no flag prints the same report as before the change and exits 0; the existing `calculate-completeness-script.vitest.ts` suite passes unmodified. |\n88:| REQ-004 | `N` must be an integer from 0 to 100. A missing value, a non-integer, or a value outside that range exits 1 with a message on stderr, and no report is printed. | `--min-percent abc`, `--min-percent -1`, `--min-percent 101` and a trailing `--min-percent` each exit 1, and the stderr message names the offending value. |\n89:| REQ-005 | `--min-percent` combined with `--file` exits 1, because single-file mode has no overall completion to compare. | `--file <path> --min-percent 50` exits 1 with a message stating the option requires a spec folder. |\n90:| REQ-006 | `--help` lists the option with one example, and the trailing exit-code comment records 3 as a threshold miss. | `--help` output contains `--min-percent <N>` and an example invocation; the comment block at the end of the script names exit 3. |\n91:| REQ-007 | When `--json` and `--min-percent` are passed together, the JSON report gains a boolean `min_percent_met` field, true when `Overall Completion` is at or above `N` and false otherwise. | `--json --min-percent 50` on a 64 percent packet prints `\"min_percent_met\": true` and `--json --min-percent 90` on the same packet prints `\"min_percent_met\": false`, with the field present in both payloads. |\n123:None. The request left two behaviours open, and Section 4 settles both: `--min-percent` requires folder mode (REQ-005), and a threshold miss prints nothing extra, so the report stays byte-identical and the exit status alone carries the verdict (REQ-002).\n---TASKS---\n34:- [ ] T001 Capture a baseline: run the script against a known packet with no flags and save stdout, stderr and exit status for the later diff (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n35:- [ ] T002 Add `MIN_PERCENT=\"\"` to the globals block beside `SINGLE_FILE` and `SPEC_FOLDER`, so `set -u` sees a defined variable on every path (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n43:- [ ] T003 Add the `--min-percent` case arm to the argument loop, storing the value and shifting two arguments, matching the existing `--file` arm (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n44:- [ ] T004 Validate the stored value after the loop: a missing value, a non-integer, or a value outside 0 to 100 exits 1 with a stderr message naming the offending input, before any calculation runs (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n45:- [ ] T005 Reject `--min-percent` combined with `--file` with exit 1 and a message stating that the option requires a spec folder (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n46:- [ ] T006 Add the threshold gate after the `output_text` or `output_json` call and before the final `exit 0`: exit 3 when `OVERALL_PERCENTAGE` is below `MIN_PERCENT`, written as an explicit `if` so `set -e` is not tripped (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n47:- [ ] T007 Add the option and one example to `show_help`, and record exit 3 in the trailing exit-code comment block (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n48:- [ ] T013 Add a `min_percent_met` boolean to the `--json` payload when `--min-percent` is set, true when `OVERALL_PERCENTAGE` is at or above `MIN_PERCENT` and false otherwise (REQ-007) (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n56:- [ ] T008 Diff the unflagged report against the T001 baseline and confirm stdout is byte-identical and the exit status is still 0 (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n57:- [ ] T009 Run the threshold matrix - below, equal, 0, 100, `--json`, `--verbose`, and no flag - recording the exit status of each run (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n58:- [ ] T010 Run the invalid-input cases - `abc`, `-1`, `101`, a trailing `--min-percent`, and `--file` with the flag - and confirm each exits 1 with a message on stderr and no report (`.skilled/skills/system-spec-kit/runtime/cli/spec/calculate-completeness.sh`)\n59:- [ ] T011 Run the existing `calculate-completeness-script.vitest.ts` suite and confirm it passes without edits (`runtime/cli/tests/calculate-completeness-script.vitest.ts`)\n60:- [ ] T012 Confirm `archive.sh` and `completion-state.cjs` still exit 0, since neither passes the new flag (`.skilled/skills/system-spec-kit/runtime/cli/spec/archive.sh`)\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wff82223311/tree","terminal_exit":{"terminal_id":"736816","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
