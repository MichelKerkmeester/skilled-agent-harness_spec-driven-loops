{"toolCallId":"call_69dfd6b5aa1045679288d807b5cd56a2","status":"completed","content":[{"type":"content","content":{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Devin PostToolUse Quality Check\n// ───────────────────────────────────────────────────────────────────\n// STATUS: hooks fire live under `devin -p` with the documented top-level event\n// arrays and nested matcher groups in .devin/hooks.v1.json.\n//\n// PostToolUse quality-check hook for Devin CLI -- the Devin sibling of the\n// Codex/Claude post-edit quality hook. Reads the hook's stdin JSON, resolves the\n// edited file's checker via the shared post-edit-router core, and runs it under\n// the hook budget; separately preserves the dist-staleness coverage. Warn-only,\n// fail-open: a checker bug, a missing binary, or a malformed payload must never\n// block the tool call this hook observes.\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst router = require('../lib/post-edit-router.cjs');\nconst { isHookEnabled } = require('../../shared/hook-flags.cjs');\nconst { readStdin } = require('../../shared/hook-adapter-shared.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// Devin's file-mutating tools: edit patches a file, write creates or overwrites one.\nconst DEVIN_EDIT_TOOLS = new Set(['edit', 'write']);\n\n// The file-path aliases a payload may use, in the order they are trusted.\nconst FILE_PATH_FIELDS = ['file_path', 'filePath', 'path'];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction remainingMs(startedAt, budgetMs) {\n  return budgetMs - (Date.now() - startedAt);\n}\n\nfunction filePathFrom(toolInput) {\n  if (!toolInput || typeof toolInput !== 'object') return undefined;\n  // The first string alias wins, not the first truthy one: a non-string\n  // file_path (a number, an object) is not a path at all, and letting it\n  // shadow the alias order would silently drop a valid filePath or path.\n  for (const field of FILE_PATH_FIELDS) {\n    const candidate = toolInput[field];\n    if (typeof candidate === 'string' && candidate) return candidate;\n  }\n  return undefined;\n}\n\nfunction buildCommentHygieneFinding(finding, filePath) {\n  const lines = [\n    '',\n    'COMMENT HYGIENE WARNING: ephemeral-artifact pointers found in code comments.',\n    'These references are unstable and will rot. Replace each with the durable WHY.',\n    `Violations in ${filePath}:`,\n  ];\n  for (const line of String(finding.stdout || '').split('\\n')) {\n    if (line.trim()) lines.push(`  ${line}`);\n  }\n  lines.push(\n    'See: .skilled/skills/sk-code/sk-code-quality/references/code-style-guide.md §4',\n    \"Escape: add 'hygiene-ok' to a comment line to suppress the warning for that line.\",\n    '',\n  );\n  return lines.join('\\n');\n}\n\nfunction buildGenericFinding(finding, filePath) {\n  const lines = [\n    '',\n    `POST-EDIT QUALITY WARNING [${finding.label}] for ${filePath}:`,\n  ];\n  for (const line of String(finding.stdout || '').split('\\n')) {\n    if (line.trim()) lines.push(`  ${line}`);\n  }\n  lines.push('');\n  return lines.join('\\n');\n}\n\nfunction buildFindings(findings, filePath) {\n  if (!Array.isArray(findings) || findings.length === 0) return '';\n  let text = '';\n  for (const finding of findings) {\n    if (finding.label === 'comment-hygiene') text += buildCommentHygieneFinding(finding, filePath);\n    else text += buildGenericFinding(finding, filePath);\n  }\n  return text;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. MAIN\n// ─────────────────────────────────────────────────────────────────────────────\n\nasync function main() {\n  const startedAt = Date.now();\n  if (!isHookEnabled('post-edit-quality')) return; // kill-switch: full no-op\n\n  let payload;\n  try {\n    const raw = await readStdin();\n    payload = raw.trim() ? JSON.parse(raw) : {};\n  } catch (_) {\n    return; // malformed stdin -- fail-open\n  }\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w776a5f2639/tree","terminal_exit":{"terminal_id":"d2e3f8","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_79952a5c6dde4b9fa20332b6089139e5","status":"completed","content":[{"type":"content","content":{"type":"text","text":"SpecKit Completeness Calculator\n\nUSAGE:\n  calculate-completeness.sh [OPTIONS] [SPEC_FOLDER]\n\nOPTIONS:\n  --verbose, -v              Show detailed per-file breakdown\n  --json, -j                 Output in JSON format\n  --file <path>, -f <path>   Calculate for single file only\n  --quality, -q              Enable content quality checks\n  --help, -h                 Show this help message\n\nEXAMPLES:\n  calculate-completeness.sh specs/001-feature-name/\n  calculate-completeness.sh --verbose specs/001-feature-name/\n  calculate-completeness.sh --json specs/001-feature-name/\n  calculate-completeness.sh --file specs/001-feature-name/spec.md\n  calculate-completeness.sh --quality specs/001-feature-name/\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w776a5f2639/tree","terminal_exit":{"terminal_id":"2f9648","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
