{"toolCallId":"call_b1bacd5ce42546c1839a62542b183060","status":"completed","content":[{"type":"content","content":{"type":"text","text":"[\n  {\n    \"rule_id\": \"FILE_EXISTS\",\n    \"aliases\": [\n      \"FILES\",\n      \"FILES_PRESENT\",\n      \"FILES_EXISTS\"\n    ],\n    \"script_path\": \"rules/check-files.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Validates required spec documents for the declared documentation level.\"\n  },\n  {\n    \"rule_id\": \"PLACEHOLDER_FILLED\",\n    \"aliases\": [\n      \"PLACEHOLDER\",\n      \"PLACEHOLDERS\",\n      \"PLACEHOLDERS_FILLED\"\n    ],\n    \"script_path\": \"rules/check-placeholders.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Rejects unfilled template placeholders in authored spec documents.\"\n  },\n  {\n    \"rule_id\": \"COMMENT_HYGIENE_MARKER\",\n    \"aliases\": [\n      \"COMMENT_HYGIENE\"\n    ],\n    \"script_path\": \"rules/check-comment-hygiene.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Rejects ephemeral finding markers inside HTML comments in authored spec documents.\"\n  },\n  {\n    \"rule_id\": \"SCAFFOLD_NEVER_TOUCHED\",\n    \"aliases\": [\n      \"SCAFFOLD_MARKERS\",\n      \"TEMPLATE_SCAFFOLD\"\n    ],\n    \"script_path\": \"rules/check-scaffold-never-touched.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Rejects scaffold-signature markers in required docs when spec.md claims Complete status.\"\n  },\n  {\n    \"rule_id\": \"STATUS_CROSS_DOC_CONSISTENCY\",\n    \"aliases\": [\n      \"STATUS_CONSISTENCY\",\n      \"CROSS_DOC_STATUS\"\n    ],\n    \"script_path\": \"rules/check-status-cross-doc-consistency.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Advisory-by-default check that spec.md and implementation-summary.md status fields classify to the same delivery state.\"\n  },\n  {\n    \"rule_id\": \"LEVEL_DECLARED\",\n    \"aliases\": [\n=== 95-170 ===\n      \"SPECKIT_AC_CLOSURE_CUTOFF\"\n    ],\n    \"description\": \"Gates packet closure on acceptance-criteria.md at Levels 2, 3 and 3+; unmet criteria block a completion claim and a waiver must cite an ADR that exists. Packets created before the cutoff stay advisory.\"\n  },\n  {\n    \"rule_id\": \"ANCHORS_VALID\",\n    \"aliases\": [\n      \"ANCHOR\",\n      \"ANCHORS\",\n      \"ANCHOR_MATCHED\"\n    ],\n    \"script_path\": \"native:orchestrator\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Checks anchors in each spec doc whose template defines them, ignoring fenced code; a phase parent is exempt, and research/research.md and review/review-report.md are skipped as free-form workflow documents. Errors: a doc with no anchors, an anchor opened twice, never closed, closed but never opened, or closed more times than it is opened. Nesting is also an error: an anchor opened inside another, closed before it is opened, or closed while another is still open, though markers quoted in inline code are ignored by the nesting check; an adr-NNN anchor may hold adr-NNN-* anchors. Template order is not checked.\"\n  },\n  {\n    \"rule_id\": \"FRONTMATTER_MEMORY_BLOCK\",\n    \"aliases\": [\n      \"MEMORY_BLOCK\",\n      \"FRONTMATTER_MEMORY\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Validates canonical _memory continuity frontmatter blocks.\"\n  },\n  {\n    \"rule_id\": \"MERGE_LEGALITY\",\n    \"aliases\": [\n      \"MERGE\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"operational_runtime\",\n    \"description\": \"Validates generated merge payloads against target anchor shape.\"\n  },\n  {\n    \"rule_id\": \"SPEC_DOC_SUFFICIENCY\",\n    \"aliases\": [\n      \"SUFFICIENCY\",\n      \"DOC_SUFFICIENCY\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Checks implementation-summary sufficiency after save/write flows.\"\n  },\n  {\n    \"rule_id\": \"CROSS_ANCHOR_CONTAMINATION\",\n    \"aliases\": [\n      \"CONTAMINATION\",\n      \"CROSS_ANCHOR\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"operational_runtime\",\n    \"description\": \"Detects route/category mismatches before generated content is merged.\"\n  },\n  {\n    \"rule_id\": \"POST_SAVE_FINGERPRINT\",\n    \"aliases\": [\n      \"FINGERPRINT\",\n      \"POST_SAVE\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"operational_runtime\",\n    \"description\": \"Verifies post-save fingerprints for generated writes.\"\n  },\n  {\n    \"rule_id\": \"TOC_POLICY\",\n    \"aliases\": [\n      \"TOC\"\n    ],\n    \"script_path\": \"rules/check-toc-policy.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Enforces table-of-contents placement policy.\"\n  },\n  {\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w8a66e200e3/tree","terminal_exit":{"terminal_id":"4f0359","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
