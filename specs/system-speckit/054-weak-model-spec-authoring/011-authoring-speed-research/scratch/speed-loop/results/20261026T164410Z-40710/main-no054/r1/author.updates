{"toolCallId":"call_6d98dfdef8cc4cfa903f0123375b41b1","status":"completed","content":[{"type":"content","content":{"type":"text","text":"{\n  \"clean\": \"node -e \\\"require('node:fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n  \"prepare-build\": \"node cli/lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime --entry default && node cli/lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime --entry validation-orchestrator\",\n  \"build\": \"npm run prepare-build && tsc --build && node scripts/finalize-dist.mjs\",\n  \"rebuild\": \"npm run clean && npm run build\",\n  \"typecheck\": \"tsc --noEmit --composite false -p tsconfig.json\",\n  \"check\": \"npm run lint && npx tsc --noEmit\",\n  \"check:full\": \"npm run check && npm run test\",\n  \"lint\": \"eslint . --ext .ts\",\n  \"test\": \"node scripts/run-tests.mjs\",\n  \"test:spec-validation\": \"node cli/tests/test-validation-system.cjs && bash cli/tests/test-validation.sh && bash cli/tests/test-validation-extended.sh\",\n  \"test:core\": \"vitest run\",\n  \"test:council\": \"vitest run tests/multi-ai-council-runtime-parity.vitest.ts tests/multi-ai-council-permission-scope.vitest.ts tests/multi-ai-council-audit-trail.vitest.ts tests/multi-ai-council-rollback.vitest.ts ../../system-deep-loop/runtime/tests/integration/council-graph-script.vitest.ts ../../system-deep-loop/runtime/tests/integration/council-graph-value-scenarios.vitest.ts tests/council-playbook-anchor-integrity.vitest.ts tests/council-helpers-smoke.vitest.ts cli/tests/multi-ai-council-persist-artifacts.vitest.ts\",\n  \"test:council:full\": \"bash cli/test-council-matrix.sh\",\n  \"test:task-enrichment\": \"npx vitest run cli/tests/task-enrichment.vitest.ts --config ../vitest.config.ts\",\n  \"test:watch\": \"vitest\",\n  \"typecheck:tests\": \"tsc --noEmit --composite false -p tsconfig.tests.json\",\n  \"test:sharded\": \"node scripts/run-tests-sharded.mjs\"\n}\n---\n+-- upgrade-level.sh            