s and comments included, so the count matches what an\n1089:  const binding = parseAnchors(content).anchors.find((anchor) => anchor.id === 'binding');\n1170:    // continue checking whatever anchors were partially parsed, letting\n1171:    // documents with corrupt anchor structure pass sufficiency validation.\n1177:          detail: `${document.basename}: anchor parse failure: ${error}`,\n1182:    const anchorMap = new Map(parsed.anchors.map((anchor) => [anchor.id, anchor]));\n1186:      for (const anchorId of expectedAnchors?.keys() ?? []) {\n1187:        if (!anchorMap.has(anchorId)) {\n1191:            detail: `${document.basename}: missing required anchor '${anchorId}'`,\n1197:    for (const anchor of parsed.anchors) {\n1198:      if (anchor.body.trim().length === 0) {\n1202:          detail: `${document.basename}:${anchor.id} is empty`,\n1207:    const whatBuilt = anchorMap.get('what-built');\n1216:    const verification = anchorMap.get('verification');\n1227:      // anchor blocks, so an anchor-only scan reports every one of them as\n1228:      // uncited. Fall back to the document body when no anchors are present.\n1229:      const citedResearch = parsed.anchors.length > 0\n1230:        ? parsed.anchors.some((anchor) => looksLikeCitation(anchor.body))\n1246:      for (const anchor of parsed.anchors.filter((entry) => entry.id.startsWith('adr-'))) {\n1247:        if (/-(?:decision|alternatives|consequences)$/.test(anchor.id) && anchor.body.trim().length < 24) {\n1251:            detail: `${document.basename}:${anchor.id} looks incomplete for ADR content`,\n1261:    'All targeted spec-doc anchors meet the sufficiency baseline',\n1311:        'Cross-anchor contamination check passed',\n1337:    'Cross-anchor contamination check passed',\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wa3f8a76d29/tree","terminal_exit":{"terminal_