n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-schema.ts\n.skilled/skills/system-spec-kit/runtime/lib/validation/generated-metadata-integrity.ts\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wa3f8a76d29/tree","terminal_exit":{"terminal_id":"5dca73","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
