{"toolCallId":"call_479495d0ac9b4541bdf8a0ba5c9e0782","status":"completed","content":[{"type":"content","content":{"type":"text","text":"{\n \"clean\": \"node -e \\\"require('node:fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n \"prepare-build\": \"node lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime/cli --entry default && node lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime/cli --entry is-phase-parent\",\n \"build\": \"npm run prepare-build && tsc --build && npm run record-build\",\n \"record-build\": \"node lib/dist-freshness.cjs record-build --package system-spec-kit/runtime/cli --entry default && node lib/dist-freshness.cjs record-build --package system-spec-kit/runtime/cli --entry is-phase-parent\",\n \"rebuild\": \"npm run clean && npm run build\",\n \"typecheck\": \"tsc --noEmit --composite false -p tsconfig.json\",\n \"lint\": \"tsc --noEmit\",\n \"pretest\": \"npm run build\",\n \"test\": \"vitest run --config ../../vitest.config.ts --project cli && npm run test:legacy && npm run test:validation\",\n \"test:task-enrichment\": \"vitest run tests/task-enrichment.vitest.ts --config ../vitest.config.ts --root .\",\n \"test:legacy\": \"npm run build && node tests/test-scripts-modules.js && node tests/test-extractors-loaders.js && node tests/test-phase-validation.js && node tests/test-phase-system.js\",\n \"test:validation\": \"node tests/test-validation-system.cjs && bash tests/test-validation.sh && bash tests/test-validation-extended.sh && bash tests/check-ac-closure.sh && bash tests/check-ac-coverage.sh && bash tests/check-graph-metadata-child-drift.sh && bash tests/check-graph-metadata-shape-last-active-child.sh && bash tests/test-phase-system.sh\",\n \"check:ast\": \"npx tsx evals/check-no-mcp-lib-imports-ast.ts && npx tsx evals/check-handler-cycles-ast.ts\",\n \"check\": \"npm run lint && npx tsx evals/check-no-mcp-lib-imports.ts && bash check-api-boundary.sh && npx tsx evals/check-architecture-boundaries.ts && npx tsx evals/check-allowlist-expiry.ts && npx tsx evals/check-source-dist-alignment.ts && npx tsx evals/check-no-mcp-lib-imports-ast.ts && npx tsx evals/check-handler-cycles-ast.ts\"\n}\n---\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wa3f8a76d29/tree","terminal_exit":{"terminal_id":"1e7847","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
