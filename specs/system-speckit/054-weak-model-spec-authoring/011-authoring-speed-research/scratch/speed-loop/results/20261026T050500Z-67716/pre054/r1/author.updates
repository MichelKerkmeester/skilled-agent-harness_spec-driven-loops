{"toolCallId":"call_f3221d8453f149e8b05d012244a5eb60","status":"completed","content":[{"type":"content","content":{"type":"text","text":"39:  judgeTriggerPhrase,\n40-  MAX_PHRASE_TOKENS,\n41-  STOP_WORDS,\n42-} from './phrase-judge.mjs';\n43-\n44:export { EDITOR_FALLBACK_WORDS, GENERIC_TRIGGER_WORDS, judgeTriggerPhrase, MAX_PHRASE_TOKENS, STOP_WORDS };\n45-\n46-// ───────────────────────────────────────────────────────────────────\n47-// 1. CONTRACT\n48-// ───────────────────────────────────────────────────────────────────\n49-\n50-/**\n51- * The frontmatter variant taxonomy. Every in-scope document resolves to exactly\n52- * one of these, and the eight counts sum to the manifest total.\n53- *\n54- * `valid-empty` is the conforming bucket. Its name describes the case the\n55- * convention singles out — a well-formed empty list is not an error — but a\n56- * well-formed populated list is conforming for the same reason, and the\n57- * taxonomy carries no other label that could hold it. Documents in this bucket\n58- * are sub-counted by `detail` so a report never claims a populated list was\n59- * empty.\n60- */\n61-export const VARIANTS = Object.freeze([\n62-  'missing',\n63-  'malformed-or-unclosed',\n64-  'non-yaml',\n65-  'wrong-list-type',\n66-  'non-string-members',\n67-  'valid-empty',\n68-  'duplicate',\n69-  'oversized',\n70-]);\n71-\n72-/** Exception classes the retrofit inventories separately from the variants. */\n73-export const EXCEPTION_CLASSES = Object.freeze([\n74-  'alias-hit',\n--\n101:export const CATEGORY_SEVERITY = Object.freeze({\n102-  'alias-hit': SEVERITY.WARN,\n103-  'anchor-duplicate': SEVERITY.WARN,\n104-  'anchor-unmatched': SEVERITY.WARN,\n105-  duplicate: SEVERITY.ERROR,\n106-  'generic-trigger': SEVERITY.WARN,\n107-  'malformed-or-unclosed': SEVERITY.ERROR,\n108-  missing: SEVERITY.ERROR,\n109-  'naming-exception': SEVERITY.WARN,\n110-  'non-string-members': SEVERITY.ERROR,\n111-  'non-yaml': SEVERITY.ERROR,\n112-  oversized: SEVERITY.ERROR,\n113-  'preimage-mismatch': SEVERITY.ERROR,\n114-  'wrong-list-type': SEVERITY.ERROR,\n115-});\n116-\n117-/** Phrase-length ceiling; a longer phrase is `oversized` and is never truncated. */\n118-export { MAX_PHRASE_LENGTH };\n119-\n120-/** List-length ceiling; a longer declaration is `oversized` and is never trimmed. */\n121-export const MAX_TRIGGER_LIST_MEMBERS = 20;\n122-\n123-/**\n124- * Variants whose frontmatter the reader could not parse. An edit that moves a\n125- * document into this set has destroyed a declaration rather than repaired one.\n126- */\n127-export const UNPARSEABLE_VARIANTS = Object.freeze(new Set([\n128-  'malformed-or-unclosed', 'non-yaml', 'wrong-list-type', 'non-string-members',\n129-]));\n130-\n131-/**\n--\n719:    const verdict = judgeTriggerPhrase(phrase.raw, context);\n720-    if (verdict) {\n721-      rejected.push({ line, negativeClass: verdict.negativeClass, raw: phrase.raw, reason: verdict.reason });\n722-      continue;\n723-    }\n724-    accepted.push({ line, raw: phrase.raw });\n725-  }\n726-\n727-  return { accepted, rejected };\n728-}\n729-\n730-/**\n731- * Tokens of the packet directory a document sits in, built the way the editor\n732- * fallback builds them: the folder name without its numeric prefix, normalized,\n733- * split, and filtered to tokens long enough for the fallback to have kept.\n734- *\n735- * @param {string} relativePath Repo-relative document path.\n736- * @returns {string[]} Candidate fallback tokens.\n737- */\n738-export function packetFolderTokens(relativePath) {\n739-  const segments = relativePath.split('/');\n740-  const folder = segments.length >= 2 ? segments[segments.length - 2] : '';\n741-  return normalizeTriggerText(folder.replace(/^\\d{3}-/, ''))\n742-    .split(' ')\n743-    .filter((token) => token.length >= MIN_FOLDER_TOKEN_LENGTH);\n744-}\n745-\n746-// ───────────────────────────────────────────────────────────────────\n747-// 8. NAMING GRAMMAR\n748-// ───────────────────────────────────────────────────────────────────\n749-\n--\n981:    diagnostics.push({ category, line, path: relativePath, rawKey, reason, severity: CATEGORY_SEVERITY[category] });\n982-  };\n983-\n984-  // Checked before the handlers, because the only safe treatment is to not\n985-  // start the edit. A block this tool cannot finish is worse than no block.\n986-  const basename = relativePath.split('/').pop() ?? '';\n987-  if (classification.variant === 'missing'\n988-    && classification.detail === 'no-frontmatter-block'\n989-    && CANONICAL_DOCUMENT_BASENAMES.has(basename)) {\n990-    return {\n991-      actions: ['skipped', 'refused-partial-canonical-block'],\n992-      anchors: analyzeAnchors(text),\n993-      classification,\n994-      diagnostics: [{\n995-        category: 'missing',\n996-        line: classification.line,\n997-        path: relativePath,\n998-        rawKey: basename,\n999-        reason: `edit refused: ${basename} needs an authored frontmatter block, because a partial one fails the frontmatter contract that an absent one only warns on`,\n1000:        severity: CATEGORY_SEVERITY.missing,\n1001-      }],\n1002-      nextText: text,\n1003-    };\n1004-  }\n1005-\n1006-  switch (classification.variant) {\n1007-    case 'missing':\n1008-      nextText = insertTriggerDeclaration(text, classification.detail);\n1009-      actions.push(classification.detail === 'no-frontmatter-block'\n1010-        ? 'inserted-frontmatter-block'\n1011-        : 'inserted-trigger-key');\n1012-      row('missing', classification.line, classification.reason);\n1013-      for (const key of missingCanonicalKeys(nextText)) {\n1014-        row('missing', classification.line, `canonical key '${key}' is absent and is reported rather than synthesized`, key);\n1015-      }\n1016-      break;\n1017-\n1018-    case 'duplicate': {\n1019-      const deduped = deduplicateTriggerPhrases(text);\n1020-      nextText = deduped.text;\n1021-      actions.push('deduplicated-trigger-phrases');\n1022-      for (const entry of deduped.removed) {\n1023-        row('duplicate', entry.line, `removed repeat of normalized phrase \"${entry.normalized}\", first occurrence kept`, entry.raw);\n1024-      }\n1025-      break;\n1026-    }\n1027-\n1028-    case 'valid-empty':\n1029-      break;\n1030-\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"bb7241","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
