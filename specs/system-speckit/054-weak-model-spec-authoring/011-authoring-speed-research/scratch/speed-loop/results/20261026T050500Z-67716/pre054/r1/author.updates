ases\": [\n   \"LEVEL\"\n  ],\n  \"script_path\": \"rules/check-level.sh\",\n  \"severity\": \"info\",\n  \"category\": \"authored_template\",\n  \"description\": \"Reports whether the documentation level was declared or inferred.\"\n },\n {\n  \"rule_id\": \"AC_COVERAGE\",\n  \"aliases\": [\n   \"ACCEPTANCE_COVERAGE\",\n   \"AC_TRACEABILITY\"\n  ],\n  \"script_path\": \"rules/check-ac-coverage.sh\",\n  \"severity\": \"info\",\n  \"category\": \"authored_template\",\n  \"flags\": [\n   \"SPECKIT_AC_COVERAGE\",\n   \"SPECKIT_AC_COVERAGE_ENFORCE\",\n   \"SPECKIT_AC_COVERAGE_FLOOR\"\n  ],\n  \"description\": \"Default-on advisory (non-blocking) scan for acceptance-criteria traceability coverage; set SPECKIT_AC_COVERAGE=false to opt out.\"\n },\n {\n  \"rule_id\": \"AC_CLOSURE\",\n  \"aliases\": [\n   \"ACCEPTANCE_CLOSURE\",\n   \"AC_GATE\"\n  ],\n  \"script_path\": \"rules/check-ac-closure.sh\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"flags\": [\n   \"SPECKIT_AC_CLOSURE\",\n   \"SPECKIT_AC_CLOSURE_CUTOFF\"\n  ],\n  \"description\": \"Gates packet closure on acceptance-criteria.md at Levels 2, 3 and 3+; unmet criteria block a completion claim and a waiver must cite an ADR that exists. Packets created before the cutoff stay advisory.\"\n },\n {\n  \"rule_id\": \"ANCHORS_VALID\",\n  \"aliases\": [\n   \"ANCHOR\",\n   \"ANCHORS\",\n   \"ANCHOR_MATCHED\"\n  ],\n  \"script_path\": \"native:orchestrator\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"Checks anchors in each spec doc whose template defines them, ignoring fenced code; a phase parent is exempt, and research/research.md and review/review-report.md are skipped as free-form workflow documents. Errors: a doc with no anchors, an anchor opened twice, never closed, closed but never opened, or closed more times than it is opened. Nesting is also an error: an anchor opened inside another, closed before it is opened, or closed while another is still open, though markers quoted in inline code are ignored by the nesting check; an adr-NNN anchor may hold adr-NNN-* anchors. Template order is not checked.\"\n },\n {\n  \"rule_id\": \"FRONTMATTER_MEMORY_BLOCK\",\n  \"aliases\": [\n   \"MEMORY_BLOCK\",\n   \"FRONTMATTER_MEMORY\"\n  ],\n  \"script_path\": \"ts:spec-doc-structure\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"Validates canonical _memory continuity frontmatter blocks.\"\n },\n {\n  \"rule_id\": \"MERGE_LEGALITY\",\n  \"aliases\": [\n   \"MERGE\"\n  ],\n  \"script_path\": \"ts:spec-doc-structure\",\n  \"severity\": \"error\",\n  \"category\": \"operational_runtime\",\n  \"description\": \"Validates generated merge payloads against target anchor shape.\"\n },\n {\n  \"rule_id\": \"SPEC_DOC_SUFFICIENCY\",\n  \"aliases\": [\n   \"SUFFICIENCY\",\n   \"DOC_SUFFICIENCY\"\n  ],\n  \"script_path\": \"ts:spec-doc-structure\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"Checks implementation-summary sufficiency after save/write flows.\"\n },\n {\n  \"rule_id\": \"CROSS_ANCHOR_CONTAMINATION\",\n  \"aliases\": [\n   \"CONTAMINATION\",\n   \"CROSS_ANCHOR\"\n  ],\n  \"script_path\": \"ts:spec-doc-structure\",\n  \"severity\": \"error\",\n  \"category\": \"operational_runtime\",\n  \"description\": \"Detects route/category mismatches before generated content is merged.\"\n },\n {\n  \"rule_id\": \"POST_SAVE_FINGERPRINT\",\n  \"aliases\": [\n   \"FINGERPRINT\",\n   \"POST_SAVE\"\n  ],\n  \"script_path\": \"ts:spec-doc-structure\",\n  \"severity\": \"error\",\n  \"category\": \"operational_runtime\",\n  \"description\": \"Verifies post-save fingerprints for generated writes.\"\n },\n {\n  \"rule_id\": \"TOC_POLICY\",\n  \"aliases\": [\n   \"TOC\"\n  ],\n  \"script_path\": \"rules/check-toc-policy.sh\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"Enforces table-of-contents placement policy.\"\n },\n {\n  \"rule_id\": \"AI_PROTOCOLS\",\n  \"aliases\": [\n   \"AI_PROTOCOL\"\n  ],\n  \"script_path\": \"rules/check-ai-protocols.sh\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"Validates AI execution protocol sections in high-governance specs.\"\n },\n {\n  \"rule_id\": \"COMPLEXITY_MATCH\",\n  \"aliases\": [\n   \"COMPLEXITY\"\n  ],\n  \"script_path\": \"rules/check-complexity.sh\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"Checks declared level against content complexity signals.\"\n },\n {\n  \"rule_id\": \"FOLDER_NAMING\",\n  \"aliases\": [],\n  \"script_path\": \"rules/check-folder-naming.sh\",\n  \"severity\": \"error\",\n  \"category\": \"authored_template\",\n  \"description\": \"\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"21d5bb","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
