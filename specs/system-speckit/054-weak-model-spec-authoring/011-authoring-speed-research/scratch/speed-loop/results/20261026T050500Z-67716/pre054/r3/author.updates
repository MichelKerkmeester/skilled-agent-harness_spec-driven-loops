{"toolCallId":"call_0de388245de1439a977dca064511a3b2","status":"completed","content":[{"type":"content","content":{"type":"text","text":"9:// the trigger index's normalizer rather than reimplementing it, so a phrase\n10-// the index would collapse is the same phrase this rule calls a duplicate.\n11-// ───────────────────────────────────────────────────────────────────\n12-\n13-import fs from 'node:fs';\n14-import path from 'node:path';\n15-import yaml from 'js-yaml';\n16-import { parseFrontmatter } from '@spec-kit/shared/frontmatter/parse-frontmatter.js';\n17-import { normalizeTriggerText } from '../retrieval/lib/normalize.mjs';\n18-import {\n19-  ALIAS_KEY as ALIAS_TRIGGER_KEY,\n20-  CANONICAL_TRIGGER_KEY,\n21-  CATEGORY_SEVERITY,\n--\n35:// Budgets, key spellings, the trigger vocabulary and the category severity\n36-// table are imported from the retrofit's shared module rather than restated\n37-// here, so the validator and the retrofit cannot drift apart on what the\n38-// convention says. Only what is genuinely local to reporting lives below.\n39-\n40-const MAX_RAW_KEY_CHARS = 80;\n41-\n42-// Uppercase basenames conventional across the whole repository. They predate\n43-// the naming rule and renaming them would break inbound links for no\n44-// retrieval gain.\n45-const NAMING_EXEMPT_BASENAMES = new Set([\n46-  'README.md',\n47-  'CHANGELOG.md',\n--\n212:        reason: 'Document has no frontmatter block, so it carries no retrievable trigger phrases',\n213-        rawKey: null,\n214-      });\n215-    }\n216-    return { variants, lines };\n217-  }\n218-\n219-  const { blockLines, blockOffset, openLine } = detection;\n220-  let parsed;\n221-  try {\n222-    parsed = yaml.load(blockLines.join('\\n'));\n223-  } catch (error) {\n224-    variants.push({\n--\n345:        category: 'generic-trigger',\n346-        reason,\n347-        rawKey: member,\n348-      });\n349-    }\n350-  });\n351-\n352-  variants.push({ label: 'valid-empty', line: 0, reason: '', rawKey: null });\n353-  return { variants, lines };\n354-}\n355-\n356-// ───────────────────────────────────────────────────────────────────\n357-// 7. ANCHOR GRAMMAR\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"fdd1d0","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
