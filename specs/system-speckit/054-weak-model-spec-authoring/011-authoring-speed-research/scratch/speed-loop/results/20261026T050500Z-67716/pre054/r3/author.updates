{"toolCallId":"call_036b2809b4db468b9b0a18c665dda080","status":"completed","content":[{"type":"content","content":{"type":"text","text":"_ai_has_status_format() {\n    local folder=\"$1\"\n    if [[ -f \"$folder/plan.md\" ]]; then\n        grep -qE \"Status Format|Status Reporting\" \"$folder/plan.md\" 2>/dev/null && return 0\n    fi\n    if [[ -f \"$folder/tasks.md\" ]]; then\n        grep -qE \"Status Format|Status Reporting\" \"$folder/tasks.md\" 2>/dev/null && return 0\n    fi\n    return 1\n}\n\n# Check for blocked task protocol\n_ai_has_blocked_protocol() {\n    local folder=\"$1\"\n    if [[ -f \"$folder/plan.md\" ]]; then\n        grep -qE \"Blocked Task|BLOCKED\" \"$folder/plan.md\" 2>/dev/null && return 0\n    fi\n    if [[ -f \"$folder/tasks.md\" ]]; then\n        grep -qE \"Blocked Task|BLOCKED\" \"$folder/tasks.md\" 2>/dev/null && return 0\n    fi\n    return 1\n}\n\n# ───────────────────────────────────────────────────────────────\n# 2. MAIN RUN_CHECK FUNCTION\n# ───────────────────────────────────────────────────────────────\n\nrun_check() {\n    local folder=\"$1\"\n    local level=\"$2\"\n\n    RULE_NAME=\"AI_PROTOCOLS\"\n    RULE_STATUS=\"pass\"\n    RULE_MESSAGE=\"\"\n    RULE_DETAILS=()\n    RULE_REMEDIATION=\"\"\n\n    local warnings=()\n    local errors=()\n\n    # Phase parents keep plan.md and tasks.md in their child folders under the\n    # lean trio policy, so there is nowhere on the parent to hold the protocol.\n    if is_phase_parent \"$folder\"; then\n        RULE_STATUS=\"info\"\n        RULE_MESSAGE=\"Phase parent: AI protocol check skipped (lean trio policy)\"\n        return 0\n    fi\n\n    # Get declared level from spec.md (fallback to passed level)\n    local declared_level\n    declared_level=$(_ai_get_declared_level \"$folder\")\n    if [[ -z \"$declared_level\" ]]; then\n        declared_level=\"$level\"\n    fi\n\n    # Only check for Level 3 and 3+\n    if [[ \"$declared_level\" != \"3\" ]] && [[ \"$declared_level\" != \"3+\" ]]; then\n        RULE_STATUS=\"pass\"\n        RULE_MESSAGE=\"AI protocol check not applicable for Level $declared_level\"\n        return 0\n    fi\n\n    # Check for main AI protocol section\n    if ! _ai_has_protocol_section \"$folder\"; then\n        if [[ \"$declared_level\" = \"3+\" ]]; then\n            errors+=(\"Level 3+ requires AI Execution Protocol section\")\n        else\n            warnings+=(\"Level 3 should include AI Execution Protocol section\")\n        fi\n    fi\n\n    # Check individual components and track score\n    local protocol_score=0\n\n    if _ai_has_pre_task_checklist \"$folder\"; then\n        ((protocol_score++)) || true\n    else\n        warnings+=(\"Missing Pre-Task Checklist\")\n    fi\n\n    if _ai_has_execution_rules \"$folder\"; then\n        ((protocol_score++)) || true\n    else\n        warnings+=(\"Missing Execution Rules table\")\n    fi\n\n    if _ai_has_status_format \"$folder\"; then\n        ((protocol_score++)) || true\n    else\n        warnings+=(\"Missing Status Reporting Format\")\n    fi\n\n    if _ai_has_blocked_protocol \"$folder\"; then\n        ((protocol_score++)) || true\n    else\n        warnings+=(\"Missing Blocked Task Protocol\")\n    fi\n\n    # For Level 3+, require at least 3 components\n    if [[ \"$declared_level\" = \"3+\" ]] && [[ \"$protocol_score\" -lt 3 ]]; then\n        errors+=(\"Level 3+ requires at least 3/4 AI protocol components (found $protocol_score)\")\n    fi\n\n    # ───────────────────────────────────────────────────────────────\n    # 3. RESULTS\n    # ───────────────────────────────────────────────────────────────\n\n    if [[ ${#errors[@]} -gt 0 ]]; then\n        RULE_STATUS=\"fail\"\n        RULE_MESSAGE=\"AI protocol validation errors\"\n        RULE_DETAILS=(\"${errors[@]-}\")\n        if [[ -n \"${warnings[*]-}\" ]]; then\n            RULE_DETAILS+=(\"${warnings[@]}\")\n        fi\n        RULE_REMEDIATION=\"Add AI Execution Protocol section with required components\"\n    elif [[ ${#warnings[@]} -gt 0 ]]; then\n        RULE_STATUS=\"warn\"\n        RULE_MESSAGE=\"AI protocol incomplete ($protocol_score/4 components)\"\n        RULE_DETAILS=(\"${warnings[@]}\")\n        RULE_REMEDIATION=\"Add missing AI protocol components for Level $declared_level\"\n    else\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"a639ec","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_04c099e056ce44fabd70268fb0719435","status":"completed","content":[{"type":"content","content":{"type":"text","text":"== output fn consumers ==\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:134:RECOMMENDED_LEVEL=0\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:336:    RECOMMENDED_LEVEL=0\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:339:    RECOMMENDED_LEVEL=1\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:342:    RECOMMENDED_LEVEL=2\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:345:    RECOMMENDED_LEVEL=3\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:355:#   - AND RECOMMENDED_LEVEL >= 3\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:356:# Must be called AFTER determine_level() since it references RECOMMENDED_LEVEL.\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:433:  if [[ \"$PHASE_SCORE\" -ge \"$PHASE_THRESHOLD\" ]] && [[ \"$RECOMMENDED_LEVEL\" -ge 3 ]]; then\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:508:output_text() {\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:510:  echo \"Recommended Level: ${RECOMMENDED_LEVEL} (${LEVEL_NAME})\"\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:562:output_json() {\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:577:  \"recommended_level\": ${RECOMMENDED_LEVEL},\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:616:  \"recommended_level\": ${RECOMMENDED_LEVEL},\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:771:  output_json\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:773:  output_text\n== existing -q anywhere in arg parser ==\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"b2e963","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_04e0dab2fc004082a642a1615f22da76","status":"completed","content":[{"type":"content","content":{"type":"text","text":"3:# COMPONENT: CHECK PLACEHOLDERS\n93:#   [YOUR_VALUE_HERE], [PLACEHOLDER], etc.\n99:PLACEHOLDER_BODY=\"[A-Za-z0-9 /,._<>+%'-]\"\n149:        if echo \"$line\" | grep -qE \"\\[[A-Z]${PLACEHOLDER_BODY}+\\]\" 2>/dev/null; then\n168:            if echo \"$cleaned\" | grep -qE \"\\[[A-Z]${PLACEHOLDER_BODY}{2,}\\]\" 2>/dev/null; then\n170:                match_text=$(echo \"$line\" | grep -oE \"\\[[A-Z]${PLACEHOLDER_BODY}{2,}\\]\" 2>/dev/null | head -1)\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"1017a9","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
