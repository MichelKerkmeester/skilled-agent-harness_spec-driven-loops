{"toolCallId":"call_be3a6fb70eaa451583b90040e2a3c324","status":"completed","content":[{"type":"content","content":{"type":"text","text":"157:_ac_lifecycle_active() {\n158-    local folder=\"$1\"\n159-    local level_num=\"$2\"\n160-    local summary_file=\"$folder/implementation-summary.md\"\n161-    local ac_file=\"$folder/acceptance-criteria.md\"\n162-\n163-    [[ \"$level_num\" -lt 2 ]] && return 1\n164-    # Either source can carry the evidence; requiring the legacy one would leave\n165-    # a canonical packet unmeasured.\n166-    if [[ ! -f \"$ac_file\" ]]; then\n167-        _ac_traceability_file \"$folder\" >/dev/null || return 1\n168-    fi\n169-\n170-    # A completion signal in either document activates the gate: the summary's\n171-    # Status row when the packet carries one, else the criteria document's own\n172-    # Status field.\n173-    local status\n174-    status=\"$(_ac_summary_status \"$summary_file\" 2>/dev/null || true)\"\n175-    if _ac_status_is_active \"$status\"; then\n176-        return 0\n177-    fi\n178-    status=\"$(_ac_criteria_status \"$ac_file\" 2>/dev/null || true)\"\n179-    _ac_status_is_active \"$status\"\n180-}\n181-\n182-# The merged tasks document is the only home for verification traceability.\n183-_ac_traceability_file() {\n184-    local folder=\"$1\"\n185-    if [[ -f \"$folder/tasks.md\" ]] && grep -q '<!-- ANCHOR:protocol -->' \"$folder/tasks.md\" 2>/dev/null; then\n186-        printf '%s\\n' \"$folder/tasks.md\"\n187-        return 0\n188-    fi\n189-    return 1\n190-}\n191-\n192-_ac_count_story_criteria() {\n193-    local spec_file=\"$1\"\n194-    awk '\n195-        /^[[:space:]]*(```|~~~)/ { in_fence = !in_fence; next }\n196-        in_fence { next }\n197-        {\n--\n506:    if ! _ac_lifecycle_active \"$folder\" \"$level_num\"; then\n507-        RULE_MESSAGE=\"Acceptance coverage gate not active for this level or lifecycle state\"\n508-        return 0\n509-    fi\n510-\n511-    local analysis rows covered malformed malformed_ids cited unresolved root total\n512-    # One lookup per run. Outside a repository the working directory stands in for the root.\n513-    root=\"$(git -C \"$folder\" rev-parse --show-toplevel 2>/dev/null)\" || root=\"\"\n514-    [[ -n \"$root\" ]] || root=\"$(pwd)\"\n515-    local ac_file=\"$folder/acceptance-criteria.md\"\n516-    local canonical=false\n517-    if [[ -f \"$ac_file\" ]]; then\n518-        # One parse. The row count and the coverage both come out of it, so the\n519-        # two can never disagree and the file is not read twice.\n520-        canonical=true\n521-        analysis=\"$(_ac_analyze_canonical \"$ac_file\")\"\n522-    else\n523-        local traceability_file\n524-        local merged_tasks=false\n525-        if ! traceability_file=\"$(_ac_traceability_file \"$folder\")\"; then\n526-            RULE_MESSAGE=\"Acceptance coverage gate not active: no verification traceability source found\"\n527-            return 0\n528-        fi\n529-        if [[ \"$traceability_file\" == \"$folder/tasks.md\" ]]; then\n530-            merged_tasks=true\n531-        fi\n532-        analysis=\"$(_ac_analyze_traceability \"$traceability_file\" \"$merged_tasks\")\"\n533-    fi\n534-    IFS=$'\\t' read -r rows covered malformed malformed_ids cited <<< \"$analysis\"\n535-    if [[ \"$malformed_ids\" == \"-\" ]]; then malformed_ids=\"\"; fi\n536-    if [[ \"$cited\" == \"-\" ]]; then cited=\"\"; fi\n537-\n538-    if [[ \"$canonical\" == true ]]; then\n539-        total=\"$rows\"\n540-    else\n541-        # Packets predating the canonical document count their criteria from\n542-        # spec.md, which is a different document than the traceability rows, so\n543-        # the larger of the two is the honest denominator.\n544-        total=\"$(_ac_count_total \"$folder\" \"$level_num\")\"\n545-        [[ \"$rows\" -gt \"$total\" ]] && total=\"$rows\"\n546-    fi\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"3d2a06","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
