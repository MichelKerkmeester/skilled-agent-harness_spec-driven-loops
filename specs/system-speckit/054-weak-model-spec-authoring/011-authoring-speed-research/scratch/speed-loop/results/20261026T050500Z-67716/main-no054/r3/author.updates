{"toolCallId":"call_c18bc84f643c471dbd9abe057f1f68b0","status":"completed","content":[{"type":"content","content":{"type":"text","text":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: CHECK-SPEC-DOC-INTEGRITY\n# ───────────────────────────────────────────────────────────────\n# Rule: SPEC_DOC_INTEGRITY\n# Severity: error\n# Description: Checks that spec-doc references, metadata pointers and handover\n#   targets resolve to real paths. Sourced by validate.sh; the repository root\n#   comes from git when available and the working directory otherwise.\n\nset -euo pipefail\n\nresolve_repo_root() {\n    git rev-parse --show-toplevel 2>/dev/null || pwd\n}\n\nresolve_target_path() {\n    local value=\"$1\"\n    local repo_root=\"$2\"\n\n    value=\"${value#\\`}\"\n    value=\"${value%\\`}\"\n\n    if [[ \"$value\" = /* ]]; then\n        printf '%s\\n' \"$value\"\n        return 0\n    fi\n\n    printf '%s/%s\\n' \"$repo_root\" \"$value\"\n}\n\nresolve_markdown_reference_path() {\n    local value=\"$1\"\n    local markdown_dir=\"$2\"\n    local spec_root=\"$3\"\n    local repo_root=\"$4\"\n\n    value=\"${value#\\`}\"\n    value=\"${value%\\`}\"\n\n    if [[ \"$value\" = /* ]]; then\n        [[ -f \"$value\" ]] && printf '%s\\n' \"$value\"\n        return $?\n    fi\n\n    local candidate=\"\"\n    local candidates=(\n        \"$markdown_dir/$value\"\n        \"$spec_root/$value\"\n        \"$repo_root/$value\"\n    )\n\n    for candidate in \"${candidates[@]}\"; do\n        if [[ -f \"$candidate\" ]]; then\n            printf '%s\\n' \"$candidate\"\n            return 0\n        fi\n    done\n\n    return 1\n}\n\nextract_markdown_link_targets() {\n    # Markdown link extraction now covers four formats:\n    #\n    #   1. Inline parens:        [label](path.md)         [label](path.md#anchor)\n    #   2. Angle-bracket inline: [label](<path.md>)        — relative paths only\n    #                            [label](<path.md#anchor>)   (skip absolute URLs)\n    #   3. Reference definition: [label]: ./path.md          — at line start\n    #   4. (shortcut/full reference USE like [label][ref] is NOT a target;\n    #      the target lives in the matching reference definition (format 3))\n    #\n    # Absolute URL forms (`https://`, `http://`, `mailto:`) are excluded —\n    # they are not local files and the missing-file probe doesn't apply.\n    # The awk fence-skip passes through every non-fenced line; the parsing\n    # is then done line-by-line by mode.\n    awk '\n        BEGIN { in_fence = 0 }\n        /^[[:space:]]*(```|~~~)/ { in_fence = !in_fence; next }\n        in_fence { next }\n\n        # Blank paired inline code spans before parsing. A link written inside\n        # backticks is literal text illustrating link syntax, not a reference to\n        # follow, so probing it reports a missing file for a document that is\n        # correct. Only matched pairs are removed, so an odd stray backtick\n        # leaves the line intact and a real link stays checkable.\n        { gsub(/`[^`]*`/, \" \") }\n\n        # Format 3: Reference definition  [label]: ./path.md  (line start, optional title in quotes)\n        # Captures the target up to the first whitespace.\n        match($0, /^[[:space:]]*\\[[^]]+\\][[:space:]]*:[[:space:]]*[^[:space:]>]+\\.md([#?][^[:space:]]*)?/) {\n            ref = substr($0, RSTART, RLENGTH)\n            sub(/^[[:space:]]*\\[[^]]+\\][[:space:]]*:[[:space:]]*/, \"\", ref)\n            sub(/[#?].*$/, \"\", ref)\n            # Skip absolute URLs.\n            if (ref !~ /^(https?:|mailto:)/) print ref\n        }\n\n        # Format 1+2: extract every inline link [label](target) and [label](<target>) on the line.\n        {\n            line = $0\n            while (match(line, /\\[[^]]+\\]\\(<?[^)>]+\\.md([^)>]*)?>?\\)/)) {\n                token = substr(line, RSTART, RLENGTH)\n                line = substr(line, RSTART + RLENGTH)\n                # Strip the [label]( prefix and trailing ).\n                sub(/^\\[[^]]+\\]\\(/, \"\", token)\n                sub(/\\)$/, \"\", token)\n                # Strip optional <...> angle brackets.\n                sub(/^</, \"\", token)\n                sub(/>$/, \"\", token)\n                # Strip anchor / query fragment.\n                sub(/[#?].*$/, \"\", token)\n                if (token !~ /^(https?:|mailto:)/ && token != \"\") print token\n            }\n        }\n    ' \"$1\" 2>/dev/null || true\n}\n\nrun_check() {\n    local folder=\"$1\"\n    local _level=\"$2\"\n\n    RULE_NAME=\"SPEC_DOC_INTEGRITY\"\n    RULE_STATUS=\"pass\"\n    RULE_MESSAGE=\"\"\n    RULE_DETAILS=()\n    RULE_REMEDIATION=\"\"\n\n    local folder_basename\n    folder_basename=$(basename \"$folder\")\n    local repo_root\n    repo_root=$(resolve_repo_root)\n    local issues=()\n\n    local markdown_file=\"\"\n    while IFS= read -r markdown_file; do\n        [[ -z \"$markdown_file\" ]] && continue\n        local filename\n        filename=$(basename \"$markdown_file\")\n        local markdown_dir\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w904a7ae601/tree","terminal_exit":{"terminal_id":"309703","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_c2ee8611e7a44dc8bc4d8ec359201fde","status":"completed","content":[{"type":"content","content":{"type":"text","text":"3:// Usage:\n4://   node .../graph/backfill-graph-metadata.js <spec-folder> [--dry-run]\n5://   node .../graph/backfill-graph-metadata.js --spec-folder <path> [--dry-run]\n6://   node .../graph/backfill-graph-metadata.js --all [--dry-run] [--active-only] [--root <specs-dir>]\n68:  specFolder: string;\n99:  skipped: Array<{ specFolder: string; reason: string }>;\n100:  failed: Array<{ specFolder: string; error: string }>;\n101:  reviewFlags: Array<{ specFolder: string; flags: string[] }>;\n104:  drift: Array<{ specFolder: string; fields: string[] }>;\n118:  specFolder?: string;\n136:    const leftKey = `${left.specFolder}\\0${left.childId}\\0${left.targetPath}\\0${left.existsOnDisk}`;\n137:    const rightKey = `${right.specFolder}\\0${right.childId}\\0${right.targetPath}\\0${right.existsOnDisk}`;\n254:  return typeof candidate.specFolder === 'string'\n350:  return specFolderRejection(dirPath) === null;\n363:function specFolderRejection(dirPath: string): string | null {\n384:function resolveScopedTarget(target: string): { ok: true; specFolder: string } | { ok: false; error: string } {\n389:  const rejection = specFolderRejection(absTarget);\n405:  return { ok: true, specFolder: absTarget };\n436:    if (arg === '--dry-run') {\n537:      specFolder: resolved.specFolder,\n597: * @param specFolderPath - Absolute path to the packet folder being inspected\n601:export function collectReviewFlags(specFolderPath: string, metadata: GraphMetadata): string[] {\n603:  const specDoc = fs.existsSync(path.join(specFolderPath, 'spec.md'))\n604:    ? fs.readFileSync(path.join(specFolderPath, 'spec.md'), 'utf-8')\n606:  const planDoc = fs.existsSync(path.join(specFolderPath, 'plan.md'))\n607:    ? fs.readFileSync(path.join(specFolderPath, 'plan.md'), 'utf-8')\n630:  specFolderPath: string,\n636:  const retainedChildren = collectChildrenPruneCandidates(specFolderPath, existing, derived)\n652: * A scoped run (`specFolder` set) refreshes that single packet only. A broad\n666:  specFolder,\n668:  const specFolders = specFolder\n669:    ? [specFolder]\n673:    scope: specFolder ? 'scoped' : 'all',\n675:    totalSpecFolders: specFolders.length,\n688:  for (const specFolderPath of specFolders) {\n689:    const graphPath = path.join(specFolderPath, 'graph-metadata.json');\n694:      summary.skipped.push({ specFolder: specFolderPath, reason: 'writer_rule' });\n707:      const derived = deriveGraphMetadata(specFolderPath, existing, { saveLineage });\n709:        ? preserveExistingChildrenForPrediction(specFolderPath, existing, derived)\n715:      const pruneCandidates = collectChildrenPruneCandidates(specFolderPath, existing, derived);\n719:            specFolder: derived.spec_folder,\n729:        : refreshGraphMetadataForSpecFolder(specFolderPath, { saveLineage, prune }).metadata;\n740:      const flags = collectReviewFlags(specFolderPath, metadata);\n743:          specFolder: metadata.spec_folder,\n750:      const driftReport = checkGeneratedMetadataDrift(specFolderPath);\n753:          specFolder: metadata.spec_folder,\n759:        specFolder: specFolderPath,\n772:    scope: options.specFolder ? 'scoped' : 'all',\n773:    specFolder: options.specFolder ? path.resolve(options.specFolder) : null,\n839:  const argv = process.argv.slice(2);\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w904a7ae601/tree","terminal_exit":{"terminal_id":"c2b756","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
