{"toolCallId":"call_ac2d2885218841838dc498b8eb1d1f28","status":"completed","content":[{"type":"content","content":{"type":"text","text":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: CHECK PLACEHOLDERS\n# ───────────────────────────────────────────────────────────────\n# Scan spec folder .md files for remaining bracket placeholder\n# Patterns after upgrade-level.sh + auto-populate.\n# Bash 3.2+ compatible (macOS and Linux).\n#\n# This is the broad post-edit scan the quality hook runs: any bracket that\n# still looks like a template placeholder. The validator rule at\n# rules/check-placeholders.sh is narrower on purpose, flagging only the two\n# canonical markers, so the two are not the same check with two homes.\n\nset -euo pipefail\n\nVERSION=\"1.0.0\"\n\n# Colors (disabled for non-TTY)\nif [[ -t 1 ]]; then\n    RED='\\033[0;31m' GREEN='\\033[0;32m' YELLOW='\\033[1;33m' BOLD='\\033[1m' NC='\\033[0m'\nelse\n    RED='' GREEN='' YELLOW='' BOLD='' NC=''\nfi\n\n# ─── Usage ────────────────────────────────────────────────────\nusage() {\n    cat <<EOF\nUsage: $(basename \"$0\") <spec-folder> [OPTIONS]\n\nScan a spec folder for remaining bracket placeholder patterns.\n\nArguments:\n  <spec-folder>    Path to spec folder (e.g., specs/042-feature/)\n\nOptions:\n  --json           Output results in JSON format\n  --verbose        Show each match with file and line number\n  --help, -h       Show this help message\n\nExit codes:\n  0  No placeholders found (PASS)\n  1  Placeholders found (FAIL)\n  2  Invalid arguments or folder not found\n\nExamples:\n  $(basename \"$0\") specs/042-feature/\n  $(basename \"$0\") specs/042-feature/ --verbose\n  $(basename \"$0\") specs/042-feature/ --json\nEOF\n}\n\n# ─── Args ─────────────────────────────────────────────────────\nFOLDER_PATH=\"\"\nJSON_MODE=false\nVERBOSE=false\n\nwhile [[ $# -gt 0 ]]; do\n    case \"$1\" in\n        --json)     JSON_MODE=true; shift ;;\n        --verbose)  VERBOSE=true; shift ;;\n        --help|-h)  usage; exit 0 ;;\n        -*)         echo \"Unknown option: $1\" >&2; usage >&2; exit 2 ;;\n        *)\n            if [[ -z \"$FOLDER_PATH\" ]]; then\n                FOLDER_PATH=\"$1\"\n            else\n                echo \"Error: unexpected argument '$1'\" >&2\n                usage >&2\n                exit 2\n            fi\n            shift\n            ;;\n    esac\ndone\n\nif [[ -z \"$FOLDER_PATH\" ]]; then\n    echo \"Error: spec folder path required\" >&2\n    usage >&2\n    exit 2\nfi\n\n# Normalize trailing slash\nFOLDER_PATH=\"${FOLDER_PATH%/}\"\n\nif [[ ! -d \"$FOLDER_PATH\" ]]; then\n    echo \"Error: folder not found: $FOLDER_PATH\" >&2\n    exit 2\nfi\n\n# ─── Placeholder patterns ────────────────────────────────────\n# Match bracket patterns that look like template placeholders:\n#   [Response time target], [Low/Med/High], [Component A],\n#   [YOUR_VALUE_HERE], [PLACEHOLDER], etc.\n#\n# The templates write their stubs with the example inline, as in\n# [Response time target - e.g., <200ms p95], [Uptime target - e.g., 99.9%]\n# and [What problem we're solving], so the body admits < > + % and the\n# apostrophe too. Without them those stubs pass the scan unfilled.\nPLACEHOLDER_BODY=\"[A-Za-z0-9 /,._<>+%'-]\"\n#\n# Exclude patterns that are NOT placeholders:\n#   [x] / [ ] (checkbox), [P0] / [P1] / [P2] (priority tags),\n#   [SPECKIT...] (markers), [ANCHOR...] (anchors),\n#   [EVIDENCE...] (checklist evidence), [W:...] (workstream),\n#   [NEEDS CLARIFICATION] (spec markers), [B] (blocked task)\n#\n# Also exclude lines where brackets appear inside code blocks\n# (backtick-wrapped) since those describe placeholder concepts\n# Rather than being actual unfilled placeholders.\n\nTOTAL=0\nMATCHES=\"\"\n\n# Process each .md file (skip backup/temp directories)\nwhile IFS= read -r file; do\n    # Skip backup directories and non-template subfolders.\n    # Memory/ contains generated session context markdown that legitimately\n    # Uses bracketed TOC links (e.g., [CONTINUE SESSION]); scratch/ is temp.\n    case \"$file\" in\n        */.backup-*) continue ;;\n        */memory/*) continue ;;\n        */scratch/*) continue ;;\n        # research/ and review/ hold the deep loops' own output: iteration files,\n        # dashboards and syntheses their workflow writes and regenerates, where\n        # bracketed status text such as [None yet] is the reducer's format rather\n        # than an unfilled template. The validator's placeholder rule reads only\n        # the authored docs, so this scan matches it.\n        */research/*) continue ;;\n        */review/*) continue ;;\n    esac\n\n    line_num=0\n    while IFS= read -r line; do\n        line_num=$((line_num + 1))\n\n        # Skip lines inside code fences or with backtick-wrapped brackets\n        case \"$line\" in\n            '```'*) continue ;;\n            *'`['*) continue ;;\n        esac\n\n        # Skip HTML comments\n        case \"$line\" in\n            *'<!--'*'-->'*) continue ;;\n        esac\n\n        # Match bracket patterns that look like placeholders\n        # Use grep to find [Something here] patterns\n        if echo \"$line\" | grep -qE \"\\[[A-Z]${PLACEHOLDER_BODY}+\\]\" 2>/dev/null; then\n            # Exclude known non-placeholder patterns\n            cleaned=\"$line\"\n            # Remove known safe patterns before re-checking\n            cleaned=$(echo \"$cleaned\" | sed -E \\\n                -e 's/\\[x\\]//g' \\\n                -e 's/\\[ \\]//g' \\\n                -e 's/\\[P[0-2]\\]//g' \\\n                -e 's/\\[B\\]//g' \\\n                -e 's/\\[SPECKIT[^]]*\\]//g' \\\n                -e 's/\\[ANCHOR[^]]*\\]//g' \\\n                -e 's/\\[EVIDENCE[^]]*\\]//g' \\\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"60f38c","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_adeb5bc84e744374bf2d9d736930eff0","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1-// ───────────────────────────────────────────────────────────────────\n2-// MODULE: Quality Gates\n3-// ───────────────────────────────────────────────────────────────────\n4:// Memory indexing decision logic and sufficiency abort formatting.\n5-// Extracted from workflow.ts to reduce module size.\n6-\n7-import {\n8-  MEMORY_SUFFICIENCY_REJECTION_CODE,\n9-  type MemorySufficiencyResult,\n10:} from '@spec-kit/shared/parsing/memory-sufficiency';\n11-\n12-import type { ValidationDispositionResult } from '../lib/validate-memory-quality.js';\n13-\n14-// ───────────────────────────────────────────────────────────────────\n15-// 1. FUNCTIONS\n16-// ───────────────────────────────────────────────────────────────────\n17-\n18-export function shouldIndexMemory(options: {\n19-  ctxFileWritten: boolean;\n20-  validationDisposition: ValidationDispositionResult;\n21-  templateContractValid: boolean;\n22:  sufficiencyPass: boolean;\n23-  qualityScore01: number;\n24-  qualityAbortThreshold: number;\n25-}): { shouldIndex: boolean; reason?: string } {\n26-  if (!options.ctxFileWritten) {\n27-    return {\n28-      shouldIndex: false,\n29-      reason: 'Context file content matched an existing memory file, so semantic indexing was skipped.',\n30-    };\n31-  }\n32-\n33-  if (!options.templateContractValid) {\n34-    return {\n35-      shouldIndex: false,\n36-      reason: 'Rendered memory failed the template contract, so semantic indexing was skipped.',\n37-    };\n38-  }\n39-\n40:  if (!options.sufficiencyPass) {\n41-    return {\n42-      shouldIndex: false,\n43:      reason: 'Rendered memory failed semantic sufficiency, so semantic indexing was skipped.',\n44-    };\n45-  }\n46-\n47-  if (options.qualityScore01 < options.qualityAbortThreshold) {\n48-    return {\n49-      shouldIndex: false,\n50-      reason: 'Rendered memory fell below the minimum quality threshold, so semantic indexing was skipped.',\n51-    };\n52-  }\n53-\n54-  if (options.validationDisposition.disposition === 'write_skip_index') {\n55-    return {\n56-      shouldIndex: false,\n57-      reason: `Validation rules require write-only persistence without semantic indexing: ${options.validationDisposition.indexBlockingRuleIds.join(', ')}`,\n58-    };\n59-  }\n60-\n61-  if (options.validationDisposition.disposition === 'abort_write') {\n62-    return {\n63-      shouldIndex: false,\n64-      reason: `Validation rules block writing and indexing: ${options.validationDisposition.blockingRuleIds.join(', ')}`,\n65-    };\n66-  }\n67-\n68-  return { shouldIndex: true };\n69-}\n70-\n71:/** Format a human-readable abort message from an insufficient-evidence sufficiency result. */\n72-export function formatSufficiencyAbort(result: MemorySufficiencyResult): string {\n73-  return `${MEMORY_SUFFICIENCY_REJECTION_CODE}: Not enough context for a proper memory. `\n74-    + `${result.reasons.join(' ')} `\n75-    + `Evidence counts: primary=${result.evidenceCounts.primary}, `\n76-    + `support=${result.evidenceCounts.support}, total=${result.evidenceCounts.total}, `\n77-    + `semanticChars=${result.evidenceCounts.semanticChars}, uniqueWords=${result.evidenceCounts.uniqueWords}.`;\n78-}\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"0e2998","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
