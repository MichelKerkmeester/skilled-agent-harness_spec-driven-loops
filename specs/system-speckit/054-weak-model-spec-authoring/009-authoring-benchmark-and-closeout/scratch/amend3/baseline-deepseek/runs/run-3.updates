{"toolCallId":"call_77056967c18e4a039a92acee544c0921","status":"completed","content":[{"type":"content","content":{"type":"text","text":"102: * SPECKIT_GENERATED_METADATA_DRIFT_GATE: Synopsis drift gate and shared-extractor routing.\n103- *\n104- * Default-ON and env-only, graduated after a scoped migration persisted source_doc_hashes\n105- * across the tree so the gate has a freshness baseline to compare against. With the flag on\n106- * both description and causal_summary derive from the one shared synopsis extractor,\n107- * source_doc_hashes persist as the cheap freshness key, and a drift report is a hard strict\n108- * failure. An explicit false, 0, or off opts back to grandfather report mode: the drift\n109- * report still surfaces in strict validation and dry-run backfill but never changes the\n110- * verdict, both fields keep their legacy local extractors, and no hashes are persisted.\n111- *\n112- * | Value          | Behavior                                                          |\n113- * |----------------|-------------------------------------------------------------------|\n114- * | unset / other  | (default) shared extractor, persisted hashes, drift fails strict   |\n115- * | `false`/`0`/off| grandfather report mode, legacy extractors, no hashes             |\n116- */\n117:const GENERATED_METADATA_DRIFT_GATE_ENV = 'SPECKIT_GENERATED_METADATA_DRIFT_GATE' as const;\n118-\n119-/**\n120- * Returns whether the generated-metadata drift gate enforces and routes both synopsis fields\n121- * through the shared extractor.\n122- *\n123- * Reads the environment on every call so a test can flip the behavior per-case, and stays ON\n124- * unless an explicit false, 0, or off opts back to grandfather report mode.\n125- */\n126-function isGeneratedMetadataDriftGateEnabled(): boolean {\n127:  return parseFlagTristate(GENERATED_METADATA_DRIFT_GATE_ENV, true);\n128-}\n129-\n130-/**\n131- * SPECKIT_GENERATOR_HARDENING: Graph-metadata generator hardening switch.\n132- *\n133- * Default-ON and env-only, graduated after a scoped migration restamped the tree with a\n134- * source_fingerprint and the unified phase-child contract so the enforcing integrity rule\n135- * has the fields to check. With the flag on the generator persists a source_fingerprint\n136- * over the volatile-ignoring source-doc projection, both the phase-parent classification\n137- * and the derived children list resolve through one shared listPhaseChildren enumeration,\n138- * and a read or resume routes access and freshness to the index-layer store instead of\n139- * dirtying the generated file. An explicit false, 0, or off opts back to the legacy split.\n140- *\n141- * | Value          | Behavior                                                          |\n142- * |----------------|-------------------------------------------------------------------|\n143- * | unset / other  | (default) fingerprint written, unified child contract, split      |\n144- * | `false`/`0`/off| no fingerprint, legacy split child paths, JSON pointer            |\n145- */\n146-const GENERATOR_HARDENING_ENV = 'SPECKIT_GENERATOR_HARDENING' as const;\n147-\n--\n222:  GENERATED_METADATA_DRIFT_GATE_ENV,\n223-  /** Documented generated-metadata grandfather env var name */\n224-  GENERATED_METADATA_GRANDFATHER_ENV,\n225-  /** Documented generator-hardening env var name */\n226-  GENERATOR_HARDENING_ENV,\n227-  /** Documented idempotent-description-writes env var name */\n228-  IDEMPOTENT_DESCRIPTION_WRITES_ENV,\n229-  /** Documented identity/merge-safety env var name */\n230-  IDENTITY_MERGE_SAFETY_ENV,\n231-  /** Documented status-completion-consistency-gate env var name */\n232-  STATUS_COMPLETION_CONSISTENCY_GATE_ENV,\n233-  parseFlagTristate,\n234-  isGeneratedMetadataDriftGateEnabled,\n235-  isGeneratedMetadataGrandfatherEnabled,\n236-  isGeneratorHardeningEnabled,\n237-  isIdempotentDescriptionWritesEnabled,\n238-  isIdentityMergeSafetyEnabled,\n239-  isStatusCompletionConsistencyGateEnabled,\n240-};\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"7e111e","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_77a286bed5ea4250950a70cfec4f51c0","status":"completed","content":[{"type":"content","content":{"type":"text","text":"        return title;\n      }\n    }\n  }\n  return null;\n}\n\nfunction extractFirstBodyLine(lines: string[]): string | null {\n  for (const line of lines) {\n    if (line.startsWith('#') || line.length === 0) continue;\n    const clean = stripInlineMarkers(line);\n    if (clean.length > 0) {\n      return firstSentence(clean);\n    }\n  }\n  return null;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ───────────────────────────────────────────────────────────────────\n\n/**\n * Clamp a generated synopsis to a length limit without cutting the final word when possible.\n *\n * @param synopsis - Candidate synopsis text\n * @param limit - Maximum character length\n * @returns The original string when at or below the limit, otherwise a word-boundary clamp\n */\nexport function truncateSynopsisAtWordBoundary(synopsis: string, limit: number): string {\n  if (synopsis.length <= limit) {\n    return synopsis;\n  }\n\n  const sentenceBoundary = sentenceBoundaryWithinLimit(synopsis, limit);\n  if (sentenceBoundary > 0) {\n    return synopsis.slice(0, sentenceBoundary).trim();\n  }\n\n  const truncated = synopsis.slice(0, limit);\n  const nextChar = synopsis[limit];\n  if (nextChar === undefined || /\\s/.test(nextChar)) {\n    return truncated.trim();\n  }\n\n  const boundary = truncated.search(/\\s+\\S*$/);\n  if (boundary > 0) {\n    return truncated.slice(0, boundary).trim();\n  }\n  return truncated.trim();\n}\n\n/**\n * Derive a packet synopsis from spec.md content with one shared precedence.\n *\n * Precedence (first match wins): the Overview section paragraph, the Problem/Purpose first\n * sentence, the frontmatter description, the title heading, then the first body line. The two\n * generated fields call this with their own `field`, so they derive from the same precedence\n * over the same source doc and only the length ceiling differs.\n *\n * @param specContent - Raw spec.md content (frontmatter included)\n * @param field - Which generated field is being derived, selects the length limit\n * @returns The synopsis trimmed to the field limit, or empty string when nothing extractable\n */\nexport function derivePacketSynopsis(specContent: string, field: SynopsisField): string {\n  const limit = SYNOPSIS_FIELD_LIMITS[field];\n  if (!specContent || typeof specContent !== 'string') {\n    return '';\n  }\n\n  const frontmatterDescription = extractFrontmatterDescription(specContent);\n  const body = stripYamlFrontmatter(specContent).trim();\n  const lines = body.split('\\n').map((line) => line.trim());\n\n  const synopsis =\n    extractOverviewParagraph(body)\n    ?? extractProblemSentence(lines)\n    ?? frontmatterDescription\n    ?? extractTitleHeading(lines)\n    ?? extractFirstBodyLine(lines)\n    ?? '';\n\n  return truncateSynopsisAtWordBoundary(synopsis, limit);\n}\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"347048","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
