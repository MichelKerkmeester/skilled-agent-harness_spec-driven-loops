ketReference,\n  type SaveLineage,\n} from './graph-metadata-schema.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst GRAPH_METADATA_STATUS_SET: ReadonlySet<string> = new Set(GRAPH_METADATA_STATUS_VALUES);\nconst PHASE_CHILD_DIRECTORY_RE = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"03ffd7","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
