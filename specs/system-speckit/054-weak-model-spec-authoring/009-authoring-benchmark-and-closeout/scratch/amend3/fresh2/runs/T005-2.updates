{"toolCallId":"call_9cade16662774796b41e8efe4a9825e4","status":"completed","content":[{"type":"content","content":{"type":"text","text":"{\n  \"name\": \"@spec-kit/runtime\",\n  \"version\": \"1.8.0\",\n  \"description\": \"Spec Kit engine - spec folder validation, generated metadata, description generation and the runtime hook adapters\",\n  \"type\": \"module\",\n  \"main\": \"dist/api/index.js\",\n  \"exports\": {\n    \".\": \"./dist/api/index.js\",\n    \"./api\": \"./dist/api/index.js\",\n    \"./api/*\": \"./dist/api/*.js\",\n    \"./hooks/lib/workspace/repo-root.mjs\": \"./hooks/lib/workspace/repo-root.mjs\",\n    \"./cli/retrieval/lib/phrase-judge.mjs\": \"./cli/retrieval/lib/phrase-judge.mjs\"\n  },\n  \"scripts\": {\n    \"clean\": \"node -e \\\"require('node:fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n    \"prepare-build\": \"node cli/lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime --entry default && node cli/lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime --entry validation-orchestrator\",\n    \"build\": \"npm run prepare-build && tsc --build && node scripts/finalize-dist.mjs\",\n    \"rebuild\": \"npm run clean && npm run build\",\n    \"typecheck\": \"tsc --noEmit --composite false -p tsconfig.json\",\n    \"check\": \"npm run lint && npx tsc --noEmit\",\n    \"check:full\": \"npm run check && npm run test\",\n    \"lint\": \"eslint . --ext .ts\",\n    \"test\": \"node scripts/run-tests.mjs\",\n    \"test:spec-validation\": \"node cli/tests/test-validation-system.cjs && bash cli/tests/test-validation.sh && bash cli/tests/test-validation-extended.sh\",\n    \"test:core\": \"vitest run\",\n    \"test:council\": \"vitest run tests/multi-ai-council-runtime-parity.vitest.ts tests/multi-ai-council-permission-scope.vitest.ts tests/multi-ai-council-audit-trail.vitest.ts tests/multi-ai-council-rollback.vitest.ts ../../system-deep-loop/runtime/tests/integration/council-graph-script.vitest.ts ../../system-deep-loop/runtime/tests/integration/council-graph-value-scenarios.vitest.ts tests/council-playbook-anchor-integrity.vitest.ts tests/council-helpers-smoke.vitest.ts cli/tests/multi-ai-council-persist-artifacts.vitest.ts\",\n    \"test:council:full\": \"bash cli/test-council-matrix.sh\",\n    \"test:task-enrichment\": \"npx vitest run cli/tests/task-enrichment.vitest.ts --config ../vitest.config.ts\",\n    \"test:watch\": \"vitest\",\n    \"typecheck:tests\": \"tsc --noEmit --composite false -p tsconfig.tests.json\",\n    \"test:sharded\": \"node scripts/run-tests-sharded.mjs\"\n  },\n  \"keywords\": [\n    \"spec-kit\",\n    \"validation\",\n    \"graph-metadata\"\n  ],\n  \"author\": \"Michel Kerkmeester\",\n  \"license\": \"MIT\",\n  \"engines\": {\n=== cli package ===\n{\n  \"name\": \"@spec-kit/cli\",\n  \"version\": \"1.7.2\",\n  \"description\": \"Continuity saves, spec-folder validation dispatch, packet metadata, retrieval tooling and cross-runtime mirrors for spec-kit\",\n  \"type\": \"module\",\n  \"main\": \"dist/continuity/generate-context.js\",\n  \"engines\": {\n    \"node\": \">=22.12.0\"\n  },\n  \"scripts\": {\n    \"clean\": \"node -e \\\"require('node:fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n    \"prepare-build\": \"node lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime/cli --entry default && node lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime/cli --entry is-phase-parent\",\n    \"build\": \"npm run prepare-build && tsc --build && npm run record-build\",\n    \"record-build\": \"node lib/dist-freshness.cjs record-build --package system-spec-kit/runtime/cli --entry default && node lib/dist-freshness.cjs record-build --package system-spec-kit/runtime/cli --entry is-phase-parent\",\n    \"rebuild\": \"npm run clean && npm run build\",\n    \"typecheck\": \"tsc --noEmit --composite false -p tsconfig.json\",\n    \"lint\": \"tsc --noEmit\",\n    \"pretest\": \"npm run build\",\n   