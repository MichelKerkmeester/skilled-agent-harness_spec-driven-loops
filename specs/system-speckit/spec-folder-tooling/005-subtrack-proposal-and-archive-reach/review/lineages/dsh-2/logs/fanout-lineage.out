do\n784:         case \"$1\" in\n785:             --list|-l) action=\"list\"; shift ;;\n786:             --restore|-r) action=\"restore\"; shift; target=\"${1:-}\"; shift || true ;;\n787:             --force|-f) force=true; shift ;;\n788:             --help|-h) show_help; exit 0 ;;\n789:             -*)\n790:                 log_error \"Unknown option: $1\"\n791:                 show_help\n792:                 exit 1\n793:                 ;;\n794:             *)\n795:                 if [[ -z \"$action\" ]]; then\n796:                     action=\"archive\"\n797:                     target=\"$1\"\n798:                 fi\n799:                 shift\n800:                 ;;\n801:         esac\n802:     done\n803: \n804:     case \"$action\" in\n805:         list) list_archived ;;\n806:         restore)\n807:             if [[ -z \"$target\" ]]; then\n808:                 log_error \"No folder specified for restore\"\n809:                 show_help\n810:                 exit 1\n811:             fi\n812:             reject_dot_segments \"$target\"\n813:             restore_spec \"$target\"\n814:             ;;\n815:         archive)\n816:             if [[ -z \"$target\" ]]; then\n817:                 log_error \"No spec folder specified\"\n818:                 show_help\n819:                 exit 1\n\n(Showing lines 740-819 of 836. Use offset=820 to continue.)\n</content>"}
