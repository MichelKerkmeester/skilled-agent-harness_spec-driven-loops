{"type":"tool_result","callId":"chatcmpl-tool-b85656015c501d5d","status":"completed","result":"<path>/Users/michelkerkmeester/MEGA/Development/Skilled/.skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Relocate\n4: // ───────────────────────────────────────────────────────────────────\n5: // Moves, renumbers or re-parents spec packets and leaves every store that\n6: // records a packet path agreeing with the new location. A packet's path is\n7: // written in many places: its own description.json and graph-metadata.json,\n8: // the packet_pointer in each document, a phase parent's children_ids, the track\n9: // and sub-track roots, other packets' manual references and markdown links, the\n10: // description cache and the trigger index. Moving the folder by hand leaves most\n11: // of them naming the old place, so this tool owns the order of operations and\n12: // drives the writer that already owns each store rather than writing a second\n13: // one.\n14: //\n15: // Dry by default: the run prints every move and every file it would change.\n16: // --apply writes. Every refusal happens before the first write, so a refused\n17: // plan changes nothing. The run is idempotent: an entry whose folder already\n18: // sits at its destination is checked for stale records only, and a second\n19: // --apply of an applied map finds nothing to do.\n20: //\n21: // Code and CI files are never rewritten. A moved path named in them fails the\n22: // run, because silently leaving a hook or workflow pointing at a folder that is\n23: // gone is worse than stopping.\n24: //\n25: // Usage (run from the repository root):\n26: //   node .skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs --map <file.json> [--apply]\n27: //   node .skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs --from <path> --to <path> [--apply]\n28: //   node .skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs --renumber <folder> [--apply]\n29: //   node .skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs --declare-subtrack <track>/<name> [--apply]\n30: //\n31: // A map file holds [{ \"from\": \"<track>/NNN-slug\", \"to\": \"<track>/<sub>/NNN-slug\" }].\n32: // Paths are specs-relative; a leading specs/ is accepted.\n33: //\n34: // Exit codes: 0 = nothing left to do (after --apply: every step landed),\n35: //             1 = work found (dry run only),\n36: //             2 = a rejected argument, a refused plan or a step that failed,\n37: //             3 = --apply landed every step and the close sweep, and only a\n38: //                 moved packet's own validation failed; a rerun finds nothing.\n39: // ───────────────────────────────────────────────────────────────────\n40: \n41: // ───────────────────────────────────────────────────────────────────\n42: // 1. IMPORTS\n43: // ───────────────────────────────────────────────────────────────────\n44: \n45: import { spawnSync } from 'node:child_process';\n46: import crypto from 'node:crypto';\n47: import fs from 'node:fs';\n48: import path from 'node:path';\n49: import { fileURLToPath } from 'node:url';\n50: \n51: import { SPEC_LEAF_SEGMENT_PATTERN, readWorkingTreeTracks, compareTrackChildren, parseTrackMetadata, trackLayout } from '../lib/track-roots.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const SCRIPT = 'relocate';\n58: const SCRIPT_DIR = path.dirname(fileURLToPath(import.meta.url));\n59: const SKILL_ROOT = path.resolve(SCRIPT_DIR, '../../..');\n60: const REPO = process.cwd();\n61: const SPECS = path.join(REPO, 'specs');\n62: \n63: const TOOLS = {\n64:   repair: path.join(SCRIPT_DIR, 'repair-derived.cjs'),\n65:   refresh: path.join(SCRIPT_DIR, 'refresh-track-roots.mjs'),\n66:   sweep: path.join(SCRIPT_DIR, 'sweep-track-roots.mjs'),\n67:   validate: path.join(SCRIPT_DIR, 'validate.sh'),\n68:   migrate: path.join(SKILL_ROOT, 'runtime/cli/graph/migrate-generated-json.ts'),\n69:   triggerIndex: path.join(SKILL_ROOT, 'runtime/cli/retrieval/generate-trigger-index.mjs'),\n70:   tsxLoader: path.join(SKILL_ROOT, 'node_modules/tsx/dist/loader.mjs'),\n71:   citeDrift: path.join(REPO, '.skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs'),\n72: };\n73: const LEDGER = path.join(REPO, '.skilled/skills/sk-doc/shared/scripts/relocation-ledger.json');\n74: const REDIRECTS = path.join(REPO, '.skilled/skills/sk-doc/shared/scripts/cite-drift-redirects.json');\n75: \n76: // The steps after the ledger write whose work lives outside the packet tree.\n77: // Each passing step marks its ledger batch, so a rerun can tell which one\n78: // stopped the earlier run and finish it instead of finding nothing to do.\n79: const LATE_STEPS = ['redirects', 'triggerIndex', 'sweep'];\n80: \n81: // Hard-coded packet paths live here. They are reported and never rewritten.\n82: const CODE_FILES = ['.skilled/bin/lib/compiled-route-layout.cjs'];\n83: const CODE_DIRS = ['.github/workflows'];\n84: \n85: // A packet folder is three digits, a hyphen and a slug, the name archive.sh\n86: // and create.sh accept. A looser name would be a folder no other tool can find.\n87: const PACKET_NAME = /^\\d{3}-[A-Za-z0-9._-]+$/;\n88: const CONTAINER_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;\n89: const ARCHIVE = 'z_archive';\n90: const SUB_TRACK_LEVEL = 'sub-track';\n91: \n92: // Text that can carry a packet path. Anything else under specs/ is left alone.\n93: const TEXT_EXTENSIONS = new Set(['.md', '.json', '.jsonl', '.yaml', '.yml', '.txt']);\n94: const SKIP_DIRS = new Set(['.git', 'node_modules']);\n95: \n96: // Characters that continue a path segment. An id followed by one of them is a\n97: // different, longer id: demo/001-a inside demo/001-a-b must not match.\n98: const SEGMENT_CHAR = 'A-Za-z0-9_\\\\-';\n99: \n100: // The one row a packet summary records its own folder in. The repair writer\n101: // owns that row after a move; the reference pass writes it too, so a bare old\n102: // name is not left behind while the rest of the document is being rewritten.\n103: const SPEC_FOLDER_ROW = /(\\|[ \\t]*\\*\\*Spec Folder\\*\\*[ \\t]*\\|[ \\t]*)([^|\\r\\n]+?)([ \\t]*\\|)/;\n104: \n105: // The documents whose frontmatter packet_pointer the repair writer owns.\n106: const POINTER_DOCS = ['spec.md', 'plan.md', 'tasks.md', 'implementation-summary.md', 'handover.md', 'goal.md', 'acceptance-criteria.md', 'resource-map.md', 'decision-record.md'];\n107: const POINTER_LINE = /^[ \\t]*packet_pointer:[ \\t]*[\"']?([^\"'\\r\\n]*?)[\"']?[ \\t]*\\r?$/m;\n108: // The recorded pointer lives in the leading YAML block, which can sit behind a\n109: // template-source comment. These mirror the repair writer's own reading.\n110: const FRONTMATTER_OPEN = /^﻿?(?:[ \\t]*\\r?\\n|<!--[\\s\\S]*?-->[ \\t]*\\r?\\n)*---[ \\t]*\\r?\\n/;\n111: const FRONTMATTER_CLOSE = /^(?:---|\\.\\.\\.)[ \\t]*\\r?$/m;\n112: \n113: const CHILD = { cwd: REPO, encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 };\n114: \n115: const USAGE = `Usage: relocate.mjs (--map <file.json> | --from <path> --to <path> | --renumber <folder> | --declare-subtrack <track>/<name>) [--apply]`;\n116: \n117: /** A rejected argument. The usage line follows it. */\n118: class UsageError extends Error {}\n119: \n120: // ─────────────","truncated":true}
{"type":"tool_result","callId":"chatcmpl-tool-94204a7fd17c656b","status":"completed","result":"<path>/Users/michelkerkmeester/MEGA/Development/Skilled/.skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs</path>\n<type>file</type>\n<content>\n1290: \n1291: function ledgerHas(ledger, entry) {\n1292:   return batchOf(ledger, entry) !== null;\n1293: }\n1294: \n1295: /**\n1296:  * Whether a record shows that the map already moved this entry: the relocation\n1297:  * record holds the pair, or git holds the source at HEAD but not the\n1298:  * destination, which is a tracked move left uncommitted. A plain rename of an\n1299:  * untracked folder leaves neither record.\n1300:  */\n1301: function recordedMove(entry, ledger) {\n1302:   if (ledgerHas(ledger, entry)) return true;\n1303:   const atHead = (id) => runChild('git', ['rev-parse', '--verify', '--quiet', `HEAD:specs/${id}`]).ok;\n1304:   return atHead(entry.from) && !atHead(entry.to);\n1305: }\n1306: \n1307: /** The late steps not yet marked as passed on every entry's ledger batch. */\n1308: function pendingLateSteps(ledger, entries) {\n1309:   return LATE_STEPS.filter((step) => entries.some((entry) => {\n1310:     const batch = batchOf(ledger, entry);\n1311:     return !batch || !batch.steps || batch.steps[step] !== true;\n1312:   }));\n1313: }\n1314: \n1315: /** Records a late step that passed on the ledger batch holding each entry. */\n1316: function markLateStep(entries, step) {\n1317:   const ledger = readLedger();\n1318:   let changed = false;\n1319:   for (const entry of entries) {\n1320:     const batch = batchOf(ledger, entry);\n1321:     if (!batch) continue;\n1322:     if (!batch.steps || typeof batch.steps !== 'object' || Array.isArray(batch.steps)) batch.steps = {};\n1323:     if (batch.steps[step] !== true) {\n1324:       batch.steps[step] = true;\n1325:       changed = true;\n1326:     }\n1327:   }\n1328:   if (changed) writeAtomic(LEDGER, `${JSON.stringify(ledger, null, 2)}\\n`);\n1329: }\n1330: \n1331: // ───────────────────────────────────────────────────────────────────\n1332: // 8. PLAN\n1333: // ───────────────────────────────────────────────────────────────────\n1334: \n1335: function scanCode(entries) {\n1336:   const hits = [];\n1337:   const files = [...CODE_FILES.map((file) => path.join(REPO, file))];\n1338:   for (const dir of CODE_DIRS) {\n1339:     let names = [];\n1340:     try {\n1341:       names = fs.readdirSync(path.join(REPO, dir));\n1342:     } catch {\n1343:       names = [];\n1344:     }\n1345:     for (const name of names.sort()) if (/\\.ya?ml$/.test(name)) files.push(path.join(REPO, dir, name));\n1346:   }\n1347:   const patterns = entries.map((entry) => ({ id: entry.from, pattern: codePattern(entry.from) }));\n1348:   for (const file of files) {\n1349:     const text = readText(file);\n1350:     if (text === null) continue;\n1351:     text.split('\\n').forEach((line, index) => {\n1352:       for (const { id, pattern } of patterns) {\n1353:         if (pattern.test(line)) hits.push(`${rel(file)}:${index + 1} names specs/${id}`);\n1354:       }\n1355:     });\n1356:   }\n1357:   return hits;\n1358: }\n1359: \n1360: // The map file is the run's input and names every old id on purpose, so it is\n1361: // never one of the references the run rewrites, wherever it is kept.\n1362: function buildPlan(entries, newSubtracks, inputs = new Set()) {\n1363:   const transform = buildTransform(entries, bareNameEdits(entries), phaseRowEdits(entries));\n1364:   const editsByFile = childrenEdits(entries);\n1365:   const forwardPending = makePathMapper(entries.filter((entry) => entry.state === 'pending').map((entry) => [abs(entry.from), abs(entry.to)]));\n1366: \n1367:   // One pass over every text file: the children edit first, so a re-parented id\n1368:   // is dropped rather than renamed in its old parent, then the reference rewrite.\n1369:   const rewrites = [];\n1370:   const childNotes = [];\n1371:   const phaseNotes = [];\n1372:   // A rerun that finishes an interrupted apply cannot know which packets the\n1373:   // first run rewrote, so every packet that now names a moved packet is\n1374:   // re-derived again. The repair writer only writes what its validator flags,\n1375:   // so this costs time, never a wrong write, and it is not counted as work.\n1376:   const doneIds = entries.filter((entry) => entry.state === 'done').map((entry) => entry.to);\n1377:   const namesMoved = doneIds.length ? new RegExp(wholeIdPattern(doneIds).source) : null;\n1378:   const followUp = new Set();\n1379:   const destinationRoots = entries.map((entry) => abs(entry.to));\n1380:   for (const file of textFiles(SPECS)) {\n1381:     if (inputs.has(file)) continue;\n1382:     const original = readText(file);\n1383:     if (original === null) continue;\n1384:     if (namesMoved && namesMoved.test(original) && !destinationRoots.some((dest) => file.startsWith(`${dest}${path.sep}`))) {\n1385:       const packet = packetOf(file);\n1386:       if (packet) followUp.add(packet);\n1387:     }\n1388:     let text = original;\n1389:     let changes = 0;\n1390:     const edit = editsByFile.get(file);\n1391:     if (edit) {\n1392:       const applied = applyChildrenEdit(text, edit);\n1393:       if (applied) {\n1394:         text = applied.text;\n1395:         changes += applied.dropped.length + applied.added.length;\n1396:         for (const id of applied.dropped) childNotes.push(`children_ids specs/${edit.parent}: drop ${id}`);\n1397:         for (const id of applied.added) childNotes.push(`children_ids specs/${edit.parent}: add ${id}`);\n1398:       }\n1399:     }\n1400:     const result = transform(file, text);\n1401:     changes += result.changes;\n1402:     for (const note of result.notes) phaseNotes.push(`phase row ${note}`);\n1403:     if (changes === 0) continue;\n1404:     rewrites.push({\n1405:       file,\n1406:       target: forwardPending(file),\n1407:       hash: crypto.createHash('sha256').update(original).digest('hex'),\n1408:       text: result.text,\n1409:       changes,\n1410:     });\n1411:   }\n1412: \n1413:   const pending = entries.filter((entry) => entry.state === 'pending');\n1414:   const done = entries.filter((entry) => entry.state === 'done');\n1415: \n1416:   const identity = [];\n1417:   for (const entry of pending) identity.push({ entry, reasons: ['moved'] });\n1418:   for (const entry of done) {\n1419:     for (const folder of specFoldersUnder(abs(entry.to))) {\n1420:       const reasons = staleIdentity(folder, entry);\n1421:       if (reasons) identity.push({ entry, folder, reasons });\n1422:     }\n1423:   }\n1424: \n1425:   const touched = new Set();\n1426:   const destinations = entries.map((entry) => abs(entry.to));\n1427:   for (const rewrite of rewrites) {\n1428:     if (destinations.some((dest) => rewrite.target === dest || rewrite.target.startsWith(`${dest}${path.sep}`))) continue;\n1429:     const packet = packetOf(rewrite.target);\n1430:     if (packet) touched.add(packet);\n1431:   }\n1432: \n1433:   // Track and sub-track roots whose children lists the moves change.\n1434:   const trackNames = new Set();\n1435:   for (const entry of entries) {\n1436:     for (const dir of [parentId(entry.from), parentId(entry.to)]) {\n1437:       const level = trackLevelOf(dir, newSubtracks);\n1438:       if (level) {\n1439:         trackNames.add(level);\n1440:         if (level.includes('/')) trackNames.add(level.split('/')[0]);\n1441:       }\n1442:     }\n1443:   }\n1444:   for (const sub of newSubtracks) {\n1445:     trackNames.add(sub);\n1446:     trackNames.add(sub.split('/')[0]);\n1447:   }\n1448:   const known = new Map(readWorkingTreeTracks(SPECS).map((track) => [track.name, track]));\n1449:   const trackWork = [];\n1450:   for (const name of [...trackNames].sort()) {\n1451:     if (newSubtracks.has(name) || pending.length > 0) {\n1452:       if (known.has(name) || newSubtracks.has(name) || (name.includes('/') && known.has(name.split('/')[0]))) trackWork.push(name);\n1453:       continue;\n1454:     }\n1455:     const track = known.get(name);\n1456:     if (!track) continue;\n1457:     const metadata = parseTrackMetadata(track.rawMetadata);\n1458:     if ","truncated":true}
