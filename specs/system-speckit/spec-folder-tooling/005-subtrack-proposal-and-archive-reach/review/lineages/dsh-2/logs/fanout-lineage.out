{"type":"tool_result","callId":"chatcmpl-tool-a6d77ade3c820f30","status":"completed","result":"append-mode-event.cjs\nappend-state-record.cjs\ncheck-contract-drift.cjs\ncheck-direct-append.cjs\ncheck-documentation-drift.cjs\ncheck-ledger-stem-producers.cjs\ncheck-projection-coverage.cjs\ncheck-protocol-append-sites.cjs\ncodex-dispatch.cjs\ncompile-command-contracts.cjs\nconvergence.cjs\nfanout-merge.cjs\nfanout-pool.cjs\nfanout-run.cjs\nfanout-salvage.cjs\nlib\nloop-lock.cjs\nopencode-version.cjs\nquery.cjs\nREADME.md\nreduce-state.cjs\nrender-command-contract.cjs\nruntime-bootstrap.cjs\nscore-fanout-pairs.cjs\nstatus.cjs\nsynthesis-closeout.cjs\nupsert.cjs\nverify-authority.cjs\nverify-iteration.cjs\n---\n#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Mode Event Append CLI\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TSX BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst TSX_LOADER = require.resolve('tsx');\nconst isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n\nfunction runTsxBootstrap() {\n  const { spawn } = require('node:child_process');\n  const child = spawn(\n    process.execPath,\n    ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n    {\n      cwd: process.cwd(),\n      env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n      stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n    },\n  );\n\n  if (!process.stdin.isTTY && child.stdin) {\n    child.stdin.on('error', () => {});\n    process.stdin.pipe(child.stdin);\n  }\n\n  child.stdout?.pipe(process.stdout);\n  child.stderr?.pipe(process.stderr);\n\n  for (const signal of ['SIGINT', 'SIGTERM']) {\n    process.once(signal, () => {\n      child.kill(signal);\n    });\n  }\n"}
