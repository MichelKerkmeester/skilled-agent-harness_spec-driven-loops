ex < cliArgs.length; index += 1) {\n      const token = cliArgs[index];\n      if (!token.startsWith('--')) {\n        if (specFolder !== undefined) throw inputError(`Unexpected positional argument: ${token}`);\n        specFolder = token;\n        continue;\n      }\n      const key = token.slice(2).replace(/-([a-z])/g, (_, character) => character.toUpperCase());\n      if (!booleanFlags.has(key) && !valueFlags.has(key)) throw inputError(`Unknown flag: ${token}`);\n      const next = cliArgs[index + 1];\n      if (booleanFlags.has(key)) {\n        if (next !== undefined && !next.startsWith('--')) throw inputError(`${token} does not take a value`);\n        parsedArgs[key] = true;\n        continue;\n      }\n      if (next === undefined || next.startsWith('--')) throw inputError(`${token} requires a value`);\n      parsedArgs[key] = next;\n      index += 1;\n    }\n  } catch (error) {\n    process.stderr.write(`${error.message}\\n`);\n    process.exit(3);\n  }\n\n  if (!specFolder) {\n    process.stderr.write(\n      'Usage: node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n    );\n    process.exit(3);\n  }\n\n  const emitResourceMapOutput = Boolean(parsedArgs.emitResourceMap);\n  try {\n    const result = reduceReviewState(specFolder, {\n      write: true,\n      lenient: Boolean(parsedArgs.lenient),\n      createMissingAnchors: Boolean(parsedArgs.createMissingAnchors),\n      emitResourceMap: emitResourceMapOutput,\n      artifactDir: parsedArgs.artifactDir,\n    });\n    if (result.strategyWarning) {\n      process.stderr.write(`[deep-review] warning: ${result.strategyWarning}\\n`);\n    }\n    process.stdout.write(\n=== delta reading ===\n178:function loadDeltaPayloads(deltaDir) {\n179:  if (!fs.existsSync(deltaDir)) {\n183:  const deltaCorruptionWarnings = [];\n184:  const payloads = fs.readdirSync(deltaDir)\n185:    .filter((fileName) => /^iter-\\d+\\.jsonl$/.test(fileName))\n188:      const { records, corruptionWarnings: parseWarnings } = parseJsonlDetailed(readUtf8(path.join(deltaDir, fileName)));\n193:        deltaCorruptionWarnings.push({ ...warning, file: fileName });\n198:  return { payloads, corruptionWarnings: deltaCorruptionWarnings };\n320:      // The id follows the delta-row convention, R<iteration>-<severity>-<NNN>,\n616: * Convert a {type:\"finding\"} delta record to the structured-finding shape\n625:function deltaRecordToFinding(record) {\n661:    deltaStatus: record.status || null,\n663:    // re-open raw delta files for scope and surface hints.\n747:    deltaStatus: detail.disposition || detail.status || null,\n756:function collectSummaryFallbackRecords(iterationRecords, deltaRecords) {\n760:    .concat(Array.isArray(deltaRecords) ? deltaRecords : [])\n852:    deltaStatus: 'active',\n947:function buildFindingRegistry(iterationFiles, iterationRecords, deltaRecords = []) {\n1003:  const deltaFindingsByRun = new Map();\n1004:  for (const record of deltaRecords) {\n1005:    const finding = deltaRecordToFinding(record);\n1008:    if (!deltaFindingsByRun.has(run)) {\n1009:      deltaFindingsByRun.set(run, []);\n1011:    deltaFindingsByRun.get(run).push(finding);\n1014:  // Process deltas in iteration order so transitions reflect chronology.\n1018:  const sortedRuns = [...deltaFindingsByRun.keys()].sort((a, b) => a - b);\n1021:    for (const finding of deltaFindingsByRun.get(run)) {\n1022:      upsertFinding(finding, run, pseudoIteration, 'Initial discovery (delta)', 'Severity adjusted in later delta');\n1026:  // An iteration that recorded delta finding rows or findingDetails already has its\n1031:  const structuredRuns = new Set(deltaFindingsByRun.keys());\n1038:  for (const [run, findings] of deltaFindingsByRun) {\n1041:  const mergedRecords = [...iterationRecords, ...deltaRecords];\n1047:      // The summary fallback reads findingDetails only for a run with no delta rows.\n1048:    