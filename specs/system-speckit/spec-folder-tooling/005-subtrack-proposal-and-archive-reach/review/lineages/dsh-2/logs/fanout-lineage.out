{"type":"tool_result","callId":"chatcmpl-tool-8655ea4bd1915871","status":"completed","result":"10:// description cache and the trigger index. Moving the folder by hand leaves most\n17:// plan changes nothing. The run is idempotent: an entry whose folder already\n22:// run, because silently leaving a hook or workflow pointing at a folder that is\n28://   node .skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs --renumber <folder> [--apply]\n85:// A packet folder is three digits, a hyphen and a slug, the name archive.sh\n86:// and create.sh accept. A looser name would be a folder no other tool can find.\n100:// The one row a packet summary records its own folder in. The repair writer\n115:const USAGE = `Usage: relocate.mjs (--map <file.json> | --from <path> --to <path> | --renumber <folder> | --declare-subtrack <track>/<name>) [--apply]`;\n222:/** The numbered folders directly in a directory, by name. */\n340:// Closes the number gaps among a folder's numbered children, in their current\n341:// order. Numbers held in the folder's z_archive count as taken, so a renumber\n344:  const folder = rawFolder.trim() === 'specs' ? '' : normalizeId(rawFolder, '--renumber', refusals);\n345:  if (folder === null) return [];\n346:  if (!isDir(abs(folder))) {\n347:    refusals.push(`--renumber specs/${folder}: not a folder`);\n350:  const children = numberedDirs(abs(folder)).sort((a, b) => numberOf(a) - numberOf(b) || (a < b ? -1 : 1));\n351:  const taken = new Set(numberedDirs(path.join(abs(folder), ARCHIVE)).map(numberOf));\n359:      const prefix = folder === '' ? '' : `${folder}/`;\n370:/** The track or sub-track whose children list a folder directly in it belongs to. */\n396:// numbered folders and archives only. Returns the sub-track it would create.\n472:// Whether the volume that holds specs/ folds case. The duplicate checks may\n473:// fold the unwritten part of a path only where it does; the specs root answers\n474:// that by naming the same folder under a flipped spelling, with no probe file.\n475:let caseFolds;\n477:  if (caseFolds !== undefined) return caseFolds;\n480:  caseFolds = Boolean(spelled && flipped && spelled.dev === flipped.dev && spelled.ino === flipped.ino);\n481:  return caseFolds;\n485: * One key per folder for the duplicate checks. An existing folder is its\n487: * folder that does not exist yet is its longest existing parent's device and\n488: * inode plus the rest of the path, folded where the volume folds case, so two\n--- renumber archive ---\n89:const ARCHIVE = 'z_archive';\n341:// order. Numbers held in the folder's z_archive count as taken, so a renumber\n342:// never gives a live packet the number of an archived one.\n343:function renumberEntries(rawFolder, refusals) {\n412:      refusals.push(`to specs/${entry.to}: \"${segment}\" is not a track, a sub-track, a packet or z_archive in that position`);\n582:  // A packet number names one folder among its siblings, live or archived, so a\n651: * The id a packet had before it was archived, keyed to the destination it now\n652: * names: the source id with its z_archive folder removed, for an entry that\n654: * document written before the packet was archived still names it. A folder\n1027:  // The archive spelling and the id the packet had before it was archived name\n1743:  else if (options.renumber !== null) rawEntries = renumberEntries(options.renumber, refusals);\n"}
