es(options.renumber, refusals);\n1744:   else rawEntries = [{ rawFrom: options.from, rawTo: options.to }];\n1745:   if (refusals.length) return refuse(refusals);\n1746:   if (rawEntries.length === 0) {\n1747:     out(`${SCRIPT}: no moves to make; nothing to do`);\n1748:     return 0;\n1749:   }\n1750: \n1751:   const { entries, newSubtracks } = preflight(rawEntries, refusals);\n1752:   if (refusals.length) return refuse(refusals);\n1753:   if (entries.length === 0) {\n1754:     out(`${SCRIPT}: every entry already names its own place; nothing to do`);\n1755:     return 0;\n1756:   }\n1757: \n1758:   const codeHits = scanCode(entries);\n1759:   if (codeHits.length) {\n1760:     return refuse([\n1761:       ...codeHits.map((hit) => `${hit}; code and CI are never rewritten here, update them in the same change`),\n1762:     ]);\n1763:   }\n1764: \n1765:   const inputs = new Set(options.map !== null ? [path.resolve(REPO, options.map)] : []);\n1766:   const plan = buildPlan(entries, newSubtracks, inputs);\n1767: \n1768:   // Uncommitted work on a path this run would move or rewrite could not be told\n1769:   // apart from the run's own changes afterwards. A rerun that completes an applied\n1770:   // map works on this tool's own output, so it is not held to the check.\n1771:   let tracked = new Set();\n1772:   if (plan.pending.length > 0) {\n1773:     const state = gitState();\n1774:     if (!state) return refuse(['git status failed; the dirty-tree check needs a git work tree']);\n1775:     tracked = state.tracked;\n1776:     const dirtyRefusals = [];\n1777:     for (const entry of plan.pending) {\n1778:       const fromRel = `specs/${entry.from}`;\n1779:       if (anyUnder(state.tracked, fromRel) && anyUnder(state.dirty, fromRel)) dirtyRefusals.push(`from ${fromRel}: has uncommitted changes`);\n1780:     }\n1781:     const untrackedSources = plan.pending.map((entry) => `specs/${entry.from}`).filter((fromRel) => !anyUnder(state.tracked, fromRel));\n1782:     // A staged move makes every file under a destination this map already\n1783:     // reached look uncommitted. That dirt is the run's own earlier output, so\n1784:     // rewriting it finishes the interrupted step instead of refusing on it.\n1785:     const movedDestinations = plan.done.map((entry) => `specs/${entry.to}`);\n1786:     const affected = [...plan.rewrites.map((rewrite) => rel(rewrite.file))];\n1787:     for (const name of plan.trackWork) affected.push(`specs/${name}/graph-metadata.json`);\n1788:     for (const file of affected) {\n1789:       if (untrackedSources.some((source) => file.startsWith(`${source}/`))) continue;\n1790:       if (movedDestinations.some((destination) => file === destination || file.startsWith(`${destination}/`))) continue;\n1791:       if (state.dirty.has(file)) dirtyRefusals.push(`${file}: has uncommitted changes and would be rewritten`);\n1792:     }\n1793:     if (dirtyRefusals.length) return refuse(dirtyRefusals);\n1794:   }\n1795: \n1796:   printPlan(plan, options.apply);\n1797:   if (!hasWork(plan)) {\n1798:     out(`${SCRIPT}: nothing to do`);\n1799:     return 0;\n1800:   }\n1801:   if (!options.apply) return 1;\n1802: \n1803:   out('');\n1804:   if (!applyPlan(plan, tracked)) {\n1805:     out(`${SCRIPT}: stopped; the report above names the failed step. Rerun the same map to finish it.`);\n1806:     return 2;\n1807:   }\n1808:   out(`${SCRIPT}: applied ${plan.pending.length} move(s)${plan.done.length ? `, finished ${plan.done.length} earlier move(s)` : ''}`);\n1809:   out('');\n1810:   return closeRun(plan);\n1811: }\n1812: \n1813: // A reader that closes early is not a failure.\n1814: for (const stream of [process.stdout, process.stderr]) {\n1815:   stream.on('error', (err) => {\n1816:     if (err && err.code !== 'EPIPE') process.exitCode = 2;\n1817:   });\n1818: }\n1819: \n1820: try {\n1821:   process.exitCode = main();\n1822: } catch (err) {\n1823:   if (err instanceof UsageError) process.stderr.write(`${SCRIPT}: ${err.message}\\n${