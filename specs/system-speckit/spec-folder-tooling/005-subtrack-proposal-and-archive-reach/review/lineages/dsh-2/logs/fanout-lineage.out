{"type":"tool_result","callId":"chatcmpl-tool-9944ba6f0ab78e10","status":"completed","result":"10:# Usage: archive-spec.sh <spec-folder> | --list | --restore <folder>\n58:    archive-spec.sh --restore <archived-folder>\n62:    --restore, -r       Restore an archived spec folder\n73:    archive-spec.sh --restore specs/z_archive/051-feature-name/\n74:    archive-spec.sh --restore specs/my-track/z_archive/012-feature-name/\n75:    archive-spec.sh --restore specs/my-track/012-feature-name/z_archive/003-phase-name/\n84:    - A restore whose number a live packet already holds lands on the next free\n86:    - A z_archive/ that is a symlink is refused on archive and on restore\n87:    - An archive or restore argument that passes through a symlink is refused,\n89:    - An archive or restore path with a . or .. segment is refused, since a\n118:# the packet's to refuse. An argument from outside the specs root is refused\n137:                refuse_linked_argument \"$argument\" \"$prefix\" \"$action\"\n144:        refuse_linked_argument \"$argument\" \"$argument\" \"$action\"\n150:refuse_linked_argument() {\n155:    log_error \"Path argument passes through a symbolic link, not followed, and is refused: $argument\"\n358:# A restore is refused when the relocation preflight for the same move reports\n362:# answer stay with the restore's own checks.\n363:refuse_mixed_track_restore() {\n374:    # become mixed, so the preflight has no mixed-track verdict to give.\n380:    # \"work found\" and a plain refusal, so the status is captured with the\n381:    # output. Only the mixed-track line below decides.\n394:    log_error \"Restore refused: track specs/$track would hold flat packets. Move the packet into a sub-track instead: node $relocate_script --from $from_id --to ${sub_id:-$track/<sub>}/$name --apply\"\n399:# archived, so the restored packet cannot collide with either. relocate.mjs then\n401:restore_on_next_number() {\n474:# The archive beside a packet home. A symlink is refused before anything is created\n484:        log_error \"Archive directory is a symbolic link, not followed, and is refused: $archive_root\"\n607:    # someone runs it. A restore then finds the phase still listed.\n629:# Every archive a folder can be restored from, as paths relative to the project\n676:    echo \"To restore: archive-spec.sh --restore <path above>\"\n679:restore_spec() {\n685:    # A link named as the archive folder is refused before the folder is resolved,\n690:        log_error \"Archive directory is a symbolic link, not followed, and is refused: $archive_named\"\n725:    # root if that derivation ever changes, and a link at the target is refused\n736:    # A folder or link already at the exact destination is refused: two live\n743:    # Both restore paths move the folder from here on, so the mixed-track\n745:    refuse_mixed_track_restore \"$resolved_archived\" \"$destination\" \"$specs_root\"\n748:    # under another name already holds the restored packet's number, the packet\n760:        restore_on_next_number \"$resolved_archived\" \"$home\" \"$archive_dir\" \"$basename\" \"$specs_root\" \"$number_holder\"\n786:            --restore|-r) action=\"restore\"; shift; target=\"${1:-}\"; shift || true ;;\n806:        restore)\n808:                log_error \"No folder specified for restore\"\n813:            restore_spec \"$target\"\n"}
