{"type":"tool_result","callId":"chatcmpl-tool-bd0ae95f484b35a5","status":"completed","result":"<path>/Users/michelkerkmeester/MEGA/Development/Skilled/.skilled/skills/system-spec-kit/runtime/cli/retrieval/rg-wrapper.mjs</path>\n<type>file</type>\n<content>\n350: \n351:   if (recipe === 'structured') {\n352:     const parsed = parseJsonLines(run.stdout);\n353:     const ranked = rankMatches(parsed.matches, { cwd, normalizedQuery: normalizeTriggerText(phrase) });\n354:     // One row per file is a post-rank filter, not a second ranker: the first\n355:     // row for a path is already that file's highest-ranked line.\n356:     const shaped = shapeRankedMatches(ranked, { limit: options.limit ?? DEFAULT_LIMIT });\n357:     record.results = includeArchive\n358:       ? shaped.results.map((result) => ({ ...result, archived: isArchivedPath(result.path) }))\n359:       : shaped.results;\n360:     record.matchCount = shaped.matchCount;\n361:     record.fileCount = shaped.fileCount;\n362:     record.hidden = shaped.hidden;\n363:     record.limit = shaped.limit;\n364:     record.truncated = shaped.hidden.files > 0;\n365:     record.unparsedLines = parsed.unparsedLines;\n366:     return record;\n367:   }\n368: \n369:   // Ripgrep walks in parallel, so its line order changes between runs. Both\n370:   // lists are sorted before the cut so a limit keeps the same files every time.\n371:   const lines = run.stdout.split('\\n').filter((line) => line.length > 0);\n372:   const limit = options.limit ?? DEFAULT_LIMIT;\n373:   const keep = limit === 0 ? lines.length : limit;\n374:   record.limit = limit;\n375:   record.fileCount = lines.length;\n376: \n377:   if (recipe === 'path') {\n378:     // The path recipe stops at one match per file, so it has no match total.\n379:     record.paths = lines.sort().slice(0, keep);\n380:     // `paths` stays a list of plain strings for its readers; the archived subset\n381:     // is reported beside it so a JSON consumer can label those files.\n382:     record.archivedPaths = record.paths.filter(isArchivedPath);\n383:     record.hidden = { files: lines.length - record.paths.length, matches: null };\n384:     record.truncated = record.hidden.files > 0;\n385:     return record;\n386:   }\n387: \n388:   const counts = lines\n389:     .map((line) => {\n390:       const separator = line.lastIndexOf(':');\n391:       return { count: Number(line.slice(separator + 1)), path: line.slice(0, separator) };\n392:     })\n393:     .sort((a, b) => b.count - a.count || a.path.localeCompare(b.path));\n394:   const sum = (entries) => entries.reduce((total, entry) => total + entry.count, 0);\n395:   const kept = counts.slice(0, keep);\n396:   record.counts = includeArchive\n397:     ? kept.map((entry) => ({ ...entry, archived: isArchivedPath(entry.path) }))\n398:     : kept;\n399:   record.matchCount = sum(counts);\n\n(Showing lines 350-399 of 550. Use offset=400 to continue.)\n</content>"}
