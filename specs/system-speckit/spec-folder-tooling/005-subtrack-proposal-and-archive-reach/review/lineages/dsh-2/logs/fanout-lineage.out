{"type":"tool_result","callId":"chatcmpl-tool-889337c0351e7e60","status":"completed","result":"<path>/Users/michelkerkmeester/MEGA/Development/Skilled/.skilled/skills/system-spec-kit/runtime/cli/spec/relocate.mjs</path>\n<type>file</type>\n<content>\n460:       dirty.add(records[index + 1]);\n461:       index += 1;\n462:     }\n463:   }\n464:   return { dirty, tracked: new Set(tracked.stdout.split('\\0').filter(Boolean)) };\n465: }\n466: \n467: function anyUnder(set, prefix) {\n468:   for (const item of set) if (item === prefix || item.startsWith(`${prefix}/`)) return true;\n469:   return false;\n470: }\n471: \n472: // Whether the volume that holds specs/ folds case. The duplicate checks may\n473: // fold the unwritten part of a path only where it does; the specs root answers\n474: // that by naming the same folder under a flipped spelling, with no probe file.\n475: let caseFolds;\n476: function volumeFoldsCase() {\n477:   if (caseFolds !== undefined) return caseFolds;\n478:   const spelled = statOrNull(SPECS);\n479:   const flipped = statOrNull(path.join(path.dirname(SPECS), path.basename(SPECS).toUpperCase()));\n480:   caseFolds = Boolean(spelled && flipped && spelled.dev === flipped.dev && spelled.ino === flipped.ino);\n481:   return caseFolds;\n482: }\n483: \n484: /**\n485:  * One key per folder for the duplicate checks. An existing folder is its\n486:  * device and inode, so a spelling the tree does not use still names it. A\n487:  * folder that does not exist yet is its longest existing parent's device and\n488:  * inode plus the rest of the path, folded where the volume folds case, so two\n489:  * ways of writing the same future folder compare equal before either move\n490:  * creates it.\n491:  */\n492: function folderIdentity(id) {\n493:   let current = abs(id);\n494:   const rest = [];\n495:   let stat = statOrNull(current);\n496:   while (!stat && path.dirname(current) !== current) {\n497:     rest.unshift(path.basename(current));\n498:     current = path.dirname(current);\n499:     stat = statOrNull(current);\n500:   }\n501:   if (!stat) return null;\n502:   const prefix = `${stat.dev}:${stat.ino}`;\n503:   if (rest.length === 0) return prefix;\n504:   const tail = rest.join('/');\n505:   return `${prefix}\\0${volumeFoldsCase() ? tail.toLowerCase() : tail}`;\n506: }\n507: \n508: /**\n509:  * Builds and checks the plan. Returns { entries, newSubtracks } with each entry\n510:  * marked pending or done, or pushes refusals.\n511:  */\n512: function preflight(rawEntries, refusals) {\n513:   const entries = [];\n514:   const ledger = readLedger();\n515:   const seen = new Set();\n516:   for (const raw of rawEntries) {\n517:     const from = normalizeId(raw.rawFrom, 'from', refusals);\n518:     const to = normalizeId(raw.rawTo, 'to', refusals);\n519:     if (from === null || to === null) continue;\n520:     const key = `${from}\\0${to}`;\n521:     if (seen.has(key) || from === to) continue;\n522:     seen.add(key);\n523:     entries.push({ from, to });\n524:   }\n525: \n526:   for (const entry of entries) {\n527:     if (!confine(entry.from, 'from', refusals) || !confine(entry.to, 'to', refusals)) continue;\n528:     for (const [label, id] of [['from', entry.from], ['to', entry.to]]) {\n529:       if (!PACKET_NAME.test(baseName(id))) refusals.push(`${label} specs/${id}: \"${baseName(id)}\" is not NNN-slug`);\n530:     }\n531:     const fromThere = isDir(abs(entry.from));\n532:     const toThere = lstat(abs(entry.to)) !== null;\n533:     if (fromThere && !toThere) entry.state = 'pending';\n534:     else if (!fromThere && toThere) {\n535:       if (recordedMove(entry, ledger)) entry.state = 'done';\n536:       else refusals.push(`from specs/${entry.from}: does not exist, and neither the relocation record nor git shows a move to specs/${entry.to}; if this map moved the folder earlier, move specs/${entry.to} back to specs/${entry.from} and rerun the map`);\n537:     } else if (fromThere && toThere) refusals.push(`to specs/${entry.to}: already exists (collision with the move from specs/${entry.from})`);\n538:     else refusals.push(`from specs/${entry.from}: does not exist, and neither does specs/${entry.to}`);\n539:   }\n540: \n541:   const froms = new Map(entries.map((entry) => [entry.from, entry]));\n542:   const sources = new Map();\n543:   const tos = new Map();\n544:   for (const entry of entries) {\n545:     const source = folderIdentity(entry.from);\n546:     const target = folderIdentity(entry.to);\n547:     if (target !== null) {\n548:       if (tos.has(target)) {\n549:         const prior = tos.get(target);\n550:         refusals.push(`to specs/${entry.to}: named by two entries (specs/${prior.from} -> specs/${prior.to} and specs/${entry.from} -> specs/${entry.to})`);\n551:       }\n552:       tos.set(target, entry);\n553:     }\n554:     if (source !== null) {\n555:       if (sources.has(source)) {\n556:         const prior = sources.get(source);\n557:         refusals.push(`from specs/${entry.from}: named by two entries (specs/${prior.from} -> specs/${prior.to} and specs/${entry.from} -> specs/${entry.to})`);\n558:       }\n559:       sources.set(source, entry);\n\n(Showing lines 460-559 of 1826. Use offset=560 to continue.)\n</content>"}
