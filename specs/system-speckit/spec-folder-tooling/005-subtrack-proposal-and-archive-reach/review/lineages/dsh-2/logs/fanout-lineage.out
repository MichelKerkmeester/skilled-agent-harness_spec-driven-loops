ing is the completion mark for the close. A packet's own\n1651:    markLateStep(plan.entries, 'sweep');\n1653:    for (const line of tail(sweep.stdout, 6)) out(`    ${line}`);\n1691:  // A sub-track beside flat packets is a mixed track, which the sweep and the\n1710:    out(`  specs/${id} is already a declared sub-track; nothing to do`);\n1735:  for (const tool of [TOOLS.repair, TOOLS.refresh, TOOLS.sweep, TOOLS.validate]) {\n1747:    out(`${SCRIPT}: no moves to make; nothing to do`);\n1754:    out(`${SCRIPT}: every entry already names its own place; nothing to do`);\n1798:    out(`${SCRIPT}: nothing to do`);\n"}
