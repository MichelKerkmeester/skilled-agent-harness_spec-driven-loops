elocate.vitest.ts:181:    parent_id: id.split('/').slice(0, -1).join('/'),\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:229:      .split('\\n')\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:245:    parent_id: id.split('/')[0],\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:274:describe('relocate move and renumber', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:275:  it('moves a packet into a sub-track and records the new path in both generated files', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:291:  it('renumbers a packet into a free number and renames the folder', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:308:  it('renumbers a live packet past a number the archive still holds', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:327:describe('relocate phase renumber names', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:328:  it('rewrites a renumbered phase bare name in its parent documents and siblings', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:354:  it('leaves a second phase parent that holds the same child name untouched', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:374:describe('relocate re-parent', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:375:  it('moves a flat track into a declared sub-track and lists the packets there', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:393:  it('removes a re-parented phase from its old parent and adds it to the new one', () => {\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts:419:    expect(newGoal.split('\\n').filter((line) => line.includes('002-gamma'))).toHaveLength(1);\n.skilled/skills/system-spec-kit/runtime/cli/tests/relocate.vitest.ts: