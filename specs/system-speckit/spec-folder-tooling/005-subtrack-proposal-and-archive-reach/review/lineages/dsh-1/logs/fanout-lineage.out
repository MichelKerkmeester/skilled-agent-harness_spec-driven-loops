NT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\nnode .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory \"$ART\" --event-json \"$EVENT_FILE\"; STATUS=$?; rm -f \"$EVENT_FILE\"; echo \"GATEWAY_EXIT=$STATUS\"; exit $STATUS","description":"Open review run through append gateway"}}
