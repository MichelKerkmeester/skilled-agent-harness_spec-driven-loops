{"type":"tool_result","callId":"chatcmpl-tool-8cb14b7c016184a5","status":"completed","result":"691:    ? getNestedField(record, 'findingsSummary')\n768:    const details = Array.isArray(record.findingDetails) ? record.findingDetails : [];\n860:  const details = Array.isArray(record.findingDetails) ? record.findingDetails : [];\n1026:  // An iteration that recorded delta finding rows or findingDetails already has its\n1045:      && Array.isArray(record.findingDetails) && record.findingDetails.length > 0) {\n1047:      // The summary fallback reads findingDetails only for a run with no delta rows.\n1049:        for (const detail of record.findingDetails) {\n1542:    if (record.reviewDepthSchemaVersion !== 2) {\n1563:    const ledgerRows = Array.isArray(record.searchLedger) ? record.searchLedger : [];\n1662:      if (record.findingsSummary !== undefined) {\n1663:        const value = record.findingsSummary;\n1666:          warnings.push({ index, rule: 'findingsSummary-severity-keys', detail: 'findingsSummary must contain P0, P1, P2 keys' });\n1682:      if (record.findingDetails !== undefined && !Array.isArray(record.findingDetails)) {\n1683:        warnings.push({ index, rule: 'findingDetails-array', detail: 'findingDetails must be an array' });\n1699:  const searchLedgerState = buildSearchLedgerState(iterationRecords);\n1748:    candidateCoverage: searchLedgerState.candidateCoverage,\n1749:    searchDebt: searchLedgerState.searchDebt,\n1750:    ruledOutCandidates: searchLedgerState.ruledOutCandidates,\n1751:    cleanSearchProof: searchLedgerState.cleanSearchProof,\n1752:    searchCoverage: searchLedgerState.searchCoverage,\n1869:    + 'Pass createMissing:true (or the reducer CLI flag --create-missing-anchors) to bootstrap.',\n2043:      const summary = record.findingsSummary || {};\n2257: * @param {string} [options.artifactDir] - Explicit review artifact directory override\n2266:  const reviewDir = options.artifactDir\n2267:    ? path.resolve(options.artifactDir)\n2268:    : resolveArtifactRoot(resolvedSpecFolder, 'review').artifactDir;\n2422:  const valueFlags = new Set(['artifactDir']);\n2425:  const cliArgs = process.argv.slice(2);\n2453:      'Usage: node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n2465:      artifactDir: parsedArgs.artifactDir,\n--- state format iteration ---\n38:| `deep-review-config.json` | JSON | Immutable after init, except the terminal `status: complete` flip |\n100:  \"status\": \"initialized\",\n149:| status | string | `\"initialized\"` | `initialized`, `running`, `converged`, `stuck`, `complete`, `error` |\n158:| immutable | Cannot be modified after creation (config: the terminal `status: complete` flip is the one permitted write) |\n199:| review-dimensions | Each iteration | Unchecked dimensions drive next focus |\n206:| next-focus | Each iteration | Recommended direction for next iteration |\n208:| cross-reference-status | Each iteration | Core vs overlay protocol status |\n219:| cross-reference-status | _(none, review-specific)_ |\n223:Sections unchanged from research: topic, what-worked, what-failed, exhausted-approaches, ruled-out-directions, next-focus, known-context.\n231:5. Move exhausted approaches. Update cross-reference-status and files-under-review\n232:6. Set next-focus based on remaining dimensions and open findings\n278:| `blockedStopHistory` | array | One entry per `blocked_stop` JSONL event: `{run, blockedBy, gateResults, recoveryStrategy, timestamp}`. Rendered in the dashboard `BLOCKED STOPS` section and can drive the strategy `next-focus` anchor when blocked-stop is the most recent loop event. |\n295:- **Strategy next-focus override**: When the latest `blocked_stop` event timestamp is newer than the latest iteration timestamp, the reducer rewrites the strategy `next-focus` anchor to surface the blocking gates and recovery hint so operators see the blocker before choosing the next iteration direction.\n374:**Active Finding Registry** lists each active finding with findingId, severity, dimension, title, file:line evidence, first/last seen iteration, and status.\n404:| Progress Table | JSONL | Run, status, focus, dimensions, ratio, duration |\n405:| Coverage | Strategy + JSONL | Dimension completion, file coverage, protocol status |\n474:Each finding is tracked with a unique identifier enabling deduplication, severity transitions, and status lifecycle.\n483:  \"status\": \"active\",\n502:| status | `\"active\"` / `\"resolved\"` / `\"deferred\"` / `\"disproved\"` | Current status |\n508:| transitions | array | Severity and status change history |\n"}
