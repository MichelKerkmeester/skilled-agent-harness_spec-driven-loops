{"type":"tool_result","callId":"chatcmpl-tool-b5701a2b6fc5f387","status":"completed","result":"=== archive help mixed/status lines ===\n100:log_warning() { echo -e \"${YELLOW}WARNING:${NC} $1\"; }\n292:        log_warning \"${track}/graph-metadata.json was not refreshed: $refresh_script is missing. Restore it, then run refresh-track-roots.mjs --track ${track} --apply.\"\n296:        log_warning \"${track}/graph-metadata.json was not refreshed. Rerun refresh-track-roots.mjs --track ${track} --apply.\"\n323:        log_warning \"Recorded paths under $destination were not re-derived: $repair_script is missing. Restore it, then run repair-derived.cjs --roots $destination --apply.\"\n327:        log_warning \"Recorded paths under $destination may still name the old folder. Rerun repair-derived.cjs --roots $destination --apply and read its report.\"\n342:        log_warning \"descriptions.json was not refreshed: $discovery_module is missing. Restore it, then run ensureDescriptionCache.\"\n346:        log_warning \"descriptions.json was not refreshed: node is not on PATH, so $discovery_module cannot run. Restore node, then run ensureDescriptionCache.\"\n354:        log_warning \"descriptions.json may still list the old folder. Rerun ensureDescriptionCache on $specs_root.\"\n363:refuse_mixed_track_restore() {\n374:    # become mixed, so the preflight has no mixed-track verdict to give.\n381:    # output. Only the mixed-track line below decides.\n438:        log_success \"Restored: $archived -> $specs_root/$to_id\"\n439:        log_warning \"Restored packet $specs_root/$to_id failed its own validation; the move is complete, but the packet still needs attention. Read the close validate line above.\"\n440:        exit 0\n446:    log_success \"Restored: $archived -> $specs_root/$to_id\"\n457:        log_warning \"Completeness script not found: $COMPLETENESS_SCRIPT\"\n539:            log_warning \"Spec is only ${completeness}% complete (minimum: ${MIN_COMPLETENESS}%)\"\n544:                exit 0\n663:        exit 0\n743:    # Both restore paths move the folder from here on, so the mixed-track\n745:    refuse_mixed_track_restore \"$resolved_archived\" \"$destination\" \"$specs_root\"\n766:    log_success \"Restored: $resolved_archived -> $destination\"\n788:            --help|-h) show_help; exit 0 ;;\n=== archive test mixed block ===\n   641\tdescribe('archive.sh restore preflight', () => {\n   642\t  // A restore reads the relocation preflight for the same move and refuses only\n   643\t  // its mixed-track verdict. The packet stays in the track archive, so the\n   644\t  // sweep that checks the track layout still passes.\n   645\t  it('refuses a restore that would leave a flat packet beside sub-tracks', { timeout: 120_000 }, () => {\n   646\t    installRestoreTools();\n   647\t    buildSubtrackTree(repo, { flat: false });\n   648\t    packet('demo/z_archive/009-old');\n   649\t\n   650\t    const result = archive(['--restore', 'specs/demo/z_archive/009-old']);\n   651\t\n   652\t    expect(result.status, result.stdout + result.stderr).toBe(1);\n   653\t    expect(result.stderr).toContain('track specs/demo');\n   654\t    expect(result.stderr).toContain('relocate.mjs');\n   655\t    expect(result.stderr).toContain('--from demo/z_archive/009-old');\n   656\t    expect(result.stderr).toContain('--to demo/sub/009-old --apply');\n   657\t    expect(fs.existsSync(path.join(specs, 'demo', 'z_archive', '009-old', 'spec.md'))).toBe(true);\n   658\t    expect(fs.existsSync(path.join(specs, 'demo', '009-old'))).toBe(false);\n   659\t\n   660\t    const sweep = spawnSync('node', [path.join(CLI_DIR, 'spec', 'sweep-track-roots.mjs'), '--specs', specs], { cwd: repo, encoding: 'utf8' });\n   661\t    expect(sweep.status, sweep.stdout + sweep.stderr).toBe(0);\n   662\t  });\n   663\t\n   664\t  // The mixed-track line is the only preflight verdict a restore reads. A flat\n   665\t  // track has no sub-track for the packet to join, so its restore proceeds.\n   666\t  it('still restores into a flat track with no sub-tracks', { timeout: 120_000 }, () => {\n   667\t    installRestoreTools();\n   668\t    trackRoot('flat', ['flat/001-live']);\n   669\t    packet('flat/z_archive/002-old');\n   670\t\n   671\t    const result = archive(['--restore', 'specs/flat/z_archive/002-old']);\n   672\t\n   673\t    expect(result.status, result.stdout + result.stderr).toBe(0);\n   674\t    expect(fs.existsSync(path.join(specs, 'flat', '002-old', 'spec.md'))).toBe(true);\n   675\t    expect(fs.existsSync(path.join(specs, 'flat', 'z_archive', '002-old'))).toBe(false);\n   676\t  });\n   677\t\n   678\t  // An archive leaves the tree dirty, so the preflight for the restore behind it\n   679\t  // can refuse on the uncommitted move. That verdict is not the mixed-track one\n   680\t  // and must not block the restore.\n   681\t  it('restores a packet archived with no commit in between', { timeout: 120_000 }, () => {\n   682\t    installRestoreTools();\n   683\t    trackRoot('flat', ['flat/001-live', 'flat/002-old']);\n   684\t    commitFixture();\n   685\t\n   686\t    const archived = archive(['--force', 'specs/flat/002-old']);\n   687\t    expect(archived.status, archived.stdout + archived.stderr).toBe(0);\n   688\t    const result = archive(['--restore', 'specs/flat/z_archive/002-old']);\n   689\t\n   690\t    expect(result.status, result.stdout + result.stderr).toBe(0);\n   691\t    expect(fs.existsSync(path.join(specs, 'flat', '002-old', 'spec.md'))).toBe(true);\n   692\t    expect(fs.existsSync(path.join(specs, 'flat', 'z_archive', '002-old'))).toBe(false);\n   693\t  });\n   694\t});\n   695\t\n"}
