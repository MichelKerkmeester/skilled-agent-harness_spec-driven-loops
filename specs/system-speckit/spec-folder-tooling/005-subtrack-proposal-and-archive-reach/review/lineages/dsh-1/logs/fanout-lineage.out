{"type":"tool_result","callId":"chatcmpl-tool-9b5670bf34c6fa87","status":"completed","result":"=== archive/create ===\n6:# Archive completed spec folders into the z_archive/ beside them: specs/z_archive/\n7:# for a packet at the specs root, a track's or declared sub-track's own z_archive/\n8:# for its packets, and a parent's own z_archive/ for a phase. Restore returns them\n10:# Usage: archive-spec.sh <spec-folder> | --list | --restore <folder>\n58:    archive-spec.sh --restore <archived-folder>\n62:    --restore, -r       Restore an archived spec folder\n71:    archive-spec.sh specs/my-track/012-feature-name/003-phase-name/\n73:    archive-spec.sh --restore specs/z_archive/051-feature-name/\n74:    archive-spec.sh --restore specs/my-track/z_archive/012-feature-name/\n75:    archive-spec.sh --restore specs/my-track/012-feature-name/z_archive/003-phase-name/\n80:    - A spec is moved into the z_archive/ beside it: specs/z_archive/ at the\n81:      specs root, specs/<track>/z_archive/ in a track, a declared sub-track's\n82:      own z_archive/ for its packets, <parent>/z_archive/ for a phase\n83:    - Restore returns a spec to the folder its z_archive/ belongs to\n84:    - A restore whose number a live packet already holds lands on the next free\n86:    - A z_archive/ that is a symlink is refused on archive and on restore\n87:    - An archive or restore argument that passes through a symlink is refused,\n89:    - An archive or restore path with a . or .. segment is refused, since a\n90:      segment can reach a linked z_archive/ that the literal path does not show\n93:    - A phase parent's graph-metadata.json is left as it is: its writer drops\n104:# path through a linked z_archive while the literal parent looks like a plain folder.\n110:            exit 1\n161:    exit 1\n186:        exit 1\n212:  if (description.level === \"sub-track\") process.exit(0);\n214:process.exit(1);\n220:# under a declared sub-track. A phase nested in a packet belongs to no track\n242:# directly under it, a declared sub-track of that track, or a packet or phase\n254:    [[ \"$first\" != \"z_archive\" && \"$first\" != .* ]] || return 1\n279:# sub-track without one gets it from the refresh, as create.sh does, as long as\n335:# none: an archive move never creates it.\n352:if (ensureDescriptionCache([process.argv[2]]) === null) process.exit(1);\n358:# A restore is refused when the relocation preflight for the same move reports\n362:# answer stay with the restore's own checks.\n363:refuse_mixed_track_restore() {\n374:    # become mixed, so the preflight has no mixed-track verdict to give.\n379:    # set -e would end the script on every non-zero preflight exit, including\n381:    # output. Only the mixed-track line below decides.\n395:    exit 1\n399:# archived, so the restored packet cannot collide with either. relocate.mjs then\n401:restore_on_next_number() {\n429:        exit 1\n440:        exit 0\n444:        exit 1\n474:# The archive beside a packet home. A symlink is refused before anything is created\n511:        exit 1\n516:        exit 1\n522:        exit 1\n529:    if [[ \"/${resolved_spec#\"$specs_root\"/}/\" == */z_archive/* ]]; then\n531:        exit 1\n544:                exit 0\n555:    # The archive beside the folder: the root archive, a track's own or a phase\n560:        log_error \"Not a packet, track packet or phase: $resolved_spec\"\n561:        exit 1\n564:    archive_root=\"$(resolve_archive_root \"$parent/z_archive\" \"$specs_root\")\" || exit 1\n568:        exit 1\n573:        exit 1\n587:        exit 1\n594:        exit 1\n605:    # A phase parent's children_ids is not rewritten here. Its writer only adds\n607:    # someone runs it. A restore then finds the phase still listed.\n609:        log_info \"Left specs/${parent#\"$specs_root\"/}/graph-metadata.json as it is: a phase leaves children_ids only through a reviewed prune, backfill-graph-metadata.js specs/${parent#\"$specs_root\"/} --prune-report, then --prune --prune-confirm <hash>.\"\n619:    if [[ -d \"$dir/z_archive\" && ! -L \"$dir/z_archive\" ]]; then\n620:        printf '%s\\n' \"$dir/z_archive\"\n629:# Every archive a folder can be restored from, as paths relative to the project\n639:        if [[ -L \"$track\" || \"$name\" =~ ^[0-9]{3} || \"$name\" == \"z_archive\" ]]; then\n663:        exit 0\n676:    echo \"To restore: archive-spec.sh --restore <path above>\"\n679:restore_spec() {\n691:        exit 1\n696:        exit 1\n701:        exit 1\n708:    if [[ \"$(basename \"$archive_dir\")\" != \"z_archive\" ]] || ! is_packet_home \"$(dirname \"$archive_dir\")\" \"$specs_root\"; then\n710:        log_info \"A restorable folder sits directly in the z_archive/ of the specs root, a track, a packet or a phase\"\n711:        exit 1\n729:        exit 1\n740:        exit 1\n743:    # Both restore paths move the folder from here on, so the mixed-track\n745:    refuse_mixed_track_restore \"$resolved_archived\" \"$destination\" \"$specs_root\"\n748:    # under another name already holds the restored packet's number, the packet\n760:        restore_on_next_number \"$resolved_archived\" \"$home\" \"$archive_dir\" \"$basename\" \"$specs_root\" \"$number_holder\"\n786:            --restore|-r) action=\"restore\"; shift; target=\"${1:-}\"; shift || true ;;\n788:            --help|-h) show_help; exit 0 ;;\n792:                exit 1\n806:        restore)\n808:                log_error \"No folder specified for restore\"\n810:                exit 1\n813:            restore_spec \"$target\"\n819:                exit 1\n827:            exit 1\n=== create ===\n41:# regardless, which quietly decided more than a number: the tasks template gates\n43:# without one and the coverage rule had no traceability source to read. In phase\n44:# mode DOC_LEVEL carries the parent's own marker rather than a level, so that\n47:    # Resolve the level a phase child should be scaffolded at.\n61:TRACK=\"\"           # Optional track segment: places the folder under specs/<track>/ with per-track numbering\n66:PHASE_MODE=false        # Enable phase decomposition mode\n67:PHASE_COUNT=3           # Number of child phases to create\n69:PHASE_NAMES=\"\"          # Comma-separated phase names (optional)\n70:PHASE_PARENT=\"\"         # Existing parent spec folder path (phase append mode)\n94:            next_arg=\"${!i}\"\n95:            if [[ \"$next_arg\" == --* ]]; then\n99:            if [[ ! \"$next_arg\" =~ ^(1|2|3|3\\+|phase-parent|review|research)$ ]]; then\n100:                echo 'Error: --level must be 1, 2, 3, 3+, phase-parent, review or research' >&2\n103:            if [[ \"$next_arg\" == \"phase-parent\" ]]; then\n104:                DOC_LEVEL=\"phase\"\n106:                DOC_LEVEL=\"$next_arg\"\n115:            next_arg=\"${!i}\"\n116:            if [[ \"$next_arg\" == --* ]]; then\n120:            EXPLICIT_PATH=\"$next_arg\"\n129:            next_arg=\"${!i}\"\n130:            if [[ \"$next_arg\" == --* ]]; then\n134:            EXPLICIT_NAME=\"$next_arg\"\n148:            next_arg=\"${!i}\"\n149:            if [[ \"$next_arg\" == --* ]]; then\n153:            TRACK=\"$next_arg\"\n168:            next_arg=\"${!i}\"\n169:            if [[ \"$next_arg\" == --* ]]; then\n173:            SUBFOLDER_BASE=\"$next_arg\"\n181:            next_arg=\"${!i}\"\n182:            if [[ \"$next_arg\" == --* ]]; then\n186:            SUBFOLDER_TOPIC=\"$next_arg\"\n188:        --phase)\n191:        --phases)\n193:                echo 'Error: --phases requires a positive integer' >&2\n197:            next_arg=\"${!i}\"\n198:            if [[ \"$next_arg\" == --* ]]; then\n199:                echo 'Error: --phases requires a positive integer' >&2\n202:            if ! [[ \"$next_arg\" =~ ^[1-9][0-9]*$ ]]; then\n203:                echo 'Error: --phases must be a positive integer (got: '\"$next_arg\"')' >&2\n206:            PHASE_COUNT=\"$next_arg\"\n209:        --phase-names)\n211:                echo 'Error: --phase-names requires a comma-separated list' >&2\n215:            next_arg=\"${!i}\"\n216:            if [[ \"$next_arg\" == --* ]]; then\n217:                echo 'Error: --phase-names requires a comma-separated list' >&2\n220:            PHASE_NAMES=\"$next_arg\"\n222:        --parent)\n224:                echo 'Error: --parent requires an existing spec folder path' >&2\n228:            next_arg=\"${!i}\"\n229:            if [[ \"$next_arg\" == --* ]]; then\n230:                echo 'Error: --parent requires an existing spec folder path' >&2\n233:            PHASE_PARENT=\"$next_arg\"\n235:        --phase-par","truncated":true}
