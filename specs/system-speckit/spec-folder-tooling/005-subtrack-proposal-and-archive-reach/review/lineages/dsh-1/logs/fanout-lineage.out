D=false # Force legacy strict-single-writer (no IPC bridge)\n102:# SPECKIT_MAX_SECONDARY_CLIENTS=64      # Max concurrent secondary stdio clients on the IPC socket\n103:# SPECKIT_LAUNCHER_IDLE_TIMEOUT_MIN=30  # Idle self-exit timeout (min); 0 disables the monitor\n104:# SPECKIT_IPC_SOCKET_DIR=               # Override daemon IPC socket dir (REQUIRED short path on macOS)\n105:# SPECKIT_PROXY_COLD_START_ATTEMPTS=30  # Connect attempts while a cold launcher backend comes up\n106:# SPECKIT_PS_PROBE_TIMEOUT_MS=2000      # Timeout for the process-table probe that checks daemons\n109:# SPECKIT_LEASE_PROBE_RETRIES=1         # Consecutive failed liveness probes before reaping the lease owner\n110:# SPECKIT_LEASE_PROBE_RETRY_TIMEOUT_MS=1500 # Per-attempt timeout for each lease retry probe\n111:# SPECKIT_LEASE_PROBE_RETRY_BACKOFF_MS=250  # Backoff between lease liveness-probe attempts\n113:# SPECKIT_STOP_HOOK_ORPHAN_SWEEP=off    # Stop-hook orphan sweep: off / dry-run / live\n116:# SPECKIT_FRONTMATTER_ALLOWLIST=        # Override path to the frontmatter grandfather allowlist JSON\n117:# SPECKIT_VERBOSE_RESOLVER=false        # Log the cause when the level-contract resolver falls back\n118:# SPECKIT_PYTHON_BIN=                   # Python interpreter for spec-kit scripts (auto)\n119:# SPEC_KIT_PLUGIN_NODE_BINARY=          # Node binary for the spec-kit plugin (auto)\n122:# SPECKIT_IPC_SOCKET_SCOPE=             # IPC socket scope selector (internal default)\n123:# SPECKIT_BRIDGE_RESPAWN_DISABLED=      # Disable launcher IPC-bridge respawn (set 1)\n127:# SPECKIT_CONTEXT_SERVER_MAX_RSS_MB=    # RSS ceiling (MB) for the default launcher watchdog (unset=off)\n128:# SPECKIT_LAUNCHER_RSS_SELF_EXIT=       # Recycle on an RSS breach (set 1, with a MAX_RSS_MB value)\n129:# SPECKIT_LAUNCHER_RSS_WATCHDOG_INTERVAL_MS=15000 # How often the watchdog samples RSS\n130:# SPECKIT_LAUNCHER_RSS_CONSECUTIVE_BREACHES=3 # Breaching samples in a row before a recycle\n131:# SPECKIT_LAUNCHER_RSS_GRACE_MS=7000    # Wait before a recycled process is force-killed\n132:# SPECKIT_LAUNCHER_CRASH_LOOP_MAX_DEATHS=3 # Deaths within the window before the launcher gives up\n133:# SPECKIT_LAUNCHER_CRASH_LOOP_WINDOW_MS=60000 # Window the crash-loop guard counts deaths in\n134:# SPECKIT_LAUNCHER_CRASH_LOOP_INITIAL_BACKOFF_MS=250 # First restart backoff after a death\n135:# SPECKIT_LAUNCHER_CRASH_LOOP_MAX","truncated":true}
