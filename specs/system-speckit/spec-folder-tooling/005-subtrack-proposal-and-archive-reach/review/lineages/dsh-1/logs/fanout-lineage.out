dMove(entry, ledger) {\n1302:  if (ledgerHas(ledger, entry)) return true;\n1307:/** The late steps not yet marked as passed on every entry's ledger batch. */\n1308:function pendingLateSteps(ledger, entries) {\n1310:    const batch = batchOf(ledger, entry);\n1315:/** Records a late step that passed on the ledger batch holding each entry. */\n1317:  const ledger = readLedger();\n1320:    const batch = batchOf(ledger, entry);\n1328:  if (changed) writeAtomic(LEDGER, `${JSON.stringify(ledger, null, 2)}\\n`);\n1363:  const transform = buildTransform(entries, bareNameEdits(entries), phaseRowEdits(entries));\n1461:  const ledger = readLedger();\n1462:  const unrecorded = entries.filter((entry) => !ledgerHas(ledger, entry));\n1463:  const lateSteps = pendingLateSteps(ledger, entries);\n1490:    out(`  identity ${where}: ${item.reasons.join(', ')} -> migrate-generated-json --only, repair-derived --apply`);\n1498:  if (plan.unrecorded.length) out(`  ledger   ${rel(LEDGER)}: record ${plan.unrecorded.length} move(s)`);\n1500:    out(`  then     cite-drift-scan --rebuild-redirects, generate-trigger-index, sweep-track-roots, validate.sh --strict on ${plan.entries.length} moved packet(s)`);\n1503:  out(`moves=${plan.pending.length} moved=${plan.done.length} rewrites=${plan.rewrites.length} identity=${plan.identity.length} roots=${plan.trackWork.length} ledger=${plan.unrecorded.length}`);\n1594:  const migrateFolders = [];\n1597:    if (item.folder) migrateFolders.push(item.folder);\n1598:    else migrateFolders.push(...specFoldersUnder(abs(item.entry.to)));\n1602:  if (migrateFolders.length) {\n1603:    const args = ['--import', TOOLS.tsxLoader, TOOLS.migrate, ...[...new Set(migrateFolders)].flatMap((folder) => ['--only', folder])];\n1604:    if (!childStep('description identity (migrate-generated-json --only)', 'node', args)) return false;\n1620:  if (plan.unrecorded.length && !step('ledger', () => {\n1621:    const ledger = readLedger();\n1623:    ledger.batches.push({\n1629:   