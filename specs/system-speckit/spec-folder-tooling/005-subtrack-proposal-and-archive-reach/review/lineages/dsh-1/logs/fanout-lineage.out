{"type":"tool_result","callId":"chatcmpl-tool-9aec7340064e65ca","status":"completed","result":"=== relocate bare-name/pre-archive ===\n   675\t * The files where a renumber inside one phase parent may leave a child's bare\n   676\t * folder name: the parent's own map, handoff and goal documents, each child's\n   677\t * neighbour rows, and the moved child's own location row. A name anywhere else\n   678\t * is too common to touch.\n   679\t */\n   680\tfunction bareNameEdits(entries) {\n   681\t  const names = new Map();\n   682\t  const summaryRows = new Map();\n   683\t  const addName = (file, from, to) => {\n   684\t    if (!names.has(file)) names.set(file, new Map());\n   685\t    names.get(file).set(from, to);\n   686\t  };\n   687\t  for (const entry of entries) {\n   688\t    const fromParent = parentId(entry.from);\n   689\t    const toParent = parentId(entry.to);\n   690\t    // A re-parent or a move at the specs root renames no sibling in place.\n   691\t    if (fromParent === '' || fromParent !== toParent) continue;\n   692\t    if (!PACKET_NAME.test(baseName(fromParent)) || !fs.existsSync(path.join(abs(fromParent), 'spec.md'))) continue;\n   693\t    const from = baseName(entry.from);\n   694\t    const to = baseName(entry.to);\n   695\t    if (from === to) continue;\n   696\t    const parentDir = abs(fromParent);\n   697\t    addName(path.join(parentDir, 'spec.md'), from, to);\n   698\t    addName(path.join(parentDir, 'goal.md'), from, to);\n   699\t    for (const child of numberedDirs(parentDir)) addName(path.join(parentDir, child, 'spec.md'), from, to);\n   700\t    // Planning reads the folder where it still sits; a finished move is read\n   701\t    // where it landed.\n   702\t    const summary = entry.state === 'done' ? abs(entry.to) : abs(entry.from);\n   703\t    summaryRows.set(path.join(summary, 'implementation-summary.md'), { from, to });\n   704\t  }\n   705\t  return { names, summaryRows };\n   706\t}\n   707\t\n   708\t/** The cells of one markdown table row, or null for a line outside a table. */\n   709\tfunction tableCells(line) {\n   710\t  const trimmed = line.trim();\n   711\t  if (!trimmed.startsWith('|')) return null;\n   712\t  const body = trimmed.slice(1, trimmed.endsWith('|') ? -1 : undefined);\n   713\t  return body.split('|').map((cell) => cell.trim());\n   714\t}\n   715\t\n   716\t/** The table a header row opens, named by the document that owns it. */\n   717\tfunction tableKind(cells) {\n   718\t  if (!cells || cells.length < 2) return null;\n   719\t  if (cells[0] === 'Phase' && cells[1] === 'Folder') return 'map';\n   720\t  if (cells[0] === 'From' && cells[1] === 'To') return 'handoff';\n   721\t  if (cells[0] === 'Phase' && /goal/i.test(cells.slice(1).join(' '))) return 'binding';\n   722\t  return null;\n   723\t}\n   724\t\n   725\t/** Every markdown table a document holds, as a header line and an exclusive end. */\n   726\tfunction markdownTables(lines) {\n   727\t  const tables = [];\n   728\t  for (let index = 0; index < lines.length; index += 1) {\n   729\t    const kind = tableKind(tableCells(lines[index]));\n   730\t    if (!kind) continue;\n   731\t    let end = index + 1;\n   732\t    while (end < lines.length && tableCells(lines[end])) end += 1;\n   733\t    tables.push({ kind, start: index, end });\n   734\t    index = end - 1;\n   735\t  }\n   736\t  return tables;\n   737\t}\n   738\t\n   739\t/** A cell that names a folder, without decoration or a trailing slash. */\n   740\tfunction tableRowName(cell) {\n   741\t  return String(cell || '').replace(/`/g, '').trim().replace(/\\/+$/, '');\n   742\t}\n   743\t\n   744\t/** A bare folder name replaced only where it stands as a whole name. */\n   745\tfunction replaceBareName(text, from, to) {\n   746\t  return text.replace(bareNamePattern(new Map([[from, to]])), to);\n   747\t}\n   748\t\n   749\t/**\n   750\t * The rows a re-parent must move between the old and new parent. The old\n   751\t * parent's map, handoff and binding rows name a folder it no longer holds, and\n   752\t * the new parent needs its own rows. Each row this plan changes is reported,\n   753\t * so an operator can see the document edit beside the folder move.\n   754\t */\n   755\tfunction phaseRowEdits(entries) {\n   756\t  const files = new Map();\n   757\t  const ensure = (file, label) => {\n   758\t    if (!files.has(file)) files.set(file, { label, ops: [] });\n   759\t    return files.get(file);\n   760\t  };\n  1018\t * an old id wherever it is written in full, then the bare-name pass rewrites a\n  1019\t * child's name in the few documents its phase parent owns. A relative markdown\n  1020\t * link cannot be matched by id, so it is resolved: a link that works now and\n  1021\t * whose target or whose own file moves is recomputed from the new places, and\n  1022\t * a link that is broken now is repaired only when it pointed into a folder that\n  1023\t * already moved.\n  1024\t */\n  1025\tfunction buildTransform(entries, bare = { names: new Map(), summaryRows: new Map() }, phaseRows = new Map()) {\n  1026\t  const idMap = new Map(entries.map((entry) => [entry.from, entry.to]));\n  1027\t  // The archive spelling and the id the packet had before it was archived name\n  1028\t  // the same source, so both map to where the packet lands.\n  1029\t  for (const [alias, to] of preArchiveAliases(entries)) idMap.set(alias, to);\n  1030\t  const pattern = wholeIdPattern(idMap.keys());\n  1031\t  const pending = entries.filter((entry) => entry.state === 'pending');\n  1032\t  const done = entries.filter((entry) => entry.state === 'done');\n  1033\t  const forward = makePathMapper(entries.map((entry) => [abs(entry.from), abs(entry.to)]));\n  1034\t  const forwardPending = makePathMapper(pending.map((entry) => [abs(entry.from), abs(entry.to)]));\n  1035\t  const backDone = makePathMapper(done.map((entry) => [abs(entry.to), abs(entry.from)]));\n  1036\t  const pendingFrom = pending.map((entry) => abs(entry.from));\n  1037\t  const doneTo = done.map((entry) => abs(entry.to));\n  1038\t  const doneFrom = done.map((entry) => abs(entry.from));\n  1039\t  const under = (list, target) => list.some((root) => target === root || target.startsWith(`${root}${path.sep}`));\n  1040\t\n  1041\t  function rewriteLink(file, target) {\n  1042\t    if (/^[a-z][a-z0-9+.-]*:/i.test(target) || target.startsWith('#') || target.startsWith('/') || target.startsWith('<')) return null;\n  1043\t    const cut = target.search(/[#?]/);\n  1044\t    const pathPart = cut < 0 ? target : target.slice(0, cut);\n  1045\t    const suffix = cut < 0 ? '' : target.slice(cut);\n  1046\t    if (pathPart === '' || pathPart === '.' || pathPart === './') return null;\n  1047\t    const fileMoving = under(pendingFrom, file);\n  1048\t    const fileMoved = under(doneTo, file);\n  1049\t    const fileOld = fileMoved ? backDone(file) : file;\n  1050\t    const fileNew = fileMoving ? forwardPending(file) : file;\n  1051\t    const fromOld = path.resolve(path.dirname(fileOld), pathPart);\n  1052\t    const mapped = forward(fromOld);\n  1053\t    if (!fileMoving && !fileMoved && mapped === fromOld) return null;\n  1054\t    if (fileMoving || under(pendingFrom, fromOld)) {\n  1055\t      if (!fs.existsSync(fromOld)) return null;\n  1056\t    } else {\n  1057\t      if (fs.existsSync(path.resolve(path.dirname(file), pathPart))) return null;\n  1058\t      if (!under(doneFrom, fromOld) && !fileMoved) return null;\n  1059\t      if (!fs.existsSync(mapped)) return null;\n  1060\t    }\n=== phase 007 goal ===\n    38\t### Decisions\n    39\t\n    40\tFrozen choices. Changing one is an amendment.\n    41\t\n    42\t| ID | Decision |\n    43\t|----|----------|\n    44\t| D1 | A bare folder name is rewritten only inside the parent folder of a phase whose parent is unchanged, and only where no letter, digit, underscore or hyphen stands before it. It is never matched across `specs/`, and `session_id` values stay as written. |\n    45\t| D2 | A dry run prints every rewrite the apply will make. |\n    46\t| D3 | The pre-archive id is rewritten only when the destination is not under `z_archive/` and no live folder holds it. |\n    47\t| D4 | Every finding is reproduced in a `mktemp` copy before its fix, and no code comment names a spec path, a packet number or a finding id. |\n    48\t| D5 | A re-parented phase's rows are removed from the old parent and added to the new one. The move is never refused over those rows, because re-parenting is a shipped capability. |\n    49\t\n    50\t<!-- /ANCHOR:dire","truncated":true}
