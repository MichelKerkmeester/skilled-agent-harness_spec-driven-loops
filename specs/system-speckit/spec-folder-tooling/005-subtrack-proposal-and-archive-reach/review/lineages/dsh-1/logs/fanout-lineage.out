eRecipe(phrase, roots = DEFAULT_SEARCH_ROOTS) {\n193:    '--glob', '**/z_archive/**/description.json',\n194:    '--glob', '**/z_archive/**/graph-metadata.json',\n205:  path: pathRecipe,\n224:    path: lanePathRecipe(phrase, [...roots], options),\n244: * Reports whether a path has a segment exactly equal to `z_archive`. Both `/`\n248: * @returns {boolean} True when the path sits in an archive directory.\n251:  return candidate.split('/').some((segment) => segment.split(path.sep).includes('z_archive'));\n261: *   archivedPaths?: string[],\n263: *   counts: Array<{ archived?: boolean, count: number, path: string }> | null,\n264: *   exitCode: number,\n268: *   jsonLane?: {\n270: *     exitCode: number,\n272: *     paths: string[],\n278: *   paths: string[] | null,\n300:    exitCode: run.exitCode,\n306:    paths: null,\n321:    const jsonArgv = jsonLaneRecipe(phrase, roots);\n322:    const jsonRun = runRecipe(jsonArgv, { cwd });\n323:    record.jsonLane = {\n324:      command: formatCommand(jsonArgv),\n325:      exitCode: jsonRun.exitCode,\n326:      outcome: jsonRun.outcome,\n327:      paths: jsonRun.stdout.split('\\n').filter((line) => line.length > 0).sort(),\n328:      stderr: jsonRun.stderr,\n331:    if (run.outcome === 'error' || jsonRun.outcome === 'error') {\n334:      const failing = run.outcome === 'error' ? run : jsonRun;\n335:      record.exitCode = failing.exitCode;\n338:    } else if (run.outcome === 'no-match' && jsonRun.outcome === 'match') {\n339:      // A main-run miss in .md files is still a match when an archived packet's\n342:      record.exitCode = EXIT_MATCH;\n355:    // row for a path is already that file's highest-ranked line.\n358:      ? shaped.results.map((result) => ({ ...result, archived: isArchivedPath(result.path) }))\n377:  if (recipe === 'path') {\n378:    // The path recipe stops at one match per file, so it has no match total.\n379:    record.paths = lines.sort().slice(0, keep);\n380:    // `paths` stays a list of plain strings for its readers; the archived subset\n382:    record.archivedPaths = record.paths.filter(isArchivedPath);\n383:    record.hidden = { files: lines.length - record.paths.length, matches: null };\n391:      return { count: Number(line.slice(separator + 1)), path: line.slice(0, separator) };\n393:    .sort((a, b) => b.count - a.count || a.path.localeCompare(b.path));\n397:    ? kept.map((entry) => ({ ...entry, archived: isArchivedPath(entry.path) }))\n411: * @returns {{ includeArchive: boolean, json: boolean, limit: number, phrase: string, recipe: string, root: string | undefined, roots: string[] }} Parsed options.\n417:  let json = false;\n423:    if (arg === '--include-archive') { includeArchive = true; continue; }\n424:    if (arg === '--json') { json = true; continue; }\n456:  const parsed = { json, limit, phrase, recipe, root, roots: roots.length > 0 ? roots : undefined };\n471:    `exit    : ${record.exitCode} (${record.outcome})`,\n479:  const archivedSuffix = (candidate) => (\n480:    record.includeArchive === true && isArchivedPath(candidate) ? '  [archived]' : ''\n491:      lines.push(`  ${result.evidenceField.padEnd(20)} ${result.path}:${result.line}${moreInFile}${archivedSuffix(result.path)}`);\n497:  if (record.paths) {\n498:    lines.push(`paths   : ${record.fileCount}`);\n499:    for (const found of record.paths) lines.push(`  ${found}${archivedSuffix(found)}`);\n503:    lines.push(`counts  : ${record.matchCount} across ${record.fileCount} path(s)`);\n504:    for (const entry of record.counts) lines.push(`  ${String(entry.count).padStart(6)} ${entry.path}${archivedSuffix(entry.path)}`);\n509:  if (record.jsonLane) {\n511:    // every path it matched is printed.\n512:    lines.push(`json    : ${record.jsonLane.paths.length} archived metadata file(s)`);\n513:    for (const found of record.jsonLane.paths) lines.push(`  ${found}  [archived]`);\n521: * @returns {number} Process exit code, mapped from ripgrep's own.\n533:    cwd: args.root ? path.resolve(args.root) : process.cwd(),\n541:    return record.exitCode >= EXIT_ERROR_FLOOR ? record.exitCode : EXIT_ERROR_FLOOR;\n544:  process.stdout.write(args.json ? `${stableStringify(record)}\\n` : formatSummary(record));\n545:  return record.exitCode;\n549:  process.exitCode = main(process.argv.slice(2));\n=== suggest ===\n2:// MODULE: Suggest Subtracks\n4:// A track that grows flat becomes hard to read: unrelated subjects share one\n6:// proposes a regrouping from the words the packets already carry. It is advice,\n7:// not a migration: it prints a mapping and never moves or writes a folder, so a\n10:// Two questions are answered. With no description, a flat track's packets are\n11:// clustered by the words they share, and every cluster gets a proposed name.\n12:// With a description, an already grouped track is scored against each declared\n13:// sub-track, and the best fit is named only when enough of its words appear.\n15:// Words shared by most packets describe the track as a whole, so they are\n17:// merges only on real overlap, and leftover packets join one remainder group\n23://   node .skilled/skills/system-spec-kit/runtime/cli/spec/suggest-subtracks.mjs --track <name> [--specs <dir>] [--threshold <n>] [--describe \"<text>\"]\n26://             2 = a rejected argument, a missing value or a track that is absent.\n35:  trackLayout,\n36:} from '../lib/track-roots.mjs';\n38:const SCRIPT = 'suggest-subtracks';\n41:// A map destination has to be NNN-slug. The relocation preflight refuses any\n42:// other separator, so a proposed map must never carry one.\n45:// The words below say what every packet is rather than what a group is about,\n54:  process.exit(2);\n58:  const parsed = { specs: null, track: null, threshold: DEFAULT_THRESHOLD, describe: null };\n61:    if (arg === '--specs' || arg === '--track' || arg === '--threshold' || arg === '--describe') {\n79:  if (parsed.track === null) {\n80:    fail('--track is required');\n137:// shared track reader. The fallback exists for a track that has no metadata at\n147:    .filter((entry) => entry.isDirectory() && NUMBERED_PACKET.test(entry.name))\n148:    .filter((entry) => fs.existsSync(path.join(directory, entry.name, 'spec.md')))\n149:    .map((entry) => entry.name)\n153:// Every folder already in the track, declared or not. A proposed group may not\n155:// a sub-track declaration.\n165:    .map((entry) => entry.name);\n168:function","truncated":true}
