{"type":"tool_result","callId":"chatcmpl-tool-bbf379e05ac702c9","status":"completed","result":"            - \"{state_paths.strategy}\"\n          legacy_review_state:\n            - \"{spec_folder}/scratch/deep-research-config.json\"\n            - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n            - \"{spec_folder}/scratch/deep-review-strategy.md\"\n            - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n            - \"{spec_folder}/scratch/iteration-*.md\"\n            - \"{spec_folder}/scratch/.deep-research-pause\"\n            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n            - \"{state_paths.legacy_root_report}\"\n          legacy_review_markers:\n            - \"scratch/deep-review-strategy.md exists\"\n            - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n        migrate_only:\n          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n          - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n          - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n          - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n          - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n        on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n        on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n        on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n        outputs:\n          - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n          - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n        command: |\n          mkdir -p {state_paths.iteration_dir}\n          if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n            [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n            [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n            [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n            [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n            find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n            [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n            [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n            echo \"LEGACY_REVIEW_STATE_MOVED\"\n          fi\n          find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Release the lock before any terminal halt branch returns control\"\n          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\"]\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent — safe to invoke when already released\"\n\n      step_classify_session:\n        action: \"Classify the session before writing files\"\n        inspect:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n        classify:\n          fresh: \"None of the three state artifacts exist\"\n          resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n          completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n          invalid-state: \"Any partial, missing, or contradictory combination\"\n        outputs:\n          - session_state: \"fresh | resume | completed-session | invalid-state\"\n          - prior_tail_digest: \"sha256 of the state log bytes when resuming or restarting an existing lineage\"\n        lifecycle_routing:\n          - \"If lineage_mode == restart and session_state is resume or completed-session, execute on_restart before on_resume or on_completed_session.\"\n          - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n        on_resume:\n          before_append: \"Run on_moved_legacy_state first when it applies.\"\n          log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n          append_jsonl: '{\"stem\":\"deep_review.run_resumed\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"sourceSessionId\":\"{session_id}\",\"resumeReason\":\"Auto-resume: state artifacts are complete and consistent; continue the same lineage.\",","truncated":true}
