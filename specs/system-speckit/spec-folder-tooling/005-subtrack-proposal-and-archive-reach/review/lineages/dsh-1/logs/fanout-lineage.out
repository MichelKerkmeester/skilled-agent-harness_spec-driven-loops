{"type":"tool_result","callId":"chatcmpl-tool-bd6b0b053041d865","status":"completed","result":"   250\texport function isArchivedPath(candidate) {\n   251\t  return candidate.split('/').some((segment) => segment.split(path.sep).includes('z_archive'));\n   252\t}\n   253\t\n   254\t/**\n   255\t * Runs one recipe and shapes its output for the recipe's own mode.\n   256\t *\n   257\t * @param {string} recipe One of RECIPES.\n   258\t * @param {string} phrase Literal phrase.\n   259\t * @param {{ cwd?: string, includeArchive?: boolean, limit?: number, roots?: ReadonlyArray<string> }} [options] Execution context.\n   260\t * @returns {{\n   261\t *   archivedPaths?: string[],\n   262\t *   command: string,\n   263\t *   counts: Array<{ archived?: boolean, count: number, path: string }> | null,\n   264\t *   exitCode: number,\n   265\t *   fileCount: number | null,\n   266\t *   hidden: { files: number, matches: number | null } | null,\n   267\t *   includeArchive?: true,\n   268\t *   jsonLane?: {\n   269\t *     command: string,\n   270\t *     exitCode: number,\n   271\t *     outcome: 'match' | 'no-match' | 'error',\n   272\t *     paths: string[],\n   273\t *     stderr: string\n   274\t *   },\n   275\t *   limit: number | null,\n   276\t *   matchCount: number | null,\n   277\t *   outcome: 'match' | 'no-match' | 'error',\n   278\t *   paths: string[] | null,\n   279\t *   recipe: string,\n   280\t *   results: Array<Record<string, unknown>> | null,\n   281\t *   schemaVersion: number,\n   282\t *   stderr: string,\n   283\t *   truncated: boolean,\n   284\t *   unparsedLines: number\n   285\t * }} Execution record.\n   286\t */\n   287\texport function search(recipe, phrase, options = {}) {\n   288\t  const builder = RECIPE_BUILDERS[recipe];\n   289\t  if (!builder) throw new Error(`unknown recipe: ${recipe}`);\n   290\t\n   291\t  const includeArchive = options.includeArchive === true;\n   292\t  const cwd = options.cwd ?? process.cwd();\n   293\t  const roots = options.roots ?? searchRootsFor(cwd);\n   294\t  const argv = builder(phrase, roots, { includeArchive });\n   295\t  const run = runRecipe(argv, { cwd });\n   296\t\n   297\t  const record = {\n   298\t    command: formatCommand(argv),\n   299\t    counts: null,\n   300\t    exitCode: run.exitCode,\n   301\t    fileCount: null,\n   302\t    hidden: null,\n   303\t    limit: null,\n   304\t    matchCount: null,\n   305\t    outcome: run.outcome,\n   306\t    paths: null,\n   307\t    recipe,\n   308\t    results: null,\n   309\t    schemaVersion: SCHEMA_VERSION,\n   310\t    stderr: run.stderr,\n   311\t    truncated: false,\n   312\t    unparsedLines: 0,\n   313\t  };\n   314\t  if (includeArchive) record.includeArchive = true;\n   315\t\n   316\t  // The archive metadata lane cannot ride on the main run: an output mode is\n   317\t  // never combined with another, so it is a second invocation. It is attached\n   318\t  // before any early return, including the main run's error return, because the\n   319\t  // combined status below already folds its fault into the record.\n   320\t  if (includeArchive) {\n   321\t    const jsonArgv = jsonLaneRecipe(phrase, roots);\n   322\t    const jsonRun = runRecipe(jsonArgv, { cwd });\n   323\t    record.jsonLane = {\n   324\t      command: formatCommand(jsonArgv),\n   325\t      exitCode: jsonRun.exitCode,\n   326\t      outcome: jsonRun.outcome,\n   327\t      paths: jsonRun.stdout.split('\\n').filter((line) => line.length > 0).sort(),\n   328\t      stderr: jsonRun.stderr,\n   329\t    };\n   330\t\n   331\t    if (run.outcome === 'error' || jsonRun.outcome === 'error') {\n   332\t      // The main run wins the tie: when both failed, its status and stderr are\n   333\t      // the ones reported.\n   334\t      const failing = run.outcome === 'error' ? run : jsonRun;\n   335\t      record.exitCode = failing.exitCode;\n   336\t      record.outcome = 'error';\n   337\t      record.stderr = failing.stderr;\n   338\t    } else if (run.outcome === 'no-match' && jsonRun.outcome === 'match') {\n   339\t      // A main-run miss in .md files is still a match when an archived packet's\n   340\t      // metadata carries the phrase; the main recipe's own fields stay shaped\n   341\t      // exactly as a miss.\n   342\t      record.exitCode = EXIT_MATCH;\n   343\t      record.outcome = 'match';\n   344\t    }\n   345\t  }\n   346\t\n   347\t  // An execution fault is surfaced with its stderr rather than parsed. Parsing\n   348\t  // the empty stdout of a failed invocation would report a clean miss.\n   349\t  if (run.outcome === 'error') return record;\n   350\t\n   351\t  if (recipe === 'structured') {\n   352\t    const parsed = parseJsonLines(run.stdout);\n   353\t    const ranked = rankMatches(parsed.matches, { cwd, normalizedQuery: normalizeTriggerText(phrase) });\n   354\t    // One row per file is a post-rank filter, not a second ranker: the first\n   355\t    // row for a path is already that file's highest-ranked line.\n   356\t    const shaped = shapeRankedMatches(ranked, { limit: options.limit ?? DEFAULT_LIMIT });\n   357\t    record.results = includeArchive\n   358\t      ? shaped.results.map((result) => ({ ...result, archived: isArchivedPath(result.path) }))\n   359\t      : shaped.results;\n   360\t    record.matchCount = shaped.matchCount;\n   361\t    record.fileCount = shaped.fileCount;\n   362\t    record.hidden = shaped.hidden;\n   363\t    record.limit = shaped.limit;\n   364\t    record.truncated = shaped.hidden.files > 0;\n   365\t    record.unparsedLines = parsed.unparsedLines;\n   366\t    return record;\n   367\t  }\n   368\t\n   369\t  // Ripgrep walks in parallel, so its line order changes between runs. Both\n   370\t  // lists are sorted before the cut so a limit keeps the same files every time.\n   371\t  const lines = run.stdout.split('\\n').filter((line) => line.length > 0);\n   372\t  const limit = options.limit ?? DEFAULT_LIMIT;\n   373\t  const keep = limit === 0 ? lines.length : limit;\n   374\t  record.limit = limit;\n   375\t  record.fileCount = lines.length;\n   376\t\n   377\t  if (recipe === 'path') {\n   378\t    // The path recipe stops at one match per file, so it has no match total.\n   379\t    record.paths = lines.sort().slice(0, keep);\n   380\t    // `paths` stays a list of plain strings for its readers; the archived subset\n   381\t    // is reported beside it so a JSON consumer can label those files.\n   382\t    record.archivedPaths = record.paths.filter(isArchivedPath);\n   383\t    record.hidden = { files: lines.length - record.paths.length, matches: null };\n   384\t    record.truncated = record.hidden.files > 0;\n   385\t    return record;\n   386\t  }\n   387\t\n   388\t  const counts = lines\n   389\t    .map((line) => {\n   390\t      const separator = line.lastIndexOf(':');\n   391\t      return { count: Number(line.slice(separator + 1)), path: line.slice(0, separator) };\n   392\t    })\n   393\t    .sort((a, b) => b.count - a.count || a.path.localeCompare(b.path));\n   394\t  const sum = (entries) => entries.reduce((total, entry) => total + entry.count, 0);\n   395\t  const kept = counts.slice(0, keep);\n   396\t  record.counts = includeArchive\n   397\t    ? kept.map((entry) => ({ ...entry, archived: isArchivedPath(entry.path) }))\n   398\t    : kept;\n   399\t  record.matchCount = sum(counts);\n   400\t  record.hidden = { files: counts.length - record.counts.length, matches: sum(counts.slice(keep)) };\n   401\t  record.truncated = record.hidden.files > 0;\n   402\t  return record;\n   403\t}\n   404\t\n   405\t// ───────────────────────────────────────────────────────────────────\n=== parse flags and main ===\n   406\t// 4. CLI\n   407\t// ───────────────────────────────────────────────────────────────────\n   408\t\n   409\t/**\n   410\t * @param {string[]} argv Arguments after the script name.\n   411\t * @returns {{ includeArchive: boolean, json: boolean, limit: number, phrase: string, recipe: string, root: string | undefined, roots: string[] }} Parsed options.\n   412\t */\n   413\texport function parseArgs(argv) {\n   414\t  const positional = [];\n   415\t  const roots = [];\n   416\t  let includeArchive = false;\n   417\t  let json = false;\n   418\t  let limit = DEFAULT_LIMIT;\n   419\t  let root;\n   420\t\n   421\t  for (let i = 0; i < argv.leng","truncated":true}
