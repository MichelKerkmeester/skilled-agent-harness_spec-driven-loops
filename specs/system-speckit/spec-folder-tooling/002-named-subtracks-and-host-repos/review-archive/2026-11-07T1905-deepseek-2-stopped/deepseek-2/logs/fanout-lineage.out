UT && has_phase_children \"$FOLDER_PATH\"; then\n        RECURSIVE=true\n        ! $JSON_MODE && ! $QUIET_MODE && echo \"Auto-enabled recursive validation: phase child folders detected.\"\n    fi\n    resolve_orchestrator\n\n    local rc=0\n    run_validation || rc=$?\n    exit \"$rc\"\n}\n\nmain \"$@\"\n\n# Exit codes:\n#   0 - Success\n#   1 - User error\n#   2 - Validation error\n#   3 - System error\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/MEGA/Development/Skilled && sed -n '460,540p' .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\"}"},"time":{"start":1794075281976,"end":1794075283021}}}}
