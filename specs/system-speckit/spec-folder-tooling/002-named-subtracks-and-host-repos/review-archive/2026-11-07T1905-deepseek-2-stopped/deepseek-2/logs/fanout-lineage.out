{"type":"tool_use","timestamp":1794075205939,"sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","part":{"partID":"prt_1b7371521001ulYeshdNTFqn0u","sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","messageID":"msg_1b73677dd001v6SYoEqG3b8v3N","type":"tool","id":"call_a9d43073961d48809cb67c6d","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled && git diff ac32d66fed..7714ff26b1 -- .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh .skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts"},"output":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh b/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\nindex 3f31138fdc..fb057a2502 100755\n--- a/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\n@@ -180,14 +180,55 @@ exit_if_switched_off() {\n # 4. PHASE CHILD DISCOVERY\n # ───────────────────────────────────────────────────────────────\n \n+is_track_root_folder() {\n+    local folder=\"$1\"\n+    local folder_name\n+    folder_name=$(basename \"$folder\")\n+    [[ \"$(basename \"$(dirname \"$folder\")\")\" == \"specs\" ]] || return 1\n+    [[ ! \"$folder_name\" =~ ^[0-9]{3}-[a-z0-9-]+$ ]] || return 1\n+    [[ ! -f \"$folder/spec.md\" ]]\n+}\n+\n+has_subtrack_declaration() {\n+    local folder=\"$1\"\n+    local folder_name\n+    folder_name=$(basename \"$folder\")\n+    [[ \"$folder_name\" != z_* ]] || return 1\n+    [[ ! \"$folder_name\" =~ ^[0-9]{3}-[a-z0-9-]+$ ]] || return 1\n+    [[ ! -f \"$folder/spec.md\" ]] || return 1\n+    [[ -f \"$folder/description.json\" ]] || return 1\n+    node -e '\n+const fs = require(\"fs\");\n+try {\n+  const description = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n+  if (description.level === \"sub-track\") process.exit(0);\n+} catch {}\n+process.exit(1);\n+' \"$folder/description.json\" >/dev/null 2>&1\n+}\n+\n+is_declared_subtrack_folder() {\n+    local folder=\"$1\"\n+    [[ -d \"$folder\" && ! -L \"$folder\" ]] || return 1\n+    is_track_root_folder \"$(dirname \"$folder\")\" || return 1\n+    has_subtrack_declaration \"$folder\"\n+}\n+\n has_phase_children() {\n     local parent_folder=\"$1\"\n     local phase_dir\n+    local subtrack_folder\n     for phase_dir in \"$parent_folder\"/[0-9][0-9][0-9]-*/; do\n         if [[ -d \"$phase_dir\" ]]; then\n             return 0\n         fi\n     done\n+    if is_track_root_folder \"$parent_folder\"; then\n+        for subtrack_folder in \"$parent_folder\"/*/; do\n+            [[ -d \"$subtrack_folder\" ]] || continue\n+            is_declared_subtrack_folder \"${subtrack_folder%/}\" && return 0\n+        done\n+    fi\n     return 1\n }\n \n@@ -302,6 +343,8 @@ collect_phase_dirs() {\n     local manifest_rc=0\n     local phase_dir=\"\"\n     local phase_name=\"\"\n+    local subtrack_folder=\"\"\n+    local packet_dir=\"\"\n \n     PHASE_DIRS=()\n     load_child_manifest \"$parent_folder\" || manifest_rc=$?\n@@ -316,6 +359,26 @@ collect_phase_dirs() {\n             [[ -d \"$phase_dir\" ]] && PHASE_DIRS+=(\"${phase_dir%/}\")\n         done\n     fi\n+\n+    if ! $CHILD_MANIFEST_ACTIVE && is_track_root_folder \"$parent_folder\"; then\n+        for subtrack_folder in \"$parent_folder\"/*/; do\n+            [[ -d \"$subtrack_folder\" ]] || continue\n+            subtrack_folder=\"${subtrack_folder%/}\"\n+            if [[ -L \"$subtrack_folder\" ]]; then\n+                if has_subtrack_declaration \"$subtrack_folder\"; then\n+                    printf 'Skipped symlinked sub-track: %s\\n' \"$subtrack_folder\" >&2\n+                fi\n+                continue\n+            fi\n+            is_declared_subtrack_folder \"$subtrack_folder\" || continue\n+            # A sub-track's packets are validated at the same depth as a track's\n+            # own packets, so a packet's result never depends on which it sits in.\n+            PHASE_DIRS+=(\"$subtrack_folder\")\n+            for packet_dir in \"$subtrack_folder\"/[0-9][0-9][0-9]-*/; do\n+                [[ -d \"$packet_dir\" ]] && PHASE_DIRS+=(\"${packet_dir%/}\")\n+            done\n+        done\n+    fi\n     return 0\n }\n \ndiff --git a/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts b/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\nindex 6f387fca1f..0acf2b5fe7 100644\n--- a/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\n+++ b/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\n@@ -223,6 +223,28 @@ function isTrackRoot(folder: string): boolean {\n   return !fs.existsSync(path.join(resolved, 'spec.md'));\n }\n \n+function hasSubTrackLevel(folder: string): boolean {\n+  const descriptionPath = path.join(folder, 'description.json');\n+  if (!fs.existsSync(descriptionPath)) return false;\n+\n+  try {\n+    const description = JSON.parse(fs.readFileSync(descriptionPath, 'utf8')) as Record<string, unknown>;\n+    return description.level === 'sub-track';\n+  } catch {\n+    return false;\n+  }\n+}\n+\n+function isDeclaredSubTrack(folder: string): boolean {\n+  const resolved = path.resolve(folder);\n+  const name = path.basename(resolved);\n+  if (!fs.existsSync(resolved) || fs.lstatSync(resolved).isSymbolicLink()) return false;\n+  if (name.startsWith('z_') || PACKET_FOLDER_RE.test(name)) return false;\n+  if (fs.existsSync(path.join(resolved, 'spec.md'))) return false;\n+  if (!isTrackRoot(path.dirname(resolved))) return false;\n+  return hasSubTrackLevel(resolved);\n+}\n+\n function isRegistryEntry(value: unknown): value is ValidatorRegistryEntry {\n   if (!value || typeof value !== 'object') return false;\n   const candidate = value as Record<string, unknown>;\n@@ -1337,8 +1359,12 @@ export function validateFolder(folderPath: string, opts: ValidateOpts = {}): Val\n   // metadata so the tracks are searchable, which is enough to make it look like\n   // a phase parent, and it then fails rules it can never satisfy — its name is\n   // a track name and will never match the packet naming convention.\n-  if (isTrackRoot(folder)) {\n-    const entries = [entry('TRACK_ROOT', 'info', 'Track directory, not a packet; no packet rules apply')];\n+  const isTrack = isTrackRoot(folder);\n+  if (isTrack || isDeclaredSubTrack(folder)) {\n+    const message = isTrack\n+      ? 'Track directory, not a packet; no packet rules apply'\n+      : 'Sub-track directory, not a packet; no packet rules apply';\n+    const entries = [entry('TRACK_ROOT', 'info', message)];\n     return {\n       folder,\n       level: '1',\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh b/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\nindex 3f31138fdc..fb057a2502 100755\n--- a/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh\n@@ -180,14 +180,55 @@ exit_if_switched_off() {\n # 4. PHASE CHILD DISCOVERY\n # ───────────────────────────────────────────────────────────────\n \n+is_track_root_folder() {\n+    local folder=\"$1\"\n+    local folder_name\n+    folder_name=$(basename \"$folder\")\n+    [[ \"$(basename \"$(dirname \"$folder\")\")\" == \"specs\" ]] || return 1\n+    [[ ! \"$folder_name\" =~ ^[0-9]{3}-[a-z0-9-]+$ ]] || return 1\n+    [[ ! -f \"$folder/spec.md\" ]]\n+}\n+\n+has_subtrack_declaration() {\n+    local folder=\"$1\"\n+    local folder_name\n+    folder_name=$(basename \"$folder\")\n+    [[ \"$folder_name\" != z_* ]] || return 1\n+    [[ ! \"$folder_name\" =~ ^[0-9]{3}-[a-z0-9-]+$ ]] || return 1\n+    [[ ! -f \"$folder/spec.md\" ]] || return 1\n+    [[ -f \"$folder/description.json\" ]] || return 1\n+    node -e '\n+const fs = require(\"fs\");\n+try {\n+  const description = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n+  if (description.level === \"sub-track\") process.exit(0);\n+} catch {}\n+process.exit(1);\n+' \"$folder/description.json\" >/dev/null 2>&1\n+}\n+\n+is_declared_subtrack_folder() {\n+    local folder=\"$1\"\n+    [[ -d \"$folder\" && ! -L \"$folder\" ]] || return 1\n+    is_track_root_folder \"$(dirname \"$folder\")\" || return 1\n+    has_subtrack_declaration \"$folder\"\n+}\n+\n has_phase_children() {\n     local parent_folder=\"$1\"\n     local phase_dir\n+    local subtrack_folder\n     for phase_dir in \"$parent_folder\"/[0-9][0-9][0-9]-*/; do\n         if [[ -d \"$phase_dir\" ]]; then\n             return 0\n         fi\n     done\n+    if is_track_root_folder \"$parent_folder\"; then\n+        for subtrack_folder in \"$parent_folder\"/*/; do\n+            [[ -d \"$subtrack_folder\" ]] || continue\n+            is_declared_subtrack_folder \"${subtrack_folder%/}\" && return 0\n+        done\n+    fi\n     return 1\n }\n \n@@ -302,6 +343,8 @@ collect_phase_dirs() {\n     local manifest_rc=0\n     local phase_dir=\"\"\n     local phase_name=\"\"\n+    local subtrack_folder=\"\"\n+    local packet_dir=\"\"\n \n     PHASE_DIRS=()\n     load_child_manifest \"$parent_folder\" || manifest_rc=$?\n@@ -316,6 +359,26 @@ collect_phase_dirs() {\n             [[ -d \"$phase_dir\" ]] && PHASE_DIRS+=(\"${phase_dir%/}\")\n         done\n     fi\n+\n+    if ! $CHILD_MANIFEST_ACTIVE && is_track_root_folder \"$parent_folder\"; then\n+        for subtrack_folder in \"$parent_folder\"/*/; do\n+            [[ -d \"$subtrack_folder\" ]] || continue\n+            subtrack_folder=\"${subtrack_folder%/}\"\n+            if [[ -L \"$subtrack_folder\" ]]; then\n+                if has_subtrack_declaration \"$subtrack_folder\"; then\n+                    printf 'Skipped symlinked sub-track: %s\\n' \"$subtrack_folder\" >&2\n+                fi\n+                continue\n+            fi\n+            is_declared_subtrack_folder \"$subtrack_folder\" || continue\n+            # A sub-track's packets are validated at the same depth as a track's\n+            # own packets, so a packet's result never depends on which it sits in.\n+            PHASE_DIRS+=(\"$subtrack_folder\")\n+            for packet_dir in \"$subtrack_folder\"/[0-9][0-9][0-9]-*/; do\n+                [[ -d \"$packet_dir\" ]] && PHASE_DIRS+=(\"${packet_dir%/}\")\n+            done\n+        done\n+    fi\n     return 0\n }\n \ndiff --git a/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts b/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\nindex 6f387fca1f..0acf2b5fe7 100644\n--- a/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\n+++ b/.skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\n@@ -223,6 +223,28 @@ function isTrackRoot(folder: string): boolean {\n   return !fs.existsSync(path.join(resolved, 'spec.md'));\n }\n \n+function hasSubTrackLevel(folder: string): boolean {\n+  const descriptionPath = path.join(folder, 'description.json');\n+  if (!fs.existsSync(descriptionPath)) return false;\n+\n+  try {\n+    const description = JSON.parse(fs.readFileSync(descriptionPath, 'utf8')) as Record<string, unknown>;\n+    return description.level === 'sub-track';\n+  } catch {\n+    return false;\n+  }\n+}\n+\n+function isDeclaredSubTrack(folder: string): boolean {\n+  const resolved = path.resolve(folder);\n+  const name = path.basename(resolved);\n+  if (!fs.existsSync(resolved) || fs.lstatSync(resolved).isSymbolicLink()) return false;\n+  if (name.startsWith('z_') || PACKET_FOLDER_RE.test(name)) return false;\n+  if (fs.existsSync(path.join(resolved, 'spec.md'))) return false;\n+  if (!isTrackRoot(path.dirname(resolved))) return false;\n+  return hasSubTrackLevel(resolved);\n+}\n+\n function isRegistryEntry(value: unknown): value is ValidatorRegistryEntry {\n   if (!value || typeof value !== 'object') return false;\n   const candidate = value as Record<string, unknown>;\n@@ -1337,8 +1359,12 @@ export function validateFolder(folderPath: string, opts: ValidateOpts = {}): Val\n   // metadata so the tracks are searchable, which is enough to make it look like\n   // a phase parent, and it then fails rules it can never satisfy — its name is\n   // a track name and will never match the packet naming convention.\n-  if (isTrackRoot(folder)) {\n-    const entries = [entry('TRACK_ROOT', 'info', 'Track directory, not a packet; no packet rules apply')];\n+  const isTrack = isTrackRoot(folder);\n+  if (isTrack || isDeclaredSubTrack(folder)) {\n+    const message = isTrack\n+      ? 'Track directory, not a packet; no packet rules apply'\n+      : 'Sub-track directory, not a packet; no packet rules apply';\n+    const entries = [entry('TRACK_ROOT', 'info', message)];\n     return {\n       folder,\n       level: '1',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/MEGA/Development/Skilled && git diff ac32d66fed..7714ff26b1 -- .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh .skilled/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\"}"},"time":{"start":1794075202849,"end":1794075205939}}}}
{"type":"tool_use","timestamp":1794075205940,"sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","part":{"partID":"prt_1b73719a0001hkeuYnd1lUxQWC","sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","messageID":"msg_1b73677dd001v6SYoEqG3b8v3N","type":"tool","id":"call_981379b75f7849289b39da6d","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled && git diff ac32d66fed..7714ff26b1 -- .skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts .skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs"},"output":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs b/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\nindex 89072b48e1..f7e78565db 100755\n--- a/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\n@@ -312,6 +312,84 @@ function readForWrite(file) {\n // 4. DERIVED REPAIRS\n // ───────────────────────────────────────────────────────────────────\n \n+// A sub-track has no number to mark it, so only the declaration in its own\n+// description.json makes it a parent. Shape alone is never enough: an undeclared\n+// folder must not be promoted just because it sits between a track and a packet.\n+const SUBTRACK_LEVEL = 'sub-track';\n+\n+/** Whether a folder declares itself a named sub-track container. */\n+function declaresSubtrack(folder) {\n+  const name = path.basename(folder);\n+  if (name.startsWith('z_') || PACKET_NAME_RE.test(name) || isSymbolicLink(folder)) return false;\n+  const file = path.join(folder, 'description.json');\n+  if (isSymbolicLink(file)) return false;\n+  const text = readIfPresent(file);\n+  if (text === null) return false;\n+  let data;\n+  try {\n+    data = JSON.parse(text);\n+  } catch {\n+    return false;\n+  }\n+  return Boolean(\n+    data\n+    && typeof data === 'object'\n+    && !Array.isArray(data)\n+    && typeof data.level === 'string'\n+    && data.level === SUBTRACK_LEVEL,\n+  );\n+}\n+\n+// Resolve a packet's specs-root-relative segments through links, so the canonical\n+// `specs` spelling and its `.opencode/specs` alias name the same tree. Null when\n+// the folder does not sit under the root.\n+function specsSegments(folder) {\n+  try {\n+    const root = fs.realpathSync(path.join(REPO, 'specs'));\n+    const relative = path.relative(root, fs.realpathSync(path.resolve(REPO, folder)));\n+    if (!relative || relative === '..' || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) {\n+      return null;\n+    }\n+    return { root, segments: relative.split(path.sep).filter(Boolean) };\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+// What parent_id the packet's current location implies, when a sub-track or an\n+// archive is involved. Every other location is left to the re-derive and the\n+// merge exactly as before: a flat packet's stored parent and its review flag wait\n+// for a person, so this repair never decides them. A move into an undeclared\n+// folder names nothing either, and the merge keeps the old parent flagged.\n+function expectedParentId(folder, recordedParent) {\n+  const resolved = specsSegments(folder);\n+  if (!resolved) return { known: false };\n+  const { root, segments } = resolved;\n+  if (segments.length < 2) return { known: false };\n+  const parentLeaf = segments[segments.length - 2];\n+  const parentId = segments.slice(0, -1).join('/');\n+  // A packet sitting directly in an archive has no parent packet.\n+  if (parentLeaf === 'z_archive') return { known: true, parentId: null, archived: true };\n+  // A declared container's own parent is its track.\n+  if (segments.length === 2 && declaresSubtrack(path.join(root, ...segments))) {\n+    return { known: true, parentId: segments[0] };\n+  }\n+  if (segments.length === 3 && declaresSubtrack(path.join(root, ...segments.slice(0, -1)))) {\n+    return { known: true, parentId };\n+  }\n+  // A packet moved out of a sub-track into its track still names that sub-track.\n+  // The recorded id is stored text, so it must be exactly \"<track>/<sub>\" before it\n+  // names a folder to read.\n+  const recordedSegments = typeof recordedParent === 'string' ? recordedParent.split('/') : [];\n+  if (segments.length === 2 && recordedSegments.length === 2\n+    && recordedSegments[0] === segments[0]\n+    && recordedSegments.every((segment) => segment !== '' && segment !== '.' && segment !== '..')\n+    && declaresSubtrack(path.join(root, ...recordedSegments))) {\n+    return { known: true, parentId: null };\n+  }\n+  return { known: false };\n+}\n+\n // A repair rewrites a document a person wrote. Writing in place truncates the\n // file first, so an interrupt between the truncate and the write leaves that\n // document empty — an outcome worse than the failure being repaired. Writing a\n@@ -436,12 +514,14 @@ function fixRecordedLocation(folder) {\n     }\n   }\n \n-  // A packet sitting directly in an archive has no parent packet: z_archive is\n-  // not one, and a re-derive computes null. The graph merge keeps a stored\n-  // parent over a null re-derive and flags it for review, so after a move the\n-  // parent the packet was archived from would survive and fail the path check.\n+  // The graph merge keeps a stored parent over a null re-derive and flags it for\n+  // review, so a packet moved out of a sub-track would keep its old parent, and one\n+  // moved between sub-tracks would keep the wrong one. Record the parent the new\n+  // location names before the re-derive runs: a numbered packet or declared\n+  // sub-track owns it, a track root or archive owns none. A move into an undeclared\n+  // folder names nothing, so that one is left for the merge to flag.\n   const graph = path.join(folder, 'graph-metadata.json');\n-  const graphText = path.basename(path.dirname(path.resolve(REPO, folder))) === 'z_archive' ? readIfPresent(graph) : null;\n+  const graphText = readIfPresent(graph);\n   if (graphText !== null) {\n     let data = null;\n     try {\n@@ -449,17 +529,24 @@ function fixRecordedLocation(folder) {\n     } catch {\n       // A graph file that cannot be read is the re-derive's to report.\n     }\n-    if (data && typeof data === 'object' && !Array.isArray(data) && data.parent_id) {\n-      actions.push({\n-        file: graph,\n-        what: `graph parent ${data.parent_id} -> none, the packet is archived`,\n-        apply: () => {\n-          const current = JSON.parse(readForWrite(graph));\n-          current.parent_id = null;\n-          delete current.parent_id_review_required;\n-          writeAtomic(graph, `${JSON.stringify(current, null, 2)}\\n`);\n-        },\n-      });\n+    // A stored parent id is sometimes the literal text \"null\" rather than JSON null.\n+    const recorded = data && typeof data === 'object' && !Array.isArray(data)\n+      ? (typeof data.parent_id === 'string' && data.parent_id.trim().toLowerCase() === 'null' ? null : data.parent_id ?? null)\n+      : undefined;\n+    const expected = recorded === undefined ? { known: false } : expectedParentId(folder, recorded);\n+    if (expected.known) {\n+      if (recorded !== expected.parentId || (!expected.archived && data.parent_id_review_required === true)) {\n+        actions.push({\n+          file: graph,\n+          what: `graph parent ${recorded ?? 'none'} -> ${expected.parentId ?? 'none'}`,\n+          apply: () => {\n+            const current = JSON.parse(readForWrite(graph));\n+            current.parent_id = expected.parentId;\n+            delete current.parent_id_review_required;\n+            writeAtomic(graph, `${JSON.stringify(current, null, 2)}\\n`);\n+          },\n+        });\n+      }\n     }\n   }\n \ndiff --git a/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts b/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\nindex 68de6a9ce4..3683e3462a 100644\n--- a/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\n+++ b/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\n@@ -844,16 +844,62 @@ function resolveSpecFolderPath(specFolderPath: string): string {\n   return path.basename(specFolderPath);\n }\n \n-function resolveParentId(specFolder: string): string | null {\n+// A named sub-track carries no number, so its segments alone cannot mark it as a\n+// parent. The declaration in the container's own description.json is the only\n+// evidence that it is one: shape is not enough, because an undeclared folder must\n+// never be promoted to a parent just for sitting between a track and a packet.\n+const SUBTRACK_LEVEL = 'sub-track';\n+\n+/** Whether a folder declares itself a named sub-track container. */\n+function isDeclaredSubtrackFolder(folderPath: string): boolean {\n+  const name = path.basename(folderPath);\n+  if (name.startsWith('z_') || isSpecLeafSegment(name) || isSymbolicLink(folderPath)) {\n+    return false;\n+  }\n+  const descriptionPath = path.join(folderPath, 'description.json');\n+  if (isSymbolicLink(descriptionPath)) {\n+    return false;\n+  }\n+  try {\n+    const parsed: unknown = JSON.parse(fs.readFileSync(descriptionPath, 'utf-8'));\n+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n+      return false;\n+    }\n+    const level = (parsed as { level?: unknown }).level;\n+    return level === SUBTRACK_LEVEL;\n+  } catch {\n+    return false;\n+  }\n+}\n+\n+/**\n+ * The parent a spec folder's location implies.\n+ *\n+ * A numbered parent is readable from the id alone. A declared sub-track is not,\n+ * so that case consults the parent folder on disk; without it a packet filed in a\n+ * sub-track re-derives as parentless and the merge keeps a stale parent flagged\n+ * for review after a move.\n+ *\n+ * @param specFolder - Specs-root-relative folder id\n+ * @param specFolderPath - Absolute path used to inspect the parent folder\n+ * @returns The parent id, or null when the folder sits at a root or under an undeclared segment\n+ */\n+function resolveParentId(specFolder: string, specFolderPath: string): string | null {\n   const segments = specFolder.split('/').filter(Boolean);\n   if (segments.length < 2) {\n     return null;\n   }\n   const parentLeaf = segments[segments.length - 2] ?? '';\n-  if (!isSpecLeafSegment(parentLeaf)) {\n+  if (isSpecLeafSegment(parentLeaf)) {\n+    return segments.slice(0, -1).join('/');\n+  }\n+  // A sub-track sits directly in its track, so only a packet three segments deep\n+  // can have one as its parent.\n+  if (segments.length !== 3) {\n     return null;\n   }\n-  return segments.slice(0, -1).join('/');\n+  const parentFolder = path.dirname(path.resolve(specFolderPath));\n+  return isDeclaredSubtrackFolder(parentFolder) ? segments.slice(0, -1).join('/') : null;\n }\n \n /** Resolve the specs-root-relative children_ids for a spec folder from its on-disk phase children. */\n@@ -894,7 +940,14 @@ interface BuildIdentity {\n function resolveBuildIdentity(specFolderPath: string): BuildIdentity {\n   if (isIdentityMergeSafetyEnabled()) {\n     try {\n-      return resolveSpecFolderIdentity(specFolderPath);\n+      const identity = resolveSpecFolderIdentity(specFolderPath);\n+      return {\n+        ...identity,\n+        // The shared resolver still reads a parent from numbered segments only, so a\n+        // packet directly inside a declared sub-track comes back parentless. Fill that\n+        // one gap from the folder layout; every parent it already found stays untouched.\n+        parentId: identity.parentId ?? resolveParentId(identity.specFolder, specFolderPath),\n+      };\n     } catch (error) {\n       if (!(error instanceof SpecFolderIdentityError)) {\n         throw error;\n@@ -905,7 +958,7 @@ function resolveBuildIdentity(specFolderPath: string): BuildIdentity {\n   const specFolder = resolveSpecFolderPath(specFolderPath);\n   return {\n     specFolder,\n-    parentId: resolveParentId(specFolder),\n+    parentId: resolveParentId(specFolder, specFolderPath),\n     childrenIds: resolveChildrenIds(specFolderPath, specFolder),\n   };\n }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs b/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\nindex 89072b48e1..f7e78565db 100755\n--- a/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/spec/repair-derived.cjs\n@@ -312,6 +312,84 @@ function readForWrite(file) {\n // 4. DERIVED REPAIRS\n // ───────────────────────────────────────────────────────────────────\n \n+// A sub-track has no number to mark it, so only the declaration in its own\n+// description.json makes it a parent. Shape alone is never enough: an undeclared\n+// folder must not be promoted just because it sits between a track and a packet.\n+const SUBTRACK_LEVEL = 'sub-track';\n+\n+/** Whether a folder declares itself a named sub-track container. */\n+function declaresSubtrack(folder) {\n+  const name = path.basename(folder);\n+  if (name.startsWith('z_') || PACKET_NAME_RE.test(name) || isSymbolicLink(folder)) return false;\n+  const file = path.join(folder, 'description.json');\n+  if (isSymbolicLink(file)) return false;\n+  const text = readIfPresent(file);\n+  if (text === null) return false;\n+  let data;\n+  try {\n+    data = JSON.parse(text);\n+  } catch {\n+    return false;\n+  }\n+  return Boolean(\n+    data\n+    && typeof data === 'object'\n+    && !Array.isArray(data)\n+    && typeof data.level === 'string'\n+    && data.level === SUBTRACK_LEVEL,\n+  );\n+}\n+\n+// Resolve a packet's specs-root-relative segments through links, so the canonical\n+// `specs` spelling and its `.opencode/specs` alias name the same tree. Null when\n+// the folder does not sit under the root.\n+function specsSegments(folder) {\n+  try {\n+    const root = fs.realpathSync(path.join(REPO, 'specs'));\n+    const relative = path.relative(root, fs.realpathSync(path.resolve(REPO, folder)));\n+    if (!relative || relative === '..' || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) {\n+      return null;\n+    }\n+    return { root, segments: relative.split(path.sep).filter(Boolean) };\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+// What parent_id the packet's current location implies, when a sub-track or an\n+// archive is involved. Every other location is left to the re-derive and the\n+// merge exactly as before: a flat packet's stored parent and its review flag wait\n+// for a person, so this repair never decides them. A move into an undeclared\n+// folder names nothing either, and the merge keeps the old parent flagged.\n+function expectedParentId(folder, recordedParent) {\n+  const resolved = specsSegments(folder);\n+  if (!resolved) return { known: false };\n+  const { root, segments } = resolved;\n+  if (segments.length < 2) return { known: false };\n+  const parentLeaf = segments[segments.length - 2];\n+  const parentId = segments.slice(0, -1).join('/');\n+  // A packet sitting directly in an archive has no parent packet.\n+  if (parentLeaf === 'z_archive') return { known: true, parentId: null, archived: true };\n+  // A declared container's own parent is its track.\n+  if (segments.length === 2 && declaresSubtrack(path.join(root, ...segments))) {\n+    return { known: true, parentId: segments[0] };\n+  }\n+  if (segments.length === 3 && declaresSubtrack(path.join(root, ...segments.slice(0, -1)))) {\n+    return { known: true, parentId };\n+  }\n+  // A packet moved out of a sub-track into its track still names that sub-track.\n+  // The recorded id is stored text, so it must be exactly \"<track>/<sub>\" before it\n+  // names a folder to read.\n+  const recordedSegments = typeof recordedParent === 'string' ? recordedParent.split('/') : [];\n+  if (segments.length === 2 && recordedSegments.length === 2\n+    && recordedSegments[0] === segments[0]\n+    && recordedSegments.every((segment) => segment !== '' && segment !== '.' && segment !== '..')\n+    && declaresSubtrack(path.join(root, ...recordedSegments))) {\n+    return { known: true, parentId: null };\n+  }\n+  return { known: false };\n+}\n+\n // A repair rewrites a document a person wrote. Writing in place truncates the\n // file first, so an interrupt between the truncate and the write leaves that\n // document empty — an outcome worse than the failure being repaired. Writing a\n@@ -436,12 +514,14 @@ function fixRecordedLocation(folder) {\n     }\n   }\n \n-  // A packet sitting directly in an archive has no parent packet: z_archive is\n-  // not one, and a re-derive computes null. The graph merge keeps a stored\n-  // parent over a null re-derive and flags it for review, so after a move the\n-  // parent the packet was archived from would survive and fail the path check.\n+  // The graph merge keeps a stored parent over a null re-derive and flags it for\n+  // review, so a packet moved out of a sub-track would keep its old parent, and one\n+  // moved between sub-tracks would keep the wrong one. Record the parent the new\n+  // location names before the re-derive runs: a numbered packet or declared\n+  // sub-track owns it, a track root or archive owns none. A move into an undeclared\n+  // folder names nothing, so that one is left for the merge to flag.\n   const graph = path.join(folder, 'graph-metadata.json');\n-  const graphText = path.basename(path.dirname(path.resolve(REPO, folder))) === 'z_archive' ? readIfPresent(graph) : null;\n+  const graphText = readIfPresent(graph);\n   if (graphText !== null) {\n     let data = null;\n     try {\n@@ -449,17 +529,24 @@ function fixRecordedLocation(folder) {\n     } catch {\n       // A graph file that cannot be read is the re-derive's to report.\n     }\n-    if (data && typeof data === 'object' && !Array.isArray(data) && data.parent_id) {\n-      actions.push({\n-        file: graph,\n-        what: `graph parent ${data.parent_id} -> none, the packet is archived`,\n-        apply: () => {\n-          const current = JSON.parse(readForWrite(graph));\n-          current.parent_id = null;\n-          delete current.parent_id_review_required;\n-          writeAtomic(graph, `${JSON.stringify(current, null, 2)}\\n`);\n-        },\n-      });\n+    // A stored parent id is sometimes the literal text \"null\" rather than JSON null.\n+    const recorded = data && typeof data === 'object' && !Array.isArray(data)\n+      ? (typeof data.parent_id === 'string' && data.parent_id.trim().toLowerCase() === 'null' ? null : data.parent_id ?? null)\n+      : undefined;\n+    const expected = recorded === undefined ? { known: false } : expectedParentId(folder, recorded);\n+    if (expected.known) {\n+      if (recorded !== expected.parentId || (!expected.archived && data.parent_id_review_required === true)) {\n+        actions.push({\n+          file: graph,\n+          what: `graph parent ${recorded ?? 'none'} -> ${expected.parentId ?? 'none'}`,\n+          apply: () => {\n+            const current = JSON.parse(readForWrite(graph));\n+            current.parent_id = expected.parentId;\n+            delete current.parent_id_review_required;\n+            writeAtomic(graph, `${JSON.stringify(current, null, 2)}\\n`);\n+          },\n+        });\n+      }\n     }\n   }\n \ndiff --git a/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts b/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\nindex 68de6a9ce4..3683e3462a 100644\n--- a/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\n+++ b/.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\n@@ -844,16 +844,62 @@ function resolveSpecFolderPath(specFolderPath: string): string {\n   return path.basename(specFolderPath);\n }\n