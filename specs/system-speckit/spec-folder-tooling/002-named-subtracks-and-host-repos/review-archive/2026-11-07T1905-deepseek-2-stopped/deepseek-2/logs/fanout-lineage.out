{"type":"step_start","timestamp":1794074013101,"sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","part":{"id":"prt_1b724edad001cwdVKO4s1BI6Zu","sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","messageID":"msg_1b72482d3001CGK8xcAUwsdV3e","type":"step-start","snapshot":"15319e2029e65dc38a9af7f10fa3c4245b5ae853"}}
{"type":"tool_use","timestamp":1794074020652,"sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","part":{"partID":"prt_1b72501310019fWRZYS3fkTw1I","sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","messageID":"msg_1b72482d3001CGK8xcAUwsdV3e","type":"tool","id":"call_8463b4dbf56447f5a47ab5cf","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-review-auto.yaml","offset":698,"limit":800},"output":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 698-1332\n698:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n699:           - session_id: \"Extract sessionId from deep-review-config.json\"\n700:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n701:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n702:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n703:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n704:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n705:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n706:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n707:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n708:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n709:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n710:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n711:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n712:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n713:           - review_focus_block: \"When deep-review-config.json reviewFocus is a non-empty string, return 'Operator review focus (cover it in addition to the dimension of this iteration, and say in the narrative how you addressed it): <reviewFocus>'. Else return an empty string.\"\n714: \n715:       step_check_pause_sentinel:\n716:         action: \"Check for pause sentinel file\"\n717:         check: \"Does {state_paths.pause_sentinel} exist?\"\n718:         if_exists:\n719:           set:\n720:             pending_stop_event: \"paused\"\n721:             pending_stop_reason: \"userPaused\"\n722:             pending_stop_detail: \"sentinel file detected\"\n723:           skip_to: step_normalize_pause_events\n724:         if_not_exists:\n725:           proceed: true\n726: \n727:       step_validate_convergence_config:\n728:         action: \"Validate convergence mode when loading config\"\n729:         if_convergence_mode_invalid:\n730:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n731:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n732: \n733:       step_graph_convergence:\n734:         action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n735:         inspect:\n736:           - \"{state_paths.state_log}\"\n737:           - \"{state_paths.findings_registry}\"\n738:         transform: |\n739:           1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n740:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n741:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n742:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n743:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n744:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n745:         note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n746:         append_jsonl: '{\"stem\":\"deep_review.graph_convergence_evaluated\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"rawSignals\":{graph_raw_signals_json},\"weightedSignals\":{graph_raw_signals_json},\"dimensionCoverageDigest\":\"{dimension_coverage_digest}\",\"protocolCoverageDigest\":\"{protocol_coverage_digest}\",\"findingStability\":\"{finding_stability}\",\"p0p1ResolutionState\":\"{p0p1_resolution_state}\",\"evidenceDensity\":{evidence_density},\"hotspotSaturation\":{hotspot_saturation},\"decision\":\"{graph_decision_code}\",\"policyFingerprint\":\"{policy_fingerprint}\",\"blockerIds\":{graph_blocker_ids_json},\"stopCandidate\":{stop_candidate},\"graphDecision\":\"{graph_decision_code}\",\"graphDigest\":\"{graph_digest}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json}},\"eventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\"}'\n747:         outputs:\n748:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n749:           - graph_decision_code: \"CONTINUE maps to continue, STOP_ALLOWED to converged, STOP_BLOCKED to blocked\"\n750:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n751:           - graph_raw_signals_json: \"Exact-field convergence-signals JSON built from the convergence.cjs signals; observationDigest is the sha256 of graph_signals_json\"\n752:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n753:           - graph_blocker_ids_json: \"JSON array of blocker type values; use [\\\"graph_blocker\\\"] when the decision is blocked and the list is empty\"\n754:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n755:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n756:           - dimension_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the registry dimensionCoverage map\"\n757:           - protocol_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the protocol coverage object in graph_signals_json, or of {} when absent\"\n758:           - finding_stability: \"stable when findingStabilityRatio >= convergenceThreshold, unstable when below, unknown when the signal is missing\"\n759:           - p0p1_resolution_state: \"resolved when active P0 + P1 findings are 0, blocked when above 0, unknown when counts are unavailable\"\n760:           - evidence_density: \"evidenceDensityRatio from graph_signals_json, capped at 1\"\n761:           - hotspot_saturation: \"hotspotSaturationRatio from graph_signals_json, between 0 and 1\"\n762:           - policy_fingerprint: \"sha256 (64 lowercase hex) of the canonical JSON {convergenceThreshold, stopPolicy, convergenceMode} from the review config\"\n763:           - stop_candidate: \"true when graph_decision == STOP_ALLOWED, else false\"\n764:           - graph_digest: \"sha256 (64 lowercase hex) of graph_signals_json\"\n765: \n766:       step_check_convergence:\n767:         action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n768:         algorithm: |\n769:           0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n770:              claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n771:              If claim_adjudication_gate_pass == false:\n772:                candidate_decision = \"BLOCKED\"\n773:                stop_blocked = true\n774:                stopReason = \"blockedStop\"\n775:                blocked_gates = [\"claimAdjudicationGate\"]\n776:                recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n777:                Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n778:           1. HARD STOPS:\n779:              a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n780:              b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n781:              c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n782:              Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n783:           2. STUCK DETECTION (threshold 2):\n784:              if stuck_count >= 2: STUCK_RECOVERY\n785:           3. GRAPH CONVERGENCE PREREQUISITE:\n786:                graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n787:                Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n788:                If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n789:           4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n790:                signals = []\n791:                a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n792:                   avg = mean(last 2 newFindingsRatios)\n793:                   stop if avg <= 0.08\n794:                b) MAD noise floor (w=0.25, needs 3+ iterations):\n795:                   noiseFloor = MAD(all ratios) * 1.4826\n796:                   stop if latest ratio <= noiseFloor\n797:                c) Dimension coverage (w=0.45):\n798:                   coverage = dimensions_covered / total_dimensions\n799:                   stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n800:                Redistribute weights for unavailable signals.\n801:                if latest ratio <= 0.05: mark no_progress_threshold_reached\n802:                if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n803:                else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n804:           5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):\n805:                a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score\n806:                b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions\n807:                c) p0ResolutionGate: pass when activeP0 == 0; record activeP0\n808:                d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding\n809:                e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic\n810:                f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count\n811:                g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows\n812:                h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: \"skip\"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = \"candidateCoverageGate\"; recovery_strategy = \"Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence.\"\n813:                i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {\"direct_read\",\"exact_grep\",\"semantic_search\",\"producer_consumer_trace\",\"negative_test_inspection\"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = \"graphlessFallbackGate\"; recovery_strategy = \"Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available.\"\n814:              if STOP is a candidate and any gate fails:\n815:                decision = \"BLOCKED\"\n816:                stop_blocked = true\n817:                stopReason = \"blockedStop\"\n818:                blocked_by_json = JSON array of failing gate names (always include \"claimAdjudicationGate\" when claim_adjudication_gate_pass == false, \"fixCompletenessReplayGate\" when fix_completeness_replay_gate_pass == false, \"candidateCoverageGate\" when candidate_coverage_gate_pass == false, and \"graphlessFallbackGate\" when graphless_fallback_gate_pass == false)\n819:                blocked_by_csv = comma-separated list of failing gate names\n820:                convergence_gate_pass = boolean\n821:                convergence_gate_score = numeric convergence score\n822:                dimension_coverage_gate_pass = boolean\n823:                dimension_coverage_gate_covered_json = JSON array of covered review dimensions\n824:                dimension_coverage_gate_missing_json = JSON array of missing review dimensions\n825:                p0_resolution_gate_pass = boolean\n826:                active_p0_count = number of active P0 findings\n827:                evidence_density_gate_pass = boolean\n828:                avg_evidence_per_finding = numeric evidence density\n829:                hotspot_saturation_gate_pass = boolean\n830:                claim_adjudication_gate_pass = boolean\n831:                claim_adjudication_active_count = numeric count of active P0/P1 at the gate\n832:                fix_completeness_replay_gate_pass = boolean\n833:                security_sensitive_fix_scope = boolean\n834:                fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns\n835:                fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence\n836:                candidate_coverage_gate_pass = boolean\n837:                candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n838:                candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n839:                graphless_fallback_gate_pass = boolean\n840:                graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n841:                graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n842:                graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n843:                recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n844:           6. COMBINED STOP RULE:\n845:                a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n846:                b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n847:                     decision = \"BLOCKED\"\n848:                     stop_blocked = true\n849:                     stopReason = \"blockedStop\"\n850:                     # Blocked-stop closure: blockedBy must be string[] per the\n851:                     # published review blocked-stop contract. Extract the `.type`\n852:                     # field from each structured graph blocker; preserve the full\n853:                     # objects in graph_blocker_detail_json for operator inspection.\n854:                     blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n855:                     blocked_by_csv = graph_blockers_csv\n856:                     graph_blocker_detail_json = graph_blockers_json\n857:                     recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n858:                c) if STOP is legal AND graph_decision == \"CONTINUE\":\n859:                     decision = \"CONTINUE\"\n860:                     stop_blocked = false\n861:                     reason = \"graph_convergence_continue\"\n862:                d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n863:         outputs:\n864:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n865:           - reason: \"Human-readable stop reason\"\n866:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n867:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n868:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n869:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n870:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n871:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n872:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n873:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n874:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n875:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n876:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n877:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n878:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n879:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n880:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n881:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n882:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n883:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n884:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n885:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n886:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n887:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n888:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n889:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n890:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n891:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n892:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n893:           - graph_signals_json: \"JSON object returned by graph convergence\"\n894:           - graph_blockers_json: \"JSON array of graph blockers\"\n895:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n896:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n897:           - recovery_strategy_code: \"Slug form of recovery_strategy for the ledger code fields\"\n898:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), with at least one fail row when decision == BLOCKED\"\n899:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n900: \n901:       step_emit_blocked_stop:\n902:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n903:         if_blocked:\n904:           append_jsonl: '{\"stem\":\"deep_review.blocked_stop_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"blockedGateIds\":{blocked_by_json},\"gateResults\":{gate_results_array_json},\"activeFindingCounts\":{\"candidates\":{active_total_count},\"adjudicated\":{active_total_count},\"p0\":{p0_count},\"p1\":{p1_count},\"p2\":{p2_count}},\"recoveryStrategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{next_dimension}\",\"originatingConvergenceEventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\",\"appendPosition\":{current_iteration},\"gateDetail\":{gate_results_array_json},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryHint\":\"{recovery_strategy}\"}}'\n905:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n906:         if_not_blocked:\n907:           proceed: true\n908: \n909:       step_handle_convergence:\n910:         action: \"Act on convergence decision\"\n911:         if_stop:\n912:           branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n913:           if_divergent_eligible:\n914:             eligibility_contract:\n915:               required_decision: \"STOP\"\n916:               eligible_reasons: [all_dimensions_clean]\n917:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n918:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n919:             steps:\n920:               step_prepare_divergent_pivot:\n921:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n922:                 command: |\n923:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n924:                   import {\n925:                     buildReviewPivotPreparationInput,\n926:                     renderReviewPivotSeatPrompt,\n927:                   } from './.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n928:                   import {\n929:                     preparePivotTransaction,\n930:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n931: \n932:                   const input = buildReviewPivotPreparationInput({\n933:                     artifactRoot: '{state_paths.packet_dir}',\n934:                     configPath: '{state_paths.config}',\n935:                     stateLogPath: '{state_paths.state_log}',\n936:                     strategyPath: '{state_paths.strategy}',\n937:                     registryPath: '{state_paths.findings_registry}',\n938:                     currentIteration: Number('{current_iteration}'),\n939:                     maxIterations: Number('{max_iterations}'),\n940:                     triggerReason: '{reason}',\n941:                   });\n942:                   const prepared = await preparePivotTransaction(input);\n943:                   const seatPrompts = prepared.status === 'pending'\n944:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n945:                         seat.id,\n946:                         renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n947:                       ]))\n948:                     : {};\n949:                   process.stdout.write(`${JSON.stringify({\n950:                     ...prepared,\n951:                     seatPrompts,\n952:                     boundaryRejections: input.boundaryRejections,\n953:                   })}\\n`);\n954:                   EOF\n955:                 working_directory: \"{repo_root}\"\n956:                 outputs:\n957:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n958:                   - pivot_prepare_status: \"status from the prepare result\"\n959:                   - pivot_id: \"pivotId from the prepare result\"\n960:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n961:                   - pivot_resumed: \"resumed from the prepare result\"\n962:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n963:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n964:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n965:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n966:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n967:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n968:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n969:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n970:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n971: \n972:               step_dispatch_pivot_seat_001:\n973:                 action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n974:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n975:                 capture_timing: true\n976:                 if_native:\n977:                   dispatch:\n978:                     agent: deep-review\n979:                     model: opus\n980:                     context_source: \"pivot_seat_001_prompt\"\n981:                   wait_for_completion: true\n982:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n983:                 outputs:\n984:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n985:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n986:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n987:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n988:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n989:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n990: \n991:               step_record_pivot_seat_001:\n992:                 action: \"Durably record the seat-001 native dispatch outcome\"\n993:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n994:                 command: |\n995:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n996:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n997:                   const status = '{pivot_seat_001_dispatch_status}';\n998:                   const outcome = status === 'fulfilled'\n999:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n1000:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n1001:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n1002:                   EOF\n1003:                 working_directory: \"{repo_root}\"\n1004: \n1005:               step_dispatch_pivot_seat_002:\n1006:                 action: \"Natively dispatch the critical read-only review direction-selection seat\"\n1007:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1008:                 capture_timing: true\n1009:                 if_native:\n1010:                   dispatch:\n1011:                     agent: deep-review\n1012:                     model: opus\n1013:                     context_source: \"pivot_seat_002_prompt\"\n1014:                   wait_for_completion: true\n1015:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n1016:                 outputs:\n1017:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n1018:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1019:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n1020:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n1021:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n1022:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n1023: \n1024:               step_record_pivot_seat_002:\n1025:                 action: \"Durably record the seat-002 native dispatch outcome\"\n1026:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1027:                 command: |\n1028:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1029:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1030:                   const status = '{pivot_seat_002_dispatch_status}';\n1031:                   const outcome = status === 'fulfilled'\n1032:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n1033:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n1034:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n1035:                   EOF\n1036:                 working_directory: \"{repo_root}\"\n1037: \n1038:               step_dispatch_pivot_seat_003:\n1039:                 action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n1040:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1041:                 capture_timing: true\n1042:                 if_native:\n1043:                   dispatch:\n1044:                     agent: deep-review\n1045:                     model: opus\n1046:                     context_source: \"pivot_seat_003_prompt\"\n1047:                   wait_for_completion: true\n1048:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1049:                 outputs:\n1050:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1051:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1052:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1053:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1054:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1055:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1056: \n1057:               step_record_pivot_seat_003:\n1058:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1059:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1060:                 command: |\n1061:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1062:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1063:                   const status = '{pivot_seat_003_dispatch_status}';\n1064:                   const outcome = status === 'fulfilled'\n1065:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1066:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1067:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1068:                   EOF\n1069:                 working_directory: \"{repo_root}\"\n1070: \n1071:               step_finalize_divergent_pivot:\n1072:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1073:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1074:                 command: |\n1075:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1076:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1077:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1078:                   EOF\n1079:                 working_directory: \"{repo_root}\"\n1080:                 outputs:\n1081:                   - pivot_finalize_json: \"The complete parsed final result\"\n1082: \n1083:               step_resolve_divergent_pivot_result:\n1084:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1085:                 branch_on: \"pivot_prepare_status\"\n1086:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1087:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1088: \n1089:               step_apply_divergent_pivot_result:\n1090:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1091:                 branch_on: \"pivot_result.status\"\n1092:                 if_completed:\n1093:                   set:\n1094:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1095:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1096:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1097:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1098:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1099:                   proceed_to: step_normalize_pause_events\n1100:                 if_failed:\n1101:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1102:                   skip_to: phase_synthesis\n1103:             on_error:\n1104:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1105:               skip_to: phase_synthesis\n1106:           if_existing_terminal_path:\n1107:             log: \"Loop stopping. Reason: {reason}\"\n1108:             skip_to: phase_synthesis\n1109:         if_blocked:\n1110:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1111:         if_stuck_recovery:\n1112:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1113:           recovery_strategies:\n1114:             - \"Change granularity: file-level → function-level → line-level review\"\n1115:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1116:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1117:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1118:           set:\n1119:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1120:             pending_stop_event: \"stuck_recovery\"\n1121:             pending_stop_reason: \"stuckRecovery\"\n1122:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1123:           reset: { stuck_count: 0 }\n1124:         if_continue:\n1125:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1126: \n1127:       step_normalize_pause_events:\n1128:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n1129:         if_pending_pause_event:\n1130:           append_jsonl: '{\"stem\":\"deep_review.pause_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"normalizedStopReason\":\"userPaused\",\"sentinelCause\":\"sentinel-file-detected\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"await-operator-resume\",\"targetDimensionId\":\"{next_dimension}\",\"outcome\":\"paused\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\"}}'\n1131:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n1132:           reset:\n1133:             pending_stop_event: null\n1134:             pending_stop_reason: null\n1135:             pending_stop_detail: null\n1136:           halt: true\n1137:         if_pending_stuck_recovery:\n1138:           append_jsonl: '{\"stem\":\"deep_review.recovery_started\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\",\"dimensionId\":\"{least_explored}\"},\"data\":{\"normalizedStopReason\":\"stuckRecovery\",\"recoveryCause\":\"repeated-no-progress\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{least_explored}\",\"outcome\":\"recovery-started\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\",\"originatingPauseEventId\":\"none\"}}'\n1139:           reset:\n1140:             pending_stop_event: null\n1141:             pending_stop_reason: null\n1142:             pending_stop_detail: null\n1143:         if_no_pending_event:\n1144:           proceed: true\n1145:         outputs:\n1146:           - prior_tail_digest: \"sha256 (64 lowercase hex) of the state log bytes at the moment the pause or recovery row is emitted\"\n1147: \n1148:       step_generate_state_summary:\n1149:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1150:         generate: |\n1151:           STATE SUMMARY (auto-generated):\n1152:           Iteration: {current_iteration} of {max_iterations}\n1153:           Dimension: {next_dimension}\n1154:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1155:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1156:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1157:           {resource_map_prompt_line}\n1158:           Coverage Age: {coverage_age}\n1159:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1160:           Stuck count: {stuck_count}\n1161:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1162: \n1163:       step_marker_scan:\n1164:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1165:         canonical_header: \"DEEP-REVIEW\"\n1166:         nested_marker_pattern: \"^(DEEP-RESEARCH|CODE-REVIEW)$\"\n1167:         algorithm: |\n1168:           if current_iteration > 1:\n1169:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1170:             if file_exists(PREV_PROMPT_PATH):\n1171:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1172:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1173:                 log \"ERROR: nested review loop detected (foreign deep-loop marker found in previous iteration prompt). Aborting.\"\n1174:                 halt with exit code 2\n1175:         note: |\n1176:           False-positive prevention: a review prompt that starts with its own canonical\n1177:           header is this loop's own iteration output, never a nested dispatch; only a\n1178:           foreign marker (DEEP-RESEARCH or CODE-REVIEW) is, so the guard matches\n1179:           nested_marker_pattern rather than the canonical header. Markers appearing in\n1180:           comments or body text are ignored. True-positive triggers only when a previous\n1181:           iteration's rendered prompt literally starts with a foreign deep-loop marker,\n1182:           indicating a nested review dispatch.\n1183: \n1184:       step_dispatch_iteration:\n1185:         action: \"Dispatch @deep-review agent for one review iteration\"\n1186:         resolve_executor:\n1187:           source: \"config.executor\"\n1188:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1189:         pre_dispatch:\n1190:           generate_summary: |\n1191:             STATE SUMMARY (auto-generated):\n1192:             Iteration: {current_iteration} of {max_iterations}\n1193:             Dimension: {next_dimension}\n1194:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1195:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1196:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1197:             {resource_map_prompt_line}\n1198:             Coverage Age: {coverage_age}\n1199:             Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1200:             Stuck count: {stuck_count}\n1201:             Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1202:           render_prompt_pack:\n1203:             template_path: \".skilled/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n1204:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1205:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1206:             variables:\n1207:               state_summary: \"{state_summary}\"\n1208:               current_iteration: \"{current_iteration}\"\n1209:               max_iterations: \"{max_iterations}\"\n1210:               next_dimension: \"{next_dimension}\"\n1211:               review_target: \"{review_target}\"\n1212:               review_scope_files: \"{review_scope_files}\"\n1213:               p0_count: \"{p0_count}\"\n1214:               p1_count: \"{p1_count}\"\n1215:               p2_count: \"{p2_count}\"\n1216:               pivot_lineage: \"{pivot_lineage}\"\n1217:               saturated_directions: \"{saturated_directions}\"\n1218:               review_focus_block: \"{review_focus_block}\"\n1219:               state_paths_config: \"{state_paths.config}\"\n1220:               state_paths_state_log: \"{state_paths.state_log}\"\n1221:               state_paths_findings_registry: \"{state_paths.findings_registry}\"\n1222:               state_paths_strategy: \"{state_paths.strategy}\"\n1223:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1224:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1225:         pre_dispatch_audit:\n1226:           skip_when: \"config.executor.kind == 'native'\"\n1227:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1228:           args:\n1229:             stateLogPath: \"{state_paths.state_log}\"\n1230:             executor: \"{config.executor}\"\n1231:             iteration: \"{current_iteration}\"\n1232:         branch_on: \"config.executor.kind\"\n1233:         if_native:\n1234:           dispatch:\n1235:             agent: deep-review\n1236:             model: opus\n1237:             context_source: \"rendered_prompt_pack\"\n1238:           wait_for_completion: true\n1239:         if_cli_copilot:\n1240:           command: |\n1241:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1242:             import { readFileSync, writeFileSync } from 'node:fs';\n1243:             import { createHash } from 'node:crypto';\n1244: \n1245:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1246:             import { buildCopilotPromptArg } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1247: \n1248:             const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';\n1249:             const prompt = readFileSync(promptPath, 'utf8');\n1250: \n1251:             // Workflow-resolved spec folder is the only legal write authority.\n1252:             // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)\n1253:             // is the single source of truth for rejecting empty / unresolved\n1254:             // template / whitespace-only / string-coerced empty values. The\n1255:             // YAML hands the raw `{spec_folder}` directly; on rejection the\n1256:             // helper safe-fails to `type:\"missing\", writeIntent:true` (Gate-3\n1257:             // enforcement, --allow-all-tools stripped).\n1258:             const specFolderRaw = '{spec_folder}';\n1259:             const targetAuthority = { type: 'approved', specFolder: specFolderRaw };\n1260: \n1261:             const baseArgs = [\n1262:               '-p',\n1263:               prompt,\n1264:               '--model',\n1265:               '{config.executor.model}',\n1266:               '--allow-all-tools',\n1267:               '--no-ask-user',\n1268:             ];\n1269: \n1270:             const built = buildCopilotPromptArg({\n1271:               promptPath,\n1272:               prompt,\n1273:               targetAuthority,\n1274:               baseArgv: baseArgs,\n1275:             });\n1276: \n1277:             // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`\n1278:             // containing `<TARGET AUTHORITY preamble>\\n\\n---\\n\\n<original>`.\n1279:             // Write it to disk so the file Copilot reads via @path opens with\n1280:             // the authority block. Without this, recovered/bootstrap folder\n1281:             // mentions inside the file could still anchor the model.\n1282:             if (built.promptFileBody !== undefined) {\n1283:               writeFileSync(promptPath, built.promptFileBody, 'utf8');\n1284:             }\n1285: \n1286:             // Copilot is routed through the audited executor wrapper so it produces\n1287:             // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode\n1288:             // There is no cli-copilot kind in the executor schema, so it\n1289:             // dispatches as kind:'native' (full env passthrough, no recursion-guard\n1290:             // layer configured for copilot); the receipt still records the real\n1291:             // 'copilot' command + built.argv as facts.\n1292:             const dispatchFacts = {\n1293:               command: 'deep/review',\n1294:               mode: 'review',\n1295:               specFolder: '{spec_folder}',\n1296:               artifactDir: '{state_paths.packet_dir}',\n1297:               iteration: Number('{current_iteration}'),\n1298:               executorKind: '{config.executor.kind}',\n1299:               branchId: '{config.executor.kind}',\n1300:               sessionId: '{session_id}',\n1301:               generation: Number('{generation}'),\n1302:             };\n1303:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1304:             process.exit(\n1305:               runAuditedExecutorCommand({\n1306:                 command: 'copilot',\n1307:                 args: built.argv,\n1308:                 cwd: '{repo_root}',\n1309:                 timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1310:                 stateLogPath: '{state_paths.state_log}',\n1311:                 executor: {\n1312:                   kind: 'native',\n1313:                   model: '{config.executor.model}',\n1314:                   configDir: null,\n1315:                   reasoningEffort: null,\n1316:                   serviceTier: null,\n1317:                   sandboxMode: null,\n1318:                   timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1319:                   governor: null,\n1320:                 },\n1321:                 iteration: Number('{current_iteration}'),\n1322:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1323:                 dispatchId,\n1324:               }),\n1325:             );\n1326:             EOF\n1327:           working_directory: \"{repo_root}\"\n1328:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1329:           wait_for_completion: true\n1330:           notes:\n1331:             - \"Routed through runAuditedExecutorCommand so copilot produces INTENT + COMPLETION dispatch receipts; built.argv (@PROMPT_PATH or positional) is forwarded verbatim as the receipt facts\"\n1332:             - \"copilot has no stdin support; prompt is positional\"\n[Output truncated. Continue reading with offset: 1333]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 698-1332\n698:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n699:           - session_id: \"Extract sessionId from deep-review-config.json\"\n700:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n701:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n702:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n703:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n704:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n705:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n706:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n707:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n708:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n709:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n710:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n711:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n712:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n713:           - review_focus_block: \"When deep-review-config.json reviewFocus is a non-empty string, return 'Operator review focus (cover it in addition to the dimension of this iteration, and say in the narrative how you addressed it): <reviewFocus>'. Else return an empty string.\"\n714: \n715:       step_check_pause_sentinel:\n716:         action: \"Check for pause sentinel file\"\n717:         check: \"Does {state_paths.pause_sentinel} exist?\"\n718:         if_exists:\n719:           set:\n720:             pending_stop_event: \"paused\"\n721:             pending_stop_reason: \"userPaused\"\n722:             pending_stop_detail: \"sentinel file detected\"\n723:           skip_to: step_normalize_pause_events\n724:         if_not_exists:\n725:           proceed: true\n726: \n727:       step_validate_convergence_config:\n728:         action: \"Validate convergence mode when loading config\"\n729:         if_convergence_mode_invalid:\n730:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n731:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n732: \n733:       step_graph_convergence:\n734:         action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n735:         inspect:\n736:           - \"{state_paths.state_log}\"\n737:           - \"{state_paths.findings_registry}\"\n738:         transform: |\n739:           1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n740:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n741:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n742:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n743:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n744:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n745:         note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n746:         append_jsonl: '{\"stem\":\"deep_review.graph_convergence_evaluated\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"rawSignals\":{graph_raw_signals_json},\"weightedSignals\":{graph_raw_signals_json},\"dimensionCoverageDigest\":\"{dimension_coverage_digest}\",\"protocolCoverageDigest\":\"{protocol_coverage_digest}\",\"findingStability\":\"{finding_stability}\",\"p0p1ResolutionState\":\"{p0p1_resolution_state}\",\"evidenceDensity\":{evidence_density},\"hotspotSaturation\":{hotspot_saturation},\"decision\":\"{graph_decision_code}\",\"policyFingerprint\":\"{policy_fingerprint}\",\"blockerIds\":{graph_blocker_ids_json},\"stopCandidate\":{stop_candidate},\"graphDecision\":\"{graph_decision_code}\",\"graphDigest\":\"{graph_digest}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json}},\"eventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\"}'\n747:         outputs:\n748:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n749:           - graph_decision_code: \"CONTINUE maps to continue, STOP_ALLOWED to converged, STOP_BLOCKED to blocked\"\n750:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n751:           - graph_raw_signals_json: \"Exact-field convergence-signals JSON built from the convergence.cjs signals; observationDigest is the sha256 of graph_signals_json\"\n752:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n753:           - graph_blocker_ids_json: \"JSON array of blocker type values; use [\\\"graph_blocker\\\"] when the decision is blocked and the list is empty\"\n754:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n755:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n756:           - dimension_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the registry dimensionCoverage map\"\n757:           - protocol_coverage_digest: \"sha256 (64 lowercase hex) of the canonical JSON of the protocol coverage object in graph_signals_json, or of {} when absent\"\n758:           - finding_stability: \"stable when findingStabilityRatio >= convergenceThreshold, unstable when below, unknown when the signal is missing\"\n759:           - p0p1_resolution_state: \"resolved when active P0 + P1 findings are 0, blocked when above 0, unknown when counts are unavailable\"\n760:           - evidence_density: \"evidenceDensityRatio from graph_signals_json, capped at 1\"\n761:           - hotspot_saturation: \"hotspotSaturationRatio from graph_signals_json, between 0 and 1\"\n762:           - policy_fingerprint: \"sha256 (64 lowercase hex) of the canonical JSON {convergenceThreshold, stopPolicy, convergenceMode} from the review config\"\n763:           - stop_candidate: \"true when graph_decision == STOP_ALLOWED, else false\"\n764:           - graph_digest: \"sha256 (64 lowercase hex) of graph_signals_json\"\n765: \n766:       step_check_convergence:\n767:         action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n768:         algorithm: |\n769:           0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n770:              claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n771:              If claim_adjudication_gate_pass == false:\n772:                candidate_decision = \"BLOCKED\"\n773:                stop_blocked = true\n774:                stopReason = \"blockedStop\"\n775:                blocked_gates = [\"claimAdjudicationGate\"]\n776:                recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n777:                Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n778:           1. HARD STOPS:\n779:              a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n780:              b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n781:              c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n782:              Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n783:           2. STUCK DETECTION (threshold 2):\n784:              if stuck_count >= 2: STUCK_RECOVERY\n785:           3. GRAPH CONVERGENCE PREREQUISITE:\n786:                graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n787:                Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n788:                If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n789:           4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n790:                signals = []\n791:                a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n792:                   avg = mean(last 2 newFindingsRatios)\n793:                   stop if avg <= 0.08\n794:                b) MAD noise floor (w=0.25, needs 3+ iterations):\n795:                   noiseFloor = MAD(all ratios) * 1.4826\n796:                   stop if latest ratio <= noiseFloor\n797:                c) Dimension coverage (w=0.45):\n798:                   coverage = dimensions_covered / total_dimensions\n799:                   stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n800:                Redistribute weights for unavailable signals.\n801:                if latest ratio <= 0.05: mark no_progress_threshold_reached\n802:                if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n803:                else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n804:           5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):\n805:                a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score\n806:                b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions\n807:                c) p0ResolutionGate: pass when activeP0 == 0; record activeP0\n808:                d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding\n809:                e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic\n810:                f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count\n811:                g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows\n812:                h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: \"skip\"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = \"candidateCoverageGate\"; recovery_strategy = \"Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence.\"\n813:                i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {\"direct_read\",\"exact_grep\",\"semantic_search\",\"producer_consumer_trace\",\"negative_test_inspection\"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = \"graphlessFallbackGate\"; recovery_strategy = \"Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available.\"\n814:              if STOP is a candidate and any gate fails:\n815:                decision = \"BLOCKED\"\n816:                stop_blocked = true\n817:                stopReason = \"blockedStop\"\n818:                blocked_by_json = JSON array of failing gate names (always include \"claimAdjudicationGate\" when claim_adjudication_gate_pass == false, \"fixCompletenessReplayGate\" when fix_completeness_replay_gate_pass == false, \"candidateCoverageGate\" when candidate_coverage_gate_pass == false, and \"graphlessFallbackGate\" when graphless_fallback_gate_pass == false)\n819:                blocked_by_csv = comma-separated list of failing gate names\n820:                convergence_gate_pass = boolean\n821:                convergence_gate_score = numeric convergence score\n822:                dimension_coverage_gate_pass = boolean\n823:                dimension_coverage_gate_covered_json = JSON array of covered review dimensions\n824:                dimension_coverage_gate_missing_json = JSON array of missing review dimensions\n825:                p0_resolution_gate_pass = boolean\n826:                active_p0_count = number of active P0 findings\n827:                evidence_density_gate_pass = boolean\n828:                avg_evidence_per_finding = numeric evidence density\n829:                hotspot_saturation_gate_pass = boolean\n830:                claim_adjudication_gate_pass = boolean\n831:                claim_adjudication_active_count = numeric count of active P0/P1 at the gate\n832:                fix_completeness_replay_gate_pass = boolean\n833:                security_sensitive_fix_scope = boolean\n834:                fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns\n835:                fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence\n836:                candidate_coverage_gate_pass = boolean\n837:                candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n838:                candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n839:                graphless_fallback_gate_pass = boolean\n840:                graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n841:                graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n842:                graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n843:                recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n844:           6. COMBINED STOP RULE:\n845:                a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n846:                b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n847:                     decision = \"BLOCKED\"\n848:                     stop_blocked = true\n849:                     stopReason = \"blockedStop\"\n850:                     # Blocked-stop closure: blockedBy must be string[] per the\n851:                     # published review blocked-stop contract. Extract the `.type`\n852:                     # field from each structured graph blocker; preserve the full\n853:                     # objects in graph_blocker_detail_json for operator inspection.\n854:                     blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n855:                     blocked_by_csv = graph_blockers_csv\n856:                     graph_blocker_detail_json = graph_blockers_json\n857:                     recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n858:                c) if STOP is legal AND graph_decision == \"CONTINUE\":\n859:                     decision = \"CONTINUE\"\n860:                     stop_blocked = false\n861:                     reason = \"graph_convergence_continue\"\n862:                d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n863:         outputs:\n864:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n865:           - reason: \"Human-readable stop reason\"\n866:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n867:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n868:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n869:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n870:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n871:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n872:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n873:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n874:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n875:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n876:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n877:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n878:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n879:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n880:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n881:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n882:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n883:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n884:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n885:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n886:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n887:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n888:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n889:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n890:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n891:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n892:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n893:           - graph_signals_json: \"JSON object returned by graph convergence\"\n894:           - graph_blockers_json: \"JSON array of graph blockers\"\n895:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n896:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n897:           - recovery_strategy_code: \"Slug form of recovery_strategy for the ledger code fields\"\n898:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), with at least one fail row when decision == BLOCKED\"\n899:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n900: \n901:       step_emit_blocked_stop:\n902:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n903:         if_blocked:\n904:           append_jsonl: '{\"stem\":\"deep_review.blocked_stop_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"blockedGateIds\":{blocked_by_json},\"gateResults\":{gate_results_array_json},\"activeFindingCounts\":{\"candidates\":{active_total_count},\"adjudicated\":{active_total_count},\"p0\":{p0_count},\"p1\":{p1_count},\"p2\":{p2_count}},\"recoveryStrategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{next_dimension}\",\"originatingConvergenceEventId\":\"graph-{session_id}-g{generation}-i{current_iteration}\",\"appendPosition\":{current_iteration},\"gateDetail\":{gate_results_array_json},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryHint\":\"{recovery_strategy}\"}}'\n905:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n906:         if_not_blocked:\n907:           proceed: true\n908: \n909:       step_handle_convergence:\n910:         action: \"Act on convergence decision\"\n911:         if_stop:\n912:           branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n913:           if_divergent_eligible:\n914:             eligibility_contract:\n915:               required_decision: \"STOP\"\n916:               eligible_reasons: [all_dimensions_clean]\n917:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n918:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n919:             steps:\n920:               step_prepare_divergent_pivot:\n921:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n922:                 command: |\n923:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n924:                   import {\n925:                     buildReviewPivotPreparationInput,\n926:                     renderReviewPivotSeatPrompt,\n927:                   } from './.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n928:                   import {\n929:                     preparePivotTransaction,\n930:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n931: \n932:                   const input = buildReviewPivotPreparationInput({\n933:                     artifactRoot: '{state_paths.packet_dir}',\n934:                     configPath: '{state_paths.config}',\n935:                     stateLogPath: '{state_paths.state_log}',\n936:                     strategyPath: '{state_paths.strategy}',\n937:                     registryPath: '{state_paths.findings_registry}',\n938:                     currentIteration: Number('{current_iteration}'),\n939:                     maxIterations: Number('{max_iterations}'),\n940:                     triggerReason: '{reason}',\n941:                   });\n942:                   const prepared = await preparePivotTransaction(input);\n943:                   const seatPrompts = prepared.status === 'pending'\n944:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n945:                         seat.id,\n946:                         renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n947:                       ]))\n948:                     : {};\n949:                   process.stdout.write(`${JSON.stringify({\n950:                     ...prepared,\n951:                     seatPrompts,\n952:                     boundaryRejections: input.boundaryRejections,\n953:                   })}\\n`);\n954:                   EOF\n955:                 working_directory: \"{repo_root}\"\n956:                 outputs:\n957:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n958:                   - pivot_prepare_status: \"status from the prepare result\"\n959:                   - pivot_id: \"pivotId from the prepare result\"\n960:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n961:                   - pivot_resumed: \"resumed from the prepare result\"\n962:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n963:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n964:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n965:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n966:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n967:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n968:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n969:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n970:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n971: \n972:               step_dispatch_pivot_seat_001:\n973:                 action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n974:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n975:                 capture_timing: true\n976:                 if_native:\n977:                   dispatch:\n978:                     agent: deep-review\n979:                     model: opus\n980:                     context_source: \"pivot_seat_001_prompt\"\n981:                   wait_for_completion: true\n982:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n983:                 outputs:\n984:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n985:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n986:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n987:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n988:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n989:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n990: \n991:               step_record_pivot_seat_001:\n992:                 action: \"Durably record the seat-001 native dispatch outcome\"\n993:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n994:                 command: |\n995:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n996:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n997:                   const status = '{pivot_seat_001_dispatch_status}';\n998:                   const outcome = status === 'fulfilled'\n999:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n1000:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n1001:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n1002:                   EOF\n1003:                 working_directory: \"{repo_root}\"\n1004: \n1005:               step_dispatch_pivot_seat_002:\n1006:                 action: \"Natively dispatch the critical read-only review direction-selection seat\"\n1007:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1008:                 capture_timing: true\n1009:                 if_native:\n1010:                   dispatch:\n1011:                     agent: deep-review\n1012:                     model: opus\n1013:                     context_source: \"pivot_seat_002_prompt\"\n1014:                   wait_for_completion: true\n1015:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n1016:                 outputs:\n1017:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n1018:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1019:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n1020:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n1021:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n1022:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n1023: \n1024:               step_record_pivot_seat_002:\n1025:                 action: \"Durably record the seat-002 native dispatch outcome\"\n1026:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n1027:                 command: |\n1028:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1029:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1030:                   const status = '{pivot_seat_002_dispatch_status}';\n1031:                   const outcome = status === 'fulfilled'\n1032:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n1033:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n1034:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n1035:                   EOF\n1036:                 working_directory: \"{repo_root}\"\n1037: \n1038:               step_dispatch_pivot_seat_003:\n1039:                 action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n1040:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1041:                 capture_timing: true\n1042:                 if_native:\n1043:                   dispatch:\n1044:                     agent: deep-review\n1045:                     model: opus\n1046:                     context_source: \"pivot_seat_003_prompt\"\n1047:                   wait_for_completion: true\n1048:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1049:                 outputs:\n1050:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1051:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1052:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1053:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1054:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1055:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1056: \n1057:               step_record_pivot_seat_003:\n1058:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1059:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1060:                 command: |\n1061:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1062:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1063:                   const status = '{pivot_seat_003_dispatch_status}';\n1064:                   const outcome = status === 'fulfilled'\n1065:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1066:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1067:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1068:                   EOF\n1069:                 working_directory: \"{repo_root}\"\n1070: \n1071:               step_finalize_divergent_pivot:\n1072:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1073:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1074:                 command: |\n1075:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1076:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1077:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1078:                   EOF\n1079:                 working_directory: \"{repo_root}\"\n1080:                 outputs:\n1081:                   - pivot_finalize_json: \"The complete parsed final result\"\n1082: \n1083:               step_resolve_divergent_pivot_result:\n1084:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1085:                 branch_on: \"pivot_prepare_status\"\n1086:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1087:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1088: \n1089:               step_apply_divergent_pivot_result:\n1090:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1091:                 branch_on: \"pivot_result.status\"\n1092:                 if_completed:\n1093:                   set:\n1094:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1095:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1096:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1097:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1098:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1099:                   proceed_to: step_normalize_pause_events\n1100:                 if_failed:\n1101:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1102:                   skip_to: phase_synthesis\n1103:             on_error:\n1104:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1105:               skip_to: phase_synthesis\n1106:           if_existing_terminal_path:\n1107:             log: \"Loop stopping. Reason: {reason}\"\n1108:             skip_to: phase_synthesis\n1109:         if_blocked:\n1110:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1111:         if_stuck_recovery:\n1112:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1113:           recovery_strategies:\n1114:             - \"Change granularity: file-level → function-level → line-level review\"\n1115:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1116:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1117:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1118:           set:\n1119:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1120:             pending_stop_event: \"stuck_recovery\"\n1121:             pending_stop_reason: \"stuckRecovery\"\n1122:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1123:           reset: { stuck_count: 0 }\n1124:         if_continue:\n1125:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1126: \n1127:       step_normalize_pause_events:\n1128:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n1129:         if_pending_pause_event:\n1130:           append_jsonl: '{\"stem\":\"deep_review.pause_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"normalizedStopReason\":\"userPaused\",\"sentinelCause\":\"sentinel-file-detected\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"await-operator-resume\",\"targetDimensionId\":\"{next_dimension}\",\"outcome\":\"paused\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\"}}'\n1131:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n1132:           reset:\n1133:             pending_stop_event: null\n1134:             pending_stop_reason: null\n1135:             pending_stop_detail: null\n1136:           halt: true\n1137:         if_pending_stuck_recovery:\n1138:           append_jsonl: '{\"stem\":\"deep_review.recovery_started\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\",\"dimensionId\":\"{least_explored}\"},\"data\":{\"normalizedStopReason\":\"stuckRecovery\",\"recoveryCause\":\"repeated-no-progress\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{least_explored}\",\"outcome\":\"recovery-started\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\",\"originatingPauseEventId\":\"none\"}}'\n1139:           reset:\n1140:             pending_stop_event: null\n1141:             pending_stop_reason: null\n1142:             pending_stop_detail: null\n1143:         if_no_pending_event:\n1144:           proceed: true\n1145:         outputs:\n1146:           - prior_tail_digest: \"sha256 (64 lowercase hex) of the state log bytes at the moment the pause or recovery row is emitted\"\n1147: \n1148:       step_generate_state_summary:\n1149:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1150:         generate: |\n1151:           STATE SUMMARY (auto-generated):\n1152:           Iteration: {current_iteration} of {max_iterations}\n1153:           Dimension: {next_dimension}\n1154:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1155:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1156:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1157:           {resource_map_prompt_line}\n1158:           Coverage Age: {coverage_age}\n1159:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1160:           Stuck count: {stuck_count}\n1161:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1162: \n1163:       step_marker_scan:\n1164:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1165:         canonical_header: \"DEEP-REVIEW\"\n1166:         nested_marker_pattern: \"^(DEEP-RESEARCH|CODE-REVIEW)$\"\n1167:         algorithm: |\n1168:           if current_iteration > 1:\n1169:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1170:             if file_exists(PREV_PROMPT_PATH):\n1171:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1172:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1173:                 log \"ERROR: nested review loop detected (foreign deep-loop marker found in previous iteration prompt). Aborting.\"\n1174:                 halt with exit code 2\n1175:         note: |\n1176:           False-positive prevention: a review prompt that starts with its own canonical\n1177:           header is this loop's own iteration output, never a nested dispatch; only a\n1178:           foreign marker (DEEP-RESEARCH or CODE-REVIEW) is, so the guard matches\n1179:           nested_marker_pattern rather than the canonical header. Markers appearing in\n1180:           comments or body text are ignored. True-positive triggers only when a previous\n1181:           iteration's rendered prompt literally starts with a foreign deep-loop marker,\n1182:           indicating a nested review dispatch.\n1183: \n1184:       step_dispatch_iteration:\n1185:         action: \"Dispatch @deep-review agent for one review iteration\"\n1186:         resolve_executor:\n1187:           source: \"config.executor\"\n1188:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1189:         pre_dispatch:\n1190:           generate_summary: |\n1191:             STATE SUMMARY (auto-generated):\n1192:             Iteration: {current_iteration} of {max_iterations}\n1193:             Dimension: {next_dimension}\n1194:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1195:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1196:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1197:             {resource_map_prompt_line}\n1198:             Coverage Age: {coverage_age}\n1199:             Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1200:             Stuck count: {stuck_count}\n1201:             Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1202:           render_prompt_pack:\n1203:             template_path: \".skilled/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n1204:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1205:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1206:             variables:\n1207:               state_summary: \"{state_summary}\"\n1208:               current_iteration: \"{current_iteration}\"\n1209:               max_iterations: \"{max_iterations}\"\n1210:               next_dimension: \"{next_dimension}\"\n1211:               review_target: \"{review_target}\"\n1212:               review_scope_files: \"{review_scope_files}\"\n1213:               p0_count: \"{p0_count}\"\n1214:               p1_count: \"{p1_count}\"\n1215:               p2_count: \"{p2_count}\"\n1216:               pivot_lineage: \"{pivot_lineage}\"\n1217:               saturated_directions: \"{saturated_directions}\"\n1218:               review_focus_block: \"{review_focus_block}\"\n1219:               state_paths_config: \"{state_paths.config}\"\n1220:               state_paths_state_log: \"{state_paths.state_log}\"\n1221:               state_paths_findings_registry: \"{state_paths.findings_registry}\"\n1222:               state_paths_strategy: \"{state_paths.strategy}\"\n1223:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1224:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1225:         pre_dispatch_audit:\n1226:           skip_when: \"config.executor.kind == 'native'\"\n1227:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1228:           args:\n1229:             stateLogPath: \"{state_paths.state_log}\"\n1230:             executor: \"{config.executor}\"\n1231:             iteration: \"{current_iteration}\"\n1232:         branch_on: \"config.executor.kind\"\n1233:         if_native:\n1234:           dispatch:\n1235:             agent: deep-review\n1236:             model: opus\n1237:             context_source: \"rendered_prompt_pack\"\n1238:           wait_for_completion: true\n1239:         if_cli_copilot:\n1240:           command: |\n1241:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1242:             import { readFileSync, writeFileSync } from 'node:fs';\n1243:             import { createHash } from 'node:crypto';\n1244: \n1245:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1246:             import { buildCopilotPromptArg } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1247: \n1248:             const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';\n1249:             const prompt = readFileSync(promptPath, 'utf8');\n1250: \n1251:             // Workflow-resolved spec folder is the only legal write authority.\n1252:             // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)\n1253:             // is the single source of truth for rejecting empty / unresolved\n1254:             // template / whitespace-only / string-coerced empty values. The\n1255:             // YAML hands the raw `{spec_folder}` directly; on rejection the\n1256:             // helper safe-fails to `type:\"missing\", writeIntent:true` (Gate-3\n1257:             // enforcement, --allow-all-tools stripped).\n1258:             const specFolderRaw = '{spec_folder}';\n1259:             const targetAuthority = { type: 'approved', specFolder: specFolderRaw };\n1260: \n1261:             const baseArgs = [\n1262:               '-p',\n1263:               prompt,\n1264:               '--model',\n1265:               '{config.executor.model}',\n1266:               '--allow-all-tools',\n1267:               '--no-ask-user',\n1268:             ];\n1269: \n1270:             const built = buildCopilotPromptArg({\n1271:               promptPath,\n1272:               prompt,\n1273:               targetAuthority,\n1274:               baseArgv: baseArgs,\n1275:             });\n1276: \n1277:             // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`\n1278:             // containing `<TARGET AUTHORITY preamble>\\n\\n---\\n\\n<original>`.\n1279:             // Write it to disk so the file Copilot reads via @path opens with\n1280:             // the authority block. Without this, recovered/bootstrap folder\n1281:             // mentions inside the file could still anchor the model.\n1282:             if (built.promptFileBody !== undefined) {\n1283:               writeFileSync(promptPath, built.promptFileBody, 'utf8');\n1284:             }\n1285: \n1286:             // Copilot is routed through the audited executor wrapper so it produces\n1287:             // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode\n1288:             // There is no cli-copilot kind in the executor schema, so it\n1289:             // dispatches as kind:'native' (full env passthrough, no recursion-guard\n1290:             // layer configured for copilot); the receipt still records the real\n1291:             // 'copilot' command + built.argv as facts.\n1292:             const dispatchFacts = {\n1293:               command: 'deep/review',\n1294:               mode: 'review',\n1295:               specFolder: '{spec_folder}',\n1296:               artifactDir: '{state_paths.packet_dir}',\n1297:               iteration: Number('{current_iteration}'),\n1298:               executorKind: '{config.executor.kind}',\n1299:               branchId: '{config.executor.kind}',\n1300:               sessionId: '{session_id}',\n1301:               generation: Number('{generation}'),\n1302:             };\n1303:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1304:             process.exit(\n1305:               runAuditedExecutorCommand({\n1306:                 command: 'copilot',\n1307:                 args: built.argv,\n1308:                 cwd: '{repo_root}',\n1309:                 timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1310:                 stateLogPath: '{state_paths.state_log}',\n1311:                 executor: {\n1312:                   kind: 'native',\n1313:                   model: '{config.executor.model}',\n1314:                   configDir: null,\n1315:                   reasoningEffort: null,\n1316:                   serviceTier: null,\n1317:                   sandboxMode: null,\n1318:                   timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1319:                   governor: null,\n1320:                 },\n1321:                 iteration: Number('{current_iteration}'),\n1322:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1323:                 dispatchId,\n1324:               }),\n1325:             );\n1326:             EOF\n1327:           working_directory: \"{repo_root}\"\n1328:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1329:           wait_for_completion: true\n1330:           notes:\n1331:             - \"Routed through runAuditedExecutorCommand so copilot produces INTENT + COMPLETION dispatch receipts; built.argv (@PROMPT_PATH or positional) is forwarded verbatim as the receipt facts\"\n1332:             - \"copilot has no stdin support; prompt is positional\"\n[Output truncated. Continue reading with offset: 1333]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\",\"offset\":698,\"limit\":800}"},"time":{"start":1794074018097,"end":1794074020652}}}}
