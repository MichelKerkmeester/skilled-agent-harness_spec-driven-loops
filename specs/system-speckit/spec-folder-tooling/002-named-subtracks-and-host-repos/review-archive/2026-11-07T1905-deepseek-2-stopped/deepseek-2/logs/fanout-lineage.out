Folder\": \"system-speckit\",\n  \"description\": \"The `system-speckit` spec-kit subsystem owns a long lineage of spec folders — the graph/context and memory-search optimization research, phased-spec\",\n  \"keywords\": [\n    \"system-speckit\",\n    \"spec-kit\",\n    \"subsystem\",\n    \"owns\",\n    \"long\",\n    \"lineage\",\n    \"spec\",\n    \"folders\",\n    \"graph\",\n    \"context\",\n    \"memory-search\",\n    \"optimization\",\n    \"research\",\n    \"phased-spec\"\n  ],\n---generate desc script flags---\n8:// Usage: node generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]\n26:            return resolveSpecFolderIdentity(folderPath).specFolder;\n38:// The level is required of every description record, but it used to be written\n41:// broke it. So fall back to what the record already carries, then to the level\n46:    const carried = existing?.level;\n66:        console.error('Usage: generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]');\n69:    // Options begin at index 2, and the token after --description or --level is\n74:        if (token === '--description' || token === '--level') {\n80:            console.error('Usage: generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]');\n102:    const levelIdx = args.indexOf('--level');\n103:    const explicitLevel = levelIdx !== -1 && args[levelIdx + 1] ? args[levelIdx + 1] : null;\n111:        const specId = numMatch ? numMatch[1] : '';\n115:        const specFolder = resolveSpecFolderForDescription(folderPath, normalizedRelativeFolder);\n116:        const parentChain = specFolder.split('/').filter(Boolean).slice(0, -1);\n118:            specFolder,\n122:            specId,\n128:                const level = resolveLevel(folderPath, explicitLevel, existingData);\n129:                return level ? { level } : {};\n138:            const level = resolveLevel(folderPath, explicitLevel, prior.ok ? prior.d