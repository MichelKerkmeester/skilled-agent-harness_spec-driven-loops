oot', () => {\n466:    const destination = path.join(tree.specs, 'demo', '003-from-subtrack');\n468:    const graph = moveAndRepair(tree.entries.nested, destination);\n470:    expect(graph.parent_id).toBeNull();\n471:    expect(graph.parent_id_review_required).toBeUndefined();\n474:  it('updates the parent when a packet moves between declared sub-tracks', () => {\n478:    const destination = path.join(other, '001-moved-probe');\n480:    const graph = moveAndRepair(tree.entries.nested, destination);\n482:    expect(graph.parent_id).toBe('demo/other');\n483:    expect(graph.parent_id_review_required).toBeUndefined();\n487:  // set, is waiting for a person: a repair that touches nothing of a sub-track\n494:    fs.writeFileSync(graphPath, `${JSON.stringify({ ...seeded, parent_id_review_required: true }, null, 2)}\\n`);\n497:    const graph = moveAndRepair(tree.entries.flat, destination);\n499:    expect(graph.parent_id).toBe('demo');\n500:    expect(graph.parent_id_review_required).toBe(true);\n503:  it('keeps an old parent flagged for review when a packet moves to an undeclared folder', () => {\n506:    const destination = path.join(tree.entries.loose, '001-moved-probe');\n508:    const graph = moveAndRepair(tree.entries.nested, destination);\n510:    expect(graph.parent_id).toBe('demo/sub');\n511:    expect(graph.parent_id_review_required).toBe(true);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"20:import { buildSubtrackTree } from './fixtures/subtrack-tree.mjs';\n41:  // Remove the tool-tree link before the recursive remove so it never walks into the real tree. Without recursive, rmSync removes the link itself, and force tolerates setup that failed before the link existed.\n267:    parent_id: parentId,\n294:    level: 'sub-track',\n296:    description: 'Fixture sub-track.',\n302:    parent_id: 'demo',\n305:    derived: { trigger_phrases: [], key_topics: [specFolder], causal_summary: 'Fix