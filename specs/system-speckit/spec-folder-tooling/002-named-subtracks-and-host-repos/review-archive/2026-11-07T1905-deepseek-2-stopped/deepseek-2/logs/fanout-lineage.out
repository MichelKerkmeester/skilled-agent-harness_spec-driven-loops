chema/deep-review-ledger-types.ts:530:  readonly type: 'iteration';\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:531:  readonly iteration: Uint32;\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:550:// A review iteration record reaches the gateway whole. Its optional fields vary with the review\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:552:// the same `type: \"iteration\"` row the reducer counts.\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:590:  'deep_review.iteration_recorded',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:611:  'deep_review.dimension_pass_started': { status: 'reserved', reason: 'No writer emits it today: a pass opens implicitly in the iteration record. A pass-lifecycle step would speak it once each pass opens its own event.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:612:  'deep_review.dimension_pass_completed': { status: 'reserved', reason: 'No writer emits it today: pass completion folds from the iteration row. A pass-lifecycle step would speak it once a pass closes with coverage and finding counts.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:613:  'deep_review.finding_candidate_emitted': { status: 'reserved', reason: 'No writer emits it today: candidates live in iteration prose and delta rows. The adjudication step would speak it once candidates enter the ledger as typed events.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:614:  'deep_review.evidence_observed': { status: 'reserved', reason: 'No writer emits it today: evidence stays in iteration files. An evidence step would speak it once captured evidence is appended for reconciliation.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:637:  'deep_review.iteration_recorded': { status: 'spoken', producers: ['.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs'] },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:672:  'deep_review.iteration_error': 'deep-review.ledger.iteration-error',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:673:  'deep_review.iteration_recorded': 'deep-review.ledger.iteration-recorded',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:712:  readonly 'deep_review.iteration_recorded': IterationRecordedData;\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:748:  readonly 'deep_review.iteration_recorded': DeepReviewBaseScope;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts:438:    iteration: 'uint32',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts:484:    type: enumRule('iteration'),\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts:485:    iteration: 'uint32',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts:503:  'deep_review.iteration_recorded': {\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts:574:  'deep_review.iteration_recorded': ['runId', 'sessionId'],\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:471:  readonly iteration: Uint32;\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:526:// A review lane that produced no iteration file still owes the reducer an\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:527:// iteration row, so this payload carries `type` explicitly: the projected row\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:528:// has to stay `type: \"iteration\"` or the iteration vanishes from every count.\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:530:  readonly type: 'iteration';\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:531:  readonly iteration: Uint32;\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:550:// A review iteration record reaches the gateway whole. Its optional fields vary with the review\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:552:// the same `type: \"iteration\"` row the reducer counts.\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:590:  'deep_review.iteration_recorded',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:611:  'deep_review.dimension_pass_started': { status: 'reserved', reason: 'No writer emits it today: a pass opens implicitly in the iteration record. A pass-lifecycle step would speak it once each pass opens its own event.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:612:  'deep_review.dimension_pass_completed': { status: 'reserved', reason: 'No writer emits it today: pass completion folds from the iteration row. A pass-lifecycle step would speak it once a pass closes with coverage and finding counts.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:613:  'deep_review.finding_candidate_emitted': { status: 'reserved', reason: 'No writer emits it today: candidates live in iteration prose and delta rows. The adjudication step would speak it once candidates enter the ledger as typed events.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:614:  'deep_review.evidence_observed': { status: 'reserved', reason: 'No writer emits it today: evidence stays in iteration files. An evidence step would speak it once captured evidence is appended for reconciliation.' },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:637:  'deep_review.iteration_recorded': { status: 'spoken', producers: ['.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs'] },\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:672:  'deep_review.iteration_error': 'deep-review.ledger.iteration-error',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:673:  'deep_review.iteration_recorded': 'deep-review.ledger.iteration-recorded',\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:712:  readonly 'deep_review.iteration_recorded': IterationRecordedData;\n.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts:748:  readonly 'deep_review.iteration_recorded': DeepReviewBaseScope;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/MEGA/Development/Skilled && grep -rn \\\"iteration_recorded\\\\|iteration\\\\b\\\" .skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/*.ts | head -40\"}"},"time":{"start":1794074256344,"end":1794074260331}}}}
