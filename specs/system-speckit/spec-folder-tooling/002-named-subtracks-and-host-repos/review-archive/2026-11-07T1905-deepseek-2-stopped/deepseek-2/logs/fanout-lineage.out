  wait_for_completion: true\n1942:           notes:\n1943:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1944:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1945:         if_cli_pi:\n1946:           command: |\n1947:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1948:             import { readFileSync } from 'node:fs';\n1949:             import { createRequire } from 'node:module';\n1950:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1951:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1952:             import {\n1953:               snapshotOutOfScopeDirtyPaths,\n1954:               enforceWriteContainment,\n1955:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1956: \n1957:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1958:             // without this they silently degrade to native. The command builder is the\n1959:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1960:             // headless write-mode flags, and binary preflight stay one source of truth.\n1961:             // It throws (fail closed) when the binary is absent or the model is off the\n1962:             // allowlist, so a requested CLI executor never becomes native.\n1963:             const require = createRequire(import.meta.url);\n1964:             const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1965: \n1966:             const kind = '{config.executor.kind}';\n1967:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1968:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1969:             // The iteration must write its own iteration file, delta and state record,\n1970:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1971:             // write-permitting headless flags.\n1972:             const sandboxMode = 'workspace-write';\n1973:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1974:             const lineage = { kind, model, sandboxMode, reasoningEffort };\n1975:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1976:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1977: \n1978:             const repoRoot = '{repo_root}';\n1979:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1980:             const { command, args, input } = buildLineageCommand(\n1981:               lineage,\n1982:               promptBody,\n1983:               resolvedSandbox,\n1984:               resolvedPermission,\n1985:               { env: process.env, cwd: repoRoot },\n1986:             );\n1987: \n1988:             const executor = {\n1989:               kind,\n1990:               model,\n1991:               configDir: null,\n1992:               reasoningEffort,\n1993:               serviceTier: null,\n1994:               sandboxMode,\n1995:               timeoutSeconds,\n1996:               governor: null,\n1997:             };\n1998:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1999:             const artifactDir = '{artifact_dir}';\n2000:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n2001:             const dispatchExit = runAuditedExecutorCommand({\n2002:               command,\n2003:               args,\n2004:               cwd: repoRoot,\n2005:               timeoutSeconds,\n2006:               stateLogPath: '{state_paths.state_log}',\n2007:               executor,\n2008:               iteration: Number('{current_iteration}'),\n2009:               input,\n2010:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n2011:               dispatchId,\n2012:             });\n2013:             const containment = enforceWriteContainment({\n2014:               repoRoot,\n2015:               artifactDir,\n2016:               preDispatchDirtyPaths,\n2017:               stateLogPath: '{state_paths.state_log}',\n2018:               iteration: Number('{current_iteration}'),\n2019:               label: dispatchId,\n2020:             });\n2021:             if (containment.violations.length > 0) {\n2022:               console.error(\n2023:                 'write-containment advisory: detected ' + containment.violations.length\n2024:                   + ' out-of-scope path(s), left on disk: '\n2025:                   + containment.violations.map((v) => v.path).join(', '),\n2026:               );\n2027:             }\n2028:             // A path that was already dirty before the dispatch and changed during it is held out of\n2029:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n2030:             // this prints it so the run's own output says so too.\n2031:             if (containment.contested.length > 0) {\n2032:               console.error(\n2033:                 'write-containment contested: ' + containment.contested.length\n2034:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n2035:                   + containment.contested.map((v) => v.path).join(', ')\n2036:                   + '\\n' + containment.contestedNote,\n2037:               );\n2038:             }\n2039:             process.exit(dispatchExit);\n2040:             EOF\n2041:           working_directory: \"{repo_root}\"\n2042:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n2043:           wait_for_completion: true\n2044:           notes:\n2045:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n2046:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n2047:             - \"cli-deepseek-harness single-executor (experimental, never a default): the same shared builder emits `dsh --profile headless` with the route, lineage and guards patches, `--json` and the prompt on stdin, from the lineage directory with a fresh DSH_HOME; fails closed when dsh is absent, its version is not the pinned release, the model is off the two-id roster or the guards patch is missing\"\n2048:         post_dispatch_validate:\n2049:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n2050:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n2051:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|iteration_verdict_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n2052:           assert_exists: \"{state_paths.iteration_pattern}\"\n2053:           assert_appended: \"{state_paths.state_log}\"\n2054:           assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n2055:           route_proof:\n2056:             mode: review\n2057:             target_agent: deep-review\n2058:             agent_definition_loaded: true\n2059:             resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n2060:           dispatchReceipt:\n2061:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n2062:             dispatchId: \"review-i{current_iteration}-g{generation}\"\n2063:           assert_canonical_type: \"iteration\"\n2064:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n2065:           assert_delta_file_has_iteration_record: true\n2066:           failure_reasons:\n2067:             - iteration_file_missing\n2068:             - iteration_file_empty\n2069:             - jsonl_not_appended\n2070:             - jsonl_missing_fields\n2071:             - jsonl_parse_error\n2072:             - jsonl_wrong_type\n2073:             - delta_file_missing\n2074:             - delta_file_empty\n2075:             - delta_file_missing_iteration_record\n2076:             - executor_missing\n2077:             - dispatch_failure_logged\n2078:             - v2_missing_ledger\n2079:             - v2_uncited_ledger_row\n2080:             - v2_broken_linked_finding\n2081:             - v2_shallow_finding_details\n2082:             - delta_iteration_id_mismatch\n2083:             - state_delta_iteration_mismatch\n2084:             - route_proof_missing\n2085:             - route_proof_mismatch\n2086:           warning_surface:\n2087:             source: \"result.warnings\"\n2088:             action: \"emit schema_advisory canonical conflict event\"\n2089:             severity: \"advisory\"\n2090:             event_shape: '{\"type\":\"event\",\"event\":\"schema_advisory\",\"mode\":\"review\",\"iteration\":{current_iteration},\"warnings\":{result.warnings},\"severity\":\"advisory\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2091:             note: \"Warnings do not fail dispatch. Hard failures still emit schema_mismatch through on_failure.\"\n2092:           on_failure:\n2093:             action: \"emit schema_mismatch canonical conflict event\"\n2094:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error (per step_evaluate_results.on_missing_outputs) and continue. Never re-dispatch a given iteration more than once.\"\n2095:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n2096:         record_executor_audit:\n2097:           skip_when: \"config.executor.kind == 'native'\"\n2098:           target: \"{state_paths.state_log}\"\n2099:           field: \"executor\"\n2100:           value:\n2101:             kind: \"{config.executor.kind}\"\n2102:             model: \"{config.executor.model}\"\n2103:             reasoningEffort: \"{config.executor.reasoningEffort}\"\n2104:             serviceTier: \"{config.executor.serviceTier}\"\n2105: \n2106:       step_evaluate_results:\n2107:         action: \"Verify iteration outputs and extract metrics\"\n2108:         verify:\n2109:           - file_exists: \"{state_paths.iteration_pattern}\"\n2110:           - jsonl_appended: \"New iteration record in state.jsonl\"\n2111:           - strategy_updated: \"Strategy.md has been modified\"\n2112:         extract:\n2113:           - newFindingsRatio: \"From latest JSONL iteration record\"\n2114:           - findings_count: \"From latest JSONL iteration record\"\n2115:           - severity_counts: \"From latest JSONL iteration record (P0, P1, P2)\"\n2116:           - dimensions: \"From latest JSONL iteration record\"\n2117:           - files_reviewed: \"From latest JSONL iteration record\"\n2118:           - status: \"From latest JSONL iteration record\"\n2119:           - reviewed_artifacts: \"From latest JSONL iteration record\"\n2120:           - traceability_checks: \"From latest JSONL iteration record when present\"\n2121:         on_missing_outputs:\n2122:           action: \"Mark iteration as 'error', continue to next\"\n2123:           # Canonical iteration record: include sessionId, generation, durationMs so the reducer can\n2124:           # persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n2125:           # The row is staged for the append gateway: the state log is a projection of the\n2126:           # ledger, so a directly appended error row is dropped by the next refresh.\n2127:           command: |\n2128:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2129:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2130:             EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-review-iteration-error.XXXXXX\")\"\n2131:             cat <<'DEEP_LOOP_STATE_RECORD' > \"$EVENT_FILE\"\n2132:             {\"stem\":\"deep_review.iteration_error\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"review\",\"status\":\"error\",\"focus\":\"{next_dimension}\",\"dimensions\":[\"{next_dimension}\"],\"filesReviewed\":[],\"findingsCount\":0,\"findingsSummary\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingsNew\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingDetails\":[],\"traceabilityChecks\":{\"summary\":{\"required\":0,\"executed\":0,\"pass\":0,\"partial\":0,\"fail\":0,\"blocked\":0,\"notApplicable\":0,\"gatingFailures\":0},\"results\":[]},\"newFindingsRatio\":0.0,\"durationMs\":0,\"sessionId\":\"{config.sessionId}\",\"generation\":{config.generation},\"lineageMode\":\"{config.lineageMode}\"}}\n2133:             DEEP_LOOP_STATE_RECORD\n2134:             node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n2135:             RECORD_STATUS=$?\n2136:             rm -f \"$EVENT_FILE\"\n2137:             exit \"$RECORD_STATUS\"\n2138: \n2139:       step_post_iteration_claim_adjudication:\n2140:         action: \"Validate typed claim-adjudication packets for any new P0/P1 findings and persist the result to state.jsonl so the next iteration's claimAdjudicationGate can read it\"\n2141:         verify:\n2142:           - typed_packets_present: \"Every new P0/P1 finding in review/iterations/iteration-{NNN}.md contains a claim-adjudication JSON block\"\n2143:           - packet_fields: \"Each packet includes claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger\"\n2144:           - missing_packet_ids: \"List of new P0/P1 finding IDs that are missing a typed packet or field; empty array when all packets validate\"\n2145:         on_pass:\n2146:           set:\n2147:             claim_adjudication_passed: true\n2148:           # The row is staged as a canonical ledger event and appended by the gateway:\n2149:           # the state log is a projection of the ledger, so a write beside it is dropped\n2150:           # by the next refresh.\n2151:           command: |\n2152:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2153:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2154:             EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-review-claim-adjudication.XXXXXX\")\"\n2155:             cat <<'DEEP_LOOP_STATE_RECORD' > \"$EVENT_FILE\"\n2156:             {\"stem\":\"deep_review.claim_adjudication\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\"},\"data\":{\"mode\":\"review\",\"run\":{current_iteration},\"passed\":true,\"activeP0P1\":{active_p0_p1_count},\"missingPackets\":[],\"reason\":null,\"sessionId\":\"{session_id}\",\"generation\":{generation}}}\n2157:             DEEP_LOOP_STATE_RECORD\n2158:             node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n2159:             RECORD_STATUS=$?\n2160:             rm -f \"$EVENT_FILE\"\n2161:             exit \"$RECORD_STATUS\"\n2162:           log: \"Claim adjudication passed for iteration {current_iteration}. All new P0/P1 findings have typed packets.\"\n2163:         on_fail:\n2164:           action: \"Mark the iteration as invalid for convergence. The next iteration's claimAdjudicationGate (step_check_convergence step 0) reads the persisted `passed: false` event and vetoes STOP until a follow-up iteration rewrites the packets.\"\n2165:           set:\n2166:             claim_adjudication_passed: false\n2167:           command: |\n2168:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2169:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n[Output truncated. Continue reading with offset: 2170]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":900,\"offset\":1333,\"path\":\".skilled/commands/deep/assets/deep-review-auto.yaml\"}"},"time":{"start":1794074056731,"end":1794074057742}}}}
