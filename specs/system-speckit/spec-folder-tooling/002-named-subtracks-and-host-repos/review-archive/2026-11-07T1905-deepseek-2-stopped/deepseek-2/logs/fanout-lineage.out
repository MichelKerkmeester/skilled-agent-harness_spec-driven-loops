rySource) {\n565:function hasHostRelativeLink(directory, entrySource, sourceRelative) {\n569:    if (isHostRelativeLink(child, entrySource)) return true;\n572:      && hasHostRelativeLink(child, entrySource, path.join(sourceRelative, name))) return true;\n586:function inspectMergeTree(root, source, rootRelative, sourceRelative, entrySource, details) {\n606:    if (isHostRelativeLink(childSource, entrySource)) {\n634:      inspectMergeTree(root, source, childRootRelative, childSourceRelative, entrySource, details);\n709:    inspectMergeTree(root, source, entry.name, entry.source || entry.name, sourcePath, details);\n794:function planMergeTree(root, source, rootRelative, sourceRelative, entrySource, actions, ignoreCandidates) {\n814:    if (isHostRelativeLink(childSource, entrySource)) {\n841:      planMergeTree(root, source, childRootRelative, childSourceRelative, entrySource, actions, ignoreCandidates);\n905:        || hasHostRelativeLink(sourcePath, sourcePath, entry.source || entry.name));\n908:        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name,\n938:        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/MEGA/Development/Skilled && grep -n \\\"specs alias\\\\|hasHostRelativeLink\\\\|isHostRelativeLink\\\\|inspectMergeTree\\\\|planMergeTree\\\" .skilled/commands/doctor/scripts/symlink-engine.cjs | head -30\"}"},"time":{"start":1794077352202,"end":1794077353405}}}}
