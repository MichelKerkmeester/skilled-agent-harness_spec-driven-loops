ue;\n---GEN---\n5:// Walks the documentation corpus, reads the trigger-phrase frontmatter out of\n7:// plus the manifest and diagnostics that describe the snapshot it was built\n21:// integer, per-phrase token lists are left to be re-derived from the key, and\n22:// raw phrase spellings move to a diagnostics fixture. Nothing stored here\n23:// exists to answer partial substrings: the lookup scans the phrase keys, which\n30://   node generate-trigger-index.mjs [--repo-root <path>] [--allow-malformed] [--json] [--quiet]\n31://   node generate-trigger-index.mjs --out <path> [--manifest <path>] [--diagnostics <path>]\n33://   node generate-trigger-index.mjs --check [--repo-root <path>] [--out <path>] [--json] [--quiet]\n35:// --out alone puts corpus-manifest.json, generation-diagnostics.json and\n36:// phrase-variants.json beside it. --check compares the index at --out, or the\n39:// Exit codes: 0 = published (--check: index matches the corpus), 1 = malformed corpus, nothing\n40:// published (--check: a document is stale, an index path left the corpus, or the corpus is\n41:// untrusted), 2 = bad invocation or, for --check, an unreadable index.\n56:import { judgeTriggerPhrase } from './lib/phrase-judge.mjs';\n78:export const DEFAULT_MANIFEST_PATH = path.join(SCRIPT_DIR, 'fixtures', 'corpus-manifest.json');\n80:export const DEFAULT_VARIANTS_PATH = path.join(SCRIPT_DIR, 'fixtures', 'phrase-variants.json');\n115: * Reads the corpus and assembles the artifact, the manifest, the diagnostics\n125: *   manifest: Record<string, unknown>,\n144:  const phrases = new Map();\n150:  let phraseDeclarations = 0;\n190:    for (const phrase of parsed.phrases) {\n191:      phraseDeclarations += 1;\n192:      let entry = phrases.get(phrase.normalized);\n195:        phrases.set(phrase.normalized, entry);\n198:      entry.raw.add(phrase.raw);\n205:  const sortedPhrases = Array.from(phrases.entries())\n208:  // Only paths that own a phrase are interned. The rest of the corpus is\n209:  // already enumerated by the manifest, and carrying it twice would grow the\n218:  const manifestIdentity = {\n227:  const manifestHash = sha256(stableStringify(manifestIdentity));\n229:  const manifest = {\n230:    ...manifestIdentity,\n233:    manifestHash,\n235:    // Left null so the manifest hash stays stable when that value lands.\n241:    manifestHash,\n244:    phrases: Object.fromEntries(\n254:  // convention bans single-token, numeric-only, generic and stop-word phrases,\n262:  // `documents` counts each owner under its own class, and `phrases` counts the\n263:  // phrase once, as folder-token-fallback when any owner's folder repeats it.\n264:  const phraseQualityPhrases = {};\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/MEGA/Development/Skilled && grep -n \\\"\\\\-\\\\-index\\\\|--out\\\\|--check\\\\|--repo-root\\\" .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs | head -20; echo \\\"---GEN---\\\"; grep -n \\\"\\\\-\\\\-out\\\\|--check\\\\|--repo-root\\\\|manifest\\\\|phrase\\\" .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs | head -40\"}"},"time":{"start":1794075636090,"end":1794075640946}}}}
