{"type":"tool_use","timestamp":1794075537934,"sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","part":{"partID":"prt_1b73c286c001tS7v29PLTUdVE8","sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","messageID":"msg_1b73bc662001m9JMidl2RviUXr","type":"tool","id":"call_d34d14a631284d09bdec6b28","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled && git diff ac32d66fed..7714ff26b1 -- .skilled/commands/doctor/assets/symlink-manifest.json .skilled/commands/doctor/scripts/symlink-engine.cjs"},"output":"diff --git a/.skilled/commands/doctor/assets/symlink-manifest.json b/.skilled/commands/doctor/assets/symlink-manifest.json\nindex be8e8ba40d..d487ba19f8 100644\n--- a/.skilled/commands/doctor/assets/symlink-manifest.json\n+++ b/.skilled/commands/doctor/assets/symlink-manifest.json\n@@ -13,7 +13,10 @@\n     \"repo-rules\": [{ \"name\": \"repo-rules\", \"kind\": \"dir\" }],\n     \"github\":     [{ \"name\": \".github\", \"kind\": \"dir\", \"merge_only\": true }],\n     \"utcp\":       [{ \"name\": \".utcp_config.json\", \"kind\": \"file\" }],\n-    \"env\":        [{ \"name\": \".env\", \"kind\": \"file\", \"warning\": \"links the Skilled checkout's .env, so every tool started in this repository reads its secrets\" }]\n+    \"env\":        [\n+      { \"name\": \".env\", \"kind\": \"file\", \"warning\": \"links the Skilled checkout's .env, so every tool started in this repository reads its secrets\" },\n+      { \"name\": \".env.example\", \"kind\": \"file\", \"project_owned\": true }\n+    ]\n   },\n   \"instructions\": [\n     { \"name\": \"AGENTS.md\", \"kind\": \"file\", \"source\": \"AGENTS.md\" },\ndiff --git a/.skilled/commands/doctor/scripts/symlink-engine.cjs b/.skilled/commands/doctor/scripts/symlink-engine.cjs\nindex cbf5a5da12..12f06c1320 100644\n--- a/.skilled/commands/doctor/scripts/symlink-engine.cjs\n+++ b/.skilled/commands/doctor/scripts/symlink-engine.cjs\n@@ -540,15 +540,50 @@ function isUnmirroredChild(sourceRelative, name) {\n   return UNMIRRORED_NAMES.has(name) || UNMIRRORED_PATHS.has(path.join(sourceRelative, name));\n }\n \n+/**\n+ * Whether a source child is a relative link that leaves its manifest folder.\n+ * Such a link names a host sibling, so it can only be mirrored relative to the host.\n+ * @param {string} sourcePath\n+ * @param {string} entrySource\n+ * @returns {boolean}\n+ */\n+function isHostRelativeLink(sourcePath, entrySource) {\n+  const stat = lstatOrNull(sourcePath);\n+  if (!stat || !stat.isSymbolicLink()) return false;\n+  const linkText = fs.readlinkSync(sourcePath);\n+  if (path.isAbsolute(linkText)) return false;\n+  return !isWithin(path.resolve(path.dirname(sourcePath), linkText), entrySource);\n+}\n+\n+/**\n+ * Whether a source folder holds any link that names a host sibling.\n+ * @param {string} directory\n+ * @param {string} entrySource\n+ * @param {string} sourceRelative\n+ * @returns {boolean}\n+ */\n+function hasHostRelativeLink(directory, entrySource, sourceRelative) {\n+  for (const name of fs.readdirSync(directory)) {\n+    if (isUnmirroredChild(sourceRelative, name)) continue;\n+    const child = path.join(directory, name);\n+    if (isHostRelativeLink(child, entrySource)) return true;\n+    const stat = lstatOrNull(child);\n+    if (stat && stat.isDirectory() && !stat.isSymbolicLink()\n+      && hasHostRelativeLink(child, entrySource, path.join(sourceRelative, name))) return true;\n+  }\n+  return false;\n+}\n+\n /**\n  * Inspect children of a merged source directory without following root symlinks.\n  * @param {string} root\n  * @param {string} source\n  * @param {string} rootRelative\n  * @param {string} sourceRelative\n+ * @param {string} entrySource\n  * @param {object} details\n  */\n-function inspectMergeTree(root, source, rootRelative, sourceRelative, details) {\n+function inspectMergeTree(root, source, rootRelative, sourceRelative, entrySource, details) {\n   const sourceDirectory = resolveInside(source, sourceRelative);\n   const rootDirectory = resolveInside(root, rootRelative);\n   let sourceNames;\n@@ -568,6 +603,18 @@ function inspectMergeTree(root, source, rootRelative, sourceRelative, details) {\n     const sourceStat = lstatOrNull(childSource);\n     const rootStat = lstatOrNull(childRoot);\n     if (!sourceStat) continue;\n+    if (isHostRelativeLink(childSource, entrySource)) {\n+      const linkText = fs.readlinkSync(childSource);\n+      const hostTarget = path.resolve(path.dirname(childRoot), linkText);\n+      // A host sibling that is absent means the alias is omitted, never missing.\n+      if (!isWithin(hostTarget, root) || !linkTargetExists(hostTarget)) continue;\n+      if (!rootStat) {\n+        details.missing_children.push(childRootRelative);\n+      } else if (!rootStat.isSymbolicLink() || fs.readlinkSync(childRoot) !== linkText) {\n+        details.local_conflicts.push(childRootRelative);\n+      }\n+      continue;\n+    }\n     if (!rootStat) {\n       details.missing_children.push(childRootRelative);\n       continue;\n@@ -584,7 +631,7 @@ function inspectMergeTree(root, source, rootRelative, sourceRelative, details) {\n       continue;\n     }\n     if (rootStat.isDirectory() && sourceStat.isDirectory()) {\n-      inspectMergeTree(root, source, childRootRelative, childSourceRelative, details);\n+      inspectMergeTree(root, source, childRootRelative, childSourceRelative, entrySource, details);\n     } else {\n       details.local_conflicts.push(childRootRelative);\n     }\n@@ -642,6 +689,10 @@ function inspectEntry(selected, root, source, gitWorkTree) {\n     details.status = 'missing';\n     return details;\n   }\n+  if (entry.project_owned === true && rootStat.isFile()) {\n+    details.status = 'project-owned';\n+    return details;\n+  }\n   if (rootStat.isSymbolicLink()) {\n     const linkText = fs.readlinkSync(rootPath);\n     if (isWholeLink(rootPath, sourcePath, entry, linkText)) {\n@@ -655,7 +706,7 @@ function inspectEntry(selected, root, source, gitWorkTree) {\n     return details;\n   }\n   if (rootStat.isDirectory() && sourceStat.isDirectory() && entry.kind === 'dir') {\n-    inspectMergeTree(root, source, entry.name, entry.source || entry.name, details);\n+    inspectMergeTree(root, source, entry.name, entry.source || entry.name, sourcePath, details);\n     details.status = details.missing_children.length > 0 || details.broken_links.length > 0\n       ? 'partial-merge'\n       : 'linked-merge';\n@@ -736,10 +787,11 @@ function refuse(actions, refusals, pathName, reason) {\n  * @param {string} source\n  * @param {string} rootRelative\n  * @param {string} sourceRelative\n+ * @param {string} entrySource\n  * @param {Array<object>} actions\n  * @param {Array<string>} ignoreCandidates\n  */\n-function planMergeTree(root, source, rootRelative, sourceRelative, actions, ignoreCandidates) {\n+function planMergeTree(root, source, rootRelative, sourceRelative, entrySource, actions, ignoreCandidates) {\n   const sourceDirectory = resolveInside(source, sourceRelative);\n   const rootDirectory = resolveInside(root, rootRelative);\n   let sourceNames;\n@@ -759,6 +811,16 @@ function planMergeTree(root, source, rootRelative, sourceRelative, actions, igno\n     const sourceStat = lstatOrNull(childSource);\n     const rootStat = lstatOrNull(childRoot);\n     if (!sourceStat) continue;\n+    if (isHostRelativeLink(childSource, entrySource)) {\n+      const linkText = fs.readlinkSync(childSource);\n+      const hostTarget = path.resolve(path.dirname(childRoot), linkText);\n+      // Only a host sibling that already exists receives the alias; it is never a link into the checkout.\n+      if (!isWithin(hostTarget, root) || !linkTargetExists(hostTarget)) continue;\n+      if (!rootStat) {\n+        actions.push({ op: 'link', path: childRootRelative, target: linkText });\n+      }\n+      continue;\n+    }\n     if (!rootStat) {\n       actions.push({ op: 'link', path: childRootRelative, target: childSource });\n       ignoreCandidates.push(childRootRelative);\n@@ -776,7 +838,7 @@ function planMergeTree(root, source, rootRelative, sourceRelative, actions, igno\n       continue;\n     }\n     if (rootStat.isDirectory() && sourceStat.isDirectory()) {\n-      planMergeTree(root, source, childRootRelative, childSourceRelative, actions, ignoreCandidates);\n+      planMergeTree(root, source, childRootRelative, childSourceRelative, entrySource, actions, ignoreCandidates);\n     }\n   }\n \n@@ -837,10 +899,14 @@ function buildPlan(options = {}) {\n     const rootStat = lstatOrNull(rootPath);\n \n     if (!rootStat) {\n-      const merge = entry.kind === 'dir' && (mode === 'merge' || entry.merge_only === true);\n+      // A whole link would resolve a host-sibling alias against this checkout, so such a\n+      // folder is built in place; every other folder keeps the whole-link default.\n+      const merge = entry.kind === 'dir' && (mode === 'merge' || entry.merge_only === true\n+        || hasHostRelativeLink(sourcePath, sourcePath, entry.source || entry.name));\n       if (merge) {\n         actions.push({ op: 'mkdir', path: entry.name });\n-        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name, actions, ignoreCandidates);\n+        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name,\n+          sourcePath, actions, ignoreCandidates);\n       } else {\n         const target = entry.kind === 'relative-link' ? entry.target : sourcePath;\n         actions.push({ op: 'link', path: entry.name, target });\n@@ -849,6 +915,9 @@ function buildPlan(options = {}) {\n       continue;\n     }\n \n+    // A real project file wins over the vendored copy; the manifest entry is a fallback only.\n+    if (entry.project_owned === true && rootStat.isFile()) continue;\n+\n     if (rootStat.isSymbolicLink()) {\n       const linkText = fs.readlinkSync(rootPath);\n       if (isWholeLink(rootPath, sourcePath, entry, linkText)) continue;\n@@ -866,7 +935,8 @@ function buildPlan(options = {}) {\n       if (mode === 'whole' && entry.merge_only !== true) {\n         refuse(actions, refusals, entry.name, 'a real folder exists; use --mode merge');\n       } else {\n-        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name, actions, ignoreCandidates);\n+        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name,\n+          sourcePath, actions, ignoreCandidates);\n       }\n       continue;\n     }\n@@ -1362,7 +1432,12 @@ function isManifestTarget(manifest, source, rootRelative, target) {\n     const suffix = rootRelative.slice(entry.name.length + 1);\n     const sourceRelative = path.join(entry.source || entry.name, suffix);\n     try {\n-      if (target === resolveInside(source, sourceRelative)) return true;\n+      const sourceChild = resolveInside(source, sourceRelative);\n+      if (target === sourceChild) return true;\n+      // A merged child may itself be a relative link mirrored from the source tree.\n+      const sourceChildStat = lstatOrNull(sourceChild);\n+      if (sourceChildStat && sourceChildStat.isSymbolicLink()\n+        && !path.isAbsolute(target) && fs.readlinkSync(sourceChild) === target) return true;\n     } catch {\n       return false;\n     }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/assets/symlink-manifest.json b/.skilled/commands/doctor/assets/symlink-manifest.json\nindex be8e8ba40d..d487ba19f8 100644\n--- a/.skilled/commands/doctor/assets/symlink-manifest.json\n+++ b/.skilled/commands/doctor/assets/symlink-manifest.json\n@@ -13,7 +13,10 @@\n     \"repo-rules\": [{ \"name\": \"repo-rules\", \"kind\": \"dir\" }],\n     \"github\":     [{ \"name\": \".github\", \"kind\": \"dir\", \"merge_only\": true }],\n     \"utcp\":       [{ \"name\": \".utcp_config.json\", \"kind\": \"file\" }],\n-    \"env\":        [{ \"name\": \".env\", \"kind\": \"file\", \"warning\": \"links the Skilled checkout's .env, so every tool started in this repository reads its secrets\" }]\n+    \"env\":        [\n+      { \"name\": \".env\", \"kind\": \"file\", \"warning\": \"links the Skilled checkout's .env, so every tool started in this repository reads its secrets\" },\n+      { \"name\": \".env.example\", \"kind\": \"file\", \"project_owned\": true }\n+    ]\n   },\n   \"instructions\": [\n     { \"name\": \"AGENTS.md\", \"kind\": \"file\", \"source\": \"AGENTS.md\" },\ndiff --git a/.skilled/commands/doctor/scripts/symlink-engine.cjs b/.skilled/commands/doctor/scripts/symlink-engine.cjs\nindex cbf5a5da12..12f06c1320 100644\n--- a/.skilled/commands/doctor/scripts/symlink-engine.cjs\n+++ b/.skilled/commands/doctor/scripts/symlink-engine.cjs\n@@ -540,15 +540,50 @@ function isUnmirroredChild(sourceRelative, name) {\n   return UNMIRRORED_NAMES.has(name) || UNMIRRORED_PATHS.has(path.join(sourceRelative, name));\n }\n \n+/**\n+ * Whether a source child is a relative link that leaves its manifest folder.\n+ * Such a link names a host sibling, so it can only be mirrored relative to the host.\n+ * @param {string} sourcePath\n+ * @param {string} entrySource\n+ * @returns {boolean}\n+ */\n+function isHostRelativeLink(sourcePath, entrySource) {\n+  const stat = lstatOrNull(sourcePath);\n+  if (!stat || !stat.isSymbolicLink()) return false;\n+  const linkText = fs.readlinkSync(sourcePath);\n+  if (path.isAbsolute(linkText)) return false;\n+  return !isWithin(path.resolve(path.dirname(sourcePath), linkText), entrySource);\n+}\n+\n+/**\n+ * Whether a source folder holds any link that names a host sibling.\n+ * @param {string} directory\n+ * @param {string} entrySource\n+ * @param {string} sourceRelative\n+ * @returns {boolean}\n+ */\n+function hasHostRelativeLink(directory, entrySource, sourceRelative) {\n+  for (const name of fs.readdirSync(directory)) {\n+    if (isUnmirroredChild(sourceRelative, name)) continue;\n+    const child = path.join(directory, name);\n+    if (isHostRelativeLink(child, entrySource)) return true;\n+    const stat = lstatOrNull(child);\n+    if (stat && stat.isDirectory() && !stat.isSymbolicLink()\n+      && hasHostRelativeLink(child, entrySource, path.join(sourceRelative, name))) return true;\n+  }\n+  return false;\n+}\n+\n /**\n  * Inspect children of a merged source directory without following root symlinks.\n  * @param {string} root\n  * @param {string} source\n  * @param {string} rootRelative\n  * @param {string} sourceRelative\n+ * @param {string} entrySource\n  * @param {object} details\n  */\n-function inspectMergeTree(root, source, rootRelative, sourceRelative, details) {\n+function inspectMergeTree(root, source, rootRelative, sourceRelative, entrySource, details) {\n   const sourceDirectory = resolveInside(source, sourceRelative);\n   const rootDirectory = resolveInside(root, rootRelative);\n   let sourceNames;\n@@ -568,6 +603,18 @@ function inspectMergeTree(root, source, rootRelative, sourceRelative, details) {\n     const sourceStat = lstatOrNull(childSource);\n     const rootStat = lstatOrNull(childRoot);\n     if (!sourceStat) continue;\n+    if (isHostRelativeLink(childSource, entrySource)) {\n+      const linkText = fs.readlinkSync(childSource);\n+      const hostTarget = path.resolve(path.dirname(childRoot), linkText);\n+      // A host sibling that is absent means the alias is omitted, never missing.\n+      if (!isWithin(hostTarget, root) || !linkTargetExists(hostTarget)) continue;\n+      if (!rootStat) {\n+        details.missing_children.push(childRootRelative);\n+      } else if (!rootStat.isSymbolicLink() || fs.readlinkSync(childRoot) !== linkText) {\n+        details.local_conflicts.push(childRootRelative);\n+      }\n+      continue;\n+    }\n     if (!rootStat) {\n       details.missing_children.push(childRootRelative);\n       continue;\n@@ -584,7 +631,7 @@ function inspectMergeTree(root, source, rootRelative, sourceRelative, details) {\n       continue;\n     }\n     if (rootStat.isDirectory() && sourceStat.isDirectory()) {\n-      inspectMergeTree(root, source, childRootRelative, childSourceRelative, details);\n+      inspectMergeTree(root, source, childRootRelative, childSourceRelative, entrySource, details);\n     } else {\n       details.local_conflicts.push(childRootRelative);\n     }\n@@ -642,6 +689,10 @@ function inspectEntry(selected, root, source, gitWorkTree) {\n     details.status = 'missing';\n     return details;\n   }\n+  if (entry.project_owned === true && rootStat.isFile()) {\n+    details.status = 'project-owned';\n+    return details;\n+  }\n   if (rootStat.isSymbolicLink()) {\n     const linkText = fs.readlinkSync(rootPath);\n     if (isWholeLink(rootPath, sourcePath, entry, linkText)) {\n@@ -655,7 +706,7 @@ function inspectEntry(selected, root, source, gitWorkTree) {\n     return details;\n   }\n   if (rootStat.isDirectory() && sourceStat.isDirectory() && entry.kind === 'dir') {\n-    inspectMergeTree(root, source, entry.name, entry.source || entry.name, details);\n+    inspectMergeTree(root, source, entry.name, entry.source || entry.name, sourcePath, details);\n     details.status = details.missing_children.length > 0 || details.broken_links.length > 0\n       ? 'partial-merge'\n       : 'linked-merge';\n@@ -736,10 +787,11 @@ function refuse(actions, refusals, pathName, reason) {\n  * @param {string} source\n  * @param {string} rootRelative\n  * @param {string} sourceRelative\n+ * @param {string} entrySource\n  * @param {Array<object>} actions\n  * @param {Array<string>} ignoreCandidates\n  */\n-function planMergeTree(root, source, rootRelative, sourceRelative, actions, ignoreCandidates) {\n+function planMergeTree(root, source, rootRelative, sourceRelative, entrySource, actions, ignoreCandidates) {\n   const sourceDirectory = resolveInside(source, sourceRelative);\n   const rootDirectory = resolveInside(root, rootRelative);\n   let sourceNames;\n@@ -759,6 +811,16 @@ function planMergeTree(root, source, rootRelative, sourceRelative, actions, igno\n     const sourceStat = lstatOrNull(childSource);\n     const rootStat = lstatOrNull(childRoot);\n     if (!sourceStat) continue;\n+    if (isHostRelativeLink(childSource, entrySource)) {\n+      const linkText = fs.readlinkSync(childSource);\n+      const hostTarget = path.resolve(path.dirname(childRoot), linkText);\n+      // Only a host sibling that already exists receives the alias; it is never a link into the checkout.\n+      if (!isWithin(hostTarget, root) || !linkTargetExists(hostTarget)) continue;\n+      if (!rootStat) {\n+        actions.push({ op: 'link', path: childRootRelative, target: linkText });\n+      }\n+      continue;\n+    }\n     if (!rootStat) {\n       actions.push({ op: 'link', path: childRootRelative, target: childSource });\n       ignoreCandidates.push(childRootRelative);\n@@ -776,7 +838,7 @@ function planMergeTree(root, source, rootRelative, sourceRelative, actions, igno\n       continue;\n     }\n     if (rootStat.isDirectory() && sourceStat.isDirectory()) {\n-      planMergeTree(root, source, childRootRelative, childSourceRelative, actions, ignoreCandidates);\n+      planMergeTree(root, source, childRootRelative, childSourceRelative, entrySource, actions, ignoreCandidates);\n     }\n   }\n \n@@ -837,10 +899,14 @@ function buildPlan(options = {}) {\n     const rootStat = lstatOrNull(rootPath);\n \n     if (!rootStat) {\n-      const merge = entry.kind === 'dir' && (mode === 'merge' || entry.merge_only === true);\n+      // A whole link would resolve a host-sibling alias against this checkout, so such a\n+      // folder is built in place; every other folder keeps the whole-link default.\n+      const merge = entry.kind === 'dir' && (mode === 'merge' || entry.merge_only === true\n+        || hasHostRelativeLink(sourcePath, sourcePath, entry.source || entry.name));\n       if (merge) {\n         actions.push({ op: 'mkdir', path: entry.name });\n-        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name, actions, ignoreCandidates);\n+        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name,\n+          sourcePath, actions, ignoreCandidates);\n       } else {\n         const target = entry.kind === 'relative-link' ? entry.target : sourcePath;\n         actions.push({ op: 'link', path: entry.name, target });\n@@ -849,6 +915,9 @@ function buildPlan(options = {}) {\n       continue;\n     }\n \n+    // A real project file wins over the vendored copy; the manifest entry is a fallback only.\n+    if (entry.project_owned === true && rootStat.isFile()) continue;\n+\n     if (rootStat.isSymbolicLink()) {\n       const linkText = fs.readlinkSync(rootPath);\n       if (isWholeLink(rootPath, sourcePath, entry, linkText)) continue;\n@@ -866,7 +935,8 @@ function buildPlan(options = {}) {\n       if (mode === 'whole' && entry.merge_only !== true) {\n         refuse(actions, refusals, entry.name, 'a real folder exists; use --mode merge');\n       } else {\n-        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name, actions, ignoreCandidates);\n+        planMergeTree(context.root, context.source, entry.name, entry.source || entry.name,\n+          sourcePath, actions, ignoreCandidates);\n       }\n       continue;\n     }\n@@ -1362,7 +1432,12 @@ function isManifestTarget(manifest, source, rootRelative, target) {\n     const suffix = rootRelative.slice(entry.name.length + 1);\n     const sourceRelative = path.join(entry.source || entry.name, suffix);\n     try {\n-      if (target === resolveInside(source, sourceRelative)) return true;\n+      const sourceChild = resolveInside(source, sourceRelative);\n+      if (target === sourceChild) return true;\n+      // A merged child may itself be a relative link mirrored from the source tree.\n+      const sourceChildStat = lstatOrNull(sourceChild);\n+      if (sourceChildStat && sourceChildStat.isSymbolicLink()\n+        && !path.isAbsolute(target) && fs.readlinkSync(sourceChild) === target) return true;\n     } catch {\n       return false;\n     }\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/MEGA/Development/Skilled && git diff ac32d66fed..7714ff26b1 -- .skilled/commands/doctor/assets/symlink-manifest.json .skilled/commands/doctor/scripts/symlink-engine.cjs\"}"},"time":{"start":1794075535468,"end":1794075537934}}}}
{"type":"tool_use","timestamp":1794075537939,"sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","part":{"partID":"prt_1b73c2e36001AN0z8iwS0WKaXJ","sessionID":"ses_e48de3ad0ffeE5McT5ooWqWS7z","messageID":"msg_1b73bc662001m9JMidl2RviUXr","type":"tool","id":"call_2c6ac699733b497aaaf0486b","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled && git diff ac32d66fed..7714ff26b1 -- .skilled/commands/doctor/scripts/tests/symlink-engine.test.cjs | head -180"},"output":"diff --git a/.skilled/commands/doctor/scripts/tests/symlink-engine.test.cjs b/.skilled/commands/doctor/scripts/tests/symlink-engine.test.cjs\nindex 427e5e5211..dd2e6d02a9 100644\n--- a/.skilled/commands/doctor/scripts/tests/symlink-engine.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/symlink-engine.test.cjs\n@@ -412,3 +412,89 @@ test('git exclude receives only the new ignore lines and unlink removes only tho\n   assertStatus(undone, 0, 'unlink should remove its recorded ignore lines');\n   assert.equal(fs.readFileSync(excludePath, 'utf8'), `${initialExclude}/keep-after-apply\\n`);\n });\n+\n+test('a project-owned file reports its status and survives link and unlink byte-for-byte', () => {\n+  const { source, root } = buildFixture();\n+  const sourceContents = Buffer.from('SOURCE_KEY=\\n');\n+  const projectContents = Buffer.from([0, 1, 2, 3, 250, 255]);\n+  writeFile(path.join(source, '.env.example'), sourceContents);\n+  writeFile(path.join(root, '.env.example'), projectContents);\n+\n+  const checked = runRoot(source, root, 'check', ['--include', 'env', '--json']);\n+  assertStatus(checked, 0, 'check should accept the project-owned file');\n+  assert.equal(findEntry(JSON.parse(checked.stdout), '.env.example').status, 'project-owned');\n+\n+  const plan = planFor(source, root, ['--include', 'env']);\n+  assert.doesNotMatch(plan.output, /^refusal:/m);\n+  assertNoPlanAction(plan, ['link', 'replace-link', 'remove-broken'], '.env.example');\n+  const applied = runRoot(source, root, 'apply', [\n+    '--include', 'env', '--plan-digest', plan.digest,\n+  ]);\n+  assertStatus(applied, 0, 'apply should preserve the project-owned file');\n+  assert.deepEqual(fs.readFileSync(path.join(root, '.env.example')), projectContents);\n+\n+  const report = runRoot(source, root, 'check', ['--include', 'env', '--json']);\n+  assertStatus(report, 0, 'post-apply check should accept the project-owned file');\n+  assert.equal(findEntry(JSON.parse(report.stdout), '.env.example').status, 'project-owned');\n+\n+  const undone = runUnlink(source, runDirectoryFrom(applied.output), '--yes');\n+  assertStatus(undone, 0, 'unlink should leave the project-owned file alone');\n+  assert.deepEqual(fs.readFileSync(path.join(root, '.env.example')), projectContents);\n+});\n+\n+test('a missing project-owned destination keeps the existing source-link behavior', () => {\n+  const { source, root } = buildFixture();\n+  writeFile(path.join(source, '.env.example'), 'SOURCE_KEY=\\n');\n+  const plan = planFor(source, root, ['--include', 'env']);\n+\n+  assertPlanAction(plan, 'link', '.env.example');\n+  const applied = runRoot(source, root, 'apply', [\n+    '--include', 'env', '--plan-digest', plan.digest,\n+  ]);\n+  assertStatus(applied, 0, 'apply should link the missing project-owned destination');\n+  assertLinkResolvesTo(path.join(root, '.env.example'), path.join(source, '.env.example'));\n+\n+  const undone = runUnlink(source, runDirectoryFrom(applied.output), '--yes');\n+  assertStatus(undone, 0, 'unlink should remove the link created for a missing destination');\n+  assert.equal(fs.lstatSync(path.join(root, '.env.example'), { throwIfNoEntry: false }), undefined);\n+});\n+\n+test('setup omits a dangling specs alias when the host has no specs folder', () => {\n+  const { source, root } = buildFixture();\n+  fs.symlinkSync('../specs', path.join(source, '.skilled/specs'));\n+  const plan = planFor(source, root);\n+\n+  assertPlanAction(plan, 'mkdir', '.skilled');\n+  assertNoPlanAction(plan, ['link'], '.skilled');\n+  assertNoPlanAction(plan, ['link', 'replace-link'], '.skilled/specs');\n+  const applied = runRoot(source, root, 'apply', ['--plan-digest', plan.digest]);\n+  assertStatus(applied, 0, 'apply should install without the missing specs alias');\n+  assert.ok(fs.lstatSync(path.join(root, '.skilled')).isDirectory());\n+  assert.equal(fs.lstatSync(path.join(root, '.skilled/specs'), { throwIfNoEntry: false }), undefined);\n+  assert.equal(findEntry(checkReport(source, root), '.skilled').status, 'linked-merge');\n+\n+  const undone = runUnlink(source, runDirectoryFrom(applied.output), '--yes');\n+  assertStatus(undone, 0, 'unlink should remove the merged install');\n+});\n+\n+test('setup keeps the specs alias pointed at a host specs folder', () => {\n+  const { source, root } = buildFixture();\n+  fs.symlinkSync('../specs', path.join(source, '.skilled/specs'));\n+  writeFile(path.join(root, 'specs/host-packet/spec.md'), '# Host packet\\n');\n+  const hostSpecs = path.join(root, 'specs');\n+  const alias = path.join(root, '.skilled/specs');\n+  const plan = planFor(source, root);\n+\n+  assertPlanAction(plan, 'mkdir', '.skilled');\n+  assertPlanAction(plan, 'link', '.skilled/specs');\n+  const applied = runRoot(source, root, 'apply', ['--plan-digest', plan.digest]);\n+  assertStatus(applied, 0, 'apply should preserve the host specs alias');\n+  assert.equal(fs.readlinkSync(alias), '../specs');\n+  assert.equal(fs.realpathSync(alias), fs.realpathSync(hostSpecs));\n+  assert.equal(findEntry(checkReport(source, root), '.skilled').status, 'linked-merge');\n+\n+  const undone = runUnlink(source, runDirectoryFrom(applied.output), '--yes');\n+  assertStatus(undone, 0, 'unlink should remove the host specs alias');\n+  assert.equal(fs.lstatSync(alias, { throwIfNoEntry: false }), undefined);\n+  assert.equal(fs.existsSync(path.join(hostSpecs, 'host-packet/spec.md')), true);\n+});\n","title":"shell","metadata":{"