itle":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review-auto.yaml, lines 1333-2169\n1333:             - \"Size check uses 16KB threshold; above that uses @PROMPT_PATH wrapper prompt\"\n1334:             - \"Large-prompt path relies on copilot honoring @path references within its prompt string\"\n1335:             - \"buildCopilotPromptArg attaches a TARGET AUTHORITY preamble bound to the workflow-approved spec folder; recovered context cannot override it (authority guard source: .skilled/commands/speckit/assets/speckit_deep-review_auto.yaml)\"\n1336:             - \"If spec_folder is missing/malformed/unresolved on a write-intent dispatch, the helper enforces plan-only by replacing the prompt with a Gate-3 question and stripping --allow-all-tools\"\n1337:             - \"Large-prompt wrapper mode rewrites the prompt file at promptPath to include the TARGET AUTHORITY preamble (prefix + divider + original body); the argv becomes a bare @promptPath reference\"\n1338:         if_cli_claude_code:\n1339:           command: |\n1340:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1341:             import { readFileSync } from 'node:fs';\n1342:             import { createHash } from 'node:crypto';\n1343: \n1344:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1345: \n1346:             const configDir = '{optional_claude_config_dir}';\n1347:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1348:             const executor = {\n1349:               kind: 'cli-claude-code',\n1350:               model: '{config.executor.model}',\n1351:               configDir: configDir || null,\n1352:               reasoningEffort,\n1353:               serviceTier: null,\n1354:               sandboxMode: null,\n1355:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1356:               governor: null,\n1357:             };\n1358:             const args = [\n1359:               '-p',\n1360:               readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n1361:               '--model',\n1362:               executor.model,\n1363:               '--permission-mode',\n1364:               'acceptEdits',\n1365:               '--output-format',\n1366:               'text',\n1367:             ];\n1368:             if (executor.reasoningEffort) {\n1369:               args.push('--effort', executor.reasoningEffort);\n1370:             }\n1371: \n1372:             // CLAUDE_CONFIG_DIR rides through guardContext.env; the CLAUDE_ prefix is\n1373:             // on the cli-claude-code env allowlist so buildExecutorDispatchEnv admits it.\n1374:             const parentEnv = { ...process.env };\n1375:             if (configDir) {\n1376:               parentEnv.CLAUDE_CONFIG_DIR = configDir;\n1377:             }\n1378: \n1379:             const dispatchFacts = {\n1380:               command: 'deep/review',\n1381:               mode: 'review',\n1382:               specFolder: '{spec_folder}',\n1383:               artifactDir: '{state_paths.packet_dir}',\n1384:               iteration: Number('{current_iteration}'),\n1385:               executorKind: '{config.executor.kind}',\n1386:               branchId: '{config.executor.kind}',\n1387:               sessionId: '{session_id}',\n1388:               generation: Number('{generation}'),\n1389:             };\n1390:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1391:             process.exit(\n1392:               runAuditedExecutorCommand({\n1393:                 command: 'claude',\n1394:                 args,\n1395:                 cwd: '{repo_root}',\n1396:                 timeoutSeconds: executor.timeoutSeconds,\n1397:                 stateLogPath: '{state_paths.state_log}',\n1398:                 executor,\n1399:                 iteration: Number('{current_iteration}'),\n1400:                 guardContext: { env: parentEnv },\n1401:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1402:                 dispatchId,\n1403:               }),\n1404:             );\n1405:             EOF\n1406:           working_directory: \"{repo_root}\"\n1407:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1408:           wait_for_completion: true\n1409:           render_hint:\n1410:             optional_claude_config_dir: |\n1411:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and bind that path.\n1412:               Otherwise expand to empty string.\n1413:           notes:\n1414:             - \"Routed through runAuditedExecutorCommand so claude-code produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1415:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so account-specific Claude Code routing is preserved\"\n1416:             - \"permission-mode stays acceptEdits (review's existing iteration-write behavior); claude-code has no serviceTier flag\"\n1417:             - \"claude-code supports --effort for reasoning depth\"\n1418:         if_cli_opencode:\n1419:           command: |\n1420:             GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1421:             [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1422:             EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-review-baseline.XXXXXX\")\"\n1423:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module - \"$EVENT_DIR\" <<'EOF'\n1424:             import { execFileSync } from 'node:child_process';\n1425:             import { readFileSync, readlinkSync, realpathSync, writeFileSync } from 'node:fs';\n1426:             import { createHash } from 'node:crypto';\n1427:             import { basename, dirname, isAbsolute, join, relative, resolve } from 'node:path';\n1428: \n1429:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1430: \n1431:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1432:             const executor = {\n1433:               kind: 'cli-opencode',\n1434:               model: '{config.executor.model}',\n1435:               configDir: null,\n1436:               reasoningEffort,\n1437:               serviceTier: null,\n1438:               sandboxMode: null,\n1439:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1440:               governor: null,\n1441:             };\n1442:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1443:             if (!promptBody.includes('BANNED OPERATIONS') || !promptBody.includes('ALLOWED WRITE PATHS')) {\n1444:               throw new Error('Unsafe cli-opencode dispatch: rendered prompt is missing required write-containment sections');\n1445:             }\n1446: \n1447:             const repoRoot = realpathSync('{repo_root}');\n1448:             const artifactDir = resolve(repoRoot, '{state_paths.packet_dir}');\n1449:             const artifactRelative = relative(repoRoot, artifactDir);\n1450:             if (artifactRelative === '' || artifactRelative.startsWith('..') || isAbsolute(artifactRelative)) {\n1451:               throw new Error('Unsafe cli-opencode dispatch: artifact directory must be a strict descendant of the worktree root');\n1452:             }\n1453: \n1454:             const git = (args, cwd = repoRoot, trim = true) => {\n1455:               const output = execFileSync('git', args, { cwd, encoding: 'utf8' });\n1456:               return trim ? output.trim() : output;\n1457:             };\n1458:             const resolveGitPath = (candidate) => realpathSync(isAbsolute(candidate) ? candidate : resolve(repoRoot, candidate));\n1459:             const gitDir = resolveGitPath(git(['rev-parse', '--git-dir']));\n1460:             const commonGitDir = resolveGitPath(git(['rev-parse', '--git-common-dir']));\n1461:             if (gitDir === commonGitDir) {\n1462:               throw new Error('Unsafe cli-opencode dispatch: --dir must point at an isolated linked worktree');\n1463:             }\n1464: \n1465:             const primaryBlock = git(['worktree', 'list', '--porcelain'])\n1466:               .split(/\\n\\n+/)\n1467:               .find((block) => /^branch refs\\/heads\\/(?:main|master)$/m.test(block));\n1468:             const primaryLine = primaryBlock?.split('\\n').find((line) => line.startsWith('worktree '));\n1469:             if (!primaryLine) {\n1470:               throw new Error('Unsafe cli-opencode dispatch: primary main/master worktree could not be resolved');\n1471:             }\n1472:             const primaryRoot = realpathSync(primaryLine.slice('worktree '.length));\n1473:             const primaryStatus = git(['status', '--porcelain=v1', '--untracked-files=all'], primaryRoot);\n1474:             if (primaryStatus) {\n1475:               throw new Error('Unsafe cli-opencode dispatch: primary worktree must be clean before unrestricted execution');\n1476:             }\n1477: \n1478:             const dirtyPaths = [\n1479:               ...git(['diff', '--name-only', '-z', 'HEAD', '--'], repoRoot, false).split('\\0'),\n1480:               ...git(['ls-files', '--others', '--exclude-standard', '-z'], repoRoot, false).split('\\0'),\n1481:             ].filter(Boolean);\n1482:             const canonicalLocation = (absolutePath) => {\n1483:               try {\n1484:                 return realpathSync(absolutePath);\n1485:               } catch {\n1486:                 let parentReal;\n1487:                 try {\n1488:                   parentReal = realpathSync(dirname(absolutePath));\n1489:                 } catch {\n1490:                   return absolutePath;\n1491:                 }\n1492:                 const leaf = resolve(parentReal, basename(absolutePath));\n1493:                 try {\n1494:                   // A dangling link still names the location it points at, and becomes a live\n1495:                   // escape the moment that target is created.\n1496:                   const target = readlinkSync(leaf);\n1497:                   return isAbsolute(target) ? resolve(target) : resolve(parentReal, target);\n1498:                 } catch {\n1499:                   return leaf;\n1500:                 }\n1501:               }\n1502:             };\n1503:             const artifactDirReal = canonicalLocation(artifactDir);\n1504:             // git reports the path it walked, not where the bytes land: a symlink component\n1505:             // under the artifact dir leaves a path that looks contained while its real\n1506:             // location is wherever the link points. Containment has to hold both by name and\n1507:             // after every component is resolved, so resolution can only ever narrow scope.\n1508:             const escapesArtifactDir = (absolutePath) => {\n1509:               const lexical = relative(artifactDir, absolutePath);\n1510:               if (lexical.startsWith('..') || isAbsolute(lexical)) return true;\n1511:               const canonical = relative(artifactDirReal, canonicalLocation(absolutePath));\n1512:               return canonical.startsWith('..') || isAbsolute(canonical);\n1513:             };\n1514:             const outsideArtifactDir = dirtyPaths.filter((candidate) => escapesArtifactDir(resolve(repoRoot, candidate)));\n1515:             if (outsideArtifactDir.length > 0) {\n1516:               throw new Error(`Unsafe cli-opencode dispatch: worktree changes outside the artifact directory: ${outsideArtifactDir.join(', ')}`);\n1517:             }\n1518: \n1519:             const recoveryBaselineCommit = git(['rev-parse', '--verify', 'HEAD']);\n1520:             // The state log is a projection the gateway rebuilds from the ledger, so the\n1521:             // recovery baseline is staged as a canonical ledger event for the wrapper\n1522:             // below to append; a write beside the projection is dropped by the next refresh.\n1523:             writeFileSync(\n1524:               join(process.argv[2], '01-recovery_baseline.json'),\n1525:               JSON.stringify({\n1526:                 stem: 'deep_review.recovery_baseline',\n1527:                 scope: { runId: '{session_id}', sessionId: '{session_id}' },\n1528:                 data: {\n1529:                   mode: 'review',\n1530:                   iteration: Number('{current_iteration}'),\n1531:                   recoveryBaselineCommit,\n1532:                   worktree: repoRoot,\n1533:                 },\n1534:               }),\n1535:               'utf8',\n1536:             );\n1537:             const message = 'Resolved route: mode=review; target_agent=@deep-review; execution=single_review_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1538:               + '\\n\\n'\n1539:               + promptBody;\n1540:             const args = [\n1541:               'run',\n1542:               '--model',\n1543:               executor.model,\n1544:               '--format',\n1545:               'json',\n1546:               '--dangerously-skip-permissions',\n1547:               '--pure',\n1548:               '--dir',\n1549:               '{repo_root}',\n1550:             ];\n1551:             if (executor.reasoningEffort) {\n1552:               args.push('--variant', executor.reasoningEffort);\n1553:             }\n1554:             args.push(message);\n1555: \n1556:             const dispatchFacts = {\n1557:               command: 'deep/review',\n1558:               mode: 'review',\n1559:               specFolder: '{spec_folder}',\n1560:               artifactDir: '{state_paths.packet_dir}',\n1561:               iteration: Number('{current_iteration}'),\n1562:               executorKind: '{config.executor.kind}',\n1563:               branchId: '{config.executor.kind}',\n1564:               sessionId: '{session_id}',\n1565:               generation: Number('{generation}'),\n1566:             };\n1567:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1568:             process.exit(\n1569:               runAuditedExecutorCommand({\n1570:                 command: 'opencode',\n1571:                 args,\n1572:                 cwd: '{repo_root}',\n1573:                 timeoutSeconds: executor.timeoutSeconds,\n1574:                 stateLogPath: '{state_paths.state_log}',\n1575:                 executor,\n1576:                 iteration: Number('{current_iteration}'),\n1577:                 // opencode v1.14.39 reads stdin at startup before session creation;\n1578:                 // an empty input gives EOF stdin, equivalent to </dev/null.\n1579:                 input: '',\n1580:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1581:                 dispatchId,\n1582:               }),\n1583:             );\n1584:             EOF\n1585:             NODE_STATUS=$?\n1586:             for eventFile in \"$EVENT_DIR\"/*.json; do\n1587:               [ -e \"$eventFile\" ] || continue\n1588:               node \"$GATEWAY\" --mode review --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1589:               GATEWAY_STATUS=$?\n1590:               if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1591:                 rm -rf \"$EVENT_DIR\"\n1592:                 exit \"$GATEWAY_STATUS\"\n1593:               fi\n1594:             done\n1595:             rm -rf \"$EVENT_DIR\"\n1596:             exit \"$NODE_STATUS\"\n1597:           working_directory: \"{repo_root}\"\n1598:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1599:           wait_for_completion: true\n1600:           notes:\n1601:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1602:             - \"Fail closed before dispatch unless the rendered containment sections exist, --dir is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir both by name and after every path component is resolved through symlinks; append the recovery-baseline commit to state_log\"\n1603:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n1604:             - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n1605:             - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n1606:             - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n1607:             - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1608:         if_cli_codex:\n1609:           command: |\n1610:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1611:             import { readFileSync } from 'node:fs';\n1612:             import { execFileSync } from 'node:child_process';\n1613: \n1614:             import {\n1615:               RECURSION_GUARD_EXIT_CODE,\n1616:               formatRecursionGuardRefusal,\n1617:               runAuditedExecutorCommand,\n1618:               validateExecutorDispatchAllowed,\n1619:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1620:             import {\n1621:               snapshotOutOfScopeDirtyPaths,\n1622:               enforceWriteContainment,\n1623:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1624: \n1625:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1626:             // never silently degrade to another executor. Undetected absence is what\n1627:             // got Codex deprecated before, so the branch exits non-zero when the\n1628:             // binary is missing instead of falling through to a native/other path.\n1629:             let codexAvailable = false;\n1630:             try {\n1631:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1632:               codexAvailable = true;\n1633:             } catch {}\n1634:             if (!codexAvailable) {\n1635:               console.error('cli-codex executor unavailable: command -v codex failed');\n1636:               process.exit(1);\n1637:             }\n1638: \n1639:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1640:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1641:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1642:             const executor = {\n1643:               kind: 'cli-codex',\n1644:               model,\n1645:               configDir: null,\n1646:               reasoningEffort,\n1647:               serviceTier,\n1648:               sandboxMode: 'workspace-write',\n1649:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1650:               governor: null,\n1651:             };\n1652: \n1653:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1654:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1655:             // or a codex session must run the iteration itself, not delegate it onward.\n1656:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1657:             if (!guardVerdict.allowed) {\n1658:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1659:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1660:             }\n1661: \n1662:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1663: \n1664:             // codex reads the iteration prompt from stdin via the trailing '-'. A review\n1665:             // iteration must WRITE its own iteration file, delta and state record, so the\n1666:             // sandbox is workspace-write — read-only would block those required writes.\n1667:             // approval_policy=never keeps the run non-interactive.\n1668:             const args = ['exec'];\n1669:             if (model) {\n1670:               args.push('--model', model);\n1671:             }\n1672:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1673:             if (serviceTier) {\n1674:               args.push('-c', 'service_tier=' + serviceTier);\n1675:             }\n1676:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1677: \n1678:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1679:             const repoRoot = '{repo_root}';\n1680:             const artifactDir = '{artifact_dir}';\n1681:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1682:             const dispatchExit = runAuditedExecutorCommand({\n1683:               command: 'codex',\n1684:               args,\n1685:               cwd: repoRoot,\n1686:               timeoutSeconds: executor.timeoutSeconds,\n1687:               stateLogPath: '{state_paths.state_log}',\n1688:               executor,\n1689:               iteration: Number('{current_iteration}'),\n1690:               input: promptBody,\n1691:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1692:               dispatchId,\n1693:             });\n1694:             // Structural write-containment: the artifact-dir boundary is prompt-only, so a\n1695:             // workspace-write leaf can write anywhere in the repo. The guard diffs the tree\n1696:             // after the dispatch and reports every NEW out-of-artifact-dir path. Its remedy\n1697:             // PRESERVES by default -- event recorded, copy quarantined, bytes left on disk --\n1698:             // because a path it cannot attribute may belong to a concurrent writer, so a\n1699:             // revert here would destroy work this lane never wrote; reverting is opt-in per\n1700:             // run and is not implied by this call. Remedy authority, both modes:\n1701:             // runtime/lib/deep-loop/write-containment.ts. A violation is reported below and\n1702:             // left on disk, never made fatal here: what the run does about it is the\n1703:             // verdict's to decide. The leaf's own writes under artifactDir (iteration\n1704:             // file/delta/state record) are never flagged.\n1705:             const containment = enforceWriteContainment({\n1706:               repoRoot,\n1707:               artifactDir,\n1708:               preDispatchDirtyPaths,\n1709:               stateLogPath: '{state_paths.state_log}',\n1710:               iteration: Number('{current_iteration}'),\n1711:               label: dispatchId,\n1712:             });\n1713:             if (containment.violations.length > 0) {\n1714:               console.error(\n1715:                 'write-containment advisory: detected ' + containment.violations.length\n1716:                   + ' out-of-scope path(s), left on disk: '\n1717:                   + containment.violations.map((v) => v.path).join(', '),\n1718:               );\n1719:             }\n1720:             // A path that was already dirty before the dispatch and changed during it is held out of\n1721:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n1722:             // this prints it so the run's own output says so too.\n1723:             if (containment.contested.length > 0) {\n1724:               console.error(\n1725:                 'write-containment contested: ' + containment.contested.length\n1726:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n1727:                   + containment.contested.map((v) => v.path).join(', ')\n1728:                   + '\\n' + containment.contestedNote,\n1729:               );\n1730:             }\n1731:             process.exit(dispatchExit);\n1732:             EOF\n1733:           working_directory: \"{repo_root}\"\n1734:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1735:           wait_for_completion: true\n1736:           notes:\n1737:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the review pass yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1738:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1739:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1740:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1741:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1742:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1743:         if_cli_cursor:\n1744:           command: |\n1745:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1746:             import { readFileSync } from 'node:fs';\n1747:             import { createRequire } from 'node:module';\n1748:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1749:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1750:             import {\n1751:               snapshotOutOfScopeDirtyPaths,\n1752:               enforceWriteContainment,\n1753:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1754: \n1755:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1756:             // without this they silently degrade to native. The command builder is the\n1757:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1758:             // headless write-mode flags, and binary preflight stay one source of truth.\n1759:             // It throws (fail closed) when the binary is absent or the model is off the\n1760:             // allowlist, so a requested CLI executor never becomes native.\n1761:             const require = createRequire(import.meta.url);\n1762:             const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1763: \n1764:             const kind = '{config.executor.kind}';\n1765:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1766:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1767:             // The iteration must write its own iteration file, delta and state record,\n1768:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1769:             // write-permitting headless flags.\n1770:             const sandboxMode = 'workspace-write';\n1771:             const lineage = { kind, model, sandboxMode };\n1772:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1773:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1774: \n1775:             const repoRoot = '{repo_root}';\n1776:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1777:             const { command, args, input } = buildLineageCommand(\n1778:               lineage,\n1779:               promptBody,\n1780:               resolvedSandbox,\n1781:               resolvedPermission,\n1782:               { env: process.env, cwd: repoRoot },\n1783:             );\n1784: \n1785:             const executor = {\n1786:               kind,\n1787:               model,\n1788:               configDir: null,\n1789:               reasoningEffort: null,\n1790:               serviceTier: null,\n1791:               sandboxMode,\n1792:               timeoutSeconds,\n1793:               governor: null,\n1794:             };\n1795:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1796:             const artifactDir = '{artifact_dir}';\n1797:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1798:             const dispatchExit = runAuditedExecutorCommand({\n1799:               command,\n1800:               args,\n1801:               cwd: repoRoot,\n1802:               timeoutSeconds,\n1803:               stateLogPath: '{state_paths.state_log}',\n1804:               executor,\n1805:               iteration: Number('{current_iteration}'),\n1806:               input,\n1807:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1808:               dispatchId,\n1809:             });\n1810:             const containment = enforceWriteContainment({\n1811:               repoRoot,\n1812:               artifactDir,\n1813:               preDispatchDirtyPaths,\n1814:               stateLogPath: '{state_paths.state_log}',\n1815:               iteration: Number('{current_iteration}'),\n1816:               label: dispatchId,\n1817:             });\n1818:             if (containment.violations.length > 0) {\n1819:               console.error(\n1820:                 'write-containment advisory: detected ' + containment.violations.length\n1821:                   + ' out-of-scope path(s), left on disk: '\n1822:                   + containment.violations.map((v) => v.path).join(', '),\n1823:               );\n1824:             }\n1825:             // A path that was already dirty before the dispatch and changed during it is held out of\n1826:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n1827:             // this prints it so the run's own output says so too.\n1828:             if (containment.contested.length > 0) {\n1829:               console.error(\n1830:                 'write-containment contested: ' + containment.contested.length\n1831:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n1832:                   + containment.contested.map((v) => v.path).join(', ')\n1833:                   + '\\n' + containment.contestedNote,\n1834:               );\n1835:             }\n1836:             process.exit(dispatchExit);\n1837:             EOF\n1838:           working_directory: \"{repo_root}\"\n1839:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1840:           wait_for_completion: true\n1841:           notes:\n1842:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1843:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1844:         if_cli_devin:\n1845:           command: |\n1846:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1847:             import { readFileSync } from 'node:fs';\n1848:             import { createRequire } from 'node:module';\n1849:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1850:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1851:             import {\n1852:               snapshotOutOfScopeDirtyPaths,\n1853:               enforceWriteContainment,\n1854:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1855: \n1856:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1857:             // without this they silently degrade to native. The command builder is the\n1858:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1859:             // headless write-mode flags, and binary preflight stay one source of truth.\n1860:             // It throws (fail closed) when the binary is absent or the model is off the\n1861:             // allowlist, so a requested CLI executor never becomes native.\n1862:             const require = createRequire(import.meta.url);\n1863:             const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1864: \n1865:             const kind = '{config.executor.kind}';\n1866:             const model = '{conf