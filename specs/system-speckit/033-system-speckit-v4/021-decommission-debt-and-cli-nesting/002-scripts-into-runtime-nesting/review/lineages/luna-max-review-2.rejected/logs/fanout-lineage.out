{"type":"tool_use","timestamp":1788620035217,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_MKZ5zrTd9ce7obSumwAdikHZ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/_routes.yaml","offset":150,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/_routes.yaml</path>\n<type>file</type>\n<content>\n150:       - \"skill-graph zombie ghost nodes\"\n151:       - \"compiled vs sqlite vs disk graph drift\"\n152:       - \"reindex staleness check\"\n153: \n154:   - target: fable-mode\n155:     yaml: doctor-fable-mode.yaml\n156:     setup_vars: [execution_mode, target_dir]\n157:     allowed_flags: [\"--dir=<path>\", \"--baseline=<path>\"]\n158:     mutating: read-only\n159:     gate3_location: \"n/a (read-only behavioral-metric diagnostic; reads deep-loop state + iteration markdown + baseline snapshot, writes no files)\"\n160:     mcp_tools: []   # script-only behavioral-metric read; no MCP calls\n161:     script_invocations:\n162:       - 'node .opencode/commands/doctor/scripts/fable-mode-check.cjs --dir \"{target_dir}\"'\n163:     trigger_phrases:\n164:       - \"fable-5 behavioral metrics\"\n165:       - \"fable mode efficiency check\"\n166:       - \"tool text ratio diagnostic\"\n167:       - \"result-first opener metric\"\n168: \n169:   - target: runtime-mirrors\n170:     yaml: doctor-runtime-mirrors.yaml\n171:     setup_vars: [execution_mode]\n172:     allowed_flags: []\n173:     mutating: read-only\n174:     gate3_location: \"n/a (read-only mirror-parity diagnostic; every checker runs in its check-only form and writes nothing)\"\n175:     mcp_tools: []   # script-only mirror parity read; no MCP calls\n176:     script_invocations:\n177:       - 'node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs --check'\n178:       - 'node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs --check'\n179:       - 'node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs --check'\n180:       - 'node .opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n181:       - 'node .opencode/commands/doctor/scripts/command-catalog-mirror-check.cjs'\n182:       - 'node .opencode/bin/install-codex-hooks.mjs --check'\n183:     trigger_phrases:\n184:       - \"runtime mirror drift\"\n185:       - \"agent command mirror parity\"\n186:       - \"command catalog drift\"\n187:       - \"cursor devin codex sync check\"\n188:       - \"discovery mirror out of sync\"\n189: \n190: # ─────────────────────────────────────────────────────────────────\n191: # COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n192: # ─────────────────────────────────────────────────────────────────\n193: # /doctor:mcp dispatches via its own command (.opencode/commands/doctor/mcp.md).\n194: # These rows are tracked here for advisor + CI visibility only — the mcp.md\n195: # command parses its own sub-action argv and dispatches to the right YAML.\n196: # ─────────────────────────────────────────────────────────────────\n197: mcp_subroutes:\n198:   - sub_action: install\n199:     yaml: doctor-mcp-install.yaml\n200:     allowed_flags: [\"--server <name>\", \"--runtime <name>\"]\n201:     mutating: mutates\n202:     gate3_location: \"MCP server install dirs + runtime config (.opencode.json / .claude/settings.json / )\"\n203:     trigger_phrases:\n204:       - \"MCP install\"\n205:       - \"MCP server fresh install\"\n206:       - \"reinstall MCP\"\n207: \n208:   - sub_action: debug\n209:     yaml: doctor-mcp-debug.yaml\n210:     allowed_flags: [\"--fix\", \"--server <name>\"]\n211:     mutating: mutates\n212:     gate3_location: \"MCP server logs + runtime config repair\"\n213:     trigger_phrases:\n214:       - \"MCP server broken\"\n215:       - \"MCP debug\"\n216:       - \"MCP connection failure\"\n217:       - \"mcp-doctor.sh\"\n218: \n219: # ─────────────────────────────────────────────────────────────────\n220: # ORCHESTRATOR (NOT routed through /doctor — kept here for reference)\n221: # ─────────────────────────────────────────────────────────────────\n222: # /doctor:update is a STANDALONE command at .opencode/commands/doctor/update.md.\n223: # It does NOT route through /doctor. This block exists for advisor visibility.\n224: # ─────────────────────────────────────────────────────────────────\n225: standalone:\n226:   - command: /doctor:update\n227:     file: .opencode/commands/doctor/update.md\n228:     yaml: doctor-update.yaml\n229:     mutating: mutates\n230:     trigger_phrases:\n231:       - \"spec-kit version migration\"\n232:       - \"doctor update orchestrator\"\n233:       - \"rebuild all spec-kit databases\"\n234:       - \"doctor full sync\"\n\n(End of file - total 234 lines)\n</content>","metadata":{"preview":"      - \"skill-graph zombie ghost nodes\"\n      - \"compiled vs sqlite vs disk graph drift\"\n      - \"reindex staleness check\"\n\n  - target: fable-mode\n    yaml: doctor-fable-mode.yaml\n    setup_vars: [execution_mode, target_dir]\n    allowed_flags: [\"--dir=<path>\", \"--baseline=<path>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only behavioral-metric diagnostic; reads deep-loop state + iteration markdown + baseline snapshot, writes no files)\"\n    mcp_tools: []   # script-only behavioral-metric read; no MCP calls\n    script_invocations:\n      - 'node .opencode/commands/doctor/scripts/fable-mode-check.cjs --dir \"{target_dir}\"'\n    trigger_phrases:\n      - \"fable-5 behavioral metrics\"\n      - \"fable mode efficiency check\"\n      - \"tool text ratio diagnostic\"\n      - \"result-first opener metric\"\n\n  - target: runtime-mirrors","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/_routes.yaml","text":"      - \"skill-graph zombie ghost nodes\"\n      - \"compiled vs sqlite vs disk graph drift\"\n      - \"reindex staleness check\"\n\n  - target: fable-mode\n    yaml: doctor-fable-mode.yaml\n    setup_vars: [execution_mode, target_dir]\n    allowed_flags: [\"--dir=<path>\", \"--baseline=<path>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only behavioral-metric diagnostic; reads deep-loop state + iteration markdown + baseline snapshot, writes no files)\"\n    mcp_tools: []   # script-only behavioral-metric read; no MCP calls\n    script_invocations:\n      - 'node .opencode/commands/doctor/scripts/fable-mode-check.cjs --dir \"{target_dir}\"'\n    trigger_phrases:\n      - \"fable-5 behavioral metrics\"\n      - \"fable mode efficiency check\"\n      - \"tool text ratio diagnostic\"\n      - \"result-first opener metric\"\n\n  - target: runtime-mirrors\n    yaml: doctor-runtime-mirrors.yaml\n    setup_vars: [execution_mode]\n    allowed_flags: []\n    mutating: read-only\n    gate3_location: \"n/a (read-only mirror-parity diagnostic; every checker runs in its check-only form and writes nothing)\"\n    mcp_tools: []   # script-only mirror parity read; no MCP calls\n    script_invocations:\n      - 'node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs --check'\n      - 'node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs --check'\n      - 'node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs --check'\n      - 'node .opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n      - 'node .opencode/commands/doctor/scripts/command-catalog-mirror-check.cjs'\n      - 'node .opencode/bin/install-codex-hooks.mjs --check'\n    trigger_phrases:\n      - \"runtime mirror drift\"\n      - \"agent command mirror parity\"\n      - \"command catalog drift\"\n      - \"cursor devin codex sync check\"\n      - \"discovery mirror out of sync\"\n\n# ─────────────────────────────────────────────────────────────────\n# COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n# ─────────────────────────────────────────────────────────────────\n# /doctor:mcp dispatches via its own command (.opencode/commands/doctor/mcp.md).\n# These rows are tracked here for advisor + CI visibility only — the mcp.md\n# command parses its own sub-action argv and dispatches to the right YAML.\n# ─────────────────────────────────────────────────────────────────\nmcp_subroutes:\n  - sub_action: install\n    yaml: doctor-mcp-install.yaml\n    allowed_flags: [\"--server <name>\", \"--runtime <name>\"]\n    mutating: mutates\n    gate3_location: \"MCP server install dirs + runtime config (.opencode.json / .claude/settings.json / )\"\n    trigger_phrases:\n      - \"MCP install\"\n      - \"MCP server fresh install\"\n      - \"reinstall MCP\"\n\n  - sub_action: debug\n    yaml: doctor-mcp-debug.yaml\n    allowed_flags: [\"--fix\", \"--server <name>\"]\n    mutating: mutates\n    gate3_location: \"MCP server logs + runtime config repair\"\n    trigger_phrases:\n      - \"MCP server broken\"\n      - \"MCP debug\"\n      - \"MCP connection failure\"\n      - \"mcp-doctor.sh\"\n\n# ─────────────────────────────────────────────────────────────────\n# ORCHESTRATOR (NOT routed through /doctor — kept here for reference)\n# ─────────────────────────────────────────────────────────────────\n# /doctor:update is a STANDALONE command at .opencode/commands/doctor/update.md.\n# It does NOT route through /doctor. This block exists for advisor visibility.\n# ─────────────────────────────────────────────────────────────────\nstandalone:\n  - command: /doctor:update\n    file: .opencode/commands/doctor/update.md\n    yaml: doctor-update.yaml\n    mutating: mutates\n    trigger_phrases:\n      - \"spec-kit version migration\"\n      - \"doctor update orchestrator\"\n      - \"rebuild all spec-kit databases\"\n      - \"doctor full sync\"","lineStart":150,"lineEnd":234,"totalLines":234,"truncated":false}},"title":".opencode/commands/doctor/_routes.yaml","time":{"start":1788620035188,"end":1788620035215}},"id":"prt_0720fd471001RdUfh0xlp907Dl","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
{"type":"tool_use","timestamp":1788620035240,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_hHBwOOpbP1VI2KCIg8j2wZW6","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/assets/doctor-runtime-mirrors.yaml","offset":1,"limit":250},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/assets/doctor-runtime-mirrors.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: RUNTIME MIRROR PARITY (READ-ONLY DIAGNOSTIC)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Diagnostic Operator reporting whether every runtime config dir still mirrors its canonical source\n5: purpose: Detect drift across the agent, command, prompt and hook mirrors that .claude, .codex, .cursor and .devin derive from .opencode, plus adapter-path resolution drift in the Codex and Devin hook fallback chains\n6: action: Run the five mirror checkers plus the hook-adapter fallback health check -> aggregate their verdicts -> report per-surface drift\n7: skill_owner: \".opencode/skills/system-spec-kit/runtime/cli/\"\n8: \n9: # ─────────────────────────────────────────────────────────────────\n10: # OPERATING MODE\n11: # ─────────────────────────────────────────────────────────────────\n12: operating_mode:\n13:   workflow: single-step\n14:   compliance: MANDATORY\n15:   execution: read_only\n16:   approvals: none\n17:   tracking: single_run\n18:   validation: read_only_assertion\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # MUTATION BOUNDARIES (READ-ONLY)\n22: # ─────────────────────────────────────────────────────────────────\n23: mutation_boundaries:\n24:   read_only: true\n25:   allowed_targets: []\n26:   forbidden_targets:\n27:     - \"**/*\"\n28:   invariant: \"Every checker below is invoked in its check-only form. This route MUST NOT run any generator in write mode, create or delete a symlink, or install a hook config. Repair is an explicit operator action, never a side effect of a diagnostic.\"\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   runtime_mirrors: \".opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\"\n35:   codex_agents: \".opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs\"\n36:   codex_prompts: \".opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs\"\n37:   agent_roster: \".opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs\"\n38:   codex_hooks_installer: \".opencode/bin/install-codex-hooks.mjs\"\n39:   pi_agents: \".opencode/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs\"\n40:   pi_prompts: \".opencode/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs\"\n41: \n42: # ─────────────────────────────────────────────────────────────────\n43: # HOOK-ADAPTER FALLBACK HEALTH CHECKS\n44: # ─────────────────────────────────────────────────────────────────\n45: # Every entry below is the primary adapter behind a `|| { <stderr>; <fallback JSON> }`\n46: # chain in .codex/hooks.json or .devin/hooks.v1.json (the chains that carry the\n47: # \"mkHookDrift\" marker). A missing path here is exactly the state a synthetic\n48: # adapter failure produces (e.g. temporarily renaming the compiled file), so a\n49: # `file_exists` failure on any row below is reported as a degraded hook adapter,\n50: # not a mirror-structure drift.\n51: hook_adapter_fallback_health_checks:\n52:   - { host: codex, event: SessionStart, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/session-start.js\", type: file_exists }\n53:   - { host: codex, event: SessionStart, path: \".opencode/bin/worktree-guard.sh\", type: file_exists }\n54:   - { host: codex, event: SessionStart, path: \".opencode/bin/check-git-hooks.sh\", type: file_exists }\n55:   - { host: codex, event: SessionStart, path: \".opencode/bin/git-live-follow.sh\", type: file_exists }\n56:   - { host: codex, event: SessionStart, path: \".opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh\", type: file_exists }\n57:   - { host: codex, event: UserPromptSubmit, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/user-prompt-submit.js\", type: file_exists }\n58:   - { host: codex, event: UserPromptSubmit, path: \".opencode/skills/system-spec-kit/runtime/hooks/codex/spec-gate-classify.mjs\", type: file_exists }\n59:   - { host: codex, event: PreToolUse, path: \".opencode/hooks/dispatch/codex/dispatch-preflight-lint.mjs\", type: file_exists }\n60:   - { host: codex, event: PreToolUse, path: \".opencode/skills/sk-git/scripts/hooks/git-preflight-advisory.mjs\", type: file_exists }\n61:   - { host: codex, event: PreToolUse, path: \".opencode/skills/system-spec-kit/runtime/hooks/codex/spec-gate-enforce.mjs\", type: file_exists }\n62:   - { host: codex, event: PreToolUse, path: \".opencode/hooks/mcp-route-guard/codex/mcp-route-guard.cjs\", type: file_exists }\n63:   - { host: codex, event: PostToolUse, path: \".opencode/hooks/post-edit-quality/codex/post-edit-quality.cjs\", type: file_exists }\n64:   - { host: codex, event: PostToolUse, path: \".opencode/hooks/dispatch/codex/dispatch-audit-posttooluse.mjs\", type: file_exists }\n65:   - { host: codex, event: Stop, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/session-stop.js\", type: file_exists }\n66:   - { host: codex, event: Stop, path: \".opencode/skills/system-spec-kit/runtime/hooks/codex/completion-evidence-stop.cjs\", type: file_exists }\n67:   - { host: codex, event: Stop, path: \".opencode/scripts/session-cleanup.sh\", type: file_exists }\n68:   - { host: codex, event: PreCompact, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/compact-inject.js\", type: file_exists }\n69:   - { host: devin, event: SessionStart, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/devin/session-start.js\", type: file_exists }\n70:   - { host: devin, event: UserPromptSubmit, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/devin/user-prompt-submit.js\", type: file_exists }\n71:   - { host: devin, event: PreToolUse, path: \".opencode/skills/sk-git/scripts/hooks/git-preflight-advisory.mjs\", type: file_exists }\n72:   - { host: devin, event: Stop, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/devin/session-stop.js\", type: file_exists }\n73: \n74: # ─────────────────────────────────────────────────────────────────\n75: # INPUTS\n76: # ─────────────────────────────────────────────────────────────────\n77: inputs:\n78:   none: \"This diagnostic takes no arguments. Every checker derives its expected state from the canonical trees and the runtimes' own config files.\"\n79: \n80: # ─────────────────────────────────────────────────────────────────\n81: # EXECUTION\n82: # ─────────────────────────────────────────────────────────────────\n83: execution:\n84:   steps:\n85:     - \"Run upstream_assets.runtime_mirrors with --check. Covers the cursor/devin agent, command and skill symlink trees plus all four hook discovery mirrors. Exit 0 = in sync, 1 = drift.\"\n86:     - \"Run upstream_assets.codex_agents with --check. Covers the generated .codex/agents/*.toml. Exit 0 = in sync, 1 = drift.\"\n87:     - \"Run upstream_assets.codex_prompts with --check. Covers the generated .codex/prompts/*.md stubs. Exit 0 = in sync, 1 = drift.\"\n88:     - \"Run upstream_assets.agent_roster. Covers roster coverage across all five surfaces and rejects a real file where a symlink belongs. Exit 0 = in sync, 1 = drift, 2 = canonical dir missing.\"\n89:     - \"Run upstream_assets.codex_hooks_installer with --check. Covers the user-global ~/.codex/hooks.json against the repo's .codex/hooks.json, including orphaned entries whose .opencode adapter no longer exists on disk. Exit 0 = in sync, 1 = drift.\"\n90:     - \"Run upstream_assets.pi_agents with --check. Covers the generated .pi/agents/*.md. Exit 0 = in sync, 1 = drift.\"\n91:     - \"Run upstream_assets.pi_prompts with --check. Covers the generated .pi/prompts/*.md stubs. Exit 0 = in sync, 1 = drift.\"\n92:     - \"For each row in hook_adapter_fallback_health_checks, run its file_exists check (a plain path-existence read, no execution of the adapter or the shell command that wraps it). Collect every row whose path does not resolve as a degraded hook adapter, keyed by host:event:path.\"\n93:     - \"Aggregate: report each surface with its own verdict rather than a single pass/fail, so the operator learns which mirror moved.\"\n94: \n95: # ─────────────────────────────────────────────────────────────────\n96: # OUTPUT\n97: # ─────────────────────────────────────────────────────────────────\n98: output: |\n99:   STATUS=OK when every checker reports in sync.\n100:   STATUS=DRIFT when any checker reports drift, listing each drifting surface and the repair command for it:\n101:     runtime mirrors  -> node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n102:     codex agents     -> node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs\n103:     codex prompts    -> node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs\n104:     codex hooks      -> node .opencode/bin/install-codex-hooks.mjs\n105:     pi agents        -> node .opencode/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs\n106:     pi prompts       -> node .opencode/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs\n107:   The agent roster check has no generator; its drift is repaired by the runtime-mirrors generator or by hand\n108:   for the authored surfaces (.opencode/agents, .codex/agents).\n109:   Hook CONFIG STRUCTURE is deliberately out of scope for mirroring: the four runtimes use incompatible event\n110:   vocabularies and entry shapes, so those files are hand-authored per runtime and cannot be mirror-checked\n111:   against each other.\n112:   Separately, \"N hook adapters degraded to fallback\" reports the count of hook_adapter_fallback_health_checks\n113:   rows whose path does not resolve, each listed as host:event:path. This is the same drift a live adapter\n114:   failure produces (its fallback JSON would carry \"mkHookDrift\": true and its stderr a matching\n115:   \"mk-hook-drift host=<host> event=<event> adapter=<name>\" line) surfaced without needing to fire the hook or\n116:   read raw JSON. Repair is adapter-specific: rebuild the runtime (npm --prefix\n117:   .opencode/skills/system-spec-kit/runtime run build) for a dist/hooks/* path, or restore/recreate the named\n118:   script for a .opencode/bin or .opencode/hooks path.\n\n(End of file - total 118 lines)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR: RUNTIME MIRROR PARITY (READ-ONLY DIAGNOSTIC)\n# ─────────────────────────────────────────────────────────────────\nrole: Diagnostic Operator reporting whether every runtime config dir still mirrors its canonical source\npurpose: Detect drift across the agent, command, prompt and hook mirrors that .claude, .codex, .cursor and .devin derive from .opencode, plus adapter-path resolution drift in the Codex and Devin hook fallback chains\naction: Run the five mirror checkers plus the hook-adapter fallback health check -> aggregate their verdicts -> report per-surface drift\nskill_owner: \".opencode/skills/system-spec-kit/runtime/cli/\"\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING MODE\n# ─────────────────────────────────────────────────────────────────\noperating_mode:\n  workflow: single-step\n  compliance: MANDATORY\n  execution: read_only\n  approvals: none\n  tracking: single_run\n  validation: read_only_assertion\n\n# ─────────────────────────────────────────────────────────────────","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/assets/doctor-runtime-mirrors.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR: RUNTIME MIRROR PARITY (READ-ONLY DIAGNOSTIC)\n# ─────────────────────────────────────────────────────────────────\nrole: Diagnostic Operator reporting whether every runtime config dir still mirrors its canonical source\npurpose: Detect drift across the agent, command, prompt and hook mirrors that .claude, .codex, .cursor and .devin derive from .opencode, plus adapter-path resolution drift in the Codex and Devin hook fallback chains\naction: Run the five mirror checkers plus the hook-adapter fallback health check -> aggregate their verdicts -> report per-surface drift\nskill_owner: \".opencode/skills/system-spec-kit/runtime/cli/\"\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING MODE\n# ─────────────────────────────────────────────────────────────────\noperating_mode:\n  workflow: single-step\n  compliance: MANDATORY\n  execution: read_only\n  approvals: none\n  tracking: single_run\n  validation: read_only_assertion\n\n# ─────────────────────────────────────────────────────────────────\n# MUTATION BOUNDARIES (READ-ONLY)\n# ─────────────────────────────────────────────────────────────────\nmutation_boundaries:\n  read_only: true\n  allowed_targets: []\n  forbidden_targets:\n    - \"**/*\"\n  invariant: \"Every checker below is invoked in its check-only form. This route MUST NOT run any generator in write mode, create or delete a symlink, or install a hook config. Repair is an explicit operator action, never a side effect of a diagnostic.\"\n\n# ─────────────────────────────────────────────────────────────────\n# UPSTREAM ASSETS\n# ─────────────────────────────────────────────────────────────────\nupstream_assets:\n  runtime_mirrors: \".opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\"\n  codex_agents: \".opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs\"\n  codex_prompts: \".opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs\"\n  agent_roster: \".opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs\"\n  codex_hooks_installer: \".opencode/bin/install-codex-hooks.mjs\"\n  pi_agents: \".opencode/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs\"\n  pi_prompts: \".opencode/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs\"\n\n# ─────────────────────────────────────────────────────────────────\n# HOOK-ADAPTER FALLBACK HEALTH CHECKS\n# ─────────────────────────────────────────────────────────────────\n# Every entry below is the primary adapter behind a `|| { <stderr>; <fallback JSON> }`\n# chain in .codex/hooks.json or .devin/hooks.v1.json (the chains that carry the\n# \"mkHookDrift\" marker). A missing path here is exactly the state a synthetic\n# adapter failure produces (e.g. temporarily renaming the compiled file), so a\n# `file_exists` failure on any row below is reported as a degraded hook adapter,\n# not a mirror-structure drift.\nhook_adapter_fallback_health_checks:\n  - { host: codex, event: SessionStart, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/session-start.js\", type: file_exists }\n  - { host: codex, event: SessionStart, path: \".opencode/bin/worktree-guard.sh\", type: file_exists }\n  - { host: codex, event: SessionStart, path: \".opencode/bin/check-git-hooks.sh\", type: file_exists }\n  - { host: codex, event: SessionStart, path: \".opencode/bin/git-live-follow.sh\", type: file_exists }\n  - { host: codex, event: SessionStart, path: \".opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh\", type: file_exists }\n  - { host: codex, event: UserPromptSubmit, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/user-prompt-submit.js\", type: file_exists }\n  - { host: codex, event: UserPromptSubmit, path: \".opencode/skills/system-spec-kit/runtime/hooks/codex/spec-gate-classify.mjs\", type: file_exists }\n  - { host: codex, event: PreToolUse, path: \".opencode/hooks/dispatch/codex/dispatch-preflight-lint.mjs\", type: file_exists }\n  - { host: codex, event: PreToolUse, path: \".opencode/skills/sk-git/scripts/hooks/git-preflight-advisory.mjs\", type: file_exists }\n  - { host: codex, event: PreToolUse, path: \".opencode/skills/system-spec-kit/runtime/hooks/codex/spec-gate-enforce.mjs\", type: file_exists }\n  - { host: codex, event: PreToolUse, path: \".opencode/hooks/mcp-route-guard/codex/mcp-route-guard.cjs\", type: file_exists }\n  - { host: codex, event: PostToolUse, path: \".opencode/hooks/post-edit-quality/codex/post-edit-quality.cjs\", type: file_exists }\n  - { host: codex, event: PostToolUse, path: \".opencode/hooks/dispatch/codex/dispatch-audit-posttooluse.mjs\", type: file_exists }\n  - { host: codex, event: Stop, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/session-stop.js\", type: file_exists }\n  - { host: codex, event: Stop, path: \".opencode/skills/system-spec-kit/runtime/hooks/codex/completion-evidence-stop.cjs\", type: file_exists }\n  - { host: codex, event: Stop, path: \".opencode/scripts/session-cleanup.sh\", type: file_exists }\n  - { host: codex, event: PreCompact, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/codex/compact-inject.js\", type: file_exists }\n  - { host: devin, event: SessionStart, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/devin/session-start.js\", type: file_exists }\n  - { host: devin, event: UserPromptSubmit, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/devin/user-prompt-submit.js\", type: file_exists }\n  - { host: devin, event: PreToolUse, path: \".opencode/skills/sk-git/scripts/hooks/git-preflight-advisory.mjs\", type: file_exists }\n  - { host: devin, event: Stop, path: \".opencode/skills/system-spec-kit/runtime/dist/hooks/devin/session-stop.js\", type: file_exists }\n\n# ─────────────────────────────────────────────────────────────────\n# INPUTS\n# ─────────────────────────────────────────────────────────────────\ninputs:\n  none: \"This diagnostic takes no arguments. Every checker derives its expected state from the canonical trees and the runtimes' own config files.\"\n\n# ─────────────────────────────────────────────────────────────────\n# EXECUTION\n# ─────────────────────────────────────────────────────────────────\nexecution:\n  steps:\n    - \"Run upstream_assets.runtime_mirrors with --check. Covers the cursor/devin agent, command and skill symlink trees plus all four hook discovery mirrors. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.codex_agents with --check. Covers the generated .codex/agents/*.toml. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.codex_prompts with --check. Covers the generated .codex/prompts/*.md stubs. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.agent_roster. Covers roster coverage across all five surfaces and rejects a real file where a symlink belongs. Exit 0 = in sync, 1 = drift, 2 = canonical dir missing.\"\n    - \"Run upstream_assets.codex_hooks_installer with --check. Covers the user-global ~/.codex/hooks.json against the repo's .codex/hooks.json, including orphaned entries whose .opencode adapter no longer exists on disk. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.pi_agents with --check. Covers the generated .pi/agents/*.md. Exit 0 = in sync, 1 = drift.\"\n    - \"Run upstream_assets.pi_prompts with --check. Covers the generated .pi/prompts/*.md stubs. Exit 0 = in sync, 1 = drift.\"\n    - \"For each row in hook_adapter_fallback_health_checks, run its file_exists check (a plain path-existence read, no execution of the adapter or the shell command that wraps it). Collect every row whose path does not resolve as a degraded hook adapter, keyed by host:event:path.\"\n    - \"Aggregate: report each surface with its own verdict rather than a single pass/fail, so the operator learns which mirror moved.\"\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT\n# ─────────────────────────────────────────────────────────────────\noutput: |\n  STATUS=OK when every checker reports in sync.\n  STATUS=DRIFT when any checker reports drift, listing each drifting surface and the repair command for it:\n    runtime mirrors  -> node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs\n    codex agents     -> node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs\n    codex prompts    -> node .opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs\n    codex hooks      -> node .opencode/bin/install-codex-hooks.mjs\n    pi agents        -> node .opencode/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs\n    pi prompts       -> node .opencode/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs\n  The agent roster check has no generator; its drift is repaired by the runtime-mirrors generator or by hand\n  for the authored surfaces (.opencode/agents, .codex/agents).\n  Hook CONFIG STRUCTURE is deliberately out of scope for mirroring: the four runtimes use incompatible event\n  vocabularies and entry shapes, so those files are hand-authored per runtime and cannot be mirror-checked\n  against each other.\n  Separately, \"N hook adapters degraded to fallback\" reports the count of hook_adapter_fallback_health_checks\n  rows whose path does not resolve, each listed as host:event:path. This is the same drift a live adapter\n  failure produces (its fallback JSON would carry \"mkHookDrift\": true and its stderr a matching\n  \"mk-hook-drift host=<host> event=<event> adapter=<name>\" line) surfaced without needing to fire the hook or\n  read raw JSON. Repair is adapter-specific: rebuild the runtime (npm --prefix\n  .opencode/skills/system-spec-kit/runtime run build) for a dist/hooks/* path, or restore/recreate the named\n  script for a .opencode/bin or .opencode/hooks path.","lineStart":1,"lineEnd":118,"totalLines":118,"truncated":false}},"title":".opencode/commands/doctor/assets/doctor-runtime-mirrors.yaml","time":{"start":1788620035175,"end":1788620035219}},"id":"prt_0720fd463001uJcz1Jd3ScX4Bz","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
{"type":"tool_use","timestamp":1788620035240,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_tjE3LHwxz5I8K4MUkAMarb7j","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs","offset":1,"limit":250},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ Sync Runtime Mirrors                                                     ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: //\n5: // Claude, Cursor, and Devin discover agents and commands by file convention,\n6: // each at its own path and in its own shape. Rather than fork the content, every\n7: // entry is a symlink back to one canonical file, so a mirror cannot drift from\n8: // what it mirrors. This script owns those symlink trees.\n9: //\n10: // A real file sitting where a symlink belongs is the failure this guards: it\n11: // still works today and silently stops tracking the source tomorrow. That is\n12: // reported as STALE, never quietly accepted.\n13: //\n14: // Hook mirrors are derived from each runtime's own hook config rather than a\n15: // hand-kept list, because the config is what the runtime actually executes; a\n16: // list would be one more thing to forget to update.\n17: \n18: 'use strict';\n19: \n20: // ───────────────────────────────────────────────────────────────\n21: // 1. IMPORTS\n22: // ───────────────────────────────────────────────────────────────\n23: \n24: const fs = require('node:fs');\n25: const path = require('node:path');\n26: const { isCanonicalMirrorExcluded, isRuntimeNativeCommand } = require('./command-scope.cjs');\n27: \n28: // ───────────────────────────────────────────────────────────────\n29: // 2. CONSTANTS\n30: // ───────────────────────────────────────────────────────────────\n31: \n32: const REPO_ROOT = path.resolve(__dirname, '../../../../../..');\n33: const EXCLUDED_COMMAND_DIRS = new Set(['assets', 'scripts', 'fixtures']);\n34: \n35: // Cursor and Devin parse the Claude agent dialect (`tools:`), not OpenCode's\n36: // `permission:` block, so agents deliberately source from .claude/agents.\n37: // Commands have no dialect split and source from .opencode directly.\n38: const CLAUDE_AGENTS = '.claude/agents';\n39: const CLAUDE_COMMANDS = '.claude/commands';\n40: const OPENCODE_COMMANDS = '.opencode/commands';\n41: \n42: const HOOK_CONFIGS = [\n43:   { runtime: 'claude', config: '.claude/settings.json', mirror: '.claude/hooks' },\n44:   { runtime: 'codex', config: '.codex/hooks.json', mirror: '.codex/hooks' },\n45:   { runtime: 'cursor', config: '.cursor/hooks.json', mirror: '.cursor/hooks' },\n46:   { runtime: 'devin', config: '.devin/hooks.v1.json', mirror: '.devin/hooks' },\n47: ];\n48: \n49: // ───────────────────────────────────────────────────────────────\n50: // 3. HELPERS\n51: // ───────────────────────────────────────────────────────────────\n52: \n53: function parseArguments(argv) {\n54:   if (argv.length === 0) {\n55:     return { check: false };\n56:   }\n57:   if (argv.length === 1 && argv[0] === '--check') {\n58:     return { check: true };\n59:   }\n60:   throw new Error('Usage: node sync-runtime-mirrors.cjs [--check]');\n61: }\n62: \n63: function listAgentNames() {\n64:   const dir = path.join(REPO_ROOT, CLAUDE_AGENTS);\n65:   if (!fs.existsSync(dir)) {\n66:     throw new Error(`No canonical agents found at ${CLAUDE_AGENTS}`);\n67:   }\n68:   return fs.readdirSync(dir, { withFileTypes: true })\n69:     .filter((e) => e.isFile() && e.name.endsWith('.md'))\n70:     .map((e) => e.name.slice(0, -3))\n71:     .sort();\n72: }\n73: \n74: function listCommandPaths() {\n75:   const root = path.join(REPO_ROOT, OPENCODE_COMMANDS);\n76:   if (!fs.existsSync(root)) {\n77:     throw new Error(`No canonical commands found at ${OPENCODE_COMMANDS}`);\n78:   }\n79:   const found = [];\n80:   const walk = (current) => {\n81:     for (const entry of fs.readdirSync(current, { withFileTypes: true })) {\n82:       const absolute = path.join(current, entry.name);\n83:       if (entry.isDirectory()) {\n84:         if (!EXCLUDED_COMMAND_DIRS.has(entry.name)) walk(absolute);\n85:         continue;\n86:       }\n87:       if (!entry.isFile() || !entry.name.endsWith('.md')) continue;\n88:       if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) continue;\n89:       found.push(path.relative(root, absolute).split(path.sep).join('/'));\n90:     }\n91:   };\n92:   walk(root);\n93:   return found.sort();\n94: }\n95: \n96: // `create/agent.md` -> `create-agent`: both runtimes expose a flat namespace,\n97: // so the directory separator collapses into the name.\n98: function toFlatName(relativePath) {\n99:   return relativePath.replace(/\\.md$/, '').split('/').join('-');\n100: }\n101: \n102: // Every path the runtime's own config actually invokes is a path its discovery\n103: // mirror should expose. Reading the raw text keeps this indifferent to the four\n104: // mutually incompatible config shapes.\n105: function hookSourcesFromConfig(configRelative) {\n106:   const absolute = path.join(REPO_ROOT, configRelative);\n107:   if (!fs.existsSync(absolute)) return [];\n108:   const raw = fs.readFileSync(absolute, 'utf8');\n109:   const matches = raw.match(/\\.opencode\\/[A-Za-z0-9_./-]+?\\.(?:mjs|cjs|js|sh|py)/g) || [];\n110:   return [...new Set(matches)].sort();\n111: }\n112: \n113: // Each entry: { mirror: repo-relative path of the symlink, source: repo-relative target }\n114: function buildExpectedLinks() {\n115:   const links = [];\n116:   const agents = listAgentNames();\n117:   const commands = listCommandPaths();\n118: \n119:   for (const name of agents) {\n120:     const source = `${CLAUDE_AGENTS}/${name}.md`;\n121:     links.push({ tree: 'cursor-agents', mirror: `.cursor/agents/${name}.md`, source });\n122:     links.push({ tree: 'devin-agents', mirror: `.devin/agents/${name}/AGENT.md`, source });\n123:   }\n124: \n125:   for (const relativePath of commands) {\n126:     // Runtime-exclusive commands (the goal triggers) are not cross-mirrored; each\n127:     // runtime carries only its own hand-authored native command instead.\n128:     if (isCanonicalMirrorExcluded(relativePath)) continue;\n129:     const source = `${OPENCODE_COMMANDS}/${relativePath}`;\n130:     const flat = toFlatName(relativePath);\n131:     links.push({ tree: 'claude-commands', mirror: `${CLAUDE_COMMANDS}/${relativePath}`, source });\n132:     links.push({ tree: 'cursor-commands', mirror: `.cursor/commands/${flat}.md`, source });\n133:   }\n134: \n135:   for (const { runtime, config, mirror } of HOOK_CONFIGS) {\n136:     for (const source of hookSourcesFromConfig(config)) {\n137:       links.push({ tree: `${runtime}-hooks`, mirror: `${mirror}/${path.posix.basename(source)}`, source });\n138:     }\n139:   }\n140: \n141:   if (links.length === 0) throw new Error('No expected mirrors were derived');\n142:   return links;\n143: }\n144: \n145: // Mirrors are relative symlinks so the tree stays valid when the repo moves.\n146: function expectedTarget(mirrorRelative, sourceRelative) {\n147:   return path.relative(\n148:     path.dirname(path.join(REPO_ROOT, mirrorRelative)),\n149:     path.join(REPO_ROOT, sourceRelative),\n150:   );\n151: }\n152: \n153: /** Build output is regenerated, never committed, so its absence is not drift. */\n154: function isBuildArtifact(target) {\n155:   return target.split('/').includes('dist');\n156: }\n157: \n158: function inspect(link) {\n159:   const absolute = path.join(REPO_ROOT, link.mirror);\n160:   let stat = null;\n161:   try {\n162:     stat = fs.lstatSync(absolute);\n163:   } catch (err) {\n164:     if (err.code !== 'ENOENT') throw err;\n165:     return { state: 'MISSING' };\n166:   }\n167:   if (!stat.isSymbolicLink()) return { state: 'STALE', why: 'not a symlink (silent fork risk)' };\n168:   const want = expectedTarget(link.mirror, link.source);\n169:   const actual = fs.readlinkSync(absolute);\n170:   if (actual !== want) return { state: 'STALE', why: `points at ${actual}, expected ${want}` };\n171:   // A mirror aimed at the right place but resolving to nothing is either a deleted source\n172:   // or an unbuilt artifact, and only the first is drift. Build output is gitignored, so a\n173:   // fresh checkout has none of it — treating that as drift makes this gate fail on every\n174:   // run in CI while passing on any machine that happens to have built, which reports\n175:   // build state as mirror integrity and trains readers to ignore the result.\n176:   if (!fs.existsSync(absolute) && !isBuildArtifact(want)) {\n177:     return { state: 'STALE', why: 'broken symlink (source is gone)' };\n178:   }\n179:   return { state: 'OK' };\n180: }\n181: \n182: // A mirror with no canonical source keeps serving something the roster dropped.\n183: function findOrphans(expectedLinks) {\n184:   const expectedByDir = new Map();\n185:   for (const link of expectedLinks) {\n186:     const dir = path.posix.dirname(link.mirror);\n187:     if (!expectedByDir.has(dir)) expectedByDir.set(dir, new Set());\n188:     expectedByDir.get(dir).add(path.posix.basename(link.mirror));\n189:   }\n190: \n191:   const orphans = [];\n192:   for (const [dir, names] of expectedByDir) {\n193:     const absoluteDir = path.join(REPO_ROOT, dir);\n194:     if (!fs.existsSync(absoluteDir)) continue;\n195:     for (const entry of fs.readdirSync(absoluteDir, { withFileTypes: true })) {\n196:       if (entry.name === 'README.md' || entry.name === 'README.txt' || entry.name.startsWith('.')) continue;\n197:       // Nested trees (devin) hold one dir per item; flat trees hold files/symlinks.\n198:       if (entry.isDirectory()) continue;\n199:       // A runtime's own hand-authored native command is deliberately not a mirror.\n200:       if (isRuntimeNativeCommand(dir, entry.name)) continue;\n201:       if (!names.has(entry.name)) orphans.push(path.posix.join(dir, entry.name));\n202:     }\n203:   }\n204: \n205:   // Devin nests each item in its own directory, so an orphan there is a whole dir.\n206:   for (const parent of ['.devin/agents', '.devin/skills']) {\n207:     const absoluteParent = path.join(REPO_ROOT, parent);\n208:     if (!fs.existsSync(absoluteParent)) continue;\n209:     const leaf = parent.endsWith('agents') ? 'AGENT.md' : 'SKILL.md';\n210:     const wanted = new Set(\n211:       expectedLinks\n212:         .filter((l) => l.mirror.startsWith(`${parent}/`))\n213:         .map((l) => l.mirror.split('/')[2]),\n214:     );\n215:     for (const entry of fs.readdirSync(absoluteParent, { withFileTypes: true })) {\n216:       if (!entry.isDirectory() || entry.name.startsWith('.')) continue;\n217:       // A hand-authored native skill in this tree is not a mirror.\n218:       if (isRuntimeNativeCommand(parent, entry.name)) continue;\n219:       if (!wanted.has(entry.name)) orphans.push(`${parent}/${entry.name}/${leaf}`);\n220:     }\n221:   }\n222: \n223:   return orphans.sort();\n224: }\n225: \n226: // ───────────────────────────────────────────────────────────────\n227: // 4. SYNC EXECUTION\n228: // ───────────────────────────────────────────────────────────────\n229: \n230: function checkMirrors(expectedLinks) {\n231:   const drift = [];\n232:   const claudeCommandsRoot = path.join(REPO_ROOT, CLAUDE_COMMANDS);\n233:   try {\n234:     const rootStat = fs.lstatSync(claudeCommandsRoot);\n235:     if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) {\n236:       drift.push(`STALE ${CLAUDE_COMMANDS} — must be a real filtered command directory`);\n237:     }\n238:   } catch (error) {\n239:     if (error?.code === 'ENOENT') drift.push(`MISSING ${CLAUDE_COMMANDS}`);\n240:     else throw error;\n241:   }\n242:   for (const link of expectedLinks) {\n243:     const result = inspect(link);\n244:     if (result.state === 'MISSING') drift.push(`MISSING ${link.mirror}`);\n245:     else if (result.state === 'STALE') drift.push(`STALE ${link.mirror} — ${result.why}`);\n246:   }\n247:   for (const orphan of findOrphans(expectedLinks)) drift.push(`EXTRA ${orphan}`);\n248: \n249:   if (drift.length > 0) {\n250:     console.error('[runtime-mirror-sync] Drift detected:');\n\n(Showing lines 1-250 of 319. Use offset=251 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Sync Runtime Mirrors                                                     ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n//\n// Claude, Cursor, and Devin discover agents and commands by file convention,\n// each at its own path and in its own shape. Rather than fork the content, every\n// entry is a symlink back to one canonical file, so a mirror cannot drift from\n// what it mirrors. This script owns those symlink trees.\n//\n// A real file sitting where a symlink belongs is the failure this guards: it\n// still works today and silently stops tracking the source tomorrow. That is\n// reported as STALE, never quietly accepted.\n//\n// Hook mirrors are derived from each runtime's own hook config rather than a\n// hand-kept list, because the config is what the runtime actually executes; a\n// list would be one more thing to forget to update.\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Sync Runtime Mirrors                                                     ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n//\n// Claude, Cursor, and Devin discover agents and commands by file convention,\n// each at its own path and in its own shape. Rather than fork the content, every\n// entry is a symlink back to one canonical file, so a mirror cannot drift from\n// what it mirrors. This script owns those symlink trees.\n//\n// A real file sitting where a symlink belongs is the failure this guards: it\n// still works today and silently stops tracking the source tomorrow. That is\n// reported as STALE, never quietly accepted.\n//\n// Hook mirrors are derived from each runtime's own hook config rather than a\n// hand-kept list, because the config is what the runtime actually executes; a\n// list would be one more thing to forget to update.\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { isCanonicalMirrorExcluded, isRuntimeNativeCommand } = require('./command-scope.cjs');\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst REPO_ROOT = path.resolve(__dirname, '../../../../../..');\nconst EXCLUDED_COMMAND_DIRS = new Set(['assets', 'scripts', 'fixtures']);\n\n// Cursor and Devin parse the Claude agent dialect (`tools:`), not OpenCode's\n// `permission:` block, so agents deliberately source from .claude/agents.\n// Commands have no dialect split and source from .opencode directly.\nconst CLAUDE_AGENTS = '.claude/agents';\nconst CLAUDE_COMMANDS = '.claude/commands';\nconst OPENCODE_COMMANDS = '.opencode/commands';\n\nconst HOOK_CONFIGS = [\n  { runtime: 'claude', config: '.claude/settings.json', mirror: '.claude/hooks' },\n  { runtime: 'codex', config: '.codex/hooks.json', mirror: '.codex/hooks' },\n  { runtime: 'cursor', config: '.cursor/hooks.json', mirror: '.cursor/hooks' },\n  { runtime: 'devin', config: '.devin/hooks.v1.json', mirror: '.devin/hooks' },\n];\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\n\nfunction parseArguments(argv) {\n  if (argv.length === 0) {\n    return { check: false };\n  }\n  if (argv.length === 1 && argv[0] === '--check') {\n    return { check: true };\n  }\n  throw new Error('Usage: node sync-runtime-mirrors.cjs [--check]');\n}\n\nfunction listAgentNames() {\n  const dir = path.join(REPO_ROOT, CLAUDE_AGENTS);\n  if (!fs.existsSync(dir)) {\n    throw new Error(`No canonical agents found at ${CLAUDE_AGENTS}`);\n  }\n  return fs.readdirSync(dir, { withFileTypes: true })\n    .filter((e) => e.isFile() && e.name.endsWith('.md'))\n    .map((e) => e.name.slice(0, -3))\n    .sort();\n}\n\nfunction listCommandPaths() {\n  const root = path.join(REPO_ROOT, OPENCODE_COMMANDS);\n  if (!fs.existsSync(root)) {\n    throw new Error(`No canonical commands found at ${OPENCODE_COMMANDS}`);\n  }\n  const found = [];\n  const walk = (current) => {\n    for (const entry of fs.readdirSync(current, { withFileTypes: true })) {\n      const absolute = path.join(current, entry.name);\n      if (entry.isDirectory()) {\n        if (!EXCLUDED_COMMAND_DIRS.has(entry.name)) walk(absolute);\n        continue;\n      }\n      if (!entry.isFile() || !entry.name.endsWith('.md')) continue;\n      if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) continue;\n      found.push(path.relative(root, absolute).split(path.sep).join('/'));\n    }\n  };\n  walk(root);\n  return found.sort();\n}\n\n// `create/agent.md` -> `create-agent`: both runtimes expose a flat namespace,\n// so the directory separator collapses into the name.\nfunction toFlatName(relativePath) {\n  return relativePath.replace(/\\.md$/, '').split('/').join('-');\n}\n\n// Every path the runtime's own config actually invokes is a path its discovery\n// mirror should expose. Reading the raw text keeps this indifferent to the four\n// mutually incompatible config shapes.\nfunction hookSourcesFromConfig(configRelative) {\n  const absolute = path.join(REPO_ROOT, configRelative);\n  if (!fs.existsSync(absolute)) return [];\n  const raw = fs.readFileSync(absolute, 'utf8');\n  const matches = raw.match(/\\.opencode\\/[A-Za-z0-9_./-]+?\\.(?:mjs|cjs|js|sh|py)/g) || [];\n  return [...new Set(matches)].sort();\n}\n\n// Each entry: { mirror: repo-relative path of the symlink, source: repo-relative target }\nfunction buildExpectedLinks() {\n  const links = [];\n  const agents = listAgentNames();\n  const commands = listCommandPaths();\n\n  for (const name of agents) {\n    const source = `${CLAUDE_AGENTS}/${name}.md`;\n    links.push({ tree: 'cursor-agents', mirror: `.cursor/agents/${name}.md`, source });\n    links.push({ tree: 'devin-agents', mirror: `.devin/agents/${name}/AGENT.md`, source });\n  }\n\n  for (const relativePath of commands) {\n    // Runtime-exclusive commands (the goal triggers) are not cross-mirrored; each\n    // runtime carries only its own hand-authored native command instead.\n    if (isCanonicalMirrorExcluded(relativePath)) continue;\n    const source = `${OPENCODE_COMMANDS}/${relativePath}`;\n    const flat = toFlatName(relativePath);\n    links.push({ tree: 'claude-commands', mirror: `${CLAUDE_COMMANDS}/${relativePath}`, source });\n    links.push({ tree: 'cursor-commands', mirror: `.cursor/commands/${flat}.md`, source });\n  }\n\n  for (const { runtime, config, mirror } of HOOK_CONFIGS) {\n    for (const source of hookSourcesFromConfig(config)) {\n      links.push({ tree: `${runtime}-hooks`, mirror: `${mirror}/${path.posix.basename(source)}`, source });\n    }\n  }\n\n  if (links.length === 0) throw new Error('No expected mirrors were derived');\n  return links;\n}\n\n// Mirrors are relative symlinks so the tree stays valid when the repo moves.\nfunction expectedTarget(mirrorRelative, sourceRelative) {\n  return path.relative(\n    path.dirname(path.join(REPO_ROOT, mirrorRelative)),\n    path.join(REPO_ROOT, sourceRelative),\n  );\n}\n\n/** Build output is regenerated, never committed, so its absence is not drift. */\nfunction isBuildArtifact(target) {\n  return target.split('/').includes('dist');\n}\n\nfunction inspect(link) {\n  const absolute = path.join(REPO_ROOT, link.mirror);\n  let stat = null;\n  try {\n    stat = fs.lstatSync(absolute);\n  } catch (err) {\n    if (err.code !== 'ENOENT') throw err;\n    return { state: 'MISSING' };\n  }\n  if (!stat.isSymbolicLink()) return { state: 'STALE', why: 'not a symlink (silent fork risk)' };\n  const want = expectedTarget(link.mirror, link.source);\n  const actual = fs.readlinkSync(absolute);\n  if (actual !== want) return { state: 'STALE', why: `points at ${actual}, expected ${want}` };\n  // A mirror aimed at the right place but resolving to nothing is either a deleted source\n  // or an unbuilt artifact, and only the first is drift. Build output is gitignored, so a\n  // fresh checkout has none of it — treating that as drift makes this gate fail on every\n  // run in CI while passing on any machine that happens to have built, which reports\n  // build state as mirror integrity and trains readers to ignore the result.\n  if (!fs.existsSync(absolute) && !isBuildArtifact(want)) {\n    return { state: 'STALE', why: 'broken symlink (source is gone)' };\n  }\n  return { state: 'OK' };\n}\n\n// A mirror with no canonical source keeps serving something the roster dropped.\nfunction findOrphans(expectedLinks) {\n  const expectedByDir = new Map();\n  for (const link of expectedLinks) {\n    const dir = path.posix.dirname(link.mirror);\n    if (!expectedByDir.has(dir)) expectedByDir.set(dir, new Set());\n    expectedByDir.get(dir).add(path.posix.basename(link.mirror));\n  }\n\n  const orphans = [];\n  for (const [dir, names] of expectedByDir) {\n    const absoluteDir = path.join(REPO_ROOT, dir);\n    if (!fs.existsSync(absoluteDir)) continue;\n    for (const entry of fs.readdirSync(absoluteDir, { withFileTypes: true })) {\n      if (entry.name === 'README.md' || entry.name === 'README.txt' || entry.name.startsWith('.')) continue;\n      // Nested trees (devin) hold one dir per item; flat trees hold files/symlinks.\n      if (entry.isDirectory()) continue;\n      // A runtime's own hand-authored native command is deliberately not a mirror.\n      if (isRuntimeNativeCommand(dir, entry.name)) continue;\n      if (!names.has(entry.name)) orphans.push(path.posix.join(dir, entry.name));\n    }\n  }\n\n  // Devin nests each item in its own directory, so an orphan there is a whole dir.\n  for (const parent of ['.devin/agents', '.devin/skills']) {\n    const absoluteParent = path.join(REPO_ROOT, parent);\n    if (!fs.existsSync(absoluteParent)) continue;\n    const leaf = parent.endsWith('agents') ? 'AGENT.md' : 'SKILL.md';\n    const wanted = new Set(\n      expectedLinks\n        .filter((l) => l.mirror.startsWith(`${parent}/`))\n        .map((l) => l.mirror.split('/')[2]),\n    );\n    for (const entry of fs.readdirSync(absoluteParent, { withFileTypes: true })) {\n      if (!entry.isDirectory() || entry.name.startsWith('.')) continue;\n      // A hand-authored native skill in this tree is not a mirror.\n      if (isRuntimeNativeCommand(parent, entry.name)) continue;\n      if (!wanted.has(entry.name)) orphans.push(`${parent}/${entry.name}/${leaf}`);\n    }\n  }\n\n  return orphans.sort();\n}\n\n// ───────────────────────────────────────────────────────────────\n// 4. SYNC EXECUTION\n// ───────────────────────────────────────────────────────────────\n\nfunction checkMirrors(expectedLinks) {\n  const drift = [];\n  const claudeCommandsRoot = path.join(REPO_ROOT, CLAUDE_COMMANDS);\n  try {\n    const rootStat = fs.lstatSync(claudeCommandsRoot);\n    if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) {\n      drift.push(`STALE ${CLAUDE_COMMANDS} — must be a real filtered command directory`);\n    }\n  } catch (error) {\n    if (error?.code === 'ENOENT') drift.push(`MISSING ${CLAUDE_COMMANDS}`);\n    else throw error;\n  }\n  for (const link of expectedLinks) {\n    const result = inspect(link);\n    if (result.state === 'MISSING') drift.push(`MISSING ${link.mirror}`);\n    else if (result.state === 'STALE') drift.push(`STALE ${link.mirror} — ${result.why}`);\n  }\n  for (const orphan of findOrphans(expectedLinks)) drift.push(`EXTRA ${orphan}`);\n\n  if (drift.length > 0) {\n    console.error('[runtime-mirror-sync] Drift detected:');","lineStart":1,"lineEnd":250,"totalLines":319,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs","time":{"start":1788620035167,"end":1788620035223}},"id":"prt_0720fd45b001hUOvCJn5ZbQ349","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
{"type":"tool_use","timestamp":1788620035240,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_C1m0bFTHxkjKnH1JdXu6k3ZL","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/scripts/fable-mode-check.cjs","offset":1,"limit":200},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/scripts/fable-mode-check.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: // Read-only /doctor fable-mode diagnostic. Renders the current fable-5 behavioral\n5: // metrics for a deep-loop artifact dir and compares them to the captured baseline.\n6: // It never writes — a /doctor run is read-only by contract. Exit 0 on success,\n7: // 2 when the target dir is missing.\n8: \n9: const fs = require('node:fs');\n10: const path = require('node:path');\n11: const { discoverLineages, measureLineage, aggregate } = require('../../../skills/system-spec-kit/runtime/cli/metrics/fable-metrics.cjs');\n12: \n13: const DEFAULT_TARGET = path.resolve(__dirname, '../../../specs/skilled-agent-orchestration/144-operate-like-fable-5/002-fable-mode-efficiency-research/research');\n14: const DEFAULT_BASELINE = path.resolve(__dirname, '../../../skills/system-spec-kit/runtime/cli/metrics/fable-baseline.json');\n15: \n16: function flag(name) { const i = process.argv.indexOf(name); return i !== -1 ? process.argv[i + 1] : null; }\n17: \n18: function main() {\n19:   const positional = process.argv.slice(2).find((a) => a[0] !== '-');\n20:   const target = path.resolve(flag('--dir') || positional || DEFAULT_TARGET);\n21:   const baselinePath = path.resolve(flag('--baseline') || DEFAULT_BASELINE);\n22: \n23:   if (!fs.existsSync(target)) {\n24:     console.error(`STATUS=ERROR fable-mode: target not found: ${target}`);\n25:     process.exit(2);\n26:   }\n27: \n28:   const lineages = discoverLineages(target).map((e) => measureLineage(e.dir, e.name));\n29:   const cur = aggregate(lineages);\n30:   let base = null;\n31:   try { base = JSON.parse(fs.readFileSync(baselinePath, 'utf8')).aggregate; } catch { /* baseline is optional */ }\n32: \n33:   const fmt = (v) => (v == null ? 'INSUFFICIENT' : String(v));\n34:   const delta = (c, b) => (c == null || b == null ? '' : `  (Δ ${Math.round((c - b) * 100) / 100})`);\n35: \n36:   console.log('\\n/doctor fable-mode — read-only behavioral metrics');\n37:   console.log(`target:   ${target}`);\n38:   console.log(`baseline: ${base ? baselinePath : '(none loaded)'}\\n`);\n39:   const rows = [\n40:     ['tool:text ratio (mean)', 'toolTextRatio_mean'],\n41:     ['median words/msg', 'medianWordsPerMsg_median'],\n42:     ['self-opener %', 'selfOpenerPct_mean'],\n43:     ['unsolicited-caveat %', 'unsolicitedCaveatPct_mean'],\n44:     ['evidence-backed completion', 'evidenceBackedCompletionRatio_mean'],\n45:   ];\n46:   for (const [label, key] of rows) {\n47:     const c = cur[key];\n48:     const b = base ? base[key] : null;\n49:     console.log(`  ${label.padEnd(28)} ${fmt(c)}${base ? delta(c, b) : ''}${b != null ? `   [baseline ${fmt(b)}]` : ''}`);\n50:   }\n51:   console.log(`\\n  lineages: ${cur.lineagesMeasured} (${cur.lineagesWithStream} with a rich JSON stream)`);\n52:   console.log('  note: drift detectors, not quality scores — higher tool:text + evidence, lower words/opener/caveat = closer to the fable-5 signature.\\n');\n53:   console.log('STATUS=OK fable-mode read-only diagnostic complete');\n54:   process.exit(0);\n55: }\n56: \n57: main();\n\n(End of file - total 57 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\n// Read-only /doctor fable-mode diagnostic. Renders the current fable-5 behavioral\n// metrics for a deep-loop artifact dir and compares them to the captured baseline.\n// It never writes — a /doctor run is read-only by contract. Exit 0 on success,\n// 2 when the target dir is missing.\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { discoverLineages, measureLineage, aggregate } = require('../../../skills/system-spec-kit/runtime/cli/metrics/fable-metrics.cjs');\n\nconst DEFAULT_TARGET = path.resolve(__dirname, '../../../specs/skilled-agent-orchestration/144-operate-like-fable-5/002-fable-mode-efficiency-research/research');\nconst DEFAULT_BASELINE = path.resolve(__dirname, '../../../skills/system-spec-kit/runtime/cli/metrics/fable-baseline.json');\n\nfunction flag(name) { const i = process.argv.indexOf(name); return i !== -1 ? process.argv[i + 1] : null; }\n\nfunction main() {\n  const positional = process.argv.slice(2).find((a) => a[0] !== '-');\n  const target = path.resolve(flag('--dir') || positional || DEFAULT_TARGET);","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/scripts/fable-mode-check.cjs","text":"#!/usr/bin/env node\n'use strict';\n\n// Read-only /doctor fable-mode diagnostic. Renders the current fable-5 behavioral\n// metrics for a deep-loop artifact dir and compares them to the captured baseline.\n// It never writes — a /doctor run is read-only by contract. Exit 0 on success,\n// 2 when the target dir is missing.\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { discoverLineages, measureLineage, aggregate } = require('../../../skills/system-spec-kit/runtime/cli/metrics/fable-metrics.cjs');\n\nconst DEFAULT_TARGET = path.resolve(__dirname, '../../../specs/skilled-agent-orchestration/144-operate-like-fable-5/002-fable-mode-efficiency-research/research');\nconst DEFAULT_BASELINE = path.resolve(__dirname, '../../../skills/system-spec-kit/runtime/cli/metrics/fable-baseline.json');\n\nfunction flag(name) { const i = process.argv.indexOf(name); return i !== -1 ? process.argv[i + 1] : null; }\n\nfunction main() {\n  const positional = process.argv.slice(2).find((a) => a[0] !== '-');\n  const target = path.resolve(flag('--dir') || positional || DEFAULT_TARGET);\n  const baselinePath = path.resolve(flag('--baseline') || DEFAULT_BASELINE);\n\n  if (!fs.existsSync(target)) {\n    console.error(`STATUS=ERROR fable-mode: target not found: ${target}`);\n    process.exit(2);\n  }\n\n  const lineages = discoverLineages(target).map((e) => measureLineage(e.dir, e.name));\n  const cur = aggregate(lineages);\n  let base = null;\n  try { base = JSON.parse(fs.readFileSync(baselinePath, 'utf8')).aggregate; } catch { /* baseline is optional */ }\n\n  const fmt = (v) => (v == null ? 'INSUFFICIENT' : String(v));\n  const delta = (c, b) => (c == null || b == null ? '' : `  (Δ ${Math.round((c - b) * 100) / 100})`);\n\n  console.log('\\n/doctor fable-mode — read-only behavioral metrics');\n  console.log(`target:   ${target}`);\n  console.log(`baseline: ${base ? baselinePath : '(none loaded)'}\\n`);\n  const rows = [\n    ['tool:text ratio (mean)', 'toolTextRatio_mean'],\n    ['median words/msg', 'medianWordsPerMsg_median'],\n    ['self-opener %', 'selfOpenerPct_mean'],\n    ['unsolicited-caveat %', 'unsolicitedCaveatPct_mean'],\n    ['evidence-backed completion', 'evidenceBackedCompletionRatio_mean'],\n  ];\n  for (const [label, key] of rows) {\n    const c = cur[key];\n    const b = base ? base[key] : null;\n    console.log(`  ${label.padEnd(28)} ${fmt(c)}${base ? delta(c, b) : ''}${b != null ? `   [baseline ${fmt(b)}]` : ''}`);\n  }\n  console.log(`\\n  lineages: ${cur.lineagesMeasured} (${cur.lineagesWithStream} with a rich JSON stream)`);\n  console.log('  note: drift detectors, not quality scores — higher tool:text + evidence, lower words/opener/caveat = closer to the fable-5 signature.\\n');\n  console.log('STATUS=OK fable-mode read-only diagnostic complete');\n  process.exit(0);\n}\n\nmain();","lineStart":1,"lineEnd":57,"totalLines":57,"truncated":false}},"title":".opencode/commands/doctor/scripts/fable-mode-check.cjs","time":{"start":1788620035184,"end":1788620035226}},"id":"prt_0720fd46c001ZQ78PIHJqPqfPi","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
{"type":"tool_use","timestamp":1788620035240,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_ox2qLaHkVZQccuNeA3lOxQbi","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh","offset":1,"limit":250},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: # Prepare the system-spec-kit runtime before /doctor:update asks OpenCode for MCP tools.\n3: set -euo pipefail\n4: \n5: ROOT=\"\"\n6: JSON_MODE=false\n7: \n8: while [[ $# -gt 0 ]]; do\n9:   case \"$1\" in\n10:     --root)\n11:       if [[ $# -lt 2 ]]; then\n12:         echo \"doctor-runtime-bootstrap: --root requires a path\" >&2\n13:         exit 2\n14:       fi\n15:       ROOT=\"$2\"\n16:       shift 2\n17:       ;;\n18:     --json)\n19:       JSON_MODE=true\n20:       shift\n21:       ;;\n22:     --help|-h)\n23:       cat <<'HELP'\n24: Usage: bash .opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh [--root <workspace>] [--json]\n25: \n26: Migrates a legacy .opencode/skill directory into .opencode/skills when present,\n27: installs system-spec-kit workspace dependencies, and builds the MCP server and\n28: script runtimes needed by /doctor:update.\n29: HELP\n30:       exit 0\n31:       ;;\n32:     *)\n33:       echo \"doctor-runtime-bootstrap: unknown option: $1\" >&2\n34:       exit 2\n35:       ;;\n36:   esac\n37: done\n38: \n39: if [[ -z \"$ROOT\" ]]; then\n40:   ROOT=\"$(pwd)\"\n41: fi\n42: ROOT=\"$(cd \"$ROOT\" && pwd)\"\n43: \n44: OPENCODE_DIR=\"$ROOT/.opencode\"\n45: SKILLS_DIR=\"$OPENCODE_DIR/skills\"\n46: LEGACY_SKILL_DIR=\"$OPENCODE_DIR/skill\"\n47: KIT_DIR=\"$SKILLS_DIR/system-spec-kit\"\n48: # Runtime state for /doctor:update. It lives in the advisor's database directory\n49: # because that one is tracked and gitignore-managed; the spec-kit runtime/database\n50: # directory that used to hold it left with its server and is absent on a fresh clone.\n51: DB_DIR=\"$SKILLS_DIR/system-skill-advisor/mcp-server/database\"\n52: STATE_FILE=\"$DB_DIR/.doctor-update.bootstrap.json\"\n53: LOCK_FILE=\"/tmp/doctor-runtime-bootstrap.lock\"\n54: GRAPH_BACKFILL_DIST=\"$KIT_DIR/runtime/cli/dist/graph/backfill-graph-metadata.js\"\n55: DESCRIPTION_DIST=\"$KIT_DIR/runtime/cli/dist/spec-folder/generate-description.js\"\n56: \n57: started_at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n58: actions_file=\"$(mktemp \"${TMPDIR:-/tmp}/doctor-runtime-bootstrap-actions.XXXXXX\")\"\n59: restart_required=false\n60: \n61: finish_state() {\n62:   local status=\"$1\"\n63:   local message=\"${2:-}\"\n64:   local ended_at\n65:   ended_at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n66: \n67:   mkdir -p \"$DB_DIR\"\n68:   STARTED_AT=\"$started_at\" \\\n69:   ENDED_AT=\"$ended_at\" \\\n70:   STATUS=\"$status\" \\\n71:   MESSAGE=\"$message\" \\\n72:   RESTART_REQUIRED=\"$restart_required\" \\\n73:   ACTIONS_FILE=\"$actions_file\" \\\n74:   STATE_FILE=\"$STATE_FILE\" \\\n75:   node <<'NODE'\n76: const fs = require('fs');\n77: \n78: const actions = fs.existsSync(process.env.ACTIONS_FILE)\n79:   ? fs.readFileSync(process.env.ACTIONS_FILE, 'utf8').split('\\n').filter(Boolean)\n80:   : [];\n81: \n82: const payload = {\n83:   command: '/doctor:update',\n84:   phase: 'runtime-bootstrap',\n85:   start: process.env.STARTED_AT,\n86:   end: process.env.ENDED_AT,\n87:   status: process.env.STATUS,\n88:   restart_required: process.env.RESTART_REQUIRED === 'true',\n89:   actions,\n90: };\n91: \n92: if (process.env.MESSAGE) {\n93:   payload.message = process.env.MESSAGE;\n94: }\n95: \n96: fs.writeFileSync(process.env.STATE_FILE, `${JSON.stringify(payload, null, 2)}\\n`);\n97: NODE\n98: }\n99: \n100: cleanup() {\n101:   rm -f \"$actions_file\"\n102: }\n103: trap cleanup EXIT\n104: \n105: record_action() {\n106:   printf '%s\\n' \"$1\" >> \"$actions_file\"\n107: }\n108: \n109: emit() {\n110:   if [[ \"$JSON_MODE\" == true ]]; then\n111:     node -e \"const fs=require('fs'); process.stdout.write(fs.readFileSync(process.argv[1], 'utf8'))\" \"$STATE_FILE\"\n112:   else\n113:     echo \"$1\"\n114:   fi\n115: }\n116: \n117: fail() {\n118:   local message=\"$1\"\n119:   finish_state \"failed\" \"$message\"\n120:   emit \"BOOTSTRAP_FAILED restart_required=$restart_required state_log=$STATE_FILE message=$message\"\n121:   exit 1\n122: }\n123: \n124: if [[ ! -d \"$OPENCODE_DIR\" ]]; then\n125:   echo \"doctor-runtime-bootstrap: .opencode directory not found under $ROOT\" >&2\n126:   exit 1\n127: fi\n128: \n129: mkdir -p \"$DB_DIR\"\n130: exec 9>\"$LOCK_FILE\"\n131: if ! flock -n 9; then\n132:   printf '[doctor-bootstrap] Another bootstrap is in progress (lock %s held). Exiting.\\n' \"$LOCK_FILE\" >&2\n133:   exit 0\n134: fi\n135: \n136: # Migrate a real legacy .opencode/skill directory into the canonical .opencode/skills\n137: # layout. Every launcher and config resolves the plural path directly, so the singular\n138: # .opencode/skill compatibility symlink is unnecessary. The bootstrap no longer creates it,\n139: # and a layout move alone never forces a restart -- the old code recreated the shim whenever\n140: # it was absent and looped restart_required, blocking the rebuild. A genuine fresh install\n141: # still restarts via the dist build step below.\n142: if [[ ! -d \"$SKILLS_DIR\" && -d \"$LEGACY_SKILL_DIR\" && ! -L \"$LEGACY_SKILL_DIR\" ]]; then\n143:   mv \"$LEGACY_SKILL_DIR\" \"$SKILLS_DIR\"\n144:   record_action \"promoted legacy .opencode/skill directory to .opencode/skills\"\n145: elif [[ -d \"$SKILLS_DIR\" && -d \"$LEGACY_SKILL_DIR\" && ! -L \"$LEGACY_SKILL_DIR\" ]]; then\n146:   backup=\"$OPENCODE_DIR/skill_legacy_backup_$(date -u +%Y%m%dT%H%M%SZ)\"\n147:   mv \"$LEGACY_SKILL_DIR\" \"$backup\"\n148:   record_action \"moved stray legacy .opencode/skill directory to ${backup#$ROOT/}\"\n149: fi\n150: \n151: KIT_DIR=\"$SKILLS_DIR/system-spec-kit\"\n152: DB_DIR=\"$SKILLS_DIR/system-skill-advisor/mcp-server/database\"\n153: STATE_FILE=\"$DB_DIR/.doctor-update.bootstrap.json\"\n154: GRAPH_BACKFILL_DIST=\"$KIT_DIR/runtime/cli/dist/graph/backfill-graph-metadata.js\"\n155: DESCRIPTION_DIST=\"$KIT_DIR/runtime/cli/dist/spec-folder/generate-description.js\"\n156: \n157: if [[ ! -d \"$KIT_DIR\" ]]; then\n158:   fail \"system-spec-kit not found at $KIT_DIR\"\n159: fi\n160: \n161: if ! command -v node >/dev/null 2>&1; then\n162:   fail \"node is required to build system-spec-kit\"\n163: fi\n164: if ! command -v npm >/dev/null 2>&1; then\n165:   fail \"npm is required to build system-spec-kit\"\n166: fi\n167: \n168: need_build=false\n169: if [[ ! -f \"$GRAPH_BACKFILL_DIST\" || ! -f \"$DESCRIPTION_DIST\" ]]; then\n170:   need_build=true\n171:   record_action \"detected missing runtime/cli/dist migration helpers\"\n172: fi\n173: \n174: if [[ \"$need_build\" == true ]]; then\n175:   if [[ \"$JSON_MODE\" == true ]]; then\n176:     (\n177:       cd \"$KIT_DIR\"\n178:       if [[ -f package-lock.json ]]; then\n179:         npm ci --no-fund --silent\n180:       else\n181:         npm install --no-fund --silent\n182:       fi\n183:       npm audit --audit-level=high || {\n184:         printf '[doctor-bootstrap] WARNING: npm audit found high-severity issues. Continuing bootstrap; investigate at next opportunity.\\n' >&2\n185:       }\n186:       npm run build --workspace=@spec-kit/runtime\n187:       npm run build --workspace=@spec-kit/cli\n188:     ) >&2\n189:   else\n190:     (\n191:       cd \"$KIT_DIR\"\n192:       if [[ -f package-lock.json ]]; then\n193:         npm ci --no-fund --silent\n194:       else\n195:         npm install --no-fund --silent\n196:       fi\n197:       npm audit --audit-level=high || {\n198:         printf '[doctor-bootstrap] WARNING: npm audit found high-severity issues. Continuing bootstrap; investigate at next opportunity.\\n' >&2\n199:       }\n200:       npm run build --workspace=@spec-kit/runtime\n201:       npm run build --workspace=@spec-kit/cli\n202:     )\n203:   fi\n204:   restart_required=true\n205:   record_action \"installed dependencies and built @spec-kit/runtime plus @spec-kit/cli\"\n206: fi\n207: \n208: [[ -f \"$GRAPH_BACKFILL_DIST\" ]] || fail \"runtime/cli/dist/graph/backfill-graph-metadata.js is still missing after bootstrap\"\n209: [[ -f \"$DESCRIPTION_DIST\" ]] || fail \"runtime/cli/dist/spec-folder/generate-description.js is still missing after bootstrap\"\n210: \n211: finish_state \"complete\" \"\"\n212: emit \"BOOTSTRAP_READY restart_required=$restart_required state_log=$STATE_FILE\"\n\n(End of file - total 212 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n# Prepare the system-spec-kit runtime before /doctor:update asks OpenCode for MCP tools.\nset -euo pipefail\n\nROOT=\"\"\nJSON_MODE=false\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --root)\n      if [[ $# -lt 2 ]]; then\n        echo \"doctor-runtime-bootstrap: --root requires a path\" >&2\n        exit 2\n      fi\n      ROOT=\"$2\"\n      shift 2\n      ;;\n    --json)\n      JSON_MODE=true\n      shift","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh","text":"#!/usr/bin/env bash\n# Prepare the system-spec-kit runtime before /doctor:update asks OpenCode for MCP tools.\nset -euo pipefail\n\nROOT=\"\"\nJSON_MODE=false\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --root)\n      if [[ $# -lt 2 ]]; then\n        echo \"doctor-runtime-bootstrap: --root requires a path\" >&2\n        exit 2\n      fi\n      ROOT=\"$2\"\n      shift 2\n      ;;\n    --json)\n      JSON_MODE=true\n      shift\n      ;;\n    --help|-h)\n      cat <<'HELP'\nUsage: bash .opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh [--root <workspace>] [--json]\n\nMigrates a legacy .opencode/skill directory into .opencode/skills when present,\ninstalls system-spec-kit workspace dependencies, and builds the MCP server and\nscript runtimes needed by /doctor:update.\nHELP\n      exit 0\n      ;;\n    *)\n      echo \"doctor-runtime-bootstrap: unknown option: $1\" >&2\n      exit 2\n      ;;\n  esac\ndone\n\nif [[ -z \"$ROOT\" ]]; then\n  ROOT=\"$(pwd)\"\nfi\nROOT=\"$(cd \"$ROOT\" && pwd)\"\n\nOPENCODE_DIR=\"$ROOT/.opencode\"\nSKILLS_DIR=\"$OPENCODE_DIR/skills\"\nLEGACY_SKILL_DIR=\"$OPENCODE_DIR/skill\"\nKIT_DIR=\"$SKILLS_DIR/system-spec-kit\"\n# Runtime state for /doctor:update. It lives in the advisor's database directory\n# because that one is tracked and gitignore-managed; the spec-kit runtime/database\n# directory that used to hold it left with its server and is absent on a fresh clone.\nDB_DIR=\"$SKILLS_DIR/system-skill-advisor/mcp-server/database\"\nSTATE_FILE=\"$DB_DIR/.doctor-update.bootstrap.json\"\nLOCK_FILE=\"/tmp/doctor-runtime-bootstrap.lock\"\nGRAPH_BACKFILL_DIST=\"$KIT_DIR/runtime/cli/dist/graph/backfill-graph-metadata.js\"\nDESCRIPTION_DIST=\"$KIT_DIR/runtime/cli/dist/spec-folder/generate-description.js\"\n\nstarted_at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\nactions_file=\"$(mktemp \"${TMPDIR:-/tmp}/doctor-runtime-bootstrap-actions.XXXXXX\")\"\nrestart_required=false\n\nfinish_state() {\n  local status=\"$1\"\n  local message=\"${2:-}\"\n  local ended_at\n  ended_at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n\n  mkdir -p \"$DB_DIR\"\n  STARTED_AT=\"$started_at\" \\\n  ENDED_AT=\"$ended_at\" \\\n  STATUS=\"$status\" \\\n  MESSAGE=\"$message\" \\\n  RESTART_REQUIRED=\"$restart_required\" \\\n  ACTIONS_FILE=\"$actions_file\" \\\n  STATE_FILE=\"$STATE_FILE\" \\\n  node <<'NODE'\nconst fs = require('fs');\n\nconst actions = fs.existsSync(process.env.ACTIONS_FILE)\n  ? fs.readFileSync(process.env.ACTIONS_FILE, 'utf8').split('\\n').filter(Boolean)\n  : [];\n\nconst payload = {\n  command: '/doctor:update',\n  phase: 'runtime-bootstrap',\n  start: process.env.STARTED_AT,\n  end: process.env.ENDED_AT,\n  status: process.env.STATUS,\n  restart_required: process.env.RESTART_REQUIRED === 'true',\n  actions,\n};\n\nif (process.env.MESSAGE) {\n  payload.message = process.env.MESSAGE;\n}\n\nfs.writeFileSync(process.env.STATE_FILE, `${JSON.stringify(payload, null, 2)}\\n`);\nNODE\n}\n\ncleanup() {\n  rm -f \"$actions_file\"\n}\ntrap cleanup EXIT\n\nrecord_action() {\n  printf '%s\\n' \"$1\" >> \"$actions_file\"\n}\n\nemit() {\n  if [[ \"$JSON_MODE\" == true ]]; then\n    node -e \"const fs=require('fs'); process.stdout.write(fs.readFileSync(process.argv[1], 'utf8'))\" \"$STATE_FILE\"\n  else\n    echo \"$1\"\n  fi\n}\n\nfail() {\n  local message=\"$1\"\n  finish_state \"failed\" \"$message\"\n  emit \"BOOTSTRAP_FAILED restart_required=$restart_required state_log=$STATE_FILE message=$message\"\n  exit 1\n}\n\nif [[ ! -d \"$OPENCODE_DIR\" ]]; then\n  echo \"doctor-runtime-bootstrap: .opencode directory not found under $ROOT\" >&2\n  exit 1\nfi\n\nmkdir -p \"$DB_DIR\"\nexec 9>\"$LOCK_FILE\"\nif ! flock -n 9; then\n  printf '[doctor-bootstrap] Another bootstrap is in progress (lock %s held). Exiting.\\n' \"$LOCK_FILE\" >&2\n  exit 0\nfi\n\n# Migrate a real legacy .opencode/skill directory into the canonical .opencode/skills\n# layout. Every launcher and config resolves the plural path directly, so the singular\n# .opencode/skill compatibility symlink is unnecessary. The bootstrap no longer creates it,\n# and a layout move alone never forces a restart -- the old code recreated the shim whenever\n# it was absent and looped restart_required, blocking the rebuild. A genuine fresh install\n# still restarts via the dist build step below.\nif [[ ! -d \"$SKILLS_DIR\" && -d \"$LEGACY_SKILL_DIR\" && ! -L \"$LEGACY_SKILL_DIR\" ]]; then\n  mv \"$LEGACY_SKILL_DIR\" \"$SKILLS_DIR\"\n  record_action \"promoted legacy .opencode/skill directory to .opencode/skills\"\nelif [[ -d \"$SKILLS_DIR\" && -d \"$LEGACY_SKILL_DIR\" && ! -L \"$LEGACY_SKILL_DIR\" ]]; then\n  backup=\"$OPENCODE_DIR/skill_legacy_backup_$(date -u +%Y%m%dT%H%M%SZ)\"\n  mv \"$LEGACY_SKILL_DIR\" \"$backup\"\n  record_action \"moved stray legacy .opencode/skill directory to ${backup#$ROOT/}\"\nfi\n\nKIT_DIR=\"$SKILLS_DIR/system-spec-kit\"\nDB_DIR=\"$SKILLS_DIR/system-skill-advisor/mcp-server/database\"\nSTATE_FILE=\"$DB_DIR/.doctor-update.bootstrap.json\"\nGRAPH_BACKFILL_DIST=\"$KIT_DIR/runtime/cli/dist/graph/backfill-graph-metadata.js\"\nDESCRIPTION_DIST=\"$KIT_DIR/runtime/cli/dist/spec-folder/generate-description.js\"\n\nif [[ ! -d \"$KIT_DIR\" ]]; then\n  fail \"system-spec-kit not found at $KIT_DIR\"\nfi\n\nif ! command -v node >/dev/null 2>&1; then\n  fail \"node is required to build system-spec-kit\"\nfi\nif ! command -v npm >/dev/null 2>&1; then\n  fail \"npm is required to build system-spec-kit\"\nfi\n\nneed_build=false\nif [[ ! -f \"$GRAPH_BACKFILL_DIST\" || ! -f \"$DESCRIPTION_DIST\" ]]; then\n  need_build=true\n  record_action \"detected missing runtime/cli/dist migration helpers\"\nfi\n\nif [[ \"$need_build\" == true ]]; then\n  if [[ \"$JSON_MODE\" == true ]]; then\n    (\n      cd \"$KIT_DIR\"\n      if [[ -f package-lock.json ]]; then\n        npm ci --no-fund --silent\n      else\n        npm install --no-fund --silent\n      fi\n      npm audit --audit-level=high || {\n        printf '[doctor-bootstrap] WARNING: npm audit found high-severity issues. Continuing bootstrap; investigate at next opportunity.\\n' >&2\n      }\n      npm run build --workspace=@spec-kit/runtime\n      npm run build --workspace=@spec-kit/cli\n    ) >&2\n  else\n    (\n      cd \"$KIT_DIR\"\n      if [[ -f package-lock.json ]]; then\n        npm ci --no-fund --silent\n      else\n        npm install --no-fund --silent\n      fi\n      npm audit --audit-level=high || {\n        printf '[doctor-bootstrap] WARNING: npm audit found high-severity issues. Continuing bootstrap; investigate at next opportunity.\\n' >&2\n      }\n      npm run build --workspace=@spec-kit/runtime\n      npm run build --workspace=@spec-kit/cli\n    )\n  fi\n  restart_required=true\n  record_action \"installed dependencies and built @spec-kit/runtime plus @spec-kit/cli\"\nfi\n\n[[ -f \"$GRAPH_BACKFILL_DIST\" ]] || fail \"runtime/cli/dist/graph/backfill-graph-metadata.js is still missing after bootstrap\"\n[[ -f \"$DESCRIPTION_DIST\" ]] || fail \"runtime/cli/dist/spec-folder/generate-description.js is still missing after bootstrap\"\n\nfinish_state \"complete\" \"\"\nemit \"BOOTSTRAP_READY restart_required=$restart_required state_log=$STATE_FILE\"","lineStart":1,"lineEnd":212,"totalLines":212,"truncated":false}},"title":".opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh","time":{"start":1788620035179,"end":1788620035227}},"id":"prt_0720fd468001uAD8xjaUckXALs","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
{"type":"tool_use","timestamp":1788620035240,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_0v1L7Xu7d4kZHaS6tLi40XoY","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/registry-loader.sh","offset":1,"limit":250},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/registry-loader.sh</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: # ───────────────────────────────────────────────────────────────\n3: # SPECKIT: REGISTRY LOADER\n4: # ───────────────────────────────────────────────────────────────\n5: # Queries scripts-registry.json for script information.\n6: \n7: set -euo pipefail\n8: \n9: # ───────────────────────────────────────────────────────────────\n10: # 1. CONFIGURATION\n11: # ───────────────────────────────────────────────────────────────\n12: \n13: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n14: REGISTRY_FILE=\"$SCRIPT_DIR/scripts-registry.json\"\n15: \n16: # Colors (disabled for non-TTY)\n17: if [[ -t 1 ]]; then\n18:     RED='\\033[0;31m'\n19:     GREEN='\\033[0;32m'\n20:     YELLOW='\\033[1;33m'\n21:     BLUE='\\033[0;34m'\n22:     CYAN='\\033[0;36m'\n23:     BOLD='\\033[1m'\n24:     DIM='\\033[2m'\n25:     NC='\\033[0m'\n26: else\n27:     RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' DIM='' NC=''\n28: fi\n29: \n30: # ───────────────────────────────────────────────────────────────\n31: # 2. HELPER FUNCTIONS\n32: # ───────────────────────────────────────────────────────────────\n33: \n34: show_help() {\n35:     cat << 'EOF'\n36: registry-loader.sh - Query the Spec Kit Script Registry\n37: \n38: USAGE:\n39:   ./registry-loader.sh [OPTIONS]\n40: \n41: OPTIONS:\n42:   <script-name>             Get info about a specific script (partial match)\n43:   --list                    List all scripts\n44:   --essential               List only essential scripts\n45:   --optional                List only optional scripts\n46:   --by-trigger \"phrase\"     Find scripts by trigger phrase\n47:   --by-gate \"gate\"          Find scripts by gate association\n48:   --by-type \"bash|node|python\"  Filter by script type\n49:   --rules                   List all validation rules\n50:   --json                    Output in JSON format\n51:   --help                    Show this help message\n52: \n53: EXAMPLES:\n54:   ./registry-loader.sh validate-spec\n55:   ./registry-loader.sh --list\n56:   ./registry-loader.sh --essential\n57:   ./registry-loader.sh --by-trigger \"save context\"\n58:   ./registry-loader.sh --by-gate \"Gate 3\"\n59:   ./registry-loader.sh --rules\n60: EOF\n61: }\n62: \n63: check_jq() {\n64:     if ! command -v jq &> /dev/null; then\n65:         echo -e \"${RED}Error: jq is required but not installed.${NC}\" >&2\n66:         echo \"Install with: brew install jq (macOS) or apt install jq (Linux)\"\n67:         exit 1\n68:     fi\n69: }\n70: \n71: check_registry() {\n72:     if [[ ! -f \"$REGISTRY_FILE\" ]]; then\n73:         echo -e \"${RED}Error: Registry file not found: $REGISTRY_FILE${NC}\" >&2\n74:         exit 1\n75:     fi\n76: }\n77: \n78: # ───────────────────────────────────────────────────────────────\n79: # 3. QUERY FUNCTIONS\n80: # ───────────────────────────────────────────────────────────────\n81: \n82: list_all_scripts() {\n83:     local json_mode=\"$1\"\n84:     \n85:     if [[ \"$json_mode\" == \"true\" ]]; then\n86:         jq '.scripts' \"$REGISTRY_FILE\"\n87:     else\n88:         echo -e \"${BOLD}Spec Kit Scripts${NC}\"\n89:         echo -e \"${DIM}────────────────────────────────────────\n90: ${NC}\"\n91:         echo \"\"\n92:         \n93:         jq -r '.scripts[] | \"\\(.name)|\\(.type)|\\(.essential)|\\(.description)\"' \"$REGISTRY_FILE\" | \\\n94:         while IFS='|' read -r name type essential desc; do\n95:             local marker=\"\"\n96:             if [[ \"$essential\" == \"true\" ]]; then\n97:                 marker=\"${GREEN}*${NC}\"\n98:             fi\n99:             printf \"  ${CYAN}%-28s${NC} ${DIM}[%s]${NC} %s %s\\n\" \"$name\" \"$type\" \"$marker\" \"$desc\"\n100:         done\n101:         \n102:         echo \"\"\n103:         echo -e \"${DIM}${GREEN}*${NC}${DIM} = essential script${NC}\"\n104:     fi\n105: }\n106: \n107: list_essential_scripts() {\n108:     local json_mode=\"$1\"\n109:     \n110:     if [[ \"$json_mode\" == \"true\" ]]; then\n111:         jq '.scripts | map(select(.essential == true))' \"$REGISTRY_FILE\"\n112:     else\n113:         echo -e \"${BOLD}Essential Scripts${NC}\"\n114:         echo -e \"${DIM}────────────────────────────────────────\n115: ${NC}\"\n116:         echo \"\"\n117:         \n118:         jq -r '.scripts[] | select(.essential == true) | \"\\(.name)|\\(.type)|\\(.description)\"' \"$REGISTRY_FILE\" | \\\n119:         while IFS='|' read -r name type desc; do\n120:             printf \"  ${GREEN}%-28s${NC} ${DIM}[%s]${NC} %s\\n\" \"$name\" \"$type\" \"$desc\"\n121:         done\n122:     fi\n123: }\n124: \n125: list_optional_scripts() {\n126:     local json_mode=\"$1\"\n127:     \n128:     if [[ \"$json_mode\" == \"true\" ]]; then\n129:         jq '.scripts | map(select(.essential == false or .essential == null))' \"$REGISTRY_FILE\"\n130:     else\n131:         echo -e \"${BOLD}Optional Scripts${NC}\"\n132:         echo -e \"${DIM}────────────────────────────────────────\n133: ${NC}\"\n134:         echo \"\"\n135:         \n136:         jq -r '.scripts[] | select(.essential == false or .essential == null) | \"\\(.name)|\\(.type)|\\(.description)\"' \"$REGISTRY_FILE\" | \\\n137:         while IFS='|' read -r name type desc; do\n138:             printf \"  ${YELLOW}%-28s${NC} ${DIM}[%s]${NC} %s\\n\" \"$name\" \"$type\" \"$desc\"\n139:         done\n140:     fi\n141: }\n142: \n143: get_script_info() {\n144:     local name=\"$1\"\n145:     local json_mode=\"$2\"\n146:     \n147:     local result\n148:     result=$(jq --arg name \"$name\" '.scripts[] | select(.name | contains($name))' \"$REGISTRY_FILE\")\n149:     \n150:     if [[ -z \"$result\" || \"$result\" == \"null\" ]]; then\n151:         echo -e \"${RED}No script found matching: $name${NC}\"\n152:         exit 1\n153:     fi\n154:     \n155:     if [[ \"$json_mode\" == \"true\" ]]; then\n156:         echo \"$result\"\n157:     else\n158:         echo -e \"${BOLD}Script: $(echo \"$result\" | jq -r '.name')${NC}\"\n159:         echo -e \"${DIM}────────────────────────────────────────\n160: ${NC}\"\n161:         echo \"\"\n162:         echo -e \"  ${CYAN}Path:${NC}        $(echo \"$result\" | jq -r '.path')\"\n163:         echo -e \"  ${CYAN}Type:${NC}        $(echo \"$result\" | jq -r '.type')\"\n164:         echo -e \"  ${CYAN}Description:${NC} $(echo \"$result\" | jq -r '.description')\"\n165:         echo -e \"  ${CYAN}Essential:${NC}   $(echo \"$result\" | jq -r '.essential')\"\n166:         echo -e \"  ${CYAN}Version:${NC}     $(echo \"$result\" | jq -r '.version // \"N/A\"')\"\n167:         \n168:         local gate\n169:         gate=$(echo \"$result\" | jq -r '.gate // \"N/A\"')\n170:         if [[ \"$gate\" != \"null\" && \"$gate\" != \"N/A\" ]]; then\n171:             echo -e \"  ${CYAN}Gate:${NC}        $gate\"\n172:         fi\n173:         \n174:         local triggers\n175:         triggers=$(echo \"$result\" | jq -r '.trigger | if type == \"array\" then join(\", \") else . end // \"N/A\"')\n176:         if [[ \"$triggers\" != \"null\" && \"$triggers\" != \"N/A\" && -n \"$triggers\" ]]; then\n177:             echo -e \"  ${CYAN}Triggers:${NC}    $triggers\"\n178:         fi\n179:         \n180:         local calledBy\n181:         calledBy=$(echo \"$result\" | jq -r '.calledBy | if type == \"array\" then join(\", \") else . end // \"N/A\"')\n182:         if [[ \"$calledBy\" != \"null\" && \"$calledBy\" != \"N/A\" ]]; then\n183:             echo -e \"  ${CYAN}Called By:${NC}   $calledBy\"\n184:         fi\n185:     fi\n186: }\n187: \n188: find_by_trigger() {\n189:     local phrase=\"$1\"\n190:     local json_mode=\"$2\"\n191:     \n192:     local results\n193:     results=$(jq --arg phrase \"$phrase\" '.scripts | map(select(.trigger | if type == \"array\" then any(. | ascii_downcase | contains($phrase | ascii_downcase)) else false end))' \"$REGISTRY_FILE\")\n194:     \n195:     if [[ \"$json_mode\" == \"true\" ]]; then\n196:         echo \"$results\"\n197:     else\n198:         local count\n199:         count=$(echo \"$results\" | jq 'length')\n200:         \n201:         if [[ \"$count\" == \"0\" ]]; then\n202:             echo -e \"${YELLOW}No scripts found for trigger: \\\"$phrase\\\"${NC}\"\n203:             exit 0\n204:         fi\n205:         \n206:         echo -e \"${BOLD}Scripts for trigger: \\\"$phrase\\\"${NC}\"\n207:         echo -e \"${DIM}────────────────────────────────────────\n208: ${NC}\"\n209:         echo \"\"\n210:         \n211:         echo \"$results\" | jq -r '.[] | \"\\(.name)|\\(.type)|\\(.description)\"' | \\\n212:         while IFS='|' read -r name type desc; do\n213:             printf \"  ${CYAN}%-28s${NC} ${DIM}[%s]${NC} %s\\n\" \"$name\" \"$type\" \"$desc\"\n214:         done\n215:     fi\n216: }\n217: \n218: find_by_gate() {\n219:     local gate=\"$1\"\n220:     local json_mode=\"$2\"\n221:     \n222:     local results\n223:     results=$(jq --arg gate \"$gate\" '.scripts | map(select(.gate != null and (.gate | ascii_downcase | contains($gate | ascii_downcase))))' \"$REGISTRY_FILE\")\n224:     \n225:     if [[ \"$json_mode\" == \"true\" ]]; then\n226:         echo \"$results\"\n227:     else\n228:         local count\n229:         count=$(echo \"$results\" | jq 'length')\n230:         \n231:         if [[ \"$count\" == \"0\" ]]; then\n232:             echo -e \"${YELLOW}No scripts found for gate: \\\"$gate\\\"${NC}\"\n233:             exit 0\n234:         fi\n235:         \n236:         echo -e \"${BOLD}Scripts for gate: \\\"$gate\\\"${NC}\"\n237:         echo -e \"${DIM}────────────────────────────────────────\n238: ${NC}\"\n239:         echo \"\"\n240:         \n241:         echo \"$results\" | jq -r '.[] | \"\\(.name)|\\(.gate)|\\(.description)\"' | \\\n242:         while IFS='|' read -r name gateName desc; do\n243:             printf \"  ${CYAN}%-20s${NC} ${GREEN}%-25s${NC} %s\\n\" \"$name\" \"$gateName\" \"$desc\"\n244:         done\n245:     fi\n246: }\n247: \n248: find_by_type() {\n249:     local type=\"$1\"\n250:     local json_mode=\"$2\"\n\n(Showing lines 1-250 of 415. Use offset=251 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# SPECKIT: REGISTRY LOADER\n# ───────────────────────────────────────────────────────────────\n# Queries scripts-registry.json for script information.\n\nset -euo pipefail\n\n# ───────────────────────────────────────────────────────────────\n# 1. CONFIGURATION\n# ───────────────────────────────────────────────────────────────\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREGISTRY_FILE=\"$SCRIPT_DIR/scripts-registry.json\"\n\n# Colors (disabled for non-TTY)\nif [[ -t 1 ]]; then\n    RED='\\033[0;31m'\n    GREEN='\\033[0;32m'\n    YELLOW='\\033[1;33m'","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/registry-loader.sh","text":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# SPECKIT: REGISTRY LOADER\n# ───────────────────────────────────────────────────────────────\n# Queries scripts-registry.json for script information.\n\nset -euo pipefail\n\n# ───────────────────────────────────────────────────────────────\n# 1. CONFIGURATION\n# ───────────────────────────────────────────────────────────────\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREGISTRY_FILE=\"$SCRIPT_DIR/scripts-registry.json\"\n\n# Colors (disabled for non-TTY)\nif [[ -t 1 ]]; then\n    RED='\\033[0;31m'\n    GREEN='\\033[0;32m'\n    YELLOW='\\033[1;33m'\n    BLUE='\\033[0;34m'\n    CYAN='\\033[0;36m'\n    BOLD='\\033[1m'\n    DIM='\\033[2m'\n    NC='\\033[0m'\nelse\n    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' DIM='' NC=''\nfi\n\n# ───────────────────────────────────────────────────────────────\n# 2. HELPER FUNCTIONS\n# ───────────────────────────────────────────────────────────────\n\nshow_help() {\n    cat << 'EOF'\nregistry-loader.sh - Query the Spec Kit Script Registry\n\nUSAGE:\n  ./registry-loader.sh [OPTIONS]\n\nOPTIONS:\n  <script-name>             Get info about a specific script (partial match)\n  --list                    List all scripts\n  --essential               List only essential scripts\n  --optional                List only optional scripts\n  --by-trigger \"phrase\"     Find scripts by trigger phrase\n  --by-gate \"gate\"          Find scripts by gate association\n  --by-type \"bash|node|python\"  Filter by script type\n  --rules                   List all validation rules\n  --json                    Output in JSON format\n  --help                    Show this help message\n\nEXAMPLES:\n  ./registry-loader.sh validate-spec\n  ./registry-loader.sh --list\n  ./registry-loader.sh --essential\n  ./registry-loader.sh --by-trigger \"save context\"\n  ./registry-loader.sh --by-gate \"Gate 3\"\n  ./registry-loader.sh --rules\nEOF\n}\n\ncheck_jq() {\n    if ! command -v jq &> /dev/null; then\n        echo -e \"${RED}Error: jq is required but not installed.${NC}\" >&2\n        echo \"Install with: brew install jq (macOS) or apt install jq (Linux)\"\n        exit 1\n    fi\n}\n\ncheck_registry() {\n    if [[ ! -f \"$REGISTRY_FILE\" ]]; then\n        echo -e \"${RED}Error: Registry file not found: $REGISTRY_FILE${NC}\" >&2\n        exit 1\n    fi\n}\n\n# ───────────────────────────────────────────────────────────────\n# 3. QUERY FUNCTIONS\n# ───────────────────────────────────────────────────────────────\n\nlist_all_scripts() {\n    local json_mode=\"$1\"\n    \n    if [[ \"$json_mode\" == \"true\" ]]; then\n        jq '.scripts' \"$REGISTRY_FILE\"\n    else\n        echo -e \"${BOLD}Spec Kit Scripts${NC}\"\n        echo -e \"${DIM}────────────────────────────────────────\n${NC}\"\n        echo \"\"\n        \n        jq -r '.scripts[] | \"\\(.name)|\\(.type)|\\(.essential)|\\(.description)\"' \"$REGISTRY_FILE\" | \\\n        while IFS='|' read -r name type essential desc; do\n            local marker=\"\"\n            if [[ \"$essential\" == \"true\" ]]; then\n                marker=\"${GREEN}*${NC}\"\n            fi\n            printf \"  ${CYAN}%-28s${NC} ${DIM}[%s]${NC} %s %s\\n\" \"$name\" \"$type\" \"$marker\" \"$desc\"\n        done\n        \n        echo \"\"\n        echo -e \"${DIM}${GREEN}*${NC}${DIM} = essential script${NC}\"\n    fi\n}\n\nlist_essential_scripts() {\n    local json_mode=\"$1\"\n    \n    if [[ \"$json_mode\" == \"true\" ]]; then\n        jq '.scripts | map(select(.essential == true))' \"$REGISTRY_FILE\"\n    else\n        echo -e \"${BOLD}Essential Scripts${NC}\"\n        echo -e \"${DIM}────────────────────────────────────────\n${NC}\"\n        echo \"\"\n        \n        jq -r '.scripts[] | select(.essential == true) | \"\\(.name)|\\(.type)|\\(.description)\"' \"$REGISTRY_FILE\" | \\\n        while IFS='|' read -r name type desc; do\n            printf \"  ${GREEN}%-28s${NC} ${DIM}[%s]${NC} %s\\n\" \"$name\" \"$type\" \"$desc\"\n        done\n    fi\n}\n\nlist_optional_scripts() {\n    local json_mode=\"$1\"\n    \n    if [[ \"$json_mode\" == \"true\" ]]; then\n        jq '.scripts | map(select(.essential == false or .essential == null))' \"$REGISTRY_FILE\"\n    else\n        echo -e \"${BOLD}Optional Scripts${NC}\"\n        echo -e \"${DIM}────────────────────────────────────────\n${NC}\"\n        echo \"\"\n        \n        jq -r '.scripts[] | select(.essential == false or .essential == null) | \"\\(.name)|\\(.type)|\\(.description)\"' \"$REGISTRY_FILE\" | \\\n        while IFS='|' read -r name type desc; do\n            printf \"  ${YELLOW}%-28s${NC} ${DIM}[%s]${NC} %s\\n\" \"$name\" \"$type\" \"$desc\"\n        done\n    fi\n}\n\nget_script_info() {\n    local name=\"$1\"\n    local json_mode=\"$2\"\n    \n    local result\n    result=$(jq --arg name \"$name\" '.scripts[] | select(.name | contains($name))' \"$REGISTRY_FILE\")\n    \n    if [[ -z \"$result\" || \"$result\" == \"null\" ]]; then\n        echo -e \"${RED}No script found matching: $name${NC}\"\n        exit 1\n    fi\n    \n    if [[ \"$json_mode\" == \"true\" ]]; then\n        echo \"$result\"\n    else\n        echo -e \"${BOLD}Script: $(echo \"$result\" | jq -r '.name')${NC}\"\n        echo -e \"${DIM}────────────────────────────────────────\n${NC}\"\n        echo \"\"\n        echo -e \"  ${CYAN}Path:${NC}        $(echo \"$result\" | jq -r '.path')\"\n        echo -e \"  ${CYAN}Type:${NC}        $(echo \"$result\" | jq -r '.type')\"\n        echo -e \"  ${CYAN}Description:${NC} $(echo \"$result\" | jq -r '.description')\"\n        echo -e \"  ${CYAN}Essential:${NC}   $(echo \"$result\" | jq -r '.essential')\"\n        echo -e \"  ${CYAN}Version:${NC}     $(echo \"$result\" | jq -r '.version // \"N/A\"')\"\n        \n        local gate\n        gate=$(echo \"$result\" | jq -r '.gate // \"N/A\"')\n        if [[ \"$gate\" != \"null\" && \"$gate\" != \"N/A\" ]]; then\n            echo -e \"  ${CYAN}Gate:${NC}        $gate\"\n        fi\n        \n        local triggers\n        triggers=$(echo \"$result\" | jq -r '.trigger | if type == \"array\" then join(\", \") else . end // \"N/A\"')\n        if [[ \"$triggers\" != \"null\" && \"$triggers\" != \"N/A\" && -n \"$triggers\" ]]; then\n            echo -e \"  ${CYAN}Triggers:${NC}    $triggers\"\n        fi\n        \n        local calledBy\n        calledBy=$(echo \"$result\" | jq -r '.calledBy | if type == \"array\" then join(\", \") else . end // \"N/A\"')\n        if [[ \"$calledBy\" != \"null\" && \"$calledBy\" != \"N/A\" ]]; then\n            echo -e \"  ${CYAN}Called By:${NC}   $calledBy\"\n        fi\n    fi\n}\n\nfind_by_trigger() {\n    local phrase=\"$1\"\n    local json_mode=\"$2\"\n    \n    local results\n    results=$(jq --arg phrase \"$phrase\" '.scripts | map(select(.trigger | if type == \"array\" then any(. | ascii_downcase | contains($phrase | ascii_downcase)) else false end))' \"$REGISTRY_FILE\")\n    \n    if [[ \"$json_mode\" == \"true\" ]]; then\n        echo \"$results\"\n    else\n        local count\n        count=$(echo \"$results\" | jq 'length')\n        \n        if [[ \"$count\" == \"0\" ]]; then\n            echo -e \"${YELLOW}No scripts found for trigger: \\\"$phrase\\\"${NC}\"\n            exit 0\n        fi\n        \n        echo -e \"${BOLD}Scripts for trigger: \\\"$phrase\\\"${NC}\"\n        echo -e \"${DIM}────────────────────────────────────────\n${NC}\"\n        echo \"\"\n        \n        echo \"$results\" | jq -r '.[] | \"\\(.name)|\\(.type)|\\(.description)\"' | \\\n        while IFS='|' read -r name type desc; do\n            printf \"  ${CYAN}%-28s${NC} ${DIM}[%s]${NC} %s\\n\" \"$name\" \"$type\" \"$desc\"\n        done\n    fi\n}\n\nfind_by_gate() {\n    local gate=\"$1\"\n    local json_mode=\"$2\"\n    \n    local results\n    results=$(jq --arg gate \"$gate\" '.scripts | map(select(.gate != null and (.gate | ascii_downcase | contains($gate | ascii_downcase))))' \"$REGISTRY_FILE\")\n    \n    if [[ \"$json_mode\" == \"true\" ]]; then\n        echo \"$results\"\n    else\n        local count\n        count=$(echo \"$results\" | jq 'length')\n        \n        if [[ \"$count\" == \"0\" ]]; then\n            echo -e \"${YELLOW}No scripts found for gate: \\\"$gate\\\"${NC}\"\n            exit 0\n        fi\n        \n        echo -e \"${BOLD}Scripts for gate: \\\"$gate\\\"${NC}\"\n        echo -e \"${DIM}────────────────────────────────────────\n${NC}\"\n        echo \"\"\n        \n        echo \"$results\" | jq -r '.[] | \"\\(.name)|\\(.gate)|\\(.description)\"' | \\\n        while IFS='|' read -r name gateName desc; do\n            printf \"  ${CYAN}%-20s${NC} ${GREEN}%-25s${NC} %s\\n\" \"$name\" \"$gateName\" \"$desc\"\n        done\n    fi\n}\n\nfind_by_type() {\n    local type=\"$1\"\n    local json_mode=\"$2\"","lineStart":1,"lineEnd":250,"totalLines":415,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/registry-loader.sh","time":{"start":1788620035152,"end":1788620035231}},"id":"prt_0720fd44f001SnDjFAniMtIDkW","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
