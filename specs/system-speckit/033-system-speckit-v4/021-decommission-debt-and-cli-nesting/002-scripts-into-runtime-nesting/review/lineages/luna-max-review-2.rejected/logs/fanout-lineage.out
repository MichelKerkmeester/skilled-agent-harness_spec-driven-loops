 id: 'system-spec-kit/runtime/cli',\n34:     name: '@spec-kit/cli',\n35:     root: '.opencode/skills/system-spec-kit/runtime/cli',\n36:     distEntries: {\n37:       default: 'dist/tsconfig.tsbuildinfo',\n38:       'is-phase-parent': 'dist/spec/is-phase-parent.js',\n39:     },\n40:     rebuildCommand: 'cd .opencode/skills/system-spec-kit/runtime/cli && npm run build',\n41:     sourceCandidates: ['.'],\n42:     // is-phase-parent.ts imports only Node builtins (fs, path) -- no local\n43:     // project dependencies -- so its own freshness check is scoped to just\n44:     // that one file rather than the whole cli/ tree. This keeps the\n45:     // child-drift guard immune to unrelated concurrent edits anywhere else\n46:     // under cli/, which the whole-tree 'default' entry is not.\n47:     entrySourceCandidates: {\n48:       'is-phase-parent': ['package.json', 'tsconfig.json', 'spec/is-phase-parent.ts'],\n49:     },\n50:     // retrieval/fixtures is rewritten by every trigger-index run; it is generator\n51:     // output that happens to live beside the generator, not a build input.\n52:     excludedSegments: ['tests', 'test-fixtures', 'fixtures'],\n53:   },\n54:   {\n55:     id: 'system-spec-kit/runtime',\n56:     name: '@spec-kit/runtime',\n57:     root: '.opencode/skills/system-spec-kit/runtime',\n58:     distEntries: {\n59:       default: 'dist/tsconfig.tsbuildinfo',\n60:       'validation-orchestrator': 'dist/lib/validation/orchestrator.js',\n61:     },\n62:     rebuildCommand: 'cd .opencode/skills/system-spec-kit/runtime && npm run build',\n63:     sourceCandidates: [\n64:       'package.json',\n65:       'tsconfig.json',\n66:       'api',\n67:       'core',\n68:       'handlers',\n69:       'hooks',\n70:       'lib',\n\n(Showing lines 1-70 of 969. Use offset=71 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────\n// MODULE: Dist Freshness Utility\n// ──────────────────────────