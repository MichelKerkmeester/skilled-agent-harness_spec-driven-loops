\n      },\n      \"outputs\": [\"Completeness percentage\", \"Per-file breakdown (with --verbose)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"test-validation\",\n      \"path\": \"runtime/cli/tests/test-validation.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Test runner for validate-spec.sh against fixture spec folders\",\n      \"trigger\": [\"test validation\", \"run tests\"],\n      \"calledBy\": [\"Developer\", \"CI/CD Pipeline\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"options\": \"-v (verbose), -t NAME (single test), -c CATEGORY, -l (list), -h (help)\"\n      },\n      \"outputs\": [\"Test pass/fail results\", \"Coverage report\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"validate-spec.sh\", \"test-fixtures/\"]\n    },\n    {\n      \"name\": \"create-spec-folder\",\n      \"path\": \"runtime/cli/spec/create.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Create new spec folders with appropriate templates based on documentation level\",\n      \"trigger\": [\"create spec\", \"new spec folder\", \"Option B\"],\n      \"calledBy\": [\"AI Assistant\", \"Gate 3 (Option B)\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Feature description\",\n        \"options\": \"--short-name, --level (1/2/3), --number, --skip-branch, --sharded, --subfolder\"\n      },\n      \"outputs\": [\"New spec folder with templates\", \"Git branch (optional)\"],\n      \"gate\": \"Gate 3 (Spec Folder Creation)\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"templates/\"]\n    },\n    {\n      \"name\": \"generate-nested-changelog\",\n      \"path\": \"runtime/cli/dist/spec-folder/nested-changelog.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate packet-local changelog content for a root spec folder or a nested phase child\",\n      \"trigger\": [\"nested changelog\", \"packet changelog\", \"phase changelog\", \"spec changelog\"],\n      \"calledBy\": [\"AI Assistant\", \"Completion workflows\", \"Create changelog command\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --write, --mode <auto|root|phase>, --output <path>\"\n      },\n      \"outputs\": [\"Rendered markdown\", \"Nested changelog payload\", \"packet-local changelog file (with --write)\"],\n      \"gate\": \"Completion workflow\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"scripts/spec-folder/*.ts\", \"templates/changelog/\"]\n    },\n    {\n      \"name\": \"recommend-level\",\n      \"path\": \"runtime/cli/spec/recommend-level.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Recommend documentation level based on task complexity factors\",\n      \"trigger\": [\"recommend level\", \"what level\"],\n      \"calledBy\": [\"AI Assistant\", \"Gate 3\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"options\": \"--loc <number>, --files <number>, --auth, --api, --db, --architectural, --json\"\n      },\n      \"outputs\": [\"Recommended level (0-3)\", \"Score breakdown\"],","lineStart":55,"lineEnd":169,"totalLines":394,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json","time":{"start":1788620322251,"end":1788620322305}},"id":"prt_0721435c8001POY085u3y5WS2m","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072138c02001ulKYawwyB5vb4A"}}
{"type":"tool_use","timestamp":1788620322325,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_OgKdHdlojZVMz5eaZKUsCsis","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/templates/README.md","offset":1,"limit":110},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/templates/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Template Scripts: Inline Gate Rendering\"\n3: description: \"Template rendering scripts for Level-gated markdown content.\"\n4: trigger_phrases:\n5:   - \"inline gate renderer\"\n6:   - \"template rendering\"\n7:   - \"level gated templates\"\n8: ---\n9: \n10: # Template Scripts: Inline Gate Rendering\n11: \n12: ## 1. OVERVIEW\n13: \n14: `scripts/templates/` owns the inline gate renderer used to produce Level-specific markdown from shared templates. It evaluates `<!-- IF ... -->` blocks and emits only the content that applies to the requested Level.\n15: \n16: Current responsibilities:\n17: \n18: - Parse `level:` gate expressions with `AND`, `OR`, `NOT` and parentheses.\n19: - Render markdown templates while preserving fenced code behavior.\n20: - Provide a shell wrapper for callers that need a stable executable entrypoint.\n21: \n22: ---\n23: \n24: ## 2. DIRECTORY TREE\n25: \n26: ```text\n27: templates/\n28: +-- inline-gate-renderer.sh  # Bash wrapper for shell callers\n29: +-- inline-gate-renderer.ts  # Gate expression parser and markdown renderer\n30: `-- README.md\n31: ```\n32: \n33: ---\n34: \n35: ## 3. KEY FILES\n36: \n37: | File | Responsibility |\n38: |---|---|\n39: | `inline-gate-renderer.ts` | Implements expression parsing, gate evaluation and template rendering. |\n40: | `inline-gate-renderer.sh` | Runs the TypeScript renderer through the local `tsx` loader. |\n41: \n42: ---\n43: \n44: ## 4. USAGE NOTES\n45: \n46: - Supported render levels are `1`, `2`, `3`, `3+` and `phase`.\n47: - Gate markers are ignored inside fenced code blocks so examples remain intact.\n48: - Empty gate markers are validated and removed from output.\n49: - Use the shell wrapper when a Bash script needs to call the renderer.\n50: \n51: ---\n52: \n53: ## 5. VALIDATION\n54: \n55: Run from the repository root:\n56: \n57: ```bash\n58: python3 .opencode/skills/sk-doc/shared/scripts/validate_document.py .opencode/skills/system-spec-kit/runtime/cli/templates/README.md\n59: ```\n60: \n61: Expected result: the README validation exits `0`.\n62: \n63: ---\n64: \n65: ## 6. RELATED\n66: \n67: - [`scripts/`](../README.md)\n68: - [`inline-gate-renderer.ts`](./inline-gate-renderer.ts)\n69: - [`inline-gate-renderer.sh`](./inline-gate-renderer.sh)\n\n(End of file - total 69 lines)\n</content>","metadata":{"preview":"---\ntitle: \"Template Scripts: Inline Gate Rendering\"\ndescription: \"Template rendering scripts for Level-gated markdown content.\"\ntrigger_phrases:\n  - \"inline gate renderer\"\n  - \"template rendering\"\n  - \"level gated templates\"\n---\n\n# Template Scripts: Inline Gate Rendering\n\n## 1. OVERVIEW\n\n`scripts/templates/` owns the inline gate renderer used to produce Level-specific markdown from shared templates. It evaluates `<!-- IF ... -->` blocks and emits only the content that applies to the requested Level.\n\nCurrent responsibilities:\n\n- Parse `level:` gate expressions with `AND`, `OR`, `NOT` and parentheses.\n- Render markdown templates while preserving fenced code behavior.\n- Provide a shell wrapper for callers that need a stable executable entrypoint.","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/templates/README.md","text":"---\ntitle: \"Template Scripts: Inline Gate Rendering\"\ndescription: \"Template rendering scripts for Level-gated markdown content.\"\ntrigger_phrases:\n  - \"inline gate renderer\"\n  - \"template rendering\"\n  - \"level gated templates\"\n---\n\n# Template Scripts: Inline Gate Rendering\n\n## 1. OVERVIEW\n\n`scripts/templates/` owns the inline gate renderer used to produce Level-specific markdown from shared templates. It evaluates `<!-- IF ... -->` blocks and emits only the content that applies to the requested Level.\n\nCurrent responsibilities:\n\n- Parse `level:` gate expressions with `AND`, `OR`, `NOT` and parentheses.\n- Render markdown templates while preserving fenced code behavior.\n- Provide a shell wrapper for callers that need a stable executable entrypoint.\n\n---\n\n## 2. DIRECTORY TREE\n\n```text\ntemplates/\n+-- inline-gate-renderer.sh  # Bash wrapper for shell callers\n+-- inline-gate-renderer.ts  # Gate expression parser and markdown renderer\n`-- README.md\n```\n\n---\n\n## 3. KEY FILES\n\n| File | Responsibility |\n|---|---|\n| `inline-gate-renderer.ts` | Implements expression parsing, gate evaluation and template rendering. |\n| `inline-gate-renderer.sh` | Runs the TypeScript renderer through the local `tsx` loader. |\n\n---\n\n## 4. USAGE NOTES\n\n- Supported render levels are `1`, `2`, `3`, `3+` and `phase`.\n- Gate markers are ignored inside fenced code blocks so examples remain intact.\n- Empty gate markers are validated and removed from output.\n- Use the shell wrapper when a Bash script needs to call the renderer.\n\n---\n\n## 5. VALIDATION\n\nRun from the repository root:\n\n```bash\npython3 .opencode/skills/sk-doc/shared/scripts/validate_document.py .opencode/skills/system-spec-kit/runtime/cli/templates/README.md\n```\n\nExpected result: the README validation exits `0`.\n\n---\n\n## 6. RELATED\n\n- [`scripts/`](../README.md)\n- [`inline-gate-renderer.ts`](./inline-gate-renderer.ts)\n- [`inline-gate-renderer.sh`](./inline-gate-renderer.sh)","lineStart":1,"lineEnd":69,"totalLines":69,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/templates/README.md","time":{"start":1788620322222,"end":1788620322310}},"id":"prt_0721435aa001SVMWSGmSx2bY2b","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072138c02001ulKYawwyB5vb4A"}}
{"type":"tool_use","timestamp":1788620322325,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_LEeEQEGGQgSMdgdyUQxcGZHQ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/sweep/README.md","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/sweep/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Sweep: strict-pass freshness regression gate\"\n3: description: \"Runs validate.sh --strict across every spec folder and flags regressions against a stored baseline of prior passes.\"\n4: ---\n5: \n6: # Sweep\n7: \n8: ---\n9: \n10: ## 1. OVERVIEW\n11: \n12: `scripts/sweep/` holds the strict-pass freshness sweep, a CI gate that walks every spec folder under `specs` (and legacy `.opencode/specs`), runs `scripts/spec/validate.sh --strict` on each and classifies the result against a prior baseline. A folder that failed with no baseline record is `first-run`, not a regression. A folder that passed before and fails now is a `regression`. This distinguishes genuinely new breakage from a folder that was already failing.\n13: \n14: ---\n15: \n16: ## 2. CONTENTS\n17: \n18: | File | Purpose |\n19: |------|---------|\n20: | `strict-pass-freshness.ts` | CLI entrypoint. `--roots <path[,path...]>` scopes the sweep, `--baseline <report.json>` supplies the prior-pass set, `--format json\\|text` controls output. Classifies each folder as `pass`, `regression`, `new-failure`, `first-run` or `error`. |\n21: \n22: ---\n23: \n24: ## 3. CONSUMERS\n25: \n26: - `.github/workflows/strict-pass-freshness-report.yml` runs this script weekly and reports.\n27:   It does not gate. Merge-blocking lives in `changed-packet-validation.yml`, which is\n28:   scoped to the packets a pull request changed; this sweep exists for the case that gate\n29:   cannot see — a toolchain change breaking packets no pull request touched.\n30: - `.opencode/skills/system-spec-kit/runtime/cli/lib/status-classifier.sh` shares the same pass/fail classification vocabulary.\n31: \n32: ---\n33: \n34: ## 4. VALIDATION\n35: \n36: ```bash\n37: npx vitest run .opencode/skills/system-spec-kit/runtime/cli/tests/strict-pass-freshness.vitest.ts\n38: npx vitest run .opencode/skills/system-spec-kit/runtime/cli/tests/validation-gate-hardening.vitest.ts\n39: ```\n40: \n41: ---\n42: \n43: ## 5. RELATED\n44: \n45: - [`../spec/validate.sh`](../spec/validate.sh): the per-folder validator this sweep drives.\n46: - [`ENV-REFERENCE.md`](../../runtime/ENV-REFERENCE.md): documents the sweep's environment-driven configuration.\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"---\ntitle: \"Sweep: strict-pass freshness regression gate\"\ndescription: \"Runs validate.sh --strict across every spec folder and flags regressions against a stored baseline of prior passes.\"\n---\n\n# Sweep\n\n---\n\n## 1. OVERVIEW\n\n`scripts/sweep/` holds the strict-pass freshness sweep, a CI gate that walks every spec folder under `specs` (and legacy `.opencode/specs`), runs `scripts/spec/validate.sh --strict` on each and classifies the result against a prior baseline. A folder that failed with no baseline record is `first-run`, not a regression. A folder that passed before and fails now is a `regression`. This distinguishes genuinely new breakage from a folder that was already failing.\n\n---\n\n## 2. CONTENTS\n\n| File | Purpose |\n|------|---------|\n| `strict-pass-freshness.ts` | CLI entrypoint. `--roots <path[,path...]>` scopes the sweep, `--baseline <report.json>` supplies the prior-pass set, `--format json\\|text` controls output. Classifies each folder as `pass`, `regression`, `new-failure`, `first-run` or `error`. |","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/sweep/README.md","text":"---\ntitle: \"Sweep: strict-pass freshness regression gate\"\ndescription: \"Runs validate.sh --strict across every spec folder and flags regressions against a stored baseline of prior passes.\"\n---\n\n# Sweep\n\n---\n\n## 1. OVERVIEW\n\n`scripts/sweep/` holds the strict-pass freshness sweep, a CI gate that walks every spec folder under `specs` (and legacy `.opencode/specs`), runs `scripts/spec/validate.sh --strict` on each and classifies the result against a prior baseline. A folder that failed with no baseline record is `first-run`, not a regression. A folder that passed before and fails now is a `regression`. This distinguishes genuinely new breakage from a folder that was already failing.\n\n---\n\n## 2. CONTENTS\n\n| File | Purpose |\n|------|---------|\n| `strict-pass-freshness.ts` | CLI entrypoint. `--roots <path[,path...]>` scopes the sweep, `--baseline <report.json>` supplies the prior-pass set, `--format json\\|text` controls output. Classifies each folder as `pass`, `regression`, `new-failure`, `first-run` or `error`. |\n\n---\n\n## 3. CONSUMERS\n\n- `.github/workflows/strict-pass-freshness-report.yml` runs this script weekly and reports.\n  It does not gate. Merge-blocking lives in `changed-packet-validation.yml`, which is\n  scoped to the packets a pull request changed; this sweep exists for the case that gate\n  cannot see — a toolchain change breaking packets no pull request touched.\n- `.opencode/skills/system-spec-kit/runtime/cli/lib/status-classifier.sh` shares the same pass/fail classification vocabulary.\n\n---\n\n## 4. VALIDATION\n\n```bash\nnpx vitest run .opencode/skills/system-spec-kit/runtime/cli/tests/strict-pass-freshness.vitest.ts\nnpx vitest run .opencode/skills/system-spec-kit/runtime/cli/tests/validation-gate-hardening.vitest.ts\n```\n\n---\n\n## 5. RELATED\n\n- [`../spec/validate.sh`](../spec/validate.sh): the per-folder validator this sweep drives.\n- [`ENV-REFERENCE.md`](../../runtime/ENV-REFERENCE.md): documents the sweep's environment-driven configuration.","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/sweep/README.md","time":{"start":1788620322229,"end":1788620322313}},"id":"prt_0721435b2001udM8yImQm0jNn6","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072138c02001ulKYawwyB5vb4A"}}
{"type":"tool_use","timestamp":1788620322325,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_pC3CZ1jG3kjhuqxmIPV8cBPX","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/setup/README.md","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/setup/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Setup Scripts\"\n3: description: \"Prerequisite, environment, and native-module checks for Spec Kit script workflows.\"\n4: trigger_phrases:\n5:   - \"setup scripts\"\n6:   - \"check prerequisites\"\n7:   - \"native module checks\"\n8: ---\n9: \n10: # Setup Scripts\n11: \n12: > Shell and Node.js utilities for checking spec-folder readiness and local runtime prerequisites.\n13: \n14: ---\n15: \n16: ## 1. OVERVIEW\n17: \n18: `scripts/setup/` contains preflight utilities for Spec Kit workflows. These scripts check whether a target spec folder has the required documents, whether native Node.js modules are loadable, and whether the recorded Node.js runtime has changed.\n19: \n20: Current state:\n21: \n22: - Shell entrypoints are run directly from source.\n23: - Node.js helpers run from the scripts workspace.\n24: - Full spec-folder validation delegates to `scripts/spec/validate.sh` when requested.\n25: \n26: ---\n27: \n28: ## 2. PACKAGE TOPOLOGY\n29: \n30: ```text\n31: scripts/setup/\n32: +-- _utils.sh                   # Shared installer and setup helpers\n33: +-- check-prerequisites.sh       # Spec-folder readiness checks\n34: +-- check-native-modules.sh      # Native module availability checks\n35: +-- rebuild-native-modules.sh    # Native module rebuild helper\n36: +-- record-node-version.js       # Node.js version recorder\n37: `-- README.md\n38: ```\n39: \n40: Allowed direction:\n41: \n42: - Setup scripts may call `scripts/spec/validate.sh` for strict spec-folder validation.\n43: - Native-module scripts may inspect package-local dependencies.\n44: - Callers may parse `--json` or `--paths-only` output from `check-prerequisites.sh`.\n45: \n46: Disallowed direction:\n47: \n48: - Setup scripts should not create or edit spec documents.\n49: - Setup scripts should not import generated `dist/` modules unless a command explicitly checks built output.\n50: - Runtime callers should not depend on human-readable output when a machine flag exists.\n51: \n52: ---\n53: \n54: ## 3. KEY FILES\n55: \n56: | File | Responsibility |\n57: |---|---|\n58: | `_utils.sh` | Provides shared logging, version, JSON and project-root helpers for setup installers. |\n59: | `check-prerequisites.sh` | Checks spec-folder presence, required docs, optional task docs and validation status. |\n60: | `check-native-modules.sh` | Verifies native modules required by the scripts workspace can load. |\n61: | `rebuild-native-modules.sh` | Rebuilds native modules after Node.js or dependency changes. |\n62: | `record-node-version.js` | Records the active Node.js version for rebuild checks. |\n63: \n64: ---\n65: \n66: ## 4. COMMANDS\n67: \n68: Run from the repository root unless noted.\n69: \n70: ```bash\n71: .opencode/skills/system-spec-kit/runtime/cli/setup/check-prerequisites.sh\n72: ```\n73: \n74: Expected result: prints `FEATURE_DIR` and available supporting documents for the active spec folder.\n75: \n76: ```bash\n77: .opencode/skills/system-spec-kit/runtime/cli/setup/check-prerequisites.sh --json --validate-strict\n78: ```\n79: \n80: Expected result: emits JSON and exits non-zero if strict spec validation fails.\n81: \n82: ```bash\n83: .opencode/skills/system-spec-kit/runtime/cli/setup/check-native-modules.sh\n84: ```\n85: \n86: Expected result: exits zero when native dependencies load in the current Node.js runtime.\n87: \n88: ```bash\n89: .opencode/skills/system-spec-kit/runtime/cli/setup/rebuild-native-modules.sh\n90: ```\n91: \n92: Expected result: rebuilds native modules for the current Node.js runtime.\n93: \n94: ---\n95: \n96: ## 5. BOUNDARIES\n97: \n98: | Boundary | Rule |\n99: |---|---|\n100: | Scope | These scripts report readiness. They do not repair spec folders or choose implementation work. |\n\n(Showing lines 1-100 of 131. Use offset=101 to continue.)\n</content>","metadata":{"preview":"---\ntitle: \"Setup Scripts\"\ndescription: \"Prerequisite, environment, and native-module checks for Spec Kit script workflows.\"\ntrigger_phrases:\n  - \"setup scripts\"\n  - \"check prerequisites\"\n  - \"native module checks\"\n---\n\n# Setup Scripts\n\n> Shell and Node.js utilities for checking spec-folder readiness and local runtime prerequisites.\n\n---\n\n## 1. OVERVIEW\n\n`scripts/setup/` contains preflight utilities for Spec Kit workflows. These scripts check whether a target spec folder has the required documents, whether native Node.js modules are loadable, and whether the recorded Node.js runtime has changed.\n\nCurrent state:","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/setup/README.md","text":"---\ntitle: \"Setup Scripts\"\ndescription: \"Prerequisite, environment, and native-module checks for Spec Kit script workflows.\"\ntrigger_phrases:\n  - \"setup scripts\"\n  - \"check prerequisites\"\n  - \"native module checks\"\n---\n\n# Setup Scripts\n\n> Shell and Node.js utilities for checking spec-folder readiness and local runtime prerequisites.\n\n---\n\n## 1. OVERVIEW\n\n`scripts/setup/` contains preflight utilities for Spec Kit workflows. These scripts check whether a target spec folder has the required documents, whether native Node.js modules are loadable, and whether the recorded Node.js runtime has changed.\n\nCurrent state:\n\n- Shell entrypoints are run directly from source.\n- Node.js helpers run from the scripts workspace.\n- Full spec-folder validation delegates to `scripts/spec/validate.sh` when requested.\n\n---\n\n## 2. PACKAGE TOPOLOGY\n\n```text\nscripts/setup/\n+-- _utils.sh                   # Shared installer and setup helpers\n+-- check-prerequisites.sh       # Spec-folder readiness checks\n+-- check-native-modules.sh      # Native module availability checks\n+-- rebuild-native-modules.sh    # Native module rebuild helper\n+-- record-node-version.js       # Node.js version recorder\n`-- README.md\n```\n\nAllowed direction:\n\n- Setup scripts may call `scripts/spec/validate.sh` for strict spec-folder validation.\n- Native-module scripts may inspect package-local dependencies.\n- Callers may parse `--json` or `--paths-only` output from `check-prerequisites.sh`.\n\nDisallowed direction:\n\n- Setup scripts should not create or edit spec documents.\n- Setup scripts should not import generated `dist/` modules unless a command explicitly checks built output.\n- Runtime callers should not depend on human-readable output when a machine flag exists.\n\n---\n\n## 3. KEY FILES\n\n| File | Responsibility |\n|---|---|\n| `_utils.sh` | Provides shared logging, version, JSON and project-root helpers for setup installers. |\n| `check-prerequisites.sh` | Checks spec-folder presence, required docs, optional task docs and validation status. |\n| `check-native-modules.sh` | Verifies native modules required by the scripts workspace can load. |\n| `rebuild-native-modules.sh` | Rebuilds native modules after Node.js or dependency changes. |\n| `record-node-version.js` | Records the active Node.js version for rebuild checks. |\n\n---\n\n## 4. COMMANDS\n\nRun from the repository root unless noted.\n\n```bash\n.opencode/skills/system-spec-kit/runtime/cli/setup/check-prerequisites.sh\n```\n\nExpected result: prints `FEATURE_DIR` and available supporting documents for the active spec folder.\n\n```bash\n.opencode/skills/system-spec-kit/runtime/cli/setup/check-prerequisites.sh --json --validate-strict\n```\n\nExpected result: emits JSON and exits non-zero if strict spec validation fails.\n\n```bash\n.opencode/skills/system-spec-kit/runtime/cli/setup/check-native-modules.sh\n```\n\nExpected result: exits zero when native dependencies load in the current Node.js runtime.\n\n```bash\n.opencode/skills/system-spec-kit/runtime/cli/setup/rebuild-native-modules.sh\n```\n\nExpected result: rebuilds native modules for the current Node.js runtime.\n\n---\n\n## 5. BOUNDARIES\n\n| Boundary | Rule |\n|---|---|\n| Scope | These scripts report readiness. They do not repair spec folders or choose implementation work. |","lineStart":1,"lineEnd":100,"totalLines":131,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/setup/README.md","time":{"start":1788620322214,"end":1788620322318}},"id":"prt_0721435a30019jGKNpB9tPCMtd","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072138c02001ulKYawwyB5vb4A"}}
