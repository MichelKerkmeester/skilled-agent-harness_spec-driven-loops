{"type":"tool_use","timestamp":1788619947911,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_8Lp6p0ImnEpp4FUrQKK3m59R","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/vitest.config.ts","offset":1,"limit":250},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/vitest.config.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Vitest Config\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import path from 'node:path';\n6: \n7: import { defineConfig } from 'vitest/config';\n8: \n9: const TEST_TIMEOUT_MS = 30_000; // 30s default, increase for CI if needed\n10: const TEARDOWN_TIMEOUT_MS = 1_000;\n11: const _INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n12: \n13: export default defineConfig({\n14:   root: path.resolve(import.meta.dirname, '..'),\n15:   test: {\n16:     include: [\n17:       'runtime/tests/**/*.{vitest,test}.ts',\n18:       '../system-deep-loop/runtime/tests/**/*.{vitest,test}.ts',\n19:     ],\n20:     exclude: [\n21:       'runtime/tests/archive/**',\n22:       'runtime/cli/**',\n23:     ],\n24:     setupFiles: [\n25:       path.resolve(import.meta.dirname, 'tests', '_support', 'vitest-setup.ts'),\n26:     ],\n27:     // Several script suites mutate shared process-level state and temp project roots.\n28:     // Run files serially so the combined config remains deterministic.\n29:     fileParallelism: false,\n30:     globals: true,\n31:     environment: 'node',\n32:     reporters: ['default', 'hanging-process'],\n33:     testTimeout: TEST_TIMEOUT_MS,\n34:     teardownTimeout: TEARDOWN_TIMEOUT_MS,\n35:     alias: {\n36:       '@lib': path.resolve(import.meta.dirname, 'lib'),\n37:       '@spec-kit/shared': path.resolve(import.meta.dirname, '..', 'shared'),\n38:     },\n39:   },\n40: });\n\n(End of file - total 40 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────\n// MODULE: Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nimport { defineConfig } from 'vitest/config';\n\nconst TEST_TIMEOUT_MS = 30_000; // 30s default, increase for CI if needed\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst _INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n\nexport default defineConfig({\n  root: path.resolve(import.meta.dirname, '..'),\n  test: {\n    include: [\n      'runtime/tests/**/*.{vitest,test}.ts',\n      '../system-deep-loop/runtime/tests/**/*.{vitest,test}.ts',\n    ],\n    exclude: [","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/vitest.config.ts","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nimport { defineConfig } from 'vitest/config';\n\nconst TEST_TIMEOUT_MS = 30_000; // 30s default, increase for CI if needed\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst _INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n\nexport default defineConfig({\n  root: path.resolve(import.meta.dirname, '..'),\n  test: {\n    include: [\n      'runtime/tests/**/*.{vitest,test}.ts',\n      '../system-deep-loop/runtime/tests/**/*.{vitest,test}.ts',\n    ],\n    exclude: [\n      'runtime/tests/archive/**',\n      'runtime/cli/**',\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, 'tests', '_support', 'vitest-setup.ts'),\n    ],\n    // Several script suites mutate shared process-level state and temp project roots.\n    // Run files serially so the combined config remains deterministic.\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    reporters: ['default', 'hanging-process'],\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n      '@spec-kit/shared': path.resolve(import.meta.dirname, '..', 'shared'),\n    },\n  },\n});","lineStart":1,"lineEnd":40,"totalLines":40,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/vitest.config.ts","time":{"start":1788619947879,"end":1788619947903}},"id":"prt_0720e7f66001jAVo6G3BEr3DGB","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720dfe83001jMYfErz284yo5E"}}
