{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/package.json","text":"{\n  \"name\": \"system-spec-kit\",\n  \"version\": \"1.7.2\",\n  \"private\": true,\n  \"description\": \"Unified workspace for the Spec Kit engine and its CLI tools\",\n  \"workspaces\": [\n    \"shared\",\n    \"runtime\",\n    \"runtime/cli\"\n  ],\n  \"engines\": {\n    \"node\": \">=20.11.0\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc --build\",\n    \"typecheck\": \"npm run --workspaces=false typecheck:root\",\n    \"typecheck:root\": \"tsc -p shared/tsconfig.json && tsc --noEmit --composite false -p runtime/tsconfig.json && tsc --noEmit --composite false -p runtime/cli/tsconfig.json\",\n    \"build:watch\": \"tsc --build --watch\",\n    \"test\": \"npm run --workspaces=false test:root\",\n    \"test:root\": \"node runtime/cli/dist/continuity/generate-context.js --help && echo 'CLI smoke test passed' && node runtime/cli/tests/test-embeddings-factory.js && npm run test --workspace=@spec-kit/runtime && npm run test --workspace=@spec-kit/cli\",\n    \"test:runtime\": \"npm run test --workspace=@spec-kit/runtime\",\n    \"test:cli\": \"node runtime/cli/dist/continuity/generate-context.js --help && echo 'CLI smoke test passed'\",\n    \"test:task-enrichment\": \"npx vitest run runtime/cli/tests/task-enrichment.vitest.ts --config vitest.config.ts\",\n    \"test:embeddings\": \"node runtime/cli/tests/test-embeddings-factory.js\",\n    \"postinstall\": \"node runtime/cli/setup/record-node-version.js\"\n  },\n  \"overrides\": {\n    \"hono\": \"^4.12.34\",\n    \"@hono/node-server\": \"^2.0.5\",\n    \"vite\": \"^8.1.2\",\n    \"esbuild\": \"^0.28.1\",\n    \"fast-uri\": \"^3.1.5\",\n    \"nanoid\": \"3.3.17\",\n    \"picomatch\": \"^4.0.4\",\n    \"path-to-regexp\": \"^8.4.0\",\n    \"postcss\": \"^8.5.23\",\n    \"js-yaml\": \"^4.3.1\",\n    \"protobufjs\": \"^7.6.4\",\n    \"tar\": \"^7.5.19\",\n    \"@protobufjs/utf8\