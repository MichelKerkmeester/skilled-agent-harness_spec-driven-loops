metadata.json","text":"{\"effectiveConfig\":{\"kind\":\"cli-opencode\",\"executable\":\"opencode\",\"executableVersion\":\"sha256:f554a08dee4c34f4f43df63af72f0a6afbe57f955496853f411767718927bf2c\",\"model\":\"llmgateway/gpt-5.6-luna\",\"reasoningEffort\":\"max\",\"serviceTier\":null,\"sandboxMode\":\"danger-full-access\",\"permissionMode\":\"acceptEdits\",\"webSearch\":\"inherit\"},\"invocationFingerprint\":\"inv:3e59632255f7d001d39895e44ece3282e3b7ee27ec011311cb130ba6eb664269\"}","lineStart":1,"lineEnd":1,"totalLines":1,"truncated":false}},"title":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/invocation-metadata.json","time":{"start":1788619850386,"end":1788619850465}},"id":"prt_0720d02900016dsJ9EvWOEzQrV","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720cd961001O61XZ4w9PEjhWG"}}
