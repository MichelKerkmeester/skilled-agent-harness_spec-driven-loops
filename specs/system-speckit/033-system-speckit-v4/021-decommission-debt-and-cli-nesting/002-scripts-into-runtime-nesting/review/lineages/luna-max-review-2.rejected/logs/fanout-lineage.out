ck-prerequisites.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Validate spec folder exists and contains required files for its level\",\n      \"trigger\": [\"check prerequisites\", \"verify files\"],\n      \"calledBy\": [\"AI Assistant\", \"Implementation Phase\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"options\": \"--json, --require-tasks, --include-tasks, --paths-only\"\n      },\n      \"outputs\": [\"FEATURE_DIR path\", \"AVAILABLE_DOCS list\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"calculate-completeness\",\n      \"path\": \"runtime/cli/spec/calculate-completeness.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Calculate percentage of template placeholders replaced with real content\",\n      \"trigger\": [\"calculate progress\", \"completeness\"],\n      \"calledBy\": [\"AI Assistant\", \"Progress Tracking\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--verbose, --json, --file <path>, --quality\"\n      },\n      \"outputs\": [\"Completeness percentage\", \"Per-file breakdown (with --verbose)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"test-validation\",\n      \"path\": \"runtime/cli/tests/test-validation.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Test runner for validate-spec.sh against fixture spec folders\",\n      \"trigger\": [\"test validation\", \"run tests\"],\n      \"calledBy\": [\"Developer\", \"CI/CD Pipeline\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"options\": \"-v (verbose), -t NAME (single test), -c CATEGORY, -l (list), -h (help)\"\n      },\n      \"outputs\": [\"Test pass/fail results\", \"Coverage report\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"validate-spec.sh\", \"test-fixtures/\"]\n    },\n    {\n      \"name\": \"create-spec-folder\",\n      \"path\": \"runtime/cli/spec/create.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Create new spec folders with appropriate templates based on documentation level\",\n      \"trigger\": [\"create spec\", \"new spec folder\", \"Option B\"],\n      \"calledBy\": [\"AI Assistant\", \"Gate 3 (Option B)\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Feature description\",\n        \"options\": \"--short-name, --level (1/2/3), --number, --skip-branch, --sharded, --subfolder\"\n      },\n      \"outputs\": [\"New spec folder with templates\", \"Git branch (optional)\"],\n      \"gate\": \"Gate 3 (Spec Folder Creation)\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"templates/\"]\n    },\n    {\n      \"name\": \"generate-nested-changelog\",\n      \"path\": \"runtime/cli/dist/spec-folder/nested-changelog.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate packet-local changelog content for a root spec folder or a nested phase child\",\n      \"trigger\": [\"nested changelog\", \"packet changelog\", \"phase changelog\", \"spec changelog\"],\n      \"calledBy\": [\"AI Assistant\", \"Completion workflows\", \"Create changelog command\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --write, --mode <auto|root|phase>, --output <path>\"\n      },\n      \"outputs\": [\"Rendered markdown\", \"Nested changelog payload\", \"packet-local changelog file (with --write)\"],\n      \"gate\": \"Completion workflow\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"scripts/spec-folder/*.ts\", \"templates/changelog/\"]\n    },\n    {\n      \"name\": \"recommend-level\",\n      \"path\": \"runtime/cli/spec/recommend-level.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Recommend documentation level based on task complexity factors\",\n      \"trigger\": [\"recommend level\", \"what level\"],\n      \"calledBy\": [\"AI Assistant\", \"Gate 3\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"options\": \"--loc <number>, --files <number>, --auth, --api, --db, --architectural, --json\"\n      },\n      \"outputs\": [\"Recommended level (0-3)\", \"Score breakdown\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"archive-spec\",\n      \"path\": \"runtime/cli/spec/archive.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Move completed spec folders to archive, keeping specs/ directory clean\",\n      \"trigger\": [\"archive spec\", \"move to archive\"],\n      \"calledBy\": [\"AI Assistant\", \"Cleanup\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--list, --restore <archived-folder>\"\n      },\n      \"outputs\": [\"Archived folder path\", \"Archive listing (with --list)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"calculate-completeness.sh\"]\n    },\n    {\n      \"name\": \"common\",\n      \"path\": \"runtime/cli/common.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Repository and branch utilities - get_repo_root(), get_current_branch()\",\n      \"trigger\": [],\n      \"calledBy\": [\"Other scripts\"],\n      \"essential\": true,\n      \"inputs\": {},\n      \"outputs\": [\"Utility functions\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": [],\n      \"isLibrary\": true\n    },\n    {\n      \"name\": \"test-embeddings-factory\",\n      \"path\": \"runtime/cli/tests/test-embeddings-factory.js\",\n      \"type\": \"node\",\n      \"description\": \"Test and verify embedding provider configuration\",\n      \"trigger\": [\"test embeddings\", \"verify provider\"],\n      \"calledBy\": [\"Developer\", \"Debugging\"],\n      \"essential\": false,\n      \"inputs\": {},\n      \"outputs\": [\"Provider status\", \"Configuration details\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"lib/embeddings/\"]\n    },\n    {\n      \"name\": \"check-markdown-links\",\n      \"path\": \"runtime/cli/check-markdown-links.cjs\",\n      \"type\": \"node\",\n      \"description\": \"Repo-wide markdown-link integrity guard over skills/commands/agents; strips fenced + inline code; complements the wikilink checker; exit 1 on any broken link\",\n      \"trigger\": [\"check markdown links\", \"link integrity\", \"broken links\"],\n      \"calledBy\": [\"CI/CD Pipeline\", \"Developer\"],\n      \"essential\": false,\n      \"inputs\": { \"optional\": \"--self-test (assert inline-code handling; no filesystem walk)\" },\n      \"outputs\": [\"Broken-link report\", \"Exit code (0 clean / 1 broken)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"node:fs\", \"node:path\"]\n    }\n  ],\n  \"rules\": [\n    {\n      \"name\": \"check-files\",\n      \"path\": \"runtime/cli/rules/check-files.sh\",\n      \"type\": \"bash\",\n      \"description\": \"FILE_EXISTS rule - validates required files exist for documentation level\",\n      \"severity\": \"error\",\n      \"essential\": true,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-folder-naming\",\n      \"path\": \"runtime/cli/rules/check-folder-naming.sh\",\n      \"type\": \"bash\",\n      \"description\": \"FOLDER_NAMING rule - validates ###-short-name convention\",\n      \"severity\": \"error\",\n      \"essential\": true,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-frontmatter\",\n      \"path\": \"runtime/cli/rules/check-frontmatter.sh\",\n      \"type\": \"bash\",\n      \"description\": \"FRONTMATTER_VALID rule - validates YAML frontmatter structure\",\n      \"severity\": \"warning\",\n      \"essential\": false,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-placeholders\",\n      \"path\": \"runtime/cli/rules/check-placeholders.sh\",\n      \"type\": \"bash\",\n      \"description\": \"PLACEHOLDER_FILLED rule - detects unfilled [TODO:], [TBD], {{mustache}} placeholders\",\n      \"severity\": \"warning\",\n      \"essential\": false,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-level\",\n      \"path\": \"runtime/cli/rules/check-level.sh\",\n      \"type\": \"bash\",\n      \"description\": \"LEVEL_DECLARED rule - checks if documentation level was explicitly declared\",\n      \"severity\": \"info\",\n      \"essential\": false,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-complexity\",\n      \"path\": \"runtime/cli/rules/check-complexity.sh\",\n      \"type\": \"bash\",\n      \"description\": \"COMPLEXITY_MATCH rule - validates declared complexity matches actual content metrics\",\n      \"severity\": \"warning\",\n      \"essential\": false,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-ai-protocols\",\n      \"path\": \"runtime/cli/rules/check-ai-protocols.sh\",\n      \"type\": \"bash\",\n      \"description\": \"AI_PROTOCOL rule - validates AI execution protocols present for Level 3+\",\n      \"severity\": \"warning\",\n      \"essential\": false,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-level-match\",\n      \"path\": \"runtime/cli/rules/check-level-match.sh\",\n      \"type\": \"bash\",\n      \"description\": \"LEVEL_MATCH rule - validates level consistency across all spec folder files\",\n      \"severity\": \"error\",\n      \"essential\": true,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-toc-policy\",\n      \"path\": \"runtime/cli/rules/check-toc-policy.sh\",\n      \"type\": \"bash\",\n      \"description\": \"TOC_POLICY rule - allows ToC only in research/research.md and rejects ToC in standard spec artifacts\",\n      \"severity\": \"error\",\n      \"essential\": true,\n      \"version\": \"1.0.0\"\n    }\n  ],\n  \"libraries\": {\n    \"shell\": [\n      {\n        \"name\": \"shell-common\",\n        \"path\": \"runtime/cli/lib/shell-common.sh\",\n        \"description\": \"Shared shell utilities (colors, logging, result tracking)\"\n      },\n      {\n        \"name\": \"git-branch\",\n        \"path\": \"runtime/cli/lib/git-branch.sh\",\n        \"description\": \"Git branch utilities\"\n      },\n      {\n        \"name\": \"template-utils\",\n        \"path\": \"runtime/cli/lib/template-utils.sh\",\n        \"description\": \"Template processing helpers\"\n      }\n    ],\n    \"javascript\": [\n      {\n        \"name\": \"embeddings\",\n        \"path\": \"runtime/cli/dist/lib/embeddings.js\",\n        \"description\": \"Re-exports from ../../shared/embeddings\"\n      },\n      {\n        \"name\": \"trigger-extractor\",\n        \"path\": \"runtime/cli/dist/lib/trigger-extractor.js\",\n        \"description\": \"Re-exports from ../../shared/trigger-extractor\"\n      },\n      {\n        \"name\": \"semantic-summarizer\",\n        \"path\": \"runtime/cli/dist/lib/semantic-summarizer.js\",\n        \"description\": \"Message classification\"","lineStart":1,"lineEnd":350,"totalLines":394,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json","time":{"start":1788619947880,"end":1788619947907}},"id":"prt_0720e7f67001rd97293tjnk88K","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720dfe83001jMYfErz284yo5E"}}
{"type":"tool_use","timestamp":1788619947911,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_8gHsRNHqUO53pvItzOhe9ZqH","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts","offset":1,"limit":200},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts</path>\n<type>file</type>\n<content>\n1: // -------------------------------------------------------------------\n2: // MODULE: Spec Root Registry Tests\n3: // -------------------------------------------------------------------\n4: \n5: import { existsSync } from 'node:fs';\n6: import path from 'node:path';\n7: import { fileURLToPath } from 'node:url';\n8: \n9: import { describe, expect, it } from 'vitest';\n10: \n11: import {\n12:   SPEC_ROOT_RESOLVERS,\n13:   registryCoverageGaps,\n14: } from '../core/spec-root-registry.js';\n15: import type { SpecRootPrecedence } from '../core/spec-root-registry.js';\n16: \n17: const ALLOWED_PRECEDENCE = new Set<SpecRootPrecedence>([\n18:   'legacy-first',\n19:   'canonical-first',\n20:   'canonical-only',\n21:   'direct-path-first',\n22:   'membership-only',\n23: ]);\n24: \n25: // Entry file values carry a trailing ':line-range' (and sometimes several,\n26: // comma-separated) suffix for human navigation; strip it to get the real path.\n27: function registryEntryFilePath(entryFile: string): string {\n28:   return entryFile.replace(/:\\d.*$/u, '');\n29: }\n30: \n31: const SKILL_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..', '..');\n32: \n33: describe('spec root resolver registry', () => {\n34:   it('contains only well-formed resolver entries', () => {\n35:     expect(SPEC_ROOT_RESOLVERS.length).toBeGreaterThan(0);\n36: \n37:     for (const entry of SPEC_ROOT_RESOLVERS) {\n38:       expect(entry.file.trim()).not.toBe('');\n39:       expect(entry.file).toMatch(/^(runtime|shared)\\/.+:\\d/u);\n40:       expect(entry.symbol.trim()).not.toBe('');\n41:       expect(entry.consumerOrEffect.trim()).not.toBe('');\n42:       expect(ALLOWED_PRECEDENCE.has(entry.precedence)).toBe(true);\n43:     }\n44:   });\n45: \n46:   it('every listed source path exists on disk', () => {\n47:     const missing = SPEC_ROOT_RESOLVERS\n48:       .map((entry) => registryEntryFilePath(entry.file))\n49:       .filter((relativePath) => !existsSync(path.join(SKILL_ROOT, relativePath)));\n50:     expect(missing).toEqual([]);\n51:   });\n52: \n53:   it('has no registry coverage gaps', () => {\n54:     expect(registryCoverageGaps()).toEqual([]);\n55:   });\n56: });\n\n(End of file - total 56 lines)\n</content>","metadata":{"preview":"// -------------------------------------------------------------------\n// MODULE: Spec Root Registry Tests\n// -------------------------------------------------------------------\n\nimport { existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  SPEC_ROOT_RESOLVERS,\n  registryCoverageGaps,\n} from '../core/spec-root-registry.js';\nimport type { SpecRootPrecedence } from '../core/spec-root-registry.js';\n\nconst ALLOWED_PRECEDENCE = new Set<SpecRootPrecedence>([\n  'legacy-first',\n  'canonical-first',\n  'canonical-only',","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts","text":"// -------------------------------------------------------------------\n// MODULE: Spec Root Registry Tests\n// -------------------------------------------------------------------\n\nimport { existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  SPEC_ROOT_RESOLVERS,\n  registryCoverageGaps,\n} from '../core/spec-root-registry.js';\nimport type { SpecRootPrecedence } from '../core/spec-root-registry.js';\n\nconst ALLOWED_PRECEDENCE = new Set<SpecRootPrecedence>([\n  'legacy-first',\n  'canonical-first',\n  'canonical-only',\n  'direct-path-first',\n  'membership-only',\n]);\n\n// Entry file values carry a trailing ':line-range' (and sometimes several,\n// comma-separated) suffix for human navigation; strip it to get the real path.\nfunction registryEntryFilePath(entryFile: string): string {\n  return entryFile.replace(/:\\d.*$/u, '');\n}\n\nconst SKILL_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..', '..');\n\ndescribe('spec root resolver registry', () => {\n  it('contains only well-formed resolver entries', () => {\n    expect(SPEC_ROOT_RESOLVERS.length).toBeGreaterThan(0);\n\n    for (const entry of SPEC_ROOT_RESOLVERS) {\n      expect(entry.file.trim()).not.toBe('');\n      expect(entry.file).toMatch(/^(runtime|shared)\\/.+:\\d/u);\n      expect(entry.symbol.trim()).not.toBe('');\n      expect(entry.consumerOrEffect.trim()).not.toBe('');\n      expect(ALLOWED_PRECEDENCE.has(entry.precedence)).toBe(true);\n    }\n  });\n\n  it('every listed source path exists on disk', () => {\n    const missing = SPEC_ROOT_RESOLVERS\n      .map((entry) => registryEntryFilePath(entry.file))\n      .filter((relativePath) => !existsSync(path.join(SKILL_ROOT, relativePath)));\n    expect(missing).toEqual([]);\n  });\n\n  it('has no registry coverage gaps', () => {\n    expect(registryCoverageGaps()).toEqual([]);\n  });\n});","lineStart":1,"lineEnd":56,"totalLines":56,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts","time":{"start":1788619947883,"end":1788619947909}},"id":"prt_0720e7f6b001uMDFa7FR2Po3UJ","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720dfe83001jMYfErz284yo5E"}}
{"type":"tool_use","timestamp":1788619947912,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_Nw4sUDeS74zMw8vJPaWPILpG","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/spec-root-registry.ts","offset":1,"limit":250},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/spec-root-registry.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Spec Root Registry\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. TYPE DEFINITIONS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: /** Supported resolution precedence contracts. */\n10: export type SpecRootPrecedence =\n11:   | 'legacy-first'\n12:   | 'canonical-first'\n13:   | 'canonical-only'\n14:   | 'direct-path-first'\n15:   | 'membership-only';\n16: \n17: /** Maintained metadata for one grouped spec-root resolver call site. */\n18: export interface SpecRootResolverEntry {\n19:   readonly file: string;\n20:   readonly symbol: string;\n21:   readonly consumerOrEffect: string;\n22:   readonly precedence: SpecRootPrecedence;\n23: }\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 2. RESOLVER INVENTORY\n27: // ───────────────────────────────────────────────────────────────────\n28: \n29: /** Complete maintained inventory of known spec-root resolution call sites. */\n30: export const SPEC_ROOT_RESOLVERS = [\n31:   {\n32:     file: 'runtime/cli/core/config.ts:321-360',\n33:     symbol: 'getSpecsDirectories / findActiveSpecsDir / getAllExistingSpecsDirs',\n34:     consumerOrEffect:\n35:       'Active root selection and existing-root enumeration; aliases retain their first spelling.',\n36:     precedence: 'canonical-first',\n37:   },\n38:   {\n39:     file: 'runtime/cli/core/subfolder-utils.ts:39-58,129-149',\n40:     symbol: 'findChildFolderSync / findChildFolderAsync',\n41:     consumerOrEffect: 'Synchronous and asynchronous recursive packet lookup with realpath deduplication.',\n42:     precedence: 'legacy-first',\n43:   },\n44:   {\n45:     file: 'runtime/cli/spec-folder/folder-detector.ts:181-186,1121-1139',\n46:     symbol: 'isUnderApprovedSpecsRoots / detectSpecFolder',\n47:     consumerOrEffect: 'Containment accepts both roots; explicit roots are preserved before bare-name lookup.',\n48:     precedence: 'direct-path-first',\n49:   },\n50:   {\n51:     file: 'runtime/cli/continuity/generate-context.ts:193-230,269-380,531-549,785-799',\n52:     symbol:\n53:       'isUnderApprovedSpecsRoot / resolveCliSpecFolderReference / resolveExistingSpecFolderPath / '\n54:       + 'getPacketIdFromGraphMetadata / validateArguments',\n55:     consumerOrEffect:\n56:       'Save validation, lookup, packet identity, and diagnostics use exact paths before root search.',\n57:     precedence: 'direct-path-first',\n58:   },\n59:   {\n60:     file: 'runtime/cli/extractors/collect-session-data.ts:1063-1093,1193-1220,1437-1469',\n61:     symbol: 'resolveProvidedSpecFolder / resolveSpecFolderRelative / collectSessionData',\n62:     consumerOrEffect: 'Session packet and related-document resolution retain a matched explicit root.',\n63:     precedence: 'direct-path-first',\n64:   },\n65:   {\n66:     file: 'runtime/cli/core/workflow.ts:1016-1043,1663-1687',\n67:     symbol: 'runWorkflow',\n68:     consumerOrEffect: 'Root-relative identity and description regeneration retain the detected absolute target.',\n69:     precedence: 'direct-path-first',\n70:   },\n71:   {\n72:     file: 'runtime/cli/spec-folder/directory-setup.ts:22-80',\n73:     symbol: 'ensureSpecFolderExists',\n74:     consumerOrEffect:\n75:       'Write-boundary validation accepts either approved root; active-root order affects diagnostics only.',\n76:     precedence: 'membership-only',\n77:   },\n78:   {\n79:     file: 'runtime/cli/spec-folder/nested-changelog.ts:589',\n80:     symbol: 'ensureApprovedSpecFolder',\n81:     consumerOrEffect:\n82:       'Changelog write-boundary validation accepts either approved root without selecting a target.',\n83:     precedence: 'membership-only',\n84:   },\n85:   {\n86:     file: 'runtime/handlers/spec-doc-discovery.ts:203-223,308-382',\n87:     symbol: 'findSpecDocuments / findGraphMetadataFiles',\n88:     consumerOrEffect: 'Spec-document and graph-metadata discovery use legacy only when canonical is absent.',\n89:     precedence: 'canonical-first',\n90:   },\n91:   {\n92:     file: 'shared/gate-3-classifier.ts:125-137,348-418',\n93:     symbol:\n94:       'SPEC_ROOTS / findWorkspaceRoot / getSpecRoots / collectSpecFolderCandidates',\n95:     consumerOrEffect: 'Workspace root discovery and candidate binding enumerate canonical before legacy.',\n96:     precedence: 'canonical-first',\n97:   },\n98:   {\n99:     file: 'runtime/cli/spec/create.sh:811-819',\n100:     symbol: 'SPECS_DIR selection',\n101:     consumerOrEffect: 'Packet creation uses the requested tracked or untracked destination directly.',\n102:     precedence: 'direct-path-first',\n103:   },\n104:   {\n105:     file: 'runtime/cli/graph/migrate-generated-json.ts:149-170,590-598',\n106:     symbol: 'resolveRepoRoot / parseArgs',\n107:     consumerOrEffect: 'Graph metadata migration defaults directly to the canonical root.',\n108:     precedence: 'canonical-only',\n109:   },\n110:   {\n111:     file: 'runtime/cli/graph/backfill-graph-metadata.ts:238-259,278-319',\n112:     symbol: 'resolveRepoRoot / resolveScopedTarget / planBackfill',\n113:     consumerOrEffect: 'Graph metadata backfill defaults directly to the canonical root.',\n114:     precedence: 'canonical-only',\n115:   },\n116:   // The memory engine's startup drift-marker containment and pending-recovery\n117:   // scan left the package when that engine was deleted, and no successor\n118:   // resolves spec roots for them, so the registry no longer lists them.\n119:   {\n120:     file: 'runtime/lib/search/folder-discovery.ts:1363-1379',\n121:     symbol: 'getSpecsBasePaths',\n122:     consumerOrEffect:\n123:       'Generic runtime spec-base discovery enumerates the legacy root before the canonical root.',\n124:     precedence: 'legacy-first',\n125:   },\n126:   {\n127:     file: 'runtime/lib/resume/resume-ladder.ts:863-910',\n128:     symbol: 'resolveFromFolderPath / resolveSpecFolder',\n129:     consumerOrEffect:\n130:       'Resume packet resolution checks canonical before legacy while preserving absolute input.',\n131:     precedence: 'canonical-first',\n132:   },\n133:   {\n134:     file: 'runtime/lib/continuity/authored-continuity-snapshot.ts:50-70',\n135:     symbol: 'normalizeSpecFolder / resolveSpecFolderPath',\n136:     consumerOrEffect: 'Authored continuity resolution checks canonical before legacy.',\n137:     precedence: 'canonical-first',\n138:   },\n139:   {\n140:     file: 'runtime/api/graph-refresh.ts:19-55',\n141:     symbol: 'resolveSpecFolderPath',\n142:     consumerOrEffect:\n143:       'Graph refresh resolves existing direct paths, discovery, canonical fallback, then legacy fallback.',\n144:     precedence: 'direct-path-first',\n145:   },\n146:   {\n147:     file: 'runtime/cli/utils/spec-affinity.ts:153-174',\n148:     symbol: 'resolveSpecFolderPathCandidates',\n149:     consumerOrEffect:\n150:       'Spec-affinity candidates preserve direct forms before legacy and canonical root candidates.',\n151:     precedence: 'direct-path-first',\n152:   },\n153:   {\n154:     file: 'runtime/cli/lib/validate-memory-quality.ts:619-651',\n155:     symbol: 'resolveSpecFolderPath',\n156:     consumerOrEffect:\n157:       'Memory-quality resolution checks a direct candidate before legacy and canonical at each ancestor.',\n158:     precedence: 'direct-path-first',\n159:   },\n160: ] as const satisfies readonly SpecRootResolverEntry[];\n161: \n162: // ───────────────────────────────────────────────────────────────────\n163: // 3. COVERAGE AUDIT\n164: // ───────────────────────────────────────────────────────────────────\n165: \n166: const REQUIRED_REGISTRY_FIELDS = [\n167:   'file',\n168:   'symbol',\n169:   'consumerOrEffect',\n170:   'precedence',\n171: ] as const satisfies readonly (keyof SpecRootResolverEntry)[];\n172: \n173: /** Return stable field paths for incomplete registry entries. */\n174: export function registryCoverageGaps(): string[] {\n175:   return SPEC_ROOT_RESOLVERS.flatMap((entry, index) =>\n176:     REQUIRED_REGISTRY_FIELDS\n177:       .filter((field) => entry[field].trim().length === 0)\n178:       .map((field) => `SPEC_ROOT_RESOLVERS[${index}].${field}`),\n179:   );\n180: }\n\n(End of file - total 180 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Spec Root Registry\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Supported resolution precedence contracts. */\nexport type SpecRootPrecedence =\n  | 'legacy-first'\n  | 'canonical-first'\n  | 'canonical-only'\n  | 'direct-path-first'\n  | 'membership-only';\n\n/** Maintained metadata for one grouped spec-root resolver call site. */\nexport interface SpecRootResolverEntry {\n  readonly file: string;\n  readonly symbol: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/spec-root-registry.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Spec Root Registry\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Supported resolution precedence contracts. */\nexport type SpecRootPrecedence =\n  | 'legacy-first'\n  | 'canonical-first'\n  | 'canonical-only'\n  | 'direct-path-first'\n  | 'membership-only';\n\n/** Maintained metadata for one grouped spec-root resolver call site. */\nexport interface SpecRootResolverEntry {\n  readonly file: string;\n  readonly symbol: string;\n  readonly consumerOrEffect: string;\n  readonly precedence: SpecRootPrecedence;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 2. RESOLVER INVENTORY\n// ───────────────────────────────────────────────────────────────────\n\n/** Complete maintained inventory of known spec-root resolution call sites. */\nexport const SPEC_ROOT_RESOLVERS = [\n  {\n    file: 'runtime/cli/core/config.ts:321-360',\n    symbol: 'getSpecsDirectories / findActiveSpecsDir / getAllExistingSpecsDirs',\n    consumerOrEffect:\n      'Active root selection and existing-root enumeration; aliases retain their first spelling.',\n    precedence: 'canonical-first',\n  },\n  {\n    file: 'runtime/cli/core/subfolder-utils.ts:39-58,129-149',\n    symbol: 'findChildFolderSync / findChildFolderAsync',\n    consumerOrEffect: 'Synchronous and asynchronous recursive packet lookup with realpath deduplication.',\n    precedence: 'legacy-first',\n  },\n  {\n    file: 'runtime/cli/spec-folder/folder-detector.ts:181-186,1121-1139',\n    symbol: 'isUnderApprovedSpecsRoots / detectSpecFolder',\n    consumerOrEffect: 'Containment accepts both roots; explicit roots are preserved before bare-name lookup.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/continuity/generate-context.ts:193-230,269-380,531-549,785-799',\n    symbol:\n      'isUnderApprovedSpecsRoot / resolveCliSpecFolderReference / resolveExistingSpecFolderPath / '\n      + 'getPacketIdFromGraphMetadata / validateArguments',\n    consumerOrEffect:\n      'Save validation, lookup, packet identity, and diagnostics use exact paths before root search.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/extractors/collect-session-data.ts:1063-1093,1193-1220,1437-1469',\n    symbol: 'resolveProvidedSpecFolder / resolveSpecFolderRelative / collectSessionData',\n    consumerOrEffect: 'Session packet and related-document resolution retain a matched explicit root.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/core/workflow.ts:1016-1043,1663-1687',\n    symbol: 'runWorkflow',\n    consumerOrEffect: 'Root-relative identity and description regeneration retain the detected absolute target.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/spec-folder/directory-setup.ts:22-80',\n    symbol: 'ensureSpecFolderExists',\n    consumerOrEffect:\n      'Write-boundary validation accepts either approved root; active-root order affects diagnostics only.',\n    precedence: 'membership-only',\n  },\n  {\n    file: 'runtime/cli/spec-folder/nested-changelog.ts:589',\n    symbol: 'ensureApprovedSpecFolder',\n    consumerOrEffect:\n      'Changelog write-boundary validation accepts either approved root without selecting a target.',\n    precedence: 'membership-only',\n  },\n  {\n    file: 'runtime/handlers/spec-doc-discovery.ts:203-223,308-382',\n    symbol: 'findSpecDocuments / findGraphMetadataFiles',\n    consumerOrEffect: 'Spec-document and graph-metadata discovery use legacy only when canonical is absent.',\n    precedence: 'canonical-first',\n  },\n  {\n    file: 'shared/gate-3-classifier.ts:125-137,348-418',\n    symbol:\n      'SPEC_ROOTS / findWorkspaceRoot / getSpecRoots / collectSpecFolderCandidates',\n    consumerOrEffect: 'Workspace root discovery and candidate binding enumerate canonical before legacy.',\n    precedence: 'canonical-first',\n  },\n  {\n    file: 'runtime/cli/spec/create.sh:811-819',\n    symbol: 'SPECS_DIR selection',\n    consumerOrEffect: 'Packet creation uses the requested tracked or untracked destination directly.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/graph/migrate-generated-json.ts:149-170,590-598',\n    symbol: 'resolveRepoRoot / parseArgs',\n    consumerOrEffect: 'Graph metadata migration defaults directly to the canonical root.',\n    precedence: 'canonical-only',\n  },\n  {\n    file: 'runtime/cli/graph/backfill-graph-metadata.ts:238-259,278-319',\n    symbol: 'resolveRepoRoot / resolveScopedTarget / planBackfill',\n    consumerOrEffect: 'Graph metadata backfill defaults directly to the canonical root.',\n    precedence: 'canonical-only',\n  },\n  // The memory engine's startup drift-marker containment and pending-recovery\n  // scan left the package when that engine was deleted, and no successor\n  // resolves spec roots for them, so the registry no longer lists them.\n  {\n    file: 'runtime/lib/search/folder-discovery.ts:1363-1379',\n    symbol: 'getSpecsBasePaths',\n    consumerOrEffect:\n      'Generic runtime spec-base discovery enumerates the legacy root before the canonical root.',\n    precedence: 'legacy-first',\n  },\n  {\n    file: 'runtime/lib/resume/resume-ladder.ts:863-910',\n    symbol: 'resolveFromFolderPath / resolveSpecFolder',\n    consumerOrEffect:\n      'Resume packet resolution checks canonical before legacy while preserving absolute input.',\n    precedence: 'canonical-first',\n  },\n  {\n    file: 'runtime/lib/continuity/authored-continuity-snapshot.ts:50-70',\n    symbol: 'normalizeSpecFolder / resolveSpecFolderPath',\n    consumerOrEffect: 'Authored continuity resolution checks canonical before legacy.',\n    precedence: 'canonical-first',\n  },\n  {\n    file: 'runtime/api/graph-refresh.ts:19-55',\n    symbol: 'resolveSpecFolderPath',\n    consumerOrEffect:\n      'Graph refresh resolves existing direct paths, discovery, canonical fallback, then legacy fallback.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/utils/spec-affinity.ts:153-174',\n    symbol: 'resolveSpecFolderPathCandidates',\n    consumerOrEffect:\n      'Spec-affinity candidates preserve direct forms before legacy and canonical root candidates.',\n    precedence: 'direct-path-first',\n  },\n  {\n    file: 'runtime/cli/lib/validate-memory-quality.ts:619-651',\n    symbol: 'resolveSpecFolderPath',\n    consumerOrEffect:\n      'Memory-quality resolution checks a direct candidate before legacy and canonical at each ancestor.',\n    precedence: 'direct-path-first',\n  },\n] as const satisfies readonly SpecRootResolverEntry[];\n\n// ───────────────────────────────────────────────────────────────────\n// 3. COVERAGE AUDIT\n// ───────────────────────────────────────────────────────────────────\n\nconst REQUIRED_REGISTRY_FIELDS = [\n  'file',\n  'symbol',\n  'consumerOrEffect',\n  'precedence',\n] as const satisfies readonly (keyof SpecRootResolverEntry)[];\n\n/** Return stable field paths for incomplete registry entries. */\nexport function registryCoverageGaps(): string[] {\n  return SPEC_ROOT_RESOLVERS.flatMap((entry, index) =>\n    REQUIRED_REGISTRY_FIELDS\n      .filter((field) => entry[field].trim().length === 0)\n      .map((field) => `SPEC_ROOT_RESOLVERS[${index}].${field}`),\n  );\n}","lineStart":1,"lineEnd":180,"totalLines":180,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/core/spec-root-registry.ts","time":{"start":1788619947882,"end":1788619947909}},"id":"prt_0720e7f690015kwQy4dvM4pLU2","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720dfe83001jMYfErz284yo5E"}}
