nd package manifest.\",\"affectedSur... (line truncated to 2000 chars)","lineStart":1,"lineEnd":6,"totalLines":6,"truncated":false}},"title":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/deep-review-state.jsonl","time":{"start":1788620608597,"end":1788620608601}},"id":"prt_0721892b6001xUmJ599Aq7HC32","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072187ae2001hSY6KoMsN2CNZC"}}
