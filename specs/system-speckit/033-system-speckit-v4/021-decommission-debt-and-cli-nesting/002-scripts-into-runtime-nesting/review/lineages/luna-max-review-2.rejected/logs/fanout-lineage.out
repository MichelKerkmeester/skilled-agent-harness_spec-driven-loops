55:     \"tests/**/*.test.ts\",\n56:     \"tests/**/*.vitest.js\",\n57:     \"stress-test/**\",\n58:     \"stress-test/**/*.vitest.ts\",\n59:     \"stress-test/**/*.test.ts\",\n60:     \"tests/chunk-thinning.vitest.ts\",\n61:     \"tests/layer-definitions.vitest.ts\",\n62:     \"tests/dead-code-regression.vitest.ts\"\n63:   ]\n64: }\n\n(End of file - total 64 lines)\n</content>","metadata":{"preview":"{\n  \"extends\": \"../tsconfig.json\",\n  \"compilerOptions\": {\n    \"composite\": true,\n    \"rootDir\": \".\",\n    \"outDir\": \"./dist\",\n    \"module\": \"nodenext\",\n    \"moduleResolution\": \"nodenext\",\n    \"verbatimModuleSyntax\": true,\n    \"allowJs\": true,\n    \"resolveJsonModule\": true,\n    \"baseUrl\": \".\",\n    \"typeRoots\": [\n      \"../node_modules/@types\",\n      \"node_modules/@types\"\n    ],\n    \"paths\": {\n      \"vitest\": [\n        \"node_modules/vitest/dist/index.d.ts\"\n      ],","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/tsconfig.json","text":"{\n  \"extends\": \"../tsconfig.json\",\n  \"compilerOptions\": {\n    \"composite\": true,\n    \"rootDir\": \".\",\n    \"outDir\": \"./dist\",\n    \"module\": \"nodenext\",\n    \"moduleResolution\": \"nodenext\",\n    \"verbatimModuleSyntax\": true,\n    \"allowJs\": true,\n    \"resolveJsonModule\": true,\n    \"baseUrl\": \".\",\n    \"typeRoots\": [\n      \"../node_modules/@types\",\n      \"node_modules/@types\"\n    ],\n    \"paths\": {\n      \"vitest\": [\n        \"node_modules/vitest/dist/index.d.ts\"\n      ],\n      \"vitest/config\": [\n        \"node_modules/vitest/config.d.ts\"\n      ]\n    }\n  },\n  \"references\": [\n    {\n      \"path\": \"../shared\"\n    }\n  ],\n  \"include\": [\n    \"api/**/*.ts\",\n    \"configs/**/*.ts\",\n    \"core/**/*.ts\",\n    \"formatters/**/*.ts\",\n    \"handlers/**/*.ts\",\n    \"hooks/**/*.ts\",\n    \"lib/**/*.ts\",\n    \"schemas/**/*.ts\",\n    \"scripts/**/*.ts\",\n    \"utils/**/*.ts\"\n  ],\n  \"exclude\": [\n    \"node_modules\",\n    \"dist\",\n    \"../shared\",\n    \"../shared/**\",\n    \"cli/**\",\n    \"hooks/pi/**\",\n    \"lib/test-helpers/**\",\n    \"scripts/tests/**\",\n    \"tests/fixtures/**/*.ts\",\n    \"tests/**\",\n    \"tests/**/*.vitest.ts\",\n    \"tests/**/*.test.ts\",\n    \"tests/**/*.vitest.js\",\n    \"stress-test/**\",\n    \"stress-test/**/*.vitest.ts\",\n    \"stress-test/**/*.test.ts\",\n    \"tests/chunk-thinning.vitest.ts\",\n    \"tests/layer-definitions.vitest.ts\",\n    \"tests/dead-code-regression.vitest.ts\"\n  ]\n}","lineStart":1,"lineEnd":64,"totalLines":64,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/tsconfig.json","time":{"start":1788620374879,"end":1788620374891}},"id":"prt_07215035e001vAk5cUFPz3qV2U","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072143d79001sAz3VjyFeElJfq"}}
{"type":"tool_use","timestamp":1788620374895,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_TOs1d6162pPjs7vfwT2oMbGO","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/import-policy-rules.ts","offset":1,"limit":180},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/import-policy-rules.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Import Policy Rules\n3: // ───────────────────────────────────────────────────────────────────\n4: // Shared detection rules for prohibited cli -> internal runtime imports.\n5: \n6: // ───────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ───────────────────────────────────────────────────────────────\n9: \n10: import * as path from 'path';\n11: \n12: // ───────────────────────────────────────────────────────────────\n13: // 2. CONSTANTS\n14: // ───────────────────────────────────────────────────────────────\n15: \n16: const PROHIBITED_PACKAGE_IMPORTS = [\n17:   '@spec-kit/runtime/lib',\n18:   '@spec-kit/runtime/core',\n19:   '@spec-kit/runtime/handlers',\n20: ];\n21: \n22: // cli/ now nests inside runtime/, so a bare escape (no explicit \"runtime/\"\n23: // segment) reads differently by how many levels it climbs: one level up from\n24: // any cli/<subdir>/file.ts still lands inside cli/'s own lib or core, but a\n25: // second level escapes cli/ entirely into runtime/'s lib or core. handlers/\n26: // and shared/ have no same-named directory inside cli/, so any climb that\n27: // reaches either is unambiguous at one level. An explicit \"runtime/\" segment\n28: // is still prohibited at any depth, since spelling it out only serves to\n29: // re-enter runtime/ (or its dist symlink) directly.\n30: const RELATIVE_INTERNAL_RUNTIME_IMPORT_RE =\n31:   /^\\.\\.(?:\\/\\.\\.)*\\/runtime\\/(?:lib|core|handlers)(?:$|\\/)|^\\.\\.(?:\\/\\.\\.)*\\/(?:handlers|shared)(?:$|\\/)|^\\.\\.\\/\\.\\.(?:\\/\\.\\.)*\\/(?:lib|core)(?:$|\\/)/;\n32: \n33: // ───────────────────────────────────────────────────────────────\n34: // 3. HELPERS\n35: // ───────────────────────────────────────────────────────────────\n36: \n37: function normalizeRelativeImportPath(importPath: string): string {\n38:   if (!importPath.startsWith('.')) {\n39:     return importPath;\n40:   }\n41: \n42:   // Normalize Windows backslashes before POSIX normalization\n43:   const normalizedPath = path.posix.normalize(importPath.replace(/\\\\/g, '/'));\n44: \n45:   if (normalizedPath === '.') {\n46:     return './';\n47:   }\n48: \n49:   if (normalizedPath === '..' || normalizedPath.startsWith('../')) {\n50:     return normalizedPath;\n51:   }\n52: \n53:   return normalizedPath.startsWith('./') ? normalizedPath : `./${normalizedPath}`;\n54: }\n55: \n56: /**\n57:  * Normalize package-scoped import paths that contain `..` traversal segments.\n58:  * E.g., `@spec-kit/runtime/api/../lib/foo` → `@spec-kit/runtime/lib/foo`\n59:  */\n60: function normalizePackageImportPath(importPath: string): string {\n61:   if (importPath.startsWith('.') || !importPath.includes('..')) {\n62:     return importPath;\n63:   }\n64:   // Split into segments and collapse '..' traversals\n65:   const segments = importPath.split('/');\n66:   const resolved: string[] = [];\n67:   for (const segment of segments) {\n68:     if (segment === '..' && resolved.length > 0) {\n69:       resolved.pop();\n70:     } else {\n71:       resolved.push(segment);\n72:     }\n73:   }\n74:   return resolved.join('/');\n75: }\n76: \n77: // ───────────────────────────────────────────────────────────────\n78: // 4. EXPORTS\n79: // ───────────────────────────────────────────────────────────────\n80: \n81: /** Returns whether the import path violates the evaluation policy rules. */\n82: export function isProhibitedImportPath(importPath: string): boolean {\n83:   const normalizedImportPath = normalizeRelativeImportPath(importPath);\n84:   const normalizedPackagePath = normalizePackageImportPath(normalizedImportPath);\n85: \n86:   return PROHIBITED_PACKAGE_IMPORTS.some((baseImport) => (\n87:     normalizedPackagePath === baseImport || normalizedPackagePath.startsWith(`${baseImport}/`)\n88:   )) || RELATIVE_INTERNAL_RUNTIME_IMPORT_RE.test(normalizedPackagePath);\n89: }\n\n(End of file - total 89 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Import Policy Rules\n// ───────────────────────────────────────────────────────────────────\n// Shared detection rules for prohibited cli -> internal runtime imports.\n\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\n\nimport * as path from 'path';\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst PROHIBITED_PACKAGE_IMPORTS = [\n  '@spec-kit/runtime/lib',\n  '@spec-kit/runtime/core',\n  '@spec-kit/runtime/handlers',\n];","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/import-policy-rules.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Import Policy Rules\n// ───────────────────────────────────────────────────────────────────\n// Shared detection rules for prohibited cli -> internal runtime imports.\n\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\n\nimport * as path from 'path';\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst PROHIBITED_PACKAGE_IMPORTS = [\n  '@spec-kit/runtime/lib',\n  '@spec-kit/runtime/core',\n  '@spec-kit/runtime/handlers',\n];\n\n// cli/ now nests inside runtime/, so a bare escape (no explicit \"runtime/\"\n// segment) reads differently by how many levels it climbs: one level up from\n// any cli/<subdir>/file.ts still lands inside cli/'s own lib or core, but a\n// second level escapes cli/ entirely into runtime/'s lib or core. handlers/\n// and shared/ have no same-named directory inside cli/, so any climb that\n// reaches either is unambiguous at one level. An explicit \"runtime/\" segment\n// is still prohibited at any depth, since spelling it out only serves to\n// re-enter runtime/ (or its dist symlink) directly.\nconst RELATIVE_INTERNAL_RUNTIME_IMPORT_RE =\n  /^\\.\\.(?:\\/\\.\\.)*\\/runtime\\/(?:lib|core|handlers)(?:$|\\/)|^\\.\\.(?:\\/\\.\\.)*\\/(?:handlers|shared)(?:$|\\/)|^\\.\\.\\/\\.\\.(?:\\/\\.\\.)*\\/(?:lib|core)(?:$|\\/)/;\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\n\nfunction normalizeRelativeImportPath(importPath: string): string {\n  if (!importPath.startsWith('.')) {\n    return importPath;\n  }\n\n  // Normalize Windows backslashes before POSIX normalization\n  const normalizedPath = path.posix.normalize(importPath.replace(/\\\\/g, '/'));\n\n  if (normalizedPath === '.') {\n    return './';\n  }\n\n  if (normalizedPath === '..' || normalizedPath.startsWith('../')) {\n    return normalizedPath;\n  }\n\n  return normalizedPath.startsWith('./') ? normalizedPath : `./${normalizedPath}`;\n}\n\n/**\n * Normalize package-scoped import paths that contain `..` traversal segments.\n * E.g., `@spec-kit/runtime/api/../lib/foo` → `@spec-kit/runtime/lib/foo`\n */\nfunction normalizePackageImportPath(importPath: string): string {\n  if (importPath.startsWith('.') || !importPath.includes('..')) {\n    return importPath;\n  }\n  // Split into segments and collapse '..' traversals\n  const segments = importPath.split('/');\n  const resolved: string[] = [];\n  for (const segment of segments) {\n    if (segment === '..' && resolved.length > 0) {\n      resolved.pop();\n    } else {\n      resolved.push(segment);\n    }\n  }\n  return resolved.join('/');\n}\n\n// ───────────────────────────────────────────────────────────────\n// 4. EXPORTS\n// ───────────────────────────────────────────────────────────────\n\n/** Returns whether the import path violates the evaluation policy rules. */\nexport function isProhibitedImportPath(importPath: string): boolean {\n  const normalizedImportPath = normalizeRelativeImportPath(importPath);\n  const normalizedPackagePath = normalizePackageImportPath(normalizedImportPath);\n\n  return PROHIBITED_PACKAGE_IMPORTS.some((baseImport) => (\n    normalizedPackagePath === baseImport || normalizedPackagePath.startsWith(`${baseImport}/`)\n  )) || RELATIVE_INTERNAL_RUNTIME_IMPORT_RE.test(normalizedPackagePath);\n}","lineStart":1,"lineEnd":89,"totalLines":89,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/evals/import-policy-rules.ts","time":{"start":1788620374874,"end":1788620374892}},"id":"prt_072150359001Hucnkm2CF97I1p","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072143d79001sAz3VjyFeElJfq"}}
{"type":"tool_use","timestamp":1788620374895,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_my4yxKEUJQ1eOXPpom1hfBGr","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/config.ts","offset":1,"limit":230},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/config.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Config\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────\n6: // 1. CONFIG\n7: // ───────────────────────────────────────────────────────────────\n8: // Central configuration loader — reads JSONC config, resolves paths, exports CONFIG object\n9: import * as path from 'path';\n10: import * as fsSync from 'fs';\n11: import { stripJsoncComments } from '@spec-kit/shared/utils/jsonc-strip';\n12: import { structuredLog } from '../utils/logger.js';\n13: import { dirnameFromImportMeta } from '../lib/esm-entry.js';\n14: \n15: const moduleDir = dirnameFromImportMeta(import.meta.url);\n16: \n17: /* ───────────────────────────────────────────────────────────────\n18:    1. INTERFACES\n19: ------------------------------------------------------------------*/\n20: \n21: /** Represents workflow config. */\n22: export interface WorkflowConfig {\n23:   maxResultPreview: number;\n24:   maxConversationMessages: number;\n25:   maxToolOutputLines: number;\n26:   messageTimeWindow: number;\n27:   contextPreviewHeadLines: number;\n28:   contextPreviewTailLines: number;\n29:   timezoneOffsetHours: number;\n30:   maxFilesInMemory: number;\n31:   maxObservations: number;\n32:   minPromptLength: number;\n33:   maxContentPreview: number;\n34:   toolPreviewLines: number;\n35:   toolOutputMaxLength: number;\n36:   timestampMatchToleranceMs: number;\n37:   qualityAbortThreshold: number;\n38:   learningWeights: {\n39:     knowledge: number;\n40:     context: number;\n41:     uncertainty: number;\n42:   };\n43: }\n44: \n45: /** Represents spec kit config. */\n46: export interface SpecKitConfig {\n47:   SKILL_VERSION: string;\n48:   MESSAGE_COUNT_TRIGGER: number;\n49:   MAX_RESULT_PREVIEW: number;\n50:   MAX_CONVERSATION_MESSAGES: number;\n51:   MAX_TOOL_OUTPUT_LINES: number;\n52:   TRUNCATE_FIRST_LINES: number;\n53:   TRUNCATE_LAST_LINES: number;\n54:   MESSAGE_TIME_WINDOW: number;\n55:   TIMEZONE_OFFSET_HOURS: number;\n56:   TOOL_PREVIEW_LINES: number;\n57:   TEMPLATE_DIR: string;\n58:   PROJECT_ROOT: string;\n59:   DATA_FILE: string | null;\n60:   SPEC_FOLDER_ARG: string | null;\n61:   MAX_FILES_IN_MEMORY: number;\n62:   MAX_OBSERVATIONS: number;\n63:   MIN_PROMPT_LENGTH: number;\n64:   MAX_CONTENT_PREVIEW: number;\n65:   TOOL_OUTPUT_MAX_LENGTH: number;\n66:   TIMESTAMP_MATCH_TOLERANCE_MS: number;\n67:   QUALITY_ABORT_THRESHOLD: number;\n68:   LEARNING_WEIGHTS: WorkflowConfig['learningWeights'];\n69: }\n70: \n71: /* ───────────────────────────────────────────────────────────────\n72:    2. PATH CONSTANTS\n73: ------------------------------------------------------------------*/\n74: \n75: // Stable root detection — walk up from moduleDir looking for package.json.\n76: // Instead of relying on fragile relative moduleDir offset\n77: function findScriptsRoot(startDir: string): string {\n78:   let dir = startDir;\n79:   for (let i = 0; i < 10; i++) {\n80:     const candidate = path.resolve(dir, '..');\n81:     if (fsSync.existsSync(path.join(candidate, 'package.json'))) {\n82:       return candidate;\n83:     }\n84:     if (candidate === dir) break; // filesystem root\n85:     dir = candidate;\n86:   }\n87:   // Fallback to original moduleDir-relative resolution\n88:   return path.resolve(startDir, '..', '..');\n89: }\n90: \n91: const SCRIPTS_DIR: string = findScriptsRoot(moduleDir);\n92: \n93: /* ───────────────────────────────────────────────────────────────\n94:    3. CONFIG VALIDATION\n95: ------------------------------------------------------------------*/\n96: \n97: /**\n98:  * Validates merged config values and falls back to defaults for invalid entries.\n99:  * Never throws — logs warnings and returns a safe config.\n100:  */\n101: export function normalizeQualityAbortThreshold(\n102:   value: number,\n103:   defaultValue: number,\n104:   log: typeof structuredLog = structuredLog,\n105: ): number {\n106:   if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0 || value > 100) {\n107:     log('warn', 'qualityAbortThreshold invalid or out of range 0.0-1.0 (or legacy 1-100), using default', {\n108:       value,\n109:     });\n110:     return defaultValue;\n111:   }\n112: \n113:   if (value > 1) {\n114:     const normalized = value / 100;\n115:     log('warn', 'qualityAbortThreshold uses legacy 1-100 scale and was auto-converted to canonical 0.0-1.0', {\n116:       value,\n117:       normalized,\n118:     });\n119:     return normalized;\n120:   }\n121: \n122:   return value;\n123: }\n124: \n125: function validateConfig(merged: WorkflowConfig, defaults: WorkflowConfig): WorkflowConfig {\n126:   const validated = { ...merged };\n127: \n128:   // Positive integer fields (must be > 0)\n129:   const positiveFields: (keyof WorkflowConfig)[] = [\n130:     'maxResultPreview',\n131:     'maxConversationMessages',\n132:     'maxToolOutputLines',\n133:     'messageTimeWindow',\n134:     'maxFilesInMemory',\n135:     'maxObservations',\n136:     'minPromptLength',\n137:     'maxContentPreview',\n138:     'toolPreviewLines',\n139:     'toolOutputMaxLength',\n140:     'timestampMatchToleranceMs',\n141:   ];\n142: \n143:   for (const field of positiveFields) {\n144:     const value = validated[field];\n145:     if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0) {\n146:       structuredLog('warn',\n147:         `Config validation: \"${field}\" has invalid value (${JSON.stringify(value)}). ` +\n148:         `Must be a positive number. Falling back to default: ${defaults[field]}`\n149:       );\n150:       (validated as Record<string, unknown>)[field] = defaults[field];\n151:     }\n152:   }\n153: \n154:   validated.qualityAbortThreshold = normalizeQualityAbortThreshold(\n155:     validated.qualityAbortThreshold,\n156:     defaults.qualityAbortThreshold,\n157:   );\n158: \n159:   // Non-negative integer fields (must be >= 0)\n160:   const nonNegativeFields: (keyof WorkflowConfig)[] = [\n161:     'contextPreviewHeadLines',\n162:     'contextPreviewTailLines',\n163:   ];\n164: \n165:   for (const field of nonNegativeFields) {\n166:     const value = validated[field];\n167:     if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) {\n168:       structuredLog('warn',\n169:         `Config validation: \"${field}\" has invalid value (${JSON.stringify(value)}). ` +\n170:         `Must be a non-negative number. Falling back to default: ${defaults[field]}`\n171:       );\n172:       (validated as Record<string, unknown>)[field] = defaults[field];\n173:     }\n174:   }\n175: \n176:   // Timezone offset: valid range is -12 to +14\n177:   if (\n178:     typeof validated.timezoneOffsetHours !== 'number' ||\n179:     !Number.isFinite(validated.timezoneOffsetHours) ||\n180:     validated.timezoneOffsetHours < -12 ||\n181:     validated.timezoneOffsetHours > 14\n182:   ) {\n183:     structuredLog('warn',\n184:       `Config validation: \"timezoneOffsetHours\" has invalid value (${JSON.stringify(validated.timezoneOffsetHours)}). ` +\n185:       `Must be between -12 and 14. Falling back to default: ${defaults.timezoneOffsetHours}`\n186:     );\n187:     validated.timezoneOffsetHours = defaults.timezoneOffsetHours;\n188:   }\n189: \n190:   // Learning weights: object must exist and each weight must be between 0 and 1\n191:   if (\n192:     typeof validated.learningWeights !== 'object' ||\n193:     validated.learningWeights === null\n194:   ) {\n195:     structuredLog('warn',\n196:       `Config validation: \"learningWeights\" has invalid value (${JSON.stringify(validated.learningWeights)}). ` +\n197:       'Must be an object. Falling back to default learning weights.'\n198:     );\n199:     validated.learningWeights = { ...defaults.learningWeights };\n200:   }\n201: \n202:   const learningWeightFields: (keyof WorkflowConfig['learningWeights'])[] = [\n203:     'knowledge',\n204:     'context',\n205:     'uncertainty',\n206:   ];\n207: \n208:   for (const field of learningWeightFields) {\n209:     const value = validated.learningWeights[field];\n210:     if (typeof value !== 'number' || !Number.isFinite(value) || value < 0 || value > 1) {\n211:       structuredLog('warn',\n212:         `Config validation: \"learningWeights.${field}\" has invalid value (${JSON.stringify(value)}). ` +\n213:         `Must be a number between 0 and 1. Falling back to default: ${defaults.learningWeights[field]}`\n214:       );\n215:       validated.learningWeights[field] = defaults.learningWeights[field];\n216:     }\n217:   }\n218: \n219:   return validated;\n220: }\n221: \n222: /* ───────────────────────────────────────────────────────────────\n223:    4. CONFIG LOADER\n224: ------------------------------------------------------------------*/\n225: \n226: function loadConfig(): WorkflowConfig {\n227:   const defaultConfig: WorkflowConfig = {\n228:     maxResultPreview: 500,\n229:     maxConversationMessages: 100,\n230:     maxToolOutputLines: 100,\n\n(Showing lines 1-230 of 372. Use offset=231 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Config\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────\n// 1. CONFIG\n// ───────────────────────────────────────────────────────────────\n// Central configuration loader — reads JSONC config, resolves paths, exports CONFIG object\nimport * as path from 'path';\nimport * as fsSync from 'fs';\nimport { stripJsoncComments } from '@spec-kit/shared/utils/jsonc-strip';\nimport { structuredLog } from '../utils/logger.js';\nimport { dirnameFromImportMeta } from '../lib/esm-entry.js';\n\nconst moduleDir = dirnameFromImportMeta(import.meta.url);\n\n/* ───────────────────────────────────────────────────────────────\n   1. INTERFACES\n------------------------------------------------------------------*/\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/config.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Config\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────\n// 1. CONFIG\n// ───────────────────────────────────────────────────────────────\n// Central configuration loader — reads JSONC config, resolves paths, exports CONFIG object\nimport * as path from 'path';\nimport * as fsSync from 'fs';\nimport { stripJsoncComments } from '@spec-kit/shared/utils/jsonc-strip';\nimport { structuredLog } from '../utils/logger.js';\nimport { dirnameFromImportMeta } from '../lib/esm-entry.js';\n\nconst moduleDir = dirnameFromImportMeta(import.meta.url);\n\n/* ───────────────────────────────────────────────────────────────\n   1. INTERFACES\n------------------------------------------------------------------*/\n\n/** Represents workflow config. */\nexport interface WorkflowConfig {\n  maxResultPreview: number;\n  maxConversationMessages: number;\n  maxToolOutputLines: number;\n  messageTimeWindow: number;\n  contextPreviewHeadLines: number;\n  contextPreviewTailLines: number;\n  timezoneOffsetHours: number;\n  maxFilesInMemory: number;\n  maxObservations: number;\n  minPromptLength: number;\n  maxContentPreview: number;\n  toolPreviewLines: number;\n  toolOutputMaxLength: number;\n  timestampMatchToleranceMs: number;\n  qualityAbortThreshold: number;\n  learningWeights: {\n    knowledge: number;\n    context: number;\n    uncertainty: number;\n  };\n}\n\n/** Represents spec kit config. */\nexport interface SpecKitConfig {\n  SKILL_VERSION: string;\n  MESSAGE_COUNT_TRIGGER: number;\n  MAX_RESULT_PREVIEW: number;\n  MAX_CONVERSATION_MESSAGES: number;\n  MAX_TOOL_OUTPUT_LINES: number;\n  TRUNCATE_FIRST_LINES: number;\n  TRUNCATE_LAST_LINES: number;\n  MESSAGE_TIME_WINDOW: number;\n  TIMEZONE_OFFSET_HOURS: number;\n  TOOL_PREVIEW_LINES: number;\n  TEMPLATE_DIR: string;\n  PROJECT_ROOT: string;\n  DATA_FILE: string | null;\n  SPEC_FOLDER_ARG: string | null;\n  MAX_FILES_IN_MEMORY: number;\n  MAX_OBSERVATIONS: number;\n  MIN_PROMPT_LENGTH: number;\n  MAX_CONTENT_PREVIEW: number;\n  TOOL_OUTPUT_MAX_LENGTH: number;\n  TIMESTAMP_MATCH_TOLERANCE_MS: number;\n  QUALITY_ABORT_THRESHOLD: number;\n  LEARNING_WEIGHTS: WorkflowConfig['learningWeights'];\n}\n\n/* ───────────────────────────────────────────────────────────────\n   2. PATH CONSTANTS\n------------------------------------------------------------------*/\n\n// Stable root detection — walk up from moduleDir looking for package.json.\n// Instead of relying on fragile relative moduleDir offset\nfunction findScriptsRoot(startDir: string): string {\n  let dir = startDir;\n  for (let i = 0; i < 10; i++) {\n    const candidate = path.resolve(dir, '..');\n    if (fsSync.existsSync(path.join(candidate, 'package.json'))) {\n      return candidate;\n    }\n    if (candidate === dir) break; // filesystem root\n    dir = candidate;\n  }\n  // Fallback to original moduleDir-relative resolution\n  return path.resolve(startDir, '..', '..');\n}\n\nconst SCRIPTS_DIR: string = findScriptsRoot(moduleDir);\n\n/* ───────────────────────────────────────────────────────────────\n   3. CONFIG VALIDATION\n------------------------------------------------------------------*/\n\n/**\n * Validates merged config values and falls back to defaults for invalid entries.\n * Never throws — logs warnings and returns a safe config.\n */\nexport function normalizeQualityAbortThreshold(\n  value: number,\n  defaultValue: number,\n  log: typeof structuredLog = structuredLog,\n): number {\n  if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0 || value > 100) {\n    log('warn', 'qualityAbortThreshold invalid or out of range 0.0-1.0 (or legacy 1-100), using default', {\n      value,\n    });\n    return defaultValue;\n  }\n\n  if (value > 1) {\n    const normalized = value / 100;\n    log('warn', 'qualityAbortThreshold uses legacy 1-100 scale and was auto-converted to canonical 0.0-1.0', {\n      value,\n      normalized,\n    });\n    return normalized;\n  }\n\n  return value;\n}\n\nfunction validateConfig(merged: WorkflowConfig, defaults: WorkflowConfig): WorkflowConfig {\n  const validated = { ...merged };\n\n  // Positive integer fields (must be > 0)\n  const positiveFields: (keyof WorkflowConfig)[] = [\n    'maxResultPreview',\n    'maxConversationMessages',\n    'maxToolOutputLines',\n    'messageTimeWindow',\n    'maxFilesInMemory',\n    'maxObservations',\n    'minPromptLength',\n    'maxContentPreview',\n    'toolPreviewLines',\n    'toolOutputMaxLength',\n    'timestampMatchToleranceMs',\n  ];\n\n  for (const field of positiveFields) {\n    const value = validated[field];\n    if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0) {\n      structuredLog('warn',\n        `Config validation: \"${field}\" has invalid value (${JSON.stringify(value)}). ` +\n        `Must be a positive number. Falling back to default: ${defaults[field]}`\n      );\n      (validated as Record<string, unknown>)[field] = defaults[field];\n    }\n  }\n\n  validated.qualityAbortThreshold = normalizeQualityAbortThreshold(\n    validated.qualityAbortThreshold,\n    defaults.qualityAbortThreshold,\n  );\n\n  // Non-negative integer fields (must be >= 0)\n  const nonNegativeFields: (keyof WorkflowConfig)[] = [\n    'contextPreviewHeadLines',\n    'contextPreviewTailLines',\n  ];\n\n  for (const field of nonNegativeFields) {\n    const value = validated[field];\n    if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) {\n      structuredLog('warn',\n        `Config validation: \"${field}\" has invalid value (${JSON.stringify(value)}). ` +\n        `Must be a non-negative number. Falling back to default: ${defaults[field]}`\n      );\n      (validated as Record<string, unknown>)[field] = defaults[field];\n    }\n  }\n\n  // Timezone offset: valid range is -12 to +14\n  if (\n    typeof validated.timezoneOffsetHours !== 'number' ||\n    !Number.isFinite(validated.timezoneOffsetHours) ||\n    validated.timezoneOffsetHours < -12 ||\n    validated.timezoneOffsetHours > 14\n  ) {\n    structuredLog('warn',\n      `Config validation: \"timezoneOffsetHours\" has invalid value (${JSON.stringify(validated.timezoneOffsetHours)}). ` +\n      `Must be between -12 and 14. Falling back to default: ${defaults.timezoneOffsetHours}`\n    );\n    validated.timezoneOffsetHours = defaults.timezoneOffsetHours;\n  }\n\n  // Learning weights: object must exist and each weight must be between 0 and 1\n  if (\n    typeof validated.learningWeights !== 'object' ||\n    validated.learningWeights === null\n  ) {\n    structuredLog('warn',\n      `Config validation: \"learningWeights\" has invalid value (${JSON.stringify(validated.learningWeights)}). ` +\n      'Must be an object. Falling back to default learning weights.'\n    );\n    validated.learningWeights = { ...defaults.learningWeights };\n  }\n\n  const learningWeightFields: (keyof WorkflowConfig['learningWeights'])[] = [\n    'knowledge',\n    'context',\n    'uncertainty',\n  ];\n\n  for (const field of learningWeightFields) {\n    const value = validated.learningWeights[field];\n    if (typeof value !== 'number' || !Number.isFinite(value) || value < 0 || value > 1) {\n      structuredLog('warn',\n        `Config validation: \"learningWeights.${field}\" has invalid value (${JSON.stringify(value)}). ` +\n        `Must be a number between 0 and 1. Falling back to default: ${defaults.learningWeights[field]}`\n      );\n      validated.learningWeights[field] = defaults.learningWeights[field];\n    }\n  }\n\n  return validated;\n}\n\n/* ───────────────────────────────────────────────────────────────\n   4. CONFIG LOADER\n------------------------------------------------------------------*/\n\nfunction loadConfig(): WorkflowConfig {\n  const defaultConfig: WorkflowConfig = {\n    maxResultPreview: 500,\n    maxConversationMessages: 100,\n    maxToolOutputLines: 100,","lineStart":1,"lineEnd":230,"totalLines":372,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/core/config.ts","time":{"start":1788620374864,"end":1788620374893}},"id":"prt_07215034e001Ivq3Wn2c2OzPv8","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072143d79001sAz3VjyFeElJfq"}}
