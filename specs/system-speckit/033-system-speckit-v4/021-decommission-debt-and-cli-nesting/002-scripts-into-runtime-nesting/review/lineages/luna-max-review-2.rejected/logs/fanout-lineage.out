{"type":"tool_use","timestamp":1788620184998,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_aBaska5YsAYjr5U0CEhfIBaG","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/deep/assets/deep-review-auto.yaml","offset":491,"limit":1050},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/deep/assets/deep-review-auto.yaml</path>\n<type>file</type>\n<content>\n491:       step_create_strategy:\n492:         action: \"Create review strategy file from deep-review-strategy.md template\"\n493:         template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n494:         populate:\n495:           review_target: \"{review_target}\"\n496:           review_target_type: \"{review_target_type}\"\n497:           dimensions: \"{dimension_queue}\"\n498:           scope_files: \"{review_scope_files}\"\n499:           cross_reference_targets: \"{cross_reference_targets}\"\n500:           max_iterations: \"{max_iterations}\"\n501:           convergence_threshold: \"{convergence_threshold}\"\n502:           stop_policy: \"{stop_policy}\"\n503:         output: \"{state_paths.strategy}\"\n504: \n505:       step_seed_coverage_graph:\n506:         action: \"Seed the review coverage graph before the first convergence check\"\n507:         transform: |\n508:           1. Convert review_scope_files into FILE nodes.\n509:           2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n510:              or DEPENDENCY nodes in review mode.\n511:           3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n512:           4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n513:           5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n514:              returns a warning and review continues with an empty graph.\n515:         bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n516:         outputs:\n517:           - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n518:           - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n519:           - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n520:         on_warning:\n521:           log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n522:           proceed: true\n523: \n524:       step_enrich_strategy_context:\n525:         action: \"Ensure Known Context is written only after strategy.md exists\"\n526:         condition: \"prior_context_found\"\n527:         edit: \"{state_paths.strategy}\"\n528:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n529: \n530:       step_enrich_strategy_resource_map:\n531:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n532:         edit: \"{state_paths.strategy}\"\n533:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n534: \n535:       step_init_complete:\n536:         log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n537:         set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }\n538: \n539:   # ═══════════════════════════════════════════════════════════════\n540:   # PHASE 2: ITERATION LOOP\n541:   # ═══════════════════════════════════════════════════════════════\n542:   phase_loop:\n543:     purpose: Dispatch review agent iterations until convergence\n544:     repeat: true\n545:     max_repeats: \"{max_iterations}\"\n546:     steps:\n547: \n548:       step_read_state:\n549:         action: \"Read current state from JSONL, strategy, and config\"\n550:         read:\n551:           - \"{state_paths.state_log}\"\n552:           - \"{state_paths.findings_registry}\"\n553:           - \"{state_paths.strategy}\"\n554:           - \"{state_paths.config}\"\n555:         extract:\n556:           - iteration_count: \"Count lines where type === 'iteration'\"\n557:           - current_iteration: \"iteration_count + 1\"\n558:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n559:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n560:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n561:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n562:           - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n563:           - dimensions_covered: \"List of dimensions already reviewed\"\n564:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n565:           - dimension_coverage: \"covered / total dimensions\"\n566:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n567:           - p0_count: \"Count P0 findings across all iterations\"\n568:           - p1_count: \"Count P1 findings across all iterations\"\n569:           - p2_count: \"Count P2 findings across all iterations\"\n570:           - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n571:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n572:           - session_id: \"Extract sessionId from deep-review-config.json\"\n573:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n574:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n575:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n576:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n577:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n578:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n579:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n580:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n581:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n582:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n583:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n584:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n585:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n586: \n587:       step_check_pause_sentinel:\n588:         action: \"Check for pause sentinel file\"\n589:         check: \"Does {state_paths.pause_sentinel} exist?\"\n590:         if_exists:\n591:           set:\n592:             pending_stop_event: \"paused\"\n593:             pending_stop_reason: \"userPaused\"\n594:             pending_stop_detail: \"sentinel file detected\"\n595:           skip_to: step_normalize_pause_events\n596:         if_not_exists:\n597:           proceed: true\n598: \n599:       step_validate_convergence_config:\n600:         action: \"Validate convergence mode when loading config\"\n601:         if_convergence_mode_invalid:\n602:           append_jsonl: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n603:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n604: \n605:       step_graph_convergence:\n606:         action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n607:         inspect:\n608:           - \"{state_paths.state_log}\"\n609:           - \"{state_paths.findings_registry}\"\n610:         transform: |\n611:           1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n612:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n613:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n614:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n615:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n616:         bash: 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n617:         note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n618:         append_jsonl: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"review\",\"run\":{current_iteration},\"decision\":\"{graph_decision}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n619:         outputs:\n620:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n621:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n622:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n623:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n624:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n625: \n626:       step_check_convergence:\n627:         action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n628:         algorithm: |\n629:           0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n630:              claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n631:              If claim_adjudication_gate_pass == false:\n632:                candidate_decision = \"BLOCKED\"\n633:                stop_blocked = true\n634:                stopReason = \"blockedStop\"\n635:                blocked_gates = [\"claimAdjudicationGate\"]\n636:                recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n637:                Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n638:           1. HARD STOPS:\n639:              a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n640:              b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n641:              c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n642:              Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n643:           2. STUCK DETECTION (threshold 2):\n644:              if stuck_count >= 2: STUCK_RECOVERY\n645:           3. GRAPH CONVERGENCE PREREQUISITE:\n646:                graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n647:                Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n648:                If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n649:           4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n650:                signals = []\n651:                a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n652:                   avg = mean(last 2 newFindingsRatios)\n653:                   stop if avg <= 0.08\n654:                b) MAD noise floor (w=0.25, needs 3+ iterations):\n655:                   noiseFloor = MAD(all ratios) * 1.4826\n656:                   stop if latest ratio <= noiseFloor\n657:                c) Dimension coverage (w=0.45):\n658:                   coverage = dimensions_covered / total_dimensions\n659:                   stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n660:                Redistribute weights for unavailable signals.\n661:                if latest ratio <= 0.05: mark no_progress_threshold_reached\n662:                if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n663:                else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n664:           5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):\n665:                a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score\n666:                b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions\n667:                c) p0ResolutionGate: pass when activeP0 == 0; record activeP0\n668:                d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding\n669:                e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic\n670:                f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count\n671:                g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows\n672:                h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: \"skip\"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = \"candidateCoverageGate\"; recovery_strategy = \"Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence.\"\n673:                i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {\"direct_read\",\"exact_grep\",\"semantic_search\",\"producer_consumer_trace\",\"negative_test_inspection\"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = \"graphlessFallbackGate\"; recovery_strategy = \"Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available.\"\n674:              if STOP is a candidate and any gate fails:\n675:                decision = \"BLOCKED\"\n676:                stop_blocked = true\n677:                stopReason = \"blockedStop\"\n678:                blocked_by_json = JSON array of failing gate names (always include \"claimAdjudicationGate\" when claim_adjudication_gate_pass == false, \"fixCompletenessReplayGate\" when fix_completeness_replay_gate_pass == false, \"candidateCoverageGate\" when candidate_coverage_gate_pass == false, and \"graphlessFallbackGate\" when graphless_fallback_gate_pass == false)\n679:                blocked_by_csv = comma-separated list of failing gate names\n680:                convergence_gate_pass = boolean\n681:                convergence_gate_score = numeric convergence score\n682:                dimension_coverage_gate_pass = boolean\n683:                dimension_coverage_gate_covered_json = JSON array of covered review dimensions\n684:                dimension_coverage_gate_missing_json = JSON array of missing review dimensions\n685:                p0_resolution_gate_pass = boolean\n686:                active_p0_count = number of active P0 findings\n687:                evidence_density_gate_pass = boolean\n688:                avg_evidence_per_finding = numeric evidence density\n689:                hotspot_saturation_gate_pass = boolean\n690:                claim_adjudication_gate_pass = boolean\n691:                claim_adjudication_active_count = numeric count of active P0/P1 at the gate\n692:                fix_completeness_replay_gate_pass = boolean\n693:                security_sensitive_fix_scope = boolean\n694:                fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns\n695:                fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence\n696:                candidate_coverage_gate_pass = boolean\n697:                candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n698:                candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n699:                graphless_fallback_gate_pass = boolean\n700:                graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n701:                graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n702:                graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n703:                recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n704:           6. COMBINED STOP RULE:\n705:                a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n706:                b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n707:                     decision = \"BLOCKED\"\n708:                     stop_blocked = true\n709:                     stopReason = \"blockedStop\"\n710:                     # Blocked-stop closure: blockedBy must be string[] per the\n711:                     # published review blocked-stop contract. Extract the `.type`\n712:                     # field from each structured graph blocker; preserve the full\n713:                     # objects in graph_blocker_detail_json for operator inspection.\n714:                     blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n715:                     blocked_by_csv = graph_blockers_csv\n716:                     graph_blocker_detail_json = graph_blockers_json\n717:                     recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n718:                c) if STOP is legal AND graph_decision == \"CONTINUE\":\n719:                     decision = \"CONTINUE\"\n720:                     stop_blocked = false\n721:                     reason = \"graph_convergence_continue\"\n722:                d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n723:         outputs:\n724:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n725:           - reason: \"Human-readable stop reason\"\n726:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n727:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n728:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n729:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n730:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n731:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n732:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n733:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n734:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n735:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n736:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n737:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n738:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n739:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n740:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n741:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n742:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n743:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n744:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n745:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n746:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n747:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n748:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n749:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n750:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n751:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n752:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n753:           - graph_signals_json: \"JSON object returned by graph convergence\"\n754:           - graph_blockers_json: \"JSON array of graph blockers\"\n755:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n756:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n757: \n758:       step_emit_blocked_stop:\n759:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n760:         if_blocked:\n761:           append_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"review\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergenceGate\":{\"pass\":{convergence_gate_pass},\"score\":{convergence_gate_score}},\"dimensionCoverageGate\":{\"pass\":{dimension_coverage_gate_pass},\"covered\":{dimension_coverage_gate_covered_json},\"missing\":{dimension_coverage_gate_missing_json}},\"p0ResolutionGate\":{\"pass\":{p0_resolution_gate_pass},\"activeP0\":{active_p0_count}},\"evidenceDensityGate\":{\"pass\":{evidence_density_gate_pass},\"avgEvidencePerFinding\":{avg_evidence_per_finding}},\"hotspotSaturationGate\":{\"pass\":{hotspot_saturation_gate_pass}},\"claimAdjudicationGate\":{\"pass\":{claim_adjudication_gate_pass},\"activeP0P1\":{claim_adjudication_active_count}},\"fixCompletenessReplayGate\":{\"pass\":{fix_completeness_replay_gate_pass},\"securitySensitive\":{security_sensitive_fix_scope},\"requiredRows\":{fix_completeness_replay_required_rows},\"passingRows\":{fix_completeness_replay_passing_rows}},\"candidateCoverageGate\":{\"pass\":{candidate_coverage_gate_pass},\"searchDebt\":{candidate_coverage_search_debt_json},\"missing\":{candidate_coverage_missing_json}},\"graphlessFallbackGate\":{\"pass\":{graphless_fallback_gate_pass},\"mode\":\"{graphless_fallback_mode}\",\"missing\":{graphless_fallback_missing_json},\"unavailabilityReason\":\"{graphless_fallback_unavailability_reason}\"}},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n762:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n763:         if_not_blocked:\n764:           proceed: true\n765: \n766:       step_handle_convergence:\n767:         action: \"Act on convergence decision\"\n768:         if_stop:\n769:           branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n770:           if_divergent_eligible:\n771:             eligibility_contract:\n772:               required_decision: \"STOP\"\n773:               eligible_reasons: [all_dimensions_clean]\n774:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n775:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n776:             steps:\n777:               step_prepare_divergent_pivot:\n778:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n779:                 command: |\n780:                   node --experimental-strip-types --input-type=module <<'EOF'\n781:                   import {\n782:                     buildReviewPivotPreparationInput,\n783:                     renderReviewPivotSeatPrompt,\n784:                   } from './.opencode/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n785:                   import {\n786:                     preparePivotTransaction,\n787:                   } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n788: \n789:                   const input = buildReviewPivotPreparationInput({\n790:                     artifactRoot: '{state_paths.packet_dir}',\n791:                     configPath: '{state_paths.config}',\n792:                     stateLogPath: '{state_paths.state_log}',\n793:                     strategyPath: '{state_paths.strategy}',\n794:                     registryPath: '{state_paths.findings_registry}',\n795:                     currentIteration: Number('{current_iteration}'),\n796:                     maxIterations: Number('{max_iterations}'),\n797:                     triggerReason: '{reason}',\n798:                   });\n799:                   const prepared = await preparePivotTransaction(input);\n800:                   const seatPrompts = prepared.status === 'pending'\n801:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n802:                         seat.id,\n803:                         renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n804:                       ]))\n805:                     : {};\n806:                   process.stdout.write(`${JSON.stringify({\n807:                     ...prepared,\n808:                     seatPrompts,\n809:                     boundaryRejections: input.boundaryRejections,\n810:                   })}\\n`);\n811:                   EOF\n812:                 working_directory: \"{repo_root}\"\n813:                 outputs:\n814:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n815:                   - pivot_prepare_status: \"status from the prepare result\"\n816:                   - pivot_id: \"pivotId from the prepare result\"\n817:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n818:                   - pivot_resumed: \"resumed from the prepare result\"\n819:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n820:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n821:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n822:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n823:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n824:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n825:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n826:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n827:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n828: \n829:               step_dispatch_pivot_seat_001:\n830:                 action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n831:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n832:                 capture_timing: true\n833:                 if_native:\n834:                   dispatch:\n835:                     agent: deep-review\n836:                     model: opus\n837:                     context_source: \"pivot_seat_001_prompt\"\n838:                   wait_for_completion: true\n839:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n840:                 outputs:\n841:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n842:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n843:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n844:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n845:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n846:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n847: \n848:               step_record_pivot_seat_001:\n849:                 action: \"Durably record the seat-001 native dispatch outcome\"\n850:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n851:                 command: |\n852:                   node --experimental-strip-types --input-type=module <<'EOF'\n853:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n854:                   const status = '{pivot_seat_001_dispatch_status}';\n855:                   const outcome = status === 'fulfilled'\n856:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n857:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n858:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n859:                   EOF\n860:                 working_directory: \"{repo_root}\"\n861: \n862:               step_dispatch_pivot_seat_002:\n863:                 action: \"Natively dispatch the critical read-only review direction-selection seat\"\n864:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n865:                 capture_timing: true\n866:                 if_native:\n867:                   dispatch:\n868:                     agent: deep-review\n869:                     model: opus\n870:                     context_source: \"pivot_seat_002_prompt\"\n871:                   wait_for_completion: true\n872:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n873:                 outputs:\n874:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n875:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n876:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n877:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n878:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n879:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n880: \n881:               step_record_pivot_seat_002:\n882:                 action: \"Durably record the seat-002 native dispatch outcome\"\n883:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n884:                 command: |\n885:                   node --experimental-strip-types --input-type=module <<'EOF'\n886:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n887:                   const status = '{pivot_seat_002_dispatch_status}';\n888:                   const outcome = status === 'fulfilled'\n889:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n890:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n891:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n892:                   EOF\n893:                 working_directory: \"{repo_root}\"\n894: \n895:               step_dispatch_pivot_seat_003:\n896:                 action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n897:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n898:                 capture_timing: true\n899:                 if_native:\n900:                   dispatch:\n901:                     agent: deep-review\n902:                     model: opus\n903:                     context_source: \"pivot_seat_003_prompt\"\n904:                   wait_for_completion: true\n905:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n906:                 outputs:\n907:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n908:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n909:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n910:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n911:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n912:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n913: \n914:               step_record_pivot_seat_003:\n915:                 action: \"Durably record the seat-003 native dispatch outcome\"\n916:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n917:                 command: |\n918:                   node --experimental-strip-types --input-type=module <<'EOF'\n919:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n920:                   const status = '{pivot_seat_003_dispatch_status}';\n921:                   const outcome = status === 'fulfilled'\n922:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n923:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n924:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n925:                   EOF\n926:                 working_directory: \"{repo_root}\"\n927: \n928:               step_finalize_divergent_pivot:\n929:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n930:                 skip_when: \"pivot_prepare_status != 'pending'\"\n931:                 command: |\n932:                   node --experimental-strip-types --input-type=module <<'EOF'\n933:                   import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n934:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n935:                   EOF\n936:                 working_directory: \"{repo_root}\"\n937:                 outputs:\n938:                   - pivot_finalize_json: \"The complete parsed final result\"\n939: \n940:               step_resolve_divergent_pivot_result:\n941:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n942:                 branch_on: \"pivot_prepare_status\"\n943:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n944:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n945: \n946:               step_apply_divergent_pivot_result:\n947:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n948:                 branch_on: \"pivot_result.status\"\n949:                 if_completed:\n950:                   set:\n951:                     next_dimension: \"{pivot_result.restoredFocus}\"\n952:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n953:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n954:                   command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n955:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n956:                   proceed_to: step_normalize_pause_events\n957:                 if_failed:\n958:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n959:                   skip_to: phase_synthesis\n960:             on_error:\n961:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n962:               skip_to: phase_synthesis\n963:           if_existing_terminal_path:\n964:             log: \"Loop stopping. Reason: {reason}\"\n965:             skip_to: phase_synthesis\n966:         if_blocked:\n967:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n968:         if_stuck_recovery:\n969:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n970:           recovery_strategies:\n971:             - \"Change granularity: file-level → function-level → line-level review\"\n972:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n973:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n974:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n975:           set:\n976:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n977:             pending_stop_event: \"stuck_recovery\"\n978:             pending_stop_reason: \"stuckRecovery\"\n979:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n980:           reset: { stuck_count: 0 }\n981:         if_continue:\n982:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n983: \n984:       step_normalize_pause_events:\n985:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n986:         if_pending_pause_event:\n987:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"review\",\"stopReason\":\"userPaused\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n988:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n989:           reset:\n990:             pending_stop_event: null\n991:             pending_stop_reason: null\n992:             pending_stop_detail: null\n993:           halt: true\n994:         if_pending_stuck_recovery:\n995:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"review\",\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"strategy\":\"{recovery_strategy}\",\"targetDimension\":\"{least_explored}\",\"outcome\":\"pending\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n996:           reset:\n997:             pending_stop_event: null\n998:             pending_stop_reason: null\n999:             pending_stop_detail: null\n1000:         if_no_pending_event:\n1001:           proceed: true\n1002: \n1003:       step_generate_state_summary:\n1004:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1005:         generate: |\n1006:           STATE SUMMARY (auto-generated):\n1007:           Iteration: {current_iteration} of {max_iterations}\n1008:           Dimension: {next_dimension}\n1009:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1010:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1011:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1012:           {resource_map_prompt_line}\n1013:           Coverage Age: {coverage_age}\n1014:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1015:           Stuck count: {stuck_count}\n1016:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1017: \n1018:       step_marker_scan:\n1019:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1020:         algorithm: |\n1021:           if current_iteration > 1:\n1022:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1023:             if file_exists(PREV_PROMPT_PATH):\n1024:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1025:               if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n1026:                 log \"ERROR: nested review-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n1027:                 halt with exit code 2\n1028:         note: |\n1029:           False-positive prevention: only matches when the first line is exactly one of the\n1030:           three canonical markers. Markers appearing in comments or body text are ignored.\n1031:           True-positive triggers only when a previous iteration's rendered prompt literally\n1032:           starts with a deep-loop marker, indicating a nested review-of-review dispatch.\n1033: \n1034:       step_dispatch_iteration:\n1035:         action: \"Dispatch @deep-review agent for one review iteration\"\n1036:         resolve_executor:\n1037:           source: \"config.executor\"\n1038:           loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1039:         pre_dispatch:\n1040:           generate_summary: |\n1041:             STATE SUMMARY (auto-generated):\n1042:             Iteration: {current_iteration} of {max_iterations}\n1043:             Dimension: {next_dimension}\n1044:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1045:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1046:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1047:             {resource_map_prompt_line}\n1048:             Coverage Age: {coverage_age}\n1049:             Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1050:             Stuck count: {stuck_count}\n1051:             Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1052:           render_prompt_pack:\n1053:             template_path: \".opencode/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n1054:             renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1055:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1056:             variables:\n1057:               state_summary: \"{state_summary}\"\n1058:               current_iteration: \"{current_iteration}\"\n1059:               max_iterations: \"{max_iterations}\"\n1060:               next_dimension: \"{next_dimension}\"\n1061:               review_target: \"{review_target}\"\n1062:               review_scope_files: \"{review_scope_files}\"\n1063:               p0_count: \"{p0_count}\"\n1064:               p1_count: \"{p1_count}\"\n1065:               p2_count: \"{p2_count}\"\n1066:               pivot_lineage: \"{pivot_lineage}\"\n1067:               saturated_directions: \"{saturated_directions}\"\n1068:               state_paths_config: \"{state_paths.config}\"\n1069:               state_paths_state_log: \"{state_paths.state_log}\"\n1070:               state_paths_findings_registry: \"{state_paths.findings_registry}\"\n1071:               state_paths_strategy: \"{state_paths.strategy}\"\n1072:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1073:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1074:         pre_dispatch_audit:\n1075:           skip_when: \"config.executor.kind == 'native'\"\n1076:           call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1077:           args:\n1078:             stateLogPath: \"{state_paths.state_log}\"\n1079:             executor: \"{config.executor}\"\n1080:             iteration: \"{current_iteration}\"\n1081:         branch_on: \"config.executor.kind\"\n1082:         if_native:\n1083:           dispatch:\n1084:             agent: deep-review\n1085:             model: opus\n1086:             context_source: \"rendered_prompt_pack\"\n1087:           wait_for_completion: true\n1088:         if_cli_copilot:\n1089:           command: |\n1090:             node --experimental-strip-types --input-type=module <<'EOF'\n1091:             import { readFileSync, writeFileSync } from 'node:fs';\n1092:             import { createHash } from 'node:crypto';\n1093: \n1094:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1095:             import { buildCopilotPromptArg } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1096: \n1097:             const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';\n1098:             const prompt = readFileSync(promptPath, 'utf8');\n1099: \n1100:             // Workflow-resolved spec folder is the only legal write authority.\n1101:             // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)\n1102:             // is the single source of truth for rejecting empty / unresolved\n1103:             // template / whitespace-only / string-coerced empty values. The\n1104:             // YAML hands the raw `{spec_folder}` directly; on rejection the\n1105:             // helper safe-fails to `type:\"missing\", writeIntent:true` (Gate-3\n1106:             // enforcement, --allow-all-tools stripped).\n1107:             const specFolderRaw = '{spec_folder}';\n1108:             const targetAuthority = { type: 'approved', specFolder: specFolderRaw };\n1109: \n1110:             const baseArgs = [\n1111:               '-p',\n1112:               prompt,\n1113:               '--model',\n1114:               '{config.executor.model}',\n1115:               '--allow-all-tools',\n1116:               '--no-ask-user',\n1117:             ];\n1118: \n1119:             const built = buildCopilotPromptArg({\n1120:               promptPath,\n1121:               prompt,\n1122:               targetAuthority,\n1123:               baseArgv: baseArgs,\n1124:             });\n1125: \n1126:             // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`\n1127:             // containing `<TARGET AUTHORITY preamble>\\n\\n---\\n\\n<original>`.\n1128:             // Write it to disk so the file Copilot reads via @path opens with\n1129:             // the authority block. Without this, recovered/bootstrap folder\n1130:             // mentions inside the file could still anchor the model.\n1131:             if (built.promptFileBody !== undefined) {\n1132:               writeFileSync(promptPath, built.promptFileBody, 'utf8');\n1133:             }\n1134: \n1135:             // Copilot is routed through the audited executor wrapper so it produces\n1136:             // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode\n1137:             // There is no cli-copilot kind in the executor schema, so it\n1138:             // dispatches as kind:'native' (full env passthrough, no recursion-guard\n1139:             // layer configured for copilot); the receipt still records the real\n1140:             // 'copilot' command + built.argv as facts.\n1141:             const dispatchFacts = {\n1142:               command: 'deep/review',\n1143:               mode: 'review',\n1144:               specFolder: '{spec_folder}',\n1145:               artifactDir: '{state_paths.packet_dir}',\n1146:               iteration: Number('{current_iteration}'),\n1147:               executorKind: '{config.executor.kind}',\n1148:               branchId: '{config.executor.kind}',\n1149:               sessionId: '{session_id}',\n\n(Output capped at 50 KB. Showing lines 491-1149. Use offset=1150 to continue.)\n</content>","metadata":{"preview":"      step_create_strategy:\n        action: \"Create review strategy file from deep-review-strategy.md template\"\n        template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n        populate:\n          review_target: \"{review_target}\"\n          review_target_type: \"{review_target_type}\"\n          dimensions: \"{dimension_queue}\"\n          scope_files: \"{review_scope_files}\"\n          cross_reference_targets: \"{cross_reference_targets}\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n          stop_policy: \"{stop_policy}\"\n        output: \"{state_paths.strategy}\"\n\n      step_seed_coverage_graph:\n        action: \"Seed the review coverage graph before the first convergence check\"\n        transform: |\n          1. Convert review_scope_files into FILE nodes.\n          2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n             or DEPENDENCY nodes in review mode.","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/deep/assets/deep-review-auto.yaml","text":"      step_create_strategy:\n        action: \"Create review strategy file from deep-review-strategy.md template\"\n        template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n        populate:\n          review_target: \"{review_target}\"\n          review_target_type: \"{review_target_type}\"\n          dimensions: \"{dimension_queue}\"\n          scope_files: \"{review_scope_files}\"\n          cross_reference_targets: \"{cross_reference_targets}\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n          stop_policy: \"{stop_policy}\"\n        output: \"{state_paths.strategy}\"\n\n      step_seed_coverage_graph:\n        action: \"Seed the review coverage graph before the first convergence check\"\n        transform: |\n          1. Convert review_scope_files into FILE nodes.\n          2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n             or DEPENDENCY nodes in review mode.\n          3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n          4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n          5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n             returns a warning and review continues with an empty graph.\n        bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n        outputs:\n          - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n          - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n          - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n        on_warning:\n          log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n          proceed: true\n\n      step_enrich_strategy_context:\n        action: \"Ensure Known Context is written only after strategy.md exists\"\n        condition: \"prior_context_found\"\n        edit: \"{state_paths.strategy}\"\n        note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n\n      step_enrich_strategy_resource_map:\n        action: \"Inject resource-map status into Known Context after strategy.md exists\"\n        edit: \"{state_paths.strategy}\"\n        note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_init_complete:\n        log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n        set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 2: ITERATION LOOP\n  # ═══════════════════════════════════════════════════════════════\n  phase_loop:\n    purpose: Dispatch review agent iterations until convergence\n    repeat: true\n    max_repeats: \"{max_iterations}\"\n    steps:\n\n      step_read_state:\n        action: \"Read current state from JSONL, strategy, and config\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.config}\"\n        extract:\n          - iteration_count: \"Count lines where type === 'iteration'\"\n          - current_iteration: \"iteration_count + 1\"\n          - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n          - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n          - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n          - dimensions_covered: \"List of dimensions already reviewed\"\n          - dimensions_remaining: \"List of dimensions not yet reviewed\"\n          - dimension_coverage: \"covered / total dimensions\"\n          - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n          - p0_count: \"Count P0 findings across all iterations\"\n          - p1_count: \"Count P1 findings across all iterations\"\n          - p2_count: \"Count P2 findings across all iterations\"\n          - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n          - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n          - session_id: \"Extract sessionId from deep-review-config.json\"\n          - generation: \"Extract generation from deep-review-config.json, else 1\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n          - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n          - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n          - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n          - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n          - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n          - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n          - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n\n      step_check_pause_sentinel:\n        action: \"Check for pause sentinel file\"\n        check: \"Does {state_paths.pause_sentinel} exist?\"\n        if_exists:\n          set:\n            pending_stop_event: \"paused\"\n            pending_stop_reason: \"userPaused\"\n            pending_stop_detail: \"sentinel file detected\"\n          skip_to: step_normalize_pause_events\n        if_not_exists:\n          proceed: true\n\n      step_validate_convergence_config:\n        action: \"Validate convergence mode when loading config\"\n        if_convergence_mode_invalid:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          log: \"Unsupported convergenceMode; using default convergence behavior.\"\n\n      step_graph_convergence:\n        action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n        inspect:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n        transform: |\n          1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n          2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n          3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n          4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n          5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n        bash: 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n        note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n        append_jsonl: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"review\",\"run\":{current_iteration},\"decision\":\"{graph_decision}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n        outputs:\n          - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n          - graph_signals_json: \"JSON object returned by convergence.cjs\"\n          - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n          - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n          - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n\n      step_check_convergence:\n        action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n        algorithm: |\n          0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n             claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n             If claim_adjudication_gate_pass == false:\n               candidate_decision = \"BLOCKED\"\n               stop_blocked = true\n               stopReason = \"blockedStop\"\n               blocked_gates = [\"claimAdjudicationGate\"]\n               recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n               Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n          1. HARD STOPS:\n             a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n             b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n             c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n             Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n          2. STUCK DETECTION (threshold 2):\n             if stuck_count >= 2: STUCK_RECOVERY\n          3. GRAPH CONVERGENCE PREREQUISITE:\n               graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n               Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n               If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n          4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n               signals = []\n               a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n                  avg = mean(last 2 newFindingsRatios)\n                  stop if avg <= 0.08\n               b) MAD noise floor (w=0.25, needs 3+ iterations):\n                  noiseFloor = MAD(all ratios) * 1.4826\n                  stop if latest ratio <= noiseFloor\n               c) Dimension coverage (w=0.45):\n                  coverage = dimensions_covered / total_dimensions\n                  stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n               Redistribute weights for unavailable signals.\n               if latest ratio <= 0.05: mark no_progress_threshold_reached\n               if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n               else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n          5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):\n               a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score\n               b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions\n               c) p0ResolutionGate: pass when activeP0 == 0; record activeP0\n               d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding\n               e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic\n               f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count\n               g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows\n               h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: \"skip\"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = \"candidateCoverageGate\"; recovery_strategy = \"Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence.\"\n               i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {\"direct_read\",\"exact_grep\",\"semantic_search\",\"producer_consumer_trace\",\"negative_test_inspection\"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = \"graphlessFallbackGate\"; recovery_strategy = \"Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available.\"\n             if STOP is a candidate and any gate fails:\n               decision = \"BLOCKED\"\n               stop_blocked = true\n               stopReason = \"blockedStop\"\n               blocked_by_json = JSON array of failing gate names (always include \"claimAdjudicationGate\" when claim_adjudication_gate_pass == false, \"fixCompletenessReplayGate\" when fix_completeness_replay_gate_pass == false, \"candidateCoverageGate\" when candidate_coverage_gate_pass == false, and \"graphlessFallbackGate\" when graphless_fallback_gate_pass == false)\n               blocked_by_csv = comma-separated list of failing gate names\n               convergence_gate_pass = boolean\n               convergence_gate_score = numeric convergence score\n               dimension_coverage_gate_pass = boolean\n               dimension_coverage_gate_covered_json = JSON array of covered review dimensions\n               dimension_coverage_gate_missing_json = JSON array of missing review dimensions\n               p0_resolution_gate_pass = boolean\n               active_p0_count = number of active P0 findings\n               evidence_density_gate_pass = boolean\n               avg_evidence_per_finding = numeric evidence density\n               hotspot_saturation_gate_pass = boolean\n               claim_adjudication_gate_pass = boolean\n               claim_adjudication_active_count = numeric count of active P0/P1 at the gate\n               fix_completeness_replay_gate_pass = boolean\n               security_sensitive_fix_scope = boolean\n               fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns\n               fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence\n               candidate_coverage_gate_pass = boolean\n               candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n               candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n               graphless_fallback_gate_pass = boolean\n               graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n               graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n               graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n               recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n          6. COMBINED STOP RULE:\n               a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n               b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n                    decision = \"BLOCKED\"\n                    stop_blocked = true\n                    stopReason = \"blockedStop\"\n                    # Blocked-stop closure: blockedBy must be string[] per the\n                    # published review blocked-stop contract. Extract the `.type`\n                    # field from each structured graph blocker; preserve the full\n                    # objects in graph_blocker_detail_json for operator inspection.\n                    blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n                    blocked_by_csv = graph_blockers_csv\n                    graph_blocker_detail_json = graph_blockers_json\n                    recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n               c) if STOP is legal AND graph_decision == \"CONTINUE\":\n                    decision = \"CONTINUE\"\n                    stop_blocked = false\n                    reason = \"graph_convergence_continue\"\n               d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n        outputs:\n          - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n          - reason: \"Human-readable stop reason\"\n          - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n          - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n          - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n          - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n          - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n          - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n          - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n          - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n          - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n          - active_p0_count: \"Active P0 finding count at stop-check time\"\n          - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n          - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n          - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n          - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n          - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n          - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n          - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n          - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n          - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n          - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n          - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n          - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n          - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n          - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n          - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n          - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n          - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n          - graph_signals_json: \"JSON object returned by graph convergence\"\n          - graph_blockers_json: \"JSON array of graph blockers\"\n          - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n          - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n\n      step_emit_blocked_stop:\n        action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n        if_blocked:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"review\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergenceGate\":{\"pass\":{convergence_gate_pass},\"score\":{convergence_gate_score}},\"dimensionCoverageGate\":{\"pass\":{dimension_coverage_gate_pass},\"covered\":{dimension_coverage_gate_covered_json},\"missing\":{dimension_coverage_gate_missing_json}},\"p0ResolutionGate\":{\"pass\":{p0_resolution_gate_pass},\"activeP0\":{active_p0_count}},\"evidenceDensityGate\":{\"pass\":{evidence_density_gate_pass},\"avgEvidencePerFinding\":{avg_evidence_per_finding}},\"hotspotSaturationGate\":{\"pass\":{hotspot_saturation_gate_pass}},\"claimAdjudicationGate\":{\"pass\":{claim_adjudication_gate_pass},\"activeP0P1\":{claim_adjudication_active_count}},\"fixCompletenessReplayGate\":{\"pass\":{fix_completeness_replay_gate_pass},\"securitySensitive\":{security_sensitive_fix_scope},\"requiredRows\":{fix_completeness_replay_required_rows},\"passingRows\":{fix_completeness_replay_passing_rows}},\"candidateCoverageGate\":{\"pass\":{candidate_coverage_gate_pass},\"searchDebt\":{candidate_coverage_search_debt_json},\"missing\":{candidate_coverage_missing_json}},\"graphlessFallbackGate\":{\"pass\":{graphless_fallback_gate_pass},\"mode\":\"{graphless_fallback_mode}\",\"missing\":{graphless_fallback_missing_json},\"unavailabilityReason\":\"{graphless_fallback_unavailability_reason}\"}},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n        if_not_blocked:\n          proceed: true\n\n      step_handle_convergence:\n        action: \"Act on convergence decision\"\n        if_stop:\n          branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n          if_divergent_eligible:\n            eligibility_contract:\n              required_decision: \"STOP\"\n              eligible_reasons: [all_dimensions_clean]\n              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n              fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n            steps:\n              step_prepare_divergent_pivot:\n                action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import {\n                    buildReviewPivotPreparationInput,\n                    renderReviewPivotSeatPrompt,\n                  } from './.opencode/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildReviewPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.findings_registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,\n                        renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n                      ]))\n                    : {};\n                  process.stdout.write(`${JSON.stringify({\n                    ...prepared,\n                    seatPrompts,\n                    boundaryRejections: input.boundaryRejections,\n                  })}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_prepare_json: \"The complete parsed JSON result\"\n                  - pivot_prepare_status: \"status from the prepare result\"\n                  - pivot_id: \"pivotId from the prepare result\"\n                  - pivot_paths_json: \"paths from the prepare result as JSON\"\n                  - pivot_resumed: \"resumed from the prepare result\"\n                  - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n                  - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n                  - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n                  - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n                  - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n                  - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n                  - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n                  - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n                short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n\n              step_dispatch_pivot_seat_001:\n                action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-review\n                    model: opus\n                    context_source: \"pivot_seat_001_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n                outputs:\n                  - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_001_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_001:\n                action: \"Durably record the seat-001 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_001_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_002:\n                action: \"Natively dispatch the critical read-only review direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-review\n                    model: opus\n                    context_source: \"pivot_seat_002_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n                outputs:\n                  - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_002_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_002:\n                action: \"Durably record the seat-002 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_002_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_003:\n                action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-review\n                    model: opus\n                    context_source: \"pivot_seat_003_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n                outputs:\n                  - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_003_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_003:\n                action: \"Durably record the seat-003 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_003_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_finalize_divergent_pivot:\n                action: \"Finalize the prepared pivot after all missing native seats are durable\"\n                skip_when: \"pivot_prepare_status != 'pending'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_finalize_json: \"The complete parsed final result\"\n\n              step_resolve_divergent_pivot_result:\n                action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n                branch_on: \"pivot_prepare_status\"\n                if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n                if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n\n              step_apply_divergent_pivot_result:\n                action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n                branch_on: \"pivot_result.status\"\n                if_completed:\n                  set:\n                    next_dimension: \"{pivot_result.restoredFocus}\"\n                    pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n                    saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n                  command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n                  log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n                  proceed_to: step_normalize_pause_events\n                if_failed:\n                  log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n                  skip_to: phase_synthesis\n            on_error:\n              log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n              skip_to: phase_synthesis\n          if_existing_terminal_path:\n            log: \"Loop stopping. Reason: {reason}\"\n            skip_to: phase_synthesis\n        if_blocked:\n          log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n        if_stuck_recovery:\n          log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n          recovery_strategies:\n            - \"Change granularity: file-level → function-level → line-level review\"\n            - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n            - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n          pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n          set:\n            next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n            pending_stop_event: \"stuck_recovery\"\n            pending_stop_reason: \"stuckRecovery\"\n            pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n          reset: { stuck_count: 0 }\n        if_continue:\n          log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n\n      step_normalize_pause_events:\n        action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n        if_pending_pause_event:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"review\",\"stopReason\":\"userPaused\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n          reset:\n            pending_stop_event: null\n            pending_stop_reason: null\n            pending_stop_detail: null\n          halt: true\n        if_pending_stuck_recovery:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"review\",\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"strategy\":\"{recovery_strategy}\",\"targetDimension\":\"{least_explored}\",\"outcome\":\"pending\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          reset:\n            pending_stop_event: null\n            pending_stop_reason: null\n            pending_stop_detail: null\n        if_no_pending_event:\n          proceed: true\n\n      step_generate_state_summary:\n        action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n        generate: |\n          STATE SUMMARY (auto-generated):\n          Iteration: {current_iteration} of {max_iterations}\n          Dimension: {next_dimension}\n          Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n          Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n          Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n          {resource_map_prompt_line}\n          Coverage Age: {coverage_age}\n          Last 2 ratios: {ratio_prev} -> {ratio_latest}\n          Stuck count: {stuck_count}\n          Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n\n      step_marker_scan:\n        action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n        algorithm: |\n          if current_iteration > 1:\n            PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n            if file_exists(PREV_PROMPT_PATH):\n              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n              if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n                log \"ERROR: nested review-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n                halt with exit code 2\n        note: |\n          False-positive prevention: only matches when the first line is exactly one of the\n          three canonical markers. Markers appearing in comments or body text are ignored.\n          True-positive triggers only when a previous iteration's rendered prompt literally\n          starts with a deep-loop marker, indicating a nested review-of-review dispatch.\n\n      step_dispatch_iteration:\n        action: \"Dispatch @deep-review agent for one review iteration\"\n        resolve_executor:\n          source: \"config.executor\"\n          loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n        pre_dispatch:\n          generate_summary: |\n            STATE SUMMARY (auto-generated):\n            Iteration: {current_iteration} of {max_iterations}\n            Dimension: {next_dimension}\n            Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n            Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n            Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n            {resource_map_prompt_line}\n            Coverage Age: {coverage_age}\n            Last 2 ratios: {ratio_prev} -> {ratio_latest}\n            Stuck count: {stuck_count}\n            Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n          render_prompt_pack:\n            template_path: \".opencode/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n            renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n            output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n            variables:\n              state_summary: \"{state_summary}\"\n              current_iteration: \"{current_iteration}\"\n              max_iterations: \"{max_iterations}\"\n              next_dimension: \"{next_dimension}\"\n              review_target: \"{review_target}\"\n              review_scope_files: \"{review_scope_files}\"\n              p0_count: \"{p0_count}\"\n              p1_count: \"{p1_count}\"\n              p2_count: \"{p2_count}\"\n              pivot_lineage: \"{pivot_lineage}\"\n              saturated_directions: \"{saturated_directions}\"\n              state_paths_config: \"{state_paths.config}\"\n              state_paths_state_log: \"{state_paths.state_log}\"\n              state_paths_findings_registry: \"{state_paths.findings_registry}\"\n              state_paths_strategy: \"{state_paths.strategy}\"\n              state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n              state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n        pre_dispatch_audit:\n          skip_when: \"config.executor.kind == 'native'\"\n          call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n          args:\n            stateLogPath: \"{state_paths.state_log}\"\n            executor: \"{config.executor}\"\n            iteration: \"{current_iteration}\"\n        branch_on: \"config.executor.kind\"\n        if_native:\n          dispatch:\n            agent: deep-review\n            model: opus\n            context_source: \"rendered_prompt_pack\"\n          wait_for_completion: true\n        if_cli_copilot:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync, writeFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { buildCopilotPromptArg } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n\n            const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';\n            const prompt = readFileSync(promptPath, 'utf8');\n\n            // Workflow-resolved spec folder is the only legal write authority.\n            // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)\n            // is the single source of truth for rejecting empty / unresolved\n            // template / whitespace-only / string-coerced empty values. The\n            // YAML hands the raw `{spec_folder}` directly; on rejection the\n            // helper safe-fails to `type:\"missing\", writeIntent:true` (Gate-3\n            // enforcement, --allow-all-tools stripped).\n            const specFolderRaw = '{spec_folder}';\n            const targetAuthority = { type: 'approved', specFolder: specFolderRaw };\n\n            const baseArgs = [\n              '-p',\n              prompt,\n              '--model',\n              '{config.executor.model}',\n              '--allow-all-tools',\n              '--no-ask-user',\n            ];\n\n            const built = buildCopilotPromptArg({\n              promptPath,\n              prompt,\n              targetAuthority,\n              baseArgv: baseArgs,\n            });\n\n            // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`\n            // containing `<TARGET AUTHORITY preamble>\\n\\n---\\n\\n<original>`.\n            // Write it to disk so the file Copilot reads via @path opens with\n            // the authority block. Without this, recovered/bootstrap folder\n            // mentions inside the file could still anchor the model.\n            if (built.promptFileBody !== undefined) {\n              writeFileSync(promptPath, built.promptFileBody, 'utf8');\n            }\n\n            // Copilot is routed through the audited executor wrapper so it produces\n            // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode\n            // There is no cli-copilot kind in the executor schema, so it\n            // dispatches as kind:'native' (full env passthrough, no recursion-guard\n            // layer configured for copilot); the receipt still records the real\n            // 'copilot' command + built.argv as facts.\n            const dispatchFacts = {\n              command: 'deep/review',\n              mode: 'review',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.kind}',\n              branchId: '{config.executor.kind}',\n              sessionId: '{session_id}',","lineStart":491,"lineEnd":1149,"totalLines":1150,"truncated":true}},"title":".opencode/commands/deep/assets/deep-review-auto.yaml","time":{"start":1788620184988,"end":1788620184992}},"id":"prt_072121d91001NyK3tqNt2X9iJU","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_07211d13a001EISw5eMuxHkh4K"}}
