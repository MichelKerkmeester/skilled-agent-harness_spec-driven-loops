oduleSpecifier = node.initializer.arguments[0].text;\n336:       markPathReference(moduleSpecifier);\n337:       if (isChildProcessModuleSpecifier(moduleSpecifier)) {\n338:         hasChildProcessImport = true;\n339:         registerChildProcessRequireBinding(node.name);\n340:       }\n341:     }\n342: \n343:     if (ts.isCallExpression(node)) {\n344:       if (isRequireCall(node) && node.arguments.length > 0 && isStringLiteralLike(node.arguments[0])) {\n345:         const moduleSpecifier = node.arguments[0].text;\n346:         markPathReference(moduleSpecifier);\n347:         if (isChildProcessModuleSpecifier(moduleSpecifier)) {\n348:           hasChildProcessImport = true;\n349:         }\n350:       }\n351: \n352:       if (node.expression.kind === ts.SyntaxKind.ImportKeyword && node.arguments.length > 0 && isStringLiteralLike(node.arguments[0])) {\n353:         markPathReference(node.arguments[0].text);\n354:       }\n355: \n356:       markSpawnExecUsage(node);\n357:     }\n358: \n359:     ts.forEachChild(node, visit);\n360:   }\n361: \n362:   visit(sourceFile);\n363: \n364:   return {\n365:     substantiveLines: countSubstantiveLines(content),\n366:     hasChildProcessImport,\n367:     hasChildProcessSpawnExecUsage,\n368:     hasScriptsDistReference,\n369:     hasScriptsSourceReference,\n370:   };\n371: }\n372: \n373: // ───────────────────────────────────────────────────────────────\n374: // 6. CORE LOGIC\n375: // ───────────────────────────────────────────────────────────────\n376: function checkSharedNeutrality(packageRoot = PACKAGE_ROOT): GapAViolation[] {\n377:   const resolvedRoot = resolveCheckRoot(packageRoot);\n378:   const sharedDir = path.join(resolvedRoot, 'shared');\n379:   const sourceFiles = findSourceFiles(sharedDir);\n380:   const violations: GapAViolation[] = [];\n381: \n382:   for (const file of sourceFiles) {\n383:     const content = fs.readFileSync(file, 'utf-8');\n384:     const moduleSpecifiers = extractModuleSpecifiers(content, file);\n385: \n386:     for (const specifier of moduleSpecifiers) {\n387:       if (isProhibitedForShared(specifier.importPath, file, resolvedRoot)) {\n388:         violations.push({ file, line: specifier.line, importPath: specifier.importPath });\n389:       }\n390:     }\n391:   }\n392: \n393:   return violations;\n394: }\n395: \n396: function checkWrapperOnly(packageRoot = PACKAGE_ROOT): GapBViolation[] {\n397:   const resolvedRoot = resolveCheckRoot(packageRoot);\n398:   const wrappersDir = path.join(resolvedRoot, 'runtime', 'scripts');\n399:   const violations: GapBViolation[] = [];\n400: \n401:   if (!fs.existsSync(wrappersDir)) return violations;\n402: \n403:   // Non-recursive scan — only top-level wrappers, not nested dirs\n404:   const entries = fs.readdirSync(wrappersDir, { withFileTypes: true });\n405:   for (const entry of entries) {\n406:     if (!entry.isFile() || !entry.name.endsWith('.ts') || entry.name.endsWith('.d.ts')) continue;\n407: \n408:     const fullPath = path.join(wrappersDir, entry.name);\n409:     const content = fs.readFileSync(fullPath, 'utf-8');\n410:     const reasons: string[] = [];\n411:     const signals = collectWrapperSignals(content, fullPath);\n412: \n413:     if (signals.substantiveLines > MAX_SUBSTANTIVE_LINES) {\n414:       reasons.push(`${signals.substantiveLines} substantive lines (max ${MAX_SUBSTANTIVE_LINES})`);\n415:     }\n416: \n417:     if (!signals.hasChildProcessImport) {\n418:       reasons.push('missing child_process import');\n419:     }\n420: \n421:     if (!signals.hasChildProcessSpawnExecUsage) {\n422:       reasons.push('no child_process spawn/exec usage');\n423:     }\n424: \n425:     if (!signals.hasScriptsDistReference) {\n426:       reasons.push('no reference to cli/dist/');\n427:     }\n428: \n429:     if (signals.hasScriptsSourceReference && !signals.hasScriptsDistReference) {\n430:       reasons.push('references cli/ without cli/dist/');\n431:     }\n432: \n433:     if (reasons.length > 0) {\n434:       violations.push({ file: fullPath, reasons });\n435:     }\n436:   }\n437: \n438:   return violations;\n439: }\n440: \n441: function runArchitectureBoundaryCheck(packageRoot = PACKAGE_ROOT): { gapAViolations: GapAViolation[]; gapBViolations: GapBViolation[] } {\n442:   const resolvedRoot = resolveCheckRoot(packageRoot);\n443:   const gapAViolations = checkSharedNeutrality(resolvedRoot);\n444:   const gapBViolations = checkWrapperOnly(resolvedRoot);\n445:   return { gapAViolations, gapBViolations };\n446: }\n447: \n448: // ───────────────────────────────────────────────────────────────\n449: // 7. MAIN\n\n(Showing lines 260-449 of 497. Use offset=450 to continue.)\n</content>","metadata":{"preview":"    if (ts.isNamespaceImport(namedBindings)) {\n      childProcessNamespaceBindings.add(namedBindings.name.text);\n      return;\n    }\n\n    for (const element of namedBindings.elements) {\n      const importedName = element.propertyName?.text ?? element.name.text;\n      if (CHILD_PROCESS_WRAPPER_APIS.has(importedName)) {\n        childProcessCallableBindings.add(element.name.text);\n      }\n    }\n  }\n\n  function registerChildProcessRequireBinding(name: ts.BindingName): void {\n    if (ts.isIdentifier(name)) {\n      childProcessNamespaceBindings.add(name.text);\n      return;\n    }\n\n    if (!ts.isObjectBindingPattern(name)) return;","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","text":"    if (ts.isNamespaceImport(namedBindings)) {\n      childProcessNamespaceBindings.add(namedBindings.name.text);\n      return;\n    }\n\n    for (const element of namedBindings.elements) {\n      const importedName = element.propertyName?.text ?? element.name.text;\n      if (CHILD_PROCESS_WRAPPER_APIS.has(importedName)) {\n        childProcessCallableBindings.add(element.name.text);\n      }\n    }\n  }\n\n  function registerChildProcessRequireBinding(name: ts.BindingName): void {\n    if (ts.isIdentifier(name)) {\n      childProcessNamespaceBindings.add(name.text);\n      return;\n    }\n\n    if (!ts.isObjectBindingPattern(name)) return;\n    for (const element of name.elements) {\n      if (!ts.isIdentifier(element.name)) continue;\n      const importedName = element.propertyName && ts.isIdentifier(element.propertyName)\n        ? element.propertyName.text\n        : element.name.text;\n      if (CHILD_PROCESS_WRAPPER_APIS.has(importedName)) {\n        childProcessCallableBindings.add(element.name.text);\n      }\n    }\n  }\n\n  function isRequireCall(node: ts.CallExpression): boolean {\n    return ts.isIdentifier(node.expression) && node.expression.text === 'require';\n  }\n\n  function markSpawnExecUsage(node: ts.CallExpression): void {\n    const expression = node.expression;\n\n    if (ts.isIdentifier(expression) && childProcessCallableBindings.has(expression.text)) {\n      hasChildProcessSpawnExecUsage = true;\n      return;\n    }\n\n    if (!ts.isPropertyAccessExpression(expression)) return;\n    if (!ts.isIdentifier(expression.expression)) return;\n    if (!childProcessNamespaceBindings.has(expression.expression.text)) return;\n    if (CHILD_PROCESS_WRAPPER_APIS.has(expression.name.text)) {\n      hasChildProcessSpawnExecUsage = true;\n    }\n  }\n\n  function visit(node: ts.Node): void {\n    if (isStringLiteralLike(node)) {\n      markPathReference(node.text);\n    }\n\n    if (ts.isImportDeclaration(node) && isStringLiteralLike(node.moduleSpecifier)) {\n      const moduleSpecifier = node.moduleSpecifier.text;\n      markPathReference(moduleSpecifier);\n      if (isChildProcessModuleSpecifier(moduleSpecifier)) {\n        hasChildProcessImport = true;\n        registerChildProcessImportClause(node.importClause);\n      }\n    }\n\n    if (ts.isImportEqualsDeclaration(node) && ts.isExternalModuleReference(node.moduleReference) && node.moduleReference.expression && isStringLiteralLike(node.moduleReference.expression)) {\n      const moduleSpecifier = node.moduleReference.expression.text;\n      markPathReference(moduleSpecifier);\n      if (isChildProcessModuleSpecifier(moduleSpecifier)) {\n        hasChildProcessImport = true;\n        childProcessNamespaceBindings.add(node.name.text);\n      }\n    }\n\n    if (ts.isVariableDeclaration(node) && node.initializer && ts.isCallExpression(node.initializer) && isRequireCall(node.initializer) && node.initializer.arguments.length > 0 && isStringLiteralLike(node.initializer.arguments[0])) {\n      const moduleSpecifier = node.initializer.arguments[0].text;\n      markPathReference(moduleSpecifier);\n      if (isChildProcessModuleSpecifier(moduleSpecifier)) {\n        hasChildProcessImport = true;\n        registerChildProcessRequireBinding(node.name);\n      }\n    }\n\n    if (ts.isCallExpression(node)) {\n      if (isRequireCall(node) && node.arguments.length > 0 && isStringLiteralLike(node.arguments[0])) {\n        const moduleSpecifier = node.arguments[0].text;\n        markPathReference(moduleSpecifier);\n        if (isChildProcessModuleSpecifier(moduleSpecifier)) {\n          hasChildProcessImport = true;\n        }\n      }\n\n      if (node.expression.kind === ts.SyntaxKind.ImportKeyword && node.arguments.length > 0 && isStringLiteralLike(node.arguments[0])) {\n        markPathReference(node.arguments[0].text);\n      }\n\n      markSpawnExecUsage(node);\n    }\n\n    ts.forEachChild(node, visit);\n  }\n\n  visit(sourceFile);\n\n  return {\n    substantiveLines: countSubstantiveLines(content),\n    hasChildProcessImport,\n    hasChildProcessSpawnExecUsage,\n    hasScriptsDistReference,\n    hasScriptsSourceReference,\n  };\n}\n\n// ───────────────────────────────────────────────────────────────\n// 6. CORE LOGIC\n// ───────────────────────────────────────────────────────────────\nfunction checkSharedNeutrality(packageRoot = PACKAGE_ROOT): GapAViolation[] {\n  const resolvedRoot = resolveCheckRoot(packageRoot);\n  const sharedDir = path.join(resolvedRoot, 'shared');\n  const sourceFiles = findSourceFiles(sharedDir);\n  const violations: GapAViolation[] = [];\n\n  for (const file of sourceFiles) {\n    const content = fs.readFileSync(file, 'utf-8');\n    const moduleSpecifiers = extractModuleSpecifiers(content, file);\n\n    for (const specifier of moduleSpecifiers) {\n      if (isProhibitedForShared(specifier.importPath, file, resolvedRoot)) {\n        violations.push({ file, line: specifier.line, importPath: specifier.importPath });\n      }\n    }\n  }\n\n  return violations;\n}\n\nfunction checkWrapperOnly(packageRoot = PACKAGE_ROOT): GapBViolation[] {\n  const resolvedRoot = resolveCheckRoot(packageRoot);\n  const wrappersDir = path.join(resolvedRoot, 'runtime', 'scripts');\n  const violations: GapBViolation[] = [];\n\n  if (!fs.existsSync(wrappersDir)) return violations;\n\n  // Non-recursive scan — only top-level wrappers, not nested dirs\n  const entries = fs.readdirSync(wrappersDir, { withFileTypes: true });\n  for (const entry of entries) {\n    if (!entry.isFile() || !entry.name.endsWith('.ts') || entry.name.endsWith('.d.ts')) continue;\n\n    const fullPath = path.join(wrappersDir, entry.name);\n    const content = fs.readFileSync(fullPath, 'utf-8');\n    const reasons: string[] = [];\n    const signals = collectWrapperSignals(content, fullPath);\n\n    if (signals.substantiveLines > MAX_SUBSTANTIVE_LINES) {\n      reasons.push(`${signals.substantiveLines} substantive lines (max ${MAX_SUBSTANTIVE_LINES})`);\n    }\n\n    if (!signals.hasChildProcessImport) {\n      reasons.push('missing child_process import');\n    }\n\n    if (!signals.hasChildProcessSpawnExecUsage) {\n      reasons.push('no child_process spawn/exec usage');\n    }\n\n    if (!signals.hasScriptsDistReference) {\n      reasons.push('no reference to cli/dist/');\n    }\n\n    if (signals.hasScriptsSourceReference && !signals.hasScriptsDistReference) {\n      reasons.push('references cli/ without cli/dist/');\n    }\n\n    if (reasons.length > 0) {\n      violations.push({ file: fullPath, reasons });\n    }\n  }\n\n  return violations;\n}\n\nfunction runArchitectureBoundaryCheck(packageRoot = PACKAGE_ROOT): { gapAViolations: GapAViolation[]; gapBViolations: GapBViolation[] } {\n  const resolvedRoot = resolveCheckRoot(packageRoot);\n  const gapAViolations = checkSharedNeutrality(resolvedRoot);\n  const gapBViolations = checkWrapperOnly(resolvedRoot);\n  return { gapAViolations, gapBViolations };\n}\n\n// ───────────────────────────────────────────────────────────────\n// 7. MAIN","lineStart":260,"lineEnd":449,"totalLines":497,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","time":{"start":1788620035201,"end":1788620035232}},"id":"prt_0720fd47d001DbWX22OLv5LdsX","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
{"type":"tool_use","timestamp":1788620035241,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_9b1Rp6v5mZd6iVK7up6zAu6z","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","offset":1,"limit":260},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Check Architecture Boundaries\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // NOTE: This script enforces shared/ neutrality and runtime/scripts/ wrapper-only rules.\n6: // The companion check for Scripts -> runtime-internals import policy lives in:\n7: //   check-no-mcp-lib-imports-ast.ts (AST-based, with allowlist governance)\n8: // Both checks should be run together for full boundary compliance.\n9: \n10: // ───────────────────────────────────────────────────────────────\n11: // 1. CHECK ARCHITECTURE BOUNDARIES\n12: // ───────────────────────────────────────────────────────────────\n13: // Enforces two rules from ARCHITECTURE.md that were\n14: // Previously documentation-only:\n15: //   GAP A — shared/ must not import from runtime/ or scripts/\n16: //   GAP B — runtime/scripts/ files must be thin wrappers only\n17: \n18: // ───────────────────────────────────────────────────────────────\n19: // 2. IMPORTS\n20: // ───────────────────────────────────────────────────────────────\n21: import * as fs from 'fs';\n22: import * as path from 'path';\n23: import ts from 'typescript';\n24: import { dirnameFromImportMeta, isMainModule } from '../lib/esm-entry.js';\n25: \n26: const moduleDir = dirnameFromImportMeta(import.meta.url);\n27: \n28: // ───────────────────────────────────────────────────────────────\n29: // 3. TYPE DEFINITIONS\n30: // ───────────────────────────────────────────────────────────────\n31: interface GapAViolation {\n32:   file: string;\n33:   line: number;\n34:   importPath: string;\n35: }\n36: \n37: interface GapBViolation {\n38:   file: string;\n39:   reasons: string[];\n40: }\n41: \n42: interface WrapperSignals {\n43:   substantiveLines: number;\n44:   hasChildProcessImport: boolean;\n45:   hasChildProcessSpawnExecUsage: boolean;\n46:   hasScriptsDistReference: boolean;\n47:   hasScriptsSourceReference: boolean;\n48: }\n49: \n50: // ───────────────────────────────────────────────────────────────\n51: // 4. CONSTANTS\n52: // ───────────────────────────────────────────────────────────────\n53: const REQUIRED_ROOT_DIRS = ['shared', 'runtime', 'runtime/cli'] as const;\n54: \n55: // Absolute prohibition — shared/ must remain neutral (no allowlist)\n56: const SHARED_PROHIBITED_PACKAGE_PREFIXES = ['@spec-kit/runtime', '@spec-kit/cli'];\n57: \n58: // 50 lines is generous for a spawn+exit wrapper; anything larger\n59: // Indicates logic that belongs in cli/ instead\n60: const MAX_SUBSTANTIVE_LINES = 50;\n61: const PACKAGE_ROOT = resolvePackageRoot(moduleDir);\n62: const CHILD_PROCESS_MODULE_SPECIFIERS = new Set(['child_process', 'node:child_process']);\n63: const CHILD_PROCESS_WRAPPER_APIS = new Set(['spawn', 'spawnSync', 'exec', 'execSync', 'execFile', 'execFileSync', 'fork']);\n64: \n65: // ───────────────────────────────────────────────────────────────\n66: // 5. HELPERS\n67: // ───────────────────────────────────────────────────────────────\n68: function findSourceFiles(dir: string): string[] {\n69:   const files: string[] = [];\n70: \n71:   function walk(currentDir: string): void {\n72:     if (!fs.existsSync(currentDir)) return;\n73:     const entries = fs.readdirSync(currentDir, { withFileTypes: true });\n74:     for (const entry of entries) {\n75:       const fullPath = path.join(currentDir, entry.name);\n76:       if (entry.isDirectory()) {\n77:         if (entry.name === 'node_modules' || entry.name === 'dist') continue;\n78:         walk(fullPath);\n79:       } else if (\n80:         (entry.name.endsWith('.ts') || entry.name.endsWith('.js') || entry.name.endsWith('.mjs') || entry.name.endsWith('.cjs'))\n81:         && !entry.name.endsWith('.d.ts')\n82:       ) {\n83:         files.push(fullPath);\n84:       }\n85:     }\n86:   }\n87: \n88:   walk(dir);\n89:   return files;\n90: }\n91: \n92: function resolvePackageRoot(startDir: string): string {\n93:   let cursor = path.resolve(startDir);\n94:   while (true) {\n95:     const hasRequiredDirs = REQUIRED_ROOT_DIRS.every((dirName) => fs.existsSync(path.join(cursor, dirName)));\n96:     if (hasRequiredDirs) return cursor;\n97: \n98:     const parent = path.dirname(cursor);\n99:     if (parent === cursor) {\n100:       throw new Error(`Unable to resolve package root from: ${startDir}`);\n101:     }\n102:     cursor = parent;\n103:   }\n104: }\n105: \n106: function resolveCheckRoot(packageRoot: string): string {\n107:   const resolvedRoot = path.resolve(packageRoot);\n108:   const missingDirs = REQUIRED_ROOT_DIRS.filter((dirName) => !fs.existsSync(path.join(resolvedRoot, dirName)));\n109:   if (missingDirs.length > 0) {\n110:     throw new Error(`Invalid package root \"${resolvedRoot}\" — missing directories: ${missingDirs.join(', ')}`);\n111:   }\n112:   return resolvedRoot;\n113: }\n114: \n115: function normalizeImportPath(importPath: string): string {\n116:   return importPath.replace(/\\\\/g, '/');\n117: }\n118: \n119: function isWithinDirectory(candidatePath: string, directoryPath: string): boolean {\n120:   const relative = path.relative(directoryPath, candidatePath);\n121:   return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n122: }\n123: \n124: function isStringLiteralLike(node: ts.Node): node is ts.StringLiteral | ts.NoSubstitutionTemplateLiteral {\n125:   return ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node);\n126: }\n127: \n128: function isChildProcessModuleSpecifier(moduleSpecifier: string): boolean {\n129:   return CHILD_PROCESS_MODULE_SPECIFIERS.has(moduleSpecifier);\n130: }\n131: \n132: function isScriptsDistReference(importPath: string): boolean {\n133:   const normalized = normalizeImportPath(importPath);\n134:   return normalized.includes('cli/dist/') || normalized.endsWith('cli/dist') || normalized.startsWith('@spec-kit/cli/dist');\n135: }\n136: \n137: function isScriptsSourceReference(importPath: string): boolean {\n138:   const normalized = normalizeImportPath(importPath);\n139:   if (normalized.startsWith('@spec-kit/cli')) return true;\n140:   return normalized.includes('/cli/') || normalized.startsWith('cli/');\n141: }\n142: \n143: function isProhibitedForShared(importPath: string, sourceFilePath: string, packageRoot: string): boolean {\n144:   const normalizedImportPath = normalizeImportPath(importPath);\n145:   const isProhibitedPackageImport = SHARED_PROHIBITED_PACKAGE_PREFIXES.some((prefix) => {\n146:     return normalizedImportPath === prefix || normalizedImportPath.startsWith(`${prefix}/`);\n147:   });\n148:   if (isProhibitedPackageImport) return true;\n149: \n150:   if (path.isAbsolute(importPath)) {\n151:     const resolvedAbsolutePath = path.resolve(importPath);\n152:     return isWithinDirectory(resolvedAbsolutePath, path.join(packageRoot, 'runtime'));\n153:   }\n154: \n155:   if (!normalizedImportPath.startsWith('.')) return false;\n156: \n157:   const resolvedImportPath = path.resolve(path.dirname(sourceFilePath), normalizedImportPath);\n158:   return isWithinDirectory(resolvedImportPath, path.join(packageRoot, 'runtime'));\n159: }\n160: \n161: function extractModuleSpecifiers(content: string, filePath: string): Array<{ importPath: string; line: number }> {\n162:   const sourceFile = ts.createSourceFile(filePath, content, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);\n163:   const hits: Array<{ importPath: string; line: number }> = [];\n164: \n165:   function pushHit(moduleSpecifier: ts.Node): void {\n166:     if (!isStringLiteralLike(moduleSpecifier)) return;\n167:     const { line } = sourceFile.getLineAndCharacterOfPosition(moduleSpecifier.getStart(sourceFile));\n168:     hits.push({ importPath: moduleSpecifier.text, line: line + 1 });\n169:   }\n170: \n171:   function visit(node: ts.Node): void {\n172:     if (ts.isImportDeclaration(node) && node.moduleSpecifier) {\n173:       pushHit(node.moduleSpecifier);\n174:     }\n175: \n176:     if (ts.isExportDeclaration(node) && node.moduleSpecifier) {\n177:       pushHit(node.moduleSpecifier);\n178:     }\n179: \n180:     if (ts.isImportEqualsDeclaration(node) && ts.isExternalModuleReference(node.moduleReference) && node.moduleReference.expression) {\n181:       pushHit(node.moduleReference.expression);\n182:     }\n183: \n184:     if (ts.isImportTypeNode(node) && ts.isLiteralTypeNode(node.argument) && isStringLiteralLike(node.argument.literal)) {\n185:       pushHit(node.argument.literal);\n186:     }\n187: \n188:     if (ts.isCallExpression(node) && node.arguments.length > 0) {\n189:       const firstArg = node.arguments[0];\n190:       const isRequireCall = ts.isIdentifier(node.expression) && node.expression.text === 'require';\n191:       const isDynamicImport = node.expression.kind === ts.SyntaxKind.ImportKeyword;\n192:       if ((isRequireCall || isDynamicImport) && isStringLiteralLike(firstArg)) {\n193:         const { line } = sourceFile.getLineAndCharacterOfPosition(firstArg.getStart(sourceFile));\n194:         hits.push({ importPath: firstArg.text, line: line + 1 });\n195:       }\n196:     }\n197: \n198:     ts.forEachChild(node, visit);\n199:   }\n200: \n201:   visit(sourceFile);\n202:   return hits;\n203: }\n204: \n205: function countSubstantiveLines(content: string): number {\n206:   const lines = content.split('\\n');\n207:   let count = 0;\n208:   let inBlockComment = false;\n209: \n210:   for (const line of lines) {\n211:     if (inBlockComment) {\n212:       if (line.indexOf('*/') !== -1) inBlockComment = false;\n213:       continue;\n214:     }\n215: \n216:     const openIdx = line.indexOf('/*');\n217:     if (openIdx !== -1) {\n218:       const closeIdx = line.indexOf('*/', openIdx + 2);\n219:       if (closeIdx === -1) {\n220:         inBlockComment = true;\n221:         continue;\n222:       }\n223:     }\n224: \n225:     const trimmed = line.trim();\n226:     if (trimmed === '' || trimmed.startsWith('//')) continue;\n227: \n228:     count++;\n229:   }\n230: \n231:   return count;\n232: }\n233: \n234: function collectWrapperSignals(content: string, filePath: string): WrapperSignals {\n235:   const sourceFile = ts.createSourceFile(filePath, content, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);\n236: \n237:   const childProcessCallableBindings = new Set<string>();\n238:   const childProcessNamespaceBindings = new Set<string>();\n239:   let hasChildProcessImport = false;\n240:   let hasChildProcessSpawnExecUsage = false;\n241:   let hasScriptsDistReference = false;\n242:   let hasScriptsSourceReference = false;\n243: \n244:   function markPathReference(rawPath: string): void {\n245:     if (!rawPath.includes('/') && !rawPath.includes('@spec-kit')) return;\n246:     if (isScriptsSourceReference(rawPath)) hasScriptsSourceReference = true;\n247:     if (isScriptsDistReference(rawPath)) hasScriptsDistReference = true;\n248:   }\n249: \n250:   function registerChildProcessImportClause(importClause: ts.ImportClause | undefined): void {\n251:     if (!importClause) return;\n252: \n253:     if (importClause.name) {\n254:       childProcessNamespaceBindings.add(importClause.name.text);\n255:     }\n256: \n257:     const namedBindings = importClause.namedBindings;\n258:     if (!namedBindings) return;\n259: \n260:     if (ts.isNamespaceImport(namedBindings)) {\n\n(Showing lines 1-260 of 497. Use offset=261 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Check Architecture Boundaries\n// ───────────────────────────────────────────────────────────────────\n\n// NOTE: This script enforces shared/ neutrality and runtime/scripts/ wrapper-only rules.\n// The companion check for Scripts -> runtime-internals import policy lives in:\n//   check-no-mcp-lib-imports-ast.ts (AST-based, with allowlist governance)\n// Both checks should be run together for full boundary compliance.\n\n// ───────────────────────────────────────────────────────────────\n// 1. CHECK ARCHITECTURE BOUNDARIES\n// ───────────────────────────────────────────────────────────────\n// Enforces two rules from ARCHITECTURE.md that were\n// Previously documentation-only:\n//   GAP A — shared/ must not import from runtime/ or scripts/\n//   GAP B — runtime/scripts/ files must be thin wrappers only\n\n// ───────────────────────────────────────────────────────────────\n// 2. IMPORTS\n// ───────────────────────────────────────────────────────────────","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Check Architecture Boundaries\n// ───────────────────────────────────────────────────────────────────\n\n// NOTE: This script enforces shared/ neutrality and runtime/scripts/ wrapper-only rules.\n// The companion check for Scripts -> runtime-internals import policy lives in:\n//   check-no-mcp-lib-imports-ast.ts (AST-based, with allowlist governance)\n// Both checks should be run together for full boundary compliance.\n\n// ───────────────────────────────────────────────────────────────\n// 1. CHECK ARCHITECTURE BOUNDARIES\n// ───────────────────────────────────────────────────────────────\n// Enforces two rules from ARCHITECTURE.md that were\n// Previously documentation-only:\n//   GAP A — shared/ must not import from runtime/ or scripts/\n//   GAP B — runtime/scripts/ files must be thin wrappers only\n\n// ───────────────────────────────────────────────────────────────\n// 2. IMPORTS\n// ───────────────────────────────────────────────────────────────\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport ts from 'typescript';\nimport { dirnameFromImportMeta, isMainModule } from '../lib/esm-entry.js';\n\nconst moduleDir = dirnameFromImportMeta(import.meta.url);\n\n// ───────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────\ninterface GapAViolation {\n  file: string;\n  line: number;\n  importPath: string;\n}\n\ninterface GapBViolation {\n  file: string;\n  reasons: string[];\n}\n\ninterface WrapperSignals {\n  substantiveLines: number;\n  hasChildProcessImport: boolean;\n  hasChildProcessSpawnExecUsage: boolean;\n  hasScriptsDistReference: boolean;\n  hasScriptsSourceReference: boolean;\n}\n\n// ───────────────────────────────────────────────────────────────\n// 4. CONSTANTS\n// ───────────────────────────────────────────────────────────────\nconst REQUIRED_ROOT_DIRS = ['shared', 'runtime', 'runtime/cli'] as const;\n\n// Absolute prohibition — shared/ must remain neutral (no allowlist)\nconst SHARED_PROHIBITED_PACKAGE_PREFIXES = ['@spec-kit/runtime', '@spec-kit/cli'];\n\n// 50 lines is generous for a spawn+exit wrapper; anything larger\n// Indicates logic that belongs in cli/ instead\nconst MAX_SUBSTANTIVE_LINES = 50;\nconst PACKAGE_ROOT = resolvePackageRoot(moduleDir);\nconst CHILD_PROCESS_MODULE_SPECIFIERS = new Set(['child_process', 'node:child_process']);\nconst CHILD_PROCESS_WRAPPER_APIS = new Set(['spawn', 'spawnSync', 'exec', 'execSync', 'execFile', 'execFileSync', 'fork']);\n\n// ───────────────────────────────────────────────────────────────\n// 5. HELPERS\n// ───────────────────────────────────────────────────────────────\nfunction findSourceFiles(dir: string): string[] {\n  const files: string[] = [];\n\n  function walk(currentDir: string): void {\n    if (!fs.existsSync(currentDir)) return;\n    const entries = fs.readdirSync(currentDir, { withFileTypes: true });\n    for (const entry of entries) {\n      const fullPath = path.join(currentDir, entry.name);\n      if (entry.isDirectory()) {\n        if (entry.name === 'node_modules' || entry.name === 'dist') continue;\n        walk(fullPath);\n      } else if (\n        (entry.name.endsWith('.ts') || entry.name.endsWith('.js') || entry.name.endsWith('.mjs') || entry.name.endsWith('.cjs'))\n        && !entry.name.endsWith('.d.ts')\n      ) {\n        files.push(fullPath);\n      }\n    }\n  }\n\n  walk(dir);\n  return files;\n}\n\nfunction resolvePackageRoot(startDir: string): string {\n  let cursor = path.resolve(startDir);\n  while (true) {\n    const hasRequiredDirs = REQUIRED_ROOT_DIRS.every((dirName) => fs.existsSync(path.join(cursor, dirName)));\n    if (hasRequiredDirs) return cursor;\n\n    const parent = path.dirname(cursor);\n    if (parent === cursor) {\n      throw new Error(`Unable to resolve package root from: ${startDir}`);\n    }\n    cursor = parent;\n  }\n}\n\nfunction resolveCheckRoot(packageRoot: string): string {\n  const resolvedRoot = path.resolve(packageRoot);\n  const missingDirs = REQUIRED_ROOT_DIRS.filter((dirName) => !fs.existsSync(path.join(resolvedRoot, dirName)));\n  if (missingDirs.length > 0) {\n    throw new Error(`Invalid package root \"${resolvedRoot}\" — missing directories: ${missingDirs.join(', ')}`);\n  }\n  return resolvedRoot;\n}\n\nfunction normalizeImportPath(importPath: string): string {\n  return importPath.replace(/\\\\/g, '/');\n}\n\nfunction isWithinDirectory(candidatePath: string, directoryPath: string): boolean {\n  const relative = path.relative(directoryPath, candidatePath);\n  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n}\n\nfunction isStringLiteralLike(node: ts.Node): node is ts.StringLiteral | ts.NoSubstitutionTemplateLiteral {\n  return ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node);\n}\n\nfunction isChildProcessModuleSpecifier(moduleSpecifier: string): boolean {\n  return CHILD_PROCESS_MODULE_SPECIFIERS.has(moduleSpecifier);\n}\n\nfunction isScriptsDistReference(importPath: string): boolean {\n  const normalized = normalizeImportPath(importPath);\n  return normalized.includes('cli/dist/') || normalized.endsWith('cli/dist') || normalized.startsWith('@spec-kit/cli/dist');\n}\n\nfunction isScriptsSourceReference(importPath: string): boolean {\n  const normalized = normalizeImportPath(importPath);\n  if (normalized.startsWith('@spec-kit/cli')) return true;\n  return normalized.includes('/cli/') || normalized.startsWith('cli/');\n}\n\nfunction isProhibitedForShared(importPath: string, sourceFilePath: string, packageRoot: string): boolean {\n  const normalizedImportPath = normalizeImportPath(importPath);\n  const isProhibitedPackageImport = SHARED_PROHIBITED_PACKAGE_PREFIXES.some((prefix) => {\n    return normalizedImportPath === prefix || normalizedImportPath.startsWith(`${prefix}/`);\n  });\n  if (isProhibitedPackageImport) return true;\n\n  if (path.isAbsolute(importPath)) {\n    const resolvedAbsolutePath = path.resolve(importPath);\n    return isWithinDirectory(resolvedAbsolutePath, path.join(packageRoot, 'runtime'));\n  }\n\n  if (!normalizedImportPath.startsWith('.')) return false;\n\n  const resolvedImportPath = path.resolve(path.dirname(sourceFilePath), normalizedImportPath);\n  return isWithinDirectory(resolvedImportPath, path.join(packageRoot, 'runtime'));\n}\n\nfunction extractModuleSpecifiers(content: string, filePath: string): Array<{ importPath: string; line: number }> {\n  const sourceFile = ts.createSourceFile(filePath, content, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);\n  const hits: Array<{ importPath: string; line: number }> = [];\n\n  function pushHit(moduleSpecifier: ts.Node): void {\n    if (!isStringLiteralLike(moduleSpecifier)) return;\n    const { line } = sourceFile.getLineAndCharacterOfPosition(moduleSpecifier.getStart(sourceFile));\n    hits.push({ importPath: moduleSpecifier.text, line: line + 1 });\n  }\n\n  function visit(node: ts.Node): void {\n    if (ts.isImportDeclaration(node) && node.moduleSpecifier) {\n      pushHit(node.moduleSpecifier);\n    }\n\n    if (ts.isExportDeclaration(node) && node.moduleSpecifier) {\n      pushHit(node.moduleSpecifier);\n    }\n\n    if (ts.isImportEqualsDeclaration(node) && ts.isExternalModuleReference(node.moduleReference) && node.moduleReference.expression) {\n      pushHit(node.moduleReference.expression);\n    }\n\n    if (ts.isImportTypeNode(node) && ts.isLiteralTypeNode(node.argument) && isStringLiteralLike(node.argument.literal)) {\n      pushHit(node.argument.literal);\n    }\n\n    if (ts.isCallExpression(node) && node.arguments.length > 0) {\n      const firstArg = node.arguments[0];\n      const isRequireCall = ts.isIdentifier(node.expression) && node.expression.text === 'require';\n      const isDynamicImport = node.expression.kind === ts.SyntaxKind.ImportKeyword;\n      if ((isRequireCall || isDynamicImport) && isStringLiteralLike(firstArg)) {\n        const { line } = sourceFile.getLineAndCharacterOfPosition(firstArg.getStart(sourceFile));\n        hits.push({ importPath: firstArg.text, line: line + 1 });\n      }\n    }\n\n    ts.forEachChild(node, visit);\n  }\n\n  visit(sourceFile);\n  return hits;\n}\n\nfunction countSubstantiveLines(content: string): number {\n  const lines = content.split('\\n');\n  let count = 0;\n  let inBlockComment = false;\n\n  for (const line of lines) {\n    if (inBlockComment) {\n      if (line.indexOf('*/') !== -1) inBlockComment = false;\n      continue;\n    }\n\n    const openIdx = line.indexOf('/*');\n    if (openIdx !== -1) {\n      const closeIdx = line.indexOf('*/', openIdx + 2);\n      if (closeIdx === -1) {\n        inBlockComment = true;\n        continue;\n      }\n    }\n\n    const trimmed = line.trim();\n    if (trimmed === '' || trimmed.startsWith('//')) continue;\n\n    count++;\n  }\n\n  return count;\n}\n\nfunction collectWrapperSignals(content: string, filePath: string): WrapperSignals {\n  const sourceFile = ts.createSourceFile(filePath, content, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);\n\n  const childProcessCallableBindings = new Set<string>();\n  const childProcessNamespaceBindings = new Set<string>();\n  let hasChildProcessImport = false;\n  let hasChildProcessSpawnExecUsage = false;\n  let hasScriptsDistReference = false;\n  let hasScriptsSourceReference = false;\n\n  function markPathReference(rawPath: string): void {\n    if (!rawPath.includes('/') && !rawPath.includes('@spec-kit')) return;\n    if (isScriptsSourceReference(rawPath)) hasScriptsSourceReference = true;\n    if (isScriptsDistReference(rawPath)) hasScriptsDistReference = true;\n  }\n\n  function registerChildProcessImportClause(importClause: ts.ImportClause | undefined): void {\n    if (!importClause) return;\n\n    if (importClause.name) {\n      childProcessNamespaceBindings.add(importClause.name.text);\n    }\n\n    const namedBindings = importClause.namedBindings;\n    if (!namedBindings) return;\n\n    if (ts.isNamespaceImport(namedBindings)) {","lineStart":1,"lineEnd":260,"totalLines":497,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","time":{"start":1788620035196,"end":1788620035236}},"id":"prt_0720fd4780016n1UIPnuaMrLSk","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_0720f853f001GZGPYTwOeH4uxa"}}
