E \"^⚠ [A-Z_]+:\" | sed 's/^⚠ \\([A-Z_]*\\):.*/\\1/' | sort -u | paste -sd, - || true)\n28:   echo \"ERR=0 WARN=${warns} | $rel | rules=$rules\"\n29: else\n30:   echo \"CLEAN | $rel\"\n31: fi\n\n(End of file - total 31 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n# Validate ONE spec folder with a short timeout, print a single summary line.\nset -euo pipefail\nfolder=\"${1:?folder required}\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREPO_ROOT=\"$(cd \"$SCRIPT_DIR/../../../../..\" && pwd)\"\nVALIDATE=\"$REPO_ROOT/.opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh\"\nROOT=\"$REPO_ROOT/.opencode/specs\"\n# 30s hard cap\nout=$(bash \"$VALIDATE\" \"$folder\" --strict 2>&1 & pid=$!\n      ( sleep 30 && kill -9 \"$pid\" 2>/dev/null || true ) & killer=$!\n      wait \"$pid\" 2>/dev/null || true\n      kill \"$killer\" 2>/dev/null || true\n      wait \"$killer\" 2>/dev/null || true)\nrel=\"${folder#$ROOT/}\"\nsummary=$(printf '%s\\n' \"$out\" | grep -E \"^  Summary:\" | head -1 || true)\nif [ -z \"$summary\" ]; then\n  echo \"TIMEOUT_OR_FAIL | $rel\"\n  exit 0\nfi","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/.scan-one.sh","text":"#!/usr/bin/env bash\n# Validate ONE spec folder with a short timeout, print a single summary line.\nset -euo pipefail\nfolder=\"${1:?folder required}\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREPO_ROOT=\"$(cd \"$SCRIPT_DIR/../../../../..\" && pwd)\"\nVALIDATE=\"$REPO_ROOT/.opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh\"\nROOT=\"$REPO_ROOT/.opencode/specs\"\n# 30s hard cap\nout=$(bash \"$VALIDATE\" \"$folder\" --strict 2>&1 & pid=$!\n      ( sleep 30 && kill -9 \"$pid\" 2>/dev/null || true ) & killer=$!\n      wait \"$pid\" 2>/dev/null || true\n      kill \"$killer\" 2>/dev/null || true\n      wait \"$killer\" 2>/dev/null || 