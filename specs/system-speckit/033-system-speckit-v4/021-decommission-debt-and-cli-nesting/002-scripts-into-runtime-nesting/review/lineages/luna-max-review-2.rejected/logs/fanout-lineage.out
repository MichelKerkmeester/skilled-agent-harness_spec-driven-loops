   \"outDir\": \"./dist\",\n    \"baseUrl\": \".\",\n    \"paths\": {\n      \"@spec-kit/runtime/api\": [\"../api/index.ts\"],\n      \"@spec-kit/shared/*\": [\"../../shared/*\"],\n      \"@spec-kit/runtime/*\": [\"../*\"]\n    }\n  },\n  \"references\": [\n    { \"path\": \"../../shared\" },\n    { \"path\": \"..\" }\n  ],\n  \"include\": [","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tsconfig.json","text":"{\n  \"extends\": \"../../tsconfig.json\",\n  \"compilerOptions\": {\n    \"composite\": true,\n    \"module\": \"es2022\",\n    \"moduleResolution\": \"node\",\n    \"rootDir\": \".\",\n    \"outDir\": \"./dist\",\n    \"baseUrl\": \".\",\n    \"paths\": {\n      \"@spec-kit/runtime/api\": [\"../api/index.ts\"],\n      \"@spec-kit/shared/*\": [\"../../shared/*\"],\n      \"@spec-kit/runtime/*\": [\"../*\"]\n    }\n  },\n  \"references\": [\n    { \"path\": \"../../shared\" },\n    { \"path\": \"..\" }\n  ],\n  \"include\": [\n    \"*.ts\",\n    \"config/**/*.ts\",\n    \"continuity/**/*.ts\",\n    \"core/**/*.ts\",\n    \"evals/**/*.ts\",\n    \"extractors/**/*.ts\",\n    \"graph/**/*.ts\",\n    \"lib/**/*.ts\",\n    \"loaders/**/*.ts\",\n    \"observability/**/*.ts\",\n    \"ops/**/*.ts\",\n    \"renderers/**/*.ts\",\n    \"spec/**/*.ts\",\n    \"spec-folder/**/*.ts\",\n    \"types/**/*.ts\",\n    \"utils/**/*.ts\",\n    \"validation/**/*.ts\"\n  ],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests/**/*.vitest.ts\"]\n}","lineStart":1,"lineEnd":40,"totalLines":40,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/tsconfig.json","time":{"start":1788620374877,"end":1788620374894}},"id":"prt_07215035b001y46zDcouSvKqT1","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072143d79001sAz3VjyFeElJfq"}}
