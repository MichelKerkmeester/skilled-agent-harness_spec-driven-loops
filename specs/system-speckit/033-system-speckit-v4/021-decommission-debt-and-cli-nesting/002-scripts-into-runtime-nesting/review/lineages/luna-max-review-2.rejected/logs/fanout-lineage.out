ndation\":\"Reconcile status, level and completion evidence before closeout.\",\"disposition\":\"active\",\"findingClass\":\"matrix/evidence\",\"scopeProof\":\"Read all canonical packet documents and metadata.\",\"affectedSurfaceHints\":[\"completion gate\",\"generated metadata\"],\"content_hash\":\"f005-traceability-packet-state\"},{\"id\":\"F006\",\"severity\":\"P1\",\"category\":\"traceability\",\"dimension\":\"traceability\",\"title\":\"Durable docs retain retired scripts validation links\",\"file\":\".opencode/skills/system-spec-kit/SKILL.md\",\"line\":103,\"evidence\":\"Link target uses ./scripts/README.md while the displayed target is runtime/cli/README.md; root README and template retain old scripts paths.\",\"recommendation\":\"Update durable links and command examples to current paths, then replay link checks.\",\"disposition\":\"active\",\"findingClass\":\"cross-consumer\",\"scopeProof\":\"Read current target paths and linked documents; old scripts directory is absent.\",\"affectedSurfaceHints\":[\"skill navigation\",\"template validation command\"],\"content_hash\":\"f006-traceability-retired-doc-links\"}],\"findingsNew\":{\"P0\":0,\"P1\":2,\"P2\":0},\"newFindingsRatio\":0.5,\"traceabilityChecks\":{\"summary\":{\"required\":2,\"executed\":2,\"pass\":0,\"partial\":1,\"fail\":1,\"blocked\":0,\"notApplicable\":0,\"gatingFailures\":1},\"results\":[{\"protocolId\":\"spec_code\",\"status\":\"partial\",\"gateClass\":\"hard\",\"applicable\":true,\"counts\":{\"pass\":0,\"partial\":1,\"fail\":0,\"skipped\":0},\"evidence\":[\"spec.md:23-32\",\"implementation-summary.md:40-64\"],\"findingRefs\":[\"F005\"],\"summary\":\"Completion state conflicts across packet documents.\"},{\"protocolId\":\"checklist_evidence\",\"status\":\"fail\",\"gateClass\":\"hard\",\"applicable\":true,\"counts\":{\"pass\":0,\"partial\":0,\"fail\":1,\"skipped\":0},\"evidence\":[\"plan.md:41-49\",\"tasks.md:65-70\",\"acceptance-criteria.md:58-63\"],\"findingRefs\":[\"F005\"],\"summary\":\"Completion marks and evidence rows are not reconciled.\"},{\"protocolId\":\"feature_catalog_code\",\"status\":\"partial\",\"gateClass\":\"advisory\",\"applicable\":true,\"counts\":{\"pass\":0,\"partial\":1,\"fail\":0,\"skipped\":0},\"evidence\":[\"SKILL.md:103\",\"README.md:446-448\"],\"findingRefs\":[\"F006\"],\"summary\":\"Durable links are mixed between old and new topology.\"},{\"protocolId\":\"playbook_capability\",\"status\":\"partial\",\"gateClass\":\"advisory\",\"applicable\":true,\"counts\":{\"pass\":0,\"partial\":1,\"fail\":0,\"skipped\":0},\"evidence\":[\"templates/changelog/README.md:88-94\"],\"findingRefs\":[\"F006\"],\"summary\":\"Template command points to a retired validator path.\"}]},\"reviewDepthSchemaVersion\":2,\"reviewDepthApplicability\":{\"scopeClass\":\"complex\",\"enforcement\":\"strict\",\"reason\":\"Completion metadata and linked command paths determine whether the packet can be safely handed off.\",\"evidenceRefs\":[\"spec.md:19-32\",\"acceptance-criteria.md:42-90\"]},\"targetSelection\":{\"selectedTargets\":[\"spec.md\",\"plan.md\",\"tasks.md\",\"acceptance-criteria.md\",\"implementation-summary.md\",\"SKILL.md\",\"README.md\",\"templates/changelog/README.md\"],\"selectionReason\":\"These documents own completion and durable path claims.\",\"discoveryMethods\":[\"direct_read\",\"exact_search\",\"producer_consumer_trace\"],\"omittedHighRiskTargets\":[],\"graphStatus\":\"unavailable\",\"semanticSearchStatus\":\"unavailable\",\"evidenceRefs\":[\"scratch/review-scope.txt:118-164\"]},\"searchCoverage\":{\"requiredBugClasses\":[\"status_reconciliation\",\"checklist_evidence\",\"retired_doc_paths\"],\"covered\":[\"status_reconciliation\",\"checklist_evidence\",\"retired_doc_paths\"],\"ruledOut\":[\"source_hash_mismatch\"],\"deferred\":[],\"blocked\":[],\"graphCoverageMode\":\"graphless_fallback\"},\"searchLedger\":[{\"id\":\"SL-007\",\"dimension\":\"traceability\",\"targetRefs\":[\"spec.md\",\"plan.md\",\"tasks.md\",\"acceptance-criteria.md\",\"implementation-summary.md\"],\"bugClass\":\"status_reconciliation\",\"hypothesis\":\"Completion state may disagree across packet documents.\",\"searchActions\":[{\"method\":\"direct_read\",\"queryOrPath\":\"status, level, checklist and closure fields\",\"result\":\"Complete, Planned and unchecked states coexist.\",\"evidenceRefs\":[\"spec.md:23-32\",\"acceptance-criteria.md:45-48\",\"plan.md:45-48\",\"implementation-summary.md:40-49\"]}],\"disposition\":\"finding\",\"rationale\":\"A future operator cannot identify one authoritative packet state.\",\"linkedFindingId\":\"F005\"},{\"id\":\"SL-008\",\"dimension\":\"traceability\",\"targetRefs\":[\".opencode/skills/system-spec-kit/SKILL.md\",\".opencode/skills/system-spec-kit/README.md\",\".opencode/skills/system-spec-kit/templates/changelog/README.md\"],\"bugClass\":\"retired_doc_paths\",\"hypothesis\":\"Durable docs still route readers to old scripts paths.\",\"searchActions\":[{\"method\":\"exact_grep\",\"queryOrPath\":\"old scripts path and relative links\",\"result\":\"Three live docs retain old links or commands.\",\"evidenceRefs\":[\"SKILL.md:103\",\"README.md:446-447\",\"templates/changelog/README.md:91\"]}],\"disposition\":\"finding\",\"rationale\":\"These are executable navigation or command examples, not historical changelog text.\",\"linkedFindingId\":\"F006\"}]},\"sessionId\":\"fanout-luna-max-review-2-1788619675959-m55pwa\",\"generation\":1,\"lineageMode\":\"new\",\"timestamp\":\"2026-09-05T15:15:00Z\",\"durationMs\":300000}\n","additions":1,"deletions":0},{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/iterations/iteration-004.md","relativePath":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/iterations/iteration-004.md","type":"add","patch":"Index: /Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/iterations/iteration-004.md\n===================================================================\n--- /Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/iterations/iteration-004.md\n+++ /Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/iterations/iteration-004.md\n@@ -0,0 +1,43 @@\n+# Iteration 4: Maintainability and Moved Documentation\n+\n+## Focus\n+Maintainability review of moved package READMEs, related links, registry metadata and operator playbooks.\n+\n+## Scorecard\n+- Dimensions covered: maintainability\n+- Files reviewed: 11 direct files\n+- New findings: P0=0 P1=1 P2=1\n+- Refined findings: P0=0 P1=1 P2=0\n+- New findings ratio: 0.25\n+\n+## Findings\n+\n+### P1, Required\n+- **F007**: The committed scan helpers still embed a developer-specific absolute repository path. `.scan-one-fast.sh` hardcodes both the validator and spec roots, while `.scan-validate-all.py` hardcodes the same workstation root. These helpers are in the moved CLI tree and are intended to run from other checkouts. [SOURCE: .opencode/skills/system-spec-kit/runtime/cli/.scan-one-fast.sh:4-6] [SOURCE: .opencode/skills/system-spec-kit/runtime/cli/.scan-validate-all.py:7-8]\n+\n+### P2, Suggestion\n+- **F008**: Several moved README related links still resolve as if the package were a sibling workspace. `continuity/README.md` links to `../../runtime/scripts/README.md`, and `spec-folder/README.md` and `kpi/README.md` link to a removed `../memory/README.md`. [SOURCE: .opencode/skills/system-spec-kit/runtime/cli/continuity/README.md:212-217] [SOURCE: .opencode/skills/system-spec-kit/runtime/cli/spec-folder/README.md:134-139] [SOURCE: .opencode/skills/system-spec-kit/runtime/cli/kpi/README.md:87-92]\n+\n+## Cross-Reference Results\n+| Protocol | Status | Gate | Evidence | Notes |\n+|----------|--------|------|----------|-------|\n+| spec_code | partial | hard | implementation-summary.md:136-154; moved READMEs | File inventory says docs were corrected, but current moved docs retain topology residue. |\n+| checklist_evidence | partial | hard | tasks.md:157-169; README links | File organization and docs checks do not evidence link resolution. |\n+| feature_catalog_code | partial | advisory | runtime/cli README files | Package surface exists but internal wayfinding is stale. |\n+| playbook_capability | partial | advisory | manual playbook:52-116 | Evidence blocks still use retired paths. |\n+\n+## Assessment\n+- New findings ratio: 0.25\n+- Dimensions addressed: maintainability\n+- Novelty justification: direct README link inspection found broken relative targets distinct from the broad root documentation findings.\n+\n+## Ruled Out\n+- The current runtime mirror generator itself resolves its repository root from `__dirname`, so this finding is limited to the scan helpers. [SOURCE: runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs:24-33]\n+\n+## Dead Ends\n+- No documentation edits were made during review.\n+\n+## Recommended Next Focus\n+Correctness replay of registry consumers, CI guard paths and committed scan helper behavior.\n+\n+Review verdict: CONDITIONAL\n","additions":43,"deletions":0},{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/deltas/iter-004.jsonl","relativePath":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-2/deltas/iter-004.jsonl","type":"add","patch":"Index: /