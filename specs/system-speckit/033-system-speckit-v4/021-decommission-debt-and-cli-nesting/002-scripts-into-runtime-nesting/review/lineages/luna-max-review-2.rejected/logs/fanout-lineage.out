,\n30:   write: 'write',\n31:   edit: 'edit',\n32:   bash: 'bash',\n33:   grep: 'grep',\n34:   glob: 'find',\n35:   list: 'ls',\n36: });\n37: \n38: // ───────────────────────────────────────────────────────────────\n39: // 3. HELPERS\n40: // ───────────────────────────────────────────────────────────────\n41: \n42: function parseArguments(argv) {\n43:   if (argv.length === 0) {\n44:     return { check: false };\n45:   }\n46:   if (argv.length === 1 && argv[0] === '--check') {\n47:     return { check: true };\n48:   }\n49:   throw new Error('Usage: node sync-agents-pi.cjs [--check]');\n50: }\n51: \n52: function listSourceFiles() {\n53:   if (!fs.existsSync(SOURCE_DIR)) {\n54:     return [];\n55:   }\n56:   return fs.readdirSync(SOURCE_DIR, { withFileTypes: true })\n57:     .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n58:     .map((entry) => entry.name)\n59:     .sort();\n60: }\n61: \n62: function listOutputFiles() {\n63:   if (!fs.existsSync(OUTPUT_DIR)) {\n64:     return [];\n65:   }\n66:   return fs.readdirSync(OUTPUT_DIR, { withFileTypes: true })\n67:     .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n68:     .map((entry) => entry.name)\n69:     .sort();\n70: }\n71: \n72: function parseScalar(value) {\n73:   const trimmed = value.trim();\n74:   if (trimmed.startsWith('\"')) return JSON.parse(trimmed);\n75:   if (trimmed.startsWith(\"'\")) return trimmed.slice(1, -1).replace(/''/g, \"'\");\n76:   return trimmed;\n77: }\n78: \n79: function parseSource(contents, sourcePath) {\n80:   const match = contents.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---\\r?\\n?([\\s\\S]*)$/);\n81:   if (!match) {\n82:     throw new Error(`missing YAML frontmatter in ${sourcePath}`);\n83:   }\n84: \n85:   const frontmatter = match[1];\n86:   const nameMatch = frontmatter.match(/^name:\\s*(.+)$/m);\n87:   const descriptionMatch = frontmatter.match(/^description:\\s*(.+)$/m);\n88:   if (!nameMatch || !descriptionMatch) {\n89:     throw new Error(`frontmatter requires name and description in ${sourcePath}`);\n90:   }\n91: \n92:   const permissions = new Map();\n93:   const permissionBlock = frontmatter.match(/^permission:\\s*\\n((?: {2,}[^\\n]*\\n?)*)/m);\n94:   if (permissionBlock) {\n95:     for (const line of permissionBlock[1].split(/\\r?\\n/)) {\n96:       const permissionMatch = line.match(/^\\s{2}([A-Za-z0-9_]+):\\s*(allow|deny)\\s*$/);\n97:       if (permissionMatch) permissions.set(permissionMatch[1], permissionMatch[2]);\n98:     }\n99:   }\n100: \n\n(Showing lines 1-100 of 265. Use offset=101 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Sync Pi Agents                                                           ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst REPO_ROOT = path.resolve(__dirname, '../../../../../..');\nconst SOURCE_DIR = path.join(REPO_ROOT, '.opencode', 'agents');\nconst OUTPUT_DIR = path.join(REPO_ROOT, '.pi', 'agents');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Sync Pi Agents                                                           ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst REPO_ROOT = path.resolve(__dirname, '../../../../../..');\nconst SOURCE_DIR = path.join(REPO_ROOT, '.opencode', 'agents');\nconst OUTPUT_DIR = path.join(REPO_ROOT, '.pi', 'agents');\n\n// These are the literal Pi built-in names confirmed by the installed Pi type\n// definitions. OpenCode-only permissions remain visible in generated YAML\n// comments instead of being silently discarded. `glob`/`list` map to `find`/`ls`\n// by name only; their exact capability shape (predicate-based find vs. simple\n// glob matching) is asserted from the type defs, not independently verified\n// against Pi's real runtime behavior.\nconst PERMISSION_TOOL_MAP = Object.freeze({\n  read: 'read',\n  write: 'write',\n  edit: 'edit',\n  bash: 'bash',\n  grep: 'grep',\n  glob: 'find',\n  list: 'ls',\n});\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\n\nfunction parseArguments(argv) {\n  if (argv.length === 0) {\n    return { check: false };\n  }\n  if (argv.length === 1 && argv[0] === '--check') {\n    return { check: true };\n  }\n  throw new Error('Usage: node sync-agents-pi.cjs [--check]');\n}\n\nfunction listSourceFiles() {\n  if (!fs.existsSync(SOURCE_DIR)) {\n    return [];\n  }\n  return fs.readdirSync(SOURCE_DIR, { withFileTypes: true })\n    .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n    .map((entry) => entry.name)\n    .sort();\n}\n\nfunction listOutputFiles() {\n  if (!fs.existsSync(OUTPUT_DIR)) {\n    return [];\n  }\n  return fs.readdirSync(OUTPUT_DIR, { withFileTypes: true })\n    .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n    .map((entry) => entry.name)\n    .sort();\n}\n\nfunction parseScalar(value) {\n  const trimmed = value.trim();\n  if (trimmed.startsWith('\"')) return JSON.parse(trimmed);\n  if (trimmed.startsWith(\"'\")) return trimmed.slice(1, -1).replace(/''/g, \"'\");\n  return trimmed;\n}\n\nfunction parseSource(contents, sourcePath) {\n  const match = contents.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---\\r?\\n?([\\s\\S]*)$/);\n  if (!match) {\n    throw new Error(`missing YAML frontmatter in ${sourcePath}`);\n  }\n\n  const frontmatter = match[1];\n  const nameMatch = frontmatter.match(/^name:\\s*(.+)$/m);\n  const descriptionMatch = frontmatter.match(/^description:\\s*(.+)$/m);\n  if (!nameMatch || !descriptionMatch) {\n    throw new Error(`frontmatter requires name and description in ${sourcePath}`);\n  }\n\n  const permissions = new Map();\n  const permissionBlock = frontmatter.match(/^permission:\\s*\\n((?: {2,}[^\\n]*\\n?)*)/m);\n  if (permissionBlock) {\n    for (const line of permissionBlock[1].split(/\\r?\\n/)) {\n      const permissionMatch = line.match(/^\\s{2}([A-Za-z0-9_]+):\\s*(allow|deny)\\s*$/);\n      if (permissionMatch) permissions.set(permissionMatch[1], permissionMatch[2]);\n    }\n  }\n","lineStart":1,"lineEnd":100,"totalLines":265,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs","time":{"start":1788620385337,"end":1788620385353}},"id":"prt_072152c20001jH1kw6YJm13ab9","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072150a65001O31uxKQyKEKNwe"}}
{"type":"tool_use","timestamp":1788620385467,"sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","part":{"type":"tool","tool":"read","callID":"call_zWtSHHIo7wgHGTTmrhYoD6ib","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/optimizer/replay-corpus.cjs","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/optimizer/replay-corpus.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ Replay Corpus                                                            ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: \n5: 'use strict';\n6: \n7: \n8: // ───────────────────────────────────────────────────────────────\n9: // MODULE: Replay Corpus Builder\n10: // ───────────────────────────────────────────────────────────────\n11: // Extracts replay corpus from packet JSONL data for offline\n12: // loop optimization. Packet family 040 is REQUIRED. 028 is an\n13: // optional holdout. 042 is excluded until traces exist.\n14: // ───────────────────────────────────────────────────────────────\n15: \n16: const fs = require('fs');\n17: const path = require('path');\n18: \n19: /* ───────────────────────────────────────────────────────────────\n20:    1. CONSTANTS\n21: ----------------------------------------------------------------*/\n22: \n23: /**\n24:  * Supported packet families and their corpus roles.\n25:  * @type {Readonly<Record<string, { role: string; required: boolean; compatibilityGrade: string }>>}\n26:  */\n27: const PACKET_FAMILIES = Object.freeze({\n28:   '040': { role: 'primary', required: true, compatibilityGrade: 'full' },\n29:   '028': { role: 'holdout', required: false, compatibilityGrade: 'legacy' },\n30:   '042': { role: 'excluded', required: false, compatibilityGrade: 'none' },\n31: });\n32: \n33: /**\n34:  * Required fields for a valid corpus entry.\n35:  * @type {ReadonlyArray<string>}\n36:  */\n37: const REQUIRED_ENTRY_FIELDS = Object.freeze([\n38:   'id',\n39:   'packetFamily',\n40:   'sourceRun',\n41:   'config',\n42:   'iterations',\n43:   'stopOutcome',\n44: ]);\n45: \n46: /**\n47:  * JSONL record types that carry iteration data.\n48:  * @type {ReadonlySet<string>}\n49:  */\n50: const ITERATION_TYPES = new Set(['iteration']);\n51: \n52: /**\n53:  * JSONL record types that carry stop/event data.\n54:  * @type {ReadonlySet<string>}\n55:  */\n56: const EVENT_TYPES = new Set(['event']);\n57: \n58: const REPO_ROOT = path.resolve(__dirname, '../../../../../..');\n59: const APPROVED_CORPUS_ROOTS = Object.freeze([\n60:   path.join(REPO_ROOT, '.opencode', 'specs'),\n61:   path.join(REPO_ROOT, 'specs'),\n62:   path.resolve(__dirname, '../tests/fixtures/deep-loop-replay'),\n63: ]);\n64: \n65: function isPathWithin(candidatePath, rootPath) {\n66:   const relative = path.relative(rootPath, candidatePath);\n67:   return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n68: }\n69: \n70: function getApprovedCorpusRoots() {\n71:   return APPROVED_CORPUS_ROOTS\n72:     .filter((rootPath) => fs.existsSync(rootPath))\n73:     .map((rootPath) => fs.realpathSync(rootPath));\n74: }\n75: \n76: function resolveApprovedCorpusPath(rawPath, label, expectedType) {\n77:   const candidatePath = path.resolve(rawPath);\n78: \n79:   if (!fs.existsSync(candidatePath)) {\n80:     throw new Error(`${label} does not exist: ${rawPath}`);\n81:   }\n82: \n83:   const stats = fs.lstatSync(candidatePath);\n84:   if (stats.isSymbolicLink()) {\n85:     throw new Error(`${label} must not be a symlink: ${rawPath}`);\n86:   }\n87: \n88:   const realPath = fs.realpathSync(candidatePath);\n89: \n90:   if (expectedType === 'dir' && !stats.isDirectory()) {\n91:     throw new Error(`${label} must be a directory: ${rawPath}`);\n92:   }\n93:   if (expectedType === 'file' && !stats.isFile()) {\n94:     throw new Error(`${label} must be a file: ${rawPath}`);\n95:   }\n96: \n97:   const approvedRoots = getApprovedCorpusRoots();\n98:   if (!approvedRoots.some((rootPath) => isPathWithin(realPath, rootPath))) {\n99:     throw new Error(`${label} must resolve under an approved corpus root`);\n100:   }\n\n(Showing lines 1-100 of 514. Use offset=101 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Replay Corpus                                                            ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n\n// ───────────────────────────────────────────────────────────────\n// MODULE: Replay Corpus Builder\n// ───────────────────────────────────────────────────────────────\n// Extracts replay corpus from packet JSONL data for offline\n// loop optimization. Packet family 040 is REQUIRED. 028 is an\n// optional holdout. 042 is excluded until traces exist.\n// ───────────────────────────────────────────────────────────────\n\nconst fs = require('fs');\nconst path = require('path');\n\n/* ───────────────────────────────────────────────────────────────\n   1. CONSTANTS","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/optimizer/replay-corpus.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Replay Corpus                                                            ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n\n// ───────────────────────────────────────────────────────────────\n// MODULE: Replay Corpus Builder\n// ───────────────────────────────────────────────────────────────\n// Extracts replay corpus from packet JSONL data for offline\n// loop optimization. Packet family 040 is REQUIRED. 028 is an\n// optional holdout. 042 is excluded until traces exist.\n// ───────────────────────────────────────────────────────────────\n\nconst fs = require('fs');\nconst path = require('path');\n\n/* ───────────────────────────────────────────────────────────────\n   1. CONSTANTS\n----------------------------------------------------------------*/\n\n/**\n * Supported packet families and their corpus roles.\n * @type {Readonly<Record<string, { role: string; required: boolean; compatibilityGrade: string }>>}\n */\nconst PACKET_FAMILIES = Object.freeze({\n  '040': { role: 'primary', required: true, compatibilityGrade: 'full' },\n  '028': { role: 'holdout', required: false, compatibilityGrade: 'legacy' },\n  '042': { role: 'excluded', required: false, compatibilityGrade: 'none' },\n});\n\n/**\n * Required fields for a valid corpus entry.\n * @type {ReadonlyArray<string>}\n */\nconst REQUIRED_ENTRY_FIELDS = Object.freeze([\n  'id',\n  'packetFamily',\n  'sourceRun',\n  'config',\n  'iterations',\n  'stopOutcome',\n]);\n\n/**\n * JSONL record types that carry iteration data.\n * @type {ReadonlySet<string>}\n */\nconst ITERATION_TYPES = new Set(['iteration']);\n\n/**\n * JSONL record types that carry stop/event data.\n * @type {ReadonlySet<string>}\n */\nconst EVENT_TYPES = new Set(['event']);\n\nconst REPO_ROOT = path.resolve(__dirname, '../../../../../..');\nconst APPROVED_CORPUS_ROOTS = Object.freeze([\n  path.join(REPO_ROOT, '.opencode', 'specs'),\n  path.join(REPO_ROOT, 'specs'),\n  path.resolve(__dirname, '../tests/fixtures/deep-loop-replay'),\n]);\n\nfunction isPathWithin(candidatePath, rootPath) {\n  const relative = path.relative(rootPath, candidatePath);\n  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n}\n\nfunction getApprovedCorpusRoots() {\n  return APPROVED_CORPUS_ROOTS\n    .filter((rootPath) => fs.existsSync(rootPath))\n    .map((rootPath) => fs.realpathSync(rootPath));\n}\n\nfunction resolveApprovedCorpusPath(rawPath, label, expectedType) {\n  const candidatePath = path.resolve(rawPath);\n\n  if (!fs.existsSync(candidatePath)) {\n    throw new Error(`${label} does not exist: ${rawPath}`);\n  }\n\n  const stats = fs.lstatSync(candidatePath);\n  if (stats.isSymbolicLink()) {\n    throw new Error(`${label} must not be a symlink: ${rawPath}`);\n  }\n\n  const realPath = fs.realpathSync(candidatePath);\n\n  if (expectedType === 'dir' && !stats.isDirectory()) {\n    throw new Error(`${label} must be a directory: ${rawPath}`);\n  }\n  if (expectedType === 'file' && !stats.isFile()) {\n    throw new Error(`${label} must be a file: ${rawPath}`);\n  }\n\n  const approvedRoots = getApprovedCorpusRoots();\n  if (!approvedRoots.some((rootPath) => isPathWithin(realPath, rootPath))) {\n    throw new Error(`${label} must resolve under an approved corpus root`);\n  }","lineStart":1,"lineEnd":100,"totalLines":514,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/optimizer/replay-corpus.cjs","time":{"start":1788620385459,"end":1788620385465}},"id":"prt_072152cae001qJwNlR7h3VVQXB","sessionID":"ses_f8df59422ffeuY8ct2HDJCCEpY","messageID":"msg_072150a65001O31uxKQyKEKNwe"}}
