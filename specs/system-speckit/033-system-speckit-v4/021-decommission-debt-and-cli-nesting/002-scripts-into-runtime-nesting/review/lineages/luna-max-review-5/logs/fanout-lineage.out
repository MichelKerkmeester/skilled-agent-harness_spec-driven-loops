isioned in this checkout (missing package.json or node_modules); dist freshness cannot be assessed or rebuilt here`,\n  };","lineStart":1,"lineEnd":180,"totalLines":969,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs","time":{"start":1788624996788,"end":1788624996824}},"id":"prt_0725b89b3001D3LZiWJdtQBk43","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0725b6b75001aTSxie5xSnq80K"}}
{"type":"step_finish","timestamp":1788624997603,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"id":"prt_0725b8ce1001KudeH9Zr13Hy1f","reason":"tool-calls","snapshot":"7af35880bef00d02a10b457fda71907691d4dd5e","messageID":"msg_0725b6b75001aTSxie5xSnq80K","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","type":"step-finish","tokens":{"total":230138,"input":27606,"output":671,"reasoning":0,"cache":{"write":0,"read":201861}},"cost":0.01036362}}
{"type":"step_start","timestamp":1788625001988,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"id":"prt_0725b9e03001NSzA4Ivx9uLA3u","messageID":"msg_0725b8fe0001Tac0PZUBC884ER","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","snapshot":"7af35880bef00d02a10b457fda71907691d4dd5e","type":"step-start"}}
{"type":"tool_use","timestamp":1788625032352,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_ANC7VeaenHkf43lyTkpnD2CR","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/config/README.md","offset":1,"limit":130},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/config/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Config: System Spec Kit Runtime Settings\"\n3: description: \"Current configuration files for the continuity writer, spec workflow support and content filtering behavior.\"\n4: trigger_phrases:\n5:   - \"system spec kit config\"\n6:   - \"continuity writer configuration\"\n7:   - \"content filter settings\"\n8: ---\n9: \n10: # Config: System Spec Kit Runtime Settings\n11: \n12: > Runtime settings for the continuity writer, spec workflow support and content filtering.\n13: \n14: ---\n15: \n16: ## 1. OVERVIEW\n17: \n18: `config/` owns JSONC settings read by the spec-kit script layer. These files are operator-editable configuration, not source modules.\n19: \n20: Current state:\n21: \n22: - `config.jsonc` defines the workflow and continuity-writer settings that `scripts/core/config.ts` merges into `SpecKitConfig`: preview and truncation caps, conversation windowing, timezone offset, observation and file limits, and the quality abort threshold.\n23: - `filters.jsonc` defines the noise, dedupe and quality pipeline that `scripts/lib/content-filter.ts` applies to captured session content.\n24: - Config files are loaded by runtime code on process startup or script execution.\n25: - Keys that no loader reads are inert. The loader takes only the fields declared in `WorkflowConfig`, so an unrecognized block changes nothing.\n26: \n27: ---\n28: \n29: ## 2. OWNERSHIP\n30: \n31: This directory belongs to the `system-spec-kit` skill. Changes should stay compatible with the loaders under `scripts/core/` and `scripts/lib/`.\n32: \n33: ---\n34: \n35: ## 3. TREE AND KEY FILES\n36: \n37: ```text\n38: config/\n39: +-- README.md       # Directory orientation\n40: +-- config.jsonc    # Workflow, continuity-writer and template settings\n41: `-- filters.jsonc   # Content filter pipeline settings\n42: ```\n43: \n44: | File | Role |\n45: |---|---|\n46: | `config.jsonc` | Shared runtime settings for the continuity writer and spec workflow support |\n47: | `filters.jsonc` | Thresholds and scoring weights for content filtering |\n48: \n49: ---\n50: \n51: ## 4. BOUNDARIES\n52: \n53: - Keep files valid JSONC.\n54: - Do not add code, generated state or packet notes here.\n55: - Add new settings only when a loader or script reads them.\n56: - Keep defaults in code aligned with documented keys.\n57: \n58: ---\n59: \n60: ## 5. VALIDATION\n61: \n62: ```bash\n63: python3 .opencode/skills/sk-doc/scripts/validate_document.py .opencode/skills/system-spec-kit/config/README.md\n64: ```\n65: \n66: Run the consumer script or test that reads any changed setting before claiming behavior changes.\n67: \n68: ---\n69: \n70: ## 6. RELATED\n71: \n72: - [`../runtime/cli/core/config.ts`](../runtime/cli/core/config.ts) - Main config loader.\n73: - [`../runtime/cli/lib/content-filter.ts`](../runtime/cli/lib/content-filter.ts) - Filter config consumer.\n74: - [`../references/memory/memory-system.md`](../references/memory/memory-system.md) - Retrieval and continuity behavior reference.\n\n(End of file - total 74 lines)\n</content>","metadata":{"preview":"---\ntitle: \"Config: System Spec Kit Runtime Settings\"\ndescription: \"Current configuration files for the continuity writer, spec workflow support and content filtering behavior.\"\ntrigger_phrases:\n  - \"system spec kit config\"\n  - \"continuity writer configuration\"\n  - \"content filter settings\"\n---\n\n# Config: System Spec Kit Runtime Settings\n\n> Runtime settings for the continuity writer, spec workflow support and content filtering.\n\n---\n\n## 1. OVERVIEW\n\n`config/` owns JSONC settings read by the spec-kit script layer. These files are operator-editable configuration, not source modules.\n\nCurrent state:","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/config/README.md","text":"---\ntitle: \"Config: System Spec Kit Runtime Settings\"\ndescription: \"Current configuration files for the continuity writer, spec workflow support and content filtering behavior.\"\ntrigger_phrases:\n  - \"system spec kit config\"\n  - \"continuity writer configuration\"\n  - \"content filter settings\"\n---\n\n# Config: System Spec Kit Runtime Settings\n\n> Runtime settings for the continuity writer, spec workflow support and content filtering.\n\n---\n\n## 1. OVERVIEW\n\n`config/` owns JSONC settings read by the spec-kit script layer. These files are operator-editable configuration, not source modules.\n\nCurrent state:\n\n- `config.jsonc` defines the workflow and continuity-writer settings that `scripts/core/config.ts` merges into `SpecKitConfig`: preview and truncation caps, conversation windowing, timezone offset, observation and file limits, and the quality abort threshold.\n- `filters.jsonc` defines the noise, dedupe and quality pipeline that `scripts/lib/content-filter.ts` applies to captured session content.\n- Config files are loaded by runtime code on process startup or script execution.\n- Keys that no loader reads are inert. The loader takes only the fields declared in `WorkflowConfig`, so an unrecognized block changes nothing.\n\n---\n\n## 2. OWNERSHIP\n\nThis directory belongs to the `system-spec-kit` skill. Changes should stay compatible with the loaders under `scripts/core/` and `scripts/lib/`.\n\n---\n\n## 3. TREE AND KEY FILES\n\n```text\nconfig/\n+-- README.md       # Directory orientation\n+-- config.jsonc    # Workflow, continuity-writer and template settings\n`-- filters.jsonc   # Content filter pipeline settings\n```\n\n| File | Role |\n|---|---|\n| `config.jsonc` | Shared runtime settings for the continuity writer and spec workflow support |\n| `filters.jsonc` | Thresholds and scoring weights for content filtering |\n\n---\n\n## 4. BOUNDARIES\n\n- Keep files valid JSONC.\n- Do not add code, generated state or packet notes here.\n- Add new settings only when a loader or script reads them.\n- Keep defaults in code aligned with documented keys.\n\n---\n\n## 5. VALIDATION\n\n```bash\npython3 .opencode/skills/sk-doc/scripts/validate_document.py .opencode/skills/system-spec-kit/config/README.md\n```\n\nRun the consumer script or test that reads any changed setting before claiming behavior changes.\n\n---\n\n## 6. RELATED\n\n- [`../runtime/cli/core/config.ts`](../runtime/cli/core/config.ts) - Main config loader.\n- [`../runtime/cli/lib/content-filter.ts`](../runtime/cli/lib/content-filter.ts) - Filter config consumer.\n- [`../references/memory/memory-system.md`](../references/memory/memory-system.md) - Retrieval and continuity behavior reference.","lineStart":1,"lineEnd":74,"totalLines":74,"truncated":false}},"title":".opencode/skills/system-spec-kit/config/README.md","time":{"start":1788625032343,"end":1788625032351}},"id":"prt_0725c1489001ujNZOc7tEDUnvN","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0725b8fe0001Tac0PZUBC884ER"}}
{"type":"tool_use","timestamp":1788625032383,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_7kqpgZZA2XN58BPYnc5jUlkw","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/ARCHITECTURE.md","offset":1,"limit":240},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/ARCHITECTURE.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Architecture: system-spec-kit\"\n3: description: \"Current package architecture for system-spec-kit: scripts, runtime engine, shared modules, canonical continuity flows, hook matrix, validators.\"\n4: trigger_phrases:\n5:   - \"system spec kit architecture\"\n6:   - \"spec kit architecture\"\n7:   - \"canonical continuity architecture\"\n8:   - \"resume ladder\"\n9:   - \"spec-kit runtime subsystems\"\n10: importance_tier: \"important\"\n11: ---\n12: \n13: # Architecture: system-spec-kit\n14: \n15: > Current-reality architecture for the `system-spec-kit` package. Authored code lives in `runtime/cli/`, `runtime/`, and `shared/`. Continuity is rebuilt through `/speckit:resume` and canonical spec documents.\n16: \n17: ---\n18: \n19: ## 1. OVERVIEW\n20: \n21: `system-spec-kit` is split into three authored zones plus generated build output:\n22: \n23: - `runtime/cli/` owns CLI generation, validation, indexing, evals, and packet tooling. TypeScript and shell.\n24: - `runtime/` owns the spec-kit engine: spec folder validation, generated packet metadata, description generation, and the per-runtime hook adapters. It is consumed as a library, not run as a service. TypeScript.\n25: - `shared/` owns neutral modules imported by both scripts and the engine. TypeScript.\n26: - Each zone carries its own generated `dist/`, gitignored and rebuilt from source. Not authored.\n27: \n28: The package's operator-facing recovery surface is `/speckit:resume`. The recovery chain reads `handover.md`, then `_memory.continuity`, then canonical spec docs (`implementation-summary.md`, `tasks.md`, `plan.md`, `spec.md`). Generated memory artifacts are supporting context only, not the primary continuity record.\n29: \n30: ### Architecture diagram\n31: \n32: ```text\n33: ┌─────────────────────────────────────────────────────────────────┐\n34: │                  SYSTEM-SPEC-KIT PACKAGE                        │\n35: ├─────────────────────────────────────────────────────────────────┤\n36: │                                                                 │\n37: │  ┌──────────────────┐     ┌──────────────────────┐              │\n38: │  │   CLI Runtimes   │     │      AI Agents       │              │\n39: │  │ Claude / OpenCode   │────▶│  (Gate 1/2/3 flow)   │               │\n40: │  │ OpenCode         │     │                      │              │\n41: │  └────────┬─────────┘     └──────────────────────┘              │\n42: │           │                                                     │\n43: │  ┌────────▼──────────────────────────────────────────────────┐  │\n44: │  │                       runtime/                         │  │\n45: │  │  ┌──────────┐ ┌──────────┐ ┌──────────────────────────┐   │  │\n46: │  │  │ hooks/   │ │handlers/ │ │           lib/           │   │  │\n47: │  │  │ claude/  │ │discovery │ │ validation / graph       │   │  │\n48: │  │  │ codex/   │ │save/     │ │ description / continuity │   │  │\n49: │  │  │ cursor/  │ │          │ │ resume / search          │   │  │\n50: │  │  │ devin/pi │ │          │ │                          │   │  │\n51: │  │  └──────────┘ └──────────┘ └──────────────────────────┘   │  │\n52: │  │  api/                   stress-test/                      │  │\n53: │  └─────────────────────────┬─────────────────────────────────┘  │\n54: │                            │                                    │\n55: │  ┌────────────────┐     ┌──┴──────────────┐                     │\n56: │  │   runtime/cli/     │     │    shared/      │                     │\n57: │  │ create.sh      │────▶│ embeddings.ts   │                     │\n58: │  │ validate.sh    │     │ trigger-extract │                     │\n59: │  │ generate-      │     │ chunking.ts     │                     │\n60: │  │ context.ts     │     │ algorithms/     │                     │\n61: │  │ evals/         │     │ scoring/        │                     │\n62: │  └────────────────┘     └─────────────────┘                     │\n63: │                                                                 │\n64: │  Dependency direction: runtime/cli/ ──▶ runtime/api/             │\n65: │                        runtime/ ──▶ shared/                  │\n66: │                        runtime/cli/ ──▶ shared/                     │\n67: │                                                                 │\n68: └─────────────────────────────────────────────────────────────────┘\n69: ```\n70: \n71: ---\n72: \n73: ## 2. PACKAGE TOPOLOGY\n74: \n75: ```text\n76: system-spec-kit/\n77: ├── runtime/cli/                # CLI generation, validation, indexing, evals\n78: ├── runtime/             # Spec-kit engine, consumed as a library\n79: │   ├── api/                # Public barrel for the scripts workspace\n80: │   ├── handlers/           # Spec-document discovery and the save-path folder mutex\n81: │   ├── lib/                # Validation, graph metadata, description, continuity, resume\n82: │   ├── hooks/              # Per-runtime hook adapters and the shared spec-gate core\n83: │   ├── core/               # Runtime path and config resolution\n84: │   ├── data/               # Committed trigger index the Gate 1 lookup reads\n85: │   ├── runtime/cli/            # Build finalizer, metadata repair, test runners\n86: │   ├── tests/              # Vitest coverage\n87: │   └── stress-test/        # Opt-in load and contention suites\n88: ├── shared/                 # Neutral modules importable by scripts + engine\n89: ├── templates/              # Level contract and document templates\n90: ├── references/             # Workflow contracts and playbooks\n91: └── feature-catalog/        # Capability inventory\n92: ```\n93: \n94: Allowed dependency direction:\n95: \n96: - `runtime/cli/ ──▶ runtime/api/`\n97: - `runtime/ ──▶ shared/`\n98: - `runtime/cli/ ──▶ shared/`\n99: \n100: Reverse imports are blocked by lint and CI. Imports that reach past `runtime/api/` into `lib/`, `core/` or `handlers/` are rejected by the import-policy checks in `runtime/cli/evals/` unless they carry a governed allowlist entry.\n101: \n102: ---\n103: \n104: ## 3. CANONICAL CONTINUITY FLOWS\n105: \n106: Spec-kit treats canonical spec documents as the durable continuity record. The generated trigger index is a lookup surface over that record, not the record itself.\n107: \n108: **Read path (`/speckit:resume`):**\n109: \n110: 1. Resolve the requested spec folder, following a valid phase-parent `derived.last_active_child_id` into a child before reading continuity.\n111: 2. Look for `handover.md` at the resolved folder root.\n112: 3. Fall back to `_memory.continuity` frontmatter blocks inside `implementation-summary.md`.\n113: 4. Fall back to canonical spec docs in this order: `implementation-summary.md`, `tasks.md`, `plan.md`, `spec.md`.\n114: \n115: **Write path (`/speckit:save`):**\n116: \n117: 1. AI composes structured JSON describing session context.\n118: 2. `generate-context.js` routes content into the right canonical doc (`implementation-summary.md`, `decision-record.md`, `handover.md`) and refreshes `description.json` + `graph-metadata.json`.\n119: 3. There is no second write lane. `generate-context.js` is the only writer of `_memory.continuity`, and it keeps the atomic same-directory update and lock semantics that made a separate indexing call unnecessary.\n120: 4. Regenerate `runtime/data/trigger-index.json` when a document's `trigger_phrases` changed; nothing else is indexed.\n121: \n122: **Key modules:**\n123: \n124: - `/speckit:resume` owns the read path, walking the continuity ladder above.\n125: - `runtime/cli/dist/continuity/generate-context.js` owns the write path.\n126: - `runtime/cli/retrieval/generate-trigger-index.mjs` builds the lookup surface; `runtime/cli/retrieval/lookup-trigger-index.mjs` reads it.\n127: \n128: ---\n129: \n130: ## 4. RUNTIME SUBSYSTEMS\n131: \n132: The engine is composed of focused subsystems that share a public barrel and a filesystem contract.\n133: \n134: **Validation.** `lib/validation/orchestrator.ts` owns every spec folder rule verdict. `runtime/cli/spec/validate.sh` is a thin front end over its compiled output and implements no rules of its own; it refuses to run against a stale build rather than returning a stale verdict. `lib/templates/level-contract-resolver.ts` supplies the per-level document contract, and `lib/spec/is-phase-parent.ts` is the single detection rule for phase parents.\n135: \n136: **Generated packet metadata.** `lib/graph/` and `lib/description/` derive, merge, validate and serialize the two generated JSON files a spec folder carries — `description.json` and `graph-metadata.json`. Reads and writes stay split: the parser writes, while the integrity and drift gates only report, so a check cannot dirty the files it exists to keep clean. `lib/description/packet-synopsis.ts` is the one shared extractor behind both generated summary fields, so they cannot drift from the same `spec.md`.\n137: \n138: **Discovery and continuity.** `handlers/spec-doc-discovery.ts` walks the filesystem for canonical spec documents and detects a folder's level; `lib/discovery/` re-exports it as a seam so `lib/` code depends inward rather than reaching sideways. `lib/continuity/` owns the bounded continuity record and `lib/resume/` builds the ladder a resume walks.\n139: \n140: **Hook adapters.** `hooks/{claude,codex,cursor,devin,pi}/` translate each runtime's payload onto shared implementations and emit that runtime's own envelope shape. Policy stays in `hooks/lib/spec-gate/spec-gate-core.mjs`, so the core never changes for a new runtime, and `lib/hooks/completion-evidence-sentinel.cjs` holds the runtime-neutral completion-evidence decision.\n141: \n142: **Public surface.** `api/index.ts` is the supported import surface. Every export has a named caller in the scripts workspace.\n143: \n144: **Stress tests.** `stress-test/` carries opt-in load and contention suites, excluded from the default test config and run through `vitest.stress.config.ts`.\n145: \n146: ### Ownership of the surfaces the memory store used to touch\n147: \n148: The retired store left names behind that now mean different things. This table is the\n149: single answer to \"who owns this now\"; a producer, test, doctor route or gate that\n150: disagrees with it is the thing to fix.\n151: \n152: | Surface | Owner today | What it is |\n153: |---------|-------------|------------|\n154: | `runtime/data/trigger-index.json` | `runtime/cli/retrieval/generate-trigger-index.mjs` (writer), `lookup-trigger-index.mjs` (reader) | The committed Gate 1 retrieval index over author-declared trigger phrases |\n155: | `runtime/database/` | The HF model server in `.opencode/bin` | Its sockets, leases and logs; no index, no database of ours |\n156: | `MEMORY_DB_PATH`, `SPEC_KIT_DB_DIR` | `shared/paths.ts` and `shared/embeddings/` for the skill advisor | The advisor's own embedding store location; nothing in this skill opens a database |\n157: | `.opencode/skills/system-skill-advisor/mcp-server/database/` | The skill advisor | Its routing graph and doctor state; the only MCP daemon this repository still runs |\n158: | `.opencode/skills/system-deep-loop/runtime/database/` | The deep-loop runtime | Coverage and council graphs for research, review and council loops |\n159: | `runtime/cli/dist/continuity/generate-context.js`, `/speckit:save`, `/speckit:search` | The scripts workspace | The continuity writer and the retrieval commands; \"memory\" here is the command family's literal name, not a store |\n160: | `shared/ipc/`, `@modelcontextprotocol/sdk` in `shared/` | The skill advisor daemon through `shared/ipc` | The IPC seam the advisor's MCP transport is built on |\n161: \n162: ---\n163: \n164: ## 5. HOOK AND PLUGIN INTEGRATION\n165: \n166: Spec-kit ships a runtime hook surface that wires into each AI client's session lifecycle. The hooks emit compact context payloads at `SessionStart`, `UserPromptSubmit`, and (where supported) `Compact`.\n167: \n168: **Hook matrix.** Claude Code injects prompt-time briefs directly. OpenCode supports native `SessionStart` and `UserPromptSubmit` hooks when `[features].opencode_hooks = true` in `~/opencode.json` and `~/.opencode/hooks.json` is wired. OpenCode delivers context through local plugins under `.opencode/plugins/`.\n169: \n170: **Plugin bridges and local plugins.** Bridge-backed OpenCode plugin entrypoints live under `.opencode/plugins/` and import thin helpers that call into `runtime/lib/hooks/` or sibling daemon surfaces. Standalone local plugins such as `.opencode/plugins/opencode-goal.js` stay in the same plugin directory but own their state and hooks directly instead of using a daemon bridge.\n171: \n172: **Payload shape.** Hooks share the same compact JSON payload (`bootstrap.json` style) across runtimes so callers can rely on consistent fields regardless of transport.\n173: \n174: ---\n175: \n176: ## 6. ENFORCEMENT AND VERIFICATION\n177: \n178: Spec-kit's quality gates run at three layers.\n179: \n180: **Spec folder validation.** `runtime/cli/spec/validate.sh` enforces 20 rules across required files, anchor structure, frontmatter shape, template source markers, continuity freshness, and phase-parent detection. Strict mode treats warnings as failures.\n181: \n182: **Save gate.** Every `/speckit:save` runs through 3 layers: intake validation (input schema + duplicate detection), content router (places content in the right canonical doc), and post-save quality review (DQI scoring + structural lint).\n183: \n184: **Test surfaces.** Default `npm test` runs the engine suites through the bounded runner in `runtime/scripts/run-tests.mjs` and, through `runtime/package.json` `test:spec-validation`, the tracked spec-validation shell suites. Stress suites are opt-in via `vitest run --config vitest.stress.config.ts`.\n185: \n186: ---\n187: \n188: ## 7. DECISION RECORDS\n189: \n190: | ADR | Subject | Status |\n191: |---|---|---|\n192: | ADR-001 | Canonical continuity surfaces own the durable record; generated memory is search-only | Accepted |\n193: | ADR-002 | Phase parents validate as the lean trio (spec + description + graph-metadata) | Accepted |\n194: | ADR-005 | 4-level documentation contract (Levels 1, 2, 3, 3+) with manifest templates | Accepted |\n195: | ADR-006 | Save gate runs 3 layers (intake, router, quality review) on every save | Accepted |\n196: | ADR-007 | Embedding provider auto-cascade is local-first (Ollama → hf-local → OpenAI → Voyage), per ADR-014 | Accepted |\n197: \n198: ---\n199: \n200: ## 8. RELATED\n201: \n202: - [README.md](./README.md): Human-facing package overview\n203: - [SKILL.md](./SKILL.md): Runtime routing and invariants\n204: - [feature-catalog/feature-catalog.md](./feature-catalog/feature-catalog.md): Current feature inventory\n205: - [manual-testing-playbook/manual-testing-playbook.md](./manual-testing-playbook/manual-testing-playbook.md): Operator validation scenarios\n206: - [runtime/README.md](./runtime/README.md): Runtime package details\n207: - [references/](./references/): Workflow contracts, hook references, validation playbooks\n\n(End of file - total 207 lines)\n</content>","metadata":{"preview":"---\ntitle: \"Architecture: system-spec-kit\"\ndescription: \"Current package architecture for system-spec-kit: scripts, runtime engine, shared modules, canonical continuity flows, hook matrix, validators.\"\ntrigger_phrases:\n  - \"system spec kit architecture\"\n  - \"spec kit architecture\"\n  - \"canonical continuity architecture\"\n  - \"resume ladder\"\n  - \"spec-kit runtime subsystems\"\nimportance_tier: \"important\"\n---\n\n# Architecture: system-spec-kit\n\n> Current-reality architecture for the `system-spec-kit` package. Authored code lives in `runtime/cli/`, `runtime/`, and `shared/`. Continuity is rebuilt through `/speckit:resume` and canonical spec documents.\n\n---\n\n## 1. OVERVIEW\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/ARCHITECTURE.md","text":"---\ntitle: \"Architecture: system-spec-kit\"\ndescription: \"Current package architecture for system-spec-kit: scripts, runtime engine, shared modules, canonical continuity flows, hook matrix, validators.\"\ntrigger_phrases:\n  - \"system spec kit architecture\"\n  - \"spec kit architecture\"\n  - \"canonical continuity architecture\"\n  - \"resume ladder\"\n  - \"spec-kit runtime subsystems\"\nimportance_tier: \"important\"\n---\n\n# Architecture: system-spec-kit\n\n> Current-reality architecture for the `system-spec-kit` package. Authored code lives in `runtime/cli/`, `runtime/`, and `shared/`. Continuity is rebuilt through `/speckit:resume` and canonical spec documents.\n\n---\n\n## 1. OVERVIEW\n\n`system-spec-kit` is split into three authored zones plus generated build output:\n\n- `runtime/cli/` owns CLI generation, validation, indexing, evals, and packet tooling. TypeScript and shell.\n- `runtime/` owns the spec-kit engine: spec folder validation, generated packet metadata, description generation, and the per-runtime hook adapters. It is consumed as a library, not run as a service. TypeScript.\n- `shared/` owns neutral modules imported by both scripts and the engine. TypeScript.\n- Each zone carries its own generated `dist/`, gitignored and rebuilt from source. Not authored.\n\nThe package's operator-facing recovery surface is `/speckit:resume`. The recovery chain reads `handover.md`, then `_memory.continuity`, then canonical spec docs (`implementation-summary.md`, `tasks.md`, `plan.md`, `spec.md`). Generated memory artifacts are supporting context only, not the primary continuity record.\n\n### Architecture diagram\n\n```text\n┌─────────────────────────────────────────────────────────────────┐\n│                  SYSTEM-SPEC-KIT PACKAGE                        │\n├─────────────────────────────────────────────────────────────────┤\n│                                                                 │\n│  ┌──────────────────┐     ┌──────────────────────┐              │\n│  │   CLI Runtimes   │     │      AI Agents       │              │\n│  │ Claude / OpenCode   │────▶│  (Gate 1/2/3 flow)   │               │\n│  │ OpenCode         │     │                      │              │\n│  └────────┬─────────┘     └──────────────────────┘              │\n│           │                                                     │\n│  ┌────────▼──────────────────────────────────────────────────┐  │\n│  │                       runtime/                         │  │\n│  │  ┌──────────┐ ┌──────────┐ ┌──────────────────────────┐   │  │\n│  │  │ hooks/   │ │handlers/ │ │           lib/           │   │  │\n│  │  │ claude/  │ │discovery │ │ validation / graph       │   │  │\n│  │  │ codex/   │ │save/     │ │ description / continuity │   │  │\n│  │  │ cursor/  │ │          │ │ resume / search          │   │  │\n│  │  │ devin/pi │ │          │ │                          │   │  │\n│  │  └──────────┘ └──────────┘ └──────────────────────────┘   │  │\n│  │  api/                   stress-test/                      │  │\n│  └─────────────────────────┬─────────────────────────────────┘  │\n│                            │                                    │\n│  ┌────────────────┐     ┌──┴──────────────┐                     │\n│  │   runtime/cli/     │     │    shared/      │                     │\n│  │ create.sh      │────▶│ embeddings.ts   │                     │\n│  │ validate.sh    │     │ trigger-extract │                     │\n│  │ generate-      │     │ chunking.ts     │                     │\n│  │ context.ts     │     │ algorithms/     │                     │\n│  │ evals/         │     │ scoring/        │                     │\n│  └────────────────┘     └─────────────────┘                     │\n│                                                                 │\n│  Dependency direction: runtime/cli/ ──▶ runtime/api/             │\n│                        runtime/ ──▶ shared/                  │\n│                        runtime/cli/ ──▶ shared/                     │\n│                                                                 │\n└─────────────────────────────────────────────────────────────────┘\n```\n\n---\n\n## 2. PACKAGE TOPOLOGY\n\n```text\nsystem-spec-kit/\n├── runtime/cli/                # CLI generation, validation, indexing, evals\n├── runtime/             # Spec-kit engine, consumed as a library\n│   ├── api/                # Public barrel for the scripts workspace\n│   ├── handlers/           # Spec-document discovery and the save-path folder mutex\n│   ├── lib/                # Validation, graph metadata, description, continuity, resume\n│   ├── hooks/              # Per-runtime hook adapters and the shared spec-gate core\n│   ├── core/               # Runtime path and config resolution\n│   ├── data/               # Committed trigger index the Gate 1 lookup reads\n│   ├── runtime/cli/            # Build finalizer, metadata repair, test runners\n│   ├── tests/              # Vitest coverage\n│   └── stress-test/        # Opt-in load and contention suites\n├── shared/                 # Neutral modules importable by scripts + engine\n├── templates/              # Level contract and document templates\n├── references/             # Workflow contracts and playbooks\n└── feature-catalog/        # Capability inventory\n```\n\nAllowed dependency direction:\n\n- `runtime/cli/ ──▶ runtime/api/`\n- `runtime/ ──▶ shared/`\n- `runtime/cli/ ──▶ shared/`\n\nReverse imports are blocked by lint and CI. Imports that reach past `runtime/api/` into `lib/`, `core/` or `handlers/` are rejected by the import-policy checks in `runtime/cli/evals/` unless they carry a governed allowlist entry.\n\n---\n\n## 3. CANONICAL CONTINUITY FLOWS\n\nSpec-kit treats canonical spec documents as the durable continuity record. The generated trigger index is a lookup surface over that record, not the record itself.\n\n**Read path (`/speckit:resume`):**\n\n1. Resolve the requested spec folder, following a valid phase-parent `derived.last_active_child_id` into a child before reading continuity.\n2. Look for `handover.md` at the resolved folder root.\n3. Fall back to `_memory.continuity` frontmatter blocks inside `implementation-summary.md`.\n4. Fall back to canonical spec docs in this order: `implementation-summary.md`, `tasks.md`, `plan.md`, `spec.md`.\n\n**Write path (`/speckit:save`):**\n\n1. AI composes structured JSON describing session context.\n2. `generate-context.js` routes content into the right canonical doc (`implementation-summary.md`, `decision-record.md`, `handover.md`) and refreshes `description.json` + `graph-metadata.json`.\n3. There is no second write lane. `generate-context.js` is the only writer of `_memory.continuity`, and it keeps the atomic same-directory update and lock semantics that made a separate indexing call unnecessary.\n4. Regenerate `runtime/data/trigger-index.json` when a document's `trigger_phrases` changed; nothing else is indexed.\n\n**Key modules:**\n\n- `/speckit:resume` owns the read path, walking the continuity ladder above.\n- `runtime/cli/dist/continuity/generate-context.js` owns the write path.\n- `runtime/cli/retrieval/generate-trigger-index.mjs` builds the lookup surface; `runtime/cli/retrieval/lookup-trigger-index.mjs` reads it.\n\n---\n\n## 4. RUNTIME SUBSYSTEMS\n\nThe engine is composed of focused subsystems that share a public barrel and a filesystem contract.\n\n**Validation.** `lib/validation/orchestrator.ts` owns every spec folder rule verdict. `runtime/cli/spec/validate.sh` is a thin front end over its compiled output and implements no rules of its own; it refuses to run against a stale build rather than returning a stale verdict. `lib/templates/level-contract-resolver.ts` supplies the per-level document contract, and `lib/spec/is-phase-parent.ts` is the single detection rule for phase parents.\n\n**Generated packet metadata.** `lib/graph/` and `lib/description/` derive, merge, validate and serialize the two generated JSON files a spec folder carries — `description.json` and `graph-metadata.json`. Reads and writes stay split: the parser writes, while the integrity and drift gates only report, so a check cannot dirty the files it exists to keep clean. `lib/description/packet-synopsis.ts` is the one shared extractor behind both generated summary fields, so they cannot drift from the same `spec.md`.\n\n**Discovery and continuity.** `handlers/spec-doc-discovery.ts` walks the filesystem for canonical spec documents and detects a folder's level; `lib/discovery/` re-exports it as a seam so `lib/` code depends inward rather than reaching sideways. `lib/continuity/` owns the bounded continuity record and `lib/resume/` builds the ladder a resume walks.\n\n**Hook adapters.** `hooks/{claude,codex,cursor,devin,pi}/` translate each runtime's payload onto shared implementations and emit that runtime's own envelope shape. Policy stays in `hooks/lib/spec-gate/spec-gate-core.mjs`, so the core never changes for a new runtime, and `lib/hooks/completion-evidence-sentinel.cjs` holds the runtime-neutral completion-evidence decision.\n\n**Public surface.** `api/index.ts` is the supported import surface. Every export has a named caller in the scripts workspace.\n\n**Stress tests.** `stress-test/` carries opt-in load and contention suites, excluded from the default test config and run through `vitest.stress.config.ts`.\n\n### Ownership of the surfaces the memory store used to touch\n\nThe retired store left names behind that now mean different things. This table is the\nsingle answer to \"who owns this now\"; a producer, test, doctor route or gate that\ndisagrees with it is the thing to fix.\n\n| Surface | Owner today | What it is |\n|---------|-------------|------------|\n| `runtime/data/trigger-index.json` | `runtime/cli/retrieval/generate-trigger-index.mjs` (writer), `lookup-trigger-index.mjs` (reader) | The committed Gate 1 retrieval index over author-declared trigger phrases |\n| `runtime/database/` | The HF model server in `.opencode/bin` | Its sockets, leases and logs; no index, no database of ours |\n| `MEMORY_DB_PATH`, `SPEC_KIT_DB_DIR` | `shared/paths.ts` and `shared/embeddings/` for the skill advisor | The advisor's own embedding store location; nothing in this skill opens a database |\n| `.opencode/skills/system-skill-advisor/mcp-server/database/` | The skill advisor | Its routing graph and doctor state; the only MCP daemon this repository still runs |\n| `.opencode/skills/system-deep-loop/runtime/database/` | The deep-loop runtime | Coverage and council graphs for research, review and council loops |\n| `runtime/cli/dist/continuity/generate-context.js`, `/speckit:save`, `/speckit:search` | The scripts workspace | The continuity writer and the retrieval commands; \"memory\" here is the command family's literal name, not a store |\n| `shared/ipc/`, `@modelcontextprotocol/sdk` in `shared/` | The skill advisor daemon through `shared/ipc` | The IPC seam the advisor's MCP transport is built on |\n\n---\n\n## 5. HOOK AND PLUGIN INTEGRATION\n\nSpec-kit ships a runtime hook surface that wires into each AI client's session lifecycle. The hooks emit compact context payloads at `SessionStart`, `UserPromptSubmit`, and (where supported) `Compact`.\n\n**Hook matrix.** Claude Code injects prompt-time briefs directly. OpenCode supports native `SessionStart` and `UserPromptSubmit` hooks when `[features].opencode_hooks = true` in `~/opencode.json` and `~/.opencode/hooks.json` is wired. OpenCode delivers context through local plugins under `.opencode/plugins/`.\n\n**Plugin bridges and local plugins.** Bridge-backed OpenCode plugin entrypoints live under `.opencode/plugins/` and import thin helpers that call into `runtime/lib/hooks/` or sibling daemon surfaces. Standalone local plugins such as `.opencode/plugins/opencode-goal.js` stay in the same plugin directory but own their state and hooks directly instead of using a daemon bridge.\n\n**Payload shape.** Hooks share the same compact JSON payload (`bootstrap.json` style) across runtimes so callers can rely on consistent fields regardless of transport.\n\n---\n\n## 6. ENFORCEMENT AND VERIFICATION\n\nSpec-kit's quality gates run at three layers.\n\n**Spec folder validation.** `runtime/cli/spec/validate.sh` enforces 20 rules across required files, anchor structure, frontmatter shape, template source markers, continuity freshness, and phase-parent detection. Strict mode treats warnings as failures.\n\n**Save gate.** Every `/speckit:save` runs through 3 layers: intake validation (input schema + duplicate detection), content router (places content in the right canonical doc), and post-save quality review (DQI scoring + structural lint).\n\n**Test surfaces.** Default `npm test` runs the engine suites through the bounded runner in `runtime/scripts/run-tests.mjs` and, through `runtime/package.json` `test:spec-validation`, the tracked spec-validation shell suites. Stress suites are opt-in via `vitest run --config vitest.stress.config.ts`.\n\n---\n\n## 7. DECISION RECORDS\n\n| ADR | Subject | Status |\n|---|---|---|\n| ADR-001 | Canonical continuity surfaces own the durable record; generated memory is search-only | Accepted |\n| ADR-002 | Phase parents validate as the lean trio (spec + description + graph-metadata) | Accepted |\n| ADR-005 | 4-level documentation contract (Levels 1, 2, 3, 3+) with manifest templates | Accepted |\n| ADR-006 | Save gate runs 3 layers (intake, router, quality review) on every save | Accepted |\n| ADR-007 | Embedding provider auto-cascade is local-first (Ollama → hf-local → OpenAI → Voyage), per ADR-014 | Accepted |\n\n---\n\n## 8. RELATED\n\n- [README.md](./README.md): Human-facing package overview\n- [SKILL.md](./SKILL.md): Runtime routing and invariants\n- [feature-catalog/feature-catalog.md](./feature-catalog/feature-catalog.md): Current feature inventory\n- [manual-testing-playbook/manual-testing-playbook.md](./manual-testing-playbook/manual-testing-playbook.md): Operator validation scenarios\n- [runtime/README.md](./runtime/README.md): Runtime package details\n- [references/](./references/): Workflow contracts, hook references, validation playbooks","lineStart":1,"lineEnd":207,"totalLines":207,"truncated":false}},"title":".opencode/skills/system-spec-kit/ARCHITECTURE.md","time":{"start":1788625032379,"end":1788625032382}},"id":"prt_0725c14b8001jFMezHspxojWtx","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0725b8fe0001Tac0PZUBC884ER"}}
{"type":"tool_use","timestamp":1788625032480,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_KPTIOoZNdQ6PMW6E6o45Tc0C","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/shared/README.md","offset":1,"limit":230},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/shared/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Shared Library Modules\"\n3: description: \"Consolidated TypeScript modules shared between the CLI scripts workspace and the runtime package for embeddings, retrieval algorithms, contracts, config, and utility logic.\"\n4: trigger_phrases:\n5:   - \"shared library modules\"\n6:   - \"embeddings trigger extractor shared\"\n7:   - \"shared TypeScript modules\"\n8: ---\n9: \n10: # Shared Library Modules\n11: \n12: > Consolidated TypeScript modules shared between the CLI scripts workspace and the runtime package for embeddings, scoring, normalization, and utility logic. Source files are `.ts`. `shared/` builds as ESM (`package.json` sets `\"type\": \"module\"` and `tsconfig.json` uses NodeNext), with generated output in `shared/dist/`.\n13: \n14: ---\n15: \n16: ## 1. OVERVIEW\n17: \n18: ### What is the shared/ Directory?\n19: \n20: The `shared/` directory is the **canonical source** for shared modules used by:\n21: - **CLI scripts** (`runtime/cli/`) - `generate-context.ts` and other utilities\n22: - **The spec-kit engine** (`runtime/`) - validation orchestrator, generated metadata and the runtime hook adapters\n23: - **The skill advisor** - the embedding stack's only consumer today, via the `@spec-kit/shared/embeddings/*` alias\n24: \n25: This consolidation eliminates code duplication and ensures consistent behavior across all entry points.\n26: These modules support packet-doc-first continuity: `/speckit:resume`, implemented by `.opencode/commands/speckit/resume.md`, rebuilds active context from `handover.md -> _memory.continuity -> spec docs`, while generated continuity support artifacts remain supporting search material.\n27: \n28: ### Architecture\n29: \n30: ```\n31: ┌──────────────────────────────────────────────────────────────────┐\n32: │                     SHARED LIB ARCHITECTURE                      │\n33: ├──────────────────────────────────────────────────────────────────┤\n34: │                                                                  │\n35: │              ┌────────────────────┐                              │\n36: │              │  shared/           │ ◄── CANONICAL SOURCE (.ts)   │\n37: │              │  ├── embeddings.ts │                              │\n38: │              │  ├── chunking.ts   │                              │\n39: │              │  ├── trigger-      │                              │\n40: │              │  │   extractor.ts  │                              │\n41: │              │  └── embeddings/   │ ◄── Provider implementations │\n42: │              └────────────────────┘                              │\n43: │                       ▲                                          │\n44: │           ┌───────────┴───────────────────┐                      │\n45: │           │                               │                      │\n46: │    ┌──────┴──────┐                 ┌──────┴──────┐               │\n47: │    │runtime/cli/lib  │                 │runtime/  │               │\n48: │    │(RE-EXPORTS) │                 │lib/         │               │\n49: │    ├─────────────┤                 │(RE-EXPORTS) │               │\n50: │    │embeddings.ts│                 ├─────────────┤               │\n51: │    │ export *    │                 │embeddings.ts│               │\n52: │    │ from '@spec-│                 │ explicit    │               │\n53: │    │ kit/shared/ │                 │ named re-   │               │\n54: │    │ embeddings' │                 │ exports     │               │\n55: │    └─────────────┘                 │ from shared │               │\n56: │                                    └─────────────┘               │\n57: │                                                                  │\n58: │  Note: Source is TypeScript (.ts) and output is ESM (.js)         │\n59: │  in shared/dist via `tsc -b` with NodeNext module resolution.    │\n60: │                                                                  │\n61: └──────────────────────────────────────────────────────────────────┘\n62: ```\n63: \n64: ### Key Statistics\n65: \n66: | Category                 | Count         | Details                                          |\n67: | ------------------------ | ------------- | ------------------------------------------------ |\n68: | Top-Level TS Modules     | 14            | index, embeddings, chunking, trigger extractor, types, normalization, config, paths, budget allocator, compact merger, context types, code graph contracts, gate 3 classifier, unicode normalization |\n69: | Top-Level Subdirectories | 11            | algorithms, contracts, dist, embeddings, ipc, lib, parsing, predicates, ranking, scoring, utils |\n70: | Provider Implementations | 5             | Voyage, OpenAI, ollama, HF Local, auto |\n71: | Embedding Dimensions     | 768/1024/1536 | 768 default (ollama and HF Local); 1024 (Voyage); 1536 (OpenAI) |\n72: \n73: ### Key Features\n74: \n75: | Feature                         | Description                                                    |\n76: | ------------------------------- | -------------------------------------------------------------- |\n77: | **Multi-Provider Embeddings**   | Supports ollama, HuggingFace local, OpenAI, and Voyage with local-first auto-cascade selection |\n78: | **Dynamic Dimension Detection** | 768 (ollama and HF Local), 1024 (Voyage), 1536/3072 (OpenAI) |\n79: | **Task-Specific Functions**     | Document, query and clustering embeddings                      |\n80: | **TF-IDF + Semantic Triggers**  | Advanced trigger phrase extraction (v11)                       |\n81: | **Adaptive Fusion Support**     | Intent-aware weighting primitives a multi-channel ranker can consume; the skill advisor's 5-lane scorer is the caller today |\n82: | **7 Intent Profiles**           | Task-specific weight profiles: add_feature, fix_bug, refactor, security_audit, understand, find_spec, find_decision |\n83: \n84: ### Requirements\n85: \n86: | Requirement          | Minimum | Recommended |\n87: | -------------------- | ------- | ----------- |\n88: | Node.js              | >=20.11.0 | >=20.11.0  |\n89: | @huggingface/transformers | 2.0+    | Latest      |\n90: \n91: ---\n92: \n93: ## 1B. BOUNDARY AND IMPORT POLICY\n94: \n95: `shared/` is the canonical source for modules consumed by **both** `runtime/cli/` and `runtime/`.\n96: \n97: - **Import convention**: Consumers should import via `@spec-kit/shared/*` path alias\n98: - **Stability**: Shared modules must be stable because breaking changes require coordination with both consumers\n99: - **New modules**: Document purpose and consumer expectations before adding\n100: - **Ownership**: See [Architecture Boundaries](../ARCHITECTURE.md) for the full dependency matrix\n101: \n102: ---\n103: \n104: ## 2. QUICK START\n105: \n106: ### 30-Second Setup\n107: \n108: ```typescript\n109: // From CLI scripts (runtime/cli/*.ts)\n110: import { generateEmbedding } from '@spec-kit/shared/embeddings'\n111: import { extractTriggerPhrases } from '@spec-kit/shared/trigger-extractor'\n112: \n113: // From the runtime package (runtime/*.ts)\n114: import { generateEmbedding } from '@spec-kit/shared/embeddings'\n115: import { extractTriggerPhrases } from '@spec-kit/shared/trigger-extractor'\n116: ```\n117: \n118: ### Verify Installation\n119: \n120: ```bash\n121: # Check that all modules exist\n122: ls .opencode/skills/system-spec-kit/shared/\n123: \n124: # Expected source files:\n125: # index.ts, types.ts, config.ts, paths.ts\n126: # embeddings.ts, chunking.ts, trigger-extractor.ts\n127: # budget-allocator.ts, compact-merger.ts, code-graph-contracts.ts\n128: # context-types.ts, gate-3-classifier.ts, unicode-normalization.ts\n129: # algorithms/, contracts/, embeddings/, ipc/, lib/, parsing/, predicates/\n130: # ranking/, scoring/, utils/\n131: # Compiled output is written to shared/dist/\n132: ```\n133: \n134: ### First Use\n135: \n136: ```typescript\n137: import { generateDocumentEmbedding, getProviderMetadata } from '@spec-kit/shared/embeddings'\n138: \n139: // Check active provider\n140: const meta: { provider: string, model: string, dim: number, healthy: boolean } = getProviderMetadata()\n141: console.log(`Provider: ${meta.provider}, Dimensions: ${meta.dim}`)\n142: // Example: \"Provider: ollama, Dimensions: 768\"\n143: \n144: // Generate an embedding\n145: const embedding: Float32Array = await generateDocumentEmbedding('How does authentication work?')\n146: console.log(`Embedding dimensions: ${embedding.length}`)\n147: ```\n148: \n149: ---\n150: \n151: ## 3. STRUCTURE\n152: \n153: ```\n154: shared/\n155: ├── index.ts                    # Barrel exports for all shared modules\n156: ├── budget-allocator.ts         # Prompt/token budget allocation helpers\n157: ├── types.ts                    # Shared type definitions\n158: ├── context-types.ts            # Shared context envelope type helpers\n159: ├── unicode-normalization.ts    # Unicode normalization helpers\n160: ├── config.ts                   # Shared DB directory resolution and update markers\n161: ├── paths.ts                    # Shared DB path resolution\n162: ├── embeddings.ts               # Multi-provider embedding generation\n163: ├── chunking.ts                 # Semantic chunking utilities\n164: ├── compact-merger.ts           # Compacted context merge helpers\n165: ├── code-graph-contracts.ts     # Code graph readiness and contract types\n166: ├── gate-3-classifier.ts        # File-modification Gate 3 classifier\n167: ├── trigger-extractor.ts        # Trigger phrase extraction\n168: ├── package.json                # @spec-kit/shared package manifest\n169: ├── tsconfig.json               # TypeScript project configuration\n170: ├── algorithms/                 # Shared retrieval fusion and reranking algorithms\n171: │   ├── adaptive-fusion.ts      # Intent-aware weighted RRF profiles\n172: │   ├── mmr-reranker.ts         # Diversity-aware reranking helpers\n173: │   ├── rrf-fusion.ts           # Reciprocal rank fusion primitives\n174: │   └── index.ts                # Algorithms barrel\n175: ├── contracts/\n176: │   └── retrieval-trace.ts      # Typed trace/envelope contracts for retrieval responses\n177: ├── embeddings/                 # Provider implementations and profile helpers\n178: │   ├── factory.ts              # Provider selection and auto-cascade\n179: │   ├── profile.ts              # Embedding profiles and DB path generation\n180: │   ├── README.md               # Embeddings factory documentation\n181: │   └── providers/\n182: │       ├── ollama.ts           # ollama local provider\n183: │       ├── hf-local.ts         # HuggingFace ONNX (fallback local provider)\n184: │       ├── openai.ts           # OpenAI embeddings API\n185: │       ├── voyage.ts           # Voyage AI (cloud opt-in)\n186: │       └── README.md           # Provider comparison and interface docs\n187: ├── lib/\n188: │   └── structure-aware-chunker.ts # Markdown-aware chunking helpers\n189: ├── ipc/\n190: │   └── socket-server.ts        # Shared IPC socket server helper\n191: ├── runtime/\n192: │   └── database/               # No source; a probe target for resolvePackageRoot() in config.ts\n193: │       └── README.md           # Directory contract\n194: ├── parsing/\n195: │   ├── memory-sufficiency.ts          # Memory sufficiency checks\n196: │   ├── memory-template-contract.ts    # Template contract validation for continuity support artifacts\n197: │   ├── quality-extractors.ts          # Quality score/flags extraction\n198: │   ├── quality-extractors.test.ts     # Parsing coverage for quality extraction\n199: │   ├── spec-doc-health.ts             # Spec document health checks\n200: │   └── spec-doc-health.test.ts        # Tests for spec document health checks\n201: ├── predicates/\n202: │   ├── boolean-expr.ts         # Boolean expression predicate helpers\n203: │   └── boolean-expr.test.ts    # Predicate parser tests\n204: ├── ranking/\n205: │   ├── learned-combiner.ts     # ML-based score combiner for retrieval ranking\n206: │   └── matrix-math.ts          # Matrix operations for ranking computations\n207: ├── scoring/\n208: │   ├── folder-scoring.ts       # Composite folder ranking logic\n209: │   └── README.md\n210: ├── utils/\n211: │   ├── path-security.ts        # Path validation and containment checks\n212: │   ├── retry.ts                # Retry/backoff classification logic\n213: │   ├── jsonc-strip.ts          # JSONC comment stripping helper\n214: │   ├── token-estimate.ts       # Shared token count estimation\n215: │   └── README.md\n216: ├── dist/                       # Compiled JS output\n217: └── README.md\n218: ```\n219: \n220: ### Key Files\n221: \n222: | File                    | Purpose                                             |\n223: | ----------------------- | --------------------------------------------------- |\n224: | `embeddings.ts` | Unified API for multi-provider embedding generation |\n225: | `trigger-extractor.ts` | Trigger phrase extraction for memory indexing |\n226: | `config.ts` | Shared DB directory resolution and update marker paths |\n227: | `paths.ts` | Provider-keyed database path resolution (encodes provider, model, dim and dtype in the filename) |\n228: | `budget-allocator.ts` | Prompt/token budget allocation helpers |\n229: | `compact-merger.ts` | Compacted context merge helpers |\n230: | `code-graph-contracts.ts` | Code graph readiness and contract types |\n\n(Showing lines 1-230 of 537. Use offset=231 to continue.)\n</content>","metadata":{"preview":"---\ntitle: \"Shared Library Modules\"\ndescription: \"Consolidated TypeScript modules shared between the CLI scripts workspace and the runtime package for embeddings, retrieval algorithms, contracts, config, and utility logic.\"\ntrigger_phrases:\n  - \"shared library modules\"\n  - \"embeddings trigger extractor shared\"\n  - \"shared TypeScript modules\"\n---\n\n# Shared Library Modules\n\n> Consolidated TypeScript modules shared between the CLI scripts workspace and the runtime package for embeddings, scoring, normalization, and utility logic. Source files are `.ts`. `shared/` builds as ESM (`package.json` sets `\"type\": \"module\"` and `tsconfig.json` uses NodeNext), with generated output in `shared/dist/`.\n\n---\n\n## 1. OVERVIEW\n\n### What is the shared/ Directory?\n\nThe `shared/` directory is the **canonical source** for shared modules used by:","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/shared/README.md","text":"---\ntitle: \"Shared Library Modules\"\ndescription: \"Consolidated TypeScript modules shared between the CLI scripts workspace and the runtime package for embeddings, retrieval algorithms, contracts, config, and utility logic.\"\ntrigger_phrases:\n  - \"shared library modules\"\n  - \"embeddings trigger extractor shared\"\n  - \"shared TypeScript modules\"\n---\n\n# Shared Library Modules\n\n> Consolidated TypeScript modules shared between the CLI scripts workspace and the runtime package for embeddings, scoring, normalization, and utility logic. Source files are `.ts`. `shared/` builds as ESM (`package.json` sets `\"type\": \"module\"` and `tsconfig.json` uses NodeNext), with generated output in `shared/dist/`.\n\n---\n\n## 1. OVERVIEW\n\n### What is the shared/ Directory?\n\nThe `shared/` directory is the **canonical source** for shared modules used by:\n- **CLI scripts** (`runtime/cli/`) - `generate-context.ts` and other utilities\n- **The spec-kit engine** (`runtime/`) - validation orchestrator, generated metadata and the runtime hook adapters\n- **The skill advisor** - the embedding stack's only consumer today, via the `@spec-kit/shared/embeddings/*` alias\n\nThis consolidation eliminates code duplication and ensures consistent behavior across all entry points.\nThese modules support packet-doc-first continuity: `/speckit:resume`, implemented by `.opencode/commands/speckit/resume.md`, rebuilds active context from `handover.md -> _memory.continuity -> spec docs`, while generated continuity support artifacts remain supporting search material.\n\n### Architecture\n\n```\n┌──────────────────────────────────────────────────────────────────┐\n│                     SHARED LIB ARCHITECTURE                      │\n├──────────────────────────────────────────────────────────────────┤\n│                                                                  │\n│              ┌────────────────────┐                              │\n│              │  shared/           │ ◄── CANONICAL SOURCE (.ts)   │\n│              │  ├── embeddings.ts │                              │\n│              │  ├── chunking.ts   │                              │\n│              │  ├── trigger-      │                              │\n│              │  │   extractor.ts  │                              │\n│              │  └── embeddings/   │ ◄── Provider implementations │\n│              └────────────────────┘                              │\n│                       ▲                                          │\n│           ┌───────────┴───────────────────┐                      │\n│           │                               │                      │\n│    ┌──────┴──────┐                 ┌──────┴──────┐               │\n│    │runtime/cli/lib  │                 │runtime/  │               │\n│    │(RE-EXPORTS) │                 │lib/         │               │\n│    ├─────────────┤                 │(RE-EXPORTS) │               │\n│    │embeddings.ts│                 ├─────────────┤               │\n│    │ export *    │                 │embeddings.ts│               │\n│    │ from '@spec-│                 │ explicit    │               │\n│    │ kit/shared/ │                 │ named re-   │               │\n│    │ embeddings' │                 │ exports     │               │\n│    └─────────────┘                 │ from shared │               │\n│                                    └─────────────┘               │\n│                                                                  │\n│  Note: Source is TypeScript (.ts) and output is ESM (.js)         │\n│  in shared/dist via `tsc -b` with NodeNext module resolution.    │\n│                                                                  │\n└──────────────────────────────────────────────────────────────────┘\n```\n\n### Key Statistics\n\n| Category                 | Count         | Details                                          |\n| ------------------------ | ------------- | ------------------------------------------------ |\n| Top-Level TS Modules     | 14            | index, embeddings, chunking, trigger extractor, types, normalization, config, paths, budget allocator, compact merger, context types, code graph contracts, gate 3 classifier, unicode normalization |\n| Top-Level Subdirectories | 11            | algorithms, contracts, dist, embeddings, ipc, lib, parsing, predicates, ranking, scoring, utils |\n| Provider Implementations | 5             | Voyage, OpenAI, ollama, HF Local, auto |\n| Embedding Dimensions     | 768/1024/1536 | 768 default (ollama and HF Local); 1024 (Voyage); 1536 (OpenAI) |\n\n### Key Features\n\n| Feature                         | Description                                                    |\n| ------------------------------- | -------------------------------------------------------------- |\n| **Multi-Provider Embeddings**   | Supports ollama, HuggingFace local, OpenAI, and Voyage with local-first auto-cascade selection |\n| **Dynamic Dimension Detection** | 768 (ollama and HF Local), 1024 (Voyage), 1536/3072 (OpenAI) |\n| **Task-Specific Functions**     | Document, query and clustering embeddings                      |\n| **TF-IDF + Semantic Triggers**  | Advanced trigger phrase extraction (v11)                       |\n| **Adaptive Fusion Support**     | Intent-aware weighting primitives a multi-channel ranker can consume; the skill advisor's 5-lane scorer is the caller today |\n| **7 Intent Profiles**           | Task-specific weight profiles: add_feature, fix_bug, refactor, security_audit, understand, find_spec, find_decision |\n\n### Requirements\n\n| Requirement          | Minimum | Recommended |\n| -------------------- | ------- | ----------- |\n| Node.js              | >=20.11.0 | >=20.11.0  |\n| @huggingface/transformers | 2.0+    | Latest      |\n\n---\n\n## 1B. BOUNDARY AND IMPORT POLICY\n\n`shared/` is the canonical source for modules consumed by **both** `runtime/cli/` and `runtime/`.\n\n- **Import convention**: Consumers should import via `@spec-kit/shared/*` path alias\n- **Stability**: Shared modules must be stable because breaking changes require coordination with both consumers\n- **New modules**: Document purpose and consumer expectations before adding\n- **Ownership**: See [Architecture Boundaries](../ARCHITECTURE.md) for the full dependency matrix\n\n---\n\n## 2. QUICK START\n\n### 30-Second Setup\n\n```typescript\n// From CLI scripts (runtime/cli/*.ts)\nimport { generateEmbedding } from '@spec-kit/shared/embeddings'\nimport { extractTriggerPhrases } from '@spec-kit/shared/trigger-extractor'\n\n// From the runtime package (runtime/*.ts)\nimport { generateEmbedding } from '@spec-kit/shared/embeddings'\nimport { extractTriggerPhrases } from '@spec-kit/shared/trigger-extractor'\n```\n\n### Verify Installation\n\n```bash\n# Check that all modules exist\nls .opencode/skills/system-spec-kit/shared/\n\n# Expected source files:\n# index.ts, types.ts, config.ts, paths.ts\n# embeddings.ts, chunking.ts, trigger-extractor.ts\n# budget-allocator.ts, compact-merger.ts, code-graph-contracts.ts\n# context-types.ts, gate-3-classifier.ts, unicode-normalization.ts\n# algorithms/, contracts/, embeddings/, ipc/, lib/, parsing/, predicates/\n# ranking/, scoring/, utils/\n# Compiled output is written to shared/dist/\n```\n\n### First Use\n\n```typescript\nimport { generateDocumentEmbedding, getProviderMetadata } from '@spec-kit/shared/embeddings'\n\n// Check active provider\nconst meta: { provider: string, model: string, dim: number, healthy: boolean } = getProviderMetadata()\nconsole.log(`Provider: ${meta.provider}, Dimensions: ${meta.dim}`)\n// Example: \"Provider: ollama, Dimensions: 768\"\n\n// Generate an embedding\nconst embedding: Float32Array = await generateDocumentEmbedding('How does authentication work?')\nconsole.log(`Embedding dimensions: ${embedding.length}`)\n```\n\n---\n\n## 3. STRUCTURE\n\n```\nshared/\n├── index.ts                    # Barrel exports for all shared modules\n├── budget-allocator.ts         # Prompt/token budget allocation helpers\n├── types.ts                    # Shared type definitions\n├── context-types.ts            # Shared context envelope type helpers\n├── unicode-normalization.ts    # Unicode normalization helpers\n├── config.ts                   # Shared DB directory resolution and update markers\n├── paths.ts                    # Shared DB path resolution\n├── embeddings.ts               # Multi-provider embedding generation\n├── chunking.ts                 # Semantic chunking utilities\n├── compact-merger.ts           # Compacted context merge helpers\n├── code-graph-contracts.ts     # Code graph readiness and contract types\n├── gate-3-classifier.ts        # File-modification Gate 3 classifier\n├── trigger-extractor.ts        # Trigger phrase extraction\n├── package.json                # @spec-kit/shared package manifest\n├── tsconfig.json               # TypeScript project configuration\n├── algorithms/                 # Shared retrieval fusion and reranking algorithms\n│   ├── adaptive-fusion.ts      # Intent-aware weighted RRF profiles\n│   ├── mmr-reranker.ts         # Diversity-aware reranking helpers\n│   ├── rrf-fusion.ts           # Reciprocal rank fusion primitives\n│   └── index.ts                # Algorithms barrel\n├── contracts/\n│   └── retrieval-trace.ts      # Typed trace/envelope contracts for retrieval responses\n├── embeddings/                 # Provider implementations and profile helpers\n│   ├── factory.ts              # Provider selection and auto-cascade\n│   ├── profile.ts              # Embedding profiles and DB path generation\n│   ├── README.md               # Embeddings factory documentation\n│   └── providers/\n│       ├── ollama.ts           # ollama local provider\n│       ├── hf-local.ts         # HuggingFace ONNX (fallback local provider)\n│       ├── openai.ts           # OpenAI embeddings API\n│       ├── voyage.ts           # Voyage AI (cloud opt-in)\n│       └── README.md           # Provider comparison and interface docs\n├── lib/\n│   └── structure-aware-chunker.ts # Markdown-aware chunking helpers\n├── ipc/\n│   └── socket-server.ts        # Shared IPC socket server helper\n├── runtime/\n│   └── database/               # No source; a probe target for resolvePackageRoot() in config.ts\n│       └── README.md           # Directory contract\n├── parsing/\n│   ├── memory-sufficiency.ts          # Memory sufficiency checks\n│   ├── memory-template-contract.ts    # Template contract validation for continuity support artifacts\n│   ├── quality-extractors.ts          # Quality score/flags extraction\n│   ├── quality-extractors.test.ts     # Parsing coverage for quality extraction\n│   ├── spec-doc-health.ts             # Spec document health checks\n│   └── spec-doc-health.test.ts        # Tests for spec document health checks\n├── predicates/\n│   ├── boolean-expr.ts         # Boolean expression predicate helpers\n│   └── boolean-expr.test.ts    # Predicate parser tests\n├── ranking/\n│   ├── learned-combiner.ts     # ML-based score combiner for retrieval ranking\n│   └── matrix-math.ts          # Matrix operations for ranking computations\n├── scoring/\n│   ├── folder-scoring.ts       # Composite folder ranking logic\n│   └── README.md\n├── utils/\n│   ├── path-security.ts        # Path validation and containment checks\n│   ├── retry.ts                # Retry/backoff classification logic\n│   ├── jsonc-strip.ts          # JSONC comment stripping helper\n│   ├── token-estimate.ts       # Shared token count estimation\n│   └── README.md\n├── dist/                       # Compiled JS output\n└── README.md\n```\n\n### Key Files\n\n| File                    | Purpose                                             |\n| ----------------------- | --------------------------------------------------- |\n| `embeddings.ts` | Unified API for multi-provider embedding generation |\n| `trigger-extractor.ts` | Trigger phrase extraction for memory indexing |\n| `config.ts` | Shared DB directory resolution and update marker paths |\n| `paths.ts` | Provider-keyed database path resolution (encodes provider, model, dim and dtype in the filename) |\n| `budget-allocator.ts` | Prompt/token budget allocation helpers |\n| `compact-merger.ts` | Compacted context merge helpers |\n| `code-graph-contracts.ts` | Code graph readiness and contract types |","lineStart":1,"lineEnd":230,"totalLines":537,"truncated":true}},"title":".opencode/skills/system-spec-kit/shared/README.md","time":{"start":1788625032470,"end":1788625032478}},"id":"prt_0725c14f9001ghRAkUXbep414l","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0725b8fe0001Tac0PZUBC884ER"}}
{"type":"tool_use","timestamp":1788625032579,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_GFBqj5sdyRSNHV9CQnmkW7PQ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/api/index.ts","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/api/index.ts</path>\n<type>file</type>\n<content>\n1: // ────────────────────────────────────────────────────────────────\n2: // MODULE: Index, Public API surface\n3: // ────────────────────────────────────────────────────────────────\n4: // @public, Only export what external consumers (scripts/, other packages) need.\n5: // Internal runtime code should import from lib/ directly, not through this barrel.\n6: // Consumer scripts import from '@spec-kit/runtime/api' instead of lib/.\n7: // Every export below has a named caller in the scripts workspace; adding one\n8: // without a caller re-widens the surface that made this package hard to shrink.\n9: \n10: export { refreshGraphMetadata } from './graph-refresh.js';\n11: \n12: // --- Spec folder identity and validation (used by scripts/spec-folder, scripts/graph) ---\n13: export {\n14:   canClassifyAsGraphMetadataPath,\n15:   resolveSpecFolderIdentity,\n16:   SpecFolderIdentityError,\n17: } from '../lib/config/spec-doc-paths.js';\n18: export type { SpecFolderIdentity } from '../lib/config/spec-doc-paths.js';\n19: export {\n20:   validateFolder,\n21:   type ValidateOpts,\n22:   type ValidationEntry,\n23:   type ValidationReport,\n24: } from '../lib/validation/orchestrator.js';\n25: export {\n26:   buildContinuityFingerprint,\n27:   ZERO_CONTINUITY_FINGERPRINT,\n28: } from '../lib/validation/spec-doc-structure.js';\n29: \n30: // --- Folder discovery (used by scripts/spec-folder, scripts/core, runtime/cli/continuity) ---\n31: export {\n32:   g