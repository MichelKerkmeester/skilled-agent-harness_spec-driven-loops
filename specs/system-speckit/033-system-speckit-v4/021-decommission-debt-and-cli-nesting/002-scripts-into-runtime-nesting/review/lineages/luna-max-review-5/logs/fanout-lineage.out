{"type":"tool_use","timestamp":1788625237991,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_7YvVZUHzJ2tP2EIPkOCx8gVY","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/spec-folder/generate-description.ts","offset":1,"limit":180},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/spec-folder/generate-description.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Generate Description\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────\n6: // 1. GENERATE DESCRIPTION\n7: // ───────────────────────────────────────────────────────────────\n8: // CLI: Generate Per-Folder description.json\n9: // Usage: node generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]\n10: //\n11: // If --description is provided, uses it directly + keyword extraction.\n12: // Otherwise reads spec.md via generatePerFolderDescription().\n13: \n14: import * as path from 'node:path';\n15: import * as fs from 'node:fs';\n16: import { fileURLToPath } from 'node:url';\n17: import {\n18:   generatePerFolderDescription,\n19:   savePerFolderDescription,\n20:   loadExistingDescription,\n21:   getRepairMergeSafe,\n22:   extractKeywords,\n23:   slugifyFolderName,\n24:   resolveSpecFolderIdentity,\n25:   SpecFolderIdentityError,\n26: } from '@spec-kit/runtime/api';\n27: import type { LoadResult, PerFolderDescription } from '@spec-kit/runtime/api';\n28: \n29: export { getRepairMergeSafe, loadExistingDescription };\n30: export type { LoadResult };\n31: \n32: const IDENTITY_MERGE_SAFETY_OPT_OUT = new Set(['false', '0', 'no', 'off', 'disabled']);\n33: \n34: function isIdentityMergeSafetyEnabled(): boolean {\n35:   const value = process.env.SPECKIT_IDENTITY_MERGE_SAFETY?.trim().toLowerCase();\n36:   return value === undefined || !IDENTITY_MERGE_SAFETY_OPT_OUT.has(value);\n37: }\n38: \n39: function resolveSpecFolderForDescription(folderPath: string, legacyValue: string): string {\n40:   if (isIdentityMergeSafetyEnabled()) {\n41:     try {\n42:       return resolveSpecFolderIdentity(folderPath).specFolder;\n43:     } catch (error: unknown) {\n44:       if (!(error instanceof SpecFolderIdentityError)) {\n45:         throw error;\n46:       }\n47:     }\n48:   }\n49:   return legacyValue;\n50: }\n51: \n52: const LEVEL_MARKER_RE = /<!--\\s*SPECKIT_LEVEL:\\s*(\\d\\+?)\\s*-->/;\n53: const LEVEL_MARKER_DOCS = ['spec.md', 'tasks.md', 'plan.md'];\n54: \n55: // The level is required of every description record, but it used to be written\n56: // only when the caller passed it explicitly. A folder generated without it was\n57: // born invalid, and regenerating a valid folder silently dropped the field and\n58: // broke it. So fall back to what the record already carries, then to the level\n59: // the packet's own documents declare, and only give up when neither exists.\n60: function resolveLevel(\n61:   folderPath: string,\n62:   explicitLevel: string | null,\n63:   existing: PerFolderDescription | null,\n64: ): string | null {\n65:   if (explicitLevel) return explicitLevel;\n66:   const carried = (existing as (PerFolderDescription & { level?: unknown }) | null)?.level;\n67:   if (typeof carried === 'string' && carried) return carried;\n68:   if (typeof carried === 'number') return String(carried);\n69:   for (const doc of LEVEL_MARKER_DOCS) {\n70:     try {\n71:       const match = fs.readFileSync(path.join(folderPath, doc), 'utf8').match(LEVEL_MARKER_RE);\n72:       if (match) return match[1];\n73:     } catch {\n74:       // Document absent or unreadable; try the next one.\n75:     }\n76:   }\n77:   return null;\n78: }\n79: \n80: function main(): void {\n81:   const args = process.argv.slice(2);\n82:   if (args.length < 2) {\n83:     console.error('Usage: generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]');\n84:     process.exit(1);\n85:   }\n86: \n87:   const folderPath = path.resolve(args[0]);\n88:   const basePath = path.resolve(args[1]);\n89: \n90:   // Path containment check — prevent directory traversal attacks.\n91:   // Try/catch guards against crash on broken symlinks (realpathSync throws ENOENT).\n92:   // Path.sep boundary prevents prefix bypass (e.g. /specs-evil passing for /specs).\n93:   let realFolder: string;\n94:   let realBase: string;\n95:   try {\n96:     realFolder = fs.realpathSync(folderPath);\n97:     realBase = fs.realpathSync(basePath);\n98:   } catch (err: unknown) {\n99:     console.error(`Error: cannot resolve real path — ${(err as NodeJS.ErrnoException).message}`);\n100:     process.exit(1);\n101:   }\n102:   if (!(realFolder === realBase || realFolder.startsWith(realBase + path.sep))) {\n103:     console.error(`Error: folder path escapes base path (${realFolder} not under ${realBase})`);\n104:     process.exit(1);\n105:   }\n106: \n107:   // Parse --description flag\n108:   let explicitDescription: string | null = null;\n109:   const descIdx = args.indexOf('--description');\n110:   if (descIdx !== -1 && args[descIdx + 1]) {\n111:     explicitDescription = args[descIdx + 1];\n112:   }\n113:   const levelIdx = args.indexOf('--level');\n114:   const explicitLevel = levelIdx !== -1 && args[levelIdx + 1] ? args[levelIdx + 1] : null;\n115: \n116:   let desc: PerFolderDescription | null;\n117: \n118:   if (explicitDescription) {\n119:     // Build from explicit description\n120:     const existing = loadExistingDescription(folderPath);\n121:     const existingData = existing.ok ? existing.data : null;\n122:     const folderName = path.basename(folderPath);\n123:     const numMatch = folderName.match(/^(\\d+)/);\n124:     const specId = numMatch ? numMatch[1] : '';\n125:     const folderSlug = slugifyFolderName(folderName);\n126: \n127:     const relativePath = path.relative(basePath, folderPath).replace(/\\\\/g, '/');\n128:     const normalizedRelativeFolder =\n129:       relativePath && !relativePath.startsWith('..') ? relativePath : folderName;\n130:     const specFolder = resolveSpecFolderForDescription(folderPath, normalizedRelativeFolder);\n131:     const parentChain = specFolder.split('/').filter(Boolean).slice(0, -1);\n132: \n133:     desc = {\n134:       specFolder,\n135:       description: explicitDescription.slice(0, 150),\n136:       keywords: extractKeywords(explicitDescription),\n137:       lastUpdated: new Date().toISOString(),\n138:       specId,\n139:       folderSlug,\n140:       parentChain,\n141:       memorySequence: existingData?.memorySequence ?? 0,\n142:       memoryNameHistory: existingData?.memoryNameHistory ?? [],\n143:       ...(() => {\n144:         const level = resolveLevel(folderPath, explicitLevel, existingData);\n145:         return level ? { level } : {};\n146:       })(),\n147:     };\n148:   } else {\n149:     // Generate from spec.md\n150:     desc = generatePerFolderDescription(folderPath, basePath);\n151:     if (desc) {\n152:       const prior = loadExistingDescription(folderPath);\n153:       const level = resolveLevel(folderPath, explicitLevel, prior.ok ? prior.data : null);\n154:       if (level) (desc as PerFolderDescription & { level?: string }).level = level;\n155:     }\n156:   }\n157: \n158:   if (!desc) {\n159:     console.error('Could not generate description (missing spec.md or unreadable content)');\n160:     process.exit(1);\n161:   }\n162: \n163:   savePerFolderDescription(desc, folderPath);\n164:   console.log(`description.json created in ${folderPath}`);\n165: }\n166: \n167: const IS_CLI_ENTRY = process.argv[1]\n168:   ? path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n169:   : false;\n170: \n171: if (IS_CLI_ENTRY) {\n172:   main();\n173: }\n\n(End of file - total 173 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────\n// MODULE: Generate Description\n// ───────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────\n// 1. GENERATE DESCRIPTION\n// ───────────────────────────────────────────────────────────────\n// CLI: Generate Per-Folder description.json\n// Usage: node generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]\n//\n// If --description is provided, uses it directly + keyword extraction.\n// Otherwise reads spec.md via generatePerFolderDescription().\n\nimport * as path from 'node:path';\nimport * as fs from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport {\n  generatePerFolderDescription,\n  savePerFolderDescription,\n  loadExistingDescription,","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/spec-folder/generate-description.ts","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Generate Description\n// ───────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────\n// 1. GENERATE DESCRIPTION\n// ───────────────────────────────────────────────────────────────\n// CLI: Generate Per-Folder description.json\n// Usage: node generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]\n//\n// If --description is provided, uses it directly + keyword extraction.\n// Otherwise reads spec.md via generatePerFolderDescription().\n\nimport * as path from 'node:path';\nimport * as fs from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport {\n  generatePerFolderDescription,\n  savePerFolderDescription,\n  loadExistingDescription,\n  getRepairMergeSafe,\n  extractKeywords,\n  slugifyFolderName,\n  resolveSpecFolderIdentity,\n  SpecFolderIdentityError,\n} from '@spec-kit/runtime/api';\nimport type { LoadResult, PerFolderDescription } from '@spec-kit/runtime/api';\n\nexport { getRepairMergeSafe, loadExistingDescription };\nexport type { LoadResult };\n\nconst IDENTITY_MERGE_SAFETY_OPT_OUT = new Set(['false', '0', 'no', 'off', 'disabled']);\n\nfunction isIdentityMergeSafetyEnabled(): boolean {\n  const value = process.env.SPECKIT_IDENTITY_MERGE_SAFETY?.trim().toLowerCase();\n  return value === undefined || !IDENTITY_MERGE_SAFETY_OPT_OUT.has(value);\n}\n\nfunction resolveSpecFolderForDescription(folderPath: string, legacyValue: string): string {\n  if (isIdentityMergeSafetyEnabled()) {\n    try {\n      return resolveSpecFolderIdentity(folderPath).specFolder;\n    } catch (error: unknown) {\n      if (!(error instanceof SpecFolderIdentityError)) {\n        throw error;\n      }\n    }\n  }\n  return legacyValue;\n}\n\nconst LEVEL_MARKER_RE = /<!--\\s*SPECKIT_LEVEL:\\s*(\\d\\+?)\\s*-->/;\nconst LEVEL_MARKER_DOCS = ['spec.md', 'tasks.md', 'plan.md'];\n\n// The level is required of every description record, but it used to be written\n// only when the caller passed it explicitly. A folder generated without it was\n// born invalid, and regenerating a valid folder silently dropped the field and\n// broke it. So fall back to what the record already carries, then to the level\n// the packet's own documents declare, and only give up when neither exists.\nfunction resolveLevel(\n  folderPath: string,\n  explicitLevel: string | null,\n  existing: PerFolderDescription | null,\n): string | null {\n  if (explicitLevel) return explicitLevel;\n  const carried = (existing as (PerFolderDescription & { level?: unknown }) | null)?.level;\n  if (typeof carried === 'string' && carried) return carried;\n  if (typeof carried === 'number') return String(carried);\n  for (const doc of LEVEL_MARKER_DOCS) {\n    try {\n      const match = fs.readFileSync(path.join(folderPath, doc), 'utf8').match(LEVEL_MARKER_RE);\n      if (match) return match[1];\n    } catch {\n      // Document absent or unreadable; try the next one.\n    }\n  }\n  return null;\n}\n\nfunction main(): void {\n  const args = process.argv.slice(2);\n  if (args.length < 2) {\n    console.error('Usage: generate-description.js <folder-path> <base-path> [--description \"text\"] [--level N]');\n    process.exit(1);\n  }\n\n  const folderPath = path.resolve(args[0]);\n  const basePath = path.resolve(args[1]);\n\n  // Path containment check — prevent directory traversal attacks.\n  // Try/catch guards against crash on broken symlinks (realpathSync throws ENOENT).\n  // Path.sep boundary prevents prefix bypass (e.g. /specs-evil passing for /specs).\n  let realFolder: string;\n  let realBase: string;\n  try {\n    realFolder = fs.realpathSync(folderPath);\n    realBase = fs.realpathSync(basePath);\n  } catch (err: unknown) {\n    console.error(`Error: cannot resolve real path — ${(err as NodeJS.ErrnoException).message}`);\n    process.exit(1);\n  }\n  if (!(realFolder === realBase || realFolder.startsWith(realBase + path.sep))) {\n    console.error(`Error: folder path escapes base path (${realFolder} not under ${realBase})`);\n    process.exit(1);\n  }\n\n  // Parse --description flag\n  let explicitDescription: string | null = null;\n  const descIdx = args.indexOf('--description');\n  if (descIdx !== -1 && args[descIdx + 1]) {\n    explicitDescription = args[descIdx + 1];\n  }\n  const levelIdx = args.indexOf('--level');\n  const explicitLevel = levelIdx !== -1 && args[levelIdx + 1] ? args[levelIdx + 1] : null;\n\n  let desc: PerFolderDescription | null;\n\n  if (explicitDescription) {\n    // Build from explicit description\n    const existing = loadExistingDescription(folderPath);\n    const existingData = existing.ok ? existing.data : null;\n    const folderName = path.basename(folderPath);\n    const numMatch = folderName.match(/^(\\d+)/);\n    const specId = numMatch ? numMatch[1] : '';\n    const folderSlug = slugifyFolderName(folderName);\n\n    const relativePath = path.relative(basePath, folderPath).replace(/\\\\/g, '/');\n    const normalizedRelativeFolder =\n      relativePath && !relativePath.startsWith('..') ? relativePath : folderName;\n    const specFolder = resolveSpecFolderForDescription(folderPath, normalizedRelativeFolder);\n    const parentChain = specFolder.split('/').filter(Boolean).slice(0, -1);\n\n    desc = {\n      specFolder,\n      description: explicitDescription.slice(0, 150),\n      keywords: extractKeywords(explicitDescription),\n      lastUpdated: new Date().toISOString(),\n      specId,\n      folderSlug,\n      parentChain,\n      memorySequence: existingData?.memorySequence ?? 0,\n      memoryNameHistory: existingData?.memoryNameHistory ?? [],\n      ...(() => {\n        const level = resolveLevel(folderPath, explicitLevel, existingData);\n        return level ? { level } : {};\n      })(),\n    };\n  } else {\n    // Generate from spec.md\n    desc = generatePerFolderDescription(folderPath, basePath);\n    if (desc) {\n      const prior = loadExistingDescription(folderPath);\n      const level = resolveLevel(folderPath, explicitLevel, prior.ok ? prior.data : null);\n      if (level) (desc as PerFolderDescription & { level?: string }).level = level;\n    }\n  }\n\n  if (!desc) {\n    console.error('Could not generate description (missing spec.md or unreadable content)');\n    process.exit(1);\n  }\n\n  savePerFolderDescription(desc, folderPath);\n  console.log(`description.json created in ${folderPath}`);\n}\n\nconst IS_CLI_ENTRY = process.argv[1]\n  ? path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n  : false;\n\nif (IS_CLI_ENTRY) {\n  main();\n}","lineStart":1,"lineEnd":173,"totalLines":173,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/spec-folder/generate-description.ts","time":{"start":1788625237965,"end":1788625237986}},"id":"prt_0725f37cb001CvigcTzWyXJbRG","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0725ee3df0010I194UXTwj8Z7u"}}
