{"type":"tool_use","timestamp":1788624896602,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_EB6D60bD1DwBjz0WTFZgr4kN","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/deep/assets/deep-review-auto.yaml","offset":1,"limit":1400},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/deep/assets/deep-review-auto.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n5: # ─────────────────────────────────────────────────────────────────\n6: role: Deep Review Loop Manager\n7: purpose: Iterative code/spec review with convergence detection across review dimensions\n8: action: Run deep-review loop from initialization through synthesis\n9: operating_mode:\n10:   workflow: iterative_loop\n11:   workflow_compliance: MANDATORY\n12:   workflow_execution: autonomous\n13:   approvals: none\n14:   tracking: progressive_review_state\n15:   validation: convergence_detection\n16: \n17: # ─────────────────────────────────────────────────────────────────\n18: # OPERATING PRINCIPLES\n19: # ─────────────────────────────────────────────────────────────────\n20: operating_principles:\n21:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n22:   approach: \"Dispatch focused review agent per dimension, evaluate convergence, repeat or stop\"\n23:   mandate: \"Never hold findings in memory; write everything to files. Review target is READ-ONLY.\"\n24: \n25: # ─────────────────────────────────────────────────────────────────\n26: # USER INPUTS (from setup phase)\n27: # ─────────────────────────────────────────────────────────────────\n28: user_inputs:\n29:   review_target: \"[REVIEW_TARGET] - What to review. REQUIRED.\"\n30:   review_target_type: \"[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED.\"\n31:   review_dimensions: \"[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all.\"\n32:   spec_folder: \"[SPEC_FOLDER] - Spec folder path for state files. REQUIRED.\"\n33:   session_id: \"[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp.\"\n34:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches.\"\n35:   max_iterations: 7\n36:   convergence_threshold: 0.10\n37:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n38:   stop_policy: \"[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling.\"\n39:   config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n40: \n41: # ─────────────────────────────────────────────────────────────────\n42: # CONTEXT LOADING\n43: # ─────────────────────────────────────────────────────────────────\n44: context_loading:\n45:   trigger: \"At workflow START, before phase_init\"\n46:   purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n47:   retrieval:\n48:     mechanism: \"continuity-ladder-then-ripgrep\"\n49:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n50:     ladder:\n51:       - \"{spec_folder}/handover.md when present\"\n52:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n53:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n54:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .opencode\"\n55:     recipe_contract: \".opencode/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n56:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n57:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n58:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n59:   behavior:\n60:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n61:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n62: \n63: # ─────────────────────────────────────────────────────────────────\n64: # SKILL REFERENCE\n65: # ─────────────────────────────────────────────────────────────────\n66: skill_reference:\n67:   skill: system-deep-loop\n68:   skill_md: .opencode/skills/system-deep-loop/deep-review/SKILL.md\n69:   references:\n70:     loop_protocol: .opencode/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n71:     state_format: .opencode/skills/system-deep-loop/deep-review/references/state/state-format.md\n72:     convergence: .opencode/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n73:   templates:\n74:     config: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n75:     strategy: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n76: \n77: # ─────────────────────────────────────────────────────────────────\n78: # AGENT CONFIGURATION\n79: # ─────────────────────────────────────────────────────────────────\n80: agent_config:\n81:   agent: deep-review\n82:   agent_file: \".opencode/agents/deep-review.md\"\n83:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n84:   mode: subagent\n85:   model: opus\n86:   leaf_only: true\n87:   tools: [Read, Write, Edit, Bash, Grep, Glob]\n88:   mcp_servers: []\n89:   tool_call_budget: { target: 9, soft_max: 12, hard_max: 13 }\n90: \n91: # ─────────────────────────────────────────────────────────────────\n92: # STATE FILE PATHS\n93: # ─────────────────────────────────────────────────────────────────\n94: # ─────────────────────────────────────────────────────────────────\n95: # CANONICAL STATE WRITE MECHANISM\n96: # ─────────────────────────────────────────────────────────────────\n97: state_write_protocol:\n98:   mechanism: \"append-gateway\"\n99:   command: \"node .opencode/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n100:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n101:   refusal_handling: \"halt on exit 2; never fall back to a direct file write\"\n102:   migration_exception: \"the one-shot legacy-state migration command appends a legacy-shaped migration marker directly; it predates the canonical log and is not a workflow record\"\n103:   exempt_append_sites: 3\n104:   contract: |\n105:     Every canonical record named by an append_to_jsonl or append_jsonl directive below is\n106:     intended to reach the log by invoking the command above with that record as the event JSON.\n107:     Those directives specify WHAT to record; this block specifies the mechanism they are moving\n108:     to, so it is stated once rather than repeated at each site where it could drift.\n109: \n110:     The gateway authorizes the write against the mode's durable authority record, serialises it\n111:     behind the ledger fence, and returns a receipt. It does NOT refresh this mode's legacy state\n112:     file: no projection contract is registered for this mode, so `projectionRefreshed` comes back\n113:     false and the legacy file is left untouched. Exit 0 therefore means the event is durable in\n114:     the ledger, and nothing more. Exit 2 means it was refused and the refusal names the check\n115:     that failed.\n116: \n117:     Because the legacy file is what this workflow's existing readers consume, this block declares\n118:     the mechanism these records are INTENDED to move to. It is not yet a live cutover for this\n119:     mode, and the existing direct writes must stay until a projection contract exists for it.\n120:     Switching them over before then would leave the legacy file silently stale.\n121: \n122:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n123:     can then interleave with no shared ordering, and a record nobody authorized carries no\n124:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n125:     is a halt, never a reason to write the file directly.\n126: \n127:     One exception exists and is deliberate. The legacy-state migration command appends a\n128:     legacy-shaped migration marker directly, because it runs before a canonical log exists and\n129:     records that the move happened rather than recording workflow progress. Every record the\n130:     workflow itself produces goes through the gateway.\n131: \n132:     The exempt_append_sites number is the count of direct-append sites this exception covers;\n133:     adding another such site fails the conformance check until it is reviewed and the count is\n134:     deliberately updated to include it.\n135: \n136: state_paths:\n137:   # Template paths document the canonical packet layout. Runtime resolution happens via\n138:   # step_resolve_artifact_root plus the shared resolver, so root specs keep\n139:   # root-local review/ and child phases keep local review/ packet dirs.\n140:   # Canonical root-spec write targets remain review/deep-review-config.json,\n141:   # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n142:   packet_dir: \"{artifact_dir}\"\n143:   local_packet_dir: \"{spec_folder}/review\"\n144:   legacy_root_report: \"{spec_folder}/review-report.md\"\n145:   config: \"{artifact_dir}/deep-review-config.json\"\n146:   state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n147:   findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n148:   strategy: \"{artifact_dir}/deep-review-strategy.md\"\n149:   dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n150:   pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n151:   lock_file: \"{artifact_dir}/.deep-review.lock\"\n152:   prompt_dir: \"{artifact_dir}/prompts\"\n153:   iteration_dir: \"{artifact_dir}/iterations\"\n154:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n155:   # Per-iteration structured delta stream — complement to the canonical state_log\n156:   # append. MUST contain at least one record with `type === \"iteration\"`; variants\n157:   # like `\"iteration_delta\"` are silently dropped by the reducer.\n158:   delta_dir: \"{artifact_dir}/deltas\"\n159:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n160:   review_output: \"{artifact_dir}/review-report.md\"\n161:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n162:   archive_root: \"{artifact_archive_root}\"\n163: \n164: # ─────────────────────────────────────────────────────────────────\n165: # WORKFLOW\n166: # ─────────────────────────────────────────────────────────────────\n167: workflow:\n168: \n169:   step_resolve_artifact_root:\n170:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n171:     note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n172:     branch_on: \"config.fanout_lineage_artifact_dir\"\n173:     if_present:\n174:       bind:\n175:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n176:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n177:         artifact_subfolder: null\n178:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n179:     if_absent:\n180:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.opencode/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\\\"\"\n181:       outputs:\n182:         - artifact_root_dir: \"Resolved local review owner directory\"\n183:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n184:         - artifact_dir: \"Resolved review packet directory for this target\"\n185:         - artifact_archive_root: \"Resolved local review archive directory for this target\"\n186: \n187:   step_bind_reducer_artifact_arg:\n188:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n189:     branch_on: \"config.fanout_lineage_artifact_dir\"\n190:     if_present:\n191:       bind:\n192:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n193:     if_absent:\n194:       bind:\n195:         reducer_artifact_arg: \"\"\n196: \n197:   step_apply_lifecycle_request:\n198:     description: \"Honor explicit auto-mode restart before fan-out or normal initialization\"\n199:     skip_when: \"lineage_mode != 'restart'\"\n200:     instructions: |\n201:       This is the autonomous equivalent of the confirm-mode restart choice. Run it\n202:       immediately after artifact resolution and before fan-out so old packet files\n203:       cannot be merged with fresh lineage outputs. A restart request must never\n204:       fall back to auto-resume. In auto mode, the explicit restart flag is operator\n205:       authorization to archive the resolved review packet, so do not ask for a\n206:       second confirmation. Rollback is to move the timestamped archive back to\n207:       the packet directory.\n208:     command: \"if [ -d \\\"{state_paths.packet_dir}\\\" ]; then mkdir -p \\\"{state_paths.archive_root}\\\" && mv \\\"{state_paths.packet_dir}\\\" \\\"{state_paths.archive_root}/{timestamp_slug}\\\"; fi; mkdir -p \\\"{state_paths.packet_dir}\\\"\"\n209:     outputs:\n210:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n211:       - lineage_mode: \"restart\"\n212:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n213: \n214:   step_fanout_spawn:\n215:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n216:     skip_when: \"config.fanout is absent\"\n217:     instructions: |\n218:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n219:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n220:       A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n221:       session with a separate lineage directory and session id; it is not the single-executor\n222:       self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n223:       first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n224:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n225:       deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n226:       deep-review agent is used only for individual iterations, never as a full-loop\n227:       sub-agent or pasted phase-running prompt.\n228:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n229:       phase_main_loop entirely (those are the single-executor path). The merge step in\n230:       phase_synthesis will consolidate results across all lineages.\n231:     sub_steps:\n232:       step_fanout_spawn_cli:\n233:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n234:         skip_when: \"no entries in config.fanout.executors\"\n235:         command: |\n236:           node .opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n237:             --spec-folder {spec_folder} \\\n238:             --loop-type review \\\n239:             --fanout-config-json '{config.fanout_json}' \\\n240:             --base-artifact-dir {artifact_dir} \\\n241:             --convergence-threshold {convergence_threshold} \\\n242:             --stop-policy {stop_policy}\n243:         working_directory: \"{repo_root}\"\n244:         wait_for_completion: true\n245: \n246:   # ═══════════════════════════════════════════════════════════════\n247:   # PHASE 1: INITIALIZATION\n248:   # ═══════════════════════════════════════════════════════════════\n249:   phase_init:\n250:     purpose: Create all state files for the review session and resolve review scope\n251:     steps:\n252: \n253:       step_preflight_contract:\n254:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n255:         verify:\n256:           - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n257:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n258:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n259:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n260:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n261: \n262:       step_create_directories:\n263:         action: \"Create spec folder and canonical review packet directories if they don't exist\"\n264:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n265: \n266:       step_detect_resource_map:\n267:         action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n268:         inspect:\n269:           - \"{spec_folder}/resource-map.md\"\n270:         classify:\n271:           present: \"resource-map.md exists at init\"\n272:           absent: \"resource-map.md does not exist at init\"\n273:         outputs:\n274:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n275:           - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n276: \n277:       step_migrate_legacy_review_state:\n278:         action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n279:         detect:\n280:           canonical_review_state:\n281:             - \"{state_paths.config}\"\n282:             - \"{state_paths.state_log}\"\n283:             - \"{state_paths.findings_registry}\"\n284:             - \"{state_paths.strategy}\"\n285:           legacy_review_state:\n286:             - \"{spec_folder}/scratch/deep-research-config.json\"\n287:             - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n288:             - \"{spec_folder}/scratch/deep-review-strategy.md\"\n289:             - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n290:             - \"{spec_folder}/scratch/iteration-*.md\"\n291:             - \"{spec_folder}/scratch/.deep-research-pause\"\n292:             - \"{state_paths.local_packet_dir}/iteration-*.md\"\n293:             - \"{state_paths.legacy_root_report}\"\n294:           legacy_review_markers:\n295:             - \"scratch/deep-review-strategy.md exists\"\n296:             - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n297:         migrate_only:\n298:           - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n299:           - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n300:           - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n301:           - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n302:           - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n303:           - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n304:           - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n305:           - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n306:         on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n307:         on_legacy_detected: \"Move only the review-specific whitelist, append a migration event to the canonical JSONL, and leave unrelated scratch files untouched.\"\n308:         on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n309:         command: \"mkdir -p {state_paths.iteration_dir} && if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}; [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}; [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}; [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}; find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\\\; ; [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}; [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}; if [ -e {state_paths.state_log} ]; then printf '%s\\n' '{\\\"type\\\":\\\"event\\\",\\\"event\\\":\\\"migration\\\",\\\"mode\\\":\\\"review\\\",\\\"legacyArtifacts\\\":[\\\"deep-research-config.json\\\",\\\"deep-research-state.jsonl\\\",\\\".deep-research-pause\\\"],\\\"canonicalArtifacts\\\":[\\\"deep-review-config.json\\\",\\\"deep-review-state.jsonl\\\",\\\".deep-review-pause\\\"],\\\"timestamp\\\":\\\"{ISO_8601_NOW}\\\"}' >> {state_paths.state_log}; fi; fi; find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\\\; 2>/dev/null || true\"\n310: \n311:       step_acquire_lock:\n312:         action: \"Acquire the single-writer advisory lock before session classification\"\n313:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder}\"\n314:         on_acquire: \"Capture ownerPid from the JSON output and reuse it for every release below. If acquired=false, fail closed — another deep-review run already holds this packet.\"\n315:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls; stale-lock override is confirm-only or explicit recovery-only.\"\n316:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n317:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n318:         on_halt:\n319:           action: \"Release the lock before any terminal halt branch returns control\"\n320:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\"]\n321:           command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; failures here are logged but do not block the halt\"\n322:         on_cancel:\n323:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n324:           command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; cancel completes regardless of cleanup result\"\n325:         on_workflow_exit:\n326:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n327:           command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; idempotent — safe to invoke when already released\"\n328: \n329:       step_classify_session:\n330:         action: \"Classify the session before writing files\"\n331:         inspect:\n332:           - \"{state_paths.config}\"\n333:           - \"{state_paths.state_log}\"\n334:           - \"{state_paths.findings_registry}\"\n335:           - \"{state_paths.strategy}\"\n336:         classify:\n337:           fresh: \"None of the three state artifacts exist\"\n338:           resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n339:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n340:           invalid-state: \"Any partial, missing, or contradictory combination\"\n341:         outputs:\n342:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n343:         lifecycle_routing:\n344:           - \"If lineage_mode == restart and session_state is resume or completed-session, execute on_restart before on_resume or on_completed_session.\"\n345:           - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n346:         on_resume:\n347:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n348:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"review\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n349:           skip_to: phase_loop\n350:         on_restart:\n351:           action: \"Archive the current review packet under the root-level review-archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n352:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n353:           set:\n354:             lineage_mode: \"restart\"\n355:             parent_session_id: \"{prior_session_id}\"\n356:             generation: \"{prior_generation + 1}\"\n357:           append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"review\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n358:           skip_to: step_create_config\n359:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n360:         on_completed_session:\n361:           log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n362:           skip_to: phase_synthesis\n363:         on_invalid_state:\n364:           halt: true\n365:           message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n366:         on_fresh:\n367:           action: \"Proceed with a new session\"\n368: \n369:       step_scope_discovery:\n370:         action: \"Resolve review target to a concrete file list based on target type\"\n371:         resolve:\n372:           spec-folder: |\n373:             1. Inspect spec.md, plan.md, tasks.md, checklist.md, implementation-summary.md, and goal-file-manifest.txt when present\n374:             2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n375:             3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n376:             4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n377:             5. Discover test files associated with the implementation files\n378:             6. Set scope = all discovered implementation and test files\n379:           skill: |\n380:             1. Read SKILL.md from .opencode/skills/{skill_name}/\n381:             2. Discover references/, assets/, scripts/ contents\n382:             3. Find agent definitions referencing this skill across runtimes\n383:             4. Find command entry points referencing this skill\n384:             5. Set scope = all discovered files\n385:           agent: |\n386:             1. Find agent definition across repo-managed runtimes (.claude/agents/, .opencode/agents/)\n387:             2. Compare agent definitions for consistency\n388:             3. Set scope = all discovered agent files\n389:           track: |\n390:             1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n391:             2. For each: read spec.md + checklist.md\n392:             3. Set scope = all child spec artifacts\n393:           files: |\n394:             1. Expand glob patterns from review_target\n395:             2. Validate all files exist\n396:             3. Discover immediate cross-references (imports, links)\n397:             4. Set scope = expanded file list + cross-references\n398:         outputs:\n399:           - review_scope_files: \"List of all files in review scope\"\n400:           - cross_reference_targets: \"{ spec_paths: [...], code_paths: [...], test_paths: [...] }\"\n401: \n402:       step_order_dimensions:\n403:         action: \"Order review dimensions based on risk priority\"\n404:         algorithm: |\n405:           1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity\n406:           2. Subsequent iterations follow risk-ordered deep passes:\n407:              correctness → security → traceability → maintainability\n408:           3. If review_dimensions != \"all\", filter to only requested dimensions\n409:           4. Derive traceability protocol plan:\n410:              - core: spec_code, checklist_evidence\n411:              - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability\n412:           5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes\n413:           6. Store ordered list as dimension_queue\n414:         outputs:\n415:           - dimension_queue: \"Ordered list of dimensions to review\"\n416:           - inventory_pass: true\n417: \n418:       step_normalize_review_dimensions:\n419:         action: \"Normalize reviewDimensions once during init for config + JSONL reuse\"\n420:         outputs:\n421:           - review_dimensions_normalized: \"Canonical string[] for deep-review-config.json\"\n422:           - review_dimensions_json: \"JSON.stringify(review_dimensions_normalized) for JSONL config record\"\n423:         normalize: |\n424:           Accept {review_dimensions} in any of these shapes and convert once:\n425:             - \"all\" → [\"correctness\",\"security\",\"traceability\",\"maintainability\"]\n426:             - \"correctness,security\" → [\"correctness\",\"security\"]\n427:             - [\"correctness\"] → [\"correctness\"]\n428:           Every element MUST be one of the four canonical dimension names.\n429: \n430:       step_resolve_session_id:\n431:         action: \"Resolve init session id from caller when supplied, else preserve timestamp fallback\"\n432:         branch_on: \"session_id\"\n433:         if_present:\n434:           bind:\n435:             session_id_init: \"{session_id}\"\n436:         if_absent:\n437:           bind:\n438:             session_id_init: \"{ISO_8601_NOW}\"\n439: \n440:       step_create_config:\n441:         action: \"Create deep-review-config.json from template with review-specific fields\"\n442:         template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n443:         populate:\n444:           topic: \"Review: {review_target}\"\n445:           mode: \"review\"\n446:           sessionId: \"{session_id_init}\"\n447:           parentSessionId: null\n448:           lineageMode: \"new\"\n449:           generation: 1\n450:           continuedFromRun: null\n451:           reviewTarget: \"{review_target}\"\n452:           reviewTargetType: \"{review_target_type}\"\n453:           # Reuse the single normalized init-time value from step_normalize_review_dimensions.\n454:           reviewDimensions: \"{review_dimensions_normalized}\"\n455:           resource_map_present: \"{resource_map_present}\"\n456:           reviewScopeFiles: \"{review_scope_files}\"\n457:           severityThreshold: \"P2\"\n458:           crossReference:\n459:             core: [\"spec_code\", \"checklist_evidence\"]\n460:             overlay: [\"skill_agent\", \"agent_cross_runtime\", \"feature_catalog_code\", \"playbook_capability\"]\n461:           maxIterations: \"{max_iterations}\"\n462:           # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §\"Convergence Threshold Semantics\".\n463:           convergenceThreshold: \"{convergence_threshold}\"\n464:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n465:           antiConvergence.divergent: {}\n466:           stopPolicy: \"{stop_policy}\"\n467:           stuckThreshold: 2\n468:           maxDurationMinutes: 120\n469:           specFolder: \"{spec_folder}\"\n470:           # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).\n471:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n472:           resource_map.emit: \"{resource_map_emit}\"\n473:           createdAt: \"{ISO_8601_NOW}\"\n474:           status: \"initialized\"\n475:           releaseReadinessState: \"in-progress\"\n476:           executionMode: \"auto\"\n477:         output: \"{state_paths.config}\"\n478: \n479:       step_create_state_log:\n480:         action: \"Initialize JSONL state log with config record including review fields and lineage metadata\"\n481:         note: \"Reuse review_dimensions_json from step_normalize_review_dimensions. Never re-normalize or wrap the raw template value.\"\n482:         # Same parsed --no-resource-map flag honored here so config and state_log agree from line 1.\n483:         content: '{\"type\":\"config\",\"mode\":\"review\",\"reviewTarget\":\"{review_target}\",\"reviewTargetType\":\"{review_target_type}\",\"reviewDimensions\":{review_dimensions_json},\"resource_map_present\":{resource_map_present},\"resource_map\":{\"emit\":{resource_map_emit}},\"sessionId\":\"{session_id_init}\",\"parentSessionId\":null,\"lineageMode\":\"new\",\"generation\":1,\"continuedFromRun\":null,\"maxIterations\":{max_iterations},\"convergenceThreshold\":{convergence_threshold},\"antiConvergence\":{\"convergenceMode\":\"{convergence_mode}\",\"divergent\":{}},\"stopPolicy\":\"{stop_policy}\",\"createdAt\":\"{ISO_8601_NOW}\",\"specFolder\":\"{spec_folder}\"}'\n484:         output: \"{state_paths.state_log}\"\n485: \n486:       step_create_findings_registry:\n487:         action: \"Initialize reducer-owned review findings registry\"\n488:         content: '{\"sessionId\":\"{session_id_init}\",\"generation\":1,\"lineageMode\":\"new\",\"openFindings\":[],\"resolvedFindings\":[],\"repeatedFindings\":[],\"dimensionCoverage\":{\"correctness\":false,\"security\":false,\"traceability\":false,\"maintainability\":false},\"findingsBySeverity\":{\"P0\":0,\"P1\":0,\"P2\":0},\"openFindingsCount\":0,\"resolvedFindingsCount\":0,\"convergenceScore\":0.0}'\n489:         output: \"{state_paths.findings_registry}\"\n490: \n491:       step_create_strategy:\n492:         action: \"Create review strategy file from deep-review-strategy.md template\"\n493:         template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n494:         populate:\n495:           review_target: \"{review_target}\"\n496:           review_target_type: \"{review_target_type}\"\n497:           dimensions: \"{dimension_queue}\"\n498:           scope_files: \"{review_scope_files}\"\n499:           cross_reference_targets: \"{cross_reference_targets}\"\n500:           max_iterations: \"{max_iterations}\"\n501:           convergence_threshold: \"{convergence_threshold}\"\n502:           stop_policy: \"{stop_policy}\"\n503:         output: \"{state_paths.strategy}\"\n504: \n505:       step_seed_coverage_graph:\n506:         action: \"Seed the review coverage graph before the first convergence check\"\n507:         transform: |\n508:           1. Convert review_scope_files into FILE nodes.\n509:           2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n510:              or DEPENDENCY nodes in review mode.\n511:           3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n512:           4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n513:           5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n514:              returns a warning and review continues with an empty graph.\n515:         bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n516:         outputs:\n517:           - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n518:           - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n519:           - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n520:         on_warning:\n521:           log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n522:           proceed: true\n523: \n524:       step_enrich_strategy_context:\n525:         action: \"Ensure Known Context is written only after strategy.md exists\"\n526:         condition: \"prior_context_found\"\n527:         edit: \"{state_paths.strategy}\"\n528:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n529: \n530:       step_enrich_strategy_resource_map:\n531:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n532:         edit: \"{state_paths.strategy}\"\n533:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n534: \n535:       step_init_complete:\n536:         log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n537:         set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }\n538: \n539:   # ═══════════════════════════════════════════════════════════════\n540:   # PHASE 2: ITERATION LOOP\n541:   # ═══════════════════════════════════════════════════════════════\n542:   phase_loop:\n543:     purpose: Dispatch review agent iterations until convergence\n544:     repeat: true\n545:     max_repeats: \"{max_iterations}\"\n546:     steps:\n547: \n548:       step_read_state:\n549:         action: \"Read current state from JSONL, strategy, and config\"\n550:         read:\n551:           - \"{state_paths.state_log}\"\n552:           - \"{state_paths.findings_registry}\"\n553:           - \"{state_paths.strategy}\"\n554:           - \"{state_paths.config}\"\n555:         extract:\n556:           - iteration_count: \"Count lines where type === 'iteration'\"\n557:           - current_iteration: \"iteration_count + 1\"\n558:           - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n559:           - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n560:           - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n561:           - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n562:           - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n563:           - dimensions_covered: \"List of dimensions already reviewed\"\n564:           - dimensions_remaining: \"List of dimensions not yet reviewed\"\n565:           - dimension_coverage: \"covered / total dimensions\"\n566:           - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n567:           - p0_count: \"Count P0 findings across all iterations\"\n568:           - p1_count: \"Count P1 findings across all iterations\"\n569:           - p2_count: \"Count P2 findings across all iterations\"\n570:           - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n571:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n572:           - session_id: \"Extract sessionId from deep-review-config.json\"\n573:           - generation: \"Extract generation from deep-review-config.json, else 1\"\n574:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n575:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n576:           - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n577:           - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n578:           - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n579:           - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n580:           - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n581:           - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n582:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n583:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n584:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n585:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n586: \n587:       step_check_pause_sentinel:\n588:         action: \"Check for pause sentinel file\"\n589:         check: \"Does {state_paths.pause_sentinel} exist?\"\n590:         if_exists:\n591:           set:\n592:             pending_stop_event: \"paused\"\n593:             pending_stop_reason: \"userPaused\"\n594:             pending_stop_detail: \"sentinel file detected\"\n595:           skip_to: step_normalize_pause_events\n596:         if_not_exists:\n597:           proceed: true\n598: \n599:       step_validate_convergence_config:\n600:         action: \"Validate convergence mode when loading config\"\n601:         if_convergence_mode_invalid:\n602:           append_jsonl: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n603:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n604: \n605:       step_graph_convergence:\n606:         action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n607:         inspect:\n608:           - \"{state_paths.state_log}\"\n609:           - \"{state_paths.findings_registry}\"\n610:         transform: |\n611:           1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n612:           2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n613:           3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n614:           4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n615:           5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n616:         bash: 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n617:         note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n618:         append_jsonl: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"review\",\"run\":{current_iteration},\"decision\":\"{graph_decision}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n619:         outputs:\n620:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n621:           - graph_signals_json: \"JSON object returned by convergence.cjs\"\n622:           - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n623:           - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n624:           - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n625: \n626:       step_check_convergence:\n627:         action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n628:         algorithm: |\n629:           0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n630:              claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n631:              If claim_adjudication_gate_pass == false:\n632:                candidate_decision = \"BLOCKED\"\n633:                stop_blocked = true\n634:                stopReason = \"blockedStop\"\n635:                blocked_gates = [\"claimAdjudicationGate\"]\n636:                recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n637:                Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n638:           1. HARD STOPS:\n639:              a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n640:              b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n641:              c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n642:              Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n643:           2. STUCK DETECTION (threshold 2):\n644:              if stuck_count >= 2: STUCK_RECOVERY\n645:           3. GRAPH CONVERGENCE PREREQUISITE:\n646:                graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n647:                Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n648:                If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n649:           4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n650:                signals = []\n651:                a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n652:                   avg = mean(last 2 newFindingsRatios)\n653:                   stop if avg <= 0.08\n654:                b) MAD noise floor (w=0.25, needs 3+ iterations):\n655:                   noiseFloor = MAD(all ratios) * 1.4826\n656:                   stop if latest ratio <= noiseFloor\n657:                c) Dimension coverage (w=0.45):\n658:                   coverage = dimensions_covered / total_dimensions\n659:                   stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n660:                Redistribute weights for unavailable signals.\n661:                if latest ratio <= 0.05: mark no_progress_threshold_reached\n662:                if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n663:                else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run\n\n(Output capped at 50 KB. Showing lines 1-663. Use offset=664 to continue.)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Review Loop Manager\npurpose: Iterative code/spec review with convergence detection across review dimensions\naction: Run deep-review loop from initialization through synthesis\noperating_mode:\n  workflow: iterative_loop\n  workflow_compliance: MANDATORY\n  workflow_execution: autonomous\n  approvals: none\n  tracking: progressive_review_state\n  validation: convergence_detection\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING PRINCIPLES\n# ─────────────────────────────────────────────────────────────────\noperating_principles:","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/commands/deep/assets/deep-review-auto.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Review Loop Manager\npurpose: Iterative code/spec review with convergence detection across review dimensions\naction: Run deep-review loop from initialization through synthesis\noperating_mode:\n  workflow: iterative_loop\n  workflow_compliance: MANDATORY\n  workflow_execution: autonomous\n  approvals: none\n  tracking: progressive_review_state\n  validation: convergence_detection\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING PRINCIPLES\n# ─────────────────────────────────────────────────────────────────\noperating_principles:\n  core: \"Fresh context per iteration + externalized state = no context degradation\"\n  approach: \"Dispatch focused review agent per dimension, evaluate convergence, repeat or stop\"\n  mandate: \"Never hold findings in memory; write everything to files. Review target is READ-ONLY.\"\n\n# ─────────────────────────────────────────────────────────────────\n# USER INPUTS (from setup phase)\n# ─────────────────────────────────────────────────────────────────\nuser_inputs:\n  review_target: \"[REVIEW_TARGET] - What to review. REQUIRED.\"\n  review_target_type: \"[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED.\"\n  review_dimensions: \"[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all.\"\n  spec_folder: \"[SPEC_FOLDER] - Spec folder path for state files. REQUIRED.\"\n  session_id: \"[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp.\"\n  lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches.\"\n  max_iterations: 7\n  convergence_threshold: 0.10\n  convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n  stop_policy: \"[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling.\"\n  config.fanout_lineage_artifact_dir: \"[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution.\"\n\n# ─────────────────────────────────────────────────────────────────\n# CONTEXT LOADING\n# ─────────────────────────────────────────────────────────────────\ncontext_loading:\n  trigger: \"At workflow START, before phase_init\"\n  purpose: \"Load prior review context for the target and buffer it until strategy.md exists\"\n  retrieval:\n    mechanism: \"continuity-ladder-then-ripgrep\"\n    note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n    ladder:\n      - \"{spec_folder}/handover.md when present\"\n      - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n      - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n    free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .opencode\"\n    recipe_contract: \".opencode/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n    exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n    ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n  behavior:\n    if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n    if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n\n# ─────────────────────────────────────────────────────────────────\n# SKILL REFERENCE\n# ─────────────────────────────────────────────────────────────────\nskill_reference:\n  skill: system-deep-loop\n  skill_md: .opencode/skills/system-deep-loop/deep-review/SKILL.md\n  references:\n    loop_protocol: .opencode/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md\n    state_format: .opencode/skills/system-deep-loop/deep-review/references/state/state-format.md\n    convergence: .opencode/skills/system-deep-loop/deep-review/references/convergence/convergence.md\n  templates:\n    config: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n    strategy: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n\n# ─────────────────────────────────────────────────────────────────\n# AGENT CONFIGURATION\n# ─────────────────────────────────────────────────────────────────\nagent_config:\n  agent: deep-review\n  agent_file: \".opencode/agents/deep-review.md\"\n  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n  mode: subagent\n  model: opus\n  leaf_only: true\n  tools: [Read, Write, Edit, Bash, Grep, Glob]\n  mcp_servers: []\n  tool_call_budget: { target: 9, soft_max: 12, hard_max: 13 }\n\n# ─────────────────────────────────────────────────────────────────\n# STATE FILE PATHS\n# ─────────────────────────────────────────────────────────────────\n# ─────────────────────────────────────────────────────────────────\n# CANONICAL STATE WRITE MECHANISM\n# ─────────────────────────────────────────────────────────────────\nstate_write_protocol:\n  mechanism: \"append-gateway\"\n  command: \"node .opencode/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n  refusal_handling: \"halt on exit 2; never fall back to a direct file write\"\n  migration_exception: \"the one-shot legacy-state migration command appends a legacy-shaped migration marker directly; it predates the canonical log and is not a workflow record\"\n  exempt_append_sites: 3\n  contract: |\n    Every canonical record named by an append_to_jsonl or append_jsonl directive below is\n    intended to reach the log by invoking the command above with that record as the event JSON.\n    Those directives specify WHAT to record; this block specifies the mechanism they are moving\n    to, so it is stated once rather than repeated at each site where it could drift.\n\n    The gateway authorizes the write against the mode's durable authority record, serialises it\n    behind the ledger fence, and returns a receipt. It does NOT refresh this mode's legacy state\n    file: no projection contract is registered for this mode, so `projectionRefreshed` comes back\n    false and the legacy file is left untouched. Exit 0 therefore means the event is durable in\n    the ledger, and nothing more. Exit 2 means it was refused and the refusal names the check\n    that failed.\n\n    Because the legacy file is what this workflow's existing readers consume, this block declares\n    the mechanism these records are INTENDED to move to. It is not yet a live cutover for this\n    mode, and the existing direct writes must stay until a projection contract exists for it.\n    Switching them over before then would leave the legacy file silently stale.\n\n    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n    can then interleave with no shared ordering, and a record nobody authorized carries no\n    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n    is a halt, never a reason to write the file directly.\n\n    One exception exists and is deliberate. The legacy-state migration command appends a\n    legacy-shaped migration marker directly, because it runs before a canonical log exists and\n    records that the move happened rather than recording workflow progress. Every record the\n    workflow itself produces goes through the gateway.\n\n    The exempt_append_sites number is the count of direct-append sites this exception covers;\n    adding another such site fails the conformance check until it is reviewed and the count is\n    deliberately updated to include it.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep\n  # root-local review/ and child phases keep local review/ packet dirs.\n  # Canonical root-spec write targets remain review/deep-review-config.json,\n  # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n  packet_dir: \"{artifact_dir}\"\n  local_packet_dir: \"{spec_folder}/review\"\n  legacy_root_report: \"{spec_folder}/review-report.md\"\n  config: \"{artifact_dir}/deep-review-config.json\"\n  state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n  findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n  strategy: \"{artifact_dir}/deep-review-strategy.md\"\n  dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n  lock_file: \"{artifact_dir}/.deep-review.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream — complement to the canonical state_log\n  # append. MUST contain at least one record with `type === \"iteration\"`; variants\n  # like `\"iteration_delta\"` are silently dropped by the reducer.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  review_output: \"{artifact_dir}/review-report.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_subfolder: null\n        artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n    if_absent:\n      command: \"node -e \\\"const { resolveArtifactRoot } = require('./.opencode/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\\\"\"\n      outputs:\n        - artifact_root_dir: \"Resolved local review owner directory\"\n        - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n        - artifact_dir: \"Resolved review packet directory for this target\"\n        - artifact_archive_root: \"Resolved local review archive directory for this target\"\n\n  step_bind_reducer_artifact_arg:\n    description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n    if_absent:\n      bind:\n        reducer_artifact_arg: \"\"\n\n  step_apply_lifecycle_request:\n    description: \"Honor explicit auto-mode restart before fan-out or normal initialization\"\n    skip_when: \"lineage_mode != 'restart'\"\n    instructions: |\n      This is the autonomous equivalent of the confirm-mode restart choice. Run it\n      immediately after artifact resolution and before fan-out so old packet files\n      cannot be merged with fresh lineage outputs. A restart request must never\n      fall back to auto-resume. In auto mode, the explicit restart flag is operator\n      authorization to archive the resolved review packet, so do not ask for a\n      second confirmation. Rollback is to move the timestamped archive back to\n      the packet directory.\n    command: \"if [ -d \\\"{state_paths.packet_dir}\\\" ]; then mkdir -p \\\"{state_paths.archive_root}\\\" && mv \\\"{state_paths.packet_dir}\\\" \\\"{state_paths.archive_root}/{timestamp_slug}\\\"; fi; mkdir -p \\\"{state_paths.packet_dir}\\\"\"\n    outputs:\n      - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n      - lineage_mode: \"restart\"\n    on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n\n  step_fanout_spawn:\n    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n    skip_when: \"config.fanout is absent\"\n    instructions: |\n      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n      A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode\n      session with a separate lineage directory and session id; it is not the single-executor\n      self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that\n      first-level detached lineage and still blocks recursive same-kind dispatch from inside it.\n      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n      deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF\n      deep-review agent is used only for individual iterations, never as a full-loop\n      sub-agent or pasted phase-running prompt.\n      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n      phase_main_loop entirely (those are the single-executor path). The merge step in\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_spawn_cli:\n        description: \"Spawn all native and CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type review \\\n            --fanout-config-json '{config.fanout_json}' \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 1: INITIALIZATION\n  # ═══════════════════════════════════════════════════════════════\n  phase_init:\n    purpose: Create all state files for the review session and resolve review scope\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and canonical review packet directories if they don't exist\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_migrate_legacy_review_state:\n        action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n        detect:\n          canonical_review_state:\n            - \"{state_paths.config}\"\n            - \"{state_paths.state_log}\"\n            - \"{state_paths.findings_registry}\"\n            - \"{state_paths.strategy}\"\n          legacy_review_state:\n            - \"{spec_folder}/scratch/deep-research-config.json\"\n            - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n            - \"{spec_folder}/scratch/deep-review-strategy.md\"\n            - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n            - \"{spec_folder}/scratch/iteration-*.md\"\n            - \"{spec_folder}/scratch/.deep-research-pause\"\n            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n            - \"{state_paths.legacy_root_report}\"\n          legacy_review_markers:\n            - \"scratch/deep-review-strategy.md exists\"\n            - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n        migrate_only:\n          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n          - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n          - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n          - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n          - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n        on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n        on_legacy_detected: \"Move only the review-specific whitelist, append a migration event to the canonical JSONL, and leave unrelated scratch files untouched.\"\n        on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n        command: \"mkdir -p {state_paths.iteration_dir} && if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}; [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}; [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}; [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}; find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\\\; ; [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}; [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}; if [ -e {state_paths.state_log} ]; then printf '%s\\n' '{\\\"type\\\":\\\"event\\\",\\\"event\\\":\\\"migration\\\",\\\"mode\\\":\\\"review\\\",\\\"legacyArtifacts\\\":[\\\"deep-research-config.json\\\",\\\"deep-research-state.jsonl\\\",\\\".deep-research-pause\\\"],\\\"canonicalArtifacts\\\":[\\\"deep-review-config.json\\\",\\\"deep-review-state.jsonl\\\",\\\".deep-review-pause\\\"],\\\"timestamp\\\":\\\"{ISO_8601_NOW}\\\"}' >> {state_paths.state_log}; fi; fi; find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\\\; 2>/dev/null || true\"\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder}\"\n        on_acquire: \"Capture ownerPid from the JSON output and reuse it for every release below. If acquired=false, fail closed — another deep-review run already holds this packet.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls; stale-lock override is confirm-only or explicit recovery-only.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Release the lock before any terminal halt branch returns control\"\n          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\"]\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; idempotent — safe to invoke when already released\"\n\n      step_classify_session:\n        action: \"Classify the session before writing files\"\n        inspect:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n        classify:\n          fresh: \"None of the three state artifacts exist\"\n          resume: \"Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder\"\n          completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n          invalid-state: \"Any partial, missing, or contradictory combination\"\n        outputs:\n          - session_state: \"fresh | resume | completed-session | invalid-state\"\n        lifecycle_routing:\n          - \"If lineage_mode == restart and session_state is resume or completed-session, execute on_restart before on_resume or on_completed_session.\"\n          - \"If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior.\"\n        on_resume:\n          log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"review\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: phase_loop\n        on_restart:\n          action: \"Archive the current review packet under the root-level review-archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n          command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n          set:\n            lineage_mode: \"restart\"\n            parent_session_id: \"{prior_session_id}\"\n            generation: \"{prior_generation + 1}\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"review\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: step_create_config\n        note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract.\"\n        on_completed_session:\n          log: \"Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts.\"\n          skip_to: phase_synthesis\n        on_invalid_state:\n          halt: true\n          message: \"Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing.\"\n        on_fresh:\n          action: \"Proceed with a new session\"\n\n      step_scope_discovery:\n        action: \"Resolve review target to a concrete file list based on target type\"\n        resolve:\n          spec-folder: |\n            1. Inspect spec.md, plan.md, tasks.md, checklist.md, implementation-summary.md, and goal-file-manifest.txt when present\n            2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries\n            3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order\n            4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts\n            5. Discover test files associated with the implementation files\n            6. Set scope = all discovered implementation and test files\n          skill: |\n            1. Read SKILL.md from .opencode/skills/{skill_name}/\n            2. Discover references/, assets/, scripts/ contents\n            3. Find agent definitions referencing this skill across runtimes\n            4. Find command entry points referencing this skill\n            5. Set scope = all discovered files\n          agent: |\n            1. Find agent definition across repo-managed runtimes (.claude/agents/, .opencode/agents/)\n            2. Compare agent definitions for consistency\n            3. Set scope = all discovered agent files\n          track: |\n            1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/\n            2. For each: read spec.md + checklist.md\n            3. Set scope = all child spec artifacts\n          files: |\n            1. Expand glob patterns from review_target\n            2. Validate all files exist\n            3. Discover immediate cross-references (imports, links)\n            4. Set scope = expanded file list + cross-references\n        outputs:\n          - review_scope_files: \"List of all files in review scope\"\n          - cross_reference_targets: \"{ spec_paths: [...], code_paths: [...], test_paths: [...] }\"\n\n      step_order_dimensions:\n        action: \"Order review dimensions based on risk priority\"\n        algorithm: |\n          1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity\n          2. Subsequent iterations follow risk-ordered deep passes:\n             correctness → security → traceability → maintainability\n          3. If review_dimensions != \"all\", filter to only requested dimensions\n          4. Derive traceability protocol plan:\n             - core: spec_code, checklist_evidence\n             - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability\n          5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes\n          6. Store ordered list as dimension_queue\n        outputs:\n          - dimension_queue: \"Ordered list of dimensions to review\"\n          - inventory_pass: true\n\n      step_normalize_review_dimensions:\n        action: \"Normalize reviewDimensions once during init for config + JSONL reuse\"\n        outputs:\n          - review_dimensions_normalized: \"Canonical string[] for deep-review-config.json\"\n          - review_dimensions_json: \"JSON.stringify(review_dimensions_normalized) for JSONL config record\"\n        normalize: |\n          Accept {review_dimensions} in any of these shapes and convert once:\n            - \"all\" → [\"correctness\",\"security\",\"traceability\",\"maintainability\"]\n            - \"correctness,security\" → [\"correctness\",\"security\"]\n            - [\"correctness\"] → [\"correctness\"]\n          Every element MUST be one of the four canonical dimension names.\n\n      step_resolve_session_id:\n        action: \"Resolve init session id from caller when supplied, else preserve timestamp fallback\"\n        branch_on: \"session_id\"\n        if_present:\n          bind:\n            session_id_init: \"{session_id}\"\n        if_absent:\n          bind:\n            session_id_init: \"{ISO_8601_NOW}\"\n\n      step_create_config:\n        action: \"Create deep-review-config.json from template with review-specific fields\"\n        template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n        populate:\n          topic: \"Review: {review_target}\"\n          mode: \"review\"\n          sessionId: \"{session_id_init}\"\n          parentSessionId: null\n          lineageMode: \"new\"\n          generation: 1\n          continuedFromRun: null\n          reviewTarget: \"{review_target}\"\n          reviewTargetType: \"{review_target_type}\"\n          # Reuse the single normalized init-time value from step_normalize_review_dimensions.\n          reviewDimensions: \"{review_dimensions_normalized}\"\n          resource_map_present: \"{resource_map_present}\"\n          reviewScopeFiles: \"{review_scope_files}\"\n          severityThreshold: \"P2\"\n          crossReference:\n            core: [\"spec_code\", \"checklist_evidence\"]\n            overlay: [\"skill_agent\", \"agent_cross_runtime\", \"feature_catalog_code\", \"playbook_capability\"]\n          maxIterations: \"{max_iterations}\"\n          # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §\"Convergence Threshold Semantics\".\n          convergenceThreshold: \"{convergence_threshold}\"\n          antiConvergence.convergenceMode: \"{convergence_mode}\"\n          antiConvergence.divergent: {}\n          stopPolicy: \"{stop_policy}\"\n          stuckThreshold: 2\n          maxDurationMinutes: 120\n          specFolder: \"{spec_folder}\"\n          # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).\n          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n          resource_map.emit: \"{resource_map_emit}\"\n          createdAt: \"{ISO_8601_NOW}\"\n          status: \"initialized\"\n          releaseReadinessState: \"in-progress\"\n          executionMode: \"auto\"\n        output: \"{state_paths.config}\"\n\n      step_create_state_log:\n        action: \"Initialize JSONL state log with config record including review fields and lineage metadata\"\n        note: \"Reuse review_dimensions_json from step_normalize_review_dimensions. Never re-normalize or wrap the raw template value.\"\n        # Same parsed --no-resource-map flag honored here so config and state_log agree from line 1.\n        content: '{\"type\":\"config\",\"mode\":\"review\",\"reviewTarget\":\"{review_target}\",\"reviewTargetType\":\"{review_target_type}\",\"reviewDimensions\":{review_dimensions_json},\"resource_map_present\":{resource_map_present},\"resource_map\":{\"emit\":{resource_map_emit}},\"sessionId\":\"{session_id_init}\",\"parentSessionId\":null,\"lineageMode\":\"new\",\"generation\":1,\"continuedFromRun\":null,\"maxIterations\":{max_iterations},\"convergenceThreshold\":{convergence_threshold},\"antiConvergence\":{\"convergenceMode\":\"{convergence_mode}\",\"divergent\":{}},\"stopPolicy\":\"{stop_policy}\",\"createdAt\":\"{ISO_8601_NOW}\",\"specFolder\":\"{spec_folder}\"}'\n        output: \"{state_paths.state_log}\"\n\n      step_create_findings_registry:\n        action: \"Initialize reducer-owned review findings registry\"\n        content: '{\"sessionId\":\"{session_id_init}\",\"generation\":1,\"lineageMode\":\"new\",\"openFindings\":[],\"resolvedFindings\":[],\"repeatedFindings\":[],\"dimensionCoverage\":{\"correctness\":false,\"security\":false,\"traceability\":false,\"maintainability\":false},\"findingsBySeverity\":{\"P0\":0,\"P1\":0,\"P2\":0},\"openFindingsCount\":0,\"resolvedFindingsCount\":0,\"convergenceScore\":0.0}'\n        output: \"{state_paths.findings_registry}\"\n\n      step_create_strategy:\n        action: \"Create review strategy file from deep-review-strategy.md template\"\n        template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n        populate:\n          review_target: \"{review_target}\"\n          review_target_type: \"{review_target_type}\"\n          dimensions: \"{dimension_queue}\"\n          scope_files: \"{review_scope_files}\"\n          cross_reference_targets: \"{cross_reference_targets}\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n          stop_policy: \"{stop_policy}\"\n        output: \"{state_paths.strategy}\"\n\n      step_seed_coverage_graph:\n        action: \"Seed the review coverage graph before the first convergence check\"\n        transform: |\n          1. Convert review_scope_files into FILE nodes.\n          2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL\n             or DEPENDENCY nodes in review mode.\n          3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.\n          4. Bind coverage_seed_source to \"scope_discovery\" and coverage_seed_confidence to 0.50.\n          5. When scope discovery yields no files, emit [] for both arrays; the upsert script\n             returns a warning and review continues with an empty graph.\n        bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{config.sessionId}\\\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \\\"{coverage_seed_source}\\\" --seed-confidence \\\"{coverage_seed_confidence}\\\"\"\n        outputs:\n          - coverage_seed_nodes_json: \"Seed nodes for review SLICE and FILE kinds only\"\n          - coverage_seed_edges_json: \"Seed COVERS edges where review target groupings resolved\"\n          - coverage_seed_warning: \"Warning emitted when the seed batch inserts zero nodes, else empty\"\n        on_warning:\n          log: \"Coverage graph seed inserted zero nodes; continuing with an empty graph.\"\n          proceed: true\n\n      step_enrich_strategy_context:\n        action: \"Ensure Known Context is written only after strategy.md exists\"\n        condition: \"prior_context_found\"\n        edit: \"{state_paths.strategy}\"\n        note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n\n      step_enrich_strategy_resource_map:\n        action: \"Inject resource-map status into Known Context after strategy.md exists\"\n        edit: \"{state_paths.strategy}\"\n        note: \"When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_init_complete:\n        log: \"Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions.\"\n        set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 2: ITERATION LOOP\n  # ═══════════════════════════════════════════════════════════════\n  phase_loop:\n    purpose: Dispatch review agent iterations until convergence\n    repeat: true\n    max_repeats: \"{max_iterations}\"\n    steps:\n\n      step_read_state:\n        action: \"Read current state from JSONL, strategy, and config\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.config}\"\n        extract:\n          - iteration_count: \"Count lines where type === 'iteration'\"\n          - current_iteration: \"iteration_count + 1\"\n          - last_newFindingsRatio: \"Extract newFindingsRatio from last iteration record\"\n          - last_focus: \"Extract focus/dimension from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newFindingsRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newFindingsRatio from latest iteration record, else 'N/A'\"\n          - next_dimension: \"Next uncovered dimension from dimension_queue in strategy.md\"\n          - dimensions_covered: \"List of dimensions already reviewed\"\n          - dimensions_remaining: \"List of dimensions not yet reviewed\"\n          - dimension_coverage: \"covered / total dimensions\"\n          - coverage_age: \"Iterations since dimension coverage last changed; require >= 1 before STOP\"\n          - p0_count: \"Count P0 findings across all iterations\"\n          - p1_count: \"Count P1 findings across all iterations\"\n          - p2_count: \"Count P2 findings across all iterations\"\n          - resource_map_present: \"Extract boolean from deep-review-config.json, default false\"\n          - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'\"\n          - session_id: \"Extract sessionId from deep-review-config.json\"\n          - generation: \"Extract generation from deep-review-config.json, else 1\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'\"\n          - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n          - last_claim_adjudication_passed: \"Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings).\"\n          - claim_adjudication_active_count: \"Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist\"\n          - security_sensitive_fix_scope: \"Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false.\"\n          - fix_completeness_replay_required_rows: \"Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP.\"\n          - fix_completeness_replay_passing_rows: \"Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage.\"\n          - stop_policy: \"Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n\n      step_check_pause_sentinel:\n        action: \"Check for pause sentinel file\"\n        check: \"Does {state_paths.pause_sentinel} exist?\"\n        if_exists:\n          set:\n            pending_stop_event: \"paused\"\n            pending_stop_reason: \"userPaused\"\n            pending_stop_detail: \"sentinel file detected\"\n          skip_to: step_normalize_pause_events\n        if_not_exists:\n          proceed: true\n\n      step_validate_convergence_config:\n        action: \"Validate convergence mode when loading config\"\n        if_convergence_mode_invalid:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"review\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          log: \"Unsupported convergenceMode; using default convergence behavior.\"\n\n      step_graph_convergence:\n        action: \"Evaluate coverage-graph convergence before the inline review convergence vote\"\n        inspect:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n        transform: |\n          1. Call graph convergence on the current review lineage before the inline 3-signal vote.\n          2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.\n          3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.\n          4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.\n          5. Set graph_stop_blocked = true only when graph_decision == \"STOP_BLOCKED\".\n        bash: 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --convergence-mode \"{convergence_mode}\"'\n        note: \"Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote.\"\n        append_jsonl: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"review\",\"run\":{current_iteration},\"decision\":\"{graph_decision}\",\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n        outputs:\n          - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED\"\n          - graph_signals_json: \"JSON object returned by convergence.cjs\"\n          - graph_blockers_json: \"JSON array of graph blockers when present, else []\"\n          - graph_blockers_csv: \"Comma-separated blocker summary when graph blocks STOP, else empty string\"\n          - graph_stop_blocked: \"Boolean true when graph_decision == STOP_BLOCKED\"\n\n      step_check_convergence:\n        action: \"Evaluate graph-assisted review stop conditions and the legal-stop decision tree\"\n        algorithm: |\n          0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):\n             claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)\n             If claim_adjudication_gate_pass == false:\n               candidate_decision = \"BLOCKED\"\n               stop_blocked = true\n               stopReason = \"blockedStop\"\n               blocked_gates = [\"claimAdjudicationGate\"]\n               recovery_strategy = \"Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed.\"\n               Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.\n          1. HARD STOPS:\n             a) if iteration_count >= max_iterations: set decision = \"STOP\", stopReason = \"maxIterationsReached\", hard_stop_reason = \"max_iterations_reached\", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto\n             b) if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = \"CONTINUE\", and broaden the next review angle.\n             c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = \"all_dimensions_clean\" and promote to STOP candidate\n             Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.\n          2. STUCK DETECTION (threshold 2):\n             if stuck_count >= 2: STUCK_RECOVERY\n          3. GRAPH CONVERGENCE PREREQUISITE:\n               graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.\n               Final STOP is never legal unless the inline review vote says STOP AND graph_decision == \"STOP_ALLOWED\".\n               If graph_decision == \"STOP_BLOCKED\", set stop_blocked = true and route through blocked_stop emission instead of stopping.\n          4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):\n               signals = []\n               a) Rolling average (w=0.30, window=2, needs 2+ iterations):\n                  avg = mean(last 2 newFindingsRatios)\n                  stop if avg <= 0.08\n               b) MAD noise floor (w=0.25, needs 3+ iterations):\n                  noiseFloor = MAD(all ratios) * 1.4826\n                  stop if latest ratio <= noiseFloor\n               c) Dimension coverage (w=0.45):\n                  coverage = dimensions_covered / total_dimensions\n                  stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1\n               Redistribute weights for unavailable signals.\n               if latest ratio <= 0.05: mark no_progress_threshold_reached\n               if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = \"CONTINUE\", and choose a broader next focus.\n               else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run","lineStart":1,"lineEnd":663,"totalLines":664,"truncated":true}},"title":".opencode/commands/deep/assets/deep-review-auto.yaml","time":{"start":1788624896556,"end":1788624896573}},"id":"prt_0725a022b001ixTfpX34f3DOES","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_07259c2f8001Lra6aR3bELiQxa"}}
{"type":"tool_use","timestamp":1788624896602,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_521vAKvyYrREUd6cQyaKvcZX","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/REPO RULES.md","offset":1,"limit":1200},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/REPO RULES.md</path>\n<type>file</type>\n<content>\n1: # REPO RULES\n2: \n3: Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\n4: before your first write of the session; this document then routes you to the one rule\n5: file that governs what you are about to do. **It is a router, not a rulebook:** it\n6: holds no rules of its own.\n7: \n8: ---\n9: \n10: ## 1. HOW TO USE THIS\n11: \n12: 1. **Match on the action you are about to take**, not the topic of the request.\n13: 2. **Load before the action.** A rule read afterwards is a post-mortem.\n14: 3. **A file already in context is not re-read.**\n15: 4. **Every trigger that fires is loaded, not just the first.** They compose; the more\n16:    specific wins on conflict. Three and four firing at once is the normal case, not an\n17:    edge case.\n18: 5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n19: \n20: ### Precedence\n21: \n22: | Level | Source | Can be overridden? |\n23: |-------|--------|--------------------|\n24: | 1 | Every `AGENTS.md` §1 hard blocker, the Four Laws, PLAN-WORKFLOW LOCK, Comment Hygiene, and every mandatory gate in §2 | No |\n25: | 2 | An explicit, in-the-moment operator instruction | Not applicable, it is the instruction |\n26: | 3 | These rule files | Only by level 1 or 2 |\n27: | 4 | General judgment | By anything above |\n28: \n29: A rule file may tighten `AGENTS.md`. None relaxes a HARD BLOCK or authorizes what\n30: `AGENTS.md` forbids. Gate 5 does not change that: it makes the **load** mandatory,\n31: while what you load stays at level 3, the obligation to read is tier 1, the content\n32: is not.\n33: \n34: ---\n35: \n36: ## 2. TRIGGER TABLE\n37: \n38: | You are about to… | Load | It settles |\n39: |-------------------|------|-----------|\n40: | Add a file, module, class, interface, option, layer, or dependency · generalize something that works · write \"flexible\", \"future-proof\", \"might need\", \"best practice\" · add a test beyond the coverage floor | [`prevent-overengineering.md`](repo-rules/prevent-overengineering.md) | Whether this should exist at all, and at what size |\n41: | Touch a file outside the ask · fix something noticed in passing · rename, reformat, or delete beyond the named area · deviate from an approved plan | [`scope-discipline.md`](repo-rules/scope-discipline.md) | What is yours to change, and how to raise what isn't |\n42: | Say \"done\", \"works\", \"fixed\", \"passing\", \"no regressions\" · report a result · quote a number · act on a tool's or sub-agent's success report · close out a turn | [`evidence-and-proof.md`](repo-rules/evidence-and-proof.md) | What counts as proof, how a green run lies, what an honest close-out contains |\n43: | Hand work to another runtime: a CLI executor, sub-agent, fan-out lineage, or deep loop · compose the prompt one will act on · accept or quote what one returned · answer a judgment question from your own reading alone | [`delegation-and-orchestration.md`](repo-rules/delegation-and-orchestration.md) | The orchestrating posture, what a brief must carry, why one model is one opinion |\n44: | Delete, overwrite, migrate, deploy, publish, send, install · force-push or rewrite history · change a shared contract · touch auth, data, or config | [`blast-radius.md`](repo-rules/blast-radius.md) | Reversibility, the rollback sentence, when to stop for a yes |\n45: | Diagnose a failure · make a red check green · attempt the same fix twice · add a special case, retry, sleep, or broadened catch | [`root-cause-and-debugging.md`](repo-rules/root-cause-and-debugging.md) | Fixing the producer instead of the symptom, and when to level up to the seam |\n46: | Answer without certainty · contradict the operator · fill a gap with a plausible guess · hit a contradiction between two things that must both be true | [`uncertainty-and-honesty.md`](repo-rules/uncertainty-and-honesty.md) | Confidence bands, UNKNOWN, contradiction halts |\n47: | Write any substantive reply · present a recommendation, a fork, or a trade-off · answer a complex or ambiguous request · the reader says they did not follow | [`communication.md`](repo-rules/communication.md) | How a reply reads: sentence shape, length, filler, verdict-first order, Ask→Do framing |\n48: | Wire, rewire or remove a mode in a parent-hub skill · edit a hub's registry, router, `ROUTER.md`, `graph-metadata.json` or `SKILL.md` mode table · report that a mode is registered, routed or integrated · quote a per-hub gate result | [`skill-hub-routing.md`](repo-rules/skill-hub-routing.md) | The two routing stages, what \"integrated\" requires, and checking the hub you actually changed |\n49: \n50: ---\n51: \n52: ## 3. INDEX\n53: \n54: | Rule | Summary |\n55: |------|---------|\n56: | [Overengineering](repo-rules/prevent-overengineering.md) | Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one. |\n57: | [Scope discipline](repo-rules/scope-discipline.md) | The requested scope is the deliverable, adjacent problems get named, not fixed. |\n58: | [Evidence and proof](repo-rules/evidence-and-proof.md) | A claim is only as strong as the observation behind it. |\n59: | [Delegation and orchestration](repo-rules/delegation-and-orchestration.md) | Delegating makes you the orchestrator; brief with evidence, and no single model's verdict closes a question. |\n60: | [Blast radius](repo-rules/blast-radius.md) | Size effort to what the change can break; no irreversible step without a named rollback and a yes. |\n61: | [Root cause](repo-rules/root-cause-and-debugging.md) | Fix the producer, not the symptom; every fix names the mechanism. |\n62: | [Uncertainty and honesty](repo-rules/uncertainty-and-honesty.md) | Never fabricate; mark the confidence you actually have. |\n63: | [Communication](repo-rules/communication.md) | Write so the reader can act after one pass: one idea per sentence, verdict first, nothing that does not carry information. |\n64: | [Hub routing](repo-rules/skill-hub-routing.md) | A hub projects one advisor identity and routes in two stages; registered is not routed, and a gate run without its hub argument checks something else. |\n65: \n66: Each file expands `AGENTS.md` and is bounded by it: where a rule file appears to\n67: permit something `AGENTS.md` restricts, `AGENTS.md` wins and the rule file is wrong.\n68: \n69: ---\n70: \n71: ## 4. SCOPE OF THIS DOCUMENT\n72: \n73: **In:** how to think and act, restraint, scope, evidence, risk, diagnosis, honesty,\n74: the posture to hold when work is handed to another runtime, how the resulting reply\n75: reads, and what you may claim about wiring you have changed. Delivery joined the list\n76: when `AGENTS.md` §8 moved down; it is the one rule here whose trigger is every\n77: substantive reply rather than a specific action, and §8 keeps the two clauses that\n78: must bind even when nothing loads.\n79: \n80: **Out:** skill routing, workflow selection, spec-folder mechanics, and the *mechanics*\n81: of agent and CLI dispatch: which agent, which command, which model, which flags.\n82: Those belong to `AGENTS.md` §2 and the skills it routes to, and are deliberately\n83: absent here so each has exactly one place to change. The line is between plumbing and\n84: posture: how to dispatch is theirs, how to think while dispatching is ours.\n85: \n86: **The routing carve-out, added deliberately as the third widening.** *Selecting* a\n87: route stays Out. *Verifying wiring you changed, and what you may claim about it*, is\n88: In; it is an evidence obligation whose subject happens to be routing. `skill-hub-routing.md`\n89: is the one rule on this side of that line, and it carries no route-selection guidance:\n90: the mechanics stay in the skills, and the rule points at them. A fourth widening that\n91: admits selection itself would dissolve the boundary; this one does not.\n\n(End of file - total 91 lines)\n</content>","metadata":{"preview":"# REPO RULES\n\nRepo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\nbefore your first write of the session; this document then routes you to the one rule\nfile that governs what you are about to do. **It is a router, not a rulebook:** it\nholds no rules of its own.\n\n---\n\n## 1. HOW TO USE THIS\n\n1. **Match on the action you are about to take**, not the topic of the request.\n2. **Load before the action.** A rule read afterwards is a post-mortem.\n3. **A file already in context is not re-read.**\n4. **Every trigger that fires is loaded, not just the first.** They compose; the more\n   specific wins on conflict. Three and four firing at once is the normal case, not an\n   edge case.\n5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n\n### Precedence","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/REPO RULES.md","text":"# REPO RULES\n\nRepo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory\nbefore your first write of the session; this document then routes you to the one rule\nfile that governs what you are about to do. **It is a router, not a rulebook:** it\nholds no rules of its own.\n\n---\n\n## 1. HOW TO USE THIS\n\n1. **Match on the action you are about to take**, not the topic of the request.\n2. **Load before the action.** A rule read afterwards is a post-mortem.\n3. **A file already in context is not re-read.**\n4. **Every trigger that fires is loaded, not just the first.** They compose; the more\n   specific wins on conflict. Three and four firing at once is the normal case, not an\n   edge case.\n5. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.\n\n### Precedence\n\n| Level | Source | Can be overridden? |\n|-------|--------|--------------------|\n| 1 | Every `AGENTS.md` §1 hard blocker, the Four Laws, PLAN-WORKFLOW LOCK, Comment Hygiene, and every mandatory gate in §2 | No |\n| 2 | An explicit, in-the-moment operator instruction | Not applicable, it is the instruction |\n| 3 | These rule files | Only by level 1 or 2 |\n| 4 | General judgment | By anything above |\n\nA rule file may tighten `AGENTS.md`. None relaxes a HARD BLOCK or authorizes what\n`AGENTS.md` forbids. Gate 5 does not change that: it makes the **load** mandatory,\nwhile what you load stays at level 3, the obligation to read is tier 1, the content\nis not.\n\n---\n\n## 2. TRIGGER TABLE\n\n| You are about to… | Load | It settles |\n|-------------------|------|-----------|\n| Add a file, module, class, interface, option, layer, or dependency · generalize something that works · write \"flexible\", \"future-proof\", \"might need\", \"best practice\" · add a test beyond the coverage floor | [`prevent-overengineering.md`](repo-rules/prevent-overengineering.md) | Whether this should exist at all, and at what size |\n| Touch a file outside the ask · fix something noticed in passing · rename, reformat, or delete beyond the named area · deviate from an approved plan | [`scope-discipline.md`](repo-rules/scope-discipline.md) | What is yours to change, and how to raise what isn't |\n| Say \"done\", \"works\", \"fixed\", \"passing\", \"no regressions\" · report a result · quote a number · act on a tool's or sub-agent's success report · close out a turn | [`evidence-and-proof.md`](repo-rules/evidence-and-proof.md) | What counts as proof, how a green run lies, what an honest close-out contains |\n| Hand work to another runtime: a CLI executor, sub-agent, fan-out lineage, or deep loop · compose the prompt one will act on · accept or quote what one returned · answer a judgment question from your own reading alone | [`delegation-and-orchestration.md`](repo-rules/delegation-and-orchestration.md) | The orchestrating posture, what a brief must carry, why one model is one opinion |\n| Delete, overwrite, migrate, deploy, publish, send, install · force-push or rewrite history · change a shared contract · touch auth, data, or config | [`blast-radius.md`](repo-rules/blast-radius.md) | Reversibility, the rollback sentence, when to stop for a yes |\n| Diagnose a failure · make a red check green · attempt the same fix twice · add a special case, retry, sleep, or broadened catch | [`root-cause-and-debugging.md`](repo-rules/root-cause-and-debugging.md) | Fixing the producer instead of the symptom, and when to level up to the seam |\n| Answer without certainty · contradict the operator · fill a gap with a plausible guess · hit a contradiction between two things that must both be true | [`uncertainty-and-honesty.md`](repo-rules/uncertainty-and-honesty.md) | Confidence bands, UNKNOWN, contradiction halts |\n| Write any substantive reply · present a recommendation, a fork, or a trade-off · answer a complex or ambiguous request · the reader says they did not follow | [`communication.md`](repo-rules/communication.md) | How a reply reads: sentence shape, length, filler, verdict-first order, Ask→Do framing |\n| Wire, rewire or remove a mode in a parent-hub skill · edit a hub's registry, router, `ROUTER.md`, `graph-metadata.json` or `SKILL.md` mode table · report that a mode is registered, routed or integrated · quote a per-hub gate result | [`skill-hub-routing.md`](repo-rules/skill-hub-routing.md) | The two routing stages, what \"integrated\" requires, and checking the hub you actually changed |\n\n---\n\n## 3. INDEX\n\n| Rule | Summary |\n|------|---------|\n| [Overengineering](repo-rules/prevent-overengineering.md) | Build the smallest thing that solves the stated problem; take a costlier move only by naming what fails at the cheaper one. |\n| [Scope discipline](repo-rules/scope-discipline.md) | The requested scope is the deliverable, adjacent problems get named, not fixed. |\n| [Evidence and proof](repo-rules/evidence-and-proof.md) | A claim is only as strong as the observation behind it. |\n| [Delegation and orchestration](repo-rules/delegation-and-orchestration.md) | Delegating makes you the orchestrator; brief with evidence, and no single model's verdict closes a question. |\n| [Blast radius](repo-rules/blast-radius.md) | Size effort to what the change can break; no irreversible step without a named rollback and a yes. |\n| [Root cause](repo-rules/root-cause-and-debugging.md) | Fix the producer, not the symptom; every fix names the mechanism. |\n| [Uncertainty and honesty](repo-rules/uncertainty-and-honesty.md) | Never fabricate; mark the confidence you actually have. |\n| [Communication](repo-rules/communication.md) | Write so the reader can act after one pass: one idea per sentence, verdict first, nothing that does not carry information. |\n| [Hub routing](repo-rules/skill-hub-routing.md) | A hub projects one advisor identity and routes in two stages; registered is not routed, and a gate run without its hub argument checks something else. |\n\nEach file expands `AGENTS.md` and is bounded by it: where a rule file appears to\npermit something `AGENTS.md` restricts, `AGENTS.md` wins and the rule file is wrong.\n\n---\n\n## 4. SCOPE OF THIS DOCUMENT\n\n**In:** how to think and act, restraint, scope, evidence, risk, diagnosis, honesty,\nthe posture to hold when work is handed to another runtime, how the resulting reply\nreads, and what you may claim about wiring you have changed. Delivery joined the list\nwhen `AGENTS.md` §8 moved down; it is the one rule here whose trigger is every\nsubstantive reply rather than a specific action, and §8 keeps the two clauses that\nmust bind even when nothing loads.\n\n**Out:** skill routing, workflow selection, spec-folder mechanics, and the *mechanics*\nof agent and CLI dispatch: which agent, which command, which model, which flags.\nThose belong to `AGENTS.md` §2 and the skills it routes to, and are deliberately\nabsent here so each has exactly one place to change. The line is between plumbing and\nposture: how to dispatch is theirs, how to think while dispatching is ours.\n\n**The routing carve-out, added deliberately as the third widening.** *Selecting* a\nroute stays Out. *Verifying wiring you changed, and what you may claim about it*, is\nIn; it is an evidence obligation whose subject happens to be routing. `skill-hub-routing.md`\nis the one rule on this side of that line, and it carries no route-selection guidance:\nthe mechanics stay in the skills, and the rule points at them. A fourth widening that\nadmits selection itself would dissolve the boundary; this one does not.","lineStart":1,"lineEnd":91,"totalLines":91,"truncated":false}},"title":"REPO RULES.md","time":{"start":1788624896554,"end":1788624896593}},"id":"prt_0725a0228001QH8LwwTFSIniSx","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_07259c2f8001Lra6aR3bELiQxa"}}
{"type":"tool_use","timestamp":1788624896602,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_T4xNXRWFDwTVMogGbNKeGWA7","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/deep-review/references/protocol/completion-criteria.md","offset":1,"limit":1000},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/deep-review/references/protocol/completion-criteria.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: Deep Review Completion Criteria\n3: description: Full definition-of-done checklist for a deep-review loop -- loop completion conditions, the binary quality gates that must pass before STOP, and release-readiness validation success criteria.\n4: trigger_phrases:\n5:   - \"review loop completion criteria\"\n6:   - \"review success criteria\"\n7:   - \"review definition of done\"\n8:   - \"review release readiness validation\"\n9: importance_tier: important\n10: contextType: implementation\n11: version: 1.11.0.0\n12: ---\n13: \n14: # Deep Review Completion Criteria\n15: \n16: Full definition-of-done checklist for a deep-review loop: loop completion conditions, the binary quality gates STOP must clear, and release-readiness validation success criteria.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: This reference is the authoritative checklist for \"is this review loop actually done.\" SKILL.md §6 SUCCESS CRITERIA carries a condensed summary and links here for the full enumeration; use this file when verifying a completed run, debugging a premature STOP, or reconciling completion metadata against the loop's real state.\n25: \n26: ### When to Use\n27: \n28: - Verifying a review loop's completion before accepting its verdict.\n29: - Debugging why STOP was blocked or why synthesis produced an incomplete report.\n30: - Reconciling `review-report.md` claims against the canonical state files.\n31: - Auditing a run for the release-readiness handoff.\n32: \n33: ### Relationship to `loop-state-and-gates.md`\n34: \n35: `references/protocol/loop-state-and-gates.md` defines the three state-machine-level binary gates (Evidence, Scope, Coverage) that block a STOP *decision* inside the convergence check. This file is the broader definition-of-done: it also covers artifact existence, report structure, severity-field completeness, and the release-readiness handoff -- checked once the loop believes it has already reached STOP.\n36: \n37: ---\n38: \n39: ## 2. LOOP COMPLETION\n40: \n41: A review loop is considered complete when every item below holds:\n42: \n43: - The loop reached convergence (composite stop score above `compositeStopScore`, with required gates green) OR hit `maxIterations` without false-positive STOP.\n44: - Every configured review dimension has at least one full iteration of coverage recorded in `deep-review-state.jsonl` and reflected in `deep-review-strategy.md`.\n45: - Required traceability protocols (`spec_code`, `checklist_evidence`) executed at least once. Overlay protocols that apply to the target type ran or were explicitly marked N/A.\n46: - All canonical state files exist and parse cleanly: `deep-review-config.json`, `deep-review-state.jsonl`, `deep-review-findings-registry.json`, `deep-review-strategy.md`, `deep-review-dashboard.md`, and one `iterations/iteration-NNN.md` per dispatched iteration.\n47: - `review/resource-map.md` was emitted from converged delta evidence unless `config.resource_map.emit == false` (operator flag `--no-resource-map`).\n48: - `review/review-report.md` carries all 9 core sections (Executive Summary, Planning Trigger, Active Finding Registry, Remediation Workstreams, Spec Seed, Plan Seed, Traceability Status, Deferred Items, Audit Appendix) plus the conditional `## Resource Map Coverage Gate` section when `resource_map_present == true`.\n49: - Canonical continuity surfaces updated via `generate-context.js` (description.json, graph-metadata.json, indexed memory entries).\n50: \n51: ---\n52: \n53: ## 3. QUALITY GATES\n54: \n55: Each gate is binary: pass or block. STOP cannot be legal until every gate passes.\n56: \n57: - **Config validity**: `deep-review-config.json` parses, names every required field, and lineage block matches the current run (`sessionId`, `parentSessionId`, `lineageMode`, `generation`, `continuedFromRun`, `releaseReadinessState`).\n58: - **Strategy initialization**: `deep-review-strategy.md` carries the Files Under Review table, Cross-Reference Status grouped by core vs overlay, Known Context, and Review Boundaries.\n59: - **State consistency**: `deep-review-state.jsonl` opens with the config record and appends one iteration record per dispatched iteration. Reducer-owned fields in `deep-review-findings-registry.json` reconcile against JSONL totals.\n60: - **Iteration completeness**: every dispatched iteration produced both an `iterations/iteration-NNN.md` (non-empty, ending with the canonical `Review verdict: PASS|CONDITIONAL|FAIL` line) AND a JSONL delta record with `findingDetails[]`, `findingsSummary`, `newFindingsRatio`.\n61: - **Severity coverage**: every reported finding carries `severity` in {P0, P1, P2}, `category`, `file:line` evidence, `finding_class`, and a `content_hash` for synthesis dedup.\n62: - **Advisory numeric score**: `riskScore` may appear in finding details as non-gating context only; verdict logic must ignore it.\n63: - **Adversarial replay**: every P0 finding survived adversarial self-check. Rejected P0s downgraded with rationale recorded in the iteration narrative.\n64: - **Coverage threshold**: `dimensions_covered_count == configured_dimensions_count` AND required traceability protocols covered, stable for at least `minStabilizationPasses` iterations.\n65: - **Acceptance coverage**: when the spec-folder lifecycle predicate is active, the final report records `AC_COVERAGE` status, covered/total, floor, and next action; default-off INFO output is advisory and does not by itself block STOP.\n66: - **Security-sensitive override**: when the run targets security, path handling, env precedence, schema boundaries, persistence, or shared policy, the gates from `references/convergence/convergence.md` \"Security-Sensitive Fix Overrides\" apply (`minStabilizationPasses=2`, closed-finding replay required, fix-completeness gate enforced).\n67: \n68: ---\n69: \n70: ## 4. VALIDATION SUCCESS\n71: \n72: The release-readiness handoff is valid when:\n73: \n74: - The final report records stop reason, iteration count, dimension coverage, severity counts (P0/P1/P2), verdict (PASS / CONDITIONAL / FAIL), and release-readiness state (`in-progress`, `converged`, `release-blocking`).\n75: - Verdict logic matches: PASS = no P0/P1 findings (P2 advisories permitted with `hasAdvisories: true`). CONDITIONAL = P1 findings present with remediation plan. FAIL = any P0 confirmed after adversarial self-check.\n76: - `resource-map.md` Phase-5 Augmentation section (if present) lists novel logic gaps with iteration source links, or explicitly records the empty-result case.\n77: - `skill_advisor.py \"run a deep review loop\" --threshold 0.8` still surfaces the skill after any graph-metadata edits.\n78: - `bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh <spec-folder> --strict` exits 0 on the target spec folder.\n79: \n80: ---\n81: \n82: ## 5. RELATED RESOURCES\n83: \n84: - `references/protocol/loop-state-and-gates.md` -- state transitions, error handling, and the Evidence/Scope/Coverage STOP-decision gates.\n85: - `references/state/state-outputs.md` -- packet file ownership and the `review-report.md` section list.\n86: - `references/state/state-format.md` -- schemas for every state file referenced above.\n87: - `references/convergence/convergence.md` -- composite stop score, `minStabilizationPasses`, and Security-Sensitive Fix Overrides.\n\n(End of file - total 87 lines)\n</content>","metadata":{"preview":"---\ntitle: Deep Review Completion Criteria\ndescription: Full definition-of-done checklist for a deep-review loop -- loop completion conditions, the binary quality gates that must pass before STOP, and release-readiness validation success criteria.\ntrigger_phrases:\n  - \"review loop completion criteria\"\n  - \"review success criteria\"\n  - \"review definition of done\"\n  - \"review release readiness validation\"\nimportance_tier: important\ncontextType: implementation\nversion: 1.11.0.0\n---\n\n# Deep Review Completion Criteria\n\nFull definition-of-done checklist for a deep-review loop: loop completion conditions, the binary quality gates STOP must clear, and release-readiness validation success criteria.\n\n---\n\n## 1. OVERVIEW","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/deep-review/references/protocol/completion-criteria.md","text":"---\ntitle: Deep Review Completion Criteria\ndescription: Full definition-of-done checklist for a deep-review loop -- loop completion conditions, the binary quality gates that must pass before STOP, and release-readiness validation success criteria.\ntrigger_phrases:\n  - \"review loop completion criteria\"\n  - \"review success criteria\"\n  - \"review definition of done\"\n  - \"review release readiness validation\"\nimportance_tier: important\ncontextType: implementation\nversion: 1.11.0.0\n---\n\n# Deep Review Completion Criteria\n\nFull definition-of-done checklist for a deep-review loop: loop completion conditions, the binary quality gates STOP must clear, and release-readiness validation success criteria.\n\n---\n\n## 1. OVERVIEW\n\n### Purpose\n\nThis reference is the authoritative checklist for \"is this review loop actually done.\" SKILL.md §6 SUCCESS CRITERIA carries a condensed summary and links here for the full enumeration; use this file when verifying a completed run, debugging a premature STOP, or reconciling completion metadata against the loop's real state.\n\n### When to Use\n\n- Verifying a review loop's completion before accepting its verdict.\n- Debugging why STOP was blocked or why synthesis produced an incomplete report.\n- Reconciling `review-report.md` claims against the canonical state files.\n- Auditing a run for the release-readiness handoff.\n\n### Relationship to `loop-state-and-gates.md`\n\n`references/protocol/loop-state-and-gates.md` defines the three state-machine-level binary gates (Evidence, Scope, Coverage) that block a STOP *decision* inside the convergence check. This file is the broader definition-of-done: it also covers artifact existence, report structure, severity-field completeness, and the release-readiness handoff -- checked once the loop believes it has already reached STOP.\n\n---\n\n## 2. LOOP COMPLETION\n\nA review loop is considered complete when every item below holds:\n\n- The loop reached convergence (composite stop score above `compositeStopScore`, with required gates green) OR hit `maxIterations` without false-positive STOP.\n- Every configured review dimension has at least one full iteration of coverage recorded in `deep-review-state.jsonl` and reflected in `deep-review-strategy.md`.\n- Required traceability protocols (`spec_code`, `checklist_evidence`) executed at least once. Overlay protocols that apply to the target type ran or were explicitly marked N/A.\n- All canonical state files exist and parse cleanly: `deep-review-config.json`, `deep-review-state.jsonl`, `deep-review-findings-registry.json`, `deep-review-strategy.md`, `deep-review-dashboard.md`, and one `iterations/iteration-NNN.md` per dispatched iteration.\n- `review/resource-map.md` was emitted from converged delta evidence unless `config.resource_map.emit == false` (operator flag `--no-resource-map`).\n- `review/review-report.md` carries all 9 core sections (Executive Summary, Planning Trigger, Active Finding Registry, Remediation Workstreams, Spec Seed, Plan Seed, Traceability Status, Deferred Items, Audit Appendix) plus the conditional `## Resource Map Coverage Gate` section when `resource_map_present == true`.\n- Canonical continuity surfaces updated via `generate-context.js` (description.json, graph-metadata.json, indexed memory entries).\n\n---\n\n## 3. QUALITY GATES\n\nEach gate is binary: pass or block. STOP cannot be legal until every gate passes.\n\n- **Config validity**: `deep-review-config.json` parses, names every required field, and lineage block matches the current run (`sessionId`, `parentSessionId`, `lineageMode`, `generation`, `continuedFromRun`, `releaseReadinessState`).\n- **Strategy initialization**: `deep-review-strategy.md` carries the Files Under Review table, Cross-Reference Status grouped by core vs overlay, Known Context, and Review Boundaries.\n- **State consistency**: `deep-review-state.jsonl` opens with the config record and appends one iteration record per dispatched iteration. Reducer-owned fields in `deep-review-findings-registry.json` reconcile against JSONL totals.\n- **Iteration completeness**: every dispatched iteration produced both an `iterations/iteration-NNN.md` (non-empty, ending with the canonical `Review verdict: PASS|CONDITIONAL|FAIL` line) AND a JSONL delta record with `findingDetails[]`, `findingsSummary`, `newFindingsRatio`.\n- **Severity coverage**: every reported finding carries `severity` in {P0, P1, P2}, `category`, `file:line` evidence, `finding_class`, and a `content_hash` for synthesis dedup.\n- **Advisory numeric score**: `riskScore` may appear in finding details as non-gating context only; verdict logic must ignore it.\n- **Adversarial replay**: every P0 finding survived adversarial self-check. Rejected P0s downgraded with rationale recorded in the iteration narrative.\n- **Coverage threshold**: `dimensions_covered_count == configured_dimensions_count` AND required traceability protocols covered, stable for at least `minStabilizationPasses` iterations.\n- **Acceptance coverage**: when the spec-folder lifecycle predicate is active, the final report records `AC_COVERAGE` status, covered/total, floor, and next action; default-off INFO output is advisory and does not by itself block STOP.\n- **Security-sensitive override**: when the run targets security, path handling, env precedence, schema boundaries, persistence, or shared policy, the gates from `references/convergence/convergence.md` \"Security-Sensitive Fix Overrides\" apply (`minStabilizationPasses=2`, closed-finding replay required, fix-completeness gate enforced).\n\n---\n\n## 4. VALIDATION SUCCESS\n\nThe release-readiness handoff is valid when:\n\n- The final report records stop reason, iteration count, dimension coverage, severity counts (P0/P1/P2), verdict (PASS / CONDITIONAL / FAIL), and release-readiness state (`in-progress`, `converged`, `release-blocking`).\n- Verdict logic matches: PASS = no P0/P1 findings (P2 advisories permitted with `hasAdvisories: true`). CONDITIONAL = P1 findings present with remediation plan. FAIL = any P0 confirmed after adversarial self-check.\n- `resource-map.md` Phase-5 Augmentation section (if present) lists novel logic gaps with iteration source links, or explicitly records the empty-result case.\n- `skill_advisor.py \"run a deep review loop\" --threshold 0.8` still surfaces the skill after any graph-metadata edits.\n- `bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh <spec-folder> --strict` exits 0 on the target spec folder.\n\n---\n\n## 5. RELATED RESOURCES\n\n- `references/protocol/loop-state-and-gates.md` -- state transitions, error handling, and the Evidence/Scope/Coverage STOP-decision gates.\n- `references/state/state-outputs.md` -- packet file ownership and the `review-report.md` section list.\n- `references/state/state-format.md` -- schemas for every state file referenced above.\n- `references/convergence/convergence.md` -- composite stop score, `minStabilizationPasses`, and Security-Sensitive Fix Overrides.","lineStart":1,"lineEnd":87,"totalLines":87,"truncated":false}},"title":".opencode/skills/system-deep-loop/deep-review/references/protocol/completion-criteria.md","time":{"start":1788624896561,"end":1788624896596}},"id":"prt_0725a0230001J833Z5L0V8caFY","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_07259c2f8001Lra6aR3bELiQxa"}}
{"type":"tool_use","timestamp":1788624896602,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_gGhBilVoZrVfw5zfPawLi7IW","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/review-scope.txt","offset":1,"limit":1200},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/review-scope.txt</path>\n<type>file</type>\n<content>\n1: .claude/SYNC.md\n2: .codex/SYNC.md\n3: .cursor/SYNC.md\n4: .devin/SYNC.md\n5: .github/workflows/changed-packet-validation.yml\n6: .github/workflows/command-tree-parity.yml\n7: .github/workflows/markdown-link-integrity.yml\n8: .github/workflows/strict-pass-freshness-report.yml\n9: .gitignore\n10: .opencode/agents/ai-council.md\n11: .opencode/agents/debug.md\n12: .opencode/agents/deep-improvement.md\n13: .opencode/agents/deep-research.md\n14: .opencode/agents/deep-review.md\n15: .opencode/agents/orchestrate.md\n16: .opencode/agents/review.md\n17: .opencode/bin/README.md\n18: .opencode/bin/skill-advisor.cjs\n19: .opencode/bin/speckit-completion.cjs\n20: .opencode/bin/worktree-session.sh\n21: .opencode/commands/create/assets/create-agent-auto.yaml\n22: .opencode/commands/create/assets/create-agent-confirm.yaml\n23: .opencode/commands/create/assets/create-changelog-auto.yaml\n24: .opencode/commands/create/assets/create-changelog-confirm.yaml\n25: .opencode/commands/create/assets/create-command-auto.yaml\n26: .opencode/commands/create/assets/create-readme-auto.yaml\n27: .opencode/commands/create/assets/create-readme-confirm.yaml\n28: .opencode/commands/create/assets/create-skill-auto.yaml\n29: .opencode/commands/create/assets/create-skill-confirm.yaml\n30: .opencode/commands/create/assets/create-skill-parent-auto.yaml\n31: .opencode/commands/create/assets/create-skill-parent-confirm.yaml\n32: .opencode/commands/deep/assets/deep-ai-council-auto.yaml\n33: .opencode/commands/deep/assets/deep-ai-council-confirm.yaml\n34: .opencode/commands/deep/assets/deep-research-auto.yaml\n35: .opencode/commands/deep/assets/deep-research-confirm.yaml\n36: .opencode/commands/deep/assets/deep-research-presentation.txt\n37: .opencode/commands/deep/assets/deep-review-auto.yaml\n38: .opencode/commands/deep/assets/deep-review-confirm.yaml\n39: .opencode/commands/deep/assets/deep-review-presentation.txt\n40: .opencode/commands/doctor/_routes.yaml\n41: .opencode/commands/doctor/assets/doctor-fable-mode.yaml\n42: .opencode/commands/doctor/assets/doctor-runtime-mirrors.yaml\n43: .opencode/commands/doctor/assets/doctor-speckit-retrieval.yaml\n44: .opencode/commands/doctor/assets/doctor-update.yaml\n45: .opencode/commands/doctor/scripts/doctor-runtime-bootstrap.sh\n46: .opencode/commands/doctor/scripts/fable-mode-check.cjs\n47: .opencode/commands/speckit/README.txt\n48: .opencode/commands/speckit/assets/speckit-complete-auto.yaml\n49: .opencode/commands/speckit/assets/speckit-complete-confirm.yaml\n50: .opencode/commands/speckit/assets/speckit-implement-auto.yaml\n51: .opencode/commands/speckit/assets/speckit-implement-confirm.yaml\n52: .opencode/commands/speckit/assets/speckit-plan-auto.yaml\n53: .opencode/commands/speckit/assets/speckit-plan-confirm.yaml\n54: .opencode/commands/speckit/assets/speckit-resume-auto.yaml\n55: .opencode/commands/speckit/assets/speckit-resume-confirm.yaml\n56: .opencode/commands/speckit/save.md\n57: .opencode/commands/speckit/search.md\n58: .opencode/hooks/completion/README.md\n59: .opencode/hooks/dist-freshness/README.md\n60: .opencode/hooks/post-edit-quality/lib/post-edit-router.cjs\n61: .opencode/install-guides/README.md\n62: .opencode/plugins/session-cleanup.js\n63: .opencode/plugins/system-dist-freshness-guard.js\n64: .opencode/plugins/system-speckit-completion.js\n65: .opencode/plugins/tests/system-dist-freshness-guard.test.cjs\n66: .opencode/skills/.state/smart-router-telemetry/README.md\n67: .opencode/skills/cli-external-orchestration/cli-claude-code/SKILL.md\n68: .opencode/skills/cli-external-orchestration/cli-claude-code/assets/prompt-templates.md\n69: .opencode/skills/cli-external-orchestration/cli-codex/SKILL.md\n70: .opencode/skills/cli-external-orchestration/cli-codex/assets/prompt-templates.md\n71: .opencode/skills/cli-external-orchestration/cli-cursor/SKILL.md\n72: .opencode/skills/cli-external-orchestration/cli-devin/SKILL.md\n73: .opencode/skills/cli-external-orchestration/cli-devin/assets/prompt-templates.md\n74: .opencode/skills/cli-external-orchestration/cli-opencode/references/permissions-matrix.md\n75: .opencode/skills/sk-code/shared/references/workflow-verify.md\n76: .opencode/skills/sk-code/sk-code-opencode/assets/checklists/agent-authoring.md\n77: .opencode/skills/sk-code/sk-code-opencode/assets/checklists/command-authoring.md\n78: .opencode/skills/sk-code/sk-code-opencode/assets/checklists/mcp-server-authoring.md\n79: .opencode/skills/sk-code/sk-code-opencode/assets/checklists/skill-authoring.md\n80: .opencode/skills/sk-code/sk-code-opencode/references/javascript/quality-standards/overview-modules-and-docs.md\n81: .opencode/skills/sk-code/sk-code-opencode/references/javascript/style-guide.md\n82: .opencode/skills/sk-code/sk-code-opencode/references/shared/code-organization/overview-and-module-organization.md\n83: .opencode/skills/sk-code/sk-code-opencode/references/shared/universal-patterns/naming-and-commenting.md\n84: .opencode/skills/sk-code/sk-code-opencode/references/shell/quality-standards/overview-and-priority-blockers.md\n85: .opencode/skills/sk-code/sk-code-opencode/references/shell/quality-standards/validation-security-and-shellcheck.md\n86: .opencode/skills/sk-code/sk-code-opencode/references/shell/style-guide/overview-structure-and-naming.md\n87: .opencode/skills/sk-code/sk-code-opencode/reference