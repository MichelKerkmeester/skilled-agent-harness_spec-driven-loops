'%s/%s\\n' \"$canonical_parent\" \"$(basename \"$path\")\"\n105:   fi\n106: }\n107: \n108: _canonical_parent_dir() {\n109:   local path=\"$1\" missing=\"\" base parent canonical\n\n(Showing lines 70-109 of 360. Use offset=110 to continue.)\n</content>","metadata":{"preview":"# Absolute common git dir (shared across every worktree of a clone) — the stable\n# place to keep per-session state that must not live inside any worktree.\n_abs_common() {\n  local root=\"$1\" c\n  c=\"$(git -C \"$root\" rev-parse --git-common-dir 2>/dev/null)\" || return 1\n  case \"$c\" in /*) printf '%s\\n' \"$c\" ;; *) ( cd \"$root\" && cd \"$c\" && pwd -P ) ;; esac\n}\n\n# Shared artifacts symlinked from main into each worktree (deps + compiled output).\n# Override with SPECKIT_WORKTREE_SHARED_PATHS (newline- or colon-separated relative paths).\ndefault_shared_paths() {\n  cat <<'PATHS'\n.opencode/skills/system-spec-kit/node_modules\n.opencode/skills/system-spec-kit/runtime/node_modules\n.opencode/skills/system-spec-kit/runtime/dist\n.opencode/skills/system-spec-kit/runtime/cli/dist\n.opencode/skills/system-spec-kit/runtime/cli/node_modules\nPATHS\n}\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/bin/worktree-session.sh","text":"# Absolute common git dir (shared across every worktree of a clone) — the stable\n# place to keep per-session state that must not live inside any worktree.\n_abs_common() {\n  local root=\"$1\" c\n  c=\"$(git -C \"$root\" rev-parse --git-common-dir 2>/dev/null)\" || return 1\n  case \"$c\" in /*) printf '%s\\n' \"$c\" ;; *) ( cd \"$root\" && cd \"$c\" && pwd -P ) ;; esac\n}\n\n# Shared artifacts symlinked from main into each worktree (deps + compiled output).\n# Override with SPECKIT_WORKTREE_SHARED_PATHS (newline- or colon-separated relative paths).\ndefault_shared_paths() {\n  cat <<'PATHS'\n.opencode/skills/system-spec-kit/node_modules\n.opencode/skills/system-spec-kit/runtime/node_modules\n.opencode/skills/system-spec-kit/runtime/dist\n.opencode/skills/system-spec-kit/runtime/cli/dist\n.opencode/skills/system-spec-kit/runtime/cli/node_modules\nPATHS\n}\n\n_canonical_existing_path() {\n  local path=\"$1\" target parent canonical_parent\n  while [ -L \"$path\" ]; do\n    target=\"$(readlink \"$path\")\" || return 1\n    parent=\"$(dirname \"$path\")\"\n    case \"$target\" in\n      /*) path=\"$target\" ;;\n      *) path=\"$parent/$target\" ;;\n    esac\n  done\n  if [ -d \"$path\" ]; then\n    ( cd \"$path\" && pwd -P )\n  else\n    canonical_parent=\"$(cd \"$(dirname \"$path\")\" 2>/dev/null && pwd -P)\" || return 1\n    printf '%s/%s\\n' \"$canonical_parent\" \"$(basename \"$path\")\"\n  fi\n}\n\n_canonical_parent_dir() {\n  local path=\"$1\" missing=\"\" base parent canonical","lineStart":70,"lineEnd":109,"totalLines":360,"truncated":true}},"title":".opencode/bin/worktree-session.sh","time":{"start":1788625582411,"end":1788625582425}},"id":"prt_07264794a001sqUsU8Gh8vxUqV","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_07264588e001TEFj1446RBdbSp"}}
{"type":"tool_use","timestamp":1788625582427,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_Y1vkdakSuplHFHXXxFoDzLql","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/plugins/system-speckit-completion.js","offset":1,"limit":80},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/plugins/system-speckit-completion.js</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: system-speckit-completion OpenCode Plugin (adapter)               ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: OpenCode transport adapter over the runtime-neutral             ║\n5: // ║          completion-state core. Registers one read-only tool,            ║\n6: // ║          `system_speckit_completion`, that returns a spec folder's inferred  ║\n7: // ║          level, checklist P0/P1/P2 completion with evidence gaps, and    ║\n8: // ║          placeholder completeness percentage merged into one payload --  ║\n9: // ║          replacing a hand-composed, hand-merged pair of Bash calls at    ║\n10: // ║          the COMPLETION VERIFICATION gate. All resolution, exec, and     ║\n11: // ║          fail-open logic lives in the shared core; this file only maps    ║\n12: // ║          the tool args/context in and stringifies the result out. No      ║\n13: // ║          event/before/after hooks, so it cannot touch the TUI, and it    ║\n14: // ║          never writes stdout/stderr -- the tool's string return value    ║\n15: // ║          is the only output channel.                                     ║\n16: // ╚══════════════════════════════════════════════════════════════════════════╝\n17: 'use strict';\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 1. IMPORTS\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: // The completion-state core lives outside .opencode/plugins/ so this file can\n24: // remain a thin, default-export-only OpenCode plugin while a Claude/Bash CLI\n25: // shim consumes the identical core. A .cjs core is imported here as the ESM\n26: // default export, exactly like system-deep-loop-guard.js.\n27: import core from '../skills/system-spec-kit/runtime/cli/lib/completion-state.cjs';\n28: import { tool } from '@opencode-ai/plugin/tool';\n29: \n30: // ─────────────────────────────────────────────────────────────────────────────\n31: // 2. PLUGIN FACTORY\n32: // ─────────────────────────────────────────────────────────────────────────────\n33: \n34: /**\n35:  * Create the system-speckit-completion OpenCode plugin hooks.\n36:  *\n37:  * Read-only by design: the tool cannot write, block, or enforce anything, so\n38:  * there is no fail-open/closed decision to make -- the worst case on any\n39:  * internal failure is a payload whose affected section reports\n40:  * `{status:'unavailable', error}` rather than a thrown error.\n41:  *\n42:  * @param {{ directory?: string } | undefined} ctx - OpenCode plugin context.\n43:  * @returns {Promise<object>} Hooks object for the OpenCode plugin loader.\n44:  */\n45: export default async function MkSpeckitCompletionPlugin(ctx) {\n46:   // Kill-switch: return an empty plugin object so the tool is never\n47:   // registered at all -- the same env var the core checks per-call, read\n48:   // here too so setting it makes the surface a full no-op (no registration),\n49:   // not just a registered tool that always answers `disabled`.\n50:   if (process.env[core.DISABLED_ENV] === '1') {\n51:     return {};\n52:   }\n53: \n54:   const defaultProjectDir = ctx?.directory || process.cwd();\n55: \n56:   return {\n57:     tool: {\n58:       system_speckit_completion: tool({\n59:         description: 'Return a spec folder\\'s inferred level (1/2/3), checklist P0/P1/P2 completion with evidence gaps, and placeholder completeness percentage, merged from check-completion.sh and calculate-completeness.sh. Read-only; never blocks or writes. Set SYSTEM_SPECKIT_COMPLETION_DISABLED=1 to make this a full no-op.',\n60:         args: {\n61:           specFolder: tool.schema.string().optional(),\n62:           strict: tool.schema.boolean().optional(),\n63:         },\n64:         async execute(args, toolContext) {\n65:           // Never throws: computeCompletionState degrades a failing section\n66:           // to {status:'unavailable', error} instead of raising, so this\n67:           // execute() always resolves with a payload string.\n68:           const payload = core.computeCompletionState({\n69:             specFolder: args?.specFolder,\n70:             projectDir: toolContext?.directory || defaultProjectDir,\n71:             strict: args?.strict === true,\n72:           });\n73:           // The tool's return value is the legitimate output channel (unlike\n74:           // stdout/stderr, which corrupt the OpenCode TUI); execute() returns\n75:           // a string per the @opencode-ai/plugin tool() contract, so the\n76:           // merged payload is delivered as pretty-printed JSON text.\n77:           return JSON.stringify(payload, null, 2);\n78:         },\n79:       }),\n80:     },\n\n(Showing lines 1-80 of 90. Use offset=81 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: system-speckit-completion OpenCode Plugin (adapter)               ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: OpenCode transport adapter over the runtime-neutral             ║\n// ║          completion-state core. Registers one read-only tool,            ║\n// ║          `system_speckit_completion`, that returns a spec folder's inferred  ║\n// ║          level, checklist P0/P1/P2 completion with evidence gaps, and    ║\n// ║          placeholder completeness percentage merged into one payload --  ║\n// ║          replacing a hand-composed, hand-merged pair of Bash calls at    ║\n// ║          the COMPLETION VERIFICATION gate. All resolution, exec, and     ║\n// ║          fail-open logic lives in the shared core; this file only maps    ║\n// ║          the tool args/context in and stringifies the result out. No      ║\n// ║          event/before/after hooks, so it cannot touch the TUI, and it    ║\n// ║          never writes stdout/stderr -- the tool's string return value    ║\n// ║          is the only output channel.                                     ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/plugins/system-speckit-completion.js","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: system-speckit-completion OpenCode Plugin (adapter)               ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: OpenCode transport adapter over the runtime-neutral             ║\n// ║          completion-state core. Registers one read-only tool,            ║\n// ║          `system_speckit_completion`, that returns a spec folder's inferred  ║\n// ║          level, checklist P0/P1/P2 completion with evidence gaps, and    ║\n// ║          placeholder completeness percentage merged into one payload --  ║\n// ║          replacing a hand-composed, hand-merged pair of Bash calls at    ║\n// ║          the COMPLETION VERIFICATION gate. All resolution, exec, and     ║\n// ║          fail-open logic lives in the shared core; this file only maps    ║\n// ║          the tool args/context in and stringifies the result out. No      ║\n// ║          event/before/after hooks, so it cannot touch the TUI, and it    ║\n// ║          never writes stdout/stderr -- the tool's string return value    ║\n// ║          is the only output channel.                                     ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// The completion-state core lives outside .opencode/plugins/ so this file can\n// remain a thin, default-export-only OpenCode plugin while a Claude/Bash CLI\n// shim consumes the identical core. A .cjs core is imported here as the ESM\n// default export, exactly like system-deep-loop-guard.js.\nimport core from '../skills/system-spec-kit/runtime/cli/lib/completion-state.cjs';\nimport { tool } from '@opencode-ai/plugin/tool';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. PLUGIN FACTORY\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Create the system-speckit-completion OpenCode plugin hooks.\n *\n * Read-only by design: the tool cannot write, block, or enforce anything, so\n * there is no fail-open/closed decision to make -- the worst case on any\n * internal failure is a payload whose affected section reports\n * `{status:'unavailable', error}` rather than a thrown error.\n *\n * @param {{ directory?: string } | undefined} ctx - OpenCode plugin context.\n * @returns {Promise<object>} Hooks object for the OpenCode plugin loader.\n */\nexport default async function MkSpeckitCompletionPlugin(ctx) {\n  // Kill-switch: return an empty plugin object so the tool is never\n  // registered at all -- the same env var the core checks per-call, read\n  // here too so setting it makes the surface a full no-op (no registration),\n  // not just a registered tool that always answers `disabled`.\n  if (process.env[core.DISABLED_ENV] === '1') {\n    return {};\n  }\n\n  const defaultProjectDir = ctx?.directory || process.cwd();\n\n  return {\n    tool: {\n      system_speckit_completion: tool({\n        description: 'Return a spec folder\\'s inferred level (1/2/3), checklist P0/P1/P2 completion with evidence gaps, and placeholder completeness percentage, merged from check-completion.sh and calculate-completeness.sh. Read-only; never blocks or writes. Set SYSTEM_SPECKIT_COMPLETION_DISABLED=1 to make this a full no-op.',\n        args: {\n          specFolder: tool.schema.string().optional(),\n          strict: tool.schema.boolean().optional(),\n        },\n        async execute(args, toolContext) {\n          // Never throws: computeCompletionState degrades a failing section\n          // to {status:'unavailable', error} instead of raising, so this\n          // execute() always resolves with a payload string.\n          const payload = core.computeCompletionState({\n            specFolder: args?.specFolder,\n            projectDir: toolContext?.directory || defaultProjectDir,\n            strict: args?.strict === true,\n          });\n          // The tool's return value is the legitimate output channel (unlike\n          // stdout/stderr, which corrupt the OpenCode TUI); execute() returns\n          // a string per the @opencode-ai/plugin tool() contract, so the\n          // merged payload is delivered as pretty-printed JSON text.\n          return JSON.stringify(payload, null, 2);\n        },\n      }),\n    },","lineStart":1,"lineEnd":80,"totalLines":90,"truncated":true}},"title":".opencode/plugins/system-speckit-completion.js","time":{"start":1788625582404,"end":1788625582426}},"id":"prt_072647942001AE2f4ZiDAAGFp7","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_07264588e001TEFj1446RBdbSp"}}
{"type":"tool_use","timestamp":1788625582430,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_Ot83se04LoGBsnVOsRDdgzB3","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/hooks/post-edit-quality/lib/post-edit-router.cjs","offset":1,"limit":80},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/hooks/post-edit-quality/lib/post-edit-router.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: post-edit-router core (runtime-neutral policy)                ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: One path-dispatch table deciding which quality checker(s) run   ║\n5: // ║          for an edited file, shared by the Claude PostToolUse hook and   ║\n6: // ║          the OpenCode plugin so the two runtimes cannot drift on policy. ║\n7: // ║          resolveDispatch() is a pure, side-effect-free path/string       ║\n8: // ║          resolver (deterministic given the same inputs); runChecks()     ║\n9: // ║          spawns the resolved checkers under a shared deadline and        ║\n10: // ║          returns bounded, redacted findings. Neither function writes to  ║\n11: // ║          stdout/stderr or throws -- every failure path (missing checker, ║\n12: // ║          non-{0,1} exit, spawn error, exhausted deadline) resolves to no ║\n13: // ║          finding so a bug here can never block the edit it observes.    ║\n14: // ╚══════════════════════════════════════════════════════════════════════════╝\n15: 'use strict';\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 1. IMPORTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const { existsSync } = require('node:fs');\n22: const path = require('node:path');\n23: const { spawnSync } = require('node:child_process');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: // Canonical checker paths (repo-relative). Pinned here so a future move of any\n30: // checker script only requires a one-line update, not a per-runtime hunt.\n31: // Comment-hygiene = sk-code/sk-code-quality (not the older system-spec-kit/rules\n32: // variant); placeholders = spec/ (rules/check-placeholders.sh is sourced-only,\n33: // not CLI-invocable); links = rules/; frontmatter + flowchart canonical live\n34: // under sk-doc.\n35: const CHECKER_RELATIVE_PATHS = {\n36:   commentHygiene: '.opencode/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh',\n37:   flowchart: '.opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh',\n38:   frontmatterVersions: '.opencode/skills/sk-doc/shared/scripts/check-frontmatter-versions.sh',\n39:   placeholders: '.opencode/skills/system-spec-kit/runtime/cli/spec/check-placeholders.sh',\n40:   wikilinks: '.opencode/skills/system-spec-kit/runtime/cli/rules/check-links.sh',\n41:   distStaleness: '.opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh',\n42: };\n43: \n44: const SOURCE_EXTENSIONS = new Set(['.ts', '.tsx', '.js', '.mjs', '.cjs', '.py', '.sh', '.bash', '.jsonc']);\n45: const EXCLUDED_DIR_SEGMENTS = new Set(['dist', 'node_modules', '.git']);\n46: // Mirrors frontmatter-version.mjs's own SCOPE_SUBTREES so the router's match\n47: // stays aligned with what the checker itself actually validates.\n48: const SKILL_SCOPE_SUBTREES = new Set(['references', 'assets', 'feature-catalog', 'manual-testing-playbook']);\n49: const CANONICAL_SKILL_SCOPE_SUBTREES = new Map([\n50:   ['references', 'references'],\n51:   ['assets', 'assets'],\n52:   ['feature-catalog', 'feature-catalog'],\n53:   ['manual-testing-playbook', 'manual-testing-playbook'],\n54: ]);\n55: const SPEC_DOC_BASENAMES = new Set(['spec.md', 'plan.md', 'tasks.md', 'checklist.md', 'decision-record.md']);\n56: const WIKILINKS_ENABLE_ENV = 'SPECKIT_VALIDATE_LINKS';\n57: \n58: const DEFAULT_MAX_FINDING_CHARS = 2000;\n59: const DEFAULT_MAX_FINDINGS = 20;\n60: \n61: // Claude PostToolUse budget -- preserves the pre-existing Python hook's 9s\n62: // host timeout with an 8s per-checker cap and a 0.5s minimum worth running.\n63: const CLAUDE_HOOK_BUDGET_MS = 9000;\n64: const CLAUDE_CHECKER_TIMEOUT_MS = 8000;\n65: const CLAUDE_MIN_CHECKER_MS = 500;\n66: \n67: // OpenCode's tool.execute.after has no host timeout wrapper, so the plugin\n68: // self-imposes a tighter budget to keep a slow or hung checker from ever\n69: // being perceived as blocking tool completion.\n70: const OPENCODE_DEADLINE_MS = 4000;\n71: const OPENCODE_CHECKER_TIMEOUT_MS = 3000;\n72: const OPENCODE_MIN_CHECKER_MS = 300;\n73: \n74: // Fallback defaults used only when a caller invokes runChecks without any of\n75: // the runtime-specific budgets above (e.g. a bare unit test).\n76: const DEFAULT_CHECKER_TIMEOUT_MS = 8000;\n77: const DEFAULT_MIN_CHECKER_MS = 300;\n78: \n79: // Redacts common secret-shaped assignments before any finding text is ever\n80: // logged or printed. Scoped to keyworded assignments (api_key=, token:, ...)\n\n(Showing lines 1-80 of 459. Use offset=81 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: post-edit-router core (runtime-neutral policy)                ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: One path-dispatch table deciding which quality checker(s) run   ║\n// ║          for an edited file, shared by the Claude PostToolUse hook and   ║\n// ║          the OpenCode plugin so the two runtimes cannot drift on policy. ║\n// ║          resolveDispatch() is a pure, side-effect-free path/string       ║\n// ║          resolver (deterministic given the same inputs); runChecks()     ║\n// ║          spawns the resolved checkers under a shared deadline and        ║\n// ║          returns bounded, redacted findings. Neither function writes to  ║\n// ║          stdout/stderr or throws -- every failure path (missing checker, ║\n// ║          non-{0,1} exit, spawn error, exhausted deadline) resolves to no ║\n// ║          finding so a bug here can never block the edit it observes.    ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/hooks/post-edit-quality/lib/post-edit-router.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: post-edit-router core (runtime-neutral policy)                ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: One path-dispatch table deciding which quality checker(s) run   ║\n// ║          for an edited file, shared by the Claude PostToolUse hook and   ║\n// ║          the OpenCode plugin so the two runtimes cannot drift on policy. ║\n// ║          resolveDispatch() is a pure, side-effect-free path/string       ║\n// ║          resolver (deterministic given the same inputs); runChecks()     ║\n// ║          spawns the resolved checkers under a shared deadline and        ║\n// ║          returns bounded, redacted findings. Neither function writes to  ║\n// ║          stdout/stderr or throws -- every failure path (missing checker, ║\n// ║          non-{0,1} exit, spawn error, exhausted deadline) resolves to no ║\n// ║          finding so a bug here can never block the edit it observes.    ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst { existsSync } = require('node:fs');\nconst path = require('node:path');\nconst { spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// Canonical checker paths (repo-relative). Pinned here so a future move of any\n// checker script only requires a one-line update, not a per-runtime hunt.\n// Comment-hygiene = sk-code/sk-code-quality (not the older system-spec-kit/rules\n// variant); placeholders = spec/ (rules/check-placeholders.sh is sourced-only,\n// not CLI-invocable); links = rules/; frontmatter + flowchart canonical live\n// under sk-doc.\nconst CHECKER_RELATIVE_PATHS = {\n  commentHygiene: '.opencode/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh',\n  flowchart: '.opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh',\n  frontmatterVersions: '.opencode/skills/sk-doc/shared/scripts/check-frontmatter-versions.sh',\n  placeholders: '.opencode/skills/system-spec-kit/runtime/cli/spec/check-placeholders.sh',\n  wikilinks: '.opencode/skills/system-spec-kit/runtime/cli/rules/check-links.sh',\n  distStaleness: '.opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh',\n};\n\nconst SOURCE_EXTENSIONS = new Set(['.ts', '.tsx', '.js', '.mjs', '.cjs', '.py', '.sh', '.bash', '.jsonc']);\nconst EXCLUDED_DIR_SEGMENTS = new Set(['dist', 'node_modules', '.git']);\n// Mirrors frontmatter-version.mjs's own SCOPE_SUBTREES so the router's match\n// stays aligned with what the checker itself actually validates.\nconst SKILL_SCOPE_SUBTREES = new Set(['references', 'assets', 'feature-catalog', 'manual-testing-playbook']);\nconst CANONICAL_SKILL_SCOPE_SUBTREES = new Map([\n  ['references', 'references'],\n  ['assets', 'assets'],\n  ['feature-catalog', 'feature-catalog'],\n  ['manual-testing-playbook', 'manual-testing-playbook'],\n]);\nconst SPEC_DOC_BASENAMES = new Set(['spec.md', 'plan.md', 'tasks.md', 'checklist.md', 'decision-record.md']);\nconst WIKILINKS_ENABLE_ENV = 'SPECKIT_VALIDATE_LINKS';\n\nconst DEFAULT_MAX_FINDING_CHARS = 2000;\nconst DEFAULT_MAX_FINDINGS = 20;\n\n// Claude PostToolUse budget -- preserves the pre-existing Python hook's 9s\n// host timeout with an 8s per-checker cap and a 0.5s minimum worth running.\nconst CLAUDE_HOOK_BUDGET_MS = 9000;\nconst CLAUDE_CHECKER_TIMEOUT_MS = 8000;\nconst CLAUDE_MIN_CHECKER_MS = 500;\n\n// OpenCode's tool.execute.after has no host timeout wrapper, so the plugin\n// self-imposes a tighter budget to keep a slow or hung checker from ever\n// being perceived as blocking tool completion.\nconst OPENCODE_DEADLINE_MS = 4000;\nconst OPENCODE_CHECKER_TIMEOUT_MS = 3000;\nconst OPENCODE_MIN_CHECKER_MS = 300;\n\n// Fallback defaults used only when a caller invokes runChecks without any of\n// the runtime-specific budgets above (e.g. a bare unit test).\nconst DEFAULT_CHECKER_TIMEOUT_MS = 8000;\nconst DEFAULT_MIN_CHECKER_MS = 300;\n\n// Redacts common secret-shaped assignments before any finding text is ever\n// logged or printed. Scoped to keyworded assignments (api_key=, token:, ...)","lineStart":1,"lineEnd":80,"totalLines":459,"truncated":true}},"title":".opencode/hooks/post-edit-quality/lib/post-edit-router.cjs","time":{"start":1788625582407,"end":1788625582429}},"id":"prt_072647946001UuPvUORLtg9xu7","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_07264588e001TEFj1446RBdbSp"}}
