acking)\"\n324:       },\n325:       {\n326:         \"name\": \"git-branch\",\n327:         \"path\": \"runtime/cli/lib/git-branch.sh\",\n328:         \"description\": \"Git branch utilities\"\n329:       },\n330:       {\n331:         \"name\": \"template-utils\",\n332:         \"path\": \"runtime/cli/lib/template-utils.sh\",\n333:         \"description\": \"Template processing helpers\"\n334:       }\n335:     ],\n336:     \"javascript\": [\n337:       {\n338:         \"name\": \"embeddings\",\n339:         \"path\": \"runtime/cli/dist/lib/embeddings.js\",\n340:         \"description\": \"Re-exports from ../../shared/embeddings\"\n341:       },\n342:       {\n343:         \"name\": \"trigger-extractor\",\n344:         \"path\": \"runtime/cli/dist/lib/trigger-extractor.js\",\n345:         \"description\": \"Re-exports from ../../shared/trigger-extractor\"\n346:       },\n347:       {\n348:         \"name\": \"semantic-summarizer\",\n349:         \"path\": \"runtime/cli/dist/lib/semantic-summarizer.js\",\n350:         \"description\": \"Message classification\"\n351:       },\n352:       {\n353:         \"name\": \"content-filter\",\n354:         \"path\": \"runtime/cli/dist/lib/content-filter.js\",\n355:         \"description\": \"Three-stage content filtering\"\n356:       },\n357:       {\n358:         \"name\": \"anchor-generator\",\n359:         \"path\": \"runtime/cli/dist/lib/anchor-generator.js\",\n360:         \"description\": \"ANCHOR ID generation\"\n361:       },\n362:       {\n363:         \"name\": \"flowchart-generator\",\n364:         \"path\": \"runtime/cli/dist/lib/flowchart-generator.js\",\n365:         \"description\": \"ASCII flowcharts\"\n366:       },\n367:       {\n368:         \"name\": \"ascii-boxes\",\n369:         \"path\": \"runtime/cli/dist/lib/ascii-boxes.js\",\n370:         \"description\": \"ASCII box drawing\"\n371:       },\n372:       {\n373:         \"name\": \"simulation-factory\",\n374:         \"path\": \"runtime/cli/dist/lib/simulation-factory.js\",\n375:         \"description\": \"Fallback data generation\"\n376:       }\n377:     ]\n378:   },\n379:   \"metadata\": {\n380:     \"totalScripts\": 13,\n381:     \"essentialScripts\": 7,\n382:     \"optionalScripts\": 6,\n383:     \"totalRules\": 14,\n384:     \"essentialRules\": 3,\n385:     \"totalLibraries\": 12,\n386:     \"categories\": {\n387:       \"memory\": [\"generate-context\", \"test-embeddings-factory\"],\n388:       \"validation\": [\"validate-spec\", \"check-completion\", \"check-prerequisites\", \"test-validation\"],\n389:       \"lifecycle\": [\"create-spec-folder\", \"archive-spec\", \"recommend-level\", \"calculate-completeness\"],\n390:       \"routing\": [],\n391:       \"utilities\": [\"common\"]\n392:     }\n393:   }\n394: }\n\n(End of file - total 394 lines)\n</content>","metadata":{"preview":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Spec Kit Script Registry - Centralized catalog of all scripts for dynamic discovery\",\n  \"lastUpdated\": \"2025-12-31\",\n  \"scripts\": [\n    {\n      \"name\": \"generate-context\",\n      \"path\": \"runtime/cli/dist/continuity/generate-context.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate the saved context artifact with ANCHOR format and refresh the packet's graph metadata\",\n      \"trigger\": [\"save context\", \"save memory\", \"/speckit:save\"],\n      \"calledBy\": [\"AI Assistant\", \"Command YAML\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"mode1\": \"JSON data file path (e.g., /tmp/save-context-data-<session-id>.json)\",\n        \"mode2\": \"Spec folder path (e.g., 007-feature/)\"\n      },\n      \"outputs\": [\"memory/*.md\", \"metadata.json\"],\n      \"gate\": \"Memory Save Rule\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json","text":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Spec Kit Script Registry - Centralized catalog of all scripts for dynamic discovery\",\n  \"lastUpdated\": \"2025-12-31\",\n  \"scripts\": [\n    {\n      \"name\": \"generate-context\",\n      \"path\": \"runtime/cli/dist/continuity/generate-context.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate the saved context artifact with ANCHOR format and refresh the packet's graph metadata\",\n      \"trigger\": [\"save context\", \"save memory\", \"/speckit:save\"],\n      \"calledBy\": [\"AI Assistant\", \"Command YAML\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"mode1\": \"JSON data file path (e.g., /tmp/save-context-data-<session-id>.json)\",\n        \"mode2\": \"Spec folder path (e.g., 007-feature/)\"\n      },\n      \"outputs\": [\"memory/*.md\", \"metadata.json\"],\n      \"gate\": \"Memory Save Rule\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"lib/embeddings.js\", \"lib/anchor-generator.js\", \"lib/content-filter.js\"]\n    },\n    {\n      \"name\": \"validate-spec\",\n      \"path\": \"runtime/cli/spec/validate.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Validate spec folder contents against documentation level requirements\",\n      \"trigger\": [\"validate spec\", \"check spec\"],\n      \"calledBy\": [\"AI Assistant\", \"CI/CD Pipeline\", \"Pre-commit Hook\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --strict, --verbose, --quiet\"\n      },\n      \"outputs\": [\"Pass/warn/fail status\", \"JSON report (with --json)\"],\n      \"gate\": \"Completion Verification\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"rules/*.sh\", \"lib/shell-common.sh\"]\n    },\n    {\n      \"name\": \"check-completion\",\n      \"path\": \"runtime/cli/spec/check-completion.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Completion Verification Rule enforcement - verify checklist items are complete before claiming done\",\n      \"trigger\": [\"check completion\", \"verify complete\", \"claiming done\"],\n      \"calledBy\": [\"AI Assistant\", \"Completion Verification Rule\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --strict, --quiet\"\n      },\n      \"outputs\": [\"Pass/fail status\", \"Incomplete items list\"],\n      \"gate\": \"Completion Verification Rule\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"upgrade-level\",\n      \"path\": \"runtime/cli/spec/upgrade-level.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Upgrade existing spec folders to higher documentation levels with backup and rollback. Post-upgrade: AI must auto-populate injected placeholder content from existing spec context\",\n      \"trigger\": [\"upgrade level\", \"level upgrade\", \"promote spec level\"],\n      \"calledBy\": [\"AI Assistant\", \"Developer\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Spec folder path, --to <2|3|3+>\",\n        \"options\": \"--dry-run, --verbose, --json, --keep-backups\"\n      },\n      \"outputs\": [\"Upgraded spec docs\", \"Backup directory\", \"JSON result with --json\"],\n      \"gate\": \"Documentation Level Upgrade\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"runtime/cli/lib/shell-common.sh\", \"templates/\"]\n    },\n    {\n      \"name\": \"check-prerequisites\",\n      \"path\": \"runtime/cli/setup/check-prerequisites.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Validate spec folder exists and contains required files for its level\",\n      \"trigger\": [\"check prerequisites\", \"verify files\"],\n      \"calledBy\": [\"AI Assistant\", \"Implementation Phase\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"options\": \"--json, --require-tasks, --include-tasks, --paths-only\"\n      },\n      \"outputs\": [\"FEATURE_DIR path\", \"AVAILABLE_DOCS list\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"calculate-completeness\",\n      \"path\": \"runtime/cli/spec/calculate-completeness.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Calculate percentage of template placeholders replaced with real content\",\n      \"trigger\": [\"calculate progress\", \"completeness\"],\n      \"calledBy\": [\"AI Assistant\", \"Progress Tracking\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--verbose, --json, --file <path>, --quality\"\n      },\n      \"outputs\": [\"Completeness percentage\", \"Per-file breakdown (with --verbose)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"test-validation\",\n      \"path\": \"runtime/cli/tests/test-validation.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Test runner for validate-spec.sh against fixture spec folders\",\n      \"trigger\": [\"test validation\", \"run tests\"],\n      \"calledBy\": [\"Developer\", \"CI/CD Pipeline\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"options\": \"-v (verbose), -t NAME (single test), -c CATEGORY, -l (list), -h (help)\"\n      },\n      \"outputs\": [\"Test pass/fail results\", \"Coverage report\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"validate-spec.sh\", \"test-fixtures/\"]\n    },\n    {\n      \"name\": \"create-spec-folder\",\n      \"path\": \"runtime/cli/spec/create.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Create new spec folders with appropriate templates based on documentation level\",\n      \"trigger\": [\"create spec\", \"new spec folder\", \"Option B\"],\n      \"calledBy\": [\"AI Assistant\", \"Gate 3 (Option B)\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Feature description\",\n        \"options\": \"--short-name, --level (1/2/3), --number, --skip-branch, --sharded, --subfolder\"\n      },\n      \"outputs\": [\"New spec folder with templates\", \"Git branch (optional)\"],\n      \"gate\": \"Gate 3 (Spec Folder Creation)\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"templates/\"]\n    },\n    {\n      \"name\": \"generate-nested-changelog\",\n      \"path\": \"runtime/cli/dist/spec-folder/nested-changelog.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate packet-local changelog content for a root spec folder or a nested phase child\",\n      \"trigger\": [\"nested changelog\", \"packet changelog\", \"phase changelog\", \"spec changelog\"],\n      \"calledBy\": [\"AI Assistant\", \"Completion workflows\", \"Create changelog command\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --write, --mode <auto|root|phase>, --output <path>\"\n      },\n      \"outputs\": [\"Rendered markdown\", \"Nested changelog payload\", \"packet-local changelog file (with --write)\"],\n      \"gate\": \"Completion workflow\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"runtime/cli/spec-folder/*.ts\", \"templates/changelog/\"]\n    },\n    {\n      \"name\": \"recommend-level\",\n      \"path\": \"runtime/cli/spec/recommend-level.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Recommend documentation level based on task complexity factors\",\n      \"trigger\": [\"recommend level\", \"what level\"],\n      \"calledBy\": [\"AI Assistant\", \"Gate 3\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"options\": \"--loc <number>, --files <number>, --auth, --api, --db, --architectural, --json\"\n      },\n      \"outputs\": [\"Recommended level (0-3)\", \"Score breakdown\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"archive-spec\",\n      \"path\": \"runtime/cli/spec/archive.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Move completed spec folders to archive, keeping specs/ directory clean\",\n      \"trigger\": [\"archive spec\", \"move to archive\"],\n      \"calledBy\": [\"AI Assistant\", \"Cleanup\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--list, --restore <archived-folder>\"\n      },\n      \"outputs\": [\"Archived folder path\", \"Archive listing (with --list)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"calculate-completeness.sh\"]\n    },\n    {\n      \"name\": \"common\",\n      \"path\": \"runtime/cli/common.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Repository and branch utilities - get_repo_root(), get_current_branch()\",\n      \"trigger\": [],\n      \"calledBy\": [\"Other scripts\"],\n      \"essential\": true,\n      \"inputs\": {},\n      \"outputs\": [\"Utility functions\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": [],\n      \"isLibrary\": true\n    },\n    {\n      \"name\": \"test-embeddings-factory\",\n      \"path\": \"runtime/cli/tests/test-embeddings-factory.cjs\",\n      \"type\": \"node\",\n      \"description\": \"Test and verify embedding provider configuration\",\n      \"trigger\": [\"test embeddings\", \"verify provider\"],\n      \"calledBy\": [\"Developer\", \"Debugging\"],\n      \"essential\": false,\n      \"inputs\": {},\n      \"outputs\": [\"Provider status\", \"Configuration details\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"lib/embeddings/\"]\n    },\n    {\n      \"name\": \"check-markdown-links\",\n      \"path\": \"runtime/cli/check-markdown-links.cjs\",\n      \"type\": \"node\",\n      \"description\": \"Repo-wide markdown-link integrity guard over skills/commands/agents; strips fenced + inline code; complements the wikilink checker; exit 1 on any broken link\",\n      \"trigger\": [\"check markdown links\", \"link integrity\", \"broken links\"],\n      \"calledBy\": [\"CI/CD Pipeline\", \"Developer\"],\n      \"essential\": false,\n      \"inputs\": { \"optional\": \"--self-test (assert inline-code handling; no filesystem walk)\" },\n      \"outputs\": [\"Broken-link report\", \"Exit code (0 clean / 1 broken)\"],\n      \"gate\": null,\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"node:fs\", \"node:path\"]\n    }\n  ],\n  \"rules\": [\n    {\n      \"name\": \"check-files\",\n      \"path\": \"runtime/cli/rules/check-files.sh\",\n      \"type\": \"bash\",\n      \"description\": \"FILE_EXISTS rule - validates required files exist for documentation level\",\n      \"severity\": \"error\",\n      \"essential\": true,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-folder-naming\",\n      \"path\": \"runtime/cli/rules/check-folder-naming.sh\",\n      \"type\": \"bash\",\n      \"description\": \"FOLDER_NAMING rule - validates ###-short-name convention\",\n      \"severity\": \"error\",\n      \"essential\": true,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-frontmatter\",\n      \"path\": \"runtime/cli/rules/check-frontmatter.sh\",\n      \"type\": \"bash\",\n      \"description\": \"FRONTMATTER_VALID rule - validates YAML frontmatter structure\",\n      \"severity\": \"warning\",\n      \"essential\": false,\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"name\": \"check-placeholders\",\n      \"path\": \"runtime/cli/rules/check-placeholders.sh\",\n      \"type\": \"bash\",\n      \"description\": \"PLACEHOLDER_FILLED rule - detects unfilled [TODO:], [TBD], {{mustache}} placeholders\",\n      \"severity\": \"warning\",\n      \"essential\": false,\n      \"ve