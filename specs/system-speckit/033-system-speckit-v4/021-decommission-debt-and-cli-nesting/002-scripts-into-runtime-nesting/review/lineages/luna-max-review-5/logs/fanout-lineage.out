RY.length > 0)\n1026:         ? cleanContaminationText(collectedData.SUMMARY) : collectedData.SUMMARY;\n1027:       // Clean _JSON_SESSION_SUMMARY (raw sessionSummary title candidate).\n1028:       const preCleanedJsonSummary = (typeof (collectedData as Record<string, unknown>)._JSON_SESSION_SUMMARY === 'string' &&\n1029:         ((collectedData as Record<string, unknown>)._JSON_SESSION_SUMMARY as string).length > 0)\n1030:         ? cleanContaminationText((collectedData as Record<string, unknown>)._JSON_SESSION_SUMMARY as string)\n1031:         : (collectedData as Record<string, unknown>)._JSON_SESSION_SUMMARY;\n1032:       // Clean _manualDecisions array entries.\n1033:       const preCleanedDecisions = Array.isArray((collectedData as Record<string, unknown>)._manualDecisions)\n1034:         ? ((collectedData as Record<string, unknown>)._manualDecisions as unknown[]).map((d: unknown) => {\n1035:             if (typeof d === 'string') return cleanContaminationText(d);\n1036:             if (d && typeof d === 'object') {\n1037:               const obj = { ...(d as Record<string, unknown>) };\n1038:               for (const key of Object.keys(obj)) {\n1039:                 if (typeof obj[key] === 'string') obj[key] = cleanContaminationText(obj[key] as string);\n1040:               }\n1041:               return obj;\n1042:             }\n1043:             return d;\n1044:           })\n1045:         : (collectedData as Record<string, unknown>)._manualDecisions;\n1046:       // Clean recentContext array entries.\n1047:       const preCleanedRecentCtx = Array.isArray(collectedData.recentContext)\n1048:         ? collectedData.recentContext.map((entry) => ({\n1049:             ...entry,\n1050:             request: typeof entry.request === 'string' ? cleanContaminationText(entry.request) : entry.request,\n1051:             learning: typeof entry.learning === 'string' ? cleanContaminationText(entry.learning) : entry.learning,\n1052:           }))\n1053:         : collected