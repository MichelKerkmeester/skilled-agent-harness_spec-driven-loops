ce (covered in runtime_descend_class)\"\n    }\n  ],\n  \"excluded_historical\": {\n    \"specs_outside_this_packet\": \"5040 files (system-spec-kit/scripts) + 944 (scripts/dist), overlapping; never edited\",\n    \"changelog_dirs_any_depth\": \".opencode/skills/system-spec-kit/changelog/ (20 files)\",\n    \"benchmark_dirs_any_depth\": \".opencode/skills/{sk-code,cli-external-orchestration}/benchmark/reports/** (7 files)\",\n    \"out_of_scope_gitignored_copies\": [\n      \"barter/ai-speckit/coder/.opencode/install_guides/install_scripts/install-spec-kit-memory.sh (symlink, vendored subproject)\",\n      \".worktrees/022-012-runtime-enablement-build/.opencode/install-guides/install-scripts/install-spec-kit-memory.sh (symlink, different branch checkout)\"\n    ]\n  }\n}","lineStart":1,"lineEnd":266,"totalLines":266,"truncated":false}},"title":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/path-map.json","time":{"start":1788624859277,"end":1788624859286}},"id":"prt_07259708c001uywVzVszEmGmSG","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0725940fb001A8okWvJ3AkmwUX"}}
