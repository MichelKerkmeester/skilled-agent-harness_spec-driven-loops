{"type":"tool_use","timestamp":1788625646043,"sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","part":{"type":"tool","tool":"read","callID":"call_hehTRqcYhNuKEzxxgRwJS601","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/test-export-contracts.js","offset":1,"limit":240},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/test-export-contracts.js</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: /**\n5:  * Test: Export Contract Verification\n6:  *\n7:  * Covers:\n8:  *   T3 - Export contract verification (handlers, lib, barrels)\n9:  *   T6 - Backward-compat alias verification (snake_case in handler exports)\n10:  *\n11:  * Uses source-level analysis (no require) to avoid DB dependencies.\n12:  */\n13: \n14: const fs = require('fs');\n15: const path = require('path');\n16: \n17: // ───────────────────────────────────────────────────────────────\n18: // 1. PATHS\n19: // ───────────────────────────────────────────────────────────────\n20: const RUNTIME_ROOT = path.resolve(__dirname, '..', '..');\n21: const SCRIPTS_ROOT = path.resolve(__dirname, '..');\n22: const HANDLERS_DIR = path.join(RUNTIME_ROOT, 'handlers');\n23: const BASE_ROOT = path.resolve(RUNTIME_ROOT, '..');\n24: \n25: // ───────────────────────────────────────────────────────────────\n26: // 2. TEST STATE\n27: // ───────────────────────────────────────────────────────────────\n28: let passed = 0;\n29: let failed = 0;\n30: let skipped = 0;\n31: const failures = [];\n32: \n33: function pass(msg) { passed++; console.log(`  \\u2713 ${msg}`); }\n34: function fail(msg, detail) {\n35:   failed++;\n36:   failures.push({ msg, detail });\n37:   console.log(`  \\u2717 ${msg}`);\n38:   if (detail) console.log(`    ${detail}`);\n39: }\n40: function skip(msg) { skipped++; console.log(`  \\u25CB ${msg}`); }\n41: function section(name) { console.log(`\\n\\u2501\\u2501 ${name} ${'\\u2501'.repeat(Math.max(0, 56 - name.length))}`); }\n42: \n43: function rel(filePath) {\n44:   return path.relative(BASE_ROOT, filePath);\n45: }\n46: \n47: // ───────────────────────────────────────────────────────────────\n48: // 3. HELPERS\n49: // ───────────────────────────────────────────────────────────────\n50: function toSnakeCase(str) {\n51:   return str.replace(/([A-Z])/g, '_$1').toLowerCase();\n52: }\n53: \n54: /**\n55:  * Extract exported keys from:\n56:  *  - CJS module.exports = { ... }\n57:  *  - ESM export default { ... }\n58:  *  - ESM named exports: export { a, b as c } [from '...']\n59:  *  - Direct ESM declarations: export function foo() {}\n60:  * Returns array of { key, value, line } objects.\n61:  */\n62: function extractExportKeys(source) {\n63:   const keys = [];\n64:   const lines = source.split('\\n');\n65: \n66:   // 1) CJS/ESM default object export blocks\n67:   let inExports = false;\n68:   let braceDepth = 0;\n69:   for (let i = 0; i < lines.length; i++) {\n70:     const line = lines[i];\n71: \n72:     if (/module\\.exports\\s*=\\s*\\{/.test(line) || /export\\s+default\\s*\\{/.test(line)) {\n73:       inExports = true;\n74:       braceDepth = (line.match(/\\{/g) || []).length - (line.match(/\\}/g) || []).length;\n75:       const afterBrace = line.substring(line.indexOf('{') + 1);\n76:       extractKeysFromLine(afterBrace, i, keys);\n77:       continue;\n78:     }\n79: \n80:     if (inExports) {\n81:       braceDepth += (line.match(/\\{/g) || []).length - (line.match(/\\}/g) || []).length;\n82:       if (braceDepth <= 0) {\n83:         inExports = false;\n84:         continue;\n85:       }\n86: \n87:       extractKeysFromLine(line, i, keys);\n88:     }\n89:   }\n90: \n91:   // 2) ESM named export blocks (supports multiline and \"from\" re-export)\n92:   const exportBlockRegex = /export\\s*\\{([\\s\\S]*?)\\}\\s*(?:from\\s+['\"][^'\"]+['\"])?\\s*;/g;\n93:   for (const match of source.matchAll(exportBlockRegex)) {\n94:     const exportClause = match[1] || '';\n95:     const lineNum = source.slice(0, match.index).split('\\n').length;\n96:     extractKeysFromExportClause(exportClause, lineNum, keys);\n97:   }\n98: \n99:   // 3) Direct exported declarations\n100:   const directExportRegexes = [\n101:     /export\\s+(?:async\\s+)?function\\s+(\\w+)/g,\n102:     /export\\s+(?:const|let|var|class)\\s+(\\w+)/g,\n103:   ];\n104:   for (const regex of directExportRegexes) {\n105:     for (const match of source.matchAll(regex)) {\n106:       const lineNum = source.slice(0, match.index).split('\\n').length;\n107:       keys.push({ key: match[1], value: match[1], line: lineNum });\n108:     }\n109:   }\n110: \n111:   // Deduplicate noisy duplicates from multiple export forms\n112:   const seen = new Set();\n113:   const deduped = [];\n114:   for (const item of keys) {\n115:     const signature = `${item.key}:${item.value}`;\n116:     if (seen.has(signature)) continue;\n117:     seen.add(signature);\n118:     deduped.push(item);\n119:   }\n120: \n121:   return deduped;\n122: }\n123: \n124: function extractKeysFromLine(line, lineNum, keys) {\n125:   const trimmed = line.trim();\n126:   if (!trimmed || trimmed.startsWith('//') || trimmed.startsWith('*') || trimmed.startsWith('...')) return;\n127: \n128:   // Key-value: `handleMemorySearch: handleMemorySearch,`\n129:   const kvMatch = trimmed.match(/^(\\w+)\\s*:\\s*(\\w+)\\s*,?\\s*(?:\\/\\/.*)?$/);\n130:   if (kvMatch) {\n131:     keys.push({ key: kvMatch[1], value: kvMatch[2], line: lineNum + 1 });\n132:     return;\n133:   }\n134: \n135:   // Shorthand: `handleMemorySearch,`\n136:   const shortMatch = trimmed.match(/^(\\w+)\\s*,?\\s*(?:\\/\\/.*)?$/);\n137:   if (shortMatch) {\n138:     keys.push({ key: shortMatch[1], value: shortMatch[1], line: lineNum + 1 });\n139:   }\n140: }\n141: \n142: function extractKeysFromExportClause(exportClause, lineNum, keys) {\n143:   const entries = exportClause\n144:     .split(',')\n145:     .map(entry => entry.replace(/\\/\\*.*?\\*\\//g, '').replace(/\\/\\/.*$/g, '').trim())\n146:     .filter(Boolean);\n147: \n148:   for (const entry of entries) {\n149:     const aliasMatch = entry.match(/^(\\w+)\\s+as\\s+(\\w+)$/);\n150:     if (aliasMatch) {\n151:       keys.push({ key: aliasMatch[2], value: aliasMatch[1], line: lineNum });\n152:       continue;\n153:     }\n154: \n155:     const plainMatch = entry.match(/^(\\w+)$/);\n156:     if (plainMatch) {\n157:       keys.push({ key: plainMatch[1], value: plainMatch[1], line: lineNum });\n158:     }\n159:   }\n160: }\n161: \n162: // ───────────────────────────────────────────────────────────────\n163: // 4. HANDLER FILES AND EXPECTED MINIMUM HANDLE* FUNCTION COUNTS\n164: // ───────────────────────────────────────────────────────────────\n165: const HANDLER_FILES = [\n166:   { file: 'causal-graph.ts', minHandleFuncs: 3 },\n167:   { file: 'checkpoints.ts', minHandleFuncs: 3 },\n168:   { file: 'memory-context.ts', minHandleFuncs: 1 },\n169:   { file: 'memory-crud.ts', minHandleFuncs: 4 },\n170:   { file: 'memory-index.ts', minHandleFuncs: 1 },\n171:   { file: 'memory-save.ts', minHandleFuncs: 1 },\n172:   { file: 'memory-search.ts', minHandleFuncs: 1 },\n173:   { file: 'memory-triggers.ts', minHandleFuncs: 1 },\n174:   { file: 'session-learning.ts', minHandleFuncs: 3 },\n175: ];\n176: \n177: // ───────────────────────────────────────────────────────────────\n178: // 5. BARREL FILES AND EXPECTED KEY EXPORTS\n179: // ───────────────────────────────────────────────────────────────\n180: const BARREL_FILES = [\n181:   {\n182:     file: 'runtime/cli/dist/core/index.js',\n183:     root: SCRIPTS_ROOT,\n184:     expectedKeys: [], // config re-exports vary; just check non-empty\n185:     minExports: 1,\n186:   },\n187:   {\n188:     file: 'runtime/cli/dist/extractors/index.js',\n189:     root: SCRIPTS_ROOT,\n190:     expectedKeys: [],\n191:     minExports: 3,\n192:   },\n193:   {\n194:     file: 'runtime/cli/dist/loaders/index.js',\n195:     root: SCRIPTS_ROOT,\n196:     expectedKeys: ['loadCollectedData'],\n197:     minExports: 1,\n198:   },\n199:   {\n200:     file: 'runtime/cli/dist/renderers/index.js',\n201:     root: SCRIPTS_ROOT,\n202:     expectedKeys: ['populateTemplate', 'renderTemplate'],\n203:     minExports: 2,\n204:   },\n205:   {\n206:     file: 'runtime/cli/dist/spec-folder/index.js',\n207:     root: SCRIPTS_ROOT,\n208:     expectedKeys: ['detectSpecFolder', 'setupContextDirectory'],\n209:     minExports: 3,\n210:   },\n211:   {\n212:     file: 'runtime/cli/dist/utils/index.js',\n213:     root: SCRIPTS_ROOT,\n214:     expectedKeys: [],\n215:     minExports: 3,\n216:   },\n217: ];\n218: \n219: // ════════════════════════════════════════════════════════════════════════\n220: // EXPORT CONTRACT VERIFICATION\n221: // ════════════════════════════════════════════════════════════════════════\n222: function t3ExportContracts() {\n223:   section('T3: Export Contract Verification - Handlers');\n224: \n225:   for (const { file, minHandleFuncs } of HANDLER_FILES) {\n226:     const filePath = path.join(HANDLERS_DIR, file);\n227:     if (!fs.existsSync(filePath)) {\n228:       fail(`Handler missing: ${file}`, 'File does not exist');\n229:       continue;\n230:     }\n231: \n232:     const source = fs.readFileSync(filePath, 'utf8');\n233:     const exportKeys = extractExportKeys(source);\n234:     const handleKeys = exportKeys.filter(k => /^handle[A-Z]/.test(k.key));\n235: \n236:     if (handleKeys.length >= minHandleFuncs) {\n237:       pass(`${file}: ${handleKeys.length} handle* exports (min: ${minHandleFuncs})`);\n238:     } else {\n239:       fail(`${file}: only ${handleKeys.length} handle* exports (expected >= ${minHandleFuncs})`,\n240:         `Found: ${handleKeys.map(k => k.key).join(', ') || 'none'}`);\n\n(Showing lines 1-240 of 391. Use offset=241 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\n/**\n * Test: Export Contract Verification\n *\n * Covers:\n *   T3 - Export contract verification (handlers, lib, barrels)\n *   T6 - Backward-compat alias verification (snake_case in handler exports)\n *\n * Uses source-level analysis (no require) to avoid DB dependencies.\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\n// ───────────────────────────────────────────────────────────────\n// 1. PATHS\n// ───────────────────────────────────────────────────────────────\nconst RUNTIME_ROOT = path.resolve(__dirname, '..', '..');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/test-export-contracts.js","text":"#!/usr/bin/env node\n'use strict';\n\n/**\n * Test: Export Contract Verification\n *\n * Covers:\n *   T3 - Export contract verification (handlers, lib, barrels)\n *   T6 - Backward-compat alias verification (snake_case in handler exports)\n *\n * Uses source-level analysis (no require) to avoid DB dependencies.\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\n// ───────────────────────────────────────────────────────────────\n// 1. PATHS\n// ───────────────────────────────────────────────────────────────\nconst RUNTIME_ROOT = path.resolve(__dirname, '..', '..');\nconst SCRIPTS_ROOT = path.resolve(__dirname, '..');\nconst HANDLERS_DIR = path.join(RUNTIME_ROOT, 'handlers');\nconst BASE_ROOT = path.resolve(RUNTIME_ROOT, '..');\n\n// ───────────────────────────────────────────────────────────────\n// 2. TEST STATE\n// ───────────────────────────────────────────────────────────────\nlet passed = 0;\nlet failed = 0;\nlet skipped = 0;\nconst failures = [];\n\nfunction pass(msg) { passed++; console.log(`  \\u2713 ${msg}`); }\nfunction fail(msg, detail) {\n  failed++;\n  failures.push({ msg, detail });\n  console.log(`  \\u2717 ${msg}`);\n  if (detail) console.log(`    ${detail}`);\n}\nfunction skip(msg) { skipped++; console.log(`  \\u25CB ${msg}`); }\nfunction section(name) { console.log(`\\n\\u2501\\u2501 ${name} ${'\\u2501'.repeat(Math.max(0, 56 - name.length))}`); }\n\nfunction rel(filePath) {\n  return path.relative(BASE_ROOT, filePath);\n}\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\nfunction toSnakeCase(str) {\n  return str.replace(/([A-Z])/g, '_$1').toLowerCase();\n}\n\n/**\n * Extract exported keys from:\n *  - CJS module.exports = { ... }\n *  - ESM export default { ... }\n *  - ESM named exports: export { a, b as c } [from '...']\n *  - Direct ESM declarations: export function foo() {}\n * Returns array of { key, value, line } objects.\n */\nfunction extractExportKeys(source) {\n  const keys = [];\n  const lines = source.split('\\n');\n\n  // 1) CJS/ESM default object export blocks\n  let inExports = false;\n  let braceDepth = 0;\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n\n    if (/module\\.exports\\s*=\\s*\\{/.test(line) || /export\\s+default\\s*\\{/.test(line)) {\n      inExports = true;\n      braceDepth = (line.match(/\\{/g) || []).length - (line.match(/\\}/g) || []).length;\n      const afterBrace = line.substring(line.indexOf('{') + 1);\n      extractKeysFromLine(afterBrace, i, keys);\n      continue;\n    }\n\n    if (inExports) {\n      braceDepth += (line.match(/\\{/g) || []).length - (line.match(/\\}/g) || []).length;\n      if (braceDepth <= 0) {\n        inExports = false;\n        continue;\n      }\n\n      extractKeysFromLine(line, i, keys);\n    }\n  }\n\n  // 2) ESM named export blocks (supports multiline and \"from\" re-export)\n  const exportBlockRegex = /export\\s*\\{([\\s\\S]*?)\\}\\s*(?:from\\s+['\"][^'\"]+['\"])?\\s*;/g;\n  for (const match of source.matchAll(exportBlockRegex)) {\n    const exportClause = match[1] || '';\n    const lineNum = source.slice(0, match.index).split('\\n').length;\n    extractKeysFromExportClause(exportClause, lineNum, keys);\n  }\n\n  // 3) Direct exported declarations\n  const directExportRegexes = [\n    /export\\s+(?:async\\s+)?function\\s+(\\w+)/g,\n    /export\\s+(?:const|let|var|class)\\s+(\\w+)/g,\n  ];\n  for (const regex of directExportRegexes) {\n    for (const match of source.matchAll(regex)) {\n      const lineNum = source.slice(0, match.index).split('\\n').length;\n      keys.push({ key: match[1], value: match[1], line: lineNum });\n    }\n  }\n\n  // Deduplicate noisy duplicates from multiple export forms\n  const seen = new Set();\n  const deduped = [];\n  for (const item of keys) {\n    const signature = `${item.key}:${item.value}`;\n    if (seen.has(signature)) continue;\n    seen.add(signature);\n    deduped.push(item);\n  }\n\n  return deduped;\n}\n\nfunction extractKeysFromLine(line, lineNum, keys) {\n  const trimmed = line.trim();\n  if (!trimmed || trimmed.startsWith('//') || trimmed.startsWith('*') || trimmed.startsWith('...')) return;\n\n  // Key-value: `handleMemorySearch: handleMemorySearch,`\n  const kvMatch = trimmed.match(/^(\\w+)\\s*:\\s*(\\w+)\\s*,?\\s*(?:\\/\\/.*)?$/);\n  if (kvMatch) {\n    keys.push({ key: kvMatch[1], value: kvMatch[2], line: lineNum + 1 });\n    return;\n  }\n\n  // Shorthand: `handleMemorySearch,`\n  const shortMatch = trimmed.match(/^(\\w+)\\s*,?\\s*(?:\\/\\/.*)?$/);\n  if (shortMatch) {\n    keys.push({ key: shortMatch[1], value: shortMatch[1], line: lineNum + 1 });\n  }\n}\n\nfunction extractKeysFromExportClause(exportClause, lineNum, keys) {\n  const entries = exportClause\n    .split(',')\n    .map(entry => entry.replace(/\\/\\*.*?\\*\\//g, '').replace(/\\/\\/.*$/g, '').trim())\n    .filter(Boolean);\n\n  for (const entry of entries) {\n    const aliasMatch = entry.match(/^(\\w+)\\s+as\\s+(\\w+)$/);\n    if (aliasMatch) {\n      keys.push({ key: aliasMatch[2], value: aliasMatch[1], line: lineNum });\n      continue;\n    }\n\n    const plainMatch = entry.match(/^(\\w+)$/);\n    if (plainMatch) {\n      keys.push({ key: plainMatch[1], value: plainMatch[1], line: lineNum });\n    }\n  }\n}\n\n// ───────────────────────────────────────────────────────────────\n// 4. HANDLER FILES AND EXPECTED MINIMUM HANDLE* FUNCTION COUNTS\n// ───────────────────────────────────────────────────────────────\nconst HANDLER_FILES = [\n  { file: 'causal-graph.ts', minHandleFuncs: 3 },\n  { file: 'checkpoints.ts', minHandleFuncs: 3 },\n  { file: 'memory-context.ts', minHandleFuncs: 1 },\n  { file: 'memory-crud.ts', minHandleFuncs: 4 },\n  { file: 'memory-index.ts', minHandleFuncs: 1 },\n  { file: 'memory-save.ts', minHandleFuncs: 1 },\n  { file: 'memory-search.ts', minHandleFuncs: 1 },\n  { file: 'memory-triggers.ts', minHandleFuncs: 1 },\n  { file: 'session-learning.ts', minHandleFuncs: 3 },\n];\n\n// ───────────────────────────────────────────────────────────────\n// 5. BARREL FILES AND EXPECTED KEY EXPORTS\n// ───────────────────────────────────────────────────────────────\nconst BARREL_FILES = [\n  {\n    file: 'runtime/cli/dist/core/index.js',\n    root: SCRIPTS_ROOT,\n    expectedKeys: [], // config re-exports vary; just check non-empty\n    minExports: 1,\n  },\n  {\n    file: 'runtime/cli/dist/extractors/index.js',\n    root: SCRIPTS_ROOT,\n    expectedKeys: [],\n    minExports: 3,\n  },\n  {\n    file: 'runtime/cli/dist/loaders/index.js',\n    root: SCRIPTS_ROOT,\n    expectedKeys: ['loadCollectedData'],\n    minExports: 1,\n  },\n  {\n    file: 'runtime/cli/dist/renderers/index.js',\n    root: SCRIPTS_ROOT,\n    expectedKeys: ['populateTemplate', 'renderTemplate'],\n    minExports: 2,\n  },\n  {\n    file: 'runtime/cli/dist/spec-folder/index.js',\n    root: SCRIPTS_ROOT,\n    expectedKeys: ['detectSpecFolder', 'setupContextDirectory'],\n    minExports: 3,\n  },\n  {\n    file: 'runtime/cli/dist/utils/index.js',\n    root: SCRIPTS_ROOT,\n    expectedKeys: [],\n    minExports: 3,\n  },\n];\n\n// ════════════════════════════════════════════════════════════════════════\n// EXPORT CONTRACT VERIFICATION\n// ════════════════════════════════════════════════════════════════════════\nfunction t3ExportContracts() {\n  section('T3: Export Contract Verification - Handlers');\n\n  for (const { file, minHandleFuncs } of HANDLER_FILES) {\n    const filePath = path.join(HANDLERS_DIR, file);\n    if (!fs.existsSync(filePath)) {\n      fail(`Handler missing: ${file}`, 'File does not exist');\n      continue;\n    }\n\n    const source = fs.readFileSync(filePath, 'utf8');\n    const exportKeys = extractExportKeys(source);\n    const handleKeys = exportKeys.filter(k => /^handle[A-Z]/.test(k.key));\n\n    if (handleKeys.length >= minHandleFuncs) {\n      pass(`${file}: ${handleKeys.length} handle* exports (min: ${minHandleFuncs})`);\n    } else {\n      fail(`${file}: only ${handleKeys.length} handle* exports (expected >= ${minHandleFuncs})`,\n        `Found: ${handleKeys.map(k => k.key).join(', ') || 'none'}`);","lineStart":1,"lineEnd":240,"totalLines":391,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/test-export-contracts.js","time":{"start":1788625646038,"end":1788625646042}},"id":"prt_072657187001JQdQDifJTmamLw","sessionID":"ses_f8da76375ffeCjuPpA01WdxIjC","messageID":"msg_0726552650016h5YcQh4wCSi7d"}}
