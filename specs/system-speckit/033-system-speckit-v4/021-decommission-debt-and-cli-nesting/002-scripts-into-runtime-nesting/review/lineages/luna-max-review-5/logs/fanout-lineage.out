process.cwd(), 'runtime/cli/dist/memory/generate-context.js')\", \"reason\": \"mechanical, assumes cwd already inside system-spec-kit/\" }\n      ]\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/package.json\",\n      \"field\": \"workspaces\",\n      \"old\": [\"shared\", \"runtime\", \"scripts\"],\n      \"new\": [\"shared\", \"runtime\", \"runtime/cli\"],\n      \"verify\": \"npm install && npm ci --dry-run at this workspace root must both succeed; nested-workspace-member placement has no in-repo precedent, prove it rather than assume it\"\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/package.json\",\n      \"field\": \"scripts\",\n      \"keys_needing_edit\": [\"typecheck:root\", \"test:root\", \"test:cli\", \"test:task-enrichment\", \"postinstall\"],\n      \"unaffected_keys\": [\"test\", \"test:runtime\", \"test:embeddings\"],\n      \"reason\": \"test:task-enrichment additionally needs --root scripts -> --root runtime/cli; flag its --config ../runtime/vitest.config.ts value for manual verification (see inventory.md section 6, cwd ambiguity may predate this move)\"\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/scripts/package.json\",\n      \"renamed_to\": \".opencode/skills/system-spec-kit/runtime/cli/package.json\",\n      \"changes\": [\n        { \"field\": \"dependencies['@spec-kit/runtime']\", \"old\": \"file:../runtime\", \"new\": \"file:../..\" },\n        { \"field\": \"scripts.test\", \"old_fragment\": \"--config ../runtime/vitest.config.ts\", \"new_fragment\": \"--config ../vitest.config.ts\" },\n        { \"field\": \"scripts['test:task-enrichment']\", \"old_fragment\": \"--config ../runtime/vitest.config.ts\", \"new_fragment\": \"--config ../vitest.config.ts\" }\n      ],\n      \"keep_unchanged\": [\"name: @spec-kit/scripts (see inventory.md section 8)\"]\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/tsconfig.json\",\n      \"field\": \"references\",\n      \"old\": [{\"path\": \"./shared\"}, {\"path\": \"./runtime\"}, {\"path\": \"./scripts\"}],\n      \"new\": [{\"path\": \"./shared\"}, {\"path\": \"./runtime\"}, {\"path\": \"./runtime/cli\"}]\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/scripts/tsconfig.json\",\n      \"renamed_to\": \".opencode/skills/system-spec-kit/runtime/cli/tsconfig.json\",\n      \"changes\": [\n        { \"field\": \"extends\", \"old\": \"../tsconfig.json\", \"new\": \"../../tsconfig.json\", \"reason\": \"+1 escape, does not pass through runtime\" },\n        { \"field\": \"references[1] (was ../runtime)\", \"old\": {\"path\": \"../runtime\"}, \"new\": {\"path\": \"..\"}, \"reason\": \"drop-the-segment rule, runtime is now the direct parent\" },\n        { \"field\": \"compilerOptions.paths['@spec-kit/runtime/*']\", \"old\": [\"../runtime/*\"], \"new\": [\"../*\"], \"reason\": \"drop-the-segment rule\" },\n        { \"field\": \"compilerOptions.paths['@spec-kit/runtime/api']\", \"old\": [\"../runtime/api/index.ts\"], \"new\": [\"../api/index.ts\"], \"reason\": \"drop-the-segment rule\" }\n      ]\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/vitest.config.ts\",\n      \"field\": \"test.include\",\n      \"old_entry\": \"scripts/tests/**/*.vitest.ts\",\n      \"new_entry\": \"runtime/cli/tests/**/*.vitest.ts\"\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/runtime/vitest.config.ts\",\n      \"field\": \"test.include\",\n      \"old_entry\": \"scripts/tests/**/*.{vitest,test}.ts\",\n      \"new_entry\": \"cli/tests/**/*.{vitest,test}.ts\",\n      \"reason\": \"this file does not move; its root stays path.resolve(import.meta.dirname,'..') = system-spec-kit/; only the include glob's leaf segment changes since scripts becomes a child of runtime rather than a sibling\"\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/scripts/runtime\",\n      \"renamed_to\": \".opencode/skills/system-spec-kit/runtime/cli/runtime\",\n      \"symlink_target_old\": \"../runtime/dist\",\n      \"symlink_target_new\": \"../dist\",\n      \"reason\": \"preserves the exact same real target (system-spec-kit/runtime/dist) from the new location; do not remove despite no import consumer found -- dist-freshness.cjs's symlink-skip logic documents it as an intentional freshness-walker boundary marker, and removing it is a behavior decision outside this rename-only phase's scope\"\n    },\n    {\n      \"file\": \".opencode/skills/system-spec-kit/package-lock.json\",\n      \"action\": \"regenerate, do not hand-edit\",\n      \"command\": \"cd .opencode/skills/system-spec-kit && npm install\",\n      \"reason\": \"npm v7+ lockfile keys workspace members by relative path (102 lines naming \\\"scripts in this lockfile); npm ci inside a workspace member with no lockfile of its own refuses with EUSAGE, so regeneration must run from this workspace root, not the repository root and not the moved package itself (packet 053 precedent)\"\n    },\n    {\n      \"file\": \".gitignore\",\n      \"lines\": [83, 84],\n      \"old\": [\n        \".opencode/skills/system-spec-kit/scripts/tests/*.vitest.d.ts.map\",\n        \".opencode/skills/system-spec-kit/scripts/tests/*.vitest.js.map\"\n      ],\n      \"new\": [\n        \".opencode/skills/system-spec-kit/runtime/cli/tests/*.vitest.d.ts.map\",\n        \".opencode/skills/system-spec-kit/runtime/cli/tests/*.vitest.js.map\"\n      ]\n    }\n  ],\n  \"runtime_descend_class\": {\n    \"_comment\": \"36 lines across 21 files under scripts/** matching the literal substring '../../runtime' (or deeper). Rule: drop the 'runtime/' segment, keep the same '..' count, EXCEPT check-handler-cycles-ast.ts (multi-candidate resolver, each candidate needs its own depth-specific treatment) and import-policy-rules.vitest.ts (string literals are test data for a boundary-rule under test, not real resolved paths -- confirm intended post-move semantics before editing). See inventory.md section 4 for the