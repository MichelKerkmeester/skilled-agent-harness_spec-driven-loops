.config.ts\",\n25:     \"test:embeddings\": \"node runtime/cli/tests/test-embeddings-factory.cjs\",\n26:     \"postinstall\": \"node runtime/cli/setup/record-node-version.js\"\n27:   },\n28:   \"overrides\": {\n29:     \"hono\": \"^4.12.34\",\n30:     \"@hono/node-server\": \"^2.0.5\",\n31:     \"vite\": \"^8.1.2\",\n32:     \"esbuild\": \"^0.28.1\",\n33:     \"fast-uri\": \"^3.1.5\",\n34:     \"nanoid\": \"3.3.17\",\n35:     \"picomatch\": \"^4.0.4\",\n36:     \"path-to-regexp\": \"^8.4.0\",\n37:     \"postcss\": \"^8.5.23\",\n38:     \"js-yaml\": \"^4.3.1\",\n39:     \"protobufjs\": \"^7.6.4\",\n40:     \"tar\": \"^7.5.19\",\n41:     \"@protobufjs/utf8\": \"^1.1.1\",\n42:     \"sharp\": \"^0.35.3\",\n43:     \"@modelcontextprotocol/sdk\": {\n44:       \"hono\": \"^4.12.34\",\n45:       \"@hono/node-server\": \"^2.0.5\"\n46:     }\n47:   },\n48:   \"devDependencies\": {\n49:     \"@huggingface/transformers\": \"^3.8.1\",\n50:     \"@types/node\": \"^25.2.1\",\n51:     \"typescript\": \"^5.9.3\"\n52:   },\n53:   \"dependencies\": {}\n54: }\n\n(End of file - total 54 lines)\n</content>","metadata":{"preview":"{\n  \"name\": \"system-spec-kit\",\n  \"version\": \"1.7.2\",\n  \"private\": true,\n  \"description\": \"Unified workspace for the Spec Kit engine and its CLI tools\",\n  \"workspaces\": [\n    \"shared\",\n    \"runtime\",\n    \"runtime/cli\"\n  ],\n  \"engines\": {\n    \"node\": \">=20.11.0\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc --build\",\n    \"typecheck\": \"npm run --workspaces=false typecheck:root\",\n    \"typecheck:root\": \"tsc -p shared/tsconfig.json && tsc --noEmit --composite false -p runtime/tsconfig.json && tsc --noEmit --composite false -p runtime/cli/tsconfig.json\",\n    \"build:watch\": \"tsc --build --watch\",\n    \"test\": \"npm run --workspaces=false test:root\",\n    \"pretest:root\": \"npm run build --workspace=@spec-kit/shared --workspace=@spec-kit/runtime --workspace=@spec-kit/cli\",","truncated":false,"loaded":[],"display