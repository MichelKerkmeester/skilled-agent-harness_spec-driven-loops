{"type":"tool_use","timestamp":1785134361495,"sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","part":{"type":"tool","tool":"read","callID":"call_OfYByobEmJGie0gjiMB5AoW3","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/bin/lib/compiled-routing/014-runtime-engine/lib/compiled-route.cjs","limit":260},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/bin/lib/compiled-routing/014-runtime-engine/lib/compiled-route.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: // Runtime compiled-route engine.\n5: //\n6: // Routes a prompt through a hub's compiled policy using the same proven closed\n7: // decision algebra the shadow canary validates (evaluateCanary over the hub's\n8: // snapshot). The engine routes WITHIN a hub — it selects compiled destinations\n9: // (modes/surfaces) when the prompt carries the policy's detector signals, and\n10: // otherwise returns a `defer` decision (the correct conservative outcome), so a\n11: // caller can fall back to legacy routing on ambiguous input.\n12: //\n13: // This module is pure and side-effect-free: it never flips serving authority\n14: // and never edits a manifest. Whether its result is authoritative is decided by\n15: // the resolver, which gates on the activation manifest and a runtime flag.\n16: \n17: const fs = require('fs');\n18: const path = require('path');\n19: const crypto = require('crypto');\n20: \n21: // Each hub's compiled policy + engine live in its shadow rollout child; this\n22: // phase reuses them read-only rather than duplicating the compiled contract.\n23: const IMPL_ROOT = path.resolve(__dirname, '..', '..');\n24: \n25: // Promoted activation manifests (never the spec tree). Fingerprinting a hub's\n26: // manifest lets the engine cache invalidate when the manifest flips, so a\n27: // serving-authority or selected-policy change never serves an engine cached\n28: // against the prior manifest.\n29: const ACTIVATION_ROOT = path.resolve(__dirname, '..', '..', '013-live-activation', 'activation');\n30: const HUB_CHILD = Object.freeze({\n31:   'sk-code': '009-parent-hub-rollout/001-sk-code',\n32:   'system-deep-loop': '009-parent-hub-rollout/002-system-deep-loop',\n33:   'mcp-tooling': '009-parent-hub-rollout/003-mcp-tooling',\n34:   'cli-external-orchestration': '009-parent-hub-rollout/004-cli-external-orchestration',\n35:   'sk-prompt': '009-parent-hub-rollout/005-sk-prompt',\n36:   'sk-design': '009-parent-hub-rollout/006-sk-design',\n37:   'sk-doc': '009-parent-hub-rollout/007-sk-doc',\n38: });\n39: \n40: const engineCache = new Map();\n41: \n42: // Fingerprint the hub's activation manifest. A read failure yields a stable\n43: // sentinel so a route never throws on a missing or unreadable manifest; the\n44: // downstream HUB_CHILD check still rejects an unknown hub.\n45: function manifestFingerprint(hubId) {\n46:   try {\n47:     return crypto.createHash('sha256')\n48:       .update(fs.readFileSync(path.join(ACTIVATION_ROOT, hubId, 'manifest.json')))\n49:       .digest('hex');\n50:   } catch {\n51:     return 'no-manifest';\n52:   }\n53: }\n54: \n55: function loadHubEngine(hubId) {\n56:   // Key on the manifest fingerprint so a flip invalidates a stale cached engine\n57:   // while an unchanged manifest still hits the cache within a process.\n58:   const cacheKey = `${hubId}::${manifestFingerprint(hubId)}`;\n59:   if (engineCache.has(cacheKey)) return engineCache.get(cacheKey);\n60:   const child = HUB_CHILD[hubId];\n61:   if (!child) throw new Error(`unknown hub: ${hubId}`);\n62:   const childRoot = path.join(IMPL_ROOT, child);\n63:   // Relative requires inside these modules resolve from their own location, so\n64:   // reusing them from here keeps the compiled contract's dependency graph intact.\n65:   const { loadSnapshot } = require(path.join(childRoot, 'harness', 'build-artifacts.cjs'));\n66:   // Hubs ship one of two engine module shapes: the surfaceBundle canary-router\n67:   // (evaluateCanary) or the plain router (evaluateRoute). Both take\n68:   // (snapshot, input) and return a { decision } — pick whichever this hub has.\n69:   const canaryRouter = path.join(childRoot, 'lib', 'canary-router.cjs');\n70:   const plainRouter = path.join(childRoot, 'lib', 'router.cjs');\n71:   const routerPath = fs.existsSync(canaryRouter) ? canaryRouter\n72:     : (fs.existsSync(plainRouter) ? plainRouter : null);\n73:   if (!routerPath) throw new Error(`no compiled router module for hub ${hubId}`);\n74:   const routerMod = require(routerPath);\n75:   // The export name varies by archetype (evaluateCanary or evaluateRoute); both\n76:   // share the (snapshot, input) -> { decision } contract.\n77:   const evaluate = routerMod.evaluateCanary || routerMod.evaluateRoute;\n78:   if (typeof evaluate !== 'function') {\n79:     throw new Error(`no evaluate function exported by ${routerPath} for hub ${hubId}`);\n80:   }\n81:   const { snapshot } = loadSnapshot();\n82:   const engine = Object.freeze({ snapshot, evaluate });\n83:   engineCache.set(cacheKey, engine);\n84:   return engine;\n85: }\n86: \n87: function normalizeTargets(route) {\n88:   if (!route || !Array.isArray(route.targets)) return [];\n89:   return route.targets\n90:     .map((t) => t.qualifiedId || t.destinationId || t.skillId || null)\n91:     .filter(Boolean);\n92: }\n93: \n94: // Route `taskText` through hub `hubId`'s compiled contract. Returns a normalized,\n95: // serializable decision; `action` is one of route/clarify/defer/reject.\n96: function compiledRoute(hubId, taskText) {\n97:   const { snapshot, evaluate } = loadHubEngine(hubId);\n98:   const evaluated = evaluate(snapshot, { prompt: taskText });\n99:   const route = evaluated.decision.route || null;\n100:   return {\n101:     hubId,\n102:     action: evaluated.decision.action,\n103:     selectionKind: route ? route.selectionKind : null,\n104:     targets: normalizeTargets(route),\n105:     effectivePolicyHash: snapshot.policy.effectivePolicyHash,\n106:     generation: snapshot.policy.activationGeneration,\n107:   };\n108: }\n109: \n110: module.exports = { compiledRoute, loadHubEngine, HUB_CHILD };\n\n(End of file - total 110 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\n// Runtime compiled-route engine.\n//\n// Routes a prompt through a hub's compiled policy using the same proven closed\n// decision algebra the shadow canary validates (evaluateCanary over the hub's\n// snapshot). The engine routes WITHIN a hub — it selects compiled destinations\n// (modes/surfaces) when the prompt carries the policy's detector signals, and\n// otherwise returns a `defer` decision (the correct conservative outcome), so a\n// caller can fall back to legacy routing on ambiguous input.\n//\n// This module is pure and side-effect-free: it never flips serving authority\n// and never edits a manifest. Whether its result is authoritative is decided by\n// the resolver, which gates on the activation manifest and a runtime flag.\n\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/bin/lib/compiled-routing/014-runtime-engine/lib/compiled-route.cjs","text":"#!/usr/bin/env node\n'use strict';\n\n// Runtime compiled-route engine.\n//\n// Routes a prompt through a hub's compiled policy using the same proven closed\n// decision algebra the shadow canary validates (evaluateCanary over the hub's\n// snapshot). The engine routes WITHIN a hub — it selects compiled destinations\n// (modes/surfaces) when the prompt carries the policy's detector signals, and\n// otherwise returns a `defer` decision (the correct conservative outcome), so a\n// caller can fall back to legacy routing on ambiguous input.\n//\n// This module is pure and side-effect-free: it never flips serving authority\n// and never edits a manifest. Whether its result is authoritative is decided by\n// the resolver, which gates on the activation manifest and a runtime flag.\n\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\n\n// Each hub's compiled policy + engine live in its shadow rollout child; this\n// phase reuses them read-only rather than duplicating the compiled contract.\nconst IMPL_ROOT = path.resolve(__dirname, '..', '..');\n\n// Promoted activation manifests (never the spec tree). Fingerprinting a hub's\n// manifest lets the engine cache invalidate when the manifest flips, so a\n// serving-authority or selected-policy change never serves an engine cached\n// against the prior manifest.\nconst ACTIVATION_ROOT = path.resolve(__dirname, '..', '..', '013-live-activation', 'activation');\nconst HUB_CHILD = Object.freeze({\n  'sk-code': '009-parent-hub-rollout/001-sk-code',\n  'system-deep-loop': '009-parent-hub-rollout/002-system-deep-loop',\n  'mcp-tooling': '009-parent-hub-rollout/003-mcp-tooling',\n  'cli-external-orchestration': '009-parent-hub-rollout/004-cli-external-orchestration',\n  'sk-prompt': '009-parent-hub-rollout/005-sk-prompt',\n  'sk-design': '009-parent-hub-rollout/006-sk-design',\n  'sk-doc': '009-parent-hub-rollout/007-sk-doc',\n});\n\nconst engineCache = new Map();\n\n// Fingerprint the hub's activation manifest. A read failure yields a stable\n// sentinel so a route never throws on a missing or unreadable manifest; the\n// downstream HUB_CHILD check still rejects an unknown hub.\nfunction manifestFingerprint(hubId) {\n  try {\n    return crypto.createHash('sha256')\n      .update(fs.readFileSync(path.join(ACTIVATION_ROOT, hubId, 'manifest.json')))\n      .digest('hex');\n  } catch {\n    return 'no-manifest';\n  }\n}\n\nfunction loadHubEngine(hubId) {\n  // Key on the manifest fingerprint so a flip invalidates a stale cached engine\n  // while an unchanged manifest still hits the cache within a process.\n  const cacheKey = `${hubId}::${manifestFingerprint(hubId)}`;\n  if (engineCache.has(cacheKey)) return engineCache.get(cacheKey);\n  const child = HUB_CHILD[hubId];\n  if (!child) throw new Error(`unknown hub: ${hubId}`);\n  const childRoot = path.join(IMPL_ROOT, child);\n  // Relative requires inside these modules resolve from their own location, so\n  // reusing them from here keeps the compiled contract's dependency graph intact.\n  const { loadSnapshot } = require(path.join(childRoot, 'harness', 'build-artifacts.cjs'));\n  // Hubs ship one of two engine module shapes: the surfaceBundle canary-router\n  // (evaluateCanary) or the plain router (evaluateRoute). Both take\n  // (snapshot, input) and return a { decision } — pick whichever this hub has.\n  const canaryRouter = path.join(childRoot, 'lib', 'canary-router.cjs');\n  const plainRouter = path.join(childRoot, 'lib', 'router.cjs');\n  const routerPath = fs.existsSync(canaryRouter) ? canaryRouter\n    : (fs.existsSync(plainRouter) ? plainRouter : null);\n  if (!routerPath) throw new Error(`no compiled router module for hub ${hubId}`);\n  const routerMod = require(routerPath);\n  // The export name varies by archetype (evaluateCanary or evaluateRoute); both\n  // share the (snapshot, input) -> { decision } contract.\n  const evaluate = routerMod.evaluateCanary || routerMod.evaluateRoute;\n  if (typeof evaluate !== 'function') {\n    throw new Error(`no evaluate function exported by ${routerPath} for hub ${hubId}`);\n  }\n  const { snapshot } = loadSnapshot();\n  const engine = Object.freeze({ snapshot, evaluate });\n  engineCache.set(cacheKey, engine);\n  return engine;\n}\n\nfunction normalizeTargets(route) {\n  if (!route || !Array.isArray(route.targets)) return [];\n  return route.targets\n    .map((t) => t.qualifiedId || t.destinationId || t.skillId || null)\n    .filter(Boolean);\n}\n\n// Route `taskText` through hub `hubId`'s compiled contract. Returns a normalized,\n// serializable decision; `action` is one of route/clarify/defer/reject.\nfunction compiledRoute(hubId, taskText) {\n  const { snapshot, evaluate } = loadHubEngine(hubId);\n  const evaluated = evaluate(snapshot, { prompt: taskText });\n  const route = evaluated.decision.route || null;\n  return {\n    hubId,\n    action: evaluated.decision.action,\n    selectionKind: route ? route.selectionKind : null,\n    targets: normalizeTargets(route),\n    effectivePolicyHash: snapshot.policy.effectivePolicyHash,\n    generation: snapshot.policy.activationGeneration,\n  };\n}\n\nmodule.exports = { compiledRoute, loadHubEngine, HUB_CHILD };","lineStart":1,"lineEnd":110,"totalLines":110,"truncated":false}},"title":".opencode/bin/lib/compiled-routing/014-runtime-engine/lib/compiled-route.cjs","time":{"start":1785134361353,"end":1785134361491}},"metadata":{"openai":{"itemId":"fc_01b3eb02ef0bdef6016a66fd18f9748191ad9252415abeca28"}},"id":"prt_fa24cab04001tXio2Ouw270fQu","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa24c67b50012No5UEZTZlJHuL"}}
