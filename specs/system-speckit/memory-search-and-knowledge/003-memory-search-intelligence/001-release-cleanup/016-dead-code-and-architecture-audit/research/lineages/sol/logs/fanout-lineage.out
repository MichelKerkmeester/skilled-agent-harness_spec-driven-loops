{"type":"tool_use","timestamp":1785134497149,"sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","part":{"type":"tool","tool":"read","callID":"call_1yXXwJ7g1IKjpEWfdfGtyzST","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-code-graph/mcp-server/lib/shared/shared-payload.ts","limit":260},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-code-graph/mcp-server/lib/shared/shared-payload.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Shared Payload Contract (local copy for system-code-graph)\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { assertNever } from './assert-never.js';\n6: \n7: export const SHARED_PAYLOAD_KIND_VALUES = ['startup', 'resume', 'health', 'bootstrap', 'compaction'] as const;\n8: export type SharedPayloadKind = (typeof SHARED_PAYLOAD_KIND_VALUES)[number];\n9: \n10: export const SHARED_PAYLOAD_TRUST_STATE_VALUES = [\n11:   'live', 'cached', 'stale', 'absent', 'unavailable', 'imported', 'rebuilt', 'rehomed',\n12: ] as const;\n13: export type SharedPayloadTrustState = (typeof SHARED_PAYLOAD_TRUST_STATE_VALUES)[number];\n14: \n15: export const DETECTOR_PROVENANCE_VALUES = ['ast', 'structured', 'regex', 'heuristic'] as const;\n16: export type DetectorProvenance = (typeof DETECTOR_PROVENANCE_VALUES)[number];\n17: \n18: export const PARSER_PROVENANCE_VALUES = ['ast', 'regex', 'heuristic', 'unknown'] as const;\n19: export type ParserProvenance = (typeof PARSER_PROVENANCE_VALUES)[number];\n20: \n21: export const EVIDENCE_STATUS_VALUES = ['confirmed', 'probable', 'unverified', 'unknown'] as const;\n22: export type EvidenceStatus = (typeof EVIDENCE_STATUS_VALUES)[number];\n23: \n24: export const FRESHNESS_AUTHORITY_VALUES = ['live', 'cached', 'stale', 'unknown'] as const;\n25: export type FreshnessAuthority = (typeof FRESHNESS_AUTHORITY_VALUES)[number];\n26: \n27: export const ADVISOR_ENVELOPE_FRESHNESS_VALUES = ['live', 'stale', 'absent', 'unavailable'] as const;\n28: export type AdvisorEnvelopeFreshness = (typeof ADVISOR_ENVELOPE_FRESHNESS_VALUES)[number];\n29: \n30: export const ADVISOR_ENVELOPE_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n31: export type AdvisorEnvelopeStatus = (typeof ADVISOR_ENVELOPE_STATUS_VALUES)[number];\n32: \n33: export const EDGE_EVIDENCE_CLASS_VALUES = [\n34:   'direct_call', 'import', 'type_reference', 'inferred_heuristic', 'test_coverage',\n35: ] as const;\n36: export type EdgeEvidenceClass = (typeof EDGE_EVIDENCE_CLASS_VALUES)[number];\n37: \n38: export const SHARED_PAYLOAD_CERTAINTY_VALUES = ['exact', 'estimated', 'defaulted', 'unknown'] as const;\n39: export type SharedPayloadCertainty = (typeof SHARED_PAYLOAD_CERTAINTY_VALUES)[number];\n40: \n41: export const SHARED_PAYLOAD_SOURCE_KIND_VALUES = [\n42:   'memory', 'code-graph', 'semantic', 'session', 'operational',\n43:   'skill-inventory', 'skill-graph', 'advisor-runtime',\n44: ] as const;\n45: export type SharedPayloadSourceKind = (typeof SHARED_PAYLOAD_SOURCE_KIND_VALUES)[number];\n46: \n47: export const SHARED_PAYLOAD_PRODUCER_VALUES = [\n48:   'startup_brief', 'session_snapshot', 'session_resume', 'session_health',\n49:   'session_bootstrap', 'compact_merger', 'hook_cache', 'advisor',\n50: ] as const;\n51: export type SharedPayloadProducer = (typeof SHARED_PAYLOAD_PRODUCER_VALUES)[number];\n52: \n53: export interface StructuralTrust {\n54:   parserProvenance: ParserProvenance;\n55:   evidenceStatus: EvidenceStatus;\n56:   freshnessAuthority: FreshnessAuthority;\n57: }\n58: \n59: export interface HotFileBreadcrumb {\n60:   degree: number;\n61:   changeCarefullyReason: string;\n62: }\n63: \n64: export interface GraphEdgeEnrichment {\n65:   edgeEvidenceClass: EdgeEvidenceClass;\n66:   numericConfidence: number;\n67: }\n68: \n69: export type StructuralTrustCarrier<T extends object = Record<string, unknown>> = T & StructuralTrust;\n70: export type GraphEdgeEnrichmentCarrier<T extends object = Record<string, unknown>> = T & GraphEdgeEnrichment;\n71: \n72: export interface SharedPayloadSection {\n73:   key: string;\n74:   title: string;\n75:   content: string;\n76:   source: SharedPayloadSourceKind;\n77:   certainty?: SharedPayloadCertainty;\n78:   structuralTrust?: StructuralTrust;\n79:   graphEdgeEnrichment?: GraphEdgeEnrichment;\n80:   hotFileBreadcrumb?: HotFileBreadcrumb;\n81: }\n82: \n83: export interface SharedPayloadProvenance {\n84:   producer: SharedPayloadProducer;\n85:   sourceSurface: string;\n86:   trustState: SharedPayloadTrustState;\n87:   generatedAt: string;\n88:   lastUpdated: string | null;\n89:   sourceRefs: (string | { kind: SharedPayloadSourceKind; path: string })[];\n90:   sanitizerVersion?: string;\n91: }\n92: \n93: export interface PreMergeSelectionMetadata {\n94:   strategy: 'pre-merge';\n95:   selectedFrom: string[];\n96:   fileCount: number;\n97:   topicCount: number;\n98:   attentionSignalCount: number;\n99:   notes: string[];\n100:   antiFeedbackGuards: string[];\n101: }\n102: \n103: export interface AdvisorEnvelopeMetadata {\n104:   freshness: AdvisorEnvelopeFreshness;\n105:   confidence: number;\n106:   uncertainty: number;\n107:   skillLabel: string | null;\n108:   status: AdvisorEnvelopeStatus;\n109: }\n110: \n111: export type SharedPayloadEnvelopeMetadata = AdvisorEnvelopeMetadata;\n112: \n113: export interface SharedPayloadEnvelope {\n114:   kind: SharedPayloadKind;\n115:   summary: string;\n116:   sections: SharedPayloadSection[];\n117:   provenance: SharedPayloadProvenance;\n118:   metadata?: SharedPayloadEnvelopeMetadata;\n119:   selection?: PreMergeSelectionMetadata;\n120: }\n121: \n122: function detectorProvenanceToParserProvenance(value: DetectorProvenance): ParserProvenance {\n123:   if (value === 'structured') return 'regex';\n124:   return value as ParserProvenance;\n125: }\n126: \n127: export function buildStructuralTrustFromProvenance(input: {\n128:   evidenceStatus: EvidenceStatus;\n129:   freshnessAuthority: FreshnessAuthority;\n130:   detectorProvenance?: DetectorProvenance | null;\n131:   fallbackParserProvenance?: ParserProvenance;\n132: }): StructuralTrust {\n133:   const parserProvenance = input.detectorProvenance\n134:     ? detectorProvenanceToParserProvenance(input.detectorProvenance)\n135:     : input.fallbackParserProvenance ?? 'unknown';\n136:   return { parserProvenance, evidenceStatus: input.evidenceStatus, freshnessAuthority: input.freshnessAuthority };\n137: }\n138: \n139: export function attachStructuralTrustFields<T extends object>(\n140:   payload: T,\n141:   trustPayload: unknown,\n142:   _options?: { label?: string },\n143: ): StructuralTrustCarrier<T> {\n144:   const structuralTrust = trustPayload as StructuralTrust;\n145:   return { ...payload, ...structuralTrust };\n146: }\n147: \n148: export function attachGraphEdgeEnrichment<T extends object>(\n149:   payload: T,\n150:   enrichment: unknown,\n151:   _options?: { label?: string },\n152: ): GraphEdgeEnrichmentCarrier<T> {\n153:   const graphEdgeEnrichment = enrichment as GraphEdgeEnrichment;\n154:   return { ...payload, ...graphEdgeEnrichment };\n155: }\n156: \n157: export function trustStateFromGraphState(\n158:   graphState: 'ready' | 'stale' | 'empty' | 'missing' | 'error',\n159: ): SharedPayloadTrustState {\n160:   switch (graphState) {\n161:     case 'ready': return 'live';\n162:     case 'stale': return 'stale';\n163:     case 'empty':\n164:     case 'missing': return 'absent';\n165:     case 'error': return 'unavailable';\n166:     default: return assertNever(graphState, 'graph-state');\n167:   }\n168: }\n169: \n170: function truncateInline(text: string, maxChars: number = 220): string {\n171:   const normalized = text.replace(/\\s+/g, ' ').trim();\n172:   if (normalized.length <= maxChars) return normalized;\n173:   return `${normalized.slice(0, maxChars - 3).trimEnd()}...`;\n174: }\n175: \n176: export function createSharedPayloadEnvelope(input: {\n177:   kind: SharedPayloadKind;\n178:   sections: SharedPayloadSection[];\n179:   provenance: SharedPayloadProvenance;\n180:   metadata?: SharedPayloadEnvelopeMetadata;\n181:   summary?: string;\n182:   selection?: PreMergeSelectionMetadata;\n183: }): SharedPayloadEnvelope {\n184:   const sections = input.sections.filter((section) => section.content.trim().length > 0);\n185:   const summary = input.summary\n186:     ? truncateInline(input.summary)\n187:     : truncateInline(\n188:       sections.length > 0\n189:         ? sections.slice(0, 2).map((section) => `${section.title}: ${section.content}`).join(' | ')\n190:         : `${input.kind} payload from ${input.provenance.producer}`,\n191:     );\n192:   return {\n193:     kind: input.kind,\n194:     summary,\n195:     sections,\n196:     provenance: input.provenance,\n197:     ...(input.metadata ? { metadata: input.metadata } : {}),\n198:     ...(input.selection ? { selection: input.selection } : {}),\n199:   };\n200: }\n\n(End of file - total 200 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────\n// MODULE: Shared Payload Contract (local copy for system-code-graph)\n// ───────────────────────────────────────────────────────────────\n\nimport { assertNever } from './assert-never.js';\n\nexport const SHARED_PAYLOAD_KIND_VALUES = ['startup', 'resume', 'health', 'bootstrap', 'compaction'] as const;\nexport type SharedPayloadKind = (typeof SHARED_PAYLOAD_KIND_VALUES)[number];\n\nexport const SHARED_PAYLOAD_TRUST_STATE_VALUES = [\n  'live', 'cached', 'stale', 'absent', 'unavailable', 'imported', 'rebuilt', 'rehomed',\n] as const;\nexport type SharedPayloadTrustState = (typeof SHARED_PAYLOAD_TRUST_STATE_VALUES)[number];\n\nexport const DETECTOR_PROVENANCE_VALUES = ['ast', 'structured', 'regex', 'heuristic'] as const;\nexport type DetectorProvenance = (typeof DETECTOR_PROVENANCE_VALUES)[number];\n\nexport const PARSER_PROVENANCE_VALUES = ['ast', 'regex', 'heuristic', 'unknown'] as const;\nexport type ParserProvenance = (typeof PARSER_PROVENANCE_VALUES)[number];\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-code-graph/mcp-server/lib/shared/shared-payload.ts","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Shared Payload Contract (local copy for system-code-graph)\n// ───────────────────────────────────────────────────────────────\n\nimport { assertNever } from './assert-never.js';\n\nexport const SHARED_PAYLOAD_KIND_VALUES = ['startup', 'resume', 'health', 'bootstrap', 'compaction'] as const;\nexport type SharedPayloadKind = (typeof SHARED_PAYLOAD_KIND_VALUES)[number];\n\nexport const SHARED_PAYLOAD_TRUST_STATE_VALUES = [\n  'live', 'cached', 'stale', 'absent', 'unavailable', 'imported', 'rebuilt', 'rehomed',\n] as const;\nexport type SharedPayloadTrustState = (typeof SHARED_PAYLOAD_TRUST_STATE_VALUES)[number];\n\nexport const DETECTOR_PROVENANCE_VALUES = ['ast', 'structured', 'regex', 'heuristic'] as const;\nexport type DetectorProvenance = (typeof DETECTOR_PROVENANCE_VALUES)[number];\n\nexport const PARSER_PROVENANCE_VALUES = ['ast', 'regex', 'heuristic', 'unknown'] as const;\nexport type ParserProvenance = (typeof PARSER_PROVENANCE_VALUES)[number];\n\nexport const EVIDENCE_STATUS_VALUES = ['confirmed', 'probable', 'unverified', 'unknown'] as const;\nexport type EvidenceStatus = (typeof EVIDENCE_STATUS_VALUES)[number];\n\nexport const FRESHNESS_AUTHORITY_VALUES = ['live', 'cached', 'stale', 'unknown'] as const;\nexport type FreshnessAuthority = (typeof FRESHNESS_AUTHORITY_VALUES)[number];\n\nexport const ADVISOR_ENVELOPE_FRESHNESS_VALUES = ['live', 'stale', 'absent', 'unavailable'] as const;\nexport type AdvisorEnvelopeFreshness = (typeof ADVISOR_ENVELOPE_FRESHNESS_VALUES)[number];\n\nexport const ADVISOR_ENVELOPE_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\nexport type AdvisorEnvelopeStatus = (typeof ADVISOR_ENVELOPE_STATUS_VALUES)[number];\n\nexport const EDGE_EVIDENCE_CLASS_VALUES = [\n  'direct_call', 'import', 'type_reference', 'inferred_heuristic', 'test_coverage',\n] as const;\nexport type EdgeEvidenceClass = (typeof EDGE_EVIDENCE_CLASS_VALUES)[number];\n\nexport const SHARED_PAYLOAD_CERTAINTY_VALUES = ['exact', 'estimated', 'defaulted', 'unknown'] as const;\nexport type SharedPayloadCertainty = (typeof SHARED_PAYLOAD_CERTAINTY_VALUES)[number];\n\nexport const SHARED_PAYLOAD_SOURCE_KIND_VALUES = [\n  'memory', 'code-graph', 'semantic', 'session', 'operational',\n  'skill-inventory', 'skill-graph', 'advisor-runtime',\n] as const;\nexport type SharedPayloadSourceKind = (typeof SHARED_PAYLOAD_SOURCE_KIND_VALUES)[number];\n\nexport const SHARED_PAYLOAD_PRODUCER_VALUES = [\n  'startup_brief', 'session_snapshot', 'session_resume', 'session_health',\n  'session_bootstrap', 'compact_merger', 'hook_cache', 'advisor',\n] as const;\nexport type SharedPayloadProducer = (typeof SHARED_PAYLOAD_PRODUCER_VALUES)[number];\n\nexport interface StructuralTrust {\n  parserProvenance: ParserProvenance;\n  evidenceStatus: EvidenceStatus;\n  freshnessAuthority: FreshnessAuthority;\n}\n\nexport interface HotFileBreadcrumb {\n  degree: number;\n  changeCarefullyReason: string;\n}\n\nexport interface GraphEdgeEnrichment {\n  edgeEvidenceClass: EdgeEvidenceClass;\n  numericConfidence: number;\n}\n\nexport type StructuralTrustCarrier<T extends object = Record<string, unknown>> = T & StructuralTrust;\nexport type GraphEdgeEnrichmentCarrier<T extends object = Record<string, unknown>> = T & GraphEdgeEnrichment;\n\nexport interface SharedPayloadSection {\n  key: string;\n  title: string;\n  content: string;\n  source: SharedPayloadSourceKind;\n  certainty?: SharedPayloadCertainty;\n  structuralTrust?: StructuralTrust;\n  graphEdgeEnrichment?: GraphEdgeEnrichment;\n  hotFileBreadcrumb?: HotFileBreadcrumb;\n}\n\nexport interface SharedPayloadProvenance {\n  producer: SharedPayloadProducer;\n  sourceSurface: string;\n  trustState: SharedPayloadTrustState;\n  generatedAt: string;\n  lastUpdated: string | null;\n  sourceRefs: (string | { kind: SharedPayloadSourceKind; path: string })[];\n  sanitizerVersion?: string;\n}\n\nexport interface PreMergeSelectionMetadata {\n  strategy: 'pre-merge';\n  selectedFrom: string[];\n  fileCount: number;\n  topicCount: number;\n  attentionSignalCount: number;\n  notes: string[];\n  antiFeedbackGuards: string[];\n}\n\nexport interface AdvisorEnvelopeMetadata {\n  freshness: AdvisorEnvelopeFreshness;\n  confidence: number;\n  uncertainty: number;\n  skillLabel: string | null;\n  status: AdvisorEnvelopeStatus;\n}\n\nexport type SharedPayloadEnvelopeMetadata = AdvisorEnvelopeMetadata;\n\nexport interface SharedPayloadEnvelope {\n  kind: SharedPayloadKind;\n  summary: string;\n  sections: SharedPayloadSection[];\n  provenance: SharedPayloadProvenance;\n  metadata?: SharedPayloadEnvelopeMetadata;\n  selection?: PreMergeSelectionMetadata;\n}\n\nfunction detectorProvenanceToParserProvenance(value: DetectorProvenance): ParserProvenance {\n  if (value === 'structured') return 'regex';\n  return value as ParserProvenance;\n}\n\nexport function buildStructuralTrustFromProvenance(input: {\n  evidenceStatus: EvidenceStatus;\n  freshnessAuthority: FreshnessAuthority;\n  detectorProvenance?: DetectorProvenance | null;\n  fallbackParserProvenance?: ParserProvenance;\n}): StructuralTrust {\n  const parserProvenance = input.detectorProvenance\n    ? detectorProvenanceToParserProvenance(input.detectorProvenance)\n    : input.fallbackParserProvenance ?? 'unknown';\n  return { parserProvenance, evidenceStatus: input.evidenceStatus, freshnessAuthority: input.freshnessAuthority };\n}\n\nexport function attachStructuralTrustFields<T extends object>(\n  payload: T,\n  trustPayload: unknown,\n  _options?: { label?: string },\n): StructuralTrustCarrier<T> {\n  const structuralTrust = trustPayload as StructuralTrust;\n  return { ...payload, ...structuralTrust };\n}\n\nexport function attachGraphEdgeEnrichment<T extends object>(\n  payload: T,\n  enrichment: unknown,\n  _options?: { label?: string },\n): GraphEdgeEnrichmentCarrier<T> {\n  const graphEdgeEnrichment = enrichment as GraphEdgeEnrichment;\n  return { ...payload, ...graphEdgeEnrichment };\n}\n\nexport function trustStateFromGraphState(\n  graphState: 'ready' | 'stale' | 'empty' | 'missing' | 'error',\n): SharedPayloadTrustState {\n  switch (graphState) {\n    case 'ready': return 'live';\n    case 'stale': return 'stale';\n    case 'empty':\n    case 'missing': return 'absent';\n    case 'error': return 'unavailable';\n    default: return assertNever(graphState, 'graph-state');\n  }\n}\n\nfunction truncateInline(text: string, maxChars: number = 220): string {\n  const normalized = text.replace(/\\s+/g, ' ').trim();\n  if (normalized.length <= maxChars) return normalized;\n  return `${normalized.slice(0, maxChars - 3).trimEnd()}...`;\n}\n\nexport function createSharedPayloadEnvelope(input: {\n  kind: SharedPayloadKind;\n  sections: SharedPayloadSection[];\n  provenance: SharedPayloadProvenance;\n  metadata?: SharedPayloadEnvelopeMetadata;\n  summary?: string;\n  selection?: PreMergeSelectionMetadata;\n}): SharedPayloadEnvelope {\n  const sections = input.sections.filter((section) => section.content.trim().length > 0);\n  const summary = input.summary\n    ? truncateInline(input.summary)\n    : truncateInline(\n      sections.length > 0\n        ? sections.slice(0, 2).map((section) => `${section.title}: ${section.content}`).join(' | ')\n        : `${input.kind} payload from ${input.provenance.producer}`,\n    );\n  return {\n    kind: input.kind,\n    summary,\n    sections,\n    provenance: input.provenance,\n    ...(input.metadata ? { metadata: input.metadata } : {}),\n    ...(input.selection ? { selection: input.selection } : {}),\n  };\n}","lineStart":1,"lineEnd":200,"totalLines":200,"truncated":false}},"title":".opencode/skills/system-code-graph/mcp-server/lib/shared/shared-payload.ts","time":{"start":1785134497131,"end":1785134497142}},"metadata":{"openai":{"itemId":"fc_02919b9ca7f267f7016a66fda0e71881918970b17486822257"}},"id":"prt_fa24ebd2d0016YKuKNlTy1yevm","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa24e75ed0015024CCVuQlKj8B"}}
{"type":"tool_use","timestamp":1785134497237,"sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","part":{"type":"tool","tool":"read","callID":"call_L11uuhI2JvPTzWYubgn7y9jE","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-code-graph/mcp-server/lib/shared/README.md","limit":140},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-code-graph/mcp-server/lib/shared/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Code Graph Shared: Local Contracts And Runtime Helpers\"\n3: description: \"Local code-graph contracts for payload shaping, path safety, hook state, metrics stubs and MCP helper types.\"\n4: trigger_phrases:\n5:   - \"code graph shared\"\n6:   - \"shared payload contract\"\n7:   - \"code graph metrics stub\"\n8:   - \"index scope policy\"\n9: ---\n10: \n11: # Code Graph Shared: Local Contracts And Runtime Helpers\n12: \n13: > Local helper modules used by the `mk-code-index` runtime without importing sibling skills.\n14: \n15: ---\n16: \n17: ## 1. OVERVIEW\n18: \n19: `lib/shared/` contains the small contracts and runtime helpers that must be reused across code-graph handlers, library modules and tools. The folder keeps code-graph ownership local, including payload trust fields, MCP response helpers, path canonicalization, hook-state reads and scan-scope filtering.\n20: \n21: Current state:\n22: \n23: - Shared payload and code-graph contract types are local copies owned by this package.\n24: - `metrics-stub.ts` provides no-op `spec_kit.*` instrumentation hooks so production code does not import `system-skill-advisor`.\n25: - Path helpers guard operator-controlled locations such as canonical file paths.\n26: - Hook state helpers expose read-only runtime state to startup and detection modules.\n27: \n28: ---\n29: \n30: ## 2. PACKAGE TOPOLOGY\n31: \n32: ```text\n33: shared/\n34: +-- assert-never.ts             # Exhaustiveness guard\n35: +-- canonical-path.ts           # File path canonicalization helper\n36: +-- code-graph-contracts.ts     # Local readiness and ops contracts\n37: +-- hook-state.ts               # Hook state reads\n38: +-- index-scope.ts              # Scan include and exclude policy\n39: +-- logger.ts                   # Small logging helper\n40: +-- mcp-types.ts                # MCP response and arg parsing helpers\n41: +-- metrics-stub.ts             # No-op spec_kit metric surface\n42: +-- shared-payload.ts           # Trust, provenance and envelope helpers\n43: `-- README.md\n44: ```\n45: \n46: Allowed dependency direction:\n47: \n48: ```text\n49: handlers -> lib/shared\n50: lib modules -> lib/shared\n51: tools -> lib/shared\n52: lib/shared -> Node standard modules or sibling files in lib/shared\n53: ```\n54: \n55: Disallowed dependency direction:\n56: \n57: ```text\n58: lib/shared -> handlers\n59: lib/shared -> database adapters unless the contract explicitly owns storage\n60: lib/shared -> system-spec-kit or system-skill-advisor source files\n61: ```\n62: \n63: ---\n64: \n65: ## 3. DIRECTORY TREE\n66: \n67: ```text\n68: shared/\n69: +-- assert-never.ts\n70: +-- canonical-path.ts\n71: +-- code-graph-contracts.ts\n72: +-- hook-state.ts\n73: +-- index-scope.ts\n74: +-- logger.ts\n75: +-- mcp-types.ts\n76: +-- metrics-stub.ts\n77: +-- shared-payload.ts\n78: `-- README.md\n79: ```\n80: \n81: ---\n82: \n83: ## 4. KEY FILES\n84: \n85: | File | Responsibility |\n86: |---|---|\n87: | `shared-payload.ts` | Builds trust, provenance and envelope fields for graph-aware payloads. |\n88: | `code-graph-contracts.ts` | Defines local readiness and metadata preview contracts shared with ops-hardening exports. |\n89: | `index-scope.ts` | Applies default excludes and `.opencode/*` opt-in policy for scans. |\n90: | `mcp-types.ts` | Provides typed MCP response and argument parsing helpers. |\n91: | `metrics-stub.ts` | Exposes no-op metric helpers used by code-graph call sites. |\n92: | `canonical-path.ts` | Resolves canonical filesystem paths for graph records and safety checks. |\n93: | `hook-state.ts` | Reads persisted hook state for startup and readiness surfaces. |\n94: | `assert-never.ts` | Throws on impossible discriminated-union branches. |\n95: | `logger.ts` | Centralizes small logger behavior used by library modules. |\n96: \n97: ---\n98: \n99: ## 5. BOUNDARIES AND FLOW\n100: \n101: | Boundary | Rule |\n102: |---|---|\n103: | Ownership | Contracts here are owned by `system-code-graph`. Do not import sibling skill source to satisfy local type needs. |\n104: | Runtime state | Helpers may read filesystem state when their filename owns that edge, such as hook state or binary path lookup. |\n105: | Metrics | `metrics-stub.ts` intentionally keeps metric emission inert until code-graph owns a real collector. |\n106: | Scan policy | `index-scope.ts` is the source for default code-graph exclusions and `.opencode/*` opt-in behavior. |\n107: \n108: Main flow:\n109: \n110: ```text\n111: handler or library module\n112:   -> shared helper\n113:   -> typed value, safety decision or no-op metric call\n114:   -> caller shapes the final MCP payload\n115: ```\n116: \n117: ---\n118: \n119: ## 6. ENTRYPOINTS\n120: \n121: | Entrypoint | Type | Purpose |\n122: |---|---|---|\n123: | `createSharedPayloadEnvelope` | Function | Builds compact payload envelopes with provenance and optional metadata. |\n124: | `attachStructuralTrustFields` | Function | Adds parser, evidence and freshness trust fields to payload objects. |\n125: | `attachGraphEdgeEnrichment` | Function | Adds edge evidence class and numeric confidence fields. |\n126: | `shouldIndexForCodeGraph` | Function | Applies scan include and exclude policy for candidate paths. |\n127: | `parseArgs` | Function | Parses MCP tool args into object payloads. |\n128: | `isSpeckitMetricsEnabled` | Function | Returns whether local code-graph metrics should emit. Currently always `false`. |\n129: \n130: ---\n131: \n132: ## 7. VALIDATION\n133: \n134: Run from the repository root.\n135: \n136: ```bash\n137: .opencode/skills/system-code-graph/node_modules/.bin/tsc --noEmit -p .opencode/skills/system-code-graph/tsconfig.json\n138: python3 .opencode/skills/sk-doc/scripts/validate_document.py --type readme .opencode/skills/system-code-graph/mcp-server/lib/shared/README.md\n139: ```\n140: \n\n(Showing lines 1-140 of 152. Use offset=141 to continue.)\n</content>","metadata":{"preview":"---\ntitle: \"Code Graph Shared: Local Contracts And Runtime Helpers\"\ndescription: \"Local code-graph contracts for payload shaping, path safety, hook state, metrics stubs and MCP helper types.\"\ntrigger_phrases:\n  - \"code graph shared\"\n  - \"shared payload contract\"\n  - \"code graph metrics stub\"\n  - \"index scope policy\"\n---\n\n# Code Graph Shared: Local Contracts And Runtime Helpers\n\n> Local helper modules used by the `mk-code-index` runtime without importing sibling skills.\n\n---\n\n## 1. OVERVIEW\n\n`lib/shared/` contains the small contracts and runtime helpers that must be reused across code-graph handlers, library modules and tools. The folder keeps code-graph ownership local, including payload trust fields, MCP response helpers, path canonicalization, hook-state reads and scan-scope filtering.\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-code-graph/mcp-server/lib/shared/README.md","text":"---\ntitle: \"Code Graph Shared: Local Contracts And Runtime Helpers\"\ndescription: \"Local code-graph contracts for payload shaping, path safety, hook state, metrics stubs and MCP helper types.\"\ntrigger_phrases:\n  - \"code graph shared\"\n  - \"shared payload contract\"\n  - \"code graph metrics stub\"\n  - \"index scope policy\"\n---\n\n# Code Graph Shared: Local Contracts And Runtime Helpers\n\n> Local helper modules used by the `mk-code-index` runtime without importing sibling skills.\n\n---\n\n## 1. OVERVIEW\n\n`lib/shared/` contains the small contracts and runtime helpers that must be reused across code-graph handlers, library modules and tools. The folder keeps code-graph ownership local, including payload trust fields, MCP response helpers, path canonicalization, hook-state reads and scan-scope filtering.\n\nCurrent state:\n\n- Shared payload and code-graph contract types are local copies owned by this package.\n- `metrics-stub.ts` provides no-op `spec_kit.*` instrumentation hooks so production code does not import `system-skill-advisor`.\n- Path helpers guard operator-controlled locations such as canonical file paths.\n- Hook state helpers expose read-only runtime state to startup and detection modules.\n\n---\n\n## 2. PACKAGE TOPOLOGY\n\n```text\nshared/\n+-- assert-never.ts             # Exhaustiveness guard\n+-- canonical-path.ts           # File path canonicalization helper\n+-- code-graph-contracts.ts     # Local readiness and ops contracts\n+-- hook-state.ts               # Hook state reads\n+-- index-scope.ts              # Scan include and exclude policy\n+-- logger.ts                   # Small logging helper\n+-- mcp-types.ts                # MCP response and arg parsing helpers\n+-- metrics-stub.ts             # No-op spec_kit metric surface\n+-- shared-payload.ts           # Trust, provenance and envelope helpers\n`-- README.md\n```\n\nAllowed dependency direction:\n\n```text\nhandlers -> lib/shared\nlib modules -> lib/shared\ntools -> lib/shared\nlib/shared -> Node standard modules or sibling files in lib/shared\n```\n\nDisallowed dependency direction:\n\n```text\nlib/shared -> handlers\nlib/shared -> database adapters unless the contract explicitly owns storage\nlib/shared -> system-spec-kit or system-skill-advisor source files\n```\n\n---\n\n## 3. DIRECTORY TREE\n\n```text\nshared/\n+-- assert-never.ts\n+-- canonical-path.ts\n+-- code-graph-contracts.ts\n+-- hook-state.ts\n+-- index-scope.ts\n+-- logger.ts\n+-- mcp-types.ts\n+-- metrics-stub.ts\n+-- shared-payload.ts\n`-- README.md\n```\n\n---\n\n## 4. KEY FILES\n\n| File | Responsibility |\n|---|---|\n| `shared-payload.ts` | Builds trust, provenance and envelope fields for graph-aware payloads. |\n| `code-graph-contracts.ts` | Defines local readiness and metadata preview contracts shared with ops-hardening exports. |\n| `index-scope.ts` | Applies default excludes and `.opencode/*` opt-in policy for scans. |\n| `mcp-types.ts` | Provides typed MCP response and argument parsing helpers. |\n| `metrics-stub.ts` | Exposes no-op metric helpers used by code-graph call sites. |\n| `canonical-path.ts` | Resolves canonical filesystem paths for graph records and safety checks. |\n| `hook-state.ts` | Reads persisted hook state for startup and readiness surfaces. |\n| `assert-never.ts` | Throws on impossible discriminated-union branches. |\n| `logger.ts` | Centralizes small logger behavior used by library modules. |\n\n---\n\n## 5. BOUNDARIES AND FLOW\n\n| Boundary | Rule |\n|---|---|\n| Ownership | Contracts here are owned by `system-code-graph`. Do not import sibling skill source to satisfy local type needs. |\n| Runtime state | Helpers may read filesystem state when their filename owns that edge, such as hook state or binary path lookup. |\n| Metrics | `metrics-stub.ts` intentionally keeps metric emission inert until code-graph owns a real collector. |\n| Scan policy | `index-scope.ts` is the source for default code-graph exclusions and `.opencode/*` opt-in behavior. |\n\nMain flow:\n\n```text\nhandler or library module\n  -> shared helper\n  -> typed value, safety decision or no-op metric call\n  -> caller shapes the final MCP payload\n```\n\n---\n\n## 6. ENTRYPOINTS\n\n| Entrypoint | Type | Purpose |\n|---|---|---|\n| `createSharedPayloadEnvelope` | Function | Builds compact payload envelopes with provenance and optional metadata. |\n| `attachStructuralTrustFields` | Function | Adds parser, evidence and freshness trust fields to payload objects. |\n| `attachGraphEdgeEnrichment` | Function | Adds edge evidence class and numeric confidence fields. |\n| `shouldIndexForCodeGraph` | Function | Applies scan include and exclude policy for candidate paths. |\n| `parseArgs` | Function | Parses MCP tool args into object payloads. |\n| `isSpeckitMetricsEnabled` | Function | Returns whether local code-graph metrics should emit. Currently always `false`. |\n\n---\n\n## 7. VALIDATION\n\nRun from the repository root.\n\n```bash\n.opencode/skills/system-code-graph/node_modules/.bin/tsc --noEmit -p .opencode/skills/system-code-graph/tsconfig.json\npython3 .opencode/skills/sk-doc/scripts/validate_document.py --type readme .opencode/skills/system-code-graph/mcp-server/lib/shared/README.md\n```\n","lineStart":1,"lineEnd":140,"totalLines":152,"truncated":true}},"title":".opencode/skills/system-code-graph/mcp-server/lib/shared/README.md","time":{"start":1785134497230,"end":1785134497235}},"metadata":{"openai":{"itemId":"fc_02919b9ca7f267f7016a66fda0e7288191bd6bc1be9289715e"}},"id":"prt_fa24ebd6e001QRs0r4h8sE6PES","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa24e75ed0015024CCVuQlKj8B"}}
