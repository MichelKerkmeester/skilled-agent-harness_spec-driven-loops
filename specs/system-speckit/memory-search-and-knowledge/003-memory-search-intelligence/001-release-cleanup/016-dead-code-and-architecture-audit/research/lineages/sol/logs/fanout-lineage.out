d value ${JSON.stringify(unexpectedValue)}${context ? ` (${context})` : ''}`,\n  );\n}","lineStart":1,"lineEnd":9,"totalLines":9,"truncated":false}},"title":".opencode/skills/system-code-graph/mcp-server/lib/shared/assert-never.ts","time":{"start":1785133911500,"end":1785133911562}},"metadata":{"openai":{"itemId":"fc_08386469f3ac3b14016a66fb57575081918893fba6dcfec532"}},"id":"prt_fa245cdc9001s75OaRQu24A8nt","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa24583d3001m3IH87k1UPOQ0H"}}
