{"type":"tool_use","timestamp":1785134465946,"sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","part":{"type":"tool","tool":"read","callID":"call_32MVHo1IO98IfGl2X6pKHkJI","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-skill-advisor/mcp-server/plugin-bridges/mk-skill-advisor-bridge.mjs","limit":240},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-skill-advisor/mcp-server/plugin-bridges/mk-skill-advisor-bridge.mjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ COMPONENT: Skill Advisor Plugin Bridge (mk-skill-advisor, MJS source)   ║\n4: // ╠══════════════════════════════════════════════════════════════════════════╣\n5: // ║ PURPOSE: Subprocess bridge between `.opencode/plugins/mk-skill-          ║\n6: // ║          advisor.js` and the standalone mk_skill_advisor MCP server.     ║\n7: // ║          The plugin spawns this script with stdin JSON; this script      ║\n8: // ║          writes a single stdout JSON response and exits.                 ║\n9: // ╚══════════════════════════════════════════════════════════════════════════╝\n10: //\n11: // This file is the SOURCE-OF-TRUTH bridge. It lives outside the\n12: // TypeScript build tree on purpose:\n13: //   1. The OpenCode plugin host imports `.opencode/plugins/*.js` only — having\n14: //      the bridge as a sibling .mjs keeps the plugin entrypoint count to 1\n15: //      while letting the bridge use ESM and dynamic imports without TS\n16: //      compile coordination on every plugin reload.\n17: //   2. The bridge is a thin subprocess wrapper (parse stdin → call native\n18: //      compat handlers → emit stdout JSON) and benefits from being editable\n19: //      as plain JS for live diagnosis when the OpenCode plugin host misroutes.\n20: //   3. Migrating to TS would require either (a) building this file into the\n21: //      same dist tree the plugin watches, creating a chicken-and-egg with\n22: //      cache-signature freshness, or (b) maintaining a\n23: //      .ts → .mjs build step exclusive to this single file. Either path is\n24: //      a larger packet than the source/dist boundary fixes here.\n25: //\n26: // Smoke tests asserting the subprocess envelope live in the standalone\n27: // system-skill-advisor compatibility test suite.\n28: // This file intentionally lives outside\n29: // `.opencode/plugins/` so OpenCode discovers only real plugin entrypoints.\n30: \n31: import { spawn } from 'node:child_process';\n32: import { existsSync, readFileSync } from 'node:fs';\n33: import { createRequire } from 'node:module';\n34: import { dirname, resolve } from 'node:path';\n35: import { fileURLToPath } from 'node:url';\n36: \n37: import { Client } from '@modelcontextprotocol/sdk/client/index.js';\n38: import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';\n39: \n40: const COMPAT_CONTRACT = JSON.parse(readFileSync(new URL('../../../system-skill-advisor/mcp-server/schemas/compat-contract.json', import.meta.url), 'utf8'));\n41: const STATUS_VALUES = new Set(COMPAT_CONTRACT.statusValues);\n42: const DISABLED_ENV = COMPAT_CONTRACT.disabledEnv;\n43: const FORCE_LOCAL_ENV = COMPAT_CONTRACT.forceLocalEnv;\n44: const DEFAULT_CONFIDENCE_THRESHOLD = COMPAT_CONTRACT.defaults.confidenceThreshold;\n45: const DEFAULT_UNCERTAINTY_THRESHOLD = COMPAT_CONTRACT.defaults.uncertaintyThreshold;\n46: const ADVISOR_LAUNCHER_PATH = fileURLToPath(new URL('../../../../bin/mk-skill-advisor-launcher.cjs', import.meta.url));\n47: const ADVISOR_CLI_PATH = fileURLToPath(new URL('../../../../bin/skill-advisor.cjs', import.meta.url));\n48: const ADVISOR_BRIDGE_HELPER_PATH = fileURLToPath(new URL('../../../../bin/lib/launcher-ipc-bridge.cjs', import.meta.url));\n49: const DEFAULT_SOCKET_DIR = '/tmp/mk-skill-advisor';\n50: const ADVISOR_MCP_TIMEOUT_MS = 8000;\n51: const ADVISOR_CLI_TIMEOUT_MS = 250;\n52: const ADVISOR_CLI_PROBE_TIMEOUT_MS = 50;\n53: const ADVISOR_CLI_RETRYABLE_EXIT = 75;\n54: const ADVISOR_CLI_STALE_EXIT = 69;\n55: const MAX_CLI_STDERR_BYTES = 1024 * 1024;\n56: const SOCKET_FILE_NAME = 'daemon-ipc.sock';\n57: const require = createRequire(import.meta.url);\n58: const CHILD_ENV_ALLOWLIST = new Set([\n59:   'PATH',\n60:   'HOME',\n61:   'USER',\n62:   'LOGNAME',\n63:   'SHELL',\n64:   'TMPDIR',\n65:   'TEMP',\n66:   'TMP',\n67:   'LANG',\n68:   'LC_ALL',\n69:   'CI',\n70:   'VITEST',\n71:   'MK_SKILL_ADVISOR_DB_DIR',\n72:   'SYSTEM_SKILL_ADVISOR_DB_DIR',\n73:   'SPECKIT_RUNTIME',\n74:   // Compiled-routing runtime flag. Forwarded so the operator's .env value reaches\n75:   // the bridge-spawned advisor child instead of being stripped at the boundary;\n76:   // without it a compiled-routing canary is impossible. One exact key, no prefix.\n77:   'SPECKIT_COMPILED_ROUTING',\n78:   'SPECKIT_ADVISOR_FRESHNESS',\n79:   'MK_SKILL_ADVISOR_HOOK_DISABLED',\n80:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n81:   'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n82:   'SPECKIT_OPENCODE_HOOK_TIMEOUT_MS',\n83:   'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n84:   'SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST',\n85:   'SPECKIT_ADVISOR_SHADOW_DELTA_PATH',\n86:   'SPECKIT_METRICS_ENABLED',\n87:   'SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS',\n88:   'SPECKIT_IPC_SOCKET_DIR',\n89:   'SPECKIT_SKILL_ADVISOR_CLI_FALLBACK_TIMEOUT_MS',\n90:   'SPECKIT_SKILL_ADVISOR_CLI_PROBE_TIMEOUT_MS',\n91: ]);\n92: \n93: /**\n94:  * Build the normalized bridge response envelope consumed by the plugin host.\n95:  *\n96:  * @param {object} args - Response fields from the selected advisor route.\n97:  * @returns {object} JSON-serializable bridge response.\n98:  */\n99: function response(args) {\n100:   return {\n101:     brief: typeof args.brief === 'string' ? args.brief : null,\n102:     status: STATUS_VALUES.has(args.status) ? args.status : 'fail_open',\n103:     metadata: args.metadata && typeof args.metadata === 'object' ? args.metadata : {},\n104:     ...(args.error ? { error: args.error } : {}),\n105:   };\n106: }\n107: \n108: function failOpen(error) {\n109:   return response({\n110:     brief: null,\n111:     status: 'fail_open',\n112:     error,\n113:     metadata: {},\n114:   });\n115: }\n116: \n117: function errorCode(error) {\n118:   const raw = error?.code ?? error?.name ?? 'UNKNOWN';\n119:   const normalized = String(raw).toUpperCase().replace(/[^A-Z0-9_]/g, '_');\n120:   return normalized || 'UNKNOWN';\n121: }\n122: \n123: async function readStdin() {\n124:   let input = '';\n125:   process.stdin.setEncoding('utf8');\n126:   for await (const chunk of process.stdin) {\n127:     input += chunk;\n128:   }\n129:   return input;\n130: }\n131: \n132: async function withStdoutSilenced(fn) {\n133:   const forwarded = (...args) => {\n134:     const rendered = args\n135:       .map((value) => (typeof value === 'string' ? value : JSON.stringify(value)))\n136:       .join(' ');\n137:     process.stderr.write(`${rendered}\\n`);\n138:   };\n139: \n140:   const original = {\n141:     log: console.log,\n142:     info: console.info,\n143:     debug: console.debug,\n144:     warn: console.warn,\n145:   };\n146: \n147:   console.log = forwarded;\n148:   console.info = forwarded;\n149:   console.debug = forwarded;\n150:   console.warn = forwarded;\n151: \n152:   try {\n153:     return await fn();\n154:   } finally {\n155:     console.log = original.log;\n156:     console.info = original.info;\n157:     console.debug = original.debug;\n158:     console.warn = original.warn;\n159:   }\n160: }\n161: \n162: /**\n163:  * Parse and validate the stdin payload sent by the plugin host.\n164:  *\n165:  * @param {string} text - Raw JSON stdin text.\n166:  * @returns {object} Validated bridge input payload.\n167:  */\n168: function parseInput(text) {\n169:   if (!text.trim()) {\n170:     throw Object.assign(new Error('Missing bridge input'), { code: 'MISSING_INPUT' });\n171:   }\n172:   const parsed = JSON.parse(text);\n173:   if (typeof parsed?.prompt !== 'string') {\n174:     throw Object.assign(new Error('Missing prompt'), { code: 'MISSING_PROMPT' });\n175:   }\n176:   if (typeof parsed?.workspaceRoot !== 'string' || !parsed.workspaceRoot.trim()) {\n177:     throw Object.assign(new Error('Missing workspace root'), { code: 'MISSING_WORKSPACE_ROOT' });\n178:   }\n179:   return parsed;\n180: }\n181: \n182: function positiveInt(value, fallback) {\n183:   return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n184: }\n185: \n186: function threshold(value) {\n187:   if (!Number.isFinite(value)) {\n188:     return DEFAULT_CONFIDENCE_THRESHOLD;\n189:   }\n190:   return Math.min(1, Math.max(0, Number(value)));\n191: }\n192: \n193: function formatScore(value) {\n194:   return Number.isFinite(value) ? Number(value).toFixed(2) : '0.00';\n195: }\n196: \n197: function sanitizeLabel(value) {\n198:   if (typeof value !== 'string') {\n199:     return null;\n200:   }\n201:   const cleaned = value.replace(/[\\u0000-\\u001F\\u007F]/g, '').replace(/\\s+/g, ' ').trim();\n202:   if (!cleaned || cleaned.length > 160 || /\\b(ignore|override|forget|bypass|disable|execute|run|call|tool|developer|assistant|previous instructions|all instructions)\\b/i.test(cleaned) || /<!--|-->|```|<script\\b|<\\/script>|^\\s*(system|instruction|developer|assistant)\\s*:/i.test(cleaned)) {\n203:     return null;\n204:   }\n205:   return cleaned;\n206: }\n207: \n208: /**\n209:  * Create a minimal environment for advisor subprocesses.\n210:  *\n211:  * @param {NodeJS.ProcessEnv} [sourceEnv=process.env] - Environment to filter.\n212:  * @returns {Record<string, string>} Allowlisted child-process environment.\n213:  */\n214: function createChildEnv(sourceEnv = process.env) {\n215:   return Object.fromEntries(\n216:     Object.entries(sourceEnv).filter((entry) => CHILD_ENV_ALLOWLIST.has(entry[0]) && typeof entry[1] === 'string'),\n217:   );\n218: }\n219: \n220: function resolveCliSocketDir(env = process.env, workspaceRoot = process.cwd()) {\n221:   // Default to the same short /tmp directory as the launcher and CLI shim.\n222:   // Defaulting to the database directory produced a socket path longer than\n223:   // Darwin's 103-byte sun_path limit, so the warm probe always failed and the\n224:   // CLI fallback could never engage. An explicit env override still wins.\n225:   const baseSocketDir = env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SOCKET_DIR;\n226:   if (baseSocketDir.startsWith('tcp://')) return baseSocketDir;\n227:   const bridge = loadBridgeHelper();\n228:   if (!bridge || typeof bridge.getIpcSocketPath !== 'function') return baseSocketDir;\n229:   const dbDir = env.MK_SKILL_ADVISOR_DB_DIR\n230:     ? resolve(workspaceRoot, env.MK_SKILL_ADVISOR_DB_DIR)\n231:     : resolve(workspaceRoot, '.opencode/skills/system-skill-advisor/mcp-server/database');\n232:   return dirname(bridge.getIpcSocketPath('mk-skill-advisor', { dbDir }));\n233: }\n234: \n235: function createCliChildEnv(sourceEnv = process.env) {\n236:   return {\n237:     ...createChildEnv(sourceEnv),\n238:     SPECKIT_IPC_SOCKET_DIR: resolveCliSocketDir(sourceEnv),\n239:     MK_SKILL_ADVISOR_CLI_PROMPT_TIME: '1',\n240:   };\n\n(Showing lines 1-240 of 1012. Use offset=241 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: Skill Advisor Plugin Bridge (mk-skill-advisor, MJS source)   ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Subprocess bridge between `.opencode/plugins/mk-skill-          ║\n// ║          advisor.js` and the standalone mk_skill_advisor MCP server.     ║\n// ║          The plugin spawns this script with stdin JSON; this script      ║\n// ║          writes a single stdout JSON response and exits.                 ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n//\n// This file is the SOURCE-OF-TRUTH bridge. It lives outside the\n// TypeScript build tree on purpose:\n//   1. The OpenCode plugin host imports `.opencode/plugins/*.js` only — having\n//      the bridge as a sibling .mjs keeps the plugin entrypoint count to 1\n//      while letting the bridge use ESM and dynamic imports without TS\n//      compile coordination on every plugin reload.\n//   2. The bridge is a thin subprocess wrapper (parse stdin → call native\n//      compat handlers → emit stdout JSON) and benefits from being editable\n//      as plain JS for live diagnosis when the OpenCode plugin host misroutes.\n//   3. Migrating to TS would require either (a) building this file into the","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-skill-advisor/mcp-server/plugin-bridges/mk-skill-advisor-bridge.mjs","text":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: Skill Advisor Plugin Bridge (mk-skill-advisor, MJS source)   ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Subprocess bridge between `.opencode/plugins/mk-skill-          ║\n// ║          advisor.js` and the standalone mk_skill_advisor MCP server.     ║\n// ║          The plugin spawns this script with stdin JSON; this script      ║\n// ║          writes a single stdout JSON response and exits.                 ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n//\n// This file is the SOURCE-OF-TRUTH bridge. It lives outside the\n// TypeScript build tree on purpose:\n//   1. The OpenCode plugin host imports `.opencode/plugins/*.js` only — having\n//      the bridge as a sibling .mjs keeps the plugin entrypoint count to 1\n//      while letting the bridge use ESM and dynamic imports without TS\n//      compile coordination on every plugin reload.\n//   2. The bridge is a thin subprocess wrapper (parse stdin → call native\n//      compat handlers → emit stdout JSON) and benefits from being editable\n//      as plain JS for live diagnosis when the OpenCode plugin host misroutes.\n//   3. Migrating to TS would require either (a) building this file into the\n//      same dist tree the plugin watches, creating a chicken-and-egg with\n//      cache-signature freshness, or (b) maintaining a\n//      .ts → .mjs build step exclusive to this single file. Either path is\n//      a larger packet than the source/dist boundary fixes here.\n//\n// Smoke tests asserting the subprocess envelope live in the standalone\n// system-skill-advisor compatibility test suite.\n// This file intentionally lives outside\n// `.opencode/plugins/` so OpenCode discovers only real plugin entrypoints.\n\nimport { spawn } from 'node:child_process';\nimport { existsSync, readFileSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { Client } from '@modelcontextprotocol/sdk/client/index.js';\nimport { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';\n\nconst COMPAT_CONTRACT = JSON.parse(readFileSync(new URL('../../../system-skill-advisor/mcp-server/schemas/compat-contract.json', import.meta.url), 'utf8'));\nconst STATUS_VALUES = new Set(COMPAT_CONTRACT.statusValues);\nconst DISABLED_ENV = COMPAT_CONTRACT.disabledEnv;\nconst FORCE_LOCAL_ENV = COMPAT_CONTRACT.forceLocalEnv;\nconst DEFAULT_CONFIDENCE_THRESHOLD = COMPAT_CONTRACT.defaults.confidenceThreshold;\nconst DEFAULT_UNCERTAINTY_THRESHOLD = COMPAT_CONTRACT.defaults.uncertaintyThreshold;\nconst ADVISOR_LAUNCHER_PATH = fileURLToPath(new URL('../../../../bin/mk-skill-advisor-launcher.cjs', import.meta.url));\nconst ADVISOR_CLI_PATH = fileURLToPath(new URL('../../../../bin/skill-advisor.cjs', import.meta.url));\nconst ADVISOR_BRIDGE_HELPER_PATH = fileURLToPath(new URL('../../../../bin/lib/launcher-ipc-bridge.cjs', import.meta.url));\nconst DEFAULT_SOCKET_DIR = '/tmp/mk-skill-advisor';\nconst ADVISOR_MCP_TIMEOUT_MS = 8000;\nconst ADVISOR_CLI_TIMEOUT_MS = 250;\nconst ADVISOR_CLI_PROBE_TIMEOUT_MS = 50;\nconst ADVISOR_CLI_RETRYABLE_EXIT = 75;\nconst ADVISOR_CLI_STALE_EXIT = 69;\nconst MAX_CLI_STDERR_BYTES = 1024 * 1024;\nconst SOCKET_FILE_NAME = 'daemon-ipc.sock';\nconst require = createRequire(import.meta.url);\nconst CHILD_ENV_ALLOWLIST = new Set([\n  'PATH',\n  'HOME',\n  'USER',\n  'LOGNAME',\n  'SHELL',\n  'TMPDIR',\n  'TEMP',\n  'TMP',\n  'LANG',\n  'LC_ALL',\n  'CI',\n  'VITEST',\n  'MK_SKILL_ADVISOR_DB_DIR',\n  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n  'SPECKIT_RUNTIME',\n  // Compiled-routing runtime flag. Forwarded so the operator's .env value reaches\n  // the bridge-spawned advisor child instead of being stripped at the boundary;\n  // without it a compiled-routing canary is impossible. One exact key, no prefix.\n  'SPECKIT_COMPILED_ROUTING',\n  'SPECKIT_ADVISOR_FRESHNESS',\n  'MK_SKILL_ADVISOR_HOOK_DISABLED',\n  'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n  'SPECKIT_OPENCODE_HOOK_TIMEOUT_MS',\n  'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n  'SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST',\n  'SPECKIT_ADVISOR_SHADOW_DELTA_PATH',\n  'SPECKIT_METRICS_ENABLED',\n  'SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS',\n  'SPECKIT_IPC_SOCKET_DIR',\n  'SPECKIT_SKILL_ADVISOR_CLI_FALLBACK_TIMEOUT_MS',\n  'SPECKIT_SKILL_ADVISOR_CLI_PROBE_TIMEOUT_MS',\n]);\n\n/**\n * Build the normalized bridge response envelope consumed by the plugin host.\n *\n * @param {object} args - Response fields from the selected advisor route.\n * @returns {object} JSON-serializable bridge response.\n */\nfunction response(args) {\n  return {\n    brief: typeof args.brief === 'string' ? args.brief : null,\n    status: STATUS_VALUES.has(args.status) ? args.status : 'fail_open',\n    metadata: args.metadata && typeof args.metadata === 'object' ? args.metadata : {},\n    ...(args.error ? { error: args.error } : {}),\n  };\n}\n\nfunction failOpen(error) {\n  return response({\n    brief: null,\n    status: 'fail_open',\n    error,\n    metadata: {},\n  });\n}\n\nfunction errorCode(error) {\n  const raw = error?.code ?? error?.name ?? 'UNKNOWN';\n  const normalized = String(raw).toUpperCase().replace(/[^A-Z0-9_]/g, '_');\n  return normalized || 'UNKNOWN';\n}\n\nasync function readStdin() {\n  let input = '';\n  process.stdin.setEncoding('utf8');\n  for await (const chunk of process.stdin) {\n    input += chunk;\n  }\n  return input;\n}\n\nasync function withStdoutSilenced(fn) {\n  const forwarded = (...args) => {\n    const rendered = args\n      .map((value) => (typeof value === 'string' ? value : JSON.stringify(value)))\n      .join(' ');\n    process.stderr.write(`${rendered}\\n`);\n  };\n\n  const original = {\n    log: console.log,\n    info: console.info,\n    debug: console.debug,\n    warn: console.warn,\n  };\n\n  console.log = forwarded;\n  console.info = forwarded;\n  console.debug = forwarded;\n  console.warn = forwarded;\n\n  try {\n    return await fn();\n  } finally {\n    console.log = original.log;\n    console.info = original.info;\n    console.debug = original.debug;\n    console.warn = original.warn;\n  }\n}\n\n/**\n * Parse and validate the stdin payload sent by the plugin host.\n *\n * @param {string} text - Raw JSON stdin text.\n * @returns {object} Validated bridge input payload.\n */\nfunction parseInput(text) {\n  if (!text.trim()) {\n    throw Object.assign(new Error('Missing bridge input'), { code: 'MISSING_INPUT' });\n  }\n  const parsed = JSON.parse(text);\n  if (typeof parsed?.prompt !== 'string') {\n    throw Object.assign(new Error('Missing prompt'), { code: 'MISSING_PROMPT' });\n  }\n  if (typeof parsed?.workspaceRoot !== 'string' || !parsed.workspaceRoot.trim()) {\n    throw Object.assign(new Error('Missing workspace root'), { code: 'MISSING_WORKSPACE_ROOT' });\n  }\n  return parsed;\n}\n\nfunction positiveInt(value, fallback) {\n  return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n}\n\nfunction threshold(value) {\n  if (!Number.isFinite(value)) {\n    return DEFAULT_CONFIDENCE_THRESHOLD;\n  }\n  return Math.min(1, Math.max(0, Number(value)));\n}\n\nfunction formatScore(value) {\n  return Number.isFinite(value) ? Number(value).toFixed(2) : '0.00';\n}\n\nfunction sanitizeLabel(value) {\n  if (typeof value !== 'string') {\n    return null;\n  }\n  const cleaned = value.replace(/[\\u0000-\\u001F\\u007F]/g, '').replace(/\\s+/g, ' ').trim();\n  if (!cleaned || cleaned.length > 160 || /\\b(ignore|override|forget|bypass|disable|execute|run|call|tool|developer|assistant|previous instructions|all instructions)\\b/i.test(cleaned) || /<!--|-->|```|<script\\b|<\\/script>|^\\s*(system|instruction|developer|assistant)\\s*:/i.test(cleaned)) {\n    return null;\n  }\n  return cleaned;\n}\n\n/**\n * Create a minimal environment for advisor subprocesses.\n *\n * @param {NodeJS.ProcessEnv} [sourceEnv=process.env] - Environment to filter.\n * @returns {Record<string, string>} Allowlisted child-process environment.\n */\nfunction createChildEnv(sourceEnv = process.env) {\n  return Object.fromEntries(\n    Object.entries(sourceEnv).filter((entry) => CHILD_ENV_ALLOWLIST.has(entry[0]) && typeof entry[1] === 'string'),\n  );\n}\n\nfunction resolveCliSocketDir(env = process.env, workspaceRoot = process.cwd()) {\n  // Default to the same short /tmp directory as the launcher and CLI shim.\n  // Defaulting to the database directory produced a socket path longer than\n  // Darwin's 103-byte sun_path limit, so the warm probe always failed and the\n  // CLI fallback could never engage. An explicit env override still wins.\n  const baseSocketDir = env.SPECKIT_IPC_SOCKET_DIR ?? DEFAULT_SOCKET_DIR;\n  if (baseSocketDir.startsWith('tcp://')) return baseSocketDir;\n  const bridge = loadBridgeHelper();\n  if (!bridge || typeof bridge.getIpcSocketPath !== 'function') return baseSocketDir;\n  const dbDir = env.MK_SKILL_ADVISOR_DB_DIR\n    ? resolve(workspaceRoot, env.MK_SKILL_ADVISOR_DB_DIR)\n    : resolve(workspaceRoot, '.opencode/skills/system-skill-advisor/mcp-server/database');\n  return dirname(bridge.getIpcSocketPath('mk-skill-advisor', { dbDir }));\n}\n\nfunction createCliChildEnv(sourceEnv = process.env) {\n  return {\n    ...createChildEnv(sourceEnv),\n    SPECKIT_IPC_SOCKET_DIR: resolveCliSocketDir(sourceEnv),\n    MK_SKILL_ADVISOR_CLI_PROMPT_TIME: '1',\n  };","lineStart":1,"lineEnd":240,"totalLines":1012,"truncated":true}},"title":".opencode/skills/system-skill-advisor/mcp-server/plugin-bridges/mk-skill-advisor-bridge.mjs","time":{"start":1785134465912,"end":1785134465944}},"metadata":{"openai":{"itemId":"fc_0c5e98665029ae6b016a66fd81c19c8191b40937c73a1577f8"}},"id":"prt_fa24e433500126y5Db0ATR9ify","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa24e0e67001aGMPcWeCkSjLuD"}}
