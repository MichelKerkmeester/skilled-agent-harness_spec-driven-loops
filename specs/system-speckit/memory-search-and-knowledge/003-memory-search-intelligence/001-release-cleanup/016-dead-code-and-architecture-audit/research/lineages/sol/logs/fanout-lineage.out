           \"aside\": {\n55:             \"transport\": \"stdio\",\n56:             \"command\": \"aside\",\n57:             \"args\": [\n58:               \"mcp\"\n59:             ],\n60:             \"env\": {}\n61:           }\n62:         }\n63:       }\n64:     },\n65:     {\n66:       \"name\": \"clickup_official\",\n67:       \"call_template_type\": \"mcp\",\n68:       \"config\": {\n69:         \"mcpServers\": {\n70:           \"clickup_official\": {\n71:             \"transport\": \"stdio\",\n72:             \"command\": \"npx\",\n73:             \"args\": [\n74:               \"-y\",\n75:               \"@clickup/mcp-server\"\n76:             ],\n77:             \"env\": {\n78:               \"CLICKUP_API_KEY\": \"${CLICKUP_API_KEY}\",\n79:               \"CLICKUP_TEAM_ID\": \"${CLICKUP_TEAM_ID}\"\n80:             }\n\n(Showing lines 1-80 of 200. Use offset=81 to continue.)\n</content>","metadata":{"preview":"{\n  \"load_variables_from\": [\n    {\n      \"variable_loader_type\": \"dotenv\",\n      \"env_file_path\": \".env\"\n    }\n  ],\n  \"tool_repository\": {\n    \"tool_repository_type\": \"in_memory\"\n  },\n  \"tool_search_strategy\": {\n    \"tool_search_strategy_type\": \"tag_and_description_word_match\"\n  },\n  \"manual_call_templates\": [\n    {\n      \"name\": \"chrome_devtools_1\",\n      \"call_template_type\": \"mcp\",\n      \"config\": {\n        \"mcpServers\": {\n          \"chrome_devtools_1\": {","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.utcp_config.json","text":"{\n  \"load_variables_from\": [\n    {\n      \"variable_loader_type\": \"dotenv\",\n      \"env_file_path\": \".env\"\n    }\n  ],\n  \"tool_repository\": {\n    \"tool_repository_type\": \"in_memory\"\n  },\n  \"tool_search_strategy\": {\n    \"tool_search_strategy_type\": \"tag_and_description_word_match\"\n  },\n  \"manual_call_templates\": [\n    {\n      \"name\": \"chrome_devtools_