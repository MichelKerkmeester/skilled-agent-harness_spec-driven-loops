{"type":"tool_use","timestamp":1785134448112,"sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","part":{"type":"tool","tool":"read","callID":"call_4rKOP4QuynbhAKZNkEQKXZfJ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/bin/cli-exit-taxonomy-smoke.cjs","limit":240},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/bin/cli-exit-taxonomy-smoke.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ COMPONENT: CLI Exit-Taxonomy Smoke                                       ║\n4: // ╠══════════════════════════════════════════════════════════════════════════╣\n5: // ║ PURPOSE: Daemon-free exit-code and envelope taxonomy smoke for the       ║\n6: // ║ three CLI shims (warm-only=75, usage/trust refusal=64).                  ║\n7: // ╚══════════════════════════════════════════════════════════════════════════╝\n8: 'use strict';\n9: \n10: // The sibling cli-offline-smoke.cjs proves list-tools counts; this\n11: // script proves the FAILURE contract: warm-only refusals exit 75, usage\n12: // and trust refusals exit 64, and failure envelopes stay parseable JSON\n13: // (or usage text) rather than stack traces. Every case runs in a sandbox\n14: // socket dir so no daemon is ever spawned or contacted.\n15: \n16: // ─────────────────────────────────────────────────────────────────────────────\n17: // 1. IMPORTS\n18: // ─────────────────────────────────────────────────────────────────────────────\n19: \n20: const fs = require('fs');\n21: const os = require('os');\n22: const path = require('path');\n23: const { spawnSync } = require('child_process');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const repoRoot = path.resolve(__dirname, '..', '..');\n30: \n31: const SHIMS = {\n32:   'spec-memory': path.join(__dirname, 'spec-memory.cjs'),\n33:   'code-index': path.join(__dirname, 'code-index.cjs'),\n34:   'skill-advisor': path.join(__dirname, 'skill-advisor.cjs'),\n35: };\n36: \n37: // ─────────────────────────────────────────────────────────────────────────────\n38: // 3. TAXONOMY CASES\n39: // ─────────────────────────────────────────────────────────────────────────────\n40: \n41: const CASES = [\n42:   // Warm-only reads with no daemon must refuse retryably (75), never spawn.\n43:   { name: 'spec-memory warm-only read exits 75', shim: 'spec-memory', args: ['memory_stats', '--json', '{}', '--warm-only', '--format', 'json'], expectExit: 75, expectJsonStatus: 'error' },\n44:   { name: 'code-index warm-only read exits 75', shim: 'code-index', args: ['code_graph_status', '--warm-only', '--format', 'json'], expectExit: 75, expectJsonStatus: 'error' },\n45:   { name: 'skill-advisor warm-only read exits 75', shim: 'skill-advisor', args: ['advisor_recommend', '--json', '{\"prompt\":\"taxonomy smoke\"}', '--warm-only', '--format', 'json'], expectExit: 75, expectJsonStatus: 'error' },\n46:   // Unknown commands are usage errors (64).\n47:   { name: 'spec-memory unknown command exits 64', shim: 'spec-memory', args: ['no_such_tool', '--format', 'json'], expectExit: 64 },\n48:   { name: 'code-index unknown command exits 64', shim: 'code-index', args: ['no_such_tool', '--format', 'json'], expectExit: 64 },\n49:   { name: 'skill-advisor unknown command exits 64', shim: 'skill-advisor', args: ['no_such_tool', '--format', 'json'], expectExit: 64 },\n50:   // Trust refusal: advisor mutations without --trusted fail closed (64)\n51:   // before any IPC frame, so this stays daemon-free.\n52:   { name: 'skill-advisor untrusted mutation exits 64', shim: 'skill-advisor', args: ['skill_graph_scan', '--format', 'json'], expectExit: 64 },\n53:   // Mutation-intent guard: a bare apply is refused as usage (64) before\n54:   // any daemon contact — default rescan routing must be opted into.\n55:   { name: 'code-index bare apply guarded exits 64', shim: 'code-index', args: ['code_graph_apply', '--format', 'json'], expectExit: 64 },\n56: ];\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 4. ARGUMENT PARSING\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: function parseArgs(argv) {\n63:   const options = { format: 'text', timeoutMs: 20_000 };\n64:   for (let index = 0; index < argv.length; index += 1) {\n65:     const value = argv[index];\n66:     if (value === '--format') {\n67:       options.format = argv[index + 1] === 'json' ? 'json' : 'text';\n68:       index += 1;\n69:     } else if (value === '--json') {\n70:       options.format = 'json';\n71:     } else if (value === '--timeout-ms') {\n72:       const parsed = Number.parseInt(argv[index + 1], 10);\n73:       if (Number.isFinite(parsed) && parsed > 0) options.timeoutMs = parsed;\n74:       index += 1;\n75:     }\n76:   }\n77:   return options;\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 5. CASE EXECUTION\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function parseJson(text) {\n85:   if (!text || !text.trim()) return null;\n86:   try {\n87:     return JSON.parse(text);\n88:   } catch {\n89:     return null;\n90:   }\n91: }\n92: \n93: function runCase(testCase, timeoutMs) {\n94:   const sandbox = fs.mkdtempSync(path.join(os.tmpdir(), 'cli-taxonomy-smoke-'));\n95:   const socketDir = path.join(sandbox, 'sock');\n96:   try {\n97:     const result = spawnSync(process.execPath, [SHIMS[testCase.shim], ...testCase.args], {\n98:       cwd: repoRoot,\n99:       env: {\n100:         ...process.env,\n101:         SPECKIT_IPC_SOCKET_DIR: socketDir,\n102:         SPECKIT_DAEMON_REELECTION: '0',\n103:       },\n104:       encoding: 'utf8',\n105:       timeout: timeoutMs,\n106:       maxBuffer: 1024 * 1024 * 10,\n107:       stdio: ['ignore', 'pipe', 'pipe'],\n108:     });\n109: \n110:     // Failure envelopes route to stderr when stdout is piped; accept either.\n111:     const payload = parseJson(result.stdout) ?? parseJson(result.stderr);\n112:     const exitOk = result.status === testCase.expectExit;\n113:     const envelopeOk = testCase.expectJsonStatus === undefined\n114:       || payload?.status === testCase.expectJsonStatus;\n115:     const daemonFree = !fs.existsSync(path.join(socketDir, 'daemon-ipc.sock'));\n116: \n117:     return {\n118:       name: testCase.name,\n119:       ok: exitOk && envelopeOk && daemonFree,\n120:       exitCode: result.status,\n121:       expectedExit: testCase.expectExit,\n122:       envelopeStatus: payload?.status ?? null,\n123:       daemonFree,\n124:       signal: result.signal,\n125:     };\n126:   } finally {\n127:     fs.rmSync(sandbox, { recursive: true, force: true });\n128:   }\n129: }\n130: \n131: // ─────────────────────────────────────────────────────────────────────────────\n132: // 6. CLI ENTRYPOINT\n133: // ─────────────────────────────────────────────────────────────────────────────\n134: \n135: function main() {\n136:   const options = parseArgs(process.argv.slice(2));\n137:   const results = CASES.map((testCase) => runCase(testCase, options.timeoutMs));\n138:   const ok = results.every((entry) => entry.ok);\n139:   const payload = { status: ok ? 'ok' : 'error', data: { cases: results } };\n140: \n141:   if (options.format === 'json') {\n142:     process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`);\n143:   } else {\n144:     for (const entry of results) {\n145:       process.stdout.write(`${entry.ok ? 'PASS' : 'FAIL'} ${entry.name} (exit ${entry.exitCode}, expected ${entry.expectedExit})\\n`);\n146:     }\n147:     process.stdout.write(`${ok ? 'OK' : 'FAILED'}: ${results.filter((entry) => entry.ok).length}/${results.length} taxonomy cases\\n`);\n148:   }\n149:   process.exit(ok ? 0 : 1);\n150: }\n151: \n152: main();\n\n(End of file - total 152 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: CLI Exit-Taxonomy Smoke                                       ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Daemon-free exit-code and envelope taxonomy smoke for the       ║\n// ║ three CLI shims (warm-only=75, usage/trust refusal=64).                  ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// The sibling cli-offline-smoke.cjs proves list-tools counts; this\n// script proves the FAILURE contract: warm-only refusals exit 75, usage\n// and trust refusals exit 64, and failure envelopes stay parseable JSON\n// (or usage text) rather than stack traces. Every case runs in a sandbox\n// socket dir so no daemon is ever spawned or contacted.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('fs');","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/bin/cli-exit-taxonomy-smoke.cjs","text":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ COMPONENT: CLI Exit-Taxonomy Smoke                                       ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ PURPOSE: Daemon-free exit-code and envelope taxonomy smoke for the       ║\n// ║ three CLI shims (warm-only=75, usage/trust refusal=64).                  ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// The sibling cli-offline-smoke.cjs proves list-tools counts; this\n// script proves the FAILURE contract: warm-only refusals exit 75, usage\n// and trust refusals exit 64, and failure envelopes stay parseable JSON\n// (or usage text) rather than stack traces. Every case runs in a sandbox\n// socket dir so no daemon is ever spawned or contacted.\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('fs');\nconst os = require('os');\nconst path = require('path');\nconst { spawnSync } = require('child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst repoRoot = path.resolve(__dirname, '..', '..');\n\nconst SHIMS = {\n  'spec-memory': path.join(__dirname, 'spec-memory.cjs'),\n  'code-index': path.join(__dirname, 'code-index.cjs'),\n  'skill-advisor': path.join(__dirname, 'skill-advisor.cjs'),\n};\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. TAXONOMY CASES\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst CASES = [\n  // Warm-only reads with no daemon must refuse retryably (75), never spawn.\n  { name: 'spec-memory warm-only read exits 75', shim: 'spec-memory', args: ['memory_stats', '--json', '{}', '--warm-only', '--format', 'json'], expectExit: 75, expectJsonStatus: 'error' },\n  { name: 'code-index warm-only read exits 75', shim: 'code-index', args: ['code_graph_status', '--warm-only', '--format', 'json'], expectExit: 75, expectJsonStatus: 'error' },\n  { name: 'skill-advisor warm-only read exits 75', shim: 'skill-advisor', args: ['advisor_recommend', '--json', '{\"prompt\":\"taxonomy smoke\"}', '--warm-only', '--format', 'json'], expectExit: 75, expectJsonStatus: 'error' },\n  // Unknown commands are usage errors (64).\n  { name: 'spec-memory unknown command exits 64', shim: 'spec-memory', args: ['no_such_tool', '--format', 'json'], expectExit: 64 },\n  { name: 'code-index unknown command exits 64', shim: 'code-index', args: ['no_such_tool', '--format', 'json'], expectExit: 64 },\n  { name: 'skill-advisor unknown command exits 64', shim: 'skill-advisor', args: ['no_such_tool', '--format', 'json'], expectExit: 64 },\n  // Trust refusal: advisor mutations without --trusted fail closed (64)\n  // before any IPC frame, so this stays daemon-free.\n  { name: 'skill-advisor untrusted mutation exits 64', shim: 'skill-advisor', args: ['skill_graph_scan', '--format', 'json'], expectExit: 64 },\n  // Mutation-intent guard: a bare apply is refused as usage (64) before\n  // any daemon contact — default rescan routing must be opted into.\n  { name: 'code-index bare apply guarded exits 64', shim: 'code-index', args: ['code_graph_apply', '--format', 'json'], expectExit: 64 },\n];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. ARGUMENT PARSING\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv) {\n  const options = { format: 'text', timeoutMs: 20_000 };\n  for (let index = 0; index < argv.length; index += 1) {\n    const value = argv[index];\n    if (value === '--format') {\n      options.format = argv[index + 1] === 'json' ? 'json' : 'text';\n      index += 1;\n    } else if (value === '--json') {\n      options.format = 'json';\n    } else if (value === '--timeout-ms') {\n      const parsed = Number.parseInt(argv[index + 1], 10);\n      if (Number.isFinite(parsed) && parsed > 0) options.timeoutMs = parsed;\n      index += 1;\n    }\n  }\n  return options;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. CASE EXECUTION\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseJson(text) {\n  if (!text || !text.trim()) return null;\n  try {\n    return JSON.parse(text);\n  } catch {\n    return null;\n  }\n}\n\nfunction runCase(testCase, timeoutMs) {\n  const sandbox = fs.mkdtempSync(path.join(os.tmpdir(), 'cli-taxonomy-smoke-'));\n  const socketDir = path.join(sandbox, 'sock');\n  try {\n    const result = spawnSync(process.execPath, [SHIMS[testCase.shim], ...testCase.args], {\n      cwd: repoRoot,\n      env: {\n        ...process.env,\n        SPECKIT_IPC_SOCKET_DIR: socketDir,\n        SPECKIT_DAEMON_REELECTION: '0',\n      },\n      encoding: 'utf8',\n      timeout: timeoutMs,\n      maxBuffer: 1024 * 1024 * 10,\n      stdio: ['ignore', 'pipe', 'pipe'],\n    });\n\n    // Failure envelopes route to stderr when stdout is piped; accept either.\n    const payload = parseJson(result.stdout) ?? parseJson(result.stderr);\n    const exitOk = result.status === testCase.expectExit;\n    const envelopeOk = testCase.expectJsonStatus === undefined\n      || payload?.status === testCase.expectJsonStatus;\n    const daemonFree = !fs.existsSync(path.join(socketDir, 'daemon-ipc.sock'));\n\n    return {\n      name: testCase.name,\n      ok: exitOk && envelopeOk && daemonFree,\n      exitCode: result.status,\n      expectedExit: testCase.expectExit,\n      envelopeStatus: payload?.status ?? null,\n      daemonFree,\n      signal: result.signal,\n    };\n  } finally {\n    fs.rmSync(sandbox, { recursive: true, force: true });\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 6. CLI ENTRYPOINT\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction main() {\n  const options = parseArgs(process.argv.slice(2));\n  const results = CASES.map((testCase) => runCase(testCase, options.timeoutMs));\n  const ok = results.every((entry) => entry.ok);\n  const payload = { status: ok ? 'ok' : 'error', data: { cases: results } };\n\n  if (options.format === 'json') {\n    process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`);\n  } else {\n    for (const entry of results) {\n      process.stdout.write(`${entry.ok ? 'PASS' : 'FAIL'} ${entry.name} (exit ${entry.exitCode}, expected ${entry.expectedExit})\\n`);\n    }\n    process.stdout.write(`${ok ? 'OK' : 'FAILED'}: ${results.filter((entry) => entry.ok).length}/${results.length} taxonomy cases\\n`);\n  }\n  process.exit(ok ? 0 : 1);\n}\n\nmain();","lineStart":1,"lineEnd":152,"totalLines":152,"truncated":false}},"title":".opencode/bin/cli-exit-taxonomy-smoke.cjs","time":{"start":1785134448103,"end":1785134448111}},"metadata":{"openai":{"itemId":"fc_0a5fbd4e32e4b441016a66fd6fea7c8191869619431fd9bb43"}},"id":"prt_fa24dfd9c0014UlxXb9WacX5Iz","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa24dc251001jDfIiRPz36Z7lA"}}
