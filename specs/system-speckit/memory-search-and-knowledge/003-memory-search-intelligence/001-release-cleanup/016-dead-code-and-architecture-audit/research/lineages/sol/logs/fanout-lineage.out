legacyBodyPath: '.opencode/commands/deep/assets/legacy/deep-alignment.body.md',\n36:     compiledContractPath: '.opencode/commands/deep/assets/compiled/deep-alignment.contract.md',\n37:   },\n38: };\n39: \n40: function absolutePath(sourcePath) {\n41:   return path.resolve(WORKSPACE_ROOT, sourcePath);\n42: }\n43: \n44: function sha256(input) {\n45:   return crypto.createHash('sha256').update(input).digest('hex');\n46: }\n47: \n48: function readBuffer(sourcePath) {\n49:   return fs.readFileSync(absolutePath(sourcePath));\n50: }\n51: \n52: function getCommandDefinition(command) {\n53:   const canonicalCommand = canonicalizeCommand(command);\n54:   const definition = COMMANDS[canonicalCommand];\n55:   if (!definition) {\n56:     const supported = Object.keys(COMMANDS).join(', ');\n57:     throw new Error(`Unsupported command ${command}. Supported commands: ${supported}`);\n58:   }\n59:   return { command: canonicalCommand, ...definition };\n60: }\n61: \n62: function passthroughArgsText(argv) {\n63:   if (argv.length === 0) return '';\n64:   if (argv.length === 1) return argv[0];\n65:   return argv.join(' ');\n66: }\n67: \n68: function resolveMode(command) {\n69:   return resolveInjectionMode(command);\n70: }\n71: \n72: function assertCompiledContractFresh(definition, check = checkCommand) {\n73:   const drift = check(definition.command);\n74:   if (drift.failures.length > 0) {\n75:     const classes = [...new Set(drift.failures.map((failure) => failure.class))].join(', ');\n76:     throw new Error(\n77:       `Refusing stale compiled contract for ${definition.command}: ${classes}. `\n78:         + 'Re-run compile-command-contracts.cjs --write.',\n79:     );\n80:   }\n81: }\n82: \n83: function renderPayload(definition, mode) {\n84:   const legacyBody = readBuffer(definition.legacyBodyPath);\n85: \n86:   if (mode === 'fallback') return legacyBody;\n87:   if (mode === 'fix') {\n88:     assertCompiledContractFresh(definition);\n89:     const compiledContract = readBuffer(definition.compiledContractPath);\n90:     return Buffer.concat([compiledContract, legacyBody]);\n91:   }\n92:   throw new Error(`Unsupported injection mode ${mode} for ${definition.command}`);\n93: }\n94: \n95: // The command reaches the executor as rendered markdown; the raw invocation message\n96: // (target, :auto suffix, spec_folder, topic, flags) arrives only via this prelude's\n97: // argv and must be echoed back, or the model never sees it and re-asks for setup.\n98: // This mirrors the memory-search command's ARGS_PRESENT/QUERY surface.\n99: function buildInvocationPrefix(argsText) {\n100:   const present = argsText.trim().length > 0;\n101:   const lines = [\n102:     '<!-- INVOCATION MESSAGE (the user input for this run) -->',\n103:     `ARGS_PRESENT=${present}`,\n104:   ];\n105:   if (present) {\n106:     lines.push('MESSAGE:', argsText, '');\n107:     lines.push(\n108:       'Bind setup from the MESSAGE above — the target, the `:auto`/`:confirm` suffix, `--spec-folder`, the research topic, and other flags are there. When ARGS_PRESENT=true you MUST proceed on that MESSAGE now: do NOT ask the setup question, and do NOT treat a populated MESSAGE as empty.',\n109:     );\n110:   } else {\n111:     lines.push('MESSAGE: (none supplied)', '');\n112:     lines.push('ARGS_PRESENT=false: no invocation message was supplied; follow the command body below for setup routing.');\n113:   }\n114:   lines.push('', '<!-- END INVOCATION MESSAGE -->', '');\n115:   return Buffer.from(lines.join('\\n'), 'utf8');\n116: }\n117: \n118: function buildManifestRow(definition, mode, argsText, output) {\n119:   const legacyBody = readBuffer(definition.legacyBodyPath);\n120:   const compiledContract = readBuffer(definition.compiledContractPath);\n121:   return {\n122:     command: definition.command,\n123:     mode,\n124:     argsSha256: sha256(Buffer.from(argsText, 'utf8')),\n125:     legacyBodySha256: sha256(legacyBody),\n126:     compiledContractSha256: sha256(compiledContract),\n127:     renderedSha256: sha256(output),\n128:   };\n129: }\n130: \n131: function appendManifestRow(row, manifestPath = absolutePath(MANIFEST_PATH)) {\n132:   fs.mkdirSync(path.dirname(manifestPath), { recursive: true });\n133:   fs.appendFileSync(manifestPath, `${JSON.stringify(row)}\\n`, 'utf8');\n134: }\n135: \n136: function renderCommandContract(command, options = {}) {\n137:   const definition = getCommandDefinition(command);\n138:   const mode = resolveMode(definition.command);\n139:   const argsText = options.argsText ?? '';\n140:   const body = renderPayload(definition, mode);\n141:   const prefix = buildInvocationPrefix(argsText);\n142:   const output = Buffer.concat([prefix, body]);\n143:   const manifestRow = buildManifestRow(definition, mode, argsText, output);\n144: \n145:   if (options.writeManifest !== false) {\n\n(Showing lines 1-145 of 266. Use offset=146 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\nconst crypto = require('node:crypto');\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst {\n  canonicalizeCommand,\n  resolveInjectionMode,\n} = require('../../shared/rollout/resolve-injection-mode.cjs');\nconst { checkCommand } = require('./check-contract-drift.cjs');\n\nconst WORKSPACE_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\nconst MANIFEST_PATH = '.opencode/commands/deep/assets/compiled/manifest.jsonl';\n\nconst COMMANDS = {\n  'deep/ai-council': {\n    slug: 'deep_ai-council',\n    legacyBodyPath: '.opencode/commands/deep/assets/legacy/deep-ai-council.body.md',","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/render-command-contract.cjs","text":"#!/usr/bin/env node\n'use strict';\n\nconst crypto = require('node:crypto');\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst {\n  canonicalizeCommand,\n  resolveInjectionMode,\n} = require('../../shared/rollout/resolve-injection-mode.cjs');\nconst { checkCommand } = require('./check-contract-drift.cjs');\n\nconst WORKSPACE_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\nconst MANIFEST_PATH = '.opencode/commands/deep/assets/compiled/manifest.jsonl';\n\nconst COMMANDS = {\n  'deep/ai-council': {\n    slug: 'deep_ai-council',\n    legacyBodyPath: '.opencode/commands/deep/assets/legacy/deep-ai-council.body.md',\n    compiledContractPath: '.opencode/commands/deep/assets/compiled/deep-ai-council.contract.md',\n  },\n  'deep/review': {\n    slug: 'deep_review',\n    legacyBodyPath: '.opencode/commands/deep/assets/legacy/deep-review.body.md',\n    compiledContractPath: '.opencode/commands/deep/assets/compiled/deep-review.contract.md',\n  },\n  'deep/research': {\n    slug: 'deep_research',\n    legacyBodyPath: '.opencode/commands/deep/assets/legacy/deep-research.body.md',\n    compiledContractPath: '.opencode/commands/deep/assets/compiled/deep-research.contract.md',\n  },\n  'deep/alignment': {\n    slug: 'deep_alignment',\n    legacyBodyPath: '.opencode/commands/deep/assets/legacy/deep-alignment.body.md',\n    compiledContractPath: '.opencode/commands/deep/assets/compiled/deep-alignment.contract.md',\n  },\n};\n\nfunction absolutePath(sourcePath) {\n  return path.resolve(WORKSPACE_ROOT, sourcePath);\n}\n\nfunction sha256(input) {\n  return crypto.createHash('sha256').update(input).digest('hex');\n}\n\nfunction readBuffer(sourcePath) {\n  return fs.readFileSync(absolutePath(sourcePath));\n}\n\nfunction getCommandDefinition(command) {\n  const canonicalCommand = canonicalizeCommand(command);\n  const definition = COMMANDS[canonicalCommand];\n  if (!definition) {\n    const supported = Object.keys(COMMANDS).join(', ');\n    throw new Error(`Unsupported command ${command}. Supported commands: ${supported}`);\n  }\n  return { command: canonicalCommand, ...definition };\n}\n\nfunction passthroughArgsText(argv) {\n  if (argv.length === 0) return '';\n  if (argv.length === 1) return argv[0];\n  return argv.join(' ');\n}\n\nfunction resolveMode(command) {\n  return resolveInjectionMode(command);\n}\n\nfunction assertCompiledContractFresh(definition, check = checkCommand) {\n  const drift = check(definition.command);\n  if (drift.failures.length > 0) {\n    const classes = [...new Set(drift.failures.map((failure) => failure.class))].join(', ');\n    throw new Error(\n      `Refusing stale compiled contract for ${definition.command}: ${classes}. `\n        + 'Re-run compile-command-contracts.cjs --write.',\n    );\n  }\n}\n\nfunction renderPayload(definition, mode) {\n  const legacyBody = readBuffer(definition.legacyBodyPath);\n\n  if (mode === 'fallback') return legacyBody;\n  if (mode === 'fix') {\n    assertCompiledContractFresh(definition);\n    const compiledContract = readBuffer(definition.compiledContractPath);\n    return Buffer.concat([compiledContract, legacyBody]);\n  }\n  throw new Error(`Unsupported injection mode ${mode} for ${definition.command}`);\n}\n\n// The command reaches the executor as rendered markdown; the raw invocation message\n// (target, :auto suffix, spec_folder, topic, flags) arrives only via this prelude's\n// argv and must be echoed back, or the model never sees it and re-asks for setup.\n// This mirrors the memory-search command's ARGS_PRESENT/QUERY surface.\nfunction buildInvocationPrefix(argsText) {\n  const present = argsText.trim().length > 0;\n  const lines = [\n    '<!-- INVOCATION MESSAGE (the user input for this run) -->',\n    `ARGS_PRESENT=${present}`,\n  ];\n  if (present) {\n    lines.push('MESSAGE:', argsText, '');\n    lines.push(\n      'Bind setup from the MESSAGE above — the target, the `:auto`/`:confirm` suffix, `--spec-folder`, the research topic, and other flags are there. When ARGS_PRESENT=true you MUST proceed on that MESSAGE now: do NOT ask the setup question, and do NOT treat a populated MESSAGE as empty.',\n    );\n  } else {\n    lines.push('MESSAGE: (none supplied)', '');\n    lines.push('ARGS_PRESENT=false: no invocation message was supplied; follow the command body below for setup routing.');\n  }\n  lines.push('', '<!-- END INVOCATION MESSAGE -->', '');\n  return Buffer.from(lines.join('\\n'), 'utf8');\n}\n\nfunction buildManifestRow(definition, mode, argsText, output) {\n  const legacyBody = readBuffer(definition.legacyBodyPath);\n  const compiledContract = readBuffer(definition.compiledContractPath);\n  return {\n    command: definition.command,\n    mode,\n    argsSha256: sha256(Buffer.from(argsText, 'utf8')),\n    legacyBodySha256: sha256(legacyBody),\n    compiledContractSha256: sha256(compiledContract),\n    renderedSha256: sha256(output),\n  };\n}\n\nfunction appendManifestRow(row, manifestPath = absolutePath(MANIFEST_PATH)) {\n  fs.mkdirSync(path.dirname(manifestPath), { recursive: true });\n  fs.appendFileSync(manifestPath, `${JSON.stringify(row)}\\n`, 'utf8');\n}\n\nfunction renderCommandContract(command, options = {}) {\n  const definition = getCommandDefinition(command);\n  const mode = resolveMode(definition.command);\n  const argsText = options.argsText ?? '';\n  const body = renderPayload(definition, mode);\n  const prefix = buildInvocationPrefix(argsText);\n  const output = Buffer.concat([prefix, body]);\n  const manifestRow = buildManifestRow(definition, mode, argsText, output);\n\n  if (options.writeManifest !== false) {","lineStart":1,"lineEnd":145,"totalLines":266,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/render-command-contract.cjs","time":{"start":1785134639913,"end":1785134639918}},"metadata":{"openai":{"itemId":"fc_08b5431fb491411e016a66fe2fbb4c8191a2edf5a65904c98f"}},"id":"prt_fa250eaef001WmvXYMCx1LGKCu","sessionID":"ses_05dbebdb4ffe8dApbcbo3OIc7y","messageID":"msg_fa2507600001X1rhQDYPE1nFn0"}}
