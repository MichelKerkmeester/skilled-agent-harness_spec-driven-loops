 target folder, level, rule, and its plan. */\n82-export interface SpecDocRuleOptions {\n83-  folder: string;\n84-  level: string;\n85-  rule: SpecDocRuleName;\n86-  mergePlan?: MergePlan | null;\n87-  contaminationPlan?: ContaminationPlan | null;\n88-  postSavePlan?: PostSavePlan | null;\n89-}\n90-\n91-interface DocumentRecord {\n92-  basename: string;\n93-  path: string;\n94-  content: string;\n95-}\n96-\n97-interface AnchorOccurrence {\n98-  id: string;\n99-  startLine: number;\n100-  endLine: number;\n101-  body: string;\n102-}\n103-\n--\n125:  'FRONTMATTER_MEMORY_BLOCK',\n126-  'MERGE_LEGALITY',\n127-  'SPEC_DOC_SUFFICIENCY',\n128-  'CROSS_ANCHOR_CONTAMINATION',\n129-  'POST_SAVE_FINGERPRINT',\n130-] as const;\n131-\n132-/** The full set of diagnostic codes each structural rule can emit, keyed by rule name. */\n133-export const RULE_FAILURE_CODES: Readonly<Record<SpecDocRuleName, readonly string[]>> = {\n134:  FRONTMATTER_MEMORY_BLOCK: [\n135-    'SPECDOC_FRONTMATTER_001',\n136-    'SPECDOC_FRONTMATTER_002',\n137-    'SPECDOC_FRONTMATTER_003',\n138-    'SPECDOC_FRONTMATTER_004',\n139-    'SPECDOC_FRONTMATTER_005',\n140-    'SPECDOC_FRONTMATTER_006',\n141-    'SPECDOC_FRONTMATTER_007',\n142-    'MEMORY_BLOCK_INVALID',\n143-    'SESSION_LINEAGE_BROKEN',\n144-  ],\n145-  MERGE_LEGALITY: [\n146-    'SPECDOC_MERGE_001',\n147-    'SPECDOC_MERGE_002',\n148-    'SPECDOC_MERGE_003',\n149-    'SPECDOC_MERGE_004',\n150-    'SPECDOC_MERGE_005',\n151-  ],\n152-  SPEC_DOC_SUFFICIENCY: [\n153-    'SPECDOC_SUFFICIENCY_001',\n154-    'SPECDOC_SUFFICIENCY_002',\n155-    'SPECDOC_SUFFICIENCY_003',\n156-    'SPECDOC_SUFFICIENCY_004',\n157-    'SPECDOC_SUFFICIENCY_005',\n158-    'SPECDOC_SUFFICIENCY_006',\n159-  ],\n160-  CROSS_ANCHOR_CONTAMINATION: [\n161-    'SPECDOC_CONTAM_001',\n162-    'SPECDOC_CONTAM_002',\n163-    'SPECDOC_CONTAM_003',\n164-  ],\n165-  POST_SAVE_FINGERPRINT: [\n166-    'SPECDOC_FINGERPRINT_001',\n167-    'SPECDOC_FINGERPRINT_002',\n168-    'SPECDOC_FINGERPRI