{"toolCallId":"call_617aa331b1c54c15abe3471881194ca4","status":"completed","content":[{"type":"content","content":{"type":"text","text":"132-/** The full set of diagnostic codes each structural rule can emit, keyed by rule name. */\n133-export const RULE_FAILURE_CODES: Readonly<Record<SpecDocRuleName, readonly string[]>> = {\n134-  FRONTMATTER_MEMORY_BLOCK: [\n135:    'SPECDOC_FRONTMATTER_001',\n136:    'SPECDOC_FRONTMATTER_002',\n137:    'SPECDOC_FRONTMATTER_003',\n138:    'SPECDOC_FRONTMATTER_004',\n139:    'SPECDOC_FRONTMATTER_005',\n140:    'SPECDOC_FRONTMATTER_006',\n141:    'SPECDOC_FRONTMATTER_007',\n142-    'MEMORY_BLOCK_INVALID',\n143:    'SESSION_LINEAGE_BROKEN',\n144-  ],\n145-  MERGE_LEGALITY: [\n146-    'SPECDOC_MERGE_001',\n147-    'SPECDOC_MERGE_002',\n148-    'SPECDOC_MERGE_003',\n149-    'SPECDOC_MERGE_004',\n150-    'SPECDOC_MERGE_005',\n151-  ],\n152-  SPEC_DOC_SUFFICIENCY: [\n153-    'SPECDOC_SUFFICIENCY_001',\n154-    'SPECDOC_SUFFICIENCY_002',\n155-    'SPECDOC_SUFFICIENCY_003',\n--\n715-\n716-    if (parsed.error) {\n717-      diagnostics.push({\n718:        code: 'SPECDOC_FRONTMATTER_001',\n719-        severity: 'error',\n720-        detail: `${document.basename}: malformed YAML frontmatter (${parsed.error})`,\n721-      });\n722-      continue;\n723-    }\n724-\n725-    if (!parsed.rawBlock) {\n726-      continue;\n727-    }\n728-\n729-    if (!parsed.memoryBlock) {\n730-      if (continuityRequired) {\n731-        diagnostics.push({\n732:          code: 'SPECDOC_FRONTMATTER_002',\n733-          severity: 'warning',\n734-          detail: `${document.basename}: missing _memory block`,\n735-        });\n736-      }\n737-      continue;\n738-    }\n739-\n740-    if (parsed.memoryError) {\n741-      diagnostics.push({\n742-        code: 'MEMORY_BLOCK_INVALID',\n743-        severity: 'error',\n744-        detail: `${document.basename}: invalid _memory YAML (${parsed.memoryError})`,\n--\n748-\n749-    if (parsed.fingerprint && !/^sha256:[a-f0-9]{64}$/.test(parsed.fingerprint)) {\n750-      diagnostics.push({\n751:        code: 'SPECDOC_FRONTMATTER_005',\n752-        severity: 'error',\n753-        detail: `${document.basename}: fingerprint '${parsed.fingerprint}' is not sha256:<64-hex>`,\n754-      });\n755-    }\n756-\n757-    if (!parsed.continuityBlock) {\n758-      if (continuityRequired) {\n759-        diagnostics.push({\n760:          code: 'SPECDOC_FRONTMATTER_006',\n761-          severity: 'warning',\n762-          detail: `${document.basename}: _memory.continuity is missing`,\n763-        });\n764-      }\n765-      continue;\n766-    }\n767-\n768-    const sessionId = extractSessionDedupField(parsed.continuityBlock, 'session_id');\n769-    const parentSessionId = extractSessionDedupField(parsed.continuityBlock, 'parent_session_id');\n770-    if (sessionId) {\n771-      knownSessionIds.add(sessionId);\n772-    }\n--\n792-    if (missingFields.length > 0) {\n793-      if (isFrontmatterGrandfathered(document.path)) {\n794-        diagnostics.push({\n795:          code: 'SPECDOC_FRONTMATTER_003',\n796-          severity: 'warning',\n797-          detail: `${document.basename}: missing continuity fields ${missingFields.map(([field]) => field).join(', ')} grandfathered until cutoff`,\n798-        });\n799-      } else {\n800-        diagnostics.push({\n801:          code: 'SPECDOC_FRONTMATTER_003',\n802-          severity: 'error',\n803-          detail: `${document.basename}: missing continuity fields ${missingFields.map(([field]) => field).join(', ')}`,\n804-        });\n805-      }\n806-    }\n807-\n808-    // Single-segment pointers are legal: a repository may keep packets directly\n809-    // under the spec root, and the disk-path consistency rule already proves the\n810-    // pointer against the real folder leaf, so a two-segment minimum adds nothing.\n811-    if (packetPointer && (!/^[a-z0-9._-]+(?:\\/[a-z0-9._-]+)*\\/?$/.test(packetPointer) || packetPointer.includes('..') || packetPointer.includes('\\\\'))) {\n812-      diagnostics.push({\n813:        code: 'SPECDOC_FRONTMATTER_004',\n814-        severity: 'error',\n815-        detail: `${document.basename}: packet_pointer '${packetPointer}' is not a safe relative packet path`,\n816-      });\n817-    }\n818-\n819-    if (lastUpdatedAt && Number.isNaN(Date.parse(lastUpdatedAt))) {\n820-      diagnostics.push({\n821:        code: 'SPECDOC_FRONTMATTER_004',\n822-        severity: 'error',\n823-        detail: `${document.basename}: last_updated_at '${lastUpdatedAt}' is not ISO-8601 parseable`,\n824-      });\n825-    }\n826-\n827-    if (lastUpdatedBy && !/^[a-z0-9][a-z0-9._-]{1,63}$/.test(lastUpdatedBy)) {\n828-      diagnostics.push({\n829:        code: 'SPECDOC_FRONTMATTER_004',\n830-        severity: 'error',\n831-        detail: `${document.basename}: last_updated_by '${lastUpdatedBy}' is not an actor slug`,\n832-      });\n833-    }\n834-\n835-    for (const [fieldName, fieldValue] of [['recent_action', recentAction], ['next_safe_action', nextSafeAction]] as const) {\n836-      if (!fieldValue) {\n837-        continue;\n838-      }\n839-      const looksNarrative = /\\n|(^|\\s)(?:because|so that|which means|the reason|details|summary)\\b/i.test(fieldValue)\n840-        || (fieldValue.match(/[.!?](?=\\s+[A-Z]|\\s*$)/g) ?? []).length >= 2\n841-        || /^[#>*-]/.test(fieldValue)\n--\n848-        // happens to contain \"because\" is not a defect. Failing a packet on\n849-        // style costs a red gate and buys nothing no reader would have caught.\n850-        diagnostics.push({\n851:          code: 'SPECDOC_FRONTMATTER_004',\n852-          severity: 'warning',\n853-          detail: `${document.basename}: ${fieldName} reads long or narrative; keep it compact`,\n854-        });\n855-      }\n856-    }\n857-\n858-    const blockers = extractContinuityList(parsed.continuityBlock, 'blockers');\n859-    const keyFiles = extractContinuityList(parsed.continuityBlock, 'key_files');\n860-\n861-    if (blockers.length > 5) {\n862-      // A cap on how many things a person may be blocked on. Nothing reads the\n863-      // list by index and a sixth blocker is information, not corruption.\n864-      diagnostics.push({\n865:        code: 'SPECDOC_FRONTMATTER_004',\n866-        severity: 'warning',\n867-        detail: `${document.basename}: blockers contains ${blockers.length} items; keep it to 5 or fewer`,\n868-      });\n869-    }\n870-\n871-    if (keyFiles.some((value) => value.startsWith('/') || value.includes('..') || value.includes('\\\\'))) {\n872-      diagnostics.push({\n873:        code: 'SPECDOC_FRONTMATTER_004',\n874-        severity: 'error',\n875-        detail: `${document.basename}: key_files must stay repo-relative`,\n876-      });\n877-    }\n878-\n879-    if (Buffer.byteLength(parsed.continuityBlock, 'utf8') > 2048) {\n880-      diagnostics.push({\n881:        code: 'SPECDOC_FRONTMATTER_007',\n882-        severity: 'warning',\n883-        detail: `${document.basename}: _memory.continuity is ${Buffer.byteLength(parsed.continuityBlock, 'utf8')} bytes (> 2048)`,\n884-      });\n885-    }\n886-  }\n887-\n888-  for (const { basename, parentSessionId } of parentSessionRefs) {\n889-    if (!knownSessionIds.has(parentSessionId)) {\n890-      diagnostics.push({\n891:        code: 'SESSION_LINEAGE_BROKEN',\n892-        severity: 'warning',\n893-        detail: `${basename}: parent_session_id '${parentSessionId}' does not match a session_id in this packet`,\n894-      });\n895-    }\n896-  }\n897-\n898-  return createResult(\n899-    'FRONTMATTER_MEMORY_BLOCK',\n900-    diagnostics,\n901-    'All spec-doc frontmatter memory blocks are structurally valid',\n902-  );\n903-}\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"0f1e53","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_634a995082944e04ae011159571a23e5","status":"completed","content":[{"type":"content","content":{"type":"text","text":".skilled/changelog/skilled/v4.0.0.0.md:82:- `spec/validate.sh`, `spec/create.sh`, `spec/repair-derived.cjs` and `spec/recommend-level.sh` for the packet lifecycle\n.skilled/skills/sk-code/sk-code-skilled/references/shared/code-organization/directory-and-test-conventions.md:203:│   ├── recommend-level.sh\n.skilled/commands/speckit/assets/speckit-plan.yaml:86:        command: \"bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --json --recommend-phases --phase-threshold {phase_threshold} --loc {estimated_loc} --files {estimated_files}\"\n.skilled/commands/speckit/assets/speckit-plan.yaml:272:    note: \"recommend-level.sh scores LOC, file count and risk and decides the level; when its answer and judgment differ, go higher. decision-record.md and the other add-ons are lazy at every level, scaffolded on request\"\n.skilled/commands/speckit/assets/speckit-implement.yaml:247:    note: \"recommend-level.sh scores LOC, file count and risk and decides the level; when its answer and judgment differ, go higher. decision-record.md and the other add-ons are lazy at every level, scaffolded on request\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:147:        command: \"bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --json --recommend-phases --phase-threshold {phase_threshold} --loc {estimated_loc} --files {estimated_files}\"\n.skilled/commands/speckit/assets/speckit-complete.yaml:309:    note: \"recommend-level.sh scores LOC, file count and risk and decides the level; when its answer and judgment differ, go higher. decision-record.md and the other add-ons are lazy at every level, scaffolded on request\"\n.skilled/skills/system-spec-kit/assets/template-mapping.md:297:Run `runtime/cli/spec/recommend-level.sh`, which scores LOC, file count and risk; go higher when it disagrees with your judgment\n.skilled/skills/system-spec-kit/assets/level-decision-matrix.md:302:**LOC as one input to `recommend-level.sh`, which scores LOC, file count and risk together:**\n.skilled/skills/system-spec-kit/SKILL.md:114:- `spec/recommend-level.sh`\n.skilled/skills/system-spec-kit/README.md:513:bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh specs/[project]/NNN-feature/\n.skilled/skills/system-spec-kit/README.md:620:| `recommend-level.sh` | analyze scope and risk to recommend the right level |\n.skilled/skills/system-spec-kit/references/structure/phase-definitions.md:60:- **Level threshold:** documentation level >= 3 (from `recommend-level.sh` 100-point level scoring)\n.skilled/skills/system-spec-kit/references/structure/phase-definitions.md:62:> **Scoring systems clarification:** The 50-point phase complexity score (this section) is separate from the 100-point level recommendation score used by `recommend-level.sh`. The level score determines documentation depth (L1/L2/L3/L3+); the phase score determines whether to decompose into child folders. Both thresholds must be met independently.\n.skilled/skills/system-spec-kit/references/structure/phase-system.md:32:2. **Documentation level >= 3** (from `recommend-level.sh` 100-point level scoring)\n.skilled/skills/system-spec-kit/references/structure/phase-system.md:89:| `recommend-level.sh --recommend-phases` | Phase recommendation scoring alongside level       |\n.skilled/skills/system-spec-kit/references/templates/level-selection-guide.md:38:`runtime/cli/spec/recommend-level.sh` scores tasks across 4 weighted factors (0-100 scale):\n.skilled/skills/system-spec-kit/references/templates/template-guide.md:104:- <100 LOC, as one input to `recommend-level.sh`\n.skilled/skills/system-spec-kit/references/templates/template-guide.md:151:- 100-499 LOC, as one input to `recommend-level.sh`\n.skilled/skills/system-spec-kit/references/templates/template-guide.md:205:- >=500 LOC, as one input to `recommend-level.sh`\n.skilled/skills/system-spec-kit/references/workflows/execution-methods.md:155:### recommend-level.sh\n.skilled/skills/system-spec-kit/references/workflows/execution-methods.md:162:bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh \"Add user authentication\"\n.skilled/skills/system-spec-kit/references/workflows/execution-methods.md:165:bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --auth --api \"Add OAuth login\"\n.skilled/skills/system-spec-kit/references/workflows/intake-contract.md:64:- `level_recommendation` — output of `recommend-level.sh`\n.skilled/skills/system-spec-kit/references/workflows/intake-contract.md:139:- **Q2. Documentation Level** — recommendation from `recommend-level.sh`; keep or override to Level 1 / 2 / 3 / 3+\n.skilled/skills/system-spec-kit/references/workflows/intake-contract.md:285:| Recommend-level helper | `.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh` |\n.skilled/skills/system-spec-kit/references/workflows/quick-reference.md:56:**LOC as one input to `runtime/cli/spec/recommend-level.sh`, which scores it with file count and risk:**\n.skilled/skills/system-spec-kit/references/workflows/quick-reference.md:576:- **LOC is one scored input** - run `recommend-level.sh` and go higher when your judgment disagrees\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-command-workflow.md:44:2. Verify Step 1: Phase scoring runs (recommend-level.sh --recommend-phases)\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-command-workflow.md:61:$ bash \".skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh\" --json --recommend-phases --phase-threshold 0.6 --loc 500 --files 8\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-command-workflow.md:66:$ bash \".skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh\" --json --recommend-phases --phase-threshold 300 --loc 500 --files 8\n.skilled/skills/system-spec-kit/changelog/v2.0.0.0.md:79:- `spec/validate.sh`, `spec/create.sh`, `spec/repair-derived.cjs` and `spec/recommend-level.sh` for the packet lifecycle\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:22:- Real user request: `Please validate Spec Lifecycle Automation against bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --help and tell me whether the expected signals are present: help output available for lifecycle entrypoints; upgrade regression suite passes; completeness JSON is emitted; completion gate returns a stable status.`\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:23:- Prompt: `Validate Spec Lifecycle Automation against bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --help and report cited pass/fail evidence.`\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:36:Validate Spec Lifecycle Automation against bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --help and report cited pass/fail evidence.\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:41:1. `bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --help`\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:53:Command 1: `bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --help`\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:61:  recommend-level.sh [OPTIONS]\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:78:  recommend-level.sh --loc 50 --files 2\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:81:  recommend-level.sh --loc 200 --files 5 --api\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:84:  recommend-level.sh --loc 500 --files 15 --auth --api --db --architectural\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:87:  recommend-level.sh --loc 1000 --files 20 --architectural --api --db --recommend-phases\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:90:  recommend-level.sh --loc 1000 --files 20 --architectural --no-recommend-phases\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:93:  recommend-level.sh --loc 100 --files 3 --json\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:232:Inspect `runtime/cli/spec/recommend-level.sh`, `runtime/cli/tests/test-upgrade-level.sh`, `runtime/cli/spec/calculate-completeness.sh`, and `runtime/cli/spec/archive.sh` if a lifecycle stage is missing or inconsistent\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/spec-lifecycle-automation.md:240:Provenance: manual only - bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --help\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:3:description: \"This scenario validates Phase detection scoring for `PHASE-001`. It focuses on Run `recommend-level.sh --recommend-phases --json` on a high-complexity spec and verify scoring output.\"\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:16:This scenario validates Phase detection scoring for `PHASE-001`. It focuses on Run `recommend-level.sh --recommend-phases --json` on a high-complexity spec and verify scoring output.\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:23:- Objective: Run `recommend-level.sh --recommend-phases --json` on a high-complexity spec and verify scoring output.\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:24:- Real user request: `` Please validate Phase detection scoring against bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --recommend-phases --json specs/<target-spec> and tell me whether the expected signals are present: JSON output contains `recommended_phases` (boolean), `phase_score` (number), `suggested_phase_count` (number), and 4 dimension scores: LOC Factor (35%), File Count (20%), Risk Factors (25%), Complexity (20%); simple specs score low. ``\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:25:- Prompt: `Validate Phase detection scoring against bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --recommend-phases --json specs/<target-spec> and report cited pass/fail evidence.`\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:38:Validate Phase detection scoring against bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --recommend-phases --json specs/<target-spec> and report cited pass/fail evidence.\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:44:2. `bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --recommend-phases --json specs/<target-spec>`\n.skilled/skills/system-spec-kit/manual-testing-playbook/tooling-and-scripts/phase-detection-scoring.md:72:Provenance: manual only - bash .skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh --recommend-phases --json specs/<target-spec>\n.skilled/skills/system-spec-kit/feature-catalog/feature-catalog.md:594:`create.sh`, `recommend-level.sh`, `check-completion.sh` and `archive.sh` are the entry points.\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/phase-system-knowledge-node.md:31:That summary is backed by a deeper reference and executable tooling. `references/structure/phase-definitions.md` expands the taxonomy, folder conventions, phase map/back-reference requirements, and recursive validation expectations. `/speckit:plan :with-phases` (or `/speckit:complete :with-phases`) is the user-facing entry point that drives phase decomposition workflows via optional pre-workflow steps in the plan and complete YAML assets. `create.sh` implements the actual parent-plus-child folder creation path via `--phase`, `--phases`, `--phase-names`, and `--parent`. `recommend-level.sh` calculates both documentation level and the separate default-on phase recommendation fields, while `validate.sh --recursive` checks whether a phased packet is structurally coherent.\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/phase-system-knowledge-node.md:48:| `.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh` | Script | Computes documentation-level scoring plus the separate phase recommendation and suggested phase count |\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/spec-lifecycle-automation.md:6:  - recommend-level.sh\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/spec-lifecycle-automation.md:19:The lifecycle is intentionally split into focused commands. `recommend-level.sh` scores a task and recommends the documentation level and optional phasing strategy. `create.sh` materializes the parent spec, optional child phases, or versioned subfolders. `upgrade-level.sh` raises an existing spec folder to a richer documentation level without discarding authored content. `calculate-completeness.sh` measures placeholder burn-down and optional content quality, `check-completion.sh` enforces checklist completion and evidence rules, and `archive.sh` archives or restores completed work with a completeness gate.\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/spec-lifecycle-automation.md:29:Level recommendation is handled by `recommend-level.sh` as a standalone scoring tool. It accepts estimated LOC, file count, and risk flags for auth, API, database, and architectural work, converts those inputs into a 100-point score, maps the result to Level 0 through Level 3, and separately computes whether phased execution is recommended. Phase scoring uses its own 50-point signal model and only recommends phases when the phase score crosses the threshold and the recommended documentation level is Level 3 or higher.\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/spec-lifecycle-automation.md:31:Spec creation is handled by `create.sh`, which defaults to Level 1 unless `--level` is provided. The script creates `scratch/`, copies the level template set, optionally creates a git branch and writes `description.json` when the Node helper is available. For root and phase scaffolds it then derives `graph-metadata.json` through the graph backfill, which warns and continues when the derivation fails. It also replaces the template placeholder trigger phrases of 18 document kinds with phrases built from the packet slug, and it runs full post-create validation only when `SPECKIT_POST_VALIDATE=1` is set. Beyond normal folder creation, it supports versioned subfolders with `--subfolder`, phased parent-plus-child creation with `--phase`, append-mode phase growth with `--parent`, named child phases with `--phase-names`, and Level 3 sharded spec sections with `--sharded`. The current implementation exposes complexity fields in its output, but the script itself still depends on explicit `--level` input rather than invoking `recommend-level.sh` automatically.\n.skilled/skills/system-spec-kit/feature-catalog/tooling-and-scripts/spec-lifecycle-automation.md:56:| `.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh` | Script | Scores requested work to recommend documentation level and optional phase decomposition |\n.skilled/skills/system-spec-kit/runtime/cli/retrieval/fixtures/phrase-variants.json:80077:      \"recommend-level.sh\"\n.skilled/skills/system-spec-kit/runtime/cli/spec/README.md:67:+-- recommend-level.sh           # Recommend documentation level from task signals\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:169:  recommend-level.sh [OPTIONS]\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:186:  recommend-level.sh --loc 50 --files 2\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:189:  recommend-level.sh --loc 200 --files 5 --api\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:192:  recommend-level.sh --loc 500 --files 15 --auth --api --db --architectural\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:195:  recommend-level.sh --loc 1000 --files 20 --architectural --api --db --recommend-phases\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:198:  recommend-level.sh --loc 1000 --files 20 --architectural --no-recommend-phases\n.skilled/skills/system-spec-kit/runtime/cli/spec/recommend-level.sh:201:  recommend-level.sh --loc 100 --files 3 --json\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-system.js:23:const RECOMMEND_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'recommend-level.sh');\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-system.js:133:      `recommend-level ${fixture.name}: recommended_phases`\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-system.js:138:      `recommend-level ${fixture.name}: phase_score`\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-system.js:143:      `recommend-level ${fixture.name}: suggested_phase_count`\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-validation.js:23:const RECOMMEND_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'recommend-level.sh');\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-validation.js:205:    const result = parseJson(raw, `recommend-level fixture parse failed (${fixtureName})`);\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-validation.js:223:  const result = parseJson(raw, 'recommend-level default phase output parse failed');\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-validation.js:227:    'recommend-level default-on: recommended_phases field present without --recommend-phases'\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-validation.js:231:    'recommend-level default-on: phase_score field present without --recommend-phases'\n.skilled/skills/system-spec-kit/runtime/cli/tests/test-phase-validation.js:235:    'recommend-level default-on: suggested_phase_count field present without --recommend-phases'\n"}}],"_meta":{"cognition.ai/cwd":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/222-deepseek-baseline","terminal_exit":{"terminal_id":"d6aaf0","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
