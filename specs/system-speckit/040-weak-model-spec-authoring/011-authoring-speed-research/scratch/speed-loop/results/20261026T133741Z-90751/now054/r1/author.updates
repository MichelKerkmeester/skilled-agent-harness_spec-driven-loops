",\n      \"dynamic\": false\n    }\n  ],\n  \"optionalHeaderRules\": [\n    {\n      \"raw\": \"L3+: Architecture Verification\",\n      \"normalized\": \"L3+: ARCHITECTURE VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Performance Verification\",\n      \"normalized\": \"L3+: PERFORMANCE VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Deployment Readiness\",\n      \"normalized\": \"L3+: DEPLOYMENT READINESS\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Compliance Verification\",\n      \"normalized\": \"L3+: COMPLIANCE VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Documentation Verification\",\n      \"normalized\": \"L3+: DOCUMENTATION VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Sign-Off\",\n      \"normalized\": \"L3+: SIGN-OFF\",\n      \"dynamic\": false\n    }\n  ],\n  \"requiredAnchors\": [\n    \"notation\",\n    \"phase-1\",\n    \"phase-2\",\n    \"phase-3\",\n    \"completion\",\n    \"cross-refs\",\n    \"protocol\",\n    \"pre-impl\",\n    \"code-quality\",\n    \"testing\",\n    \"fix-completeness\",\n    \"security\",\n    \"docs\",\n    \"file-org\",\n    \"summary\"\n  ],\n  \"optionalAnchors\": [\n    \"arch-verify\",\n    \"perf-verify\",\n    \"deploy-ready\",\n    \"compliance-verify\",\n    \"docs-verify\",\n    \"sign-off\"\n  ],\n  \"allowedAnchors\": [\n    \"notation\",\n    \"phase-1\",\n    \"phase-2\",\n    \"phase-3\",\n    \"completion\",\n    \"cross-refs\",\n    \"protocol\",\n    \"pre-impl\",\n    \"code-quality\",\n    \"testing\",\n    \"fix-completeness\",\n    \"security\",\n    \"docs\",\n    \"file-org\",\n    \"summary\",\n    \"arch-verify\",\n    \"perf-verify\",\n    \"deploy-ready\",\n    \"compliance-verify\",\n    \"docs-verify\",\n    \"sign-off\"\n  ]\n}\n=== acceptance-criteria.md ===\n{\n  \"supported\": true,\n  \"basename\": \"acceptance-criteria.md\",\n  \"templatePath\": \"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree/.skilled/skills/system-spec-kit/templates/addons/acceptance-criteria.md.tmpl\",\n  \"headerRules\": [\n    {\n      \"raw\": \"1. METADATA\",\n      \"normalized\": \"METADATA\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"2. CRITERIA\",\n      \"normalized\": \"CRITERIA\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"3. CLOSURE STATEMENT\",\n      \"normalized\": \"CLOSURE STATEMENT\",\n      \"dynamic\": false\n    }\n  ],\n  \"optionalHeaderRules\": [],\n  \"requiredAnchors\": [\n    \"metadata\",\n    \"criteria\",\n    \"closure\"\n  ],\n  \"optionalAnchors\": [],\n  \"allowedAnchors\": [\n    \"metadata\",\n    \"criteria\",\n    \"closure\"\n  ]\n}\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"9cce2f","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_c2b5e07a6d9e4ba7bc19839f628f34b4","status":"completed","content":[{"type":"content","content":{"type":"text","text":"check-ac-closure.sh\ncheck-ac-coverage.sh\ncheck-ai-protocols.sh\ncheck-canonical-save-description-graph-freshness.cjs\ncheck-canonical-save-description-graph-freshness.sh\ncheck-canonical-save-lineage.cjs\ncheck-canonical-save-lineage.sh\ncheck-canonical-save-packet-identity.cjs\ncheck-canonical-save-packet-identity.sh\ncheck-canonical-save-root-spec.cjs\ncheck-canonical-save-root-spec.sh\ncheck-canonical-save-shared.cjs\ncheck-canonical-save-source-docs.cjs\ncheck-canonical-save-source-docs.sh\ncheck-comment-hygiene.sh\ncheck-complexity.sh\ncheck-description-shape.sh\ncheck-files.sh\ncheck-folder-naming.sh\ncheck-frontmatter-values-helper.cjs\ncheck-frontmatter-values.sh\ncheck-frontmatter.sh\ncheck-graph-metadata-child-drift.sh\ncheck-graph-metadata-child-identity.sh\ncheck-graph-metadata-shape.sh\ncheck-graph-metadata.sh\ncheck-grep-convention-helper.mjs\ncheck-grep-convention.sh\ncheck-level-match.sh\ncheck-level.sh\ncheck-links.sh\ncheck-metadata-disk-consistency-helper.cjs\ncheck-metadata-disk-consistency.sh\ncheck-normalizer-lint.sh\ncheck-placeholders.sh\ncheck-scaffold-never-touched.sh\ncheck-source-tags-helper.mjs\ncheck-source-tags.sh\ncheck-spec-doc-integrity.sh\ncheck-status-cross-doc-consistency.sh\ncheck-template-source.sh\ncheck-toc-policy.sh\nREADME.md\n---\n#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: CHECK-AC-CLOSURE\n# ───────────────────────────────────────────────────────────────\n\n# Sourced by validate.sh and compatible with strict mode.\nset -euo pipefail\n\n# Rule: AC_CLOSURE\n# Severity: error\n# Description: Gates packet closure on acceptance-criteria.md at Levels 2, 3 and 3+.\n#   A packet may close when every criterion is Met, Waived or Superseded.\n#   Waived and Superseded rows must name a decision record that exists.\n#   Packets created before the rollout cutoff stay advisory on every branch.\n\n# ───────────────────────────────────────────────────────────────\n# 1. INITIALIZATION\n# ───────────────────────────────────────────────────────────────\n\n_acc_lower() {\n    printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]'\n}\n\n_acc_numeric_level() {\n    printf '%s' \"$1\" | tr -cd '0-9'\n}\n\n# An unrecognised flag value enables the gate rather than disabling it: a\n# typo in an opt-out must not silently switch a closure gate off.\n_ACC_FLAG_NOTE=\"\"\n_acc_enabled() {\n    local raw=\"${SPECKIT_AC_CLOSURE:-true}\"\n    case \"$(_acc_lower \"$raw\")\" in\n        true|1|yes|on) return 0 ;;\n        false|0|no|off) return 1 ;;\n        *)\n            _ACC_FLAG_NOTE=\"SPECKIT_AC_CLOSURE='$raw' is not a boolean; the gate stayed enabled\"\n            return 0\n            ;;\n    esac\n}\n\n# Rollout boundary, overridable by operators. A malformed override falls back to\n# the default instead of being compared as a string, which would grandfather\n# every packet in the repository.\n_ACC_CUTOFF_DEFAULT=\"2026-08-30\"\n_ACC_CUTOFF_NOTE=\"\"\n_acc_cutoff_date() {\n    local raw=\"${SPECKIT_AC_CLOSURE_CUTOFF:-$_ACC_CUTOFF_DEFAULT}\"\n    local candidate=\"${raw:0:10}\"\n    if [[ \"$candidate\" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then\n        printf '%s' \"$candidate\"\n        return 0\n    fi\n    _ACC_CUTOFF_NOTE=\"SPECKIT_AC_CLOSURE_CUTOFF='$raw' is not an ISO date; using $_ACC_CUTOFF_DEFAULT\"\n    printf '%s' \"$_ACC_CUTOFF_DEFAULT\"\n}\n\n# Packet creation date from the spec.md metadata table. Matching is lowered\n# explicitly because the awk on this platform does not honour IGNORECASE.\n_acc_created_date() {\n    local spec_file=\"$1\"\n    [[ -f \"$spec_file\" ]] || return 1\n    local value\n    value=\"$(awk '\n        { line = tolower($0) }\n        line ~ /\\|[[:space:]]*\\*{0,2}created\\*{0,2}[[:space:]]*\\|/ {\n            if (match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2}/)) {\n                print substr($0, RSTART, RLENGTH)\n                exit\n            }\n        }\n    ' \"$spec_file\")\"\n    [[ -n \"$value\" ]] || return 1\n    printf '%s' \"$value\"\n}\n\n# Reads the Status CELL, never the whole row: a line-wide substring match reads\n# \"Not Complete\" and \"Blocked - nothing done yet\" as completion claims.\n_acc_completion_claimed() {\n    local folder=\"$1\"\n    local file status\n    for file in \"$folder/spec.md\" \"$folder/implementation-summary.md\"; do\n        [[ -f \"$file\" ]] || continue\n        status=\"$(awk -F'|' '\n            function norm(v) {\n                gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", v)\n                gsub(/\\*\\*|`|\\.$/, \"\", v)\n                gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", v)\n                return tolower(v)\n            }\n            /^[[:space:]]*\\|/ {\n                if (norm($2) == \"status\") { print norm($3); exit }\n            }\n        ' \"$file\")\"\n        case \"$status\" in\n            complete|completed|done|shipped|delivered|closed) return 0 ;;\n        esac\n    done\n    return 1\n}\n\n# ───────────────────────────────────────────────────────────────\n# 2. TABLE PARSING\n# ───────────────────────────────────────────────────────────────\n\n# Emits TAB-separated records. Columns are located by header name rather than by\n# position, so an escaped pipe or an extra column cannot shift the Status cell.\n# A row that looks like a criterion but does not parse is reported, never\n# skipped: a silently dropped row empties the table and closes the packet.\n_acc_rows() {\n    local ac_file=\"$1\"\n    awk '\n        function norm(v) {\n            gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", v)\n            gsub(/\\*\\*|`/, \"\", v)\n            gsub(/\\.$/, \"\", v)\n            gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", v)\n            return v\n        }\n        function lower(v) { return tolower(v) }\n        function looks_like_ac(v) { return lower(v) ~ /^ac[-_ ]?[0-9a-z.]/ }\n        BEGIN { fence = 0; in_table = 0; c_id = 0; c_status = 0; c_waiver = 0 }\n        /^[[:space:]]*(```|~~~)/ { fence = 1 - fence; next }\n        fence { next }\n        {\n            raw = $0\n            if (raw !~ /^[[:space:]]*\\|/) { in_table = 0; next }\n            gsub(/\\\\\\|/, \"\\001\", raw)\n            n = split(raw, cell, \"|\")\n            for (i = 1; i <= n; i++) { gsub(/\\001/, \"|\", cell[i]) }\n\n            # header row: bind columns by name\n            found_id = 0\n            for (i = 1; i <= n; i++) if (lower(norm(cell[i])) == \"ac-id\") { found_id = i; break }\n            if (found_id) {\n                in_table = 1; c_id = found_id; c_status = 0; c_waiver = 0\n                for (i = 1; i <= n; i++) {\n                    h = lower(norm(cell[i]))\n                    if (h == \"status\") c_status = i\n                    else if (h == \"waiver\") c_waiver = i\n                }\n                if (!c_status) printf \"MALFORMED\\t(header)\\tno Status column in the criteria table\\n\"\n                next\n            }\n            if (raw ~ /^[[:space:]]*\\|[[:space:]:*-]+\\|?[[:space:]:|*-]*$/) next\n\n            first = norm(cell[2])\n            if (!in_table) {\n                if (looks_like_ac(first))\n                    printf \"MALFORMED\\t%s\\tcriterion row outside any table with an AC-ID header\\n\", first\n                next\n            }\n            id = norm(cell[c_id])\n            if (id == \"\") next\n            if (!looks_like_ac(id)) next\n            if (toupper(id) !~ /^AC-[0-9]+[0-9A-Za-z]*$/) {\n                printf \"MALFORMED\\t%s\\tAC id is not of the form AC-NNN\\n\", id\n                next\n            }\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w1eb206b128/tree","terminal_exit":{"terminal_id":"48a74d","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
