d/skills/system-spec-kit/runtime/lib/validation/generated-metadata-integrity.ts:216:        'source_fingerprint is present without source_fingerprint_docset, so the digest names no document set and cannot be compared',\n.skilled/skills/system-spec-kit/runtime/lib/validation/generated-metadata-integrity.ts:220:  if (storedDocset < SOURCE_FINGERPRINT_DOCSET) {\n.skilled/skills/system-spec-kit/runtime/lib/validation/generated-metadata-integrity.ts:227:      code: 'SOURCE_FINGERPRINT_MISMATCH',\n.skilled/skills/system-spec-kit/runtime/lib/validation/generated-metadata-integrity.ts:228:      message: 'source_fingerprint does not match a re-derive of the current source docs, the stored derived fields may be stale',\n.skilled/skills/system-spec-kit/runtime/lib/config/capability-flags.ts:134: * source_fingerprint and the unified phase-child contract so the enforcing integrity rule\n.skilled/skills/system-spec-kit/runtime/lib/config/capability-flags.ts:135: * has the fields to check. With the flag on the generator persists a source_fingerprint\n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-schema.ts:108:  source_fingerprint: z.string().min(1).optional(),\n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-schema.ts:116:  source_fingerprint_docset: z.number().int().positive().optional(),\n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts:800:export const SOURCE_FINGERPRINT_DOCSET = 3;\n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts:1547:    source_fingerprint: isGeneratorHardeningEnabled()\n.skilled/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts:1550:    source_fingerprint_docset: isGeneratorHardeningEnabled() ? SOURCE_FINGERPRINT_DOCSET : undefined,\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/053-template-compliant-level2/graph-metadata.json:40:    \"source_fingerprint\": \"sha256:df0058a66b916c9cdfe086c6c66e127a0e59bee05033644fb80e3b398fed69f1\",\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/053-template-compliant-level2/graph-metadata.json:41:    \"source_fingerprint_docset\": 3,\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/003-valid-level2/graph-metadata.json:45:    \"source_fingerprint\": \"sha256:fd845d1db8e28ef8d0f6d181b570d7b0965e90d3c217d7d06d8d96bbd627eaaf\",\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/003-valid-level2/graph-metadata.json:46:    \"source_fingerprint_docset\": 3\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/004-valid-level3/graph-metadata.json:47:    \"source_fingerprint\": \"sha256:89360aef33696eec0fa01550eb0e0036d5f572c5a9669e3ff714e8fd30be3cb9\",\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/004-valid-level3/graph-metadata.json:48:    \"source_fingerprint_docset\": 3\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/080-anchors-duplicate-closer/graph-metadata.json:40:    \"source_fingerprint\": \"sha256:df0058a66b916c9cdfe086c6c66e127a0e59bee05033644fb80e3b398fed69f1\",\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/080-anchors-duplicate-closer/graph-metadata.json:41:    \"source_fingerprint_docset\": 3,\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/078-anchors-nested-questions/graph-metadata.json:40:    \"source_fingerprint\": \"sha256:df0058a66b916c9cdfe086c6c66e127a0e59bee05033644fb80e3b398fed69f1\",\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/078-anchors-nested-questions/graph-metadata.json:41:    \"source_fingerprint_docset\": 3,\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/063-template-compliant-level3/graph-metadata.json:51:    \"source_fingerprint\": \"sha256:e8de3726d7aa99637c6c5006d7a4d220d4afc3325844559d2e033db9a50e9f43\",\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/063-template-compliant-level3/graph-metadata.json:52:    \"source_fingerprint_docset\": 3\n.skilled/skills/system-spec-kit/runtime/cli/test-fixtures/079-anchors-adr-allowanc