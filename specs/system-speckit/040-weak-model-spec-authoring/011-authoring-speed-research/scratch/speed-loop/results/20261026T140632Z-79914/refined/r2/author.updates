is byte-identical to the previous direct readdir filter.\n865-  if (isGeneratorHardeningEnabled()) {\n866-    return listPhaseChildren(specFolderPath)\n867-      .map((child) => `${specFolder}/${child.name}`)\n868-      .sort();\n=== docset list ===\n795- * 2: the standalone verification checklist left the set; the merged tasks document\n796- *    carries its content.\n797- * 3: the acceptance-criteria and goal documents joined it - both decide packet\n798- *    state, and an unhashed document is an edit nobody detects.\n799- */\n800:export const SOURCE_FINGERPRINT_DOCSET = 3;\n801-\n802-/** Compute the `sha256:`-prefixed source fingerprint over an already-collected set of packet docs. */\n803-export function computeSourceFingerprintFromDocs(\n804-  docs: Array<{ relativePath: string; content: string }>,\n805-): string {\n806-  const projected = docs\n807-    .map((doc) => projectDocForFingerprint(doc.relativePath, doc.content))\n808-    .sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0));\n809-  const hash = crypto.createHash('sha256').update(JSON.stringify(projected)).digest('hex');\n810-  return `sha256:${hash}`;\n811-}\n812-\n813-/**\n814- * Re-derive the source fingerprint for a spec folder by reading its canonical docs.\n815- *\n816- * Used by the strict read path that has only a folder path. It reads the same canonical doc\n817- * set the generator reads, so the re-derived fingerprint matches the stored one when the\n818- * docs are unchanged and diverges when a source doc changed without a re-derive.\n819- *\n820- * @param specFolderPath - Absolute path to the packet/spec folder\n821- * @returns The `sha256:`-prefixed fingerprint over the current source docs\n822- */\n823-export function computeSourceFingerprintForFolder(specFolderPath: string): string {\n824-  const docs = collectPacketDocs(specFolderPath).docs.map((doc) => ({\n825-    relativePath: doc.relativePath,\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-M