{"toolCallId":"call_16042a6b92544e2ca3cc3665c1d34de5","status":"completed","content":[{"type":"content","content":{"type":"text","text":"14:#   Packets created before the rollout cutoff stay advisory on every branch.\n48:_acc_cutoff_date() {\n82:    local file status\n85:        status=\"$(awk -F'|' '\n93:                if (norm($2) == \"status\") { print norm($3); exit }\n96:        case \"$status\" in\n97:            complete|completed|done|shipped|delivered|closed) return 0 ;;\n123:        BEGIN { fence = 0; in_table = 0; c_id = 0; c_status = 0; c_waiver = 0 }\n137:                in_table = 1; c_id = found_id; c_status = 0; c_waiver = 0\n140:                    if (h == \"status\") c_status = i\n143:                if (!c_status) printf \"MALFORMED\\t(header)\\tno Status column in the criteria table\\n\"\n161:            st = c_status ? norm(cell[c_status]) : \"\"\n204:    RULE_STATUS=\"pass\"\n228:    local cutoff created pre_cutoff=false\n230:    cutoff=\"$(_acc_cutoff_date)\"\n232:        pre_cutoff=true\n234:    elif [[ ! \"$created\" > \"$cutoff\" ]]; then\n235:        # On the cutoff date itself the packet is still grandfathered: the\n237:        pre_cutoff=true\n245:    $pre_cutoff && verdict=\"info\"\n248:        if $pre_cutoff; then\n249:            RULE_STATUS=\"info\"\n250:            RULE_MESSAGE=\"acceptance-criteria.md absent; packet created ${created} is at or before the ${cutoff} cutoff, so closure is advisory\"\n253:        RULE_STATUS=\"fail\"\n254:        RULE_MESSAGE=\"acceptance-criteria.md is required at Level ${level} for packets created after ${cutoff} (this packet: ${created})\"\n268:    local id status waiver status_l key cited missing\n270:    while IFS=$'\\t' read -r id status waiver; do\n273:            malformed+=(\"${status}: ${waiver}\")\n281:        status_l=\"$(_acc_lower \"$status\")\"\n282:        case \"$status_l\" in\n289:                    dangling+=(\"$id is ${status} but names no decision record\")\n308:                unmet+=(\"$id (${status:-blank})\")\n316:        RULE_STATUS=\"$verdict\"\n324:        RULE_STATUS=\"info\"\n330:        RULE_STATUS=\"$verdict\"\n338:        RULE_STATUS=\"$verdict\"\n353:        RULE_STATUS=\"$verdict\"\n360:    RULE_STATUS=\"info\"\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"7eec5e","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
