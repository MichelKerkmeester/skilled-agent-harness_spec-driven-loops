{"toolCallId":"call_b9367e66b47249e8ad8bafdd9f956bb1","status":"completed","content":[{"type":"content","content":{"type":"text","text":"5:// folder: the description in description.json and the causal_summary in graph-metadata.json.\n22:export type SynopsisField = 'description' | 'causal_summary';\n28:// Field-specific length limits. The short description is a one-line label, the causal_summary\n30:// different ceiling, so a longer source produces a fuller causal_summary while the description\n33:  description: 150,\n34:  causal_summary: 600,\n40:const FRONTMATTER_DESCRIPTION_RE = /^\\s*description:\\s*(.+?)\\s*$/im;\n82:// cut it always had, so a stored description that was in sync stays in sync.\n209: * sentence, the frontmatter description, the title heading, then the first body line. The two\n217:export function derivePacketSynopsis(specContent: string, field: SynopsisField): string {\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"61865f","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_b9e73470d4e94c37b6d70fdc14999b45","status":"completed","content":[{"type":"content","content":{"type":"text","text":"64:  driftedFields: DriftedSynopsisField[];\n66:  hashDrift: boolean;\n75:  status: 'pass' | 'error' | 'info';\n204:    driftedFields: [],\n205:    hashDrift: false,\n249:  const hashDrift = storedHashes !== null && !hashMapsEqual(storedHashes, currentHashes);\n253:  if (storedHashes !== null && !hashDrift) {\n257:      driftedFields: [],\n258:      hashDrift: false,\n264:  const driftedFields: DriftedSynopsisField[] = [];\n272:      driftedFields.push({ field: 'description', stored: storedDescription, fresh });\n280:      driftedFields.push({ field: 'causal_summary', stored: storedCausalSummary, fresh });\n287:    driftedFields,\n288:    hashDrift,\n312:      status: 'pass',\n318:  const hasFindings = report.driftedFields.length > 0 || report.readErrors.length > 0;\n323:      status: 'pass',\n330:    ...report.driftedFields.map(\n339:    message: `Generated metadata drift found ${report.driftedFields.length} drifted field(s) (${mode})`,\n=== registry entries ===\n  },\n  {\n    \"rule_id\": \"COMMENT_HYGIENE_MARKER\",\n    \"aliases\": [\n      \"COMMENT_HYGIENE\"\n    ],\n    \"script_path\": \"rules/check-comment-hygiene.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Rejects ephemeral finding markers inside HTML comments in authored spec documents.\"\n  },\n  {\n    \"rule_id\": \"SCAFFOLD_NEVER_TOUCHED\",\n    \"aliases\": [\n      \"SCAFFOLD_MARKERS\",\n      \"TEMPLATE_SCAFFOLD\"\n    ],\n    \"script_path\": \"rules/check-scaffold-never-touched.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Rejects scaffold-signature markers in required docs when spec.md claims Complete status.\"\n  },\n  {\n    \"rule_id\": \"STATUS_CROSS_DOC_CONSISTENCY\",\n    \"aliases\": [\n      \"STATUS_CONSISTENCY\",\n      \"CROSS_DOC_STATUS\"\n    ],\n    \"script_path\": \"rules/check-status-cross-doc-consistency.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Advisory-by-default check that spec.md and implementation-summary.md status fields classify to the same delivery state.\"\n  },\n  {\n    \"rule_id\": \"LEVEL_DECLARED\",\n    \"aliases\": [\n      \"LEVEL\"\n    ],\n    \"script_path\": \"rules/check-level.sh\",\n    \"severity\": \"info\",\n    \"category\": \"authored_template\",\n    \"description\": \"Reports whether the documentation level was declared or inferred.\"\n  },\n  {\n    \"rule_id\": \"AC_COVERAGE\",\n    \"aliases\": [\n      \"ACCEPTANCE_COVERAGE\",\n      \"AC_TRACEABILITY\"\n    ],\n    \"script_path\": \"rules/check-ac-coverage.sh\",\n    \"severity\": \"info\",\n    \"category\": \"authored_template\",\n    \"flags\": [\n      \"SPECKIT_AC_COVERAGE\",\n      \"SPECKIT_AC_COVERAGE_ENFORCE\",\n      \"SPECKIT_AC_COVERAGE_FLOOR\"\n    ],\n    \"description\": \"Default-on advisory (non-blocking) scan for acceptance-criteria traceability coverage; set SPECKIT_AC_COVERAGE=false to opt out.\"\n  },\n  {\n    \"rule_id\": \"AC_CLOSURE\",\n    \"aliases\": [\n      \"ACCEPTANCE_CLOSURE\",\n      \"AC_GATE\"\n    ],\n    \"script_path\": \"rules/check-ac-closure.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"flags\": [\n      \"SPECKIT_AC_CLOSURE\",\n      \"SPECKIT_AC_CLOSURE_CUTOFF\"\n    ],\n    \"description\": \"Gates packet closure on acceptance-criteria.md at Levels 2, 3 and 3+; unmet criteria block a completion claim and a waiver must cite an ADR that exists. Packets created before the cutoff stay advisory.\"\n  },\n  {\n    \"rule_id\": \"ANCHORS_VALID\",\n      \"MERGE\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"operational_runtime\",\n    \"description\": \"Validates generated merge payloads against target anchor shape.\"\n  },\n  {\n    \"rule_id\": \"SPEC_DOC_SUFFICIENCY\",\n    \"aliases\": [\n      \"SUFFICIENCY\",\n      \"DOC_SUFFICIENCY\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Checks implementation-summary sufficiency after save/write flows.\"\n  },\n  {\n    \"rule_id\": \"CROSS_ANCHOR_CONTAMINATION\",\n    \"aliases\": [\n      \"CONTAMINATION\",\n      \"CROSS_ANCHOR\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"operational_runtime\",\n    \"description\": \"Detects route/category mismatches before generated content is merged.\"\n  },\n  {\n    \"rule_id\": \"POST_SAVE_FINGERPRINT\",\n    \"aliases\": [\n      \"FINGERPRINT\",\n      \"POST_SAVE\"\n    ],\n    \"script_path\": \"ts:spec-doc-structure\",\n    \"severity\": \"error\",\n    \"category\": \"operational_runtime\",\n    \"description\": \"Verifies post-save fingerprints for generated writes.\"\n  },\n  {\n    \"rule_id\": \"TOC_POLICY\",\n    \"aliases\": [\n      \"TOC\"\n    ],\n    \"script_path\": \"rules/check-toc-policy.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Enforces table-of-contents placement policy.\"\n  },\n  {\n    \"rule_id\": \"AI_PROTOCOLS\",\n    \"aliases\": [\n      \"AI_PROTOCOL\"\n    ],\n    \"script_path\": \"rules/check-ai-protocols.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Validates AI execution protocol sections in high-governance specs.\"\n  },\n  {\n    \"rule_id\": \"COMPLEXITY_MATCH\",\n    \"aliases\": [\n      \"COMPLEXITY\"\n    ],\n    \"script_path\": \"rules/check-complexity.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    \"description\": \"Checks declared level against content complexity signals.\"\n  },\n  {\n    \"rule_id\": \"FOLDER_NAMING\",\n    \"aliases\": [],\n    \"script_path\": \"rules/check-folder-naming.sh\",\n    \"severity\": \"error\",\n    \"category\": \"authored_template\",\n    ],\n    \"script_path\": \"validation/generated-metadata-integrity.ts\",\n    \"severity\": \"error\",\n    \"category\": \"structural\",\n    \"strict_only\": true,\n    \"description\": \"Validates description.json and graph-metadata.json through the shared schemas plus path-prefix and status-enum invariants, error under strict behind a grandfather report mode.\"\n  },\n  {\n    \"rule_id\": \"GENERATED_METADATA_DRIFT\",\n    \"aliases\": [\n      \"METADATA_DRIFT\",\n      \"SYNOPSIS_DRIFT\"\n    ],\n    \"script_path\": \"validation/generated-metadata-drift.ts\",\n    \"severity\": \"error\",\n    \"category\": \"structural\",\n    \"strict_only\": true,\n    \"description\": \"Re-derives a folder and reports drift between the stored description/causal_summary and the current docs, read-only, error under strict only when the drift-gate flag is on and otherwise grandfather report mode.\"\n  },\n  {\n    \"rule_id\": \"LINKS_VALID\",\n    \"aliases\": [\n      \"WIKILINKS_VALID\",\n      \"CHECK_LINKS\"\n    ],\n    \"category\": \"operational_runtime\",\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w5963e3680a/tree","terminal_exit":{"terminal_id":"51cbec","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
