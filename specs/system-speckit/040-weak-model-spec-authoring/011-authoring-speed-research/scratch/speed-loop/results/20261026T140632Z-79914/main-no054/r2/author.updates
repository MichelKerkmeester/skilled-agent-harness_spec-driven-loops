{"toolCallId":"call_b1373d15191745fcae82de04d79b325f","status":"completed","content":[{"type":"content","content":{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Generated Metadata Integrity\n// ───────────────────────────────────────────────────────────────────\n// First-class validator for the two generated JSON files a spec folder carries:\n// description.json and graph-metadata.json. It runs the shared Zod schemas plus the\n// canonical path-prefix and status-enum invariants, so the generated contract is a real\n// completion gate rather than a shallow shell-shape warning. Severity resolution is left\n// to the caller so the same check backs both the report-mode rollout and the enforced run.\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nimport { graphMetadataSchema } from '../graph/graph-metadata-schema.js';\nimport { perFolderDescriptionSchema } from '../description/description-schema.js';\nimport { SOURCE_FINGERPRINT_DOCSET, computeSourceFingerprintForFolder, parseCompletionPct, hasOpenTaskItems } from '../graph/graph-metadata-parser.js';\nimport { isGeneratorHardeningEnabled } from '../config/capability-flags.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n/** Validation rule id reported for the generated-metadata integrity gate. */\nexport const GENERATED_METADATA_INTEGRITY_RULE = 'GENERATED_METADATA_INTEGRITY' as const;\n\n/** Violation code for a derived.status:'complete' folder whose completion evidence disagrees. */\nexport const STATUS_COMPLETE_EVIDENCE_MISMATCH_CODE = 'STATUS_COMPLETE_EVIDENCE_MISMATCH' as const;\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Which of a spec folder's two generated JSON files a violation belongs to. */\nexport type GeneratedMetadataFile = 'graph-metadata.json' | 'description.json';\n\n/** One schema, path-prefix, or status-enum violation found in a generated metadata file. */\nexport interface GeneratedMetadataViolation {\n  file: GeneratedMetadataFile;\n  code: string;\n  message: string;\n}\n\n/** Result of validating a spec folder's generated metadata files against the integrity contract. */\nexport interface GeneratedMetadataIntegrityReport {\n  rule: typeof GENERATED_METADATA_INTEGRITY_RULE;\n  /** Whether any generated file was present to validate. */\n  checked: boolean;\n  violations: GeneratedMetadataViolation[];\n}\n\n/** An integrity report resolved to a validator-consumable pass/error/info status and message. */\nexport interface ResolvedIntegrityStatus {\n  rule: typeof GENERATED_METADATA_INTEGRITY_RULE;\n  status: 'pass' | 'error' | 'info';\n  message: string;\n  details: string[];\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\n/**\n * Whether a stored spec-folder identity is in the canonical specs-root-relative shape.\n *\n * The generated files store a specs-root-relative folder (the same shape graph metadata\n * keeps in spec_folder). A value that carries the specs-root prefix, is absolute, or walks\n * parents has drifted out of that shape and breaks identity joins.\n */\nfunction isCanonicalSpecFolderValue(value: string): boolean {\n  const normalized = value.replace(/\\\\/g, '/').trim();\n  if (!normalized) {\n    return false;\n  }\n  if (normalized.startsWith('/')) {\n    return false;\n  }\n  if (normalized.startsWith('./') || normalized.startsWith('../')) {\n    return false;\n  }\n  if (normalized.split('/').includes('..')) {\n    return false;\n  }\n  if (/^(\\.(?:skilled|opencode)\\/)?specs\\//.test(normalized)) {\n    return false;\n  }\n  return true;\n}\n\nfunction readJsonFile(filePath: string): { ok: true; value: unknown } | { ok: false; reason: 'unreadable' | 'unparseable' } {\n  let raw: string;\n  try {\n    raw = fs.readFileSync(filePath, 'utf-8');\n  } catch {\n    return { ok: false, reason: 'unreadable' };\n  }\n  try {\n    return { ok: true, value: JSON.parse(raw) as unknown };\n  } catch {\n    return { ok: false, reason: 'unparseable' };\n  }\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. CORE LOGIC\n// ───────────────────────────────────────────────────────────────────\n\nfunction validateGraphMetadataFile(filePath: string, violations: GeneratedMetadataViolation[]): void {\n  const read = readJsonFile(filePath);\n  if (!read.ok) {\n    violations.push({\n      file: 'graph-metadata.json',\n      code: read.reason === 'unreadable' ? 'FILE_UNREADABLE' : 'FILE_UNPARSEABLE',\n      message: `graph-metadata.json could not be ${read.reason === 'unreadable' ? 'read' : 'parsed as JSON'}`,\n    });\n    return;\n  }\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w904a7ae601/tree","terminal_exit":{"terminal_id":"09da81","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_b18ad1b84a4d484e9e3731032483c1cc","status":"completed","content":[{"type":"content","content":{"type":"text","text":"    1536 .skilled/skills/system-spec-kit/runtime/lib/validation/spec-doc-structure.ts\n23:  | 'FRONTMATTER_MEMORY_BLOCK'\n25:  | 'SPEC_DOC_SUFFICIENCY'\n26:  | 'CROSS_ANCHOR_CONTAMINATION'\n64:/** A proposed edit's routing details, for the CROSS_ANCHOR_CONTAMINATION rule. */\n110:  memoryBlock: string | null;\n125:  'FRONTMATTER_MEMORY_BLOCK',\n127:  'SPEC_DOC_SUFFICIENCY',\n128:  'CROSS_ANCHOR_CONTAMINATION',\n134:  FRONTMATTER_MEMORY_BLOCK: [\n142:    'MEMORY_BLOCK_INVALID',\n152:  SPEC_DOC_SUFFICIENCY: [\n153:    'SPECDOC_SUFFICIENCY_001',\n154:    'SPECDOC_SUFFICIENCY_002',\n155:    'SPECDOC_SUFFICIENCY_003',\n156:    'SPECDOC_SUFFICIENCY_004',\n157:    'SPECDOC_SUFFICIENCY_005',\n158:    'SPECDOC_SUFFICIENCY_006',\n160:  CROSS_ANCHOR_CONTAMINATION: [\n218: * anchor-sufficiency gates. The numbered levels list research/research.md as a\n248:const LAZY_DOCS_WITH_STATIC_ANCHORS = new Set(['before-after.md', 'timeline.md', 'roadmap.md', 'goal.md']);\n305:      memoryBlock: null,\n315:      memoryBlock: null,\n333:        memoryBlock: null,\n347:  let memoryBlock: string | null = null;\n362:    memoryBlock = blockLines.join('\\n');\n364:      validateMemoryYamlBlock(memoryBlock);\n403:    memoryBlock,\n616:    const openMatch = scannable.match(/<!--\\s*ANCHOR:([A-Za-z0-9][A-Za-z0-9_-]*)\\s*-->/);\n617:    const closeMatch = scannable.match(/<!--\\s*\\/ANCHOR:([A-Za-z0-9][A-Za-z0-9_-]*)\\s*-->/);\n729:    if (!parsed.memoryBlock) {\n742:        code: 'MEMORY_BLOCK_INVALID',\n899:    'FRONTMATTER_MEMORY_BLOCK',\n1042:const GOAL_LOG_ANCHOR = '<!-- ANCHOR:log -->';\n1060:  const logIndex = body.indexOf(GOAL_LOG_ANCHOR);\n1082:        code: 'SPECDOC_SUFFICIENCY_005',\n1100:        code: 'SPECDOC_SUFFICIENCY_006',\n1168:    // Anchor-parse failures must cause SPEC_DOC_SUFFICIENCY to fail.\n1171:    // documents with corrupt anchor structure pass sufficiency validation.\n1175:          code: 'SPECDOC_SUFFICIENCY_001',\n1184:    if (LAZY_DOCS_WITH_STATIC_ANCHORS.has(document.basename)) {\n1189:            code: 'SPECDOC_SUFFICIENCY_001',\n1200:          code: 'SPECDOC_SUFFICIENCY_001',\n1210:        code: 'SPECDOC_SUFFICIENCY_002',\n1219:        code: 'SPECDOC_SUFFICIENCY_002',\n1234:          code: 'SPECDOC_SUFFICIENCY_004',\n1249:            code: 'SPECDOC_SUFFICIENCY_003',\n1259:    'SPEC_DOC_SUFFICIENCY',\n1261:    'All targeted spec-doc anchors meet the sufficiency baseline',\n1291:      'CROSS_ANCHOR_CONTAMINATION',\n1309:        'CROSS_ANCHOR_CONTAMINATION',\n1335:    'CROSS_ANCHOR_CONTAMINATION',\n1413:    case 'FRONTMATTER_MEMORY_BLOCK':\n1417:    case 'SPEC_DOC_SUFFICIENCY':\n1419:    case 'CROSS_ANCHOR_CONTAMINATION':\n1500:      'Usage: spec-doc-structure.ts --folder <path> --level <level> --rule <FRONTMATTER_MEMORY_BLOCK|MERGE_LEGALITY|SPEC_DOC_SUFFICIENCY|CROSS_ANCHOR_CONTAMINATION|POST_SAVE_FINGERPRINT> [--merge-plan-json <json>] [--contamination-json <json>] [--post-save-json <json>] [--output tsv|json]',\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w904a7ae601/tree","terminal_exit":{"terminal_id":"997cff","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
