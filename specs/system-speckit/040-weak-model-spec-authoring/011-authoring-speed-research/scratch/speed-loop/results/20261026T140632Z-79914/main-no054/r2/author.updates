    \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Task Format\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Task Notation\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Completion Criteria\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Verification Checklist\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Verification Protocol\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Completion Impact\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"tasks.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Acceptance Criteria\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"acceptance-criteria.md\",\n        \"source\": \"derived\"\n      }\n    ],\n    \"causal_summary\": \"[What is broken, missing, or inefficient? 2-3 sentences describing the specific pain point.]\",\n    \"created_at\": \"2026-10-26T14:18:27Z\",\n    \"last_save_at\": \"2026-10-26T14:18:27.707Z\",\n    \"save_lineage\": \"graph_only\",\n    \"last_accessed_at\": null,\n    \"source_docs\": [\n      \"spec.md\",\n      \"plan.md\",\n      \"tasks.md\",\n      \"acceptance-criteria.md\",\n      \"implementation-summary.md\"\n    ],\n    \"source_fingerprint\": \"sha256:7dfb369d67850e19144322421e65a6331adb77a58360c318832d936505cec0ad\",\n    \"source_fingerprint_docset\": 3,\n    \"source_doc_hashes\": {\n      \"spec.md\": \"534dc1d2df51525a610315d58b77e8e43073038424a81664dd83bbb83f2a0675\",\n      \"plan.md\": \"7a7cabf4be5130237449ed0b760d2bdaaac87f20095c4d7dad