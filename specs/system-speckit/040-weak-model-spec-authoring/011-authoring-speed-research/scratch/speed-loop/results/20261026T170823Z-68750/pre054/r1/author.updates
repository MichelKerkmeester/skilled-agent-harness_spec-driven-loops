{"toolCallId":"call_46b751a96a4b4749a280bfbe1d7dd27b","status":"completed","content":[{"type":"content","content":{"type":"text","text":"    else\n      echo \"  \\\"quality\\\": {\"\n      echo \"    \\\"enabled\\\": false\"\n      echo \"  }\"\n    fi\n\n    echo \"}\"\n  fi\n}\n\n# ───────────────────────────────────────────────────────────────\n# 8. MAIN SCRIPT\n# ───────────────────────────────────────────────────────────────\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --verbose|-v) VERBOSE=true; shift ;;\n    --json|-j) JSON_OUTPUT=true; shift ;;\n    --quality|-q) QUALITY_CHECK=true; shift ;;\n    --file|-f) SINGLE_FILE=\"$2\"; shift 2 ;;\n    --help|-h) show_help ;;\n    *)\n      if [[ -z \"$SPEC_FOLDER\" ]] && [[ -z \"$SINGLE_FILE\" ]]; then\n        SPEC_FOLDER=\"$1\"\n      else\n        echo \"ERROR: Unexpected argument: $1\" >&2\n        echo \"Use --help for usage information\" >&2\n        exit 1\n      fi\n      shift\n      ;;\n  esac\ndone\n\nif [[ -z \"$SPEC_FOLDER\" ]] && [[ -z \"$SINGLE_FILE\" ]]; then\n  echo \"ERROR: Either spec folder or --file must be specified\" >&2\n  echo \"Use --help for usage information\" >&2\n  exit 1\nfi\n\nif ! command -v bc &>/dev/null; then\n  echo \"ERROR: 'bc' command not found. Install bc for percentage calculations.\" >&2\n  exit 1\nfi\n\nif [[ -n \"$SINGLE_FILE\" ]]; then\n  calculate_file_completeness \"$SINGLE_FILE\"\nelse\n  calculate_spec_completeness \"$SPEC_FOLDER\"\nfi\n\nif [[ \"$JSON_OUTPUT\" = true ]]; then\n  output_json\nelse\n  output_text\nfi\n\nexit 0\n\n# Exit codes:\n#   0 - Success\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wa3f8a76d29/tree","terminal_exit":{"terminal_id":"5e4b96","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
