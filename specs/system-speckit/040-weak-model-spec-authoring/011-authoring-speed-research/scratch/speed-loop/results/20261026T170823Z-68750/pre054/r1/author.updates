{"toolCallId":"call_0de5b0b2e05b4e0ca94de7d096fe409e","status":"completed","content":[{"type":"content","content":{"type":"text","text":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: CALCULATE COMPLETENESS\n# ───────────────────────────────────────────────────────────────\n#\n# Calculate placeholder replacement progress in spec folders.\n# Usage: calculate-completeness.sh [OPTIONS] [SPEC_FOLDER]\n# Options: --verbose/-v, --json/-j, --file/-f <path>, --quality/-q, --help/-h\n\nset -euo pipefail\n\n# ───────────────────────────────────────────────────────────────\n# 1. CONFIGURATION\n# ───────────────────────────────────────────────────────────────\n\ndeclare -a PLACEHOLDER_PATTERNS=(\n  '\\[PLACEHOLDER\\]'\n  '\\[TODO:.*\\]'\n  '\\[NEEDS CLARIFICATION:.*\\]'\n  '\\[TBD\\]'\n  '\\[XXX\\]'\n  '\\[FIXME\\]'\n)\n\ndeclare -a TEMPLATE_FILES=(\n  'spec.md'\n  'plan.md'\n  'tasks.md'\n  'research/research.md'\n  'decision-record-*.md'\n)\n\n# ───────────────────────────────────────────────────────────────\n# 2. QUALITY THRESHOLDS\n# ───────────────────────────────────────────────────────────────\n\nMIN_WORDS_SPEC=100\nMIN_WORDS_PLAN=80\nMIN_WORDS_TASKS=50\nMIN_WORDS_CHECKLIST=30\nMIN_WORDS_RESEARCH=150\nMIN_WORDS_DEFAULT=50\n\n# ───────────────────────────────────────────────────────────────\n# 3. GLOBALS\n# ───────────────────────────────────────────────────────────────\n\nVERBOSE=false\nJSON_OUTPUT=false\nQUALITY_CHECK=false\nSINGLE_FILE=\"\"\nSPEC_FOLDER=\"\"\n\nQUALITY_WARNINGS=()\nQUALITY_WARNING_COUNT=0\n\n# Bash 3.2 compatible temp file handling\nSTATS_DIR=\"${TMPDIR:-/tmp}/speckit-completeness-$$\"\nif ! mkdir -p \"$STATS_DIR\" 2>/dev/null; then\n  echo \"ERROR: Cannot create temp directory: $STATS_DIR\" >&2\n  exit 1\nfi\ntrap 'rm -rf \"$STATS_DIR\"' EXIT\n\nTOTAL_PLACEHOLDERS=0\nTOTAL_LINES=0\nOVERALL_PERCENTAGE=100\nFILES_ANALYZED=0\n\n# ───────────────────────────────────────────────────────────────\n# 4. HELPER FUNCTIONS\n# ───────────────────────────────────────────────────────────────\n\nshow_help() {\n  cat << 'EOF'\nSpecKit Completeness Calculator\n\nUSAGE:\n  calculate-completeness.sh [OPTIONS] [SPEC_FOLDER]\n\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/wa3f8a76d29/tree","terminal_exit":{"terminal_id":"34ed58","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
