  {\n      \"raw\": \"Security\",\n      \"normalized\": \"SECURITY\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"Documentation\",\n      \"normalized\": \"DOCUMENTATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"File Organization\",\n      \"normalized\": \"FILE ORGANIZATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"Verification Summary\",\n      \"normalized\": \"VERIFICATION SUMMARY\",\n      \"dynamic\": false\n    }\n  ],\n  \"optionalHeaderRules\": [\n    {\n      \"raw\": \"L3+: Architecture Verification\",\n      \"normalized\": \"L3+: ARCHITECTURE VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Performance Verification\",\n      \"normalized\": \"L3+: PERFORMANCE VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Deployment Readiness\",\n      \"normalized\": \"L3+: DEPLOYMENT READINESS\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Compliance Verification\",\n      \"normalized\": \"L3+: COMPLIANCE VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Documentation Verification\",\n      \"normalized\": \"L3+: DOCUMENTATION VERIFICATION\",\n      \"dynamic\": false\n    },\n    {\n      \"raw\": \"L3+: Sign-Off\",\n      \"normalized\": \"L3+: SIGN-OFF\",\n      \"dynamic\": false\n    }\n  ],\n  \"requiredAnchors\": [\n    \"notation\",\n    \"phase-1\",\n    \"phase-2\",\n    \"phase-3\",\n    \"completion\",\n    \"cross-refs\",\n    \"protocol\",\n    \"pre-impl\",\n    \"code-quality\",\n    \"testing\",\n    \"fix-completeness\",\n    \"security\",\n    \"docs\",\n    \"file-org\",\n    \"summary\"\n  ],\n  \"optionalAnchors\": [\n    \"arch-verify\",\n    \"perf-verify\",\n    \"deploy-ready\",\n    \"compliance-verify\",\n    \"docs-verify\",\n    \"sign-off\"\n  ],\n  \"allowedAnchors\": [\n    \"notation\",\n    \"phase-1\",\n    \"phase-2\",\n    \"phase-3\",\n    \"completion\",\n    \"cross-refs\",\n    \"protocol\",\n    \"pre-impl\",\n    \"code-quality\",\n    \"testing\",\n    \"fix-completeness\",\n    \"security\",\n    \"docs\",\n    \"file-org\",\n    \"summary\",\n    \"arch-verify\",\n    \"perf-verify\",\n    \"deploy-ready\",\n    \"compliance-verify\",\n    \"docs-verify\",\n    \"sign-off\"\n  ]\n}\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w27ef8e22cd/tree","terminal_exit":{"terminal_id":"2cb3e7","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_78e3d2f7c0e8410d9f63cf69ca4a0e4c","status":"completed","content":[{"type":"content","content":{"type":"text","text":"53-| Complex/architectural | 3 | L2 + decision-record.md | research/research.md, resource-map.md |\n54-| Enterprise/governance heavy | 3+ | L3 file set rendered at Level 3+ | research/research.md, resource-map.md |\n55-\n56:**LOC as one input to `runtime/cli/spec/recommend-level.sh`, which scores it with file count and risk:**\n57-- <100 LOC suggests Level 1\n58-- 100-499 LOC suggests Level 2\n59-- >=500 LOC suggests Level 3\n60-- High complexity/risk and governance needs suggest Level 3+\n61-\n62----\n63-\n64-## 3. TEMPLATE COPY COMMANDS (PROGRESSIVE)\n--\n573-### Enforcement\n574-\n575-- **Verify required templates exist** before claiming completion\n576:- **LOC is one scored input** - run `recommend-level.sh` and go higher when your judgment disagrees\n577-- **Enforcement is `validate.sh --strict` plus `check-completion.sh`** - run both before claiming done\n578-\n579-### Applies to ALL\n580-\n581-- Code files (*.js, *.ts, *.py, *.css, *.html)\n582-- Documentation files (*.md, README, docs/)\n583-- Configuration files (*.json, *.yaml, *.toml)\n584-- Knowledge base files (project-specific)\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w27ef8e22cd/tree","terminal_exit":{"terminal_id":"0c1d54","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_83e6bdae8eef4ddcbd660a45b068d59c","status":"completed","content":[{"type":"content","content":{"type":"text","text":"409-    \"strict_only\": true,\n410-    \"description\": \"Validates description.json and graph-metadata.json through the shared schemas plus path-prefix and status-enum invariants, error under strict behind a grandfather report mode.\"\n411-  },\n412-  {\n413:    \"rule_id\": \"GENERATED_METADATA_DRIFT\",\n414-    \"aliases\": [\n415-      \"METADATA_DRIFT\",\n416-      \"SYNOPSIS_DRIFT\"\n417-    ],\n418-    \"script_path\": \"validation/generated-metadata-drift.ts\",\n419-    \"severity\": \"error\",\n420-    \"category\": \"structural\",\n421-    \"strict_only\": true,\n422-    \"description\": \"Re-derives a folder and reports drift between the stored description/causal_summary and the current docs, read-only, error under strict only when the drift-gate flag is on and otherwise grandfather report mode.\"\n423-  },\n424-  {\n425-    \"rule_id\": \"LINKS_VALID\",\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w27ef8e22cd/tree","terminal_exit":{"terminal_id":"a59294","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
