{"toolCallId":"call_5ef597f144424e5593ab6c0e7073f13f","status":"completed","content":[{"type":"content","content":{"type":"text","text":"63-+-- progressive-validate.sh      # Staged validation helper\n64-+-- check-completion.sh          # Verify the tasks checklist and acceptance closure\n65-+-- scaffold-debug-delegation.sh # Generate debug-delegation handoff scaffolds\n66-+-- calculate-completeness.sh    # Report checklist completion metrics\n67:+-- recommend-level.sh           # Recommend documentation level from task signals\n68-+-- archive.sh                   # Move completed or stale spec folders\n69-+-- check-template-staleness.sh  # Compare generated docs with templates\n70-+-- check-card-sync.sh           # Assert the authoring card, router, inventory and checklist agree\n71-+-- quality-audit.sh             # Batch quality audit helper\n72-+-- test-validation.sh           # Legacy wrapper for scripts/tests/test-validation.sh\n73-+-- is-phase-parent.ts           # Phase-parent detection and manifest health check\n74-+-- sync-phase-map-status.ts     # Sync a phase parent's map table; report completion mismatches\n75-+-- sweep-track-roots.mjs        # Report track roots whose children_ids differ from their packets\n76-+-- refresh-track-roots.mjs      # Rewrite a track root's children_ids to its packets on disk\n77-+-- repair-derived.cjs           # Repair packet facts derivable from disk; refuses authored facts\n78-+-- README-repair-derived.md     # Derived-vs-authored repair boundary reference\n79-+-- upgrade-legacy.mjs           # Upgrade a v3.x specs tree: repair failing packets, record the rest\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w27ef8e22cd/tree","terminal_exit":{"terminal_id":"3d6bbd","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
