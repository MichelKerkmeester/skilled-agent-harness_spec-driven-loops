{"toolCallId":"call_5d634dd5e07248f8abaad2ad4ed26d88","status":"completed","content":[{"type":"content","content":{"type":"text","text":"87-// in-document reference paths, which a re-derive does not write; planning one\n88-// for them would be a write that changes nothing and a report line that never\n89-// clears.\n90-const REDERIVABLE = new Set([\n91-  'GENERATED_METADATA_INTEGRITY',\n92-  'GENERATED_METADATA_DRIFT',\n93-  'GRAPH_METADATA_SHAPE',\n94-  'METADATA_DISK_PATH_CONSISTENCY',\n95-]);\n96-\n97:const POINTER_LINE = /^([ \\t]*packet_pointer:[ \\t]*)([\"']?)([^\"'\\r\\n]*)([\"']?)[ \\t]*\\r?$/m;\n98-const SPEC_FOLDER_ROW = /(\\|[ \\t]*\\*\\*Spec Folder\\*\\*[ \\t]*\\|[ \\t]*)([^|\\r\\n]+?)([ \\t]*\\|)/;\n99-const DOCS = ['spec.md', 'plan.md', 'tasks.md', 'implementation-summary.md', 'handover.md'];\n100-const PACKET_MARKERS = new Set(['spec.md', 'implementation-summary.md']);\n101-\n102-// A marker alone is not enough: the metadata writer this script drives also\n103-// requires the numbered folder name, and handing it a folder it will refuse\n104-// turns a correctly out-of-scope directory into a reported failure. The two\n105-// definitions of \"packet\" have to agree or the failure count means nothing.\n106-// Mirrors SPEC_FOLDER_RE in backfill-graph-metadata.ts.\n107-const PACKET_NAME_RE = /^\\d{3}(?:[-_].+)?$/;\n108-\n109-// The recorded location lives in the leading YAML block. A pointer written into\n110-// a document's body is an illustration of the format, not this packet's own\n111-// record, and rewriting it would corrupt the passage it explains. The block can\n112-// sit behind a template-source HTML comment, so the opener is matched past\n113-// leading comments and blank lines rather than demanded at byte zero. Every\n114-// repeat here consumes a newline, so the group cannot loop on an empty match.\n115-const FRONTMATTER_OPEN = /^\\uFEFF?(?:[ \\t]*\\r?\\n|<!--[\\s\\S]*?-->[ \\t]*\\r?\\n)*---[ \\t]*\\r?\\n/;\n116-const FRONTMATTER_CLOSE = /^(?:---|\\.\\.\\.)[ \\t]*\\r?$/m;\n117-\n118-const USAGE = 'Usage: repair-derived.cjs [--folder <packet>]... [--roots <dir>] [--apply]';\n119-\n120-// Reported as one planned step like any other, so a dry run names it and the\n121-// exit code counts it. Carries no apply(): the re-derive is a child process the\n122-// repair awaits, not a file this tool writes itself.\n123-const REDERIVE_STEP = Object.freeze({ what: 're-derive graph metadata' });\n124-\n125-/** Rejected arguments, kept apart from failures so the usage line follows them. */\n126-class UsageError extends Error {}\n127-\n--\n455-          writeAtomic(graph, `${JSON.stringify(current, null, 2)}\\n`);\n456-        },\n457-      });\n458-    }\n459-  }\n460-\n461-  for (const name of DOCS) {\n462-    const file = path.join(folder, name);\n463-    const text = readIfPresent(file);\n464-    if (text === null) continue;\n465:    const hit = POINTER_LINE.exec(text);\n466-    if (!hit || hit.index >= frontmatterEnd(text) || hit[3] === pointer) continue;\n467-    actions.push({\n468-      file,\n469-      what: `packet pointer -> ${pointer}`,\n470-      apply: () => {\n471-        const current = readForWrite(file);\n472:        const found = POINTER_LINE.exec(current);\n473-        if (!found || found.index >= frontmatterEnd(current)) {\n474-          throw new Error('the packet pointer left the frontmatter between the report and the write');\n475-        }\n476-        writeAtomic(file, `${current.slice(0, found.index)}${found[1]}\"${pointer}\"${current.slice(found.index + found[0].length)}`);\n477-      },\n478-    });\n479-  }\n480-  return actions;\n481-}\n482-\n483-async function rederive(folder) {\n484-  try {\n485-    await run('node', ['--import', TSX_LOADER, BACKFILL, folder], CHILD);\n486-    return null;\n487-  } catch (err) {\n488-    return childFailure(err);\n489-  }\n490-}\n491-\n492-// A JSON parse error's message quotes the bytes around the fault, so a failed write\n"}}],"_meta":{"cognition.ai/cwd