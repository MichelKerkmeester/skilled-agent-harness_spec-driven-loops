{"toolCallId":"call_332fc7622e6145948f65b9c6253b009d","status":"completed","content":[{"type":"content","content":{"type":"text","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Backfill Graph Metadata\n// Usage:\n//   node .../graph/backfill-graph-metadata.js <spec-folder> [--dry-run]\n//   node .../graph/backfill-graph-metadata.js --spec-folder <path> [--dry-run]\n//   node .../graph/backfill-graph-metadata.js --all [--dry-run] [--active-only] [--root <specs-dir>]\n//   node .../graph/backfill-graph-metadata.js <scope> --prune-report\n//   node .../graph/backfill-graph-metadata.js <scope> --prune --prune-confirm <report-hash>\n//\n// --prune-report writes .backfill-graph-metadata-prune-report.json under the\n// selected specs root and exits without changing graph metadata. Review that\n// artifact, then pass its contentHash to --prune-confirm. Apply refuses when\n// the artifact is absent or the current candidates differ from the report.\n//\n// A default invocation refreshes ONE packet only: it requires a target spec\n// folder, validates it against the supported specs roots, and never walks the\n// repo-wide tree. The broad repo-wide walk lives behind an explicit --all flag\n// so a single-packet intent can no longer dirty unrelated sessions' folders.\n// In --all mode z-future/ is always skipped (it is not a supported specs root)\n// and z_archive/ is included unless --active-only is passed.\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport crypto from 'node:crypto';\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nimport {\n  canClassifyAsGraphMetadataPath,\n  checkGeneratedMetadataDrift,\n  collectChildrenPruneCandidates,\n  deriveGraphMetadata,\n  getSpecsBasePaths,\n  graphMetadataEqualIgnoringVolatile,\n  loadGraphMetadata,\n  mergeGraphMetadata,\n  refreshGraphMetadataForSpecFolder,\n  resolveSpecFolderIdentity,\n  SpecFolderIdentityError,\n  type GraphMetadata,\n} from '@spec-kit/runtime/api';\nimport { dirnameFromImportMeta, isMainModule } from '../lib/esm-entry.js';\nimport { findRepoRoot } from '@spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nconst moduleDir = dirnameFromImportMeta(import.meta.url);\n\nconst SPEC_FOLDER_RE = /^\\d{3}(?:[-_].+)?$/;\nconst EXCLUDED_DIRS = new Set(['memory', 'scratch', 'node_modules', '.git', 'z-future']);\nconst ARCHIVE_SEGMENT_RE = /(^|\\/)(z_archive|z_future)(\\/|$)/;\nconst BACKFILL_PRUNE_REPORT_FILE = '.backfill-graph-metadata-prune-report.json';\nconst PRUNE_REPORT_VERSION = 1;\n\n// ───────────────────────────────────────────────────────────────────\n=== USAGE ===\n4://   node .../graph/backfill-graph-metadata.js <spec-folder> [--dry-run]\n5://   node .../graph/backfill-graph-metadata.js --spec-folder <path> [--dry-run]\n6://   node .../graph/backfill-graph-metadata.js --all [--dry-run] [--active-only] [--root <specs-dir>]\n90:  dryRun: boolean;\n109:/** CLI-parsed options controlling scope, dry-run, and prune behavior for the graph-metadata backfill. */\n111:  dryRun: boolean;\n413: * Parse argv into a validated backfill plan.\n420: * @param argv - CLI arguments after the node entrypoint\n423:export function planBackfill(argv: string[]): BackfillPlan {\n424:  let dryRun = false;\n434:  for (let index = 0; index < argv.length; index += 1) {\n435:    const arg = argv[index];\n436:    if (arg === '--dry-run') {\n437:      dryRun = true;\n446:      dryRun = true;\n450:      const value = argv[index + 1];\n471:      const value = argv[index + 1];\n480:      const value = argv[index + 1];\n517:      options: { dryRun, root, activeOnly, prune, pruneReport, pruneConfirm },\n535:      dryRun,\n661:  dryRun,\n672:    dryRun,\n727:      const metadata = dryRun\n735:        if (!dryRun && !existing.derived.save_lineage && metadata.derived.save_lineage === 'graph_only') {\n749:      // dry-run and live alike and cannot churn the files the gate exists to keep clean.\n796:    dryRun: true,\n839:  const argv = process.argv.slice(2);\n840:  const plan = planBackfill(argv);\n848:  if (argv.includes('--root') && !isInsideRepository(plan.options.root)) {\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w27ef8e22cd/tree","terminal_exit":{"terminal_id":"e6a64d","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
{"toolCallId":"call_3cc9fc78a8954224ba950729c09342ff","status":"completed","content":[{"type":"content","content":{"type":"text","text":"// A link is refused rather than followed. Reading through it takes content from\n// wherever it points, and a rename over it replaces the link itself, so the anchor\n// healer refuses the same case with the same message.\nconst SYMLINK_REFUSAL = 'symbolic link, not followed';\n\n/** True when the path itself is a symbolic link, judged without following it. */\nfunction isSymbolicLink(file) {\n  try { return fs.lstatSync(file).isSymbolicLink(); } catch { return false; }\n}\n\n// Files a repair may rewrite inside a packet. A link among them is reported as refused.\nconst REWRITE_TARGETS = ['description.json', 'graph-metadata.json', ...DOCS];\n\n/** The rewrite targets in a packet that are links, which the tool will not touch. */\nfunction linkedRewriteTargets(folder) {\n  return REWRITE_TARGETS.map((name) => path.join(folder, name)).filter(isSymbolicLink);\n}\n\n// Measured set: the packet files the re-derive child opened through planted links. Mirrors the packet document lists of the graph parser, the drift check and folder discovery.\nconst REDERIVE_INPUTS = Object.freeze([\n  'spec.md',\n  'plan.md',\n  'tasks.md',\n  'acceptance-criteria.md',\n  'goal.md',\n  'decision-record.md',\n  'implementation-summary.md',\n  'handover.md',\n  'resource-map.md',\n  'description.json',\n  'research.md',\n  path.join('research', 'research.md'),\n]);\n\nfunction isWithinPacketFolder(filePath, packetFolderPath) {\n  try {\n    const realPacketFolderPath = fs.realpathSync(packetFolderPath);\n    const realFilePath = fs.realpathSync(filePath);\n    const relativePath = path.relative(realPacketFolderPath, realFilePath);\n    return relativePath === '' || (\n      relativePath !== '..'\n      && !relativePath.startsWith(`..${path.sep}`)\n      && !path.isAbsolute(relativePath)\n    );\n  } catch {\n    return false;\n  }\n}\n\n// Re-derive imports packet documents, so a link must resolve within the same packet.\nfunction linkedRederiveInputs(folder) {\n  return REDERIVE_INPUTS.filter((name) => {\n    const inputPath = path.join(folder, name);\n    return (fs.existsSync(inputPath) || isSymbolicLink(inputPath)) && !isWithinPacketFolder(inputPath, folder);\n  });\n}\n\n/** Read a file that may not be there, without racing a separate existence check. */\nfunction readIfPresent(file) {\n  if (isSymbolicLink(file)) return null;\n  try {\n    return fs.readFileSync(file, 'utf8');\n  } catch (err) {\n    if (err.code === 'ENOENT' || err.code === 'EISDIR') return null;\n    throw err;\n  }\n}\n\n// Planning ran earlier, so a target may have become a link since it was read.\n// Reading through that link would take bytes from outside the packet, so the\n// write-time read refuses it the same way readIfPresent does.\nfunction readForWrite(file) {\n  if (isSymbolicLink(file)) throw new Error(SYMLINK_REFUSAL);\n  return fs.readFileSync(file, 'utf8');\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. DERIVED REPAIRS\n// ───────────────────────────────────────────────────────────────────\n\n// A repair rewrites a document a person wrote. Writing in place truncates the\n// file first, so an interrupt between the truncate and the write leaves that\n// document empty — an outcome worse than the failure being repaired. Writing a\n// sibling and renaming over the original makes the swap atomic: a reader sees\n// either the old bytes or the new ones, never neither.\n// The sibling's name carries random bytes and is created exclusively. A predictable\n// name let a link planted there receive the write, which then landed wherever the\n// link pointed, outside the packet.\nfunction writeAtomic(file, text) {\n  if (isSymbolicLink(file)) throw new Error(SYMLINK_REFUSAL);\n  const temp = path.join(path.dirname(file), `.${path.basename(file)}.repair-${process.pid}-${crypto.randomBytes(6).toString('hex')}.tmp`);\n  let descriptor = null;\n  let temporary = null;\n  try {\n    descriptor = fs.openSync(temp, 'wx');\n    temporary = temp;\n    fs.writeFileSync(descriptor, text, 'utf8');\n    fs.closeSync(descriptor);\n    descriptor = null;\n    try {\n      fs.chmodSync(temp, fs.statSync(file).mode & 0o777);\n    } catch {\n      // No original to match: the default mode is right for a new file.\n    }\n    fs.renameSync(temp, file);\n    temporary = null;\n  } finally {\n    if (descriptor !== null) {\n      try { fs.closeSync(descriptor); } catch { /* The original write error is more useful. */ }\n    }\n    if (temporary !== null) {\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w27ef8e22cd/tree","terminal_exit":{"terminal_id":"34eda2","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
