{"toolCallId":"call_0d4a164ae2de4b9d8d99eda6ad2a6c26","status":"completed","content":[{"type":"content","content":{"type":"text","text":"{\n  \"name\": \"@spec-kit/cli\",\n  \"version\": \"1.7.2\",\n  \"description\": \"Continuity saves, spec-folder validation dispatch, packet metadata, retrieval tooling and cross-runtime mirrors for spec-kit\",\n  \"type\": \"module\",\n  \"main\": \"dist/continuity/generate-context.js\",\n  \"engines\": {\n    \"node\": \">=22.12.0\"\n  },\n  \"scripts\": {\n    \"clean\": \"node -e \\\"require('node:fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n    \"prepare-build\": \"node lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime/cli --entry default && node lib/dist-freshness.cjs prepare-build --package system-spec-kit/runtime/cli --entry is-phase-parent\",\n    \"build\": \"npm run prepare-build && tsc --build && npm run record-build\",\n    \"record-build\": \"node lib/dist-freshness.cjs record-build --package system-spec-kit/runtime/cli --entry default && node lib/dist-freshness.cjs record-build --package system-spec-kit/runtime/cli --entry is-phase-parent\",\n    \"rebuild\": \"npm run clean && npm run build\",\n    \"typecheck\": \"tsc --noEmit --composite false -p tsconfig.json\",\n    \"lint\": \"tsc --noEmit\",\n    \"pretest\": \"npm run build\",\n    \"test\": \"vitest run --config ../../vitest.config.ts --project cli && npm run test:legacy && npm run test:validation\",\n    \"test:task-enrichment\": \"vitest run tests/task-enrichment.vitest.ts --config ../vitest.config.ts --root .\",\n    \"test:legacy\": \"npm run build && node tests/test-scripts-modules.js && node tests/test-extractors-loaders.js && node tests/test-phase-validation.js && node tests/test-phase-system.js\",\n    \"test:validation\": \"node tests/test-validation-system.cjs && bash tests/test-validation.sh && bash tests/test-validation-extended.sh && bash tests/check-ac-closure.sh && bash tests/check-ac-coverage.sh && bash tests/check-graph-metadata-child-drift.sh && bash tests/check-graph-metadata-shape-last-active-child.sh && bash tests/test-phase-system.sh\",\n    \"check:ast\": \"npx tsx evals/check-no-mcp-lib-imports-ast.ts && npx tsx evals/check-handler-cycles-ast.ts\",\n    \"check\": \"npm run lint && npx tsx evals/check-no-mcp-lib-imports.ts && bash check-api-boundary.sh && npx tsx evals/check-architecture-boundaries.ts && npx tsx evals/check-allowlist-expiry.ts && npx tsx evals/check-source-dist-alignment.ts && npx tsx evals/check-no-mcp-lib-imports-ast.ts && npx tsx evals/check-handler-cycles-ast.ts\"\n  },\n  \"dependencies\": {\n    \"@spec-kit/runtime\": \"file:..\",\n    \"@spec-kit/shared\": \"file:../../shared\",\n    \"js-yaml\": \"^4.3.0\"\n  },\n  \"devDependencies\": {\n    \"tsx\": \"4.22.4\",\n    \"vitest\": \"^4.1.11\"\n  }\n}\n"}}],"_meta":{"cognition.ai/cwd":"/private/tmp/claude-501/-Users-michelkerkmeester-MEGA-Development-Code-Environment-Public/fcd93cd7-b3f2-45e6-b976-87fabe792df3/scratchpad/speed-loop/w4fbf614733/tree","terminal_exit":{"terminal_id":"67673f","exit_code":0,"signal":null},"cognition.ai/inferenceToolName":"exec"}}
