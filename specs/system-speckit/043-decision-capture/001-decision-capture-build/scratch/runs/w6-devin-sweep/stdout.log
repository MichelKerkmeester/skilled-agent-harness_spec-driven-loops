export function sweepDevinTranscript({ projectDir, transcriptPath, now }) reads and JSON.parses the file, session_id = transcript.session_id or the file name without .json, appends devinAnswerRecords via appendRecords(projectDir, session_id, records), and returns { transcript: transcriptPath, session_id, recovered: <appended count>, pending: pendingRecords(projectDir, session_id), chat_candidates: [] }.

CLI (only when executed directly): `node sweep-devin.mjs [--transcript <path>]`. projectDir = process.cwd(). Without --transcript: dataDir = path.join(process.env.XDG_DATA_HOME || path.join(os.homedir(), '.local', 'share'), 'devin', 'cli'); open path.join(dataDir, 'sessions.db') with `new DatabaseSync(file, { readOnly: true })` from 'node:sqlite'; SELECT id FROM sessions WHERE working_directory = ? ORDER BY last_activity_at DESC LIMIT 1 with projectDir; transcript = path.join(dataDir, 'transcripts', id + '.json'). Close the database. Print JSON.stringify(result, null, 2), exit 0. No session, missing file or any error: print {"error":"..."} to stdout, exit 1.
