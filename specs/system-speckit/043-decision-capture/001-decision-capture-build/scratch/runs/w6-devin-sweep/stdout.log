+// Option labels are what a record quotes; descriptions are context the question
+// already carries and would only bloat the queue.
+function optionLabels(options) {
+  if (!Array.isArray(options)) return [];
+  const labels = [];
+  for (const option of options) {
+    if (typeof option === 'string') labels.push(option);
+    else if (typeof option?.label === 'string') labels.push(option.label);
+  }
+  return labels;
+}
