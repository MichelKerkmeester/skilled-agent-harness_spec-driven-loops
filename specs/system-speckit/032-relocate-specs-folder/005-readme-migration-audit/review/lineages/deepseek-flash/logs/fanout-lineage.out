s.add(realPath);\n      deduped.push(dir);\n    }\n  }\n\n  return deduped;\n}\n\n/* ───────────────────────────────────────────────────────────────\n   7. EXPORTS\n------------------------------------------------------------------*/\n\nexport {\n  CONFIG,\n  getSpecsDirectories,\n  findActiveSpecsDir,\n  getAllExistingSpecsDirs,\n};\n","exit":0,"truncated":false},"title":"echo \"=== mcp-server includeSpecDocs default ===\"; rg -rn 'includeSpecDocs|specs' .opencode/skills/system-spec-kit/mcp-server/*.ts .opencode/skills/system-spec-kit/mcp-server/src/*.ts 2>/dev/null | grep -iE 'specs|includeSpecDocs' | head -8\necho \"\"\necho \"=== drift-marker-write.ts path handling ===\"; rg -n 'opencode/specs|specs' .opencode/skills/system-spec-kit/scripts/git-hooks/drift-marker-write.ts 2>/dev/null | head -6\necho \"\"\necho \"=== config.ts: where are the two roots actually consumed? ===\"; sed -n '350,372p' .opencode/skills/system-spec-kit/scripts/core/config.ts","time":{"start":1786125238156,"end":1786125238158}},"id":"prt_fdd5c3a2e001Eez6LjfQDF2vu0","sessionID":"ses_022ada93cffeiuPDQc9GVcDNCF","messageID":"msg_fdd5b735b001lp29fWZTEoBAXn"}}
