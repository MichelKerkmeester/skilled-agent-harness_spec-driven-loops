eckit/032-relocate-specs-folder/005-readme-migration-audit/review/lineages/glm-high//logs:\ntotal 0\ndrwxr-xr-x@ 3 michelkerkmeester  staff   96 Aug  7 19:43 .\ndrwxr-xr-x@ 5 michelkerkmeester  staff  160 Aug  7 19:43 ..\n-rw-r--r--@ 1 michelkerkmeester  staff    0 Aug  7 19:43 fanout-lineage.out\n","metadata":{"output":"total 8\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug  7 19:43 .\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug  7 19:43 ..\ndrwxr-xr-x@ 2 michelkerkmeester  staff   64 Aug  7 19:43 .executor-state\n-rw-r--r--@ 1 michelkerkmeester  staff  430 Aug  7 19:43 invocation-metadata.json\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/specs/system-speckit/032-relocate-specs-folder/005-readme-migration-audit/review/lineages/deepseek-flash//.executor-state:\ntotal 0\ndrwxr-xr-x@ 2 michelkerkmeester  staff   64 Aug  7 19:43 .\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug  7 19:43 ..\n---GLM---\ntotal 8\ndrwxr-xr-x@ 5 michelkerkmeester  staff  160 Aug  7 19:43 .\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug  7 19:43 ..\ndrwxr-xr-x@ 2 michelkerkmeester  staff   64 Aug  7 19:43 .executor-state\n-rw-r--r--@ 1 michelkerkmeester  staff  400 Aug  7 19:43 invocation-metadata.json\ndrwxr-xr-x@ 3 michelkerkmeester  staff   96 Aug  7 19:43 logs\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/specs/system-speckit/032-relocate-specs-folder/005-readme-migration-audit/review/lineages/glm-high//.executor-state:\ntotal 0\ndrwxr-xr-x@ 2 michelkerkmeester  staff   64 Aug  7 19:43 .\ndrwxr-xr-x@ 5 michelkerkmeester  staff  160 Aug  7 19:43 ..\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/specs/system-speckit/032-relocate-specs-folder/005-readme-migration-audit/review/lineages/glm-high//logs:\ntotal 0\ndrwxr-xr-x@ 3 michelkerkmeester  staff   96 Aug  7 19:43 .\ndrwxr-xr-x@ 5 michelkerkmeester  staff  160 Aug  7 19:43 ..\n-rw-r--r--@ 1 michelkerkmeester  staff    0 Aug  7 19:43 fanout-lineage.out\n","exit":