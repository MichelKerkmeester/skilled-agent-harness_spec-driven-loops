\n\n=== mcp-server scan scope ===\n109:**Default scan scope includes Spec Kit docs.** `memory_index_scan` defaults `includeConstitutional=true` for `.opencode/skills/*/constitutional/` and `includeSpecDocs=true` for `.opencode/specs/` documents, with `background:true` jobs polled by `memory_index_scan_status` and stopped by `memory_index_scan_cancel`.\n277:- [Orphan MCP leak prevention implementation summary](../../../specs/system-speckit/026-graph-and-context-optimization/003-memory-and-causal-runtime/003-embedder-testing-and-architecture/009-memory-leak-remediation/022-orphan-mcp-leak-prevention/implementation-summary.md)\n","metadata":{"output":"=== bin/README check-no-spec-imports ===\n4:// Durable guard: no runtime code may require or import from `.opencode/specs`.\n10:// under `.opencode/specs`, or embeds the compiled-routing spec-tree path in a\n26:const SPECS_ROOT = path.join(REPO_ROOT, '.opencode', 'specs');\n52:const COMPILED_ROUTING_SPEC_FRAGMENT = 'specs/sk-doc/019-skill-routing-refactor';\n80:  if (target.includes('.opencode/specs')) return true;\n101:          violations.push({ file, line: index + 1, target, reason: 'import/require resolves under .opencode/specs' });\n107:    if (line.includes(COMPILED_ROUTING_SPEC_FRAGMENT) || line.includes('.opencode/specs')) {\n108:      if (/\\b(require|import)\\b/.test(line) || /['\"][^'\"]*specs\\/sk-doc\\/019-skill-routing-refactor/.test(line)) {\n\n=== bin/lib compiled-routing source under .opencode/specs? ===\nzsh:3: no matches found: .opencode/bin/lib/*.js\n\n=== git-hooks drift-marker actual ===\n16:  diff_output=\"$(git diff-tree --no-commit-id -r -M --name-status \"$@\" -- .opencode/specs 2>/dev/null || true)\"\n\n=== mcp-server scan scope ===\n109:**Default scan scope includes Spec Kit docs.** `memory_index_scan` defaults `includeConstitutional=true` for `.opencode/skills/*/constitutional/` and `includeSpecDocs=true` for `.opencode/specs/` documents, with `background:true` jobs polled by `memory_index_scan_status` and stopped by `memory_index_scan_cancel`.\n277:- [Orphan MCP leak prevention implementation summary](../../../specs/system-speckit/026-graph-and-context-optimization/003-memory-and-causal-runtime/003-embedder-testing-and-architecture/009-memory-leak-remediation/022-orphan-mcp-leak-prevention/implementation-summary.md)\n","exit":0,"truncated":false},"title":"echo \"=== bin/README check-no-spec-imports ===\"; rg -n 'opencode/specs|specs' .opencode/bin/check-no-spec-imports.cjs 2>/dev/null | head -8\necho \"\"\necho \"=== bin/lib compiled-routing source under .opencode/specs? ===\"; rg -rn 'opencode/specs' .opencode/bin/lib/*.cjs .opencode/bin/lib/*.js 2>/dev/null | head -6\necho \"\"\necho \"=== git-hooks drift-marker actual ===\"; rg -n 'opencode/specs|specs' .opencode/scripts/git-hooks/lib/memory-drift-marker.sh 2>/dev/null | head -8\necho \"\"\necho \"=== mcp-server scan scope ===\"; rg -n 'opencode/specs|includeSpecDocs|specs' .opencode/skills/system-spec-kit/mcp-server/README.md | head -12","time":{"start":1786125077077,"end":1786125077081}},"id":"prt_fdd59c489001NvURKgGdONSCLU","sessionID":"ses_022ada93cffeiuPDQc9GVcDNCF","messageID":"msg_fdd597058001di9pC1WXNeTqQz"}}
