 \"Shared shell utilities (colors, logging, result tracking)\"\n      },\n      {\n        \"name\": \"git-branch\",\n        \"path\": \"runtime/cli/lib/git-branch.sh\",\n        \"description\": \"Git branch utilities\"\n      },\n      {\n        \"name\": \"template-utils\",\n        \"path\": \"runtime/cli/lib/template-utils.sh\",\n        \"description\": \"Template processing helpers\"\n      }\n    ],\n    \"javascript\": [\n      {\n        \"name\": \"embeddings\",\n        \"path\": \"runtime/cli/dist/lib/embeddings.js\",\n        \"description\": \"Re-exports from ../../shared/embeddings\"\n      },\n      {\n        \"name\": \"trigger-extractor\",\n        \"path\": \"runtime/cli/dist/lib/trigger-extractor.js\",\n        \"description\": \"Re-exports from ../../shared/trigger-extractor\"\n      },\n      {\n        \"name\": \"semantic-summarizer\",\n        \"path\": \"runtime/cli/dist/lib/semantic-summarizer.js\",\n        \"description\": \"Message classification\"\n      },\n      {\n        \"name\": \"content-filter\",\n        \"path\": \"runtime/cli/dist/lib/content-filter.js\",\n        \"description\": \"Three-stage content filtering\"\n      },\n      {\n        \"name\": \"anchor-generator\",\n        \"path\": \"runtime/cli/dist/lib/anchor-generator.js\",\n        \"description\": \"ANCHOR ID generation\"\n      },\n      {\n        \"name\": \"flowchart-generator\",\n        \"path\": \"runtime/cli/dist/lib/flowchart-generator.js\",\n        \"description\": \"ASCII flowcharts\"\n      },\n      {\n        \"name\": \"ascii-boxes\",\n        \"path\": \"runtime/cli/dist/lib/ascii-boxes.js\",\n        \"description\": \"ASCII box drawing\"\n      },\n      {\n        \"name\": \"simulation-factory\",\n        \"path\": \"runtime/cli/dist/lib/simulation-factory.js\",\n        \"description\": \"Fallback data generation\"\n      }\n    ]\n  },\n  \"metadata\": {\n    \"totalScripts\": 13,\n    \"essentialScripts\": 7,\n    \"optionalScripts\