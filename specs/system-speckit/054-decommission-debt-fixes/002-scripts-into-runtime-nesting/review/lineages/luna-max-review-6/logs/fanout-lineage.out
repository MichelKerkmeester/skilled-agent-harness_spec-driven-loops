":\"traceability:generated-metadata-and-completion-attestation\",\"dimensions\":[\"traceability\",\"correctness\"],\"filesReviewed\":[\"description.json\",\"graph-metadata.json\",\"acceptance-criteria.md\",\"implementation-summary.md\",\"spec.md\",\".opencode/skills/system-spec-kit/runtime/cli/validation/continuity-freshness.ts\",\".opencode/skills/system-spec-kit/runtime/cli/core/memory-metadata.ts\",\".opencode/skills/system-spec-kit/runtime/cli/tests/continuity-freshness.vitest.ts\",\".opencode/skills/system-spec-kit/runtime/cli/validation/generated-metadata-drift.ts\",\".opencode/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts\"],\"findingsCount\":17,\"findingsSummary\":{\"P0\":0,\"P1\":9,\"P2\":8},\"findingsNew\":{\"P0\":0,\"P1\":1,\"P2\":0},\"findingDetails\":[{\"id\":\"F017\",\"severity\":\"P1\",\"title\":\"Completion claims carry the zero fingerprint that the freshness rule explicitly skips\",\"dimension\":\"traceability\",\"file\":\"acceptance-criteria.md:23-28\",\"evidence\":\"Packet declares completion_pct 100 and closeable state while storing the zero session_dedup fingerprint; continuity freshness treats zero as a passing skip.\",\"recommendation\":\"Refresh the completion fingerprint through the canonical save path or record an explicit waiver for the grandfathered attestation state.\",\"disposition\":\"active\",\"findingClass\":\"matrix/evidence\",\"scopeProof\":\"Direct comparison of acceptance and summary continuity metadata, freshness implementation and zero-fingerprint regression test.\",\"affectedSurfaceHints\":[\"completion attestation\",\"session_dedup fingerprint\",\"freshness gate\"],\"content_hash\":\"review6-f017-zero-fingerprint\"}],\"traceabilityChecks\":{\"summary\":{\"required\":2,\"executed\":4,\"pass\":1,\"partial\":1,\"fail\":2,\"blocked\":0,\"notApplicable\":0,\"gatingFailures\":2},\"results\":[{\"protocolId\":\"spec_code\",\"status\":\"fail\",\"gateClass\":\"hard\",\"applicable\":true,\"findingRefs\":[\"F005\",\"F017\"]},{\"protocolId\":\"checklist_evidence\",\"status... (line truncated to 2000 chars)","lineStart":1,"lineEnd":22,"totalLines":22,"truncated":false}},"title":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/review/lineages/luna-max-review-6/deep-review-state.jsonl","time":{"start":1788633098979,"end":1788633098985}},"id":"prt_072d729ac001b7kvZIyeA5g1Ry","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072d6e9a6001S6g0NfWPLLNgYj"}}
