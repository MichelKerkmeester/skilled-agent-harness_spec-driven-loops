{"type":"tool_use","timestamp":1788632180351,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_msXU5WQcMqWmoAiu9SBnDy5s","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs","offset":1,"limit":500},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: \n3: // ╔══════════════════════════════════════════════════════════════════════════╗\n4: // ║ Deep-Loop Runtime — Mode Event Append CLI                                ║\n5: // ╠══════════════════════════════════════════════════════════════════════════╣\n6: // ║ Input:  CLI args (--mode, --run-directory, --event-json).                ║\n7: // ║ Output: JSON to stdout.                                                  ║\n8: // ║ Exit:   0=success, 1=script error, 2=append failed.                      ║\n9: // ╚══════════════════════════════════════════════════════════════════════════╝\n10: \n11: 'use strict';\n12: \n13: // ─────────────────────────────────────────────────────────────────────────────\n14: // 1. TSX BOOTSTRAP\n15: // ─────────────────────────────────────────────────────────────────────────────\n16: \n17: const TSX_LOADER = require.resolve('tsx');\n18: const isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n19: \n20: function runTsxBootstrap() {\n21:   const { spawn } = require('node:child_process');\n22:   const child = spawn(\n23:     process.execPath,\n24:     ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n25:     {\n26:       cwd: process.cwd(),\n27:       env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n28:       stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n29:     },\n30:   );\n31: \n32:   if (!process.stdin.isTTY && child.stdin) {\n33:     child.stdin.on('error', () => {});\n34:     process.stdin.pipe(child.stdin);\n35:   }\n36: \n37:   child.stdout?.pipe(process.stdout);\n38:   child.stderr?.pipe(process.stderr);\n39: \n40:   for (const signal of ['SIGINT', 'SIGTERM']) {\n41:     process.once(signal, () => {\n42:       child.kill(signal);\n43:     });\n44:   }\n45: \n46:   child.on('close', (status, signal) => {\n47:     if (status !== null) {\n48:       process.exit(status);\n49:     }\n50:     process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n51:   });\n52: }\n53: \n54: if (require.main === module && !isTsxLoaded) {\n55:   runTsxBootstrap();\n56: }\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 2. MAIN IMPLEMENTATION (under tsx)\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: function parseArgs(argv = process.argv.slice(2)) {\n63:   const args = {};\n64:   for (let i = 0; i < argv.length; i += 1) {\n65:     const token = argv[i];\n66:     if (!token.startsWith('--')) {\n67:       throw new Error(`Unexpected positional argument: ${token}`);\n68:     }\n69:     const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n70:     const next = argv[i + 1];\n71:     if (next === undefined || next.startsWith('--')) {\n72:       args[key] = true;\n73:     } else {\n74:       args[key] = next;\n75:       i += 1;\n76:     }\n77:   }\n78:   return args;\n79: }\n80: \n81: function requireString(args, ...keys) {\n82:   for (const key of keys) {\n83:     if (args[key] && typeof args[key] === 'string') {\n84:       return args[key];\n85:     }\n86:   }\n87:   throw new Error(`${keys[0]} is required`);\n88: }\n89: \n90: function jsonOut(payload) {\n91:   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n92: }\n93: \n94: function normalizeMode(mode) {\n95:   if (!mode || typeof mode !== 'string') return '';\n96:   const trimmed = mode.trim();\n97:   if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n98:   if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n99:   if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n100:   if (trimmed === 'agent-improvement' || trimmed === 'deep-agent-improvement') return 'agent-improvement';\n101:   if (trimmed === 'model-benchmark' || trimmed === 'deep-model-benchmark') return 'model-benchmark';\n102:   if (trimmed === 'skill-benchmark' || trimmed === 'deep-skill-benchmark') return 'skill-benchmark';\n103:   // The authority order is the canonical spelling; a private alias that\n104:   // disagrees with it makes a real fleet mode unreachable.\n105:   if (trimmed === 'improvement' || trimmed === 'deep-improvement' || trimmed === 'deep-improvement-common') return 'deep-improvement-common';\n106:   return trimmed;\n107: }\n108: \n109: async function resolveModeAdapter(mode) {\n110:   const normalized = normalizeMode(mode);\n111:   switch (normalized) {\n112:     case 'deep-research': {\n113:       const mod = await import('../lib/deep-research-ledger-schema/index.ts');\n114:       return {\n115:         normalizedMode: 'deep-research',\n116:         createRegistry: mod.createDeepResearchEventRegistry,\n117:         prepareEvent: mod.prepareDeepResearchEvent,\n118:         isEventStem: mod.isDeepResearchEventStem,\n119:       };\n120:     }\n121:     case 'deep-review': {\n122:       const mod = await import('../lib/deep-review-ledger-schema/index.ts');\n123:       return {\n124:         normalizedMode: 'deep-review',\n125:         createRegistry: mod.createDeepReviewEventRegistry,\n126:         prepareEvent: mod.prepareDeepReviewEvent,\n127:         isEventStem: mod.isDeepReviewEventStem,\n128:       };\n129:     }\n130:     case 'deep-ai-council': {\n131:       const mod = await import('../lib/deep-ai-council-ledger-schema/index.ts');\n132:       return {\n133:         normalizedMode: 'deep-ai-council',\n134:         createRegistry: mod.createDeepAiCouncilEventRegistry,\n135:         prepareEvent: mod.prepareDeepAiCouncilEvent,\n136:         isEventStem: mod.isDeepAiCouncilEventStem,\n137:       };\n138:     }\n139:     case 'agent-improvement': {\n140:       const mod = await import('../lib/agent-improvement-ledger-schema/index.ts');\n141:       return {\n142:         normalizedMode: 'agent-improvement',\n143:         createRegistry: mod.createAgentImprovementEventRegistry,\n144:         prepareEvent: mod.prepareAgentImprovementEvent,\n145:         isEventStem: mod.isAgentImprovementEventStem,\n146:       };\n147:     }\n148:     case 'model-benchmark': {\n149:       const mod = await import('../lib/model-benchmark-ledger-schema/index.ts');\n150:       return {\n151:         normalizedMode: 'model-benchmark',\n152:         createRegistry: mod.createModelBenchmarkEventRegistry,\n153:         prepareEvent: mod.prepareModelBenchmarkEvent,\n154:         isEventStem: mod.isModelBenchmarkEventStem,\n155:       };\n156:     }\n157:     case 'skill-benchmark': {\n158:       const mod = await import('../lib/skill-benchmark-ledger-schema/index.ts');\n159:       return {\n160:         normalizedMode: 'skill-benchmark',\n161:         createRegistry: mod.createSkillBenchmarkEventRegistry,\n162:         prepareEvent: mod.prepareSkillBenchmarkEvent,\n163:         isEventStem: mod.isSkillBenchmarkEventStem,\n164:       };\n165:     }\n166:     case 'deep-improvement-common': {\n167:       const mod = await import('../lib/deep-improvement-common-ledger-schema/index.ts');\n168:       return {\n169:         normalizedMode: 'deep-improvement-common',\n170:         createRegistry: mod.createDeepImprovementCommonEventRegistry,\n171:         prepareEvent: mod.prepareDeepImprovementCommonEvent,\n172:         isEventStem: mod.isDeepImprovementCommonEventStem,\n173:       };\n174:     }\n175:     default:\n176:       throw new Error(`Unsupported mode: ${mode}`);\n177:   }\n178: }\n179: \n180: async function main() {\n181:   const fs = require('node:fs');\n182:   const crypto = require('node:crypto');\n183: \n184:   const args = parseArgs();\n185: \n186:   const modeRaw = requireString(args, 'mode');\n187:   const runDirectory = requireString(args, 'runDirectory', 'runDir', 'specFolder');\n188:   const eventJsonPath = requireString(args, 'eventJson', 'eventJsonPath');\n189: \n190:   let rawEvent;\n191:   try {\n192:     const raw = fs.readFileSync(eventJsonPath, 'utf8');\n193:     rawEvent = JSON.parse(raw);\n194:   } catch (error) {\n195:     jsonOut({\n196:       ok: false,\n197:       phase: 'input',\n198:       reason: `Failed to read event JSON: ${error.message}`,\n199:       code: 'INPUT_ERROR',\n200:     });\n201:     process.exit(1);\n202:   }\n203: \n204:   const { appendModeEvent } = await import('../lib/mode-append-gateway/index.ts');\n205:   const {\n206:     AppendOnlyLedger,\n207:     TransitionAuthorizationGateway,\n208:     TransitionPolicyRegistry,\n209:     AuthorizationVerdicts,\n210:     AuthorizationReasonCodes,\n211:   } = await import('../lib/authorized-ledger/index.ts');\n212:   const { prepareEventWrite } = await import('../lib/event-envelope/index.ts');\n213:   const { resolveCutoverBinding } = await import('../lib/cutover-binding/index.ts');\n214:   const { resolveAuthorityRoot } = await import('../lib/authority-root/index.ts');\n215:   const { admitCanonicalWrite } = await import('../lib/deep-research-authority/index.ts');\n216:   const { AUTHORITY_FLIP_MODE_ORDER } = await import('../lib/per-mode-authority-flip/index.ts');\n217:   const { upcastLegacyDeepResearchRecord } = await import('../lib/deep-research-ledger-schema/index.ts');\n218: \n219:   const adapter = await resolveModeAdapter(modeRaw);\n220:   const normalizedMode = adapter.normalizedMode;\n221:   const registry = adapter.createRegistry();\n222: \n223:   // Read the durable authority record before anything is constructed. A CLI\n224:   // that asserts its own authority is exactly the private write path the\n225:   // gateway exists to remove, so a refusal here must happen before a ledger,\n226:   // a policy registry, or a run directory is touched.\n227:   const authorityRoot = resolveAuthorityRoot();\n228:   // A mode outside the frozen flip order has no authority record to read, and\n229:   // the selector reports that as a malformed record. Naming the real cause here\n230:   // keeps an operator from hunting a corrupt file that does not exist.\n231:   if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n232:     jsonOut({\n233:       ok: false,\n234:       phase: 'authority',\n235:       reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n236:       code: 'AUTHORITY_DENIED',\n237:     });\n238:     process.exit(2);\n239:   }\n240:   let admission;\n241:   try {\n242:     admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n243:   } catch (error) {\n244:     jsonOut({\n245:       ok: false,\n246:       phase: 'authority',\n247:       reason: error instanceof Error ? error.message : String(error),\n248:       code: 'AUTHORITY_DENIED',\n249:     });\n250:     process.exit(2);\n251:   }\n252:   if (admission.outcome === 'denied') {\n253:     jsonOut({\n254:       ok: false,\n255:       phase: 'authority',\n256:       reason: `Authority admission denied: ${admission.reasonCode}`,\n257:       code: 'AUTHORITY_DENIED',\n258:     });\n259:     process.exit(2);\n260:   }\n261:   if (admission.admissionOpen === false) {\n262:     jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n263:     process.exit(2);\n264:   }\n265:   const authority = { state: admission.state, epoch: admission.epoch };\n266:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n267:   const policyVersion = 1;\n268:   const ruleId = 'mode-event-append';\n269: \n270:   const policyRegistry = new TransitionPolicyRegistry([{\n271:     policyId,\n272:     policyVersion,\n273:     evaluatorVersion: '1',\n274:     ruleIds: [ruleId],\n275:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n276:     evaluate: () => ({\n277:       verdict: AuthorizationVerdicts.ALLOW,\n278:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n279:       matchedRuleIds: [ruleId],\n280:     }),\n281:   }]);\n282: \n283:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n284: \n285:   const ledgerId = `${normalizedMode}-ledger`;\n286:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n287: \n288:   const ledger = new AppendOnlyLedger({\n289:     rootDirectory: runDirectory,\n290:     ledgerId,\n291:     auditLedgerId,\n292:     authorityProvider: () => authority,\n293:   }, registry);\n294: \n295:   const authorizationGateway = new TransitionAuthorizationGateway({\n296:     rootDirectory: runDirectory,\n297:     auditLedgerId,\n298:     authorityProvider: () => authority,\n299:     identityResolver: (context) => ({\n300:       actorId: context.evaluationInput.actorId,\n301:       capabilityId: context.evaluationInput.capabilityId,\n302:       evidenceDigest: context.evaluationInput.evidenceDigest,\n303:     }),\n304:   }, ledger, policyRegistry);\n305: \n306:   let binding;\n307:   try {\n308:     binding = resolveCutoverBinding({\n309:       mode: normalizedMode,\n310:       repositoryRoot: runDirectory,\n311:     });\n312:   } catch (primaryError) {\n313:     try {\n314:       binding = resolveCutoverBinding({\n315:         mode: normalizedMode,\n316:         repositoryRoot: process.cwd(),\n317:       });\n318:     } catch (fallbackError) {\n319:       // An unattributable flip is worse than a blocked one: fabricating a\n320:       // zero-SHA identity here would let the ledger carry a transition\n321:       // nobody can be held to. Refuse instead of defaulting.\n322:       const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n323:       const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n324:       jsonOut({\n325:         ok: false,\n326:         phase: 'binding',\n327:         reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n328:         code: 'BINDING_FAILED',\n329:       });\n330:       process.exit(2);\n331:     }\n332:   }\n333: \n334:   const currentHead = await ledger.getVerifiedHead();\n335:   const nowIso = new Date().toISOString();\n336: \n337:   // Shared builder for the envelope-metadata + payload-core input that\n338:   // adapter.prepareEvent consumes. Both the explicit-stem path and the legacy\n339:   // upcast path funnel through here so the envelope shape is defined once.\n340:   function buildPreparedInput(core, meta) {\n341:     return {\n342:       stem: core.stem,\n343:       scope: core.scope,\n344:       data: core.data,\n345:       prevEventHash: core.prevEventHash,\n346:       replay: core.replay,\n347:       eventId: meta.eventId || meta.event_id || `event-${crypto.randomUUID()}`,\n348:       streamId: meta.streamId || meta.stream_id || ledgerId,\n349:       streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n350:       occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n351:       recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n352:       producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n353:       authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n354:       correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n355:       causationId: meta.causationId !== undefined\n356:         ? meta.causationId\n357:         : (meta.causation_id !== undefined ? meta.causation_id : null),\n358:       idempotencyKey: meta.idempotencyKey || meta.idempotency_key || crypto.randomUUID(),\n359:     };\n360:   }\n361: \n362:   const defaultReplay = {\n363:     fingerprint_version: 1,\n364:     final_digest: '0'.repeat(64),\n365:     replay_input_digests: {},\n366:   };\n367: \n368:   let eventRecord;\n369:   let legacyWarnings;\n370:   if (\n371:     rawEvent\n372:     && typeof rawEvent === 'object'\n373:     && rawEvent.canonicalDigest\n374:     && rawEvent.canonicalBytes\n375:     && rawEvent.identity\n376:     && rawEvent.envelope\n377:   ) {\n378:     eventRecord = rawEvent;\n379:   } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n380:     const preparedInput = buildPreparedInput({\n381:       stem: rawEvent.stem,\n382:       scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n383:       data: rawEvent.data || {},\n384:       prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n385:       replay: rawEvent.replay || defaultReplay,\n386:     }, rawEvent);\n387:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n388:   } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n389:     const envelope = {\n390:       envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n391:       event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n392:       event_type: rawEvent.event_type || rawEvent.eventType,\n393:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n394:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n395:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n396:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n397:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n398:       producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n399:       authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n400:       correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n401:       causation_id: rawEvent.causation_id !== undefined\n402:         ? rawEvent.causation_id\n403:         : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n404:       idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || crypto.randomUUID(),\n405:       payload: rawEvent.payload || {},\n406:     };\n407:     eventRecord = prepareEventWrite(envelope, registry);\n408:   } else if (\n409:     normalizedMode === 'deep-research'\n410:     && rawEvent\n411:     && typeof rawEvent === 'object'\n412:   ) {\n413:     // Legacy deep-research rows predate the canonical envelope and carry no\n414:     // stem or event_type the current registry recognizes. This branch is tried\n415:     // last so canonical envelopes and explicit stem/event_type rows keep their\n416:     // fast paths untouched; only rows that would otherwise hit the final throw\n417:     // reach the upcaster. Non-research modes never enter here, so they keep\n418:     // the original unrecognized-format rejection.\n419:     const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n420:     const legacyLineageId = rawEvent.lineageId\n421:       || rawEvent.parentSessionId\n422:       || rawEvent.sessionId\n423:       || 'lineage-cli';\n424:     const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n425:     const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n426:     if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n427:       legacyScope.iteration = legacyIteration;\n428:     }\n429:     const legacyContext = {\n430:       sc