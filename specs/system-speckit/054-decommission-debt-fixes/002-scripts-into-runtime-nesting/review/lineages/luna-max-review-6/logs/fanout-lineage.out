{"type":"tool_use","timestamp":1788632346795,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_fAGrzaQqTjEiHO4tAcWnQbwf","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts","offset":1,"limit":500},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep Review Reducer\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import {\n6:   DeepReviewEventStems,\n7:   DeepReviewWireEventTypes,\n8:   createDeepReviewEventRegistry,\n9:   isDeepReviewEventStem,\n10: } from '../deep-review-ledger-schema/index.js';\n11: import {\n12:   canonicalBytes,\n13:   canonicalJson,\n14:   readEvent,\n15:   sha256Bytes,\n16: } from '../event-envelope/index.js';\n17: import {\n18:   DeepReviewReducerError,\n19:   assertDeepReviewLegacyProjection,\n20:   assertDeepReviewProjectionState,\n21:   immutableProjectionClone,\n22:   isDeepFrozenProjection,\n23: } from './deep-review-projection-schema.js';\n24: \n25: import type { VerifiedLedgerEvent } from '../authorized-ledger/index.js';\n26: import type {\n27:   DeepReviewEventEnvelope,\n28:   DeepReviewEventStem,\n29:   DeepReviewLedgerEvent,\n30:   DeepReviewLedgerPayload,\n31: } from '../deep-review-ledger-schema/index.js';\n32: import type { JsonObject } from '../event-envelope/index.js';\n33: import type {\n34:   ModeContract,\n35:   ModeReducerSet,\n36:   ModeReductionResult,\n37: } from '../mode-contracts/index.js';\n38: import type {\n39:   DeepReviewArtifactRecord,\n40:   DeepReviewConvergenceEvaluation,\n41:   DeepReviewEvidenceRecord,\n42:   DeepReviewFindingProjection,\n43:   DeepReviewFindingRecord,\n44:   DeepReviewFoldOptions,\n45:   DeepReviewFoldResult,\n46:   DeepReviewIterationConvergenceProjection,\n47:   DeepReviewLegacyProjection,\n48:   DeepReviewModeStatus,\n49:   DeepReviewPersistedField,\n50:   DeepReviewProjectedResult,\n51:   DeepReviewProjectionCheckpoint,\n52:   DeepReviewProjectionFieldOwnership,\n53:   DeepReviewProjectionState,\n54:   DeepReviewRebuildReasonCode,\n55:   DeepReviewSeenEvent,\n56:   DeepReviewStatusProjection,\n57:   DeepReviewStatusTransition,\n58:   SharedReviewLoopBackboneInput,\n59:   SharedReviewLoopBackboneResult,\n60:   SharedReviewLoopModeConfiguration,\n61: } from './deep-review-projection-types.js';\n62: \n63: // ───────────────────────────────────────────────────────────────────\n64: // 1. PUBLIC CONTRACT CONSTANTS\n65: // ───────────────────────────────────────────────────────────────────\n66: \n67: export const DEEP_REVIEW_PROJECTION_SCHEMA_VERSION = 'deep-review-projection@1' as const;\n68: export const DEEP_REVIEW_REDUCER_VERSION = 'deep-review-reducer@1' as const;\n69: export const DEEP_REVIEW_PROJECTION_CODEC_VERSION = 'canonical-json@1' as const;\n70: export const DEEP_REVIEW_ORDERING_POLICY_VERSION = 'causal-input-order@1' as const;\n71: export const DEEP_REVIEW_REDUCER_ID = 'deep-review:projection-fold' as const;\n72: \n73: export const DEEP_REVIEW_SHARED_REVIEW_LOOP_CONFIGURATION: SharedReviewLoopModeConfiguration =\n74:   Object.freeze({\n75:     mode: 'review',\n76:     requiredCoveragePolicy: 'all-required-cells',\n77:     hardVetoClasses: Object.freeze(['build', 'regression', 'schema', 'security']),\n78:     terminalDecisionPolicy: 'typed-transition-only',\n79:   });\n80: \n81: const eventRegistry = createDeepReviewEventRegistry();\n82: const EMPTY_DIGEST = sha256Bytes(canonicalBytes([]));\n83: const HARD_VETO_CLASS_SEPARATORS = '-._:/@';\n84: type DeepReviewModeContractState = DeepReviewProjectionState & JsonObject;\n85: \n86: const PERSISTED_FIELDS = Object.freeze([\n87:   'schemaVersion',\n88:   'reducerVersion',\n89:   'codecVersion',\n90:   'orderingPolicyVersion',\n91:   'run',\n92:   'reviewLoop',\n93:   'findingLedger',\n94:   'artifactIndex',\n95:   'status',\n96:   'cursors',\n97:   'seenEvents',\n98: ] as const satisfies readonly DeepReviewPersistedField[]);\n99: \n100: type ProjectionPlane = 'reviewLoop' | 'findings' | 'artifactIndex' | 'status';\n101: \n102: export const DEEP_REVIEW_EVENT_ROUTING = Object.freeze({\n103:   'deep_review.run_initialized': Object.freeze(['reviewLoop', 'status']),\n104:   'deep_review.run_resumed': Object.freeze(['status']),\n105:   'deep_review.run_restarted': Object.freeze(['status']),\n106:   'deep_review.scope_resolved': Object.freeze(['reviewLoop', 'status']),\n107:   'deep_review.dimension_ordered': Object.freeze(['reviewLoop', 'status']),\n108:   'deep_review.protocol_plan_recorded': Object.freeze(['reviewLoop', 'status']),\n109:   'deep_review.dimension_pass_started': Object.freeze(['reviewLoop', 'status']),\n110:   'deep_review.dimension_pass_completed': Object.freeze(['reviewLoop', 'status']),\n111:   'deep_review.finding_candidate_emitted': Object.freeze([\n112:     'findings', 'artifactIndex', 'status',\n113:   ]),\n114:   'deep_review.evidence_observed': Object.freeze([\n115:     'findings', 'artifactIndex', 'status',\n116:   ]),\n117:   'deep_review.evidence_reconciled': Object.freeze([\n118:     'findings', 'artifactIndex', 'status',\n119:   ]),\n120:   'deep_review.claim_adjudication_recorded': Object.freeze([\n121:     'findings', 'artifactIndex', 'status',\n122:   ]),\n123:   'deep_review.finding_lineage_recorded': Object.freeze(['findings', 'status']),\n124:   'deep_review.finding_state_changed': Object.freeze(['findings', 'status']),\n125:   'deep_review.review_depth_recorded': Object.freeze(['reviewLoop', 'status']),\n126:   'deep_review.convergence_evaluated': Object.freeze(['reviewLoop', 'status']),\n127:   'deep_review.graph_convergence_evaluated': Object.freeze(['reviewLoop', 'status']),\n128:   'deep_review.blocked_stop_recorded': Object.freeze(['reviewLoop', 'status']),\n129:   'deep_review.pause_recorded': Object.freeze(['reviewLoop', 'status']),\n130:   'deep_review.recovery_started': Object.freeze(['reviewLoop', 'status']),\n131:   'deep_review.synthesis_started': Object.freeze(['reviewLoop', 'status']),\n132:   'deep_review.review_report_committed': Object.freeze(['artifactIndex', 'status']),\n133:   'deep_review.continuity_save_requested': Object.freeze(['artifactIndex']),\n134:   'deep_review.continuity_save_completed': Object.freeze(['artifactIndex']),\n135:   'deep_review.continuity_save_failed': Object.freeze(['artifactIndex', 'status']),\n136:   'deep_review.run_completed': Object.freeze(['reviewLoop', 'status']),\n137: } as const satisfies Readonly<Record<DeepReviewEventStem, readonly ProjectionPlane[]>>);\n138: \n139: function stemsForPlane(plane: ProjectionPlane): readonly DeepReviewEventStem[] {\n140:   return Object.freeze(DeepReviewEventStems.filter((stem) => (\n141:     DEEP_REVIEW_EVENT_ROUTING[stem].includes(plane as never)\n142:   )));\n143: }\n144: \n145: export const DEEP_REVIEW_PROJECTION_FIELD_OWNERSHIP = Object.freeze([\n146:   {\n147:     field: 'schemaVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n148:     inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n149:   },\n150:   {\n151:     field: 'reducerVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n152:     inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n153:   },\n154:   {\n155:     field: 'codecVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n156:     inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n157:   },\n158:   {\n159:     field: 'orderingPolicyVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n160:     inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n161:   },\n162:   {\n163:     field: 'run', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n164:     inputStems: stemsForPlane('reviewLoop'), foldAlgebra: 'insert-sorted-and-derive',\n165:     immutableOutput: true,\n166:   },\n167:   {\n168:     field: 'reviewLoop', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n169:     inputStems: stemsForPlane('reviewLoop'), foldAlgebra: 'insert-sorted-and-derive',\n170:     immutableOutput: true,\n171:   },\n172:   {\n173:     field: 'findingLedger', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n174:     inputStems: stemsForPlane('findings'), foldAlgebra: 'insert-sorted-and-derive',\n175:     immutableOutput: true,\n176:   },\n177:   {\n178:     field: 'artifactIndex', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n179:     inputStems: stemsForPlane('artifactIndex'), foldAlgebra: 'insert-sorted-and-derive',\n180:     immutableOutput: true,\n181:   },\n182:   {\n183:     field: 'status', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n184:     inputStems: stemsForPlane('status'), foldAlgebra: 'insert-sorted-and-derive',\n185:     immutableOutput: true,\n186:   },\n187:   {\n188:     field: 'cursors', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n189:     inputStems: DeepReviewEventStems, foldAlgebra: 'insert-sorted-and-derive',\n190:     immutableOutput: true,\n191:   },\n192:   {\n193:     field: 'seenEvents', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n194:     inputStems: DeepReviewEventStems, foldAlgebra: 'insert-sorted', immutableOutput: true,\n195:   },\n196: ] as const satisfies readonly DeepReviewProjectionFieldOwnership[]);\n197: \n198: export const DEEP_REVIEW_REDUCER_SET: ModeReducerSet<DeepReviewModeContractState> =\n199:   Object.freeze({\n200:     persistedFields: PERSISTED_FIELDS,\n201:     definitions: Object.freeze([Object.freeze({\n202:       reducerId: DEEP_REVIEW_REDUCER_ID,\n203:       reducerVersion: DEEP_REVIEW_REDUCER_VERSION,\n204:       stateVersion: DEEP_REVIEW_PROJECTION_SCHEMA_VERSION,\n205:       ownedFields: PERSISTED_FIELDS,\n206:       inputEventTypes: Object.freeze(\n207:         DeepReviewEventStems.map((stem) => DeepReviewWireEventTypes[stem]),\n208:       ),\n209:       replaySource: 'verified-ledger-events-only',\n210:       outputRule: 'immutable',\n211:     })]),\n212:   });\n213: \n214: // ───────────────────────────────────────────────────────────────────\n215: // 2. GENERAL HELPERS\n216: // ───────────────────────────────────────────────────────────────────\n217: \n218: function compareString(left: string, right: string): number {\n219:   return left < right ? -1 : left > right ? 1 : 0;\n220: }\n221: \n222: function compareNumber(left: number, right: number): number {\n223:   return left < right ? -1 : left > right ? 1 : 0;\n224: }\n225: \n226: function sortStrings(values: readonly string[]): string[] {\n227:   return [...new Set(values)].sort(compareString);\n228: }\n229: \n230: function sameCanonical(left: unknown, right: unknown): boolean {\n231:   return canonicalJson(left) === canonicalJson(right);\n232: }\n233: \n234: function payloadFor<TStem extends DeepReviewEventStem>(\n235:   event: DeepReviewLedgerEvent,\n236:   stem: TStem,\n237: ): DeepReviewLedgerPayload<TStem> {\n238:   if (event.payload.stem !== stem) {\n239:     throw new DeepReviewReducerError(\n240:       'event-not-deep-review',\n241:       `Expected ${stem}, received ${event.payload.stem}`,\n242:       'payload.stem',\n243:     );\n244:   }\n245:   return event.payload as DeepReviewLedgerPayload<TStem>;\n246: }\n247: \n248: function assertNeverStem(stem: never): never {\n249:   throw new DeepReviewReducerError(\n250:     'event-not-deep-review',\n251:     `Unhandled deep-review event stem: ${String(stem)}`,\n252:     'payload.stem',\n253:   );\n254: }\n255: \n256: function eventDigest(event: DeepReviewLedgerEvent): string {\n257:   return sha256Bytes(canonicalBytes(event));\n258: }\n259: \n260: interface CanonicalEventPosition {\n261:   readonly event_id: string;\n262:   readonly causal_position: number;\n263: }\n264: \n265: function compareEvents(left: CanonicalEventPosition, right: CanonicalEventPosition): number {\n266:   return compareNumber(left.causal_position, right.causal_position)\n267:     || compareString(left.event_id, right.event_id);\n268: }\n269: \n270: function producerEventPosition(\n271:   seenEvents: readonly DeepReviewSeenEvent[],\n272:   producerEventId: string,\n273: ): CanonicalEventPosition {\n274:   const causalPosition = seenEvents.findIndex((event) => event.eventId === producerEventId);\n275:   if (causalPosition === -1) {\n276:     throw new DeepReviewReducerError(\n277:       'referential-integrity',\n278:       'Temporal projection records require captured producer-event provenance',\n279:       'seenEvents',\n280:     );\n281:   }\n282:   return {\n283:     event_id: producerEventId,\n284:     causal_position: causalPosition,\n285:   };\n286: }\n287: \n288: function compareProducerEvents(\n289:   seenEvents: readonly DeepReviewSeenEvent[],\n290:   leftEventId: string,\n291:   rightEventId: string,\n292: ): number {\n293:   return compareEvents(\n294:     producerEventPosition(seenEvents, leftEventId),\n295:     producerEventPosition(seenEvents, rightEventId),\n296:   );\n297: }\n298: \n299: function establishedRunStreamId(\n300:   run: DeepReviewProjectionState['run'],\n301:   seenEvents: readonly DeepReviewSeenEvent[],\n302: ): string {\n303:   const initialized = run.initializationEventId === null\n304:     ? undefined\n305:     : seenEvents.find((event) => event.eventId === run.initializationEventId);\n306:   if (initialized === undefined || initialized.stem !== 'deep_review.run_initialized') {\n307:     throw new DeepReviewReducerError(\n308:       'referential-integrity',\n309:       'Run stream identity requires its captured initialization event',\n310:       'run.initializationEventId',\n311:     );\n312:   }\n313:   return initialized.streamId;\n314: }\n315: \n316: function validateTypedEvent(event: DeepReviewLedgerEvent): DeepReviewLedgerEvent {\n317:   try {\n318:     const read = readEvent(canonicalBytes(event), eventRegistry);\n319:     const effective = read.effective.envelope;\n320:     const payload = effective.payload;\n321:     if (!isDeepReviewEventStem(payload.stem)\n322:       || effective.event_type !== DeepReviewWireEventTypes[payload.stem]) {\n323:       throw new DeepReviewReducerError(\n324:         'event-not-deep-review',\n325:         'Verified event does not carry a registered deep-review stem',\n326:         'event_type',\n327:       );\n328:     }\n329:     return effective as DeepReviewLedgerEvent;\n330:   } catch (error: unknown) {\n331:     if (error instanceof DeepReviewReducerError) throw error;\n332:     throw new DeepReviewReducerError(\n333:       'event-schema-invalid',\n334:       'Deep-review event failed the real typed-ledger registry',\n335:       'event',\n336:     );\n337:   }\n338: }\n339: \n340: function typedEventFromVerified(verified: VerifiedLedgerEvent): DeepReviewLedgerEvent {\n341:   const envelope = verified.event.effective.envelope;\n342:   const payload = envelope.payload;\n343:   if (!isDeepReviewEventStem(payload.stem)\n344:     || envelope.event_type !== DeepReviewWireEventTypes[payload.stem]) {\n345:     throw new DeepReviewReducerError(\n346:       'event-not-deep-review',\n347:       'Mode reducer received a verified event outside the deep-review union',\n348:       'event_type',\n349:     );\n350:   }\n351:   return validateTypedEvent(envelope as DeepReviewLedgerEvent);\n352: }\n353: \n354: function asModeContractState(state: DeepReviewProjectionState): DeepReviewModeContractState {\n355:   assertDeepReviewProjectionState(state);\n356:   return state as DeepReviewModeContractState;\n357: }\n358: \n359: function topLevelChangedFields(\n360:   before: DeepReviewProjectionState,\n361:   after: DeepReviewProjectionState,\n362: ): DeepReviewPersistedField[] {\n363:   return PERSISTED_FIELDS.filter((field) => !sameCanonical(before[field], after[field]));\n364: }\n365: \n366: // ───────────────────────────────────────────────────────────────────\n367: // 3. INITIAL STATE\n368: // ───────────────────────────────────────────────────────────────────\n369: \n370: /** Create the immutable empty state accepted by the shared mode reducer contract. */\n371: export function createDeepReviewProjectionState(): DeepReviewProjectionState {\n372:   const state: DeepReviewProjectionState = {\n373:     schemaVersion: DEEP_REVIEW_PROJECTION_SCHEMA_VERSION,\n374:     reducerVersion: DEEP_REVIEW_REDUCER_VERSION,\n375:     codecVersion: DEEP_REVIEW_PROJECTION_CODEC_VERSION,\n376:     orderingPolicyVersion: DEEP_REVIEW_ORDERING_POLICY_VERSION,\n377:     run: {\n378:       runId: null,\n379:       sessionId: null,\n380:       generation: 0,\n381:       target: null,\n382:       maxIterations: 0,\n383:       convergencePolicyVersion: null,\n384:       reviewModeContractDigest: null,\n385:       initializationEventId: null,\n386:     },\n387:     reviewLoop: {\n388:       configuration: DEEP_REVIEW_SHARED_REVIEW_LOOP_CONFIGURATION,\n389:       scope: {\n390:         targetSetDigest: null,\n391:         scopeClass: null,\n392:         targets: [],\n393:         orderedDimensionIds: [],\n394:         scopeEvidenceRefs: [],\n395:         orderingPolicyVersion: null,\n396:       },\n397:       coverageCells: [],\n398:       passes: [],\n399:       obligations: [],\n400:       evaluations: [],\n401:       currentIterationId: null,\n402:       eligibility: 'INDETERMINATE',\n403:       outcome: 'active',\n404:       terminalDecision: null,\n405:       blockerIds: [],\n406:       lastAppliedSequence: 0,\n407:     },\n408:     findingLedger: {\n409:       findings: [],\n410:       evidence: [],\n411:       lineage: [],\n412:       activeFindingIds: [],\n413:       hardVetoFindingIds: [],\n414:     },\n415:     artifactIndex: { artifacts: [] },\n416:     status: {\n417:       state: 'planned',\n418:       terminal: false,\n419:       health: 'healthy',\n420:       activeContractVersions: [],\n421:       lastAppliedSequence: 0,\n422:       blockingReason: null,\n423:       shadowParityState: 'not-run',\n424:       provenance: [],\n425:     },\n426:     cursors: { reviewLoop: 0, findings: 0, artifactIndex: 0, status: 0 },\n427:     seenEvents: [],\n428:   };\n429:   assertDeepReviewProjectionState(state);\n430:   return immutableProjectionClone(state) as DeepReviewProjectionState;\n431: }\n432: \n433: // ───────────────────────────────────────────────────────────────────\n434: // 4. RUN AND SHARED REVIEW-LOOP FOLDS\n435: // ───────────────────────────────────────────────────────────────────\n436: \n437: function assertRunIdentity(\n438:   state: DeepReviewProjectionState,\n439:   event: DeepReviewLedgerEvent,\n440: ): void {\n441:   if (state.run.runId === null && event.payload.stem !== 'deep_review.run_initialized') {\n442:     throw new DeepReviewReducerError(\n443:       'run-not-initialized',\n444:       'A run-initialized event must precede every deep-review event',\n445:       'run',\n446:     );\n447:   }\n448:   if (state.run.runId !== null && (\n449:     state.run.runId !== event.payload.scope.runId\n450:     || state.run.sessionId !== event.payload.scope.sessionId\n451:   )) {\n452:     throw new DeepReviewReducerError(\n453:       'run-identity-conflict',\n454:       'One projection cannot fold events from different run or session identities',\n455:       'run',\n456:     );\n457:   }\n458: }\n459: \n460: function foldRun(\n461:   state: DeepReviewProjectionState,\n462:   event: DeepReviewLedgerEvent,\n463: ): DeepReviewProjectionState['run'] {\n464:   if (event.payload.stem === 'deep_review.run_initialized') {\n465:     const payload = payloadFor(event, 'deep_review.run_initialized');\n466:     if (state.run.initializationEventId !== null\n467:       && state.run.initializationEventId !== event.event_id) {\n468:       throw new DeepReviewReducerError(\n469:         'duplicate-terminal-event',\n470:         'A projection accepts exactly one run initialization',\n471:         'run.initializationEventId',\n472:       );\n473:     }\n474:     return {\n475:       runId: payload.scope.runId,\n476:       sessionId: payload.scope.sessionId,\n477:       generation: payload.scope.generation,\n478:       target: payload.data.target,\n479:       maxIterations: payload.data.maxIterations,\n480:       convergencePolicyVersion: payload.data.convergencePolicyVersion,\n481:       reviewModeContractDigest: payload.data.reviewModeContractDigest,\n482:       initializationEventId: event.event_id,\n483:     };\n484:   }\n485:   if (event.payload.stem === 'deep_review.run_resumed'\n486:     || event.payload.stem === 'deep_review.run_restarted') {\n487:     return { ...state.run, generation: event.payload.scope.generation };\n488:   }\n489:   return state.run;\n490: }\n491: \n492: function upsertCoverageCell(\n493:   reviewLoop: DeepReviewIterationConvergenceProjection,\n494:   event: DeepReviewEventEnvelope<\n495:     'deep_review.dimension_pass_started' | 'deep_review.dimension_pass_completed'\n496:   >,\n497:   seenEvents: readonly DeepReviewSeenEvent[],\n498: ): DeepReviewIterationConvergenceProjection {\n499:   const payload = event.payload;\n500:   const status = payload.data.passStatus;\n\n(Showing lines 1-500 of 2251. Use offset=501 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep Review Reducer\n// ───────────────────────────────────────────────────────────────────\n\nimport {\n  DeepReviewEventStems,\n  DeepReviewWireEventTypes,\n  createDeepReviewEventRegistry,\n  isDeepReviewEventStem,\n} from '../deep-review-ledger-schema/index.js';\nimport {\n  canonicalBytes,\n  canonicalJson,\n  readEvent,\n  sha256Bytes,\n} from '../event-envelope/index.js';\nimport {\n  DeepReviewReducerError,\n  assertDeepReviewLegacyProjection,\n  assertDeepReviewProjectionState,","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep Review Reducer\n// ───────────────────────────────────────────────────────────────────\n\nimport {\n  DeepReviewEventStems,\n  DeepReviewWireEventTypes,\n  createDeepReviewEventRegistry,\n  isDeepReviewEventStem,\n} from '../deep-review-ledger-schema/index.js';\nimport {\n  canonicalBytes,\n  canonicalJson,\n  readEvent,\n  sha256Bytes,\n} from '../event-envelope/index.js';\nimport {\n  DeepReviewReducerError,\n  assertDeepReviewLegacyProjection,\n  assertDeepReviewProjectionState,\n  immutableProjectionClone,\n  isDeepFrozenProjection,\n} from './deep-review-projection-schema.js';\n\nimport type { VerifiedLedgerEvent } from '../authorized-ledger/index.js';\nimport type {\n  DeepReviewEventEnvelope,\n  DeepReviewEventStem,\n  DeepReviewLedgerEvent,\n  DeepReviewLedgerPayload,\n} from '../deep-review-ledger-schema/index.js';\nimport type { JsonObject } from '../event-envelope/index.js';\nimport type {\n  ModeContract,\n  ModeReducerSet,\n  ModeReductionResult,\n} from '../mode-contracts/index.js';\nimport type {\n  DeepReviewArtifactRecord,\n  DeepReviewConvergenceEvaluation,\n  DeepReviewEvidenceRecord,\n  DeepReviewFindingProjection,\n  DeepReviewFindingRecord,\n  DeepReviewFoldOptions,\n  DeepReviewFoldResult,\n  DeepReviewIterationConvergenceProjection,\n  DeepReviewLegacyProjection,\n  DeepReviewModeStatus,\n  DeepReviewPersistedField,\n  DeepReviewProjectedResult,\n  DeepReviewProjectionCheckpoint,\n  DeepReviewProjectionFieldOwnership,\n  DeepReviewProjectionState,\n  DeepReviewRebuildReasonCode,\n  DeepReviewSeenEvent,\n  DeepReviewStatusProjection,\n  DeepReviewStatusTransition,\n  SharedReviewLoopBackboneInput,\n  SharedReviewLoopBackboneResult,\n  SharedReviewLoopModeConfiguration,\n} from './deep-review-projection-types.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. PUBLIC CONTRACT CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nexport const DEEP_REVIEW_PROJECTION_SCHEMA_VERSION = 'deep-review-projection@1' as const;\nexport const DEEP_REVIEW_REDUCER_VERSION = 'deep-review-reducer@1' as const;\nexport const DEEP_REVIEW_PROJECTION_CODEC_VERSION = 'canonical-json@1' as const;\nexport const DEEP_REVIEW_ORDERING_POLICY_VERSION = 'causal-input-order@1' as const;\nexport const DEEP_REVIEW_REDUCER_ID = 'deep-review:projection-fold' as const;\n\nexport const DEEP_REVIEW_SHARED_REVIEW_LOOP_CONFIGURATION: SharedReviewLoopModeConfiguration =\n  Object.freeze({\n    mode: 'review',\n    requiredCoveragePolicy: 'all-required-cells',\n    hardVetoClasses: Object.freeze(['build', 'regression', 'schema', 'security']),\n    terminalDecisionPolicy: 'typed-transition-only',\n  });\n\nconst eventRegistry = createDeepReviewEventRegistry();\nconst EMPTY_DIGEST = sha256Bytes(canonicalBytes([]));\nconst HARD_VETO_CLASS_SEPARATORS = '-._:/@';\ntype DeepReviewModeContractState = DeepReviewProjectionState & JsonObject;\n\nconst PERSISTED_FIELDS = Object.freeze([\n  'schemaVersion',\n  'reducerVersion',\n  'codecVersion',\n  'orderingPolicyVersion',\n  'run',\n  'reviewLoop',\n  'findingLedger',\n  'artifactIndex',\n  'status',\n  'cursors',\n  'seenEvents',\n] as const satisfies readonly DeepReviewPersistedField[]);\n\ntype ProjectionPlane = 'reviewLoop' | 'findings' | 'artifactIndex' | 'status';\n\nexport const DEEP_REVIEW_EVENT_ROUTING = Object.freeze({\n  'deep_review.run_initialized': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.run_resumed': Object.freeze(['status']),\n  'deep_review.run_restarted': Object.freeze(['status']),\n  'deep_review.scope_resolved': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.dimension_ordered': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.protocol_plan_recorded': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.dimension_pass_started': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.dimension_pass_completed': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.finding_candidate_emitted': Object.freeze([\n    'findings', 'artifactIndex', 'status',\n  ]),\n  'deep_review.evidence_observed': Object.freeze([\n    'findings', 'artifactIndex', 'status',\n  ]),\n  'deep_review.evidence_reconciled': Object.freeze([\n    'findings', 'artifactIndex', 'status',\n  ]),\n  'deep_review.claim_adjudication_recorded': Object.freeze([\n    'findings', 'artifactIndex', 'status',\n  ]),\n  'deep_review.finding_lineage_recorded': Object.freeze(['findings', 'status']),\n  'deep_review.finding_state_changed': Object.freeze(['findings', 'status']),\n  'deep_review.review_depth_recorded': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.convergence_evaluated': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.graph_convergence_evaluated': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.blocked_stop_recorded': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.pause_recorded': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.recovery_started': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.synthesis_started': Object.freeze(['reviewLoop', 'status']),\n  'deep_review.review_report_committed': Object.freeze(['artifactIndex', 'status']),\n  'deep_review.continuity_save_requested': Object.freeze(['artifactIndex']),\n  'deep_review.continuity_save_completed': Object.freeze(['artifactIndex']),\n  'deep_review.continuity_save_failed': Object.freeze(['artifactIndex', 'status']),\n  'deep_review.run_completed': Object.freeze(['reviewLoop', 'status']),\n} as const satisfies Readonly<Record<DeepReviewEventStem, readonly ProjectionPlane[]>>);\n\nfunction stemsForPlane(plane: ProjectionPlane): readonly DeepReviewEventStem[] {\n  return Object.freeze(DeepReviewEventStems.filter((stem) => (\n    DEEP_REVIEW_EVENT_ROUTING[stem].includes(plane as never)\n  )));\n}\n\nexport const DEEP_REVIEW_PROJECTION_FIELD_OWNERSHIP = Object.freeze([\n  {\n    field: 'schemaVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n  },\n  {\n    field: 'reducerVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n  },\n  {\n    field: 'codecVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n  },\n  {\n    field: 'orderingPolicyVersion', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: Object.freeze([]), foldAlgebra: 'constant', immutableOutput: true,\n  },\n  {\n    field: 'run', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: stemsForPlane('reviewLoop'), foldAlgebra: 'insert-sorted-and-derive',\n    immutableOutput: true,\n  },\n  {\n    field: 'reviewLoop', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: stemsForPlane('reviewLoop'), foldAlgebra: 'insert-sorted-and-derive',\n    immutableOutput: true,\n  },\n  {\n    field: 'findingLedger', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: stemsForPlane('findings'), foldAlgebra: 'insert-sorted-and-derive',\n    immutableOutput: true,\n  },\n  {\n    field: 'artifactIndex', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: stemsForPlane('artifactIndex'), foldAlgebra: 'insert-sorted-and-derive',\n    immutableOutput: true,\n  },\n  {\n    field: 'status', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: stemsForPlane('status'), foldAlgebra: 'insert-sorted-and-derive',\n    immutableOutput: true,\n  },\n  {\n    field: 'cursors', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: DeepReviewEventStems, foldAlgebra: 'insert-sorted-and-derive',\n    immutableOutput: true,\n  },\n  {\n    field: 'seenEvents', ownerReducerId: DEEP_REVIEW_REDUCER_ID,\n    inputStems: DeepReviewEventStems, foldAlgebra: 'insert-sorted', immutableOutput: true,\n  },\n] as const satisfies readonly DeepReviewProjectionFieldOwnership[]);\n\nexport const DEEP_REVIEW_REDUCER_SET: ModeReducerSet<DeepReviewModeContractState> =\n  Object.freeze({\n    persistedFields: PERSISTED_FIELDS,\n    definitions: Object.freeze([Object.freeze({\n      reducerId: DEEP_REVIEW_REDUCER_ID,\n      reducerVersion: DEEP_REVIEW_REDUCER_VERSION,\n      stateVersion: DEEP_REVIEW_PROJECTION_SCHEMA_VERSION,\n      ownedFields: PERSISTED_FIELDS,\n      inputEventTypes: Object.freeze(\n        DeepReviewEventStems.map((stem) => DeepReviewWireEventTypes[stem]),\n      ),\n      replaySource: 'verified-ledger-events-only',\n      outputRule: 'immutable',\n    })]),\n  });\n\n// ───────────────────────────────────────────────────────────────────\n// 2. GENERAL HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction compareString(left: string, right: string): number {\n  return left < right ? -1 : left > right ? 1 : 0;\n}\n\nfunction compareNumber(left: number, right: number): number {\n  return left < right ? -1 : left > right ? 1 : 0;\n}\n\nfunction sortStrings(values: readonly string[]): string[] {\n  return [...new Set(values)].sort(compareString);\n}\n\nfunction sameCanonical(left: unknown, right: unknown): boolean {\n  return canonicalJson(left) === canonicalJson(right);\n}\n\nfunction payloadFor<TStem extends DeepReviewEventStem>(\n  event: DeepReviewLedgerEvent,\n  stem: TStem,\n): DeepReviewLedgerPayload<TStem> {\n  if (event.payload.stem !== stem) {\n    throw new DeepReviewReducerError(\n      'event-not-deep-review',\n      `Expected ${stem}, received ${event.payload.stem}`,\n      'payload.stem',\n    );\n  }\n  return event.payload as DeepReviewLedgerPayload<TStem>;\n}\n\nfunction assertNeverStem(stem: never): never {\n  throw new DeepReviewReducerError(\n    'event-not-deep-review',\n    `Unhandled deep-review event stem: ${String(stem)}`,\n    'payload.stem',\n  );\n}\n\nfunction eventDigest(event: DeepReviewLedgerEvent): string {\n  return sha256Bytes(canonicalBytes(event));\n}\n\ninterface CanonicalEventPosition {\n  readonly event_id: string;\n  readonly causal_position: number;\n}\n\nfunction compareEvents(left: CanonicalEventPosition, right: CanonicalEventPosition): number {\n  return compareNumber(left.causal_position, right.causal_position)\n    || compareString(left.event_id, right.event_id);\n}\n\nfunction producerEventPosition(\n  seenEvents: readonly DeepReviewSeenEvent[],\n  producerEventId: string,\n): CanonicalEventPosition {\n  const causalPosition = seenEvents.findIndex((event) => event.eventId === producerEventId);\n  if (causalPosition === -1) {\n    throw new DeepReviewReducerError(\n      'referential-integrity',\n      'Temporal projection records require captured producer-event provenance',\n      'seenEvents',\n    );\n  }\n  return {\n    event_id: producerEventId,\n    causal_position: causalPosition,\n  };\n}\n\nfunction compareProducerEvents(\n  seenEvents: readonly DeepReviewSeenEvent[],\n  leftEventId: string,\n  rightEventId: string,\n): number {\n  return compareEvents(\n    producerEventPosition(seenEvents, leftEventId),\n    producerEventPosition(seenEvents, rightEventId),\n  );\n}\n\nfunction establishedRunStreamId(\n  run: DeepReviewProjectionState['run'],\n  seenEvents: readonly DeepReviewSeenEvent[],\n): string {\n  const initialized = run.initializationEventId === null\n    ? undefined\n    : seenEvents.find((event) => event.eventId === run.initializationEventId);\n  if (initialized === undefined || initialized.stem !== 'deep_review.run_initialized') {\n    throw new DeepReviewReducerError(\n      'referential-integrity',\n      'Run stream identity requires its captured initialization event',\n      'run.initializationEventId',\n    );\n  }\n  return initialized.streamId;\n}\n\nfunction validateTypedEvent(event: DeepReviewLedgerEvent): DeepReviewLedgerEvent {\n  try {\n    const read = readEvent(canonicalBytes(event), eventRegistry);\n    const effective = read.effective.envelope;\n    const payload = effective.payload;\n    if (!isDeepReviewEventStem(payload.stem)\n      || effective.event_type !== DeepReviewWireEventTypes[payload.stem]) {\n      throw new DeepReviewReducerError(\n        'event-not-deep-review',\n        'Verified event does not carry a registered deep-review stem',\n        'event_type',\n      );\n    }\n    return effective as DeepReviewLedgerEvent;\n  } catch (error: unknown) {\n    if (error instanceof DeepReviewReducerError) throw error;\n    throw new DeepReviewReducerError(\n      'event-schema-invalid',\n      'Deep-review event failed the real typed-ledger registry',\n      'event',\n    );\n  }\n}\n\nfunction typedEventFromVerified(verified: VerifiedLedgerEvent): DeepReviewLedgerEvent {\n  const envelope = verified.event.effective.envelope;\n  const payload = envelope.payload;\n  if (!isDeepReviewEventStem(payload.stem)\n    || envelope.event_type !== DeepReviewWireEventTypes[payload.stem]) {\n    throw new DeepReviewReducerError(\n      'event-not-deep-review',\n      'Mode reducer received a verified event outside the deep-review union',\n      'event_type',\n    );\n  }\n  return validateTypedEvent(envelope as DeepReviewLedgerEvent);\n}\n\nfunction asModeContractState(state: DeepReviewProjectionState): DeepReviewModeContractState {\n  assertDeepReviewProjectionState(state);\n  return state as DeepReviewModeContractState;\n}\n\nfunction topLevelChangedFields(\n  before: DeepReviewProjectionState,\n  after: DeepReviewProjectionState,\n): DeepReviewPersistedField[] {\n  return PERSISTED_FIELDS.filter((field) => !sameCanonical(before[field], after[field]));\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 3. INITIAL STATE\n// ───────────────────────────────────────────────────────────────────\n\n/** Create the immutable empty state accepted by the shared mode reducer contract. */\nexport function createDeepReviewProjectionState(): DeepReviewProjectionState {\n  const state: DeepReviewProjectionState = {\n    schemaVersion: DEEP_REVIEW_PROJECTION_SCHEMA_VERSION,\n    reducerVersion: DEEP_REVIEW_REDUCER_VERSION,\n    codecVersion: DEEP_REVIEW_PROJECTION_CODEC_VERSION,\n    orderingPolicyVersion: DEEP_REVIEW_ORDERING_POLICY_VERSION,\n    run: {\n      runId: null,\n      sessionId: null,\n      generation: 0,\n      target: null,\n      maxIterations: 0,\n      convergencePolicyVersion: null,\n      reviewModeContractDigest: null,\n      initializationEventId: null,\n    },\n    reviewLoop: {\n      configuration: DEEP_REVIEW_SHARED_REVIEW_LOOP_CONFIGURATION,\n      scope: {\n        targetSetDigest: null,\n        scopeClass: null,\n        targets: [],\n        orderedDimensionIds: [],\n        scopeEvidenceRefs: [],\n        orderingPolicyVersion: null,\n      },\n      coverageCells: [],\n      passes: [],\n      obligations: [],\n      evaluations: [],\n      currentIterationId: null,\n      eligibility: 'INDETERMINATE',\n      outcome: 'active',\n      terminalDecision: null,\n      blockerIds: [],\n      lastAppliedSequence: 0,\n    },\n    findingLedger: {\n      findings: [],\n      evidence: [],\n      lineage: [],\n      activeFindingIds: [],\n      hardVetoFindingIds: [],\n    },\n    artifactIndex: { artifacts: [] },\n    status: {\n      state: 'planned',\n      terminal: false,\n      health: 'healthy',\n      activeContractVersions: [],\n      lastAppliedSequence: 0,\n      blockingReason: null,\n      shadowParityState: 'not-run',\n      provenance: [],\n    },\n    cursors: { reviewLoop: 0, findings: 0, artifactIndex: 0, status: 0 },\n    seenEvents: [],\n  };\n  assertDeepReviewProjectionState(state);\n  return immutableProjectionClone(state) as DeepReviewProjectionState;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. RUN AND SHARED REVIEW-LOOP FOLDS\n// ───────────────────────────────────────────────────────────────────\n\nfunction assertRunIdentity(\n  state: DeepReviewProjectionState,\n  event: DeepReviewLedgerEvent,\n): void {\n  if (state.run.runId === null && event.payload.stem !== 'deep_review.run_initialized') {\n    throw new DeepReviewReducerError(\n      'run-not-initialized',\n      'A run-initialized event must precede every deep-review event',\n      'run',\n    );\n  }\n  if (state.run.runId !== null && (\n    state.run.runId !== event.payload.scope.runId\n    || state.run.sessionId !== event.payload.scope.sessionId\n  )) {\n    throw new DeepReviewReducerError(\n      'run-identity-conflict',\n      'One projection cannot fold events from different run or session identities',\n      'run',\n    );\n  }\n}\n\nfunction foldRun(\n  state: DeepReviewProjectionState,\n  event: DeepReviewLedgerEvent,\n): DeepReviewProjectionState['run'] {\n  if (event.payload.stem === 'deep_review.run_initialized') {\n    const payload = payloadFor(event, 'deep_review.run_initialized');\n    if (state.run.initializationEventId !== null\n      && state.run.initializationEventId !== event.event_id) {\n      throw new DeepReviewReducerError(\n        'duplicate-terminal-event',\n        'A projection accepts exactly one run initialization',\n        'run.initializationEventId',\n      );\n    }\n    return {\n      runId: payload.scope.runId,\n      sessionId: payload.scope.sessionId,\n      generation: payload.scope.generation,\n      target: payload.data.target,\n      maxIterations: payload.data.maxIterations,\n      convergencePolicyVersion: payload.data.convergencePolicyVersion,\n      reviewModeContractDigest: payload.data.reviewModeContractDigest,\n      initializationEventId: event.event_id,\n    };\n  }\n  if (event.payload.stem === 'deep_review.run_resumed'\n    || event.payload.stem === 'deep_review.run_restarted') {\n    return { ...state.run, generation: event.payload.scope.generation };\n  }\n  return state.run;\n}\n\nfunction upsertCoverageCell(\n  reviewLoop: DeepReviewIterationConvergenceProjection,\n  event: DeepReviewEventEnvelope<\n    'deep_review.dimension_pass_started' | 'deep_review.dimension_pass_completed'\n  >,\n  seenEvents: readonly DeepReviewSeenEvent[],\n): DeepReviewIterationConvergenceProjection {\n  const payload = event.payload;\n  const status = payload.data.passStatus;","lineStart":1,"lineEnd":500,"totalLines":2251,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts","time":{"start":1788632346780,"end":1788632346792}},"id":"prt_072cbae5c001JTfcPQA321haj1","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072cb915f001WO5aas4qvc714C"}}
