neratePerFolderDescription,\n33:   savePerFolderDescription,\n34:   loadPerFolderDescription,\n35:   loadExistingDescription,\n36:   wouldWritePerFolderDescription,\n37:   extractKeywords,\n38:   slugifyFolderName,\n39:   getRepairMergeSafe,\n40: } from '../lib/search/folder-discovery.js';\n41: export type { PerFolderDescription, LoadResult } from '../lib/search/folder-discovery.js';\n42: \n43: // --- Graph metadata (used by scripts/core, scripts/graph, runtime/cli/continuity) ---\n44: export {\n45:   GRAPH_METADATA_DOCUMENT_TYPE,\n46:   GRAPH_METADATA_FILENAME,\n47:   GRAPH_METADATA_MIGRATED_QUALITY_FLAG,\n48:   GRAPH_METADATA_SCHEMA_VERSION,\n49:   GRAPH_METADATA_STATUS_VALUES,\n50:   SAVE_LINEAGE_VALUES,\n51:   createEmptyGraphMetadataManual,\n52:   graphMetadataLoadSchema,\n53:   graphMetadataSchema,\n54:   packetReferenceSchema,\n55:   graphEntityReferenceSchema,\n56: } from '../lib/graph/graph-metadata-schema.js';\n57: export type {\n58:   GraphMetadata,\n59:   GraphMetadataDerived,\n60:   GraphMetadataMigrationSource,\n61:   GraphMetadataManual,\n62:   GraphMetadataStatus,\n63:   GraphEntityReference,\n64:   PacketReference,\n65:   SaveLineage,\n66: } from '../lib/graph/graph-metadata-schema.js';\n67: export {\n68:   GENERATED_METADATA_INTEGRITY_RULE,\n69:   STATUS_COMPLETE_EVIDENCE_MISMATCH_CODE,\n70:   checkGeneratedMetadataIntegrity,\n71:   resolveGeneratedMetadataIntegrity,\n72: } from '../lib/validation/generated-metadata-integrity.js';\n73: export type {\n74:   GeneratedMetadataViolation,\n75:   GeneratedMetadataIntegrityReport,\n76:   ResolvedIntegrityStatus,\n77: } from '../lib/validation/generated-metadata-integrity.js';\n78: export {\n79:   GENERATED_METADATA_DRIFT_RULE,\n80:   checkGeneratedMetadataDrift,\n\n(Showing lines 1-80 of 103. Use offset=81 to continue.)\n</content>","metadata":{"preview":"// ────────────────────────────────────────────────────────────────\n// MODULE: Index, Public API surface\n// ──────────────────────────────────────────