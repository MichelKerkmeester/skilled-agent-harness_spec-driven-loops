{"type":"tool_use","timestamp":1788632229691,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_p36O8RdMX0DYwWeUiy2Arqas","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts","offset":1,"limit":180},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts</path>\n<type>file</type>\n<content>\n1: // -------------------------------------------------------------------\n2: // MODULE: Spec Root Registry Tests\n3: // -------------------------------------------------------------------\n4: \n5: import { existsSync } from 'node:fs';\n6: import path from 'node:path';\n7: import { fileURLToPath } from 'node:url';\n8: \n9: import { describe, expect, it } from 'vitest';\n10: \n11: import {\n12:   SPEC_ROOT_RESOLVERS,\n13:   registryCoverageGaps,\n14: } from '../core/spec-root-registry.js';\n15: import type { SpecRootPrecedence } from '../core/spec-root-registry.js';\n16: \n17: const ALLOWED_PRECEDENCE = new Set<SpecRootPrecedence>([\n18:   'legacy-first',\n19:   'canonical-first',\n20:   'canonical-only',\n21:   'direct-path-first',\n22:   'membership-only',\n23: ]);\n24: \n25: // Entry file values carry a trailing ':line-range' (and sometimes several,\n26: // comma-separated) suffix for human navigation; strip it to get the real path.\n27: function registryEntryFilePath(entryFile: string): string {\n28:   return entryFile.replace(/:\\d.*$/u, '');\n29: }\n30: \n31: const SKILL_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..', '..');\n32: \n33: describe('spec root resolver registry', () => {\n34:   it('contains only well-formed resolver entries', () => {\n35:     expect(SPEC_ROOT_RESOLVERS.length).toBeGreaterThan(0);\n36: \n37:     for (const entry of SPEC_ROOT_RESOLVERS) {\n38:       expect(entry.file.trim()).not.toBe('');\n39:       expect(entry.file).toMatch(/^(runtime|shared)\\/.+:\\d/u);\n40:       expect(entry.symbol.trim()).not.toBe('');\n41:       expect(entry.consumerOrEffect.trim()).not.toBe('');\n42:       expect(ALLOWED_PRECEDENCE.has(entry.precedence)).toBe(true);\n43:     }\n44:   });\n45: \n46:   it('every listed source path exists on disk', () => {\n47:     const missing = SPEC_ROOT_RESOLVERS\n48:       .map((entry) => registryEntryFilePath(entry.file))\n49:       .filter((relativePath) => !existsSync(path.join(SKILL_ROOT, relativePath)));\n50:     expect(missing).toEqual([]);\n51:   });\n52: \n53:   it('has no registry coverage gaps', () => {\n54:     expect(registryCoverageGaps()).toEqual([]);\n55:   });\n56: });\n\n(End of file - total 56 lines)\n</content>","metadata":{"preview":"// -------------------------------------------------------------------\n// MODULE: Spec Root Registry Tests\n// -------------------------------------------------------------------\n\nimport { existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  SPEC_ROOT_RESOLVERS,\n  registryCoverageGaps,\n} from '../core/spec-root-registry.js';\nimport type { SpecRootPrecedence } from '../core/spec-root-registry.js';\n\nconst ALLOWED_PRECEDENCE = new Set<SpecRootPrecedence>([\n  'legacy-first',\n  'canonical-first',\n  'canonical-only',","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts","text":"// -------------------------------------------------------------------\n// MODULE: Spec Root Registry Tests\n// -------------------------------------------------------------------\n\nimport { existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  SPEC_ROOT_RESOLVERS,\n  registryCoverageGaps,\n} from '../core/spec-root-registry.js';\nimport type { SpecRootPrecedence } from '../core/spec-root-registry.js';\n\nconst ALLOWED_PRECEDENCE = new Set<SpecRootPrecedence>([\n  'legacy-first',\n  'canonical-first',\n  'canonical-only',\n  'direct-path-first',\n  'membership-only',\n]);\n\n// Entry file values carry a trailing ':line-range' (and sometimes several,\n// comma-separated) suffix for human navigation; strip it to get the real path.\nfunction registryEntryFilePath(entryFile: string): string {\n  return entryFile.replace(/:\\d.*$/u, '');\n}\n\nconst SKILL_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..', '..');\n\ndescribe('spec root resolver registry', () => {\n  it('contains only well-formed resolver entries', () => {\n    expect(SPEC_ROOT_RESOLVERS.length).toBeGreaterThan(0);\n\n    for (const entry of SPEC_ROOT_RESOLVERS) {\n      expect(entry.file.trim()).not.toBe('');\n      expect(entry.file).toMatch(/^(runtime|shared)\\/.+:\\d/u);\n      expect(entry.symbol.trim()).not.toBe('');\n      expect(entry.consumerOrEffect.trim()).not.toBe('');\n      expect(ALLOWED_PRECEDENCE.has(entry.precedence)).toBe(true);\n    }\n  });\n\n  it('every listed source path exists on disk', () => {\n    const missing = SPEC_ROOT_RESOLVERS\n      .map((entry) => registryEntryFilePath(entry.file))\n      .filter((relativePath) => !existsSync(path.join(SKILL_ROOT, relativePath)));\n    expect(missing).toEqual([]);\n  });\n\n  it('has no registry coverage gaps', () => {\n    expect(registryCoverageGaps()).toEqual([]);\n  });\n});","lineStart":1,"lineEnd":56,"totalLines":56,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/spec-root-registry.vitest.ts","time":{"start":1788632229652,"end":1788632229685}},"id":"prt_072c9e7130017AmoLwy6VT5Akb","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
{"type":"tool_use","timestamp":1788632229691,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_wxzFxTTmFlR60N6y4TqwGHSz","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/import-policy-rules.vitest.ts","offset":1,"limit":240},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/import-policy-rules.vitest.ts</path>\n<type>file</type>\n<content>\n1: // TEST: Import Policy Rules\n2: import { describe, expect, it } from 'vitest';\n3: \n4: import { isProhibitedImportPath } from '../evals/import-policy-rules';\n5: \n6: describe('isProhibitedImportPath', () => {\n7:   it('blocks package imports for internal runtime roots and descendants', () => {\n8:     expect(isProhibitedImportPath('@spec-kit/runtime/lib/search/vector-index')).toBe(true);\n9:     expect(isProhibitedImportPath('@spec-kit/runtime/core')).toBe(true);\n10:     expect(isProhibitedImportPath('@spec-kit/runtime/core/db-state')).toBe(true);\n11:     expect(isProhibitedImportPath('@spec-kit/runtime/handlers')).toBe(true);\n12:     expect(isProhibitedImportPath('@spec-kit/runtime/handlers/memory-index')).toBe(true);\n13:   });\n14: \n15:   it('blocks relative imports for internal runtime roots and descendants', () => {\n16:     expect(isProhibitedImportPath('../../lib/search/vector-index')).toBe(true);\n17:     expect(isProhibitedImportPath('../../core')).toBe(true);\n18:     expect(isProhibitedImportPath('../../../core/db-state')).toBe(true);\n19:     expect(isProhibitedImportPath('../../handlers')).toBe(true);\n20:     expect(isProhibitedImportPath('../../../handlers/memory-index')).toBe(true);\n21:   });\n22: \n23:   it('blocks normalized relative bypass attempts into internal runtime roots', () => {\n24:     expect(isProhibitedImportPath('../../api/../core/config')).toBe(true);\n25:     expect(isProhibitedImportPath('./../runtime/core/config')).toBe(true);\n26:     expect(isProhibitedImportPath('../../shared/lib/../utils')).toBe(true);\n27:   });\n28: \n29:   it('blocks sibling shared traversals and still allows public package imports', () => {\n30:     expect(isProhibitedImportPath('../shared/utils')).toBe(true);\n31:     expect(isProhibitedImportPath('../../shared/utils/path-security')).toBe(true);\n32:     expect(isProhibitedImportPath('@spec-kit/runtime/api')).toBe(false);\n33:     expect(isProhibitedImportPath('@spec-kit/runtime/api/indexing')).toBe(false);\n34:     expect(isProhibitedImportPath('../../api/indexing')).toBe(false);\n35:     expect(isProhibitedImportPath('../../core/../api/indexing')).toBe(false);\n36:   });\n37: });\n\n(End of file - total 37 lines)\n</content>","metadata":{"preview":"// TEST: Import Policy Rules\nimport { describe, expect, it } from 'vitest';\n\nimport { isProhibitedImportPath } from '../evals/import-policy-rules';\n\ndescribe('isProhibitedImportPath', () => {\n  it('blocks package imports for internal runtime roots and descendants', () => {\n    expect(isProhibitedImportPath('@spec-kit/runtime/lib/search/vector-index')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/core')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/core/db-state')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/handlers')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/handlers/memory-index')).toBe(true);\n  });\n\n  it('blocks relative imports for internal runtime roots and descendants', () => {\n    expect(isProhibitedImportPath('../../lib/search/vector-index')).toBe(true);\n    expect(isProhibitedImportPath('../../core')).toBe(true);\n    expect(isProhibitedImportPath('../../../core/db-state')).toBe(true);\n    expect(isProhibitedImportPath('../../handlers')).toBe(true);\n    expect(isProhibitedImportPath('../../../handlers/memory-index')).toBe(true);","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/import-policy-rules.vitest.ts","text":"// TEST: Import Policy Rules\nimport { describe, expect, it } from 'vitest';\n\nimport { isProhibitedImportPath } from '../evals/import-policy-rules';\n\ndescribe('isProhibitedImportPath', () => {\n  it('blocks package imports for internal runtime roots and descendants', () => {\n    expect(isProhibitedImportPath('@spec-kit/runtime/lib/search/vector-index')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/core')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/core/db-state')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/handlers')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/handlers/memory-index')).toBe(true);\n  });\n\n  it('blocks relative imports for internal runtime roots and descendants', () => {\n    expect(isProhibitedImportPath('../../lib/search/vector-index')).toBe(true);\n    expect(isProhibitedImportPath('../../core')).toBe(true);\n    expect(isProhibitedImportPath('../../../core/db-state')).toBe(true);\n    expect(isProhibitedImportPath('../../handlers')).toBe(true);\n    expect(isProhibitedImportPath('../../../handlers/memory-index')).toBe(true);\n  });\n\n  it('blocks normalized relative bypass attempts into internal runtime roots', () => {\n    expect(isProhibitedImportPath('../../api/../core/config')).toBe(true);\n    expect(isProhibitedImportPath('./../runtime/core/config')).toBe(true);\n    expect(isProhibitedImportPath('../../shared/lib/../utils')).toBe(true);\n  });\n\n  it('blocks sibling shared traversals and still allows public package imports', () => {\n    expect(isProhibitedImportPath('../shared/utils')).toBe(true);\n    expect(isProhibitedImportPath('../../shared/utils/path-security')).toBe(true);\n    expect(isProhibitedImportPath('@spec-kit/runtime/api')).toBe(false);\n    expect(isProhibitedImportPath('@spec-kit/runtime/api/indexing')).toBe(false);\n    expect(isProhibitedImportPath('../../api/indexing')).toBe(false);\n    expect(isProhibitedImportPath('../../core/../api/indexing')).toBe(false);\n  });\n});","lineStart":1,"lineEnd":37,"totalLines":37,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/import-policy-rules.vitest.ts","time":{"start":1788632229654,"end":1788632229686}},"id":"prt_072c9e715001LuOLGSVKZ9jAY8","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
{"type":"tool_use","timestamp":1788632229691,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_0TMVr5UqUwM015I80UDW1g42","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/continuity-freshness.vitest.ts","offset":1,"limit":180},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/continuity-freshness.vitest.ts</path>\n<type>file</type>\n<content>\n1: import fs from 'node:fs';\n2: import os from 'node:os';\n3: import path from 'node:path';\n4: import { spawnSync } from 'node:child_process';\n5: import { fileURLToPath } from 'node:url';\n6: \n7: import { afterEach, describe, expect, it } from 'vitest';\n8: \n9: import { buildContinuityFingerprint, refreshGraphMetadataForSpecFolder, ZERO_CONTINUITY_FINGERPRINT } from '../../api';\n10: import { validateContinuityFreshness } from '../validation/continuity-freshness.js';\n11: \n12: const createdRoots = new Set<string>();\n13: const __dirname = path.dirname(fileURLToPath(import.meta.url));\n14: const SKILL_ROOT = path.resolve(__dirname, '..', '..', '..');\n15: const VALIDATE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'validate.sh');\n16: const RULE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'dist', 'validation', 'continuity-freshness.js');\n17: \n18: function makeWorkspace(): string {\n19:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'continuity-freshness-'));\n20:   createdRoots.add(root);\n21:   return root;\n22: }\n23: \n24: // No completion claim by default -- exercises the last_updated_at-vs-\n25: // graph-metadata staleness path. Tests that need a completion claim use\n26: // createSpecFolderWithCompletionClaim instead.\n27: function createSpecFolder(workspaceRoot: string, name: string): string {\n28:   const specFolder = path.join(workspaceRoot, '.opencode', 'specs', 'system-spec-kit', name);\n29:   fs.mkdirSync(specFolder, { recursive: true });\n30:   fs.writeFileSync(path.join(specFolder, 'spec.md'), [\n31:     '---',\n32:     'title: \"Continuity Freshness Fixture\"',\n33:     'description: \"Fixture for continuity freshness validation.\"',\n34:     'trigger_phrases: [\"continuity freshness\"]',\n35:     'importance_tier: \"important\"',\n36:     'status: \"planned\"',\n37:     '---',\n38:     '',\n39:     '# Fixture',\n40:   ].join('\\n'), 'utf-8');\n41:   fs.writeFileSync(path.join(specFolder, 'plan.md'), '# Plan\\n', 'utf-8');\n42:   fs.writeFileSync(path.join(specFolder, 'tasks.md'), '# Tasks\\n', 'utf-8');\n43:   return specFolder;\n44: }\n45: \n46: // Claims completion the way a real packet does: spec.md's metadata table,\n47: // not its frontmatter -- implementation-summary.md carries no status of its\n48: // own, as real closed packets do, so the claim binds to its fingerprint alone.\n49: function createSpecFolderWithCompletionClaim(workspaceRoot: string, name: string): string {\n50:   const specFolder = path.join(workspaceRoot, '.opencode', 'specs', 'system-spec-kit', name);\n51:   fs.mkdirSync(specFolder, { recursive: true });\n52:   fs.writeFileSync(path.join(specFolder, 'spec.md'), [\n53:     '---',\n54:     'title: \"Continuity Freshness Completion Fixture\"',\n55:     'description: \"Fixture for completion-claim continuity freshness validation.\"',\n56:     'trigger_phrases: [\"continuity freshness\"]',\n57:     'importance_tier: \"important\"',\n58:     '---',\n59:     '',\n60:     '# Fixture',\n61:     '',\n62:     '| Field | Value |',\n63:     '|-------|-------|',\n64:     '| **Status** | Complete |',\n65:   ].join('\\n'), 'utf-8');\n66:   fs.writeFileSync(path.join(specFolder, 'plan.md'), '# Plan\\n', 'utf-8');\n67:   fs.writeFileSync(path.join(specFolder, 'tasks.md'), '# Tasks\\n', 'utf-8');\n68:   return specFolder;\n69: }\n70: \n71: function writeImplementationSummary(specFolder: string, continuityTimestamp?: string, fingerprint?: string): void {\n72:   const frontmatterLines = [\n73:     '---',\n74:     'title: \"Implementation Summary\"',\n75:     'status: \"planned\"',\n76:   ];\n77:   if (continuityTimestamp) {\n78:     frontmatterLines.push('_memory:');\n79:     frontmatterLines.push('  continuity:');\n80:     frontmatterLines.push('    packet_pointer: \"system-spec-kit/test-packet\"');\n81:     frontmatterLines.push(`    last_updated_at: \"${continuityTimestamp}\"`);\n82:     frontmatterLines.push('    last_updated_by: \"tester\"');\n83:     frontmatterLines.push('    recent_action: \"Validated freshness\"');\n84:     frontmatterLines.push('    next_safe_action: \"Keep timestamps aligned\"');\n85:     frontmatterLines.push('    blockers: []');\n86:     frontmatterLines.push('    key_files: []');\n87:     if (fingerprint) {\n88:       frontmatterLines.push('    session_dedup:');\n89:       frontmatterLines.push(`      fingerprint: \"${fingerprint}\"`);\n90:       frontmatterLines.push('      session_id: \"test-session\"');\n91:       frontmatterLines.push('      parent_session_id: null');\n92:     }\n93:     frontmatterLines.push('    completion_pct: 0');\n94:     frontmatterLines.push('    open_questions: []');\n95:     frontmatterLines.push('    answered_questions: []');\n96:   }\n97:   frontmatterLines.push('---', '', '| File Path | Change Type | Description |', '|-----------|-------------|-------------|', '| `implementation-summary.md` | Modify | Freshness fixture |');\n98:   fs.writeFileSync(path.join(specFolder, 'implementation-summary.md'), frontmatterLines.join('\\n'), 'utf-8');\n99: }\n100: \n101: // Stamps a fingerprint that will actually match on read-back: write the\n102: // placeholder first, then recompute over that exact content (the field is\n103: // normalized to the zero placeholder before hashing either way) and patch it in.\n104: function stampRealFingerprint(specFolder: string): void {\n105:   const summaryPath = path.join(specFolder, 'implementation-summary.md');\n106:   const content = fs.readFileSync(summaryPath, 'utf-8');\n107:   const recomputed = buildContinuityFingerprint(content);\n108:   fs.writeFileSync(summaryPath, content.replace(ZERO_CONTINUITY_FINGERPRINT, recomputed), 'utf-8');\n109: }\n110: \n111: function runValidateStrict(specFolder: string): { exitCode: number; stdout: string; stderr: string } {\n112:   const result = spawnSync('bash', [VALIDATE_SCRIPT, specFolder, '--strict'], {\n113:     cwd: path.resolve(specFolder, '..', '..', '..', '..'),\n114:     encoding: 'utf-8',\n115:     env: {\n116:       ...process.env,\n117:       SPECKIT_RULES: 'GRAPH_METADATA_PRESENT,CONTINUITY_FRESHNESS',\n118:     },\n119:   });\n120: \n121:   return {\n122:     exitCode: result.status ?? 1,\n123:     stdout: result.stdout ?? '',\n124:     stderr: result.stderr ?? '',\n125:   };\n126: }\n127: \n128: afterEach(() => {\n129:   for (const root of createdRoots) {\n130:     fs.rmSync(root, { recursive: true, force: true });\n131:   }\n132:   createdRoots.clear();\n133: });\n134: \n135: describe('continuity-freshness', () => {\n136:   it('passes when continuity is within the 10-minute freshness budget', () => {\n137:     const root = makeWorkspace();\n138:     const specFolder = createSpecFolder(root, '920-continuity-fresh');\n139:     writeImplementationSummary(specFolder, '2026-04-17T12:00:00Z');\n140:     refreshGraphMetadataForSpecFolder(specFolder, { now: '2026-04-17T12:09:59Z' });\n141: \n142:     const result = validateContinuityFreshness(specFolder);\n143: \n144:     expect(result.status).toBe('pass');\n145:     expect(result.code).toBe('fresh');\n146:   });\n147: \n148:   it('warns when graph metadata is more than 10 minutes newer than continuity', () => {\n149:     const root = makeWorkspace();\n150:     const specFolder = createSpecFolder(root, '921-continuity-stale');\n151:     writeImplementationSummary(specFolder, '2026-04-17T12:00:00Z');\n152:     refreshGraphMetadataForSpecFolder(specFolder, { now: '2026-04-17T12:10:01Z' });\n153: \n154:     const result = validateContinuityFreshness(specFolder);\n155: \n156:     expect(result.status).toBe('warn');\n157:     expect(result.code).toBe('stale');\n158:     expect(result.deltaMs).toBe(601000);\n159:   });\n160: \n161:   it('skips cleanly when continuity frontmatter is missing', () => {\n162:     const root = makeWorkspace();\n163:     const specFolder = createSpecFolder(root, '922-continuity-missing-frontmatter');\n164:     writeImplementationSummary(specFolder);\n165:     refreshGraphMetadataForSpecFolder(specFolder, { now: '2026-04-17T12:10:01Z' });\n166: \n167:     const result = validateContinuityFreshness(specFolder);\n168: \n169:     expect(result.status).toBe('pass');\n170:     expect(result.code).toBe('missing_frontmatter');\n171:   });\n172: \n173:   it('skips cleanly when graph metadata is missing', () => {\n174:     const root = makeWorkspace();\n175:     const specFolder = createSpecFolder(root, '923-continuity-missing-graph');\n176:     writeImplementationSummary(specFolder, '2026-04-17T12:00:00Z');\n177: \n178:     const result = validateContinuityFreshness(specFolder);\n179: \n180:     expect(result.status).toBe('pass');\n\n(Showing lines 1-180 of 282. Use offset=181 to continue.)\n</content>","metadata":{"preview":"import fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { spawnSync } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nimport { buildContinuityFingerprint, refreshGraphMetadataForSpecFolder, ZERO_CONTINUITY_FINGERPRINT } from '../../api';\nimport { validateContinuityFreshness } from '../validation/continuity-freshness.js';\n\nconst createdRoots = new Set<string>();\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\nconst SKILL_ROOT = path.resolve(__dirname, '..', '..', '..');\nconst VALIDATE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'validate.sh');\nconst RULE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'dist', 'validation', 'continuity-freshness.js');\n\nfunction makeWorkspace(): string {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'continuity-freshness-'));\n  createdRoots.add(root);","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/continuity-freshness.vitest.ts","text":"import fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { spawnSync } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nimport { buildContinuityFingerprint, refreshGraphMetadataForSpecFolder, ZERO_CONTINUITY_FINGERPRINT } from '../../api';\nimport { validateContinuityFreshness } from '../validation/continuity-freshness.js';\n\nconst createdRoots = new Set<string>();\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\nconst SKILL_ROOT = path.resolve(__dirname, '..', '..', '..');\nconst VALIDATE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec', 'validate.sh');\nconst RULE_SCRIPT = path.join(SKILL_ROOT, 'runtime', 'cli', 'dist', 'validation', 'continuity-freshness.js');\n\nfunction makeWorkspace(): string {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'continuity-freshness-'));\n  createdRoots.add(root);\n  return root;\n}\n\n// No completion claim by default -- exercises the last_updated_at-vs-\n// graph-metadata staleness path. Tests that need a completion claim use\n// createSpecFolderWithCompletionClaim instead.\nfunction createSpecFolder(workspaceRoot: string, name: string): string {\n  const specFolder = path.join(workspaceRoot, '.opencode', 'specs', 'system-spec-kit', name);\n  fs.mkdirSync(specFolder, { recursive: true });\n  fs.writeFileSync(path.join(specFolder, 'spec.md'), [\n    '---',\n    'title: \"Continuity Freshness Fixture\"',\n    'description: \"Fixture for continuity freshness validation.\"',\n    'trigger_phrases: [\"continuity freshness\"]',\n    'importance_tier: \"important\"',\n    'status: \"planned\"',\n    '---',\n    '',\n    '# Fixture',\n  ].join('\\n'), 'utf-8');\n  fs.writeFileSync(path.join(specFolder, 'plan.md'), '# Plan\\n', 'utf-8');\n  fs.writeFileSync(path.join(specFolder, 'tasks.md'), '# Tasks\\n', 'utf-8');\n  return specFolder;\n}\n\n// Claims completion the way a real packet does: spec.md's metadata table,\n// not its frontmatter -- implementation-summary.md carries no status of its\n// own, as real closed packets do, so the claim binds to its fingerprint alone.\nfunction createSpecFolderWithCompletionClaim(workspaceRoot: string, name: string): string {\n  const specFolder = path.join(workspaceRoot, '.opencode', 'specs', 'system-spec-kit', name);\n  fs.mkdirSync(specFolder, { recursive: true });\n  fs.writeFileSync(path.join(specFolder, 'spec.md'), [\n    '---',\n    'title: \"Continuity Freshness Completion Fixture\"',\n    'description: \"Fixture for completion-claim continuity freshness validation.\"',\n    'trigger_phrases: [\"continuity freshness\"]',\n    'importance_tier: \"important\"',\n    '---',\n    '',\n    '# Fixture',\n    '',\n    '| Field | Value |',\n    '|-------|-------|',\n    '| **Status** | Complete |',\n  ].join('\\n'), 'utf-8');\n  fs.writeFileSync(path.join(specFolder, 'plan.md'), '# Plan\\n', 'utf-8');\n  fs.writeFileSync(path.join(specFolder, 'tasks.md'), '# Tasks\\n', 'utf-8');\n  return specFolder;\n}\n\nfunction writeImplementationSummary(specFolder: string, continuityTimestamp?: string, fingerprint?: string): void {\n  const frontmatterLines = [\n    '---',\n    'title: \"Implementation Summary\"',\n    'status: \"planned\"',\n  ];\n  if (continuityTimestamp) {\n    frontmatterLines.push('_memory:');\n    frontmatterLines.push('  continuity:');\n    frontmatterLines.push('    packet_pointer: \"system-spec-kit/test-packet\"');\n    frontmatterLines.push(`    last_updated_at: \"${continuityTimestamp}\"`);\n    frontmatterLines.push('    last_updated_by: \"tester\"');\n    frontmatterLines.push('    recent_action: \"Validated freshness\"');\n    frontmatterLines.push('    next_safe_action: \"Keep timestamps aligned\"');\n    frontmatterLines.push('    blockers: []');\n    frontmatterLines.push('    key_files: []');\n    if (fingerprint) {\n      frontmatterLines.push('    session_dedup:');\n      frontmatterLines.push(`      fingerprint: \"${fingerprint}\"`);\n      frontmatterLines.push('      session_id: \"test-session\"');\n      frontmatterLines.push('      parent_session_id: null');\n    }\n    frontmatterLines.push('    completion_pct: 0');\n    frontmatterLines.push('    open_questions: []');\n    frontmatterLines.push('    answered_questions: []');\n  }\n  frontmatterLines.push('---', '', '| File Path | Change Type | Description |', '|-----------|-------------|-------------|', '| `implementation-summary.md` | Modify | Freshness fixture |');\n  fs.writeFileSync(path.join(specFolder, 'implementation-summary.md'), frontmatterLines.join('\\n'), 'utf-8');\n}\n\n// Stamps a fingerprint that will actually match on read-back: write the\n// placeholder first, then recompute over that exact content (the field is\n// normalized to the zero placeholder before hashing either way) and patch it in.\nfunction stampRealFingerprint(specFolder: string): void {\n  const summaryPath = path.join(specFolder, 'implementation-summary.md');\n  const content = fs.readFileSync(summaryPath, 'utf-8');\n  const recomputed = buildContinuityFingerprint(content);\n  fs.writeFileSync(summaryPath, content.replace(ZERO_CONTINUITY_FINGERPRINT, recomputed), 'utf-8');\n}\n\nfunction runValidateStrict(specFolder: string): { exitCode: number; stdout: string; stderr: string } {\n  const result = spawnSync('bash', [VALIDATE_SCRIPT, specFolder, '--strict'], {\n    cwd: path.resolve(specFolder, '..', '..', '..', '..'),\n    encoding: 'utf-8',\n    env: {\n      ...process.env,\n      SPECKIT_RULES: 'GRAPH_METADATA_PRESENT,CONTINUITY_FRESHNESS',\n    },\n  });\n\n  return {\n    exitCode: result.status ?? 1,\n    stdout: result.stdout ?? '',\n    stderr: result.stderr ?? '',\n  };\n}\n\nafterEach(() => {\n  for (const root of createdRoots) {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n  createdRoots.clear();\n});\n\ndescribe('continuity-freshness', () => {\n  it('passes when continuity is within the 10-minute freshness budget', () => {\n    const root = makeWorkspace();\n    const specFolder = createSpecFolder(root, '920-continuity-fresh');\n    writeImplementationSummary(specFolder, '2026-04-17T12:00:00Z');\n    refreshGraphMetadataForSpecFolder(specFolder, { now: '2026-04-17T12:09:59Z' });\n\n    const result = validateContinuityFreshness(specFolder);\n\n    expect(result.status).toBe('pass');\n    expect(result.code).toBe('fresh');\n  });\n\n  it('warns when graph metadata is more than 10 minutes newer than continuity', () => {\n    const root = makeWorkspace();\n    const specFolder = createSpecFolder(root, '921-continuity-stale');\n    writeImplementationSummary(specFolder, '2026-04-17T12:00:00Z');\n    refreshGraphMetadataForSpecFolder(specFolder, { now: '2026-04-17T12:10:01Z' });\n\n    const result = validateContinuityFreshness(specFolder);\n\n    expect(result.status).toBe('warn');\n    expect(result.code).toBe('stale');\n    expect(result.deltaMs).toBe(601000);\n  });\n\n  it('skips cleanly when continuity frontmatter is missing', () => {\n    const root = makeWorkspace();\n    const specFolder = createSpecFolder(root, '922-continuity-missing-frontmatter');\n    writeImplementationSummary(specFolder);\n    refreshGraphMetadataForSpecFolder(specFolder, { now: '2026-04-17T12:10:01Z' });\n\n    const result = validateContinuityFreshness(specFolder);\n\n    expect(result.status).toBe('pass');\n    expect(result.code).toBe('missing_frontmatter');\n  });\n\n  it('skips cleanly when graph metadata is missing', () => {\n    const root = makeWorkspace();\n    const specFolder = createSpecFolder(root, '923-continuity-missing-graph');\n    writeImplementationSummary(specFolder, '2026-04-17T12:00:00Z');\n\n    const result = validateContinuityFreshness(specFolder);\n\n    expect(result.status).toBe('pass');","lineStart":1,"lineEnd":180,"totalLines":282,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/continuity-freshness.vitest.ts","time":{"start":1788632229647,"end":1788632229686}},"id":"prt_072c9e70c0012Ah0dwKZN8sokI","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
{"type":"tool_use","timestamp":1788632229691,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_5M4OMoZjNEZqcdK3R9xylTz7","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ Sync Runtime Mirrors                                                     ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: //\n5: // Claude, Cursor, and Devin discover agents and commands by file convention,\n6: // each at its own path and in its own shape. Rather than fork the content, every\n7: // entry is a symlink back to one canonical file, so a mirror cannot drift from\n8: // what it mirrors. This script owns those symlink trees.\n9: //\n10: // A real file sitting where a symlink belongs is the failure this guards: it\n11: // still works today and silently stops tracking the source tomorrow. That is\n12: // reported as STALE, never quietly accepted.\n13: //\n14: // Hook mirrors are derived from each runtime's own hook config rather than a\n15: // hand-kept list, because the config is what the runtime actually executes; a\n16: // list would be one more thing to forget to update.\n17: \n18: 'use strict';\n19: \n20: // ───────────────────────────────────────────────────────────────\n21: // 1. IMPORTS\n22: // ───────────────────────────────────────────────────────────────\n23: \n24: const fs = require('node:fs');\n25: const path = require('node:path');\n26: const { isCanonicalMirrorExcluded, isRuntimeNativeCommand } = require('./command-scope.cjs');\n27: \n28: // ───────────────────────────────────────────────────────────────\n29: // 2. CONSTANTS\n30: // ───────────────────────────────────────────────────────────────\n31: \n32: const REPO_ROOT = path.resolve(__dirname, '../../../../../..');\n33: const EXCLUDED_COMMAND_DIRS = new Set(['assets', 'scripts', 'fixtures']);\n34: \n35: // Cursor and Devin parse the Claude agent dialect (`tools:`), not OpenCode's\n36: // `permission:` block, so agents deliberately source from .claude/agents.\n37: // Commands have no dialect split and source from .opencode directly.\n38: const CLAUDE_AGENTS = '.claude/agents';\n39: const CLAUDE_COMMANDS = '.claude/commands';\n40: const OPENCODE_COMMANDS = '.opencode/commands';\n41: \n42: const HOOK_CONFIGS = [\n43:   { runtime: 'claude', config: '.claude/settings.json', mirror: '.claude/hooks' },\n44:   { runtime: 'codex', config: '.codex/hooks.json', mirror: '.codex/hooks' },\n45:   { runtime: 'cursor', config: '.cursor/hooks.json', mirror: '.cursor/hooks' },\n46:   { runtime: 'devin', config: '.devin/hooks.v1.json', mirror: '.devin/hooks' },\n47: ];\n48: \n49: // ───────────────────────────────────────────────────────────────\n50: // 3. HELPERS\n51: // ───────────────────────────────────────────────────────────────\n52: \n53: function parseArguments(argv) {\n54:   if (argv.length === 0) {\n55:     return { check: false };\n56:   }\n57:   if (argv.length === 1 && argv[0] === '--check') {\n58:     return { check: true };\n59:   }\n60:   throw new Error('Usage: node sync-runtime-mirrors.cjs [--check]');\n61: }\n62: \n63: function listAgentNames() {\n64:   const dir = path.join(REPO_ROOT, CLAUDE_AGENTS);\n65:   if (!fs.existsSync(dir)) {\n66:     throw new Error(`No canonical agents found at ${CLAUDE_AGENTS}`);\n67:   }\n68:   return fs.readdirSync(dir, { withFileTypes: true })\n69:     .filter((e) => e.isFile() && e.name.endsWith('.md'))\n70:     .map((e) => e.name.slice(0, -3))\n71:     .sort();\n72: }\n73: \n74: function listCommandPaths() {\n75:   const root = path.join(REPO_ROOT, OPENCODE_COMMANDS);\n76:   if (!fs.existsSync(root)) {\n77:     throw new Error(`No canonical commands found at ${OPENCODE_COMMANDS}`);\n78:   }\n79:   const found = [];\n80:   const walk = (current) => {\n81:     for (const entry of fs.readdirSync(current, { withFileTypes: true })) {\n82:       const absolute = path.join(current, entry.name);\n83:       if (entry.isDirectory()) {\n84:         if (!EXCLUDED_COMMAND_DIRS.has(entry.name)) walk(absolute);\n85:         continue;\n86:       }\n87:       if (!entry.isFile() || !entry.name.endsWith('.md')) continue;\n88:       if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) continue;\n89:       found.push(path.relative(root, absolute).split(path.sep).join('/'));\n90:     }\n91:   };\n92:   walk(root);\n93:   return found.sort();\n94: }\n95: \n96: // `create/agent.md` -> `create-agent`: both runtimes expose a flat namespace,\n97: // so the directory separator collapses into the name.\n98: function toFlatName(relativePath) {\n99:   return relativePath.replace(/\\.md$/, '').split('/').join('-');\n100: }\n\n(Showing lines 1-100 of 319. Use offset=101 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Sync Runtime Mirrors                                                     ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n//\n// Claude, Cursor, and Devin discover agents and commands by file convention,\n// each at its own path and in its own shape. Rather than fork the content, every\n// entry is a symlink back to one canonical file, so a mirror cannot drift from\n// what it mirrors. This script owns those symlink trees.\n//\n// A real file sitting where a symlink belongs is the failure this guards: it\n// still works today and silently stops tracking the source tomorrow. That is\n// reported as STALE, never quietly accepted.\n//\n// Hook mirrors are derived from each runtime's own hook config rather than a\n// hand-kept list, because the config is what the runtime actually executes; a\n// list would be one more thing to forget to update.\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Sync Runtime Mirrors                                                     ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n//\n// Claude, Cursor, and Devin discover agents and commands by file convention,\n// each at its own path and in its own shape. Rather than fork the content, every\n// entry is a symlink back to one canonical file, so a mirror cannot drift from\n// what it mirrors. This script owns those symlink trees.\n//\n// A real file sitting where a symlink belongs is the failure this guards: it\n// still works today and silently stops tracking the source tomorrow. That is\n// reported as STALE, never quietly accepted.\n//\n// Hook mirrors are derived from each runtime's own hook config rather than a\n// hand-kept list, because the config is what the runtime actually executes; a\n// list would be one more thing to forget to update.\n\n'use strict';\n\n// ───────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { isCanonicalMirrorExcluded, isRuntimeNativeCommand } = require('./command-scope.cjs');\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst REPO_ROOT = path.resolve(__dirname, '../../../../../..');\nconst EXCLUDED_COMMAND_DIRS = new Set(['assets', 'scripts', 'fixtures']);\n\n// Cursor and Devin parse the Claude agent dialect (`tools:`), not OpenCode's\n// `permission:` block, so agents deliberately source from .claude/agents.\n// Commands have no dialect split and source from .opencode directly.\nconst CLAUDE_AGENTS = '.claude/agents';\nconst CLAUDE_COMMANDS = '.claude/commands';\nconst OPENCODE_COMMANDS = '.opencode/commands';\n\nconst HOOK_CONFIGS = [\n  { runtime: 'claude', config: '.claude/settings.json', mirror: '.claude/hooks' },\n  { runtime: 'codex', config: '.codex/hooks.json', mirror: '.codex/hooks' },\n  { runtime: 'cursor', config: '.cursor/hooks.json', mirror: '.cursor/hooks' },\n  { runtime: 'devin', config: '.devin/hooks.v1.json', mirror: '.devin/hooks' },\n];\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\n\nfunction parseArguments(argv) {\n  if (argv.length === 0) {\n    return { check: false };\n  }\n  if (argv.length === 1 && argv[0] === '--check') {\n    return { check: true };\n  }\n  throw new Error('Usage: node sync-runtime-mirrors.cjs [--check]');\n}\n\nfunction listAgentNames() {\n  const dir = path.join(REPO_ROOT, CLAUDE_AGENTS);\n  if (!fs.existsSync(dir)) {\n    throw new Error(`No canonical agents found at ${CLAUDE_AGENTS}`);\n  }\n  return fs.readdirSync(dir, { withFileTypes: true })\n    .filter((e) => e.isFile() && e.name.endsWith('.md'))\n    .map((e) => e.name.slice(0, -3))\n    .sort();\n}\n\nfunction listCommandPaths() {\n  const root = path.join(REPO_ROOT, OPENCODE_COMMANDS);\n  if (!fs.existsSync(root)) {\n    throw new Error(`No canonical commands found at ${OPENCODE_COMMANDS}`);\n  }\n  const found = [];\n  const walk = (current) => {\n    for (const entry of fs.readdirSync(current, { withFileTypes: true })) {\n      const absolute = path.join(current, entry.name);\n      if (entry.isDirectory()) {\n        if (!EXCLUDED_COMMAND_DIRS.has(entry.name)) walk(absolute);\n        continue;\n      }\n      if (!entry.isFile() || !entry.name.endsWith('.md')) continue;\n      if (entry.name === 'README.md' || entry.name.endsWith('.contract.md')) continue;\n      found.push(path.relative(root, absolute).split(path.sep).join('/'));\n    }\n  };\n  walk(root);\n  return found.sort();\n}\n\n// `create/agent.md` -> `create-agent`: both runtimes expose a flat namespace,\n// so the directory separator collapses into the name.\nfunction toFlatName(relativePath) {\n  return relativePath.replace(/\\.md$/, '').split('/').join('-');\n}","lineStart":1,"lineEnd":100,"totalLines":319,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs","time":{"start":1788632229660,"end":1788632229687}},"id":"prt_072c9e71b001YtcVrk8SeG2h4q","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
{"type":"tool_use","timestamp":1788632229691,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_Zro4LrRDkEOSphQINkKdbYkn","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/validation-gate-hardening.vitest.ts","offset":1,"limit":120},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/validation-gate-hardening.vitest.ts</path>\n<type>file</type>\n<content>\n1: import { spawnSync } from 'node:child_process';\n2: import fs from 'node:fs';\n3: import os from 'node:os';\n4: import path from 'node:path';\n5: import { fileURLToPath } from 'node:url';\n6: \n7: import { afterEach, describe, expect, it } from 'vitest';\n8: \n9: const __dirname = path.dirname(fileURLToPath(import.meta.url));\n10: const scriptsRoot = path.resolve(__dirname, '..');\n11: const repoRoot = path.resolve(scriptsRoot, '..', '..', '..', '..', '..');\n12: const validateScript = path.join(scriptsRoot, 'spec', 'validate.sh');\n13: const statusClassifier = path.join(scriptsRoot, 'lib', 'status-classifier.sh');\n14: const sweepScript = path.join(scriptsRoot, 'sweep', 'strict-pass-freshness.ts');\n15: const tsxLoader = path.join(scriptsRoot, '..', '..', 'node_modules', 'tsx', 'dist', 'loader.mjs');\n16: const createdRoots = new Set<string>();\n17: \n18: function makeWorkspace(): string {\n19:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'validation-hardening-'));\n20:   createdRoots.add(root);\n21:   return root;\n22: }\n23: \n24: function makeRepoWorkspace(): string {\n25:   const scratchRoot = path.join(repoRoot, 'scratch');\n26:   fs.mkdirSync(scratchRoot, { recursive: true });\n27:   const root = fs.mkdtempSync(path.join(scratchRoot, 'validation-hardening-'));\n28:   createdRoots.add(root);\n29:   return root;\n30: }\n31: \n32: function writeFile(filePath: string, content: string): void {\n33:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n34:   fs.writeFileSync(filePath, content, 'utf8');\n35: }\n36: \n37: function createPacket(workspace: string, packetId: string, options: {\n38:   specStatus?: string;\n39:   implementationStatus?: string;\n40:   metadataId?: string;\n41:   parentId?: string | null;\n42:   checklist?: string;\n43:   tasks?: string;\n44:   scaffoldMarker?: boolean;\n45: } = {}): string {\n46:   const folder = path.join(workspace, '.opencode', 'specs', packetId);\n47:   const specStatus = options.specStatus ?? 'Planned';\n48:   const implementationStatus = options.implementationStatus ?? specStatus;\n49:   const metadataId = options.metadataId ?? packetId;\n50:   const parentId = options.parentId === undefined ? packetId.split('/').slice(0, -1).join('/') : options.parentId;\n51:   fs.mkdirSync(folder, { recursive: true });\n52:   writeFile(path.join(folder, 'spec.md'), [\n53:     '---',\n54:     'title: \"Fixture Spec\"',\n55:     '_memory:',\n56:     '  continuity:',\n57:     `    packet_pointer: \"${metadataId}\"`,\n58:     '---',\n59:     '# Fixture Spec',\n60:     '<!-- SPECKIT_LEVEL: 2 -->',\n61:     '| Field | Value |',\n62:     '|-------|-------|',\n63:     `| **Status** | ${specStatus} |`,\n64:   ].join('\\n'));\n65:   writeFile(path.join(folder, 'plan.md'), '# Plan\\n');\n66:   writeFile(path.join(folder, 'tasks.md'), options.tasks ?? '- [ ] T001 Pending task\\n');\n67:   writeFile(path.join(folder, 'checklist.md'), options.checklist ?? '- [ ] CHK-001 [P0] Pending check\\n');\n68:   writeFile(path.join(folder, 'implementation-summary.md'), [\n69:     '---',\n70:     'title: \"Implementation Summary\"',\n71:     '_memory:',\n72:     '  continuity:',\n73:     // SCAFFOLD_NEVER_TOUCHED reads packet_pointer's own scaffold/ prefix as its\n74:     // durable signal, not last_updated_by, which is a value the scaffold's own\n75:     // author could edit away without doing the real work.\n76:     options.scaffoldMarker ? `    packet_pointer: \"scaffold/${metadataId}\"` : `    packet_pointer: \"${metadataId}\"`,\n77:     '    last_updated_by: \"test-author\"',\n78:     '    completion_pct: 100',\n79:     '---',\n80:     '# Implementation Summary',\n81:     '| Field | Value |',\n82:     '|-------|-------|',\n83:     `| **Status** | ${implementationStatus} |`,\n84:   ].join('\\n'));\n85:   writeFile(path.join(folder, 'description.json'), JSON.stringify({ specFolder: metadataId, description: 'fixture' }, null, 2));\n86:   writeFile(path.join(folder, 'graph-metadata.json'), JSON.stringify({\n87:     schema_version: 1,\n88:     packet_id: metadataId,\n89:     spec_folder: metadataId,\n90:     parent_id: parentId,\n91:     children_ids: [],\n92:     manual: { depends_on: [], supersedes: [], related_to: [] },\n93:     derived: { status: 'complete', source_docs: ['spec.md'] },\n94:   }, null, 2));\n95:   return folder;\n96: }\n97: \n98: function runValidate(folder: string, rules: string, env: Record<string, string> = {}): { code: number; stdout: string; stderr: string } {\n99:   const result = spawnSync('bash', [validateScript, folder, '--strict', '--no-recursive'], {\n100:     cwd: repoRoot,\n101:     encoding: 'utf8',\n102:     env: { ...process.env, SPECKIT_RULES: rules, ...env },\n103:   });\n104:   return { code: result.status ?? 1, stdout: result.stdout ?? '', stderr: result.stderr ?? '' };\n105: }\n106: \n107: afterEach(() => {\n108:   for (const root of createdRoots) fs.rmSync(root, { recursive: true, force: true });\n109:   createdRoots.clear();\n110: });\n111: \n112: describe('validation gate hardening', () => {\n113:   it('classifies complete and non-complete status variants', () => {\n114:     const script = `source \"${statusClassifier}\"; for value in \"Complete\" \"Shipped\" \"Done\" \"COMPLETE \" \"complete.\" \"Planned\" \"Draft\" \"In Progress\"; do classify_status \"$value\"; done`;\n115:     const result = spawnSync('bash', ['-lc', script], { encoding: 'utf8' });\n116:     expect(result.status).toBe(0);\n117:     expect(result.stdout.trim().split('\\n')).toEqual([\n118:       'complete',\n119:       'complete',\n120:       'complete',\n\n(Showing lines 1-120 of 282. Use offset=121 to continue.)\n</content>","metadata":{"preview":"import { spawnSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\nconst scriptsRoot = path.resolve(__dirname, '..');\nconst repoRoot = path.resolve(scriptsRoot, '..', '..', '..', '..', '..');\nconst validateScript = path.join(scriptsRoot, 'spec', 'validate.sh');\nconst statusClassifier = path.join(scriptsRoot, 'lib', 'status-classifier.sh');\nconst sweepScript = path.join(scriptsRoot, 'sweep', 'strict-pass-freshness.ts');\nconst tsxLoader = path.join(scriptsRoot, '..', '..', 'node_modules', 'tsx', 'dist', 'loader.mjs');\nconst createdRoots = new Set<string>();\n\nfunction makeWorkspace(): string {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'validation-hardening-'));\n  createdRoots.add(root);","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/validation-gate-hardening.vitest.ts","text":"import { spawnSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { afterEach, describe, expect, it } from 'vitest';\n\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\nconst scriptsRoot = path.resolve(__dirname, '..');\nconst repoRoot = path.resolve(scriptsRoot, '..', '..', '..', '..', '..');\nconst validateScript = path.join(scriptsRoot, 'spec', 'validate.sh');\nconst statusClassifier = path.join(scriptsRoot, 'lib', 'status-classifier.sh');\nconst sweepScript = path.join(scriptsRoot, 'sweep', 'strict-pass-freshness.ts');\nconst tsxLoader = path.join(scriptsRoot, '..', '..', 'node_modules', 'tsx', 'dist', 'loader.mjs');\nconst createdRoots = new Set<string>();\n\nfunction makeWorkspace(): string {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'validation-hardening-'));\n  createdRoots.add(root);\n  return root;\n}\n\nfunction makeRepoWorkspace(): string {\n  const scratchRoot = path.join(repoRoot, 'scratch');\n  fs.mkdirSync(scratchRoot, { recursive: true });\n  const root = fs.mkdtempSync(path.join(scratchRoot, 'validation-hardening-'));\n  createdRoots.add(root);\n  return root;\n}\n\nfunction writeFile(filePath: string, content: string): void {\n  fs.mkdirSync(path.dirname(filePath), { recursive: true });\n  fs.writeFileSync(filePath, content, 'utf8');\n}\n\nfunction createPacket(workspace: string, packetId: string, options: {\n  specStatus?: string;\n  implementationStatus?: string;\n  metadataId?: string;\n  parentId?: string | null;\n  checklist?: string;\n  tasks?: string;\n  scaffoldMarker?: boolean;\n} = {}): string {\n  const folder = path.join(workspace, '.opencode', 'specs', packetId);\n  const specStatus = options.specStatus ?? 'Planned';\n  const implementationStatus = options.implementationStatus ?? specStatus;\n  const metadataId = options.metadataId ?? packetId;\n  const parentId = options.parentId === undefined ? packetId.split('/').slice(0, -1).join('/') : options.parentId;\n  fs.mkdirSync(folder, { recursive: true });\n  writeFile(path.join(folder, 'spec.md'), [\n    '---',\n    'title: \"Fixture Spec\"',\n    '_memory:',\n    '  continuity:',\n    `    packet_pointer: \"${metadataId}\"`,\n    '---',\n    '# Fixture Spec',\n    '<!-- SPECKIT_LEVEL: 2 -->',\n    '| Field | Value |',\n    '|-------|-------|',\n    `| **Status** | ${specStatus} |`,\n  ].join('\\n'));\n  writeFile(path.join(folder, 'plan.md'), '# Plan\\n');\n  writeFile(path.join(folder, 'tasks.md'), options.tasks ?? '- [ ] T001 Pending task\\n');\n  writeFile(path.join(folder, 'checklist.md'), options.checklist ?? '- [ ] CHK-001 [P0] Pending check\\n');\n  writeFile(path.join(folder, 'implementation-summary.md'), [\n    '---',\n    'title: \"Implementation Summary\"',\n    '_memory:',\n    '  continuity:',\n    // SCAFFOLD_NEVER_TOUCHED reads packet_pointer's own scaffold/ prefix as its\n    // durable signal, not last_updated_by, which is a value the scaffold's own\n    // author could edit away without doing the real work.\n    options.scaffoldMarker ? `    packet_pointer: \"scaffold/${metadataId}\"` : `    packet_pointer: \"${metadataId}\"`,\n    '    last_updated_by: \"test-author\"',\n    '    completion_pct: 100',\n    '---',\n    '# Implementation Summary',\n    '| Field | Value |',\n    '|-------|-------|',\n    `| **Status** | ${implementationStatus} |`,\n  ].join('\\n'));\n  writeFile(path.join(folder, 'description.json'), JSON.stringify({ specFolder: metadataId, description: 'fixture' }, null, 2));\n  writeFile(path.join(folder, 'graph-metadata.json'), JSON.stringify({\n    schema_version: 1,\n    packet_id: metadataId,\n    spec_folder: metadataId,\n    parent_id: parentId,\n    children_ids: [],\n    manual: { depends_on: [], supersedes: [], related_to: [] },\n    derived: { status: 'complete', source_docs: ['spec.md'] },\n  }, null, 2));\n  return folder;\n}\n\nfunction runValidate(folder: string, rules: string, env: Record<string, string> = {}): { code: number; stdout: string; stderr: string } {\n  const result = spawnSync('bash', [validateScript, folder, '--strict', '--no-recursive'], {\n    cwd: repoRoot,\n    encoding: 'utf8',\n    env: { ...process.env, SPECKIT_RULES: rules, ...env },\n  });\n  return { code: result.status ?? 1, stdout: result.stdout ?? '', stderr: result.stderr ?? '' };\n}\n\nafterEach(() => {\n  for (const root of createdRoots) fs.rmSync(root, { recursive: true, force: true });\n  createdRoots.clear();\n});\n\ndescribe('validation gate hardening', () => {\n  it('classifies complete and non-complete status variants', () => {\n    const script = `source \"${statusClassifier}\"; for value in \"Complete\" \"Shipped\" \"Done\" \"COMPLETE \" \"complete.\" \"Planned\" \"Draft\" \"In Progress\"; do classify_status \"$value\"; done`;\n    const result = spawnSync('bash', ['-lc', script], { encoding: 'utf8' });\n    expect(result.status).toBe(0);\n    expect(result.stdout.trim().split('\\n')).toEqual([\n      'complete',\n      'complete',\n      'complete',","lineStart":1,"lineEnd":120,"totalLines":282,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/validation-gate-hardening.vitest.ts","time":{"start":1788632229658,"end":1788632229688}},"id":"prt_072c9e719001TuHuGEKq61vQE6","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
{"type":"tool_use","timestamp":1788632229691,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_57hdR0g2ZZXmmuAAC1fKgmQt","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts","offset":1,"limit":220},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Generated Metadata Drift Gate and Shared Synopsis Extractor\n3: // ───────────────────────────────────────────────────────────────\n4: // Proves the two synopsis-and-freshness fixes. The shared extractor derives both the\n5: // description and the causal_summary from one precedence over the same spec.md, each honoring\n6: // its own length limit, so flipping the source doc moves both fields together. The drift gate\n7: // re-derives one folder and reports drift on a changed folder, no drift on an in-sync folder,\n8: // and never writes the folder. source_doc_hashes is the cheap freshness key. The resolver maps\n9: // drift to a non-blocking info under grandfather report mode and to a blocking error when the\n10: // drift-gate flag enforces.\n11: \n12: import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n13: import * as crypto from 'node:crypto';\n14: import * as fs from 'node:fs';\n15: import * as os from 'node:os';\n16: import * as path from 'node:path';\n17: \n18: import {\n19:   checkGeneratedMetadataDrift,\n20:   computeSourceDocHashes,\n21:   deriveGraphMetadata,\n22:   resolveGeneratedMetadataDrift,\n23:   serializeGraphMetadata,\n24: } from '../../api';\n25: import {\n26:   derivePacketSynopsis,\n27:   SYNOPSIS_FIELD_LIMITS,\n28: } from '../../lib/description/packet-synopsis.js';\n29: \n30: const DRIFT_GATE_FLAG = 'SPECKIT_GENERATED_METADATA_DRIFT_GATE';\n31: \n32: // An Overview paragraph longer than the description ceiling so the two fields capture\n33: // different amounts of the same source, which is what proves the per-field limit.\n34: const LONG_OVERVIEW =\n35:   'This packet adds a generated metadata drift gate and a shared synopsis extractor so the '\n36:   + 'description and the causal summary stop diverging from the same source doc and a stale '\n37:   + 'synopsis is provable rather than silently carried forward across many sessions.';\n38: \n39: function specWithOverview(overview: string): string {\n40:   return [\n41:     '---',\n42:     'title: \"Fixture spec\"',\n43:     'description: \"Frontmatter description fallback\"',\n44:     '---',\n45:     '# Fixture Spec',\n46:     '',\n47:     '## 1. SUMMARY',\n48:     '',\n49:     '### Overview',\n50:     overview,\n51:     '',\n52:     '## 2. PROBLEM',\n53:     '',\n54:     'Some problem text.',\n55:     '',\n56:   ].join('\\n');\n57: }\n58: \n59: let tmpDir: string;\n60: \n61: function writeFolder(files: Record<string, string>): string {\n62:   const folder = fs.mkdtempSync(path.join(tmpDir, 'packet-'));\n63:   for (const [relativePath, content] of Object.entries(files)) {\n64:     const target = path.join(folder, relativePath);\n65:     fs.mkdirSync(path.dirname(target), { recursive: true });\n66:     fs.writeFileSync(target, content, 'utf-8');\n67:   }\n68:   return folder;\n69: }\n70: \n71: function snapshotFolder(folder: string): Record<string, string> {\n72:   const snapshot: Record<string, string> = {};\n73:   for (const entry of fs.readdirSync(folder, { recursive: true, withFileTypes: true })) {\n74:     if (!entry.isFile()) continue;\n75:     const dir = (entry as unknown as { parentPath?: string; path?: string }).parentPath\n76:       ?? (entry as unknown as { path?: string }).path\n77:       ?? folder;\n78:     const abs = path.join(dir, entry.name);\n79:     const rel = path.relative(folder, abs);\n80:     snapshot[rel] = crypto.createHash('sha256').update(fs.readFileSync(abs)).digest('hex');\n81:   }\n82:   return snapshot;\n83: }\n84: \n85: function writeDerivedGraph(folder: string): void {\n86:   // Build a graph-metadata.json from the current docs with the drift-gate flag on, so the\n87:   // stored causal_summary comes from the shared extractor and source_doc_hashes are persisted.\n88:   const previous = process.env[DRIFT_GATE_FLAG];\n89:   process.env[DRIFT_GATE_FLAG] = 'true';\n90:   try {\n91:     const metadata = deriveGraphMetadata(folder);\n92:     fs.writeFileSync(path.join(folder, 'graph-metadata.json'), serializeGraphMetadata(metadata), 'utf-8');\n93:   } finally {\n94:     if (previous === undefined) {\n95:       delete process.env[DRIFT_GATE_FLAG];\n96:     } else {\n97:       process.env[DRIFT_GATE_FLAG] = previous;\n98:     }\n99:   }\n100: }\n101: \n102: beforeEach(() => {\n103:   tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'drift-gate-'));\n104:   delete process.env[DRIFT_GATE_FLAG];\n105: });\n106: \n107: afterEach(() => {\n108:   delete process.env[DRIFT_GATE_FLAG];\n109:   fs.rmSync(tmpDir, { recursive: true, force: true });\n110: });\n111: \n112: describe('shared synopsis extractor (REQ-004, SC-003)', () => {\n113:   it('derives both fields from one precedence over the same source doc with field-specific limits', () => {\n114:     const content = specWithOverview(LONG_OVERVIEW);\n115:     const description = derivePacketSynopsis(content, 'description');\n116:     const causalSummary = derivePacketSynopsis(content, 'causal_summary');\n117: \n118:     expect(description.length).toBeLessThanOrEqual(SYNOPSIS_FIELD_LIMITS.description);\n119:     expect(causalSummary.length).toBeLessThanOrEqual(SYNOPSIS_FIELD_LIMITS.causal_summary);\n120:     // The longer ceiling captures more of the same Overview, the shorter is its prefix.\n121:     expect(causalSummary.length).toBeGreaterThan(description.length);\n122:     expect(causalSummary.startsWith(description)).toBe(true);\n123:     expect(causalSummary).toContain('shared synopsis extractor');\n124:   });\n125: \n126:   it('moves both fields together when the source doc flips', () => {\n127:     const before = specWithOverview(LONG_OVERVIEW);\n128:     const after = specWithOverview('A completely different overview paragraph that replaces the prior summary text entirely for this packet.');\n129: \n130:     const descBefore = derivePacketSynopsis(before, 'description');\n131:     const causalBefore = derivePacketSynopsis(before, 'causal_summary');\n132:     const descAfter = derivePacketSynopsis(after, 'description');\n133:     const causalAfter = derivePacketSynopsis(after, 'causal_summary');\n134: \n135:     expect(descAfter).not.toBe(descBefore);\n136:     expect(causalAfter).not.toBe(causalBefore);\n137:     expect(descAfter.startsWith('A completely different overview')).toBe(true);\n138:     expect(causalAfter.startsWith('A completely different overview')).toBe(true);\n139:   });\n140: \n141:   it('falls back through the precedence to the title heading when there is no Overview or Problem body', () => {\n142:     const content = ['---', 'title: \"t\"', '---', '# Only A Title Here', ''].join('\\n');\n143:     expect(derivePacketSynopsis(content, 'description')).toBe('Only A Title Here');\n144:   });\n145: \n146:   it('does not cut an over-limit synopsis mid-word', () => {\n147:     const prefix = 'word '.repeat(29);\n148:     const content = specWithOverview(`${prefix}resilience`);\n149: \n150:     expect(derivePacketSynopsis(content, 'description')).toBe(prefix.trim());\n151:   });\n152: \n153:   it('preserves an over-limit synopsis when the cut lands on a word boundary', () => {\n154:     const boundaryWord = 'a'.repeat(SYNOPSIS_FIELD_LIMITS.description);\n155:     const content = specWithOverview(`${boundaryWord} trailing words`);\n156: \n157:     expect(derivePacketSynopsis(content, 'description')).toBe(boundaryWord);\n158:   });\n159: \n160:   it('passes shorter synopsis strings through unchanged', () => {\n161:     const overview = 'Short synopsis under the limit';\n162: \n163:     expect(derivePacketSynopsis(specWithOverview(overview), 'description')).toBe(overview);\n164:   });\n165: });\n166: \n167: describe('source_doc_hashes freshness key (REQ-003, SC-004)', () => {\n168:   it('computes a hash per present source doc and a doc edit changes it', () => {\n169:     const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n170:     const before = computeSourceDocHashes(folder);\n171:     expect(before['spec.md']).toMatch(/^[0-9a-f]{64}$/);\n172: \n173:     fs.writeFileSync(path.join(folder, 'spec.md'), specWithOverview('Edited overview text for the freshness key.'), 'utf-8');\n174:     const after = computeSourceDocHashes(folder);\n175:     expect(after['spec.md']).not.toBe(before['spec.md']);\n176:   });\n177: \n178:   it('persists source_doc_hashes on the derived metadata only when the flag is on', () => {\n179:     const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n180: \n181:     process.env[DRIFT_GATE_FLAG] = 'false';\n182:     const flagOff = deriveGraphMetadata(folder);\n183:     expect(flagOff.derived.source_doc_hashes).toBeUndefined();\n184: \n185:     process.env[DRIFT_GATE_FLAG] = 'true';\n186:     const flagOn = deriveGraphMetadata(folder);\n187:     expect(flagOn.derived.source_doc_hashes?.['spec.md']).toMatch(/^[0-9a-f]{64}$/);\n188:   });\n189: });\n190: \n191: describe('drift detection (REQ-002, SC-002)', () => {\n192:   it('reports drift when a doc changed after the stored synopsis', () => {\n193:     const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n194:     writeDerivedGraph(folder);\n195:     fs.writeFileSync(\n196:       path.join(folder, 'description.json'),\n197:       `${JSON.stringify({ specFolder: path.basename(folder), description: derivePacketSynopsis(specWithOverview(LONG_OVERVIEW), 'description') }, null, 2)}\\n`,\n198:       'utf-8',\n199:     );\n200: \n201:     // The doc changes after both the stored graph metadata and description were derived.\n202:     fs.writeFileSync(path.join(folder, 'spec.md'), specWithOverview('A drastically rewritten overview that no longer matches the stored synopsis fields at all.'), 'utf-8');\n203: \n204:     const report = checkGeneratedMetadataDrift(folder);\n205:     expect(report.checked).toBe(true);\n206:     expect(report.hashDrift).toBe(true);\n207:     const driftedFields = report.driftedFields.map((field) => field.field).sort();\n208:     expect(driftedFields).toEqual(['causal_summary', 'description']);\n209:   });\n210: \n211:   it('reports no drift for an in-sync folder', () => {\n212:     const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n213:     writeDerivedGraph(folder);\n214:     fs.writeFileSync(\n215:       path.join(folder, 'description.json'),\n216:       `${JSON.stringify({ specFolder: path.basename(folder), description: derivePacketSynopsis(specWithOverview(LONG_OVERVIEW), 'description') }, null, 2)}\\n`,\n217:       'utf-8',\n218:     );\n219: \n220:     const report = checkGeneratedMetadataDrift(folder);\n\n(Showing lines 1-220 of 273. Use offset=221 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────\n// MODULE: Generated Metadata Drift Gate and Shared Synopsis Extractor\n// ───────────────────────────────────────────────────────────────\n// Proves the two synopsis-and-freshness fixes. The shared extractor derives both the\n// description and the causal_summary from one precedence over the same spec.md, each honoring\n// its own length limit, so flipping the source doc moves both fields together. The drift gate\n// re-derives one folder and reports drift on a changed folder, no drift on an in-sync folder,\n// and never writes the folder. source_doc_hashes is the cheap freshness key. The resolver maps\n// drift to a non-blocking info under grandfather report mode and to a blocking error when the\n// drift-gate flag enforces.\n\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport * as crypto from 'node:crypto';\nimport * as fs from 'node:fs';\nimport * as os from 'node:os';\nimport * as path from 'node:path';\n\nimport {\n  checkGeneratedMetadataDrift,\n  computeSourceDocHashes,","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Generated Metadata Drift Gate and Shared Synopsis Extractor\n// ───────────────────────────────────────────────────────────────\n// Proves the two synopsis-and-freshness fixes. The shared extractor derives both the\n// description and the causal_summary from one precedence over the same spec.md, each honoring\n// its own length limit, so flipping the source doc moves both fields together. The drift gate\n// re-derives one folder and reports drift on a changed folder, no drift on an in-sync folder,\n// and never writes the folder. source_doc_hashes is the cheap freshness key. The resolver maps\n// drift to a non-blocking info under grandfather report mode and to a blocking error when the\n// drift-gate flag enforces.\n\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport * as crypto from 'node:crypto';\nimport * as fs from 'node:fs';\nimport * as os from 'node:os';\nimport * as path from 'node:path';\n\nimport {\n  checkGeneratedMetadataDrift,\n  computeSourceDocHashes,\n  deriveGraphMetadata,\n  resolveGeneratedMetadataDrift,\n  serializeGraphMetadata,\n} from '../../api';\nimport {\n  derivePacketSynopsis,\n  SYNOPSIS_FIELD_LIMITS,\n} from '../../lib/description/packet-synopsis.js';\n\nconst DRIFT_GATE_FLAG = 'SPECKIT_GENERATED_METADATA_DRIFT_GATE';\n\n// An Overview paragraph longer than the description ceiling so the two fields capture\n// different amounts of the same source, which is what proves the per-field limit.\nconst LONG_OVERVIEW =\n  'This packet adds a generated metadata drift gate and a shared synopsis extractor so the '\n  + 'description and the causal summary stop diverging from the same source doc and a stale '\n  + 'synopsis is provable rather than silently carried forward across many sessions.';\n\nfunction specWithOverview(overview: string): string {\n  return [\n    '---',\n    'title: \"Fixture spec\"',\n    'description: \"Frontmatter description fallback\"',\n    '---',\n    '# Fixture Spec',\n    '',\n    '## 1. SUMMARY',\n    '',\n    '### Overview',\n    overview,\n    '',\n    '## 2. PROBLEM',\n    '',\n    'Some problem text.',\n    '',\n  ].join('\\n');\n}\n\nlet tmpDir: string;\n\nfunction writeFolder(files: Record<string, string>): string {\n  const folder = fs.mkdtempSync(path.join(tmpDir, 'packet-'));\n  for (const [relativePath, content] of Object.entries(files)) {\n    const target = path.join(folder, relativePath);\n    fs.mkdirSync(path.dirname(target), { recursive: true });\n    fs.writeFileSync(target, content, 'utf-8');\n  }\n  return folder;\n}\n\nfunction snapshotFolder(folder: string): Record<string, string> {\n  const snapshot: Record<string, string> = {};\n  for (const entry of fs.readdirSync(folder, { recursive: true, withFileTypes: true })) {\n    if (!entry.isFile()) continue;\n    const dir = (entry as unknown as { parentPath?: string; path?: string }).parentPath\n      ?? (entry as unknown as { path?: string }).path\n      ?? folder;\n    const abs = path.join(dir, entry.name);\n    const rel = path.relative(folder, abs);\n    snapshot[rel] = crypto.createHash('sha256').update(fs.readFileSync(abs)).digest('hex');\n  }\n  return snapshot;\n}\n\nfunction writeDerivedGraph(folder: string): void {\n  // Build a graph-metadata.json from the current docs with the drift-gate flag on, so the\n  // stored causal_summary comes from the shared extractor and source_doc_hashes are persisted.\n  const previous = process.env[DRIFT_GATE_FLAG];\n  process.env[DRIFT_GATE_FLAG] = 'true';\n  try {\n    const metadata = deriveGraphMetadata(folder);\n    fs.writeFileSync(path.join(folder, 'graph-metadata.json'), serializeGraphMetadata(metadata), 'utf-8');\n  } finally {\n    if (previous === undefined) {\n      delete process.env[DRIFT_GATE_FLAG];\n    } else {\n      process.env[DRIFT_GATE_FLAG] = previous;\n    }\n  }\n}\n\nbeforeEach(() => {\n  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'drift-gate-'));\n  delete process.env[DRIFT_GATE_FLAG];\n});\n\nafterEach(() => {\n  delete process.env[DRIFT_GATE_FLAG];\n  fs.rmSync(tmpDir, { recursive: true, force: true });\n});\n\ndescribe('shared synopsis extractor (REQ-004, SC-003)', () => {\n  it('derives both fields from one precedence over the same source doc with field-specific limits', () => {\n    const content = specWithOverview(LONG_OVERVIEW);\n    const description = derivePacketSynopsis(content, 'description');\n    const causalSummary = derivePacketSynopsis(content, 'causal_summary');\n\n    expect(description.length).toBeLessThanOrEqual(SYNOPSIS_FIELD_LIMITS.description);\n    expect(causalSummary.length).toBeLessThanOrEqual(SYNOPSIS_FIELD_LIMITS.causal_summary);\n    // The longer ceiling captures more of the same Overview, the shorter is its prefix.\n    expect(causalSummary.length).toBeGreaterThan(description.length);\n    expect(causalSummary.startsWith(description)).toBe(true);\n    expect(causalSummary).toContain('shared synopsis extractor');\n  });\n\n  it('moves both fields together when the source doc flips', () => {\n    const before = specWithOverview(LONG_OVERVIEW);\n    const after = specWithOverview('A completely different overview paragraph that replaces the prior summary text entirely for this packet.');\n\n    const descBefore = derivePacketSynopsis(before, 'description');\n    const causalBefore = derivePacketSynopsis(before, 'causal_summary');\n    const descAfter = derivePacketSynopsis(after, 'description');\n    const causalAfter = derivePacketSynopsis(after, 'causal_summary');\n\n    expect(descAfter).not.toBe(descBefore);\n    expect(causalAfter).not.toBe(causalBefore);\n    expect(descAfter.startsWith('A completely different overview')).toBe(true);\n    expect(causalAfter.startsWith('A completely different overview')).toBe(true);\n  });\n\n  it('falls back through the precedence to the title heading when there is no Overview or Problem body', () => {\n    const content = ['---', 'title: \"t\"', '---', '# Only A Title Here', ''].join('\\n');\n    expect(derivePacketSynopsis(content, 'description')).toBe('Only A Title Here');\n  });\n\n  it('does not cut an over-limit synopsis mid-word', () => {\n    const prefix = 'word '.repeat(29);\n    const content = specWithOverview(`${prefix}resilience`);\n\n    expect(derivePacketSynopsis(content, 'description')).toBe(prefix.trim());\n  });\n\n  it('preserves an over-limit synopsis when the cut lands on a word boundary', () => {\n    const boundaryWord = 'a'.repeat(SYNOPSIS_FIELD_LIMITS.description);\n    const content = specWithOverview(`${boundaryWord} trailing words`);\n\n    expect(derivePacketSynopsis(content, 'description')).toBe(boundaryWord);\n  });\n\n  it('passes shorter synopsis strings through unchanged', () => {\n    const overview = 'Short synopsis under the limit';\n\n    expect(derivePacketSynopsis(specWithOverview(overview), 'description')).toBe(overview);\n  });\n});\n\ndescribe('source_doc_hashes freshness key (REQ-003, SC-004)', () => {\n  it('computes a hash per present source doc and a doc edit changes it', () => {\n    const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n    const before = computeSourceDocHashes(folder);\n    expect(before['spec.md']).toMatch(/^[0-9a-f]{64}$/);\n\n    fs.writeFileSync(path.join(folder, 'spec.md'), specWithOverview('Edited overview text for the freshness key.'), 'utf-8');\n    const after = computeSourceDocHashes(folder);\n    expect(after['spec.md']).not.toBe(before['spec.md']);\n  });\n\n  it('persists source_doc_hashes on the derived metadata only when the flag is on', () => {\n    const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n\n    process.env[DRIFT_GATE_FLAG] = 'false';\n    const flagOff = deriveGraphMetadata(folder);\n    expect(flagOff.derived.source_doc_hashes).toBeUndefined();\n\n    process.env[DRIFT_GATE_FLAG] = 'true';\n    const flagOn = deriveGraphMetadata(folder);\n    expect(flagOn.derived.source_doc_hashes?.['spec.md']).toMatch(/^[0-9a-f]{64}$/);\n  });\n});\n\ndescribe('drift detection (REQ-002, SC-002)', () => {\n  it('reports drift when a doc changed after the stored synopsis', () => {\n    const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n    writeDerivedGraph(folder);\n    fs.writeFileSync(\n      path.join(folder, 'description.json'),\n      `${JSON.stringify({ specFolder: path.basename(folder), description: derivePacketSynopsis(specWithOverview(LONG_OVERVIEW), 'description') }, null, 2)}\\n`,\n      'utf-8',\n    );\n\n    // The doc changes after both the stored graph metadata and description were derived.\n    fs.writeFileSync(path.join(folder, 'spec.md'), specWithOverview('A drastically rewritten overview that no longer matches the stored synopsis fields at all.'), 'utf-8');\n\n    const report = checkGeneratedMetadataDrift(folder);\n    expect(report.checked).toBe(true);\n    expect(report.hashDrift).toBe(true);\n    const driftedFields = report.driftedFields.map((field) => field.field).sort();\n    expect(driftedFields).toEqual(['causal_summary', 'description']);\n  });\n\n  it('reports no drift for an in-sync folder', () => {\n    const folder = writeFolder({ 'spec.md': specWithOverview(LONG_OVERVIEW) });\n    writeDerivedGraph(folder);\n    fs.writeFileSync(\n      path.join(folder, 'description.json'),\n      `${JSON.stringify({ specFolder: path.basename(folder), description: derivePacketSynopsis(specWithOverview(LONG_OVERVIEW), 'description') }, null, 2)}\\n`,\n      'utf-8',\n    );\n\n    const report = checkGeneratedMetadataDrift(folder);","lineStart":1,"lineEnd":220,"totalLines":273,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/generated-metadata-drift.vitest.ts","time":{"start":1788632229650,"end":1788632229689}},"id":"prt_072c9e710001i0RLzvSuBH0eGZ","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
