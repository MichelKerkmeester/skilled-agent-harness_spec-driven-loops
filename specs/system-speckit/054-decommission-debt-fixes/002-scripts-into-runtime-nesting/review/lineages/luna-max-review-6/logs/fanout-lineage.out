terations (10/10)\") and is not a genuinely different outcome\n\n  Line 776: function isMaxIterationsStopReason(stopReason) {\n\n  Line 777:   if (typeof stopReason !== 'string') return false;\n\n  Line 778:   return stopReason.toLowerCase().replace(/[^a-z]/g, '').startsWith('maxiteration');\n\n  Line 812:   // a review lineage leaves review-report.md. Research also never emits a review-style\n\n  Line 813:   // synthesis event (its terminal event is maxIterationsReached), so this artifact check is\n\n  Line 815:   const reportName = loopType === 'research' ? 'research.md' : 'review-report.md';\n\n  Line 838:   // research lineage leaves research.md plus a terminal maxIterationsReached event (no review-\n\n  Line 839:   // style synthesis event), a review lineage leaves review-report.md — so completion detection\n\n  Line 881:   if (!isMaxIterationsStopReason(synthesis.stopReason)) {\n\n  Line 882:     return `expected stopReason=maxIterationsReached, got ${synthesis.stopReason || 'unknown'}`;\n\n  Line 2698:       // deep-review-state.jsonl, review-report.md, resource-map.md) INTO lineageDir, so a\n\n\n/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/fanout-salvage.cjs:\n  Line 21:   review: 'deep-review-state.jsonl',\n\n\n/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:\n  Line 32:   review: 'deep-review-state.jsonl',\n\n  Line 157: // (\"review/deep-review-state.jsonl\") and the watermark directory\n","metadata":{"matches":25,"truncated":false},"title":"stopReason|maxIterationsReached|run_completed|review-report.md|deep-review-state.jsonl","time":{"start":1788632371752,"end":1788632371778}},"id":"prt_072cc1226001mUMyqSifzxZRTY","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072cbb697001XM5U96TxttQENP"}}
