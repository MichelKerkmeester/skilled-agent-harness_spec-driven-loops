encode/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js'),\n76:     resolve(process.cwd(), 'runtime/cli/dist/continuity/generate-context.js'),\n77:   ].filter((candidate): candidate is string => typeof candidate === 'string' && candidate.length > 0);\n78: \n79:   for (const candidate of candidates) {\n80:     try {\n81:       const fileHandle = openSync(candidate, 'r');\n82:       closeSync(fileHandle);\n83:       return candidate;\n84:     } catch {\n85:       // Candidate missing or unreadable — continue.\n86:     }\n87:   }\n88: \n89:   return null;\n90: }\n91: \n92: export type SessionStopAutosaveOutcome = 'ran' | 'skipped' | 'failed';\n93: export type SessionStopRetargetReason =\n94:   | 'detected_different_packet'\n95:   | 'no_previous_packet'\n96:   | 'ambiguous_transcript'\n97:   | 'transcript_io_failed'\n98:   | null;\n99: \n100: type SpecFolderDetectionReason =\n101:   | 'current_packet'\n102:   | 'detected_single_packet'\n103:   | 'ambiguous_transcript'\n104:   | 'transcript_io_failed'\n105:   | 'no_match';\n106: \n107: interface DetectSpecFolderOptions {\n108:   tailBytes?: number;\n109: }\n110: \n111: interface SpecFolderDetectionResult {\n112:   specFolder: string | null;\n113:   reason: SpecFolderDetectionReason;\n114: }\n115: \n116: /**\n117:  * Run context autosave using the in-memory merged state returned by the\n118:  * single atomic `updateState()` call.\n119:  *\n\n(Showing lines 50-119 of 749. Use offset=120 to continue.)\n</content>","metadata":{"preview":"const SPEC_FOLDER_CANONICAL_PREFIX = 'specs/';\nconst SPEC_FOLDER_SEGMENT_RE = /^\\d{2,3}(?:--|-)[\\w-]+$/;\nconst SPEC_FOLDER_NAMESPACE_SEGMENT_RE = /^[a-z][\\w-]+$/i;\nconst HOOK_DIR = dirname(fileURLToPath(import.meta.url));\nconst AUTOSAVE_TIMEOUT_MS = 4000;\nconst IS_CLI_ENTRY = process.argv[1] ? resolve(process.argv[1]) === fileURLToPath(import.meta.url) : false;\n\n// ───────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction resolveGenerateContextScriptPath(): string | null {\n  // Test-only env override: SPECKIT_GENERATE_CONTEXT_SCRIPT is honored only when\n  // NODE_ENV='test' or SPECKIT_TEST='true'. In production, the env var is ignored\n  // to prevent malformed/hostile values from redirecting autosave script execution\n  // before workflow path resolution.\n  const isTestMode =\n    process.env.NODE_ENV === 'test' || process.env.SPECKIT_TEST === 'true';\n  const explicitPath = isTestMode\n    ? process.env.SPECKIT_GENERATE_CONTEXT_SCRIPT","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/hooks/claude/session-stop.ts","text":"const SPEC_FOLDER_CANONICAL_PREFIX = 'specs/';\nconst SPEC_FOLDER_SEGMENT_RE = /^\\d{2,3}(?:--|-)[\\w-]+$/;\nconst SPEC_FOLDER_NAMESPACE_SEGMENT_RE = /^[a-z][\\w-]+$/i;\nconst HOOK_DIR = dirname(fileURLToPath(import.meta.url));\nconst AUTOSAVE_TIMEOUT_MS = 4000;\nconst IS_CLI_ENTRY = process.argv[1] ? resolve(process.argv[1]) === fileURLToPath(import.meta.url) : false;\n\n// ───────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction resolveGenerateContextScriptPath(): string | null {\n  // Test-only env override: SPECKIT_GENERATE_CONTEXT_SCRIPT is honored only when\n  // NODE_ENV='test' or SPECKIT_TEST='true'. In production, the env var is ignored\n  // to prevent malformed/hostile values from redirecting autosave script execution\n  // before workflow path resolution.\n  const isTestMode =\n    process.env.NODE_ENV === 'test' || process.env.SPECKIT_TEST === 'true';\n  const explicitPath = isTestMode\n    ? process.env.SPECKIT_GENERATE_CONTEXT_SCRIPT\n    : undefined;\n  const candidates = [\n    explicitPath?.trim(),\n    resolve(HOOK_DIR, '../../cli/dist/continuity/generate-context.js'),\n    resolve(HOOK_DIR, '../../../cli/dist/continuity/generate-context.js'),\n    resolve(process.cwd(), '.opencode/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js'),\n    resolve(process.cwd(), 'runtime/cli/dist/continuity/generate-context.js'),\n  ].filter((candidate): candidate is string => typeof candidate === 'string' && candidate.length > 0);\n\n  for (const candidate of candidates) {\n    try {\n      const fileHandle = openSync(candidate, 'r');\n      closeSync(fileHandle);\n      return candidate;\n    } catch {\n      // Candidate missing or unreadable — continue.\n    }\n  }\n\n  return null;\n}\n\nexport type SessionStopAutosaveOutcome = 'ran' | 'skipped' | 'failed';\nexport type SessionStopRetargetReason =\n  | 'detected_different_packet'\n  | 'no_previous_packet'\n  | 'ambiguous_transcript'\n  | 'transcript_io_failed'\n  | null;\n\ntype SpecFolderDetectionReason =\n  | 'current_packet'\n  | 'detected_single_packet'\n  | 'ambiguous_transcript'\n  | 'transcript_io_failed'\n  | 'no_match';\n\ninterface DetectSpecFolderOptions {\n  tailBytes?: number;\n}\n\ninterface SpecFolderDetectionResult {\n  specFolder: string | null;\n  reason: SpecFolderDetectionReason;\n}\n\n/**\n * Run context autosave using the in-memory merged state returned by the\n * single atomic `updateState()` call.\n *","lineStart":50,"lineEnd":119,"totalLines":749,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/hooks/claude/session-stop.ts","time":{"start":1788632101629,"end":1788632101648}},"id":"prt_072c7f2fc001BrenCCwBdJ7ydZ","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c7b8c1001eH1hd0scqzAgF7"}}
{"type":"tool_use","timestamp":1788632101653,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_wCIbt9P1Ixn8Av4xbDKGfLNg","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/README.md","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Script Tests\"\n3: description: \"Test entrypoints and fixtures for system-spec-kit shell scripts, TypeScript modules and integration workflows.\"\n4: trigger_phrases:\n5:   - \"spec kit tests\"\n6:   - \"test validation\"\n7:   - \"upgrade-level tests\"\n8: ---\n9: \n10: <!-- markdownlint-disable MD025 -->\n11: \n12: # Script Tests\n13: \n14: ---\n15: \n16: ## 1. OVERVIEW\n17: \n18: `runtime/cli/tests/` validates script behavior across shell workflows, JavaScript\n19: smoke tests, Python checks and Vitest regression suites. It covers validation\n20: orchestration, memory pipeline seams, phase workflows, import policy, template\n21: rendering and utility contracts.\n22: \n23: Tests assume the resume contract where packet context is recovered from\n24: `handover.md -> _memory.continuity -> spec docs`; generated memory artifacts\n25: remain supporting fixtures or outputs.\n26: \n27: ---\n28: \n29: ## 2. PACKAGE TOPOLOGY\n30: \n31: ```text\n32: runtime/cli/tests/\n33: +-- test-*.js                 # Node smoke and integration tests\n34: +-- test-*.sh                 # Shell validation and phase workflow tests\n35: +-- test_dual_threshold.py    # Python threshold check\n36: +-- *.vitest.ts               # TypeScript regression suites\n37: +-- fixtures/                 # Test-local fixtures\n38: +-- test-fixtures -> ../test-fixtures\n39: `-- README.md\n40: ```\n41: \n42: Suite groups:\n43: \n44: | Group | Coverage |\n45: | --- | --- |\n46: | Shell tests | Spec validation, phase workflow and upgrade-level behavior |\n47: | Node tests | Script modules, extractors, loaders, templates and regressions |\n48: | Vitest suites | Memory, validation, import policy and templates |\n49: | Python tests | Dual-threshold decision behavior |\n50: \n51: ---\n52: \n53: ## 3. FIXTURE BOUNDARIES\n54: \n55: Allowed fixture content:\n56: \n57: - `fixtures/` for test-local inputs and expected outputs.\n58: - `test-fixtures` symlink for shared spec folder validation cases.\n59: - Generated JS artifacts only when intentionally retained.\n60: \n61: Not owned here:\n62: \n63: - Validation scenario definitions live in `../test-fixtures/`.\n64: - Production templates live under `../../templates/`.\n65: - Runtime fixture JSON lives under `../../runtime/tests/fixtures/`.\n66: \n67: ---\n68: \n69: ## 4. ENTRYPOINTS\n70: \n71: Run from the repository root unless a command changes into `runtime/cli/` explicitly:\n72: \n73: ```bash\n74: npm --prefix .opencode/skills/system-spec-kit/runtime/cli run build\n75: node .opencode/skills/system-spec-kit/runtime/cli/tests/test-scripts-modules.js\n76: bash .opencode/skills/system-spec-kit/runtime/cli/tests/test-phase-system.sh\n77: bash .opencode/skills/system-spec-kit/runtime/cli/tests/test-validation.sh\n78: (cd .opencode/skills/system-spec-kit/runtime/cli && npx vitest run \\\n79:   --config ../../vitest.config.ts --project cli tests/test-integration.vitest.ts)\n80: python3 .opencode/skills/system-spec-kit/runtime/cli/tests/test_dual_threshold.py\n81: ```\n82: \n83: ---\n84: \n85: ## 5. VALIDATION\n86: \n87: Recommended targeted order after script changes:\n88: \n89: ```bash\n90: npm --prefix .opencode/skills/system-spec-kit/runtime/cli run build\n91: node .opencode/skills/system-spec-kit/runtime/cli/tests/test-scripts-modules.js\n92: bash .opencode/skills/system-spec-kit/runtime/cli/tests/test-phase-system.sh\n93: bash .opencode/skills/system-spec-kit/runtime/cli/tests/test-validation.sh\n94: (cd .opencode/skills/system-spec-kit/runtime/cli && npx vitest run \\\n95:   --config ../../vitest.config.ts --project cli tests/test-integration.vitest.ts)\n96: ```\n97: \n98: Use narrower Vitest files for focused changes, then run the shell validation\n99: suite when spec folder behavior changes.\n100: \n\n(Showing lines 1-100 of 108. Use offset=101 to continue.)\n</content>","metadata":{"preview":"---\ntitle: \"Script Tests\"\ndescription: \"Test entrypoints and fixtures for system-spec-kit shell scripts, TypeScript modules and integration workflows.\"\ntrigger_phrases:\n  - \"spec kit tests\"\n  - \"test validation\"\n  - \"upgrade-level tests\"\n---\n\n<!-- markdownlint-disable MD025 -->\n\n# Script Tests\n\n---\n\n## 1. OVERVIEW\n\n`runtime/cli/tests/` validates script behavior across shell workflows, JavaScript\nsmoke tests, Python checks and Vitest regression suites. It covers validation\norchestration, memory pipeline seams, phase workflows, import policy, template","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/tests/README.md","text":"---\ntitle: \"Script Tests\"\ndescription: \"Test entrypoints and fixtures for system-spec-kit shell scripts, TypeScript modules and integration workflows.\"\ntrigger_phrases:\n  - \"spec kit tests\"\n  - \"test validation\"\n  - \"upgrade-level tests\"\n---\n\n<!-- markdownlint-disable MD025 -->\n\n# Script Tests\n\n---\n\n## 1. OVERVIEW\n\n`runtime/cli/tests/` validates script behavior across shell workflows, JavaScript\nsmoke tests, Python checks and Vitest regression suites. It covers validation\norchestration, memory pipeline seams, phase workflows, import policy, template\nrendering and utility contracts.\n\nTests assume the resume contract where packet context is recovered from\n`handover.md -> _memory.continuity -> spec docs`; generated memory artifacts\nremain supporting fixtures or outputs.\n\n---\n\n## 2. PACKAGE TOPOLOGY\n\n```text\nruntime/cli/tests/\n+-- test-*.js                 # Node smoke and integration tests\n+-- test-*.sh                 # Shell validation and phase workflow tests\n+-- test_dual_threshold.py    # Python threshold check\n+-- *.vitest.ts               # TypeScript regression suites\n+-- fixtures/                 # Test-local fixtures\n+-- test-fixtures -> ../test-fixtures\n`-- README.md\n```\n\nSuite groups:\n\n| Group | Coverage |\n| --- | --- |\n| Shell tests | Spec validation, phase workflow and upgrade-level behavior |\n| Node tests | Script modules, extractors, loaders, templates and regressions |\n| Vitest suites | Memory, validation, import policy and templates |\n| Python tests | Dual-threshold decision behavior |\n\n---\n\n## 3. FIXTURE BOUNDARIES\n\nAllowed fixture content:\n\n- `fixtures/` for test-local inputs and expected outputs.\n- `test-fixtures` symlink for shared spec folder validation cases.\n- Generated JS artifacts only when intentionally retained.\n\nNot owned here:\n\n- Validation scenario definitions live in `../test-fixtures/`.\n- Production templates live under `../../templates/`.\n- Runtime fixture JSON lives under `../../runtime/tests/fixtures/`.\n\n---\n\n## 4. ENTRYPOINTS\n\nRun from the repository root unless a command changes into `runtime/cli/` explicitly:\n\n```bash\nnpm --prefix .opencode/skills/system-spec-kit/runtime/cli run build\nnode .opencode/skills/system-spec-kit/runtime/cli/tests/test-scripts-modules.js\nbash .opencode/skills/system-spec-kit/runtime/cli/tests/test-phase-system.sh\nbash .opencode/skills/system-spec-kit/runtime/cli/tests/test-validation.sh\n(cd .opencode/skills/system-spec-kit/runtime/cli && npx vitest run \\\n  --config ../../vitest.config.ts --project cli tests/test-integration.vitest.ts)\npython3 .opencode/skills/system-spec-kit/runtime/cli/tests/test_dual_threshold.py\n```\n\n---\n\n## 5. VALIDATION\n\nRecommended targeted order after script changes:\n\n```bash\nnpm --prefix .opencode/skills/system-spec-kit/runtime/cli run build\nnode .opencode/skills/system-spec-kit/runtime/cli/tests/test-scripts-modules.js\nbash .opencode/skills/system-spec-kit/runtime/cli/tests/test-phase-system.sh\nbash .opencode/skills/system-spec-kit/runtime/cli/tests/test-validation.sh\n(cd .opencode/skills/system-spec-kit/runtime/cli && npx vitest run \\\n  --config ../../vitest.config.ts --project cli tests/test-integration.vitest.ts)\n```\n\nUse narrower Vitest files for focused changes, then run the shell validation\nsuite when spec folder behavior changes.\n","lineStart":1,"lineEnd":100,"totalLines":108,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/tests/README.md","time":{"start":1788632101625,"end":1788632101649}},"id":"prt_072c7f2f80019KhQNx021HTPJO","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c7b8c1001eH1hd0scqzAgF7"}}
{"type":"tool_use","timestamp":1788632101653,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_AYCoPSIK18jYjI8CW9c1J3hw","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json</path>\n<type>file</type>\n<content>\n1: {\n2:   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n3:   \"version\": \"1.0.0\",\n4:   \"description\": \"Spec Kit Script Registry - Centralized catalog of all scripts for dynamic discovery\",\n5:   \"lastUpdated\": \"2025-12-31\",\n6:   \"scripts\": [\n7:     {\n8:       \"name\": \"generate-context\",\n9:       \"path\": \"runtime/cli/dist/continuity/generate-context.js\",\n10:       \"type\": \"node\",\n11:       \"description\": \"Generate the saved context artifact with ANCHOR format and refresh the packet's graph metadata\",\n12:       \"trigger\": [\"save context\", \"save memory\", \"/speckit:save\"],\n13:       \"calledBy\": [\"AI Assistant\", \"Command YAML\"],\n14:       \"essential\": true,\n15:       \"inputs\": {\n16:         \"mode1\": \"JSON data file path (e.g., /tmp/save-context-data-<session-id>.json)\",\n17:         \"mode2\": \"Spec folder path (e.g., 007-feature/)\"\n18:       },\n19:       \"outputs\": [\"Refreshed generated metadata pair\", \"continuity frontmatter\"],\n20:       \"gate\": \"Continuity save\",\n21:       \"version\": \"2.0.0\",\n22:       \"dependencies\": [\"lib/embeddings.js\", \"lib/anchor-generator.js\", \"lib/content-filter.js\"]\n23:     },\n24:     {\n25:       \"name\": \"validate-spec\",\n26:       \"path\": \"runtime/cli/spec/validate.sh\",\n27:       \"type\": \"bash\",\n28:       \"description\": \"Validate spec folder contents against documentation level requirements\",\n29:       \"trigger\": [\"validate spec\", \"check spec\"],\n30:       \"calledBy\": [\"AI Assistant\", \"CI/CD Pipeline\", \"Pre-commit Hook\"],\n31:       \"essential\": true,\n32:       \"inputs\": {\n33:         \"required\": \"Spec folder path\",\n34:         \"options\": \"--json, --strict, --verbose, --quiet\"\n35:       },\n36:       \"outputs\": [\"Pass/warn/fail status\", \"JSON report (with --json)\"],\n37:       \"gate\": \"Completion Verification\",\n38:       \"version\": \"2.0.0\",\n39:       \"dependencies\": [\"rules/*.sh\", \"lib/shell-common.sh\"]\n40:     },\n41:     {\n42:       \"name\": \"check-completion\",\n43:       \"path\": \"runtime/cli/spec/check-completion.sh\",\n44:       \"type\": \"bash\",\n45:       \"description\": \"Completion Verification Rule enforcement - verify checklist items are complete before claiming done\",\n46:       \"trigger\": [\"check completion\", \"verify complete\", \"claiming done\"],\n47:       \"calledBy\": [\"AI Assistant\", \"Completion Verification Rule\"],\n48:       \"essential\": true,\n49:       \"inputs\": {\n50:         \"required\": \"Spec folder path\",\n51:         \"options\": \"--json, --strict, --quiet\"\n52:       },\n53:       \"outputs\": [\"Pass/fail status\", \"Incomplete items list\"],\n54:       \"gate\": \"Completion Verification Rule\",\n55:       \"version\": \"1.0.0\",\n56:       \"dependencies\": []\n57:     },\n58:     {\n59:       \"name\": \"upgrade-level\",\n60:       \"path\": \"runtime/cli/spec/upgrade-level.sh\",\n61:       \"type\": \"bash\",\n62:       \"description\": \"Upgrade existing spec folders to higher documentation levels with backup and rollback. Post-upgrade: AI must auto-populate injected placeholder content from existing spec context\",\n63:       \"trigger\": [\"upgrade level\", \"level upgrade\", \"promote spec level\"],\n64:       \"calledBy\": [\"AI Assistant\", \"Developer\"],\n65:       \"essential\": true,\n66:       \"inputs\": {\n67:         \"required\": \"Spec folder path, --to <2|3|3+>\",\n68:         \"options\": \"--dry-run, --verbose, --json, --keep-backups\"\n69:       },\n70:       \"outputs\": [\"Upgraded spec docs\", \"Backup directory\", \"JSON result with --json\"],\n71:       \"gate\": \"Documentation Level Upgrade\",\n72:       \"version\": \"1.0.0\",\n73:       \"dependencies\": [\"runtime/cli/lib/shell-common.sh\", \"templates/\"]\n74:     },\n75:     {\n76:       \"name\": \"check-prerequisites\",\n77:       \"path\": \"runtime/cli/setup/check-prerequisites.sh\",\n78:       \"type\": \"bash\",\n79:       \"description\": \"Validate spec folder exists and contains required files for its level\",\n80:       \"trigger\": [\"check prerequisites\", \"verify files\"],\n81:       \"calledBy\": [\"AI Assistant\", \"Implementation Phase\"],\n82:       \"essential\": true,\n83:       \"inputs\": {\n84:         \"options\": \"--json, --require-tasks, --include-tasks, --paths-only\"\n85:       },\n86:       \"outputs\": [\"FEATURE_DIR path\", \"AVAILABLE_DOCS list\"],\n87:       \"gate\": null,\n88:       \"version\": \"2.0.0\",\n89:       \"dependencies\": []\n90:     },\n91:     {\n92:       \"name\": \"calculate-completeness\",\n93:       \"path\": \"runtime/cli/spec/calculate-completeness.sh\",\n94:       \"type\": \"bash\",\n95:       \"description\": \"Calculate percentage of template placeholders replaced with real content\",\n96:       \"trigger\": [\"calculate progress\", \"completeness\"],\n97:       \"calledBy\": [\"AI Assistant\", \"Progress Tracking\"],\n98:       \"essential\": false,\n99:       \"inputs\": {\n100:         \"required\": \"Spec folder path\",\n\n(Showing lines 1-100 of 394. Use offset=101 to continue.)\n</content>","metadata":{"preview":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Spec Kit Script Registry - Centralized catalog of all scripts for dynamic discovery\",\n  \"lastUpdated\": \"2025-12-31\",\n  \"scripts\": [\n    {\n      \"name\": \"generate-context\",\n      \"path\": \"runtime/cli/dist/continuity/generate-context.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate the saved context artifact with ANCHOR format and refresh the packet's graph metadata\",\n      \"trigger\": [\"save context\", \"save memory\", \"/speckit:save\"],\n      \"calledBy\": [\"AI Assistant\", \"Command YAML\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"mode1\": \"JSON data file path (e.g., /tmp/save-context-data-<session-id>.json)\",\n        \"mode2\": \"Spec folder path (e.g., 007-feature/)\"\n      },\n      \"outputs\": [\"Refreshed generated metadata pair\", \"continuity frontmatter\"],\n      \"gate\": \"Continuity save\",","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json","text":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Spec Kit Script Registry - Centralized catalog of all scripts for dynamic discovery\",\n  \"lastUpdated\": \"2025-12-31\",\n  \"scripts\": [\n    {\n      \"name\": \"generate-context\",\n      \"path\": \"runtime/cli/dist/continuity/generate-context.js\",\n      \"type\": \"node\",\n      \"description\": \"Generate the saved context artifact with ANCHOR format and refresh the packet's graph metadata\",\n      \"trigger\": [\"save context\", \"save memory\", \"/speckit:save\"],\n      \"calledBy\": [\"AI Assistant\", \"Command YAML\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"mode1\": \"JSON data file path (e.g., /tmp/save-context-data-<session-id>.json)\",\n        \"mode2\": \"Spec folder path (e.g., 007-feature/)\"\n      },\n      \"outputs\": [\"Refreshed generated metadata pair\", \"continuity frontmatter\"],\n      \"gate\": \"Continuity save\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"lib/embeddings.js\", \"lib/anchor-generator.js\", \"lib/content-filter.js\"]\n    },\n    {\n      \"name\": \"validate-spec\",\n      \"path\": \"runtime/cli/spec/validate.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Validate spec folder contents against documentation level requirements\",\n      \"trigger\": [\"validate spec\", \"check spec\"],\n      \"calledBy\": [\"AI Assistant\", \"CI/CD Pipeline\", \"Pre-commit Hook\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --strict, --verbose, --quiet\"\n      },\n      \"outputs\": [\"Pass/warn/fail status\", \"JSON report (with --json)\"],\n      \"gate\": \"Completion Verification\",\n      \"version\": \"2.0.0\",\n      \"dependencies\": [\"rules/*.sh\", \"lib/shell-common.sh\"]\n    },\n    {\n      \"name\": \"check-completion\",\n      \"path\": \"runtime/cli/spec/check-completion.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Completion Verification Rule enforcement - verify checklist items are complete before claiming done\",\n      \"trigger\": [\"check completion\", \"verify complete\", \"claiming done\"],\n      \"calledBy\": [\"AI Assistant\", \"Completion Verification Rule\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",\n        \"options\": \"--json, --strict, --quiet\"\n      },\n      \"outputs\": [\"Pass/fail status\", \"Incomplete items list\"],\n      \"gate\": \"Completion Verification Rule\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"upgrade-level\",\n      \"path\": \"runtime/cli/spec/upgrade-level.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Upgrade existing spec folders to higher documentation levels with backup and rollback. Post-upgrade: AI must auto-populate injected placeholder content from existing spec context\",\n      \"trigger\": [\"upgrade level\", \"level upgrade\", \"promote spec level\"],\n      \"calledBy\": [\"AI Assistant\", \"Developer\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"required\": \"Spec folder path, --to <2|3|3+>\",\n        \"options\": \"--dry-run, --verbose, --json, --keep-backups\"\n      },\n      \"outputs\": [\"Upgraded spec docs\", \"Backup directory\", \"JSON result with --json\"],\n      \"gate\": \"Documentation Level Upgrade\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": [\"runtime/cli/lib/shell-common.sh\", \"templates/\"]\n    },\n    {\n      \"name\": \"check-prerequisites\",\n      \"path\": \"runtime/cli/setup/check-prerequisites.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Validate spec folder exists and contains required files for its level\",\n      \"trigger\": [\"check prerequisites\", \"verify files\"],\n      \"calledBy\": [\"AI Assistant\", \"Implementation Phase\"],\n      \"essential\": true,\n      \"inputs\": {\n        \"options\": \"--json, --require-tasks, --include-tasks, --paths-only\"\n      },\n      \"outputs\": [\"FEATURE_DIR path\", \"AVAILABLE_DOCS list\"],\n      \"gate\": null,\n      \"version\": \"2.0.0\",\n      \"dependencies\": []\n    },\n    {\n      \"name\": \"calculate-completeness\",\n      \"path\": \"runtime/cli/spec/calculate-completeness.sh\",\n      \"type\": \"bash\",\n      \"description\": \"Calculate percentage of template placeholders replaced with real content\",\n      \"trigger\": [\"calculate progress\", \"completeness\"],\n      \"calledBy\": [\"AI Assistant\", \"Progress Tracking\"],\n      \"essential\": false,\n      \"inputs\": {\n        \"required\": \"Spec folder path\",","lineStart":1,"lineEnd":100,"totalLines":394,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/scripts-registry.json","time":{"start":1788632101622,"end":1788632101650}},"id":"prt_072c7f2f6001bY2Y5B0sfH6hPK","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c7b8c1001eH1hd0scqzAgF7"}}
{"type":"tool_use","timestamp":1788632101653,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_pZcbaXaI2FJcaFZ3NcJ7Vu0Q","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/spec/README.md","offset":1,"limit":120},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/spec/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"Spec Scripts\"\n3: description: \"Spec lifecycle shell entrypoints for create, upgrade, validation, completion checks and archival.\"\n4: trigger_phrases:\n5:   - \"spec scripts\"\n6:   - \"upgrade spec level\"\n7:   - \"validate spec folder\"\n8:   - \"check placeholders\"\n9: ---\n10: \n11: # Spec Scripts\n12: \n13: ---\n14: \n15: ## 1. OVERVIEW\n16: \n17: `runtime/cli/spec/` owns shell entrypoints for spec folder lifecycle work. It creates packet folders, upgrades documentation levels, validates structure, checks completion state and archives finished or stale folders.\n18: \n19: Current state:\n20: \n21: - Shell scripts are the public command surface for spec lifecycle operations.\n22: - Validation delegates rule checks to `../rules/` and shared helpers in `../lib/`.\n23: - Scripts accept explicit spec folder paths and are intended to run from the repository root.\n24: \n25: ---\n26: \n27: ## 2. ARCHITECTURE\n28: \n29: ```text\n30: ╭──────────────────────────────────────────────────────────────╮\n31: │                         SPEC SCRIPTS                         │\n32: ╰──────────────────────────────────────────────────────────────╯\n33: \n34: ┌──────────────┐      ┌────────────────┐      ┌────────────────┐\n35: │ Operator     │ ───▶ │ create.sh      │ ───▶ │ Spec folder    │\n36: │ or command   │      │ upgrade-level  │      │ files          │\n37: └──────┬───────┘      └───────┬────────┘      └───────┬────────┘\n38:        │                      │                       │\n39:        │                      ▼                       ▼\n40:        │              ┌──────────────┐       ┌────────────────┐\n41:        └────────────▶ │ validate.sh  │ ───▶  │ rules/check-*  │\n42:                       └──────┬───────┘       └───────┬────────┘\n43:                              │                       │\n44:                              ▼                       ▼\n45:                       ┌──────────────┐       ┌────────────────┐\n46:                       │ completion   │       │ lib/*.sh       │\n47:                       │ and archive  │       │ helpers        │\n48:                       └──────────────┘       └────────────────┘\n49: \n50: Dependency direction: spec/*.sh ───▶ rules/*.sh ───▶ lib/*.sh\n51: ```\n52: \n53: ---\n54: \n55: ## 3. PACKAGE TOPOLOGY\n56: \n57: ```text\n58: runtime/cli/spec/\n59: +-- create.sh                    # Scaffold spec folders from templates\n60: +-- upgrade-level.sh             # Add level-owned docs and sections\n61: +-- check-placeholders.sh        # Detect unresolved template placeholders\n62: +-- validate.sh                  # Run structural validation rules\n63: +-- progressive-validate.sh      # Staged validation helper\n64: +-- check-completion.sh          # Verify completion checklist state\n65: +-- scaffold-debug-delegation.sh # Generate debug-delegation handoff scaffolds\n66: +-- calculate-completeness.sh    # Report checklist completion metrics\n67: +-- recommend-level.sh           # Recommend documentation level from task signals\n68: +-- archive.sh                   # Move completed or stale spec folders\n69: +-- check-template-staleness.sh  # Compare generated docs with templates\n70: +-- check-smart-router.sh        # Validate SKILL.md smart-router references\n71: +-- quality-audit.sh             # Batch quality audit helper\n72: +-- test-validation.sh           # Legacy wrapper for scripts/tests/test-validation.sh\n73: +-- is-phase-parent.ts           # Phase-parent detection and manifest health check\n74: +-- sync-phase-map-status.ts     # Sync a phase parent's map table and completion percentages\n75: +-- repair-derived.cjs           # Repair packet facts derivable from disk; refuses authored facts\n76: +-- README-repair-derived.md     # Derived-vs-authored repair boundary reference\n77: `-- README.md\n78: ```\n79: \n80: Allowed direction:\n81: \n82: - `spec/*.sh` may source shared shell helpers from `../lib/`.\n83: - `validate.sh` may call validation rules from `../rules/`.\n84: - Lifecycle scripts may read templates and write only the selected spec folder.\n85: \n86: Disallowed direction:\n87: \n88: - Rule scripts should not mutate spec content.\n89: - Shell helpers should not call spec lifecycle entrypoints.\n90: - Source modules should not import generated `dist/` output directly. Shell entrypoints may execute freshness-verified compiled output, as `validate.sh` does for the runtime validation orchestrator.\n91: \n92: ---\n93: \n94: ## 4. KEY FILES\n95: \n96: | File | Role |\n97: |---|---|\n98: | `create.sh` | Creates new Level 1 or phase folders from templates. |\n99: | `upgrade-level.sh` | Adds missing files and sections for higher documentation levels. |\n100: | `validate.sh` | Runs the modular validation gate used before completion claims. `resolve_orchestrator()` checks the compiled runtime dist freshness (via `../lib/dist-freshness.cjs`) before trusting it and fails closed with exit `3` when stale — no silent auto-rebuild. |\n101: | `check-completion.sh` | Confirms checklist evidence before a task is called complete. |\n102: | `scaffold-debug-delegation.sh` | Generates `debug-delegation.md` handoff scaffolds from failure-trail input. |\n103: | `progressive-validate.sh` | Runs a staged validation pass for detect, fix, suggest and report flows. |\n104: | `check-smart-router.sh` | Validates `SKILL.md` smart-router resource paths and reports load bloat warnings. |\n105: | `test-validation.sh` | Legacy wrapper forwarding to `runtime/cli/tests/test-validation.sh`. |\n106: | `archive.sh` | Moves completed or stale spec folders into the archive area. |\n107: | `is-phase-parent.ts` | Detects whether a folder is a phase parent and reports child-count manifest health. |\n108: | `sync-phase-map-status.ts` | Corrects a phase parent's map table rows and descendant completion percentages. |\n109: | `repair-derived.cjs` | Repairs derivable packet facts (folder name, packet pointer, level, metadata fingerprint) and refuses authored ones; see `README-repair-derived.md`. |\n110: \n111: ---\n112: \n113: ## 5. BOUNDARIES AND FLOW\n114: \n115: Main validation flow:\n116: \n117: ```text\n118: ╭──────────────────────────────╮\n119: │ Repository-root command      │\n120: ╰──────────────────────────────╯\n\n(Showing lines 1-120 of 175. Use offset=121 to continue.)\n</content>","metadata":{"preview":"---\ntitle: \"Spec Scripts\"\ndescription: \"Spec lifecycle shell entrypoints for create, upgrade, validation, completion checks and archival.\"\ntrigger_phrases:\n  - \"spec scripts\"\n  - \"upgrade spec level\"\n  - \"validate spec folder\"\n  - \"check placeholders\"\n---\n\n# Spec Scripts\n\n---\n\n## 1. OVERVIEW\n\n`runtime/cli/spec/` owns shell entrypoints for spec folder lifecycle work. It creates packet folders, upgrades documentation levels, validates structure, checks completion state and archives finished or stale folders.\n\nCurrent state:\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/spec/README.md","text":"---\ntitle: \"Spec Scripts\"\ndescription: \"Spec lifecycle shell entrypoints for create, upgrade, validation, completion checks and archival.\"\ntrigger_phrases:\n  - \"spec scripts\"\n  - \"upgrade spec level\"\n  - \"validate spec folder\"\n  - \"check placeholders\"\n---\n\n# Spec Scripts\n\n---\n\n## 1. OVERVIEW\n\n`runtime/cli/spec/` owns shell entrypoints for spec folder lifecycle work. It creates packet folders, upgrades documentation levels, validates structure, checks completion state and archives finished or stale folders.\n\nCurrent state:\n\n- Shell scripts are the public command surface for spec lifecycle operations.\n- Validation delegates rule checks to `../rules/` and shared helpers in `../lib/`.\n- Scripts accept explicit spec folder paths and are intended to run from the repository root.\n\n---\n\n## 2. ARCHITECTURE\n\n```text\n╭──────────────────────────────────────────────────────────────╮\n│                         SPEC SCRIPTS                         │\n╰──────────────────────────────────────────────────────────────╯\n\n┌──────────────┐      ┌────────────────┐      ┌────────────────┐\n│ Operator     │ ───▶ │ create.sh      │ ───▶ │ Spec folder    │\n│ or command   │      │ upgrade-level  │      │ files          │\n└──────┬───────┘      └───────┬────────┘      └───────┬────────┘\n       │                      │                       │\n       │                      ▼                       ▼\n       │              ┌──────────────┐       ┌────────────────┐\n       └────────────▶ │ validate.sh  │ ───▶  │ rules/check-*  │\n                      └──────┬───────┘       └───────┬────────┘\n                             │                       │\n                             ▼                       ▼\n                      ┌──────────────┐       ┌────────────────┐\n                      │ completion   │       │ lib/*.sh       │\n                      │ and archive  │       │ helpers        │\n                      └──────────────┘       └────────────────┘\n\nDependency direction: spec/*.sh ───▶ rules/*.sh ───▶ lib/*.sh\n```\n\n---\n\n## 3. PACKAGE TOPOLOGY\n\n```text\nruntime/cli/spec/\n+-- create.sh                    # Scaffold spec folders from templates\n+-- upgrade-level.sh             # Add level-owned docs and sections\n+-- check-placeholders.sh        # Detect unresolved template placeholders\n+-- validate.sh                  # Run structural validation rules\n+-- progressive-validate.sh      # Staged validation helper\n+-- check-completion.sh          # Verify completion checklist state\n+-- scaffold-debug-delegation.sh # Generate debug-delegation handoff scaffolds\n+-- calculate-completeness.sh    # Report checklist completion metrics\n+-- recommend-level.sh           # Recommend documentation level from task signals\n+-- archive.sh                   # Move completed or stale spec folders\n+-- check-template-staleness.sh  # Compare generated docs with templates\n+-- check-smart-router.sh        # Validate SKILL.md smart-router references\n+-- quality-audit.sh             # Batch quality audit helper\n+-- test-validation.sh           # Legacy wrapper for scripts/tests/test-validation.sh\n+-- is-phase-parent.ts           # Phase-parent detection and manifest health check\n+-- sync-phase-map-status.ts     # Sync a phase parent's map table and completion percentages\n+-- repair-derived.cjs           # Repair packet facts derivable from disk; refuses authored facts\n+-- README-repair-derived.md     # Derived-vs-authored repair boundary reference\n`-- README.md\n```\n\nAllowed direction:\n\n- `spec/*.sh` may source shared shell helpers from `../lib/`.\n- `validate.sh` may call validation rules from `../rules/`.\n- Lifecycle scripts may read templates and write only the selected spec folder.\n\nDisallowed direction:\n\n- Rule scripts should not mutate spec content.\n- Shell helpers should not call spec lifecycle entrypoints.\n- Source modules should not import generated `dist/` output directly. Shell entrypoints may execute freshness-verified compiled output, as `validate.sh` does for the runtime validation orchestrator.\n\n---\n\n## 4. KEY FILES\n\n| File | Role |\n|---|---|\n| `create.sh` | Creates new Level 1 or phase folders from templates. |\n| `upgrade-level.sh` | Adds missing files and sections for higher documentation levels. |\n| `validate.sh` | Runs the modular validation gate used before completion claims. `resolve_orchestrator()` checks the compiled runtime dist freshness (via `../lib/dist-freshness.cjs`) before trusting it and fails closed with exit `3` when stale — no silent auto-rebuild. |\n| `check-completion.sh` | Confirms checklist evidence before a task is called complete. |\n| `scaffold-debug-delegation.sh` | Generates `debug-delegation.md` handoff scaffolds from failure-trail input. |\n| `progressive-validate.sh` | Runs a staged validation pass for detect, fix, suggest and report flows. |\n| `check-smart-router.sh` | Validates `SKILL.md` smart-router resource paths and reports load bloat warnings. |\n| `test-validation.sh` | Legacy wrapper forwarding to `runtime/cli/tests/test-validation.sh`. |\n| `archive.sh` | Moves completed or stale spec folders into the archive area. |\n| `is-phase-parent.ts` | Detects whether a folder is a phase parent and reports child-count manifest health. |\n| `sync-phase-map-status.ts` | Corrects a phase parent's map table rows and descendant completion percentages. |\n| `repair-derived.cjs` | Repairs derivable packet facts (folder name, packet pointer, level, metadata fingerprint) and refuses authored ones; see `README-repair-derived.md`. |\n\n---\n\n## 5. BOUNDARIES AND FLOW\n\nMain validation flow:\n\n```text\n╭──────────────────────────────╮\n│ Repository-root command      │\n╰──────────────────────────────╯","lineStart":1,"lineEnd":120,"totalLines":175,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/spec/README.md","time":{"start":1788632101624,"end":1788632101650}},"id":"prt_072c7f2f7001JKp2z54KbmNPdQ","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c7b8c1001eH1hd0scqzAgF7"}}
{"type":"tool_use","timestamp":1788632101653,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_9DBuvfplBHWd0tm6G2e7bQh7","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","offset":1,"limit":100},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Check Architecture Boundaries\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // NOTE: This script enforces shared/ neutrality and runtime/scripts/ wrapper-only rules.\n6: // The companion check for Scripts -> runtime-internals import policy lives in:\n7: //   check-no-mcp-lib-imports-ast.ts (AST-based, with allowlist governance)\n8: // Both checks should be run together for full boundary compliance.\n9: \n10: // ───────────────────────────────────────────────────────────────\n11: // 1. CHECK ARCHITECTURE BOUNDARIES\n12: // ───────────────────────────────────────────────────────────────\n13: // Enforces two rules from ARCHITECTURE.md that were\n14: // Previously documentation-only:\n15: //   GAP A — shared/ must not import from runtime/ or scripts/\n16: //   GAP B — runtime/scripts/ files must be thin wrappers only\n17: \n18: // ───────────────────────────────────────────────────────────────\n19: // 2. IMPORTS\n20: // ───────────────────────────────────────────────────────────────\n21: import * as fs from 'fs';\n22: import * as path from 'path';\n23: import ts from 'typescript';\n24: import { dirnameFromImportMeta, isMainModule } from '../lib/esm-entry.js';\n25: \n26: const moduleDir = dirnameFromImportMeta(import.meta.url);\n27: \n28: // ───────────────────────────────────────────────────────────────\n29: // 3. TYPE DEFINITIONS\n30: // ───────────────────────────────────────────────────────────────\n31: interface GapAViolation {\n32:   file: string;\n33:   line: number;\n34:   importPath: string;\n35: }\n36: \n37: interface GapBViolation {\n38:   file: string;\n39:   reasons: string[];\n40: }\n41: \n42: interface WrapperSignals {\n43:   substantiveLines: number;\n44:   hasChildProcessImport: boolean;\n45:   hasChildProcessSpawnExecUsage: boolean;\n46:   hasScriptsDistReference: boolean;\n47:   hasScriptsSourceReference: boolean;\n48: }\n49: \n50: // ───────────────────────────────────────────────────────────────\n51: // 4. CONSTANTS\n52: // ───────────────────────────────────────────────────────────────\n53: const REQUIRED_ROOT_DIRS = ['shared', 'runtime', 'runtime/cli'] as const;\n54: \n55: // Absolute prohibition — shared/ must remain neutral (no allowlist)\n56: const SHARED_PROHIBITED_PACKAGE_PREFIXES = ['@spec-kit/runtime', '@spec-kit/cli'];\n57: \n58: // 50 lines is generous for a spawn+exit wrapper; anything larger\n59: // Indicates logic that belongs in cli/ instead\n60: const MAX_SUBSTANTIVE_LINES = 50;\n61: const PACKAGE_ROOT = resolvePackageRoot(moduleDir);\n62: const CHILD_PROCESS_MODULE_SPECIFIERS = new Set(['child_process', 'node:child_process']);\n63: const CHILD_PROCESS_WRAPPER_APIS = new Set(['spawn', 'spawnSync', 'exec', 'execSync', 'execFile', 'execFileSync', 'fork']);\n64: \n65: // ───────────────────────────────────────────────────────────────\n66: // 5. HELPERS\n67: // ───────────────────────────────────────────────────────────────\n68: function findSourceFiles(dir: string): string[] {\n69:   const files: string[] = [];\n70: \n71:   function walk(currentDir: string): void {\n72:     if (!fs.existsSync(currentDir)) return;\n73:     const entries = fs.readdirSync(currentDir, { withFileTypes: true });\n74:     for (const entry of entries) {\n75:       const fullPath = path.join(currentDir, entry.name);\n76:       if (entry.isDirectory()) {\n77:         if (entry.name === 'node_modules' || entry.name === 'dist') continue;\n78:         walk(fullPath);\n79:       } else if (\n80:         (entry.name.endsWith('.ts') || entry.name.endsWith('.js') || entry.name.endsWith('.mjs') || entry.name.endsWith('.cjs'))\n81:         && !entry.name.endsWith('.d.ts')\n82:       ) {\n83:         files.push(fullPath);\n84:       }\n85:     }\n86:   }\n87: \n88:   walk(dir);\n89:   return files;\n90: }\n91: \n92: function resolvePackageRoot(startDir: string): string {\n93:   let cursor = path.resolve(startDir);\n94:   while (true) {\n95:     const hasRequiredDirs = REQUIRED_ROOT_DIRS.every((dirName) => fs.existsSync(path.join(cursor, dirName)));\n96:     if (hasRequiredDirs) return cursor;\n97: \n98:     const parent = path.dirname(cursor);\n99:     if (parent === cursor) {\n100:       throw new Error(`Unable to resolve package root from: ${startDir}`);\n\n(Showing lines 1-100 of 497. Use offset=101 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Check Architecture Boundaries\n// ───────────────────────────────────────────────────────────────────\n\n// NOTE: This script enforces shared/ neutrality and runtime/scripts/ wrapper-only rules.\n// The companion check for Scripts -> runtime-internals import policy lives in:\n//   check-no-mcp-lib-imports-ast.ts (AST-based, with allowlist governance)\n// Both checks should be run together for full boundary compliance.\n\n// ───────────────────────────────────────────────────────────────\n// 1. CHECK ARCHITECTURE BOUNDARIES\n// ───────────────────────────────────────────────────────────────\n// Enforces two rules from ARCHITECTURE.md that were\n// Previously documentation-only:\n//   GAP A — shared/ must not import from runtime/ or scripts/\n//   GAP B — runtime/scripts/ files must be thin wrappers only\n\n// ───────────────────────────────────────────────────────────────\n// 2. IMPORTS\n// ───────────────────────────────────────────────────────────────","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Check Architecture Boundaries\n// ───────────────────────────────────────────────────────────────────\n\n// NOTE: This script enforces shared/ neutrality and runtime/scripts/ wrapper-only rules.\n// The companion check for Scripts -> runtime-internals import policy lives in:\n//   check-no-mcp-lib-imports-ast.ts (AST-based, with allowlist governance)\n// Both checks should be run together for full boundary compliance.\n\n// ───────────────────────────────────────────────────────────────\n// 1. CHECK ARCHITECTURE BOUNDARIES\n// ───────────────────────────────────────────────────────────────\n// Enforces two rules from ARCHITECTURE.md that were\n// Previously documentation-only:\n//   GAP A — shared/ must not import from runtime/ or scripts/\n//   GAP B — runtime/scripts/ files must be thin wrappers only\n\n// ───────────────────────────────────────────────────────────────\n// 2. IMPORTS\n// ───────────────────────────────────────────────────────────────\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport ts from 'typescript';\nimport { dirnameFromImportMeta, isMainModule } from '../lib/esm-entry.js';\n\nconst moduleDir = dirnameFromImportMeta(import.meta.url);\n\n// ───────────────────────────────────────────────────────────────\n// 3. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────\ninterface GapAViolation {\n  file: string;\n  line: number;\n  importPath: string;\n}\n\ninterface GapBViolation {\n  file: string;\n  reasons: string[];\n}\n\ninterface WrapperSignals {\n  substantiveLines: number;\n  hasChildProcessImport: boolean;\n  hasChildProcessSpawnExecUsage: boolean;\n  hasScriptsDistReference: boolean;\n  hasScriptsSourceReference: boolean;\n}\n\n// ───────────────────────────────────────────────────────────────\n// 4. CONSTANTS\n// ───────────────────────────────────────────────────────────────\nconst REQUIRED_ROOT_DIRS = ['shared', 'runtime', 'runtime/cli'] as const;\n\n// Absolute prohibition — shared/ must remain neutral (no allowlist)\nconst SHARED_PROHIBITED_PACKAGE_PREFIXES = ['@spec-kit/runtime', '@spec-kit/cli'];\n\n// 50 lines is generous for a spawn+exit wrapper; anything larger\n// Indicates logic that belongs in cli/ instead\nconst MAX_SUBSTANTIVE_LINES = 50;\nconst PACKAGE_ROOT = resolvePackageRoot(moduleDir);\nconst CHILD_PROCESS_MODULE_SPECIFIERS = new Set(['child_process', 'node:child_process']);\nconst CHILD_PROCESS_WRAPPER_APIS = new Set(['spawn', 'spawnSync', 'exec', 'execSync', 'execFile', 'execFileSync', 'fork']);\n\n// ───────────────────────────────────────────────────────────────\n// 5. HELPERS\n// ───────────────────────────────────────────────────────────────\nfunction findSourceFiles(dir: string): string[] {\n  const files: string[] = [];\n\n  function walk(currentDir: string): void {\n    if (!fs.existsSync(currentDir)) return;\n    const entries = fs.readdirSync(currentDir, { withFileTypes: true });\n    for (const entry of entries) {\n      const fullPath = path.join(currentDir, entry.name);\n      if (entry.isDirectory()) {\n        if (entry.name === 'node_modules' || entry.name === 'dist') continue;\n        walk(fullPath);\n      } else if (\n        (entry.name.endsWith('.ts') || entry.name.endsWith('.js') || entry.name.endsWith('.mjs') || entry.name.endsWith('.cjs'))\n        && !entry.name.endsWith('.d.ts')\n      ) {\n        files.push(fullPath);\n      }\n    }\n  }\n\n  walk(dir);\n  return files;\n}\n\nfunction resolvePackageRoot(startDir: string): string {\n  let cursor = path.resolve(startDir);\n  while (true) {\n    const hasRequiredDirs = REQUIRED_ROOT_DIRS.every((dirName) => fs.existsSync(path.join(cursor, dirName)));\n    if (hasRequiredDirs) return cursor;\n\n    const parent = path.dirname(cursor);\n    if (parent === cursor) {\n      throw new Error(`Unable to resolve package root from: ${startDir}`);","lineStart":1,"lineEnd":100,"totalLines":497,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/evals/check-architecture-boundaries.ts","time":{"start":1788632101628,"end":1788632101651}},"id":"prt_072c7f2fb0013cgVZY5T0w2Ayk","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c7b8c1001eH1hd0scqzAgF7"}}
