ly evidenceSetDigest: Digest;\n285: }\n286: \n287: export interface ClaimAdjudicationRecordedData extends JsonObject {\n288:   readonly claimDigest: Digest;\n289:   readonly evidenceRefs: string[];\n290:   readonly counterevidenceSoughtRefs: string[];\n291:   readonly alternativeExplanationDigest: Digest;\n292:   readonly finalSeverity: 'none' | 'P0' | 'P1' | 'P2';\n293:   readonly impact: number;\n294:   readonly confidence: number;\n295:   readonly downgradeTrigger: 'confidence-floor' | 'counterevidence' | 'none' | 'scope-limited';\n296:   readonly transition: 'candidate-to-finding' | 'candidate-to-rejected' | 'finding-reaffirmed';\n297:   readonly validatorFingerprint: Fingerprint;\n298:   readonly adjudicationOutcome: 'accepted' | 'deferred' | 'disproved' | 'rejected';\n299:   readonly predecessorAdjudicationEventId: string | null;\n300: }\n301: \n302: export interface FindingLineageRecordedData extends JsonObject {\n303:   readonly priorFingerprint: SemanticFingerprintParts;\n304:   readonly currentFingerprint: SemanticFingerprintParts;\n305:   readonly lineageRelation:\n306:     | 'absent'\n307:     | 'disproved'\n308:     | 'fixed'\n309:     | 'introduced'\n310:     | 'preexisting'\n311:     | 'unchanged'\n312:     | 'updated';\n313:   readonly baselineStatus: 'absent' | 'present' | 'unknown';\n314:   readonly evidenceSetDigest: Digest;\n315:   readonly predecessorEventRef: string;\n316: }\n317: \n318: export interface FindingStateChangedData extends JsonObject {\n319:   readonly priorFingerprint: SemanticFingerprintParts;\n320:   readonly currentFingerprint: SemanticFingerprintParts;\n321:   readonly priorState: 'accepted' | 'adjudicated' | 'candidate' | 'dismissed' | 'fixed';\n322:   readonly currentState: 'accepted' | 'adjudicated' | 'candidate' | 'dismissed' | 'fixed';\n323:   readonly priorSeverity: 'none' | 'P0' | 'P1' | 'P2';\n324:   readonly currentSeverity: 'none' | 'P0' | 'P1' | 'P2';\n325:   readonly adjudicationEventId: string;\n326:   readonly adjudicationPayloadDigest: Digest;\n327:   readonly changeReason: string;\n328:   readonly evidenceSetDigest: Digest;\n329:   readonly predecessorEventRef: string;\n330: }\n331: \n332: export interface ReviewDepthRecordedData extends JsonObject {\n333:   readonly reviewDepthSchemaVersion: Version;\n334:   readonly applicability: 'applicable' | 'conditional' | 'not-applicable';\n335:   readonly targetSelectionDigest: Digest;\n336:   readonly requiredBugClasses: string[];\n337:   readonly coveredBugClasses: string[];\n338:   readonly ruledOutBugClasses: string[];\n339:   readonly deferredBugClasses: string[];\n340:   readonly blockedBugClasses: string[];\n341:   readonly searchLedgerRowDigests: string[];\n342:   readonly graphStatus: 'available' | 'degraded' | 'unavailable';\n343:   readonly semanticSearchStatus: 'available' | 'degraded' | 'unavailable';\n344: }\n345: \n346: export interface ConvergenceEvaluatedData extends JsonObject {\n347:   readonly rawSignals: ConvergenceSignals;\n348:   readonly weightedSignals: ConvergenceSignals;\n349:   readonly dimensionCoverageDigest: Digest;\n350:   readonly protocolCoverageDigest: Digest;\n351:   readonly findingStability: 'stable' | 'unstable' | 'unknown';\n352:   readonly p0p1ResolutionState: 'blocked' | 'resolved' | 'unknown';\n353:   readonly evidenceDensity: number;\n354:   readonly hotspotSaturation: number;\n355:   readonly decision: 'blocked' | 'continue' | 'converged' | 'incomplete' | 'recover';\n356:   readonly policyFingerprint: Fingerprint;\n357:   readonly blockerIds: string[];\n358:   readonly stopCandidate: boolean;\n359: }\n360: \n361: export interface GraphConvergenceEvaluatedData extends ConvergenceEvaluatedData {\n362:   readonly graphDecision: 'blocked' | 'continue' | 'converged' | 'unavailable';\n363:   readonly graphDigest: Digest;\n364: }\n365: \n366: export interface BlockedStopRecordedData extends JsonObject {\n367:   readonly blockedGateIds: string[];\n368:   readonly gateResults: GateResult[];\n36