1: // ───────────────────────────────────────────────────────────────────\n862: // 4. REGISTRY AND EVENT PREPARATION\n863: // ───────────────────────────────────────────────────────────────────\n864: \n865: function eventDefinition(stem: DeepReviewEventStem): EventTypeDefinition {\n866:   return {\n867:     eventType: DeepReviewWireEventTypes[stem],\n868:     currentVersion: DEEP_REVIEW_EVENT_VERSION,\n869:     versions: [{\n870:       version: DEEP_REVIEW_EVENT_VERSION,\n871:       payload: {\n872:         requiredFields: DEEP_REVIEW_MODE_PAYLOAD_FIELDS,\n873:         validate: (payload) => isPayload(stem, payload),\n874:       },\n875:     }],\n876:     upcasters: [],\n877:   };\n878: }\n879: \n880: export function createDeepReviewEventRegistry(): EventTypeRegistry {\n881:   return new EventTypeRegistry(DeepReviewEventStems.map(eventDefinition));\n882: }\n883: \n884: export function createDeepReviewLedgerPayload<TStem extends DeepReviewEventStem>(\n885:   stem: TStem,\n886:   scope: DeepReviewScopeMap[TStem],\n887:   prevEventHash: string,\n888:   replay: DeepReviewReplayMetadata,\n889:   data: DeepReviewPayloadMap[TStem],\n890: ): DeepReviewLedgerPayload<TStem> {\n891:   if (!isScope(stem, scope)\n892:     || !isDigest(prevEventHash)\n893:     || !isReplayMetadata(replay)\n894:     || !isData(stem, data)) {\n895:     throw new TypeError(`Invalid closed-shape payload for ${stem}`);\n896:   }\n897:   const payloadDigest = digestPayloadInput(\n898:     stem,\n899:     scope,\n900:     prevEventHash,\n901:     replay,\n902:     data,\n903:   );\n904:   return Object.freeze({\n905:     stem,\n906:     eventVersion: DEEP_REVIEW_EVENT_VERSION,\n907:     scope,\n908:     prevEventHash,\n909:     payloadDigest,\n910:     replay,\n911:     data,\n912:   }) as DeepReviewLedgerPayload<TStem>;\n913: }\n914: \n915: export function prepareDeepReviewEvent<TStem extends DeepReviewEventStem>(\n916:   input: DeepReviewEventInput<TStem>,\n917:   registry: EventTypeRegistry,\n918: ): EventWritePreflight {\n919:   const payload = createDeepReviewLedgerPayload(\n920:     input.stem,\n921:     input.scope,\n922:     input.prevEventHash,\n923:     input.replay,\n924:     input.data,\n925:   );\n926:   const envelope: DeepReviewEventEnvelope<TStem> = {\n927:     envelope_version: CURRENT_ENVELOPE_VERSION,\n928:     event_id: input.eventId,\n929:     event_type: DeepReviewWireEventTypes[input.stem],\n930:     event_version: DEEP_REVIEW_EVENT_VERSION,\n931:     stream_id: input.streamId,\n932:     stream_sequence: input.streamSequence,\n933:     occurred_at: input.occurredAt,\n934:     recorded_at: input.recordedAt,\n935:     producer: input.producer,\n936:     authority_epoch: input.authorityEpoch,\n937:     correlation_id: input.correlationId,\n938:     causation_id: input.causationId,\n939:     idempotency_key: input.idempotencyKey,\n940:     payload,\n941:   };\n942:   return prepareEventWrite(envelope, registry);\n943: }\n944: \n945: export function deepReviewEventDefinitions(): readonly EventTypeDefinition[] {\n946:   return Object.freeze(DeepReviewEventStems.map(eventDefinition));\n947: }\n948: \n949: export function deepReviewPayloadDigest<TStem extends DeepReviewEventStem>(\n950:   payload: Readonly<{\n951:     stem: TStem;\n952:     eventVersion: 1;\n953:     scope: DeepReviewScopeMap[TStem];\n954:     prevEventHash: string;\n955:     replay: DeepReviewReplayMetadata;\n956:     data: DeepReviewPayloadMap[TStem];\n957:   }>,\n958: ): string {\n959:   return digestPayloadInput(\n960:     payload.stem,\n961:     payload.scope,\n962:     payload.prevEventHash,\n963:     payload.replay,\n964:     payload.data,\n965:   );\n966: }\n967: \n968: export function isDeepReviewEventStem(value: JsonValue): value is DeepReviewEventStem {\n969:   return typeof value === 'string'\n970:     && (DeepReviewEventStems as readonly string[]).includes(value);\n971: }\n\n(End of file - total 971 lines)\n</content>","metadata":{"preview":"      ? value.completionReason !== null && value.incompleteReason === null\n      : value.incompleteReason !== null;\n  }\n  return true;\n}\n\nfunction digestPayloadInput(\n  stem: DeepReviewEventStem,\n  scope: JsonObject,\n  prevEventHash: string,\n  replay: JsonObject,\n  data: JsonObject,\n): string {\n  return sha256Bytes(canonicalBytes({\n    stem,\n    eventVersion: DEEP_REVIEW_EVENT_VERSION,\n    scope,\n    prevEventHash,\n    replay,\n    data,","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts","text":"      ? value.completionReason !== null && value.incompleteReason === null\n      : value.incompleteReason !== null;\n  }\n  return true;\n}\n\nfunction digestPayloadInput(\n  stem: DeepReviewEventStem,\n  scope: JsonObject,\n  prevEventHash: string,\n  replay: JsonObject,\n  data: JsonObject,\n): string {\n  return sha256Bytes(canonicalBytes({\n    stem,\n    eventVersion: DEEP_REVIEW_EVENT_VERSION,\n    scope,\n    prevEventHash,\n    replay,\n    data,\n  }));\n}\n\nfunction isPayload(stem: DeepReviewEventStem, payload: Readonly<JsonObject>): boolean {\n  if (!hasExactFields(payload, DEEP_REVIEW_MODE_PAYLOAD_FIELDS)\n    || !isDeepReviewEventStem(payload.stem)\n    || payload.stem !== stem\n    || payload.eventVersion !== DEEP_REVIEW_EVENT_VERSION) return false;\n  if (!isScope(stem, payload.scope)\n    || !isDigest(payload.prevEventHash)\n    || !isReplayMetadata(payload.replay)\n    || !isData(stem, payload.data)) return false;\n  return payload.payloadDigest === digestPayloadInput(\n    stem,\n    payload.scope as JsonObject,\n    payload.prevEventHash,\n    payload.replay as JsonObject,\n    payload.data as JsonObject,\n  );\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. REGISTRY AND EVENT PREPARATION\n// ───────────────────────────────────────────────────────────────────\n\nfunction eventDefinition(stem: DeepReviewEventStem): EventTypeDefinition {\n  return {\n    eventType: DeepReviewWireEventTypes[stem],\n    currentVersion: DEEP_REVIEW_EVENT_VERSION,\n    versions: [{\n      version: DEEP_REVIEW_EVENT_VERSION,\n      payload: {\n        requiredFields: DEEP_REVIEW_MODE_PAYLOAD_FIELDS,\n        validate: (payload) => isPayload(stem, payload),\n      },\n    }],\n    upcasters: [],\n  };\n}\n\nexport function createDeepReviewEventRegistry(): EventTypeRegistry {\n  return new EventTypeRegistry(DeepReviewEventStems.map(eventDefinition));\n}\n\nexport function createDeepReviewLedgerPayload<TStem extends DeepReviewEventStem>(\n  stem: TStem,\n  scope: DeepReviewScopeMap[TStem],\n  prevEventHash: string,\n  replay: DeepReviewReplayMetadata,\n  data: DeepReviewPayloadMap[TStem],\n): DeepReviewLedgerPayload<TStem> {\n  if (!isScope(stem, scope)\n    || !isDigest(prevEventHash)\n    || !isReplayMetadata(replay)\n    || !isData(stem, data)) {\n    throw new TypeError(`Invalid closed-shape payload for ${stem}`);\n  }\n  const payloadDigest = digestPayloadInput(\n    stem,\n    scope,\n    prevEventHash,\n    replay,\n    data,\n  );\n  return Object.freeze({\n    stem,\n    eventVersion: DEEP_REVIEW_EVENT_VERSION,\n    scope,\n    prevEventHash,\n    payloadDigest,\n    replay,\n    data,\n  }) as DeepReviewLedgerPayload<TStem>;\n}\n\nexport function prepareDeepReviewEvent<TStem extends DeepReviewEventStem>(\n  input: DeepReviewEventInput<TStem>,\n  registry: EventTypeRegistry,\n): EventWritePreflight {\n  const payload = createDeepReviewLedgerPayload(\n    input.stem,\n    input.scope,\n    input.prevEventHash,\n    input.replay,\n    input.data,\n  );\n  const envelope: DeepReviewEventEnvelope<TStem> = {\n    envelope_version: CURRENT_ENVELOPE_VERSION,\n    event_id: input.eventId,\n    event_type: DeepReviewWireEventTypes[input.stem],\n    event_version: DEEP_REVIEW_EVENT_VERSION,\n    stream_id: input.streamId,\n    stream_sequence: input.streamSequence,\n    occurred_at: input.occurredAt,\n    recorded_at: input.recordedAt,\n    producer: input.producer,\n    authority_epoch: input.authorityEpoch,\n    correlation_id: input.correlationId,\n    causation_id: input.causationId,\n    idempotency_key: input.idempotencyKey,\n    payload,\n  };\n  return prepareEventWrite(envelope, registry);\n}\n\nexport function deepReviewEventDefinitions(): readonly EventTypeDefinition[] {\n  return Object.freeze(DeepReviewEventStems.map(eventDefinition));\n}\n\nexport function deepReviewPayloadDigest<TStem extends DeepReviewEventStem>(\n  payload: Readonly<{\n    stem: TStem;\n    eventVersion: 1;\n    scope: DeepReviewScopeMap[TStem];\n    prevEventHash: string;\n    replay: DeepReviewReplayMetadata;\n    data: DeepReviewPayloadMap[TStem];\n  }>,\n): string {\n  return digestPayloadInput(\n    payload.stem,\n    payload.scope,\n    payload.prevEventHash,\n    payload.replay,\n    payload.data,\n  );\n}\n\nexport function isDeepReviewEventStem(value: JsonValue): value is DeepReviewEventStem {\n  return typeof value === 'string'\n    && (DeepReviewEventStems as readonly string[]).includes(value);\n}","lineStart":820,"lineEnd":971,"totalLines":971,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts","time":{"start":1788632291507,"end":1788632291520}},"id":"prt_072cad8b2001pJcZDNTeHwrWAi","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072cab0ba001rt6taIsxzK6K3B"}}
