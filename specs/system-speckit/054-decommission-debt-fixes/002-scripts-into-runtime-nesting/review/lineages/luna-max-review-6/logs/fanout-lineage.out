 string>;\n33: }\n34: \n35: export interface DeepReviewBaseScope extends JsonObject {\n36:   readonly runId: ReviewRunId;\n37:   readonly sessionId: SessionId;\n38: }\n39: \n40: export interface DeepReviewGenerationScope extends DeepReviewBaseScope {\n41:   readonly generation: Uint32;\n42: }\n43: \n44: export interface DeepReviewIterationScope extends DeepReviewGenerationScope {\n45:   readonly iterationId: IterationId;\n46: }\n47: \n48: export interface DeepReviewDimensionScope extends DeepReviewIterationScope {\n49:   readonly dimensionId: DimensionId;\n50: }\n51: \n52: export interface DeepReviewCandidateScope extends DeepReviewDimensionScope {\n53:   readonly candidateId: CandidateId;\n54: }\n55: \n56: export interface DeepReviewFindingScope extends DeepReviewDimensionScope {\n57:   readonly findingId: FindingId;\n58: }\n59: \n60: export interface DeepReviewAdjudicationScope extends DeepReviewCandidateScope {\n61:   readonly findingId: FindingId;\n62: }\n63: \n64: export interface DeepReviewEvidenceScope extends DeepReviewCandidateScope {\n65:   readonly evidenceId: EvidenceId;\n66: }\n67: \n68: export interface DeepReviewProtocolScope extends DeepReviewBaseScope {\n69:   readonly protocolId: ProtocolId;\n70: }\n71: \n72: export interface DeepReviewReportScope extends DeepReviewBaseScope {\n73:   readonly reportRevisionId: ReportRevisionId;\n74: }\n75: \n76: export type DeepReviewScope =\n77:   | DeepReviewBaseScope\n78:   | DeepReviewGenerationScope\n79:   | DeepReviewIterationScope\n80:   | DeepReviewDimensionScope\n81:   | DeepReviewCandidateScope\n82:   | DeepReviewFindingScope\n83:   | DeepReviewAdjudicationScope\n84:   | DeepReviewEvidenceScope\n85:   | DeepReviewProtocolScope\n86:   | DeepReviewReportScope;\n87: \n88: // ───────────────────────────────────────────────────────────────────\n89: // 2. PAYLOAD VALUE OBJECTS\n90: // ───────────────────────────────────────────────────────────────────\n91: \n92: export interface TargetReference extends JsonObject {\n93:   readonly targetId: string;\n94:   readonly targetType: 'artifact' | 'directory' | 'file' | 'repository' | 'symbol';\n95:   readonly artifactRef: string;\n96:   readonly sourceDigest: Digest;\n97:   readonly contentDigest: Digest;\n98: }\n99: \n100: export interface EvidenceLocator extends JsonObject {\n101:   readonly scheme: 'artifact' | 'file' | 'other';\n102:   readonly artifactRef: string;\n103:   readonly locatorDigest: Digest;\n104:   readonly selector: string;\n105:   readonly startLine: Uint32 | null;\n106:   readonly endLine: Uint32 | null;\n107:   readonly revision: string | null;\n108: }\n109: \n110: export interface SemanticFingerprintParts extends JsonObject {\n111:   readonly algorithmVersion: Version;\n112:   readonly semanticAnchorDigest: Digest;\n113:   readonly normalizedContextDigest: Digest;\n114:   readonly programSliceDigest: Digest;\n115:   readonly renameMapVersion: Version;\n116:   readonly baselineState: 'absent' | 'present' | 'unknown';\n117: }\n118: \n119: export interface SourceEventRange extends JsonObject {\n120:   readonly firstEventId: string;\n121:   readonly lastEventId: string;\n122: }\n123: \n124: export interface FindingCounts extends JsonObject {\n125:   readonly candidates: Uint32;\n126:   readonly adjudicated: Uint32;\n127:   readonly p0: Uint32;\n128:   readonly p1: Uint32;\n129:   readonly p2: Uint32;\n130: }\n131: \n132: export interface RunCompletionCounts extends JsonObject {\n133:   readonly dimensions: Uint32;\n134:   readonly iterations: Uint32;\n135:   readonly candidates: Uint32;\n136:   readonly findings: Uint32;\n137:   readonly evidence: Uint32;\n138: }\n139: \n140: export interface ConvergenceSignals extends JsonObject {\n141:   readonly noveltyRatio: number;\n142:   readonly coverageRatio: number;\n143:   readonly findingStabilityRatio: number;\n144:   readonly evidenceDensityRatio: number;\n145:   readonly hotspotSaturationRatio: number;\n146:   readonly observationDigest: Digest;\n147: }\n148: \n149: export interface GateResult extends JsonObject {\n150:   readonly gateId: string;\n151:   readonly status: 'fail' | 'pass' | 'unknown';\n152:   readonly reasonCode: string;\n153:   readonly evidenceDigest: Digest;\n154: }\n155: \n156: export interface ReportSectionManifest extends JsonObject {\n157:   readonly sectionIds: string[];\n158:   readonly manifestDigest: Digest;\n159: }\n160: \n161: // ───────────────────────────────────────────────────────────────────\n162: // 3. EVENT PAYLOAD DATA\n163: // ───────────────────────────────────────────────────────────────────\n164: \n165: export interface RunInitializedData extends JsonObject {\n166:   readonly target: TargetReference;\n167:   readonly lineageMode: 'fresh' | 'restart' | 'resume';\n168:   readonly maxIterations: Uint32;\n169:   readonly convergencePolicyVersion: Version;\n170:   readonly reviewModeContractDigest: Digest;\n171:   readonly initialReleaseReadinessState: 'blocked' | 'not-assessed' | 'ready';\n172: }\n173: \n174: export interface RunResumedData extends JsonObject {\n175:   readonly priorTailDigest: Digest;\n176:   readonly sourceSessionId: SessionId;\n177:   readonly resumeReason: string;\n178:   readonly continuedFromRunId: ReviewRunId;\n179:   readonly compatibilityDecision: DeepReviewCompatibilityStatus;\n180:   readonly recoveryReceiptRef: string;\n181: }\n182: \n183: export interface RunRestartedData extends JsonObject {\n184:   readonly priorTailDigest: Digest;\n185:   readonly archivedLineageId: string;\n186:   readonly restartReason: string;\n187:   readonly continuedFromRunId: ReviewRunId;\n188:   readonly compatibilityDecision: DeepReviewCompatibilityStatus;\n189:   readonly recoveryReceiptRef: string;\n190: }\n191: \n192: export interface ScopeResolvedData extends JsonObject {\n193:   readonly targetSetDigest: Digest;\n194:   readonly scopeClass: 'bounded' | 'repository' | 'targeted';\n195:   readonly selectedTargets: TargetReference[];\n196:   readonly omittedHighRiskTargetRefs: s