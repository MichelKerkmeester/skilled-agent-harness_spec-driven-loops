{"type":"tool_use","timestamp":1788632193937,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_swiSFVEEaRo2THCYh3wEmqmM","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/index.ts","offset":1,"limit":450},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/index.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep Review Ledger Schema Public API\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: export {\n6:   DEEP_REVIEW_EVENT_VERSION,\n7:   DEEP_REVIEW_MODE_PAYLOAD_FIELDS,\n8:   DEEP_REVIEW_SHARED_ENVELOPE_FIELDS,\n9:   createDeepReviewEventRegistry,\n10:   createDeepReviewLedgerPayload,\n11:   deepReviewEventDefinitions,\n12:   deepReviewPayloadDigest,\n13:   isDeepReviewEventStem,\n14:   prepareDeepReviewEvent,\n15: } from './deep-review-ledger-schema.js';\n16: export {\n17:   DeepReviewEventStems,\n18:   DeepReviewWireEventTypes,\n19: } from './deep-review-ledger-types.js';\n20: \n21: export type * from './deep-review-ledger-schema.js';\n22: export type * from './deep-review-ledger-types.js';\n\n(End of file - total 22 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep Review Ledger Schema Public API\n// ───────────────────────────────────────────────────────────────────\n\nexport {\n  DEEP_REVIEW_EVENT_VERSION,\n  DEEP_REVIEW_MODE_PAYLOAD_FIELDS,\n  DEEP_REVIEW_SHARED_ENVELOPE_FIELDS,\n  createDeepReviewEventRegistry,\n  createDeepReviewLedgerPayload,\n  deepReviewEventDefinitions,\n  deepReviewPayloadDigest,\n  isDeepReviewEventStem,\n  prepareDeepReviewEvent,\n} from './deep-review-ledger-schema.js';\nexport {\n  DeepReviewEventStems,\n  DeepReviewWireEventTypes,\n} from './deep-review-ledger-types.js';\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/index.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep Review Ledger Schema Public API\n// ───────────────────────────────────────────────────────────────────\n\nexport {\n  DEEP_REVIEW_EVENT_VERSION,\n  DEEP_REVIEW_MODE_PAYLOAD_FIELDS,\n  DEEP_REVIEW_SHARED_ENVELOPE_FIELDS,\n  createDeepReviewEventRegistry,\n  createDeepReviewLedgerPayload,\n  deepReviewEventDefinitions,\n  deepReviewPayloadDigest,\n  isDeepReviewEventStem,\n  prepareDeepReviewEvent,\n} from './deep-review-ledger-schema.js';\nexport {\n  DeepReviewEventStems,\n  DeepReviewWireEventTypes,\n} from './deep-review-ledger-types.js';\n\nexport type * from './deep-review-ledger-schema.js';\nexport type * from './deep-review-ledger-types.js';","lineStart":1,"lineEnd":22,"totalLines":22,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/index.ts","time":{"start":1788632193922,"end":1788632193935}},"id":"prt_072c95b43001qmR7SC6EYW06s1","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c92c55001q0ZR6BB3CJI6WK"}}
{"type":"tool_use","timestamp":1788632194077,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_0mxHa3zLLosi4EinKpBl8RGZ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs","offset":1,"limit":400},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: // Deterministic append of one JSONL state record read from stdin.\n5: //\n6: // The deep-loop state logs (deep-review-state.jsonl, deep-research-state.jsonl,\n7: // ...) accumulate multi-KB single-line iteration records. When an orchestrator\n8: // fulfils an `append_jsonl` step with an edit/patch tool, the patch must\n9: // context-match the preceding giant line and reliably fails, halting the loop.\n10: // Piping the record to this helper appends it with a plain filesystem write, so\n11: // the append never routes through a context-matched patch.\n12: //\n13: // Usage:  <producer> | node append-state-record.cjs <state-log-path>\n14: // The record is read whole from stdin, validated as JSON, normalised to a single\n15: // line, and appended with a trailing newline. Invalid JSON is rejected (a guard\n16: // against a malformed interpolation) rather than silently corrupting the log.\n17: \n18: const fs = require('fs');\n19: \n20: /**\n21:  * Replace the record's timestamp with the moment it was actually appended,\n22:  * keeping whatever the producer claimed as `reportedTimestamp`.\n23:  *\n24:  * The command templates that build these records carry a literal\n25:  * `{ISO_8601_NOW}` placeholder for a model to substitute, and a model has no\n26:  * clock — so it writes a plausible-looking time instead of a real one. Observed\n27:  * logs have carried iteration times minutes into the future, and neat ten-minute\n28:  * cadences for runs that finished in six. Every consumer downstream then reasons\n29:  * about a schedule that never happened.\n30:  *\n31:  * Stamping here fixes it for every producer at once, because this is the single\n32:  * path all state records travel. The claimed value is preserved rather than\n33:  * dropped: it is the only evidence that a producer invents times, and that is\n34:  * worth keeping visible.\n35:  *\n36:  * @param {Object} record - Parsed state record.\n37:  * @returns {Object} The record with an authoritative timestamp.\n38:  */\n39: function stampObservedTime(record) {\n40:   if (record === null || typeof record !== 'object' || Array.isArray(record)) return record;\n41:   const observed = new Date().toISOString();\n42:   const claimed = record.timestamp;\n43:   const stamped = { ...record, timestamp: observed };\n44:   // Only record a claim that differs; an absent or already-correct value would\n45:   // just add noise to every line.\n46:   if (typeof claimed === 'string' && claimed && claimed !== observed) {\n47:     stamped.reportedTimestamp = claimed;\n48:   }\n49:   return stamped;\n50: }\n51: \n52: function main() {\n53:   const target = process.argv[2];\n54:   if (!target) {\n55:     process.stderr.write('usage: append-state-record.cjs <state-log-path> (record on stdin)\\n');\n56:     process.exit(2);\n57:   }\n58: \n59:   let buf = '';\n60:   process.stdin.setEncoding('utf8');\n61:   process.stdin.on('data', (chunk) => { buf += chunk; });\n62:   process.stdin.on('end', () => {\n63:     const record = buf.trim();\n64:     if (!record) {\n65:       process.stderr.write('append-state-record: empty record on stdin; nothing appended\\n');\n66:       process.exit(1);\n67:     }\n68:     let parsed;\n69:     try {\n70:       parsed = JSON.parse(record);\n71:     } catch (err) {\n72:       process.stderr.write(`append-state-record: record is not valid JSON (${err.message}); refusing to append\\n`);\n73:       process.exit(1);\n74:     }\n75:     // Re-serialise to a guaranteed single line (collapses any incidental newlines\n76:     // from a heredoc without touching string contents).\n77:     const line = JSON.stringify(stampObservedTime(parsed));\n78:     fs.appendFileSync(target, `${line}\\n`);\n79:     process.stdout.write(`appended ${line.length} bytes to ${target}\\n`);\n80:   });\n81: }\n82: \n83: main();\n\n(End of file - total 83 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\n// Deterministic append of one JSONL state record read from stdin.\n//\n// The deep-loop state logs (deep-review-state.jsonl, deep-research-state.jsonl,\n// ...) accumulate multi-KB single-line iteration records. When an orchestrator\n// fulfils an `append_jsonl` step with an edit/patch tool, the patch must\n// context-match the preceding giant line and reliably fails, halting the loop.\n// Piping the record to this helper appends it with a plain filesystem write, so\n// the append never routes through a context-matched patch.\n//\n// Usage:  <producer> | node append-state-record.cjs <state-log-path>\n// The record is read whole from stdin, validated as JSON, normalised to a single\n// line, and appended with a trailing newline. Invalid JSON is rejected (a guard\n// against a malformed interpolation) rather than silently corrupting the log.\n\nconst fs = require('fs');\n\n/**","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs","text":"#!/usr/bin/env node\n'use strict';\n\n// Deterministic append of one JSONL state record read from stdin.\n//\n// The deep-loop state logs (deep-review-state.jsonl, deep-research-state.jsonl,\n// ...) accumulate multi-KB single-line iteration records. When an orchestrator\n// fulfils an `append_jsonl` step with an edit/patch tool, the patch must\n// context-match the preceding giant line and reliably fails, halting the loop.\n// Piping the record to this helper appends it with a plain filesystem write, so\n// the append never routes through a context-matched patch.\n//\n// Usage:  <producer> | node append-state-record.cjs <state-log-path>\n// The record is read whole from stdin, validated as JSON, normalised to a single\n// line, and appended with a trailing newline. Invalid JSON is rejected (a guard\n// against a malformed interpolation) rather than silently corrupting the log.\n\nconst fs = require('fs');\n\n/**\n * Replace the record's timestamp with the moment it was actually appended,\n * keeping whatever the producer claimed as `reportedTimestamp`.\n *\n * The command templates that build these records carry a literal\n * `{ISO_8601_NOW}` placeholder for a model to substitute, and a model has no\n * clock — so it writes a plausible-looking time instead of a real one. Observed\n * logs have carried iteration times minutes into the future, and neat ten-minute\n * cadences for runs that finished in six. Every consumer downstream then reasons\n * about a schedule that never happened.\n *\n * Stamping here fixes it for every producer at once, because this is the single\n * path all state records travel. The claimed value is preserved rather than\n * dropped: it is the only evidence that a producer invents times, and that is\n * worth keeping visible.\n *\n * @param {Object} record - Parsed state record.\n * @returns {Object} The record with an authoritative timestamp.\n */\nfunction stampObservedTime(record) {\n  if (record === null || typeof record !== 'object' || Array.isArray(record)) return record;\n  const observed = new Date().toISOString();\n  const claimed = record.timestamp;\n  const stamped = { ...record, timestamp: observed };\n  // Only record a claim that differs; an absent or already-correct value would\n  // just add noise to every line.\n  if (typeof claimed === 'string' && claimed && claimed !== observed) {\n    stamped.reportedTimestamp = claimed;\n  }\n  return stamped;\n}\n\nfunction main() {\n  const target = process.argv[2];\n  if (!target) {\n    process.stderr.write('usage: append-state-record.cjs <state-log-path> (record on stdin)\\n');\n    process.exit(2);\n  }\n\n  let buf = '';\n  process.stdin.setEncoding('utf8');\n  process.stdin.on('data', (chunk) => { buf += chunk; });\n  process.stdin.on('end', () => {\n    const record = buf.trim();\n    if (!record) {\n      process.stderr.write('append-state-record: empty record on stdin; nothing appended\\n');\n      process.exit(1);\n    }\n    let parsed;\n    try {\n      parsed = JSON.parse(record);\n    } catch (err) {\n      process.stderr.write(`append-state-record: record is not valid JSON (${err.message}); refusing to append\\n`);\n      process.exit(1);\n    }\n    // Re-serialise to a guaranteed single line (collapses any incidental newlines\n    // from a heredoc without touching string contents).\n    const line = JSON.stringify(stampObservedTime(parsed));\n    fs.appendFileSync(target, `${line}\\n`);\n    process.stdout.write(`appended ${line.length} bytes to ${target}\\n`);\n  });\n}\n\nmain();","lineStart":1,"lineEnd":83,"totalLines":83,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs","time":{"start":1788632194073,"end":1788632194076}},"id":"prt_072c95b99001LX91b2sQTK0T2i","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c92c55001q0ZR6BB3CJI6WK"}}
{"type":"tool_use","timestamp":1788632194152,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_pqVWeOwz6IgE5SzxPfIwRu7e","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs","offset":1,"limit":450},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: // After-dispatch leaf-reliability check for the deep-loop iteration loop.\n5: //\n6: // A dispatched leaf owes THREE artifacts per iteration: the narrative markdown\n7: // (iterations/iteration-NNN.md), an appended canonical state-log record, and a\n8: // per-iteration delta file. The state-log record must also carry route-proof\n9: // fields proving the leaf ran as itself (mode, target_agent, agent_definition_loaded,\n10: // resolved_route). A model-driven loop is trusted to self-check today, which lets a\n11: // silently-incomplete leaf advance the loop. This makes the check mechanical: exit\n12: // non-zero with a single machine reason so the workflow can re-dispatch the same\n13: // iteration once before recording an error and continuing.\n14: //\n15: // A leaf can also satisfy every shape check above by writing the state-log\n16: // record directly instead of through the append gateway, which leaves the\n17: // projection looking complete while the ledger holds nothing behind it. This\n18: // check cross-checks the state log against check-direct-append.cjs's gateway\n19: // watermark so a receipt-less projection cannot be counted as a verified\n20: // iteration once the mode has actually moved to ledger authority.\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: const { spawnSync } = require('node:child_process');\n25: \n26: const LEAF_BY_LOOP = {\n27:   review: 'deep-review',\n28:   research: 'deep-research',\n29: };\n30: \n31: const STATE_LOG_BY_LOOP = {\n32:   review: 'deep-review-state.jsonl',\n33:   research: 'deep-research-state.jsonl',\n34: };\n35: \n36: // Matches each mode's `artifactId` in its legacy projection contract\n37: // (runtime/lib/legacy-projections/*-contract.ts) -- the key check-direct-append.cjs\n38: // uses to locate the gateway's watermark under the packet root.\n39: const ARTIFACT_ID_BY_LOOP = {\n40:   review: 'review-state',\n41:   research: 'research-state',\n42: };\n43: \n44: const CHECK_DIRECT_APPEND_CLI = path.join(__dirname, 'check-direct-append.cjs');\n45: \n46: const REASONS = {\n47:   ITERATION_FILE_MISSING: 'iteration_file_missing',\n48:   ITERATION_VERDICT_MISSING: 'iteration_verdict_missing',\n49:   STATE_RECORD_MISSING: 'state_record_missing',\n50:   ROUTE_PROOF_MISSING: 'route_proof_missing',\n51:   ROUTE_PROOF_MISMATCH: 'route_proof_mismatch',\n52:   DELTA_FILE_MISSING: 'delta_file_missing',\n53:   STATE_LOG_MALFORMED: 'state_log_malformed',\n54:   DELTA_FILE_MALFORMED: 'delta_file_malformed',\n55:   GATEWAY_BYPASS_DETECTED: 'gateway_bypass_detected',\n56:   LEDGER_BACKING_MISSING: 'ledger_backing_missing',\n57: };\n58: \n59: function pad3(n) {\n60:   return String(n).padStart(3, '0');\n61: }\n62: \n63: function parseArgs(argv) {\n64:   const out = { json: false };\n65:   for (let i = 0; i < argv.length; i += 1) {\n66:     const a = argv[i];\n67:     if (a === '--loop-type') { out.loopType = argv[i + 1]; i += 1; }\n68:     else if (a === '--artifact-dir') { out.artifactDir = argv[i + 1]; i += 1; }\n69:     else if (a === '--iteration') { out.iteration = parseInt(argv[i + 1], 10); i += 1; }\n70:     else if (a === '--json') { out.json = true; }\n71:     else if (a === '--help' || a === '-h') { out.help = true; }\n72:     else { out.error = `unknown flag: ${a}`; }\n73:   }\n74:   return out;\n75: }\n76: \n77: // Read a JSONL file and retain malformed-line evidence so the gate can fail closed.\n78: function readJsonlRecords(filePath) {\n79:   return readJsonlRecordsDetailed(filePath).records;\n80: }\n81: \n82: function readJsonlRecordsDetailed(filePath) {\n83:   let raw;\n84:   try {\n85:     raw = fs.readFileSync(filePath, 'utf8');\n86:   } catch (_) {\n87:     return { records: null, malformedLines: [] };\n88:   }\n89:   const records = [];\n90:   const malformedLines = [];\n91:   let lineNumber = 0;\n92:   for (const line of raw.split('\\n')) {\n93:     lineNumber += 1;\n94:     const trimmed = line.trim();\n95:     if (!trimmed) continue;\n96:     try {\n97:       records.push(JSON.parse(trimmed));\n98:     } catch (_) {\n99:       malformedLines.push(lineNumber);\n100:     }\n101:   }\n102:   return { records, malformedLines };\n103: }\n104: \n105: // The narrative file is written as iteration-NNN.md but the leaf may append a\n106: // descriptive suffix (iteration-NNN-some-focus.md), so match the padded number as a\n107: // prefix bounded by \".\" or \"-\" to avoid confusing 002 with 020.\n108: function findIterationNarrative(iterationsDir, iteration) {\n109:   const nnn = pad3(iteration);\n110:   let entries;\n111:   try {\n112:     entries = fs.readdirSync(iterationsDir);\n113:   } catch (_) {\n114:     return null;\n115:   }\n116:   const re = new RegExp(`^iteration-${nnn}(?:\\\\.md$|-.*\\\\.md$)`);\n117:   for (const name of entries) {\n118:     if (re.test(name)) return path.join(iterationsDir, name);\n119:   }\n120:   return null;\n121: }\n122: \n123: function isNonEmptyString(value) {\n124:   return typeof value === 'string' && value.trim().length > 0;\n125: }\n126: \n127: // Route-proof lives on the canonical iteration record. Absent fields => the leaf did\n128: // not emit route-proof at all; present-but-wrong => it ran as something other than\n129: // its own leaf identity or in the wrong mode.\n130: function checkRouteProof(record, loopType, leaf) {\n131:   const hasMode = 'mode' in record;\n132:   const hasTarget = 'target_agent' in record;\n133:   const hasLoaded = 'agent_definition_loaded' in record;\n134:   const hasRoute = 'resolved_route' in record;\n135:   if (!hasMode || !hasTarget || !hasLoaded || !hasRoute) {\n136:     return REASONS.ROUTE_PROOF_MISSING;\n137:   }\n138:   if (\n139:     record.mode !== loopType ||\n140:     record.target_agent !== leaf ||\n141:     record.agent_definition_loaded !== true ||\n142:     !isNonEmptyString(record.resolved_route)\n143:   ) {\n144:     return REASONS.ROUTE_PROOF_MISMATCH;\n145:   }\n146:   return null;\n147: }\n148: \n149: // Cross-check the projected state log against check-direct-append.cjs's gateway\n150: // watermark. That script already knows how to read a mode's authority state and\n151: // stays inert (status 'not-enforced') until the mode has actually cut over to\n152: // ledger authority, so this call is a no-op everywhere a mode still runs on the\n153: // legacy writer -- it only turns into a real finding once ledger authority is\n154: // live and the watermark disagrees with (or is missing for) the file on disk.\n155: // artifactRoot is the packet root ONE level above artifactDir: the gateway's\n156: // --run-directory is that packet root, and both the projection's relativePath\n157: // (\"review/deep-review-state.jsonl\") and the watermark directory\n158: // (\".legacy-projection-watermarks/\") resolve from it, not from artifactDir itself.\n159: function checkGatewayReceipt(loopType, artifactDir, legacyFilePath) {\n160:   const leaf = LEAF_BY_LOOP[loopType];\n161:   const artifactId = ARTIFACT_ID_BY_LOOP[loopType];\n162:   if (!leaf || !artifactId) return { status: 'skipped' };\n163: \n164:   let spawned;\n165:   try {\n166:     spawned = spawnSync(process.execPath, [\n167:       CHECK_DIRECT_APPEND_CLI,\n168:       '--mode', leaf,\n169:       '--artifact-root', path.dirname(artifactDir),\n170:       '--artifact-id', artifactId,\n171:       '--legacy-file', legacyFilePath,\n172:     ], { encoding: 'utf8', timeout: 15000 });\n173:   } catch (error) {\n174:     return { status: 'error', detail: `check-direct-append spawn failed: ${error instanceof Error ? error.message : String(error)}` };\n175:   }\n176:   if (spawned.error) {\n177:     return { status: 'error', detail: `check-direct-append spawn failed: ${spawned.error.message}` };\n178:   }\n179: \n180:   const lastLine = (spawned.stdout || '').trim().split(/\\r?\\n/).filter(Boolean).at(-1) ?? '';\n181:   let payload = null;\n182:   try { payload = JSON.parse(lastLine); } catch (_) { /* handled as inconclusive below */ }\n183: \n184:   if (spawned.status === 2 && payload) {\n185:     return { status: 'violation', detail: payload.reason || `check-direct-append reported ${payload.code || 'a violation'}`, payload };\n186:   }\n187:   if (spawned.status === 0 && payload) {\n188:     return { status: payload.status === 'not-enforced' ? 'not-enforced' : 'ok', payload };\n189:   }\n190:   return { status: 'error', detail: `check-direct-append exited ${spawned.status} with unreadable output: ${(spawned.stdout || spawned.stderr || '').slice(0, 200)}` };\n191: }\n192: \n193: // Structural ledger-backing check. Under ledger authority the gateway roots the\n194: // mode's own append-only ledger ({leaf}-ledger) at its run directory and writes an\n195: // event there for every iteration it records. A complete-looking projection record\n196: // with no such ledger behind it is a leaf that wrote the projection directly, so the\n197: // ledger and the projection have silently diverged. The run directory is the artifact\n198: // dir for lineage-rooted modes and its parent for packet-rooted ones, so the ledger\n199: // is accepted at either level; its total absence is the divergence signal. Returns\n200: // 'not-enforced' before a mode moves to ledger authority (the legacy writer is\n201: // sanctioned then), and 'skipped' when authority cannot be read (fail-open).\n202: function checkLedgerBacking(loopType, artifactDir, legacyFilePath) {\n203:   const leaf = LEAF_BY_LOOP[loopType];\n204:   if (!leaf || !ARTIFACT_ID_BY_LOOP[loopType]) return { status: 'skipped' };\n205:   const authority = checkGatewayReceipt(loopType, artifactDir, legacyFilePath);\n206:   if (authority.status !== 'violation' && authority.status !== 'ok') {\n207:     return { status: 'not-enforced', authority: authority.status };\n208:   }\n209:   const roots = [artifactDir, path.dirname(artifactDir)];\n210:   const backed = roots.some((root) => {\n211:     const framesDir = path.join(root, `${leaf}-ledger`, 'frames');\n212:     try {\n213:       return fs.existsSync(framesDir) && fs.readdirSync(framesDir).some((f) => f.endsWith('.frame'));\n214:     } catch (_) {\n215:       return false;\n216:     }\n217:   });\n218:   return { status: backed ? 'backed' : 'unbacked' };\n219: }\n220: \n221: function verify(loopType, artifactDir, iteration) {\n222:   const leaf = LEAF_BY_LOOP[loopType];\n223:   const stateLogName = STATE_LOG_BY_LOOP[loopType];\n224: \n225:   // 1. Iteration narrative markdown.\n226:   const narrativePath = findIterationNarrative(path.join(artifactDir, 'iterations'), iteration);\n227:   if (!narrativePath) {\n228:     return { ok: false, reason: REASONS.ITERATION_FILE_MISSING, detail: `no iterations/iteration-${pad3(iteration)}*.md under ${artifactDir}` };\n229:   }\n230:   const narrative = fs.readFileSync(narrativePath, 'utf8');\n231:   if (!narrative.trim()) {\n232:     return { ok: false, reason: REASONS.ITERATION_FILE_MISSING, detail: `${narrativePath} is empty` };\n233:   }\n234:   // Review narratives must end on exactly one machine-readable verdict; research/context\n235:   // use a different closing shape, so only review enforces the verdict line here.\n236:   if (loopType === 'review') {\n237:     const verdictPattern = /^Review verdict:\\s*(PASS|CONDITIONAL|FAIL)\\s*$/i;\n238:     const verdictLines = narrative.split(/\\r?\\n/).filter((line) => verdictPattern.test(line));\n239:     const finalLine = narrative.trimEnd().split(/\\r?\\n/).at(-1) ?? '';\n240:     if (verdictLines.length !== 1 || !verdictPattern.test(finalLine)) {\n241:       return { ok: false, reason: REASONS.ITERATION_VERDICT_MISSING, detail: `${narrativePath} must end with exactly one \"Review verdict: PASS|CONDITIONAL|FAIL\" line` };\n242:     }\n243:   }\n244: \n245:   // 2. Canonical state-log record for this iteration + route-proof.\n246:   const stateLogPath = path.join(artifactDir, stateLogName);\n247:   const stateLog = readJsonlRecordsDetailed(stateLogPath);\n248:   if (stateLog.malformedLines.length > 0) {\n249:     return { ok: false, reason: REASONS.STATE_LOG_MALFORMED, detail: `${stateLogName} contains malformed JSONL at line(s) ${stateLog.malformedLines.join(', ')}` };\n250:   }\n251:   const stateRecords = stateLog.records;\n252:   // Review/research key the iteration number as `iteration`; context keys it as `run`.\n253:   // Match either so one shim covers all three modes (a non-numeric run-id yields NaN\n254:   // and never false-matches). Take the LAST matching record, not the first: the state\n255:   // log is append-only, so a re-dispatched iteration appends a corrected record after\n256:   // the bad one -- matching the first would keep reporting the stale failure and defeat\n257:   // the bounded retry. The state reducer applies the same latest-record-wins rule.\n258:   const iterationRecord = (stateRecords || []).findLast(\n259:     (r) => r && r.type === 'iteration' && (Number(r.iteration) === iteration || Number(r.run) === iteration),\n260:   );\n261:   if (!iterationRecord) {\n262:     return { ok: false, reason: REASONS.STATE_RECORD_MISSING, detail: `no type=iteration record with iteration=${iteration} in ${stateLogName}` };\n263:   }\n264:   const routeReason = checkRouteProof(iterationRecord, loopType, leaf);\n265:   if (routeReason) {\n266:     return { ok: false, reason: routeReason, detail: `iteration ${iteration} state record failed route-proof (expected mode=${loopType} target_agent=${leaf})` };\n267:   }\n268: \n269:   // 2b. Structural ledger-backing gate (default on; DEEP_LOOP_LEDGER_BACKING_GATE=0\n270:   // disables it as an emergency escape). Under ledger authority a complete-looking\n271:   // iteration record with no mode ledger behind it means the leaf wrote the projection\n272:   // directly, bypassing the gateway -- exactly the divergence where the reducer would\n273:   // otherwise build a report from projection-only state. Fail the iteration loudly.\n274:   if (process.env.DEEP_LOOP_LEDGER_BACKING_GATE !== '0') {\n275:     const backing = checkLedgerBacking(loopType, artifactDir, stateLogPath);\n276:     if (backing.status === 'unbacked') {\n277:       return {\n278:         ok: false,\n279:         reason: REASONS.LEDGER_BACKING_MISSING,\n280:         detail: `iteration ${iteration}: ${stateLogName} shows a complete iteration but no ${leaf}-ledger events back it — the gateway was bypassed under ledger authority`,\n281:       };\n282:     }\n283:   }\n284: \n285:   // 2c. The state log should be backed by the append gateway's ledger, not merely\n286:   // shaped like a complete record: a leaf that writes the projection directly\n287:   // produces an indistinguishable type=iteration record with no ledger event\n288:   // behind it. This corroboration is opt-in: the modes are mid-migration and not\n289:   // every correct path publishes a projection watermark yet, so enforcing here\n290:   // would false-alarm on legitimate iterations. When explicitly enabled it is\n291:   // advisory only -- a warning, never a hard failure -- so a real bypass stays\n292:   // visible without blocking a possibly-valid iteration. The unambiguous, always-on\n293:   // defense against a leaf that skips the gateway is the prompt-pack contract,\n294:   // which now states plainly that the gateway call is required and in-scope.\n295:   const gatewayCheck = process.env.DEEP_LOOP_VERIFY_GATEWAY_RECEIPT === '1'\n296:     ? checkGatewayReceipt(loopType, artifactDir, stateLogPath)\n297:     : { status: 'skipped' };\n298:   const gatewayWarning = gatewayCheck.status === 'violation'\n299:     ? `possible direct state-log write for ${stateLogName} (no matching gateway receipt): ${gatewayCheck.detail}`\n300:     : gatewayCheck.status === 'error'\n301:       ? `gateway receipt check inconclusive for ${stateLogName}: ${gatewayCheck.detail}`\n302:       : null;\n303: \n304:   // 3. Per-iteration delta file with at least one iteration record.\n305:   const deltaLog = readJsonlRecordsDetailed(path.join(artifactDir, 'deltas', `iter-${pad3(iteration)}.jsonl`));\n306:   if (deltaLog.malformedLines.length > 0) {\n307:     return { ok: false, reason: REASONS.DELTA_FILE_MALFORMED, detail: `deltas/iter-${pad3(iteration)}.jsonl contains malformed JSONL at line(s) ${deltaLog.malformedLines.join(', ')}` };\n308:   }\n309:   const deltaRecords = deltaLog.records;\n310:   if (!deltaRecords || !deltaRecords.some((r) => r && r.type === 'iteration')) {\n311:     return { ok: false, reason: REASONS.DELTA_FILE_MISSING, detail: `deltas/iter-${pad3(iteration)}.jsonl missing or has no type=iteration record` };\n312:   }\n313: \n314:   return {\n315:     ok: true,\n316:     reason: null,\n317:     detail: `iteration ${iteration} complete: narrative + route-proof + delta`,\n318:     ...(gatewayWarning ? { warnings: [gatewayWarning] } : {}),\n319:   };\n320: }\n321: \n322: function main(argv = process.argv.slice(2)) {\n323:   const args = parseArgs(argv);\n324:   if (args.help) {\n325:     process.stdout.write(`Usage: verify-iteration.cjs --loop-type ${Object.keys(LEAF_BY_LOOP).join('|')} --artifact-dir <dir> --iteration <N> [--json]\\n`);\n326:     return 0;\n327:   }\n328:   if (args.error) { process.stderr.write(`${args.error}\\n`); return 2; }\n329:   if (!args.loopType || !LEAF_BY_LOOP[args.loopType]) { process.stderr.write(`--loop-type must be one of ${Object.keys(LEAF_BY_LOOP).join('|')}\\n`); return 2; }\n330:   if (!args.artifactDir) { process.stderr.write('--artifact-dir is required\\n'); return 2; }\n331:   if (!Number.isInteger(args.iteration) || args.iteration < 1) { process.stderr.write('--iteration must be a positive integer\\n'); return 2; }\n332: \n333:   const result = verify(args.loopType, args.artifactDir, args.iteration);\n334:   if (args.json) {\n335:     process.stdout.write(`${JSON.stringify(result)}\\n`);\n336:   } else if (result.ok) {\n337:     process.stdout.write(`OK ${result.detail}\\n`);\n338:   } else {\n339:     process.stderr.write(`${result.reason} ${result.detail}\\n`);\n340:   }\n341:   // Warnings ride on an ok:true result, so a plain OK line would otherwise hide\n342:   // them from a human running this outside --json.\n343:   if (result.warnings) {\n344:     for (const warning of result.warnings) process.stderr.write(`WARNING ${warning}\\n`);\n345:   }\n346:   return result.ok ? 0 : 1;\n347: }\n348: \n349: if (require.main === module) {\n350:   process.exit(main());\n351: }\n352: \n353: module.exports = { verify, checkGatewayReceipt, checkRouteProof, findIterationNarrative, readJsonlRecords, readJsonlRecordsDetailed, pad3, REASONS, LEAF_BY_LOOP, STATE_LOG_BY_LOOP, ARTIFACT_ID_BY_LOOP };\n\n(End of file - total 353 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\n// After-dispatch leaf-reliability check for the deep-loop iteration loop.\n//\n// A dispatched leaf owes THREE artifacts per iteration: the narrative markdown\n// (iterations/iteration-NNN.md), an appended canonical state-log record, and a\n// per-iteration delta file. The state-log record must also carry route-proof\n// fields proving the leaf ran as itself (mode, target_agent, agent_definition_loaded,\n// resolved_route). A model-driven loop is trusted to self-check today, which lets a\n// silently-incomplete leaf advance the loop. This makes the check mechanical: exit\n// non-zero with a single machine reason so the workflow can re-dispatch the same\n// iteration once before recording an error and continuing.\n//\n// A leaf can also satisfy every shape check above by writing the state-log\n// record directly instead of through the append gateway, which leaves the\n// projection looking complete while the ledger holds nothing behind it. This\n// check cross-checks the state log against check-direct-append.cjs's gateway\n// watermark so a receipt-less projection cannot be counted as a verified\n// iteration once the mode has actually moved to ledger authority.","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs","text":"#!/usr/bin/env node\n'use strict';\n\n// After-dispatch leaf-reliability check for the deep-loop iteration loop.\n//\n// A dispatched leaf owes THREE artifacts per iteration: the narrative markdown\n// (iterations/iteration-NNN.md), an appended canonical state-log record, and a\n// per-iteration delta file. The state-log record must also carry route-proof\n// fields proving the leaf ran as itself (mode, target_agent, agent_definition_loaded,\n// resolved_route). A model-driven loop is trusted to self-check today, which lets a\n// silently-incomplete leaf advance the loop. This makes the check mechanical: exit\n// non-zero with a single machine reason so the workflow can re-dispatch the same\n// iteration once before recording an error and continuing.\n//\n// A leaf can also satisfy every shape check above by writing the state-log\n// record directly instead of through the append gateway, which leaves the\n// projection looking complete while the ledger holds nothing behind it. This\n// check cross-checks the state log against check-direct-append.cjs's gateway\n// watermark so a receipt-less projection cannot be counted as a verified\n// iteration once the mode has actually moved to ledger authority.\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { spawnSync } = require('node:child_process');\n\nconst LEAF_BY_LOOP = {\n  review: 'deep-review',\n  research: 'deep-research',\n};\n\nconst STATE_LOG_BY_LOOP = {\n  review: 'deep-review-state.jsonl',\n  research: 'deep-research-state.jsonl',\n};\n\n// Matches each mode's `artifactId` in its legacy projection contract\n// (runtime/lib/legacy-projections/*-contract.ts) -- the key check-direct-append.cjs\n// uses to locate the gateway's watermark under the packet root.\nconst ARTIFACT_ID_BY_LOOP = {\n  review: 'review-state',\n  research: 'research-state',\n};\n\nconst CHECK_DIRECT_APPEND_CLI = path.join(__dirname, 'check-direct-append.cjs');\n\nconst REASONS = {\n  ITERATION_FILE_MISSING: 'iteration_file_missing',\n  ITERATION_VERDICT_MISSING: 'iteration_verdict_missing',\n  STATE_RECORD_MISSING: 'state_record_missing',\n  ROUTE_PROOF_MISSING: 'route_proof_missing',\n  ROUTE_PROOF_MISMATCH: 'route_proof_mismatch',\n  DELTA_FILE_MISSING: 'delta_file_missing',\n  STATE_LOG_MALFORMED: 'state_log_malformed',\n  DELTA_FILE_MALFORMED: 'delta_file_malformed',\n  GATEWAY_BYPASS_DETECTED: 'gateway_bypass_detected',\n  LEDGER_BACKING_MISSING: 'ledger_backing_missing',\n};\n\nfunction pad3(n) {\n  return String(n).padStart(3, '0');\n}\n\nfunction parseArgs(argv) {\n  const out = { json: false };\n  for (let i = 0; i < argv.length; i += 1) {\n    const a = argv[i];\n    if (a === '--loop-type') { out.loopType = argv[i + 1]; i += 1; }\n    else if (a === '--artifact-dir') { out.artifactDir = argv[i + 1]; i += 1; }\n    else if (a === '--iteration') { out.iteration = parseInt(argv[i + 1], 10); i += 1; }\n    else if (a === '--json') { out.json = true; }\n    else if (a === '--help' || a === '-h') { out.help = true; }\n    else { out.error = `unknown flag: ${a}`; }\n  }\n  return out;\n}\n\n// Read a JSONL file and retain malformed-line evidence so the gate can fail closed.\nfunction readJsonlRecords(filePath) {\n  return readJsonlRecordsDetailed(filePath).records;\n}\n\nfunction readJsonlRecordsDetailed(filePath) {\n  let raw;\n  try {\n    raw = fs.readFileSync(filePath, 'utf8');\n  } catch (_) {\n    return { records: null, malformedLines: [] };\n  }\n  const records = [];\n  const malformedLines = [];\n  let lineNumber = 0;\n  for (const line of raw.split('\\n')) {\n    lineNumber += 1;\n    const trimmed = line.trim();\n    if (!trimmed) continue;\n    try {\n      records.push(JSON.parse(trimmed));\n    } catch (_) {\n      malformedLines.push(lineNumber);\n    }\n  }\n  return { records, malformedLines };\n}\n\n// The narrative file is written as iteration-NNN.md but the leaf may append a\n// descriptive suffix (iteration-NNN-some-focus.md), so match the padded number as a\n// prefix bounded by \".\" or \"-\" to avoid confusing 002 with 020.\nfunction findIterationNarrative(iterationsDir, iteration) {\n  const nnn = pad3(iteration);\n  let entries;\n  try {\n    entries = fs.readdirSync(iterationsDir);\n  } catch (_) {\n    return null;\n  }\n  const re = new RegExp(`^iteration-${nnn}(?:\\\\.md$|-.*\\\\.md$)`);\n  for (const name of entries) {\n    if (re.test(name)) return path.join(iterationsDir, name);\n  }\n  return null;\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === 'string' && value.trim().length > 0;\n}\n\n// Route-proof lives on the canonical iteration record. Absent fields => the leaf did\n// not emit route-proof at all; present-but-wrong => it ran as something other than\n// its own leaf identity or in the wrong mode.\nfunction checkRouteProof(record, loopType, leaf) {\n  const hasMode = 'mode' in record;\n  const hasTarget = 'target_agent' in record;\n  const hasLoaded = 'agent_definition_loaded' in record;\n  const hasRoute = 'resolved_route' in record;\n  if (!hasMode || !hasTarget || !hasLoaded || !hasRoute) {\n    return REASONS.ROUTE_PROOF_MISSING;\n  }\n  if (\n    record.mode !== loopType ||\n    record.target_agent !== leaf ||\n    record.agent_definition_loaded !== true ||\n    !isNonEmptyString(record.resolved_route)\n  ) {\n    return REASONS.ROUTE_PROOF_MISMATCH;\n  }\n  return null;\n}\n\n// Cross-check the projected state log against check-direct-append.cjs's gateway\n// watermark. That script already knows how to read a mode's authority state and\n// stays inert (status 'not-enforced') until the mode has actually cut over to\n// ledger authority, so this call is a no-op everywhere a mode still runs on the\n// legacy writer -- it only turns into a real finding once ledger authority is\n// live and the watermark disagrees with (or is missing for) the file on disk.\n// artifactRoot is the packet root ONE level above artifactDir: the gateway's\n// --run-directory is that packet root, and both the projection's relativePath\n// (\"review/deep-review-state.jsonl\") and the watermark directory\n// (\".legacy-projection-watermarks/\") resolve from it, not from artifactDir itself.\nfunction checkGatewayReceipt(loopType, artifactDir, legacyFilePath) {\n  const leaf = LEAF_BY_LOOP[loopType];\n  const artifactId = ARTIFACT_ID_BY_LOOP[loopType];\n  if (!leaf || !artifactId) return { status: 'skipped' };\n\n  let spawned;\n  try {\n    spawned = spawnSync(process.execPath, [\n      CHECK_DIRECT_APPEND_CLI,\n      '--mode', leaf,\n      '--artifact-root', path.dirname(artifactDir),\n      '--artifact-id', artifactId,\n      '--legacy-file', legacyFilePath,\n    ], { encoding: 'utf8', timeout: 15000 });\n  } catch (error) {\n    return { status: 'error', detail: `check-direct-append spawn failed: ${error instanceof Error ? error.message : String(error)}` };\n  }\n  if (spawned.error) {\n    return { status: 'error', detail: `check-direct-append spawn failed: ${spawned.error.message}` };\n  }\n\n  const lastLine = (spawned.stdout || '').trim().split(/\\r?\\n/).filter(Boolean).at(-1) ?? '';\n  let payload = null;\n  try { payload = JSON.parse(lastLine); } catch (_) { /* handled as inconclusive below */ }\n\n  if (spawned.status === 2 && payload) {\n    return { status: 'violation', detail: payload.reason || `check-direct-append reported ${payload.code || 'a violation'}`, payload };\n  }\n  if (spawned.status === 0 && payload) {\n    return { status: payload.status === 'not-enforced' ? 'not-enforced' : 'ok', payload };\n  }\n  return { status: 'error', detail: `check-direct-append exited ${spawned.status} with unreadable output: ${(spawned.stdout || spawned.stderr || '').slice(0, 200)}` };\n}\n\n// Structural ledger-backing check. Under ledger authority the gateway roots the\n// mode's own append-only ledger ({leaf}-ledger) at its run directory and writes an\n// event there for every iteration it records. A complete-looking projection record\n// with no such ledger behind it is a leaf that wrote the projection directly, so the\n// ledger and the projection have silently diverged. The run directory is the artifact\n// dir for lineage-rooted modes and its parent for packet-rooted ones, so the ledger\n// is accepted at either level; its total absence is the divergence signal. Returns\n// 'not-enforced' before a mode moves to ledger authority (the legacy writer is\n// sanctioned then), and 'skipped' when authority cannot be read (fail-open).\nfunction checkLedgerBacking(loopType, artifactDir, legacyFilePath) {\n  const leaf = LEAF_BY_LOOP[loopType];\n  if (!leaf || !ARTIFACT_ID_BY_LOOP[loopType]) return { status: 'skipped' };\n  const authority = checkGatewayReceipt(loopType, artifactDir, legacyFilePath);\n  if (authority.status !== 'violation' && authority.status !== 'ok') {\n    return { status: 'not-enforced', authority: authority.status };\n  }\n  const roots = [artifactDir, path.dirname(artifactDir)];\n  const backed = roots.some((root) => {\n    const framesDir = path.join(root, `${leaf}-ledger`, 'frames');\n    try {\n      return fs.existsSync(framesDir) && fs.readdirSync(framesDir).some((f) => f.endsWith('.frame'));\n    } catch (_) {\n      return false;\n    }\n  });\n  return { status: backed ? 'backed' : 'unbacked' };\n}\n\nfunction verify(loopType, artifactDir, iteration) {\n  const leaf = LEAF_BY_LOOP[loopType];\n  const stateLogName = STATE_LOG_BY_LOOP[loopType];\n\n  // 1. Iteration narrative markdown.\n  const narrativePath = findIterationNarrative(path.join(artifactDir, 'iterations'), iteration);\n  if (!narrativePath) {\n    return { ok: false, reason: REASONS.ITERATION_FILE_MISSING, detail: `no iterations/iteration-${pad3(iteration)}*.md under ${artifactDir}` };\n  }\n  const narrative = fs.readFileSync(narrativePath, 'utf8');\n  if (!narrative.trim()) {\n    return { ok: false, reason: REASONS.ITERATION_FILE_MISSING, detail: `${narrativePath} is empty` };\n  }\n  // Review narratives must end on exactly one machine-readable verdict; research/context\n  // use a different closing shape, so only review enforces the verdict line here.\n  if (loopType === 'review') {\n    const verdictPattern = /^Review verdict:\\s*(PASS|CONDITIONAL|FAIL)\\s*$/i;\n    const verdictLines = narrative.split(/\\r?\\n/).filter((line) => verdictPattern.test(line));\n    const finalLine = narrative.trimEnd().split(/\\r?\\n/).at(-1) ?? '';\n    if (verdictLines.length !== 1 || !verdictPattern.test(finalLine)) {\n      return { ok: false, reason: REASONS.ITERATION_VERDICT_MISSING, detail: `${narrativePath} must end with exactly one \"Review verdict: PASS|CONDITIONAL|FAIL\" line` };\n    }\n  }\n\n  // 2. Canonical state-log record for this iteration + route-proof.\n  const stateLogPath = path.join(artifactDir, stateLogName);\n  const stateLog = readJsonlRecordsDetailed(stateLogPath);\n  if (stateLog.malformedLines.length > 0) {\n    return { ok: false, reason: REASONS.STATE_LOG_MALFORMED, detail: `${stateLogName} contains malformed JSONL at line(s) ${stateLog.malformedLines.join(', ')}` };\n  }\n  const stateRecords = stateLog.records;\n  // Review/research key the iteration number as `iteration`; context keys it as `run`.\n  // Match either so one shim covers all three modes (a non-numeric run-id yields NaN\n  // and never false-matches). Take the LAST matching record, not the first: the state\n  // log is append-only, so a re-dispatched iteration appends a corrected record after\n  // the bad one -- matching the first would keep reporting the stale failure and defeat\n  // the bounded retry. The state reducer applies the same latest-record-wins rule.\n  const iterationRecord = (stateRecords || []).findLast(\n    (r) => r && r.type === 'iteration' && (Number(r.iteration) === iteration || Number(r.run) === iteration),\n  );\n  if (!iterationRecord) {\n    return { ok: false, reason: REASONS.STATE_RECORD_MISSING, detail: `no type=iteration record with iteration=${iteration} in ${stateLogName}` };\n  }\n  const routeReason = checkRouteProof(iterationRecord, loopType, leaf);\n  if (routeReason) {\n    return { ok: false, reason: routeReason, detail: `iteration ${iteration} state record failed route-proof (expected mode=${loopType} target_agent=${leaf})` };\n  }\n\n  // 2b. Structural ledger-backing gate (default on; DEEP_LOOP_LEDGER_BACKING_GATE=0\n  // disables it as an emergency escape). Under ledger authority a complete-looking\n  // iteration record with no mode ledger behind it means the leaf wrote the projection\n  // directly, bypassing the gateway -- exactly the divergence where the reducer would\n  // otherwise build a report from projection-only state. Fail the iteration loudly.\n  if (process.env.DEEP_LOOP_LEDGER_BACKING_GATE !== '0') {\n    const backing = checkLedgerBacking(loopType, artifactDir, stateLogPath);\n    if (backing.status === 'unbacked') {\n      return {\n        ok: false,\n        reason: REASONS.LEDGER_BACKING_MISSING,\n        detail: `iteration ${iteration}: ${stateLogName} shows a complete iteration but no ${leaf}-ledger events back it — the gateway was bypassed under ledger authority`,\n      };\n    }\n  }\n\n  // 2c. The state log should be backed by the append gateway's ledger, not merely\n  // shaped like a complete record: a leaf that writes the projection directly\n  // produces an indistinguishable type=iteration record with no ledger event\n  // behind it. This corroboration is opt-in: the modes are mid-migration and not\n  // every correct path publishes a projection watermark yet, so enforcing here\n  // would false-alarm on legitimate iterations. When explicitly enabled it is\n  // advisory only -- a warning, never a hard failure -- so a real bypass stays\n  // visible without blocking a possibly-valid iteration. The unambiguous, always-on\n  // defense against a leaf that skips the gateway is the prompt-pack contract,\n  // which now states plainly that the gateway call is required and in-scope.\n  const gatewayCheck = process.env.DEEP_LOOP_VERIFY_GATEWAY_RECEIPT === '1'\n    ? checkGatewayReceipt(loopType, artifactDir, stateLogPath)\n    : { status: 'skipped' };\n  const gatewayWarning = gatewayCheck.status === 'violation'\n    ? `possible direct state-log write for ${stateLogName} (no matching gateway receipt): ${gatewayCheck.detail}`\n    : gatewayCheck.status === 'error'\n      ? `gateway receipt check inconclusive for ${stateLogName}: ${gatewayCheck.detail}`\n      : null;\n\n  // 3. Per-iteration delta file with at least one iteration record.\n  const deltaLog = readJsonlRecordsDetailed(path.join(artifactDir, 'deltas', `iter-${pad3(iteration)}.jsonl`));\n  if (deltaLog.malformedLines.length > 0) {\n    return { ok: false, reason: REASONS.DELTA_FILE_MALFORMED, detail: `deltas/iter-${pad3(iteration)}.jsonl contains malformed JSONL at line(s) ${deltaLog.malformedLines.join(', ')}` };\n  }\n  const deltaRecords = deltaLog.records;\n  if (!deltaRecords || !deltaRecords.some((r) => r && r.type === 'iteration')) {\n    return { ok: false, reason: REASONS.DELTA_FILE_MISSING, detail: `deltas/iter-${pad3(iteration)}.jsonl missing or has no type=iteration record` };\n  }\n\n  return {\n    ok: true,\n    reason: null,\n    detail: `iteration ${iteration} complete: narrative + route-proof + delta`,\n    ...(gatewayWarning ? { warnings: [gatewayWarning] } : {}),\n  };\n}\n\nfunction main(argv = process.argv.slice(2)) {\n  const args = parseArgs(argv);\n  if (args.help) {\n    process.stdout.write(`Usage: verify-iteration.cjs --loop-type ${Object.keys(LEAF_BY_LOOP).join('|')} --artifact-dir <dir> --iteration <N> [--json]\\n`);\n    return 0;\n  }\n  if (args.error) { process.stderr.write(`${args.error}\\n`); return 2; }\n  if (!args.loopType || !LEAF_BY_LOOP[args.loopType]) { process.stderr.write(`--loop-type must be one of ${Object.keys(LEAF_BY_LOOP).join('|')}\\n`); return 2; }\n  if (!args.artifactDir) { process.stderr.write('--artifact-dir is required\\n'); return 2; }\n  if (!Number.isInteger(args.iteration) || args.iteration < 1) { process.stderr.write('--iteration must be a positive integer\\n'); return 2; }\n\n  const result = verify(args.loopType, args.artifactDir, args.iteration);\n  if (args.json) {\n    process.stdout.write(`${JSON.stringify(result)}\\n`);\n  } else if (result.ok) {\n    process.stdout.write(`OK ${result.detail}\\n`);\n  } else {\n    process.stderr.write(`${result.reason} ${result.detail}\\n`);\n  }\n  // Warnings ride on an ok:true result, so a plain OK line would otherwise hide\n  // them from a human running this outside --json.\n  if (result.warnings) {\n    for (const warning of result.warnings) process.stderr.write(`WARNING ${warning}\\n`);\n  }\n  return result.ok ? 0 : 1;\n}\n\nif (require.main === module) {\n  process.exit(main());\n}\n\nmodule.exports = { verify, checkGatewayReceipt, checkRouteProof, findIterationNarrative, readJsonlRecords, readJsonlRecordsDetailed, pad3, REASONS, LEAF_BY_LOOP, STATE_LOG_BY_LOOP, ARTIFACT_ID_BY_LOOP };","lineStart":1,"lineEnd":353,"totalLines":353,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs","time":{"start":1788632194148,"end":1788632194151}},"id":"prt_072c95c61001nImSL1Gz3eRYz1","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c92c55001q0ZR6BB3CJI6WK"}}
{"type":"tool_use","timestamp":1788632194199,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_w1LcYIwXxzJ3xOY392N860LE","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts","offset":1,"limit":500},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep-Loop Post-Dispatch Validator\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { existsSync, readFileSync, renameSync, rmSync, statSync, truncateSync, writeFileSync } from 'node:fs';\n6: import { join, resolve } from 'node:path';\n7: \n8: import { validateEvidenceContract } from './evidence-contract.js';\n9: import { appendJsonlRecord } from './jsonl-repair.js';\n10: import { deriveReceiptKeyForDispatch } from './executor-audit.js';\n11: import { canonicalReceiptJson, verifyReceipt } from './receipt-crypto.js';\n12: import type { ExecutorKind } from './executor-config.js';\n13: \n14: // ───── 1. TYPE DEFINITIONS ─────\n15: \n16: export type VerificationLanguage = 'python' | 'typescript' | 'javascript' | 'rust' | 'go';\n17: \n18: export type PostDispatchRecipeConfig = {\n19:   verification_enabled?: boolean;\n20:   verification_languages?: VerificationLanguage[];\n21:   verification_threshold?: number;\n22:   judge_quarantine_enabled?: boolean;\n23: };\n24: \n25: export type RouteProofExpectation = {\n26:   mode: string;\n27:   targetAgent: string;\n28:   resolvedRoute: string;\n29:   requireAgentDefinitionLoaded?: boolean;\n30: };\n31: \n32: export type DispatchReceiptExpectation = {\n33:   receiptDir: string;\n34:   dispatchId: string;\n35: };\n36: \n37: export type PostDispatchValidateInput = {\n38:   iterationFile: string;\n39:   stateLogPath: string;\n40:   previousStateLogSize: number;\n41:   requiredJsonlFields: string[];\n42:   executorKind?: ExecutorKind;\n43:   deltaFilePath?: string;\n44:   routeProof?: RouteProofExpectation;\n45:   recipeConfig?: PostDispatchRecipeConfig;\n46:   // When set, the validator requires a structurally intact, intent-bound\n47:   // dispatch receipt pair (intent + completion) before accepting the\n48:   // state-log append; a mac that fails to cryptographically correlate is\n49:   // reported as a warning, not a blocking failure (see\n50:   // validateDispatchReceipt). Dispatches that did not opt into receipts omit\n51:   // it and keep legacy behavior.\n52:   dispatchReceipt?: DispatchReceiptExpectation;\n53: };\n54: \n55: /** Failure class recorded for a hardened judge attempt. */\n56: export type JudgeFailureKind = 'model_error' | 'parse_error' | 'slow_timeout' | 'unknown';\n57: \n58: /** Persistence destinations protected by judge-card quarantine. */\n59: export type JudgePersistenceSurface = 'persistence' | 'convergence' | 'coverage';\n60: \n61: /** A failed judge attempt with retry and timeout diagnostics. */\n62: export interface JudgeAttemptFailure {\n63:   attempt: number;\n64:   kind: JudgeFailureKind;\n65:   message: string;\n66:   fastTimedOut: boolean;\n67:   formatStripRetried: boolean;\n68: }\n69: \n70: /** Retry, timeout, and parser configuration for a hardened judge call. */\n71: export interface JudgeHardeningConfig {\n72:   maxAttempts?: number;\n73:   backoffMs?: number | ((attempt: number) => number);\n74:   fastTimeoutMs?: number;\n75:   slowTimeoutMs?: number;\n76:   now?: () => string;\n77:   sleep?: (ms: number) => Promise<void>;\n78: }\n79: \n80: /** Input for running one model-backed judge call through hardening layers. */\n81: export interface JudgeHardeningInput<TCard extends Record<string, unknown>> extends JudgeHardeningConfig {\n82:   invoke: () => Promise<string>;\n83:   parse?: (record: Record<string, unknown>) => TCard;\n84:   fallbackReason?: string;\n85: }\n86: \n87: /** Metadata attached to neutral judge fallback cards. */\n88: export interface JudgeFallbackMetadata {\n89:   attempts: number;\n90:   maxAttempts: number;\n91:   failureKind: JudgeFailureKind;\n92:   failures: JudgeAttemptFailure[];\n93:   formatStripRetries: number;\n94:   fastTimeouts: number;\n95:   slowTimeouts: number;\n96:   generatedAt: string;\n97: }\n98: \n99: /** Input for constructing a neutral quarantined judge fallback card. */\n100: export interface JudgeFallbackInput {\n101:   reason: string;\n102:   failures: JudgeAttemptFailure[];\n103:   maxAttempts: number;\n104:   formatStripRetries: number;\n105:   fastTimeouts: number;\n106:   slowTimeouts: number;\n107:   now?: () => string;\n108: }\n109: \n110: /** Neutral card emitted when judge retries cannot produce a parseable score. */\n111: export interface NeutralJudgeFallbackCard extends Record<string, unknown> {\n112:   type: 'judge_fallback_card';\n113:   fallback: true;\n114:   quarantined: true;\n115:   score: 0.5;\n116:   confidence: 0;\n117:   reason: string;\n118:   metadata: JudgeFallbackMetadata;\n119: }\n120: \n121: /** Result from a hardened judge call. */\n122: export type JudgeHardeningResult<TCard extends Record<string, unknown>> =\n123:   | {\n124:       ok: true;\n125:       card: TCard;\n126:       attempts: number;\n127:       failures: JudgeAttemptFailure[];\n128:       formatStripRetries: number;\n129:       fastTimeouts: number;\n130:       slowTimeouts: number;\n131:     }\n132:   | {\n133:       ok: false;\n134:       card: NeutralJudgeFallbackCard;\n135:       attempts: number;\n136:       failures: JudgeAttemptFailure[];\n137:       formatStripRetries: number;\n138:       fastTimeouts: number;\n139:       slowTimeouts: number;\n140:     };\n141: \n142: /** Writer callback for a judge card persistence surface. */\n143: export type JudgePersistenceWriter<TCard extends Record<string, unknown>> = (\n144:   card: TCard,\n145:   surface: JudgePersistenceSurface,\n146: ) => void | Promise<void>;\n147: \n148: /** Persistence writers guarded by the quarantine boundary. */\n149: export type JudgePersistenceWriters<TCard extends Record<string, unknown>> = Partial<\n150:   Record<JudgePersistenceSurface, JudgePersistenceWriter<TCard>>\n151: >;\n152: \n153: /** Summary of judge-card persistence after quarantine checks. */\n154: export interface JudgePersistenceResult {\n155:   persisted: boolean;\n156:   writtenSurfaces: JudgePersistenceSurface[];\n157:   skippedSurfaces: JudgePersistenceSurface[];\n158:   reason?: 'quarantined' | 'no_writer';\n159: }\n160: \n161: export type VerificationStageScores = {\n162:   compiled: boolean;\n163:   executed: boolean;\n164:   testsPassed: boolean;\n165:   lintClean: boolean;\n166:   autoFixed: boolean;\n167: };\n168: \n169: export type VerificationPassResult =\n170:   | { ok: true; skipped: true; reason: 'verification_disabled' | 'no_code_output' }\n171:   | {\n172:       ok: true;\n173:       skipped: false;\n174:       confidence: number;\n175:       threshold: number;\n176:       language: VerificationLanguage;\n177:       stages: VerificationStageScores;\n178:     }\n179:   | {\n180:       ok: false;\n181:       reason: 'verification_degraded';\n182:       confidence: number;\n183:       threshold: number;\n184:       language: VerificationLanguage;\n185:       details: string;\n186:       stages: VerificationStageScores;\n187:     };\n188: \n189: export type PostDispatchAdvisory = { code: string; detail: string; fieldPath?: string };\n190: \n191: type PostDispatchFailureReason =\n192:   | 'iteration_file_missing'\n193:   | 'iteration_file_empty'\n194:   | 'jsonl_not_appended'\n195:   | 'jsonl_missing_fields'\n196:   | 'jsonl_parse_error'\n197:   | 'jsonl_wrong_type'\n198:   | 'delta_file_missing'\n199:   | 'delta_file_empty'\n200:   | 'delta_file_missing_iteration_record'\n201:   | 'executor_missing'\n202:   | 'dispatch_failure_logged'\n203:   | 'verification_degraded'\n204:   | 'route_proof_missing'\n205:   | 'route_proof_mismatch'\n206:   | 'dispatch_receipt_missing'\n207:   | 'dispatch_receipt_invalid_mac'\n208:   | 'dispatch_receipt_intent_mismatch'\n209:   | 'v2_missing_ledger'\n210:   | 'v2_uncited_ledger_row'\n211:   | 'v2_broken_linked_finding'\n212:   | 'v2_shallow_finding_details'\n213:   | 'delta_iteration_id_mismatch'\n214:   | 'state_delta_iteration_mismatch';\n215: \n216: export type PostDispatchValidateResult =\n217:   | { ok: true; warnings?: PostDispatchAdvisory[] }\n218:   | {\n219:       ok: false;\n220:       reason: PostDispatchFailureReason;\n221:       details: string;\n222:       warnings?: PostDispatchAdvisory[];\n223:     };\n224: \n225: // ───── 2. DOMAIN ERRORS ─────\n226: \n227: export class PostDispatchValidationError extends Error {\n228:   result: PostDispatchValidateResult;\n229: \n230:   constructor(result: PostDispatchValidateResult) {\n231:     super(result.ok ? 'Post-dispatch validation unexpectedly succeeded' : `${result.reason}: ${result.details}`);\n232:     this.name = 'PostDispatchValidationError';\n233:     this.result = result;\n234:   }\n235: }\n236: \n237: class JudgeTimeoutError extends Error {\n238:   kind: 'slow_timeout';\n239: \n240:   constructor(message: string) {\n241:     super(message);\n242:     this.name = 'JudgeTimeoutError';\n243:     this.kind = 'slow_timeout';\n244:   }\n245: }\n246: \n247: // ───── 3. CONSTANTS ─────\n248: \n249: const CANONICAL_ITERATION_TYPE = 'iteration' as const;\n250: const DEFAULT_VERIFICATION_THRESHOLD = 0.5;\n251: const DEFAULT_JUDGE_MAX_ATTEMPTS = 1;\n252: const DEFAULT_JUDGE_BACKOFF_MS = 0;\n253: const DEFAULT_JUDGE_FAST_TIMEOUT_MS = 10_000;\n254: const DEFAULT_JUDGE_SLOW_TIMEOUT_MS = 60_000;\n255: const JUDGE_PERSISTENCE_SURFACES = ['persistence', 'convergence', 'coverage'] as const;\n256: const SUPPORTED_VERIFICATION_LANGUAGES = new Set<VerificationLanguage>([\n257:   'python',\n258:   'typescript',\n259:   'javascript',\n260:   'rust',\n261:   'go',\n262: ]);\n263: const REVIEW_ITERATION_FIELDS = [\n264:   'type',\n265:   'iteration',\n266:   'mode',\n267:   'run',\n268:   'status',\n269:   'focus',\n270:   'dimensions',\n271:   'filesReviewed',\n272:   'findingsCount',\n273:   'findingsSummary',\n274:   'findingsNew',\n275:   'newFindingsRatio',\n276:   'sessionId',\n277:   'generation',\n278:   'lineageMode',\n279:   'timestamp',\n280:   'durationMs',\n281: ] as const;\n282: const V2_SCOPE_CLASSES = new Set(['trivial', 'standard', 'complex']);\n283: const V2_ENFORCEMENT_MODES = new Set(['strict', 'warn', 'skip']);\n284: const V2_GRAPH_COVERAGE_MODES = new Set(['graph', 'graphless_fallback', 'unavailable_blocked']);\n285: \n286: type V2EnforcementMode = 'warn' | 'strict' | 'off';\n287: type V2ValidationFailure = {\n288:   reason: PostDispatchFailureReason;\n289:   details: string;\n290:   fieldPath?: string;\n291: };\n292: type IterationRecordWithLogRegion = Record<string, unknown> & {\n293:   logOffset?: number;\n294:   logSize?: number;\n295:   logPath?: string;\n296: };\n297: type JsonlLineRegion = {\n298:   rawLine: string;\n299:   startOffset: number;\n300:   nextOffset: number;\n301:   parsed: unknown;\n302: };\n303: \n304: // ───── 4. HELPERS ─────\n305: \n306: type JudgeParseResult =\n307:   | { ok: true; record: Record<string, unknown>; formatStripRetried: boolean }\n308:   | { ok: false; error: string; formatStripRetried: boolean };\n309: \n310: function normalizePositiveInteger(value: number | undefined, fallback: number): number {\n311:   if (value === undefined || !Number.isFinite(value)) {\n312:     return fallback;\n313:   }\n314:   return Math.max(1, Math.floor(value));\n315: }\n316: \n317: function normalizeNonNegativeInteger(value: number | undefined, fallback: number): number {\n318:   if (value === undefined || !Number.isFinite(value)) {\n319:     return fallback;\n320:   }\n321:   return Math.max(0, Math.floor(value));\n322: }\n323: \n324: function errorMessage(error: unknown): string {\n325:   return error instanceof Error ? error.message : String(error);\n326: }\n327: \n328: function defaultSleep(ms: number): Promise<void> {\n329:   return new Promise((resolveSleep) => {\n330:     setTimeout(resolveSleep, ms);\n331:   });\n332: }\n333: \n334: function resolveJudgeBackoffMs(backoff: JudgeHardeningConfig['backoffMs'], attempt: number): number {\n335:   if (typeof backoff === 'function') {\n336:     return normalizeNonNegativeInteger(backoff(attempt), DEFAULT_JUDGE_BACKOFF_MS);\n337:   }\n338:   return normalizeNonNegativeInteger(backoff, DEFAULT_JUDGE_BACKOFF_MS);\n339: }\n340: \n341: function parseJsonObject(text: string): { ok: true; record: Record<string, unknown> } | { ok: false; error: string } {\n342:   try {\n343:     const parsed: unknown = JSON.parse(text);\n344:     if (!isObjectRecord(parsed)) {\n345:       return { ok: false, error: 'judge response JSON is not an object' };\n346:     }\n347:     return { ok: true, record: parsed };\n348:   } catch (error: unknown) {\n349:     return { ok: false, error: errorMessage(error) };\n350:   }\n351: }\n352: \n353: function stripMarkdownJsonFence(text: string): string {\n354:   const trimmed = text.trim();\n355:   const match = trimmed.match(/^```(?:json)?\\s*\\r?\\n?([\\s\\S]*?)\\r?\\n?```\\s*$/i);\n356:   return match?.[1]?.trim() ?? trimmed;\n357: }\n358: \n359: function parseJudgeJsonWithFormatStrip(text: string): JudgeParseResult {\n360:   const trimmed = text.trim();\n361:   if (trimmed === '') {\n362:     return { ok: false, error: 'judge response was empty', formatStripRetried: false };\n363:   }\n364: \n365:   const direct = parseJsonObject(trimmed);\n366:   if (direct.ok) {\n367:     return { ok: true, record: direct.record, formatStripRetried: false };\n368:   }\n369: \n370:   const stripped = stripMarkdownJsonFence(trimmed);\n371:   if (stripped !== trimmed) {\n372:     const strippedParse = parseJsonObject(stripped);\n373:     if (strippedParse.ok) {\n374:       return { ok: true, record: strippedParse.record, formatStripRetried: true };\n375:     }\n376:     return { ok: false, error: strippedParse.error, formatStripRetried: true };\n377:   }\n378: \n379:   return { ok: false, error: direct.error, formatStripRetried: false };\n380: }\n381: \n382: async function callJudgeWithDualTimeouts(\n383:   invoke: () => Promise<string>,\n384:   fastTimeoutMs: number,\n385:   slowTimeoutMs: number,\n386: ): Promise<{ text: string; fastTimedOut: boolean }> {\n387:   const normalizedSlowTimeoutMs = Math.max(fastTimeoutMs, slowTimeoutMs);\n388:   const operation = invoke();\n389:   let fastTimer: ReturnType<typeof setTimeout> | undefined;\n390: \n391:   const fastResult = await (async (): Promise<\n392:     | { kind: 'response'; text: string }\n393:     | { kind: 'fast_timeout' }\n394:   > => {\n395:     try {\n396:       return await Promise.race<\n397:         | { kind: 'response'; text: string }\n398:         | { kind: 'fast_timeout' }\n399:       >([\n400:         operation.then((text) => ({ kind: 'response', text })),\n401:         new Promise<{ kind: 'fast_timeout' }>((resolveTimeout) => {\n402:           fastTimer = setTimeout(() => resolveTimeout({ kind: 'fast_timeout' }), fastTimeoutMs);\n403:         }),\n404:       ]);\n405:     } finally {\n406:       if (fastTimer !== undefined) {\n407:         clearTimeout(fastTimer);\n408:       }\n409:     }\n410:   })();\n411: \n412:   if (fastResult.kind === 'response') {\n413:     return { text: fastResult.text, fastTimedOut: false };\n414:   }\n415: \n416:   let slowTimer: ReturnType<typeof setTimeout> | undefined;\n417:   const remainingTimeoutMs = Math.max(0, normalizedSlowTimeoutMs - fastTimeoutMs);\n418:   try {\n419:     const text = await Promise.race([\n420:       operation,\n421:       new Promise<never>((_, reject) => {\n422:         slowTimer = setTimeout(() => {\n423:           reject(new JudgeTimeoutError(`judge slow timeout after ${normalizedSlowTimeoutMs}ms`));\n424:         }, remainingTimeoutMs);\n425:       }),\n426:     ]);\n427:     return { text, fastTimedOut: true };\n428:   } catch (error: unknown) {\n429:     operation.catch(() => undefined);\n430:     throw error;\n431:   } finally {\n432:     if (slowTimer !== undefined) {\n433:       clearTimeout(slowTimer);\n434:     }\n435:   }\n436: }\n437: \n438: function clampByteOffset(value: number, contentLength: number): number {\n439:   if (!Number.isFinite(value)) {\n440:     return 0;\n441:   }\n442:   return Math.max(0, Math.min(Math.floor(value), contentLength));\n443: }\n444: \n445: function isObjectRecord(value: unknown): value is Record<string, unknown> {\n446:   return value !== null && !Array.isArray(value) && typeof value === 'object';\n447: }\n448: \n449: function isStringArray(value: unknown): value is string[] {\n450:   return Array.isArray(value) && value.every((entry) => typeof entry === 'string');\n451: }\n452: \n453: function isNonEmptyStringArray(value: unknown): value is string[] {\n454:   return isStringArray(value) && value.length > 0;\n455: }\n456: \n457: function isVerificationLanguage(value: string): value is VerificationLanguage {\n458:   return SUPPORTED_VERIFICATION_LANGUAGES.has(value as VerificationLanguage);\n459: }\n460: \n461: function normalizeFenceLanguage(language: string): VerificationLanguage | null {\n462:   const normalized = language.trim().toLowerCase();\n463:   if (normalized === 'py' || normalized === 'python') return 'python';\n464:   if (normalized === 'ts' || normalized === 'tsx' || normalized === 'typescript') return 'typescript';\n465:   if (normalized === 'js' || normalized === 'mjs' || normalized === 'javascript') return 'javascript';\n466:   if (normalized === 'rs' || normalized === 'rust') return 'rust';\n467:   if (normalized === 'go' || normalized === 'golang') return 'go';\n468:   return null;\n469: }\n470: \n471: function extractCodeBlocks(\n472:   content: string,\n473:   allowedLanguages: VerificationLanguage[],\n474: ): Array<{ language: VerificationLanguage; code: string }> {\n475:   const blocks: Array<{ language: VerificationLanguage; code: string }> = [];\n476:   const fencePattern = /```([a-zA-Z0-9_-]+)\\n([\\s\\S]*?)```/g;\n477:   let match: RegExpExecArray | null;\n478: \n479:   while ((match = fencePattern.exec(content)) !== null) {\n480:     const language = normalizeFenceLanguage(match[1] ?? '');\n481:     if (language && (allowedLanguages.length === 0 || allowedLanguages.includes(language))) {\n482:       blocks.push({ language, code: match[2] ?? '' });\n483:     }\n484:   }\n485: \n486:   return blocks;\n487: }\n488: \n489: function bracesBalanced(code: string): boolean {\n490:   let balance = 0;\n491:   for (const char of code) {\n492:     if (char === '{') balance += 1;\n493:     if (char === '}') balance -= 1;\n494:     if (balance < 0) return false;\n495:   }\n496:   return balance === 0;\n497: }\n498: \n499: function hasPlaceholderOrTruncation(code: string): boolean {\n500:   return /TODO|NotImplementedError|pass\\s+#\\s*placeholder|\\[\\.\\.\\. truncated|\\.\\.\\. rest of|\\.\\.\\. more/i.test(code);\n\n(Showing lines 1-500 of 1840. Use offset=501 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep-Loop Post-Dispatch Validator\n// ───────────────────────────────────────────────────────────────────\n\nimport { existsSync, readFileSync, renameSync, rmSync, statSync, truncateSync, writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\n\nimport { validateEvidenceContract } from './evidence-contract.js';\nimport { appendJsonlRecord } from './jsonl-repair.js';\nimport { deriveReceiptKeyForDispatch } from './executor-audit.js';\nimport { canonicalReceiptJson, verifyReceipt } from './receipt-crypto.js';\nimport type { ExecutorKind } from './executor-config.js';\n\n// ───── 1. TYPE DEFINITIONS ─────\n\nexport type VerificationLanguage = 'python' | 'typescript' | 'javascript' | 'rust' | 'go';\n\nexport type PostDispatchRecipeConfig = {\n  verification_enabled?: boolean;\n  verification_languages?: VerificationLanguage[];","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep-Loop Post-Dispatch Validator\n// ───────────────────────────────────────────────────────────────────\n\nimport { existsSync, readFileSync, renameSync, rmSync, statSync, truncateSync, writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\n\nimport { validateEvidenceContract } from './evidence-contract.js';\nimport { appendJsonlRecord } from './jsonl-repair.js';\nimport { deriveReceiptKeyForDispatch } from './executor-audit.js';\nimport { canonicalReceiptJson, verifyReceipt } from './receipt-crypto.js';\nimport type { ExecutorKind } from './executor-config.js';\n\n// ───── 1. TYPE DEFINITIONS ─────\n\nexport type VerificationLanguage = 'python' | 'typescript' | 'javascript' | 'rust' | 'go';\n\nexport type PostDispatchRecipeConfig = {\n  verification_enabled?: boolean;\n  verification_languages?: VerificationLanguage[];\n  verification_threshold?: number;\n  judge_quarantine_enabled?: boolean;\n};\n\nexport type RouteProofExpectation = {\n  mode: string;\n  targetAgent: string;\n  resolvedRoute: string;\n  requireAgentDefinitionLoaded?: boolean;\n};\n\nexport type DispatchReceiptExpectation = {\n  receiptDir: string;\n  dispatchId: string;\n};\n\nexport type PostDispatchValidateInput = {\n  iterationFile: string;\n  stateLogPath: string;\n  previousStateLogSize: number;\n  requiredJsonlFields: string[];\n  executorKind?: ExecutorKind;\n  deltaFilePath?: string;\n  routeProof?: RouteProofExpectation;\n  recipeConfig?: PostDispatchRecipeConfig;\n  // When set, the validator requires a structurally intact, intent-bound\n  // dispatch receipt pair (intent + completion) before accepting the\n  // state-log append; a mac that fails to cryptographically correlate is\n  // reported as a warning, not a blocking failure (see\n  // validateDispatchReceipt). Dispatches that did not opt into receipts omit\n  // it and keep legacy behavior.\n  dispatchReceipt?: DispatchReceiptExpectation;\n};\n\n/** Failure class recorded for a hardened judge attempt. */\nexport type JudgeFailureKind = 'model_error' | 'parse_error' | 'slow_timeout' | 'unknown';\n\n/** Persistence destinations protected by judge-card quarantine. */\nexport type JudgePersistenceSurface = 'persistence' | 'convergence' | 'coverage';\n\n/** A failed judge attempt with retry and timeout diagnostics. */\nexport interface JudgeAttemptFailure {\n  attempt: number;\n  kind: JudgeFailureKind;\n  message: string;\n  fastTimedOut: boolean;\n  formatStripRetried: boolean;\n}\n\n/** Retry, timeout, and parser configuration for a hardened judge call. */\nexport interface JudgeHardeningConfig {\n  maxAttempts?: number;\n  backoffMs?: number | ((attempt: number) => number);\n  fastTimeoutMs?: number;\n  slowTimeoutMs?: number;\n  now?: () => string;\n  sleep?: (ms: number) => Promise<void>;\n}\n\n/** Input for running one model-backed judge call through hardening layers. */\nexport interface JudgeHardeningInput<TCard extends Record<string, unknown>> extends JudgeHardeningConfig {\n  invoke: () => Promise<string>;\n  parse?: (record: Record<string, unknown>) => TCard;\n  fallbackReason?: string;\n}\n\n/** Metadata attached to neutral judge fallback cards. */\nexport interface JudgeFallbackMetadata {\n  attempts: number;\n  maxAttempts: number;\n  failureKind: JudgeFailureKind;\n  failures: JudgeAttemptFailure[];\n  formatStripRetries: number;\n  fastTimeouts: number;\n  slowTimeouts: number;\n  generatedAt: string;\n}\n\n/** Input for constructing a neutral quarantined judge fallback card. */\nexport interface JudgeFallbackInput {\n  reason: string;\n  failures: JudgeAttemptFailure[];\n  maxAttempts: number;\n  formatStripRetries: number;\n  fastTimeouts: number;\n  slowTimeouts: number;\n  now?: () => string;\n}\n\n/** Neutral card emitted when judge retries cannot produce a parseable score. */\nexport interface NeutralJudgeFallbackCard extends Record<string, unknown> {\n  type: 'judge_fallback_card';\n  fallback: true;\n  quarantined: true;\n  score: 0.5;\n  confidence: 0;\n  reason: string;\n  metadata: JudgeFallbackMetadata;\n}\n\n/** Result from a hardened judge call. */\nexport type JudgeHardeningResult<TCard extends Record<string, unknown>> =\n  | {\n      ok: true;\n      card: TCard;\n      attempts: number;\n      failures: JudgeAttemptFailure[];\n      formatStripRetries: number;\n      fastTimeouts: number;\n      slowTimeouts: number;\n    }\n  | {\n      ok: false;\n      card: NeutralJudgeFallbackCard;\n      attempts: number;\n      failures: JudgeAttemptFailure[];\n      formatStripRetries: number;\n      fastTimeouts: number;\n      slowTimeouts: number;\n    };\n\n/** Writer callback for a judge card persistence surface. */\nexport type JudgePersistenceWriter<TCard extends Record<string, unknown>> = (\n  card: TCard,\n  surface: JudgePersistenceSurface,\n) => void | Promise<void>;\n\n/** Persistence writers guarded by the quarantine boundary. */\nexport type JudgePersistenceWriters<TCard extends Record<string, unknown>> = Partial<\n  Record<JudgePersistenceSurface, JudgePersistenceWriter<TCard>>\n>;\n\n/** Summary of judge-card persistence after quarantine checks. */\nexport interface JudgePersistenceResult {\n  persisted: boolean;\n  writtenSurfaces: JudgePersistenceSurface[];\n  skippedSurfaces: JudgePersistenceSurface[];\n  reason?: 'quarantined' | 'no_writer';\n}\n\nexport type VerificationStageScores = {\n  compiled: boolean;\n  executed: boolean;\n  testsPassed: boolean;\n  lintClean: boolean;\n  autoFixed: boolean;\n};\n\nexport type VerificationPassResult =\n  | { ok: true; skipped: true; reason: 'verification_disabled' | 'no_code_output' }\n  | {\n      ok: true;\n      skipped: false;\n      confidence: number;\n      threshold: number;\n      language: VerificationLanguage;\n      stages: VerificationStageScores;\n    }\n  | {\n      ok: false;\n      reason: 'verification_degraded';\n      confidence: number;\n      threshold: number;\n      language: VerificationLanguage;\n      details: string;\n      stages: VerificationStageScores;\n    };\n\nexport type PostDispatchAdvisory = { code: string; detail: string; fieldPath?: string };\n\ntype PostDispatchFailureReason =\n  | 'iteration_file_missing'\n  | 'iteration_file_empty'\n  | 'jsonl_not_appended'\n  | 'jsonl_missing_fields'\n  | 'jsonl_parse_error'\n  | 'jsonl_wrong_type'\n  | 'delta_file_missing'\n  | 'delta_file_empty'\n  | 'delta_file_missing_iteration_record'\n  | 'executor_missing'\n  | 'dispatch_failure_logged'\n  | 'verification_degraded'\n  | 'route_proof_missing'\n  | 'route_proof_mismatch'\n  | 'dispatch_receipt_missing'\n  | 'dispatch_receipt_invalid_mac'\n  | 'dispatch_receipt_intent_mismatch'\n  | 'v2_missing_ledger'\n  | 'v2_uncited_ledger_row'\n  | 'v2_broken_linked_finding'\n  | 'v2_shallow_finding_details'\n  | 'delta_iteration_id_mismatch'\n  | 'state_delta_iteration_mismatch';\n\nexport type PostDispatchValidateResult =\n  | { ok: true; warnings?: PostDispatchAdvisory[] }\n  | {\n      ok: false;\n      reason: PostDispatchFailureReason;\n      details: string;\n      warnings?: PostDispatchAdvisory[];\n    };\n\n// ───── 2. DOMAIN ERRORS ─────\n\nexport class PostDispatchValidationError extends Error {\n  result: PostDispatchValidateResult;\n\n  constructor(result: PostDispatchValidateResult) {\n    super(result.ok ? 'Post-dispatch validation unexpectedly succeeded' : `${result.reason}: ${result.details}`);\n    this.name = 'PostDispatchValidationError';\n    this.result = result;\n  }\n}\n\nclass JudgeTimeoutError extends Error {\n  kind: 'slow_timeout';\n\n  constructor(message: string) {\n    super(message);\n    this.name = 'JudgeTimeoutError';\n    this.kind = 'slow_timeout';\n  }\n}\n\n// ───── 3. CONSTANTS ─────\n\nconst CANONICAL_ITERATION_TYPE = 'iteration' as const;\nconst DEFAULT_VERIFICATION_THRESHOLD = 0.5;\nconst DEFAULT_JUDGE_MAX_ATTEMPTS = 1;\nconst DEFAULT_JUDGE_BACKOFF_MS = 0;\nconst DEFAULT_JUDGE_FAST_TIMEOUT_MS = 10_000;\nconst DEFAULT_JUDGE_SLOW_TIMEOUT_MS = 60_000;\nconst JUDGE_PERSISTENCE_SURFACES = ['persistence', 'convergence', 'coverage'] as const;\nconst SUPPORTED_VERIFICATION_LANGUAGES = new Set<VerificationLanguage>([\n  'python',\n  'typescript',\n  'javascript',\n  'rust',\n  'go',\n]);\nconst REVIEW_ITERATION_FIELDS = [\n  'type',\n  'iteration',\n  'mode',\n  'run',\n  'status',\n  'focus',\n  'dimensions',\n  'filesReviewed',\n  'findingsCount',\n  'findingsSummary',\n  'findingsNew',\n  'newFindingsRatio',\n  'sessionId',\n  'generation',\n  'lineageMode',\n  'timestamp',\n  'durationMs',\n] as const;\nconst V2_SCOPE_CLASSES = new Set(['trivial', 'standard', 'complex']);\nconst V2_ENFORCEMENT_MODES = new Set(['strict', 'warn', 'skip']);\nconst V2_GRAPH_COVERAGE_MODES = new Set(['graph', 'graphless_fallback', 'unavailable_blocked']);\n\ntype V2EnforcementMode = 'warn' | 'strict' | 'off';\ntype V2ValidationFailure = {\n  reason: PostDispatchFailureReason;\n  details: string;\n  fieldPath?: string;\n};\ntype IterationRecordWithLogRegion = Record<string, unknown> & {\n  logOffset?: number;\n  logSize?: number;\n  logPath?: string;\n};\ntype JsonlLineRegion = {\n  rawLine: string;\n  startOffset: number;\n  nextOffset: number;\n  parsed: unknown;\n};\n\n// ───── 4. HELPERS ─────\n\ntype JudgeParseResult =\n  | { ok: true; record: Record<string, unknown>; formatStripRetried: boolean }\n  | { ok: false; error: string; formatStripRetried: boolean };\n\nfunction normalizePositiveInteger(value: number | undefined, fallback: number): number {\n  if (value === undefined || !Number.isFinite(value)) {\n    return fallback;\n  }\n  return Math.max(1, Math.floor(value));\n}\n\nfunction normalizeNonNegativeInteger(value: number | undefined, fallback: number): number {\n  if (value === undefined || !Number.isFinite(value)) {\n    return fallback;\n  }\n  return Math.max(0, Math.floor(value));\n}\n\nfunction errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n\nfunction defaultSleep(ms: number): Promise<void> {\n  return new Promise((resolveSleep) => {\n    setTimeout(resolveSleep, ms);\n  });\n}\n\nfunction resolveJudgeBackoffMs(backoff: JudgeHardeningConfig['backoffMs'], attempt: number): number {\n  if (typeof backoff === 'function') {\n    return normalizeNonNegativeInteger(backoff(attempt), DEFAULT_JUDGE_BACKOFF_MS);\n  }\n  return normalizeNonNegativeInteger(backoff, DEFAULT_JUDGE_BACKOFF_MS);\n}\n\nfunction parseJsonObject(text: string): { ok: true; record: Record<string, unknown> } | { ok: false; error: string } {\n  try {\n    const parsed: unknown = JSON.parse(text);\n    if (!isObjectRecord(parsed)) {\n      return { ok: false, error: 'judge response JSON is not an object' };\n    }\n    return { ok: true, record: parsed };\n  } catch (error: unknown) {\n    return { ok: false, error: errorMessage(error) };\n  }\n}\n\nfunction stripMarkdownJsonFence(text: string): string {\n  const trimmed = text.trim();\n  const match = trimmed.match(/^```(?:json)?\\s*\\r?\\n?([\\s\\S]*?)\\r?\\n?```\\s*$/i);\n  return match?.[1]?.trim() ?? trimmed;\n}\n\nfunction parseJudgeJsonWithFormatStrip(text: string): JudgeParseResult {\n  const trimmed = text.trim();\n  if (trimmed === '') {\n    return { ok: false, error: 'judge response was empty', formatStripRetried: false };\n  }\n\n  const direct = parseJsonObject(trimmed);\n  if (direct.ok) {\n    return { ok: true, record: direct.record, formatStripRetried: false };\n  }\n\n  const stripped = stripMarkdownJsonFence(trimmed);\n  if (stripped !== trimmed) {\n    const strippedParse = parseJsonObject(stripped);\n    if (strippedParse.ok) {\n      return { ok: true, record: strippedParse.record, formatStripRetried: true };\n    }\n    return { ok: false, error: strippedParse.error, formatStripRetried: true };\n  }\n\n  return { ok: false, error: direct.error, formatStripRetried: false };\n}\n\nasync function callJudgeWithDualTimeouts(\n  invoke: () => Promise<string>,\n  fastTimeoutMs: number,\n  slowTimeoutMs: number,\n): Promise<{ text: string; fastTimedOut: boolean }> {\n  const normalizedSlowTimeoutMs = Math.max(fastTimeoutMs, slowTimeoutMs);\n  const operation = invoke();\n  let fastTimer: ReturnType<typeof setTimeout> | undefined;\n\n  const fastResult = await (async (): Promise<\n    | { kind: 'response'; text: string }\n    | { kind: 'fast_timeout' }\n  > => {\n    try {\n      return await Promise.race<\n        | { kind: 'response'; text: string }\n        | { kind: 'fast_timeout' }\n      >([\n        operation.then((text) => ({ kind: 'response', text })),\n        new Promise<{ kind: 'fast_timeout' }>((resolveTimeout) => {\n          fastTimer = setTimeout(() => resolveTimeout({ kind: 'fast_timeout' }), fastTimeoutMs);\n        }),\n      ]);\n    } finally {\n      if (fastTimer !== undefined) {\n        clearTimeout(fastTimer);\n      }\n    }\n  })();\n\n  if (fastResult.kind === 'response') {\n    return { text: fastResult.text, fastTimedOut: false };\n  }\n\n  let slowTimer: ReturnType<typeof setTimeout> | undefined;\n  const remainingTimeoutMs = Math.max(0, normalizedSlowTimeoutMs - fastTimeoutMs);\n  try {\n    const text = await Promise.race([\n      operation,\n      new Promise<never>((_, reject) => {\n        slowTimer = setTimeout(() => {\n          reject(new JudgeTimeoutError(`judge slow timeout after ${normalizedSlowTimeoutMs}ms`));\n        }, remainingTimeoutMs);\n      }),\n    ]);\n    return { text, fastTimedOut: true };\n  } catch (error: unknown) {\n    operation.catch(() => undefined);\n    throw error;\n  } finally {\n    if (slowTimer !== undefined) {\n      clearTimeout(slowTimer);\n    }\n  }\n}\n\nfunction clampByteOffset(value: number, contentLength: number): number {\n  if (!Number.isFinite(value)) {\n    return 0;\n  }\n  return Math.max(0, Math.min(Math.floor(value), contentLength));\n}\n\nfunction isObjectRecord(value: unknown): value is Record<string, unknown> {\n  return value !== null && !Array.isArray(value) && typeof value === 'object';\n}\n\nfunction isStringArray(value: unknown): value is string[] {\n  return Array.isArray(value) && value.every((entry) => typeof entry === 'string');\n}\n\nfunction isNonEmptyStringArray(value: unknown): value is string[] {\n  return isStringArray(value) && value.length > 0;\n}\n\nfunction isVerificationLanguage(value: string): value is VerificationLanguage {\n  return SUPPORTED_VERIFICATION_LANGUAGES.has(value as VerificationLanguage);\n}\n\nfunction normalizeFenceLanguage(language: string): VerificationLanguage | null {\n  const normalized = language.trim().toLowerCase();\n  if (normalized === 'py' || normalized === 'python') return 'python';\n  if (normalized === 'ts' || normalized === 'tsx' || normalized === 'typescript') return 'typescript';\n  if (normalized === 'js' || normalized === 'mjs' || normalized === 'javascript') return 'javascript';\n  if (normalized === 'rs' || normalized === 'rust') return 'rust';\n  if (normalized === 'go' || normalized === 'golang') return 'go';\n  return null;\n}\n\nfunction extractCodeBlocks(\n  content: string,\n  allowedLanguages: VerificationLanguage[],\n): Array<{ language: VerificationLanguage; code: string }> {\n  const blocks: Array<{ language: VerificationLanguage; code: string }> = [];\n  const fencePattern = /```([a-zA-Z0-9_-]+)\\n([\\s\\S]*?)```/g;\n  let match: RegExpExecArray | null;\n\n  while ((match = fencePattern.exec(content)) !== null) {\n    const language = normalizeFenceLanguage(match[1] ?? '');\n    if (language && (allowedLanguages.length === 0 || allowedLanguages.includes(language))) {\n      blocks.push({ language, code: match[2] ?? '' });\n    }\n  }\n\n  return blocks;\n}\n\nfunction bracesBalanced(code: string): boolean {\n  let balance = 0;\n  for (const char of code) {\n    if (char === '{') balance += 1;\n    if (char === '}') balance -= 1;\n    if (balance < 0) return false;\n  }\n  return balance === 0;\n}\n\nfunction hasPlaceholderOrTruncation(code: string): boolean {\n  return /TODO|NotImplementedError|pass\\s+#\\s*placeholder|\\[\\.\\.\\. truncated|\\.\\.\\. rest of|\\.\\.\\. more/i.test(code);","lineStart":1,"lineEnd":500,"totalLines":1840,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts","time":{"start":1788632194189,"end":1788632194198}},"id":"prt_072c95c8c001EiGjnMnCk1X1ck","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c92c55001q0ZR6BB3CJI6WK"}}
