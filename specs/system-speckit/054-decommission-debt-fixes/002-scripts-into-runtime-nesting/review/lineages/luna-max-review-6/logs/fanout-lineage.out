:   }\n279:   return candidates;\n280: }\n281: \n282: /**\n283:  * True when any of the six COMPLETION_DOCS in this spec folder carries a\n284:  * completion claim. Exported so the continuity writer (generate-context.ts,\n285:  * via memory-metadata.ts) can decide whether a freshly saved packet needs the\n286:  * fingerprint stamp this rule's attestation binding expects, without\n287:  * duplicating the claim-detection logic above.\n288:  */\n289: export function hasAnyCompletionClaim(specFolderPath: string): boolean {\n290:   return collectCompletionCandidates(specFolderPath).some((candidate) => candidate.hasCompletionClaim);\n291: }\n292: \n293: function findGitRoot(folderPath: string): string | null {\n294:   try {\n295:     return execFileSync('git', ['-C', folderPath, 'rev-parse', '--show-toplevel'], {\n296:       encoding: 'utf-8',\n297:       stdio: ['ignore', 'pipe', 'ignore'],\n298:     }).trim();\n299:   } catch {\n300:     return null;\n301:   }\n302: }\n303: \n304: function listPacketDirtyPaths(specFolderPath: string): string[] {\n305:   const gitRoot = findGitRoot(specFolderPath);\n306:   if (!gitRoot) {\n307:     return [];\n308:   }\n309: \n310:   const relativeFolder = path.relative(gitRoot, specFolderPath).replace(/\\\\/g, '/');\n311:   try {\n312:     const output = execFileSync('git', ['-C', gitRoot, 'status', '--porcelain', '--', relativeFolder], {\n313:       encoding: 'utf-8',\n314:       stdio: ['ignore', 'pipe', 'ignore'],\n315:     });\n316:     return output\n317:       .split('\\n')\n318:       .map((line) => line.trimEnd())\n319:       .filter(Boolean)\n320:       .map((line) => line.slice(3).trim())\n321:       .filter(Boolean);\n322:   } catch {\n323:     return [];\n324:   }\n325: }\n326: \n327: function evaluateCompletionFreshness(specFolderPath: string): ContinuityFreshnessResult | null {\n328:   const candidates = collectCompletionCandidates(specFolderPath);\n329:   const completionClaims = candidates.filter((candidate) => candidate.hasCompletionClaim);\n330: \n331:   if (completionClaims.length === 0) {\n332:     return buildPass(\n333:       'no_completion_claim',\n334:       'Continuity freshness skipped: no completion claim found',\n335:     );\n336:   }\n337: \n338:   // A claim raised by any of the six COMPLETION_DOCS is verified against\n339:   // implementation-summary.md's own fingerprint (the attestation binding\n340:   // documented above), not the claiming document's -- most claims live in\n341:   // spec.md's metadata table, which never carries a session_dedup block.\n342:   const attestationCandidate = candidates.find((candidate) => candidate.basename === 'implementation-summary.md');\n343:   const attestationFingerprint = attestationCandidate?.fingerprint ?? null;\n344: \n345:   if (!attestationFingerprint || !/^sha256:[a-f0-9]{64}$/.test(attestationFingerprint)) {\n346:     return buildPass(\n347:       'missing_fingerprint',\n348:       'Continuity freshness skipped: completion claim has no stored session_dedup fingerprint',\n349:     );\n350:   }\n351: \n352:   if (attestationFingerprint === ZERO_CONTINUITY_FINGERPRINT) {\n353:     return buildPass(\n354:       'zero_fingerprint',\n355:       'Continuity freshness skipped: completion claim has only the zero fingerprint placeholder',\n356:     );\n357:   }\n358: \n359:   const isContentStale = attestationFingerprint !== attestationCandidate!.recomputedFingerprint;\n360:   const dirtyPaths = listPacketDirtyPaths(specFolderPath);\n361: \n362:   if (isContentStale || dirtyPaths.length > 0) {\n363:     const details = [\n364:       ...(isContentStale\n365:         ? [`${attestationCandidate!.basename}: stored=${attestationFingerprint} recomputed=${attestationCandidate!.recomputedFingerprint}`]\n366:         : []),\n367:       ...dirtyPaths.slice(0, 10).map((dirtyPath) => `dirty=${dirtyPath}`),\n368:       'How to Fix: rerun verification, refresh session_dedup.fingerprint, and ensure packet paths are clean.',\n369:       'fix: rerun the completion workflow after updating the packet continuity fingerprint.',\n370:     ];\n371:     const code = isContentStale ? 'content_stale' : 'dirty_tree';\n372:     const message = isContentStale\n373:       ? 'Completion freshness is stale: stored continuity fingerprint does not match current content'\n374:       : 'Completion freshness is stale: packet paths have uncommitted changes';\n375: \n376:     return isEnforceMode()\n377:       ? buildFail(code, message, details)\n378:       : buildWarn(code, message, details);\n379:   }\n380: \n381:   return buildPass(\n382:     'fresh_completion',\n383:     'Completion freshness passed: completion claim fingerprint matches current content and packet paths are clean',\n384:     [`${attestationCandidate!.basename}: recomputed=${attestationCandidate!.recomputedFingerprint}`],\n385:   );\n386: }\n387: \n388: /** Compare a spec folder's continuity timestamp against its graph-metadata save time and report freshness. */\n389: export function validateContinuityFreshness(\n\n(Showing lines 240-389 of 608. Use offset=390 to continue.)\n</content>","metadata":{"preview":"  message: string,\n  details: string[] = [],\n): ContinuityFreshnessResult {\n  return {\n    rule: 'CONTINUITY_FRESHNESS',\n    status: 'fail',\n    code,\n    message,\n    details,\n  };\n}\n\nfunction isCompletionStatus(status: string | null): boolean {\n  return /\\b(?:complete|completed|done|shipped|implemented)\\b/i.test(status ?? '');\n}\n\nfunction hasCompletionClaim(basename: string, content: string, fields: ContinuityFields): boolean {\n  return fields.completionPct === 100\n    || isCompletionStatus(fields.status);\n}","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/validation/continuity-freshness.ts","text":"  message: string,\n  details: string[] = [],\n): ContinuityFreshnessResult {\n  return {\n    rule: 'CONTINUITY_FRESHNESS',\n    status: 'fail',\n    code,\n    message,\n    details,\n  };\n}\n\nfunction isCompletionStatus(status: string | null): boolean {\n  return /\\b(?:complete|completed|done|shipped|implemented)\\b/i.test(status ?? '');\n}\n\nfunction hasCompletionClaim(basename: string, content: string, fields: ContinuityFields): boolean {\n  return fields.completionPct === 100\n    || isCompletionStatus(fields.status);\n}\n\nfunction collectCompletionCandidates(specFolderPath: string): CompletionCandidate[] {\n  const candidates: CompletionCandidate[] = [];\n  for (const basename of COMPLETION_DOCS) {\n    const filePath = path.join(specFolderPath, basename);\n    if (!fs.existsSync(filePath)) {\n      continue;\n    }\n    const content = fs.readFileSync(filePath, 'utf-8');\n    const fields = readContinuityFields(content);\n    candidates.push({\n      basename,\n      filePath,\n      content,\n      fingerprint: fields.fingerprint,\n      hasCompletionClaim: hasCompletionClaim(basename, content, fields),\n      recomputedFingerprint: buildContinuityFingerprint(content),\n    });\n  }\n  return candidates;\n}\n\n/**\n * True when any of the six COMPLETION_DOCS in this spec folder carries a\n * completion claim. Exported so the continuity writer (generate-context.ts,\n * via memory-metadata.ts) can decide whether a freshly saved packet needs the\n * fingerprint stamp this rule's attestation binding expects, without\n * duplicating the claim-detection logic above.\n */\nexport function hasAnyCompletionClaim(specFolderPath: string): boolean {\n  return collectCompletionCandidates(specFolderPath).some((candidate) => candidate.hasCompletionClaim);\n}\n\nfunction findGitRoot(folderPath: string): string | null {\n  try {\n    return execFileSync('git', ['-C', folderPath, 'rev-parse', '--show-toplevel'], {\n      encoding: 'utf-8',\n      stdio: ['ignore', 'pipe', 'ignore'],\n    }).trim();\n  } catch {\n    return null;\n  }\n}\n\nfunction listPacketDirtyPaths(specFolderPath: string): string[] {\n  const gitRoot = findGitRoot(specFolderPath);\n  if (!gitRoot) {\n    return [];\n  }\n\n  const relativeFolder = path.relative(gitRoot, specFolderPath).replace(/\\\\/g, '/');\n  try {\n    const output = execFileSync('git', ['-C', gitRoot, 'status', '--porcelain', '--', relativeFolder], {\n      encoding: 'utf-8',\n      stdio: ['ignore', 'pipe', 'ignore'],\n    });\n    return output\n      .split('\\n')\n      .map((line) => line.trimEnd())\n      .filter(Boolean)\n      .map((line) => line.slice(3).trim())\n      .filter(Boolean);\n  } catch {\n    return [];\n  }\n}\n\nfunction evaluateCompletionFreshness(specFolderPath: string): ContinuityFreshnessResult | null {\n  const candidates = collectCompletionCandidates(specFolderPath);\n  const completionClaims = candidates.filter((candidate) => candidate.hasCompletionClaim);\n\n  if (completionClaims.length === 0) {\n    return buildPass(\n      'no_completion_claim',\n      'Continuity freshness skipped: no completion claim found',\n    );\n  }\n\n  // A claim raised by any of the six COMPLETION_DOCS is verified against\n  // implementation-summary.md's own fingerprint (the attestation binding\n  // documented above), not the claiming document's -- most claims live in\n  // spec.md's metadata table, which never carries a session_dedup block.\n  const attestationCandidate = candidates.find((candidate) => candidate.basename === 'implementation-summary.md');\n  const attestationFingerprint = attestationCandidate?.fingerprint ?? null;\n\n  if (!attestationFingerprint || !/^sha256:[a-f0-9]{64}$/.test(attestationFingerprint)) {\n    return buildPass(\n      'missing_fingerprint',\n      'Continuity freshness skipped: completion claim has no stored session_dedup fingerprint',\n    );\n  }\n\n  if (attestationFingerprint === ZERO_CONTINUITY_FINGERPRINT) {\n    return buildPass(\n      'zero_fingerprint',\n      'Continuity freshness skipped: completion claim has only the zero fingerprint placeholder',\n    );\n  }\n\n  const isContentStale = attestationFingerprint !== attestationCandidate!.recomputedFingerprint;\n  const dirtyPaths = listPacketDirtyPaths(specFolderPath);\n\n  if (isContentStale || dirtyPaths.length > 0) {\n    const details = [\n      ...(isContentStale\n        ? [`${attestationCandidate!.basename}: stored=${attestationFingerprint} recomputed=${attestationCandidate!.recomputedFingerprint}`]\n        : []),\n      ...dirtyPaths.slice(0, 10).map((dirtyPath) => `dirty=${dirtyPath}`),\n      'How to Fix: rerun verification, refresh session_dedup.fingerprint, and ensure packet paths are clean.',\n      'fix: rerun the completion workflow after updating the packet continuity fingerprint.',\n    ];\n    const code = isContentStale ? 'content_stale' : 'dirty_tree';\n    const message = isContentStale\n      ? 'Completion freshness is stale: stored continuity fingerprint does not match current content'\n      : 'Completion freshness is stale: packet paths have uncommitted changes';\n\n    return isEnforceMode()\n      ? buildFail(code, message, details)\n      : buildWarn(code, message, details);\n  }\n\n  return buildPass(\n    'fresh_completion',\n    'Completion freshness passed: completion claim fingerprint matches current content and packet paths are clean',\n    [`${attestationCandidate!.basename}: recomputed=${attestationCandidate!.recomputedFingerprint}`],\n  );\n}\n\n/** Compare a spec folder's continuity timestamp against its graph-metadata save time and report freshness. */\nexport function validateContinuityFreshness(","lineStart":240,"lineEnd":389,"totalLines":608,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/cli/validation/continuity-freshness.ts","time":{"start":1788632422662,"end":1788632422666}},"id":"prt_072ccd9040014s1vZpwbBFerYL","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072ccbd7b001ahxuuPssIRJaQo"}}
{"type":"tool_use","timestamp":1788632422743,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_NMNpYdJQL6MxFrj91Bcno3cY","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/memory-metadata.ts","offset":380,"limit":90},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/memory-metadata.ts</path>\n<type>file</type>\n<content>\n380:       learning: context.learning,\n381:     })),\n382:     anchors: extractAnchorIds(content),\n383:   };\n384: }\n385: \n386: /** Also used by frontmatter-editor; exported for reuse. */\n387: export function extractAnchorIds(content: string): string[] {\n388:   // HTML ids are intentionally ignored; comment anchors are the structural source of truth.\n389:   const matches = content.matchAll(/<!--\\s*(?:\\/)?ANCHOR:\\s*([a-zA-Z0-9][a-zA-Z0-9-]*)\\s*-->/g);\n390:   return Array.from(new Set(Array.from(matches, (match) => match[1])));\n391: }\n392: \n393: // Mirrors the fingerprint-field pattern normalizeForContinuityFingerprint\n394: // (runtime/lib/validation/spec-doc-structure.ts) hashes past, so a value\n395: // stamped here reads back identical through CONTINUITY_FRESHNESS's own\n396: // recomputation. Duplicated rather than imported: that module lives outside\n397: // this package's runtime-API boundary.\n398: const SESSION_DEDUP_FINGERPRINT_LINE_RE = /^(\\s{6}fingerprint:\\s*)(?:[\"'])?sha256:[a-f0-9]{64}(?:[\"'])?(\\s*(?:#.*)?)$/m;\n399: \n400: /**\n401:  * Stamp implementation-summary.md's `_memory.continuity.session_dedup.fingerprint`\n402:  * with a real, content-derived value whenever the spec folder carries a\n403:  * completion claim in any of the six COMPLETION_DOCS (continuity-freshness.ts's\n404:  * attestation binding: implementation-summary.md is the sole document that\n405:  * fingerprint is ever verified against). Intended as a post-save step so a\n406:  * freshly saved completed packet does not default into CONTINUITY_FRESHNESS's\n407:  * `missing_fingerprint`/`zero_fingerprint` skip codes. A no-op when the\n408:  * document has no session_dedup.fingerprint field to stamp, or when the\n409:  * stored value already matches the recomputed one.\n410:  */\n411: export function stampCompletionFingerprintIfNeeded(specFolderPath: string): void {\n412:   const summaryPath = path.join(specFolderPath, 'implementation-summary.md');\n413:   if (!fsSync.existsSync(summaryPath)) {\n414:     return;\n415:   }\n416:   if (!hasAnyCompletionClaim(specFolderPath)) {\n417:     return;\n418:   }\n419: \n420:   const content = fsSync.readFileSync(summaryPath, 'utf-8');\n421:   if (!SESSION_DEDUP_FINGERPRINT_LINE_RE.test(content)) {\n422:     return;\n423:   }\n424: \n425:   // The fingerprint field itself is normalized to the zero placeholder before\n426:   // hashing, so recomputing against the pre-stamp content already yields the\n427:   // value the field should hold -- no separate re-read after writing is needed.\n428:   const recomputed = buildContinuityFingerprint(content);\n429:   if (recomputed === ZERO_CONTINUITY_FINGERPRINT) {\n430:     return;\n431:   }\n432: \n433:   const stamped = content.replace(SESSION_DEDUP_FINGERPRINT_LINE_RE, `$1\"${recomputed}\"$2`);\n434:   if (stamped === content) {\n435:     return;\n436:   }\n437:   fsSync.writeFileSync(summaryPath, stamped, 'utf-8');\n438: }\n\n(End of file - total 438 lines)\n</content>","metadata":{"preview":"      learning: context.learning,\n    })),\n    anchors: extractAnchorIds(content),\n  };\n}\n\n/** Also used by frontmatter-editor; exported for reuse. */\nexport function extractAnchorIds(content: string): string[] {\n  // HTML ids are intentionally ignored; comment anchors are the structural source of truth.\n  const matches = content.matchAll(/<!--\\s*(?:\\/)?ANCHOR:\\s*([a-zA-Z0-9][a-zA-Z0-9-]*)\\s*-->/g);\n  return Array.from(new Set(Array.from(matches, (match) => match[1])));\n}\n\n// Mirrors the fingerprint-field pattern normalizeForContinuityFingerprint\n// (runtime/lib/validation/spec-doc-structure.ts) hashes past, so a value\n// stamped here reads back identical through CONTINUITY_FRESHNESS's own\n// recomputation. Duplicated rather than imported: that module lives outside\n// this package's runtime-API boundary.\nconst SESSION_DEDUP_FINGERPRINT_LINE_RE = /^(\\s{6}fingerprint:\\s*)(?:[\"'])?sha256:[a-f0-9]{64}(?:[\"'])?(\\s*(?:#.*)?)$/m;\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/cli/core/memory-metadata.ts","text":"      learning: context.learning,\n    })),\n    anchors: extractAnchorIds(content),\n  };\n}\n\n/** Also used by frontmatter-editor; exported for reuse. */\nexport function extractAnchorIds(content: string): string[] {\n  // HTML ids are intentionally ignored; comment anchors are the structural source of truth.\n  const matches = content.matchAll(/<!--\\s*(?:\\/)?ANCHOR:\\s*([a-zA-Z0-9][a-zA-Z0-9-]*)\\s*-->/g);\n  return Array.from(new Set(Array.from(matches, (match) => match[1])));\n}\n\n// Mirrors the fingerprint-field pattern normalizeForContinuityFingerprint\n// (runtime/lib/validation/spec-doc-structure.ts) hashes past, so a value\n// stamped here reads back identical through CONTINUITY_FRESHNESS's own\n// recomputation. Duplicated rather than imported: that module lives outside\n// this package's runtime-API boundary.\nconst SESSION_DEDUP_FINGERPRINT_LINE_RE = /^(\\s{6}fingerprint:\\s*)(?:[\"'])?sha256:[a-f0-9]{64}(?:[\"'])?(\\s*(?:#.*)?)$/m;\n\n/**\n * Stamp implementation-summary.md's `_memory.continuity.session_dedup.fingerprint`\n * with a real, content-derived value whenever the spec folder carries a\n * completion claim in any of the six COMPLETION_DOCS (continuity-freshness.ts's\n * attestation binding: implementation-summary.md is the sole document that\n * fingerprint is ever verified against). Intended as a post-save step so a\n * freshly saved completed packet does not default into CONTINUITY_FRESHNESS's\n * `missing_fingerprint`/`zero_fingerprint` skip codes. A no-op when the\n * document has no session_dedup.fingerprint field to stamp, or when the\n * stored value already matches the recomputed one.\n */\nexport function stampCompletionFingerprintIfNeeded(specFolderPath: string): void {\n  const summaryPath = path.join(specFolderPath, 'implementation-summary.md');\n  if (!fsSync.existsSync(summaryPath)) {\n    return;\n  }\n  if (!hasAnyCompletionClaim(specFolderPath)) {\n    return;\n  }\n\n  const content = fsSync.readFileSync(summaryPath, 'utf-8');\n  if (!SESSION_DEDUP_FINGERPRINT_LINE_RE.test(content)) {\n    return;\n  }\n\n  // The fingerprint field itself is normalized to the zero placeholder before\n  // hashing, so recomputing against the pre-stamp content already yields the\n  // value the field should hold -- no separate re-read after writing is needed.\n  const recomputed = buildContinuityFingerprint(content);\n  if (recomputed === ZERO_CONTINUITY_FINGERPRINT) {\n    return;\n  }\n\n  const stamped = content.replace(SESSION_DEDUP_FINGERPRINT_LINE_RE, `$1\"${recomputed}\"$2`);\n  if (stamped === content) {\n    return;\n  }\n  fsSync.writeFileSync(summaryPath, stamped, 'utf-8');\n}","lineStart":380,"lineEnd":438,"totalLines":438,"truncated":false}},"title":".opencode/skills/system-spec-kit/runtime/cli/core/memory-metadata.ts","time":{"start":1788632422738,"end":1788632422742}},"id":"prt_072ccd939001687J9g19s2DD52","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072ccbd7b001ahxuuPssIRJaQo"}}
