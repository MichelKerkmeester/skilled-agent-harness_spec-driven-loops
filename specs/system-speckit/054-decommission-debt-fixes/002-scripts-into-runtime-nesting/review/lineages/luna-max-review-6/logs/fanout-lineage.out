text.ts`, `scripts/retrieval/`)\",\n212:     \"created_at\": \"2026-09-05T06:13:04Z\",\n213:     \"last_save_at\": \"2026-09-05T16:38:40.190Z\",\n214:     \"save_lineage\": \"graph_only\",\n215:     \"last_accessed_at\": null,\n216:     \"source_docs\": [\n217:       \"spec.md\",\n218:       \"plan.md\",\n219:       \"tasks.md\",\n220:       \"acceptance-criteria.md\",\n221:       \"implementation-summary.md\"\n222:     ],\n223:     \"source_fingerprint\": \"sha256:e7be0b5994c8f229cd5e1c5b61fd861a58f99a891ad33f34809388ddd2b1675d\",\n224:     \"source_fingerprint_docset\": 3,\n225:     \"source_doc_hashes\": {\n226:       \"spec.md\": \"1d9269bdb8ae4be75a9ba7da02d2d9755db64755e6d057ebd7b37e760cc9968e\",\n227:       \"plan.md\": \"aa9e48f1cef7f720cafab62b6303b06e2509c6ed227c19410bd8231fc734f0a4\",\n228:       \"tasks.md\": \"20277610b50b3da92b645bcaa77f4fe7e419dbaa9dc948a191e32e5bf0f4d36b\",\n229:       \"implementation-summary.md\": \"884c0ba391f049d1479fab5e73c3181935848b0fdb3c31edf3dcd1233fc40d6f\"\n230:     },\n231:     \"last_active_child_id\": null,\n232:     \"last_active_at\": null\n233:   }\n234: }\n\n(End of file - total 234 lines)\n</content>","metadata":{"preview":"      {\n        \"name\": \"workflow.ts\",\n        \"kind\": \"code\",\n        \"path\": \"core/workflow.ts\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Feature Specification\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Parent Spec\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Handoff Criteria\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/graph-metadata.json","text":"      {\n        \"name\": \"workflow.ts\",\n        \"kind\": \"code\",\n        \"path\": \"core/workflow.ts\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Feature Specification\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Parent Spec\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Handoff Criteria\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      },\n      {\n        \"name\": \"Phase Context This\",\n        \"kind\": \"proper_noun\",\n        \"path\": \"spec.md\",\n        \"source\": \"derived\"\n      }\n    ],\n    \"causal_summary\": \"When this phase opened, `.opencode/skills/system-spec-kit/` ran two npm workspace packages side by side: `runtime/` (the `@spec-kit/runtime` engine - validation, metadata, hooks) and `scripts/` (then `@spec-kit/scripts`, now `runtime/cli/` as `@spec-kit/cli`; the CLI workspace over it - `scripts/spec/validate.sh`, `scripts/memory/generate-context.ts`, `scripts/retrieval/`)\",\n    \"created_at\": \"2026-09-05T06:13:04Z\",\n    \"last_save_at\": \"2026-09-05T16:38:40.190Z\",\n    \"save_lineage\": \"graph_only\",\n    \"last_accessed_at\": null,\n    \"source_docs\": [\n      \"spec.md\",\n      \"plan.md\",\n      \"tasks.md\",\n      \"acceptance-criteria.md\",\n      \"implementation-summary.md\"\n    ],\n    \"source_fingerprint\": \"sha256:e7be0b5994c8f229cd5e1c5b61fd861a58f99a891ad33f34809388ddd2b1675d\",\n    \"source_fingerprint_docset\": 3,\n    \"source_doc_hashes\": {\n      \"spec.md\": \"1d9269bdb8ae4be75a9ba7da02d2d9755db64755e6d057ebd7b37e760cc9968e\",\n      \"plan.md\": \"aa9e48f1cef7f720cafab62b6303b06e2509c6ed227c19410bd8231fc734f0a4\",\n      \"tasks.md\": \"20277610b50b3da92b645bcaa77f4fe7e419dbaa9dc948a191e32e5bf0f4d36b\",\n      \"implementation-summary.md\": \"884c0ba391f049d1479fab5e73c3181935848b0fdb3c31edf3dcd1233fc40d6f\"\n    },\n    \"last_active_child_id\": null,\n    \"last_active_at\": null\n  }\n}","lineStart":180,"lineEnd":234,"totalLines":234,"truncated":false}},"title":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/graph-metadata.json","time":{"start":1788632067549,"end":1788632067594}},"id":"prt_072c76ddb001URYlA042uH42SU","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c73059001wc3JHFtgXcDaup"}}
{"type":"tool_use","timestamp":1788632067605,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_JHyJJl0wn53QYDAf5pSXldTI","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/inventory.md","offset":1,"limit":450},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/inventory.md</path>\n<type>file</type>\n<content>\n1: # Reference inventory and target-layout resolution\n2: \n3: Taken read-only on `skilled/v4.0.0.0` in the main checkout, before any lane other\n4: than this one touches `scripts/`. `git grep` is the authority, not `rg` alone —\n5: packet 053 found a `.gitignore` rule that hides `package.json`/`package-lock.json`\n6: from `rg`; this repo's current `.gitignore` no longer carries that exact rule, but\n7: `git grep` was used throughout anyway so the result does not depend on that being\n8: true today.\n9: \n10: Excluded as historical evidence, matching packet 053's own exclusion class: `specs/**`,\n11: any directory literally named `changelog` or `benchmark` at any depth (both the\n12: repo has none at the root, but `.opencode/skills/system-spec-kit/changelog/` and two\n13: skills' `benchmark/reports/` trees exist and are the same kind of frozen record),\n14: `node_modules/**`, generated `dist/**`, `z_archive/**`, and two gitignored,\n15: out-of-tree copies (`barter/ai-speckit/...` — a vendored subproject — and\n16: `.worktrees/022-012-runtime-enablement-build/...` — a different branch's checkout).\n17: \n18: ## 0. Target-layout decision (REQ-002)\n19: \n20: **Chosen: `runtime/cli/`** (spec.md's option (a)), confirmed by direct inspection:\n21: `runtime/scripts/` already holds `finalize-dist.mjs`, `run-tests.mjs`,\n22: `run-tests-sharded.mjs` and a `tests/` folder — real build-tooling content, not an\n23: empty placeholder — so a literal `git mv scripts runtime/scripts` collides on day\n24: one. `runtime/cli/` does not exist yet (confirmed: `ls` returns \"No such file or\n25: directory\"), so the incoming CLI workspace lands on a clean name. The rejected\n26: alternative (folding `runtime/scripts/`'s three files into the incoming tree first)\n27: would require touching every reference to those three build-tooling files instead\n28: of the handful this decision touches (see §7); this phase's plan.md already reached\n29: the same conclusion and this inventory found nothing that overturns it.\n30: \n31: **The collision is bounded, not eliminated by re-partitioning**: two directories will\n32: both be named `scripts` after the move — `runtime/scripts/` (build tooling, unmoved)\n33: and `runtime/cli/` (unaffected, it's the CLI workspace's new name). No name collision\n34: survives. The one thing that DOES still require care is `evals/check-architecture-boundaries.ts`,\n35: which references both `runtime/scripts` (the build-tooling dir, stays) and the outer\n36: `scripts` (the CLI workspace, moves) in the same file four lines apart — see §7.1.\n37: \n38: ## 1. Counts\n39: \n40: | Group | Count | How it was taken |\n41: |-------|------:|-------------------|\n42: | Files (outside `specs/`, `changelog/`, `benchmark/`, `node_modules`, `dist`, `z_archive`) naming `system-spec-kit/scripts` or `scripts/dist` | 447 | `git grep -l -F \"system-spec-kit/scripts\"` ∪ `git grep -l -F \"scripts/dist\"`, filtered |\n43: | — of those, inside the `scripts/` tree itself (move wholesale via `git mv`, but internal content still needs text edits) | 157 | self-references |\n44: | — of those, outside the `scripts/` tree (need a real text edit at their current location) | 290 | see §4 |\n45: | Approx. total matching lines across the 447 files (both patterns; a line matching both is counted twice) | ~1,800 | summed per-file `git grep -c` |\n46: | `specs/**` files naming the same strings (historical corpus, excluded from the count above, not edited) | 5,040 (`system-spec-kit/scripts`) + 944 (`scripts/dist`), overlapping | `git grep -l` scoped to `specs/*` |\n47: | Skill-level `changelog/`/`benchmark/` files naming the same strings (historical, excluded) | 29 + 7 | `grep -c '/changelog/'` / `/benchmark/'` over the raw hit list |\n48: | Symlinks whose target resolves into `system-spec-kit/scripts` | 0 in-tree; 2 in gitignored, out-of-scope copies | `find . -type l -lname '*system-spec-kit/scripts*'` |\n49: | Tracked symlink inside the package's own tree | 1 | `scripts/runtime -> ../runtime/dist` |\n50: \n51: ### Outside-the-tree files by area (290, non-self-reference)\n52: \n53: | Area | Files | Notes |\n54: |------|------:|-------|\n55: | `.opencode/skills/system-spec-kit` (non-`scripts/`: `manual-testing-playbook`, `references`, `feature-catalog`, `runtime`, `changelog`*, `templates`, `assets`, root docs) | 130 | *changelog subset (20) is historical, not counted as live below |\n56: | `.opencode/skills/system-deep-loop` | 48 | deep-review/deep-research/deep-ai-council SKILL docs quoting the trigger-index or validate.sh commands; 3 under `runtime/`, 1 `shared/`, 1 `benchmark/`* |\n57: | `.opencode/skills/sk-code` | 23 | 3 under `benchmark/reports/`* (historical), rest are manual-testing-playbook + reference docs |\n58: | `.opencode/skills/cli-external-orchestration` | 20 | 2 under `benchmark/reports/`* (historical); rest are per-CLI `SKILL.md` + prompt-template assets |\n59: | `.opencode/commands` | 41 | `create` (15), `speckit` (8), `deep` (8), `doctor` (7, see §5), `memory` (3) |\n60: | `.opencode/skills/sk-doc` | 10 | includes 2 test-fixture manifests that enumerate real paths (§3) |\n61: | `.claude`, `.codex`, `.pi` (agent mirrors + SYNC.md) | 8 each | generated by `sync-runtime-mirrors.cjs`; see §2 |\n62: | `.github/workflows` | 4 | all live CI steps, see §5 |\n63: | `.opencode/plugins` | 3 | live PostToolUse/session plugins, see §3 |\n64: | `.opencode/bin` | 3 | `README.md`, `speckit-completion.cjs` (relative `require`), `worktree-session.sh` |\n65: | `.opencode/agents` | 7 | canonical agent sources `sync-runtime-mirrors.cjs` reads |\n66: | `.opencode/hooks` | 2 | `dist-freshness/README.md`, `post-edit-quality/lib/post-edit-router.cjs` (relative config-string) |\n67: | `.opencode/install-guides` | 1 | `README.md`, 6 lines |\n68: | `.cursor`, `.devin` (`SYNC.md` only) | 1 each | |\n69: | `.opencode/skills/sk-git` | 2 | docs only |\n70: | `.opencode/skills/system-skill-advisor` | 1 | doc only |\n71: | `.opencode/skills/.state` | 1 | `smart-router-telemetry/README.md`, 5 lines |\n72: | repo root (`CLAUDE.md`, `AGENTS.md`, `README.md`, `CONTRIBUTING.md`, `.gitignore`) | 5 | see §6 |\n73: \n74: ## 2. Runtime-mirror generation chain (grep-invisible unless traced)\n75: \n76: `.claude/agents/*.md`, `.codex/agents/*.toml`, `.pi/agents/*.md` are **not** hand-edited\n77: copies — `ls -la` shows them as regular files, and `.claude/SYNC.md:62,103,125` names the\n78: generator: `.opencode/skills/system-spec-kit/scripts/runtime-mirrors/sync-runtime-mirrors.cjs`,\n79: which reads the canonical `.opencode/agents/*.md` sources and writes the five mirrors\n80: (`.claude`, `.codex`, `.cursor`, `.devin`, `.pi`). Confirmed by direct grep:\n81: `.opencode/agents/ai-council.md:748` carries the same\n82: `node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js` line\n83: that shows up verbatim in `.claude/agents/ai-council.md:734` and\n84: `.codex/agents/ai-council.toml:738`.\n85: \n86: **Consequence for the execution phase**: editing the seven canonical `.opencode/agents/*.md`\n87: files is necessary but not sufficient — the mirrors must be regenerated in the same\n88: commit (`node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs`,\n89: post-move) and verified with its own `--check` flag (per `.claude/SYNC.md:103`), or the\n90: five per-runtime copies keep the stale path even though the canonical source is fixed.\n91: Separately, `.claude/hooks/`, `.codex/hooks/`, `.cursor/hooks/`, `.devin/hooks/`,\n92: `.pi/extensions/` are real symlink trees, but none of their 13 symlinks target\n93: `system-spec-kit/scripts/**` (they resolve into `sk-git/scripts/`, `sk-code/sk-code-quality/scripts/`,\n94: or `.opencode/scripts/session-cleanup.sh` — confirmed by `readlink` on all 13). No hook\n95: symlink needs repointing.\n96: \n97: ## 3. References a path/name grep does not reach\n98: \n99: These carry the workspace's location without spelling the searched strings as one\n100: contiguous token, and each one breaks silently on the move if handled by text\n101: substitution alone.\n102: \n103: | File | Line | Shape | Why the grep misses it |\n104: |------|-----:|-------|--------------------------|\n105: | `.opencode/bin/skill-advisor.cjs` | 24 | `require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'scripts', 'lib', 'dist-freshness.cjs'))` | each path segment is a separate string argument to `path.join`, not one literal |\n106: | `.opencode/skills/system-spec-kit/shared/embeddings/factory.ts` | 248 | `resolveSpecKitPackageRoot()` walks up directories checking `existsSync(path.join(currentDir,'runtime','database')) && existsSync(path.join(currentDir,'scripts')) && existsSync(path.join(currentDir,'shared'))` as its root-detection landmark | bare `'scripts'` segment used as a directory-existence marker, not a joined string; also sits in `shared/`, which the architecture rule says must stay neutral of `runtime`/`scripts` internals — this landmark check already couples it, and the coupling gets worse (the check would need `runtime/cli` instead of a plain sibling name) |\n107: | `.opencode/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts` | 966 | `workspaceRoots = [systemSpecKitRoot, path.join(systemSpecKitRoot,'runtime'), path.join(systemSpecKitRoot,'scripts')]`, used to resolve bare relative `key_files` paths against every workspace root | segmented `path.join`, and the array is built, not matched as a string |\n108: | `.opencode/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts` | 74, 75, 76, 77, 229 | five separate `path.join(SKILL_ROOT, 'scripts', …)` calls building `VALIDATOR_REGISTRY_PATH`, `VALIDATOR_RULES_ROOT`, `VALIDATOR_DIST_VALIDATION_ROOT`, `VALIDATE_SCRIPT_DIR`, and a dynamic validator-script resolve — this is `validate.sh`'s own rule-loading core | segmented `path.join`; this is the single highest-risk file in this class since every `validate.sh` run depends on it |\n109: | `.opencode/skills/system-spec-kit/runtime/tests/env-reference-drift.vitest.ts` | 125 | `resolve(SYSTEM_SPEC_KIT_ROOT, 'scripts')`, then recursively walks it for env-flag token drift | segmented `resolve` |\n110: | `.opencode/skills/system-spec-kit/runtime/tests/validation-orchestrator-bridge.vitest.ts` | 100 | `path.join(SKILL_ROOT, 'scripts', 'dist', 'validation', 'continuity-freshness.js')` | segmented `path.join` |\n111: | `.opencode/skills/system-spec-kit/scripts/evals/check-architecture-boundaries.ts` | 53, 154, 163 | `REQUIRED_ROOT_DIRS = ['shared','runtime','scripts']`; `isProhibitedForShared()`'s two `path.join(packageRoot, 'scripts')` boundary checks | bare directory-name literals keying architecture-boundary logic — the exact same file and the exact same shape (`'mcp-server'` literals) packet 053 found at these same line numbers for its own rename |\n112: | `.opencode/skills/system-spec-kit/scripts/evals/check-architecture-boundaries.ts` | 404 | `wrappersDir = path.join(resolvedRoot, 'runtime', 'scripts')` | **do not touch** — this is the *other* `scripts`, the build-tooling dir inside `runtime/` that this move does not rename; it happens to sit four lines from three that must change, in the same file |\n113: | `.opencode/skills/system-spec-kit/scripts/lib/dist-freshness.cjs` | 33 (`id`), 35 (`root`), 41 (`rebuildCommand`) | `DIST_PACKAGES` table entry `{ id: 'system-spec-kit/scripts', root: '.opencode/skills/system-spec-kit/scripts', rebuildCommand: 'cd .../scripts && npm run build' }` | caught by the main sweep as text, listed here because the `id` field (not a filesystem path) has exactly one consumer: `scripts/tests/dist-freshness-walker.vitest.ts:35` looks it up by the literal string `'system-spec-kit/scripts'`. Renaming it to `'system-spec-kit/runtime/cli'` (recommended, to match the `root`/`runtime` sibling entries' convention) needs that one test line updated in the same commit — both files move together so this is low-risk, just easy to miss since it's an identifier, not a path |\n114: | `.opencode/skills/sk-doc/scripts/tests/code-folder/durable-directory-manifest.json` | — | a data manifest enumerating real repository directories a checker compares against the working tree | a JSON data file, not code; if any listed entry names `system-spec-kit/scripts/...` as a durable directory, the checker will report a false drift the day the real directory moves — needs a value update, not import repair |\n115: \n116: ## 4. Relative-import direction flips (`scripts/` ↔ `runtime/`)\n117: \n118: This is the single largest and easiest-to-miss class the task called out by name.\n119: Today `scripts/` and `runtime/` are siblings under `system-spec-kit/`, so code in\n120: `scripts/<subdir>/<file>.ts` reaches `runtime/` by climbing out of `scripts/` and\n121: back down: `'../../runtime/…'` (2 `..` from `scripts/<subdir>` lands on\n122: `system-spec-kit/`, then `runtime/…` descends into it). After the move, `runtime/`\n123: is the **parent** of the relocated `cli/`, so the same 2 `..` from\n124: `runtime/cli/<subdir>` already lands *on* `runtime/` — the trailing `runtime/`\n125: segment must be **dropped**, not have a `..` added:\n126: \n127: ```\n128: OLD (from scripts/tests/x.ts):  '../../runtime/api'      -> up 2 = system-spec-kit, then descend runtime/api\n129: NEW (from runtime/cli/tests/x.ts): '../../api'            -> up 2 already IS runtime, descend api directly\n130: ```\n131: \n132: The dot-count is unchanged; only the literal `runtime/` segment in the middle is\n133: removed. This is **not** covered by the generic \"+1 `..`\" rule in §7, which applies\n134: to the opposite case (an escape that does *not* pass through `runtime`).\n135: \n136: Verified count: **21 files, 36 matching lines** (`git grep -rE \"['\\\"]\\.\\./\\.\\./runtime\"` under\n137: `scripts/`, excluding `dist/`). Two are production source, not tests:\n138: \n139: - `scripts/validation/generated-metadata-drift.ts:14-15`\n140: - `scripts/validation/generated-metadata-integrity.ts:14,18`\n141: - `scripts/evals/check-handler-cycles-ast.ts:24,26,28-29` — a **multi-candidate resolver**\n142:   trying 1-, 2- and 3-level climbs plus a `process.cwd()`-relative fallback to find\n143:   `runtime/handlers` from an AST-visited module at an unknown depth; each candidate\n144:   needs the same drop-the-`runtime`-segment treatment at its own depth, not a uniform\n145:   rule — read the file before editing it.\n146: \n147: The remaining 18 are test files (`scripts/tests/backfill-research-metadata.vitest.ts`,\n148: `continuity-freshness.vitest.ts`, `gate-3-classifier.vitest.ts`,\n149: `generated-metadata-drift.vitest.ts`, `graph-key-file-declarations.vitest.ts`,\n150: `graph-metadata-backfill.vitest.ts`, `graph-metadata-refresh.vitest.ts`,\n151: `import-policy-rules.vitest.ts` — **caution**, its matches are string literals passed\n152: to `isProhibitedImportPath()` under test, i.e. test *data*, not real resolved paths;\n153: confirm whether the boundary rule's meaning should change post-move before editing\n154: its fixtures — `level-contract-resolver.vitest.ts`, `scaffold-golden-snapshots.vitest.ts`,\n155: `scoped-backfill-boundary.vitest.ts`, `test-bug-regressions.js`, `test-export-contracts.js`,\n156: `test-naming-migration.js` — **caution**, most of its ~60 `'runtime/lib/…'` entries are\n157: a descriptive data table of file-and-count pairs for files that live inside `runtime/`\n158: and never move, so they need **no change**; only its one real `path.resolve(__dirname,'../../runtime')`\n159: call at line 31 is a live reference — `validation-engine-coherence.vitest.ts`,\n160: `workflow-canonical-save-metadata.vitest.ts`).\n161: \n162: `tests/architecture-boundary-enforcement.vitest.ts` and\n163: `tests/check-source-dist-alignment-orphans.vitest.ts` also match `'runtime/scripts'` or\n164: `'runtime/lib'` etc. as literals, but on inspection these build **synthetic fixture\n165: trees** (`writeFixtureFile(root, 'runtime/scripts/too-long.ts', …)`) mimicking the\n166: `runtime/scripts` *build-tooling* dir that this move does not touch — confirmed\n167: **unaffected**, listed here so the execution phase does not re-flag them.\n168: \n169: Two identically-shaped test files are confirmed **unaffected** despite matching a\n170: bare `'scripts'` grep: `runtime/tests/dist-freshness.vitest.ts:134` iterates\n171: `['api','configs','core','handlers','hooks','scripts']` to build a fixture for\n172: `runtime/`'s *own* dist-freshness sourceCandidates (its `'scripts'` is `runtime/scripts`,\n173: the build-tooling dir, per the surrounding `packageRoot = …/runtime` line 126); and\n174: `runtime/tests/path-boundary.vitest.ts:86` builds an arbitrary synthetic fixture path\n175: (`createTempRoot('path-boundary-graph-')`) with no relation to the real workspace.\n176: \n177: ## 5. Fixed-depth `__dirname` climbers (the \"+1\" rule)\n178: \n179: Every file under `scripts/` that computes an ancestor directory by counting a fixed\n180: number of `..` segments from `__dirname` needs **one more `..`** after the move,\n181: *unless* the target is inside `runtime/` (§4 applies instead) or inside `scripts/`\n182: itself (moves together, no change). Verified via\n183: `grep -rn \"path\\.resolve(__dirname, '\\(\\.\\./\\)\\{3,\\}\"` (5-level, reaching repo root)\n184: and the 2-level pattern (reaching `system-spec-kit/` root):\n185: \n186: | File | Line | Current | Reaches (today) | Needs |\n187: |------|-----:|---------|------------------|-------|\n188: | `scripts/runtime-mirrors/sync-runtime-mirrors.cjs` | 32 | `'../../../../..'` (5) | repo root | 6 `..` |\n189: | `scripts/optimizer/replay-corpus.cjs` | 58 | `'../../../../..'` (5) | repo root | 6 `..` |\n190: | `scripts/codex/sync-agents.cjs` | 18 | `'../../../../..'` (5) | repo root | 6 `..` |\n191: | `scripts/codex/sync-prompts.cjs` | 19 | `'../../../../..'` (5) | repo root | 6 `..` |\n192: | `scripts/pi/sync-agents-pi.cjs` | 18 | `'../../../../..'` (5) | repo root | 6 `..` |\n193: | `scripts/pi/sync-prompts-pi.cjs` | 19 | `'../../../../..'` (5) | repo root | 6 `..` |\n194: | `scripts/resource-map/extract-from-evidence.cjs` | 11 | `'../../../../..'` (5) | repo root | 6 `..` |\n195: | `scripts/tests/repair-derived.vitest.ts` | 15 | `'../../../../..'` (5) | repo root | 6 `..` |\n196: | `scripts/tests/validate-memory-quality-v8-overreach.vitest.ts` | 195 | `'../../../../..'` (5) | repo root | 6 `..` |\n197: | `scripts/lib/dist-freshness.cjs` | 21 | `'..','..','..','..','..'` (5, chained args) | repo root (`WORKSPACE_ROOT`) | 6 `..` |\n198: | `scripts/tests/test-phase-validation.js` | 14 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n199: | `scripts/tests/completion-state.vitest.ts` | 33 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n200: | `scripts/tests/test-phase-command-workflows.js` | 18 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n201: | `scripts/tests/test-phase-system.js` | 13 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n202: | `scripts/tests/test-folder-detector-functional.js` | 25 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n203: | `scripts/setup/record-node-version.js` | 19 | `'../..'` (2) | `system-spec-kit/` (`rootDir`) | 3 `..` |\n204: | `scripts/tests/workflow-invariance.vitest.ts` | 10 | `'../..'` (2) | `system-spec-kit/` (`SKILL_ROOT`) | 3 `..` |\n205: | `scripts/tests/scaffold-golden-snapshots.vitest.ts` | 13 | `'../..'` (2) | `system-spec-kit/` (`SKILL_ROOT`) | 3 `..`; **note**: same file's line 10 is a §4 case (`'../../runtime/lib/…'`), needing the opposite treatment |\n206: \n207: `scripts/tests/test-utils.js:17` (`path.join(__dirname,'..','..','runtime','database')`)\n208: is a hybrid of both rules: it currently climbs 2 (to `system-spec-kit/`) then descends\n209: `runtime/database` — after the move this becomes `path.join(__dirname,'..','..','database')`\n210: (§4's drop-the-segment rule, same 2 ups, since 2 ups from the new location already IS\n211: `runtime/`).\n212: \n213: `.opencode/skills/system-spec-kit/runtime/hooks/claude/session-stop.ts:73-76`\n214: (`resolveGenerateContextScriptPath()`) is its own special case: a 4-candidate\n215: resolver trying `HOOK_DIR` at both its source depth (`runtime/hooks/claude/`, 3 `..`\n216: today) and its compiled-dist depth (`runtime/dist/hooks/claude/`, 4 `..` today),\n217: plus two `process.cwd()`-relative absolute/bare forms. Every candidate lands on\n218: `runtime`'s own path, one hop before old-`scripts`, so **all four collapse to\n219: climbing to `runtime` and descending directly into `cli/dist/…`** rather than any\n220: uniform `+1`:\n221: `resolve(HOOK_DIR, '../../cli/dist/memory/generate-context.js')` (was 3 `..` + `scripts/…`),\n222: `resolve(HOOK_DIR, '../../../cli/dist/memory/generate-context.js')` (was 4 `..` + `scripts/…`),\n223: `resolve(process.cwd(), '.opencode/skills/system-spec-kit/runtime/cli/dist/memory/generate-context.js')`,\n224: `resolve(process.cwd(), 'runtime/cli/dist/memory/generate-context.js')`.\n225: \n226: ## 6. Workspace, package-manifest and build-config surfaces\n227: \n228: | Surface | Current | Change |\n229: |---------|---------|--------|\n230: | `system-spec-kit/package.json` `workspaces` | `[\"shared\",\"runtime\",\"scripts\"]` | `[\"shared\",\"runtime\",\"runtime/cli\"]` — nesting a workspace member's path inside another member's directory is unusual for npm workspaces but not prohibited; flagged as a risk to prove during the execution phase's `npm install` gate, not assumed safe |\n231: | `system-spec-kit/package.json` root scripts | `test:root`, `test:cli`, `postinstall` reference `scripts/dist/…`, `scripts/tests/…`, `scripts/setup/…` | straightforward `scripts/` → `runtime/cli/` string swap; `npm run test --workspace=@spec-kit/scripts` lines are **unaffected** (workspace flag uses the npm name, not the path) |\n232: | `system-spec-kit/package.json` `test:task-enrichment` | `\"node runtime/node_modules/vitest/vitest.mjs run tests/task-enrichment.vitest.ts --root scripts --config ../runtime/vitest.config.ts\"` | `--root scripts` → `--root runtime/cli`; the `--config ../runtime/vitest.config.ts` value's correctness relative to the invoking cwd (`system-spec-kit/` root) looks suspect **before** this move too (see below) — flagged for manual verification by running the script, not auto-rewritten |\n233: | `system-spec-kit/scripts/package.json` name/deps | `@spec-kit/scripts`; `\"@spec-kit/runtime\": \"file:../runtime\"` | **keep the npm name** `@spec-kit/scripts` (see §8); `file:../runtime` → `file:../..` (one hop, since `runtime` is now the parent, not a sibling) |\n234: | `system-spec-kit/scripts/package.json` `test`/`test:task-enrichment` scripts | `vitest run --config ../runtime/vitest.config.ts --root .` | `../runtime/vitest.config.ts` → `../vitest.config.ts` (§4's drop-the-segment rule: one `..` now reaches `runtime/` directly) |\n235: | `system-spec-kit/tsconfig.json` | `references: [{path:\"./shared\"},{path:\"./runtime\"},{path:\"./scripts\"}]` | `{path:\"./runtime/cli\"}` |\n236: | `system-spec-kit/scripts/tsconfig.json` | `extends: \"../tsconfig.json\"`; `references: [{path:\"../shared\"},{path:\"../runtime\"}]`; `paths: {\"@spec-kit/runtime/*\":[\"../runtime/*\"], ...}` | `extends` → `\"../../tsconfig.json\"` (+1, escapes to system-spec-kit); `references` → `{path:\"../../shared\"}` (+1) and `{path:\"..\"}` (§4 drop-segment: one `..` now IS runtime); `paths` → `\"../*\"` for `@spec-kit/runtime/*` (drop-segment) |\n237: | `system-spec-kit/vitest.config.ts` (root) | `include: ['tests/**','scripts/tests/**','runtime/tests/**']` | `'scripts/tests/**'` → `'runtime/cli/tests/**'` |\n238: | `system-spec-kit/runtime/vitest.config.ts` | `root: path.resolve(import.meta.dirname,'..')` (= `system-spec-kit/`, **unchanged** — this file does not move); `include: [...,'scripts/tests/**',...]` | the `root` computation is untouched since `runtime/vitest.config.ts` stays in place; only the include glob changes: `'scripts/tests/**'` → `'runtime/cli/tests/**'` |\n239: | `system-spec-kit/package-lock.json` | npm v7+ lockfile keys workspace members by relative path (`\"scripts\": {...}`, `\"node_modules/@spec-kit/scripts\": {\"resolved\":\"scripts\",\"link\":true}`, 102 lines total naming `\"scripts` per `git grep -c`) | **do not hand-edit** — regenerate via `npm install` at the `system-spec-kit/` workspace root (the workspace's own root, not the repository root; packet 053 did the same and documented why: `npm ci` inside a workspace member with no lockfile of its own refuses with `EUSAGE`) |\n240: | `.gitignore` | lines 83-84: `.opencode/skills/system-spec-kit/scripts/tests/*.vitest.d.ts.map`, `...vitest.js.map` | both → `.opencode/skills/system-spec-kit/runtime/cli/tests/...` |\n241: | `scripts/runtime` (tracked symlink) | `-> ../runtime/dist` | after the move this file lives at `runtime/cli/runtime`; to preserve the exact same real target (`system-spec-kit/runtime/dist`) it must repoint to `-> ../dist`. **Do not remove it** even though nothing was found to dereference it for imports (`grep` for `require('./runtime` / `from './runtime` inside `scripts/dist` returned 0 hits) — `dist-freshness.cjs`'s symlink-skip comment at line 233 documents it as an intentional freshness-walker boundary marker, and removing it would be a behavior change outside this phase's \"path rename only\" scope, not a path fix. Flag for the execution phase: confirm whether `DEFAULT_EXCLUDED_SEGMENTS = ['node_modules','dist']` already makes the marker redundant (it excludes any `dist`-named segment regardless of symlink status) — a real finding, but a removal decision, not a rename, so out of scope here |\n242: \n243: **On the `test:task-enrichment` cwd ambiguity**: the root `package.json` script invokes\n244: `node runtime/node_modules/vitest/vitest.mjs` with cwd at `system-spec-kit/` (npm sets\n245: cwd to the package declaring the script), and passes `--config ../runtime/vitest.config.ts`.\n246: If vitest resolves `--config` relative to cwd (the common case), that value already\n247: points one level *above* `system-spec-kit/`, which does not exist — a candidate\n248: pre-existing bug, unrelated to this move. Recorded here per the edge-case guidance\n249: (\"a reference that resolves ambiguously is flagged for manual resolution, not\n250: auto-resolved\"); the execution phase should run this exact script before and after\n251: the move rather than assume its current or post-move correctness.\n252: \n253: ## 7. CI, doctor, hooks and plugins (all confirmed live)\n254: \n255: | Surface | File | Lines | Live because |\n256: |---------|------|------:|---------------|\n257: | CI | `.github/workflows/changed-packet-validation.yml` | 37, 89, 122, 131, 144 | `npm ci` in scripts/, `validate.sh` invocations |\n258: | CI | `.github/workflows/command-tree-parity.yml` | 22 | `CHECKER=\".../scripts/validate-command-tree-parity.sh\"` |\n259: | CI | `.github/workflows/markdown-link-integrity.yml` | 29 | `GUARD=\".../scripts/check-markdown-links.cjs\"` |\n260: | CI | `.github/workflows/strict-pass-freshness-report.yml` | 45, 56-57, 94 | `npm ci`, `tsx` loader path, `repair-derived.cjs` |\n261: | Doctor | `.opencode/commands/doctor/_routes.yaml`, `assets/doctor-fable-mode.yaml`, `assets/doctor-memory.yaml`, `assets/doctor-runtime-mirrors.yaml`, `assets/doctor-update.yaml`, `scripts/fable-mode-check.cjs`, `scripts/doctor-runtime-bootstrap.sh` | — | routing YAML `command:` fields and doctor sub-scripts shelling into `system-spec-kit/scripts/**` |\n262: | Session plugin | `.opencode/plugins/session-cleanup.js` | 32 | `join(REPO_ROOT, '.opencode/skills/system-spec-kit/scripts/dist/ops/process-sweep.js')` |\n263: | Session plugin | `.opencode/plugins/system-dist-freshness-guard.js` | 27 | `require('../skills/system-spec-kit/scripts/lib/dist-freshness.cjs')` — runs on every `PostToolUse` |\n264: | Session plugin | `.opencode/plugins/system-speckit-completion.js` | 27 | `import core from '../skills/system-spec-kit/scripts/lib/completion-state.cjs'` |\n265: | Bin shim | `.opencode/bin/speckit-completion.cjs` | 20 | `require('../skills/system-spec-kit/scripts/lib/completion-state.cjs')` |\n266: | Bin script | `.opencode/bin/worktree-session.sh` | 85-86 | lists `scripts/dist`, `scripts/node_modules` (likely a worktree-copy exclude/ignore list) |\n267: | Hook router | `.opencode/hooks/post-edit-quality/lib/post-edit-router.cjs` | 39-40 | config-string map to `scripts/spec/check-placeholders.sh`, `scripts/rules/check-links.sh` |\n268: | Hook doc | `.opencode/hooks/dist-freshness/README.md` | 95, 122 | documents the same shared `dist-freshness.cjs` import path |\n269: \n270: These are exactly the class of surface the parent packet's own affected-surfaces\n271: table called out as \"not changed in this phase; inventory only\" — now inventoried\n272: with exact file:line evidence for the execution phase to act on directly.\n273: \n274: ## 8. Package-name decision\n275: \n276: **Recommendation: keep `@spec-kit/scripts` as the npm package name.** The physical\n277: directory changes; the identity a `package.json` `name` field, a\n278: `--workspace=@spec-kit/scripts` flag, and a `\"@spec-kit/scripts\": \"file:../scripts\"`\n279: dependency declaration all reference does not have to move with it — npm resolves\n280: workspace members by their `workspaces` array path, not by matching the folder name\n281: to the package name (confirmed: the sibling `@spec-kit/runtime` package already\n282: lives at a directory that doesn't literally spell `runtime` anywhere unusual, and\n283: packet 053 renamed the *directory* `mcp-server → runtime` while also renaming the\n284: npm name in that case — but that case was renaming an inaccurate name to an accurate\n285: one; here `scripts` still accurately describes what the CLI workspace *is*, only\n286: *where* it lives changes). Renaming the npm name would additionally require touching\n287: every `--workspace=@spec-kit/scripts` invocation, the `dependencies` entries in\n288: `runtime/package.json` (if any) and `shared/package.json` that reference it by name,\n289: and would not by itself fix a single path reference in this inventory — pure\n290: downside for this phase's stated goal. `spec.md`'s own Out of Scope section already\n291: reaches this conclusion; this inventory found nothing to overturn it.\n292: \n293: Separately, the **internal `dist-freshness.cjs` `id` field** (`'system-spec-kit/scripts'`,\n294: §3) is not the npm name — it is a path-shaped identifier local to that one file's\n295: `DIST_PACKAGES` table, consistent with its sibling entries `'system-spec-kit/runtime'`\n296: and `'system-spec-kit/shared'`. Recommend renaming it to `'system-spec-kit/runtime/cli'`\n297: to keep that convention, since its only consumer (`dist-freshness-walker.vitest.ts:35`)\n298: moves in the same commit.\n299: \n300: ## 9. Symlinks\n301: \n302: Zero live symlinks in the tracked tree resolve into `system-spec-kit/scripts/**`\n303: (`find . -type l -lname '*system-spec-kit/scripts*'` found only two matches, both\n304: inside gitignored, out-of-scope trees — a vendored `barter/` subproject and the\n305: `.worktrees/022-012-runtime-enablement-build` checkout on a different branch — and\n306: both are stale leftovers: the *current* tracked `install-scripts/` directory no\n307: longer contains the `install-spec-kit-memory.sh` script that made them). The one\n308: tracked symlink *inside* the moving tree is `scripts/runtime -> ../runtime/dist`,\n309: covered in §6. No hook-registration symlink (`.claude/.codex/.cursor/.devin/.pi`\n310: `hooks/**`, 13 total) targets `system-spec-kit/scripts/**` — confirmed by\n311: `readlink` on every one.\n312: \n313: ## 10. Historical corpus (excluded, not edited)\n314: \n315: `specs/**` outside `specs/system-speckit/054-decommission-debt-fixes/` — 5,040 files\n316: naming `system-spec-kit/scripts` and 944 naming `scripts/dist` (overlapping; this is\n317: every historical packet's `spec.md`/`plan.md`/`acceptance-criteria.md` that quotes\n318: CLAUDE.md's own Completion Verification Rule text, which names `validate.sh`'s path\n319: directly). Also `.opencode/skills/system-spec-kit/changelog/*.md` (20 files quoting\n320: past validation runs as evidence, e.g. `v3.2.1.0.md`'s `bash .../scripts/spec/validate.sh\n321: ... - PASS` lines) and `.opencode/skills/{sk-code,cli-external-orchestration}/benchmark/reports/**`\n322: (7 files, frozen benchmark-run JSON/MD snapshots). None of these are edited by the\n323: execution phase — they are frozen records of what was true when they were written,\n324: matching packet 053's own treatment of `specs/**`, `changelog/**` and `benchmark/**`\n325: as historical evidence outside the blast radius. `specs/system-speckit/054-decommission-debt-fixes/**`\n326: itself (this packet's own planning and research docs, ~90 files) is excluded from\n327: this bucket for the opposite reason: it is the live plan *for* this move, not a\n328: record of the past, and stays exactly as authored.\n329: \n330: ## 11. Level re-score (REQ-003)\n331: \n332: `recommend-level.sh` scores by estimated LOC/files/risk factors, not by folder path,\n333: so it was run against this move's estimated execution-phase scope (~450 files touched\n334: across git-mv self-references + external text edits, ~900 LOC of diff, an\n335: architectural/workspace-topology change):\n336: \n337: ```\n338: $ bash .../scripts/spec/recommend-level.sh --loc 900 --files 450 --architectural --json\n339: {\n340:   \"recommended_level\": 3, \"level_name\": \"Full\", \"total_score\": 73, \"max_score\": 100,\n341:   \"confidence\": 82, \"recommended_phases\": true, \"phase_score\": 40,\n342:   \"phase_reason\": \"Architectural change + 450 files + 900 LOC + extreme scale\",\n343:   \"suggested_phase_count\": 3\n344: }\n345: ```\n346: \n347: **Level 3 confirmed**, matching this phase's own risk note and the packet-053\n348: precedent. The tool additionally recommends phase decomposition (3 suggested\n349: phases) given the scale — worth weighing against REQ-004's \"one atomic commit\"\n350: requirement when the execution packet is scoped: the *commit* should stay atomic\n351: per packet-053 precedent, but the *planning documents* could still be phased\n352: (e.g. tree move + internal fixes / external consumer updates / verification pass)\n353: without splitting the commit itself.\n354: \n355: ## 12. Foreseen conflicts for the execution phase\n356: \n357: 1. **`runtime/scripts/` vs the incoming `runtime/cli/`** — resolved by the layout\n358:    decision (§0); no actual name collision survives, but `check-architecture-boundaries.ts`\n359:    references both in four nearby lines (§3) and is the one file most likely to be\n360:    mis-edited by a blind find-and-replace.\n361: 2. **`workspaces: [..., \"runtime/cli\"]`** — nesting a workspace member inside\n362:    another member's own directory tree is not something this inventory found\n363:    precedent for elsewhere in this repo's own workspace configs; npm does not\n364:    document this as prohibited, but it should be *proven*, not assumed, via a\n365:    clean `npm install` + `npm ci --dry-run` at the `system-spec-kit/` root before\n366:    the commit is considered complete (mirroring packet 053's own verification list).\n367: 3. **Two false positives a naive sweep would wrongly touch**: `runtime/tests/dist-freshness.vitest.ts:134`\n368:    and `runtime/tests/path-boundary.vitest.ts:86` both contain a bare `'scripts'`\n369:    literal that is unrelated to the moving workspace (§4) — confirmed safe to leave\n370:    alone by reading surrounding context, not by pattern alone.\n371: 4. **The `test:task-enrichment` root script's `--config` path** (§6) has a cwd\n372:    ambiguity that may predate this move; resolve by running it, not by assumption.\n373: 5. **`scripts/runtime` symlink's continued necessity** (§6) is a real open question\n374:    (`DEFAULT_EXCLUDED_SEGMENTS` may already make it redundant) but resolving that\n375:    is a behavior decision outside a path-rename-only phase — repoint it, do not\n376:    remove it, unless the operator explicitly widens scope.\n\n(End of file - total 376 lines)\n</content>","metadata":{"preview":"# Reference inventory and target-layout resolution\n\nTaken read-only on `skilled/v4.0.0.0` in the main checkout, before any lane other\nthan this one touches `scripts/`. `git grep` is the authority, not `rg` alone —\npacket 053 found a `.gitignore` rule that hides `package.json`/`package-lock.json`\nfrom `rg`; this repo's current `.gitignore` no longer carries that exact rule, but\n`git grep` was used throughout anyway so the result does not depend on that being\ntrue today.\n\nExcluded as historical evidence, matching packet 053's own exclusion class: `specs/**`,\nany directory literally named `changelog` or `benchmark` at any depth (both the\nrepo has none at the root, but `.opencode/skills/system-spec-kit/changelog/` and two\nskills' `benchmark/reports/` trees exist and are the same kind of frozen record),\n`node_modules/**`, generated `dist/**`, `z_archive/**`, and two gitignored,\nout-of-tree copies (`barter/ai-speckit/...` — a vendored subproject — and\n`.worktrees/022-012-runtime-enablement-build/...` — a different branch's checkout).\n\n## 0. Target-layout decision (REQ-002)\n\n**Chosen: `runtime/cli/`** (spec.md's option (a)), confirmed by direct inspection:","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/inventory.md","text":"# Reference inventory and target-layout resolution\n\nTaken read-only on `skilled/v4.0.0.0` in the main checkout, before any lane other\nthan this one touches `scripts/`. `git grep` is the authority, not `rg` alone —\npacket 053 found a `.gitignore` rule that hides `package.json`/`package-lock.json`\nfrom `rg`; this repo's current `.gitignore` no longer carries that exact rule, but\n`git grep` was used throughout anyway so the result does not depend on that being\ntrue today.\n\nExcluded as historical evidence, matching packet 053's own exclusion class: `specs/**`,\nany directory literally named `changelog` or `benchmark` at any depth (both the\nrepo has none at the root, but `.opencode/skills/system-spec-kit/changelog/` and two\nskills' `benchmark/reports/` trees exist and are the same kind of frozen record),\n`node_modules/**`, generated `dist/**`, `z_archive/**`, and two gitignored,\nout-of-tree copies (`barter/ai-speckit/...` — a vendored subproject — and\n`.worktrees/022-012-runtime-enablement-build/...` — a different branch's checkout).\n\n## 0. Target-layout decision (REQ-002)\n\n**Chosen: `runtime/cli/`** (spec.md's option (a)), confirmed by direct inspection:\n`runtime/scripts/` already holds `finalize-dist.mjs`, `run-tests.mjs`,\n`run-tests-sharded.mjs` and a `tests/` folder — real build-tooling content, not an\nempty placeholder — so a literal `git mv scripts runtime/scripts` collides on day\none. `runtime/cli/` does not exist yet (confirmed: `ls` returns \"No such file or\ndirectory\"), so the incoming CLI workspace lands on a clean name. The rejected\nalternative (folding `runtime/scripts/`'s three files into the incoming tree first)\nwould require touching every reference to those three build-tooling files instead\nof the handful this decision touches (see §7); this phase's plan.md already reached\nthe same conclusion and this inventory found nothing that overturns it.\n\n**The collision is bounded, not eliminated by re-partitioning**: two directories will\nboth be named `scripts` after the move — `runtime/scripts/` (build tooling, unmoved)\nand `runtime/cli/` (unaffected, it's the CLI workspace's new name). No name collision\nsurvives. The one thing that DOES still require care is `evals/check-architecture-boundaries.ts`,\nwhich references both `runtime/scripts` (the build-tooling dir, stays) and the outer\n`scripts` (the CLI workspace, moves) in the same file four lines apart — see §7.1.\n\n## 1. Counts\n\n| Group | Count | How it was taken |\n|-------|------:|-------------------|\n| Files (outside `specs/`, `changelog/`, `benchmark/`, `node_modules`, `dist`, `z_archive`) naming `system-spec-kit/scripts` or `scripts/dist` | 447 | `git grep -l -F \"system-spec-kit/scripts\"` ∪ `git grep -l -F \"scripts/dist\"`, filtered |\n| — of those, inside the `scripts/` tree itself (move wholesale via `git mv`, but internal content still needs text edits) | 157 | self-references |\n| — of those, outside the `scripts/` tree (need a real text edit at their current location) | 290 | see §4 |\n| Approx. total matching lines across the 447 files (both patterns; a line matching both is counted twice) | ~1,800 | summed per-file `git grep -c` |\n| `specs/**` files naming the same strings (historical corpus, excluded from the count above, not edited) | 5,040 (`system-spec-kit/scripts`) + 944 (`scripts/dist`), overlapping | `git grep -l` scoped to `specs/*` |\n| Skill-level `changelog/`/`benchmark/` files naming the same strings (historical, excluded) | 29 + 7 | `grep -c '/changelog/'` / `/benchmark/'` over the raw hit list |\n| Symlinks whose target resolves into `system-spec-kit/scripts` | 0 in-tree; 2 in gitignored, out-of-scope copies | `find . -type l -lname '*system-spec-kit/scripts*'` |\n| Tracked symlink inside the package's own tree | 1 | `scripts/runtime -> ../runtime/dist` |\n\n### Outside-the-tree files by area (290, non-self-reference)\n\n| Area | Files | Notes |\n|------|------:|-------|\n| `.opencode/skills/system-spec-kit` (non-`scripts/`: `manual-testing-playbook`, `references`, `feature-catalog`, `runtime`, `changelog`*, `templates`, `assets`, root docs) | 130 | *changelog subset (20) is historical, not counted as live below |\n| `.opencode/skills/system-deep-loop` | 48 | deep-review/deep-research/deep-ai-council SKILL docs quoting the trigger-index or validate.sh commands; 3 under `runtime/`, 1 `shared/`, 1 `benchmark/`* |\n| `.opencode/skills/sk-code` | 23 | 3 under `benchmark/reports/`* (historical), rest are manual-testing-playbook + reference docs |\n| `.opencode/skills/cli-external-orchestration` | 20 | 2 under `benchmark/reports/`* (historical); rest are per-CLI `SKILL.md` + prompt-template assets |\n| `.opencode/commands` | 41 | `create` (15), `speckit` (8), `deep` (8), `doctor` (7, see §5), `memory` (3) |\n| `.opencode/skills/sk-doc` | 10 | includes 2 test-fixture manifests that enumerate real paths (§3) |\n| `.claude`, `.codex`, `.pi` (agent mirrors + SYNC.md) | 8 each | generated by `sync-runtime-mirrors.cjs`; see §2 |\n| `.github/workflows` | 4 | all live CI steps, see §5 |\n| `.opencode/plugins` | 3 | live PostToolUse/session plugins, see §3 |\n| `.opencode/bin` | 3 | `README.md`, `speckit-completion.cjs` (relative `require`), `worktree-session.sh` |\n| `.opencode/agents` | 7 | canonical agent sources `sync-runtime-mirrors.cjs` reads |\n| `.opencode/hooks` | 2 | `dist-freshness/README.md`, `post-edit-quality/lib/post-edit-router.cjs` (relative config-string) |\n| `.opencode/install-guides` | 1 | `README.md`, 6 lines |\n| `.cursor`, `.devin` (`SYNC.md` only) | 1 each | |\n| `.opencode/skills/sk-git` | 2 | docs only |\n| `.opencode/skills/system-skill-advisor` | 1 | doc only |\n| `.opencode/skills/.state` | 1 | `smart-router-telemetry/README.md`, 5 lines |\n| repo root (`CLAUDE.md`, `AGENTS.md`, `README.md`, `CONTRIBUTING.md`, `.gitignore`) | 5 | see §6 |\n\n## 2. Runtime-mirror generation chain (grep-invisible unless traced)\n\n`.claude/agents/*.md`, `.codex/agents/*.toml`, `.pi/agents/*.md` are **not** hand-edited\ncopies — `ls -la` shows them as regular files, and `.claude/SYNC.md:62,103,125` names the\ngenerator: `.opencode/skills/system-spec-kit/scripts/runtime-mirrors/sync-runtime-mirrors.cjs`,\nwhich reads the canonical `.opencode/agents/*.md` sources and writes the five mirrors\n(`.claude`, `.codex`, `.cursor`, `.devin`, `.pi`). Confirmed by direct grep:\n`.opencode/agents/ai-council.md:748` carries the same\n`node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js` line\nthat shows up verbatim in `.claude/agents/ai-council.md:734` and\n`.codex/agents/ai-council.toml:738`.\n\n**Consequence for the execution phase**: editing the seven canonical `.opencode/agents/*.md`\nfiles is necessary but not sufficient — the mirrors must be regenerated in the same\ncommit (`node .opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs`,\npost-move) and verified with its own `--check` flag (per `.claude/SYNC.md:103`), or the\nfive per-runtime copies keep the stale path even though the canonical source is fixed.\nSeparately, `.claude/hooks/`, `.codex/hooks/`, `.cursor/hooks/`, `.devin/hooks/`,\n`.pi/extensions/` are real symlink trees, but none of their 13 symlinks target\n`system-spec-kit/scripts/**` (they resolve into `sk-git/scripts/`, `sk-code/sk-code-quality/scripts/`,\nor `.opencode/scripts/session-cleanup.sh` — confirmed by `readlink` on all 13). No hook\nsymlink needs repointing.\n\n## 3. References a path/name grep does not reach\n\nThese carry the workspace's location without spelling the searched strings as one\ncontiguous token, and each one breaks silently on the move if handled by text\nsubstitution alone.\n\n| File | Line | Shape | Why the grep misses it |\n|------|-----:|-------|--------------------------|\n| `.opencode/bin/skill-advisor.cjs` | 24 | `require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'scripts', 'lib', 'dist-freshness.cjs'))` | each path segment is a separate string argument to `path.join`, not one literal |\n| `.opencode/skills/system-spec-kit/shared/embeddings/factory.ts` | 248 | `resolveSpecKitPackageRoot()` walks up directories checking `existsSync(path.join(currentDir,'runtime','database')) && existsSync(path.join(currentDir,'scripts')) && existsSync(path.join(currentDir,'shared'))` as its root-detection landmark | bare `'scripts'` segment used as a directory-existence marker, not a joined string; also sits in `shared/`, which the architecture rule says must stay neutral of `runtime`/`scripts` internals — this landmark check already couples it, and the coupling gets worse (the check would need `runtime/cli` instead of a plain sibling name) |\n| `.opencode/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts` | 966 | `workspaceRoots = [systemSpecKitRoot, path.join(systemSpecKitRoot,'runtime'), path.join(systemSpecKitRoot,'scripts')]`, used to resolve bare relative `key_files` paths against every workspace root | segmented `path.join`, and the array is built, not matched as a string |\n| `.opencode/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts` | 74, 75, 76, 77, 229 | five separate `path.join(SKILL_ROOT, 'scripts', …)` calls building `VALIDATOR_REGISTRY_PATH`, `VALIDATOR_RULES_ROOT`, `VALIDATOR_DIST_VALIDATION_ROOT`, `VALIDATE_SCRIPT_DIR`, and a dynamic validator-script resolve — this is `validate.sh`'s own rule-loading core | segmented `path.join`; this is the single highest-risk file in this class since every `validate.sh` run depends on it |\n| `.opencode/skills/system-spec-kit/runtime/tests/env-reference-drift.vitest.ts` | 125 | `resolve(SYSTEM_SPEC_KIT_ROOT, 'scripts')`, then recursively walks it for env-flag token drift | segmented `resolve` |\n| `.opencode/skills/system-spec-kit/runtime/tests/validation-orchestrator-bridge.vitest.ts` | 100 | `path.join(SKILL_ROOT, 'scripts', 'dist', 'validation', 'continuity-freshness.js')` | segmented `path.join` |\n| `.opencode/skills/system-spec-kit/scripts/evals/check-architecture-boundaries.ts` | 53, 154, 163 | `REQUIRED_ROOT_DIRS = ['shared','runtime','scripts']`; `isProhibitedForShared()`'s two `path.join(packageRoot, 'scripts')` boundary checks | bare directory-name literals keying architecture-boundary logic — the exact same file and the exact same shape (`'mcp-server'` literals) packet 053 found at these same line numbers for its own rename |\n| `.opencode/skills/system-spec-kit/scripts/evals/check-architecture-boundaries.ts` | 404 | `wrappersDir = path.join(resolvedRoot, 'runtime', 'scripts')` | **do not touch** — this is the *other* `scripts`, the build-tooling dir inside `runtime/` that this move does not rename; it happens to sit four lines from three that must change, in the same file |\n| `.opencode/skills/system-spec-kit/scripts/lib/dist-freshness.cjs` | 33 (`id`), 35 (`root`), 41 (`rebuildCommand`) | `DIST_PACKAGES` table entry `{ id: 'system-spec-kit/scripts', root: '.opencode/skills/system-spec-kit/scripts', rebuildCommand: 'cd .../scripts && npm run build' }` | caught by the main sweep as text, listed here because the `id` field (not a filesystem path) has exactly one consumer: `scripts/tests/dist-freshness-walker.vitest.ts:35` looks it up by the literal string `'system-spec-kit/scripts'`. Renaming it to `'system-spec-kit/runtime/cli'` (recommended, to match the `root`/`runtime` sibling entries' convention) needs that one test line updated in the same commit — both files move together so this is low-risk, just easy to miss since it's an identifier, not a path |\n| `.opencode/skills/sk-doc/scripts/tests/code-folder/durable-directory-manifest.json` | — | a data manifest enumerating real repository directories a checker compares against the working tree | a JSON data file, not code; if any listed entry names `system-spec-kit/scripts/...` as a durable directory, the checker will report a false drift the day the real directory moves — needs a value update, not import repair |\n\n## 4. Relative-import direction flips (`scripts/` ↔ `runtime/`)\n\nThis is the single largest and easiest-to-miss class the task called out by name.\nToday `scripts/` and `runtime/` are siblings under `system-spec-kit/`, so code in\n`scripts/<subdir>/<file>.ts` reaches `runtime/` by climbing out of `scripts/` and\nback down: `'../../runtime/…'` (2 `..` from `scripts/<subdir>` lands on\n`system-spec-kit/`, then `runtime/…` descends into it). After the move, `runtime/`\nis the **parent** of the relocated `cli/`, so the same 2 `..` from\n`runtime/cli/<subdir>` already lands *on* `runtime/` — the trailing `runtime/`\nsegment must be **dropped**, not have a `..` added:\n\n```\nOLD (from scripts/tests/x.ts):  '../../runtime/api'      -> up 2 = system-spec-kit, then descend runtime/api\nNEW (from runtime/cli/tests/x.ts): '../../api'            -> up 2 already IS runtime, descend api directly\n```\n\nThe dot-count is unchanged; only the literal `runtime/` segment in the middle is\nremoved. This is **not** covered by the generic \"+1 `..`\" rule in §7, which applies\nto the opposite case (an escape that does *not* pass through `runtime`).\n\nVerified count: **21 files, 36 matching lines** (`git grep -rE \"['\\\"]\\.\\./\\.\\./runtime\"` under\n`scripts/`, excluding `dist/`). Two are production source, not tests:\n\n- `scripts/validation/generated-metadata-drift.ts:14-15`\n- `scripts/validation/generated-metadata-integrity.ts:14,18`\n- `scripts/evals/check-handler-cycles-ast.ts:24,26,28-29` — a **multi-candidate resolver**\n  trying 1-, 2- and 3-level climbs plus a `process.cwd()`-relative fallback to find\n  `runtime/handlers` from an AST-visited module at an unknown depth; each candidate\n  needs the same drop-the-`runtime`-segment treatment at its own depth, not a uniform\n  rule — read the file before editing it.\n\nThe remaining 18 are test files (`scripts/tests/backfill-research-metadata.vitest.ts`,\n`continuity-freshness.vitest.ts`, `gate-3-classifier.vitest.ts`,\n`generated-metadata-drift.vitest.ts`, `graph-key-file-declarations.vitest.ts`,\n`graph-metadata-backfill.vitest.ts`, `graph-metadata-refresh.vitest.ts`,\n`import-policy-rules.vitest.ts` — **caution**, its matches are string literals passed\nto `isProhibitedImportPath()` under test, i.e. test *data*, not real resolved paths;\nconfirm whether the boundary rule's meaning should change post-move before editing\nits fixtures — `level-contract-resolver.vitest.ts`, `scaffold-golden-snapshots.vitest.ts`,\n`scoped-backfill-boundary.vitest.ts`, `test-bug-regressions.js`, `test-export-contracts.js`,\n`test-naming-migration.js` — **caution**, most of its ~60 `'runtime/lib/…'` entries are\na descriptive data table of file-and-count pairs for files that live inside `runtime/`\nand never move, so they need **no change**; only its one real `path.resolve(__dirname,'../../runtime')`\ncall at line 31 is a live reference — `validation-engine-coherence.vitest.ts`,\n`workflow-canonical-save-metadata.vitest.ts`).\n\n`tests/architecture-boundary-enforcement.vitest.ts` and\n`tests/check-source-dist-alignment-orphans.vitest.ts` also match `'runtime/scripts'` or\n`'runtime/lib'` etc. as literals, but on inspection these build **synthetic fixture\ntrees** (`writeFixtureFile(root, 'runtime/scripts/too-long.ts', …)`) mimicking the\n`runtime/scripts` *build-tooling* dir that this move does not touch — confirmed\n**unaffected**, listed here so the execution phase does not re-flag them.\n\nTwo identically-shaped test files are confirmed **unaffected** despite matching a\nbare `'scripts'` grep: `runtime/tests/dist-freshness.vitest.ts:134` iterates\n`['api','configs','core','handlers','hooks','scripts']` to build a fixture for\n`runtime/`'s *own* dist-freshness sourceCandidates (its `'scripts'` is `runtime/scripts`,\nthe build-tooling dir, per the surrounding `packageRoot = …/runtime` line 126); and\n`runtime/tests/path-boundary.vitest.ts:86` builds an arbitrary synthetic fixture path\n(`createTempRoot('path-boundary-graph-')`) with no relation to the real workspace.\n\n## 5. Fixed-depth `__dirname` climbers (the \"+1\" rule)\n\nEvery file under `scripts/` that computes an ancestor directory by counting a fixed\nnumber of `..` segments from `__dirname` needs **one more `..`** after the move,\n*unless* the target is inside `runtime/` (§4 applies instead) or inside `scripts/`\nitself (moves together, no change). Verified via\n`grep -rn \"path\\.resolve(__dirname, '\\(\\.\\./\\)\\{3,\\}\"` (5-level, reaching repo root)\nand the 2-level pattern (reaching `system-spec-kit/` root):\n\n| File | Line | Current | Reaches (today) | Needs |\n|------|-----:|---------|------------------|-------|\n| `scripts/runtime-mirrors/sync-runtime-mirrors.cjs` | 32 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/optimizer/replay-corpus.cjs` | 58 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/codex/sync-agents.cjs` | 18 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/codex/sync-prompts.cjs` | 19 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/pi/sync-agents-pi.cjs` | 18 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/pi/sync-prompts-pi.cjs` | 19 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/resource-map/extract-from-evidence.cjs` | 11 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/tests/repair-derived.vitest.ts` | 15 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/tests/validate-memory-quality-v8-overreach.vitest.ts` | 195 | `'../../../../..'` (5) | repo root | 6 `..` |\n| `scripts/lib/dist-freshness.cjs` | 21 | `'..','..','..','..','..'` (5, chained args) | repo root (`WORKSPACE_ROOT`) | 6 `..` |\n| `scripts/tests/test-phase-validation.js` | 14 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n| `scripts/tests/completion-state.vitest.ts` | 33 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n| `scripts/tests/test-phase-command-workflows.js` | 18 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n| `scripts/tests/test-phase-system.js` | 13 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n| `scripts/tests/test-folder-detector-functional.js` | 25 | `'..','..','..','..','..'` (5) | repo root | 6 `..` |\n| `scripts/setup/record-node-version.js` | 19 | `'../..'` (2) | `system-spec-kit/` (`rootDir`) | 3 `..` |\n| `scripts/tests/workflow-invariance.vitest.ts` | 10 | `'../..'` (2) | `system-spec-kit/` (`SKILL_ROOT`) | 3 `..` |\n| `scripts/tests/scaffold-golden-snapshots.vitest.ts` | 13 | `'../..'` (2) | `system-spec-kit/` (`SKILL_ROOT`) | 3 `..`; **note**: same file's line 10 is a §4 case (`'../../runtime/lib/…'`), needing the opposite treatment |\n\n`scripts/tests/test-utils.js:17` (`path.join(__dirname,'..','..','runtime','database')`)\nis a hybrid of both rules: it currently climbs 2 (to `system-spec-kit/`) then descends\n`runtime/database` — after the move this becomes `path.join(__dirname,'..','..','database')`\n(§4's drop-the-segment rule, same 2 ups, since 2 ups from the new location already IS\n`runtime/`).\n\n`.opencode/skills/system-spec-kit/runtime/hooks/claude/session-stop.ts:73-76`\n(`resolveGenerateContextScriptPath()`) is its own special case: a 4-candidate\nresolver trying `HOOK_DIR` at both its source depth (`runtime/hooks/claude/`, 3 `..`\ntoday) and its compiled-dist depth (`runtime/dist/hooks/claude/`, 4 `..` today),\nplus two `process.cwd()`-relative absolute/bare forms. Every candidate lands on\n`runtime`'s own path, one hop before old-`scripts`, so **all four collapse to\nclimbing to `runtime` and descending directly into `cli/dist/…`** rather than any\nuniform `+1`:\n`resolve(HOOK_DIR, '../../cli/dist/memory/generate-context.js')` (was 3 `..` + `scripts/…`),\n`resolve(HOOK_DIR, '../../../cli/dist/memory/generate-context.js')` (was 4 `..` + `scripts/…`),\n`resolve(process.cwd(), '.opencode/skills/system-spec-kit/runtime/cli/dist/memory/generate-context.js')`,\n`resolve(process.cwd(), 'runtime/cli/dist/memory/generate-context.js')`.\n\n## 6. Workspace, package-manifest and build-config surfaces\n\n| Surface | Current | Change |\n|---------|---------|--------|\n| `system-spec-kit/package.json` `workspaces` | `[\"shared\",\"runtime\",\"scripts\"]` | `[\"shared\",\"runtime\",\"runtime/cli\"]` — nesting a workspace member's path inside another member's directory is unusual for npm workspaces but not prohibited; flagged as a risk to prove during the execution phase's `npm install` gate, not assumed safe |\n| `system-spec-kit/package.json` root scripts | `test:root`, `test:cli`, `postinstall` reference `scripts/dist/…`, `scripts/tests/…`, `scripts/setup/…` | straightforward `scripts/` → `runtime/cli/` string swap; `npm run test --workspace=@spec-kit/scripts` lines are **unaffected** (workspace flag uses the npm name, not the path) |\n| `system-spec-kit/package.json` `test:task-enrichment` | `\"node runtime/node_modules/vitest/vitest.mjs run tests/task-enrichment.vitest.ts --root scripts --config ../runtime/vitest.config.ts\"` | `--root scripts` → `--root runtime/cli`; the `--config ../runtime/vitest.config.ts` value's correctness relative to the invoking cwd (`system-spec-kit/` root) looks suspect **before** this move too (see below) — flagged for manual verification by running the script, not auto-rewritten |\n| `system-spec-kit/scripts/package.json` name/deps | `@spec-kit/scripts`; `\"@spec-kit/runtime\": \"file:../runtime\"` | **keep the npm name** `@spec-kit/scripts` (see §8); `file:../runtime` → `file:../..` (one hop, since `runtime` is now the parent, not a sibling) |\n| `system-spec-kit/scripts/package.json` `test`/`test:task-enrichment` scripts | `vitest run --config ../runtime/vitest.config.ts --root .` | `../runtime/vitest.config.ts` → `../vitest.config.ts` (§4's drop-the-segment rule: one `..` now reaches `runtime/` directly) |\n| `system-spec-kit/tsconfig.json` | `references: [{path:\"./shared\"},{path:\"./runtime\"},{path:\"./scripts\"}]` | `{path:\"./runtime/cli\"}` |\n| `system-spec-kit/scripts/tsconfig.json` | `extends: \"../tsconfig.json\"`; `references: [{path:\"../shared\"},{path:\"../runtime\"}]`; `paths: {\"@spec-kit/runtime/*\":[\"../runtime/*\"], ...}` | `extends` → `\"../../tsconfig.json\"` (+1, escapes to system-spec-kit); `references` → `{path:\"../../shared\"}` (+1) and `{path:\"..\"}` (§4 drop-segment: one `..` now IS runtime); `paths` → `\"../*\"` for `@spec-kit/runtime/*` (drop-segment) |\n| `system-spec-kit/vitest.config.ts` (root) | `include: ['tests/**','scripts/tests/**','runtime/tests/**']` | `'scripts/tests/**'` → `'runtime/cli/tests/**'` |\n| `system-spec-kit/runtime/vitest.config.ts` | `root: path.resolve(import.meta.dirname,'..')` (= `system-spec-kit/`, **unchanged** — this file does not move); `include: [...,'scripts/tests/**',...]` | the `root` computation is untouched since `runtime/vitest.config.ts` stays in place; only the include glob changes: `'scripts/tests/**'` → `'runtime/cli/tests/**'` |\n| `system-spec-kit/package-lock.json` | npm v7+ lockfile keys workspace members by relative path (`\"scripts\": {...}`, `\"node_modules/@spec-kit/scripts\": {\"resolved\":\"scripts\",\"link\":true}`, 102 lines total naming `\"scripts` per `git grep -c`) | **do not hand-edit** — regenerate via `npm install` at the `system-spec-kit/` workspace root (the workspace's own root, not the repository root; packet 053 did the same and documented why: `npm ci` inside a workspace member with no lockfile of its own refuses with `EUSAGE`) |\n| `.gitignore` | lines 83-84: `.opencode/skills/system-spec-kit/scripts/tests/*.vitest.d.ts.map`, `...vitest.js.map` | both → `.opencode/skills/system-spec-kit/runtime/cli/tests/...` |\n| `scripts/runtime` (tracked symlink) | `-> ../runtime/dist` | after the move this file lives at `runtime/cli/runtime`; to preserve the exact same real target (`system-spec-kit/runtime/dist`) it must repoint to `-> ../dist`. **Do not remove it** even though nothing was found to dereference it for imports (`grep` for `require('./runtime` / `from './runtime` inside `scripts/dist` returned 0 hits) — `dist-freshness.cjs`'s symlink-skip comment at line 233 documents it as an intentional freshness-walker boundary marker, and removing it would be a behavior change outside this phase's \"path rename only\" scope, not a path fix. Flag for the execution phase: confirm whether `DEFAULT_EXCLUDED_SEGMENTS = ['node_modules','dist']` already makes the marker redundant (it excludes any `dist`-named segment regardless of symlink status) — a real finding, but a removal decision, not a rename, so out of scope here |\n\n**On the `test:task-enrichment` cwd ambiguity**: the root `package.json` script invokes\n`node runtime/node_modules/vitest/vitest.mjs` with cwd at `system-spec-kit/` (npm sets\ncwd to the package declaring the script), and passes `--config ../runtime/vitest.config.ts`.\nIf vitest resolves `--config` relative to cwd (the common case), that value already\npoints one level *above* `system-spec-kit/`, which does not exist — a candidate\npre-existing bug, unrelated to this move. Recorded here per the edge-case guidance\n(\"a reference that resolves ambiguously is flagged for manual resolution, not\nauto-resolved\"); the execution phase should run this exact script before and after\nthe move rather than assume its current or post-move correctness.\n\n## 7. CI, doctor, hooks and plugins (all confirmed live)\n\n| Surface | File | Lines | Live because |\n|---------|------|------:|---------------|\n| CI | `.github/workflows/changed-packet-validation.yml` | 37, 89, 122, 131, 144 | `npm ci` in scripts/, `validate.sh` invocations |\n| CI | `.github/workflows/command-tree-parity.yml` | 22 | `CHECKER=\".../scripts/validate-command-tree-parity.sh\"` |\n| CI | `.github/workflows/markdown-link-integrity.yml` | 29 | `GUARD=\".../scripts/check-markdown-links.cjs\"` |\n| CI | `.github/workflows/strict-pass-freshness-report.yml` | 45, 56-57, 94 | `npm ci`, `tsx` loader path, `repair-derived.cjs` |\n| Doctor | `.opencode/commands/doctor/_routes.yaml`, `assets/doctor-fable-mode.yaml`, `assets/doctor-memory.yaml`, `assets/doctor-runtime-mirrors.yaml`, `assets/doctor-update.yaml`, `scripts/fable-mode-check.cjs`, `scripts/doctor-runtime-bootstrap.sh` | — | routing YAML `command:` fields and doctor sub-scripts shelling into `system-spec-kit/scripts/**` |\n| Session plugin | `.opencode/plugins/session-cleanup.js` | 32 | `join(REPO_ROOT, '.opencode/skills/system-spec-kit/scripts/dist/ops/process-sweep.js')` |\n| Session plugin | `.opencode/plugins/system-dist-freshness-guard.js` | 27 | `require('../skills/system-spec-kit/scripts/lib/dist-freshness.cjs')` — runs on every `PostToolUse` |\n| Session plugin | `.opencode/plugins/system-speckit-completion.js` | 27 | `import core from '../skills/system-spec-kit/scripts/lib/completion-state.cjs'` |\n| Bin shim | `.opencode/bin/speckit-completion.cjs` | 20 | `require('../skills/system-spec-kit/scripts/lib/completion-state.cjs')` |\n| Bin script | `.opencode/bin/worktree-session.sh` | 85-86 | lists `scripts/dist`, `scripts/node_modules` (likely a worktree-copy exclude/ignore list) |\n| Hook router | `.opencode/hooks/post-edit-quality/lib/post-edit-router.cjs` | 39-40 | config-string map to `scripts/spec/check-placeholders.sh`, `scripts/rules/check-links.sh` |\n| Hook doc | `.opencode/hooks/dist-freshness/README.md` | 95, 122 | documents the same shared `dist-freshness.cjs` import path |\n\nThese are exactly the class of surface the parent packet's own affected-surfaces\ntable called out as \"not changed in this phase; inventory only\" — now inventoried\nwith exact file:line evidence for the execution phase to act on directly.\n\n## 8. Package-name decision\n\n**Recommendation: keep `@spec-kit/scripts` as the npm package name.** The physical\ndirectory changes; the identity a `package.json` `name` field, a\n`--workspace=@spec-kit/scripts` flag, and a `\"@spec-kit/scripts\": \"file:../scripts\"`\ndependency declaration all reference does not have to move with it — npm resolves\nworkspace members by their `workspaces` array path, not by matching the folder name\nto the package name (confirmed: the sibling `@spec-kit/runtime` package already\nlives at a directory that doesn't literally spell `runtime` anywhere unusual, and\npacket 053 renamed the *directory* `mcp-server → runtime` while also renaming the\nnpm name in that case — but that case was renaming an inaccurate name to an accurate\none; here `scripts` still accurately describes what the CLI workspace *is*, only\n*where* it lives changes). Renaming the npm name would additionally require touching\nevery `--workspace=@spec-kit/scripts` invocation, the `dependencies` entries in\n`runtime/package.json` (if any) and `shared/package.json` that reference it by name,\nand would not by itself fix a single path reference in this inventory — pure\ndownside for this phase's stated goal. `spec.md`'s own Out of Scope section already\nreaches this conclusion; this inventory found nothing to overturn it.\n\nSeparately, the **internal `dist-freshness.cjs` `id` field** (`'system-spec-kit/scripts'`,\n§3) is not the npm name — it is a path-shaped identifier local to that one file's\n`DIST_PACKAGES` table, consistent with its sibling entries `'system-spec-kit/runtime'`\nand `'system-spec-kit/shared'`. Recommend renaming it to `'system-spec-kit/runtime/cli'`\nto keep that convention, since its only consumer (`dist-freshness-walker.vitest.ts:35`)\nmoves in the same commit.\n\n## 9. Symlinks\n\nZero live symlinks in the tracked tree resolve into `system-spec-kit/scripts/**`\n(`find . -type l -lname '*system-spec-kit/scripts*'` found only two matches, both\ninside gitignored, out-of-scope trees — a vendored `barter/` subproject and the\n`.worktrees/022-012-runtime-enablement-build` checkout on a different branch — and\nboth are stale leftovers: the *current* tracked `install-scripts/` directory no\nlonger contains the `install-spec-kit-memory.sh` script that made them). The one\ntracked symlink *inside* the moving tree is `scripts/runtime -> ../runtime/dist`,\ncovered in §6. No hook-registration symlink (`.claude/.codex/.cursor/.devin/.pi`\n`hooks/**`, 13 total) targets `system-spec-kit/scripts/**` — confirmed by\n`readlink` on every one.\n\n## 10. Historical corpus (excluded, not edited)\n\n`specs/**` outside `specs/system-speckit/054-decommission-debt-fixes/` — 5,040 files\nnaming `system-spec-kit/scripts` and 944 naming `scripts/dist` (overlapping; this is\nevery historical packet's `spec.md`/`plan.md`/`acceptance-criteria.md` that quotes\nCLAUDE.md's own Completion Verification Rule text, which names `validate.sh`'s path\ndirectly). Also `.opencode/skills/system-spec-kit/changelog/*.md` (20 files quoting\npast validation runs as evidence, e.g. `v3.2.1.0.md`'s `bash .../scripts/spec/validate.sh\n... - PASS` lines) and `.opencode/skills/{sk-code,cli-external-orchestration}/benchmark/reports/**`\n(7 files, frozen benchmark-run JSON/MD snapshots). None of these are edited by the\nexecution phase — they are frozen records of what was true when they were written,\nmatching packet 053's own treatment of `specs/**`, `changelog/**` and `benchmark/**`\nas historical evidence outside the blast radius. `specs/system-speckit/054-decommission-debt-fixes/**`\nitself (this packet's own planning and research docs, ~90 files) is excluded from\nthis bucket for the opposite reason: it is the live plan *for* this move, not a\nrecord of the past, and stays exactly as authored.\n\n## 11. Level re-score (REQ-003)\n\n`recommend-level.sh` scores by estimated LOC/files/risk factors, not by folder path,\nso it was run against this move's estimated execution-phase scope (~450 files touched\nacross git-mv self-references + external text edits, ~900 LOC of diff, an\narchitectural/workspace-topology change):\n\n```\n$ bash .../scripts/spec/recommend-level.sh --loc 900 --files 450 --architectural --json\n{\n  \"recommended_level\": 3, \"level_name\": \"Full\", \"total_score\": 73, \"max_score\": 100,\n  \"confidence\": 82, \"recommended_phases\": true, \"phase_score\": 40,\n  \"phase_reason\": \"Architectural change + 450 files + 900 LOC + extreme scale\",\n  \"suggested_phase_count\": 3\n}\n```\n\n**Level 3 confirmed**, matching this phase's own risk note and the packet-053\nprecedent. The tool additionally recommends phase decomposition (3 suggested\nphases) given the scale — worth weighing against REQ-004's \"one atomic commit\"\nrequirement when the execution packet is scoped: the *commit* should stay atomic\nper packet-053 precedent, but the *planning documents* could still be phased\n(e.g. tree move + internal fixes / external consumer updates / verification pass)\nwithout splitting the commit itself.\n\n## 12. Foreseen conflicts for the execution phase\n\n1. **`runtime/scripts/` vs the incoming `runtime/cli/`** — resolved by the layout\n   decision (§0); no actual name collision survives, but `check-architecture-boundaries.ts`\n   references both in four nearby lines (§3) and is the one file most likely to be\n   mis-edited by a blind find-and-replace.\n2. **`workspaces: [..., \"runtime/cli\"]`** — nesting a workspace member inside\n   another member's own directory tree is not something this inventory found\n   precedent for elsewhere in this repo's own workspace configs; npm does not\n   document this as prohibited, but it should be *proven*, not assumed, via a\n   clean `npm install` + `npm ci --dry-run` at the `system-spec-kit/` root before\n   the commit is considered complete (mirroring packet 053's own verification list).\n3. **Two false positives a naive sweep would wrongly touch**: `runtime/tests/dist-freshness.vitest.ts:134`\n   and `runtime/tests/path-boundary.vitest.ts:86` both contain a bare `'scripts'`\n   literal that is unrelated to the moving workspace (§4) — confirmed safe to leave\n   alone by reading surrounding context, not by pattern alone.\n4. **The `test:task-enrichment` root script's `--config` path** (§6) has a cwd\n   ambiguity that may predate this move; resolve by running it, not by assumption.\n5. **`scripts/runtime` symlink's continued necessity** (§6) is a real open question\n   (`DEFAULT_EXCLUDED_SEGMENTS` may already make it redundant) but resolving that\n   is a behavior decision outside a path-rename-only phase — repoint it, do not\n   remove it, unless the operator explicitly widens scope.","lineStart":1,"lineEnd":376,"totalLines":376,"truncated":false}},"title":".opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/inventory.md","time":{"start":1788632067553,"end":1788632067596}},"id":"prt_072c76de10018iRJiSArD3oNFX","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c73059001wc3JHFtgXcDaup"}}
{"type":"tool_use","timestamp":1788632067605,"sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","part":{"type":"tool","tool":"read","callID":"call_HAW4HqAbPrVmrPZwrmNVovus","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/path-map.json","offset":1,"limit":400},"output":"<path>/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/specs/system-speckit/054-decommission-debt-fixes/002-scripts-into-runtime-nesting/scratch/path-map.json</path>\n<type>file</type>\n<content>\n1: {\n2:   \"_comment\": \"Stage-2 consumption map for packet 054/002. Apply directory_move first (git mv), then string_replacements over the files it lists (never over dist/, node_modules/, specs/, or any changelog/ or benchmark/ directory), then hand-fix special_cases individually — none of them is a safe mechanical sed. See scratch/inventory.md for the evidence behind every row.\",\n3:   \"decision\": \"runtime/cli\",\n4:   \"directory_move\": {\n5:     \"old\": \".opencode/skills/system-spec-kit/scripts\",\n6:     \"new\": \".opencode/skills/system-spec-kit/runtime/cli\",\n7:     \"method\": \"git mv\",\n8:     \"collision_check\": \"runtime/cli does not exist yet (verified); runtime/scripts (build tooling: finalize-dist.mjs, run-tests.mjs, run-tests-sharded.mjs, tests/) is untouched by this move and must not be conflated with it\"\n9:   },\n10:   \"string_replacements\": [\n11:     {\n12:       \"pattern\": \".opencode/skills/system-spec-kit/scripts/\",\n13:       \"replacement\": \".opencode/skills/system-spec-kit/runtime/cli/\",\n14:       \"scope\": \"repo-wide text search, excluding: specs/**, any changelog/ or benchmark/ directory at any depth, node_modules/**, dist/**, z_archive/**, .worktrees/**, barter/**\",\n15:       \"applies_to_file_count\": 447,\n16:       \"notes\": \"The bulk mechanical rule. Covers CLAUDE.md, AGENTS.md, README.md, CONTRIBUTING.md, .gitignore, .github/workflows/*, .opencode/commands/**, .opencode/agents/*.md (canonical mirror sources), .opencode/bin/*, .opencode/hooks/**, .opencode/plugins/*, .opencode/install-guides/README.md, and every skill doc listed in inventory.md section 1's area table. Does NOT cover the resolution-only findings in inventory.md sections 3-5 (segmented path.join/resolve calls, bare 'scripts' literals, __dirname depth climbers, the runtime/-descend flip) -- those need the special_cases below.\"\n17:     },\n18:     {\n19:       \"pattern\": \"scripts/dist/\",\n20:       \"replacement\": \"runtime/cli/dist/\",\n21:       \"scope\": \"same exclusions as above; only where NOT already covered by the system-spec-kit/scripts/ pattern above (i.e. bare 'scripts/dist' without the system-spec-kit/ prefix, such as .opencode/bin/worktree-session.sh:85 and cwd-relative CLI invocations)\",\n22:       \"applies_to_file_count\": 142,\n23:       \"notes\": \"Large overlap with the pattern above; run system-spec-kit/scripts/ first, then this one only catches the bare-relative remainder.\"\n24:     }\n25:   ],\n26:   \"special_cases\": [\n27:     {\n28:       \"file\": \".opencode/bin/skill-advisor.cjs\",\n29:       \"line\": 24,\n30:       \"old\": \"require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'scripts', 'lib', 'dist-freshness.cjs'))\",\n31:       \"new\": \"require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'runtime', 'cli', 'lib', 'dist-freshness.cjs'))\",\n32:       \"reason\": \"segmented path.join, invisible to a literal string sed\"\n33:     },\n34:     {\n35:       \"file\": \".opencode/skills/system-spec-kit/shared/embeddings/factory.ts\",\n36:       \"line\": 248,\n37:       \"old\": \"existsSync(path.join(currentDir, 'scripts'))\",\n38:       \"new\": \"existsSync(path.join(currentDir, 'runtime', 'cli'))\",\n39:       \"reason\": \"root-detection landmark inside shared/, which must stay neutral of runtime/scripts internals per ARCHITECTURE.md's GAP A; verify this coupling is even correct post-move, not just re-pathed\"\n40:     },\n41:     {\n42:       \"file\": \".opencode/skills/system-spec-kit/runtime/lib/graph/graph-metadata-parser.ts\",\n43:       \"line\": 966,\n44:       \"old\": \"path.join(systemSpecKitRoot, 'scripts')\",\n45:       \"new\": \"path.join(systemSpecKitRoot, 'runtime', 'cli')\",\n46:       \"reason\": \"segmented path.join inside workspaceRoots[] used to resolve bare key_files paths\"\n47:     },\n48:     {\n49:       \"file\": \".opencode/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts\",\n50:       \"lines\": [74, 75, 76, 77, 229],\n51:       \"old_pattern\": \"path.join(SKILL_ROOT, 'scripts', ...) / path.resolve(SKILL_ROOT, 'scripts', scriptPath)\",\n52:       \"new_pattern\": \"path.join(SKILL_ROOT, 'runtime', 'cli', ...) / path.resolve(SKILL_ROOT, 'runtime', 'cli', scriptPath)\",\n53:       \"reason\": \"five segmented calls building validate.sh's own rule-loading core (VALIDATOR_REGISTRY_PATH, VALIDATOR_RULES_ROOT, VALIDATOR_DIST_VALIDATION_ROOT, VALIDATE_SCRIPT_DIR, dynamic script resolve) -- highest-risk file in this class\"\n54:     },\n55:     {\n56:       \"file\": \".opencode/skills/system-spec-kit/runtime/tests/env-reference-drift.vitest.ts\",\n57:       \"line\": 125,\n58:       \"old\": \"resolve(SYSTEM_SPEC_KIT_ROOT, 'scripts')\",\n59:       \"new\": \"resolve(SYSTEM_SPEC_KIT_ROOT, 'runtime', 'cli')\",\n60:       \"reason\": \"segmented resolve\"\n61:     },\n62:     {\n63:       \"file\": \".opencode/skills/system-spec-kit/runtime/tests/validation-orchestrator-bridge.vitest.ts\",\n64:       \"line\": 100,\n65:       \"old\": \"path.join(SKILL_ROOT, 'scripts', 'dist', 'validation', 'continuity-freshness.js')\",\n66:       \"new\": \"path.join(SKILL_ROOT, 'runtime', 'cli', 'dist', 'validation', 'continuity-freshness.js')\",\n67:       \"reason\": \"segmented path.join\"\n68:     },\n69:     {\n70:       \"file\": \".opencode/skills/system-spec-kit/scripts/evals/check-architecture-boundaries.ts\",\n71:       \"lines\": [53, 154, 163],\n72:       \"old\": \"'scripts' as bare literal in REQUIRED_ROOT_DIRS and isProhibitedForShared()'s two path.join(packageRoot,'scripts') calls\",\n73:       \"new\": \"REQUIRED_ROOT_DIRS entry and both path.join calls become 'runtime','cli' (as a joined segment pair, not a single string)\",\n74:       \"do_not_touch_line\": 404,\n75:       \"do_not_touch_reason\": \"line 404's wrappersDir = path.join(resolvedRoot,'runtime','scripts') references the OTHER scripts -- runtime's own build-tooling dir, which this move does not rename\"\n76:     },\n77:     {\n78:       \"file\": \".opencode/skills/system-spec-kit/scripts/lib/dist-freshness.cjs\",\n79:       \"lines\": [21, 33, 35, 41],\n80:       \"changes\": [\n81:         { \"line\": 21, \"field\": \"WORKSPACE_ROOT\", \"old\": \"path.resolve(__dirname, '..','..','..','..','..')\", \"new\": \"path.resolve(__dirname, '..','..','..','..','..','..')\", \"reason\": \"fixed-depth repo-root climb, +1 level after the move\" },\n82:         { \"line\": 33, \"field\": \"DIST_PACKAGES[1].id\", \"old\": \"system-spec-kit/scripts\", \"new\": \"system-spec-kit/runtime/cli\", \"reason\": \"recommended rename to match sibling id convention; sole consumer scripts/tests/dist-freshness-walker.vitest.ts:35 moves with it\" },\n83:         { \"line\": 35, \"field\": \"DIST_PACKAGES[1].root\", \"old\": \".opencode/skills/system-spec-kit/scripts\", \"new\": \".opencode/skills/system-spec-kit/runtime/cli\", \"reason\": \"mechanical\" },\n84:         { \"line\": 41, \"field\": \"DIST_PACKAGES[1].rebuildCommand\", \"old\": \"cd .opencode/skills/system-spec-kit/scripts && npm run build\", \"new\": \"cd .opencode/skills/system-spec-kit/runtime/cli && npm run build\", \"reason\": \"mechanical\" }\n85:       ]\n86:     },\n87:     {\n88:       \"file\": \".opencode/skills/system-spec-kit/scripts/tests/dist-freshness-walker.vitest.ts\",\n89:       \"line\": 35,\n90:       \"old\": \"DIST_PACKAGES.find((entry) => entry.id === 'system-spec-kit/scripts')\",\n91:       \"new\": \"DIST_PACKAGES.find((entry) => entry.id === 'system-spec-kit/runtime/cli')\",\n92:       \"reason\": \"must match the id rename above, in the same commit\"\n93:     },\n94:     {\n95:       \"file\": \".opencode/skills/system-spec-kit/runtime/hooks/claude/session-stop.ts\",\n96:       \"lines\": [73, 74, 75, 76],\n97:       \"changes\": [\n98:         { \"line\": 73, \"old\": \"resolve(HOOK_DIR, '../../../scripts/dist/memory/generate-context.js')\", \"new\": \"resolve(HOOK_DIR, '../../cli/dist/memory/generate-context.js')\", \"reason\": \"source-execution candidate: 3 ups reached system-spec-kit then descended scripts/; now 2 ups reaches runtime directly, descend cli/\" },\n99:         { \"line\": 74, \"old\": \"resolve(HOOK_DIR, '../../../../scripts/dist/memory/generate-context.js')\", \"new\": \"resolve(HOOK_DIR, '../../../cli/dist/memory/generate-context.js')\", \"reason\": \"dist-execution candidate: 4 ups reached system-spec-kit then descended scripts/; now 3 ups reaches runtime directly, descend cli/\" },\n100:         { \"line\": 75, \"old\": \"resolve(process.cwd(), '.opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js')\", \"new\": \"resolve(process.cwd(), '.opencode/skills/system-spec-kit/runtime/cli/dist/memory/generate-context.js')\", \"reason\": \"mechanical\" },\n101:         { \"line\": 76, \"old\": \"resolve(process.cwd(), 'scripts/dist/memory/generate-context.js')\", \"new\": \"resolve(process.cwd(), 'runtime/cli/dist/memory/generate-context.js')\", \"reason\": \"mechanical, assumes cwd already inside system-spec-kit/\" }\n102:       ]\n103:     },\n104:     {\n105:       \"file\": \".opencode/skills/system-spec-kit/package.json\",\n106:       \"field\": \"workspaces\",\n107:       \"old\": [\"shared\", \"runtime\", \"scripts\"],\n108:       \"new\": [\"shared\", \"runtime\", \"runt