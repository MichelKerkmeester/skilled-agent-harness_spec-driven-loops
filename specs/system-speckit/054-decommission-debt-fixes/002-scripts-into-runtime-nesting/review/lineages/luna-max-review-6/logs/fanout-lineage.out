legation.md',\n86:   'research/research.md',\n87:   'before-after.md',\n88:   'timeline.md',\n89:   'roadmap.md',\n90: ]);\n91: const REQUIRED_FRONTMATTER_KEYS = ['packet_pointer', 'last_updated_at', 'last_updated_by', 'recent_action', 'next_safe_action'];\n92: const REQUIRED_SCALAR_FRONTMATTER_FIELDS = ['title', 'description', 'importance_tier', 'contextType'];\n93: const SCALAR_FRONTMATTER_DOCS = ['spec.md', 'plan.md', 'tasks.md', 'decision-record.md', 'implementation-summary.md'];\n94: // Named in the report so a verdict can be attributed to what produced it.\n95: const ENGINE_NAME = 'orchestrator';\n96: const CHECKLIST_H1_PREFIX = '# Verification Checklist:';\n97: const OPTIONAL_TEMPLATE_HEADER_RE = /^(?:L(?:2|3\\+?)|FIX ADDENDUM)\\s*:/iu;\n98: const OPTIONAL_TEMPLATE_ANCHORS = new Set(['affected-surfaces', 'nfr', 'edge-cases', 'complexity', 'phase-deps', 'effort', 'enhanced-rollback']);\n99: \n100: /** Severity a validator-registry rule is declared at (`skip` disables it entirely). */\n101: export type RegistrySeverity = 'error' | 'warn' | 'info' | 'skip';\n102: \n103: /** One rule entry from the shell-based validator registry. */\n104: export interface ValidatorRegistryEntry {\n105:   rule_id: string;\n106:   script_path: string;\n107:   severity: RegistrySeverity;\n108:   strict_only?: boolean;\n109:   aliases?: string[];\n110: }\n111: \n112: interface ShellRuleOutput {\n113:   rule: string;\n114:   status: string;\n115:   message: string;\n116:   details: string[];\n117:   // Present only for rules that emit a `code\\t...` bridge line (currently\n118:   // CONTINUITY_FRESHNESS). Carries the rule's own result code alongside its\n119:   // mapped pass/warn/fail status so an attestation-gap skip stays\n120:   // distinguishable from a genuinely verified pass in the report, without\n121:   // changing that mapped status.\n122:   code?: string;\n123: }\n124: \n125: const REGISTRY_SHELL_RULE_WRAPPER = String.raw`set -euo pipefail\n126: folder=\"$1\"\n127: level=\"$2\"\n128: rule_script=\"$3\"\n129: rule_id=\"$4\"\n130: STRICT_MODE=\"$5\"\n131: validate_script_dir=\"$6\"\n132: \n133: RULES_DIR=\"$validate_script_dir/../rules\"\n134: VALIDATOR_REGISTRY_JSON=\"$validate_script_dir/../lib/validator-registry.json\"\n135: JSON_MODE=false\n136: QUIET_MODE=false\n137: VERBOSE=false\n138: LEVEL_METHOD=\"inferred\"\n139: DETECTED_LEVEL=\"$level\"\n140: RULE_NAME=\"\"\n141: RULE_STATUS=\"pass\"\n142: RULE_MESSAGE=\"\"\n143: RULE_DETAILS=()\n144: RULE_REMEDIATION=\"\"\n145: \n146: source \"$validate_script_dir/../lib/shell-common.sh\"\n147: source \"$rule_script\"\n148: \n149: if ! type run_check >/dev/null 2>&1; then\n150:   printf 'rule\\t%s\\n' \"$rule_id\"\n151:   printf 'status\\tfail\\n'\n152:   printf 'message\\tRule script has no run_check function\\n'\n153:   exit 0\n154: fi\n155: \n156: if [[ \"$(basename \"$rule_script\")\" == \"check-canonical-save.sh\" ]]; then\n157:   SPECKIT_CANONICAL_SAVE_RULE=\"$rule_id\"\n158:   run_check \"$folder\" \"$level\" \"$rule_id\"\n159:   unset SPECKIT_CANONICAL_SAVE_RULE\n160: else\n161:   run_check \"$folder\" \"$level\"\n162: fi\n163: \n164: printf 'rule\\t%s\\n' \"${'${'}RULE_NAME:-$rule_id}\"\n165: printf 'status\\t%s\\n' \"${'${'}RULE_STATUS:-pass}\"\n166: printf 'message\\t%s\\n' \"${'${'}RULE_MESSAGE:-OK}\"\n167: if [[ -n \"${'${'}RULE_DETAILS[*]-}\" ]]; then\n168:   for detail in \"${'${'}RULE_DETAILS[@]}\"; do\n169:     printf 'detail\\t%s\\n' \"$detail\"\n170:   done\n171: fi\n172: `;\n173: \n174: function normalizeLevel(raw: string): SpecKitLevel {\n175:   if (raw === '3+') return '3+';\n176:   if (raw === 'phase' || raw === 'phase-parent') return 'phase';\n177:   if (raw === 'review') return 'review';\n178:   if (raw === 'research') return 'research';\n179:   if (raw === '1' || raw === '2' || raw === '3') return raw;\n180:   throw new Error(`Unsupported spec kit level: ${raw || '(empty)'}`);\n181: }\n182: \n183: function detectLevel(folder: string): SpecKitLevel {\n184:   if (isPhaseParent(folder)) return 'phase';\n185:   const specPath = path.join(folder, 'spec.md');\n186:   if (fs.existsSync(specPath)) {\n187:     const head = fs.readFileSync(specPath, 'utf8').slice(0, 4096);\n188:     const marker = head.match(/SPECKIT_LEVEL:\\s*(1|2|3\\+?|phase|review|research)/u)?.[1];\n189:     if (marker) return normalizeLevel(marker);\n190:     const yamlLevel = head.match(/^level:\\s*(1|2|3\\+?|phase|review|research)\\s*$/mu)?.[1];\n191:     if (yamlLevel) return normalizeLevel(yamlLevel);\n192:     const tableLevel = head.match(/\\|\\s*\\*\\*Level\\*\\*\\s*\\|\\s*(1|2|3\\+?|phase|review|research)\\s*\\|/u)?.[1];\n193:     if (tableLevel) return normalizeLevel(tableLevel);\n194:   }\n195:   if (fs.existsSync(path.join(folder, 'decision-record.md'))) return '3';\n196:   const tasksPath = path.join(folder, 'tasks.md');\n197:   if (fs.existsSync(tasksPath) && fs.readFileSync(tasksPath, 'utf8').includes('<!-- ANCHOR:protocol -->')) return '2';\n198:   return '1';\n199: }\n200: \n201: function entry(rule: string, status: ValidationEntry['status'], message: string, details: string[] = []): ValidationEntry {\n202:   return { rule, status, message, details };\n203: }\n204: \n205: const PACKET_FOLDER_RE = /^\\d{3}-[a-z0-9-]+$/u;\n206: \n207: // A track sits directly inside the specs root, is named for the track rather\n208: // than numbered like a packet, and has no spec of its own — it is the drawer,\n209: // not a document in it. Requiring all three keeps a genuine packet from taking\n210: // the exemption just because of where it happens to sit.\n211: function isTrackRoot(folder: string): boolean {\n212:   const resolved = path.resolve(folder);\n213:   if (path.basename(path.dirname(resolved)) !== 'specs') return false;\n214:   if (PACKET_FOLDER_RE.test(path.basename(resolved))) return false;\n215:   return !fs.existsSync(path.join(resolved, 'spec.md'));\n216: }\n217: \n218: function isRegistryEntry(value: unknown): value is ValidatorRegistryEntry {\n219:   if (!value || typeof value !== 'object') return false;\n220:   const candidate = value as Record<string, unknown>;\n221:   const severity = candidate.severity;\n222:   return typeof candidate.rule_id === 'string'\n223:     && typeof candidate.script_path === 'string'\n224:     && (severity === 'error' || severity === 'warn' || severity === 'info' || severity === 'skip');\n225: }\n226: \n227: function readValidatorRegistry(): ValidatorRegistryEntry[] {\n228:   if (!fs.existsSync(VALIDATOR_REGISTRY_PATH)) return [];\n229:   const parsed = JSON.parse(fs.readFileSync(VALIDATOR_REGISTRY_PATH, 'utf8')) as unknown;\n230:   return Array.isArray(parsed) ? parsed.filter(isRegistryEntry) : [];\n231: }\n232: \n233: function resolveRegistryRuleScript(scriptPath: string): string | null {\n234:   if (scriptPath.startsWith('rules/') && scriptPath.endsWith('.sh')) {\n235:     const resolved = path.resolve(SKILL_ROOT, 'runtime', 'cli', scriptPath);\n236:     const rulesRoot = path.resolve(VALIDATOR_RULES_ROOT);\n237:     if (resolved !== rulesRoot && !resolved.startsWith(`${rulesRoot}${path.sep}`)) return null;\n238:     return fs.existsSync(resolved) && fs.statSync(resolved).isFile() ? resolved : null;\n239:   }\n240: \n241:   if (/^validation\\/[^/]+\\.ts$/u.test(scriptPath)) {\n242:     const compiledName = `${path.basename(scriptPath, '.ts')}.js`;\n243:     const resolved = path.resolve(VALIDATOR_DIST_VALIDATION_ROOT, compiledName);\n244:     const validationRoot = path.resolve(VALIDATOR_DIST_VALIDATION_ROOT);\n245:     if (resolved !== validationRoot && !resolved.startsWith(`${validationRoot}${path.sep}`)) return null;\n246:     return fs.existsSync(resolved) && fs.statSync(resolved).isFile() ? resolved : null;\n247:   }\n248: \n249:   return null;\n250: }\n251: \n252: function isRegistryShellRulePath(scriptPath: string): boolean {\n253:   return scriptPath.startsWith('rules/') && scriptPath.endsWith('.sh');\n254: }\n255: \n256: function isRegistryNodeRulePath(scriptPath: string): boolean {\n257:   return /^validation\\/[^/]+\\.ts$/u.test(scriptPath);\n258: }\n259: \n260: function parseShellRuleOutput(ruleId: string, output: string): ShellRuleOutput {\n261:   const parsed: ShellRuleOutput = {\n262:     rule: ruleId,\n263:     status: 'pass',\n264:     message: '',\n\n(Showing lines 55-264 of 1101. Use offset=265 to continue.)\n</content>","metadata":{"preview":"}\n\nconst MODULE_DIR = path.dirname(fileURLToPath(import.meta.url));\nfunction findSkillRoot(startDir: string): string {\n  let current = startDir;\n  for (let depth = 0; depth < 8; depth += 1) {\n    if (fs.existsSync(path.join(current, 'templates', 'spec-kit-docs.json'))) {\n      return current;\n    }\n    const parent = path.dirname(current);\n    if (parent === current) break;\n    current = parent;\n  }\n  return path.resolve(startDir, '../../..');\n}\n\nconst SKILL_ROOT = findSkillRoot(MODULE_DIR);\nconst TEMPLATE_ROOT = path.join(SKILL_ROOT, 'templates');\nconst TEMPLATE_SUBDIRECTORIES = ['core', 'addons', 'packet-types'] as const;\nconst VALIDATOR_REGISTRY_PATH = path.join(SKILL_ROOT, 'runtime', 'cli', 'lib', 'validator-registry.json');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.opencode/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts","text":"}\n\nconst MODULE_DIR = path.dirname(fileURLToPath(import.meta.url));\nfunction findSkillRoot(startDir: string): string {\n  let current = startDir;\n  for (let depth = 0; depth < 8; depth += 1) {\n    if (fs.existsSync(path.join(current, 'templates', 'spec-kit-docs.json'))) {\n      return current;\n    }\n    const parent = path.dirname(current);\n    if (parent === current) break;\n    current = parent;\n  }\n  return path.resolve(startDir, '../../..');\n}\n\nconst SKILL_ROOT = findSkillRoot(MODULE_DIR);\nconst TEMPLATE_ROOT = path.join(SKILL_ROOT, 'templates');\nconst TEMPLATE_SUBDIRECTORIES = ['core', 'addons', 'packet-types'] as const;\nconst VALIDATOR_REGISTRY_PATH = path.join(SKILL_ROOT, 'runtime', 'cli', 'lib', 'validator-registry.json');\nconst VALIDATOR_RULES_ROOT = path.join(SKILL_ROOT, 'runtime', 'cli', 'rules');\nconst VALIDATOR_DIST_VALIDATION_ROOT = path.join(SKILL_ROOT, 'runtime', 'cli', 'dist', 'validation');\nconst VALIDATE_SCRIPT_DIR = path.join(SKILL_ROOT, 'runtime', 'cli', 'spec');\nconst VALID_LEVELS = new Set<SpecKitLevel>(['1', '2', '3', '3+', 'phase', 'review', 'research']);\nconst CANONICAL_CONTINUITY_DOC = 'implementation-summary.md';\nconst OPTIONAL_CONTINUITY_DOCS = new Set([\n  'spec.md',\n  'plan.md',\n  'tasks.md',\n  'handover.md',\n  'debug-delegation.md',\n  'research/research.md',\n  'before-after.md',\n  'timeline.md',\n  'roadmap.md',\n]);\nconst REQUIRED_FRONTMATTER_KEYS = ['packet_pointer', 'last_updated_at', 'last_updated_by', 'recent_action', 'next_safe_action'];\nconst REQUIRED_SCALAR_FRONTMATTER_FIELDS = ['title', 'description', 'importance_tier', 'contextType'];\nconst SCALAR_FRONTMATTER_DOCS = ['spec.md', 'plan.md', 'tasks.md', 'decision-record.md', 'implementation-summary.md'];\n// Named in the report so a verdict can be attributed to what produced it.\nconst ENGINE_NAME = 'orchestrator';\nconst CHECKLIST_H1_PREFIX = '# Verification Checklist:';\nconst OPTIONAL_TEMPLATE_HEADER_RE = /^(?:L(?:2|3\\+?)|FIX ADDENDUM)\\s*:/iu;\nconst OPTIONAL_TEMPLATE_ANCHORS = new Set(['affected-surfaces', 'nfr', 'edge-cases', 'complexity', 'phase-deps', 'effort', 'enhanced-rollback']);\n\n/** Severity a validator-registry rule is declared at (`skip` disables it entirely). */\nexport type RegistrySeverity = 'error' | 'warn' | 'info' | 'skip';\n\n/** One rule entry from the shell-based validator registry. */\nexport interface ValidatorRegistryEntry {\n  rule_id: string;\n  script_path: string;\n  severity: RegistrySeverity;\n  strict_only?: boolean;\n  aliases?: string[];\n}\n\ninterface ShellRuleOutput {\n  rule: string;\n  status: string;\n  message: string;\n  details: string[];\n  // Present only for rules that emit a `code\\t...` bridge line (currently\n  // CONTINUITY_FRESHNESS). Carries the rule's own result code alongside its\n  // mapped pass/warn/fail status so an attestation-gap skip stays\n  // distinguishable from a genuinely verified pass in the report, without\n  // changing that mapped status.\n  code?: string;\n}\n\nconst REGISTRY_SHELL_RULE_WRAPPER = String.raw`set -euo pipefail\nfolder=\"$1\"\nlevel=\"$2\"\nrule_script=\"$3\"\nrule_id=\"$4\"\nSTRICT_MODE=\"$5\"\nvalidate_script_dir=\"$6\"\n\nRULES_DIR=\"$validate_script_dir/../rules\"\nVALIDATOR_REGISTRY_JSON=\"$validate_script_dir/../lib/validator-registry.json\"\nJSON_MODE=false\nQUIET_MODE=false\nVERBOSE=false\nLEVEL_METHOD=\"inferred\"\nDETECTED_LEVEL=\"$level\"\nRULE_NAME=\"\"\nRULE_STATUS=\"pass\"\nRULE_MESSAGE=\"\"\nRULE_DETAILS=()\nRULE_REMEDIATION=\"\"\n\nsource \"$validate_script_dir/../lib/shell-common.sh\"\nsource \"$rule_script\"\n\nif ! type run_check >/dev/null 2>&1; then\n  printf 'rule\\t%s\\n' \"$rule_id\"\n  printf 'status\\tfail\\n'\n  printf 'message\\tRule script has no run_check function\\n'\n  exit 0\nfi\n\nif [[ \"$(basename \"$rule_script\")\" == \"check-canonical-save.sh\" ]]; then\n  SPECKIT_CANONICAL_SAVE_RULE=\"$rule_id\"\n  run_check \"$folder\" \"$level\" \"$rule_id\"\n  unset SPECKIT_CANONICAL_SAVE_RULE\nelse\n  run_check \"$folder\" \"$level\"\nfi\n\nprintf 'rule\\t%s\\n' \"${'${'}RULE_NAME:-$rule_id}\"\nprintf 'status\\t%s\\n' \"${'${'}RULE_STATUS:-pass}\"\nprintf 'message\\t%s\\n' \"${'${'}RULE_MESSAGE:-OK}\"\nif [[ -n \"${'${'}RULE_DETAILS[*]-}\" ]]; then\n  for detail in \"${'${'}RULE_DETAILS[@]}\"; do\n    printf 'detail\\t%s\\n' \"$detail\"\n  done\nfi\n`;\n\nfunction normalizeLevel(raw: string): SpecKitLevel {\n  if (raw === '3+') return '3+';\n  if (raw === 'phase' || raw === 'phase-parent') return 'phase';\n  if (raw === 'review') return 'review';\n  if (raw === 'research') return 'research';\n  if (raw === '1' || raw === '2' || raw === '3') return raw;\n  throw new Error(`Unsupported spec kit level: ${raw || '(empty)'}`);\n}\n\nfunction detectLevel(folder: string): SpecKitLevel {\n  if (isPhaseParent(folder)) return 'phase';\n  const specPath = path.join(folder, 'spec.md');\n  if (fs.existsSync(specPath)) {\n    const head = fs.readFileSync(specPath, 'utf8').slice(0, 4096);\n    const marker = head.match(/SPECKIT_LEVEL:\\s*(1|2|3\\+?|phase|review|research)/u)?.[1];\n    if (marker) return normalizeLevel(marker);\n    const yamlLevel = head.match(/^level:\\s*(1|2|3\\+?|phase|review|research)\\s*$/mu)?.[1];\n    if (yamlLevel) return normalizeLevel(yamlLevel);\n    const tableLevel = head.match(/\\|\\s*\\*\\*Level\\*\\*\\s*\\|\\s*(1|2|3\\+?|phase|review|research)\\s*\\|/u)?.[1];\n    if (tableLevel) return normalizeLevel(tableLevel);\n  }\n  if (fs.existsSync(path.join(folder, 'decision-record.md'))) return '3';\n  const tasksPath = path.join(folder, 'tasks.md');\n  if (fs.existsSync(tasksPath) && fs.readFileSync(tasksPath, 'utf8').includes('<!-- ANCHOR:protocol -->')) return '2';\n  return '1';\n}\n\nfunction entry(rule: string, status: ValidationEntry['status'], message: string, details: string[] = []): ValidationEntry {\n  return { rule, status, message, details };\n}\n\nconst PACKET_FOLDER_RE = /^\\d{3}-[a-z0-9-]+$/u;\n\n// A track sits directly inside the specs root, is named for the track rather\n// than numbered like a packet, and has no spec of its own — it is the drawer,\n// not a document in it. Requiring all three keeps a genuine packet from taking\n// the exemption just because of where it happens to sit.\nfunction isTrackRoot(folder: string): boolean {\n  const resolved = path.resolve(folder);\n  if (path.basename(path.dirname(resolved)) !== 'specs') return false;\n  if (PACKET_FOLDER_RE.test(path.basename(resolved))) return false;\n  return !fs.existsSync(path.join(resolved, 'spec.md'));\n}\n\nfunction isRegistryEntry(value: unknown): value is ValidatorRegistryEntry {\n  if (!value || typeof value !== 'object') return false;\n  const candidate = value as Record<string, unknown>;\n  const severity = candidate.severity;\n  return typeof candidate.rule_id === 'string'\n    && typeof candidate.script_path === 'string'\n    && (severity === 'error' || severity === 'warn' || severity === 'info' || severity === 'skip');\n}\n\nfunction readValidatorRegistry(): ValidatorRegistryEntry[] {\n  if (!fs.existsSync(VALIDATOR_REGISTRY_PATH)) return [];\n  const parsed = JSON.parse(fs.readFileSync(VALIDATOR_REGISTRY_PATH, 'utf8')) as unknown;\n  return Array.isArray(parsed) ? parsed.filter(isRegistryEntry) : [];\n}\n\nfunction resolveRegistryRuleScript(scriptPath: string): string | null {\n  if (scriptPath.startsWith('rules/') && scriptPath.endsWith('.sh')) {\n    const resolved = path.resolve(SKILL_ROOT, 'runtime', 'cli', scriptPath);\n    const rulesRoot = path.resolve(VALIDATOR_RULES_ROOT);\n    if (resolved !== rulesRoot && !resolved.startsWith(`${rulesRoot}${path.sep}`)) return null;\n    return fs.existsSync(resolved) && fs.statSync(resolved).isFile() ? resolved : null;\n  }\n\n  if (/^validation\\/[^/]+\\.ts$/u.test(scriptPath)) {\n    const compiledName = `${path.basename(scriptPath, '.ts')}.js`;\n    const resolved = path.resolve(VALIDATOR_DIST_VALIDATION_ROOT, compiledName);\n    const validationRoot = path.resolve(VALIDATOR_DIST_VALIDATION_ROOT);\n    if (resolved !== validationRoot && !resolved.startsWith(`${validationRoot}${path.sep}`)) return null;\n    return fs.existsSync(resolved) && fs.statSync(resolved).isFile() ? resolved : null;\n  }\n\n  return null;\n}\n\nfunction isRegistryShellRulePath(scriptPath: string): boolean {\n  return scriptPath.startsWith('rules/') && scriptPath.endsWith('.sh');\n}\n\nfunction isRegistryNodeRulePath(scriptPath: string): boolean {\n  return /^validation\\/[^/]+\\.ts$/u.test(scriptPath);\n}\n\nfunction parseShellRuleOutput(ruleId: string, output: string): ShellRuleOutput {\n  const parsed: ShellRuleOutput = {\n    rule: ruleId,\n    status: 'pass',\n    message: '',","lineStart":55,"lineEnd":264,"totalLines":1101,"truncated":true}},"title":".opencode/skills/system-spec-kit/runtime/lib/validation/orchestrator.ts","time":{"start":1788632229663,"end":1788632229691}},"id":"prt_072c9e71e0010D1Bj724xxJyW6","sessionID":"ses_f8d3af518ffeLlqe3jGkU1uCSu","messageID":"msg_072c962c2001SPlxpCwovnQmU0"}}
