{"type":"tool_use","timestamp":1786253965985,"sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","part":{"type":"tool","tool":"read","callID":"call_00_ET_fSfhFNQiE0jPRkPiXlgD3020","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/tests/hook-guards.test.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/tests/hook-guards.test.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Cache Optimizer Hook Guard Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import assert from 'node:assert/strict';\n10: import { mkdtemp, rm } from 'node:fs/promises';\n11: import { tmpdir } from 'node:os';\n12: import { join } from 'node:path';\n13: import { after, before, test } from 'node:test';\n14: import { createJiti } from 'jiti';\n15: \n16: // ───────────────────────────────────────────────────────────────────\n17: // 2. TEST FIXTURES\n18: // ───────────────────────────────────────────────────────────────────\n19: \n20: type Hook = (event: any, context: any) => Promise<any> | any;\n21: \n22: let previousAgentDir: string | undefined;\n23: let agentDir: string;\n24: \n25: // Isolate registration tests from the operator's agent directory and restore it after the suite.\n26: before(async () => {\n27:   previousAgentDir = process.env.PI_CODING_AGENT_DIR;\n28:   agentDir = await mkdtemp(join(tmpdir(), 'pi-hook-guards-'));\n29:   process.env.PI_CODING_AGENT_DIR = agentDir;\n30: });\n31: \n32: after(async () => {\n33:   if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;\n34:   else process.env.PI_CODING_AGENT_DIR = previousAgentDir;\n35:   await rm(agentDir, { recursive: true, force: true });\n36: });\n37: \n38: function ownedModel(overrides: Record<string, unknown> = {}) {\n39:   return {\n40:     provider: 'deepseek',\n41:     id: 'deepseek-v4-flash',\n42:     name: 'DeepSeek V4 Flash',\n43:     api: 'openai-completions',\n44:     baseUrl: 'https://proxy.example/v1',\n45:     compat: {},\n46:     reasoning: false,\n47:     input: ['text'],\n48:     cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },\n49:     contextWindow: 128_000,\n50:     maxTokens: 4096,\n51:     ...overrides,\n52:   };\n53: }\n54: \n55: async function freshExtension() {\n56:   // Disable Jiti caching so each test observes a newly registered handler map.\n57:   const jiti = createJiti(join(process.cwd(), 'tests', 'hook-guards.test.ts'), {\n58:     interopDefault: false,\n59:     moduleCache: false,\n60:   });\n61:   const module = await jiti.import(join(process.cwd(), 'index.ts')) as any;\n62:   const handlers = new Map<string, Hook>();\n63:   const activeTools = ['read', 'edit', 'bash'];\n64:   // Supply only the host methods exercised by these guards; the tool list stays observable.\n65:   module.default({\n66:     on(name: string, handler: Hook) {\n67:       handlers.set(name, handler);\n68:     },\n69:     registerCommand() {},\n70:     registerTool() {},\n71:     getActiveTools() {\n72:       return [...activeTools];\n73:     },\n74:     setActiveTools(names: string[]) {\n75:       activeTools.splice(0, activeTools.length, ...names);\n76:     },\n77:   } as any);\n78:   return { handlers, activeTools };\n79: }\n80: \n81: function contextFor(\n82:   model: ReturnType<typeof ownedModel>,\n83:   counters: { sessionReads: number; statuses: number; notifications: number },\n84: ) {\n85:   // Count side effects because guarded handlers must not read session state or touch the UI.\n86:   return {\n87:     model,\n88:     hasUI: true,\n89:     sessionManager: {\n90:       getSessionId() {\n91:         counters.sessionReads++;\n92:         return 'hook-guard-session';\n93:       },\n94:     },\n95:     modelRegistry: { find: () => undefined, getAvailable: () => [], getAll: () => [] },\n96:     ui: {\n97:       notify() {\n98:         counters.notifications++;\n99:       },\n100:       setStatus() {\n101:         counters.statuses++;\n102:       },\n103:     },\n104:   };\n105: }\n106: \n107: // ───────────────────────────────────────────────────────────────────\n108: // 3. TESTS\n109: // ───────────────────────────────────────────────────────────────────\n110: \n111: test('session_start guard suppresses restore and status effects', async () => {\n112:   const { handlers } = await freshExtension();\n113:   const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n114:   await handlers.get('session_start')!({ reason: 'new' }, contextFor(ownedModel(), counters));\n115:   assert.equal(counters.sessionReads, 0);\n116:   assert.equal(counters.statuses, 0);\n117: });\n118: \n119: test('model_select guard suppresses compatibility and status effects', async () => {\n120:   const { handlers } = await freshExtension();\n121:   const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n122:   const model = ownedModel();\n123:   await handlers.get('model_select')!({ model }, contextFor(model, counters));\n124:   assert.equal(counters.notifications, 0);\n125:   assert.equal(counters.statuses, 0);\n126: });\n127: \n128: test('before_agent_start guard leaves the cache key global untouched', async () => {\n129:   const { handlers } = await freshExtension();\n130:   const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n131:   const context = contextFor(ownedModel(), counters);\n132:   const key = 'sentinel-cache-key';\n133:   const globalState = globalThis as typeof globalThis & { __piCacheOptimizerCacheKey__?: unknown };\n134:   const previous = globalState.__piCacheOptimizerCacheKey__;\n135:   globalState.__piCacheOptimizerCacheKey__ = key;\n136:   try {\n137:     await handlers.get('before_agent_start')!({\n138:       systemPrompt: 'stable',\n139:       systemPromptOptions: { skills: [] },\n140:     }, context);\n141:     assert.equal(globalState.__piCacheOptimizerCacheKey__, key);\n142:   } finally {\n143:     if (previous === undefined) delete globalState.__piCacheOptimizerCacheKey__;\n144:     else globalState.__piCacheOptimizerCacheKey__ = previous;\n145:   }\n146: });\n147: \n148: test('before_provider_request guard preserves the payload', async () => {\n149:   const { handlers } = await freshExtension();\n150:   const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n151:   const model = ownedModel();\n152:   const context = contextFor(model, counters);\n153:   const payload = {\n154:     prompt_cache_retention: 'long',\n155:     messages: [{ role: 'user', content: 'hello' }],\n156:   };\n157:   const before = structuredClone(payload);\n158:   const result = await handlers.get('before_provider_request')!({ payload }, context);\n159:   assert.equal(result, undefined);\n160:   assert.deepEqual(payload, before);\n161: });\n162: \n163: test('after_provider_response guard suppresses response diagnostics', async () => {\n164:   const { handlers } = await freshExtension();\n165:   const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n166:   const model = ownedModel({ compat: { supportsLongCacheRetention: true } });\n167:   await handlers.get('after_provider_response')!({\n168:     status: 400,\n169:     headers: { error: 'unsupported parameter: prompt_cache_retention' },\n170:   }, contextFor(model, counters));\n171:   assert.equal(counters.notifications, 0);\n172: });\n173: \n174: test('message_end guard suppresses cache-stat recording', async () => {\n175:   const { handlers } = await freshExtension();\n176:   const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n177:   const model = ownedModel();\n178:   await handlers.get('message_end')!({\n179:     message: {\n180:       role: 'assistant',\n181:       provider: model.provider,\n182:       model: model.id,\n183:       usage: { input: 100, cacheRead: 50, cacheWrite: 0, totalTokens: 150 },\n184:     },\n185:   }, contextFor(model, counters));\n186:   assert.equal(counters.statuses, 0);\n187: });\n\n(End of file - total 187 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Cache Optimizer Hook Guard Tests\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport assert from 'node:assert/strict';\nimport { mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { after, before, test } from 'node:test';\nimport { createJiti } from 'jiti';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. TEST FIXTURES\n// ───────────────────────────────────────────────────────────────────\n\ntype Hook = (event: any, context: any) => Promise<any> | any;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/tests/hook-guards.test.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Cache Optimizer Hook Guard Tests\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport assert from 'node:assert/strict';\nimport { mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { after, before, test } from 'node:test';\nimport { createJiti } from 'jiti';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. TEST FIXTURES\n// ───────────────────────────────────────────────────────────────────\n\ntype Hook = (event: any, context: any) => Promise<any> | any;\n\nlet previousAgentDir: string | undefined;\nlet agentDir: string;\n\n// Isolate registration tests from the operator's agent directory and restore it after the suite.\nbefore(async () => {\n  previousAgentDir = process.env.PI_CODING_AGENT_DIR;\n  agentDir = await mkdtemp(join(tmpdir(), 'pi-hook-guards-'));\n  process.env.PI_CODING_AGENT_DIR = agentDir;\n});\n\nafter(async () => {\n  if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;\n  else process.env.PI_CODING_AGENT_DIR = previousAgentDir;\n  await rm(agentDir, { recursive: true, force: true });\n});\n\nfunction ownedModel(overrides: Record<string, unknown> = {}) {\n  return {\n    provider: 'deepseek',\n    id: 'deepseek-v4-flash',\n    name: 'DeepSeek V4 Flash',\n    api: 'openai-completions',\n    baseUrl: 'https://proxy.example/v1',\n    compat: {},\n    reasoning: false,\n    input: ['text'],\n    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },\n    contextWindow: 128_000,\n    maxTokens: 4096,\n    ...overrides,\n  };\n}\n\nasync function freshExtension() {\n  // Disable Jiti caching so each test observes a newly registered handler map.\n  const jiti = createJiti(join(process.cwd(), 'tests', 'hook-guards.test.ts'), {\n    interopDefault: false,\n    moduleCache: false,\n  });\n  const module = await jiti.import(join(process.cwd(), 'index.ts')) as any;\n  const handlers = new Map<string, Hook>();\n  const activeTools = ['read', 'edit', 'bash'];\n  // Supply only the host methods exercised by these guards; the tool list stays observable.\n  module.default({\n    on(name: string, handler: Hook) {\n      handlers.set(name, handler);\n    },\n    registerCommand() {},\n    registerTool() {},\n    getActiveTools() {\n      return [...activeTools];\n    },\n    setActiveTools(names: string[]) {\n      activeTools.splice(0, activeTools.length, ...names);\n    },\n  } as any);\n  return { handlers, activeTools };\n}\n\nfunction contextFor(\n  model: ReturnType<typeof ownedModel>,\n  counters: { sessionReads: number; statuses: number; notifications: number },\n) {\n  // Count side effects because guarded handlers must not read session state or touch the UI.\n  return {\n    model,\n    hasUI: true,\n    sessionManager: {\n      getSessionId() {\n        counters.sessionReads++;\n        return 'hook-guard-session';\n      },\n    },\n    modelRegistry: { find: () => undefined, getAvailable: () => [], getAll: () => [] },\n    ui: {\n      notify() {\n        counters.notifications++;\n      },\n      setStatus() {\n        counters.statuses++;\n      },\n    },\n  };\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TESTS\n// ───────────────────────────────────────────────────────────────────\n\ntest('session_start guard suppresses restore and status effects', async () => {\n  const { handlers } = await freshExtension();\n  const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n  await handlers.get('session_start')!({ reason: 'new' }, contextFor(ownedModel(), counters));\n  assert.equal(counters.sessionReads, 0);\n  assert.equal(counters.statuses, 0);\n});\n\ntest('model_select guard suppresses compatibility and status effects', async () => {\n  const { handlers } = await freshExtension();\n  const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n  const model = ownedModel();\n  await handlers.get('model_select')!({ model }, contextFor(model, counters));\n  assert.equal(counters.notifications, 0);\n  assert.equal(counters.statuses, 0);\n});\n\ntest('before_agent_start guard leaves the cache key global untouched', async () => {\n  const { handlers } = await freshExtension();\n  const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n  const context = contextFor(ownedModel(), counters);\n  const key = 'sentinel-cache-key';\n  const globalState = globalThis as typeof globalThis & { __piCacheOptimizerCacheKey__?: unknown };\n  const previous = globalState.__piCacheOptimizerCacheKey__;\n  globalState.__piCacheOptimizerCacheKey__ = key;\n  try {\n    await handlers.get('before_agent_start')!({\n      systemPrompt: 'stable',\n      systemPromptOptions: { skills: [] },\n    }, context);\n    assert.equal(globalState.__piCacheOptimizerCacheKey__, key);\n  } finally {\n    if (previous === undefined) delete globalState.__piCacheOptimizerCacheKey__;\n    else globalState.__piCacheOptimizerCacheKey__ = previous;\n  }\n});\n\ntest('before_provider_request guard preserves the payload', async () => {\n  const { handlers } = await freshExtension();\n  const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n  const model = ownedModel();\n  const context = contextFor(model, counters);\n  const payload = {\n    prompt_cache_retention: 'long',\n    messages: [{ role: 'user', content: 'hello' }],\n  };\n  const before = structuredClone(payload);\n  const result = await handlers.get('before_provider_request')!({ payload }, context);\n  assert.equal(result, undefined);\n  assert.deepEqual(payload, before);\n});\n\ntest('after_provider_response guard suppresses response diagnostics', async () => {\n  const { handlers } = await freshExtension();\n  const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n  const model = ownedModel({ compat: { supportsLongCacheRetention: true } });\n  await handlers.get('after_provider_response')!({\n    status: 400,\n    headers: { error: 'unsupported parameter: prompt_cache_retention' },\n  }, contextFor(model, counters));\n  assert.equal(counters.notifications, 0);\n});\n\ntest('message_end guard suppresses cache-stat recording', async () => {\n  const { handlers } = await freshExtension();\n  const counters = { sessionReads: 0, statuses: 0, notifications: 0 };\n  const model = ownedModel();\n  await handlers.get('message_end')!({\n    message: {\n      role: 'assistant',\n      provider: model.provider,\n      model: model.id,\n      usage: { input: 100, cacheRead: 50, cacheWrite: 0, totalTokens: 150 },\n    },\n  }, contextFor(model, counters));\n  assert.equal(counters.statuses, 0);\n});","lineStart":1,"lineEnd":187,"totalLines":187,"truncated":false}},"title":".pi/extensions/pi-cache-optimizer/tests/hook-guards.test.ts","time":{"start":1786253965979,"end":1786253965984}},"id":"prt_fe50879b0001EYlMmivmrA61Fz","sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","messageID":"msg_fe5086b56001L5RgsnGDoQBd1p"}}
{"type":"tool_use","timestamp":1786253966241,"sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","part":{"type":"tool","tool":"read","callID":"call_01_ET_Acp6rwqzLhlgXJzfFh1U1967","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/tests/ownership-composition.test.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/tests/ownership-composition.test.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Cache Optimizer Ownership Composition Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import assert from 'node:assert/strict';\n10: import { readFileSync } from 'node:fs';\n11: import { mkdtemp, rm } from 'node:fs/promises';\n12: import { tmpdir } from 'node:os';\n13: import { join } from 'node:path';\n14: import { after, before, describe, test } from 'node:test';\n15: import { createJiti } from 'jiti';\n16: \n17: import type { OwnershipFixture } from '../../shared/composition/one-owner.js';\n18: \n19: // ───────────────────────────────────────────────────────────────────\n20: // 2. TEST FIXTURES\n21: // ───────────────────────────────────────────────────────────────────\n22: \n23: // Keep both forks pointed at one fixture so their ownership decisions cannot drift silently.\n24: const fixture = JSON.parse(\n25:   readFileSync(join(process.cwd(), '..', 'shared', 'deepseek-ownership.json'), 'utf8'),\n26: ) as OwnershipFixture;\n27: \n28: let previousAgentDir: string | undefined;\n29: let agentDir: string;\n30: \n31: async function prepareAgentDir() {\n32:   // Extension loading reads process-scoped configuration, so each suite uses an isolated directory.\n33:   previousAgentDir = process.env.PI_CODING_AGENT_DIR;\n34:   agentDir = await mkdtemp(join(tmpdir(), 'pi-ownership-composition-'));\n35:   process.env.PI_CODING_AGENT_DIR = agentDir;\n36: }\n37: \n38: async function restoreAgentDir() {\n39:   if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;\n40:   else process.env.PI_CODING_AGENT_DIR = previousAgentDir;\n41:   await rm(agentDir, { recursive: true, force: true });\n42: }\n43: \n44: before(prepareAgentDir);\n45: after(restoreAgentDir);\n46: \n47: async function loadCrossForkModules() {\n48:   // Disable Jiti caching so both forks and the shared composition helper load fresh for each test.\n49:   const jiti = createJiti(join(process.cwd(), 'tests', 'ownership-composition.test.ts'), {\n50:     interopDefault: false,\n51:     moduleCache: false,\n52:   });\n53:   const deepPi = await jiti.import(join(process.cwd(), '..', 'deep-pi', 'extensions', 'deeppi.ts'));\n54:   const eligibility = await jiti.import(\n55:     join(process.cwd(), '..', 'deep-pi', 'extensions', 'deeppi', 'eligibility.ts'),\n56:   );\n57:   const fakePi = await jiti.import(join(process.cwd(), '..', 'deep-pi', 'tests', 'fake-pi.ts'));\n58:   const composition = await jiti.import(\n59:     join(process.cwd(), '..', 'shared', 'composition', 'one-owner.ts'),\n60:   );\n61:   const optimizer = await jiti.import(join(process.cwd(), '..', 'pi-cache-optimizer', 'index.ts'));\n62:   return { deepPi, eligibility, fakePi, composition, optimizer } as any;\n63: }\n64: \n65: function runtimeModel(model: { provider: string; id: string }) {\n66:   return {\n67:     ...model,\n68:     name: model.id,\n69:     api: 'openai-completions',\n70:     baseUrl: 'https://proxy.example/v1',\n71:     compat: {},\n72:     reasoning: false,\n73:     input: ['text'],\n74:     cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },\n75:     contextWindow: 128_000,\n76:     maxTokens: 4096,\n77:   };\n78: }\n79: \n80: // ───────────────────────────────────────────────────────────────────\n81: // 3. TESTS\n82: // ───────────────────────────────────────────────────────────────────\n83: \n84: describe('DeepSeek ownership contract', () => {\n85:   test('keeps both real predicates aligned with the shared fixture', async () => {\n86:     const { eligibility, optimizer } = await loadCrossForkModules();\n87:     for (const model of fixture.owned) {\n88:       assert.equal(eligibility.isDeepPiModel(model), true, `${model.provider}/${model.id}`);\n89:       assert.equal(\n90:         optimizer.__internals_for_tests.isDeepPiOwned(model),\n91:         true,\n92:         `${model.provider}/${model.id}`,\n93:       );\n94:     }\n95:     for (const model of fixture.excluded) {\n96:       assert.equal(eligibility.isDeepPiModel(model), false, `${model.provider}/${model.id}`);\n97:       assert.equal(\n98:         optimizer.__internals_for_tests.isDeepPiOwned(model),\n99:         false,\n100:         `${model.provider}/${model.id}`,\n101:       );\n102:     }\n103:   });\n104: \n105:   test('composes one owner from both real predicates', async () => {\n106:     const { eligibility, composition, optimizer } = await loadCrossForkModules();\n107:     const results = composition.composeOneOwner(\n108:       fixture,\n109:       eligibility.isDeepPiModel,\n110:       optimizer.__internals_for_tests.isDeepPiOwned,\n111:     );\n112: \n113:     for (const result of results) {\n114:       assert.deepEqual(result.actualOwners, [result.expectedOwner], result.modelId);\n115:     }\n116:   });\n117: \n118:   test('observes exactly one extension reacting in the combined host', async () => {\n119:     const { deepPi, fakePi, optimizer } = await loadCrossForkModules();\n120:     for (const model of [...fixture.owned, ...fixture.excluded]) {\n121:       const fake = new fakePi.FakePi();\n122:       deepPi.default(fake.asExtensionAPI());\n123:       optimizer.default(fake.asExtensionAPI());\n124:       const ctx = fakePi.fakeContext(runtimeModel(model));\n125: \n126:       await fake.emit('session_start', { reason: 'new' }, ctx);\n127:       await fake.emit('model_select', { model: runtimeModel(model) }, ctx);\n128: \n129:       const modelId = `${model.provider}/${model.id}`;\n130:       if (fixture.owned.some((entry) => `${entry.provider}/${entry.id}` === modelId)) {\n131:         assert.ok(fake.activeTools.includes('edit_lines'), modelId);\n132:         assert.equal(ctx.statuses.get('deeppi'), 'DeepPi · warming', modelId);\n133:         assert.equal(ctx.statuses.get('pi-cache-stats'), undefined, modelId);\n134:       } else {\n135:         assert.equal(fake.activeTools.includes('edit_lines'), false, modelId);\n136:         assert.equal(ctx.statuses.get('deeppi'), undefined, modelId);\n137:         assert.equal(typeof ctx.statuses.get('pi-cache-stats'), 'string', modelId);\n138:       }\n139:     }\n140:   });\n141: });\n\n(End of file - total 141 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Cache Optimizer Ownership Composition Tests\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { after, before, describe, test } from 'node:test';\nimport { createJiti } from 'jiti';\n\nimport type { OwnershipFixture } from '../../shared/composition/one-owner.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. TEST FIXTURES","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/tests/ownership-composition.test.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Cache Optimizer Ownership Composition Tests\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { after, before, describe, test } from 'node:test';\nimport { createJiti } from 'jiti';\n\nimport type { OwnershipFixture } from '../../shared/composition/one-owner.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. TEST FIXTURES\n// ───────────────────────────────────────────────────────────────────\n\n// Keep both forks pointed at one fixture so their ownership decisions cannot drift silently.\nconst fixture = JSON.parse(\n  readFileSync(join(process.cwd(), '..', 'shared', 'deepseek-ownership.json'), 'utf8'),\n) as OwnershipFixture;\n\nlet previousAgentDir: string | undefined;\nlet agentDir: string;\n\nasync function prepareAgentDir() {\n  // Extension loading reads process-scoped configuration, so each suite uses an isolated directory.\n  previousAgentDir = process.env.PI_CODING_AGENT_DIR;\n  agentDir = await mkdtemp(join(tmpdir(), 'pi-ownership-composition-'));\n  process.env.PI_CODING_AGENT_DIR = agentDir;\n}\n\nasync function restoreAgentDir() {\n  if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;\n  else process.env.PI_CODING_AGENT_DIR = previousAgentDir;\n  await rm(agentDir, { recursive: true, force: true });\n}\n\nbefore(prepareAgentDir);\nafter(restoreAgentDir);\n\nasync function loadCrossForkModules() {\n  // Disable Jiti caching so both forks and the shared composition helper load fresh for each test.\n  const jiti = createJiti(join(process.cwd(), 'tests', 'ownership-composition.test.ts'), {\n    interopDefault: false,\n    moduleCache: false,\n  });\n  const deepPi = await jiti.import(join(process.cwd(), '..', 'deep-pi', 'extensions', 'deeppi.ts'));\n  const eligibility = await jiti.import(\n    join(process.cwd(), '..', 'deep-pi', 'extensions', 'deeppi', 'eligibility.ts'),\n  );\n  const fakePi = await jiti.import(join(process.cwd(), '..', 'deep-pi', 'tests', 'fake-pi.ts'));\n  const composition = await jiti.import(\n    join(process.cwd(), '..', 'shared', 'composition', 'one-owner.ts'),\n  );\n  const optimizer = await jiti.import(join(process.cwd(), '..', 'pi-cache-optimizer', 'index.ts'));\n  return { deepPi, eligibility, fakePi, composition, optimizer } as any;\n}\n\nfunction runtimeModel(model: { provider: string; id: string }) {\n  return {\n    ...model,\n    name: model.id,\n    api: 'openai-completions',\n    baseUrl: 'https://proxy.example/v1',\n    compat: {},\n    reasoning: false,\n    input: ['text'],\n    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },\n    contextWindow: 128_000,\n    maxTokens: 4096,\n  };\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 3. TESTS\n// ───────────────────────────────────────────────────────────────────\n\ndescribe('DeepSeek ownership contract', () => {\n  test('keeps both real predicates aligned with the shared fixture', async () => {\n    const { eligibility, optimizer } = await loadCrossForkModules();\n    for (const model of fixture.owned) {\n      assert.equal(eligibility.isDeepPiModel(model), true, `${model.provider}/${model.id}`);\n      assert.equal(\n        optimizer.__internals_for_tests.isDeepPiOwned(model),\n        true,\n        `${model.provider}/${model.id}`,\n      );\n    }\n    for (const model of fixture.excluded) {\n      assert.equal(eligibility.isDeepPiModel(model), false, `${model.provider}/${model.id}`);\n      assert.equal(\n        optimizer.__internals_for_tests.isDeepPiOwned(model),\n        false,\n        `${model.provider}/${model.id}`,\n      );\n    }\n  });\n\n  test('composes one owner from both real predicates', async () => {\n    const { eligibility, composition, optimizer } = await loadCrossForkModules();\n    const results = composition.composeOneOwner(\n      fixture,\n      eligibility.isDeepPiModel,\n      optimizer.__internals_for_tests.isDeepPiOwned,\n    );\n\n    for (const result of results) {\n      assert.deepEqual(result.actualOwners, [result.expectedOwner], result.modelId);\n    }\n  });\n\n  test('observes exactly one extension reacting in the combined host', async () => {\n    const { deepPi, fakePi, optimizer } = await loadCrossForkModules();\n    for (const model of [...fixture.owned, ...fixture.excluded]) {\n      const fake = new fakePi.FakePi();\n      deepPi.default(fake.asExtensionAPI());\n      optimizer.default(fake.asExtensionAPI());\n      const ctx = fakePi.fakeContext(runtimeModel(model));\n\n      await fake.emit('session_start', { reason: 'new' }, ctx);\n      await fake.emit('model_select', { model: runtimeModel(model) }, ctx);\n\n      const modelId = `${model.provider}/${model.id}`;\n      if (fixture.owned.some((entry) => `${entry.provider}/${entry.id}` === modelId)) {\n        assert.ok(fake.activeTools.includes('edit_lines'), modelId);\n        assert.equal(ctx.statuses.get('deeppi'), 'DeepPi · warming', modelId);\n        assert.equal(ctx.statuses.get('pi-cache-stats'), undefined, modelId);\n      } else {\n        assert.equal(fake.activeTools.includes('edit_lines'), false, modelId);\n        assert.equal(ctx.statuses.get('deeppi'), undefined, modelId);\n        assert.equal(typeof ctx.statuses.get('pi-cache-stats'), 'string', modelId);\n      }\n    }\n  });\n});","lineStart":1,"lineEnd":141,"totalLines":141,"truncated":false}},"title":".pi/extensions/pi-cache-optimizer/tests/ownership-composition.test.ts","time":{"start":1786253966236,"end":1786253966240}},"id":"prt_fe5087ac5001lKAU8IYaOzZTbr","sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","messageID":"msg_fe5086b56001L5RgsnGDoQBd1p"}}
