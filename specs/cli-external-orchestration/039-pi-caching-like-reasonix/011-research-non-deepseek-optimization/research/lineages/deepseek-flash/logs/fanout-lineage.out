  return false;\n1487:   }\n1488: \n1489:   // Pi's built-in llama.cpp provider supplies this exact explicit compat\n1490:   // fingerprint. Provider ids are extension-overridable and models.json can add\n1491:   // cache/routing overrides, so provider id alone must never imply exemption.\n1492:   const compat = getCompat(model);\n1493:   return compat.supportsStore === false &&\n1494:     compat.supportsDeveloperRole === false &&\n1495:     compat.supportsReasoningEffort === false &&\n1496:     compat.supportsUsageInStreaming === false &&\n1497:     compat.supportsStrictMode === false &&\n1498:     compat.maxTokensField === 'max_tokens' &&\n1499:     compat.sendSessionAffinityHeaders === undefined &&\n1500:     compat.sessionAffinityFormat === undefined &&\n1501:     compat.supportsLongCacheRetention === undefined;\n1502: }\n1503: \n1504: function shouldInjectOpenAIPromptCacheKeyForModel(model: PiModel | undefined): boolean {\n1505:   return isOpenAICompatibleApi(model?.api);\n1506: }\n1507: \n1508: function collectAnthropicCacheControlsInWireOrder(payload: unknown): UnknownRecord[] {\n1509:   const record = asRecord(payload);\n1510:   if (!record) return [];\n1511: \n1512:   const controls: UnknownRecord[] = [];\n1513:   const collectFromBlock = (value: unknown): void => {\n1514:     const cacheControl = asRecord(asRecord(value)?.cache_control);\n1515:     if (cacheControl?.type === 'ephemeral') controls.push(cacheControl);\n1516:   };\n1517: \n1518:   // Anthropic processes cache breakpoints in tools → system → messages order.\n1519:   if (Array.isArray(record.tools)) {\n1520:     for (const tool of record.tools) collectFromBlock(tool);\n1521:   }\n1522:   if (Array.isArray(record.system)) {\n1523:     for (const block of record.system) collectFromBlock(block);\n1524:   }\n1525:   if (Array.isArray(record.messages)) {\n1526:     for (const message of record.messages) {\n1527:       const content = asRecord(message)?.content;\n1528:       if (!Array.isArray(content)) continue;\n1529:       for (const block of content) collectFromBlock(block);\n1530:     }\n1531:   }\n1532: \n1533:   return controls;\n1534: }\n1535: \n1536: /**\n1537:  * Anthropic requires every 1h cache breakpoint to precede every 5m breakpoint.\n1538:  * An ephemeral cache_control without ttl uses Anthropic's default 5m retention.\n1539:  * If the final serialized payload contains a short → long transition, downgrade\n1540:  * all 1h breakpoints to the default 5m so the request remains valid.\n1541:  */\n1542: function downgradeAnthropicLongCacheControls(payload: unknown): boolean {\n1543:   let changed = false;\n1544:   for (const control of collectAnthropicCacheControlsInWireOrder(payload)) {\n1545:     if (control.ttl === '1h') {\n1546:       delete control.ttl;\n1547:       changed = true;\n1548:     }\n1549:   }\n1550:   return changed;\n1551: }\n1552: \n1553: function hasAnthropicCacheTtlOrderError(message: unknown): boolean {\n1554:   const record = getAssistantRecord(message);\n1555:   if (record?.stopReason !== 'error' || typeof record.errorMessage !== 'string') return false;\n1556: \n1557:   const error = lower(record.errorMessage);\n1558:   return error.includes('cache_control') &&\n1559:     error.includes(\"ttl='1h'\") &&\n1560:     error.includes(\"ttl='5m'\") &&\n1561:     error.includes('must not come after');\n1562: }\n1563: \n1564: function normalizeAnthropicCacheControlTtlOrder(payload: unknown): boolean {\n1565:   const controls = collectAnthropicCacheControlsInWireOrder(payload);\n1566:   let seenShort = false;\n1567:   let hasInvalidLongAfterShort = false;\n1568: \n1569:   for (const control of controls) {\n1570:     const ttl = control.ttl;\n1571:     if (ttl === undefined || ttl === '5m') {\n1572:       seenShort = true;\n1573:     } else if (ttl === '1h' && seenShort) {\n1574:       hasInvalidLongAfterShort = true;\n1575:       break;\n1576:     }\n1577:   }\n1578:   if (!hasInvalidLongAfterShort) return false;\n1579: \n1580:   return downgradeAnthropicLongCacheControls(payload);\n1581: }\n1582: \n1583: function isResponsesPromptRewriteBypassApi(api: unknown): boolean {\n1584:   const value = lower(api);\n1585:   return value === 'openai-codex-responses' || value === 'openai-responses' ||\n1586:     value === 'azure-openai-responses';\n1587: }\n1588: \n1589: function isMistralConversationsApi(api: unknown): boolean {\n1590:   return lower(api) === 'mistral-conversations';\n1591: }\n1592: \n1593: function isOpenAIFamilyToken(token: string): boolean {\n1594:   return token.includes('gpt-') || token.includes('chatgpt') ||\n1595:     OPENAI_REASONING_MODEL_PATTERN.test(token);\n1596: }\n1597: \n1598: function isOpenAIFamilyModel(model: PiModel | undefined): boolean {\n1599:   return getModelIdNameTokenValues(model).some(isOpenAIFamilyToken);\n1600: }\n1601: \n1602: function isOpenAIFamilyAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n1603:   return [...getModelIdNameTokenValues(model), ...getAssistantMessageModelTokenValues(message)]\n1604:     .some(isOpenAIFamilyToken);\n1605: }\n1606: \n1607: function isClaudeLikeModel(model: PiModel | undefined): boolean {\n1608:   return hasAnyTokenContaining(getModelIdNameTokenValues(model), ['anthropic', 'claude']);\n1609: }\n1610: \n1611: function isClaudeLikeAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n1612:   return modelOrAssistantMessageHas(message, model, ['anthropic', 'claude']);\n1613: }\n1614: \n1615: function isGeminiLikeModel(model: PiModel | undefined): boolean {\n1616:   return hasAnyTokenContaining(getModelIdNameTokenValues(model), ['gemini', 'vertex']);\n1617: }\n1618: \n1619: function isGeminiLikeAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n1620:   return modelOrAssistantMessageHas(message, model, ['gemini', 'vertex']);\n1621: }\n1622: \n1623: // ── Adaptive generation model detection ────────────────────────────\n1624: \n1625: /**\n1626:  * Check whether the model id uses Anthropic's adaptive generation (thinking)\n1627:  * that requires `forceAdaptiveThinking: true` in compat.\n1628:  *\n1629:  * Adaptive-generation models (from pi-ai built-in catalog) include:\n1630:  *   claude-opus-4-6, claude-opus-4-7, claude-opus-4-8 (also dotted 4.6/4.7/4.8)\n1631:  *   claude-sonnet-4-6, claude-sonnet-5\n1632:  *   claude-fable-5\n1633:  *\n1634:  * We match broadly: opus >= 4-6, sonnet >= 4-6, fable >= 5.\n1635:  * Ids may carry date-stamp or size suffixes like \"[1M]\".\n1636:  */\n1637: const ADAPTIVE_OPUS_PATTERN =\n1638:   /(^|[\\/\\s:_-])(opus-4[.-][6-9]|opus-4-[1-9][0-9]|opus-([5-9]|[1-9][0-9]))($|[-_.:\\/\\s\\[])/i;\n1639: const ADAPTIVE_SONNET_PATTERN =\n1640:   /(^|[\\/\\s:_-])(sonnet-4[.-][6-9]|sonnet-4-[1-9][0-9]|sonnet-([5-9]|[1-9][0-9]))($|[-_.:\\/\\s\\[])/i;\n1641: const ADAPTIVE_FABLE_PATTERN = /(^|[\\/\\s:_-])fable-([5-9]|[1-9][0-9])($|[-_.:\\/\\s\\[])/i;\n1642: \n1643: function isAdaptiveGenerationModel(model: PiModel | undefined): boolean {\n1644:   if (!model) return false;\n1645:   const tokens = getModelIdNameTokenValues(model);\n1646:   return tokens.some((t) =>\n1647:     ADAPTIVE_OPUS_PATTERN.test(t) || ADAPTIVE_SONNET_PATTERN.test(t) ||\n1648:     ADAPTIVE_FABLE_PATTERN.test(t)\n1649:   );\n\n(Showing lines 1450-1649 of 9239. Use offset=1650 to continue.)\n</content>","metadata":{"preview":"  needles: string[],\n): boolean {\n  return hasAnyTokenContaining([\n    ...getModelIdNameTokenValues(model),\n    ...getAssistantMessageModelTokenValues(message),\n  ], needles);\n}\n\nfunction isDeepSeekLikeModel(model: PiModel | undefined): boolean {\n  return hasAnyTokenContaining(getModelIdNameTokenValues(model), ['deepseek']);\n}\n\nfunction isDeepPiOwned(model: PiModel | undefined): boolean {\n  return model?.provider === 'deepseek' &&\n    (model.id === 'deepseek-v4-flash' || model.id === 'deepseek-v4-pro');\n}\n\nfunction isDeepSeekLikeAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n  return modelOrAssistantMessageHas(message, model, ['deepseek']);\n}","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts","text":"  needles: string[],\n): boolean {\n  return hasAnyTokenContaining([\n    ...getModelIdNameTokenValues(model),\n    ...getAssistantMessageModelTokenValues(message),\n  ], needles);\n}\n\nfunction isDeepSeekLikeModel(model: PiModel | undefined): boolean {\n  return hasAnyTokenContaining(getModelIdNameTokenValues(model), ['deepseek']);\n}\n\nfunction isDeepPiOwned(model: PiModel | undefined): boolean {\n  return model?.provider === 'deepseek' &&\n    (model.id === 'deepseek-v4-flash' || model.id === 'deepseek-v4-pro');\n}\n\nfunction isDeepSeekLikeAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n  return modelOrAssistantMessageHas(message, model, ['deepseek']);\n}\n\nfunction isOpenAICompatibleApi(api: unknown): boolean {\n  const value = lower(api);\n  return value === 'openai-completions' || value === 'openai-responses';\n}\n\nfunction isAnthropicMessagesApi(api: unknown): boolean {\n  return lower(api) === 'anthropic-messages';\n}\n\nfunction isOpenAICompatibleProxyApi(api: unknown): boolean {\n  return lower(api) === 'openai-completions';\n}\n\nfunction isPiBuiltInLlamaCppModel(model: PiModel | undefined): boolean {\n  if (lower(model?.provider) !== 'llama.cpp' || !isOpenAICompatibleProxyApi(model?.api)) {\n    return false;\n  }\n\n  // Pi's built-in llama.cpp provider supplies this exact explicit compat\n  // fingerprint. Provider ids are extension-overridable and models.json can add\n  // cache/routing overrides, so provider id alone must never imply exemption.\n  const compat = getCompat(model);\n  return compat.supportsStore === false &&\n    compat.supportsDeveloperRole === false &&\n    compat.supportsReasoningEffort === false &&\n    compat.supportsUsageInStreaming === false &&\n    compat.supportsStrictMode === false &&\n    compat.maxTokensField === 'max_tokens' &&\n    compat.sendSessionAffinityHeaders === undefined &&\n    compat.sessionAffinityFormat === undefined &&\n    compat.supportsLongCacheRetention === undefined;\n}\n\nfunction shouldInjectOpenAIPromptCacheKeyForModel(model: PiModel | undefined): boolean {\n  return isOpenAICompatibleApi(model?.api);\n}\n\nfunction collectAnthropicCacheControlsInWireOrder(payload: unknown): UnknownRecord[] {\n  const record = asRecord(payload);\n  if (!record) return [];\n\n  const controls: UnknownRecord[] = [];\n  const collectFromBlock = (value: unknown): void => {\n    const cacheControl = asRecord(asRecord(value)?.cache_control);\n    if (cacheControl?.type === 'ephemeral') controls.push(cacheControl);\n  };\n\n  // Anthropic processes cache breakpoints in tools → system → messages order.\n  if (Array.isArray(record.tools)) {\n    for (const tool of record.tools) collectFromBlock(tool);\n  }\n  if (Array.isArray(record.system)) {\n    for (const block of record.system) collectFromBlock(block);\n  }\n  if (Array.isArray(record.messages)) {\n    for (const message of record.messages) {\n      const content = asRecord(message)?.content;\n      if (!Array.isArray(content)) continue;\n      for (const block of content) collectFromBlock(block);\n    }\n  }\n\n  return controls;\n}\n\n/**\n * Anthropic requires every 1h cache breakpoint to precede every 5m breakpoint.\n * An ephemeral cache_control without ttl uses Anthropic's default 5m retention.\n * If the final serialized payload contains a short → long transition, downgrade\n * all 1h breakpoints to the default 5m so the request remains valid.\n */\nfunction downgradeAnthropicLongCacheControls(payload: unknown): boolean {\n  let changed = false;\n  for (const control of collectAnthropicCacheControlsInWireOrder(payload)) {\n    if (control.ttl === '1h') {\n      delete control.ttl;\n      changed = true;\n    }\n  }\n  return changed;\n}\n\nfunction hasAnthropicCacheTtlOrderError(message: unknown): boolean {\n  const record = getAssistantRecord(message);\n  if (record?.stopReason !== 'error' || typeof record.errorMessage !== 'string') return false;\n\n  const error = lower(record.errorMessage);\n  return error.includes('cache_control') &&\n    error.includes(\"ttl='1h'\") &&\n    error.includes(\"ttl='5m'\") &&\n    error.includes('must not come after');\n}\n\nfunction normalizeAnthropicCacheControlTtlOrder(payload: unknown): boolean {\n  const controls = collectAnthropicCacheControlsInWireOrder(payload);\n  let seenShort = false;\n  let hasInvalidLongAfterShort = false;\n\n  for (const control of controls) {\n    const ttl = control.ttl;\n    if (ttl === undefined || ttl === '5m') {\n      seenShort = true;\n    } else if (ttl === '1h' && seenShort) {\n      hasInvalidLongAfterShort = true;\n      break;\n    }\n  }\n  if (!hasInvalidLongAfterShort) return false;\n\n  return downgradeAnthropicLongCacheControls(payload);\n}\n\nfunction isResponsesPromptRewriteBypassApi(api: unknown): boolean {\n  const value = lower(api);\n  return value === 'openai-codex-responses' || value === 'openai-responses' ||\n    value === 'azure-openai-responses';\n}\n\nfunction isMistralConversationsApi(api: unknown): boolean {\n  return lower(api) === 'mistral-conversations';\n}\n\nfunction isOpenAIFamilyToken(token: string): boolean {\n  return token.includes('gpt-') || token.includes('chatgpt') ||\n    OPENAI_REASONING_MODEL_PATTERN.test(token);\n}\n\nfunction isOpenAIFamilyModel(model: PiModel | undefined): boolean {\n  return getModelIdNameTokenValues(model).some(isOpenAIFamilyToken);\n}\n\nfunction isOpenAIFamilyAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n  return [...getModelIdNameTokenValues(model), ...getAssistantMessageModelTokenValues(message)]\n    .some(isOpenAIFamilyToken);\n}\n\nfunction isClaudeLikeModel(model: PiModel | undefined): boolean {\n  return hasAnyTokenContaining(getModelIdNameTokenValues(model), ['anthropic', 'claude']);\n}\n\nfunction isClaudeLikeAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n  return modelOrAssistantMessageHas(message, model, ['anthropic', 'claude']);\n}\n\nfunction isGeminiLikeModel(model: PiModel | undefined): boolean {\n  return hasAnyTokenContaining(getModelIdNameTokenValues(model), ['gemini', 'vertex']);\n}\n\nfunction isGeminiLikeAssistantMessage(message: unknown, model: PiModel | undefined): boolean {\n  return modelOrAssistantMessageHas(message, model, ['gemini', 'vertex']);\n}\n\n// ── Adaptive generation model detection ────────────────────────────\n\n/**\n * Check whether the model id uses Anthropic's adaptive generation (thinking)\n * that requires `forceAdaptiveThinking: true` in compat.\n *\n * Adaptive-generation models (from pi-ai built-in catalog) include:\n *   claude-opus-4-6, claude-opus-4-7, claude-opus-4-8 (also dotted 4.6/4.7/4.8)\n *   claude-sonnet-4-6, claude-sonnet-5\n *   claude-fable-5\n *\n * We match broadly: opus >= 4-6, sonnet >= 4-6, fable >= 5.\n * Ids may carry date-stamp or size suffixes like \"[1M]\".\n */\nconst ADAPTIVE_OPUS_PATTERN =\n  /(^|[\\/\\s:_-])(opus-4[.-][6-9]|opus-4-[1-9][0-9]|opus-([5-9]|[1-9][0-9]))($|[-_.:\\/\\s\\[])/i;\nconst ADAPTIVE_SONNET_PATTERN =\n  /(^|[\\/\\s:_-])(sonnet-4[.-][6-9]|sonnet-4-[1-9][0-9]|sonnet-([5-9]|[1-9][0-9]))($|[-_.:\\/\\s\\[])/i;\nconst ADAPTIVE_FABLE_PATTERN = /(^|[\\/\\s:_-])fable-([5-9]|[1-9][0-9])($|[-_.:\\/\\s\\[])/i;\n\nfunction isAdaptiveGenerationModel(model: PiModel | undefined): boolean {\n  if (!model) return false;\n  const tokens = getModelIdNameTokenValues(model);\n  return tokens.some((t) =>\n    ADAPTIVE_OPUS_PATTERN.test(t) || ADAPTIVE_SONNET_PATTERN.test(t) ||\n    ADAPTIVE_FABLE_PATTERN.test(t)\n  );","lineStart":1450,"lineEnd":1649,"totalLines":9239,"truncated":true}},"title":".pi/extensions/pi-cache-optimizer/index.ts","time":{"start":1786253457939,"end":1786253457947}},"id":"prt