{"type":"tool_use","timestamp":1786253465108,"sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","part":{"type":"tool","tool":"read","callID":"call_00_h4UTbbWtZW6jM0wyfFGx2456","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts","limit":220,"offset":2860},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts</path>\n<type>file</type>\n<content>\n2860:     `💡 pi-cache-optimizer: ${key} is a third-party GPT/OpenAI-compatible proxy but merged compat lacks ${\n2861:       missing.join(' and ')\n2862:     }.`,\n2863:     `Edit ${modelsJsonPath} -> providers[\"${providerLabel}\"] -> compat (at the same level as baseUrl/api/apiKey/models).`,\n2864:     ``,\n2865:   ];\n2866: \n2867:   appendOpenAIProxyCompatAdviceLines(lines, missing, { providerLabel, modelId });\n2868: \n2869:   return lines.join('\\n');\n2870: }\n2871: \n2872: function describeMissingDeepSeekCompat(model: PiModel): string[] {\n2873:   const compat = getCompat(model);\n2874:   const missing: string[] = [];\n2875: \n2876:   if (compat.supportsLongCacheRetention !== true) {\n2877:     missing.push('supportsLongCacheRetention');\n2878:   }\n2879:   if (model.api !== 'openai-responses' && compat.sendSessionAffinityHeaders !== true) {\n2880:     missing.push('sendSessionAffinityHeaders');\n2881:   }\n2882:   if (compat.requiresReasoningContentOnAssistantMessages !== true) {\n2883:     missing.push('requiresReasoningContentOnAssistantMessages');\n2884:   }\n2885:   if (compat.thinkingFormat !== 'deepseek') {\n2886:     missing.push('thinkingFormat');\n2887:   }\n2888: \n2889:   return missing;\n2890: }\n2891: \n2892: function isDeepSeekCompatCheckApplicable(model: PiModel): boolean {\n2893:   return isDeepSeekLikeModel(model) && isOpenAICompatibleApi(model.api) &&\n2894:     !isPiBuiltInLlamaCppModel(model);\n2895: }\n2896: \n2897: function describeMissingCacheCompatForModel(model: PiModel): string[] {\n2898:   if (isAdaptiveThinkingCompatApplicable(model)) {\n2899:     return describeMissingAdaptiveThinkingCompat(model);\n2900:   }\n2901:   if (isDeepSeekCompatCheckApplicable(model)) {\n2902:     return describeMissingDeepSeekCompat(model);\n2903:   }\n2904:   return describeMissingOpenAICompatibleProxyCompat(model);\n2905: }\n2906: \n2907: function buildDeepSeekCompatSuggestion(missing: string[]): Record<string, unknown> {\n2908:   const suggestion: Record<string, unknown> = {};\n2909: \n2910:   if (missing.includes('supportsLongCacheRetention')) {\n2911:     suggestion.supportsLongCacheRetention = true;\n2912:   }\n2913:   if (missing.includes('sendSessionAffinityHeaders')) {\n2914:     suggestion.sendSessionAffinityHeaders = true;\n2915:   }\n2916:   if (missing.includes('requiresReasoningContentOnAssistantMessages')) {\n2917:     suggestion.requiresReasoningContentOnAssistantMessages = true;\n2918:   }\n2919:   if (missing.includes('thinkingFormat')) {\n2920:     suggestion.thinkingFormat = 'deepseek';\n2921:   }\n2922: \n2923:   return suggestion;\n2924: }\n2925: \n2926: function appendDeepSeekCompatAdviceLines(\n2927:   lines: string[],\n2928:   missing: string[],\n2929:   placement: CompatAdvicePlacement = {},\n2930: ): void {\n2931:   const suggestion = buildDeepSeekCompatSuggestion(missing);\n2932:   if (Object.keys(suggestion).length > 0) {\n2933:     lines.push('Recommended DeepSeek compat snippet:');\n2934:     lines.push(JSON.stringify(suggestion, null, 2));\n2935:   }\n2936: \n2937:   if (missing.includes('requiresReasoningContentOnAssistantMessages')) {\n2938:     lines.push(\n2939:       '- requiresReasoningContentOnAssistantMessages: true keeps replayed assistant turns compatible with DeepSeek reasoning_content requirements.',\n2940:     );\n2941:   }\n2942:   if (missing.includes('thinkingFormat')) {\n2943:     lines.push(\n2944:       '- thinkingFormat: \"deepseek\" tells Pi to use DeepSeek reasoning/thinking parameter format.',\n2945:     );\n2946:   }\n2947:   if (missing.includes('sendSessionAffinityHeaders')) {\n2948:     lines.push(\n2949:       '- sendSessionAffinityHeaders: recommended for OpenAI-compatible DeepSeek proxies when supported; it helps keep one Pi session on the same upstream/backend.',\n2950:     );\n2951:   }\n2952:   if (missing.includes('supportsLongCacheRetention')) {\n2953:     lines.push(\n2954:       '- supportsLongCacheRetention: enable for DeepSeek-compatible endpoints that support long cache retention.',\n2955:     );\n2956:   }\n2957: \n2958:   appendCredentialSafeProviderGuidance(lines, placement, suggestion);\n2959: }\n2960: \n2961: function buildDeepSeekCompatWarningText(key: string, missing: string[]): string {\n2962:   const slashIdx = key.indexOf('/');\n2963:   const providerLabel = slashIdx > 0 ? key.slice(0, slashIdx) : key;\n2964:   const modelId = slashIdx > 0 ? key.slice(slashIdx + 1) : undefined;\n2965:   const modelsJsonPath = getModelsJsonDisplayPath();\n2966:   const lines: string[] = [\n2967:     `💡 pi-cache-optimizer: ${key} is DeepSeek-like but merged compat lacks ${\n2968:       missing.join(' and ')\n2969:     }.`,\n2970:     `Proxies may reduce or hide cache hits. Edit ${modelsJsonPath} -> providers[\"${providerLabel}\"] -> compat (at the same level as baseUrl/api/apiKey/models).`,\n2971:     '',\n2972:   ];\n2973: \n2974:   appendDeepSeekCompatAdviceLines(lines, missing, { providerLabel, modelId });\n2975: \n2976:   return lines.join('\\n');\n2977: }\n2978: \n2979: // ───────────────────────────────────────────────────────────────────\n2980: // 6. CACHE PROVIDER ADAPTERS\n2981: // ───────────────────────────────────────────────────────────────────\n2982: \n2983: const CACHE_PROVIDER_ADAPTERS: CacheProviderAdapter[] = [\n2984:   {\n2985:     id: 'deepseek',\n2986:     label: 'DS cache',\n2987:     matchesModel: isDeepSeekLikeModel,\n2988:     matchesAssistantMessage(message, model) {\n2989:       if (!isAssistantMessage(message)) return false;\n2990:       return isDeepSeekLikeAssistantMessage(message, model);\n2991:     },\n2992:     normalizeUsage(message) {\n2993:       return normalizeWithFallback(message, getDeepSeekRawUsage, { allowInputOnlyPiUsage: true });\n2994:     },\n2995:     warningText(model) {\n2996:       if (!isDeepSeekCompatCheckApplicable(model)) return undefined;\n2997: \n2998:       const missing = describeMissingDeepSeekCompat(model);\n2999:       if (missing.length === 0) return undefined;\n3000: \n3001:       const key = modelKey(model);\n3002:       return buildDeepSeekCompatWarningText(key, missing);\n3003:     },\n3004:   },\n3005:   {\n3006:     id: 'claude',\n3007:     label: 'Claude cache',\n3008:     showCacheWrite: true,\n3009:     matchesModel: isClaudeLikeModel,\n3010:     matchesAssistantMessage(message, model) {\n3011:       if (!isAssistantMessage(message)) return false;\n3012:       return isClaudeLikeAssistantMessage(message, model);\n3013:     },\n3014:     normalizeUsage(message) {\n3015:       return normalizeWithFallback(message, getAnthropicRawUsage);\n3016:     },\n3017:     warningText(model) {\n3018:       if (\n3019:         !isClaudeLikeModel(model) || !isOpenAICompatibleApi(model.api) ||\n3020:         isPiBuiltInLlamaCppModel(model)\n3021:       ) return undefined;\n3022:       if (getCompat(model).cacheControlFormat === 'anthropic') return undefined;\n3023: \n3024:       return (\n3025:         `💡 Cache optimizer: ${\n3026:           modelKey(model)\n3027:         } looks Claude/Anthropic-like but OpenAI-compatible compat lacks cacheControlFormat: \"anthropic\". ` +\n3028:         'Pi may not place Anthropic cache_control breakpoints unless this endpoint supports and enables that compat flag.'\n3029:       );\n3030:     },\n3031:   },\n3032:   {\n3033:     id: 'openai',\n3034:     label: 'OpenAI cache',\n3035:     matchesModel: isOpenAIFamilyModel,\n3036:     matchesAssistantMessage(message, model) {\n3037:       if (!isAssistantMessage(message)) return false;\n3038:       return isOpenAIFamilyAssistantMessage(message, model);\n3039:     },\n3040:     normalizeUsage(message) {\n3041:       return normalizeWithFallback(message, getOpenAIRawUsage);\n3042:     },\n3043:     warningText(model) {\n3044:       const missing = describeMissingOpenAICompatibleProxyCompat(model);\n3045:       if (missing.length === 0) return undefined;\n3046:       return buildOpenAIProxyCompatWarningText(modelKey(model), missing);\n3047:     },\n3048:   },\n3049:   {\n3050:     id: 'gemini',\n3051:     label: 'Gemini cache',\n3052:     matchesModel: isGeminiLikeModel,\n3053:     matchesAssistantMessage(message, model) {\n3054:       if (!isAssistantMessage(message)) return false;\n3055:       return isGeminiLikeAssistantMessage(message, model);\n3056:     },\n3057:     normalizeUsage(message) {\n3058:       return normalizeWithFallback(message, getGeminiRawUsage);\n3059:     },\n3060:   },\n3061:   // ── Non-GPT OpenAI-compatible adapters ──────────────────────\n3062:   {\n3063:     id: 'openai',\n3064:     label: 'Kimi cache',\n3065:     matchesModel: isKimiLikeModel,\n3066:     matchesAssistantMessage(message, model) {\n3067:       if (!isAssistantMessage(message)) return false;\n3068:       return isKimiLikeAssistantMessage(message, model);\n3069:     },\n3070:     normalizeUsage(message) {\n3071:       return normalizeWithFallback(message, getOpenAIRawUsage);\n3072:     },\n3073:     warningText(model) {\n3074:       const missing = describeMissingOpenAICompatibleProxyCompat(model);\n3075:       if (missing.length === 0) return undefined;\n3076:       return buildOpenAIProxyCompatWarningText(modelKey(model), missing);\n3077:     },\n3078:   },\n3079:   {\n\n(Showing lines 2860-3079 of 9239. Use offset=3080 to continue.)\n</content>","metadata":{"preview":"    `💡 pi-cache-optimizer: ${key} is a third-party GPT/OpenAI-compatible proxy but merged compat lacks ${\n      missing.join(' and ')\n    }.`,\n    `Edit ${modelsJsonPath} -> providers[\"${providerLabel}\"] -> compat (at the same level as baseUrl/api/apiKey/models).`,\n    ``,\n  ];\n\n  appendOpenAIProxyCompatAdviceLines(lines, missing, { providerLabel, modelId });\n\n  return lines.join('\\n');\n}\n\nfunction describeMissingDeepSeekCompat(model: PiModel): string[] {\n  const compat = getCompat(model);\n  const missing: string[] = [];\n\n  if (compat.supportsLongCacheRetention !== true) {\n    missing.push('supportsLongCacheRetention');\n  }\n  if (model.api !== 'openai-responses' && compat.sendSessionAffinityHeaders !== true) {","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts","text":"    `💡 pi-cache-optimizer: ${key} is a third-party GPT/OpenAI-compatible proxy but merged compat lacks ${\n      missing.join(' and ')\n    }.`,\n    `Edit ${modelsJsonPath} -> providers[\"${providerLabel}\"] -> compat (at the same level as baseUrl/api/apiKey/models).`,\n    ``,\n  ];\n\n  appendOpenAIProxyCompatAdviceLines(lines, missing, { providerLabel, modelId });\n\n  return lines.join('\\n');\n}\n\nfunction describeMissingDeepSeekCompat(model: PiModel): string[] {\n  const compat = getCompat(model);\n  const missing: string[] = [];\n\n  if (compat.supportsLongCacheRetention !== true) {\n    missing.push('supportsLongCacheRetention');\n  }\n  if (model.api !== 'openai-responses' && compat.sendSessionAffinityHeaders !== true) {\n    missing.push('sendSessionAffinityHeaders');\n  }\n  if (compat.requiresReasoningContentOnAssistantMessages !== true) {\n    missing.push('requiresReasoningContentOnAssistantMessages');\n  }\n  if (compat.thinkingFormat !== 'deepseek') {\n    missing.push('thinkingFormat');\n  }\n\n  return missing;\n}\n\nfunction isDeepSeekCompatCheckApplicable(model: PiModel): boolean {\n  return isDeepSeekLikeModel(model) && isOpenAICompatibleApi(model.api) &&\n    !isPiBuiltInLlamaCppModel(model);\n}\n\nfunction describeMissingCacheCompatForModel(model: PiModel): string[] {\n  if (isAdaptiveThinkingCompatApplicable(model)) {\n    return describeMissingAdaptiveThinkingCompat(model);\n  }\n  if (isDeepSeekCompatCheckApplicable(model)) {\n    return describeMissingDeepSeekCompat(model);\n  }\n  return describeMissingOpenAICompatibleProxyCompat(model);\n}\n\nfunction buildDeepSeekCompatSuggestion(missing: string[]): Record<string, unknown> {\n  const suggestion: Record<string, unknown> = {};\n\n  if (missing.includes('supportsLongCacheRetention')) {\n    suggestion.supportsLongCacheRetention = true;\n  }\n  if (missing.includes('sendSessionAffinityHeaders')) {\n    suggestion.sendSessionAffinityHeaders = true;\n  }\n  if (missing.includes('requiresReasoningContentOnAssistantMessages')) {\n    suggestion.requiresReasoningContentOnAssistantMessages = true;\n  }\n  if (missing.includes('thinkingFormat')) {\n    suggestion.thinkingFormat = 'deepseek';\n  }\n\n  return suggestion;\n}\n\nfunction appendDeepSeekCompatAdviceLines(\n  lines: string[],\n  missing: string[],\n  placement: CompatAdvicePlacement = {},\n): void {\n  const suggestion = buildDeepSeekCompatSuggestion(missing);\n  if (Object.keys(suggestion).length > 0) {\n    lines.push('Recommended DeepSeek compat snippet:');\n    lines.push(JSON.stringify(suggestion, null, 2));\n  }\n\n  if (missing.includes('requiresReasoningContentOnAssistantMessages')) {\n    lines.push(\n      '- requiresReasoningContentOnAssistantMessages: true keeps replayed assistant turns compatible with DeepSeek reasoning_content requirements.',\n    );\n  }\n  if (missing.includes('thinkingFormat')) {\n    lines.push(\n      '- thinkingFormat: \"deepseek\" tells Pi to use DeepSeek reasoning/thinking parameter format.',\n    );\n  }\n  if (missing.includes('sendSessionAffinityHeaders')) {\n    lines.push(\n      '- sendSessionAffinityHeaders: recommended for OpenAI-compatible DeepSeek proxies when supported; it helps keep one Pi session on the same upstream/backend.',\n    );\n  }\n  if (missing.includes('supportsLongCacheRetention')) {\n    lines.push(\n      '- supportsLongCacheRetention: enable for DeepSeek-compatible endpoints that support long cache retention.',\n    );\n  }\n\n  appendCredentialSafeProviderGuidance(lines, placement, suggestion);\n}\n\nfunction buildDeepSeekCompatWarningText(key: string, missing: string[]): string {\n  const slashIdx = key.indexOf('/');\n  const providerLabel = slashIdx > 0 ? key.slice(0, slashIdx) : key;\n  const modelId = slashIdx > 0 ? key.slice(slashIdx + 1) : undefined;\n  const modelsJsonPath = getModelsJsonDisplayPath();\n  const lines: string[] = [\n    `💡 pi-cache-optimizer: ${key} is DeepSeek-like but merged compat lacks ${\n      missing.join(' and ')\n    }.`,\n    `Proxies may reduce or hide cache hits. Edit ${modelsJsonPath} -> providers[\"${providerLabel}\"] -> compat (at the same level as baseUrl/api/apiKey/models).`,\n    '',\n  ];\n\n  appendDeepSeekCompatAdviceLines(lines, missing, { providerLabel, modelId });\n\n  return lines.join('\\n');\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 6. CACHE PROVIDER ADAPTERS\n// ───────────────────────────────────────────────────────────────────\n\nconst CACHE_PROVIDER_ADAPTERS: CacheProviderAdapter[] = [\n  {\n    id: 'deepseek',\n    label: 'DS cache',\n    matchesModel: isDeepSeekLikeModel,\n    matchesAssistantMessage(message, model) {\n      if (!isAssistantMessage(message)) return false;\n      return isDeepSeekLikeAssistantMessage(message, model);\n    },\n    normalizeUsage(message) {\n      return normalizeWithFallback(message, getDeepSeekRawUsage, { allowInputOnlyPiUsage: true });\n    },\n    warningText(model) {\n      if (!isDeepSeekCompatCheckApplicable(model)) return undefined;\n\n      const missing = describeMissingDeepSeekCompat(model);\n      if (missing.length === 0) return undefined;\n\n      const key = modelKey(model);\n      return buildDeepSeekCompatWarningText(key, missing);\n    },\n  },\n  {\n    id: 'claude',\n    label: 'Claude cache',\n    showCacheWrite: true,\n    matchesModel: isClaudeLikeModel,\n    matchesAssistantMessage(message, model) {\n      if (!isAssistantMessage(message)) return false;\n      return isClaudeLikeAssistantMessage(message, model);\n    },\n    normalizeUsage(message) {\n      return normalizeWithFallback(message, getAnthropicRawUsage);\n    },\n    warningText(model) {\n      if (\n        !isClaudeLikeModel(model) || !isOpenAICompatibleApi(model.api) ||\n        isPiBuiltInLlamaCppModel(model)\n      ) return undefined;\n      if (getCompat(model).cacheControlFormat === 'anthropic') return undefined;\n\n      return (\n        `💡 Cache optimizer: ${\n          modelKey(model)\n        } looks Claude/Anthropic-like but OpenAI-compatible compat lacks cacheControlFormat: \"anthropic\". ` +\n        'Pi may not place Anthropic cache_control breakpoints unless this endpoint supports and enables that compat flag.'\n      );\n    },\n  },\n  {\n    id: 'openai',\n    label: 'OpenAI cache',\n    matchesModel: isOpenAIFamilyModel,\n    matchesAssistantMessage(message, model) {\n      if (!isAssistantMessage(message)) return false;\n      return isOpenAIFamilyAssistantMessage(message, model);\n    },\n    normalizeUsage(message) {\n      return normalizeWithFallback(message, getOpenAIRawUsage);\n    },\n    warningText(model) {\n      const missing = describeMissingOpenAICompatibleProxyCompat(model);\n      if (missing.length === 0) return undefined;\n      return buildOpenAIProxyCompatWarningText(modelKey(model), missing);\n    },\n  },\n  {\n    id: 'gemini',\n    label: 'Gemini cache',\n    matchesModel: isGeminiLikeModel,\n    matchesAssistantMessage(message, model) {\n      if (!isAssistantMessage(message)) return false;\n      return isGeminiLikeAssistantMessage(message, model);\n    },\n    normalizeUsage(message) {\n      return normalizeWithFallback(message, getGeminiRawUsage);\n    },\n  },\n  // ── Non-GPT OpenAI-compatible adapters ──────────────────────\n  {\n    id: 'openai',\n    label: 'Kimi cache',\n    matchesModel: isKimiLikeModel,\n    matchesAssistantMessage(message, model) {\n      if (!isAssistantMessage(message)) return false;\n      return isKimiLikeAssistantMessage(message, model);\n    },\n    normalizeUsage(message) {\n      return normalizeWithFallback(message, getOpenAIRawUsage);\n    },\n    warningText(model) {\n      const missing = describeMissingOpenAICompatibleProxyCompat(model);\n      if (missing.length === 0) return undefined;\n      return buildOpenAIProxyCompatWarningText(modelKey(model), missing);\n    },\n  },\n  {","lineStart":2860,"lineEnd":3079,"totalLines":9239,"truncated":true}},"title":".pi/extensions/pi-cache-optimizer/index.ts","time":{"start":1786253465079,"end":1786253465106}},"id":"prt_fe500d46200131rhhy1WpVirgC","sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","messageID":"msg_fe500c652001oGUM91g9039fEp"}}
{"type":"tool_use","timestamp":1786253465401,"sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","part":{"type":"tool","tool":"read","callID":"call_01_CKYjb8v8MqDX6N0hRnNQ5031","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts","limit":110,"offset":2370},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts</path>\n<type>file</type>\n<content>\n2370:   return `${model.provider}/${model.id}`;\n2371: }\n2372: \n2373: /**\n2374:  * For direct (non-virtual-routing) providers, the upstream API may normalize or\n2375:  * rename the model id echoed in its response (e.g. a request to\n2376:  * `zai-org/GLM-5.2-FP8` returns a message whose `model` field is\n2377:  * `GLM5.2-FP8`). Writing stats under the echoed name fragments the bucket\n2378:  * away from the active-model key the footer reads (`totalsByModel[ctx.model]`),\n2379:  * so the footer shows 0% even when the backend is hitting cache.\n2380:  *\n2381:  * When the response-derived statsModel differs from the active context model\n2382:  * only in name (same provider + same cache adapter), consolidate stats back to\n2383:  * the active model identity. Virtual routing providers are excluded — their\n2384:  * message-local metadata is authoritative for router correctness (spec:\n2385:  * `message_end` MUST prefer assistant message metadata).\n2386:  *\n2387:  * Never merges across providers or across adapters, so genuinely different\n2388:  * models are never combined.\n2389:  */\n2390: function consolidateDirectProviderStatsModel(\n2391:   statsModel: PiModel | undefined,\n2392:   ctxModel: PiModel | undefined,\n2393:   ctx?: Pick<ExtensionContext, 'sessionManager'>,\n2394: ): PiModel | undefined {\n2395:   if (!statsModel || !ctxModel) return statsModel;\n2396:   // Virtual routing providers keep message-local stats identity.\n2397:   if (isVirtualRoutingModel(ctxModel, ctx)) return statsModel;\n2398:   // Only consolidate within the same provider.\n2399:   if (statsModel.provider !== ctxModel.provider) return statsModel;\n2400:   // Only consolidate when both resolve to the same cache adapter object, so\n2401:   // genuinely different models sharing a provider (or sharing the same adapter\n2402:   // family id, e.g. GPT and GLM both report family id \"openai\") are never\n2403:   // merged. `selectAdapterForModel` returns the precise adapter object, so\n2404:   // object identity is the correct criterion.\n2405:   const statsAdapter = selectAdapterForModel(statsModel);\n2406:   const ctxAdapter = selectAdapterForModel(ctxModel);\n2407:   if (!statsAdapter || !ctxAdapter || statsAdapter !== ctxAdapter) return statsModel;\n2408:   // No drift — nothing to consolidate.\n2409:   if (statsModel.id === ctxModel.id) return statsModel;\n2410:   // Consolidate: pin stats to the active-model identity the footer reads.\n2411:   return {\n2412:     ...statsModel,\n2413:     id: ctxModel.id,\n2414:     name: ctxModel.name || ctxModel.id,\n2415:   };\n2416: }\n2417: \n2418: function usageRecordFromAssistant(message: unknown): UnknownRecord | undefined {\n2419:   return asRecord(getAssistantRecord(message)?.usage);\n2420: }\n2421: \n2422: function getNestedRecord(\n2423:   record: UnknownRecord | undefined,\n2424:   key: string,\n2425: ): UnknownRecord | undefined {\n2426:   return asRecord(record?.[key]);\n2427: }\n2428: \n2429: function getFirstNonNegativeNumber(...values: unknown[]): number | undefined {\n2430:   for (const value of values) {\n2431:     const number = getNumber(value);\n2432:     if (number !== undefined && number >= 0) return number;\n2433:   }\n2434:   return undefined;\n2435: }\n2436: \n2437: function readCachedTokensFromDetails(details: UnknownRecord | undefined): number | undefined {\n2438:   return getFirstNonNegativeNumber(details?.cached_tokens, details?.cachedTokens);\n2439: }\n2440: \n2441: function readCacheWriteFromDetails(details: UnknownRecord | undefined): number | undefined {\n2442:   return getFirstNonNegativeNumber(details?.cache_write_tokens, details?.cacheWriteTokens);\n2443: }\n2444: \n2445: // Pi normalizes provider-specific raw usage (prompt_cache_hit_tokens, cached_tokens,\n2446: // cache_read_input_tokens, etc.) into a common shape:\n2447: //   input     = uncached prompt portion (total prompt minus cacheRead minus cacheWrite)\n2448: //   cacheRead = tokens read from a previously-cached prefix\n2449: //   cacheWrite= tokens newly written into cache in this request\n2450: //\n2451: // We reconstruct the total prompt-token count as input + cacheRead + cacheWrite.\n2452: // Pi guarantees that input, cacheRead, and cacheWrite are always present on\n2453: // assistant messages processed through its provider pipeline (at least as zero).\n2454: //\n2455: // Only DeepSeek sets allowInputOnly=true so that a cache miss (cacheRead=0) still\n2456: // contributes total input tokens to the denominator.\n2457: function getPiNormalizedUsage(message: unknown, allowInputOnly = false): UsageSnapshot | undefined {\n2458:   const usage = usageRecordFromAssistant(message);\n2459:   if (!usage) return undefined;\n2460: \n2461:   const input = getNonNegativeNumber(usage, 'input');\n2462:   const cacheRead = getNonNegativeNumber(usage, 'cacheRead');\n2463:   const cacheWrite = getNonNegativeNumber(usage, 'cacheWrite');\n2464:   const hasCacheSignal = cacheRead !== undefined || cacheWrite !== undefined;\n2465: \n2466:   if (!hasCacheSignal && (input === undefined || !allowInputOnly)) return undefined;\n2467: \n2468:   // Under healthy Pi normalization input is the uncached portion, so\n2469:   // totalInput = input + cacheRead + cacheWrite gives the full prompt token count.\n2470:   // Guard against degenerate reads where a broken proxy omits prompt_tokens and\n2471:   // Pi's input falls to zero: totalInput must never be less than cacheRead + cacheWrite.\n2472:   const computed = (input ?? 0) + (cacheRead ?? 0) + (cacheWrite ?? 0);\n2473:   const floor = (cacheRead ?? 0) + (cacheWrite ?? 0);\n2474:   return {\n2475:     cacheRead: cacheRead ?? 0,\n2476:     cacheWrite: cacheWrite ?? 0,\n2477:     totalInput: computed >= floor ? computed : floor,\n2478:   };\n2479: }\n\n(Showing lines 2370-2479 of 9239. Use offset=2480 to continue.)\n</content>","metadata":{"preview":"  return `${model.provider}/${model.id}`;\n}\n\n/**\n * For direct (non-virtual-routing) providers, the upstream API may normalize or\n * rename the model id echoed in its response (e.g. a request to\n * `zai-org/GLM-5.2-FP8` returns a message whose `model` field is\n * `GLM5.2-FP8`). Writing stats under the echoed name fragments the bucket\n * away from the active-model key the footer reads (`totalsByModel[ctx.model]`),\n * so the footer shows 0% even when the backend is hitting cache.\n *\n * When the response-derived statsModel differs from the active context model\n * only in name (same provider + same cache adapter), consolidate stats back to\n * the active model identity. Virtual routing providers are excluded — their\n * message-local metadata is authoritative for router correctness (spec:\n * `message_end` MUST prefer assistant message metadata).\n *\n * Never merges across providers or across adapters, so genuinely different\n * models are never combined.\n */","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts","text":"  return `${model.provider}/${model.id}`;\n}\n\n/**\n * For direct (non-virtual-routing) providers, the upstream API may normalize or\n * rename the model id echoed in its response (e.g. a request to\n * `zai-org/GLM-5.2-FP8` returns a message whose `model` field is\n * `GLM5.2-FP8`). Writing stats under the echoed name fragments the bucket\n * away from the active-model key the footer reads (`totalsByModel[ctx.model]`),\n * so the footer shows 0% even when the backend is hitting cache.\n *\n * When the response-derived statsModel differs from the active context model\n * only in name (same provider + same cache adapter), consolidate stats back to\n * the active model identity. Virtual routing providers are excluded — their\n * message-local metadata is authoritative for router correctness (spec:\n * `message_end` MUST prefer assistant message metadata).\n *\n * Never merges across providers or across adapters, so genuinely different\n * models are never combined.\n */\nfunction consolidateDirectProviderStatsModel(\n  statsModel: PiModel | undefined,\n  ctxModel: PiModel | undefined,\n  ctx?: Pick<ExtensionContext, 'sessionManager'>,\n): PiModel | undefined {\n  if (!statsModel || !ctxModel) return statsModel;\n  // Virtual routing providers keep message-local stats identity.\n  if (isVirtualRoutingModel(ctxModel, ctx)) return statsModel;\n  // Only consolidate within the same provider.\n  if (statsModel.provider !== ctxModel.provider) return statsModel;\n  // Only consolidate when both resolve to the same cache adapter object, so\n  // genuinely different models sharing a provider (or sharing the same adapter\n  // family id, e.g. GPT and GLM both report family id \"openai\") are never\n  // merged. `selectAdapterForModel` returns the precise adapter object, so\n  // object identity is the correct criterion.\n  const statsAdapter = selectAdapterForModel(statsModel);\n  const ctxAdapter = selectAdapterForModel(ctxModel);\n  if (!statsAdapter || !ctxAdapter || statsAdapter !== ctxAdapter) return statsModel;\n  // No drift — nothing to consolidate.\n  if (statsModel.id === ctxModel.id) return statsModel;\n  // Consolidate: pin stats to the active-model identity the footer reads.\n  return {\n    ...statsModel,\n    id: ctxModel.id,\n    name: ctxModel.name || ctxModel.id,\n  };\n}\n\nfunction usageRecordFromAssistant(message: unknown): UnknownRecord | undefined {\n  return asRecord(getAssistantRecord(message)?.usage);\n}\n\nfunction getNestedRecord(\n  record: UnknownRecord | undefined,\n  key: string,\n): UnknownRecord | undefined {\n  return asRecord(record?.[key]);\n}\n\nfunction getFirstNonNegativeNumber(...values: unknown[]): number | undefined {\n  for (const value of values) {\n    const number = getNumber(value);\n    if (number !== undefined && number >= 0) return number;\n  }\n  return undefined;\n}\n\nfunction readCachedTokensFromDetails(details: UnknownRecord | undefined): number | undefined {\n  return getFirstNonNegativeNumber(details?.cached_tokens, details?.cachedTokens);\n}\n\nfunction readCacheWriteFromDetails(details: UnknownRecord | undefined): number | undefined {\n  return getFirstNonNegativeNumber(details?.cache_write_tokens, details?.cacheWriteTokens);\n}\n\n// Pi normalizes provider-specific raw usage (prompt_cache_hit_tokens, cached_tokens,\n// cache_read_input_tokens, etc.) into a common shape:\n//   input     = uncached prompt portion (total prompt minus cacheRead minus cacheWrite)\n//   cacheRead = tokens read from a previously-cached prefix\n//   cacheWrite= tokens newly written into cache in this request\n//\n// We reconstruct the total prompt-token count as input + cacheRead + cacheWrite.\n// Pi guarantees that input, cacheRead, and cacheWrite are always present on\n// assistant messages processed through its provider pipeline (at least as zero).\n//\n// Only DeepSeek sets allowInputOnly=true so that a cache miss (cacheRead=0) still\n// contributes total input tokens to the denominator.\nfunction getPiNormalizedUsage(message: unknown, allowInputOnly = false): UsageSnapshot | undefined {\n  const usage = usageRecordFromAssistant(message);\n  if (!usage) return undefined;\n\n  const input = getNonNegativeNumber(usage, 'input');\n  const cacheRead = getNonNegativeNumber(usage, 'cacheRead');\n  const cacheWrite = getNonNegativeNumber(usage, 'cacheWrite');\n  const hasCacheSignal = cacheRead !== undefined || cacheWrite !== undefined;\n\n  if (!hasCacheSignal && (input === undefined || !allowInputOnly)) return undefined;\n\n  // Under healthy Pi normalization input is the uncached portion, so\n  // totalInput = input + cacheRead + cacheWrite gives the full prompt token count.\n  // Guard against degenerate reads where a broken proxy omits prompt_tokens and\n  // Pi's input falls to zero: totalInput must never be less than cacheRead + cacheWrite.\n  const computed = (input ?? 0) + (cacheRead ?? 0) + (cacheWrite ?? 0);\n  const floor = (cacheRead ?? 0) + (cacheWrite ?? 0);\n  return {\n    cacheRead: cacheRead ?? 0,\n    cacheWrite: cacheWrite ?? 0,\n    totalInput: computed >= floor ? computed : floor,\n  };\n}","lineStart":2370,"lineEnd":2479,"totalLines":9239,"truncated":true}},"title":".pi/extensions/pi-cache-optimizer/index.ts","time":{"start":1786253465390,"end":1786253465400}},"id":"prt_fe500d5f9001KuIh7PMk2MU7Hu","sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","messageID":"msg_fe500c652001oGUM91g9039fEp"}}
