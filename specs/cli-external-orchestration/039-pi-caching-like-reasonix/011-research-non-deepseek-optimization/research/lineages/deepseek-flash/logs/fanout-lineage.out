nsDetails');\n2510:   const cacheRead = readCachedTokensFromDetails(promptDetails) ??\n2511:     readCachedTokensFromDetails(inputDetails);\n2512:   if (cacheRead === undefined) return undefined;\n2513: \n2514:   const cacheWrite = readCacheWriteFromDetails(promptDetails) ??\n2515:     readCacheWriteFromDetails(inputDetails) ?? 0;\n2516:   const totalInput = getFirstNonNegativeNumber(\n2517:     usage.prompt_tokens,\n2518:     usage.promptTokens,\n2519:     usage.input_tokens,\n2520:     usage.inputTokens,\n2521:   ) ?? cacheRead + cacheWrite;\n2522: \n2523:   return { cacheRead, cacheWrite, totalInput };\n2524: }\n2525: \n2526: // Raw fallback for Anthropic/Claude responses that still carry their native usage fields.\n2527: // In practice Pi normalizes usage before message_end fires, so this path is only\n2528: // reached when Pi-normalized fields are absent (e.g. custom/foreign providers).\n2529: function getAnthropicRawUsage(message: unknown): UsageSnapshot | undefined {\n2530:   const usage = usageRecordFromAssistant(message);\n2531:   if (!usage) return undefined;\n2532: \n2533:   const cacheRead = getFirstNonNegativeNumber(\n2534:     usage.cache_read_input_tokens,\n2535:     usage.cacheReadInputTokens,\n2536:   );\n2537:   const cacheWrite = getFirstNonNegativeNumber(\n2538:     usage.cache_creation_input_tokens,\n2539:     usage.cacheCreationInputTokens,\n2540:   );\n2541:   if (cacheRead === undefined && cacheWrite === undefined) return undefined;\n2542: \n2543:   // Anthropic input_tokens = tokens after the last cache breakpoint (neither read nor written).\n2544:   const input = getFirstNonNegativeNumber(usage.input_tokens, usage.inputTokens) ?? 0;\n2545:   return {\n2546:     cacheRead: cacheRead ?? 0,\n2547:     cacheWrite: cacheWrite ?? 0,\n2548:     totalInput: input + (cacheRead ?? 0) + (cacheWrite ?? 0),\n2549:   };\n2550: }\n2551: \n2552: // Raw fallback for Gemini/Vertex responses that still carry their native usage fields.\n2553: // In practice Pi