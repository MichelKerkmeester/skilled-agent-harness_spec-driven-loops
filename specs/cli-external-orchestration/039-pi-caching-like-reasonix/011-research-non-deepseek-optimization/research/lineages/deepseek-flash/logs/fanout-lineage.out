{"type":"tool_use","timestamp":1786253978935,"sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","part":{"type":"tool","tool":"bash","callID":"call_01_2EjmXKMUkv9fC951wx4t5090","state":{"status":"completed","input":{"command":"cd .pi/extensions/pi-cache-optimizer && rg -n \"getOpenAIRawUsage|getAnthropicRawUsage|getGeminiRawUsage|addOpenAIPromptCacheKey|prompt_cache_key|normalizeAnthropicCacheControlTtlOrder|downgradeAnthropicLongCacheControls|isMimoLikeModel|isMiniMaxLikeModel|isQwenLikeModel|isGLMLikeModel|isKimiLikeModel|prompt_cache_retention|supportsLongCacheRetention|selectAdapterForAssistantMessage|modelFromAssistantMessage|consolidateDirectProviderStatsModel|isVirtualRoutingModel|cache_control|403|openAISdkHeader|sendSessionAffinityHeaders\" tests/*.ts"},"output":"tests/review-findings.test.ts:525:  const compatKey = 'supportsLongCacheRetention';\ntests/review-findings.test.ts:642:      const deniedPayload: Record<string, unknown> = { prompt_cache_retention: '24h' };\ntests/review-findings.test.ts:644:      assert.equal('prompt_cache_retention' in deniedPayload, false);\ntests/review-findings.test.ts:650:      const allowedPayload: Record<string, unknown> = { prompt_cache_retention: '24h' };\ntests/review-findings.test.ts:652:      assert.equal(allowedPayload.prompt_cache_retention, '24h');\ntests/review-findings.test.ts:670:  const compatKeys = { supportsLongCacheRetention: true };\ntests/review-findings.test.ts:676:      \"compat\": { \"supportsLongCacheRetention\": false },\ntests/review-findings.test.ts:679:        \"compat\": { \"supportsLongCacheRetention\": false }\ntests/review-findings.test.ts:685:            \"supportsLongCacheRetention\": false,\ntests/review-findings.test.ts:714:        'supportsLongCacheRetention',\ntests/review-findings.test.ts:724:      \"compat\": { \"supportsLongCacheRetention\": false },\ntests/review-findings.test.ts:728:          \"compat\": { \"supportsLongCacheRetention\": false }\ntests/review-findings.test.ts:752:      /effe