erOwnedCacheHintsService(value: unknown): boolean {\n1164:   // The symbol-keyed owner marker is private metadata added at runtime.\n1165:   return typeof value === 'object' && value !== null &&\n1166:     (value as Record<symbol, unknown>)[PI_CACHE_HINTS_OWNER_SYMBOL] === true;\n1167: }\n1168: \n1169: function installCacheHintsService(\n1170:   service: PiCacheHintsV1,\n1171:   options: CacheHintsInstallOptions = {},\n1172: ): () => void {\n1173:   const globals = getProtocolGlobal();\n1174:   const previous = globals[PI_CACHE_HINTS_SYMBOL];\n1175:   globals[PI_CACHE_HINTS_SYMBOL] = service;\n1176:   return () => {\n1177:     if (globals[PI_CACHE_HINTS_SYMBOL] !== service) return;\n1178:     if (previous !== undefined && !options.discardPrevious?.(previous)) {\n1179:       globals[PI_CACHE_HINTS_SYMBOL] = previous;\n1180:     } else {\n1181:       delete globals[PI_CACHE_HINTS_SYMBOL];\n1182:     }\n1183:   };\n1184: }\n1185: \n1186: /**\n1187:  * Build a session-scoped stats key from a session hash + provider/id.\n1188:  * Pure function (no closure dependency) for use by tests and internals.\n1189:  */\n1190: function makeSessionModelKey(sessionHash: string, provider: string, id: string): string {\n1191:   return `${sessionHash}:${provider}/${id}`;\n1192: }\n1193: \n1194: /**\n1195:  * Extract the user-facing model key from a session-scoped key.\n1196:  * \"abc123:otokapi/gpt-5.5\" → \"otokapi/gpt-5.5\"\n1197:  */\n1198: function modelKeyFromSessionKey(sessionModelKey: string): string {\n1199:   const idx = sessionModelKey.indexOf(':');\n1200:   return idx >= 0 ? sessionModelKey.slice(idx + 1) : sessionModelKey;\n1201: }\n1202: \n1203: function asRecord(value: unknown): UnknownRecord | undefined {\n1204:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n1205:   // The checks above exclude null and arrays, leaving the object shape\n1206:   // represented by the shared unknown-record alias.\n1207:   return value as UnknownRecord;\n1208: }\n1209: \n1210: function lower(value: unknown): string {\n1211:   return typeof value === 'string' ? value.toLowerCase() : '';\n1212: }\n1213: \n1214: function getNumber(value: unknown): number | undefined {\n1215:   return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\n1216: }\n1217: \n1218: function getNonNegativeNumber(record: UnknownRecord, key: string): number | undefined {\n1219:   const value = getNumber(record[key]);\n1220:   return value !== undefined && value >= 0 ? value : undefined;\n1221: }\n1222: \n1223: /**\n1224:  * Get effective compat for a model by merging provider-level and model-level compat.\n1225:  * Model-level compat takes precedence over provider-level compat for overlapping keys.\n1226:  * This matches Pi's model-registry.js mergeCompat behavior.\n1227:  */\n1228: function getCompat(model: PiModel | undefined): CacheCompat {\n1229:   if (!model) return {};\n1230: \n1231:   // Pi merges provider.compat with model.compat (model wins on conflicts)\n1232:   // We approximate this by reading from ctx.model which should already have merged compat\n1233:   // However, for safety, we check both levels if available\n1234:   // Pi exposes compat as an open record; the interface documents known fields\n1235:   // while preserving provider-specific keys used by routing integrations.\n1236:   const modelCompat = model.compat ?? {};\n1237: \n1238:   // Note: ctx.model from Pi should already contain merged compat,\n1239:   // but we document the two-level structure for clarity\n1240:   return modelCompat;\n1241: }\n1242: \n1243: /** Join display-only path fragments without resolving them for I/O. */\n1244: function joinDisplayPath(base: string, child: string, platform: string = process.platform): string {\n1245:   const sep = platform.startsWith('win') ? '\\\\' : '/';\n1246:   return `${base.replace(/[\\\\/]+$/, '')}${sep}${child}`;\n1247: }\n1248: \n1249: /**\n\n(Showing lines 1130-1249 of 9239. Use offset=1250 to continue.)\n</content>","metadata":{"preview":"  const snapshot = resolveActiveRouteSnapshot(model, ctx);\n  if (!snapshot) return undefined;\n\n  return findModelInRegistry(ctx?.modelRegistry, snapshot.provider, snapshot.modelId) ??\n    routeSnapshotToPiModel(snapshot, model);\n}\n\nfunction isVirtualRoutingModel(\n  model: PiModel | undefined,\n  ctx?: Pick<ExtensionContext, 'sessionManager'>,\n): boolean {\n  if (!model) return false;\n  return isRouterModel(model) || !!getRoutingRegistry()?.getRouter(model.provider) ||\n    !!resolveActiveRouteSnapshot(model, ctx);\n}\n\nfunction isCacheHintsServiceV1(value: unknown): value is PiCacheHintsV1 {\n  const record = asRecord(value);\n  return !!record && record.version === 1 && typeof record.getHints === 'function';\n}","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/pi-cache-optimizer/index.ts","text":"  const snapshot = resolveActiveRouteSnapshot(model, ctx);\n  if (!snapshot) return undefined;\n\n  return findModelInRegistry(ctx?.modelRegistry, snapshot.provider, snapshot.modelId) ??\n    routeSnapshotToPiModel(snapshot, model);\n}\n\nfunction isVirtualRoutingModel(\n  model: PiModel | undefined,\n  ctx?: Pick<ExtensionContext, 'sessionManager'>,\n): boolean {\n  if (!model) return false;\n  return isRouterModel(model) || !!getRoutingRegistry()?.getRouter(model.provider) ||\n    !!resolveActiveRouteSnapshot(model, ctx);\n}\n\nfunction isCacheHintsServiceV1(value: unknown): value is PiCacheHintsV1 {\n  const record = asRecord(value);\n  return !!record && record.version === 1 && typeof record.getHints === 'function';\n}\n\nfunction getCacheHintsService(): PiCacheHintsV1 | undefined {\n  const candidate = getProtocolGlobal()[PI_CACHE_HINTS_SYMBOL];\n  return isCacheHintsServiceV1(candidate) ? candidate : undefined;\n}\n\nfunction markOptimizerOwnedCacheHintsService(service: PiCacheHintsV1): PiCacheHintsV1 {\n  // The owner marker is private symbol metadata, not part of the public\n  // cache-hints service contract.\n  (service as PiCacheHintsV1 & Record<symbol, unknown>)[PI_CACHE_HINTS_OWNER_SYMBOL] = true;\n  return service;\n}\n\nfunction isOptimizerOwnedCacheHintsService(value: unknown): boolean {\n  // The symbol-keyed owner marker is private metadata added at runtime.\n  return typeof value === 'object' && value !== null &&\n    (value as Record<symbol, unknown>)[PI_CACHE_HINTS_OWNER_SYMBOL] === true;\n}\n\nfunction installCacheHintsService(\n  service: PiCacheHintsV1,\n  options: CacheHintsInstallOptions = {},\n): () => void {\n  const globals = getProtocolGlobal();\n  const previous = globals[PI_CACHE_HINTS_SYMBOL];\n  globals[PI_CACHE_HINTS_SYMBOL] = service;\n  return () => {\n    if (globals[PI_CACHE_HINTS_SYMBOL] !== service) return;\n    if (previous !== undefined && !options.discardPrevious?.(previous)) {\n      globals[PI_CACHE_HINTS_SYMBOL] = previous;\n    } else {\n      delete globals[PI_CACHE_HINTS_SYMBOL];\n    }\n  };\n}\n\n/**\n * Build a session-scoped stats key from a session hash + provider/id.\n * Pure function (no closure dependency) for use by tests and internals.\n */\nfunction makeSessionModelKey(sessionHash: string, provider: string, id: string): string {\n  return `${sessionHash}:${provider}/${id}`;\n}\n\n/**\n * Extract the user-facing model key from a session-scoped key.\n * \"abc123:otokapi/gpt-5.5\" → \"otokapi/gpt-5.5\"\n */\nfunction modelKeyFromSessionKey(sessionModelKey: string): string {\n  const idx = sessionModelKey.indexOf(':');\n  return idx >= 0 ? sessionModelKey.slice(idx + 1) : sessionModelKey;\n}\n\nfunction asRecord(value: unknown): UnknownRecord | undefined {\n  if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n  // The checks above exclude null and arrays, leaving the object shape\n  // represented by the shared unknown-record alias.\n  return value as UnknownRecord;\n}\n\nfunction lower(value: unknown): string {\n  return typeof value === 'string' ? value.toLowerCase() : '';\n}\n\nfunction getNumber(value: unknown): number | undefined {\n  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\n}\n\nfunction getNonNegativeNumber(record: UnknownRecord, key: string): number | undefined {\n  const value = getNumber(record[key]);\n  return value !== undefined && value >= 0 ? value : undefined;\n}\n\n/**\n * Get effective compat for a model by merging provider-level and model-level compat.\n * Model-level compat takes precedence over provider-level compat for overlapping keys.\n * This matches Pi's model-registry.js mergeCompat behavior.\n */\nfunction getCompat(model: PiModel | undefined): CacheCompat {\n  if (!model) return {};\n\n  // Pi merges provider.compat with model.compat (model wins on conflicts)\n  // We approximate this by reading from ctx.model which should already have merged compat\n  // However, for safety, we check both levels if available\n  // Pi exposes compat as an open record; the interface documents known fields\n  // while preserving provider-specific keys used by routing integrations.\n  const modelCompat = model.compat ?? {};\n\n  // Note: ctx.model from Pi should already contain merged compat,\n  // but we document the two-level structure for clarity\n  return modelCompat;\n}\n\n/** Join display-only path fragments without resolving them for I/O. */\nfunction joinDisplayPath(base: string, child: string, platform: string = process.platform): string {\n  const sep = platform.startsWith('win') ? '\\\\' : '/';\n  return `${base.replace(/[\\\\/]+$/, '')}${sep}${child}`;\n}\n\n/**","lineStart":1130,"lineEnd":1249,"totalLines":9239,"truncated":true}},"title":".pi/extensions/pi-cache-optimizer/index.ts","time":{"start":1786253595631,"end":1786253595644}},"id":"prt_fe502d2ac0018h3BLZ86sjU5m1","sessionID":"ses_01b038435ffe8s23kM0wHD2vvA","messageID":"msg_fe502c102001GxoIrkm3t1YQP6"}}
