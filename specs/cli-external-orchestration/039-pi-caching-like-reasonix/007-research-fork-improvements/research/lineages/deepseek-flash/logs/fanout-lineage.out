{"type":"tool_use","timestamp":1786167899652,"sessionID":"ses_020238d7affe3gDc79EXqntLlP","part":{"type":"tool","tool":"read","callID":"call_00_ET_2lZ4bEPw8ENLmYx05waC7253","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/extensions/deeppi/stormbreaker.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/extensions/deeppi/stormbreaker.ts</path>\n<type>file</type>\n<content>\n1: /**\n2:  * Storm-breaker module — batch-aware retry economy.\n3:  *\n4:  * Collects every tool call in a turn as a batch, then escalates only when\n5:  * the *whole* batch fails repeatedly: a guard on the third equivalent\n6:  * all-failed batch, an abort on the fourth. Any success resets both streaks.\n7:  */\n8: import type {\n9: \tExtensionAPI,\n10: \tExtensionContext,\n11: \tToolResultEvent,\n12: } from \"@earendil-works/pi-coding-agent\";\n13: import { enhanceError, errorSignature, extractErrorText } from \"./utils.js\";\n14: \n15: // ─────────────────────────────────────────────────────────────────────────────\n16: // New batch-aware implementation (Task 4)\n17: // ─────────────────────────────────────────────────────────────────────────────\n18: \n19: export interface ExpectedToolCall { id: string; name: string }\n20: export interface ToolOutcome extends ExpectedToolCall { isError: boolean; text: string }\n21: export type StormDecision =\n22: \t| { kind: \"pending\" | \"none\" }\n23: \t| { kind: \"guard\" | \"abort\"; message: string };\n24: \n25: export interface StormBreakerState {\n26: \texpected: ExpectedToolCall[];\n27: \toutcomes: Map<string, ToolOutcome>;\n28: \tlastSignature: string | null;\n29: \trepeatCount: number;\n30: \tblockedTurnStreak: number;\n31: \tguardsInjected: number;\n32: \tloopsAborted: number;\n33: \terrorsEnhanced: number;\n34: }\n35: \n36: export function createStormBreakerState(): StormBreakerState {\n37: \treturn {\n38: \t\texpected: [], outcomes: new Map(), lastSignature: null, repeatCount: 0,\n39: \t\tblockedTurnStreak: 0, guardsInjected: 0, loopsAborted: 0, errorsEnhanced: 0,\n40: \t};\n41: }\n42: \n43: export function resetStormBreaker(state: StormBreakerState): void {\n44: \tstate.expected = [];\n45: \tstate.outcomes = new Map();\n46: \tstate.lastSignature = null;\n47: \tstate.repeatCount = 0;\n48: \tstate.blockedTurnStreak = 0;\n49: \tstate.guardsInjected = 0;\n50: \tstate.loopsAborted = 0;\n51: \tstate.errorsEnhanced = 0;\n52: }\n53: \n54: export function startToolBatch(state: StormBreakerState, calls: ExpectedToolCall[]): void {\n55: \tstate.expected = calls;\n56: \tstate.outcomes = new Map();\n57: }\n58: \n59: export function recordToolOutcome(\n60: \tstate: StormBreakerState,\n61: \toutcome: ToolOutcome,\n62: ): StormDecision {\n63: \tif (!state.expected.some((call) => call.id === outcome.id)) return { kind: \"none\" };\n64: \tstate.outcomes.set(outcome.id, outcome);\n65: \tif (state.outcomes.size < state.expected.length) return { kind: \"pending\" };\n66: \tconst ordered = state.expected.map((call) => state.outcomes.get(call.id)!);\n67: \tstate.expected = [];\n68: \tstate.outcomes = new Map();\n69: \tif (ordered.some((value) => !value.isError)) {\n70: \t\tstate.lastSignature = null;\n71: \t\tstate.repeatCount = 0;\n72: \t\tstate.blockedTurnStreak = 0;\n73: \t\treturn { kind: \"none\" };\n74: \t}\n75: \tconst signature = batchSignatureFromOutcomes(ordered);\n76: \tstate.repeatCount = state.lastSignature === signature ? state.repeatCount + 1 : 1;\n77: \tstate.lastSignature = signature;\n78: \tstate.blockedTurnStreak++;\n79: \tconst level = Math.max(state.repeatCount, state.blockedTurnStreak);\n80: \tconst lastError = ordered.at(-1)!.text.slice(0, 300);\n81: \tif (level === 3) {\n82: \t\tstate.guardsInjected++;\n83: \t\treturn {\n84: \t\t\tkind: \"guard\",\n85: \t\t\tmessage: `[loop guard] Every tool call in this batch failed repeatedly. Change arguments, use another tool, or report the blocker. Last error: ${lastError}`,\n86: \t\t};\n87: \t}\n88: \tif (level >= 4) {\n89: \t\tstate.loopsAborted++;\n90: \t\treturn { kind: \"abort\", message: `DeepPi stopped a repeated failed tool batch. Last error: ${lastError}` };\n91: \t}\n92: \treturn { kind: \"none\" };\n93: }\n94: \n95: function batchSignatureFromOutcomes(outcomes: ToolOutcome[]): string {\n96: \treturn outcomes.map((outcome) =>\n97: \t\t`${outcome.name}\\0${errorSignature(outcome.name, outcome.text)}`,\n98: \t).join(\"\\0\\0\");\n99: }\n100: \n101: export function toolCallsFromMessage(message: unknown): ExpectedToolCall[] {\n102: \tconst value = message as { role?: unknown; content?: unknown } | undefined;\n103: \tif (value?.role !== \"assistant\" || !Array.isArray(value.content)) return [];\n104: \treturn value.content.flatMap((block) => {\n105: \t\tconst call = block as { type?: unknown; id?: unknown; name?: unknown };\n106: \t\treturn call.type === \"toolCall\" && typeof call.id === \"string\" && typeof call.name === \"string\"\n107: \t\t\t? [{ id: call.id, name: call.name }]\n108: \t\t\t: [];\n109: \t});\n110: }\n111: \n112: export function registerStormBreaker(\n113: \tpi: ExtensionAPI,\n114: \tstate: StormBreakerState,\n115: \teligible: (model: { provider: string; id: string } | undefined) => boolean,\n116: ): StormBreakerState {\n117: \tpi.on(\"message_end\", async (event, ctx) => {\n118: \t\tif (!eligible(ctx.model)) return;\n119: \t\tconst message = event.message as { role?: unknown } | undefined;\n120: \t\t// Pi emits message_start/message_end for EVERY message — including\n121: \t\t// tool-result messages (role \"toolResult\", see agent-loop.ts\n122: \t\t// emitToolResultMessage) and user turns. Only assistant turns carry\n123: \t\t// tool calls or end a blocked streak; ignoring everything else keeps a\n124: \t\t// tool-result's message_end from resetting the streak mid-batch.\n125: \t\tif (message?.role !== \"assistant\") return;\n126: \t\tconst calls = toolCallsFromMessage(event.message);\n127: \t\tif (calls.length > 0) {\n128: \t\t\tstartToolBatch(state, calls);\n129: \t\t} else {\n130: \t\t\t// The assistant moved on without calling any tools — the blocked\n131: \t\t\t// streak is over. A later all-failed batch starts a fresh streak.\n132: \t\t\tstate.expected = [];\n133: \t\t\tstate.outcomes = new Map();\n134: \t\t\tstate.lastSignature = null;\n135: \t\t\tstate.repeatCount = 0;\n136: \t\t\tstate.blockedTurnStreak = 0;\n137: \t\t}\n138: \t});\n139: \n140: \tpi.on(\"tool_result\", async (event, ctx) => {\n141: \t\tif (!eligible(ctx.model)) return;\n142: \t\tconst raw = extractErrorText(event.content);\n143: \t\tconst text = event.isError ? enhanceError(event.toolName, raw) : raw;\n144: \t\tif (text !== raw) state.errorsEnhanced++;\n145: \t\tconst decision = recordToolOutcome(state, {\n146: \t\t\tid: event.toolCallId,\n147: \t\t\tname: event.toolName,\n148: \t\t\tisError: event.isError,\n149: \t\t\ttext,\n150: \t\t});\n151: \t\tif (decision.kind === \"guard\") {\n152: \t\t\treturn { content: [{ type: \"text\" as const, text: `${text}\\n\\n${decision.message}` }] };\n153: \t\t}\n154: \t\tif (decision.kind === \"abort\") {\n155: \t\t\tctx.abort();\n156: \t\t\tctx.ui.notify(decision.message, \"warning\");\n157: \t\t}\n158: \t\tif (event.isError && text !== raw) {\n159: \t\t\treturn { content: [{ type: \"text\" as const, text }] };\n160: \t\t}\n161: \t});\n162: \n163: \treturn state;\n164: }\n\n(End of file - total 164 lines)\n</content>","metadata":{"preview":"/**\n * Storm-breaker module — batch-aware retry economy.\n *\n * Collects every tool call in a turn as a batch, then escalates only when\n * the *whole* batch fails repeatedly: a guard on the third equivalent\n * all-failed batch, an abort on the fourth. Any success resets both streaks.\n */\nimport type {\n\tExtensionAPI,\n\tExtensionContext,\n\tToolResultEvent,\n} from \"@earendil-works/pi-coding-agent\";\nimport { enhanceError, errorSignature, extractErrorText } from \"./utils.js\";\n\n// ─────────────────────────────────────────────────────────────────────────────\n// New batch-aware implementation (Task 4)\n// ─────────────────────────────────────────────────────────────────────────────\n\nexport interface ExpectedToolCall { id: string; name: string }\nexport interface ToolOutcome extends ExpectedToolCall { isError: boolean; text: string }","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/extensions/deeppi/stormbreaker.ts","text":"/**\n * Storm-breaker module — batch-aware retry economy.\n *\n * Collects every tool call in a turn as a batch, then escalates only when\n * the *whole* batch fails repeatedly: a guard on the third equivalent\n * all-failed batch, an abort on the fourth. Any success resets both streaks.\n */\nimport type {\n\tExtensionAPI,\n\tExtensionContext,\n\tToolResultEvent,\n} from \"@earendil-works/pi-coding-agent\";\nimport { enhanceError, errorSignature, extractErrorText } from \"./utils.js\";\n\n// ─────────────────────────────────────────────────────────────────────────────\n// New batch-aware implementation (Task 4)\n// ─────────────────────────────────────────────────────────────────────────────\n\nexport interface ExpectedToolCall { id: string; name: string }\nexport interface ToolOutcome extends ExpectedToolCall { isError: boolean; text: string }\nexport type StormDecision =\n\t| { kind: \"pending\" | \"none\" }\n\t| { kind: \"guard\" | \"abort\"; message: string };\n\nexport interface StormBreakerState {\n\texpected: ExpectedToolCall[];\n\toutcomes: Map<string, ToolOutcome>;\n\tlastSignature: string | null;\n\trepeatCount: number;\n\tblockedTurnStreak: number;\n\tguardsInjected: number;\n\tloopsAborted: number;\n\terrorsEnhanced: number;\n}\n\nexport function createStormBreakerState(): StormBreakerState {\n\treturn {\n\t\texpected: [], outcomes: new Map(), lastSignature: null, repeatCount: 0,\n\t\tblockedTurnStreak: 0, guardsInjected: 0, loopsAborted: 0, errorsEnhanced: 0,\n\t};\n}\n\nexport function resetStormBreaker(state: StormBreakerState): void {\n\tstate.expected = [];\n\tstate.outcomes = new Map();\n\tstate.lastSignature = null;\n\tstate.repeatCount = 0;\n\tstate.blockedTurnStreak = 0;\n\tstate.guardsInjected = 0;\n\tstate.loopsAborted = 0;\n\tstate.errorsEnhanced = 0;\n}\n\nexport function startToolBatch(state: StormBreakerState, calls: ExpectedToolCall[]): void {\n\tstate.expected = calls;\n\tstate.outcomes = new Map();\n}\n\nexport function recordToolOutcome(\n\tstate: StormBreakerState,\n\toutcome: ToolOutcome,\n): StormDecision {\n\tif (!state.expected.some((call) => call.id === outcome.id)) return { kind: \"none\" };\n\tstate.outcomes.set(outcome.id, outcome);\n\tif (state.outcomes.size < state.expected.length) return { kind: \"pending\" };\n\tconst ordered = state.expected.map((call) => state.outcomes.get(call.id)!);\n\tstate.expected = [];\n\tstate.outcomes = new Map();\n\tif (ordered.some((value) => !value.isError)) {\n\t\tstate.lastSignature = null;\n\t\tstate.repeatCount = 0;\n\t\tstate.blockedTurnStreak = 0;\n\t\treturn { kind: \"none\" };\n\t}\n\tconst signature = batchSignatureFromOutcomes(ordered);\n\tstate.repeatCount = state.lastSignature === signature ? state.repeatCount + 1 : 1;\n\tstate.lastSignature = signature;\n\tstate.blockedTurnStreak++;\n\tconst level = Math.max(state.repeatCount, state.blockedTurnStreak);\n\tconst lastError = ordered.at(-1)!.text.slice(0, 300);\n\tif (level === 3) {\n\t\tstate.guardsInjected++;\n\t\treturn {\n\t\t\tkind: \"guard\",\n\t\t\tmessage: `[loop guard] Every tool call in this batch failed repeatedly. Change arguments, use another tool, or report the blocker. Last error: ${lastError}`,\n\t\t};\n\t}\n\tif (level >= 4) {\n\t\tstate.loopsAborted++;\n\t\treturn { kind: \"abort\", message: `DeepPi stopped a repeated failed tool batch. Last error: ${lastError}` };\n\t}\n\treturn { kind: \"none\" };\n}\n\nfunction batchSignatureFromOutcomes(outcomes: ToolOutcome[]): string {\n\treturn outcomes.map((outcome) =>\n\t\t`${outcome.name}\\0${errorSignature(outcome.name, outcome.text)}`,\n\t).join(\"\\0\\0\");\n}\n\nexport function toolCallsFromMessage(message: unknown): ExpectedToolCall[] {\n\tconst value = message as { role?: unknown; content?: unknown } | undefined;\n\tif (value?.role !== \"assistant\" || !Array.isArray(value.content)) return [];\n\treturn value.content.flatMap((block) => {\n\t\tconst call = block as { type?: unknown; id?: unknown; name?: unknown };\n\t\treturn call.type === \"toolCall\" && typeof call.id === \"string\" && typeof call.name === \"string\"\n\t\t\t? [{ id: call.id, name: call.name }]\n\t\t\t: [];\n\t});\n}\n\nexport function registerStormBreaker(\n\tpi: ExtensionAPI,\n\tstate: StormBreakerState,\n\teligible: (model: { provider: string; id: string } | undefined) => boolean,\n): StormBreakerState {\n\tpi.on(\"message_end\", async (event, ctx) => {\n\t\tif (!eligible(ctx.model)) return;\n\t\tconst message = event.message as { role?: unknown } | undefined;\n\t\t// Pi emits message_start/message_end for EVERY message — including\n\t\t// tool-result messages (role \"toolResult\", see agent-loop.ts\n\t\t// emitToolResultMessage) and user turns. Only assistant turns carry\n\t\t// tool calls or end a blocked streak; ignoring everything else keeps a\n\t\t// tool-result's message_end from resetting the streak mid-batch.\n\t\tif (message?.role !== \"assistant\") return;\n\t\tconst calls = toolCallsFromMessage(event.message);\n\t\tif (calls.length > 0) {\n\t\t\tstartToolBatch(state, calls);\n\t\t} else {\n\t\t\t// The assistant moved on without calling any tools — the blocked\n\t\t\t// streak is over. A later all-failed batch starts a fresh streak.\n\t\t\tstate.expected = [];\n\t\t\tstate.outcomes = new Map();\n\t\t\tstate.lastSignature = null;\n\t\t\tstate.repeatCount = 0;\n\t\t\tstate.blockedTurnStreak = 0;\n\t\t}\n\t});\n\n\tpi.on(\"tool_result\", async (event, ctx) => {\n\t\tif (!eligible(ctx.model)) return;\n\t\tconst raw = extractErrorText(event.content);\n\t\tconst text = event.isError ? enhanceError(event.toolName, raw) : raw;\n\t\tif (text !== raw) state.errorsEnhanced++;\n\t\tconst decision = recordToolOutcome(state, {\n\t\t\tid: event.toolCallId,\n\t\t\tname: event.toolName,\n\t\t\tisError: event.isError,\n\t\t\ttext,\n\t\t});\n\t\tif (decision.kind === \"guard\") {\n\t\t\treturn { content: [{ type: \"text\" as const, text: `${text}\\n\\n${decision.message}` }] };\n\t\t}\n\t\tif (decision.kind === \"abort\") {\n\t\t\tctx.abort();\n\t\t\tctx.ui.notify(decision.message, \"warning\");\n\t\t}\n\t\tif (event.isError && text !== raw) {\n\t\t\treturn { content: [{ type: \"text\" as const, text }] };\n\t\t}\n\t});\n\n\treturn state;\n}","lineStart":1,"lineEnd":164,"totalLines":164,"truncated":false}},"title":".pi/extensions/deep-pi/extensions/deeppi/stormbreaker.ts","time":{"start":1786167899646,"end":1786167899651}},"id":"prt_fdfe734fe0011bC9dJvCdemK7G","sessionID":"ses_020238d7affe3gDc79EXqntLlP","messageID":"msg_fdfe726fe001Kea60uU83WEMw2"}}
{"type":"tool_use","timestamp":1786167899932,"sessionID":"ses_020238d7affe3gDc79EXqntLlP","part":{"type":"tool","tool":"read","callID":"call_01_ET_N0fobOVY16bVFSJPEMYX9908","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/tests/deeppi.integration.test.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/tests/deeppi.integration.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, expect, it } from \"vitest\";\n2: import deepPi from \"../extensions/deeppi.js\";\n3: import { FakePi, fakeContext } from \"./fake-pi.js\";\n4: \n5: it(\"is dormant and removes only edit_lines for unsupported models\", async () => {\n6: \tconst fake = new FakePi();\n7: \tfake.activeTools.push(\"edit_lines\");\n8: \tdeepPi(fake.asExtensionAPI());\n9: \tconst ctx = fakeContext({ provider: \"openrouter\", id: \"deepseek/deepseek-v4-pro\" });\n10: \tawait fake.emit(\"session_start\", {}, ctx);\n11: \texpect(fake.activeTools).toEqual([\"read\", \"edit\", \"bash\"]);\n12: \texpect(ctx.statuses.get(\"deeppi\")).toBeUndefined();\n13: });\n14: \n15: it(\"activates edit_lines and reports measured cache usage for Pro\", async () => {\n16: \tconst fake = new FakePi();\n17: \tdeepPi(fake.asExtensionAPI());\n18: \tconst ctx = fakeContext({\n19: \t\tprovider: \"deepseek\",\n20: \t\tid: \"deepseek-v4-pro\",\n21: \t\tcost: { input: 1.74, output: 3.48, cacheRead: 0.145, cacheWrite: 0 },\n22: \t});\n23: \tawait fake.emit(\"session_start\", {}, ctx);\n24: \texpect(fake.activeTools).toContain(\"edit_lines\");\n25: \texpect(ctx.statuses.get(\"deeppi\")).toBe(\"DeepPi · warming\");\n26: \tawait fake.emit(\"message_end\", {\n27: \t\tmessage: {\n28: \t\t\trole: \"assistant\",\n29: \t\t\tprovider: \"deepseek\",\n30: \t\t\tmodel: \"deepseek-v4-pro\",\n31: \t\t\tcontent: [{ type: \"text\", text: \"done\" }],\n32: \t\t\tusage: {\n33: \t\t\t\tinput: 20_000, output: 100, cacheRead: 80_000, cacheWrite: 0, totalTokens: 100_100,\n34: \t\t\t\tcost: { input: 0.0348, output: 0.000348, cacheRead: 0.0116, cacheWrite: 0, total: 0.046748 },\n35: \t\t\t},\n36: \t\t},\n37: \t}, ctx);\n38: \texpect(ctx.statuses.get(\"deeppi\")).toBe(\"DeepPi · 80% cache\");\n39: \tawait fake.commands.get(\"deeppi\")!.handler(\"\", ctx);\n40: \texpect(ctx.notifications.at(-1)).toContain(\"Cache hit rate:     80.0%\");\n41: });\n42: \n43: it(\"does not transform request bytes for unsupported models\", async () => {\n44: \tconst fake = new FakePi();\n45: \tdeepPi(fake.asExtensionAPI());\n46: \tconst ctx = fakeContext({ provider: \"deepseek\", id: \"deepseek-chat\" });\n47: \tconst messages = [{ role: \"assistant\", content: [\n48: \t\t{ type: \"thinking\", thinking: \"must remain\" },\n49: \t\t{ type: \"text\", text: \"answer\" },\n50: \t] }];\n51: \tconst payload = {\n52: \t\tmodel: \"deepseek-chat\",\n53: \t\tmessages: [{ role: \"user\", content: \"hello\" }],\n54: \t\ttools: [\n55: \t\t\t{ type: \"function\", function: { name: \"write\" } },\n56: \t\t\t{ type: \"function\", function: { name: \"read\" } },\n57: \t\t],\n58: \t};\n59: \tconst messagesBefore = structuredClone(messages);\n60: \tconst payloadBefore = structuredClone(payload);\n61: \tconst contextResults = await fake.emit(\"context\", { messages }, ctx);\n62: \tconst providerResults = await fake.emit(\"before_provider_request\", { payload }, ctx);\n63: \texpect(contextResults.every((value) => value === undefined)).toBe(true);\n64: \texpect(providerResults.every((value) => value === undefined)).toBe(true);\n65: \texpect(messages).toEqual(messagesBefore);\n66: \texpect(payload).toEqual(payloadBefore);\n67: });\n68: \n69: it(\"warns once per unrecognized DeepSeek model id in a session\", async () => {\n70: \tconst fake = new FakePi();\n71: \tdeepPi(fake.asExtensionAPI());\n72: \tconst ctx = fakeContext({\n73: \t\tprovider: \"deepseek\",\n74: \t\tid: \"deepseek-v5-test\",\n75: \t\tname: \"DeepSeek V5 Test\",\n76: \t});\n77: \tconst warning = `deep-pi doesn't recognize model \"deepseek-v5-test\" - it may need updating for new DeepSeek releases.`;\n78: \tawait fake.emit(\"session_start\", {}, ctx);\n79: \texpect(ctx.notifications).toEqual([warning]);\n80: \texpect(ctx.notificationSeverities).toEqual([\"warning\"]);\n81: \texpect(fake.activeTools).not.toContain(\"edit_lines\");\n82: \tawait fake.emit(\"model_select\", {}, ctx);\n83: \texpect(ctx.notifications).toHaveLength(1);\n84: \tawait fake.emit(\"session_start\", {}, ctx);\n85: \texpect(ctx.notifications).toEqual([warning, warning]);\n86: });\n87: \n88: it(\"stays silent through the real hook path for DeepSeek-family models on non-deepseek providers\", async () => {\n89: \tfor (const model of [\n90: \t\t{ provider: \"opencode\", id: \"deepseek-v4-flash-free\", name: \"DeepSeek V4 Flash Free\" },\n91: \t\t{ provider: \"opencode-go\", id: \"deepseek-v4-flash\", name: \"DeepSeek V4 Flash\" },\n92: \t]) {\n93: \t\tconst fake = new FakePi();\n94: \t\tdeepPi(fake.asExtensionAPI());\n95: \t\tconst ctx = fakeContext(model);\n96: \t\tawait fake.emit(\"session_start\", {}, ctx);\n97: \t\tawait fake.emit(\"model_select\", {}, ctx);\n98: \t\texpect(ctx.notifications).toEqual([]);\n99: \t\texpect(fake.activeTools).not.toContain(\"edit_lines\");\n100: \t\texpect(ctx.statuses.get(\"deeppi\")).toBeUndefined();\n101: \t}\n102: });\n\n(End of file - total 102 lines)\n</content>","metadata":{"preview":"import { describe, expect, it } from \"vitest\";\nimport deepPi from \"../extensions/deeppi.js\";\nimport { FakePi, fakeContext } from \"./fake-pi.js\";\n\nit(\"is dormant and removes only edit_lines for unsupported models\", async () => {\n\tconst fake = new FakePi();\n\tfake.activeTools.push(\"edit_lines\");\n\tdeepPi(fake.asExtensionAPI());\n\tconst ctx = fakeContext({ provider: \"openrouter\", id: \"deepseek/deepseek-v4-pro\" });\n\tawait fake.emit(\"session_start\", {}, ctx);\n\texpect(fake.activeTools).toEqual([\"read\", \"edit\", \"bash\"]);\n\texpect(ctx.statuses.get(\"deeppi\")).toBeUndefined();\n});\n\nit(\"activates edit_lines and reports measured cache usage for Pro\", async () => {\n\tconst fake = new FakePi();\n\tdeepPi(fake.asExtensionAPI());\n\tconst ctx = fakeContext({\n\t\tprovider: \"deepseek\",\n\t\tid: \"deepseek-v4-pro\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/tests/deeppi.integration.test.ts","text":"import { describe, expect, it } from \"vitest\";\nimport deepPi from \"../extensions/deeppi.js\";\nimport { FakePi, fakeContext } from \"./fake-pi.js\";\n\nit(\"is dormant and removes only edit_lines for unsupported models\", async () => {\n\tconst fake = new FakePi();\n\tfake.activeTools.push(\"edit_lines\");\n\tdeepPi(fake.asExtensionAPI());\n\tconst ctx = fakeContext({ provider: \"openrouter\", id: \"deepseek/deepseek-v4-pro\" });\n\tawait fake.emit(\"session_start\", {}, ctx);\n\texpect(fake.activeTools).toEqual([\"read\", \"edit\", \"bash\"]);\n\texpect(ctx.statuses.get(\"deeppi\")).toBeUndefined();\n});\n\nit(\"activates edit_lines and reports measured cache usage for Pro\", async () => {\n\tconst fake = new FakePi();\n\tdeepPi(fake.asExtensionAPI());\n\tconst ctx = fakeContext({\n\t\tprovider: \"deepseek\",\n\t\tid: \"deepseek-v4-pro\",\n\t\tcost: { input: 1.74, output: 3.48, cacheRead: 0.145, cacheWrite: 0 },\n\t});\n\tawait fake.emit(\"session_start\", {}, ctx);\n\texpect(fake.activeTools).toContain(\"edit_lines\");\n\texpect(ctx.statuses.get(\"deeppi\")).toBe(\"DeepPi · warming\");\n\tawait fake.emit(\"message_end\", {\n\t\tmessage: {\n\t\t\trole: \"assistant\",\n\t\t\tprovider: \"deepseek\",\n\t\t\tmodel: \"deepseek-v4-pro\",\n\t\t\tcontent: [{ type: \"text\", text: \"done\" }],\n\t\t\tusage: {\n\t\t\t\tinput: 20_000, output: 100, cacheRead: 80_000, cacheWrite: 0, totalTokens: 100_100,\n\t\t\t\tcost: { input: 0.0348, output: 0.000348, cacheRead: 0.0116, cacheWrite: 0, total: 0.046748 },\n\t\t\t},\n\t\t},\n\t}, ctx);\n\texpect(ctx.statuses.get(\"deeppi\")).toBe(\"DeepPi · 80% cache\");\n\tawait fake.commands.get(\"deeppi\")!.handler(\"\", ctx);\n\texpect(ctx.notifications.at(-1)).toContain(\"Cache hit rate:     80.0%\");\n});\n\nit(\"does not transform request bytes for unsupported models\", async () => {\n\tconst fake = new FakePi();\n\tdeepPi(fake.asExtensionAPI());\n\tconst ctx = fakeContext({ provider: \"deepseek\", id: \"deepseek-chat\" });\n\tconst messages = [{ role: \"assistant\", content: [\n\t\t{ type: \"thinking\", thinking: \"must remain\" },\n\t\t{ type: \"text\", text: \"answer\" },\n\t] }];\n\tconst payload = {\n\t\tmodel: \"deepseek-chat\",\n\t\tmessages: [{ role: \"user\", content: \"hello\" }],\n\t\ttools: [\n\t\t\t{ type: \"function\", function: { name: \"write\" } },\n\t\t\t{ type: \"function\", function: { name: \"read\" } },\n\t\t],\n\t};\n\tconst messagesBefore = structuredClone(messages);\n\tconst payloadBefore = structuredClone(payload);\n\tconst contextResults = await fake.emit(\"context\", { messages }, ctx);\n\tconst providerResults = await fake.emit(\"before_provider_request\", { payload }, ctx);\n\texpect(contextResults.every((value) => value === undefined)).toBe(true);\n\texpect(providerResults.every((value) => value === undefined)).toBe(true);\n\texpect(messages).toEqual(messagesBefore);\n\texpect(payload).toEqual(payloadBefore);\n});\n\nit(\"warns once per unrecognized DeepSeek model id in a session\", async () => {\n\tconst fake = new FakePi();\n\tdeepPi(fake.asExtensionAPI());\n\tconst ctx = fakeContext({\n\t\tprovider: \"deepseek\",\n\t\tid: \"deepseek-v5-test\",\n\t\tname: \"DeepSeek V5 Test\",\n\t});\n\tconst warning = `deep-pi doesn't recognize model \"deepseek-v5-test\" - it may need updating for new DeepSeek releases.`;\n\tawait fake.emit(\"session_start\", {}, ctx);\n\texpect(ctx.notifications).toEqual([warning]);\n\texpect(ctx.notificationSeverities).toEqual([\"warning\"]);\n\texpect(fake.activeTools).not.toContain(\"edit_lines\");\n\tawait fake.emit(\"model_select\", {}, ctx);\n\texpect(ctx.notifications).toHaveLength(1);\n\tawait fake.emit(\"session_start\", {}, ctx);\n\texpect(ctx.notifications).toEqual([warning, warning]);\n});\n\nit(\"stays silent through the real hook path for DeepSeek-family models on non-deepseek providers\", async () => {\n\tfor (const model of [\n\t\t{ provider: \"opencode\", id: \"deepseek-v4-flash-free\", name: \"DeepSeek V4 Flash Free\" },\n\t\t{ provider: \"opencode-go\", id: \"deepseek-v4-flash\", name: \"DeepSeek V4 Flash\" },\n\t]) {\n\t\tconst fake = new FakePi();\n\t\tdeepPi(fake.asExtensionAPI());\n\t\tconst ctx = fakeContext(model);\n\t\tawait fake.emit(\"session_start\", {}, ctx);\n\t\tawait fake.emit(\"model_select\", {}, ctx);\n\t\texpect(ctx.notifications).toEqual([]);\n\t\texpect(fake.activeTools).not.toContain(\"edit_lines\");\n\t\texpect(ctx.statuses.get(\"deeppi\")).toBeUndefined();\n\t}\n});","lineStart":1,"lineEnd":102,"totalLines":102,"truncated":false}},"title":".pi/extensions/deep-pi/tests/deeppi.integration.test.ts","time":{"start":1786167899923,"end":1786167899931}},"id":"prt_fdfe7362b001IckrxNqxKCcLD2","sessionID":"ses_020238d7affe3gDc79EXqntLlP","messageID":"msg_fdfe726fe001Kea60uU83WEMw2"}}
