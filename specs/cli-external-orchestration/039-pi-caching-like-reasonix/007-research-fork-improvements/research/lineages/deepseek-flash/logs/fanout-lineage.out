put === 0)) {\n3733:  const totalInput = recent.reduce((sum, s) => sum + s.totalInputTokens, 0);\n3737:  const tokenRatio = totalInput > 0 ? formatHitRatio(totalCached, totalInput) : \"N/A\";\n3765:  lines.push(`Cached tokens: ${formatTokenM(currentStats.cachedInputTokens)}M / ${formatTokenM(currentStats.totalInputTokens)}M input · ${currentStats.totalInputTokens > 0 ? `${Math.round((currentStats.cachedInputTokens / currentStats.totalInputTokens) * 100)}%` : \"N/A\"}`);\n3802:  const totalInputTokens = getNonNegativeNumber(stats, \"totalInputTokens\");\n3808:    totalInputTokens === undefined ||\n3810:    cachedInputTokens > totalInputTokens ||\n3811:    cacheWriteInputTokens > totalInputTokens\n3822:    totalInputTokens,\n3835:  target.totalInputTokens += source.totalInputTokens;\n","exit":0,"truncated":false},"title":"rg -n \"function normalizeWithFallback|function getDeepSeekRawUsage|function normalizeUsage|totalInput\" \".pi/extensions/pi-cache-optimizer/index.ts\" | head -30","time":{"start":1786167754089,"end":1786167754091}},"id":"prt_fdfe4fc25001DBuQvbkZ6be6Bm","sessionID":"ses_020238d7affe3gDc79EXqntLlP","messageID":"msg_fdfe4ca8f001MweamHqVPM20xG"}}
