EGACY_STATE_FILE_PATH = join(STATE_DIR, \"deepseek-cache-optimizer-stats.json\");\n1050:function modelKeyFromSessionKey(sessionModelKey: string): string {\n1051:  const idx = sessionModelKey.indexOf(\":\");\n1052:  return idx >= 0 ? sessionModelKey.slice(idx + 1) : sessionModelKey;\n3622:function currentLocalDay(): string {\n4264:async function writePersistedCacheStats(\n6856:  function sessionModelKey(model: { provider: string; id: string }): string {\n6870:  function recordRecentSample(modelKeyStr: string, usage: UsageSnapshot, missingUsageFields: boolean): void {\n7057:  async function flushPersistCacheStats(ctx?: ExtensionContext): Promise<void> {\n7110:  async function restoreCacheStats(reason: string, ctx: ExtensionContext): Promise<void> {\n7156:  async function publishStatus(ctx: ExtensionContext, model: PiModel | undefined = ctx.model): Promise<void> {\n7616:      const sk = sessionModelKey(statsModel);\n7633:      const sk = sessionModelKey(statsModel);\n7687:        const sk = model ? sessionModelKey(model) : undefined;\n7701:        const sk = model ? sessionModelKey(model) : undefined;\n8144:              const sk = model ? sessionModelKey(model) : undefined;\n8158:              const sk = model ? sessionModelKey(model) : undefined;\n","exit":0,"truncated":false},"title":"rg -n \"interface CacheStatsState|function writePersistedCacheStats|function flushPersistCacheStats|function restoreCacheStats|function recordRecentSample|function publishStatus|function currentLocalDay|STATE_FILE_PATH =|sessionModelKey\" \".pi/extensions/pi-cache-optimizer/index.ts\" | head -40","time":{"start":1786167717955,"end":1786167717957}},"id":"prt_fdfe46e22001FhW7SXDIVggewX","sessionID":"ses_020238d7affe3gDc79EXqntLlP","messageID":"msg_fdfe447020017JB6Fl4lOysf5L"}}
