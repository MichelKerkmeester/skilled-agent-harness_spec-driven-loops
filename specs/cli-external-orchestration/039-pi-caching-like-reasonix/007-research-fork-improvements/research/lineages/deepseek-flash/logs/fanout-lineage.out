l direct-DeepSeek model ids; no shared source of truth.\",\"addedAtIteration\":1,\"sources\":[\".pi/extensions/deep-pi/extensions/deeppi/eligibility.ts:1\",\".pi/extensions/pi-cache-optimizer/index.ts:1279\"]},\n+    {\"id\":\"f-report-ui-only-corroborated\",\"text\":\"deeppi command routes full report exclusively through ctx.ui.notify.\",\"addedAtIteration\":1,\"sources\":[\".pi/extensions/deep-pi/extensions/deeppi.ts:64\"]},\n+    {\"id\":\"f-stats-asymmetry-corroborated\",\"text\":\"deep-pi resets in-memory telemetry every session_start; no persistent stats file.\",\"addedAtIteration\":1,\"sources\":[\".pi/extensions/deep-pi/extensions/deeppi/telemetry.ts:123\",\".pi/extensions/deep-pi/extensions/deeppi.ts:46\"]},\n+    {\"id\":\"f-cachewrite-accounting-mechanism\",\"text\":\"recordUsage drops pure-cache-write usage and savings arithmetic omits cacheWrite cost.\",\"addedAtIteration\":1,\"sources\":[\".pi/extensions/deep-pi/extensions/deeppi/telemetry.ts:52\",\".pi/extensions/deep-pi/extensions/deeppi/telemetry.ts:65\",\".pi/extensions/pi-cache-optimizer/index.ts:3645\"]},\n+    {\"id\":\"f-guard-early-return-test-target\",\"text\":\"cache-optimizer session_start early-return is the exact seam a composition test must assert.\",\"addedAtIteration\":1,\"sources\":[\".pi/extensions/pi-cache-optimizer/index.ts:7278\"]}\n+  ],\n+  \"ruledOutDirections\": [\n+    \"Enforce ownership split via a shared runtime module\",\n+    \"Rely on parent-synthesis counter names without re-checking current source (errorsEnhanced is stale)\"\n+  ],\n   \"blockedStopHistory\": [],\n   \"divergence\": {\n     \"saturatedDirections\": [],\n     \"completedPivots\": [],\n@@ -34,14 +44,14 @@\n     \"councilArtifactRefs\": [],\n     \"remainingFrontier\": []\n   },\n   \"metrics\": {\n-    \"iterationsCompleted\": 0,\n-    \"openQuestions\": 6,\n-    \"resolvedQuestions\": 0,\n-    \"keyFindings\": 0,\n-    \"sourceFindings\": 0,\n+    \"iterationsCompleted\": 1,\n+    \"openQuestions\": 5,\n+    \"resolvedQuestions\": 1,\n+    \"keyFindings\": 5,\n+    \"sourceFindings\": 5,\n     \"reconstructionGaps\": 0,\n-    \"convergenceScore\": null,\n-    \"coverageBySources\": {}\n+    \"convergenceScore\": 0.8,\n+    \"coverageBySources\": {\"local-source\":9}\n   }\n }\n","additions":21,"deletions":11},"truncated":false},"title":"specs/cli-external-orchestration/039-pi-caching-like-reasonix/007-research-fork-improvements/research/lineages/deepseek-flash/findings-registry.json","time":{"start":1786167502694,"end":1786167502695}},"id":"prt_fdfe1118f001MtLoxChQiv0y30","sessionID":"ses_020238d7affe3gDc79EXqntLlP","messageID":"msg_fdfe102d3001dZJwPNMmoEVXNS"}}
