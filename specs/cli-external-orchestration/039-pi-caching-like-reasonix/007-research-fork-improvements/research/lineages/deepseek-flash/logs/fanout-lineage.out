{"type":"tool_use","timestamp":1786167548265,"sessionID":"ses_020238d7affe3gDc79EXqntLlP","part":{"type":"tool","tool":"read","callID":"call_00_W88h9hTMzrh75FyjVViq3416","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/tests/telemetry.test.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/tests/telemetry.test.ts</path>\n<type>file</type>\n<content>\n1: import type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\n2: import { describe, expect, it } from \"vitest\";\n3: import {\n4: \tcacheHitRate,\n5: \tcreateTelemetryState,\n6: \tfooterText,\n7: \tformatDeepPiReport,\n8: \trecordUsage,\n9: \tregisterTelemetryHooks,\n10: \tresetTelemetry,\n11: \ttype PricedModel,\n12: } from \"../extensions/deeppi/telemetry.js\";\n13: \n14: const pro = {\n15: \tprovider: \"deepseek\",\n16: \tid: \"deepseek-v4-pro\" as const,\n17: \tcost: { input: 1.74, output: 3.48, cacheRead: 0.145, cacheWrite: 0 },\n18: };\n19: \n20: it(\"records normalized Pi usage and model-aware savings\", () => {\n21: \tconst state = createTelemetryState();\n22: \trecordUsage(state, pro, {\n23: \t\tinput: 20_000,\n24: \t\toutput: 1_000,\n25: \t\tcacheRead: 80_000,\n26: \t\tcacheWrite: 0,\n27: \t\ttotalTokens: 101_000,\n28: \t\tcost: { input: 0.0348, output: 0.00348, cacheRead: 0.0116, cacheWrite: 0, total: 0.04988 },\n29: \t});\n30: \tconst totals = state.byModel[\"deepseek-v4-pro\"];\n31: \texpect(totals.responses).toBe(1);\n32: \texpect(totals.hitTokens).toBe(80_000);\n33: \texpect(totals.missTokens).toBe(20_000);\n34: \texpect(cacheHitRate(totals)).toBe(0.8);\n35: \texpect(totals.actualInputCost).toBeCloseTo(0.0464);\n36: \texpect(totals.estimatedSavings).toBeCloseTo(0.1276);\n37: \texpect(footerText(state, \"deepseek-v4-pro\")).toBe(\"DeepPi · 80% cache\");\n38: });\n39: \n40: it(\"omits rates and savings when usage or matching pricing is unavailable\", () => {\n41: \tconst state = createTelemetryState();\n42: \texpect(footerText(state, \"deepseek-v4-flash\")).toBe(\"DeepPi · warming\");\n43: \trecordUsage(state, null, {\n44: \t\tinput: 0,\n45: \t\toutput: 0,\n46: \t\tcacheRead: 0,\n47: \t\tcacheWrite: 0,\n48: \t\ttotalTokens: 0,\n49: \t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n50: \t});\n51: \texpect(state.usageUnavailable).toBe(true);\n52: });\n53: \n54: it(\"renders measured economics and runtime counters\", () => {\n55: \tconst state = createTelemetryState();\n56: \trecordUsage(state, pro, {\n57: \t\tinput: 20_000,\n58: \t\toutput: 1_000,\n59: \t\tcacheRead: 80_000,\n60: \t\tcacheWrite: 0,\n61: \t\ttotalTokens: 101_000,\n62: \t\tcost: { input: 0.0348, output: 0.00348, cacheRead: 0.0116, cacheWrite: 0, total: 0.04988 },\n63: \t});\n64: \tstate.latestChurn = [\"tool-schema\"];\n65: \tconst report = formatDeepPiReport({\n66: \t\teligible: true,\n67: \t\tmodelId: \"deepseek-v4-pro\",\n68: \t\ttelemetry: state,\n69: \t\tloopsGuarded: 2,\n70: \t\tloopsAborted: 1,\n71: \t\teditAttempts: 5,\n72: \t\teditMismatches: 1,\n73: \t\teditSuccesses: 4,\n74: \t\ttransformErrors: 0,\n75: \t\tusageUnavailable: false,\n76: \t\tcostMathErrors: 0,\n77: \t});\n78: \texpect(report).toContain(\"Model:              deepseek-v4-pro\");\n79: \texpect(report).toContain(\"Cache hit rate:     80.0%\");\n80: \texpect(report).toContain(\"Prefix churn:       tool-schema\");\n81: \texpect(report).toContain(\"Loops guarded:      2\");\n82: });\n83: \n84: it(\"surfaces unavailable usage and clears it on reset\", () => {\n85: \tconst state = createTelemetryState();\n86: \trecordUsage(state, null, {\n87: \t\tinput: 0,\n88: \t\toutput: 0,\n89: \t\tcacheRead: 0,\n90: \t\tcacheWrite: 0,\n91: \t\ttotalTokens: 0,\n92: \t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n93: \t});\n94: \tconst report = formatDeepPiReport({\n95: \t\teligible: true,\n96: \t\tmodelId: \"deepseek-v4-flash\",\n97: \t\ttelemetry: state,\n98: \t\tloopsGuarded: 0,\n99: \t\tloopsAborted: 0,\n100: \t\teditAttempts: 0,\n101: \t\teditMismatches: 0,\n102: \t\teditSuccesses: 0,\n103: \t\ttransformErrors: 0,\n104: \t\tusageUnavailable: state.usageUnavailable,\n105: \t\tcostMathErrors: 0,\n106: \t});\n107: \texpect(report).toContain(\"Usage unavailable:  true\");\n108: \tresetTelemetry(state);\n109: \texpect(state.usageUnavailable).toBe(false);\n110: });\n111: \n112: it(\"surfaces cost-math errors in the report and clears them on reset\", () => {\n113: \tconst state = createTelemetryState();\n114: \tconst modelWithoutCost = { provider: \"deepseek\", id: \"deepseek-v4-flash\" } as unknown as PricedModel;\n115: \trecordUsage(state, modelWithoutCost, {\n116: \t\tinput: 100,\n117: \t\toutput: 10,\n118: \t\tcacheRead: 50,\n119: \t\tcacheWrite: 0,\n120: \t\ttotalTokens: 160,\n121: \t\tcost: { input: 0.1, output: 0.01, cacheRead: 0.01, cacheWrite: 0, total: 0.12 },\n122: \t});\n123: \texpect(state.costMathErrors).toBe(1);\n124: \tconst report = formatDeepPiReport({\n125: \t\teligible: true,\n126: \t\tmodelId: \"deepseek-v4-flash\",\n127: \t\ttelemetry: state,\n128: \t\tloopsGuarded: 0,\n129: \t\tloopsAborted: 0,\n130: \t\teditAttempts: 0,\n131: \t\teditMismatches: 0,\n132: \t\teditSuccesses: 0,\n133: \t\ttransformErrors: 0,\n134: \t\tusageUnavailable: false,\n135: \t\tcostMathErrors: state.costMathErrors,\n136: \t});\n137: \texpect(report).toContain(\"Cost math errors:   1\");\n138: \tresetTelemetry(state);\n139: \texpect(state.costMathErrors).toBe(0);\n140: });\n141: \n142: it(\"rejects usage with missing model pricing before changing totals\", () => {\n143: \tconst state = createTelemetryState();\n144: \tconst totals = state.byModel[\"deepseek-v4-flash\"];\n145: \tconst before = {\n146: \t\tresponses: totals.responses,\n147: \t\thitTokens: totals.hitTokens,\n148: \t\tmissTokens: totals.missTokens,\n149: \t\tactualInputCost: totals.actualInputCost,\n150: \t};\n151: \tconst modelWithoutCost = {\n152: \t\tprovider: \"deepseek\",\n153: \t\tid: \"deepseek-v4-flash\",\n154: \t} as unknown as PricedModel;\n155: \texpect(recordUsage(state, modelWithoutCost, {\n156: \t\tinput: 100,\n157: \t\toutput: 10,\n158: \t\tcacheRead: 50,\n159: \t\tcacheWrite: 0,\n160: \t\ttotalTokens: 160,\n161: \t\tcost: { input: 0.1, output: 0.01, cacheRead: 0.01, cacheWrite: 0, total: 0.12 },\n162: \t})).toBe(false);\n163: \texpect(state.costMathErrors).toBe(1);\n164: \texpect(state.byModel[\"deepseek-v4-flash\"]).toBe(totals);\n165: \texpect({\n166: \t\tresponses: totals.responses,\n167: \t\thitTokens: totals.hitTokens,\n168: \t\tmissTokens: totals.missTokens,\n169: \t\tactualInputCost: totals.actualInputCost,\n170: \t}).toEqual(before);\n171: });\n172: \n173: it(\"rejects usage with missing usage.cost before changing totals\", () => {\n174: \tconst state = createTelemetryState();\n175: \tconst totals = state.byModel[\"deepseek-v4-pro\"];\n176: \tconst before = {\n177: \t\tresponses: totals.responses,\n178: \t\thitTokens: totals.hitTokens,\n179: \t\tmissTokens: totals.missTokens,\n180: \t\tactualInputCost: totals.actualInputCost,\n181: \t};\n182: \texpect(recordUsage(state, pro, {\n183: \t\tinput: 100,\n184: \t\toutput: 10,\n185: \t\tcacheRead: 50,\n186: \t\tcacheWrite: 0,\n187: \t\ttotalTokens: 160,\n188: \t\tcost: undefined as unknown as { input: number; output: number; cacheRead: number; cacheWrite: number; total: number },\n189: \t})).toBe(false);\n190: \texpect(state.costMathErrors).toBe(1);\n191: \texpect(state.byModel[\"deepseek-v4-pro\"]).toBe(totals);\n192: \texpect({\n193: \t\tresponses: totals.responses,\n194: \t\thitTokens: totals.hitTokens,\n195: \t\tmissTokens: totals.missTokens,\n196: \t\tactualInputCost: totals.actualInputCost,\n197: \t}).toEqual(before);\n198: });\n199: \n200: it(\"ignores supported-looking model IDs from unsupported providers\", async () => {\n201: \ttype Hook = (event: any, ctx: any) => Promise<any> | any;\n202: \tconst hooks = new Map<string, Hook>();\n203: \tconst pi = {\n204: \t\ton(type: string, hook: Hook) { hooks.set(type, hook); },\n205: \t} as unknown as ExtensionAPI;\n206: \tconst state = createTelemetryState();\n207: \tregisterTelemetryHooks(pi, state, () => {});\n208: \tawait hooks.get(\"message_end\")!({\n209: \t\tmessage: {\n210: \t\t\trole: \"assistant\",\n211: \t\t\tprovider: \"openrouter\",\n212: \t\t\tmodel: \"deepseek-v4-pro\",\n213: \t\t\tusage: {\n214: \t\t\t\tinput: 10,\n215: \t\t\t\toutput: 1,\n216: \t\t\t\tcacheRead: 20,\n217: \t\t\t\tcacheWrite: 0,\n218: \t\t\t\ttotalTokens: 31,\n219: \t\t\t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n220: \t\t\t},\n221: \t\t},\n222: \t}, {\n223: \t\tmodel: { provider: \"openrouter\", id: \"deepseek-v4-pro\", cost: pro.cost },\n224: \t});\n225: \texpect(state.byModel[\"deepseek-v4-pro\"].responses).toBe(0);\n226: });\n\n(End of file - total 226 lines)\n</content>","metadata":{"preview":"import type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\nimport { describe, expect, it } from \"vitest\";\nimport {\n\tcacheHitRate,\n\tcreateTelemetryState,\n\tfooterText,\n\tformatDeepPiReport,\n\trecordUsage,\n\tregisterTelemetryHooks,\n\tresetTelemetry,\n\ttype PricedModel,\n} from \"../extensions/deeppi/telemetry.js\";\n\nconst pro = {\n\tprovider: \"deepseek\",\n\tid: \"deepseek-v4-pro\" as const,\n\tcost: { input: 1.74, output: 3.48, cacheRead: 0.145, cacheWrite: 0 },\n};\n\nit(\"records normalized Pi usage and model-aware savings\", () => {","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.pi/extensions/deep-pi/tests/telemetry.test.ts","text":"import type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\nimport { describe, expect, it } from \"vitest\";\nimport {\n\tcacheHitRate,\n\tcreateTelemetryState,\n\tfooterText,\n\tformatDeepPiReport,\n\trecordUsage,\n\tregisterTelemetryHooks,\n\tresetTelemetry,\n\ttype PricedModel,\n} from \"../extensions/deeppi/telemetry.js\";\n\nconst pro = {\n\tprovider: \"deepseek\",\n\tid: \"deepseek-v4-pro\" as const,\n\tcost: { input: 1.74, output: 3.48, cacheRead: 0.145, cacheWrite: 0 },\n};\n\nit(\"records normalized Pi usage and model-aware savings\", () => {\n\tconst state = createTelemetryState();\n\trecordUsage(state, pro, {\n\t\tinput: 20_000,\n\t\toutput: 1_000,\n\t\tcacheRead: 80_000,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 101_000,\n\t\tcost: { input: 0.0348, output: 0.00348, cacheRead: 0.0116, cacheWrite: 0, total: 0.04988 },\n\t});\n\tconst totals = state.byModel[\"deepseek-v4-pro\"];\n\texpect(totals.responses).toBe(1);\n\texpect(totals.hitTokens).toBe(80_000);\n\texpect(totals.missTokens).toBe(20_000);\n\texpect(cacheHitRate(totals)).toBe(0.8);\n\texpect(totals.actualInputCost).toBeCloseTo(0.0464);\n\texpect(totals.estimatedSavings).toBeCloseTo(0.1276);\n\texpect(footerText(state, \"deepseek-v4-pro\")).toBe(\"DeepPi · 80% cache\");\n});\n\nit(\"omits rates and savings when usage or matching pricing is unavailable\", () => {\n\tconst state = createTelemetryState();\n\texpect(footerText(state, \"deepseek-v4-flash\")).toBe(\"DeepPi · warming\");\n\trecordUsage(state, null, {\n\t\tinput: 0,\n\t\toutput: 0,\n\t\tcacheRead: 0,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 0,\n\t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n\t});\n\texpect(state.usageUnavailable).toBe(true);\n});\n\nit(\"renders measured economics and runtime counters\", () => {\n\tconst state = createTelemetryState();\n\trecordUsage(state, pro, {\n\t\tinput: 20_000,\n\t\toutput: 1_000,\n\t\tcacheRead: 80_000,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 101_000,\n\t\tcost: { input: 0.0348, output: 0.00348, cacheRead: 0.0116, cacheWrite: 0, total: 0.04988 },\n\t});\n\tstate.latestChurn = [\"tool-schema\"];\n\tconst report = formatDeepPiReport({\n\t\teligible: true,\n\t\tmodelId: \"deepseek-v4-pro\",\n\t\ttelemetry: state,\n\t\tloopsGuarded: 2,\n\t\tloopsAborted: 1,\n\t\teditAttempts: 5,\n\t\teditMismatches: 1,\n\t\teditSuccesses: 4,\n\t\ttransformErrors: 0,\n\t\tusageUnavailable: false,\n\t\tcostMathErrors: 0,\n\t});\n\texpect(report).toContain(\"Model:              deepseek-v4-pro\");\n\texpect(report).toContain(\"Cache hit rate:     80.0%\");\n\texpect(report).toContain(\"Prefix churn:       tool-schema\");\n\texpect(report).toContain(\"Loops guarded:      2\");\n});\n\nit(\"surfaces unavailable usage and clears it on reset\", () => {\n\tconst state = createTelemetryState();\n\trecordUsage(state, null, {\n\t\tinput: 0,\n\t\toutput: 0,\n\t\tcacheRead: 0,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 0,\n\t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n\t});\n\tconst report = formatDeepPiReport({\n\t\teligible: true,\n\t\tmodelId: \"deepseek-v4-flash\",\n\t\ttelemetry: state,\n\t\tloopsGuarded: 0,\n\t\tloopsAborted: 0,\n\t\teditAttempts: 0,\n\t\teditMismatches: 0,\n\t\teditSuccesses: 0,\n\t\ttransformErrors: 0,\n\t\tusageUnavailable: state.usageUnavailable,\n\t\tcostMathErrors: 0,\n\t});\n\texpect(report).toContain(\"Usage unavailable:  true\");\n\tresetTelemetry(state);\n\texpect(state.usageUnavailable).toBe(false);\n});\n\nit(\"surfaces cost-math errors in the report and clears them on reset\", () => {\n\tconst state = createTelemetryState();\n\tconst modelWithoutCost = { provider: \"deepseek\", id: \"deepseek-v4-flash\" } as unknown as PricedModel;\n\trecordUsage(state, modelWithoutCost, {\n\t\tinput: 100,\n\t\toutput: 10,\n\t\tcacheRead: 50,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 160,\n\t\tcost: { input: 0.1, output: 0.01, cacheRead: 0.01, cacheWrite: 0, total: 0.12 },\n\t});\n\texpect(state.costMathErrors).toBe(1);\n\tconst report = formatDeepPiReport({\n\t\teligible: true,\n\t\tmodelId: \"deepseek-v4-flash\",\n\t\ttelemetry: state,\n\t\tloopsGuarded: 0,\n\t\tloopsAborted: 0,\n\t\teditAttempts: 0,\n\t\teditMismatches: 0,\n\t\teditSuccesses: 0,\n\t\ttransformErrors: 0,\n\t\tusageUnavailable: false,\n\t\tcostMathErrors: state.costMathErrors,\n\t});\n\texpect(report).toContain(\"Cost math errors:   1\");\n\tresetTelemetry(state);\n\texpect(state.costMathErrors).toBe(0);\n});\n\nit(\"rejects usage with missing model pricing before changing totals\", () => {\n\tconst state = createTelemetryState();\n\tconst totals = state.byModel[\"deepseek-v4-flash\"];\n\tconst before = {\n\t\tresponses: totals.responses,\n\t\thitTokens: totals.hitTokens,\n\t\tmissTokens: totals.missTokens,\n\t\tactualInputCost: totals.actualInputCost,\n\t};\n\tconst modelWithoutCost = {\n\t\tprovider: \"deepseek\",\n\t\tid: \"deepseek-v4-flash\",\n\t} as unknown as PricedModel;\n\texpect(recordUsage(state, modelWithoutCost, {\n\t\tinput: 100,\n\t\toutput: 10,\n\t\tcacheRead: 50,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 160,\n\t\tcost: { input: 0.1, output: 0.01, cacheRead: 0.01, cacheWrite: 0, total: 0.12 },\n\t})).toBe(false);\n\texpect(state.costMathErrors).toBe(1);\n\texpect(state.byModel[\"deepseek-v4-flash\"]).toBe(totals);\n\texpect({\n\t\tresponses: totals.responses,\n\t\thitTokens: totals.hitTokens,\n\t\tmissTokens: totals.missTokens,\n\t\tactualInputCost: totals.actualInputCost,\n\t}).toEqual(before);\n});\n\nit(\"rejects usage with missing usage.cost before changing totals\", () => {\n\tconst state = createTelemetryState();\n\tconst totals = state.byModel[\"deepseek-v4-pro\"];\n\tconst before = {\n\t\tresponses: totals.responses,\n\t\thitTokens: totals.hitTokens,\n\t\tmissTokens: totals.missTokens,\n\t\tactualInputCost: totals.actualInputCost,\n\t};\n\texpect(recordUsage(state, pro, {\n\t\tinput: 100,\n\t\toutput: 10,\n\t\tcacheRead: 50,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 160,\n\t\tcost: undefined as unknown as { input: number; output: number; cacheRead: number; cacheWrite: number; total: number },\n\t})).toBe(false);\n\texpect(state.costMathErrors).toBe(1);\n\texpect(state.byModel[\"deepseek-v4-pro\"]).toBe(totals);\n\texpect({\n\t\tresponses: totals.responses,\n\t\thitTokens: totals.hitTokens,\n\t\tmissTokens: totals.missTokens,\n\t\tactualInputCost: totals.actualInputCost,\n\t}).toEqual(before);\n});\n\nit(\"ignores supported-looking model IDs from unsupported providers\", async () => {\n\ttype Hook = (event: any, ctx: any) => Promise<any> | any;\n\tconst hooks = new Map<string, Hook>();\n\tconst pi = {\n\t\ton(type: string, hook: Hook) { hooks.set(type, hook); },\n\t} as unknown as ExtensionAPI;\n\tconst state = createTelemetryState();\n\tregisterTelemetryHooks(pi, state, () => {});\n\tawait hooks.get(\"message_end\")!({\n\t\tmessage: {\n\t\t\trole: \"assistant\",\n\t\t\tprovider: \"openrouter\",\n\t\t\tmodel: \"deepseek-v4-pro\",\n\t\t\tusage: {\n\t\t\t\tinput: 10,\n\t\t\t\toutput: 1,\n\t\t\t\tcacheRead: 20,\n\t\t\t\tcacheWrite: 0,\n\t\t\t\ttotalTokens: 31,\n\t\t\t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n\t\t\t},\n\t\t},\n\t}, {\n\t\tmodel: { provider: \"openrouter\", id: \"deepseek-v4-pro\", cost: pro.cost },\n\t});\n\texpect(state.byModel[\"deepseek-v4-pro\"].responses).toBe(0);\n});","lineStart":1,"lineEnd":226,"totalLines":226,"truncated":false}},"title":".pi/extensions/deep-pi/tests/telemetry.test.ts","time":{"start":1786167548254,"end":1786167548263}},"id":"prt_fdfe1d877001R8xl0RVg0548Jb","sessionID":"ses_020238d7affe3gDc79EXqntLlP","messageID":"msg_fdfe19c90001gzP01OY5G6eQ31"}}
