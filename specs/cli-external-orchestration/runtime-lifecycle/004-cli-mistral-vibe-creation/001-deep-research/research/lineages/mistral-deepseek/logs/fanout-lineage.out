{"type":"tool_use","timestamp":1794659703885,"sessionID":"ses_e25fd45d9ffevqO0j4AcG7O1MF","part":{"partID":"prt_1da0ddbe2001yERpzFM75tdpBi","sessionID":"ses_e25fd45d9ffevqO0j4AcG7O1MF","messageID":"msg_1da0dcee6001klDE0JNhoaFWvf","type":"tool","id":"r817beoui","tool":"shell","state":{"status":"completed","input":{"command":"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/mistralai_vibe_local_harness; sed -n '85,125p' $SP/session_api/app_server/session/models/configuration.py"},"output":"    \"\"\"\n\n    skills: bool = Field(\n        default=True,\n        description=\"Expose the `skill` tool while at least one skill is configured.\",\n    )\n    subagents: bool = Field(\n        default=True,\n        description=(\n            \"Expose `tools.agents`. Requires programmatic tool calling. When off, a child \"\n            \"keeps `send_message` and `wait` to reach the rest of its tree.\"\n        ),\n    )\n    programmatic_tool_calling: bool | ProgrammaticToolCallingConfig = Field(\n        default=True,\n        description=(\n            \"Expose `run_typescript`, `search_tool_functions`, and the `tools.<group>` \"\n            \"catalog. An options object enables the feature.\"\n        ),\n    )\n    background_processes: bool | None = Field(\n        default=None,\n        description=(\n            \"Expose `tools.process`. Omitted enables them when the Host supports them, \"\n            \"sandbox access is `full`, and programmatic tool calling is enabled. True fails \"\n            \"Session start when the Host cannot honor it.\"\n        ),\n    )\n\n    @property\n    def programmatic_enabled(self) -> bool:\n        return self.programmatic_tool_calling is not False\n\n    @property\n    def programmatic_sleep(self) -> bool:\n        options = self.programmatic_tool_calling\n        if isinstance(options, ProgrammaticToolCallingConfig):\n            return options.sleep\n        return options\n\n    @model_validator(mode=\"after\")\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    \"\"\"\n\n    skills: bool = Field(\n        default=True,\n        description=\"Expose the `skill` tool while at least one skill is configured.\",\n    )\n    subagents: bool = Field(\n        default=True,\n        description=(\n            \"Expose `tools.agents`. Requires programmatic tool calling. When off, a child \"\n            \"keeps `send_message` and `wait` to reach the rest of its tree.\"\n        ),\n    )\n    programmatic_tool_calling: bool | ProgrammaticToolCallingConfig = Field(\n        default=True,\n        description=(\n            \"Expose `run_typescript`, `search_tool_functions`, and the `tools.<group>` \"\n            \"catalog. An options object enables the feature.\"\n        ),\n    )\n    background_processes: bool | None = Field(\n        default=None,\n        description=(\n            \"Expose `tools.process`. Omitted enables them when the Host supports them, \"\n            \"sandbox access is `full`, and programmatic tool calling is enabled. True fails \"\n            \"Session start when the Host cannot honor it.\"\n        ),\n    )\n\n    @property\n    def programmatic_enabled(self) -> bool:\n        return self.programmatic_tool_calling is not False\n\n    @property\n    def programmatic_sleep(self) -> bool:\n        options = self.programmatic_tool_calling\n        if isinstance(options, ProgrammaticToolCallingConfig):\n            return options.sleep\n        return options\n\n    @model_validator(mode=\"after\")\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/mistralai_vibe_local_harness; sed -n '85,125p' $SP/session_api/app_server/session/models/configuration.py\"}"},"time":{"start":1794659703778,"end":1794659703885}}}}
