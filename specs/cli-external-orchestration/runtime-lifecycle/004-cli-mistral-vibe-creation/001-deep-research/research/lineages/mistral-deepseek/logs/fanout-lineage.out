ackages/vibe/app_server/protocol.py:478:    reasoning_effort: str | None = None\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/protocol.py:1550:    reasoning_effort: str | None = None\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/protocol.py:2921:    reasoning_effort: str | None = None\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_runtime_resources.py:133:        reasoning_effort: ThinkingLevel | None = None,\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_runtime_resources.py:153:                    reasoning_effort=reasoning_effort,\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_runtime_resources.py:184:        return await self.write_model(reasoning_effort=level)\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_session_model.py:131:async def set_session_reasoning_effort_override(\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_session_model.py:133:    reasoning_effort: str,\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_session_model.py:151:            value=reasoning_effort,\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/app_server/_unified_harness_backend_adapter.py:344:    set_session_reasoning_effort_override,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; grep -rn \\\"reasoning_effort\\\" $SP --include=*.py | grep -v test | head -20\"}"},"time":{"start":1794659390235,"end":1794659390647}}}}
