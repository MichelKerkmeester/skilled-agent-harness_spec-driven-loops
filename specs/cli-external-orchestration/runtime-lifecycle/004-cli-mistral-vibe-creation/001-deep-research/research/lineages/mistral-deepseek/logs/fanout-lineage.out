{"type":"tool_use","timestamp":1794659409396,"sessionID":"ses_e25fd45d9ffevqO0j4AcG7O1MF","part":{"partID":"prt_1da095dbe001DKIi4ID7AUtSk4","sessionID":"ses_e25fd45d9ffevqO0j4AcG7O1MF","messageID":"msg_1da09521a001EISsXJlkNN2sez","type":"tool","id":"gv1pp0r1l","tool":"shell","state":{"status":"completed","input":{"command":"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; sed -n '1,60p' $SP/app_server/_billing.py; echo \"=== account ===\"; sed -n '1,40p' $SP/app_server/_account.py"},"output":"\"\"\"Read the plan and the Vibe Code budget from the public billing API.\n\n``/v1/billing/subscription`` names the organization's plan and whether\npay-as-you-go is on; ``/v1/billing/budget`` reports how much of the monthly\nVibe Code allowance is used. Both are optional: self-hosted platforms may not\nserve them and ``/budget`` needs the ``see_org_inference_usage`` permission, so\nevery failure reads as ``None`` and the account read carries on without them.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nfrom typing import Protocol\n\nimport httpx2\nfrom pydantic import BaseModel, ConfigDict, ValidationError\n\nfrom vibe.core.platform_auth import (\n    MistralPlatformHTTPClient,\n    PlatformCredentialProvider,\n    PlatformCredentialUnavailable,\n)\nfrom vibe.observability.logging import logger\n\n_SUBSCRIPTION_PATH = \"billing/subscription\"\n_BUDGET_PATH = \"billing/budget\"\n# The footer and plan title are not worth a long wait on a platform that never answers.\n_TIMEOUT_SECONDS = 3.0\n\n\nclass SubscriptionResult(BaseModel):\n    model_config = ConfigDict(extra=\"ignore\")\n\n    plan_name: str\n    # Pay-as-you-go covers Vibe Code past its allowance; null reads as off.\n    vibe_payg_enabled: bool | None = None\n\n\nclass BudgetDetail(BaseModel):\n    model_config = ConfigDict(extra=\"ignore\")\n\n    usage_percentage: float\n    initial_budget: float\n    reset_at: str | None = None\n    payg_enabled: bool | None = None\n\n\nclass BudgetResult(BaseModel):\n    model_config = ConfigDict(extra=\"ignore\")\n\n    vibe_budget: BudgetDetail | None = None\n\n\n@dataclass(frozen=True, slots=True)\nclass BillingRead:\n    subscription: SubscriptionResult | None = None\n    budget: BudgetResult | None = None\n\n=== account ===\nfrom __future__ import annotations\n\nimport asyncio\nfrom dataclasses import dataclass\nfrom typing import Protocol\n\nfrom vibe.app_server._billing import (\n    BillingGateway,\n    BillingRead,\n    SubscriptionResult,\n    default_billing_gateway,\n)\nfrom vibe.app_server.models import (\n    AccountAction,\n    AccountActionKind,\n    AccountApiKeyView,\n    AccountBudgetView,\n    AccountPlanKind,\n    AccountPlanView,\n    AccountStatus,\n    AccountView,\n)\nfrom vibe.core.config import DEFAULT_VIBE_BASE_URL, VibeConfigSchema\nfrom vibe.core.config._vibe_base_url import resolve_vibe_base_url\nfrom vibe.core.config.orchestrator import ConfigOrchestrator\nfrom vibe.core.platform_auth import (\n    PlatformCredentialFactory,\n    PlatformCredentialProvider,\n    PlatformCredentialSnapshot,\n)\nfrom vibe.core.platform_auth._mistral import (\n    MistralCredentials,\n    mistral_credentials,\n    resolve_snapshot,\n)\nfrom vibe.core.types import Backend\nfrom vibe.observability.logging import logger\nfrom vibe.setup.auth.api_key_persistence import (\n    apply_provider_to_config,\n    apply_vibe_base_url,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"\"\"\"Read the plan and the Vibe Code budget from the public billing API.\n\n``/v1/billing/subscription`` names the organization's plan and whether\npay-as-you-go is on; ``/v1/billing/budget`` reports how much of the monthly\nVibe Code allowance is used. Both are optional: self-hosted platforms may not\nserve them and ``/budget`` needs the ``see_org_inference_usage`` permission, so\nevery failure reads as ``None`` and the account read carries on without them.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nfrom typing import Protocol\n\nimport httpx2\nfrom pydantic import BaseModel, ConfigDict, ValidationError\n\nfrom vibe.core.platform_auth import (\n    MistralPlatformHTTPClient,\n    PlatformCredentialProvider,\n    PlatformCredentialUnavailable,\n)\nfrom vibe.observability.logging import logger\n\n_SUBSCRIPTION_PATH = \"billing/subscription\"\n_BUDGET_PATH = \"billing/budget\"\n# The footer and plan title are not worth a long wait on a platform that never answers.\n_TIMEOUT_SECONDS = 3.0\n\n\nclass SubscriptionResult(BaseModel):\n    model_config = ConfigDict(extra=\"ignore\")\n\n    plan_name: str\n    # Pay-as-you-go covers Vibe Code past its allowance; null reads as off.\n    vibe_payg_enabled: bool | None = None\n\n\nclass BudgetDetail(BaseModel):\n    model_config = ConfigDict(extra=\"ignore\")\n\n    usage_percentage: float\n    initial_budget: float\n    reset_at: str | None = None\n    payg_enabled: bool | None = None\n\n\nclass BudgetResult(BaseModel):\n    model_config = ConfigDict(extra=\"ignore\")\n\n    vibe_budget: BudgetDetail | None = None\n\n\n@dataclass(frozen=True, slots=True)\nclass BillingRead:\n    subscription: SubscriptionResult | None = None\n    budget: BudgetResult | None = None\n\n=== account ===\nfrom __future__ import annotations\n\nimport asyncio\nfrom dataclasses import dataclass\nfrom typing import Protocol\n\nfrom vibe.app_server._billing import (\n    BillingGateway,\n    BillingRead,\n    SubscriptionResult,\n    default_billing_gateway,\n)\nfrom vibe.app_server.models import (\n    AccountAction,\n    AccountActionKind,\n    AccountApiKeyView,\n    AccountBudgetView,\n    AccountPlanKind,\n    AccountPlanView,\n    AccountStatus,\n    AccountView,\n)\nfrom vibe.core.config import DEFAULT_VIBE_BASE_URL, VibeConfigSchema\nfrom vibe.core.config._vibe_base_url import resolve_vibe_base_url\nfrom vibe.core.config.orchestrator import ConfigOrchestrator\nfrom vibe.core.platform_auth import (\n    PlatformCredentialFactory,\n    PlatformCredentialProvider,\n    PlatformCredentialSnapshot,\n)\nfrom vibe.core.platform_auth._mistral import (\n    MistralCredentials,\n    mistral_credentials,\n    resolve_snapshot,\n)\nfrom vibe.core.types import Backend\nfrom vibe.observability.logging import logger\nfrom vibe.setup.auth.api_key_persistence import (\n    apply_provider_to_config,\n    apply_vibe_base_url,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; sed -n '1,60p' $SP/app_server/_billing.py; echo \\\"=== account ===\\\"; sed -n '1,40p' $SP/app_server/_account.py\"}"},"time":{"start":1794659409342,"end":1794659409396}}}}
