{"type":"tool_use","timestamp":1794659157943,"sessionID":"ses_e25fd45d9ffevqO0j4AcG7O1MF","part":{"partID":"prt_1da058785002hByH0pwzD2jBXy","sessionID":"ses_e25fd45d9ffevqO0j4AcG7O1MF","messageID":"msg_1da057c80001yU4kByvjIYSuV1","type":"tool","id":"jj1dbeaa5","tool":"shell","state":{"status":"completed","input":{"command":"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; sed -n '1,120p' $SP/cli/launcher.py"},"output":"from __future__ import annotations\n\nimport os\nfrom pathlib import Path\nimport shlex\nimport sys\n\n# Kept intentionally tiny: the `vibe` console script lands here and only execs\n# the Rust TUI, so it must not import the rest of the Python package.\n\nif sys.platform == \"win32\":\n    _BIN_NAME = \"vibe-rs.exe\"\n    _APP_SERVER_SCRIPT = \"vibe-app-server.exe\"\nelse:\n    _BIN_NAME = \"vibe-rs\"\n    _APP_SERVER_SCRIPT = \"vibe-app-server\"\n\n# vibe/\n#   _bin/                <-- Exists if the Rust CLI is bundled in the wheel.\n#     vibe-rs(.exe)\n#   cli/\n#     launcher.py        <-- This file\n#   cli-rust/            <-- Source checkout only (excluded from the wheel).\n#     Cargo.toml\n#     target/\n#       release/\n#         vibe-rs(.exe)  <-- Exists after a release build in the source checkout.\n_PKG_ROOT = Path(__file__).resolve().parents[1]\n_BUNDLED_BIN = _PKG_ROOT / \"_bin\" / _BIN_NAME\n_MANIFEST = _PKG_ROOT / \"cli-rust\" / \"Cargo.toml\"\n_RELEASE_BIN = _PKG_ROOT / \"cli-rust\" / \"target\" / \"release\" / _BIN_NAME\n# The Python project root, where `uv run vibe-app-server` resolves.\n_PROJECT_ROOT = _PKG_ROOT.parent\n# NTSTATUS for a process Windows could not load because a DLL it imports is missing.\n_STATUS_DLL_NOT_FOUND = 0xC0000135\n_APP_SERVER_ENV_KEYS = (\n    \"VIBE_APP_SERVER_CMD\",\n    \"VIBE_APP_SERVER_BIN\",\n    \"VIBE_APP_SERVER_CWD\",\n)\n\n\ndef main() -> None:\n    exec_rust_cli(sys.argv[1:])\n\n\ndef exec_rust_cli(\n    passthrough: list[str],\n    *,\n    extra_env: dict[str, str] | None = None,\n    app_server_cmd: list[str] | None = None,\n) -> None:\n    \"\"\"Run the Rust TUI in the caller's cwd; `app_server_cmd` sets its app-server.\"\"\"\n    env = {**os.environ, **(extra_env or {})}\n    binary = _rust_cli_binary()\n    selected = _app_server_env(env, app_server_cmd, bundled=binary == _BUNDLED_BIN)\n    # Stale values from the parent env must not shadow the selected app-server.\n    for name in _APP_SERVER_ENV_KEYS:\n        env.pop(name, None)\n    env.update(selected)\n    argv = [str(binary), *passthrough]\n    if sys.platform == \"win32\":\n        # execvpe does not overlay the process on Windows; run and forward the code.\n        import subprocess\n\n        returncode = subprocess.run(argv, env=env).returncode\n        # Windows reports the NTSTATUS unsigned here and signed in shells.\n        if returncode & 0xFFFFFFFF == _STATUS_DLL_NOT_FOUND:\n            print(\n                f\"{binary} could not start: Windows could not find a DLL it needs.\",\n                file=sys.stderr,\n            )\n        sys.exit(returncode)\n    os.execvpe(str(binary), argv, env)\n\n\ndef _rust_cli_binary() -> Path:\n    if _BUNDLED_BIN.exists():\n        return _BUNDLED_BIN\n    if not _MANIFEST.exists():\n        sys.exit(\n            f\"Rust CLI not bundled at {_BUNDLED_BIN} and no source checkout at \"\n            f\"{_MANIFEST}.\"\n        )\n    if not _RELEASE_BIN.exists():\n        _build_release()\n    return _RELEASE_BIN\n\n\ndef _app_server_env(\n    env: dict[str, str], app_server_cmd: list[str] | None, *, bundled: bool\n) -> dict[str, str]:\n    if app_server_cmd is not None:\n        return {\"VIBE_APP_SERVER_CMD\": shlex.join(app_server_cmd)}\n    if bundled:\n        # Wheel install: point the Rust client at the installed vibe-app-server.\n        script = Path(sys.argv[0]).resolve().parent / _APP_SERVER_SCRIPT\n        return {\"VIBE_APP_SERVER_BIN\": str(script)}\n    # Source checkout: the Makefile's command, if any, runs from the project root.\n    selected = {\"VIBE_APP_SERVER_CWD\": str(_PROJECT_ROOT)}\n    if cmd := env.get(\"VIBE_APP_SERVER_CMD\"):\n        selected[\"VIBE_APP_SERVER_CMD\"] = cmd\n    return selected\n\n\ndef _build_release() -> None:\n    import subprocess\n\n    print(\"Building vibe-rs (first run, this may take a while)...\", file=sys.stderr)\n    cmd = [\n        \"cargo\",\n        \"build\",\n        \"--release\",\n        \"--manifest-path\",\n        str(_MANIFEST),\n        \"--bin\",\n        \"vibe-rs\",\n        *shlex.split(os.environ.get(\"CARGO_BUILD_FLAGS\", \"\")),\n    ]\n    try:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"from __future__ import annotations\n\nimport os\nfrom pathlib import Path\nimport shlex\nimport sys\n\n# Kept intentionally tiny: the `vibe` console script lands here and only execs\n# the Rust TUI, so it must not import the rest of the Python package.\n\nif sys.platform == \"win32\":\n    _BIN_NAME = \"vibe-rs.exe\"\n    _APP_SERVER_SCRIPT = \"vibe-app-server.exe\"\nelse:\n    _BIN_NAME = \"vibe-rs\"\n    _APP_SERVER_SCRIPT = \"vibe-app-server\"\n\n# vibe/\n#   _bin/                <-- Exists if the Rust CLI is bundled in the wheel.\n#     vibe-rs(.exe)\n#   cli/\n#     launcher.py        <-- This file\n#   cli-rust/            <-- Source checkout only (excluded from the wheel).\n#     Cargo.toml\n#     target/\n#       release/\n#         vibe-rs(.exe)  <-- Exists after a release build in the source checkout.\n_PKG_ROOT = Path(__file__).resolve().parents[1]\n_BUNDLED_BIN = _PKG_ROOT / \"_bin\" / _BIN_NAME\n_MANIFEST = _PKG_ROOT / \"cli-rust\" / \"Cargo.toml\"\n_RELEASE_BIN = _PKG_ROOT / \"cli-rust\" / \"target\" / \"release\" / _BIN_NAME\n# The Python project root, where `uv run vibe-app-server` resolves.\n_PROJECT_ROOT = _PKG_ROOT.parent\n# NTSTATUS for a process Windows could not load because a DLL it imports is missing.\n_STATUS_DLL_NOT_FOUND = 0xC0000135\n_APP_SERVER_ENV_KEYS = (\n    \"VIBE_APP_SERVER_CMD\",\n    \"VIBE_APP_SERVER_BIN\",\n    \"VIBE_APP_SERVER_CWD\",\n)\n\n\ndef main() -> None:\n    exec_rust_cli(sys.argv[1:])\n\n\ndef exec_rust_cli(\n    passthrough: list[str],\n    *,\n    extra_env: dict[str, str] | None = None,\n    app_server_cmd: list[str] | None = None,\n) -> None:\n    \"\"\"Run the Rust TUI in the caller's cwd; `app_server_cmd` sets its app-server.\"\"\"\n    env = {**os.environ, **(extra_env or {})}\n    binary = _rust_cli_binary()\n    selected = _app_server_env(env, app_server_cmd, bundled=binary == _BUNDLED_BIN)\n    # Stale values from the parent env must not shadow the selected app-server.\n    for name in _APP_SERVER_ENV_KEYS:\n        env.pop(name, None)\n    env.update(selected)\n    argv = [str(binary), *passthrough]\n    if sys.platform == \"win32\":\n        # execvpe does not overlay the process on Windows; run and forward the code.\n        import subprocess\n\n        returncode = subprocess.run(argv, env=env).returncode\n        # Windows reports the NTSTATUS unsigned here and signed in shells.\n        if returncode & 0xFFFFFFFF == _STATUS_DLL_NOT_FOUND:\n            print(\n                f\"{binary} could not start: Windows could not find a DLL it needs.\",\n                file=sys.stderr,\n            )\n        sys.exit(returncode)\n    os.execvpe(str(binary), argv, env)\n\n\ndef _rust_cli_binary() -> Path:\n    if _BUNDLED_BIN.exists():\n        return _BUNDLED_BIN\n    if not _MANIFEST.exists():\n        sys.exit(\n            f\"Rust CLI not bundled at {_BUNDLED_BIN} and no source checkout at \"\n            f\"{_MANIFEST}.\"\n        )\n    if not _RELEASE_BIN.exists():\n        _build_release()\n    return _RELEASE_BIN\n\n\ndef _app_server_env(\n    env: dict[str, str], app_server_cmd: list[str] | None, *, bundled: bool\n) -> dict[str, str]:\n    if app_server_cmd is not None:\n        return {\"VIBE_APP_SERVER_CMD\": shlex.join(app_server_cmd)}\n    if bundled:\n        # Wheel install: point the Rust client at the installed vibe-app-server.\n        script = Path(sys.argv[0]).resolve().parent / _APP_SERVER_SCRIPT\n        return {\"VIBE_APP_SERVER_BIN\": str(script)}\n    # Source checkout: the Makefile's command, if any, runs from the project root.\n    selected = {\"VIBE_APP_SERVER_CWD\": str(_PROJECT_ROOT)}\n    if cmd := env.get(\"VIBE_APP_SERVER_CMD\"):\n        selected[\"VIBE_APP_SERVER_CMD\"] = cmd\n    return selected\n\n\ndef _build_release() -> None:\n    import subprocess\n\n    print(\"Building vibe-rs (first run, this may take a while)...\", file=sys.stderr)\n    cmd = [\n        \"cargo\",\n        \"build\",\n        \"--release\",\n        \"--manifest-path\",\n        str(_MANIFEST),\n        \"--bin\",\n        \"vibe-rs\",\n        *shlex.split(os.environ.get(\"CARGO_BUILD_FLAGS\", \"\")),\n    ]\n    try:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"SP=/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; sed -n '1,120p' $SP/cli/launcher.py\"}"},"time":{"start":1794659157893,"end":1794659157943}}}}
