{"type":"tool_use","timestamp":1794659268390,"sessionID":"ses_e25fd45d8ffe2Iv7ljplDZNbln","part":{"partID":"prt_1da0734c9001PcxJb7tMuJpiVH","sessionID":"ses_e25fd45d8ffe2Iv7ljplDZNbln","messageID":"msg_1da07245e001z9Xz1c4Biz1CT9","type":"tool","id":"chatcmpl-tool-85fdc42af19a19ae","tool":"shell","state":{"status":"completed","input":{"command":"V=~/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; sed -n '1,80p' $V/core/platform_auth/_api_key.py; echo \"=== MISTRAL ===\"; grep -n \"base_url\\|api_key\\|console\\|platform\\|class \\|def \" $V/core/platform_auth/_mistral.py | head -40; echo \"=== CONSTANTS ===\"; sed -n '1,60p' $V/core/model_catalog/_constants.py"},"output":"from __future__ import annotations\n\nimport asyncio\nfrom hashlib import sha256\nfrom typing import Literal\n\nfrom vibe.core.platform_auth._credentials_port import (\n    PlatformCredentialIdentity,\n    PlatformCredentialRequired,\n    PlatformCredentialResult,\n    PlatformCredentialSnapshot,\n    PlatformCredentialTarget,\n)\nfrom vibe.utils.api_keys import resolve_api_key_with_origin\nfrom vibe.utils.oidc_marker import is_oidc_authorization, is_oidc_marker\n\n\nclass ApiKeyPlatformCredentialProvider:\n    \"\"\"Resolve the current platform API key without freezing it into a client.\"\"\"\n\n    def __init__(self, env_var: str, *, cli_oidc: bool = True) -> None:\n        self._env_var = env_var\n        # Whether the CLI OIDC marker may stand for the CLI user's session. A\n        # non-CLI connection never borrows it, even when the flag is set.\n        self._cli_oidc = cli_oidc\n        self._fixed_api_key: str | None = None\n        self._rejected: dict[PlatformCredentialTarget, PlatformCredentialIdentity] = {}\n        self._lock = asyncio.Lock()\n\n    @classmethod\n    def from_api_key(cls, api_key: str) -> ApiKeyPlatformCredentialProvider:\n        provider = cls(\"\")\n        provider._fixed_api_key = api_key\n        return provider\n\n    def pinned(self) -> ApiKeyPlatformCredentialProvider:\n        \"\"\"This provider fixed to the key it resolves now: for a caller that\n        keys state on the key and must fetch with that same key later, whatever\n        the environment holds by then.\n        \"\"\"\n        if self._fixed_api_key is not None:\n            return self\n        resolved = resolve_api_key_with_origin(self._env_var)\n        return ApiKeyPlatformCredentialProvider.from_api_key(\n            resolved[0] if resolved is not None else \"\"\n        )\n\n    async def resolve(\n        self, target: PlatformCredentialTarget\n    ) -> PlatformCredentialResult:\n        snapshot = await self._snapshot_for_target(target)\n        if isinstance(snapshot, PlatformCredentialRequired):\n            return snapshot\n        if snapshot is None:\n            return PlatformCredentialRequired(reason=\"missing\")\n        async with self._lock:\n            if self._rejected.get(target) == snapshot.identity:\n                return PlatformCredentialRequired(\n                    reason=\"rejected\", observed_revision=snapshot.revision\n                )\n        return snapshot\n\n    async def reject(\n        self,\n        target: PlatformCredentialTarget,\n        *,\n        observed: PlatformCredentialIdentity,\n        reason: Literal[\"http_unauthorized\"],\n    ) -> PlatformCredentialResult:\n        del reason\n        current = await self._snapshot_for_target(target)\n        if isinstance(current, PlatformCredentialRequired):\n            return current\n        if current is not None and current.identity != observed:\n            return current\n        async with self._lock:\n            self._rejected[target] = observed\n        return PlatformCredentialRequired(\n            reason=\"rejected\", observed_revision=observed.revision\n        )\n=== MISTRAL ===\n1:\"\"\"The Mistral platform credential a config's first-party calls use.\n18:from vibe.core.platform_auth._api_key import ApiKeyPlatformCredentialProvider\n19:from vibe.core.platform_auth._credentials_port import (\n38:def api_key_credentials(env_var: str) -> PlatformCredentialProvider:\n43:class MistralCredentials:\n49:    def cached_principal(self) -> str | None:\n55:def mistral_credentials(\n69:        selected = (credentials or api_key_credentials)(provider.api_key_env_var)\n78:async def resolve_principal(\n79:    mistral: MistralCredentials, base_url: str | None = None\n88:        target = PlatformCredentialTarget(base_url or mistral.provider.api_base)\n98:def is_user_principal(key: str) -> bool:\n104:def may_cache_under(key: str | None, *, fetched_for: str | None) -> bool:\n115:def fetched_for_current_account(\n131:async def resolve_snapshot(\n135:    target = platform_target(url)\n141:def platform_target(url: str) -> PlatformCredentialTarget | None:\n151:async def credential_request(\n168:    from vibe.core.platform_auth._http import PlatformCredentialUnavailable\n201:def _origin_and_path(url: str) -> str:\n210:    \"api_key_credentials\",\n216:    \"platform_target\",\n=== CONSTANTS ===\nfrom __future__ import annotations\n\nfrom typing import Final\n\nMODEL_CATALOG_PATH: Final = \"/model-catalog\"\n\nMODEL_CATALOG_SURFACE: Final = \"vibe-code\"\n\n# Matches EVAL_REQUEST_TIMEOUT_SECONDS, per connection phase.\nMODEL_CATALOG_TIMEOUT_SECONDS: Final = 5.0\n\n# The HTTP timeout above bounds each connection phase, not the request, so the\n# wait on a fetch is capped on its own.\nMODEL_CATALOG_WAIT_CAP_SECONDS: Final = 5.0\n\n# A catalog this old may advertise retired models. Longer than the\n# experiment-eval TTL because a model list moves far less than a variant.\nMODEL_CATALOG_CACHE_TTL_SECONDS: Final = 30 * 24 * 60 * 60\n\n\ndef build_model_catalog_url(api_base: str) -> str | None:\n    \"\"\"Build the catalog URL from a Mistral provider's ``api_base``.\n\n    Returns None when ``api_base`` is empty, so a misconfigured provider makes\n    the fetch a no-op rather than a request to a garbage URL.\n    \"\"\"\n    api_base = api_base.strip().rstrip(\"/\")\n    if not api_base:\n        return None\n    return f\"{api_base}{MODEL_CATALOG_PATH}?surface={MODEL_CATALOG_SURFACE}\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"from __future__ import annotations\n\nimport asyncio\nfrom hashlib import sha256\nfrom typing import Literal\n\nfrom vibe.core.platform_auth._credentials_port import (\n    PlatformCredentialIdentity,\n    PlatformCredentialRequired,\n    PlatformCredentialResult,\n    PlatformCredentialSnapshot,\n    PlatformCredentialTarget,\n)\nfrom vibe.utils.api_keys import resolve_api_key_with_origin\nfrom vibe.utils.oidc_marker import is_oidc_authorization, is_oidc_marker\n\n\nclass ApiKeyPlatformCredentialProvider:\n    \"\"\"Resolve the current platform API key without freezing it into a client.\"\"\"\n\n    def __init__(self, env_var: str, *, cli_oidc: bool = True) -> None:\n        self._env_var = env_var\n        # Whether the CLI OIDC marker may stand for the CLI user's session. A\n        # non-CLI connection never borrows it, even when the flag is set.\n        self._cli_oidc = cli_oidc\n        self._fixed_api_key: str | None = None\n        self._rejected: dict[PlatformCredentialTarget, PlatformCredentialIdentity] = {}\n        self._lock = asyncio.Lock()\n\n    @classmethod\n    def from_api_key(cls, api_key: str) -> ApiKeyPlatformCredentialProvider:\n        provider = cls(\"\")\n        provider._fixed_api_key = api_key\n        return provider\n\n    def pinned(self) -> ApiKeyPlatformCredentialProvider:\n        \"\"\"This provider fixed to the key it resolves now: for a caller that\n        keys state on the key and must fetch with that same key later, whatever\n        the environment holds by then.\n        \"\"\"\n        if self._fixed_api_key is not None:\n            return self\n        resolved = resolve_api_key_with_origin(self._env_var)\n        return ApiKeyPlatformCredentialProvider.from_api_key(\n            resolved[0] if resolved is not None else \"\"\n        )\n\n    async def resolve(\n        self, target: PlatformCredentialTarget\n    ) -> PlatformCredentialResult:\n        snapshot = await self._snapshot_for_target(target)\n        if isinstance(snapshot, PlatformCredentialRequired):\n            return snapshot\n        if snapshot is None:\n            return PlatformCredentialRequired(reason=\"missing\")\n        async with self._lock:\n            if self._rejected.get(target) == snapshot.identity:\n                return PlatformCredentialRequired(\n                    reason=\"rejected\", observed_revision=snapshot.revision\n                )\n        return snapshot\n\n    async def reject(\n        self,\n        target: PlatformCredentialTarget,\n        *,\n        observed: PlatformCredentialIdentity,\n        reason: Literal[\"http_unauthorized\"],\n    ) -> PlatformCredentialResult:\n        del reason\n        current = await self._snapshot_for_target(target)\n        if isinstance(current, PlatformCredentialRequired):\n            return current\n        if current is not None and current.identity != observed:\n            return current\n        async with self._lock:\n            self._rejected[target] = observed\n        return PlatformCredentialRequired(\n            reason=\"rejected\", observed_revision=observed.revision\n        )\n=== MISTRAL ===\n1:\"\"\"The Mistral platform credential a config's first-party calls use.\n18:from vibe.core.platform_auth._api_key import ApiKeyPlatformCredentialProvider\n19:from vibe.core.platform_auth._credentials_port import (\n38:def api_key_credentials(env_var: str) -> PlatformCredentialProvider:\n43:class MistralCredentials:\n49:    def cached_principal(self) -> str | None:\n55:def mistral_credentials(\n69:        selected = (credentials or api_key_credentials)(provider.api_key_env_var)\n78:async def resolve_principal(\n79:    mistral: MistralCredentials, base_url: str | None = None\n88:        target = PlatformCredentialTarget(base_url or mistral.provider.api_base)\n98:def is_user_principal(key: str) -> bool:\n104:def may_cache_under(key: str | None, *, fetched_for: str | None) -> bool:\n115:def fetched_for_current_account(\n131:async def resolve_snapshot(\n135:    target = platform_target(url)\n141:def platform_target(url: str) -> PlatformCredentialTarget | None:\n151:async def credential_request(\n168:    from vibe.core.platform_auth._http import PlatformCredentialUnavailable\n201:def _origin_and_path(url: str) -> str:\n210:    \"api_key_credentials\",\n216:    \"platform_target\",\n=== CONSTANTS ===\nfrom __future__ import annotations\n\nfrom typing import Final\n\nMODEL_CATALOG_PATH: Final = \"/model-catalog\"\n\nMODEL_CATALOG_SURFACE: Final = \"vibe-code\"\n\n# Matches EVAL_REQUEST_TIMEOUT_SECONDS, per connection phase.\nMODEL_CATALOG_TIMEOUT_SECONDS: Final = 5.0\n\n# The HTTP timeout above bounds each connection phase, not the request, so the\n# wait on a fetch is capped on its own.\nMODEL_CATALOG_WAIT_CAP_SECONDS: Final = 5.0\n\n# A catalog this old may advertise retired models. Longer than the\n# experiment-eval TTL because a model list moves far less than a variant.\nMODEL_CATALOG_CACHE_TTL_SECONDS: Final = 30 * 24 * 60 * 60\n\n\ndef build_model_catalog_url(api_base: str) -> str | None:\n    \"\"\"Build the catalog URL from a Mistral provider's ``api_base``.\n\n    Returns None when ``api_base`` is empty, so a misconfigured provider makes\n    the fetch a no-op rather than a request to a garbage URL.\n    \"\"\"\n    api_base = api_base.strip().rstrip(\"/\")\n    if not api_base:\n        return None\n    return f\"{api_base}{MODEL_CATALOG_PATH}?surface={MODEL_CATALOG_SURFACE}\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"V=~/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; sed -n '1,80p' $V/core/platform_auth/_api_key.py; echo \\\"=== MISTRAL ===\\\"; grep -n \\\"base_url\\\\|api_key\\\\|console\\\\|platform\\\\|class \\\\|def \\\" $V/core/platform_auth/_mistral.py | head -40; echo \\\"=== CONSTANTS ===\\\"; sed -n '1,60p' $V/core/model_catalog/_constants.py\"}"},"time":{"start":1794659267785,"end":1794659268390}}}}
