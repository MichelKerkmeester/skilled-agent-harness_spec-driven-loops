281:             );\n1282:             EOF\n1283:           working_directory: \"{repo_root}\"\n1284:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1285:           wait_for_completion: true\n1286:           notes:\n1287:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1288:             - \"claude-code has no serviceTier flag\"\n1289:             - \"claude-code supports --effort for reasoning depth\"\n1290:         if_cli_cursor:\n1291:           command: |\n1292:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1293:             import { readFileSync } from 'node:fs';\n1294:             import { createRequire } from 'node:module';\n1295:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1296:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1297:             import {\n1298:               snapshotOutOfScopeDirtyPaths,\n1299:               enforceWriteContainment,\n1300:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1301: \n1302:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1303:             // without this they silently degrade to native. The command builder is the\n1304:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1305:             // headless write-mode flags, and binary preflight stay one source of truth.\n1306:             // It throws (fail closed) when the binary is absent or the model is off the\n1307:             // allowlist, so a requested CLI executor never becomes native.\n1308:             const require = createRequire(import.meta.url);\n1309:             const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1310: \n1311:             const kind = '{config.executor.kind}';\n1312:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1313:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1314:             // The iteration must write its own iteration file, delta and state record,\n1315:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1316:             // write-permitting headless flags.\n1317:             const sandboxMode = 'workspace-write';\n1318:             const lineage = { kind, model, sandboxMode };\n1319:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1320:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1321: \n1322:             const repoRoot = '{repo_root}';\n1323:             const promptBody = withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n1324:             const { command, args, input } = buildLineageCommand(\n1325:               lineage,\n1326:               promptBody,\n1327:               resolvedSandbox,\n1328:               resolvedPermission,\n1329:               { env: process.env, cwd: repoRoot },\n1330:             );\n1331: \n1332:             const executor = {\n1333:               kind,\n1334:               model,\n1335:               configDir: null,\n1336:               reasoningEffort: null,\n1337:               serviceTier: null,\n1338:               sandboxMode,\n1339:               timeoutSeconds,\n1340:               governor: null,\n1341:             };\n1342:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1343:             const artifactDir = '{artifact_dir}';\n1344:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1345:             const dispatchExit = runAuditedExecutorCommand({\n1346:               command,\n1347:               args,\n1348:               cwd: repoRoot,\n1349:               timeoutSeconds,\n1350:               stateLogPath: '{state_paths.state_log}',\n1351:               executor,\n1352:               iteration: Number('{current_iteration}'),\n1353:               input,\n1354:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1355:               dispatchId,\n1356:             });\n1357:             const containment = enforceWriteContainment({\n1358:               repoRoot,\n1359:               artifactDir,\n1360:               preDispatchDirtyPaths,\n1361:               stateLogPath: '{state_paths.state_log}',\n1362:               iteration: Number('{current_iteration}'),\n1363:               label: dispatchId,\n1364:             });\n1365:             if (containment.violations.length > 0) {\n1366:               console.error(\n1367:                 'write-containment advisory: detected ' + containment.violations.length\n1368:                   + ' out-of-scope path(s), left on disk: '\n1369:                   + containment.violations.map((v) => v.path).join(', '),\n1370:               );\n1371:             }\n1372:             // A path that was already dirty before the dispatch and changed during it is held out of\n1373:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n1374:             // this prints it so the run's own output says so too.\n1375:             if (containment.contested.length > 0) {\n1376:               console.error(\n1377:                 'write-containment contested: ' + containment.contested.length\n1378:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n1379:                   + containment.contested.map