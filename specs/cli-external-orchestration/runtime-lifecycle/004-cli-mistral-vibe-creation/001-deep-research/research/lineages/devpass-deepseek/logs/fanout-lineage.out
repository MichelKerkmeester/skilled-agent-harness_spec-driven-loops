es 180-254\n180:     # We allow FIFO path to support some environment management solutions (e.g. https://developer.1password.com/docs/environments/local-env-file/)\n181:     if not env_path.is_file() and not env_path.is_fifo():\n182:         return\n183: \n184:     env_vars = dotenv_values(env_path)\n185:     # Only injections into the real process environment are recorded: a caller\n186:     # passing a private mapping (tests) did not change where this process's\n187:     # credentials come from.\n188:     record_injection = environ is os.environ\n189:     for key, value in env_vars.items():\n190:         if not value:\n191:             continue\n192:         if environ.get(key):\n193:             # An explicit non-empty process/shell value wins over the .env file.\n194:             continue\n195:         environ[key] = value\n196:         if record_injection:\n197:             record_env_value_origin(key, value, EnvValueOrigin.VIBE_HOME_ENV_FILE)\n198: \n199: \n200: DEFAULT_PROVIDERS = [\n201:     ProviderConfig(\n202:         name=\"mistral\",\n203:         api_base=DEFAULT_MISTRAL_API_BASE,\n204:         api_key_env_var=DEFAULT_MISTRAL_API_ENV_KEY,\n205:         browser_auth_base_url=DEFAULT_MISTRAL_BROWSER_AUTH_BASE_URL,\n206:         browser_auth_api_base_url=DEFAULT_MISTRAL_BROWSER_AUTH_API_BASE_URL,\n207:         backend=Backend.MISTRAL,\n208:     ),\n209:     ProviderConfig(\n210:         name=\"llamacpp\",\n211:         api_base=\"http://127.0.0.1:8080/v1\",\n212:         api_key_env_var=\"\",  # NOTE: if you wish to use --api-key in llama-server, change this value\n213:     ),\n214: ]\n215: \n216: DEFAULT_ACTIVE_MODEL_CONFIG = ModelConfig(\n217:     name=\"mistral-vibe-cli-latest\",\n218:     provider=\"mistral\",\n219:     alias=\"mistral-medium-3.5\",\n220:     display_name=\"Mistral Medium 3.5\",\n221:     temperature=1.0,\n222:     input_price=1.5,\n223:     output_price=7.5,\n224:     cached_input_price=0.15,\n225:     thinking=\"high\",\n226:     supports_images=True,\n227:     thinking_levels=[\"off\", \"high\"],\n228:     max_context_length=262144,  # 256k window per the model card\n229: )\n230: \n231: DEFAULT_MODELS = [DEFAULT_ACTIVE_MODEL_CONFIG]\n232: \n233: # Sentinel ``active_model`` value meaning \"not pinned\": the config resolves it to\n234: # the default model (see ``get_active_model``). Kept distinct from pinning the\n235: # alias that happens to be the current default, which is a deliberate choice.\n236: UNPINNED_ACTIVE_MODEL = \"\"\n237: \n238: DEFAULT_TRANSCRIBE_PROVIDERS = [\n239:     TranscribeProviderConfig(\n240:         name=\"mistral\",\n241:         api_base=\"wss://api.mistral.ai\",\n242:         api_key_env_var=DEFAULT_MISTRAL_API_ENV_KEY,\n243:     )\n244: ]\n245: \n246: DEFAULT_ACTIVE_TRANSCRIBE_MODEL_CONFIG = TranscribeModelConfig(\n247:     name=\"voxtral-mini-transcribe-realtime-2602\",\n248:     provider=\"mistral\",\n249:     alias=\"voxtral-realtime\",\n250: )\n251: \n252: DEFAULT_TRANSCRIBE_MODELS = [DEFAULT_ACTIVE_TRANSCRIBE_MODEL_CONFIG]\n253: \n254: DEFAULT_TTS_PROVIDERS = [\n[Output truncated. Continue reading with offset: 255]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 75, \"offset\": 180, \"path\": \"/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/core/config/vibe_schema.py\"}"},"time":{"start":1794659287728,"end":1794659288448}}}}
{"type":"tool_use","timestamp":1794659288464,"sessionID":"ses_e25fd45d8ffe2Iv7ljplDZNbln","part":{"partID":"prt_1da078429001mjoBBU4tRQdOEH","sessionID":"ses_e25fd45d8ffe2Iv7ljplDZNbln","messageID":"msg_1da077160001YSgk5rfiNUNctG","type":"tool","id":"chatcmpl-tool-bba3f35220e63ca3","tool":"read","state":{"status":"completed","input":{"limit":80,"offset":40,"path":"/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/core/platform_auth/_mistral.py"},"output":"Read file /Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/core/platform_auth/_mistral.py, lines 40-119\n40: \n41: \n42: @dataclass(frozen=True, slots=True)\n43: class MistralCredentials:\n44:     \"\"\"A config's Mistral provider and the credential its calls carry.\"\"\"\n45: \n46:     provider: ProviderConfig\n47:     credentials: PlatformCredentialProvider\n48: \n49:     def cached_principal(self) -> str | None:\n50:         if isinstance(self.credentials, CachedPrincipal):\n51:             return self.credentials.cached_principal()\n52:         return None\n53: \n54: \n55: def mistral_credentials(\n56:     config: VibeConfigSchema, credentials: PlatformCredentialFactory | None = None\n57: ) -> MistralCredentials | None:\n58:     \"\"\"The config's Mistral provider with its credential; ``None`` without one.\n59: \n60:     Prefers the active provider when it is a Mistral provider, else the first\n61:     configured one: a third-party credential never reaches a first-party\n62:     endpoint. ``None`` also when the credential is known to be absent (no API\n63:     key, no stored sign-in), so callers skip the request.\n64:     \"\"\"\n65:     try:\n66:         provider = config.get_mistral_provider()\n67:         if provider is None:\n68:             return None\n69:         selected = (credentials or api_key_credentials)(provider.api_key_env_var)\n70:         if isinstance(selected, CachedPrincipal) and not selected.has_credential():\n71:             return None\n72:     except Exception:\n73:         # A first-party call is optional: an unreadable credential skips it.\n74:         return None\n75:     return MistralCredentials(provider, selected)\n76: \n77: \n78: async def resolve_principal(\n79:     mistral: MistralCredentials, base_url: str | None = None\n80: ) -> str | None:\n81:     \"\"\"The principal a fetch starts under, resolving (and refreshing) the\n82:     credential when nothing is cached. ``None`` when it cannot be resolved in\n83:     time: fetch, but cache nothing.\n84:     \"\"\"\n85:     if (principal := mistral.cached_principal()) is not None:\n86:         return principal\n87:     try:\n88:         target = PlatformCredentialTarget(base_url or mistral.provider.api_base)\n89:         async with asyncio.timeout(_PRINCIPAL_TIMEOUT_SECONDS):\n90:             snapshot = await mistral.credentials.resolve(target)\n91:     except Exception:\n92:         return None\n93:     if isinstance(snapshot, PlatformCredentialRequired):\n94:         return None\n95:     return snapshot.principal\n96: \n97: \n98: def is_user_principal(key: str) -> bool:\n99:     from vibe.utils.oidc_marker import OIDC_CACHE_KEY_PREFIX\n100: \n101:     return key.startswith((OIDC_PRINCIPAL_PREFIX, OIDC_CACHE_KEY_PREFIX))\n102: \n103: \n104: def may_cache_under(key: str | None, *, fetched_for: str | None) -> bool:\n105:     \"\"\"Whether a response fetched for ``fetched_for`` may be stored under the\n106:     current principal ``key``. An API key's principal names the material the\n107:     request carried; a user token's does not, so a sign-in during the fetch\n108:     makes the response another account's.\n109:     \"\"\"\n110:     if key is None:\n111:         return False\n112:     return key == fetched_for or (fetched_for is None and not is_user_principal(key))\n113: \n114: \n115: def fetched_for_current_account(\n116:     credentials: PlatformCredentialProvider, fetched_for: str\n117: ) -> bool:\n118:     \"\"\"Whether a response fetched for the principal ``fetched_for`` is still\n119:     the signed-in account's. An API key's principal names the material the\n[Output truncated. Continue reading with offset: 120]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/core/platform_auth/_mistral.py, lines 40-119\n40: \n41: \n42: @dataclass(frozen=True, slots=True)\n43: class MistralCredentials:\n44:     \"\"\"A config's Mistral provider and the credential its calls carry.\"\"\"\n45: \n46:     provider: ProviderConfig\n47:     credentials: PlatformCredentialProvider\n48: \n49:     def cached_principal(self) -> str | None:\n50:         if isinstance(self.credentials, CachedPrincipal):\n51:             return self.credentials.cached_principal()\n52:         return None\n53: \n54: \n55: def mistral_credentials(\n56:     config: VibeConfigSchema, credentials: PlatformCredentialFactory | None = None\n57: ) -> MistralCredentials | None:\n58:     \"\"\"The config's Mistral provider with its credential; ``None`` without one.\n59: \n60:     Prefers the active provider when it is a Mistral provider, else the first\n61:     configured one: a third-party credential never reaches a first-party\n62:     endpoint. ``None`` also when the credential is known to be absent (no API\n63:     key, no stored sign-in), so callers skip the request.\n64:     \"\"\"\n65:     try:\n66:         provider = config.get_mistral_provider()\n67:         if provider is None:\n68:             return None\n69:         selected = (credentials or api_key_credentials)(provider.api_key_env_var)\n70:         if isinstance(selected, CachedPrincipal) and not selected.has_credential():\n71:             return None\n72:     except Exception:\n73:         # A first-party call is optional: an unreadable credential skips it.\n74:         return None\n75:     return MistralCr