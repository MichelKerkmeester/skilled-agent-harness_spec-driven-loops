neages/devpass-deepseek\\\" && jq '.metrics, (.keyFindings|length), (.resolvedQuestions|length), (.openQuestions|length)' \\\"$LIN/findings-registry.json\\\"\"}"},"time":{"start":1794659916166,"end":1794659916211}}}}
