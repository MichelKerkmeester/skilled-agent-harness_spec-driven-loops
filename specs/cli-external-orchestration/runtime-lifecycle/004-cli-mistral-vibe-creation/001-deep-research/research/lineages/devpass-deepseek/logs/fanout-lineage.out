{"type":"tool_use","timestamp":1794659809084,"sessionID":"ses_e25fd45d8ffe2Iv7ljplDZNbln","part":{"partID":"prt_1da0f76df002SdL4orxSI8r75l","sessionID":"ses_e25fd45d8ffe2Iv7ljplDZNbln","messageID":"msg_1da0f6c1b001pZ7u8b7zhPFXLg","type":"tool","id":"chatcmpl-tool-a3ab05bcb9fd13ca","tool":"read","state":{"status":"completed","input":{"limit":90,"offset":263,"path":".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts"},"output":"Read file .skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts, lines 263-352\n263: /** True when `model` is in the enforced cli-pi allowlist. */\n264: export function isPiModelAllowed(model: string): model is PiSupportedModel {\n265:   return (PI_SUPPORTED_MODELS as readonly string[]).includes(model);\n266: }\n267: \n268: /** Keep explicit route selection available, with only the verified Gateway route as default. */\n269: export const DSH_SUPPORTED_MODELS = [\n270:   'deepseek-v4.1-flash-1017',\n271:   'deepseek-v4.1-flash', // OpenCode Go is configured, not verified, and remains explicit-only.\n272: ] as const;\n273: export type DshSupportedModel = typeof DSH_SUPPORTED_MODELS[number];\n274: \n275: export const DSH_DEFAULT_MODEL: DshSupportedModel = 'deepseek-v4.1-flash-1017';\n276: \n277: export function isDshModelAllowed(model: string): model is DshSupportedModel {\n278:   return (DSH_SUPPORTED_MODELS as readonly string[]).includes(model);\n279: }\n280: \n281: /**\n282:  * DeepSeek V4 Flash and GLM-5.3-Flash are reasoning models pinned to their TOP tier: they are\n283:  * never dispatched at a lower effort. Both top out at `max` on every route reachable from\n284:  * here, so one pin covers them.\n285:  *\n286:  * A model's top tier is a property of the ROUTE, not of the model name. GLM-5.3-Flash\n287:  * exposes `low`/`high`/`max` on OpenRouter, opencode-go and DevPass — the routes whose\n288:  * literals reach this function — and has no `xhigh` on either, so pinning a GLM literal to\n289:  * `xhigh` would send the fan-out routes a tier their provider does not offer.\n290:  *\n291:  * DeepSeek's id is bare on cli-pi (`deepseek-v4.1-flash-1017`, fronted by DevPass) and\n292:  * cli-deepseek-harness, and provider-prefixed on cli-opencode\n293:  * (`deepseek/deepseek-v4-flash`, `opencode-go/deepseek-v4.1-flash`); the OpenRouter `-latest`\n294:  * variant (`deepseek/deepseek-v4-flash-latest`) is the same reasoning family and is pinned\n295:  * too. GLM-5.3-Flash is matched on both its bare DevPass literal (`glm-5.3-flash`) and\n296:  * its OpenRouter vendor-prefixed literal (`z-ai/glm-5.3-flash`); DevPass offers `max`, so the\n297:  * pin lands on a tier that route actually has. The devin `-max` uid already\n298:  * bakes the tier into the id and is intentionally not matched here.\n299:  */\n300: export function isFlashMaxPinnedModel(model: string): boolean {\n301:   return /(^|\\/)(deepseek-v4-flash(-latest|-vision-exp)?|deepseek-v4\\.1-flash(-1017)?|glm-5\\.3-flash)$/.test(model);\n302: }\n303: \n304: /** Effective reasoning effort after the Flash top-tier pin. */\n305: export function pinReasoningEffortForModel(\n306:   model: string,\n307:   reasoningEffort: string | null | undefined,\n308: ): string | null | undefined {\n309:   return isFlashMaxPinnedModel(model) ? 'max' : reasoningEffort;\n310: }\n311: \n312: /**\n313:  * Enforced allowlist of cursor-agent --model ids. Cursor's live roster spans\n314:  * 150+ hosted-frontier ids across GPT/Claude/Gemini/Grok/GLM/Kimi families,\n315:  * with no per-model prompt-craft data for almost all of them and ids that\n316:  * drift over time — dispatch is scoped to this curated set only, confirmed\n317:  * live via `cursor-agent --list-models` (2026-08-12, account\n318:  * mkerkmeester@proton.me, cursor-agent 2026.08.11-e8db854; no id here was\n319:  * ever fabricated). This is a hard gate, not a typo-checked reference: any\n320:  * caller-supplied model outside this set must be rejected before a command\n321:  * is constructed. `auto` (Cursor's own router) is deliberately excluded — it\n322:  * can silently resolve to a model outside this allowlist, defeating the\n323:  * point of enforcing one. Entries are sorted alphabetically, not grouped by\n324:  * family.\n325:  *\n326:  * Grok 4.6 joined this allowlist alongside Grok 4.5 (2026-08-12) — both\n327:  * versions are live and dispatchable on Cursor, so this is an addition, not\n328:  * a swap. 4.6 adds a fourth tier, xhigh, that 4.5 never had (8 ids:\n329:  * low/medium/high/xhigh, each with a -fast sibling); 4.5 keeps its original\n330:  * 6 (low/medium/high, each with a -fast sibling). All 8 Grok 4.6 ids were\n331:  * live-dispatch-tested end-to-end before being added here.\n332:  *\n333:  * GPT-5.6 Luna Max joined this allowlist (2026-08-14): gpt-5.6-luna-max and\n334:  * gpt-5.6-luna-max-fast — the first GPT-5.6 persona in the curated Cursor\n335:  * scope. Both ids were confirmed present verbatim in the live\n336:  * `cursor-agent --list-models` output on 2026-08-14 (\"GPT-5.6 Luna 1M Max\" /\n337:  * \"GPT-5.6 Luna Max Fast\"). Unlike the Grok entries above, these two were\n338:  * list-verified only, NOT dispatch-tested (operator decision) — no\n339:  * dispatch-test claim is made for them.\n340:  *\n341:  * Gemini 3.7 Flash High joined this allowlist (2026-08-15):\n342:  * gemini-3.8-flash-high — the Gemini id in the curated Cursor scope, moved up\n343:  * from 3.7 on 2026-09-04 once cursor-agent listed the 3.8 tiers.\n344:  * Cursor's display name is just \"Gemini 3.7 Flash\" but the id carries the\n345:  * -high suffix; the low and medium sibling tiers stay out of scope.\n346:  * Confirmed present verbatim in the live `cursor-agent --list-models` output\n347:  * and dispatch-tested end-to-end (probe dispatch returned a live model\n348:  * response, exit 0) on 2026-08-15.\n349:  *\n350:  * Grok 4.7 joined this allowlist alongside Grok 4.5 and 4.6 (2026-09-26).\n351:  * Cursor lists its ids without the `cursor-` prefix the older Grok ids carry,\n352:  * so they sort with the g-ids rather than beside them. All 8 ids\n[Output truncated. Continue reading with offset: 353]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts, lines 263-352\n263: /** True when `model` is in the enforced cli-pi allowlist. */\n264: export function isPiModelAllowed(model: string): model is PiSupportedModel {\n265:   return (PI_SUPPORTED_MODELS as readonly string[]).includes(model);\n266: }\n267: \n268: /** Keep explicit route selection available, with only the verified Gateway route as default. */\n269: export const DSH_SUPPORTED_MODELS = [\n270:   'deepseek-v4.1-flash-1017',\n271:   'deepseek-v4.1-flash', // OpenCode Go is configured, not verified, and remains explicit-only.\n272: ] as const;\n273: export type DshSupportedModel = typeof DSH_SUPPORTED_MODELS[number];\n274: \n275: export const DSH_DEFAULT_MODEL: DshSupportedModel = 'deepseek-v4.1-flash-1017';\n276: \n277: export function isDshModelAllowed(model: string): model is DshSupportedModel {\n278:   return (DSH_SUPPORTED_MODELS as readonly string[]).includes(model);\n279: }\n280: \n281: /**\n282:  * DeepSeek V4 Flash and GLM-5.3-Flash are reasoning models pinned to their TOP tier: they are\n283:  * never dispatched at a lower effort. Both top out at `max` on every route reachable from\n284:  * here, so one pin covers them.\n285:  *\n286:  * A model's top tier is a property of the ROUTE, not of the model name. GLM-5.3-Flash\n287:  * exposes `low`/`high`/`max` on OpenRouter, opencode-go and DevPass — the routes whose\n288:  * literals reach this function — and has no `xhigh` on either, so pinning a GLM literal to\n289:  * `xhigh` would send the fan-out routes a tier their provider does not offer.\n290:  *\n291:  * DeepSeek's id is bare on cli-pi (`deepseek-v4.1-flash-1017`, fronted by DevPass) and\n292:  * cli-deepseek-harness, and provider-prefixed on cli-opencode\n293:  * (`deepseek/deepseek-v4-flash`, `opencode-go/deepseek-v4.1-flash`); the OpenRouter `-latest`\n294:  * variant (`deepseek/deepseek-v4-flash-latest`) is the same reasoning family and is pinned\n295:  * too. GLM-5.3-Flash is matched on both its bare DevPass literal (`glm-5.3-flash`) and\n296:  * its OpenRouter vendor-prefixed literal (`z-ai/glm-5.3-flash`); DevPass offers `max`, so the\n297:  * pin lands on a tier that route actually has. The devin `-max` uid already\n298:  * bakes the tier into the id and is intentionally not matched here.\n299:  */\n300: export function isFlashMaxPinnedModel(model: string): boolean {\n301:   return /(^|\\/)(deepseek-v4-flash(-latest|-vision-exp)?|deepseek-v4\\.1-flash(-1017)?|glm-5\\.3-flash)$/.test(model);\n302: }\n303: \n304: /** Effective reasoning effort after the Flash top-tier pin. */\n305: export function pinReasoningEffortForModel(\n306:   model: string,\n307:   reasoningEffort: string | null | undefined,\n308: ): string | null | undefined {\n309:   return isFlashMaxPinnedModel(model) ? 'max' : reasoningEffort;\n310: }\n311: \n312: /**\n313:  * Enforced allowlist of cursor-agent --model ids. Cursor's live roster spans\n314:  * 150+ hosted-frontier ids across GPT/Claude/Gemini/Grok/GLM/Kimi families,\n315:  * with no per-model prompt-craft data for almost all of them and ids that\n316:  * drift over time — dispatch is scoped to this curated set only, confirmed\n317:  * live via `cursor-agent --list-models` (2026-08-12, account\n318:  * mkerkmeester@proton.me, cursor-agent 2026.08.11-e8db854; no id here was\n319:  * ever fabricated). This is a hard gate, not a typo-checked reference: any\n320:  * caller-supplied model outside this set must be rejected before a command\n321:  * is constructed. `auto` (Cursor's own router) is deliberately excluded — it\n322:  * can silently resolve to a model outside this allowlist, defeating the\n323:  * point of enforcing one. Entries are sorted alphabetically, not grouped by\n324:  * family.\n325:  *\n326:  * Grok 4.6 joined this allowlist alongside Grok 4.5 (2026-08-12) — both\n327:  * versions are live and dispatchable on Cursor, so this is an addition, not\n328:  * a swap. 4.6 adds a fourth tier, xhigh, that 4.5 never had (8 ids:\n329:  * low/medium/high/xhigh, each with a -fast sibling); 4.5 keeps its original\n330:  * 6 (low/medium/high, each with a -fast sibling). All 8 Grok 4.6 ids were\n331:  * live-dispatch-tested end-to-end before being added here.\n332:  *\n333:  * GPT-5.6 Luna Max joined this allowlist (2026-08-14): gpt-5.6-luna-max and\n334:  * gpt-5.6-luna-max-fast — the first GPT-5.6 persona in the curated Cursor\n335:  * scope. Both ids were confirmed present verbatim in the live\n336:  * `cursor-agent --list-models` output on 2026-08-14 (\"GPT-5.6 Luna 1M Max\" /\n337:  * \"GPT-5.6 Luna Max Fast\"). Unlike the Grok entries above, these two were\n338:  * list-verified only, NOT dispatch-tested (operator decision) — no\n339:  * dispatch-test claim is made for them.\n340:  *\n341:  * Gemini 3.7 Flash High joined this allowlist (2026-08-15):\n342:  * gemini-3.8-flash-high — the Gemini id in the curated Cursor scope, moved up\n343:  * from 3.7 on 2026-09-04 once cursor-agent listed the 3.8 tiers.\n344:  * Cursor's display name is just \"Gemini 3.7 Flash\" but the id carries the\n345:  * -high suffix; the low and medium sibling tiers stay out of scope.\n346:  * Confirmed present verbatim in the live `cursor-agent --list-models` output\n347:  * and dispatch-tested end-to-end (probe dispatch returned a live model\n348:  * response, exit 0) on 2026-08-15.\n349:  *\n350:  * Grok 4.7 joined this allowlist alongside Grok 4.5 and 4.6 (2026-09-26).\n351:  * Cursor lists its ids without the `cursor-` prefix the older Grok ids carry,\n352:  * so they sort with the g-ids rather than beside them. All 8 ids\n[Output truncated. Continue reading with offset: 353]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 90, \"offset\": 263, \"path\": \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts\"}"},"time":{"start":1794659808991,"end":1794659809084}}}}
