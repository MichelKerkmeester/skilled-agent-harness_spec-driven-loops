:    agent_paths: Annotated[list[Path], WithConcatMerge()] = Field(\n/Users/michelkerkmeester/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe/core/config/vibe_schema.py:898:    installed_agents: Annotated[list[str], WithConcatMerge()] = Field(\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"V=~/.local/share/uv/tools/mistral-vibe/lib/python3.12/site-packages/vibe; grep -rn \\\"AGENTS_MD_FILENAME\\\" $V --include=*.py | head -10; echo \\\"=== SYSTEM PROMPT ===\\\"; grep -n \\\"project_context\\\\|AGENTS\\\\|agents_md\\\\|def \\\" $V/core/system_prompt.py | head -30; echo \\\"=== AGENT PATHS ===\\\"; grep -rn \\\"agent_paths\\\\|installed_agents\\\\|\\\\.vibe.*agents\\\\|agents.*toml\\\" $V/core/config/vibe_schema.py $V/agents.py | head -25\"}"},"time":{"start":1794659374265,"end":1794659374967}}}}
