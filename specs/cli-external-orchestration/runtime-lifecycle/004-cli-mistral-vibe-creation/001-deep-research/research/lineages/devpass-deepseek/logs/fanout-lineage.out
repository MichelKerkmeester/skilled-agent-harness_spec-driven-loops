sandboxMode };\n1635:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1636:             const repoRoot = '{repo_root}';\n1637:             const { command, args, input, cwd } = buildLineageCommand(\n1638:               lineage,\n1639:               message,\n1640:               sandboxMode,\n1641:               resolvedPermission,\n1642:               { env: process.env, cwd: repoRoot, directoryRoot: repoRoot },\n1643:             );\n1644: \n1645:             const dispatchFacts = {\n1646:               command: 'deep/research',\n1647:               mode: 'research',\n1648:               specFolder: '{spec_folder}',\n1649:               artifactDir: '{state_paths.packet_dir}',\n1650:               iteration: Number('{current_iteration}'),\n1651:               executorKind: '{config.executor.kind}',\n1652:               branchId: '{config.executor.kind}',\n1653:               sessionId: '{config.lineage.sessionId}',\n1654:               generation: Number('{config.lineage.generation}'),\n1655:             };\n1656:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1657:             process.exit(\n1658:               runAuditedExecutorCommand({\n1659:                 command,\n1660:                 args,\n1661:                 cwd: cwd || repoRoot,\n1662:                 timeoutSeconds: executor.timeoutSeconds,\n1663:                 stateLogPath: '{state_paths.state_log}',\n1664:                 executor,\n1665:                 iteration: Number('{current_iteration}'),\n1666:                 // buildLineageCommand returns empty input, so stdin is closed for OpenCode.\n1667:                 input,\n1668:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1669:                 dispatchId,\n1670:               }),\n1671:             );\n1672:             EOF\n1673:           working_directory: \"{repo_root}\"\n1674:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1675:           wait_for_completion: true\n1676:           notes:\n1677:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1678:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1679:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1680:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1681:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1682:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1683:         if_cli_codex:\n1684:           command: |\n1685:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1686:             import { readFileSync } from 'node:fs';\n1687:             import { execFileSync } from 'node:child_process';\n1688:             import { createRequire } from 'node:module';\n1689: \n1690:             import {\n1691:               RECURSION_GUARD_EXIT_CODE,\n1692:               formatRecursionGuardRefusal,\n1693:               runAuditedExecutorCommand,\n1694:               validateExecutorDispatchAllowed,\n1695:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1696:             import {\n1697:               snapshotOutOfScopeDirtyPaths,\n1698:               enforceWriteContainment,\n1699:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1700: \n1701:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1702:             // never silently degrade to another executor. Undetected absence is what\n1703:             // got Codex deprecated before, so the branch exits non-zero when the\n1704:             // binary is missing instead of falling through to a native/other path.\n1705:             let codexAvailable = false;\n1706:             try {\n1707:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1708:               codexAvailable = true;\n1709:             } catch {}\n1710:             if (!codexAvailable) {\n1711:               console.error('cli-codex executor unavailable: command -v codex failed');\n1712:               process.exit(1);\n1713:             }\n1714: \n1715:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1716:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1717:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1718:             const executor = {\n1719:               kind: 'cli-codex',\n1720:               model,\n1721:               configDir: null,\n1722:               reasoningEffort,\n1723:               serviceTier,\n1724:               sandboxMode: 'workspace-write',\n1725:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1726:               governor: null,\n1727:             };\n1728: \n1729:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1730:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1731:             // or a codex session must run the iteration itself, not delegate it onward.\n1732:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1733:             if (!guardVerdict.allowed) {\n1734:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1735:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1736:             }\n1737: \n1738:             const require = createRequire(import.meta.url);\n1739:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1740:             const promptBody = withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}');\n1741: \n1742:             // codex reads the iteration prompt from stdin via the trailing '-'. A research\n1743:             // iteration must WRITE its own iteration file, delta and state record, so the\n1744:             // sandbox is workspace-write — read-only would block those required writes.\n1745:             // approval_policy=never keeps the run non-interactive.\n1746:             const args = ['exec'];\n1747:             if (model) {\n1748:               args.push('--model', model);\n1749:             }\n[Output truncated. Continue reading with offset: 1750]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 500, \"offset\": 1250, \"path\": \".skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1794659008696,"end":1794659008719}}}}
