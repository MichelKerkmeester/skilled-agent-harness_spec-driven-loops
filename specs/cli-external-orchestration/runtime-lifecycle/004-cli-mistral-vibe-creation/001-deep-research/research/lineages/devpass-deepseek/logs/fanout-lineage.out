outcome\"\n977:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n978:                 command: |\n979:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n980:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n981:                   const status = '{pivot_seat_002_dispatch_status}';\n982:                   const outcome = status === 'fulfilled'\n983:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n984:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n985:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n986:                   EOF\n987:                 working_directory: \"{repo_root}\"\n988: \n989:               step_dispatch_pivot_seat_003:\n990:                 action: \"Natively dispatch the pragmatic research direction-selection seat\"\n991:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n992:                 capture_timing: true\n993:                 if_native:\n994:                   dispatch:\n995:                     agent: deep-research\n996:                     model: opus\n997:                     context_source: \"pivot_seat_003_prompt\"\n998:                   wait_for_completion: true\n999:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1000:                 outputs:\n1001:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1002:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1003:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1004:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1005:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1006:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1007: \n1008:               step_record_pivot_seat_003:\n1009:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1010:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1011:                 command: |\n1012:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1013:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1014:                   const status = '{pivot_seat_003_dispatch_status}';\n1015:                   const outcome = status === 'fulfilled'\n1016:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1017:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1018:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1019:                   EOF\n1020:                 working_directory: \"{repo_root}\"\n1021: \n1022:               step_finalize_divergent_pivot:\n1023:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1024:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1025:                 command: |\n1026:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1027:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1028:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1029:                   EOF\n1030:                 working_directory: \"{repo_root}\"\n1031:                 outputs:\n1032:                   - pivot_finalize_json: \"The complete parsed final result\"\n1033: \n1034:               step_resolve_divergent_pivot_result:\n1035:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1036:                 branch_on: \"pivot_prepare_status\"\n1037:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1038:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1039: \n1040:               step_apply_divergent_pivot_result:\n1041:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1042:                 branch_on: \"pivot_result.status\"\n1043:                 if_completed:\n1044:                   set:\n1045:                     next_focus: \"{pivot_result.restoredFocus}\"\n1046:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1047:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1048:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1049:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1050:                   proceed_to: step_rejected_pattern_cache\n1051:                 if_failed:\n1052:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1053:                   skip_to: phase_synthesis\n1054:             on_error:\n1055:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1056:               skip_to: phase_synthesis\n1057:           if_existing_terminal_path:\n1058:             log: \"Loop stopping. Reason: {reason}\"\n1059:             skip_to: phase_synthesis\n1060:         if_stuck_recovery:\n1061:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1062:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1063:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1064:           reset: { stuck_count: 0 }\n1065:         if_continue:\n1066:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1067: \n1068:       step_rejected_pattern_cache:\n1069:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1070:         read:\n1071:           - \"{state_paths.state_log}\"\n1072:           - \"{state_paths.registry}\"\n1073:           - \"{state_paths.strategy}\"\n1074:         candidate_sources:\n1075:           next_focus:\n1076:             category: \"next-focus\"\n1077:             values:\n1078:               - \"{next_focus}\"\n1079:               - \"{remaining_questions_list}\"\n1080:               - \"{carried_forward_open_questions}\"\n1081:           recovery:\n1082:             category: \"recovery\"\n1083:             values:\n1084:               - \"{recovery_strategy}\"\n1085:               - \"{least_explored}\"\n1086:           ideas:\n1087:             category: \"ideas\"\n1088:             values:\n1089:               - \"{promoted_ideas_list}\"\n1090:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1091:         algorithm: |\n1092:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1093:           reducer pass as the source of truth.\n1094:           Compare normalized exact text first. Then compare fuzzy similarity with\n1095:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1096:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1097:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1098:           halt for operator input instead of reusing a rejected idea.\n1099:         outputs:\n1100:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1101:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1102:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1103:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1104:         if_next_focus_suppressed:\n1105:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1106:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1107:         if_all_candidates_suppressed:\n1108:           halt: true\n1109:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1110: \n1111:       step_ideas_backlog_lifecycle:\n1112:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1113:         read:\n1114:           - \"{state_paths.state_log}\"\n1115:           - \"{state_paths.registry}\"\n1116:           - \"{state_paths.config}\"\n1117:         lifecycle:\n1118:           observed_event: \"idea_observed\"\n1119:           promoted_event: \"idea_promoted\"\n1120:           rejected_event: \"idea_rejected\"\n1121:           min_observations: \"{min_idea_observations}\"\n1122:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1123:         validate:\n1124:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1125:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1126:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1127:         outputs:\n1128:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1129:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1130:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1131:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1132: \n1133:       step_normalize_pause_events:\n1134:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1135:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n1136:         rule_pause_sentinel:\n1137:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1138:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1139:         rule_stuck_recovery:\n1140:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1141:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1142: \n1143:       step_marker_scan:\n1144:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1145:         canonical_header: \"DEEP-RESEARCH\"\n1146:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1147:         algorithm: |\n1148:           if current_iteration > 1:\n1149:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1150:             if file_exists(PREV_PROMPT_PATH):\n1151:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1152:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1153:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1154:                 halt with exit code 2\n1155:         note: |\n1156:           False-positive prevention: a research prompt that starts with its own canonical\n1157:           header is this loop's own iteration output, never a nested dispatch; only a review\n1158:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1159:           header. Markers appearing in comments or body text are ignored. True-positive\n1160:           triggers only when a previous iteration's rendered prompt literally starts with a\n1161:           review marker, indicating a nested research-of-review dispatch.\n1162: \n1163:       step_dispatch_iteration:\n1164:         action: \"Dispatch one iteration via the selected executor\"\n1165:         resolve_executor:\n1166:           source: \"config.executor\"\n1167:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1168:         pre_dispatch:\n1169:           generate_summary: |\n1170:             STATE SUMMARY (auto-generated):\n1171:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1172:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1173:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1174:             {resource_map_prompt_line}\n1175:             {lineage_context_prompt_line}\n1176:             Next focus: {next_focus}\n1177:           render_prompt_pack:\n1178:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1179:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1180:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1181:             variables:\n1182:               state_summary: \"{state_summary}\"\n1183:               research_topic: \"{research_topic}\"\n1184:               current_iteration: \"{current_iteration}\"\n1185:               max_iterations: \"{max_iterations}\"\n1186:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1187:               next_focus: \"{next_focus}\"\n1188:               remaining_questions_list: \"{remaining_questions_list}\"\n1189:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1190:               last_3_summaries: \"{last_3_summaries}\"\n1191:               pivot_lineage: \"{pivot_lineage}\"\n1192:               saturated_directions: \"{saturated_directions}\"\n1193:               state_paths_config: \"{state_paths.config}\"\n1194:               state_paths_state_log: \"{state_paths.state_log}\"\n1195:               state_paths_strategy: \"{state_paths.strategy}\"\n1196:               state_paths_registry: \"{state_paths.registry}\"\n1197:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1198:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1199:         pre_dispatch_audit:\n1200:           skip_when: \"config.executor.kind == 'native'\"\n1201:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1202:           args:\n1203:             stateLogPath: \"{state_paths.state_log}\"\n1204:             executor: \"{config.executor}\"\n1205:             iteration: \"{current_iteration}\"\n1206:         branch_on: \"config.executor.kind\"\n1207:         if_native:\n1208:           dispatch:\n1209:             agent: deep-research\n1210:             model: opus\n1211:             context_source: \"rendered_prompt_pack\"\n1212:           wait_for_completion: true\n1213:         if_cli_deepseek_harness:\n1214:           command: |\n1215:             node --input-type=module <<'EOF'\n1216:             console.error('cli-deepseek-harness runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1217:             process.exit(2);\n1218:             EOF\n1219:           working_directory: \"{repo_root}\"\n1220:           wait_for_completion: true\n1221:           notes:\n1222:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1223:         if_cli_claude_code:\n1224:           command: |\n1225:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1226:             import { readFileSync } from 'node:fs';\n1227:             import { createHash } from 'node:crypto';\n1228:             import { createRequire } from 'node:module';\n1229: \n1230:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1231:             import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1232: \n1233:             const require = createRequire(import.meta.url);\n1234:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1235:             const executor = {\n1236:               kind: 'cli-claude-code',\n1237:               model: '{config.executor.model}',\n1238:               reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n1239:               serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n1240:               sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n1241:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1242:             };\n1243:             const args = [\n1244:               '-p',\n1245:               withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}'),\n1246:               '--model',\n1247:               executor.model,\n1248:               '--permission-mode',\n1249:               resolveClaudePermissionMode(executor.sandboxMode),\n[Output truncated. Continue reading with offset: 1250]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 750-1249\n750:           log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n751:         if_min_iterations_clamped:\n752:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n753:           log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n754:         if_convergence_mode_invalid:\n755:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n756:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n757: \n758:       step_graph_convergence:\n759:         action: \"Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot\"\n760:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --persist-snapshot --iteration \"{current_iteration}\"'\n761:         note: \"Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent.\"\n762:         outputs:\n763:           - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n764:           - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n765:           - graph_signals_json: \"Tool signals object, else {}\"\n766:           - graph_blockers_json: \"Tool blockers array, else []\"\n767:           - graph_trace_json: \"Tool trace payload, else []\"\n768:           - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n769:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n770: \n771:       step_check_convergence:\n772:         action: \"Evaluate stop conditions and combine the inline 3-signal vote with graph convergence\"\n773:         algorithm: |\n774:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n775:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n776:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.\n777:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = \"CONTINUE\" and choose a broader next focus.\n778:           4. if remaining_questions == 0: STOP (all_questions_answered)\n779:           5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:\n780:                step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.\n781:                The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.\n782:                signals = []\n783:                Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)\n784:                a) Rolling average (w=0.30, needs 3+ iterations):\n785:                   avg = mean(last 3 newInfoRatios)\n786:                   stop if avg < convergence_threshold\n787:                b) MAD noise floor (w=0.35, needs 4+ iterations):\n788:                   noiseFloor = MAD(all ratios) * 1.4826\n789:                   stop if latest ratio <= noiseFloor\n790:                c) Question entropy (w=0.35):\n791:                   coverage = answered / total questions\n792:                   stop if coverage >= 0.85\n793:                Redistribute weights for unavailable signals.\n794:                if weighted_stop_score > 0.60: inline_stop_candidate = true\n795:                Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.\n796:                if inline_stop_candidate and graph_decision == \"STOP_BLOCKED\":\n797:                  decision = \"BLOCKED\"\n798:                  reason = \"blockedStop\"\n799:                  stop_blocked = true\n800:                  blocked_by_json = JSON array derived from graph_blockers_json\n801:                  blocked_by_csv = comma-separated blocker names derived from graph_blockers_json\n802:                  gate_convergence_pass = false\n803:                  gate_convergence_score = graph_convergence_score\n804:                  gate_key_question_coverage_pass = no blocker named questionCoverage\n805:                  gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n806:                  gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n807:                  gate_hotspot_saturation_pass = true\n808:                  recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n809:                else if inline_stop_candidate and (graph_decision == \"STOP_ALLOWED\" or graph_decision is absent):\n810:                  decision = \"STOP\"\n811:                  reason = \"composite_converged\"\n812:                  stop_blocked = false\n813:           6. else: CONTINUE\n814:           7. if decision == \"STOP\" and reason != \"maxIterationsReached\" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:\n815:                decision = \"CONTINUE\"\n816:                reason = \"minIterationsNotReached\"\n817:                min_iterations_guard_blocked = true\n818:                min_iterations_guard_pass = false\n819:           8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n820:                min_iterations_guard_pass = true\n821:           9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n822:                guardResult = checkQualityGuards(state, strategy)\n823:                if not guardResult.passed:\n824:                  log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n825:                  decision = \"CONTINUE\"\n826:           See convergence.md for full pseudocode and signal definitions.\n827:           Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n828:         outputs:\n829:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n830:           - reason: \"Human-readable stop reason\"\n831:           - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n832:           - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n833:           - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n834:           - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n835:           - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n836:           - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n837:           - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n838:           - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n839:           - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n840:           - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n841:           - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n842:           - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n843: \n844:       step_emit_min_iterations_guard_pass:\n845:         action: \"Persist a first-class event when the convergence floor clears\"\n846:         if_pass:\n847:           append_jsonl: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n848:           log: \"Minimum iteration floor cleared for convergence stopping.\"\n849: \n850:       step_emit_blocked_stop:\n851:         action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n852:         if_blocked:\n853:           append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n854:           log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n855:           set:\n856:             decision: \"CONTINUE\"\n857:             reason: \"blockedStop\"\n858:             stop_blocked: false\n859: \n860:       step_handle_convergence:\n861:         action: \"Act on convergence decision\"\n862:         if_stop:\n863:           branch_on: \"convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']\"\n864:           if_divergent_eligible:\n865:             eligibility_contract:\n866:               required_decision: \"STOP\"\n867:               eligible_reasons: [composite_converged, all_questions_answered]\n868:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]\n869:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n870:             steps:\n871:               step_prepare_divergent_pivot:\n872:                 action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n873:                 command: |\n874:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n875:                   import {\n876:                     buildResearchPivotPreparationInput,\n877:                     renderResearchPivotSeatPrompt,\n878:                   } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n879:                   import {\n880:                     preparePivotTransaction,\n881:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n882: \n883:                   const input = buildResearchPivotPreparationInput({\n884:                     artifactRoot: '{state_paths.packet_dir}',\n885:                     configPath: '{state_paths.config}',\n886:                     stateLogPath: '{state_paths.state_log}',\n887:                     strategyPath: '{state_paths.strategy}',\n888:                     registryPath: '{state_paths.registry}',\n889:                     currentIteration: Number('{current_iteration}'),\n890:                     maxIterations: Number('{max_iterations}'),\n891:                     triggerReason: '{reason}',\n892:                   });\n893:                   const prepared = await preparePivotTransaction(input);\n894:                   const seatPrompts = prepared.status === 'pending'\n895:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n896:                         seat.id,\n897:                         renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n898:                       ]))\n899:                     : {};\n900:                   process.stdout.write(`${JSON.stringify({\n901:                     ...prepared,\n902:                     seatPrompts,\n903:                     boundaryRejections: input.boundaryRejections,\n904:                   })}\\n`);\n905:                   EOF\n906:                 working_directory: \"{repo_root}\"\n907:                 outputs:\n908:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n909:                   - pivot_prepare_status: \"status from the prepare result\"\n910:                   - pivot_id: \"pivotId from the prepare result\"\n911:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n912:                   - pivot_resumed: \"resumed from the prepare result\"\n913:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n914:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n915:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n916:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n917:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n918:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n919:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n920:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n921:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n922: \n923:               step_dispatch_pivot_seat_001:\n924:                 action: \"Natively dispatch the analytical research direction-selection seat\"\n925:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n926:                 capture_timing: true\n927:                 if_native:\n928:                   dispatch:\n929:                     agent: deep-research\n930:                     model: opus\n931:                     context_source: \"pivot_seat_001_prompt\"\n932:                   wait_for_completion: true\n933:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n934:                 outputs:\n935:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n936:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n937:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n938:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n939:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n940:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n941: \n942:               step_record_pivot_seat_001:\n943:                 action: \"Durably record the seat-001 native dispatch outcome\"\n944:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n945:                 command: |\n946:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n947:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n948:                   const status = '{pivot_seat_001_dispatch_status}';\n949:                   const outcome = status === 'fulfilled'\n950:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n951:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n952:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n953:                   EOF\n954:                 working_directory: \"{repo_root}\"\n955: \n956:               step_dispatch_pivot_seat_002:\n957:                 action: \"Natively dispatch the critical research direction-selection seat\"\n958:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n959:                 capture_timing: true\n960:                 if_native:\n961:                   dispatch:\n962:                     agent: deep-research\n963:                     model: opus\n964:                     context_source: \"pivot_seat_002_prompt\"\n965:                   wait_for_completion: true\n966:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n967:                 outputs:\n968:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n969:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n970:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n971:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n972:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n973:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n974: \n975:               step_record_pivot_seat_002:\n976:                 action: \"Durably record the seat-002 native dispatch outcome\"\n977:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n978:                 command: |\n979:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n980:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n981:                   const status = '{pivot_seat_002_dispatch_status}';\n982:                   const outcome = status === 'fulfilled'\n983:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n984:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n985:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n986:                   EOF\n987:                 working_directory: \"{repo_root}\"\n988: \n989:               step_dispatch_pivot_seat_003:\n990:                 action: \"Natively dispatch the pragmatic research direction-selection seat\"\n991:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n992:                 capture_timing: true\n993:                 if_native:\n994:                   dispatch:\n995:                     agent: deep-research\n996:                     model: opus\n997:                     context_source: \"pivot_seat_003_prompt\"\n998:                   wait_for_completion: true\n999:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1000:                 outputs:\n1001:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1002:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1003:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1004:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1005:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1006:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1007: \n1008:               step_record_pivot_seat_003:\n1009:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1010:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1011:                 command: |\n1012:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1013:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1014:                   const status = '{pivot_seat_003_dispatch_status}';\n1015:                   const outcome = status === 'fulfilled'\n1016:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1017:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1018:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1019:                   EOF\n1020:                 working_directory: \"{repo_root}\"\n1021: \n1022:               step_finalize_divergent_pivot:\n1023:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1024:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1025:                 command: |\n1026:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1027:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1028:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1029:                   EOF\n1030:                 working_directory: \"{repo_root}\"\n1031:                 outputs:\n1032:                   - pivot_finalize_json: \"The complete parsed final result\"\n1033: \n1034:               step_resolve_divergent_pivot_result:\n1035:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1036:                 branch_on: \"pivot_prepare_status\"\n1037:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1038:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1039: \n1040:               step_apply_divergent_pivot_result:\n1041:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1042:                 branch_on: \"pivot_result.status\"\n1043:                 if_completed:\n1044:                   set:\n1045:                     next_focus: \"{pivot_result.restoredFocus}\"\n1046:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1047:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1048:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1049:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1050:                   proceed_to: step_rejected_pattern_cache\n1051:                 if_failed:\n1052:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1053:                   skip_to: phase_synthesis\n1054:             on_error:\n1055:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1056:               skip_to: phase_synthesis\n1057:           if_existing_terminal_path:\n1058:             log: \"Loop stopping. Reason: {reason}\"\n1059:             skip_to: phase_synthesis\n1060:         if_stuck_recovery:\n1061:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1062:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1063:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1064:           reset: { stuck_count: 0 }\n1065:         if_continue:\n1066:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1067: \n1068:       step_rejected_pattern_cache:\n1069:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1070:         read:\n1071:           - \"{state_paths.state_log}\"\n1072:           - \"{state_paths.registry}\"\n1073:           - \"{state_paths.strategy}\"\n1074:         candidate_sources:\n1075:           next_focus:\n1076:             category: \"next-focus\"\n1077:             values:\n1078:               - \"{next_focus}\"\n1079:               - \"{remaining_questions_list}\"\n1080:               - \"{carried_forward_open_questions}\"\n1081:           recovery:\n1082:             category: \"recovery\"\n1083:             values:\n1084:               - \"{recovery_strategy}\"\n1085:               - \"{least_explored}\"\n1086:           ideas:\n1087:             category: \"ideas\"\n1088:             values:\n1089:               - \"{promoted_ideas_list}\"\n1090:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1091:         algorithm: |\n1092:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1093:           reducer pass as the source of truth.\n1094:           Compare normalized exact text first. Then compare fuzzy similarity with\n1095:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1096:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1097:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1098:           halt for operator input instead of reusing a rejected idea.\n1099:         outputs:\n1100:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1101:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1102:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1103:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1104:         if_next_focus_suppressed:\n1105:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1106:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1107:         if_all_candidates_suppressed:\n1108:           halt: true\n1109:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1110: \n1111:       step_ideas_backlog_lifecycle:\n1112:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1113:         read:\n1114:           - \"{state_paths.state_log}\"\n1115:           - \"{state_paths.registry}\"\n1116:           - \"{state_paths.config}\"\n1117:         lifecycle:\n1118:           observed_event: \"idea_observed\"\n1119:           promoted_event: \"idea_promoted\"\n1120:           rejected_event: \"idea_rejected\"\n1121:           min_observations: \"{min_idea_observations}\"\n1122:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1123:         validate:\n1124:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1125:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1126:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1127:         outputs:\n1128:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1129:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1130:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1131:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1132: \n1133:       step_normalize_pause_events:\n1134:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1135:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n1136:         rule_pause_sentinel:\n1137:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1138:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1139:         rule_stuck_recovery:\n1140:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1141:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1142: \n1143:       step_marker_scan:\n1144:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1145:         canonical_header: \"DEEP-RESEARCH\"\n1146:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1147:         algorithm: |\n1148:           if current_iteration > 1:\n1149:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1150:             if file_exists(PREV_PROMPT_PATH):\n1151:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1152:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1153:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1154:                 halt with exit code 2\n1155:         note: |\n1156:           False-positive prevention: a research prompt that starts with its own canonical\n1157:           header is this loop's own iteration output, never a nested dispatch; only a review\n1158:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1159:           header. Markers appearing in comments or body text are ignored. True-positive\n1160:           triggers only when a previous iteration's rendered prompt literally starts with a\n1161:           review marker, indicating a nested research-of-review dispatch.\n1162: \n1163:       step_dispatch_iteration:\n1164:         action: \"Dispatch one iteration via the selected executor\"\n1165:         resolve_executor:\n1166:           source: \"config.executor\"\n1167:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1168:         pre_dispatch:\n1169:           generate_summary: |\n1170:             STATE SUMMARY (auto-generated):\n1171:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1172:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1173:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1174:             {resource_map_prompt_line}\n1175:             {lineage_context_prompt_line}\n1176:             Next focus: {next_focus}\n1177:           render_prompt_pack:\n1178:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1179:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1180:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1181:             variables:\n1182:               state_summary: \"{state_summary}\"\n1183:               research_topic: \"{research_topic}\"\n1184:               current_iteration: \"{current_iteration}\"\n1185:               max_iterations: \"{max_iterations}\"\n1186:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1187:               next_focus: \"{next_focus}\"\n1188:               remaining_questions_list: \"{remaining_questions_list}\"\n1189:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1190:               last_3_summaries: \"{last_3_summaries}\"\n1191:               pivot_lineage: \"{pivot_lineage}\"\n1192:               saturated_directions: \"{saturated_directions}\"\n1193:               state_paths_config: \"{state_paths.config}\"\n1194:               state_paths_state_log: \"{state_paths.state_log}\"\n1195:               state_paths_strategy: \"{state_paths.strategy}\"\n1196:               state_paths_registry: \"{state_paths.registry}\"\n1197:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1198:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1199:         pre_dispatch_audit:\n1200:           skip_when: \"config.executor.kind == 'native'\"\n1201:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1202:           args:\n1203:             stateLogPath: \"{state_paths.state_log}\"\n1204:             executor: \"{config.executor}\"\n1205:             iteration: \"{current_iteration}\"\n1206:         branch_on: \"config.executor.kind\"\n1207:         if_native:\n1208:           dispatch:\n1209:             agent: deep-research\n1210:             model: opus\n1211:             context_source: \"rendered_prompt_pack\"\n1212:           wait_for_completion: true\n1213:         if_cli_deepseek_harness:\n1214:           command: |\n1215:             node --input-type=module <<'EOF'\n1216:             console.error('cli-deepseek-harness runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1217:             process.exit(2);\n1218:             EOF\n1219:           working_directory: \"{repo_root}\"\n1220:           wait_for_completion: true\n1221:           notes:\n1222:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1223:         if_cli_claude_code:\n1224:           command: |\n1225:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1226:             import { readFileSync } from 'node:fs';\n1227:             import { createHash } from 'node:crypto';\n1228:             import { createRequire } from 'node:module';\n1229: \n1230:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1231:             import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1232: \n1233:             const require = createRequire(import.meta.url);\n1234:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1235:             const executor = {\n1236:               kind: 'cli-claude-code',\n1237:               model: '{config.executor.model}',\n1238:               reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n1239:               serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n1240:               sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n1241:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1242:             };\n1243:             const args = [\n1244:               '-p',\n1245:               withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}'),\n1246:               '--mod