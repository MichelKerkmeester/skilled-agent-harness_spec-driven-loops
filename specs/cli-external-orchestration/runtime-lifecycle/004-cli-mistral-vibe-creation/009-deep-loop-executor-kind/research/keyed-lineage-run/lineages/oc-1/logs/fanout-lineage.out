{\n  research: Object.freeze(['keyFindings', 'findings']),\n  review: Object.freeze(['findingDetails']),\n});\n\nconst FLAG_KEYS = Object.freeze({\n  '--mode': 'mode',\n  '--event-dir': 'eventDir',\n  '--artifact-dir': 'artifactDir',\n  '--state-log': 'stateLog',\n  '--registry': 'registry',\n  '--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n\n===SCHEMA===\n    missingStructuredFindingCount: 'uint32',\n    sourceFindingCount: 'nullable-uint32',\n    reconstructionGapCount: 'nullable-uint32',\n    stateParseFailureCount: 'uint32',\n  },\n  'deep_research.synthesis_complete': {\n    totalIterations: 'uint32',\n    answeredCount: 'uint32',\n    totalQuestions: 'uint32',\n    stopReason: 'prose',\n  },\n  'deep_research.spec_check_result': {\n    folderState: SPEC_FOLDER_STATE_RULE,\n    normalizedTopic: 'prose',\n    specPath: 'prose',\n    lockPath: 'prose',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/383-mistral-vibe-runtime && sed -n '1,60p' .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs; echo \\\"===SCHEMA===\\\"; sed -n '505,520p' .skilled/skills/system-deep-loop/runtime/lib/deep-research-ledger-schema/deep-research-ledger-schema.ts\"}"},"time":{"start":1794674883514,"end":1794674883620}}}}
