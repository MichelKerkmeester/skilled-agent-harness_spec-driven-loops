{"type":"tool_result","callId":"call_00_n3fwQJ6WIm0icjsdjBJF9527","status":"completed","result":"<path>/Users/michelkerkmeester/MEGA/Development/Skilled/.skilled/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ─────────────────────────────────────────────────────────────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ─────────────────────────────────────────────────────────────────\n32: # OPERATING PRINCIPLES\n33: # ─────────────────────────────────────────────────────────────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # USER INPUTS (from setup phase)\n41: # ─────────────────────────────────────────────────────────────────\n42: user_inputs:\n43:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n44:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n45:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n46:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n47:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n48:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n49: \n50: # ─────────────────────────────────────────────────────────────────\n51: # CONTEXT LOADING\n52: # ─────────────────────────────────────────────────────────────────\n53: context_loading:\n54:   trigger: \"At workflow START, before phase_init\"\n55:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n56:   retrieval:\n57:     mechanism: \"continuity-ladder-then-ripgrep\"\n58:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n59:     ladder:\n60:       - \"{spec_folder}/handover.md when present\"\n61:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n62:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n63:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n64:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n65:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n66:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n67:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n68:   behavior:\n69:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n70:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n71: \n72: # ─────────────────────────────────────────────────────────────────\n73: # SKILL REFERENCE\n74: # ─────────────────────────────────────────────────────────────────\n75: skill_reference:\n76:   skill: system-deep-loop\n77:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n78:   references:\n79:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n80:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n81:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n82:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n83:   templates:\n84:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n85:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # AGENT CONFIGURATION\n89: # ─────────────────────────────────────────────────────────────────\n90: agent_config:\n91:   agent: deep-research\n92:   agent_file: \".skilled/agents/deep-research.md\"\n93:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n94:   model: opus\n95:   leaf_only: true\n96:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n97:   mcp_servers: []\n98:   tool_call_budget: { target: 12, max: 24 }\n99: \n100: # ─────────────────────────────────────────────────────────────────\n101: # STATE FILE PATHS\n102: # ───────────────────────","truncated":true}
