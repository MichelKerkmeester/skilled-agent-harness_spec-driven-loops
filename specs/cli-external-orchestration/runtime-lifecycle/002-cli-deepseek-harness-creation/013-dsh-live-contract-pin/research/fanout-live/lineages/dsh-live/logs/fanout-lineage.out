kills/sk-git/SKILL.md\n./containment/baseline/.hermes/skills/sk-prompt/SKILL.md\n./containment/baseline/.hermes/skills/system-deep-loop/SKILL.md\n./containment/baseline/.hermes/skills/system-spec-kit/SKILL.md\n--- dirs ---\n.\n./.executor-state\n./containment\n./containment/baseline\n./containment/baseline/.claude\n./containment/baseline/.claude/agents\n./containment/baseline/.codex\n./containment/baseline/.codex/agents\n./containment/baseline/.dsh\n./containment/baseline/.dsh/agents\n./containment/baseline/.dsh/patches\n./containment/baseline/.dsh/plugins\n./containment/baseline/.dsh/plugins/repo-guards\n./containment/baseline/.dsh/plugins/repo-guards/adapters\n./containment/baseline/.dsh/plugins/repo-guards/tests\n./containment/baseline/.dsh/prompts\n./containment/baseline/.github\n./containment/baseline/.github/workflows\n./containment/baseline/.hermes\n./containment/baseline/.hermes/skills\n./containment/baseline/.hermes/skills/agent-orchestrate\n./containment/baseline/.hermes/skills/agent-prompt-improver\n./containment/baseline/.hermes/skills/cli-deepseek-harness\n./containment/baseline/.hermes/skills/cli-external-orchestration\n./containment/baseline/.hermes/skills/deep-research\n./containment/baseline/.hermes/skills/deep-review\n./containment/baseline/.hermes/skills/sk-git\n./containment/baseline/.hermes/skills/sk-prompt\n./containment/baseline/.hermes/skills/system-deep-loop\n./containment/baseline/.hermes/skills/system-spec-kit\n./containment/baseline/.pi\n./containment/baseline/.pi/agents\n./containment/baseline/.skilled\n./containment/baseline/.skilled/agents\n./containment/baseline/.skilled/bin\n./containment/baseline/.skilled/bin/lib\n./containment/baseline/.skilled/bin/lib/compiled-routing\n./containment/baseline/.skilled/bin/lib/compiled-routing/009-parent-hub-rollout\n./containment/baseline/.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/004-cli-external-orchestration\n./containment/baseline/.skilled/bin/lib/compiled-routing/009-parent-hub-r