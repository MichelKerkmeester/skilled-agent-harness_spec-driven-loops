odules/@deepseek-ai]\\\",\\n\\\"[SOURCE: /Users/michelkerkmeester/.local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-mcp-client/package.json:1]\\\")\\ns=s.replace(\\\"[SOURCE: dsh-src/packages/experimental/hooks-claude-code/package.json:1]\\\",\\n\\\"[SOURCE: dsh-src/packages/experimental/hooks-claude-code/package.json:1]\\\")\\nopen(p,'w').write(s)\\nprint('ok')\\nEOF\\nls /Users/michelkerkmeester/.local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-mcp-client/package.json\"}"},"time":{"start":1793916446391,"end":1793916447059}}}}
