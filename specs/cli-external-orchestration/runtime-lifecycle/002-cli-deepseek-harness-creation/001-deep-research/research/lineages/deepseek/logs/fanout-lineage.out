 and data-flow changes; cover edge cases, failure modes, tests, acceptance criteria, and explicit assumptions. Keep it concise enough to review but detailed enough that another engineer can implement it without making design decisions.\n363:    - id: subagent\n364:      name: '@deepseek-ai/dsh-subagent'\n374:    - id: subagent-spawn-in-process\n375:      name: '@deepseek-ai/dsh-subagent-spawn-in-process'\n379:    - id: subagent-fork-in-process\n380:      name: '@deepseek-ai/dsh-subagent-fork-in-process'\n386:    - id: tool-subagent-control\n387:      name: '@deepseek-ai/dsh-tool-subagent-control'\n389:    - id: tool-subagent\n390:      name: '@deepseek-ai/dsh-tool-subagent'\n393:        toolName: subagent\n397:    # See packages/subagent/tool-subagent/README.md\n399:    - id: tool-subagent-fork\n400:      name: '@deepseek-ai/dsh-tool-subagent'\n403:        toolName: subagent_fork\n408:    - id: workflow-ptc\n409:      name: '@deepseek-ai/dsh-workflow-ptc'\n413:    - id: tool-workflow\n414:      name: '@deepseek-ai/dsh-tool-workflow'\n450:    # Persisted same-session goals reach the model and the slash menu here; the\n451:    # domain, driver, and `/goal` command are above.\n452:    - id: tool-goal\n453:      name: '@deepseek-ai/dsh-tool-goal'\n521:    # The deployment persona is a deployment choice; plan-mode and tool plugins own\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"151:    # (session export, subagent-fork Workspace inheritance) stay available —\n163:    # Shared projection registry: subagent catalog identity (mode/label) folds\n315:    - id: skill-filesystem\n316:      name: '@deepseek-ai/dsh-skill-filesystem'\n318:    - id: tool-skill\n319:      name: '@deepseek-ai/dsh-tool-skill'\n327:    - id: goal\n328:      name: '@deepseek-ai/dsh-goal'\n330:    - id: goal-round-driver\n331:      name: '@deepseek-ai/dsh-goal-round-driver'\n333:    - id: command-goal\n334:      name: '@deep