\n252-  const cmdlinePath = join(procDir, 'cmdline');\n253-  const statPath = join(procDir, 'stat');\n254-\n255-  if (!existsSync(cmdlinePath) || !existsSync(statPath)) {\n256-    return null;\n257-  }\n258-\n259-  try {\n260-    const commandLine = readFileSync(cmdlinePath, 'utf8').replace(/\\0/g, ' ').trim();\n261-    const stat = readFileSync(statPath, 'utf8');\n262-    const closeParenIndex = stat.lastIndexOf(')');\n263-    const afterCommand = closeParenIndex === -1 ? '' : stat.slice(closeParenIndex + 2).trim();\n264-    const parentPid = Number(afterCommand.split(/\\s+/)[1]);\n265-    return { commandLine, parentPid: Number.isInteger(parentPid) ? parentPid : 0 };\n266-  } catch {\n267-    return null;\n268-  }\n269-}\n270-\n271-// `ps` is the only ancestry source on platforms without /proc — macOS and the BSDs.\n272-// Without it the ancestry layer never fires there, and ancestry is the one layer that\n273-// survives a sandboxed CLI scrubbing its child environment, so a leaf can re-dispatch\n274-// its own binary undetected while every env-based layer stays blind.\n275-function readPsAncestorFrame(pid: number): AncestorFrame | null {\n276-  try {\n277-    const result = spawnSync('/bin/ps', ['-o', 'ppid=,command=', '-p', String(pid)], {\n278-      encoding: 'utf8',\n279-    });\n280-    if (result.status !== 0 || typeof result.stdout !== 'string') {\n281-      return null;\n282-    }\n283-\n284-    const line = result.stdout\n285-      .split('\\n')\n286-      .map((entry) => entry.trim())\n--\n1005:    if (value !== undefined && isAllowedExecutorEnvKey(key, kind)) {\n1006-      nextEnv[key] = value;\n1007-    }\n1008-  }\n1009-  nextEnv[CLI_DISPATCH_STACK_ENV] = [...splitDispatchStack(parentEnv[CLI_DISPATCH_STACK_ENV]), kind].join(':');\n1010-  return nextEnv;\n1011-}\n1012-\n1013-/**\n1014- * Build an executor audit record for provenance logging.\n1015- *\n1016- * @param executor - Executor configuration.\n1017- * @returns Audit record with kind, model, rea