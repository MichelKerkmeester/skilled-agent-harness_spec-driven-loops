{"type":"step_start","timestamp":1793915929948,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8c55c001qV8EsCwGzWR9cp","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8c1ac001106ADlqsyBIi4A","type":"step-start","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6"}}
{"type":"tool_use","timestamp":1793915930307,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"partID":"prt_1adb8c633001J71dxQ7R4RX0g2","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8c1ac001106ADlqsyBIi4A","type":"tool","id":"chatcmpl-tool-8d7945ad1d8829ca","tool":"shell","state":{"status":"completed","input":{"command":"sed -n 140,420p .skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n    projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n    the next refresh.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n  # research/ and child phases keep local research/ packet directories.\n  packet_dir: \"{artifact_dir}\"\n  config: \"{artifact_dir}/deep-research-config.json\"\n  state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n  status_ledger: \"{artifact_dir}/orchestration-status.log\"\n  strategy: \"{artifact_dir}/deep-research-strategy.md\"\n  registry: \"{artifact_dir}/findings-registry.json\"\n  dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n  run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n  lock_file: \"{artifact_dir}/.deep-research.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream (one file per iteration) — complement to the\n  # canonical state_log append. The delta file MUST contain at least one record whose\n  # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n  # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n  # post_dispatch_validate step enforces the canonical type below.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  research_output: \"{artifact_dir}/research.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_subfolder: null\n        artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n    if_absent:\n      command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n      outputs:\n        - artifact_root_dir: \"Resolved local research owner directory\"\n        - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n        - artifact_dir: \"Resolved research packet directory for this target\"\n        - artifact_archive_root: \"Resolved local research archive directory for this target\"\n\n  step_bind_reducer_artifact_arg:\n    description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n    if_absent:\n      bind:\n        reducer_artifact_arg: \"\"\n\n  step_fanout_spawn:\n    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n    skip_when: \"config.fanout is absent\"\n    instructions: |\n      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n      deep-research agent is used only for individual iterations, never as a full-loop\n      sub-agent or pasted phase-running prompt.\n      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n      phase_main_loop entirely (those are the single-executor path). The merge step in\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_spawn_cli:\n        description: \"Spawn all native and CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type research \\\n            --research-topic \"{research_topic}\" \\\n            --fanout-config-json '{config.fanout_json}' \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy} \\\n            --convergence-mode {convergence_mode}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 1: INITIALIZATION\n  # ═══════════════════════════════════════════════════════════════\n  phase_init:\n    purpose: Create all state files for the research session\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and research packet directories if they don't exist\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_resolve_canonical_names:\n        action: \"Resolve canonical research packet artifact names before classification\"\n        inspect_legacy:\n          - \"{state_paths.packet_dir}/config.json\"\n          - \"{state_paths.packet_dir}/state.jsonl\"\n          - \"{state_paths.packet_dir}/strategy.md\"\n          - \"{state_paths.packet_dir}/dashboard.md\"\n          - \"{state_paths.packet_dir}/.pause\"\n        migration_policy: \"dual-read / single-write for 4 weeks\"\n        on_legacy_read:\n          set: { legacy_migration_detected: true, migration_recorded: false }\n          outputs:\n            - legacy_path: \"The legacy artifact path that was read\"\n            - canonical_path: \"The canonical artifact path it maps to\"\n          note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Release the lock before any terminal halt branch returns control\"\n          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n\n      step_classify_session:\n        action: \"Classify the session before writing files\"\n        inspect:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n        classify:\n          fresh: \"None of the three state artifacts exist\"\n          resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n          completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n          invalid-state: \"Any partial, missing, or contradictory combination\"\n        outputs:\n          - session_state: \"fresh | resume | completed-session | invalid-state\"\n        on_resume:\n          # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n          # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).\n          gate3_classification: write-path\n          gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n          log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: phase_loop\n        on_restart:\n          action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n          command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n          set:\n            lineage_mode: \"restart\"\n            parent_session_id: \"{prior_session_id}\"\n            generation: \"{prior_generation + 1}\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: step_create_config\n        note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n        on_completed_session:\n          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n          halt: true\n          message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n        on_invalid_state:\n          halt: true\n          message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n        on_fresh:\n          action: \"Proceed with a new session\"\n\n      step_resolve_session_id:\n        action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n        branch_on: \"session_id\"\n        if_present:\n          bind:\n            session_id_init: \"{session_id}\"\n        if_absent:\n          bind:\n            # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n            AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n            session_id_init: \"{AUTO_SESSION_ID}\"\n\n      step_create_config:\n        action: \"Create deep-research-config.json from template\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n        populate:\n          topic: \"{research_topic}\"\n          maxIterations: \"{max_iterations}\"\n          minIterations: 3\n          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n          convergenceThreshold: \"{convergence_threshold}\"\n          stopPolicy: \"{stop_policy}\"\n          antiConvergence.convergenceMode: \"{convergence_mode}\"\n          antiConvergence.divergent: {}\n          stuckThreshold: 3\n          minIdeaObservations: 2\n          maxDurationMinutes: 120\n          specFolder: \"{spec_folder}\"\n          resource_map_present: \"{resource_map_present}\"\n          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n          resource_map.emit: \"{resource_map_emit}\"\n          createdAt: \"{ISO_8601_NOW}\"\n          status: \"initialized\"\n          executionMode: \"auto\"\n          lineage.sessionId: \"{session_id_init}\"\n          lineage.parentSessionId: null\n          lineage.lineageMode: \"new\"\n          lineage.generation: 1\n          lineage.continuedFromRun: null\n          nextRunAt: null\n          remainingDelayMs: null\n        output: \"{state_paths.config}\"\n\n      step_create_state_log:\n        action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n        note: |\n          The state log is a projection rebuilt by the gateway. Recording the run's opening in\n          the ledger gives every later state append the same authorized, ordered source.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n          node -e '\n            const fs = require(\"fs\"), crypto = require(\"crypto\");\n            const [configPath] = process.argv.slice(1);\n            const raw = fs.readFileSync(configPath);\n            const config = JSON.parse(raw);\n            const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n            const lineage = config.lineage || {};\n            const sessionId = lineage.sessionId;\n            const lineageId = lineage.parentSessionId || sessionId;\n            const generation = Number(lineage.generation) || 1;\n            const configDigest = sha(raw);\n            // The projected config row shows this topic; one the schema cannot hold is left out,\n            // and the row falls back to the run id rather than the run failing to open.\n            const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n              ? config.topic\n              : null;\n            const event = {\n              stem: \"deep_research.run_initialized\",\n              scope: { runId: sessionId, lineageId },\n              data: {\n                generation,\n                ...(topic === null ? {} : { topic }),\n                charterDigest: sha(Buffer.from(JSON.stringify({\n                  topic: config.topic,\n                  specFolder: config.specFolder || \"\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n    projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n    the next refresh.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n  # research/ and child phases keep local research/ packet directories.\n  packet_dir: \"{artifact_dir}\"\n  config: \"{artifact_dir}/deep-research-config.json\"\n  state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n  status_ledger: \"{artifact_dir}/orchestration-status.log\"\n  strategy: \"{artifact_dir}/deep-research-strategy.md\"\n  registry: \"{artifact_dir}/findings-registry.json\"\n  dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n  run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n  lock_file: \"{artifact_dir}/.deep-research.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream (one file per iteration) — complement to the\n  # canonical state_log append. The delta file MUST contain at least one record whose\n  # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n  # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n  # post_dispatch_validate step enforces the canonical type below.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  research_output: \"{artifact_dir}/research.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_subfolder: null\n        artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n    if_absent:\n      command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n      outputs:\n        - artifact_root_dir: \"Resolved local research owner directory\"\n        - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n        - artifact_dir: \"Resolved research packet directory for this target\"\n        - artifact_archive_root: \"Resolved local research archive directory for this target\"\n\n  step_bind_reducer_artifact_arg:\n    description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n    if_absent:\n      bind:\n        reducer_artifact_arg: \"\"\n\n  step_fanout_spawn:\n    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n    skip_when: \"config.fanout is absent\"\n    instructions: |\n      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n      deep-research agent is used only for individual iterations, never as a full-loop\n      sub-agent or pasted phase-running prompt.\n      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n      phase_main_loop entirely (those are the single-executor path). The merge step in\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_spawn_cli:\n        description: \"Spawn all native and CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type research \\\n            --research-topic \"{research_topic}\" \\\n            --fanout-config-json '{config.fanout_json}' \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy} \\\n            --convergence-mode {convergence_mode}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 1: INITIALIZATION\n  # ═══════════════════════════════════════════════════════════════\n  phase_init:\n    purpose: Create all state files for the research session\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and research packet directories if they don't exist\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_resolve_canonical_names:\n        action: \"Resolve canonical research packet artifact names before classification\"\n        inspect_legacy:\n          - \"{state_paths.packet_dir}/config.json\"\n          - \"{state_paths.packet_dir}/state.jsonl\"\n          - \"{state_paths.packet_dir}/strategy.md\"\n          - \"{state_paths.packet_dir}/dashboard.md\"\n          - \"{state_paths.packet_dir}/.pause\"\n        migration_policy: \"dual-read / single-write for 4 weeks\"\n        on_legacy_read:\n          set: { legacy_migration_detected: true, migration_recorded: false }\n          outputs:\n            - legacy_path: \"The legacy artifact path that was read\"\n            - canonical_path: \"The canonical artifact path it maps to\"\n          note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Release the lock before any terminal halt branch returns control\"\n          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n\n      step_classify_session:\n        action: \"Classify the session before writing files\"\n        inspect:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n        classify:\n          fresh: \"None of the three state artifacts exist\"\n          resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n          completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n          invalid-state: \"Any partial, missing, or contradictory combination\"\n        outputs:\n          - session_state: \"fresh | resume | completed-session | invalid-state\"\n        on_resume:\n          # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n          # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).\n          gate3_classification: write-path\n          gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n          log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: phase_loop\n        on_restart:\n          action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n          command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n          set:\n            lineage_mode: \"restart\"\n            parent_session_id: \"{prior_session_id}\"\n            generation: \"{prior_generation + 1}\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: step_create_config\n        note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n        on_completed_session:\n          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n          halt: true\n          message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n        on_invalid_state:\n          halt: true\n          message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n        on_fresh:\n          action: \"Proceed with a new session\"\n\n      step_resolve_session_id:\n        action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n        branch_on: \"session_id\"\n        if_present:\n          bind:\n            session_id_init: \"{session_id}\"\n        if_absent:\n          bind:\n            # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n            AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n            session_id_init: \"{AUTO_SESSION_ID}\"\n\n      step_create_config:\n        action: \"Create deep-research-config.json from template\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n        populate:\n          topic: \"{research_topic}\"\n          maxIterations: \"{max_iterations}\"\n          minIterations: 3\n          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n          convergenceThreshold: \"{convergence_threshold}\"\n          stopPolicy: \"{stop_policy}\"\n          antiConvergence.convergenceMode: \"{convergence_mode}\"\n          antiConvergence.divergent: {}\n          stuckThreshold: 3\n          minIdeaObservations: 2\n          maxDurationMinutes: 120\n          specFolder: \"{spec_folder}\"\n          resource_map_present: \"{resource_map_present}\"\n          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n          resource_map.emit: \"{resource_map_emit}\"\n          createdAt: \"{ISO_8601_NOW}\"\n          status: \"initialized\"\n          executionMode: \"auto\"\n          lineage.sessionId: \"{session_id_init}\"\n          lineage.parentSessionId: null\n          lineage.lineageMode: \"new\"\n          lineage.generation: 1\n          lineage.continuedFromRun: null\n          nextRunAt: null\n          remainingDelayMs: null\n        output: \"{state_paths.config}\"\n\n      step_create_state_log:\n        action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n        note: |\n          The state log is a projection rebuilt by the gateway. Recording the run's opening in\n          the ledger gives every later state append the same authorized, ordered source.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n          node -e '\n            const fs = require(\"fs\"), crypto = require(\"crypto\");\n            const [configPath] = process.argv.slice(1);\n            const raw = fs.readFileSync(configPath);\n            const config = JSON.parse(raw);\n            const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n            const lineage = config.lineage || {};\n            const sessionId = lineage.sessionId;\n            const lineageId = lineage.parentSessionId || sessionId;\n            const generation = Number(lineage.generation) || 1;\n            const configDigest = sha(raw);\n            // The projected config row shows this topic; one the schema cannot hold is left out,\n            // and the row falls back to the run id rather than the run failing to open.\n            const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n              ? config.topic\n              : null;\n            const event = {\n              stem: \"deep_research.run_initialized\",\n              scope: { runId: sessionId, lineageId },\n              data: {\n                generation,\n                ...(topic === null ? {} : { topic }),\n                charterDigest: sha(Buffer.from(JSON.stringify({\n                  topic: config.topic,\n                  specFolder: config.specFolder || \"\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n 140,420p .skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1793915930163,"end":1793915930307}}}}
{"type":"step_finish","timestamp":1793915931071,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8c9bf001JKSDzfb2GYeC2s","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8c1ac001106ADlqsyBIi4A","type":"step-finish","reason":"tool-calls","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6","cost":0.000489594,"tokens":{"input":1975,"output":59,"reasoning":45,"cache":{"read":43648,"write":0}}}}
{"type":"step_start","timestamp":1793915932119,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8cdd70011KXBvMCyfnhwEm","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8c9c300180osHYF3c7ouBS","type":"step-start","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6"}}
{"type":"tool_use","timestamp":1793915932547,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"partID":"prt_1adb8cf03001CiTQ5kXst0g20X","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8c9c300180osHYF3c7ouBS","type":"tool","id":"chatcmpl-tool-927964fa402a82ad","tool":"shell","state":{"status":"completed","input":{"command":"sed -n 420,700p .skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"                  specFolder: config.specFolder || \"\",\n                }))),\n                configDigest,\n                executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n                replayFingerprint: sha(Buffer.from(JSON.stringify({\n                  runId: sessionId,\n                  lineageId,\n                  generation,\n                  configDigest,\n                }))),\n                maxIterations: Number(config.maxIterations),\n                convergencePolicyVersion: \"convergence-policy@\" + (\n                  (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n                ),\n              },\n            };\n            process.stdout.write(JSON.stringify(event));\n          ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n          node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n          STATUS=$?\n          rm -f \"$EVENT_FILE\"\n          exit \"$STATUS\"\n        output: \"{state_paths.state_log}\"\n\n      step_create_strategy:\n        action: \"Create strategy file from template with initial questions\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n        populate:\n          topic: \"{research_topic}\"\n          key_questions: \"Derive 3-5 key questions from the research topic\"\n          known_context: \"None\"\n          known_context_summary: \"None\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n        output: \"{state_paths.strategy}\"\n\n      step_create_registry:\n        action: \"Initialize reducer-owned findings registry\"\n        content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n        output: \"{state_paths.registry}\"\n\n      step_enrich_strategy_context:\n        action: \"Ensure Known Context is written only after strategy.md exists\"\n        condition: \"prior_context_found\"\n        edit: \"{state_paths.strategy}\"\n        note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n\n      step_enrich_strategy_resource_map:\n        action: \"Inject resource-map status into Known Context after strategy.md exists\"\n        edit: \"{state_paths.strategy}\"\n        note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_detect_spec_present:\n        action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n        inspect:\n          - \"{spec_folder}/spec.md\"\n          - \"{state_paths.lock_file}\"\n        classify:\n          no-spec: \"spec.md is absent before any pre-init mutation\"\n          spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n          spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n          conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n        outputs:\n          - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n          - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_preinit_spec_branch:\n        action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n        protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n        branches:\n          no-spec:\n            create: \"{spec_folder}/spec.md\"\n            seed_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n            scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n            set:\n              folder_state: \"spec-just-created-by-this-run\"\n              validate_spec_doc: true\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-present:\n            edit: \"{spec_folder}/spec.md\"\n            set:\n              validate_spec_doc: true\n            idempotency_check:\n              host_anchor: \"Open Questions\"\n              normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n              if_match:\n                skip_append: true\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              if_no_match:\n                append_only:\n                  - host_anchor: \"Open Questions\"\n                    content: \"Add the normalized research topic only if it is not already present.\"\n                  - host_anchor: \"Research Context\"\n                    content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-just-created-by-this-run:\n            verify_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            set:\n              validate_spec_doc: false\n            note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n          conflict-detected:\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n            halt: true\n\n      step_validate_preinit_spec_doc:\n        action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n        condition: \"validate_spec_doc\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n\n      step_telemetry_heartbeat_started:\n        action: \"Emit a single-loop started row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        canonical_lifecycle_event: \"iteration_start\"\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n          const generation = Number(config.lineage?.generation ?? 1);\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n          const row = {\n            event: 'started',\n            label: 'single',\n            at: timestamp,\n            duration_ms: 0,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation },\n                event: row.event,\n                status: 'running',\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n\n      step_init_complete:\n        log: \"Initialization complete. Config, state, and strategy files created.\"\n        set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 2: ITERATION LOOP\n  # ═══════════════════════════════════════════════════════════════\n  phase_loop:\n    purpose: Dispatch agent iterations until convergence\n    repeat: true\n    max_repeats: \"{max_iterations}\"\n    steps:\n\n      step_refresh_lock:\n        action: \"Refresh the packet lock heartbeat before the iteration begins\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n        on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n\n      step_record_artifact_migration:\n        action: \"Record a legacy artifact alias read once per session, after the run is open\"\n        skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n        append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n        set: { migration_recorded: true }\n\n      step_read_state:\n        action: \"Read current state from JSONL and strategy\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.config}\"\n        extract:\n          - iteration_count: \"Count lines where type === 'iteration'\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n          - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n          - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n          - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n          - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n          - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n          - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n          - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n          - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n          - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n          - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n          - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n          - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n          - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n          - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n          - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n          - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n          - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n          - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n\n      step_run_now_check:\n        action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n          node - \"$EVENT_DIR\" <<'EOF'\n          const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n          const { join } = require('node:path');\n\n          const eventDir = process.argv[2];\n          const sentinelPath = \"{state_paths.run_now_sentinel}\";\n          const pausePath = \"{state_paths.pause_sentinel}\";\n          const sessionId = \"{config.lineage.sessionId}\";\n          const generation = Number(\"{config.lineage.generation}\");\n          const run = Number(\"{current_iteration}\");\n\n          // The state log is a projection the gateway rebuilds from the ledger, so a\n          // run-now row is staged as a canonical ledger event and appended by the\n          // gateway; a write beside the projection is dropped by the next refresh.\n          // The loop boundary has no lineage identity yet, so the session names both\n          // scope halves rather than inventing a second identifier.\n          const scope = { runId: sessionId, lineageId: sessionId };\n\n          let sequence = 0;\n\n          function record(event, fields) {\n            sequence += 1;\n            writeFileSync(\n              join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n              JSON.stringify({\n                stem: `deep_research.${event}`,\n                scope,\n                data: { mode: \"research\", run, sessionId, generation, ...fields },\n              }),\n              \"utf8\",\n            );\n          }\n\n          if (existsSync(sentinelPath)) {\n            record(\"run_now_requested\", { sentinelPath });\n            if (existsSync(pausePath)) {\n              record(\"run_now_rejected\", {\n                sentinelPath,\n                reason: \"loop_paused\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"                  specFolder: config.specFolder || \"\",\n                }))),\n                configDigest,\n                executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n                replayFingerprint: sha(Buffer.from(JSON.stringify({\n                  runId: sessionId,\n                  lineageId,\n                  generation,\n                  configDigest,\n                }))),\n                maxIterations: Number(config.maxIterations),\n                convergencePolicyVersion: \"convergence-policy@\" + (\n                  (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n                ),\n              },\n            };\n            process.stdout.write(JSON.stringify(event));\n          ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n          node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n          STATUS=$?\n          rm -f \"$EVENT_FILE\"\n          exit \"$STATUS\"\n        output: \"{state_paths.state_log}\"\n\n      step_create_strategy:\n        action: \"Create strategy file from template with initial questions\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n        populate:\n          topic: \"{research_topic}\"\n          key_questions: \"Derive 3-5 key questions from the research topic\"\n          known_context: \"None\"\n          known_context_summary: \"None\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n        output: \"{state_paths.strategy}\"\n\n      step_create_registry:\n        action: \"Initialize reducer-owned findings registry\"\n        content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n        output: \"{state_paths.registry}\"\n\n      step_enrich_strategy_context:\n        action: \"Ensure Known Context is written only after strategy.md exists\"\n        condition: \"prior_context_found\"\n        edit: \"{state_paths.strategy}\"\n        note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n\n      step_enrich_strategy_resource_map:\n        action: \"Inject resource-map status into Known Context after strategy.md exists\"\n        edit: \"{state_paths.strategy}\"\n        note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_detect_spec_present:\n        action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n        inspect:\n          - \"{spec_folder}/spec.md\"\n          - \"{state_paths.lock_file}\"\n        classify:\n          no-spec: \"spec.md is absent before any pre-init mutation\"\n          spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n          spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n          conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n        outputs:\n          - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n          - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_preinit_spec_branch:\n        action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n        protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n        branches:\n          no-spec:\n            create: \"{spec_folder}/spec.md\"\n            seed_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n            scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n            set:\n              folder_state: \"spec-just-created-by-this-run\"\n              validate_spec_doc: true\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-present:\n            edit: \"{spec_folder}/spec.md\"\n            set:\n              validate_spec_doc: true\n            idempotency_check:\n              host_anchor: \"Open Questions\"\n              normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n              if_match:\n                skip_append: true\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              if_no_match:\n                append_only:\n                  - host_anchor: \"Open Questions\"\n                    content: \"Add the normalized research topic only if it is not already present.\"\n                  - host_anchor: \"Research Context\"\n                    content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-just-created-by-this-run:\n            verify_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            set:\n              validate_spec_doc: false\n            note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n          conflict-detected:\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n            halt: true\n\n      step_validate_preinit_spec_doc:\n        action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n        condition: \"validate_spec_doc\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n\n      step_telemetry_heartbeat_started:\n        action: \"Emit a single-loop started row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        canonical_lifecycle_event: \"iteration_start\"\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n          const generation = Number(config.lineage?.generation ?? 1);\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n          const row = {\n            event: 'started',\n            label: 'single',\n            at: timestamp,\n            duration_ms: 0,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation },\n                event: row.event,\n                status: 'running',\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n\n      step_init_complete:\n        log: \"Initialization complete. Config, state, and strategy files created.\"\n        set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 2: ITERATION LOOP\n  # ═══════════════════════════════════════════════════════════════\n  phase_loop:\n    purpose: Dispatch agent iterations until convergence\n    repeat: true\n    max_repeats: \"{max_iterations}\"\n    steps:\n\n      step_refresh_lock:\n        action: \"Refresh the packet lock heartbeat before the iteration begins\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n        on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n\n      step_record_artifact_migration:\n        action: \"Record a legacy artifact alias read once per session, after the run is open\"\n        skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n        append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n        set: { migration_recorded: true }\n\n      step_read_state:\n        action: \"Read current state from JSONL and strategy\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.config}\"\n        extract:\n          - iteration_count: \"Count lines where type === 'iteration'\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n          - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n          - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n          - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n          - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n          - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n          - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n          - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n          - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n          - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n          - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n          - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n          - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n          - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n          - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n          - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n          - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n          - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n          - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n\n      step_run_now_check:\n        action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n          node - \"$EVENT_DIR\" <<'EOF'\n          const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n          const { join } = require('node:path');\n\n          const eventDir = process.argv[2];\n          const sentinelPath = \"{state_paths.run_now_sentinel}\";\n          const pausePath = \"{state_paths.pause_sentinel}\";\n          const sessionId = \"{config.lineage.sessionId}\";\n          const generation = Number(\"{config.lineage.generation}\");\n          const run = Number(\"{current_iteration}\");\n\n          // The state log is a projection the gateway rebuilds from the ledger, so a\n          // run-now row is staged as a canonical ledger event and appended by the\n          // gateway; a write beside the projection is dropped by the next refresh.\n          // The loop boundary has no lineage identity yet, so the session names both\n          // scope halves rather than inventing a second identifier.\n          const scope = { runId: sessionId, lineageId: sessionId };\n\n          let sequence = 0;\n\n          function record(event, fields) {\n            sequence += 1;\n            writeFileSync(\n              join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n              JSON.stringify({\n                stem: `deep_research.${event}`,\n                scope,\n                data: { mode: \"research\", run, sessionId, generation, ...fields },\n              }),\n              \"utf8\",\n            );\n          }\n\n          if (existsSync(sentinelPath)) {\n            record(\"run_now_requested\", { sentinelPath });\n            if (existsSync(pausePath)) {\n              record(\"run_now_rejected\", {\n                sentinelPath,\n                reason: \"loop_paused\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n 420,700p .skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1793915932419,"end":1793915932547}}}}
{"type":"step_finish","timestamp":1793915933307,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8d27b001JnKOIMNnIj8kru","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8c9c300180osHYF3c7ouBS","type":"step-finish","reason":"tool-calls","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6","cost":0.000898062,"tokens":{"input":4505,"output":59,"reasoning":84,"cache":{"read":45504,"write":0}}}}
{"type":"step_start","timestamp":1793915934411,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8d6cb001hCy6K4FUkyemFZ","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8d280001sTZxmSMUieRsDx","type":"step-start","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6"}}
{"type":"tool_use","timestamp":1793915934767,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"partID":"prt_1adb8d787001DNECO6O3V245lm","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8d280001sTZxmSMUieRsDx","type":"tool","id":"chatcmpl-tool-9d5b50b4a6cb6646","tool":"shell","state":{"status":"completed","input":{"command":"grep -n \"step_reduce_state\\|reduce-state\\|step_post_dispatch_validate\\|step_synthesis\\|synthesis\\b\\|stopReason\\|phase_synthesis\\|step_write_research\\|step_merge\" .skilled/commands/deep/assets/deep-research-auto.yaml | head -60"},"output":"22:action: Run deep-research loop from initialization through synthesis\n141:    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n172:  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n217:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n219:      phase_synthesis will consolidate results across all lineages.\n334:          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n739:          append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n773:          1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n1040:                action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1047:                  command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1051:                  log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1052:                  skip_to: phase_synthesis\n1054:              log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1055:              skip_to: phase_synthesis\n1058:            skip_to: phase_synthesis\n1060:          append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1137:          canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1140:          canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1902:      step_reduce_state:\n1904:        command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n2014:        source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n2142:  phase_synthesis:\n2157:        action: \"Hydrate summary metrics before synthesis\"\n2179:          - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n2187:        identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n2194:          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n2200:          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n2211:          If research/research.md exists (progressive synthesis was active):\n2228:          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2246:          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2247:          CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2248:          [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2283:          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2287:          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2288:        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2336:          function terminalEvent(stopReason) {\n2337:            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2338:            if (stopReason === 'error') return 'failed';\n2389:        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2457:  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2470:    - write_continuity_after_synthesis\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"22:action: Run deep-research loop from initialization through synthesis\n141:    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n172:  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n217:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n219:      phase_synthesis will consolidate results across all lineages.\n334:          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n739:          append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n773:          1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n1040:                action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1047:                  command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1051:                  log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1052:                  skip_to: phase_synthesis\n1054:              log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1055:              skip_to: phase_synthesis\n1058:            skip_to: phase_synthesis\n1060:          append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1137:          canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1140:          canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1902:      step_reduce_state:\n1904:        command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n2014:        source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n2142:  phase_synthesis:\n2157:        action: \"Hydrate summary metrics before synthesis\"\n2179:          - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n2187:        identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n2194:          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n2200:          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n2211:          If research/research.md exists (progressive synthesis was active):\n2228:          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2246:          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2247:          CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2248:          [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2283:          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2287:          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2288:        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2336:          function terminalEvent(stopReason) {\n2337:            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2338:            if (stopReason === 'error') return 'failed';\n2389:        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2457:  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2470:    - write_continuity_after_synthesis\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"grep -n \\\"step_reduce_state\\\\|reduce-state\\\\|step_post_dispatch_validate\\\\|step_synthesis\\\\|synthesis\\\\b\\\\|stopReason\\\\|phase_synthesis\\\\|step_write_research\\\\|step_merge\\\" .skilled/commands/deep/assets/deep-research-auto.yaml | head -60\"}"},"time":{"start":1793915934599,"end":1793915934767}}}}
{"type":"step_finish","timestamp":1793915935655,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8dba7001HXez0psl7zE2n2","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8d280001sTZxmSMUieRsDx","type":"step-finish","reason":"tool-calls","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6","cost":0.00092376,"tokens":{"input":4572,"output":100,"reasoning":47,"cache":{"read":49920,"write":0}}}}
{"type":"step_start","timestamp":1793915936997,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8e0e5001azZues9AknllEv","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8dbab0013yADoOqwWWv8VX","type":"step-start","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6"}}
{"type":"tool_use","timestamp":1793915937150,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"partID":"prt_1adb8e0e6001eY7om7ma0jbXJj","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8dbab0013yADoOqwWWv8VX","type":"tool","id":"chatcmpl-tool-b3e4c7bf8bdad963","tool":"shell","state":{"status":"completed","input":{"command":"sed -n 1890,1930p .skilled/commands/deep/assets/deep-research-auto.yaml; echo \"=====SYNTH=====\"; sed -n 2142,2400p .skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n        outputs:\n          - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n\n      step_reduce_state:\n        action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n        command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n        inputs:\n          latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n          newIterationFile: \"{state_paths.iteration_pattern}\"\n          priorReducedState: \"{state_paths.registry}\"\n        outputs:\n          - \"{state_paths.registry}\"\n          - \"{state_paths.dashboard}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n          - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n          - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n        failure_modes:\n          malformed_delta: \"skip + warn\"\n          missing_iteration_file: \"no-op + error\"\n          schema_mismatch: \"reject + conflict event\"\n          question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n        guarantee: \"Idempotent for identical inputs\"\n\n      step_graph_upsert:\n        action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n        note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n        command: |\n          node <<'EOF'\n          const { existsSync, readFileSync } = require('node:fs');\n          const { join } = require('node:path');\n          const { spawnSync } = require('node:child_process');\n=====SYNTH=====\n  phase_synthesis:\n    purpose: Compile all iteration findings into final research/research.md\n    steps:\n\n      step_fanout_merge:\n        description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n        skip_when: \"config.fanout is absent\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n            --loop-type research \\\n            --artifact-dir {artifact_dir}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n      step_hydrate_summary_metrics:\n        action: \"Hydrate summary metrics before synthesis\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        read_patterns:\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n        extract:\n          - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n          - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n\n      step_read_all_iterations:\n        action: \"Read all iteration files and strategy\"\n        read_patterns:\n          - \"{state_paths.iteration_dir}/iteration-*.md\"\n          - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n        read_also: \"{state_paths.strategy}\"\n        identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n        selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n\n      step_emit_resource_map:\n        action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n        branch_on: \"config.fanout\"\n        if_present:\n          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n            - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n        if_absent:\n          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n        write:\n          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n      step_compile_research:\n        action: \"Compile or finalize research/research.md\"\n        instructions: |\n          If research/research.md exists (progressive synthesis was active):\n            1. Read current research/research.md\n            2. Consolidate and deduplicate findings across all iterations\n            3. Fill any empty sections with findings from iteration files\n            4. Remove redundancy while preserving all unique findings\n            5. Add convergence report as appendix\n            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n\n          If research/research.md does not exist:\n            1. Create research/research.md following 17-section template\n            2. Populate sections from iteration files\n            3. Add citations from original sources\n            4. Note unanswered questions in Open Questions section\n            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n        output: \"{state_paths.research_output}\"\n\n      step_convergence_report:\n        action: \"Generate and append convergence report\"\n        report: |\n          ## Convergence Report\n          - Stop reason: {reason}\n          - Total iterations: {iteration_count}\n          - Questions answered: {answered_count} / {total_questions}\n          - Remaining questions: {remaining_questions}\n          - Last 3 iteration summaries: {last_3_summaries}\n          - Convergence threshold: {convergence_threshold}\n          - Divergence summary: {divergence_summary}\n          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n          CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n          [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n          node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n            --artifact-dir \"{state_paths.packet_dir}\" \\\n            --state-log \"{state_paths.state_log}\" \\\n            --registry \"{state_paths.registry}\" \\\n            --output \"{state_paths.research_output}\" \\\n            --dashboard \"{state_paths.dashboard}\" \\\n            --stop-reason \"{reason}\" \\\n            --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n          NODE_STATUS=$?\n          for eventFile in \"$EVENT_DIR\"/*.json; do\n            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n          exit \"$NODE_STATUS\"\n\n      step_writeback_spec_findings:\n        action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n        edit: \"{spec_folder}/spec.md\"\n        host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n        generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n        generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n        fail_closed_conflict_check:\n          if_existing_generated_fence_present:\n            detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n            on_manual_edit_conflict:\n              append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              halt: true\n        instructions:\n          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n          - \"Replace exactly one generated findings block under the chosen host anchor.\"\n          - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n          - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_validate_post_synthesis_spec_doc:\n        action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_telemetry_heartbeat_terminal:\n        action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        terminal_events: [completed, failed, stopped]\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n          const reason = '{reason}';\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          function terminalEvent(stopReason) {\n            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n            if (stopReason === 'error') return 'failed';\n            return 'completed';\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const event = terminalEvent(reason);\n          const row = {\n            event,\n            label: 'single',\n            terminal: true,\n            reason,\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, reason },\n                event,\n                status: event,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n\n      step_stage_artifact_dir:\n        skip_when: \"config.fanout_lineage_artifact_dir is present\"\n        action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n        command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n        note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve research context in the packet's canonical continuity documents\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n        outputs:\n          - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n\n      step_reduce_state:\n        action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n        command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n        inputs:\n          latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n          newIterationFile: \"{state_paths.iteration_pattern}\"\n          priorReducedState: \"{state_paths.registry}\"\n        outputs:\n          - \"{state_paths.registry}\"\n          - \"{state_paths.dashboard}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n          - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n          - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n        failure_modes:\n          malformed_delta: \"skip + warn\"\n          missing_iteration_file: \"no-op + error\"\n          schema_mismatch: \"reject + conflict event\"\n          question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n        guarantee: \"Idempotent for identical inputs\"\n\n      step_graph_upsert:\n        action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n        note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n        command: |\n          node <<'EOF'\n          const { existsSync, readFileSync } = require('node:fs');\n          const { join } = require('node:path');\n          const { spawnSync } = require('node:child_process');\n=====SYNTH=====\n  phase_synthesis:\n    purpose: Compile all iteration findings into final research/research.md\n    steps:\n\n      step_fanout_merge:\n        description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n        skip_when: \"config.fanout is absent\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n            --loop-type research \\\n            --artifact-dir {artifact_dir}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n      step_hydrate_summary_metrics:\n        action: \"Hydrate summary metrics before synthesis\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        read_patterns:\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n        extract:\n          - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n          - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n\n      step_read_all_iterations:\n        action: \"Read all iteration files and strategy\"\n        read_patterns:\n          - \"{state_paths.iteration_dir}/iteration-*.md\"\n          - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n        read_also: \"{state_paths.strategy}\"\n        identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n        selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n\n      step_emit_resource_map:\n        action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n        branch_on: \"config.fanout\"\n        if_present:\n          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n            - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n        if_absent:\n          command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n        write:\n          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n      step_compile_research:\n        action: \"Compile or finalize research/research.md\"\n        instructions: |\n          If research/research.md exists (progressive synthesis was active):\n            1. Read current research/research.md\n            2. Consolidate and deduplicate findings across all iterations\n            3. Fill any empty sections with findings from iteration files\n            4. Remove redundancy while preserving all unique findings\n            5. Add convergence report as appendix\n            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n\n          If research/research.md does not exist:\n            1. Create research/research.md following 17-section template\n            2. Populate sections from iteration files\n            3. Add citations from original sources\n            4. Note unanswered questions in Open Questions section\n            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n        output: \"{state_paths.research_output}\"\n\n      step_convergence_report:\n        action: \"Generate and append convergence report\"\n        report: |\n          ## Convergence Report\n          - Stop reason: {reason}\n          - Total iterations: {iteration_count}\n          - Questions answered: {answered_count} / {total_questions}\n          - Remaining questions: {remaining_questions}\n          - Last 3 iteration summaries: {last_3_summaries}\n          - Convergence threshold: {convergence_threshold}\n          - Divergence summary: {divergence_summary}\n          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n          CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n          [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n          node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n            --artifact-dir \"{state_paths.packet_dir}\" \\\n            --state-log \"{state_paths.state_log}\" \\\n            --registry \"{state_paths.registry}\" \\\n            --output \"{state_paths.research_output}\" \\\n            --dashboard \"{state_paths.dashboard}\" \\\n            --stop-reason \"{reason}\" \\\n            --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n          NODE_STATUS=$?\n          for eventFile in \"$EVENT_DIR\"/*.json; do\n            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n          exit \"$NODE_STATUS\"\n\n      step_writeback_spec_findings:\n        action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n        edit: \"{spec_folder}/spec.md\"\n        host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n        generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n        generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n        fail_closed_conflict_check:\n          if_existing_generated_fence_present:\n            detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n            on_manual_edit_conflict:\n              append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              halt: true\n        instructions:\n          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n          - \"Replace exactly one generated findings block under the chosen host anchor.\"\n          - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n          - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_validate_post_synthesis_spec_doc:\n        action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_telemetry_heartbeat_terminal:\n        action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        terminal_events: [completed, failed, stopped]\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n          const reason = '{reason}';\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          function terminalEvent(stopReason) {\n            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n            if (stopReason === 'error') return 'failed';\n            return 'completed';\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const event = terminalEvent(reason);\n          const row = {\n            event,\n            label: 'single',\n            terminal: true,\n            reason,\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, reason },\n                event,\n                status: event,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n\n      step_stage_artifact_dir:\n        skip_when: \"config.fanout_lineage_artifact_dir is present\"\n        action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n        command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n        note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve research context in the packet's canonical continuity documents\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n 1890,1930p .skilled/commands/deep/assets/deep-research-auto.yaml; echo \\\"=====SYNTH=====\\\"; sed -n 2142,2400p .skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1793915936998,"end":1793915937150}}}}
{"type":"step_finish","timestamp":1793915937918,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8e47e0012bx1EXr4j8lqlN","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8dbab0013yADoOqwWWv8VX","type":"step-finish","reason":"tool-calls","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6","cost":0.0004707,"tokens":{"input":1666,"output":96,"reasoning":0,"cache":{"read":54400,"write":0}}}}
{"type":"step_start","timestamp":1793915939051,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"id":"prt_1adb8e8eb001YV3mfpgmlGdtEs","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8e482001CPn1IqIXCL6wYI","type":"step-start","snapshot":"550d739932bbbeb8e3662a01605eaabc40fb23f6"}}
{"type":"tool_use","timestamp":1793915940406,"sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","part":{"partID":"prt_1adb8eca20026eaFUGAFW5ixaG","sessionID":"ses_e52476d2effeOgPb5IbtWFIN6s","messageID":"msg_1adb8e482001CPn1IqIXCL6wYI","type":"tool","id":"chatcmpl-tool-a65b0c5ef7d052bd","tool":"shell","state":{"status":"completed","input":{"command":"find specs/cli-external-orchestration/085-cli-deepseek-harness-creation/001-deep-research/research/lineages/luna -maxdepth 2 -type f | head -30; echo \"---CONFIG ROOT---\"; cat specs/cli-external-orchestration/085-cli-deepseek-harness-creation/001-deep-research/research/deep-research-config.json; echo \"---TMPL CONFIG---\"; cat .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json"},"output":"specs/cli-external-orchestration/085-cli-deepseek-harness-creation/001-deep-research/research/lineages/luna/invocation-metadata.json\n---CONFIG ROOT---\n{\n  \"topic\": \"DeepSeek Harness (dsh, github.com/deepseek-ai/deepseek-harness, installed 0.2.2-rc.1) as a new cli-external-orchestration runtime mode that mirrors cli-pi: headless dispatch contract, providers (LLM Gateway and OpenCode Go DeepSeek V4.1 Flash), repo-local runtime folder, skills, agents, commands, plugins and hooks to port, third-party Pi plugins to migrate or drop, MCP, deep-loop fan-out executor support, every cross-repo touch point, and the phase plan. FIRST read specs/cli-external-orchestration/085-cli-deepseek-harness-creation/001-deep-research/research-angles.md (ten angles, rules of engagement) and resource-map.md (known context, do not rediscover). One angle per iteration.\",\n  \"specFolder\": \"specs/cli-external-orchestration/085-cli-deepseek-harness-creation/001-deep-research\",\n  \"maxIterations\": 20,\n  \"minIterations\": 3,\n  \"convergenceThreshold\": 0.05,\n  \"antiConvergence\": { \"convergenceMode\": \"default\", \"divergent\": {} },\n  \"stuckThreshold\": 3,\n  \"minIdeaObservations\": 2,\n  \"maxDurationMinutes\": 240,\n  \"executionMode\": \"auto\",\n  \"stop_policy\": \"max-iterations\",\n  \"resource_map_present\": true,\n  \"resource_map\": { \"emit\": true },\n  \"fanout\": {\n    \"executors\": [\n      { \"kind\": \"cli-codex\", \"model\": \"gpt-6-luna\", \"reasoningEffort\": \"xhigh\", \"serviceTier\": \"fast\", \"label\": \"luna\", \"iterations\": 10, \"timeoutSeconds\": 2400 },\n      { \"kind\": \"cli-opencode\", \"model\": \"llmgateway/deepseek-v4.1-flash-1017\", \"reasoningEffort\": \"max\", \"label\": \"deepseek\", \"iterations\": 10, \"timeoutSeconds\": 2400 }\n    ],\n    \"concurrency\": 2\n  },\n  \"lineage\": { \"sessionId\": \"dr-085-001-fanout-20261105\", \"parentSessionId\": null, \"lineageMode\": \"new\", \"generation\": 1, \"continuedFromRun\": null },\n  \"createdAt\": \"2026-11-05T00:00:00Z\",\n  \"status\": \"initialized\"\n}\n---TMPL CONFIG---\n{\n  \"topic\": \"\",\n  \"maxIterations\": 10,\n  \"convergenceThreshold\": 0.05,\n  \"antiConvergence\": {\n    \"minIterations\": 3,\n    \"convergenceMode\": \"default\",\n    \"stopPolicy\": \"fail-closed\"\n  },\n  \"stuckThreshold\": 3,\n  \"maxDurationMinutes\": 120,\n  \"maxToolCallsPerIteration\": 24,\n  \"maxMinutesPerIteration\": 10,\n  \"progressiveSynthesis\": true,\n  \"specFolder\": \"\",\n  \"createdAt\": \"\",\n  \"status\": \"initialized\",\n  \"executionMode\": \"auto\",\n  \"executor\": {\n    \"kind\": \"native\",\n    \"model\": null,\n    \"reasoningEffort\": null,\n    \"serviceTier\": null,\n    \"sandboxMode\": null,\n    \"timeoutSeconds\": 900\n  },\n  \"lineage\": {\n    \"sessionId\": \"\",\n    \"parentSessionId\": null,\n    \"lineageMode\": \"new\",\n    \"allowedModes\": [\n      \"new\",\n      \"resume\",\n      \"restart\"\n    ],\n    \"deferredModes\": [\n      \"fork\",\n      \"completed-continue\"\n    ],\n    \"generation\": 1,\n    \"continuedFromRun\": null\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"version\": \"1.0\",\n    \"registryFile\": \"research/findin