may name only code_mode');\n3037:   }\n3038:   if (mcpServers.length > 0) {\n3039:     const mcpPatch = path.join(repoRoot, '.dsh', 'patches', 'mcp-code-mode.patch.yml');\n3040:     if (!fs.existsSync(mcpPatch)) {\n3041:       throw inputError('cli-deepseek-harness MCP patch is missing');\n3042:     }\n3043:     args.push('--patch', mcpPatch);\n3044:   }\n3045: \n3046:   const permissionMode = resolvedSandbox === 'read-only' ? 'read-only' : 'workspace-write';\n3047:   args.push('--json', '--permission-mode', permissionMode, '--approval-policy', 'never', '-');\n3048:   const reasoningEffort = pinReasoningEffortForModel(model, lineage.reasoningEffort || 'max');\n3049:   return finalizeLineageCommand({\n\n(Showing lines 2970-3049 of 4399. Use offset=3050 to continue.)\n</content>"}
