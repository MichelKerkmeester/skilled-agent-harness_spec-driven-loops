return {\n1932:     path: iterationPath,\n1933:     run: runMatch ? Number(runMatch[1]) : 0,\n1934:     focus: normalizeText(focusSection || (headingMatch ? headingMatch[1] : 'Unknown focus')),\n1935:     findings: extractListItems(findingsSection),\n1936:     ruledOut: extractListItems(ruledOutSection),\n1937:     deadEnds: extractListItems(deadEndsSection),\n1938:     questionsRemaining: extractListItems(questionsRemainingSection),\n1939:     sources: extractListItems(sourcesSection),\n1940:     reflectionWorked: parseReflectionValue(reflectionSection, 'What worked and why'),\n1941:     reflectionFailed: parseReflectionValue(reflectionSection, 'What did not work and why'),\n1942:     reflectionDifferent: parseReflectionValue(reflectionSection, 'What I would do differently'),\n1943:     nextFocus: normalizeText(nextFocusSection),\n1944:   };\n1945: }\n1946: \n1947: function extractKeyQuestionsSection(strategyContent) {\n1948:   const canonical = extractSection(strategyContent, '3. KEY QUESTIONS (remaining)');\n1949:   if (canonical) {\n1950:     return canonical;\n1951:   }\n1952: \n1953:   // A fan-out leaf can author the section without the ordinal, so fall back to the\n1954:   // heading core and treat the parenthetical as optional.\n1955:   const pattern = /(?:^|\\n)##\\s+(?:\\d+[A-Za-z]?\\.\\s+)?KEY QUESTIONS(?:\\s*\\(remaining\\))?[^\\S\\n]*\\n([\\s\\S]*?)(?=\\n##\\s|$)/i;\n1956:   const match = strategyContent.match(pattern);\n1957:   return match ? match[1].trim() : '';\n1958: }\n1959: \n1960: function parseStrategyQuestions(strategyContent) {\n1961:   const section = extractKeyQuestionsSection(strategyContent);\n1962:   return section\n1963:     .split('\\n')\n1964:     .map((line) => line.trim())\n1965:     .filter((line) => /^- \\[[ xX]\\]\\s+/.test(line))\n1966:     .map((line) => {\n1967:       const checked = /^- \\[[xX]\\]\\s+/.test(line);\n1968:       const text = normalizeText(line.replace(/^- \\[[ xX]\\]\\s+/, ''));\n1969:       return {\n1970:         checked,\n1971:         text,\n1972:         origin: LEGACY_IMPORT_ORIGIN,\n1973:         source: LEGACY_IMPORT_SOURCE,\n1974:         injectedAtIteration: 0,\n1975:         promotedQuestionId: null,\n1976:       };\n1977:     });\n1978: }\n1979: \n1980: function buildCoverageBySources(iterationFiles, iterationRecords) {\n1981:   const counter = {};\n1982:   const seen = new Set();\n1983: \n1984:   for (const source of iterationFiles.flatMap((iteration) => iteration.sources).concat(\n1985:     iterationRecords.flatMap((record) => (Array.isArray(record.sourcesQueried) ? record.sourcesQueried : [])),\n1986:   )) {\n1987:     const normalized = normalizeText(source);\n1988:     if (!normalized || seen.has(normalized)) {\n1989:       continue;\n1990:     }\n1991:     seen.add(normalized);\n1992: \n1993:     let key = 'other';\n1994:     if (/^https?:\\/\\//i.test(normalized)) {\n1995:       try {\n1996:         key = new URL(normalized).hostname;\n1997:       } catch (_error) {\n1998:         key = 'web';\n1999:       }\n2000:     } else if (normalized.startsWith('memory:')) {\n2001:       key = 'memory';\n2002:     } else if (normalized.includes(':')) {\n2003:       key = 'code';\n2004:     }\n2005: \n2006:     counter[key] = (counter[key] || 0) + 1;\n2007:   }\n2008: \n2009:   return Object.fromEntries(Object.entries(counter).sort(([left], [right]) => left.localeCompare(right)));\n2010: }\n2011: \n2012: function uniqueById(items) {\n2013:   const seen = new Set();\n2014:   const result = [];\n2015: \n2016:   for (const item of items) {\n2017:     if (seen.has(item.id)) {\n2018:       continue;\n2019:     }\n\n(Showing lines 1900-2019 of 3393. Use offset=2020 to continue.)\n</content>"}
