ted:\n1044:                   set:\n1045:                     next_focus: \"{pivot_result.restoredFocus}\"\n1046:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1047:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1048:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1049:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1050:                   proceed_to: step_rejected_pattern_cache\n1051:                 if_failed:\n1052:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1053:                   skip_to: phase_synthesis\n1054:             on_error:\n1055:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1056:               skip_to: phase_synthesis\n1057:           if_existing_terminal_path:\n1058:             log: \"Loop stopping. Reason: {reason}\"\n1059:             skip_to: phase_synthesis\n1060:         if_stuck_recovery:\n1061:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1062:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1063:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1064:           reset: { stuck_count: 0 }\n1065:         if_continue:\n1066:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1067: \n1068:       step_rejected_pattern_cache:\n1069:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1070:         read:\n1071:           - \"{state_paths.state_log}\"\n1072:           - \"{state_paths.registry}\"\n1073:           - \"{state_paths.strategy}\"\n1074:         candidate_sources:\n1075:           next_focus:\n1076:             category: \"next-focus\"\n1077:             values:\n1078:               - \"{next_focus}\"\n1079:               - \"{remaining_questions_list}\"\n1080:               - \"{carried_forward_open_questions}\"\n1081:           recovery:\n1082:             category: \"recovery\"\n1083:             values:\n1084:               - \"{recovery_strategy}\"\n1085:               - \"{least_explored}\"\n1086:           ideas:\n1087:             category: \"ideas\"\n1088:             values:\n1089:               - \"{promoted_ideas_list}\"\n1090:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1091:         algorithm: |\n1092:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1093:           reducer pass as the source of truth.\n1094:           Compare normalized exact text first. Then compare fuzzy similarity with\n1095:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1096:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1097:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1098:           halt for operator input instead of reusing a rejected idea.\n1099:         outputs:\n1100:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1101:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1102:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1103:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1104:         if_next_focus_suppressed:\n1105:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1106:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1107:         if_all_candidates_s","truncated":true}
