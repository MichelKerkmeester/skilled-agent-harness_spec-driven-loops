, 'unknown-legacy-record', null, version);\n489:   if (!stableTargetIdentity(input, targetStem)) {\n490:     const reasonCode = targetStem === 'deep_research.question_registered'\n491:       && hasStableIdentity(input)\n492:       ? 'question-registration-fields-missing'\n493:       : 'stable-identity-missing';\n494:     return decision('pin-old-runtime', reasonCode, targetStem, version);\n495:   }\n496:   return decision('migrate', 'registered-pure-upcaster', targetStem, version);\n497: }\n498: \n499: export function upcastLegacyDeepResearchRecord(\n500:   input: unknown,\n501:   context: LegacyUpcastContext,\n502: ): LegacyUpcastResult {\n503:   const compatibility = decideDeepResearchCompatibility(input);\n504:   if (compatibility.status !== 'migrate' || !compatibility.targetStem || !isObject(input)) {\n505:     return Object.freeze({ status: 'refused', decision: compatibility });\n506:   }\n507: \n508:   const recordDigest = digestRecord(input);\n509:   const iteration = iterationFromContext(context);\n510:   const warnings: string[] = [];\n511:   let data: JsonObject;\n512:   let scope: DeepResearchScope = context.scope;\n513:   let occurredAt: string | undefined;\n514: \n515:   switch (compatibility.targetStem) {\n516:     case 'deep_research.question_registered': {\n517:       const dependencyQuestionIds = stringArray(input.dependencyQuestionIds);\n518:       const requiredSourceClasses = stringArray(input.requiredSourceClasses);\n519:       const disconfirmingQueryRecipeIds = stringArray(input.disconfirmingQueryRecipeIds);\n520:       if (!hasQuestionRegistrationData(input)\n521:         || dependencyQuestionIds === null\n522:         || requiredSourceClasses === null\n523:         || disconfirmingQueryRecipeIds === null) {\n524:         return Object.freeze({\n525:           status: 'refused',\n526:           decision: decision(\n527:             'pin-old-runtime',\n528:             'question-registration-fields-missing',\n529:             compatibility.targetStem,\n530:             compatibility.sourceVersion,\n531:           ),\n532:         });\n533:       }\n534:       scope = { ...context.scope, questionId: input.questionId as string };\n535:       data = {\n536:         normalizedQuestionDigest: input.normalizedQuestionDigest as string,\n537:         dependencyQuestionIds,\n538:         requiredSourceClasses,\n539:         disconfirmingQueryRecipeIds,\n540:         budgetRef: input.budgetRef as string,\n541:       };\n542:       break;\n543:     }\n544:     case 'deep_research.run_initialized': {\n545:       const fields = legacyConfigFields(input);\n546:       if (fields.status === 'mistyped') {\n547:         return refusedUpcast(\n548:           compatibility,\n549:           `${reducerReadRowReason(compatibility.targetStem, 'mistyped')}:${fields.field}`,\n550:         );\n551:       }\n552:       data = {\n553:         generation: fields.generation,\n554:         charterDigest: recordDigest,\n555:         configDigest: recordDigest,\n556:         executorFingerprint: sha256Bytes(canonicalBytes(stringValue(input.executor, 'legacy'))),\n557:         replayFingerprint: context.replay.final_digest,\n558:         maxIterations: fields.maxIterations,\n559:         convergencePolicyVersion: 'legacy-jsonl@1',\n560:         ...legacyTopic(input.topic),\n561:       };\n562:       warnings.push('Legacy config has one digest for both charter and configuration evidence.');\n563:       for (const field of fields.converted) {\n564:         warnings.push(`The config ${field} was a numeric string and is carried as the number it spells.`);\n565:       }\n566:       break;\n567:     }\n568:     case 'deep_research.run_resumed':\n569:       data = {\n570:         priorTailDigest: context.prevEventHash,\n571:         sourceLineageId: stringValue(input.parentSessionId, context.scope.lineageId),\n572:         resumeReason: stringValue(input.reason, 'legacy-resume'),\n573:         generation: positiveInteger(input.generation, 1),\n574:         compatibilityDecision: 'migrate',\n575:         recoveryReceiptRef: `legacy-jsonl:${recordDigest}`,\n576:       };\n577:       break;\n578:     case 'deep_research.run_restarted':\n579:       data = {\n580:         priorTailDigest: context.prevEventHash,\n581:         archivedLineageId: stringValue(input.parentSessionId, context.scope.lineageId),\n582:         restartReason: stringValue(input.reason, 'legacy-restart'),\n583:         generation: positiveInteger(input.generation, 1),\n584:         compatibilityDecision: 'migrate',\n585:         recoveryReceiptRef: `legacy-jsonl:${recordDigest}`,\n586:       };\n587:       break;\n588:     case 'deep_research.iteration_completed':\n589:       if (iteration === null) return Object.freeze({\n\n(Showing lines 450-589 of 829. Use offset=590 to continue.)\n</content>"}
