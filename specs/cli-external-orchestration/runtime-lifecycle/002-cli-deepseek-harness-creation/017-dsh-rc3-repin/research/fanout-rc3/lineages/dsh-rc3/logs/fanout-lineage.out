{"type":"tool_result","callId":"chatcmpl-tool-9d2aa98ad2934b07","status":"completed","result":"}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2c. REDUCER PROVENANCE\n// ─────────────────────────────────────────────────────────────────────────────\n\n// The research reducer stamps this description into the dashboard it writes beside\n// the registry and strategy on every pass. A dashboard that exists without the stamp\n// says the projections were written by hand, so the merge refuses the registry; a\n// lineage with no dashboard leaves provenance unconfirmed and is merged with a\n// warning, because the state-log reconstruction path is the contract for runs that\n// wrote no projections of their own.\n//\n// An unreadable dashboard refuses only its own lineage: the reason travels back to\n// the caller that reports it, so one broken link cannot abort every other lineage's\n// merge the way the shared resolver's throw would.\nconst RESEARCH_REDUCER_DASHBOARD = {\n  fileName: 'deep-research-dashboard.md',\n  stamp: 'description: Auto-generated reducer view over the research packet.',\n};\n\nfunction inspectResearchReducerProvenance(root, label, lineageDir) {\n  const dashboardPath = path.join(lineageDir, RESEARCH_REDUCER_DASHBOARD.fileName);\n  let realFile;\n  try {\n    realFile = resolveOptionalRealFile(root, dashboardPath, `lineage ${label} dashboard`);\n  } catch (error) {\n    return { state: 'refused', reason: error instanceof Error ? error.message : String(error) };\n  }\n  if (!realFile) return { state: 'unverified', reason: null };\n  const content = fs.readFileSync(realFile, 'utf8');\n  return {\n    state: content.includes(RESEARCH_REDUCER_DASHBOARD.stamp) ? 'reducer' : 'hand-written',\n    reason: null,\n  };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. RESEARCH MERGE\n// ─────────────────────────────────────────────────────────────────────────────\n\n// Executor provenance is label-keyed so a reader can group merged findings by model\n// without decoding lineage directory names. Labels are sorted before insertion so the\n// serialized map does not depend on lineage arrival order.\nfunction buildLineageExecutors(lineageData) {\n  const executors = {};\n  const sorted = [...lineageData].sort((a, b) => (a.label < b.label ? -1 : a.label > b.label ? 1 : 0));\n  for (const { label, kind, model, reasoningEffort } of sorted) {\n    executors[label] = {\n      kind: kind ?? 'unknown',\n      model: model ?? 'unknown',\n      reasoningEffort: reasoningEffort ?? null,\n    };\n  }\n  return executors;\n}\n\n/**\n * Merge research findings registries from all lineages.\n * Deduplicates by findingId; cross-model attribution via lineage labels.\n * Returns the merged registry object.\n */\nfunction mergeResearchRegistries(lineageData, options = {}) {\n  const mergeOptions = resolveMergeOptions(options);\n  const findingById = mergeOptions.enableNearDuplicateDedup ? createFindingBucketIndex() : new Map();\n  const schemaWarnings = [];\n\n  for (const { label, registry: rawRegistry } of lineageData) {\n    const { registry, warnings } = normalizeRegistrySchema(rawRegistry, {\n      canonicalKey: 'keyFindings',\n      aliases: { findings: 'keyFindings' },\n---reducer provenance emission---\n92:    const { type: _type, event: _event, timestamp, ...data } = row;\n99:      occurredAt: timestamp,\n325:    timestamp: normalizeOptionalText(record.timestamp),\n579:    timestamp: entry.timestamp,\n629:    timestamp: normalizeOptionalText(record.timestamp),\n645:      firstObservedAt: observation.timestamp || null,\n646:      lastObservedAt: observation.timestamp || null,\n662:    lastObservedAt: observation.timestamp || existing.lastObservedAt,\n790:      timestamp: context.timestamp || new Date().toISOString(),\n1065:        timestamp: typeof latestRecord?.timestamp === 'string' && latestRecord.timestamp\n1066:          ? latestRecord.timestamp\n1455:      timestamp: context.timestamp || new Date().toISOString(),\n2229:      timestamp: normalizeOptionalText(record.timestamp),\n2312:    timestamp: typeof latestSynthesisComplete.timestamp === 'string' && latestSynthesisComplete.timestamp\n2313:      ? latestSynthesisComplete.timestamp\n2324:  const latestIterationTimestamp = getTimestampValue(iterationRecords.at(-1)?.timestamp);\n2325:  const latestRecoveryTimestamp = getTimestampValue(latestStuckRecovery?.timestamp);\n2326:  if (latestRecoveryTimestamp >= latestIterationTimestamp && latestRecoveryTimestamp > Number.NEGATIVE_INFINITY) {\n2414:function getTimestampValue(timestamp) {\n2415:  const value = Date.parse(timestamp);\n"}
