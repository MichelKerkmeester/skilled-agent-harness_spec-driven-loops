gistry was hand-written rather than reduced`,\n      })}\\n`);\n    } else if (entry.reducerProvenance === 'unverified') {\n      unverifiedProvenance.push(entry.label);\n      process.stderr.write(`${JSON.stringify({\n        type: 'lineage_reducer_provenance_unverified',\n        severity: 'warn',\n        lineage: entry.label,\n        message: `lineage ${entry.label} merged with unverified provenance: no ${RESEARCH_REDUCER_DASHBOAR","truncated":true}
