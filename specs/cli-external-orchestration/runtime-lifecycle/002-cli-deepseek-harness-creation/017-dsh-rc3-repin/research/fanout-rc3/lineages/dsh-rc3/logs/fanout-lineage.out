remains\"\n1223:         if_cli_claude_code:\n1224:           command: |\n1225:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1226:             import { readFileSync } from 'node:fs';\n1227:             import { createHash } from 'node:crypto';\n1228:             import { createRequire } from 'node:module';\n1229: \n1230:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1231:             import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1232: \n1233:             const require = createRequire(import.meta.url);\n1234:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1235:             const executor = {\n1236:               kind: 'cli-claude-code',\n1237:               model: '{config.executor.model}',\n1238:               reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n1239:               serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n1240:               sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n1241:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1242:             };\n1243:             const args = [\n1244:               '-p',\n1245:               withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}'),\n1246:               '--model',\n1247:               executor.model,\n1248:               '--permission-mode',\n1249:               resolveClaudePermissionMode(executor.sandboxMode),\n1250:               '--output-format',\n1251:               'text',\n1252:         