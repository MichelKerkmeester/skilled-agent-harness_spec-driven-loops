>, field: string): string | null {\n320:   return isNonEmptyString(record[field]) ? record[field] : null;\n321: }\n322: \n323: // Absent reads as null; present must be a non-empty string, else undefined marks it invalid.\n324: function optionalStringField(record: Record<string, unknown>, field: string): string | null | undefined {\n325:   if (!(field in record)) return null;\n326:   return isNonEmptyString(record[field]) ? record[field] : undefined;\n327: }\n328: \n329: function requiredStringArrayField(\n330:   record: Record<string, unknown>,\n331:   field: string,\n332: ): string[] | null {\n333:   return stringArray(record[field]);\n334: }\n335: \n336: function hasQuestionRegistrationData(record: Record<string, unknown>): boolean {\n337:   return hasStableIdentity(record)\n338:     && isNonEmptyString(record.questionId)\n339:     && isNonEmptyString(record.normalizedQuestionDigest)\n340:     && stringArray(record.dependencyQuestionIds) !== null\n341:     && stringArray(record.requiredSourceClasses) !== null\n342:     && stringArray(record.disconfirmingQueryRecipeIds) !== null\n343:     && isNonEmptyString(record.budgetRef);\n344: }\n345: \n346: function stableTargetIdentity(\n347:   record: Record<string, unknown>,\n348:   targetStem: DeepResearchEventStem,\n349: ): boolean {\n350:   if (targetStem === 'deep_research.iteration_completed'\n351:     || targetStem === 'deep_research.convergence_blocked') {\n352:     return hasIterationIdentity(record);\n353:   }\n354:   if (targetStem === 'deep_research.question_registered') {\n355:     return hasQuestionRegistrationData(record);\n356:   }\n357:   // The spec-protocol rows carry no run or session identity: the append context\n358:   // supplies their scope and the upcaster validates their payload fields. The\n359:   // rows the reducer reads back are scoped the same way.\n360:   if (CONTEXT_SCOPE_STEMS.has(targetStem)) return true;\n361:   if (REDUCER_READ_ROW_SHAPES[targetStem]) return true;\n362:   return hasStableIdentity(record);\n363: }\n364: \n365: // The envelope accepts only a UTC instant, and the projection writes the\n366: // occurrence time back as the row's timestamp, so anything else cannot travel.\n367: function isUtcTimestamp(value: unknown): value is string {\n368:   if (typeof value !== 'string' || !UTC_TIMESTAMP_PATTERN.test(value)) return false;\n369:   const parsed = new Date(value);\n370:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 19) === value.slice(0, 19);\n371: }\n372: \n373: function reducerReadRowReason(stem: DeepResearchEventStem, problem: string): string {\n374:   return `${stem.replace(/^deep_research\\./, '').replace(/_/g, '-')}-fields-${problem}`;\n375: }\n376: \n377: function digestRecord(record: Record<string, unknown>): string {\n378:   return sha256Bytes(canonicalBytes(record as JsonObject));\n379: }\n380: \n381: // The longest topic the run-open event's prose rule accepts; a longer one is\n382: // left out so the row still upcasts and the projection falls back to the run id.\n383: const MAX_TOPIC_LENGTH = 4_096;\n384: \n385: function legacyTopic(value: unknown): { readonly topic: string } | Record<string, never> {\n386:   return isNonEmptyString(value) && value.length <= MAX_TOPIC_LENGTH\n387:     ? { topic: value }\n388:     : {};\n389: }\n390: \n391: function stringValue(value: unknown, fallback: string): string {\n392:   return isNonEmptyString(value) ? value : fallback;\n393: }\n394: \n395: function positiveInteger(value: unknown, fallback: number): number {\n396:   return Number.isSafeInteger(value) && (value as number) >= 0 ? value as number : fallback;\n397: }\n398: \n399: // The config's counts feed the run's budget and lineage, so a wrongly typed\n\n(Showing lines 280-399 of 829. Use offset=400 to continue.)\n</content>"}
