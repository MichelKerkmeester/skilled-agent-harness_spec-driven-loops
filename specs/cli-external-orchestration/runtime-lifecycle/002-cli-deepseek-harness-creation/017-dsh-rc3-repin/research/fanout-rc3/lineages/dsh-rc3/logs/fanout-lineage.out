olderState, normalizedTopic, specPath, lockPath };\n670:       break;\n671:     }\n672:     case 'deep_research.spec_seed_created': {\n673:       const folderState = requiredStringField(input, 'folder_state');\n674:       const anchorsTouched = requiredStringArrayField(input, 'anchors_touched');\n675:       const diffSummary = requiredStringField(input, 'diff_summary');\n676:       const seedMarkers = requiredStringArrayField(input, 'seed_markers');\n677:       if (folderState === null || anchorsTouched === null\n678:         || diffSummary === null || seedMarkers === null) {\n679:         return refusedUpcast(compatibility, 'spec-seed-created-fields-missing');\n680:       }\n681:       data = { folderState, anchorsTouched, diffSummary, seedMarkers };\n682:       break;\n683:     }\n684:     case 'deep_research.spec_preinit_context_added': {\n685:       const folderState = requiredStringField(input, 'folder_state');\n686:       const normalizedTopic = requiredStringField(input, 'normalized_topic');\n687:       const specPath = requiredStringField(input, 'specPath');\n688:       const anchorsTouched = requiredStringArrayField(input, 'anchors_touched');\n689:       const diffSummary = requiredStringField(input, 'diff_summary');\n690:       if (folderState === null || normalizedTopic === null || specPath === null\n691:         || anchorsTouched === null || diffSummary === null) {\n692:         return refusedUpcast(compatibility, 'spec-preinit-context-added-fields-missing');\n693:       }\n694:       data = { folderState, normalizedTopic, specPath, anchorsTouched, diffSummary };\n695:       break;\n696:     }\n697:     case 'deep_research.spec_preinit_context_deduped': {\n698:       const folderState = requiredStringField(input, 'folder_state');\n699:       const normalizedTopic = requiredStringField(input, 'normalized_topic');\n700:       const specPath = requiredStringField(input, 'specPath');\n701:       const anchorsTouched = requiredStringArrayField(input, 'anchors