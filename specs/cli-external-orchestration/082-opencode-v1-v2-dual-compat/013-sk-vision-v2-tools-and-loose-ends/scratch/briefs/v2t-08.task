    } catch (err) {
      this.broken = true;
      log(`provision failed: ${(err as Error).message}`);

with:

    } catch (err) {
      this.broken = true;
      if (this.closed) {
        log("closed while provisioning; startup stopped");
        this.rejectAll(new SkVisionError("SHUTDOWN", "sk-vision runtime closed"));
        return;
      }
      log(`provision failed: ${(err as Error).message}`);

