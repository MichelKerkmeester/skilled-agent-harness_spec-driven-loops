ags, 'lockPath');\n188:     const holder = fs.existsSync(lockPath) ? readDiskLock(lockPath) : null;\n189:     if (!holder) {\n190:       jsonOut({ command: 'status', exists: false, stale: false, alive: false, holder: null });\n191:       return;\n192:     }\n193:     const stale = lib.isStaleLoopLock(holder);\n194:     const alive = lib.processAlive(holder.ownerPid);\n195:     jsonOut({ command: 'status', exists: true, held: !stale, stale, alive, holder });\n196:     return;\n197:   }\n198: \n199:   if (subcommand === 'refresh') {\n200:     const lockPath = requireString(flags, 'lockPath');\n201:     const ownerPid = resolveOwnerPid(flags);\n202:     const acquireNonce = resolveOptionalNonce(flags);\n203:     const refreshed = lib.refreshLoopLock(lockPath, ownerPid, new Date(), { acquireNonce });\n204:     jsonOut({ command: 'refresh', refreshed });\n205:     return;\n206:   }\n207: \n208:   if (subcommand === 'release') {\n209:     const lockPath = requireString(flags, 'lockPath');\n210:     const ownerPid = resolveOwnerPid(flags);\n211:     const acquireNonce = resolveOptionalNonce(flags);\n212:     const released = lib.releaseLoopLock(lockPath, ownerPid, acquireNonce);\n213:     jsonOut({ command: 'release', released });\n214:     return;\n215:   }\n216: \n217:   throw inputError(`Unknown subcommand \"${subcommand}\": expected acquire | status | refresh | release`);\n218: }\n219: \n\n(Showing lines 95-219 of 228. Use offset=220 to continue.)\n</content>","metadata":{"preview":"  }\n  return value;\n}\n\nfunction resolveOwnerPid(flags) {\n  if (flags.ownerPid === undefined) {\n    return process.pid;\n  }\n  const pid = Number(flags.ownerPid);\n  if (!Number.isInteger(pid) || pid <= 0) {\n    throw inputError('--owner-pid must be a positive integer');\n  }\n  return pid;\n}\n\n// Nonce is optional on the CLI: nonce-less legacy locks still refresh/release\n// on pid match alone, so callers that never captured a nonce keep working.\nfunction resolveOptionalNonce(fla