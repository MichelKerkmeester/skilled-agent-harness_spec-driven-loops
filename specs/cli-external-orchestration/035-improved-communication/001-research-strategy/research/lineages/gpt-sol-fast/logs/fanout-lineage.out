{"type":"tool_use","timestamp":1786433672664,"sessionID":"ses_010495952ffeknG4pENad6KM6w","part":{"type":"tool","tool":"read","callID":"call_9jNYe3WTwWGMtGEScXrHSJtJ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0138-system-deep-loop-communication-research/specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/gpt-sol-fast/findings-registry.json"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0138-system-deep-loop-communication-research/specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/gpt-sol-fast/findings-registry.json</path>\n<type>file</type>\n<content>\n1: {\n2:   \"sessionId\": \"fanout-gpt-sol-fast-1786433150940-mdbr01\",\n3:   \"parentSessionId\": null,\n4:   \"lineageMode\": \"new\",\n5:   \"generation\": 1,\n6:   \"continuedFromRun\": null,\n7:   \"terminalStop\": null,\n8:   \"keyQuestions\": [\n9:     {\n10:       \"id\": \"question-1-what-is-the-safest-primary-source-supported-display-integration-boundary-in-each\",\n11:       \"inboxId\": null,\n12:       \"text\": \"What is the safest primary-source-supported display integration boundary in each of the six CLIs, and how should their events normalize without mutating canonical context, tools, or transcripts?\",\n13:       \"origin\": \"legacy-import\",\n14:       \"source\": \"key-questions\",\n15:       \"injectedAtIteration\": 0,\n16:       \"promotedQuestionId\": null,\n17:       \"addedAtIteration\": 0,\n18:       \"resolvedAtIteration\": 1,\n19:       \"resolved\": true\n20:     },\n21:     {\n22:       \"id\": \"question-2-how-should-message-assembly-handle-streaming-ordering-duplication-concurrency-ca\",\n23:       \"inboxId\": null,\n24:       \"text\": \"How should message assembly handle streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic render commitment?\",\n25:       \"origin\": \"legacy-import\",\n26:       \"source\": \"key-questions\",\n27:       \"injectedAtIteration\": 0,\n28:       \"promotedQuestionId\": null,\n29:       \"addedAtIteration\": 0,\n30:       \"resolvedAtIteration\": null,\n31:       \"resolved\": false\n32:     },\n33:     {\n34:       \"id\": \"question-3-which-protected-span-and-semantic-fidelity-gates-can-reject-every-changed-litera\",\n35:       \"inboxId\": null,\n36:       \"text\": \"Which protected-span and semantic fidelity gates can reject every changed literal, structure, fact, polarity, requirement strength, caveat, or next step and return the exact original?\",\n37:       \"origin\": \"legacy-import\",\n38:       \"source\": \"key-questions\",\n39:       \"injectedAtIteration\": 0,\n40:       \"promotedQuestionId\": null,\n41:       \"addedAtIteration\": 0,\n42:       \"resolvedAtIteration\": null,\n43:       \"resolved\": false\n44:     },\n45:     {\n46:       \"id\": \"question-4-how-should-privacy-aware-routing-normalize-opencode-go-deepseek-v4-flash-ollama-\",\n47:       \"inboxId\": null,\n48:       \"text\": \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n49:       \"origin\": \"legacy-import\",\n50:       \"source\": \"key-questions\",\n51:       \"injectedAtIteration\": 0,\n52:       \"promotedQuestionId\": null,\n53:       \"addedAtIteration\": 0,\n54:       \"resolvedAtIteration\": null,\n55:       \"resolved\": false\n56:     },\n57:     {\n58:       \"id\": \"question-5-which-observability-perceptual-parity-evaluation-and-downstream-phase-boundaries\",\n59:       \"inboxId\": null,\n60:       \"text\": \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\",\n61:       \"origin\": \"legacy-import\",\n62:       \"source\": \"key-questions\",\n63:       \"injectedAtIteration\": 0,\n64:       \"promotedQuestionId\": null,\n65:       \"addedAtIteration\": 0,\n66:       \"resolvedAtIteration\": null,\n67:       \"resolved\": false\n68:     }\n69:   ],\n70:   \"openQuestions\": [\n71:     {\n72:       \"id\": \"question-2-how-should-message-assembly-handle-streaming-ordering-duplication-concurrency-ca\",\n73:       \"inboxId\": null,\n74:       \"text\": \"How should message assembly handle streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic render commitment?\",\n75:       \"origin\": \"legacy-import\",\n76:       \"source\": \"key-questions\",\n77:       \"injectedAtIteration\": 0,\n78:       \"promotedQuestionId\": null,\n79:       \"addedAtIteration\": 0,\n80:       \"resolvedAtIteration\": null\n81:     },\n82:     {\n83:       \"id\": \"question-3-which-protected-span-and-semantic-fidelity-gates-can-reject-every-changed-litera\",\n84:       \"inboxId\": null,\n85:       \"text\": \"Which protected-span and semantic fidelity gates can reject every changed literal, structure, fact, polarity, requirement strength, caveat, or next step and return the exact original?\",\n86:       \"origin\": \"legacy-import\",\n87:       \"source\": \"key-questions\",\n88:       \"injectedAtIteration\": 0,\n89:       \"promotedQuestionId\": null,\n90:       \"addedAtIteration\": 0,\n91:       \"resolvedAtIteration\": null\n92:     },\n93:     {\n94:       \"id\": \"question-4-how-should-privacy-aware-routing-normalize-opencode-go-deepseek-v4-flash-ollama-\",\n95:       \"inboxId\": null,\n96:       \"text\": \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n97:       \"origin\": \"legacy-import\",\n98:       \"source\": \"key-questions\",\n99:       \"injectedAtIteration\": 0,\n100:       \"promotedQuestionId\": null,\n101:       \"addedAtIteration\": 0,\n102:       \"resolvedAtIteration\": null\n103:     },\n104:     {\n105:       \"id\": \"question-5-which-observability-perceptual-parity-evaluation-and-downstream-phase-boundaries\",\n106:       \"inboxId\": null,\n107:       \"text\": \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\",\n108:       \"origin\": \"legacy-import\",\n109:       \"source\": \"key-questions\",\n110:       \"injectedAtIteration\": 0,\n111:       \"promotedQuestionId\": null,\n112:       \"addedAtIteration\": 0,\n113:       \"resolvedAtIteration\": null\n114:     }\n115:   ],\n116:   \"resolvedQuestions\": [\n117:     {\n118:       \"id\": \"question-1-what-is-the-safest-primary-source-supported-display-integration-boundary-in-each\",\n119:       \"inboxId\": null,\n120:       \"text\": \"What is the safest primary-source-supported display integration boundary in each of the six CLIs, and how should their events normalize without mutating canonical context, tools, or transcripts?\",\n121:       \"origin\": \"legacy-import\",\n122:       \"source\": \"key-questions\",\n123:       \"injectedAtIteration\": 0,\n124:       \"promotedQuestionId\": null,\n125:       \"addedAtIteration\": 0,\n126:       \"resolvedAtIteration\": 1\n127:     }\n128:   ],\n129:   \"carriedForwardOpenQuestions\": [\n130:     {\n131:       \"text\": \"How should assembly implement streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic commit against version-pinned event fixtures?\",\n132:       \"addedAtIteration\": 1,\n133:       \"source\": \"iteration-markdown\"\n134:     },\n135:     {\n136:       \"text\": \"Which deterministic protected-span and semantic fidelity gates reject unsafe rewrites and return the exact original?\",\n137:       \"addedAtIteration\": 1,\n138:       \"source\": \"iteration-markdown\"\n139:     },\n140:     {\n141:       \"text\": \"How should privacy-aware provider routing cover OpenCode Go DeepSeek V4 Flash and local providers?\",\n142:       \"addedAtIteration\": 1,\n143:       \"source\": \"iteration-markdown\"\n144:     },\n145:     {\n146:       \"text\": \"Which observability and perceptual-parity evaluation gates make the architecture testable?\",\n147:       \"addedAtIteration\": 1,\n148:       \"source\": \"iteration-markdown\"\n149:     },\n150:     {\n151:       \"text\": \"Which exact Devin ACP and Claude MessageDisplay fields vary by installed version?\",\n152:       \"addedAtIteration\": 1,\n153:       \"source\": \"iteration-markdown\"\n154:     }\n155:   ],\n156:   \"uncoveredQuestions\": [\n157:     \"How should message assembly handle streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic render commitment?\",\n158:     \"Which protected-span and semantic fidelity gates can reject every changed literal, structure, fact, polarity, requirement strength, caveat, or next step and return the exact original?\",\n159:     \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n160:     \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\"\n161:   ],\n162:   \"keyFindings\": [\n163:     {\n164:       \"id\": \"finding-1-8-atomic-commitment-requires-two-independent-orders-and-an-explicit-terminal-state\",\n165:       \"text\": \"**Atomic commitment requires two independent orders and an explicit terminal state.** `sourceSequence` records runtime arrival order; `assemblySequence` records projector assembly order. Deduplicate on stable runtime event identity when available and otherwise on an adapter-scoped event ID plus canonical payload hash. Only `completed` may replace the original; `cancelled`, `interrupted`, `error`, timeout, missing completion, duplicate conflict, or validation failure renders the exact canonical original. This corrects the reference’s replace mode, which suppresses non-final chunks before rewrite validation and buffers under raw session/message-derived paths. [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:102] [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:109] [INFERENCE: based on Codex terminal statuses, Cursor cancellation/stopReason, OpenCode abort, and the reference’s pre-final suppression]\",\n166:       \"addedAtIteration\": 1,\n167:       \"sources\": [\n168:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n169:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n170:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n171:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n172:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n173:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n174:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n175:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n176:       ]\n177:     },\n178:     {\n179:       \"id\": \"finding-1-1-claude-cli-has-the-narrowest-native-display-only-boundary-claude-code-documents-\",\n180:       \"text\": \"**Claude CLI has the narrowest native display-only boundary.** Claude Code documents `MessageDisplay` as firing while assistant text is displayed and explicitly places it outside the agentic lifecycle as display-only. The reference confirms a chunk contract containing `session_id`, `message_id`, `index`, `final`, `delta`, and `transcript_path`; therefore a Claude adapter can assemble projection text without changing canonical context, but it must commit only after the final chunk and retain the original for exact fallback. [SOURCE: https://code.claude.com/docs/en/hooks] [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89]\",\n181:       \"addedAtIteration\": 1,\n182:       \"sources\": [\n183:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n184:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n185:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n186:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n187:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n188:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n189:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n190:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n191:       ]\n192:     },\n193:     {\n194:       \"id\": \"finding-1-2-codex-s-safest-arbitrary-rendering-boundary-is-an-app-server-client-not-a-lifecy\",\n195:       \"text\": \"**Codex’s safest arbitrary-rendering boundary is an App Server client, not a lifecycle hook.** App Server is the documented rich-client interface and exposes version-generated schemas, thread/turn/item identity, `item/started`, `item/completed`, `item/agentMessage/delta`, a terminal `turn/completed`, and `turn/interrupt`. A projector can therefore maintain a read-only mirror keyed by thread, turn, and item while cancellation remains a runtime command rather than a synthetic display event. [SOURCE: https://learn.chatgpt.com/docs/app-server]\",\n196:       \"addedAtIteration\": 1,\n197:       \"sources\": [\n198:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n199:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n200:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n201:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n202:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n203:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n204:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n205:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n206:       ]\n207:     },\n208:     {\n209:       \"id\": \"finding-1-6-cursor-confirms-the-complete-acp-client-loop-needed-for-projection-cursor-docume\",\n210:       \"text\": \"**Cursor confirms the complete ACP client loop needed for projection.** Cursor documents newline-delimited JSON-RPC over stdio, `session/new` or `session/load`, streamed `session/update`, blocking `session/request_permission`, optional `session/cancel`, and a terminal prompt result with `stopReason`. Its extensions also expose task identity and cancellation-like todo states, so the adapter must preserve both ACP core and Cursor extension events rather than flattening everything into text. [SOURCE: https://cursor.com/docs/cli/acp]\",\n211:       \"addedAtIteration\": 1,\n212:       \"sources\": [\n213:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n214:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n215:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n216:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n217:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n218:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n219:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n220:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n221:       ]\n222:     },\n223:     {\n224:       \"id\": \"finding-1-5-devin-confirms-an-acp-process-boundary-but-not-a-devin-specific-update-schema-on\",\n225:       \"text\": \"**Devin confirms an ACP process boundary but not a Devin-specific update schema on the consulted command page.** `devin acp` is documented as a non-interactive stdio JSON-RPC server for ACP-aware hosts. This supports a separate renderer process, but field-level mapping, completion, ancestry, and cancellation must be capability-tested against the pinned Devin/ACP version rather than copied from Cursor. [SOURCE: https://docs.devin.ai/cli/reference/commands] [INFERENCE: based on Devin documenting only the ACP transport boundary while the attempted shared session-update page was unavailable]\",\n226:       \"addedAtIteration\": 1,\n227:       \"sources\": [\n228:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n229:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n230:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n231:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n232:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n233:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n234:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n235:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n236:       ]\n237:     },\n238:     {\n239:       \"id\": \"finding-1-4-opencode-s-server-sse-boundary-is-the-portable-choice-the-official-server-is-the\",\n240:       \"text\": \"**OpenCode’s server/SSE boundary is the portable choice.** The official server is the same client/server architecture used by the TUI, publishes OpenAPI 3.1, exposes canonical session messages and child sessions, streams bus events over `/event` or `/global/event`, and provides `/session/:id/abort`. A separate server/SDK client can project events without depending on undocumented TUI replacement behavior. [SOURCE: https://opencode.ai/docs/server/]\",\n241:       \"addedAtIteration\": 1,\n242:       \"sources\": [\n243:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n244:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n245:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n246:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n247:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n248:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n249:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n250:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n251:       ]\n252:     },\n253:     {\n254:       \"id\": \"finding-1-3-pi-offers-a-native-extension-rendering-boundary-but-extension-event-mutation-mus\",\n255:       \"text\": \"**Pi offers a native extension rendering boundary, but extension event mutation must be kept out of the canonical lane.** Pi documents custom rendering for tool calls, results, and messages, plus `message_start/update/end` and tool execution start/update/end events. It also permits a `message_end` handler to replace the finalized message; that capability is unsafe for a display-only projector because the replacement participates in Pi’s message lifecycle. Use custom rendering/UI for projection and treat message replacement as out of scope. [SOURCE: https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md]\",\n256:       \"addedAtIteration\": 1,\n257:       \"sources\": [\n258:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n259:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n260:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n261:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n262:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n263:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n264:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n265:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n266:       ]\n267:     },\n268:     {\n269:       \"id\": \"finding-1-7-the-common-architecture-is-an-immutable-event-mirror-plus-a-replaceable-projecti\",\n270:       \"text\": \"**The common architecture is an immutable event mirror plus a replaceable projection, not a universal hook.** Normalize every runtime event into `{runtime, runtimeVersion, sessionId, turnId, messageId, itemId, partId, toolCallId, parentId, kind, phase, sequence, sourceTimestamp, canonicalPayloadRef, terminalStatus, eventId}`. Keep text deltas, tool inputs/results, approvals, and extension payloads as typed canonical references; store rewritten prose only under a separate `projection` object with its provider, model, policy, validation result, and fallback reason. Missing native fields remain `null` with a capability-confidence tag; adapters must not invent ancestry or order. [INFERENCE: based on the identity/lifecycle fields documented by Codex App Server, OpenCode SSE/session APIs, Cursor ACP, Pi events, and Claude MessageDisplay]\",\n271:       \"addedAtIteration\": 1,\n272:       \"sources\": [\n273:         \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n274:         \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n275:         \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n276:         \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n277:         \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n278:         \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n279:         \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n280:         \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n281:       ]\n282:     }\n283:   ],\n284:   \"ruledOutDirections\": [\n285:     {\n286:       \"id\": \"ruled-out-ee869556052a\",\n287:       \"text\": \"`https://agentclientprotocol.com/protocol/session-updates` returned 404. No claims depend on that unavailable page; shared ACP semantics beyond the runtime-specific documentation remain unconfirmed.\",\n288:       \"contentHash\": \"ee869556052a\",\n289:       \"addedAtIteration\": 1\n290:     },\n291:     {\n292:       \"id\": \"ruled-out-704e0f91773a\",\n293:       \"text\": \"A narrow grep over the captured Claude web response exceeded the tool record limit. The official page’s directly returned lifecycle table and the local reference supplied the used evidence.\",\n294:       \"contentHash\": \"704e0f91773a\",\n295:       \"addedAtIteration\": 1\n296:     },\n297:     {\n298:       \"id\": \"ruled-out-469f9e98832b\",\n299:       \"text\": \"A single universal lifecycle hook: the six runtimes expose materially different boundaries; only Claude confirms a dedicated presentation-only hook. [SOURCE: https://code.claude.com/docs/en/hooks] [SOURCE: https://opencode.ai/docs/server/]\",\n300:       \"contentHash\": \"469f9e98832b\",\n301:       \"addedAtIteration\": 1\n302:     },\n303:     {\n304:       \"id\": \"ruled-out-ecd65819a40c\",\n305:       \"text\": \"Pi finalized-message replacement as the projector: the documented handler can replace the lifecycle message, violating the immutable-canonical-lane requirement. [SOURCE: https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md]\",\n306:       \"contentHash\": \"ecd65819a40c\",\n307:       \"addedAtIteration\": 1\n308:     },\n309:     {\n310:       \"id\": \"ruled-out-f96bba6e43ef\",\n311:       \"text\": \"Reusing Cursor’s ACP field mapping unchanged for Devin: both expose ACP, but the consulted Devin source confirms transport rather than identical update payloads. [SOURCE: https://docs.devin.ai/cli/reference/commands] [SOURCE: https://cursor.com/docs/cli/acp]\",\n312:       \"contentHash\": \"f96bba6e43ef\",\n313:       \"addedAtIteration\": 1\n314:     },\n315:     {\n316:       \"id\": \"ruled-out-5be8ba11465e\",\n317:       \"text\": \"The GitHub HTML view of Pi’s extension documentation failed to render content; the raw repository URL supplied the primary document instead.\",\n318:       \"contentHash\": \"5be8ba11465e\",\n319:       \"addedAtIteration\": 1\n320:     }\n321:   ],\n322:   \"rejectedPatterns\": [],\n323:   \"rejectedPatternIndex\": {\n324:     \"maxEntries\": 100,\n325:     \"fuzzyThreshold\": 0.85,\n326:     \"entries\": []\n327:   },\n328:   \"rejectedPatternWarnings\": [],\n329:   \"suppressedCandidates\": [],\n330:   \"minIdeaObservations\": 2,\n331:   \"observedIdeas\": [],\n332:   \"promotedIdeas\": [],\n333:   \"suppressedIdeas\": [],\n334:   \"blockedStopHistory\": [],\n335:   \"graphConvergenceScore\": 0,\n336:   \"graphDecision\": null,\n337:   \"graphBlockers\": [],\n338:   \"divergence\": {\n339:     \"started\": [],\n340:     \"completed\": [],\n341:     \"failed\": [],\n342:     \"overrides\": [],\n343:     \"saturatedDirections\": [],\n344:     \"remainingFrontier\": [],\n345:     \"currentFocus\": \"\",\n346:     \"activePivotId\": null,\n347:     \"activeSourceIteration\": null\n348:   },\n349:   \"metrics\": {\n350:     \"iterationsCompleted\": 1,\n351:     \"openQuestions\": 4,\n352:     \"resolvedQuestions\": 1,\n353:     \"carriedForwardOpenQuestions\": 5,\n354:     \"keyFindings\": 8,\n355:     \"rejectedPatterns\": 0,\n356:     \"suppressedCandidates\": 0,\n357:     \"observedIdeas\": 0,\n358:     \"promotedIdeas\": 0,\n359:     \"suppressedIdeas\": 0,\n360:     \"convergenceScore\": 0.69,\n361:     \"coverageBySources\": {\n362:       \"agentclientprotocol.com\": 1,\n363:       \"code\": 10,\n364:       \"code.claude.com\": 1,\n365:       \"cursor.com\": 1,\n366:       \"docs.devin.ai\": 1,\n367:       \"github.com\": 1,\n368:       \"learn.chatgpt.com\": 1,\n369:       \"opencode.ai\": 1,\n370:       \"raw.githubusercontent.com\": 1\n371:     },\n372:     \"completedPivots\": 0,\n373:     \"failedPivots\": 0,\n374:     \"pivotOverrides\": 0\n375:   },\n376:   \"corruptionWarnings\": [],\n377:   \"inboxPath\": \"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0138-system-deep-loop-communication-research/specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/gpt-sol-fast/inbox.jsonl\",\n378:   \"inboxWarnings\": [],\n379:   \"status\": \"INITIALIZED\",\n380:   \"advisoryEvents\": []\n381: }\n\n(End of file - total 381 lines)\n</content>","metadata":{"preview":"{\n  \"sessionId\": \"fanout-gpt-sol-fast-1786433150940-mdbr01\",\n  \"parentSessionId\": null,\n  \"lineageMode\": \"new\",\n  \"generation\": 1,\n  \"continuedFromRun\": null,\n  \"terminalStop\": null,\n  \"keyQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-safest-primary-source-supported-display-integration-boundary-in-each\",\n      \"inboxId\": null,\n      \"text\": \"What is the safest primary-source-supported display integration boundary in each of the six CLIs, and how should their events normalize without mutating canonical context, tools, or transcripts?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 1,\n      \"resolved\": true\n    },","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0138-system-deep-loop-communication-research/specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/gpt-sol-fast/findings-registry.json","text":"{\n  \"sessionId\": \"fanout-gpt-sol-fast-1786433150940-mdbr01\",\n  \"parentSessionId\": null,\n  \"lineageMode\": \"new\",\n  \"generation\": 1,\n  \"continuedFromRun\": null,\n  \"terminalStop\": null,\n  \"keyQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-safest-primary-source-supported-display-integration-boundary-in-each\",\n      \"inboxId\": null,\n      \"text\": \"What is the safest primary-source-supported display integration boundary in each of the six CLIs, and how should their events normalize without mutating canonical context, tools, or transcripts?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 1,\n      \"resolved\": true\n    },\n    {\n      \"id\": \"question-2-how-should-message-assembly-handle-streaming-ordering-duplication-concurrency-ca\",\n      \"inboxId\": null,\n      \"text\": \"How should message assembly handle streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic render commitment?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null,\n      \"resolved\": false\n    },\n    {\n      \"id\": \"question-3-which-protected-span-and-semantic-fidelity-gates-can-reject-every-changed-litera\",\n      \"inboxId\": null,\n      \"text\": \"Which protected-span and semantic fidelity gates can reject every changed literal, structure, fact, polarity, requirement strength, caveat, or next step and return the exact original?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null,\n      \"resolved\": false\n    },\n    {\n      \"id\": \"question-4-how-should-privacy-aware-routing-normalize-opencode-go-deepseek-v4-flash-ollama-\",\n      \"inboxId\": null,\n      \"text\": \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null,\n      \"resolved\": false\n    },\n    {\n      \"id\": \"question-5-which-observability-perceptual-parity-evaluation-and-downstream-phase-boundaries\",\n      \"inboxId\": null,\n      \"text\": \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null,\n      \"resolved\": false\n    }\n  ],\n  \"openQuestions\": [\n    {\n      \"id\": \"question-2-how-should-message-assembly-handle-streaming-ordering-duplication-concurrency-ca\",\n      \"inboxId\": null,\n      \"text\": \"How should message assembly handle streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic render commitment?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null\n    },\n    {\n      \"id\": \"question-3-which-protected-span-and-semantic-fidelity-gates-can-reject-every-changed-litera\",\n      \"inboxId\": null,\n      \"text\": \"Which protected-span and semantic fidelity gates can reject every changed literal, structure, fact, polarity, requirement strength, caveat, or next step and return the exact original?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null\n    },\n    {\n      \"id\": \"question-4-how-should-privacy-aware-routing-normalize-opencode-go-deepseek-v4-flash-ollama-\",\n      \"inboxId\": null,\n      \"text\": \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null\n    },\n    {\n      \"id\": \"question-5-which-observability-perceptual-parity-evaluation-and-downstream-phase-boundaries\",\n      \"inboxId\": null,\n      \"text\": \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": null\n    }\n  ],\n  \"resolvedQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-safest-primary-source-supported-display-integration-boundary-in-each\",\n      \"inboxId\": null,\n      \"text\": \"What is the safest primary-source-supported display integration boundary in each of the six CLIs, and how should their events normalize without mutating canonical context, tools, or transcripts?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 1\n    }\n  ],\n  \"carriedForwardOpenQuestions\": [\n    {\n      \"text\": \"How should assembly implement streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic commit against version-pinned event fixtures?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Which deterministic protected-span and semantic fidelity gates reject unsafe rewrites and return the exact original?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"How should privacy-aware provider routing cover OpenCode Go DeepSeek V4 Flash and local providers?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Which observability and perceptual-parity evaluation gates make the architecture testable?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Which exact Devin ACP and Claude MessageDisplay fields vary by installed version?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    }\n  ],\n  \"uncoveredQuestions\": [\n    \"How should message assembly handle streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic render commitment?\",\n    \"Which protected-span and semantic fidelity gates can reject every changed literal, structure, fact, polarity, requirement strength, caveat, or next step and return the exact original?\",\n    \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n    \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\"\n  ],\n  \"keyFindings\": [\n    {\n      \"id\": \"finding-1-8-atomic-commitment-requires-two-independent-orders-and-an-explicit-terminal-state\",\n      \"text\": \"**Atomic commitment requires two independent orders and an explicit terminal state.** `sourceSequence` records runtime arrival order; `assemblySequence` records projector assembly order. Deduplicate on stable runtime event identity when available and otherwise on an adapter-scoped event ID plus canonical payload hash. Only `completed` may replace the original; `cancelled`, `interrupted`, `error`, timeout, missing completion, duplicate conflict, or validation failure renders the exact canonical original. This corrects the reference’s replace mode, which suppresses non-final chunks before rewrite validation and buffers under raw session/message-derived paths. [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:102] [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:109] [INFERENCE: based on Codex terminal statuses, Cursor cancellation/stopReason, OpenCode abort, and the reference’s pre-final suppression]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-1-claude-cli-has-the-narrowest-native-display-only-boundary-claude-code-documents-\",\n      \"text\": \"**Claude CLI has the narrowest native display-only boundary.** Claude Code documents `MessageDisplay` as firing while assistant text is displayed and explicitly places it outside the agentic lifecycle as display-only. The reference confirms a chunk contract containing `session_id`, `message_id`, `index`, `final`, `delta`, and `transcript_path`; therefore a Claude adapter can assemble projection text without changing canonical context, but it must commit only after the final chunk and retain the original for exact fallback. [SOURCE: https://code.claude.com/docs/en/hooks] [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-2-codex-s-safest-arbitrary-rendering-boundary-is-an-app-server-client-not-a-lifecy\",\n      \"text\": \"**Codex’s safest arbitrary-rendering boundary is an App Server client, not a lifecycle hook.** App Server is the documented rich-client interface and exposes version-generated schemas, thread/turn/item identity, `item/started`, `item/completed`, `item/agentMessage/delta`, a terminal `turn/completed`, and `turn/interrupt`. A projector can therefore maintain a read-only mirror keyed by thread, turn, and item while cancellation remains a runtime command rather than a synthetic display event. [SOURCE: https://learn.chatgpt.com/docs/app-server]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-6-cursor-confirms-the-complete-acp-client-loop-needed-for-projection-cursor-docume\",\n      \"text\": \"**Cursor confirms the complete ACP client loop needed for projection.** Cursor documents newline-delimited JSON-RPC over stdio, `session/new` or `session/load`, streamed `session/update`, blocking `session/request_permission`, optional `session/cancel`, and a terminal prompt result with `stopReason`. Its extensions also expose task identity and cancellation-like todo states, so the adapter must preserve both ACP core and Cursor extension events rather than flattening everything into text. [SOURCE: https://cursor.com/docs/cli/acp]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-5-devin-confirms-an-acp-process-boundary-but-not-a-devin-specific-update-schema-on\",\n      \"text\": \"**Devin confirms an ACP process boundary but not a Devin-specific update schema on the consulted command page.** `devin acp` is documented as a non-interactive stdio JSON-RPC server for ACP-aware hosts. This supports a separate renderer process, but field-level mapping, completion, ancestry, and cancellation must be capability-tested against the pinned Devin/ACP version rather than copied from Cursor. [SOURCE: https://docs.devin.ai/cli/reference/commands] [INFERENCE: based on Devin documenting only the ACP transport boundary while the attempted shared session-update page was unavailable]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-4-opencode-s-server-sse-boundary-is-the-portable-choice-the-official-server-is-the\",\n      \"text\": \"**OpenCode’s server/SSE boundary is the portable choice.** The official server is the same client/server architecture used by the TUI, publishes OpenAPI 3.1, exposes canonical session messages and child sessions, streams bus events over `/event` or `/global/event`, and provides `/session/:id/abort`. A separate server/SDK client can project events without depending on undocumented TUI replacement behavior. [SOURCE: https://opencode.ai/docs/server/]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-3-pi-offers-a-native-extension-rendering-boundary-but-extension-event-mutation-mus\",\n      \"text\": \"**Pi offers a native extension rendering boundary, but extension event mutation must be kept out of the canonical lane.** Pi documents custom rendering for tool calls, results, and messages, plus `message_start/update/end` and tool execution start/update/end events. It also permits a `message_end` handler to replace the finalized message; that capability is unsafe for a display-only projector because the replacement participates in Pi’s message lifecycle. Use custom rendering/UI for projection and treat message replacement as out of scope. [SOURCE: https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-7-the-common-architecture-is-an-immutable-event-mirror-plus-a-replaceable-projecti\",\n      \"text\": \"**The common architecture is an immutable event mirror plus a replaceable projection, not a universal hook.** Normalize every runtime event into `{runtime, runtimeVersion, sessionId, turnId, messageId, itemId, partId, toolCallId, parentId, kind, phase, sequence, sourceTimestamp, canonicalPayloadRef, terminalStatus, eventId}`. Keep text deltas, tool inputs/results, approvals, and extension payloads as typed canonical references; store rewritten prose only under a separate `projection` object with its provider, model, policy, validation result, and fallback reason. Missing native fields remain `null` with a capability-confidence tag; adapters must not invent ancestry or order. [INFERENCE: based on the identity/lifecycle fields documented by Codex App Server, OpenCode SSE/session APIs, Cursor ACP, Pi events, and Claude MessageDisplay]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"[Claude Code hooks reference](https://code.claude.com/docs/en/hooks), accessed 2026-08-11.\",\n        \"[Codex App Server](https://learn.chatgpt.com/docs/app-server), accessed 2026-08-11.\",\n        \"[Pi extensions raw documentation](https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md), accessed 2026-08-11.\",\n        \"[OpenCode server documentation](https://opencode.ai/docs/server/), last-updated marker 2026-08-09 and accessed 2026-08-11.\",\n        \"[Devin CLI commands](https://docs.devin.ai/cli/reference/commands), accessed 2026-08-11.\",\n        \"[Cursor CLI ACP](https://cursor.com/docs/cli/acp), accessed 2026-08-11.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/001-research-strategy/plan.md:264`.\",\n        \"`specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:89`.\"\n      ]\n    }\n  ],\n  \"ruledOutDirections\": [\n    {\n      \"id\": \"ruled-out-ee869556052a\",\n      \"text\": \"`https://agentclientprotocol.com/protocol/session-updates` returned 404. No claims depend on that unavailable page; shared ACP semantics beyond the runtime-specific documentation remain unconfirmed.\",\n      \"contentHash\": \"ee869556052a\",\n      \"addedAtIteration\": 1\n    },\n    {\n      \"id\": \"ruled-out-704e0f91773a\",\n      \"text\": \"A narrow grep over the captured Claude web response exceeded the tool record limit. The official page’s directly returned lifecycle table and the local reference supplied the used evidence.\",\n      \"contentHash\": \"704e0f91773a\",\n      \"addedAtIteration\": 1\n    },\n    {\n      \"id\": \"ruled-out-469f9e98832b\",\n      \"text\": \"A single universal lifecycle hook: the six runtimes expose materially different boundaries; only Claude confirms a dedicated presentation-only hook. [SOURCE: https://code.claude.com/docs/en/hooks] [SOURCE: https://opencode.ai/docs/server/]\",\n      \"contentHash\": \"469f9e98832b\",\n      \"addedAtIteration\": 1\n    },\n    {\n      \"id\": \"ruled-out-ecd65819a40c\",\n      \"text\": \"Pi finalized-message replacement as the projector: the documented handler can replace the lifecycle message, violating the immutable-canonical-lane requirement. [SOURCE: https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/docs/extensions.md]\",\n      \"contentHash\": \"ecd65819a40c\",\n      \"addedAtIteration\": 1\n    },\n    {\n      \"id\": \"ruled-out-f96bba6e43ef\",\n      \"text\": \"Reusing Cursor’s ACP field mapping unchanged for Devin: both expose ACP, but the consulted Devin source confirms transport rather than identical update payloads. [SOURCE: https://docs.devin.ai/cli/reference/commands] [SOURCE: https://cursor.com/docs/cli/acp]\",\n      \"contentHash\": \"f96bba6e43ef\",\n      \"addedAtIteration\": 1\n    },\n    {\n      \"id\": \"ruled-out-5be8ba11465e\",\n      \"text\": \"The GitHub HTML view of Pi’s extension documentation failed to render content; the raw repository URL supplied the primary document instead.\",\n      \"contentHash\": \"5be8ba11465e\",\n      \"addedAtIteration\": 1\n    }\n  ],\n  \"rejectedPatterns\": [],\n  \"rejectedPatternIndex\": {\n    \"maxEntries\": 100,\n    \"fuzzyThreshold\": 0.85,\n    \"entries\": []\n  },\n  \"rejectedPatternWarnings\": [],\n  \"suppressedCandidates\": [],\n  \"minIdeaObservations\": 2,\n  \"observedIdeas\": [],\n  \"promotedIdeas\": [],\n  \"suppressedIdeas\": [],\n  \"blockedStopHistory\": [],\n  \"graphConvergenceScore\": 0,\n  \"graphDecision\": null,\n  \"graphBlockers\": [],\n  \"divergence\": {\n    \"started\": [],\n    \"completed\": [],\n    \"failed\": [],\n    \"overrides\": [],\n    \"saturatedDirections\": [],\n    \"remainingFrontier\": [],\n    \"currentFocus\": \"\",\n    \"activePivotId\": null,\n    \"activeSourceIteration\": null\n  },\n  \"metrics\": {\n    \"iterationsCompleted\": 1,\n    \"openQuestions\": 4,\n    \"resolvedQuestions\": 1,\n    \"carriedForwardOpenQuestions\": 5,\n    \"keyFindings\": 8,\n    \"rejectedPatterns\": 0,\n    \"suppressedCandidates\": 0,\n    \"observedIdeas\": 0,\n    \"promotedIdeas\": 0,\n    \"suppressedIdeas\": 0,\n    \"convergenceScore\": 0.69,\n    \"coverageBySources\": {\n      \"agentclientprotocol.com\": 1,\n      \"code\": 10,\n      \"code.claude.com\": 1,\n      \"cursor.com\": 1,\n      \"docs.devin.ai\": 1,\n      \"github.com\": 1,\n      \"learn.chatgpt.com\": 1,\n      \"opencode.ai\": 1,\n      \"raw.githubusercontent.com\": 1\n    },\n    \"completedPivots\": 0,\n    \"failedPivots\": 0,\n    \"pivotOverrides\": 0\n  },\n  \"corruptionWarnings\": [],\n  \"inboxPath\": \"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0138-system-deep-loop-communication-research/specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/gpt-sol-fast/inbox.jsonl\",\n  \"inboxWarnings\": [],\n  \"status\": \"INITIALIZED\",\n  \"advisoryEvents\": []\n}","lineStart":1,"lineEnd":381,"totalLines":381,"truncated":false}},"title":"specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/gpt-sol-fast/findings-registry.json","time":{"start":1786433672641,"end":1786433672657}},"metadata":{"openai":{"itemId":"fc_01f4d7aa3449db22016a7ad08869708191b9b3f5a8879a5b07"}},"id":"prt_fefbe95be001s91DrmgWSpQKBw","sessionID":"ses_010495952ffeknG4pENad6KM6w","messageID":"msg_fefbe72c70011ZohaR8qLaQ3wh"}}
