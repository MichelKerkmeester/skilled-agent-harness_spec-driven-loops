ly released.\n716:  */\n717: export function releaseLoopLock(lockPath: string, ownerPid: number, acquireNonce?: string): boolean {\n718:   const claimPath = makeClaimPath(lockPath, 'releasing');\n719:   try {\n720:     renameSync(lockPath, claimPath);\n721:   } catch (error: unknown) {\n722:     if (errorCode(error) === 'ENOENT') return false;\n723:     throw error;\n724:   }\n725: \n726:   try {\n727:     const holder = readLoopLock(claimPath);\n728:     if (!holder || !lockIdentityMatches(holder, ownerPid, acquireNonce)) {\n729:       restoreClaimedLoopLock(lockPath, claimPath);\n730:       return false;\n731:     }\n732:     unlinkSync(claimPath);\n733:     try {\n734:       fsyncPath(dirname(lockPath));\n735:     } catch {\n736:     }\n737:     dropHostLocalSingleFlightLease(lockPath, ownerPid);\n738:     return true;\n739:   } finally {\n740:     rmSync(claimPath, { force: true });\n741:   }\n742: }\n\n(End of file - total 742 lines)\n</content>","metadata":{"preview":"\n  stopHeartbeat();\n  heartbeatTimer = setInterval(() => {\n    try {\n      const refreshed = refreshLoopLock(ownerToken.lockPath, ownerToken.ownerPid, new Date(), {\n        acquireNonce: ownerToken.acquireNonce,\n        phase: ownerToken.phase ?? DEFAULT_LOOP_LOCK_PHASE,\n      });\n      if (!refreshed) {\n        stopHeartbeat();\n      }\n    } catch (error: unknown) {\n      console.error(`Failed to refresh deep-loop lock heartbeat for ${ownerToken.lockPath}`, error);\n    }\n  }, intervalMs);\n  heartbeatTimer.unref?.();\n}\n\n/** Stop the active lock heartbeat, if one is running. */\nexport function stopHeartbeat(): void {","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0138-system-deep-loop-communication-research/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/loop-lock.ts","text":"\n  stopHeartbeat();\n  heartbeatTimer = setInterval(() => {\n    try {\n      const refreshed = refreshLoopLock(ownerToken.lockPath, ownerToken.ownerPid, new Date(), {\n        acquireNonce: ownerToken.acquireNonce,\n        phase: ownerToken.phase ?? DEFAULT_LOOP_LOCK_PHASE,\n      });\n      if (!refreshed) {\n        stopHeartbeat();\n      }\n    } catch (error: unknown) {\n      console.error(`Failed to refresh deep-loop lock heartbeat for ${ownerToken.lockPath}`, error);\n    }\n  }, intervalMs);\n  heartbeatTimer.unref?.();\n}\n\n/** Stop the active lock heartbeat, if one is running. */\nexport function stopHeartbeat(): void {\n  if (heartbeatTimer === null) {\n    return;\n  }\n\n  clearInterval(heartbeatTimer);\n  heartbeatTimer = null;\n}\n\n/**\n * Release the loop lock for the owning process.\n *\n * @param lockPath - File path for the lock file.\n * @param ownerPid - PID of the owning process (must match current owner).\n * @param acquireNonce - Nonce from the acquiring lock. Required when the\n *   on-disk lock carries a nonce, ignored for legacy nonce-less locks.\n * @returns True if the lock was successfully released.\n */\nexport function releaseLoopLock(lockPath: string, ownerPid: number, acquireNonce?: string): boolean {\n  const claimPath = makeClaimPath(lockPath, 'releasing');\n  try {\n    renameSync(lockPath, claimPath);\n  } catch (error: unknown) {\n    if (errorCode(error) === 'ENOENT') return false;\n    throw error;\n  }\n\n  try {\n    const holder = readLoopLock(claimPath);\n    if (!holder || !lockIdentityMatches(holder, ownerPid, acquireNonce)) {\n      restoreClaimedLoopLock(lockPath, claimPath);\n      return false;\n    }\n    unlinkSync(claimPath);\n    try {\n      fsyncPath(dirname(lockPath));\n    } catch {\n    }\n    dropHostLocalSingleFlightLease(lockPath, ownerPid);\n    return true;\n  } finally {\n    rmSync(claimPath, { force: true });\n  }\n}","lineStart":680,"lineEnd":742,"totalLines":742,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/loop-lock.ts","time":{"start":1786434720170,"end":1786434720175}},"metadata":{"openai":{"itemId":"fc_007e55efbc4197ff016a7ad49ec9288191be0763d7efb00de4"}},"id":"prt_fefce8c57001yaWK5uW2BvYFex","sessionID":"ses_010495952ffeknG4pENad6KM6w","messageID":"msg_fefce7767001QKybQMN3bQWcVW"}}
