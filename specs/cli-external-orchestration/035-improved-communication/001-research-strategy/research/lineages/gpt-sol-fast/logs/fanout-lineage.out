romotedQuestionId\": null,\n102:       \"addedAtIteration\": 0,\n103:       \"resolvedAtIteration\": 3\n104:     },\n105:     {\n106:       \"id\": \"question-4-how-should-privacy-aware-routing-normalize-opencode-go-deepseek-v4-flash-ollama-\",\n107:       \"inboxId\": null,\n108:       \"text\": \"How should privacy-aware routing normalize OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted or local providers without unapproved egress or capability assumptions?\",\n109:       \"origin\": \"legacy-import\",\n110:       \"source\": \"key-questions\",\n111:       \"injectedAtIteration\": 0,\n112:       \"promotedQuestionId\": null,\n113:       \"addedAtIteration\": 0,\n114:       \"resolvedAtIteration\": 3\n115:     },\n116:     {\n117:       \"id\": \"question-5-which-observability-perceptual-parity-evaluation-and-downstream-phase-boundaries\",\n118:       \"inboxId\": null,\n119:       \"text\": \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\",\n120:       \"origin\": \"legacy-import\",\n121:       \"source\": \"key-questions\",\n122:       \"injectedAtIteration\": 0,\n123:       \"promotedQuestionId\": null,\n124:       \"addedAtIteration\": 0,\n125:       \"resolvedAtIteration\": 3\n126:     }\n127:   ],\n128:   \"carriedForwardOpenQuestions\": [\n129:     {\n130:       \"text\": \"How should assembly implement streaming, ordering, duplication, concurrency, cancellation, timeout, retry, and atomic commit against version-pinned event fixtures?\",\n131:       \"addedAtIteration\": 1,\n132:       \"source\": \"iteration-markdown\"\n133:     },\n134:     {\n135:       \"text\": \"Which deterministic protected-span and semantic fidelity gates reject unsafe rewrites and return the exact original?\",\n136:       \"addedAtIteration\": 1,\n137:       \"source\": \"iteration-markdown\"\n138:     },\n139:     {\n140:       \"text\": \"How should privacy-aware provider routing cover OpenCode Go DeepSeek V4 Flash and local providers?\",\n141:       \"addedAtIteration\": 1,\n142:       \"source\": \"iteration-markdown\"\n143:     },\n144:     {\n145:       \"text\": \"Which observability and perceptual-parity evaluation gates make the architecture testable?\",\n146:       \"addedAtIteration\": 1,\n147:       \"source\": \"iteration-markdown\"\n148:     },\n149:     {\n150:       \"text\": \"Which exact Devin ACP and Claude MessageDisplay fields vary by installed version?\",\n151:       \"addedAtIteration\": 1,\n152:       \"source\": \"iteration-markdown\"\n153:     },\n154:     {\n155:       \"text\": \"Which observability, perceptual-parity evaluation, and downstream phase boundaries make the architecture testable and implementable?\",\n156:       \"addedAtIteration\": 2,\n157:       \"source\": \"iteration-markdown\"\n158:     },\n159:     {\n160:       \"text\": \"How should privacy-aware provider routing cover OpenCode Go DeepSeek V4 Flash, Ollama, llama.cpp, and other hosted/local providers without unapproved egress or capability assumptions?\",\n161:       \"addedAtIteration\": 2,\n162:       \"source\": \"iteration-markdown\"\n163:     },\n164:     {\n165:       \"text\": \"Which exact event fields and Markdown dialect capabilities appear in version-pinned fixtures for Claude, Devin, and the other four adapters?\",\n166:       \"addedAtIteration\": 2,\n167:       \"source\": \"iteration-markdown\"\n168:     },\n169:     {\n170:       \"text\": \"Which exact version-pinned runtime event fields, Markdown dialect/parser behaviors, provider request/stream/error shapes, Ollama native timing/keep-alive fields, and llama.cpp build/model capability outcomes appear in executable fixtures?\",\n171:       \"addedAtIteration\": 3,\n172:       \"source\": \"iteration-markdown\"\n173:     }\n174:   ],\n175:   \"uncoveredQuestions\": [],\n176:   \"keyFindings\": [\n177:     {\n178:       \"id\": \"finding-1-8-atomic-commitment-requires-two-independent-orders-and-an-explicit-terminal-state\",\n179:       \"text\": \"**Atomic commitment requires two independent orders and an explicit terminal state.** `sourceSequence` records runtime arrival order; `assemblySequence` records projector assembly order. Deduplicate on stable runtime event identity when available and otherwise on an adapter-scoped event ID plus canonical payload hash. Only `completed` may replace the original; `cancelled`, `interrupted`, `error`, timeout, missing completion, duplicate conflict, or validation failure renders the exact canonical original. This corrects the reference’s replace mode, which suppresses non-final chunks before rewrite validation and buffers under raw session/message-derived paths. [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:102] [SOURCE: specs/cli-external-orchestration/042-improved-communication/context/claudish-to-english-main/rewrite.sh:109] [INFERENCE: based on Codex terminal statuses, Cursor cancellation/stopReason, OpenCode abort, and the reference’s pre-final suppression]\",\n180:       \"addedAtIteration\": 1,\n\n(Showing lines 1-180 of 670. Use offset=181 to continue.)\n</content>","metadata":{"preview":"{\n  \"sessionId\": \"fanout-gpt-sol-fast-1786433150940-mdbr01\",\n  \"parentSessionId\": null,\n  \"lineageMode\": \"new\",\n  \"generation\": 1,\n  \"continuedFromRun\": null,\n  \"terminalStop\": null,\n  \"keyQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-safest-primary-source-supported-display-integration-boundary-in-each\",\n      \"inboxId\": null,\n      \"text\": \"What is the safest primary-source-supported display integration boundary in each of the six CLIs, and how should their events normalize without mutating canonical context, tools, or transcripts?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"adde