complete, synthesis_complete event","status":"pending","priority":"high"}],"truncated":false},"title":"2 todos","time":{"start":1786434688996,"end":1786434689000}},"id":"prt_fefce12ce001I7ghAE1gLWWIGP","sessionID":"ses_010495b2effeRJw5ynhosNr3HY","messageID":"msg_fefcddec3001QrcmCt0WC8I7R8"}}
