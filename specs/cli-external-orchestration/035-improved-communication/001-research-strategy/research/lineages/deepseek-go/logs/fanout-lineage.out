ption uses append/sidecar/custom client',iteration:7},\n{id:'f-iter007-009',label:'Downstream phase map A-E: adapters+envelope, assembler+concurrency, codec+validator, providers+privacy, render+eval',iteration:7},\n{id:'f-iter007-010',label:'Handoffs A>B, B>C, A>D, C>E, D>E; gates per child; rollback confined to research artifacts',iteration:7},\n{id:'f-iter007-011',label:'Architecture freeze: plan component set compatible with all findings; no redesign required',iteration:7}\n]);\nr.ruledOutDirections=r.ruledOutDirections.concat([\n{approach:'Retry semantic validation failures',reason:'Validation rejection selects original immediately',evidence:'spec.md:187',iteration:7},\n{approach:'Share mutable assembler state across concurrent identities',reason:'Isolation required per hashed identity',evidence:'spec.md:222',iteration:7}\n]);\nr.metrics.iterationsCompleted=7;\nr.metrics.openQuestions=0;\nr.metrics.resolvedQuestions=8;\nr.metrics.keyFindings=r.keyFindings.length;\nr.lastUpdated='2026-08-11T09:49:00Z';\nfs.writeFileSync('findings-registry.json',JSON.stringify(r,null,2));\nconsole.log('registry updated: '+r.keyFindings.length+' findings, open:',r.metrics.openQuestions);\n\""},"output":"registry updated: 74 findings, open: 0\n","metadata":{"output":"registry updated: 74 findings, open: 0\n","exit":0,"truncated":false},"title":"cd specs/cli-external-orchestration/042-improved-communication/001-research-strategy/research/lineages/deepseek-go && node -e \"\nconst fs=require('fs');\nconst r=JSON.parse(fs.readFileSync('findings-registry.json','utf8'));\n['q4','q7','q8'].forEach(id=>{r.openQuestions=r.openQuestions.filter(q=>q.id!==id);});\nr.resolvedQuestions.push({id:'q4',text:'Streaming/buffering/ordering/concurrency/cancellation/retry semantics?',answeredAtIteration:7});\nr.resolvedQuestions.push({id:'q7',text:'Observability and evaluation methods for perceptual 1:1 parity?',answeredAtIteration:7});\nr.resolvedQuestions.push({id:'q8',text:'Downstream phase decomposit