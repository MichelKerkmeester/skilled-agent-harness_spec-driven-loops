dentity.cjs\nartifact-root.cjs\natomic-state.ts\nbayesian-scorer.ts\ncontinuity-identity\ncontinuity-thread.cjs\ndivergent-pivot.ts\nevidence-contract.ts\nexecutor-audit.ts\nexecutor-config.ts\nfallback-router.ts\njsonl-repair.ts\nleaf-artifact-writer.ts\nlifecycle-taxonomy.cjs\nlineage-timestamp-window.ts\nloop-lock.ts\nobservability-events.cjs\npermissions-gate.ts\npivot-candidates.ts\npost-dispatch-validate.ts\nprompt-pack.ts\nreceipt-crypto.ts\nruntime-capabilities.cjs\nsleep.ts\nwrite-containment.ts\n","metadata":{"output":"agent-improvement.md\nai-council.md\nalignment.md\nassets\ncommand-benchmark.md\nmodel-benchmark.md\nresearch.md\nreview.md\nskill-benchmark.md\n---assets---\ncompiled\ndeep-agent-improvement-auto.yaml\ndeep-agent-improvement-confirm.yaml\ndeep-agent-improvement-presentation.txt\ndeep-ai-council-auto.yaml\ndeep-ai-council-confirm.yaml\ndeep-ai-council-presentation.txt\ndeep-alignment-auto.yaml\ndeep-alignment-confirm.yaml\ndeep-alignment-presentation.txt\ndeep-command-benchmark-auto.yaml\ndeep-command-benchmark-confirm.yaml\ndeep-command-benchmark-presentation.txt\ndeep-model-benchmark-auto.yaml\ndeep-model-benchmark-confirm.yaml\ndeep-model-benchmark-presentation.txt\ndeep-research-auto.yaml\ndeep-research-confirm.yaml\ndeep-research-presentation.txt\ndeep-review-auto.yaml\ndeep-review-confirm.yaml\ndeep-review-presentation.txt\ndeep-skill-benchmark-auto.yaml\ndeep-skill-benchmark-confirm.yaml\ndeep-skill-benchmark-presentation.txt\nlegacy\n---dashboard template---\ndeep-research-config.json\ndeep-research-dashboard.md\ndeep-research-strategy.md\nprompt-pack-iteration.md.tmpl\nruntime-capabilities.json\n---reduce script---\nREADME.md\ndivergent-research-pivot.ts\nreduce-state-sparkline.test.cjs\nreduce-state.cjs\nruntime-capabilities.cjs\nverify-yaml-script-paths.sh\n---runtime lib---\nREADME.md\nalignment-identity.cjs\nartifact-root.cjs\natomic-state.ts\nbayesian-scorer.ts\ncontinuity-identity\ncontinuity-thread.cjs\ndivergent-pivot.ts\nevidence-contract.ts\nexecutor-audit.ts\nexecutor-config.ts\nfallback-router.ts\njsonl-repair.ts\nleaf-artifact-writer.ts\nlifecycle-taxonomy.cjs\nlineage-timestamp-window.ts\nloop-lock.ts\nobservability-events.cjs\npermissions-gate.ts\npivot-candidates.ts\npost-dispatch-validate.ts\nprompt-pack.ts\nreceipt-crypto.ts\nruntime-capabilities.cjs\nsleep.ts\nwrite-containment.ts\n","exit":0,"truncated":false},"title":"ls .opencode/commands/deep/ 2>/dev/null && echo \"---assets---\" && ls .opencode/commands/deep/assets/ 2>/dev/null && echo \"---dashboard template---\" && ls .opencode/skills/system-deep-loop/deep-research/assets/ 2>/dev/null && echo \"---reduce script---\" && ls .opencode/skills/system-deep-loop/deep-research/scripts/ 2>/dev/null && echo \"---runtime lib---\" && ls .opencode/skills/system-deep-loop/runtime/lib/deep-loop/ 2>/dev/null","time":{"start":1786433262481,"end":1786433262483}},"id":"prt_fefb850e2001tQF78P3Y2EBJZk","sessionID":"ses_010495b2effeRJw5ynhosNr3HY","messageID":"msg_fefb83a1c001C7yZUpiRRjBtfW"}}
