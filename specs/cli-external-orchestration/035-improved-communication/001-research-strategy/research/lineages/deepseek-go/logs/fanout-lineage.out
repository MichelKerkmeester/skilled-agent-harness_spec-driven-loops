ff    8714 Aug 11 09:14 render-command-contract.cjs\n-rwxr-xr-x@  1 michelkerkmeester  staff   10388 Aug 11 09:14 status.cjs\n-rwxr-xr-x@  1 michelkerkmeester  staff   13452 Aug 11 09:14 upsert.cjs\n-rw-r--r--@  1 michelkerkmeester  staff    9303 Aug 11 09:14 verify-iteration.cjs\n---\ntotal 0\ndrwxr-xr-x@ 2 michelkerkmeester  staff   64 Aug 11 09:25 .\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug 11 09:25 ..\n---deltas---\ntotal 8\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug 11 09:25 .\ndrwxr-xr-x@ 4 michelkerkmeester  staff  128 Aug 11 09:25 ..\ndrwxr-xr-x@ 2 michelkerkmeester  staff   64 Aug 11 09:25 .executor-state\n-rw-r--r--@ 1 michelkerkmeester  staff  424 Aug 11 09:25 invocation-metadata.json\n","metadata":{"output":"total 1072\ndrwxr-xr-x@ 21 michelkerkmeester  staff     672 Aug 11 09:14 .\ndrwxr-xr-x@ 14 michelkerkmeester  staff     448 Aug 11 09:14 ..\n-rw-r--r--@  1 michelkerkmeester  staff    3636 Aug 11 09:14 README.md\n-rw-r--r--@  1 michelkerkmeester  staff    3461 Aug 11 09:14 append-state-record.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   20714 Aug 11 09:14 check-contract-drift.cjs\n-rw-r--r--@  1 michelkerkmeester  staff    9202 Aug 11 09:14 codex-dispatch.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   36287 Aug 11 09:14 compile-command-contracts.cjs\n-rwxr-xr-x@  1 michelkerkmeester  staff   42067 Aug 11 09:14 convergence.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   51285 Aug 11 09:14 fanout-merge.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   34202 Aug 11 09:14 fanout-pool.cjs\n-rw-r--r--@  1 michelkerkmeester  staff  105750 Aug 11 09:14 fanout-run.cjs\n-rw-r--r--@  1 michelkerkmeester  staff    5391 Aug 11 09:14 fanout-salvage.cjs\ndrwxr-xr-x@  4 michelkerkmeester  staff     128 Aug 11 09:14 lib\n-rwxr-xr-x@  1 michelkerkmeester  staff   10356 Aug 11 09:14 loop-lock.cjs\n-rwxr-xr-x@  1 michelkerkmeester  staff   12158 Aug 11 09:14 query.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   44301 Aug 11 09:14 reduce-alignment-state.cjs\n-rw