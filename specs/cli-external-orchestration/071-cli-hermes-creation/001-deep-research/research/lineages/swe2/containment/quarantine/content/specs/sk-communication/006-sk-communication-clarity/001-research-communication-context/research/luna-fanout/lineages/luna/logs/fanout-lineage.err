   382	        template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md
   383	        populate:
   384	          topic: "{research_topic}"
   385	          key_questions: "Derive 3-5 key questions from the research topic"
   386	          known_context: "None"
   387	          known_context_summary: "None"
   388	          max_iterations: "{max_iterations}"
   389	          convergence_threshold: "{convergence_threshold}"
   390	        output: "{state_paths.strategy}"
   391	
   392	      step_create_registry:
   393	        action: "Initialize reducer-owned findings registry"
   394	        content: '{"openQuestions":[],"resolvedQuestions":[],"keyFindings":[],"ruledOutDirections":[],"metrics":{"iterationsCompleted":0,"openQuestions":0,"resolvedQuestions":0,"keyFindings":0,"convergenceScore":0,"coverageBySources":{}}}'
   395	        output: "{state_paths.registry}"
   396	
   397	      step_enrich_strategy_context:
   398	        action: "Ensure Known Context is written only after strategy.md exists"
   399	        condition: "prior_context_found"
   400	        edit: "{state_paths.strategy}"
   401	        note: "Append or replace the Known Context section with prior_context_summary and retained detail from prior_context"
   402	
   403	      step_enrich_strategy_resource_map:
   404	        action: "Inject resource-map status into Known Context after strategy.md exists"
   405	        edit: "{state_paths.strategy}"
   406	        note: "When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'."
   407	
   408	      step_detect_spec_present:
   409	        action: "Classify late-INIT spec.md state after the durable research packet exists"
   410	        inspect:
   411	          - "{spec_folder}/spec.md"
   412	          - "{state_paths.lock_file}"
   413	        classify:
   414	          no-spec: "spec.md is absent before any pre-init mutation"
   415	          spec-present: "spec.md exists and approved host anchors are available for bounded mutation"
   416	          spec-just-created-by-this-run: "spec.md already carries this run's DR seed markers and should not be reseeded"
   417	          conflict-detected: "missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe"
   418	        outputs:
   419	          - folder_state: "no-spec | spec-present | spec-just-created-by-this-run | conflict-detected"
   420	          - normalized_topic: "Trim, lowercase, and collapse whitespace in research_topic before dedupe checks"
   421	        append_to_jsonl: '{"type":"event","event":"spec_check_result","folder_state":"{folder_state}","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","lockPath":"{state_paths.lock_file}","timestamp":"{ISO_8601_NOW}"}'
   422	
   423	      step_preinit_spec_branch:
   424	        action: "Run the bounded pre-init spec branch required by spec_check_protocol"
   425	        protocol_reference: ".opencode/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md"
   426	        branches:
   427	          no-spec:
   428	            create: "{spec_folder}/spec.md"
   429	            seed_markers:
   430	              - "<!-- DR-SEED:REQUIREMENTS -->"
   431	              - "<!-- DR-SEED:SCOPE -->"
   432	            requirements_host: "Seed Requirements from the research ask without broadening scope"
   433	            scope_host: "Seed Scope from the research ask without inventing implementation details"
   434	            set:
   435	              folder_state: "spec-just-created-by-this-run"
   436	              validate_spec_doc: true
   437	            append_to_jsonl: '{"type":"spec_mutation","event":"spec_seed_created","folder_state":"spec-just-created-by-this-run","anchors_touched":["Requirements","Scope"],"diff_summary":"Seeded Level 1 spec.md from research topic with DR seed markers.","seed_markers":["DR-SEED:REQUIREMENTS","DR-SEED:SCOPE"],"timestamp":"{ISO_8601_NOW}"}'
   438	          spec-present:
   439	            edit: "{spec_folder}/spec.md"
   440	            set:
   441	              validate_spec_doc: true
   442	            idempotency_check:
   443	              host_anchor: "Open Questions"
   444	              normalized_match: "Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}."
   445	              if_match:
   446	                skip_append: true
   447	                append_to_jsonl: '{"type":"spec_mutation","event":"spec_preinit_context_deduped","folder_state":"spec-present","anchors_touched":["Open Questions"],"diff_summary":"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
   448	              if_no_match:
   449	                append_only:
   450	                  - host_anchor: "Open Questions"
   451	                    content: "Add the normalized research topic only if it is not already present."
   452	                  - host_anchor: "Research Context"
   453	                    content: "Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical."
   454	                append_to_jsonl: '{"type":"spec_mutation","event":"spec_preinit_context_added","folder_state":"spec-present","anchors_touched":["Open Questions","Research Context"],"diff_summary":"Appended bounded pre-init research context for the normalized topic.","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
   455	          spec-just-created-by-this-run:
   456	            verify_markers:
   457	              - "<!-- DR-SEED:REQUIREMENTS -->"
   458	              - "<!-- DR-SEED:SCOPE -->"
   459	            set:
   460	              validate_spec_doc: false
   461	            note: "Treat already-seeded spec.md as a no-op guard and continue."
