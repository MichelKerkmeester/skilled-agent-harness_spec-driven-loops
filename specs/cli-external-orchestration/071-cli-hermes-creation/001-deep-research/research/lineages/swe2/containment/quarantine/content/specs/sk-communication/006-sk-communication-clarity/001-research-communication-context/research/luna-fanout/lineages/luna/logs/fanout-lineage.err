    13	#
    14	# GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):
    15	# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files
    16	#   and JSONL state-log appends. The workflow classifies resume as
    17	#   write-path below (see `gate3_classification` fields) so Gate 3 trigger
    18	#   extraction can surface resume correctly rather than false-negative.
    19	# ─────────────────────────────────────────────────────────────────
    20	role: Deep Research Loop Manager
    21	purpose: Iterative deep research with convergence detection
    22	action: Run deep-research loop from initialization through synthesis
    23	operating_mode:
    24	  workflow: iterative_loop
    25	  workflow_compliance: MANDATORY
    26	  workflow_execution: autonomous
    27	  approvals: none
    28	  tracking: progressive_research_state
    29	  validation: convergence_detection
    30	
    31	# ─────────────────────────────────────────────────────────────────
    32	# OPERATING PRINCIPLES
    33	# ─────────────────────────────────────────────────────────────────
    34	operating_principles:
    35	  core: "Fresh context per iteration + externalized state = no context degradation"
    36	  approach: "Dispatch focused agent, evaluate convergence, repeat or stop"
    37	  mandate: "Never hold findings in memory; write everything to files"
    38	
    39	# ─────────────────────────────────────────────────────────────────
    40	# USER INPUTS (from setup phase)
    41	# ─────────────────────────────────────────────────────────────────
    42	user_inputs:
    43	  research_topic: "[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED."
    44	  spec_folder: "[SPEC_FOLDER] - Spec folder path. REQUIRED."
    45	  max_iterations: "[MAX_ITERATIONS] - Maximum loop iterations. Default: 10."
    46	  convergence_threshold: "[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05."
    47	  convergence_mode: "[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default."
    48	  stop_policy: "[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence."
    49	
    50	# ─────────────────────────────────────────────────────────────────
    51	# CONTEXT LOADING
    52	# ─────────────────────────────────────────────────────────────────
    53	context_loading:
    54	  trigger: "At workflow START, before phase_init"
    55	  purpose: "Load prior research context for the topic and buffer it until strategy.md exists"
    56	  retrieval:
    57	    mechanism: "continuity-ladder-then-ripgrep"
    58	    note: "File reads only. Nothing here needs a running daemon, and every step is reproducible by hand."
    59	    ladder:
    60	      - "{spec_folder}/handover.md when present"
    61	      - "the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md"
    62	      - "the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open"
    63	    free_text_recipe: "rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .opencode"
    64	    recipe_contract: ".opencode/skills/system-spec-kit/references/retrieval/retrieval-conventions.md"
    65	    exit_status: "0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit"
    66	    ranking: "Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5."
    67	  when_to_skip: ["User says 'skip context' or 'fresh start'"]
    68	  behavior:
    69	    if_context_found: "Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created."
    70	    if_no_context: "Set prior_context and prior_context_summary to 'None' and continue."
    71	
    72	# ─────────────────────────────────────────────────────────────────
    73	# SKILL REFERENCE
    74	# ─────────────────────────────────────────────────────────────────
    75	skill_reference:
    76	  skill: system-deep-loop
    77	  skill_md: .opencode/skills/system-deep-loop/deep-research/SKILL.md
    78	  references:
    79	    loop_protocol: .opencode/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md
    80	    spec_check_protocol: .opencode/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md
    81	    state_format: .opencode/skills/system-deep-loop/deep-research/references/state/state-format.md
    82	    convergence: .opencode/skills/system-deep-loop/deep-research/references/convergence/convergence.md
    83	  templates:
    84	    config: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-config.json
    85	    strategy: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md
    86	
    87	# ─────────────────────────────────────────────────────────────────
    88	# AGENT CONFIGURATION
    89	# ─────────────────────────────────────────────────────────────────
    90	agent_config:
    91	  agent: deep-research
    92	  agent_file: ".opencode/agents/deep-research.md"
    93	  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.
    94	  model: opus
    95	  leaf_only: true
    96	  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]
    97	  mcp_servers: []
    98	  tool_call_budget: { target: 8, max: 12 }
    99	
   100	# ─────────────────────────────────────────────────────────────────
   101	# STATE FILE PATHS
   102	# ─────────────────────────────────────────────────────────────────
   103	# ─────────────────────────────────────────────────────────────────
   104	# CANONICAL STATE WRITE MECHANISM
   105	# ─────────────────────────────────────────────────────────────────
   106	state_write_protocol:
   107	  mechanism: "append-gateway"
   108	  command: "node .opencode/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>"
   109	  applies_to: "every append_to_jsonl and append_jsonl directive in this workflow"
   110	  refusal_handling: "halt on exit 2; never fall back to a direct file write"
   111	  migration_exception: "Embedded lifecycle writers append run-now and pause sentinel records directly; no ledger event stem exists for them yet, so the gateway would reject them."
   112	  exempt_append_sites: 3
   113	  contract: |
   114	    The directives below specify WHAT to record; this block specifies the mechanism. The
   115	    command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an
   116	    `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,
   117	    which it upcasts before appending. Where the upcast is lossy it returns a warning, and
   118	    the warning is surfaced rather than swallowed. Only a small number of the directives
   119	    below currently reach the log this way: of fifteen, one routes through the gateway,
   120	    six are deliberately pinned to the legacy path by the schema and refused by the
   121	    upcaster on purpose — a decision, not an omission — and the remaining eight have no
   122	    registered stem, because the ledger models research semantics and those rows are
   123	    workflow bookkeeping. Whether they should become ledger events is unsettled. A
   124	    refusal names its own reason, so the caller can tell a deliberate pin from a missing
   125	    stem. A row the upcaster refuses returns exit 1 and writes nothing, with the reason
   126	    naming why. Exit 1 is distinct from the exit 2 refusal described in the next
   127	    paragraph: exit 1 means the input never reached authority, exit 2 means authority
   128	    refused it.
   129	
   130	    The gateway authorizes the write against the mode's durable authority record, serialises it
   131	    behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0
   132	    means the record is durable. Exit 2 means it was refused, and the refusal names the check
   133	    that failed.
   134	
   135	    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers
   136	    can then interleave with no shared ordering, and a record nobody authorized carries no
   137	    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal
   138	    is a halt, never a reason to write the file directly.
   139	
   140	    One exception exists and is deliberate. The embedded lifecycle writers append run-now and
   141	    pause sentinel records straight to the log, because those records have no registered event
   142	    type in this mode's ledger schema and the gateway would refuse them. They record that a
   143	    sentinel changed, not research progress. Every record the workflow itself produces goes
   144	    through the gateway, and these move to it once the schema names them.
   145	
   146	    The exempt_append_sites value is the exact number of direct-append sites covered by this
   147	    exception; any additional append site fails the conformance check until it has been
   148	    reviewed and the count deliberately raised to include it.
   149	
   150	state_paths:
   151	  # Template paths document the canonical packet layout. Runtime resolution happens via
   152	  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local
   153	  # research/ and child phases keep local research/ packet directories.
   154	  packet_dir: "{artifact_dir}"
   155	  config: "{artifact_dir}/deep-research-config.json"
   156	  state_log: "{artifact_dir}/deep-research-state.jsonl"
   157	  status_ledger: "{artifact_dir}/orchestration-status.log"
   158	  strategy: "{artifact_dir}/deep-research-strategy.md"
   159	  registry: "{artifact_dir}/findings-registry.json"
   160	  dashboard: "{artifact_dir}/deep-research-dashboard.md"
   161	  pause_sentinel: "{artifact_dir}/.deep-research-pause"
   162	  run_now_sentinel: "{artifact_dir}/.deep-research-run-now"
   163	  lock_file: "{artifact_dir}/.deep-research.lock"
   164	  prompt_dir: "{artifact_dir}/prompts"
   165	  iteration_dir: "{artifact_dir}/iterations"
   166	  iteration_pattern: "{artifact_dir}/iterations/iteration-{NNN}.md"
   167	  # Per-iteration structured delta stream (one file per iteration) — complement to the
   168	  # canonical state_log append. The delta file MUST contain at least one record whose
   169	  # `type === "iteration"` so the reducer can rehydrate iteration state after a partial
   170	  # run. Variants like `"iteration_delta"` are silently dropped by the reducer; the
   171	  # post_dispatch_validate step enforces the canonical type below.
   172	  delta_dir: "{artifact_dir}/deltas"
   173	  delta_pattern: "{artifact_dir}/deltas/iter-{NNN}.jsonl"
   174	  research_output: "{artifact_dir}/research.md"
   175	  resource_map_output: "{artifact_dir}/resource-map.md"
   176	  archive_root: "{artifact_archive_root}"
   177	  synthesis_snapshot_pattern: "{artifact_dir}/synthesis-v{generation}.md"
   178	
   179	# ─────────────────────────────────────────────────────────────────
   180	# WORKFLOW
   181	# ─────────────────────────────────────────────────────────────────
   182	workflow:
   183	
   184	  step_resolve_artifact_root:
   185	    description: "Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder"
   186	    note: "Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/."
   187	    branch_on: "config.fanout_lineage_artifact_dir"
   188	    if_present:
   189	      bind:
   190	        artifact_dir: "{config.fanout_lineage_artifact_dir}"
   191	        artifact_root_dir: "{config.fanout_lineage_artifact_dir}"
   192	        artifact_subfolder: null
   193	        artifact_archive_root: "{config.fanout_lineage_artifact_dir}/_archive"
   194	    if_absent:
   195	      command: "node -e \"const { resolveArtifactRoot } = require('./.opencode/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\""
   196	      outputs:
   197	        - artifact_root_dir: "Resolved local research owner directory"
   198	        - artifact_subfolder: "Local packet subfolder ({ownerSlug}-pt-{NN}), else null"
   199	        - artifact_dir: "Resolved research packet directory for this target"
   200	        - artifact_archive_root: "Resolved local research archive directory for this target"
   201	
   202	  step_fanout_spawn:
   203	    description: "Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor"
   204	    skip_when: "config.fanout is absent"
   205	    instructions: |
   206	      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own
   207	      isolated sub-packet under {artifact_dir}/lineages/{label}/.
   208	      fanout-run.cjs owns native and CLI lineage execution; native is run through the
   209	      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF
   210	      deep-research agent is used only for individual iterations, never as a full-loop
   211	      sub-agent or pasted phase-running prompt.
   212	      After all lineages complete, jump directly to phase_synthesis — skip phase_init and
   213	      phase_main_loop entirely (those are the single-executor path). The merge step in
   214	      phase_synthesis will consolidate results across all lineages.
   215	    sub_steps:
   216	      step_fanout_spawn_cli:
   217	        description: "Spawn all native and CLI lineages in capped worker pool"
   218	        skip_when: "no entries in config.fanout.executors"
   219	        command: |
   220	          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \
   221	            --spec-folder {spec_folder} \
   222	            --loop-type research \
   223	            --research-topic "{research_topic}" \
   224	            --fanout-config-json '{config.fanout_json}' \
   225	            --base-artifact-dir {artifact_dir} \
   226	            --convergence-threshold {convergence_threshold} \
   227	            --stop-policy {stop_policy}
   228	        working_directory: "{repo_root}"
   229	        wait_for_completion: true
   230	
   231	  # ═══════════════════════════════════════════════════════════════
   232	  # PHASE 1: INITIALIZATION
   233	  # ═══════════════════════════════════════════════════════════════
   234	  phase_init:
   235	    purpose: Create all state files for the research session
   236	    steps:
   237	
   238	      step_preflight_contract:
   239	        action: "Validate required setup bindings and executable workflow contract before any file writes"
   240	        verify:
   241	          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]
   242	          - spec_folder_is_within: "specs/ or .opencode/specs/ (canonicalize alias roots before validation)"
   243	          - unresolved_placeholders: "FAIL if any user-facing template references placeholders not produced by earlier steps"
   244	          - tool_contract: "FAIL if executable steps reference tools outside the command allowlist"
   245	        on_fail: "Halt with STATUS=FAIL and report the missing binding or unsupported contract reference"
   246	
   247	      step_create_directories:
   248	        action: "Create spec folder and research packet directories if they don't exist"
   249	        command: "mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}"
   250	
   251	      step_detect_resource_map:
   252	        action: "Detect resource-map.md before config creation so init can persist the flag and seed Known Context"
   253	        inspect:
   254	          - "{spec_folder}/resource-map.md"
   255	        classify:
   256	          present: "resource-map.md exists at init"
   257	          absent: "resource-map.md does not exist at init"
   258	        outputs:
   259	          - resource_map_present: "Boolean true when {spec_folder}/resource-map.md exists, else false"
   260	          - resource_map_known_context: "When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'."
   261	
   262	      step_resolve_canonical_names:
   263	        action: "Resolve canonical research packet artifact names before classification"
   264	        inspect_legacy:
   265	          - "{state_paths.packet_dir}/config.json"
   266	          - "{state_paths.packet_dir}/state.jsonl"
   267	          - "{state_paths.packet_dir}/strategy.md"
   268	          - "{state_paths.packet_dir}/dashboard.md"
   269	          - "{state_paths.packet_dir}/.pause"
   270	        migration_policy: "dual-read / single-write for 4 weeks"
   271	        on_legacy_read:
   272	          append_jsonl: '{"type":"event","event":"migration","legacyPath":"{legacy_path}","canonicalPath":"{canonical_path}","timestamp":"{ISO_8601_NOW}"}'
   273	
   274	      step_acquire_lock:
   275	        action: "Acquire the single-writer advisory lock before session classification"
   276	        command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder}"
   277	        on_acquire: "Capture ownerPid from the JSON output and reuse it for every release below. If acquired=false, fail closed — another deep-research run already holds this packet."
   278	        note: "Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls; stale-lock override is confirm-only or explicit recovery-only."
   279	        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.
   280	        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.
   281	        on_halt:
   282	          action: "Release the lock before any terminal halt branch returns control"
   283	          applies_to: ["step_classify_session.on_invalid_state", "step_classify_session.on_completed_session", "step_preinit_spec_branch.conflict-detected"]
   284	          command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; failures here are logged but do not block the halt"
   285	        on_cancel:
   286	          action: "Release the lock on user cancel or pause-sentinel detection before sentinel processing"
   287	          command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; cancel completes regardless of cleanup result"
   288	        on_workflow_exit:
   289	          action: "Release the lock as the final step of any workflow exit path (success or failure)"
   290	          command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; idempotent — safe to invoke when already released"
   291	
   292	      step_classify_session:
   293	        action: "Classify the session before writing files"
   294	        inspect:
   295	          - "{state_paths.config}"
   296	          - "{state_paths.state_log}"
   297	          - "{state_paths.strategy}"
   298	        classify:
   299	          fresh: "None of the three state artifacts exist"
   300	          resume: "Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null"
   301	          completed-session: "Resume artifacts exist and config.status == 'complete'"
   302	          invalid-state: "Any partial, missing, or contradictory combination"
   303	        outputs:
   304	          - session_state: "fresh | resume | completed-session | invalid-state"
   305	        on_resume:
   306	          # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.
   307	          # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).
   308	          gate3_classification: write-path
   309	          gate3_rationale: "resume produces iteration-NNN.md writes and JSONL state-log appends"
   310	          log: "Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive)."
   311	          append_jsonl: '{"type":"event","event":"resumed","mode":"research","sessionId":"{session_id}","parentSessionId":"{session_id}","lineageMode":"resume","continuedFromRun":{iteration_count},"generation":{generation},"archivedPath":null,"timestamp":"{ISO_8601_NOW}"}'
   312	          skip_to: phase_loop
   313	        on_restart:
   314	          action: "Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1."
   315	          command: "if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi"
   316	          set:
   317	            lineage_mode: "restart"
   318	            parent_session_id: "{prior_session_id}"
   319	            generation: "{prior_generation + 1}"
   320	          append_jsonl: '{"type":"event","event":"restarted","mode":"research","sessionId":"{session_id}","parentSessionId":"{prior_session_id}","lineageMode":"restart","generation":{generation},"archivedPath":"{state_paths.archive_root}/{timestamp_slug}","timestamp":"{ISO_8601_NOW}"}'
   321	          skip_to: step_create_config
   322	        note_deferred_branches: "fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract."
   323	        on_completed_session:
   324	          log: "Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead."
   325	          halt: true
   326	          message: "Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session."
   327	        on_invalid_state:
   328	          halt: true
   329	          message: "Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing."
   330	        on_fresh:
   331	          action: "Proceed with a new session"
   332	
   333	      step_resolve_session_id:
   334	        action: "Resolve init session id from caller when supplied, else preserve the auto-generated fallback"
   335	        branch_on: "session_id"
   336	        if_present:
   337	          bind:
   338	            session_id_init: "{session_id}"
   339	        if_absent:
   340	          bind:
   341	            session_id_init: "{AUTO_SESSION_ID}"
   342	
   343	      step_create_config:
   344	        action: "Create deep-research-config.json from template"
   345	        template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-config.json
   346	        populate:
   347	          topic: "{research_topic}"
   348	          maxIterations: "{max_iterations}"
   349	          minIterations: 3
   350	          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §"Convergence Threshold Semantics".
   351	          convergenceThreshold: "{convergence_threshold}"
   352	          antiConvergence.convergenceMode: "{convergence_mode}"
   353	          antiConvergence.divergent: {}
   354	          stuckThreshold: 3
   355	          minIdeaObservations: 2
   356	          maxDurationMinutes: 120
   357	          specFolder: "{spec_folder}"
   358	          resource_map_present: "{resource_map_present}"
   359	          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).
   360	          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.

