 succeeded in 0ms:
# ─────────────────────────────────────────────────────────────────
# DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)
# ─────────────────────────────────────────────────────────────────
# DEEP REVIEW: AUTONOMOUS DEEP REVIEW LOOP (AUTO MODE)
# ─────────────────────────────────────────────────────────────────
role: Deep Review Loop Manager
purpose: Iterative code/spec review with convergence detection across review dimensions
action: Run deep-review loop from initialization through synthesis
operating_mode:
  workflow: iterative_loop
  workflow_compliance: MANDATORY
  workflow_execution: autonomous
  approvals: none
  tracking: progressive_review_state
  validation: convergence_detection

# ─────────────────────────────────────────────────────────────────
# OPERATING PRINCIPLES
# ─────────────────────────────────────────────────────────────────
operating_principles:
  core: "Fresh context per iteration + externalized state = no context degradation"
  approach: "Dispatch focused review agent per dimension, evaluate convergence, repeat or stop"
  mandate: "Never hold findings in memory; write everything to files. Review target is READ-ONLY."

# ─────────────────────────────────────────────────────────────────
# USER INPUTS (from setup phase)
# ─────────────────────────────────────────────────────────────────
user_inputs:
  review_target: "[REVIEW_TARGET] - What to review. REQUIRED."
  review_target_type: "[spec-folder|skill|agent|track|files] - Target type for scope derivation. REQUIRED."
  review_dimensions: "[all|correctness,security,traceability,maintainability] - Dimensions to check. Default: all."
  spec_folder: "[SPEC_FOLDER] - Spec folder path for state files. REQUIRED."
  session_id: "[SESSION_ID] - Optional caller-supplied session id for fan-out lineages. Default: timestamp."
  lineage_mode: "[auto|resume|restart] - Session lifecycle intent. Default: auto. The runtime only persists lineage events for `resume` (same sessionId, no archive) and `restart` (new sessionId, generation+1, prior review/ archived). `fork` and `completed-continue` are deferred and no longer accepted — see deep-review/references/protocol/loop-protocol.md §Lifecycle Branches."
  max_iterations: 7
  convergence_threshold: 0.10
  convergence_mode: "[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default."
  stop_policy: "[convergence|max-iterations] - Stop behavior. Default: convergence. max-iterations treats convergence as telemetry until the hard iteration ceiling."
  config.fanout_lineage_artifact_dir: "[optional internal path] - Fan-out lineage artifact override for command-owned single-lineage execution."

# ─────────────────────────────────────────────────────────────────
# CONTEXT LOADING
# ─────────────────────────────────────────────────────────────────
context_loading:
  trigger: "At workflow START, before phase_init"
  purpose: "Load prior review context for the target and buffer it until strategy.md exists"
  retrieval:
    mechanism: "continuity-ladder-then-ripgrep"
    note: "File reads only. Nothing here needs a running daemon, and every step is reproducible by hand."
    ladder:
      - "{spec_folder}/handover.md when present"
      - "the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md"
      - "the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open"
    free_text_recipe: "rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{review_target}' specs .opencode"
    recipe_contract: ".opencode/skills/system-spec-kit/references/retrieval/retrieval-conventions.md"
    exit_status: "0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit"
    ranking: "Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5."
  when_to_skip: ["User says 'skip context' or 'fresh start'"]
  behavior:
    if_context_found: "Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created."
    if_no_context: "Set prior_context and prior_context_summary to 'None' and continue."

# ─────────────────────────────────────────────────────────────────
# SKILL REFERENCE
# ─────────────────────────────────────────────────────────────────
skill_reference:
  skill: system-deep-loop
  skill_md: .opencode/skills/system-deep-loop/deep-review/SKILL.md
  references:
    loop_protocol: .opencode/skills/system-deep-loop/deep-review/references/protocol/loop-protocol.md
    state_format: .opencode/skills/system-deep-loop/deep-review/references/state/state-format.md
    convergence: .opencode/skills/system-deep-loop/deep-review/references/convergence/convergence.md
  templates:
    config: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-config.json
    strategy: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md

# ─────────────────────────────────────────────────────────────────
# AGENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────
agent_config:
  agent: deep-review
  agent_file: ".opencode/agents/deep-review.md"
  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.
  mode: subagent
  model: opus
  leaf_only: true
  tools: [Read, Write, Edit, Bash, Grep, Glob]
  mcp_servers: []
  tool_call_budget: { target: 9, soft_max: 12, hard_max: 13 }

# ─────────────────────────────────────────────────────────────────
# STATE FILE PATHS
# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# CANONICAL STATE WRITE MECHANISM
# ─────────────────────────────────────────────────────────────────
state_write_protocol:
  mechanism: "append-gateway"
  command: "node .opencode/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>"
  applies_to: "every append_to_jsonl and append_jsonl directive in this workflow"
  refusal_handling: "halt on exit 2; never fall back to a direct file write"
  migration_exception: "the one-shot legacy-state migration command appends a legacy-shaped migration marker directly; it predates the canonical log and is not a workflow record"
  exempt_append_sites: 3
  contract: |
    Every canonical record named by an append_to_jsonl or append_jsonl directive below is
    intended to reach the log by invoking the command above with that record as the event JSON.
    Those directives specify WHAT to record; this block specifies the mechanism they are moving
    to, so it is stated once rather than repeated at each site where it could drift.

    The gateway authorizes the write against the mode's durable authority record, serialises it
    behind the ledger fence, and returns a receipt. It does NOT refresh this mode's legacy state
    file: no projection contract is registered for this mode, so `projectionRefreshed` comes back
    false and the legacy file is left untouched. Exit 0 therefore means the event is durable in
    the ledger, and nothing more. Exit 2 means it was refused and the refusal names the check
    that failed.

    Because the legacy file is what this workflow's existing readers consume, this block declares
    the mechanism these records are INTENDED to move to. It is not yet a live cutover for this
    mode, and the existing direct writes must stay until a projection contract exists for it.
    Switching them over before then would leave the legacy file silently stale.

    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers
    can then interleave with no shared ordering, and a record nobody authorized carries no
    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal
    is a halt, never a reason to write the file directly.

    One exception exists and is deliberate. The legacy-state migration command appends a
    legacy-shaped migration marker directly, because it runs before a canonical log exists and
    records that the move happened rather than recording workflow progress. Every record the
    workflow itself produces goes through the gateway.

    The exempt_append_sites number is the count of direct-append sites this exception covers;
    adding another such site fails the conformance check until it is reviewed and the count is
    deliberately updated to include it.

state_paths:
  # Template paths document the canonical packet layout. Runtime resolution happens via
  # step_resolve_artifact_root plus the shared resolver, so root specs keep
  # root-local review/ and child phases keep local review/ packet dirs.
  # Canonical root-spec write targets remain review/deep-review-config.json,
  # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.
  packet_dir: "{artifact_dir}"
  local_packet_dir: "{spec_folder}/review"
  legacy_root_report: "{spec_folder}/review-report.md"
  config: "{artifact_dir}/deep-review-config.json"
  state_log: "{artifact_dir}/deep-review-state.jsonl"
  findings_registry: "{artifact_dir}/deep-review-findings-registry.json"
  strategy: "{artifact_dir}/deep-review-strategy.md"
  dashboard: "{artifact_dir}/deep-review-dashboard.md"
  pause_sentinel: "{artifact_dir}/.deep-review-pause"
  lock_file: "{artifact_dir}/.deep-review.lock"
  prompt_dir: "{artifact_dir}/prompts"
  iteration_dir: "{artifact_dir}/iterations"
  iteration_pattern: "{artifact_dir}/iterations/iteration-{NNN}.md"
  # Per-iteration structured delta stream — complement to the canonical state_log
  # append. MUST contain at least one record with `type === "iteration"`; variants
  # like `"iteration_delta"` are silently dropped by the reducer.
  delta_dir: "{artifact_dir}/deltas"
  delta_pattern: "{artifact_dir}/deltas/iter-{NNN}.jsonl"
  review_output: "{artifact_dir}/review-report.md"
  resource_map_output: "{artifact_dir}/resource-map.md"
  archive_root: "{artifact_archive_root}"

# ─────────────────────────────────────────────────────────────────
# WORKFLOW
# ─────────────────────────────────────────────────────────────────
workflow:

  step_resolve_artifact_root:
    description: "Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder"
    note: "Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/."
    branch_on: "config.fanout_lineage_artifact_dir"
    if_present:
      bind:
        artifact_dir: "{config.fanout_lineage_artifact_dir}"
        artifact_root_dir: "{config.fanout_lineage_artifact_dir}"
        artifact_subfolder: null
        artifact_archive_root: "{config.fanout_lineage_artifact_dir}/_archive"
    if_absent:
      command: "node -e \"const { resolveArtifactRoot } = require('./.opencode/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'review')));\""
      outputs:
        - artifact_root_dir: "Resolved local review owner directory"
        - artifact_subfolder: "Local packet subfolder ({ownerSlug}-pt-{NN}), else null"
        - artifact_dir: "Resolved review packet directory for this target"
        - artifact_archive_root: "Resolved local review archive directory for this target"

  step_bind_reducer_artifact_arg:
    description: "Keep the reducer on the lineage-owned artifact directory during fan-out"
    branch_on: "config.fanout_lineage_artifact_dir"
    if_present:
      bind:
        reducer_artifact_arg: "--artifact-dir {artifact_dir}"
    if_absent:
      bind:
        reducer_artifact_arg: ""

  step_apply_lifecycle_request:
    description: "Honor explicit auto-mode restart before fan-out or normal initialization"
    skip_when: "lineage_mode != 'restart'"
    instructions: |
      This is the autonomous equivalent of the confirm-mode restart choice. Run it
      immediately after artifact resolution and before fan-out so old packet files
      cannot be merged with fresh lineage outputs. A restart request must never
      fall back to auto-resume. In auto mode, the explicit restart flag is operator
      authorization to archive the resolved review packet, so do not ask for a
      second confirmation. Rollback is to move the timestamped archive back to
      the packet directory.
    command: "if [ -d \"{state_paths.packet_dir}\" ]; then mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\"; fi; mkdir -p \"{state_paths.packet_dir}\""
    outputs:
      - archived_path: "{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null"
      - lineage_mode: "restart"
    on_fail: "Halt with STATUS=FAIL; do not continue as resume or auto."

  step_fanout_spawn:
    description: "Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor"
    skip_when: "config.fanout is absent"
    instructions: |
      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own
      isolated sub-packet under {artifact_dir}/lineages/{label}/.
      A cli-opencode lineage inside this fan-out is an explicit parallel-detached OpenCode
      session with a separate lineage directory and session id; it is not the single-executor
      self-invocation path. fanout-run.cjs owns the stack-only recursion guard for that
      first-level detached lineage and still blocks recursive same-kind dispatch from inside it.
      fanout-run.cjs owns native and CLI lineage execution; native is run through the
      deep/review command surface with config.fanout_lineage_artifact_dir so the LEAF
      deep-review agent is used only for individual iterations, never as a full-loop
      sub-agent or pasted phase-running prompt.
      After all lineages complete, jump directly to phase_synthesis — skip phase_init and
      phase_main_loop entirely (those are the single-executor path). The merge step in
      phase_synthesis will consolidate results across all lineages.
    sub_steps:
      step_fanout_spawn_cli:
        description: "Spawn all native and CLI lineages in capped worker pool"
        skip_when: "no entries in config.fanout.executors"
        command: |
          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \
            --spec-folder {spec_folder} \
            --loop-type review \
            --fanout-config-json '{config.fanout_json}' \
            --base-artifact-dir {artifact_dir} \
            --convergence-threshold {convergence_threshold} \
            --stop-policy {stop_policy}
        working_directory: "{repo_root}"
        wait_for_completion: true

  # ═══════════════════════════════════════════════════════════════
  # PHASE 1: INITIALIZATION
  # ═══════════════════════════════════════════════════════════════
  phase_init:
    purpose: Create all state files for the review session and resolve review scope
    steps:

      step_preflight_contract:
        action: "Validate required setup bindings and executable workflow contract before any file writes"
        verify:
          - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]
          - spec_folder_is_within: "specs/ or .opencode/specs/ (canonicalize alias roots before validation)"
          - unresolved_placeholders: "FAIL if any user-facing template references placeholders not produced by earlier steps"
          - tool_contract: "FAIL if executable steps reference tools outside the command allowlist"
        on_fail: "Halt with STATUS=FAIL and report the missing binding or unsupported contract reference"

      step_create_directories:
        action: "Create spec folder and canonical review packet directories if they don't exist"
        command: "mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}"

      step_detect_resource_map:
        action: "Detect resource-map.md before config creation so init can persist coverage-gate state"
        inspect:
          - "{spec_folder}/resource-map.md"
        classify:
          present: "resource-map.md exists at init"
          absent: "resource-map.md does not exist at init"
        outputs:
          - resource_map_present: "Boolean true when {spec_folder}/resource-map.md exists, else false"
          - resource_map_known_context: "When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'."

      step_migrate_legacy_review_state:
        action: "Rehome legacy review artifacts into review/iterations before session classification"
        detect:
          canonical_review_state:
            - "{state_paths.config}"
            - "{state_paths.state_log}"
            - "{state_paths.findings_registry}"
            - "{state_paths.strategy}"
          legacy_review_state:
            - "{spec_folder}/scratch/deep-research-config.json"
            - "{spec_folder}/scratch/deep-research-state.jsonl"
            - "{spec_folder}/scratch/deep-review-strategy.md"
            - "{spec_folder}/scratch/deep-review-dashboard.md"
            - "{spec_folder}/scratch/iteration-*.md"
            - "{spec_folder}/scratch/.deep-research-pause"
            - "{state_paths.local_packet_dir}/iteration-*.md"
            - "{state_paths.legacy_root_report}"
          legacy_review_markers:
            - "scratch/deep-review-strategy.md exists"
            - "scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'"
        migrate_only:
          - "{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}"
          - "{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}"
          - "{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}"
          - "{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}"
          - "{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/"
          - "{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}"
          - "{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/"
          - "{state_paths.legacy_root_report} -> {state_paths.review_output}"
        on_canonical_present: "Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts."
        on_legacy_detected: "Move only the review-specific whitelist, append a migration event to the canonical JSONL, and leave unrelated scratch files untouched."
        on_conflict: "If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state."
        command: "mkdir -p {state_paths.iteration_dir} && if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}; [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}; [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}; [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}; find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; ; [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}; [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}; if [ -e {state_paths.state_log} ]; then printf '%s\n' '{\"type\":\"event\",\"event\":\"migration\",\"mode\":\"review\",\"legacyArtifacts\":[\"deep-research-config.json\",\"deep-research-state.jsonl\",\".deep-research-pause\"],\"canonicalArtifacts\":[\"deep-review-config.json\",\"deep-review-state.jsonl\",\".deep-review-pause\"],\"timestamp\":\"{ISO_8601_NOW}\"}' >> {state_paths.state_log}; fi; fi; find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true"

      step_acquire_lock:
        action: "Acquire the single-writer advisory lock before session classification"
        command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder}"
        on_acquire: "Capture ownerPid from the JSON output and reuse it for every release below. If acquired=false, fail closed — another deep-review run already holds this packet."
        note: "Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls; stale-lock override is confirm-only or explicit recovery-only."
        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.
        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.
        on_halt:
          action: "Release the lock before any terminal halt branch returns control"
          applies_to: ["step_classify_session.on_invalid_state", "step_classify_session.on_completed_session"]
          command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; failures here are logged but do not block the halt"
        on_cancel:
          action: "Release the lock on user cancel or pause-sentinel detection before sentinel processing"
          command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; cancel completes regardless of cleanup result"
        on_workflow_exit:
          action: "Release the lock as the final step of any workflow exit path (success or failure)"
          command: "node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}; idempotent — safe to invoke when already released"

      step_classify_session:
        action: "Classify the session before writing files"
        inspect:
          - "{state_paths.config}"
          - "{state_paths.state_log}"
          - "{state_paths.findings_registry}"
          - "{state_paths.strategy}"
        classify:
          fresh: "None of the three state artifacts exist"
          resume: "Config, JSONL, and strategy all exist and config.mode == 'review' and agree on target/spec folder"
          completed-session: "Resume artifacts exist and config.status == 'complete'"
          invalid-state: "Any partial, missing, or contradictory combination"
        outputs:
          - session_state: "fresh | resume | completed-session | invalid-state"
        lifecycle_routing:
          - "If lineage_mode == restart and session_state is resume or completed-session, execute on_restart before on_resume or on_completed_session."
          - "If lineage_mode == auto or lineage_mode == resume, preserve the existing resume/completed/fresh behavior."
        on_resume:
          log: "Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive)."
          append_jsonl: '{"type":"event","event":"resumed","mode":"review","sessionId":"{session_id}","parentSessionId":"{session_id}","lineageMode":"resume","continuedFromRun":{iteration_count},"generation":{generation},"archivedPath":null,"timestamp":"{ISO_8601_NOW}"}'
          skip_to: phase_loop
        on_restart:
          action: "Archive the current review packet under the root-level review-archive/ tree and start a new lineage segment with a fresh sessionId and generation+1."
          command: "if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi"
          set:
            lineage_mode: "restart"
            parent_session_id: "{prior_session_id}"
            generation: "{prior_generation + 1}"
          append_jsonl: '{"type":"event","event":"restarted","mode":"review","sessionId":"{session_id}","parentSessionId":"{prior_session_id}","lineageMode":"restart","generation":{generation},"archivedPath":"{state_paths.archive_root}/{timestamp_slug}","timestamp":"{ISO_8601_NOW}"}'
          skip_to: step_create_config
        note_deferred_branches: "fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-review/references/protocol/loop-protocol.md §Lifecycle Branches for the one-session contract."
        on_completed_session:

hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "sed -n '360,780p' .opencode/commands/deep/assets/deep-review-auto.yaml" in /Users/michelkerkmeester/MEGA/Development/Code_Environment/Public
 succeeded in 0ms:
        on_completed_session:
          log: "Prior session already completed. Either archive the completed review/ tree and start a fresh session, or jump straight to synthesis with the existing artifacts."
          skip_to: phase_synthesis
        on_invalid_state:
          halt: true
          message: "Existing deep-review state in review/ is incomplete or contradictory. Repair or archive the invalid review packet before continuing."
        on_fresh:
          action: "Proceed with a new session"

      step_scope_discovery:
        action: "Resolve review target to a concrete file list based on target type"
        resolve:
          spec-folder: |
            1. Inspect spec.md, plan.md, tasks.md, checklist.md, implementation-summary.md, and goal-file-manifest.txt when present
            2. If goal-file-manifest.txt exists, parse one repo-relative path per non-empty, non-comment line; reject absolute paths, traversal outside repo_root, duplicates, missing paths, and non-file entries
            3. Fail before dispatch with line-numbered validation errors when any manifest entry is invalid; otherwise set scope = the validated manifest paths in declared order
            4. When no manifest exists, discover implementation files referenced in the canonical spec artifacts
            5. Discover test files associated with the implementation files
            6. Set scope = all discovered implementation and test files
          skill: |
            1. Read SKILL.md from .opencode/skills/{skill_name}/
            2. Discover references/, assets/, scripts/ contents
            3. Find agent definitions referencing this skill across runtimes
            4. Find command entry points referencing this skill
            5. Set scope = all discovered files
          agent: |
            1. Find agent definition across repo-managed runtimes (.claude/agents/, .opencode/agents/)
            2. Compare agent definitions for consistency
            3. Set scope = all discovered agent files
          track: |
            1. List all child spec folders under specs/{track}/ or .opencode/specs/{track}/
            2. For each: read spec.md + checklist.md
            3. Set scope = all child spec artifacts
          files: |
            1. Expand glob patterns from review_target
            2. Validate all files exist
            3. Discover immediate cross-references (imports, links)
            4. Set scope = expanded file list + cross-references
        outputs:
          - review_scope_files: "List of all files in review scope"
          - cross_reference_targets: "{ spec_paths: [...], code_paths: [...], test_paths: [...] }"

      step_order_dimensions:
        action: "Order review dimensions based on risk priority"
        algorithm: |
          1. Iteration 0 (inventory pass): Build artifact map, identify file types, estimate complexity
          2. Subsequent iterations follow risk-ordered deep passes:
             correctness → security → traceability → maintainability
          3. If review_dimensions != "all", filter to only requested dimensions
          4. Derive traceability protocol plan:
             - core: spec_code, checklist_evidence
             - overlay: skill_agent, agent_cross_runtime, feature_catalog_code, playbook_capability
          5. If resource_map_present, reserve at least one traceability-oriented pass to cross-check target_files from applied/T-*.md against resource-map.md and classify touched / expected-by-scope / gap / absent-from-map outcomes
          6. Store ordered list as dimension_queue
        outputs:
          - dimension_queue: "Ordered list of dimensions to review"
          - inventory_pass: true

      step_normalize_review_dimensions:
        action: "Normalize reviewDimensions once during init for config + JSONL reuse"
        outputs:
          - review_dimensions_normalized: "Canonical string[] for deep-review-config.json"
          - review_dimensions_json: "JSON.stringify(review_dimensions_normalized) for JSONL config record"
        normalize: |
          Accept {review_dimensions} in any of these shapes and convert once:
            - "all" → ["correctness","security","traceability","maintainability"]
            - "correctness,security" → ["correctness","security"]
            - ["correctness"] → ["correctness"]
          Every element MUST be one of the four canonical dimension names.

      step_resolve_session_id:
        action: "Resolve init session id from caller when supplied, else preserve timestamp fallback"
        branch_on: "session_id"
        if_present:
          bind:
            session_id_init: "{session_id}"
        if_absent:
          bind:
            session_id_init: "{ISO_8601_NOW}"

      step_create_config:
        action: "Create deep-review-config.json from template with review-specific fields"
        template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-config.json
        populate:
          topic: "Review: {review_target}"
          mode: "review"
          sessionId: "{session_id_init}"
          parentSessionId: null
          lineageMode: "new"
          generation: 1
          continuedFromRun: null
          reviewTarget: "{review_target}"
          reviewTargetType: "{review_target_type}"
          # Reuse the single normalized init-time value from step_normalize_review_dimensions.
          reviewDimensions: "{review_dimensions_normalized}"
          resource_map_present: "{resource_map_present}"
          reviewScopeFiles: "{review_scope_files}"
          severityThreshold: "P2"
          crossReference:
            core: ["spec_code", "checklist_evidence"]
            overlay: ["skill_agent", "agent_cross_runtime", "feature_catalog_code", "playbook_capability"]
          maxIterations: "{max_iterations}"
          # Semantic: weighted P0/P1/P2 severity ratio. See SKILL.md §"Convergence Threshold Semantics".
          convergenceThreshold: "{convergence_threshold}"
          antiConvergence.convergenceMode: "{convergence_mode}"
          antiConvergence.divergent: {}
          stopPolicy: "{stop_policy}"
          stuckThreshold: 2
          maxDurationMinutes: 120
          specFolder: "{spec_folder}"
          # Honor the parsed --no-resource-map flag from deep-review.md:71 (default true; false when flag is set).
          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.
          resource_map.emit: "{resource_map_emit}"
          createdAt: "{ISO_8601_NOW}"
          status: "initialized"
          releaseReadinessState: "in-progress"
          executionMode: "auto"
        output: "{state_paths.config}"

      step_create_state_log:
        action: "Initialize JSONL state log with config record including review fields and lineage metadata"
        note: "Reuse review_dimensions_json from step_normalize_review_dimensions. Never re-normalize or wrap the raw template value."
        # Same parsed --no-resource-map flag honored here so config and state_log agree from line 1.
        content: '{"type":"config","mode":"review","reviewTarget":"{review_target}","reviewTargetType":"{review_target_type}","reviewDimensions":{review_dimensions_json},"resource_map_present":{resource_map_present},"resource_map":{"emit":{resource_map_emit}},"sessionId":"{session_id_init}","parentSessionId":null,"lineageMode":"new","generation":1,"continuedFromRun":null,"maxIterations":{max_iterations},"convergenceThreshold":{convergence_threshold},"antiConvergence":{"convergenceMode":"{convergence_mode}","divergent":{}},"stopPolicy":"{stop_policy}","createdAt":"{ISO_8601_NOW}","specFolder":"{spec_folder}"}'
        output: "{state_paths.state_log}"

      step_create_findings_registry:
        action: "Initialize reducer-owned review findings registry"
        content: '{"sessionId":"{session_id_init}","generation":1,"lineageMode":"new","openFindings":[],"resolvedFindings":[],"repeatedFindings":[],"dimensionCoverage":{"correctness":false,"security":false,"traceability":false,"maintainability":false},"findingsBySeverity":{"P0":0,"P1":0,"P2":0},"openFindingsCount":0,"resolvedFindingsCount":0,"convergenceScore":0.0}'
        output: "{state_paths.findings_registry}"

      step_create_strategy:
        action: "Create review strategy file from deep-review-strategy.md template"
        template: .opencode/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md
        populate:
          review_target: "{review_target}"
          review_target_type: "{review_target_type}"
          dimensions: "{dimension_queue}"
          scope_files: "{review_scope_files}"
          cross_reference_targets: "{cross_reference_targets}"
          max_iterations: "{max_iterations}"
          convergence_threshold: "{convergence_threshold}"
          stop_policy: "{stop_policy}"
        output: "{state_paths.strategy}"

      step_seed_coverage_graph:
        action: "Seed the review coverage graph before the first convergence check"
        transform: |
          1. Convert review_scope_files into FILE nodes.
          2. Convert review target groupings into coarse SLICE nodes only; do not expand SYMBOL
             or DEPENDENCY nodes in review mode.
          3. Emit COVERS edges from SLICE nodes to FILE nodes when the grouping is known.
          4. Bind coverage_seed_source to "scope_discovery" and coverage_seed_confidence to 0.50.
          5. When scope discovery yields no files, emit [] for both arrays; the upsert script
             returns a warning and review continues with an empty graph.
        bash: "node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{config.sessionId}\" --nodes '{coverage_seed_nodes_json}' --edges '{coverage_seed_edges_json}' --seed-source \"{coverage_seed_source}\" --seed-confidence \"{coverage_seed_confidence}\""
        outputs:
          - coverage_seed_nodes_json: "Seed nodes for review SLICE and FILE kinds only"
          - coverage_seed_edges_json: "Seed COVERS edges where review target groupings resolved"
          - coverage_seed_warning: "Warning emitted when the seed batch inserts zero nodes, else empty"
        on_warning:
          log: "Coverage graph seed inserted zero nodes; continuing with an empty graph."
          proceed: true

      step_enrich_strategy_context:
        action: "Ensure Known Context is written only after strategy.md exists"
        condition: "prior_context_found"
        edit: "{state_paths.strategy}"
        note: "Append or replace the Known Context section with prior_context_summary and retained detail from prior_context"

      step_enrich_strategy_resource_map:
        action: "Inject resource-map status into Known Context after strategy.md exists"
        edit: "{state_paths.strategy}"
        note: "When resource_map_present is true, append the resource_map_known_context snapshot and add Resource Map Coverage to the Review Charter. When false, append 'resource-map.md not present; skipping coverage gate'."

      step_init_complete:
        log: "Initialization complete. Config, state, and strategy files created. Review scope: {review_scope_files_count} files, {dimension_queue_count} dimensions."
        set: { current_iteration: 1, stuck_count: 0, p0_count: 0, p1_count: 0, p2_count: 0 }

  # ═══════════════════════════════════════════════════════════════
  # PHASE 2: ITERATION LOOP
  # ═══════════════════════════════════════════════════════════════
  phase_loop:
    purpose: Dispatch review agent iterations until convergence
    repeat: true
    max_repeats: "{max_iterations}"
    steps:

      step_read_state:
        action: "Read current state from JSONL, strategy, and config"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.findings_registry}"
          - "{state_paths.strategy}"
          - "{state_paths.config}"
        extract:
          - iteration_count: "Count lines where type === 'iteration'"
          - current_iteration: "iteration_count + 1"
          - last_newFindingsRatio: "Extract newFindingsRatio from last iteration record"
          - last_focus: "Extract focus/dimension from latest iteration record, else 'none yet'"
          - ratio_prev: "Extract newFindingsRatio from second-latest iteration record, else 'N/A'"
          - ratio_latest: "Extract newFindingsRatio from latest iteration record, else 'N/A'"
          - next_dimension: "Next uncovered dimension from dimension_queue in strategy.md"
          - dimensions_covered: "List of dimensions already reviewed"
          - dimensions_remaining: "List of dimensions not yet reviewed"
          - dimension_coverage: "covered / total dimensions"
          - coverage_age: "Iterations since dimension coverage last changed; require >= 1 before STOP"
          - p0_count: "Count P0 findings across all iterations"
          - p1_count: "Count P1 findings across all iterations"
          - p2_count: "Count P2 findings across all iterations"
          - resource_map_present: "Extract boolean from deep-review-config.json, default false"
          - resource_map_prompt_line: "If resource_map_present is true, return 'Resource Map Coverage: cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md and classify only missed coverage as gaps.' Else return 'Resource Map Coverage: resource-map.md not present; skipping coverage gate.'"
          - session_id: "Extract sessionId from deep-review-config.json"
          - generation: "Extract generation from deep-review-config.json, else 1"
          - last_3_summaries: "Summarize the latest 3 iteration records as 'run N: dimension (ratio, P0/P1/P2)'"
          - latest_status: "Extract status from latest iteration record, else 'none yet'"
          - last_claim_adjudication_passed: "Scan state.jsonl for the most recent `claim_adjudication` event; use its `passed` boolean. Default true when no event exists or when activeP0 + activeP1 == 0 (gate is vacuous without adjudicable findings)."
          - claim_adjudication_active_count: "Count of active P0/P1 findings at the time of the last claim_adjudication event; 0 when none exist"
          - security_sensitive_fix_scope: "Boolean true when the current review is a rerun after fixes involving security, path disclosure, auth/authz, sandboxing, env precedence, public schemas, persistence, or user-visible error payloads; derive from the latest review report, remediation notes, or planning packet when present, else false."
          - fix_completeness_replay_required_rows: "Count prior active or remediated P0/P1 findings, plus any prior security/path P2 findings, that require closed-gate replay before STOP."
          - fix_completeness_replay_passing_rows: "Count required replay rows marked PASS with file:line or command evidence and producer/consumer/matrix coverage."
          - stop_policy: "Extract stopPolicy from deep-review-config.json, default 'convergence'. Valid values: convergence, max-iterations."
          - convergence_mode: "Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'"
          - convergence_mode_warning: "Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'"
          - pivot_lineage: "Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected review direction; else 'none yet'"
          - saturated_directions: "List registry.divergence.saturatedDirections; else 'none yet'"

      step_check_pause_sentinel:
        action: "Check for pause sentinel file"
        check: "Does {state_paths.pause_sentinel} exist?"
        if_exists:
          set:
            pending_stop_event: "paused"
            pending_stop_reason: "userPaused"
            pending_stop_detail: "sentinel file detected"
          skip_to: step_normalize_pause_events
        if_not_exists:
          proceed: true

      step_validate_convergence_config:
        action: "Validate convergence mode when loading config"
        if_convergence_mode_invalid:
          append_jsonl: '{"type":"event","event":"config_warning","mode":"review","field":"antiConvergence.convergenceMode","fallback":"default","message":"Unsupported convergenceMode; using default convergence behavior.","timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}'
          log: "Unsupported convergenceMode; using default convergence behavior."

      step_graph_convergence:
        action: "Evaluate coverage-graph convergence before the inline review convergence vote"
        inspect:
          - "{state_paths.state_log}"
          - "{state_paths.findings_registry}"
        transform: |
          1. Call graph convergence on the current review lineage before the inline 3-signal vote.
          2. Record the decision as one of CONTINUE, STOP_ALLOWED, STOP_BLOCKED.
          3. Preserve raw graph signals and blockers for reducer rollup and blocked-stop evidence.
          4. Normalize blockers to both JSON array and CSV forms for downstream stop handling.
          5. Set graph_stop_blocked = true only when graph_decision == "STOP_BLOCKED".
        bash: 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder "{spec_folder}" --loop-type "review" --session-id "{session_id}" --convergence-mode "{convergence_mode}"'
        note: "Invoke the runtime script directly. Review-side graph convergence must run before the inline review stop vote."
        append_jsonl: '{"type":"event","event":"graph_convergence","mode":"review","run":{current_iteration},"decision":"{graph_decision}","signals":{graph_signals_json},"blockers":{graph_blockers_json},"timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}'
        outputs:
          - graph_decision: "CONTINUE | STOP_ALLOWED | STOP_BLOCKED"
          - graph_signals_json: "JSON object returned by convergence.cjs"
          - graph_blockers_json: "JSON array of graph blockers when present, else []"
          - graph_blockers_csv: "Comma-separated blocker summary when graph blocks STOP, else empty string"
          - graph_stop_blocked: "Boolean true when graph_decision == STOP_BLOCKED"

      step_check_convergence:
        action: "Evaluate graph-assisted review stop conditions and the legal-stop decision tree"
        algorithm: |
          0. CLAIM-ADJUDICATION PRE-CHECK (universal STOP veto; runs before hard stops and composite convergence):
             claim_adjudication_gate_pass = (last_claim_adjudication_passed != false) OR (p0_count + p1_count == 0)
             If claim_adjudication_gate_pass == false:
               candidate_decision = "BLOCKED"
               stop_blocked = true
               stopReason = "blockedStop"
               blocked_gates = ["claimAdjudicationGate"]
               recovery_strategy = "Reviewer must add typed claim-adjudication packets (claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger) for every active P0/P1 finding before STOP is allowed."
               Skip hard stops (1) and composite convergence (4); proceed directly to step 5 legal-stop decision-tree assembly so blocked_by_json, gate outputs, and the blocked_stop event still populate consistently.
          1. HARD STOPS:
             a) if iteration_count >= max_iterations: set decision = "STOP", stopReason = "maxIterationsReached", hard_stop_reason = "max_iterations_reached", preserve any failed legal-stop gates as terminal evidence, and proceed to synthesis without legal-stop veto
             b) if stop_policy == "max-iterations" AND iteration_count < max_iterations: do not allow all-dimensions-clean or composite convergence to stop; treat convergence signals as telemetry, set decision = "CONTINUE", and broaden the next review angle.
             c) if all dimensions clean AND required traceability protocols are covered AND p0_count == 0 AND p1_count == 0 AND coverage_age >= 1 AND all quality gates pass (evidence: every P0/P1 has file:line; scope: all findings within target; coverage: all dimensions reviewed): mark hard_stop_reason = "all_dimensions_clean" and promote to STOP candidate
             Operator stop reasons (`maxIterationsReached`, `manualStop`, `userPaused`, unrecoverable `error`) are terminal ceilings. They do not hide failed gates; they record them in synthesis and stop dispatch.
          2. STUCK DETECTION (threshold 2):
             if stuck_count >= 2: STUCK_RECOVERY
          3. GRAPH CONVERGENCE PREREQUISITE:
               graph_decision, graph_signals_json, and graph_blockers_json are already populated by step_graph_convergence.
               Final STOP is never legal unless the inline review vote says STOP AND graph_decision == "STOP_ALLOWED".
               If graph_decision == "STOP_BLOCKED", set stop_blocked = true and route through blocked_stop emission instead of stopping.
          4. COMPOSITE CONVERGENCE (3-signal weighted vote with split thresholds):
               signals = []
               a) Rolling average (w=0.30, window=2, needs 2+ iterations):
                  avg = mean(last 2 newFindingsRatios)
                  stop if avg <= 0.08
               b) MAD noise floor (w=0.25, needs 3+ iterations):
                  noiseFloor = MAD(all ratios) * 1.4826
                  stop if latest ratio <= noiseFloor
               c) Dimension coverage (w=0.45):
                  coverage = dimensions_covered / total_dimensions
                  stop if coverage >= 1.0 AND required traceability protocols are covered AND coverage_age >= 1
               Redistribute weights for unavailable signals.
               if latest ratio <= 0.05: mark no_progress_threshold_reached
               if stop_policy == "max-iterations" AND iteration_count < max_iterations: convergence votes are telemetry only; set weighted_stop_score for diagnostics, keep decision = "CONTINUE", and choose a broader next focus.
               else if weighted_stop_score >= 0.60: inline STOP becomes a candidate and binary gates must run
          5. LEGAL-STOP DECISION TREE (review-specific gates; runs whenever step 0, all-dimensions-clean, or the composite vote promotes STOP to a candidate; terminal max-iteration/manual/error stops bypass veto and record failed gates as evidence):
               a) convergenceGate: pass when a hard-stop condition is met OR weighted_stop_score >= 0.60; record score
               b) dimensionCoverageGate: pass when configured dimensions and required traceability coverage are complete and coverage_age >= 1; record covered and missing dimensions
               c) p0ResolutionGate: pass when activeP0 == 0; record activeP0
               d) evidenceDensityGate: pass when every active P0/P1 has concrete file:line evidence and no active P0/P1 relies only on inference; record avgEvidencePerFinding
               e) hotspotSaturationGate: pass when review hotspots have been revisited enough times to satisfy the saturation heuristic
               f) claimAdjudicationGate: pass when claim_adjudication_gate_pass == true (i.e. last_claim_adjudication_passed != false OR there are no active P0/P1 findings to adjudicate); record last_claim_adjudication_passed and claim_adjudication_active_count
               g) fixCompletenessReplayGate: pass when security_sensitive_fix_scope == false OR every required closed-gate replay row passes with file:line or command evidence and producer/consumer/matrix coverage; record security_sensitive_fix_scope, fix_completeness_replay_required_rows, and fix_completeness_replay_passing_rows
               h) candidateCoverageGate: skip entirely when `reviewDepthSchemaVersion` is not 2 on the latest iteration. Otherwise pass when the current iteration's `reviewDepthApplicability.scopeClass` is `trivial` with `enforcement: "skip"` AND `reviewDepthApplicability.evidenceRefs` is non-empty, OR when the reducer registry's `searchDebt` is empty AND `candidateCoverage.covered` is a superset of `searchCoverage.requiredBugClasses` for the lineage. Otherwise pass = false; record `searchDebt` items as blocked-stop evidence; blocker name = "candidateCoverageGate"; recovery_strategy = "Resolve deferred/blocked obligations in next iteration or downgrade scope explicitly to trivial with cited evidence."
               i) graphlessFallbackGate: skip when `reviewDepthSchemaVersion` is not 2 OR the reducer registry's last-iteration `searchCoverage.graphCoverageMode` is `graph`. Applies when graphCoverageMode is `graphless_fallback` or `unavailable_blocked`. Pass when graphCoverageMode is `graphless_fallback` AND at least one `searchLedger` row exists for each entry in `searchCoverage.requiredBugClasses` with `searchActions[].method` in {"direct_read","exact_grep","semantic_search","producer_consumer_trace","negative_test_inspection"} AND non-empty `evidenceRefs`. Fail automatically when graphCoverageMode is `unavailable_blocked`; record the explicit unavailability reason. Otherwise pass = false; blocker name = "graphlessFallbackGate"; recovery_strategy = "Add cited fallback ledger rows (direct read, exact search, producer/consumer trace, negative-test inspection) or set graphCoverageMode to 'graph' once graph data is available."
             if STOP is a candidate and any gate fails:
               decision = "BLOCKED"
               stop_blocked = true
               stopReason = "blockedStop"
               blocked_by_json = JSON array of failing gate names (always include "claimAdjudicationGate" when claim_adjudication_gate_pass == false, "fixCompletenessReplayGate" when fix_completeness_replay_gate_pass == false, "candidateCoverageGate" when candidate_coverage_gate_pass == false, and "graphlessFallbackGate" when graphless_fallback_gate_pass == false)
               blocked_by_csv = comma-separated list of failing gate names
               convergence_gate_pass = boolean
               convergence_gate_score = numeric convergence score
               dimension_coverage_gate_pass = boolean
               dimension_coverage_gate_covered_json = JSON array of covered review dimensions
               dimension_coverage_gate_missing_json = JSON array of missing review dimensions
               p0_resolution_gate_pass = boolean
               active_p0_count = number of active P0 findings
               evidence_density_gate_pass = boolean
               avg_evidence_per_finding = numeric evidence density
               hotspot_saturation_gate_pass = boolean
               claim_adjudication_gate_pass = boolean
               claim_adjudication_active_count = numeric count of active P0/P1 at the gate
               fix_completeness_replay_gate_pass = boolean
               security_sensitive_fix_scope = boolean
               fix_completeness_replay_required_rows = numeric count of closed-gate replay rows required for security-sensitive fix reruns
               fix_completeness_replay_passing_rows = numeric count of required closed-gate replay rows marked PASS with evidence
               candidate_coverage_gate_pass = boolean
               candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []
               candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []
               graphless_fallback_gate_pass = boolean
               graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value
               graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []
               graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == "unavailable_blocked", else empty string
               recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)
          6. COMBINED STOP RULE:
               a) if STOP is legal AND graph_decision == "STOP_ALLOWED": decision = "STOP"
               b) if STOP is legal AND graph_decision == "STOP_BLOCKED":
                    decision = "BLOCKED"
                    stop_blocked = true
                    stopReason = "blockedStop"
                    # Blocked-stop closure: blockedBy must be string[] per the
                    # published review blocked-stop contract. Extract the `.type`
                    # field from each structured graph blocker; preserve the full
                    # objects in graph_blocker_detail_json for operator inspection.
                    blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === "string" ? b : (b && b.type) || "graph_blocker"))
                    blocked_by_csv = graph_blockers_csv
                    graph_blocker_detail_json = graph_blockers_json
                    recovery_strategy = "Resolve review coverage-graph blockers before stopping."
               c) if STOP is legal AND graph_decision == "CONTINUE":
                    decision = "CONTINUE"
                    stop_blocked = false
                    reason = "graph_convergence_continue"
               d) else keep the existing STUCK_RECOVERY or CONTINUE outcome
        outputs:
          - decision: "STOP | BLOCKED | STUCK_RECOVERY | CONTINUE"
          - reason: "Human-readable stop reason"
          - stop_blocked: "Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED"
          - blocked_by_json: "JSON array of failed legal-stop gates when decision == BLOCKED"
          - blocked_by_csv: "Comma-separated list of failed legal-stop gates when decision == BLOCKED"
          - convergence_gate_pass: "Boolean pass/fail for convergenceGate"
          - convergence_gate_score: "Numeric score recorded for convergenceGate"
          - dimension_coverage_gate_pass: "Boolean pass/fail for dimensionCoverageGate"
          - dimension_coverage_gate_covered_json: "JSON array of covered review dimensions"
          - dimension_coverage_gate_missing_json: "JSON array of missing review dimensions"
          - p0_resolution_gate_pass: "Boolean pass/fail for p0ResolutionGate"
          - active_p0_count: "Active P0 finding count at stop-check time"
          - evidence_density_gate_pass: "Boolean pass/fail for evidenceDensityGate"
          - avg_evidence_per_finding: "Numeric evidence density for active findings"
          - hotspot_saturation_gate_pass: "Boolean pass/fail for hotspotSaturationGate"
          - claim_adjudication_gate_pass: "Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)"
          - claim_adjudication_active_count: "Count of active P0/P1 findings evaluated by claimAdjudicationGate"
          - fix_completeness_replay_gate_pass: "Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)"
          - security_sensitive_fix_scope: "Boolean true when the review is a security-sensitive fix rerun"
          - fix_completeness_replay_required_rows: "Count of closed-gate replay rows required before STOP"
          - fix_completeness_replay_passing_rows: "Count of required closed-gate replay rows that passed with evidence"
          - candidate_coverage_gate_pass: "Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)"
          - candidate_coverage_search_debt_json: "JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence"
          - candidate_coverage_missing_json: "JSON array of required bug classes missing from candidateCoverage.covered"
          - graphless_fallback_gate_pass: "Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)"
          - graphless_fallback_mode: "Latest reducer-owned searchCoverage.graphCoverageMode value"
          - graphless_fallback_missing_json: "JSON array of required bug classes missing cited fallback ledger rows"
          - graphless_fallback_unavailability_reason: "Explicit unavailability reason when graphCoverageMode == unavailable_blocked"
          - graph_decision: "CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence"
          - graph_signals_json: "JSON object returned by graph convergence"
          - graph_blockers_json: "JSON array of graph blockers"
          - graph_blockers_csv: "Comma-separated graph blocker summary"
          - recovery_strategy: "One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY"

      step_emit_blocked_stop:
        action: "Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP"
        if_blocked:
          append_jsonl: '{"type":"event","event":"blocked_stop","mode":"review","run":{current_iteration},"blockedBy":{blocked_by_json},"gateResults":{"convergenceGate":{"pass":{convergence_gate_pass},"score":{convergence_gate_score}},"dimensionCoverageGate":{"pass":{dimension_coverage_gate_pass},"covered":{dimension_coverage_gate_covered_json},"missing":{dimension_coverage_gate_missing_json}},"p0ResolutionGate":{"pass":{p0_resolution_gate_pass},"activeP0":{active_p0_count}},"evidenceDensityGate":{"pass":{evidence_density_gate_pass},"avgEvidencePerFinding":{avg_evidence_per_finding}},"hotspotSaturationGate":{"pass":{hotspot_saturation_gate_pass}},"claimAdjudicationGate":{"pass":{claim_adjudication_gate_pass},"activeP0P1":{claim_adjudication_active_count}},"fixCompletenessReplayGate":{"pass":{fix_completeness_replay_gate_pass},"securitySensitive":{security_sensitive_fix_scope},"requiredRows":{fix_completeness_replay_required_rows},"passingRows":{fix_completeness_replay_passing_rows}},"candidateCoverageGate":{"pass":{candidate_coverage_gate_pass},"searchDebt":{candidate_coverage_search_debt_json},"missing":{candidate_coverage_missing_json}},"graphlessFallbackGate":{"pass":{graphless_fallback_gate_pass},"mode":"{graphless_fallback_mode}","missing":{graphless_fallback_missing_json},"unavailabilityReason":"{graphless_fallback_unavailability_reason}"}},"graphBlockerDetail":{graph_blockers_json},"recoveryStrategy":"{recovery_strategy}","timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}'
          log: "Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}"
        if_not_blocked:
          proceed: true

      step_handle_convergence:
        action: "Act on convergence decision"
        if_stop:
          branch_on: "convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'"
          if_divergent_eligible:
            eligibility_contract:
              required_decision: "STOP"
              eligible_reasons: [all_dimensions_clean]
              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]
              fail_closed: "Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged."
            steps:
              step_prepare_divergent_pivot:
                action: "Generate state-grounded read-only review candidates and prepare or resume the pivot transaction"
                command: |
                  node --experimental-strip-types --input-type=module <<'EOF'

hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "sed -n '780,1220p' .opencode/commands/deep/assets/deep-review-auto.yaml" in /Users/michelkerkmeester/MEGA/Development/Code_Environment/Public
 succeeded in 0ms:
                  node --experimental-strip-types --input-type=module <<'EOF'
                  import {
                    buildReviewPivotPreparationInput,
                    renderReviewPivotSeatPrompt,
                  } from './.opencode/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';
                  import {
                    preparePivotTransaction,
                  } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';

                  const input = buildReviewPivotPreparationInput({
                    artifactRoot: '{state_paths.packet_dir}',
                    configPath: '{state_paths.config}',
                    stateLogPath: '{state_paths.state_log}',
                    strategyPath: '{state_paths.strategy}',
                    registryPath: '{state_paths.findings_registry}',
                    currentIteration: Number('{current_iteration}'),
                    maxIterations: Number('{max_iterations}'),
                    triggerReason: '{reason}',
                  });
                  const prepared = await preparePivotTransaction(input);
                  const seatPrompts = prepared.status === 'pending'
                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [
                        seat.id,
                        renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),
                      ]))
                    : {};
                  process.stdout.write(`${JSON.stringify({
                    ...prepared,
                    seatPrompts,
                    boundaryRejections: input.boundaryRejections,
                  })}\n`);
                  EOF
                working_directory: "{repo_root}"
                outputs:
                  - pivot_prepare_json: "The complete parsed JSON result"
                  - pivot_prepare_status: "status from the prepare result"
                  - pivot_id: "pivotId from the prepare result"
                  - pivot_paths_json: "paths from the prepare result as JSON"
                  - pivot_resumed: "resumed from the prepare result"
                  - pivot_missing_seat_ids: "missingSeats ids from a pending result"
                  - pivot_seat_001_json: "The seat-001 mandate object from missingSeats"
                  - pivot_seat_002_json: "The seat-002 mandate object from missingSeats"
                  - pivot_seat_003_json: "The seat-003 mandate object from missingSeats"
                  - pivot_seat_001_prompt: "seatPrompts['seat-001']"
                  - pivot_seat_002_prompt: "seatPrompts['seat-002']"
                  - pivot_seat_003_prompt: "seatPrompts['seat-003']"
                  - pivot_dispatch_context_json: "dispatchContext from a pending result as JSON"
                short_circuit: "When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result."

              step_dispatch_pivot_seat_001:
                action: "Natively dispatch the analytical read-only review direction-selection seat"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'"
                capture_timing: true
                if_native:
                  dispatch:
                    agent: deep-review
                    model: opus
                    context_source: "pivot_seat_001_prompt"
                  wait_for_completion: true
                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001."
                outputs:
                  - pivot_seat_001_dispatch_status: "fulfilled or rejected"
                  - pivot_seat_001_output_json: "Raw native return serialized as JSON when fulfilled"
                  - pivot_seat_001_error_json: "{name,message} when rejected"
                  - pivot_seat_001_started_at_iso: "Dispatch start timestamp"
                  - pivot_seat_001_completed_at_iso: "Dispatch completion timestamp"
                  - pivot_seat_001_duration_ms: "Dispatch duration in milliseconds"

              step_record_pivot_seat_001:
                action: "Durably record the seat-001 native dispatch outcome"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'"
                command: |
                  node --experimental-strip-types --input-type=module <<'EOF'
                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  const status = '{pivot_seat_001_dispatch_status}';
                  const outcome = status === 'fulfilled'
                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }
                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };
                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\n`);
                  EOF
                working_directory: "{repo_root}"

              step_dispatch_pivot_seat_002:
                action: "Natively dispatch the critical read-only review direction-selection seat"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'"
                capture_timing: true
                if_native:
                  dispatch:
                    agent: deep-review
                    model: opus
                    context_source: "pivot_seat_002_prompt"
                  wait_for_completion: true
                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002."
                outputs:
                  - pivot_seat_002_dispatch_status: "fulfilled or rejected"
                  - pivot_seat_002_output_json: "Raw native return serialized as JSON when fulfilled"
                  - pivot_seat_002_error_json: "{name,message} when rejected"
                  - pivot_seat_002_started_at_iso: "Dispatch start timestamp"
                  - pivot_seat_002_completed_at_iso: "Dispatch completion timestamp"
                  - pivot_seat_002_duration_ms: "Dispatch duration in milliseconds"

              step_record_pivot_seat_002:
                action: "Durably record the seat-002 native dispatch outcome"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'"
                command: |
                  node --experimental-strip-types --input-type=module <<'EOF'
                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  const status = '{pivot_seat_002_dispatch_status}';
                  const outcome = status === 'fulfilled'
                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }
                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };
                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\n`);
                  EOF
                working_directory: "{repo_root}"

              step_dispatch_pivot_seat_003:
                action: "Natively dispatch the pragmatic read-only review direction-selection seat"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'"
                capture_timing: true
                if_native:
                  dispatch:
                    agent: deep-review
                    model: opus
                    context_source: "pivot_seat_003_prompt"
                  wait_for_completion: true
                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003."
                outputs:
                  - pivot_seat_003_dispatch_status: "fulfilled or rejected"
                  - pivot_seat_003_output_json: "Raw native return serialized as JSON when fulfilled"
                  - pivot_seat_003_error_json: "{name,message} when rejected"
                  - pivot_seat_003_started_at_iso: "Dispatch start timestamp"
                  - pivot_seat_003_completed_at_iso: "Dispatch completion timestamp"
                  - pivot_seat_003_duration_ms: "Dispatch duration in milliseconds"

              step_record_pivot_seat_003:
                action: "Durably record the seat-003 native dispatch outcome"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'"
                command: |
                  node --experimental-strip-types --input-type=module <<'EOF'
                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  const status = '{pivot_seat_003_dispatch_status}';
                  const outcome = status === 'fulfilled'
                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }
                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };
                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\n`);
                  EOF
                working_directory: "{repo_root}"

              step_finalize_divergent_pivot:
                action: "Finalize the prepared pivot after all missing native seats are durable"
                skip_when: "pivot_prepare_status != 'pending'"
                command: |
                  node --experimental-strip-types --input-type=module <<'EOF'
                  import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\n`);
                  EOF
                working_directory: "{repo_root}"
                outputs:
                  - pivot_finalize_json: "The complete parsed final result"

              step_resolve_divergent_pivot_result:
                action: "Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result"
                branch_on: "pivot_prepare_status"
                if_pending: { bind: { pivot_result: "{pivot_finalize_json}" } }
                if_completed_or_failed: { bind: { pivot_result: "{pivot_prepare_json}" } }

              step_apply_divergent_pivot_result:
                action: "Adopt a successful read-only review direction or fail closed to the existing synthesis path"
                branch_on: "pivot_result.status"
                if_completed:
                  set:
                    next_dimension: "{pivot_result.restoredFocus}"
                    pivot_lineage: "Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}."
                    saturated_directions: "{pivot_result.completedEvent.saturatedDirections}"
                  command: "node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors"
                  log: "Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}."
                  proceed_to: step_normalize_pause_events
                if_failed:
                  log: "Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis."
                  skip_to: phase_synthesis
            on_error:
              log: "Divergent review pivot integration error; failing closed to the existing synthesis path."
              skip_to: phase_synthesis
          if_existing_terminal_path:
            log: "Loop stopping. Reason: {reason}"
            skip_to: phase_synthesis
        if_blocked:
          log: "Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review."
        if_stuck_recovery:
          log: "Stuck detected ({stuck_count} consecutive no-progress). Entering recovery."
          recovery_strategies:
            - "Change granularity: file-level → function-level → line-level review"
            - "Traceability protocol replay: re-run unresolved core or overlay checks"
            - "Escalate severity review: re-examine P2 findings for potential P1 upgrades"
          pivot_target: "Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio)."
          set:
            next_dimension: "RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}"
            pending_stop_event: "stuck_recovery"
            pending_stop_reason: "stuckRecovery"
            pending_stop_detail: "Recovery path activated after repeated no-progress iterations"
          reset: { stuck_count: 0 }
        if_continue:
          log: "Iteration {current_iteration}: Continuing. Dimension: {next_dimension}"

      step_normalize_pause_events:
        action: "Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused"
        if_pending_pause_event:
          append_jsonl: '{"type":"event","event":"userPaused","mode":"review","stopReason":"userPaused","reason":"{pending_stop_detail}","timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}'
          message: "Review paused. Delete review/.deep-review-pause to resume."
          reset:
            pending_stop_event: null
            pending_stop_reason: null
            pending_stop_detail: null
          halt: true
        if_pending_stuck_recovery:
          append_jsonl: '{"type":"event","event":"stuckRecovery","mode":"review","stopReason":"stuckRecovery","fromIteration":{current_iteration},"strategy":"{recovery_strategy}","targetDimension":"{least_explored}","outcome":"pending","reason":"{pending_stop_detail}","timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}'
          reset:
            pending_stop_event: null
            pending_stop_reason: null
            pending_stop_detail: null
        if_no_pending_event:
          proceed: true

      step_generate_state_summary:
        action: "Generate compact state summary for dispatch context (~200 tokens)"
        generate: |
          STATE SUMMARY (auto-generated):
          Iteration: {current_iteration} of {max_iterations}
          Dimension: {next_dimension}
          Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}
          Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})
          Traceability: core={core_protocol_status} overlay={overlay_protocol_status}
          {resource_map_prompt_line}
          Coverage Age: {coverage_age}
          Last 2 ratios: {ratio_prev} -> {ratio_latest}
          Stuck count: {stuck_count}
          Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}

      step_marker_scan:
        action: "H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker"
        algorithm: |
          if current_iteration > 1:
            PREV_PROMPT_PATH = "{state_paths.prompt_dir}/iteration-{previous_iteration}.md"
            if file_exists(PREV_PROMPT_PATH):
              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH
              if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:
                log "ERROR: nested review-of-review loop detected (marker found in previous iteration prompt). Aborting."
                halt with exit code 2
        note: |
          False-positive prevention: only matches when the first line is exactly one of the
          three canonical markers. Markers appearing in comments or body text are ignored.
          True-positive triggers only when a previous iteration's rendered prompt literally
          starts with a deep-loop marker, indicating a nested review-of-review dispatch.

      step_dispatch_iteration:
        action: "Dispatch @deep-review agent for one review iteration"
        resolve_executor:
          source: "config.executor"
          loader: ".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig"
        pre_dispatch:
          generate_summary: |
            STATE SUMMARY (auto-generated):
            Iteration: {current_iteration} of {max_iterations}
            Dimension: {next_dimension}
            Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}
            Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})
            Traceability: core={core_protocol_status} overlay={overlay_protocol_status}
            {resource_map_prompt_line}
            Coverage Age: {coverage_age}
            Last 2 ratios: {ratio_prev} -> {ratio_latest}
            Stuck count: {stuck_count}
            Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}
          render_prompt_pack:
            template_path: ".opencode/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl"
            renderer: ".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack"
            output_path: "{state_paths.prompt_dir}/iteration-{current_iteration}.md"
            variables:
              state_summary: "{state_summary}"
              current_iteration: "{current_iteration}"
              max_iterations: "{max_iterations}"
              next_dimension: "{next_dimension}"
              review_target: "{review_target}"
              review_scope_files: "{review_scope_files}"
              p0_count: "{p0_count}"
              p1_count: "{p1_count}"
              p2_count: "{p2_count}"
              pivot_lineage: "{pivot_lineage}"
              saturated_directions: "{saturated_directions}"
              state_paths_config: "{state_paths.config}"
              state_paths_state_log: "{state_paths.state_log}"
              state_paths_findings_registry: "{state_paths.findings_registry}"
              state_paths_strategy: "{state_paths.strategy}"
              state_paths_iteration_pattern: "{state_paths.iteration_pattern}"
              state_paths_delta_pattern: "{state_paths.delta_pattern}"
        pre_dispatch_audit:
          skip_when: "config.executor.kind == 'native'"
          call: ".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor"
          args:
            stateLogPath: "{state_paths.state_log}"
            executor: "{config.executor}"
            iteration: "{current_iteration}"
        branch_on: "config.executor.kind"
        if_native:
          dispatch:
            agent: deep-review
            model: opus
            context_source: "rendered_prompt_pack"
          wait_for_completion: true
        if_cli_copilot:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync, writeFileSync } from 'node:fs';
            import { createHash } from 'node:crypto';

            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { buildCopilotPromptArg } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';

            const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';
            const prompt = readFileSync(promptPath, 'utf8');

            // Workflow-resolved spec folder is the only legal write authority.
            // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)
            // is the single source of truth for rejecting empty / unresolved
            // template / whitespace-only / string-coerced empty values. The
            // YAML hands the raw `{spec_folder}` directly; on rejection the
            // helper safe-fails to `type:"missing", writeIntent:true` (Gate-3
            // enforcement, --allow-all-tools stripped).
            const specFolderRaw = '{spec_folder}';
            const targetAuthority = { type: 'approved', specFolder: specFolderRaw };

            const baseArgs = [
              '-p',
              prompt,
              '--model',
              '{config.executor.model}',
              '--allow-all-tools',
              '--no-ask-user',
            ];

            const built = buildCopilotPromptArg({
              promptPath,
              prompt,
              targetAuthority,
              baseArgv: baseArgs,
            });

            // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`
            // containing `<TARGET AUTHORITY preamble>\n\n---\n\n<original>`.
            // Write it to disk so the file Copilot reads via @path opens with
            // the authority block. Without this, recovered/bootstrap folder
            // mentions inside the file could still anchor the model.
            if (built.promptFileBody !== undefined) {
              writeFileSync(promptPath, built.promptFileBody, 'utf8');
            }

            // Copilot is routed through the audited executor wrapper so it produces
            // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode
            // There is no cli-copilot kind in the executor schema, so it
            // dispatches as kind:'native' (full env passthrough, no recursion-guard
            // layer configured for copilot); the receipt still records the real
            // 'copilot' command + built.argv as facts.
            const dispatchFacts = {
              command: 'deep/review',
              mode: 'review',
              specFolder: '{spec_folder}',
              artifactDir: '{state_paths.packet_dir}',
              iteration: Number('{current_iteration}'),
              executorKind: '{config.executor.kind}',
              branchId: '{config.executor.kind}',
              sessionId: '{session_id}',
              generation: Number('{generation}'),
            };
            const dispatchId = 'review-i{current_iteration}-g{generation}';
            process.exit(
              runAuditedExecutorCommand({
                command: 'copilot',
                args: built.argv,
                cwd: '{repo_root}',
                timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
                stateLogPath: '{state_paths.state_log}',
                executor: {
                  kind: 'native',
                  model: '{config.executor.model}',
                  configDir: null,
                  reasoningEffort: null,
                  serviceTier: null,
                  sandboxMode: null,
                  timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
                  governor: null,
                },
                iteration: Number('{current_iteration}'),
                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
                dispatchId,
              }),
            );
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "Routed through runAuditedExecutorCommand so copilot produces INTENT + COMPLETION dispatch receipts; built.argv (@PROMPT_PATH or positional) is forwarded verbatim as the receipt facts"
            - "copilot has no stdin support; prompt is positional"
            - "Size check uses 16KB threshold; above that uses @PROMPT_PATH wrapper prompt"
            - "Large-prompt path relies on copilot honoring @path references within its prompt string"
            - "buildCopilotPromptArg attaches a TARGET AUTHORITY preamble bound to the workflow-approved spec folder; recovered context cannot override it (authority guard source: .opencode/commands/speckit/assets/speckit_deep-review_auto.yaml)"
            - "If spec_folder is missing/malformed/unresolved on a write-intent dispatch, the helper enforces plan-only by replacing the prompt with a Gate-3 question and stripping --allow-all-tools"
            - "Large-prompt wrapper mode rewrites the prompt file at promptPath to include the TARGET AUTHORITY preamble (prefix + divider + original body); the argv becomes a bare @promptPath reference"
        if_cli_claude_code:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createHash } from 'node:crypto';

            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';

            const configDir = '{optional_claude_config_dir}';
            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';
            const executor = {
              kind: 'cli-claude-code',
              model: '{config.executor.model}',
              configDir: configDir || null,
              reasoningEffort,
              serviceTier: null,
              sandboxMode: null,
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
              governor: null,
            };
            const args = [
              '-p',
              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),
              '--model',
              executor.model,
              '--permission-mode',
              'acceptEdits',
              '--output-format',
              'text',
            ];
            if (executor.reasoningEffort) {
              args.push('--effort', executor.reasoningEffort);
            }


hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "sed -n '1420,2010p' .opencode/commands/deep/assets/deep-review-auto.yaml" in /Users/michelkerkmeester/MEGA/Development/Code_Environment/Public
 succeeded in 0ms:
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv"
            - "Fail closed before dispatch unless the rendered containment sections exist, --dir is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir both by name and after every path component is resolved through symlinks; append the recovery-baseline commit to state_log"
            - "input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)"
            - "opencode run takes a positional message; prompt is the route-proof preamble + iteration body"
            - "--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)"
            - "--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)"
            - "cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate"
        if_cli_codex:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { execFileSync } from 'node:child_process';

            import {
              RECURSION_GUARD_EXIT_CODE,
              formatRecursionGuardRefusal,
              runAuditedExecutorCommand,
              validateExecutorDispatchAllowed,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // Fail closed: a requested codex executor must dispatch codex or abort,
            // never silently degrade to another executor. Undetected absence is what
            // got Codex deprecated before, so the branch exits non-zero when the
            // binary is missing instead of falling through to a native/other path.
            let codexAvailable = false;
            try {
              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });
              codexAvailable = true;
            } catch {}
            if (!codexAvailable) {
              console.error('cli-codex executor unavailable: command -v codex failed');
              process.exit(1);
            }

            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';
            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const executor = {
              kind: 'cli-codex',
              model,
              configDir: null,
              reasoningEffort,
              serviceTier,
              sandboxMode: 'workspace-write',
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
              governor: null,
            };

            // Refuse before any spawn and before any receipt is written, so a refusal can
            // never be mistaken for a real attempt. A process that is already a CLI lineage
            // or a codex session must run the iteration itself, not delegate it onward.
            const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });
            if (!guardVerdict.allowed) {
              console.error(formatRecursionGuardRefusal(guardVerdict, executor));
              process.exit(RECURSION_GUARD_EXIT_CODE);
            }

            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');

            // codex reads the iteration prompt from stdin via the trailing '-'. A review
            // iteration must WRITE its own iteration file, delta and state record, so the
            // sandbox is workspace-write — read-only would block those required writes.
            // approval_policy=never keeps the run non-interactive.
            const args = ['exec'];
            if (model) {
              args.push('--model', model);
            }
            args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));
            if (serviceTier) {
              args.push('-c', 'service_tier=' + serviceTier);
            }
            args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');

            const dispatchId = 'review-i{current_iteration}-g{generation}';
            const repoRoot = '{repo_root}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command: 'codex',
              args,
              cwd: repoRoot,
              timeoutSeconds: executor.timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input: promptBody,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            // Structural write-containment: a workspace-write codex leaf can write
            // anywhere in the repo. Revert any NEW out-of-artifact-dir change it
            // made, append a containment_violation event to the state log, and
            // fail the iteration fail-closed. The leaf's own writes under
            // artifactDir (iteration file/delta/state record) are never flagged.
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the review pass yourself, and write the iteration file, the delta and the state record exactly as the leaf contract requires, then continue to post_dispatch_validate."
            - "Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure."
            - "Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv"
            - "Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native"
            - "codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured"
            - "--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies"
        if_cli_cursor:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.kind}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'review-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native"
        if_cli_devin:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.kind}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'review-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native"
        if_cli_pi:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.kind}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'review-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native"
        post_dispatch_validate:
          validator: ".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs"
          command: "node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}"
          command_note: "Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|iteration_verdict_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once."
          assert_exists: "{state_paths.iteration_pattern}"
          assert_appended: "{state_paths.state_log}"
          assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]
          route_proof:
            mode: review
            target_agent: deep-review
            agent_definition_loaded: true
            resolved_route: "Resolved route: mode=review target_agent=deep-review"
          dispatchReceipt:
            receiptDir: "{state_paths.packet_dir}/dispatch-receipts"
            dispatchId: "review-i{current_iteration}-g{generation}"
          assert_canonical_type: "iteration"
          assert_delta_file_exists: "{state_paths.delta_pattern}"
          assert_delta_file_has_iteration_record: true
          failure_reasons:
            - iteration_file_missing
            - iteration_file_empty
            - jsonl_not_appended
            - jsonl_missing_fields
            - jsonl_parse_error
            - jsonl_wrong_type
            - delta_file_missing
            - delta_file_empty
            - delta_file_missing_iteration_record
            - executor_missing
            - dispatch_failure_logged
            - v2_missing_ledger
            - v2_uncited_ledger_row
            - v2_broken_linked_finding
            - v2_shallow_finding_details
            - delta_iteration_id_mismatch
            - state_delta_iteration_mismatch
            - route_proof_missing
            - route_proof_mismatch
          warning_surface:
            source: "result.warnings"
            action: "emit schema_advisory canonical conflict event"
            severity: "advisory"
            event_shape: '{"type":"event","event":"schema_advisory","mode":"review","iteration":{current_iteration},"warnings":{result.warnings},"severity":"advisory","timestamp":"{ISO_8601_NOW}"}'
            note: "Warnings do not fail dispatch. Hard failures still emit schema_mismatch through on_failure."
          on_failure:
            action: "emit schema_mismatch canonical conflict event"
            redispatch_once: "On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error (per step_evaluate_results.on_missing_outputs) and continue. Never re-dispatch a given iteration more than once."
            escalation: "After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context"
        record_executor_audit:
          skip_when: "config.executor.kind == 'native'"
          target: "{state_paths.state_log}"
          field: "executor"
          value:
            kind: "{config.executor.kind}"
            model: "{config.executor.model}"
            reasoningEffort: "{config.executor.reasoningEffort}"
            serviceTier: "{config.executor.serviceTier}"

      step_evaluate_results:
        action: "Verify iteration outputs and extract metrics"
        verify:
          - file_exists: "{state_paths.iteration_pattern}"
          - jsonl_appended: "New iteration record in state.jsonl"
          - strategy_updated: "Strategy.md has been modified"
        extract:
          - newFindingsRatio: "From latest JSONL iteration record"
          - findings_count: "From latest JSONL iteration record"
          - severity_counts: "From latest JSONL iteration record (P0, P1, P2)"
          - dimensions: "From latest JSONL iteration record"
          - files_reviewed: "From latest JSONL iteration record"
          - status: "From latest JSONL iteration record"
          - reviewed_artifacts: "From latest JSONL iteration record"
          - traceability_checks: "From latest JSONL iteration record when present"
        on_missing_outputs:
          action: "Mark iteration as 'error', continue to next"
          # Canonical iteration record: include sessionId, generation, durationMs so the reducer can persist
          # the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.
          command: |
            cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}
            {"type":"iteration","iteration":{current_iteration},"run":{current_iteration},"mode":"review","status":"error","focus":"{next_dimension}","dimensions":["{next_dimension}"],"filesReviewed":[],"findingsCount":0,"findingsSummary":{"P0":0,"P1":0,"P2":0},"findingsNew":{"P0":0,"P1":0,"P2":0},"findingDetails":[],"traceabilityChecks":{"summary":{"required":0,"executed":0,"pass":0,"partial":0,"fail":0,"blocked":0,"notApplicable":0,"gatingFailures":0},"results":[]},"newFindingsRatio":0.0,"durationMs":0,"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation},"lineageMode":"{config.lineage.lineageMode}"}
            DEEP_LOOP_STATE_RECORD

      step_post_iteration_claim_adjudication:
        action: "Validate typed claim-adjudication packets for any new P0/P1 findings and persist the result to state.jsonl so the next iteration's claimAdjudicationGate can read it"
        verify:
          - typed_packets_present: "Every new P0/P1 finding in review/iterations/iteration-{NNN}.md contains a claim-adjudication JSON block"
          - packet_fields: "Each packet includes claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger"
          - missing_packet_ids: "List of new P0/P1 finding IDs that are missing a typed packet or field; empty array when all packets validate"
        on_pass:
          set:
            claim_adjudication_passed: true
          # Append via the deterministic stdin helper, never an edit/patch tool:
          # the state log holds multi-KB single-line records that a context-matched
          # apply_patch cannot anchor on (it halts the loop). See append-state-record.cjs.
          command: |
            cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}
            {"type":"event","event":"claim_adjudication","mode":"review","run":{current_iteration},"passed":true,"activeP0P1":{active_p0_p1_count},"missingPackets":[],"timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}
            DEEP_LOOP_STATE_RECORD
          log: "Claim adjudication passed for iteration {current_iteration}. All new P0/P1 findings have typed packets."
        on_fail:
          action: "Mark the iteration as invalid for convergence. The next iteration's claimAdjudicationGate (step_check_convergence step 0) reads the persisted `passed: false` event and vetoes STOP until a follow-up iteration rewrites the packets."
          set:
            claim_adjudication_passed: false
          command: |
            cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}
            {"type":"event","event":"claim_adjudication","mode":"review","run":{current_iteration},"passed":false,"activeP0P1":{active_p0_p1_count},"missingPackets":{missing_packet_ids},"reason":"Missing typed packet fields for new P0/P1 findings","timestamp":"{ISO_8601_NOW}","sessionId":"{session_id}","generation":{generation}}
            DEEP_LOOP_STATE_RECORD
          log: "Claim adjudication incomplete for new P0/P1 findings. Event persisted. The next iteration's step_check_convergence claim-adjudication pre-check will veto STOP while `passed: false` remains the latest event and active P0/P1 > 0."

      step_reduce_review_state:
        action: "Run reducer to refresh the canonical findings registry before dashboard generation"
        command: "node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.iteration_pattern}"
          - "{state_paths.findings_registry}"
          - "{state_paths.strategy}"
        write:
          - "{state_paths.findings_registry}"
          - "{state_paths.dashboard}"
          - "{state_paths.strategy}"
        failure_modes:
          malformed_delta: "skip + warn"
          missing_iteration_file: "no-op + error"
          schema_mismatch: "reject + conflict event"
        guarantee: "Idempotent for identical inputs"
        note: "Reducer outputs findingsRegistry, dashboardMetrics, and strategyUpdates. Re-running the same inputs must be idempotent."

      step_graph_upsert:
        action: "Project canonical review coverage plus optional graphEvents into graph nodes and edges, then upsert it"
        read:
          - "{state_paths.config}"
          - "{state_paths.state_log}"
          - "{state_paths.findings_registry}"
        transform: |
          1. Read the latest iteration JSONL record after reducer completion.
          2. Seed one stable DIMENSION node for every configured review dimension, falling back to correctness, security, traceability, and maintainability.
          3. Seed one stable FILE node for every latest-record filesReviewed entry and emit a COVERS edge from each latest-record dimension to each reviewed file.
          4. Merge optional graphEvents nodes after normalizing type = uppercase(event.kind || event.nodeKind || event.type); keep only DIMENSION, FILE, FINDING, EVIDENCE, REMEDIATION, BUG_CLASS, INVARIANT, PRODUCER, CONSUMER, TEST.
          5. Merge optional graphEvents edges after normalizing relation = uppercase(event.relation); keep only COVERS, EVIDENCE_FOR, CONTRADICTS, RESOLVES, CONFIRMS, ESCALATES, IN_DIMENSION, IN_FILE.
          6. Emit nodes as { id, type, name, iteration, metadata } and edges as { id, relation, sourceId, targetId, metadata }, deduplicated by id.
          7. Discard malformed or unknown optional events without discarding canonical dimension and file coverage.
        bash: "node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \"{spec_folder}\" --loop-type \"review\" --session-id \"{session_id}\" --nodes '{graph_nodes_json}' --edges '{graph_edges_json}'"
        note: "Invoke the runtime script directly. Canonical iteration fields provide baseline coverage; graphEvents add richer evidence."
        outputs:
          - graph_nodes_json: "JSON array of canonical and optional review graph nodes"
          - graph_edges_json: "JSON array of canonical and optional review graph edges"

      step_generate_dashboard:
        action: "Generate or refresh the review dashboard"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.findings_registry}"
          - "{state_paths.strategy}"
        content: |
          # Deep Review Dashboard - Session Overview

          Auto-generated from JSONL state log and strategy file. Regenerated after every iteration evaluation.

          ## Status
          - Review Target: {review_target} ({review_target_type})
          - Status: [ITERATING | CONVERGING | STUCK_RECOVERY | COMPLETE]
          - Iteration: {current_iteration} of {max_iterations}
          - Provisional Verdict: [PASS | CONDITIONAL | FAIL | PENDING]
          - hasAdvisories: {has_advisories}

          ## Findings Summary
          | Severity | Count | Trend |
          |----------|------:|-------|
          | P0 (Blockers) | {p0_count} | {p0_trend} |
          | P1 (Required) | {p1_count} | {p1_trend} |
          | P2 (Suggestions) | {p2_count} | {p2_trend} |

          ## Dimension Coverage
          | Dimension | Status | Iteration | Findings |
          |-----------|--------|-----------|----------|
          | [per dimension from strategy + JSONL] |

          ## Traceability Coverage
          | Protocol | Level | Status | Findings |
          |----------|-------|--------|----------|
          | [per protocol from traceabilityChecks] |

          ## Progress
          | # | Dimension | Ratio | P0/P1/P2 | Status |
          |---|-----------|-------|----------|--------|
          | [per iteration from JSONL] |

          ## Trend

