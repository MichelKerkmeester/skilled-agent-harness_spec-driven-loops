\n  '--state-log': 'stateLog',\n  '--registry': 'registry',\n  '--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n\nconst PATH_FLAGS = Object.freeze([\n  ['eventDir', '--event-dir'],\n  ['artifactDir', '--artifact-dir'],\n  ['stateLog', '--state-log'],\n  ['registry', '--registry'],\n  ['output', '--output'],\n  ['dashboard', '--dashboard'],\n]);\n\n// ───────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv) {\n  const args = {};\n  for (let index = 0; index < argv.length; index += 1) {\n    const token = argv[index];\n    if (!Object.prototype.hasOwnProperty.call(FLAG_KEYS, token)) {\n      throw new Error(token.startsWith('--') ? `unknown flag: ${token}` : `unknown argument: ${token}`);\n    }\n=== args ===\n45:  '--artifact-dir': 'artifactDir',\n46:  '--state-log': 'stateLog',\n47:  '--registry': 'registry',\n48:  '--output': 'output',\n49:  '--dashboard': 'dashboard',\n50:  '--stop-reason': 'stopReason',\n53:  '--active-p0': 'activeP0',\n56:  '--dimension-coverage': 'dimensionCoverage',\n57:  '--verdict': 'verdict',\n63:  ['artifactDir', '--artifact-dir'],\n64:  ['stateLog', '--state-log'],\n65:  ['registry', '--registry'],\n66:  ['output', '--output'],\n67:  ['dashboard', '--dashboard'],\n104:    throw new Error('missing required flag: --stop-reason');\n109:      ['activeP0', '--active-p0'],\n112:      ['dimensionCoverage', '--dimension-coverage'],\n113:      ['verdict', '--verdict'],\n224:function registryEvidence(mode, registry) {\n226:    const present = Array.isArray(registry?.keyFindings);\n228:      registryFindingCount: present ? countDistinctFindings(registry.keyFindings) : null,\n229:      keys: present ? registry.keyFindings.flatMap(findingKeys) : [],\n230:      missingCode: 'registry_missing_keyFindings',\n233:  const openFindings = Array.isArray(registry?.openFindings) ? registry.openFindings : null;\n234:  const registryFindings = [registry?.openFindings, registry?.resolvedFindings, registry?.repeatedFindings]\n238:    registryFindingCount: openFindings === null ? null : countDistinctFindings(registryFindings),\n239:    keys: registryFindings.flatMap(findingKeys),\n240:    missingCode: 'registry_missing_openFindings',\n258:// from the state-log path it was handed.\n295:  const registry = readJson(args.registry);\n296:  const evidence = registryEvidence(mode, registry);\n311:  const registryFindingKeys = new Set(evidence.keys);\n313:    .filter((keys) => !keys.some((key) => registryFindingKeys.has(key)));\n320:  // The root dashboard is a single-executor artifact. Fan-out stores one\n323:    ['registry', args.registry],\n324:    [mode, args.output],\n325:    ...(lineageLogs.length > 0 ? [] : [['dashboard', args.dashboard]]),\n331:  if (evidence.registryFindingCount === null) invariantFailures.push(evidence.missingCode);\n332:  if (iterationFindingCount > 0 && (evidence.registryFindingCount ?? 0) === 0) {\n333:    invariantFailures.push('state_findings_not_reflected_in_registry');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Synthesis Close-Out\n// ───────────────────────────────────────────────────────────────────\n\n// ───────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\nconst {\n  existsSync,\n  lstatSync,\n  readdirSync,\n  readFileSync,\n  realpathSync,\n  writeFileSync,\n} = require('node:fs');\nconst {\n  basename,\n  dirname,\n  isAbsolute,\n  join,\n  relative,\n  resolve,\n  sep,\n} = require('node:path');\nconst { latestIterationRecords, findingKeys } = require('../lib/deep-loop/iteration-findings.cjs');\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n// Per-mode structured finding fields, in the order a record is searched.\nconst FINDING_FIELDS = Object.freeze({\n  research: Object.freeze(['keyFindings', 'findings']),\n  review: Object.freeze(['findingDetails']),\n});\n\nconst FLAG_KEYS = Object.freeze({\n  '--mode': 'mode',\n  '--event-dir': 'eventDir',\n  '--artifact-dir': 'artifactDir',\n  '--state-log': 'stateLog',\n  '--registry': 'registry',\n  '--output': 'output',\n  '--dashboard': 'dashboard',\n  '--stop-reason': 'stopReason',\n  '--answered-count': 'answeredCount',\n  '--total-questions': 'totalQuestions',\n  '--active-p0': 'activeP0',\n  '--active-p1': 'activeP1',\n  '--active-p2': 'activeP2',\n  '--dimension-coverage': 'dimensionCoverage',\n  '--verdict': 'verdict',\n  '--release-readiness-state': 'releaseReadinessState',\n});\n\nconst PATH_FLAGS = Object.freeze([\n  ['eventDir', '--event-dir'],\n  ['artifactDir', '--artifact-dir'],\n  ['stateLog', '--state-log'],\n  ['registry', '--registry'],\n  ['output', '--output'],\n  ['dashboard', '--dashboard'],\n]);\n\n// ───────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv) {\n  const args = {};\n  for (let index = 0; index < argv.length; index += 1) {\n    const token = argv[index];\n    if (!Object.prototype.hasOwnProperty.call(FLAG_KEYS, token)) {\n      throw new Error(token.startsWith('--') ? `unknown flag: ${token}` : `unknown argument: ${token}`);\n    }\n=== args ===\n45:  '--artifact-dir'