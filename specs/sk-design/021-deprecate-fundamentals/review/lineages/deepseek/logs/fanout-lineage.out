.json .skilled/skills/sk-code/leaf-manifest.json .skilled/skills/sk-code/sk-code-frontend/SKILL.md .skilled/skills/sk-code/sk-code-frontend/ROUTER.md .skilled/skills/sk-design/sk-design-chart/SKILL.md; do printf \\\"%s: \\\" \\\"$f\\\"; grep -m1 -o '\\\"version\\\": *\\\"[^\\\"]*\\\"\\\\|^version: .*' \\\"$f\\\" | head -1; done\"}"},"time":{"start":1793873118926,"end":1793873120226}}}}
