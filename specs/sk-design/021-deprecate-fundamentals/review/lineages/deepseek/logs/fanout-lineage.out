CLI lineage whose state log has rows while its ledger has none.\n929: * so a lineage that ran the workflow leaves at least one ledger record behind\n932: * to explain it. Native lineages run the workflow through the command host and\n935:function findUnledgeredStateLog({ loopType, lineage, lineageDir, stateRead }) {\n936:  if (lineage.kind === 'native') return null;\n938:  const frames = countLineageLedgerFrames(loopType, lineageDir);\n943:    + 'holds no records: the lineage wrote its state log without the append gateway';\n946:function findMissingLineageStateLog(loopType, lineageDir) {\n947:  const stateLogPath = requiredLineageStateLogPath(loopType, lineageDir);\n962:function lineageStateLogName(loopType) {\n966:function readLineageStateRecords(loopType, lineageDir) {\n967:  const stateLogName = lineageStateLogName(loopType);\n971:  const statePath = path.join(lineageDir, stateLogName);\n987:// Registry file a settled lineage is expected to have written, per loop type. Research also\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/316-deprecate-design-fundamentals && grep -n \\\"FANOUT_LINEAGE_COMPLETE\\\\|review-report\\\\|state_log\\\\|registry\\\\|synthesis\\\\|lineage\\\" .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs | head -60\"}"},"time":{"start":1793873308115,"end":1793873308381}}}}
