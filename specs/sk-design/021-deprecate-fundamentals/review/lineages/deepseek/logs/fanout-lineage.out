// is owned by which workflow mode. VALUES and REVIEW share a mode on purpose,\n-// because they share its references; they stay separate intents because they\n-// load different ones. Keeping the ownership here (validated against both the\n-// registry and the leaf manifest) means a root-router row that points at a\n-// retired or renamed mode fails the build instead of silently routing there.\n+// is owned by which workflow mode. Keeping the ownership here (validated against\n+// both the registry and the leaf manifest) means a root-router row that points at\n+// a retired or renamed mode fails the build instead of silently routing there.\n const INTENT_MODE_OWNERS = Object.freeze({\n-  VALUES: 'sk-design-fundamentals',\n-  REVIEW: 'sk-design-fundamentals',\n   CHART: 'sk-design-chart',\n   FLOWCHART: 'sk-design-diagram',\n   EXTRACT: 'sk-design-md-generator',\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/009-sk-design/fixtures/canary-cases.v1.json b/.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/009-sk-design/fixtures/canary-cases.v1.json\nindex 5bd017f6425..833b0047667 100644\n--- a/.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/009-sk-design/fixtures/canary-cases.v1.json\n+++ b/.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/009-sk-design/fixtures/canary-cases.v1.json\n@@ -3,46 +3,6 @@\n   \"activationGeneration\": 1,\n   \"certificates\": {},\n   \"cases\": [\n-    {\n-      \"id\": \"values-spacing-single\",\n-      \"prompt\": \"what spacing scale should the pricing page use\",\n-      \"riskSlice\": \"actor:mutating:single\",\n-      \"expectedAction\": \"route\",\n-      \"expectedSelectionKind\": \"single\",\n-      \"expectedModes\": [\n-        \"sk-design-fundamentals\"\n-      ],\n-      \"gold\": {\n-        \"expectedIntents\": [\n-          \"sk-design-fundamentals\"\n-   