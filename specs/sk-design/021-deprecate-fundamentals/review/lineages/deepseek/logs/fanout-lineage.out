prompt of ['review .github/workflows/ci.yml', 'review this GitHub Actions workflow']) {\n209:    const route = resolveRoute('sk-code', prompt);\n210:    assert.equal(route.action, 'route', prompt);\n211:    assert.equal(route.selectionKind, 'surfaceBundle', prompt);\n212:    assert.deepEqual(modes(route), ['sk-code-review', 'sk-code-ci'], prompt);\n218:// Actions form of each phrase and these prompts must stay off it.\n219:test('non-CI prompts that share CI words do not select the CI surface', () => {\n220:  for (const prompt of [\n228:    const route = resolveRoute('sk-code', prompt);\n229:    assert.ok(route, prompt);\n230:    assert.ok(!modes(route).includes('sk-code-ci'), prompt);\n234:test('a frontend review prompt bundles the frontend surface', () => {\n238:  assert.deepEqual(modes(route), ['sk-code-review', 'sk-code-frontend']);\n241:// A stylesheet path, a React hook, or a workflow file also names non-frontend\n243:// prompts must stay off it.\n244:test('non-frontend prompts that share frontend words do not select the frontend surface', () => {\n245:  for (const prompt of [\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/316-deprecate-design-fundamentals && grep -n \\\"prompt\\\\|bundle\\\\|frontend\\\" .skilled/bin/tests/compiled-route-surface-hint.test.cjs | head -30\"}"},"time":{"start":1793873241490,"end":1793873241729}}}}
