{"type":"tool_use","timestamp":1793873244699,"sessionID":"ses_e54d7f46fffe0ZLISbmnuV6zfy","part":{"partID":"prt_1ab2d719a0012p2uyLYSEM7h6U","sessionID":"ses_e54d7f46fffe0ZLISbmnuV6zfy","messageID":"msg_1ab2d6a7f001hpVbnWOAU1f0hO","type":"tool","id":"chatcmpl-tool-873071f11505f781","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/316-deprecate-design-fundamentals && sed -n '232,275p' .skilled/bin/tests/compiled-route-surface-hint.test.cjs"},"output":"});\n\ntest('a frontend review prompt bundles the frontend surface', () => {\n  const route = resolveRoute('sk-code', 'review my css cascade layers change');\n  assert.equal(route.action, 'route');\n  assert.equal(route.selectionKind, 'surfaceBundle');\n  assert.deepEqual(modes(route), ['sk-code-review', 'sk-code-frontend']);\n});\n\n// A stylesheet path, a React hook, or a workflow file also names non-frontend\n// code, so the surface keys on its own web and Figma phrases and these\n// prompts must stay off it.\ntest('non-frontend prompts that share frontend words do not select the frontend surface', () => {\n  for (const prompt of [\n    'fix the css in the advisor dashboard script',\n    'write a react hook test',\n    'review the github actions workflow yaml',\n  ]) {\n    const route = resolveRoute('sk-code', prompt);\n    assert.ok(route, prompt);\n    assert.ok(!modes(route).includes('sk-code-frontend'), prompt);\n  }\n});\n\ntest('a hub without surface packets ignores the hint', () => {\n  for (const hubId of ['sk-doc', 'mcp-tooling']) {\n    for (const prompt of ['create a new skill and validate the docs', 'use the figma mcp transport']) {\n      assert.deepEqual(compiledRoute(hubId, prompt, { surfaceHint: 'SKILLED' }), compiledRoute(hubId, prompt));\n    }\n  }\n});\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. FRONT DOOR\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('the front door passes --surface-hint through and keeps stdout to one route line', () => {\n  const plain = runFrontDoor(['--hub', 'sk-code', '--prompt', SKILLED_TESTING]);\n  const hinted = runFrontDoor(['--hub', 'sk-code', '--prompt', SKILLED_TESTING, '--surface-hint', 'SKILLED']);\n  const invalid = runFrontDoor(['--hub', 'sk-code', '--prompt', SKILLED_TESTING, '--surface-hint', 'not-a-surface']);\n  for (const run of [plain, hinted, invalid]) {\n    assert.equal(run.status, 0);\n    assert.equal(run.stderr, '');\n  }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"});\n\ntest('a frontend review prompt bundles the frontend surface', () => {\n  const route = resolveRoute('sk-code', 'review my css cascade layers change');\n  assert.equal(route.action, 'route');\n  assert.equal(route.selectionKind, 'surfaceBundle');\n  assert.deepEqual(modes(route), ['sk-code-review', 'sk-code-frontend']);\n});\n\n// A stylesheet path, a React hook, or a workflow file also names non-frontend\n// code, so the surface keys on its own web and Figma phrases and these\n// prompts must stay off it.\ntest('non-frontend prompts that share frontend words do not select the frontend surface', () => {\n  for (const prompt of [\n    'fix the css in the advisor dashboard script',\n    'write a react hook test',\n    'review the github actions workflow yaml',\n  ]) {\n    const route = resolveRoute('sk-code', prompt);\n    assert.ok(route, prompt);\n    assert.ok(!modes(route).includes('sk-code-frontend'), prompt);\n  }\n});\n\ntest('a hub without surface packets ignores the hint', () => {\n  for (const hubId of ['sk-doc', 'mcp-tooling']) {\n    for (const prompt of ['create a new skill and validate the docs', 'use the figma mcp transport']) {\n      assert.deepEqual(compiledRoute(hubId, prompt, { surfaceHint: 'SKILLED' }), compiledRoute(hubId, prompt));\n    }\n  }\n});\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. FRONT DOOR\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('the front door passes --surface-hint through and keeps stdout to one route line', () => {\n  const plain = runFrontDoor(['--hub', 'sk-code', '--prompt', SKILLED_TESTING]);\n  const hinted = runFrontDoor(['--hub', 'sk-code', '--prompt', SKILLED_TESTING, '--surface-hint', 'SKILLED']);\n  const invalid = runFrontDoor(['--hub', 'sk-code', '--prompt', SKILLED_TESTING, '--surface-hint', 'not-a-surface']);\n  for (const run of [plain, hinted, invalid]) {\n    assert.equal(run.status, 0);\n    assert.equal(run.stderr, '');\n  }\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/316-deprecate-design-fundamentals && sed -n '232,275p' .skilled/bin/tests/compiled-route-surface-hint.test.cjs\"}"},"time":{"start":1793873244570,"end":1793873244699}}}}
