routes a request through mode-registry.json to two workflow modes (sk-code-quality, sk-code-review) or bundles one of three read-only surface evidence packets (sk-code-ci, sk-code-frontend, sk-code-skilled) over a shared surface-detection router. Each surface carries the shared implement/debug/verify workflow doctrine plus its domain knowledge. The shar\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/316-deprecate-design-fundamentals && python3 - <<'EOF'\\nimport json\\nd=json.load(open('.skilled/skills/sk-code/graph-metadata.json'))\\nprint('top signals', len(d.get('intent_signals',[])))\\nprint('derived keys', list(d.get('derived',{}).keys()))\\nprint('derived intent_signals', d.get('derived',{}).get('intent_signals'))\\nprint('causal', d.get('derived',{}).get('causal_summary','')[:400])\\nEOF\"}"},"time":{"start":1793873110718,"end":1793873111210}}}}
