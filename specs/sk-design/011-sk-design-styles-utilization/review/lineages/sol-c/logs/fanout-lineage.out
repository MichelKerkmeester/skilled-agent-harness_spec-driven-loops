      EOF\n877:                 working_directory: \"{repo_root}\"\n878: \n879:               step_finalize_divergent_pivot:\n880:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n881:                 skip_when: \"pivot_prepare_status != 'pending'\"\n882:                 command: |\n883:                   node --experimental-strip-types --input-type=module <<'EOF'\n884:                   import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n885:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n886:                   EOF\n887:                 working_directory: \"{repo_root}\"\n888:                 outputs:\n889:                   - pivot_finalize_json: \"The complete parsed final result\"\n890: \n891:               step_resolve_divergent_pivot_result:\n892:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n893:                 branch_on: \"pivot_prepare_status\"\n894:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n895:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n896: \n897:               step_apply_divergent_pivot_result:\n898:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n899:                 branch_on: \"pivot_result.status\"\n900:                 if_completed:\n901:                   set:\n902:                     next_dimension: \"{pivot_result.restoredFocus}\"\n903:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n904:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n905:                   command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n906:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n907:                   proceed_to: step_normalize_pause_events\n908:                 if_failed:\n909:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n910:                   skip_to: phase_synthesis\n911:             on_error:\n912:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n913:               skip_to: phase_synthesis\n914:           if_existing_terminal_path:\n915:             log: \"Loop stopping. Reason: {reason}\"\n916:             skip_to: phase_synthesis\n917:         if_blocked:\n918:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n919:         if_stuck_recovery:\n920:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n921:           recovery_strategies:\n922:             - \"Change granularity: file-level → function-level → line-level review\"\n923:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n924:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n925:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n926:           set:\n927:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n928:             pending_stop_event: \"stuck_recovery\"\n929:             pending_stop_reason: \"stuckRecovery\"\n\n(Showing lines 840-929 of 2111. Use offset=