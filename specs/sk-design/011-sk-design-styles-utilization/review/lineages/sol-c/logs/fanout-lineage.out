\"]},\"targetSelection\":{\"selectedTargets\":[\"retrieval rights gates\",\"STUDY prompt path\",\"shared authority seam\",\"mode consumers\",\"Open Design transport\"],\"selectionReason\":\"These are the producer-consumer security boundaries for corpus-derived content\",\"discoveryMethods\":[\"direct_read\",\"exact_search\",\"producer_consumer_trace\"],\"omittedHighRiskTargets\":[],\"graphStatus\":\"unavailable\",\"semanticSearchStatus\":\"unavailable\",\"evidenceRefs\":[\".opencode/specs/sk-design/011-sk-design-styles-utilization/006-md-generator-study-exemplars/plan.md:76-87\"]},\"searchCoverage\":{\"requiredBugClasses\":[\"prompt_injection\",\"rights_reuse\",\"cache_exposure\",\"authority_override\"],\"covered\":[\"prompt_injection\",\"rights_reuse\",\"cache_exposure\",\"authority_override\"],\"ruledOut\":[\"rights_reuse\",\"cache_exposure\",\"authority_override\"],\"deferred\":[],\"blocked\":[],\"graphCoverageMode\":\"graphless_fallback\"},\"searchLedger\":[{\"id\":\"SL-004\",\"dimension\":\"security\",\"targetRefs\":[\"phase 006 STUDY producer-consumer path\"],\"bugClass\":\"prompt_injection\",\"hypothesis\":\"Hydrated corpus instructions may cross into the model prompt without a defined neutralization gate\",\"searchActions\":[{\"method\":\"producer_consumer_trace\",\"queryOrPath\":\"hydrate -> transform -> buildWritePrompt -> runGuided\",\"result\":\"envelope named; no hostile-instruction behavior or fixture defined\",\"evidenceRefs\":[\".opencode/specs/sk-design/011-sk-design-styles-utilization/006-md-generator-study-exemplars/plan.md:83-87,128-135\",\".opencode/specs/sk-design/011-sk-design-styles-utilization/006-md-generator-study-exemplars/tasks.md:65-71\"]}],\"disposition\":\"finding\",\"rationale\":\"The output leak gate cannot substitute for pre-prompt instruction isolation\",\"linkedFindingId\":\"F002\"},{\"id\":\"SL-005\",\"dimension\":\"security\",\"targetRefs\":[\"phases 004,007,008,009\"],\"bugClass\":\"rights_reuse\",\"invariant\":\"Unknown-right