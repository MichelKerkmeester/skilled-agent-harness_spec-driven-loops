ledger is append-only, so the report notes it instead of rewriting it.\n- A leftover `.run-open.json` file is in the lineage directory.\n\nEach iteration file, delta and state record went through the append gateway, with the reducer run after each. The final record carries `stopReason: maxIterationsReached`, the lock is released, and no file outside the review directory changed. The full report is `specs/mcp/mcp-browser-use/001-mcp-browser-use-hub/review/lineages/claude2/review-report.md`.\n\nFANOUT_LINEAGE_COMPLETE:claude2","ttft_ms":3280,"type":"result","duration_ms":753971,"uuid":"04cc72e9-833f-407a-99d5-327fb826c5f8","ttft_stream_ms":2650,"time_to_request_ms":446,"first_content_frame_ms":2650,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":132,"outputTokens":72723,"cacheReadInputTokens":11423435,"cacheCreationInputTokens":247318,"webSearchRequests":0,"costUSD":5.718218999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":11789,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":247318,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-13T04:42:42.977Z"}
