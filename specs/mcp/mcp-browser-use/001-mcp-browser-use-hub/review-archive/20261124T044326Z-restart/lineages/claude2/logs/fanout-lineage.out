{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013bFdL85V3Br88EZbhLyKjX","type":"tool_result","content":"     1\t'use strict';\n     2\t\n     3\t// This router scores directly against the routingModel that registry-compiler.cjs\n     4\t// builds from hub-router.json. It does not go through the generic\n     5\t// destinationGraph detector and selector evaluator, because the authored routing\n     6\t// contract is the weighted vocabulary scorer in hub-router.json: a prompt scores\n     7\t// each mode by its distinct keyword matches times the mode's weight, near-ties\n     8\t// within ambiguityDelta route together in tie-break order, and a prompt that\n     9\t// matches no mode defers because the hub declares no default mode. The generic\n    10\t// policy is still compiled and hashed for the policy card and provenance.\n    11\t\n    12\tconst {\n    13\t  computeRequestFactsHash,\n    14\t} = require('../../../003-contract-schemas/lib/canonical.cjs');\n    15\tconst {\n    16\t  parseRouteDecision,\n    17\t} = require('../../../005-decision-evaluator/lib/decision-contract.cjs');\n    18\t\n    19\tfunction normalize(value) {\n    20\t  return String(value).trim().toLowerCase();\n    21\t}\n    22\t\n    23\t// A hyphenated and a spaced prompt name the same thing, so both sides fold\n    24\t// hyphen runs to one space and collapse whitespace before comparing.\n    25\tfunction spaced(value) {\n    26\t  return String(value).replace(/-+/g, ' ').replace(/\\s+/g, ' ').trim();\n    27\t}\n    28\t\n    29\tfunction containsSignal(text, value) {\n    30\t  return spaced(text).includes(spaced(normalize(value)));\n    31\t}\n    32\t\n    33\tfunction requestFor(snapshot, input) {\n    34\t  const request = {\n    35\t    evidence: [],\n    36\t    observations: [{ kind: 'intent', value: input.prompt || '' }],\n    37\t    pinnedActivationGeneration: snapshot.policy.activationGeneration,\n    38\t    schemaVersion: 'V1',\n    39\t  };\n    40\t  request.requestFactsHash = computeRequestFactsHash(request);\n    41\t  return request;\n    42\t}\n    43\t\n    44\tfunction target(destination) {\n    45\t  return {\n    46\t    authorityRef: destination.authorityRef,\n    47\t    destinationId: destination.id,\n    48\t    mutatesWorkspace: destination.mutatesWorkspace,\n    49\t    role: destination.role,\n    50\t  };\n    51\t}\n    52\t\n    53\tfunction negative(action, payload) {\n    54\t  return parseRouteDecision({ action, [action]: { ...payload, authority: 'Withheld' }, schemaVersion: 'V1' });\n    55\t}\n    56\t\n    57\tfunction route(snapshot, selectionKind, modes) {\n    58\t  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    59\t    [destination.id.workflowMode, destination]\n    60\t  )));\n    61\t  return parseRouteDecision({\n    62\t    action: 'route',\n    63\t    route: {\n    64\t      authority: 'WithheldUntilVerify',\n    65\t      basis: { kind: 'signal' },\n    66\t      evidence: [],\n    67\t      selectionKind,\n    68\t      targets: modes.map((mode) => target(byMode.get(mode))),\n    69\t    },\n    70\t    schemaVersion: 'V1',\n    71\t  }, snapshot.policy);\n    72\t}\n    73\t\n    74\t// A vocabulary that lists both spellings of one phrase names it once, so the\n    75\t// fold-deduped count keeps a single mention worth one hit rather than two.\n    76\tfunction scoreModes(routingModel, text) {\n    77\t  return routingModel.modes.map((mode) => {\n    78\t    const matched = new Set(mode.keywords\n    79\t      .filter((keyword) => containsSignal(text, keyword))\n    80\t      .map((keyword) => spaced(normalize(keyword))));\n    81\t    return { mode: mode.workflowMode, score: matched.size * mode.weight };\n    82\t  }).filter((entry) => entry.score > 0);\n    83\t}\n    84\t\n    85\t// Keep every mode within ambiguityDelta of the top score. The hub's outcomes\n    86\t// declare single, orderedBundle and defer only, so a near-tie routes every tied\n    87\t// mode as a bundle rather than asking for clarification.\n    88\tfunction selectNearTiedModes(scores, ambiguityDelta) {\n    89\t  if (scores.length === 0) return [];\n    90\t  const top = scores[0].score;\n    91\t  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n    92\t}\n    93\t\n    94\tfunction exactBundle(routingModel, orderedModes) {\n    95\t  const candidate = orderedModes.join(' ');\n    96\t  return routingModel.bundleRules.find((rule) => (\n    97\t    rule.targetWorkflowModes.join(' ') === candidate\n    98\t  )) || null;\n    99\t}\n   100\t\n   101\tfunction evaluateRoute(snapshot, input) {\n   102\t  const request = requestFor(snapshot, input);\n   103\t  const text = normalize(input.prompt || '');\n   104\t  const constraints = new Set((input.constraints || []).map(normalize));\n   105\t  let decision;\n   106\t  let scores = [];\n   107\t  if (constraints.has('forbidden') || text.includes('forbidden')) {\n   108\t    decision = negative('reject', { reason: 'forbidden' });\n   109\t  } else if (constraints.has('dependency-failure')) {\n   110\t    decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n   111\t  } else {\n   112\t    scores = scoreModes(snapshot.routingModel, text);\n   113\t    const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n   114\t    scores.sort((left, right) => (\n   115\t      right.score - left.score || order.get(left.mode) - order.get(right.mode)\n   116\t    ));\n   117\t    const selected = selectNearTiedModes(scores, snapshot.routingModel.ambiguityDelta);\n   118\t    if (selected.length === 0) {\n   119\t      decision = snapshot.routingModel.defaultMode == null\n   120\t        ? negative('defer', { reason: 'no-match', recovery: ['defer'] })\n   121\t        : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n   122\t    } else if (selected.length === 1) {\n   123\t      decision = route(snapshot, 'single', selected);\n   124\t    } else {\n   125\t      const ordered = [...selected].sort((left, right) => order.get(left) - order.get(right));\n   126\t      const bundle = exactBundle(snapshot.routingModel, ordered);\n   127\t      decision = route(snapshot, bundle ? bundle.kind : 'orderedBundle', ordered);\n   128\t    }\n   129\t  }\n   130\t  return {\n   131\t    decision,\n   132\t    request,\n   133\t    trace: {\n   134\t      matchedScores: scores,\n   135\t      outcome: decision.action === 'route' ? decision.route.selectionKind : decision.action,\n   136\t    },\n   137\t  };\n   138\t}\n   139\t\n   140\tfunction advisorContribution(snapshot, advisor) {\n   141\t  if (!advisor || advisor.state === 'absent' || advisor.state === 'unavailable') {\n   142\t    return { contributes: false, reason: 'advisor-zero-evidence' };\n   143\t  }\n   144\t  if (advisor.state !== 'live') return { contributes: false, reason: 'advisor-annotation-only' };\n   145\t  if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n   146\t    || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n   147\t    return { contributes: false, reason: 'advisor-drift-annotation-only' };\n   148\t  }\n   149\t  return { contributes: true, reason: 'advisor-live-identity-match' };\n   150\t}\n   151\t\n   152\tmodule.exports = {\n   153\t  advisorContribution,\n   154\t  evaluateRoute,\n   155\t};\n{\n  \"skill\": \"mcp-browser-use\",\n  \"version\": \"1.1.0.0\",\n  \"routerPolicy\": {\n    \"defaultMode\": null,\n    \"ambiguityDelta\": 1,\n    \"tieBreak\": [\n      \"mcp-chrome-devtools\",\n      \"mcp-aside-devtools\",\n      \"mcp-bladebro\"\n    ],\n    \"outcomes\": {\n      \"single\": \"one dominant browser signal routes to one mode\",\n      \"orderedBundle\": \"multiple explicitly named browser tools route in tie-break order\",\n      \"defer\": \"unclear or generic browser phrasing asks for disambiguation\"\n    },\n    \"defaultResource\": [\n      \"ROUTER.md\",\n      \"mode-registry.json\"\n    ],\n    \"defaultResourceSemantics\": \"fallback-only\",\n    \"defaultResourceContract\": \"A scored route assembles exactly the selected mode's declared resources. defaultResource is consulted only when no mode scores, and then only as the defer-time suggestion offered alongside disambiguation. It is never added to a scored route's resource set.\",\n    \"discoveryClasses\": [\n      \"hub-identity\",\n      \"generic-browser-automation\"\n    ],\n    \"discoveryClassesContract\": \"Classes listed here are hub discovery and defer evidence only. No mode's scoring classes reference them, so a prompt that matches only discovery vocabulary scores zero modes and takes the defer outcome instead of fanning out to every mode.\"\n  },\n  \"routerSignals\": {\n    \"mcp-chrome-devtools\": {\n      \"weight\": 4,\n      \"classes\": [\n        \"chrome-devtools-aliases\",\n        \"browser-debug\"\n      ],\n      \"resources\": [\n        \"mcp-chrome-devtools/SKILL.md\"\n      ]\n    },\n    \"mcp-aside-devtools\": {\n      \"weight\": 4,\n      \"classes\": [\n        \"aside-devtools-aliases\",\n        \"aside-repl-evidence\"\n      ],\n      \"resources\": [\n        \"mcp-aside-devtools/SKILL.md\"\n      ]\n    },\n    \"mcp-bladebro\": {\n      \"weight\": 4,\n      \"classes\": [\n        \"bladebro-aliases\",\n        \"bladebro-workflow\"\n      ],\n      \"resources\": [\n        \"mcp-bladebro/SKILL.md\"\n      ]\n    }\n  },\n  \"vocabularyClasses\": {\n    \"hub-identity\": {\n      \"note\": \"Discovery-only. Hub-level vocabulary that identifies this hub, not any one mode. Deliberately unreferenced by routerSignals, so hub-identity-only prompts defer.\",\n      \"keywords\": [\n        \"mcp-browser-use\",\n        \"mode-registry\",\n        \"hub-router\"\n      ]\n    },\n    \"generic-browser-automation\": {\n      \"note\": \"Discovery-only. Generic browser-automation phrasing names no tool, so it never scores a mode. A prompt that matches only these phrases defers. The Aside and Bladebro agentic phrasing lives here too, because a bare agentic request belongs to neither mode.\",\n      \"keywords\": [\n        \"browser automation\",\n        \"automate the browser\",\n        \"web browser\",\n        \"agentic browser\",\n        \"ai browser automation\",\n        \"browser agent\",\n        \"natural language browser\"\n      ]\n    },\n    \"chrome-devtools-aliases\": {\n      \"keywords\": [\n        \"chrome devtools\",\n        \"open devtools\",\n        \"via devtools\",\n        \"use devtools\",\n        \"in devtools\",\n        \"devtools console\",\n        \"browser debug\",\n        \"lighthouse\",\n        \"bdg\",\n        \"cdp\",\n        \"chrome-devtools\",\n        \"mcp-chrome-devtools\",\n        \"chrome_devtools_live\",\n        \"chrome devtools live\",\n        \"chrome live manual\",\n        \"remote debugging\",\n        \"chrome autoconnect\",\n        \"my own chrome\",\n        \"signed-in chrome\",\n        \"logged in chrome\"\n      ]\n    },\n    \"browser-debug\": {\n      \"note\": \"Debugging and inspection vocabulary. It stays here and out of the Bladebro classes, so a debugging request resolves to Chrome DevTools and never to Bladebro on its own.\",\n      \"keywords\": [\n        \"inspect the dom\",\n        \"screenshot capture\",\n        \"console errors\",\n        \"network requests\",\n        \"har export\",\n        \"performance trace\",\n        \"cdp domain\",\n        \"capture browser screenshots\",\n        \"export a har\",\n        \"har file\",\n        \"core web vitals\"\n      ]\n    },\n    \"aside-devtools-aliases\": {\n      \"note\": \"Bare aside is kept: without it, requests such as \\\"run aside on the pricing page\\\" or \\\"open aside and log in\\\" name the tool and still defer. Stage two only runs after the advisor picks this hub, so ordinary-prose uses of the word never reach it.\",\n      \"keywords\": [\n        \"aside\",\n        \"aside browser\",\n        \"aside cli\",\n        \"aside mcp\",\n        \"aside repl\",\n        \"aside daemon\",\n        \"aside account\",\n        \"aside devtools\",\n        \"mcp-aside-devtools\"\n      ]\n    },\n    \"aside-repl-evidence\": {\n      \"note\": \"Deterministic REPL replay and evidence capture. These phrases carry no agentic or stealth qualifier, because agentic and stealth signed-in work belongs to the Bladebro classes.\",\n      \"keywords\": [\n        \"capture repl evidence\",\n        \"repl evidence capture\",\n        \"deterministic signed-in proof\",\n        \"sandboxed playwright repl\",\n        \"replay this signed-in\",\n        \"signed-in replay\"\n      ]\n    },\n    \"bladebro-aliases\": {\n      \"keywords\": [\n        \"bladebro\",\n        \"bladebro cli\",\n        \"bladebro mcp\",\n        \"stealth browser\",\n        \"rb attach\",\n        \"rb status\"\n      ]\n    },\n    \"bladebro-workflow\": {\n      \"note\": \"Agentic branching, stealth signed-in work and caller-owned browser attachment. Tie-break order places Chrome DevTools first on debugging overlap and Aside first on deterministic signed-in overlap.\",\n      \"keywords\": [\n        \"agentic signed-in\",\n        \"stealth signed-in\",\n        \"agentic branching\",\n        \"anti-detection browser\",\n        \"attach to my open browser\",\n        \"caller-owned browser\",\n        \"browser i already have open\",\n        \"already-open browser\"\n      ]\n    }\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"edeb1bd5-df81-4af8-a20d-fbfd6e2d1470","timestamp":"2026-11-21T22:33:26.056Z","tool_use_result":{"stdout":"     1\t'use strict';\n     2\t\n     3\t// This router scores directly against the routingModel that registry-compiler.cjs\n     4\t// builds from hub-router.json. It does not go through the generic\n     5\t// destinationGraph detector and selector evaluator, because the authored routing\n     6\t// contract is the weighted vocabulary scorer in hub-router.json: a prompt scores\n     7\t// each mode by its distinct keyword matches times the mode's weight, near-ties\n     8\t// within ambiguityDelta route together in tie-break order, and a prompt that\n     9\t// matches no mode defers because the hub declares no default mode. The generic\n    10\t// policy is still compiled and hashed for the policy card and provenance.\n    11\t\n    12\tconst {\n    13\t  computeRequestFactsHash,\n    14\t} = require('../../../003-contract-schemas/lib/canonical.cjs');\n    15\tconst {\n    16\t  parseRouteDecision,\n    17\t} = require('../../../005-decision-evaluator/lib/decision-contract.cjs');\n    18\t\n    19\tfunction normalize(value) {\n    20\t  return String(value).trim().toLowerCase();\n    21\t}\n    22\t\n    23\t// A hyphenated and a spaced prompt name the same thing, so both sides fold\n    24\t// hyphen runs to one space and collapse whitespace before comparing.\n    25\tfunction spaced(value) {\n    26\t  return String(value).replace(/-+/g, ' ').replace(/\\s+/g, ' ').trim();\n    27\t}\n    28\t\n    29\tfunction containsSignal(text, value) {\n    30\t  return spaced(text).includes(spaced(normalize(value)));\n    31\t}\n    32\t\n    33\tfunction requestFor(snapshot, input) {\n    34\t  const request = {\n    35\t    evidence: [],\n    36\t    observations: [{ kind: 'intent', value: input.prompt || '' }],\n    37\t    pinnedActivationGeneration: snapshot.policy.activationGeneration,\n    38\t    schemaVersion: 'V1',\n    39\t  };\n    40\t  request.requestFactsHash = computeRequestFactsHash(request);\n    41\t  return request;\n    42\t}\n    43\t\n    44\tfunction target(destination) {\n    45\t  return {\n    46\t    authorityRef: destination.authorityRef,\n    47\t    destinationId: destination.id,\n    48\t    mutatesWorkspace: destination.mutatesWorkspace,\n    49\t    role: destination.role,\n    50\t  };\n    51\t}\n    52\t\n    53\tfunction negative(action, payload) {\n    54\t  return parseRouteDecision({ action, [action]: { ...payload, authority: 'Withheld' }, schemaVersion: 'V1' });\n    55\t}\n    56\t\n    57\tfunction route(snapshot, selectionKind, modes) {\n    58\t  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    59\t    [destination.id.workflowMode, destination]\n    60\t  )));\n    61\t  return parseRouteDecision({\n    62\t    action: 'route',\n    63\t    route: {\n    64\t      authority: 'WithheldUntilVerify',\n    65\t      basis: { kind: 'signal' },\n    66\t      evidence: [],\n    67\t      selectionKind,\n    68\t      targets: modes.map((mode) => target(byMode.get(mode))),\n    69\t    },\n    70\t    schemaVersion: 'V1',\n    71\t  }, snapshot.policy);\n    72\t}\n    73\t\n    74\t// A vocabulary that lists both spellings of one phrase names it once, so the\n    75\t// fold-deduped count keeps a single mention worth one hit rather than two.\n    76\tfunction scoreModes(routingModel, text) {\n    77\t  return routingModel.modes.map((mode) => {\n    78\t    const matched = new Set(mode.keywords\n    79\t      .filter((keyword) => containsSignal(text, keyword))\n    80\t      .map((keyword) => spaced(normalize(keyword))));\n    81\t    return { mode: mode.workflowMode, score: matched.size * mode.weight };\n    82\t  }).filter((entry) => entry.score > 0);\n    83\t}\n    84\t\n    85\t// Keep every mode within ambiguityDelta of the top score. The hub's outcomes\n    86\t// declare single, orderedBundle and defer only, so a near-tie routes every tied\n    87\t// mode as a bundle rather than asking for clarification.\n    88\tfunction selectNearTiedModes(scores, ambiguityDelta) {\n    89\t  if (scores.length === 0) return [];\n    90\t  const top = scores[0].score;\n    91\t  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n    92\t}\n    93\t\n    94\tfunction exactBundle(routingModel, orderedModes) {\n    95\t  const candidate = orderedModes.join(' ');\n    96\t  return routingModel.bundleRules.find((rule) => (\n    97\t    rule.targetWorkflowModes.join(' ') === candidate\n    98\t  )) || null;\n    99\t}\n   100\t\n   101\tfunction evaluateRoute(snapshot, input) {\n   102\t  const request = requestFor(snapshot, input);\n   103\t  const text = normalize(input.prompt || '');\n   104\t  const constraints = new Set((input.constraints || []).map(normalize));\n   105\t  let decision;\n   106\t  let scores = [];\n   107\t  if (constraints.has('forbidden') || text.includes('forbidden')) {\n   108\t    decision = negative('reject', { reason: 'forbidden' });\n   109\t  } else if (constraints.has('dependency-failure')) {\n   110\t    decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n   111\t  } else {\n   112\t    scores = scoreModes(snapshot.routingModel, text);\n   113\t    const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n   114\t    scores.sort((left, right) => (\n   115\t      right.score - left.score || order.get(left.mode) - order.get(right.mode)\n   116\t    ));\n   117\t    const selected = selectNearTiedModes(scores, snapshot.routingModel.ambiguityDelta);\n   118\t    if (selected.length === 0) {\n   119\t      decision = snapshot.routingModel.defaultMode == null\n   120\t        ? negative('defer', { reason: 'no-match', recovery: ['defer'] })\n   121\t        : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n   122\t    } else if (selected.length === 1) {\n   123\t      decision = route(snapshot, 'single', selected);\n   124\t    } else {\n   125\t      const ordered = [...selected].sort((left, right) => order.get(left) - order.get(right));\n   126\t      const bundle = exactBundle(snapshot.routingModel, ordered);\n   127\t      decision = route(snapshot, bundle ? bundle.kind : 'orderedBundle', ordered);\n   128\t    }\n   129\t  }\n   130\t  return {\n   131\t    decision,\n   132\t    request,\n   133\t    trace: {\n   134\t      matchedScores: scores,\n   135\t      outcome: decision.action === 'route' ? decision.route.selectionKind : decision.action,\n   136\t    },\n   137\t  };\n   138\t}\n   139\t\n   140\tfunction advisorContribution(snapshot, advisor) {\n   141\t  if (!advisor || advisor.state === 'absent' || advisor.state === 'unavailable') {\n   142\t    return { contributes: false, reason: 'advisor-zero-evidence' };\n   143\t  }\n   144\t  if (advisor.state !== 'live') return { contributes: false, reason: 'advisor-annotation-only' };\n   145\t  if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n   146\t    || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n   147\t    return { contributes: false, reason: 'advisor-drift-annotation-only' };\n   148\t  }\n   149\t  return { contributes: true, reason: 'advisor-live-identity-match' };\n   150\t}\n   151\t\n   152\tmodule.exports = {\n   153\t  advisorContribution,\n   154\t  evaluateRoute,\n   155\t};\n{\n  \"skill\": \"mcp-browser-use\",\n  \"version\": \"1.1.0.0\",\n  \"routerPolicy\": {\n    \"defaultMode\": null,\n    \"ambiguityDelta\": 1,\n    \"tieBreak\": [\n      \"mcp-chrome-devtools\",\n      \"mcp-aside-devtools\",\n      \"mcp-bladebro\"\n    ],\n    \"outcomes\": {\n      \"single\": \"one dominant browser signal routes to one mode\",\n      \"orderedBundle\": \"multiple explicitly named browser tools route in tie-break order\",\n      \"defer\": \"unclear or generic browser phrasing asks for disambiguation\"\n    },\n    \"defaultResource\": [\n      \"ROUTER.md\",\n      \"mode-registry.json\"\n    ],\n    \"defaultResourceSemantics\": \"fallback-only\",\n    \"defaultResourceContract\": \"A scored route assembles exactly the selected mode's declared resources. defaultResource is consulted only when no mode scores, and then only as the defer-time suggestion offered alongside disambiguation. It is never added to a scored route's resource set.\",\n    \"discoveryClasses\": [\n      \"hub-identity\",\n      \"generic-browser-automation\"\n    ],\n    \"discoveryClassesContract\": \"Classes listed here are hub discovery and defer evidence only. No mode's scoring classes reference them, so a prompt that matches only discovery vocabulary scores zero modes and takes the defer outcome instead of fanning out to every mode.\"\n  },\n  \"routerSignals\": {\n    \"mcp-chrome-devtools\": {\n      \"weight\": 4,\n      \"classes\": [\n        \"chrome-devtools-aliases\",\n        \"browser-debug\"\n      ],\n      \"resources\": [\n        \"mcp-chrome-devtools/SKILL.md\"\n      ]\n    },\n    \"mcp-aside-devtools\": {\n      \"weight\": 4,\n      \"classes\": [\n        \"aside-devtools-aliases\",\n        \"aside-repl-evidence\"\n      ],\n      \"resources\": [\n        \"mcp-aside-devtools/SKILL.md\"\n      ]\n    },\n    \"mcp-bladebro\": {\n      \"weight\": 4,\n      \"classes\": [\n        \"bladebro-aliases\",\n        \"bladebro-workflow\"\n      ],\n      \"resources\": [\n        \"mcp-bladebro/SKILL.md\"\n      ]\n    }\n  },\n  \"vocabularyClasses\": {\n    \"hub-identity\": {\n      \"note\": \"Discovery-only. Hub-level vocabulary that identifies this hub, not any one mode. Deliberately unreferenced by routerSignals, so hub-identity-only prompts defer.\",\n      \"keywords\": [\n        \"mcp-browser-use\",\n        \"mode-registry\",\n        \"hub-router\"\n      ]\n    },\n    \"generic-browser-automation\": {\n      \"note\": \"Discovery-only. Generic browser-automation phrasing names no tool, so it never scores a mode. A prompt that matches only these phrases defers. The Aside and Bladebro agentic phrasing lives here too, because a bare agentic request belongs to neither mode.\",\n      \"keywords\": [\n        \"browser automation\",\n        \"automate the browser\",\n        \"web browser\",\n        \"agentic browser\",\n        \"ai browser automation\",\n        \"browser agent\",\n        \"natural language browser\"\n      ]\n    },\n    \"chrome-devtools-aliases\": {\n      \"keywords\": [\n        \"chrome devtools\",\n        \"open devtools\",\n        \"via devtools\",\n        \"use devtools\",\n        \"in devtools\",\n        \"devtools console\",\n        \"browser debug\",\n        \"lighthouse\",\n        \"bdg\",\n        \"cdp\",\n        \"chrome-devtools\",\n        \"mcp-chrome-devtools\",\n        \"chrome_devtools_live\",\n        \"chrome devtools live\",\n        \"chrome live manual\",\n        \"remote debugging\",\n        \"chrome autoconnect\",\n        \"my own chrome\",\n        \"signed-in chrome\",\n        \"logged in chrome\"\n      ]\n    },\n    \"browser-debug\": {\n      \"note\": \"Debugging and inspection vocabulary. It stays here and out of the Bladebro classes, so a debugging request resolves to Chrome DevTools and never to Bladebro on its own.\",\n      \"keywords\": [\n        \"inspect the dom\",\n        \"screenshot capture\",\n        \"console errors\",\n        \"network requests\",\n        \"har export\",\n        \"performance trace\",\n        \"cdp domain\",\n        \"capture browser screenshots\",\n        \"export a har\",\n        \"har file\",\n        \"core web vitals\"\n      ]\n    },\n    \"aside-devtools-aliases\": {\n      \"note\": \"Bare aside is kept: without it, requests such as \\\"run aside on the pricing page\\\" or \\\"open aside and log in\\\" name the tool and still defer. Stage two only runs after the advisor picks this hub, so ordinary-prose uses of the word never reach it.\",\n      \"keywords\": [\n        \"aside\",\n        \"aside browser\",\n        \"aside cli\",\n        \"aside mcp\",\n        \"aside repl\",\n        \"aside daemon\",\n        \"aside account\",\n        \"aside devtools\",\n        \"mcp-aside-devtools\"\n      ]\n    },\