manifestFingerprint(hubId) {\n  try {\n    return crypto.createHash('sha256')\n      .update(fs.readFileSync(path.join(ACTIVATION_ROOT, hubId, 'manifest.json')))\n      .digest('hex');\n  } catch {\n    return 'no-manifest';\n  }\n}\n\nfunction loadHubEngine(hubId) {\n  // Key on the manifest fingerprint so a flip invalidates a stale cached engine\n  // while an unchanged manifest still hits the cache within a process.\n  const cacheKey = `${hubId}::${manifestFingerprint(hubId)}`;\n  if (engineCache.has(cacheKey)) return engineCache.get(cacheKey);\n  const child = HUB_CHILD[hubId];\n  if (!child) throw new Error(`unknown hub: ${hubId}`);\n  const childRoot = path.join(IMPL_ROOT, child);\n  // Relative requires inside these modules resolve from their own location, so\n  // reusing them from here keeps the compiled contract's dependency graph intact.\n  const { loadSnapshot } = require(path.join(childRoot, 'harness', 'build-artifacts.cjs'));\n  // Hubs ship one of two engine module shapes: the surfaceBundle canary-router\n  // (evaluateCanary) or the plain router (evaluateRoute). Both take\n  // (snapshot, input) and return a { decision } — pick whichever this hub has.\n  const canaryRouter = path.join(childRoot, 'lib', 'canary-router.cjs');\n  const plainRouter = path.join(childRoot, 'lib', 'router.cjs');\n  const routerPath = fs.existsSync(canaryRouter) ? canaryRouter\n    : (fs.existsSync(plainRouter) ? plainRouter : null);\n  if (!routerPath) throw new Error(`no compiled router module for hub ${hubId}`);\n  const routerMod = require(routerPath);\n  // The export name varies by archetype (evaluateCanary or evaluateRoute); both\n  // share the (snapshot, input) -> { decision } contract.\n  const evaluate = routerMod.evaluateCanary || routerMod.evaluateRoute;\n  if (typeof evaluate !== 'function') {\n    throw new Error(`no evaluate function exported by ${routerPath} for hub ${hubId}`);\n  }\n  const { snapshot } = loadSnapshot();\n  // Only a router that knows its hub's surface packets exports applySurfaceHint,\n  // so a hub without one serves the compiled order whatever hint arrives.\n  const applySurfaceHint = typeof routerMod.applySurfaceHint === 'function' ? routerMod.applySurfaceHint : null;\n  const engine = Object.freeze({ snapshot, evaluate, applySurfaceHint });\n  engineCache.set(cacheKey, engine);\n  return engine;\n}\n\nfunction normalizeTargets(route) {\n  if (!route || !Array.isArray(route.targets)) return [];\n  return route.targets\n    .map((t) => t.qualifiedId || t.destinationId || t.skillId || null)\n    .filter(Boolean);\n}\n\n// Route `taskText` through hub `hubId`'s compiled contract. Returns a normalized,\n// serializable decision; `action` is one of route/clarify/defer/reject.\n// `options.surfaceHint` names the surface the caller's session works in. The\n// evaluation receives it, because a surface it adds changes the route's kind and\n// the route must be validated with that surface in it. The validated targets are\n// then reordered so the hinted surface leads. A call without it serves exactly\n// the compiled order.\nfunction compiledRoute(hubId, taskText, options = {}) {\n  const { snapshot, evaluate, applySurfaceHint } = loadHubEngine(hubId);\n  // Only a router that knows its hub's surface packets takes the hint.\n  const hinted = Boolean(applySurfaceHint) && typeof options.surfaceHint === 'string';\n  const evaluated = evaluate(snapshot, hinted\n    ? { prompt: taskText, surfaceHint: options.surfaceHint }\n    : { prompt: taskText });\n  let route = evaluated.decision.route || null;\n  if (route && hinted) {\n    route = { ...route, targets: applySurfaceHint(snapshot, route.targets, options.surfaceHint) };\n  }\n  return {\n    hubId,\n    action: evaluated.decision.action,\n    selectionKind: route ? route.selectionKind : null,\n    targets: normalizeTargets(route),\n    effectivePolicyHash: snapshot.policy.effectivePolicyHash,\n    generation: snapshot.policy.activationGeneration,\n  };\n}\n\nmodule.exports = { compiledRoute, loadHubEngine, HUB_CHILD };","is_error":false}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"073b7014-d87f-4792-88cd-7a8132ba70bb","timestamp":"2026-11-21T22:33:37.270Z","tool_use_result":{"stdout":".skilled/bin/lib/compiled-routing/009-parent-hub-rollout/004-cli-external-orchestration/lib/router.cjs:219:      decision: reject('forbidden'),\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/003-mcp-tooling/lib/router.cjs:145:  if (constraints.has('forbidden') || text.includes('forbidden')) {\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/003-mcp-tooling/lib/router.cjs:146:    decision = negative('reject', { reason: 'forbidden' });\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs:308:  if (constraints.has('forbidden') || text.includes('forbidden')) {\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs:309:    decision = negative('reject', { reason: 'forbidden' });\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/001-sk-code/lib/canary-router.cjs:337:  if (constraints.has('forbidden') || text.includes('forbidden')) {\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/001-sk-code/lib/canary-router.cjs:338:    decision = negative('reject', { reason: 'forbidden' });\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/router.cjs:107:  if (constraints.has('forbidden') || text.includes('forbidden')) {\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/router.cjs:108:    decision = negative('reject', { reason: 'forbidden' });\n.skilled/bin/lib/compiled-routing/009-parent-hub-rollout/009-sk-design/lib/canary-router.cjs:302:  if (constraints.has('forbidden') || text.includes('forbidden')) {\n\n\nconst engineCache = new Map();\n\n// Fingerprint the hub's activation manifest. A read failure yields a stable\n// sentinel so a route never throws on a missing or unreadable manifest; the\n// downstream HUB_CHILD check still rejects an unknown hub.\nfunction manifestFingerprint(hubId) {\n  try {\n    return crypto.createHash('sha256')\n      .update(fs.readFileSync(path.join(ACTIVATION_ROOT, hubId, 'manifest.json')))\n      .digest('hex');\n  } catch {\n    return 'no-manifest';\n  }\n}\n\nfunction loadHubEngine(hubId) {\n  // Key on the manifest fingerprint so a flip invalidates a stale cached engine\n  // while an unchanged manifest still hits the cache within a process.\n  const cacheKey = `${hubId}::${manifestFingerprint(hubId)}`;\n  if (engineCache.has(cacheKey)) return engineCache.get(cacheKey);\n  const child = HUB_CHILD[hubId];\n  if (!child) throw new Error(`unknown hub: ${hubId}`);\n  const childRoot = path.join(IMPL_ROOT, child);\n  // Relative requires inside these modules resolve from their own location, so\n  // reusing them from here keeps the compiled contract's dependency graph intact.\n  const { loadSnapshot } = require(path.join(childRoot, 'harness', 'build-artifacts.cjs'));\n  // Hubs ship one of two engine module shapes: the surfaceBundle canary-router\n  // (evaluateCanary) or the plain router (evaluateRoute). Both take\n  // (snapshot, input) and return a { decision } — pick whichever this hub has.\n  const canaryRouter = path.join(childRoot, 'lib', 'canary-router.cjs');\n  const plainRouter = path.join(childRoot, 'lib', 'router.cjs');\n  const routerPath = fs.existsSync(canaryRouter) ? canaryRouter\n    : (fs.existsSync(plainRouter) ? plainRouter : null);\n  if (!routerPath) throw new Error(`no compiled router module for hub ${hubId}`);\n  const routerMod = require(routerPath);\n  // The export name varies by archetype (evaluateCanary or evaluateRoute); both\n  // share the (snapshot, input) -> { decision } contract.\n  const evaluate = routerMod.evaluateCanary || routerMod.evaluateRoute;\n  if (typeof evaluate !== 'function') {\n    throw new Error(`no evaluate function exported by ${routerPath} for hub ${hubId}`);\n  }\n  const { snapshot } = loadSnapshot();\n  // Only a router that knows its hub's surface packets exports applySurfaceHint,\n  // so a hub without one serves the compiled order whatever hint arrives.\n  const applySurfaceHint = typeof routerMod.applySurfaceHint === 'function' ? routerMod.applySurfaceHint : null;\n  const engine = Object.freeze({ snapshot, evaluate, applySurfaceHint });\n  engineCache.set(cacheKey, engine);\n  return engine;\n}\n\nfunction normalizeTargets(route) {\n  if (!route || !Array.isArray(route.targets)) return [];\n  return route.targets\n    .map((t) => t.qualifiedId || t.destinationId || t.skillId || null)\n    .filter(Boolean);\n}\n\n// Route `taskText` through hub `hubId`'s compiled contract. Returns a normalized,\n// serializable decision; `action` is one of route/clarify/defer/reject.\n// `options.surfaceHint` names the surface the caller's session works in. The\n// evaluation receives it, because a surface it adds changes the route's kind and\n// the route must be validated with that surface in it. The validated targets are\n// then reordered so the hinted surface leads. A call without it serves exactly\n// the compiled order.\nfunction compiledRoute(hubId, taskText, options = {}) {\n  const { snapshot, evaluate, applySurfaceHint } = loadHubEngine(hubId);\n  // Only a router that knows its hub's surface packets takes the hint.\n  const hinted = Boolean(applySurfaceHint) && typeof options.surfaceHint === 'string';\n  const evaluated = evaluate(snapshot, hinted\n    ? { prompt: taskText, surfaceHint: options.surfaceHint }\n    : { prompt: taskText });\n  let route = evaluated.decision.route || null;\n  if (route && hinted) {\n    route = { ...route, targets: applySurfaceHint(snapshot, route.targets, options.surfaceHint) };\n  }\n  return {\n    hubId,\n    action: evaluated.decision.action,\n    selectionKind: route ? route.selectionKind : null,\n    targets: normalizeTargets(route),\n    effectivePolicyHash: snapshot.policy.effectivePolicyHash,\n    generation: snapshot.policy.activationGeneration,\n  };\n}\n\nmodule.exports = { compiledRoute, loadHubEngine, HUB_CHILD };","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[],"moreFiles":0,"unavailable":true}},"tool_result_meta":[{"id":"toolu_01CCxfmZbjASgYumdSzAcxaN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
