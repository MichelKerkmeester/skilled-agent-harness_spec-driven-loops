{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MRBbGh1dmwrPuxLKLVY9SZ","type":"tool_result","content":"      59 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/policy-card.cjs\n     338 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/registry-compiler.cjs\n     157 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/router.cjs\n     228 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/harness/build-artifacts.cjs\n     782 total\n     1\t'use strict';\n     2\t\n     3\t// This router scores directly against the routingModel that registry-compiler.cjs\n     4\t// builds from hub-router.json. It does not go through the generic\n     5\t// destinationGraph detector and selector evaluator, because the authored routing\n     6\t// contract is the weighted vocabulary scorer in hub-router.json: a prompt scores\n     7\t// each mode by its distinct keyword matches times the mode's weight, near-ties\n     8\t// within ambiguityDelta route together in tie-break order, and a prompt that\n     9\t// matches no mode defers because the hub declares no default mode. The generic\n    10\t// policy is still compiled and hashed for the policy card and provenance.\n    11\t\n    12\tconst {\n    13\t  computeRequestFactsHash,\n    14\t} = require('../../../003-contract-schemas/lib/canonical.cjs');\n    15\tconst {\n    16\t  parseRouteDecision,\n    17\t} = require('../../../005-decision-evaluator/lib/decision-contract.cjs');\n    18\t\n    19\tfunction normalize(value) {\n    20\t  return String(value).trim().toLowerCase();\n    21\t}\n    22\t\n    23\t// A hyphenated and a spaced prompt name the same thing, so both sides fold\n    24\t// hyphen runs to one space and collapse whitespace before comparing.\n    25\tfunction spaced(value) {\n    26\t  return String(value).replace(/-+/g, ' ').replace(/\\s+/g, ' ').trim();\n    27\t}\n    28\t\n    29\tfunction containsSignal(text, value) {\n    30\t  return spaced(text).includes(spaced(normalize(value)));\n    31\t}\n    32\t\n    33\tfunction requestFor(snapshot, input) {\n    34\t  const request = {\n    35\t    evidence: [],\n    36\t    observations: [{ kind: 'intent', value: input.prompt || '' }],\n    37\t    pinnedActivationGeneration: snapshot.policy.activationGeneration,\n    38\t    schemaVersion: 'V1',\n    39\t  };\n    40\t  request.requestFactsHash = computeRequestFactsHash(request);\n    41\t  return request;\n    42\t}\n    43\t\n    44\tfunction target(destination) {\n    45\t  return {\n    46\t    authorityRef: destination.authorityRef,\n    47\t    destinationId: destination.id,\n    48\t    mutatesWorkspace: destination.mutatesWorkspace,\n    49\t    role: destination.role,\n    50\t  };\n    51\t}\n    52\t\n    53\tfunction negative(action, payload) {\n    54\t  return parseRouteDecision({ action, [action]: { ...payload, authority: 'Withheld' }, schemaVersion: 'V1' });\n    55\t}\n    56\t\n    57\tfunction route(snapshot, selectionKind, modes) {\n    58\t  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    59\t    [destination.id.workflowMode, destination]\n    60\t  )));\n    61\t  return parseRouteDecision({\n    62\t    action: 'route',\n    63\t    route: {\n    64\t      authority: 'WithheldUntilVerify',\n    65\t      basis: { kind: 'signal' },\n    66\t      evidence: [],\n    67\t      selectionKind,\n    68\t      targets: modes.map((mode) => target(byMode.get(mode))),\n    69\t    },\n    70\t    schemaVersion: 'V1',\n    71\t  }, snapshot.policy);\n    72\t}\n    73\t\n    74\t// A vocabulary that lists both spellings of one phrase names it once, so the\n    75\t// fold-deduped count keeps a single mention worth one hit rather than two.\n    76\tfunction scoreModes(routingModel, text) {\n    77\t  return routingModel.modes.map((mode) => {\n    78\t    const matched = new Set(mode.keywords\n    79\t      .filter((keyword) => containsSignal(text, keyword))\n    80\t      .map((keyword) => spaced(normalize(keyword))));\n    81\t    return { mode: mode.workflowMode, score: matched.size * mode.weight };\n    82\t  }).filter((entry) => entry.score > 0);\n    83\t}\n    84\t\n    85\t// Keep every mode within ambiguityDelta of the top score. The hub's outcomes\n    86\t// declare single, orderedBundle and defer only, so a near-tie routes every tied\n    87\t// mode as a bundle rather than asking for clarification.\n    88\tfunction selectNearTiedModes(scores, ambiguityDelta) {\n    89\t  if (scores.length === 0) return [];\n    90\t  const top = scores[0].score;\n    91\t  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n    92\t}\n    93\t\n    94\tfunction exactBundle(routingModel, orderedModes) {\n    95\t  const candidate = orderedModes.join(' ');\n    96\t  return routingModel.bundleRules.find((rule) => (\n    97\t    rule.targetWorkflowModes.join(' ') === candidate\n    98\t  )) || null;\n    99\t}\n   100\t\n   101\tfunction evaluateRoute(snapshot, input) {\n   102\t  const request = requestFor(snapshot, input);\n   103\t  const text = normalize(input.prompt || '');\n   104\t  const constraints = new Set((input.constraints || []).map(normalize));\n   105\t  let decision;\n   106\t  let scores = [];\n   107\t  // A reject comes only from the caller's constraints. Prompt text is user content, and a\n   108\t  // request that merely mentions the word, such as a 403 Forbidden debugging task, is routable.\n   109\t  if (constraints.has('forbidden')) {\n   110\t    decision = negative('reject', { reason: 'forbidden' });\n   111\t  } else if (constraints.has('dependency-failure')) {\n   112\t    decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n   113\t  } else {\n   114\t    scores = scoreModes(snapshot.routingModel, text);\n   115\t    const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n   116\t    scores.sort((left, right) => (\n   117\t      right.score - left.score || order.get(left.mode) - order.get(right.mode)\n   118\t    ));\n   119\t    const selected = selectNearTiedModes(scores, snapshot.routingModel.ambiguityDelta);\n   120\t    if (selected.length === 0) {\n   121\t      decision = snapshot.routingModel.defaultMode == null\n   122\t        ? negative('defer', { reason: 'no-match', recovery: ['defer'] })\n   123\t        : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n   124\t    } else if (selected.length === 1) {\n   125\t      decision = route(snapshot, 'single', selected);\n   126\t    } else {\n   127\t      const ordered = [...selected].sort((left, right) => order.get(left) - order.get(right));\n   128\t      const bundle = exactBundle(snapshot.routingModel, ordered);\n   129\t      decision = route(snapshot, bundle ? bundle.kind : 'orderedBundle', ordered);\n   130\t    }\n   131\t  }\n   132\t  return {\n   133\t    decision,\n   134\t    request,\n   135\t    trace: {\n   136\t      matchedScores: scores,\n   137\t      outcome: decision.action === 'route' ? decision.route.selectionKind : decision.action,\n   138\t    },\n   139\t  };\n   140\t}\n   141\t\n   142\tfunction advisorContribution(snapshot, advisor) {\n   143\t  if (!advisor || advisor.state === 'absent' || advisor.state === 'unavailable') {\n   144\t    return { contributes: false, reason: 'advisor-zero-evidence' };\n   145\t  }\n   146\t  if (advisor.state !== 'live') return { contributes: false, reason: 'advisor-annotation-only' };\n   147\t  if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n   148\t    || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n   149\t    return { contributes: false, reason: 'advisor-drift-annotation-only' };\n   150\t  }\n   151\t  return { contributes: true, reason: 'advisor-live-identity-match' };\n   152\t}\n   153\t\n   154\tmodule.exports = {\n   155\t  advisorContribution,\n   156\t  evaluateRoute,\n   157\t};","is_error":false}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:46:31.320Z","tool_use_result":{"stdout":"      59 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/policy-card.cjs\n     338 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/registry-compiler.cjs\n     157 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/router.cjs\n     228 .skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/harness/build-artifacts.cjs\n     782 total\n     1\t'use strict';\n     2\t\n     3\t// This router scores directly against the routingModel that registry-compiler.cjs\n     4\t// builds from hub-router.json. It does not go through the generic\n     5\t// destinationGraph detector and selector evaluator, because the authored routing\n     6\t// contract is the weighted vocabulary scorer in hub-router.json: a prompt scores\n     7\t// each mode by its distinct keyword matches times the mode's weight, near-ties\n     8\t// within ambiguityDelta route together in tie-break order, and a prompt that\n     9\t// matches no mode defers because the hub declares no default mode. The generic\n    10\t// policy is still compiled and hashed for the policy card and provenance.\n    11\t\n    12\tconst {\n    13\t  computeRequestFactsHash,\n    14\t} = require('../../../003-contract-schemas/lib/canonical.cjs');\n    15\tconst {\n    16\t  parseRouteDecision,\n    17\t} = require('../../../005-decision-evaluator/lib/decision-contract.cjs');\n    18\t\n    19\tfunction normalize(value) {\n    20\t  return String(value).trim().toLowerCase();\n    21\t}\n    22\t\n    23\t// A hyphenated and a spaced prompt name the same thing, so both sides fold\n    24\t// hyphen runs to one space and collapse whitespace before compari