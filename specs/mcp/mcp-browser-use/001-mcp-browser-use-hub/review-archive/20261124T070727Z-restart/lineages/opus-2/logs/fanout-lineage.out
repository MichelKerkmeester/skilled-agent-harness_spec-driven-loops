ry.json\nREADME.md\nROUTER.md\nshared\nSKILL.md\n{\"skill\":\"mcp-browser-use\",\"version\":\"1.1.1.0\",\"resourceContractVersion\":1,\"description\":\"Declarative mode registry: the single source of truth for the discriminator (workflowMode, packetKind, backendKind) and the advisorRouting projection for mcp-browser-use. The hub reads this file to resolve a mo\nmodes [ 'mcp-chrome-devtools', 'mcp-aside-devtools', 'mcp-bladebro' ]\ntooling [\n  'mcp-click-up',\n  'mcp-figma',\n  'mcp-refero',\n  'mcp-mobbin',\n  'mcp-obsidian',\n  'mcp-notion'\n]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012k7K3NZ5RKUws3yEBsUNYv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
