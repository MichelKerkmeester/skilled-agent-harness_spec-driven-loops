},\"data\":{\"mode\":\"{adjudication_mode}\",\"run\":{adjudication_run},\"passed\":{adjudicati\n2429:        note: \"Every earlier reducer pass ran before closeout wrote synthesis_complete and before the status flip, so the dashboard would keep its pre-completion status. A fan-out root keeps no r","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AF7DMXCk6HJgAgmH3CdqfG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
