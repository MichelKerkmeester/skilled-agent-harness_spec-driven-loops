n scoreModes(routingModel, text) {\n    77\t  return routingModel.modes.map((mode) => {\n    78\t    const matched = new Set(mode.keywords\n    79\t      .filter((keyword) => containsSignal(text, keyword))\n    80\t      .map((keyword) => spaced(normalize(keyword))));\n    81\t    return { mode: mode.workflowMode, score: matched.size * mode.weight };\n    82\t  }).filter((entry) => entry.score > 0);\n    83\t}\n    84\t\n    85\t// Keep every mode within ambiguityDelta of the top score. The hub's outcomes\n    86\t// declare single, orderedBundle and defer only, so a near-tie routes every tied\n    87\t// mode as a bundle rather than asking for clarification.\n    88\tfunction selectNearTiedModes(scores, ambiguityDelta) {\n    89\t  if (scores.length === 0) return [];\n    90\t  const top = scores[0].score;\n    91\t  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n    92\t}\n    93\t\n    94\tfunction exactBundle(routingModel, orderedModes) {\n    95\t  const candidate = orderedModes.join(' ');\n    96\t  return routingModel.bundleRules.find((rule) => (\n    97\t    rule.targetWorkflowModes.join(' ') === candidate\n    98\t  )) || null;\n    99\t}\n   100\t\n   101\tfunction evaluateRoute(snapshot, input) {\n   102\t  const request = requestFor(snapshot, input);\n   103\t  const text = normalize(input.prompt || '');\n   104\t  const constraints = new Set((input.constraints || []).map(normalize));\n   105\t  let decision;\n   106\t  let scores = [];\n   107\t  // A reject comes only from the caller's constraints. Prompt text is user content, and a\n   108\t  // request that merely mentions the word, such as a 403 Forbidden debugging task, is routable.\n   109\t  if (constraints.has('forbidden')) {\n   110\t    decision = negative('reject', { reason: 'forbidden' });\n   111\t  } else if (constraints.has('dependency-failure')) {\n   112\t    decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n   113\t  } else {\n   114\t    scores = scoreModes(snapshot.routingModel, text);\n   115\t    const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n   116\t    scores.sort((left, right) => (\n   117\t      right.score - left.score || order.get(left.mode) - order.get(right.mode)\n   118\t    ));\n   119\t    const selected = selectNearTiedModes(scores, snapshot.routingModel.ambiguityDelta);\n   120\t    if (selected.length === 0) {\n   121\t      decision = snapshot.routingModel.defaultMode == null\n   122\t        ? negative('defer', { reason: 'no-match', recovery: ['defer'] })\n   123\t        : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n   124\t    } else if (selected.length === 1) {\n   125\t      decision = route(snapshot, 'single', selected);\n   126\t    } else {\n   127\t      const ordered = [...selected].sort((left, right) => order.get(left) - order.get(right));\n   128\t      const bundle = exactBundle(snapshot.routingModel, ordered);\n   129\t      decision = route(snapshot, bundle ? bundle.kind : 'orderedBundle', ordered);\n   130\t    }\n   131\t  }\n   132\t  return {\n   133\t    decision,\n   134\t    request,\n   135\t    trace: {\n   136\t      matchedScores: scores,\n   137\t      outcome: decision.action === 'route' ? decision.route.selectionKind : decision.action,\n   138\t    },\n   139\t  };\n   140\t}\n   141\t\n   142\tfunction advisorContribution(snapshot, advisor) {\n   143\t  if (!advisor || advisor.state === 'absent' || advisor.state === 'unavailable') {\n   144\t    return { contributes: false, reason: 'advisor-zero-evidence' };\n   145\t  }\n   146\t  if (advisor.state !== 'live') return { contributes: false, reason: 'advisor-annotation-only' };\n   147\t  if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n   148\t    || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n   149\t    return { contributes: false, reason: 'advisor-drift-annotation-only' };\n   150\t  }\n   151\t  return { contributes: true, reason: 'advisor-live-identity-match' };\n   152\t}\n   153\t\n   154\tmodule.exports = {\n   155\t  advisorContribution,\n   156\t  evaluateRoute,\n   157\t};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[],"moreFiles":0,"unavailable":true}},"tool_result_meta":[{"id":"toolu_01MRBbGh1dmwrPuxLKLVY9SZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
