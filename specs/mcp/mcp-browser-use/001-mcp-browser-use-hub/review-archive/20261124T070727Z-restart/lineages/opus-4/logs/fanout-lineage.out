.file, dimension: x.dimension, iteration: s.iteration })));\n(s.traceability || []).forEach((t) => lines.push(JSON.stringify({ type: 'traceability_check', protocolId: t.protocolId, status: t.status, iteration: s.iteration })));\n(s.ruledOut || []).forEach((r) => lines.push(JSON.stringify({ type: 'ruled_out', direction: r.direction, reason: r.reason, iteration: s.iteration })));\nif (fs.existsSync(deltaOut)) { console.error('delta exists'); process.exit(1); }\nfs.writeFileSync(deltaOut, lines.join('\\n') + '\\n');\nconsole.log('built', rec.findingsCount, JSON.stringify(sum));\nEOF\ncat > $L/prompts/spec-001.json <<'EOF'\n{\"iteration\":1,\"focus\":\"correctness: goal criteria re-check across phases 001-013\",\"dimensions\":[\"correctness\"],\n\"filesReviewed\":[\"specs/mcp/mcp-browser-use/001-mcp-browser-use-hub/goal.md:91\",\"specs/mcp/mcp-browser-use/001-mcp-browser-use-hub/003-mode-relocation/goal.md\",\"specs/mcp/mcp-browser-use/001-mcp-browser-use-hub/004-bladebro-mode/spec.md:91\",\".skilled/skills/mcp-browser-use/mode-registry.json\",\".skilled/skills/mcp-tooling/mode-registry.json\",\".skilled/bin/lib/compiled-routing/009-parent-hub-rollout/010-mcp-browser-use/lib/router.cjs:107\",\".skilled/commands/doctor/assets/mcp-mutation-class-manifest.yaml:45\",\".skilled/scripts/git-hooks/pre-commit:726\",\".skilled/commands/doctor/scripts/check-mcp-mutation-class.sh:148\",\".skilled/skills/mcp-browser-use/mcp-bladebro/SKILL.md:112\",\".utcp_config.json\",\".skilled/skills/mcp-browser-use/mcp-chrome-devtools/feature-catalog/feature-catalog.md:243\",\".skilled/skills/mcp-browser-use/mcp-chrome-devtools/scripts/install.sh:88\"],\n\"findings\":[],\n\"traceability\":[{\"protocolId\":\"spec_code\",\"status\":\"pass\",\"gateClass\":\"hard\",\"applicable\":true,\"evidence\":[\"specs/mcp/mcp-browser-use/001-mcp-browser-use-hub/004-bladebro-mode/spec.md:91\",\".skilled/skills/mcp-browser-use/mcp-bladebro/SKILL.md:112\",\".skilled/bin/lib/compiled-routing/009-parent-hub-rollout