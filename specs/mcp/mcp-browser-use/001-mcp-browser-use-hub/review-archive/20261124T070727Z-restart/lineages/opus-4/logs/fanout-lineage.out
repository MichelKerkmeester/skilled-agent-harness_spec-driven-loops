hrome_path\n341:    if chrome_path=$(detect_chrome_path); then\n342:        log_success \"Chrome found: ${chrome_path}\"\n344:        if chrome_at_default_location; then\n345:            log_info \"Chrome is at default location, no CHROME_PATH needed\"\n347:            log_warn \"Chrome is not at default location\"\n348:            log_info \"CHROME_PATH should be set to: ${chrome_path}\"\n351:                add_chrome_path_to_profile \"$chrome_path\"\n353:                export CHROME_PATH=\"$chrome_path\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01A9qJsW6fcwLQb9PgYbVFgG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
