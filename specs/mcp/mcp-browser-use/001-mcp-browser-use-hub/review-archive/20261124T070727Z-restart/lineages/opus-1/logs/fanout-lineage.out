m-spec-kit` share on those prompts.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RogDN27AuSu7htRS8hHUVS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
