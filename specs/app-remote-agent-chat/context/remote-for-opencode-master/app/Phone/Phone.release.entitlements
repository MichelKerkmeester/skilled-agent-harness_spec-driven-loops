<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release entitlements. Identical to the generated Debug set except for
  aps-environment, which MUST be production in a store or TestFlight build:
  a development APNs token is rejected by the production gateway, so push
  fails silently — the single easiest way to ship a broken notification
  feature and not find out until users report it.

  Hand-maintained rather than generated, because xcodegen emits one
  entitlements file per target and this is the one value that differs by
  configuration. Keep the two files in step.
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.timwilliams.opencodego</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
