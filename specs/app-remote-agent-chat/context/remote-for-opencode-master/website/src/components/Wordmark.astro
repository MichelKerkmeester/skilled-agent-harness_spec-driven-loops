---
// The wordmark, drawn on the same 4x5 module grid as the app and the icon
// (see RemoteKit's Glyphs, tools/mark/generate.py). It is geometry, not type —
// so no font ships, and it is identical across app, icon and site by
// construction rather than by eye.
interface Props {
  height?: number;
  text?: string;
}
const { height = 18, text = "REMOTE FOR OPENCODE" } = Astro.props;

const GLYPHS: Record<string, string[]> = {
  O: ["####", "#..#", "#..#", "#..#", "####"],
  P: ["####", "#..#", "####", "#...", "#..."],
  E: ["####", "#...", "####", "#...", "####"],
  N: ["#..#", "##.#", "#.##", "#..#", "#..#"],
  C: ["####", "#...", "#...", "#...", "####"],
  D: ["###.", "#..#", "#..#", "#..#", "###."],
  G: ["####", "#...", "#.##", "#..#", "####"],
  F: ["####", "#...", "####", "#...", "#..."],
  R: ["####", "#..#", "####", "#.#.", "#..#"],
  M: ["#..#", "####", "#..#", "#..#", "#..#"],
  T: ["####", ".#..", ".#..", ".#..", ".#.."],
};
const ROWS = 5;
const GLYPH_W = 4;
const GAP = 1;

const cells: [number, number][] = [];
let x = 0;
for (const [i, ch] of [...text].entries()) {
  if (i > 0) x += GAP;
  const glyph = GLYPHS[ch];
  if (!glyph) {
    x += GAP + 2; // space
    continue;
  }
  glyph.forEach((line, row) =>
    [...line].forEach((mark, col) => {
      if (mark === "#") cells.push([x + col, row]);
    }),
  );
  x += GLYPH_W;
}
const width = x;
const cell = Math.max(1, Math.round(height / ROWS));
---

<svg
  width={cell * width}
  height={cell * ROWS}
  viewBox={`0 0 ${width} ${ROWS}`}
  shape-rendering="crispEdges"
  role="img"
  aria-label={text === "REMOTE FOR OPENCODE" ? "Remote for OpenCode" : text}
>
  {cells.map(([cx, cy]) => <rect x={cx} y={cy} width="1" height="1" fill="currentColor" />)}
</svg>
