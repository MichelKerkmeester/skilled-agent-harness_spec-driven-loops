          Database Testbed/Records/08 — Customer Interviews Round Two.md: xmiA
      galleryImageField: ""
      galleryImageAspectRatio: 0.75
      galleryCardSize: 250
      galleryImageFit: cover
      boardImageField: ""
      boardImageAspectRatio: 0.75
      boardImageFit: cover
      showEmptyFields: false
      listCompactFields: false
      statusPresets: []
      defaultStatusPresetId: ""
      filterLogic: and
      filters: []
      summaryRules:
        - field: amount
          summary: SUM
        - field: budget
          summary: SUM
        - field: net
          summary: AVERAGE
        - field: margin
          summary: AVERAGE
      conditionalFormats:
        - id: cf-blocked
          condition:
            field: status
            op: eq
            value: Blocked
          valueSource: literal
          target: record
          bold: true
          color: red
      chartType: bar
      chartGroupField: ""
      chartDateBucket: ""
      chartNumberBucket: ""
      chartStackField: ""
      chartSeriesField: ""
      chartAggregation: count
      chartValueField: ""
