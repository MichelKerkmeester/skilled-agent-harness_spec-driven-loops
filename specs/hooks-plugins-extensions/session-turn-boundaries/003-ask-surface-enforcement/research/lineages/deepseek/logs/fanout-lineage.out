metadata.json\nhub-router.json\nleaf-manifest.json\nmanual-testing-playbook\nmode-registry.json\nREADME.md\nROUTER.md\nshared\nSKILL.md\n=== HERMES DIR ===\nno .hermes\n=== SKILL REFS ===\n.skilled/skills/cli-external-orchestration/cli-cursor/references:\nagent-delegation.md\ncli-reference.md\ncursor-tools.md\nhook-contract.md\nintegration-patterns.md\nproviders-and-models.md\nshared-editor-config.md\n\n.skilled/skills/cli-external-orchestration/cli-deepseek-harness/references:\ncli-reference.md\nfanout-executor.md\nguards-and-hooks.md\nmcp.md\nproviders-and-models.md\nrepin-runbook.md\nruntime-folder-and-sync.md\n\n.skilled/skills/cli-external-orchestration/cli-devin/references:\nagent-delegation.md\ncli-reference.md\ncloud-handoff.md\ndevin-tools.md\nintegration-patterns.md\nproviders-and-models.md\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"ls .skilled/skills/cli-external-orchestration/ 2>/dev/null; echo \\\"=== HERMES DIR ===\\\"; ls -d .hermes 2>/dev/null || echo \\\"no .hermes\\\"; echo \\\"=== SKILL REFS ===\\\"; ls .skilled/skills/cli-external-orchestration/cli-devin/references .skilled/skills/cli-external-orchestration/cli-cursor/references .skilled/skills/cli-external-orchestration/cli-deepseek-harness/references 2>/dev/null\"}"},"time":{"start":1794133480083,"end":1794133480651}}}}
