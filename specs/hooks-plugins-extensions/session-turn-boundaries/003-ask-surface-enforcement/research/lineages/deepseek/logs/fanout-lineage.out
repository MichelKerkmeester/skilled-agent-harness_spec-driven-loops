{"type":"tool_use","timestamp":1794133145932,"sessionID":"ses_e45574eb5fferLWklFUKCqoqXo","part":{"partID":"prt_1baab3928001r5JNGhXSNIp9JP","sessionID":"ses_e45574eb5fferLWklFUKCqoqXo","messageID":"msg_1baab325a001lw9xFitk5Fg7u7","type":"tool","id":"chatcmpl-tool-88d8e26ddf682ccb","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs"},"output":"Read file .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs, lines 1-283\n1: #!/usr/bin/env node\n2: 'use strict';\n3: // ───────────────────────────────────────────────────────────────────\n4: // MODULE: Hook registration synchronizer\n5: // ───────────────────────────────────────────────────────────────────\n6: // Four runtimes register their lifecycle hooks through JSON, each in its own\n7: // nesting, matcher dialect and wrapper convention, and each file used to be\n8: // kept by hand. hook-registry.json names every hook once with its concern, its\n9: // script and its per-runtime bindings; this script renders the four files from\n10: // it. Pi registers by symlink under .pi/extensions, so for Pi the registry is\n11: // verified against the directory instead of rendered.\n12: //\n13: // Usage:\n14: //   node sync-hook-registrations.cjs [--check] [--root <repo-root>]\n15: // Exit: 0 in sync (or written), 1 drift or a missing Pi symlink under --check,\n16: //       2 usage or a registry the renderer cannot honour.\n17: \n18: // ───────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ───────────────────────────────────────────────────────────────────\n21: const fs = require('node:fs');\n22: const path = require('node:path');\n23: const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ───────────────────────────────────────────────────────────────────\n28: const TAG = '[hook-registration-sync]';\n29: const REGISTRY_PATH = path.join(__dirname, 'hook-registry.json');\n30: const JSON_RUNTIMES = ['claude', 'codex', 'cursor', 'devin'];\n31: // Codex rejects any `hookSpecificOutput` key it does not define and discards\n32: // the whole response, which would swallow the very message the envelope exists\n33: // to deliver. These runtimes carry the drift marker on stderr alone.\n34: const ENVELOPE_REJECTS_UNKNOWN_KEYS = new Set(['codex']);\n35: // Codex accepts `hookSpecificOutput` only on the events that take additional\n36: // context; Stop and PreCompact reject it and discard the whole response, so\n37: // their fallback carries the message as a plain `systemMessage` instead.\n38: const SYSTEM_MESSAGE_EVENTS = new Set(['codex:Stop', 'codex:PreCompact']);\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 3. HELPERS\n42: // ───────────────────────────────────────────────────────────────────\n43: function parseArgs(argv) {\n44:   const options = { check: false, root: null };\n45:   for (let index = 0; index < argv.length; index += 1) {\n46:     const arg = argv[index];\n47:     if (arg === '--check') options.check = true;\n48:     else if (arg === '--root') { options.root = argv[index + 1]; index += 1; }\n49:     else throw new Error(`Usage: node sync-hook-registrations.cjs [--check] [--root <repo-root>] (unknown argument: ${arg})`);\n50:   }\n51:   if (options.root === undefined) throw new Error('--root requires a path');\n52:   return options;\n53: }\n54: \n55: function loadRegistry(registryPath = REGISTRY_PATH) {\n56:   return JSON.parse(fs.readFileSync(registryPath, 'utf8'));\n57: }\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 4. WRAPPER GRAMMAR\n61: // ───────────────────────────────────────────────────────────────────\n62: \n63: function fallbackEnvelope(runtime, event, message) {\n64:   if (SYSTEM_MESSAGE_EVENTS.has(`${runtime}:${event}`)) return JSON.stringify({ systemMessage: message }).replace(/\"/g, '\\\\\"');\n65:   const hookSpecificOutput = { hookEventName: event, additionalContext: message };\n66:   if (!ENVELOPE_REJECTS_UNKNOWN_KEYS.has(runtime)) hookSpecificOutput.mkHookDrift = true;\n67:   return JSON.stringify({ hookSpecificOutput }).replace(/\"/g, '\\\\\"');\n68: }\n69: \n70: /** The base invocation every wrapper shares: runner, script and arguments. */\n71: function invocation(binding) {\n72:   return `${binding.runner} ${binding.script}${binding.args ? ` ${binding.args}` : ''}`;\n73: }\n74: \n75: /**\n76:  * The command a project-dir runtime (Claude, Codex, Devin) registers: cd into\n77:  * the project, run the script, and on failure print a drift line to stderr and\n78:  * a hook-shaped envelope to stdout so the host keeps going.\n79:  */\n80: function renderProjectDirCommand(runtime, runtimeConfig, binding) {\n81:   const base = invocation(binding);\n82:   const adapter = path.posix.basename(binding.script);\n83:   const message = binding.message ?? runtimeConfig.defaultMessage;\n84:   const silence = binding.silence ? ' >/dev/null 2>&1' : '';\n85:   let inner;\n86:   switch (binding.fallback) {\n87:     case 'none': inner = `${base}${silence}`; break;\n88:     case 'background': inner = `${base} >/dev/null 2>&1 &`; break;\n89:     case 'echo': inner = `${base} >/dev/null 2>&1 || echo \"${message}\"`; break;\n90:     case 'envelope':\n91:       inner = `${base}${silence} || { printf \"%s\\\\n\" \"mk-hook-drift host=${runtime} event=${binding.event} adapter=${adapter}\" >&2; printf %s \"${fallbackEnvelope(runtime, binding.event, message)}\"; }`;\n92:       break;\n93:     default: throw new Error(`unknown fallback \"${binding.fallback}\" on ${runtime} ${binding.script}`);\n94:   }\n95:   return `bash -c 'cd \"\\${${runtimeConfig.projectDirEnv}:-$PWD}\" && ${inner}'`;\n96: }\n97: \n98: /** Cursor runs the command without a project-dir wrapper and answers with its own permission envelope. */\n99: function renderCursorCommand(runtimeConfig, binding) {\n100:   const base = invocation(binding);\n101:   if (binding.fallback === 'none') return base;\n102:   // Detached like the project-dir runtimes' background form, so a slow reconcile never holds up session start.\n103:   if (binding.fallback === 'background') return `${base} >/dev/null 2>&1 &`;\n104:   if (binding.fallback !== 'envelope') throw new Error(`cursor supports none, background or envelope fallbacks, got \"${binding.fallback}\" on ${binding.script}`);\n105:   const adapter = path.posix.basename(binding.script);\n106:   const message = binding.message ?? runtimeConfig.defaultMessage;\n107:   const envelope = JSON.stringify({ permission: 'allow', agent_message: message, mkHookDrift: true });\n108:   return `${base} || { printf \"%s\\\\n\" \"mk-hook-drift host=cursor event=${binding.event} adapter=${adapter}\" >&2; printf %s '${envelope}'; }`;\n109: }\n110: \n111: // ───────────────────────────────────────────────────────────────────\n112: // 5. PER-RUNTIME SHAPES\n113: // ───────────────────────────────────────────────────────────────────\n114: \n115: /** Bindings of one runtime, ordered by the runtime's event order, then group, then slot. */\n116: function bindingsFor(registry, runtime) {\n117:   const order = registry.runtimes[runtime].eventOrder;\n118:   const rows = [];\n119:   for (const hook of registry.hooks) {\n120:     for (const binding of hook.bindings[runtime] ?? []) rows.push({ hook, binding });\n121:   }\n122:   rows.sort((a, b) => {\n123:     const byEvent = order.indexOf(a.binding.event) - order.indexOf(b.binding.event);\n124:     if (byEvent !== 0) return byEvent;\n125:     if (a.binding.group !== b.binding.group) return a.binding.group - b.binding.group;\n126:     return a.binding.slot - b.binding.slot;\n127:   });\n128:   return rows;\n129: }\n130: \n131: /** Rows grouped as the runtime's file groups them: by event, then by group index. */\n132: function groupedBindings(registry, runtime) {\n133:   const events = new Map();\n134:   for (const row of bindingsFor(registry, runtime)) {\n135:     const groups = events.get(row.binding.event) ?? new Map();\n136:     const group = groups.get(row.binding.group) ?? [];\n137:     group.push(row);\n138:     groups.set(row.binding.group, group);\n139:     events.set(row.binding.event, groups);\n140:   }\n141:   return events;\n142: }\n143: \n144: function groupMatcher(rows, runtime) {\n145:   const matchers = new Set(rows.map((row) => row.binding.matcher ?? null));\n146:   if (matchers.size !== 1) throw new Error(`${runtime} ${rows[0].binding.event} group ${rows[0].binding.group} mixes matchers: ${[...matchers].join(', ')}`);\n147:   return rows[0].binding.matcher ?? null;\n148: }\n149: \n150: function renderNestedEvents(registry, runtime, renderHook) {\n151:   const config = registry.runtimes[runtime];\n152:   const out = {};\n153:   for (const [event, groups] of groupedBindings(registry, runtime)) {\n154:     out[event] = [...groups.values()].map((rows) => {\n155:       const matcher = groupMatcher(rows, runtime);\n156:       const entry = {};\n157:       if (matcher !== null) entry.matcher = matcher;\n158:       entry.hooks = rows.map(({ binding }) => {\n159:         const hook = { type: 'command', command: renderHook(config, binding), timeout: binding.timeout };\n160:         if (binding.async) hook.async = true;\n161:         return hook;\n162:       });\n163:       return entry;\n164:     });\n165:   }\n166:   return out;\n167: }\n168: \n169: /** `.claude/settings.json` keeps every other key; only `hooks` is rendered. */\n170: function renderClaude(registry, current) {\n171:   const settings = current ? JSON.parse(current) : {};\n172:   settings.hooks = renderNestedEvents(registry, 'claude', (config, binding) => renderProjectDirCommand('claude', config, binding));\n173:   return settings;\n174: }\n175: \n176: function renderCodex(registry) {\n177:   return { hooks: renderNestedEvents(registry, 'codex', (config, binding) => renderProjectDirCommand('codex', config, binding)) };\n178: }\n179: \n180: function renderDevin(registry) {\n181:   return renderNestedEvents(registry, 'devin', (config, binding) => renderProjectDirCommand('devin', config, binding));\n182: }\n183: \n184: /** Cursor's file is a flat array per event, each entry carrying its own optional matcher. */\n185: function renderCursor(registry) {\n186:   const config = registry.runtimes.cursor;\n187:   const hooks = {};\n188:   for (const [event, groups] of groupedBindings(registry, 'cursor')) {\n189:     hooks[event] = [...groups.values()].flat().map(({ binding }) => {\n190:       const entry = { command: renderCursorCommand(config, binding), type: 'command' };\n191:       if (binding.matcher !== null && binding.matcher !== undefined) entry.matcher = binding.matcher;\n192:       entry.timeout = binding.timeout;\n193:       return entry;\n194:     });\n195:   }\n196:   return { version: 1, hooks };\n197: }\n198: \n199: function serialize(value) {\n200:   return `${JSON.stringify(value, null, 2)}\\n`;\n201: }\n202: \n203: /** The expected content of one runtime's registration file. */\n204: function renderRuntimeFile(registry, runtime, current) {\n205:   switch (runtime) {\n206:     case 'claude': return serialize(renderClaude(registry, current));\n207:     case 'codex': return serialize(renderCodex(registry));\n208:     case 'cursor': return serialize(renderCursor(registry));\n209:     case 'devin': return serialize(renderDevin(registry));\n210:     default: throw new Error(`no renderer for runtime ${runtime}`);\n211:   }\n212: }\n213: \n214: // ───────────────────────────────────────────────────────────────────\n215: // 6. PI VERIFICATION\n216: // ───────────────────────────────────────────────────────────────────\n217: \n218: /** Every Pi extension the registry names must be a symlink that resolves to a file. */\n219: function verifyPiExtensions(registry, repoRoot) {\n220:   const dir = path.join(repoRoot, registry.runtimes.pi.extensionsDir);\n221:   const problems = [];\n222:   const expected = new Set(registry.hooks.map((hook) => hook.pi?.extension).filter(Boolean));\n223:   for (const extension of [...expected].sort()) {\n224:     const link = path.join(dir, extension);\n225:     let stat;\n226:     try { stat = fs.lstatSync(link); } catch { problems.push(`${registry.runtimes.pi.extensionsDir}/${extension}: missing`); continue; }\n227:     if (!stat.isSymbolicLink()) { problems.push(`${registry.runtimes.pi.extensionsDir}/${extension}: not a symlink`); continue; }\n228:     const target = path.resolve(dir, fs.readlinkSync(link));\n229:     if (!fs.existsSync(target) || !fs.statSync(target).isFile()) problems.push(`${registry.runtimes.pi.extensionsDir}/${extension}: dangling -> ${path.relative(repoRoot, target)}`);\n230:   }\n231:   return { checked: expected.size, problems };\n232: }\n233: \n234: // ───────────────────────────────────────────────────────────────────\n235: // 7. ENTRY\n236: // ───────────────────────────────────────────────────────────────────\n237: \n238: function main(argv) {\n239:   const options = parseArgs(argv);\n240:   const repoRoot = options.root ? path.resolve(options.root) : findRepoRoot(__dirname);\n241:   const registry = loadRegistry();\n242: \n243:   const drift = [];\n244:   let written = 0;\n245:   for (const runtime of JSON_RUNTIMES) {\n246:     const relative = registry.runtimes[runtime].file;\n247:     const target = path.join(repoRoot, relative);\n248:     const current = fs.existsSync(target) ? fs.readFileSync(target, 'utf8') : null;\n249:     if (runtime === 'claude' && current === null) { drift.push(`${relative}: missing (the settings file is never created from the registry)`); continue; }\n250:     const expected = renderRuntimeFile(registry, runtime, current);\n251:     if (current === expected) continue;\n252:     if (options.check) { drift.push(`${relative}: ${current === null ? 'missing' : 'differs from the registry'}`); continue; }\n253:     fs.writeFileSync(target, expected, 'utf8');\n254:     written += 1;\n255:   }\n256: \n257:   const pi = verifyPiExtensions(registry, repoRoot);\n258:   drift.push(...pi.problems);\n259: \n260:   if (drift.length > 0) {\n261:     console.error(`${TAG} Drift detected:`);\n262:     for (const item of drift) console.error(`${TAG} ${item}`);\n263:     return 1;\n264:   }\n265:   const hookCount = registry.hooks.length;\n266:   if (options.check) console.log(`${TAG} PASS: ${JSON_RUNTIMES.length} registration files match the ${hookCount}-hook registry; ${pi.checked} Pi extensions resolve.`);\n267:   else console.log(`${TAG} Wrote ${written} of ${JSON_RUNTIMES.length} registration files from the ${hookCount}-hook registry; ${pi.checked} Pi extensions resolve.`);\n268:   return 0;\n269: }\n270: \n271: if (require.main === module) {\n272:   try {\n273:     process.exitCode = main(process.argv.slice(2));\n274:   } catch (error) {\n275:     console.error(`${TAG} ERROR: ${error.message}`);\n276:     process.exitCode = 2;\n277:   }\n278: }\n279: \n280: // ───────────────────────────────────────────────────────────────────\n281: // 8. EXPORTS\n282: // ───────────────────────────────────────────────────────────────────\n283: module.exports = { JSON_RUNTIMES, loadRegistry, renderRuntimeFile, renderProjectDirCommand, renderCursorCommand, verifyPiExtensions, main };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs, lines 1-283\n1: #!/usr/bin/env node\n2: 'use strict';\n3: // ───────────────────────────────────────────────────────────────────\n4: // MODULE: Hook registration synchronizer\n5: // ───────────────────────────────────────────────────────────────────\n6: // Four runtimes register their lifecycle hooks through JSON, each in its own\n7: // nesting, matcher dialect and wrapper convention, and each file used to be\n8: // kept by hand. hook-registry.json names every hook once with its concern, its\n9: // script and its per-runtime bindings; this script renders the four files from\n10: // it. Pi registers by symlink under .pi/extensions, so for Pi the registry is\n11: // verified against the directory instead of rendered.\n12: //\n13: // Usage:\n14: //   node sync-hook-registrations.cjs [--check] [--root <repo-root>]\n15: // Exit: 0 in sync (or written), 1 drift or a missing Pi symlink under --check,\n16: //       2 usage or a registry the renderer cannot honour.\n17: \n18: // ───────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ───────────────────────────────────────────────────────────────────\n21: const fs = require('node:fs');\n22: const path = require('node:path');\n23: const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n24: \n25: // ───────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ───────────────────────────────────────────────────────────────────\n28: const TAG = '[hook-registration-sync]';\n29: const REGISTRY_PATH = path.join(__dirname, 'hook-registry.json');\n30: const JSON_RUNTIMES = ['claude', 'codex', 'cursor', 'devin'];\n31: // Codex rejects any `hookSpecificOutput` key it does not define and discards\n32: // the whole response, which would swallow the very message the envelope exists\n33: // to deliver. These runtimes carry the drift marker on stderr alone.\n34: const ENVELOPE_REJECTS_UNKNOWN_KEYS = new Set(['codex']);\n35: // Codex accepts `hookSpecificOutput` only on the events that take additional\n36: // context; Stop and PreCompact reject it and discard the whole response, so\n37: // their fallback carries the message as a plain `systemMessage` instead.\n38: const SYSTEM_MESSAGE_EVENTS = new Set(['codex:Stop', 'codex:PreCompact']);\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 3. HELPERS\n42: // ───────────────────────────────────────────────────────────────────\n43: function parseArgs(argv) {\n44:   const options = { check: false, root: null };\n45:   for (let index = 0; index < argv.length; index += 1) {\n46:     const arg = argv[index];\n47:     if (arg === '--check') options.check = true;\n48:     else if (arg === '--root') { options.root = argv[index + 1]; index += 1; }\n49:     else throw new Error(`Usage: node sync-hook-registrations.cjs [--check] [--root <repo-root>] (unknown argument: ${arg})`);\n50:   }\n51:   if (options.root === undefined) throw new Error('--root requires a path');\n52:   return options;\n53: }\n54: \n55: function loadRegistry(registryPath = REGISTRY_PATH) {\n56:   return JSON.parse(fs.readFileSync(registryPath, 'utf8'));\n57: }\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 4. WRAPPER GRAMMAR\n61: // ───────────────────────────────────────────────────────────────────\n62: \n63: function fallbackEnvelope(runtime, event, message) {\n64:   if (SYSTEM_MESSAGE_EVENTS.has(`${runtime}:${event}`)) return JSON.stringify({ systemMessage: message }).replace(/\"/g, '\\\\\"');\n65:   const hookSpecificOutput = { hookEventName: event, additionalContext: message };\n66:   if (!ENVELOPE_REJECTS_UNKNOWN_KEYS.has(runtime)) hookSpecificOutput.mkHookDrift = true;\n67:   return JSON.stringify({ hookSpecificOutput }).replace(/\"/g, '\\\\\"');\n68: }\n69: \n70: /** The base invocation every wrapper shares: runner, script and arguments. */\n71: function invocation(binding) {\n72:   return `${binding.runner} ${binding.script}${binding.args ? ` ${binding.args}` : ''}`;\n73: }\n74: \n75: /**\n76:  * The command a project-dir runtime (Claude, Codex, Devin) registers: cd into\n77:  * the project, run the script, and on failure print a drift line to stderr and\n78:  * a hook-shaped envelope to stdout so the host keeps going.\n79:  */\n80: function renderProjectDirCommand(runtime, runtimeConfig, binding) {\n81:   const base = invocation(binding);\n82:   const adapter = path.posix.basename(binding.script);\n83:   const message = binding.message ?? runtimeConfig.defaultMessage;\n84:   const silence = binding.silence ? ' >/dev/null 2>&1' : '';\n85:   let inner;\n86:   switch (binding.fallback) {\n87:     case 'none': inner = `${base}${silence}`; break;\n88:     case 'background': inner = `${base} >/dev/null 2>&1 &`; break;\n89:     case 'echo': inner = `${base} >/dev/null 2>&1 || echo \"${message}\"`; break;\n90:     case 'envelope':\n91:       inner = `${base}${silence} || { printf \"%s\\\\n\" \"mk-hook-drift host=${runtime} event=${binding.event} adapter=${adapter}\" >&2; printf %s \"${fallbackEnvelope(runtime, binding.event, message)}\"; }`;\n92:       break;\n93:     default: throw new Error(`unknown fallback \"${binding.fallback}\" on ${runtime} ${binding.script}`);\n94:   }\n95:   return `bash -c 'cd \"\\${${runtimeConfig.projectDirEnv}:-$PWD}\" && ${inner}'`;\n96: }\n97: \n98: /** Cursor runs the command without a project-dir wrapper and answers with its own permission envelope. */\n99: function renderCursorCommand(runtimeConfig, binding) {\n100:   const base = invocation(binding);\n101:   if (binding.fallback === 'none') return base;\n102:   // Detached like the project-dir runtimes' background form, so a slow reconcile never holds up session start.\n103:   if (binding.fallback === 'background') return `${base} >/dev/null 2>&1 &`;\n104:   if (binding.fallback !== 'envelope') throw new Error(`cursor supports none, background or envelope fallbacks, got \"${binding.fallback}\" on ${binding.script}`);\n105:   const adapter = path.posix.basename(binding.script);\n106:   const message = binding.message ?? runtimeConfig.defaultMessage;\n107:   const envelope = JSON.stringify({ permission: 'allow', agent_message: message, mkHookDrift: true });\n108:   return `${base} || { printf \"%s\\\\n\" \"mk-hook-drift host=cursor event=${binding.event} adapter=${adapter}\" >&2; printf %s '${envelope}'; }`;\n109: }\n110: \n111: // ───────────────────────────────────────────────────────────────────\n112: // 5. PER-RUNTIME SHAPES\n113: // ───────────────────────────────────────────────────────────────────\n114: \n115: /** Bindings of one runtime, ordered by the runtime's event order, then group, then slot. */\n116: function bindingsFor(registry, runtime) {\n117:   const order = registry.runtimes[runtime].eventOrder;\n118:   const rows = [];\n119:   for (const hook of registry.hooks) {\n120:     for (const binding of hook.bindings[runtime] ?? []) rows.push({ hook, binding });\n121:   }\n122:   rows.sort((a, b) => {\n123:     const byEvent = order.indexOf(a.binding.event) - order.indexOf(b.binding.event);\n124:     if (byEvent !== 0) return byEvent;\n125:     if (a.binding.group !== b.binding.group) return a.binding.group - b.binding.group;\n126:     return a.binding.slot - b.binding.slot;\n127:   });\n128:   return rows;\n129: }\n130: \n131: /** Rows grouped as the runtime's file groups them: by event, then by group index. */\n132: function groupedBindings(registry, runtime) {\n133:   const events = new Map();\n134:   for (const row of bindingsFor(registry, runtime)) {\n135:     const groups = events.get(row.binding.event) ?? new Map();\n136:     const group = groups.get(row.binding.group) ?? [];\n137:     group.push(row);\n138:     groups.set(row.binding.group, group);\n139:     events.set(row.binding.event, groups);\n140:   }\n141:   return events;\n142: }\n143: \n144: function groupMatcher(rows, runtime) {\n145:   const matchers = new Set(rows.map((row) => row.binding.matcher ?? null));\n146:   if (matchers.size !== 1) throw new Error(`${runtime} ${rows[0].binding.event} group ${rows[0].binding.group} mixes matchers: ${[...matchers].join(', ')}`);\n147:   return rows[0].binding.matcher ?? null;\n148: }\n149: \n150: function renderNestedEvents(registry, runtime, renderHook) {\n151:   const config = registry.runtimes[runtime];\n152:   const out = {};\n153:   for (const [event, groups] of groupedBindings(registry, runtime)) {\n154:     out[event] = [...groups.values()].map((rows) => {\n155:       const matcher = groupMatcher(rows, runtime);\n156:       const entry = {};\n157:       if (matcher !== null) entry.matcher = matcher;\n158:       entry.hooks = rows.map(({ binding }) => {\n159:         const hook = { type: 'command', command: renderHook(config, binding), timeout: binding.timeout };\n160:         if (binding.async) hook.async = true;\n161:         return hook;\n162:       });\n163:       return entry;\n164:     });\n165:   }\n166:   return out;\n167: }\n168: \n169: /** `.claude/settings.json` keeps every other key; only `hooks` is rendered. */\n170: function renderClaude(registry, current) {\n171:   const settings = current ? JSON.parse(current) : {};\n172:   settings.hooks = renderNestedEvents(registry, 'claude', (config, binding) => renderProjectDirCommand('claude', config, binding));\n173:   return settings;\n174: }\n175: \n176: function renderCodex(registry) {\n177:   return { hooks: renderNestedEvents(registry, 'codex', (config, binding) => renderProjectDirCommand('codex', config, binding)) };\n178: }\n179: \n180: function renderDevin(registry) {\n181:   return renderNestedEvents(registry, 'devin', (config, binding) => renderProjectDirCommand('devin', config, binding));\n182: }\n183: \n184: /** Cursor's file is a flat array per event, each entry carrying its own optional matcher. */\n185: function renderCursor(registry) {\n186:   const config = registry.runtimes.cursor;\n187:   const hooks = {};\n188:   for (const [event, groups] of groupedBindings(registry, 'cursor')) {\n189:     hooks[event] = [...groups.values()].flat().map(({ binding }) => {\n190:       const entry = { command: renderCursorCommand(config, binding), type: 'command' };\n191:       if (binding.matcher !== null && binding.matcher !== undefined) entry.matcher = binding.matcher;\n192:       entry.timeout = binding.timeout;\n193:       return entry;\n194:     });\n195:   }\n196:   return { version: 1, hooks };\n197: }\n198: \n199: function serialize(value) {\n200:   return `${JSON.stringify(value, null, 2)}\\n`;\n201: }\n202: \n203: /** The expected content of one runtime's registration file. */\n204: function renderRuntimeFile(registry, runtime, current) {\n205:   switch (runtime) {\n206:     case 'claude': return serialize(renderClaude(registry, current));\n207:     case 'codex': return serialize(renderCodex(registry));\n208:     case 'cursor': return serialize(renderCursor(registry));\n209:     case 'devin': return serialize(renderDevin(registry));\n210:     default: throw new Error(`no renderer for runtime ${runtime}`);\n211:   }\n212: }\n213: \n214: // ───────────────────────────────────────────────────────────────────\n215: // 6. PI VERIFICATION\n216: // ───────────────────────────────────────────────────────────────────\n217: \n218: /** Every Pi extension the registry names must be a symlink that resolves to a file. */\n219: function verifyPiExtensions(registry, repoRoot) {\n220:   const dir = path.join(repoRoot, registry.runtimes.pi.extensionsDir);\n221:   const problems = [];\n222:   const expected = new Set(registry.hooks.map((hook) => hook.pi?.extension).filter(Boolean));\n223:   for (const extension of [...expected].sort()) {\n224:     const link = path.join(dir, extension);\n225:     let stat;\n226:     try { stat = fs.lstatSync(link); } catch { problems.push(`${registry.runtimes.pi.extensionsDir}/${extension}: missing`); continue; }\n227:     if (!stat.isSymbolicLink()) { problems.push(`${registry.runtimes.pi.extensionsDir}/${extension}: not a symlink`); continue; }\n228:     const target = path.resolve(dir, fs.readlinkSync(link));\n229:     if (!fs.existsSync(target) || !fs.statSync(target).isFile()) problems.push(`${registry.runtimes.pi.extensionsDir}/${extension}: dangling -> ${path.relative(repoRoot, target)}`);\n230:   }\n231:   return { checked: expected.size, problems };\n232: }\n233: \n234: // ───────────────────────────────────────────────────────────────────\n235: // 7. ENTRY\n236: // ───────────────────────────────────────────────────────────────────\n237: \n238: function main(argv) {\n239:   const options = parseArgs(argv);\n240:   const repoRoot = options.root ? path.resolve(options.root) : findRepoRoot(__dirname);\n241:   const registry = loadRegistry();\n242: \n243:   const drift = [];\n244:   let written = 0;\n245:   for (const runtime of JSON_RUNTIMES) {\n246:     const relative = registry.runtimes[runtime].file;\n247:     const target = path.join(repoRoot, relative);\n248:     const current = fs.existsSync(target) ? fs.readFileSync(target, 'utf8') : null;\n249:     if (runtime === 'claude' && current === null) { drift.push(`${relative}: missing (the settings file is never created from the registry)`); continue; }\n250:     const expected = renderRuntimeFile(registry, runtime, current);\n251:     if (current === expected) continue;\n252:     if (options.check) { drift.push(`${relative}: ${current === null ? 'missing' : 'differs from the registry'}`); continue; }\n253:     fs.writeFileSync(target, expected, 'utf8');\n254:     written += 1;\n255:   }\n256: \n257:   const pi = verifyPiExtensions(registry, repoRoot);\n258:   drift.push(...pi.problems);\n259: \n260:   if (drift.length > 0) {\n261:     console.error(`${TAG} Drift detected:`);\n262:     for (const item of drift) console.error(`${TAG} ${item}`);\n263:     return 1;\n264:   }\n265:   const hookCount = registry.hooks.length;\n266:   if (options.check) console.log(`${TAG} PASS: ${JSON_RUNTIMES.length} registration files match the ${hookCount}-hook registry; ${pi.checked} Pi extensions resolve.`);\n267:   else console.log(`${TAG} Wrote ${written} of ${JSON_RUNTIMES.length} registration files from the ${hookCount}-hook registry; ${pi.checked} Pi extensions resolve.`);\n268:   return 0;\n269: }\n270: \n271: if (require.main === module) {\n272:   try {\n273:     process.exitCode = main(process.argv.slice(2));\n274:   } catch (error) {\n275:     console.error(`${TAG} ERROR: ${error.message}`);\n276:     process.exitCode = 2;\n277:   }\n278: }\n279: \n280: // ───────────────────────────────────────────────────────────────────\n281: // 8. EXPORTS\n282: // ───────────────────────────────────────────────────────────────────\n283: module.exports = { JSON_RUNTIMES, loadRegistry, renderRuntimeFile, renderProjectDirCommand, renderCursorCommand, verifyPiExtensions, main };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs\"}"},"time":{"start":1794133145896,"end":1794133145932}}}}
