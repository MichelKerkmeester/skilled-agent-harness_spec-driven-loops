{"type":"tool_use","timestamp":1794133226475,"sessionID":"ses_e45574eb5fferLWklFUKCqoqXo","part":{"partID":"prt_1baac73dd001asTVE2DLsunehF","sessionID":"ses_e45574eb5fferLWklFUKCqoqXo","messageID":"msg_1baac3d2400119LbCaIWBlnk0h","type":"tool","id":"chatcmpl-tool-a9c383376f0a44c9","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '110,215p' .pi/types/pi-coding-agent.d.ts"},"output":"    usage: Usage;\n  };\n\n  /** A transcript message; `role` discriminates the union. */\n  export type AgentMessage =\n    | { role: \"system\" }\n    | { role: \"user\" }\n    | AssistantMessage\n    | { role: \"toolResult\" }\n    | { role: \"bashExecution\" }\n    | CustomMessage\n    | { role: \"branchSummary\" }\n    | { role: \"compactionSummary\" };\n\n  /** Fired when a message ends. */\n  export type MessageEndEvent = {\n    type: \"message_end\";\n    message: AgentMessage;\n  };\n  export type MessageEndEventResult = {\n    /** Replace the finalized message. The replacement must keep the original message role. */\n    message?: AgentMessage;\n  };\n\n  /** Fired when an agent loop ends. */\n  export type AgentEndEvent = {\n    type: \"agent_end\";\n    messages: AgentMessage[];\n  };\n\n  /** A run started by a submitted prompt, RPC prompt, or `pi.sendUserMessage()`. */\n  export type BeforeAgentStartUserEvent = {\n    type: \"before_agent_start\";\n    messageType: \"user\";\n    /** The current system prompt, rendered from systemPromptOptions and earlier handler changes. */\n    readonly systemPrompt: string;\n    /** The raw user prompt text (after expansion). */\n    prompt: string;\n  };\n  /** A run started by `pi.sendMessage(..., { triggerTurn: true })` while idle. */\n  export type BeforeAgentStartCustomEvent = {\n    type: \"before_agent_start\";\n    messageType: \"custom\";\n    readonly systemPrompt: string;\n    /** The custom message that starts the run. */\n    message: CustomMessage;\n  };\n  export type BeforeAgentStartEvent =\n    | BeforeAgentStartUserEvent\n    | BeforeAgentStartCustomEvent;\n  export type BeforeAgentStartEventResult = {\n    message?: Pick<\n      CustomMessage,\n      \"customType\" | \"content\" | \"display\" | \"details\"\n    >;\n    /** Replace the complete system prompt for this turn. Later handlers observe this exact override. */\n    systemPrompt?: string;\n  };\n\n  /** Handler function type for events; the result type is per-event. */\n  export type ExtensionHandler<E, R = undefined> = (\n    event: E,\n    ctx: ExtensionContext,\n  ) => Promise<R | void> | R | void;\n\n  /** The registration surface: one handler per event the extension cares about. */\n  export type ExtensionAPI = {\n    on(\n      event: \"input\",\n      handler: (event: InputEvent, ctx: ExtensionContext) => unknown,\n    ): void;\n    on(\n      event: \"tool_call\",\n      handler: (event: ToolCallEvent, ctx: ExtensionContext) => unknown,\n    ): void;\n    on(\n      event: \"before_agent_start\",\n      handler: ExtensionHandler<\n        BeforeAgentStartEvent,\n        BeforeAgentStartEventResult\n      >,\n    ): () => void;\n    on(\n      event: \"agent_end\",\n      handler: ExtensionHandler<AgentEndEvent>,\n    ): () => void;\n    on(\n      event: \"message_end\",\n      handler: ExtensionHandler<MessageEndEvent, MessageEndEventResult>,\n    ): () => void;\n    /** Send a custom message to the session. */\n    sendMessage<T = unknown>(\n      message: Pick<\n        CustomMessage<T>,\n        \"customType\" | \"content\" | \"display\" | \"details\"\n      >,\n      options?: {\n        triggerTurn?: boolean;\n        deliverAs?: \"steer\" | \"followUp\" | \"nextTurn\";\n      },\n    ): void;\n  };\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    usage: Usage;\n  };\n\n  /** A transcript message; `role` discriminates the union. */\n  export type AgentMessage =\n    | { role: \"system\" }\n    | { role: \"user\" }\n    | AssistantMessage\n    | { role: \"toolResult\" }\n    | { role: \"bashExecution\" }\n    | CustomMessage\n    | { role: \"branchSummary\" }\n    | { role: \"compactionSummary\" };\n\n  /** Fired when a message ends. */\n  export type MessageEndEvent = {\n    type: \"message_end\";\n    message: AgentMessage;\n  };\n  export type MessageEndEventResult = {\n    /** Replace the finalized message. The replacement must keep the original message role. */\n    message?: AgentMessage;\n  };\n\n  /** Fired when an agent loop ends. */\n  export type AgentEndEvent = {\n    type: \"agent_end\";\n    messages: AgentMessage[];\n  };\n\n  /** A run started by a submitted prompt, RPC prompt, or `pi.sendUserMessage()`. */\n  export type BeforeAgentStartUserEvent = {\n    type: \"before_agent_start\";\n    messageType: \"user\";\n    /** The current system prompt, rendered from systemPromptOptions and earlier handler changes. */\n    readonly systemPrompt: string;\n    /** The raw user prompt text (after expansion). */\n    prompt: string;\n  };\n  /** A run started by `pi.sendMessage(..., { triggerTurn: true })` while idle. */\n  export type BeforeAgentStartCustomEvent = {\n    type: \"before_agent_start\";\n    messageType: \"custom\";\n    readonly systemPrompt: string;\n    /** The custom message that starts the run. */\n    message: CustomMessage;\n  };\n  export type BeforeAgentStartEvent =\n    | BeforeAgentStartUserEvent\n    | BeforeAgentStartCustomEvent;\n  export type BeforeAgentStartEventResult = {\n    message?: Pick<\n      CustomMessage,\n      \"customType\" | \"content\" | \"display\" | \"details\"\n    >;\n    /** Replace the complete system prompt for this turn. Later handlers observe this exact override. */\n    systemPrompt?: string;\n  };\n\n  /** Handler function type for events; the result type is per-event. */\n  export type ExtensionHandler<E, R = undefined> = (\n    event: E,\n    ctx: ExtensionContext,\n  ) => Promise<R | void> | R | void;\n\n  /** The registration surface: one handler per event the extension cares about. */\n  export type ExtensionAPI = {\n    on(\n      event: \"input\",\n      handler: (event: InputEvent, ctx: ExtensionContext) => unknown,\n    ): void;\n    on(\n      event: \"tool_call\",\n      handler: (event: ToolCallEvent, ctx: ExtensionContext) => unknown,\n    ): void;\n    on(\n      event: \"before_agent_start\",\n      handler: ExtensionHandler<\n        BeforeAgentStartEvent,\n        BeforeAgentStartEventResult\n      >,\n    ): () => void;\n    on(\n      event: \"agent_end\",\n      handler: ExtensionHandler<AgentEndEvent>,\n    ): () => void;\n    on(\n      event: \"message_end\",\n      handler: ExtensionHandler<MessageEndEvent, MessageEndEventResult>,\n    ): () => void;\n    /** Send a custom message to the session. */\n    sendMessage<T = unknown>(\n      message: Pick<\n        CustomMessage<T>,\n        \"customType\" | \"content\" | \"display\" | \"details\"\n      >,\n      options?: {\n        triggerTurn?: boolean;\n        deliverAs?: \"steer\" | \"followUp\" | \"nextTurn\";\n      },\n    ): void;\n  };\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '110,215p' .pi/types/pi-coding-agent.d.ts\"}"},"time":{"start":1794133226461,"end":1794133226475}}}}
