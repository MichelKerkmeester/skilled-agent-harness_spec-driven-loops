,\n545:     diffSummary: 'prose',\n546:     generatedFence: 'code',\n547:   },\n548:   'deep_research.spec_mutation_conflict': {\n549:     folderState: SPEC_FOLDER_STATE_RULE,\n550:     reason: 'prose',\n551:     specPath: 'prose',\n552:     generatedFence: 'nullable-identifier',\n553:     conflictKind: SPEC_CONFLICT_KIND_RULE,\n554:   },\n555:   'deep_research.spec_synthesis_deferred': {\n556:     reason: 'prose',\n557:     generatedFence: 'code',\n558:   },\n559:   'deep_research.idea_promoted': {\n560:     mode: 'code',\n561:     run: 'nullable-uint32',\n562:     ideaId: 'prose',\n563:     idea: 'prose',\n564:     category: 'prose',\n565:     observationCount: 'uint32',\n566:     minIdeaObservations: 'nullable-uint32',\n567:     firstObservedRun: 'nullable-uint32',\n568:     lastObservedRun: 'nullable-uint32',\n569:   },\n570:   'deep_research.question_conflict': {\n571:     mode: 'code',\n572:     run: 'nullable-uint32',\n573:     conflictId: 'identifier',\n574:     questionId: 'prose',\n575:     inboxId: 'nullable-prose',\n576:     operatorDecision: QUESTION_DECISION_RULE,\n577:     inboxValue: 'prose',\n578:     registryValue: 'prose',\n579:     source: 'prose',\n580:     origin: 'code',\n581:     injectedAtIteration: 'uint32',\n582:     sessionId: 'nullable-prose',\n583:     generation: 'nullable-uint32',\n584:   },\n585:   'deep_research.idea_observed': {\n586:     idea: 'prose',\n587:   },\n588:   'deep_research.idea_rejected': {},\n589:   'deep_research.idea_rejected_removed': {},\n590:   'deep_research.idea_rejected_reset': {},\n591:   'deep_research.user_paused': {\n592:     mode: 'code',\n593:     run: 'nullable-uint32',\n594:     stopReason: stopReasonRule('userPaused'),\n595:     sentinelPath: 'prose',\n596:   },\n597:   'deep_research.stuck_recovery': {\n598:     mode: 'code',\n599:     run: 'nullable-uint32',\n600:     stopReason: stopReasonRule('stuckRecovery'),\n601:   },\n602:   'deep_research.min_iterations_guard_pass': {\n603:     mode: 'code',\n604:     run: 'nullable-uint32',\n605:     iterationCount: 'uint32',\n606:     minIterations: 'uint32',\n607:   },\n608:   'deep_research.migration': {\n609:     legacyPath: 'prose',\n610:     canonicalPath: 'prose',\n611:   },\n612:   'deep_research.novelty_signal_inert': TREND_ADVISORY_FIELD_RULES,\n613:   'deep_research.trend_flatline': TREND_ADVISORY_FIELD_RULES,\n614:   'deep_research.pivot_override_accepted': {\n615:     mode: 'code',\n616:     run: 'nullable-uint32',\n617:     pivotId: 'identifier',\n618:     selectedCandidate: 'json',\n619:     selectedFrontier: 'json',\n[Output truncated. Continue reading with offset: 620]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 140, \"offset\": 480, \"path\": \".skilled/skills/system-deep-loop/runtime/lib/deep-research-ledger-schema/deep-research-ledger-schema.ts\"}"},"time":{"start":1794133075193,"end":1794133075504}}}}
