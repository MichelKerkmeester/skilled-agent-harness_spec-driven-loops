home for every external CLI dispatch orchestrator in this repo.\n64:- **`packetKind`**: the axis a mode sits on, and every mode here is `workflow` because all seven orchestrate a CLI binary.\n71:- **`tieBreak`**: the `routerPolicy` order that ranks the seven modes when scores are close.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"python3 -c \\\"\\nimport json\\nd=json.load(open('.skilled/skills/cli-external-orchestration/mode-registry.json'))\\nprint(json.dumps(list(d.keys())))\\nmodes=d.get('modes', d)\\nif isinstance(modes,dict):\\n    print(sorted(modes.keys()))\\n\\\"; echo \\\"=== HUB ROUTES ===\\\"; grep -n \\\"seven\\\\|hermes\\\\|Hermes\\\" .skilled/skills/cli-external-orchestration/SKILL.md | head -10\"}"},"time":{"start":1794133511037,"end":1794133511968}}}}
