│   └── finalize-dist.mjs       # Build finalization
├── tests/                      # Test files (*.vitest.ts)
│   ├── _support/               # Shared test support
│   └── __helpers__/            # Test helpers
└── dist/                       # Compiled output (gitignored)
```

