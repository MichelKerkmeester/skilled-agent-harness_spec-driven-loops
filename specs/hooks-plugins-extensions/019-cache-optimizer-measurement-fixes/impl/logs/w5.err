      contextFiles: [{ path: 'AGENTS.md', content }],
    }, new Set([fullContext]));

    assert.equal(result.changed, true);
    assert.equal(result.stablePrefix, fullContext);
    assert.equal(result.stablePrefix.split(content).length - 1, 1);
