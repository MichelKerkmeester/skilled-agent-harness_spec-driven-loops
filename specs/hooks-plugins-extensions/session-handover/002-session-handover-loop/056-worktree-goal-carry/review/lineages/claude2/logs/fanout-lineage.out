unch goes on unbound.\n+# exactly as consume does. Any failure prints nothing and the launch goes on unbound. A packet\n+# proven in a linked worktree is followed by a second line naming that worktree.\n seeded_goal_packet() {\n   local seed=\"$1\"\n \n@@ -504,7 +507,8 @@ seeded_goal_packet() {\n       if (core.noteState(realNote) !== \"open\") process.exit(0);\n       const { frontmatter } = core.parseHandoff(fs.readFileSync(realNote, \"utf8\"));\n       const switches = { ...loadConfigFile(configPath()), ...process.env };\n-      process.stdout.write(core.usableGoalPacket(frontmatter, switches, repoRoot));\n+      const { packet, root } = core.usableGoal(frontmatter, switches, repoRoot);\n+      process.stdout.write(packet === \"\" || root === \"\" ? packet : packet + \"\\n\" + root);\n     } catch {\n       // An unreadable or unparsable note binds nothing.\n     }\n@@ -1230,10 +1234,16 @@ claim_seed_prefix='[session-handover] claim and continue handoff '\n for ((index = 0; index < ${#launch_arguments[@]}; index++)); do\n   if [[ \"${launch_arguments[$index]}\" == \"$claim_seed_prefix\"* ]]; then\n     first_launch_seed=${launch_arguments[$index]}\n-    goal_packet=$(seeded_goal_packet \"$first_launch_seed\")\n+    seeded_goal=$(seeded_goal_packet \"$first_launch_seed\")\n+    goal_packet=${seeded_goal%%$'\\n'*}\n+    goal_root=''\n+    if [[ \"$seeded_goal\" == *$'\\n'* ]]; then\n+      goal_root=${seeded_goal#*$'\\n'}\n+    fi\n     if [[ -n \"$goal_packet\" ]]; then\n       export SESSION_HANDOVER_GOAL_PACKET=\"$goal_packet\"\n-      if [[ \"$runtime\" == 'claude' ]] && goal_slice=$(render_goal_slice \"$goal_packet\"); then\n+      if [[ \"$runtime\" == 'claude' ]] \\\n+        && goal_slice=$(render_goal_slice \"$goal_packet\" \"$goal_root\"); then\n         # Claude takes its goal from a start prompt that is the goal command alone, so the\n         # seed moves to the environment for the start hook, as it does on a hop.\n         launch_arguments[index]=\"/g