cket = goalSlice.readPacketGoal(workspace, packetPath);\n  if (!packet) return null;\n  return {\n    packetPath: packet.packetPath,\n    nested: packet.nested,\n    durableChars: packet.durableChars,\n    budgetState: packet.budgetState,\n    hash: packet.hash,\n    chatSlice: packet.chatSlice,\n(eval):1: no matches found: --include=*.cjs","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012oL8nRQjKge4Zxu5eYHAkF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
