{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WusgrNVudWP2Ux6q5Xo3Mg","type":"tool_result","content":" .skilled/bin/skilled-loop                          |  28 ++-\n .../session-handover/bin/session-handover.cjs      |  18 +-\n .skilled/hooks/session-handover/goal-carry-over.md |  10 +-\n .../hooks/session-handover/lib/relaunch-core.cjs   | 206 +++++++++++++++++++--\n .../session-handover/tests/relaunch-core.test.cjs  |  19 ++\n .../tests/session-handover-cli.test.cjs            | 152 +++++++++++++++\n .../tests/skilled-loop-wrapper-claim-goal.test.cjs |  65 +++++++\n .skilled/hooks/session-handover/troubleshooting.md |   2 +-\n .../002-session-handover-loop/graph-metadata.json  |   9 +-\n .../002-session-handover-loop/spec.md              |   2 +\n 10 files changed, 472 insertions(+), 39 deletions(-)\ndiff --git a/.skilled/hooks/session-handover/lib/relaunch-core.cjs b/.skilled/hooks/session-handover/lib/relaunch-core.cjs\nindex f1dffc893fa..c38ca7db0cc 100644\n--- a/.skilled/hooks/session-handover/lib/relaunch-core.cjs\n+++ b/.skilled/hooks/session-handover/lib/relaunch-core.cjs\n@@ -68,6 +68,13 @@ const GOAL_LOG_MAX_CANDIDATES = 8;\n // A headline search walks the packet tree, so folders that hold fixtures, history and\n // archived work are skipped, and a match counts only when no second packet shares it.\n const GOAL_SEARCH_SKIP_DIRECTORIES = new Set(['scratch', 'lineages', 'z_archive']);\n+// Listing the repository's worktrees is one local git call. A git that hangs must not hold a\n+// hand-over up, and a list it cannot finish names no worktree.\n+const WORKTREE_LIST_TIMEOUT_MS = 5000;\n+const GIT_REPOSITORY_VARIABLES = Object.freeze([\n+  'GIT_DIR', 'GIT_WORK_TREE', 'GIT_COMMON_DIR', 'GIT_INDEX_FILE', 'GIT_NAMESPACE',\n+  'GIT_CEILING_DIRECTORIES', 'GIT_DISCOVERY_ACROSS_FILESYSTEM',\n+]);\n const GOAL_SWITCH_OFF_VALUES = Object.freeze(['0', 'false', 'off', 'no']);\n // Defaults for a record that names no limits; the wrapper reads