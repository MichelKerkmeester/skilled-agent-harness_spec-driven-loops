essionManager.getBranch === 'function') return sessionManager.getBranch();\n88:   if (Array.isArray(sessionManager.branch)) return sessionManager.branch;\n89:   return null;\n90: }\n91: \n92: // ─────────────────────────────────────────────────────────────────────────────\n93: // 4. ENTRY MAPPING\n94: // ─────────────────────────────────────────────────────────────────────────────\n95: \n96: function assistantBlocks(content) {\n97:   const blocks = [];\n98:   for (const item of Array.isArray(content) ? content : []) {\n99:     if (!item || typeof item !== 'object') continue;\n100:     if (item.type === 'text' && typeof item.text === 'string') {\n101:       blocks.push(textBlock(item.text));\n102:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n103:       blocks.push(thinkingBlock(item.thinking));\n104:     } else if (item.type === 'toolCall' && typeof item.id === 'string' && typeof item.name === 'string') {\n105:       blocks.push(toolCallBlock({ id: item.id, name: item.name, arguments: item.arguments }));\n106:     }\n107:   }\n108:   return blocks;\n109: }\n110: \n111: function recordsFromLines(lines) {\n112:   const records = [];\n113: \n114:   lines.forEach((line, index) => {\n115:     if (line?.type !== 'message' || !line.message || typeof line.message !== 'object') return;\n116:     const message = line.message;\n117:     const id = typeof line.id === 'string' && line.id ? line.id : `pi-entry-${index}`;\n118:     const timestamp = line.timestamp;\n119: \n120:     if (message.role === 'user') {\n121:       const blocks = [];\n122:       for (const item of Array.isArray(message.content) ? message.content : []) {\n123:         if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n124:       }\n125:       // Pi records harness injections as their own `custom_message` entry type,\n126:       // which this mapping never reads, so a user message is operator content\n127:       // even when it opens with '<'.\n128:       const text = contentText(blocks);\n129:       if (!text) return;\n130:       records.push({ id, role: 'user', timestamp, content: blocks });\n131:       return;\n132:     }\n133: \n134:     if (message.role === 'assistant') {\n135:       const blocks = assistantBlocks(message.content);\n136:       if (blocks.length === 0) return;\n137:       records.push({ id, role: 'assistant', timestamp, content: blocks });\n138:       return;\n139:     }\n140: \n141:     if (message.role === 'toolResult') {\n142:       if (typeof message.toolCallId !== 'string' || !message.toolCallId) return;\n143:       const blocks = [];\n144:       for (const item of Array.isArray(message.content) ? message.content : []) {\n145:         if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n146:       }\n147:       const record = {\n148:         id,\n149:         role: 'toolResult',\n150:         timestamp,\n151:         content: blocks.length > 0 ? blocks : [textBlock(contentText(message.content))],\n152:         toolCallId: message.toolCallId,\n153:       };\n154:       if (message.isError === true) record.isError = true;\n155:       records.push(record);\n156:     }\n157:   });\n158: \n159:   return records;\n160: }\n161: \n162: // A `custom_message` is context a hook or harness put into the session rather\n163: // than a turn the operator wrote, so it stays out of `records` and travels as\n164: // its own list. The custom type names the producer when the entry carries one.\n165: function injectedFromLines(lines) {\n166:   const injected = [];\n167:   for (const line of lines) {\n168:     if (line?.type !== 'custom_message') continue;\n169:     const text = contentText(line.content);\n170:     if (!text) continue;\n171:     injected.push({ source: line.customType ?? 'custom_message', text });\n172:   }\n173:   return injected;\n174: }\n175: \n176: // ─────────────────────────────────────────────────────────────────────────