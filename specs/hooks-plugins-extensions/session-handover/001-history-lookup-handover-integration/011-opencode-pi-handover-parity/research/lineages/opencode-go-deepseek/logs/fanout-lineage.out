{"type":"tool_use","timestamp":1794808087449,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"partID":"prt_1e2e602db002e4I1vTeFhIH6s6","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e5f318001SkMKRwbHL12H63","type":"tool","id":"call_00_yh1xa1p6a93qqhkmtsff4yr6","tool":"read","state":{"status":"completed","input":{"path":".skilled/hooks/shared/session-readers/opencode.mjs"},"output":"Read file .skilled/hooks/shared/session-readers/opencode.mjs, lines 1-310\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: OpenCode Read-Only Database Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // OpenCode keeps its history in SQLite. The driver loads only when a database\n5: // is opened, because the plugin that shares this package runs under Bun, which\n6: // has no `node:sqlite`. The session id is proven against the session table\n7: // before any row for it is selected, and the connection is read-only.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { createRequire } from 'node:module';\n14: import { isAbsolute, join } from 'node:path';\n15: import { envOf, homeDir, isSafeSessionId, resolveInside, samePath } from './identity.mjs';\n16: import {\n17:   contentText,\n18:   isoOr,\n19:   parseJsonObject,\n20:   textBlock,\n21:   thinkingBlock,\n22:   toolCallBlock,\n23: } from './project.mjs';\n24: \n25: const require = createRequire(import.meta.url);\n26: \n27: // ─────────────────────────────────────────────────────────────────────────────\n28: // 2. CONSTANTS\n29: // ─────────────────────────────────────────────────────────────────────────────\n30: \n31: const RUNTIME = 'opencode';\n32: const LOCATOR_KIND = 'session-store';\n33: const PART_TABLE = 'part';\n34: const MESSAGE_TABLE = 'session_message';\n35: // OpenCode 1 keeps each turn's role in this table instead of `session_message`.\n36: const LEGACY_MESSAGE_TABLE = 'message';\n37: const SESSION_TABLES = ['session_v2', 'session'];\n38: // A message row without its own clock keeps its sequence order, but after every\n39: // part row that does carry one, rather than sorting ahead of the conversation.\n40: const UNTIMED_MESSAGE_BASE = 1e15;\n41: \n42: // ─────────────────────────────────────────────────────────────────────────────\n43: // 3. STORE\n44: // ─────────────────────────────────────────────────────────────────────────────\n45: \n46: export function openCodeStoreRoot(options = {}) {\n47:   if (options.opencodeRoot) return options.opencodeRoot;\n48:   const dataHome = envOf(options).XDG_DATA_HOME || join(homeDir(options), '.local', 'share');\n49:   return join(dataHome, 'opencode');\n50: }\n51: \n52: // OpenCode reads `OPENCODE_DB` the same way: a relative name sits in the data\n53: // folder and an absolute path is used as given. The OpenCode 1 launcher sets it\n54: // so the two majors keep separate databases, and a shell the model runs inherits\n55: // it, so the reader opens the database that session wrote.\n56: export function openCodeDatabasePath(options = {}) {\n57:   if (options.dbPath) return options.dbPath;\n58:   const named = envOf(options).OPENCODE_DB;\n59:   const root = openCodeStoreRoot(options);\n60:   if (typeof named === 'string' && named.trim()) {\n61:     return isAbsolute(named) ? named : join(root, named);\n62:   }\n63:   return join(root, 'opencode.db');\n64: }\n65: \n66: function openDatabase(dbPath) {\n67:   const { DatabaseSync } = require('node:sqlite');\n68:   return new DatabaseSync(dbPath, { readOnly: true });\n69: }\n70: \n71: function tableNames(database) {\n72:   const rows = database.prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\").all();\n73:   return new Set(rows.map((row) => row.name));\n74: }\n75: \n76: // ─────────────────────────────────────────────────────────────────────────────\n77: // 4. ENTRY MAPPING\n78: // ─────────────────────────────────────────────────────────────────────────────\n79: \n80: function toolPair({ id, callId, name, input, output, timestamp, sort }) {\n81:   const resultText = typeof output === 'string' ? output : contentText(output);\n82:   return [\n83:     {\n84:       sort,\n85:       record: {\n86:         id,\n87:         role: 'assistant',\n88:         timestamp,\n89:         content: [toolCallBlock({ id: callId, name, arguments: input ?? {} })],\n90:       },\n91:     },\n92:     {\n93:       sort,\n94:       record: {\n95:         id: `${id}:result`.slice(0, 128),\n96:         role: 'toolResult',\n97:         timestamp,\n98:         content: [textBlock(resultText)],\n99:         toolCallId: callId,\n100:       },\n101:     },\n102:   ];\n103: }\n104: \n105: // A text part is only as trustworthy as the message row it belongs to: the\n106: // same table holds user and assistant parts, so the row type decides the role.\n107: function roleOfMessage(rolesByMessageId, messageId) {\n108:   return rolesByMessageId.get(messageId) === 'user' ? 'user' : 'assistant';\n109: }\n110: \n111: function partEntries(rows, rolesByMessageId) {\n112:   const entries = [];\n113:   for (const row of rows) {\n114:     const parsed = parseJsonObject(row.data);\n115:     // OpenCode 1 stores a part's id as a column, not inside its JSON.\n116:     const part = parsed && typeof parsed.id !== 'string' && typeof row.id === 'string'\n117:       ? { ...parsed, id: row.id }\n118:       : parsed;\n119:     if (!part || typeof part.id !== 'string') continue;\n120:     const timestamp = isoOr(row.time_created ?? part.time_created);\n121: \n122:     if (part.type === 'text' && typeof part.text === 'string') {\n123:       const role = roleOfMessage(rolesByMessageId, row.message_id);\n124:       entries.push({ sort: row.time_created ?? 0, record: { id: part.id, role, timestamp, content: [textBlock(part.text)] } });\n125:       continue;\n126:     }\n127:     if (part.type === 'reasoning' && typeof part.text === 'string') {\n128:       entries.push({ sort: row.time_created ?? 0, record: { id: part.id, role: 'assistant', timestamp, content: [thinkingBlock(part.text)] } });\n129:       continue;\n130:     }\n131:     if (part.type === 'tool' && typeof part.callID === 'string' && typeof part.tool === 'string') {\n132:       entries.push(...toolPair({\n133:         id: part.id,\n134:         callId: part.callID,\n135:         name: part.tool,\n136:         input: part.state?.input,\n137:         output: part.state?.output ?? part.state?.content,\n138:         timestamp,\n139:         sort: row.time_created ?? 0,\n140:       }));\n141:     }\n142:   }\n143:   return entries;\n144: }\n145: \n146: function messageRoles(rows, legacyRows = []) {\n147:   const roles = new Map();\n148:   for (const row of legacyRows) {\n149:     if (typeof row.id !== 'string' || !row.id) continue;\n150:     const role = parseJsonObject(row.data)?.role;\n151:     if (role === 'user' || role === 'assistant') roles.set(row.id, role);\n152:   }\n153:   for (const row of rows) {\n154:     if (typeof row.id !== 'string' || !row.id) continue;\n155:     if (row.type === 'user' || row.type === 'assistant') roles.set(row.id, row.type);\n156:   }\n157:   return roles;\n158: }\n159: \n160: // A message whose text already arrived as text parts must not repeat it from\n161: // the message row, or the same turn would be found and counted twice.\n162: function messageIdsWithTextParts(rows) {\n163:   const ids = new Set();\n164:   for (const row of rows) {\n165:     if (typeof row.message_id !== 'string') continue;\n166:     const part = parseJsonObject(row.data);\n167:     if (part?.type === 'text' && typeof part.text === 'string') ids.add(row.message_id);\n168:   }\n169:   return ids;\n170: }\n171: \n172: function messageEntries(rows, seenCallIds, textPartMessageIds = new Set()) {\n173:   const entries = [];\n174: \n175:   rows.forEach((row) => {\n176:     const message = parseJsonObject(row.data);\n177:     if (!message) return;\n178:     const timestamp = isoOr(message.time?.created ?? row.time_created);\n179:     const sort = message.time?.created ?? UNTIMED_MESSAGE_BASE + (row.seq ?? 0);\n180:     const textFromParts = textPartMessageIds.has(row.id);\n181: \n182:     if (row.type === 'user') {\n183:       // Synthetic context is recorded as its own message type, which this branch\n184:       // never reads, so a user row is operator content even when it opens with '<'.\n185:       if (textFromParts || typeof message.text !== 'string' || !message.text) return;\n186:       entries.push({ sort, record: { id: row.id, role: 'user', timestamp, content: [textBlock(message.text)] } });\n187:       return;\n188:     }\n189: \n190:     if (row.type !== 'assistant') return;\n191:     const content = Array.isArray(message.content) ? message.content : [];\n192:     content.forEach((item, index) => {\n193:       if (!item || typeof item !== 'object') return;\n194:       if (item.type === 'text' && typeof item.text === 'string') {\n195:         if (textFromParts) return;\n196:         entries.push({\n197:           sort,\n198:           record: { id: `${row.id}:${index}`.slice(0, 128), role: 'assistant', timestamp, content: [textBlock(item.text)] },\n199:         });\n200:         return;\n201:       }\n202:       if (item.type === 'tool' && typeof item.id === 'string' && typeof item.name === 'string') {\n203:         if (seenCallIds.has(item.id)) return;\n204:         seenCallIds.add(item.id);\n205:         entries.push(...toolPair({\n206:           id: `${row.id}:${index}`.slice(0, 128),\n207:           callId: item.id,\n208:           name: item.name,\n209:           input: item.state?.input,\n210:           output: item.state?.output ?? item.state?.content,\n211:           timestamp,\n212:           sort,\n213:         }));\n214:       }\n215:     });\n216:   });\n217: \n218:   return entries;\n219: }\n220: \n221: // ─────────────────────────────────────────────────────────────────────────────\n222: // 5. LOADER\n223: // ─────────────────────────────────────────────────────────────────────────────\n224: \n225: function columnNames(database, table) {\n226:   return new Set(database.prepare(`PRAGMA table_info(${table})`).all().map((row) => row.name));\n227: }\n228: \n229: export function loadOpenCodeSession({ sessionId, ...options } = {}) {\n230:   if (!isSafeSessionId(sessionId)) {\n231:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n232:   }\n233: \n234:   const dbPath = openCodeDatabasePath(options);\n235:   const containment = resolveInside({ path: dbPath, root: openCodeStoreRoot(options) });\n236:   if (!containment.ok) return containment;\n237: \n238:   let database;\n239:   try {\n240:     database = openDatabase(containment.path);\n241:   } catch {\n242:     return { ok: false, code: 'store_unreadable' };\n243:   }\n244: \n245:   try {\n246:     const tables = tableNames(database);\n247: \n248:     const sessionTables = SESSION_TABLES.filter((table) => tables.has(table));\n249:     if (sessionTables.length === 0) return { ok: false, code: 'store_unreadable' };\n250: \n251:     // A caller that names the folder the session ran in gets the session only\n252:     // when its recorded directory is that folder, as the Pi and DSH readers\n253:     // prove the session header's cwd.\n254:     let found = false;\n255:     for (const table of sessionTables) {\n256:       const hasDirectory = columnNames(database, table).has('directory');\n257:       const columns = hasDirectory ? 'id, directory' : 'id';\n258:       const row = database.prepare(`SELECT ${columns} FROM ${table} WHERE id = ?`).get(sessionId);\n259:       if (typeof row?.id === 'string' && row.id === sessionId) {\n260:         if (options.projectDir !== undefined && hasDirectory && !samePath(row.directory, options.projectDir)) {\n261:           return { ok: false, code: 'session_mismatch' };\n262:         }\n263:         found = true;\n264:         break;\n265:       }\n266:     }\n267:     if (!found) return { ok: false, code: 'session_not_found' };\n268: \n269:     const partRows = tables.has(PART_TABLE)\n270:       ? database\n271:         .prepare(`SELECT id, message_id, time_created, data FROM ${PART_TABLE} WHERE session_id = ? ORDER BY time_created, id`)\n272:         .all(sessionId)\n273:       : [];\n274:     const messageRows = tables.has(MESSAGE_TABLE)\n275:       ? database\n276:         .prepare(`SELECT id, type, seq, data FROM ${MESSAGE_TABLE} WHERE session_id = ? ORDER BY seq`)\n277:         .all(sessionId)\n278:       : [];\n279: \n280:     const seenCallIds = new Set();\n281:     const legacyRows = tables.has(LEGACY_MESSAGE_TABLE)\n282:       ? database.prepare(`SELECT id, data FROM ${LEGACY_MESSAGE_TABLE} WHERE session_id = ?`).all(sessionId)\n283:       : [];\n284:     const entries = [...partEntries(partRows, messageRoles(messageRows, legacyRows))];\n285:     for (const entry of entries) {\n286:       if (entry.record.role === 'assistant') {\n287:         for (const block of entry.record.content) {\n288:           if (block.type === 'toolCall') seenCallIds.add(block.id);\n289:         }\n290:       }\n291:     }\n292:     entries.push(...messageEntries(messageRows, seenCallIds, messageIdsWithTextParts(partRows)));\n293:     entries.sort((left, right) => left.sort - right.sort);\n294: \n295:     return {\n296:       ok: true,\n297:       source: {\n298:         runtime: RUNTIME,\n299:         sessionId,\n300:         locatorKind: LOCATOR_KIND,\n301:         storePath: containment.path,\n302:       },\n303:       records: entries.map((entry) => entry.record),\n304:     };\n305:   } catch {\n306:     return { ok: false, code: 'store_unreadable' };\n307:   } finally {\n308:     database.close();\n309:   }\n310: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/opencode.mjs, lines 1-310\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: OpenCode Read-Only Database Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // OpenCode keeps its history in SQLite. The driver loads only when a database\n5: // is opened, because the plugin that shares this package runs under Bun, which\n6: // has no `node:sqlite`. The session id is proven against the session table\n7: // before any row for it is selected, and the connection is read-only.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { createRequire } from 'node:module';\n14: import { isAbsolute, join } from 'node:path';\n15: import { envOf, homeDir, isSafeSessionId, resolveInside, samePath } from './identity.mjs';\n16: import {\n17:   contentText,\n18:   isoOr,\n19:   parseJsonObject,\n20:   textBlock,\n21:   thinkingBlock,\n22:   toolCallBlock,\n23: } from './project.mjs';\n24: \n25: const require = createRequire(import.meta.url);\n26: \n27: // ─────────────────────────────────────────────────────────────────────────────\n28: // 2. CONSTANTS\n29: // ─────────────────────────────────────────────────────────────────────────────\n30: \n31: const RUNTIME = 'opencode';\n32: const LOCATOR_KIND = 'session-store';\n33: const PART_TABLE = 'part';\n34: const MESSAGE_TABLE = 'session_message';\n35: // OpenCode 1 keeps each turn's role in this table instead of `session_message`.\n36: const LEGACY_MESSAGE_TABLE = 'message';\n37: const SESSION_TABLES = ['session_v2', 'session'];\n38: // A message row without its own clock keeps its sequence order, but after every\n39: // part row that does carry one, rather than sorting ahead of the conversation.\n40: const UNTIMED_MESSAGE_BASE = 1e15;\n41: \n42: // ─────────────────────────────────────────────────────────────────────────────\n43: // 3. STORE\n44: // ─────────────────────────────────────────────────────────────────────────────\n45: \n46: export function openCodeStoreRoot(options = {}) {\n47:   if (options.opencodeRoot) return options.opencodeRoot;\n48:   const dataHome = envOf(options).XDG_DATA_HOME || join(homeDir(options), '.local', 'share');\n49:   return join(dataHome, 'opencode');\n50: }\n51: \n52: // OpenCode reads `OPENCODE_DB` the same way: a relative name sits in the data\n53: // folder and an absolute path is used as given. The OpenCode 1 launcher sets it\n54: // so the two majors keep separate databases, and a shell the model runs inherits\n55: // it, so the reader opens the database that session wrote.\n56: export function openCodeDatabasePath(options = {}) {\n57:   if (options.dbPath) return options.dbPath;\n58:   const named = envOf(options).OPENCODE_DB;\n59:   const root = openCodeStoreRoot(options);\n60:   if (typeof named === 'string' && named.trim()) {\n61:     return isAbsolute(named) ? named : join(root, named);\n62:   }\n63:   return join(root, 'opencode.db');\n64: }\n65: \n66: function openDatabase(dbPath) {\n67:   const { DatabaseSync } = require('node:sqlite');\n68:   return new DatabaseSync(dbPath, { readOnly: true });\n69: }\n70: \n71: function tableNames(database) {\n72:   const rows = database.prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\").all();\n73:   return new Set(rows.map((row) => row.name));\n74: }\n75: \n76: // ─────────────────────────────────────────────────────────────────────────────\n77: // 4. ENTRY MAPPING\n78: // ─────────────────────────────────────────────────────────────────────────────\n79: \n80: function toolPair({ id, callId, name, input, output, timestamp, sort }) {\n81:   const resultText = typeof output === 'string' ? output : contentText(output);\n82:   return [\n83:     {\n84:       sort,\n85:       record: {\n86:         id,\n87:         role: 'assistant',\n88:         timestamp,\n89:         content: [toolCallBlock({ id: callId, name, arguments: input ?? {} })],\n90:       },\n91:     },\n92:     {\n93:       sort,\n94:       record: {\n95:         id: `${id}:result`.slice(0, 128),\n96:         role: 'toolResult',\n97:         timestamp,\n98:         content: [textBlock(resultText)],\n99:         toolCallId: callId,\n100:       },\n101:     },\n102:   ];\n103: }\n104: \n105: // A text part is only as trustworthy as the message row it belongs to: the\n106: // same table holds user and assistant parts, so the row type decides the role.\n107: function roleOfMessage(rolesByMessageId, messageId) {\n108:   return rolesByMessageId.get(messageId) === 'user' ? 'user' : 'assistant';\n109: }\n110: \n111: function partEntries(rows, rolesByMessageId) {\n112:   const entries = [];\n113:   for (const row of rows) {\n114:     const parsed = parseJsonObject(row.data);\n115:     // OpenCode 1 stores a part's id as a column, not inside its JSON.\n116:     const part = parsed && typeof parsed.id !== 'string' && typeof row.id === 'string'\n117:       ? { ...parsed, id: row.id }\n118:       : parsed;\n119:     if (!part || typeof part.id !== 'string') continue;\n120:     const timestamp = isoOr(row.time_created ?? part.time_created);\n121: \n122:     if (part.type === 'text' && typeof part.text === 'string') {\n123:       const role = roleOfMessage(rolesByMessageId, row.message_id);\n124:       entries.push({ sort: row.time_created ?? 0, record: { id: part.id, role, timestamp, content: [textBlock(part.text)] } });\n125:       continue;\n126:     }\n127:     if (part.type === 'reasoning' && typeof part.text === 'string') {\n128:       entries.push({ sort: row.time_created ?? 0, record: { id: part.id, role: 'assistant', timestamp, content: [thinkingBlock(part.text)] } });\n129:       continue;\n130:     }\n131:     if (part.type === 'tool' && typeof part.callID === 'string' && typeof part.tool === 'string') {\n132:       entries.push(...toolPair({\n133:         id: part.id,\n134:         callId: part.callID,\n135:         name: part.tool,\n136:         input: part.state?.input,\n137:         output: part.state?.output ?? part.state?.content,\n138:         timestamp,\n139:         sort: row.time_created ?? 0,\n140:       }));\n141:     }\n142:   }\n143:   return entries;\n144: }\n145: \n146: function messageRoles(rows, legacyRows = []) {\n147:   const roles = new Map();\n148:   for (const row of legacyRows) {\n149:     if (typeof row.id !== 'string' || !row.id) continue;\n150:     const role = parseJsonObject(row.data)?.role;\n151:     if (role === 'user' || role === 'assistant') roles.set(row.id, role);\n152:   }\n153:   for (const row of rows) {\n154:     if (typeof row.id !== 'string' || !row.id) continue;\n155:     if (row.type === 'user' || row.type === 'assistant') roles.set(row.id, row.type);\n156:   }\n157:   return roles;\n158: }\n159: \n160: // A message whose text already arrived as text parts must not repeat it from\n161: // the message row, or the same turn would be found and counted twice.\n162: function messageIdsWithTextParts(rows) {\n163:   const ids = new Set();\n164:   for (const row of rows) {\n165:     if (typeof row.message_id !== 'string') continue;\n166:     const part = parseJsonObject(row.data);\n167:     if (part?.type === 'text' && typeof part.text === 'string') ids.add(row.message_id);\n168:   }\n169:   return ids;\n170: }\n171: \n172: function messageEntries(rows, seenCallIds, textPartMessageIds = new Set()) {\n173:   const entries = [];\n174: \n175:   rows.forEach((row) => {\n176:     const message = parseJsonObject(row.data);\n177:     if (!message) return;\n178:     const timestamp = isoOr(message.time?.created ?? row.time_created);\n179:     const sort = message.time?.created ?? UNTIMED_MESSAGE_BASE + (row.seq ?? 0);\n180:     const textFromParts = textPartMessageIds.has(row.id);\n181: \n182:     if (row.type === 'user') {\n183:       // Synthetic context is recorded as its own message type, which this branch\n184:       // never reads, so a user row is operator content even when it opens with '<'.\n185:       if (textFromParts || typeof message.text !== 'string' || !message.text) return;\n186:       entries.push({ sort, record: { id: row.id, role: 'user', timestamp, content: [textBlock(message.text)] } });\n187:       return;\n188:     }\n189: \n190:     if (row.type !== 'assistant') return;\n191:     const content = Array.isArray(message.content) ? message.content : [];\n192:     content.forEach((item, index) => {\n193:       if (!item || typeof item !== 'object') return;\n194:       if (item.type === 'text' && typeof item.text === 'string') {\n195:         if (textFromParts) return;\n196:         entries.push({\n197:           sort,\n198:           record: { id: `${row.id}:${index}`.slice(0, 128), role: 'assistant', timestamp, content: [textBlock(item.text)] },\n199:         });\n200:         return;\n201:       }\n202:       if (item.type === 'tool' && typeof item.id === 'string' && typeof item.name === 'string') {\n203:         if (seenCallIds.has(item.id)) return;\n204:         seenCallIds.add(item.id);\n205:         entries.push(...toolPair({\n206:           id: `${row.id}:${index}`.slice(0, 128),\n207:           callId: item.id,\n208:           name: item.name,\n209:           input: item.state?.input,\n210:           output: item.state?.output ?? item.state?.content,\n211:           timestamp,\n212:           sort,\n213:         }));\n214:       }\n215:     });\n216:   });\n217: \n218:   return entries;\n219: }\n220: \n221: // ─────────────────────────────────────────────────────────────────────────────\n222: // 5. LOADER\n223: // ─────────────────────────────────────────────────────────────────────────────\n224: \n225: function columnNames(database, table) {\n226:   return new Set(database.prepare(`PRAGMA table_info(${table})`).all().map((row) => row.name));\n227: }\n228: \n229: export function loadOpenCodeSession({ sessionId, ...options } = {}) {\n230:   if (!isSafeSessionId(sessionId)) {\n231:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n232:   }\n233: \n234:   const dbPath = openCodeDatabasePath(options);\n235:   const containment = resolveInside({ path: dbPath, root: openCodeStoreRoot(options) });\n236:   if (!containment.ok) return containment;\n237: \n238:   let database;\n239:   try {\n240:     database = openDatabase(containment.path);\n241:   } catch {\n242:     return { ok: false, code: 'store_unreadable' };\n243:   }\n244: \n245:   try {\n246:     const tables = tableNames(database);\n247: \n248:     const sessionTables = SESSION_TABLES.filter((table) => tables.has(table));\n249:     if (sessionTables.length === 0) return { ok: false, code: 'store_unreadable' };\n250: \n251:     // A caller that names the folder the session ran in gets the session only\n252:     // when its recorded directory is that folder, as the Pi and DSH readers\n253:     // prove the session header's cwd.\n254:     let found = false;\n255:     for (const table of sessionTables) {\n256:       const hasDirectory = columnNames(database, table).has('directory');\n257:       const columns = hasDirectory ? 'id, directory' : 'id';\n258:       const row = database.prepare(`SELECT ${columns} FROM ${table} WHERE id = ?`).get(sessionId);\n259:       if (typeof row?.id === 'string' && row.id === sessionId) {\n260:         if (options.projectDir !== undefined && hasDirectory && !samePath(row.directory, options.projectDir)) {\n261:           return { ok: false, code: 'session_mismatch' };\n262:         }\n263:         found = true;\n264:         break;\n265:       }\n266:     }\n267:     if (!found) return { ok: false, code: 'session_not_found' };\n268: \n269:     const partRows = tables.has(PART_TABLE)\n270:       ? database\n271:         .prepare(`SELECT id, message_id, time_created, data FROM ${PART_TABLE} WHERE session_id = ? ORDER BY time_created, id`)\n272:         .all(sessionId)\n273:       : [];\n274:     const messageRows = tables.has(MESSAGE_TABLE)\n275:       ? database\n276:         .prepare(`SELECT id, type, seq, data FROM ${MESSAGE_TABLE} WHERE session_id = ? ORDER BY seq`)\n277:         .all(sessionId)\n278:       : [];\n279: \n280:     const seenCallIds = new Set();\n281:     const legacyRows = tables.has(LEGACY_MESSAGE_TABLE)\n282:       ? database.prepare(`SELECT id, data FROM ${LEGACY_MESSAGE_TABLE} WHERE session_id = ?`).all(sessionId)\n283:       : [];\n284:     const entries = [...partEntries(partRows, messageRoles(messageRows, legacyRows))];\n285:     for (const entry of entries) {\n286:       if (entry.record.role === 'assistant') {\n287:         for (const block of entry.record.content) {\n288:           if (block.type === 'toolCall') seenCallIds.add(block.id);\n289:         }\n290:       }\n291:     }\n292:     entries.push(...messageEntries(messageRows, seenCallIds, messageIdsWithTextParts(partRows)));\n293:     entries.sort((left, right) => left.sort - right.sort);\n294: \n295:     return {\n296:       ok: true,\n297:       source: {\n298:         runtime: RUNTIME,\n299:         sessionId,\n300:         locatorKind: LOCATOR_KIND,\n301:         storePath: containment.path,\n302:       },\n303:       records: entries.map((entry) => entry.record),\n304:     };\n305:   } catch {\n306:     return { ok: false, code: 'store_unreadable' };\n307:   } finally {\n308:     database.close();\n309:   }\n310: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/hooks/shared/session-readers/opencode.mjs\"}"},"time":{"start":1794808087259,"end":1794808087449}}}}
