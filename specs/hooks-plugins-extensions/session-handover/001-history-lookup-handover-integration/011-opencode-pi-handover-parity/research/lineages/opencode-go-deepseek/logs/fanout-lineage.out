{"type":"tool_use","timestamp":1794808081113,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"partID":"prt_1e2e5ea2a001qtxbdxuWU8hOK8","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e5dbac001YgeeTGAf74SNg2","type":"tool","id":"call_01_ywrbyj644ixggzah7rl6a2nm","tool":"read","state":{"status":"completed","input":{"path":".skilled/hooks/shared/session-readers/pi.mjs"},"output":"Read file .skilled/hooks/shared/session-readers/pi.mjs, lines 1-291\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Session Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // Pi exposes its live branch in-process, so the current session needs no disk\n5: // read at all. An older session is found only by an exact header id inside the\n6: // caller's project directory. The header's `cwd` is the tie-breaker because\n7: // separator flattening lets two projects share one directory name.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { Buffer } from 'node:buffer';\n14: import { closeSync, openSync, readFileSync, readSync, readdirSync, statSync } from 'node:fs';\n15: import { join } from 'node:path';\n16: import {\n17:   guardSessionPath,\n18:   homeDir,\n19:   isSafeSessionId,\n20:   samePath,\n21: } from './identity.mjs';\n22: import {\n23:   contentText,\n24:   parseJsonObject,\n25:   textBlock,\n26:   thinkingBlock,\n27:   toolCallBlock,\n28: } from './project.mjs';\n29: \n30: // ─────────────────────────────────────────────────────────────────────────────\n31: // 2. CONSTANTS\n32: // ─────────────────────────────────────────────────────────────────────────────\n33: \n34: const RUNTIME = 'pi';\n35: // One vocabulary across the capability table and both source envelopes.\n36: const LOCATOR_KIND = 'live_branch_or_session_log';\n37: const TRANSCRIPT_EXT = '.jsonl';\n38: const HEADER_PROBE_BYTES = 64 * 1024;\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 3. STORE\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: export function piStoreRoot(options = {}) {\n45:   return options.piRoot ?? join(homeDir(options), '.pi', 'agent', 'sessions');\n46: }\n47: \n48: export function piProjectDirectory(projectDir) {\n49:   const projectKey = projectDir.replace(/^\\/+/, '').replaceAll('/', '-');\n50:   return '--' + projectKey + '--';\n51: }\n52: \n53: function headerOf(filePath) {\n54:   // Only the first line is needed, so the probe reads a bounded prefix rather\n55:   // than a whole session file that may run to many megabytes.\n56:   const buffer = Buffer.alloc(HEADER_PROBE_BYTES);\n57:   const fd = openSync(filePath, 'r');\n58:   let length;\n59:   try {\n60:     length = readSync(fd, buffer, 0, HEADER_PROBE_BYTES, 0);\n61:   } finally {\n62:     closeSync(fd);\n63:   }\n64:   const head = buffer.subarray(0, length).toString('utf8');\n65:   return parseJsonObject(head.split('\\n')[0]);\n66: }\n67: \n68: // Session file names start with their creation time and end with the session\n69: // id, so the id filters candidates before any file is opened.\n70: function idFromFileName(fileName) {\n71:   const withoutExtension = fileName.endsWith(TRANSCRIPT_EXT)\n72:     ? fileName.slice(0, -TRANSCRIPT_EXT.length)\n73:     : fileName;\n74:   const separator = withoutExtension.indexOf('_');\n75:   return separator === -1 ? withoutExtension : withoutExtension.slice(separator + 1) || withoutExtension;\n76: }\n77: \n78: function liveSessionId(sessionManager) {\n79:   if (!sessionManager || typeof sessionManager !== 'object') return null;\n80:   const value = typeof sessionManager.getSessionId === 'function'\n81:     ? sessionManager.getSessionId()\n82:     : sessionManager.sessionId;\n83:   return typeof value === 'string' && value ? value : null;\n84: }\n85: \n86: function branchEntries(sessionManager) {\n87:   if (typeof sessionManager.getBranch === 'function') return sessionManager.getBranch();\n88:   if (Array.isArray(sessionManager.branch)) return sessionManager.branch;\n89:   return null;\n90: }\n91: \n92: // ─────────────────────────────────────────────────────────────────────────────\n93: // 4. ENTRY MAPPING\n94: // ─────────────────────────────────────────────────────────────────────────────\n95: \n96: function assistantBlocks(content) {\n97:   const blocks = [];\n98:   for (const item of Array.isArray(content) ? content : []) {\n99:     if (!item || typeof item !== 'object') continue;\n100:     if (item.type === 'text' && typeof item.text === 'string') {\n101:       blocks.push(textBlock(item.text));\n102:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n103:       blocks.push(thinkingBlock(item.thinking));\n104:     } else if (item.type === 'toolCall' && typeof item.id === 'string' && typeof item.name === 'string') {\n105:       blocks.push(toolCallBlock({ id: item.id, name: item.name, arguments: item.arguments }));\n106:     }\n107:   }\n108:   return blocks;\n109: }\n110: \n111: function recordsFromLines(lines) {\n112:   const records = [];\n113: \n114:   lines.forEach((line, index) => {\n115:     if (line?.type !== 'message' || !line.message || typeof line.message !== 'object') return;\n116:     const message = line.message;\n117:     const id = typeof line.id === 'string' && line.id ? line.id : `pi-entry-${index}`;\n118:     const timestamp = line.timestamp;\n119: \n120:     if (message.role === 'user') {\n121:       const blocks = [];\n122:       for (const item of Array.isArray(message.content) ? message.content : []) {\n123:         if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n124:       }\n125:       // Pi records harness injections as their own `custom_message` entry type,\n126:       // which this mapping never reads, so a user message is operator content\n127:       // even when it opens with '<'.\n128:       const text = contentText(blocks);\n129:       if (!text) return;\n130:       records.push({ id, role: 'user', timestamp, content: blocks });\n131:       return;\n132:     }\n133: \n134:     if (message.role === 'assistant') {\n135:       const blocks = assistantBlocks(message.content);\n136:       if (blocks.length === 0) return;\n137:       records.push({ id, role: 'assistant', timestamp, content: blocks });\n138:       return;\n139:     }\n140: \n141:     if (message.role === 'toolResult') {\n142:       if (typeof message.toolCallId !== 'string' || !message.toolCallId) return;\n143:       const blocks = [];\n144:       for (const item of Array.isArray(message.content) ? message.content : []) {\n145:         if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n146:       }\n147:       const record = {\n148:         id,\n149:         role: 'toolResult',\n150:         timestamp,\n151:         content: blocks.length > 0 ? blocks : [textBlock(contentText(message.content))],\n152:         toolCallId: message.toolCallId,\n153:       };\n154:       if (message.isError === true) record.isError = true;\n155:       records.push(record);\n156:     }\n157:   });\n158: \n159:   return records;\n160: }\n161: \n162: // A `custom_message` is context a hook or harness put into the session rather\n163: // than a turn the operator wrote, so it stays out of `records` and travels as\n164: // its own list. The custom type names the producer when the entry carries one.\n165: function injectedFromLines(lines) {\n166:   const injected = [];\n167:   for (const line of lines) {\n168:     if (line?.type !== 'custom_message') continue;\n169:     const text = contentText(line.content);\n170:     if (!text) continue;\n171:     injected.push({ source: line.customType ?? 'custom_message', text });\n172:   }\n173:   return injected;\n174: }\n175: \n176: // ─────────────────────────────────────────────────────────────────────────────\n177: // 5. LOADER\n178: // ─────────────────────────────────────────────────────────────────────────────\n179: \n180: function liveResult({ sessionId, sessionManager, options }) {\n181:   const entries = branchEntries(sessionManager);\n182:   if (!Array.isArray(entries)) return { ok: false, code: 'store_unreadable' };\n183:   if (entries.length === 0) return { ok: false, code: 'session_not_found' };\n184:   return {\n185:     ok: true,\n186:     source: {\n187:       runtime: RUNTIME,\n188:       sessionId,\n189:       locatorKind: LOCATOR_KIND,\n190:       mode: 'live',\n191:       storePath: typeof sessionManager.getSessionFile === 'function'\n192:         ? String(sessionManager.getSessionFile())\n193:         : piStoreRoot(options),\n194:     },\n195:     records: recordsFromLines(entries),\n196:     injected: injectedFromLines(entries),\n197:   };\n198: }\n199: \n200: function diskResult({ sessionId, projectDir, options }) {\n201:   if (typeof projectDir !== 'string' || !projectDir.trim()) {\n202:     return { ok: false, code: 'locator_unavailable' };\n203:   }\n204: \n205:   const root = piStoreRoot(options);\n206:   const directory = join(root, piProjectDirectory(projectDir));\n207: \n208:   let names;\n209:   try {\n210:     names = readdirSync(directory);\n211:   } catch {\n212:     // A missing root means the store itself cannot be read; a known root with\n213:     // no project directory means this project simply has no saved session.\n214:     try {\n215:       statSync(root);\n216:       return { ok: false, code: 'session_not_found' };\n217:     } catch {\n218:       return { ok: false, code: 'store_unreadable' };\n219:     }\n220:   }\n221: \n222:   const candidates = names.filter(\n223:     (name) => name.endsWith(TRANSCRIPT_EXT) && idFromFileName(name) === sessionId,\n224:   );\n225:   if (candidates.length === 0) return { ok: false, code: 'session_not_found' };\n226:   // Two files that decode to one id are two possible sessions, and neither the\n227:   // name nor the header can choose between them, so a recovery read refuses\n228:   // rather than guessing.\n229:   if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n230: \n231:   const filePath = join(directory, candidates[0]);\n232:   let header;\n233:   try {\n234:     header = headerOf(filePath);\n235:   } catch {\n236:     return { ok: false, code: 'store_unreadable' };\n237:   }\n238: \n239:   if (header?.type !== 'session' || header.id !== sessionId) {\n240:     return { ok: false, code: 'session_mismatch' };\n241:   }\n242:   if (!samePath(header.cwd, projectDir)) {\n243:     return { ok: false, code: 'session_mismatch' };\n244:   }\n245: \n246:   const guard = guardSessionPath({\n247:     path: filePath,\n248:     root,\n249:     sessionId,\n250:     recordedId: header.id,\n251:   });\n252:   if (!guard.ok) return guard;\n253: \n254:   let raw;\n255:   try {\n256:     raw = readFileSync(filePath, 'utf8');\n257:   } catch {\n258:     return { ok: false, code: 'store_unreadable' };\n259:   }\n260: \n261:   const lines = [];\n262:   for (const line of raw.split('\\n')) {\n263:     if (!line.trim()) continue;\n264:     const parsed = parseJsonObject(line);\n265:     if (parsed) lines.push(parsed);\n266:   }\n267: \n268:   return {\n269:     ok: true,\n270:     source: {\n271:       runtime: RUNTIME,\n272:       sessionId,\n273:       locatorKind: LOCATOR_KIND,\n274:       mode: 'disk',\n275:       storePath: guard.path,\n276:     },\n277:     records: recordsFromLines(lines),\n278:     injected: injectedFromLines(lines),\n279:   };\n280: }\n281: \n282: export function loadPiSession({ sessionId, projectDir, sessionManager, ...options } = {}) {\n283:   if (!isSafeSessionId(sessionId)) {\n284:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n285:   }\n286: \n287:   if (sessionManager && liveSessionId(sessionManager) === sessionId) {\n288:     return liveResult({ sessionId, sessionManager, options });\n289:   }\n290:   return diskResult({ sessionId, projectDir, options });\n291: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/pi.mjs, lines 1-291\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Session Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // Pi exposes its live branch in-process, so the current session needs no disk\n5: // read at all. An older session is found only by an exact header id inside the\n6: // caller's project directory. The header's `cwd` is the tie-breaker because\n7: // separator flattening lets two projects share one directory name.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { Buffer } from 'node:buffer';\n14: import { closeSync, openSync, readFileSync, readSync, readdirSync, statSync } from 'node:fs';\n15: import { join } from 'node:path';\n16: import {\n17:   guardSessionPath,\n18:   homeDir,\n19:   isSafeSessionId,\n20:   samePath,\n21: } from './identity.mjs';\n22: import {\n23:   contentText,\n24:   parseJsonObject,\n25:   textBlock,\n26:   thinkingBlock,\n27:   toolCallBlock,\n28: } from './project.mjs';\n29: \n30: // ─────────────────────────────────────────────────────────────────────────────\n31: // 2. CONSTANTS\n32: // ─────────────────────────────────────────────────────────────────────────────\n33: \n34: const RUNTIME = 'pi';\n35: // One vocabulary across the capability table and both source envelopes.\n36: const LOCATOR_KIND = 'live_branch_or_session_log';\n37: const TRANSCRIPT_EXT = '.jsonl';\n38: const HEADER_PROBE_BYTES = 64 * 1024;\n39: \n40: // ────────────────