  const width = maximum - 2; // Reserve space for both ellipses.\n274:   const before = Math.max(0, Math.floor((width - (matchEnd - matchStart)) / 2));\n275:   const start = Math.min(Math.max(0, matchStart - before), text.length - width);\n276:   const end = Math.min(text.length, start + width);\n277:   const excerpt = text.slice(start, end).replace(/^[\\uDC00-\\uDFFF]|[\\uD800-\\uDBFF]$/gu, '');\n278:   return `${start > 0 ? '…' : ''}${excerpt}${end < text.length ? '…' : ''}`;\n279: }\n280: \n281: // The preview centers on the term that made the turn match: an exact mention\n282: // first, else the first identifier holding a required part, so a match on a\n283: // fragment still shows the identifier it came from.\n284: function searchPreview(text: string, groups: readonly QueryGroup[]): string | undefined {\n285:   const compact = text.replace(/\\s+/g, ' ').trim();\n286:   const wholes = new Set(groups.map((group) => group.whole));\n287:   const required = new Set(groups.flatMap((group) => group.required));\n288:   let fallback: [number, number] | undefined;\n289:   let previous: SearchToken | undefined;\n290:   for (const token of tokensOf(compact)) {\n291:     if (wholes.has(token.whole)) return excerptAround(compact, token.start, token.end);\n292:     if (fallback === undefined) {\n293:       const pair = adjacentHanPair(previous, token);\n294:       if (required.has(token.whole) || token.parts.some((part) => required.has(part))) {\n295:         fallback = [token.start, token.end];\n296:       } else if (pair !== undefined && required.has(pair) && previous !== undefined) {\n297:         fallback = [previous.start, token.end];\n298:       }\n299:     }\n300:     previous = token;\n301:   }\n302:   return fallback === undefined ? undefined : excerptAround(compact, fallback[0], fallback[1]);\n303: }\n304: \n305: // ───────────────────────────────────────────────────────────────────\n306: // 5. REFERENCES & VALIDATION\n307: // ───────────────────────────────────────────────────────────────────\n308: \n309: function buildReference(item: RecoveryHistoryItem, index: number, items: readonly RecoveryHistoryItem[]): HistoryReference {\n310:   const metadata = item.kind === 'modelTurn' ? item.metadata : { tools: [], files: [], failed: false };\n311:   const omittedTools = metadata.tools.length - MAXIMUM_REFERENCE_TOOLS;\n312:   const omittedFiles = metadata.files.length - MAXIMUM_REFERENCE_FILES;\n313:   return {\n314:     historyId: item.id,\n315:     sequence: item.sequence,\n316:     kind: item.kind,\n317:     timestamp: item.timestamp,\n318:     preview: previewFor(item),\n319:     tools: metadata.tools.slice(0, MAXIMUM_REFERENCE_TOOLS),\n320:     files: metadata.files.slice(0, MAXIMUM_REFERENCE_FILES),\n321:     ...(omittedTools > 0 ? { omittedTools } : {}),\n322:     ...(omittedFiles > 0 ? { omittedFiles } : {}),\n323:     failed: metadata.failed,\n324:     previousHistoryId: items[index - 1]?.id ?? null,\n325:     nextHistoryId: items[index + 1]?.id ?? null,\n326:   };\n327: }\n328: \n329: function invalid(message: string): never {\n[Output truncated. Continue reading with offset: 330]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/hooks/session-handover/history/lib/navigator.ts, lines 240-329\n240: \n241: // A tool call reads as its name and its arguments, never as the block object, whose id and\n242: // type field tell a reader nothing about what the turn did. Search and previews share this.\n243: function turnText(item: RecoveryModelTurnHistoryItem): string {\n244:   return item.assistantMessage.content\n245:     .flatMap((block) => {\n246:       if (block === null) return [];\n247:       if (block.type === 'text') return [block.text];\n248:       return [`${block.name} ${serialized(block.arguments)}`];\n249:     })\n250:     .join(' ');\n251: }\n252: \n253: function itemText(item: RecoveryHistoryItem): string {\n254:   if (item.kind === 'user') return contentT