\n64: function redactText(text: string): string {\n65:   return scrubSecrets(text)\n66:     .replace(URL_PASSWORD, '$1[REDACTED:url-password]@')\n67:     .replace(AUTHORIZATION_VALUE, (match: string, prefix: string, value: string) =>\n68:       (looksLikeCredential(value) ? `${prefix}[REDACTED:authorization]` : match));\n69: }\n70: \n71: function redactArgument(value: unknown, key?: string): unknown {\n72:   if (typeof value === 'string') {\n73:     // A shell variable reference names a secret without holding it.\n74:     if (key !== undefined && SECRET_ARGUMENT_KEY.test(key) && value.length > 0 && !value.startsWith('$')) {\n75:       return '[REDACTED:credential-argument]';\n76:     }\n77:     return redactText(value);\n78:   }\n79:   if (Array.isArray(value)) return value.map((item) => redactArgument(item));\n80:   if (typeof value === 'object' && value !== null) {\n81:     return Object.fromEntries(Object.entries(value).map(([name, child]) => [name, redactArgument(child, name)]));\n82:   }\n83:   return value;\n84: }\n85: \n86: function redactBlock(block: HistoryContentBlock): HistoryContentBlock {\n87:   if (block.type === 'text') return { ...block, text: redactText(block.text) };\n88:   if (block.type === 'thinking') return { ...block, thinking: redactText(block.thinking) };\n89:   if (block.type === 'toolCall') return { ...block, arguments: redactArgument(block.arguments) };\n90:   // Image bytes are base64, where a pattern hit would corrupt the image.\n91:   return block;\n92: }\n93: \n94: /**\n95:  * Remove secret-shaped values from every readable string before projection.\n96:  *\n97:  * Redacting here, once, means search cannot match a secret, and every byte\n98:  * bound, part list and page offset is computed on the text a caller receives.\n99:  * Ids, tool names and ordering stay untouched so pairing still validates.\n100:  */\n101: function redactHistoryEntries(entries: readonly HistoryEntry[]): HistoryEntry[] {\n102:   return entries.map((entry) => ({ ...entry, content: entry.content.map(redactBlock) }));\n103: }\n104: \n105: function readImagePage(items: ReturnType<typeof projectHistoryEntries>, input: HistoryPageInput): HistoryPageReply {\n106:   if (input.part === undefined || input.offset !== undefined || input.limit !== undefined) {\n107:     throw new HistoryPageError('INVALID_PAGE_INPUT', 'Image mode requires a part handle without text-page bounds.');\n108:   }\n109:   const item = publicHistoryItem(items, input.historyId);\n110:   const image = selectHistoryImage(item, input.part);\n111:   const metadata = describeHistoryPart(item, { part: input.part, value: image });\n112:   const reply = recoveryResponse(metadata);\n113:   const withImage: HistoryPageReply = {\n114:     ...reply,\n115:     content: [...reply.content, { type: 'image' as const, data: image.data, mimeType: image.mimeType }],\n116:   };\n117:   // The metadata alone was measured above. The attachment is what makes an\n118:   // image reply large, so the whole reply is measured again against the cap.\n119:   if (Buffer.byteLength(JSON.stringify(withImage), 'utf8') > MAXIMUM_RECOVERY_REPLY_BYTES) {\n120:     throw new HistoryResponseError('HISTORY_REPLY_TOO_LARGE', 'The image does not fit the reply size cap.');\n121:   }\n122:   return withImage;\n123: }\n124: \n125: /**\n126:  * Build the four-operation lookup over an adapter-supplied entry list.\n127:  *\n128:  * The core owns redaction, projection and reply bounds, so no route can reach a\n129:  * raw entry, a secret it held, a transcript path or a store handle after this\n130:  * call returns.\n131:  */\n132: export function createHistoryLookup(\n133:   entries: readonly HistoryEntry[],\n134:   options: HistoryProjectionOptions = {},\n135: ): HistoryLookup {\n136:   const items = projectHistoryEntries(redactHistoryEntries(entries), options);\n137:   const navigator = new HistoryNavigator(items);\n138: \n139:   return {\n140:     search(input: HistorySearchInput): BoundedHistoryReply {\n14