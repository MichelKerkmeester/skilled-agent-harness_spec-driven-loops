g)) return;\n626:     const modules = await loadModules();\n627:     const sessionId = sessionIdOf(ctx, modules.nudge);\n628:     if (!sessionId) return;\n629: \n630:     const held = heldNudges.get(sessionId);\n631:     if (held === undefined) return;\n632:     heldNudges.delete(sessionId);\n633:     // A record for this session already covers the handoff the nudge asks\n634:     // for, so a pending or still-armed one retires the held text unread.\n635:     if (modules.nudge.handoffPending({ sessionId })) return;\n636:     // The hop count can reach the cap between holding the text and this stop,\n637:     // and a prompt that cannot relaunch must not reach the model.\n638:     if (modules.nudge.hopLimitReached()) return;\n639: \n640:     pi.sendMessage(\n641:       { customType: CONCERN, content: held, display: false },\n642:       // The nudge must reach the model without an operator turn: a steer joins the\n643:       // running loop before its next model call, a follow-up starts a turn once it stops.\n644:       { deliverAs, triggerTurn: true },\n645:     );\n646:   }\n647: \n648:   // A turn whose tool calls ran is followed by another model call in the same run, and its\n649:   // tools have finished, so a prepare call they made already left its record. Steering the\n650:   // held nudge in here reaches the model mid-run, the way a tool hook does on other runtimes,\n651:   // instead of waiting for a long run to stop on its own.\n652:   (pi as unknown as TurnEndRegistrar).on('turn_end', async (event, ctx) => {\n653:     try {\n654:       const toolResults = (event as { toolResults?: unknown[] }).toolResults;\n655:       if (!Array.isArray(toolResults) || toolResults.length === 0) return;\n656:       await deliverHeldNudge(ctx, 'steer');\n657:     } catch {\n658:       return undefined;\n659:     }\n660:   });\n661: \n662:   // A turn with no tool calls ends the loop, so the nudge leaves on agent_end rather than on the\n663:   // settle: a follow-up queued here runs as a continuation of the same run, so the run settles\n664:   // only after the prepare turn it asks for, and the settle then arms the record that turn wrote.\n665:   pi.on('agent_end', async (_event, ctx) => {\n666:     try {\n667:       await deliverHeldNudge(ctx, 'followUp');\n668:     } catch {\n669:       return undefined;\n670:     }\n671:   });\n672: \n[Output truncated. Continue reading with offset: 673]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 120, \"offset\": 553, \"path\": \".skilled/hooks/session-handover/pi/session-handover.ts\"}"},"time":{"start":1794808310480,"end":1794808311244}}}}
