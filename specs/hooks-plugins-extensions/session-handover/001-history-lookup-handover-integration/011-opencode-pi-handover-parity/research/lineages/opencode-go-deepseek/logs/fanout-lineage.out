{"type":"tool_use","timestamp":1794807961917,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"partID":"prt_1e2e41833002t4b4pm2jhoise7","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e40fca001xxe2m0Udp3Wq6D","type":"tool","id":"call_00_ot0th8x0ptslpu8hhso409vk","tool":"read","state":{"status":"completed","input":{"limit":400,"offset":1220,"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1220-1619\n1220:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1221: \n1222:       step_rejected_pattern_cache:\n1223:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1224:         read:\n1225:           - \"{state_paths.state_log}\"\n1226:           - \"{state_paths.registry}\"\n1227:           - \"{state_paths.strategy}\"\n1228:         candidate_sources:\n1229:           next_focus:\n1230:             category: \"next-focus\"\n1231:             values:\n1232:               - \"{next_focus}\"\n1233:               - \"{remaining_questions_list}\"\n1234:               - \"{carried_forward_open_questions}\"\n1235:           recovery:\n1236:             category: \"recovery\"\n1237:             values:\n1238:               - \"{recovery_strategy}\"\n1239:               - \"{least_explored}\"\n1240:           ideas:\n1241:             category: \"ideas\"\n1242:             values:\n1243:               - \"{promoted_ideas_list}\"\n1244:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1245:         algorithm: |\n1246:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1247:           reducer pass as the source of truth.\n1248:           Compare normalized exact text first. Then compare fuzzy similarity with\n1249:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1250:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1251:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1252:           halt for operator input instead of reusing a rejected idea.\n1253:         outputs:\n1254:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1255:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1256:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1257:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1258:         if_next_focus_suppressed:\n1259:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1260:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1261:         if_all_candidates_suppressed:\n1262:           halt: true\n1263:           release_lock: step_release_lock\n1264:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1265: \n1266:       step_ideas_backlog_lifecycle:\n1267:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1268:         read:\n1269:           - \"{state_paths.state_log}\"\n1270:           - \"{state_paths.registry}\"\n1271:           - \"{state_paths.config}\"\n1272:         lifecycle:\n1273:           observed_event: \"idea_observed\"\n1274:           promoted_event: \"idea_promoted\"\n1275:           rejected_event: \"idea_rejected\"\n1276:           min_observations: \"{min_idea_observations}\"\n1277:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1278:         validate:\n1279:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1280:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1281:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1282:         outputs:\n1283:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1284:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1285:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1286:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1287: \n1288:       step_normalize_pause_events:\n1289:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1290:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1291:         rule_pause_sentinel:\n1292:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1293:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1294:         rule_stuck_recovery:\n1295:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1296:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1297: \n1298:       step_marker_scan:\n1299:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1300:         canonical_header: \"DEEP-RESEARCH\"\n1301:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1302:         algorithm: |\n1303:           if current_iteration > 1:\n1304:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1305:             if file_exists(PREV_PROMPT_PATH):\n1306:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1307:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1308:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1309:                 halt with exit code 2\n1310:         note: |\n1311:           False-positive prevention: a research prompt that starts with its own canonical\n1312:           header is this loop's own iteration output, never a nested dispatch; only a review\n1313:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1314:           header. Markers appearing in comments or body text are ignored. True-positive\n1315:           triggers only when a previous iteration's rendered prompt literally starts with a\n1316:           review marker, indicating a nested research-of-review dispatch.\n1317: \n1318:       # ─── APPROVAL GATE: Pre-Iteration ───\n1319:       gate_pre_iteration:\n1320:         applies_to: confirm\n1321:         skip_when: \"The operator already approved the next dispatch in this pass through gate_consecutive_failures, gate_divergent_pivot_choice or gate_divergent_pivot_override.\"\n1322:         type: approval_gate\n1323:         purpose: \"Show planned focus and get approval before dispatching agent\"\n1324:         present: |\n1325:           ## Iteration {current_iteration} of {max_iterations}\n1326: \n1327:           **Focus**: {next_focus}\n1328:           **Remaining Questions**: {remaining_questions}\n1329:           **Last newInfoRatio**: {last_newInfoRatio}\n1330:           **Stuck Count**: {stuck_count}\n1331: \n1332:           Options:\n1333:           A) Proceed with this focus\n1334:           B) Change focus to: [user provides new focus]\n1335:           C) Stop loop and synthesize now\n1336:           D) Cancel entirely\n1337:         wait_for: \"User response\"\n1338:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1339:         on_A: { proceed_to: step_dispatch_iteration }\n1340:         on_B: { action: \"Update next_focus to user's choice\", proceed_to: step_dispatch_iteration }\n1341:         on_C:\n1342:           action: \"Record the operator-requested manual stop before synthesis\"\n1343:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1344:           set: { reason: \"manualStop\" }\n1345:           proceed_to: gate_pre_synthesis\n1346:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1347: \n1348:       step_dispatch_iteration:\n1349:         action: \"Dispatch one iteration via the selected executor\"\n1350:         pre_dispatch_refresh_lock:\n1351:           action: \"Refresh the packet lock heartbeat immediately before the dispatch starts\"\n1352:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1353:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than dispatch without it.\"\n1354:         post_dispatch_refresh_lock:\n1355:           action: \"Refresh the packet lock heartbeat immediately after the dispatch returns\"\n1356:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1357:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than continue without it.\"\n1358:         dry_run_boundary: \"dispatch\"\n1359:         dry_run_preview:\n1360:           before_halt:\n1361:             - \"Generate the state summary.\"\n1362:             - \"Render the prompt pack to terminal preview without writing the prompt file.\"\n1363:             - \"Show the selected executor branch and command or native dispatch target that would run.\"\n1364:         resolve_executor:\n1365:           source: \"config.executor\"\n1366:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1367:         pre_dispatch:\n1368:           generate_summary: |\n1369:             STATE SUMMARY (auto-generated):\n1370:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1371:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1372:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1373:             {resource_map_prompt_line}\n1374:             {lineage_context_prompt_line}\n1375:             Next focus: {next_focus}\n1376:           render_prompt_pack:\n1377:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1378:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1379:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1380:             dry_run_output: \"Render in memory and print to terminal preview; do not write output_path.\"\n1381:             variables:\n1382:               state_summary: \"{state_summary}\"\n1383:               research_topic: \"{research_topic}\"\n1384:               current_iteration: \"{current_iteration}\"\n1385:               max_iterations: \"{max_iterations}\"\n1386:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1387:               next_focus: \"{next_focus}\"\n1388:               remaining_questions_list: \"{remaining_questions_list}\"\n1389:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1390:               last_3_summaries: \"{last_3_summaries}\"\n1391:               pivot_lineage: \"{pivot_lineage}\"\n1392:               saturated_directions: \"{saturated_directions}\"\n1393:               state_paths_config: \"{state_paths.config}\"\n1394:               state_paths_state_log: \"{state_paths.state_log}\"\n1395:               state_paths_strategy: \"{state_paths.strategy}\"\n1396:               state_paths_registry: \"{state_paths.registry}\"\n1397:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1398:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1399:         pre_dispatch_audit:\n1400:           skip_when: \"config.executor.kind == 'native' or dry_run == true\"\n1401:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1402:           args:\n1403:             stateLogPath: \"{state_paths.state_log}\"\n1404:             executor: \"{config.executor}\"\n1405:             iteration: \"{current_iteration}\"\n1406:             sessionId: \"{config.lineage.sessionId}\"\n1407:         branch_on: \"config.executor.kind\"\n1408:         cli_dispatch_args: '--loop-type research --repo-root \"{repo_root}\" --prompt-file \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\" --state-log \"{state_paths.state_log}\" --packet-dir \"{state_paths.packet_dir}\" --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --generation \"{config.lineage.generation}\" --session-id \"{config.lineage.sessionId}\" --model \"{config.executor.model}\" --reasoning-effort \"{config.executor.reasoningEffort}\" --service-tier \"{config.executor.serviceTier}\" --sandbox-mode \"{config.executor.sandboxMode}\" --timeout-seconds \"{config.executor.timeoutSeconds}\"'\n1409:         if_native:\n1410:           dispatch:\n1411:             agent: deep-research\n1412:             model: opus\n1413:             context_source: \"rendered_prompt_pack\"\n1414:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1415:           wait_for_completion: true\n1416:         if_cli_deepseek_harness:\n1417:           command: |\n1418:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-deepseek-harness {cli_dispatch_args} --spec-folder \"{spec_folder}\"\n1419:           working_directory: \"{repo_root}\"\n1420:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1421:           wait_for_completion: true\n1422:           notes:\n1423:             - \"cli-deepseek-harness single-executor: builds through the shared fan-out command builder (buildLineageCommand), so the pinned harness release, the model allowlist and the route, lineage and guards patches stay one source of truth. runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1424:             - \"The harness starts in the artifact directory, never the repository root, with a fresh DSH_HOME outside the checkout. DSH_HOME, DSH_SPEC_FOLDER, SYSTEM_SPEC_GATE_DISABLED and AI_SESSION_CHILD reach the child through dispatchEnv, and the home is removed in a finally block. The event stream is judged and counted, not echoed\"\n1425:             - \"The prompt opens with a REPOSITORY ROOT line, because the prompt pack's paths and gateway call are repo-relative while the harness starts in the artifact directory\"\n1426:             - \"The child timeout is 30 s under the step timeout (at least half of it), so the finally block removes the home before any outer kill\"\n1427:             - \"validateDshCompletion judges a clean exit, so a plugin that did not activate or a missing final event records a crash dispatch_failure\"\n1428:             - \"Fails closed when the harness binary is absent, off its pinned release or the model is off the allowlist (buildLineageCommand throws, exit non-zero). A requested cli-deepseek-harness executor never degrades to native\"\n1429:             - \"The command text never names the harness binary as a bare word, because the ancestry recursion guard reads the parent shell's command line\"\n1430:         if_cli_mistral_vibe:\n1431:           command: |\n1432:             node --input-type=module <<'EOF'\n1433:             console.error('cli-mistral-vibe runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1434:             process.exit(2);\n1435:             EOF\n1436:           working_directory: \"{repo_root}\"\n1437:           wait_for_completion: true\n1438:           notes:\n1439:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1440:         if_cli_claude_code:\n1441:           command: |\n1442:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-claude-code {cli_dispatch_args}\n1443:           working_directory: \"{repo_root}\"\n1444:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1445:           wait_for_completion: true\n1446:           notes:\n1447:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1448:             - \"claude-code has no serviceTier flag\"\n1449:             - \"claude-code supports --effort for reasoning depth\"\n1450:         if_cli_cursor:\n1451:           command: |\n1452:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-cursor {cli_dispatch_args}\n1453:           working_directory: \"{repo_root}\"\n1454:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1455:           wait_for_completion: true\n1456:           notes:\n1457:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1458:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1459:         if_cli_devin:\n1460:           command: |\n1461:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-devin {cli_dispatch_args}\n1462:           working_directory: \"{repo_root}\"\n1463:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1464:           wait_for_completion: true\n1465:           notes:\n1466:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1467:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1468:         if_cli_pi:\n1469:           command: |\n1470:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-pi {cli_dispatch_args}\n1471:           working_directory: \"{repo_root}\"\n1472:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1473:           wait_for_completion: true\n1474:           notes:\n1475:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1476:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1477:             - \"cli-deepseek-harness has its own single-executor branch, if_cli_deepseek_harness above, built through the same buildLineageCommand. Fan-out also runs the kind\"\n1478:         record_executor_audit:\n1479:           skip_when: \"config.executor.kind == 'native'\"\n1480:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#appendExecutorAuditToLastRecord\"\n1481:           args:\n1482:             stateLogPath: \"{state_paths.state_log}\"\n1483:             executor: \"{config.executor}\"\n1484:             sessionId: \"{config.lineage.sessionId}\"\n1485:         if_cli_opencode:\n1486:           command: |\n1487:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-opencode {cli_dispatch_args}\n1488:           working_directory: \"{repo_root}\"\n1489:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1490:           wait_for_completion: true\n1491:           notes:\n1492:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1493:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1494:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1495:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1496:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1497:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1498:         if_cli_codex:\n1499:           command: |\n1500:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-codex {cli_dispatch_args}\n1501:           working_directory: \"{repo_root}\"\n1502:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1503:           wait_for_completion: true\n1504:           notes:\n1505:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1506:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1507:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1508:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1509:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1510:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1511:         post_dispatch_validate:\n1512:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1513:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1514:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing|executor_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1515:           assert_exists: \"{state_paths.iteration_pattern}\"\n1516:           assert_appended: \"{state_paths.state_log}\"\n1517:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1518:           route_proof:\n1519:             mode: research\n1520:             target_agent: deep-research\n1521:             agent_definition_loaded: true\n1522:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1523:           dispatchReceipt:\n1524:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1525:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1526:           sessionId: \"{config.lineage.sessionId}\"\n1527:           optional_jsonl_fields:\n1528:             logOffset: \"Byte offset where the seekable log region starts\"\n1529:             logSize: \"Byte length of the seekable log region\"\n1530:             logPath: \"Absolute path to the file containing the seekable log region\"\n1531:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1532:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1533:           assert_canonical_type: \"iteration\"\n1534:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1535:           assert_delta_file_has_iteration_record: true\n1536:           on_failure:\n1537:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1538:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1539:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1540:           failure_reasons_reference:\n1541:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1542:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1543:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1544:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1545:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1546:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1547:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1548:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1549:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1550:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1551:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1552:             - \"executor_missing — non-native executor did not record provenance\"\n1553:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1554: \n1555:       step_run_now_restore_check:\n1556:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1557:         command: |\n1558:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs restore --sentinel \"{state_paths.run_now_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1559:         outputs:\n1560:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1561: \n1562:       step_check_executor_unavailable:\n1563:         action: \"Stop when the current iteration dispatch records an unavailable executor\"\n1564:         read:\n1565:           - \"{state_paths.state_log}\"\n1566:         extract:\n1567:           - unavailable_record: \"Latest line with type == 'event', event == 'dispatch_failure', iteration == current_iteration, and executorUnavailable == true; else none\"\n1568:         branch_on: \"unavailable_record\"\n1569:         if_present:\n1570:           set: { reason: \"error\", stopReason: \"error\" }\n1571:           message: \"The {unavailable_record.executor.kind} executor is unavailable ({unavailable_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1572:           halt: true\n1573:           release_lock: step_release_lock\n1574:         if_absent:\n1575:           action: \"Continue to state reduction\"\n1576: \n1577:       step_reduce_state:\n1578:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1579:         dry_run_boundary: \"reducer-refresh\"\n1580:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1581:         inputs:\n1582:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1583:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1584:           priorReducedState: \"{state_paths.registry}\"\n1585:         outputs:\n1586:           - \"{state_paths.registry}\"\n1587:           - \"{state_paths.dashboard}\"\n1588:           - \"{state_paths.strategy}\"\n1589:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1590:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1591:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1592:         failure_modes:\n1593:           malformed_delta: \"skip + warn\"\n1594:           missing_iteration_file: \"no-op + error\"\n1595:           schema_mismatch: \"reject + conflict event\"\n1596:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1597:         guarantee: \"Idempotent for identical inputs\"\n1598: \n1599:       step_graph_upsert:\n1600:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1601:         dry_run_boundary: \"state-mutation\"\n1602:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1603:         command: |\n1604:           node .skilled/skills/system-deep-loop/runtime/scripts/iteration-graph-upsert.cjs --delta-dir \"{state_paths.delta_dir}\" --state-log \"{state_paths.state_log}\" --iteration \"{current_iteration}\" --spec-folder \"{spec_folder}\" --session-id \"{config.lineage.sessionId}\"\n1605: \n1606:       step_refresh_lineage_context:\n1607:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1608:         read:\n1609:           - \"{state_paths.dashboard}\"\n1610:           - \"{state_paths.registry}\"\n1611:           - \"{state_paths.strategy}\"\n1612:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1613:         use_response:\n1614:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1615:         failure_policy:\n1616:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1617:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1618:         outputs:\n1619:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n[Output truncated. Continue reading with offset: 1620]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1220-1619\n1220:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1221: \n1222:       step_rejected_pattern_cache:\n1223:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1224:         read:\n1225:           - \"{state_paths.state_log}\"\n1226:           - \"{state_paths.registry}\"\n1227:           - \"{state_paths.strategy}\"\n1228:         candidate_sources:\n1229:           next_focus:\n1230:             category: \"next-focus\"\n1231:             values:\n1232:               - \"{next_focus}\"\n1233:               - \"{remaining_questions_list}\"\n1234:               - \"{carried_forward_open_questions}\"\n1235:           recovery:\n1236:             category: \"recovery\"\n1237:             values:\n1238:               - \"{recovery_strategy}\"\n1239:               - \"{least_explored}\"\n1240:           ideas:\n1241:             category: \"ideas\"\n1242:             values:\n1243:               - \"{promoted_ideas_list}\"\n1244:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1245:         algorithm: |\n1246:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1247:           reducer pass as the source of truth.\n1248:           Compare normalized exact text first. Then compare fuzzy similarity with\n1249:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1250:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1251:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1252:           halt for operator input instead of reusing a rejected idea.\n1253:         outputs:\n1254:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1255:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1256:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1257:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1258:         if_next_focus_suppressed:\n1259:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1260:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1261:         if_all_candidates_suppressed:\n1262:           halt: true\n1263:           release_lock: step_release_lock\n1264:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1265: \n1266:       step_ideas_backlog_lifecycle:\n1267:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1268:         read:\n1269:           - \"{state_paths.state_log}\"\n1270:           - \"{state_paths.registry}\"\n1271:           - \"{state_paths.config}\"\n1272:         lifecycle:\n1273:           observed_event: \"idea_observed\"\n1274:           promoted_event: \"idea_promoted\"\n1275:           rejected_event: \"idea_rejected\"\n1276:           min_observations: \"{min_idea_observations}\"\n1277:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1278:         validate:\n1279:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1280:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1281:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1282:         outputs:\n1283:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1284:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1285:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1286:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1287: \n1288:       step_normalize_pause_events:\n1289:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1290:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1291:         rule_pause_sentinel:\n1292:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1293:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1294:         rule_stuck_recovery:\n1295:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1296:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1297: \n1298:       step_marker_scan:\n1299:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1300:         canonical_header: \"DEEP-RESEARCH\"\n1301:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1302:         algorithm: |\n1303:           if current_iteration > 1:\n1304:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1305:             if file_exists(PREV_PROMPT_PATH):\n1306:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1307:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1308:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1309:                 halt with exit code 2\n1310:         note: |\n1311:           False-positive prevention: a research prompt that starts with its own canonical\n1312:           header is this loop's own iteration output, never a nested dispatch; only a review\n1313:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1314:           header. Markers appearing in comments or body text are ignored. True-positive\n1315:           triggers only when a previous iteration's rendered prompt literally starts with a\n1316:           review marker, indicating a nested research-of-review dispatch.\n1317: \n1318:       # ─── APPROVAL GATE: Pre-Iteration ───\n1319:       gate_pre_iteration:\n1320:         applies_to: confirm\n1321:         skip_when: \"The operator already approved the next dispatch in this pass through gate_consecutive_failures, gate_divergent_pivot_choice or gate_divergent_pivot_override.\"\n1322:         type: approval_gate\n1323:         purpose: \"Show planned focus and get approval before dispatching agent\"\n1324:         present: |\n1325:           ## Iteration {current_iteration} of {max_iterations}\n1326: \n1327:           **Focus**: {next_focus}\n1328:           **Remaining Questions**: {remaining_questions}\n1329:           **Last newInfoRatio**: {last_newInfoRatio}\n1330:           **Stuck Count**: {stuck_count}\n1331: \n1332:           Options:\n1333:           A) Proceed with this focus\n1334:           B) Change focus to: [user provides new focus]\n1335:           C) Stop loop and synthesize now\n1336:           D) Cancel entirely\n1337:         wait_for: \"User response\"\n1338:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1339:         on_A: { proceed_to: step_dispatch_iteration }\n1340:         on_B: { action: \"Update next_focus to user's choice\", proceed_to: step_dispatch_iteration }\n1341:         on_C:\n1342:           action: \"Record the operator-requested manual stop before synthesis\"\n1343:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1344:           set: { reason: \"manualStop\" }\n1345:           proceed_to: gate_pre_synthesis\n1346:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1347: \n1348:       step_dispatch_iteration:\n1349:         action: \"Dispatch one iteration via the selected executor\"\n1350:         pre_dispatch_refresh_lock:\n1351:           action: \"Refresh the packet lock heartbeat immediately before the dispatch starts\"\n1352:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1353:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than dispatch without it.\"\n1354:         post_dispatch_refresh_lock:\n1355:           action: \"Refresh the packet lock heartbeat immediately after the dispatch returns\"\n1356:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1357:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than continue without it.\"\n1358:         dry_run_boundary: \"dispatch\"\n1359:         dry_run_preview:\n1360:           before_halt:\n1361:             - \"Generate the state summary.\"\n1362:             - \"Render the prompt pack to terminal preview without writing the prompt file.\"\n1363:             - \"Show the selected executor branch and command or native dispatch target that would run.\"\n1364:         resolve_executor:\n1365:           source: \"config.executor\"\n1366:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1367:         pre_dispatch:\n1368:           generate_summary: |\n1369:             STATE SUMMARY (auto-generated):\n1370:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1371:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1372:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1373:             {resource_map_prompt_line}\n1374:             {lineage_context_prompt_line}\n1375:             Next focus: {next_focus}\n1376:           render_prompt_pack:\n1377:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1378:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1379:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1380:             dry_run_output: \"Render in memory and print to terminal preview; do not write output_path.\"\n1381:             variables:\n1382:               state_summary: \"{state_summary}\"\n1383:               research_topic: \"{research_topic}\"\n1384:               current_iteration: \"{current_iteration}\"\n1385:               max_iterations: \"{max_iterations}\"\n1386:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1387:               next_focus: \"{next_focus}\"\n1388:               remaining_questions_list: \"{remaining_questions_list}\"\n1389:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1390:               last_3_summaries: \"{last_3_summaries}\"\n1391:               pivot_lineage: \"{pivot_lineage}\"\n1392:               saturated_directions: \"{saturated_directions}\"\n1393:               state_paths_config: \"{state_paths.config}\"\n1394:               state_paths_state_log: \"{state_paths.state_log}\"\n1395:               state_paths_strategy: \"{state_paths.strategy}\"\n1396:               state_paths_registry: \"{state_paths.registry}\"\n1397:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1398:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1399:         pre_dispatch_audit:\n1400:           skip_when: \"config.executor.kind == 'native' or dry_run == true\"\n1401:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1402:           args:\n1403:             stateLogPath: \"{state_paths.state_log}\"\n1404:             executor: \"{config.executor}\"\n1405:             iteration: \"{current_iteration}\"\n1406:             sessionId: \"{config.lineage.sessionId}\"\n1407:         branch_on: \"config.executor.kind\"\n1408:         cli_dispatch_args: '--loop-type research --repo-root \"{repo_root}\" --prompt-file \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\" --state-log \"{state_paths.state_log}\" --packet-dir \"{state_paths.packet_dir}\" --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --generation \"{config.lineage.generation}\" --session-id \"{config.lineage.sessionId}\" --model \"{config.executor.model}\" --reasoning-effort \"{config.executor.reasoningEffort}\" --service-tier \"{config.executor.serviceTier}\" --sandbox-mode \"{config.executor.sandboxMode}\" --timeout-seconds \"{config.executor.timeoutSeconds}\"'\n1409:         if_native:\n1410:           dispatch:\n1411:             agent: deep-research\n1412:             model: opus\n1413:             context_source: \"rendered_prompt_pack\"\n1414:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1415:           wait_for_completion: true\n1416:         if_cli_deepseek_harness:\n1417:           command: |\n1418:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-deepseek-harness {cli_dispatch_args} --spec-folder \"{spec_folder}\"\n1419:           working_directory: \"{repo_root}\"\n1420:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1421:           wait_for_completion: true\n1422:           notes:\n1423:             - \"cli-deepseek-harness single-executor: builds through the shared fan-out command builder (buildLineageCommand), so the pinned harness release, the model allowlist and the route, lineage and guards patches stay one source of truth. runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1424:             - \"The harness starts in the artifact directory, never the repository root, with a fresh DSH_HOME outside the checkout. DSH_HOME, DSH_SPEC_FOLDER, SYSTEM_SPEC_GATE_DISABLED and AI_SESSION_CHILD reach the child through dispatchEnv, and the home is removed in a finally block. The event stream is judged and counted, not echoed\"\n1425:             - \"The prompt opens with a REPOSITORY ROOT line, because the prompt pack's paths and gateway call are repo-relative while the harness starts in the artifact directory\"\n1426:             - \"The child timeout is 30 s under the step timeout (at least half of it), so the finally block removes the home before any outer kill\"\n1427:             - \"validateDshCompletion judges a clean exit, so a plugin that did not activate or a missing final event records a crash dispatch_failure\"\n1428:             - \"Fails closed when the harness binary is absent, off its pinned release or the model is off the allowlist (buildLineageCommand throws, exit non-zero). A requested cli-deepseek-harness executor never degrades to native\"\n1429:             - \"The command text never names the harness binary as a bare word, because the ancestry recursion guard reads the parent shell's command line\"\n1430:         if_cli_mistral_vibe:\n1431:           command: |\n1432:             node --input-type=module <<'EOF'\n1433:             console.error('cli-mistral-vibe runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1434:             process.exit(2);\n1435:             EOF\n1436:           working_directory: \"{repo_root}\"\n1437:           wait_for_completion: true\n1438:           notes:\n1439:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1440:         if_cli_claude_code:\n1441:           command: |\n1442:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-claude-code {cli_dispatch_args}\n1443:           working_directory: \"{repo_root}\"\n1444:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1445:           wait_for_completion: true\n1446:           notes:\n1447:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1448:             - \"claude-code has no serviceTier flag\"\n1449:             - \"claude-code supports --effort for reasoning depth\"\n1450:         if_cli_cursor:\n1451:           command: |\n1452:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-cursor {cli_dispatch_args}\n1453:           working_directory: \"{repo_root}\"\n1454:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1455:           wait_for_completion: true\n1456:           notes:\n1457:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1458:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1459:         if_cli_devin:\n1460:           command: |\n1461:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-devin {cli_dispatch_args}\n1462:           working_directory: \"{repo_root}\"\n1463:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1464:           wait_for_completion: true\n1465:           notes:\n1466:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1467:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1468:         if_cli_pi:\n1469:           command: |\n1470:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-pi {cli_dispatch_args}\n1471:           working_directory: \"{repo_root}\"\n1472:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1473:           wait_for_completion: true\n1474:           notes:\n1475:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1476:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1477:             - \"cli-deepseek-harness has its own single-executor branch, if_cli_deepseek_harness above, built through the same buildLineageCommand. Fan-out also runs the kind\"\n1478:         record_executor_audit:\n1479:           skip_when: \"config.executor.kind == 'native'\"\n1480:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#appendExecutorAuditToLastRecord\"\n1481:           args:\n1482:             stateLogPath: \"{state_paths.state_log}\"\n1483:             executor: \"{config.executor}\"\n1484:             sessionId: \"{config.lineage.sessionId}\"\n1485:         if_cli_opencode:\n1486:           command: |\n1487:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-opencode {cli_dispatch_args}\n1488:           working_directory: \"{repo_root}\"\n1489:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1490:           wait_for_completion: true\n1491:           notes:\n1492:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1493:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1494:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1495:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1496:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1497:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1498:         if_cli_codex:\n1499:           command: |\n1500:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-codex {cli_dispatch_args}\n1501:           working_directory: \"{repo_root}\"\n1502:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1503:           wait_for_completion: true\n1504:           notes:\n1505:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1506:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1507:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1508:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1509:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1510:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1511:         post_dispatch_validate:\n1512:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1513:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1514:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing|executor_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1515:           assert_exists: \"{state_paths.iteration_pattern}\"\n1516:           assert_appended: \"{state_paths.state_log}\"\n1517:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1518:           route_proof:\n1519:             mode: research\n1520:             target_agent: deep-research\n1521:             agent_definition_loaded: true\n1522:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1523:           dispatchReceipt:\n1524:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1525:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1526:           sessionId: \"{config.lineage.sessionId}\"\n1527:           optional_jsonl_fields:\n1528:             logOffset: \"Byte offset where the seekable log region starts\"\n1529:             logSize: \"Byte length of the seekable log region\"\n1530:             logPath: \"Absolute path to the file containing the seekable log region\"\n1531:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1532:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1533:           assert_canonical_type: \"iteration\"\n1534:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1535:           assert_delta_file_has_iteration_record: true\n1536:           on_failure:\n1537:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1538:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1539:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1540:           failure_reasons_reference:\n1541:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1542:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1543:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1544:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1545:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1546:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1547:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1548:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1549:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1550:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1551:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1552:             - \"executor_missing — non-native executor did not record provenance\"\n1553:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1554: \n1555:       step_run_now_restore_check:\n1556:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1557:         command: |\n1558:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs restore --sentinel \"{state_paths.run_now_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1559:         outputs:\n1560:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1561: \n1562:       step_check_executor_unavailable:\n1563:         action: \"Stop when the current iteration dispatch records an unavailable executor\"\n1564:         read:\n1565:           - \"{state_paths.state_log}\"\n1566:         extract:\n1567:           - unavailable_record: \"Latest line with type == 'event', event == 'dispatch_failure', iteration == current_iteration, and executorUnavailable == true; else none\"\n1568:         branch_on: \"unavailable_record\"\n1569:         if_present:\n1570:           set: { reason: \"error\", stopReason: \"error\" }\n1571:           message: \"The {unavailable_record.executor.kind} executor is unavailable ({unavailable_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1572:           halt: true\n1573:           release_lock: step_release_lock\n1574:         if_absent:\n1575:           action: \"Continue to state reduction\"\n1576: \n1577:       step_reduce_state:\n1578:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1579:         dry_run_boundary: \"reducer-refresh\"\n1580:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1581:         inputs:\n1582:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1583:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1584:           priorReducedState: \"{state_paths.registry}\"\n1585:         outputs:\n1586:           - \"{state_paths.registry}\"\n1587:           - \"{state_paths.dashboard}\"\n1588:           - \"{state_paths.strategy}\"\n1589:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1590:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1591:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1592:         failure_modes:\n1593:           malformed_delta: \"skip + warn\"\n1594:           missing_iteration_file: \"no-op + error\"\n1595:           schema_mismatch: \"reject + conflict event\"\n1596:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1597:         guarantee: \"Idempotent for identical inputs\"\n1598: \n1599:       step_graph_upsert:\n1600:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1601:         dry_run_boundary: \"state-mutation\"\n1602:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1603:         command: |\n1604:           node .skilled/skills/system-deep-loop/runtime/scripts/iteration-graph-upsert.cjs --delta-dir \"{state_paths.delta_dir}\" --state-log \"{state_paths.state_log}\" --iteration \"{current_iteration}\" --spec-folder \"{spec_folder}\" --session-id \"{config.lineage.sessionId}\"\n1605: \n1606:       step_refresh_lineage_context:\n1607:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1608:         read:\n1609:           - \"{state_paths.dashboard}\"\n1610:           - \"{state_paths.registry}\"\n1611:           - \"{state_paths.strategy}\"\n1612:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1613:         use_response:\n1614:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1615:         failure_policy:\n1616:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1617:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1618:         outputs:\n1619:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n[Output truncated. Continue reading with offset: 1620]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 400, \"offset\": 1220, \"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1794807961651,"end":1794807961917}}}}
