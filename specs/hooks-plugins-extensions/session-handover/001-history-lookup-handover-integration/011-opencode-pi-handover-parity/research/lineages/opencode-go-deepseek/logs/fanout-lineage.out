{"type":"step_start","timestamp":1794807965404,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"id":"prt_1e2e426dc001BPBcxlkag5hS9V","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e41eb3001zHL1vy11SCtPiu","type":"step-start","snapshot":"3d41cb6cb899ce956a5cd220da2be58abaf1597e"}}
{"type":"tool_use","timestamp":1794807965997,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"partID":"prt_1e2e4276b002usUc9hKDBs2NAg","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e41eb3001zHL1vy11SCtPiu","type":"tool","id":"call_00_w9v5ma2bck1bc5thtqq1aozp","tool":"read","state":{"status":"completed","input":{"limit":450,"offset":1620,"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1620-2069\n1620:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1621: \n1622:       step_evaluate_results:\n1623:         action: \"Verify iteration outputs and extract metrics\"\n1624:         verify:\n1625:           - file_exists: \"{state_paths.iteration_pattern}\"\n1626:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1627:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1628:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1629:         extract:\n1630:           - newInfoRatio: \"From latest JSONL iteration record\"\n1631:           - findings_count: \"From latest JSONL iteration record\"\n1632:           - status: \"From latest JSONL iteration record\"\n1633:           - latest_focus: \"From latest JSONL iteration record\"\n1634:         on_missing_outputs:\n1635:           action: \"Inspect the latest dispatch record before handling missing outputs\"\n1636:           read:\n1637:             - \"{state_paths.state_log}\"\n1638:           extract:\n1639:             - last_record: \"Parse the latest state.jsonl record after dispatch\"\n1640:           branch_on: \"last_record.type == 'event' AND last_record.event == 'dispatch_failure' AND last_record.executorUnavailable == true\"\n1641:           if_executor_unavailable:\n1642:             set: { reason: \"error\", stopReason: \"error\" }\n1643:             message: \"The {last_record.executor.kind} executor is unavailable ({last_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1644:             halt: true\n1645:             release_lock: step_release_lock\n1646:           if_other_failure:\n1647:             action: \"Mark iteration as 'error', continue to next\"\n1648:             # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n1649:             # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1650:             append_jsonl: '{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1651: \n1652:       step_telemetry_heartbeat_progress:\n1653:         action: \"Emit a single-loop progress row when iteration state changes\"\n1654:         skip_when: \"config.fanout is present\"\n1655:         command: |\n1656:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase progress --execution-mode \"{execution_mode}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1657:         working_directory: \"{repo_root}\"\n1658:         outputs:\n1659:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n1660: \n1661:       # ─── APPROVAL GATE: Post-Iteration ───\n1662:       gate_post_iteration:\n1663:         applies_to: confirm\n1664:         type: approval_gate\n1665:         purpose: \"Show iteration results and get approval for next step\"\n1666:         present: |\n1667:           ## Iteration {current_iteration} Results\n1668: \n1669:           **Focus**: {latest_focus}\n1670:           **Findings**: {findings_count}\n1671:           **newInfoRatio**: {newInfoRatio}\n1672:           **Status**: {status}\n1673:           **Remaining Questions**: {remaining_questions}\n1674:           **Stuck Count**: {stuck_count}\n1675: \n1676:           **Recent Iteration Summary**:\n1677:           {last_3_summaries}\n1678: \n1679:           Options:\n1680:           A) Continue to next iteration\n1681:           B) Continue with adjusted focus: [user provides]\n1682:           C) Stop loop and synthesize\n1683:           D) Cancel entirely\n1684:         wait_for: \"User response\"\n1685:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1686:         on_A: { proceed_to: step_update_tracking }\n1687:         on_B: { action: \"Set next_focus to user's choice in strategy.md\", proceed_to: step_update_tracking }\n1688:         on_C:\n1689:           action: \"Record the operator-requested manual stop before synthesis\"\n1690:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1691:           set: { reason: \"manualStop\" }\n1692:           proceed_to: gate_pre_synthesis\n1693:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1694: \n1695:       step_update_tracking:\n1696:         action: \"Update loop tracking variables\"\n1697:         set:\n1698:           current_iteration: \"{current_iteration + 1}\"\n1699:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}.\"\n1700: \n1701:       step_loop_decision:\n1702:         action: \"Return to step_read_state for next iteration\"\n1703:         goto: step_read_state\n1704: \n1705:   # ════════\n1706:   # PHASE 3: SYNTHESIS\n1707:   # ════════\n1708:   phase_synthesis:\n1709:     purpose: Compile all iteration findings into final research/research.md\n1710:     steps:\n1711: \n1712:       step_fanout_merge:\n1713:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n1714:         skip_when: \"config.fanout is absent\"\n1715:         dry_run_boundary: \"reducer-refresh\"\n1716:         command: |\n1717:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n1718:             --loop-type research \\\n1719:             --artifact-dir {artifact_dir}\n1720:         working_directory: \"{repo_root}\"\n1721:         wait_for_completion: true\n1722: \n1723:       step_hydrate_summary_metrics:\n1724:         action: \"Hydrate summary metrics before synthesis\"\n1725:         read:\n1726:           - \"{state_paths.config}\"\n1727:           - \"{state_paths.state_log}\"\n1728:           - \"{state_paths.registry}\"\n1729:           - \"{state_paths.strategy}\"\n1730:         read_patterns:\n1731:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n1732:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n1733:         extract:\n1734:           - iteration_count: \"When direct lineage state logs exist, count distinct run values (run, else iteration) across those logs in stable lineage order; otherwise count distinct run values (run, else iteration) across the root state log. Never add root compatibility records to lineage records.\"\n1735:           - highest_run: \"When direct lineage state logs exist, take the highest run value (run, else iteration) across lines where type === 'iteration' in those logs in stable lineage order, else 0; otherwise take the highest run value (run, else iteration) across lines where type === 'iteration' in the root state log, else 0. Never add root compatibility records to lineage records.\"\n1736:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n1737:           - current_segment: \"Latest segment_start event segment, else 1\"\n1738:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n1739:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n1740:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n1741:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n1742:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n1743:           - answered_count: \"Count answered questions from strategy.md\"\n1744:           - total_questions: \"Count total questions tracked in strategy.md\"\n1745:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n1746:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n1747:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached.)\"\n1748: \n1749:       # ─── APPROVAL GATE: Pre-Synthesis ───\n1750:       gate_pre_synthesis:\n1751:         applies_to: confirm\n1752:         type: approval_gate\n1753:         purpose: \"Show loop summary and get approval to synthesize\"\n1754:         present: |\n1755:           ## Research Loop Complete\n1756: \n1757:           **Total Iterations**: {iteration_count}\n1758:           **Stop Reason**: {reason}\n1759:           **Questions Answered**: {answered_count}/{total_questions}\n1760:           **Recent Iteration Summary**: {last_3_summaries}\n1761: \n1762:           Review the iteration files in `{state_paths.iteration_dir}/` if you want more detail before synthesis.\n1763: \n1764:           Options:\n1765:           A) Proceed to synthesis\n1766:           B) Run more iterations (increase max)\n1767:           C) Cancel (keep iteration files)\n1768:         wait_for: \"User response\"\n1769:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1770:         on_A: { proceed_to: step_read_all_iterations }\n1771:         on_B: { action: \"Increase max_iterations, return to loop. When reason is maxDurationReached, raise maxDurationMinutes in the config too, or the duration check stops the loop again\", proceed_to: phase_loop }\n1772:         on_C: { action: \"Cancel synthesis, keep artifacts\", status: \"PARTIAL\" }\n1773: \n1774:       step_read_all_iterations:\n1775:         action: \"Read all iteration files and strategy\"\n1776:         read_patterns:\n1777:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n1778:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n1779:         read_also: \"{state_paths.strategy}\"\n1780:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n1781:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n1782: \n1783:       step_emit_resource_map:\n1784:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n1785:         dry_run_boundary: \"reducer-refresh\"\n1786:         branch_on: \"config.fanout\"\n1787:         if_present:\n1788:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n1789:           read:\n1790:             - \"{state_paths.config}\"\n1791:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1792:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n1793:         if_absent:\n1794:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n1795:           read:\n1796:             - \"{state_paths.config}\"\n1797:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1798:         write:\n1799:           - \"{state_paths.resource_map_output}\"\n1800:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n1801: \n1802:       step_compile_research:\n1803:         action: \"Compile or finalize research/research.md\"\n1804:         dry_run_boundary: \"state-mutation\"\n1805:         instructions: |\n1806:           If research/research.md exists (progressive synthesis was active):\n1807:             1. Read current research/research.md\n1808:             2. Consolidate and deduplicate findings across all iterations\n1809:             3. Fill any empty sections with findings from iteration files\n1810:             4. Remove redundancy while preserving all unique findings\n1811:             5. Add convergence report as appendix\n1812:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1813:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n1814: \n1815:           If research/research.md does not exist:\n1816:             1. Create research/research.md following 17-section template\n1817:             2. Populate sections from iteration files\n1818:             3. Add citations from original sources\n1819:             4. Note unanswered questions in Open Questions section\n1820:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1821:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n1822:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n1823:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n1824:         output: \"{state_paths.research_output}\"\n1825: \n1826:       step_convergence_report:\n1827:         action: \"Generate and append convergence report\"\n1828:         dry_run_boundary: \"state-mutation\"\n1829:         report: |\n1830:           ## Convergence Report\n1831:           - Stop reason: {reason}\n1832:           - Total iterations: {iteration_count}\n1833:           - Questions answered: {answered_count} / {total_questions}\n1834:           - Remaining questions: {remaining_questions}\n1835:           - Last 3 iteration summaries: {last_3_summaries}\n1836:           - Convergence threshold: {convergence_threshold}\n1837:           - Divergence summary: {divergence_summary}\n1838:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n1839:         command: |\n1840:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1841:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1842:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n1843:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n1844:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n1845:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n1846:             --artifact-dir \"{state_paths.packet_dir}\" \\\n1847:             --state-log \"{state_paths.state_log}\" \\\n1848:             --registry \"{state_paths.registry}\" \\\n1849:             --output \"{state_paths.research_output}\" \\\n1850:             --dashboard \"{state_paths.dashboard}\" \\\n1851:             --stop-reason \"{reason}\" \\\n1852:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n1853:           NODE_STATUS=$?\n1854:           for eventFile in \"$EVENT_DIR\"/*.json; do\n1855:             [ -e \"$eventFile\" ] || continue\n1856:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1857:             GATEWAY_STATUS=$?\n1858:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1859:               rm -rf \"$EVENT_DIR\"\n1860:               exit \"$GATEWAY_STATUS\"\n1861:             fi\n1862:           done\n1863:           rm -rf \"$EVENT_DIR\"\n1864:           exit \"$NODE_STATUS\"\n1865: \n1866:       gate_post_synthesis_spec_writeback:\n1867:         applies_to: confirm\n1868:         type: approval_gate\n1869:         purpose: \"Approve bounded spec.md write-back before memory-save review\"\n1870:         present: |\n1871:           ## Post-Synthesis Spec Write-Back\n1872: \n1873:           **Source of truth**: `{state_paths.research_output}`\n1874:           **Target**: `{spec_folder}/spec.md`\n1875:           **Generated Fence**:\n1876:           - `<!-- BEGIN GENERATED: deep-research/spec-findings -->`\n1877:           - `<!-- END GENERATED: deep-research/spec-findings -->`\n1878: \n1879:           Planned action:\n1880:           - replace exactly one generated findings block under the chosen host anchor\n1881:           - fail closed on missing host anchor, duplicate markers, or human edits inside the machine-owned block\n1882: \n1883:           Options:\n1884:           A) Approve write-back\n1885:           B) Revise before write-back\n1886:           C) Defer spec.md write-back\n1887:         wait_for: \"User response\"\n1888:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1889:         on_A: { proceed_to: step_writeback_spec_findings }\n1890:         on_B: { action: \"Adjust the synthesis or write-back inputs\", return_to: gate_post_synthesis_spec_writeback }\n1891:         on_C:\n1892:           dry_run_event_policy: preview-only\n1893:           append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_synthesis_deferred\",\"reason\":\"confirm_mode_deferred_writeback\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1894:           proceed_to: step_update_config_status\n1895: \n1896:       step_writeback_spec_findings:\n1897:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n1898:         dry_run_boundary: \"state-mutation\"\n1899:         edit: \"{spec_folder}/spec.md\"\n1900:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n1901:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n1902:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n1903:         fail_closed_conflict_check:\n1904:           if_existing_generated_fence_present:\n1905:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n1906:             on_manual_edit_conflict:\n1907:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1908:               halt: true\n1909:               release_lock: step_release_lock\n1910:         instructions:\n1911:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n1912:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n1913:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n1914:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n1915:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n1916:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1917: \n1918:       step_validate_post_synthesis_spec_doc:\n1919:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n1920:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n1921:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n1922: \n1923:       step_update_config_status:\n1924:         action: \"Mark config as complete\"\n1925:         dry_run_boundary: \"state-mutation\"\n1926:         edit: \"{state_paths.config}\"\n1927:         set_field: { status: \"complete\" }\n1928: \n1929:       step_telemetry_heartbeat_terminal:\n1930:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n1931:         skip_when: \"config.fanout is present\"\n1932:         terminal_events: [completed, failed, stopped]\n1933:         command: |\n1934:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase terminal --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --reason \"{reason}\"\n1935:         working_directory: \"{repo_root}\"\n1936:         outputs:\n1937:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n1938: \n1939:       step_stage_artifact_dir:\n1940:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n1941:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n1942:         dry_run_boundary: \"state-mutation\"\n1943:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n1944:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n1945:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n1946: \n1947:       # ─── APPROVAL GATE: Post-Synthesis ───\n1948:       gate_post_synthesis:\n1949:         applies_to: confirm\n1950:         type: approval_gate\n1951:         purpose: \"Show synthesis results and get approval\"\n1952:         present: |\n1953:           ## Synthesis Complete\n1954: \n1955:           **research/research.md** has been compiled with findings from {iteration_count} iterations.\n1956:           **Remaining Questions**: {remaining_questions_list}\n1957:           Review `{state_paths.research_output}` before deciding whether to save memory.\n1958:           Confirm-mode cleanup keeps the advisory lock until save, skip-save, or cancellation cleanup resolves.\n1959: \n1960:           Options:\n1961:           A) Approve and save to memory\n1962:           B) Request revisions to research/research.md\n1963:           C) Skip memory save\n1964:         wait_for: \"User response\"\n1965:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1966:         on_A: { proceed_to: phase_save }\n1967:         on_B: { action: \"Apply user revisions\", return_to: gate_post_synthesis }\n1968:         on_C: { proceed_to: completion }\n1969: \n1970:   # ════════\n1971:   # PHASE 4: SAVE\n1972:   # ════════\n1973:   phase_save:\n1974:     purpose: Preserve research context in the packet's canonical continuity documents\n1975:     steps:\n1976: \n1977:       step_compose_save_payload:\n1978:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n1979:         dry_run_boundary: \"state-mutation\"\n1980:         output: \"/tmp/save-context-data-<session-id>.json\"\n1981:         requirements:\n1982:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n1983:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop. Without `--full-auto` the writer only plans, and a full-auto save writes continuity only from `recent_action`, `next_safe_action`, `blockers` and `key_files`, so the payload carries all four.\"\n1984:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n1985:         example_payload: |\n1986:           {\n1987:             \"specFolder\": \"{spec_folder}\",\n1988:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n1989:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n1990:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n1991:             \"exchanges\": [],\n1992:             \"toolCalls\": [],\n1993:             \"recent_action\": \"Deep research finished after {iteration_count} iterations\",\n1994:             \"next_safe_action\": \"Act on the synthesis in research/research.md\",\n1995:             \"blockers\": [],\n1996:             \"key_files\": [\"research/research.md\"]\n1997:           }\n1998: \n1999:       step_generate_context:\n2000:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2001:         dry_run_boundary: \"state-mutation\"\n2002:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder} --full-auto\"\n2003:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2004: \n2005:       step_verify_save:\n2006:         action: \"Verify canonical save routed content into the correct spec document\"\n2007:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2008:         on_fail: \"Log warning but do not block completion\"\n2009: \n2010:       step_release_lock:\n2011:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2012:         dry_run_boundary: \"state-mutation\"\n2013:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2014:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2015: \n2016:   # ════════\n2017:   # COMPLETION\n2018:   # ════════\n2019:   completion:\n2020:     message: |\n2021:       Deep research complete.\n2022:       Iterations: {iteration_count} | Stop reason: {reason}\n2023:       Questions answered: {answered_count}/{total_questions}\n2024: \n2025:       Artifacts:\n2026:         - research/research.md (compiled from {iteration_count} iterations)\n2027:         - {iteration_count} iteration files in research/\n2028:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2029:         - Continuity update routed into the canonical spec document\n2030: \n2031:       STATUS=OK PATH={spec_folder}\n2032:     next_steps:\n2033:       - \"/speckit:plan [feature-description]\"\n2034:       - \"/deep:research [new-topic] (for related deep research)\"\n2035:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2036: \n2037: # ────────\n2038: # ERROR RECOVERY\n2039: # ────────\n2040: error_recovery:\n2041:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2042:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2043:   consecutive_failures: \"See step_check_convergence rule 1a. The script counts trailing failed iterations from the state log and returns stop reason error.\"\n2044:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2045: \n2046: # ────────\n2047: # RULES\n2048: # ────────\n2049: rules:\n2050:   DRY_RUN_OVERRIDES:\n2051:     - \"When dry_run is true, dry_run_control overrides default dispatch, write, reducer, continuity-save, and child-spawn requirements.\"\n2052:     - \"Dry-run preview events are emitted to terminal output only and are not persisted.\"\n2053:   ALWAYS:\n2054:     - follow_workflow_phases_in_order\n2055:     - dispatch_deep_research_agent_per_iteration\n2056:     - check_convergence_before_each_iteration\n2057:     - write_all_state_to_files\n2058:     - refresh_lineage_context_before_next_prompt\n2059:     - write_continuity_after_synthesis\n2060:     - respect_max_iterations_cap\n2061:   NEVER:\n2062:     - skip_convergence_check\n2063:     - dispatch_non_leaf_agents\n2064:     - hold_iteration_findings_in_memory_only\n2065:     - modify_config_after_initialization\n2066:     - overwrite_jsonl_state_log\n2067:     - proceed_without_state_file_verification\n2068: \n2069: # ────────\n[Output truncated. Continue reading with offset: 2070]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1620-2069\n1620:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1621: \n1622:       step_evaluate_results:\n1623:         action: \"Verify iteration outputs and extract metrics\"\n1624:         verify:\n1625:           - file_exists: \"{state_paths.iteration_pattern}\"\n1626:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1627:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1628:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1629:         extract:\n1630:           - newInfoRatio: \"From latest JSONL iteration record\"\n1631:           - findings_count: \"From latest JSONL iteration record\"\n1632:           - status: \"From latest JSONL iteration record\"\n1633:           - latest_focus: \"From latest JSONL iteration record\"\n1634:         on_missing_outputs:\n1635:           action: \"Inspect the latest dispatch record before handling missing outputs\"\n1636:           read:\n1637:             - \"{state_paths.state_log}\"\n1638:           extract:\n1639:             - last_record: \"Parse the latest state.jsonl record after dispatch\"\n1640:           branch_on: \"last_record.type == 'event' AND last_record.event == 'dispatch_failure' AND last_record.executorUnavailable == true\"\n1641:           if_executor_unavailable:\n1642:             set: { reason: \"error\", stopReason: \"error\" }\n1643:             message: \"The {last_record.executor.kind} executor is unavailable ({last_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1644:             halt: true\n1645:             release_lock: step_release_lock\n1646:           if_other_failure:\n1647:             action: \"Mark iteration as 'error', continue to next\"\n1648:             # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n1649:             # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1650:             append_jsonl: '{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1651: \n1652:       step_telemetry_heartbeat_progress:\n1653:         action: \"Emit a single-loop progress row when iteration state changes\"\n1654:         skip_when: \"config.fanout is present\"\n1655:         command: |\n1656:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase progress --execution-mode \"{execution_mode}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1657:         working_directory: \"{repo_root}\"\n1658:         outputs:\n1659:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n1660: \n1661:       # ─── APPROVAL GATE: Post-Iteration ───\n1662:       gate_post_iteration:\n1663:         applies_to: confirm\n1664:         type: approval_gate\n1665:         purpose: \"Show iteration results and get approval for next step\"\n1666:         present: |\n1667:           ## Iteration {current_iteration} Results\n1668: \n1669:           **Focus**: {latest_focus}\n1670:           **Findings**: {findings_count}\n1671:           **newInfoRatio**: {newInfoRatio}\n1672:           **Status**: {status}\n1673:           **Remaining Questions**: {remaining_questions}\n1674:           **Stuck Count**: {stuck_count}\n1675: \n1676:           **Recent Iteration Summary**:\n1677:           {last_3_summaries}\n1678: \n1679:           Options:\n1680:           A) Continue to next iteration\n1681:           B) Continue with adjusted focus: [user provides]\n1682:           C) Stop loop and synthesize\n1683:           D) Cancel entirely\n1684:         wait_for: \"User response\"\n1685:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1686:         on_A: { proceed_to: step_update_tracking }\n1687:         on_B: { action: \"Set next_focus to user's choice in strategy.md\", proceed_to: step_update_tracking }\n1688:         on_C:\n1689:           action: \"Record the operator-requested manual stop before synthesis\"\n1690:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1691:           set: { reason: \"manualStop\" }\n1692:           proceed_to: gate_pre_synthesis\n1693:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1694: \n1695:       step_update_tracking:\n1696:         action: \"Update loop tracking variables\"\n1697:         set:\n1698:           current_iteration: \"{current_iteration + 1}\"\n1699:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}.\"\n1700: \n1701:       step_loop_decision:\n1702:         action: \"Return to step_read_state for next iteration\"\n1703:         goto: step_read_state\n1704: \n1705:   # ════════\n1706:   # PHASE 3: SYNTHESIS\n1707:   # ════════\n1708:   phase_synthesis:\n1709:     purpose: Compile all iteration findings into final research/research.md\n1710:     steps:\n1711: \n1712:       step_fanout_merge:\n1713:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n1714:         skip_when: \"config.fanout is absent\"\n1715:         dry_run_boundary: \"reducer-refresh\"\n1716:         command: |\n1717:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n1718:             --loop-type research \\\n1719:             --artifact-dir {artifact_dir}\n1720:         working_directory: \"{repo_root}\"\n1721:         wait_for_completion: true\n1722: \n1723:       step_hydrate_summary_metrics:\n1724:         action: \"Hydrate summary metrics before synthesis\"\n1725:         read:\n1726:           - \"{state_paths.config}\"\n1727:           - \"{state_paths.state_log}\"\n1728:           - \"{state_paths.registry}\"\n1729:           - \"{state_paths.strategy}\"\n1730:         read_patterns:\n1731:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n1732:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n1733:         extract:\n1734:           - iteration_count: \"When direct lineage state logs exist, count distinct run values (run, else iteration) across those logs in stable lineage order; otherwise count distinct run values (run, else iteration) across the root state log. Never add root compatibility records to lineage records.\"\n1735:           - highest_run: \"When direct lineage state logs exist, take the highest run value (run, else iteration) across lines where type === 'iteration' in those logs in stable lineage order, else 0; otherwise take the highest run value (run, else iteration) across lines where type === 'iteration' in the root state log, else 0. Never add root compatibility records to lineage records.\"\n1736:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n1737:           - current_segment: \"Latest segment_start event segment, else 1\"\n1738:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n1739:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n1740:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n1741:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n1742:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n1743:           - answered_count: \"Count answered questions from strategy.md\"\n1744:           - total_questions: \"Count total questions tracked in strategy.md\"\n1745:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n1746:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n1747:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached.)\"\n1748: \n1749:       # ─── APPROVAL GATE: Pre-Synthesis ───\n1750:       gate_pre_synthesis:\n1751:         applies_to: confirm\n1752:         type: approval_gate\n1753:         purpose: \"Show loop summary and get approval to synthesize\"\n1754:         present: |\n1755:           ## Research Loop Complete\n1756: \n1757:           **Total Iterations**: {iteration_count}\n1758:           **Stop Reason**: {reason}\n1759:           **Questions Answered**: {answered_count}/{total_questions}\n1760:           **Recent Iteration Summary**: {last_3_summaries}\n1761: \n1762:           Review the iteration files in `{state_paths.iteration_dir}/` if you want more detail before synthesis.\n1763: \n1764:           Options:\n1765:           A) Proceed to synthesis\n1766:           B) Run more iterations (increase max)\n1767:           C) Cancel (keep iteration files)\n1768:         wait_for: \"User response\"\n1769:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1770:         on_A: { proceed_to: step_read_all_iterations }\n1771:         on_B: { action: \"Increase max_iterations, return to loop. When reason is maxDurationReached, raise maxDurationMinutes in the config too, or the duration check stops the loop again\", proceed_to: phase_loop }\n1772:         on_C: { action: \"Cancel synthesis, keep artifacts\", status: \"PARTIAL\" }\n1773: \n1774:       step_read_all_iterations:\n1775:         action: \"Read all iteration files and strategy\"\n1776:         read_patterns:\n1777:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n1778:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n1779:         read_also: \"{state_paths.strategy}\"\n1780:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n1781:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n1782: \n1783:       step_emit_resource_map:\n1784:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n1785:         dry_run_boundary: \"reducer-refresh\"\n1786:         branch_on: \"config.fanout\"\n1787:         if_present:\n1788:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n1789:           read:\n1790:             - \"{state_paths.config}\"\n1791:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1792:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n1793:         if_absent:\n1794:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n1795:           read:\n1796:             - \"{state_paths.config}\"\n1797:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1798:         write:\n1799:           - \"{state_paths.resource_map_output}\"\n1800:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n1801: \n1802:       step_compile_research:\n1803:         action: \"Compile or finalize research/research.md\"\n1804:         dry_run_boundary: \"state-mutation\"\n1805:         instructions: |\n1806:           If research/research.md exists (progressive synthesis was active):\n1807:             1. Read current research/research.md\n1808:             2. Consolidate and deduplicate findings across all iterations\n1809:             3. Fill any empty sections with findings from iteration files\n1810:             4. Remove redundancy while preserving all unique findings\n1811:             5. Add convergence report as appendix\n1812:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1813:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n1814: \n1815:           If research/research.md does not exist:\n1816:             1. Create research/research.md following 17-section template\n1817:             2. Populate sections from iteration files\n1818:             3. Add citations from original sources\n1819:             4. Note unanswered questions in Open Questions section\n1820:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1821:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n1822:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n1823:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n1824:         output: \"{state_paths.research_output}\"\n1825: \n1826:       step_convergence_report:\n1827:         action: \"Generate and append convergence report\"\n1828:         dry_run_boundary: \"state-mutation\"\n1829:         report: |\n1830:           ## Convergence Report\n1831:           - Stop reason: {reason}\n1832:           - Total iterations: {iteration_count}\n1833:           - Questions answered: {answered_count} / {total_questions}\n1834:           - Remaining questions: {remaining_questions}\n1835:           - Last 3 iteration summaries: {last_3_summaries}\n1836:           - Convergence threshold: {convergence_threshold}\n1837:           - Divergence summary: {divergence_summary}\n1838:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n1839:         command: |\n1840:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1841:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1842:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n1843:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n1844:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n1845:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n1846:             --artifact-dir \"{state_paths.packet_dir}\" \\\n1847:             --state-log \"{state_paths.state_log}\" \\\n1848:             --registry \"{state_paths.registry}\" \\\n1849:             --output \"{state_paths.research_output}\" \\\n1850:             --dashboard \"{state_paths.dashboard}\" \\\n1851:             --stop-reason \"{reason}\" \\\n1852:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n1853:           NODE_STATUS=$?\n1854:           for eventFile in \"$EVENT_DIR\"/*.json; do\n1855:             [ -e \"$eventFile\" ] || continue\n1856:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1857:             GATEWAY_STATUS=$?\n1858:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1859:               rm -rf \"$EVENT_DIR\"\n1860:               exit \"$GATEWAY_STATUS\"\n1861:             fi\n1862:           done\n1863:           rm -rf \"$EVENT_DIR\"\n1864:           exit \"$NODE_STATUS\"\n1865: \n1866:       gate_post_synthesis_spec_writeback:\n1867:         applies_to: confirm\n1868:         type: approval_gate\n1869:         purpose: \"Approve bounded spec.md write-back before memory-save review\"\n1870:         present: |\n1871:           ## Post-Synthesis Spec Write-Back\n1872: \n1873:           **Source of truth**: `{state_paths.research_output}`\n1874:           **Target**: `{spec_folder}/spec.md`\n1875:           **Generated Fence**:\n1876:           - `<!-- BEGIN GENERATED: deep-research/spec-findings -->`\n1877:           - `<!-- END GENERATED: deep-research/spec-findings -->`\n1878: \n1879:           Planned action:\n1880:           - replace exactly one generated findings block under the chosen host anchor\n1881:           - fail closed on missing host anchor, duplicate markers, or human edits inside the machine-owned block\n1882: \n1883:           Options:\n1884:           A) Approve write-back\n1885:           B) Revise before write-back\n1886:           C) Defer spec.md write-back\n1887:         wait_for: \"User response\"\n1888:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1889:         on_A: { proceed_to: step_writeback_spec_findings }\n1890:         on_B: { action: \"Adjust the synthesis or write-back inputs\", return_to: gate_post_synthesis_spec_writeback }\n1891:         on_C:\n1892:           dry_run_event_policy: preview-only\n1893:           append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_synthesis_deferred\",\"reason\":\"confirm_mode_deferred_writeback\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1894:           proceed_to: step_update_config_status\n1895: \n1896:       step_writeback_spec_findings:\n1897:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n1898:         dry_run_boundary: \"state-mutation\"\n1899:         edit: \"{spec_folder}/spec.md\"\n1900:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n1901:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n1902:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n1903:         fail_closed_conflict_check:\n1904:           if_existing_generated_fence_present:\n1905:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n1906:             on_manual_edit_conflict:\n1907:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1908:               halt: true\n1909:               release_lock: step_release_lock\n1910:         instructions:\n1911:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n1912:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n1913:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n1914:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n1915:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n1916:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1917: \n1918:       step_validate_post_synthesis_spec_doc:\n1919:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n1920:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n1921:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n1922: \n1923:       step_update_config_status:\n1924:         action: \"Mark config as complete\"\n1925:         dry_run_boundary: \"state-mutation\"\n1926:         edit: \"{state_paths.config}\"\n1927:         set_field: { status: \"complete\" }\n1928: \n1929:       step_telemetry_heartbeat_terminal:\n1930:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n1931:         skip_when: \"config.fanout is present\"\n1932:         terminal_events: [completed, failed, stopped]\n1933:         command: |\n1934:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase terminal --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --reason \"{reason}\"\n1935:         working_directory: \"{repo_root}\"\n1936:         outputs:\n1937:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n1938: \n1939:       step_stage_artifact_dir:\n1940:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n1941:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n1942:         dry_run_boundary: \"state-mutation\"\n1943:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n1944:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n1945:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n1946: \n1947:       # ─── APPROVAL GATE: Post-Synthesis ───\n1948:       gate_post_synthesis:\n1949:         applies_to: confirm\n1950:         type: approval_gate\n1951:         purpose: \"Show synthesis results and get approval\"\n1952:         present: |\n1953:           ## Synthesis Complete\n1954: \n1955:           **research/research.md** has been compiled with findings from {iteration_count} iterations.\n1956:           **Remaining Questions**: {remaining_questions_list}\n1957:           Review `{state_paths.research_output}` before deciding whether to save memory.\n1958:           Confirm-mode cleanup keeps the advisory lock until save, skip-save, or cancellation cleanup resolves.\n1959: \n1960:           Options:\n1961:           A) Approve and save to memory\n1962:           B) Request revisions to research/research.md\n1963:           C) Skip memory save\n1964:         wait_for: \"User response\"\n1965:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1966:         on_A: { proceed_to: phase_save }\n1967:         on_B: { action: \"Apply user revisions\", return_to: gate_post_synthesis }\n1968:         on_C: { proceed_to: completion }\n1969: \n1970:   # ════════\n1971:   # PHASE 4: SAVE\n1972:   # ════════\n1973:   phase_save:\n1974:     purpose: Preserve research context in the packet's canonical continuity documents\n1975:     steps:\n1976: \n1977:       step_compose_save_payload:\n1978:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n1979:         dry_run_boundary: \"state-mutation\"\n1980:         output: \"/tmp/save-context-data-<session-id>.json\"\n1981:         requirements:\n1982:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n1983:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop. Without `--full-auto` the writer only plans, and a full-auto save writes continuity only from `recent_action`, `next_safe_action`, `blockers` and `key_files`, so the payload carries all four.\"\n1984:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n1985:         example_payload: |\n1986:           {\n1987:             \"specFolder\": \"{spec_folder}\",\n1988:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n1989:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n1990:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n1991:             \"exchanges\": [],\n1992:             \"toolCalls\": [],\n1993:             \"recent_action\": \"Deep research finished after {iteration_count} iterations\",\n1994:             \"next_safe_action\": \"Act on the synthesis in research/research.md\",\n1995:             \"blockers\": [],\n1996:             \"key_files\": [\"research/research.md\"]\n1997:           }\n1998: \n1999:       step_generate_context:\n2000:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2001:         dry_run_boundary: \"state-mutation\"\n2002:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder} --full-auto\"\n2003:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2004: \n2005:       step_verify_save:\n2006:         action: \"Verify canonical save routed content into the correct spec document\"\n2007:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2008:         on_fail: \"Log warning but do not block completion\"\n2009: \n2010:       step_release_lock:\n2011:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2012:         dry_run_boundary: \"state-mutation\"\n2013:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2014:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2015: \n2016:   # ════════\n2017:   # COMPLETION\n2018:   # ════════\n2019:   completion:\n2020:     message: |\n2021:       Deep research complete.\n2022:       Iterations: {iteration_count} | Stop reason: {reason}\n2023:       Questions answered: {answered_count}/{total_questions}\n2024: \n2025:       Artifacts:\n2026:         - research/research.md (compiled from {iteration_count} iterations)\n2027:         - {iteration_count} iteration files in research/\n2028:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2029:         - Continuity update routed into the canonical spec document\n2030: \n2031:       STATUS=OK PATH={spec_folder}\n2032:     next_steps:\n2033:       - \"/speckit:plan [feature-description]\"\n2034:       - \"/deep:research [new-topic] (for related deep research)\"\n2035:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2036: \n2037: # ────────\n2038: # ERROR RECOVERY\n2039: # ────────\n2040: error_recovery:\n2041:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2042:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2043:   consecutive_failures: \"See step_check_convergence rule 1a. The script counts trailing failed iterations from the state log and returns stop reason error.\"\n2044:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2045: \n2046: # ────────\n2047: # RULES\n2048: # ────────\n2049: rules:\n2050:   DRY_RUN_OVERRIDES:\n2051:     - \"When dry_run is true, dry_run_control overrides default dispatch, write, reducer, continuity-save, and child-spawn requirements.\"\n2052:     - \"Dry-run preview events are emitted to terminal output only and are not persisted.\"\n2053:   ALWAYS:\n2054:     - follow_workflow_phases_in_order\n2055:     - dispatch_deep_research_agent_per_iteration\n2056:     - check_convergence_before_each_iteration\n2057:     - write_all_state_to_files\n2058:     - refresh_lineage_context_before_next_prompt\n2059:     - write_continuity_after_synthesis\n2060:     - respect_max_iterations_cap\n2061:   NEVER:\n2062:     - skip_convergence_check\n2063:     - dispatch_non_leaf_agents\n2064:     - hold_iteration_findings_in_memory_only\n2065:     - modify_config_after_initialization\n2066:     - overwrite_jsonl_state_log\n2067:     - proceed_without_state_file_verification\n2068: \n2069: # ────────\n[Output truncated. Continue reading with offset: 2070]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 450, \"offset\": 1620, \"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1794807965547,"end":1794807965997}}}}
