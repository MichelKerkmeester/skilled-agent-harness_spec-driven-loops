 relation: String(event.relation ?? '').toUpperCase(),\n150-      });\n151-    }\n152-  }\n153-  return { nodes, edges };\n154-}\n155-\n156-/**\n157- * Picks this iteration's graph events. The delta file wins over the state log\n158- * whenever it exists, even when it carries no events: falling back to the log\n159- * there would replay an earlier iteration's graph.\n160- *\n161- * @param {{ deltaDir: string, stateLogPath: string, iteration: number }} input - Source selection.\n162- * @returns {Array<unknown>} Graph events.\n163- */\n164-function readGraphEvents({ deltaDir, stateLogPath, iteration }) {\n165-  const deltaPath = path.join(deltaDir, `iter-${String(iteration).padStart(3, '0')}.jsonl`);\n166-  const sourcePath = existsSync(deltaPath) ? deltaPath : stateLogPath;\n167-  const records = existsSync(sourcePath)\n168-    ? parseJsonLines(readFileSync(sourcePath, 'utf8'), sourcePath)\n169-    : [];\n170-  return latestGraphEvents(records);\n171-}\n172-\n173-/**\n174- * Runs the upsert entrypoint. No `env` and no `cwd` are passed, so the child\n175- * inherits both: tests pin the coverage database through the environment, and\n176- * the entrypoint resolves its own TypeScript modules from its own directory.\n177- *\n--\n188:  const { nodes, edges } = splitGraphEvents(readGraphEvents({ deltaDir, stateLogPath, iteration }));\n189-\n190-  if (nodes.length === 0 && edges.length === 0) {\n191-    process.stdout.write(`deep-research graph upsert: no graph events for iteration ${iteration}; skipping\\n`);\n192-    return 0;\n193-  }\n194-\n195-  const upsert = spawnSync(\n196-    process.execPath,\n197-    [\n198-      path.join(__dirname, 'upsert.cjs'),\n199-      '--spec-folder', specFolder,\n200-      '--loop-type', LOOP_TYPE,\n201-      '--session-id', sessionId,\n202-      '--nodes', JSON.stringify(nodes),\n203-      '--edges', JSON.stringify(edges),\n204-    ],\n205-    { encoding: 'utf8' },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":fals