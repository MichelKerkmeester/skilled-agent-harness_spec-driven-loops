{"type":"tool_use","timestamp":1794808270249,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"partID":"prt_1e2e8ccbd001DzOelRbyi3ISm0","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e8ad77001U1qOW4Pwq64CTh","type":"tool","id":"call_01_lkbui98v327p9qsskn512nbe","tool":"read","state":{"status":"completed","input":{"path":".skilled/hooks/shared/session-readers/project.mjs"},"output":"Read file .skilled/hooks/shared/session-readers/project.mjs, lines 1-229\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Projection\n3: // ───────────────────────────────────────────────────────────────────\n4: // Readers hand over neutral entries in the store's own order. This module\n5: // owns the one entry-list contract those entries become: stable ids, a\n6: // zero-based sequence, an ISO timestamp, role-discriminated content blocks,\n7: // and the tool-call/result pairing rule. A pairing defect fails the whole\n8: // read so a caller never receives a partial conversation.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. CONSTANTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: export const PROJECTION_ERRORS = Object.freeze({\n15:   DUPLICATE_ENTRY_ID: 'DUPLICATE_ENTRY_ID',\n16:   INVALID_ENTRY: 'INVALID_ENTRY',\n17:   DUPLICATE_TOOL_CALL: 'DUPLICATE_TOOL_CALL',\n18:   ORPHAN_TOOL_RESULT: 'ORPHAN_TOOL_RESULT',\n19:   DUPLICATE_TOOL_RESULT: 'DUPLICATE_TOOL_RESULT',\n20:   MISMATCHED_TOOL_RESULT: 'MISMATCHED_TOOL_RESULT',\n21:   INCOMPLETE_TOOL_RESULTS: 'INCOMPLETE_TOOL_RESULTS',\n22: });\n23: \n24: const ROLES = new Set(['user', 'assistant', 'toolResult']);\n25: const MAX_ID_LENGTH = 128;\n26: const EPOCH = new Date(0).toISOString();\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 2. BLOCK HELPERS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: export function textBlock(text) {\n33:   return { type: 'text', text: String(text) };\n34: }\n35: \n36: export function thinkingBlock(thinking) {\n37:   return { type: 'thinking', thinking: String(thinking) };\n38: }\n39: \n40: export function toolCallBlock({ id, name, arguments: args } = {}) {\n41:   return {\n42:     type: 'toolCall',\n43:     id: String(id),\n44:     name: String(name),\n45:     arguments: args && typeof args === 'object' && !Array.isArray(args) ? args : {},\n46:   };\n47: }\n48: \n49: export function imageBlock({ data, mimeType } = {}) {\n50:   return { type: 'image', data: String(data), mimeType: String(mimeType) };\n51: }\n52: \n53: function isRecord(value) {\n54:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n55: }\n56: \n57: function validBlock(block) {\n58:   if (!isRecord(block) || typeof block.type !== 'string') return false;\n59:   if (block.type === 'text') return typeof block.text === 'string';\n60:   if (block.type === 'thinking') return typeof block.thinking === 'string';\n61:   if (block.type === 'toolCall') {\n62:     return typeof block.id === 'string'\n63:       && block.id.length > 0\n64:       && typeof block.name === 'string'\n65:       && block.name.length > 0\n66:       && isRecord(block.arguments);\n67:   }\n68:   if (block.type === 'image') {\n69:     return typeof block.data === 'string' && typeof block.mimeType === 'string';\n70:   }\n71:   return false;\n72: }\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 3. STORE PARSING HELPERS\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: export function parseJsonObject(value) {\n79:   if (typeof value !== 'string' || !value.trim()) return null;\n80:   try {\n81:     const parsed = JSON.parse(value);\n82:     return isRecord(parsed) ? parsed : null;\n83:   } catch {\n84:     return null;\n85:   }\n86: }\n87: \n88: // A killed process can leave a torn final line, so a malformed line is skipped\n89: // rather than failing a read that still holds every complete entry.\n90: export function parseJsonLines(text) {\n91:   const lines = [];\n92:   for (const line of String(text).split('\\n')) {\n93:     if (!line.trim()) continue;\n94:     const parsed = parseJsonObject(line);\n95:     if (parsed) lines.push(parsed);\n96:   }\n97:   return lines;\n98: }\n99: \n100: export function contentText(content) {\n101:   if (typeof content === 'string') return content;\n102:   if (!Array.isArray(content)) return '';\n103:   return content\n104:     .filter((item) => isRecord(item) && item.type === 'text' && typeof item.text === 'string')\n105:     .map((item) => item.text)\n106:     .join('\\n');\n107: }\n108: \n109: // ─────────────────────────────────────────────────────────────────────────────\n110: // 4. TIMESTAMP NORMALIZATION\n111: // ─────────────────────────────────────────────────────────────────────────────\n112: \n113: export function isoOr(value, fallback = EPOCH) {\n114:   if (typeof value === 'string' && value.trim()) {\n115:     const parsed = Date.parse(value);\n116:     if (!Number.isNaN(parsed)) return new Date(parsed).toISOString();\n117:   }\n118:   if (typeof value === 'number' && Number.isFinite(value)) {\n119:     // A finite number can still sit outside the Date range, so the constructed\n120:     // date is checked before serializing rather than trusting the guard alone.\n121:     const date = new Date(value);\n122:     if (!Number.isNaN(date.getTime())) return date.toISOString();\n123:   }\n124:   return fallback;\n125: }\n126: \n127: // ─────────────────────────────────────────────────────────────────────────────\n128: // 5. PAIRING VALIDATION\n129: // ─────────────────────────────────────────────────────────────────────────────\n130: \n131: function fail(reason) {\n132:   return { ok: false, reason };\n133: }\n134: \n135: function checkedRecord(record) {\n136:   if (!isRecord(record)) return false;\n137:   if (typeof record.id !== 'string' || !record.id || record.id.length > MAX_ID_LENGTH) return false;\n138:   if (!ROLES.has(record.role)) return false;\n139:   if (!Array.isArray(record.content) || !record.content.every(validBlock)) return false;\n140:   if (record.role === 'toolResult') {\n141:     if (typeof record.toolCallId !== 'string' || !record.toolCallId) return false;\n142:     if (record.isError !== undefined && typeof record.isError !== 'boolean') return false;\n143:   }\n144:   return true;\n145: }\n146: \n147: // The order is the store's order. An assistant entry owns the tool results that\n148: // immediately follow it; a result that arrives without that owner, twice, or\n149: // under a call id the owner never made is a broken projection, not a skippable\n150: // line. A turn still streaming at the end of the file is the one incomplete\n151: // case that is accepted, because its result may not be written yet.\n152: export function projectEntries(records) {\n153:   if (!Array.isArray(records)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n154: \n155:   const items = [];\n156:   const seenIds = new Set();\n157:   const seenCallIds = new Set();\n158:   let lastTimestamp = EPOCH;\n159: \n160:   for (let index = 0; index < records.length; index += 1) {\n161:     const record = records[index];\n162:     if (!checkedRecord(record)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n163:     if (seenIds.has(record.id)) return fail(PROJECTION_ERRORS.DUPLICATE_ENTRY_ID);\n164:     seenIds.add(record.id);\n165: \n166:     lastTimestamp = isoOr(record.timestamp, lastTimestamp);\n167: \n168:     if (record.role !== 'assistant') {\n169:       if (record.role === 'toolResult') return fail(PROJECTION_ERRORS.ORPHAN_TOOL_RESULT);\n170:       items.push({\n171:         id: record.id,\n172:         role: record.role,\n173:         sequence: items.length,\n174:         timestamp: lastTimestamp,\n175:         content: record.content,\n176:       });\n177:       continue;\n178:     }\n179: \n180:     const calls = record.content.filter((block) => block.type === 'toolCall');\n181:     const expected = new Set();\n182:     for (const call of calls) {\n183:       if (seenCallIds.has(call.id)) return fail(PROJECTION_ERRORS.DUPLICATE_TOOL_CALL);\n184:       seenCallIds.add(call.id);\n185:       expected.add(call.id);\n186:     }\n187: \n188:     items.push({\n189:       id: record.id,\n190:       role: record.role,\n191:       sequence: items.length,\n192:       timestamp: lastTimestamp,\n193:       content: record.content,\n194:     });\n195: \n196:     const seenResults = new Set();\n197:     let cursor = index + 1;\n198:     while (cursor < records.length && isRecord(records[cursor]) && records[cursor].role === 'toolResult') {\n199:       const result = records[cursor];\n200:       if (!checkedRecord(result)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n201:       if (seenIds.has(result.id)) return fail(PROJECTION_ERRORS.DUPLICATE_ENTRY_ID);\n202:       seenIds.add(result.id);\n203: \n204:       if (!expected.has(result.toolCallId)) return fail(PROJECTION_ERRORS.MISMATCHED_TOOL_RESULT);\n205:       if (seenResults.has(result.toolCallId)) return fail(PROJECTION_ERRORS.DUPLICATE_TOOL_RESULT);\n206:       seenResults.add(result.toolCallId);\n207: \n208:       lastTimestamp = isoOr(result.timestamp, lastTimestamp);\n209:       const item = {\n210:         id: result.id,\n211:         role: 'toolResult',\n212:         sequence: items.length,\n213:         timestamp: lastTimestamp,\n214:         content: result.content,\n215:         toolCallId: result.toolCallId,\n216:       };\n217:       if (result.isError === true) item.isError = true;\n218:       items.push(item);\n219:       cursor += 1;\n220:     }\n221: \n222:     if (seenResults.size !== expected.size && cursor < records.length) {\n223:       return fail(PROJECTION_ERRORS.INCOMPLETE_TOOL_RESULTS);\n224:     }\n225:     index = cursor - 1;\n226:   }\n227: \n228:   return { ok: true, items };\n229: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/hooks/shared/session-readers/project.mjs, lines 1-229\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Projection\n3: // ───────────────────────────────────────────────────────────────────\n4: // Readers hand over neutral entries in the store's own order. This module\n5: // owns the one entry-list contract those entries become: stable ids, a\n6: // zero-based sequence, an ISO timestamp, role-discriminated content blocks,\n7: // and the tool-call/result pairing rule. A pairing defect fails the whole\n8: // read so a caller never receives a partial conversation.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. CONSTANTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: export const PROJECTION_ERRORS = Object.freeze({\n15:   DUPLICATE_ENTRY_ID: 'DUPLICATE_ENTRY_ID',\n16:   INVALID_ENTRY: 'INVALID_ENTRY',\n17:   DUPLICATE_TOOL_CALL: 'DUPLICATE_TOOL_CALL',\n18:   ORPHAN_TOOL_RESULT: 'ORPHAN_TOOL_RESULT',\n19:   DUPLICATE_TOOL_RESULT: 'DUPLICATE_TOOL_RESULT',\n20:   MISMATCHED_TOOL_RESULT: 'MISMATCHED_TOOL_RESULT',\n21:   INCOMPLETE_TOOL_RESULTS: 'INCOMPLETE_TOOL_RESULTS',\n22: });\n23: \n24: const ROLES = new Set(['user', 'assistant', 'toolResult']);\n25: const MAX_ID_LENGTH = 128;\n26: const EPOCH = new Date(0).toISOString();\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 2. BLOCK HELPERS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: export function textBlock(text) {\n33:   return { type: 'text', text: String(text) };\n34: }\n35: \n36: export function thinkingBlock(thinking) {\n37:   return { type: 'thinking', thinking: String(thinking) };\n38: }\