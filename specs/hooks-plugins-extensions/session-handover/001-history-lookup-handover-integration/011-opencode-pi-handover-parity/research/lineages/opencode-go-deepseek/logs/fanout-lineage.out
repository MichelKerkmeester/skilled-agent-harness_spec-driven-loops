he\n227:   // name nor the header can choose between them, so a recovery read refuses\n228:   // rather than guessing.\n229:   if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n230: \n231:   const filePath = join(directory, candidates[0]);\n232:   let header;\n233:   try {\n234:     header = headerOf(filePath);\n235:   } catch {\n236:     return { ok: false, code: 'store_unreadable' };\n237:   }\n238: \n239:   if (header?.type !== 'session' || header.id !== sessionId) {\n240:     return { ok: false, code: 'session_mismatch' };\n241:   }\n242:   if (!samePath(header.cwd, projectDir)) {\n243:     return { ok: false, code: 'session_mismatch' };\n244:   }\n245: \n246:   const guard = guardSessionPath({\n247:     path: filePath,\n248:     root,\n249:     sessionId,\n250:     recordedId: header.id,\n251:   });\n252:   if (!guard.ok) return guard;\n253: \n254:   let raw;\n255:   try {\n256:     raw = readFileSync(filePath, 'utf8');\n257:   } catch {\n258:     return { ok: false, code: 'store_unreadable' };\n259:   }\n260: \n261:   const lines = [];\n262:   for (const line of raw.split('\\n')) {\n263:     if (!line.trim()) continue;\n264:     const parsed = parseJsonObject(line);\n265:     if (parsed) lines.push(parsed);\n266:   }\n267: \n268:   return {\n269:     ok: true,\n270:     source: {\n271:       runtime: RUNTIME,\n272:       sessionId,\n273:       locatorKind: LOCATOR_KIND,\n274:       mode: 'disk',\n275:       storePath: guard.path,\n276:     },\n277:     records: recordsFromLines(lines),\n278:     injected: injectedFromLines(lines),\n279:   };\n280: }\n281: \n282: export function loadPiSession({ sessionId, projectDir, sessionManager, ...options } = {}) {\n283:   if (!isSafeSessionId(sessionId)) {\n284:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n285:   }\n286: \n287:   if (sessionManager && liveSessionId(sessionManager) === sessionId) {\n288:     return liveResult({ sessionId, sessionManager, options });\n289:   }\n290:   return diskResult({ sessionId, projectDir, options });\n291: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/hooks/shared/session-readers/pi.mjs\"}"},"time":{"start":1794808080938,"end":1794808081113}}}}
