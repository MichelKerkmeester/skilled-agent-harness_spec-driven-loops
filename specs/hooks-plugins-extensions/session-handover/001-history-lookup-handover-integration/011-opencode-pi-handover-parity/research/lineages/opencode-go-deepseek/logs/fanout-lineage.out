   88 Nov 16 06:24 decision-capture.ts\n-rw-r--r--@  1 michelkerkmeester  staff     78 Nov 16 06:24 dispatch-audit.ts\n-rw-r--r--@  1 michelkerkmeester  staff     87 Nov 16 06:24 dispatch-preflight-lint.ts\n-rw-r--r--@  1 michelkerkmeester  staff     88 Nov 16 06:24 env-secret-guard.ts\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/422-opencode-pi-handover-parity && cat .pi/extensions/session-handover.ts; echo \\\"---\\\"; ls -la .pi/extensions/ | head\"}"},"time":{"start":1794808039962,"end":1794808040465}}}}
