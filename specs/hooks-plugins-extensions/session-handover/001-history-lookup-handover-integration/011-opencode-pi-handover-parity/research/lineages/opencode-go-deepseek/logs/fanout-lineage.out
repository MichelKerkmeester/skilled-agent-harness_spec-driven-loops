{"type":"tool_use","timestamp":1794807953578,"sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","part":{"partID":"prt_1e2e3f7be002XFrS2pMmyuUblu","sessionID":"ses_e1d1c612bffenqRaMYnBfMfTGv","messageID":"msg_1e2e3f093001EfEWc6l1nppQHv","type":"tool","id":"call_00_xwepie3p0ht35u5v5abunq8e","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1-820\n1: # ────────\n2: # DEEP RESEARCH: DEEP RESEARCH LOOP (AUTO AND CONFIRM MODES)\n3: # ────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ────────\n32: # OPERATING PRINCIPLES\n33: # ────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ────────\n40: # EXECUTION MODE\n41: # ────────\n42: execution_mode:\n43:   source: \"$ARGUMENTS\"\n44:   values: [auto, confirm]\n45:   default: confirm\n46:   rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n47: mode_overrides:\n48:   confirm:\n49:     purpose: \"Iterative deep research with convergence detection and user approval gates\"\n50:     action: \"Run deep-research loop with user confirmation at each phase transition\"\n51:     workflow_execution: \"interactive\"\n52:     approvals: \"multi_gate\"\n53:     approach: \"Dispatch focused agent, show results, get approval, repeat or stop\"\n54:     mandate: \"Never hold findings in memory; write everything to files. Pause for user at each gate.\"\n55:     phase_loop_purpose: \"Dispatch agent iterations with approval at each step\"\n56:     lock_not_acquired: \"If acquired=false, stop and present recovery choices: another deep-research run already holds this packet.\"\n57:     agent_dispatch_timeout: \"Retry once with reduced scope. If second timeout, mark as 'timeout' and show to user for decision.\"\n58:     continuity_save_failure: \"Preserve the research/ packet as backup. Inform user.\"\n59:     rules_always: [pause_at_approval_gates, present_clear_options_at_each_gate]\n60:     rules_never: [proceed_past_approval_gate_without_user_response, auto_approve_on_behalf_of_user]\n61: \n62: # ────────\n63: # USER INPUTS (from setup phase)\n64: # ────────\n65: user_inputs:\n66:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n67:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n68:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. `resume` keeps the same sessionId and archives nothing. `restart` opens a new sessionId at generation+1 and archives the prior research/ packet.\"\n69:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n70:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n71:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n72:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n73:   dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n74:   lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n75: \n76: # ────────\n77: # DRY-RUN CONTROL\n78: # ────────\n79: dry_run_control:\n80:   enabled_when: \"dry_run == true\"\n81:   default: false\n82:   modes: [auto, confirm]\n83:   purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n84:   safe_operations:\n85:     - \"Resolve setup inputs and artifact roots.\"\n86:     - \"Read current state, strategy, focus, and convergence signals.\"\n87:     - \"Render the next prompt to terminal preview without writing prompt files.\"\n88:   forbidden_operations:\n89:     - \"Executor dispatch.\"\n90:     - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n91:     - \"Reducer refresh or generated artifact writes.\"\n92:     - \"Child-lineage spawn.\"\n93:   event_policy:\n94:     event_name: dry_run_halt\n95:     sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n96:     required_fields: [type, event, mode, boundary, step, timestamp]\n97:     optional_fields: [run, sessionId, generation, detail]\n98:     default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n99:     preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n100:   halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n101:   boundary_labels:\n102:     child_spawn: \"child-spawn\"\n103:     state_mutation: \"state-mutation\"\n104:     dispatch: \"dispatch\"\n105:     reducer_refresh: \"reducer-refresh\"\n106: \n107: # ────────\n108: # CONTEXT LOADING\n109: # ────────\n110: context_loading:\n111:   trigger: \"At workflow START, before phase_init\"\n112:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n113:   retrieval:\n114:     mechanism: \"continuity-ladder-then-ripgrep\"\n115:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n116:     ladder:\n117:       - \"{spec_folder}/handover.md when present\"\n118:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n119:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n120:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n121:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n122:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n123:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n124:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n125:   behavior:\n126:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n127:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n128: \n129: # ────────\n130: # SKILL REFERENCE\n131: # ────────\n132: skill_reference:\n133:   skill: system-deep-loop\n134:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n135:   references:\n136:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n137:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n138:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n139:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n140:   templates:\n141:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n142:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n143: \n144: # ────────\n145: # AGENT CONFIGURATION\n146: # ────────\n147: agent_config:\n148:   agent: deep-research\n149:   agent_file: \".skilled/agents/deep-research.md\"\n150:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n151:   model: opus\n152:   leaf_only: true\n153:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n154:   mcp_servers: []\n155: \n156: # ────────\n157: # STATE FILE PATHS\n158: # ────────\n159: # ────────\n160: # CANONICAL STATE WRITE MECHANISM\n161: # ────────\n162: state_write_protocol:\n163:   mechanism: \"append-gateway\"\n164:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n165:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n166:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n167:   pinned_bookkeeping:\n168:     events: [config_warning, graph_convergence, lock_released, manualStop, pivot_confirm_accepted, schema_mismatch, maxDurationReached]\n169:     directive: \"bookkeeping_log\"\n170:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n171:   contract: |\n172:     The directives below specify WHAT to record; this block specifies the mechanism. The\n173:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n174:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n175:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n176:     the warning is surfaced rather than swallowed. Some directives below record workflow\n177:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n178:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n179:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n180:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n181:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n182:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n183:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n184:     it.\n185: \n186:     The gateway authorizes the write against the mode's durable authority record, serialises it\n187:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n188:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n189:     that failed.\n190: \n191:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n192:     can then interleave with no shared ordering, and a record nobody authorized carries no\n193:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n194:     is a halt, never a reason to write the file directly.\n195: \n196:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n197:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n198:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n199:     the next refresh.\n200: \n201: state_paths:\n202:   # Template paths document the canonical packet layout. Runtime resolution happens via\n203:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n204:   # research/ and child phases keep local research/ packet directories.\n205:   packet_dir: \"{artifact_dir}\"\n206:   config: \"{artifact_dir}/deep-research-config.json\"\n207:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n208:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n209:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n210:   registry: \"{artifact_dir}/findings-registry.json\"\n211:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n212:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n213:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n214:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n215:   prompt_dir: \"{artifact_dir}/prompts\"\n216:   iteration_dir: \"{artifact_dir}/iterations\"\n217:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n218:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n219:   # canonical state_log append. The delta file MUST contain at least one record whose\n220:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n221:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n222:   # post_dispatch_validate step enforces the canonical type below.\n223:   delta_dir: \"{artifact_dir}/deltas\"\n224:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n225:   research_output: \"{artifact_dir}/research.md\"\n226:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n227:   archive_root: \"{artifact_archive_root}\"\n228:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n229: \n230: # ────────\n231: # WORKFLOW\n232: # ────────\n233: \n234: gate_defaults:\n235:   after_gate_refresh_lock:\n236:     action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n237:     command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n238:     on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n239: \n240: workflow:\n241: \n242:   step_resolve_artifact_root:\n243:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n244:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n245:     branch_on: \"config.fanout_lineage_artifact_dir\"\n246:     if_present:\n247:       bind:\n248:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n249:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n250:         artifact_subfolder: null\n251:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n252:     if_absent:\n253:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n254:       outputs:\n255:         - artifact_root_dir: \"Resolved local research owner directory\"\n256:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n257:         - artifact_dir: \"Resolved research packet directory for this target\"\n258:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n259: \n260:   step_bind_reducer_artifact_arg:\n261:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n262:     branch_on: \"config.fanout_lineage_artifact_dir\"\n263:     if_present:\n264:       bind:\n265:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n266:     if_absent:\n267:       bind:\n268:         reducer_artifact_arg: \"\"\n269: \n270:   step_apply_lifecycle_request:\n271:     description: \"Honor an explicit restart request before fan-out or normal initialization\"\n272:     dry_run_boundary: \"state-mutation\"\n273:     skip_when: \"lineage_mode != 'restart'\"\n274:     instructions: |\n275:       Run this step in both execution modes, immediately after artifact resolution\n276:       and before fan-out, so old packet files cannot be merged with fresh lineage\n277:       outputs. A restart request must never fall back to resume. The explicit\n278:       restart flag is operator authorization to archive the resolved research packet,\n279:       so do not ask for a second confirmation. Rollback is to move the timestamped\n280:       archive back to the packet directory.\n281:     bind_prior_lineage:\n282:       action: \"Read the session id and generation of the packet that is about to be archived\"\n283:       command: |\n284:         node -e '\n285:           const fs = require(\"fs\");\n286:           const crypto = require(\"crypto\");\n287:           let priorSessionId = null;\n288:           let priorGeneration = 0;\n289:           try {\n290:             const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n291:             const lineage = config.lineage || config;\n292:             priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n293:             priorGeneration = Number(lineage.generation) || 0;\n294:           } catch (error) {\n295:             if (error.code !== \"ENOENT\") {\n296:               console.error(\"The old config cannot be read: \" + error.message);\n297:               process.exit(1);\n298:             }\n299:           }\n300:           let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n301:           try {\n302:             priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n303:           } catch (error) {\n304:             if (error.code !== \"ENOENT\") throw error;\n305:           }\n306:           console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n307:         ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n308:       outputs:\n309:         - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n310:         - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n311:         - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n312:       on_fail: \"Halt with STATUS=FAIL. The old config is unreadable, so repair or archive the packet by hand.\"\n313:     command: |\n314:       if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n315:         echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n316:         exit 1\n317:       fi\n318:       if [ -d \"{state_paths.packet_dir}\" ]; then\n319:         mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n320:       fi\n321:       mkdir -p \"{state_paths.packet_dir}\"\n322:     outputs:\n323:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n324:       - lineage_mode: \"restart\"\n325:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n326: \n327:   step_fanout_spawn:\n328:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n329:     skip_when: \"config.fanout is absent\"\n330:     dry_run_boundary: \"child-spawn\"\n331:     instructions: |\n332:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n333:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n334:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n335:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n336:       deep-research agent is used only for individual iterations, never as a full-loop\n337:       sub-agent or pasted phase-running prompt.\n338:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n339:       phase_main_loop entirely (those are the single-executor path). The merge step in\n340:       phase_synthesis will consolidate results across all lineages.\n341:     sub_steps:\n342:       step_fanout_spawn_cli:\n343:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n344:         skip_when: \"no entries in config.fanout.executors\"\n345:         command: |\n346:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n347:             --spec-folder {spec_folder} \\\n348:             --loop-type research \\\n349:             --research-topic \"{research_topic}\" \\\n350:             --fanout-config-json '{config.fanout_json}' \\\n351:             --base-artifact-dir {artifact_dir} \\\n352:             --convergence-threshold {convergence_threshold} \\\n353:             --stop-policy {stop_policy} \\\n354:             --convergence-mode {convergence_mode}\n355:         working_directory: \"{repo_root}\"\n356:         wait_for_completion: true\n357:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n358: \n359:   # ════════\n360:   # PHASE 1: INITIALIZATION\n361:   # ════════\n362:   phase_init:\n363:     purpose: Create all state files for the research session\n364:     steps:\n365: \n366:       step_preflight_contract:\n367:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n368:         verify:\n369:           - required_values_present: [research_topic, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n370:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n371:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n372:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n373:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n374:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n375: \n376:       step_create_directories:\n377:         action: \"Create spec folder and research packet directories if they don't exist\"\n378:         dry_run_boundary: \"state-mutation\"\n379:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n380: \n381:       step_detect_resource_map:\n382:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n383:         inspect:\n384:           - \"{spec_folder}/resource-map.md\"\n385:         classify:\n386:           present: \"resource-map.md exists at init\"\n387:           absent: \"resource-map.md does not exist at init\"\n388:         outputs:\n389:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n390:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n391: \n392:       step_resolve_canonical_names:\n393:         action: \"Resolve canonical research packet artifact names before classification\"\n394:         inspect_legacy:\n395:           - \"{state_paths.packet_dir}/config.json\"\n396:           - \"{state_paths.packet_dir}/state.jsonl\"\n397:           - \"{state_paths.packet_dir}/strategy.md\"\n398:           - \"{state_paths.packet_dir}/dashboard.md\"\n399:           - \"{state_paths.packet_dir}/.pause\"\n400:         migration_policy: \"dual-read / single-write for 4 weeks\"\n401:         on_legacy_read:\n402:           set: { legacy_migration_detected: true, migration_recorded: false }\n403:           outputs:\n404:             - legacy_path: \"The legacy artifact path that was read\"\n405:             - canonical_path: \"The canonical artifact path it maps to\"\n406:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n407: \n408:       step_acquire_lock:\n409:         action: \"Acquire the single-writer advisory lock before session classification\"\n410:         dry_run_boundary: \"state-mutation\"\n411:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n412:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n413:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n414:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n415:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n416:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n417:         on_halt:\n418:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n419:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n420:         on_cancel:\n421:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n422:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n423:         on_workflow_exit:\n424:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n425:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n426: \n427:       step_classify_session:\n428:         action: \"Classify the session before writing files\"\n429:         inspect:\n430:           - \"{state_paths.config}\"\n431:           - \"{state_paths.state_log}\"\n432:           - \"{state_paths.strategy}\"\n433:         classify:\n434:           fresh: \"None of the three state artifacts exist\"\n435:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n436:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n437:           invalid-state: \"Any partial, missing, or contradictory combination\"\n438:         outputs:\n439:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n440:         on_resume:\n441:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n442:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n443:           gate3_classification: write-path\n444:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n445:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n446:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n447:           skip_to: phase_loop\n448:           confirm_choice:\n449:             applies_to: confirm\n450:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n451:             show_dashboard: \"{state_paths.dashboard}\"\n452:             ask: \"Existing research session is consistent. Resume where it left off, or restart (archive the current research packet under the root-level research_archive/ tree and start a fresh session)?\"\n453:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n454:             options: [resume, restart, cancel]\n455:             on_resume_choice:\n456:               dry_run_boundary: \"state-mutation\"\n457:               set:\n458:                 lineage_mode: \"resume\"\n459:                 parent_session_id: \"{session_id}\"\n460:               append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\",\"generation\":{generation}}'\n461:               skip_to: gate_init_approval\n462:             on_restart_choice:\n463:               dry_run_boundary: \"state-mutation\"\n464:               bind_prior_lineage:\n465:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n466:                 command: |\n467:                   node -e '\n468:                     const fs = require(\"fs\");\n469:                     const crypto = require(\"crypto\");\n470:                     let priorSessionId = null;\n471:                     let priorGeneration = 0;\n472:                     try {\n473:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n474:                       const lineage = config.lineage || config;\n475:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n476:                       priorGeneration = Number(lineage.generation) || 0;\n477:                     } catch (error) {\n478:                       if (error.code !== \"ENOENT\") {\n479:                         console.error(\"The old config cannot be read: \" + error.message);\n480:                         process.exit(1);\n481:                       }\n482:                     }\n483:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n484:                     try {\n485:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n486:                     } catch (error) {\n487:                       if (error.code !== \"ENOENT\") throw error;\n488:                     }\n489:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n490:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n491:                 outputs:\n492:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n493:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n494:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n495:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n496:               command: |\n497:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n498:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n499:                   exit 1\n500:                 fi\n501:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n502:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n503:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n504:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n505:               set:\n506:                 lineage_mode: \"restart\"\n507:               skip_to: step_create_config\n508:             on_cancel_choice:\n509:               halt: true\n510:               release_lock: step_release_lock\n511:               message: \"Research session preserved. Manually archive or edit research/ before re-running.\"\n512:         on_restart:\n513:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n514:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n515:         on_completed_session:\n516:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n517:           halt: true\n518:           release_lock: step_release_lock\n519:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n520:         on_invalid_state:\n521:           halt: true\n522:           release_lock: step_release_lock\n523:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n524:         on_fresh:\n525:           action: \"Proceed with a new session\"\n526: \n527:       step_resolve_session_id:\n528:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n529:         branch_on: \"session_id\"\n530:         if_present:\n531:           bind:\n532:             session_id_init: \"{session_id}\"\n533:         if_absent:\n534:           bind:\n535:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n536:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n537:             session_id_init: \"{AUTO_SESSION_ID}\"\n538: \n539:       step_create_config:\n540:         action: \"Create deep-research-config.json from template\"\n541:         dry_run_boundary: \"state-mutation\"\n542:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n543:         lineage_values:\n544:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n545:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n546:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n547:         populate:\n548:           topic: \"{research_topic}\"\n549:           maxIterations: \"{max_iterations}\"\n550:           minIterations: 3\n551:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n552:           convergenceThreshold: \"{convergence_threshold}\"\n553:           stopPolicy: \"{stop_policy}\"\n554:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n555:           antiConvergence.divergent: {}\n556:           stuckThreshold: 3\n557:           minIdeaObservations: 2\n558:           maxDurationMinutes: 120\n559:           specFolder: \"{spec_folder}\"\n560:           resource_map_present: \"{resource_map_present}\"\n561:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n562:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n563:           resource_map.emit: \"{resource_map_emit}\"\n564:           createdAt: \"{ISO_8601_NOW}\"\n565:           status: \"initialized\"\n566:           executionMode: \"{execution_mode}\"\n567:           lineage.sessionId: \"{session_id_init}\"\n568:           lineage.parentSessionId: \"{parent_session_id_init}\"\n569:           lineage.lineageMode: \"{lineage_mode_init}\"\n570:           lineage.generation: \"{generation_init}\"\n571:           lineage.continuedFromRun: null\n572:           nextRunAt: null\n573:           remainingDelayMs: null\n574:         output: \"{state_paths.config}\"\n575: \n576:       step_create_state_log:\n577:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n578:         dry_run_boundary: \"state-mutation\"\n579:         note: |\n580:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n581:           the ledger gives every later state append the same authorized, ordered source.\n582:         command: |\n583:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n584:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n585:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n586:           node -e '\n587:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n588:             const [configPath] = process.argv.slice(1);\n589:             const raw = fs.readFileSync(configPath);\n590:             const config = JSON.parse(raw);\n591:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n592:             const lineage = config.lineage || {};\n593:             const sessionId = lineage.sessionId;\n594:             const lineageId = lineage.parentSessionId || sessionId;\n595:             const generation = Number(lineage.generation) || 1;\n596:             const configDigest = sha(raw);\n597:             // The projected config row shows this topic; one the schema cannot hold is left out,\n598:             // and the row falls back to the run id rather than the run failing to open.\n599:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n600:               ? config.topic\n601:               : null;\n602:             const event = {\n603:               stem: \"deep_research.run_initialized\",\n604:               scope: { runId: sessionId, lineageId },\n605:               data: {\n606:                 generation,\n607:                 ...(topic === null ? {} : { topic }),\n608:                 charterDigest: sha(Buffer.from(JSON.stringify({\n609:                   topic: config.topic,\n610:                   specFolder: config.specFolder || \"\",\n611:                 }))),\n612:                 configDigest,\n613:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n614:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n615:                   runId: sessionId,\n616:                   lineageId,\n617:                   generation,\n618:                   configDigest,\n619:                 }))),\n620:                 maxIterations: Number(config.maxIterations),\n621:                 convergencePolicyVersion: \"convergence-policy@\" + (\n622:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n623:                 ),\n624:               },\n625:             };\n626:             process.stdout.write(JSON.stringify(event));\n627:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n628:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n629:           STATUS=$?\n630:           rm -f \"$EVENT_FILE\"\n631:           exit \"$STATUS\"\n632:         output: \"{state_paths.state_log}\"\n633: \n634:       step_record_restarted_run:\n635:         skip_when: \"lineage_mode != 'restart'\"\n636:         action: \"Record deep_research.run_restarted after the run-open row, so the restart marker never precedes deep_research.run_initialized\"\n637:         bind:\n638:           restart_lineage_id: \"{prior_session_id} when it is not null, else {session_id_init}\"\n639:         dry_run_boundary: \"state-mutation\"\n640:         append_jsonl: '{\"stem\":\"deep_research.run_restarted\",\"scope\":{\"runId\":\"{session_id_init}\",\"lineageId\":\"{restart_lineage_id}\"},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{restart_lineage_id}\",\"restartReason\":\"Restart requested: the prior research packet was archived and a new lineage segment opened.\",\"generation\":{generation_init},\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n641: \n642:       step_create_strategy:\n643:         action: \"Create strategy file from template with initial questions\"\n644:         dry_run_boundary: \"state-mutation\"\n645:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n646:         populate:\n647:           topic: \"{research_topic}\"\n648:           key_questions: \"Derive 3-5 key questions from the research topic\"\n649:           known_context: \"None\"\n650:           known_context_summary: \"None\"\n651:           max_iterations: \"{max_iterations}\"\n652:           convergence_threshold: \"{convergence_threshold}\"\n653:         output: \"{state_paths.strategy}\"\n654: \n655:       step_create_registry:\n656:         action: \"Initialize reducer-owned findings registry\"\n657:         dry_run_boundary: \"state-mutation\"\n658:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n659:         output: \"{state_paths.registry}\"\n660: \n661:       step_enrich_strategy_context:\n662:         action: \"Ensure Known Context is written only after strategy.md exists\"\n663:         condition: \"prior_context_found\"\n664:         dry_run_boundary: \"state-mutation\"\n665:         edit: \"{state_paths.strategy}\"\n666:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n667: \n668:       step_enrich_strategy_resource_map:\n669:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n670:         dry_run_boundary: \"state-mutation\"\n671:         edit: \"{state_paths.strategy}\"\n672:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n673: \n674:       step_detect_spec_present:\n675:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n676:         dry_run_event_policy: preview-only\n677:         inspect:\n678:           - \"{spec_folder}/spec.md\"\n679:           - \"{state_paths.lock_file}\"\n680:         classify:\n681:           no-spec: \"spec.md is absent before any pre-init mutation\"\n682:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n683:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n684:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n685:         outputs:\n686:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n687:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n688:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n689: \n690:       gate_preinit_spec_mutation_approval:\n691:         applies_to: confirm\n692:         type: approval_gate\n693:         purpose: \"Approve the planned pre-init spec.md mutation before LOOP starts\"\n694:         present: |\n695:           ## Pre-Init Spec Check\n696: \n697:           **Folder State**: {folder_state}\n698:           **Spec Path**: {spec_folder}/spec.md\n699:           **Normalized Topic**: {normalized_topic}\n700:           **Lock File**: {state_paths.lock_file}\n701: \n702:           Planned branch:\n703:           - `no-spec` -> seed Level 1 `spec.md` with `<!-- DR-SEED:REQUIREMENTS -->` and `<!-- DR-SEED:SCOPE -->`\n704:           - `spec-present` -> append bounded context in `Open Questions` and `Research Context`\n705:           - `spec-just-created-by-this-run` -> verify markers and continue without duplicate mutation\n706:           - `conflict-detected` -> halt fail-closed\n707: \n708:           Options:\n709:           A) Approve pre-init branch\n710:           B) Revise the planned branch\n711:           C) Cancel\n712:         wait_for: \"User response\"\n713:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n714:         on_A: { proceed_to: step_preinit_spec_branch }\n715:         on_B: { action: \"Adjust the planned pre-init mutation inputs\", return_to: gate_preinit_spec_mutation_approval }\n716:         on_C: { action: \"Cancel workflow after releasing the advisory lock during cleanup\", status: \"CANCELLED\", release_lock: step_release_lock }\n717: \n718:       step_preinit_spec_branch:\n719:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n720:         dry_run_boundary: \"state-mutation\"\n721:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n722:         branches:\n723:           no-spec:\n724:             create: \"{spec_folder}/spec.md\"\n725:             seed_markers:\n726:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n727:               - \"<!-- DR-SEED:SCOPE -->\"\n728:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n729:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n730:             set:\n731:               folder_state: \"spec-just-created-by-this-run\"\n732:               validate_spec_doc: true\n733:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n734:           spec-present:\n735:             edit: \"{spec_folder}/spec.md\"\n736:             set:\n737:               validate_spec_doc: true\n738:             idempotency_check:\n739:               host_anchor: \"Open Questions\"\n740:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n741:               if_match:\n742:                 skip_append: true\n743:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n744:               if_no_match:\n745:                 append_only:\n746:                   - host_anchor: \"Open Questions\"\n747:                     content: \"Add the normalized research topic only if it is not already present.\"\n748:                   - host_anchor: \"Research Context\"\n749:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n750:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n751:           spec-just-created-by-this-run:\n752:             verify_markers:\n753:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n754:               - \"<!-- DR-SEED:SCOPE -->\"\n755:             set:\n756:               validate_spec_doc: false\n757:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n758:           conflict-detected:\n759:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n760:             halt: true\n761:             release_lock: step_release_lock\n762: \n763:       step_validate_preinit_spec_doc:\n764:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n765:         condition: \"validate_spec_doc\"\n766:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n767:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n768: \n769:       step_telemetry_heartbeat_started:\n770:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n771:         skip_when: \"config.fanout is present\"\n772:         canonical_lifecycle_event: \"iteration_start\"\n773:         command: |\n774:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase started --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{AUTO_SESSION_ID}\"\n775:         working_directory: \"{repo_root}\"\n776:         outputs:\n777:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n778: \n779:       step_init_complete:\n780:         log: \"Initialization complete. Config, state, and strategy files created.\"\n781:         set: { current_iteration: 1, current_segment: 1 }\n782: \n783:       # ─── APPROVAL GATE: Post-Init ───\n784:       gate_init_approval:\n785:         applies_to: confirm\n786:         type: approval_gate\n787:         purpose: \"Show initialization results and get approval to start loop\"\n788:         present: |\n789:           ## Initialization Complete\n790: \n791:           **Topic**: {research_topic}\n792:           **Max Iterations**: {max_iterations}\n793:           **Convergence Threshold**: {convergence_threshold}\n794:           **Known Context Summary**: {prior_context_summary}\n795:           **Folder State**: {folder_state}\n796: \n797:           Review `{state_paths.strategy}` for the initial key questions and next focus.\n798:           Review `{spec_folder}/spec.md` for the approved pre-init branch and any DR seed markers or context notes.\n799:           Reducer-owned state will live in `{state_paths.registry}` and `{state_paths.dashboard}`.\n800:           **State files located in**: {state_paths.packet_dir}/\n801: \n802:           Options:\n803:           A) Start research loop\n804:           B) Adjust questions or parameters\n805:           C) Cancel\n806:         wait_for: \"User response\"\n807:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n808:         on_A: { set: { current_iteration: 1, current_segment: 1 }, proceed_to: phase_loop }\n809:         on_B: { action: \"Apply user adjustments to strategy.md and/or config\", return_to: gate_init_approval }\n810:         on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n811: \n812:   # ════════\n813:   # PHASE 2: ITERATION LOOP\n814:   # ════════\n815:   phase_loop:\n816:     purpose: Dispatch agent iterations until convergence\n817:     repeat: true\n818:     max_repeats: \"{max_iterations}\"\n819:     steps:\n820: \n[Output truncated. Continue reading with offset: 821]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1-820\n1: # ────────\n2: # DEEP RESEARCH: DEEP RESEARCH LOOP (AUTO AND CONFIRM MODES)\n3: # ────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ────────\n32: # OPERATING PRINCIPLES\n33: # ────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ────────\n40: # EXECUTION MODE\n41: # ────────\n42: execution_mode:\n43:   source: \"$ARGUMENTS\"\n44:   values: [auto, confirm]\n45:   default: confirm\n46:   rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n47: mode_overrides:\n48:   confirm:\n49:     purpose: \"Iterative deep research with convergence detection and user approval gates\"\n50:     action: \"Run deep-research loop with user confirmation at each phase transition\"\n51:     workflow_execution: \"interactive\"\n52:     approvals: \"multi_gate\"\n53:     approach: \"Dispatch focused agent, show results, get approval, repeat or stop\"\n54:     mandate: \"Never hold findings in memory; write everything to files. Pause for user at each gate.\"\n55:     phase_loop_purpose: \"Dispatch agent iterations with approval at each step\"\n56:     lock_not_acquired: \"If acquired=false, stop and present recovery choices: another deep-research run already holds this packet.\"\n57:     agent_dispatch_timeout: \"Retry once with reduced scope. If second timeout, mark as 'timeout' and show to user for decision.\"\n58:     continuity_save_failure: \"Preserve the research/ packet as backup. Inform user.\"\n59:     rules_always: [pause_at_approval_gates, present_clear_options_at_each_gate]\n60:     rules_never: [proceed_past_approval_gate_without_user_response, auto_approve_on_behalf_of_user]\n61: \n62: # ────────\n63: # USER INPUTS (from setup phase)\n64: # ────────\n65: user_inputs:\n66:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n67:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n68:   lineage_mode: \"[auto|resume|restart] - Session lifecycle intent. Default: auto. `resume` keeps the same sessionId and archives nothing. `restart` opens a new sessionId at generation+1 and archives the prior research/ packet.\"\n69:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n70:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n71:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n72:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n73:   dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n74:   lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n75: \n76: # ────────\n77: # DRY-RUN CONTROL\n78: # ────────\n79: dry_run_control:\n80:   enabled_when: \"dry_run == true\"\n81:   default: false\n82:   modes: [auto, confirm]\n83:   purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n84:   safe_operations:\n85:     - \"Resolve setup inputs and artifact roots.\"\n86:     - \"Read current state, strategy, focus, and convergence signals.\"\n87:     - \"Render the next prompt to terminal preview without writing prompt files.\"\n88:   forbidden_operations:\n89:     - \"Executor dispatch.\"\n90:     - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n91:     - \"Reducer refresh or generated artifact writes.\"\n92:     - \"Child-lineage spawn.\"\n93:   event_policy:\n94:     event_name: dry_run_halt\n95:     sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n96:     required_fields: [type, event, mode, boundary, step, timestamp]\n97:     optional_fields: [run, sessionId, generation, detail]\n98:     default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n99:     preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n100:   halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n101:   boundary_labels:\n102:     child_spawn: \"child-spawn\"\n103:     state_mutation: \"state-mutation\"\n104:     dispatch: \"dispatch\"\n105:     reducer_refresh: \"reducer-refresh\"\n106: \n107: # ────────\n108: # CONTEXT LOADING\n109: # ────────\n110: context_loading:\n111:   trigger: \"At workflow START, before phase_init\"\n112:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n113:   retrieval:\n114:     mechanism: \"continuity-ladder-then-ripgrep\"\n115:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n116:     ladder:\n117:       - \"{spec_folder}/handover.md when present\"\n118:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n119:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n120:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n121:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n122:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n123:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n124:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n125:   behavior:\n126:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n127:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n128: \n129: # ────────\n130: # SKILL REFERENCE\n131: # ────────\n132: skill_reference:\n133:   skill: system-deep-loop\n134:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n135:   references:\n136:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n137:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n138:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n139:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n140:   templates:\n141:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n142:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n143: \n144: # ────────\n145: # AGENT CONFIGURATION\n146: # ────────\n147: agent_config:\n148:   agent: deep-research\n149:   agent_file: \".skilled/agents/deep-research.md\"\n150:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n151:   model: opus\n152:   leaf_only: true\n153:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n154:   mcp_servers: []\n155: \n156: # ────────\n157: # STATE FILE PATHS\n158: # ────────\n159: # ────────\n160: # CANONICAL STATE WRITE MECHANISM\n161: # ────────\n162: state_write_protocol:\n163:   mechanism: \"append-gateway\"\n164:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n165:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n166:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n167:   pinned_bookkeeping:\n168:     events: [config_warning, graph_convergence, lock_released, manualStop, pivot_confirm_accepted, schema_mismatch, maxDurationReached]\n169:     directive: \"bookkeeping_log\"\n170:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n171:   contract: |\n172:     The directives below specify WHAT to record; this block specifies the mechanism. The\n173:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n174:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n175:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n176:     the warning is surfaced rather than swallowed. Some directives below record workflow\n177:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n178:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n179:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n180:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n181:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n182:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n183:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n184:     it.\n185: \n186:     The gateway authorizes the write against the mode's durable authority record, serialises it\n187:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n188:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n189:     that failed.\n190: \n191:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n192:     can then interleave with no shared ordering, and a record nobody authorized carries no\n193:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n194:     is a halt, never a reason to write the file directly.\n195: \n196:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n197:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n198:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n199:     the next refresh.\n200: \n201: state_paths:\n202:   # Template paths document the canonical packet layout. Runtime resolution happens via\n203:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n204:   # research/ and child phases keep local research/ packet directories.\n205:   packet_dir: \"{artifact_dir}\"\n206:   config: \"{artifact_dir}/deep-research-config.json\"\n207:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n208:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n209:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n210:   registry: \"{artifact_dir}/findings-registry.json\"\n211:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n212:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n213:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n214:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n215:   prompt_dir: \"{artifact_dir}/prompts\"\n216:   iteration_dir: \"{artifact_dir}/iterations\"\n217:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n218:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n219:   # canonical state_log append. The delta file MUST contain at least one record whose\n220:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n221:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n222:   # post_dispatch_validate step enforces the canonical type below.\n223:   delta_dir: \"{artifact_dir}/deltas\"\n224:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n225:   research_output: \"{artifact_dir}/research.md\"\n226:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n227:   archive_root: \"{artifact_archive_root}\"\n228:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n229: \n230: # ────────\n231: # WORKFLOW\n232: # ────────\n233: \n234: gate_defaults:\n235:   after_gate_refresh_lock:\n236:     action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n237:     command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n238:     on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n239: \n240: workflow:\n241: \n242:   step_resolve_artifact_root:\n243:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n244:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n245:     branch_on: \"config.fanout_lineage_artifact_dir\"\n246:     if_present:\n247:       bind:\n248:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n249:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n250:         artifact_subfolder: null\n251:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n252:     if_absent:\n253:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n254:       outputs:\n255:         - artifact_root_dir: \"Resolved local research owner directory\"\n256:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n257:         - artifact_dir: \"Resolved research packet directory for this target\"\n258:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n259: \n260:   step_bind_reducer_artifact_arg:\n261:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n262:     branch_on: \"config.fanout_lineage_artifact_dir\"\n263:     if_present:\n264:       bind:\n265:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n266:     if_absent:\n267:       bind:\n268:         reducer_artifact_arg: \"\"\n269: \n270:   step_apply_lifecycle_request:\n271:     description: \"Honor an explicit restart request before fan-out or normal initialization\"\n272:     dry_run_boundary: \"state-mutation\"\n273:     skip_when: \"lineage_mode != 'restart'\"\n274:     instructions: |\n275:       Run this step in both execution modes, immediately after artifact resolution\n276:       and before fan-out, so old packet files cannot be merged with fresh lineage\n277:       outputs. A restart request must never fall back to resume. The explicit\n278:       restart flag is operator authorization to archive the resolved research packet,\n279:       so do not ask for a second confirmation. Rollback is to move the timestamped\n280:       archive back to the packet directory.\n281:     bind_prior_lineage:\n282:       action: \"Read the session id and generation of the packet that is about to be archived\"\n283:       command: |\n284:         node -e '\n285:           const fs = require(\"fs\");\n286:           const crypto = require(\"crypto\");\n287:           let priorSessionId = null;\n288:           let priorGeneration = 0;\n289:           try {\n290:             const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n291:             const lineage = config.lineage || config;\n292:             priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n293:             priorGeneration = Number(lineage.generation) || 0;\n294:           } catch (error) {\n295:             if (error.code !== \"ENOENT\") {\n296:               console.error(\"The old config cannot be read: \" + error.message);\n297:               process.exit(1);\n298:             }\n299:           }\n300:           let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n301:           try {\n302:             priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n303:           } catch (error) {\n304:             if (error.code !== \"ENOENT\") throw error;\n305:           }\n306:           console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n307:         ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n308:       outputs:\n309:         - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n310:         - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n311:         - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n312:       on_fail: \"Halt with STATUS=FAIL. The old config is unreadable, so repair or archive the packet by hand.\"\n313:     command: |\n314:       if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n315:         echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n316:         exit 1\n317:       fi\n318:       if [ -d \"{state_paths.packet_dir}\" ]; then\n319:         mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n320:       fi\n321:       mkdir -p \"{state_paths.packet_dir}\"\n322:     outputs:\n323:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n324:       - lineage_mode: \"restart\"\n325:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n326: \n327:   step_fanout_spawn:\n328:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n329:     skip_when: \"config.fanout is absent\"\n330:     dry_run_boundary: \"child-spawn\"\n331:     instructions: |\n332:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n333:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n334:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n335:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n336:       deep-research agent is used only for individual iterations, never as a full-loop\n337:       sub-agent or pasted phase-running prompt.\n338:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n339:       phase_main_loop entirely (those are the single-executor path). The merge step in\n340:       phase_synthesis will consolidate results across all lineages.\n341:     sub_steps:\n342:       step_fanout_spawn_cli:\n343:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n344:         skip_when: \"no entries in config.fanout.executors\"\n345:         command: |\n346:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n347:             --spec-folder {spec_folder} \\\n348:             --loop-type research \\\n349:             --research-topic \"{research_topic}\" \\\n350:             --fanout-config-json '{config.fanout_json}' \\\n351:             --base-artifact-dir {artifact_dir} \\\n352:             --convergence-threshold {convergence_threshold} \\\n353:             --stop-policy {stop_policy} \\\n354:             --convergence-mode {convergence_mode}\n355:         working_directory: \"{repo_root}\"\n356:         wait_for_completion: true\n357:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n358: \n359:   # ════════\n360:   # PHASE 1: INITIALIZATION\n361:   # ════════\n362:   phase_init:\n363:     purpose: Create all state files for the research session\n364:     steps:\n365: \n366:       step_preflight_contract:\n367:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n368:         verify:\n369:           - required_values_present: [research_topic, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n370:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n371:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n372:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n373:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n374:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n375: \n376:       step_create_directories:\n377:         action: \"Create spec folder and research packet directories if they don't exist\"\n378:         dry_run_boundary: \"state-mutation\"\n379:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n380: \n381:       step_detect_resource_map:\n382:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n383:         inspect:\n384:           - \"{spec_folder}/resource-map.md\"\n385:         classify:\n386:           present: \"resource-map.md exists at init\"\n387:           absent: \"resource-map.md does not exist at init\"\n388:         outputs:\n389:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n390:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n391: \n392:       step_resolve_canonical_names:\n393:         action: \"Resolve canonical research packet artifact names before classification\"\n394:         inspect_legacy:\n395:           - \"{state_paths.packet_dir}/config.json\"\n396:           - \"{state_paths.packet_dir}/state.jsonl\"\n397:           - \"{state_paths.packet_dir}/strategy.md\"\n398:           - \"{state_paths.packet_dir}/dashboard.md\"\n399:           - \"{state_paths.packet_dir}/.pause\"\n400:         migration_policy: \"dual-read / single-write for 4 weeks\"\n401:         on_legacy_read:\n402:           set: { legacy_migration_detected: true, migration_recorded: false }\n403:           outputs:\n404:             - legacy_path: \"The legacy artifact path that was read\"\n405:             - canonical_path: \"The canonical artifact path it maps to\"\n406:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n407: \n408:       step_acquire_lock:\n409:         action: \"Acquire the single-writer advisory lock before session classification\"\n410:         dry_run_boundary: \"state-mutation\"\n411:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n412:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n413:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n414:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n415:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n416:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n417:         on_halt:\n418:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n419:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n420:         on_cancel:\n421:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n422:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n423:         on_workflow_exit:\n424:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n425:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n426: \n427:       step_classify_session:\n428:         action: \"Classify the session before writing files\"\n429:         inspect:\n430:           - \"{state_paths.config}\"\n431:           - \"{state_paths.state_log}\"\n432:           - \"{state_paths.strategy}\"\n433:         classify:\n434:           fresh: \"None of the three state artifacts exist\"\n435:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n436:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n437:           invalid-state: \"Any partial, missing, or contradictory combination\"\n438:         outputs:\n439:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n440:         on_resume:\n441:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n442:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n443:           gate3_classification: write-path\n444:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n445:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n446:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n447:           skip_to: phase_loop\n448:           confirm_choice:\n449:             applies_to: confirm\n450:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n451:             show_dashboard: \"{state_paths.dashboard}\"\n452:             ask: \"Existing research session is consistent. Resume where it left off, or restart (archive the current research packet under the root-level research_archive/ tree and start a fresh session)?\"\n453:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n454:             options: [resume, restart, cancel]\n455:             on_resume_choice:\n456:               dry_run_boundary: \"state-mutation\"\n457:               set:\n458:                 lineage_mode: \"resume\"\n459:                 parent_session_id: \"{session_id}\"\n460:               append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\",\"generation\":{generation}}'\n461:               skip_to: gate_init_approval\n462:             on_restart_choice:\n463:               dry_run_boundary: \"state-mutation\"\n464:               bind_prior_lineage:\n465:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n466:                 command: |\n467:                   node -e '\n468:                     const fs = require(\"fs\");\n469:                     const crypto = require(\"crypto\");\n470:                     let priorSessionId = null;\n471:                     let priorGeneration = 0;\n472:                     try {\n473:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n474:                       const lineage = config.lineage || config;\n475:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n476:                       priorGeneration = Number(lineage.generation) || 0;\n477:                     } catch (error) {\n478:                       if (error.code !== \"ENOENT\") {\n479:                         console.error(\"The old config cannot be read: \" + error.message);\n480:                         process.exit(1);\n481:                       }\n482:                     }\n483:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n484:                     try {\n485:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n486:                     } catch (error) {\n487:                       if (error.code !== \"ENOENT\") throw error;\n488:                     }\n489:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n490:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n491:                 outputs:\n492:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n493:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n494:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n495:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n496:               command: |\n497:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n498:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n499:                   exit 1\n500:                 fi\n501:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n502:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n503:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n504:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n505:               set:\n506:                 lineage_mode: \"restart\"\n507:               skip_to: step_create_config\n508:             on_cancel_choice:\n509:               halt: true\n510:               release_lock: step_release_lock\n511:               message: \"Research session preserved. Manually archive or edit research/ before re-running.\"\n512:         on_restart:\n513:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n514:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n515:         on_completed_session:\n516:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n517:           halt: true\n518:           release_lock: step_release_lock\n519:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n520:         on_invalid_state:\n521:           halt: true\n522:           release_lock: step_release_lock\n523:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n524:         on_fresh:\n525:           action: \"Proceed with a new session\"\n526: \n527:       step_resolve_session_id:\n528:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n529:         branch_on: \"session_id\"\n530:         if_present:\n531:           bind:\n532:             session_id_init: \"{session_id}\"\n533:         if_absent:\n534:           bind:\n535:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n536:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n537:             session_id_init: \"{AUTO_SESSION_ID}\"\n538: \n539:       step_create_config:\n540:         action: \"Create deep-research-config.json from template\"\n541:         dry_run_boundary: \"state-mutation\"\n542:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n543:         lineage_values:\n544:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n545:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n546:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n547:         populate:\n548:           topic: \"{research_topic}\"\n549:           maxIterations: \"{max_iterations}\"\n550:           minIterations: 3\n551:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n552:           convergenceThreshold: \"{convergence_threshold}\"\n553:           stopPolicy: \"{stop_policy}\"\n554:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n555:           antiConvergence.divergent: {}\n556:           stuckThreshold: 3\n557:           minIdeaObservations: 2\n558:           maxDurationMinutes: 120\n559:           specFolder: \"{spec_folder}\"\n560:           resource_map_present: \"{resource_map_present}\"\n561:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n562:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n563:           resource_map.emit: \"{resource_map_emit}\"\n564:           createdAt: \"{ISO_8601_NOW}\"\n565:           status: \"initialized\"\n566:           executionMode: \"{execution_mode}\"\n567:           lineage.sessionId: \"{session_id_init}\"\n568:           lineage.parentSessionId: \"{parent_session_id_init}\"\n569:           lineage.lineageMode: \"{lineage_mode_init}\"\n570:           lineage.generation: \"{generation_init}\"\n571:           lineage.continuedFromRun: null\n572:           nextRunAt: null\n573:           remainingDelayMs: null\n574:         output: \"{state_paths.config}\"\n575: \n576:       step_create_state_log:\n577:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n578:         dry_run_boundary: \"state-mutation\"\n579:         note: |\n580:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n581:           the ledger gives every later state append the same authorized, ordered source.\n582:         command: |\n583:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n584:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n585:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n586:           node -e '\n587:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n588:             const [configPath] = process.argv.slice(1);\n589:             const raw = fs.readFileSync(configPath);\n590:             const config = JSON.parse(raw);\n591:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n592:             const lineage = config.lineage || {};\n593:             const sessionId = lineage.sessionId;\n594:             const lineageId = lineage.parentSessionId || sessionId;\n595:             const generation = Number(lineage.generation) || 1;\n596:             const configDigest = sha(raw);\n597:             // The projected config row shows this topic; one the schema cannot hold is left out,\n598:             // and the row falls back to the run id rather than the run failing to open.\n599:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n600:               ? config.topic\n601:               : null;\n602:             const event = {\n603:               stem: \"deep_research.run_initialized\",\n604:               scope: { runId: sessionId, lineageId },\n605:               data: {\n606:                 generation,\n607:                 ...(topic === null ? {} : { topic }),\n608:                 charterDigest: sha(Buffer.from(JSON.stringify({\n609:                   topic: config.topic,\n610:                   specFolder: config.specFolder || \"\",\n611:                 }))),\n612:                 configDigest,\n613:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n614:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n615:                   runId: sessionId,\n616:                   lineageId,\n617:                   generation,\n618:                   configDigest,\n619:                 }))),\n620:                 maxIterations: Number(config.maxIterations),\n621:                 convergencePolicyVersion: \"convergence-policy@\" + (\n622:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n623:                 ),\n624:               },\n625:             };\n626:             process.stdout.write(JSON.stringify(event));\n627:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n628:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n629:           STATUS=$?\n630:           rm -f \"$EVENT_FILE\"\n631:           exit \"$STATUS\"\n632:         output: \"{state_paths.state_log}\"\n633: \n634:       step_record_restarted_run:\n635:         skip_when: \"lineage_mode != 'restart'\"\n636:         action: \"Record deep_research.run_restarted after the run-open row, so the restart marker never precedes deep_research.run_initialized\"\n637:         bind:\n638:           restart_lineage_id: \"{prior_session_id} when it is not null, else {session_id_init}\"\n639:         dry_run_boundary: \"state-mutation\"\n640:         append_jsonl: '{\"stem\":\"deep_research.run_restarted\",\"scope\":{\"runId\":\"{session_id_init}\",\"lineageId\":\"{restart_lineage_id}\"},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{restart_lineage_id}\",\"restartReason\":\"Restart requested: the prior research packet was archived and a new lineage segment opened.\",\"generation\":{generation_init},\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n641: \n642:       step_create_strategy:\n643:         action: \"Create strategy file from template with initial questions\"\n644:         dry_run_boundary: \"state-mutation\"\n645:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n646:         populate:\n647:           topic: \"{research_topic}\"\n648:           key_questions: \"Derive 3-5 key questions from the research topic\"\n649:           known_context: \"None\"\n650:           known_context_summary: \"None\"\n651:           max_iterations: \"{max_iterations}\"\n652:           convergence_threshold: \"{convergence_threshold}\"\n653:         output: \"{state_paths.strategy}\"\n654: \n655:       step_create_registry:\n656:         action: \"Initialize reducer-owned findings registry\"\n657:         dry_run_boundary: \"state-mutation\"\n658:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n659:         output: \"{state_paths.registry}\"\n660: \n661:       step_enrich_strategy_context:\n662:         action: \"Ensure Known Context is written only after strategy.md exists\"\n663:         condition: \"prior_context_found\"\n664:         dry_run_boundary: \"state-mutation\"\n665:         edit: \"{state_paths.strategy}\"\n666:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n667: \n668:       step_enrich_strategy_resource_map:\n669:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n670:         dry_run_boundary: \"state-mutation\"\n671:         edit: \"{state_paths.strategy}\"\n672:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n673: \n674:       step_detect_spec_present:\n675:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n676:         dry_run_event_policy: preview-only\n677:         inspect:\n678:           - \"{spec_folder}/spec.md\"\n679:           - \"{state_paths.lock_file}\"\n680:         classify:\n681:           no-spec: \"spec.md is absent before any pre-init mutation\"\n682:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n683:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n684:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n685:         outputs:\n686:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n687:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n688:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n689: \n690:       gate_preinit_spec_mutation_approval:\n691:         applies_to: confirm\n692:         type: approval_gate\n693:         purpose: \"Approve the planned pre-init spec.md mutation before LOOP starts\"\n694:         present: |\n695:           ## Pre-Init Spec Check\n696: \n697:           **Folder State**: {folder_state}\n698:           **Spec Path**: {spec_folder}/spec.md\n699:           **Normalized Topic**: {normalized_topic}\n700:           **Lock File**: {state_paths.lock_file}\n701: \n702:           Planned branch:\n703:           - `no-spec` -> seed Level 1 `spec.md` with `<!-- DR-SEED:REQUIREMENTS -->` and `<!-- DR-SEED:SCOPE -->`\n704:           - `spec-present` -> append bounded context in `Open Questions` and `Research Context`\n705:           - `spec-just-created-by-this-run` -> verify markers and continue without duplicate mutation\n706:           - `conflict-detected` -> halt fail-closed\n707: \n708:           Options:\n709:           A) Approve pre-init branch\n710:           B) Revise the planned branch\n711:           C) Cancel\n712:         wait_for: \"User response\"\n713:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n714:         on_A: { proceed_to: step_preinit_spec_branch }\n715:         on_B: { action: \"Adjust the planned pre-init mutation inputs\", return_to: gate_preinit_spec_mutation_approval }\n716:         on_C: { action: \"Cancel workflow after releasing the advisory lock during cleanup\", status: \"CANCELLED\", release_lock: step_release_lock }\n717: \n718:       step_preinit_spec_branch:\n719:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n720:         dry_run_boundary: \"state-mutation\"\n721:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n722:         branches:\n723:           no-spec:\n724:             create: \"{spec_folder}/spec.md\"\n725:             seed_markers:\n726:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n727:               - \"<!-- DR-SEED:SCOPE -->\"\n728:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n729:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n730:             set:\n731:               folder_state: \"spec-just-created-by-this-run\"\n732:               validate_spec_doc: true\n733:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n734:           spec-present:\n735:             edit: \"{spec_folder}/spec.md\"\n736:             set:\n737:               validate_spec_doc: true\n738:             idempotency_check:\n739:               host_anchor: \"Open Questions\"\n740:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n741:               if_match:\n742:                 skip_append: true\n743:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n744:               if_no_match:\n745:                 append_only:\n746:                   - host_anchor: \"Open Questions\"\n747:                     content: \"Add the normalized research topic only if it is not already present.\"\n748:                   - host_anchor: \"Research Context\"\n749:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n750:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n751:           spec-just-created-by-this-run:\n752:             verify_markers:\n753:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n754:               - \"<!-- DR-SEED:SCOPE -->\"\n755:             set:\n756:               validate_spec_doc: false\n757:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n758:           conflict-detected:\n759:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n760:             halt: true\n761:             release_lock: step_release_lock\n762: \n763:       step_validate_preinit_spec_doc:\n764:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n765:         condition: \"validate_spec_doc\"\n766:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n767:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n768: \n769:       step_telemetry_heartbeat_started:\n770:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n771:         skip_when: \"config.fanout is present\"\n772:         canonical_lifecycle_event: \"iteration_start\"\n773:         command: |\n774:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase started --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{AUTO_SESSION_ID}\"\n775:         working_directory: \"{repo_root}\"\n776:         outputs:\n777:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n778: \n779:       step_init_complete:\n780:         log: \"Initialization complete. Config, state, and strategy files created.\"\n781:         set: { current_iteration: 1, current_segment: 1 }\n782: \n783:       # ─── APPROVAL GATE: Post-Init ───\n784:       gate_init_approval:\n785:         applies_to: confirm\n786:         type: approval_gate\n787:         purpose: \"Show initialization results and get approval to start loop\"\n788:         present: |\n789:           ## Initialization Complete\n790: \n791:           **Topic**: {research_topic}\n792:           **Max Iterations**: {max_iterations}\n793:           **Convergence Threshold**: {convergence_threshold}\n794:           **Known Context Summary**: {prior_context_summary}\n795:           **Folder State**: {folder_state}\n796: \n797:           Review `{state_paths.strategy}` for the initial key questions and next focus.\n798:           Review `{spec_folder}/spec.md` for the approved pre-init branch and any DR seed markers or context notes.\n799:           Reducer-owned state will live in `{state_paths.registry}` and `{state_paths.dashboard}`.\n800:           **State files located in**: {state_paths.packet_dir}/\n801: \n802:           Options:\n803:           A) Start research loop\n804:           B) Adjust questions or parameters\n805:           C) Cancel\n806:         wait_for: \"User response\"\n807:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n808:         on_A: { set: { current_iteration: 1, current_segment: 1 }, proceed_to: phase_loop }\n809:         on_B: { action: \"Apply user adjustments to strategy.md and/or config\", return_to: gate_init_approval }\n810:         on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n811: \n812:   # ════════\n813:   # PHASE 2: ITERATION LOOP\n814:   # ════════\n815:   phase_loop:\n816:     purpose: Dispatch agent iterations until convergence\n817:     repeat: true\n818:     max_repeats: \"{max_iterations}\"\n819:     steps:\n820: \n[Output truncated. Continue reading with offset: 821]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1794807953342,"end":1794807953578}}}}
