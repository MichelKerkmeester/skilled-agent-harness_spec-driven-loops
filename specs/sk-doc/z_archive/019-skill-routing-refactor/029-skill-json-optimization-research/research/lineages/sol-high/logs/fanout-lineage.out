:1071-1085\"]}\n{\"type\":\"finding\",\"id\":\"iter-004-f2\",\"summary\":\"Normal root selection consumes SKILL and graph projection fields, not hub registry/router or leaf JSON.\",\"citations\":[\".opencode/skills/system-skill-advisor/mcp-server/lib/scorer/projection.ts:173-247\",\".opencode/skills/system-skill-advisor/mcp-server/lib/scorer/lanes/explicit.ts:315-343\"]}\n{\"type\":\"finding\",\"id\":\"iter-004-f3\",\"summary\":\"High-specificity hub vocabulary is invisible until parent selection, producing confirmed natural-language activation misses.\",\"citations\":[\".opencode/skills/sk-doc/hub-router.json:36-49\",\".opencode/skills/sk-doc/graph-metadata.json:53-110\"]}\n{\"type\":\"finding\",\"id\":\"iter-004-f4\",\"summary\":\"Filesystem fallback retains direct root fields but drops graph edges and doc-trigger projections.\",\"citations\":[\".opencode/skills/system-skill-advisor/mcp-server/lib/scorer/projection.ts:563-720\"]}\n{\"type\":\"finding\",\"id\":\"iter-004-f5\",\"summary\":\"Executor delegation directly consumes hub aliases but memoizes them without source-change invalidation.\",\"citations\":[\".opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:160-208\",\".opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:305-358\"]}\n{\"type\":\"finding\",\"id\":\"iter-004-f6\",\"summary\":\"Compiled sk-doc routing is active and conservative, while committed evaluation supports only moderate version-sensitive root accuracy.\",\"citations\":[\".opencode/bin/lib/compiled-routing/013-live-activation/activation/sk-doc/manifest.json:1\",\".opencode/skills/system-skill-advisor/mcp-server/scripts/routing-accuracy/scorer-eval-baseline.json:14-34\"]}","lineStart":1,"lineEnd":7,"totalLines":7,"truncated":false}},"title":".opencode/specs/sk-doc/019-skill-routing-refactor/029-skill-json-optimization-research/research/lineages/sol-high/deltas/iter-004.jsonl","time":{"start":1785307775697,"end":1785307775714}},"metadata":{"openai":{"itemId":"fc_05ee5df23bd700d1016a69a27f92208191846cf84c784c6ac5"}},"id":"prt_faca2c2c1001Zo9f61CviZz6rP","sessionID":"ses_053835f44ffewNv42EZbxtppsV","messageID":"msg_faca23bd9001YLWEBILe8zoJnr"}}
