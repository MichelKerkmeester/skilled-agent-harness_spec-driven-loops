          },\n            {\n              \"lane\": \"lexical\",\n              \"feature\": \"token_match\"\n            }\n          ]\n        },\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-code\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"fdd5d3325e8d9306d51c997fc2d4f22075f72522813356ba2ec5b8b52a8056a7\",\n          \"generation\": 2\n        }\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 12454,\n      \"checkedAt\": \"2026-07-29T06:08:12.557Z\",\n      \"lastLiveAt\": \"2026-07-29T06:07:58.399Z\"\n    },\n    \"generatedAt\": \"2026-07-29T06:08:12.640Z\",\n    \"cache\": {\n      \"hit\": false,\n      \"sourceSignaturePresent\": true\n    },\n    \"_shadow\": {\n      \"model\": \"advisor-shadow-learned-weights-v1\",\n      \"liveWeightsFrozen\": true,\n      \"recommendations\": [\n        {\n          \"skillId\": \"system-deep-loop\",\n          \"liveScore\": 0.740473,\n          \"shadowScore\": 0.701347,\n          \"delta\": -0.039126,\n          \"dominantShadowLane\": \"explicit_author\"\n        },\n        {\n          \"skillId\": \"sk-code\",\n          \"liveScore\": 0.46,\n          \"shadowScore\": 0.435714,\n          \"delta\": -0.024286,\n          \"dominantShadowLane\": \"explicit_author\"\n        }\n      ]\n    }\n  }\n}","metadata":{"truncated":false},"title":"","time":{"start":1785305292338,"end":1785305292711}},"metadata":{"openai":{"itemId":"fc_04a566bee8e67ee1016a6998cc34708191882fdf0de3efd67b"}},"id":"prt_fac7cde2f001bloXH4Pidg4Uap","sessionID":"ses_053835f44ffewNv42EZbxtppsV","messageID":"msg_fac7ca80b001dvBD89AYmVI2Jf"}}
