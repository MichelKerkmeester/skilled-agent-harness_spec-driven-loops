",\n      \"primePackage\": {\n        \"specFolder\": \"sk-doc/019-skill-routing-refactor/029-skill-json-optimization-research\",\n        \"currentTask\": \"Execute detached deep-research workflow over skill and skill-advisor JSON optimization, automation, effectiveness, testing, and integration; findings only; five iterations; write only to bound lineage\",\n        \"codeGraphStatus\": \"empty\",\n        \"recommendedCalls\": [\n          \"code_graph_scan\"\n        ],\n        \"structuralContext\": {\n          \"status\": \"missing\",\n          \"summary\": \"No structural context available — code graph is empty or unavailable\",\n          \"recommendedAction\": \"Call session_bootstrap first. Then run code_graph_scan if structural context is needed.\",\n          \"sourceSurface\": \"auto-prime\",\n          \"provenance\": {\n            \"producer\": \"session_snapshot\",\n            \"sourceSurface\": \"auto-prime\",\n            \"trustState\": \"absent\",\n            \"generatedAt\": \"2026-07-29T06:08:16.634Z\",\n            \"lastUpdated\": null,\n            \"sourceRefs\": [\n              \"code-graph-db\",\n              \"session-snapshot\"\n            ]\n          }\n        },\n        \"routingRules\": {\n          \"graphRetrieval\": \"For broad topic questions, use memory_search with retrievalLevel: \\\"global\\\" for community-level results. For specific memories, use \\\"local\\\" (default). Use \\\"auto\\\" for automatic fallback.\",\n          \"communitySearch\": \"When primary search returns weak results, community search fallback activates automatically (SPECKIT_COMMUNITY_SEARCH_FALLBACK). Graph provenance is visible in graphEvidence field.\",\n          \"toolRouting\": \"SEARCH ROUTING: exact text/regex → Grep\"\n        }\n      },\n      \"surfaced_at\": \"2026-07-29T06:08:16.634Z\",\n      \"latencyMs\": 0\n    },\n    \"autoSurfacedContext\": {\n      \"constitutional\": [],\n      \"triggered\": [\n        {\n          \"memory_id\": 3029,\n          \"spec_folder\": \"sk-git/z_archive/001-sk-git-github-mcp-integration\",\n          \"title\": \"Feature Specification: GitHub MCP Integration for [03--commands-and-skills/001-sk-git-github-mcp-integration/spec]\",\n          \"matched_phrases\": [\n            \"integration\"\n          ]\n        },\n        {\n          \"memory_id\": 3345,\n          \"spec_folder\": \"system-code-graph/z_archive/012-query-routing-integration\",\n          \"title\": \"Plan: Query-Routing Integration [024/020] [system-spec-kit/system-code-graph/z_archive/012-query-routing-integration/pla...\",\n          \"matched_phrases\": [\n            \"integration\"\n          ]\n        },\n        {\n          \"memory_id\": 3028,\n          \"spec_folder\": \"sk-git/z_archive/001-sk-git-github-mcp-integration\",\n          \"title\": \"Implementation Plan: GitHub MCP Integration [03--commands-and-skills/001-sk-git-github-mcp-integration/plan]\",\n          \"matched_phrases\": [\n            \"integration\"\n          ]\n        },\n        {\n          \"memory_id\": 3398,\n          \"spec_folder\": \"system-code-graph/z_archive/018-cli-devin-code-graph-hook\",\n          \"title\": \"Feature Research: CLI Devin Code Graph Hook\",\n          \"matched_phrases\": [\n            \"research\"\n          ]\n        },\n        {\n          \"memory_id\": 3347,\n          \"spec_folder\": \"system-code-graph/z_archive/012-query-routing-integration\",\n          \"title\": \"Tasks: Query-Routing Integration [024/020] [system-spec-kit/system-code-graph/z_archive/012-query-routing-integration/ta...\",\n          \"matched_phrases\": [\n            \"integration\"\n          ]\n        }\n      ],\n      \"surfaced_at\": \"2026-07-29T06:08:18.481Z\",\n      \"latencyMs\": 1847\n    },\n    \"tokenBudget\": 3500\n  }\n}","metadata":{"truncated":false},"title":"","time":{"start":1785305292332,"end":1785305299065}},"metadata":{"openai":{"itemId":"fc_04a566bee8e67ee1