{"type":"step_start","timestamp":1786561248541,"sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","part":{"id":"prt_ff7593d1c001Dt8x0uyF15ZaAc","messageID":"msg_ff75933dd001LPvT14lULC4lNn","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","snapshot":"b49964b8780a6677b92008859312b0db904b8bac","type":"step-start"}}
{"type":"tool_use","timestamp":1786561250998,"sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","part":{"type":"tool","tool":"read","callID":"call_00_mIHtiGbRz9i69BH0cx8f8288","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/commands/deep/assets/deep-review-auto.yaml","offset":647},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/commands/deep/assets/deep-review-auto.yaml</path>\n<type>file</type>\n<content>\n647:                candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n648:                candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n649:                graphless_fallback_gate_pass = boolean\n650:                graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n651:                graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n652:                graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n653:                recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n654:           6. COMBINED STOP RULE:\n655:                a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n656:                b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n657:                     decision = \"BLOCKED\"\n658:                     stop_blocked = true\n659:                     stopReason = \"blockedStop\"\n660:                     # Blocked-stop closure: blockedBy must be string[] per the\n661:                     # published review blocked-stop contract. Extract the `.type`\n662:                     # field from each structured graph blocker; preserve the full\n663:                     # objects in graph_blocker_detail_json for operator inspection.\n664:                     blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n665:                     blocked_by_csv = graph_blockers_csv\n666:                     graph_blocker_detail_json = graph_blockers_json\n667:                     recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n668:                c) if STOP is legal AND graph_decision == \"CONTINUE\":\n669:                     decision = \"CONTINUE\"\n670:                     stop_blocked = false\n671:                     reason = \"graph_convergence_continue\"\n672:                d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n673:         outputs:\n674:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n675:           - reason: \"Human-readable stop reason\"\n676:           - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n677:           - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n678:           - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n679:           - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n680:           - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n681:           - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n682:           - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n683:           - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n684:           - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n685:           - active_p0_count: \"Active P0 finding count at stop-check time\"\n686:           - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n687:           - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n688:           - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n689:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n690:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n691:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n692:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n693:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n694:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n695:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n696:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n697:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n698:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n699:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n700:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n701:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n702:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n703:           - graph_signals_json: \"JSON object returned by graph convergence\"\n704:           - graph_blockers_json: \"JSON array of graph blockers\"\n705:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n706:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n707: \n708:       step_emit_blocked_stop:\n709:         action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n710:         if_blocked:\n711:           append_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"review\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergenceGate\":{\"pass\":{convergence_gate_pass},\"score\":{convergence_gate_score}},\"dimensionCoverageGate\":{\"pass\":{dimension_coverage_gate_pass},\"covered\":{dimension_coverage_gate_covered_json},\"missing\":{dimension_coverage_gate_missing_json}},\"p0ResolutionGate\":{\"pass\":{p0_resolution_gate_pass},\"activeP0\":{active_p0_count}},\"evidenceDensityGate\":{\"pass\":{evidence_density_gate_pass},\"avgEvidencePerFinding\":{avg_evidence_per_finding}},\"hotspotSaturationGate\":{\"pass\":{hotspot_saturation_gate_pass}},\"claimAdjudicationGate\":{\"pass\":{claim_adjudication_gate_pass},\"activeP0P1\":{claim_adjudication_active_count}},\"fixCompletenessReplayGate\":{\"pass\":{fix_completeness_replay_gate_pass},\"securitySensitive\":{security_sensitive_fix_scope},\"requiredRows\":{fix_completeness_replay_required_rows},\"passingRows\":{fix_completeness_replay_passing_rows}},\"candidateCoverageGate\":{\"pass\":{candidate_coverage_gate_pass},\"searchDebt\":{candidate_coverage_search_debt_json},\"missing\":{candidate_coverage_missing_json}},\"graphlessFallbackGate\":{\"pass\":{graphless_fallback_gate_pass},\"mode\":\"{graphless_fallback_mode}\",\"missing\":{graphless_fallback_missing_json},\"unavailabilityReason\":\"{graphless_fallback_unavailability_reason}\"}},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n712:           log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n713:         if_not_blocked:\n714:           proceed: true\n715: \n716:       step_handle_convergence:\n717:         action: \"Act on convergence decision\"\n718:         if_stop:\n719:           branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n720:           if_divergent_eligible:\n721:             eligibility_contract:\n722:               required_decision: \"STOP\"\n723:               eligible_reasons: [all_dimensions_clean]\n724:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n725:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n726:             steps:\n727:               step_prepare_divergent_pivot:\n728:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n729:                 command: |\n730:                   node --experimental-strip-types --input-type=module <<'EOF'\n731:                   import {\n732:                     buildReviewPivotPreparationInput,\n733:                     renderReviewPivotSeatPrompt,\n734:                   } from './.opencode/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n735:                   import {\n736:                     preparePivotTransaction,\n737:                   } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n738: \n739:                   const input = buildReviewPivotPreparationInput({\n740:                     artifactRoot: '{state_paths.packet_dir}',\n741:                     configPath: '{state_paths.config}',\n742:                     stateLogPath: '{state_paths.state_log}',\n743:                     strategyPath: '{state_paths.strategy}',\n744:                     registryPath: '{state_paths.findings_registry}',\n745:                     currentIteration: Number('{current_iteration}'),\n746:                     maxIterations: Number('{max_iterations}'),\n747:                     triggerReason: '{reason}',\n748:                   });\n749:                   const prepared = await preparePivotTransaction(input);\n750:                   const seatPrompts = prepared.status === 'pending'\n751:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n752:                         seat.id,\n753:                         renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n754:                       ]))\n755:                     : {};\n756:                   process.stdout.write(`${JSON.stringify({\n757:                     ...prepared,\n758:                     seatPrompts,\n759:                     boundaryRejections: input.boundaryRejections,\n760:                   })}\\n`);\n761:                   EOF\n762:                 working_directory: \"{repo_root}\"\n763:                 outputs:\n764:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n765:                   - pivot_prepare_status: \"status from the prepare result\"\n766:                   - pivot_id: \"pivotId from the prepare result\"\n767:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n768:                   - pivot_resumed: \"resumed from the prepare result\"\n769:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n770:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n771:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n772:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n773:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n774:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n775:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n776:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n777:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n778: \n779:               step_dispatch_pivot_seat_001:\n780:                 action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n781:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n782:                 capture_timing: true\n783:                 if_native:\n784:                   dispatch:\n785:                     agent: deep-review\n786:                     model: opus\n787:                     context_source: \"pivot_seat_001_prompt\"\n788:                   wait_for_completion: true\n789:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n790:                 outputs:\n791:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n792:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n793:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n794:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n795:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n796:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n797: \n798:               step_record_pivot_seat_001:\n799:                 action: \"Durably record the seat-001 native dispatch outcome\"\n800:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n801:                 command: |\n802:                   node --experimental-strip-types --input-type=module <<'EOF'\n803:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n804:                   const status = '{pivot_seat_001_dispatch_status}';\n805:                   const outcome = status === 'fulfilled'\n806:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n807:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n808:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n809:                   EOF\n810:                 working_directory: \"{repo_root}\"\n811: \n812:               step_dispatch_pivot_seat_002:\n813:                 action: \"Natively dispatch the critical read-only review direction-selection seat\"\n814:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n815:                 capture_timing: true\n816:                 if_native:\n817:                   dispatch:\n818:                     agent: deep-review\n819:                     model: opus\n820:                     context_source: \"pivot_seat_002_prompt\"\n821:                   wait_for_completion: true\n822:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n823:                 outputs:\n824:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n825:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n826:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n827:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n828:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n829:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n830: \n831:               step_record_pivot_seat_002:\n832:                 action: \"Durably record the seat-002 native dispatch outcome\"\n833:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n834:                 command: |\n835:                   node --experimental-strip-types --input-type=module <<'EOF'\n836:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n837:                   const status = '{pivot_seat_002_dispatch_status}';\n838:                   const outcome = status === 'fulfilled'\n839:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n840:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n841:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n842:                   EOF\n843:                 working_directory: \"{repo_root}\"\n844: \n845:               step_dispatch_pivot_seat_003:\n846:                 action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n847:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n848:                 capture_timing: true\n849:                 if_native:\n850:                   dispatch:\n851:                     agent: deep-review\n852:                     model: opus\n853:                     context_source: \"pivot_seat_003_prompt\"\n854:                   wait_for_completion: true\n855:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n856:                 outputs:\n857:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n858:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n859:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n860:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n861:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n862:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n863: \n864:               step_record_pivot_seat_003:\n865:                 action: \"Durably record the seat-003 native dispatch outcome\"\n866:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n867:                 command: |\n868:                   node --experimental-strip-types --input-type=module <<'EOF'\n869:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n870:                   const status = '{pivot_seat_003_dispatch_status}';\n871:                   const outcome = status === 'fulfilled'\n872:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n873:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n874:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n875:                   EOF\n876:                 working_directory: \"{repo_root}\"\n877: \n878:               step_finalize_divergent_pivot:\n879:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n880:                 skip_when: \"pivot_prepare_status != 'pending'\"\n881:                 command: |\n882:                   node --experimental-strip-types --input-type=module <<'EOF'\n883:                   import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n884:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n885:                   EOF\n886:                 working_directory: \"{repo_root}\"\n887:                 outputs:\n888:                   - pivot_finalize_json: \"The complete parsed final result\"\n889: \n890:               step_resolve_divergent_pivot_result:\n891:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n892:                 branch_on: \"pivot_prepare_status\"\n893:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n894:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n895: \n896:               step_apply_divergent_pivot_result:\n897:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n898:                 branch_on: \"pivot_result.status\"\n899:                 if_completed:\n900:                   set:\n901:                     next_dimension: \"{pivot_result.restoredFocus}\"\n902:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n903:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n904:                   command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n905:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n906:                   proceed_to: step_normalize_pause_events\n907:                 if_failed:\n908:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n909:                   skip_to: phase_synthesis\n910:             on_error:\n911:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n912:               skip_to: phase_synthesis\n913:           if_existing_terminal_path:\n914:             log: \"Loop stopping. Reason: {reason}\"\n915:             skip_to: phase_synthesis\n916:         if_blocked:\n917:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n918:         if_stuck_recovery:\n919:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n920:           recovery_strategies:\n921:             - \"Change granularity: file-level → function-level → line-level review\"\n922:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n923:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n924:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n925:           set:\n926:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n927:             pending_stop_event: \"stuck_recovery\"\n928:             pending_stop_reason: \"stuckRecovery\"\n929:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n930:           reset: { stuck_count: 0 }\n931:         if_continue:\n932:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n933: \n934:       step_normalize_pause_events:\n935:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n936:         if_pending_pause_event:\n937:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"review\",\"stopReason\":\"userPaused\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n938:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n939:           reset:\n940:             pending_stop_event: null\n941:             pending_stop_reason: null\n942:             pending_stop_detail: null\n943:           halt: true\n944:         if_pending_stuck_recovery:\n945:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"review\",\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"strategy\":\"{recovery_strategy}\",\"targetDimension\":\"{least_explored}\",\"outcome\":\"pending\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n946:           reset:\n947:             pending_stop_event: null\n948:             pending_stop_reason: null\n949:             pending_stop_detail: null\n950:         if_no_pending_event:\n951:           proceed: true\n952: \n953:       step_generate_state_summary:\n954:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n955:         generate: |\n956:           STATE SUMMARY (auto-generated):\n957:           Iteration: {current_iteration} of {max_iterations}\n958:           Dimension: {next_dimension}\n959:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n960:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n961:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n962:           {resource_map_prompt_line}\n963:           Coverage Age: {coverage_age}\n964:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n965:           Stuck count: {stuck_count}\n966:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n967: \n968:       step_marker_scan:\n969:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n970:         algorithm: |\n971:           if current_iteration > 1:\n972:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n973:             if file_exists(PREV_PROMPT_PATH):\n974:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n975:               if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n976:                 log \"ERROR: nested review-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n977:                 halt with exit code 2\n978:         note: |\n979:           False-positive prevention: only matches when the first line is exactly one of the\n980:           three canonical markers. Markers appearing in comments or body text are ignored.\n981:           True-positive triggers only when a previous iteration's rendered prompt literally\n982:           starts with a deep-loop marker, indicating a nested review-of-review dispatch.\n983: \n984:       step_dispatch_iteration:\n985:         action: \"Dispatch @deep-review agent for one review iteration\"\n986:         resolve_executor:\n987:           source: \"config.executor\"\n988:           loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n989:         pre_dispatch:\n990:           generate_summary: |\n991:             STATE SUMMARY (auto-generated):\n992:             Iteration: {current_iteration} of {max_iterations}\n993:             Dimension: {next_dimension}\n994:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n995:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n996:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n997:             {resource_map_prompt_line}\n998:             Coverage Age: {coverage_age}\n999:             Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1000:             Stuck count: {stuck_count}\n1001:             Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1002:           render_prompt_pack:\n1003:             template_path: \".opencode/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n1004:             renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1005:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1006:             variables:\n1007:               state_summary: \"{state_summary}\"\n1008:               current_iteration: \"{current_iteration}\"\n1009:               max_iterations: \"{max_iterations}\"\n1010:               next_dimension: \"{next_dimension}\"\n1011:               review_target: \"{review_target}\"\n1012:               review_scope_files: \"{review_scope_files}\"\n1013:               p0_count: \"{p0_count}\"\n1014:               p1_count: \"{p1_count}\"\n1015:               p2_count: \"{p2_count}\"\n1016:               pivot_lineage: \"{pivot_lineage}\"\n1017:               saturated_directions: \"{saturated_directions}\"\n1018:               state_paths_config: \"{state_paths.config}\"\n1019:               state_paths_state_log: \"{state_paths.state_log}\"\n1020:               state_paths_findings_registry: \"{state_paths.findings_registry}\"\n1021:               state_paths_strategy: \"{state_paths.strategy}\"\n1022:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1023:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1024:         pre_dispatch_audit:\n1025:           skip_when: \"config.executor.kind == 'native'\"\n1026:           call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1027:           args:\n1028:             stateLogPath: \"{state_paths.state_log}\"\n1029:             executor: \"{config.executor}\"\n1030:             iteration: \"{current_iteration}\"\n1031:         branch_on: \"config.executor.kind\"\n1032:         if_native:\n1033:           dispatch:\n1034:             agent: deep-review\n1035:             model: opus\n1036:             context_source: \"rendered_prompt_pack\"\n1037:           wait_for_completion: true\n1038:         if_cli_copilot:\n1039:           command: |\n1040:             node --experimental-strip-types --input-type=module <<'EOF'\n1041:             import { readFileSync, writeFileSync } from 'node:fs';\n1042:             import { createHash } from 'node:crypto';\n1043: \n1044:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1045:             import { buildCopilotPromptArg } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1046: \n1047:             const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';\n1048:             const prompt = readFileSync(promptPath, 'utf8');\n1049: \n1050:             // Workflow-resolved spec folder is the only legal write authority.\n1051:             // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)\n1052:             // is the single source of truth for rejecting empty / unresolved\n1053:             // template / whitespace-only / string-coerced empty values. The\n1054:             // YAML hands the raw `{spec_folder}` directly; on rejection the\n1055:             // helper safe-fails to `type:\"missing\", writeIntent:true` (Gate-3\n1056:             // enforcement, --allow-all-tools stripped).\n1057:             const specFolderRaw = '{spec_folder}';\n1058:             const targetAuthority = { type: 'approved', specFolder: specFolderRaw };\n1059: \n1060:             const baseArgs = [\n1061:               '-p',\n1062:               prompt,\n1063:               '--model',\n1064:               '{config.executor.model}',\n1065:               '--allow-all-tools',\n1066:               '--no-ask-user',\n1067:             ];\n1068: \n1069:             const built = buildCopilotPromptArg({\n1070:               promptPath,\n1071:               prompt,\n1072:               targetAuthority,\n1073:               baseArgv: baseArgs,\n1074:             });\n1075: \n1076:             // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`\n1077:             // containing `<TARGET AUTHORITY preamble>\\n\\n---\\n\\n<original>`.\n1078:             // Write it to disk so the file Copilot reads via @path opens with\n1079:             // the authority block. Without this, recovered/bootstrap folder\n1080:             // mentions inside the file could still anchor the model.\n1081:             if (built.promptFileBody !== undefined) {\n1082:               writeFileSync(promptPath, built.promptFileBody, 'utf8');\n1083:             }\n1084: \n1085:             // Copilot is routed through the audited executor wrapper so it produces\n1086:             // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode\n1087:             // There is no cli-copilot kind in the executor schema, so it\n1088:             // dispatches as kind:'native' (full env passthrough, no recursion-guard\n1089:             // layer configured for copilot); the receipt still records the real\n1090:             // 'copilot' command + built.argv as facts.\n1091:             const dispatchFacts = {\n1092:               command: 'deep/review',\n1093:               mode: 'review',\n1094:               specFolder: '{spec_folder}',\n1095:               artifactDir: '{state_paths.packet_dir}',\n1096:               iteration: Number('{current_iteration}'),\n1097:               executorKind: '{config.executor.kind}',\n1098:               branchId: '{config.executor.kind}',\n1099:               sessionId: '{session_id}',\n1100:               generation: Number('{generation}'),\n1101:             };\n1102:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1103:             process.exit(\n1104:               runAuditedExecutorCommand({\n1105:                 command: 'copilot',\n1106:                 args: built.argv,\n1107:                 cwd: '{repo_root}',\n1108:                 timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1109:                 stateLogPath: '{state_paths.state_log}',\n1110:                 executor: {\n1111:                   kind: 'native',\n1112:                   model: '{config.executor.model}',\n1113:                   configDir: null,\n1114:                   reasoningEffort: null,\n1115:                   serviceTier: null,\n1116:                   sandboxMode: null,\n1117:                   timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1118:                   governor: null,\n1119:                 },\n1120:                 iteration: Number('{current_iteration}'),\n1121:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1122:                 dispatchId,\n1123:               }),\n1124:             );\n1125:             EOF\n1126:           working_directory: \"{repo_root}\"\n1127:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1128:           wait_for_completion: true\n1129:           notes:\n1130:             - \"Routed through runAuditedExecutorCommand so copilot produces INTENT + COMPLETION dispatch receipts; built.argv (@PROMPT_PATH or positional) is forwarded verbatim as the receipt facts\"\n1131:             - \"copilot has no stdin support; prompt is positional\"\n1132:             - \"Size check uses 16KB threshold; above that uses @PROMPT_PATH wrapper prompt\"\n1133:             - \"Large-prompt path relies on copilot honoring @path references within its prompt string\"\n1134:             - \"buildCopilotPromptArg attaches a TARGET AUTHORITY preamble bound to the workflow-approved spec folder; recovered context cannot override it (authority guard source: .opencode/commands/speckit/assets/speckit_deep-review_auto.yaml)\"\n1135:             - \"If spec_folder is missing/malformed/unresolved on a write-intent dispatch, the helper enforces plan-only by replacing the prompt with a Gate-3 question and stripping --allow-all-tools\"\n1136:             - \"Large-prompt wrapper mode rewrites the prompt file at promptPath to include the TARGET AUTHORITY preamble (prefix + divider + original body); the argv becomes a bare @promptPath reference\"\n1137:         if_cli_claude_code:\n1138:           command: |\n1139:             node --experimental-strip-types --input-type=module <<'EOF'\n1140:             import { readFileSync } from 'node:fs';\n1141:             import { createHash } from 'node:crypto';\n1142: \n1143:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1144: \n1145:             const configDir = '{optional_claude_config_dir}';\n1146:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1147:             const executor = {\n1148:               kind: 'cli-claude-code',\n1149:               model: '{config.executor.model}',\n1150:               configDir: configDir || null,\n1151:               reasoningEffort,\n1152:               serviceTier: null,\n1153:               sandboxMode: null,\n1154:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1155:               governor: null,\n1156:             };\n1157:             const args = [\n1158:               '-p',\n1159:               readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n1160:               '--model',\n1161:               executor.model,\n1162:               '--permission-mode',\n1163:               'acceptEdits',\n1164:               '--output-format',\n1165:               'text',\n1166:             ];\n1167:             if (executor.reasoningEffort) {\n1168:               args.push('--effort', executor.reasoningEffort);\n1169:             }\n1170: \n1171:             // CLAUDE_CONFIG_DIR rides through guardContext.env; the CLAUDE_ prefix is\n1172:             // on the cli-claude-code env allowlist so buildExecutorDispatchEnv admits it.\n1173:             const parentEnv = { ...process.env };\n1174:             if (configDir) {\n1175:               parentEnv.CLAUDE_CONFIG_DIR = configDir;\n1176:             }\n1177: \n1178:             const dispatchFacts = {\n1179:               command: 'deep/review',\n1180:               mode: 'review',\n1181:               specFolder: '{spec_folder}',\n1182:               artifactDir: '{state_paths.packet_dir}',\n1183:               iteration: Number('{current_iteration}'),\n1184:               executorKind: '{config.executor.kind}',\n1185:               branchId: '{config.executor.kind}',\n1186:               sessionId: '{session_id}',\n1187:               generation: Number('{generation}'),\n1188:             };\n1189:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1190:             process.exit(\n1191:               runAuditedExecutorCommand({\n1192:                 command: 'claude',\n1193:                 args,\n1194:                 cwd: '{repo_root}',\n1195:                 timeoutSeconds: executor.timeoutSeconds,\n1196:                 stateLogPath: '{state_paths.state_log}',\n1197:                 executor,\n1198:                 iteration: Number('{current_iteration}'),\n1199:                 guardContext: { env: parentEnv },\n1200:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1201:                 dispatchId,\n1202:               }),\n1203:             );\n1204:             EOF\n1205:           working_directory: \"{repo_root}\"\n1206:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1207:           wait_for_completion: true\n1208:           render_hint:\n1209:             optional_claude_config_dir: |\n1210:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and bind that path.\n1211:               Otherwise expand to empty string.\n1212:           notes:\n1213:             - \"Routed through runAuditedExecutorCommand so claude-code produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1214:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so account-specific Claude Code routing is preserved\"\n1215:             - \"permission-mode stays acceptEdits (review's existing iteration-write behavior); claude-code has no serviceTier flag\"\n1216:             - \"claude-code supports --effort for reasoning depth\"\n1217:         if_cli_opencode:\n1218:           command: |\n1219:             node --experimental-strip-types --input-type=module <<'EOF'\n1220:             import { execFileSync } from 'node:child_process';\n1221:             import { appendFileSync, readFileSync, realpathSync } from 'node:fs';\n1222:             import { createHash } from 'node:crypto';\n1223:             import { isAbsolute, relative, resolve } from 'node:path';\n1224: \n1225:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1226: \n1227:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1228:             const executor = {\n1229:               kind: 'cli-opencode',\n1230:               model: '{config.executor.model}',\n1231:               configDir: null,\n1232:               reasoningEffort,\n1233:               serviceTier: null,\n1234:               sandboxMode: null,\n1235:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1236:               governor: null,\n1237:             };\n1238:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1239:             if (!promptBody.includes('BANNED OPERATIONS') || !promptBody.includes('ALLOWED WRITE PATHS')) {\n1240:               throw new Error('Unsafe cli-opencode dispatch: rendered prompt is missing required write-containment sections');\n1241:             }\n1242: \n1243:             const repoRoot = realpathSync('{repo_root}');\n1244:             const artifactDir = resolve(repoRoot, '{state_paths.packet_dir}');\n1245:             const artifactRelative = relative(repoRoot, artifactDir);\n1246:             if (artifactRelative === '' || artifactRelative.startsWith('..') || isAbsolute(artifactRelative)) {\n1247:               throw new Error('Unsafe cli-opencode dispatch: artifact directory must be a strict descendant of the worktree root');\n1248:             }\n1249: \n1250:             const git = (args, cwd = repoRoot, trim = true) => {\n1251:               const output = execFileSync('git', args, { cwd, encoding: 'utf8' });\n1252:               return trim ? output.trim() : output;\n1253:             };\n1254:             const resolveGitPath = (candidate) => realpathSync(isAbsolute(candidate) ? candidate : resolve(repoRoot, candidate));\n1255:             const gitDir = resolveGitPath(git(['rev-parse', '--git-dir']));\n1256:             const commonGitDir = resolveGitPath(git(['rev-parse', '--git-common-dir']));\n1257:             if (gitDir === commonGitDir) {\n1258:               throw new Error('Unsafe cli-opencode dispatch: --dir must point at an isolated linked worktree');\n1259:             }\n1260: \n1261:             const primaryBlock = git(['worktree', 'list', '--porcelain'])\n1262:               .split(/\\n\\n+/)\n1263:               .find((block) => /^branch refs\\/heads\\/(?:main|master)$/m.test(block));\n1264:             const primaryLine = primaryBlock?.split('\\n').find((line) => line.startsWith('worktree '));\n1265:             if (!primaryLine) {\n1266:               throw new Error('Unsafe cli-opencode dispatch: primary main/master worktree could not be resolved');\n1267:             }\n1268:             const primaryRoot = realpathSync(primaryLine.slice('worktree '.length));\n1269:             const primaryStatus = git(['status', '--porcelain=v1', '--untracked-files=all'], primaryRoot);\n1270:             if (primaryStatus) {\n1271:               throw new Error('Unsafe cli-opencode dispatch: primary worktree must be clean before unrestricted execution');\n1272:             }\n1273: \n1274:             const dirtyPaths = [\n1275:               ...git(['diff', '--name-only', '-z', 'HEAD', '--'], repoRoot, false).split('\\0'),\n1276:               ...git(['ls-files', '--others', '--exclude-standard', '-z'], repoRoot, false).split('\\0'),\n1277:             ].filter(Boolean);\n1278:             const outsideArtifactDir = dirtyPaths.filter((candidate) => {\n1279:               const candidateRelative = relative(artifactDir, resolve(repoRoot, candidate));\n1280:               return candidateRelative.startsWith('..') || isAbsolute(candidateRelative);\n1281:             });\n1282:             if (outsideArtifactDir.length > 0) {\n1283:               throw new Error(`Unsafe cli-opencode dispatch: worktree changes outside the artifact directory: ${outsideArtifactDir.join(', ')}`);\n1284:             }\n1285: \n1286:             const recoveryBaselineCommit = git(['rev-parse', '--verify', 'HEAD']);\n1287:             appendFileSync(\n1288:               '{state_paths.state_log}',\n1289:               `${JSON.stringify({ type: 'event', event: 'recovery_baseline', mode: 'review', iteration: Number('{current_iteration}'), recoveryBaselineCommit, worktree: repoRoot, timestamp: new Date().toISOString() })}\\n`,\n1290:               'utf8',\n1291:             );\n1292:             const message = 'Resolved route: mode=review; target_agent=@deep-review; execution=single_review_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1293:               + '\\n\\n'\n1294:               + promptBody;\n1295:             const args = [\n1296:               'run',\n1297:               '--model',\n1298:               executor.model,\n1299:               '--format',\n1300:               'json',\n1301:               '--dangerously-skip-permissions',\n1302:               '--pure',\n1303:               '--dir',\n1304:               '{repo_root}',\n1305:             ];\n1306:             if (executor.reasoningEffort) {\n1307:               args.push('--variant', executor.reasoningEffort);\n1308:             }\n1309:             args.push(message);\n1310: \n1311:             const dispatchFacts = {\n1312:               command: 'deep/review',\n1313:               mode: 'review',\n1314:               specFolder: '{spec_folder}',\n1315:               artifactDir: '{state_paths.packet_dir}',\n1316:               iteration: Number('{current_iteration}'),\n1317:               executorKind: '{config.executor.kind}',\n1318:               branchId: '{config.executor.kind}',\n1319:               sessionId: '{session_id}',\n1320:               generation: Number('{generation}'),\n1321:             };\n1322:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1323:             process.exit(\n1324:               runAuditedExecutorCommand({\n1325:                 command: 'opencode',\n1326:                 args,\n1327:                 cwd: '{repo_root}',\n1328:                 timeoutSeconds: executor.timeoutSeconds,\n1329:                 stateLogPath: '{state_paths.state_log}',\n1330:                 executor,\n1331:                 iteration: Number('{current_iteration}'),\n1332:                 // opencode v1.14.39 reads stdin at startup before session creation;\n1333:                 // an empty input gives EOF stdin, equivalent to </dev/null.\n1334:                 input: '',\n1335:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1336:                 dispatchId,\n1337:               }),\n1338:             );\n1339:             EOF\n1340:           working_directory: \"{repo_root}\"\n1341:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1342:           wait_for_completion: true\n1343:           notes:\n1344:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1345:             - \"Fail closed before dispatch unless the rendered containment sections exist, --dir is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir; append the recovery-baseline commit to state_log\"\n1346:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n1347:             - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n1348:             - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n1349:             - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n1350:             - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1351:         if_cli_codex:\n1352:           command: |\n1353:             node --experimental-strip-types --input-type=module <<'EOF'\n1354:             import { readFileSync } from 'node:fs';\n1355:             import { execFileSync } from 'node:child_process';\n1356: \n1357:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1358:             import {\n1359:               snapshotOutOfScopeDirtyPaths,\n1360:               enforceWriteContainment,\n1361:             } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1362: \n1363:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1364:             // never silently degrade to another executor. Undetected absence is what\n1365:             // got Codex deprecated before, so the branch exits non-zero when the\n1366:             // binary is missing instead of falling through to a native/other path.\n1367:             let codexAvailable = false;\n1368:             try {\n1369:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1370:               codexAvailable = true;\n1371:             } catch {}\n1372:             if (!codexAvailable) {\n1373:               console.error('cli-codex executor unavailable: command -v codex failed');\n1374:               process.exit(1);\n1375:             }\n1376: \n1377:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1378:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1379:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1380:             const executor = {\n1381:               kind: 'cli-codex',\n1382:               model,\n1383:               configDir: null,\n1384:               reasoningEffort,\n1385:               serviceTier,\n1386:               sandboxMode: 'workspace-write',\n1387:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1388:               governor: null,\n1389:             };\n1390: \n1391:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1392: \n1393:             // codex reads the iteration prompt from stdin via the trailing '-'. A review\n1394:             // iteration must WRITE its own iteration file, delta and state record, so the\n1395:             // sandbox is workspace-write — read-only would block those required writes.\n1396:             // approval_policy=never keeps the run non-interactive.\n1397:             const args = ['exec'];\n1398:             if (model) {\n1399:               args.push('--model', model);\n1400:             }\n1401:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1402:             if (serviceTier) {\n1403:               args.push('-c', 'service_tier=' + serviceTier);\n1404:             }\n1405:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1406: \n1407:             const dispatchId = 'review-i{current_iteration}-g{generation}';\n1408:             const repoRoot = '{repo_root}';\n1409:             const artifactDir = '{artifact_dir}';\n1410:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1411:             const dispatchExit = runAuditedExecutorCommand({\n1412:               command: 'codex',\n1413:               args,\n1414:               cwd: repoRoot,\n1415:               timeoutSeconds: executor.timeoutSeconds,\n1416:               stateLogPath: '{state_paths.state_log}',\n1417:               executor,\n1418:               iteration: Number('{current_iteration}'),\n1419:               input: promptBody,\n1420:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1421:               dispatchId,\n1422:             });\n1423:             // Structural write-containment: a workspace-write codex leaf can write\n1424:             // anywhere in the repo. Revert any NEW out-of-artifact-dir change it\n1425:             // made, append a containment_violation event to the state log, and\n1426:             // fail the iteration fail-closed. The leaf's own writes under\n1427:             // artifactDir (iteration file/delta/state record) are never flagged.\n1428:             const containment = enforceWriteContainment({\n1429:               repoRoot,\n1430:               artifactDir,\n1431:               preDispatchDirtyPaths,\n1432:               stateLogPath: '{state_paths.state_log}',\n1433:               iteration: Number('{current_iteration}'),\n1434:               label: dispatchId,\n1435:             });\n1436:             if (containment.violations.length > 0) {\n1437:               console.error(\n1438:                 'write-containment violation: reverted ' + containment.violations.length\n1439:                   + ' out-of-scope path(s): '\n1440:                   + containment.violations.map((v) => v.path).join(', '),\n1441:               );\n1442:               process.exit(1);\n1443:             }\n1444:             process.exit(dispatchExit);\n1445:             EOF\n1446:           working_directory: \"{repo_root}\"\n1447:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1448:           wait_for_completion: true\n1449:           notes:\n\n(Output capped at 50 KB. Showing lines 647-1449. Use offset=1450 to continue.)\n</content>","metadata":{"preview":"               candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n               candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n               graphless_fallback_gate_pass = boolean\n               graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n               graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n               graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n               recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n          6. COMBINED STOP RULE:\n               a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n               b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n                    decision = \"BLOCKED\"\n                    stop_blocked = true\n                    stopReason = \"blockedStop\"\n                    # Blocked-stop closure: blockedBy must be string[] per the\n                    # published review blocked-stop contract. Extract the `.type`\n                    # field from each structured graph blocker; preserve the full\n                    # objects in graph_blocker_detail_json for operator inspection.\n                    blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n                    blocked_by_csv = graph_blockers_csv\n                    graph_blocker_detail_json = graph_blockers_json","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/commands/deep/assets/deep-review-auto.yaml","text":"               candidate_coverage_search_debt_json = JSON array of reducer-owned searchDebt obligations blocking STOP, else []\n               candidate_coverage_missing_json = JSON array of required bug classes not present in candidateCoverage.covered, else []\n               graphless_fallback_gate_pass = boolean\n               graphless_fallback_mode = latest reducer-owned searchCoverage.graphCoverageMode value\n               graphless_fallback_missing_json = JSON array of required bug classes without cited fallback ledger rows, else []\n               graphless_fallback_unavailability_reason = explicit reason when graphCoverageMode == \"unavailable_blocked\", else empty string\n               recovery_strategy = one-line hint describing the next review action needed to satisfy the failed gates; combine candidateCoverageGate and graphlessFallbackGate recovery guidance when both fail (when claimAdjudicationGate is the failing gate, prefer the step-0 recovery_strategy already set)\n          6. COMBINED STOP RULE:\n               a) if STOP is legal AND graph_decision == \"STOP_ALLOWED\": decision = \"STOP\"\n               b) if STOP is legal AND graph_decision == \"STOP_BLOCKED\":\n                    decision = \"BLOCKED\"\n                    stop_blocked = true\n                    stopReason = \"blockedStop\"\n                    # Blocked-stop closure: blockedBy must be string[] per the\n                    # published review blocked-stop contract. Extract the `.type`\n                    # field from each structured graph blocker; preserve the full\n                    # objects in graph_blocker_detail_json for operator inspection.\n                    blocked_by_json = JSON.stringify(graph_blockers_json.map(b => typeof b === \"string\" ? b : (b && b.type) || \"graph_blocker\"))\n                    blocked_by_csv = graph_blockers_csv\n                    graph_blocker_detail_json = graph_blockers_json\n                    recovery_strategy = \"Resolve review coverage-graph blockers before stopping.\"\n               c) if STOP is legal AND graph_decision == \"CONTINUE\":\n                    decision = \"CONTINUE\"\n                    stop_blocked = false\n                    reason = \"graph_convergence_continue\"\n               d) else keep the existing STUCK_RECOVERY or CONTINUE outcome\n        outputs:\n          - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n          - reason: \"Human-readable stop reason\"\n          - stop_blocked: \"Boolean true when STOP is vetoed by inline legal-stop gates or graph_decision == STOP_BLOCKED\"\n          - blocked_by_json: \"JSON array of failed legal-stop gates when decision == BLOCKED\"\n          - blocked_by_csv: \"Comma-separated list of failed legal-stop gates when decision == BLOCKED\"\n          - convergence_gate_pass: \"Boolean pass/fail for convergenceGate\"\n          - convergence_gate_score: \"Numeric score recorded for convergenceGate\"\n          - dimension_coverage_gate_pass: \"Boolean pass/fail for dimensionCoverageGate\"\n          - dimension_coverage_gate_covered_json: \"JSON array of covered review dimensions\"\n          - dimension_coverage_gate_missing_json: \"JSON array of missing review dimensions\"\n          - p0_resolution_gate_pass: \"Boolean pass/fail for p0ResolutionGate\"\n          - active_p0_count: \"Active P0 finding count at stop-check time\"\n          - evidence_density_gate_pass: \"Boolean pass/fail for evidenceDensityGate\"\n          - avg_evidence_per_finding: \"Numeric evidence density for active findings\"\n          - hotspot_saturation_gate_pass: \"Boolean pass/fail for hotspotSaturationGate\"\n          - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n          - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n          - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n          - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n          - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n          - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n          - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n          - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n          - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n          - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n          - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n          - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n          - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n          - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n          - graph_signals_json: \"JSON object returned by graph convergence\"\n          - graph_blockers_json: \"JSON array of graph blockers\"\n          - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n          - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n\n      step_emit_blocked_stop:\n        action: \"Persist blocked-stop evidence whenever the review legal-stop decision tree vetoes STOP\"\n        if_blocked:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"review\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergenceGate\":{\"pass\":{convergence_gate_pass},\"score\":{convergence_gate_score}},\"dimensionCoverageGate\":{\"pass\":{dimension_coverage_gate_pass},\"covered\":{dimension_coverage_gate_covered_json},\"missing\":{dimension_coverage_gate_missing_json}},\"p0ResolutionGate\":{\"pass\":{p0_resolution_gate_pass},\"activeP0\":{active_p0_count}},\"evidenceDensityGate\":{\"pass\":{evidence_density_gate_pass},\"avgEvidencePerFinding\":{avg_evidence_per_finding}},\"hotspotSaturationGate\":{\"pass\":{hotspot_saturation_gate_pass}},\"claimAdjudicationGate\":{\"pass\":{claim_adjudication_gate_pass},\"activeP0P1\":{claim_adjudication_active_count}},\"fixCompletenessReplayGate\":{\"pass\":{fix_completeness_replay_gate_pass},\"securitySensitive\":{security_sensitive_fix_scope},\"requiredRows\":{fix_completeness_replay_required_rows},\"passingRows\":{fix_completeness_replay_passing_rows}},\"candidateCoverageGate\":{\"pass\":{candidate_coverage_gate_pass},\"searchDebt\":{candidate_coverage_search_debt_json},\"missing\":{candidate_coverage_missing_json}},\"graphlessFallbackGate\":{\"pass\":{graphless_fallback_gate_pass},\"mode\":\"{graphless_fallback_mode}\",\"missing\":{graphless_fallback_missing_json},\"unavailabilityReason\":\"{graphless_fallback_unavailability_reason}\"}},\"graphBlockerDetail\":{graph_blockers_json},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          log: \"Blocked STOP persisted for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n        if_not_blocked:\n          proceed: true\n\n      step_handle_convergence:\n        action: \"Act on convergence decision\"\n        if_stop:\n          branch_on: \"convergence_mode == 'divergent' AND reason == 'all_dimensions_clean'\"\n          if_divergent_eligible:\n            eligibility_contract:\n              required_decision: \"STOP\"\n              eligible_reasons: [all_dimensions_clean]\n              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n              fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n            steps:\n              step_prepare_divergent_pivot:\n                action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import {\n                    buildReviewPivotPreparationInput,\n                    renderReviewPivotSeatPrompt,\n                  } from './.opencode/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildReviewPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.findings_registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,\n                        renderReviewPivotSeatPrompt(seat, prepared.dispatchContext),\n                      ]))\n                    : {};\n                  process.stdout.write(`${JSON.stringify({\n                    ...prepared,\n                    seatPrompts,\n                    boundaryRejections: input.boundaryRejections,\n                  })}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_prepare_json: \"The complete parsed JSON result\"\n                  - pivot_prepare_status: \"status from the prepare result\"\n                  - pivot_id: \"pivotId from the prepare result\"\n                  - pivot_paths_json: \"paths from the prepare result as JSON\"\n                  - pivot_resumed: \"resumed from the prepare result\"\n                  - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n                  - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n                  - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n                  - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n                  - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n                  - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n                  - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n                  - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n                short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n\n              step_dispatch_pivot_seat_001:\n                action: \"Natively dispatch the analytical read-only review direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-review\n                    model: opus\n                    context_source: \"pivot_seat_001_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n                outputs:\n                  - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_001_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_001:\n                action: \"Durably record the seat-001 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_001_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_002:\n                action: \"Natively dispatch the critical read-only review direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-review\n                    model: opus\n                    context_source: \"pivot_seat_002_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n                outputs:\n                  - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_002_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_002:\n                action: \"Durably record the seat-002 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_002_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_003:\n                action: \"Natively dispatch the pragmatic read-only review direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-review\n                    model: opus\n                    context_source: \"pivot_seat_003_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n                outputs:\n                  - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_003_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_003:\n                action: \"Durably record the seat-003 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_003_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_finalize_divergent_pivot:\n                action: \"Finalize the prepared pivot after all missing native seats are durable\"\n                skip_when: \"pivot_prepare_status != 'pending'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_finalize_json: \"The complete parsed final result\"\n\n              step_resolve_divergent_pivot_result:\n                action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n                branch_on: \"pivot_prepare_status\"\n                if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n                if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n\n              step_apply_divergent_pivot_result:\n                action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n                branch_on: \"pivot_result.status\"\n                if_completed:\n                  set:\n                    next_dimension: \"{pivot_result.restoredFocus}\"\n                    pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n                    saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n                  command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n                  log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n                  proceed_to: step_normalize_pause_events\n                if_failed:\n                  log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n                  skip_to: phase_synthesis\n            on_error:\n              log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n              skip_to: phase_synthesis\n          if_existing_terminal_path:\n            log: \"Loop stopping. Reason: {reason}\"\n            skip_to: phase_synthesis\n        if_blocked:\n          log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n        if_stuck_recovery:\n          log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n          recovery_strategies:\n            - \"Change granularity: file-level → function-level → line-level review\"\n            - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n            - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n          pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n          set:\n            next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n            pending_stop_event: \"stuck_recovery\"\n            pending_stop_reason: \"stuckRecovery\"\n            pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n          reset: { stuck_count: 0 }\n        if_continue:\n          log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n\n      step_normalize_pause_events:\n        action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused\"\n        if_pending_pause_event:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"review\",\"stopReason\":\"userPaused\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n          reset:\n            pending_stop_event: null\n            pending_stop_reason: null\n            pending_stop_detail: null\n          halt: true\n        if_pending_stuck_recovery:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"review\",\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"strategy\":\"{recovery_strategy}\",\"targetDimension\":\"{least_explored}\",\"outcome\":\"pending\",\"reason\":\"{pending_stop_detail}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n          reset:\n            pending_stop_event: null\n            pending_stop_reason: null\n            pending_stop_detail: null\n        if_no_pending_event:\n          proceed: true\n\n      step_generate_state_summary:\n        action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n        generate: |\n          STATE SUMMARY (auto-generated):\n          Iteration: {current_iteration} of {max_iterations}\n          Dimension: {next_dimension}\n          Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n          Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n          Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n          {resource_map_prompt_line}\n          Coverage Age: {coverage_age}\n          Last 2 ratios: {ratio_prev} -> {ratio_latest}\n          Stuck count: {stuck_count}\n          Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n\n      step_marker_scan:\n        action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n        algorithm: |\n          if current_iteration > 1:\n            PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n            if file_exists(PREV_PROMPT_PATH):\n              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n              if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n                log \"ERROR: nested review-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n                halt with exit code 2\n        note: |\n          False-positive prevention: only matches when the first line is exactly one of the\n          three canonical markers. Markers appearing in comments or body text are ignored.\n          True-positive triggers only when a previous iteration's rendered prompt literally\n          starts with a deep-loop marker, indicating a nested review-of-review dispatch.\n\n      step_dispatch_iteration:\n        action: \"Dispatch @deep-review agent for one review iteration\"\n        resolve_executor:\n          source: \"config.executor\"\n          loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n        pre_dispatch:\n          generate_summary: |\n            STATE SUMMARY (auto-generated):\n            Iteration: {current_iteration} of {max_iterations}\n            Dimension: {next_dimension}\n            Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n            Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n            Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n            {resource_map_prompt_line}\n            Coverage Age: {coverage_age}\n            Last 2 ratios: {ratio_prev} -> {ratio_latest}\n            Stuck count: {stuck_count}\n            Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n          render_prompt_pack:\n            template_path: \".opencode/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n            renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n            output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n            variables:\n              state_summary: \"{state_summary}\"\n              current_iteration: \"{current_iteration}\"\n              max_iterations: \"{max_iterations}\"\n              next_dimension: \"{next_dimension}\"\n              review_target: \"{review_target}\"\n              review_scope_files: \"{review_scope_files}\"\n              p0_count: \"{p0_count}\"\n              p1_count: \"{p1_count}\"\n              p2_count: \"{p2_count}\"\n              pivot_lineage: \"{pivot_lineage}\"\n              saturated_directions: \"{saturated_directions}\"\n              state_paths_config: \"{state_paths.config}\"\n              state_paths_state_log: \"{state_paths.state_log}\"\n              state_paths_findings_registry: \"{state_paths.findings_registry}\"\n              state_paths_strategy: \"{state_paths.strategy}\"\n              state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n              state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n        pre_dispatch_audit:\n          skip_when: \"config.executor.kind == 'native'\"\n          call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n          args:\n            stateLogPath: \"{state_paths.state_log}\"\n            executor: \"{config.executor}\"\n            iteration: \"{current_iteration}\"\n        branch_on: \"config.executor.kind\"\n        if_native:\n          dispatch:\n            agent: deep-review\n            model: opus\n            context_source: \"rendered_prompt_pack\"\n          wait_for_completion: true\n        if_cli_copilot:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync, writeFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { buildCopilotPromptArg } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n\n            const promptPath = '{state_paths.prompt_dir}/iteration-{current_iteration}.md';\n            const prompt = readFileSync(promptPath, 'utf8');\n\n            // Workflow-resolved spec folder is the only legal write authority.\n            // The helper (`validateSpecFolder` inside `buildCopilotPromptArg`)\n            // is the single source of truth for rejecting empty / unresolved\n            // template / whitespace-only / string-coerced empty values. The\n            // YAML hands the raw `{spec_folder}` directly; on rejection the\n            // helper safe-fails to `type:\"missing\", writeIntent:true` (Gate-3\n            // enforcement, --allow-all-tools stripped).\n            const specFolderRaw = '{spec_folder}';\n            const targetAuthority = { type: 'approved', specFolder: specFolderRaw };\n\n            const baseArgs = [\n              '-p',\n              prompt,\n              '--model',\n              '{config.executor.model}',\n              '--allow-all-tools',\n              '--no-ask-user',\n            ];\n\n            const built = buildCopilotPromptArg({\n              promptPath,\n              prompt,\n              targetAuthority,\n              baseArgv: baseArgs,\n            });\n\n            // Large-prompt @PROMPT_PATH wrapper: helper emits a `promptFileBody`\n            // containing `<TARGET AUTHORITY preamble>\\n\\n---\\n\\n<original>`.\n            // Write it to disk so the file Copilot reads via @path opens with\n            // the authority block. Without this, recovered/bootstrap folder\n            // mentions inside the file could still anchor the model.\n            if (built.promptFileBody !== undefined) {\n              writeFileSync(promptPath, built.promptFileBody, 'utf8');\n            }\n\n            // Copilot is routed through the audited executor wrapper so it produces\n            // INTENT + COMPLETION dispatch receipts alongside claude-code/opencode\n            // There is no cli-copilot kind in the executor schema, so it\n            // dispatches as kind:'native' (full env passthrough, no recursion-guard\n            // layer configured for copilot); the receipt still records the real\n            // 'copilot' command + built.argv as facts.\n            const dispatchFacts = {\n              command: 'deep/review',\n              mode: 'review',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.kind}',\n              branchId: '{config.executor.kind}',\n              sessionId: '{session_id}',\n              generation: Number('{generation}'),\n            };\n            const dispatchId = 'review-i{current_iteration}-g{generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'copilot',\n                args: built.argv,\n                cwd: '{repo_root}',\n                timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n                stateLogPath: '{state_paths.state_log}',\n                executor: {\n                  kind: 'native',\n                  model: '{config.executor.model}',\n                  configDir: null,\n                  reasoningEffort: null,\n                  serviceTier: null,\n                  sandboxMode: null,\n                  timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n                  governor: null,\n                },\n                iteration: Number('{current_iteration}'),\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"Routed through runAuditedExecutorCommand so copilot produces INTENT + COMPLETION dispatch receipts; built.argv (@PROMPT_PATH or positional) is forwarded verbatim as the receipt facts\"\n            - \"copilot has no stdin support; prompt is positional\"\n            - \"Size check uses 16KB threshold; above that uses @PROMPT_PATH wrapper prompt\"\n            - \"Large-prompt path relies on copilot honoring @path references within its prompt string\"\n            - \"buildCopilotPromptArg attaches a TARGET AUTHORITY preamble bound to the workflow-approved spec folder; recovered context cannot override it (authority guard source: .opencode/commands/speckit/assets/speckit_deep-review_auto.yaml)\"\n            - \"If spec_folder is missing/malformed/unresolved on a write-intent dispatch, the helper enforces plan-only by replacing the prompt with a Gate-3 question and stripping --allow-all-tools\"\n            - \"Large-prompt wrapper mode rewrites the prompt file at promptPath to include the TARGET AUTHORITY preamble (prefix + divider + original body); the argv becomes a bare @promptPath reference\"\n        if_cli_claude_code:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n\n            const configDir = '{optional_claude_config_dir}';\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const executor = {\n              kind: 'cli-claude-code',\n              model: '{config.executor.model}',\n              configDir: configDir || null,\n              reasoningEffort,\n              serviceTier: null,\n              sandboxMode: null,\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n            const args = [\n              '-p',\n              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n              '--model',\n              executor.model,\n              '--permission-mode',\n              'acceptEdits',\n              '--output-format',\n              'text',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--effort', executor.reasoningEffort);\n            }\n\n            // CLAUDE_CONFIG_DIR rides through guardContext.env; the CLAUDE_ prefix is\n            // on the cli-claude-code env allowlist so buildExecutorDispatchEnv admits it.\n            const parentEnv = { ...process.env };\n            if (configDir) {\n              parentEnv.CLAUDE_CONFIG_DIR = configDir;\n            }\n\n            const dispatchFacts = {\n              command: 'deep/review',\n              mode: 'review',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.kind}',\n              branchId: '{config.executor.kind}',\n              sessionId: '{session_id}',\n              generation: Number('{generation}'),\n            };\n            const dispatchId = 'review-i{current_iteration}-g{generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'claude',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                guardContext: { env: parentEnv },\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          render_hint:\n            optional_claude_config_dir: |\n              If config.executor.configDir is set and non-null, expand a leading ~ to HOME and bind that path.\n              Otherwise expand to empty string.\n          notes:\n            - \"Routed through runAuditedExecutorCommand so claude-code produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n            - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so account-specific Claude Code routing is preserved\"\n            - \"permission-mode stays acceptEdits (review's existing iteration-write behavior); claude-code has no serviceTier flag\"\n            - \"claude-code supports --effort for reasoning depth\"\n        if_cli_opencode:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { execFileSync } from 'node:child_process';\n            import { appendFileSync, readFileSync, realpathSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n            import { isAbsolute, relative, resolve } from 'node:path';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const executor = {\n              kind: 'cli-opencode',\n              model: '{config.executor.model}',\n              configDir: null,\n              reasoningEffort,\n              serviceTier: null,\n              sandboxMode: null,\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n            if (!promptBody.includes('BANNED OPERATIONS') || !promptBody.includes('ALLOWED WRITE PATHS')) {\n              throw new Error('Unsafe cli-opencode dispatch: rendered prompt is missing required write-containment sections');\n            }\n\n            const repoRoot = realpathSync('{repo_root}');\n            const artifactDir = resolve(repoRoot, '{state_paths.packet_dir}');\n            const artifactRelative = relative(repoRoot, artifactDir);\n            if (artifactRelative === '' || artifactRelative.startsWith('..') || isAbsolute(artifactRelative)) {\n              throw new Error('Unsafe cli-opencode dispatch: artifact directory must be a strict descendant of the worktree root');\n            }\n\n            const git = (args, cwd = repoRoot, trim = true) => {\n              const output = execFileSync('git', args, { cwd, encoding: 'utf8' });\n              return trim ? output.trim() : output;\n            };\n            const resolveGitPath = (candidate) => realpathSync(isAbsolute(candidate) ? candidate : resolve(repoRoot, candidate));\n            const gitDir = resolveGitPath(git(['rev-parse', '--git-dir']));\n            const commonGitDir = resolveGitPath(git(['rev-parse', '--git-common-dir']));\n            if (gitDir === commonGitDir) {\n              throw new Error('Unsafe cli-opencode dispatch: --dir must point at an isolated linked worktree');\n            }\n\n            const primaryBlock = git(['worktree', 'list', '--porcelain'])\n              .split(/\\n\\n+/)\n              .find((block) => /^branch refs\\/heads\\/(?:main|master)$/m.test(block));\n            const primaryLine = primaryBlock?.split('\\n').find((line) => line.startsWith('worktree '));\n            if (!primaryLine) {\n              throw new Error('Unsafe cli-opencode dispatch: primary main/master worktree could not be resolved');\n            }\n            const primaryRoot = realpathSync(primaryLine.slice('worktree '.length));\n            const primaryStatus = git(['status', '--porcelain=v1', '--untracked-files=all'], primaryRoot);\n            if (primaryStatus) {\n              throw new Error('Unsafe cli-opencode dispatch: primary worktree must be clean before unrestricted execution');\n            }\n\n            const dirtyPaths = [\n              ...git(['diff', '--name-only', '-z', 'HEAD', '--'], repoRoot, false).split('\\0'),\n              ...git(['ls-files', '--others', '--exclude-standard', '-z'], repoRoot, false).split('\\0'),\n            ].filter(Boolean);\n            const outsideArtifactDir = dirtyPaths.filter((candidate) => {\n              const candidateRelative = relative(artifactDir, resolve(repoRoot, candidate));\n              return candidateRelative.startsWith('..') || isAbsolute(candidateRelative);\n            });\n            if (outsideArtifactDir.length > 0) {\n              throw new Error(`Unsafe cli-opencode dispatch: worktree changes outside the artifact directory: ${outsideArtifactDir.join(', ')}`);\n            }\n\n            const recoveryBaselineCommit = git(['rev-parse', '--verify', 'HEAD']);\n            appendFileSync(\n              '{state_paths.state_log}',\n              `${JSON.stringify({ type: 'event', event: 'recovery_baseline', mode: 'review', iteration: Number('{current_iteration}'), recoveryBaselineCommit, worktree: repoRoot, timestamp: new Date().toISOString() })}\\n`,\n              'utf8',\n            );\n            const message = 'Resolved route: mode=review; target_agent=@deep-review; execution=single_review_iteration; state_source=externalized_files; do_not_switch_mode=true'\n              + '\\n\\n'\n              + promptBody;\n            const args = [\n              'run',\n              '--model',\n              executor.model,\n              '--format',\n              'json',\n              '--dangerously-skip-permissions',\n              '--pure',\n              '--dir',\n              '{repo_root}',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--variant', executor.reasoningEffort);\n            }\n            args.push(message);\n\n            const dispatchFacts = {\n              command: 'deep/review',\n              mode: 'review',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.kind}',\n              branchId: '{config.executor.kind}',\n              sessionId: '{session_id}',\n              generation: Number('{generation}'),\n            };\n            const dispatchId = 'review-i{current_iteration}-g{generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'opencode',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                // opencode v1.14.39 reads stdin at startup before session creation;\n                // an empty input gives EOF stdin, equivalent to </dev/null.\n                input: '',\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n            - \"Fail closed before dispatch unless the rendered containment sections exist, --dir is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir; append the recovery-baseline commit to state_log\"\n            - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n            - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n            - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n            - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n            - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n        if_cli_codex:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { execFileSync } from 'node:child_process';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // Fail closed: a requested codex executor must dispatch codex or abort,\n            // never silently degrade to another executor. Undetected absence is what\n            // got Codex deprecated before, so the branch exits non-zero when the\n            // binary is missing instead of falling through to a native/other path.\n            let codexAvailable = false;\n            try {\n              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n              codexAvailable = true;\n            } catch {}\n            if (!codexAvailable) {\n              console.error('cli-codex executor unavailable: command -v codex failed');\n              process.exit(1);\n            }\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const executor = {\n              kind: 'cli-codex',\n              model,\n              configDir: null,\n              reasoningEffort,\n              serviceTier,\n              sandboxMode: 'workspace-write',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n\n            // codex reads the iteration prompt from stdin via the trailing '-'. A review\n            // iteration must WRITE its own iteration file, delta and state record, so the\n            // sandbox is workspace-write — read-only would block those required writes.\n            // approval_policy=never keeps the run non-interactive.\n            const args = ['exec'];\n            if (model) {\n              args.push('--model', model);\n            }\n            args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n            if (serviceTier) {\n              args.push('-c', 'service_tier=' + serviceTier);\n            }\n            args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n\n            const dispatchId = 'review-i{current_iteration}-g{generation}';\n            const repoRoot = '{repo_root}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command: 'codex',\n              args,\n              cwd: repoRoot,\n              timeoutSeconds: executor.timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input: promptBody,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            // Structural write-containment: a workspace-write codex leaf can write\n            // anywhere in the repo. Revert any NEW out-of-artifact-dir change it\n            // made, append a containment_violation event to the state log, and\n            // fail the iteration fail-closed. The leaf's own writes under\n            // artifactDir (iteration file/delta/state record) are never flagged.\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment violation: reverted ' + containment.violations.length\n                  + ' out-of-scope path(s): '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n              process.exit(1);\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:","lineStart":647,"lineEnd":1449,"totalLines":1450,"truncated":true}},"title":".opencode/commands/deep/assets/deep-review-auto.yaml","time":{"start":1786561250990,"end":1786561250995}},"id":"prt_ff759454e001a5LPeLxu9aqMMK","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","messageID":"msg_ff75933dd001LPvT14lULC4lNn"}}
