{"type":"tool_use","timestamp":1786561257618,"sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","part":{"type":"tool","tool":"read","callID":"call_00_YbjutRvPCL3MGyfoSXob2421","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/commands/deep/assets/deep-review-auto.yaml","offset":1450},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/commands/deep/assets/deep-review-auto.yaml</path>\n<type>file</type>\n<content>\n1450:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1451:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1452:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1453:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1454:         post_dispatch_validate:\n1455:           validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1456:           command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1457:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|iteration_verdict_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1458:           assert_exists: \"{state_paths.iteration_pattern}\"\n1459:           assert_appended: \"{state_paths.state_log}\"\n1460:           assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n1461:           route_proof:\n1462:             mode: review\n1463:             target_agent: deep-review\n1464:             agent_definition_loaded: true\n1465:             resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n1466:           dispatchReceipt:\n1467:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1468:             dispatchId: \"review-i{current_iteration}-g{generation}\"\n1469:           assert_canonical_type: \"iteration\"\n1470:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1471:           assert_delta_file_has_iteration_record: true\n1472:           failure_reasons:\n1473:             - iteration_file_missing\n1474:             - iteration_file_empty\n1475:             - jsonl_not_appended\n1476:             - jsonl_missing_fields\n1477:             - jsonl_parse_error\n1478:             - jsonl_wrong_type\n1479:             - delta_file_missing\n1480:             - delta_file_empty\n1481:             - delta_file_missing_iteration_record\n1482:             - executor_missing\n1483:             - dispatch_failure_logged\n1484:             - v2_missing_ledger\n1485:             - v2_uncited_ledger_row\n1486:             - v2_broken_linked_finding\n1487:             - v2_shallow_finding_details\n1488:             - delta_iteration_id_mismatch\n1489:             - state_delta_iteration_mismatch\n1490:             - route_proof_missing\n1491:             - route_proof_mismatch\n1492:           warning_surface:\n1493:             source: \"result.warnings\"\n1494:             action: \"emit schema_advisory canonical conflict event\"\n1495:             severity: \"advisory\"\n1496:             event_shape: '{\"type\":\"event\",\"event\":\"schema_advisory\",\"mode\":\"review\",\"iteration\":{current_iteration},\"warnings\":{result.warnings},\"severity\":\"advisory\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1497:             note: \"Warnings do not fail dispatch. Hard failures still emit schema_mismatch through on_failure.\"\n1498:           on_failure:\n1499:             action: \"emit schema_mismatch canonical conflict event\"\n1500:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error (per step_evaluate_results.on_missing_outputs) and continue. Never re-dispatch a given iteration more than once.\"\n1501:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n1502:         record_executor_audit:\n1503:           skip_when: \"config.executor.kind == 'native'\"\n1504:           target: \"{state_paths.state_log}\"\n1505:           field: \"executor\"\n1506:           value:\n1507:             kind: \"{config.executor.kind}\"\n1508:             model: \"{config.executor.model}\"\n1509:             reasoningEffort: \"{config.executor.reasoningEffort}\"\n1510:             serviceTier: \"{config.executor.serviceTier}\"\n1511: \n1512:       step_evaluate_results:\n1513:         action: \"Verify iteration outputs and extract metrics\"\n1514:         verify:\n1515:           - file_exists: \"{state_paths.iteration_pattern}\"\n1516:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1517:           - strategy_updated: \"Strategy.md has been modified\"\n1518:         extract:\n1519:           - newFindingsRatio: \"From latest JSONL iteration record\"\n1520:           - findings_count: \"From latest JSONL iteration record\"\n1521:           - severity_counts: \"From latest JSONL iteration record (P0, P1, P2)\"\n1522:           - dimensions: \"From latest JSONL iteration record\"\n1523:           - files_reviewed: \"From latest JSONL iteration record\"\n1524:           - status: \"From latest JSONL iteration record\"\n1525:           - reviewed_artifacts: \"From latest JSONL iteration record\"\n1526:           - traceability_checks: \"From latest JSONL iteration record when present\"\n1527:         on_missing_outputs:\n1528:           action: \"Mark iteration as 'error', continue to next\"\n1529:           # Canonical iteration record: include sessionId, generation, durationMs so the reducer can persist\n1530:           # the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1531:           command: |\n1532:             cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}\n1533:             {\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"review\",\"status\":\"error\",\"focus\":\"{next_dimension}\",\"dimensions\":[\"{next_dimension}\"],\"filesReviewed\":[],\"findingsCount\":0,\"findingsSummary\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingsNew\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingDetails\":[],\"traceabilityChecks\":{\"summary\":{\"required\":0,\"executed\":0,\"pass\":0,\"partial\":0,\"fail\":0,\"blocked\":0,\"notApplicable\":0,\"gatingFailures\":0},\"results\":[]},\"newFindingsRatio\":0.0,\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation},\"lineageMode\":\"{config.lineage.lineageMode}\"}\n1534:             DEEP_LOOP_STATE_RECORD\n1535: \n1536:       step_post_iteration_claim_adjudication:\n1537:         action: \"Validate typed claim-adjudication packets for any new P0/P1 findings and persist the result to state.jsonl so the next iteration's claimAdjudicationGate can read it\"\n1538:         verify:\n1539:           - typed_packets_present: \"Every new P0/P1 finding in review/iterations/iteration-{NNN}.md contains a claim-adjudication JSON block\"\n1540:           - packet_fields: \"Each packet includes claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger\"\n1541:           - missing_packet_ids: \"List of new P0/P1 finding IDs that are missing a typed packet or field; empty array when all packets validate\"\n1542:         on_pass:\n1543:           set:\n1544:             claim_adjudication_passed: true\n1545:           # Append via the deterministic stdin helper, never an edit/patch tool:\n1546:           # the state log holds multi-KB single-line records that a context-matched\n1547:           # apply_patch cannot anchor on (it halts the loop). See append-state-record.cjs.\n1548:           command: |\n1549:             cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}\n1550:             {\"type\":\"event\",\"event\":\"claim_adjudication\",\"mode\":\"review\",\"run\":{current_iteration},\"passed\":true,\"activeP0P1\":{active_p0_p1_count},\"missingPackets\":[],\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}\n1551:             DEEP_LOOP_STATE_RECORD\n1552:           log: \"Claim adjudication passed for iteration {current_iteration}. All new P0/P1 findings have typed packets.\"\n1553:         on_fail:\n1554:           action: \"Mark the iteration as invalid for convergence. The next iteration's claimAdjudicationGate (step_check_convergence step 0) reads the persisted `passed: false` event and vetoes STOP until a follow-up iteration rewrites the packets.\"\n1555:           set:\n1556:             claim_adjudication_passed: false\n1557:           command: |\n1558:             cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}\n1559:             {\"type\":\"event\",\"event\":\"claim_adjudication\",\"mode\":\"review\",\"run\":{current_iteration},\"passed\":false,\"activeP0P1\":{active_p0_p1_count},\"missingPackets\":{missing_packet_ids},\"reason\":\"Missing typed packet fields for new P0/P1 findings\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}\n1560:             DEEP_LOOP_STATE_RECORD\n1561:           log: \"Claim adjudication incomplete for new P0/P1 findings. Event persisted. The next iteration's step_check_convergence claim-adjudication pre-check will veto STOP while `passed: false` remains the latest event and active P0/P1 > 0.\"\n1562: \n1563:       step_reduce_review_state:\n1564:         action: \"Run reducer to refresh the canonical findings registry before dashboard generation\"\n1565:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1566:         read:\n1567:           - \"{state_paths.state_log}\"\n1568:           - \"{state_paths.iteration_pattern}\"\n1569:           - \"{state_paths.findings_registry}\"\n1570:           - \"{state_paths.strategy}\"\n1571:         write:\n1572:           - \"{state_paths.findings_registry}\"\n1573:           - \"{state_paths.dashboard}\"\n1574:           - \"{state_paths.strategy}\"\n1575:         failure_modes:\n1576:           malformed_delta: \"skip + warn\"\n1577:           missing_iteration_file: \"no-op + error\"\n1578:           schema_mismatch: \"reject + conflict event\"\n1579:         guarantee: \"Idempotent for identical inputs\"\n1580:         note: \"Reducer outputs findingsRegistry, dashboardMetrics, and strategyUpdates. Re-running the same inputs must be idempotent.\"\n1581: \n1582:       step_graph_upsert:\n1583:         action: \"Project canonical review coverage plus optional graphEvents into graph nodes and edges, then upsert it\"\n1584:         read:\n1585:           - \"{state_paths.config}\"\n1586:           - \"{state_paths.state_log}\"\n1587:           - \"{state_paths.findings_registry}\"\n1588:         transform: |\n1589:           1. Read the latest iteration JSONL record after reducer completion.\n1590:           2. Seed one stable DIMENSION node for every configured review dimension, falling back to correctness, security, traceability, and maintainability.\n1591:           3. Seed one stable FILE node for every latest-record filesReviewed entry and emit a COVERS edge from each latest-record dimension to each reviewed file.\n1592:           4. Merge optional graphEvents nodes after normalizing type = uppercase(event.kind || event.nodeKind || event.type); keep only DIMENSION, FILE, FINDING, EVIDENCE, REMEDIATION, BUG_CLASS, INVARIANT, PRODUCER, CONSUMER, TEST.\n1593:           5. Merge optional graphEvents edges after normalizing relation = uppercase(event.relation); keep only COVERS, EVIDENCE_FOR, CONTRADICTS, RESOLVES, CONFIRMS, ESCALATES, IN_DIMENSION, IN_FILE.\n1594:           6. Emit nodes as { id, type, name, iteration, metadata } and edges as { id, relation, sourceId, targetId, metadata }, deduplicated by id.\n1595:           7. Discard malformed or unknown optional events without discarding canonical dimension and file coverage.\n1596:         bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{session_id}\\\" --nodes '{graph_nodes_json}' --edges '{graph_edges_json}'\"\n1597:         note: \"Invoke the runtime script directly. Canonical iteration fields provide baseline coverage; graphEvents add richer evidence.\"\n1598:         outputs:\n1599:           - graph_nodes_json: \"JSON array of canonical and optional review graph nodes\"\n1600:           - graph_edges_json: \"JSON array of canonical and optional review graph edges\"\n1601: \n1602:       step_generate_dashboard:\n1603:         action: \"Generate or refresh the review dashboard\"\n1604:         read:\n1605:           - \"{state_paths.state_log}\"\n1606:           - \"{state_paths.findings_registry}\"\n1607:           - \"{state_paths.strategy}\"\n1608:         content: |\n1609:           # Deep Review Dashboard - Session Overview\n1610: \n1611:           Auto-generated from JSONL state log and strategy file. Regenerated after every iteration evaluation.\n1612: \n1613:           ## Status\n1614:           - Review Target: {review_target} ({review_target_type})\n1615:           - Status: [ITERATING | CONVERGING | STUCK_RECOVERY | COMPLETE]\n1616:           - Iteration: {current_iteration} of {max_iterations}\n1617:           - Provisional Verdict: [PASS | CONDITIONAL | FAIL | PENDING]\n1618:           - hasAdvisories: {has_advisories}\n1619: \n1620:           ## Findings Summary\n1621:           | Severity | Count | Trend |\n1622:           |----------|------:|-------|\n1623:           | P0 (Blockers) | {p0_count} | {p0_trend} |\n1624:           | P1 (Required) | {p1_count} | {p1_trend} |\n1625:           | P2 (Suggestions) | {p2_count} | {p2_trend} |\n1626: \n1627:           ## Dimension Coverage\n1628:           | Dimension | Status | Iteration | Findings |\n1629:           |-----------|--------|-----------|----------|\n1630:           | [per dimension from strategy + JSONL] |\n1631: \n1632:           ## Traceability Coverage\n1633:           | Protocol | Level | Status | Findings |\n1634:           |----------|-------|--------|----------|\n1635:           | [per protocol from traceabilityChecks] |\n1636: \n1637:           ## Progress\n1638:           | # | Dimension | Ratio | P0/P1/P2 | Status |\n1639:           |---|-----------|-------|----------|--------|\n1640:           | [per iteration from JSONL] |\n1641: \n1642:           ## Trend\n1643:           - Last 3 ratios: [{ratios}] [{trend}]\n1644:           - Stuck count: {stuck_count}\n1645:           - Gate violations: {guard_violations}\n1646: \n1647:           ## Next Focus\n1648:           {next_dimension}\n1649:         output: \"{state_paths.dashboard}\"\n1650:         note: \"Auto-generated from JSONL + strategy. Never manually edited.\"\n1651: \n1652:       step_update_tracking:\n1653:         action: \"Update loop tracking variables\"\n1654:         set:\n1655:           current_iteration: \"{current_iteration + 1}\"\n1656:           p0_count: \"Accumulate from severity_counts\"\n1657:           p1_count: \"Accumulate from severity_counts\"\n1658:           p2_count: \"Accumulate from severity_counts\"\n1659:           stuck_count: |\n1660:             if status == 'thought': unchanged (skip)\n1661:             if status == 'insight': 0 (reset)\n1662:             if newFindingsRatio <= 0.05: stuck_count + 1\n1663:             else: 0\n1664:         log: \"Iteration {N} complete. Dimensions: {dimensions}. newFindingsRatio: {newFindingsRatio}. Findings: P0={severity_counts.P0} P1={severity_counts.P1} P2={severity_counts.P2}. Stuck count: {stuck_count}.\"\n1665: \n1666:       step_loop_decision:\n1667:         action: \"Return to step_read_state for next iteration\"\n1668:         goto: step_read_state\n1669: \n1670:   # ═══════════════════════════════════════════════════════════════\n1671:   # PHASE 3: SYNTHESIS\n1672:   # ═══════════════════════════════════════════════════════════════\n1673:   phase_synthesis:\n1674:     purpose: Compile all iteration findings into review/review-report.md\n1675:     steps:\n1676: \n1677:       step_fanout_merge:\n1678:         description: \"Merge N lineage registries with strongest-restriction; bind p0/p1/p2 counts for step_derive_verdict; skip when single-executor\"\n1679:         skip_when: \"config.fanout is absent\"\n1680:         command: |\n1681:           node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n1682:             --loop-type review \\\n1683:             --artifact-dir {artifact_dir}\n1684:         working_directory: \"{repo_root}\"\n1685:         wait_for_completion: true\n1686:         bind_from_output:\n1687:           p0_count: \"active_p0\"\n1688:           p1_count: \"active_p1\"\n1689:           p2_count: \"active_p2\"\n1690: \n1691:       step_hydrate_summary_metrics:\n1692:         action: \"Hydrate summary metrics before synthesis\"\n1693:         read:\n1694:           - \"{state_paths.config}\"\n1695:           - \"{state_paths.state_log}\"\n1696:           - \"{state_paths.findings_registry}\"\n1697:           - \"{state_paths.strategy}\"\n1698:         extract:\n1699:           - iteration_count: \"Count lines where type === 'iteration'\"\n1700:           - p0_count: \"Total P0 findings across all iterations (deduped)\"\n1701:           - p1_count: \"Total P1 findings across all iterations (deduped)\"\n1702:           - p2_count: \"Total P2 findings across all iterations (deduped)\"\n1703:           - dimensions_covered: \"List of reviewed dimensions\"\n1704:           - dimension_coverage: \"covered / total\"\n1705:           - ac_coverage_signal: \"For spec-folder targets only: if level is 2+ and checklist.md exists and implementation-summary.md is in-progress or later, surface the AC_COVERAGE advisory status; otherwise mark exempt.\"\n1706:           - last_3_summaries: \"Summarize the latest 3 iteration records\"\n1707:           - reason: \"Use the latest stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n1708: \n1709:       # H-1 verdict derivation: parse findings JSONL, map highest severity to verdict\n1710:       # - PASS: no P0 or P1 findings (P2-only or clean)\n1711:       # - CONDITIONAL: any P1 findings (no P0)\n1712:       # - FAIL: any P0 findings\n1713:       # Final line of iteration-NNN.md MUST be exactly: \"Review verdict: PASS\" / \"Review verdict: CONDITIONAL\" / \"Review verdict: FAIL\"\n1714:       step_derive_verdict:\n1715:         action: \"Derive review verdict from accumulated findings\"\n1716:         algorithm: |\n1717:           if p0_count > 0:\n1718:             verdict = \"FAIL\"\n1719:           elif p1_count > 0:\n1720:             verdict = \"CONDITIONAL\"\n1721:           else:\n1722:             verdict = \"PASS\"\n1723:           has_advisories = (verdict == \"PASS\" and p2_count > 0)\n1724:           ac_coverage_signal is advisory while the validation rule is INFO/default-off; include it in synthesis traceability, but do not change the exact verdict enum from this signal alone.\n1725:         outputs:\n1726:           - verdict: \"PASS | CONDITIONAL | FAIL\"\n1727:           - has_advisories: \"Boolean true when verdict is PASS and any active P2 findings exist\"\n1728:           - ac_coverage_signal: \"exempt | disabled | pass | advisory-shortfall\"\n1729:         contract: |\n1730:           Every iteration-NNN.md must end with exactly: \"Review verdict: PASS\" (or CONDITIONAL or FAIL).\n1731:           Downstream automation parses this final line via exact string match — do not vary the format.\n1732: \n1733:       step_read_all_iterations:\n1734:         action: \"Read all iteration files and strategy\"\n1735:         read_pattern: \"{state_paths.iteration_dir}/iteration-*.md\"\n1736:         read_also: \"{state_paths.strategy}\"\n1737: \n1738:       step_build_finding_registry:\n1739:         action: \"Build deduplicated finding registry from all iterations\"\n1740:         algorithm: |\n1741:           1. Extract all findings from iteration JSONL delta files\n1742:           2. Compute content_hash for each finding (emission requirement):\n1743:              content_hash = sha256(file_path + \"\\u001f\" + line_range + \"\\u001f\" + finding_type + \"\\u001f\" + normalized_description_80chars)\n1744:              Normalized description = whitespace-collapsed, lowercased, first 80 chars of the finding description.\n1745:           3. Two-tier dedup:\n1746:              PRIMARY: group by content_hash field\n1747:                - Same content_hash, multiple dimensions → single finding, merged `dimensions: [<all>]` array\n1748:                - Keep highest severity on duplicates\n1749:              FALLBACK (legacy records lacking content_hash): file:line + normalized_title\n1750:                - Same file:line, multiple dimensions → single finding, multiple dimension tags\n1751:                - Keep highest severity on duplicates\n1752:           4. Track finding lifecycle:\n1753:              - status: active | duplicate | upgraded | downgraded | contested | resolved_false_positive\n1754:              - Record first_seen, upgraded_in, previous_severity for severity changes\n1755:              - Record dimensions array reflecting all dimensions that emitted this finding\n1756:           5. Resolve contradictions:\n1757:              - Findings marked contested across iterations → referee pass\n1758:              - Determine final severity and status\n1759:           6. Count only 'active' findings for totals\n1760:         outputs:\n1761:           - finding_registry: \"Deduplicated list of all findings with metadata\"\n1762:           - active_p0: \"Count of active P0 findings\"\n1763:           - active_p1: \"Count of active P1 findings\"\n1764:           - active_p2: \"Count of active P2 findings\"\n1765: \n1766:       step_adversarial_selfcheck:\n1767:         action: \"Final adversarial self-check on all P0 and P1 findings\"\n1768:         algorithm: |\n1769:           For each active P0/P1 finding:\n1770:             1. Hunter: Re-verify finding against source code (re-read file:line)\n1771:             2. Skeptic: Challenge severity — is this really P0/P1? Could it be P2?\n1772:             3. Referee: Final call — confirm, downgrade, or mark false_positive\n1773:           Update finding_registry with adjudicated results.\n1774: \n1775:       step_emit_resource_map:\n1776:         action: \"Emit {state_paths.resource_map_output} from converged review deltas unless config.resource_map.emit is false\"\n1777:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors --emit-resource-map\"\n1778:         read:\n1779:           - \"{state_paths.config}\"\n1780:           - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1781:         write:\n1782:           - \"{state_paths.resource_map_output}\"\n1783:         guarantee: \"Reducer skips cleanly when config.resource_map.emit == false and writes a deterministic resource-map when enabled.\"\n1784: \n1785:       step_resource_map_coverage_gate:\n1786:         action: \"If resource_map_present, compute the Resource Map Coverage Gate synthesis inputs; otherwise preserve the skip note\"\n1787:         note: \"Cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md. Report touched entries, untouched entries split into expected-by-scope vs gap, and implementation paths absent from the map. Findings raised here use category resource-map-coverage with severity calibrated to the gate outcome.\"\n1788: \n1789:       step_compile_review_report:\n1790:         action: \"Compile review/review-report.md with 9 core sections, a conditional Resource Map Coverage Gate section, and an embedded Planning Packet\"\n1791:         instructions: |\n1792:           Create review/review-report.md with the following sections:\n1793: \n1794:           1. **Executive Summary**\n1795:              - Overall verdict: PASS | CONDITIONAL | FAIL\n1796:              - hasAdvisories: true when PASS carries active P2 items\n1797:              - P0/P1/P2 counts (active only)\n1798:              - Review scope summary\n1799: \n1800:           2. **Planning Trigger**\n1801:              - State whether `/speckit:plan` is required\n1802:              - Include a fenced `json` block labeled `Planning Packet`\n1803:              - The packet MUST include: `triggered`, `verdict`, `hasAdvisories`, `activeFindings`, `remediationWorkstreams`, `specSeed`, `planSeed`, `findingClasses`, `affectedSurfacesSeed`, `fixCompletenessRequired`\n1804:              - Build `activeFindings`, `findingClasses`, and `affectedSurfacesSeed` from reducer-owned state plus iteration JSONL `findingDetails`; if a field is missing, mark it `UNKNOWN` instead of inferring it from prose\n1805: \n1806:           3. **Active Finding Registry**\n1807:              - Unified registry for active P0/P1/P2 findings\n1808:              - For each: ID, severity, title, dimension, file:line, evidence, impact, fix recommendation, disposition, findingClass, scopeProof, affectedSurfaceHints\n1809: \n1810:           4. **Remediation Workstreams**\n1811:              - Ordered action groups: P0 first, then P1, with P2 advisories separated\n1812: \n1813:           5. **Spec Seed**\n1814:              - Concrete seed bullets for follow-on spec updates\n1815: \n1816:           6. **Plan Seed**\n1817:              - Concrete starter tasks for `/speckit:plan`\n1818: \n1819:            7. **Traceability Status**\n1820:               - Summarize required core protocols first, then applicable overlay protocols\n1821:               - Include status, evidence, and any unresolved drift per protocol\n1822:               - Include `AC_COVERAGE` status for lifecycle-active spec-folder targets: exempt, disabled, pass, or advisory-shortfall, with covered/total and floor when available\n1823: \n1824:           If `resource_map_present` is true, insert **## Resource Map Coverage Gate** after `Traceability Status` with exactly three bullets:\n1825:              - `Entries touched`: count of resource-map paths that appear in applied reports\n1826:              - `Entries not touched`: paths in resource-map not in implementation, labeled `expected-by-scope` or `gap`\n1827:              - `Implementation paths absent from resource-map`: `target_files` in applied reports not on the map\n1828: \n1829:           8. **Deferred Items**\n1830:              - Advisory-only or backlog-worthy follow-ups that do not block the current verdict\n1831: \n1832:           **Dimension Expansion Map**\n1833:              - Insert `## Dimension Expansion Map` after Deferred Items and before Search Ledger.\n1834:              - Render reducer-owned `divergence.saturatedDirections`, completed pivots, failed pivots, audited overrides, Council artifact references, selected review directions, and remaining frontier.\n1835:              - This section records breadth only. It cannot alter the Executive Summary verdict, hasAdvisories, finding registry, or adversarial self-check results.\n1836: \n1837:           9. **Search Ledger**\n1838:              - Always include this section before the appendix.\n1839:              - Render reducer-owned `searchCoverage`, `candidateCoverage`, `searchDebt`, `ruledOutCandidates`, and `cleanSearchProof`.\n1840:              - If all arrays are empty or absent, include: `*No search-depth state captured (legacy v1 record)*`.\n1841:              - When `searchDebt` is non-empty, state `hasSearchDebt: true` and carry the dashboard verdict as CONDITIONAL unless active P0 findings make it FAIL.\n1842: \n1843:           10. **Audit Appendix**\n1844:              - Convergence summary, coverage summary, ruled-out claims, sources reviewed\n1845:              - Cross-reference appendix MUST be split into `Core Protocols` and `Overlay Protocols`\n1846: \n1847:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-review/references/protocol/loop-protocol.md §Lifecycle Branches`.)\n1848:         output: \"{state_paths.review_output}\"\n1849: \n1850:       step_convergence_report:\n1851:         action: \"Append convergence report to JSONL\"\n1852:         command: |\n1853:           node --input-type=module <<'EOF'\n1854:           import { appendFileSync, existsSync, readFileSync, statSync } from 'node:fs';\n1855: \n1856:           const paths = {\n1857:             stateLog: String.raw`{state_paths.state_log}`,\n1858:             registry: String.raw`{state_paths.findings_registry}`,\n1859:             review: String.raw`{state_paths.review_output}`,\n1860:             dashboard: String.raw`{state_paths.dashboard}`,\n1861:           };\n1862: \n1863:           function hasFile(filePath) {\n1864:             try {\n1865:               return existsSync(filePath) && statSync(filePath).isFile();\n1866:             } catch {\n1867:               return false;\n1868:             }\n1869:           }\n1870: \n1871:           function readJson(filePath) {\n1872:             try {\n1873:               return JSON.parse(readFileSync(filePath, 'utf8'));\n1874:             } catch {\n1875:               return null;\n1876:             }\n1877:           }\n1878: \n1879:           function readJsonl(filePath) {\n1880:             if (!hasFile(filePath)) return { records: [], malformedLines: [] };\n1881:             const records = [];\n1882:             const malformedLines = [];\n1883:             readFileSync(filePath, 'utf8')\n1884:               .split(/\\r?\\n/)\n1885:               .forEach((line, index) => {\n1886:                 const trimmed = line.trim();\n1887:                 if (!trimmed) return;\n1888:                 try {\n1889:                   records.push(JSON.parse(trimmed));\n1890:                 } catch {\n1891:                   malformedLines.push(index + 1);\n1892:                 }\n1893:               });\n1894:             return { records, malformedLines };\n1895:           }\n1896: \n1897:           function countIterationFindings(record) {\n1898:             if (!record || record.type !== 'iteration') return 0;\n1899:             const numeric = Number(record.findingsCount);\n1900:             if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n1901:             if (Array.isArray(record.findingDetails)) return record.findingDetails.length;\n1902:             return 0;\n1903:           }\n1904: \n1905:           function normalizeFindingKey(value) {\n1906:             return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n1907:           }\n1908: \n1909:           function findingKeys(candidate) {\n1910:             if (typeof candidate === 'string') {\n1911:               const key = normalizeFindingKey(candidate);\n1912:               return key ? [key] : [];\n1913:             }\n1914:             if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n1915:             return [...new Set([\n1916:               candidate.id,\n1917:               candidate.findingId,\n1918:               candidate.title,\n1919:               candidate.summary,\n1920:               candidate.text,\n1921:               candidate.finding,\n1922:               candidate.description,\n1923:             ].map(normalizeFindingKey).filter(Boolean))];\n1924:           }\n1925: \n1926:           function collectIterationFindingGroups(record) {\n1927:             if (!record || record.type !== 'iteration' || !Array.isArray(record.findingDetails)) return [];\n1928:             return record.findingDetails\n1929:               .map(findingKeys)\n1930:               .filter((keys) => keys.length > 0);\n1931:           }\n1932: \n1933:           function collectRegistryFindingKeys(registry) {\n1934:             return [registry?.openFindings, registry?.resolvedFindings, registry?.repeatedFindings]\n1935:               .filter(Array.isArray)\n1936:               .flatMap((findings) => findings)\n1937:               .flatMap(findingKeys);\n1938:           }\n1939: \n1940:           function appendEvent(event) {\n1941:             appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n1942:           }\n1943: \n1944:           const registry = readJson(paths.registry);\n1945:           const openCount = Array.isArray(registry?.openFindings) ? registry.openFindings.length : null;\n1946:           const resolvedCount = Array.isArray(registry?.resolvedFindings) ? registry.resolvedFindings.length : 0;\n1947:           const repeatedCount = Array.isArray(registry?.repeatedFindings) ? registry.repeatedFindings.length : 0;\n1948:           const registryFindingCount = openCount === null ? null : openCount + resolvedCount + repeatedCount;\n1949:           const stateLog = readJsonl(paths.stateLog);\n1950:           const stateRecords = stateLog.records;\n1951:           const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n1952:           const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n1953:           const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n1954:           const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n1955:           const identifiableFindingCount = identifiableFindingGroups.length;\n1956:           const missingArtifacts = [\n1957:             ['registry', paths.registry],\n1958:             ['review', paths.review],\n1959:             ['dashboard', paths.dashboard],\n1960:           ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n1961:           const invariantFailures = [];\n1962:           if (stateLog.malformedLines.length > 0) invariantFailures.push('state_jsonl_parse_failure');\n1963:           if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n1964:           if (registryFindingCount === null) invariantFailures.push('registry_missing_openFindings');\n1965:           if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n1966:           if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n1967:           if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n1968: \n1969:           if (invariantFailures.length > 0) {\n1970:             appendEvent({\n1971:               type: 'event',\n1972:               event: 'synthesis_incomplete',\n1973:               mode: 'review',\n1974:               severity: 'warning',\n1975:               totalIterations: Number('{iteration_count}'),\n1976:               activeP0: Number('{active_p0}'),\n1977:               activeP1: Number('{active_p1}'),\n1978:               activeP2: Number('{active_p2}'),\n1979:               dimensionCoverage: Number('{dimension_coverage}'),\n1980:               verdict: '{verdict}',\n1981:               releaseReadinessState: '{release_readiness_state}',\n1982:               stopReason: '{reason}',\n1983:               reason: 'synthesis_artifact_invariant_failed',\n1984:               invariantFailures,\n1985:               missingArtifacts,\n1986:               registryFindingCount,\n1987:               iterationFindingCount,\n1988:               identifiableFindingCount,\n1989:               missingStructuredFindingCount,\n1990:               stateParseFailureCount: stateLog.malformedLines.length,\n1991:               timestamp: '{ISO_8601_NOW}',\n1992:             });\n1993:           } else {\n1994:             appendEvent({\n1995:               type: 'event',\n1996:               event: 'synthesis_complete',\n1997:               mode: 'review',\n1998:               totalIterations: Number('{iteration_count}'),\n1999:               activeP0: Number('{active_p0}'),\n2000:               activeP1: Number('{active_p1}'),\n2001:               activeP2: Number('{active_p2}'),\n2002:               dimensionCoverage: Number('{dimension_coverage}'),\n2003:               verdict: '{verdict}',\n2004:               releaseReadinessState: '{release_readiness_state}',\n2005:               stopReason: '{reason}',\n2006:               timestamp: '{ISO_8601_NOW}',\n2007:             });\n2008:           }\n2009:           EOF\n2010:         note: \"Emit as numeric ratio (e.g., 0.75), not quoted string. Compute: dimensions_covered / total_dimensions.\"\n2011: \n2012:       step_update_config_status:\n2013:         action: \"Mark config as complete\"\n2014:         edit: \"{state_paths.config}\"\n2015:         set_field: { status: \"complete\" }\n2016: \n2017:       step_leave_artifacts_unstaged:\n2018:         action: \"Leave all synthesized artifacts unstaged for explicit operator review\"\n2019:         note: \"Synthesis must not mutate the shared Git index. The operator retains staging and commit authority after reviewing the complete artifact directory.\"\n2020: \n2021:   # ═══════════════════════════════════════════════════════════════\n2022:   # PHASE 4: SAVE\n2023:   # ═══════════════════════════════════════════════════════════════\n2024:   phase_save:\n2025:     purpose: Preserve review context to memory system\n2026:     steps:\n2027: \n2028:       step_compose_save_payload:\n2029:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2030:         output: \"/tmp/save-context-data-<session-id>.json\"\n2031:         requirements:\n2032:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2033:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed review loop.\"\n2034:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2035:         example_payload: |\n2036:           {\n2037:             \"specFolder\": \"{spec_folder}\",\n2038:             \"sessionSummary\": \"Deep review completed; see review/review-report.md for verdict, findings, and workstreams.\",\n2039:             \"observations\": [\"Summarize the active findings, verdict, and remediation guidance.\"],\n2040:             \"recent_context\": [\"Point to the generated review artifacts and next action.\"],\n2041:             \"exchanges\": [],\n2042:             \"toolCalls\": []\n2043:           }\n2044: \n2045:       step_generate_context:\n2046:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2047:         command: \"node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2048:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2049: \n2050:       step_index_memory:\n2051:         action: \"Index the routed canonical spec document with memory_save when immediate MCP visibility is required\"\n2052:         mcp_tool: memory_save\n2053:         invocation: 'memory_save({ filePath: \"[routed-canonical-spec-doc-path]\" })'\n2054:         note: \"Use the actual canonical spec-doc path returned by generate-context.js (decision-record.md, implementation-summary.md, or handover.md); memory_index_scan remains the bulk fallback\"\n2055: \n2056:       step_verify_save:\n2057:         action: \"Verify canonical save routed content into the correct spec document\"\n2058:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2059:         on_fail: \"Log warning but do not block completion\"\n2060: \n2061:       step_release_lock:\n2062:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2063:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n2064:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2065: \n2066:   # ═══════════════════════════════════════════════════════════════\n2067:   # COMPLETION\n2068:   # ═══════════════════════════════════════════════════════════════\n2069:   completion:\n2070:     message: |\n2071:       Deep review complete.\n2072:       Iterations: {iteration_count} | Stop reason: {reason}\n2073:       Findings: P0={active_p0} P1={active_p1} P2={active_p2}\n2074:       Verdict: {verdict} | hasAdvisories={has_advisories}\n2075: \n2076:       Artifacts:\n2077:         - review/review-report.md (compiled from {iteration_count} iterations)\n2078:         - {iteration_count} iteration files in review/iterations/\n2079:         - State files in review/: deep-review-config.json, deep-review-state.jsonl, deep-review-findings-registry.json, deep-review-strategy.md, deep-review-dashboard.md\n2080:         - Memory context saved\n2081: \n2082:       STATUS=OK PATH={spec_folder}\n2083:     next_steps:\n2084:       - \"/speckit:plan [remediation] (if FAIL or CONDITIONAL verdict)\"\n2085:       - \"/create:changelog (if PASS, including PASS with hasAdvisories=true)\"\n2086:       - \"/deep:review [target] (for another review)\"\n2087:       - \"/memory:save {spec_folder} (refresh canonical continuity before the next session)\"\n2088: \n2089: # ─────────────────────────────────────────────────────────────────\n2090: # ERROR RECOVERY\n2091: # ─────────────────────────────────────────────────────────────────\n2092: error_recovery:\n2093:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer files per iteration). If second timeout, mark as 'timeout' and continue.\"\n2094:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2095:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2096:   memory_save_failure: \"Preserve the review packet in review/ as backup. Log warning.\"\n2097: \n2098: # ─────────────────────────────────────────────────────────────────\n2099: # RULES\n2100: # ─────────────────────────────────────────────────────────────────\n2101: rules:\n2102:   ALWAYS:\n2103:     - follow_workflow_phases_in_order\n2104:     - dispatch_deep_review_agent_per_iteration\n2105:     - check_convergence_before_each_iteration\n2106:     - write_all_state_to_files\n2107:     - save_memory_context_after_synthesis\n2108:     - respect_max_iterations_cap\n2109:     - treat_review_target_as_read_only\n2110:     - deduplicate_findings_before_synthesis\n2111:     - run_adversarial_selfcheck_on_p0_p1\n2112:   NEVER:\n2113:     - skip_convergence_check\n2114:     - dispatch_non_leaf_agents\n2115:     - hold_iteration_findings_in_memory_only\n2116:     - modify_config_after_initialization\n2117:     - overwrite_jsonl_state_log\n2118:     - proceed_without_state_file_verification\n2119:     - modify_files_under_review\n2120:     - report_p0_without_file_line_evidence\n2121: \n2122: # ─────────────────────────────────────────────────────────────────\n2123: # REFERENCE-ONLY APPENDIX\n2124: # ─────────────────────────────────────────────────────────────────\n2125: reference_only_appendix:\n2126:   checkpoint_commit:\n2127:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2128:     commands:\n2129:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.findings_registry} {state_paths.strategy} {state_paths.review_output}\"\n2130:       - 'git commit -m \"chore(deep-review): iteration {NNN} complete\"'\n2131:   severity_weights:\n2132:     note: \"Severity weights for newFindingsRatio calculation\"\n2133:     weights:\n2134:       P0: 10.0\n2135:       P1: 5.0\n2136:       P2: 1.0\n2137:     p0_override: \"If ANY new P0 discovered → newFindingsRatio = max(calculated, 0.50). A single new P0 blocks convergence.\"\n2138:     clean_pass: \"If total_findings == 0 (clean pass) → newFindingsRatio = 0.0\"\n2139:   review_dimensions:\n2140:     note: \"All 4 default review dimensions with priority ordering\"\n2141:     dimensions:\n2142:       - { priority: 1, name: \"correctness\", checks: \"Logic, state flow, edge cases, error handling\" }\n2143:       - { priority: 2, name: \"security\", checks: \"Auth, input/output safety, data exposure, permissions\" }\n2144:       - { priority: 3, name: \"traceability\", checks: \"Spec/checklist alignment, cross-reference integrity, evidence coverage\" }\n2145:       - { priority: 4, name: \"maintainability\", checks: \"Patterns, documentation quality, safe follow-on change clarity\" }\n2146:   cross_reference_protocols:\n2147:     note: \"Cross-reference verification protocols split into core and overlay classes\"\n2148:     core_protocols:\n2149:       - { check: \"Spec vs Code\", source: \"spec.md claims\", target: \"implementation\" }\n2150:       - { check: \"Checklist vs Evidence\", source: \"[x] items\", target: \"cited evidence\" }\n2151:     overlay_protocols:\n2152:       - { check: \"SKILL.md vs Agent\", source: \"Skill contracts\", target: \"agent files\" }\n2153:       - { check: \"Agent Cross-Runtime\", source: \".claude\", target: \".opencode/.agents\" }\n2154:       - { check: \"Feature Catalog vs Code\", source: \"Catalog claims\", target: \"implementation\" }\n2155:       - { check: \"Playbook vs Support\", source: \"Scenario preconditions\", target: \"actual support\" }\n\n(End of file - total 2155 lines)\n</content>","metadata":{"preview":"            - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n            - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n            - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n            - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n        post_dispatch_validate:\n          validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n          command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|iteration_verdict_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n          assert_exists: \"{state_paths.iteration_pattern}\"\n          assert_appended: \"{state_paths.state_log}\"\n          assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n          route_proof:\n            mode: review\n            target_agent: deep-review\n            agent_definition_loaded: true\n            resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n          dispatchReceipt:\n            receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n            dispatchId: \"review-i{current_iteration}-g{generation}\"\n          assert_canonical_type: \"iteration\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/commands/deep/assets/deep-review-auto.yaml","text":"            - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n            - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n            - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n            - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n        post_dispatch_validate:\n          validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n          command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|iteration_verdict_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n          assert_exists: \"{state_paths.iteration_pattern}\"\n          assert_appended: \"{state_paths.state_log}\"\n          assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n          route_proof:\n            mode: review\n            target_agent: deep-review\n            agent_definition_loaded: true\n            resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n          dispatchReceipt:\n            receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n            dispatchId: \"review-i{current_iteration}-g{generation}\"\n          assert_canonical_type: \"iteration\"\n          assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n          assert_delta_file_has_iteration_record: true\n          failure_reasons:\n            - iteration_file_missing\n            - iteration_file_empty\n            - jsonl_not_appended\n            - jsonl_missing_fields\n            - jsonl_parse_error\n            - jsonl_wrong_type\n            - delta_file_missing\n            - delta_file_empty\n            - delta_file_missing_iteration_record\n            - executor_missing\n            - dispatch_failure_logged\n            - v2_missing_ledger\n            - v2_uncited_ledger_row\n            - v2_broken_linked_finding\n            - v2_shallow_finding_details\n            - delta_iteration_id_mismatch\n            - state_delta_iteration_mismatch\n            - route_proof_missing\n            - route_proof_mismatch\n          warning_surface:\n            source: \"result.warnings\"\n            action: \"emit schema_advisory canonical conflict event\"\n            severity: \"advisory\"\n            event_shape: '{\"type\":\"event\",\"event\":\"schema_advisory\",\"mode\":\"review\",\"iteration\":{current_iteration},\"warnings\":{result.warnings},\"severity\":\"advisory\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n            note: \"Warnings do not fail dispatch. Hard failures still emit schema_mismatch through on_failure.\"\n          on_failure:\n            action: \"emit schema_mismatch canonical conflict event\"\n            redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error (per step_evaluate_results.on_missing_outputs) and continue. Never re-dispatch a given iteration more than once.\"\n            escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n        record_executor_audit:\n          skip_when: \"config.executor.kind == 'native'\"\n          target: \"{state_paths.state_log}\"\n          field: \"executor\"\n          value:\n            kind: \"{config.executor.kind}\"\n            model: \"{config.executor.model}\"\n            reasoningEffort: \"{config.executor.reasoningEffort}\"\n            serviceTier: \"{config.executor.serviceTier}\"\n\n      step_evaluate_results:\n        action: \"Verify iteration outputs and extract metrics\"\n        verify:\n          - file_exists: \"{state_paths.iteration_pattern}\"\n          - jsonl_appended: \"New iteration record in state.jsonl\"\n          - strategy_updated: \"Strategy.md has been modified\"\n        extract:\n          - newFindingsRatio: \"From latest JSONL iteration record\"\n          - findings_count: \"From latest JSONL iteration record\"\n          - severity_counts: \"From latest JSONL iteration record (P0, P1, P2)\"\n          - dimensions: \"From latest JSONL iteration record\"\n          - files_reviewed: \"From latest JSONL iteration record\"\n          - status: \"From latest JSONL iteration record\"\n          - reviewed_artifacts: \"From latest JSONL iteration record\"\n          - traceability_checks: \"From latest JSONL iteration record when present\"\n        on_missing_outputs:\n          action: \"Mark iteration as 'error', continue to next\"\n          # Canonical iteration record: include sessionId, generation, durationMs so the reducer can persist\n          # the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n          command: |\n            cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}\n            {\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"review\",\"status\":\"error\",\"focus\":\"{next_dimension}\",\"dimensions\":[\"{next_dimension}\"],\"filesReviewed\":[],\"findingsCount\":0,\"findingsSummary\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingsNew\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingDetails\":[],\"traceabilityChecks\":{\"summary\":{\"required\":0,\"executed\":0,\"pass\":0,\"partial\":0,\"fail\":0,\"blocked\":0,\"notApplicable\":0,\"gatingFailures\":0},\"results\":[]},\"newFindingsRatio\":0.0,\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation},\"lineageMode\":\"{config.lineage.lineageMode}\"}\n            DEEP_LOOP_STATE_RECORD\n\n      step_post_iteration_claim_adjudication:\n        action: \"Validate typed claim-adjudication packets for any new P0/P1 findings and persist the result to state.jsonl so the next iteration's claimAdjudicationGate can read it\"\n        verify:\n          - typed_packets_present: \"Every new P0/P1 finding in review/iterations/iteration-{NNN}.md contains a claim-adjudication JSON block\"\n          - packet_fields: \"Each packet includes claim, evidenceRefs, counterevidenceSought, alternativeExplanation, finalSeverity, confidence, downgradeTrigger\"\n          - missing_packet_ids: \"List of new P0/P1 finding IDs that are missing a typed packet or field; empty array when all packets validate\"\n        on_pass:\n          set:\n            claim_adjudication_passed: true\n          # Append via the deterministic stdin helper, never an edit/patch tool:\n          # the state log holds multi-KB single-line records that a context-matched\n          # apply_patch cannot anchor on (it halts the loop). See append-state-record.cjs.\n          command: |\n            cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}\n            {\"type\":\"event\",\"event\":\"claim_adjudication\",\"mode\":\"review\",\"run\":{current_iteration},\"passed\":true,\"activeP0P1\":{active_p0_p1_count},\"missingPackets\":[],\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}\n            DEEP_LOOP_STATE_RECORD\n          log: \"Claim adjudication passed for iteration {current_iteration}. All new P0/P1 findings have typed packets.\"\n        on_fail:\n          action: \"Mark the iteration as invalid for convergence. The next iteration's claimAdjudicationGate (step_check_convergence step 0) reads the persisted `passed: false` event and vetoes STOP until a follow-up iteration rewrites the packets.\"\n          set:\n            claim_adjudication_passed: false\n          command: |\n            cat <<'DEEP_LOOP_STATE_RECORD' | node .opencode/skills/system-deep-loop/runtime/scripts/append-state-record.cjs {state_paths.state_log}\n            {\"type\":\"event\",\"event\":\"claim_adjudication\",\"mode\":\"review\",\"run\":{current_iteration},\"passed\":false,\"activeP0P1\":{active_p0_p1_count},\"missingPackets\":{missing_packet_ids},\"reason\":\"Missing typed packet fields for new P0/P1 findings\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}\n            DEEP_LOOP_STATE_RECORD\n          log: \"Claim adjudication incomplete for new P0/P1 findings. Event persisted. The next iteration's step_check_convergence claim-adjudication pre-check will veto STOP while `passed: false` remains the latest event and active P0/P1 > 0.\"\n\n      step_reduce_review_state:\n        action: \"Run reducer to refresh the canonical findings registry before dashboard generation\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.iteration_pattern}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n        write:\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.dashboard}\"\n          - \"{state_paths.strategy}\"\n        failure_modes:\n          malformed_delta: \"skip + warn\"\n          missing_iteration_file: \"no-op + error\"\n          schema_mismatch: \"reject + conflict event\"\n        guarantee: \"Idempotent for identical inputs\"\n        note: \"Reducer outputs findingsRegistry, dashboardMetrics, and strategyUpdates. Re-running the same inputs must be idempotent.\"\n\n      step_graph_upsert:\n        action: \"Project canonical review coverage plus optional graphEvents into graph nodes and edges, then upsert it\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n        transform: |\n          1. Read the latest iteration JSONL record after reducer completion.\n          2. Seed one stable DIMENSION node for every configured review dimension, falling back to correctness, security, traceability, and maintainability.\n          3. Seed one stable FILE node for every latest-record filesReviewed entry and emit a COVERS edge from each latest-record dimension to each reviewed file.\n          4. Merge optional graphEvents nodes after normalizing type = uppercase(event.kind || event.nodeKind || event.type); keep only DIMENSION, FILE, FINDING, EVIDENCE, REMEDIATION, BUG_CLASS, INVARIANT, PRODUCER, CONSUMER, TEST.\n          5. Merge optional graphEvents edges after normalizing relation = uppercase(event.relation); keep only COVERS, EVIDENCE_FOR, CONTRADICTS, RESOLVES, CONFIRMS, ESCALATES, IN_DIMENSION, IN_FILE.\n          6. Emit nodes as { id, type, name, iteration, metadata } and edges as { id, relation, sourceId, targetId, metadata }, deduplicated by id.\n          7. Discard malformed or unknown optional events without discarding canonical dimension and file coverage.\n        bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"review\\\" --session-id \\\"{session_id}\\\" --nodes '{graph_nodes_json}' --edges '{graph_edges_json}'\"\n        note: \"Invoke the runtime script directly. Canonical iteration fields provide baseline coverage; graphEvents add richer evidence.\"\n        outputs:\n          - graph_nodes_json: \"JSON array of canonical and optional review graph nodes\"\n          - graph_edges_json: \"JSON array of canonical and optional review graph edges\"\n\n      step_generate_dashboard:\n        action: \"Generate or refresh the review dashboard\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n        content: |\n          # Deep Review Dashboard - Session Overview\n\n          Auto-generated from JSONL state log and strategy file. Regenerated after every iteration evaluation.\n\n          ## Status\n          - Review Target: {review_target} ({review_target_type})\n          - Status: [ITERATING | CONVERGING | STUCK_RECOVERY | COMPLETE]\n          - Iteration: {current_iteration} of {max_iterations}\n          - Provisional Verdict: [PASS | CONDITIONAL | FAIL | PENDING]\n          - hasAdvisories: {has_advisories}\n\n          ## Findings Summary\n          | Severity | Count | Trend |\n          |----------|------:|-------|\n          | P0 (Blockers) | {p0_count} | {p0_trend} |\n          | P1 (Required) | {p1_count} | {p1_trend} |\n          | P2 (Suggestions) | {p2_count} | {p2_trend} |\n\n          ## Dimension Coverage\n          | Dimension | Status | Iteration | Findings |\n          |-----------|--------|-----------|----------|\n          | [per dimension from strategy + JSONL] |\n\n          ## Traceability Coverage\n          | Protocol | Level | Status | Findings |\n          |----------|-------|--------|----------|\n          | [per protocol from traceabilityChecks] |\n\n          ## Progress\n          | # | Dimension | Ratio | P0/P1/P2 | Status |\n          |---|-----------|-------|----------|--------|\n          | [per iteration from JSONL] |\n\n          ## Trend\n          - Last 3 ratios: [{ratios}] [{trend}]\n          - Stuck count: {stuck_count}\n          - Gate violations: {guard_violations}\n\n          ## Next Focus\n          {next_dimension}\n        output: \"{state_paths.dashboard}\"\n        note: \"Auto-generated from JSONL + strategy. Never manually edited.\"\n\n      step_update_tracking:\n        action: \"Update loop tracking variables\"\n        set:\n          current_iteration: \"{current_iteration + 1}\"\n          p0_count: \"Accumulate from severity_counts\"\n          p1_count: \"Accumulate from severity_counts\"\n          p2_count: \"Accumulate from severity_counts\"\n          stuck_count: |\n            if status == 'thought': unchanged (skip)\n            if status == 'insight': 0 (reset)\n            if newFindingsRatio <= 0.05: stuck_count + 1\n            else: 0\n        log: \"Iteration {N} complete. Dimensions: {dimensions}. newFindingsRatio: {newFindingsRatio}. Findings: P0={severity_counts.P0} P1={severity_counts.P1} P2={severity_counts.P2}. Stuck count: {stuck_count}.\"\n\n      step_loop_decision:\n        action: \"Return to step_read_state for next iteration\"\n        goto: step_read_state\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 3: SYNTHESIS\n  # ═══════════════════════════════════════════════════════════════\n  phase_synthesis:\n    purpose: Compile all iteration findings into review/review-report.md\n    steps:\n\n      step_fanout_merge:\n        description: \"Merge N lineage registries with strongest-restriction; bind p0/p1/p2 counts for step_derive_verdict; skip when single-executor\"\n        skip_when: \"config.fanout is absent\"\n        command: |\n          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n            --loop-type review \\\n            --artifact-dir {artifact_dir}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n        bind_from_output:\n          p0_count: \"active_p0\"\n          p1_count: \"active_p1\"\n          p2_count: \"active_p2\"\n\n      step_hydrate_summary_metrics:\n        action: \"Hydrate summary metrics before synthesis\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.findings_registry}\"\n          - \"{state_paths.strategy}\"\n        extract:\n          - iteration_count: \"Count lines where type === 'iteration'\"\n          - p0_count: \"Total P0 findings across all iterations (deduped)\"\n          - p1_count: \"Total P1 findings across all iterations (deduped)\"\n          - p2_count: \"Total P2 findings across all iterations (deduped)\"\n          - dimensions_covered: \"List of reviewed dimensions\"\n          - dimension_coverage: \"covered / total\"\n          - ac_coverage_signal: \"For spec-folder targets only: if level is 2+ and checklist.md exists and implementation-summary.md is in-progress or later, surface the AC_COVERAGE advisory status; otherwise mark exempt.\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records\"\n          - reason: \"Use the latest stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n\n      # H-1 verdict derivation: parse findings JSONL, map highest severity to verdict\n      # - PASS: no P0 or P1 findings (P2-only or clean)\n      # - CONDITIONAL: any P1 findings (no P0)\n      # - FAIL: any P0 findings\n      # Final line of iteration-NNN.md MUST be exactly: \"Review verdict: PASS\" / \"Review verdict: CONDITIONAL\" / \"Review verdict: FAIL\"\n      step_derive_verdict:\n        action: \"Derive review verdict from accumulated findings\"\n        algorithm: |\n          if p0_count > 0:\n            verdict = \"FAIL\"\n          elif p1_count > 0:\n            verdict = \"CONDITIONAL\"\n          else:\n            verdict = \"PASS\"\n          has_advisories = (verdict == \"PASS\" and p2_count > 0)\n          ac_coverage_signal is advisory while the validation rule is INFO/default-off; include it in synthesis traceability, but do not change the exact verdict enum from this signal alone.\n        outputs:\n          - verdict: \"PASS | CONDITIONAL | FAIL\"\n          - has_advisories: \"Boolean true when verdict is PASS and any active P2 findings exist\"\n          - ac_coverage_signal: \"exempt | disabled | pass | advisory-shortfall\"\n        contract: |\n          Every iteration-NNN.md must end with exactly: \"Review verdict: PASS\" (or CONDITIONAL or FAIL).\n          Downstream automation parses this final line via exact string match — do not vary the format.\n\n      step_read_all_iterations:\n        action: \"Read all iteration files and strategy\"\n        read_pattern: \"{state_paths.iteration_dir}/iteration-*.md\"\n        read_also: \"{state_paths.strategy}\"\n\n      step_build_finding_registry:\n        action: \"Build deduplicated finding registry from all iterations\"\n        algorithm: |\n          1. Extract all findings from iteration JSONL delta files\n          2. Compute content_hash for each finding (emission requirement):\n             content_hash = sha256(file_path + \"\\u001f\" + line_range + \"\\u001f\" + finding_type + \"\\u001f\" + normalized_description_80chars)\n             Normalized description = whitespace-collapsed, lowercased, first 80 chars of the finding description.\n          3. Two-tier dedup:\n             PRIMARY: group by content_hash field\n               - Same content_hash, multiple dimensions → single finding, merged `dimensions: [<all>]` array\n               - Keep highest severity on duplicates\n             FALLBACK (legacy records lacking content_hash): file:line + normalized_title\n               - Same file:line, multiple dimensions → single finding, multiple dimension tags\n               - Keep highest severity on duplicates\n          4. Track finding lifecycle:\n             - status: active | duplicate | upgraded | downgraded | contested | resolved_false_positive\n             - Record first_seen, upgraded_in, previous_severity for severity changes\n             - Record dimensions array reflecting all dimensions that emitted this finding\n          5. Resolve contradictions:\n             - Findings marked contested across iterations → referee pass\n             - Determine final severity and status\n          6. Count only 'active' findings for totals\n        outputs:\n          - finding_registry: \"Deduplicated list of all findings with metadata\"\n          - active_p0: \"Count of active P0 findings\"\n          - active_p1: \"Count of active P1 findings\"\n          - active_p2: \"Count of active P2 findings\"\n\n      step_adversarial_selfcheck:\n        action: \"Final adversarial self-check on all P0 and P1 findings\"\n        algorithm: |\n          For each active P0/P1 finding:\n            1. Hunter: Re-verify finding against source code (re-read file:line)\n            2. Skeptic: Challenge severity — is this really P0/P1? Could it be P2?\n            3. Referee: Final call — confirm, downgrade, or mark false_positive\n          Update finding_registry with adjudicated results.\n\n      step_emit_resource_map:\n        action: \"Emit {state_paths.resource_map_output} from converged review deltas unless config.resource_map.emit is false\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors --emit-resource-map\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.delta_dir}/iter-*.jsonl\"\n        write:\n          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Reducer skips cleanly when config.resource_map.emit == false and writes a deterministic resource-map when enabled.\"\n\n      step_resource_map_coverage_gate:\n        action: \"If resource_map_present, compute the Resource Map Coverage Gate synthesis inputs; otherwise preserve the skip note\"\n        note: \"Cross-check target_files from {spec_folder}/applied/T-*.md against {spec_folder}/resource-map.md. Report touched entries, untouched entries split into expected-by-scope vs gap, and implementation paths absent from the map. Findings raised here use category resource-map-coverage with severity calibrated to the gate outcome.\"\n\n      step_compile_review_report:\n        action: \"Compile review/review-report.md with 9 core sections, a conditional Resource Map Coverage Gate section, and an embedded Planning Packet\"\n        instructions: |\n          Create review/review-report.md with the following sections:\n\n          1. **Executive Summary**\n             - Overall verdict: PASS | CONDITIONAL | FAIL\n             - hasAdvisories: true when PASS carries active P2 items\n             - P0/P1/P2 counts (active only)\n             - Review scope summary\n\n          2. **Planning Trigger**\n             - State whether `/speckit:plan` is required\n             - Include a fenced `json` block labeled `Planning Packet`\n             - The packet MUST include: `triggered`, `verdict`, `hasAdvisories`, `activeFindings`, `remediationWorkstreams`, `specSeed`, `planSeed`, `findingClasses`, `affectedSurfacesSeed`, `fixCompletenessRequired`\n             - Build `activeFindings`, `findingClasses`, and `affectedSurfacesSeed` from reducer-owned state plus iteration JSONL `findingDetails`; if a field is missing, mark it `UNKNOWN` instead of inferring it from prose\n\n          3. **Active Finding Registry**\n             - Unified registry for active P0/P1/P2 findings\n             - For each: ID, severity, title, dimension, file:line, evidence, impact, fix recommendation, disposition, findingClass, scopeProof, affectedSurfaceHints\n\n          4. **Remediation Workstreams**\n             - Ordered action groups: P0 first, then P1, with P2 advisories separated\n\n          5. **Spec Seed**\n             - Concrete seed bullets for follow-on spec updates\n\n          6. **Plan Seed**\n             - Concrete starter tasks for `/speckit:plan`\n\n           7. **Traceability Status**\n              - Summarize required core protocols first, then applicable overlay protocols\n              - Include status, evidence, and any unresolved drift per protocol\n              - Include `AC_COVERAGE` status for lifecycle-active spec-folder targets: exempt, disabled, pass, or advisory-shortfall, with covered/total and floor when available\n\n          If `resource_map_present` is true, insert **## Resource Map Coverage Gate** after `Traceability Status` with exactly three bullets:\n             - `Entries touched`: count of resource-map paths that appear in applied reports\n             - `Entries not touched`: paths in resource-map not in implementation, labeled `expected-by-scope` or `gap`\n             - `Implementation paths absent from resource-map`: `target_files` in applied reports not on the map\n\n          8. **Deferred Items**\n             - Advisory-only or backlog-worthy follow-ups that do not block the current verdict\n\n          **Dimension Expansion Map**\n             - Insert `## Dimension Expansion Map` after Deferred Items and before Search Ledger.\n             - Render reducer-owned `divergence.saturatedDirections`, completed pivots, failed pivots, audited overrides, Council artifact references, selected review directions, and remaining frontier.\n             - This section records breadth only. It cannot alter the Executive Summary verdict, hasAdvisories, finding registry, or adversarial self-check results.\n\n          9. **Search Ledger**\n             - Always include this section before the appendix.\n             - Render reducer-owned `searchCoverage`, `candidateCoverage`, `searchDebt`, `ruledOutCandidates`, and `cleanSearchProof`.\n             - If all arrays are empty or absent, include: `*No search-depth state captured (legacy v1 record)*`.\n             - When `searchDebt` is non-empty, state `hasSearchDebt: true` and carry the dashboard verdict as CONDITIONAL unless active P0 findings make it FAIL.\n\n          10. **Audit Appendix**\n             - Convergence summary, coverage summary, ruled-out claims, sources reviewed\n             - Cross-reference appendix MUST be split into `Core Protocols` and `Overlay Protocols`\n\n          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-review/references/protocol/loop-protocol.md §Lifecycle Branches`.)\n        output: \"{state_paths.review_output}\"\n\n      step_convergence_report:\n        action: \"Append convergence report to JSONL\"\n        command: |\n          node --input-type=module <<'EOF'\n          import { appendFileSync, existsSync, readFileSync, statSync } from 'node:fs';\n\n          const paths = {\n            stateLog: String.raw`{state_paths.state_log}`,\n            registry: String.raw`{state_paths.findings_registry}`,\n            review: String.raw`{state_paths.review_output}`,\n            dashboard: String.raw`{state_paths.dashboard}`,\n          };\n\n          function hasFile(filePath) {\n            try {\n              return existsSync(filePath) && statSync(filePath).isFile();\n            } catch {\n              return false;\n            }\n          }\n\n          function readJson(filePath) {\n            try {\n              return JSON.parse(readFileSync(filePath, 'utf8'));\n            } catch {\n              return null;\n            }\n          }\n\n          function readJsonl(filePath) {\n            if (!hasFile(filePath)) return { records: [], malformedLines: [] };\n            const records = [];\n            const malformedLines = [];\n            readFileSync(filePath, 'utf8')\n              .split(/\\r?\\n/)\n              .forEach((line, index) => {\n                const trimmed = line.trim();\n                if (!trimmed) return;\n                try {\n                  records.push(JSON.parse(trimmed));\n                } catch {\n                  malformedLines.push(index + 1);\n                }\n              });\n            return { records, malformedLines };\n          }\n\n          function countIterationFindings(record) {\n            if (!record || record.type !== 'iteration') return 0;\n            const numeric = Number(record.findingsCount);\n            if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n            if (Array.isArray(record.findingDetails)) return record.findingDetails.length;\n            return 0;\n          }\n\n          function normalizeFindingKey(value) {\n            return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n          }\n\n          function findingKeys(candidate) {\n            if (typeof candidate === 'string') {\n              const key = normalizeFindingKey(candidate);\n              return key ? [key] : [];\n            }\n            if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n            return [...new Set([\n              candidate.id,\n              candidate.findingId,\n              candidate.title,\n              candidate.summary,\n              candidate.text,\n              candidate.finding,\n              candidate.description,\n            ].map(normalizeFindingKey).filter(Boolean))];\n          }\n\n          function collectIterationFindingGroups(record) {\n            if (!record || record.type !== 'iteration' || !Array.isArray(record.findingDetails)) return [];\n            return record.findingDetails\n              .map(findingKeys)\n              .filter((keys) => keys.length > 0);\n          }\n\n          function collectRegistryFindingKeys(registry) {\n            return [registry?.openFindings, registry?.resolvedFindings, registry?.repeatedFindings]\n              .filter(Array.isArray)\n              .flatMap((findings) => findings)\n              .flatMap(findingKeys);\n          }\n\n          function appendEvent(event) {\n            appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n          }\n\n          const registry = readJson(paths.registry);\n          const openCount = Array.isArray(registry?.openFindings) ? registry.openFindings.length : null;\n          const resolvedCount = Array.isArray(registry?.resolvedFindings) ? registry.resolvedFindings.length : 0;\n          const repeatedCount = Array.isArray(registry?.repeatedFindings) ? registry.repeatedFindings.length : 0;\n          const registryFindingCount = openCount === null ? null : openCount + resolvedCount + repeatedCount;\n          const stateLog = readJsonl(paths.stateLog);\n          const stateRecords = stateLog.records;\n          const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n          const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n          const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n          const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n          const identifiableFindingCount = identifiableFindingGroups.length;\n          const missingArtifacts = [\n            ['registry', paths.registry],\n            ['review', paths.review],\n            ['dashboard', paths.dashboard],\n          ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n          const invariantFailures = [];\n          if (stateLog.malformedLines.length > 0) invariantFailures.push('state_jsonl_parse_failure');\n          if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n          if (registryFindingCount === null) invariantFailures.push('registry_missing_openFindings');\n          if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n          if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n          if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n\n          if (invariantFailures.length > 0) {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_incomplete',\n              mode: 'review',\n              severity: 'warning',\n              totalIterations: Number('{iteration_count}'),\n              activeP0: Number('{active_p0}'),\n              activeP1: Number('{active_p1}'),\n              activeP2: Number('{active_p2}'),\n              dimensionCoverage: Number('{dimension_coverage}'),\n              verdict: '{verdict}',\n              releaseReadinessState: '{release_readiness_state}',\n              stopReason: '{reason}',\n              reason: 'synthesis_artifact_invariant_failed',\n              invariantFailures,\n              missingArtifacts,\n              registryFindingCount,\n              iterationFindingCount,\n              identifiableFindingCount,\n              missingStructuredFindingCount,\n              stateParseFailureCount: stateLog.malformedLines.length,\n              timestamp: '{ISO_8601_NOW}',\n            });\n          } else {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_complete',\n              mode: 'review',\n              totalIterations: Number('{iteration_count}'),\n              activeP0: Number('{active_p0}'),\n              activeP1: Number('{active_p1}'),\n              activeP2: Number('{active_p2}'),\n              dimensionCoverage: Number('{dimension_coverage}'),\n              verdict: '{verdict}',\n              releaseReadinessState: '{release_readiness_state}',\n              stopReason: '{reason}',\n              timestamp: '{ISO_8601_NOW}',\n            });\n          }\n          EOF\n        note: \"Emit as numeric ratio (e.g., 0.75), not quoted string. Compute: dimensions_covered / total_dimensions.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_leave_artifacts_unstaged:\n        action: \"Leave all synthesized artifacts unstaged for explicit operator review\"\n        note: \"Synthesis must not mutate the shared Git index. The operator retains staging and commit authority after reviewing the complete artifact directory.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve review context to memory system\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n        requirements:\n          - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n          - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed review loop.\"\n          - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n        example_payload: |\n          {\n            \"specFolder\": \"{spec_folder}\",\n            \"sessionSummary\": \"Deep review completed; see review/review-report.md for verdict, findings, and workstreams.\",\n            \"observations\": [\"Summarize the active findings, verdict, and remediation guidance.\"],\n            \"recent_context\": [\"Point to the generated review artifacts and next action.\"],\n            \"exchanges\": [],\n            \"toolCalls\": []\n          }\n\n      step_generate_context:\n        action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n        command: \"node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n        critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n\n      step_index_memory:\n        action: \"Index the routed canonical spec document with memory_save when immediate MCP visibility is required\"\n        mcp_tool: memory_save\n        invocation: 'memory_save({ filePath: \"[routed-canonical-spec-doc-path]\" })'\n        note: \"Use the actual canonical spec-doc path returned by generate-context.js (decision-record.md, implementation-summary.md, or handover.md); memory_index_scan remains the bulk fallback\"\n\n      step_verify_save:\n        action: \"Verify canonical save routed content into the correct spec document\"\n        check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n        on_fail: \"Log warning but do not block completion\"\n\n      step_release_lock:\n        action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n  # ═══════════════════════════════════════════════════════════════\n  # COMPLETION\n  # ═══════════════════════════════════════════════════════════════\n  completion:\n    message: |\n      Deep review complete.\n      Iterations: {iteration_count} | Stop reason: {reason}\n      Findings: P0={active_p0} P1={active_p1} P2={active_p2}\n      Verdict: {verdict} | hasAdvisories={has_advisories}\n\n      Artifacts:\n        - review/review-report.md (compiled from {iteration_count} iterations)\n        - {iteration_count} iteration files in review/iterations/\n        - State files in review/: deep-review-config.json, deep-review-state.jsonl, deep-review-findings-registry.json, deep-review-strategy.md, deep-review-dashboard.md\n        - Memory context saved\n\n      STATUS=OK PATH={spec_folder}\n    next_steps:\n      - \"/speckit:plan [remediation] (if FAIL or CONDITIONAL verdict)\"\n      - \"/create:changelog (if PASS, including PASS with hasAdvisories=true)\"\n      - \"/deep:review [target] (for another review)\"\n      - \"/memory:save {spec_folder} (refresh canonical continuity before the next session)\"\n\n# ─────────────────────────────────────────────────────────────────\n# ERROR RECOVERY\n# ─────────────────────────────────────────────────────────────────\nerror_recovery:\n  agent_dispatch_timeout: \"Retry once with reduced scope (fewer files per iteration). If second timeout, mark as 'timeout' and continue.\"\n  state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n  memory_save_failure: \"Preserve the review packet in review/ as backup. Log warning.\"\n\n# ─────────────────────────────────────────────────────────────────\n# RULES\n# ─────────────────────────────────────────────────────────────────\nrules:\n  ALWAYS:\n    - follow_workflow_phases_in_order\n    - dispatch_deep_review_agent_per_iteration\n    - check_convergence_before_each_iteration\n    - write_all_state_to_files\n    - save_memory_context_after_synthesis\n    - respect_max_iterations_cap\n    - treat_review_target_as_read_only\n    - deduplicate_findings_before_synthesis\n    - run_adversarial_selfcheck_on_p0_p1\n  NEVER:\n    - skip_convergence_check\n    - dispatch_non_leaf_agents\n    - hold_iteration_findings_in_memory_only\n    - modify_config_after_initialization\n    - overwrite_jsonl_state_log\n    - proceed_without_state_file_verification\n    - modify_files_under_review\n    - report_p0_without_file_line_evidence\n\n# ─────────────────────────────────────────────────────────────────\n# REFERENCE-ONLY APPENDIX\n# ─────────────────────────────────────────────────────────────────\nreference_only_appendix:\n  checkpoint_commit:\n    note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n    commands:\n      - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.findings_registry} {state_paths.strategy} {state_paths.review_output}\"\n      - 'git commit -m \"chore(deep-review): iteration {NNN} complete\"'\n  severity_weights:\n    note: \"Severity weights for newFindingsRatio calculation\"\n    weights:\n      P0: 10.0\n      P1: 5.0\n      P2: 1.0\n    p0_override: \"If ANY new P0 discovered → newFindingsRatio = max(calculated, 0.50). A single new P0 blocks convergence.\"\n    clean_pass: \"If total_findings == 0 (clean pass) → newFindingsRatio = 0.0\"\n  review_dimensions:\n    note: \"All 4 default review dimensions with priority ordering\"\n    dimensions:\n      - { priority: 1, name: \"correctness\", checks: \"Logic, state flow, edge cases, error handling\" }\n      - { priority: 2, name: \"security\", checks: \"Auth, input/output safety, data exposure, permissions\" }\n      - { priority: 3, name: \"traceability\", checks: \"Spec/checklist alignment, cross-reference integrity, evidence coverage\" }\n      - { priority: 4, name: \"maintainability\", checks: \"Patterns, documentation quality, safe follow-on change clarity\" }\n  cross_reference_protocols:\n    note: \"Cross-reference verification protocols split into core and overlay classes\"\n    core_protocols:\n      - { check: \"Spec vs Code\", source: \"spec.md claims\", target: \"implementation\" }\n      - { check: \"Checklist vs Evidence\", source: \"[x] items\", target: \"cited evidence\" }\n    overlay_protocols:\n      - { check: \"SKILL.md vs Agent\", source: \"Skill contracts\", target: \"agent files\" }\n      - { check: \"Agent Cross-Runtime\", source: \".claude\", target: \".opencode/.agents\" }\n      - { check: \"Feature Catalog vs Code\", source: \"Catalog claims\", target: \"implementation\" }\n      - { check: \"Playbook vs Support\", source: \"Scenario preconditions\", target: \"actual support\" }","lineStart":1450,"lineEnd":2155,"totalLines":2155,"truncated":false}},"title":".opencode/commands/deep/assets/deep-review-auto.yaml","time":{"start":1786561257567,"end":1786561257609}},"id":"prt_ff7595ef7001mjfWu6rbETTE7c","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","messageID":"msg_ff7594beb001Y9Z6K64g89LCQ2"}}
