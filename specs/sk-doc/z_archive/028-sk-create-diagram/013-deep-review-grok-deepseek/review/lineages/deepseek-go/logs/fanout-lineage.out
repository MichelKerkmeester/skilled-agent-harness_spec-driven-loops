\"score\", \"optimize\", \"check\", \"review\", \"harden\", \"audit\"] },\n    \"create-skill-aliases\": { \"keywords\": [\"create skill\", \"new skill\", \"skill scaffold\", \"SKILL.md scaffold\", \"OpenCode skill\", \"package skill\", \"sk-skill\", \"create sk-\", \"reusable capability\", \"reusable helper\", \"starter reference docs\", \"which json files does a skill need\", \"skill root metadata contract\", \"leaf-manifest config aliases required\", \"hub versus standalone skill class\", \"skill metadata drift gate\"] },\n    \"create-skill-parent-aliases\": { \"keywords\": [\"parent skill\", \"parent hub\", \"mode packet\", \"nested workflow packet\"] },\n    \"create-readme-aliases\": { \"keywords\": [\"create readme\", \"readme\", \"folder readme\", \"write readme\", \"README.md\", \"install guide\", \"installation guide\", \"setup guide\", \"code folder readme\", \"front-page overview\", \"getting our project running\", \"running from scratch\"] },\n    \"create-agent-aliases\": { \"keywords\": [\"create agent\", \"OpenCode agent\", \"Claude Code agent\", \"agent file\", \"new agent\", \"agent persona\", \"agent frontmatter\", \"permission object\", \"authority boundary\", \"agent template\", \"runtime agent directory\", \"agent and paired\"] },\n--\n","metadata":{"output":"=== feature-catalog files ===\nsk-create-diagram/feature-catalog/:\ncommand-and-hub-integration\ndiagram-generation\nfeature-catalog.md\nimport-export\n\nsk-create-diagram/feature-catalog/command-and-hub-integration/:\ncreate-diagram-command.md\nhub-registration.md\n\nsk-create-diagram/feature-catalog/diagram-generation/:\neditorial-style-and-connectors.md\nonboarding-flow.md\nprimitive-variants.md\ntype-selection-and-routing.md\n\nsk-create-diagram/feature-catalog/import-export/:\ndrawio-import.md\nexport-guidance.md\nmermaid-import.md\n\n=== leaf-manifest ===\nleaf-manifest.json\n{\n  \"modes\": [\n    {\n      \"leaves\": [\n        \"assets/agent-template.md\",\n        \"references/R