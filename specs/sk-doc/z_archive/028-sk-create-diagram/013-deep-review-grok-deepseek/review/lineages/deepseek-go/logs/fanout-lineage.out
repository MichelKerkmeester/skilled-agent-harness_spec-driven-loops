ls/sk-doc/sk-create-diagram/references/types/type-line.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-loop.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-medallion.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-nested.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-org-chart.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-process.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-pyramid.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-quadrant.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-radar.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-scatter.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-sequence.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-state.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-swimlane.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-timeline.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-tree.md\n.opencode/skills/sk-doc/sk-create-diagram/references/types/type-venn.md\n.opencode/skills/sk-doc/sk-create-diagram/scripts/README.md\n.opencode/skills/sk-doc/sk-create-diagram/scripts/drawio_extract.py\n.opencode/skills/sk-doc/sk-create-diagram/scripts/mermaid_extract.py\n.opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh\n","exit":0,"truncated":false},"title":"find .opencode/skills/sk-doc/sk-create-diagram -type f | sort","time":{"start":1786561327207,"end":1786561327212}},"id":"prt_ff75a6faf001K22HvQxTXR8seo","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","messageID":"msg_ff75a4408001gWyIdQ3TL72vPv"}}
