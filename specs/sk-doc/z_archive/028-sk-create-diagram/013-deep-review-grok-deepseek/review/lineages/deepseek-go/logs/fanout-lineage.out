{"type":"tool_use","timestamp":1786561444148,"sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","part":{"type":"tool","tool":"read","callID":"call_00_Ut6HRrLNPSqJreL7fNfY8242","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: FLOWCHART VALIDATOR\n4: # ───────────────────────────────────────────────────────────────\n5: # Validate markdown flowcharts for common errors.\n6: # Usage: ./validate-flowchart.sh <flowchart.md>\n7: \n8: set -euo pipefail\n9: \n10: \n11: # ───────────────────────────────────────────────────────────────\n12: # 1. CONFIGURATION\n13: # ───────────────────────────────────────────────────────────────\n14: \n15: if [[ $# -lt 1 ]]; then\n16:   echo \"Usage: $0 <flowchart.md>\"\n17:   echo \"Example: $0 specs/094-feature/flowchart.md\"\n18:   exit 1\n19: fi\n20: \n21: FLOWCHART_FILE=\"$1\"\n22: ERRORS=0\n23: WARNINGS=0\n24: \n25: if [[ ! -f \"$FLOWCHART_FILE\" ]]; then\n26:   echo \"Usage: $0 <flowchart.md>\"\n27:   echo \"Example: $0 specs/094-feature/flowchart.md\"\n28:   exit 1\n29: fi\n30: \n31: \n32: # ───────────────────────────────────────────────────────────────\n33: # 2. VALIDATORS\n34: # ───────────────────────────────────────────────────────────────\n35: \n36: check_box_alignment() {\n37:     echo \"⏹️  Checking for misaligned boxes...\"\n38:     # Measure box-width consistency from actual box borders only: matching-corner\n39:     # tops/bottoms and side-tee separators. Connector, merge, fork, elbow and\n40:     # swimlane-divider runs are not box widths, and counting them wrongly flagged\n41:     # connector geometry as box-width variation.\n42:     NUM_WIDTHS=$(grep -oE '┌─+┐|└─+┘|├─+┤' \"$FLOWCHART_FILE\" 2>/dev/null | grep -oE '─+' | awk '{ print length }' | sort -u | sed '/^$/d' | wc -l | tr -d ' ')\n43:     NUM_WIDTHS=\"${NUM_WIDTHS:-0}\"\n44: \n45:     if [[ $NUM_WIDTHS -gt 5 ]]; then\n46:       echo \"   ❌ Error: Too many box width variations ($NUM_WIDTHS)\"\n47:       echo \"   Tip: Standardize box widths for consistency\"\n48:       ERRORS=$((ERRORS + 1))\n49:     elif [[ $NUM_WIDTHS -gt 3 ]]; then\n50:       echo \"   ⚠️  Warning: Multiple box widths detected (found $NUM_WIDTHS different widths)\"\n51:       echo \"   Tip: Standardize box widths for consistency\"\n52:       WARNINGS=$((WARNINGS + 1))\n53:     else\n54:       echo \"   ✅ Box widths consistent\"\n55:     fi\n56: }\n57: \n58: check_arrows() {\n59:     echo \"➡️  Checking for arrow patterns...\"\n60:     ARROW_COUNT=$(grep -Ec '→|↓|▼|▶|├─' \"$FLOWCHART_FILE\" || true)\n61:     BOX_COUNT=$(grep -Ec '┌─|┐|└─|┘' \"$FLOWCHART_FILE\" || true)\n62:     ARROW_COUNT=\"${ARROW_COUNT:-0}\"\n63:     BOX_COUNT=\"${BOX_COUNT:-0}\"\n64: \n65:     if [[ $ARROW_COUNT -eq 0 ]] && [[ $BOX_COUNT -gt 0 ]]; then\n66:       echo \"   ❌ Error: Found boxes but no arrows/connectors (broken flowchart)\"\n67:       echo \"   Tip: Add arrows (→, ↓, ▼, ▶) or tree branches (├─) to connect boxes\"\n68:       ERRORS=$((ERRORS + 1))\n69:     else\n70:       echo \"   ✅ Arrows and connectors present\"\n71:     fi\n72: }\n73: \n74: check_decision_labels() {\n75:     echo \"🔀 Checking decision branch labels...\"\n76:     DECISION_COUNT=$(grep -Eic '(^|[^[:alpha:]])(decision|choice|branch)([^[:alpha:]]|$)|(^|[^[:alpha:]])if([^[:alpha:]]|$)' \"$FLOWCHART_FILE\" || true)\n77:     YES_NO_COUNT=$(grep -Eic '\\[(yes|no)\\]|✓|✗' \"$FLOWCHART_FILE\" || true)\n78:     DECISION_COUNT=\"${DECISION_COUNT:-0}\"\n79:     YES_NO_COUNT=\"${YES_NO_COUNT:-0}\"\n80: \n81:     if [[ $DECISION_COUNT -gt 0 ]] && [[ $YES_NO_COUNT -eq 0 ]]; then\n82:       echo \"   ❌ Error: Decision points detected but no YES/NO labels found\"\n83:       echo \"   Tip: Add [YES]/[NO] or ✓/✗ labels to decision branches\"\n84:       ERRORS=$((ERRORS + 1))\n85:     else\n86:       echo \"   ✅ Decision branch labeling looks good\"\n87:     fi\n88: }\n89: \n90: check_nesting_depth() {\n91:     echo \"📊 Checking nesting depth...\"\n92:     MAX_INDENT=$(awk '{match($0, /^[ ]*/); print RLENGTH}' \"$FLOWCHART_FILE\" | sort -rn | head -1)\n93:     MAX_INDENT=\"${MAX_INDENT:-0}\"\n94:     DEPTH_LEVEL=$((MAX_INDENT / 2))\n95: \n96:     if [[ $DEPTH_LEVEL -gt 6 ]]; then\n97:       echo \"   ⚠️  Warning: Deep nesting detected (level $DEPTH_LEVEL)\"\n98:       echo \"   Tip: Consider breaking into multiple flowcharts or using swimlanes\"\n99:       WARNINGS=$((WARNINGS + 1))\n100:     elif [[ $DEPTH_LEVEL -gt 4 ]]; then\n101:       echo \"   ℹ️  Info: Moderate nesting (level $DEPTH_LEVEL)\"\n102:     else\n103:       echo \"   ✅ Nesting depth appropriate (level $DEPTH_LEVEL)\"\n104:     fi\n105: }\n106: \n107: check_size() {\n108:     echo \"📏 Checking flowchart size...\"\n109:     LINE_COUNT=$(wc -l < \"$FLOWCHART_FILE\" | tr -d ' ')\n110: \n111:     if [[ $LINE_COUNT -gt 200 ]]; then\n112:       echo \"   ⚠️  Warning: Large flowchart ($LINE_COUNT lines)\"\n113:       echo \"   Tip: Consider splitting into multiple diagrams for readability\"\n114:       WARNINGS=$((WARNINGS + 1))\n115:     elif [[ $LINE_COUNT -gt 100 ]]; then\n116:       echo \"   ℹ️  Info: Moderate size ($LINE_COUNT lines)\"\n117:     else\n118:       echo \"   ✅ Size appropriate ($LINE_COUNT lines)\"\n119:     fi\n120: }\n121: \n122: \n123: # ───────────────────────────────────────────────────────────────\n124: # 3. MAIN\n125: # ───────────────────────────────────────────────────────────────\n126: \n127: echo \"🔍 Validating flowchart: $FLOWCHART_FILE\"\n128: echo \"\"\n129: \n130: check_box_alignment\n131: check_arrows\n132: check_decision_labels\n133: check_nesting_depth\n134: check_size\n135: \n136: echo \"\"\n137: echo \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\"\n138: \n139: if [[ $ERRORS -eq 0 ]] && [[ $WARNINGS -eq 0 ]]; then\n140:   echo \"✅ Flowchart validation passed - No issues found\"\n141:   exit 0\n142: elif [[ $ERRORS -eq 0 ]]; then\n143:   echo \"⚠️  Flowchart validation passed with $WARNINGS warning(s)\"\n144:   echo \"   Consider addressing warnings for improved readability\"\n145:   exit 0\n146: else\n147:   echo \"❌ Found $ERRORS error(s) and $WARNINGS warning(s)\"\n148:   exit 1\n149: fi\n\n(End of file - total 149 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: FLOWCHART VALIDATOR\n# ───────────────────────────────────────────────────────────────\n# Validate markdown flowcharts for common errors.\n# Usage: ./validate-flowchart.sh <flowchart.md>\n\nset -euo pipefail\n\n\n# ───────────────────────────────────────────────────────────────\n# 1. CONFIGURATION\n# ───────────────────────────────────────────────────────────────\n\nif [[ $# -lt 1 ]]; then\n  echo \"Usage: $0 <flowchart.md>\"\n  echo \"Example: $0 specs/094-feature/flowchart.md\"\n  exit 1\nfi\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh","text":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: FLOWCHART VALIDATOR\n# ───────────────────────────────────────────────────────────────\n# Validate markdown flowcharts for common errors.\n# Usage: ./validate-flowchart.sh <flowchart.md>\n\nset -euo pipefail\n\n\n# ───────────────────────────────────────────────────────────────\n# 1. CONFIGURATION\n# ───────────────────────────────────────────────────────────────\n\nif [[ $# -lt 1 ]]; then\n  echo \"Usage: $0 <flowchart.md>\"\n  echo \"Example: $0 specs/094-feature/flowchart.md\"\n  exit 1\nfi\n\nFLOWCHART_FILE=\"$1\"\nERRORS=0\nWARNINGS=0\n\nif [[ ! -f \"$FLOWCHART_FILE\" ]]; then\n  echo \"Usage: $0 <flowchart.md>\"\n  echo \"Example: $0 specs/094-feature/flowchart.md\"\n  exit 1\nfi\n\n\n# ───────────────────────────────────────────────────────────────\n# 2. VALIDATORS\n# ───────────────────────────────────────────────────────────────\n\ncheck_box_alignment() {\n    echo \"⏹️  Checking for misaligned boxes...\"\n    # Measure box-width consistency from actual box borders only: matching-corner\n    # tops/bottoms and side-tee separators. Connector, merge, fork, elbow and\n    # swimlane-divider runs are not box widths, and counting them wrongly flagged\n    # connector geometry as box-width variation.\n    NUM_WIDTHS=$(grep -oE '┌─+┐|└─+┘|├─+┤' \"$FLOWCHART_FILE\" 2>/dev/null | grep -oE '─+' | awk '{ print length }' | sort -u | sed '/^$/d' | wc -l | tr -d ' ')\n    NUM_WIDTHS=\"${NUM_WIDTHS:-0}\"\n\n    if [[ $NUM_WIDTHS -gt 5 ]]; then\n      echo \"   ❌ Error: Too many box width variations ($NUM_WIDTHS)\"\n      echo \"   Tip: Standardize box widths for consistency\"\n      ERRORS=$((ERRORS + 1))\n    elif [[ $NUM_WIDTHS -gt 3 ]]; then\n      echo \"   ⚠️  Warning: Multiple box widths detected (found $NUM_WIDTHS different widths)\"\n      echo \"   Tip: Standardize box widths for consistency\"\n      WARNINGS=$((WARNINGS + 1))\n    else\n      echo \"   ✅ Box widths consistent\"\n    fi\n}\n\ncheck_arrows() {\n    echo \"➡️  Checking for arrow patterns...\"\n    ARROW_COUNT=$(grep -Ec '→|↓|▼|▶|├─' \"$FLOWCHART_FILE\" || true)\n    BOX_COUNT=$(grep -Ec '┌─|┐|└─|┘' \"$FLOWCHART_FILE\" || true)\n    ARROW_COUNT=\"${ARROW_COUNT:-0}\"\n    BOX_COUNT=\"${BOX_COUNT:-0}\"\n\n    if [[ $ARROW_COUNT -eq 0 ]] && [[ $BOX_COUNT -gt 0 ]]; then\n      echo \"   ❌ Error: Found boxes but no arrows/connectors (broken flowchart)\"\n      echo \"   Tip: Add arrows (→, ↓, ▼, ▶) or tree branches (├─) to connect boxes\"\n      ERRORS=$((ERRORS + 1))\n    else\n      echo \"   ✅ Arrows and connectors present\"\n    fi\n}\n\ncheck_decision_labels() {\n    echo \"🔀 Checking decision branch labels...\"\n    DECISION_COUNT=$(grep -Eic '(^|[^[:alpha:]])(decision|choice|branch)([^[:alpha:]]|$)|(^|[^[:alpha:]])if([^[:alpha:]]|$)' \"$FLOWCHART_FILE\" || true)\n    YES_NO_COUNT=$(grep -Eic '\\[(yes|no)\\]|✓|✗' \"$FLOWCHART_FILE\" || true)\n    DECISION_COUNT=\"${DECISION_COUNT:-0}\"\n    YES_NO_COUNT=\"${YES_NO_COUNT:-0}\"\n\n    if [[ $DECISION_COUNT -gt 0 ]] && [[ $YES_NO_COUNT -eq 0 ]]; then\n      echo \"   ❌ Error: Decision points detected but no YES/NO labels found\"\n      echo \"   Tip: Add [YES]/[NO] or ✓/✗ labels to decision branches\"\n      ERRORS=$((ERRORS + 1))\n    else\n      echo \"   ✅ Decision branch labeling looks good\"\n    fi\n}\n\ncheck_nesting_depth() {\n    echo \"📊 Checking nesting depth...\"\n    MAX_INDENT=$(awk '{match($0, /^[ ]*/); print RLENGTH}' \"$FLOWCHART_FILE\" | sort -rn | head -1)\n    MAX_INDENT=\"${MAX_INDENT:-0}\"\n    DEPTH_LEVEL=$((MAX_INDENT / 2))\n\n    if [[ $DEPTH_LEVEL -gt 6 ]]; then\n      echo \"   ⚠️  Warning: Deep nesting detected (level $DEPTH_LEVEL)\"\n      echo \"   Tip: Consider breaking into multiple flowcharts or using swimlanes\"\n      WARNINGS=$((WARNINGS + 1))\n    elif [[ $DEPTH_LEVEL -gt 4 ]]; then\n      echo \"   ℹ️  Info: Moderate nesting (level $DEPTH_LEVEL)\"\n    else\n      echo \"   ✅ Nesting depth appropriate (level $DEPTH_LEVEL)\"\n    fi\n}\n\ncheck_size() {\n    echo \"📏 Checking flowchart size...\"\n    LINE_COUNT=$(wc -l < \"$FLOWCHART_FILE\" | tr -d ' ')\n\n    if [[ $LINE_COUNT -gt 200 ]]; then\n      echo \"   ⚠️  Warning: Large flowchart ($LINE_COUNT lines)\"\n      echo \"   Tip: Consider splitting into multiple diagrams for readability\"\n      WARNINGS=$((WARNINGS + 1))\n    elif [[ $LINE_COUNT -gt 100 ]]; then\n      echo \"   ℹ️  Info: Moderate size ($LINE_COUNT lines)\"\n    else\n      echo \"   ✅ Size appropriate ($LINE_COUNT lines)\"\n    fi\n}\n\n\n# ───────────────────────────────────────────────────────────────\n# 3. MAIN\n# ───────────────────────────────────────────────────────────────\n\necho \"🔍 Validating flowchart: $FLOWCHART_FILE\"\necho \"\"\n\ncheck_box_alignment\ncheck_arrows\ncheck_decision_labels\ncheck_nesting_depth\ncheck_size\n\necho \"\"\necho \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\"\n\nif [[ $ERRORS -eq 0 ]] && [[ $WARNINGS -eq 0 ]]; then\n  echo \"✅ Flowchart validation passed - No issues found\"\n  exit 0\nelif [[ $ERRORS -eq 0 ]]; then\n  echo \"⚠️  Flowchart validation passed with $WARNINGS warning(s)\"\n  echo \"   Consider addressing warnings for improved readability\"\n  exit 0\nelse\n  echo \"❌ Found $ERRORS error(s) and $WARNINGS warning(s)\"\n  exit 1\nfi","lineStart":1,"lineEnd":149,"totalLines":149,"truncated":false}},"title":".opencode/skills/sk-doc/sk-create-diagram/scripts/validate-flowchart.sh","time":{"start":1786561444127,"end":1786561444134}},"id":"prt_ff75c34bb001iVl12YhU1XxlX6","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","messageID":"msg_ff75c216d001xIUb2OYYr2bTrV"}}
{"type":"tool_use","timestamp":1786561445107,"sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","part":{"type":"tool","tool":"read","callID":"call_01_ydsN52MsnatCu1A0AQAW7048","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/drawio_extract.py"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/drawio_extract.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: DRAWIO IR EXTRACTOR\n4: # ───────────────────────────────────────────────────────────────\n5: \"\"\"Extract a normalized intermediate representation (IR) from a draw.io file.\n6: \n7: The deterministic half of the draw.io import flow: this script never makes a\n8: design decision. It decodes whatever draw.io wrote (raw XML, deflate+base64\n9: payloads, PNG/SVG files with an embedded ``mxfile``), flattens the mxGraphModel\n10: into absolute-positioned nodes and edges, and reports structural signals — hubs,\n11: containers, depth, cycles, leaf clusters — that the skill uses to pick a diagram\n12: type and a level of detail.\n13: \n14: Usage:\n15:     python3 drawio_extract.py <file.drawio> [--page N|NAME] [--json]\n16:                              [--max-rows N] [--out PATH]\n17: \n18: Default output is a compact Markdown digest meant to be read into context.\n19: ``--json`` emits the full IR instead (every node, every edge, every style).\n20: \n21: Exit codes: 0 ok, 2 unreadable / unsupported input.\n22: \"\"\"\n23: \n24: from __future__ import annotations\n25: \n26: import argparse\n27: import base64\n28: import html\n29: import json\n30: import re\n31: import struct\n32: import sys\n33: import zlib\n34: from dataclasses import dataclass, field, asdict\n35: from pathlib import Path\n36: from typing import Any\n37: from urllib.parse import unquote\n38: from xml.etree import ElementTree as ET\n39: \n40: # --------------------------------------------------------------------------\n41: # container / payload decoding\n42: # --------------------------------------------------------------------------\n43: \n44: PNG_MAGIC = b\"\\x89PNG\\r\\n\\x1a\\n\"\n45: MAX_INPUT_BYTES = 32 * 1024 * 1024\n46: MAX_XML_BYTES = 64 * 1024 * 1024\n47: \n48: \n49: class PayloadTooLarge(ValueError):\n50:     \"\"\"Raised when compressed metadata expands beyond the supported limit.\"\"\"\n51: \n52: \n53: def _fail(msg: str) -> \"NoReturn\":  # type: ignore[valid-type]\n54:     \"\"\"Print an error to stderr and exit with status 2.\"\"\"\n55:     print(f\"drawio_extract: {msg}\", file=sys.stderr)\n56:     raise SystemExit(2)\n57: \n58: \n59: def _reject_unsafe_xml(xml: str, source: str) -> None:\n60:     \"\"\"Reject declarations that can make XML parsing expand external data.\"\"\"\n61:     upper = xml.upper()\n62:     if \"<!DOCTYPE\" in upper or \"<!ENTITY\" in upper:\n63:         _fail(f\"{source}: DTD and entity declarations are not supported\")\n64: \n65: \n66: def _decompress_limited(data: bytes, wbits: int, limit: int = MAX_XML_BYTES) -> bytes:\n67:     \"\"\"Decompress without allowing a small payload to expand without bound.\"\"\"\n68:     decompressor = zlib.decompressobj(wbits)\n69:     output = bytearray()\n70:     chunk = data\n71:     while chunk:\n72:         remaining = limit + 1 - len(output)\n73:         if remaining <= 0:\n74:             raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n75:         output.extend(decompressor.decompress(chunk, remaining))\n76:         if len(output) > limit:\n77:             raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n78:         chunk = decompressor.unconsumed_tail\n79:     if not decompressor.eof:\n80:         raise zlib.error(\"incomplete compressed payload\")\n81:     remaining = limit + 1 - len(output)\n82:     if remaining <= 0:\n83:         raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n84:     output.extend(decompressor.flush(remaining))\n85:     if len(output) > limit:\n86:         raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n87:     return bytes(output)\n88: \n89: \n90: def _inflate(payload: str) -> str | None:\n91:     \"\"\"Undo draw.io's base64 + raw-deflate + URL-encoding pipeline.\"\"\"\n92:     try:\n93:         raw = base64.b64decode(payload, validate=False)\n94:     except Exception:\n95:         return None\n96:     for wbits in (-15, 15, 47):\n97:         try:\n98:             text = _decompress_limited(raw, wbits).decode(\"utf-8\", \"replace\")\n99:         except PayloadTooLarge:\n100:             _fail(\n101:                 f\"decoded diagram exceeds the {MAX_XML_BYTES // (1024 * 1024)} MiB limit\"\n102:             )\n103:         except Exception:\n104:             continue\n105:         # draw.io URL-encodes before deflating; unquote is a no-op if it didn't.\n106:         return unquote(text)\n107:     return None\n108: \n109: \n110: def _png_embedded_xml(data: bytes) -> str | None:\n111:     \"\"\"Pull the ``mxfile`` tEXt/zTXt chunk out of a draw.io-exported PNG.\"\"\"\n112:     pos = len(PNG_MAGIC)\n113:     while pos + 8 <= len(data):\n114:         (length,) = struct.unpack(\">I\", data[pos : pos + 4])\n115:         ctype = data[pos + 4 : pos + 8]\n116:         body_end = pos + 8 + length\n117:         chunk_end = body_end + 4\n118:         if chunk_end > len(data):\n119:             _fail(\"PNG has a truncated metadata chunk\")\n120:         body = data[pos + 8 : body_end]\n121:         pos = chunk_end\n122:         if ctype not in (b\"tEXt\", b\"zTXt\", b\"iTXt\"):\n123:             if ctype == b\"IEND\":\n124:                 break\n125:             continue\n126:         key, _, rest = body.partition(b\"\\x00\")\n127:         if key.lower() != b\"mxfile\":\n128:             continue\n129:         try:\n130:             if ctype == b\"tEXt\":\n131:                 value = rest\n132:             elif ctype == b\"zTXt\":\n133:                 value = _decompress_limited(rest[1:], 15)\n134:             else:  # iTXt: compression flag, method, lang, translated key, text\n135:                 flag = rest[0:1]\n136:                 tail = rest[2:].split(b\"\\x00\", 2)[-1]\n137:                 value = _decompress_limited(tail, 15) if flag == b\"\\x01\" else tail\n138:         except PayloadTooLarge:\n139:             _fail(\n140:                 f\"embedded PNG diagram exceeds the \"\n141:                 f\"{MAX_XML_BYTES // (1024 * 1024)} MiB limit\"\n142:             )\n143:         except (IndexError, ValueError, zlib.error):\n144:             _fail(\"PNG has invalid compressed draw.io metadata\")\n145:         return unquote(value.decode(\"utf-8\", \"replace\"))\n146:     return None\n147: \n148: \n149: def _svg_embedded_xml(text: str) -> str | None:\n150:     \"\"\"Pull the ``mxfile`` XML out of a draw.io-exported SVG ``content`` attribute.\"\"\"\n151:     for match in re.finditer(\n152:         r\"\\bcontent\\s*=\\s*([\\\"'])(.*?)\\1\", text, flags=re.IGNORECASE | re.DOTALL\n153:     ):\n154:         candidate = html.unescape(match.group(2))\n155:         if \"<mxfile\" in candidate or \"<mxGraphModel\" in candidate:\n156:             return candidate\n157:     return None\n158: \n159: \n160: def load_mxfile(path: Path) -> str:\n161:     \"\"\"Return the ``<mxfile>`` (or bare ``<mxGraphModel>``) XML for any input.\"\"\"\n162:     size = path.stat().st_size\n163:     if size > MAX_INPUT_BYTES:\n164:         _fail(\n165:             f\"{path.name}: input is {size} bytes; maximum is \"\n166:             f\"{MAX_INPUT_BYTES // (1024 * 1024)} MiB\"\n167:         )\n168:     data = path.read_bytes()\n169:     if data.startswith(PNG_MAGIC):\n170:         xml = _png_embedded_xml(data)\n171:         if not xml:\n172:             _fail(f\"{path.name}: PNG has no embedded draw.io diagram\")\n173:         return xml\n174:     text = data.decode(\"utf-8\", \"replace\").lstrip(\"﻿\").strip()\n175:     if \"<mxfile\" in text or \"<mxGraphModel\" in text:\n176:         return text\n177:     if \"<svg\" in text[:2000]:\n178:         xml = _svg_embedded_xml(text)\n179:         if not xml:\n180:             _fail(f\"{path.name}: SVG has no embedded draw.io diagram\")\n181:         return xml\n182:     inflated = _inflate(text)\n183:     if inflated and \"<mxGraphModel\" in inflated:\n184:         return inflated\n185:     _fail(f\"{path.name}: not a draw.io file (no mxfile, mxGraphModel, or payload)\")\n186: \n187: \n188: # --------------------------------------------------------------------------\n189: # style + label helpers\n190: # --------------------------------------------------------------------------\n191: \n192: BR_RE = re.compile(r\"<br\\s*/?>|</p\\s*>|</div\\s*>\", re.IGNORECASE)\n193: TAG_RE = re.compile(r\"<[^>]+>\")\n194: \n195: \n196: def parse_style(style: str | None) -> dict[str, str]:\n197:     \"\"\"Parse a draw.io semicolon-separated style string into a key/value dict.\n198: \n199:     Args:\n200:         style: The raw style string, or None.\n201: \n202:     Returns:\n203:         A dict of style key to value; bare keys map to \"1\".\n204:     \"\"\"\n205:     out: dict[str, str] = {}\n206:     if not style:\n207:         return out\n208:     for part in style.split(\";\"):\n209:         part = part.strip()\n210:         if not part:\n211:             continue\n212:         key, sep, value = part.partition(\"=\")\n213:         out[key.strip()] = value.strip() if sep else \"1\"\n214:     return out\n215: \n216: \n217: def clean_label(value: str | None) -> str:\n218:     \"\"\"draw.io labels are often HTML fragments; flatten to plain text lines.\"\"\"\n219:     if not value:\n220:         return \"\"\n221:     text = BR_RE.sub(\"\\n\", value)\n222:     text = TAG_RE.sub(\"\", text)\n223:     text = html.unescape(text)\n224:     text = text.replace(\"\\xa0\", \" \")\n225:     lines = [re.sub(r\"[ \\t]+\", \" \", ln).strip() for ln in text.split(\"\\n\")]\n226:     return \"\\n\".join(ln for ln in lines if ln).strip()\n227: \n228: \n229: SHAPE_FAMILIES = (\n230:     (\"mxgraph.aws\", \"aws\"),\n231:     (\"mxgraph.azure\", \"azure\"),\n232:     (\"mxgraph.gcp\", \"gcp\"),\n233:     (\"mxgraph.kubernetes\", \"kubernetes\"),\n234:     (\"mxgraph.cisco\", \"network\"),\n235:     (\"mxgraph.veeam\", \"infra\"),\n236:     (\"mxgraph.flowchart\", \"flowchart\"),\n237:     (\"mxgraph.bpmn\", \"bpmn\"),\n238:     (\"mxgraph.er\", \"er\"),\n239:     (\"mxgraph.sysml\", \"uml\"),\n240:     (\"mxgraph.archimate\", \"archimate\"),\n241: )\n242: \n243: # style key -> canonical shape name, checked in order\n244: SHAPE_KEYS = (\n245:     (\"swimlane\", \"swimlane\"),\n246:     (\"ellipse\", \"ellipse\"),\n247:     (\"rhombus\", \"rhombus\"),\n248:     (\"triangle\", \"triangle\"),\n249:     (\"cylinder\", \"cylinder\"),\n250:     (\"cylinder3\", \"cylinder\"),\n251:     (\"hexagon\", \"hexagon\"),\n252:     (\"cloud\", \"cloud\"),\n253:     (\"actor\", \"actor\"),\n254:     (\"umlActor\", \"actor\"),\n255:     (\"note\", \"note\"),\n256:     (\"card\", \"card\"),\n257:     (\"step\", \"step\"),\n258:     (\"process\", \"process\"),\n259:     (\"parallelogram\", \"parallelogram\"),\n260:     (\"document\", \"document\"),\n261:     (\"datastore\", \"cylinder\"),\n262:     (\"umlLifeline\", \"lifeline\"),\n263:     (\"umlFrame\", \"frame\"),\n264:     (\"table\", \"table\"),\n265:     (\"tableRow\", \"table-row\"),\n266:     (\"partialRectangle\", \"table-row\"),\n267:     (\"image\", \"image\"),\n268:     (\"text\", \"text\"),\n269:     (\"group\", \"group\"),\n270: )\n271: \n272: \n273: def classify_shape(style: dict[str, str]) -> str:\n274:     \"\"\"Map a parsed style to a canonical shape name.\n275: \n276:     Args:\n277:         style: The parsed style dict from parse_style.\n278: \n279:     Returns:\n280:         The canonical shape name (e.g. \"rect\", \"swimlane\", \"icon:aws\").\n281:     \"\"\"\n282:     raw = style.get(\"shape\", \"\")\n283:     if raw:\n284:         for key, name in SHAPE_KEYS:\n285:             if raw == key or raw.startswith(key):\n286:                 return name\n287:         for prefix, family in SHAPE_FAMILIES:\n288:             if raw.startswith(prefix):\n289:                 return f\"icon:{family}\"\n290:         return f\"shape:{raw}\"\n291:     for key, name in SHAPE_KEYS:\n292:         if key in style:\n293:             return name\n294:     if style.get(\"ellipse\") == \"1\":\n295:         return \"ellipse\"\n296:     return \"rect\"\n297: \n298: \n299: def shape_family(shape: str) -> str:\n300:     \"\"\"Return the family name for a canonical shape, stripping icon/shape prefixes.\n301: \n302:     Args:\n303:         shape: The canonical shape name.\n304: \n305:     Returns:\n306:         The part after \"icon:\" or \"shape:\", or the shape itself.\n307:     \"\"\"\n308:     if shape.startswith(\"icon:\"):\n309:         return shape.split(\":\", 1)[1]\n310:     if shape.startswith(\"shape:\"):\n311:         return \"custom\"\n312:     return shape\n313: \n314: \n315: # --------------------------------------------------------------------------\n316: # IR model\n317: # --------------------------------------------------------------------------\n318: \n319: \n320: @dataclass\n321: class Node:\n322:     \"\"\"A vertex with absolute geometry resolved from its parent chain.\"\"\"\n323: \n324:     id: str\n325:     label: str = \"\"\n326:     shape: str = \"rect\"\n327:     parent: str | None = None\n328:     depth: int = 0\n329:     x: float = 0.0\n330:     y: float = 0.0\n331:     w: float = 0.0\n332:     h: float = 0.0\n333:     fill: str = \"\"\n334:     stroke: str = \"\"\n335:     font_color: str = \"\"\n336:     dashed: bool = False\n337:     rounded: bool = False\n338:     container: bool = False\n339:     children: list[str] = field(default_factory=list)\n340:     link: str = \"\"\n341:     attrs: dict[str, str] = field(default_factory=dict)\n342:     in_degree: int = 0\n343:     out_degree: int = 0\n344: \n345: \n346: @dataclass\n347: class Edge:\n348:     \"\"\"A connection between two nodes with style and topology signals.\"\"\"\n349: \n350:     id: str\n351:     source: str | None\n352:     target: str | None\n353:     label: str = \"\"\n354:     dashed: bool = False\n355:     bidirectional: bool = False\n356:     undirected: bool = False\n357:     style_name: str = \"\"\n358:     waypoints: int = 0\n359:     stroke: str = \"\"\n360: \n361: \n362: @dataclass\n363: class Page:\n364:     \"\"\"One draw.io diagram page: a list of nodes and edges.\"\"\"\n365: \n366:     id: str\n367:     name: str\n368:     index: int\n369:     nodes: list[Node] = field(default_factory=list)\n370:     edges: list[Edge] = field(default_factory=list)\n371: \n372:     @property\n373:     def node_map(self) -> dict[str, Node]:\n374:         \"\"\"Return the id -> Node index for this page.\"\"\"\n375:         return {n.id: n for n in self.nodes}\n376: \n377: \n378: def _num(geom: ET.Element | None, key: str) -> float:\n379:     \"\"\"Read a float attribute from an mxGeometry element, defaulting to 0.0.\"\"\"\n380:     if geom is None:\n381:         return 0.0\n382:     try:\n383:         return float(geom.get(key, \"0\") or 0)\n384:     except ValueError:\n385:         return 0.0\n386: \n387: \n388: def parse_page(diagram: ET.Element, index: int) -> Page:\n389:     \"\"\"Parse one ``<diagram>`` element into a Page of absolute-positioned nodes.\n390: \n391:     Args:\n392:         diagram: The ``<diagram>`` XML element (or a bare ``<mxGraphModel>``).\n393:         index: The page's position in the file, used for naming.\n394: \n395:     Returns:\n396:         A Page with resolved nodes and edges; empty when no model is found.\n397:     \"\"\"\n398:     name = diagram.get(\"name\") or f\"Page-{index + 1}\"\n399:     page = Page(id=diagram.get(\"id\") or f\"page-{index}\", name=name, index=index)\n400: \n401:     model = diagram.find(\".//mxGraphModel\")\n402:     if model is None:\n403:         text = (diagram.text or \"\").strip()\n404:         inflated = _inflate(text) if text else None\n405:         if not inflated:\n406:             return page\n407:         _reject_unsafe_xml(inflated, f\"page {index}\")\n408:         model = ET.fromstring(inflated)\n409:         if model.tag != \"mxGraphModel\":\n410:             found = model.find(\".//mxGraphModel\")\n411:             if found is None:\n412:                 return page\n413:             model = found\n414: \n415:     root = model.find(\"root\")\n416:     if root is None:\n417:         return page\n418: \n419:     # Pass 1: collect raw cells, unwrapping <object>/<UserObject> containers.\n420:     raw: dict[str, dict[str, Any]] = {}\n421:     order: list[str] = []\n422:     for element in root:\n423:         if element.tag in (\"object\", \"UserObject\"):\n424:             cell = element.find(\"mxCell\")\n425:             if cell is None:\n426:                 continue\n427:             attrs = {\n428:                 k: v\n429:                 for k, v in element.attrib.items()\n430:                 if k not in (\"id\", \"label\", \"placeholders\")\n431:             }\n432:             cid = element.get(\"id\") or cell.get(\"id\") or \"\"\n433:             value = element.get(\"label\", \"\")\n434:         elif element.tag == \"mxCell\":\n435:             cell = element\n436:             attrs = {}\n437:             cid = cell.get(\"id\") or \"\"\n438:             value = cell.get(\"value\", \"\")\n439:         else:\n440:             continue\n441:         if not cid:\n442:             continue\n443:         raw[cid] = {\"cell\": cell, \"attrs\": attrs, \"value\": value}\n444:         order.append(cid)\n445: \n446:     # Pass 2: vertices (absolute geometry resolved after the pass).\n447:     edge_label_parts: dict[str, list[str]] = {}\n448:     for cid in order:\n449:         entry = raw[cid]\n450:         cell = entry[\"cell\"]\n451:         style = parse_style(cell.get(\"style\"))\n452:         parent = cell.get(\"parent\")\n453:         if cell.get(\"edge\") == \"1\":\n454:             continue\n455:         if cell.get(\"vertex\") != \"1\":\n456:             continue\n457:         # An edge label is a vertex parented to an edge; fold it into the edge.\n458:         parent_entry = raw.get(parent or \"\")\n459:         parent_is_edge = bool(\n460:             parent_entry and parent_entry[\"cell\"].get(\"edge\") == \"1\"\n461:         )\n462:         if parent_is_edge or \"edgeLabel\" in style:\n463:             if parent:\n464:                 text = clean_label(entry[\"value\"])\n465:                 if text:\n466:                     edge_label_parts.setdefault(parent, []).append(text)\n467:             continue\n468: \n469:         geom = cell.find(\"mxGeometry\")\n470:         node = Node(\n471:             id=cid,\n472:             label=clean_label(entry[\"value\"]),\n473:             shape=classify_shape(style),\n474:             parent=parent,\n475:             x=_num(geom, \"x\"),\n476:             y=_num(geom, \"y\"),\n477:             w=_num(geom, \"width\"),\n478:             h=_num(geom, \"height\"),\n479:             fill=style.get(\"fillColor\", \"\"),\n480:             stroke=style.get(\"strokeColor\", \"\"),\n481:             font_color=style.get(\"fontColor\", \"\"),\n482:             dashed=style.get(\"dashed\") == \"1\",\n483:             rounded=style.get(\"rounded\") == \"1\",\n484:             container=style.get(\"container\") == \"1\" or \"swimlane\" in style,\n485:             link=entry[\"attrs\"].get(\"link\", \"\"),\n486:             attrs={\n487:                 k: v\n488:                 for k, v in entry[\"attrs\"].items()\n489:                 if k not in (\"link\", \"tooltip\")\n490:             },\n491:         )\n492:         page.nodes.append(node)\n493: \n494:     node_map = page.node_map\n495: \n496:     # Resolve absolute geometry + depth by walking the parent chain.\n497:     def resolve(node: Node, seen: set[str]) -> tuple[float, float, int]:\n498:         \"\"\"Resolve one node's absolute (x, y, depth) by walking its parent chain.\"\"\"\n499:         if node.id in seen:\n500:             return node.x, node.y, 0\n501:         seen.add(node.id)\n502:         parent = node_map.get(node.parent or \"\")\n503:         if parent is None:\n504:             return node.x, node.y, 0\n505:         px, py, pdepth = resolve(parent, seen)\n506:         return node.x + px, node.y + py, pdepth + 1\n507: \n508:     for node in page.nodes:\n509:         ax, ay, depth = resolve(node, set())\n510:         node.x, node.y, node.depth = ax, ay, depth\n511:         parent = node_map.get(node.parent or \"\")\n512:         if parent is not None:\n513:             parent.children.append(node.id)\n514:             parent.container = True\n515: \n516:     # Pass 3: edges.\n517:     for cid in order:\n518:         entry = raw[cid]\n519:         cell = entry[\"cell\"]\n520:         if cell.get(\"edge\") != \"1\":\n521:             continue\n522:         style = parse_style(cell.get(\"style\"))\n523:         geom = cell.find(\"mxGeometry\")\n524:         waypoints = 0\n525:         if geom is not None:\n526:             waypoints = len(\n527:                 [p for p in geom.findall(\".//mxPoint\") if p.get(\"as\") is None]\n528:             )\n529:         label = clean_label(entry[\"value\"])\n530:         extra = edge_label_parts.get(cid, [])\n531:         if extra:\n532:             label = \" / \".join([p for p in ([label] + extra) if p])\n533:         source = cell.get(\"source\")\n534:         target = cell.get(\"target\")\n535:         page.edges.append(\n536:             Edge(\n537:                 id=cid,\n538:                 source=source if source in node_map else None,\n539:                 target=target if target in node_map else None,\n540:                 label=label,\n541:                 dashed=style.get(\"dashed\") == \"1\",\n542:                 bidirectional=style.get(\"startArrow\", \"none\")\n543:                 not in (\"none\", \"0\", \"\")\n544:                 and style.get(\"endArrow\", \"classic\") not in (\"none\", \"0\"),\n545:                 undirected=style.get(\"endArrow\") in (\"none\", \"0\")\n546:                 and style.get(\"startArrow\", \"none\") in (\"none\", \"0\", \"\"),\n547:                 style_name=style.get(\"shape\", \"\")\n548:                 or (\"orthogonal\" if style.get(\"edgeStyle\") else \"\"),\n549:                 waypoints=waypoints,\n550:                 stroke=style.get(\"strokeColor\", \"\"),\n551:             )\n552:         )\n553: \n554:     for edge in page.edges:\n555:         if edge.source and edge.source in node_map:\n556:             node_map[edge.source].out_degree += 1\n557:         if edge.target and edge.target in node_map:\n558:             node_map[edge.target].in_degree += 1\n559: \n560:     return page\n561: \n562: \n563: def parse_file(path: Path) -> list[Page]:\n564:     \"\"\"Decode any supported draw.io input into a list of pages.\n565: \n566:     Args:\n567:         path: Path to a .drawio, .xml, .drawio.png, or .drawio.svg file.\n568: \n569:     Returns:\n570:         A list of Page objects, one per diagram page.\n571: \n572:     Raises:\n573:         SystemExit: With status 2 for unsupported or unreadable input.\n574:     \"\"\"\n575:     xml = load_mxfile(path)\n576:     _reject_unsafe_xml(xml, path.name)\n577:     try:\n578:         root = ET.fromstring(xml)\n579:     except ET.ParseError as exc:\n580:         _fail(f\"{path.name}: malformed XML ({exc})\")\n581:     if root.tag == \"mxGraphModel\":\n582:         wrapper = ET.Element(\"diagram\", {\"name\": path.stem, \"id\": \"single\"})\n583:         wrapper.append(root)\n584:         return [parse_page(wrapper, 0)]\n585:     diagrams = root.findall(\".//diagram\")\n586:     if not diagrams:\n587:         _fail(f\"{path.name}: mxfile contains no <diagram> pages\")\n588:     return [parse_page(d, i) for i, d in enumerate(diagrams)]\n589: \n590: \n591: # --------------------------------------------------------------------------\n592: # structural analysis — signals, not decisions\n593: # --------------------------------------------------------------------------\n594: \n595: \n596: def _has_cycle(nodes: list[Node], edges: list[Edge]) -> bool:\n597:     \"\"\"Detect a cycle in the edge graph via iterative DFS coloring.\"\"\"\n598:     adjacency: dict[str, list[str]] = {n.id: [] for n in nodes}\n599:     for edge in edges:\n600:         if edge.source and edge.target and edge.source in adjacency:\n601:             adjacency[edge.source].append(edge.target)\n602:     WHITE, GREY, BLACK = 0, 1, 2\n603:     color = {n.id: WHITE for n in nodes}\n604: \n605:     def visit(start: str) -> bool:\n606:         \"\"\"Iterative DFS from `start`; return True if a back-edge (cycle) is found.\"\"\"\n607:         stack = [(start, iter(adjacency.get(start, [])))]\n608:         color[start] = GREY\n609:         while stack:\n610:             nid, it = stack[-1]\n611:             advanced = False\n612:             for nxt in it:\n613:                 state = color.get(nxt, BLACK)\n614:                 if state == GREY:\n615:                     return True\n616:                 if state == WHITE:\n617:                     color[nxt] = GREY\n618:                     stack.append((nxt, iter(adjacency.get(nxt, []))))\n619:                     advanced = True\n620:                     break\n621:             if not advanced:\n622:                 color[nid] = BLACK\n623:                 stack.pop()\n624:         return False\n625: \n626:     return any(color[n.id] == WHITE and visit(n.id) for n in nodes)\n627: \n628: \n629: def _aligned(boxes: list[Node], tolerance: float = 8.0) -> bool:\n630:     \"\"\"True when the boxes stack as lanes — shared left edge or shared top edge.\"\"\"\n631:     if len(boxes) < 2:\n632:         return False\n633:     same_x = max(n.x for n in boxes) - min(n.x for n in boxes) <= tolerance\n634:     same_w = max(n.w for n in boxes) - min(n.w for n in boxes) <= tolerance\n635:     same_y = max(n.y for n in boxes) - min(n.y for n in boxes) <= tolerance\n636:     same_h = max(n.h for n in boxes) - min(n.h for n in boxes) <= tolerance\n637:     return (same_x and same_w) or (same_y and same_h)\n638: \n639: \n640: def analyze(page: Page) -> dict[str, Any]:\n641:     \"\"\"Compute the structural signals the skill uses to pick a type and detail.\n642: \n643:     Args:\n644:         page: The parsed page to analyze.\n645: \n646:     Returns:\n647:         A dict with counts, hubs, type candidates, budget flags, and collapsible groups.\n648:     \"\"\"\n649:     nodes = page.nodes\n650:     edges = page.edges\n651:     drawable = [n for n in nodes if n.shape not in (\"text\",) and (n.label or n.children)]\n652:     containers = [n for n in nodes if n.children]\n653:     leaves = [n for n in nodes if not n.children]\n654:     shapes: dict[str, int] = {}\n655:     for node in nodes:\n656:         shapes[shape_family(node.shape)] = shapes.get(shape_family(node.shape), 0) + 1\n657: \n658:     def name_of(node: Node) -> str:\n659:         \"\"\"Return a single-line display name for a node (label, or its id).\"\"\"\n660:         return (node.label.replace(\"\\n\", \" · \") or node.id)\n661: \n662:     ranked = sorted(\n663:         leaves, key=lambda n: (n.in_degree + n.out_degree), reverse=True\n664:     )\n665:     hubs = [\n666:         {\"id\": n.id, \"label\": name_of(n), \"degree\": n.in_degree + n.out_degree}\n667:         for n in ranked[:5]\n668:         if (n.in_degree + n.out_degree) > 0\n669:     ]\n670:     sources = [name_of(n) for n in leaves if n.out_degree and not n.in_degree]\n671:     sinks = [name_of(n) for n in leaves if n.in_degree and not n.out_degree]\n672:     orphans = [name_of(n) for n in leaves if not n.in_degree and not n.out_degree]\n673: \n674:     # Type candidates, strongest signal first. Advisory only.\n675:     candidates: list[str] = []\n676:     if shapes.get(\"lifeline\"):\n677:         candidates.append(\"sequence\")\n678:     if shapes.get(\"table\") or shapes.get(\"er\"):\n679:         candidates.append(\"er\")\n680:     lanes = [n for n in nodes if n.shape == \"swimlane\" and n.children]\n681:     if len(lanes) >= 2 and _aligned(lanes):\n682:         candidates.append(\"swimlane\")\n683:     if shapes.get(\"rhombus\"):\n684:         candidates.append(\"flowchart\")\n685:     if shapes.get(\"ellipse\", 0) >= max(2, len(leaves) // 3) and edges:\n686:         candidates.append(\"state\")\n687:     if any(f in shapes for f in (\"aws\", \"azure\", \"gcp\", \"kubernetes\", \"network\")):\n688:         candidates.append(\"architecture\")\n689:     if containers and not shapes.get(\"swimlane\"):\n690:         candidates.append(\"nested\")\n691:     if edges and not _has_cycle(nodes, edges) and len(sources) == 1:\n692:         candidates.append(\"tree\")\n693:     if edges:\n694:         candidates.append(\"architecture\")\n695:     if not candidates:\n696:         candidates.append(\"architecture\")\n697: \n698:     seen: set[str] = set()\n699:     candidates = [c for c in candidates if not (c in seen or seen.add(c))]\n700: \n701:     # Collapse candidates: containers whose children are all leaves, and\n702:     # fan-out clusters — the first things to merge when simplifying.\n703:     collapsible = [\n704:         {\n705:             \"id\": c.id,\n706:             \"label\": name_of(c),\n707:             \"children\": len(c.children),\n708:             \"child_labels\": [\n709:                 name_of(page.node_map[cid])\n710:                 for cid in c.children\n711:                 if page.node_map.get(cid) and page.node_map[cid].label\n712:             ][:8],\n713:         }\n714:         for c in containers\n715:         if c.children and all(not page.node_map[cid].children for cid in c.children)\n716:     ]\n717:     collapsible.sort(key=lambda c: c[\"children\"], reverse=True)\n718: \n719:     return {\n720:         \"nodes_total\": len(nodes),\n721:         \"nodes_drawable\": len(drawable),\n722:         \"containers\": len(containers),\n723:         \"leaves\": len(leaves),\n724:         \"edges_total\": len(edges),\n725:         \"edges_labeled\": sum(1 for e in edges if e.label),\n726:         \"edges_dangling\": sum(1 for e in edges if not (e.source and e.target)),\n727:         \"max_depth\": max((n.depth for n in nodes), default=0),\n728:         \"shapes\": dict(sorted(shapes.items(), key=lambda kv: -kv[1])),\n729:         \"has_cycle\": _has_cycle(nodes, edges),\n730:         \"hubs\": hubs,\n731:         \"entry_points\": sources[:6],\n732:         \"terminals\": sinks[:6],\n733:         \"orphans\": orphans[:6],\n734:         \"type_candidates\": candidates[:3],\n735:         \"collapsible_groups\": collapsible[:8],\n736:         \"over_node_budget\": len(drawable) > 9,\n737:         \"over_edge_budget\": len(edges) > 12,\n738:     }\n739: \n740: \n741: # --------------------------------------------------------------------------\n742: # rendering the digest\n743: # --------------------------------------------------------------------------\n744: \n745: \n746: def page_bounds(page: Page) -> tuple[float, float, float, float]:\n747:     \"\"\"Return the (x0, y0, x1, y1) bounds of all positioned nodes.\"\"\"\n748:     boxes = [(n.x, n.y, n.x + n.w, n.y + n.h) for n in page.nodes if n.w and n.h]\n749:     if not boxes:\n750:         return (0.0, 0.0, 0.0, 0.0)\n751:     return (\n752:         min(b[0] for b in boxes),\n753:         min(b[1] for b in boxes),\n754:         max(b[2] for b in boxes),\n755:         max(b[3] for b in boxes),\n756:     )\n757: \n758: \n759: def digest(path: Path, pages: list[Page], selected: list[Page], max_rows: int) -> str:\n760:     \"\"\"Render a compact Markdown digest of the selected pages.\n761: \n762:     Args:\n763:         path: The source file path, used for the header line.\n764:         pages: All pages in the file, used for the summary line.\n765:         selected: The pages to render in detail.\n766:         max_rows: Cap on rows per table.\n767: \n768:     Returns:\n769:         The Markdown digest as a string.\n770:     \"\"\"\n771:     out: list[str] = []\n772:     out.append(f\"# draw.io IR — {path.name}\")\n773:     out.append(\"\")\n774:     out.append(\n775:         f\"{len(pages)} page(s): \"\n776:         + \", \".join(f\"[{p.index}] {p.name} ({len(p.nodes)}n/{len(p.edges)}e)\" for p in pages)\n777:     )\n778:     for page in selected:\n779:         info = analyze(page)\n780:         x0, y0, x1, y1 = page_bounds(page)\n781:         out.append(\"\")\n782:         out.append(f\"## Page {page.index} — {page.name}\")\n783:         out.append(\"\")\n784:         out.append(\n785:             f\"- source canvas: {int(x1 - x0)}×{int(y1 - y0)} px \"\n786:             f\"(aspect {((x1 - x0) / (y1 - y0)):.2f})\"\n787:             if y1 > y0\n788:             else \"- source canvas: empty\"\n789:         )\n790:         out.append(\n791:             f\"- nodes: {info['nodes_total']} total / {info['nodes_drawable']} drawable \"\n792:             f\"/ {info['containers']} containers, depth {info['max_depth']}\"\n793:         )\n794:         out.append(\n795:             f\"- edges: {info['edges_total']} ({info['edges_labeled']} labeled, \"\n796:             f\"{info['edges_dangling']} dangling), cycle: {info['has_cycle']}\"\n797:         )\n798:         out.append(f\"- shapes: {info['shapes']}\")\n799:         out.append(f\"- type candidates: {', '.join(info['type_candidates'])}\")\n800:         out.append(\n801:             f\"- budget: nodes {'OVER' if info['over_node_budget'] else 'ok'} (max 9), \"\n802:             f\"edges {'OVER' if info['over_edge_budget'] else 'ok'} (max 12)\"\n803:         )\n804:         if info[\"hubs\"]:\n805:             hubs = \", \".join(f\"{h['label'] or h['id']}({h['degree']})\" for h in info[\"hubs\"])\n806:             out.append(f\"- hubs (focal candidates): {hubs}\")\n807:         if info[\"entry_points\"]:\n808:             out.append(f\"- entry points: {', '.join(info['entry_points'])}\")\n809:         if info[\"terminals\"]:\n810:             out.append(f\"- terminals: {', '.join(info['terminals'])}\")\n811:         if info[\"orphans\"]:\n812:             out.append(f\"- unconnected: {', '.join(info['orphans'])}\")\n813:         if info[\"collapsible_groups\"]:\n814:             out.append(\"- collapsible groups (simplify here first):\")\n815:             for group in info[\"collapsible_groups\"]:\n816:                 kids = \", \".join(group[\"child_labels\"])\n817:                 out.append(f\"  - {group['label']} — {group['children']} children: {kids}\")\n818: \n819:         out.append(\"\")\n820:         out.append(\"### Nodes\")\n821:         out.append(\"\")\n822:         out.append(\"| id | label | shape | depth | parent | deg | box |\")\n823:         out.append(\"|---|---|---|---|---|---|---|\")\n824:         listed = [n for n in page.nodes if n.label or n.children]\n825:         for node in listed[:max_rows]:\n826:             label = node.label.replace(\"\\n\", \" ⏎ \").replace(\"|\", \"\\\\|\")\n827:             out.append(\n828:                 f\"| {node.id} | {label} | {node.shape} | {node.depth} | \"\n829:                 f\"{node.parent or '-'} | {node.in_degree}/{node.out_degree} | \"\n830:                 f\"{int(node.x)},{int(node.y)} {int(node.w)}×{int(node.h)} |\"\n831:             )\n832:         if len(listed) > max_rows:\n833:             out.append(f\"| … | +{len(listed) - max_rows} more (use --json) | | | | | |\")\n834: \n835:         out.append(\"\")\n836:         out.append(\"### Edges\")\n837:         out.append(\"\")\n838:         out.append(\"| source | target | label | style |\")\n839:         out.append(\"|---|---|---|---|\")\n840:         names = {n.id: (n.label.split(\"\\n\")[0] or n.id) for n in page.nodes}\n841:         for edge in page.edges[:max_rows]:\n842:             marks = []\n843:             if edge.dashed:\n844:                 marks.append(\"dashed\")\n845:             if edge.bidirectional:\n846:                 marks.append(\"bidir\")\n847:             if edge.undirected:\n848:                 marks.append(\"undirected\")\n849:             out.append(\n850:                 f\"| {names.get(edge.source or '', '?')} | {names.get(edge.target or '', '?')} \"\n851:                 f\"| {edge.label.replace('|', chr(92) + '|') or '-'} | {' '.join(marks) or '-'} |\"\n852:             )\n853:         if len(page.edges) > max_rows:\n854:             out.append(f\"| … | +{len(page.edges) - max_rows} more (use --json) | | |\")\n855:     out.append(\"\")\n856:     return \"\\n\".join(out)\n857: \n858: \n859: def to_json(path: Path, pages: list[Page], selected: list[Page]) -> str:\n860:     \"\"\"Serialize the full IR of the selected pages as JSON.\n861: \n862:     Args:\n863:         path: The source file path, recorded in the payload.\n864:         pages: All pages in the file.\n865:         selected: The pages to serialize.\n866: \n867:     Returns:\n868:         A JSON string with bounds, analysis, nodes, and edges per page.\n869:     \"\"\"\n870:     payload = {\n871:         \"source\": str(path),\n872:         \"pages_total\": len(pages),\n873:         \"pages\": [\n874:             {\n875:                 \"id\": p.id,\n876:                 \"name\": p.name,\n877:                 \"index\": p.index,\n878:                 \"bounds\": dict(zip((\"x0\", \"y0\", \"x1\", \"y1\"), page_bounds(p))),\n879:                 \"analysis\": analyze(p),\n880:                 \"nodes\": [asdict(n) for n in p.nodes],\n881:                 \"edges\": [asdict(e) for e in p.edges],\n882:             }\n883:             for p in selected\n884:         ],\n885:     }\n886:     return json.dumps(payload, indent=2, ensure_ascii=False)\n887: \n888: \n889: def select_pages(pages: list[Page], selector: str | None) -> list[Page]:\n890:     \"\"\"Resolve a --page selector to a concrete page list.\n891: \n892:     Args:\n893:         pages: All parsed pages.\n894:         selector: None, \"all\", a page index, or a page name.\n895: \n896:     Returns:\n897:         The matching pages.\n898: \n899:     Raises:\n900:         SystemExit: With status 2 when the selector matches nothing.\n901:     \"\"\"\n902:     if selector is None:\n903:         return pages if len(pages) == 1 else pages[:1]\n904:     if selector == \"all\":\n905:         return pages\n906:     if selector.isdigit():\n907:         index = int(selector)\n908:         match = [p for p in pages if p.index == index]\n909:         if not match:\n910:             _fail(f\"no page with index {index} (have 0..{len(pages) - 1})\")\n911:         return match\n912:     match = [p for p in pages if p.name.lower() == selector.lower()]\n913:     if not match:\n914:         names = \", \".join(p.name for p in pages)\n915:         _fail(f\"no page named {selector!r} (have: {names})\")\n916:     return match\n917: \n918: \n919: def main(argv: list[str] | None = None) -> int:\n920:     \"\"\"Run the draw.io extractor CLI.\n921: \n922:     Args:\n923:         argv: Command-line arguments; defaults to sys.argv[1:].\n924: \n925:     Returns:\n926:         The process exit code (0 on success, 2 on unreadable input).\n927:     \"\"\"\n928:     parser = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n929:     parser.add_argument(\"file\", help=\".drawio / .xml / .drawio.png / .drawio.svg\")\n930:     parser.add_argument(\n931:         \"--page\",\n932:         help=\"page index, page name, or 'all' (default: first page)\",\n933:     )\n934:     parser.add_argument(\"--json\", action=\"store_true\", help=\"emit the full IR as JSON\")\n935:     parser.add_argument(\n936:         \"--max-rows\",\n937:         type=int,\n938:         default=40,\n939:         help=\"rows per table in the Markdown digest (default 40)\",\n940:     )\n941:     parser.add_argument(\"--out\", help=\"write to this path instead of stdout\")\n942:     args = parser.parse_args(argv)\n943: \n944:     if args.max_rows < 1:\n945:         parser.error(\"--max-rows must be at least 1\")\n946: \n947:     path = Path(args.file)\n948:     if not path.is_file():\n949:         _fail(f\"{path}: no such file\")\n950: \n951:     pages = parse_file(path)\n952:     selected = select_pages(pages, args.page)\n953:     text = (\n954:         to_json(path, pages, selected)\n955:         if args.json\n956:         else digest(path, pages, selected, args.max_rows)\n957:     )\n958:     if args.out:\n959:         Path(args.out).write_text(text, encoding=\"utf-8\")\n960:         print(f\"wrote {args.out} ({len(text)} bytes)\")\n961:     else:\n962:         sys.stdout.write(text if text.endswith(\"\\n\") else text + \"\\n\")\n963:     return 0\n964: \n965: \n966: if __name__ == \"__main__\":\n967:     raise SystemExit(main())\n\n(End of file - total 967 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: DRAWIO IR EXTRACTOR\n# ───────────────────────────────────────────────────────────────\n\"\"\"Extract a normalized intermediate representation (IR) from a draw.io file.\n\nThe deterministic half of the draw.io import flow: this script never makes a\ndesign decision. It decodes whatever draw.io wrote (raw XML, deflate+base64\npayloads, PNG/SVG files with an embedded ``mxfile``), flattens the mxGraphModel\ninto absolute-positioned nodes and edges, and reports structural signals — hubs,\ncontainers, depth, cycles, leaf clusters — that the skill uses to pick a diagram\ntype and a level of detail.\n\nUsage:\n    python3 drawio_extract.py <file.drawio> [--page N|NAME] [--json]\n                             [--max-rows N] [--out PATH]\n\nDefault output is a compact Markdown digest meant to be read into context.\n``--json`` emits the full IR instead (every node, every edge, every style).\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/drawio_extract.py","text":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: DRAWIO IR EXTRACTOR\n# ───────────────────────────────────────────────────────────────\n\"\"\"Extract a normalized intermediate representation (IR) from a draw.io file.\n\nThe deterministic half of the draw.io import flow: this script never makes a\ndesign decision. It decodes whatever draw.io wrote (raw XML, deflate+base64\npayloads, PNG/SVG files with an embedded ``mxfile``), flattens the mxGraphModel\ninto absolute-positioned nodes and edges, and reports structural signals — hubs,\ncontainers, depth, cycles, leaf clusters — that the skill uses to pick a diagram\ntype and a level of detail.\n\nUsage:\n    python3 drawio_extract.py <file.drawio> [--page N|NAME] [--json]\n                             [--max-rows N] [--out PATH]\n\nDefault output is a compact Markdown digest meant to be read into context.\n``--json`` emits the full IR instead (every node, every edge, every style).\n\nExit codes: 0 ok, 2 unreadable / unsupported input.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport base64\nimport html\nimport json\nimport re\nimport struct\nimport sys\nimport zlib\nfrom dataclasses import dataclass, field, asdict\nfrom pathlib import Path\nfrom typing import Any\nfrom urllib.parse import unquote\nfrom xml.etree import ElementTree as ET\n\n# --------------------------------------------------------------------------\n# container / payload decoding\n# --------------------------------------------------------------------------\n\nPNG_MAGIC = b\"\\x89PNG\\r\\n\\x1a\\n\"\nMAX_INPUT_BYTES = 32 * 1024 * 1024\nMAX_XML_BYTES = 64 * 1024 * 1024\n\n\nclass PayloadTooLarge(ValueError):\n    \"\"\"Raised when compressed metadata expands beyond the supported limit.\"\"\"\n\n\ndef _fail(msg: str) -> \"NoReturn\":  # type: ignore[valid-type]\n    \"\"\"Print an error to stderr and exit with status 2.\"\"\"\n    print(f\"drawio_extract: {msg}\", file=sys.stderr)\n    raise SystemExit(2)\n\n\ndef _reject_unsafe_xml(xml: str, source: str) -> None:\n    \"\"\"Reject declarations that can make XML parsing expand external data.\"\"\"\n    upper = xml.upper()\n    if \"<!DOCTYPE\" in upper or \"<!ENTITY\" in upper:\n        _fail(f\"{source}: DTD and entity declarations are not supported\")\n\n\ndef _decompress_limited(data: bytes, wbits: int, limit: int = MAX_XML_BYTES) -> bytes:\n    \"\"\"Decompress without allowing a small payload to expand without bound.\"\"\"\n    decompressor = zlib.decompressobj(wbits)\n    output = bytearray()\n    chunk = data\n    while chunk:\n        remaining = limit + 1 - len(output)\n        if remaining <= 0:\n            raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n        output.extend(decompressor.decompress(chunk, remaining))\n        if len(output) > limit:\n            raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n        chunk = decompressor.unconsumed_tail\n    if not decompressor.eof:\n        raise zlib.error(\"incomplete compressed payload\")\n    remaining = limit + 1 - len(output)\n    if remaining <= 0:\n        raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n    output.extend(decompressor.flush(remaining))\n    if len(output) > limit:\n        raise PayloadTooLarge(f\"decoded payload exceeds {limit} bytes\")\n    return bytes(output)\n\n\ndef _inflate(payload: str) -> str | None:\n    \"\"\"Undo draw.io's base64 + raw-deflate + URL-encoding pipeline.\"\"\"\n    try:\n        raw = base64.b64decode(payload, validate=False)\n    except Exception:\n        return None\n    for wbits in (-15, 15, 47):\n        try:\n            text = _decompress_limited(raw, wbits).decode(\"utf-8\", \"replace\")\n        except PayloadTooLarge:\n            _fail(\n                f\"decoded diagram exceeds the {MAX_XML_BYTES // (1024 * 1024)} MiB limit\"\n            )\n        except Exception:\n            continue\n        # draw.io URL-encodes before deflating; unquote is a no-op if it didn't.\n        return unquote(text)\n    return None\n\n\ndef _png_embedded_xml(data: bytes) -> str | None:\n    \"\"\"Pull the ``mxfile`` tEXt/zTXt chunk out of a draw.io-exported PNG.\"\"\"\n    pos = len(PNG_MAGIC)\n    while pos + 8 <= len(data):\n        (length,) = struct.unpack(\">I\", data[pos : pos + 4])\n        ctype = data[pos + 4 : pos + 8]\n        body_end = pos + 8 + length\n        chunk_end = body_end + 4\n        if chunk_end > len(data):\n            _fail(\"PNG has a truncated metadata chunk\")\n        body = data[pos + 8 : body_end]\n        pos = chunk_end\n        if ctype not in (b\"tEXt\", b\"zTXt\", b\"iTXt\"):\n            if ctype == b\"IEND\":\n                break\n            continue\n        key, _, rest = body.partition(b\"\\x00\")\n        if key.lower() != b\"mxfile\":\n            continue\n        try:\n            if ctype == b\"tEXt\":\n                value = rest\n            elif ctype == b\"zTXt\":\n                value = _decompress_limited(rest[1:], 15)\n            else:  # iTXt: compression flag, method, lang, translated key, text\n                flag = rest[0:1]\n                tail = rest[2:].split(b\"\\x00\", 2)[-1]\n                value = _decompress_limited(tail, 15) if flag == b\"\\x01\" else tail\n        except PayloadTooLarge:\n            _fail(\n                f\"embedded PNG diagram exceeds the \"\n                f\"{MAX_XML_BYTES // (1024 * 1024)} MiB limit\"\n            )\n        except (IndexError, ValueError, zlib.error):\n            _fail(\"PNG has invalid compressed draw.io metadata\")\n        return unquote(value.decode(\"utf-8\", \"replace\"))\n    return None\n\n\ndef _svg_embedded_xml(text: str) -> str | None:\n    \"\"\"Pull the ``mxfile`` XML out of a draw.io-exported SVG ``content`` attribute.\"\"\"\n    for match in re.finditer(\n        r\"\\bcontent\\s*=\\s*([\\\"'])(.*?)\\1\", text, flags=re.IGNORECASE | re.DOTALL\n    ):\n        candidate = html.unescape(match.group(2))\n        if \"<mxfile\" in candidate or \"<mxGraphModel\" in candidate:\n            return candidate\n    return None\n\n\ndef load_mxfile(path: Path) -> str:\n    \"\"\"Return the ``<mxfile>`` (or bare ``<mxGraphModel>``) XML for any input.\"\"\"\n    size = path.stat().st_size\n    if size > MAX_INPUT_BYTES:\n        _fail(\n            f\"{path.name}: input is {size} bytes; maximum is \"\n            f\"{MAX_INPUT_BYTES // (1024 * 1024)} MiB\"\n        )\n    data = path.read_bytes()\n    if data.startswith(PNG_MAGIC):\n        xml = _png_embedded_xml(data)\n        if not xml:\n            _fail(f\"{path.name}: PNG has no embedded draw.io diagram\")\n        return xml\n    text = data.decode(\"utf-8\", \"replace\").lstrip(\"﻿\").strip()\n    if \"<mxfile\" in text or \"<mxGraphModel\" in text:\n        return text\n    if \"<svg\" in text[:2000]:\n        xml = _svg_embedded_xml(text)\n        if not xml:\n            _fail(f\"{path.name}: SVG has no embedded draw.io diagram\")\n        return xml\n    inflated = _inflate(text)\n    if inflated and \"<mxGraphModel\" in inflated:\n        return inflated\n    _fail(f\"{path.name}: not a draw.io file (no mxfile, mxGraphModel, or payload)\")\n\n\n# --------------------------------------------------------------------------\n# style + label helpers\n# --------------------------------------------------------------------------\n\nBR_RE = re.compile(r\"<br\\s*/?>|</p\\s*>|</div\\s*>\", re.IGNORECASE)\nTAG_RE = re.compile(r\"<[^>]+>\")\n\n\ndef parse_style(style: str | None) -> dict[str, str]:\n    \"\"\"Parse a draw.io semicolon-separated style string into a key/value dict.\n\n    Args:\n        style: The raw style string, or None.\n\n    Returns:\n        A dict of style key to value; bare keys map to \"1\".\n    \"\"\"\n    out: dict[str, str] = {}\n    if not style:\n        return out\n    for part in style.split(\";\"):\n        part = part.strip()\n        if not part:\n            continue\n        key, sep, value = part.partition(\"=\")\n        out[key.strip()] = value.strip() if sep else \"1\"\n    return out\n\n\ndef clean_label(value: str | None) -> str:\n    \"\"\"draw.io labels are often HTML fragments; flatten to plain text lines.\"\"\"\n    if not value:\n        return \"\"\n    text = BR_RE.sub(\"\\n\", value)\n    text = TAG_RE.sub(\"\", text)\n    text = html.unescape(text)\n    text = text.replace(\"\\xa0\", \" \")\n    lines = [re.sub(r\"[ \\t]+\", \" \", ln).strip() for ln in text.split(\"\\n\")]\n    return \"\\n\".join(ln for ln in lines if ln).strip()\n\n\nSHAPE_FAMILIES = (\n    (\"mxgraph.aws\", \"aws\"),\n    (\"mxgraph.azure\", \"azure\"),\n    (\"mxgraph.gcp\", \"gcp\"),\n    (\"mxgraph.kubernetes\", \"kubernetes\"),\n    (\"mxgraph.cisco\", \"network\"),\n    (\"mxgraph.veeam\", \"infra\"),\n    (\"mxgraph.flowchart\", \"flowchart\"),\n    (\"mxgraph.bpmn\", \"bpmn\"),\n    (\"mxgraph.er\", \"er\"),\n    (\"mxgraph.sysml\", \"uml\"),\n    (\"mxgraph.archimate\", \"archimate\"),\n)\n\n# style key -> canonical shape name, checked in order\nSHAPE_KEYS = (\n    (\"swimlane\", \"swimlane\"),\n    (\"ellipse\", \"ellipse\"),\n    (\"rhombus\", \"rhombus\"),\n    (\"triangle\", \"triangle\"),\n    (\"cylinder\", \"cylinder\"),\n    (\"cylinder3\", \"cylinder\"),\n    (\"hexagon\", \"hexagon\"),\n    (\"cloud\", \"cloud\"),\n    (\"actor\", \"actor\"),\n    (\"umlActor\", \"actor\"),\n    (\"note\", \"note\"),\n    (\"card\", \"card\"),\n    (\"step\", \"step\"),\n    (\"process\", \"process\"),\n    (\"parallelogram\", \"parallelogram\"),\n    (\"document\", \"document\"),\n    (\"datastore\", \"cylinder\"),\n    (\"umlLifeline\", \"lifeline\"),\n    (\"umlFrame\", \"frame\"),\n    (\"table\", \"table\"),\n    (\"tableRow\", \"table-row\"),\n    (\"partialRectangle\", \"table-row\"),\n    (\"image\", \"image\"),\n    (\"text\", \"text\"),\n    (\"group\", \"group\"),\n)\n\n\ndef classify_shape(style: dict[str, str]) -> str:\n    \"\"\"Map a parsed style to a canonical shape name.\n\n    Args:\n        style: The parsed style dict from parse_style.\n\n    Returns:\n        The canonical shape name (e.g. \"rect\", \"swimlane\", \"icon:aws\").\n    \"\"\"\n    raw = style.get(\"shape\", \"\")\n    if raw:\n        for key, name in SHAPE_KEYS:\n            if raw == key or raw.startswith(key):\n                return name\n        for prefix, family in SHAPE_FAMILIES:\n            if raw.startswith(prefix):\n                return f\"icon:{family}\"\n        return f\"shape:{raw}\"\n    for key, name in SHAPE_KEYS:\n        if key in style:\n            return name\n    if style.get(\"ellipse\") == \"1\":\n        return \"ellipse\"\n    return \"rect\"\n\n\ndef shape_family(shape: str) -> str:\n    \"\"\"Return the family name for a canonical shape, stripping icon/shape prefixes.\n\n    Args:\n        shape: The canonical shape name.\n\n    Returns:\n        The part after \"icon:\" or \"shape:\", or the shape itself.\n    \"\"\"\n    if shape.startswith(\"icon:\"):\n        return shape.split(\":\", 1)[1]\n    if shape.startswith(\"shape:\"):\n        return \"custom\"\n    return shape\n\n\n# --------------------------------------------------------------------------\n# IR model\n# --------------------------------------------------------------------------\n\n\n@dataclass\nclass Node:\n    \"\"\"A vertex with absolute geometry resolved from its parent chain.\"\"\"\n\n    id: str\n    label: str = \"\"\n    shape: str = \"rect\"\n    parent: str | None = None\n    depth: int = 0\n    x: float = 0.0\n    y: float = 0.0\n    w: float = 0.0\n    h: float = 0.0\n    fill: str = \"\"\n    stroke: str = \"\"\n    font_color: str = \"\"\n    dashed: bool = False\n    rounded: bool = False\n    container: bool = False\n    children: list[str] = field(default_factory=list)\n    link: str = \"\"\n    attrs: dict[str, str] = field(default_factory=dict)\n    in_degree: int = 0\n    out_degree: int = 0\n\n\n@dataclass\nclass Edge:\n    \"\"\"A connection between two nodes with style and topology signals.\"\"\"\n\n    id: str\n    source: str | None\n    target: str | None\n    label: str = \"\"\n    dashed: bool = False\n    bidirectional: bool = False\n    undirected: bool = False\n    style_name: str = \"\"\n    waypoints: int = 0\n    stroke: str = \"\"\n\n\n@dataclass\nclass Page:\n    \"\"\"One draw.io diagram page: a list of nodes and edges.\"\"\"\n\n    id: str\n    name: str\n    index: int\n    nodes: list[Node] = field(default_factory=list)\n    edges: list[Edge] = field(default_factory=list)\n\n    @property\n    def node_map(self) -> dict[str, Node]:\n        \"\"\"Return the id -> Node index for this page.\"\"\"\n        return {n.id: n for n in self.nodes}\n\n\ndef _num(geom: ET.Element | None, key: str) -> float:\n    \"\"\"Read a float attribute from an mxGeometry element, defaulting to 0.0.\"\"\"\n    if geom is None:\n        return 0.0\n    try:\n        return float(geom.get(key, \"0\") or 0)\n    except ValueError:\n        return 0.0\n\n\ndef parse_page(diagram: ET.Element, index: int) -> Page:\n    \"\"\"Parse one ``<diagram>`` element into a Page of absolute-positioned nodes.\n\n    Args:\n        diagram: The ``<diagram>`` XML element (or a bare ``<mxGraphModel>``).\n        index: The page's position in the file, used for naming.\n\n    Returns:\n        A Page with resolved nodes and edges; empty when no model is found.\n    \"\"\"\n    name = diagram.get(\"name\") or f\"Page-{index + 1}\"\n    page = Page(id=diagram.get(\"id\") or f\"page-{index}\", name=name, index=index)\n\n    model = diagram.find(\".//mxGraphModel\")\n    if model is None:\n        text = (diagram.text or \"\").strip()\n        inflated = _inflate(text) if text else None\n        if not inflated:\n            return page\n        _reject_unsafe_xml(inflated, f\"page {index}\")\n        model = ET.fromstring(inflated)\n        if model.tag != \"mxGraphModel\":\n            found = model.find(\".//mxGraphModel\")\n            if found is None:\n                return page\n            model = found\n\n    root = model.find(\"root\")\n    if root is None:\n        return page\n\n    # Pass 1: collect raw cells, unwrapping <object>/<UserObject> containers.\n    raw: dict[str, dict[str, Any]] = {}\n    order: list[str] = []\n    for element in root:\n        if element.tag in (\"object\", \"UserObject\"):\n            cell = element.find(\"mxCell\")\n            if cell is None:\n                continue\n            attrs = {\n                k: v\n                for k, v in element.attrib.items()\n                if k not in (\"id\", \"label\", \"placeholders\")\n            }\n            cid = element.get(\"id\") or cell.get(\"id\") or \"\"\n            value = element.get(\"label\", \"\")\n        elif element.tag == \"mxCell\":\n            cell = element\n            attrs = {}\n            cid = cell.get(\"id\") or \"\"\n            value = cell.get(\"value\", \"\")\n        else:\n            continue\n        if not cid:\n            continue\n        raw[cid] = {\"cell\": cell, \"attrs\": attrs, \"value\": value}\n        order.append(cid)\n\n    # Pass 2: vertices (absolute geometry resolved after the pass).\n    edge_label_parts: dict[str, list[str]] = {}\n    for cid in order:\n        entry = raw[cid]\n        cell = entry[\"cell\"]\n        style = parse_style(cell.get(\"style\"))\n        parent = cell.get(\"parent\")\n        if cell.get(\"edge\") == \"1\":\n            continue\n        if cell.get(\"vertex\") != \"1\":\n            continue\n        # An edge label is a vertex parented to an edge; fold it into the edge.\n        parent_entry = raw.get(parent or \"\")\n        parent_is_edge = bool(\n            parent_entry and parent_entry[\"cell\"].get(\"edge\") == \"1\"\n        )\n        if parent_is_edge or \"edgeLabel\" in style:\n            if parent:\n                text = clean_label(entry[\"value\"])\n                if text:\n                    edge_label_parts.setdefault(parent, []).append(text)\n            continue\n\n        geom = cell.find(\"mxGeometry\")\n        node = Node(\n            id=cid,\n            label=clean_label(entry[\"value\"]),\n            shape=classify_shape(style),\n            parent=parent,\n            x=_num(geom, \"x\"),\n            y=_num(geom, \"y\"),\n            w=_num(geom, \"width\"),\n            h=_num(geom, \"height\"),\n            fill=style.get(\"fillColor\", \"\"),\n            stroke=style.get(\"strokeColor\", \"\"),\n            font_color=style.get(\"fontColor\", \"\"),\n            dashed=style.get(\"dashed\") == \"1\",\n            rounded=style.get(\"rounded\") == \"1\",\n            container=style.get(\"container\") == \"1\" or \"swimlane\" in style,\n            link=entry[\"attrs\"].get(\"link\", \"\"),\n            attrs={\n                k: v\n                for k, v in entry[\"attrs\"].items()\n                if k not in (\"link\", \"tooltip\")\n            },\n        )\n        page.nodes.append(node)\n\n    node_map = page.node_map\n\n    # Resolve absolute geometry + depth by walking the parent chain.\n    def resolve(node: Node, seen: set[str]) -> tuple[float, float, int]:\n        \"\"\"Resolve one node's absolute (x, y, depth) by walking its parent chain.\"\"\"\n        if node.id in seen:\n            return node.x, node.y, 0\n        seen.add(node.id)\n        parent = node_map.get(node.parent or \"\")\n        if parent is None:\n            return node.x, node.y, 0\n        px, py, pdepth = resolve(parent, seen)\n        return node.x + px, node.y + py, pdepth + 1\n\n    for node in page.nodes:\n        ax, ay, depth = resolve(node, set())\n        node.x, node.y, node.depth = ax, ay, depth\n        parent = node_map.get(node.parent or \"\")\n        if parent is not None:\n            parent.children.append(node.id)\n            parent.container = True\n\n    # Pass 3: edges.\n    for cid in order:\n        entry = raw[cid]\n        cell = entry[\"cell\"]\n        if cell.get(\"edge\") != \"1\":\n            continue\n        style = parse_style(cell.get(\"style\"))\n        geom = cell.find(\"mxGeometry\")\n        waypoints = 0\n        if geom is not None:\n            waypoints = len(\n                [p for p in geom.findall(\".//mxPoint\") if p.get(\"as\") is None]\n            )\n        label = clean_label(entry[\"value\"])\n        extra = edge_label_parts.get(cid, [])\n        if extra:\n            label = \" / \".join([p for p in ([label] + extra) if p])\n        source = cell.get(\"source\")\n        target = cell.get(\"target\")\n        page.edges.append(\n            Edge(\n                id=cid,\n                source=source if source in node_map else None,\n                target=target if target in node_map else None,\n                label=label,\n                dashed=style.get(\"dashed\") == \"1\",\n                bidirectional=style.get(\"startArrow\", \"none\")\n                not in (\"none\", \"0\", \"\")\n                and style.get(\"endArrow\", \"classic\") not in (\"none\", \"0\"),\n                undirected=style.get(\"endArrow\") in (\"none\", \"0\")\n                and style.get(\"startArrow\", \"none\") in (\"none\", \"0\", \"\"),\n                style_name=style.get(\"shape\", \"\")\n                or (\"orthogonal\" if style.get(\"edgeStyle\") else \"\"),\n                waypoints=waypoints,\n                stroke=style.get(\"strokeColor\", \"\"),\n            )\n        )\n\n    for edge in page.edges:\n        if edge.source and edge.source in node_map:\n            node_map[edge.source].out_degree += 1\n        if edge.target and edge.target in node_map:\n            node_map[edge.target].in_degree += 1\n\n    return page\n\n\ndef parse_file(path: Path) -> list[Page]:\n    \"\"\"Decode any supported draw.io input into a list of pages.\n\n    Args:\n        path: Path to a .drawio, .xml, .drawio.png, or .drawio.svg file.\n\n    Returns:\n        A list of Page objects, one per diagram page.\n\n    Raises:\n        SystemExit: With status 2 for unsupported or unreadable input.\n    \"\"\"\n    xml = load_mxfile(path)\n    _reject_unsafe_xml(xml, path.name)\n    try:\n        root = ET.fromstring(xml)\n    except ET.ParseError as exc:\n        _fail(f\"{path.name}: malformed XML ({exc})\")\n    if root.tag == \"mxGraphModel\":\n        wrapper = ET.Element(\"diagram\", {\"name\": path.stem, \"id\": \"single\"})\n        wrapper.append(root)\n        return [parse_page(wrapper, 0)]\n    diagrams = root.findall(\".//diagram\")\n    if not diagrams:\n        _fail(f\"{path.name}: mxfile contains no <diagram> pages\")\n    return [parse_page(d, i) for i, d in enumerate(diagrams)]\n\n\n# --------------------------------------------------------------------------\n# structural analysis — signals, not decisions\n# --------------------------------------------------------------------------\n\n\ndef _has_cycle(nodes: list[Node], edges: list[Edge]) -> bool:\n    \"\"\"Detect a cycle in the edge graph via iterative DFS coloring.\"\"\"\n    adjacency: dict[str, list[str]] = {n.id: [] for n in nodes}\n    for edge in edges:\n        if edge.source and edge.target and edge.source in adjacency:\n            adjacency[edge.source].append(edge.target)\n    WHITE, GREY, BLACK = 0, 1, 2\n    color = {n.id: WHITE for n in nodes}\n\n    def visit(start: str) -> bool:\n        \"\"\"Iterative DFS from `start`; return True if a back-edge (cycle) is found.\"\"\"\n        stack = [(start, iter(adjacency.get(start, [])))]\n        color[start] = GREY\n        while stack:\n            nid, it = stack[-1]\n            advanced = False\n            for nxt in it:\n                state = color.get(nxt, BLACK)\n                if state == GREY:\n                    return True\n                if state == WHITE:\n                    color[nxt] = GREY\n                    stack.append((nxt, iter(adjacency.get(nxt, []))))\n                    advanced = True\n                    break\n            if not advanced:\n                color[nid] = BLACK\n                stack.pop()\n        return False\n\n    return any(color[n.id] == WHITE and visit(n.id) for n in nodes)\n\n\ndef _aligned(boxes: list[Node], tolerance: float = 8.0) -> bool:\n    \"\"\"True when the boxes stack as lanes — shared left edge or shared top edge.\"\"\"\n    if len(boxes) < 2:\n        return False\n    same_x = max(n.x for n in boxes) - min(n.x for n in boxes) <= tolerance\n    same_w = max(n.w for n in boxes) - min(n.w for n in boxes) <= tolerance\n    same_y = max(n.y for n in boxes) - min(n.y for n in boxes) <= tolerance\n    same_h = max(n.h for n in boxes) - min(n.h for n in boxes) <= tolerance\n    return (same_x and same_w) or (same_y and same_h)\n\n\ndef analyze(page: Page) -> dict[str, Any]:\n    \"\"\"Compute the structural signals the skill uses to pick a type and detail.\n\n    Args:\n        page: The parsed page to analyze.\n\n    Returns:\n        A dict with counts, hubs, type candidates, budget flags, and collapsible groups.\n    \"\"\"\n    nodes = page.nodes\n    edges = page.edges\n    drawable = [n for n in nodes if n.shape not in (\"text\",) and (n.label or n.children)]\n    containers = [n for n in nodes if n.children]\n    leaves = [n for n in nodes if not n.children]\n    shapes: dict[str, int] = {}\n    for node in nodes:\n        shapes[shape_family(node.shape)] = shapes.get(shape_family(node.shape), 0) + 1\n\n    def name_of(node: Node) -> str:\n        \"\"\"Return a single-line display name for a node (label, or its id).\"\"\"\n        return (node.label.replace(\"\\n\", \" · \") or node.id)\n\n    ranked = sorted(\n        leaves, key=lambda n: (n.in_degree + n.out_degree), reverse=True\n    )\n    hubs = [\n        {\"id\": n.id, \"label\": name_of(n), \"degree\": n.in_degree + n.out_degree}\n        for n in ranked[:5]\n        if (n.in_degree + n.out_degree) > 0\n    ]\n    sources = [name_of(n) for n in leaves if n.out_degree and not n.in_degree]\n    sinks = [name_of(n) for n in leaves if n.in_degree and not n.out_degree]\n    orphans = [name_of(n) for n in leaves if not n.in_degree and not n.out_degree]\n\n    # Type candidates, strongest signal first. Advisory only.\n    candidates: list[str] = []\n    if shapes.get(\"lifeline\"):\n        candidates.append(\"sequence\")\n    if shapes.get(\"table\") or shapes.get(\"er\"):\n        candidates.append(\"er\")\n    lanes = [n for n in nodes if n.shape == \"swimlane\" and n.children]\n    if len(lanes) >= 2 and _aligned(lanes):\n        candidates.append(\"swimlane\")\n    if shapes.get(\"rhombus\"):\n        candidates.append(\"flowchart\")\n    if shapes.get(\"ellipse\", 0) >= max(2, len(leaves) // 3) and edges:\n        candidates.append(\"state\")\n    if any(f in shapes for f in (\"aws\", \"azure\", \"gcp\", \"kubernetes\", \"network\")):\n        candidates.append(\"architecture\")\n    if containers and not shapes.get(\"swimlane\"):\n        candidates.append(\"nested\")\n    if edges and not _has_cycle(nodes, edges) and len(sources) == 1:\n        candidates.append(\"tree\")\n    if edges:\n        candidates.append(\"architecture\")\n    if not candidates:\n        candidates.append(\"architecture\")\n\n    seen: set[str] = set()\n    candidates = [c for c in candidates if not (c in seen or seen.add(c))]\n\n    # Collapse candidates: containers whose children are all leaves, and\n    # fan-out clusters — the first things to merge when simplifying.\n    collapsible = [\n        {\n            \"id\": c.id,\n            \"label\": name_of(c),\n            \"children\": len(c.children),\n            \"child_labels\": [\n                name_of(page.node_map[cid])\n                for cid in c.children\n                if page.node_map.get(cid) and page.node_map[cid].label\n            ][:8],\n        }\n        for c in containers\n        if c.children and all(not page.node_map[cid].children for cid in c.children)\n    ]\n    collapsible.sort(key=lambda c: c[\"children\"], reverse=True)\n\n    return {\n        \"nodes_total\": len(nodes),\n        \"nodes_drawable\": len(drawable),\n        \"containers\": len(containers),\n        \"leaves\": len(leaves),\n        \"edges_total\": len(edges),\n        \"edges_labeled\": sum(1 for e in edges if e.label),\n        \"edges_dangling\": sum(1 for e in edges if not (e.source and e.target)),\n        \"max_depth\": max((n.depth for n in nodes), default=0),\n        \"shapes\": dict(sorted(shapes.items(), key=lambda kv: -kv[1])),\n        \"has_cycle\": _has_cycle(nodes, edges),\n        \"hubs\": hubs,\n        \"entry_points\": sources[:6],\n        \"terminals\": sinks[:6],\n        \"orphans\": orphans[:6],\n        \"type_candidates\": candidates[:3],\n        \"collapsible_groups\": collapsible[:8],\n        \"over_node_budget\": len(drawable) > 9,\n        \"over_edge_budget\": len(edges) > 12,\n    }\n\n\n# --------------------------------------------------------------------------\n# rendering the digest\n# --------------------------------------------------------------------------\n\n\ndef page_bounds(page: Page) -> tuple[float, float, float, float]:\n    \"\"\"Return the (x0, y0, x1, y1) bounds of all positioned nodes.\"\"\"\n    boxes = [(n.x, n.y, n.x + n.w, n.y + n.h) for n in page.nodes if n.w and n.h]\n    if not boxes:\n        return (0.0, 0.0, 0.0, 0.0)\n    return (\n        min(b[0] for b in boxes),\n        min(b[1] for b in boxes),\n        max(b[2] for b in boxes),\n        max(b[3] for b in boxes),\n    )\n\n\ndef digest(path: Path, pages: list[Page], selected: list[Page], max_rows: int) -> str:\n    \"\"\"Render a compact Markdown digest of the selected pages.\n\n    Args:\n        path: The source file path, used for the header line.\n        pages: All pages in the file, used for the summary line.\n        selected: The pages to render in detail.\n        max_rows: Cap on rows per table.\n\n    Returns:\n        The Markdown digest as a string.\n    \"\"\"\n    out: list[str] = []\n    out.append(f\"# draw.io IR — {path.name}\")\n    out.append(\"\")\n    out.append(\n        f\"{len(pages)} page(s): \"\n        + \", \".join(f\"[{p.index}] {p.name} ({len(p.nodes)}n/{len(p.edges)}e)\" for p in pages)\n    )\n    for page in selected:\n        info = analyze(page)\n        x0, y0, x1, y1 = page_bounds(page)\n        out.append(\"\")\n        out.append(f\"## Page {page.index} — {page.name}\")\n        out.append(\"\")\n        out.append(\n            f\"- source canvas: {int(x1 - x0)}×{int(y1 - y0)} px \"\n            f\"(aspect {((x1 - x0) / (y1 - y0)):.2f})\"\n            if y1 > y0\n            else \"- source canvas: empty\"\n        )\n        out.append(\n            f\"- nodes: {info['nodes_total']} total / {info['nodes_drawable']} drawable \"\n            f\"/ {info['containers']} containers, depth {info['max_depth']}\"\n        )\n        out.append(\n            f\"- edges: {info['edges_total']} ({info['edges_labeled']} labeled, \"\n            f\"{info['edges_dangling']} dangling), cycle: {info['has_cycle']}\"\n        )\n        out.append(f\"- shapes: {info['shapes']}\")\n        out.append(f\"- type candidates: {', '.join(info['type_candidates'])}\")\n        out.append(\n            f\"- budget: nodes {'OVER' if info['over_node_budget'] else 'ok'} (max 9), \"\n            f\"edges {'OVER' if info['over_edge_budget'] else 'ok'} (max 12)\"\n        )\n        if info[\"hubs\"]:\n            hubs = \", \".join(f\"{h['label'] or h['id']}({h['degree']})\" for h in info[\"hubs\"])\n            out.append(f\"- hubs (focal candidates): {hubs}\")\n        if info[\"entry_points\"]:\n            out.append(f\"- entry points: {', '.join(info['entry_points'])}\")\n        if info[\"terminals\"]:\n            out.append(f\"- terminals: {', '.join(info['terminals'])}\")\n        if info[\"orphans\"]:\n            out.append(f\"- unconnected: {', '.join(info['orphans'])}\")\n        if info[\"collapsible_groups\"]:\n            out.append(\"- collapsible groups (simplify here first):\")\n            for group in info[\"collapsible_groups\"]:\n                kids = \", \".join(group[\"child_labels\"])\n                out.append(f\"  - {group['label']} — {group['children']} children: {kids}\")\n\n        out.append(\"\")\n        out.append(\"### Nodes\")\n        out.append(\"\")\n        out.append(\"| id | label | shape | depth | parent | deg | box |\")\n        out.append(\"|---|---|---|---|---|---|---|\")\n        listed = [n for n in page.nodes if n.label or n.children]\n        for node in listed[:max_rows]:\n            label = node.label.replace(\"\\n\", \" ⏎ \").replace(\"|\", \"\\\\|\")\n            out.append(\n                f\"| {node.id} | {label} | {node.shape} | {node.depth} | \"\n                f\"{node.parent or '-'} | {node.in_degree}/{node.out_degree} | \"\n                f\"{int(node.x)},{int(node.y)} {int(node.w)}×{int(node.h)} |\"\n            )\n        if len(listed) > max_rows:\n            out.append(f\"| … | +{len(listed) - max_rows} more (use --json) | | | | | |\")\n\n        out.append(\"\")\n        out.append(\"### Edges\")\n        out.append(\"\")\n        out.append(\"| source | target | label | style |\")\n        out.append(\"|---|---|---|---|\")\n        names = {n.id: (n.label.split(\"\\n\")[0] or n.id) for n in page.nodes}\n        for edge in page.edges[:max_rows]:\n            marks = []\n            if edge.dashed:\n                marks.append(\"dashed\")\n            if edge.bidirectional:\n                marks.append(\"bidir\")\n            if edge.undirected:\n                marks.append(\"undirected\")\n            out.append(\n                f\"| {names.get(edge.source or '', '?')} | {names.get(edge.target or '', '?')} \"\n                f\"| {edge.label.replace('|', chr(92) + '|') or '-'} | {' '.join(marks) or '-'} |\"\n            )\n        if len(page.edges) > max_rows:\n            out.append(f\"| … | +{len(page.edges) - max_rows} more (use --json) | | |\")\n    out.append(\"\")\n    return \"\\n\".join(out)\n\n\ndef to_json(path: Path, pages: list[Page], selected: list[Page]) -> str:\n    \"\"\"Serialize the full IR of the selected pages as JSON.\n\n    Args:\n        path: The source file path, recorded in the payload.\n        pages: All pages in the file.\n        selected: The pages to serialize.\n\n    Returns:\n        A JSON string with bounds, analysis, nodes, and edges per page.\n    \"\"\"\n    payload = {\n        \"source\": str(path),\n        \"pages_total\": len(pages),\n        \"pages\": [\n            {\n                \"id\": p.id,\n                \"name\": p.name,\n                \"index\": p.index,\n                \"bounds\": dict(zip((\"x0\", \"y0\", \"x1\", \"y1\"), page_bounds(p))),\n                \"analysis\": analyze(p),\n                \"nodes\": [asdict(n) for n in p.nodes],\n                \"edges\": [asdict(e) for e in p.edges],\n            }\n            for p in selected\n        ],\n    }\n    return json.dumps(payload, indent=2, ensure_ascii=False)\n\n\ndef select_pages(pages: list[Page], selector: str | None) -> list[Page]:\n    \"\"\"Resolve a --page selector to a concrete page list.\n\n    Args:\n        pages: All parsed pages.\n        selector: None, \"all\", a page index, or a page name.\n\n    Returns:\n        The matching pages.\n\n    Raises:\n        SystemExit: With status 2 when the selector matches nothing.\n    \"\"\"\n    if selector is None:\n        return pages if len(pages) == 1 else pages[:1]\n    if selector == \"all\":\n        return pages\n    if selector.isdigit():\n        index = int(selector)\n        match = [p for p in pages if p.index == index]\n        if not match:\n            _fail(f\"no page with index {index} (have 0..{len(pages) - 1})\")\n        return match\n    match = [p for p in pages if p.name.lower() == selector.lower()]\n    if not match:\n        names = \", \".join(p.name for p in pages)\n        _fail(f\"no page named {selector!r} (have: {names})\")\n    return match\n\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"Run the draw.io extractor CLI.\n\n    Args:\n        argv: Command-line arguments; defaults to sys.argv[1:].\n\n    Returns:\n        The process exit code (0 on success, 2 on unreadable input).\n    \"\"\"\n    parser = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n    parser.add_argument(\"file\", help=\".drawio / .xml / .drawio.png / .drawio.svg\")\n    parser.add_argument(\n        \"--page\",\n        help=\"page index, page name, or 'all' (default: first page)\",\n    )\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"emit the full IR as JSON\")\n    parser.add_argument(\n        \"--max-rows\",\n        type=int,\n        default=40,\n        help=\"rows per table in the Markdown digest (default 40)\",\n    )\n    parser.add_argument(\"--out\", help=\"write to this path instead of stdout\")\n    args = parser.parse_args(argv)\n\n    if args.max_rows < 1:\n        parser.error(\"--max-rows must be at least 1\")\n\n    path = Path(args.file)\n    if not path.is_file():\n        _fail(f\"{path}: no such file\")\n\n    pages = parse_file(path)\n    selected = select_pages(pages, args.page)\n    text = (\n        to_json(path, pages, selected)\n        if args.json\n        else digest(path, pages, selected, args.max_rows)\n    )\n    if args.out:\n        Path(args.out).write_text(text, encoding=\"utf-8\")\n        print(f\"wrote {args.out} ({len(text)} bytes)\")\n    else:\n        sys.stdout.write(text if text.endswith(\"\\n\") else text + \"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":967,"totalLines":967,"truncated":false}},"title":".opencode/skills/sk-doc/sk-create-diagram/scripts/drawio_extract.py","time":{"start":1786561445098,"end":1786561445105}},"id":"prt_ff75c3933001i10Z1z9M0Jmo17","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","messageID":"msg_ff75c216d001xIUb2OYYr2bTrV"}}
{"type":"tool_use","timestamp":1786561446065,"sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","part":{"type":"tool","tool":"read","callID":"call_02_VGVS3d5tlkNT7G2k2TXp7819","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/mermaid_extract.py"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/mermaid_extract.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: MERMAID IR EXTRACTOR\n4: # ───────────────────────────────────────────────────────────────\n5: \"\"\"Extract a normalized intermediate representation (IR) from Mermaid text.\n6: \n7: Trust boundary: this program parses bounded text. It never evaluates, renders,\n8: fetches, or executes Mermaid, JavaScript, URLs, directives, or label content.\n9: Every label and directive value is untrusted data. Click targets and styling are\n10: counted and discarded; retained labels are emitted only as inert text.\n11: \n12: Supported grammars are flowchart/graph, sequenceDiagram, stateDiagram-v2, and\n13: erDiagram. Inputs may be .mmd, .mermaid, or Markdown files containing fenced\n14: ``mermaid`` blocks.\n15: \n16: Usage:\n17:     python3 mermaid_extract.py <file> [--diagram N|all] [--json]\n18:                                [--max-rows N] [--out PATH]\n19: \n20: Exit codes: 0 success, 2 unreadable, unsupported, malformed, or over limits.\n21: \"\"\"\n22: \n23: from __future__ import annotations\n24: \n25: import argparse\n26: import html\n27: import json\n28: import re\n29: import sys\n30: from dataclasses import asdict, dataclass, field\n31: from pathlib import Path\n32: from typing import Any, NoReturn\n33: \n34: \n35: MAX_SOURCE_BYTES = 4 * 1024 * 1024\n36: MAX_NODES = 2000\n37: MAX_EDGES = 5000\n38: SUPPORTED_KINDS = \"flowchart, sequenceDiagram, stateDiagram-v2, erDiagram\"\n39: UNSUPPORTED_KINDS = {\n40:     \"pie\",\n41:     \"mindmap\",\n42:     \"gitgraph\",\n43:     \"quadrantchart\",\n44:     \"timeline\",\n45:     \"c4context\",\n46:     \"sankey\",\n47:     \"sankey-beta\",\n48:     \"gantt\",\n49:     \"journey\",\n50:     \"classdiagram\",\n51:     \"statediagram\",\n52: }\n53: MARKDOWN_SUFFIXES = {\".md\", \".markdown\", \".mdown\", \".mkd\"}\n54: MERMAID_SUFFIXES = {\".mmd\", \".mermaid\"}\n55: \n56: \n57: def _fail(message: str) -> NoReturn:\n58:     \"\"\"Print an error to stderr and exit with status 2.\"\"\"\n59:     print(f\"mermaid_extract: {message}\", file=sys.stderr)\n60:     raise SystemExit(2)\n61: \n62: \n63: @dataclass\n64: class Node:\n65:     \"\"\"A node with optional container/parent/depth bookkeeping.\"\"\"\n66: \n67:     id: str\n68:     label: str = \"\"\n69:     shape: str = \"rect\"\n70:     parent: str | None = None\n71:     depth: int = 0\n72:     container: bool = False\n73:     children: list[str] = field(default_factory=list)\n74:     fields: list[str] = field(default_factory=list)\n75:     in_degree: int = 0\n76:     out_degree: int = 0\n77: \n78: \n79: @dataclass\n80: class Edge:\n81:     \"\"\"A directed or undirected connection with style and arrowhead.\"\"\"\n82: \n83:     id: str\n84:     source: str\n85:     target: str\n86:     label: str = \"\"\n87:     style: str = \"solid\"\n88:     arrowhead: str = \"arrow\"\n89:     bidirectional: bool = False\n90:     undirected: bool = False\n91:     order: int = 0\n92: \n93: \n94: @dataclass\n95: class Diagram:\n96:     \"\"\"One parsed Mermaid diagram with nodes, edges, fragments, and notes.\"\"\"\n97: \n98:     index: int\n99:     kind: str\n100:     source_line: int\n101:     direction: str = \"TD\"\n102:     nodes: list[Node] = field(default_factory=list)\n103:     edges: list[Edge] = field(default_factory=list)\n104:     fragments: list[dict[str, Any]] = field(default_factory=list)\n105:     notes: list[str] = field(default_factory=list)\n106:     discarded: dict[str, int] = field(\n107:         default_factory=lambda: {\"style_directives\": 0, \"click_handlers\": 0}\n108:     )\n109:     _nodes_by_id: dict[str, Node] = field(default_factory=dict, init=False, repr=False)\n110: \n111:     @property\n112:     def node_map(self) -> dict[str, Node]:\n113:         \"\"\"Return the id -> Node index for this diagram.\"\"\"\n114:         return self._nodes_by_id\n115: \n116:     def add_node(\n117:         self,\n118:         node_id: str,\n119:         label: str = \"\",\n120:         shape: str = \"rect\",\n121:         parent: str | None = None,\n122:         container: bool = False,\n123:     ) -> Node:\n124:         \"\"\"Add or update a node, merging labels, shapes, and parents.\n125: \n126:         Args:\n127:             node_id: The node identifier.\n128:             label: The display label; ignored when empty or already set.\n129:             shape: The normalized shape family.\n130:             parent: Optional parent node id; sets depth and attachment.\n131:             container: Whether the node is a container.\n132: \n133:         Returns:\n134:             The created or updated Node.\n135: \n136:         Raises:\n137:             SystemExit: With status 2 when MAX_NODES is exceeded.\n138:         \"\"\"\n139:         existing = self._nodes_by_id.get(node_id)\n140:         if existing is not None:\n141:             if label and (label != node_id or existing.label == existing.id):\n142:                 existing.label = label\n143:             if shape != \"rect\" or not existing.shape:\n144:                 existing.shape = shape\n145:             if parent is not None and existing.parent is None:\n146:                 existing.parent = parent\n147:                 existing.depth = self._depth_for(parent)\n148:                 self._attach(parent, node_id)\n149:             existing.container = existing.container or container\n150:             return existing\n151:         if len(self.nodes) >= MAX_NODES:\n152:             _fail(f\"node limit exceeded (max {MAX_NODES})\")\n153:         node = Node(\n154:             id=node_id,\n155:             label=label or node_id,\n156:             shape=shape,\n157:             parent=parent,\n158:             depth=self._depth_for(parent),\n159:             container=container,\n160:         )\n161:         self.nodes.append(node)\n162:         self._nodes_by_id[node_id] = node\n163:         if parent is not None:\n164:             self._attach(parent, node_id)\n165:         return node\n166: \n167:     def _depth_for(self, parent: str | None) -> int:\n168:         \"\"\"Return the depth for a parent node id (0 when parent is None).\"\"\"\n169:         if parent is None:\n170:             return 0\n171:         parent_node = self._nodes_by_id.get(parent)\n172:         return (parent_node.depth + 1) if parent_node is not None else 1\n173: \n174:     def _attach(self, parent: str, child: str) -> None:\n175:         \"\"\"Attach a child id to a parent's children list if not already present.\"\"\"\n176:         parent_node = self._nodes_by_id.get(parent)\n177:         if parent_node is not None and child not in parent_node.children:\n178:             parent_node.children.append(child)\n179:             parent_node.container = True\n180: \n181:     def add_edge(\n182:         self,\n183:         source: str,\n184:         target: str,\n185:         label: str = \"\",\n186:         style: str = \"solid\",\n187:         arrowhead: str = \"arrow\",\n188:         bidirectional: bool = False,\n189:         undirected: bool = False,\n190:     ) -> Edge:\n191:         \"\"\"Append an edge to the diagram with an auto-incrementing id.\n192: \n193:         Args:\n194:             source: Source node id.\n195:             target: Target node id.\n196:             label: Optional edge label.\n197:             style: solid, dashed, or thick.\n198:             arrowhead: arrow, open, cross, or cardinality marker.\n199:             bidirectional: Whether both ends carry markers.\n200:             undirected: Whether the edge has no arrowheads.\n201: \n202:         Returns:\n203:             The created Edge.\n204: \n205:         Raises:\n206:             SystemExit: With status 2 when MAX_EDGES is exceeded.\n207:         \"\"\"\n208:         if len(self.edges) >= MAX_EDGES:\n209:             _fail(f\"edge limit exceeded (max {MAX_EDGES})\")\n210:         edge = Edge(\n211:             id=f\"e{len(self.edges) + 1}\",\n212:             source=source,\n213:             target=target,\n214:             label=label,\n215:             style=style,\n216:             arrowhead=arrowhead,\n217:             bidirectional=bidirectional,\n218:             undirected=undirected,\n219:             order=len(self.edges) + 1,\n220:         )\n221:         self.edges.append(edge)\n222:         return edge\n223: \n224: \n225: @dataclass\n226: class SourceBlock:\n227:     \"\"\"One mermaid source block with its file-relative start line.\"\"\"\n228: \n229:     index: int\n230:     text: str\n231:     source_line: int\n232: \n233: \n234: def clean_label(value: str) -> str:\n235:     \"\"\"Flatten Mermaid label markup without interpreting it.\"\"\"\n236:     text = value.strip()\n237:     if len(text) >= 2 and text[0] == text[-1] and text[0] in \"\\\"'`\":\n238:         text = text[1:-1]\n239:     if text.startswith(\"`\") and text.endswith(\"`\"):\n240:         text = text[1:-1]\n241:     text = re.sub(r\"<br\\s*/?>\", \"\\n\", text, flags=re.IGNORECASE)\n242:     text = re.sub(r\"<[^>]+>\", \"\", text)\n243:     text = re.sub(r\"(?<!&)#(quot|apos|amp|lt|gt);\", r\"&\\1;\", text)\n244:     text = html.unescape(text)\n245:     text = re.sub(r\"\\*\\*(.*?)\\*\\*\", r\"\\1\", text)\n246:     text = re.sub(r\"__(.*?)__\", r\"\\1\", text)\n247:     text = re.sub(r\"(?<!\\w)[*_](.*?)[*_](?!\\w)\", r\"\\1\", text)\n248:     text = text.replace(\"\\\\\\\"\", '\"').replace(\"\\\\'\", \"'\")\n249:     return \"\\n\".join(part.strip() for part in text.splitlines()).strip()\n250: \n251: \n252: def _read_bounded(path: Path) -> str:\n253:     \"\"\"Read the source file up to MAX_SOURCE_BYTES, decoding it as UTF-8.\"\"\"\n254:     try:\n255:         with path.open(\"rb\") as source:\n256:             data = source.read(MAX_SOURCE_BYTES + 1)\n257:     except OSError as error:\n258:         _fail(f\"{path}: {error}\")\n259:     if len(data) > MAX_SOURCE_BYTES:\n260:         _fail(\n261:             f\"source exceeds the {MAX_SOURCE_BYTES // (1024 * 1024)} MiB limit\"\n262:         )\n263:     try:\n264:         return data.decode(\"utf-8\")\n265:     except UnicodeDecodeError:\n266:         _fail(f\"{path.name}: source is not valid UTF-8 text\")\n267: \n268: \n269: def load_blocks(path: Path) -> list[SourceBlock]:\n270:     \"\"\"Split a Mermaid or Markdown file into source blocks.\n271: \n272:     Args:\n273:         path: Path to a .mmd, .mermaid, or Markdown file with mermaid fences.\n274: \n275:     Returns:\n276:         A list of SourceBlock: one entry for .mmd/.mermaid, one per fenced block.\n277: \n278:     Raises:\n279:         SystemExit: With status 2 for unsupported files or missing/empty blocks.\n280:     \"\"\"\n281:     suffix = path.suffix.casefold()\n282:     if suffix not in MERMAID_SUFFIXES | MARKDOWN_SUFFIXES:\n283:         _fail(f\"{path.name}: not a Mermaid file\")\n284:     source = _read_bounded(path)\n285:     if suffix in MERMAID_SUFFIXES:\n286:         return [SourceBlock(0, source, 1)]\n287: \n288:     blocks: list[SourceBlock] = []\n289:     lines = source.splitlines()\n290:     start: int | None = None\n291:     fence = \"\"\n292:     content: list[str] = []\n293:     for line_number, line in enumerate(lines, 1):\n294:         if start is None:\n295:             match = re.match(r\"^\\s*(`{3,}|~{3,})\\s*mermaid\\s*$\", line, re.I)\n296:             if match:\n297:                 start = line_number + 1\n298:                 fence = match.group(1)\n299:                 content = []\n300:             continue\n301:         if re.match(rf\"^\\s*{re.escape(fence[0])}{{{len(fence)},}}\\s*$\", line):\n302:             blocks.append(SourceBlock(len(blocks), \"\\n\".join(content), start))\n303:             start = None\n304:             fence = \"\"\n305:             content = []\n306:         else:\n307:             content.append(line)\n308:     if start is not None:\n309:         _fail(f\"{path.name}: unterminated mermaid fence starting at line {start - 1}\")\n310:     if not blocks:\n311:         _fail(f\"{path.name}: no fenced mermaid block found\")\n312:     return blocks\n313: \n314: \n315: FRONTMATTER_MAX_LINES = 40\n316: \n317: \n318: def _frontmatter_end(lines: list[str]) -> int:\n319:     \"\"\"Return the last line index of a leading `---` frontmatter block, or -1.\"\"\"\n320:     first = next(\n321:         (index for index, line in enumerate(lines) if line.strip()),\n322:         None,\n323:     )\n324:     if first is None or lines[first].strip() != \"---\":\n325:         return -1\n326:     limit = min(len(lines), first + FRONTMATTER_MAX_LINES + 1)\n327:     for index in range(first + 1, limit):\n328:         if lines[index].strip() == \"---\":\n329:             return index\n330:     return -1\n331: \n332: \n333: def _prepared_lines(block: SourceBlock) -> list[tuple[int, str]]:\n334:     \"\"\"Mask directives and frontmatter so the parser sees only diagram statements.\"\"\"\n335:     prepared: list[tuple[int, str]] = []\n336:     in_directive = False\n337:     lines = block.text.splitlines()\n338:     frontmatter_end = _frontmatter_end(lines)\n339:     for offset, raw in enumerate(lines):\n340:         line_number = block.source_line + offset\n341:         stripped = raw.strip()\n342:         if offset <= frontmatter_end:\n343:             # Mermaid's `--- title: ... ---` frontmatter is source config; the\n344:             # redraw discards it the same way it discards `%%{init}%%`.\n345:             prepared.append((line_number, \"\"))\n346:             continue\n347:         if in_directive:\n348:             if \"}%%\" in stripped:\n349:                 in_directive = False\n350:             prepared.append((line_number, \"\"))\n351:             continue\n352:         if stripped.startswith(\"%%{\"):\n353:             if \"}%%\" not in stripped:\n354:                 in_directive = True\n355:             prepared.append((line_number, \"\"))\n356:             continue\n357:         if stripped.startswith(\"%%\"):\n358:             prepared.append((line_number, \"\"))\n359:             continue\n360:         prepared.append((line_number, raw.rstrip()))\n361:     return prepared\n362: \n363: \n364: def _kind_and_direction(\n365:     lines: list[tuple[int, str]],\n366: ) -> tuple[str, str, int]:\n367:     \"\"\"Return the diagram kind, declared direction, and header line position.\"\"\"\n368:     for position, (line_number, raw) in enumerate(lines):\n369:         text = raw.strip()\n370:         if not text:\n371:             continue\n372:         match = re.match(r\"^(flowchart|graph)\\s+(TD|TB|LR|RL|BT)\\b\", text, re.I)\n373:         if match:\n374:             return \"flowchart\", match.group(2).upper(), position\n375:         if re.match(r\"^sequenceDiagram\\b\", text, re.I):\n376:             return \"sequenceDiagram\", \"LR\", position\n377:         if re.match(r\"^stateDiagram-v2\\b\", text, re.I):\n378:             return \"stateDiagram-v2\", \"TD\", position\n379:         if re.match(r\"^erDiagram\\b\", text, re.I):\n380:             return \"erDiagram\", \"TD\", position\n381:         token = text.split(maxsplit=1)[0]\n382:         if token.casefold() in UNSUPPORTED_KINDS:\n383:             _fail(\n384:                 f\"unsupported diagram kind: `{token}` (supported: {SUPPORTED_KINDS})\"\n385:             )\n386:         _fail(f\"not a Mermaid file at line {line_number}\")\n387:     _fail(\"not a Mermaid file\")\n388: \n389: \n390: def _top_level_mask(text: str) -> str:\n391:     \"\"\"Keep top-level syntax positions and blank quoted/bracketed content.\"\"\"\n392:     output = list(text)\n393:     stack: list[str] = []\n394:     quote: str | None = None\n395:     escaped = False\n396:     pairs = {\"]\": \"[\", \")\": \"(\", \"}\": \"{\"}\n397:     for index, character in enumerate(text):\n398:         if quote is not None:\n399:             output[index] = \" \"\n400:             if escaped:\n401:                 escaped = False\n402:             elif character == \"\\\\\":\n403:                 escaped = True\n404:             elif character == quote:\n405:                 quote = None\n406:             continue\n407:         if character in \"\\\"'`\":\n408:             quote = character\n409:             output[index] = \" \"\n410:             continue\n411:         if character in \"[({\":\n412:             stack.append(character)\n413:             output[index] = \" \"\n414:             continue\n415:         if character in \"])}\":\n416:             if stack and stack[-1] == pairs[character]:\n417:                 stack.pop()\n418:             output[index] = \" \"\n419:             continue\n420:         if stack:\n421:             output[index] = \" \"\n422:     return \"\".join(output)\n423: \n424: \n425: def _split_top_level(text: str, delimiter: str) -> list[str]:\n426:     \"\"\"Split text on a delimiter only at top-level (unquoted/unbracketed) positions.\"\"\"\n427:     mask = _top_level_mask(text)\n428:     parts: list[str] = []\n429:     start = 0\n430:     for index, character in enumerate(mask):\n431:         if character == delimiter:\n432:             parts.append(text[start:index])\n433:             start = index + 1\n434:     parts.append(text[start:])\n435:     return parts\n436: \n437: \n438: def _statement_complete(text: str) -> bool:\n439:     \"\"\"Return whether quotes and node delimiters close within a statement.\"\"\"\n440:     stack: list[str] = []\n441:     quote: str | None = None\n442:     escaped = False\n443:     pairs = {\"]\": \"[\", \")\": \"(\", \"}\": \"{\"}\n444:     for character in text:\n445:         if quote is not None:\n446:             if escaped:\n447:                 escaped = False\n448:             elif character == \"\\\\\":\n449:                 escaped = True\n450:             elif character == quote:\n451:                 quote = None\n452:             continue\n453:         if character in \"\\\"'`\":\n454:             quote = character\n455:         elif character in \"[({\":\n456:             stack.append(character)\n457:         elif character in \"])}\":\n458:             if stack and stack[-1] == pairs[character]:\n459:                 stack.pop()\n460:     return quote is None and not stack\n461: \n462: \n463: def _logical_statements(\n464:     lines: list[tuple[int, str]],\n465: ) -> list[tuple[int, str]]:\n466:     \"\"\"Join multiline Mermaid strings before parsing semicolon statements.\"\"\"\n467:     logical: list[tuple[int, str]] = []\n468:     pending: list[str] = []\n469:     start_line = 0\n470:     for line_number, raw in lines:\n471:         if not pending and not raw.strip():\n472:             continue\n473:         if not pending:\n474:             start_line = line_number\n475:         pending.append(raw)\n476:         combined = \"\\n\".join(pending)\n477:         if not _statement_complete(combined):\n478:             continue\n479:         logical.extend(\n480:             (start_line, statement)\n481:             for statement in _split_top_level(combined, \";\")\n482:         )\n483:         pending = []\n484:     if pending:\n485:         _fail(f\"unterminated statement at line {start_line}\")\n486:     return logical\n487: \n488: \n489: SHAPE_FOR_DELIMITERS = (\n490:     (\"(((\", \")))\", \"circle\"),\n491:     (\"((\", \"))\", \"circle\"),\n492:     (\"([\", \"])\", \"stadium\"),\n493:     (\"{{\", \"}}\", \"hexagon\"),\n494:     (\"[(\", \")]\", \"cylinder\"),\n495:     (\"[[\", \"]]\", \"subroutine\"),\n496:     (\"[/\", \"/]\", \"parallelogram\"),\n497:     (\"[\\\\\", \"\\\\]\", \"parallelogram\"),\n498:     (\"[/\", \"\\\\]\", \"trapezoid\"),\n499:     (\"[\\\\\", \"/]\", \"trapezoid\"),\n500:     (\"[\", \"]\", \"rect\"),\n501:     (\"(\", \")\", \"round\"),\n502:     (\"{\", \"}\", \"rhombus\"),\n503:     (\">\", \"]\", \"asymmetric\"),\n504: )\n505: \n506: EXPANDED_SHAPE_FAMILIES = {\n507:     \"rect\": \"rect\",\n508:     \"rectangle\": \"rect\",\n509:     \"proc\": \"rect\",\n510:     \"process\": \"rect\",\n511:     \"rounded\": \"round\",\n512:     \"event\": \"round\",\n513:     \"stadium\": \"stadium\",\n514:     \"pill\": \"stadium\",\n515:     \"terminal\": \"stadium\",\n516:     \"circle\": \"circle\",\n517:     \"circ\": \"circle\",\n518:     \"sm-circ\": \"circle\",\n519:     \"small-circle\": \"circle\",\n520:     \"start\": \"circle\",\n521:     \"dbl-circ\": \"circle\",\n522:     \"double-circle\": \"circle\",\n523:     \"fr-circ\": \"circle\",\n524:     \"framed-circle\": \"circle\",\n525:     \"stop\": \"circle\",\n526:     \"cyl\": \"cylinder\",\n527:     \"cylinder\": \"cylinder\",\n528:     \"database\": \"cylinder\",\n529:     \"db\": \"cylinder\",\n530:     \"h-cyl\": \"cylinder\",\n531:     \"horizontal-cylinder\": \"cylinder\",\n532:     \"lin-cyl\": \"cylinder\",\n533:     \"lined-cylinder\": \"cylinder\",\n534:     \"diam\": \"rhombus\",\n535:     \"decision\": \"rhombus\",\n536:     \"diamond\": \"rhombus\",\n537:     \"question\": \"rhombus\",\n538:     \"hex\": \"hexagon\",\n539:     \"hexagon\": \"hexagon\",\n540:     \"prepare\": \"hexagon\",\n541:     \"fr-rect\": \"subroutine\",\n542:     \"framed-rectangle\": \"subroutine\",\n543:     \"subproc\": \"subroutine\",\n544:     \"subprocess\": \"subroutine\",\n545:     \"subroutine\": \"subroutine\",\n546:     \"lean-r\": \"parallelogram\",\n547:     \"lean-l\": \"parallelogram\",\n548:     \"in-out\": \"parallelogram\",\n549:     \"lean-right\": \"parallelogram\",\n550:     \"lean-left\": \"parallelogram\",\n551:     \"out-in\": \"parallelogram\",\n552:     \"trap-t\": \"trapezoid\",\n553:     \"trap-b\": \"trapezoid\",\n554:     \"trapezoid\": \"trapezoid\",\n555:     \"inv-trapezoid\": \"trapezoid\",\n556:     \"manual\": \"trapezoid\",\n557:     \"priority\": \"trapezoid\",\n558: }\n559: \n560: \n561: def classify_shape(expression: str) -> str:\n562:     \"\"\"Return the normalized Mermaid shape family for a node suffix.\"\"\"\n563:     for opening, closing, shape in SHAPE_FOR_DELIMITERS:\n564:         if expression.startswith(opening) and expression.endswith(closing):\n565:             return shape\n566:     return \"rect\"\n567: \n568: \n569: def _strip_class_suffix(text: str) -> str:\n570:     \"\"\"Drop Mermaid's `:::class` attachment; source styling is discarded.\"\"\"\n571:     mask = _top_level_mask(text)\n572:     index = mask.find(\":::\")\n573:     if index == -1:\n574:         return text\n575:     end = index + 3\n576:     while end < len(text) and (text[end].isalnum() or text[end] in \"_-\"):\n577:         end += 1\n578:     return (text[:index] + text[end:]).strip()\n579: \n580: \n581: def _parse_expanded_attributes(text: str) -> tuple[str, str] | None:\n582:     \"\"\"Normalize Mermaid v11.3+ ``@{ ... }`` node attributes.\n583: \n584:     Only semantic label/shape data crosses the trust boundary. Image URLs,\n585:     registered icon names, dimensions, and renderer configuration are dropped.\n586:     \"\"\"\n587:     if not text.startswith(\"@{\") or not text.endswith(\"}\"):\n588:         return None\n589:     values: dict[str, str] = {}\n590:     for raw_attribute in _split_top_level(text[2:-1], \",\"):\n591:         key, separator, raw_value = raw_attribute.partition(\":\")\n592:         if not separator:\n593:             continue\n594:         key = key.strip().casefold()\n595:         if not re.fullmatch(r\"[a-z][a-z0-9_-]*\", key):\n596:             continue\n597:         values[key] = clean_label(raw_value)\n598:     shape_name = values.get(\"shape\", \"\").casefold()\n599:     if not shape_name:\n600:         if \"img\" in values:\n601:             shape_name = \"image\"\n602:         elif \"icon\" in values:\n603:             shape_name = \"icon\"\n604:         else:\n605:             shape_name = \"rect\"\n606:     if not re.fullmatch(r\"[a-z][a-z0-9-]*\", shape_name):\n607:         shape_name = \"rect\"\n608:     shape = EXPANDED_SHAPE_FAMILIES.get(shape_name, shape_name)\n609:     return values.get(\"label\", \"\"), shape\n610: \n611: \n612: def _parse_node_expression(expression: str) -> tuple[str, str, str] | None:\n613:     \"\"\"Parse one node expression into (node_id, label, shape) or None.\"\"\"\n614:     text = _strip_class_suffix(expression.strip().rstrip(\";\").strip())\n615:     if not text:\n616:         return None\n617:     match = re.match(r\"^([\\w.:-]+)\", text, re.UNICODE)\n618:     if match is None:\n619:         return None\n620:     node_id = match.group(1)\n621:     rest = text[match.end() :].strip()\n622:     if not rest:\n623:         return node_id, node_id, \"rect\"\n624:     expanded = _parse_expanded_attributes(rest)\n625:     if expanded is not None:\n626:         label, shape = expanded\n627:         return node_id, label or node_id, shape\n628:     for opening, closing, _shape in SHAPE_FOR_DELIMITERS:\n629:         if rest.startswith(opening) and rest.endswith(closing):\n630:             label = rest[len(opening) : len(rest) - len(closing)]\n631:             return node_id, clean_label(label), classify_shape(rest)\n632:     return None\n633: \n634: \n635: @dataclass\n636: class _Operator:\n637:     \"\"\"A link operator match with its label and style flags.\"\"\"\n638: \n639:     start: int\n640:     end: int\n641:     label: str\n642:     style: str\n643:     arrowhead: str\n644:     bidirectional: bool = False\n645:     undirected: bool = False\n646: \n647: \n648: def _operator_style(token: str) -> tuple[str, str, bool, bool]:\n649:     \"\"\"Map a link operator token to style, arrowhead, and direction flags.\"\"\"\n650:     style = \"dashed\" if \".\" in token else \"thick\" if \"=\" in token else \"solid\"\n651:     arrowhead = \"cross\" if token.endswith(\"x\") else \"circle\" if token.endswith(\"o\") else \"arrow\"\n652:     undirected = \">\" not in token and not token.endswith((\"x\", \"o\"))\n653:     bidirectional = (\n654:         token.startswith(\"<\") and token.endswith(\">\")\n655:     ) or (token.startswith((\"x\", \"o\")) and token.endswith((\"x\", \"o\")))\n656:     return style, arrowhead, bidirectional, undirected\n657: \n658: \n659: def _edge_operators(text: str) -> list[_Operator]:\n660:     \"\"\"Find link operators in a statement, carrying their inline labels.\"\"\"\n661:     mask = _top_level_mask(text)\n662:     operators: list[_Operator] = []\n663:     occupied: list[tuple[int, int]] = []\n664: \n665:     # Labeled links carry the label between the opening and closing operator:\n666:     # `A-- text -->B`, `A-. retry .-> B`, `A== critical ==> B`, and the\n667:     # undirected forms of each.\n668:     text_edge = re.compile(\n669:         r\"(?:--|-\\.|==)\\s+(.+?)\\s+(\\.-+[>xo]|\\.-+|-{2,}>|--[xo]|=+>|={2,}|-{3,})\"\n670:     )\n671:     for match in text_edge.finditer(mask):\n672:         token = match.group(2)\n673:         style, arrowhead, bidirectional, undirected = _operator_style(token)\n674:         operators.append(\n675:             _Operator(\n676:                 match.start(),\n677:                 match.end(),\n678:                 clean_label(text[match.start(1) : match.end(1)]),\n679:                 style,\n680:                 arrowhead,\n681:                 bidirectional,\n682:                 undirected,\n683:             )\n684:         )\n685:         occupied.append((match.start(), match.end()))\n686: \n687:     pattern = re.compile(\n688:         r\"[xo][-=.]+[xo]|<[-=.]+>|-+\\.-+>|=+>|-+(?:>|x|o)|-+\\.-+|={3,}|-{3,}\"\n689:     )\n690:     for match in pattern.finditer(mask):\n691:         if any(start <= match.start() < end for start, end in occupied):\n692:             continue\n693:         token = match.group()\n694:         end = match.end()\n695:         label = \"\"\n696:         if end < len(text) and text[end] == \"|\":\n697:             close = text.find(\"|\", end + 1)\n698:             if close != -1:\n699:                 label = clean_label(text[end + 1 : close])\n700:                 end = close + 1\n701:         style, arrowhead, bidirectional, undirected = _operator_style(token)\n702:         operators.append(\n703:             _Operator(\n704:                 match.start(), end, label, style, arrowhead, bidirectional, undirected\n705:             )\n706:         )\n707:         occupied.append((match.start(), end))\n708:     return sorted(operators, key=lambda operator: operator.start)\n709: \n710: \n711: def _endpoint_group(\n712:     diagram: Diagram, text: str, parent: str | None\n713: ) -> list[str] | None:\n714:     \"\"\"Parse an ampersand-joined endpoint group into node identifiers or None.\"\"\"\n715:     identifiers: list[str] = []\n716:     for raw in _split_top_level(text.strip(), \"&\"):\n717:         parsed = _parse_node_expression(raw)\n718:         if parsed is None:\n719:             return None\n720:         node_id, label, shape = parsed\n721:         diagram.add_node(node_id, label, shape, parent)\n722:         identifiers.append(node_id)\n723:     return identifiers or None\n724: \n725: \n726: STYLE_DIRECTIVES = (\"style \", \"classDef \", \"class \", \"linkStyle \")\n727: \n728: \n729: def _discard_nonsemantic(diagram: Diagram, text: str) -> bool:\n730:     \"\"\"Count and drop style directives and click handlers from a statement.\"\"\"\n731:     lowered = text.casefold()\n732:     if any(lowered.startswith(prefix.casefold()) for prefix in STYLE_DIRECTIVES):\n733:         diagram.discarded[\"style_directives\"] += 1\n734:         return True\n735:     if lowered.startswith(\"click \"):\n736:         diagram.discarded[\"click_handlers\"] += 1\n737:         return True\n738:     return False\n739: \n740: \n741: def _parse_flowchart(\n742:     diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n743: ) -> None:\n744:     \"\"\"Parse flowchart/graph statements into nodes, edges, and containers.\"\"\"\n745:     containers: list[str] = []\n746:     for line_number, raw in _logical_statements(lines[header_position + 1 :]):\n747:         text = raw.strip()\n748:         if not text:\n749:             continue\n750:         lowered = text.casefold()\n751:         if _discard_nonsemantic(diagram, text):\n752:             continue\n753:         if lowered.startswith(\"direction \"):\n754:             if not containers:\n755:                 direction = text.split(maxsplit=1)[1].upper()\n756:                 if direction in {\"TD\", \"TB\", \"LR\", \"RL\", \"BT\"}:\n757:                     diagram.direction = direction\n758:             continue\n759:         if lowered.startswith(\"subgraph \"):\n760:             spec = text.split(maxsplit=1)[1].strip()\n761:             parsed = _parse_node_expression(spec)\n762:             if parsed is None:\n763:                 generated = f\"subgraph-{len([node for node in diagram.nodes if node.container]) + 1}\"\n764:                 node_id, label = generated, clean_label(spec)\n765:             else:\n766:                 node_id, label, _shape = parsed\n767:             parent = containers[-1] if containers else None\n768:             diagram.add_node(node_id, label, \"container\", parent, container=True)\n769:             containers.append(node_id)\n770:             continue\n771:         if lowered == \"end\":\n772:             if containers:\n773:                 containers.pop()\n774:             continue\n775: \n776:         operators = _edge_operators(text)\n777:         parent = containers[-1] if containers else None\n778:         if operators:\n779:             segments: list[str] = []\n780:             cursor = 0\n781:             for operator in operators:\n782:                 segments.append(text[cursor : operator.start])\n783:                 cursor = operator.end\n784:             segments.append(text[cursor:])\n785:             if len(segments) != len(operators) + 1:\n786:                 _fail(f\"malformed edge at line {line_number}\")\n787:             groups = [_endpoint_group(diagram, segment, parent) for segment in segments]\n788:             if any(group is None for group in groups):\n789:                 _fail(f\"malformed edge at line {line_number}\")\n790:             valid_groups = [group for group in groups if group is not None]\n791:             for index, operator in enumerate(operators):\n792:                 for source in valid_groups[index]:\n793:                     for target in valid_groups[index + 1]:\n794:                         diagram.add_edge(\n795:                             source,\n796:                             target,\n797:                             operator.label,\n798:                             operator.style,\n799:                             operator.arrowhead,\n800:                             operator.bidirectional,\n801:                             operator.undirected,\n802:                         )\n803:             continue\n804:         if re.search(r\"(?:--|==|-.).*?(?:>|x|o|-)\", _top_level_mask(text)):\n805:             _fail(f\"malformed edge at line {line_number}\")\n806:         parsed = _parse_node_expression(text)\n807:         if parsed is not None:\n808:             node_id, label, shape = parsed\n809:             diagram.add_node(node_id, label, shape, parent)\n810: \n811: \n812: def _parse_sequence(\n813:     diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n814: ) -> None:\n815:     \"\"\"Parse sequenceDiagram statements into participants, messages, and fragments.\"\"\"\n816:     fragment_stack: list[dict[str, Any]] = []\n817:     participant_re = re.compile(\n818:         r\"^(participant|actor)\\s+([\\w.:-]+)(?:\\s+as\\s+(.+))?$\", re.I\n819:     )\n820:     message_re = re.compile(\n821:         r\"^([\\w.:-]+?)(?:\\(\\))?\\s*(--?>>|--?>|--?\\)|--?x)\"\n822:         r\"\\s*[+-]?\\s*(?:\\(\\))?([\\w.:-]+)\\s*:\\s*(.*)$\"\n823:     )\n824:     for line_number, raw in lines[header_position + 1 :]:\n825:         text = raw.strip()\n826:         if not text:\n827:             continue\n828:         lowered = text.casefold()\n829:         if _discard_nonsemantic(diagram, text):\n830:             continue\n831:         participant = participant_re.match(text)\n832:         if participant:\n833:             node_id = participant.group(2)\n834:             diagram.add_node(\n835:                 node_id,\n836:                 clean_label(participant.group(3) or node_id),\n837:                 \"actor\" if participant.group(1).casefold() == \"actor\" else \"lifeline\",\n838:             )\n839:             continue\n840:         fragment = re.match(r\"^(alt|opt|loop|par|critical|break)\\b\\s*(.*)$\", text, re.I)\n841:         if fragment:\n842:             entry = {\n843:                 \"kind\": fragment.group(1).casefold(),\n844:                 \"label\": clean_label(fragment.group(2)),\n845:                 \"line\": line_number,\n846:                 \"depth\": len(fragment_stack),\n847:                 \"regions\": [],\n848:             }\n849:             diagram.fragments.append(entry)\n850:             fragment_stack.append(entry)\n851:             continue\n852:         region = re.match(r\"^(else|and|option)\\b\\s*(.*)$\", text, re.I)\n853:         if region and fragment_stack:\n854:             fragment_stack[-1][\"regions\"].append(clean_label(region.group(2)))\n855:             continue\n856:         if lowered == \"end\":\n857:             if fragment_stack:\n858:                 fragment_stack.pop()\n859:             continue\n860:         if lowered.startswith((\"activate \", \"deactivate \", \"+\", \"-\")):\n861:             continue\n862:         if lowered.startswith(\"note \"):\n863:             _, separator, note = text.partition(\":\")\n864:             diagram.notes.append(clean_label(note if separator else text[5:]))\n865:             continue\n866:         message = message_re.match(text)\n867:         if message:\n868:             source, token, target, label = message.groups()\n869:             diagram.add_node(source, source, \"lifeline\")\n870:             diagram.add_node(target, target, \"lifeline\")\n871:             diagram.add_edge(\n872:                 source,\n873:                 target,\n874:                 clean_label(label),\n875:                 \"dashed\" if token.startswith(\"--\") else \"solid\",\n876:                 \"cross\" if token.endswith(\"x\") else \"async\" if token.endswith(\")\") else \"arrow\",\n877:             )\n878:             continue\n879:         if re.search(r\"--?>>|--?>|--?\\)|--?x\", text):\n880:             _fail(f\"malformed edge at line {line_number}\")\n881: \n882: \n883: def _state_endpoint(\n884:     diagram: Diagram,\n885:     token: str,\n886:     role: str,\n887:     parent: str | None,\n888: ) -> str | None:\n889:     \"\"\"Resolve a state endpoint token to a node id, creating start/end markers.\"\"\"\n890:     value = _strip_class_suffix(token.strip())\n891:     if value == \"[*]\":\n892:         prefix = \"start\" if role == \"source\" else \"end\"\n893:         count = sum(node.id.startswith(\"__\" + prefix) for node in diagram.nodes)\n894:         node_id = f\"__{prefix}_{count + 1}\"\n895:         diagram.add_node(node_id, f\"[{prefix}]\", prefix, parent)\n896:         return node_id\n897:     parsed = _parse_node_expression(value)\n898:     if parsed is None:\n899:         return None\n900:     node_id, label, shape = parsed\n901:     diagram.add_node(node_id, label, \"state\" if shape == \"rect\" else shape, parent)\n902:     return node_id\n903: \n904: \n905: def _parse_state(\n906:     diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n907: ) -> None:\n908:     \"\"\"Parse stateDiagram-v2 statements into states and transitions.\"\"\"\n909:     containers: list[str] = []\n910:     for line_number, raw in lines[header_position + 1 :]:\n911:         text = raw.strip()\n912:         if not text:\n913:             continue\n914:         if _discard_nonsemantic(diagram, text):\n915:             continue\n916:         if text == \"}\":\n917:             if containers:\n918:                 containers.pop()\n919:             continue\n920:         parent = containers[-1] if containers else None\n921:         direction_match = re.match(r\"^direction\\s+(TD|TB|LR|RL|BT)$\", text, re.I)\n922:         if direction_match and not containers:\n923:             diagram.direction = direction_match.group(1).upper()\n924:             continue\n925:         composite = re.match(r\"^state\\s+([\\w.:-]+)\\s*\\{$\", text, re.I)\n926:         if composite:\n927:             node_id = composite.group(1)\n928:             diagram.add_node(node_id, node_id, \"container\", parent, container=True)\n929:             containers.append(node_id)\n930:             continue\n931:         alias = re.match(r'^state\\s+\"(.*?)\"\\s+as\\s+([\\w.:-]+)$', text, re.I)\n932:         if alias:\n933:             diagram.add_node(alias.group(2), clean_label(alias.group(1)), \"state\", parent)\n934:             continue\n935:         stereotype = re.match(\n936:             r\"^state\\s+([\\w.:-]+)\\s+<<(fork|join|choice)>>$\", text, re.I\n937:         )\n938:         if stereotype:\n939:             diagram.add_node(\n940:                 stereotype.group(1), stereotype.group(1), stereotype.group(2).casefold(), parent\n941:             )\n942:             continue\n943:         if \"-->\" in text:\n944:             source_text, target_text = text.split(\"-->\", 1)\n945:             label = \"\"\n946:             label_separator = re.search(r\"(?<!:):(?!:)\", target_text)\n947:             if label_separator:\n948:                 label = target_text[label_separator.end() :]\n949:                 target_text = target_text[: label_separator.start()]\n950:             source = _state_endpoint(diagram, source_text, \"source\", parent)\n951:             target = _state_endpoint(diagram, target_text, \"target\", parent)\n952:             if source is None or target is None:\n953:                 _fail(f\"malformed edge at line {line_number}\")\n954:             diagram.add_edge(source, target, clean_label(label))\n955:             continue\n956:         description = re.match(r\"^([A-Za-z_][\\w.-]*)\\s*:\\s*(.+)$\", text)\n957:         if description:\n958:             diagram.add_node(\n959:                 description.group(1), clean_label(description.group(2)), \"state\", parent\n960:             )\n961:             continue\n962:         plain = re.match(r\"^state\\s+([\\w.:-]+)$\", text, re.I)\n963:         if plain:\n964:             diagram.add_node(plain.group(1), plain.group(1), \"state\", parent)\n965: \n966: \n967: def _parse_er(\n968:     diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n969: ) -> None:\n970:     \"\"\"Parse erDiagram statements into entities, fields, and relationships.\"\"\"\n971:     current: Node | None = None\n972:     relationship = re.compile(\n973:         r\"^([A-Za-z_][\\w.-]*)\\s+(\\S*(?:--|\\.\\.)\\S*)\\s+\"\n974:         r\"([A-Za-z_][\\w.-]*)\\s*(?::\\s*(.*))?$\"\n975:     )\n976:     for line_number, raw in lines[header_position + 1 :]:\n977:         text = raw.strip()\n978:         if not text:\n979:             continue\n980:         if _discard_nonsemantic(diagram, text):\n981:             continue\n982:         if text == \"}\":\n983:             current = None\n984:             continue\n985:         direction_match = re.match(r\"^direction\\s+(TD|TB|LR|RL|BT)$\", text, re.I)\n986:         if direction_match and current is None:\n987:             diagram.direction = direction_match.group(1).upper()\n988:             continue\n989:         entity = re.match(r\"^([A-Za-z_][\\w.-]*)\\s*\\{$\", text)\n990:         if entity:\n991:             current = diagram.add_node(entity.group(1), entity.group(1), \"table\")\n992:             continue\n993:         if current is not None:\n994:             current.fields.append(clean_label(text))\n995:             continue\n996:         edge = relationship.match(text)\n997:         if edge:\n998:             source, cardinality, target, relationship_label = edge.groups()\n999:             diagram.add_node(source, source, \"table\")\n1000:             diagram.add_node(target, target, \"table\")\n1001:             left, separator, right = cardinality.partition(\"--\")\n1002:             if not separator:\n1003:                 left, separator, right = cardinality.partition(\"..\")\n1004:             label_parts = [f\"{left} {separator} {right}\".strip()]\n1005:             if relationship_label:\n1006:                 label_parts.append(clean_label(relationship_label))\n1007:             diagram.add_edge(\n1008:                 source,\n1009:                 target,\n1010:                 \" · \".join(label_parts),\n1011:                 \"dashed\" if separator == \"..\" else \"solid\",\n1012:                 \"cardinality\",\n1013:                 undirected=True,\n1014:             )\n1015:             continue\n1016:         if \"--\" in text or \"..\" in text:\n1017:             _fail(f\"malformed edge at line {line_number}\")\n1018: \n1019: \n1020: def parse_block(block: SourceBlock) -> Diagram:\n1021:     \"\"\"Parse one source block into a Diagram by its detected grammar.\n1022: \n1023:     Args:\n1024:         block: The source block to parse.\n1025: \n1026:     Returns:\n1027:         A Diagram with nodes, edges, fragments, and analysis-ready degrees.\n1028:     \"\"\"\n1029:     lines = _prepared_lines(block)\n1030:     kind, direction, header_position = _kind_and_direction(lines)\n1031:     diagram = Diagram(block.index, kind, block.source_line, direction=direction)\n1032:     if kind == \"flowchart\":\n1033:         _parse_flowchart(diagram, lines, header_position)\n1034:     elif kind == \"sequenceDiagram\":\n1035:         _parse_sequence(diagram, lines, header_position)\n1036:     elif kind == \"stateDiagram-v2\":\n1037:         _parse_state(diagram, lines, header_position)\n1038:     else:\n1039:         _parse_er(diagram, lines, header_position)\n1040:     _finalize_degrees(diagram)\n1041:     return diagram\n1042: \n1043: \n1044: def _finalize_degrees(diagram: Diagram) -> None:\n1045:     \"\"\"Accumulate in/out degrees over all edges after parsing.\"\"\"\n1046:     nodes = diagram.node_map\n1047:     for edge in diagram.edges:\n1048:         if edge.source in nodes:\n1049:             nodes[edge.source].out_degree += 1\n1050:         if edge.target in nodes:\n1051:             nodes[edge.target].in_degree += 1\n1052: \n1053: \n1054: def _has_cycle(nodes: list[Node], edges: list[Edge]) -> bool:\n1055:     \"\"\"Detect a cycle in the edge graph via iterative DFS coloring.\"\"\"\n1056:     adjacency: dict[str, list[str]] = {node.id: [] for node in nodes}\n1057:     for edge in edges:\n1058:         if edge.source in adjacency and edge.target in adjacency:\n1059:             adjacency[edge.source].append(edge.target)\n1060:     WHITE, GREY, BLACK = 0, 1, 2\n1061:     colors = {node.id: WHITE for node in nodes}\n1062: \n1063:     def visit(start: str) -> bool:\n1064:         \"\"\"Iterative DFS from `start`; return True if a back-edge (cycle) is found.\"\"\"\n1065:         stack: list[tuple[str, Any]] = [(start, iter(adjacency[start]))]\n1066:         colors[start] = GREY\n1067:         while stack:\n1068:             node_id, targets = stack[-1]\n1069:             for target in targets:\n1070:                 if colors.get(target, BLACK) == GREY:\n1071:                     return True\n1072:                 if colors.get(target, BLACK) == WHITE:\n1073:                     colors[target] = GREY\n1074:                     stack.append((target, iter(adjacency.get(target, []))))\n1075:                     break\n1076:             else:\n1077:                 colors[node_id] = BLACK\n1078:                 stack.pop()\n1079:         return False\n1080: \n1081:     return any(colors[node.id] == WHITE and visit(node.id) for node in nodes)\n1082: \n1083: \n1084: def shape_family(shape: str) -> str:\n1085:     \"\"\"Return the family name for a normalized shape (\"container\" stays as-is).\"\"\"\n1086:     return \"container\" if shape == \"container\" else shape\n1087: \n1088: \n1089: def analyze(diagram: Diagram) -> dict[str, Any]:\n1090:     \"\"\"Compute the structural signals the skill uses to pick a type and detail.\n1091: \n1092:     Args:\n1093:         diagram: The parsed diagram to analyze.\n1094: \n1095:     Returns:\n1096:         A dict with counts, hubs, type candidates, budget flags, and collapsible groups.\n1097:     \"\"\"\n1098:     containers = [node for node in diagram.nodes if node.container or node.children]\n1099:     leaves = [node for node in diagram.nodes if not (node.container or node.children)]\n1100:     shapes: dict[str, int] = {}\n1101:     for node in diagram.nodes:\n1102:         family = shape_family(node.shape)\n1103:         shapes[family] = shapes.get(family, 0) + 1\n1104: \n1105:     def name(node: Node) -> str:\n1106:         \"\"\"Return a single-line display name for a node (label, or its id).\"\"\"\n1107:         return node.label.replace(\"\\n\", \" · \") or node.id\n1108: \n1109:     hubs = [\n1110:         {\"id\": node.id, \"label\": name(node), \"degree\": node.in_degree + node.out_degree}\n1111:         for node in sorted(\n1112:             leaves,\n1113:             key=lambda item: (item.in_degree + item.out_degree, item.id),\n1114:             reverse=True,\n1115:         )[:5]\n1116:         if node.in_degree + node.out_degree > 0\n1117:     ]\n1118:     entry_points = [name(node) for node in leaves if node.out_degree and not node.in_degree]\n1119:     terminals = [name(node) for node in leaves if node.in_degree and not node.out_degree]\n1120:     orphans = [name(node) for node in leaves if not node.in_degree and not node.out_degree]\n1121:     candidates = {\n1122:         \"flowchart\": [\"flowchart\" if shapes.get(\"rhombus\") else \"architecture\", \"architecture\"],\n1123:         \"sequenceDiagram\": [\"sequence\"],\n1124:         \"stateDiagram-v2\": [\"state machine\"],\n1125:         \"erDiagram\": [\"ER / data model\"],\n1126:     }[diagram.kind]\n1127:     candidates = list(dict.fromkeys(candidates))\n1128:     collapsible = [\n1129:         {\n1130:             \"id\": node.id,\n1131:             \"label\": name(node),\n1132:             \"children\": len(node.children),\n1133:             \"child_labels\": [\n1134:                 name(diagram.node_map[child])\n1135:                 for child in node.children\n1136:                 if child in diagram.node_map\n1137:             ][:8],\n1138:         }\n1139:         for node in containers\n1140:         if node.children\n1141:     ]\n1142:     collapsible.sort(key=lambda item: item[\"children\"], reverse=True)\n1143:     drawable = len(leaves)\n1144:     return {\n1145:         \"nodes_total\": len(diagram.nodes),\n1146:         \"nodes_drawable\": drawable,\n1147:         \"containers\": len(containers),\n1148:         \"leaves\": len(leaves),\n1149:         \"edges_total\": len(diagram.edges),\n1150:         \"edges_labeled\": sum(bool(edge.label) for edge in diagram.edges),\n1151:         \"edges_dangling\": 0,\n1152:         \"max_depth\": max((node.depth for node in diagram.nodes), default=0),\n1153:         \"shapes\": dict(sorted(shapes.items(), key=lambda item: (-item[1], item[0]))),\n1154:         \"has_cycle\": _has_cycle(diagram.nodes, diagram.edges),\n1155:         \"hubs\": hubs,\n1156:         \"entry_points\": entry_points[:6],\n1157:         \"terminals\": terminals[:6],\n1158:         \"orphans\": orphans[:6],\n1159:         \"type_candidates\": candidates,\n1160:         \"collapsible_groups\": collapsible[:8],\n1161:         \"over_node_budget\": drawable > 9,\n1162:         \"over_edge_budget\": len(diagram.edges) > 12,\n1163:     }\n1164: \n1165: \n1166: def _escape_markdown(text: str) -> str:\n1167:     \"\"\"Escape markdown-sensitive characters in digest output.\"\"\"\n1168:     encoded = html.escape(text, quote=False)\n1169:     return re.sub(r\"([\\\\`*{}\\[\\]()#+\\-.!_|>])\", r\"\\\\\\1\", encoded)\n1170: \n1171: \n1172: def _escape_table(text: str) -> str:\n1173:     \"\"\"Escape text for a Markdown table cell, flattening newlines.\"\"\"\n1174:     return _escape_markdown(text.replace(\"\\n\", \" ⏎ \"))\n1175: \n1176: \n1177: def digest(\n1178:     path: Path,\n1179:     diagrams: list[Diagram],\n1180:     selected: list[Diagram],\n1181:     max_rows: int,\n1182: ) -> str:\n1183:     \"\"\"Render a compact Markdown digest of the selected diagrams.\n1184: \n1185:     Args:\n1186:         path: The source file path, used for the header line.\n1187:         diagrams: All diagrams in the file, used for the summary line.\n1188:         selected: The diagrams to render in detail.\n1189:         max_rows: Cap on rows per table.\n1190: \n1191:     Returns:\n1192:         The Markdown digest as a string.\n1193:     \"\"\"\n1194:     output = [f\"# Mermaid IR — {path.name}\", \"\"]\n1195:     output.append(\n1196:         f\"{len(diagrams)} diagram(s): \"\n1197:         + \", \".join(\n1198:             f\"[{diagram.index}] {diagram.kind} ({len(diagram.nodes)}n/{len(diagram.edges)}e)\"\n1199:             for diagram in diagrams\n1200:         )\n1201:     )\n1202:     for diagram in selected:\n1203:         info = analyze(diagram)\n1204:         output.extend(\n1205:             [\n1206:                 \"\",\n1207:                 f\"## Diagram {diagram.index} — {diagram.kind}\",\n1208:                 \"\",\n1209:                 f\"- source layout: none (Mermaid is layout-free); direction: {diagram.direction}\",\n1210:                 f\"- nodes: {info['nodes_total']} total / {info['nodes_drawable']} drawable / \"\n1211:                 f\"{info['containers']} containers, depth {info['max_depth']}\",\n1212:                 f\"- edges: {info['edges_total']} ({info['edges_labeled']} labeled, \"\n1213:                 f\"{info['edges_dangling']} dangling), cycle: {info['has_cycle']}\",\n1214:                 f\"- shapes: {info['shapes']}\",\n1215:                 f\"- type candidates: {', '.join(info['type_candidates'])}\",\n1216:                 f\"- budget: nodes {'OVER' if info['over_node_budget'] else 'ok'} (max 9), \"\n1217:                 f\"edges {'OVER' if info['over_edge_budget'] else 'ok'} (max 12)\",\n1218:             ]\n1219:         )\n1220:         if diagram.discarded[\"style_directives\"] or diagram.discarded[\"click_handlers\"]:\n1221:             output.append(\n1222:                 f\"- discarded: {diagram.discarded['style_directives']} style directives, \"\n1223:                 f\"{diagram.discarded['click_handlers']} click handlers\"\n1224:             )\n1225:         if diagram.fragments:\n1226:             fragments = \", \".join(\n1227:                 f\"{item['kind']}({_escape_markdown(item['label'] or 'unlabeled')})\"\n1228:                 for item in diagram.fragments\n1229:             )\n1230:             output.append(f\"- fragments: {fragments}\")\n1231:         if diagram.notes:\n1232:             output.append(\n1233:                 f\"- notes: {'; '.join(_escape_markdown(note) for note in diagram.notes[:6])}\"\n1234:             )\n1235:         if info[\"hubs\"]:\n1236:             output.append(\n1237:                 \"- hubs (focal candidates): \"\n1238:                 + \", \".join(\n1239:                     f\"{_escape_markdown(hub['label'])}({hub['degree']})\"\n1240:                     for hub in info[\"hubs\"]\n1241:                 )\n1242:             )\n1243:         if info[\"entry_points\"]:\n1244:             output.append(\n1245:                 f\"- entry points: {', '.join(_escape_markdown(label) for label in info['entry_points'])}\"\n1246:             )\n1247:         if info[\"terminals\"]:\n1248:             output.append(\n1249:                 f\"- terminals: {', '.join(_escape_markdown(label) for label in info['terminals'])}\"\n1250:             )\n1251:         if info[\"orphans\"]:\n1252:             output.append(\n1253:                 f\"- unconnected: {', '.join(_escape_markdown(label) for label in info['orphans'])}\"\n1254:             )\n1255:         if info[\"collapsible_groups\"]:\n1256:             output.append(\"- collapsible groups (simplify here first):\")\n1257:             for group in info[\"collapsible_groups\"]:\n1258:                 output.append(\n1259:                     f\"  - {_escape_markdown(group['label'])} — {group['children']} children: \"\n1260:                     + \", \".join(_escape_markdown(label) for label in group[\"child_labels\"])\n1261:                 )\n1262: \n1263:         output.extend(\n1264:             [\n1265:                 \"\",\n1266:                 \"### Nodes\",\n1267:                 \"\",\n1268:                 \"| id | label | shape | depth | parent | deg | fields |\",\n1269:                 \"|---|---|---|---|---|---|---|\",\n1270:             ]\n1271:         )\n1272:         for node in diagram.nodes[:max_rows]:\n1273:             output.append(\n1274:                 f\"| {_escape_table(node.id)} | {_escape_table(node.label)} | {node.shape} | \"\n1275:                 f\"{node.depth} | {node.parent or '-'} | {node.in_degree}/{node.out_degree} | \"\n1276:                 f\"{_escape_table('; '.join(node.fields)) or '-'} |\"\n1277:             )\n1278:         if len(diagram.nodes) > max_rows:\n1279:             output.append(\n1280:                 f\"| … | +{len(diagram.nodes) - max_rows} more (use --json) | | | | | |\"\n1281:             )\n1282: \n1283:         output.extend(\n1284:             [\n1285:                 \"\",\n1286:                 \"### Edges\",\n1287:                 \"\",\n1288:                 \"| source | target | label | style |\",\n1289:                 \"|---|---|---|---|\",\n1290:             ]\n1291:         )\n1292:         names = {node.id: node.label.split(\"\\n\")[0] for node in diagram.nodes}\n1293:         for edge in diagram.edges[:max_rows]:\n1294:             marks = [edge.style, edge.arrowhead]\n1295:             if edge.bidirectional:\n1296:                 marks.append(\"bidir\")\n1297:             if edge.undirected:\n1298:                 marks.append(\"undirected\")\n1299:             output.append(\n1300:                 f\"| {_escape_table(names.get(edge.source, edge.source))} | \"\n1301:                 f\"{_escape_table(names.get(edge.target, edge.target))} | \"\n1302:                 f\"{_escape_table(edge.label) or '-'} | {' '.join(marks)} |\"\n1303:             )\n1304:         if len(diagram.edges) > max_rows:\n1305:             output.append(\n1306:                 f\"| … | +{len(diagram.edges) - max_rows} more (use --json) | | |\"\n1307:             )\n1308:     output.append(\"\")\n1309:     return \"\\n\".join(output)\n1310: \n1311: \n1312: def to_json(path: Path, diagrams: list[Diagram], selected: list[Diagram]) -> str:\n1313:     \"\"\"Serialize the full IR of the selected diagrams as JSON.\n1314: \n1315:     Args:\n1316:         path: The source file path, recorded in the payload.\n1317:         diagrams: All diagrams in the file.\n1318:         selected: The diagrams to serialize.\n1319: \n1320:     Returns:\n1321:         A JSON string with analysis, nodes, edges, and fragments per diagram.\n1322:     \"\"\"\n1323:     return json.dumps(\n1324:         {\n1325:             \"source\": str(path),\n1326:             \"diagrams_total\": len(diagrams),\n1327:             \"diagrams\": [\n1328:                 {\n1329:                     \"index\": diagram.index,\n1330:                     \"kind\": diagram.kind,\n1331:                     \"source_line\": diagram.source_line,\n1332:                     \"direction\": diagram.direction,\n1333:                     \"analysis\": analyze(diagram),\n1334:                     \"discarded\": diagram.discarded,\n1335:                     \"fragments\": diagram.fragments,\n1336:                     \"notes\": diagram.notes,\n1337:                     \"nodes\": [asdict(node) for node in diagram.nodes],\n1338:                     \"edges\": [asdict(edge) for edge in diagram.edges],\n1339:                 }\n1340:                 for diagram in selected\n1341:             ],\n1342:         },\n1343:         indent=2,\n1344:         ensure_ascii=False,\n1345:     )\n1346: \n1347: \n1348: def select_diagrams(diagrams: list[Diagram], selector: str | None) -> list[Diagram]:\n1349:     \"\"\"Resolve a --diagram selector to a concrete diagram list.\n1350: \n1351:     Args:\n1352:         diagrams: All parsed diagrams.\n1353:         selector: None, \"all\", or a diagram index.\n1354: \n1355:     Returns:\n1356:         The matching diagrams.\n1357: \n1358:     Raises:\n1359:         SystemExit: With status 2 when the selector matches nothing.\n1360:     \"\"\"\n1361:     if selector is None:\n1362:         return diagrams[:1]\n1363:     if selector == \"all\":\n1364:         return diagrams\n1365:     if selector.isdigit():\n1366:         index = int(selector)\n1367:         selected = [diagram for diagram in diagrams if diagram.index == index]\n1368:         if not selected:\n1369:             _fail(f\"no diagram with index {index} (have 0..{len(diagrams) - 1})\")\n1370:         return selected\n1371:     _fail(\"--diagram must be an index or 'all'\")\n1372: \n1373: \n1374: def main(argv: list[str] | None = None) -> int:\n1375:     \"\"\"Run the Mermaid extractor CLI.\n1376: \n1377:     Args:\n1378:         argv: Command-line arguments; defaults to sys.argv[1:].\n1379: \n1380:     Returns:\n1381:         The process exit code (0 on success, 2 on unreadable input).\n1382:     \"\"\"\n1383:     parser = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n1384:     parser.add_argument(\"file\", help=\".mmd, .mermaid, or Markdown with mermaid fences\")\n1385:     parser.add_argument(\n1386:         \"--diagram\", help=\"diagram index or 'all' (default: first diagram)\"\n1387:     )\n1388:     parser.add_argument(\"--json\", action=\"store_true\", help=\"emit the full IR as JSON\")\n1389:     parser.add_argument(\n1390:         \"--max-rows\",\n1391:         type=int,\n1392:         default=40,\n1393:         help=\"rows per table in the Markdown digest (default 40)\",\n1394:     )\n1395:     parser.add_argument(\"--out\", help=\"write to this path instead of stdout\")\n1396:     args = parser.parse_args(argv)\n1397:     if args.max_rows < 1:\n1398:         _fail(\"--max-rows must be at least 1\")\n1399: \n1400:     path = Path(args.file)\n1401:     if not path.is_file():\n1402:         _fail(f\"{path}: no such file\")\n1403:     blocks = load_blocks(path)\n1404:     diagrams = [parse_block(block) for block in blocks]\n1405:     selected = select_diagrams(diagrams, args.diagram)\n1406:     output = (\n1407:         to_json(path, diagrams, selected)\n1408:         if args.json\n1409:         else digest(path, diagrams, selected, args.max_rows)\n1410:     )\n1411:     if args.out:\n1412:         try:\n1413:             Path(args.out).write_text(output, encoding=\"utf-8\")\n1414:         except OSError as error:\n1415:             _fail(f\"cannot write {args.out}: {error}\")\n1416:         print(f\"wrote {args.out} ({len(output)} bytes)\")\n1417:     else:\n\n(Output capped at 50 KB. Showing lines 1-1417. Use offset=1418 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: MERMAID IR EXTRACTOR\n# ───────────────────────────────────────────────────────────────\n\"\"\"Extract a normalized intermediate representation (IR) from Mermaid text.\n\nTrust boundary: this program parses bounded text. It never evaluates, renders,\nfetches, or executes Mermaid, JavaScript, URLs, directives, or label content.\nEvery label and directive value is untrusted data. Click targets and styling are\ncounted and discarded; retained labels are emitted only as inert text.\n\nSupported grammars are flowchart/graph, sequenceDiagram, stateDiagram-v2, and\nerDiagram. Inputs may be .mmd, .mermaid, or Markdown files containing fenced\n``mermaid`` blocks.\n\nUsage:\n    python3 mermaid_extract.py <file> [--diagram N|all] [--json]\n                               [--max-rows N] [--out PATH]\n\nExit codes: 0 success, 2 unreadable, unsupported, malformed, or over limits.","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/sk-create-diagram/scripts/mermaid_extract.py","text":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: MERMAID IR EXTRACTOR\n# ───────────────────────────────────────────────────────────────\n\"\"\"Extract a normalized intermediate representation (IR) from Mermaid text.\n\nTrust boundary: this program parses bounded text. It never evaluates, renders,\nfetches, or executes Mermaid, JavaScript, URLs, directives, or label content.\nEvery label and directive value is untrusted data. Click targets and styling are\ncounted and discarded; retained labels are emitted only as inert text.\n\nSupported grammars are flowchart/graph, sequenceDiagram, stateDiagram-v2, and\nerDiagram. Inputs may be .mmd, .mermaid, or Markdown files containing fenced\n``mermaid`` blocks.\n\nUsage:\n    python3 mermaid_extract.py <file> [--diagram N|all] [--json]\n                               [--max-rows N] [--out PATH]\n\nExit codes: 0 success, 2 unreadable, unsupported, malformed, or over limits.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport html\nimport json\nimport re\nimport sys\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Any, NoReturn\n\n\nMAX_SOURCE_BYTES = 4 * 1024 * 1024\nMAX_NODES = 2000\nMAX_EDGES = 5000\nSUPPORTED_KINDS = \"flowchart, sequenceDiagram, stateDiagram-v2, erDiagram\"\nUNSUPPORTED_KINDS = {\n    \"pie\",\n    \"mindmap\",\n    \"gitgraph\",\n    \"quadrantchart\",\n    \"timeline\",\n    \"c4context\",\n    \"sankey\",\n    \"sankey-beta\",\n    \"gantt\",\n    \"journey\",\n    \"classdiagram\",\n    \"statediagram\",\n}\nMARKDOWN_SUFFIXES = {\".md\", \".markdown\", \".mdown\", \".mkd\"}\nMERMAID_SUFFIXES = {\".mmd\", \".mermaid\"}\n\n\ndef _fail(message: str) -> NoReturn:\n    \"\"\"Print an error to stderr and exit with status 2.\"\"\"\n    print(f\"mermaid_extract: {message}\", file=sys.stderr)\n    raise SystemExit(2)\n\n\n@dataclass\nclass Node:\n    \"\"\"A node with optional container/parent/depth bookkeeping.\"\"\"\n\n    id: str\n    label: str = \"\"\n    shape: str = \"rect\"\n    parent: str | None = None\n    depth: int = 0\n    container: bool = False\n    children: list[str] = field(default_factory=list)\n    fields: list[str] = field(default_factory=list)\n    in_degree: int = 0\n    out_degree: int = 0\n\n\n@dataclass\nclass Edge:\n    \"\"\"A directed or undirected connection with style and arrowhead.\"\"\"\n\n    id: str\n    source: str\n    target: str\n    label: str = \"\"\n    style: str = \"solid\"\n    arrowhead: str = \"arrow\"\n    bidirectional: bool = False\n    undirected: bool = False\n    order: int = 0\n\n\n@dataclass\nclass Diagram:\n    \"\"\"One parsed Mermaid diagram with nodes, edges, fragments, and notes.\"\"\"\n\n    index: int\n    kind: str\n    source_line: int\n    direction: str = \"TD\"\n    nodes: list[Node] = field(default_factory=list)\n    edges: list[Edge] = field(default_factory=list)\n    fragments: list[dict[str, Any]] = field(default_factory=list)\n    notes: list[str] = field(default_factory=list)\n    discarded: dict[str, int] = field(\n        default_factory=lambda: {\"style_directives\": 0, \"click_handlers\": 0}\n    )\n    _nodes_by_id: dict[str, Node] = field(default_factory=dict, init=False, repr=False)\n\n    @property\n    def node_map(self) -> dict[str, Node]:\n        \"\"\"Return the id -> Node index for this diagram.\"\"\"\n        return self._nodes_by_id\n\n    def add_node(\n        self,\n        node_id: str,\n        label: str = \"\",\n        shape: str = \"rect\",\n        parent: str | None = None,\n        container: bool = False,\n    ) -> Node:\n        \"\"\"Add or update a node, merging labels, shapes, and parents.\n\n        Args:\n            node_id: The node identifier.\n            label: The display label; ignored when empty or already set.\n            shape: The normalized shape family.\n            parent: Optional parent node id; sets depth and attachment.\n            container: Whether the node is a container.\n\n        Returns:\n            The created or updated Node.\n\n        Raises:\n            SystemExit: With status 2 when MAX_NODES is exceeded.\n        \"\"\"\n        existing = self._nodes_by_id.get(node_id)\n        if existing is not None:\n            if label and (label != node_id or existing.label == existing.id):\n                existing.label = label\n            if shape != \"rect\" or not existing.shape:\n                existing.shape = shape\n            if parent is not None and existing.parent is None:\n                existing.parent = parent\n                existing.depth = self._depth_for(parent)\n                self._attach(parent, node_id)\n            existing.container = existing.container or container\n            return existing\n        if len(self.nodes) >= MAX_NODES:\n            _fail(f\"node limit exceeded (max {MAX_NODES})\")\n        node = Node(\n            id=node_id,\n            label=label or node_id,\n            shape=shape,\n            parent=parent,\n            depth=self._depth_for(parent),\n            container=container,\n        )\n        self.nodes.append(node)\n        self._nodes_by_id[node_id] = node\n        if parent is not None:\n            self._attach(parent, node_id)\n        return node\n\n    def _depth_for(self, parent: str | None) -> int:\n        \"\"\"Return the depth for a parent node id (0 when parent is None).\"\"\"\n        if parent is None:\n            return 0\n        parent_node = self._nodes_by_id.get(parent)\n        return (parent_node.depth + 1) if parent_node is not None else 1\n\n    def _attach(self, parent: str, child: str) -> None:\n        \"\"\"Attach a child id to a parent's children list if not already present.\"\"\"\n        parent_node = self._nodes_by_id.get(parent)\n        if parent_node is not None and child not in parent_node.children:\n            parent_node.children.append(child)\n            parent_node.container = True\n\n    def add_edge(\n        self,\n        source: str,\n        target: str,\n        label: str = \"\",\n        style: str = \"solid\",\n        arrowhead: str = \"arrow\",\n        bidirectional: bool = False,\n        undirected: bool = False,\n    ) -> Edge:\n        \"\"\"Append an edge to the diagram with an auto-incrementing id.\n\n        Args:\n            source: Source node id.\n            target: Target node id.\n            label: Optional edge label.\n            style: solid, dashed, or thick.\n            arrowhead: arrow, open, cross, or cardinality marker.\n            bidirectional: Whether both ends carry markers.\n            undirected: Whether the edge has no arrowheads.\n\n        Returns:\n            The created Edge.\n\n        Raises:\n            SystemExit: With status 2 when MAX_EDGES is exceeded.\n        \"\"\"\n        if len(self.edges) >= MAX_EDGES:\n            _fail(f\"edge limit exceeded (max {MAX_EDGES})\")\n        edge = Edge(\n            id=f\"e{len(self.edges) + 1}\",\n            source=source,\n            target=target,\n            label=label,\n            style=style,\n            arrowhead=arrowhead,\n            bidirectional=bidirectional,\n            undirected=undirected,\n            order=len(self.edges) + 1,\n        )\n        self.edges.append(edge)\n        return edge\n\n\n@dataclass\nclass SourceBlock:\n    \"\"\"One mermaid source block with its file-relative start line.\"\"\"\n\n    index: int\n    text: str\n    source_line: int\n\n\ndef clean_label(value: str) -> str:\n    \"\"\"Flatten Mermaid label markup without interpreting it.\"\"\"\n    text = value.strip()\n    if len(text) >= 2 and text[0] == text[-1] and text[0] in \"\\\"'`\":\n        text = text[1:-1]\n    if text.startswith(\"`\") and text.endswith(\"`\"):\n        text = text[1:-1]\n    text = re.sub(r\"<br\\s*/?>\", \"\\n\", text, flags=re.IGNORECASE)\n    text = re.sub(r\"<[^>]+>\", \"\", text)\n    text = re.sub(r\"(?<!&)#(quot|apos|amp|lt|gt);\", r\"&\\1;\", text)\n    text = html.unescape(text)\n    text = re.sub(r\"\\*\\*(.*?)\\*\\*\", r\"\\1\", text)\n    text = re.sub(r\"__(.*?)__\", r\"\\1\", text)\n    text = re.sub(r\"(?<!\\w)[*_](.*?)[*_](?!\\w)\", r\"\\1\", text)\n    text = text.replace(\"\\\\\\\"\", '\"').replace(\"\\\\'\", \"'\")\n    return \"\\n\".join(part.strip() for part in text.splitlines()).strip()\n\n\ndef _read_bounded(path: Path) -> str:\n    \"\"\"Read the source file up to MAX_SOURCE_BYTES, decoding it as UTF-8.\"\"\"\n    try:\n        with path.open(\"rb\") as source:\n            data = source.read(MAX_SOURCE_BYTES + 1)\n    except OSError as error:\n        _fail(f\"{path}: {error}\")\n    if len(data) > MAX_SOURCE_BYTES:\n        _fail(\n            f\"source exceeds the {MAX_SOURCE_BYTES // (1024 * 1024)} MiB limit\"\n        )\n    try:\n        return data.decode(\"utf-8\")\n    except UnicodeDecodeError:\n        _fail(f\"{path.name}: source is not valid UTF-8 text\")\n\n\ndef load_blocks(path: Path) -> list[SourceBlock]:\n    \"\"\"Split a Mermaid or Markdown file into source blocks.\n\n    Args:\n        path: Path to a .mmd, .mermaid, or Markdown file with mermaid fences.\n\n    Returns:\n        A list of SourceBlock: one entry for .mmd/.mermaid, one per fenced block.\n\n    Raises:\n        SystemExit: With status 2 for unsupported files or missing/empty blocks.\n    \"\"\"\n    suffix = path.suffix.casefold()\n    if suffix not in MERMAID_SUFFIXES | MARKDOWN_SUFFIXES:\n        _fail(f\"{path.name}: not a Mermaid file\")\n    source = _read_bounded(path)\n    if suffix in MERMAID_SUFFIXES:\n        return [SourceBlock(0, source, 1)]\n\n    blocks: list[SourceBlock] = []\n    lines = source.splitlines()\n    start: int | None = None\n    fence = \"\"\n    content: list[str] = []\n    for line_number, line in enumerate(lines, 1):\n        if start is None:\n            match = re.match(r\"^\\s*(`{3,}|~{3,})\\s*mermaid\\s*$\", line, re.I)\n            if match:\n                start = line_number + 1\n                fence = match.group(1)\n                content = []\n            continue\n        if re.match(rf\"^\\s*{re.escape(fence[0])}{{{len(fence)},}}\\s*$\", line):\n            blocks.append(SourceBlock(len(blocks), \"\\n\".join(content), start))\n            start = None\n            fence = \"\"\n            content = []\n        else:\n            content.append(line)\n    if start is not None:\n        _fail(f\"{path.name}: unterminated mermaid fence starting at line {start - 1}\")\n    if not blocks:\n        _fail(f\"{path.name}: no fenced mermaid block found\")\n    return blocks\n\n\nFRONTMATTER_MAX_LINES = 40\n\n\ndef _frontmatter_end(lines: list[str]) -> int:\n    \"\"\"Return the last line index of a leading `---` frontmatter block, or -1.\"\"\"\n    first = next(\n        (index for index, line in enumerate(lines) if line.strip()),\n        None,\n    )\n    if first is None or lines[first].strip() != \"---\":\n        return -1\n    limit = min(len(lines), first + FRONTMATTER_MAX_LINES + 1)\n    for index in range(first + 1, limit):\n        if lines[index].strip() == \"---\":\n            return index\n    return -1\n\n\ndef _prepared_lines(block: SourceBlock) -> list[tuple[int, str]]:\n    \"\"\"Mask directives and frontmatter so the parser sees only diagram statements.\"\"\"\n    prepared: list[tuple[int, str]] = []\n    in_directive = False\n    lines = block.text.splitlines()\n    frontmatter_end = _frontmatter_end(lines)\n    for offset, raw in enumerate(lines):\n        line_number = block.source_line + offset\n        stripped = raw.strip()\n        if offset <= frontmatter_end:\n            # Mermaid's `--- title: ... ---` frontmatter is source config; the\n            # redraw discards it the same way it discards `%%{init}%%`.\n            prepared.append((line_number, \"\"))\n            continue\n        if in_directive:\n            if \"}%%\" in stripped:\n                in_directive = False\n            prepared.append((line_number, \"\"))\n            continue\n        if stripped.startswith(\"%%{\"):\n            if \"}%%\" not in stripped:\n                in_directive = True\n            prepared.append((line_number, \"\"))\n            continue\n        if stripped.startswith(\"%%\"):\n            prepared.append((line_number, \"\"))\n            continue\n        prepared.append((line_number, raw.rstrip()))\n    return prepared\n\n\ndef _kind_and_direction(\n    lines: list[tuple[int, str]],\n) -> tuple[str, str, int]:\n    \"\"\"Return the diagram kind, declared direction, and header line position.\"\"\"\n    for position, (line_number, raw) in enumerate(lines):\n        text = raw.strip()\n        if not text:\n            continue\n        match = re.match(r\"^(flowchart|graph)\\s+(TD|TB|LR|RL|BT)\\b\", text, re.I)\n        if match:\n            return \"flowchart\", match.group(2).upper(), position\n        if re.match(r\"^sequenceDiagram\\b\", text, re.I):\n            return \"sequenceDiagram\", \"LR\", position\n        if re.match(r\"^stateDiagram-v2\\b\", text, re.I):\n            return \"stateDiagram-v2\", \"TD\", position\n        if re.match(r\"^erDiagram\\b\", text, re.I):\n            return \"erDiagram\", \"TD\", position\n        token = text.split(maxsplit=1)[0]\n        if token.casefold() in UNSUPPORTED_KINDS:\n            _fail(\n                f\"unsupported diagram kind: `{token}` (supported: {SUPPORTED_KINDS})\"\n            )\n        _fail(f\"not a Mermaid file at line {line_number}\")\n    _fail(\"not a Mermaid file\")\n\n\ndef _top_level_mask(text: str) -> str:\n    \"\"\"Keep top-level syntax positions and blank quoted/bracketed content.\"\"\"\n    output = list(text)\n    stack: list[str] = []\n    quote: str | None = None\n    escaped = False\n    pairs = {\"]\": \"[\", \")\": \"(\", \"}\": \"{\"}\n    for index, character in enumerate(text):\n        if quote is not None:\n            output[index] = \" \"\n            if escaped:\n                escaped = False\n            elif character == \"\\\\\":\n                escaped = True\n            elif character == quote:\n                quote = None\n            continue\n        if character in \"\\\"'`\":\n            quote = character\n            output[index] = \" \"\n            continue\n        if character in \"[({\":\n            stack.append(character)\n            output[index] = \" \"\n            continue\n        if character in \"])}\":\n            if stack and stack[-1] == pairs[character]:\n                stack.pop()\n            output[index] = \" \"\n            continue\n        if stack:\n            output[index] = \" \"\n    return \"\".join(output)\n\n\ndef _split_top_level(text: str, delimiter: str) -> list[str]:\n    \"\"\"Split text on a delimiter only at top-level (unquoted/unbracketed) positions.\"\"\"\n    mask = _top_level_mask(text)\n    parts: list[str] = []\n    start = 0\n    for index, character in enumerate(mask):\n        if character == delimiter:\n            parts.append(text[start:index])\n            start = index + 1\n    parts.append(text[start:])\n    return parts\n\n\ndef _statement_complete(text: str) -> bool:\n    \"\"\"Return whether quotes and node delimiters close within a statement.\"\"\"\n    stack: list[str] = []\n    quote: str | None = None\n    escaped = False\n    pairs = {\"]\": \"[\", \")\": \"(\", \"}\": \"{\"}\n    for character in text:\n        if quote is not None:\n            if escaped:\n                escaped = False\n            elif character == \"\\\\\":\n                escaped = True\n            elif character == quote:\n                quote = None\n            continue\n        if character in \"\\\"'`\":\n            quote = character\n        elif character in \"[({\":\n            stack.append(character)\n        elif character in \"])}\":\n            if stack and stack[-1] == pairs[character]:\n                stack.pop()\n    return quote is None and not stack\n\n\ndef _logical_statements(\n    lines: list[tuple[int, str]],\n) -> list[tuple[int, str]]:\n    \"\"\"Join multiline Mermaid strings before parsing semicolon statements.\"\"\"\n    logical: list[tuple[int, str]] = []\n    pending: list[str] = []\n    start_line = 0\n    for line_number, raw in lines:\n        if not pending and not raw.strip():\n            continue\n        if not pending:\n            start_line = line_number\n        pending.append(raw)\n        combined = \"\\n\".join(pending)\n        if not _statement_complete(combined):\n            continue\n        logical.extend(\n            (start_line, statement)\n            for statement in _split_top_level(combined, \";\")\n        )\n        pending = []\n    if pending:\n        _fail(f\"unterminated statement at line {start_line}\")\n    return logical\n\n\nSHAPE_FOR_DELIMITERS = (\n    (\"(((\", \")))\", \"circle\"),\n    (\"((\", \"))\", \"circle\"),\n    (\"([\", \"])\", \"stadium\"),\n    (\"{{\", \"}}\", \"hexagon\"),\n    (\"[(\", \")]\", \"cylinder\"),\n    (\"[[\", \"]]\", \"subroutine\"),\n    (\"[/\", \"/]\", \"parallelogram\"),\n    (\"[\\\\\", \"\\\\]\", \"parallelogram\"),\n    (\"[/\", \"\\\\]\", \"trapezoid\"),\n    (\"[\\\\\", \"/]\", \"trapezoid\"),\n    (\"[\", \"]\", \"rect\"),\n    (\"(\", \")\", \"round\"),\n    (\"{\", \"}\", \"rhombus\"),\n    (\">\", \"]\", \"asymmetric\"),\n)\n\nEXPANDED_SHAPE_FAMILIES = {\n    \"rect\": \"rect\",\n    \"rectangle\": \"rect\",\n    \"proc\": \"rect\",\n    \"process\": \"rect\",\n    \"rounded\": \"round\",\n    \"event\": \"round\",\n    \"stadium\": \"stadium\",\n    \"pill\": \"stadium\",\n    \"terminal\": \"stadium\",\n    \"circle\": \"circle\",\n    \"circ\": \"circle\",\n    \"sm-circ\": \"circle\",\n    \"small-circle\": \"circle\",\n    \"start\": \"circle\",\n    \"dbl-circ\": \"circle\",\n    \"double-circle\": \"circle\",\n    \"fr-circ\": \"circle\",\n    \"framed-circle\": \"circle\",\n    \"stop\": \"circle\",\n    \"cyl\": \"cylinder\",\n    \"cylinder\": \"cylinder\",\n    \"database\": \"cylinder\",\n    \"db\": \"cylinder\",\n    \"h-cyl\": \"cylinder\",\n    \"horizontal-cylinder\": \"cylinder\",\n    \"lin-cyl\": \"cylinder\",\n    \"lined-cylinder\": \"cylinder\",\n    \"diam\": \"rhombus\",\n    \"decision\": \"rhombus\",\n    \"diamond\": \"rhombus\",\n    \"question\": \"rhombus\",\n    \"hex\": \"hexagon\",\n    \"hexagon\": \"hexagon\",\n    \"prepare\": \"hexagon\",\n    \"fr-rect\": \"subroutine\",\n    \"framed-rectangle\": \"subroutine\",\n    \"subproc\": \"subroutine\",\n    \"subprocess\": \"subroutine\",\n    \"subroutine\": \"subroutine\",\n    \"lean-r\": \"parallelogram\",\n    \"lean-l\": \"parallelogram\",\n    \"in-out\": \"parallelogram\",\n    \"lean-right\": \"parallelogram\",\n    \"lean-left\": \"parallelogram\",\n    \"out-in\": \"parallelogram\",\n    \"trap-t\": \"trapezoid\",\n    \"trap-b\": \"trapezoid\",\n    \"trapezoid\": \"trapezoid\",\n    \"inv-trapezoid\": \"trapezoid\",\n    \"manual\": \"trapezoid\",\n    \"priority\": \"trapezoid\",\n}\n\n\ndef classify_shape(expression: str) -> str:\n    \"\"\"Return the normalized Mermaid shape family for a node suffix.\"\"\"\n    for opening, closing, shape in SHAPE_FOR_DELIMITERS:\n        if expression.startswith(opening) and expression.endswith(closing):\n            return shape\n    return \"rect\"\n\n\ndef _strip_class_suffix(text: str) -> str:\n    \"\"\"Drop Mermaid's `:::class` attachment; source styling is discarded.\"\"\"\n    mask = _top_level_mask(text)\n    index = mask.find(\":::\")\n    if index == -1:\n        return text\n    end = index + 3\n    while end < len(text) and (text[end].isalnum() or text[end] in \"_-\"):\n        end += 1\n    return (text[:index] + text[end:]).strip()\n\n\ndef _parse_expanded_attributes(text: str) -> tuple[str, str] | None:\n    \"\"\"Normalize Mermaid v11.3+ ``@{ ... }`` node attributes.\n\n    Only semantic label/shape data crosses the trust boundary. Image URLs,\n    registered icon names, dimensions, and renderer configuration are dropped.\n    \"\"\"\n    if not text.startswith(\"@{\") or not text.endswith(\"}\"):\n        return None\n    values: dict[str, str] = {}\n    for raw_attribute in _split_top_level(text[2:-1], \",\"):\n        key, separator, raw_value = raw_attribute.partition(\":\")\n        if not separator:\n            continue\n        key = key.strip().casefold()\n        if not re.fullmatch(r\"[a-z][a-z0-9_-]*\", key):\n            continue\n        values[key] = clean_label(raw_value)\n    shape_name = values.get(\"shape\", \"\").casefold()\n    if not shape_name:\n        if \"img\" in values:\n            shape_name = \"image\"\n        elif \"icon\" in values:\n            shape_name = \"icon\"\n        else:\n            shape_name = \"rect\"\n    if not re.fullmatch(r\"[a-z][a-z0-9-]*\", shape_name):\n        shape_name = \"rect\"\n    shape = EXPANDED_SHAPE_FAMILIES.get(shape_name, shape_name)\n    return values.get(\"label\", \"\"), shape\n\n\ndef _parse_node_expression(expression: str) -> tuple[str, str, str] | None:\n    \"\"\"Parse one node expression into (node_id, label, shape) or None.\"\"\"\n    text = _strip_class_suffix(expression.strip().rstrip(\";\").strip())\n    if not text:\n        return None\n    match = re.match(r\"^([\\w.:-]+)\", text, re.UNICODE)\n    if match is None:\n        return None\n    node_id = match.group(1)\n    rest = text[match.end() :].strip()\n    if not rest:\n        return node_id, node_id, \"rect\"\n    expanded = _parse_expanded_attributes(rest)\n    if expanded is not None:\n        label, shape = expanded\n        return node_id, label or node_id, shape\n    for opening, closing, _shape in SHAPE_FOR_DELIMITERS:\n        if rest.startswith(opening) and rest.endswith(closing):\n            label = rest[len(opening) : len(rest) - len(closing)]\n            return node_id, clean_label(label), classify_shape(rest)\n    return None\n\n\n@dataclass\nclass _Operator:\n    \"\"\"A link operator match with its label and style flags.\"\"\"\n\n    start: int\n    end: int\n    label: str\n    style: str\n    arrowhead: str\n    bidirectional: bool = False\n    undirected: bool = False\n\n\ndef _operator_style(token: str) -> tuple[str, str, bool, bool]:\n    \"\"\"Map a link operator token to style, arrowhead, and direction flags.\"\"\"\n    style = \"dashed\" if \".\" in token else \"thick\" if \"=\" in token else \"solid\"\n    arrowhead = \"cross\" if token.endswith(\"x\") else \"circle\" if token.endswith(\"o\") else \"arrow\"\n    undirected = \">\" not in token and not token.endswith((\"x\", \"o\"))\n    bidirectional = (\n        token.startswith(\"<\") and token.endswith(\">\")\n    ) or (token.startswith((\"x\", \"o\")) and token.endswith((\"x\", \"o\")))\n    return style, arrowhead, bidirectional, undirected\n\n\ndef _edge_operators(text: str) -> list[_Operator]:\n    \"\"\"Find link operators in a statement, carrying their inline labels.\"\"\"\n    mask = _top_level_mask(text)\n    operators: list[_Operator] = []\n    occupied: list[tuple[int, int]] = []\n\n    # Labeled links carry the label between the opening and closing operator:\n    # `A-- text -->B`, `A-. retry .-> B`, `A== critical ==> B`, and the\n    # undirected forms of each.\n    text_edge = re.compile(\n        r\"(?:--|-\\.|==)\\s+(.+?)\\s+(\\.-+[>xo]|\\.-+|-{2,}>|--[xo]|=+>|={2,}|-{3,})\"\n    )\n    for match in text_edge.finditer(mask):\n        token = match.group(2)\n        style, arrowhead, bidirectional, undirected = _operator_style(token)\n        operators.append(\n            _Operator(\n                match.start(),\n                match.end(),\n                clean_label(text[match.start(1) : match.end(1)]),\n                style,\n                arrowhead,\n                bidirectional,\n                undirected,\n            )\n        )\n        occupied.append((match.start(), match.end()))\n\n    pattern = re.compile(\n        r\"[xo][-=.]+[xo]|<[-=.]+>|-+\\.-+>|=+>|-+(?:>|x|o)|-+\\.-+|={3,}|-{3,}\"\n    )\n    for match in pattern.finditer(mask):\n        if any(start <= match.start() < end for start, end in occupied):\n            continue\n        token = match.group()\n        end = match.end()\n        label = \"\"\n        if end < len(text) and text[end] == \"|\":\n            close = text.find(\"|\", end + 1)\n            if close != -1:\n                label = clean_label(text[end + 1 : close])\n                end = close + 1\n        style, arrowhead, bidirectional, undirected = _operator_style(token)\n        operators.append(\n            _Operator(\n                match.start(), end, label, style, arrowhead, bidirectional, undirected\n            )\n        )\n        occupied.append((match.start(), end))\n    return sorted(operators, key=lambda operator: operator.start)\n\n\ndef _endpoint_group(\n    diagram: Diagram, text: str, parent: str | None\n) -> list[str] | None:\n    \"\"\"Parse an ampersand-joined endpoint group into node identifiers or None.\"\"\"\n    identifiers: list[str] = []\n    for raw in _split_top_level(text.strip(), \"&\"):\n        parsed = _parse_node_expression(raw)\n        if parsed is None:\n            return None\n        node_id, label, shape = parsed\n        diagram.add_node(node_id, label, shape, parent)\n        identifiers.append(node_id)\n    return identifiers or None\n\n\nSTYLE_DIRECTIVES = (\"style \", \"classDef \", \"class \", \"linkStyle \")\n\n\ndef _discard_nonsemantic(diagram: Diagram, text: str) -> bool:\n    \"\"\"Count and drop style directives and click handlers from a statement.\"\"\"\n    lowered = text.casefold()\n    if any(lowered.startswith(prefix.casefold()) for prefix in STYLE_DIRECTIVES):\n        diagram.discarded[\"style_directives\"] += 1\n        return True\n    if lowered.startswith(\"click \"):\n        diagram.discarded[\"click_handlers\"] += 1\n        return True\n    return False\n\n\ndef _parse_flowchart(\n    diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n) -> None:\n    \"\"\"Parse flowchart/graph statements into nodes, edges, and containers.\"\"\"\n    containers: list[str] = []\n    for line_number, raw in _logical_statements(lines[header_position + 1 :]):\n        text = raw.strip()\n        if not text:\n            continue\n        lowered = text.casefold()\n        if _discard_nonsemantic(diagram, text):\n            continue\n        if lowered.startswith(\"direction \"):\n            if not containers:\n                direction = text.split(maxsplit=1)[1].upper()\n                if direction in {\"TD\", \"TB\", \"LR\", \"RL\", \"BT\"}:\n                    diagram.direction = direction\n            continue\n        if lowered.startswith(\"subgraph \"):\n            spec = text.split(maxsplit=1)[1].strip()\n            parsed = _parse_node_expression(spec)\n            if parsed is None:\n                generated = f\"subgraph-{len([node for node in diagram.nodes if node.container]) + 1}\"\n                node_id, label = generated, clean_label(spec)\n            else:\n                node_id, label, _shape = parsed\n            parent = containers[-1] if containers else None\n            diagram.add_node(node_id, label, \"container\", parent, container=True)\n            containers.append(node_id)\n            continue\n        if lowered == \"end\":\n            if containers:\n                containers.pop()\n            continue\n\n        operators = _edge_operators(text)\n        parent = containers[-1] if containers else None\n        if operators:\n            segments: list[str] = []\n            cursor = 0\n            for operator in operators:\n                segments.append(text[cursor : operator.start])\n                cursor = operator.end\n            segments.append(text[cursor:])\n            if len(segments) != len(operators) + 1:\n                _fail(f\"malformed edge at line {line_number}\")\n            groups = [_endpoint_group(diagram, segment, parent) for segment in segments]\n            if any(group is None for group in groups):\n                _fail(f\"malformed edge at line {line_number}\")\n            valid_groups = [group for group in groups if group is not None]\n            for index, operator in enumerate(operators):\n                for source in valid_groups[index]:\n                    for target in valid_groups[index + 1]:\n                        diagram.add_edge(\n                            source,\n                            target,\n                            operator.label,\n                            operator.style,\n                            operator.arrowhead,\n                            operator.bidirectional,\n                            operator.undirected,\n                        )\n            continue\n        if re.search(r\"(?:--|==|-.).*?(?:>|x|o|-)\", _top_level_mask(text)):\n            _fail(f\"malformed edge at line {line_number}\")\n        parsed = _parse_node_expression(text)\n        if parsed is not None:\n            node_id, label, shape = parsed\n            diagram.add_node(node_id, label, shape, parent)\n\n\ndef _parse_sequence(\n    diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n) -> None:\n    \"\"\"Parse sequenceDiagram statements into participants, messages, and fragments.\"\"\"\n    fragment_stack: list[dict[str, Any]] = []\n    participant_re = re.compile(\n        r\"^(participant|actor)\\s+([\\w.:-]+)(?:\\s+as\\s+(.+))?$\", re.I\n    )\n    message_re = re.compile(\n        r\"^([\\w.:-]+?)(?:\\(\\))?\\s*(--?>>|--?>|--?\\)|--?x)\"\n        r\"\\s*[+-]?\\s*(?:\\(\\))?([\\w.:-]+)\\s*:\\s*(.*)$\"\n    )\n    for line_number, raw in lines[header_position + 1 :]:\n        text = raw.strip()\n        if not text:\n            continue\n        lowered = text.casefold()\n        if _discard_nonsemantic(diagram, text):\n            continue\n        participant = participant_re.match(text)\n        if participant:\n            node_id = participant.group(2)\n            diagram.add_node(\n                node_id,\n                clean_label(participant.group(3) or node_id),\n                \"actor\" if participant.group(1).casefold() == \"actor\" else \"lifeline\",\n            )\n            continue\n        fragment = re.match(r\"^(alt|opt|loop|par|critical|break)\\b\\s*(.*)$\", text, re.I)\n        if fragment:\n            entry = {\n                \"kind\": fragment.group(1).casefold(),\n                \"label\": clean_label(fragment.group(2)),\n                \"line\": line_number,\n                \"depth\": len(fragment_stack),\n                \"regions\": [],\n            }\n            diagram.fragments.append(entry)\n            fragment_stack.append(entry)\n            continue\n        region = re.match(r\"^(else|and|option)\\b\\s*(.*)$\", text, re.I)\n        if region and fragment_stack:\n            fragment_stack[-1][\"regions\"].append(clean_label(region.group(2)))\n            continue\n        if lowered == \"end\":\n            if fragment_stack:\n                fragment_stack.pop()\n            continue\n        if lowered.startswith((\"activate \", \"deactivate \", \"+\", \"-\")):\n            continue\n        if lowered.startswith(\"note \"):\n            _, separator, note = text.partition(\":\")\n            diagram.notes.append(clean_label(note if separator else text[5:]))\n            continue\n        message = message_re.match(text)\n        if message:\n            source, token, target, label = message.groups()\n            diagram.add_node(source, source, \"lifeline\")\n            diagram.add_node(target, target, \"lifeline\")\n            diagram.add_edge(\n                source,\n                target,\n                clean_label(label),\n                \"dashed\" if token.startswith(\"--\") else \"solid\",\n                \"cross\" if token.endswith(\"x\") else \"async\" if token.endswith(\")\") else \"arrow\",\n            )\n            continue\n        if re.search(r\"--?>>|--?>|--?\\)|--?x\", text):\n            _fail(f\"malformed edge at line {line_number}\")\n\n\ndef _state_endpoint(\n    diagram: Diagram,\n    token: str,\n    role: str,\n    parent: str | None,\n) -> str | None:\n    \"\"\"Resolve a state endpoint token to a node id, creating start/end markers.\"\"\"\n    value = _strip_class_suffix(token.strip())\n    if value == \"[*]\":\n        prefix = \"start\" if role == \"source\" else \"end\"\n        count = sum(node.id.startswith(\"__\" + prefix) for node in diagram.nodes)\n        node_id = f\"__{prefix}_{count + 1}\"\n        diagram.add_node(node_id, f\"[{prefix}]\", prefix, parent)\n        return node_id\n    parsed = _parse_node_expression(value)\n    if parsed is None:\n        return None\n    node_id, label, shape = parsed\n    diagram.add_node(node_id, label, \"state\" if shape == \"rect\" else shape, parent)\n    return node_id\n\n\ndef _parse_state(\n    diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n) -> None:\n    \"\"\"Parse stateDiagram-v2 statements into states and transitions.\"\"\"\n    containers: list[str] = []\n    for line_number, raw in lines[header_position + 1 :]:\n        text = raw.strip()\n        if not text:\n            continue\n        if _discard_nonsemantic(diagram, text):\n            continue\n        if text == \"}\":\n            if containers:\n                containers.pop()\n            continue\n        parent = containers[-1] if containers else None\n        direction_match = re.match(r\"^direction\\s+(TD|TB|LR|RL|BT)$\", text, re.I)\n        if direction_match and not containers:\n            diagram.direction = direction_match.group(1).upper()\n            continue\n        composite = re.match(r\"^state\\s+([\\w.:-]+)\\s*\\{$\", text, re.I)\n        if composite:\n            node_id = composite.group(1)\n            diagram.add_node(node_id, node_id, \"container\", parent, container=True)\n            containers.append(node_id)\n            continue\n        alias = re.match(r'^state\\s+\"(.*?)\"\\s+as\\s+([\\w.:-]+)$', text, re.I)\n        if alias:\n            diagram.add_node(alias.group(2), clean_label(alias.group(1)), \"state\", parent)\n            continue\n        stereotype = re.match(\n            r\"^state\\s+([\\w.:-]+)\\s+<<(fork|join|choice)>>$\", text, re.I\n        )\n        if stereotype:\n            diagram.add_node(\n                stereotype.group(1), stereotype.group(1), stereotype.group(2).casefold(), parent\n            )\n            continue\n        if \"-->\" in text:\n            source_text, target_text = text.split(\"-->\", 1)\n            label = \"\"\n            label_separator = re.search(r\"(?<!:):(?!:)\", target_text)\n            if label_separator:\n                label = target_text[label_separator.end() :]\n                target_text = target_text[: label_separator.start()]\n            source = _state_endpoint(diagram, source_text, \"source\", parent)\n            target = _state_endpoint(diagram, target_text, \"target\", parent)\n            if source is None or target is None:\n                _fail(f\"malformed edge at line {line_number}\")\n            diagram.add_edge(source, target, clean_label(label))\n            continue\n        description = re.match(r\"^([A-Za-z_][\\w.-]*)\\s*:\\s*(.+)$\", text)\n        if description:\n            diagram.add_node(\n                description.group(1), clean_label(description.group(2)), \"state\", parent\n            )\n            continue\n        plain = re.match(r\"^state\\s+([\\w.:-]+)$\", text, re.I)\n        if plain:\n            diagram.add_node(plain.group(1), plain.group(1), \"state\", parent)\n\n\ndef _parse_er(\n    diagram: Diagram, lines: list[tuple[int, str]], header_position: int\n) -> None:\n    \"\"\"Parse erDiagram statements into entities, fields, and relationships.\"\"\"\n    current: Node | None = None\n    relationship = re.compile(\n        r\"^([A-Za-z_][\\w.-]*)\\s+(\\S*(?:--|\\.\\.)\\S*)\\s+\"\n        r\"([A-Za-z_][\\w.-]*)\\s*(?::\\s*(.*))?$\"\n    )\n    for line_number, raw in lines[header_position + 1 :]:\n        text = raw.strip()\n        if not text:\n            continue\n        if _discard_nonsemantic(diagram, text):\n            continue\n        if text == \"}\":\n            current = None\n            continue\n        direction_match = re.match(r\"^direction\\s+(TD|TB|LR|RL|BT)$\", text, re.I)\n        if direction_match and current is None:\n            diagram.direction = direction_match.group(1).upper()\n            continue\n        entity = re.match(r\"^([A-Za-z_][\\w.-]*)\\s*\\{$\", text)\n        if entity:\n            current = diagram.add_node(entity.group(1), entity.group(1), \"table\")\n            continue\n        if current is not None:\n            current.fields.append(clean_label(text))\n            continue\n        edge = relationship.match(text)\n        if edge:\n            source, cardinality, target, relationship_label = edge.groups()\n            diagram.add_node(source, source, \"table\")\n            diagram.add_node(target, target, \"table\")\n            left, separator, right = cardinality.partition(\"--\")\n            if not separator:\n                left, separator, right = cardinality.partition(\"..\")\n            label_parts = [f\"{left} {separator} {right}\".strip()]\n            if relationship_label:\n                label_parts.append(clean_label(relationship_label))\n            diagram.add_edge(\n                source,\n                target,\n                \" · \".join(label_parts),\n                \"dashed\" if separator == \"..\" else \"solid\",\n                \"cardinality\",\n                undirected=True,\n            )\n            continue\n        if \"--\" in text or \"..\" in text:\n            _fail(f\"malformed edge at line {line_number}\")\n\n\ndef parse_block(block: SourceBlock) -> Diagram:\n    \"\"\"Parse one source block into a Diagram by its detected grammar.\n\n    Args:\n        block: The source block to parse.\n\n    Returns:\n        A Diagram with nodes, edges, fragments, and analysis-ready degrees.\n    \"\"\"\n    lines = _prepared_lines(block)\n    kind, direction, header_position = _kind_and_direction(lines)\n    diagram = Diagram(block.index, kind, block.source_line, direction=direction)\n    if kind == \"flowchart\":\n        _parse_flowchart(diagram, lines, header_position)\n    elif kind == \"sequenceDiagram\":\n        _parse_sequence(diagram, lines, header_position)\n    elif kind == \"stateDiagram-v2\":\n        _parse_state(diagram, lines, header_position)\n    else:\n        _parse_er(diagram, lines, header_position)\n    _finalize_degrees(diagram)\n    return diagram\n\n\ndef _finalize_degrees(diagram: Diagram) -> None:\n    \"\"\"Accumulate in/out degrees over all edges after parsing.\"\"\"\n    nodes = diagram.node_map\n    for edge in diagram.edges:\n        if edge.source in nodes:\n            nodes[edge.source].out_degree += 1\n        if edge.target in nodes:\n            nodes[edge.target].in_degree += 1\n\n\ndef _has_cycle(nodes: list[Node], edges: list[Edge]) -> bool:\n    \"\"\"Detect a cycle in the edge graph via iterative DFS coloring.\"\"\"\n    adjacency: dict[str, list[str]] = {node.id: [] for node in nodes}\n    for edge in edges:\n        if edge.source in adjacency and edge.target in adjacency:\n            adjacency[edge.source].append(edge.target)\n    WHITE, GREY, BLACK = 0, 1, 2\n    colors = {node.id: WHITE for node in nodes}\n\n    def visit(start: str) -> bool:\n        \"\"\"Iterative DFS from `start`; return True if a back-edge (cycle) is found.\"\"\"\n        stack: list[tuple[str, Any]] = [(start, iter(adjacency[start]))]\n        colors[start] = GREY\n        while stack:\n            node_id, targets = stack[-1]\n            for target in targets:\n                if colors.get(target, BLACK) == GREY:\n                    return True\n                if colors.get(target, BLACK) == WHITE:\n                    colors[target] = GREY\n                    stack.append((target, iter(adjacency.get(target, []))))\n                    break\n            else:\n                colors[node_id] = BLACK\n                stack.pop()\n        return False\n\n    return any(colors[node.id] == WHITE and visit(node.id) for node in nodes)\n\n\ndef shape_family(shape: str) -> str:\n    \"\"\"Return the family name for a normalized shape (\"container\" stays as-is).\"\"\"\n    return \"container\" if shape == \"container\" else shape\n\n\ndef analyze(diagram: Diagram) -> dict[str, Any]:\n    \"\"\"Compute the structural signals the skill uses to pick a type and detail.\n\n    Args:\n        diagram: The parsed diagram to analyze.\n\n    Returns:\n        A dict with counts, hubs, type candidates, budget flags, and collapsible groups.\n    \"\"\"\n    containers = [node for node in diagram.nodes if node.container or node.children]\n    leaves = [node for node in diagram.nodes if not (node.container or node.children)]\n    shapes: dict[str, int] = {}\n    for node in diagram.nodes:\n        family = shape_family(node.shape)\n        shapes[family] = shapes.get(family, 0) + 1\n\n    def name(node: Node) -> str:\n        \"\"\"Return a single-line display name for a node (label, or its id).\"\"\"\n        return node.label.replace(\"\\n\", \" · \") or node.id\n\n    hubs = [\n        {\"id\": node.id, \"label\": name(node), \"degree\": node.in_degree + node.out_degree}\n        for node in sorted(\n            leaves,\n            key=lambda item: (item.in_degree + item.out_degree, item.id),\n            reverse=True,\n        )[:5]\n        if node.in_degree + node.out_degree > 0\n    ]\n    entry_points = [name(node) for node in leaves if node.out_degree and not node.in_degree]\n    terminals = [name(node) for node in leaves if node.in_degree and not node.out_degree]\n    orphans = [name(node) for node in leaves if not node.in_degree and not node.out_degree]\n    candidates = {\n        \"flowchart\": [\"flowchart\" if shapes.get(\"rhombus\") else \"architecture\", \"architecture\"],\n        \"sequenceDiagram\": [\"sequence\"],\n        \"stateDiagram-v2\": [\"state machine\"],\n        \"erDiagram\": [\"ER / data model\"],\n    }[diagram.kind]\n    candidates = list(dict.fromkeys(candidates))\n    collapsible = [\n        {\n            \"id\": node.id,\n            \"label\": name(node),\n            \"children\": len(node.children),\n            \"child_labels\": [\n                name(diagram.node_map[child])\n                for child in node.children\n                if child in diagram.node_map\n            ][:8],\n        }\n        for node in containers\n        if node.children\n    ]\n    collapsible.sort(key=lambda item: item[\"children\"], reverse=True)\n    drawable = len(leaves)\n    return {\n        \"nodes_total\": len(diagram.nodes),\n        \"nodes_drawable\": drawable,\n        \"containers\": len(containers),\n        \"leaves\": len(leaves),\n        \"edges_total\": len(diagram.edges),\n        \"edges_labeled\": sum(bool(edge.label) for edge in diagram.edges),\n        \"edges_dangling\": 0,\n        \"max_depth\": max((node.depth for node in diagram.nodes), default=0),\n        \"shapes\": dict(sorted(shapes.items(), key=lambda item: (-item[1], item[0]))),\n        \"has_cycle\": _has_cycle(diagram.nodes, diagram.edges),\n        \"hubs\": hubs,\n        \"entry_points\": entry_points[:6],\n        \"terminals\": terminals[:6],\n        \"orphans\": orphans[:6],\n        \"type_candidates\": candidates,\n        \"collapsible_groups\": collapsible[:8],\n        \"over_node_budget\": drawable > 9,\n        \"over_edge_budget\": len(diagram.edges) > 12,\n    }\n\n\ndef _escape_markdown(text: str) -> str:\n    \"\"\"Escape markdown-sensitive characters in digest output.\"\"\"\n    encoded = html.escape(text, quote=False)\n    return re.sub(r\"([\\\\`*{}\\[\\]()#+\\-.!_|>])\", r\"\\\\\\1\", encoded)\n\n\ndef _escape_table(text: str) -> str:\n    \"\"\"Escape text for a Markdown table cell, flattening newlines.\"\"\"\n    return _escape_markdown(text.replace(\"\\n\", \" ⏎ \"))\n\n\ndef digest(\n    path: Path,\n    diagrams: list[Diagram],\n    selected: list[Diagram],\n    max_rows: int,\n) -> str:\n    \"\"\"Render a compact Markdown digest of the selected diagrams.\n\n    Args:\n        path: The source file path, used for the header line.\n        diagrams: All diagrams in the file, used for the summary line.\n        selected: The diagrams to render in detail.\n        max_rows: Cap on rows per table.\n\n    Returns:\n        The Markdown digest as a string.\n    \"\"\"\n    output = [f\"# Mermaid IR — {path.name}\", \"\"]\n    output.append(\n        f\"{len(diagrams)} diagram(s): \"\n        + \", \".join(\n            f\"[{diagram.index}] {diagram.kind} ({len(diagram.nodes)}n/{len(diagram.edges)}e)\"\n            for diagram in diagrams\n        )\n    )\n    for diagram in selected:\n        info = analyze(diagram)\n        output.extend(\n            [\n                \"\",\n                f\"## Diagram {diagram.index} — {diagram.kind}\",\n                \"\",\n                f\"- source layout: none (Mermaid is layout-free); direction: {diagram.direction}\",\n                f\"- nodes: {info['nodes_total']} total / {info['nodes_drawable']} drawable / \"\n                f\"{info['containers']} containers, depth {info['max_depth']}\",\n                f\"- edges: {info['edges_total']} ({info['edges_labeled']} labeled, \"\n                f\"{info['edges_dangling']} dangling), cycle: {info['has_cycle']}\",\n                f\"- shapes: {info['shapes']}\",\n                f\"- type candidates: {', '.join(info['type_candidates'])}\",\n                f\"- budget: nodes {'OVER' if info['over_node_budget'] else 'ok'} (max 9), \"\n                f\"edges {'OVER' if info['over_edge_budget'] else 'ok'} (max 12)\",\n            ]\n        )\n        if diagram.discarded[\"style_directives\"] or diagram.discarded[\"click_handlers\"]:\n            output.append(\n                f\"- discarded: {diagram.discarded['style_directives']} style directives, \"\n                f\"{diagram.discarded['click_handlers']} click handlers\"\n            )\n        if diagram.fragments:\n            fragments = \", \".join(\n                f\"{item['kind']}({_escape_markdown(item['label'] or 'unlabeled')})\"\n                for item in diagram.fragments\n            )\n            output.append(f\"- fragments: {fragments}\")\n        if diagram.notes:\n            output.append(\n                f\"- notes: {'; '.join(_escape_markdown(note) for note in diagram.notes[:6])}\"\n            )\n        if info[\"hubs\"]:\n            output.append(\n                \"- hubs (focal candidates): \"\n                + \", \".join(\n                    f\"{_escape_markdown(hub['label'])}({hub['degree']})\"\n                    for hub in info[\"hubs\"]\n                )\n            )\n        if info[\"entry_points\"]:\n            output.append(\n                f\"- entry points: {', '.join(_escape_markdown(label) for label in info['entry_points'])}\"\n            )\n        if info[\"terminals\"]:\n            output.append(\n                f\"- terminals: {', '.join(_escape_markdown(label) for label in info['terminals'])}\"\n            )\n        if info[\"orphans\"]:\n            output.append(\n                f\"- unconnected: {', '.join(_escape_markdown(label) for label in info['orphans'])}\"\n            )\n        if info[\"collapsible_groups\"]:\n            output.append(\"- collapsible groups (simplify here first):\")\n            for group in info[\"collapsible_groups\"]:\n                output.append(\n                    f\"  - {_escape_markdown(group['label'])} — {group['children']} children: \"\n                    + \", \".join(_escape_markdown(label) for label in group[\"child_labels\"])\n                )\n\n        output.extend(\n            [\n                \"\",\n                \"### Nodes\",\n                \"\",\n                \"| id | label | shape | depth | parent | deg | fields |\",\n                \"|---|---|---|---|---|---|---|\",\n            ]\n        )\n        for node in diagram.nodes[:max_rows]:\n            output.append(\n                f\"| {_escape_table(node.id)} | {_escape_table(node.label)} | {node.shape} | \"\n                f\"{node.depth} | {node.parent or '-'} | {node.in_degree}/{node.out_degree} | \"\n                f\"{_escape_table('; '.join(node.fields)) or '-'} |\"\n            )\n        if len(diagram.nodes) > max_rows:\n            output.append(\n                f\"| … | +{len(diagram.nodes) - max_rows} more (use --json) | | | | | |\"\n            )\n\n        output.extend(\n            [\n                \"\",\n                \"### Edges\",\n                \"\",\n                \"| source | target | label | style |\",\n                \"|---|---|---|---|\",\n            ]\n        )\n        names = {node.id: node.label.split(\"\\n\")[0] for node in diagram.nodes}\n        for edge in diagram.edges[:max_rows]:\n            marks = [edge.style, edge.arrowhead]\n            if edge.bidirectional:\n                marks.append(\"bidir\")\n            if edge.undirected:\n                marks.append(\"undirected\")\n            output.append(\n                f\"| {_escape_table(names.get(edge.source, edge.source))} | \"\n                f\"{_escape_table(names.get(edge.target, edge.target))} | \"\n                f\"{_escape_table(edge.label) or '-'} | {' '.join(marks)} |\"\n            )\n        if len(diagram.edges) > max_rows:\n            output.append(\n                f\"| … | +{len(diagram.edges) - max_rows} more (use --json) | | |\"\n            )\n    output.append(\"\")\n    return \"\\n\".join(output)\n\n\ndef to_json(path: Path, diagrams: list[Diagram], selected: list[Diagram]) -> str:\n    \"\"\"Serialize the full IR of the selected diagrams as JSON.\n\n    Args:\n        path: The source file path, recorded in the payload.\n        diagrams: All diagrams in the file.\n        selected: The diagrams to serialize.\n\n    Returns:\n        A JSON string with analysis, nodes, edges, and fragments per diagram.\n    \"\"\"\n    return json.dumps(\n        {\n            \"source\": str(path),\n            \"diagrams_total\": len(diagrams),\n            \"diagrams\": [\n                {\n                    \"index\": diagram.index,\n                    \"kind\": diagram.kind,\n                    \"source_line\": diagram.source_line,\n                    \"direction\": diagram.direction,\n                    \"analysis\": analyze(diagram),\n                    \"discarded\": diagram.discarded,\n                    \"fragments\": diagram.fragments,\n                    \"notes\": diagram.notes,\n                    \"nodes\": [asdict(node) for node in diagram.nodes],\n                    \"edges\": [asdict(edge) for edge in diagram.edges],\n                }\n                for diagram in selected\n            ],\n        },\n        indent=2,\n        ensure_ascii=False,\n    )\n\n\ndef select_diagrams(diagrams: list[Diagram], selector: str | None) -> list[Diagram]:\n    \"\"\"Resolve a --diagram selector to a concrete diagram list.\n\n    Args:\n        diagrams: All parsed diagrams.\n        selector: None, \"all\", or a diagram index.\n\n    Returns:\n        The matching diagrams.\n\n    Raises:\n        SystemExit: With status 2 when the selector matches nothing.\n    \"\"\"\n    if selector is None:\n        return diagrams[:1]\n    if selector == \"all\":\n        return diagrams\n    if selector.isdigit():\n        index = int(selector)\n        selected = [diagram for diagram in diagrams if diagram.index == index]\n        if not selected:\n            _fail(f\"no diagram with index {index} (have 0..{len(diagrams) - 1})\")\n        return selected\n    _fail(\"--diagram must be an index or 'all'\")\n\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"Run the Mermaid extractor CLI.\n\n    Args:\n        argv: Command-line arguments; defaults to sys.argv[1:].\n\n    Returns:\n        The process exit code (0 on success, 2 on unreadable input).\n    \"\"\"\n    parser = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n    parser.add_argument(\"file\", help=\".mmd, .mermaid, or Markdown with mermaid fences\")\n    parser.add_argument(\n        \"--diagram\", help=\"diagram index or 'all' (default: first diagram)\"\n    )\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"emit the full IR as JSON\")\n    parser.add_argument(\n        \"--max-rows\",\n        type=int,\n        default=40,\n        help=\"rows per table in the Markdown digest (default 40)\",\n    )\n    parser.add_argument(\"--out\", help=\"write to this path instead of stdout\")\n    args = parser.parse_args(argv)\n    if args.max_rows < 1:\n        _fail(\"--max-rows must be at least 1\")\n\n    path = Path(args.file)\n    if not path.is_file():\n        _fail(f\"{path}: no such file\")\n    blocks = load_blocks(path)\n    diagrams = [parse_block(block) for block in blocks]\n    selected = select_diagrams(diagrams, args.diagram)\n    output = (\n        to_json(path, diagrams, selected)\n        if args.json\n        else digest(path, diagrams, selected, args.max_rows)\n    )\n    if args.out:\n        try:\n            Path(args.out).write_text(output, encoding=\"utf-8\")\n        except OSError as error:\n            _fail(f\"cannot write {args.out}: {error}\")\n        print(f\"wrote {args.out} ({len(output)} bytes)\")\n    else:","lineStart":1,"lineEnd":1417,"totalLines":1418,"truncated":true}},"title":".opencode/skills/sk-doc/sk-create-diagram/scripts/mermaid_extract.py","time":{"start":1786561446046,"end":1786561446058}},"id":"prt_ff75c3cfc001c6nmRuN38eZfjA","sessionID":"ses_008a7474dffeDMoYnQ74TeMyw4","messageID":"msg_ff75c216d001xIUb2OYYr2bTrV"}}
