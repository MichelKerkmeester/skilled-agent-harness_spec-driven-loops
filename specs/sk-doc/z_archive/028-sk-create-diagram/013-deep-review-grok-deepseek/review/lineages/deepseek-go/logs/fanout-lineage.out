ument before after review\", \"before after document diff\", \"document change report\"],\n      \"advisorRouting\": { \"routingClass\": \"metadata\" }\n    },\n    {\n      \"workflowMode\": \"sk-create-diagram\",\n      \"packetKind\": \"workflow\",\n      \"backendKind\": \"template-scaffold\",\n      \"toolSurface\": { \"allowed\": [\"Read\", \"Write\", \"Edit\", \"Bash\", \"Grep\", \"Glob\"], \"forbidden\": [\"Task\"], \"mutatesWorkspace\": true, \"bashAllowlist\": [] },\n      \"packet\": \"sk-create-diagram\",\n      \"packetSkillName\": \"sk-create-diagram\",\n      \"grandfatheredFolderMismatch\": false,\n      \"command\": \"/create:diagram\",\n      \"aliases\": [\"create diagram\", \"diagram\", \"architecture diagram\", \"sequence diagram\", \"ER diagram\", \"state machine diagram\", \"data model diagram\", \"swimlane\", \"venn diagram\", \"org chart\", \"quadrant diagram\", \"gantt chart\", \"draw.io\", \"drawio\", \"mermaid diagram\", \"redraw diagram\", \"export diagram\", \"create flowchart\", \"flowchart\", \"ASCII flowchart\", \"workflow diagram\", \"text diagram\", \"text characters\", \"decision tree\", \"decision branch\", \"parallel execution diagram\", \"approval loop diagram\"],","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0145-sk-doc-sk-create-diagram/.opencode/skills/sk-doc/mode-registry.json","text":"      \"packetKind\": \"workflow\",\n      \"backendKind\": \"template-scaffold\",\n      \"toolSurface\": { \"allowed\": [\"Read\", \"Write\", \"Edit\", \"Bash\", \"Grep\", \"Glob\"], \"forbidden\": [\"Task\"], \"mutatesWorkspace\": true, \"bashAllowlist\": [] },\n      \"packet\": \"sk-create-diff\",\n      \"packetSkillName\": \"sk-create-diff\",\n      \"grandfatheredFolderMismatch\": false,\n      \"command\": \"/create:diff\",\n      \"aliases\": [\"create diff report\", \"document before after review\", \"before after document diff\", \"docum