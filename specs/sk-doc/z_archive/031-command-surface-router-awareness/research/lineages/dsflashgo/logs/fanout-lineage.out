{"type":"tool_use","timestamp":1786890741255,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"type":"tool","tool":"read","callID":"call_00_veywdsoZghm4oUu9P3nW3086","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/doctor/assets/doctor-parent-skill.yaml"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/doctor/assets/doctor-parent-skill.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: PARENT SKILL WORKFLOW (INTERACTIVE READ-ONLY MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator running the parent-skill structural audit in interactive mode\n5: purpose: Read-only audit of the \"parent skill with nested mode packets\" pattern — single hub identity, non-discoverable packets, and a registry-backed routing contract\n6: action: Run parent-skill-check.cjs against the target parent-skill dir -> present per-invariant PASS/FAIL report -> final status\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential_read_only_audit\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: none\n16:   tracking: audit_report_and_exit_code\n17:   validation: audit_script_exit_code\n18:   read_only: true\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # PARENT-SKILL AUDIT INVARIANT\n22: # ─────────────────────────────────────────────────────────────────\n23: parent_skill_doctor_invariant: |\n24:   Parent-skill doctor is strictly read-only. It inspects a parent skill that\n25:   routes to nested mode packets and asserts the structure that keeps the hub a\n26:   single advisor identity. The audit runs the full canon on every parent hub\n27:   (no basename gating):\n28:     1. EXACTLY ONE graph-metadata.json (the hub's), whose skill_id equals the\n29:        directory name and whose family is in the allowed set.\n30:     2. NO graph-metadata.json inside any mode packet or shared/.\n31:     3. mode-registry.json exists; every mode's packet resolves to a sub-dir and\n32:        carries the two-axis discriminator — workflowMode plus packetKind\n33:        (\"workflow\" | \"surface\") plus backendKind — with runtimeLoopType present\n34:        only when the runtime-loop extension is declared. Every mode carries a\n35:        toolSurface and grandfatheredFolderMismatch; workflow modes carry an\n36:        advisorRouting block with a valid routingClass; surface packets are\n37:        read-only evidence-base with a metadata routingClass.\n38:     4. The CI drift-guard test (registry projection == hardcoded advisor maps)\n39:        is wired when any mode routes lexically or via alias-fold; optionally the\n40:        registry's lexical projection is cross-checked against the advisor's live\n41:        DEEP_ROUTING_MODE_BY_KEY.\n42:     5-9. Canon — FAIL by default now that every hub carries the fields\n43:        (PARENT_HUB_CHECK_STRICT=0 downgrades these to advisory WARN for a\n44:        work-in-progress hub): hub-router.json validity (routerSignals ↔ registry\n45:        workflowModes, typed classes and resource paths resolve, tieBreak covers\n46:        every mode); registry ↔ directory reverse consistency; changelog shape\n47:        (real files, no symlinks) at both hub and packet level; description.json\n48:        presence; and a hub playbook plus a benchmark baseline.\n49:   It NEVER writes files, mutates graph metadata, re-indexes the advisor, or\n50:   edits the audited skill. Exit code is non-zero when any invariant fails,\n51:   including checks 5-9 (canon by default; PARENT_HUB_CHECK_STRICT=0 downgrades\n52:   5-9 to advisory WARN for a work-in-progress hub still being scaffolded).\n53: \n54: # ─────────────────────────────────────────────────────────────────\n55: # UPSTREAM ASSETS\n56: # ─────────────────────────────────────────────────────────────────\n57: upstream_assets:\n58:   contract: \"local command design contract\"\n59:   audit_script: \".opencode/commands/doctor/scripts/parent-skill-check.cjs\"\n60:   reference_implementation: \".opencode/skills/system-deep-loop\"\n61:   reference_doc: \".opencode/skills/sk-doc/sk-create-skill/references/README.md\"\n62: \n63: # ─────────────────────────────────────────────────────────────────\n64: # USER INPUTS\n65: # ─────────────────────────────────────────────────────────────────\n66: user_inputs:\n67:   execution_mode: \"INTERACTIVE\"\n68:   parent_skill_dir: \"[PARENT_SKILL_DIR] path\"\n69: \n70: # ─────────────────────────────────────────────────────────────────\n71: # FIELD HANDLING\n72: # ─────────────────────────────────────────────────────────────────\n73: field_handling:\n74:   defaults:\n75:     parent_skill_dir_empty: \".opencode/skills/system-deep-loop\"\n76:   validation:\n77:     execution_mode_must_be: INTERACTIVE\n78:     parent_skill_dir_must_be_existing_directory: true\n79:   command_mapping:\n80:     parent_skill_dir: \"pass as the first positional argument to the audit script\"\n81: \n82: # ─────────────────────────────────────────────────────────────────\n83: # MUTATION BOUNDARIES\n84: # ─────────────────────────────────────────────────────────────────\n85: mutation_boundaries:\n86:   read_only: true\n87:   allowed_targets: []\n88:   forbidden_targets:\n89:     - \"**/*\"\n90:   invariant: \"This workflow is read-only. It may execute the audit script and print output, but it must not write files, reindex databases, mutate graph metadata, or edit the audited skill.\"\n91: \n92: # ─────────────────────────────────────────────────────────────────\n93: # WORKFLOW\n94: # ─────────────────────────────────────────────────────────────────\n95: workflow:\n96:   phase_0_audit:\n97:     purpose: \"Run the parent-skill structural audit (read-only).\"\n98:     activities:\n99:       - \"Resolve parent_skill_dir (default to upstream_assets.reference_implementation when empty).\"\n100:       - \"Execute upstream_assets.audit_script via Bash with parent_skill_dir as the first positional argument.\"\n101:       - \"Capture stdout and exit code.\"\n102:     outputs:\n103:       - per_invariant_report\n104:       - exit_code\n105: \n106:   phase_1_report:\n107:     purpose: \"Present the per-invariant PASS/FAIL report and the final status.\"\n108:     activities:\n109:       - \"Print the audit report.\"\n110:       - \"Map exit code 0 to STATUS=OK, exit code 1 to STATUS=FAIL, exit code 2 to STATUS=ERROR (target missing).\"\n111: \n112: # ─────────────────────────────────────────────────────────────────\n113: # OUTPUT FORMAT\n114: # ─────────────────────────────────────────────────────────────────\n115: output_format: |\n116:   STATUS=OK when every invariant passes (audit script exits 0).\n117:   STATUS=FAIL ERROR=\"parent-skill invariant failed\" when the audit script exits 1.\n118:   STATUS=ERROR ERROR=\"parent skill directory not found\" when the audit script exits 2.\n\n(End of file - total 118 lines)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR: PARENT SKILL WORKFLOW (INTERACTIVE READ-ONLY MODE)\n# ─────────────────────────────────────────────────────────────────\nrole: Expert Operator running the parent-skill structural audit in interactive mode\npurpose: Read-only audit of the \"parent skill with nested mode packets\" pattern — single hub identity, non-discoverable packets, and a registry-backed routing contract\naction: Run parent-skill-check.cjs against the target parent-skill dir -> present per-invariant PASS/FAIL report -> final status\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING MODE\n# ─────────────────────────────────────────────────────────────────\noperating_mode:\n  workflow: sequential_read_only_audit\n  compliance: MANDATORY\n  execution: interactive\n  approvals: none\n  tracking: audit_report_and_exit_code\n  validation: audit_script_exit_code\n  read_only: true\n\n# ─────────────────────────────────────────────────────────────────","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/doctor/assets/doctor-parent-skill.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR: PARENT SKILL WORKFLOW (INTERACTIVE READ-ONLY MODE)\n# ─────────────────────────────────────────────────────────────────\nrole: Expert Operator running the parent-skill structural audit in interactive mode\npurpose: Read-only audit of the \"parent skill with nested mode packets\" pattern — single hub identity, non-discoverable packets, and a registry-backed routing contract\naction: Run parent-skill-check.cjs against the target parent-skill dir -> present per-invariant PASS/FAIL report -> final status\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING MODE\n# ─────────────────────────────────────────────────────────────────\noperating_mode:\n  workflow: sequential_read_only_audit\n  compliance: MANDATORY\n  execution: interactive\n  approvals: none\n  tracking: audit_report_and_exit_code\n  validation: audit_script_exit_code\n  read_only: true\n\n# ─────────────────────────────────────────────────────────────────\n# PARENT-SKILL AUDIT INVARIANT\n# ─────────────────────────────────────────────────────────────────\nparent_skill_doctor_invariant: |\n  Parent-skill doctor is strictly read-only. It inspects a parent skill that\n  routes to nested mode packets and asserts the structure that keeps the hub a\n  single advisor identity. The audit runs the full canon on every parent hub\n  (no basename gating):\n    1. EXACTLY ONE graph-metadata.json (the hub's), whose skill_id equals the\n       directory name and whose family is in the allowed set.\n    2. NO graph-metadata.json inside any mode packet or shared/.\n    3. mode-registry.json exists; every mode's packet resolves to a sub-dir and\n       carries the two-axis discriminator — workflowMode plus packetKind\n       (\"workflow\" | \"surface\") plus backendKind — with runtimeLoopType present\n       only when the runtime-loop extension is declared. Every mode carries a\n       toolSurface and grandfatheredFolderMismatch; workflow modes carry an\n       advisorRouting block with a valid routingClass; surface packets are\n       read-only evidence-base with a metadata routingClass.\n    4. The CI drift-guard test (registry projection == hardcoded advisor maps)\n       is wired when any mode routes lexically or via alias-fold; optionally the\n       registry's lexical projection is cross-checked against the advisor's live\n       DEEP_ROUTING_MODE_BY_KEY.\n    5-9. Canon — FAIL by default now that every hub carries the fields\n       (PARENT_HUB_CHECK_STRICT=0 downgrades these to advisory WARN for a\n       work-in-progress hub): hub-router.json validity (routerSignals ↔ registry\n       workflowModes, typed classes and resource paths resolve, tieBreak covers\n       every mode); registry ↔ directory reverse consistency; changelog shape\n       (real files, no symlinks) at both hub and packet level; description.json\n       presence; and a hub playbook plus a benchmark baseline.\n  It NEVER writes files, mutates graph metadata, re-indexes the advisor, or\n  edits the audited skill. Exit code is non-zero when any invariant fails,\n  including checks 5-9 (canon by default; PARENT_HUB_CHECK_STRICT=0 downgrades\n  5-9 to advisory WARN for a work-in-progress hub still being scaffolded).\n\n# ─────────────────────────────────────────────────────────────────\n# UPSTREAM ASSETS\n# ─────────────────────────────────────────────────────────────────\nupstream_assets:\n  contract: \"local command design contract\"\n  audit_script: \".opencode/commands/doctor/scripts/parent-skill-check.cjs\"\n  reference_implementation: \".opencode/skills/system-deep-loop\"\n  reference_doc: \".opencode/skills/sk-doc/sk-create-skill/references/README.md\"\n\n# ─────────────────────────────────────────────────────────────────\n# USER INPUTS\n# ─────────────────────────────────────────────────────────────────\nuser_inputs:\n  execution_mode: \"INTERACTIVE\"\n  parent_skill_dir: \"[PARENT_SKILL_DIR] path\"\n\n# ─────────────────────────────────────────────────────────────────\n# FIELD HANDLING\n# ─────────────────────────────────────────────────────────────────\nfield_handling:\n  defaults:\n    parent_skill_dir_empty: \".opencode/skills/system-deep-loop\"\n  validation:\n    execution_mode_must_be: INTERACTIVE\n    parent_skill_dir_must_be_existing_directory: true\n  command_mapping:\n    parent_skill_dir: \"pass as the first positional argument to the audit script\"\n\n# ─────────────────────────────────────────────────────────────────\n# MUTATION BOUNDARIES\n# ─────────────────────────────────────────────────────────────────\nmutation_boundaries:\n  read_only: true\n  allowed_targets: []\n  forbidden_targets:\n    - \"**/*\"\n  invariant: \"This workflow is read-only. It may execute the audit script and print output, but it must not write files, reindex databases, mutate graph metadata, or edit the audited skill.\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n  phase_0_audit:\n    purpose: \"Run the parent-skill structural audit (read-only).\"\n    activities:\n      - \"Resolve parent_skill_dir (default to upstream_assets.reference_implementation when empty).\"\n      - \"Execute upstream_assets.audit_script via Bash with parent_skill_dir as the first positional argument.\"\n      - \"Capture stdout and exit code.\"\n    outputs:\n      - per_invariant_report\n      - exit_code\n\n  phase_1_report:\n    purpose: \"Present the per-invariant PASS/FAIL report and the final status.\"\n    activities:\n      - \"Print the audit report.\"\n      - \"Map exit code 0 to STATUS=OK, exit code 1 to STATUS=FAIL, exit code 2 to STATUS=ERROR (target missing).\"\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT FORMAT\n# ─────────────────────────────────────────────────────────────────\noutput_format: |\n  STATUS=OK when every invariant passes (audit script exits 0).\n  STATUS=FAIL ERROR=\"parent-skill invariant failed\" when the audit script exits 1.\n  STATUS=ERROR ERROR=\"parent skill directory not found\" when the audit script exits 2.","lineStart":1,"lineEnd":118,"totalLines":118,"truncated":false}},"title":".opencode/commands/doctor/assets/doctor-parent-skill.yaml","time":{"start":1786890741250,"end":1786890741254}},"id":"prt_00afce5070012nANPq6EIIdqk2","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","messageID":"msg_00afcd213001aCDyvA0AukGjQN"}}
