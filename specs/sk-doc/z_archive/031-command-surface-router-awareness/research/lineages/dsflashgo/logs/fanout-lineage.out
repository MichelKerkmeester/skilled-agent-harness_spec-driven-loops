{"type":"tool_use","timestamp":1786890915828,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"type":"tool","tool":"read","callID":"call_00_1jI9jsjjmPXRl97KRUyG4683","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.github/workflows/routing-registry-drift.yml"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.github/workflows/routing-registry-drift.yml</path>\n<type>file</type>\n<content>\n1: name: Routing Registry Drift Guard\n2: \n3: # Makes the C-plus guarantee real: a change to the advisor's hardcoded routing\n4: # maps without a matching mode-registry.json change (or vice-versa) fails CI here.\n5: # Pairs with the local drift-guard test; this is the authoritative gate.\n6: #\n7: # It also blocks compiled-routing freshness drift: editing a hub's routing inputs\n8: # without re-minting drops that hub to legacy routing silently, so the trigger paths\n9: # below cover every input that can invalidate a serving manifest.\n10: on:\n11:   push:\n12:     # skilled/v* is included because release-line pushes land directly (no PR),\n13:     # and both live skill-metadata regressions to date arrived exactly that way.\n14:     branches: [main, 'skilled/v*']\n15:     paths:\n16:       - '.github/workflows/routing-registry-drift.yml'\n17:       - '.opencode/skills/*/mode-registry.json'\n18:       - '.opencode/skills/*/hub-router.json'\n19:       - '.opencode/skills/system-skill-advisor/mcp-server/**'\n20:       - '.opencode/commands/doctor/scripts/parent-skill-check.cjs'\n21:       - '.opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/**'\n22:       - '.opencode/skills/sk-doc/sk-create-skill/references/parent-skill/**'\n23:       - '.opencode/skills/*/SKILL.md'\n24:       - '.opencode/skills/*/leaf-manifest.json'\n25:       - '.opencode/skills/*/leaf-manifest.config.json'\n26:       - '.opencode/skills/*/command-metadata.json'\n27:       - '.opencode/skills/*/leaf-aliases.json'\n28:       - '.opencode/skills/*/description.json'\n29:       - '.opencode/skills/*/graph-metadata.json'\n30:       - '.opencode/skills/sk-doc/sk-create-skill/scripts/**'\n31:       - '.opencode/bin/compiled-route*'\n32:       - '.opencode/bin/lib/compiled-route*'\n33:       - 'specs/sk-doc/019-skill-routing-refactor/015-router-unification-program/**'\n34:       - 'specs/sk-doc/019-skill-routing-refactor/033-json-optimization-implementation/002-baseline-capture/baseline/**'\n35:   pull_request:\n36:     branches: [main]\n37:     paths:\n38:       - '.github/workflows/routing-registry-drift.yml'\n39:       - '.opencode/skills/*/mode-registry.json'\n40:       - '.opencode/skills/*/hub-router.json'\n41:       - '.opencode/skills/system-skill-advisor/mcp-server/**'\n42:       - '.opencode/commands/doctor/scripts/parent-skill-check.cjs'\n43:       - '.opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/**'\n44:       - '.opencode/skills/sk-doc/sk-create-skill/references/parent-skill/**'\n45:       - '.opencode/skills/*/SKILL.md'\n46:       - '.opencode/skills/*/leaf-manifest.json'\n47:       - '.opencode/skills/*/leaf-manifest.config.json'\n48:       - '.opencode/skills/*/command-metadata.json'\n49:       - '.opencode/skills/*/leaf-aliases.json'\n50:       - '.opencode/skills/*/description.json'\n51:       - '.opencode/skills/*/graph-metadata.json'\n52:       - '.opencode/skills/sk-doc/sk-create-skill/scripts/**'\n53:       - '.opencode/bin/compiled-route*'\n54:       - '.opencode/bin/lib/compiled-route*'\n55:       - 'specs/sk-doc/019-skill-routing-refactor/015-router-unification-program/**'\n56:       - 'specs/sk-doc/019-skill-routing-refactor/033-json-optimization-implementation/002-baseline-capture/baseline/**'\n57: \n58: # Least-privilege default: these jobs only check out and run read-only gates,\n59: # so they never need write access. Declared explicitly rather than inheriting\n60: # the repository default token grant.\n61: permissions:\n62:   contents: read\n63: \n64: jobs:\n65:   routing-drift:\n66:     name: Registry == advisor maps; compiled-routing freshness; parent-skill structure\n67:     runs-on: ubuntu-latest\n68:     steps:\n69:       - uses: actions/checkout@v4\n70:         with:\n71:           fetch-depth: 1\n72:       - uses: actions/setup-node@v4\n73:         with:\n74:           node-version: '20'\n75:       - uses: actions/setup-python@v5\n76:         with:\n77:           python-version: '3.x'\n78:       - name: Routing-registry drift-guard + parity suites\n79:         working-directory: .opencode/skills/system-skill-advisor/mcp-server\n80:         # The drift-guard asserts the hardcoded Python/TS routing maps equal the\n81:         # registry projection; the parity suites assert per-mode routing. The\n82:         # routing surface is dependency-free (aliases.ts has no imports;\n83:         # workspace-root.ts is node-only) and the suites shell to a stdlib-only\n84:         # python3 dump — so the gate installs only vitest on demand rather than the\n85:         # full skill (which carries native + ML deps unrelated to routing).\n86:         run: |\n87:           set -euo pipefail\n88:           npx --yes vitest@4.0.18 run \\\n89:             tests/routing-registry-drift-guard.vitest.ts \\\n90:             tests/routing-parity-deep-skills.vitest.ts \\\n91:             tests/routing-parity-deep-council.vitest.ts\n92:       - name: Compiled-routing freshness — serving matches inputs, runtime matches source\n93:         # Editing a hub's routing inputs without re-minting silently drops that hub to\n94:         # legacy routing: nothing errors and nothing logs, so it is only ever found by\n95:         # accident. This is the authoritative blocker for that drift. A hub that is\n96:         # mid-restructure can be excused through the checked-in exemptions file, which\n97:         # covers only an uncompilable hub and never a stale or drifted one.\n98:         run: |\n99:           set -euo pipefail\n100:           node .opencode/bin/compiled-route-guard.cjs\n101:       - name: Parent-skill structural invariants (one identity, registry coverage) — every hub\n102:         # Glob-enrolled: every skill carrying a mode-registry.json is a parent hub and is\n103:         # checked, so a fifth hub joins the gate automatically with no hand-maintained list.\n104:         run: |\n105:           set -euo pipefail\n106:           for registry in .opencode/skills/*/mode-registry.json; do\n107:             hub=\"$(dirname \"$registry\")\"\n108:             echo \"── parent-skill-check: $hub\"\n109:             node .opencode/commands/doctor/scripts/parent-skill-check.cjs \"$hub\"\n110:           done\n111:       - name: Skill-root metadata class contract — every root, hub or standalone\n112:         # The per-hub loop above enrolls only registry-bearing hubs, which is exactly\n113:         # how standalone roots drifted unnoticed. This gate discovers every root from\n114:         # its SKILL.md, classifies it, enforces the class-required/forbidden file set,\n115:         # and byte-checks generated manifests and derived alias projections — so a\n116:         # missing file is a failure here, not a silence.\n117:         run: |\n118:           set -euo pipefail\n119:           node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs\n120:           node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-leaf-manifest-freshness.cjs\n121:           node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-derived-freshness.cjs\n122:       - name: Skill-graph compiler validation — full derived schema + path existence\n123:         # The gates above check presence and byte-freshness; only the compiler\n124:         # validates the full derived block (topics/entities/causal_summary, edge\n125:         # weight bands, dependency cycles) and that every key_files/source_docs/\n126:         # entities path resolves to a real file. Without it a malformed derived\n127:         # block passes CI green and only fails later at an offline advisor\n128:         # rebuild. Stdlib-only python, so it runs in this lean job as-is; the\n129:         # same command reproduces any failure locally.\n130:         run: |\n131:           set -euo pipefail\n132:           python3 .opencode/skills/system-skill-advisor/mcp-server/scripts/skill_graph_compiler.py --validate-only\n133: \n134:   golden-prompt-gate:\n135:     name: Gate-2 golden prompts — real scorer top-1/top-3 + joined compiled mode\n136:     # Separate from the dependency-light drift/parity job above: this gate runs\n137:     # the REAL TS fusion scorer against labelled prompts and asserts top-1/top-3\n138:     # skill selection plus, for compiled-serving hubs, the concrete workflowMode.\n139:     # It therefore needs a full advisor install (zod + a native sqlite dep) and\n140:     # the @spec-kit/shared dist the scorer imports — which the lean job avoids on\n141:     # purpose. Kept as its own job so the lean gate stays untouched and fast.\n142:     runs-on: ubuntu-latest\n143:     steps:\n144:       - uses: actions/checkout@v4\n145:         with:\n146:           fetch-depth: 1\n147:       - uses: actions/setup-node@v4\n148:         with:\n149:           node-version: '20'\n150:       - name: Install advisor scorer + build the shared projection dependency\n151:         # tsc for the shared build comes from the spec-kit install; the scorer\n152:         # runs in a force-local regime at test time so no skill-graph DB is built.\n153:         run: |\n154:           set -euo pipefail\n155:           npm --prefix .opencode/skills/system-spec-kit ci\n156:           ( cd .opencode/skills/system-spec-kit/shared && ../node_modules/.bin/tsc --build )\n157:           npm --prefix .opencode/skills/system-skill-advisor/mcp-server ci\n158:       - name: Golden-prompt acceptance suite\n159:         working-directory: .opencode/skills/system-skill-advisor/mcp-server\n160:         run: |\n161:           set -euo pipefail\n162:           npx vitest run tests/routing-golden-prompts.vitest.ts\n163:       - name: Scorer-eval baseline ratchet — exact holdout/bucket counts + release floors\n164:         # The golden-prompt suite above checks a weaker property and stays green\n165:         # through a routing regression confined to contested or single-intent\n166:         # prompts. This ratchet is the only gate that pins holdout top-1 to an\n167:         # exact count, holds every named bucket, and enforces the release floors,\n168:         # re-scoring live under the same no-sqlite fallback regime the baseline\n169:         # was captured in. It runs here, in the full-install job, because it\n170:         # imports the real fusion scorer and the built shared dist.\n171:         working-directory: .opencode/skills/system-skill-advisor/mcp-server\n172:         run: |\n173:           set -euo pipefail\n174:           npx vitest run tests/parity/scorer-eval-baseline-ratchet.vitest.ts\n175:       - name: Routing-accuracy corpus gate — pinned corpus, baseline floors\n176:         # An unpinned corpus makes an accuracy floor meaningless: silently adding\n177:         # or relabeling rows moves the number without any routing change. So the\n178:         # corpus files are first verified against the sha256 pins recorded in the\n179:         # checked-in baseline capture, and only then scored. The floors are the\n180:         # scorer's deterministic no-sqlite (fallback-regime) baseline — CI has no\n181:         # skill-graph.sqlite (gitignored, produced only by the live daemon's\n182:         # ingest), so the advisor scores via its local fallback here and the\n183:         # sqlite-regime numbers in the baseline capture do not apply (they read\n184:         # higher: graph boosts). Equality passes; any regression in CI's own\n185:         # regime fails. historical-clean keeps known-good prompts from regressing\n186:         # inside the allowed band. Runs here rather than in the lean job because\n187:         # the gate3 leg imports the built shared dist the install step produces.\n188:         working-directory: .opencode/skills/system-skill-advisor/mcp-server\n189:         run: |\n190:           set -euo pipefail\n191:           python3 - <<'EOF'\n192:           import hashlib, json, pathlib, sys\n193:           baseline = json.load(open(\"../../../specs/sk-doc/019-skill-routing-refactor/033-json-optimization-implementation/002-baseline-capture/baseline/routing-baseline.json\"))\n194:           corpus_dir = pathlib.Path(\"scripts/routing-accuracy\")\n195:           bad = []\n196:           for name, meta in baseline[\"corpus\"].items():\n197:               if not isinstance(meta, dict) or \"sha256\" not in meta:\n198:                   continue\n199:               actual = hashlib.sha256((corpus_dir / name).read_bytes()).hexdigest()\n200:               if actual != meta[\"sha256\"]:\n201:                   bad.append(f\"{name}: pinned {meta['sha256'][:16]}… actual {actual[:16]}…\")\n202:           if bad:\n203:               print(\"CORPUS DRIFTED FROM PIN — recapture the baseline before scoring:\")\n204:               print(\"\\n\".join(f\"  {line}\" for line in bad))\n205:               sys.exit(2)\n206:           print(\"corpus matches the pinned baseline hashes\")\n207:           EOF\n208:           python3 scripts/routing-accuracy/score-routing-corpus.py \\\n209:             --dataset \"$PWD/scripts/routing-accuracy/labeled-prompts.jsonl\" \\\n210:             --min-advisor-accuracy 0.5333 \\\n211:             --min-gate3-f1 0.9843 \\\n212:             --min-joint-tt 101 \\\n213:             --max-joint-ft 3 \\\n214:             --max-joint-ff 1 \\\n215:             --require-historical-clean\n\n(End of file - total 215 lines)\n</content>","metadata":{"preview":"name: Routing Registry Drift Guard\n\n# Makes the C-plus guarantee real: a change to the advisor's hardcoded routing\n# maps without a matching mode-registry.json change (or vice-versa) fails CI here.\n# Pairs with the local drift-guard test; this is the authoritative gate.\n#\n# It also blocks compiled-routing freshness drift: editing a hub's routing inputs\n# without re-minting drops that hub to legacy routing silently, so the trigger paths\n# below cover every input that can invalidate a serving manifest.\non:\n  push:\n    # skilled/v* is included because release-line pushes land directly (no PR),\n    # and both live skill-metadata regressions to date arrived exactly that way.\n    branches: [main, 'skilled/v*']\n    paths:\n      - '.github/workflows/routing-registry-drift.yml'\n      - '.opencode/skills/*/mode-registry.json'\n      - '.opencode/skills/*/hub-router.json'\n      - '.opencode/skills/system-skill-advisor/mcp-server/**'\n      - '.opencode/commands/doctor/scripts/parent-skill-check.cjs'","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.github/workflows/routing-registry-drift.yml","text":"name: Routing Registry Drift Guard\n\n# Makes the C-plus guarantee real: a change to the advisor's hardcoded routing\n# maps without a matching mode-registry.json change (or vice-versa) fails CI here.\n# Pairs with the local drift-guard test; this is the authoritative gate.\n#\n# It also blocks compiled-routing freshness drift: editing a hub's routing inputs\n# without re-minting drops that hub to legacy routing silently, so the trigger paths\n# below cover every input that can invalidate a serving manifest.\non:\n  push:\n    # skilled/v* is included because release-line pushes land directly (no PR),\n    # and both live skill-metadata regressions to date arrived exactly that way.\n    branches: [main, 'skilled/v*']\n    paths:\n      - '.github/workflows/routing-registry-drift.yml'\n      - '.opencode/skills/*/mode-registry.json'\n      - '.opencode/skills/*/hub-router.json'\n      - '.opencode/skills/system-skill-advisor/mcp-server/**'\n      - '.opencode/commands/doctor/scripts/parent-skill-check.cjs'\n      - '.opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/**'\n      - '.opencode/skills/sk-doc/sk-create-skill/references/parent-skill/**'\n      - '.opencode/skills/*/SKILL.md'\n      - '.opencode/skills/*/leaf-manifest.json'\n      - '.opencode/skills/*/leaf-manifest.config.json'\n      - '.opencode/skills/*/command-metadata.json'\n      - '.opencode/skills/*/leaf-aliases.json'\n      - '.opencode/skills/*/description.json'\n      - '.opencode/skills/*/graph-metadata.json'\n      - '.opencode/skills/sk-doc/sk-create-skill/scripts/**'\n      - '.opencode/bin/compiled-route*'\n      - '.opencode/bin/lib/compiled-route*'\n      - 'specs/sk-doc/019-skill-routing-refactor/015-router-unification-program/**'\n      - 'specs/sk-doc/019-skill-routing-refactor/033-json-optimization-implementation/002-baseline-capture/baseline/**'\n  pull_request:\n    branches: [main]\n    paths:\n      - '.github/workflows/routing-registry-drift.yml'\n      - '.opencode/skills/*/mode-registry.json'\n      - '.opencode/skills/*/hub-router.json'\n      - '.opencode/skills/system-skill-advisor/mcp-server/**'\n      - '.opencode/commands/doctor/scripts/parent-skill-check.cjs'\n      - '.opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/**'\n      - '.opencode/skills/sk-doc/sk-create-skill/references/parent-skill/**'\n      - '.opencode/skills/*/SKILL.md'\n      - '.opencode/skills/*/leaf-manifest.json'\n      - '.opencode/skills/*/leaf-manifest.config.json'\n      - '.opencode/skills/*/command-metadata.json'\n      - '.opencode/skills/*/leaf-aliases.json'\n      - '.opencode/skills/*/description.json'\n      - '.opencode/skills/*/graph-metadata.json'\n      - '.opencode/skills/sk-doc/sk-create-skill/scripts/**'\n      - '.opencode/bin/compiled-route*'\n      - '.opencode/bin/lib/compiled-route*'\n      - 'specs/sk-doc/019-skill-routing-refactor/015-router-unification-program/**'\n      - 'specs/sk-doc/019-skill-routing-refactor/033-json-optimization-implementation/002-baseline-capture/baseline/**'\n\n# Least-privilege default: these jobs only check out and run read-only gates,\n# so they never need write access. Declared explicitly rather than inheriting\n# the repository default token grant.\npermissions:\n  contents: read\n\njobs:\n  routing-drift:\n    name: Registry == advisor maps; compiled-routing freshness; parent-skill structure\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 1\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.x'\n      - name: Routing-registry drift-guard + parity suites\n        working-directory: .opencode/skills/system-skill-advisor/mcp-server\n        # The drift-guard asserts the hardcoded Python/TS routing maps equal the\n        # registry projection; the parity suites assert per-mode routing. The\n        # routing surface is dependency-free (aliases.ts has no imports;\n        # workspace-root.ts is node-only) and the suites shell to a stdlib-only\n        # python3 dump — so the gate installs only vitest on demand rather than the\n        # full skill (which carries native + ML deps unrelated to routing).\n        run: |\n          set -euo pipefail\n          npx --yes vitest@4.0.18 run \\\n            tests/routing-registry-drift-guard.vitest.ts \\\n            tests/routing-parity-deep-skills.vitest.ts \\\n            tests/routing-parity-deep-council.vitest.ts\n      - name: Compiled-routing freshness — serving matches inputs, runtime matches source\n        # Editing a hub's routing inputs without re-minting silently drops that hub to\n        # legacy routing: nothing errors and nothing logs, so it is only ever found by\n        # accident. This is the authoritative blocker for that drift. A hub that is\n        # mid-restructure can be excused through the checked-in exemptions file, which\n        # covers only an uncompilable hub and never a stale or drifted one.\n        run: |\n          set -euo pipefail\n          node .opencode/bin/compiled-route-guard.cjs\n      - name: Parent-skill structural invariants (one identity, registry coverage) — every hub\n        # Glob-enrolled: every skill carrying a mode-registry.json is a parent hub and is\n        # checked, so a fifth hub joins the gate automatically with no hand-maintained list.\n        run: |\n          set -euo pipefail\n          for registry in .opencode/skills/*/mode-registry.json; do\n            hub=\"$(dirname \"$registry\")\"\n            echo \"── parent-skill-check: $hub\"\n            node .opencode/commands/doctor/scripts/parent-skill-check.cjs \"$hub\"\n          done\n      - name: Skill-root metadata class contract — every root, hub or standalone\n        # The per-hub loop above enrolls only registry-bearing hubs, which is exactly\n        # how standalone roots drifted unnoticed. This gate discovers every root from\n        # its SKILL.md, classifies it, enforces the class-required/forbidden file set,\n        # and byte-checks generated manifests and derived alias projections — so a\n        # missing file is a failure here, not a silence.\n        run: |\n          set -euo pipefail\n          node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs\n          node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-leaf-manifest-freshness.cjs\n          node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-derived-freshness.cjs\n      - name: Skill-graph compiler validation — full derived schema + path existence\n        # The gates above check presence and byte-freshness; only the compiler\n        # validates the full derived block (topics/entities/causal_summary, edge\n        # weight bands, dependency cycles) and that every key_files/source_docs/\n        # entities path resolves to a real file. Without it a malformed derived\n        # block passes CI green and only fails later at an offline advisor\n        # rebuild. Stdlib-only python, so it runs in this lean job as-is; the\n        # same command reproduces any failure locally.\n        run: |\n          set -euo pipefail\n          python3 .opencode/skills/system-skill-advisor/mcp-server/scripts/skill_graph_compiler.py --validate-only\n\n  golden-prompt-gate:\n    name: Gate-2 golden prompts — real scorer top-1/top-3 + joined compiled mode\n    # Separate from the dependency-light drift/parity job above: this gate runs\n    # the REAL TS fusion scorer against labelled prompts and asserts top-1/top-3\n    # skill selection plus, for compiled-serving hubs, the concrete workflowMode.\n    # It therefore needs a full advisor install (zod + a native sqlite dep) and\n    # the @spec-kit/shared dist the scorer imports — which the lean job avoids on\n    # purpose. Kept as its own job so the lean gate stays untouched and fast.\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 1\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n      - name: Install advisor scorer + build the shared projection dependency\n        # tsc for the shared build comes from the spec-kit install; the scorer\n        # runs in a force-local regime at test time so no skill-graph DB is built.\n        run: |\n          set -euo pipefail\n          npm --prefix .opencode/skills/system-spec-kit ci\n          ( cd .opencode/skills/system-spec-kit/shared && ../node_modules/.bin/tsc --build )\n          npm --prefix .opencode/skills/system-skill-advisor/mcp-server ci\n      - name: Golden-prompt acceptance suite\n        working-directory: .opencode/skills/system-skill-advisor/mcp-server\n        run: |\n          set -euo pipefail\n          npx vitest run tests/routing-golden-prompts.vitest.ts\n      - name: Scorer-eval baseline ratchet — exact holdout/bucket counts + release floors\n        # The golden-prompt suite above checks a weaker property and stays green\n        # through a routing regression confined to contested or single-intent\n        # prompts. This ratchet is the only gate that pins holdout top-1 to an\n        # exact count, holds every named bucket, and enforces the release floors,\n        # re-scoring live under the same no-sqlite fallback regime the baseline\n        # was captured in. It runs here, in the full-install job, because it\n        # imports the real fusion scorer and the built shared dist.\n        working-directory: .opencode/skills/system-skill-advisor/mcp-server\n        run: |\n          set -euo pipefail\n          npx vitest run tests/parity/scorer-eval-baseline-ratchet.vitest.ts\n      - name: Routing-accuracy corpus gate — pinned corpus, baseline floors\n        # An unpinned corpus makes an accuracy floor meaningless: silently adding\n        # or relabeling rows moves the number without any routing change. So the\n        # corpus files are first verified against the sha256 pins recorded in the\n        # checked-in baseline capture, and only then scored. The floors are the\n        # scorer's deterministic no-sqlite (fallback-regime) baseline — CI has no\n        # skill-graph.sqlite (gitignored, produced only by the live daemon's\n        # ingest), so the advisor scores via its local fallback here and the\n        # sqlite-regime numbers in the baseline capture do not apply (they read\n        # higher: graph boosts). Equality passes; any regression in CI's own\n        # regime fails. historical-clean keeps known-good prompts from regressing\n        # inside the allowed band. Runs here rather than in the lean job because\n        # the gate3 leg imports the built shared dist the install step produces.\n        working-directory: .opencode/skills/system-skill-advisor/mcp-server\n        run: |\n          set -euo pipefail\n          python3 - <<'EOF'\n          import hashlib, json, pathlib, sys\n          baseline = json.load(open(\"../../../specs/sk-doc/019-skill-routing-refactor/033-json-optimization-implementation/002-baseline-capture/baseline/routing-baseline.json\"))\n          corpus_dir = pathlib.Path(\"scripts/routing-accuracy\")\n          bad = []\n          for name, meta in baseline[\"corpus\"].items():\n              if not isinstance(meta, dict) or \"sha256\" not in meta:\n                  continue\n              actual = hashlib.sha256((corpus_dir / name).read_bytes()).hexdigest()\n              if actual != meta[\"sha256\"]:\n                  bad.append(f\"{name}: pinned {meta['sha256'][:16]}… actual {actual[:16]}…\")\n          if bad:\n              print(\"CORPUS DRIFTED FROM PIN — recapture the baseline before scoring:\")\n              print(\"\\n\".join(f\"  {line}\" for line in bad))\n              sys.exit(2)\n          print(\"corpus matches the pinned baseline hashes\")\n          EOF\n          python3 scripts/routing-accuracy/score-routing-corpus.py \\\n            --dataset \"$PWD/scripts/routing-accuracy/labeled-prompts.jsonl\" \\\n            --min-advisor-accuracy 0.5333 \\\n            --min-gate3-f1 0.9843 \\\n            --min-joint-tt 101 \\\n            --max-joint-ft 3 \\\n            --max-joint-ff 1 \\\n            --require-historical-clean","lineStart":1,"lineEnd":215,"totalLines":215,"truncated":false}},"title":".github/workflows/routing-registry-drift.yml","time":{"start":1786890915819,"end":1786890915827}},"id":"prt_00aff8ed0001RFn3H44aYi5O2X","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","messageID":"msg_00aff804a001wwfq6hsUfGacKy"}}
