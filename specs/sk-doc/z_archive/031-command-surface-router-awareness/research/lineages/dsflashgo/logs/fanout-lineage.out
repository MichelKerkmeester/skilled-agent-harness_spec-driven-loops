{"type":"step_start","timestamp":1786890595437,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"id":"prt_00afaac6c001xd7GAQUrgg3DYn","messageID":"msg_00afaa4f600180IGxaEBe43XIt","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","snapshot":"f24f178276832443854b0ffdbcedc8c5bc38f309","type":"step-start"}}
{"type":"tool_use","timestamp":1786890597932,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"type":"tool","tool":"read","callID":"call_00_BqX5t2enR1iHU4NQe85j8721","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/create/assets/create-skill-parent-auto.yaml"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/create/assets/create-skill-parent-auto.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # OPENCODE CREATE: PARENT SKILL WORKFLOW (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # Mode: autonomous execution (no approval checkpoints)\n5: # Entrypoint: /create:skill-parent\n6: # Operations: create | update\n7: # ─────────────────────────────────────────────────────────────────\n8: role: Parent Skill Creator using sk-doc\n9: purpose: Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth)\n10: action: Normalize inputs, load standards, generate the hub + registry + packets + shared, validate identity, and report completion\n11: \n12: # ─────────────────────────────────────────────────────────────────\n13: # PREREQUISITE: @markdown AGENT VERIFICATION\n14: # ─────────────────────────────────────────────────────────────────\n15: # This workflow REQUIRES the @markdown agent for:\n16: #   - Template-first generation\n17: #   - sk-doc standards enforcement\n18: #   - Hub document validation\n19: #\n20: # PHASE 0 in the command markdown verifies @markdown agent BEFORE\n21: # this YAML workflow loads. If you are executing this workflow,\n22: # @markdown verification has already passed.\n23: # ─────────────────────────────────────────────────────────────────\n24: \n25: operating_mode:\n26:   workflow: unified_6_step\n27:   workflow_compliance: MANDATORY\n28:   workflow_execution: autonomous\n29:   approvals: none\n30:   tracking: progressive_status_logging\n31:   validation: continuous_self_validation\n32:   supports_operations:\n33:     - create\n34:     - update\n35:   description: |\n36:     Executes the 6-step parent-skill scaffolding workflow without step-by-step approval.\n37:     Pauses only if confidence drops below threshold or existence semantics conflict.\n38: \n39: development_philosophy:\n40:   principle: \"One discoverable hub identity, the registry as the single declarative source of truth\"\n41:   approach: \"Normalize -> Plan modes -> Scaffold -> Validate identity -> Report\"\n42:   mandate: \"Prefer the shipped sk-doc parent-skill pattern over ad-hoc nested-skill layouts\"\n43: \n44: runtime_agent_path_resolution:\n45:   default: .opencode/agents\n46:   claude: .claude/agents\n47: \n48: # ─────────────────────────────────────────────────────────────────\n49: # CONFIDENCE & CLARIFICATION FRAMEWORK\n50: # ─────────────────────────────────────────────────────────────────\n51: confidence_framework:\n52:   thresholds:\n53:     high: { range: \"80-100%\", action: \"Proceed with deterministic defaults\" }\n54:     medium: { range: \"40-79%\", action: \"Proceed with caution and log assumptions\" }\n55:     low: { range: \"0-39%\", action: \"STOP and request clarification\" }\n56:   scoring_weights:\n57:     input_completeness: 0.30\n58:     routing_clarity: 0.20\n59:     contract_alignment: 0.30\n60:     validation_readiness: 0.20\n61:   low_confidence_behavior:\n62:     action: \"Stop before generation and ask one consolidated clarification\"\n63: \n64: # ─────────────────────────────────────────────────────────────────\n65: # REQUEST ANALYSIS FRAMEWORK\n66: # ─────────────────────────────────────────────────────────────────\n67: request_analysis_framework:\n68:   solution_flow:\n69:     - \"Parse command arguments and normalize execution mode\"\n70:     - \"Verify create/update semantics against the real target path\"\n71:     - \"Load the creation reference and both templates before writing\"\n72:     - \"Derive the mode list and per-mode packet plan\"\n73:     - \"Generate the hub, registry, packets, and shared dir with one hub identity\"\n74:     - \"Validate hub structure, per-packet structure, registry coverage, and the one-identity invariant\"\n75:   pre_change_validation:\n76:     items:\n77:       - \"create_agent_verified is true\"\n78:       - \"skill_name is present\"\n79:       - \"operation is create or update\"\n80:       - \"modes is present and non-empty\"\n81:       - \"execution_mode is :auto\"\n82:     stop_conditions:\n83:       - \"Any required input missing\"\n84:       - \"Operation does not match real target existence\"\n85:     stop_action: \"STOP and correct setup before generation\"\n86: \n87: input_contract:\n88:   required:\n89:     - create_agent_verified\n90:     - skill_name\n91:     - operation\n92:     - modes\n93:     - execution_mode\n94:   optional:\n95:     - skill_path\n96:     - surfaces\n97:     - spec_choice\n98:     - spec_path\n99:     - memory_choice\n100: \n101: field_handling:\n102:   skill_name:\n103:     validation: \"hyphen-case folder name; becomes the hub skill identity\"\n104:     required: true\n105:   operation:\n106:     validation: \"must be one of: create, update\"\n107:     required: true\n108:   modes:\n109:     validation: \"comma-separated hyphen-case mode names; one workflow packet per mode\"\n110:     required: true\n111:   surfaces:\n112:     validation: \"optional comma-separated bare-noun names, one read-only evidence-base surface packet each (packetKind: surface)\"\n113:     required: false\n114:   execution_mode:\n115:     validation: \"must be :auto\"\n116:     required: true\n117: \n118: documentation_level:\n119:   default: \"Level 2 (Verification)\"\n120:   required_files:\n121:     - spec.md\n122:     - plan.md\n123:     - tasks.md\n124:     - checklist.md\n125:   note: \"Parent-skill scaffolding spans a hub, a registry, multiple packets, and an identity invariant, so it needs verification\"\n126: \n127: defaults:\n128:   skill_path: .opencode/skills/\n129:   registry_filename: mode-registry.json\n130:   hub_router_filename: hub-router.json\n131:   root_router_filename: ROUTER.md\n132:   description_filename: description.json\n133:   graph_metadata_filename: graph-metadata.json\n134:   shared_dirname: shared\n135:   packet_prefix: \"[hub-prefix]-  # derived from the hub (e.g. code- for sk-code); NEVER hardcode deep-. Exception: system-deep-loop's packets keep the deep- prefix (matching the /deep:* command namespace, not the hub folder name) — the folder-prefix/command-namespace-prefix equivalence has this one documented exception.\"\n136:   surface_packet_naming: \"bare noun, no prefix (e.g. webflow)\"\n137:   execution_mode: :auto\n138:   dqi_hard_minimum: 75\n139: \n140: # ─────────────────────────────────────────────────────────────────\n141: # CANONICAL ROOT ROUTER CLASSIFICATION + ACTION CONTRACT\n142: # ─────────────────────────────────────────────────────────────────\n143: # Both workflows bind this exact block: the classification states, the action\n144: # line, and the invariants are one contract shared by :auto and :confirm. The\n145: # parity test compares this block structurally, so the two workflows can never\n146: # drift apart on when they create, migrate, leave unchanged, or stop. Only\n147: # checkpointing differs between the modes.\n148: # ─────────────────────────────────────────────────────────────────\n149: root_router_contract:\n150:   action_line: \"ROUTER.md: create|migrate|unchanged\"\n151:   classification_states:\n152:     - stage1-only\n153:     - active\n154:     - legacy-migratable\n155:     - already-current\n156:     - conflict\n157:     - malformed\n158:   actions:\n159:     - create\n160:     - migrate\n161:     - unchanged\n162:   state_action_map:\n163:     stage1-only:\n164:       action: unchanged\n165:       note: \"Existing stage1-only router with empty maps stays as-is; an absent root on a new hub routes to create\"\n166:     active:\n167:       action: unchanged\n168:       note: \"Existing active router with non-empty equal-key maps stays as-is\"\n169:     legacy-migratable:\n170:       action: migrate\n171:       note: \"No root router; only a legacy smart-routing.md exists. Create the root ROUTER.md from the legacy content, preserve the machine block byte-for-byte, then delete the legacy file only after the migrated hub validates\"\n172:     already-current:\n173:       action: unchanged\n174:       note: \"Root router already matches the contract\"\n175:     conflict:\n176:       action: null\n177:       stop_before_write: true\n178:       note: \"Root ROUTER.md coexists with a legacy smart-routing.md; STOP before any write and require manual resolution\"\n179:     malformed:\n180:       action: null\n181:       stop_before_write: true\n182:       note: \"Router state or machine maps are unreadable; STOP before any write and require manual repair\"\n183:   invariants:\n184:     create_emits_stage1_only_with_empty_maps: true\n185:     stop_before_write_on_conflict: true\n186:     stop_before_write_on_malformed: true\n187:     delete_legacy_only_after_validation: true\n188:     preserve_machine_block_bytes_on_migrate: true\n189: \n190: operation_router:\n191:   create:\n192:     requires_existing_skill: false\n193:     output_scope:\n194:       - SKILL.md\n195:       - mode-registry.json\n196:       - hub-router.json\n197:       - ROUTER.md                # stage-two control; router_state: stage1-only on a fresh scaffold\n198:       - description.json\n199:       - graph-metadata.json\n200:       - changelog/\n201:       - manual-testing-playbook/\n202:       - \"[hub-prefix]-<mode>/SKILL.md\"\n203:       - \"[hub-prefix]-<mode>/README.md\"\n204:       - \"[hub-prefix]-<mode>/changelog/\"\n205:       - \"<surface>/{SKILL.md,README.md,changelog/}  (when --surfaces)\"\n206:       - shared/\n207:       - shared/README.md\n208:   update:\n209:     requires_existing_skill: true\n210:     output_scope:\n211:       - SKILL.md\n212:       - mode-registry.json\n213:       - hub-router.json\n214:       - ROUTER.md                # stage-two control; classify, then create/migrate/unchanged\n215:       - description.json\n216:       - graph-metadata.json\n217:       - changelog/\n218:       - \"[hub-prefix]-<mode>/SKILL.md\"\n219:       - shared/\n220: \n221: reference_sources:\n222:   specific_creation: .opencode/skills/sk-doc/sk-create-skill/references/README.md\n223:   pattern_section: \"Parent Skills with Nested Mode Packets\"\n224:   hub_router_schema: .opencode/skills/sk-doc/sk-create-skill/references/parent-skill/parent-hub-router-schema.md\n225:   core_standards: .opencode/skills/sk-doc/shared/references/core-standards.md\n226:   validation: .opencode/skills/sk-doc/shared/references/validation.md\n227:   canonical_example: .opencode/skills/sk-code\n228: \n229: template_sources:\n230:   hub_skill: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\n231:   mode_registry: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\n232:   hub_router: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\n233:   root_router: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-smart-routing-template.md\n234:   description: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-description-template.json\n235:   hub_graph_metadata: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\n236: \n237: validation_scripts:\n238:   validate_document: .opencode/skills/sk-doc/scripts/validate_document.py\n239:   extract_structure: .opencode/skills/sk-doc/scripts/extract_structure.py\n240:   advisor_projection_emit: \"python3 .opencode/skills/system-skill-advisor/mcp-server/scripts/skill_advisor.py --emit-routing-projection\"\n241:   advisor_projection_guard: \"PATH=\\\"/opt/homebrew/bin:$PATH\\\" npm test -- routing-registry-drift-guard.vitest.ts\"\n242: \n243: quality_standards:\n244:   template_first: required\n245:   frontmatter_required: true\n246:   hub_requirements:\n247:     - thin routing-only SKILL.md (no per-mode logic)\n248:     - \"exactly one graph-metadata.json at the hub root (from parent_skill_graph_metadata_template.json) with skill_id == hub folder name and family in {cli, mcp, sk-code, deep-loop, sk-util, system}\"\n249:     - mode-registry.json present and valid JSON\n250:     - \"hub-router.json present and valid (routerSignals cover every workflowMode, typed vocabularyClasses, tieBreak covers all modes; any catch-all vocabulary class (hub-identity) is on the default mode only, not specialized modes (see parent_hub_router_schema.md); surface packets get metadata routerSignals plus a surfaceBundle outcome)\"\n251:     - \"root ROUTER.md present with router_state: stage1-only or active, a root skill_pointer, and a four-part version; stage1-only maps stay empty, active maps are non-empty and equal-keyed\"\n252:     - description.json present\n253:     - \"changelog/ with real files (no symlinks) at the hub root and in every packet\"\n254:   registry_requirements:\n255:     - \"each mode carries the two-axis discriminator: workflowMode (string) + packetKind (\\\"workflow\\\" | \\\"surface\\\") + backendKind; runtimeLoopType is present ONLY for workflow modes on a runtime-loop backend (when the runtime-loop extension is declared), otherwise omitted\"\n256:     - \"each mode carries toolSurface (allowed, forbidden, mutatesWorkspace, bashAllowlist) and grandfatheredFolderMismatch (boolean, false unless a legacy folder/name mismatch is intentionally preserved)\"\n257:     - \"surface packets (packetKind: surface) are read-only evidence bases: backendKind evidence-base, toolSurface allowed subset of {Read, Bash, Grep, Glob} with {Write, Edit, Task} forbidden and mutatesWorkspace false, advisorRouting.routingClass metadata (advisor-invisible)\"\n258:     - \"each mode has a top-level packet field naming its packet sub-directory (a direct child of the hub)\"\n259:     - one advisorRouting block per mode\n260:     - \"advisorRouting fields: routingClass (lexical | alias-fold | metadata | command-bridge), legacyAdvisorId (lexical + alias-fold modes only), advisorDefaultMode (optional, alias-fold default), legacyAliases (lexical + alias-fold only), packetSkillName\"\n261:     - \"registry keys (mode.packet) match packet folder names; canonical workflow folder == packetSkillName == [hub-prefix]-<mode>, surface folder == packetSkillName == bare noun; grandfathered mismatches recorded via grandfatheredFolderMismatch + packetSkillName\"\n262:     - \"runtimeLoopType allowed set when present and non-null: research | review | council | context (or the hub's declared runtime-loop types)\"\n263:   advisor_projection_requirements:\n264:     - \"For lexical/alias-fold modes, emit the generated advisor projection from the finalized mode-registry.json into system-skill-advisor's TypeScript and Python projection constants\"\n265:     - \"Projection emission must include a SHA-256 freshness hash and must not add runtime reads of another skill's mode-registry.json\"\n266:     - \"The routing-registry drift guard must pass after projection emission\"\n267:   packet_requirements:\n268:     - \"RECOMMENDED DEFAULT for a net-new single-mode workflow packet: folder == packetSkillName == [hub-prefix]-<mode> (soft guidance, not a hard gate); surface packets use a bare-noun folder\"\n269:     - \"ALLOWED: many modes mapping to one packet folder (canonical: 4 improvement modes -> deep-improvement)\"\n270:     - \"ALLOWED: grandfathered packets where folder != packetSkillName (rare; record the rationale in the packet's decision record)\"\n271:     - each packet has its own SKILL.md\n272:     - \"each mode's packet folder is a direct child of the hub (no absolute or ../ paths)\"\n273:     - NO per-packet graph-metadata.json\n274:   shared_requirements:\n275:     - non-discoverable shared/ for packet-shared workflow-layer helpers (synthesis, not execution primitives)\n276:     - NO graph-metadata.json inside shared/\n277:   one_identity_rule: \"Exactly one graph-metadata.json (the hub's). A nested graph-metadata.json creates a rogue advisor identity.\"\n278:   root_router_rule: \"Root ROUTER.md declares router_state: stage1-only or active. Fresh scaffolds are stage1-only with empty maps; promote to active only after authoring a concrete leaf map. On update, classify the router state and emit exactly one ROUTER.md: create|migrate|unchanged action; stop on conflict or malformed state; preserve the machine block byte-for-byte in ordinary migration.\"\n279:   validation_pipeline:\n280:     - \"python3 .opencode/skills/sk-doc/scripts/validate_document.py [skill_root]/SKILL.md\"\n281:     - \"python3 .opencode/skills/sk-doc/scripts/extract_structure.py [skill_root]/SKILL.md\"\n282: \n283: gate_logic:\n284:   hard:\n285:     H0_write_verified:\n286:       description: \"create_agent_verified must be true\"\n287:       fail_action: \"STOP and return to setup\"\n288:     H1_required_fields:\n289:       description: \"All required setup fields must be present (including a non-empty mode list)\"\n290:       fail_action: \"STOP and collect missing fields\"\n291:     H2_existence_semantics:\n292:       description: \"create/update must match real skill-root existence\"\n293:       fail_action: \"STOP and reroute or correct target\"\n294:     H3_contract_shape:\n295:       description: \"Generated package must match the parent-skill pattern (hub + registry + packets + shared)\"\n296:       fail_action: \"Fix structure before continuing\"\n297:     H4_one_identity:\n298:       description: \"Exactly one graph-metadata.json at the hub; zero inside packets or shared\"\n299:       fail_action: \"Remove rogue identities and re-validate\"\n300:     H5_validation_gate:\n301:       description: \"Hub validation, registry coverage, and per-packet structure checks must pass\"\n302:       fail_action: \"Run fix-and-revalidate loop\"\n303:   soft:\n304:     S1_packet_naming:\n305:       description: \"DEFAULT for a net-new single-mode workflow packet: folder == packetSkillName == [hub-prefix]-<mode> (surfaces use a bare-noun folder). NOT a hard gate. Many-modes-to-one-packet and grandfathered folder!=packetSkillName names are valid (canonical: 4 modes -> deep-improvement).\"\n306:       fail_action: \"Proceed with a logged assumption when grandfathering an existing packet or mapping several modes to one packet\"\n307: \n308: workflow_overview:\n309:   steps:\n310:     - id: step_1_preflight\n311:       purpose: \"Normalize inputs and enforce H0-H2\"\n312:     - id: step_1b_spec_folder_setup\n313:       purpose: \"Resolve spec_choice into spec_path and create/confirm the documentation folder for tracking this work\"\n314:     - id: step_2_mode_planning\n315:       purpose: \"Resolve the mode list and per-packet plan\"\n316:     - id: step_3_template_loading\n317:       purpose: \"Load the reference and both hub/registry templates\"\n318:     - id: step_4_package_generation\n319:       purpose: \"Create or update hub, registry, packets, and shared with one identity\"\n320:     - id: step_5_validation\n321:       purpose: \"Run hub validation, registry coverage, and the one-identity invariant\"\n322:     - id: step_5b_save_context\n323:       purpose: \"Persist spec-folder documentation and index the implementation summary for this parent-skill work\"\n324:     - id: step_6_completion\n325:       purpose: \"Emit deterministic completion report\"\n326: \n327: # ─────────────────────────────────────────────────────────────────\n328: # CONTEXT LOADING\n329: # ─────────────────────────────────────────────────────────────────\n330: context_loading:\n331:   trigger: \"During UNIFIED SETUP PHASE, non-interactive resolution before Step 1\"\n332:   applies_when: \"spec_path resolves to an existing spec folder (Q3 choice A - Existing, C - Update related, or D - Extend phased packet) that contains handover.md or _memory.continuity in implementation-summary.md; not applicable to a freshly created spec folder (Q3 choice B - New) or when spec_choice is E (Skip)\"\n333:   auto_resolution:\n334:     default: \"If prior context exists (handover.md <24h old, or _memory.continuity present in {spec_path}), load it automatically via memory_context (mode: resume); sets memory_loaded: handover+continuity. Otherwise skip; sets memory_loaded: skipped.\"\n335:     override: \"Honor memory_choice if explicitly supplied as a command argument or pre-bound setup answer (A/B/C)\"\n336:   mcp_integration:\n337:     tool: memory_context\n338:     note: \"Call MCP tools directly - NEVER through Code Mode\"\n339:     parameters: { input: \"resume previous work on {spec_path}\", mode: \"resume\", profile: \"resume\", specFolder: \"{spec_path}\", includeContent: true }\n340:     transport_fallback: \"If MCP tools are missing or erroring while the daemon is otherwise warm, use: node .opencode/bin/spec-memory.cjs memory_context --json '{\\\"input\\\":\\\"resume previous work\\\",\\\"mode\\\":\\\"resume\\\"}' --format json --timeout-ms 3000 --warm-only. Exit 75 = retryable backend unavailability.\"\n341:   output: memory_loaded\n342: \n343: workflow:\n344:   step_1_preflight:\n345:     purpose: Normalize and verify required fields\n346:     activities:\n347:       - Normalize skill_path to default when omitted\n348:       - Derive skill_root as \"[skill_path]/[skill_name]\"\n349:       - Validate operation token to supported value\n350:       - Parse modes into a normalized hyphen-case list\n351:       - Validate execution_mode is :auto\n352:       - Check whether skill_root already exists\n353:       - Resolve memory_choice via the context_loading block (Q4 if applicable); record result as memory_loaded\n354:     outputs:\n355:       - normalized_inputs\n356:       - mode_list\n357:       - target_existence_state\n358:       - memory_loaded\n359: \n360:   step_1b_spec_folder_setup:\n361:     purpose: Resolve spec_choice into spec_path and create/confirm the documentation folder for tracking this work\n362:     condition: \"spec_choice != E (Skip)\"\n363:     activities:\n364:     - IF spec_choice == B (Create new):\n365:       - Find next available spec number\n366:       - Command: \"ls -d specs/[0-9]*/ | sed 's/.*\\\\/\\\\([0-9]*\\\\)-.*/\\\\1/' | sort -n | tail -1\"\n367:       - Create folder: specs/[NNN]-[skill_name]-parent/\n368:     - IF spec_choice == A, C, or D (Existing, Update related, or Extend phased packet):\n369:       - Use selected spec_path\n370:     - \"Route spec.md, plan.md, tasks.md, and checklist.md creation through distributed governance (AGENTS.md Rule 5), matching this family's Level 2 documentation_level\"\n371:     templates:\n372:     # Use Level 2 templates as default for parent-skill scaffolding\n373:     - .opencode/skills/system-spec-kit/templates/examples/level-2/spec.md\n374:     - .opencode/skills/system-spec-kit/templates/examples/level-2/plan.md\n375:     - .opencode/skills/system-spec-kit/templates/examples/level-2/tasks.md\n376:     - .opencode/skills/system-spec-kit/templates/examples/level-2/checklist.md\n377:     outputs:\n378:     - spec_path_resolved\n379:     - spec.md: created_or_updated\n380:     - plan.md: created_or_updated\n381:     - tasks.md: created_or_updated\n382:     - checklist.md: created_or_updated\n383: \n384:   step_2_mode_planning:\n385:     purpose: Resolve the mode list and per-packet plan\n386:     activities:\n387:       - \"For a net-new single-mode workflow packet, default packetSkillName = \\\"[hub-prefix]-[mode]\\\" and a packet folder of the same name (recommended, not enforced); plan any --surfaces as bare-noun surface packets\"\n388:       - \"Allow several modes to share one packet folder (canonical: 4 improvement modes -> deep-improvement); allow a grandfathered packet whose folder != packetSkillName (rare; record the rationale via grandfatheredFolderMismatch)\"\n389:       - \"Set each mode's top-level packet field to its packet sub-directory and plan the two-axis discriminator (workflowMode + packetKind + backendKind; runtimeLoopType only for runtime-loop workflow modes) plus toolSurface and grandfatheredFolderMismatch\"\n390:       - Plan the advisorRouting block per mode (routingClass, legacyAdvisorId for lexical/alias-fold, advisorDefaultMode, legacyAliases, packetSkillName)\n391:       - Preserve existing packet names, registry keys, and routing blocks when update mode\n392:       - \"When several modes intentionally share one packet folder, log it as an assumption — do not treat it as a duplicate-folder failure\"\n393:       - \"On update, classify the target's root ROUTER.md as stage1-only, active, legacy-migratable, already-current, conflict, or malformed and select the ROUTER.md: create|migrate|unchanged action (see skill-parent.md section 7); stop on conflict or malformed\"\n394:     outputs:\n395:       - packet_plan\n396:       - registry_plan\n397:       - router_state_classification\n398:       - router_action_line\n399: \n400:   step_3_template_loading:\n401:     purpose: Load standards and templates before generation\n402:     activities:\n403:       - Read parent-skill/parent-skills-nested-packets.md for the Parent Skills with Nested Mode Packets pattern\n404:       - Read references/parent-skill/parent-hub-router-schema.md for the hub-router.json contract\n405:       - Read parent_skill_hub_template.md\n406:       - Read parent_skill_registry_template.json\n407:       - Read parent_skill_hub_router_template.json\n408:       - Read parent_skill_root_router_template.md (root ROUTER.md two-state authoring)\n409:       - Read parent_skill_description_template.json\n410:       - Read parent_skill_graph_metadata_template.json\n411:       - Extract the hub SKILL.md, registry, hub-router, root router, description, and hub graph-metadata contracts\n412:     outputs:\n413:       - template_contract_loaded\n414: \n415:   step_4_package_generation:\n416:     purpose: Generate or update the parent-skill package\n417:     activities:\n418:       - Ensure skill_root exists\n419:       - Create or update the thin hub SKILL.md (routing only)\n420:       - \"Create or update mode-registry.json with the two-axis discriminator (workflowMode + packetKind + backendKind), toolSurface and grandfatheredFolderMismatch per mode, a top-level packet, and one advisorRouting block per mode\"\n421:       - \"Create or update hub-router.json from parent_skill_hub_router_template.json (routerSignals for every mode, typed vocabularyClasses, tieBreak covering all modes; keep any catch-all class (hub-identity) on the default mode only, never specialized modes (route-gold over-emission); surface packets get metadata routerSignals plus a surfaceBundle outcome)\"\n422:       - \"Create or update root ROUTER.md from parent_skill_root_router_template.md per the classified action: create -> stage1-only with empty maps; migrate -> root ROUTER.md from the legacy smart-routing.md content with the inner machine block preserved byte-for-byte; unchanged -> leave as-is; conflict/malformed -> STOP before generation\"\n423:       - \"Create or update description.json from parent_skill_description_template.json\"\n424:       - \"Create or update exactly one hub graph-metadata.json from parent_skill_graph_metadata_template.json (skill_id == hub folder, family in the allowed set)\"\n425:       - \"Create or update one workflow packet dir per distinct packet value (default folder == packetSkillName == [hub-prefix]-<mode>; reuse a shared packet folder when several modes map to one), each with its own SKILL.md, README.md, and changelog/\"\n426:       - \"When --surfaces <names> is given, generate each surface as a read-only evidence-base packet: bare-noun folder, packetKind surface, backendKind evidence-base, read-only toolSurface, routingClass metadata, with its own SKILL.md, README.md, and changelog/\"\n427:       - \"Create the hub changelog/ and manual-testing-playbook/ (changelog files are real files, never symlinks)\"\n428:       - Create the non-discoverable shared/ dir with a shared/README.md\n429:       - Never write a graph-metadata.json inside any packet or inside shared/\n430:       - \"When any mode is routingClass lexical or alias-fold, run advisor_projection_emit to emit/update the advisor routing projection from the finalized mode-registry.json and refresh the embedded projection hash\"\n431:       - \"After mode-registry.json and all packet directories are finalized, run node .opencode/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --write [skill_root] to generate or refresh this hub's leaf-manifest.json. This is the scoped, hub-only generator; never invoke the fleet ci-skill-root-metadata.cjs --fix from this workflow, since --fix regenerates generated files across all scanned roots and would hide unrelated-root blast radius behind this create operation\"\n432:     outputs:\n433:       - generated_hub\n434:       - generated_registry\n435:       - generated_packets\n436:       - generated_shared\n437:       - advisor_projection_emitted\n438:       - generated_leaf_manifest\n439:       - root_router_actioned\n440: \n441:   step_5_validation:\n442:     purpose: Validate the generated package against the canonical structural gate (success gate == the /doctor parent-skill-check gate)\n443:     activities:\n444:       - Run validate_document.py on the hub SKILL.md\n445:       - \"Run the canonical structural gate and REQUIRE exit 0: node .opencode/commands/doctor/scripts/parent-skill-check.cjs [skill_root] — the same gate /doctor parent-skill runs, owning hub identity, the two-axis discriminator, toolSurface, hub-router validity, description.json, changelog shape, and registry/directory reverse consistency\"\n446:       - \"For a net-new hub (create), the default gate now blocks on checks 5-9 (canon-promoted): node .opencode/commands/doctor/scripts/parent-skill-check.cjs [skill_root] must exit 0, so a fresh hub must carry no canon gaps in hub-router, description.json, changelog shape, playbook, or benchmark baseline\"\n447:       - \"Assert the hub graph-metadata.json has skill_id == hub folder name AND family in {cli, mcp, sk-code, deep-loop, sk-util, system}\"\n448:       - Check mode-registry.json is valid JSON and has one advisorRouting block per mode\n449:       - \"Per mode, assert the two-axis discriminator: workflowMode is a non-empty string; packetKind is \\\"workflow\\\" or \\\"surface\\\"; backendKind is present; runtimeLoopType appears only for runtime-loop workflow modes; toolSurface and grandfatheredFolderMismatch are present; surface packets are read-only evidence-base\"\n450:       - \"Per mode, assert an advisorRouting block with routingClass in {lexical, alias-fold, metadata, command-bridge}\"\n451:       - \"Check each mode's top-level packet resolves to an existing direct-child sub-directory (no absolute or ../ paths) that contains its own SKILL.md; workflow folder == [hub-prefix]-<mode> and surface folder == bare noun are recommended, grandfathered mismatches allowed via grandfatheredFolderMismatch\"\n452:       - Count graph-metadata.json files under skill_root; assert exactly 1 (the hub) and 0 inside packets/shared\n453:       - \"If any mode is routingClass lexical or alias-fold, run the advisor projection drift guard from system-skill-advisor and require a pass\"\n454:       - \"Assert [skill_root]/leaf-manifest.json exists and is valid JSON (step_4 generates it via the scoped generator); parent_skill_check_passed already covers its class-H structural requirement, so a missing/stale file here means step_4's generation activity was skipped, not a separate defect to fix in this step\"\n455:       - \"Assert the root ROUTER.md conforms to the two-state contract via parent_skill_check's check 12 (stable RRC codes) and, on migrate, assert the machine-block hash before == after\"\n456:     outputs:\n457:       - hub_validation_passed\n458:       - parent_skill_check_passed\n459:       - hub_identity_passed\n460:       - registry_coverage_passed\n461:       - discriminator_passed\n462:       - packet_structure_passed\n463:       - one_identity_passed\n464:       - advisor_projection_guard_passed\n465:       - leaf_manifest_present\n466:       - root_router_contract_passed\n467: \n468:   step_5b_save_context:\n469:     purpose: Preserve spec-folder documentation and index the implementation summary for this parent-skill work\n470:     condition: \"spec_path is not null\"\n471:     activities:\n472:     - Invoke system-spec-kit skill\n473:     - Document parent-skill decisions (mode list, packet plan, advisorRouting choices, validation results)\n474:     - Record any logged assumptions from mode planning or generation\n475:     - Create or update implementation-summary.md with timestamp\n476:     - Index implementation-summary.md for immediate search availability\n477:     tool_invocation:\n478:       command: 'Read(\".opencode/skills/system-spec-kit/SKILL.md\")'\n479:       note: \"Activate context saving via memory skill\"\n480:     outputs:\n481:     - implementation_summary: \"[spec_path]/implementation-summary.md\"\n482:     validation: context_saved\n483: \n484:     post_save_indexing:\n485:       purpose: \"Index the canonical spec document immediately for search availability\"\n486:       mcp_tool: memory_save\n487:       invocation: |\n488:         memory_save({\n489:           filePath: \"[spec_path]/implementation-summary.md\"\n490:         })\n491:       critical_note: \"Call semantic memory MCP DIRECTLY - NEVER through Code Mode. The save target is a canonical spec document; standalone memory/*.md files are retired and the runtime rejects them.\"\n492:       when: \"Immediately after implementation-summary.md is written to disk\"\n493: \n494:   step_6_completion:\n495:     purpose: Emit completion status\n496:     activities:\n497:       - Summarize operation, mode list, and generated paths\n498:       - Report identity counts and validation results\n499:       - \"Report advisor projection emission when any mode is routingClass lexical or alias-fold (see advisor_map_sync_note)\"\n500:       - \"Render the Advisor/Index Handoff block per .opencode/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md: description.json/graph-metadata.json ownership lines are static text; leaf-manifest.json state is fresh when step_4's generate-leaf-manifest.cjs --write ran cleanly and leaf_manifest_present held in step_5, missing when the file is absent, stale is not reachable here since this command just generated it; command-metadata.json reports present-and-validated or omitted per whether the hub declares one; refresh status is always NOT RUN — this command never calls skill_graph_scan or advisor_rebuild itself\"\n501:       - \"Report spec-folder tracking status: [spec_path] ([created|existing|skipped])\"\n502:       - Return STATUS=OK PATH=[skill_root]\n503:     outputs:\n504:       - completion_report\n505:       - advisor_index_handoff_report\n506:       - spec_folder_status\n507: \n508:   advisor_map_sync_note:\n509:     when: \"any generated mode has advisorRouting.routingClass == lexical or alias-fold\"\n510:     warning: |\n511:       Advisor routing for lexical/alias-fold modes is registry-declared and then\n512:       emitted into the advisor projection constants with a freshness hash.\n513:       The advisor does NOT read mode-registry.json at runtime. After emission,\n514:       the system-skill-advisor drift guard must pass before reporting success.\n515:       metadata and command-bridge modes need no advisor-map entry.\n516: \n517: error_recovery:\n518:   missing_skill_on_update:\n519:     action: \"Stop and recommend reroute to create\"\n520:   existing_skill_on_create:\n521:     action: \"Stop and recommend reroute to update\"\n522:   missing_hub_template:\n523:     action: \"Stop because the parent-skill contract cannot be enforced\"\n524:   rogue_packet_identity:\n525:     action: \"Remove the per-packet or shared graph-metadata.json and re-validate\"\n526:   hub_validation_failure:\n527:     action: \"Enter fix-and-revalidate loop\"\n528: \n529: circuit_breaker:\n530:   trigger_threshold: 3\n531:   reset_condition: \"Hub validation passes, registry coverage passes, and exactly one graph-metadata.json resolves\"\n532:   actions:\n533:     - \"Stop autonomous generation\"\n534:     - \"Report the failing gate and affected path\"\n535:     - \"Return STATUS=FAIL with next-step guidance\"\n536: \n537: autonomous_execution:\n538:   principle: \"Advance automatically once hard gates pass\"\n539:   status_reporting:\n540:     cadence: \"Report at major workflow boundaries\"\n541:     include:\n542:       - operation\n543:       - mode_list\n544:       - target_path\n545:       - identity_count\n546:       - validation_state\n547: \n548: completion_report_template: |\n549:   Parent Skill Command Complete\n550: \n551:   Skill: [skill_name]\n552:   Operation: [operation]\n553:   Modes: [mode_list]\n554:   Mode: :auto\n555:   Target: [skill_root]\n556: \n557:   Root router:\n558:   - ROUTER.md state: [stage1-only|active|legacy-migratable|already-current|conflict|malformed]\n559:   - ROUTER.md action: [create|migrate|unchanged]\n560: \n561:   Spec Folder: [spec_path] ([created|existing|skipped])\n562:   Context saved: [yes/no]\n563: \n564:   Identity:\n565:   - Hub graph-metadata.json count: [count, must be 1]\n566:   - Per-packet graph-metadata.json count: [count, must be 0]\n567: \n568:   Validation:\n569:   - parent-skill-check.cjs (canonical gate): [exit 0 / FAIL]\n570:   - Root router contract (check 12, stable RRC codes): [passed/failed]\n571:   - Hub structure: [passed/failed]\n572:   - Hub identity (skill_id == folder, family in allowed set): [passed/failed]\n573:   - Canon files (hub-router.json, description.json, changelogs): [present/missing]\n574:   - Registry advisorRouting: registry-declared (advisor map sync required) [present/missing per mode]\n575:   - Mode discriminator (workflowMode/packetKind/backendKind + toolSurface): [passed/failed]\n576:   - Per-packet structure: [passed/failed]\n577:   - One-identity invariant: [passed/failed]\n578: \n579:   Advisor map sync (lexical/alias-fold modes only):\n580:   - [none | emitted with projection hash and drift guard passed]\n581: \n582:   STATUS=[OK|FAIL] PATH=[skill_root]\n583: \n584: termination:\n585:   success_signal: \"STATUS=OK PATH=[skill_root]\"\n586:   failure_signal: \"STATUS=FAIL PATH=[skill_root]\"\n587:   rule: \"Do not claim completion until identity counts and validation output are included\"\n588: \n589: rules:\n590:   must:\n591:     - \"Load the creation reference and all canon templates (hub, registry, hub-router, root router, description, graph-metadata) before writing\"\n592:     - \"Keep the hub SKILL.md thin and routing-only\"\n593:     - \"Resolve modes through the registry; keep per-mode contracts in packets\"\n594:     - \"Emit the full canon set: mode-registry.json, hub-router.json, ROUTER.md (stage1-only on create), description.json, graph-metadata.json, and changelogs (real files) at hub and packet level\"\n595:     - \"Gate completion on parent-skill-check.cjs exit 0\"\n596:     - \"Keep exactly one graph-metadata.json (the hub's)\"\n597:     - \"On update, classify the root ROUTER.md state and emit exactly one ROUTER.md: create|migrate|unchanged action; stop on conflict or malformed; preserve the machine block byte-for-byte in ordinary migration\"\n598:   must_not:\n599:     - \"Add a graph-metadata.json inside a packet or inside shared/\"\n600:     - \"Emit runtimeLoopType for a mode that is not a runtime-loop workflow mode\"\n601:     - \"Give a surface packet write or mutate tools — surfaces are read-only evidence bases\"\n602:     - \"Use symlinks for changelog files\"\n603:     - \"Move synthesis helpers into the execution backend\"\n604:     - \"Widen the behavior-parity contract to chase coverage\"\n605:     - \"Synthesize placeholder leaf intents or promote ROUTER.md to active without a concrete authored leaf map\"\n606:     - \"Create a legacy shared/references/smart-routing.md path or point hub-router defaultResource at a legacy router path\"\n\n(End of file - total 606 lines)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# OPENCODE CREATE: PARENT SKILL WORKFLOW (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# Mode: autonomous execution (no approval checkpoints)\n# Entrypoint: /create:skill-parent\n# Operations: create | update\n# ─────────────────────────────────────────────────────────────────\nrole: Parent Skill Creator using sk-doc\npurpose: Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth)\naction: Normalize inputs, load standards, generate the hub + registry + packets + shared, validate identity, and report completion\n\n# ─────────────────────────────────────────────────────────────────\n# PREREQUISITE: @markdown AGENT VERIFICATION\n# ─────────────────────────────────────────────────────────────────\n# This workflow REQUIRES the @markdown agent for:\n#   - Template-first generation\n#   - sk-doc standards enforcement\n#   - Hub document validation\n#\n# PHASE 0 in the command markdown verifies @markdown agent BEFORE","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/create/assets/create-skill-parent-auto.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# OPENCODE CREATE: PARENT SKILL WORKFLOW (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# Mode: autonomous execution (no approval checkpoints)\n# Entrypoint: /create:skill-parent\n# Operations: create | update\n# ─────────────────────────────────────────────────────────────────\nrole: Parent Skill Creator using sk-doc\npurpose: Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth)\naction: Normalize inputs, load standards, generate the hub + registry + packets + shared, validate identity, and report completion\n\n# ─────────────────────────────────────────────────────────────────\n# PREREQUISITE: @markdown AGENT VERIFICATION\n# ─────────────────────────────────────────────────────────────────\n# This workflow REQUIRES the @markdown agent for:\n#   - Template-first generation\n#   - sk-doc standards enforcement\n#   - Hub document validation\n#\n# PHASE 0 in the command markdown verifies @markdown agent BEFORE\n# this YAML workflow loads. If you are executing this workflow,\n# @markdown verification has already passed.\n# ─────────────────────────────────────────────────────────────────\n\noperating_mode:\n  workflow: unified_6_step\n  workflow_compliance: MANDATORY\n  workflow_execution: autonomous\n  approvals: none\n  tracking: progressive_status_logging\n  validation: continuous_self_validation\n  supports_operations:\n    - create\n    - update\n  description: |\n    Executes the 6-step parent-skill scaffolding workflow without step-by-step approval.\n    Pauses only if confidence drops below threshold or existence semantics conflict.\n\ndevelopment_philosophy:\n  principle: \"One discoverable hub identity, the registry as the single declarative source of truth\"\n  approach: \"Normalize -> Plan modes -> Scaffold -> Validate identity -> Report\"\n  mandate: \"Prefer the shipped sk-doc parent-skill pattern over ad-hoc nested-skill layouts\"\n\nruntime_agent_path_resolution:\n  default: .opencode/agents\n  claude: .claude/agents\n\n# ─────────────────────────────────────────────────────────────────\n# CONFIDENCE & CLARIFICATION FRAMEWORK\n# ─────────────────────────────────────────────────────────────────\nconfidence_framework:\n  thresholds:\n    high: { range: \"80-100%\", action: \"Proceed with deterministic defaults\" }\n    medium: { range: \"40-79%\", action: \"Proceed with caution and log assumptions\" }\n    low: { range: \"0-39%\", action: \"STOP and request clarification\" }\n  scoring_weights:\n    input_completeness: 0.30\n    routing_clarity: 0.20\n    contract_alignment: 0.30\n    validation_readiness: 0.20\n  low_confidence_behavior:\n    action: \"Stop before generation and ask one consolidated clarification\"\n\n# ─────────────────────────────────────────────────────────────────\n# REQUEST ANALYSIS FRAMEWORK\n# ─────────────────────────────────────────────────────────────────\nrequest_analysis_framework:\n  solution_flow:\n    - \"Parse command arguments and normalize execution mode\"\n    - \"Verify create/update semantics against the real target path\"\n    - \"Load the creation reference and both templates before writing\"\n    - \"Derive the mode list and per-mode packet plan\"\n    - \"Generate the hub, registry, packets, and shared dir with one hub identity\"\n    - \"Validate hub structure, per-packet structure, registry coverage, and the one-identity invariant\"\n  pre_change_validation:\n    items:\n      - \"create_agent_verified is true\"\n      - \"skill_name is present\"\n      - \"operation is create or update\"\n      - \"modes is present and non-empty\"\n      - \"execution_mode is :auto\"\n    stop_conditions:\n      - \"Any required input missing\"\n      - \"Operation does not match real target existence\"\n    stop_action: \"STOP and correct setup before generation\"\n\ninput_contract:\n  required:\n    - create_agent_verified\n    - skill_name\n    - operation\n    - modes\n    - execution_mode\n  optional:\n    - skill_path\n    - surfaces\n    - spec_choice\n    - spec_path\n    - memory_choice\n\nfield_handling:\n  skill_name:\n    validation: \"hyphen-case folder name; becomes the hub skill identity\"\n    required: true\n  operation:\n    validation: \"must be one of: create, update\"\n    required: true\n  modes:\n    validation: \"comma-separated hyphen-case mode names; one workflow packet per mode\"\n    required: true\n  surfaces:\n    validation: \"optional comma-separated bare-noun names, one read-only evidence-base surface packet each (packetKind: surface)\"\n    required: false\n  execution_mode:\n    validation: \"must be :auto\"\n    required: true\n\ndocumentation_level:\n  default: \"Level 2 (Verification)\"\n  required_files:\n    - spec.md\n    - plan.md\n    - tasks.md\n    - checklist.md\n  note: \"Parent-skill scaffolding spans a hub, a registry, multiple packets, and an identity invariant, so it needs verification\"\n\ndefaults:\n  skill_path: .opencode/skills/\n  registry_filename: mode-registry.json\n  hub_router_filename: hub-router.json\n  root_router_filename: ROUTER.md\n  description_filename: description.json\n  graph_metadata_filename: graph-metadata.json\n  shared_dirname: shared\n  packet_prefix: \"[hub-prefix]-  # derived from the hub (e.g. code- for sk-code); NEVER hardcode deep-. Exception: system-deep-loop's packets keep the deep- prefix (matching the /deep:* command namespace, not the hub folder name) — the folder-prefix/command-namespace-prefix equivalence has this one documented exception.\"\n  surface_packet_naming: \"bare noun, no prefix (e.g. webflow)\"\n  execution_mode: :auto\n  dqi_hard_minimum: 75\n\n# ─────────────────────────────────────────────────────────────────\n# CANONICAL ROOT ROUTER CLASSIFICATION + ACTION CONTRACT\n# ─────────────────────────────────────────────────────────────────\n# Both workflows bind this exact block: the classification states, the action\n# line, and the invariants are one contract shared by :auto and :confirm. The\n# parity test compares this block structurally, so the two workflows can never\n# drift apart on when they create, migrate, leave unchanged, or stop. Only\n# checkpointing differs between the modes.\n# ─────────────────────────────────────────────────────────────────\nroot_router_contract:\n  action_line: \"ROUTER.md: create|migrate|unchanged\"\n  classification_states:\n    - stage1-only\n    - active\n    - legacy-migratable\n    - already-current\n    - conflict\n    - malformed\n  actions:\n    - create\n    - migrate\n    - unchanged\n  state_action_map:\n    stage1-only:\n      action: unchanged\n      note: \"Existing stage1-only router with empty maps stays as-is; an absent root on a new hub routes to create\"\n    active:\n      action: unchanged\n      note: \"Existing active router with non-empty equal-key maps stays as-is\"\n    legacy-migratable:\n      action: migrate\n      note: \"No root router; only a legacy smart-routing.md exists. Create the root ROUTER.md from the legacy content, preserve the machine block byte-for-byte, then delete the legacy file only after the migrated hub validates\"\n    already-current:\n      action: unchanged\n      note: \"Root router already matches the contract\"\n    conflict:\n      action: null\n      stop_before_write: true\n      note: \"Root ROUTER.md coexists with a legacy smart-routing.md; STOP before any write and require manual resolution\"\n    malformed:\n      action: null\n      stop_before_write: true\n      note: \"Router state or machine maps are unreadable; STOP before any write and require manual repair\"\n  invariants:\n    create_emits_stage1_only_with_empty_maps: true\n    stop_before_write_on_conflict: true\n    stop_before_write_on_malformed: true\n    delete_legacy_only_after_validation: true\n    preserve_machine_block_bytes_on_migrate: true\n\noperation_router:\n  create:\n    requires_existing_skill: false\n    output_scope:\n      - SKILL.md\n      - mode-registry.json\n      - hub-router.json\n      - ROUTER.md                # stage-two control; router_state: stage1-only on a fresh scaffold\n      - description.json\n      - graph-metadata.json\n      - changelog/\n      - manual-testing-playbook/\n      - \"[hub-prefix]-<mode>/SKILL.md\"\n      - \"[hub-prefix]-<mode>/README.md\"\n      - \"[hub-prefix]-<mode>/changelog/\"\n      - \"<surface>/{SKILL.md,README.md,changelog/}  (when --surfaces)\"\n      - shared/\n      - shared/README.md\n  update:\n    requires_existing_skill: true\n    output_scope:\n      - SKILL.md\n      - mode-registry.json\n      - hub-router.json\n      - ROUTER.md                # stage-two control; classify, then create/migrate/unchanged\n      - description.json\n      - graph-metadata.json\n      - changelog/\n      - \"[hub-prefix]-<mode>/SKILL.md\"\n      - shared/\n\nreference_sources:\n  specific_creation: .opencode/skills/sk-doc/sk-create-skill/references/README.md\n  pattern_section: \"Parent Skills with Nested Mode Packets\"\n  hub_router_schema: .opencode/skills/sk-doc/sk-create-skill/references/parent-skill/parent-hub-router-schema.md\n  core_standards: .opencode/skills/sk-doc/shared/references/core-standards.md\n  validation: .opencode/skills/sk-doc/shared/references/validation.md\n  canonical_example: .opencode/skills/sk-code\n\ntemplate_sources:\n  hub_skill: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\n  mode_registry: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\n  hub_router: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\n  root_router: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-smart-routing-template.md\n  description: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-description-template.json\n  hub_graph_metadata: .opencode/skills/sk-doc/sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\n\nvalidation_scripts:\n  validate_document: .opencode/skills/sk-doc/scripts/validate_document.py\n  extract_structure: .opencode/skills/sk-doc/scripts/extract_structure.py\n  advisor_projection_emit: \"python3 .opencode/skills/system-skill-advisor/mcp-server/scripts/skill_advisor.py --emit-routing-projection\"\n  advisor_projection_guard: \"PATH=\\\"/opt/homebrew/bin:$PATH\\\" npm test -- routing-registry-drift-guard.vitest.ts\"\n\nquality_standards:\n  template_first: required\n  frontmatter_required: true\n  hub_requirements:\n    - thin routing-only SKILL.md (no per-mode logic)\n    - \"exactly one graph-metadata.json at the hub root (from parent_skill_graph_metadata_template.json) with skill_id == hub folder name and family in {cli, mcp, sk-code, deep-loop, sk-util, system}\"\n    - mode-registry.json present and valid JSON\n    - \"hub-router.json present and valid (routerSignals cover every workflowMode, typed vocabularyClasses, tieBreak covers all modes; any catch-all vocabulary class (hub-identity) is on the default mode only, not specialized modes (see parent_hub_router_schema.md); surface packets get metadata routerSignals plus a surfaceBundle outcome)\"\n    - \"root ROUTER.md present with router_state: stage1-only or active, a root skill_pointer, and a four-part version; stage1-only maps stay empty, active maps are non-empty and equal-keyed\"\n    - description.json present\n    - \"changelog/ with real files (no symlinks) at the hub root and in every packet\"\n  registry_requirements:\n    - \"each mode carries the two-axis discriminator: workflowMode (string) + packetKind (\\\"workflow\\\" | \\\"surface\\\") + backendKind; runtimeLoopType is present ONLY for workflow modes on a runtime-loop backend (when the runtime-loop extension is declared), otherwise omitted\"\n    - \"each mode carries toolSurface (allowed, forbidden, mutatesWorkspace, bashAllowlist) and grandfatheredFolderMismatch (boolean, false unless a legacy folder/name mismatch is intentionally preserved)\"\n    - \"surface packets (packetKind: surface) are read-only evidence bases: backendKind evidence-base, toolSurface allowed subset of {Read, Bash, Grep, Glob} with {Write, Edit, Task} forbidden and mutatesWorkspace false, advisorRouting.routingClass metadata (advisor-invisible)\"\n    - \"each mode has a top-level packet field naming its packet sub-directory (a direct child of the hub)\"\n    - one advisorRouting block per mode\n    - \"advisorRouting fields: routingClass (lexical | alias-fold | metadata | command-bridge), legacyAdvisorId (lexical + alias-fold modes only), advisorDefaultMode (optional, alias-fold default), legacyAliases (lexical + alias-fold only), packetSkillName\"\n    - \"registry keys (mode.packet) match packet folder names; canonical workflow folder == packetSkillName == [hub-prefix]-<mode>, surface folder == packetSkillName == bare noun; grandfathered mismatches recorded via grandfatheredFolderMismatch + packetSkillName\"\n    - \"runtimeLoopType allowed set when present and non-null: research | review | council | context (or the hub's declared runtime-loop types)\"\n  advisor_projection_requirements:\n    - \"For lexical/alias-fold modes, emit the generated advisor projection from the finalized mode-registry.json into system-skill-advisor's TypeScript and Python projection constants\"\n    - \"Projection emission must include a SHA-256 freshness hash and must not add runtime reads of another skill's mode-registry.json\"\n    - \"The routing-registry drift guard must pass after projection emission\"\n  packet_requirements:\n    - \"RECOMMENDED DEFAULT for a net-new single-mode workflow packet: folder == packetSkillName == [hub-prefix]-<mode> (soft guidance, not a hard gate); surface packets use a bare-noun folder\"\n    - \"ALLOWED: many modes mapping to one packet folder (canonical: 4 improvement modes -> deep-improvement)\"\n    - \"ALLOWED: grandfathered packets where folder != packetSkillName (rare; record the rationale in the packet's decision record)\"\n    - each packet has its own SKILL.md\n    - \"each mode's packet folder is a direct child of the hub (no absolute or ../ paths)\"\n    - NO per-packet graph-metadata.json\n  shared_requirements:\n    - non-discoverable shared/ for packet-shared workflow-layer helpers (synthesis, not execution primitives)\n    - NO graph-metadata.json inside shared/\n  one_identity_rule: \"Exactly one graph-metadata.json (the hub's). A nested graph-metadata.json creates a rogue advisor identity.\"\n  root_router_rule: \"Root ROUTER.md declares router_state: stage1-only or active. Fresh scaffolds are stage1-only with empty maps; promote to active only after authoring a concrete leaf map. On update, classify the router state and emit exactly one ROUTER.md: create|migrate|unchanged action; stop on conflict or malformed state; preserve the machine block byte-for-byte in ordinary migration.\"\n  validation_pipeline:\n    - \"python3 .opencode/skills/sk-doc/scripts/validate_document.py [skill_root]/SKILL.md\"\n    - \"python3 .opencode/skills/sk-doc/scripts/extract_structure.py [skill_root]/SKILL.md\"\n\ngate_logic:\n  hard:\n    H0_write_verified:\n      description: \"create_agent_verified must be true\"\n      fail_action: \"STOP and return to setup\"\n    H1_required_fields:\n      description: \"All required setup fields must be present (including a non-empty mode list)\"\n      fail_action: \"STOP and collect missing fields\"\n    H2_existence_semantics:\n      description: \"create/update must match real skill-root existence\"\n      fail_action: \"STOP and reroute or correct target\"\n    H3_contract_shape:\n      description: \"Generated package must match the parent-skill pattern (hub + registry + packets + shared)\"\n      fail_action: \"Fix structure before continuing\"\n    H4_one_identity:\n      description: \"Exactly one graph-metadata.json at the hub; zero inside packets or shared\"\n      fail_action: \"Remove rogue identities and re-validate\"\n    H5_validation_gate:\n      description: \"Hub validation, registry coverage, and per-packet structure checks must pass\"\n      fail_action: \"Run fix-and-revalidate loop\"\n  soft:\n    S1_packet_naming:\n      description: \"DEFAULT for a net-new single-mode workflow packet: folder == packetSkillName == [hub-prefix]-<mode> (surfaces use a bare-noun folder). NOT a hard gate. Many-modes-to-one-packet and grandfathered folder!=packetSkillName names are valid (canonical: 4 modes -> deep-improvement).\"\n      fail_action: \"Proceed with a logged assumption when grandfathering an existing packet or mapping several modes to one packet\"\n\nworkflow_overview:\n  steps:\n    - id: step_1_preflight\n      purpose: \"Normalize inputs and enforce H0-H2\"\n    - id: step_1b_spec_folder_setup\n      purpose: \"Resolve spec_choice into spec_path and create/confirm the documentation folder for tracking this work\"\n    - id: step_2_mode_planning\n      purpose: \"Resolve the mode list and per-packet plan\"\n    - id: step_3_template_loading\n      purpose: \"Load the reference and both hub/registry templates\"\n    - id: step_4_package_generation\n      purpose: \"Create or update hub, registry, packets, and shared with one identity\"\n    - id: step_5_validation\n      purpose: \"Run hub validation, registry coverage, and the one-identity invariant\"\n    - id: step_5b_save_context\n      purpose: \"Persist spec-folder documentation and index the implementation summary for this parent-skill work\"\n    - id: step_6_completion\n      purpose: \"Emit deterministic completion report\"\n\n# ─────────────────────────────────────────────────────────────────\n# CONTEXT LOADING\n# ─────────────────────────────────────────────────────────────────\ncontext_loading:\n  trigger: \"During UNIFIED SETUP PHASE, non-interactive resolution before Step 1\"\n  applies_when: \"spec_path resolves to an existing spec folder (Q3 choice A - Existing, C - Update related, or D - Extend phased packet) that contains handover.md or _memory.continuity in implementation-summary.md; not applicable to a freshly created spec folder (Q3 choice B - New) or when spec_choice is E (Skip)\"\n  auto_resolution:\n    default: \"If prior context exists (handover.md <24h old, or _memory.continuity present in {spec_path}), load it automatically via memory_context (mode: resume); sets memory_loaded: handover+continuity. Otherwise skip; sets memory_loaded: skipped.\"\n    override: \"Honor memory_choice if explicitly supplied as a command argument or pre-bound setup answer (A/B/C)\"\n  mcp_integration:\n    tool: memory_context\n    note: \"Call MCP tools directly - NEVER through Code Mode\"\n    parameters: { input: \"resume previous work on {spec_path}\", mode: \"resume\", profile: \"resume\", specFolder: \"{spec_path}\", includeContent: true }\n    transport_fallback: \"If MCP tools are missing or erroring while the daemon is otherwise warm, use: node .opencode/bin/spec-memory.cjs memory_context --json '{\\\"input\\\":\\\"resume previous work\\\",\\\"mode\\\":\\\"resume\\\"}' --format json --timeout-ms 3000 --warm-only. Exit 75 = retryable backend unavailability.\"\n  output: memory_loaded\n\nworkflow:\n  step_1_preflight:\n    purpose: Normalize and verify required fields\n    activities:\n      - Normalize skill_path to default when omitted\n      - Derive skill_root as \"[skill_path]/[skill_name]\"\n      - Validate operation token to supported value\n      - Parse modes into a normalized hyphen-case list\n      - Validate execution_mode is :auto\n      - Check whether skill_root already exists\n      - Resolve memory_choice via the context_loading block (Q4 if applicable); record result as memory_loaded\n    outputs:\n      - normalized_inputs\n      - mode_list\n      - target_existence_state\n      - memory_loaded\n\n  step_1b_spec_folder_setup:\n    purpose: Resolve spec_choice into spec_path and create/confirm the documentation folder for tracking this work\n    condition: \"spec_choice != E (Skip)\"\n    activities:\n    - IF spec_choice == B (Create new):\n      - Find next available spec number\n      - Command: \"ls -d specs/[0-9]*/ | sed 's/.*\\\\/\\\\([0-9]*\\\\)-.*/\\\\1/' | sort -n | tail -1\"\n      - Create folder: specs/[NNN]-[skill_name]-parent/\n    - IF spec_choice == A, C, or D (Existing, Update related, or Extend phased packet):\n      - Use selected spec_path\n    - \"Route spec.md, plan.md, tasks.md, and checklist.md creation through distributed governance (AGENTS.md Rule 5), matching this family's Level 2 documentation_level\"\n    templates:\n    # Use Level 2 templates as default for parent-skill scaffolding\n    - .opencode/skills/system-spec-kit/templates/examples/level-2/spec.md\n    - .opencode/skills/system-spec-kit/templates/examples/level-2/plan.md\n    - .opencode/skills/system-spec-kit/templates/examples/level-2/tasks.md\n    - .opencode/skills/system-spec-kit/templates/examples/level-2/checklist.md\n    outputs:\n    - spec_path_resolved\n    - spec.md: created_or_updated\n    - plan.md: created_or_updated\n    - tasks.md: created_or_updated\n    - checklist.md: created_or_updated\n\n  step_2_mode_planning:\n    purpose: Resolve the mode list and per-packet plan\n    activities:\n      - \"For a net-new single-mode workflow packet, default packetSkillName = \\\"[hub-prefix]-[mode]\\\" and a packet folder of the same name (recommended, not enforced); plan any --surfaces as bare-noun surface packets\"\n      - \"Allow several modes to share one packet folder (canonical: 4 improvement modes -> deep-improvement); allow a grandfathered packet whose folder != packetSkillName (rare; record the rationale via grandfatheredFolderMismatch)\"\n      - \"Set each mode's top-level packet field to its packet sub-directory and plan the two-axis discriminator (workflowMode + packetKind + backendKind; runtimeLoopType only for runtime-loop workflow modes) plus toolSurface and grandfatheredFolderMismatch\"\n      - Plan the advisorRouting block per mode (routingClass, legacyAdvisorId for lexical/alias-fold, advisorDefaultMode, legacyAliases, packetSkillName)\n      - Preserve existing packet names, registry keys, and routing blocks when update mode\n      - \"When several modes intentionally share one packet folder, log it as an assumption — do not treat it as a duplicate-folder failure\"\n      - \"On update, classify the target's root ROUTER.md as stage1-only, active, legacy-migratable, already-current, conflict, or malformed and select the ROUTER.md: create|migrate|unchanged action (see skill-parent.md section 7); stop on conflict or malformed\"\n    outputs:\n      - packet_plan\n      - registry_plan\n      - router_state_classification\n      - router_action_line\n\n  step_3_template_loading:\n    purpose: Load standards and templates before generation\n    activities:\n      - Read parent-skill/parent-skills-nested-packets.md for the Parent Skills with Nested Mode Packets pattern\n      - Read references/parent-skill/parent-hub-router-schema.md for the hub-router.json contract\n      - Read parent_skill_hub_template.md\n      - Read parent_skill_registry_template.json\n      - Read parent_skill_hub_router_template.json\n      - Read parent_skill_root_router_template.md (root ROUTER.md two-state authoring)\n      - Read parent_skill_description_template.json\n      - Read parent_skill_graph_metadata_template.json\n      - Extract the hub SKILL.md, registry, hub-router, root router, description, and hub graph-metadata contracts\n    outputs:\n      - template_contract_loaded\n\n  step_4_package_generation:\n    purpose: Generate or update the parent-skill package\n    activities:\n      - Ensure skill_root exists\n      - Create or update the thin hub SKILL.md (routing only)\n      - \"Create or update mode-registry.json with the two-axis discriminator (workflowMode + packetKind + backendKind), toolSurface and grandfatheredFolderMismatch per mode, a top-level packet, and one advisorRouting block per mode\"\n      - \"Create or update hub-router.json from parent_skill_hub_router_template.json (routerSignals for every mode, typed vocabularyClasses, tieBreak covering all modes; keep any catch-all class (hub-identity) on the default mode only, never specialized modes (route-gold over-emission); surface packets get metadata routerSignals plus a surfaceBundle outcome)\"\n      - \"Create or update root ROUTER.md from parent_skill_root_router_template.md per the classified action: create -> stage1-only with empty maps; migrate -> root ROUTER.md from the legacy smart-routing.md content with the inner machine block preserved byte-for-byte; unchanged -> leave as-is; conflict/malformed -> STOP before generation\"\n      - \"Create or update description.json from parent_skill_description_template.json\"\n      - \"Create or update exactly one hub graph-metadata.json from parent_skill_graph_metadata_template.json (skill_id == hub folder, family in the allowed set)\"\n      - \"Create or update one workflow packet dir per distinct packet value (default folder == packetSkillName == [hub-prefix]-<mode>; reuse a shared packet folder when several modes map to one), each with its own SKILL.md, README.md, and changelog/\"\n      - \"When --surfaces <names> is given, generate each surface as a read-only evidence-base packet: bare-noun folder, packetKind surface, backendKind evidence-base, read-only toolSurface, routingClass metadata, with its own SKILL.md, README.md, and changelog/\"\n      - \"Create the hub changelog/ and manual-testing-playbook/ (changelog files are real files, never symlinks)\"\n      - Create the non-discoverable shared/ dir with a shared/README.md\n      - Never write a graph-metadata.json inside any packet or inside shared/\n      - \"When any mode is routingClass lexical or alias-fold, run advisor_projection_emit to emit/update the advisor routing projection from the finalized mode-registry.json and refresh the embedded projection hash\"\n      - \"After mode-registry.json and all packet directories are finalized, run node .opencode/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --write [skill_root] to generate or refresh this hub's leaf-manifest.json. This is the scoped, hub-only generator; never invoke the fleet ci-skill-root-metadata.cjs --fix from this workflow, since --fix regenerates generated files across all scanned roots and would hide unrelated-root blast radius behind this create operation\"\n    outputs:\n      - generated_hub\n      - generated_registry\n      - generated_packets\n      - generated_shared\n      - advisor_projection_emitted\n      - generated_leaf_manifest\n      - root_router_actioned\n\n  step_5_validation:\n    purpose: Validate the generated package against the canonical structural gate (success gate == the /doctor parent-skill-check gate)\n    activities:\n      - Run validate_document.py on the hub SKILL.md\n      - \"Run the canonical structural gate and REQUIRE exit 0: node .opencode/commands/doctor/scripts/parent-skill-check.cjs [skill_root] — the same gate /doctor parent-skill runs, owning hub identity, the two-axis discriminator, toolSurface, hub-router validity, description.json, changelog shape, and registry/directory reverse consistency\"\n      - \"For a net-new hub (create), the default gate now blocks on checks 5-9 (canon-promoted): node .opencode/commands/doctor/scripts/parent-skill-check.cjs [skill_root] must exit 0, so a fresh hub must carry no canon gaps in hub-router, description.json, changelog shape, playbook, or benchmark baseline\"\n      - \"Assert the hub graph-metadata.json has skill_id == hub folder name AND family in {cli, mcp, sk-code, deep-loop, sk-util, system}\"\n      - Check mode-registry.json is valid JSON and has one advisorRouting block per mode\n      - \"Per mode, assert the two-axis discriminator: workflowMode is a non-empty string; packetKind is \\\"workflow\\\" or \\\"surface\\\"; backendKind is present; runtimeLoopType appears only for runtime-loop workflow modes; toolSurface and grandfatheredFolderMismatch are present; surface packets are read-only evidence-base\"\n      - \"Per mode, assert an advisorRouting block with routingClass in {lexical, alias-fold, metadata, command-bridge}\"\n      - \"Check each mode's top-level packet resolves to an existing direct-child sub-directory (no absolute or ../ paths) that contains its own SKILL.md; workflow folder == [hub-prefix]-<mode> and surface folder == bare noun are recommended, grandfathered mismatches allowed via grandfatheredFolderMismatch\"\n      - Count graph-metadata.json files under skill_root; assert exactly 1 (the hub) and 0 inside packets/shared\n      - \"If any mode is routingClass lexical or alias-fold, run the advisor projection drift guard from system-skill-advisor and require a pass\"\n      - \"Assert [skill_root]/leaf-manifest.json exists and is valid JSON (step_4 generates it via the scoped generator); parent_skill_check_passed already covers its class-H structural requirement, so a missing/stale file here means step_4's generation activity was skipped, not a separate defect to fix in this step\"\n      - \"Assert the root ROUTER.md conforms to the two-state contract via parent_skill_check's check 12 (stable RRC codes) and, on migrate, assert the machine-block hash before == after\"\n    outputs:\n      - hub_validation_passed\n      - parent_skill_check_passed\n      - hub_identity_passed\n      - registry_coverage_passed\n      - discriminator_passed\n      - packet_structure_passed\n      - one_identity_passed\n      - advisor_projection_guard_passed\n      - leaf_manifest_present\n      - root_router_contract_passed\n\n  step_5b_save_context:\n    purpose: Preserve spec-folder documentation and index the implementation summary for this parent-skill work\n    condition: \"spec_path is not null\"\n    activities:\n    - Invoke system-spec-kit skill\n    - Document parent-skill decisions (mode list, packet plan, advisorRouting choices, validation results)\n    - Record any logged assumptions from mode planning or generation\n    - Create or update implementation-summary.md with timestamp\n    - Index implementation-summary.md for immediate search availability\n    tool_invocation:\n      command: 'Read(\".opencode/skills/system-spec-kit/SKILL.md\")'\n      note: \"Activate context saving via memory skill\"\n    outputs:\n    - implementation_summary: \"[spec_path]/implementation-summary.md\"\n    validation: context_saved\n\n    post_save_indexing:\n      purpose: \"Index the canonical spec document immediately for search availability\"\n      mcp_tool: memory_save\n      invocation: |\n        memory_save({\n          filePath: \"[spec_path]/implementation-summary.md\"\n        })\n      critical_note: \"Call semantic memory MCP DIRECTLY - NEVER through Code Mode. The save target is a canonical spec document; standalone memory/*.md files are retired and the runtime rejects them.\"\n      when: \"Immediately after implementation-summary.md is written to disk\"\n\n  step_6_completion:\n    purpose: Emit completion status\n    activities:\n      - Summarize operation, mode list, and generated paths\n      - Report identity counts and validation results\n      - \"Report advisor projection emission when any mode is routingClass lexical or alias-fold (see advisor_map_sync_note)\"\n      - \"Render the Advisor/Index Handoff block per .opencode/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md: description.json/graph-metadata.json ownership lines are static text; leaf-manifest.json state is fresh when step_4's generate-leaf-manifest.cjs --write ran cleanly and leaf_manifest_present held in step_5, missing when the file is absent, stale is not reachable here since this command just generated it; command-metadata.json reports present-and-validated or omitted per whether the hub declares one; refresh status is always NOT RUN — this command never calls skill_graph_scan or advisor_rebuild itself\"\n      - \"Report spec-folder tracking status: [spec_path] ([created|existing|skipped])\"\n      - Return STATUS=OK PATH=[skill_root]\n    outputs:\n      - completion_report\n      - advisor_index_handoff_report\n      - spec_folder_status\n\n  advisor_map_sync_note:\n    when: \"any generated mode has advisorRouting.routingClass == lexical or alias-fold\"\n    warning: |\n      Advisor routing for lexical/alias-fold modes is registry-declared and then\n      emitted into the advisor projection constants with a freshness hash.\n      The advisor does NOT read mode-registry.json at runtime. After emission,\n      the system-skill-advisor drift guard must pass before reporting success.\n      metadata and command-bridge modes need no advisor-map entry.\n\nerror_recovery:\n  missing_skill_on_update:\n    action: \"Stop and recommend reroute to create\"\n  existing_skill_on_create:\n    action: \"Stop and recommend reroute to update\"\n  missing_hub_template:\n    action: \"Stop because the parent-skill contract cannot be enforced\"\n  rogue_packet_identity:\n    action: \"Remove the per-packet or shared graph-metadata.json and re-validate\"\n  hub_validation_failure:\n    action: \"Enter fix-and-revalidate loop\"\n\ncircuit_breaker:\n  trigger_threshold: 3\n  reset_condition: \"Hub validation passes, registry coverage passes, and exactly one graph-metadata.json resolves\"\n  actions:\n    - \"Stop autonomous generation\"\n    - \"Report the failing gate and affected path\"\n    - \"Return STATUS=FAIL with next-step guidance\"\n\nautonomous_execution:\n  principle: \"Advance automatically once hard gates pass\"\n  status_reporting:\n    cadence: \"Report at major workflow boundaries\"\n    include:\n      - operation\n      - mode_list\n      - target_path\n      - identity_count\n      - validation_state\n\ncompletion_report_template: |\n  Parent Skill Command Complete\n\n  Skill: [skill_name]\n  Operation: [operation]\n  Modes: [mode_list]\n  Mode: :auto\n  Target: [skill_root]\n\n  Root router:\n  - ROUTER.md state: [stage1-only|active|legacy-migratable|already-current|conflict|malformed]\n  - ROUTER.md action: [create|migrate|unchanged]\n\n  Spec Folder: [spec_path] ([created|existing|skipped])\n  Context saved: [yes/no]\n\n  Identity:\n  - Hub graph-metadata.json count: [count, must be 1]\n  - Per-packet graph-metadata.json count: [count, must be 0]\n\n  Validation:\n  - parent-skill-check.cjs (canonical gate): [exit 0 / FAIL]\n  - Root router contract (check 12, stable RRC codes): [passed/failed]\n  - Hub structure: [passed/failed]\n  - Hub identity (skill_id == folder, family in allowed set): [passed/failed]\n  - Canon files (hub-router.json, description.json, changelogs): [present/missing]\n  - Registry advisorRouting: registry-declared (advisor map sync required) [present/missing per mode]\n  - Mode discriminator (workflowMode/packetKind/backendKind + toolSurface): [passed/failed]\n  - Per-packet structure: [passed/failed]\n  - One-identity invariant: [passed/failed]\n\n  Advisor map sync (lexical/alias-fold modes only):\n  - [none | emitted with projection hash and drift guard passed]\n\n  STATUS=[OK|FAIL] PATH=[skill_root]\n\ntermination:\n  success_signal: \"STATUS=OK PATH=[skill_root]\"\n  failure_signal: \"STATUS=FAIL PATH=[skill_root]\"\n  rule: \"Do not claim completion until identity counts and validation output are included\"\n\nrules:\n  must:\n    - \"Load the creation reference and all canon templates (hub, registry, hub-router, root router, description, graph-metadata) before writing\"\n    - \"Keep the hub SKILL.md thin and routing-only\"\n    - \"Resolve modes through the registry; keep per-mode contracts in packets\"\n    - \"Emit the full canon set: mode-registry.json, hub-router.json, ROUTER.md (stage1-only on create), description.json, graph-metadata.json, and changelogs (real files) at hub and packet level\"\n    - \"Gate completion on parent-skill-check.cjs exit 0\"\n    - \"Keep exactly one graph-metadata.json (the hub's)\"\n    - \"On update, classify the root ROUTER.md state and emit exactly one ROUTER.md: create|migrate|unchanged action; stop on conflict or malformed; preserve the machine block byte-for-byte in ordinary migration\"\n  must_not:\n    - \"Add a graph-metadata.json inside a packet or inside shared/\"\n    - \"Emit runtimeLoopType for a mode that is not a runtime-loop workflow mode\"\n    - \"Give a surface packet write or mutate tools — surfaces are read-only evidence bases\"\n    - \"Use symlinks for changelog files\"\n    - \"Move synthesis helpers into the execution backend\"\n    - \"Widen the behavior-parity contract to chase coverage\"\n    - \"Synthesize placeholder leaf intents or promote ROUTER.md to active without a concrete authored leaf map\"\n    - \"Create a legacy shared/references/smart-routing.md path or point hub-router defaultResource at a legacy router path\"","lineStart":1,"lineEnd":606,"totalLines":606,"truncated":false}},"title":".opencode/commands/create/assets/create-skill-parent-auto.yaml","time":{"start":1786890597927,"end":1786890597931}},"id":"prt_00afab50e001HuMR593gTSCNtw","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","messageID":"msg_00afaa4f600180IGxaEBe43XIt"}}
{"type":"text","timestamp":1786890598016,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"id":"prt_00afab45300121gBPT3eg0nrDC","messageID":"msg_00afaa4f600180IGxaEBe43XIt","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","type":"text","text":"Let me read the create-skill-parent auto YAML and check how init_skill.py and root-router-contract.cjs are wired in.","time":{"start":1786890597459,"end":1786890598015}}}
{"type":"step_finish","timestamp":1786890598501,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"id":"prt_00afab85f001sv3i2czONsi5H3","reason":"tool-calls","snapshot":"f24f178276832443854b0ffdbcedc8c5bc38f309","messageID":"msg_00afaa4f600180IGxaEBe43XIt","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","type":"step-finish","tokens":{"total":117289,"input":2710,"output":113,"reasoning":162,"cache":{"write":0,"read":114304}},"cost":0.0007764512}}
{"type":"step_start","timestamp":1786890600934,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"id":"prt_00afac1e5001GfQANlFBRJWGjm","messageID":"msg_00afaba3c001ytmndaP3KCHw6h","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","snapshot":"f24f178276832443854b0ffdbcedc8c5bc38f309","type":"step-start"}}
{"type":"tool_use","timestamp":1786890605296,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"type":"tool","tool":"read","callID":"call_00_hWxikV6HBSFaKuV1Bop67558","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/skills/sk-doc/sk-create-skill/scripts/init_skill.py"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/skills/sk-doc/sk-create-skill/scripts/init_skill.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: SKILL INITIALIZER\n4: # ───────────────────────────────────────────────────────────────\n5: \n6: \"\"\"\n7: Skill Initializer - Creates a new skill from template\n8: \n9: Usage:\n10:     init_skill.py <skill-name> --path <path>\n11: \n12: Examples:\n13:     init_skill.py my-new-skill --path skills/public\n14:     init_skill.py my-api-helper --path skills/private\n15:     init_skill.py custom-skill --path /custom/location\n16: \"\"\"\n17: \n18: import argparse\n19: import json\n20: import re\n21: import subprocess\n22: import sys\n23: from datetime import datetime, timezone\n24: from pathlib import Path\n25: from typing import Any, Optional\n26: \n27: # Shared S-class config defaults, also read by generate-leaf-manifest.cjs's\n28: # readStandaloneConfig fallback, so a scaffolded config and that fallback stay\n29: # in lockstep instead of being two hand-kept-equivalent copies.\n30: _S_CLASS_CONFIG_DEFAULTS = json.loads(\n31:     (Path(__file__).resolve().parent / \"lib\" / \"s-class-config-defaults.json\").read_text()\n32: )\n33: \n34: \n35: # ───────────────────────────────────────────────────────────────\n36: # 1. VALIDATION\n37: # ───────────────────────────────────────────────────────────────\n38: \n39: def validate_skill_name(skill_name: str) -> tuple[bool, str]:\n40:     \"\"\"Validate skill name format (hyphen-case).\n41: \n42:     Args:\n43:         skill_name: The skill name to validate.\n44: \n45:     Returns:\n46:         Tuple of (is_valid, error_message). Error message is empty if valid.\n47:     \"\"\"\n48:     if not re.match(r'^[a-z][a-z0-9-]*[a-z0-9]$', skill_name):\n49:         return False, (\n50:             f\"Skill name '{skill_name}' must be hyphen-case:\\n\"\n51:             \"   - Start with a lowercase letter\\n\"\n52:             \"   - End with a lowercase letter or number\\n\"\n53:             \"   - Contain only lowercase letters, numbers, and hyphens\\n\"\n54:             \"   Examples: my-skill, pdf-editor, code-review-v2\"\n55:         )\n56: \n57:     if len(skill_name) > 40:\n58:         return False, f\"Skill name '{skill_name}' exceeds 40 character limit ({len(skill_name)} chars)\"\n59: \n60:     if '--' in skill_name:\n61:         return False, f\"Skill name '{skill_name}' cannot contain consecutive hyphens (--)\"\n62: \n63:     return True, \"\"\n64: \n65: \n66: def title_case_skill_name(skill_name: str) -> str:\n67:     \"\"\"Convert hyphenated skill name to Title Case for display.\n68: \n69:     Args:\n70:         skill_name: Hyphen-case skill name (e.g., 'my-skill').\n71: \n72:     Returns:\n73:         Title-cased string (e.g., 'My Skill').\n74:     \"\"\"\n75:     return ' '.join(word.capitalize() for word in skill_name.split('-'))\n76: \n77: \n78: # ───────────────────────────────────────────────────────────────\n79: # 2. SCAFFOLDING\n80: # ───────────────────────────────────────────────────────────────\n81: \n82: def scaffold_benchmark_tree(skill_dir: Path, skill_name: str) -> None:\n83:     \"\"\"Create the benchmark tree a skill needs before its first measured run.\n84: \n85:     A skill scaffolded without this gets `benchmark/` as a bare empty directory,\n86:     so the first run has nowhere obvious to land and its results end up wherever\n87:     the operator happened to point them. Creating the reports directory and its\n88:     index up front means the first run has a home and a row waiting for it.\n89: \n90:     The reports index is written in the same shape the benchmark harness appends\n91:     to, so a scaffolded index and a harness-written one are the same document.\n92:     \"\"\"\n93:     benchmark_dir = skill_dir / 'benchmark'\n94:     reports_dir = benchmark_dir / 'reports'\n95:     reports_dir.mkdir(parents=True, exist_ok=True)\n96: \n97:     tree_index = (\n98:         '---\\n'\n99:         f'title: \"{skill_name} Benchmark Artifacts\"\\n'\n100:         f'description: \"Benchmark inputs and run reports for {skill_name}, kept beside the skill they measure.\"\\n'\n101:         'trigger_phrases:\\n'\n102:         f'  - \"{skill_name} benchmark\"\\n'\n103:         f'  - \"{skill_name} benchmark artifacts\"\\n'\n104:         'importance_tier: \"important\"\\n'\n105:         'contextType: \"general\"\\n'\n106:         '---\\n'\n107:         '\\n'\n108:         f'# {skill_name} Benchmark Artifacts\\n'\n109:         '\\n'\n110:         f'> Inputs and reports for benchmarking `{skill_name}`, kept beside the skill they measure.\\n'\n111:         '\\n'\n112:         '---\\n'\n113:         '\\n'\n114:         '## 1. OVERVIEW\\n'\n115:         '\\n'\n116:         'TODO describe what this skill is benchmarked on and by which harness.\\n'\n117:         '\\n'\n118:         '## 2. LAYOUT\\n'\n119:         '\\n'\n120:         '| Path | Contents |\\n'\n121:         '|---|---|\\n'\n122:         '| [`reports/`](./reports/) | One folder per run, indexed by `reports/README.md` |\\n'\n123:         '\\n'\n124:         '## 3. RUNNING A BENCHMARK\\n'\n125:         '\\n'\n126:         'The Lane C harness reads this skill\\'s manual-testing playbook as its default corpus and\\n'\n127:         'writes a dated run folder under `reports/`:\\n'\n128:         '\\n'\n129:         '```bash\\n'\n130:         'node .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/run-skill-benchmark.cjs \\\\\\n'\n131:         f'  --skill {skill_name}\\n'\n132:         '```\\n'\n133:     )\n134:     _write_if_absent(benchmark_dir / 'README.md', tree_index)\n135:     _write_if_absent(reports_dir / 'README.md', empty_reports_index(skill_name))\n136: \n137: \n138: def empty_reports_index(skill_name: str) -> str:\n139:     \"\"\"Return the empty run index, matching the harness writer byte for byte.\n140: \n141:     Two writers produce this document: this scaffolder and the benchmark harness\n142:     that appends rows to it. They must agree, or a scaffolded index would gain a\n143:     second table the first time a run recorded itself.\n144:     \"\"\"\n145:     columns = ['Executed', 'Folder', 'Runtime', 'Result', 'Verdict', 'Source']\n146:     header = f\"| {' | '.join(columns)} |\"\n147:     divider = '|' + '|'.join('---' for _ in columns) + '|'\n148:     return '\\n'.join([\n149:         '---',\n150:         f'title: \"{skill_name} Benchmark Reports\"',\n151:         f'description: \"Index of curated benchmark run reports for {skill_name}, one row per run folder.\"',\n152:         'trigger_phrases:',\n153:         f'  - \"{skill_name} benchmark reports\"',\n154:         f'  - \"{skill_name} benchmark index\"',\n155:         'importance_tier: \"important\"',\n156:         'contextType: \"general\"',\n157:         '---',\n158:         '',\n159:         f'# {skill_name} Benchmark Reports',\n160:         '',\n161:         \"> Curated reports derived from completed benchmark runs, newest first. Raw execution evidence stays in the packet that produced it, named in each run's `source.md`.\",\n162:         '',\n163:         '---',\n164:         '',\n165:         '## 1. OVERVIEW',\n166:         '',\n167:         'Each row below is one run folder. Rows are written by the benchmark harness at the moment it writes the report, so this table cannot fall behind the folders beside it.',\n168:         '',\n169:         '## 2. RUN INDEX',\n170:         '',\n171:         header,\n172:         divider,\n173:         '',\n174:         '## 3. STORAGE RULE',\n175:         '',\n176:         'Run folders are named `<YYYY-MM-DD>--<subject>--<variant>`, dated by execution. Keep curated summaries and machine-readable result tables here, and raw transcripts and copied artifacts in the source packet. A run whose result changes gets a new folder rather than overwriting a prior one.',\n177:         '',\n178:         'The grammar and the report file set are owned by `create-benchmark`; this index states them only so the folder reads on its own. Where the two differ, that skill is correct.',\n179:         '',\n180:     ])\n181: \n182: \n183: def scaffold_playbook_tree(skill_dir: Path, skill_name: str) -> None:\n184:     \"\"\"Create the manual-testing-playbook corpus a benchmark run reads.\n185: \n186:     The benchmark tree is scaffolded richly while this one has been created bare\n187:     or not at all, which is the same gap that left benchmark output with nowhere\n188:     obvious to land: a run needs a corpus to read as much as a place to write.\n189:     The index is created empty rather than pre-populated, because inventing\n190:     scenarios would put untested claims in front of the first real one.\n191:     \"\"\"\n192:     playbook_dir = skill_dir / 'manual-testing-playbook'\n193:     playbook_dir.mkdir(parents=True, exist_ok=True)\n194: \n195:     index = '\\n'.join([\n196:         '---',\n197:         f'title: \"{skill_name} Manual Testing Playbook\"',\n198:         f'description: \"Deterministic operator scenarios for {skill_name}, and the corpus its benchmark runs score against.\"',\n199:         'trigger_phrases:',\n200:         f'  - \"{skill_name} manual testing\"',\n201:         f'  - \"{skill_name} playbook\"',\n202:         'importance_tier: \"important\"',\n203:         'contextType: \"general\"',\n204:         '---',\n205:         '',\n206:         f'# {skill_name} Manual Testing Playbook',\n207:         '',\n208:         '> Operator scenarios for this skill. This corpus is an input: a benchmark run reads it and',\n209:         \"> never rewrites it, so a later run can be compared against an earlier one.\",\n210:         '',\n211:         '---',\n212:         '',\n213:         '## 1. OVERVIEW',\n214:         '',\n215:         'TODO state what this playbook covers and what it deliberately leaves to automated tests.',\n216:         '',\n217:         '## 2. SCENARIOS',\n218:         '',\n219:         'TODO add one category folder per area, and one file per feature inside it. Every scenario',\n220:         'needs a deterministic prompt, an expected signal, and a pass or fail criterion another',\n221:         'operator could apply without asking the author what was meant.',\n222:         '',\n223:         '## 3. RESULTS',\n224:         '',\n225:         'Runs land in [`../benchmark/reports/`](../benchmark/reports/), one dated folder each.',\n226:         '`create-manual-testing-playbook` owns the scenario contract and the results-storage rules.',\n227:         '',\n228:     ])\n229:     _write_if_absent(playbook_dir / 'manual-testing-playbook.md', index)\n230: \n231: \n232: def _write_if_absent(target: Path, content: str) -> None:\n233:     \"\"\"Write a scaffold file only when nothing is there, never over real content.\"\"\"\n234:     if not target.exists():\n235:         target.write_text(content, encoding='utf-8')\n236: \n237: \n238: def _ensure_class_gate_fresh(skill_dir: Path, expect_aliases: bool) -> tuple[bool, str]:\n239:     \"\"\"Run the H/S class gate --fix so a scaffolded root is gate-fresh on return.\n240: \n241:     A new root otherwise stays non-conforming until someone runs --fix by hand:\n242:     the generated leaf-manifest.json (both classes) and leaf-aliases.json (S only)\n243:     never exist until then. This runs the same gate an author would, scoped by\n244:     --skill to just this new root, so the write can never touch an unrelated\n245:     sibling root under the same parent directory.\n246:     \"\"\"\n247:     gate = Path(__file__).resolve().parent / \"ci-skill-root-metadata.cjs\"\n248:     try:\n249:         subprocess.run(\n250:             [\n251:                 \"node\", str(gate), \"--fix\",\n252:                 \"--skills-dir\", str(skill_dir.parent),\n253:                 \"--skill\", skill_dir.name,\n254:             ],\n255:             stdout=subprocess.PIPE,\n256:             stderr=subprocess.PIPE,\n257:             text=True,\n258:             check=False,\n259:         )\n260:     except OSError as exc:\n261:         return False, str(exc)\n262: \n263:     required = [\"leaf-manifest.json\"]\n264:     if expect_aliases:\n265:         required.append(\"leaf-aliases.json\")\n266:     missing = [name for name in required if not (skill_dir / name).is_file()]\n267:     if missing:\n268:         return False, f\"class gate did not generate: {', '.join(missing)}\"\n269:     return True, \"\"\n270: \n271: \n272: def init_skill(skill_name: str, path: str) -> Optional[Path]:\n273:     \"\"\"Initialize a new skill directory with template SKILL.md.\n274: \n275:     Args:\n276:         skill_name: Hyphen-case skill name (e.g., 'my-skill').\n277:         path: Parent directory path where skill folder will be created.\n278: \n279:     Returns:\n280:         Path to created skill directory, or None on failure.\n281:     \"\"\"\n282:     is_valid, error_msg = validate_skill_name(skill_name)\n283:     if not is_valid:\n284:         print(f\"❌ Error: {error_msg}\")\n285:         return None\n286: \n287:     skill_dir = Path(path).resolve() / skill_name\n288: \n289:     if skill_dir.exists():\n290:         print(f\"❌ Error: Skill directory already exists: {skill_dir}\")\n291:         return None\n292: \n293:     template_path = (\n294:         Path(__file__).resolve().parent.parent\n295:         / 'assets'\n296:         / 'skill'\n297:         / 'skill-scaffold-template.md'\n298:     )\n299:     try:\n300:         skill_template = template_path.read_text(encoding='utf-8')\n301:     except (OSError, UnicodeError) as exc:\n302:         print(f\"❌ Error reading scaffold template {template_path}: {exc}\")\n303:         return None\n304: \n305:     skill_title = title_case_skill_name(skill_name)\n306:     skill_content = (\n307:         skill_template\n308:         .replace('{{SKILL_NAME}}', skill_name)\n309:         .replace('{{SKILL_TITLE}}', skill_title)\n310:     )\n311:     timestamp = datetime.now(timezone.utc).isoformat()\n312:     graph_metadata = {\n313:         \"schema_version\": 2,\n314:         \"skill_id\": skill_name,\n315:         \"family\": \"sk-util\",\n316:         \"category\": \"utility\",\n317:         \"deprecated\": False,\n318:         \"edges\": {\n319:             \"depends_on\": [],\n320:             \"enhances\": [],\n321:             \"siblings\": [],\n322:             \"conflicts_with\": [],\n323:             \"prerequisite_for\": [],\n324:         },\n325:         \"domains\": [skill_name],\n326:         \"intent_signals\": [\n327:             skill_name,\n328:             f\"{skill_name} skill\",\n329:             f\"{skill_name} workflow\",\n330:             f\"how to use {skill_name}\",\n331:             f\"use {skill_name}\",\n332:             f\"{skill_name} guide\",\n333:             f\"{skill_name} reference\",\n334:             f\"{skill_name} setup\",\n335:         ],\n336:         \"derived\": {\n337:             \"trigger_phrases\": [skill_name],\n338:             \"key_topics\": [skill_name],\n339:             \"key_files\": [f\".opencode/skills/{skill_name}/SKILL.md\"],\n340:             \"entities\": [\n341:                 {\n342:                     \"name\": skill_name,\n343:                     \"kind\": \"skill\",\n344:                     \"path\": f\".opencode/skills/{skill_name}/SKILL.md\",\n345:                     \"source\": \"derived\",\n346:                 }\n347:             ],\n348:             \"source_docs\": [\"SKILL.md\", \"leaf-manifest.config.json\"],\n349:             \"causal_summary\": (\n350:                 f\"{skill_name} standalone skill. Replace this scaffold summary with the \"\n351:                 \"skill's real purpose and its routing/consumer relationships.\"\n352:             ),\n353:             \"created_at\": timestamp,\n354:             \"last_updated_at\": timestamp,\n355:         },\n356:     }\n357:     leaf_manifest_config = {\n358:         \"workflowMode\": skill_name,\n359:         \"packet\": _S_CLASS_CONFIG_DEFAULTS[\"packet\"],\n360:         \"leafRoots\": _S_CLASS_CONFIG_DEFAULTS[\"leafRoots\"],\n361:         \"excludeIndexFiles\": _S_CLASS_CONFIG_DEFAULTS[\"excludeIndexFiles\"],\n362:         \"resourceContractVersion\": _S_CLASS_CONFIG_DEFAULTS[\"resourceContractVersion\"],\n363:         \"_note\": (\n364:             \"Standalone single-mode manifest config. Consumed by \"\n365:             \"generate-leaf-manifest.cjs to emit leaf-manifest.json; \"\n366:             \"leaf-aliases.json is the derived identity projection of that \"\n367:             \"manifest, so regenerate both together via \"\n368:             \"ci-skill-root-metadata.cjs --fix.\"\n369:         ),\n370:     }\n371: \n372:     try:\n373:         skill_dir.mkdir(parents=True, exist_ok=False)\n374:         print(f\"✅ Created skill directory: {skill_dir}\")\n375:     except OSError as exc:\n376:         print(f\"❌ Error creating directory: {exc}\")\n377:         return None\n378: \n379:     scaffold_playbook_tree(skill_dir, skill_name)\n380:     scaffold_benchmark_tree(skill_dir, skill_name)\n381:     print(\"✅ Created manual-testing-playbook/ and benchmark/reports/ with their indexes\")\n382: \n383:     skill_md_path = skill_dir / 'SKILL.md'\n384:     try:\n385:         skill_md_path.write_text(skill_content, encoding='utf-8')\n386:         print(\"✅ Created SKILL.md\")\n387:         with (skill_dir / 'graph-metadata.json').open('w', encoding='utf-8') as handle:\n388:             json.dump(graph_metadata, handle, indent=2)\n389:             handle.write('\\n')\n390:         with (skill_dir / 'leaf-manifest.config.json').open('w', encoding='utf-8') as handle:\n391:             json.dump(leaf_manifest_config, handle, indent=2)\n392:             handle.write('\\n')\n393:         print(\"✅ Created graph-metadata.json and leaf-manifest.config.json\")\n394:     except OSError as exc:\n395:         print(f\"❌ Error creating SKILL.md: {exc}\")\n396:         return None\n397: \n398:     gate_ok, gate_cause = _ensure_class_gate_fresh(skill_dir, expect_aliases=True)\n399:     if not gate_ok:\n400:         print(f\"❌ Class gate fix failed for '{skill_name}': {gate_cause}\")\n401:         return None\n402: \n403:     print(f\"\\n✅ Skill '{skill_name}' initialized successfully at {skill_dir}\")\n404:     print(\"\\nNext steps:\")\n405:     print(\"1. Edit SKILL.md to complete the TODO items and update the description\")\n406:     print(\"2. Add optional references/, assets/, or scripts/ directories as needed\")\n407:     print(\"3. Run the validator when ready to check the skill structure\")\n408: \n409:     return skill_dir\n410: \n411: \n412: def _compiled_manifest_cli() -> Path:\n413:     \"\"\"Return the canonical compiled-routing manifest CLI path.\"\"\"\n414:     return (\n415:         Path(__file__).resolve().parents[4]\n416:         / 'bin'\n417:         / 'compiled-route-manifest.cjs'\n418:     )\n419: \n420: \n421: def _run_manifest_command(\n422:     action: str,\n423:     skill_name: str,\n424:     skill_dir: Path,\n425: ) -> tuple[bool, dict[str, Any], str]:\n426:     \"\"\"Run one canonical manifest command and parse its JSON result.\"\"\"\n427:     command = [\n428:         'node',\n429:         str(_compiled_manifest_cli()),\n430:         action,\n431:         '--hub',\n432:         skill_name,\n433:         '--skill-root',\n434:         str(skill_dir),\n435:     ]\n436:     try:\n437:         result = subprocess.run(\n438:             command,\n439:             stdout=subprocess.PIPE,\n440:             stderr=subprocess.PIPE,\n441:             text=True,\n442:             check=False,\n443:         )\n444:     except OSError as exc:\n445:         return False, {}, str(exc)\n446: \n447:     try:\n448:         payload = json.loads(result.stdout)\n449:     except json.JSONDecodeError:\n450:         detail = result.stderr.strip() or result.stdout.strip() or 'no output'\n451:         return False, {}, f\"invalid manifest CLI output: {detail}\"\n452: \n453:     valid = bool(payload.get('manifestValid'))\n454:     fresh = bool(payload.get('fresh'))\n455:     if result.returncode == 0 and valid and fresh:\n456:         return True, payload, ''\n457: \n458:     cause = payload.get('causeCode') or result.stderr.strip() or 'unknown failure'\n459:     return False, payload, str(cause)\n460: \n461: \n462: def stage1_only_router_content(skill_name: str, skill_title: str) -> str:\n463:     \"\"\"Return the stage1-only root ROUTER.md a fresh parent hub is born with.\n464: \n465:     A new hub owns no second-stage leaf map, so it must not fabricate one:\n466:     both maps, the stage-two default and the hub-shared control list stay empty\n467:     and the document declares `router_state: stage1-only`, delegating all\n468:     routing to stage one (hub-router.json plus mode-registry.json). Promotion\n469:     to `active` is an authored act that fills the maps with concrete,\n470:     resolvable leaf paths; this generator never synthesizes placeholder paths\n471:     or fake intents.\n472:     \"\"\"\n473:     return (\n474:         '---\\n'\n475:         f'title: \"{skill_title} Surface Router — stage-one only\"\\n'\n476:         f'description: \"First-class stage-two control document at the {skill_name} hub root; hub-router.json plus mode-registry.json own mode selection and this leafless router owns no second-stage leaf sets until an author promotes it to active.\"\\n'\n477:         'trigger_phrases:\\n'\n478:         f'  - \"{skill_name} smart routing\"\\n'\n479:         f'  - \"{skill_name} surface router\"\\n'\n480:         f'  - \"{skill_name} leaf routing\"\\n'\n481:         'importance_tier: normal\\n'\n482:         'contextType: general\\n'\n483:         'version: 1.0.0.0\\n'\n484:         'router_state: stage1-only\\n'\n485:         'skill_pointer: SKILL.md\\n'\n486:         '---\\n'\n487:         '\\n'\n488:         f'# {skill_title} Surface Router — stage-one only\\n'\n489:         '\\n'\n490:         f'This is {skill_name}\\'s stage-two control document, first-class at the hub root as\\n'\n491:         '`ROUTER.md`. The hub selects a workflow mode in [`hub-router.json`](hub-router.json);\\n'\n492:         'mode identity lives in [`mode-registry.json`](mode-registry.json). This router\\n'\n493:         'declares `router_state: stage1-only`, so it owns no second-stage leaf selection:\\n'\n494:         'routing delegates entirely to stage one until an author promotes it to `active`\\n'\n495:         'with a concrete `INTENT_SIGNALS` / `RESOURCE_MAP`.\\n'\n496:         '\\n'\n497:         '## 1. MACHINE-READABLE ROUTER\\n'\n498:         '\\n'\n499:         '```python\\n'\n500:         '# Leafless by construction: stage-one mode selection is the whole routing story.\\n'\n501:         'DEFAULT_RESOURCE = []\\n'\n502:         '\\n'\n503:         'INTENT_SIGNALS = {}\\n'\n504:         '\\n'\n505:         'RESOURCE_MAP = {}\\n'\n506:         '\\n'\n507:         'SHARED_CONTROL_RESOURCES = []\\n'\n508:         '```\\n'\n509:         '\\n'\n510:         '## 2. PROMOTION\\n'\n511:         '\\n'\n512:         'Replace `router_state: stage1-only` with `router_state: active` only after\\n'\n513:         'authoring non-empty equal-key `INTENT_SIGNALS` / `RESOURCE_MAP` entries whose\\n'\n514:         'packet-qualified or shared-alias paths resolve on disk and map to typed\\n'\n515:         '`(workflowMode, leafResourceId)` pairs in `leaf-manifest.json`.\\n'\n516:     )\n517: \n518: \n519: def init_parent_skill(\n520:     skill_name: str,\n521:     path: str,\n522:     compiled_routing: str = 'legacy',\n523: ) -> Optional[Path]:\n524:     \"\"\"Initialize a minimal parent skill hub and its primary workflow packet.\"\"\"\n525:     if compiled_routing not in {'legacy', 'ready'}:\n526:         print(\"❌ Error: compiled routing must be 'legacy' or 'ready'\")\n527:         return None\n528: \n529:     is_valid, error_msg = validate_skill_name(skill_name)\n530:     if not is_valid:\n531:         print(f\"❌ Error: {error_msg}\")\n532:         return None\n533: \n534:     skill_dir = Path(path).resolve() / skill_name\n535:     if skill_dir.exists():\n536:         print(f\"❌ Error: Skill directory already exists: {skill_dir}\")\n537:         return None\n538: \n539:     scaffold_dir = (\n540:         Path(__file__).resolve().parent.parent\n541:         / 'assets'\n542:         / 'parent-skill'\n543:         / 'scaffold'\n544:     )\n545:     hub_template_path = scaffold_dir / 'hub-skill-scaffold.md'\n546:     packet_template_path = scaffold_dir / 'packet-skill-scaffold.md'\n547:     try:\n548:         hub_template = hub_template_path.read_text(encoding='utf-8')\n549:         packet_template = packet_template_path.read_text(encoding='utf-8')\n550:     except (OSError, UnicodeError) as exc:\n551:         print(f\"❌ Error reading parent scaffold template: {exc}\")\n552:         return None\n553: \n554:     skill_title = title_case_skill_name(skill_name)\n555:     mode = 'primary'\n556:     packet_name = f'{skill_name}-{mode}'\n557:     packet_title = f'{skill_title} Primary'\n558:     allowed_union = [\"Read\", \"Write\", \"Edit\", \"Bash\", \"Grep\", \"Glob\"]\n559:     allowed_tools = \"[\" + \", \".join(allowed_union) + \"]\"\n560:     timestamp = datetime.now(timezone.utc).isoformat()\n561: \n562:     hub_content = (\n563:         hub_template\n564:         .replace('{{HUB_NAME}}', skill_name)\n565:         .replace('{{ALLOWED_TOOLS}}', allowed_tools)\n566:         .replace('{{HUB_TITLE}}', skill_title)\n567:         .replace('{{MODE}}', mode)\n568:         .replace('{{PACKET}}', packet_name)\n569:     )\n570:     packet_content = (\n571:         packet_template\n572:         .replace('{{PACKET_NAME}}', packet_name)\n573:         .replace('{{PACKET_TITLE}}', packet_title)\n574:         .replace('{{HUB_NAME}}', skill_name)\n575:     )\n576: \n577:     mode_registry = {\n578:         \"skill\": skill_name,\n579:         \"version\": \"1.0.0.0\",\n580:         \"resourceContractVersion\": 1,\n581:         \"modes\": [\n582:             {\n583:                 \"workflowMode\": mode,\n584:                 \"packetKind\": \"workflow\",\n585:                 \"backendKind\": \"skill-workflow\",\n586:                 \"toolSurface\": {\n587:                     \"allowed\": allowed_union,\n588:                     \"forbidden\": [\"Task\"],\n589:                     \"mutatesWorkspace\": True,\n590:                     \"bashAllowlist\": [],\n591:                 },\n592:                 \"packet\": packet_name,\n593:                 \"packetSkillName\": packet_name,\n594:                 \"grandfatheredFolderMismatch\": False,\n595:                 \"aliases\": [packet_name, f\"{skill_name} primary workflow\"],\n596:                 \"advisorRouting\": {\n597:                     \"routingClass\": \"metadata\",\n598:                 },\n599:             }\n600:         ],\n601:     }\n602:     hub_router = {\n603:         \"skill\": skill_name,\n604:         \"version\": \"1.0.0.0\",\n605:         \"routerPolicy\": {\n606:             \"defaultMode\": mode,\n607:             \"ambiguityDelta\": 1,\n608:             \"tieBreak\": [mode],\n609:             \"outcomes\": {\n610:                 \"single\": \"one dominant workflow intent routes to the primary workflow mode\",\n611:                 \"orderedBundle\": \"clearly separate workflow intents route to an ordered workflow mode list\",\n612:                 \"defer\": \"unclear or contradictory intent asks for disambiguation\",\n613:             },\n614:             \"defaultResource\": [f\"{packet_name}/SKILL.md\"],\n615:             \"bundleRules\": [],\n616:         },\n617:         \"routerSignals\": {\n618:             mode: {\n619:                 \"weight\": 4,\n620:                 \"classes\": [\"primary-aliases\", \"hub-identity\"],\n621:                 \"resources\": [f\"{packet_name}/SKILL.md\"],\n622:             }\n623:         },\n624:         \"vocabularyClasses\": {\n625:             \"hub-identity\": {\n626:                 \"keywords\": [\n627:                     skill_name,\n628:                     \"mode-registry\",\n629:                     \"hub-router\",\n630:                     \"workflowmode\",\n631:                     \"packetkind\",\n632:                 ]\n633:             },\n634:             \"primary-aliases\": {\n635:                 \"keywords\": [\"primary\", f\"{skill_name} primary\"]\n636:             },\n637:         },\n638:     }\n639:     graph_metadata = {\n640:         \"schema_version\": 2,\n641:         \"skill_id\": skill_name,\n642:         \"family\": \"sk-hub\",\n643:         \"category\": \"workflow\",\n644:         \"deprecated\": False,\n645:         \"edges\": {\n646:             \"depends_on\": [],\n647:             \"enhances\": [],\n648:             \"siblings\": [],\n649:             \"conflicts_with\": [],\n650:             \"prerequisite_for\": [],\n651:         },\n652:         \"domains\": [\n653:             skill_name,\n654:             \"mode-registry\",\n655:             \"hub-router\",\n656:             \"workflowMode\",\n657:             \"packetKind\",\n658:         ],\n659:         \"intent_signals\": [\n660:             f\"{skill_name} hub\",\n661:             f\"{skill_name} primary workflow\",\n662:             f\"{skill_name} skill\",\n663:             f\"{skill_name} parent skill\",\n664:             f\"{skill_name} mode registry\",\n665:             f\"{skill_name} hub router\",\n666:             f\"use {skill_name}\",\n667:             f\"{skill_name} guide\",\n668:         ],\n669:         \"derived\": {\n670:             \"trigger_phrases\": [skill_name, \"primary\"],\n671:             \"key_topics\": [\n672:                 skill_name,\n673:                 \"mode-registry\",\n674:                 \"hub-router\",\n675:                 \"workflowMode\",\n676:                 \"packetKind\",\n677:             ],\n678:             \"key_files\": [\n679:                 f\".opencode/skills/{skill_name}/SKILL.md\",\n680:                 f\".opencode/skills/{skill_name}/mode-registry.json\",\n681:                 f\".opencode/skills/{skill_name}/hub-router.json\",\n682:             ],\n683:             \"entities\": [\n684:                 {\n685:                     \"name\": skill_name,\n686:                     \"kind\": \"skill\",\n687:                     \"path\": f\".opencode/skills/{skill_name}/SKILL.md\",\n688:                     \"source\": \"derived\",\n689:                 },\n690:                 {\n691:                     \"name\": \"mode-registry\",\n692:                     \"kind\": \"config\",\n693:                     \"path\": f\".opencode/skills/{skill_name}/mode-registry.json\",\n694:                     \"source\": \"derived\",\n695:                 },\n696:             ],\n697:             \"source_docs\": [\n698:                 \"SKILL.md\",\n699:                 \"README.md\",\n700:                 \"mode-registry.json\",\n701:                 \"hub-router.json\",\n702:             ],\n703:             \"causal_summary\": (\n704:                 f\"{skill_name} parent hub. Replace this scaffold summary with the hub's real \"\n705:                 \"purpose and the workflow modes it routes to via mode-registry / hub-router.\"\n706:             ),\n707:             \"created_at\": timestamp,\n708:             \"last_updated_at\": timestamp,\n709:         },\n710:     }\n711:     description = {\n712:         \"name\": skill_name,\n713:         \"description\": (\n714:             \"TODO hub description — routes the primary workflow packet via \"\n715:             \"mode-registry.json.\"\n716:         ),\n717:         \"version\": \"1.0.0.0\",\n718:         \"importance_tier\": \"high\",\n719:         \"keywords\": [skill_name, \"mode-registry\", \"hub-router\", \"primary\"],\n720:         \"trigger_examples\": [\n721:             f\"example request for the {skill_name} primary workflow\"\n722:         ],\n723:         \"lastUpdated\": timestamp,\n724:     }\n725: \n726:     router_content = stage1_only_router_content(skill_name, skill_title)\n727: \n728:     packet_dir = skill_dir / packet_name\n729:     changelog_dir = packet_dir / 'changelog'\n730:     try:\n731:         changelog_dir.mkdir(parents=True, exist_ok=False)\n732:         (skill_dir / 'changelog').mkdir()\n733:         scaffold_playbook_tree(skill_dir, skill_name)\n734:         scaffold_benchmark_tree(skill_dir, skill_name)\n735:         print(f\"✅ Created parent skill directory: {skill_dir}\")\n736: \n737:         (skill_dir / 'ROUTER.md').write_text(router_content, encoding='utf-8')\n738:         (skill_dir / 'SKILL.md').write_text(hub_content, encoding='utf-8')\n739:         (skill_dir / 'README.md').write_text(\n740:             f\"# {skill_title}\\n\\nRouting hub. See SKILL.md and mode-registry.json.\\n\",\n741:             encoding='utf-8',\n742:         )\n743:         with (skill_dir / 'mode-registry.json').open('w', encoding='utf-8') as handle:\n744:             json.dump(mode_registry, handle, indent=2)\n745:             handle.write('\\n')\n746:         with (skill_dir / 'hub-router.json').open('w', encoding='utf-8') as handle:\n747:             json.dump(hub_router, handle, indent=2)\n748:             handle.write('\\n')\n749:         with (skill_dir / 'graph-metadata.json').open('w', encoding='utf-8') as handle:\n750:             json.dump(graph_metadata, handle, indent=2)\n751:             handle.write('\\n')\n752:         with (skill_dir / 'description.json').open('w', encoding='utf-8') as handle:\n753:             json.dump(description, handle, indent=2)\n754:             handle.write('\\n')\n755:         # A fresh hub owns no slash commands, so it ships no command-metadata.json:\n756:         # the file is optional and authored only when the hub gains its first\n757:         # command, at which point the fleet gate validates its entries against the\n758:         # registry and the disk.\n759: \n760:         (packet_dir / 'SKILL.md').write_text(packet_content, encoding='utf-8')\n761:         (packet_dir / 'README.md').write_text(\n762:             f\"# {packet_title}\\n\\nPrimary workflow packet for the {skill_name} hub.\\n\",\n763:             encoding='utf-8',\n764:         )\n765:         (changelog_dir / '1.0.0.0.md').write_text(\n766:             \"# 1.0.0.0 - Initial scaffold\\n\",\n767:             encoding='utf-8',\n768:         )\n769:     except OSError as exc:\n770:         print(f\"❌ Error creating parent skill scaffold: {exc}\")\n771:         return None\n772: \n773:     if compiled_routing == 'ready':\n774:         minted, mint_result, mint_error = _run_manifest_command(\n775:             'mint',\n776:             skill_name,\n777:             skill_dir,\n778:         )\n779:         if not minted:\n780:             manifest_path = mint_result.get('manifestPath', 'UNKNOWN')\n781:             print(\n782:                 \"❌ Compiled routing manifest mint failed; \"\n783:                 f\"legacy fallback retained ({mint_error}, {manifest_path})\"\n784:             )\n785:             return None\n786: \n787:         fresh, freshness_result, freshness_error = _run_manifest_command(\n788:             'freshness',\n789:             skill_name,\n790:             skill_dir,\n791:         )\n792:         if not fresh:\n793:             manifest_path = freshness_result.get(\n794:                 'manifestPath',\n795:                 mint_result.get('manifestPath', 'UNKNOWN'),\n796:             )\n797:             print(\n798:                 \"❌ Compiled routing freshness validation failed; \"\n799:                 f\"legacy fallback retained ({freshness_error}, {manifest_path})\"\n800:             )\n801:             return None\n802: \n803:         print(\n804:             \"✅ Compiled routing: compiled-ready \"\n805:             f\"(fresh manifest verified at {freshness_result['manifestPath']})\"\n806:         )\n807:     else:\n808:         _fresh, manifest_result, manifest_error = _run_manifest_command(\n809:             'freshness',\n810:             skill_name,\n811:             skill_dir,\n812:         )\n813:         if manifest_error != 'missing-manifest':\n814:             manifest_path = manifest_result.get('manifestPath', 'UNKNOWN')\n815:             print(\n816:                 \"❌ Legacy-by-construction requires no canonical manifest; \"\n817:                 f\"reconcile the existing state ({manifest_error}, {manifest_path})\"\n818:             )\n819:             return None\n820:         print(\"✅ Compiled routing: legacy (no manifest)\")\n821: \n822:     gate_ok, gate_cause = _ensure_class_gate_fresh(skill_dir, expect_aliases=False)\n823:     if not gate_ok:\n824:         print(f\"❌ Class gate fix failed for '{skill_name}': {gate_cause}\")\n825:         return None\n826: \n827:     print(f\"\\n✅ Parent skill '{skill_name}' initialized successfully at {skill_dir}\")\n828:     print(\"\\nNext steps:\")\n829:     print(f\"1. Rename or replace the {packet_name} example mode\")\n830:     print(\"2. Fill the TODO descriptions in the hub and packet SKILL.md files\")\n831:     print(\"3. Re-run the completion gate with validate_skill_package.py\")\n832: \n833:     return skill_dir\n834: \n835: \n836: # ───────────────────────────────────────────────────────────────\n837: # 3. MAIN\n838: # ───────────────────────────────────────────────────────────────\n839: \n840: def main() -> None:\n841:     \"\"\"CLI entry point for skill initialization.\"\"\"\n842:     parser = argparse.ArgumentParser(\n843:         description=\"Create a new skill from the sk-doc template.\"\n844:     )\n845:     parser.add_argument(\n846:         'skill_name',\n847:         help=\"Hyphen-case skill name (e.g., my-new-skill)\",\n848:     )\n849:     parser.add_argument(\n850:         '--path',\n851:         required=True,\n852:         help=\"Destination parent directory for the skill\",\n853:     )\n854:     parser.add_argument(\n855:         '--kind',\n856:         choices=['standalone', 'parent'],\n857:         default='standalone',\n858:         help=\"Skill scaffold kind (default: standalone)\",\n859:     )\n860:     parser.add_argument(\n861:         '--compiled-routing',\n862:         choices=['legacy', 'ready'],\n863:         default=None,\n864:         help=(\n865:             \"Parent-hub compiled routing state (default: legacy). 'ready' only mints \"\n866:             \"a fresh activation manifest (generation 1, servingAuthority='legacy', \"\n867:             \"shadowOnly=true) as onboarding evidence -- it does NOT make the hub \"\n868:             \"compiled-serving. The hub still needs its own shadow-child router built \"\n869:             \"to route == legacy and pass Lane C parity before it can join the \"\n870:             \"runtime's compiled-serving cohort; see \"\n871:             \"references/parent-skill/compiled-routing-architecture.md.\"\n872:         ),\n873:     )\n874:     args = parser.parse_args()\n875: \n876:     skill_name = args.skill_name\n877:     path = args.path\n878: \n879:     print(f\"🚀 Initializing skill: {skill_name}\")\n880:     print(f\"   Location: {path}\")\n881:     print()\n882: \n883:     if args.compiled_routing is not None and args.kind != 'parent':\n884:         parser.error('--compiled-routing is only valid with --kind parent')\n885: \n886:     if args.kind == 'parent':\n887:         result = init_parent_skill(\n888:             skill_name,\n889:             path,\n890:             compiled_routing=args.compiled_routing or 'legacy',\n891:         )\n892:     else:\n893:         result = init_skill(skill_name, path)\n894: \n895:     if result:\n896:         sys.exit(0)\n897:     else:\n898:         sys.exit(1)\n899: \n900: \n901: if __name__ == \"__main__\":\n902:     main()\n\n(End of file - total 902 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: SKILL INITIALIZER\n# ───────────────────────────────────────────────────────────────\n\n\"\"\"\nSkill Initializer - Creates a new skill from template\n\nUsage:\n    init_skill.py <skill-name> --path <path>\n\nExamples:\n    init_skill.py my-new-skill --path skills/public\n    init_skill.py my-api-helper --path skills/private\n    init_skill.py custom-skill --path /custom/location\n\"\"\"\n\nimport argparse\nimport json\nimport re","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/skills/sk-doc/sk-create-skill/scripts/init_skill.py","text":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: SKILL INITIALIZER\n# ───────────────────────────────────────────────────────────────\n\n\"\"\"\nSkill Initializer - Creates a new skill from template\n\nUsage:\n    init_skill.py <skill-name> --path <path>\n\nExamples:\n    init_skill.py my-new-skill --path skills/public\n    init_skill.py my-api-helper --path skills/private\n    init_skill.py custom-skill --path /custom/location\n\"\"\"\n\nimport argparse\nimport json\nimport re\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Optional\n\n# Shared S-class config defaults, also read by generate-leaf-manifest.cjs's\n# readStandaloneConfig fallback, so a scaffolded config and that fallback stay\n# in lockstep instead of being two hand-kept-equivalent copies.\n_S_CLASS_CONFIG_DEFAULTS = json.loads(\n    (Path(__file__).resolve().parent / \"lib\" / \"s-class-config-defaults.json\").read_text()\n)\n\n\n# ───────────────────────────────────────────────────────────────\n# 1. VALIDATION\n# ───────────────────────────────────────────────────────────────\n\ndef validate_skill_name(skill_name: str) -> tuple[bool, str]:\n    \"\"\"Validate skill name format (hyphen-case).\n\n    Args:\n        skill_name: The skill name to validate.\n\n    Returns:\n        Tuple of (is_valid, error_message). Error message is empty if valid.\n    \"\"\"\n    if not re.match(r'^[a-z][a-z0-9-]*[a-z0-9]$', skill_name):\n        return False, (\n            f\"Skill name '{skill_name}' must be hyphen-case:\\n\"\n            \"   - Start with a lowercase letter\\n\"\n            \"   - End with a lowercase letter or number\\n\"\n            \"   - Contain only lowercase letters, numbers, and hyphens\\n\"\n            \"   Examples: my-skill, pdf-editor, code-review-v2\"\n        )\n\n    if len(skill_name) > 40:\n        return False, f\"Skill name '{skill_name}' exceeds 40 character limit ({len(skill_name)} chars)\"\n\n    if '--' in skill_name:\n        return False, f\"Skill name '{skill_name}' cannot contain consecutive hyphens (--)\"\n\n    return True, \"\"\n\n\ndef title_case_skill_name(skill_name: str) -> str:\n    \"\"\"Convert hyphenated skill name to Title Case for display.\n\n    Args:\n        skill_name: Hyphen-case skill name (e.g., 'my-skill').\n\n    Returns:\n        Title-cased string (e.g., 'My Skill').\n    \"\"\"\n    return ' '.join(word.capitalize() for word in skill_name.split('-'))\n\n\n# ───────────────────────────────────────────────────────────────\n# 2. SCAFFOLDING\n# ───────────────────────────────────────────────────────────────\n\ndef scaffold_benchmark_tree(skill_dir: Path, skill_name: str) -> None:\n    \"\"\"Create the benchmark tree a skill needs before its first measured run.\n\n    A skill scaffolded without this gets `benchmark/` as a bare empty directory,\n    so the first run has nowhere obvious to land and its results end up wherever\n    the operator happened to point them. Creating the reports directory and its\n    index up front means the first run has a home and a row waiting for it.\n\n    The reports index is written in the same shape the benchmark harness appends\n    to, so a scaffolded index and a harness-written one are the same document.\n    \"\"\"\n    benchmark_dir = skill_dir / 'benchmark'\n    reports_dir = benchmark_dir / 'reports'\n    reports_dir.mkdir(parents=True, exist_ok=True)\n\n    tree_index = (\n        '---\\n'\n        f'title: \"{skill_name} Benchmark Artifacts\"\\n'\n        f'description: \"Benchmark inputs and run reports for {skill_name}, kept beside the skill they measure.\"\\n'\n        'trigger_phrases:\\n'\n        f'  - \"{skill_name} benchmark\"\\n'\n        f'  - \"{skill_name} benchmark artifacts\"\\n'\n        'importance_tier: \"important\"\\n'\n        'contextType: \"general\"\\n'\n        '---\\n'\n        '\\n'\n        f'# {skill_name} Benchmark Artifacts\\n'\n        '\\n'\n        f'> Inputs and reports for benchmarking `{skill_name}`, kept beside the skill they measure.\\n'\n        '\\n'\n        '---\\n'\n        '\\n'\n        '## 1. OVERVIEW\\n'\n        '\\n'\n        'TODO describe what this skill is benchmarked on and by which harness.\\n'\n        '\\n'\n        '## 2. LAYOUT\\n'\n        '\\n'\n        '| Path | Contents |\\n'\n        '|---|---|\\n'\n        '| [`reports/`](./reports/) | One folder per run, indexed by `reports/README.md` |\\n'\n        '\\n'\n        '## 3. RUNNING A BENCHMARK\\n'\n        '\\n'\n        'The Lane C harness reads this skill\\'s manual-testing playbook as its default corpus and\\n'\n        'writes a dated run folder under `reports/`:\\n'\n        '\\n'\n        '```bash\\n'\n        'node .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/run-skill-benchmark.cjs \\\\\\n'\n        f'  --skill {skill_name}\\n'\n        '```\\n'\n    )\n    _write_if_absent(benchmark_dir / 'README.md', tree_index)\n    _write_if_absent(reports_dir / 'README.md', empty_reports_index(skill_name))\n\n\ndef empty_reports_index(skill_name: str) -> str:\n    \"\"\"Return the empty run index, matching the harness writer byte for byte.\n\n    Two writers produce this document: this scaffolder and the benchmark harness\n    that appends rows to it. They must agree, or a scaffolded index would gain a\n    second table the first time a run recorded itself.\n    \"\"\"\n    columns = ['Executed', 'Folder', 'Runtime', 'Result', 'Verdict', 'Source']\n    header = f\"| {' | '.join(columns)} |\"\n    divider = '|' + '|'.join('---' for _ in columns) + '|'\n    return '\\n'.join([\n        '---',\n        f'title: \"{skill_name} Benchmark Reports\"',\n        f'description: \"Index of curated benchmark run reports for {skill_name}, one row per run folder.\"',\n        'trigger_phrases:',\n        f'  - \"{skill_name} benchmark reports\"',\n        f'  - \"{skill_name} benchmark index\"',\n        'importance_tier: \"important\"',\n        'contextType: \"general\"',\n        '---',\n        '',\n        f'# {skill_name} Benchmark Reports',\n        '',\n        \"> Curated reports derived from completed benchmark runs, newest first. Raw execution evidence stays in the packet that produced it, named in each run's `source.md`.\",\n        '',\n        '---',\n        '',\n        '## 1. OVERVIEW',\n        '',\n        'Each row below is one run folder. Rows are written by the benchmark harness at the moment it writes the report, so this table cannot fall behind the folders beside it.',\n        '',\n        '## 2. RUN INDEX',\n        '',\n        header,\n        divider,\n        '',\n        '## 3. STORAGE RULE',\n        '',\n        'Run folders are named `<YYYY-MM-DD>--<subject>--<variant>`, dated by execution. Keep curated summaries and machine-readable result tables here, and raw transcripts and copied artifacts in the source packet. A run whose result changes gets a new folder rather than overwriting a prior one.',\n        '',\n        'The grammar and the report file set are owned by `create-benchmark`; this index states them only so the folder reads on its own. Where the two differ, that skill is correct.',\n        '',\n    ])\n\n\ndef scaffold_playbook_tree(skill_dir: Path, skill_name: str) -> None:\n    \"\"\"Create the manual-testing-playbook corpus a benchmark run reads.\n\n    The benchmark tree is scaffolded richly while this one has been created bare\n    or not at all, which is the same gap that left benchmark output with nowhere\n    obvious to land: a run needs a corpus to read as much as a place to write.\n    The index is created empty rather than pre-populated, because inventing\n    scenarios would put untested claims in front of the first real one.\n    \"\"\"\n    playbook_dir = skill_dir / 'manual-testing-playbook'\n    playbook_dir.mkdir(parents=True, exist_ok=True)\n\n    index = '\\n'.join([\n        '---',\n        f'title: \"{skill_name} Manual Testing Playbook\"',\n        f'description: \"Deterministic operator scenarios for {skill_name}, and the corpus its benchmark runs score against.\"',\n        'trigger_phrases:',\n        f'  - \"{skill_name} manual testing\"',\n        f'  - \"{skill_name} playbook\"',\n        'importance_tier: \"important\"',\n        'contextType: \"general\"',\n        '---',\n        '',\n        f'# {skill_name} Manual Testing Playbook',\n        '',\n        '> Operator scenarios for this skill. This corpus is an input: a benchmark run reads it and',\n        \"> never rewrites it, so a later run can be compared against an earlier one.\",\n        '',\n        '---',\n        '',\n        '## 1. OVERVIEW',\n        '',\n        'TODO state what this playbook covers and what it deliberately leaves to automated tests.',\n        '',\n        '## 2. SCENARIOS',\n        '',\n        'TODO add one category folder per area, and one file per feature inside it. Every scenario',\n        'needs a deterministic prompt, an expected signal, and a pass or fail criterion another',\n        'operator could apply without asking the author what was meant.',\n        '',\n        '## 3. RESULTS',\n        '',\n        'Runs land in [`../benchmark/reports/`](../benchmark/reports/), one dated folder each.',\n        '`create-manual-testing-playbook` owns the scenario contract and the results-storage rules.',\n        '',\n    ])\n    _write_if_absent(playbook_dir / 'manual-testing-playbook.md', index)\n\n\ndef _write_if_absent(target: Path, content: str) -> None:\n    \"\"\"Write a scaffold file only when nothing is there, never over real content.\"\"\"\n    if not target.exists():\n        target.write_text(content, encoding='utf-8')\n\n\ndef _ensure_class_gate_fresh(skill_dir: Path, expect_aliases: bool) -> tuple[bool, str]:\n    \"\"\"Run the H/S class gate --fix so a scaffolded root is gate-fresh on return.\n\n    A new root otherwise stays non-conforming until someone runs --fix by hand:\n    the generated leaf-manifest.json (both classes) and leaf-aliases.json (S only)\n    never exist until then. This runs the same gate an author would, scoped by\n    --skill to just this new root, so the write can never touch an unrelated\n    sibling root under the same parent directory.\n    \"\"\"\n    gate = Path(__file__).resolve().parent / \"ci-skill-root-metadata.cjs\"\n    try:\n        subprocess.run(\n            [\n                \"node\", str(gate), \"--fix\",\n                \"--skills-dir\", str(skill_dir.parent),\n                \"--skill\", skill_dir.name,\n            ],\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=False,\n        )\n    except OSError as exc:\n        return False, str(exc)\n\n    required = [\"leaf-manifest.json\"]\n    if expect_aliases:\n        required.append(\"leaf-aliases.json\")\n    missing = [name for name in required if not (skill_dir / name).is_file()]\n    if missing:\n        return False, f\"class gate did not generate: {', '.join(missing)}\"\n    return True, \"\"\n\n\ndef init_skill(skill_name: str, path: str) -> Optional[Path]:\n    \"\"\"Initialize a new skill directory with template SKILL.md.\n\n    Args:\n        skill_name: Hyphen-case skill name (e.g., 'my-skill').\n        path: Parent directory path where skill folder will be created.\n\n    Returns:\n        Path to created skill directory, or None on failure.\n    \"\"\"\n    is_valid, error_msg = validate_skill_name(skill_name)\n    if not is_valid:\n        print(f\"❌ Error: {error_msg}\")\n        return None\n\n    skill_dir = Path(path).resolve() / skill_name\n\n    if skill_dir.exists():\n        print(f\"❌ Error: Skill directory already exists: {skill_dir}\")\n        return None\n\n    template_path = (\n        Path(__file__).resolve().parent.parent\n        / 'assets'\n        / 'skill'\n        / 'skill-scaffold-template.md'\n    )\n    try:\n        skill_template = template_path.read_text(encoding='utf-8')\n    except (OSError, UnicodeError) as exc:\n        print(f\"❌ Error reading scaffold template {template_path}: {exc}\")\n        return None\n\n    skill_title = title_case_skill_name(skill_name)\n    skill_content = (\n        skill_template\n        .replace('{{SKILL_NAME}}', skill_name)\n        .replace('{{SKILL_TITLE}}', skill_title)\n    )\n    timestamp = datetime.now(timezone.utc).isoformat()\n    graph_metadata = {\n        \"schema_version\": 2,\n        \"skill_id\": skill_name,\n        \"family\": \"sk-util\",\n        \"category\": \"utility\",\n        \"deprecated\": False,\n        \"edges\": {\n            \"depends_on\": [],\n            \"enhances\": [],\n            \"siblings\": [],\n            \"conflicts_with\": [],\n            \"prerequisite_for\": [],\n        },\n        \"domains\": [skill_name],\n        \"intent_signals\": [\n            skill_name,\n            f\"{skill_name} skill\",\n            f\"{skill_name} workflow\",\n            f\"how to use {skill_name}\",\n            f\"use {skill_name}\",\n            f\"{skill_name} guide\",\n            f\"{skill_name} reference\",\n            f\"{skill_name} setup\",\n        ],\n        \"derived\": {\n            \"trigger_phrases\": [skill_name],\n            \"key_topics\": [skill_name],\n            \"key_files\": [f\".opencode/skills/{skill_name}/SKILL.md\"],\n            \"entities\": [\n                {\n                    \"name\": skill_name,\n                    \"kind\": \"skill\",\n                    \"path\": f\".opencode/skills/{skill_name}/SKILL.md\",\n                    \"source\": \"derived\",\n                }\n            ],\n            \"source_docs\": [\"SKILL.md\", \"leaf-manifest.config.json\"],\n            \"causal_summary\": (\n                f\"{skill_name} standalone skill. Replace this scaffold summary with the \"\n                \"skill's real purpose and its routing/consumer relationships.\"\n            ),\n            \"created_at\": timestamp,\n            \"last_updated_at\": timestamp,\n        },\n    }\n    leaf_manifest_config = {\n        \"workflowMode\": skill_name,\n        \"packet\": _S_CLASS_CONFIG_DEFAULTS[\"packet\"],\n        \"leafRoots\": _S_CLASS_CONFIG_DEFAULTS[\"leafRoots\"],\n        \"excludeIndexFiles\": _S_CLASS_CONFIG_DEFAULTS[\"excludeIndexFiles\"],\n        \"resourceContractVersion\": _S_CLASS_CONFIG_DEFAULTS[\"resourceContractVersion\"],\n        \"_note\": (\n            \"Standalone single-mode manifest config. Consumed by \"\n            \"generate-leaf-manifest.cjs to emit leaf-manifest.json; \"\n            \"leaf-aliases.json is the derived identity projection of that \"\n            \"manifest, so regenerate both together via \"\n            \"ci-skill-root-metadata.cjs --fix.\"\n        ),\n    }\n\n    try:\n        skill_dir.mkdir(parents=True, exist_ok=False)\n        print(f\"✅ Created skill directory: {skill_dir}\")\n    except OSError as exc:\n        print(f\"❌ Error creating directory: {exc}\")\n        return None\n\n    scaffold_playbook_tree(skill_dir, skill_name)\n    scaffold_benchmark_tree(skill_dir, skill_name)\n    print(\"✅ Created manual-testing-playbook/ and benchmark/reports/ with their indexes\")\n\n    skill_md_path = skill_dir / 'SKILL.md'\n    try:\n        skill_md_path.write_text(skill_content, encoding='utf-8')\n        print(\"✅ Created SKILL.md\")\n        with (skill_dir / 'graph-metadata.json').open('w', encoding='utf-8') as handle:\n            json.dump(graph_metadata, handle, indent=2)\n            handle.write('\\n')\n        with (skill_dir / 'leaf-manifest.config.json').open('w', encoding='utf-8') as handle:\n            json.dump(leaf_manifest_config, handle, indent=2)\n            handle.write('\\n')\n        print(\"✅ Created graph-metadata.json and leaf-manifest.config.json\")\n    except OSError as exc:\n        print(f\"❌ Error creating SKILL.md: {exc}\")\n        return None\n\n    gate_ok, gate_cause = _ensure_class_gate_fresh(skill_dir, expect_aliases=True)\n    if not gate_ok:\n        print(f\"❌ Class gate fix failed for '{skill_name}': {gate_cause}\")\n        return None\n\n    print(f\"\\n✅ Skill '{skill_name}' initialized successfully at {skill_dir}\")\n    print(\"\\nNext steps:\")\n    print(\"1. Edit SKILL.md to complete the TODO items and update the description\")\n    print(\"2. Add optional references/, assets/, or scripts/ directories as needed\")\n    print(\"3. Run the validator when ready to check the skill structure\")\n\n    return skill_dir\n\n\ndef _compiled_manifest_cli() -> Path:\n    \"\"\"Return the canonical compiled-routing manifest CLI path.\"\"\"\n    return (\n        Path(__file__).resolve().parents[4]\n        / 'bin'\n        / 'compiled-route-manifest.cjs'\n    )\n\n\ndef _run_manifest_command(\n    action: str,\n    skill_name: str,\n    skill_dir: Path,\n) -> tuple[bool, dict[str, Any], str]:\n    \"\"\"Run one canonical manifest command and parse its JSON result.\"\"\"\n    command = [\n        'node',\n        str(_compiled_manifest_cli()),\n        action,\n        '--hub',\n        skill_name,\n        '--skill-root',\n        str(skill_dir),\n    ]\n    try:\n        result = subprocess.run(\n            command,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=False,\n        )\n    except OSError as exc:\n        return False, {}, str(exc)\n\n    try:\n        payload = json.loads(result.stdout)\n    except json.JSONDecodeError:\n        detail = result.stderr.strip() or result.stdout.strip() or 'no output'\n        return False, {}, f\"invalid manifest CLI output: {detail}\"\n\n    valid = bool(payload.get('manifestValid'))\n    fresh = bool(payload.get('fresh'))\n    if result.returncode == 0 and valid and fresh:\n        return True, payload, ''\n\n    cause = payload.get('causeCode') or result.stderr.strip() or 'unknown failure'\n    return False, payload, str(cause)\n\n\ndef stage1_only_router_content(skill_name: str, skill_title: str) -> str:\n    \"\"\"Return the stage1-only root ROUTER.md a fresh parent hub is born with.\n\n    A new hub owns no second-stage leaf map, so it must not fabricate one:\n    both maps, the stage-two default and the hub-shared control list stay empty\n    and the document declares `router_state: stage1-only`, delegating all\n    routing to stage one (hub-router.json plus mode-registry.json). Promotion\n    to `active` is an authored act that fills the maps with concrete,\n    resolvable leaf paths; this generator never synthesizes placeholder paths\n    or fake intents.\n    \"\"\"\n    return (\n        '---\\n'\n        f'title: \"{skill_title} Surface Router — stage-one only\"\\n'\n        f'description: \"First-class stage-two control document at the {skill_name} hub root; hub-router.json plus mode-registry.json own mode selection and this leafless router owns no second-stage leaf sets until an author promotes it to active.\"\\n'\n        'trigger_phrases:\\n'\n        f'  - \"{skill_name} smart routing\"\\n'\n        f'  - \"{skill_name} surface router\"\\n'\n        f'  - \"{skill_name} leaf routing\"\\n'\n        'importance_tier: normal\\n'\n        'contextType: general\\n'\n        'version: 1.0.0.0\\n'\n        'router_state: stage1-only\\n'\n        'skill_pointer: SKILL.md\\n'\n        '---\\n'\n        '\\n'\n        f'# {skill_title} Surface Router — stage-one only\\n'\n        '\\n'\n        f'This is {skill_name}\\'s stage-two control document, first-class at the hub root as\\n'\n        '`ROUTER.md`. The hub selects a workflow mode in [`hub-router.json`](hub-router.json);\\n'\n        'mode identity lives in [`mode-registry.json`](mode-registry.json). This router\\n'\n        'declares `router_state: stage1-only`, so it owns no second-stage leaf selection:\\n'\n        'routing delegates entirely to stage one until an author promotes it to `active`\\n'\n        'with a concrete `INTENT_SIGNALS` / `RESOURCE_MAP`.\\n'\n        '\\n'\n        '## 1. MACHINE-READABLE ROUTER\\n'\n        '\\n'\n        '```python\\n'\n        '# Leafless by construction: stage-one mode selection is the whole routing story.\\n'\n        'DEFAULT_RESOURCE = []\\n'\n        '\\n'\n        'INTENT_SIGNALS = {}\\n'\n        '\\n'\n        'RESOURCE_MAP = {}\\n'\n        '\\n'\n        'SHARED_CONTROL_RESOURCES = []\\n'\n        '```\\n'\n        '\\n'\n        '## 2. PROMOTION\\n'\n        '\\n'\n        'Replace `router_state: stage1-only` with `router_state: active` only after\\n'\n        'authoring non-empty equal-key `INTENT_SIGNALS` / `RESOURCE_MAP` entries whose\\n'\n        'packet-qualified or shared-alias paths resolve on disk and map to typed\\n'\n        '`(workflowMode, leafResourceId)` pairs in `leaf-manifest.json`.\\n'\n    )\n\n\ndef init_parent_skill(\n    skill_name: str,\n    path: str,\n    compiled_routing: str = 'legacy',\n) -> Optional[Path]:\n    \"\"\"Initialize a minimal parent skill hub and its primary workflow packet.\"\"\"\n    if compiled_routing not in {'legacy', 'ready'}:\n        print(\"❌ Error: compiled routing must be 'legacy' or 'ready'\")\n        return None\n\n    is_valid, error_msg = validate_skill_name(skill_name)\n    if not is_valid:\n        print(f\"❌ Error: {error_msg}\")\n        return None\n\n    skill_dir = Path(path).resolve() / skill_name\n    if skill_dir.exists():\n        print(f\"❌ Error: Skill directory already exists: {skill_dir}\")\n        return None\n\n    scaffold_dir = (\n        Path(__file__).resolve().parent.parent\n        / 'assets'\n        / 'parent-skill'\n        / 'scaffold'\n    )\n    hub_template_path = scaffold_dir / 'hub-skill-scaffold.md'\n    packet_template_path = scaffold_dir / 'packet-skill-scaffold.md'\n    try:\n        hub_template = hub_template_path.read_text(encoding='utf-8')\n        packet_template = packet_template_path.read_text(encoding='utf-8')\n    except (OSError, UnicodeError) as exc:\n        print(f\"❌ Error reading parent scaffold template: {exc}\")\n        return None\n\n    skill_title = title_case_skill_name(skill_name)\n    mode = 'primary'\n    packet_name = f'{skill_name}-{mode}'\n    packet_title = f'{skill_title} Primary'\n    allowed_union = [\"Read\", \"Write\", \"Edit\", \"Bash\", \"Grep\", \"Glob\"]\n    allowed_tools = \"[\" + \", \".join(allowed_union) + \"]\"\n    timestamp = datetime.now(timezone.utc).isoformat()\n\n    hub_content = (\n        hub_template\n        .replace('{{HUB_NAME}}', skill_name)\n        .replace('{{ALLOWED_TOOLS}}', allowed_tools)\n        .replace('{{HUB_TITLE}}', skill_title)\n        .replace('{{MODE}}', mode)\n        .replace('{{PACKET}}', packet_name)\n    )\n    packet_content = (\n        packet_template\n        .replace('{{PACKET_NAME}}', packet_name)\n        .replace('{{PACKET_TITLE}}', packet_title)\n        .replace('{{HUB_NAME}}', skill_name)\n    )\n\n    mode_registry = {\n        \"skill\": skill_name,\n        \"version\": \"1.0.0.0\",\n        \"resourceContractVersion\": 1,\n        \"modes\": [\n            {\n                \"workflowMode\": mode,\n                \"packetKind\": \"workflow\",\n                \"backendKind\": \"skill-workflow\",\n                \"toolSurface\": {\n                    \"allowed\": allowed_union,\n                    \"forbidden\": [\"Task\"],\n                    \"mutatesWorkspace\": True,\n                    \"bashAllowlist\": [],\n                },\n                \"packet\": packet_name,\n                \"packetSkillName\": packet_name,\n                \"grandfatheredFolderMismatch\": False,\n                \"aliases\": [packet_name, f\"{skill_name} primary workflow\"],\n                \"advisorRouting\": {\n                    \"routingClass\": \"metadata\",\n                },\n            }\n        ],\n    }\n    hub_router = {\n        \"skill\": skill_name,\n        \"version\": \"1.0.0.0\",\n        \"routerPolicy\": {\n            \"defaultMode\": mode,\n            \"ambiguityDelta\": 1,\n            \"tieBreak\": [mode],\n            \"outcomes\": {\n                \"single\": \"one dominant workflow intent routes to the primary workflow mode\",\n                \"orderedBundle\": \"clearly separate workflow intents route to an ordered workflow mode list\",\n                \"defer\": \"unclear or contradictory intent asks for disambiguation\",\n            },\n            \"defaultResource\": [f\"{packet_name}/SKILL.md\"],\n            \"bundleRules\": [],\n        },\n        \"routerSignals\": {\n            mode: {\n                \"weight\": 4,\n                \"classes\": [\"primary-aliases\", \"hub-identity\"],\n                \"resources\": [f\"{packet_name}/SKILL.md\"],\n            }\n        },\n        \"vocabularyClasses\": {\n            \"hub-identity\": {\n                \"keywords\": [\n                    skill_name,\n                    \"mode-registry\",\n                    \"hub-router\",\n                    \"workflowmode\",\n                    \"packetkind\",\n                ]\n            },\n            \"primary-aliases\": {\n                \"keywords\": [\"primary\", f\"{skill_name} primary\"]\n            },\n        },\n    }\n    graph_metadata = {\n        \"schema_version\": 2,\n        \"skill_id\": skill_name,\n        \"family\": \"sk-hub\",\n        \"category\": \"workflow\",\n        \"deprecated\": False,\n        \"edges\": {\n            \"depends_on\": [],\n            \"enhances\": [],\n            \"siblings\": [],\n            \"conflicts_with\": [],\n            \"prerequisite_for\": [],\n        },\n        \"domains\": [\n            skill_name,\n            \"mode-registry\",\n            \"hub-router\",\n            \"workflowMode\",\n            \"packetKind\",\n        ],\n        \"intent_signals\": [\n            f\"{skill_name} hub\",\n            f\"{skill_name} primary workflow\",\n            f\"{skill_name} skill\",\n            f\"{skill_name} parent skill\",\n            f\"{skill_name} mode registry\",\n            f\"{skill_name} hub router\",\n            f\"use {skill_name}\",\n            f\"{skill_name} guide\",\n        ],\n        \"derived\": {\n            \"trigger_phrases\": [skill_name, \"primary\"],\n            \"key_topics\": [\n                skill_name,\n                \"mode-registry\",\n                \"hub-router\",\n                \"workflowMode\",\n                \"packetKind\",\n            ],\n            \"key_files\": [\n                f\".opencode/skills/{skill_name}/SKILL.md\",\n                f\".opencode/skills/{skill_name}/mode-registry.json\",\n                f\".opencode/skills/{skill_name}/hub-router.json\",\n            ],\n            \"entities\": [\n                {\n                    \"name\": skill_name,\n                    \"kind\": \"skill\",\n                    \"path\": f\".opencode/skills/{skill_name}/SKILL.md\",\n                    \"source\": \"derived\",\n                },\n                {\n                    \"name\": \"mode-registry\",\n                    \"kind\": \"config\",\n                    \"path\": f\".opencode/skills/{skill_name}/mode-registry.json\",\n                    \"source\": \"derived\",\n                },\n            ],\n            \"source_docs\": [\n                \"SKILL.md\",\n                \"README.md\",\n                \"mode-registry.json\",\n                \"hub-router.json\",\n            ],\n            \"causal_summary\": (\n                f\"{skill_name} parent hub. Replace this scaffold summary with the hub's real \"\n                \"purpose and the workflow modes it routes to via mode-registry / hub-router.\"\n            ),\n            \"created_at\": timestamp,\n            \"last_updated_at\": timestamp,\n        },\n    }\n    description = {\n        \"name\": skill_name,\n        \"description\": (\n            \"TODO hub description — routes the primary workflow packet via \"\n            \"mode-registry.json.\"\n        ),\n        \"version\": \"1.0.0.0\",\n        \"importance_tier\": \"high\",\n        \"keywords\": [skill_name, \"mode-registry\", \"hub-router\", \"primary\"],\n        \"trigger_examples\": [\n            f\"example request for the {skill_name} primary workflow\"\n        ],\n        \"lastUpdated\": timestamp,\n    }\n\n    router_content = stage1_only_router_content(skill_name, skill_title)\n\n    packet_dir = skill_dir / packet_name\n    changelog_dir = packet_dir / 'changelog'\n    try:\n        changelog_dir.mkdir(parents=True, exist_ok=False)\n        (skill_dir / 'changelog').mkdir()\n        scaffold_playbook_tree(skill_dir, skill_name)\n        scaffold_benchmark_tree(skill_dir, skill_name)\n        print(f\"✅ Created parent skill directory: {skill_dir}\")\n\n        (skill_dir / 'ROUTER.md').write_text(router_content, encoding='utf-8')\n        (skill_dir / 'SKILL.md').write_text(hub_content, encoding='utf-8')\n        (skill_dir / 'README.md').write_text(\n            f\"# {skill_title}\\n\\nRouting hub. See SKILL.md and mode-registry.json.\\n\",\n            encoding='utf-8',\n        )\n        with (skill_dir / 'mode-registry.json').open('w', encoding='utf-8') as handle:\n            json.dump(mode_registry, handle, indent=2)\n            handle.write('\\n')\n        with (skill_dir / 'hub-router.json').open('w', encoding='utf-8') as handle:\n            json.dump(hub_router, handle, indent=2)\n            handle.write('\\n')\n        with (skill_dir / 'graph-metadata.json').open('w', encoding='utf-8') as handle:\n            json.dump(graph_metadata, handle, indent=2)\n            handle.write('\\n')\n        with (skill_dir / 'description.json').open('w', encoding='utf-8') as handle:\n            json.dump(description, handle, indent=2)\n            handle.write('\\n')\n        # A fresh hub owns no slash commands, so it ships no command-metadata.json:\n        # the file is optional and authored only when the hub gains its first\n        # command, at which point the fleet gate validates its entries against the\n        # registry and the disk.\n\n        (packet_dir / 'SKILL.md').write_text(packet_content, encoding='utf-8')\n        (packet_dir / 'README.md').write_text(\n            f\"# {packet_title}\\n\\nPrimary workflow packet for the {skill_name} hub.\\n\",\n            encoding='utf-8',\n        )\n        (changelog_dir / '1.0.0.0.md').write_text(\n            \"# 1.0.0.0 - Initial scaffold\\n\",\n            encoding='utf-8',\n        )\n    except OSError as exc:\n        print(f\"❌ Error creating parent skill scaffold: {exc}\")\n        return None\n\n    if compiled_routing == 'ready':\n        minted, mint_result, mint_error = _run_manifest_command(\n            'mint',\n            skill_name,\n            skill_dir,\n        )\n        if not minted:\n            manifest_path = mint_result.get('manifestPath', 'UNKNOWN')\n            print(\n                \"❌ Compiled routing manifest mint failed; \"\n                f\"legacy fallback retained ({mint_error}, {manifest_path})\"\n            )\n            return None\n\n        fresh, freshness_result, freshness_error = _run_manifest_command(\n            'freshness',\n            skill_name,\n            skill_dir,\n        )\n        if not fresh:\n            manifest_path = freshness_result.get(\n                'manifestPath',\n                mint_result.get('manifestPath', 'UNKNOWN'),\n            )\n            print(\n                \"❌ Compiled routing freshness validation failed; \"\n                f\"legacy fallback retained ({freshness_error}, {manifest_path})\"\n            )\n            return None\n\n        print(\n            \"✅ Compiled routing: compiled-ready \"\n            f\"(fresh manifest verified at {freshness_result['manifestPath']})\"\n        )\n    else:\n        _fresh, manifest_result, manifest_error = _run_manifest_command(\n            'freshness',\n            skill_name,\n            skill_dir,\n        )\n        if manifest_error != 'missing-manifest':\n            manifest_path = manifest_result.get('manifestPath', 'UNKNOWN')\n            print(\n                \"❌ Legacy-by-construction requires no canonical manifest; \"\n                f\"reconcile the existing state ({manifest_error}, {manifest_path})\"\n            )\n            return None\n        print(\"✅ Compiled routing: legacy (no manifest)\")\n\n    gate_ok, gate_cause = _ensure_class_gate_fresh(skill_dir, expect_aliases=False)\n    if not gate_ok:\n        print(f\"❌ Class gate fix failed for '{skill_name}': {gate_cause}\")\n        return None\n\n    print(f\"\\n✅ Parent skill '{skill_name}' initialized successfully at {skill_dir}\")\n    print(\"\\nNext steps:\")\n    print(f\"1. Rename or replace the {packet_name} example mode\")\n    print(\"2. Fill the TODO descriptions in the hub and packet SKILL.md files\")\n    print(\"3. Re-run the completion gate with validate_skill_package.py\")\n\n    return skill_dir\n\n\n# ───────────────────────────────────────────────────────────────\n# 3. MAIN\n# ───────────────────────────────────────────────────────────────\n\ndef main() -> None:\n    \"\"\"CLI entry point for skill initialization.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Create a new skill from the sk-doc template.\"\n    )\n    parser.add_argument(\n        'skill_name',\n        help=\"Hyphen-case skill name (e.g., my-new-skill)\",\n    )\n    parser.add_argument(\n        '--path',\n        required=True,\n        help=\"Destination parent directory for the skill\",\n    )\n    parser.add_argument(\n        '--kind',\n        choices=['standalone', 'parent'],\n        default='standalone',\n        help=\"Skill scaffold kind (default: standalone)\",\n    )\n    parser.add_argument(\n        '--compiled-routing',\n        choices=['legacy', 'ready'],\n        default=None,\n        help=(\n            \"Parent-hub compiled routing state (default: legacy). 'ready' only mints \"\n            \"a fresh activation manifest (generation 1, servingAuthority='legacy', \"\n            \"shadowOnly=true) as onboarding evidence -- it does NOT make the hub \"\n            \"compiled-serving. The hub still needs its own shadow-child router built \"\n            \"to route == legacy and pass Lane C parity before it can join the \"\n            \"runtime's compiled-serving cohort; see \"\n            \"references/parent-skill/compiled-routing-architecture.md.\"\n        ),\n    )\n    args = parser.parse_args()\n\n    skill_name = args.skill_name\n    path = args.path\n\n    print(f\"🚀 Initializing skill: {skill_name}\")\n    print(f\"   Location: {path}\")\n    print()\n\n    if args.compiled_routing is not None and args.kind != 'parent':\n        parser.error('--compiled-routing is only valid with --kind parent')\n\n    if args.kind == 'parent':\n        result = init_parent_skill(\n            skill_name,\n            path,\n            compiled_routing=args.compiled_routing or 'legacy',\n        )\n    else:\n        result = init_skill(skill_name, path)\n\n    if result:\n        sys.exit(0)\n    else:\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()","lineStart":1,"lineEnd":902,"totalLines":902,"truncated":false}},"title":".opencode/skills/sk-doc/sk-create-skill/scripts/init_skill.py","time":{"start":1786890605290,"end":1786890605294}},"id":"prt_00afad19f001cG9r9XOj7rZo2i","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","messageID":"msg_00afaba3c001ytmndaP3KCHw6h"}}
