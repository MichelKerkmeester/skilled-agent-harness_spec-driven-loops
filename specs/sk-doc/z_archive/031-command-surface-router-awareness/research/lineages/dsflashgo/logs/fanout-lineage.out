n(routerPath);\n\n  Line 817:       pass('5a: hub-router.json exists and parses as JSON');\n\n  Line 819:       softFail(`5a: hub-router.json is not valid JSON: ${e.message}`);\n\n  Line 821:     if (router) {\n\n  Line 822:       const signals = router.routerSignals && typeof router.routerSignals === 'object' ? router.routerSignals : {};\n\n  Line 823:       const subworkflowSignals = router.commandSubworkflowSignals && typeof router.commandSubworkflowSignals === 'object'\n\n  Line 824:         ? router.commandSubworkflowSignals\n\n  Line 826:       const classes = router.vocabularyClasses && typeof router.vocabularyClasses === 'object' ? router.vocabularyClasses : {};\n\n  Line 829:       // 5b — routerSignals keys ↔ registry workflowModes, bidirectional.\n\n  Line 833:         pass(`5b: routerSignals keys match the registry workflowMode set (${signalKeys.size})`);\n\n  Line 835:         softFail(`5b: routerSignals ↔ registry mismatch — missing signals for [${missingSignals.join(', ') || 'none'}], stray signals [${straySignals.join(', ') || 'none'}]`);\n\n  Line 850:         softFail(`5c: routerSignals reference undefined vocabulary class(es): [${missingClasses.join(', ')}]`);\n\n  Line 865:       for (const r of (router.routerPolicy && Array.isArray(router.routerPolicy.defaultResource) ? router.routerPolicy.defaultResource : [])) {\n\n  Line 869:         pass('5d: every router resource path resolves on disk');\n\n  Line 871:         softFail(`5d: router resource path(s) missing on disk: [${[...new Set(missingResources)].join(', ')}]`);\n\n  Line 875:       const tieBreak = router.routerPolicy && Array.isArray(router.routerPolicy.tieBreak) ? router.routerPolicy.tieBreak : [];\n\n  Line 883:         pass('5e: routerPolicy.tieBreak covers every registered mode');\n\n  Line 885:         softFail(`5e: routerPolicy.tieBreak is not an exact permutation of registry modes — extras: [${tieExtras.join(', ') || 'none'}], duplicates: [${tieDuplicates.join(', ') || 'none'}], m