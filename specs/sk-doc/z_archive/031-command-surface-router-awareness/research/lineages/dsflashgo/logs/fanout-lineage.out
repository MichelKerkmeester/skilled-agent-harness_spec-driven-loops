{"type":"tool_use","timestamp":1786890720426,"sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","part":{"type":"tool","tool":"read","callID":"call_00_2b5wG0pdNQPKcImHM2Te5734","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/doctor/_routes.yaml"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/doctor/_routes.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n3: # ─────────────────────────────────────────────────────────────────\n4: # Source of truth for /doctor <target> dispatch.\n5: # Read by: .opencode/commands/doctor/speckit.md (the router)\n6: # Validated by: .opencode/commands/doctor/scripts/route-validate.sh\n7: # Consumed by: NOT currently harvested by either Skill Advisor implementation.\n8: #   Both harvesters (Python skill_advisor.py:810-871 _DOC_HARVEST_SUBDIRS =\n9: #   (\"references\",\"assets\") rooted at SKILLS_DIR; TS doc-frontmatter.ts:23)\n10: #   walk only .opencode/skills/*/{references,assets}/*.md frontmatter — a\n11: #   .yaml file under .opencode/commands/doctor/ is out of scope by both file\n12: #   type and root. /doctor <target> dispatch is presentation-menu/argv-driven\n13: #   (see speckit.md), not advisor-driven. The trigger_phrases field below is\n14: #   retained for a possible future doctor-routes harvester but is inert today.\n15: #\n16: # Schema (per route):\n17: #   target:           string — positional name the user types\n18: #   yaml:             string — YAML asset filename in assets/\n19: #   setup_vars:       list   — variables the router resolves and passes to YAML\n20: #   allowed_flags:    list   — per-target flag schema (target-first parsing)\n21: #   mutating:         enum   — read-only | add-only | mutates\n22: #   gate3_location:   string — concrete mutation target (or \"n/a\" for read-only)\n23: #   mcp_tools:        list   — subset of router's frontmatter allowed-tools union\n24: #   trigger_phrases:  list   — descriptive routing phrases for this target; not\n25: #                              currently harvested by advisor (see \"Consumed by\" above)\n26: #\n27: # Skill-advisor recommendation tools are registered through mk-skill-advisor.\n28: # To add a new target: append a route here, then re-run route-validate.sh.\n29: # To remove a target: delete the route AND its corresponding assets/doctor_<target>.yaml.\n30: # ─────────────────────────────────────────────────────────────────\n31: schema_version: 1\n32: routes:\n33:   - target: memory\n34:     yaml: doctor-memory.yaml\n35:     setup_vars: [execution_mode, intent, incremental]\n36:     allowed_flags: [\"--incremental=true|false\"]\n37:     mutating: add-only\n38:     gate3_location: \"<packet_scratch>/doctor-memory-report.<timestamp>.md + <packet_scratch>/doctor-memory-state.<timestamp>.json\"\n39:     mcp_tools:\n40:       - mcp__mk_spec_memory__memory_health\n41:       - mcp__mk_spec_memory__memory_drift_why\n42:       - mcp__mk_spec_memory__memory_search\n43:       - mcp__mk_spec_memory__memory_stats\n44:     script_invocations:\n45:       - 'Warm-only: probe the existing mk-spec-memory IPC socket first; only when it answers, run node .opencode/bin/spec-memory.cjs memory_health --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n46:     trigger_phrases:\n47:       - \"memory continuity index drift\"\n48:       - \"memory health rebuild\"\n49:       - \"context-index doctor\"\n50:       - \"voyage embedding rebuild\"\n51: \n52:   - target: embeddings\n53:     yaml: doctor-embeddings.yaml\n54:     setup_vars: [execution_mode]\n55:     allowed_flags: []\n56:     mutating: read-only\n57:     gate3_location: \"n/a (read-only provider and model-server status)\"\n58:     mcp_tools:\n59:       - mcp__mk_spec_memory__embedder_status\n60:     trigger_phrases:\n61:       - \"embedding provider status\"\n62:       - \"hf-local model-server health\"\n63:       - \"embedder_status diagnostics\"\n64: \n65:   - target: causal-graph\n66:     yaml: doctor-causal-graph.yaml\n67:     setup_vars: [execution_mode, intent, confidence_threshold]\n68:     allowed_flags: [\"--confidence-threshold=N\"]\n69:     mutating: add-only\n70:     gate3_location: \"<packet_scratch>/doctor-causal-graph-state.<timestamp>.json\"\n71:     mcp_tools:\n72:       - mcp__mk_spec_memory__memory_causal_stats\n73:       - mcp__mk_spec_memory__memory_drift_why\n74:       - mcp__mk_spec_memory__memory_search\n75:     trigger_phrases:\n76:       - \"causal edges drift\"\n77:       - \"causal graph doctor\"\n78:       - \"lineage coverage\"\n79:       - \"memory_causal_stats\"\n80: \n81: \n82:   - target: deep-loop\n83:     yaml: doctor-deep-loop.yaml\n84:     setup_vars: [execution_mode, intent, scope]\n85:     allowed_flags: [\"--scope=research|review|council|both|all\"]\n86:     mutating: add-only\n87:     gate3_location: \"<packet_scratch>/doctor-deep-loop-state.<timestamp>.json\"\n88:     mcp_tools: []\n89:     script_invocations:\n90:       - 'node .opencode/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\"'\n91:       - 'node .opencode/skills/system-deep-loop/runtime/scripts/query.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --query-type \"{query_type}\"'\n92:       - 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\"'\n93:     trigger_phrases:\n94:       - \"deep-loop coverage\"\n95:       - \"deep-loop graph rebuild\"\n96:       - \"deep-research convergence drift\"\n97:       - \"deep-review iteration graph\"\n98: \n99:   - target: skill-advisor\n100:     yaml: doctor-skill-advisor.yaml\n101:     setup_vars: [execution_mode, scope, skip_tests, dry_run]\n102:     allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n103:     mutating: mutates\n104:     gate3_location: \"lib/scorer/lanes/*.ts + .opencode/skills/*/graph-metadata.json\"\n105:     mcp_tools:\n106:       - mcp__mk_skill_advisor__advisor_recommend\n107:       - mcp__mk_skill_advisor__advisor_status\n108:       - mcp__mk_skill_advisor__advisor_validate\n109:       - mcp__mk_skill_advisor__advisor_rebuild\n110:       - mcp__mk_skill_advisor__skill_graph_scan\n111:       - mcp__mk_skill_advisor__skill_graph_validate\n112:       - mcp__mk_skill_advisor__skill_graph_query\n113:       - mcp__mk_skill_advisor__skill_graph_status\n114:       - mcp__mk_spec_memory__memory_context\n115:       - mcp__mk_spec_memory__memory_search\n116:     script_invocations:\n117:       - 'Warm-only: probe the existing mk-skill-advisor IPC socket first; only when it answers, run node .opencode/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n118:     trigger_phrases:\n119:       - \"skill advisor scoring\"\n120:       - \"skill advisor rebuild\"\n121:       - \"advisor recommendation tuning\"\n122:       - \"skill_graph scan\"\n123: \n124:   - target: skill-budget\n125:     yaml: doctor-skill-budget.yaml\n126:     setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n127:     allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n128:     mutating: read-only\n129:     gate3_location: \"n/a (read-only audit; no spec folder required)\"\n130:     mcp_tools: []   # script-only audit; no MCP calls\n131:     script_invocations:\n132:       - 'Warm-only: probe the existing mk-skill-advisor IPC socket first; only when it answers, run node .opencode/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n133:     trigger_phrases:\n134:       - \"skill budget audit\"\n135:       - \"description budget check\"\n136:       - \"skill char count drift\"\n137:       - \"frontmatter description trim\"\n138: \n139:   - target: parent-skill\n140:     yaml: doctor-parent-skill.yaml\n141:     setup_vars: [execution_mode, parent_skill_dir]\n142:     allowed_flags: [\"--dir=<path>\"]\n143:     mutating: read-only\n144:     gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n145:     mcp_tools: []   # script-only structural audit; no MCP calls\n146:     script_invocations:\n147:       # The fleet class gate runs first: it starts from SKILL.md, so it is the only\n148:       # check that can report a metadata file a root never wrote. The per-hub audit\n149:       # then goes deep on the one directory the operator named.\n150:       - 'node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs'\n151:       - 'node .opencode/commands/doctor/scripts/parent-skill-check.cjs \"{parent_skill_dir}\"'\n152:     trigger_phrases:\n153:       - \"parent skill structure audit\"\n154:       - \"nested mode packet check\"\n155:       - \"mode-registry drift guard\"\n156:       - \"single graph-metadata identity\"\n157:       - \"skill root metadata contract\"\n158:       - \"missing skill json files\"\n159: \n160:   - target: skill-graph-freshness\n161:     yaml: doctor-skill-graph-freshness.yaml\n162:     setup_vars: [execution_mode]\n163:     allowed_flags: []\n164:     mutating: read-only\n165:     gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n166:     mcp_tools: []   # script-only read; no MCP calls\n167:     script_invocations:\n168:       - 'node .opencode/commands/doctor/scripts/skill-graph-freshness.cjs'\n169:     trigger_phrases:\n170:       - \"skill graph freshness\"\n171:       - \"skill-graph zombie ghost nodes\"\n172:       - \"compiled vs sqlite vs disk graph drift\"\n173:       - \"reindex staleness check\"\n174: \n175:   - target: fable-mode\n176:     yaml: doctor-fable-mode.yaml\n177:     setup_vars: [execution_mode, target_dir]\n178:     allowed_flags: [\"--dir=<path>\", \"--baseline=<path>\"]\n179:     mutating: read-only\n180:     gate3_location: \"n/a (read-only behavioral-metric diagnostic; reads deep-loop state + iteration markdown + baseline snapshot, writes no files)\"\n181:     mcp_tools: []   # script-only behavioral-metric read; no MCP calls\n182:     script_invocations:\n183:       - 'node .opencode/commands/doctor/scripts/fable-mode-check.cjs --dir \"{target_dir}\"'\n184:     trigger_phrases:\n185:       - \"fable-5 behavioral metrics\"\n186:       - \"fable mode efficiency check\"\n187:       - \"tool text ratio diagnostic\"\n188:       - \"result-first opener metric\"\n189: \n190:   - target: runtime-mirrors\n191:     yaml: doctor-runtime-mirrors.yaml\n192:     setup_vars: [execution_mode]\n193:     allowed_flags: []\n194:     mutating: read-only\n195:     gate3_location: \"n/a (read-only mirror-parity diagnostic; every checker runs in its check-only form and writes nothing)\"\n196:     mcp_tools: []   # script-only mirror parity read; no MCP calls\n197:     script_invocations:\n198:       - 'node .opencode/skills/system-spec-kit/scripts/runtime-mirrors/sync-runtime-mirrors.cjs --check'\n199:       - 'node .opencode/skills/system-spec-kit/scripts/codex/sync-agents.cjs --check'\n200:       - 'node .opencode/skills/system-spec-kit/scripts/codex/sync-prompts.cjs --check'\n201:       - 'node .opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n202:       - 'node .opencode/bin/install-codex-hooks.mjs --check'\n203:     trigger_phrases:\n204:       - \"runtime mirror drift\"\n205:       - \"agent command mirror parity\"\n206:       - \"cursor devin codex sync check\"\n207:       - \"discovery mirror out of sync\"\n208: \n209: # ─────────────────────────────────────────────────────────────────\n210: # COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n211: # ─────────────────────────────────────────────────────────────────\n212: # /doctor:mcp dispatches via its own command (.opencode/commands/doctor/mcp.md).\n213: # These rows are tracked here for advisor + CI visibility only — the mcp.md\n214: # command parses its own sub-action argv and dispatches to the right YAML.\n215: # ─────────────────────────────────────────────────────────────────\n216: mcp_subroutes:\n217:   - sub_action: install\n218:     yaml: doctor-mcp-install.yaml\n219:     allowed_flags: [\"--server <name>\", \"--runtime <name>\"]\n220:     mutating: mutates\n221:     gate3_location: \"MCP server install dirs + runtime config (.opencode.json / .claude/settings.json / )\"\n222:     trigger_phrases:\n223:       - \"MCP install\"\n224:       - \"MCP server fresh install\"\n225:       - \"reinstall MCP\"\n226: \n227:   - sub_action: debug\n228:     yaml: doctor-mcp-debug.yaml\n229:     allowed_flags: [\"--fix\", \"--server <name>\"]\n230:     mutating: mutates\n231:     gate3_location: \"MCP server logs + runtime config repair\"\n232:     trigger_phrases:\n233:       - \"MCP server broken\"\n234:       - \"MCP debug\"\n235:       - \"MCP connection failure\"\n236:       - \"mcp-doctor.sh\"\n237: \n238: # ─────────────────────────────────────────────────────────────────\n239: # ORCHESTRATOR (NOT routed through /doctor — kept here for reference)\n240: # ─────────────────────────────────────────────────────────────────\n241: # /doctor:update is a STANDALONE command at .opencode/commands/doctor/update.md.\n242: # It does NOT route through /doctor. This block exists for advisor visibility.\n243: # ─────────────────────────────────────────────────────────────────\n244: standalone:\n245:   - command: /doctor:update\n246:     file: .opencode/commands/doctor/update.md\n247:     yaml: doctor-update.yaml\n248:     mutating: mutates\n249:     trigger_phrases:\n250:       - \"spec-kit version migration\"\n251:       - \"doctor update orchestrator\"\n252:       - \"rebuild all spec-kit databases\"\n253:       - \"doctor full sync\"\n\n(End of file - total 253 lines)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n# ─────────────────────────────────────────────────────────────────\n# Source of truth for /doctor <target> dispatch.\n# Read by: .opencode/commands/doctor/speckit.md (the router)\n# Validated by: .opencode/commands/doctor/scripts/route-validate.sh\n# Consumed by: NOT currently harvested by either Skill Advisor implementation.\n#   Both harvesters (Python skill_advisor.py:810-871 _DOC_HARVEST_SUBDIRS =\n#   (\"references\",\"assets\") rooted at SKILLS_DIR; TS doc-frontmatter.ts:23)\n#   walk only .opencode/skills/*/{references,assets}/*.md frontmatter — a\n#   .yaml file under .opencode/commands/doctor/ is out of scope by both file\n#   type and root. /doctor <target> dispatch is presentation-menu/argv-driven\n#   (see speckit.md), not advisor-driven. The trigger_phrases field below is\n#   retained for a possible future doctor-routes harvester but is inert today.\n#\n# Schema (per route):\n#   target:           string — positional name the user types\n#   yaml:             string — YAML asset filename in assets/\n#   setup_vars:       list   — variables the router resolves and passes to YAML\n#   allowed_flags:    list   — per-target flag schema (target-first parsing)","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/010-root-router-document-standard/.opencode/commands/doctor/_routes.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n# ─────────────────────────────────────────────────────────────────\n# Source of truth for /doctor <target> dispatch.\n# Read by: .opencode/commands/doctor/speckit.md (the router)\n# Validated by: .opencode/commands/doctor/scripts/route-validate.sh\n# Consumed by: NOT currently harvested by either Skill Advisor implementation.\n#   Both harvesters (Python skill_advisor.py:810-871 _DOC_HARVEST_SUBDIRS =\n#   (\"references\",\"assets\") rooted at SKILLS_DIR; TS doc-frontmatter.ts:23)\n#   walk only .opencode/skills/*/{references,assets}/*.md frontmatter — a\n#   .yaml file under .opencode/commands/doctor/ is out of scope by both file\n#   type and root. /doctor <target> dispatch is presentation-menu/argv-driven\n#   (see speckit.md), not advisor-driven. The trigger_phrases field below is\n#   retained for a possible future doctor-routes harvester but is inert today.\n#\n# Schema (per route):\n#   target:           string — positional name the user types\n#   yaml:             string — YAML asset filename in assets/\n#   setup_vars:       list   — variables the router resolves and passes to YAML\n#   allowed_flags:    list   — per-target flag schema (target-first parsing)\n#   mutating:         enum   — read-only | add-only | mutates\n#   gate3_location:   string — concrete mutation target (or \"n/a\" for read-only)\n#   mcp_tools:        list   — subset of router's frontmatter allowed-tools union\n#   trigger_phrases:  list   — descriptive routing phrases for this target; not\n#                              currently harvested by advisor (see \"Consumed by\" above)\n#\n# Skill-advisor recommendation tools are registered through mk-skill-advisor.\n# To add a new target: append a route here, then re-run route-validate.sh.\n# To remove a target: delete the route AND its corresponding assets/doctor_<target>.yaml.\n# ─────────────────────────────────────────────────────────────────\nschema_version: 1\nroutes:\n  - target: memory\n    yaml: doctor-memory.yaml\n    setup_vars: [execution_mode, intent, incremental]\n    allowed_flags: [\"--incremental=true|false\"]\n    mutating: add-only\n    gate3_location: \"<packet_scratch>/doctor-memory-report.<timestamp>.md + <packet_scratch>/doctor-memory-state.<timestamp>.json\"\n    mcp_tools:\n      - mcp__mk_spec_memory__memory_health\n      - mcp__mk_spec_memory__memory_drift_why\n      - mcp__mk_spec_memory__memory_search\n      - mcp__mk_spec_memory__memory_stats\n    script_invocations:\n      - 'Warm-only: probe the existing mk-spec-memory IPC socket first; only when it answers, run node .opencode/bin/spec-memory.cjs memory_health --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n    trigger_phrases:\n      - \"memory continuity index drift\"\n      - \"memory health rebuild\"\n      - \"context-index doctor\"\n      - \"voyage embedding rebuild\"\n\n  - target: embeddings\n    yaml: doctor-embeddings.yaml\n    setup_vars: [execution_mode]\n    allowed_flags: []\n    mutating: read-only\n    gate3_location: \"n/a (read-only provider and model-server status)\"\n    mcp_tools:\n      - mcp__mk_spec_memory__embedder_status\n    trigger_phrases:\n      - \"embedding provider status\"\n      - \"hf-local model-server health\"\n      - \"embedder_status diagnostics\"\n\n  - target: causal-graph\n    yaml: doctor-causal-graph.yaml\n    setup_vars: [execution_mode, intent, confidence_threshold]\n    allowed_flags: [\"--confidence-threshold=N\"]\n    mutating: add-only\n    gate3_location: \"<packet_scratch>/doctor-causal-graph-state.<timestamp>.json\"\n    mcp_tools:\n      - mcp__mk_spec_memory__memory_causal_stats\n      - mcp__mk_spec_memory__memory_drift_why\n      - mcp__mk_spec_memory__memory_search\n    trigger_phrases:\n      - \"causal edges drift\"\n      - \"causal graph doctor\"\n      - \"lineage coverage\"\n      - \"memory_causal_stats\"\n\n\n  - target: deep-loop\n    yaml: doctor-deep-loop.yaml\n    setup_vars: [execution_mode, intent, scope]\n    allowed_flags: [\"--scope=research|review|council|both|all\"]\n    mutating: add-only\n    gate3_location: \"<packet_scratch>/doctor-deep-loop-state.<timestamp>.json\"\n    mcp_tools: []\n    script_invocations:\n      - 'node .opencode/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\"'\n      - 'node .opencode/skills/system-deep-loop/runtime/scripts/query.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --query-type \"{query_type}\"'\n      - 'node .opencode/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\"'\n    trigger_phrases:\n      - \"deep-loop coverage\"\n      - \"deep-loop graph rebuild\"\n      - \"deep-research convergence drift\"\n      - \"deep-review iteration graph\"\n\n  - target: skill-advisor\n    yaml: doctor-skill-advisor.yaml\n    setup_vars: [execution_mode, scope, skip_tests, dry_run]\n    allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n    mutating: mutates\n    gate3_location: \"lib/scorer/lanes/*.ts + .opencode/skills/*/graph-metadata.json\"\n    mcp_tools:\n      - mcp__mk_skill_advisor__advisor_recommend\n      - mcp__mk_skill_advisor__advisor_status\n      - mcp__mk_skill_advisor__advisor_validate\n      - mcp__mk_skill_advisor__advisor_rebuild\n      - mcp__mk_skill_advisor__skill_graph_scan\n      - mcp__mk_skill_advisor__skill_graph_validate\n      - mcp__mk_skill_advisor__skill_graph_query\n      - mcp__mk_skill_advisor__skill_graph_status\n      - mcp__mk_spec_memory__memory_context\n      - mcp__mk_spec_memory__memory_search\n    script_invocations:\n      - 'Warm-only: probe the existing mk-skill-advisor IPC socket first; only when it answers, run node .opencode/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n    trigger_phrases:\n      - \"skill advisor scoring\"\n      - \"skill advisor rebuild\"\n      - \"advisor recommendation tuning\"\n      - \"skill_graph scan\"\n\n  - target: skill-budget\n    yaml: doctor-skill-budget.yaml\n    setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n    allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only audit; no spec folder required)\"\n    mcp_tools: []   # script-only audit; no MCP calls\n    script_invocations:\n      - 'Warm-only: probe the existing mk-skill-advisor IPC socket first; only when it answers, run node .opencode/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n    trigger_phrases:\n      - \"skill budget audit\"\n      - \"description budget check\"\n      - \"skill char count drift\"\n      - \"frontmatter description trim\"\n\n  - target: parent-skill\n    yaml: doctor-parent-skill.yaml\n    setup_vars: [execution_mode, parent_skill_dir]\n    allowed_flags: [\"--dir=<path>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n    mcp_tools: []   # script-only structural audit; no MCP calls\n    script_invocations:\n      # The fleet class gate runs first: it starts from SKILL.md, so it is the only\n      # check that can report a metadata file a root never wrote. The per-hub audit\n      # then goes deep on the one directory the operator named.\n      - 'node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs'\n      - 'node .opencode/commands/doctor/scripts/parent-skill-check.cjs \"{parent_skill_dir}\"'\n    trigger_phrases:\n      - \"parent skill structure audit\"\n      - \"nested mode packet check\"\n      - \"mode-registry drift guard\"\n      - \"single graph-metadata identity\"\n      - \"skill root metadata contract\"\n      - \"missing skill json files\"\n\n  - target: skill-graph-freshness\n    yaml: doctor-skill-graph-freshness.yaml\n    setup_vars: [execution_mode]\n    allowed_flags: []\n    mutating: read-only\n    gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n    mcp_tools: []   # script-only read; no MCP calls\n    script_invocations:\n      - 'node .opencode/commands/doctor/scripts/skill-graph-freshness.cjs'\n    trigger_phrases:\n      - \"skill graph freshness\"\n      - \"skill-graph zombie ghost nodes\"\n      - \"compiled vs sqlite vs disk graph drift\"\n      - \"reindex staleness check\"\n\n  - target: fable-mode\n    yaml: doctor-fable-mode.yaml\n    setup_vars: [execution_mode, target_dir]\n    allowed_flags: [\"--dir=<path>\", \"--baseline=<path>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only behavioral-metric diagnostic; reads deep-loop state + iteration markdown + baseline snapshot, writes no files)\"\n    mcp_tools: []   # script-only behavioral-metric read; no MCP calls\n    script_invocations:\n      - 'node .opencode/commands/doctor/scripts/fable-mode-check.cjs --dir \"{target_dir}\"'\n    trigger_phrases:\n      - \"fable-5 behavioral metrics\"\n      - \"fable mode efficiency check\"\n      - \"tool text ratio diagnostic\"\n      - \"result-first opener metric\"\n\n  - target: runtime-mirrors\n    yaml: doctor-runtime-mirrors.yaml\n    setup_vars: [execution_mode]\n    allowed_flags: []\n    mutating: read-only\n    gate3_location: \"n/a (read-only mirror-parity diagnostic; every checker runs in its check-only form and writes nothing)\"\n    mcp_tools: []   # script-only mirror parity read; no MCP calls\n    script_invocations:\n      - 'node .opencode/skills/system-spec-kit/scripts/runtime-mirrors/sync-runtime-mirrors.cjs --check'\n      - 'node .opencode/skills/system-spec-kit/scripts/codex/sync-agents.cjs --check'\n      - 'node .opencode/skills/system-spec-kit/scripts/codex/sync-prompts.cjs --check'\n      - 'node .opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n      - 'node .opencode/bin/install-codex-hooks.mjs --check'\n    trigger_phrases:\n      - \"runtime mirror drift\"\n      - \"agent command mirror parity\"\n      - \"cursor devin codex sync check\"\n      - \"discovery mirror out of sync\"\n\n# ─────────────────────────────────────────────────────────────────\n# COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n# ─────────────────────────────────────────────────────────────────\n# /doctor:mcp dispatches via its own command (.opencode/commands/doctor/mcp.md).\n# These rows are tracked here for advisor + CI visibility only — the mcp.md\n# command parses its own sub-action argv and dispatches to the right YAML.\n# ─────────────────────────────────────────────────────────────────\nmcp_subroutes:\n  - sub_action: install\n    yaml: doctor-mcp-install.yaml\n    allowed_flags: [\"--server <name>\", \"--runtime <name>\"]\n    mutating: mutates\n    gate3_location: \"MCP server install dirs + runtime config (.opencode.json / .claude/settings.json / )\"\n    trigger_phrases:\n      - \"MCP install\"\n      - \"MCP server fresh install\"\n      - \"reinstall MCP\"\n\n  - sub_action: debug\n    yaml: doctor-mcp-debug.yaml\n    allowed_flags: [\"--fix\", \"--server <name>\"]\n    mutating: mutates\n    gate3_location: \"MCP server logs + runtime config repair\"\n    trigger_phrases:\n      - \"MCP server broken\"\n      - \"MCP debug\"\n      - \"MCP connection failure\"\n      - \"mcp-doctor.sh\"\n\n# ─────────────────────────────────────────────────────────────────\n# ORCHESTRATOR (NOT routed through /doctor — kept here for reference)\n# ─────────────────────────────────────────────────────────────────\n# /doctor:update is a STANDALONE command at .opencode/commands/doctor/update.md.\n# It does NOT route through /doctor. This block exists for advisor visibility.\n# ─────────────────────────────────────────────────────────────────\nstandalone:\n  - command: /doctor:update\n    file: .opencode/commands/doctor/update.md\n    yaml: doctor-update.yaml\n    mutating: mutates\n    trigger_phrases:\n      - \"spec-kit version migration\"\n      - \"doctor update orchestrator\"\n      - \"rebuild all spec-kit databases\"\n      - \"doctor full sync\"","lineStart":1,"lineEnd":253,"totalLines":253,"truncated":false}},"title":".opencode/commands/doctor/_routes.yaml","time":{"start":1786890720419,"end":1786890720424}},"id":"prt_00afc9384001XHlHemRAtjcte8","sessionID":"ses_ff5086a9cffeOVVmWhMNGVn4l3","messageID":"msg_00afc8262001gUaL9UJ49oersp"}}
