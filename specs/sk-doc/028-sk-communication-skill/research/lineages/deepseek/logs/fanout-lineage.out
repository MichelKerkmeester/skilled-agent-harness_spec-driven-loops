{"type":"tool_use","timestamp":1786569010888,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_TVjiIWpTRgxo2lubJHw37510","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/evaluation/types.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/evaluation/types.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Evaluation Artifact Types\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import type {\n6:   FixtureProvenance,\n7:   PrivacyClass,\n8:   RuntimeId,\n9: } from '../contracts/index.js';\n10: import type { ProtectedSpanKind } from '../fidelity/types.js';\n11: \n12: /** Origin of subjective reviewer evidence used by an evaluation decision. */\n13: export type EvidenceClass = 'human' | 'llm-proxy';\n14: \n15: /** Provenance fields carried by any result that might be presented as release evidence. */\n16: export interface EvidenceProvenance {\n17:   readonly evidenceClass: EvidenceClass;\n18:   readonly isProvisional: boolean;\n19: }\n20: \n21: /** Resolve mixed reviewer evidence conservatively to proxy provenance. */\n22: export function resolveEvidenceClass(\n23:   evidenceClasses: readonly EvidenceClass[],\n24: ): EvidenceClass {\n25:   return evidenceClasses.includes('llm-proxy') ? 'llm-proxy' : 'human';\n26: }\n27: \n28: /** Refuse provisional evidence at a human-certification boundary. */\n29: export function assertHumanCertifiable<T extends EvidenceProvenance>(\n30:   result: T,\n31: ): asserts result is T & { readonly evidenceClass: 'human'; readonly isProvisional: false } {\n32:   if (result.evidenceClass === 'llm-proxy') {\n33:     throw new TypeError('LLM proxy evidence is PROVISIONAL and cannot be human-certified.');\n34:   }\n35:   if (result.isProvisional) {\n36:     throw new TypeError('Provisional evidence cannot be human-certified.');\n37:   }\n38: }\n39: \n40: /** Content-free expectation for protected span coverage in one case. */\n41: export interface ExpectedProtectedSpan {\n42:   readonly kind: ProtectedSpanKind;\n43:   readonly count: number;\n44: }\n45: \n46: /** One synthetic, versioned evaluation case without prompt or response content. */\n47: export interface EvaluationCase {\n48:   readonly id: string;\n49:   readonly provenance: FixtureProvenance;\n50:   readonly category: string;\n51:   readonly expectedProtectedSpans: readonly ExpectedProtectedSpan[];\n52:   readonly privacyClass: PrivacyClass;\n53:   readonly corpusVersion: string;\n54: }\n55: \n56: /** Integrity metadata for a content-free evaluation corpus. */\n57: export interface CorpusManifest {\n58:   readonly corpusVersion: string;\n59:   readonly caseCount: number;\n60:   readonly contentFreeDigest: string;\n61: }\n62: \n63: /** Immutable corpus returned after its pinned metadata passes validation. */\n64: export interface EvaluationCorpus {\n65:   readonly manifest: CorpusManifest;\n66:   readonly cases: readonly EvaluationCase[];\n67: }\n68: \n69: /** Host metadata recorded without environment variables or process arguments. */\n70: export interface RunEnvironmentMetadata {\n71:   readonly nodeVersion: string;\n72:   readonly platform: string;\n73:   readonly architecture: string;\n74: }\n75: \n76: /** Runtime coordinates needed to reproduce one evaluation route. */\n77: export interface RunRuntimeMetadata {\n78:   readonly runtimeId: RuntimeId;\n79:   readonly runtimeVersion: string;\n80:   readonly protocolVersion: string;\n81:   readonly pathId: string;\n82: }\n83: \n84: /** Deterministic run description containing no source or candidate content. */\n85: export interface RunManifest {\n86:   readonly manifestVersion: 'evaluation-run/1.0.0';\n87:   readonly corpusVersion: string;\n88:   readonly corpusDigest: string;\n89:   readonly caseOrder: readonly string[];\n90:   readonly seed: string;\n91:   readonly environment: RunEnvironmentMetadata;\n92:   readonly runtime: RunRuntimeMetadata;\n93:   readonly reproducibilityDigest: string;\n94: }\n95: \n96: /** One provider-model and prompt-profile pilot stratum. */\n97: export interface PilotStratum {\n98:   readonly providerId: string;\n99:   readonly modelId: string;\n100:   readonly promptProfileId: string;\n101: }\n102: \n103: /** Deterministic coordinates passed to an injected fixture producer. */\n104: export interface PilotCandidateInput extends PilotStratum {\n105:   readonly evaluationCase: EvaluationCase;\n106:   readonly sampleIndex: number;\n107: }\n108: \n109: /** Candidate producer used only in memory during the variance pilot. */\n110: export type PilotCandidateProducer = (\n111:   input: PilotCandidateInput,\n112: ) => Promise<string> | string;\n113: \n114: /** Ephemeral scorer input whose candidate is never copied into an artifact. */\n115: export interface PilotScoringInput extends PilotCandidateInput {\n116:   readonly candidate: string;\n117: }\n118: \n119: /** Numeric scorer applied to one injected candidate. */\n120: export type PilotCandidateScorer = (\n121:   input: PilotScoringInput,\n122: ) => Promise<number> | number;\n123: \n124: /** Content-free numeric observation retained from one pilot repetition. */\n125: export interface PilotSample extends PilotStratum {\n126:   readonly caseId: string;\n127:   readonly sampleIndex: number;\n128:   readonly score: number;\n129: }\n130: \n131: /** Sample variance for one provider-model and prompt-profile stratum. */\n132: export interface PilotVarianceEstimate extends PilotStratum {\n133:   readonly estimateVersion: 'pilot-variance/1.0.0';\n134:   readonly purpose: 'variance-planning-only';\n135:   readonly sampleCount: number;\n136:   readonly mean: number;\n137:   readonly variance: number;\n138:   readonly samples: readonly PilotSample[];\n139: }\n\n(End of file - total 139 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Evaluation Artifact Types\n// ───────────────────────────────────────────────────────────────────\n\nimport type {\n  FixtureProvenance,\n  PrivacyClass,\n  RuntimeId,\n} from '../contracts/index.js';\nimport type { ProtectedSpanKind } from '../fidelity/types.js';\n\n/** Origin of subjective reviewer evidence used by an evaluation decision. */\nexport type EvidenceClass = 'human' | 'llm-proxy';\n\n/** Provenance fields carried by any result that might be presented as release evidence. */\nexport interface EvidenceProvenance {\n  readonly evidenceClass: EvidenceClass;\n  readonly isProvisional: boolean;\n}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/evaluation/types.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Evaluation Artifact Types\n// ───────────────────────────────────────────────────────────────────\n\nimport type {\n  FixtureProvenance,\n  PrivacyClass,\n  RuntimeId,\n} from '../contracts/index.js';\nimport type { ProtectedSpanKind } from '../fidelity/types.js';\n\n/** Origin of subjective reviewer evidence used by an evaluation decision. */\nexport type EvidenceClass = 'human' | 'llm-proxy';\n\n/** Provenance fields carried by any result that might be presented as release evidence. */\nexport interface EvidenceProvenance {\n  readonly evidenceClass: EvidenceClass;\n  readonly isProvisional: boolean;\n}\n\n/** Resolve mixed reviewer evidence conservatively to proxy provenance. */\nexport function resolveEvidenceClass(\n  evidenceClasses: readonly EvidenceClass[],\n): EvidenceClass {\n  return evidenceClasses.includes('llm-proxy') ? 'llm-proxy' : 'human';\n}\n\n/** Refuse provisional evidence at a human-certification boundary. */\nexport function assertHumanCertifiable<T extends EvidenceProvenance>(\n  result: T,\n): asserts result is T & { readonly evidenceClass: 'human'; readonly isProvisional: false } {\n  if (result.evidenceClass === 'llm-proxy') {\n    throw new TypeError('LLM proxy evidence is PROVISIONAL and cannot be human-certified.');\n  }\n  if (result.isProvisional) {\n    throw new TypeError('Provisional evidence cannot be human-certified.');\n  }\n}\n\n/** Content-free expectation for protected span coverage in one case. */\nexport interface ExpectedProtectedSpan {\n  readonly kind: ProtectedSpanKind;\n  readonly count: number;\n}\n\n/** One synthetic, versioned evaluation case without prompt or response content. */\nexport interface EvaluationCase {\n  readonly id: string;\n  readonly provenance: FixtureProvenance;\n  readonly category: string;\n  readonly expectedProtectedSpans: readonly ExpectedProtectedSpan[];\n  readonly privacyClass: PrivacyClass;\n  readonly corpusVersion: string;\n}\n\n/** Integrity metadata for a content-free evaluation corpus. */\nexport interface CorpusManifest {\n  readonly corpusVersion: string;\n  readonly caseCount: number;\n  readonly contentFreeDigest: string;\n}\n\n/** Immutable corpus returned after its pinned metadata passes validation. */\nexport interface EvaluationCorpus {\n  readonly manifest: CorpusManifest;\n  readonly cases: readonly EvaluationCase[];\n}\n\n/** Host metadata recorded without environment variables or process arguments. */\nexport interface RunEnvironmentMetadata {\n  readonly nodeVersion: string;\n  readonly platform: string;\n  readonly architecture: string;\n}\n\n/** Runtime coordinates needed to reproduce one evaluation route. */\nexport interface RunRuntimeMetadata {\n  readonly runtimeId: RuntimeId;\n  readonly runtimeVersion: string;\n  readonly protocolVersion: string;\n  readonly pathId: string;\n}\n\n/** Deterministic run description containing no source or candidate content. */\nexport interface RunManifest {\n  readonly manifestVersion: 'evaluation-run/1.0.0';\n  readonly corpusVersion: string;\n  readonly corpusDigest: string;\n  readonly caseOrder: readonly string[];\n  readonly seed: string;\n  readonly environment: RunEnvironmentMetadata;\n  readonly runtime: RunRuntimeMetadata;\n  readonly reproducibilityDigest: string;\n}\n\n/** One provider-model and prompt-profile pilot stratum. */\nexport interface PilotStratum {\n  readonly providerId: string;\n  readonly modelId: string;\n  readonly promptProfileId: string;\n}\n\n/** Deterministic coordinates passed to an injected fixture producer. */\nexport interface PilotCandidateInput extends PilotStratum {\n  readonly evaluationCase: EvaluationCase;\n  readonly sampleIndex: number;\n}\n\n/** Candidate producer used only in memory during the variance pilot. */\nexport type PilotCandidateProducer = (\n  input: PilotCandidateInput,\n) => Promise<string> | string;\n\n/** Ephemeral scorer input whose candidate is never copied into an artifact. */\nexport interface PilotScoringInput extends PilotCandidateInput {\n  readonly candidate: string;\n}\n\n/** Numeric scorer applied to one injected candidate. */\nexport type PilotCandidateScorer = (\n  input: PilotScoringInput,\n) => Promise<number> | number;\n\n/** Content-free numeric observation retained from one pilot repetition. */\nexport interface PilotSample extends PilotStratum {\n  readonly caseId: string;\n  readonly sampleIndex: number;\n  readonly score: number;\n}\n\n/** Sample variance for one provider-model and prompt-profile stratum. */\nexport interface PilotVarianceEstimate extends PilotStratum {\n  readonly estimateVersion: 'pilot-variance/1.0.0';\n  readonly purpose: 'variance-planning-only';\n  readonly sampleCount: number;\n  readonly mean: number;\n  readonly variance: number;\n  readonly samples: readonly PilotSample[];\n}","lineStart":1,"lineEnd":139,"totalLines":139,"truncated":false}},"title":"packages/cli-communication-projection/src/evaluation/types.ts","time":{"start":1786569010882,"end":1786569010886}},"id":"prt_ff7cfaa28001w0uolh9PQK4St2","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cf75f2001vgAO0J6UfV4LvM"}}
{"type":"tool_use","timestamp":1786569011905,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_02_2XbvAPd1bowyju0yZ6o86238","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/docs/privacy.md"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/docs/privacy.md</path>\n<type>file</type>\n<content>\n1: # Privacy modes\n2: \n3: The privacy router evaluates metadata before any transport is called. It stores\n4: privacy classes, reason codes, dates, counts, and digests—not prompts,\n5: transcripts, generated text, credential values, or raw provider responses.\n6: \n7: ## Local-only\n8: \n9: - Allow only `local-offline` and explicitly approved `local-networked` records.\n10: - Set egress consent to `false`.\n11: - Use `fallbackPolicy.mode: 'none'` unless every fallback is also local and named.\n12: - Verify the transport call list contains zero hosted provider identifiers.\n13: \n14: ## Hosted\n15: \n16: - Name the hosted provider and model; do not route by an open-ended alias.\n17: - Set egress consent to `true` only after operator approval.\n18: - Require fresh retention and training-use facts and a credential reference.\n19: - Pass references such as `env:NAME`, `keychain:NAME`, or `managed:NAME`; never\n20:   pass or log the referenced value.\n21: \n22: ## Mixed\n23: \n24: - Name local and hosted candidates separately.\n25: - Use an explicit ordered fallback list; ranking does not imply fallback.\n26: - Crossing privacy classes requires egress consent and an intentional\n27:   `preservePrivacyClass: false` policy.\n28: - Any missing, unknown, contradictory, or stale fact fails closed to the exact\n29:   original. There is no hidden hosted fallback.\n30: \n31: Telemetry and release evidence must remain content-free. Run the privacy canary\n32: gate before release and stop if any canary is present in an export or manifest.\n\n(End of file - total 32 lines)\n</content>","metadata":{"preview":"# Privacy modes\n\nThe privacy router evaluates metadata before any transport is called. It stores\nprivacy classes, reason codes, dates, counts, and digests—not prompts,\ntranscripts, generated text, credential values, or raw provider responses.\n\n## Local-only\n\n- Allow only `local-offline` and explicitly approved `local-networked` records.\n- Set egress consent to `false`.\n- Use `fallbackPolicy.mode: 'none'` unless every fallback is also local and named.\n- Verify the transport call list contains zero hosted provider identifiers.\n\n## Hosted\n\n- Name the hosted provider and model; do not route by an open-ended alias.\n- Set egress consent to `true` only after operator approval.\n- Require fresh retention and training-use facts and a credential reference.\n- Pass references such as `env:NAME`, `keychain:NAME`, or `managed:NAME`; never\n  pass or log the referenced value.","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/docs/privacy.md","text":"# Privacy modes\n\nThe privacy router evaluates metadata before any transport is called. It stores\nprivacy classes, reason codes, dates, counts, and digests—not prompts,\ntranscripts, generated text, credential values, or raw provider responses.\n\n## Local-only\n\n- Allow only `local-offline` and explicitly approved `local-networked` records.\n- Set egress consent to `false`.\n- Use `fallbackPolicy.mode: 'none'` unless every fallback is also local and named.\n- Verify the transport call list contains zero hosted provider identifiers.\n\n## Hosted\n\n- Name the hosted provider and model; do not route by an open-ended alias.\n- Set egress consent to `true` only after operator approval.\n- Require fresh retention and training-use facts and a credential reference.\n- Pass references such as `env:NAME`, `keychain:NAME`, or `managed:NAME`; never\n  pass or log the referenced value.\n\n## Mixed\n\n- Name local and hosted candidates separately.\n- Use an explicit ordered fallback list; ranking does not imply fallback.\n- Crossing privacy classes requires egress consent and an intentional\n  `preservePrivacyClass: false` policy.\n- Any missing, unknown, contradictory, or stale fact fails closed to the exact\n  original. There is no hidden hosted fallback.\n\nTelemetry and release evidence must remain content-free. Run the privacy canary\ngate before release and stop if any canary is present in an export or manifest.","lineStart":1,"lineEnd":32,"totalLines":32,"truncated":false}},"title":"packages/cli-communication-projection/docs/privacy.md","time":{"start":1786569011898,"end":1786569011903}},"id":"prt_ff7cfaf43001tljYCZPWCr0TMN","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cf75f2001vgAO0J6UfV4LvM"}}
