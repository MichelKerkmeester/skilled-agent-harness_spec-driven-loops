{"type":"tool_use","timestamp":1786569355185,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_00_P49BMWc9VFNJo0I7siNx7287","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/runtimes/codex.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/runtimes/codex.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Codex Runtime Adapter\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import {\n6:   EventKinds,\n7:   EventPhases,\n8:   TerminalStatuses,\n9: } from '../contracts/event.js';\n10: import { validateEventEnvelope } from '../contracts/validate-event.js';\n11: import { deepFreeze } from '../fidelity/freeze.js';\n12: import { RenderModes } from '../render/types.js';\n13: import {\n14:   mapRuntimeGeneration,\n15:   sanitizeRuntimeTelemetryPathId,\n16: } from './adapter.js';\n17: import {\n18:   assessRuntimeCompatibility,\n19:   mapRuntimeCapability,\n20: } from './capability.js';\n21: import { RuntimeAdapterReasonCodes } from './types.js';\n22: \n23: import type { JsonObject } from '../contracts/common.js';\n24: import type { EventEnvelope } from '../contracts/event.js';\n25: import type { RuntimeAdapter } from './adapter.js';\n26: import type {\n27:   PresentationTier,\n28:   RuntimeAdapterInput,\n29:   RuntimeAdapterReasonCode,\n30:   RuntimeAdapterResult,\n31:   RuntimeCapabilityClaim,\n32:   RuntimeCapabilityRecord,\n33:   RuntimeExactOriginalPresentation,\n34:   RuntimePresentationInput,\n35:   RuntimePresentationResult,\n36:   RuntimeTelemetryRecord,\n37: } from './types.js';\n38: \n39: /** Supported Codex presentation paths. */\n40: export const CodexRuntimePaths = {\n41:   APP_SERVER: 'codex-app-server-client',\n42: } as const;\n43: \n44: /** Supported Codex App Server event classes. */\n45: export const CodexEventTypes = {\n46:   AGENT_MESSAGE: 'agent-message',\n47:   AGENT_MESSAGE_DELTA: 'agent-message-delta',\n48:   CANCELLED: 'cancelled',\n49:   DISCONNECT: 'disconnect',\n50:   ERROR: 'error',\n51:   EXTENSION: 'extension',\n52:   THREAD_STARTED: 'thread-started',\n53:   TIMEOUT: 'timeout',\n54:   TOOL_CALL: 'tool-call',\n55:   TOOL_RESULT: 'tool-result',\n56:   TURN_COMPLETED: 'turn-completed',\n57: } as const;\n58: \n59: /** Metadata-only Codex content event whose bytes remain canonical. */\n60: export interface CodexContentEvent {\n61:   readonly type: 'agent-message' | 'agent-message-delta' | 'tool-call' | 'tool-result';\n62:   readonly eventId: string;\n63:   readonly index: number;\n64:   readonly sourceTimestamp: string | null;\n65:   readonly itemId: string | null;\n66:   readonly toolCallId: string | null;\n67: }\n68: \n69: /** Codex thread and turn lifecycle event. */\n70: export interface CodexLifecycleEvent {\n71:   readonly type: 'thread-started' | 'turn-completed';\n72:   readonly eventId: string;\n73:   readonly index: number;\n74:   readonly sourceTimestamp: string | null;\n75: }\n76: \n77: /** Terminal Codex App Server lifecycle event. */\n78: export interface CodexTerminalEvent {\n79:   readonly type: 'cancelled' | 'disconnect' | 'error' | 'timeout';\n80:   readonly eventId: string;\n81:   readonly index: number;\n82:   readonly sourceTimestamp: string | null;\n83: }\n84: \n85: /** Namespaced Codex metadata retained outside the portable core. */\n86: export interface CodexExtensionEvent {\n87:   readonly type: 'extension';\n88:   readonly eventId: string;\n89:   readonly index: number;\n90:   readonly final: boolean;\n91:   readonly sourceTimestamp: string | null;\n92:   readonly namespace: string;\n93:   readonly value: JsonObject;\n94: }\n95: \n96: /** Codex App Server events translated by this adapter. */\n97: export type CodexRuntimeEvent =\n98:   | CodexContentEvent\n99:   | CodexExtensionEvent\n100:   | CodexLifecycleEvent\n101:   | CodexTerminalEvent;\n102: \n103: const CONFIRMED_YES: RuntimeCapabilityClaim = Object.freeze({\n104:   state: 'yes',\n105:   confidence: 'confirmed',\n106: });\n107: const CONFIRMED_NO: RuntimeCapabilityClaim = Object.freeze({\n108:   state: 'no',\n109:   confidence: 'confirmed',\n110: });\n111: const TESTED_RUNTIME_VERSION = '0.147.0';\n112: const TESTED_PROTOCOL_VERSION = '1.0.0';\n113: const EVIDENCE_DATE = '2026-08-12T00:00:00.000Z';\n114: \n115: /** Version-pinned Codex App Server client capability record. */\n116: export const CodexCapabilityRecords: readonly RuntimeCapabilityRecord[] = Object.freeze([\n117:   mapRuntimeCapability({\n118:     runtime: 'codex',\n119:     pathId: CodexRuntimePaths.APP_SERVER,\n120:     protocol: 'codex-app-server-json-rpc',\n121:     testedVersions: {\n122:       runtime: TESTED_RUNTIME_VERSION,\n123:       protocol: TESTED_PROTOCOL_VERSION,\n124:     },\n125:     evidence: {\n126:       observedAt: EVIDENCE_DATE,\n127:       source: 'codex-app-server-client-observation',\n128:       completeMessage: CONFIRMED_YES,\n129:       atomicRenderDecision: CONFIRMED_YES,\n130:       safePresentationBoundary: CONFIRMED_YES,\n131:       append: CONFIRMED_NO,\n132:       sidecar: CONFIRMED_NO,\n133:     },\n134:   }),\n135: ]);\n136: \n137: /** Create a Codex adapter with an App Server client-owned presentation boundary. */\n138: export function createCodexRuntimeAdapter(\n139:   capabilities: readonly RuntimeCapabilityRecord[] = CodexCapabilityRecords,\n140: ): RuntimeAdapter<CodexRuntimeEvent> {\n141:   const records = deepFreeze(structuredClone(capabilities));\n142:   return Object.freeze({\n143:     adapterVersion: 'runtime-adapter/1.0.0',\n144:     runtime: 'codex',\n145:     capabilities: records,\n146:     adapt(input: RuntimeAdapterInput<CodexRuntimeEvent>): RuntimeAdapterResult {\n147:       return adaptCodexEvent(records, input);\n148:     },\n149:     present(input: RuntimePresentationInput): RuntimePresentationResult {\n150:       return presentCodexDecision(records, input);\n151:     },\n152:   });\n153: }\n154: \n155: /** Default Codex App Server adapter. */\n156: export const codexRuntimeAdapter = createCodexRuntimeAdapter();\n157: \n158: function adaptCodexEvent(\n159:   capabilities: readonly RuntimeCapabilityRecord[],\n160:   input: RuntimeAdapterInput<CodexRuntimeEvent>,\n161: ): RuntimeAdapterResult {\n162:   const generation = mapRuntimeGeneration(input);\n163:   const record = findCapability(capabilities, input.envelope.pathId);\n164:   if (record === undefined) {\n165:     return exactEvent(capabilities, input, generation, null, RuntimeAdapterReasonCodes.UNSUPPORTED_PATH);\n166:   }\n167:   if (input.envelope.runtime !== 'codex' || input.envelope.protocol !== record.protocol) {\n168:     return exactEvent(capabilities, input, generation, null, RuntimeAdapterReasonCodes.INVALID_EVENT);\n169:   }\n170:   const compatibility = assessRuntimeCompatibility(\n171:     record,\n172:     input.envelope.runtimeVersion,\n173:     input.envelope.protocolVersion,\n174:   );\n175:   if (!compatibility.compatible) {\n176:     return exactEvent(capabilities, input, generation, null, compatibility.reasonCode);\n177:   }\n178: \n179:   const event = createEventEnvelope(input, record);\n180:   if (!validateEventEnvelope(event).success) {\n181:     return exactEvent(capabilities, input, generation, null, RuntimeAdapterReasonCodes.INVALID_EVENT);\n182:   }\n183:   const reasonCode = terminalReason(input.envelope.event);\n184:   if (reasonCode !== RuntimeAdapterReasonCodes.NONE) {\n185:     return exactEvent(capabilities, input, generation, event, reasonCode);\n186:   }\n187:   return deepFreeze({\n188:     status: 'mapped',\n189:     reasonCode: RuntimeAdapterReasonCodes.NONE,\n190:     generation,\n191:     event,\n192:     exactOriginal: null,\n193:     presentationTier: record.presentationTier,\n194:     telemetry: telemetry(record, 'mapped', RuntimeAdapterReasonCodes.NONE),\n195:   });\n196: }\n197: \n198: function createEventEnvelope(\n199:   input: RuntimeAdapterInput<CodexRuntimeEvent>,\n200:   record: RuntimeCapabilityRecord,\n201: ): EventEnvelope {\n202:   const runtimeEvent = input.envelope.event;\n203:   const lifecycle = lifecycleFor(runtimeEvent);\n204:   const originalId = input.canonical.exactOriginal.originalId;\n205:   const isExtension = runtimeEvent.type === CodexEventTypes.EXTENSION;\n206:   const isContent = isContentEvent(runtimeEvent);\n207:   return deepFreeze({\n208:     contractKind: 'event',\n209:     schemaVersion: '1.0.0',\n210:     runtime: 'codex',\n211:     runtimeVersion: input.envelope.runtimeVersion,\n212:     adapterSchemaVersion: '1.0.0',\n213:     sessionId: input.envelope.sessionId,\n214:     turnId: input.envelope.turnId,\n215:     messageId: input.envelope.messageId,\n216:     itemId: isContent ? runtimeEvent.itemId : null,\n217:     partId: runtimeEvent.type === CodexEventTypes.AGENT_MESSAGE_DELTA\n218:       ? `part-${runtimeEvent.index}`\n219:       : null,\n220:     toolCallId: isContent ? runtimeEvent.toolCallId : null,\n221:     parentId: null,\n222:     eventId: runtimeEvent.eventId,\n223:     kind: lifecycle.kind,\n224:     phase: lifecycle.phase,\n225:     sourceTimestamp: runtimeEvent.sourceTimestamp,\n226:     order: {\n227:       sourceSequence: runtimeEvent.index,\n228:       arrivalIndex: runtimeEvent.index,\n229:       assemblyIndex: null,\n230:     },\n231:     canonicalPayloadRef: originalId,\n232:     payload: isExtension ? {} : payloadFor(runtimeEvent, originalId),\n233:     extensions: isExtension\n234:       ? { [runtimeEvent.namespace]: structuredClone(runtimeEvent.value) }\n235:       : {},\n236:     terminalStatus: lifecycle.terminalStatus,\n237:     capabilityConfidence: record.evidence.safePresentationBoundary.confidence,\n238:   });\n239: }\n240: \n241: function lifecycleFor(event: CodexRuntimeEvent): Pick<\n242:   EventEnvelope,\n243:   'kind' | 'phase' | 'terminalStatus'\n244: > {\n245:   switch (event.type) {\n246:     case CodexEventTypes.AGENT_MESSAGE_DELTA:\n247:       return { kind: EventKinds.ASSISTANT_MESSAGE_DELTA, phase: EventPhases.STREAMING, terminalStatus: TerminalStatuses.NONE };\n248:     case CodexEventTypes.AGENT_MESSAGE:\n249:       return { kind: EventKinds.ASSISTANT_MESSAGE, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED };\n250:     case CodexEventTypes.TOOL_CALL:\n251:       return { kind: EventKinds.TOOL_CALL, phase: EventPhases.CREATED, terminalStatus: TerminalStatuses.NONE };\n252:     case CodexEventTypes.TOOL_RESULT:\n253:       return { kind: EventKinds.TOOL_RESULT, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED };\n254:     case CodexEventTypes.THREAD_STARTED:\n255:       return { kind: EventKinds.EXTENSION, phase: EventPhases.CREATED, terminalStatus: TerminalStatuses.NONE };\n256:     case CodexEventTypes.TURN_COMPLETED:\n257:       return { kind: EventKinds.EXTENSION, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED };\n258:     case CodexEventTypes.CANCELLED:\n259:       return { kind: EventKinds.CANCELLATION, phase: EventPhases.CANCELLED, terminalStatus: TerminalStatuses.CANCELLED };\n260:     case CodexEventTypes.DISCONNECT:\n261:     case CodexEventTypes.ERROR:\n262:     case CodexEventTypes.TIMEOUT:\n263:       return { kind: EventKinds.ERROR, phase: EventPhases.FAILED, terminalStatus: TerminalStatuses.FAILED };\n264:     case CodexEventTypes.EXTENSION:\n265:       return event.final\n266:         ? { kind: EventKinds.EXTENSION, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED }\n267:         : { kind: EventKinds.EXTENSION, phase: EventPhases.STREAMING, terminalStatus: TerminalStatuses.NONE };\n268:   }\n269: }\n270: \n271: function payloadFor(event: CodexRuntimeEvent, originalId: string): JsonObject {\n272:   switch (event.type) {\n273:     case CodexEventTypes.AGENT_MESSAGE:\n274:     case CodexEventTypes.AGENT_MESSAGE_DELTA:\n275:       return Object.freeze({ textOriginalId: originalId });\n276:     case CodexEventTypes.TOOL_CALL:\n277:       return Object.freeze({ toolInputOriginalId: originalId });\n278:     case CodexEventTypes.TOOL_RESULT:\n279:       return Object.freeze({ toolResultOriginalId: originalId });\n280:     case CodexEventTypes.THREAD_STARTED:\n281:     case CodexEventTypes.TURN_COMPLETED:\n282:       return Object.freeze({ lifecycleOriginalId: originalId });\n283:     case CodexEventTypes.CANCELLED:\n284:       return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.CANCELLED });\n285:     case CodexEventTypes.DISCONNECT:\n286:       return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.DISCONNECTED });\n287:     case CodexEventTypes.ERROR:\n288:       return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.RUNTIME_FAILURE });\n289:     case CodexEventTypes.TIMEOUT:\n290:       return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.TIMEOUT });\n291:     case CodexEventTypes.EXTENSION:\n292:       return Object.freeze({});\n293:   }\n294: }\n295: \n296: function terminalReason(event: CodexRuntimeEvent): RuntimeAdapterReasonCode {\n297:   switch (event.type) {\n298:     case CodexEventTypes.CANCELLED:\n299:       return RuntimeAdapterReasonCodes.CANCELLED;\n300:     case CodexEventTypes.DISCONNECT:\n301:       return RuntimeAdapterReasonCodes.DISCONNECTED;\n302:     case CodexEventTypes.ERROR:\n303:       return RuntimeAdapterReasonCodes.RUNTIME_FAILURE;\n304:     case CodexEventTypes.TIMEOUT:\n305:       return RuntimeAdapterReasonCodes.TIMEOUT;\n306:     default:\n307:       return RuntimeAdapterReasonCodes.NONE;\n308:   }\n309: }\n310: \n311: function presentCodexDecision(\n312:   capabilities: readonly RuntimeCapabilityRecord[],\n313:   input: RuntimePresentationInput,\n314: ): RuntimePresentationResult {\n315:   const record = findCapability(capabilities, input.pathId);\n316:   if (record === undefined) {\n317:     return exactPresentation(capabilities, input, RuntimeAdapterReasonCodes.UNSUPPORTED_PATH);\n318:   }\n319:   const compatibility = assessRuntimeCompatibility(record, input.runtimeVersion, input.protocolVersion);\n320:   if (!compatibility.compatible) {\n321:     return exactPresentation(capabilities, input, compatibility.reasonCode);\n322:   }\n323:   if (input.renderDecision.status !== 'projection') {\n324:     return exactPresentation(capabilities, input, RuntimeAdapterReasonCodes.PROJECTION_REJECTED);\n325:   }\n326:   if (record.presentationTier !== 'full-projection' || input.renderDecision.mode !== RenderModes.ATOMIC_REPLACE) {\n327:     return exactPresentation(capabilities, input, RuntimeAdapterReasonCodes.UNSUPPORTED_PRESENTATION);\n328:   }\n329:   return deepFreeze({\n330:     status: 'projection',\n331:     mode: 'atomic-replace',\n332:     reasonCode: RuntimeAdapterReasonCodes.NONE,\n333:     presentationTier: 'full-projection',\n334:     exactOriginal: input.renderDecision.exactOriginal,\n335:     projectionText: input.renderDecision.projectionText,\n336:     originalSuppressed: true,\n337:     telemetry: telemetry(record, 'projection', RuntimeAdapterReasonCodes.NONE),\n338:   });\n339: }\n340: \n341: function exactEvent(\n342:   capabilities: readonly RuntimeCapabilityRecord[],\n343:   input: RuntimeAdapterInput<CodexRuntimeEvent>,\n344:   generation: ReturnType<typeof mapRuntimeGeneration>,\n345:   event: EventEnvelope | null,\n346:   reasonCode: Exclude<RuntimeAdapterReasonCode, 'none'>,\n347: ): RuntimeAdapterResult {\n348:   return deepFreeze({\n349:     status: 'exact-original',\n350:     reasonCode,\n351:     generation,\n352:     event,\n353:     exactOriginal: input.canonical.exactOriginal,\n354:     presentationTier: 'safe-native',\n355:     telemetry: telemetryFor(\n356:       capabilities,\n357:       input.envelope.pathId,\n358:       'safe-native',\n359:       'exact-original',\n360:       reasonCode,\n361:     ),\n362:   });\n363: }\n364: \n365: function exactPresentation(\n366:   capabilities: readonly RuntimeCapabilityRecord[],\n367:   input: RuntimePresentationInput,\n368:   reasonCode: Exclude<RuntimeAdapterReasonCode, 'none'>,\n369: ): RuntimeExactOriginalPresentation {\n370:   return deepFreeze({\n371:     status: 'exact-original',\n372:     mode: 'original-only',\n373:     reasonCode,\n374:     presentationTier: 'safe-native',\n375:     exactOriginal: input.renderDecision.exactOriginal,\n376:     projectionText: null,\n377:     originalSuppressed: false,\n378:     telemetry: telemetryFor(\n379:       capabilities,\n380:       input.pathId,\n381:       'safe-native',\n382:       'exact-original',\n383:       reasonCode,\n384:     ),\n385:   });\n386: }\n387: \n388: function isContentEvent(event: CodexRuntimeEvent): event is CodexContentEvent {\n389:   return event.type === CodexEventTypes.AGENT_MESSAGE\n390:     || event.type === CodexEventTypes.AGENT_MESSAGE_DELTA\n391:     || event.type === CodexEventTypes.TOOL_CALL\n392:     || event.type === CodexEventTypes.TOOL_RESULT;\n393: }\n394: \n395: function findCapability(\n396:   capabilities: readonly RuntimeCapabilityRecord[],\n397:   pathId: string,\n398: ): RuntimeCapabilityRecord | undefined {\n399:   return capabilities.find((record) => record.runtime === 'codex' && record.pathId === pathId);\n400: }\n401: \n402: function telemetry(\n403:   record: RuntimeCapabilityRecord,\n404:   status: RuntimeTelemetryRecord['status'],\n405:   reasonCode: RuntimeAdapterReasonCode,\n406: ): RuntimeTelemetryRecord {\n407:   return telemetryFor([record], record.pathId, record.presentationTier, status, reasonCode);\n408: }\n409: \n410: function telemetryFor(\n411:   capabilities: readonly RuntimeCapabilityRecord[],\n412:   pathId: string,\n413:   tier: PresentationTier,\n414:   status: RuntimeTelemetryRecord['status'],\n415:   reasonCode: RuntimeAdapterReasonCode,\n416: ): RuntimeTelemetryRecord {\n417:   return Object.freeze({\n418:     telemetryVersion: 'runtime-telemetry/1.0.0',\n419:     eventName: 'runtime-adapter-terminal',\n420:     runtime: 'codex',\n421:     pathId: sanitizeRuntimeTelemetryPathId(pathId, capabilities),\n422:     presentationTier: tier,\n423:     status,\n424:     reasonCode,\n425:   });\n426: }\n\n(End of file - total 426 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Codex Runtime Adapter\n// ───────────────────────────────────────────────────────────────────\n\nimport {\n  EventKinds,\n  EventPhases,\n  TerminalStatuses,\n} from '../contracts/event.js';\nimport { validateEventEnvelope } from '../contracts/validate-event.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\nimport { RenderModes } from '../render/types.js';\nimport {\n  mapRuntimeGeneration,\n  sanitizeRuntimeTelemetryPathId,\n} from './adapter.js';\nimport {\n  assessRuntimeCompatibility,\n  mapRuntimeCapability,\n} from './capability.js';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/runtimes/codex.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Codex Runtime Adapter\n// ───────────────────────────────────────────────────────────────────\n\nimport {\n  EventKinds,\n  EventPhases,\n  TerminalStatuses,\n} from '../contracts/event.js';\nimport { validateEventEnvelope } from '../contracts/validate-event.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\nimport { RenderModes } from '../render/types.js';\nimport {\n  mapRuntimeGeneration,\n  sanitizeRuntimeTelemetryPathId,\n} from './adapter.js';\nimport {\n  assessRuntimeCompatibility,\n  mapRuntimeCapability,\n} from './capability.js';\nimport { RuntimeAdapterReasonCodes } from './types.js';\n\nimport type { JsonObject } from '../contracts/common.js';\nimport type { EventEnvelope } from '../contracts/event.js';\nimport type { RuntimeAdapter } from './adapter.js';\nimport type {\n  PresentationTier,\n  RuntimeAdapterInput,\n  RuntimeAdapterReasonCode,\n  RuntimeAdapterResult,\n  RuntimeCapabilityClaim,\n  RuntimeCapabilityRecord,\n  RuntimeExactOriginalPresentation,\n  RuntimePresentationInput,\n  RuntimePresentationResult,\n  RuntimeTelemetryRecord,\n} from './types.js';\n\n/** Supported Codex presentation paths. */\nexport const CodexRuntimePaths = {\n  APP_SERVER: 'codex-app-server-client',\n} as const;\n\n/** Supported Codex App Server event classes. */\nexport const CodexEventTypes = {\n  AGENT_MESSAGE: 'agent-message',\n  AGENT_MESSAGE_DELTA: 'agent-message-delta',\n  CANCELLED: 'cancelled',\n  DISCONNECT: 'disconnect',\n  ERROR: 'error',\n  EXTENSION: 'extension',\n  THREAD_STARTED: 'thread-started',\n  TIMEOUT: 'timeout',\n  TOOL_CALL: 'tool-call',\n  TOOL_RESULT: 'tool-result',\n  TURN_COMPLETED: 'turn-completed',\n} as const;\n\n/** Metadata-only Codex content event whose bytes remain canonical. */\nexport interface CodexContentEvent {\n  readonly type: 'agent-message' | 'agent-message-delta' | 'tool-call' | 'tool-result';\n  readonly eventId: string;\n  readonly index: number;\n  readonly sourceTimestamp: string | null;\n  readonly itemId: string | null;\n  readonly toolCallId: string | null;\n}\n\n/** Codex thread and turn lifecycle event. */\nexport interface CodexLifecycleEvent {\n  readonly type: 'thread-started' | 'turn-completed';\n  readonly eventId: string;\n  readonly index: number;\n  readonly sourceTimestamp: string | null;\n}\n\n/** Terminal Codex App Server lifecycle event. */\nexport interface CodexTerminalEvent {\n  readonly type: 'cancelled' | 'disconnect' | 'error' | 'timeout';\n  readonly eventId: string;\n  readonly index: number;\n  readonly sourceTimestamp: string | null;\n}\n\n/** Namespaced Codex metadata retained outside the portable core. */\nexport interface CodexExtensionEvent {\n  readonly type: 'extension';\n  readonly eventId: string;\n  readonly index: number;\n  readonly final: boolean;\n  readonly sourceTimestamp: string | null;\n  readonly namespace: string;\n  readonly value: JsonObject;\n}\n\n/** Codex App Server events translated by this adapter. */\nexport type CodexRuntimeEvent =\n  | CodexContentEvent\n  | CodexExtensionEvent\n  | CodexLifecycleEvent\n  | CodexTerminalEvent;\n\nconst CONFIRMED_YES: RuntimeCapabilityClaim = Object.freeze({\n  state: 'yes',\n  confidence: 'confirmed',\n});\nconst CONFIRMED_NO: RuntimeCapabilityClaim = Object.freeze({\n  state: 'no',\n  confidence: 'confirmed',\n});\nconst TESTED_RUNTIME_VERSION = '0.147.0';\nconst TESTED_PROTOCOL_VERSION = '1.0.0';\nconst EVIDENCE_DATE = '2026-08-12T00:00:00.000Z';\n\n/** Version-pinned Codex App Server client capability record. */\nexport const CodexCapabilityRecords: readonly RuntimeCapabilityRecord[] = Object.freeze([\n  mapRuntimeCapability({\n    runtime: 'codex',\n    pathId: CodexRuntimePaths.APP_SERVER,\n    protocol: 'codex-app-server-json-rpc',\n    testedVersions: {\n      runtime: TESTED_RUNTIME_VERSION,\n      protocol: TESTED_PROTOCOL_VERSION,\n    },\n    evidence: {\n      observedAt: EVIDENCE_DATE,\n      source: 'codex-app-server-client-observation',\n      completeMessage: CONFIRMED_YES,\n      atomicRenderDecision: CONFIRMED_YES,\n      safePresentationBoundary: CONFIRMED_YES,\n      append: CONFIRMED_NO,\n      sidecar: CONFIRMED_NO,\n    },\n  }),\n]);\n\n/** Create a Codex adapter with an App Server client-owned presentation boundary. */\nexport function createCodexRuntimeAdapter(\n  capabilities: readonly RuntimeCapabilityRecord[] = CodexCapabilityRecords,\n): RuntimeAdapter<CodexRuntimeEvent> {\n  const records = deepFreeze(structuredClone(capabilities));\n  return Object.freeze({\n    adapterVersion: 'runtime-adapter/1.0.0',\n    runtime: 'codex',\n    capabilities: records,\n    adapt(input: RuntimeAdapterInput<CodexRuntimeEvent>): RuntimeAdapterResult {\n      return adaptCodexEvent(records, input);\n    },\n    present(input: RuntimePresentationInput): RuntimePresentationResult {\n      return presentCodexDecision(records, input);\n    },\n  });\n}\n\n/** Default Codex App Server adapter. */\nexport const codexRuntimeAdapter = createCodexRuntimeAdapter();\n\nfunction adaptCodexEvent(\n  capabilities: readonly RuntimeCapabilityRecord[],\n  input: RuntimeAdapterInput<CodexRuntimeEvent>,\n): RuntimeAdapterResult {\n  const generation = mapRuntimeGeneration(input);\n  const record = findCapability(capabilities, input.envelope.pathId);\n  if (record === undefined) {\n    return exactEvent(capabilities, input, generation, null, RuntimeAdapterReasonCodes.UNSUPPORTED_PATH);\n  }\n  if (input.envelope.runtime !== 'codex' || input.envelope.protocol !== record.protocol) {\n    return exactEvent(capabilities, input, generation, null, RuntimeAdapterReasonCodes.INVALID_EVENT);\n  }\n  const compatibility = assessRuntimeCompatibility(\n    record,\n    input.envelope.runtimeVersion,\n    input.envelope.protocolVersion,\n  );\n  if (!compatibility.compatible) {\n    return exactEvent(capabilities, input, generation, null, compatibility.reasonCode);\n  }\n\n  const event = createEventEnvelope(input, record);\n  if (!validateEventEnvelope(event).success) {\n    return exactEvent(capabilities, input, generation, null, RuntimeAdapterReasonCodes.INVALID_EVENT);\n  }\n  const reasonCode = terminalReason(input.envelope.event);\n  if (reasonCode !== RuntimeAdapterReasonCodes.NONE) {\n    return exactEvent(capabilities, input, generation, event, reasonCode);\n  }\n  return deepFreeze({\n    status: 'mapped',\n    reasonCode: RuntimeAdapterReasonCodes.NONE,\n    generation,\n    event,\n    exactOriginal: null,\n    presentationTier: record.presentationTier,\n    telemetry: telemetry(record, 'mapped', RuntimeAdapterReasonCodes.NONE),\n  });\n}\n\nfunction createEventEnvelope(\n  input: RuntimeAdapterInput<CodexRuntimeEvent>,\n  record: RuntimeCapabilityRecord,\n): EventEnvelope {\n  const runtimeEvent = input.envelope.event;\n  const lifecycle = lifecycleFor(runtimeEvent);\n  const originalId = input.canonical.exactOriginal.originalId;\n  const isExtension = runtimeEvent.type === CodexEventTypes.EXTENSION;\n  const isContent = isContentEvent(runtimeEvent);\n  return deepFreeze({\n    contractKind: 'event',\n    schemaVersion: '1.0.0',\n    runtime: 'codex',\n    runtimeVersion: input.envelope.runtimeVersion,\n    adapterSchemaVersion: '1.0.0',\n    sessionId: input.envelope.sessionId,\n    turnId: input.envelope.turnId,\n    messageId: input.envelope.messageId,\n    itemId: isContent ? runtimeEvent.itemId : null,\n    partId: runtimeEvent.type === CodexEventTypes.AGENT_MESSAGE_DELTA\n      ? `part-${runtimeEvent.index}`\n      : null,\n    toolCallId: isContent ? runtimeEvent.toolCallId : null,\n    parentId: null,\n    eventId: runtimeEvent.eventId,\n    kind: lifecycle.kind,\n    phase: lifecycle.phase,\n    sourceTimestamp: runtimeEvent.sourceTimestamp,\n    order: {\n      sourceSequence: runtimeEvent.index,\n      arrivalIndex: runtimeEvent.index,\n      assemblyIndex: null,\n    },\n    canonicalPayloadRef: originalId,\n    payload: isExtension ? {} : payloadFor(runtimeEvent, originalId),\n    extensions: isExtension\n      ? { [runtimeEvent.namespace]: structuredClone(runtimeEvent.value) }\n      : {},\n    terminalStatus: lifecycle.terminalStatus,\n    capabilityConfidence: record.evidence.safePresentationBoundary.confidence,\n  });\n}\n\nfunction lifecycleFor(event: CodexRuntimeEvent): Pick<\n  EventEnvelope,\n  'kind' | 'phase' | 'terminalStatus'\n> {\n  switch (event.type) {\n    case CodexEventTypes.AGENT_MESSAGE_DELTA:\n      return { kind: EventKinds.ASSISTANT_MESSAGE_DELTA, phase: EventPhases.STREAMING, terminalStatus: TerminalStatuses.NONE };\n    case CodexEventTypes.AGENT_MESSAGE:\n      return { kind: EventKinds.ASSISTANT_MESSAGE, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED };\n    case CodexEventTypes.TOOL_CALL:\n      return { kind: EventKinds.TOOL_CALL, phase: EventPhases.CREATED, terminalStatus: TerminalStatuses.NONE };\n    case CodexEventTypes.TOOL_RESULT:\n      return { kind: EventKinds.TOOL_RESULT, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED };\n    case CodexEventTypes.THREAD_STARTED:\n      return { kind: EventKinds.EXTENSION, phase: EventPhases.CREATED, terminalStatus: TerminalStatuses.NONE };\n    case CodexEventTypes.TURN_COMPLETED:\n      return { kind: EventKinds.EXTENSION, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED };\n    case CodexEventTypes.CANCELLED:\n      return { kind: EventKinds.CANCELLATION, phase: EventPhases.CANCELLED, terminalStatus: TerminalStatuses.CANCELLED };\n    case CodexEventTypes.DISCONNECT:\n    case CodexEventTypes.ERROR:\n    case CodexEventTypes.TIMEOUT:\n      return { kind: EventKinds.ERROR, phase: EventPhases.FAILED, terminalStatus: TerminalStatuses.FAILED };\n    case CodexEventTypes.EXTENSION:\n      return event.final\n        ? { kind: EventKinds.EXTENSION, phase: EventPhases.FINAL, terminalStatus: TerminalStatuses.COMPLETED }\n        : { kind: EventKinds.EXTENSION, phase: EventPhases.STREAMING, terminalStatus: TerminalStatuses.NONE };\n  }\n}\n\nfunction payloadFor(event: CodexRuntimeEvent, originalId: string): JsonObject {\n  switch (event.type) {\n    case CodexEventTypes.AGENT_MESSAGE:\n    case CodexEventTypes.AGENT_MESSAGE_DELTA:\n      return Object.freeze({ textOriginalId: originalId });\n    case CodexEventTypes.TOOL_CALL:\n      return Object.freeze({ toolInputOriginalId: originalId });\n    case CodexEventTypes.TOOL_RESULT:\n      return Object.freeze({ toolResultOriginalId: originalId });\n    case CodexEventTypes.THREAD_STARTED:\n    case CodexEventTypes.TURN_COMPLETED:\n      return Object.freeze({ lifecycleOriginalId: originalId });\n    case CodexEventTypes.CANCELLED:\n      return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.CANCELLED });\n    case CodexEventTypes.DISCONNECT:\n      return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.DISCONNECTED });\n    case CodexEventTypes.ERROR:\n      return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.RUNTIME_FAILURE });\n    case CodexEventTypes.TIMEOUT:\n      return Object.freeze({ reasonCode: RuntimeAdapterReasonCodes.TIMEOUT });\n    case CodexEventTypes.EXTENSION:\n      return Object.freeze({});\n  }\n}\n\nfunction terminalReason(event: CodexRuntimeEvent): RuntimeAdapterReasonCode {\n  switch (event.type) {\n    case CodexEventTypes.CANCELLED:\n      return RuntimeAdapterReasonCodes.CANCELLED;\n    case CodexEventTypes.DISCONNECT:\n      return RuntimeAdapterReasonCodes.DISCONNECTED;\n    case CodexEventTypes.ERROR:\n      return RuntimeAdapterReasonCodes.RUNTIME_FAILURE;\n    case CodexEventTypes.TIMEOUT:\n      return RuntimeAdapterReasonCodes.TIMEOUT;\n    default:\n      return RuntimeAdapterReasonCodes.NONE;\n  }\n}\n\nfunction presentCodexDecision(\n  capabilities: readonly RuntimeCapabilityRecord[],\n  input: RuntimePresentationInput,\n): RuntimePresentationResult {\n  const record = findCapability(capabilities, input.pathId);\n  if (record === undefined) {\n    return exactPresentation(capabilities, input, RuntimeAdapterReasonCodes.UNSUPPORTED_PATH);\n  }\n  const compatibility = assessRuntimeCompatibility(record, input.runtimeVersion, input.protocolVersion);\n  if (!compatibility.compatible) {\n    return exactPresentation(capabilities, input, compatibility.reasonCode);\n  }\n  if (input.renderDecision.status !== 'projection') {\n    return exactPresentation(capabilities, input, RuntimeAdapterReasonCodes.PROJECTION_REJECTED);\n  }\n  if (record.presentationTier !== 'full-projection' || input.renderDecision.mode !== RenderModes.ATOMIC_REPLACE) {\n    return exactPresentation(capabilities, input, RuntimeAdapterReasonCodes.UNSUPPORTED_PRESENTATION);\n  }\n  return deepFreeze({\n    status: 'projection',\n    mode: 'atomic-replace',\n    reasonCode: RuntimeAdapterReasonCodes.NONE,\n    presentationTier: 'full-projection',\n    exactOriginal: input.renderDecision.exactOriginal,\n    projectionText: input.renderDecision.projectionText,\n    originalSuppressed: true,\n    telemetry: telemetry(record, 'projection', RuntimeAdapterReasonCodes.NONE),\n  });\n}\n\nfunction exactEvent(\n  capabilities: readonly RuntimeCapabilityRecord[],\n  input: RuntimeAdapterInput<CodexRuntimeEvent>,\n  generation: ReturnType<typeof mapRuntimeGeneration>,\n  event: EventEnvelope | null,\n  reasonCode: Exclude<RuntimeAdapterReasonCode, 'none'>,\n): RuntimeAdapterResult {\n  return deepFreeze({\n    status: 'exact-original',\n    reasonCode,\n    generation,\n    event,\n    exactOriginal: input.canonical.exactOriginal,\n    presentationTier: 'safe-native',\n    telemetry: telemetryFor(\n      capabilities,\n      input.envelope.pathId,\n      'safe-native',\n      'exact-original',\n      reasonCode,\n    ),\n  });\n}\n\nfunction exactPresentation(\n  capabilities: readonly RuntimeCapabilityRecord[],\n  input: RuntimePresentationInput,\n  reasonCode: Exclude<RuntimeAdapterReasonCode, 'none'>,\n): RuntimeExactOriginalPresentation {\n  return deepFreeze({\n    status: 'exact-original',\n    mode: 'original-only',\n    reasonCode,\n    presentationTier: 'safe-native',\n    exactOriginal: input.renderDecision.exactOriginal,\n    projectionText: null,\n    originalSuppressed: false,\n    telemetry: telemetryFor(\n      capabilities,\n      input.pathId,\n      'safe-native',\n      'exact-original',\n      reasonCode,\n    ),\n  });\n}\n\nfunction isContentEvent(event: CodexRuntimeEvent): event is CodexContentEvent {\n  return event.type === CodexEventTypes.AGENT_MESSAGE\n    || event.type === CodexEventTypes.AGENT_MESSAGE_DELTA\n    || event.type === CodexEventTypes.TOOL_CALL\n    || event.type === CodexEventTypes.TOOL_RESULT;\n}\n\nfunction findCapability(\n  capabilities: readonly RuntimeCapabilityRecord[],\n  pathId: string,\n): RuntimeCapabilityRecord | undefined {\n  return capabilities.find((record) => record.runtime === 'codex' && record.pathId === pathId);\n}\n\nfunction telemetry(\n  record: RuntimeCapabilityRecord,\n  status: RuntimeTelemetryRecord['status'],\n  reasonCode: RuntimeAdapterReasonCode,\n): RuntimeTelemetryRecord {\n  return telemetryFor([record], record.pathId, record.presentationTier, status, reasonCode);\n}\n\nfunction telemetryFor(\n  capabilities: readonly RuntimeCapabilityRecord[],\n  pathId: string,\n  tier: PresentationTier,\n  status: RuntimeTelemetryRecord['status'],\n  reasonCode: RuntimeAdapterReasonCode,\n): RuntimeTelemetryRecord {\n  return Object.freeze({\n    telemetryVersion: 'runtime-telemetry/1.0.0',\n    eventName: 'runtime-adapter-terminal',\n    runtime: 'codex',\n    pathId: sanitizeRuntimeTelemetryPathId(pathId, capabilities),\n    presentationTier: tier,\n    status,\n    reasonCode,\n  });\n}","lineStart":1,"lineEnd":426,"totalLines":426,"truncated":false}},"title":"packages/cli-communication-projection/src/runtimes/codex.ts","time":{"start":1786569355178,"end":1786569355184}},"id":"prt_ff7d4ed65001j1ZwFIPCnJT1DN","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7d4d594001UH4u1AESG2STzO"}}
{"type":"tool_use","timestamp":1786569355725,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_6aSVgvY9O3NWY0zj48yK9348","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/core/assembler.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/core/assembler.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Generation-Keyed Message Assembly\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { TerminalStatuses } from '../contracts/event.js';\n6: import {\n7:   validateExactOriginal,\n8: } from '../contracts/validate-event.js';\n9: import {\n10:   completeAssembly,\n11:   createAssemblySnapshot,\n12:   createEmptyFallback,\n13:   createFallbackAssembly,\n14:   freezeExactOriginal,\n15: } from './assembly-output.js';\n16: import {\n17:   parseIngestEventInput,\n18:   parseMessageAssemblerOptions,\n19:   parseStartGenerationInput,\n20: } from './assembly-input.js';\n21: import { AssemblyReasonCodes } from './assembly-types.js';\n22: import {\n23:   createNormalizedSequenceDigest,\n24:   normalizeEvent,\n25: } from './normalizer.js';\n26: \n27: import type { ValidationIssue } from '../contracts/common.js';\n28: import type { EventEnvelope } from '../contracts/event.js';\n29: import type { ExactOriginalRecord } from '../contracts/exact-original.js';\n30: import type {\n31:   AssemblyReasonCode,\n32:   AssemblyRejection,\n33:   AssemblyTerminalBase,\n34:   AssemblyTerminalResult,\n35:   BufferedAssemblyEvent,\n36:   ExactOriginalAssembly,\n37:   GenerationKey,\n38:   IngestEventResult,\n39:   StartGenerationResult,\n40: } from './assembly-types.js';\n41: import type { ResolvedAssemblerOptions } from './assembly-input.js';\n42: \n43: interface ActiveGeneration {\n44:   readonly key: GenerationKey;\n45:   readonly keyId: string;\n46:   readonly exactOriginal: ExactOriginalRecord;\n47:   readonly startedAtMs: number;\n48:   lastActivityAtMs: number;\n49:   inputByteCount: number;\n50:   readonly events: BufferedAssemblyEvent[];\n51:   readonly eventDigests: Map<string, string>;\n52:   readonly sourceSequences: Map<number, string>;\n53: }\n54: \n55: interface TerminalMarker {\n56:   readonly reasonCode: AssemblyReasonCode;\n57: }\n58: \n59: /** Deterministic, bounded state machine for complete-message assembly. */\n60: export class MessageAssembler {\n61:   private readonly options: ResolvedAssemblerOptions;\n62:   private readonly active = new Map<string, ActiveGeneration>();\n63:   private readonly terminal = new Map<string, TerminalMarker>();\n64:   private readonly terminalOrder: string[] = [];\n65: \n66:   /** Create an assembler with explicit finite resource bounds. */\n67:   public constructor(options: unknown = {}) {\n68:     this.options = parseMessageAssemblerOptions(options);\n69:   }\n70: \n71:   /** Open a new generation without sharing buffers with prior attempts. */\n72:   public startGeneration(input: unknown): StartGenerationResult {\n73:     const inputResult = parseStartGenerationInput(input);\n74:     if (!inputResult.success) {\n75:       return rejection(input, inputResult.issues);\n76:     }\n77:     const request = inputResult.value;\n78: \n79:     const key = freezeKey(request.key);\n80:     const keyId = serializeGenerationKey(key);\n81:     const terminalMarker = this.terminal.get(keyId);\n82:     if (terminalMarker !== undefined) {\n83:       return Object.freeze({\n84:         status: 'ignored-terminal',\n85:         reasonCode: terminalMarker.reasonCode,\n86:       });\n87:     }\n88:     if (this.active.has(keyId)) {\n89:       return rejection(input, [{\n90:         path: '$.key',\n91:         code: 'duplicate_generation',\n92:         message: 'Generation is already active.',\n93:       }]);\n94:     }\n95: \n96:     const exactOriginal = freezeExactOriginal(request.exactOriginal);\n97:     if (key.attempt > this.options.maxAttempts) {\n98:       const result = createEmptyFallback(\n99:         key,\n100:         exactOriginal,\n101:         AssemblyReasonCodes.RETRY_LIMIT,\n102:         request.startedAtMs,\n103:       );\n104:       this.rememberTerminal(keyId, result.reasonCode);\n105:       return Object.freeze({ status: 'terminal', result });\n106:     }\n107: \n108:     this.active.set(keyId, {\n109:       key,\n110:       keyId,\n111:       exactOriginal,\n112:       startedAtMs: request.startedAtMs,\n113:       lastActivityAtMs: request.startedAtMs,\n114:       inputByteCount: 0,\n115:       events: [],\n116:       eventDigests: new Map(),\n117:       sourceSequences: new Map(),\n118:     });\n119:     return Object.freeze({ status: 'started', key });\n120:   }\n121: \n122:   /** Add an event, applying idempotence, ordering, lifecycle, and bound rules. */\n123:   public ingestEvent(input: unknown): IngestEventResult {\n124:     const inputResult = parseIngestEventInput(input);\n125:     if (!inputResult.success) {\n126:       return rejection(input, inputResult.issues);\n127:     }\n128:     const request = inputResult.value;\n129:     const keyId = serializeGenerationKey(request.key);\n130:     const terminalMarker = this.terminal.get(keyId);\n131:     if (terminalMarker !== undefined) {\n132:       return Object.freeze({\n133:         status: 'ignored-terminal',\n134:         reasonCode: terminalMarker.reasonCode,\n135:       });\n136:     }\n137: \n138:     const state = this.active.get(keyId);\n139:     if (state === undefined) {\n140:       return rejection(input, [{\n141:         path: '$.key',\n142:         code: 'unknown_generation',\n143:         message: 'Generation is not active.',\n144:       }]);\n145:     }\n146: \n147:     const issues: ValidationIssue[] = [];\n148:     if (request.observedAtMs < state.lastActivityAtMs) {\n149:       issues.push({\n150:         path: '$.observedAtMs',\n151:         code: 'non_monotonic_time',\n152:         message: 'Observed time cannot move backwards within a generation.',\n153:       });\n154:     }\n155:     const eventResult = normalizeEvent(request.event);\n156:     if (!eventResult.success) {\n157:       issues.push(...prefixIssues('$.event', eventResult.issues));\n158:     }\n159:     const originalResult = validateExactOriginal(request.original);\n160:     if (!originalResult.success) {\n161:       issues.push(...prefixIssues('$.original', originalResult.issues));\n162:     }\n163:     if (eventResult.success) {\n164:       issues.push(...validateEventIdentity(state.key, eventResult.value));\n165:     }\n166:     if (\n167:       eventResult.success\n168:       && originalResult.success\n169:       && eventResult.value.canonicalPayloadRef !== originalResult.value.originalId\n170:     ) {\n171:       issues.push({\n172:         path: '$.original.originalId',\n173:         code: 'canonical_reference',\n174:         message: 'Canonical bytes must match the event payload reference.',\n175:       });\n176:     }\n177:     if (issues.length > 0 || !eventResult.success || !originalResult.success) {\n178:       return Object.freeze({\n179:         status: 'terminal',\n180:         result: this.finalize(\n181:           state,\n182:           AssemblyReasonCodes.INVALID_INPUT,\n183:           Math.max(request.observedAtMs, state.lastActivityAtMs),\n184:         ),\n185:       });\n186:     }\n187: \n188:     const event = eventResult.value;\n189:     const digest = createNormalizedSequenceDigest([event]);\n190:     const existingDigest = state.eventDigests.get(event.eventId);\n191:     if (existingDigest !== undefined) {\n192:       if (existingDigest === digest) {\n193:         return Object.freeze({ status: 'duplicate', eventId: event.eventId });\n194:       }\n195:       return Object.freeze({\n196:         status: 'terminal',\n197:         result: this.finalize(\n198:           state,\n199:           AssemblyReasonCodes.CONFLICTING_DUPLICATE,\n200:           request.observedAtMs,\n201:         ),\n202:       });\n203:     }\n204: \n205:     const sourceSequence = event.order.sourceSequence;\n206:     if (sourceSequence !== null && state.sourceSequences.has(sourceSequence)) {\n207:       return Object.freeze({\n208:         status: 'terminal',\n209:         result: this.finalize(\n210:           state,\n211:           AssemblyReasonCodes.CONFLICTING_DUPLICATE,\n212:           request.observedAtMs,\n213:         ),\n214:       });\n215:     }\n216:     if (state.events.length + 1 > this.options.maxEvents) {\n217:       return Object.freeze({\n218:         status: 'terminal',\n219:         result: this.finalize(state, AssemblyReasonCodes.EVENT_LIMIT, request.observedAtMs),\n220:       });\n221:     }\n222:     if (state.inputByteCount + originalResult.value.byteLength > this.options.maxBytes) {\n223:       return Object.freeze({\n224:         status: 'terminal',\n225:         result: this.finalize(state, AssemblyReasonCodes.BYTE_LIMIT, request.observedAtMs),\n226:       });\n227:     }\n228: \n229:     state.events.push({\n230:       event,\n231:       original: freezeExactOriginal(originalResult.value),\n232:     });\n233:     state.eventDigests.set(event.eventId, digest);\n234:     if (sourceSequence !== null) {\n235:       state.sourceSequences.set(sourceSequence, event.eventId);\n236:     }\n237:     state.inputByteCount += originalResult.value.byteLength;\n238:     state.lastActivityAtMs = request.observedAtMs;\n239: \n240:     if (event.terminalStatus === TerminalStatuses.CANCELLED) {\n241:       return Object.freeze({\n242:         status: 'terminal',\n243:         result: this.finalize(state, AssemblyReasonCodes.CANCELLED, request.observedAtMs),\n244:       });\n245:     }\n246:     if (event.terminalStatus === TerminalStatuses.FAILED) {\n247:       return Object.freeze({\n248:         status: 'terminal',\n249:         result: this.finalize(state, AssemblyReasonCodes.SOURCE_FAILED, request.observedAtMs),\n250:       });\n251:     }\n252:     if (event.terminalStatus === TerminalStatuses.COMPLETED) {\n253:       return Object.freeze({\n254:         status: 'terminal',\n255:         result: this.finalize(state, AssemblyReasonCodes.COMPLETED, request.observedAtMs),\n256:       });\n257:     }\n258: \n259:     return Object.freeze({ status: 'accepted', eventId: event.eventId });\n260:   }\n261: \n262:   /** Expire every idle generation without allocating live timer handles. */\n263:   public expireIdle(nowMs: number): readonly ExactOriginalAssembly[] {\n264:     if (!Number.isFinite(nowMs) || nowMs < 0) {\n265:       throw new RangeError('nowMs must be a non-negative finite number.');\n266:     }\n267:     const results: ExactOriginalAssembly[] = [];\n268:     for (const state of [...this.active.values()]) {\n269:       if (nowMs - state.lastActivityAtMs >= this.options.idleTimeoutMs) {\n270:         const result = this.finalize(state, AssemblyReasonCodes.TIMEOUT, nowMs);\n271:         if (result.status !== 'exact-original') {\n272:           throw new Error('Idle expiry cannot produce a completed assembly.');\n273:         }\n274:         results.push(result);\n275:       }\n276:     }\n277:     return Object.freeze(results);\n278:   }\n279: \n280:   /** Number of generations that still retain mutable buffers. */\n281:   public get activeGenerationCount(): number {\n282:     return this.active.size;\n283:   }\n284: \n285:   /** Number of bounded content-free tombstones retained for late-event suppression. */\n286:   public get terminalGenerationCount(): number {\n287:     return this.terminal.size;\n288:   }\n289: \n290:   private finalize(\n291:     state: ActiveGeneration,\n292:     reasonCode: AssemblyReasonCode,\n293:     terminalAtMs: number,\n294:   ): AssemblyTerminalResult {\n295:     this.active.delete(state.keyId);\n296:     const snapshot = createAssemblySnapshot(state.events);\n297:     const base: AssemblyTerminalBase = {\n298:       key: state.key,\n299:       reasonCode,\n300:       exactOriginal: state.exactOriginal,\n301:       events: snapshot.events,\n302:       order: snapshot.order,\n303:       startedAtMs: state.startedAtMs,\n304:       terminalAtMs,\n305:       durationMs: Math.max(0, terminalAtMs - state.startedAtMs),\n306:       inputByteCount: state.inputByteCount,\n307:       outputByteCount: state.exactOriginal.byteLength,\n308:     };\n309: \n310:     const result = reasonCode === AssemblyReasonCodes.COMPLETED\n311:       ? completeAssembly(base, snapshot.buffered)\n312:       : createFallbackAssembly(base, reasonCode);\n313:     this.rememberTerminal(state.keyId, result.reasonCode);\n314:     return result;\n315:   }\n316: \n317:   private rememberTerminal(keyId: string, reasonCode: AssemblyReasonCode): void {\n318:     this.terminal.set(keyId, Object.freeze({ reasonCode }));\n319:     this.terminalOrder.push(keyId);\n320:     while (this.terminalOrder.length > this.options.maxTerminalGenerations) {\n321:       const oldest = this.terminalOrder.shift();\n322:       if (oldest !== undefined) {\n323:         this.terminal.delete(oldest);\n324:       }\n325:     }\n326:   }\n327: }\n328: \n329: /** Serialize a generation identity without delimiter ambiguity. */\n330: export function serializeGenerationKey(key: GenerationKey): string {\n331:   return JSON.stringify([\n332:     key.runtime,\n333:     key.sessionId,\n334:     key.turnId,\n335:     key.messageId,\n336:     key.generationId,\n337:     key.attempt,\n338:   ]);\n339: }\n340: \n341: function validateEventIdentity(\n342:   key: GenerationKey,\n343:   event: EventEnvelope,\n344: ): ValidationIssue[] {\n345:   const issues: ValidationIssue[] = [];\n346:   const coordinates: readonly [string, string | null, string][] = [\n347:     ['runtime', event.runtime, key.runtime],\n348:     ['sessionId', event.sessionId, key.sessionId],\n349:     ['turnId', event.turnId, key.turnId],\n350:     ['messageId', event.messageId, key.messageId],\n351:   ];\n352:   for (const [field, observed, expected] of coordinates) {\n353:     if (observed !== expected) {\n354:       issues.push({\n355:         path: `$.event.${field}`,\n356:         code: 'generation_identity',\n357:         message: 'Event identity does not match the active generation.',\n358:       });\n359:     }\n360:   }\n361:   return issues;\n362: }\n363: \n364: function freezeKey(key: GenerationKey): GenerationKey {\n365:   return Object.freeze({ ...key });\n366: }\n367: \n368: function prefixIssues(\n369:   prefix: string,\n370:   issues: readonly ValidationIssue[],\n371: ): ValidationIssue[] {\n372:   return issues.map((issue) => ({\n373:     ...issue,\n374:     path: issue.path === '$' ? prefix : `${prefix}${issue.path.slice(1)}`,\n375:   }));\n376: }\n377: \n378: function rejection(\n379:   originalInput: unknown,\n380:   issues: readonly ValidationIssue[],\n381: ): AssemblyRejection {\n382:   return Object.freeze({\n383:     status: 'rejected',\n384:     reasonCode: AssemblyReasonCodes.INVALID_INPUT,\n385:     issues: Object.freeze([...issues]),\n386:     originalInput,\n387:   });\n388: }\n\n(End of file - total 388 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Generation-Keyed Message Assembly\n// ───────────────────────────────────────────────────────────────────\n\nimport { TerminalStatuses } from '../contracts/event.js';\nimport {\n  validateExactOriginal,\n} from '../contracts/validate-event.js';\nimport {\n  completeAssembly,\n  createAssemblySnapshot,\n  createEmptyFallback,\n  createFallbackAssembly,\n  freezeExactOriginal,\n} from './assembly-output.js';\nimport {\n  parseIngestEventInput,\n  parseMessageAssemblerOptions,\n  parseStartGenerationInput,\n} from './assembly-input.js';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/core/assembler.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Generation-Keyed Message Assembly\n// ───────────────────────────────────────────────────────────────────\n\nimport { TerminalStatuses } from '../contracts/event.js';\nimport {\n  validateExactOriginal,\n} from '../contracts/validate-event.js';\nimport {\n  completeAssembly,\n  createAssemblySnapshot,\n  createEmptyFallback,\n  createFallbackAssembly,\n  freezeExactOriginal,\n} from './assembly-output.js';\nimport {\n  parseIngestEventInput,\n  parseMessageAssemblerOptions,\n  parseStartGenerationInput,\n} from './assembly-input.js';\nimport { AssemblyReasonCodes } from './assembly-types.js';\nimport {\n  createNormalizedSequenceDigest,\n  normalizeEvent,\n} from './normalizer.js';\n\nimport type { ValidationIssue } from '../contracts/common.js';\nimport type { EventEnvelope } from '../contracts/event.js';\nimport type { ExactOriginalRecord } from '../contracts/exact-original.js';\nimport type {\n  AssemblyReasonCode,\n  AssemblyRejection,\n  AssemblyTerminalBase,\n  AssemblyTerminalResult,\n  BufferedAssemblyEvent,\n  ExactOriginalAssembly,\n  GenerationKey,\n  IngestEventResult,\n  StartGenerationResult,\n} from './assembly-types.js';\nimport type { ResolvedAssemblerOptions } from './assembly-input.js';\n\ninterface ActiveGeneration {\n  readonly key: GenerationKey;\n  readonly keyId: string;\n  readonly exactOriginal: ExactOriginalRecord;\n  readonly startedAtMs: number;\n  lastActivityAtMs: number;\n  inputByteCount: number;\n  readonly events: BufferedAssemblyEvent[];\n  readonly eventDigests: Map<string, string>;\n  readonly sourceSequences: Map<number, string>;\n}\n\ninterface TerminalMarker {\n  readonly reasonCode: AssemblyReasonCode;\n}\n\n/** Deterministic, bounded state machine for complete-message assembly. */\nexport class MessageAssembler {\n  private readonly options: ResolvedAssemblerOptions;\n  private readonly active = new Map<string, ActiveGeneration>();\n  private readonly terminal = new Map<string, TerminalMarker>();\n  private readonly terminalOrder: string[] = [];\n\n  /** Create an assembler with explicit finite resource bounds. */\n  public constructor(options: unknown = {}) {\n    this.options = parseMessageAssemblerOptions(options);\n  }\n\n  /** Open a new generation without sharing buffers with prior attempts. */\n  public startGeneration(input: unknown): StartGenerationResult {\n    const inputResult = parseStartGenerationInput(input);\n    if (!inputResult.success) {\n      return rejection(input, inputResult.issues);\n    }\n    const request = inputResult.value;\n\n    const key = freezeKey(request.key);\n    const keyId = serializeGenerationKey(key);\n    const terminalMarker = this.terminal.get(keyId);\n    if (terminalMarker !== undefined) {\n      return Object.freeze({\n        status: 'ignored-terminal',\n        reasonCode: terminalMarker.reasonCode,\n      });\n    }\n    if (this.active.has(keyId)) {\n      return rejection(input, [{\n        path: '$.key',\n        code: 'duplicate_generation',\n        message: 'Generation is already active.',\n      }]);\n    }\n\n    const exactOriginal = freezeExactOriginal(request.exactOriginal);\n    if (key.attempt > this.options.maxAttempts) {\n      const result = createEmptyFallback(\n        key,\n        exactOriginal,\n        AssemblyReasonCodes.RETRY_LIMIT,\n        request.startedAtMs,\n      );\n      this.rememberTerminal(keyId, result.reasonCode);\n      return Object.freeze({ status: 'terminal', result });\n    }\n\n    this.active.set(keyId, {\n      key,\n      keyId,\n      exactOriginal,\n      startedAtMs: request.startedAtMs,\n      lastActivityAtMs: request.startedAtMs,\n      inputByteCount: 0,\n      events: [],\n      eventDigests: new Map(),\n      sourceSequences: new Map(),\n    });\n    return Object.freeze({ status: 'started', key });\n  }\n\n  /** Add an event, applying idempotence, ordering, lifecycle, and bound rules. */\n  public ingestEvent(input: unknown): IngestEventResult {\n    const inputResult = parseIngestEventInput(input);\n    if (!inputResult.success) {\n      return rejection(input, inputResult.issues);\n    }\n    const request = inputResult.value;\n    const keyId = serializeGenerationKey(request.key);\n    const terminalMarker = this.terminal.get(keyId);\n    if (terminalMarker !== undefined) {\n      return Object.freeze({\n        status: 'ignored-terminal',\n        reasonCode: terminalMarker.reasonCode,\n      });\n    }\n\n    const state = this.active.get(keyId);\n    if (state === undefined) {\n      return rejection(input, [{\n        path: '$.key',\n        code: 'unknown_generation',\n        message: 'Generation is not active.',\n      }]);\n    }\n\n    const issues: ValidationIssue[] = [];\n    if (request.observedAtMs < state.lastActivityAtMs) {\n      issues.push({\n        path: '$.observedAtMs',\n        code: 'non_monotonic_time',\n        message: 'Observed time cannot move backwards within a generation.',\n      });\n    }\n    const eventResult = normalizeEvent(request.event);\n    if (!eventResult.success) {\n      issues.push(...prefixIssues('$.event', eventResult.issues));\n    }\n    const originalResult = validateExactOriginal(request.original);\n    if (!originalResult.success) {\n      issues.push(...prefixIssues('$.original', originalResult.issues));\n    }\n    if (eventResult.success) {\n      issues.push(...validateEventIdentity(state.key, eventResult.value));\n    }\n    if (\n      eventResult.success\n      && originalResult.success\n      && eventResult.value.canonicalPayloadRef !== originalResult.value.originalId\n    ) {\n      issues.push({\n        path: '$.original.originalId',\n        code: 'canonical_reference',\n        message: 'Canonical bytes must match the event payload reference.',\n      });\n    }\n    if (issues.length > 0 || !eventResult.success || !originalResult.success) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(\n          state,\n          AssemblyReasonCodes.INVALID_INPUT,\n          Math.max(request.observedAtMs, state.lastActivityAtMs),\n        ),\n      });\n    }\n\n    const event = eventResult.value;\n    const digest = createNormalizedSequenceDigest([event]);\n    const existingDigest = state.eventDigests.get(event.eventId);\n    if (existingDigest !== undefined) {\n      if (existingDigest === digest) {\n        return Object.freeze({ status: 'duplicate', eventId: event.eventId });\n      }\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(\n          state,\n          AssemblyReasonCodes.CONFLICTING_DUPLICATE,\n          request.observedAtMs,\n        ),\n      });\n    }\n\n    const sourceSequence = event.order.sourceSequence;\n    if (sourceSequence !== null && state.sourceSequences.has(sourceSequence)) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(\n          state,\n          AssemblyReasonCodes.CONFLICTING_DUPLICATE,\n          request.observedAtMs,\n        ),\n      });\n    }\n    if (state.events.length + 1 > this.options.maxEvents) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(state, AssemblyReasonCodes.EVENT_LIMIT, request.observedAtMs),\n      });\n    }\n    if (state.inputByteCount + originalResult.value.byteLength > this.options.maxBytes) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(state, AssemblyReasonCodes.BYTE_LIMIT, request.observedAtMs),\n      });\n    }\n\n    state.events.push({\n      event,\n      original: freezeExactOriginal(originalResult.value),\n    });\n    state.eventDigests.set(event.eventId, digest);\n    if (sourceSequence !== null) {\n      state.sourceSequences.set(sourceSequence, event.eventId);\n    }\n    state.inputByteCount += originalResult.value.byteLength;\n    state.lastActivityAtMs = request.observedAtMs;\n\n    if (event.terminalStatus === TerminalStatuses.CANCELLED) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(state, AssemblyReasonCodes.CANCELLED, request.observedAtMs),\n      });\n    }\n    if (event.terminalStatus === TerminalStatuses.FAILED) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(state, AssemblyReasonCodes.SOURCE_FAILED, request.observedAtMs),\n      });\n    }\n    if (event.terminalStatus === TerminalStatuses.COMPLETED) {\n      return Object.freeze({\n        status: 'terminal',\n        result: this.finalize(state, AssemblyReasonCodes.COMPLETED, request.observedAtMs),\n      });\n    }\n\n    return Object.freeze({ status: 'accepted', eventId: event.eventId });\n  }\n\n  /** Expire every idle generation without allocating live timer handles. */\n  public expireIdle(nowMs: number): readonly ExactOriginalAssembly[] {\n    if (!Number.isFinite(nowMs) || nowMs < 0) {\n      throw new RangeError('nowMs must be a non-negative finite number.');\n    }\n    const results: ExactOriginalAssembly[] = [];\n    for (const state of [...this.active.values()]) {\n      if (nowMs - state.lastActivityAtMs >= this.options.idleTimeoutMs) {\n        const result = this.finalize(state, AssemblyReasonCodes.TIMEOUT, nowMs);\n        if (result.status !== 'exact-original') {\n          throw new Error('Idle expiry cannot produce a completed assembly.');\n        }\n        results.push(result);\n      }\n    }\n    return Object.freeze(results);\n  }\n\n  /** Number of generations that still retain mutable buffers. */\n  public get activeGenerationCount(): number {\n    return this.active.size;\n  }\n\n  /** Number of bounded content-free tombstones retained for late-event suppression. */\n  public get terminalGenerationCount(): number {\n    return this.terminal.size;\n  }\n\n  private finalize(\n    state: ActiveGeneration,\n    reasonCode: AssemblyReasonCode,\n    terminalAtMs: number,\n  ): AssemblyTerminalResult {\n    this.active.delete(state.keyId);\n    const snapshot = createAssemblySnapshot(state.events);\n    const base: AssemblyTerminalBase = {\n      key: state.key,\n      reasonCode,\n      exactOriginal: state.exactOriginal,\n      events: snapshot.events,\n      order: snapshot.order,\n      startedAtMs: state.startedAtMs,\n      terminalAtMs,\n      durationMs: Math.max(0, terminalAtMs - state.startedAtMs),\n      inputByteCount: state.inputByteCount,\n      outputByteCount: state.exactOriginal.byteLength,\n    };\n\n    const result = reasonCode === AssemblyReasonCodes.COMPLETED\n      ? completeAssembly(base, snapshot.buffered)\n      : createFallbackAssembly(base, reasonCode);\n    this.rememberTerminal(state.keyId, result.reasonCode);\n    return result;\n  }\n\n  private rememberTerminal(keyId: string, reasonCode: AssemblyReasonCode): void {\n    this.terminal.set(keyId, Object.freeze({ reasonCode }));\n    this.terminalOrder.push(keyId);\n    while (this.terminalOrder.length > this.options.maxTerminalGenerations) {\n      const oldest = this.terminalOrder.shift();\n      if (oldest !== undefined) {\n        this.terminal.delete(oldest);\n      }\n    }\n  }\n}\n\n/** Serialize a generation identity without delimiter ambiguity. */\nexport function serializeGenerationKey(key: GenerationKey): string {\n  return JSON.stringify([\n    key.runtime,\n    key.sessionId,\n    key.turnId,\n    key.messageId,\n    key.generationId,\n    key.attempt,\n  ]);\n}\n\nfunction validateEventIdentity(\n  key: GenerationKey,\n  event: EventEnvelope,\n): ValidationIssue[] {\n  const issues: ValidationIssue[] = [];\n  const coordinates: readonly [string, string | null, string][] = [\n    ['runtime', event.runtime, key.runtime],\n    ['sessionId', event.sessionId, key.sessionId],\n    ['turnId', event.turnId, key.turnId],\n    ['messageId', event.messageId, key.messageId],\n  ];\n  for (const [field, observed, expected] of coordinates) {\n    if (observed !== expected) {\n      issues.push({\n        path: `$.event.${field}`,\n        code: 'generation_identity',\n        message: 'Event identity does not match the active generation.',\n      });\n    }\n  }\n  return issues;\n}\n\nfunction freezeKey(key: GenerationKey): GenerationKey {\n  return Object.freeze({ ...key });\n}\n\nfunction prefixIssues(\n  prefix: string,\n  issues: readonly ValidationIssue[],\n): ValidationIssue[] {\n  return issues.map((issue) => ({\n    ...issue,\n    path: issue.path === '$' ? prefix : `${prefix}${issue.path.slice(1)}`,\n  }));\n}\n\nfunction rejection(\n  originalInput: unknown,\n  issues: readonly ValidationIssue[],\n): AssemblyRejection {\n  return Object.freeze({\n    status: 'rejected',\n    reasonCode: AssemblyReasonCodes.INVALID_INPUT,\n    issues: Object.freeze([...issues]),\n    originalInput,\n  });\n}","lineStart":1,"lineEnd":388,"totalLines":388,"truncated":false}},"title":"packages/cli-communication-projection/src/core/assembler.ts","time":{"start":1786569355718,"end":1786569355724}},"id":"prt_ff7d4effb001lJWCuUf2vDSoY1","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7d4d594001UH4u1AESG2STzO"}}
