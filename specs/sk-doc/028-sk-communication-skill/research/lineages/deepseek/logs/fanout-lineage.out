 Keep every fact, name, number, and file path. Use short sentences and everyday words. Leave fenced code blocks unchanged. Output ONLY the rewritten message with no preamble, labels, or commentary.\",\n72:         \"copyEditingScope\": \"assistant-message-only\",\n73:         \"protectedValuePolicyVersion\": \"protected-values-v1\",\n74:         \"temperature\": 0.3,\n75:         \"thinkingMode\": \"disabled\",\n76:         \"providerControlMappings\": [\n77:           {\n78:             \"providerId\": \"synthetic-no-controls\",\n79:             \"modelPattern\": \"*\",\n80:             \"control\": \"temperature\",\n81:             \"wireField\": null,\n82:             \"support\": \"no\",\n83:             \"confidence\": \"confirmed\"\n84:           },\n85:           {\n86:             \"providerId\": \"synthetic-no-controls\",\n87:             \"modelPattern\": \"*\",\n88:             \"control\": \"thinking\",\n89:             \"wireField\": null,\n90:             \"support\": \"no\",\n91:             \"confidence\": \"confirmed\"\n92:           }\n93:         ],\n94:         \"unsupportedControlBehavior\": \"exact-original\"\n95:       }\n96:     }\n97:   ]\n98: }\n\n(End of file - total 98 lines)\n</content>","metadata":{"preview":"{\n  \"fixtureSetVersion\": \"1.0.0\",\n  \"description\": \"Versioned synthetic prompt controls derived from the reference's narrow whole-message rewrite behavior.\",\n  \"cases\": [\n    {\n      \"fixtureId\": \"prompt-reference-like\",\n      \"schemaVersion\": \"1.0.0\",\n      \"sourceFamily\": \"phase-002-synthetic-contract-corpus\",\n      \"sourceVersion\": \"1.0.0\",\n      \"captureMethod\": \"synthetic\",\n      \"sanitizationStatus\": \"synthetic\",\n      \"expectedResult\": \"accept-when-controls-supported\",\n      \"record\": {\n        \"contractKind\": \"prompt-profile\",\n        \"schemaVersion\": \"1.0.0\",\n        \"promptVersion\": \"reference-like-v1\",\n        \"systemInstruction\": \"You rewrite the assistant's message into much simpler, plain English. Keep every fact, name, number, and file path. Use short sentences and everyday words. Leave fenced code blocks unchanged. Output ONLY the rewritten message with no preamble, labels, or commentary.\",\n        \"copyEditingScope\": \"assistant-message-only\",\n        \"protectedValuePolicyVersion\": \"protected-values-v1\",\n        \"temperature\": 0.3,","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/test/fixtures/prompt-profiles.json","text":"{\n  \"fixtureSetVersion\": \"1.0.0\",\n  \"description\": \"Versioned synthetic prompt controls derived from the reference's narrow whole-message rewrite behavior.\",\n  \"cases\": [\n    {\n      \"fixtureId\": \"prompt-reference-like\",\n      \"schemaVersion\": \"1.0.0\",\n      \"sourceFamily\": \"phase-002-synthetic-contract-corpus\",\n      \"sourceVersion\": \"1.0.0\",\n      \"captureMethod\": \"synthetic\",\n      \"sanitizationStatus\": \"synthetic\",\n      \"expectedResult\": \"accept-when-controls-supported\",\n      \"record\": {\n        \"contractKind\": \"prompt-profile\",\n        \"schemaVersion\": \"1.0.0\",\n        \"promptVersion\": \"reference-like-v1\",\n        \"systemInstruction\": \"You rewrite the assistant's message into much simpler, plain English. Keep every fact, name, number, and file path. Use short sentences and everyday words. Leave fenced code blocks unchanged. Output ONLY the rewritten message with no preamble, labels, or commentary.\",\n        \"copyEditingScope\": \"assistant-message-only\",\n        \"protectedValuePolicyVersion\": \"protected-values-v1\",\n        \"temperature\": 0.3,\n        \"thinkingMode\": \"disabled\",\n        \"providerControlMappings\": [\n          {\n            \"providerId\": \"opencode-go\",\n            \"modelPattern\": \"deepseek