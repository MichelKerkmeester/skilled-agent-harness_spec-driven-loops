{"type":"tool_use","timestamp":1786568935068,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_00_ztlFoc4WbgI1z46MsSqN5087","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/dialect.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/dialect.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Conservative Markdown Dialect\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { ProtectedSpanKinds } from './types.js';\n6: \n7: import type { ProtectedSpanKind } from './types.js';\n8: \n9: /** One non-overlapping source range selected for exact preservation. */\n10: export interface ProtectedSourceRange {\n11:   readonly start: number;\n12:   readonly end: number;\n13:   readonly kind: ProtectedSpanKind;\n14: }\n15: \n16: interface SourceLine {\n17:   readonly start: number;\n18:   readonly contentEnd: number;\n19:   readonly end: number;\n20:   readonly text: string;\n21: }\n22: \n23: const COMMAND_PREFIX = /^[ \\t]*(?:bun|cargo|deno|git|go|node|npm|npx|pnpm|python|python3|sh|bash|yarn)\\s+\\S/u;\n24: const TABLE_DELIMITER = /^[ \\t]*\\|?[ \\t]*:?-{3,}:?[ \\t]*(?:\\|[ \\t]*:?-{3,}:?[ \\t]*)+\\|?[ \\t]*$/u;\n25: \n26: /** Select technical and structural ranges using the pinned conservative dialect. */\n27: export function collectProtectedRanges(\n28:   sourceText: string,\n29:   configuredLiterals: readonly string[],\n30: ): readonly ProtectedSourceRange[] {\n31:   const ranges: ProtectedSourceRange[] = [];\n32:   const lines = createLines(sourceText);\n33:   const addRange = (\n34:     start: number,\n35:     end: number,\n36:     kind: ProtectedSpanKind,\n37:   ): boolean => {\n38:     if (start < 0 || end <= start || end > sourceText.length) {\n39:       return false;\n40:     }\n41:     if (ranges.some((range) => start < range.end && end > range.start)) {\n42:       return false;\n43:     }\n44:     ranges.push({ start, end, kind });\n45:     return true;\n46:   };\n47: \n48:   collectBlockRanges(lines, sourceText.length, addRange);\n49:   collectConfiguredRanges(sourceText, configuredLiterals, addRange);\n50:   collectInlineRanges(sourceText, addRange);\n51: \n52:   return Object.freeze(ranges.sort((left, right) =>\n53:     left.start - right.start || left.end - right.end));\n54: }\n55: \n56: /** Create a stable structural signature without retaining prose. */\n57: export function createMarkdownStructureSignature(sourceText: string): string {\n58:   const lines = createLines(sourceText);\n59:   const headings: string[] = [];\n60:   const lists: string[] = [];\n61:   const quotes: number[] = [];\n62:   const fences: string[] = [];\n63:   const tables: string[] = [];\n64: \n65:   for (let index = 0; index < lines.length; index += 1) {\n66:     const line = lines[index];\n67:     if (line === undefined) {\n68:       continue;\n69:     }\n70:     const atx = line.text.match(/^[ \\t]{0,3}(#{1,6})(?:[ \\t]+|$)/u);\n71:     if (atx?.[1] !== undefined) {\n72:       headings.push(`atx:${atx[1].length}`);\n73:     }\n74:     const next = lines[index + 1];\n75:     if (line.text.trim().length > 0 && next !== undefined) {\n76:       const setext = next.text.match(/^[ \\t]{0,3}(=+|-+)[ \\t]*$/u);\n77:       if (setext?.[1] !== undefined) {\n78:         headings.push(`setext:${setext[1].startsWith('=') ? 1 : 2}`);\n79:       }\n80:     }\n81:     const list = line.text.match(/^([ \\t]*)([-+*]|\\d+[.)])[ \\t]+/u);\n82:     if (list?.[1] !== undefined && list[2] !== undefined) {\n83:       lists.push(`${indentWidth(list[1])}:${/^\\d/u.test(list[2]) ? 'ordered' : list[2]}`);\n84:     }\n85:     const quote = line.text.match(/^[ \\t]*(>+(?:[ \\t]|$))/u);\n86:     if (quote?.[1] !== undefined) {\n87:       quotes.push((quote[1].match(/>/gu) ?? []).length);\n88:     }\n89:     const fence = line.text.match(/^[ \\t]{0,3}(`{3,}|~{3,})([^`]*)$/u);\n90:     if (fence?.[1] !== undefined) {\n91:       fences.push(`${fence[1][0]}:${fence[1].length}:${(fence[2] ?? '').trim()}`);\n92:     }\n93:     if (next !== undefined && line.text.includes('|') && TABLE_DELIMITER.test(next.text)) {\n94:       let rowCount = 2;\n95:       let cursor = index + 2;\n96:       while (cursor < lines.length && (lines[cursor]?.text.includes('|') ?? false)) {\n97:         rowCount += 1;\n98:         cursor += 1;\n99:       }\n100:       tables.push(`${countTableCells(line.text)}x${rowCount}`);\n101:     }\n102:   }\n103: \n104:   return JSON.stringify({\n105:     headings,\n106:     lists,\n107:     quotes,\n108:     fences,\n109:     tables,\n110:     links: countPattern(sourceText, /!?\\[[^\\]\\n]*\\]\\([^\\n)]+\\)/gu),\n111:     referenceLinks: countPattern(sourceText, /!?\\[[^\\]\\n]+\\]\\[[^\\]\\n]*\\]/gu),\n112:     inlineCode: countPattern(sourceText, /(`+)([^`]|`(?!\\1))*?\\1/gu),\n113:     html: countPattern(sourceText, /<(?:!--[\\s\\S]*?--|\\/?[A-Za-z][^>\\n]*)>/gu),\n114:   });\n115: }\n116: \n117: /** Reject strings that cannot round trip through strict UTF-8 text semantics. */\n118: export function hasUnpairedSurrogate(value: string): boolean {\n119:   for (let index = 0; index < value.length; index += 1) {\n120:     const code = value.charCodeAt(index);\n121:     if (code >= 0xD800 && code <= 0xDBFF) {\n122:       const next = value.charCodeAt(index + 1);\n123:       if (!(next >= 0xDC00 && next <= 0xDFFF)) {\n124:         return true;\n125:       }\n126:       index += 1;\n127:     } else if (code >= 0xDC00 && code <= 0xDFFF) {\n128:       return true;\n129:     }\n130:   }\n131:   return false;\n132: }\n133: \n134: function collectBlockRanges(\n135:   lines: readonly SourceLine[],\n136:   sourceLength: number,\n137:   addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n138: ): void {\n139:   for (let index = 0; index < lines.length; index += 1) {\n140:     const line = lines[index];\n141:     if (line === undefined) {\n142:       continue;\n143:     }\n144: \n145:     const fence = line.text.match(/^[ \\t]{0,3}(`{3,}|~{3,})/u)?.[1];\n146:     if (fence !== undefined) {\n147:       const marker = fence[0] ?? '`';\n148:       const closing = new RegExp(`^[ \\\\t]{0,3}${escapeRegex(marker)}{${fence.length},}[ \\\\t]*$`, 'u');\n149:       let last = line;\n150:       let cursor = index + 1;\n151:       for (; cursor < lines.length; cursor += 1) {\n152:         const candidate = lines[cursor];\n153:         if (candidate === undefined) {\n154:           break;\n155:         }\n156:         last = candidate;\n157:         if (closing.test(candidate.text)) {\n158:           break;\n159:         }\n160:       }\n161:       addRange(line.start, last.contentEnd, ProtectedSpanKinds.FENCED_CODE);\n162:       index = Math.min(cursor, lines.length - 1);\n163:       continue;\n164:     }\n165: \n166:     if (/^[ \\t]*:::{3,}/u.test(line.text)) {\n167:       let last = line;\n168:       let cursor = index + 1;\n169:       for (; cursor < lines.length; cursor += 1) {\n170:         const candidate = lines[cursor];\n171:         if (candidate === undefined) {\n172:           break;\n173:         }\n174:         last = candidate;\n175:         if (/^[ \\t]*:::{3,}[ \\t]*$/u.test(candidate.text)) {\n176:           break;\n177:         }\n178:       }\n179:       addRange(line.start, last.contentEnd, ProtectedSpanKinds.RUNTIME_EXTENSION);\n180:       index = Math.min(cursor, lines.length - 1);\n181:       continue;\n182:     }\n183: \n184:     if (/^[ \\t]*<!--/u.test(line.text)) {\n185:       let last = line;\n186:       let cursor = index;\n187:       while (!last.text.includes('-->') && cursor + 1 < lines.length) {\n188:         cursor += 1;\n189:         last = lines[cursor] ?? last;\n190:       }\n191:       addRange(line.start, last.contentEnd, ProtectedSpanKinds.HTML);\n192:       index = cursor;\n193:       continue;\n194:     }\n195: \n196:     const next = lines[index + 1];\n197:     if (next !== undefined && line.text.includes('|') && TABLE_DELIMITER.test(next.text)) {\n198:       let last = next;\n199:       let cursor = index + 2;\n200:       while (cursor < lines.length && (lines[cursor]?.text.includes('|') ?? false)) {\n201:         last = lines[cursor] ?? last;\n202:         cursor += 1;\n203:       }\n204:       addRange(line.start, last.contentEnd, ProtectedSpanKinds.TABLE);\n205:       index = cursor - 1;\n206:       continue;\n207:     }\n208: \n209:     if (/^(?: {4}|\\t)/u.test(line.text)) {\n210:       let last = line;\n211:       let cursor = index + 1;\n212:       while (cursor < lines.length && /^(?: {4}|\\t|[ \\t]*$)/u.test(lines[cursor]?.text ?? '')) {\n213:         last = lines[cursor] ?? last;\n214:         cursor += 1;\n215:       }\n216:       addRange(line.start, last.contentEnd, ProtectedSpanKinds.INDENTED_CODE);\n217:       index = cursor - 1;\n218:       continue;\n219:     }\n220: \n221:     if (/^[ \\t]{0,3}#{1,6}(?:[ \\t]+|$)/u.test(line.text)) {\n222:       addRange(line.start, line.contentEnd, ProtectedSpanKinds.HEADING);\n223:       continue;\n224:     }\n225: \n226:     if (COMMAND_PREFIX.test(line.text)) {\n227:       addRange(line.start, line.contentEnd, ProtectedSpanKinds.COMMAND);\n228:       continue;\n229:     }\n230: \n231:     const list = line.text.match(/^[ \\t]*(?:[-+*]|\\d+[.)])[ \\t]+/u)?.[0];\n232:     if (list !== undefined) {\n233:       addRange(line.start, line.start + list.length, ProtectedSpanKinds.LIST_MARKER);\n234:     }\n235:     const quote = line.text.match(/^[ \\t]*>+[ \\t]?/u)?.[0];\n236:     if (quote !== undefined) {\n237:       addRange(line.start, line.start + quote.length, ProtectedSpanKinds.LIST_MARKER);\n238:     }\n239:   }\n240: \n241:   if (lines.length === 0 && sourceLength > 0) {\n242:     addRange(0, sourceLength, ProtectedSpanKinds.QUOTED_LITERAL);\n243:   }\n244: }\n245: \n246: function collectConfiguredRanges(\n247:   sourceText: string,\n248:   configuredLiterals: readonly string[],\n249:   addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n250: ): void {\n251:   const literals = [...configuredLiterals].sort((left, right) => right.length - left.length);\n252:   for (const literal of literals) {\n253:     let cursor = 0;\n254:     while (cursor <= sourceText.length - literal.length) {\n255:       const start = sourceText.indexOf(literal, cursor);\n256:       if (start < 0) {\n257:         break;\n258:       }\n259:       addRange(start, start + literal.length, ProtectedSpanKinds.CONFIGURED_LITERAL);\n260:       cursor = start + Math.max(1, literal.length);\n261:     }\n262:   }\n263: }\n264: \n265: function collectInlineRanges(\n266:   sourceText: string,\n267:   addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n268: ): void {\n269:   addPattern(sourceText, /⟦pcp:v1:[^:⟧]+:\\d+:[^⟧]+⟧/gu, ProtectedSpanKinds.QUOTED_LITERAL, addRange);\n270:   addPattern(sourceText, /(`+)([\\s\\S]*?)\\1/gu, ProtectedSpanKinds.INLINE_CODE, addRange);\n271:   addPattern(sourceText, /!?\\[[^\\]\\n]*\\]\\((?:\\\\.|[^)\\n])+\\)/gu, ProtectedSpanKinds.LINK, addRange);\n272:   addPattern(sourceText, /!?\\[[^\\]\\n]+\\]\\[[^\\]\\n]*\\]/gu, ProtectedSpanKinds.LINK, addRange);\n273:   addPattern(sourceText, /<(?:https?:\\/\\/[^>\\s]+|!--[\\s\\S]*?--|\\/?[A-Za-z][^>\\n]*)>/gu, ProtectedSpanKinds.HTML, addRange);\n274:   addPattern(sourceText, /\\bhttps?:\\/\\/[^\\s<>()]+/giu, ProtectedSpanKinds.URL, addRange);\n275:   addPattern(sourceText, /\\b[A-Za-z]:\\\\(?:[^\\\\\\s<>:\"|?*]+\\\\)*[^\\\\\\s<>:\"|?*]+/gu, ProtectedSpanKinds.PATH, addRange);\n276:   addPattern(sourceText, /(?:~|\\.{1,2})?\\/(?:[A-Za-z0-9._~@%+,:=-]+\\/?)+/gu, ProtectedSpanKinds.PATH, addRange);\n277:   addPattern(sourceText, /\\b(?:[A-Za-z0-9._-]+\\/)+[A-Za-z0-9._-]+\\b/gu, ProtectedSpanKinds.PATH, addRange);\n278:   addPattern(sourceText, /\"(?:\\\\.|[^\"\\\\\\n])*\"|'(?:\\\\.|[^'\\\\\\n]){2,}'/gu, ProtectedSpanKinds.QUOTED_LITERAL, addRange);\n279:   addPattern(sourceText, /\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?/gu, ProtectedSpanKinds.VARIABLE, addRange);\n280:   addPattern(sourceText, /(?:^|(?<=\\s))--?[A-Za-z0-9][A-Za-z0-9-]*(?:=[^\\s]+)?/gu, ProtectedSpanKinds.FLAG, addRange);\n281:   addPattern(sourceText, /\\b(?:sha256:)?[a-f0-9]{12,128}\\b/giu, ProtectedSpanKinds.HASH, addRange);\n282:   addPattern(sourceText, /\\b\\p{Lu}[\\p{L}\\p{N}-]{1,}(?:[ \\t]+\\p{Lu}[\\p{L}\\p{N}-]{1,})+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n283:   addPattern(sourceText, /\\b\\d+(?:[.,]\\d+)*(?:\\s?(?:%|ms|s|min|h|B|KB|MB|GB|KiB|MiB|GiB|px|rem|em|Hz|kHz|MHz|GHz))?\\b/gu, ProtectedSpanKinds.NUMBER, addRange);\n284:   addPattern(sourceText, /\\b[a-z]+(?:[A-Z][A-Za-z0-9]*)+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n285:   addPattern(sourceText, /\\b[A-Za-z][A-Za-z0-9]*_[A-Za-z0-9_]+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n286:   addPattern(sourceText, /\\b[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n287:   addPattern(sourceText, /\\b[A-Z][A-Z0-9_]{2,}\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n288: }\n289: \n290: function addPattern(\n291:   sourceText: string,\n292:   pattern: RegExp,\n293:   kind: ProtectedSpanKind,\n294:   addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n295: ): void {\n296:   for (const match of sourceText.matchAll(pattern)) {\n297:     const value = match[0];\n298:     if (value.length > 0 && match.index !== undefined) {\n299:       addRange(match.index, match.index + value.length, kind);\n300:     }\n301:   }\n302: }\n303: \n304: function createLines(sourceText: string): readonly SourceLine[] {\n305:   if (sourceText.length === 0) {\n306:     return [];\n307:   }\n308:   const lines: SourceLine[] = [];\n309:   let start = 0;\n310:   while (start < sourceText.length) {\n311:     const newline = sourceText.indexOf('\\n', start);\n312:     const contentEnd = newline < 0 ? sourceText.length : newline;\n313:     const end = newline < 0 ? sourceText.length : newline + 1;\n314:     const raw = sourceText.slice(start, contentEnd);\n315:     lines.push({\n316:       start,\n317:       contentEnd: raw.endsWith('\\r') ? contentEnd - 1 : contentEnd,\n318:       end,\n319:       text: raw.endsWith('\\r') ? raw.slice(0, -1) : raw,\n320:     });\n321:     start = end;\n322:   }\n323:   return lines;\n324: }\n325: \n326: function countPattern(value: string, pattern: RegExp): number {\n327:   return [...value.matchAll(pattern)].length;\n328: }\n329: \n330: function countTableCells(line: string): number {\n331:   return line\n332:     .replace(/^\\s*\\|/u, '')\n333:     .replace(/\\|\\s*$/u, '')\n334:     .split('|').length;\n335: }\n336: \n337: function indentWidth(value: string): number {\n338:   return [...value].reduce((total, character) => total + (character === '\\t' ? 4 : 1), 0);\n339: }\n340: \n341: function escapeRegex(value: string): string {\n342:   return value.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&');\n343: }\n\n(End of file - total 343 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Conservative Markdown Dialect\n// ───────────────────────────────────────────────────────────────────\n\nimport { ProtectedSpanKinds } from './types.js';\n\nimport type { ProtectedSpanKind } from './types.js';\n\n/** One non-overlapping source range selected for exact preservation. */\nexport interface ProtectedSourceRange {\n  readonly start: number;\n  readonly end: number;\n  readonly kind: ProtectedSpanKind;\n}\n\ninterface SourceLine {\n  readonly start: number;\n  readonly contentEnd: number;\n  readonly end: number;\n  readonly text: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/dialect.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Conservative Markdown Dialect\n// ───────────────────────────────────────────────────────────────────\n\nimport { ProtectedSpanKinds } from './types.js';\n\nimport type { ProtectedSpanKind } from './types.js';\n\n/** One non-overlapping source range selected for exact preservation. */\nexport interface ProtectedSourceRange {\n  readonly start: number;\n  readonly end: number;\n  readonly kind: ProtectedSpanKind;\n}\n\ninterface SourceLine {\n  readonly start: number;\n  readonly contentEnd: number;\n  readonly end: number;\n  readonly text: string;\n}\n\nconst COMMAND_PREFIX = /^[ \\t]*(?:bun|cargo|deno|git|go|node|npm|npx|pnpm|python|python3|sh|bash|yarn)\\s+\\S/u;\nconst TABLE_DELIMITER = /^[ \\t]*\\|?[ \\t]*:?-{3,}:?[ \\t]*(?:\\|[ \\t]*:?-{3,}:?[ \\t]*)+\\|?[ \\t]*$/u;\n\n/** Select technical and structural ranges using the pinned conservative dialect. */\nexport function collectProtectedRanges(\n  sourceText: string,\n  configuredLiterals: readonly string[],\n): readonly ProtectedSourceRange[] {\n  const ranges: ProtectedSourceRange[] = [];\n  const lines = createLines(sourceText);\n  const addRange = (\n    start: number,\n    end: number,\n    kind: ProtectedSpanKind,\n  ): boolean => {\n    if (start < 0 || end <= start || end > sourceText.length) {\n      return false;\n    }\n    if (ranges.some((range) => start < range.end && end > range.start)) {\n      return false;\n    }\n    ranges.push({ start, end, kind });\n    return true;\n  };\n\n  collectBlockRanges(lines, sourceText.length, addRange);\n  collectConfiguredRanges(sourceText, configuredLiterals, addRange);\n  collectInlineRanges(sourceText, addRange);\n\n  return Object.freeze(ranges.sort((left, right) =>\n    left.start - right.start || left.end - right.end));\n}\n\n/** Create a stable structural signature without retaining prose. */\nexport function createMarkdownStructureSignature(sourceText: string): string {\n  const lines = createLines(sourceText);\n  const headings: string[] = [];\n  const lists: string[] = [];\n  const quotes: number[] = [];\n  const fences: string[] = [];\n  const tables: string[] = [];\n\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index];\n    if (line === undefined) {\n      continue;\n    }\n    const atx = line.text.match(/^[ \\t]{0,3}(#{1,6})(?:[ \\t]+|$)/u);\n    if (atx?.[1] !== undefined) {\n      headings.push(`atx:${atx[1].length}`);\n    }\n    const next = lines[index + 1];\n    if (line.text.trim().length > 0 && next !== undefined) {\n      const setext = next.text.match(/^[ \\t]{0,3}(=+|-+)[ \\t]*$/u);\n      if (setext?.[1] !== undefined) {\n        headings.push(`setext:${setext[1].startsWith('=') ? 1 : 2}`);\n      }\n    }\n    const list = line.text.match(/^([ \\t]*)([-+*]|\\d+[.)])[ \\t]+/u);\n    if (list?.[1] !== undefined && list[2] !== undefined) {\n      lists.push(`${indentWidth(list[1])}:${/^\\d/u.test(list[2]) ? 'ordered' : list[2]}`);\n    }\n    const quote = line.text.match(/^[ \\t]*(>+(?:[ \\t]|$))/u);\n    if (quote?.[1] !== undefined) {\n      quotes.push((quote[1].match(/>/gu) ?? []).length);\n    }\n    const fence = line.text.match(/^[ \\t]{0,3}(`{3,}|~{3,})([^`]*)$/u);\n    if (fence?.[1] !== undefined) {\n      fences.push(`${fence[1][0]}:${fence[1].length}:${(fence[2] ?? '').trim()}`);\n    }\n    if (next !== undefined && line.text.includes('|') && TABLE_DELIMITER.test(next.text)) {\n      let rowCount = 2;\n      let cursor = index + 2;\n      while (cursor < lines.length && (lines[cursor]?.text.includes('|') ?? false)) {\n        rowCount += 1;\n        cursor += 1;\n      }\n      tables.push(`${countTableCells(line.text)}x${rowCount}`);\n    }\n  }\n\n  return JSON.stringify({\n    headings,\n    lists,\n    quotes,\n    fences,\n    tables,\n    links: countPattern(sourceText, /!?\\[[^\\]\\n]*\\]\\([^\\n)]+\\)/gu),\n    referenceLinks: countPattern(sourceText, /!?\\[[^\\]\\n]+\\]\\[[^\\]\\n]*\\]/gu),\n    inlineCode: countPattern(sourceText, /(`+)([^`]|`(?!\\1))*?\\1/gu),\n    html: countPattern(sourceText, /<(?:!--[\\s\\S]*?--|\\/?[A-Za-z][^>\\n]*)>/gu),\n  });\n}\n\n/** Reject strings that cannot round trip through strict UTF-8 text semantics. */\nexport function hasUnpairedSurrogate(value: string): boolean {\n  for (let index = 0; index < value.length; index += 1) {\n    const code = value.charCodeAt(index);\n    if (code >= 0xD800 && code <= 0xDBFF) {\n      const next = value.charCodeAt(index + 1);\n      if (!(next >= 0xDC00 && next <= 0xDFFF)) {\n        return true;\n      }\n      index += 1;\n    } else if (code >= 0xDC00 && code <= 0xDFFF) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction collectBlockRanges(\n  lines: readonly SourceLine[],\n  sourceLength: number,\n  addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n): void {\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index];\n    if (line === undefined) {\n      continue;\n    }\n\n    const fence = line.text.match(/^[ \\t]{0,3}(`{3,}|~{3,})/u)?.[1];\n    if (fence !== undefined) {\n      const marker = fence[0] ?? '`';\n      const closing = new RegExp(`^[ \\\\t]{0,3}${escapeRegex(marker)}{${fence.length},}[ \\\\t]*$`, 'u');\n      let last = line;\n      let cursor = index + 1;\n      for (; cursor < lines.length; cursor += 1) {\n        const candidate = lines[cursor];\n        if (candidate === undefined) {\n          break;\n        }\n        last = candidate;\n        if (closing.test(candidate.text)) {\n          break;\n        }\n      }\n      addRange(line.start, last.contentEnd, ProtectedSpanKinds.FENCED_CODE);\n      index = Math.min(cursor, lines.length - 1);\n      continue;\n    }\n\n    if (/^[ \\t]*:::{3,}/u.test(line.text)) {\n      let last = line;\n      let cursor = index + 1;\n      for (; cursor < lines.length; cursor += 1) {\n        const candidate = lines[cursor];\n        if (candidate === undefined) {\n          break;\n        }\n        last = candidate;\n        if (/^[ \\t]*:::{3,}[ \\t]*$/u.test(candidate.text)) {\n          break;\n        }\n      }\n      addRange(line.start, last.contentEnd, ProtectedSpanKinds.RUNTIME_EXTENSION);\n      index = Math.min(cursor, lines.length - 1);\n      continue;\n    }\n\n    if (/^[ \\t]*<!--/u.test(line.text)) {\n      let last = line;\n      let cursor = index;\n      while (!last.text.includes('-->') && cursor + 1 < lines.length) {\n        cursor += 1;\n        last = lines[cursor] ?? last;\n      }\n      addRange(line.start, last.contentEnd, ProtectedSpanKinds.HTML);\n      index = cursor;\n      continue;\n    }\n\n    const next = lines[index + 1];\n    if (next !== undefined && line.text.includes('|') && TABLE_DELIMITER.test(next.text)) {\n      let last = next;\n      let cursor = index + 2;\n      while (cursor < lines.length && (lines[cursor]?.text.includes('|') ?? false)) {\n        last = lines[cursor] ?? last;\n        cursor += 1;\n      }\n      addRange(line.start, last.contentEnd, ProtectedSpanKinds.TABLE);\n      index = cursor - 1;\n      continue;\n    }\n\n    if (/^(?: {4}|\\t)/u.test(line.text)) {\n      let last = line;\n      let cursor = index + 1;\n      while (cursor < lines.length && /^(?: {4}|\\t|[ \\t]*$)/u.test(lines[cursor]?.text ?? '')) {\n        last = lines[cursor] ?? last;\n        cursor += 1;\n      }\n      addRange(line.start, last.contentEnd, ProtectedSpanKinds.INDENTED_CODE);\n      index = cursor - 1;\n      continue;\n    }\n\n    if (/^[ \\t]{0,3}#{1,6}(?:[ \\t]+|$)/u.test(line.text)) {\n      addRange(line.start, line.contentEnd, ProtectedSpanKinds.HEADING);\n      continue;\n    }\n\n    if (COMMAND_PREFIX.test(line.text)) {\n      addRange(line.start, line.contentEnd, ProtectedSpanKinds.COMMAND);\n      continue;\n    }\n\n    const list = line.text.match(/^[ \\t]*(?:[-+*]|\\d+[.)])[ \\t]+/u)?.[0];\n    if (list !== undefined) {\n      addRange(line.start, line.start + list.length, ProtectedSpanKinds.LIST_MARKER);\n    }\n    const quote = line.text.match(/^[ \\t]*>+[ \\t]?/u)?.[0];\n    if (quote !== undefined) {\n      addRange(line.start, line.start + quote.length, ProtectedSpanKinds.LIST_MARKER);\n    }\n  }\n\n  if (lines.length === 0 && sourceLength > 0) {\n    addRange(0, sourceLength, ProtectedSpanKinds.QUOTED_LITERAL);\n  }\n}\n\nfunction collectConfiguredRanges(\n  sourceText: string,\n  configuredLiterals: readonly string[],\n  addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n): void {\n  const literals = [...configuredLiterals].sort((left, right) => right.length - left.length);\n  for (const literal of literals) {\n    let cursor = 0;\n    while (cursor <= sourceText.length - literal.length) {\n      const start = sourceText.indexOf(literal, cursor);\n      if (start < 0) {\n        break;\n      }\n      addRange(start, start + literal.length, ProtectedSpanKinds.CONFIGURED_LITERAL);\n      cursor = start + Math.max(1, literal.length);\n    }\n  }\n}\n\nfunction collectInlineRanges(\n  sourceText: string,\n  addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n): void {\n  addPattern(sourceText, /⟦pcp:v1:[^:⟧]+:\\d+:[^⟧]+⟧/gu, ProtectedSpanKinds.QUOTED_LITERAL, addRange);\n  addPattern(sourceText, /(`+)([\\s\\S]*?)\\1/gu, ProtectedSpanKinds.INLINE_CODE, addRange);\n  addPattern(sourceText, /!?\\[[^\\]\\n]*\\]\\((?:\\\\.|[^)\\n])+\\)/gu, ProtectedSpanKinds.LINK, addRange);\n  addPattern(sourceText, /!?\\[[^\\]\\n]+\\]\\[[^\\]\\n]*\\]/gu, ProtectedSpanKinds.LINK, addRange);\n  addPattern(sourceText, /<(?:https?:\\/\\/[^>\\s]+|!--[\\s\\S]*?--|\\/?[A-Za-z][^>\\n]*)>/gu, ProtectedSpanKinds.HTML, addRange);\n  addPattern(sourceText, /\\bhttps?:\\/\\/[^\\s<>()]+/giu, ProtectedSpanKinds.URL, addRange);\n  addPattern(sourceText, /\\b[A-Za-z]:\\\\(?:[^\\\\\\s<>:\"|?*]+\\\\)*[^\\\\\\s<>:\"|?*]+/gu, ProtectedSpanKinds.PATH, addRange);\n  addPattern(sourceText, /(?:~|\\.{1,2})?\\/(?:[A-Za-z0-9._~@%+,:=-]+\\/?)+/gu, ProtectedSpanKinds.PATH, addRange);\n  addPattern(sourceText, /\\b(?:[A-Za-z0-9._-]+\\/)+[A-Za-z0-9._-]+\\b/gu, ProtectedSpanKinds.PATH, addRange);\n  addPattern(sourceText, /\"(?:\\\\.|[^\"\\\\\\n])*\"|'(?:\\\\.|[^'\\\\\\n]){2,}'/gu, ProtectedSpanKinds.QUOTED_LITERAL, addRange);\n  addPattern(sourceText, /\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?/gu, ProtectedSpanKinds.VARIABLE, addRange);\n  addPattern(sourceText, /(?:^|(?<=\\s))--?[A-Za-z0-9][A-Za-z0-9-]*(?:=[^\\s]+)?/gu, ProtectedSpanKinds.FLAG, addRange);\n  addPattern(sourceText, /\\b(?:sha256:)?[a-f0-9]{12,128}\\b/giu, ProtectedSpanKinds.HASH, addRange);\n  addPattern(sourceText, /\\b\\p{Lu}[\\p{L}\\p{N}-]{1,}(?:[ \\t]+\\p{Lu}[\\p{L}\\p{N}-]{1,})+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n  addPattern(sourceText, /\\b\\d+(?:[.,]\\d+)*(?:\\s?(?:%|ms|s|min|h|B|KB|MB|GB|KiB|MiB|GiB|px|rem|em|Hz|kHz|MHz|GHz))?\\b/gu, ProtectedSpanKinds.NUMBER, addRange);\n  addPattern(sourceText, /\\b[a-z]+(?:[A-Z][A-Za-z0-9]*)+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n  addPattern(sourceText, /\\b[A-Za-z][A-Za-z0-9]*_[A-Za-z0-9_]+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n  addPattern(sourceText, /\\b[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n  addPattern(sourceText, /\\b[A-Z][A-Z0-9_]{2,}\\b/gu, ProtectedSpanKinds.IDENTIFIER, addRange);\n}\n\nfunction addPattern(\n  sourceText: string,\n  pattern: RegExp,\n  kind: ProtectedSpanKind,\n  addRange: (start: number, end: number, kind: ProtectedSpanKind) => boolean,\n): void {\n  for (const match of sourceText.matchAll(pattern)) {\n    const value = match[0];\n    if (value.length > 0 && match.index !== undefined) {\n      addRange(match.index, match.index + value.length, kind);\n    }\n  }\n}\n\nfunction createLines(sourceText: string): readonly SourceLine[] {\n  if (sourceText.length === 0) {\n    return [];\n  }\n  const lines: SourceLine[] = [];\n  let start = 0;\n  while (start < sourceText.length) {\n    const newline = sourceText.indexOf('\\n', start);\n    const contentEnd = newline < 0 ? sourceText.length : newline;\n    const end = newline < 0 ? sourceText.length : newline + 1;\n    const raw = sourceText.slice(start, contentEnd);\n    lines.push({\n      start,\n      contentEnd: raw.endsWith('\\r') ? contentEnd - 1 : contentEnd,\n      end,\n      text: raw.endsWith('\\r') ? raw.slice(0, -1) : raw,\n    });\n    start = end;\n  }\n  return lines;\n}\n\nfunction countPattern(value: string, pattern: RegExp): number {\n  return [...value.matchAll(pattern)].length;\n}\n\nfunction countTableCells(line: string): number {\n  return line\n    .replace(/^\\s*\\|/u, '')\n    .replace(/\\|\\s*$/u, '')\n    .split('|').length;\n}\n\nfunction indentWidth(value: string): number {\n  return [...value].reduce((total, character) => total + (character === '\\t' ? 4 : 1), 0);\n}\n\nfunction escapeRegex(value: string): string {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&');\n}","lineStart":1,"lineEnd":343,"totalLines":343,"truncated":false}},"title":"packages/cli-communication-projection/src/fidelity/dialect.ts","time":{"start":1786568935060,"end":1786568935066}},"id":"prt_ff7ce841900109jgZuiVuZBJh6","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ce4e25001ItoFL7wTcRJUdx"}}
{"type":"tool_use","timestamp":1786568935417,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_jenkuE5hnG6owibwzY7g3397","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/protected-spans.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/protected-spans.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Protected Span Codec\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { createHash } from 'node:crypto';\n6: \n7: import { createSha256Digest, decodeExactOriginal } from '../contracts/exact-original.js';\n8: import { validateExactOriginal } from '../contracts/validate-event.js';\n9: import { isRecord } from '../contracts/validator-utils.js';\n10: import { collectProtectedRanges, hasUnpairedSurrogate } from './dialect.js';\n11: import { deepFreeze, freezeExactOriginal } from './freeze.js';\n12: import {\n13:   FidelityReasonCodes,\n14:   ProtectedMarkdownDialect,\n15:   ProtectedSpanKinds,\n16: } from './types.js';\n17: \n18: import type { ValidationIssue } from '../contracts/common.js';\n19: import type {\n20:   FidelityCheck,\n21:   FidelityInputRejection,\n22:   FidelityReasonCode,\n23:   ProtectMarkdownResult,\n24:   ProtectedDocument,\n25:   ProtectedSpan,\n26:   RestoreProtectedSpansResult,\n27: } from './types.js';\n28: \n29: const PROTECT_INPUT_KEYS = ['sourceText', 'exactOriginal', 'configuredLiterals'] as const;\n30: const TOKEN_SCAN = /⟦pcp:v1:[^:⟧]+:\\d+:[^⟧]+⟧/gu;\n31: const SHA256_PATTERN = /^sha256:[a-f0-9]{64}$/u;\n32: const MAX_CONFIGURED_LITERALS = 256;\n33: const MAX_CONFIGURED_LITERAL_LENGTH = 4096;\n34: \n35: /** Protect exact technical spans before a candidate leaves the trusted boundary. */\n36: export function protectMarkdown(input: unknown): ProtectMarkdownResult {\n37:   if (!isRecord(input)) {\n38:     return rejectedInput([issue('$', 'type', 'Protection input must be an object.')]);\n39:   }\n40: \n41:   const exactResult = validateExactOriginal(input.exactOriginal);\n42:   if (!exactResult.success) {\n43:     return rejectedInput(prefixIssues('$.exactOriginal', exactResult.issues));\n44:   }\n45:   const exactOriginal = freezeExactOriginal(exactResult.value);\n46:   const issues = validateProtectInput(input);\n47:   if (issues.length > 0) {\n48:     return protectionFallback(exactOriginal, FidelityReasonCodes.INVALID_INPUT, issues);\n49:   }\n50: \n51:   const sourceText = input.sourceText as string;\n52:   if (hasUnpairedSurrogate(sourceText)) {\n53:     return protectionFallback(exactOriginal, FidelityReasonCodes.INVALID_ENCODING, [\n54:       issue('$.sourceText', 'encoding', 'Source text must contain valid Unicode scalar values.'),\n55:     ]);\n56:   }\n57:   const sourceBytes = new TextEncoder().encode(sourceText);\n58:   if (\n59:     sourceBytes.byteLength !== exactOriginal.byteLength\n60:     || createSha256Digest(sourceBytes) !== exactOriginal.sha256\n61:   ) {\n62:     return protectionFallback(exactOriginal, FidelityReasonCodes.SOURCE_CHANGED, [\n63:       issue('$.sourceText', 'source_digest', 'Source text does not match the stored original.'),\n64:     ]);\n65:   }\n66: \n67:   const configuredLiterals = input.configuredLiterals === undefined\n68:     ? []\n69:     : input.configuredLiterals as readonly string[];\n70:   const ranges = collectProtectedRanges(sourceText, configuredLiterals);\n71:   const namespace = createCollisionFreeNamespace(sourceText);\n72:   const spans: ProtectedSpan[] = [];\n73:   const encodedParts: string[] = [];\n74:   let charCursor = 0;\n75:   let byteCursor = 0;\n76: \n77:   for (const [index, range] of ranges.entries()) {\n78:     const prose = sourceText.slice(charCursor, range.start);\n79:     encodedParts.push(prose);\n80:     byteCursor += new TextEncoder().encode(prose).byteLength;\n81: \n82:     const spanText = sourceText.slice(range.start, range.end);\n83:     const bytes = new TextEncoder().encode(spanText);\n84:     const sha256 = createSha256Digest(bytes);\n85:     const token = createToken(namespace, index, sha256);\n86:     encodedParts.push(token);\n87:     spans.push(deepFreeze({\n88:       index,\n89:       kind: range.kind,\n90:       charStart: range.start,\n91:       charEnd: range.end,\n92:       byteStart: byteCursor,\n93:       byteEnd: byteCursor + bytes.byteLength,\n94:       byteLength: bytes.byteLength,\n95:       bytesBase64: Buffer.from(bytes).toString('base64'),\n96:       sha256,\n97:       token,\n98:     }));\n99:     byteCursor += bytes.byteLength;\n100:     charCursor = range.end;\n101:   }\n102:   encodedParts.push(sourceText.slice(charCursor));\n103: \n104:   const document: ProtectedDocument = deepFreeze({\n105:     dialect: ProtectedMarkdownDialect,\n106:     namespace,\n107:     sourceSha256: exactOriginal.sha256,\n108:     sourceByteLength: exactOriginal.byteLength,\n109:     encodedText: encodedParts.join(''),\n110:     spans,\n111:     configuredLiteralCount: configuredLiterals.length,\n112:     exactOriginal,\n113:   });\n114:   return Object.freeze({ status: 'protected', document });\n115: }\n116: \n117: /** Restore exact span bytes only when set, count, order, and identity all match. */\n118: export function restoreProtectedSpans(\n119:   document: ProtectedDocument,\n120:   candidateText: string,\n121: ): RestoreProtectedSpansResult | FidelityInputRejection {\n122:   const documentIssues = validateProtectedDocument(document);\n123:   if (documentIssues.length > 0) {\n124:     return rejectedInput(documentIssues);\n125:   }\n126:   if (typeof candidateText !== 'string') {\n127:     return protectedRejection(document, FidelityReasonCodes.INVALID_INPUT, null, null);\n128:   }\n129:   if (hasUnpairedSurrogate(candidateText)) {\n130:     return protectedRejection(document, FidelityReasonCodes.INVALID_ENCODING, null, null);\n131:   }\n132: \n133:   const expected = document.spans.map((span) => span.token);\n134:   const actual = [...candidateText.matchAll(TOKEN_SCAN)].map((match) => match[0]);\n135:   const actualCounts = countValues(actual);\n136:   if (expected.some((token) => (actualCounts.get(token) ?? 0) > 1)) {\n137:     return protectedRejection(\n138:       document,\n139:       FidelityReasonCodes.PLACEHOLDER_DUPLICATE,\n140:       expected.length,\n141:       actual.length,\n142:     );\n143:   }\n144: \n145:   const changed = document.spans.some((span) =>\n146:     !actualCounts.has(span.token)\n147:       && candidateText.includes(`⟦pcp:v1:${document.namespace}:${span.index}:`));\n148:   if (changed) {\n149:     return protectedRejection(\n150:       document,\n151:       FidelityReasonCodes.PLACEHOLDER_CHANGED,\n152:       expected.length,\n153:       actual.length,\n154:     );\n155:   }\n156: \n157:   const expectedSet = new Set(expected);\n158:   if (actual.some((token) => !expectedSet.has(token))) {\n159:     return protectedRejection(\n160:       document,\n161:       FidelityReasonCodes.PLACEHOLDER_UNEXPECTED,\n162:       expected.length,\n163:       actual.length,\n164:     );\n165:   }\n166:   if (expected.some((token) => !actualCounts.has(token))) {\n167:     return protectedRejection(\n168:       document,\n169:       FidelityReasonCodes.PLACEHOLDER_MISSING,\n170:       expected.length,\n171:       actual.length,\n172:     );\n173:   }\n174:   if (actual.some((token, index) => token !== expected[index])) {\n175:     return protectedRejection(\n176:       document,\n177:       FidelityReasonCodes.PLACEHOLDER_REORDERED,\n178:       expected.length,\n179:       actual.length,\n180:     );\n181:   }\n182: \n183:   const replacements = new Map<string, string>();\n184:   for (const span of document.spans) {\n185:     const bytes = Uint8Array.from(Buffer.from(span.bytesBase64, 'base64'));\n186:     if (\n187:       bytes.byteLength !== span.byteLength\n188:       || createSha256Digest(bytes) !== span.sha256\n189:     ) {\n190:       return protectedRejection(\n191:         document,\n192:         FidelityReasonCodes.PROTECTED_BYTES_CHANGED,\n193:         span.byteLength,\n194:         bytes.byteLength,\n195:       );\n196:     }\n197:     try {\n198:       replacements.set(span.token, new TextDecoder('utf-8', { fatal: true }).decode(bytes));\n199:     } catch (error: unknown) {\n200:       return protectedRejection(document, FidelityReasonCodes.INVALID_ENCODING, null, null);\n201:     }\n202:   }\n203: \n204:   const text = candidateText.replace(TOKEN_SCAN, (token) => replacements.get(token) ?? token);\n205:   const bytes = new TextEncoder().encode(text);\n206:   const checks = Object.freeze([\n207:     check(FidelityReasonCodes.PLACEHOLDER_MISSING, 'passed', expected.length, actual.length),\n208:     check(FidelityReasonCodes.PROTECTED_BYTES_CHANGED, 'passed', expected.length, actual.length),\n209:   ]);\n210:   return deepFreeze({\n211:     status: 'restored',\n212:     text,\n213:     bytes,\n214:     byteLength: bytes.byteLength,\n215:     checks,\n216:   });\n217: }\n218: \n219: function validateProtectInput(input: Record<string, unknown>): ValidationIssue[] {\n220:   const issues: ValidationIssue[] = [];\n221:   for (const key of Object.keys(input)) {\n222:     if (!(PROTECT_INPUT_KEYS as readonly string[]).includes(key)) {\n223:       issues.push(issue(`$.${key}`, 'unknown_key', 'Field is not permitted at this boundary.'));\n224:     }\n225:   }\n226:   if (typeof input.sourceText !== 'string' || input.sourceText.length === 0) {\n227:     issues.push(issue('$.sourceText', 'type', 'Source text must be a non-empty string.'));\n228:   }\n229:   if (input.configuredLiterals !== undefined) {\n230:     if (!Array.isArray(input.configuredLiterals)) {\n231:       issues.push(issue('$.configuredLiterals', 'type', 'Configured literals must be an array.'));\n232:     } else {\n233:       if (input.configuredLiterals.length > MAX_CONFIGURED_LITERALS) {\n234:         issues.push(issue('$.configuredLiterals', 'limit', 'Too many configured literals.'));\n235:       }\n236:       const seen = new Set<string>();\n237:       for (const [index, value] of input.configuredLiterals.entries()) {\n238:         if (\n239:           typeof value !== 'string'\n240:           || value.length === 0\n241:           || value.length > MAX_CONFIGURED_LITERAL_LENGTH\n242:         ) {\n243:           issues.push(issue(\n244:             `$.configuredLiterals[${index}]`,\n245:             'type',\n246:             'Configured literals must be bounded non-empty strings.',\n247:           ));\n248:         } else if (seen.has(value)) {\n249:           issues.push(issue(\n250:             `$.configuredLiterals[${index}]`,\n251:             'duplicate',\n252:             'Configured literals must be unique.',\n253:           ));\n254:         } else {\n255:           seen.add(value);\n256:         }\n257:       }\n258:     }\n259:   }\n260:   return issues;\n261: }\n262: \n263: function validateProtectedDocument(document: unknown): ValidationIssue[] {\n264:   if (!isRecord(document)) {\n265:     return [issue('$', 'type', 'Protected document must be an object.')];\n266:   }\n267:   const issues: ValidationIssue[] = [];\n268:   const exact = validateExactOriginal(document.exactOriginal);\n269:   if (!exact.success) {\n270:     issues.push(...prefixIssues('$.exactOriginal', exact.issues));\n271:     return issues;\n272:   }\n273:   if (document.sourceSha256 !== exact.value.sha256) {\n274:     issues.push(issue('$.sourceSha256', 'source_digest', 'Protected source digest is invalid.'));\n275:   }\n276:   if (document.sourceByteLength !== exact.value.byteLength) {\n277:     issues.push(issue('$.sourceByteLength', 'source_length', 'Protected source length is invalid.'));\n278:   }\n279:   if (\n280:     !isRecord(document.dialect)\n281:     || JSON.stringify(document.dialect) !== JSON.stringify(ProtectedMarkdownDialect)\n282:   ) {\n283:     issues.push(issue('$.dialect', 'dialect', 'Protected Markdown dialect is not supported.'));\n284:   }\n285:   const namespace = typeof document.namespace === 'string' ? document.namespace : null;\n286:   if (namespace === null || !/^[a-f0-9]{24}$/u.test(namespace)) {\n287:     issues.push(issue('$.namespace', 'namespace', 'Placeholder namespace is invalid.'));\n288:   }\n289:   if (typeof document.encodedText !== 'string' || !Array.isArray(document.spans)) {\n290:     issues.push(issue('$', 'type', 'Protected document text and spans are required.'));\n291:     return issues;\n292:   }\n293:   if (\n294:     typeof document.configuredLiteralCount !== 'number'\n295:     || !Number.isInteger(document.configuredLiteralCount)\n296:     || document.configuredLiteralCount < 0\n297:     || document.configuredLiteralCount > MAX_CONFIGURED_LITERALS\n298:   ) {\n299:     issues.push(issue(\n300:       '$.configuredLiteralCount',\n301:       'range',\n302:       'Configured literal count is invalid.',\n303:     ));\n304:   }\n305: \n306:   const originalBytes = decodeExactOriginal(exact.value);\n307:   let sourceText: string;\n308:   try {\n309:     sourceText = new TextDecoder('utf-8', { fatal: true }).decode(originalBytes);\n310:   } catch (error: unknown) {\n311:     issues.push(issue('$.exactOriginal', 'encoding', 'Protected source is not valid UTF-8.'));\n312:     return issues;\n313:   }\n314:   const tokens = new Set<string>();\n315:   const encodedParts: string[] = [];\n316:   const spanKinds = Object.values(ProtectedSpanKinds) as readonly string[];\n317:   let previousCharEnd = 0;\n318:   let previousByteEnd = 0;\n319:   let canReconstruct = true;\n320:   for (const [index, value] of document.spans.entries()) {\n321:     if (!isRecord(value)) {\n322:       issues.push(issue(`$.spans[${index}]`, 'type', 'Protected span must be an object.'));\n323:       canReconstruct = false;\n324:       continue;\n325:     }\n326:     const token = value.token;\n327:     const charStart = value.charStart;\n328:     const charEnd = value.charEnd;\n329:     const byteStart = value.byteStart;\n330:     const byteEnd = value.byteEnd;\n331:     const byteLength = value.byteLength;\n332:     const bytesBase64 = value.bytesBase64;\n333:     const sha256 = value.sha256;\n334:     if (\n335:       value.index !== index\n336:       || typeof value.kind !== 'string'\n337:       || !spanKinds.includes(value.kind)\n338:       || typeof token !== 'string'\n339:       || typeof charStart !== 'number'\n340:       || typeof charEnd !== 'number'\n341:       || !Number.isInteger(charStart)\n342:       || !Number.isInteger(charEnd)\n343:       || charStart < previousCharEnd\n344:       || charEnd <= charStart\n345:       || charEnd > sourceText.length\n346:       || typeof byteStart !== 'number'\n347:       || typeof byteEnd !== 'number'\n348:       || typeof byteLength !== 'number'\n349:       || !Number.isInteger(byteStart)\n350:       || !Number.isInteger(byteEnd)\n351:       || !Number.isInteger(byteLength)\n352:       || byteStart < previousByteEnd\n353:       || byteEnd <= byteStart\n354:       || byteEnd > originalBytes.byteLength\n355:       || byteLength !== byteEnd - byteStart\n356:       || typeof bytesBase64 !== 'string'\n357:       || typeof sha256 !== 'string'\n358:       || !SHA256_PATTERN.test(sha256)\n359:     ) {\n360:       issues.push(issue(`$.spans[${index}]`, 'span', 'Protected span metadata is invalid.'));\n361:       canReconstruct = false;\n362:       continue;\n363:     }\n364:     const bytes = Uint8Array.from(Buffer.from(bytesBase64, 'base64'));\n365:     const sourceSlice = originalBytes.slice(byteStart, byteEnd);\n366:     const prose = sourceText.slice(previousCharEnd, charStart);\n367:     const spanTextBytes = new TextEncoder().encode(sourceText.slice(charStart, charEnd));\n368:     const calculatedByteStart = previousByteEnd + new TextEncoder().encode(prose).byteLength;\n369:     if (\n370:       byteStart !== calculatedByteStart\n371:       || bytes.byteLength !== byteLength\n372:       || bytesBase64 !== Buffer.from(bytes).toString('base64')\n373:       || !Buffer.from(bytes).equals(Buffer.from(sourceSlice))\n374:       || !Buffer.from(bytes).equals(Buffer.from(spanTextBytes))\n375:       || createSha256Digest(bytes) !== sha256\n376:       || token !== createToken(namespace ?? '', index, sha256)\n377:       || tokens.has(token)\n378:       || sourceText.includes(token)\n379:     ) {\n380:       issues.push(issue(`$.spans[${index}]`, 'span_identity', 'Protected span identity is invalid.'));\n381:     }\n382:     encodedParts.push(prose, token);\n383:     previousCharEnd = charEnd;\n384:     previousByteEnd = byteEnd;\n385:     tokens.add(token);\n386:   }\n387:   if (canReconstruct) {\n388:     encodedParts.push(sourceText.slice(previousCharEnd));\n389:     if (encodedParts.join('') !== document.encodedText) {\n390:       issues.push(issue('$.encodedText', 'encoded_text', 'Protected text does not match its spans.'));\n391:     }\n392:   }\n393:   return issues;\n394: }\n395: \n396: function createCollisionFreeNamespace(sourceText: string): string {\n397:   let attempt = 0;\n398:   while (true) {\n399:     const namespace = createHash('sha256')\n400:       .update(ProtectedMarkdownDialect.policyVersion)\n401:       .update('\\0')\n402:       .update(sourceText)\n403:       .update('\\0')\n404:       .update(String(attempt))\n405:       .digest('hex')\n406:       .slice(0, 24);\n407:     if (!sourceText.includes(`⟦pcp:v1:${namespace}:`)) {\n408:       return namespace;\n409:     }\n410:     attempt += 1;\n411:   }\n412: }\n413: \n414: function createToken(namespace: string, index: number, sha256: string): string {\n415:   return `⟦pcp:v1:${namespace}:${index}:${sha256.slice('sha256:'.length, 'sha256:'.length + 12)}⟧`;\n416: }\n417: \n418: function protectedRejection(\n419:   document: ProtectedDocument,\n420:   reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n421:   expectedCount: number | null,\n422:   actualCount: number | null,\n423: ): RestoreProtectedSpansResult {\n424:   return deepFreeze({\n425:     status: 'rejected',\n426:     reasonCode,\n427:     exactOriginal: document.exactOriginal,\n428:     checks: [check(reasonCode, 'failed', expectedCount, actualCount)],\n429:   });\n430: }\n431: \n432: function protectionFallback(\n433:   exactOriginal: ProtectedDocument['exactOriginal'],\n434:   reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n435:   issues: readonly ValidationIssue[],\n436: ): ProtectMarkdownResult {\n437:   return deepFreeze({ status: 'exact-original', reasonCode, exactOriginal, issues: [...issues] });\n438: }\n439: \n440: function rejectedInput(issues: readonly ValidationIssue[]): FidelityInputRejection {\n441:   return deepFreeze({ status: 'rejected', reasonCode: 'invalid-input', issues: [...issues] });\n442: }\n443: \n444: function check(\n445:   ruleId: FidelityReasonCode,\n446:   status: FidelityCheck['status'],\n447:   expectedCount: number | null,\n448:   actualCount: number | null,\n449: ): FidelityCheck {\n450:   return Object.freeze({ ruleId, status, expectedCount, actualCount });\n451: }\n452: \n453: function countValues(values: readonly string[]): ReadonlyMap<string, number> {\n454:   const counts = new Map<string, number>();\n455:   for (const value of values) {\n456:     counts.set(value, (counts.get(value) ?? 0) + 1);\n457:   }\n458:   return counts;\n459: }\n460: \n461: function issue(path: string, code: string, message: string): ValidationIssue {\n462:   return Object.freeze({ path, code, message });\n463: }\n464: \n465: function prefixIssues(\n466:   path: string,\n467:   issues: readonly ValidationIssue[],\n468: ): ValidationIssue[] {\n469:   return issues.map((entry) => ({\n470:     ...entry,\n471:     path: `${path}${entry.path === '$' ? '' : entry.path.slice(1)}`,\n472:   }));\n473: }\n\n(End of file - total 473 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Protected Span Codec\n// ───────────────────────────────────────────────────────────────────\n\nimport { createHash } from 'node:crypto';\n\nimport { createSha256Digest, decodeExactOriginal } from '../contracts/exact-original.js';\nimport { validateExactOriginal } from '../contracts/validate-event.js';\nimport { isRecord } from '../contracts/validator-utils.js';\nimport { collectProtectedRanges, hasUnpairedSurrogate } from './dialect.js';\nimport { deepFreeze, freezeExactOriginal } from './freeze.js';\nimport {\n  FidelityReasonCodes,\n  ProtectedMarkdownDialect,\n  ProtectedSpanKinds,\n} from './types.js';\n\nimport type { ValidationIssue } from '../contracts/common.js';\nimport type {\n  FidelityCheck,","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/protected-spans.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Protected Span Codec\n// ───────────────────────────────────────────────────────────────────\n\nimport { createHash } from 'node:crypto';\n\nimport { createSha256Digest, decodeExactOriginal } from '../contracts/exact-original.js';\nimport { validateExactOriginal } from '../contracts/validate-event.js';\nimport { isRecord } from '../contracts/validator-utils.js';\nimport { collectProtectedRanges, hasUnpairedSurrogate } from './dialect.js';\nimport { deepFreeze, freezeExactOriginal } from './freeze.js';\nimport {\n  FidelityReasonCodes,\n  ProtectedMarkdownDialect,\n  ProtectedSpanKinds,\n} from './types.js';\n\nimport type { ValidationIssue } from '../contracts/common.js';\nimport type {\n  FidelityCheck,\n  FidelityInputRejection,\n  FidelityReasonCode,\n  ProtectMarkdownResult,\n  ProtectedDocument,\n  ProtectedSpan,\n  RestoreProtectedSpansResult,\n} from './types.js';\n\nconst PROTECT_INPUT_KEYS = ['sourceText', 'exactOriginal', 'configuredLiterals'] as const;\nconst TOKEN_SCAN = /⟦pcp:v1:[^:⟧]+:\\d+:[^⟧]+⟧/gu;\nconst SHA256_PATTERN = /^sha256:[a-f0-9]{64}$/u;\nconst MAX_CONFIGURED_LITERALS = 256;\nconst MAX_CONFIGURED_LITERAL_LENGTH = 4096;\n\n/** Protect exact technical spans before a candidate leaves the trusted boundary. */\nexport function protectMarkdown(input: unknown): ProtectMarkdownResult {\n  if (!isRecord(input)) {\n    return rejectedInput([issue('$', 'type', 'Protection input must be an object.')]);\n  }\n\n  const exactResult = validateExactOriginal(input.exactOriginal);\n  if (!exactResult.success) {\n    return rejectedInput(prefixIssues('$.exactOriginal', exactResult.issues));\n  }\n  const exactOriginal = freezeExactOriginal(exactResult.value);\n  const issues = validateProtectInput(input);\n  if (issues.length > 0) {\n    return protectionFallback(exactOriginal, FidelityReasonCodes.INVALID_INPUT, issues);\n  }\n\n  const sourceText = input.sourceText as string;\n  if (hasUnpairedSurrogate(sourceText)) {\n    return protectionFallback(exactOriginal, FidelityReasonCodes.INVALID_ENCODING, [\n      issue('$.sourceText', 'encoding', 'Source text must contain valid Unicode scalar values.'),\n    ]);\n  }\n  const sourceBytes = new TextEncoder().encode(sourceText);\n  if (\n    sourceBytes.byteLength !== exactOriginal.byteLength\n    || createSha256Digest(sourceBytes) !== exactOriginal.sha256\n  ) {\n    return protectionFallback(exactOriginal, FidelityReasonCodes.SOURCE_CHANGED, [\n      issue('$.sourceText', 'source_digest', 'Source text does not match the stored original.'),\n    ]);\n  }\n\n  const configuredLiterals = input.configuredLiterals === undefined\n    ? []\n    : input.configuredLiterals as readonly string[];\n  const ranges = collectProtectedRanges(sourceText, configuredLiterals);\n  const namespace = createCollisionFreeNamespace(sourceText);\n  const spans: ProtectedSpan[] = [];\n  const encodedParts: string[] = [];\n  let charCursor = 0;\n  let byteCursor = 0;\n\n  for (const [index, range] of ranges.entries()) {\n    const prose = sourceText.slice(charCursor, range.start);\n    encodedParts.push(prose);\n    byteCursor += new TextEncoder().encode(prose).byteLength;\n\n    const spanText = sourceText.slice(range.start, range.end);\n    const bytes = new TextEncoder().encode(spanText);\n    const sha256 = createSha256Digest(bytes);\n    const token = createToken(namespace, index, sha256);\n    encodedParts.push(token);\n    spans.push(deepFreeze({\n      index,\n      kind: range.kind,\n      charStart: range.start,\n      charEnd: range.end,\n      byteStart: byteCursor,\n      byteEnd: byteCursor + bytes.byteLength,\n      byteLength: bytes.byteLength,\n      bytesBase64: Buffer.from(bytes).toString('base64'),\n      sha256,\n      token,\n    }));\n    byteCursor += bytes.byteLength;\n    charCursor = range.end;\n  }\n  encodedParts.push(sourceText.slice(charCursor));\n\n  const document: ProtectedDocument = deepFreeze({\n    dialect: ProtectedMarkdownDialect,\n    namespace,\n    sourceSha256: exactOriginal.sha256,\n    sourceByteLength: exactOriginal.byteLength,\n    encodedText: encodedParts.join(''),\n    spans,\n    configuredLiteralCount: configuredLiterals.length,\n    exactOriginal,\n  });\n  return Object.freeze({ status: 'protected', document });\n}\n\n/** Restore exact span bytes only when set, count, order, and identity all match. */\nexport function restoreProtectedSpans(\n  document: ProtectedDocument,\n  candidateText: string,\n): RestoreProtectedSpansResult | FidelityInputRejection {\n  const documentIssues = validateProtectedDocument(document);\n  if (documentIssues.length > 0) {\n    return rejectedInput(documentIssues);\n  }\n  if (typeof candidateText !== 'string') {\n    return protectedRejection(document, FidelityReasonCodes.INVALID_INPUT, null, null);\n  }\n  if (hasUnpairedSurrogate(candidateText)) {\n    return protectedRejection(document, FidelityReasonCodes.INVALID_ENCODING, null, null);\n  }\n\n  const expected = document.spans.map((span) => span.token);\n  const actual = [...candidateText.matchAll(TOKEN_SCAN)].map((match) => match[0]);\n  const actualCounts = countValues(actual);\n  if (expected.some((token) => (actualCounts.get(token) ?? 0) > 1)) {\n    return protectedRejection(\n      document,\n      FidelityReasonCodes.PLACEHOLDER_DUPLICATE,\n      expected.length,\n      actual.length,\n    );\n  }\n\n  const changed = document.spans.some((span) =>\n    !actualCounts.has(span.token)\n      && candidateText.includes(`⟦pcp:v1:${document.namespace}:${span.index}:`));\n  if (changed) {\n    return protectedRejection(\n      document,\n      FidelityReasonCodes.PLACEHOLDER_CHANGED,\n      expected.length,\n      actual.length,\n    );\n  }\n\n  const expectedSet = new Set(expected);\n  if (actual.some((token) => !expectedSet.has(token))) {\n    return protectedRejection(\n      document,\n      FidelityReasonCodes.PLACEHOLDER_UNEXPECTED,\n      expected.length,\n      actual.length,\n    );\n  }\n  if (expected.some((token) => !actualCounts.has(token))) {\n    return protectedRejection(\n      document,\n      FidelityReasonCodes.PLACEHOLDER_MISSING,\n      expected.length,\n      actual.length,\n    );\n  }\n  if (actual.some((token, index) => token !== expected[index])) {\n    return protectedRejection(\n      document,\n      FidelityReasonCodes.PLACEHOLDER_REORDERED,\n      expected.length,\n      actual.length,\n    );\n  }\n\n  const replacements = new Map<string, string>();\n  for (const span of document.spans) {\n    const bytes = Uint8Array.from(Buffer.from(span.bytesBase64, 'base64'));\n    if (\n      bytes.byteLength !== span.byteLength\n      || createSha256Digest(bytes) !== span.sha256\n    ) {\n      return protectedRejection(\n        document,\n        FidelityReasonCodes.PROTECTED_BYTES_CHANGED,\n        span.byteLength,\n        bytes.byteLength,\n      );\n    }\n    try {\n      replacements.set(span.token, new TextDecoder('utf-8', { fatal: true }).decode(bytes));\n    } catch (error: unknown) {\n      return protectedRejection(document, FidelityReasonCodes.INVALID_ENCODING, null, null);\n    }\n  }\n\n  const text = candidateText.replace(TOKEN_SCAN, (token) => replacements.get(token) ?? token);\n  const bytes = new TextEncoder().encode(text);\n  const checks = Object.freeze([\n    check(FidelityReasonCodes.PLACEHOLDER_MISSING, 'passed', expected.length, actual.length),\n    check(FidelityReasonCodes.PROTECTED_BYTES_CHANGED, 'passed', expected.length, actual.length),\n  ]);\n  return deepFreeze({\n    status: 'restored',\n    text,\n    bytes,\n    byteLength: bytes.byteLength,\n    checks,\n  });\n}\n\nfunction validateProtectInput(input: Record<string, unknown>): ValidationIssue[] {\n  const issues: ValidationIssue[] = [];\n  for (const key of Object.keys(input)) {\n    if (!(PROTECT_INPUT_KEYS as readonly string[]).includes(key)) {\n      issues.push(issue(`$.${key}`, 'unknown_key', 'Field is not permitted at this boundary.'));\n    }\n  }\n  if (typeof input.sourceText !== 'string' || input.sourceText.length === 0) {\n    issues.push(issue('$.sourceText', 'type', 'Source text must be a non-empty string.'));\n  }\n  if (input.configuredLiterals !== undefined) {\n    if (!Array.isArray(input.configuredLiterals)) {\n      issues.push(issue('$.configuredLiterals', 'type', 'Configured literals must be an array.'));\n    } else {\n      if (input.configuredLiterals.length > MAX_CONFIGURED_LITERALS) {\n        issues.push(issue('$.configuredLiterals', 'limit', 'Too many configured literals.'));\n      }\n      const seen = new Set<string>();\n      for (const [index, value] of input.configuredLiterals.entries()) {\n        if (\n          typeof value !== 'string'\n          || value.length === 0\n          || value.length > MAX_CONFIGURED_LITERAL_LENGTH\n        ) {\n          issues.push(issue(\n            `$.configuredLiterals[${index}]`,\n            'type',\n            'Configured literals must be bounded non-empty strings.',\n          ));\n        } else if (seen.has(value)) {\n          issues.push(issue(\n            `$.configuredLiterals[${index}]`,\n            'duplicate',\n            'Configured literals must be unique.',\n          ));\n        } else {\n          seen.add(value);\n        }\n      }\n    }\n  }\n  return issues;\n}\n\nfunction validateProtectedDocument(document: unknown): ValidationIssue[] {\n  if (!isRecord(document)) {\n    return [issue('$', 'type', 'Protected document must be an object.')];\n  }\n  const issues: ValidationIssue[] = [];\n  const exact = validateExactOriginal(document.exactOriginal);\n  if (!exact.success) {\n    issues.push(...prefixIssues('$.exactOriginal', exact.issues));\n    return issues;\n  }\n  if (document.sourceSha256 !== exact.value.sha256) {\n    issues.push(issue('$.sourceSha256', 'source_digest', 'Protected source digest is invalid.'));\n  }\n  if (document.sourceByteLength !== exact.value.byteLength) {\n    issues.push(issue('$.sourceByteLength', 'source_length', 'Protected source length is invalid.'));\n  }\n  if (\n    !isRecord(document.dialect)\n    || JSON.stringify(document.dialect) !== JSON.stringify(ProtectedMarkdownDialect)\n  ) {\n    issues.push(issue('$.dialect', 'dialect', 'Protected Markdown dialect is not supported.'));\n  }\n  const namespace = typeof document.namespace === 'string' ? document.namespace : null;\n  if (namespace === null || !/^[a-f0-9]{24}$/u.test(namespace)) {\n    issues.push(issue('$.namespace', 'namespace', 'Placeholder namespace is invalid.'));\n  }\n  if (typeof document.encodedText !== 'string' || !Array.isArray(document.spans)) {\n    issues.push(issue('$', 'type', 'Protected document text and spans are required.'));\n    return issues;\n  }\n  if (\n    typeof document.configuredLiteralCount !== 'number'\n    || !Number.isInteger(document.configuredLiteralCount)\n    || document.configuredLiteralCount < 0\n    || document.configuredLiteralCount > MAX_CONFIGURED_LITERALS\n  ) {\n    issues.push(issue(\n      '$.configuredLiteralCount',\n      'range',\n      'Configured literal count is invalid.',\n    ));\n  }\n\n  const originalBytes = decodeExactOriginal(exact.value);\n  let sourceText: string;\n  try {\n    sourceText = new TextDecoder('utf-8', { fatal: true }).decode(originalBytes);\n  } catch (error: unknown) {\n    issues.push(issue('$.exactOriginal', 'encoding', 'Protected source is not valid UTF-8.'));\n    return issues;\n  }\n  const tokens = new Set<string>();\n  const encodedParts: string[] = [];\n  const spanKinds = Object.values(ProtectedSpanKinds) as readonly string[];\n  let previousCharEnd = 0;\n  let previousByteEnd = 0;\n  let canReconstruct = true;\n  for (const [index, value] of document.spans.entries()) {\n    if (!isRecord(value)) {\n      issues.push(issue(`$.spans[${index}]`, 'type', 'Protected span must be an object.'));\n      canReconstruct = false;\n      continue;\n    }\n    const token = value.token;\n    const charStart = value.charStart;\n    const charEnd = value.charEnd;\n    const byteStart = value.byteStart;\n    const byteEnd = value.byteEnd;\n    const byteLength = value.byteLength;\n    const bytesBase64 = value.bytesBase64;\n    const sha256 = value.sha256;\n    if (\n      value.index !== index\n      || typeof value.kind !== 'string'\n      || !spanKinds.includes(value.kind)\n      || typeof token !== 'string'\n      || typeof charStart !== 'number'\n      || typeof charEnd !== 'number'\n      || !Number.isInteger(charStart)\n      || !Number.isInteger(charEnd)\n      || charStart < previousCharEnd\n      || charEnd <= charStart\n      || charEnd > sourceText.length\n      || typeof byteStart !== 'number'\n      || typeof byteEnd !== 'number'\n      || typeof byteLength !== 'number'\n      || !Number.isInteger(byteStart)\n      || !Number.isInteger(byteEnd)\n      || !Number.isInteger(byteLength)\n      || byteStart < previousByteEnd\n      || byteEnd <= byteStart\n      || byteEnd > originalBytes.byteLength\n      || byteLength !== byteEnd - byteStart\n      || typeof bytesBase64 !== 'string'\n      || typeof sha256 !== 'string'\n      || !SHA256_PATTERN.test(sha256)\n    ) {\n      issues.push(issue(`$.spans[${index}]`, 'span', 'Protected span metadata is invalid.'));\n      canReconstruct = false;\n      continue;\n    }\n    const bytes = Uint8Array.from(Buffer.from(bytesBase64, 'base64'));\n    const sourceSlice = originalBytes.slice(byteStart, byteEnd);\n    const prose = sourceText.slice(previousCharEnd, charStart);\n    const spanTextBytes = new TextEncoder().encode(sourceText.slice(charStart, charEnd));\n    const calculatedByteStart = previousByteEnd + new TextEncoder().encode(prose).byteLength;\n    if (\n      byteStart !== calculatedByteStart\n      || bytes.byteLength !== byteLength\n      || bytesBase64 !== Buffer.from(bytes).toString('base64')\n      || !Buffer.from(bytes).equals(Buffer.from(sourceSlice))\n      || !Buffer.from(bytes).equals(Buffer.from(spanTextBytes))\n      || createSha256Digest(bytes) !== sha256\n      || token !== createToken(namespace ?? '', index, sha256)\n      || tokens.has(token)\n      || sourceText.includes(token)\n    ) {\n      issues.push(issue(`$.spans[${index}]`, 'span_identity', 'Protected span identity is invalid.'));\n    }\n    encodedParts.push(prose, token);\n    previousCharEnd = charEnd;\n    previousByteEnd = byteEnd;\n    tokens.add(token);\n  }\n  if (canReconstruct) {\n    encodedParts.push(sourceText.slice(previousCharEnd));\n    if (encodedParts.join('') !== document.encodedText) {\n      issues.push(issue('$.encodedText', 'encoded_text', 'Protected text does not match its spans.'));\n    }\n  }\n  return issues;\n}\n\nfunction createCollisionFreeNamespace(sourceText: string): string {\n  let attempt = 0;\n  while (true) {\n    const namespace = createHash('sha256')\n      .update(ProtectedMarkdownDialect.policyVersion)\n      .update('\\0')\n      .update(sourceText)\n      .update('\\0')\n      .update(String(attempt))\n      .digest('hex')\n      .slice(0, 24);\n    if (!sourceText.includes(`⟦pcp:v1:${namespace}:`)) {\n      return namespace;\n    }\n    attempt += 1;\n  }\n}\n\nfunction createToken(namespace: string, index: number, sha256: string): string {\n  return `⟦pcp:v1:${namespace}:${index}:${sha256.slice('sha256:'.length, 'sha256:'.length + 12)}⟧`;\n}\n\nfunction protectedRejection(\n  document: ProtectedDocument,\n  reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n  expectedCount: number | null,\n  actualCount: number | null,\n): RestoreProtectedSpansResult {\n  return deepFreeze({\n    status: 'rejected',\n    reasonCode,\n    exactOriginal: document.exactOriginal,\n    checks: [check(reasonCode, 'failed', expectedCount, actualCount)],\n  });\n}\n\nfunction protectionFallback(\n  exactOriginal: ProtectedDocument['exactOriginal'],\n  reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n  issues: readonly ValidationIssue[],\n): ProtectMarkdownResult {\n  return deepFreeze({ status: 'exact-original', reasonCode, exactOriginal, issues: [...issues] });\n}\n\nfunction rejectedInput(issues: readonly ValidationIssue[]): FidelityInputRejection {\n  return deepFreeze({ status: 'rejected', reasonCode: 'invalid-input', issues: [...issues] });\n}\n\nfunction check(\n  ruleId: FidelityReasonCode,\n  status: FidelityCheck['status'],\n  expectedCount: number | null,\n  actualCount: number | null,\n): FidelityCheck {\n  return Object.freeze({ ruleId, status, expectedCount, actualCount });\n}\n\nfunction countValues(values: readonly string[]): ReadonlyMap<string, number> {\n  const counts = new Map<string, number>();\n  for (const value of values) {\n    counts.set(value, (counts.get(value) ?? 0) + 1);\n  }\n  return counts;\n}\n\nfunction issue(path: string, code: string, message: string): ValidationIssue {\n  return Object.freeze({ path, code, message });\n}\n\nfunction prefixIssues(\n  path: string,\n  issues: readonly ValidationIssue[],\n): ValidationIssue[] {\n  return issues.map((entry) => ({\n    ...entry,\n    path: `${path}${entry.path === '$' ? '' : entry.path.slice(1)}`,\n  }));\n}","lineStart":1,"lineEnd":473,"totalLines":473,"truncated":false}},"title":"packages/cli-communication-projection/src/fidelity/protected-spans.ts","time":{"start":1786568935411,"end":1786568935416}},"id":"prt_ff7ce8695001TsbS2uTeIGOTxg","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ce4e25001ItoFL7wTcRJUdx"}}
