{"type":"tool_use","timestamp":1786568942146,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_00_IMlB9MzvITAI3Fy8ZYBn5141","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/adapters.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/adapters.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Provider Wire Adapters\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { isRecord } from '../contracts/validator-utils.js';\n6: import { validateProviderModelRecord } from './registry.js';\n7: import { compilePromptControls } from './controls.js';\n8: import { ProviderFamilies } from './types.js';\n9: \n10: import type { JsonValue } from '../contracts/common.js';\n11: import type {\n12:   MutableJsonObject,\n13:   ParsedProviderFailure,\n14:   ParsedProviderResponse,\n15:   ProviderAdapter,\n16:   ProviderFamily,\n17:   ProviderPreparationInput,\n18:   ProviderRequestPreparation,\n19:   ProviderWireResponse,\n20: } from './types.js';\n21: \n22: const openCodeGoAdapter = createOpenAiChatAdapter(ProviderFamilies.OPENCODE_GO);\n23: const genericHostedAdapter = createOpenAiChatAdapter(ProviderFamilies.GENERIC_HOSTED);\n24: const llamaCppAdapter = createOpenAiChatAdapter(ProviderFamilies.LLAMA_CPP);\n25: const ollamaAdapter: ProviderAdapter = Object.freeze({\n26:   family: ProviderFamilies.OLLAMA,\n27:   prepare(input: ProviderPreparationInput): ProviderRequestPreparation {\n28:     return prepare(input, ProviderFamilies.OLLAMA, {\n29:       model: input.record.provider.modelId,\n30:       messages: messages(input),\n31:       stream: false,\n32:     });\n33:   },\n34:   parse: parseOllamaResponse,\n35: });\n36: \n37: /** Return the adapter with wire semantics matching one validated family. */\n38: export function getProviderAdapter(family: ProviderFamily): ProviderAdapter {\n39:   switch (family) {\n40:     case ProviderFamilies.OPENCODE_GO:\n41:       return openCodeGoAdapter;\n42:     case ProviderFamilies.GENERIC_HOSTED:\n43:       return genericHostedAdapter;\n44:     case ProviderFamilies.LLAMA_CPP:\n45:       return llamaCppAdapter;\n46:     case ProviderFamilies.OLLAMA:\n47:       return ollamaAdapter;\n48:   }\n49: }\n50: \n51: function createOpenAiChatAdapter(family: ProviderFamily): ProviderAdapter {\n52:   return Object.freeze({\n53:     family,\n54:     prepare(input: ProviderPreparationInput): ProviderRequestPreparation {\n55:       return prepare(input, family, {\n56:         model: input.record.provider.modelId,\n57:         messages: messages(input),\n58:         stream: false,\n59:       });\n60:     },\n61:     parse: parseOpenAiChatResponse,\n62:   });\n63: }\n64: \n65: function prepare(\n66:   input: ProviderPreparationInput,\n67:   family: ProviderFamily,\n68:   baseBody: MutableJsonObject,\n69: ): ProviderRequestPreparation {\n70:   const recordResult = validateProviderModelRecord(input.record);\n71:   if (!recordResult.success || input.record.family !== family) {\n72:     return Object.freeze({\n73:       status: 'unsupported',\n74:       reasonCode: 'invalid-provider',\n75:       control: null,\n76:     });\n77:   }\n78:   const controls = compilePromptControls(input.record, input.prompt, baseBody, input.now);\n79:   if (controls.status === 'unsupported') {\n80:     return controls;\n81:   }\n82:   return Object.freeze({\n83:     status: 'prepared',\n84:     request: Object.freeze({\n85:       endpoint: input.record.provider.endpoint,\n86:       providerId: input.record.provider.providerId,\n87:       modelId: input.record.provider.modelId,\n88:       protocol: input.record.provider.protocol,\n89:       credentialReference: input.record.provider.credentialReference,\n90:       body: controls.body,\n91:       signal: input.signal,\n92:     }),\n93:   });\n94: }\n95: \n96: function messages(input: ProviderPreparationInput): JsonValue {\n97:   return [\n98:     { role: 'system', content: input.prompt.systemInstruction },\n99:     { role: 'user', content: input.document.encodedText },\n100:   ];\n101: }\n102: \n103: function parseOpenAiChatResponse(response: ProviderWireResponse): ParsedProviderResponse {\n104:   if (!isSuccessfulStatus(response.status)) {\n105:     return failure('provider-error', 'error');\n106:   }\n107:   if (!isRecord(response.body) || !Array.isArray(response.body.choices)) {\n108:     return failure('invalid-response', 'error');\n109:   }\n110:   const choice = response.body.choices[0];\n111:   if (!isRecord(choice)) {\n112:     return failure('invalid-response', 'error');\n113:   }\n114:   if (choice.finish_reason === 'length') {\n115:     return failure('truncated', 'truncated');\n116:   }\n117:   if (!isRecord(choice.message) || typeof choice.message.content !== 'string') {\n118:     return failure('invalid-response', 'error');\n119:   }\n120:   return candidate(choice.message.content);\n121: }\n122: \n123: function parseOllamaResponse(response: ProviderWireResponse): ParsedProviderResponse {\n124:   if (!isSuccessfulStatus(response.status)) {\n125:     return failure('provider-error', 'error');\n126:   }\n127:   if (!isRecord(response.body) || response.body.done !== true) {\n128:     return response.body !== null\n129:       && isRecord(response.body)\n130:       && response.body.done === false\n131:       ? failure('truncated', 'truncated')\n132:       : failure('invalid-response', 'error');\n133:   }\n134:   if (!isRecord(response.body.message) || typeof response.body.message.content !== 'string') {\n135:     return failure('invalid-response', 'error');\n136:   }\n137:   return candidate(response.body.message.content);\n138: }\n139: \n140: function candidate(text: string): ParsedProviderResponse {\n141:   if (text.trim().length === 0) {\n142:     return failure('empty-output', 'error');\n143:   }\n144:   return Object.freeze({\n145:     status: 'candidate',\n146:     text,\n147:     outputByteCount: new TextEncoder().encode(text).byteLength,\n148:   });\n149: }\n150: \n151: function failure(\n152:   reasonCode: ParsedProviderFailure['reasonCode'],\n153:   terminal: ParsedProviderFailure['terminal'],\n154: ): ParsedProviderFailure {\n155:   return Object.freeze({ status: 'failure', reasonCode, terminal });\n156: }\n157: \n158: function isSuccessfulStatus(status: number): boolean {\n159:   return Number.isInteger(status) && status >= 200 && status < 300;\n160: }\n\n(End of file - total 160 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Provider Wire Adapters\n// ───────────────────────────────────────────────────────────────────\n\nimport { isRecord } from '../contracts/validator-utils.js';\nimport { validateProviderModelRecord } from './registry.js';\nimport { compilePromptControls } from './controls.js';\nimport { ProviderFamilies } from './types.js';\n\nimport type { JsonValue } from '../contracts/common.js';\nimport type {\n  MutableJsonObject,\n  ParsedProviderFailure,\n  ParsedProviderResponse,\n  ProviderAdapter,\n  ProviderFamily,\n  ProviderPreparationInput,\n  ProviderRequestPreparation,\n  ProviderWireResponse,\n} from './types.js';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/adapters.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Provider Wire Adapters\n// ───────────────────────────────────────────────────────────────────\n\nimport { isRecord } from '../contracts/validator-utils.js';\nimport { validateProviderModelRecord } from './registry.js';\nimport { compilePromptControls } from './controls.js';\nimport { ProviderFamilies } from './types.js';\n\nimport type { JsonValue } from '../contracts/common.js';\nimport type {\n  MutableJsonObject,\n  ParsedProviderFailure,\n  ParsedProviderResponse,\n  ProviderAdapter,\n  ProviderFamily,\n  ProviderPreparationInput,\n  ProviderRequestPreparation,\n  ProviderWireResponse,\n} from './types.js';\n\nconst openCodeGoAdapter = createOpenAiChatAdapter(ProviderFamilies.OPENCODE_GO);\nconst genericHostedAdapter = createOpenAiChatAdapter(ProviderFamilies.GENERIC_HOSTED);\nconst llamaCppAdapter = createOpenAiChatAdapter(ProviderFamilies.LLAMA_CPP);\nconst ollamaAdapter: ProviderAdapter = Object.freeze({\n  family: ProviderFamilies.OLLAMA,\n  prepare(input: ProviderPreparationInput): ProviderRequestPreparation {\n    return prepare(input, ProviderFamilies.OLLAMA, {\n      model: input.record.provider.modelId,\n      messages: messages(input),\n      stream: false,\n    });\n  },\n  parse: parseOllamaResponse,\n});\n\n/** Return the adapter with wire semantics matching one validated family. */\nexport function getProviderAdapter(family: ProviderFamily): ProviderAdapter {\n  switch (family) {\n    case ProviderFamilies.OPENCODE_GO:\n      return openCodeGoAdapter;\n    case ProviderFamilies.GENERIC_HOSTED:\n      return genericHostedAdapter;\n    case ProviderFamilies.LLAMA_CPP:\n      return llamaCppAdapter;\n    case ProviderFamilies.OLLAMA:\n      return ollamaAdapter;\n  }\n}\n\nfunction createOpenAiChatAdapter(family: ProviderFamily): ProviderAdapter {\n  return Object.freeze({\n    family,\n    prepare(input: ProviderPreparationInput): ProviderRequestPreparation {\n      return prepare(input, family, {\n        model: input.record.provider.modelId,\n        messages: messages(input),\n        stream: false,\n      });\n    },\n    parse: parseOpenAiChatResponse,\n  });\n}\n\nfunction prepare(\n  input: ProviderPreparationInput,\n  family: ProviderFamily,\n  baseBody: MutableJsonObject,\n): ProviderRequestPreparation {\n  const recordResult = validateProviderModelRecord(input.record);\n  if (!recordResult.success || input.record.family !== family) {\n    return Object.freeze({\n      status: 'unsupported',\n      reasonCode: 'invalid-provider',\n      control: null,\n    });\n  }\n  const controls = compilePromptControls(input.record, input.prompt, baseBody, input.now);\n  if (controls.status === 'unsupported') {\n    return controls;\n  }\n  return Object.freeze({\n    status: 'prepared',\n    request: Object.freeze({\n      endpoint: input.record.provider.endpoint,\n      providerId: input.record.provider.providerId,\n      modelId: input.record.provider.modelId,\n      protocol: input.record.provider.protocol,\n      credentialReference: input.record.provider.credentialReference,\n      body: controls.body,\n      signal: input.signal,\n    }),\n  });\n}\n\nfunction messages(input: ProviderPreparationInput): JsonValue {\n  return [\n    { role: 'system', content: input.prompt.systemInstruction },\n    { role: 'user', content: input.document.encodedText },\n  ];\n}\n\nfunction parseOpenAiChatResponse(response: ProviderWireResponse): ParsedProviderResponse {\n  if (!isSuccessfulStatus(response.status)) {\n    return failure('provider-error', 'error');\n  }\n  if (!isRecord(response.body) || !Array.isArray(response.body.choices)) {\n    return failure('invalid-response', 'error');\n  }\n  const choice = response.body.choices[0];\n  if (!isRecord(choice)) {\n    return failure('invalid-response', 'error');\n  }\n  if (choice.finish_reason === 'length') {\n    return failure('truncated', 'truncated');\n  }\n  if (!isRecord(choice.message) || typeof choice.message.content !== 'string') {\n    return failure('invalid-response', 'error');\n  }\n  return candidate(choice.message.content);\n}\n\nfunction parseOllamaResponse(response: ProviderWireResponse): ParsedProviderResponse {\n  if (!isSuccessfulStatus(response.status)) {\n    return failure('provider-error', 'error');\n  }\n  if (!isRecord(response.body) || response.body.done !== true) {\n    return response.body !== null\n      && isRecord(response.body)\n      && response.body.done === false\n      ? failure('truncated', 'truncated')\n      : failure('invalid-response', 'error');\n  }\n  if (!isRecord(response.body.message) || typeof response.body.message.content !== 'string') {\n    return failure('invalid-response', 'error');\n  }\n  return candidate(response.body.message.content);\n}\n\nfunction candidate(text: string): ParsedProviderResponse {\n  if (text.trim().length === 0) {\n    return failure('empty-output', 'error');\n  }\n  return Object.freeze({\n    status: 'candidate',\n    text,\n    outputByteCount: new TextEncoder().encode(text).byteLength,\n  });\n}\n\nfunction failure(\n  reasonCode: ParsedProviderFailure['reasonCode'],\n  terminal: ParsedProviderFailure['terminal'],\n): ParsedProviderFailure {\n  return Object.freeze({ status: 'failure', reasonCode, terminal });\n}\n\nfunction isSuccessfulStatus(status: number): boolean {\n  return Number.isInteger(status) && status >= 200 && status < 300;\n}","lineStart":1,"lineEnd":160,"totalLines":160,"truncated":false}},"title":"packages/cli-communication-projection/src/providers/adapters.ts","time":{"start":1786568942139,"end":1786568942144}},"id":"prt_ff7cea068001SVp32KjXxKtGvO","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ce8bf30010ow85Mn5Zuada1"}}
{"type":"tool_use","timestamp":1786568942618,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_uxa3JgwBFW6pWZdewsER1431","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/contracts/prompt.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/contracts/prompt.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Prompt Profile Contract\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import type { ConfidenceState, ContractHeader } from './common.js';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. TYPE DEFINITIONS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: /** Provider-specific mapping for one inference control. */\n12: export interface ProviderControlMapping {\n13:   readonly providerId: string;\n14:   readonly modelPattern: string;\n15:   readonly control: 'temperature' | 'thinking';\n16:   readonly wireField: string | null;\n17:   readonly support: 'no' | 'unknown' | 'yes';\n18:   readonly confidence: ConfidenceState;\n19: }\n20: \n21: /** Versioned copy-editing prompt and deterministic inference controls. */\n22: export interface PromptProfileRecord extends ContractHeader {\n23:   readonly contractKind: 'prompt-profile';\n24:   readonly promptVersion: string;\n25:   readonly systemInstruction: string;\n26:   readonly copyEditingScope: 'assistant-message-only';\n27:   readonly protectedValuePolicyVersion: string;\n28:   readonly temperature: number;\n29:   readonly thinkingMode: 'disabled' | 'enabled' | 'provider-default';\n30:   readonly providerControlMappings: readonly ProviderControlMapping[];\n31:   readonly unsupportedControlBehavior: UnsupportedControlBehavior;\n32: }\n33: \n34: // ───────────────────────────────────────────────────────────────────\n35: // 2. CONSTANTS\n36: // ───────────────────────────────────────────────────────────────────\n37: \n38: /** Fail-closed behavior when a provider cannot honor a prompt control. */\n39: export const UnsupportedControlBehaviors = {\n40:   EXACT_ORIGINAL: 'exact-original',\n41:   REJECT_PROVIDER: 'reject-provider',\n42: } as const;\n43: \n44: /** Behavior selected for unsupported inference controls. */\n45: export type UnsupportedControlBehavior =\n46:   typeof UnsupportedControlBehaviors[keyof typeof UnsupportedControlBehaviors];\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Prompt Profile Contract\n// ───────────────────────────────────────────────────────────────────\n\nimport type { ConfidenceState, ContractHeader } from './common.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Provider-specific mapping for one inference control. */\nexport interface ProviderControlMapping {\n  readonly providerId: string;\n  readonly modelPattern: string;\n  readonly control: 'temperature' | 'thinking';\n  readonly wireField: string | null;\n  readonly support: 'no' | 'unknown' | 'yes';\n  readonly confidence: ConfidenceState;\n}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/contracts/prompt.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Prompt Profile Contract\n// ───────────────────────────────────────────────────────────────────\n\nimport type { ConfidenceState, ContractHeader } from './common.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Provider-specific mapping for one inference control. */\nexport interface ProviderControlMapping {\n  readonly providerId: string;\n  readonly modelPattern: string;\n  readonly control: 'temperature' | 'thinking';\n  readonly wireField: string | null;\n  readonly support: 'no' | 'unknown' | 'yes';\n  readonly confidence: ConfidenceState;\n}\n\n/** Versioned copy-editing prompt and deterministic inference controls. */\nexport interface PromptProfileRecord extends ContractHeader {\n  readonly contractKind: 'prompt-profile';\n  readonly promptVersion: string;\n  readonly systemInstruction: string;\n  readonly copyEditingScope: 'assistant-message-only';\n  readonly protectedValuePolicyVersion: string;\n  readonly temperature: number;\n  readonly thinkingMode: 'disabled' | 'enabled' | 'provider-default';\n  readonly providerControlMappings: readonly ProviderControlMapping[];\n  readonly unsupportedControlBehavior: UnsupportedControlBehavior;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n/** Fail-closed behavior when a provider cannot honor a prompt control. */\nexport const UnsupportedControlBehaviors = {\n  EXACT_ORIGINAL: 'exact-original',\n  REJECT_PROVIDER: 'reject-provider',\n} as const;\n\n/** Behavior selected for unsupported inference controls. */\nexport type UnsupportedControlBehavior =\n  typeof UnsupportedControlBehaviors[keyof typeof UnsupportedControlBehaviors];","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"packages/cli-communication-projection/src/contracts/prompt.ts","time":{"start":1786568942610,"end":1786568942617}},"id":"prt_ff7cea283001n5MKOSrRArx9jd","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ce8bf30010ow85Mn5Zuada1"}}
{"type":"tool_use","timestamp":1786568943106,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_02_cqwWCIDLHAcRNUeITISq6809","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/.opencode/skills/sk-communication/SKILL.md"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/.opencode/skills/sk-communication/SKILL.md</path>\n<type>file</type>\n<content>\n1: ---\n2: name: sk-communication\n3: description: Portable CLI projection layer that rewrites terse agent output to plain English while keeping canonical bytes unchanged.\n4: allowed-tools: [Read, Bash, Grep, Glob]\n5: version: 1.0.0.0\n6: ---\n7: \n8: <!-- Keywords: communication projection, claudish to english, rewrite CLI output, plain-english projection, presentation projection, privacy-first rewrite, full-projection, safe-native, provider adapters, exact-original fallback, deepseek ollama llama.cpp, blind non-inferiority evaluation, compatibility doctor, release gate -->\n9: \n10: # Communication Projection\n11: \n12: Make supported CLI and agent output read like careful plain English, across Claude, Codex, Pi, OpenCode, Devin, and Cursor, while leaving the canonical event stream, transcript, tool data, and model context byte-for-byte unchanged. Every unsafe or failed path returns the exact original. The implementation is the `@portable-cli/communication-projection` package under `packages/cli-communication-projection/`; this skill routes you to the right part of it and enforces its invariants.\n13: \n14: ---\n15: \n16: ## 1. WHEN TO USE\n17: \n18: ### Activation Triggers\n19: \n20: Use this skill when the request involves:\n21: \n22: - Rewriting terse, robotic CLI or agent status output into readable prose without changing the underlying data.\n23: - A provider-neutral \"claudish to English\" projection layer across multiple CLIs.\n24: - Choosing where rewriting happens — a local model or a hosted one — under explicit privacy and egress rules.\n25: - Wiring one of the six runtime adapters (Claude, Codex, Pi, OpenCode, Devin, Cursor) to a rewrite pipeline.\n26: - Deciding a presentation tier: full 1:1 projection versus a safe-native fallback.\n27: - Measuring whether rewritten output reads as well as a human reference (blind non-inferiority evaluation), or gating a release on that evidence.\n28: \n29: ### Keyword Triggers\n30: \n31: `communication projection`, `claudish to english`, `rewrite CLI output`, `plain-english projection`, `privacy-first rewrite`, `full-projection`, `safe-native`, `provider adapters`, `exact-original fallback`, `compatibility doctor`, `release gate`, `non-inferiority evaluation`.\n32: \n33: ### When NOT to Use\n34: \n35: - General application code implementation → `sk-code`.\n36: - Authoring documentation or markdown → `sk-doc`.\n37: - UI or visual design → `sk-design`.\n38: - Git worktrees, commits, or PRs → `sk-git`.\n39: - Rewriting durable Markdown or any on-disk file. That changes canonical bytes and is explicitly out of scope; it needs a separate opt-in product contract, not this projection layer.\n40: \n41: ---\n42: \n43: ## 2. SMART ROUTING\n44: \n45: ### Routing Signals\n46: \n47: The capability is one package split by responsibility. Route to the subsystem the request needs:\n48: \n49: | Request signal | Package surface |\n50: |---|---|\n51: | Assemble a whole message, bound context, versioned prompt profile | `src/core/`, `src/context/`, `src/contracts/` |\n52: | Preserve protected spans, validate meaning, decide how to display | `src/fidelity/`, `src/render/` |\n53: | Pick a local vs hosted model under privacy rules | `src/privacy/`, `src/providers/` |\n54: | Wire a specific CLI adapter or its display | `src/runtimes/`, `src/clients/` |\n55: | Score quality or aggregate private telemetry | `src/evaluation/`, `src/observability/` |\n56: | Check compatibility, gate a release, or roll back | `src/doctor/`, `src/release/` |\n57: \n58: ### Resource Domains\n59: \n60: - The package itself under `packages/cli-communication-projection/` is the primary resource; its `docs/` folder holds install, configuration, privacy, support-matrix, rollback, and runbook guidance.\n61: - The design and requirements history lives in the spec epic under `specs/cli-external-orchestration/035-improved-communication/`.\n62: \n63: ### Loading Levels\n64: \n65: - ALWAYS: read the relevant `src/<subsystem>/index.ts` exports before integrating against them.\n66: - CONDITIONAL: read the matching `docs/*.md` when the task is install, privacy, support, or rollback.\n67: - ON_DEMAND: read the spec epic only for the \"why\" behind a frozen invariant.\n68: \n69: ### Smart Router Pseudocode\n70: \n71: ```python\n72: from pathlib import Path\n73: \n74: SKILL_ROOT = Path(__file__).resolve().parent\n75: RESOURCE_BASES = (SKILL_ROOT / \"references\",)\n76: UNKNOWN_FALLBACK = {\n77:     \"load_level\": \"UNKNOWN_FALLBACK\",\n78:     \"needs_disambiguation\": True,\n79:     \"checklist\": [\n80:         \"Confirm which subsystem the task touches\",\n81:         \"Provide one concrete input or expected outcome\",\n82:     ],\n83: }\n84: \n85: def discover_markdown_resources() -> set[str]:\n86:     docs = []\n87:     for base in RESOURCE_BASES:\n88:         if base.exists():\n89:             docs.extend(path for path in base.rglob(\"*.md\") if path.is_file())\n90:     return {doc.relative_to(SKILL_ROOT).as_posix() for doc in docs}\n91: \n92: def _guard_in_skill(relative_path: str) -> str:\n93:     resolved = (SKILL_ROOT / relative_path).resolve()\n94:     resolved.relative_to(SKILL_ROOT)\n95:     if resolved.suffix.lower() != \".md\":\n96:         raise ValueError(\"Only skill-local markdown resources are routable\")\n97:     return resolved.relative_to(SKILL_ROOT).as_posix()\n98: \n99: def route_resources(request):\n100:     inventory = discover_markdown_resources()\n101:     selected = [\"references/package-map.md\"] if inventory else []\n102:     if not selected:\n103:         return {**UNKNOWN_FALLBACK, \"resources\": []}\n104:     loaded = []\n105:     for relative_path in selected:\n106:         guarded = _guard_in_skill(relative_path)\n107:         if guarded in inventory and guarded not in loaded:\n108:             load(guarded)\n109:             loaded.append(guarded)\n110:     return {\"resources\": loaded}\n111: ```\n112: \n113: ---\n114: \n115: ## 3. HOW IT WORKS\n116: \n117: ### The Pipeline\n118: \n119: ```text\n120: canonical event/transcript ──> unchanged persistence + model context\n121:                           └──> assemble message + bound context\n122:                                └──> protect spans\n123:                                     └──> privacy route (classify + consent BEFORE ranking)\n124:                                          └──> provider rewrite (local or hosted)\n125:                                               └──> fidelity validate (deterministic + semantic)\n126:                                                    └──> render decision:\n127:                                                         atomic replace | append | sidecar | original-only\n128: ```\n129: \n130: Consume it through the package's subpath exports (`@portable-cli/communication-projection`, plus `./contracts`, `./versioning`, `./providers`, `./privacy`, `./runtimes`, `./evaluation`, `./observability`, `./doctor`, `./release`). Key entry points: `selectPrivacyRoute` then `executeProviderRoute`; the runtime adapters' `adapt`/`present`; `runCompatibilityDoctor`; `evaluateReleaseReadiness`.\n131: \n132: ### The Two Presentation Tiers\n133: \n134: - **full-projection** — only a client-owned or headless path that owns a complete message AND an atomic render decision may claim a full 1:1 rewrite.\n135: - **safe-native** — a constrained native surface may only append, use a sidecar, or show original-only. It never claims 1:1 parity, and it never suppresses the original before a validated replacement exists.\n136: \n137: ### Verification\n138: \n139: Run the package's authoritative gate from the package directory: `npm run check` (typecheck, build, tests, import smoke). Test files run serially so latency benchmarks measure without contention.\n140: \n141: ---\n142: \n143: ## 4. RULES\n144: \n145: ### ✅ ALWAYS\n146: \n147: - Keep canonical transcripts, events, tool inputs, tool results, and future model context byte-for-byte unchanged.\n148: - Run privacy classification and egress consent BEFORE any cost, quality, or latency ranking.\n149: - Return the exact original bytes on any unsupported, unsafe, timed-out, cancelled, or failed path.\n150: - Make every runtime path declare full-projection or safe-native, and keep the two separate in any parity claim.\n151: - Keep telemetry content-free: reason codes only, never raw transcript, prompt, candidate, protected-span, or credential values; correlate with rotating keyed digests.\n152: - Revalidate OpenCode Go retention and training facts before the OpenCode Go preset's `expiresAt` (`packages/cli-communication-projection/src/providers/presets.ts`) and again at every release; a stale hosted-privacy fact blocks hosted routing.\n153: \n154: ### ❌ NEVER\n155: \n156: - Never write a projection back into canonical state to simulate an integration.\n157: - Never move locally classified text to a hosted provider without explicit, configured, allowed fallback.\n158: - Never treat a shared wire protocol as proof of model capability, privacy, retention, or fidelity — require dated evidence and fail closed on unknown.\n159: - Never count a safe-native result toward a full-projection 1:1 claim.\n160: - Never authorize a release on provisional or LLM-judge evaluation evidence; the release gate requires a human-certified non-inferiority result.\n161: \n162: ### ⚠️ ESCALATE IF\n163: \n164: - A capability, retention, residency, or protocol-major fact is unknown or stale — fail closed to original-only and surface it.\n165: - A release is requested before the powered blind human non-inferiority study has passed, or before a live credentialed provider smoke exists.\n166: \n167: ---\n168: \n169: ## 5. REFERENCES AND RELATED RESOURCES\n170: \n171: ### Core\n172: \n173: - `references/package-map.md` — the subsystem-to-path map and the public entry points; the smart router loads it.\n174: - `packages/cli-communication-projection/` — the implementation; read `src/<subsystem>/index.ts` for the public surface.\n175: - `packages/cli-communication-projection/docs/` — install, configuration, privacy, support-matrix, rollback, and runbook.\n176: \n177: ### Deep Detail\n178: \n179: - `specs/cli-external-orchestration/035-improved-communication/` — the eight-phase design record and frozen invariants; load only for the reasoning behind a rule above.\n180: \n181: ### Related Skills\n182: \n183: - `sk-code` — builds and verifies integration code against the package.\n184: - `sk-design` — owns a companion UI for a full-projection view.\n185: - `sk-git` — worktree, commits, and PR for the integration.\n186: \n187: ---\n188: \n189: ## 6. SUCCESS CRITERIA\n190: \n191: - The chosen path preserves the canonical original exactly and returns it on every failure.\n192: - Privacy runs before ranking, with no silent local-to-hosted egress.\n193: - Each runtime path declares and honors one presentation tier.\n194: - Telemetry is content-free and passes secret and content canaries.\n195: - The package gate (`npm run check`) is green from the final state.\n196: \n197: ---\n198: \n199: ## 7. INTEGRATION POINTS\n200: \n201: ### Inputs\n202: \n203: - A runtime's canonical event stream or transcript, plus provider and privacy configuration.\n204: \n205: ### Outputs\n206: \n207: - A validated display projection, or a typed safe fallback that shows the exact original.\n208: \n209: ### Related Workflows\n210: \n211: - `sk-code` builds and verifies integration code against this package.\n212: - `sk-design` owns any companion UI that renders a full-projection view.\n213: - `sk-git` handles the worktree, commits, and PR when integrating.\n\n(End of file - total 213 lines)\n</content>","metadata":{"preview":"---\nname: sk-communication\ndescription: Portable CLI projection layer that rewrites terse agent output to plain English while keeping canonical bytes unchanged.\nallowed-tools: [Read, Bash, Grep, Glob]\nversion: 1.0.0.0\n---\n\n<!-- Keywords: communication projection, claudish to english, rewrite CLI output, plain-english projection, presentation projection, privacy-first rewrite, full-projection, safe-native, provider adapters, exact-original fallback, deepseek ollama llama.cpp, blind non-inferiority evaluation, compatibility doctor, release gate -->\n\n# Communication Projection\n\nMake supported CLI and agent output read like careful plain English, across Claude, Codex, Pi, OpenCode, Devin, and Cursor, while leaving the canonical event stream, transcript, tool data, and model context byte-for-byte unchanged. Every unsafe or failed path returns the exact original. The implementation is the `@portable-cli/communication-projection` package under `packages/cli-communication-projection/`; this skill routes you to the right part of it and enforces its invariants.\n\n---\n\n## 1. WHEN TO USE\n\n### Activation Triggers\n\nUse this skill when the request involves:","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/.opencode/skills/sk-communication/SKILL.md","text":"---\nname: sk-communication\ndescription: Portable CLI projection layer that rewrites terse agent output to plain English while keeping canonical bytes unchanged.\nallowed-tools: [Read, Bash, Grep, Glob]\nversion: 1.0.0.0\n---\n\n<!-- Keywords: communication projection, claudish to english, rewrite CLI output, plain-english projection, presentation projection, privacy-first rewrite, full-projection, safe-native, provider adapters, exact-original fallback, deepseek ollama llama.cpp, blind non-inferiority evaluation, compatibility doctor, release gate -->\n\n# Communication Projection\n\nMake supported CLI and agent output read like careful plain English, across Claude, Codex, Pi, OpenCode, Devin, and Cursor, while leaving the canonical event stream, transcript, tool data, and model context byte-for-byte unchanged. Every unsafe or failed path returns the exact original. The implementation is the `@portable-cli/communication-projection` package under `packages/cli-communication-projection/`; this skill routes you to the right part of it and enforces its invariants.\n\n---\n\n## 1. WHEN TO USE\n\n### Activation Triggers\n\nUse this skill when the request involves:\n\n- Rewriting terse, robotic CLI or agent status output into readable prose without changing the underlying data.\n- A provider-neutral \"claudish to English\" projection layer across multiple CLIs.\n- Choosing where rewriting happens — a local model or a hosted one — under explicit privacy and egress rules.\n- Wiring one of the six runtime adapters (Claude, Codex, Pi, OpenCode, Devin, Cursor) to a rewrite pipeline.\n- Deciding a presentation tier: full 1:1 projection versus a safe-native fallback.\n- Measuring whether rewritten output reads as well as a human reference (blind non-inferiority evaluation), or gating a release on that evidence.\n\n### Keyword Triggers\n\n`communication projection`, `claudish to english`, `rewrite CLI output`, `plain-english projection`, `privacy-first rewrite`, `full-projection`, `safe-native`, `provider adapters`, `exact-original fallback`, `compatibility doctor`, `release gate`, `non-inferiority evaluation`.\n\n### When NOT to Use\n\n- General application code implementation → `sk-code`.\n- Authoring documentation or markdown → `sk-doc`.\n- UI or visual design → `sk-design`.\n- Git worktrees, commits, or PRs → `sk-git`.\n- Rewriting durable Markdown or any on-disk file. That changes canonical bytes and is explicitly out of scope; it needs a separate opt-in product contract, not this projection layer.\n\n---\n\n## 2. SMART ROUTING\n\n### Routing Signals\n\nThe capability is one package split by responsibility. Route to the subsystem the request needs:\n\n| Request signal | Package surface |\n|---|---|\n| Assemble a whole message, bound context, versioned prompt profile | `src/core/`, `src/context/`, `src/contracts/` |\n| Preserve protected spans, validate meaning, decide how to display | `src/fidelity/`, `src/render/` |\n| Pick a local vs hosted model under privacy rules | `src/privacy/`, `src/providers/` |\n| Wire a specific CLI adapter or its display | `src/runtimes/`, `src/clients/` |\n| Score quality or aggregate private telemetry | `src/evaluation/`, `src/observability/` |\n| Check compatibility, gate a release, or roll back | `src/doctor/`, `src/release/` |\n\n### Resource Domains\n\n- The package itself under `packages/cli-communication-projection/` is the primary resource; its `docs/` folder holds install, configuration, privacy, support-matrix, rollback, and runbook guidance.\n- The design and requirements history lives in the spec epic under `specs/cli-external-orchestration/035-improved-communication/`.\n\n### Loading Levels\n\n- ALWAYS: read the relevant `src/<subsystem>/index.ts` exports before integrating against them.\n- CONDITIONAL: read the matching `docs/*.md` when the task is install, privacy, support, or rollback.\n- ON_DEMAND: read the spec epic only for the \"why\" behind a frozen invariant.\n\n### Smart Router Pseudocode\n\n```python\nfrom pathlib import Path\n\nSKILL_ROOT = Path(__file__).resolve().parent\nRESOURCE_BASES = (SKILL_ROOT / \"references\",)\nUNKNOWN_FALLBACK = {\n    \"load_level\": \"UNKNOWN_FALLBACK\",\n    \"needs_disambiguation\": True,\n    \"checklist\": [\n        \"Confirm which subsystem the task touches\",\n        \"Provide one concrete input or expected outcome\",\n    ],\n}\n\ndef discover_markdown_resources() -> set[str]:\n    docs = []\n    for base in RESOURCE_BASES:\n        if base.exists():\n            docs.extend(path for path in base.rglob(\"*.md\") if path.is_file())\n    return {doc.relative_to(SKILL_ROOT).as_posix() for doc in docs}\n\ndef _guard_in_skill(relative_path: str) -> str:\n    resolved = (SKILL_ROOT / relative_path).resolve()\n    resolved.relative_to(SKILL_ROOT)\n    if resolved.suffix.lower() != \".md\":\n        raise ValueError(\"Only skill-local markdown resources are routable\")\n    return resolved.relative_to(SKILL_ROOT).as_posix()\n\ndef route_resources(request):\n    inventory = discover_markdown_resources()\n    selected = [\"references/package-map.md\"] if inventory else []\n    if not selected:\n        return {**UNKNOWN_FALLBACK, \"resources\": []}\n    loaded = []\n    for relative_path in selected:\n        guarded = _guard_in_skill(relative_path)\n        if guarded in inventory and guarded not in loaded:\n            load(guarded)\n            loaded.append(guarded)\n    return {\"resources\": loaded}\n```\n\n---\n\n## 3. HOW IT WORKS\n\n### The Pipeline\n\n```text\ncanonical event/transcript ──> unchanged persistence + model context\n                          └──> assemble message + bound context\n                               └──> protect spans\n                                    └──> privacy route (classify + consent BEFORE ranking)\n                                         └──> provider rewrite (local or hosted)\n                                              └──> fidelity validate (deterministic + semantic)\n                                                   └──> render decision:\n                                                        atomic replace | append | sidecar | original-only\n```\n\nConsume it through the package's subpath exports (`@portable-cli/communication-projection`, plus `./contracts`, `./versioning`, `./providers`, `./privacy`, `./runtimes`, `./evaluation`, `./observability`, `./doctor`, `./release`). Key entry points: `selectPrivacyRoute` then `executeProviderRoute`; the runtime adapters' `adapt`/`present`; `runCompatibilityDoctor`; `evaluateReleaseReadiness`.\n\n### The Two Presentation Tiers\n\n- **full-projection** — only a client-owned or headless path that owns a complete message AND an atomic render decision may claim a full 1:1 rewrite.\n- **safe-native** — a constrained native surface may only append, use a sidecar, or show original-only. It never claims 1:1 parity, and it never suppresses the original before a validated replacement exists.\n\n### Verification\n\nRun the package's authoritative gate from the package directory: `npm run check` (typecheck, build, tests, import smoke). Test files run serially so latency benchmarks measure without contention.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n\n- Keep canonical transcripts, events, tool inputs, tool results, and future model context byte-for-byte unchanged.\n- Run privacy classification and egress consent BEFORE any cost, quality, or latency ranking.\n- Return the exact original bytes on any unsupported, unsafe, timed-out, cancelled, or failed path.\n- Make every runtime path declare full-projection or safe-native, and keep the two separate in any parity claim.\n- Keep telemetry content-free: reason codes only, never raw transcript, prompt, candidate, protected-span, or credential values; correlate with rotating keyed digests.\n- Revalidate OpenCode Go retention and training facts before the OpenCode Go preset's `expiresAt` (`packages/cli-communication-projection/src/providers/presets.ts`) and again at every release; a stale hosted-privacy fact blocks hosted routing.\n\n### ❌ NEVER\n\n- Never write a projection back into canonical state to simulate an integration.\n- Never move locally classified text to a hosted provider without explicit, configured, allowed fallback.\n- Never treat a shared wire protocol as proof of model capability, privacy, retention, or fidelity — require dated evidence and fail closed on unknown.\n- Never count a safe-native result toward a full-projection 1:1 claim.\n- Never authorize a release on provisional or LLM-judge evaluation evidence; the release gate requires a human-certified non-inferiority result.\n\n### ⚠️ ESCALATE IF\n\n- A capability, retention, residency, or protocol-major fact is unknown or stale — fail closed to original-only and surface it.\n- A release is requested before the powered blind human non-inferiority study has passed, or before a live credentialed provider smoke exists.\n\n---\n\n## 5. REFERENCES AND RELATED RESOURCES\n\n### Core\n\n- `references/package-map.md` — the subsystem-to-path map and the public entry points; the smart router loads it.\n- `packages/cli-communication-projection/` — the implementation; read `src/<subsystem>/index.ts` for the public surface.\n- `packages/cli-communication-projection/docs/` — install, configuration, privacy, support-matrix, rollback, and runbook.\n\n### Deep Detail\n\n- `specs/cli-external-orchestration/035-improved-communication/` — the eight-phase design record and frozen invariants; load only for the reasoning behind a rule above.\n\n### Related Skills\n\n- `sk-code` — builds and verifies integration code against the package.\n- `sk-design` — owns a companion UI for a full-projection view.\n- `sk-git` — worktree, commits, and PR for the integration.\n\n---\n\n## 6. SUCCESS CRITERIA\n\n- The chosen path preserves the canonical original exactly and returns it on every failure.\n- Privacy runs before ranking, with no silent local-to-hosted egress.\n- Each runtime path declares and honors one presentation tier.\n- Telemetry is content-free and passes secret and content canaries.\n- The package gate (`npm run check`) is green from the final state.\n\n---\n\n## 7. INTEGRATION POINTS\n\n### Inputs\n\n- A runtime's canonical event stream or transcript, plus provider and privacy configuration.\n\n### Outputs\n\n- A validated display projection, or a typed safe fallback that shows the exact original.\n\n### Related Workflows\n\n- `sk-code` builds and verifies integration code against this package.\n- `sk-design` owns any companion UI that renders a full-projection view.\n- `sk-git` handles the worktree, commits, and PR when integrating.","lineStart":1,"lineEnd":213,"totalLines":213,"truncated":false}},"title":".opencode/skills/sk-communication/SKILL.md","time":{"start":1786568943100,"end":1786568943105}},"id":"prt_ff7cea45a001h7ci4udqJvD5XH","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ce8bf30010ow85Mn5Zuada1"}}
{"type":"step_finish","timestamp":1786568943745,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"id":"prt_ff7cea87e001sRgC9S9J4iP9VO","reason":"tool-calls","snapshot":"9c6988a6c1fe0834218f2cf112d05862516ca9bd","messageID":"msg_ff7ce8bf30010ow85Mn5Zuada1","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","type":"step-finish","tokens":{"total":110162,"input":10069,"output":248,"reasoning":133,"cache":{"write":0,"read":99712}},"cost":0.005072941}}
{"type":"step_start","timestamp":1786568946739,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"id":"prt_ff7ceb432001JMtrz7I2HXEN7X","messageID":"msg_ff7ceaa57001pU9tt1yysZXnJb","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","snapshot":"9c6988a6c1fe0834218f2cf112d05862516ca9bd","type":"step-start"}}
{"type":"tool_use","timestamp":1786568950082,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_00_OELydFXU5smErm1xjZYh7323","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/validator.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/validator.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Fidelity Validation Pipeline\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { createSha256Digest, decodeExactOriginal } from '../contracts/exact-original.js';\n6: import { validateExactOriginal } from '../contracts/validate-event.js';\n7: import { isRecord } from '../contracts/validator-utils.js';\n8: import {\n9:   createMarkdownStructureSignature,\n10:   hasUnpairedSurrogate,\n11: } from './dialect.js';\n12: import { deepFreeze, freezeExactOriginal } from './freeze.js';\n13: import { restoreProtectedSpans } from './protected-spans.js';\n14: import {\n15:   compareSemanticMeaning,\n16:   countContentCodepoints,\n17:   isUnexpectedRefusal,\n18: } from './semantics.js';\n19: import { FidelityReasonCodes } from './types.js';\n20: \n21: import type { ValidationIssue } from '../contracts/common.js';\n22: import type { ExactOriginalRecord } from '../contracts/exact-original.js';\n23: import type {\n24:   FidelityCheck,\n25:   FidelityInputRejection,\n26:   FidelityOutcome,\n27:   FidelityReasonCode,\n28:   FidelityValidationResult,\n29:   ProjectionValidationInput,\n30:   ProtectedDocument,\n31:   ProviderTerminalState,\n32:   RejectOnlyJudge,\n33: } from './types.js';\n34: \n35: const INPUT_KEYS = [\n36:   'protection',\n37:   'candidateText',\n38:   'providerTerminal',\n39:   'allPartsComplete',\n40:   'currentSourceSha256',\n41:   'judgeMode',\n42:   'maximumOutputBytes',\n43:   'minimumContentRatio',\n44:   'judgeTimeoutMs',\n45:   'signal',\n46: ] as const;\n47: const PROVIDER_TERMINALS: readonly ProviderTerminalState[] = [\n48:   'cancelled',\n49:   'error',\n50:   'success',\n51:   'timeout',\n52:   'truncated',\n53: ];\n54: const SHA256_PATTERN = /^sha256:[a-f0-9]{64}$/u;\n55: const DEFAULT_JUDGE_TIMEOUT_MS = 30_000;\n56: const DEFAULT_MINIMUM_CONTENT_RATIO = 0.2;\n57: const MAX_OUTPUT_BYTES = 64 * 1024 * 1024;\n58: \n59: /** Validate a protected provider candidate and select acceptance or exact original. */\n60: export async function validateProjectionCandidate(\n61:   input: unknown,\n62:   judge?: RejectOnlyJudge,\n63: ): Promise<FidelityValidationResult> {\n64:   try {\n65:     return await validateProjectionCandidateInternal(input, judge);\n66:   } catch (error: unknown) {\n67:     try {\n68:       if (isRecord(input) && isRecord(input.protection)) {\n69:         const exactResult = validateExactOriginal(input.protection.exactOriginal);\n70:         if (exactResult.success) {\n71:           return fallbackFromExactOriginal(\n72:             exactResult.value,\n73:             FidelityReasonCodes.VALIDATOR_FAILED,\n74:             [],\n75:             null,\n76:             null,\n77:           );\n78:         }\n79:       }\n80:     } catch (recoveryError: unknown) {\n81:       return rejectedInput([issue('$', 'validator_failed', 'Validation failed closed.')]);\n82:     }\n83:     return rejectedInput([issue('$', 'validator_failed', 'Validation failed closed.')]);\n84:   }\n85: }\n86: \n87: async function validateProjectionCandidateInternal(\n88:   input: unknown,\n89:   judge?: RejectOnlyJudge,\n90: ): Promise<FidelityValidationResult> {\n91:   if (!isRecord(input) || !isRecord(input.protection)) {\n92:     return rejectedInput([issue('$', 'type', 'Validation input and protection are required.')]);\n93:   }\n94:   const protection = input.protection as unknown as ProtectedDocument;\n95:   const originalResult = validateExactOriginal(protection.exactOriginal);\n96:   if (!originalResult.success) {\n97:     return rejectedInput(prefixIssues('$.protection.exactOriginal', originalResult.issues));\n98:   }\n99: \n100:   const inputIssues = validateInput(input);\n101:   if (inputIssues.length > 0) {\n102:     return fallbackFromExactOriginal(\n103:       originalResult.value,\n104:       FidelityReasonCodes.INVALID_INPUT,\n105:       [],\n106:       null,\n107:       null,\n108:     );\n109:   }\n110:   const request = input as unknown as ProjectionValidationInput;\n111:   const checks: FidelityCheck[] = [];\n112: \n113:   if (request.signal?.aborted === true) {\n114:     return fallback(protection, FidelityReasonCodes.CANCELLED, checks, null, null);\n115:   }\n116:   if (request.currentSourceSha256 !== protection.sourceSha256) {\n117:     return fallback(protection, FidelityReasonCodes.SOURCE_CHANGED, checks, 1, 0);\n118:   }\n119: \n120:   const providerFailure = providerFailureReason(request.providerTerminal);\n121:   if (providerFailure !== null) {\n122:     return fallback(protection, providerFailure, checks, null, null);\n123:   }\n124:   if (!request.allPartsComplete) {\n125:     return fallback(protection, FidelityReasonCodes.TRUNCATED_OUTPUT, checks, 1, 0);\n126:   }\n127:   if (request.candidateText.trim().length === 0) {\n128:     return fallback(protection, FidelityReasonCodes.EMPTY_OUTPUT, checks, 1, 0);\n129:   }\n130:   if (hasUnpairedSurrogate(request.candidateText)) {\n131:     return fallback(protection, FidelityReasonCodes.INVALID_ENCODING, checks, null, null);\n132:   }\n133: \n134:   const candidateBytes = new TextEncoder().encode(request.candidateText);\n135:   const maximumOutputBytes = request.maximumOutputBytes\n136:     ?? Math.min(\n137:       MAX_OUTPUT_BYTES,\n138:       Math.max(protection.sourceByteLength * 4, protection.sourceByteLength + 65_536),\n139:     );\n140:   if (candidateBytes.byteLength > maximumOutputBytes) {\n141:     return fallback(\n142:       protection,\n143:       FidelityReasonCodes.OUTPUT_LIMIT,\n144:       checks,\n145:       maximumOutputBytes,\n146:       candidateBytes.byteLength,\n147:     );\n148:   }\n149: \n150:   const restored = restoreProtectedSpans(protection, request.candidateText);\n151:   if (restored.status === 'rejected') {\n152:     if ('issues' in restored) {\n153:       return fallbackFromExactOriginal(\n154:         originalResult.value,\n155:         FidelityReasonCodes.INVALID_INPUT,\n156:         [],\n157:         null,\n158:         null,\n159:       );\n160:     }\n161:     return deepFreeze({\n162:       status: 'exact-original',\n163:       reasonCode: restored.reasonCode,\n164:       sourceSha256: protection.sourceSha256,\n165:       projectionSha256: null,\n166:       projectionByteLength: protection.exactOriginal.byteLength,\n167:       projectionText: null,\n168:       validationProfileVersion: 'fidelity/1.0.0',\n169:       exactOriginal: protection.exactOriginal,\n170:       checks: restored.checks,\n171:     });\n172:   }\n173:   checks.push(...restored.checks);\n174: \n175:   let sourceText: string;\n176:   try {\n177:     sourceText = new TextDecoder('utf-8', { fatal: true })\n178:       .decode(decodeExactOriginal(protection.exactOriginal));\n179:   } catch (error: unknown) {\n180:     return fallback(protection, FidelityReasonCodes.INVALID_ENCODING, checks, null, null);\n181:   }\n182: \n183:   if (restored.text !== sourceText) {\n184:     if (isUnexpectedRefusal(sourceText, restored.text)) {\n185:       return fallback(protection, FidelityReasonCodes.REFUSAL_OUTPUT, checks, 0, 1);\n186:     }\n187:     const minimumRatio = request.minimumContentRatio ?? DEFAULT_MINIMUM_CONTENT_RATIO;\n188:     const sourceContent = countContentCodepoints(sourceText);\n189:     const candidateContent = countContentCodepoints(restored.text);\n190:     if (sourceContent > 0 && candidateContent / sourceContent < minimumRatio) {\n191:       return fallback(\n192:         protection,\n193:         FidelityReasonCodes.TRUNCATED_OUTPUT,\n194:         checks,\n195:         Math.ceil(sourceContent * minimumRatio),\n196:         candidateContent,\n197:       );\n198:     }\n199: \n200:     const sourceStructure = createMarkdownStructureSignature(sourceText);\n201:     const candidateStructure = createMarkdownStructureSignature(restored.text);\n202:     if (sourceStructure !== candidateStructure) {\n203:       return fallback(\n204:         protection,\n205:         FidelityReasonCodes.MARKDOWN_STRUCTURE_CHANGED,\n206:         checks,\n207:         1,\n208:         0,\n209:       );\n210:     }\n211: \n212:     const semanticDifference = compareSemanticMeaning(sourceText, restored.text);\n213:     if (semanticDifference !== null) {\n214:       return fallback(\n215:         protection,\n216:         semanticDifference.reasonCode,\n217:         checks,\n218:         semanticDifference.expectedCount,\n219:         semanticDifference.actualCount,\n220:       );\n221:     }\n222:   }\n223:   checks.push(passed(FidelityReasonCodes.MARKDOWN_STRUCTURE_CHANGED));\n224:   checks.push(passed(FidelityReasonCodes.FACT_ADDED));\n225:   checks.push(passed(FidelityReasonCodes.POLARITY_CHANGED));\n226:   checks.push(passed(FidelityReasonCodes.REQUIREMENT_STRENGTH_CHANGED));\n227:   checks.push(passed(FidelityReasonCodes.PRIORITY_CHANGED));\n228: \n229:   if (request.judgeMode === 'required') {\n230:     if (judge === undefined) {\n231:       return fallback(protection, FidelityReasonCodes.JUDGE_UNAVAILABLE, checks, 1, 0);\n232:     }\n233:     const judgeResult = await runJudge(\n234:       judge,\n235:       sourceText,\n236:       restored.text,\n237:       request.judgeTimeoutMs ?? DEFAULT_JUDGE_TIMEOUT_MS,\n238:       request.signal,\n239:     );\n240:     if (judgeResult !== 'accept') {\n241:       return fallback(protection, judgeReason(judgeResult), checks, 1, 0);\n242:     }\n243:     checks.push(passed(FidelityReasonCodes.JUDGE_REJECTED));\n244:   }\n245: \n246:   const projectionBytes = new TextEncoder().encode(restored.text);\n247:   checks.push(passed(FidelityReasonCodes.ACCEPTED));\n248:   return deepFreeze({\n249:     status: 'accepted',\n250:     reasonCode: FidelityReasonCodes.ACCEPTED,\n251:     sourceSha256: protection.sourceSha256,\n252:     projectionSha256: createSha256Digest(projectionBytes),\n253:     projectionByteLength: projectionBytes.byteLength,\n254:     projectionText: restored.text,\n255:     validationProfileVersion: 'fidelity/1.0.0',\n256:     exactOriginal: protection.exactOriginal,\n257:     checks,\n258:   });\n259: }\n260: \n261: function validateInput(input: Record<string, unknown>): ValidationIssue[] {\n262:   const issues: ValidationIssue[] = [];\n263:   for (const key of Object.keys(input)) {\n264:     if (!(INPUT_KEYS as readonly string[]).includes(key)) {\n265:       issues.push(issue(`$.${key}`, 'unknown_key', 'Field is not permitted at this boundary.'));\n266:     }\n267:   }\n268:   if (typeof input.candidateText !== 'string') {\n269:     issues.push(issue('$.candidateText', 'type', 'Candidate text must be a string.'));\n270:   }\n271:   if (\n272:     typeof input.providerTerminal !== 'string'\n273:     || !PROVIDER_TERMINALS.includes(input.providerTerminal as ProviderTerminalState)\n274:   ) {\n275:     issues.push(issue('$.providerTerminal', 'enum', 'Provider terminal state is invalid.'));\n276:   }\n277:   if (typeof input.allPartsComplete !== 'boolean') {\n278:     issues.push(issue('$.allPartsComplete', 'type', 'Part completeness must be boolean.'));\n279:   }\n280:   if (\n281:     typeof input.currentSourceSha256 !== 'string'\n282:     || !SHA256_PATTERN.test(input.currentSourceSha256)\n283:   ) {\n284:     issues.push(issue('$.currentSourceSha256', 'digest', 'Current source digest is invalid.'));\n285:   }\n286:   if (input.judgeMode !== 'disabled' && input.judgeMode !== 'required') {\n287:     issues.push(issue('$.judgeMode', 'enum', 'Judge mode is invalid.'));\n288:   }\n289:   validateOptionalInteger(input.maximumOutputBytes, '$.maximumOutputBytes', 1, MAX_OUTPUT_BYTES, issues);\n290:   validateOptionalNumber(input.minimumContentRatio, '$.minimumContentRatio', 0.01, 1, issues);\n291:   validateOptionalInteger(input.judgeTimeoutMs, '$.judgeTimeoutMs', 1, 120_000, issues);\n292:   if (input.signal !== undefined && !isAbortSignal(input.signal)) {\n293:     issues.push(issue('$.signal', 'type', 'Signal must implement the AbortSignal contract.'));\n294:   }\n295:   return issues;\n296: }\n297: \n298: function providerFailureReason(\n299:   terminal: ProviderTerminalState,\n300: ): Exclude<FidelityReasonCode, 'accepted'> | null {\n301:   switch (terminal) {\n302:     case 'success':\n303:       return null;\n304:     case 'error':\n305:       return FidelityReasonCodes.PROVIDER_ERROR;\n306:     case 'cancelled':\n307:       return FidelityReasonCodes.PROVIDER_CANCELLED;\n308:     case 'timeout':\n309:       return FidelityReasonCodes.PROVIDER_TIMEOUT;\n310:     case 'truncated':\n311:       return FidelityReasonCodes.TRUNCATED_OUTPUT;\n312:   }\n313: }\n314: \n315: type JudgeRunResult = 'accept' | 'cancelled' | 'failed' | 'reject' | 'timeout';\n316: \n317: async function runJudge(\n318:   judge: RejectOnlyJudge,\n319:   sourceText: string,\n320:   candidateText: string,\n321:   timeoutMs: number,\n322:   externalSignal?: AbortSignal,\n323: ): Promise<JudgeRunResult> {\n324:   const controller = new AbortController();\n325:   let timer: ReturnType<typeof setTimeout> | undefined;\n326:   let removeAbortListener: (() => void) | undefined;\n327:   const judgePromise = Promise.resolve()\n328:     .then(() => judge({ sourceText, candidateText, signal: controller.signal }))\n329:     .then((result): JudgeRunResult => result === 'accept' || result === 'reject' ? result : 'failed')\n330:     .catch((): JudgeRunResult => 'failed');\n331:   const timeoutPromise = new Promise<JudgeRunResult>((resolve) => {\n332:     timer = setTimeout(() => {\n333:       controller.abort();\n334:       resolve('timeout');\n335:     }, timeoutMs);\n336:   });\n337:   const cancellationPromise = new Promise<JudgeRunResult>((resolve) => {\n338:     if (externalSignal === undefined) {\n339:       return;\n340:     }\n341:     const onAbort = (): void => {\n342:       controller.abort();\n343:       resolve('cancelled');\n344:     };\n345:     externalSignal.addEventListener('abort', onAbort, { once: true });\n346:     removeAbortListener = () => externalSignal.removeEventListener('abort', onAbort);\n347:   });\n348: \n349:   try {\n350:     return await Promise.race([judgePromise, timeoutPromise, cancellationPromise]);\n351:   } finally {\n352:     if (timer !== undefined) {\n353:       clearTimeout(timer);\n354:     }\n355:     removeAbortListener?.();\n356:   }\n357: }\n358: \n359: function judgeReason(result: Exclude<JudgeRunResult, 'accept'>): Exclude<FidelityReasonCode, 'accepted'> {\n360:   switch (result) {\n361:     case 'reject':\n362:       return FidelityReasonCodes.JUDGE_REJECTED;\n363:     case 'timeout':\n364:       return FidelityReasonCodes.JUDGE_TIMEOUT;\n365:     case 'cancelled':\n366:       return FidelityReasonCodes.CANCELLED;\n367:     case 'failed':\n368:       return FidelityReasonCodes.JUDGE_FAILED;\n369:   }\n370: }\n371: \n372: function fallback(\n373:   protection: ProtectedDocument,\n374:   reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n375:   checks: readonly FidelityCheck[],\n376:   expectedCount: number | null,\n377:   actualCount: number | null,\n378: ): FidelityOutcome {\n379:   return fallbackFromExactOriginal(\n380:     protection.exactOriginal,\n381:     reasonCode,\n382:     checks,\n383:     expectedCount,\n384:     actualCount,\n385:   );\n386: }\n387: \n388: function fallbackFromExactOriginal(\n389:   exactOriginal: ExactOriginalRecord,\n390:   reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n391:   checks: readonly FidelityCheck[],\n392:   expectedCount: number | null,\n393:   actualCount: number | null,\n394: ): FidelityOutcome {\n395:   const safeExactOriginal = freezeExactOriginal(exactOriginal);\n396:   return deepFreeze({\n397:     status: 'exact-original',\n398:     reasonCode,\n399:     sourceSha256: safeExactOriginal.sha256,\n400:     projectionSha256: null,\n401:     projectionByteLength: safeExactOriginal.byteLength,\n402:     projectionText: null,\n403:     validationProfileVersion: 'fidelity/1.0.0',\n404:     exactOriginal: safeExactOriginal,\n405:     checks: [...checks, {\n406:       ruleId: reasonCode,\n407:       status: 'failed',\n408:       expectedCount,\n409:       actualCount,\n410:     }],\n411:   });\n412: }\n413: \n414: function passed(ruleId: FidelityReasonCode): FidelityCheck {\n415:   return Object.freeze({\n416:     ruleId,\n417:     status: 'passed',\n418:     expectedCount: null,\n419:     actualCount: null,\n420:   });\n421: }\n422: \n423: function rejectedInput(issues: readonly ValidationIssue[]): FidelityInputRejection {\n424:   return deepFreeze({ status: 'rejected', reasonCode: 'invalid-input', issues: [...issues] });\n425: }\n426: \n427: function validateOptionalInteger(\n428:   value: unknown,\n429:   path: string,\n430:   minimum: number,\n431:   maximum: number,\n432:   issues: ValidationIssue[],\n433: ): void {\n434:   if (\n435:     value !== undefined\n436:     && (typeof value !== 'number'\n437:       || !Number.isInteger(value)\n438:       || value < minimum\n439:       || value > maximum)\n440:   ) {\n441:     issues.push(issue(path, 'range', 'Expected a bounded integer.'));\n442:   }\n443: }\n444: \n445: function validateOptionalNumber(\n446:   value: unknown,\n447:   path: string,\n448:   minimum: number,\n449:   maximum: number,\n450:   issues: ValidationIssue[],\n451: ): void {\n452:   if (\n453:     value !== undefined\n454:     && (typeof value !== 'number'\n455:       || !Number.isFinite(value)\n456:       || value < minimum\n457:       || value > maximum)\n458:   ) {\n459:     issues.push(issue(path, 'range', 'Expected a bounded finite number.'));\n460:   }\n461: }\n462: \n463: function isAbortSignal(value: unknown): value is AbortSignal {\n464:   return isRecord(value)\n465:     && typeof value.aborted === 'boolean'\n466:     && typeof value.addEventListener === 'function'\n467:     && typeof value.removeEventListener === 'function';\n468: }\n469: \n470: function issue(path: string, code: string, message: string): ValidationIssue {\n471:   return Object.freeze({ path, code, message });\n472: }\n473: \n474: function prefixIssues(\n475:   path: string,\n476:   issues: readonly ValidationIssue[],\n477: ): ValidationIssue[] {\n478:   return issues.map((entry) => ({\n479:     ...entry,\n480:     path: `${path}${entry.path === '$' ? '' : entry.path.slice(1)}`,\n481:   }));\n482: }\n\n(End of file - total 482 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Fidelity Validation Pipeline\n// ───────────────────────────────────────────────────────────────────\n\nimport { createSha256Digest, decodeExactOriginal } from '../contracts/exact-original.js';\nimport { validateExactOriginal } from '../contracts/validate-event.js';\nimport { isRecord } from '../contracts/validator-utils.js';\nimport {\n  createMarkdownStructureSignature,\n  hasUnpairedSurrogate,\n} from './dialect.js';\nimport { deepFreeze, freezeExactOriginal } from './freeze.js';\nimport { restoreProtectedSpans } from './protected-spans.js';\nimport {\n  compareSemanticMeaning,\n  countContentCodepoints,\n  isUnexpectedRefusal,\n} from './semantics.js';\nimport { FidelityReasonCodes } from './types.js';\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/validator.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Fidelity Validation Pipeline\n// ───────────────────────────────────────────────────────────────────\n\nimport { createSha256Digest, decodeExactOriginal } from '../contracts/exact-original.js';\nimport { validateExactOriginal } from '../contracts/validate-event.js';\nimport { isRecord } from '../contracts/validator-utils.js';\nimport {\n  createMarkdownStructureSignature,\n  hasUnpairedSurrogate,\n} from './dialect.js';\nimport { deepFreeze, freezeExactOriginal } from './freeze.js';\nimport { restoreProtectedSpans } from './protected-spans.js';\nimport {\n  compareSemanticMeaning,\n  countContentCodepoints,\n  isUnexpectedRefusal,\n} from './semantics.js';\nimport { FidelityReasonCodes } from './types.js';\n\nimport type { ValidationIssue } from '../contracts/common.js';\nimport type { ExactOriginalRecord } from '../contracts/exact-original.js';\nimport type {\n  FidelityCheck,\n  FidelityInputRejection,\n  FidelityOutcome,\n  FidelityReasonCode,\n  FidelityValidationResult,\n  ProjectionValidationInput,\n  ProtectedDocument,\n  ProviderTerminalState,\n  RejectOnlyJudge,\n} from './types.js';\n\nconst INPUT_KEYS = [\n  'protection',\n  'candidateText',\n  'providerTerminal',\n  'allPartsComplete',\n  'currentSourceSha256',\n  'judgeMode',\n  'maximumOutputBytes',\n  'minimumContentRatio',\n  'judgeTimeoutMs',\n  'signal',\n] as const;\nconst PROVIDER_TERMINALS: readonly ProviderTerminalState[] = [\n  'cancelled',\n  'error',\n  'success',\n  'timeout',\n  'truncated',\n];\nconst SHA256_PATTERN = /^sha256:[a-f0-9]{64}$/u;\nconst DEFAULT_JUDGE_TIMEOUT_MS = 30_000;\nconst DEFAULT_MINIMUM_CONTENT_RATIO = 0.2;\nconst MAX_OUTPUT_BYTES = 64 * 1024 * 1024;\n\n/** Validate a protected provider candidate and select acceptance or exact original. */\nexport async function validateProjectionCandidate(\n  input: unknown,\n  judge?: RejectOnlyJudge,\n): Promise<FidelityValidationResult> {\n  try {\n    return await validateProjectionCandidateInternal(input, judge);\n  } catch (error: unknown) {\n    try {\n      if (isRecord(input) && isRecord(input.protection)) {\n        const exactResult = validateExactOriginal(input.protection.exactOriginal);\n        if (exactResult.success) {\n          return fallbackFromExactOriginal(\n            exactResult.value,\n            FidelityReasonCodes.VALIDATOR_FAILED,\n            [],\n            null,\n            null,\n          );\n        }\n      }\n    } catch (recoveryError: unknown) {\n      return rejectedInput([issue('$', 'validator_failed', 'Validation failed closed.')]);\n    }\n    return rejectedInput([issue('$', 'validator_failed', 'Validation failed closed.')]);\n  }\n}\n\nasync function validateProjectionCandidateInternal(\n  input: unknown,\n  judge?: RejectOnlyJudge,\n): Promise<FidelityValidationResult> {\n  if (!isRecord(input) || !isRecord(input.protection)) {\n    return rejectedInput([issue('$', 'type', 'Validation input and protection are required.')]);\n  }\n  const protection = input.protection as unknown as ProtectedDocument;\n  const originalResult = validateExactOriginal(protection.exactOriginal);\n  if (!originalResult.success) {\n    return rejectedInput(prefixIssues('$.protection.exactOriginal', originalResult.issues));\n  }\n\n  const inputIssues = validateInput(input);\n  if (inputIssues.length > 0) {\n    return fallbackFromExactOriginal(\n      originalResult.value,\n      FidelityReasonCodes.INVALID_INPUT,\n      [],\n      null,\n      null,\n    );\n  }\n  const request = input as unknown as ProjectionValidationInput;\n  const checks: FidelityCheck[] = [];\n\n  if (request.signal?.aborted === true) {\n    return fallback(protection, FidelityReasonCodes.CANCELLED, checks, null, null);\n  }\n  if (request.currentSourceSha256 !== protection.sourceSha256) {\n    return fallback(protection, FidelityReasonCodes.SOURCE_CHANGED, checks, 1, 0);\n  }\n\n  const providerFailure = providerFailureReason(request.providerTerminal);\n  if (providerFailure !== null) {\n    return fallback(protection, providerFailure, checks, null, null);\n  }\n  if (!request.allPartsComplete) {\n    return fallback(protection, FidelityReasonCodes.TRUNCATED_OUTPUT, checks, 1, 0);\n  }\n  if (request.candidateText.trim().length === 0) {\n    return fallback(protection, FidelityReasonCodes.EMPTY_OUTPUT, checks, 1, 0);\n  }\n  if (hasUnpairedSurrogate(request.candidateText)) {\n    return fallback(protection, FidelityReasonCodes.INVALID_ENCODING, checks, null, null);\n  }\n\n  const candidateBytes = new TextEncoder().encode(request.candidateText);\n  const maximumOutputBytes = request.maximumOutputBytes\n    ?? Math.min(\n      MAX_OUTPUT_BYTES,\n      Math.max(protection.sourceByteLength * 4, protection.sourceByteLength + 65_536),\n    );\n  if (candidateBytes.byteLength > maximumOutputBytes) {\n    return fallback(\n      protection,\n      FidelityReasonCodes.OUTPUT_LIMIT,\n      checks,\n      maximumOutputBytes,\n      candidateBytes.byteLength,\n    );\n  }\n\n  const restored = restoreProtectedSpans(protection, request.candidateText);\n  if (restored.status === 'rejected') {\n    if ('issues' in restored) {\n      return fallbackFromExactOriginal(\n        originalResult.value,\n        FidelityReasonCodes.INVALID_INPUT,\n        [],\n        null,\n        null,\n      );\n    }\n    return deepFreeze({\n      status: 'exact-original',\n      reasonCode: restored.reasonCode,\n      sourceSha256: protection.sourceSha256,\n      projectionSha256: null,\n      projectionByteLength: protection.exactOriginal.byteLength,\n      projectionText: null,\n      validationProfileVersion: 'fidelity/1.0.0',\n      exactOriginal: protection.exactOriginal,\n      checks: restored.checks,\n    });\n  }\n  checks.push(...restored.checks);\n\n  let sourceText: string;\n  try {\n    sourceText = new TextDecoder('utf-8', { fatal: true })\n      .decode(decodeExactOriginal(protection.exactOriginal));\n  } catch (error: unknown) {\n    return fallback(protection, FidelityReasonCodes.INVALID_ENCODING, checks, null, null);\n  }\n\n  if (restored.text !== sourceText) {\n    if (isUnexpectedRefusal(sourceText, restored.text)) {\n      return fallback(protection, FidelityReasonCodes.REFUSAL_OUTPUT, checks, 0, 1);\n    }\n    const minimumRatio = request.minimumContentRatio ?? DEFAULT_MINIMUM_CONTENT_RATIO;\n    const sourceContent = countContentCodepoints(sourceText);\n    const candidateContent = countContentCodepoints(restored.text);\n    if (sourceContent > 0 && candidateContent / sourceContent < minimumRatio) {\n      return fallback(\n        protection,\n        FidelityReasonCodes.TRUNCATED_OUTPUT,\n        checks,\n        Math.ceil(sourceContent * minimumRatio),\n        candidateContent,\n      );\n    }\n\n    const sourceStructure = createMarkdownStructureSignature(sourceText);\n    const candidateStructure = createMarkdownStructureSignature(restored.text);\n    if (sourceStructure !== candidateStructure) {\n      return fallback(\n        protection,\n        FidelityReasonCodes.MARKDOWN_STRUCTURE_CHANGED,\n        checks,\n        1,\n        0,\n      );\n    }\n\n    const semanticDifference = compareSemanticMeaning(sourceText, restored.text);\n    if (semanticDifference !== null) {\n      return fallback(\n        protection,\n        semanticDifference.reasonCode,\n        checks,\n        semanticDifference.expectedCount,\n        semanticDifference.actualCount,\n      );\n    }\n  }\n  checks.push(passed(FidelityReasonCodes.MARKDOWN_STRUCTURE_CHANGED));\n  checks.push(passed(FidelityReasonCodes.FACT_ADDED));\n  checks.push(passed(FidelityReasonCodes.POLARITY_CHANGED));\n  checks.push(passed(FidelityReasonCodes.REQUIREMENT_STRENGTH_CHANGED));\n  checks.push(passed(FidelityReasonCodes.PRIORITY_CHANGED));\n\n  if (request.judgeMode === 'required') {\n    if (judge === undefined) {\n      return fallback(protection, FidelityReasonCodes.JUDGE_UNAVAILABLE, checks, 1, 0);\n    }\n    const judgeResult = await runJudge(\n      judge,\n      sourceText,\n      restored.text,\n      request.judgeTimeoutMs ?? DEFAULT_JUDGE_TIMEOUT_MS,\n      request.signal,\n    );\n    if (judgeResult !== 'accept') {\n      return fallback(protection, judgeReason(judgeResult), checks, 1, 0);\n    }\n    checks.push(passed(FidelityReasonCodes.JUDGE_REJECTED));\n  }\n\n  const projectionBytes = new TextEncoder().encode(restored.text);\n  checks.push(passed(FidelityReasonCodes.ACCEPTED));\n  return deepFreeze({\n    status: 'accepted',\n    reasonCode: FidelityReasonCodes.ACCEPTED,\n    sourceSha256: protection.sourceSha256,\n    projectionSha256: createSha256Digest(projectionBytes),\n    projectionByteLength: projectionBytes.byteLength,\n    projectionText: restored.text,\n    validationProfileVersion: 'fidelity/1.0.0',\n    exactOriginal: protection.exactOriginal,\n    checks,\n  });\n}\n\nfunction validateInput(input: Record<string, unknown>): ValidationIssue[] {\n  const issues: ValidationIssue[] = [];\n  for (const key of Object.keys(input)) {\n    if (!(INPUT_KEYS as readonly string[]).includes(key)) {\n      issues.push(issue(`$.${key}`, 'unknown_key', 'Field is not permitted at this boundary.'));\n    }\n  }\n  if (typeof input.candidateText !== 'string') {\n    issues.push(issue('$.candidateText', 'type', 'Candidate text must be a string.'));\n  }\n  if (\n    typeof input.providerTerminal !== 'string'\n    || !PROVIDER_TERMINALS.includes(input.providerTerminal as ProviderTerminalState)\n  ) {\n    issues.push(issue('$.providerTerminal', 'enum', 'Provider terminal state is invalid.'));\n  }\n  if (typeof input.allPartsComplete !== 'boolean') {\n    issues.push(issue('$.allPartsComplete', 'type', 'Part completeness must be boolean.'));\n  }\n  if (\n    typeof input.currentSourceSha256 !== 'string'\n    || !SHA256_PATTERN.test(input.currentSourceSha256)\n  ) {\n    issues.push(issue('$.currentSourceSha256', 'digest', 'Current source digest is invalid.'));\n  }\n  if (input.judgeMode !== 'disabled' && input.judgeMode !== 'required') {\n    issues.push(issue('$.judgeMode', 'enum', 'Judge mode is invalid.'));\n  }\n  validateOptionalInteger(input.maximumOutputBytes, '$.maximumOutputBytes', 1, MAX_OUTPUT_BYTES, issues);\n  validateOptionalNumber(input.minimumContentRatio, '$.minimumContentRatio', 0.01, 1, issues);\n  validateOptionalInteger(input.judgeTimeoutMs, '$.judgeTimeoutMs', 1, 120_000, issues);\n  if (input.signal !== undefined && !isAbortSignal(input.signal)) {\n    issues.push(issue('$.signal', 'type', 'Signal must implement the AbortSignal contract.'));\n  }\n  return issues;\n}\n\nfunction providerFailureReason(\n  terminal: ProviderTerminalState,\n): Exclude<FidelityReasonCode, 'accepted'> | null {\n  switch (terminal) {\n    case 'success':\n      return null;\n    case 'error':\n      return FidelityReasonCodes.PROVIDER_ERROR;\n    case 'cancelled':\n      return FidelityReasonCodes.PROVIDER_CANCELLED;\n    case 'timeout':\n      return FidelityReasonCodes.PROVIDER_TIMEOUT;\n    case 'truncated':\n      return FidelityReasonCodes.TRUNCATED_OUTPUT;\n  }\n}\n\ntype JudgeRunResult = 'accept' | 'cancelled' | 'failed' | 'reject' | 'timeout';\n\nasync function runJudge(\n  judge: RejectOnlyJudge,\n  sourceText: string,\n  candidateText: string,\n  timeoutMs: number,\n  externalSignal?: AbortSignal,\n): Promise<JudgeRunResult> {\n  const controller = new AbortController();\n  let timer: ReturnType<typeof setTimeout> | undefined;\n  let removeAbortListener: (() => void) | undefined;\n  const judgePromise = Promise.resolve()\n    .then(() => judge({ sourceText, candidateText, signal: controller.signal }))\n    .then((result): JudgeRunResult => result === 'accept' || result === 'reject' ? result : 'failed')\n    .catch((): JudgeRunResult => 'failed');\n  const timeoutPromise = new Promise<JudgeRunResult>((resolve) => {\n    timer = setTimeout(() => {\n      controller.abort();\n      resolve('timeout');\n    }, timeoutMs);\n  });\n  const cancellationPromise = new Promise<JudgeRunResult>((resolve) => {\n    if (externalSignal === undefined) {\n      return;\n    }\n    const onAbort = (): void => {\n      controller.abort();\n      resolve('cancelled');\n    };\n    externalSignal.addEventListener('abort', onAbort, { once: true });\n    removeAbortListener = () => externalSignal.removeEventListener('abort', onAbort);\n  });\n\n  try {\n    return await Promise.race([judgePromise, timeoutPromise, cancellationPromise]);\n  } finally {\n    if (timer !== undefined) {\n      clearTimeout(timer);\n    }\n    removeAbortListener?.();\n  }\n}\n\nfunction judgeReason(result: Exclude<JudgeRunResult, 'accept'>): Exclude<FidelityReasonCode, 'accepted'> {\n  switch (result) {\n    case 'reject':\n      return FidelityReasonCodes.JUDGE_REJECTED;\n    case 'timeout':\n      return FidelityReasonCodes.JUDGE_TIMEOUT;\n    case 'cancelled':\n      return FidelityReasonCodes.CANCELLED;\n    case 'failed':\n      return FidelityReasonCodes.JUDGE_FAILED;\n  }\n}\n\nfunction fallback(\n  protection: ProtectedDocument,\n  reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n  checks: readonly FidelityCheck[],\n  expectedCount: number | null,\n  actualCount: number | null,\n): FidelityOutcome {\n  return fallbackFromExactOriginal(\n    protection.exactOriginal,\n    reasonCode,\n    checks,\n    expectedCount,\n    actualCount,\n  );\n}\n\nfunction fallbackFromExactOriginal(\n  exactOriginal: ExactOriginalRecord,\n  reasonCode: Exclude<FidelityReasonCode, 'accepted'>,\n  checks: readonly FidelityCheck[],\n  expectedCount: number | null,\n  actualCount: number | null,\n): FidelityOutcome {\n  const safeExactOriginal = freezeExactOriginal(exactOriginal);\n  return deepFreeze({\n    status: 'exact-original',\n    reasonCode,\n    sourceSha256: safeExactOriginal.sha256,\n    projectionSha256: null,\n    projectionByteLength: safeExactOriginal.byteLength,\n    projectionText: null,\n    validationProfileVersion: 'fidelity/1.0.0',\n    exactOriginal: safeExactOriginal,\n    checks: [...checks, {\n      ruleId: reasonCode,\n      status: 'failed',\n      expectedCount,\n      actualCount,\n    }],\n  });\n}\n\nfunction passed(ruleId: FidelityReasonCode): FidelityCheck {\n  return Object.freeze({\n    ruleId,\n    status: 'passed',\n    expectedCount: null,\n    actualCount: null,\n  });\n}\n\nfunction rejectedInput(issues: readonly ValidationIssue[]): FidelityInputRejection {\n  return deepFreeze({ status: 'rejected', reasonCode: 'invalid-input', issues: [...issues] });\n}\n\nfunction validateOptionalInteger(\n  value: unknown,\n  path: string,\n  minimum: number,\n  maximum: number,\n  issues: ValidationIssue[],\n): void {\n  if (\n    value !== undefined\n    && (typeof value !== 'number'\n      || !Number.isInteger(value)\n      || value < minimum\n      || value > maximum)\n  ) {\n    issues.push(issue(path, 'range', 'Expected a bounded integer.'));\n  }\n}\n\nfunction validateOptionalNumber(\n  value: unknown,\n  path: string,\n  minimum: number,\n  maximum: number,\n  issues: ValidationIssue[],\n): void {\n  if (\n    value !== undefined\n    && (typeof value !== 'number'\n      || !Number.isFinite(value)\n      || value < minimum\n      || value > maximum)\n  ) {\n    issues.push(issue(path, 'range', 'Expected a bounded finite number.'));\n  }\n}\n\nfunction isAbortSignal(value: unknown): value is AbortSignal {\n  return isRecord(value)\n    && typeof value.aborted === 'boolean'\n    && typeof value.addEventListener === 'function'\n    && typeof value.removeEventListener === 'function';\n}\n\nfunction issue(path: string, code: string, message: string): ValidationIssue {\n  return Object.freeze({ path, code, message });\n}\n\nfunction prefixIssues(\n  path: string,\n  issues: readonly ValidationIssue[],\n): ValidationIssue[] {\n  return issues.map((entry) => ({\n    ...entry,\n    path: `${path}${entry.path === '$' ? '' : entry.path.slice(1)}`,\n  }));\n}","lineStart":1,"lineEnd":482,"totalLines":482,"truncated":false}},"title":"packages/cli-communication-projection/src/fidelity/validator.ts","time":{"start":1786568950072,"end":1786568950080}},"id":"prt_ff7cebf60001XDb1pRAchupiho","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ceaa57001pU9tt1yysZXnJb"}}
{"type":"tool_use","timestamp":1786568950549,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_KQ0AuLjPnhbNXIJ3nbxS2708","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/semantics.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/semantics.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deterministic Semantic Vetoes\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { FidelityReasonCodes } from './types.js';\n6: \n7: import type { FidelityReasonCode } from './types.js';\n8: \n9: /** Content-free semantic mismatch evidence. */\n10: export interface SemanticDifference {\n11:   readonly reasonCode: Exclude<FidelityReasonCode, 'accepted'>;\n12:   readonly expectedCount: number;\n13:   readonly actualCount: number;\n14: }\n15: \n16: interface SemanticSignature {\n17:   readonly facts: ReadonlyMap<string, number>;\n18:   readonly polarity: ReadonlyMap<string, number>;\n19:   readonly requirementStrength: ReadonlyMap<string, number>;\n20:   readonly priority: ReadonlyMap<string, number>;\n21:   readonly uncertainty: ReadonlyMap<string, number>;\n22:   readonly caveats: ReadonlyMap<string, number>;\n23:   readonly directives: ReadonlyMap<string, number>;\n24: }\n25: \n26: const COMMON_CAPITALIZED_WORDS = new Set([\n27:   'a',\n28:   'after',\n29:   'an',\n30:   'and',\n31:   'as',\n32:   'at',\n33:   'before',\n34:   'but',\n35:   'do',\n36:   'for',\n37:   'from',\n38:   'however',\n39:   'if',\n40:   'in',\n41:   'it',\n42:   'keep',\n43:   'next',\n44:   'no',\n45:   'not',\n46:   'on',\n47:   'or',\n48:   'run',\n49:   'set',\n50:   'that',\n51:   'the',\n52:   'then',\n53:   'there',\n54:   'this',\n55:   'to',\n56:   'use',\n57:   'when',\n58:   'with',\n59: ]);\n60: \n61: /** Return the first deterministic semantic veto in fixed rule order. */\n62: export function compareSemanticMeaning(\n63:   sourceText: string,\n64:   candidateText: string,\n65: ): SemanticDifference | null {\n66:   const source = createSemanticSignature(sourceText);\n67:   const candidate = createSemanticSignature(candidateText);\n68: \n69:   const addedFacts = countMapDifference(candidate.facts, source.facts);\n70:   if (addedFacts > 0) {\n71:     return {\n72:       reasonCode: FidelityReasonCodes.FACT_ADDED,\n73:       expectedCount: totalCount(source.facts),\n74:       actualCount: totalCount(candidate.facts),\n75:     };\n76:   }\n77:   const omittedFacts = countMapDifference(source.facts, candidate.facts);\n78:   if (omittedFacts > 0) {\n79:     return {\n80:       reasonCode: FidelityReasonCodes.FACT_OMITTED,\n81:       expectedCount: totalCount(source.facts),\n82:       actualCount: totalCount(candidate.facts),\n83:     };\n84:   }\n85: \n86:   const checks = [\n87:     [source.polarity, candidate.polarity, FidelityReasonCodes.POLARITY_CHANGED],\n88:     [\n89:       source.requirementStrength,\n90:       candidate.requirementStrength,\n91:       FidelityReasonCodes.REQUIREMENT_STRENGTH_CHANGED,\n92:     ],\n93:     [source.priority, candidate.priority, FidelityReasonCodes.PRIORITY_CHANGED],\n94:     [source.uncertainty, candidate.uncertainty, FidelityReasonCodes.UNCERTAINTY_CHANGED],\n95:     [source.caveats, candidate.caveats, FidelityReasonCodes.CAVEAT_CHANGED],\n96:     [source.directives, candidate.directives, FidelityReasonCodes.NEXT_STEP_CHANGED],\n97:   ] as const;\n98:   for (const [expected, actual, reasonCode] of checks) {\n99:     if (!mapsEqual(expected, actual)) {\n100:       return {\n101:         reasonCode,\n102:         expectedCount: totalCount(expected),\n103:         actualCount: totalCount(actual),\n104:       };\n105:     }\n106:   }\n107:   return null;\n108: }\n109: \n110: /** Detect provider refusals that replace a non-refusal source. */\n111: export function isUnexpectedRefusal(sourceText: string, candidateText: string): boolean {\n112:   const refusal = /(?:^|\\n)\\s*(?:sorry\\b|i\\s+(?:cannot|can't|won't|am unable to)\\b|as an ai\\b|i must decline\\b|i am not able to\\b)/iu;\n113:   return refusal.test(candidateText) && !refusal.test(sourceText);\n114: }\n115: \n116: /** Count non-whitespace codepoints for bounded truncation checks. */\n117: export function countContentCodepoints(value: string): number {\n118:   return [...value.replace(/\\s/gu, '')].length;\n119: }\n120: \n121: function createSemanticSignature(value: string): SemanticSignature {\n122:   return {\n123:     facts: createFactMap(value),\n124:     polarity: createCategoryMap(value, {\n125:       negative: /\\b(?:no|not|never|neither|nor|without|unchanged|disabled|failed|fails|cannot|can't|won't)\\b/giu,\n126:       prohibition: /\\b(?:must\\s+not|do\\s+not|never|cannot|can't|prohibited|forbidden)\\b/giu,\n127:     }),\n128:     requirementStrength: createCategoryMap(value, {\n129:       strong: /\\b(?:must|shall|required|requires|need\\s+to|needs\\s+to|has\\s+to|have\\s+to|cannot|never|prohibited|forbidden)\\b/giu,\n130:       medium: /\\b(?:should|recommended|ought\\s+to|expected\\s+to)\\b/giu,\n131:       weak: /\\b(?:may|might|can|could|optional|optionally)\\b/giu,\n132:     }),\n133:     priority: createCategoryMap(value, {\n134:       critical: /\\b(?:critical|highest|urgent)\\b/giu,\n135:       high: /\\bhigh(?:est)?(?:[ -]priority)?\\b/giu,\n136:       medium: /\\bmedium(?:[ -]priority)?\\b/giu,\n137:       low: /\\blow(?:est)?(?:[ -]priority)?\\b/giu,\n138:     }),\n139:     uncertainty: createCategoryMap(value, {\n140:       uncertainty: /\\b(?:approximately|about|estimated|inferred|may|might|could|possibly|perhaps|uncertain|unknown|unverified|provisional)\\b/giu,\n141:     }),\n142:     caveats: createCategoryMap(value, {\n143:       caveat: /\\b(?:although|but|except|however|only\\s+if|provided\\s+that|subject\\s+to|unless|warning|limitation|yet)\\b/giu,\n144:     }),\n145:     directives: createDirectiveMap(value),\n146:   };\n147: }\n148: \n149: function createFactMap(value: string): ReadonlyMap<string, number> {\n150:   const facts = new Map<string, number>();\n151:   for (const match of value.matchAll(/\\b\\d+(?:[.,]\\d+)*(?:\\s?(?:%|ms|s|min|h|B|KB|MB|GB|KiB|MiB|GiB|px|rem|em|Hz|kHz|MHz|GHz))?\\b/gu)) {\n152:     increment(facts, `number:${match[0].toLowerCase()}`);\n153:   }\n154:   for (const match of value.matchAll(/\\b\\p{Lu}[\\p{L}\\p{N}-]{2,}\\b/gu)) {\n155:     const word = match[0];\n156:     if (!COMMON_CAPITALIZED_WORDS.has(word.toLowerCase())) {\n157:       increment(facts, `entity:${word}`);\n158:     }\n159:   }\n160:   return facts;\n161: }\n162: \n163: function createDirectiveMap(value: string): ReadonlyMap<string, number> {\n164:   const hasDirectiveContext = /\\b(?:after|before|finally|first|next|then)\\b|(?:^|\\n)\\s*(?:[-+*]|\\d+[.)])\\s+/iu.test(value);\n165:   if (!hasDirectiveContext) {\n166:     return new Map();\n167:   }\n168:   return createCategoryMap(value, {\n169:     build: /\\b(?:build|create|generate)\\b/giu,\n170:     continue: /\\b(?:continue|proceed|resume)\\b/giu,\n171:     inspect: /\\b(?:check|inspect|review|verify)\\b/giu,\n172:     preserve: /\\b(?:keep|preserve|retain)\\b/giu,\n173:     remove: /\\b(?:delete|remove)\\b/giu,\n174:     restart: /\\b(?:restart|relaunch)\\b/giu,\n175:     run: /\\b(?:execute|run)\\b/giu,\n176:     update: /\\b(?:change|edit|update)\\b/giu,\n177:     use: /\\b(?:apply|use)\\b/giu,\n178:   });\n179: }\n180: \n181: function createCategoryMap(\n182:   value: string,\n183:   patterns: Readonly<Record<string, RegExp>>,\n184: ): ReadonlyMap<string, number> {\n185:   const result = new Map<string, number>();\n186:   for (const [category, pattern] of Object.entries(patterns)) {\n187:     const count = [...value.matchAll(pattern)].length;\n188:     if (count > 0) {\n189:       result.set(category, count);\n190:     }\n191:   }\n192:   return result;\n193: }\n194: \n195: function increment(map: Map<string, number>, key: string): void {\n196:   map.set(key, (map.get(key) ?? 0) + 1);\n197: }\n198: \n199: function mapsEqual(\n200:   left: ReadonlyMap<string, number>,\n201:   right: ReadonlyMap<string, number>,\n202: ): boolean {\n203:   return left.size === right.size\n204:     && [...left].every(([key, value]) => right.get(key) === value);\n205: }\n206: \n207: function countMapDifference(\n208:   left: ReadonlyMap<string, number>,\n209:   right: ReadonlyMap<string, number>,\n210: ): number {\n211:   let difference = 0;\n212:   for (const [key, count] of left) {\n213:     difference += Math.max(0, count - (right.get(key) ?? 0));\n214:   }\n215:   return difference;\n216: }\n217: \n218: function totalCount(map: ReadonlyMap<string, number>): number {\n219:   return [...map.values()].reduce((total, count) => total + count, 0);\n220: }\n\n(End of file - total 220 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deterministic Semantic Vetoes\n// ───────────────────────────────────────────────────────────────────\n\nimport { FidelityReasonCodes } from './types.js';\n\nimport type { FidelityReasonCode } from './types.js';\n\n/** Content-free semantic mismatch evidence. */\nexport interface SemanticDifference {\n  readonly reasonCode: Exclude<FidelityReasonCode, 'accepted'>;\n  readonly expectedCount: number;\n  readonly actualCount: number;\n}\n\ninterface SemanticSignature {\n  readonly facts: ReadonlyMap<string, number>;\n  readonly polarity: ReadonlyMap<string, number>;\n  readonly requirementStrength: ReadonlyMap<string, number>;\n  readonly priority: ReadonlyMap<string, number>;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/fidelity/semantics.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deterministic Semantic Vetoes\n// ───────────────────────────────────────────────────────────────────\n\nimport { FidelityReasonCodes } from './types.js';\n\nimport type { FidelityReasonCode } from './types.js';\n\n/** Content-free semantic mismatch evidence. */\nexport interface SemanticDifference {\n  readonly reasonCode: Exclude<FidelityReasonCode, 'accepted'>;\n  readonly expectedCount: number;\n  readonly actualCount: number;\n}\n\ninterface SemanticSignature {\n  readonly facts: ReadonlyMap<string, number>;\n  readonly polarity: ReadonlyMap<string, number>;\n  readonly requirementStrength: ReadonlyMap<string, number>;\n  readonly priority: ReadonlyMap<string, number>;\n  readonly uncertainty: ReadonlyMap<string, number>;\n  readonly caveats: ReadonlyMap<string, number>;\n  readonly directives: ReadonlyMap<string, number>;\n}\n\nconst COMMON_CAPITALIZED_WORDS = new Set([\n  'a',\n  'after',\n  'an',\n  'and',\n  'as',\n  'at',\n  'before',\n  'but',\n  'do',\n  'for',\n  'from',\n  'however',\n  'if',\n  'in',\n  'it',\n  'keep',\n  'next',\n  'no',\n  'not',\n  'on',\n  'or',\n  'run',\n  'set',\n  'that',\n  'the',\n  'then',\n  'there',\n  'this',\n  'to',\n  'use',\n  'when',\n  'with',\n]);\n\n/** Return the first deterministic semantic veto in fixed rule order. */\nexport function compareSemanticMeaning(\n  sourceText: string,\n  candidateText: string,\n): SemanticDifference | null {\n  const source = createSemanticSignature(sourceText);\n  const candidate = createSemanticSignature(candidateText);\n\n  const addedFacts = countMapDifference(candidate.facts, source.facts);\n  if (addedFacts > 0) {\n    return {\n      reasonCode: FidelityReasonCodes.FACT_ADDED,\n      expectedCount: totalCount(source.facts),\n      actualCount: totalCount(candidate.facts),\n    };\n  }\n  const omittedFacts = countMapDifference(source.facts, candidate.facts);\n  if (omittedFacts > 0) {\n    return {\n      reasonCode: FidelityReasonCodes.FACT_OMITTED,\n      expectedCount: totalCount(source.facts),\n      actualCount: totalCount(candidate.facts),\n    };\n  }\n\n  const checks = [\n    [source.polarity, candidate.polarity, FidelityReasonCodes.POLARITY_CHANGED],\n    [\n      source.requirementStrength,\n      candidate.requirementStrength,\n      FidelityReasonCodes.REQUIREMENT_STRENGTH_CHANGED,\n    ],\n    [source.priority, candidate.priority, FidelityReasonCodes.PRIORITY_CHANGED],\n    [source.uncertainty, candidate.uncertainty, FidelityReasonCodes.UNCERTAINTY_CHANGED],\n    [source.caveats, candidate.caveats, FidelityReasonCodes.CAVEAT_CHANGED],\n    [source.directives, candidate.directives, FidelityReasonCodes.NEXT_STEP_CHANGED],\n  ] as const;\n  for (const [expected, actual, reasonCode] of checks) {\n    if (!mapsEqual(expected, actual)) {\n      return {\n        reasonCode,\n        expectedCount: totalCount(expected),\n        actualCount: totalCount(actual),\n      };\n    }\n  }\n  return null;\n}\n\n/** Detect provider refusals that replace a non-refusal source. */\nexport function isUnexpectedRefusal(sourceText: string, candidateText: string): boolean {\n  const refusal = /(?:^|\\n)\\s*(?:sorry\\b|i\\s+(?:cannot|can't|won't|am unable to)\\b|as an ai\\b|i must decline\\b|i am not able to\\b)/iu;\n  return refusal.test(candidateText) && !refusal.test(sourceText);\n}\n\n/** Count non-whitespace codepoints for bounded truncation checks. */\nexport function countContentCodepoints(value: string): number {\n  return [...value.replace(/\\s/gu, '')].length;\n}\n\nfunction createSemanticSignature(value: string): SemanticSignature {\n  return {\n    facts: createFactMap(value),\n    polarity: createCategoryMap(value, {\n      negative: /\\b(?:no|not|never|neither|nor|without|unchanged|disabled|failed|fails|cannot|can't|won't)\\b/giu,\n      prohibition: /\\b(?:must\\s+not|do\\s+not|never|cannot|can't|prohibited|forbidden)\\b/giu,\n    }),\n    requirementStrength: createCategoryMap(value, {\n      strong: /\\b(?:must|shall|required|requires|need\\s+to|needs\\s+to|has\\s+to|have\\s+to|cannot|never|prohibited|forbidden)\\b/giu,\n      medium: /\\b(?:should|recommended|ought\\s+to|expected\\s+to)\\b/giu,\n      weak: /\\b(?:may|might|can|could|optional|optionally)\\b/giu,\n    }),\n    priority: createCategoryMap(value, {\n      critical: /\\b(?:critical|highest|urgent)\\b/giu,\n      high: /\\bhigh(?:est)?(?:[ -]priority)?\\b/giu,\n      medium: /\\bmedium(?:[ -]priority)?\\b/giu,\n      low: /\\blow(?:est)?(?:[ -]priority)?\\b/giu,\n    }),\n    uncertainty: createCategoryMap(value, {\n      uncertainty: /\\b(?:approximately|about|estimated|inferred|may|might|could|possibly|perhaps|uncertain|unknown|unverified|provisional)\\b/giu,\n    }),\n    caveats: createCategoryMap(value, {\n      caveat: /\\b(?:although|but|except|however|only\\s+if|provided\\s+that|subject\\s+to|unless|warning|limitation|yet)\\b/giu,\n    }),\n    directives: createDirectiveMap(value),\n  };\n}\n\nfunction createFactMap(value: string): ReadonlyMap<string, number> {\n  const facts = new Map<string, number>();\n  for (const match of value.matchAll(/\\b\\d+(?:[.,]\\d+)*(?:\\s?(?:%|ms|s|min|h|B|KB|MB|GB|KiB|MiB|GiB|px|rem|em|Hz|kHz|MHz|GHz))?\\b/gu)) {\n    increment(facts, `number:${match[0].toLowerCase()}`);\n  }\n  for (const match of value.matchAll(/\\b\\p{Lu}[\\p{L}\\p{N}-]{2,}\\b/gu)) {\n    const word = match[0];\n    if (!COMMON_CAPITALIZED_WORDS.has(word.toLowerCase())) {\n      increment(facts, `entity:${word}`);\n    }\n  }\n  return facts;\n}\n\nfunction createDirectiveMap(value: string): ReadonlyMap<string, number> {\n  const hasDirectiveContext = /\\b(?:after|before|finally|first|next|then)\\b|(?:^|\\n)\\s*(?:[-+*]|\\d+[.)])\\s+/iu.test(value);\n  if (!hasDirectiveContext) {\n    return new Map();\n  }\n  return createCategoryMap(value, {\n    build: /\\b(?:build|create|generate)\\b/giu,\n    continue: /\\b(?:continue|proceed|resume)\\b/giu,\n    inspect: /\\b(?:check|inspect|review|verify)\\b/giu,\n    preserve: /\\b(?:keep|preserve|retain)\\b/giu,\n    remove: /\\b(?:delete|remove)\\b/giu,\n    restart: /\\b(?:restart|relaunch)\\b/giu,\n    run: /\\b(?:execute|run)\\b/giu,\n    update: /\\b(?:change|edit|update)\\b/giu,\n    use: /\\b(?:apply|use)\\b/giu,\n  });\n}\n\nfunction createCategoryMap(\n  value: string,\n  patterns: Readonly<Record<string, RegExp>>,\n): ReadonlyMap<string, number> {\n  const result = new Map<string, number>();\n  for (const [category, pattern] of Object.entries(patterns)) {\n    const count = [...value.matchAll(pattern)].length;\n    if (count > 0) {\n      result.set(category, count);\n    }\n  }\n  return result;\n}\n\nfunction increment(map: Map<string, number>, key: string): void {\n  map.set(key, (map.get(key) ?? 0) + 1);\n}\n\nfunction mapsEqual(\n  left: ReadonlyMap<string, number>,\n  right: ReadonlyMap<string, number>,\n): boolean {\n  return left.size === right.size\n    && [...left].every(([key, value]) => right.get(key) === value);\n}\n\nfunction countMapDifference(\n  left: ReadonlyMap<string, number>,\n  right: ReadonlyMap<string, number>,\n): number {\n  let difference = 0;\n  for (const [key, count] of left) {\n    difference += Math.max(0, count - (right.get(key) ?? 0));\n  }\n  return difference;\n}\n\nfunction totalCount(map: ReadonlyMap<string, number>): number {\n  return [...map.values()].reduce((total, count) => total + count, 0);\n}","lineStart":1,"lineEnd":220,"totalLines":220,"truncated":false}},"title":"packages/cli-communication-projection/src/fidelity/semantics.ts","time":{"start":1786568950544,"end":1786568950548}},"id":"prt_ff7cec183001TZMGkjdpR0Z2P1","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ceaa57001pU9tt1yysZXnJb"}}
{"type":"tool_use","timestamp":1786568951030,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_02_GGun9KcZ5wpmekzoJ1b75371","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/executor.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/executor.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Bounded Provider Execution\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { PrivacyClasses } from '../contracts/context.js';\n6: import { freezeExactOriginal, deepFreeze } from '../fidelity/freeze.js';\n7: import { getProviderAdapter } from './adapters.js';\n8: import { ProviderExecutionReasonCodes } from './types.js';\n9: import { selectPrivacyRoute } from '../privacy/router.js';\n10: \n11: import type { PromptProfileRecord } from '../contracts/prompt.js';\n12: import type { ProtectedDocument, ProviderTerminalState } from '../fidelity/types.js';\n13: import type { PrivacyRoute } from '../privacy/types.js';\n14: import type {\n15:   ProviderCredentialStatus,\n16:   ProviderExecutionReasonCode,\n17:   ProviderExecutionResult,\n18:   ProviderModelRecord,\n19:   ProviderTransport,\n20: } from './types.js';\n21: \n22: /** Dependencies for one privacy-approved, bounded provider execution. */\n23: export interface ExecuteProviderRouteInput {\n24:   readonly route: PrivacyRoute;\n25:   readonly prompt: PromptProfileRecord;\n26:   readonly document: ProtectedDocument;\n27:   readonly transport: ProviderTransport;\n28:   readonly credentialStatus: ProviderCredentialStatus;\n29:   readonly now: string;\n30:   readonly signal?: AbortSignal;\n31:   readonly nowMs?: () => number;\n32: }\n33: \n34: interface AttemptCandidate {\n35:   readonly status: 'candidate';\n36:   readonly text: string;\n37:   readonly inputByteCount: number;\n38:   readonly outputByteCount: number;\n39: }\n40: \n41: interface AttemptFailure {\n42:   readonly status: 'failure';\n43:   readonly reasonCode: Exclude<ProviderExecutionReasonCode, 'none' | 'privacy-denied'>;\n44:   readonly terminal: Exclude<ProviderTerminalState, 'success'>;\n45:   readonly inputByteCount: number;\n46: }\n47: \n48: type AttemptResult = AttemptCandidate | AttemptFailure;\n49: \n50: /** Execute only the attempts approved by the transport-free privacy router. */\n51: export async function executeProviderRoute(\n52:   input: ExecuteProviderRouteInput,\n53: ): Promise<ProviderExecutionResult> {\n54:   const clock = input.nowMs ?? (() => performance.now());\n55:   const startedAt = clock();\n56:   const exactOriginal = freezeExactOriginal(input.document.exactOriginal);\n57:   if (input.route.status === 'denied') {\n58:     return exactResult({\n59:       record: null,\n60:       exactOriginal,\n61:       privacyClass: input.route.evaluations[0]?.privacyClass ?? PrivacyClasses.UNKNOWN,\n62:       attemptCount: 0,\n63:       inputByteCount: 0,\n64:       durationMs: elapsed(clock, startedAt),\n65:       reasonCode: ProviderExecutionReasonCodes.PRIVACY_DENIED,\n66:       terminal: 'error',\n67:     });\n68:   }\n69:   const verifiedRoute = selectPrivacyRoute({\n70:     records: input.route.attempts,\n71:     candidateProviderIds: [input.route.primary.provider.providerId],\n72:     policy: input.route.policy,\n73:     now: input.now,\n74:   });\n75:   if (\n76:     verifiedRoute.status === 'denied'\n77:     || !sameAttemptPlan(input.route.attempts, verifiedRoute.attempts)\n78:   ) {\n79:     return exactResult({\n80:       record: null,\n81:       exactOriginal,\n82:       privacyClass: input.route.primary.provider.privacyClass,\n83:       attemptCount: 0,\n84:       inputByteCount: 0,\n85:       durationMs: elapsed(clock, startedAt),\n86:       reasonCode: ProviderExecutionReasonCodes.PRIVACY_DENIED,\n87:       terminal: 'error',\n88:     });\n89:   }\n90:   if (input.signal?.aborted === true) {\n91:     return exactResult({\n92:       record: verifiedRoute.primary,\n93:       exactOriginal,\n94:       attemptCount: 0,\n95:       inputByteCount: 0,\n96:       durationMs: elapsed(clock, startedAt),\n97:       reasonCode: ProviderExecutionReasonCodes.CANCELLED,\n98:       terminal: 'cancelled',\n99:     });\n100:   }\n101: \n102:   let attemptCount = 0;\n103:   let lastRecord: ProviderModelRecord = verifiedRoute.primary;\n104:   let lastFailure: AttemptFailure = {\n105:     status: 'failure',\n106:     reasonCode: ProviderExecutionReasonCodes.INVALID_PROVIDER,\n107:     terminal: 'error',\n108:     inputByteCount: 0,\n109:   };\n110:   for (const record of verifiedRoute.attempts) {\n111:     attemptCount += 1;\n112:     lastRecord = record;\n113:     const result = await runAttempt(input, record);\n114:     if (result.status === 'candidate') {\n115:       return deepFreeze({\n116:         status: 'candidate',\n117:         reasonCode: ProviderExecutionReasonCodes.NONE,\n118:         providerTerminal: 'success',\n119:         providerId: record.provider.providerId,\n120:         modelId: record.provider.modelId,\n121:         privacyClass: record.provider.privacyClass,\n122:         exactOriginal,\n123:         attemptCount,\n124:         inputByteCount: result.inputByteCount,\n125:         outputByteCount: result.outputByteCount,\n126:         durationMs: elapsed(clock, startedAt),\n127:         candidateText: result.text,\n128:       });\n129:     }\n130:     lastFailure = result;\n131:     if (\n132:       result.reasonCode === ProviderExecutionReasonCodes.CANCELLED\n133:       || (result.reasonCode === ProviderExecutionReasonCodes.UNSUPPORTED_CONTROL\n134:         && input.prompt.unsupportedControlBehavior === 'exact-original')\n135:     ) {\n136:       break;\n137:     }\n138:   }\n139:   return exactResult({\n140:     record: lastRecord,\n141:     exactOriginal,\n142:     attemptCount,\n143:     inputByteCount: lastFailure.inputByteCount,\n144:     durationMs: elapsed(clock, startedAt),\n145:     reasonCode: lastFailure.reasonCode,\n146:     terminal: lastFailure.terminal,\n147:   });\n148: }\n149: \n150: async function runAttempt(\n151:   input: ExecuteProviderRouteInput,\n152:   record: ProviderModelRecord,\n153: ): Promise<AttemptResult> {\n154:   const controller = new AbortController();\n155:   let timedOut = false;\n156:   const abortFromCaller = (): void => controller.abort();\n157:   if (input.signal?.aborted === true) {\n158:     controller.abort();\n159:   } else {\n160:     input.signal?.addEventListener('abort', abortFromCaller, { once: true });\n161:   }\n162:   const timeout = setTimeout(() => {\n163:     timedOut = true;\n164:     controller.abort();\n165:   }, record.timeoutMs);\n166: \n167:   const adapter = getProviderAdapter(record.family);\n168:   const prepared = adapter.prepare({\n169:     record,\n170:     prompt: input.prompt,\n171:     document: input.document,\n172:     now: input.now,\n173:     signal: controller.signal,\n174:   });\n175:   if (prepared.status === 'unsupported') {\n176:     clearTimeout(timeout);\n177:     input.signal?.removeEventListener('abort', abortFromCaller);\n178:     return failure(\n179:       prepared.reasonCode === 'unsupported-control'\n180:         ? ProviderExecutionReasonCodes.UNSUPPORTED_CONTROL\n181:         : ProviderExecutionReasonCodes.INVALID_PROVIDER,\n182:       'error',\n183:       0,\n184:     );\n185:   }\n186: \n187:   const aborted = new Promise<AttemptFailure>((resolve) => {\n188:     controller.signal.addEventListener('abort', () => {\n189:       resolve(failure(\n190:         timedOut\n191:           ? ProviderExecutionReasonCodes.TIMEOUT\n192:           : ProviderExecutionReasonCodes.CANCELLED,\n193:         timedOut ? 'timeout' : 'cancelled',\n194:         0,\n195:       ));\n196:     }, { once: true });\n197:   });\n198:   const operation = performTransport(input, record, prepared.request, adapter.parse);\n199:   try {\n200:     return await Promise.race([operation, aborted]);\n201:   } finally {\n202:     clearTimeout(timeout);\n203:     input.signal?.removeEventListener('abort', abortFromCaller);\n204:   }\n205: }\n206: \n207: async function performTransport(\n208:   input: ExecuteProviderRouteInput,\n209:   record: ProviderModelRecord,\n210:   request: Parameters<ProviderTransport>[0],\n211:   parse: ReturnType<typeof getProviderAdapter>['parse'],\n212: ): Promise<AttemptResult> {\n213:   try {\n214:     if (record.authorizationScheme === 'bearer') {\n215:       const status = await input.credentialStatus(\n216:         record.provider.credentialReference,\n217:         request.signal,\n218:       );\n219:       if (status !== 'available') {\n220:         return failure(\n221:           status === 'expired'\n222:             ? ProviderExecutionReasonCodes.EXPIRED_CREDENTIAL\n223:             : ProviderExecutionReasonCodes.MISSING_CREDENTIAL,\n224:           'error',\n225:           0,\n226:         );\n227:       }\n228:     }\n229:     if (request.signal.aborted) {\n230:       return failure(ProviderExecutionReasonCodes.CANCELLED, 'cancelled', 0);\n231:     }\n232:     const inputByteCount = new TextEncoder().encode(JSON.stringify(request.body)).byteLength;\n233:     const response = await input.transport(request);\n234:     if (request.signal.aborted) {\n235:       return failure(ProviderExecutionReasonCodes.CANCELLED, 'cancelled', inputByteCount);\n236:     }\n237:     const parsed = parse(response);\n238:     if (parsed.status === 'failure') {\n239:       return failure(parsed.reasonCode, parsed.terminal, inputByteCount);\n240:     }\n241:     return Object.freeze({\n242:       status: 'candidate',\n243:       text: parsed.text,\n244:       inputByteCount,\n245:       outputByteCount: parsed.outputByteCount,\n246:     });\n247:   } catch (error: unknown) {\n248:     return failure(\n249:       request.signal.aborted\n250:         ? ProviderExecutionReasonCodes.CANCELLED\n251:         : ProviderExecutionReasonCodes.PROVIDER_ERROR,\n252:       request.signal.aborted ? 'cancelled' : 'error',\n253:       0,\n254:     );\n255:   }\n256: }\n257: \n258: interface ExactResultInput {\n259:   readonly record: ProviderModelRecord | null;\n260:   readonly exactOriginal: ProviderExecutionResult['exactOriginal'];\n261:   readonly privacyClass?: ProviderExecutionResult['privacyClass'];\n262:   readonly attemptCount: number;\n263:   readonly inputByteCount: number;\n264:   readonly durationMs: number;\n265:   readonly reasonCode: Exclude<ProviderExecutionReasonCode, 'none'>;\n266:   readonly terminal: Exclude<ProviderTerminalState, 'success'>;\n267: }\n268: \n269: function exactResult(input: ExactResultInput): ProviderExecutionResult {\n270:   return deepFreeze({\n271:     status: 'exact-original',\n272:     reasonCode: input.reasonCode,\n273:     providerTerminal: input.terminal,\n274:     providerId: input.record?.provider.providerId ?? null,\n275:     modelId: input.record?.provider.modelId ?? null,\n276:     privacyClass: input.privacyClass\n277:       ?? input.record?.provider.privacyClass\n278:       ?? PrivacyClasses.UNKNOWN,\n279:     exactOriginal: input.exactOriginal,\n280:     attemptCount: input.attemptCount,\n281:     inputByteCount: input.inputByteCount,\n282:     outputByteCount: 0,\n283:     durationMs: input.durationMs,\n284:     candidateText: null,\n285:   });\n286: }\n287: \n288: function failure(\n289:   reasonCode: AttemptFailure['reasonCode'],\n290:   terminal: AttemptFailure['terminal'],\n291:   inputByteCount: number,\n292: ): AttemptFailure {\n293:   return Object.freeze({ status: 'failure', reasonCode, terminal, inputByteCount });\n294: }\n295: \n296: function elapsed(clock: () => number, startedAt: number): number {\n297:   return Math.max(0, Math.round(clock() - startedAt));\n298: }\n299: \n300: function sameAttemptPlan(\n301:   expected: readonly ProviderModelRecord[],\n302:   actual: readonly ProviderModelRecord[],\n303: ): boolean {\n304:   return expected.length === actual.length\n305:     && expected.every((record, index) =>\n306:       record.provider.providerId === actual[index]?.provider.providerId);\n307: }\n\n(End of file - total 307 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Bounded Provider Execution\n// ───────────────────────────────────────────────────────────────────\n\nimport { PrivacyClasses } from '../contracts/context.js';\nimport { freezeExactOriginal, deepFreeze } from '../fidelity/freeze.js';\nimport { getProviderAdapter } from './adapters.js';\nimport { ProviderExecutionReasonCodes } from './types.js';\nimport { selectPrivacyRoute } from '../privacy/router.js';\n\nimport type { PromptProfileRecord } from '../contracts/prompt.js';\nimport type { ProtectedDocument, ProviderTerminalState } from '../fidelity/types.js';\nimport type { PrivacyRoute } from '../privacy/types.js';\nimport type {\n  ProviderCredentialStatus,\n  ProviderExecutionReasonCode,\n  ProviderExecutionResult,\n  ProviderModelRecord,\n  ProviderTransport,\n} from './types.js';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/executor.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Bounded Provider Execution\n// ───────────────────────────────────────────────────────────────────\n\nimport { PrivacyClasses } from '../contracts/context.js';\nimport { freezeExactOriginal, deepFreeze } from '../fidelity/freeze.js';\nimport { getProviderAdapter } from './adapters.js';\nimport { ProviderExecutionReasonCodes } from './types.js';\nimport { selectPrivacyRoute } from '../privacy/router.js';\n\nimport type { PromptProfileRecord } from '../contracts/prompt.js';\nimport type { ProtectedDocument, ProviderTerminalState } from '../fidelity/types.js';\nimport type { PrivacyRoute } from '../privacy/types.js';\nimport type {\n  ProviderCredentialStatus,\n  ProviderExecutionReasonCode,\n  ProviderExecutionResult,\n  ProviderModelRecord,\n  ProviderTransport,\n} from './types.js';\n\n/** Dependencies for one privacy-approved, bounded provider execution. */\nexport interface ExecuteProviderRouteInput {\n  readonly route: PrivacyRoute;\n  readonly prompt: PromptProfileRecord;\n  readonly document: ProtectedDocument;\n  readonly transport: ProviderTransport;\n  readonly credentialStatus: ProviderCredentialStatus;\n  readonly now: string;\n  readonly signal?: AbortSignal;\n  readonly nowMs?: () => number;\n}\n\ninterface AttemptCandidate {\n  readonly status: 'candidate';\n  readonly text: string;\n  readonly inputByteCount: number;\n  readonly outputByteCount: number;\n}\n\ninterface AttemptFailure {\n  readonly status: 'failure';\n  readonly reasonCode: Exclude<ProviderExecutionReasonCode, 'none' | 'privacy-denied'>;\n  readonly terminal: Exclude<ProviderTerminalState, 'success'>;\n  readonly inputByteCount: number;\n}\n\ntype AttemptResult = AttemptCandidate | AttemptFailure;\n\n/** Execute only the attempts approved by the transport-free privacy router. */\nexport async function executeProviderRoute(\n  input: ExecuteProviderRouteInput,\n): Promise<ProviderExecutionResult> {\n  const clock = input.nowMs ?? (() => performance.now());\n  const startedAt = clock();\n  const exactOriginal = freezeExactOriginal(input.document.exactOriginal);\n  if (input.route.status === 'denied') {\n    return exactResult({\n      record: null,\n      exactOriginal,\n      privacyClass: input.route.evaluations[0]?.privacyClass ?? PrivacyClasses.UNKNOWN,\n      attemptCount: 0,\n      inputByteCount: 0,\n      durationMs: elapsed(clock, startedAt),\n      reasonCode: ProviderExecutionReasonCodes.PRIVACY_DENIED,\n      terminal: 'error',\n    });\n  }\n  const verifiedRoute = selectPrivacyRoute({\n    records: input.route.attempts,\n    candidateProviderIds: [input.route.primary.provider.providerId],\n    policy: input.route.policy,\n    now: input.now,\n  });\n  if (\n    verifiedRoute.status === 'denied'\n    || !sameAttemptPlan(input.route.attempts, verifiedRoute.attempts)\n  ) {\n    return exactResult({\n      record: null,\n      exactOriginal,\n      privacyClass: input.route.primary.provider.privacyClass,\n      attemptCount: 0,\n      inputByteCount: 0,\n      durationMs: elapsed(clock, startedAt),\n      reasonCode: ProviderExecutionReasonCodes.PRIVACY_DENIED,\n      terminal: 'error',\n    });\n  }\n  if (input.signal?.aborted === true) {\n    return exactResult({\n      record: verifiedRoute.primary,\n      exactOriginal,\n      attemptCount: 0,\n      inputByteCount: 0,\n      durationMs: elapsed(clock, startedAt),\n      reasonCode: ProviderExecutionReasonCodes.CANCELLED,\n      terminal: 'cancelled',\n    });\n  }\n\n  let attemptCount = 0;\n  let lastRecord: ProviderModelRecord = verifiedRoute.primary;\n  let lastFailure: AttemptFailure = {\n    status: 'failure',\n    reasonCode: ProviderExecutionReasonCodes.INVALID_PROVIDER,\n    terminal: 'error',\n    inputByteCount: 0,\n  };\n  for (const record of verifiedRoute.attempts) {\n    attemptCount += 1;\n    lastRecord = record;\n    const result = await runAttempt(input, record);\n    if (result.status === 'candidate') {\n      return deepFreeze({\n        status: 'candidate',\n        reasonCode: ProviderExecutionReasonCodes.NONE,\n        providerTerminal: 'success',\n        providerId: record.provider.providerId,\n        modelId: record.provider.modelId,\n        privacyClass: record.provider.privacyClass,\n        exactOriginal,\n        attemptCount,\n        inputByteCount: result.inputByteCount,\n        outputByteCount: result.outputByteCount,\n        durationMs: elapsed(clock, startedAt),\n        candidateText: result.text,\n      });\n    }\n    lastFailure = result;\n    if (\n      result.reasonCode === ProviderExecutionReasonCodes.CANCELLED\n      || (result.reasonCode === ProviderExecutionReasonCodes.UNSUPPORTED_CONTROL\n        && input.prompt.unsupportedControlBehavior === 'exact-original')\n    ) {\n      break;\n    }\n  }\n  return exactResult({\n    record: lastRecord,\n    exactOriginal,\n    attemptCount,\n    inputByteCount: lastFailure.inputByteCount,\n    durationMs: elapsed(clock, startedAt),\n    reasonCode: lastFailure.reasonCode,\n    terminal: lastFailure.terminal,\n  });\n}\n\nasync function runAttempt(\n  input: ExecuteProviderRouteInput,\n  record: ProviderModelRecord,\n): Promise<AttemptResult> {\n  const controller = new AbortController();\n  let timedOut = false;\n  const abortFromCaller = (): void => controller.abort();\n  if (input.signal?.aborted === true) {\n    controller.abort();\n  } else {\n    input.signal?.addEventListener('abort', abortFromCaller, { once: true });\n  }\n  const timeout = setTimeout(() => {\n    timedOut = true;\n    controller.abort();\n  }, record.timeoutMs);\n\n  const adapter = getProviderAdapter(record.family);\n  const prepared = adapter.prepare({\n    record,\n    prompt: input.prompt,\n    document: input.document,\n    now: input.now,\n    signal: controller.signal,\n  });\n  if (prepared.status === 'unsupported') {\n    clearTimeout(timeout);\n    input.signal?.removeEventListener('abort', abortFromCaller);\n    return failure(\n      prepared.reasonCode === 'unsupported-control'\n        ? ProviderExecutionReasonCodes.UNSUPPORTED_CONTROL\n        : ProviderExecutionReasonCodes.INVALID_PROVIDER,\n      'error',\n      0,\n    );\n  }\n\n  const aborted = new Promise<AttemptFailure>((resolve) => {\n    controller.signal.addEventListener('abort', () => {\n      resolve(failure(\n        timedOut\n          ? ProviderExecutionReasonCodes.TIMEOUT\n          : ProviderExecutionReasonCodes.CANCELLED,\n        timedOut ? 'timeout' : 'cancelled',\n        0,\n      ));\n    }, { once: true });\n  });\n  const operation = performTransport(input, record, prepared.request, adapter.parse);\n  try {\n    return await Promise.race([operation, aborted]);\n  } finally {\n    clearTimeout(timeout);\n    input.signal?.removeEventListener('abort', abortFromCaller);\n  }\n}\n\nasync function performTransport(\n  input: ExecuteProviderRouteInput,\n  record: ProviderModelRecord,\n  request: Parameters<ProviderTransport>[0],\n  parse: ReturnType<typeof getProviderAdapter>['parse'],\n): Promise<AttemptResult> {\n  try {\n    if (record.authorizationScheme === 'bearer') {\n      const status = await input.credentialStatus(\n        record.provider.credentialReference,\n        request.signal,\n      );\n      if (status !== 'available') {\n        return failure(\n          status === 'expired'\n            ? ProviderExecutionReasonCodes.EXPIRED_CREDENTIAL\n            : ProviderExecutionReasonCodes.MISSING_CREDENTIAL,\n          'error',\n          0,\n        );\n      }\n    }\n    if (request.signal.aborted) {\n      return failure(ProviderExecutionReasonCodes.CANCELLED, 'cancelled', 0);\n    }\n    const inputByteCount = new TextEncoder().encode(JSON.stringify(request.body)).byteLength;\n    const response = await input.transport(request);\n    if (request.signal.aborted) {\n      return failure(ProviderExecutionReasonCodes.CANCELLED, 'cancelled', inputByteCount);\n    }\n    const parsed = parse(response);\n    if (parsed.status === 'failure') {\n      return failure(parsed.reasonCode, parsed.terminal, inputByteCount);\n    }\n    return Object.freeze({\n      status: 'candidate',\n      text: parsed.text,\n      inputByteCount,\n      outputByteCount: parsed.outputByteCount,\n    });\n  } catch (error: unknown) {\n    return failure(\n      request.signal.aborted\n        ? ProviderExecutionReasonCodes.CANCELLED\n        : ProviderExecutionReasonCodes.PROVIDER_ERROR,\n      request.signal.aborted ? 'cancelled' : 'error',\n      0,\n    );\n  }\n}\n\ninterface ExactResultInput {\n  readonly record: ProviderModelRecord | null;\n  readonly exactOriginal: ProviderExecutionResult['exactOriginal'];\n  readonly privacyClass?: ProviderExecutionResult['privacyClass'];\n  readonly attemptCount: number;\n  readonly inputByteCount: number;\n  readonly durationMs: number;\n  readonly reasonCode: Exclude<ProviderExecutionReasonCode, 'none'>;\n  readonly terminal: Exclude<ProviderTerminalState, 'success'>;\n}\n\nfunction exactResult(input: ExactResultInput): ProviderExecutionResult {\n  return deepFreeze({\n    status: 'exact-original',\n    reasonCode: input.reasonCode,\n    providerTerminal: input.terminal,\n    providerId: input.record?.provider.providerId ?? null,\n    modelId: input.record?.provider.modelId ?? null,\n    privacyClass: input.privacyClass\n      ?? input.record?.provider.privacyClass\n      ?? PrivacyClasses.UNKNOWN,\n    exactOriginal: input.exactOriginal,\n    attemptCount: input.attemptCount,\n    inputByteCount: input.inputByteCount,\n    outputByteCount: 0,\n    durationMs: input.durationMs,\n    candidateText: null,\n  });\n}\n\nfunction failure(\n  reasonCode: AttemptFailure['reasonCode'],\n  terminal: AttemptFailure['terminal'],\n  inputByteCount: number,\n): AttemptFailure {\n  return Object.freeze({ status: 'failure', reasonCode, terminal, inputByteCount });\n}\n\nfunction elapsed(clock: () => number, startedAt: number): number {\n  return Math.max(0, Math.round(clock() - startedAt));\n}\n\nfunction sameAttemptPlan(\n  expected: readonly ProviderModelRecord[],\n  actual: readonly ProviderModelRecord[],\n): boolean {\n  return expected.length === actual.length\n    && expected.every((record, index) =>\n      record.provider.providerId === actual[index]?.provider.providerId);\n}","lineStart":1,"lineEnd":307,"totalLines":307,"truncated":false}},"title":"packages/cli-communication-projection/src/providers/executor.ts","time":{"start":1786568951021,"end":1786568951029}},"id":"prt_ff7cec358001lM9fl8pNjjTFwo","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7ceaa57001pU9tt1yysZXnJb"}}
