{"type":"tool_use","timestamp":1786568967055,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_00_y7dxwi1jCHJEXWKfLZG62409","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/controls.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/controls.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Provider Prompt Control Compilation\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { ConfidenceStates } from '../contracts/common.js';\n6: import { ProviderCapabilityNames } from '../contracts/provider.js';\n7: import { validatePromptProfile } from '../contracts/validate-policy.js';\n8: import { deepFreeze } from '../fidelity/freeze.js';\n9: \n10: import type { JsonObject, JsonValue } from '../contracts/common.js';\n11: import type { ProviderCapabilityName } from '../contracts/provider.js';\n12: import type { ProviderControlMapping, PromptProfileRecord } from '../contracts/prompt.js';\n13: import type {\n14:   MutableJsonObject,\n15:   ProviderModelRecord,\n16:   UnsupportedProviderRequest,\n17: } from './types.js';\n18: \n19: interface CompiledControls {\n20:   readonly status: 'compiled';\n21:   readonly body: JsonObject;\n22: }\n23: \n24: export type ControlCompilation = CompiledControls | UnsupportedProviderRequest;\n25: \n26: const SAFE_WIRE_SEGMENT = /^[A-Za-z][A-Za-z0-9_]*$/u;\n27: const FORBIDDEN_WIRE_SEGMENTS = new Set(['__proto__', 'constructor', 'prototype']);\n28: \n29: /** Compile required prompt controls into an isolated body before transport exists. */\n30: export function compilePromptControls(\n31:   record: ProviderModelRecord,\n32:   prompt: PromptProfileRecord,\n33:   baseBody: MutableJsonObject,\n34:   now: string,\n35: ): ControlCompilation {\n36:   const promptResult = validatePromptProfile(prompt);\n37:   if (\n38:     !promptResult.success\n39:     || !hasFreshCapabilityEvidence(record, now)\n40:     || !hasCapability(record, ProviderCapabilityNames.CHAT)\n41:   ) {\n42:     return unsupported('chat');\n43:   }\n44:   const body = structuredClone(baseBody);\n45:   const temperature = findMapping(record, prompt, 'temperature');\n46:   if (\n47:     !isSupportedMapping(temperature)\n48:     || !hasCapability(record, ProviderCapabilityNames.TEMPERATURE_CONTROL)\n49:     || !setWireValue(body, temperature.wireField, prompt.temperature)\n50:   ) {\n51:     return unsupported('temperature');\n52:   }\n53: \n54:   if (prompt.thinkingMode !== 'provider-default') {\n55:     const thinking = findMapping(record, prompt, 'thinking');\n56:     if (\n57:       !isSupportedMapping(thinking)\n58:       || !hasCapability(record, ProviderCapabilityNames.THINKING_CONTROL)\n59:       || !setWireValue(\n60:         body,\n61:         thinking.wireField,\n62:         thinkingWireValue(thinking.wireField, prompt.thinkingMode),\n63:       )\n64:     ) {\n65:       return unsupported('thinking');\n66:     }\n67:   }\n68:   return { status: 'compiled', body: deepFreeze(body) };\n69: }\n70: \n71: function hasFreshCapabilityEvidence(record: ProviderModelRecord, now: string): boolean {\n72:   const nowMs = Date.parse(now);\n73:   return Number.isFinite(nowMs)\n74:     && Date.parse(record.capabilityEvidence.observedAt) <= nowMs\n75:     && Date.parse(record.capabilityEvidence.expiresAt) > nowMs;\n76: }\n77: \n78: function findMapping(\n79:   record: ProviderModelRecord,\n80:   prompt: PromptProfileRecord,\n81:   control: ProviderControlMapping['control'],\n82: ): ProviderControlMapping | null {\n83:   const exact = prompt.providerControlMappings.find((mapping) =>\n84:     mapping.control === control\n85:       && matchesProvider(record, mapping.providerId)\n86:       && mapping.modelPattern === record.provider.modelId);\n87:   if (exact !== undefined) {\n88:     return exact;\n89:   }\n90:   return prompt.providerControlMappings.find((mapping) =>\n91:     mapping.control === control\n92:       && matchesProvider(record, mapping.providerId)\n93:       && mapping.modelPattern === '*') ?? null;\n94: }\n95: \n96: function matchesProvider(record: ProviderModelRecord, providerId: string): boolean {\n97:   return providerId === record.controlProviderId || providerId === record.provider.providerId;\n98: }\n99: \n100: function isSupportedMapping(\n101:   mapping: ProviderControlMapping | null,\n102: ): mapping is ProviderControlMapping & { readonly wireField: string } {\n103:   return mapping !== null\n104:     && mapping.support === 'yes'\n105:     && mapping.confidence === ConfidenceStates.CONFIRMED\n106:     && typeof mapping.wireField === 'string'\n107:     && mapping.wireField.length > 0;\n108: }\n109: \n110: function hasCapability(\n111:   record: ProviderModelRecord,\n112:   name: ProviderCapabilityName,\n113: ): boolean {\n114:   const capability = record.provider.capabilities.find((entry) => entry.name === name);\n115:   return capability?.state === 'yes' && capability.confidence === ConfidenceStates.CONFIRMED;\n116: }\n117: \n118: function thinkingWireValue(\n119:   wireField: string,\n120:   mode: Exclude<PromptProfileRecord['thinkingMode'], 'provider-default'>,\n121: ): JsonValue {\n122:   if (wireField === 'reasoning_effort') {\n123:     return mode === 'disabled' ? 'none' : 'medium';\n124:   }\n125:   return mode === 'enabled';\n126: }\n127: \n128: function setWireValue(\n129:   body: MutableJsonObject,\n130:   wireField: string,\n131:   value: JsonValue,\n132: ): boolean {\n133:   const segments = wireField.split('.');\n134:   if (\n135:     segments.length === 0\n136:     || segments.some((segment) =>\n137:       !SAFE_WIRE_SEGMENT.test(segment) || FORBIDDEN_WIRE_SEGMENTS.has(segment))\n138:   ) {\n139:     return false;\n140:   }\n141:   let target = body;\n142:   for (const segment of segments.slice(0, -1)) {\n143:     const current = target[segment];\n144:     if (current === undefined) {\n145:       const child: MutableJsonObject = {};\n146:       target[segment] = child;\n147:       target = child;\n148:     } else if (typeof current === 'object' && current !== null && !Array.isArray(current)) {\n149:       target = current as MutableJsonObject;\n150:     } else {\n151:       return false;\n152:     }\n153:   }\n154:   const last = segments.at(-1);\n155:   if (last === undefined) {\n156:     return false;\n157:   }\n158:   target[last] = value;\n159:   return true;\n160: }\n161: \n162: function unsupported(control: UnsupportedProviderRequest['control']): UnsupportedProviderRequest {\n163:   return Object.freeze({\n164:     status: 'unsupported',\n165:     reasonCode: 'unsupported-control',\n166:     control,\n167:   });\n168: }\n\n(End of file - total 168 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Provider Prompt Control Compilation\n// ───────────────────────────────────────────────────────────────────\n\nimport { ConfidenceStates } from '../contracts/common.js';\nimport { ProviderCapabilityNames } from '../contracts/provider.js';\nimport { validatePromptProfile } from '../contracts/validate-policy.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\n\nimport type { JsonObject, JsonValue } from '../contracts/common.js';\nimport type { ProviderCapabilityName } from '../contracts/provider.js';\nimport type { ProviderControlMapping, PromptProfileRecord } from '../contracts/prompt.js';\nimport type {\n  MutableJsonObject,\n  ProviderModelRecord,\n  UnsupportedProviderRequest,\n} from './types.js';\n\ninterface CompiledControls {\n  readonly status: 'compiled';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/controls.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Provider Prompt Control Compilation\n// ───────────────────────────────────────────────────────────────────\n\nimport { ConfidenceStates } from '../contracts/common.js';\nimport { ProviderCapabilityNames } from '../contracts/provider.js';\nimport { validatePromptProfile } from '../contracts/validate-policy.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\n\nimport type { JsonObject, JsonValue } from '../contracts/common.js';\nimport type { ProviderCapabilityName } from '../contracts/provider.js';\nimport type { ProviderControlMapping, PromptProfileRecord } from '../contracts/prompt.js';\nimport type {\n  MutableJsonObject,\n  ProviderModelRecord,\n  UnsupportedProviderRequest,\n} from './types.js';\n\ninterface CompiledControls {\n  readonly status: 'compiled';\n  readonly body: JsonObject;\n}\n\nexport type ControlCompilation = CompiledControls | UnsupportedProviderRequest;\n\nconst SAFE_WIRE_SEGMENT = /^[A-Za-z][A-Za-z0-9_]*$/u;\nconst FORBIDDEN_WIRE_SEGMENTS = new Set(['__proto__', 'constructor', 'prototype']);\n\n/** Compile required prompt controls into an isolated body before transport exists. */\nexport function compilePromptControls(\n  record: ProviderModelRecord,\n  prompt: PromptProfileRecord,\n  baseBody: MutableJsonObject,\n  now: string,\n): ControlCompilation {\n  const promptResult = validatePromptProfile(prompt);\n  if (\n    !promptResult.success\n    || !hasFreshCapabilityEvidence(record, now)\n    || !hasCapability(record, ProviderCapabilityNames.CHAT)\n  ) {\n    return unsupported('chat');\n  }\n  const body = structuredClone(baseBody);\n  const temperature = findMapping(record, prompt, 'temperature');\n  if (\n    !isSupportedMapping(temperature)\n    || !hasCapability(record, ProviderCapabilityNames.TEMPERATURE_CONTROL)\n    || !setWireValue(body, temperature.wireField, prompt.temperature)\n  ) {\n    return unsupported('temperature');\n  }\n\n  if (prompt.thinkingMode !== 'provider-default') {\n    const thinking = findMapping(record, prompt, 'thinking');\n    if (\n      !isSupportedMapping(thinking)\n      || !hasCapability(record, ProviderCapabilityNames.THINKING_CONTROL)\n      || !setWireValue(\n        body,\n        thinking.wireField,\n        thinkingWireValue(thinking.wireField, prompt.thinkingMode),\n      )\n    ) {\n      return unsupported('thinking');\n    }\n  }\n  return { status: 'compiled', body: deepFreeze(body) };\n}\n\nfunction hasFreshCapabilityEvidence(record: ProviderModelRecord, now: string): boolean {\n  const nowMs = Date.parse(now);\n  return Number.isFinite(nowMs)\n    && Date.parse(record.capabilityEvidence.observedAt) <= nowMs\n    && Date.parse(record.capabilityEvidence.expiresAt) > nowMs;\n}\n\nfunction findMapping(\n  record: ProviderModelRecord,\n  prompt: PromptProfileRecord,\n  control: ProviderControlMapping['control'],\n): ProviderControlMapping | null {\n  const exact = prompt.providerControlMappings.find((mapping) =>\n    mapping.control === control\n      && matchesProvider(record, mapping.providerId)\n      && mapping.modelPattern === record.provider.modelId);\n  if (exact !== undefined) {\n    return exact;\n  }\n  return prompt.providerControlMappings.find((mapping) =>\n    mapping.control === control\n      && matchesProvider(record, mapping.providerId)\n      && mapping.modelPattern === '*') ?? null;\n}\n\nfunction matchesProvider(record: ProviderModelRecord, providerId: string): boolean {\n  return providerId === record.controlProviderId || providerId === record.provider.providerId;\n}\n\nfunction isSupportedMapping(\n  mapping: ProviderControlMapping | null,\n): mapping is ProviderControlMapping & { readonly wireField: string } {\n  return mapping !== null\n    && mapping.support === 'yes'\n    && mapping.confidence === ConfidenceStates.CONFIRMED\n    && typeof mapping.wireField === 'string'\n    && mapping.wireField.length > 0;\n}\n\nfunction hasCapability(\n  record: ProviderModelRecord,\n  name: ProviderCapabilityName,\n): boolean {\n  const capability = record.provider.capabilities.find((entry) => entry.name === name);\n  return capability?.state === 'yes' && capability.confidence === ConfidenceStates.CONFIRMED;\n}\n\nfunction thinkingWireValue(\n  wireField: string,\n  mode: Exclude<PromptProfileRecord['thinkingMode'], 'provider-default'>,\n): JsonValue {\n  if (wireField === 'reasoning_effort') {\n    return mode === 'disabled' ? 'none' : 'medium';\n  }\n  return mode === 'enabled';\n}\n\nfunction setWireValue(\n  body: MutableJsonObject,\n  wireField: string,\n  value: JsonValue,\n): boolean {\n  const segments = wireField.split('.');\n  if (\n    segments.length === 0\n    || segments.some((segment) =>\n      !SAFE_WIRE_SEGMENT.test(segment) || FORBIDDEN_WIRE_SEGMENTS.has(segment))\n  ) {\n    return false;\n  }\n  let target = body;\n  for (const segment of segments.slice(0, -1)) {\n    const current = target[segment];\n    if (current === undefined) {\n      const child: MutableJsonObject = {};\n      target[segment] = child;\n      target = child;\n    } else if (typeof current === 'object' && current !== null && !Array.isArray(current)) {\n      target = current as MutableJsonObject;\n    } else {\n      return false;\n    }\n  }\n  const last = segments.at(-1);\n  if (last === undefined) {\n    return false;\n  }\n  target[last] = value;\n  return true;\n}\n\nfunction unsupported(control: UnsupportedProviderRequest['control']): UnsupportedProviderRequest {\n  return Object.freeze({\n    status: 'unsupported',\n    reasonCode: 'unsupported-control',\n    control,\n  });\n}","lineStart":1,"lineEnd":168,"totalLines":168,"truncated":false}},"title":"packages/cli-communication-projection/src/providers/controls.ts","time":{"start":1786568967042,"end":1786568967053}},"id":"prt_ff7cf01a9001NHf75nziqTH5d2","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cec8de001Ao2SXniDKMnqBT"}}
{"type":"tool_use","timestamp":1786568967567,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_aTH87jJoIxl4G0xeMIvA3965","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/presets.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/presets.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Evidence-Backed Provider Presets\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { PrivacyClasses } from '../contracts/context.js';\n6: import { deepFreeze } from '../fidelity/freeze.js';\n7: import {\n8:   ProviderFamilies,\n9:   ProviderPrivacyFactNames,\n10: } from './types.js';\n11: \n12: import type { PrivacyClass } from '../contracts/context.js';\n13: import type { ProviderCapability, ProviderRecord } from '../contracts/provider.js';\n14: import type {\n15:   ProviderCostRecord,\n16:   ProviderModelRecord,\n17:   ProviderPrivacyFact,\n18: } from './types.js';\n19: \n20: const OPENCODE_GO_DOCS = 'https://opencode.ai/docs/go/';\n21: const OLLAMA_DOCS = 'https://docs.ollama.com/api/chat';\n22: const LLAMA_CPP_DOCS =\n23:   'https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md';\n24: \n25: /** Configuration that never accepts a hosted credential value. */\n26: export interface OpenCodeGoPresetOptions {\n27:   readonly credentialReference: `env:${string}` | `keychain:${string}` | `managed:${string}`;\n28:   readonly timeoutMs?: number;\n29:   readonly priority?: number;\n30: }\n31: \n32: /** Operator assertions needed for a model-specific local deployment. */\n33: export interface LocalProviderPresetOptions {\n34:   readonly modelId: string;\n35:   readonly privacyClass: Extract<PrivacyClass, 'local-networked' | 'local-offline'>;\n36:   readonly observedAt: string;\n37:   readonly capabilitiesExpireAt: string;\n38:   readonly endpoint?: string;\n39:   readonly timeoutMs?: number;\n40:   readonly priority?: number;\n41: }\n42: \n43: /** OpenCode Go DeepSeek V4 Flash with dated privacy facts and unknown model controls. */\n44: export function createOpenCodeGoDeepSeekV4FlashRecord(\n45:   options: OpenCodeGoPresetOptions,\n46: ): ProviderModelRecord {\n47:   const observedAt = '2026-08-11T00:00:00.000Z';\n48:   const expiresAt = '2026-08-31T23:59:59.000Z';\n49:   return createRecord({\n50:     recordVersion: 'provider-model/1.0.0',\n51:     family: ProviderFamilies.OPENCODE_GO,\n52:     controlProviderId: 'opencode-go',\n53:     provider: {\n54:       contractKind: 'provider',\n55:       schemaVersion: '1.0.0',\n56:       providerId: 'opencode-go-deepseek-v4-flash',\n57:       deploymentMode: 'hosted',\n58:       protocol: 'openai-chat-completions',\n59:       endpoint: 'https://opencode.ai/zen/go/v1/chat/completions',\n60:       modelId: 'deepseek-v4-flash',\n61:       credentialReference: options.credentialReference,\n62:       providerVersion: 'research-snapshot-2026-08-11',\n63:       capabilities: baseCapabilities(true),\n64:       privacyClass: PrivacyClasses.HOSTED_ZDR,\n65:       termsCheckedAt: observedAt,\n66:       termsExpiresAt: expiresAt,\n67:       fallbackPolicy: noFallback(),\n68:     },\n69:     authorizationScheme: 'bearer',\n70:     timeoutMs: options.timeoutMs ?? 30_000,\n71:     priority: options.priority ?? 100,\n72:     capabilityEvidence: {\n73:       sourceUrl: OPENCODE_GO_DOCS,\n74:       observedAt,\n75:       expiresAt,\n76:     },\n77:     cost: unknownCost(OPENCODE_GO_DOCS, observedAt, expiresAt),\n78:     privacyFacts: [\n79:       knownFact(ProviderPrivacyFactNames.RETENTION, '0-days', OPENCODE_GO_DOCS, observedAt, expiresAt),\n80:       knownFact(ProviderPrivacyFactNames.TRAINING_USE, 'not-used', OPENCODE_GO_DOCS, observedAt, expiresAt),\n81:       unknownFact(ProviderPrivacyFactNames.RESIDENCY, OPENCODE_GO_DOCS, observedAt, expiresAt),\n82:     ],\n83:   });\n84: }\n85: \n86: /** Ollama native chat route whose model-specific controls require a fresh probe. */\n87: export function createOllamaModelRecord(\n88:   options: LocalProviderPresetOptions,\n89: ): ProviderModelRecord {\n90:   return createRecord({\n91:     recordVersion: 'provider-model/1.0.0',\n92:     family: ProviderFamilies.OLLAMA,\n93:     controlProviderId: 'ollama-local',\n94:     provider: localProvider(\n95:       'ollama-local',\n96:       'ollama-native',\n97:       options.endpoint ?? 'http://127.0.0.1:11434/api/chat',\n98:       options,\n99:       baseCapabilities(true),\n100:     ),\n101:     authorizationScheme: 'none',\n102:     timeoutMs: options.timeoutMs ?? 60_000,\n103:     priority: options.priority ?? 80,\n104:     capabilityEvidence: {\n105:       sourceUrl: OLLAMA_DOCS,\n106:       observedAt: options.observedAt,\n107:       expiresAt: options.capabilitiesExpireAt,\n108:     },\n109:     cost: unknownCost(OLLAMA_DOCS, options.observedAt, null),\n110:     privacyFacts: unknownFacts(OLLAMA_DOCS, options.observedAt),\n111:   });\n112: }\n113: \n114: /** llama.cpp OpenAI-style route whose build and template controls require a probe. */\n115: export function createLlamaCppModelRecord(\n116:   options: LocalProviderPresetOptions,\n117: ): ProviderModelRecord {\n118:   return createRecord({\n119:     recordVersion: 'provider-model/1.0.0',\n120:     family: ProviderFamilies.LLAMA_CPP,\n121:     controlProviderId: 'llama-cpp-local',\n122:     provider: localProvider(\n123:       'llama-cpp-local',\n124:       'llama-cpp-openai',\n125:       options.endpoint ?? 'http://127.0.0.1:8080/v1/chat/completions',\n126:       options,\n127:       baseCapabilities(true),\n128:     ),\n129:     authorizationScheme: 'none',\n130:     timeoutMs: options.timeoutMs ?? 60_000,\n131:     priority: options.priority ?? 70,\n132:     capabilityEvidence: {\n133:       sourceUrl: LLAMA_CPP_DOCS,\n134:       observedAt: options.observedAt,\n135:       expiresAt: options.capabilitiesExpireAt,\n136:     },\n137:     cost: unknownCost(LLAMA_CPP_DOCS, options.observedAt, null),\n138:     privacyFacts: unknownFacts(LLAMA_CPP_DOCS, options.observedAt),\n139:   });\n140: }\n141: \n142: function createRecord(record: ProviderModelRecord): ProviderModelRecord {\n143:   return deepFreeze(structuredClone(record));\n144: }\n145: \n146: function localProvider(\n147:   providerId: string,\n148:   protocol: ProviderRecord['protocol'],\n149:   endpoint: string,\n150:   options: LocalProviderPresetOptions,\n151:   capabilities: readonly ProviderCapability[],\n152: ): ProviderRecord {\n153:   return {\n154:     contractKind: 'provider',\n155:     schemaVersion: '1.0.0',\n156:     providerId,\n157:     deploymentMode: 'local',\n158:     protocol,\n159:     endpoint,\n160:     modelId: options.modelId,\n161:     credentialReference: 'none:local',\n162:     providerVersion: `operator-snapshot-${options.observedAt}`,\n163:     capabilities,\n164:     privacyClass: options.privacyClass,\n165:     termsCheckedAt: null,\n166:     termsExpiresAt: null,\n167:     fallbackPolicy: noFallback(),\n168:   };\n169: }\n170: \n171: function baseCapabilities(chatConfirmed: boolean): readonly ProviderCapability[] {\n172:   return [\n173:     { name: 'chat', state: chatConfirmed ? 'yes' : 'unknown', confidence: chatConfirmed ? 'confirmed' : 'unknown' },\n174:     { name: 'streaming', state: 'yes', confidence: 'confirmed' },\n175:     { name: 'temperature-control', state: 'unknown', confidence: 'unknown' },\n176:     { name: 'thinking-control', state: 'unknown', confidence: 'unknown' },\n177:     { name: 'cancellation', state: 'unknown', confidence: 'unknown' },\n178:   ];\n179: }\n180: \n181: function noFallback(): ProviderRecord['fallbackPolicy'] {\n182:   return { mode: 'none', providerIds: [], preservePrivacyClass: true };\n183: }\n184: \n185: function unknownCost(\n186:   sourceUrl: string,\n187:   observedAt: string,\n188:   expiresAt: string | null,\n189: ): ProviderCostRecord {\n190:   return {\n191:     state: 'unknown',\n192:     currency: 'USD',\n193:     inputPerMillionTokens: null,\n194:     outputPerMillionTokens: null,\n195:     sourceUrl,\n196:     observedAt,\n197:     expiresAt,\n198:   };\n199: }\n200: \n201: function knownFact(\n202:   name: ProviderPrivacyFact['name'],\n203:   value: string,\n204:   sourceUrl: string,\n205:   observedAt: string,\n206:   expiresAt: string,\n207: ): ProviderPrivacyFact {\n208:   return { name, state: 'known', value, confidence: 'confirmed', sourceUrl, observedAt, expiresAt };\n209: }\n210: \n211: function unknownFact(\n212:   name: ProviderPrivacyFact['name'],\n213:   sourceUrl: string,\n214:   observedAt: string,\n215:   expiresAt: string | null,\n216: ): ProviderPrivacyFact {\n217:   return { name, state: 'unknown', value: null, confidence: 'unknown', sourceUrl, observedAt, expiresAt };\n218: }\n219: \n220: function unknownFacts(sourceUrl: string, observedAt: string): readonly ProviderPrivacyFact[] {\n221:   return Object.values(ProviderPrivacyFactNames).map((name) =>\n222:     unknownFact(name, sourceUrl, observedAt, null));\n223: }\n\n(End of file - total 223 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Evidence-Backed Provider Presets\n// ───────────────────────────────────────────────────────────────────\n\nimport { PrivacyClasses } from '../contracts/context.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\nimport {\n  ProviderFamilies,\n  ProviderPrivacyFactNames,\n} from './types.js';\n\nimport type { PrivacyClass } from '../contracts/context.js';\nimport type { ProviderCapability, ProviderRecord } from '../contracts/provider.js';\nimport type {\n  ProviderCostRecord,\n  ProviderModelRecord,\n  ProviderPrivacyFact,\n} from './types.js';\n\nconst OPENCODE_GO_DOCS = 'https://opencode.ai/docs/go/';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/providers/presets.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Evidence-Backed Provider Presets\n// ───────────────────────────────────────────────────────────────────\n\nimport { PrivacyClasses } from '../contracts/context.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\nimport {\n  ProviderFamilies,\n  ProviderPrivacyFactNames,\n} from './types.js';\n\nimport type { PrivacyClass } from '../contracts/context.js';\nimport type { ProviderCapability, ProviderRecord } from '../contracts/provider.js';\nimport type {\n  ProviderCostRecord,\n  ProviderModelRecord,\n  ProviderPrivacyFact,\n} from './types.js';\n\nconst OPENCODE_GO_DOCS = 'https://opencode.ai/docs/go/';\nconst OLLAMA_DOCS = 'https://docs.ollama.com/api/chat';\nconst LLAMA_CPP_DOCS =\n  'https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md';\n\n/** Configuration that never accepts a hosted credential value. */\nexport interface OpenCodeGoPresetOptions {\n  readonly credentialReference: `env:${string}` | `keychain:${string}` | `managed:${string}`;\n  readonly timeoutMs?: number;\n  readonly priority?: number;\n}\n\n/** Operator assertions needed for a model-specific local deployment. */\nexport interface LocalProviderPresetOptions {\n  readonly modelId: string;\n  readonly privacyClass: Extract<PrivacyClass, 'local-networked' | 'local-offline'>;\n  readonly observedAt: string;\n  readonly capabilitiesExpireAt: string;\n  readonly endpoint?: string;\n  readonly timeoutMs?: number;\n  readonly priority?: number;\n}\n\n/** OpenCode Go DeepSeek V4 Flash with dated privacy facts and unknown model controls. */\nexport function createOpenCodeGoDeepSeekV4FlashRecord(\n  options: OpenCodeGoPresetOptions,\n): ProviderModelRecord {\n  const observedAt = '2026-08-11T00:00:00.000Z';\n  const expiresAt = '2026-08-31T23:59:59.000Z';\n  return createRecord({\n    recordVersion: 'provider-model/1.0.0',\n    family: ProviderFamilies.OPENCODE_GO,\n    controlProviderId: 'opencode-go',\n    provider: {\n      contractKind: 'provider',\n      schemaVersion: '1.0.0',\n      providerId: 'opencode-go-deepseek-v4-flash',\n      deploymentMode: 'hosted',\n      protocol: 'openai-chat-completions',\n      endpoint: 'https://opencode.ai/zen/go/v1/chat/completions',\n      modelId: 'deepseek-v4-flash',\n      credentialReference: options.credentialReference,\n      providerVersion: 'research-snapshot-2026-08-11',\n      capabilities: baseCapabilities(true),\n      privacyClass: PrivacyClasses.HOSTED_ZDR,\n      termsCheckedAt: observedAt,\n      termsExpiresAt: expiresAt,\n      fallbackPolicy: noFallback(),\n    },\n    authorizationScheme: 'bearer',\n    timeoutMs: options.timeoutMs ?? 30_000,\n    priority: options.priority ?? 100,\n    capabilityEvidence: {\n      sourceUrl: OPENCODE_GO_DOCS,\n      observedAt,\n      expiresAt,\n    },\n    cost: unknownCost(OPENCODE_GO_DOCS, observedAt, expiresAt),\n    privacyFacts: [\n      knownFact(ProviderPrivacyFactNames.RETENTION, '0-days', OPENCODE_GO_DOCS, observedAt, expiresAt),\n      knownFact(ProviderPrivacyFactNames.TRAINING_USE, 'not-used', OPENCODE_GO_DOCS, observedAt, expiresAt),\n      unknownFact(ProviderPrivacyFactNames.RESIDENCY, OPENCODE_GO_DOCS, observedAt, expiresAt),\n    ],\n  });\n}\n\n/** Ollama native chat route whose model-specific controls require a fresh probe. */\nexport function createOllamaModelRecord(\n  options: LocalProviderPresetOptions,\n): ProviderModelRecord {\n  return createRecord({\n    recordVersion: 'provider-model/1.0.0',\n    family: ProviderFamilies.OLLAMA,\n    controlProviderId: 'ollama-local',\n    provider: localProvider(\n      'ollama-local',\n      'ollama-native',\n      options.endpoint ?? 'http://127.0.0.1:11434/api/chat',\n      options,\n      baseCapabilities(true),\n    ),\n    authorizationScheme: 'none',\n    timeoutMs: options.timeoutMs ?? 60_000,\n    priority: options.priority ?? 80,\n    capabilityEvidence: {\n      sourceUrl: OLLAMA_DOCS,\n      observedAt: options.observedAt,\n      expiresAt: options.capabilitiesExpireAt,\n    },\n    cost: unknownCost(OLLAMA_DOCS, options.observedAt, null),\n    privacyFacts: unknownFacts(OLLAMA_DOCS, options.observedAt),\n  });\n}\n\n/** llama.cpp OpenAI-style route whose build and template controls require a probe. */\nexport function createLlamaCppModelRecord(\n  options: LocalProviderPresetOptions,\n): ProviderModelRecord {\n  return createRecord({\n    recordVersion: 'provider-model/1.0.0',\n    family: ProviderFamilies.LLAMA_CPP,\n    controlProviderId: 'llama-cpp-local',\n    provider: localProvider(\n      'llama-cpp-local',\n      'llama-cpp-openai',\n      options.endpoint ?? 'http://127.0.0.1:8080/v1/chat/completions',\n      options,\n      baseCapabilities(true),\n    ),\n    authorizationScheme: 'none',\n    timeoutMs: options.timeoutMs ?? 60_000,\n    priority: options.priority ?? 70,\n    capabilityEvidence: {\n      sourceUrl: LLAMA_CPP_DOCS,\n      observedAt: options.observedAt,\n      expiresAt: options.capabilitiesExpireAt,\n    },\n    cost: unknownCost(LLAMA_CPP_DOCS, options.observedAt, null),\n    privacyFacts: unknownFacts(LLAMA_CPP_DOCS, options.observedAt),\n  });\n}\n\nfunction createRecord(record: ProviderModelRecord): ProviderModelRecord {\n  return deepFreeze(structuredClone(record));\n}\n\nfunction localProvider(\n  providerId: string,\n  protocol: ProviderRecord['protocol'],\n  endpoint: string,\n  options: LocalProviderPresetOptions,\n  capabilities: readonly ProviderCapability[],\n): ProviderRecord {\n  return {\n    contractKind: 'provider',\n    schemaVersion: '1.0.0',\n    providerId,\n    deploymentMode: 'local',\n    protocol,\n    endpoint,\n    modelId: options.modelId,\n    credentialReference: 'none:local',\n    providerVersion: `operator-snapshot-${options.observedAt}`,\n    capabilities,\n    privacyClass: options.privacyClass,\n    termsCheckedAt: null,\n    termsExpiresAt: null,\n    fallbackPolicy: noFallback(),\n  };\n}\n\nfunction baseCapabilities(chatConfirmed: boolean): readonly ProviderCapability[] {\n  return [\n    { name: 'chat', state: chatConfirmed ? 'yes' : 'unknown', confidence: chatConfirmed ? 'confirmed' : 'unknown' },\n    { name: 'streaming', state: 'yes', confidence: 'confirmed' },\n    { name: 'temperature-control', state: 'unknown', confidence: 'unknown' },\n    { name: 'thinking-control', state: 'unknown', confidence: 'unknown' },\n    { name: 'cancellation', state: 'unknown', confidence: 'unknown' },\n  ];\n}\n\nfunction noFallback(): ProviderRecord['fallbackPolicy'] {\n  return { mode: 'none', providerIds: [], preservePrivacyClass: true };\n}\n\nfunction unknownCost(\n  sourceUrl: string,\n  observedAt: string,\n  expiresAt: string | null,\n): ProviderCostRecord {\n  return {\n    state: 'unknown',\n    currency: 'USD',\n    inputPerMillionTokens: null,\n    outputPerMillionTokens: null,\n    sourceUrl,\n    observedAt,\n    expiresAt,\n  };\n}\n\nfunction knownFact(\n  name: ProviderPrivacyFact['name'],\n  value: string,\n  sourceUrl: string,\n  observedAt: string,\n  expiresAt: string,\n): ProviderPrivacyFact {\n  return { name, state: 'known', value, confidence: 'confirmed', sourceUrl, observedAt, expiresAt };\n}\n\nfunction unknownFact(\n  name: ProviderPrivacyFact['name'],\n  sourceUrl: string,\n  observedAt: string,\n  expiresAt: string | null,\n): ProviderPrivacyFact {\n  return { name, state: 'unknown', value: null, confidence: 'unknown', sourceUrl, observedAt, expiresAt };\n}\n\nfunction unknownFacts(sourceUrl: string, observedAt: string): readonly ProviderPrivacyFact[] {\n  return Object.values(ProviderPrivacyFactNames).map((name) =>\n    unknownFact(name, sourceUrl, observedAt, null));\n}","lineStart":1,"lineEnd":223,"totalLines":223,"truncated":false}},"title":"packages/cli-communication-projection/src/providers/presets.ts","time":{"start":1786568967557,"end":1786568967566}},"id":"prt_ff7cf03ca001h14aX55lXyKTIG","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cec8de001Ao2SXniDKMnqBT"}}
{"type":"tool_use","timestamp":1786568968037,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_02_b17Yx0nY1P7rSwmToQBM4855","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/render/decision.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/render/decision.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Capability-Aware Render Decision\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { createSha256Digest } from '../contracts/exact-original.js';\n6: import { validateExactOriginal } from '../contracts/validate-event.js';\n7: import { isRecord } from '../contracts/validator-utils.js';\n8: import { deepFreeze } from '../fidelity/freeze.js';\n9: import {\n10:   RenderModes,\n11:   RenderReasonCodes,\n12: } from './types.js';\n13: \n14: import type {\n15:   ExactOriginalRenderDecision,\n16:   RenderCapabilities,\n17:   RenderDecision,\n18:   RenderDecisionInput,\n19:   RenderMode,\n20: } from './types.js';\n21: \n22: const INPUT_KEYS = [\n23:   'validation',\n24:   'currentSourceSha256',\n25:   'sourceTerminal',\n26:   'allPartsComplete',\n27:   'capabilities',\n28:   'preferredModes',\n29: ] as const;\n30: const CAPABILITY_KEYS = ['atomicReplace', 'appendAfterOriginal', 'sidecar'] as const;\n31: const SOURCE_TERMINALS = ['cancelled', 'completed', 'error', 'timeout'] as const;\n32: const DEFAULT_MODE_PREFERENCE: readonly RenderMode[] = Object.freeze([\n33:   RenderModes.ATOMIC_REPLACE,\n34:   RenderModes.APPEND_AFTER_ORIGINAL,\n35:   RenderModes.SIDECAR,\n36: ]);\n37: const SHA256_PATTERN = /^sha256:[a-f0-9]{64}$/u;\n38: \n39: /** Select one display mode without changing the canonical source or validation result. */\n40: export function decideRender(input: RenderDecisionInput): RenderDecision {\n41:   if (!isRecord(input) || !isRecord(input.validation)) {\n42:     throw new TypeError('Render input did not contain a valid exact original.');\n43:   }\n44:   const exactResult = validateExactOriginal(input.validation.exactOriginal);\n45:   if (!exactResult.success) {\n46:     throw new TypeError('Render input did not contain a valid exact original.');\n47:   }\n48:   const exactOriginal = exactResult.value;\n49: \n50:   if (!isValidInput(input)) {\n51:     return originalDecision(input, RenderReasonCodes.INVALID_INPUT);\n52:   }\n53:   if (input.currentSourceSha256 !== input.validation.sourceSha256) {\n54:     return originalDecision(input, RenderReasonCodes.SOURCE_CHANGED);\n55:   }\n56:   if (input.sourceTerminal !== 'completed' || !input.allPartsComplete) {\n57:     return originalDecision(input, RenderReasonCodes.INCOMPLETE_SOURCE);\n58:   }\n59:   if (input.validation.status !== 'accepted') {\n60:     return originalDecision(input, RenderReasonCodes.VALIDATION_REJECTED);\n61:   }\n62: \n63:   const projectionBytes = new TextEncoder().encode(input.validation.projectionText);\n64:   if (\n65:     projectionBytes.byteLength !== input.validation.projectionByteLength\n66:     || createSha256Digest(projectionBytes) !== input.validation.projectionSha256\n67:     || exactOriginal.sha256 !== input.validation.sourceSha256\n68:   ) {\n69:     return originalDecision(input, RenderReasonCodes.INVALID_INPUT);\n70:   }\n71: \n72:   const preferences = input.preferredModes ?? DEFAULT_MODE_PREFERENCE;\n73:   const mode = preferences.find((candidate) => isModeSupported(candidate, input.capabilities));\n74:   if (mode === undefined) {\n75:     return originalDecision(input, RenderReasonCodes.UNSUPPORTED_MODE);\n76:   }\n77:   if (mode === RenderModes.EXACT_ORIGINAL_ONLY) {\n78:     return originalDecision(input, RenderReasonCodes.ORIGINAL_SELECTED);\n79:   }\n80: \n81:   return deepFreeze({\n82:     status: 'projection',\n83:     mode,\n84:     reasonCode: RenderReasonCodes.PROJECTION_ACCEPTED,\n85:     renderProfileVersion: 'render/1.0.0',\n86:     sourceSha256: input.validation.sourceSha256,\n87:     exactOriginal,\n88:     projectionSha256: input.validation.projectionSha256,\n89:     projectionText: input.validation.projectionText,\n90:   });\n91: }\n92: \n93: function isValidInput(input: RenderDecisionInput): boolean {\n94:   if (!isRecord(input)) {\n95:     return false;\n96:   }\n97:   if (Object.keys(input).some((key) => !(INPUT_KEYS as readonly string[]).includes(key))) {\n98:     return false;\n99:   }\n100:   if (\n101:     typeof input.currentSourceSha256 !== 'string'\n102:     || !SHA256_PATTERN.test(input.currentSourceSha256)\n103:     || typeof input.allPartsComplete !== 'boolean'\n104:     || typeof input.sourceTerminal !== 'string'\n105:     || !(SOURCE_TERMINALS as readonly string[]).includes(input.sourceTerminal)\n106:   ) {\n107:     return false;\n108:   }\n109:   if (!isRecord(input.capabilities)) {\n110:     return false;\n111:   }\n112:   if (\n113:     Object.keys(input.capabilities)\n114:       .some((key) => !(CAPABILITY_KEYS as readonly string[]).includes(key))\n115:     || CAPABILITY_KEYS.some((key) => typeof input.capabilities[key] !== 'boolean')\n116:   ) {\n117:     return false;\n118:   }\n119:   if (input.preferredModes !== undefined) {\n120:     if (\n121:       !Array.isArray(input.preferredModes)\n122:       || input.preferredModes.length === 0\n123:       || input.preferredModes.some((mode) => !isRenderMode(mode))\n124:       || new Set(input.preferredModes).size !== input.preferredModes.length\n125:     ) {\n126:       return false;\n127:     }\n128:   }\n129:   return isValidValidationShape(input);\n130: }\n131: \n132: function isValidValidationShape(input: RenderDecisionInput): boolean {\n133:   const validation = input.validation;\n134:   if (!isRecord(validation)) {\n135:     return false;\n136:   }\n137:   if (\n138:     validation.sourceSha256 !== validation.exactOriginal.sha256\n139:     || typeof validation.validationProfileVersion !== 'string'\n140:     || validation.validationProfileVersion !== 'fidelity/1.0.0'\n141:   ) {\n142:     return false;\n143:   }\n144:   if (validation.status === 'accepted') {\n145:     return validation.reasonCode === 'accepted'\n146:       && typeof validation.projectionText === 'string'\n147:       && typeof validation.projectionSha256 === 'string'\n148:       && SHA256_PATTERN.test(validation.projectionSha256)\n149:       && typeof validation.projectionByteLength === 'number'\n150:       && Number.isInteger(validation.projectionByteLength)\n151:       && validation.projectionByteLength >= 0;\n152:   }\n153:   return validation.status === 'exact-original'\n154:     && validation.projectionText === null\n155:     && validation.projectionSha256 === null\n156:     && validation.projectionByteLength === validation.exactOriginal.byteLength;\n157: }\n158: \n159: function isRenderMode(value: unknown): value is RenderMode {\n160:   return typeof value === 'string'\n161:     && (Object.values(RenderModes) as readonly string[]).includes(value);\n162: }\n163: \n164: function isModeSupported(mode: RenderMode, capabilities: RenderCapabilities): boolean {\n165:   switch (mode) {\n166:     case RenderModes.ATOMIC_REPLACE:\n167:       return capabilities.atomicReplace;\n168:     case RenderModes.APPEND_AFTER_ORIGINAL:\n169:       return capabilities.appendAfterOriginal;\n170:     case RenderModes.SIDECAR:\n171:       return capabilities.sidecar;\n172:     case RenderModes.EXACT_ORIGINAL_ONLY:\n173:       return true;\n174:   }\n175: }\n176: \n177: function originalDecision(\n178:   input: RenderDecisionInput,\n179:   reasonCode: ExactOriginalRenderDecision['reasonCode'],\n180: ): ExactOriginalRenderDecision {\n181:   return deepFreeze({\n182:     status: 'exact-original',\n183:     mode: RenderModes.EXACT_ORIGINAL_ONLY,\n184:     reasonCode,\n185:     renderProfileVersion: 'render/1.0.0',\n186:     sourceSha256: input.validation.sourceSha256,\n187:     exactOriginal: input.validation.exactOriginal,\n188:     projectionSha256: null,\n189:     projectionText: null,\n190:   });\n191: }\n\n(End of file - total 191 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Capability-Aware Render Decision\n// ───────────────────────────────────────────────────────────────────\n\nimport { createSha256Digest } from '../contracts/exact-original.js';\nimport { validateExactOriginal } from '../contracts/validate-event.js';\nimport { isRecord } from '../contracts/validator-utils.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\nimport {\n  RenderModes,\n  RenderReasonCodes,\n} from './types.js';\n\nimport type {\n  ExactOriginalRenderDecision,\n  RenderCapabilities,\n  RenderDecision,\n  RenderDecisionInput,\n  RenderMode,\n} from './types.js';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/render/decision.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Capability-Aware Render Decision\n// ───────────────────────────────────────────────────────────────────\n\nimport { createSha256Digest } from '../contracts/exact-original.js';\nimport { validateExactOriginal } from '../contracts/validate-event.js';\nimport { isRecord } from '../contracts/validator-utils.js';\nimport { deepFreeze } from '../fidelity/freeze.js';\nimport {\n  RenderModes,\n  RenderReasonCodes,\n} from './types.js';\n\nimport type {\n  ExactOriginalRenderDecision,\n  RenderCapabilities,\n  RenderDecision,\n  RenderDecisionInput,\n  RenderMode,\n} from './types.js';\n\nconst INPUT_KEYS = [\n  'validation',\n  'currentSourceSha256',\n  'sourceTerminal',\n  'allPartsComplete',\n  'capabilities',\n  'preferredModes',\n] as const;\nconst CAPABILITY_KEYS = ['atomicReplace', 'appendAfterOriginal', 'sidecar'] as const;\nconst SOURCE_TERMINALS = ['cancelled', 'completed', 'error', 'timeout'] as const;\nconst DEFAULT_MODE_PREFERENCE: readonly RenderMode[] = Object.freeze([\n  RenderModes.ATOMIC_REPLACE,\n  RenderModes.APPEND_AFTER_ORIGINAL,\n  RenderModes.SIDECAR,\n]);\nconst SHA256_PATTERN = /^sha256:[a-f0-9]{64}$/u;\n\n/** Select one display mode without changing the canonical source or validation result. */\nexport function decideRender(input: RenderDecisionInput): RenderDecision {\n  if (!isRecord(input) || !isRecord(input.validation)) {\n    throw new TypeError('Render input did not contain a valid exact original.');\n  }\n  const exactResult = validateExactOriginal(input.validation.exactOriginal);\n  if (!exactResult.success) {\n    throw new TypeError('Render input did not contain a valid exact original.');\n  }\n  const exactOriginal = exactResult.value;\n\n  if (!isValidInput(input)) {\n    return originalDecision(input, RenderReasonCodes.INVALID_INPUT);\n  }\n  if (input.currentSourceSha256 !== input.validation.sourceSha256) {\n    return originalDecision(input, RenderReasonCodes.SOURCE_CHANGED);\n  }\n  if (input.sourceTerminal !== 'completed' || !input.allPartsComplete) {\n    return originalDecision(input, RenderReasonCodes.INCOMPLETE_SOURCE);\n  }\n  if (input.validation.status !== 'accepted') {\n    return originalDecision(input, RenderReasonCodes.VALIDATION_REJECTED);\n  }\n\n  const projectionBytes = new TextEncoder().encode(input.validation.projectionText);\n  if (\n    projectionBytes.byteLength !== input.validation.projectionByteLength\n    || createSha256Digest(projectionBytes) !== input.validation.projectionSha256\n    || exactOriginal.sha256 !== input.validation.sourceSha256\n  ) {\n    return originalDecision(input, RenderReasonCodes.INVALID_INPUT);\n  }\n\n  const preferences = input.preferredModes ?? DEFAULT_MODE_PREFERENCE;\n  const mode = preferences.find((candidate) => isModeSupported(candidate, input.capabilities));\n  if (mode === undefined) {\n    return originalDecision(input, RenderReasonCodes.UNSUPPORTED_MODE);\n  }\n  if (mode === RenderModes.EXACT_ORIGINAL_ONLY) {\n    return originalDecision(input, RenderReasonCodes.ORIGINAL_SELECTED);\n  }\n\n  return deepFreeze({\n    status: 'projection',\n    mode,\n    reasonCode: RenderReasonCodes.PROJECTION_ACCEPTED,\n    renderProfileVersion: 'render/1.0.0',\n    sourceSha256: input.validation.sourceSha256,\n    exactOriginal,\n    projectionSha256: input.validation.projectionSha256,\n    projectionText: input.validation.projectionText,\n  });\n}\n\nfunction isValidInput(input: RenderDecisionInput): boolean {\n  if (!isRecord(input)) {\n    return false;\n  }\n  if (Object.keys(input).some((key) => !(INPUT_KEYS as readonly string[]).includes(key))) {\n    return false;\n  }\n  if (\n    typeof input.currentSourceSha256 !== 'string'\n    || !SHA256_PATTERN.test(input.currentSourceSha256)\n    || typeof input.allPartsComplete !== 'boolean'\n    || typeof input.sourceTerminal !== 'string'\n    || !(SOURCE_TERMINALS as readonly string[]).includes(input.sourceTerminal)\n  ) {\n    return false;\n  }\n  if (!isRecord(input.capabilities)) {\n    return false;\n  }\n  if (\n    Object.keys(input.capabilities)\n      .some((key) => !(CAPABILITY_KEYS as readonly string[]).includes(key))\n    || CAPABILITY_KEYS.some((key) => typeof input.capabilities[key] !== 'boolean')\n  ) {\n    return false;\n  }\n  if (input.preferredModes !== undefined) {\n    if (\n      !Array.isArray(input.preferredModes)\n      || input.preferredModes.length === 0\n      || input.preferredModes.some((mode) => !isRenderMode(mode))\n      || new Set(input.preferredModes).size !== input.preferredModes.length\n    ) {\n      return false;\n    }\n  }\n  return isValidValidationShape(input);\n}\n\nfunction isValidValidationShape(input: RenderDecisionInput): boolean {\n  const validation = input.validation;\n  if (!isRecord(validation)) {\n    return false;\n  }\n  if (\n    validation.sourceSha256 !== validation.exactOriginal.sha256\n    || typeof validation.validationProfileVersion !== 'string'\n    || validation.validationProfileVersion !== 'fidelity/1.0.0'\n  ) {\n    return false;\n  }\n  if (validation.status === 'accepted') {\n    return validation.reasonCode === 'accepted'\n      && typeof validation.projectionText === 'string'\n      && typeof validation.projectionSha256 === 'string'\n      && SHA256_PATTERN.test(validation.projectionSha256)\n      && typeof validation.projectionByteLength === 'number'\n      && Number.isInteger(validation.projectionByteLength)\n      && validation.projectionByteLength >= 0;\n  }\n  return validation.status === 'exact-original'\n    && validation.projectionText === null\n    && validation.projectionSha256 === null\n    && validation.projectionByteLength === validation.exactOriginal.byteLength;\n}\n\nfunction isRenderMode(value: unknown): value is RenderMode {\n  return typeof value === 'string'\n    && (Object.values(RenderModes) as readonly string[]).includes(value);\n}\n\nfunction isModeSupported(mode: RenderMode, capabilities: RenderCapabilities): boolean {\n  switch (mode) {\n    case RenderModes.ATOMIC_REPLACE:\n      return capabilities.atomicReplace;\n    case RenderModes.APPEND_AFTER_ORIGINAL:\n      return capabilities.appendAfterOriginal;\n    case RenderModes.SIDECAR:\n      return capabilities.sidecar;\n    case RenderModes.EXACT_ORIGINAL_ONLY:\n      return true;\n  }\n}\n\nfunction originalDecision(\n  input: RenderDecisionInput,\n  reasonCode: ExactOriginalRenderDecision['reasonCode'],\n): ExactOriginalRenderDecision {\n  return deepFreeze({\n    status: 'exact-original',\n    mode: RenderModes.EXACT_ORIGINAL_ONLY,\n    reasonCode,\n    renderProfileVersion: 'render/1.0.0',\n    sourceSha256: input.validation.sourceSha256,\n    exactOriginal: input.validation.exactOriginal,\n    projectionSha256: null,\n    projectionText: null,\n  });\n}","lineStart":1,"lineEnd":191,"totalLines":191,"truncated":false}},"title":"packages/cli-communication-projection/src/render/decision.ts","time":{"start":1786568968032,"end":1786568968036}},"id":"prt_ff7cf05a9001jYKRskGAMJiY7f","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cec8de001Ao2SXniDKMnqBT"}}
