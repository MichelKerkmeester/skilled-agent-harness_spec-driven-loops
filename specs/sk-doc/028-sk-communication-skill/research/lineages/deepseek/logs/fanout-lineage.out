cation-projection/src/providers/presets.ts:43-84,171-179\",\"packages/cli-communication-projection/src/providers/executor.ts:150-185\",\"packages/cli-communication-projection/test/fixtures/prompt-profiles.json:22-57\",\"packages/cli-communication-projection/src/fidelity/dialect.ts:37-46,265-288\"],\"timestamp\":\"2026-08-12T21:14:00.000Z\",\"durationMs\":120000,\"graphEvents\":[{\"type\":\"node\",\"id\":\"f-control-gate\",\"kind\":\"FINDING\",\"label\":\"fail-closed control evidence\"},{\"type\":\"node\",\"id\":\"f-adjacent-inflation\",\"kind\":\"FINDING\",\"label\":\"adjacent span not coalesced\"},{\"type\":\"edge\",\"from\":\"f-control-gate\",\"to\":\"q-quality\",\"relation\":\"ANSWERS\"}]}\nEOF\necho ok","time":{"start":1786569191453,"end":1786569191455}},"id":"prt_ff7d25e65001eVZrBTRufC2RDp","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7d251dc001OOR83VCF0ME8Bc"}}
