nly kind: EventKind;\n38:   readonly phase: EventPhase;\n39:   readonly sourceTimestamp: string | null;\n40:   readonly order: EventOrder;\n41:   readonly canonicalPayloadRef: string;\n42:   readonly payload: JsonObject;\n43:   readonly extensions: JsonObject;\n44:   readonly terminalStatus: TerminalStatus;\n45:   readonly capabilityConfidence: ConfidenceState;\n46: }\n47: \n48: // ───────────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────────\n51: \n52: /** Portable event categories; runtime-only events use `extension`. */\n53: export const EventKinds = {\n54:   ASSISTANT_MESSAGE: 'assistant-message',\n55:   ASSISTANT_MESSAGE_DELTA: 'assistant-message-delta',\n56:   CANCELLATION: 'cancellation',\n57:   ERROR: 'error',\n58:   EXTENSION: 'extension',\n59:   TOOL_CALL: 'tool-call',\n60:   TOOL_RESULT: 'tool-result',\n61: } as const;\n62: \n63: /** Portable event category. */\n64: export type EventKind = typeof EventKinds[keyof typeof EventKinds];\n65: \n66: /** Lifecycle phase of one immutable event. */\n67: export const EventPhases = {\n68:   CANCELLED: 'cancelled',\n69:   CREATED: 'created',\n70:   FAILED: 'failed',\n71:   FINAL: 'final',\n72:   STREAMING: 'streaming',\n73: } as const;\n74: \n75: /** Event lifecycle phase. */\n76: export type EventPhase = typeof EventPhases[keyof typeof EventPhases];\n77: \n78: /** Terminal state represented by an event. */\n79: export const TerminalStatuses = {\n80:   CANCELLED: 'cancelled',\n81:   COMPLETED: 'completed',\n82:   FAILED: 'failed',\n83:   NONE: 'none',\n84: } as const;\n85: \n86: /** Event terminal state. */\n87: export type TerminalStatus = typeof TerminalStatuses[keyof typeof TerminalStatuses];\n\n(End of file - total 87 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Canonical Event Contract\n// ───────────────────────────────────────────────────────────────────\n\nimport type {\n  ConfidenceState,\n  ContractHeader,\n  JsonObject,\n  RuntimeId,\n} from './common.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Independent order coordinates retained from a runtime event stream. */\nexport interface EventOrder {\n  readonly sourceSequence: number | null;\n  readonly arrivalIndex: number;\n  readonly assemblyIndex: number | null;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/contracts/event.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Canonical Event Contract\n// ───────────────────────────────────────────────────────────────────\n\nimport type {\n  ConfidenceState,\n  ContractHeader,\n  JsonObject,\n  RuntimeId,\n} from './common.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\n/** Independent order coordinates retained from a runtime event stream. */\nexport interface EventOrder {\n  readonly sourceSequence: number | null;\n  readonly arrivalIndex: number;\n  readonly assemblyIndex: number | null;\n}\n\n/** Runtime-neutral immutable event envelope. */\nexport interface EventEnvelope extends ContractHeader {\n  readonly contractKind: 'event';\n  readonly runtime: RuntimeId;\n  readonly runtimeVersion: string;\n  readonly adapterSchemaVersion: string;\n  readonly sessionId: string;\n  readonly turnId: string | null;\n  readonly messageId: string | null;\n  readonly itemId: string | null;\n  readonly partId: string | null;\n  readonly toolCallId: string | null;\n  readonly parentId: string | null;\n  readonly eventId: string;\n  readonly kind: EventKind;\n  readonly phase: EventPhase;\n  readonly sourceTimestamp: string | null;\n  readonly order: EventOrder;\n  readonly canonicalPayloadRef: string;\n  readonly payload: JsonObject;\n  readonly extensions: JsonObject;\n  readonly terminalStatus: TerminalStatus;\n  readonly capabilityConfidence: ConfidenceState;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\n/** Portable event categories; runtime-only events use `extension`. */\nexport const EventKinds = {\n  ASSISTANT_MESSAGE: 'assistant-message',\n  ASSISTANT_MESSAGE_DELTA: 'assistant-message-delta',\n  CANCELLATION: 'cancellation',\n  ERROR: 'error',\n  EXTENSION: 'extension',\n  TOOL_CALL: 'tool-call',\n  TOOL_RESULT: 'tool-result',\n} as const;\n\n/** Portable event category. */\nexport type EventKind = typeof EventKinds[keyof typeof EventKinds];\n\n/** Lifecycle phase of one immutable event. */\nexport const EventPhases = {\n  CANCELLED: 'cancelled',\n  CREATED: 'created',\n  FAILED: 'failed',\n  FINAL: 'final',\n  STREAMING: 'streaming',\n} as const;\n\n/** Event lifecycle phase. */\nexport type EventPhase = typeof EventPhases[keyof typeof EventPhases];\n\n/** Terminal state represented by an event. */\nexport const TerminalStatuses = {\n  CANCELLED: 'cancelled',\n  COMPLETED: 'completed',\n  FAILED: 'failed',\n  NONE: 'none',\n} as const;\n\n/** Event terminal state. */\nexport type TerminalStatus = typeof TerminalStatuses[keyof typeof TerminalStatuses];","lineStart":1,"lineEnd":87,"totalLines":87,"truncated":false}},"title":"packages/cli-communication-projection/src/contracts/event.ts","time":{"start":1786568994295,"end":1786568994300}},"id":"prt_ff7cf6bfc001GgMM1yD1Y6hnQv","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cf0d63001xLI5WZMiQTwR5S"}}
{"type":"tool_use","timestamp":1786568994813,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_01_mf7JxfeNjglxwfsdSFGf0840","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/core/assembly-output.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/core/assembly-output.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Terminal Assembly Output\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import {\n6:   EventKinds,\n7:   TerminalStatuses,\n8: } from '../contracts/event.js';\n9: import { decodeExactOriginal } from '../contracts/exact-original.js';\n10: import { normalizeEvent } from './normalizer.js';\n11: import { AssemblyReasonCodes } from './assembly-types.js';\n12: \n13: import type { EventEnvelope } from '../contracts/event.js';\n14: import type { ExactOriginalRecord } from '../contracts/exact-original.js';\n15: import type {\n16:   AssemblyOrderSnapshot,\n17:   AssemblyReasonCode,\n18:   AssemblyTerminalBase,\n19:   AssemblyTerminalResult,\n20:   BufferedAssemblyEvent,\n21:   ExactOriginalAssembly,\n22:   GenerationKey,\n23: } from './assembly-types.js';\n24: \n25: /** Ordered terminal view used to build a candidate or exact-original outcome. */\n26: export interface TerminalAssemblySnapshot {\n27:   readonly buffered: readonly BufferedAssemblyEvent[];\n28:   readonly events: readonly EventEnvelope[];\n29:   readonly order: AssemblyOrderSnapshot;\n30: }\n31: \n32: /** Derive source, arrival, and assembly views without mutating stored events. */\n33: export function createAssemblySnapshot(\n34:   events: readonly BufferedAssemblyEvent[],\n35: ): TerminalAssemblySnapshot {\n36:   const arrival = [...events].sort(compareArrival);\n37:   const source = [...events].sort(compareSource);\n38:   const assembly = [...source];\n39:   const indexedEvents = assembly.map((entry, index) => withAssemblyIndex(entry.event, index));\n40:   const buffered = assembly.map((entry, index) => ({\n41:     event: indexedEvents[index] ?? entry.event,\n42:     original: entry.original,\n43:   }));\n44:   const order: AssemblyOrderSnapshot = deepFreeze({\n45:     source: source.map((entry) => ({\n46:       eventId: entry.event.eventId,\n47:       index: entry.event.order.sourceSequence,\n48:     })),\n49:     arrival: arrival.map((entry) => ({\n50:       eventId: entry.event.eventId,\n51:       index: entry.event.order.arrivalIndex,\n52:     })),\n53:     assembly: indexedEvents.map((event) => ({\n54:       eventId: event.eventId,\n55:       index: event.order.assemblyIndex,\n56:     })),\n57:   });\n58:   return Object.freeze({\n59:     buffered: Object.freeze(buffered),\n60:     events: Object.freeze(indexedEvents),\n61:     order,\n62:   });\n63: }\n64: \n65: /** Decode a successful terminal snapshot or select a typed exact-original fallback. */\n66: export function completeAssembly(\n67:   base: AssemblyTerminalBase,\n68:   events: readonly BufferedAssemblyEvent[],\n69: ): AssemblyTerminalResult {\n70:   const finalMessage = [...events].reverse().find((entry) =>\n71:     entry.event.kind === EventKinds.ASSISTANT_MESSAGE\n72:       && entry.event.terminalStatus === TerminalStatuses.COMPLETED,\n73:   );\n74:   const contentRecords = finalMessage === undefined\n75:     ? events\n76:       .filter((entry) => entry.event.kind === EventKinds.ASSISTANT_MESSAGE_DELTA)\n77:       .map((entry) => entry.original)\n78:     : [finalMessage.original];\n79:   const byteParts = contentRecords.map((record) => Buffer.from(decodeExactOriginal(record)));\n80:   const bytes = Buffer.concat(byteParts);\n81:   if (bytes.byteLength === 0) {\n82:     return createFallbackAssembly(base, AssemblyReasonCodes.EMPTY_OUTPUT);\n83:   }\n84: \n85:   try {\n86:     const text = new TextDecoder('utf-8', { fatal: true }).decode(bytes);\n87:     if (text.length === 0) {\n88:       return createFallbackAssembly(base, AssemblyReasonCodes.EMPTY_OUTPUT);\n89:     }\n90:     return deepFreeze({\n91:       ...base,\n92:       status: 'completed',\n93:       reasonCode: AssemblyReasonCodes.COMPLETED,\n94:       outputByteCount: bytes.byteLength,\n95:       text,\n96:     });\n97:   } catch (error: unknown) {\n98:     return createFallbackAssembly(base, AssemblyReasonCodes.CORRUPT_ENCODING);\n99:   }\n100: }\n101: \n102: /** Freeze a terminal exact-original result with no raw diagnostic copy. */\n103: export function createFallbackAssembly(\n104:   base: AssemblyTerminalBase,\n105:   reasonCode: Exclude<AssemblyReasonCode, 'completed'>,\n106: ): ExactOriginalAssembly {\n107:   return deepFreeze({\n108:     ...base,\n109:     status: 'exact-original',\n110:     reasonCode,\n111:     outputByteCount: base.exactOriginal.byteLength,\n112:   });\n113: }\n114: \n115: /** Create a terminal fallback before mutable generation state is allocated. */\n116: export function createEmptyFallback(\n117:   key: GenerationKey,\n118:   exactOriginal: ExactOriginalRecord,\n119:   reasonCode: Exclude<AssemblyReasonCode, 'completed'>,\n120:   timestampMs: number,\n121: ): ExactOriginalAssembly {\n122:   return deepFreeze({\n123:     status: 'exact-original',\n124:     key,\n125:     reasonCode,\n126:     exactOriginal,\n127:     events: [],\n128:     order: { source: [], arrival: [], assembly: [] },\n129:     startedAtMs: timestampMs,\n130:     terminalAtMs: timestampMs,\n131:     durationMs: 0,\n132:     inputByteCount: 0,\n133:     outputByteCount: exactOriginal.byteLength,\n134:   });\n135: }\n136: \n137: /** Detach caller-owned exact bytes before retaining them in mutable state. */\n138: export function freezeExactOriginal(record: ExactOriginalRecord): ExactOriginalRecord {\n139:   if (Object.isFrozen(record) && Object.isFrozen(record.provenance)) {\n140:     return record;\n141:   }\n142:   return deepFreeze(structuredClone(record));\n143: }\n144: \n145: function compareArrival(\n146:   left: BufferedAssemblyEvent,\n147:   right: BufferedAssemblyEvent,\n148: ): number {\n149:   return left.event.order.arrivalIndex - right.event.order.arrivalIndex\n150:     || left.event.eventId.localeCompare(right.event.eventId);\n151: }\n152: \n153: function compareSource(\n154:   left: BufferedAssemblyEvent,\n155:   right: BufferedAssemblyEvent,\n156: ): number {\n157:   const leftSource = left.event.order.sourceSequence;\n158:   const rightSource = right.event.order.sourceSequence;\n159:   if (leftSource === null && rightSource !== null) {\n160:     return 1;\n161:   }\n162:   if (leftSource !== null && rightSource === null) {\n163:     return -1;\n164:   }\n165:   if (leftSource !== null && rightSource !== null && leftSource !== rightSource) {\n166:     return leftSource - rightSource;\n167:   }\n168:   return compareArrival(left, right);\n169: }\n170: \n171: function withAssemblyIndex(event: EventEnvelope, assemblyIndex: number): EventEnvelope {\n172:   const result = normalizeEvent({\n173:     ...event,\n174:     order: {\n175:       ...event.order,\n176:       assemblyIndex,\n177:     },\n178:   });\n179:   if (!result.success) {\n180:     throw new Error('Internal assembly order must remain a valid event envelope.');\n181:   }\n182:   return result.value;\n183: }\n184: \n185: function deepFreeze<TValue>(value: TValue): TValue {\n186:   if (typeof value !== 'object' || value === null || Object.isFrozen(value)) {\n187:     return value;\n188:   }\n189:   for (const child of Object.values(value)) {\n190:     deepFreeze(child);\n191:   }\n192:   return Object.freeze(value);\n193: }\n\n(End of file - total 193 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Terminal Assembly Output\n// ───────────────────────────────────────────────────────────────────\n\nimport {\n  EventKinds,\n  TerminalStatuses,\n} from '../contracts/event.js';\nimport { decodeExactOriginal } from '../contracts/exact-original.js';\nimport { normalizeEvent } from './normalizer.js';\nimport { AssemblyReasonCodes } from './assembly-types.js';\n\nimport type { EventEnvelope } from '../contracts/event.js';\nimport type { ExactOriginalRecord } from '../contracts/exact-original.js';\nimport type {\n  AssemblyOrderSnapshot,\n  AssemblyReasonCode,\n  AssemblyTerminalBase,\n  AssemblyTerminalResult,\n  BufferedAssemblyEvent,","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/core/assembly-output.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Terminal Assembly Output\n// ───────────────────────────────────────────────────────────────────\n\nimport {\n  EventKinds,\n  TerminalStatuses,\n} from '../contracts/event.js';\nimport { decodeExactOriginal } from '../contracts/exact-original.js';\nimport { normalizeEvent } from './normalizer.js';\nimport { AssemblyReasonCodes } from './assembly-types.js';\n\nimport type { EventEnvelope } from '../contracts/event.js';\nimport type { ExactOriginalRecord } from '../contracts/exact-original.js';\nimport type {\n  AssemblyOrderSnapshot,\n  AssemblyReasonCode,\n  AssemblyTerminalBase,\n  AssemblyTerminalResult,\n  BufferedAssemblyEvent,\n  ExactOriginalAssembly,\n  GenerationKey,\n} from './assembly-types.js';\n\n/** Ordered terminal view used to build a candidate or exact-original outcome. */\nexport interface TerminalAssemblySnapshot {\n  readonly buffered: readonly BufferedAssemblyEvent[];\n  readonly events: readonly EventEnvelope[];\n  readonly order: AssemblyOrderSnapshot;\n}\n\n/** Derive source, arrival, and assembly views without mutating stored events. */\nexport function createAssemblySnapshot(\n  events: readonly BufferedAssemblyEvent[],\n): TerminalAssemblySnapshot {\n  const arrival = [...events].sort(compareArrival);\n  const source = [...events].sort(compareSource);\n  const assembly = [...source];\n  const indexedEvents = assembly.map((entry, index) => withAssemblyIndex(entry.event, index));\n  const buffered = assembly.map((entry, index) => ({\n    event: indexedEvents[index] ?? entry.event,\n    original: entry.original,\n  }));\n  const order: AssemblyOrderSnapshot = deepFreeze({\n    source: source.map((entry) => ({\n      eventId: entry.event.eventId,\n      index: entry.event.order.sourceSequence,\n    })),\n    arrival: arrival.map((entry) => ({\n      eventId: entry.event.eventId,\n      index: entry.event.order.arrivalIndex,\n    })),\n    assembly: indexedEvents.map((event) => ({\n      eventId: event.eventId,\n      index: event.order.assemblyIndex,\n    })),\n  });\n  return Object.freeze({\n    buffered: Object.freeze(buffered),\n    events: Object.freeze(indexedEvents),\n    order,\n  });\n}\n\n/** Decode a successful terminal snapshot or select a typed exact-original fallback. */\nexport function completeAssembly(\n  base: AssemblyTerminalBase,\n  events: readonly BufferedAssemblyEvent[],\n): AssemblyTerminalResult {\n  const finalMessage = [...events].reverse().find((entry) =>\n    entry.event.kind === EventKinds.ASSISTANT_MESSAGE\n      && entry.event.terminalStatus === TerminalStatuses.COMPLETED,\n  );\n  const contentRecords = finalMessage === undefined\n    ? events\n      .filter((entry) => entry.event.kind === EventKinds.ASSISTANT_MESSAGE_DELTA)\n      .map((entry) => entry.original)\n    : [finalMessage.original];\n  const byteParts = contentRecords.map((record) => Buffer.from(decodeExactOriginal(record)));\n  const bytes = Buffer.concat(byteParts);\n  if (bytes.byteLength === 0) {\n    return createFallbackAssembly(base, AssemblyReasonCodes.EMPTY_OUTPUT);\n  }\n\n  try {\n    const text = new TextDecoder('utf-8', { fatal: true }).decode(bytes);\n    if (text.length === 0) {\n      return createFallbackAssembly(base, AssemblyReasonCodes.EMPTY_OUTPUT);\n    }\n    return deepFreeze({\n      ...base,\n      status: 'completed',\n      reasonCode: AssemblyReasonCodes.COMPLETED,\n      outputByteCount: bytes.byteLength,\n      text,\n    });\n  } catch (error: unknown) {\n    return createFallbackAssembly(base, AssemblyReasonCodes.CORRUPT_ENCODING);\n  }\n}\n\n/** Freeze a terminal exact-original result with no raw diagnostic copy. */\nexport function createFallbackAssembly(\n  base: AssemblyTerminalBase,\n  reasonCode: Exclude<AssemblyReasonCode, 'completed'>,\n): ExactOriginalAssembly {\n  return deepFreeze({\n    ...base,\n    status: 'exact-original',\n    reasonCode,\n    outputByteCount: base.exactOriginal.byteLength,\n  });\n}\n\n/** Create a terminal fallback before mutable generation state is allocated. */\nexport function createEmptyFallback(\n  key: GenerationKey,\n  exactOriginal: ExactOriginalRecord,\n  reasonCode: Exclude<AssemblyReasonCode, 'completed'>,\n  timestampMs: number,\n): ExactOriginalAssembly {\n  return deepFreeze({\n    status: 'exact-original',\n    key,\n    reasonCode,\n    exactOriginal,\n    events: [],\n    order: { source: [], arrival: [], assembly: [] },\n    startedAtMs: timestampMs,\n    terminalAtMs: timestampMs,\n    durationMs: 0,\n    inputByteCount: 0,\n    outputByteCount: exactOriginal.byteLength,\n  });\n}\n\n/** Detach caller-owned exact bytes before retaining them in mutable state. */\nexport function freezeExactOriginal(record: ExactOriginalRecord): ExactOriginalRecord {\n  if (Object.isFrozen(record) && Object.isFrozen(record.provenance)) {\n    return record;\n  }\n  return deepFreeze(structuredClone(record));\n}\n\nfunction compareArrival(\n  left: BufferedAssemblyEvent,\n  right: BufferedAssemblyEvent,\n): number {\n  return left.event.order.arrivalIndex - right.event.order.arrivalIndex\n    || left.event.eventId.localeCompare(right.event.eventId);\n}\n\nfunction compareSource(\n  left: BufferedAssemblyEvent,\n  right: BufferedAssemblyEvent,\n): number {\n  const leftSource = left.event.order.sourceSequence;\n  const rightSource = right.event.order.sourceSequence;\n  if (leftSource === null && rightSource !== null) {\n    return 1;\n  }\n  if (leftSource !== null && rightSource === null) {\n    return -1;\n  }\n  if (leftSource !== null && rightSource !== null && leftSource !== rightSource) {\n    return leftSource - rightSource;\n  }\n  return compareArrival(left, right);\n}\n\nfunction withAssemblyIndex(event: EventEnvelope, assemblyIndex: number): EventEnvelope {\n  const result = normalizeEvent({\n    ...event,\n    order: {\n      ...event.order,\n      assemblyIndex,\n    },\n  });\n  if (!result.success) {\n    throw new Error('Internal assembly order must remain a valid event envelope.');\n  }\n  return result.value;\n}\n\nfunction deepFreeze<TValue>(value: TValue): TValue {\n  if (typeof value !== 'object' || value === null || Object.isFrozen(value)) {\n    return value;\n  }\n  for (const child of Object.values(value)) {\n    deepFreeze(child);\n  }\n  return Object.freeze(value);\n}","lineStart":1,"lineEnd":193,"totalLines":193,"truncated":false}},"title":"packages/cli-communication-projection/src/core/assembly-output.ts","time":{"start":1786568994806,"end":1786568994811}},"id":"prt_ff7cf6e42001RZjpsVq3eKP0X3","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cf0d63001xLI5WZMiQTwR5S"}}
{"type":"tool_use","timestamp":1786568995285,"sessionID":"ses_00832c111ffe8md0OBtHNejm4h","part":{"type":"tool","tool":"read","callID":"call_02_Vh1fsVe1MLpb6GDNzAnb3519","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/clients/types.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/clients/types.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Client Presentation Types\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import type { RuntimeAdapterReasonCode, RuntimePresentationResult } from '../runtimes/types.js';\n6: \n7: /** Failures introduced while applying an already-decided presentation outcome. */\n8: export const ClientPresentationReasonCodes = {\n9:   DISPLAY_COMMIT_FAILED: 'display-commit-failed',\n10:   SIDECAR_COMMIT_FAILED: 'sidecar-commit-failed',\n11: } as const;\n12: \n13: /** Typed reason retained after a client applies or safely rejects an outcome. */\n14: export type ClientPresentationReasonCode =\n15:   | RuntimeAdapterReasonCode\n16:   | typeof ClientPresentationReasonCodes[keyof typeof ClientPresentationReasonCodes];\n17: \n18: /** Ownership required before a client may claim full-projection parity. */\n19: export interface ClientPresentationOwnership {\n20:   readonly ownsCompleteMessage: boolean;\n21:   readonly ownsAtomicRenderDecision: boolean;\n22: }\n23: \n24: /** Complete replacement passed to one client-owned display transaction. */\n25: export interface ClientCompleteMessageReplacement {\n26:   readonly messageId: string;\n27:   readonly projectionText: string;\n28: }\n29: \n30: /** Client-owned display operations that never receive canonical state. */\n31: export interface ClientDisplaySurface {\n32:   commitAtomicReplacement(replacement: ClientCompleteMessageReplacement): boolean;\n33:   appendAfterOriginal(replacement: ClientCompleteMessageReplacement): boolean;\n34: }\n35: \n36: /** Projection rendered outside the native message surface. */\n37: export interface ClientSidecarProjection {\n38:   readonly messageId: string;\n39:   readonly projectionText: string;\n40: }\n41: \n42: /** Separate view that cannot suppress or replace the native message. */\n43: export interface ClientSidecarSurface {\n44:   presentProjection(projection: ClientSidecarProjection): boolean;\n45: }\n46: \n47: /** Inputs shared by complete-message and sidecar clients. */\n48: export interface ClientPresentationInput {\n49:   readonly messageId: string;\n50:   readonly outcome: RuntimePresentationResult;\n51: }\n52: \n53: /** Input to a client-owned message display. */\n54: export interface ClientDisplayInput extends ClientPresentationInput {\n55:   readonly ownership: ClientPresentationOwnership;\n56:   readonly surface: ClientDisplaySurface;\n57: }\n58: \n59: /** Input to a separate projection view. */\n60: export interface ClientSidecarInput extends ClientPresentationInput {\n61:   readonly surface: ClientSidecarSurface;\n62: }\n63: \n64: /** Atomically committed complete-message projection. */\n65: export interface ClientProjectionApplication {\n66:   readonly clientContractVersion: 'client-presentation/1.0.0';\n67:   readonly status: 'projection';\n68:   readonly mode: 'atomic-replace';\n69:   readonly reasonCode: 'none';\n70:   readonly originalVisible: false;\n71:   readonly projectionVisible: true;\n72: }\n73: \n74: /** Projection displayed without changing the native original. */\n75: export interface ClientDegradedApplication {\n76:   readonly clientContractVersion: 'client-presentation/1.0.0';\n77:   readonly status: 'degraded';\n78:   readonly mode: 'append' | 'sidecar';\n79:   readonly reasonCode: 'atomic-replace-unavailable';\n80:   readonly originalVisible: true;\n81:   readonly projectionVisible: true;\n82: }\n83: \n84: /** No committed projection; the already-visible original remains authoritative. */\n85: export interface ClientOriginalOnlyApplication {\n86:   readonly clientContractVersion: 'client-presentation/1.0.0';\n87:   readonly status: 'exact-original';\n88:   readonly mode: 'original-only';\n89:   readonly reasonCode: Exclude<ClientPresentationReasonCode, 'none'>;\n90:   readonly originalVisible: true;\n91:   readonly projectionVisible: false;\n92: }\n93: \n94: /** Result of applying one runtime presentation outcome to a client surface. */\n95: export type ClientPresentationApplication =\n96:   | ClientDegradedApplication\n97:   | ClientOriginalOnlyApplication\n98:   | ClientProjectionApplication;\n99: \n100: /** Confirm the only ownership combination eligible for full-projection parity. */\n101: export function canClaimFullProjectionParity(\n102:   ownership: ClientPresentationOwnership,\n103: ): boolean {\n104:   return ownership.ownsCompleteMessage && ownership.ownsAtomicRenderDecision;\n105: }\n\n(End of file - total 105 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Client Presentation Types\n// ───────────────────────────────────────────────────────────────────\n\nimport type { RuntimeAdapterReasonCode, RuntimePresentationResult } from '../runtimes/types.js';\n\n/** Failures introduced while applying an already-decided presentation outcome. */\nexport const ClientPresentationReasonCodes = {\n  DISPLAY_COMMIT_FAILED: 'display-commit-failed',\n  SIDECAR_COMMIT_FAILED: 'sidecar-commit-failed',\n} as const;\n\n/** Typed reason retained after a client applies or safely rejects an outcome. */\nexport type ClientPresentationReasonCode =\n  | RuntimeAdapterReasonCode\n  | typeof ClientPresentationReasonCodes[keyof typeof ClientPresentationReasonCodes];\n\n/** Ownership required before a client may claim full-projection parity. */\nexport interface ClientPresentationOwnership {\n  readonly ownsCompleteMessage: boolean;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0143-skilled-provider-adapters-privacy/packages/cli-communication-projection/src/clients/types.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Client Presentation Types\n// ───────────────────────────────────────────────────────────────────\n\nimport type { RuntimeAdapterReasonCode, RuntimePresentationResult } from '../runtimes/types.js';\n\n/** Failures introduced while applying an already-decided presentation outcome. */\nexport const ClientPresentationReasonCodes = {\n  DISPLAY_COMMIT_FAILED: 'display-commit-failed',\n  SIDECAR_COMMIT_FAILED: 'sidecar-commit-failed',\n} as const;\n\n/** Typed reason retained after a client applies or safely rejects an outcome. */\nexport type ClientPresentationReasonCode =\n  | RuntimeAdapterReasonCode\n  | typeof ClientPresentationReasonCodes[keyof typeof ClientPresentationReasonCodes];\n\n/** Ownership required before a client may claim full-projection parity. */\nexport interface ClientPresentationOwnership {\n  readonly ownsCompleteMessage: boolean;\n  readonly ownsAtomicRenderDecision: boolean;\n}\n\n/** Complete replacement passed to one client-owned display transaction. */\nexport interface ClientCompleteMessageReplacement {\n  readonly messageId: string;\n  readonly projectionText: string;\n}\n\n/** Client-owned display operations that never receive canonical state. */\nexport interface ClientDisplaySurface {\n  commitAtomicReplacement(replacement: ClientCompleteMessageReplacement): boolean;\n  appendAfterOriginal(replacement: ClientCompleteMessageReplacement): boolean;\n}\n\n/** Projection rendered outside the native message surface. */\nexport interface ClientSidecarProjection {\n  readonly messageId: string;\n  readonly projectionText: string;\n}\n\n/** Separate view that cannot suppress or replace the native message. */\nexport interface ClientSidecarSurface {\n  presentProjection(projection: ClientSidecarProjection): boolean;\n}\n\n/** Inputs shared by complete-message and sidecar clients. */\nexport interface ClientPresentationInput {\n  readonly messageId: string;\n  readonly outcome: RuntimePresentationResult;\n}\n\n/** Input to a client-owned message display. */\nexport interface ClientDisplayInput extends ClientPresentationInput {\n  readonly ownership: ClientPresentationOwnership;\n  readonly surface: ClientDisplaySurface;\n}\n\n/** Input to a separate projection view. */\nexport interface ClientSidecarInput extends ClientPresentationInput {\n  readonly surface: ClientSidecarSurface;\n}\n\n/** Atomically committed complete-message projection. */\nexport interface ClientProjectionApplication {\n  readonly clientContractVersion: 'client-presentation/1.0.0';\n  readonly status: 'projection';\n  readonly mode: 'atomic-replace';\n  readonly reasonCode: 'none';\n  readonly originalVisible: false;\n  readonly projectionVisible: true;\n}\n\n/** Projection displayed without changing the native original. */\nexport interface ClientDegradedApplication {\n  readonly clientContractVersion: 'client-presentation/1.0.0';\n  readonly status: 'degraded';\n  readonly mode: 'append' | 'sidecar';\n  readonly reasonCode: 'atomic-replace-unavailable';\n  readonly originalVisible: true;\n  readonly projectionVisible: true;\n}\n\n/** No committed projection; the already-visible original remains authoritative. */\nexport interface ClientOriginalOnlyApplication {\n  readonly clientContractVersion: 'client-presentation/1.0.0';\n  readonly status: 'exact-original';\n  readonly mode: 'original-only';\n  readonly reasonCode: Exclude<ClientPresentationReasonCode, 'none'>;\n  readonly originalVisible: true;\n  readonly projectionVisible: false;\n}\n\n/** Result of applying one runtime presentation outcome to a client surface. */\nexport type ClientPresentationApplication =\n  | ClientDegradedApplication\n  | ClientOriginalOnlyApplication\n  | ClientProjectionApplication;\n\n/** Confirm the only ownership combination eligible for full-projection parity. */\nexport function canClaimFullProjectionParity(\n  ownership: ClientPresentationOwnership,\n): boolean {\n  return ownership.ownsCompleteMessage && ownership.ownsAtomicRenderDecision;\n}","lineStart":1,"lineEnd":105,"totalLines":105,"truncated":false}},"title":"packages/cli-communication-projection/src/clients/types.ts","time":{"start":1786568995278,"end":1786568995283}},"id":"prt_ff7cf7049001ztTN6hqdDCPkM2","sessionID":"ses_00832c111ffe8md0OBtHNejm4h","messageID":"msg_ff7cf0d63001xLI5WZMiQTwR5S"}}
