jection replaces it.\n */\nfunction stateLogHasLedger(stateLogPath) {\n  try {\n    return fs.readdirSync(path.join(path.dirname(stateLogPath), 'deep-research-ledger', 'frames'))\n      .some((name) => name.endsWith('.frame'));\n  } catch {\n    return false;\n  }\n}\n\nfunction ledgerScopeId(sessionId, stateLogPath) {\n  return typeof sessionId === 'string' && LEDGER_SCOPE_TOKEN.test(sessionId)\n    ? sessionId\n    : path.basename(path.dirname(stateLogPath));\n}\n\nfunction appendThroughGateway(stateLogPath, event) {\n  const eventDir = fs.mkdtempSync(path.join(os.tmpdir(), 'deep-research-reducer-event-'));\n  const eventPath = path.join(eventDir, 'event.json');\n  try {\n    fs.writeFileSync(eventPath, JSON.stringify(event), 'utf8');\n    const result = spawnSync(process.execPath, [\n=== args\n3262:  const fanoutResourceMapOnly = args.includes('--fanout-resource-map-only');\n3263:  const emitResourceMapOutput = args.includes('--emit-resource-map') || fanoutResourceMapOnly;\n3265:  const artifactDirFlagIndex = args.indexOf('--artifact-dir');\n3269:    process.stderr.write('[deep-research] --artifact-dir requires a path value\\n');\n3278:      'Usage: node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--emit-resource-map]\\n',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/MEGA/Development/Code_Environment/Public && sed -n '1,60p' .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs; echo \\\"=== args\\\"; grep -n \\\"artifact-dir\\\\|parseArgs\\\\|--emit-resource-map\\\\|fanout-resource-map-only\\\" .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs | head -30\"}"},"time":{"start":1793089156764,"end":1793089157053}}}}
