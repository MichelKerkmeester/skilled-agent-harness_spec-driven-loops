{"type":"tool_use","timestamp":1793094376730,"sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","part":{"partID":"prt_17cc0dbc900191iNky0acMh52L","sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","messageID":"msg_17cc0d1f2001axCR8fQKzzs013","type":"tool","id":"call_03bbf1043c5c8138ede6bb3d","tool":"read","state":{"status":"completed","input":{"limit":700,"offset":1451,"path":".skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 1451-2150\n1451:           wait_for_completion: true\n1452:           notes:\n1453:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1454:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1455:         if_cli_pi:\n1456:           command: |\n1457:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1458:             import { readFileSync } from 'node:fs';\n1459:             import { createRequire } from 'node:module';\n1460:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1461:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1462:             import {\n1463:               snapshotOutOfScopeDirtyPaths,\n1464:               enforceWriteContainment,\n1465:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1466: \n1467:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1468:             // without this they silently degrade to native. The command builder is the\n1469:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1470:             // headless write-mode flags, and binary preflight stay one source of truth.\n1471:             // It throws (fail closed) when the binary is absent or the model is off the\n1472:             // allowlist, so a requested CLI executor never becomes native.\n1473:             const require = createRequire(import.meta.url);\n1474:             const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1475: \n1476:             const kind = '{config.executor.type}';\n1477:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1478:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1479:             // The iteration must write its own iteration file, delta and state record,\n1480:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1481:             // write-permitting headless flags.\n1482:             const sandboxMode = 'workspace-write';\n1483:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1484:             const lineage = { kind, model, sandboxMode, reasoningEffort };\n1485:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1486:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1487: \n1488:             const repoRoot = '{repo_root}';\n1489:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1490:             const { command, args, input } = buildLineageCommand(\n1491:               lineage,\n1492:               promptBody,\n1493:               resolvedSandbox,\n1494:               resolvedPermission,\n1495:               { env: process.env, cwd: repoRoot },\n1496:             );\n1497: \n1498:             const executor = {\n1499:               kind,\n1500:               model,\n1501:               configDir: null,\n1502:               reasoningEffort,\n1503:               serviceTier: null,\n1504:               sandboxMode,\n1505:               timeoutSeconds,\n1506:               governor: null,\n1507:             };\n1508:             const dispatchId = 'research-i{current_iteration}-g{generation}';\n1509:             const artifactDir = '{artifact_dir}';\n1510:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1511:             const dispatchExit = runAuditedExecutorCommand({\n1512:               command,\n1513:               args,\n1514:               cwd: repoRoot,\n1515:               timeoutSeconds,\n1516:               stateLogPath: '{state_paths.state_log}',\n1517:               executor,\n1518:               iteration: Number('{current_iteration}'),\n1519:               input,\n1520:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1521:               dispatchId,\n1522:             });\n1523:             const containment = enforceWriteContainment({\n1524:               repoRoot,\n1525:               artifactDir,\n1526:               preDispatchDirtyPaths,\n1527:               stateLogPath: '{state_paths.state_log}',\n1528:               iteration: Number('{current_iteration}'),\n1529:               label: dispatchId,\n1530:             });\n1531:             if (containment.violations.length > 0) {\n1532:               console.error(\n1533:                 'write-containment advisory: detected ' + containment.violations.length\n1534:                   + ' out-of-scope path(s), left on disk: '\n1535:                   + containment.violations.map((v) => v.path).join(', '),\n1536:               );\n1537:             }\n1538:             process.exit(dispatchExit);\n1539:             EOF\n1540:           working_directory: \"{repo_root}\"\n1541:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1542:           wait_for_completion: true\n1543:           notes:\n1544:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1545:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1546:             - \"cli-hermes single-executor: the same shared builder emits `hermes chat -Q --oneshot --query-file -` with the prompt on stdin, the two-id llmgateway roster and the max reasoning pin; fails closed when hermes is absent or the model is off the roster\"\n1547:         record_executor_audit:\n1548:           skip_when: \"config.executor.type == 'native'\"\n1549:           target: \"{state_paths.state_log}\"\n1550:           field: \"executor\"\n1551:           value:\n1552:             kind: \"{config.executor.type}\"\n1553:             model: \"{config.executor.model}\"\n1554:             reasoningEffort: \"{config.executor.reasoningEffort}\"\n1555:             serviceTier: \"{config.executor.serviceTier}\"\n1556:         if_cli_opencode:\n1557:           command: |\n1558:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1559:             import { readFileSync } from 'node:fs';\n1560:             import { createHash } from 'node:crypto';\n1561: \n1562:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1563: \n1564:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1565:             const executor = {\n1566:               kind: 'cli-opencode',\n1567:               model: '{config.executor.model}',\n1568:               configDir: null,\n1569:               reasoningEffort,\n1570:               serviceTier: null,\n1571:               sandboxMode: null,\n1572:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1573:               governor: null,\n1574:             };\n1575:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1576:             const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1577:               + '\\n\\n'\n1578:               + promptBody;\n1579:             const args = [\n1580:               'run',\n1581:               '--model',\n1582:               executor.model,\n1583:               '--format',\n1584:               'json',\n1585:               '--dangerously-skip-permissions',\n1586:               '--pure',\n1587:               '--dir',\n1588:               '{repo_root}',\n1589:             ];\n1590:             if (executor.reasoningEffort) {\n1591:               args.push('--variant', executor.reasoningEffort);\n1592:             }\n1593:             args.push(message);\n1594: \n1595:             const dispatchFacts = {\n1596:               command: 'deep/research',\n1597:               mode: 'research',\n1598:               specFolder: '{spec_folder}',\n1599:               artifactDir: '{state_paths.packet_dir}',\n1600:               iteration: Number('{current_iteration}'),\n1601:               executorKind: '{config.executor.type}',\n1602:               branchId: '{config.executor.type}',\n1603:               sessionId: '{config.lineage.sessionId}',\n1604:               generation: Number('{config.lineage.generation}'),\n1605:             };\n1606:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1607:             process.exit(\n1608:               runAuditedExecutorCommand({\n1609:                 command: 'opencode',\n1610:                 args,\n1611:                 cwd: '{repo_root}',\n1612:                 timeoutSeconds: executor.timeoutSeconds,\n1613:                 stateLogPath: '{state_paths.state_log}',\n1614:                 executor,\n1615:                 iteration: Number('{current_iteration}'),\n1616:                 // opencode v1.14.39 reads stdin at startup before session creation;\n1617:                 // an empty input gives EOF stdin, equivalent to </dev/null.\n1618:                 input: '',\n1619:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1620:                 dispatchId,\n1621:               }),\n1622:             );\n1623:             EOF\n1624:           working_directory: \"{repo_root}\"\n1625:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1626:           wait_for_completion: true\n1627:           notes:\n1628:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1629:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n1630:             - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n1631:             - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n1632:             - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n1633:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1634:         if_cli_codex:\n1635:           command: |\n1636:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1637:             import { readFileSync } from 'node:fs';\n1638:             import { execFileSync } from 'node:child_process';\n1639: \n1640:             import {\n1641:               RECURSION_GUARD_EXIT_CODE,\n1642:               formatRecursionGuardRefusal,\n1643:               runAuditedExecutorCommand,\n1644:               validateExecutorDispatchAllowed,\n1645:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1646:             import {\n1647:               snapshotOutOfScopeDirtyPaths,\n1648:               enforceWriteContainment,\n1649:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1650: \n1651:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1652:             // never silently degrade to another executor. Undetected absence is what\n1653:             // got Codex deprecated before, so the branch exits non-zero when the\n1654:             // binary is missing instead of falling through to a native/other path.\n1655:             let codexAvailable = false;\n1656:             try {\n1657:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1658:               codexAvailable = true;\n1659:             } catch {}\n1660:             if (!codexAvailable) {\n1661:               console.error('cli-codex executor unavailable: command -v codex failed');\n1662:               process.exit(1);\n1663:             }\n1664: \n1665:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1666:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1667:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1668:             const executor = {\n1669:               kind: 'cli-codex',\n1670:               model,\n1671:               configDir: null,\n1672:               reasoningEffort,\n1673:               serviceTier,\n1674:               sandboxMode: 'workspace-write',\n1675:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1676:               governor: null,\n1677:             };\n1678: \n1679:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1680:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1681:             // or a codex session must run the iteration itself, not delegate it onward.\n1682:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1683:             if (!guardVerdict.allowed) {\n1684:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1685:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1686:             }\n1687: \n1688:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1689: \n1690:             // codex reads the iteration prompt from stdin via the trailing '-'. A research\n1691:             // iteration must WRITE its own iteration file, delta and state record, so the\n1692:             // sandbox is workspace-write — read-only would block those required writes.\n1693:             // approval_policy=never keeps the run non-interactive.\n1694:             const args = ['exec'];\n1695:             if (model) {\n1696:               args.push('--model', model);\n1697:             }\n1698:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1699:             if (serviceTier) {\n1700:               args.push('-c', 'service_tier=' + serviceTier);\n1701:             }\n1702:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1703: \n1704:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1705:             const repoRoot = '{repo_root}';\n1706:             const artifactDir = '{artifact_dir}';\n1707:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1708:             const dispatchExit = runAuditedExecutorCommand({\n1709:               command: 'codex',\n1710:               args,\n1711:               cwd: repoRoot,\n1712:               timeoutSeconds: executor.timeoutSeconds,\n1713:               stateLogPath: '{state_paths.state_log}',\n1714:               executor,\n1715:               iteration: Number('{current_iteration}'),\n1716:               input: promptBody,\n1717:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1718:               dispatchId,\n1719:             });\n1720:             // Structural write-containment: the artifact-dir boundary is prompt-only, so a\n1721:             // workspace-write leaf can write anywhere in the repo. The guard diffs the tree\n1722:             // after the dispatch and reports every NEW out-of-artifact-dir path. Its remedy\n1723:             // PRESERVES by default -- event recorded, copy quarantined, bytes left on disk --\n1724:             // because a path it cannot attribute may belong to a concurrent writer, so a\n1725:             // revert here would destroy work this lane never wrote; reverting is opt-in per\n1726:             // run and is not implied by this call. Remedy authority, both modes:\n1727:             // runtime/lib/deep-loop/write-containment.ts. A violation is reported below and\n1728:             // left on disk, never made fatal here: what the run does about it is the\n1729:             // verdict's to decide. The leaf's own writes under artifactDir (iteration\n1730:             // file/delta/state record) are never flagged.\n1731:             const containment = enforceWriteContainment({\n1732:               repoRoot,\n1733:               artifactDir,\n1734:               preDispatchDirtyPaths,\n1735:               stateLogPath: '{state_paths.state_log}',\n1736:               iteration: Number('{current_iteration}'),\n1737:               label: dispatchId,\n1738:             });\n1739:             if (containment.violations.length > 0) {\n1740:               console.error(\n1741:                 'write-containment advisory: detected ' + containment.violations.length\n1742:                   + ' out-of-scope path(s), left on disk: '\n1743:                   + containment.violations.map((v) => v.path).join(', '),\n1744:               );\n1745:             }\n1746:             process.exit(dispatchExit);\n1747:             EOF\n1748:           working_directory: \"{repo_root}\"\n1749:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1750:           wait_for_completion: true\n1751:           notes:\n1752:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1753:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1754:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1755:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1756:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1757:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1758:         post_dispatch_validate:\n1759:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1760:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1761:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1762:           assert_exists: \"{state_paths.iteration_pattern}\"\n1763:           assert_appended: \"{state_paths.state_log}\"\n1764:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1765:           route_proof:\n1766:             mode: research\n1767:             target_agent: deep-research\n1768:             agent_definition_loaded: true\n1769:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1770:           dispatchReceipt:\n1771:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1772:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1773:           optional_jsonl_fields:\n1774:             logOffset: \"Byte offset where the seekable log region starts\"\n1775:             logSize: \"Byte length of the seekable log region\"\n1776:             logPath: \"Absolute path to the file containing the seekable log region\"\n1777:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1778:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1779:           assert_canonical_type: \"iteration\"\n1780:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1781:           assert_delta_file_has_iteration_record: true\n1782:           on_failure:\n1783:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1784:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1785:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1786:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n1787:           failure_reasons_reference:\n1788:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1789:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1790:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1791:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1792:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1793:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1794:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1795:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1796:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1797:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1798:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1799:             - \"executor_missing — non-native executor did not record provenance\"\n1800:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1801: \n1802:       step_run_now_restore_check:\n1803:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1804:         command: |\n1805:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1806:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1807:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n1808:           node - \"$EVENT_DIR\" <<'EOF'\n1809:           const { existsSync, readFileSync, writeFileSync } = require('node:fs');\n1810:           const { join } = require('node:path');\n1811: \n1812:           const eventDir = process.argv[2];\n1813:           const stateLogPath = \"{state_paths.state_log}\";\n1814:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n1815:           const sessionId = \"{config.lineage.sessionId}\";\n1816:           const generation = Number(\"{config.lineage.generation}\");\n1817:           const run = Number(\"{current_iteration}\");\n1818: \n1819:           function hasAcceptedCurrentRun() {\n1820:             if (!existsSync(stateLogPath)) return false;\n1821:             const lines = readFileSync(stateLogPath, \"utf8\").trim().split(/\\r?\\n/).filter(Boolean);\n1822:             for (let index = lines.length - 1; index >= 0; index -= 1) {\n1823:               const record = JSON.parse(lines[index]);\n1824:               if (record.run !== run || record.sessionId !== sessionId) continue;\n1825:               if (record.event === \"run_now_accepted\") return true;\n1826:               if (record.event === \"run_now_rejected\") return false;\n1827:             }\n1828:             return false;\n1829:           }\n1830: \n1831:           if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {\n1832:             // The restored-sentinel row is staged for the gateway: the projection is\n1833:             // rebuilt from the ledger, so appending beside it loses the row.\n1834:             writeFileSync(\n1835:               join(eventDir, \"01-run_now_restored.json\"),\n1836:               JSON.stringify({\n1837:                 stem: \"deep_research.run_now_restored\",\n1838:                 scope: { runId: sessionId, lineageId: sessionId },\n1839:                 data: { mode: \"research\", run, sessionId, generation, sentinelPath },\n1840:               }),\n1841:               \"utf8\",\n1842:             );\n1843:           }\n1844:           EOF\n1845:           for eventFile in \"$EVENT_DIR\"/*.json; do\n1846:             [ -e \"$eventFile\" ] || continue\n1847:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1848:             GATEWAY_STATUS=$?\n1849:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1850:               rm -rf \"$EVENT_DIR\"\n1851:               exit \"$GATEWAY_STATUS\"\n1852:             fi\n1853:           done\n1854:           rm -rf \"$EVENT_DIR\"\n1855:         outputs:\n1856:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1857: \n1858:       step_reduce_state:\n1859:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1860:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1861:         inputs:\n1862:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1863:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1864:           priorReducedState: \"{state_paths.registry}\"\n1865:         outputs:\n1866:           - \"{state_paths.registry}\"\n1867:           - \"{state_paths.dashboard}\"\n1868:           - \"{state_paths.strategy}\"\n1869:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1870:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1871:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1872:         failure_modes:\n1873:           malformed_delta: \"skip + warn\"\n1874:           missing_iteration_file: \"no-op + error\"\n1875:           schema_mismatch: \"reject + conflict event\"\n1876:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1877:         guarantee: \"Idempotent for identical inputs\"\n1878: \n1879:       step_graph_upsert:\n1880:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1881:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1882:         command: |\n1883:           node <<'EOF'\n1884:           const { existsSync, readFileSync } = require('node:fs');\n1885:           const { join } = require('node:path');\n1886:           const { spawnSync } = require('node:child_process');\n1887: \n1888:           const deltaDir = '{state_paths.delta_dir}';\n1889:           const stateLogPath = '{state_paths.state_log}';\n1890:           const iteration = Number('{current_iteration}');\n1891:           const specFolder = '{spec_folder}';\n1892:           const sessionId = '{config.lineage.sessionId}';\n1893: \n1894:           function parseJsonLines(raw, source) {\n1895:             const records = [];\n1896:             for (const line of raw.split(/\\r?\\n/)) {\n1897:               const trimmed = line.trim();\n1898:               if (!trimmed) continue;\n1899:               try {\n1900:                 records.push(JSON.parse(trimmed));\n1901:               } catch (error) {\n1902:                 process.stderr.write(`deep-research graph upsert: skipped malformed line in ${source}: ${error.message}\\n`);\n1903:               }\n1904:             }\n1905:             return records;\n1906:           }\n1907: \n1908:           function latestGraphEvents(records) {\n1909:             for (let index = records.length - 1; index >= 0; index -= 1) {\n1910:               const record = records[index];\n1911:               if (record && record.type === 'iteration') {\n1912:                 return Array.isArray(record.graphEvents) ? record.graphEvents : [];\n1913:               }\n1914:             }\n1915:             return [];\n1916:           }\n1917: \n1918:           const deltaPath = join(deltaDir, `iter-${String(iteration).padStart(3, '0')}.jsonl`);\n1919:           const sourcePath = existsSync(deltaPath) ? deltaPath : stateLogPath;\n1920:           const records = existsSync(sourcePath) ? parseJsonLines(readFileSync(sourcePath, 'utf8'), sourcePath) : [];\n1921:           const events = latestGraphEvents(records);\n1922: \n1923:           const nodes = [];\n1924:           const edges = [];\n1925:           for (const event of events) {\n1926:             if (!event || typeof event !== 'object') continue;\n1927:             if (event.type === 'node') {\n1928:               nodes.push({ ...event, name: event.label ?? event.name ?? event.id });\n1929:             } else if (event.type === 'edge') {\n1930:               edges.push({\n1931:                 ...event,\n1932:                 sourceId: event.sourceId ?? event.source,\n1933:                 targetId: event.targetId ?? event.target,\n1934:                 relation: String(event.relation ?? '').toUpperCase(),\n1935:               });\n1936:             }\n1937:           }\n1938: \n1939:           if (nodes.length === 0 && edges.length === 0) {\n1940:             process.stdout.write(`deep-research graph upsert: no graph events for iteration ${iteration}; skipping\\n`);\n1941:             process.exit(0);\n1942:           }\n1943: \n1944:           const upsert = spawnSync(\n1945:             process.execPath,\n1946:             [\n1947:               '.skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs',\n1948:               '--spec-folder', specFolder,\n1949:               '--loop-type', 'research',\n1950:               '--session-id', sessionId,\n1951:               '--nodes', JSON.stringify(nodes),\n1952:               '--edges', JSON.stringify(edges),\n1953:             ],\n1954:             { encoding: 'utf8' },\n1955:           );\n1956:           if (upsert.error) {\n1957:             process.stderr.write(`deep-research graph upsert: failed to spawn upsert.cjs: ${upsert.error.message}\\n`);\n1958:           }\n1959:           if (upsert.stdout) process.stdout.write(upsert.stdout);\n1960:           if (upsert.stderr) process.stderr.write(upsert.stderr);\n1961:           process.exit(upsert.status === null ? 1 : upsert.status);\n1962:           EOF\n1963: \n1964:       step_refresh_lineage_context:\n1965:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1966:         read:\n1967:           - \"{state_paths.dashboard}\"\n1968:           - \"{state_paths.registry}\"\n1969:           - \"{state_paths.strategy}\"\n1970:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1971:         use_response:\n1972:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1973:         failure_policy:\n1974:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1975:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1976:         outputs:\n1977:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n1978:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1979: \n1980:       step_evaluate_results:\n1981:         action: \"Verify iteration outputs and extract metrics\"\n1982:         verify:\n1983:           - file_exists: \"{state_paths.iteration_pattern}\"\n1984:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1985:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1986:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1987:         extract:\n1988:           - newInfoRatio: \"From latest JSONL iteration record\"\n1989:           - findings_count: \"From latest JSONL iteration record\"\n1990:           - status: \"From latest JSONL iteration record\"\n1991:           - latest_focus: \"From latest JSONL iteration record\"\n1992:         on_missing_outputs:\n1993:           action: \"Mark iteration as 'error', continue to next\"\n1994:           # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n1995:           # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1996:           append_jsonl: '{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1997: \n1998:       step_telemetry_heartbeat_progress:\n1999:         action: \"Emit a single-loop progress row when iteration state changes\"\n2000:         skip_when: \"config.fanout is present\"\n2001:         command: |\n2002:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2003:           import { existsSync, readFileSync } from 'node:fs';\n2004: \n2005:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2006:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2007: \n2008:           const { appendObservabilityEvent } = observabilityEvents;\n2009:           const stateLogPath = '{state_paths.state_log}';\n2010:           const timestamp = '{ISO_8601_NOW}';\n2011:           const sessionId = '{config.lineage.sessionId}';\n2012:           const generation = Number('{config.lineage.generation}');\n2013:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2014: \n2015:           function readRecords(path) {\n2016:             if (!existsSync(path)) return [];\n2017:             return readFileSync(path, 'utf8')\n2018:               .split(/\\r?\\n/)\n2019:               .map((line) => line.trim())\n2020:               .filter(Boolean)\n2021:               .map((line) => JSON.parse(line));\n2022:           }\n2023: \n2024:           function elapsedSince(value) {\n2025:             const startedAtMs = Date.parse(String(value ?? ''));\n2026:             const nowMs = Date.parse(timestamp);\n2027:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2028:             return Math.max(0, nowMs - startedAtMs);\n2029:           }\n2030: \n2031:           const records = readRecords(stateLogPath);\n2032:           const iterations = records.filter((record) => record.type === 'iteration');\n2033:           const latest = iterations.at(-1) ?? {};\n2034:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2035:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2036:             ?? timestamp;\n2037:           const elapsedMs = elapsedSince(startedAt);\n2038:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2039:           const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');\n2040:           const status = typeof latest.status === 'string' ? latest.status : 'unknown';\n2041:           const row = {\n2042:             event: 'progress',\n2043:             label: 'single',\n2044:             at: timestamp,\n2045:             duration_ms: elapsedMs,\n2046:             loop_type: 'research',\n2047:             sessionId,\n2048:             generation,\n2049:             run,\n2050:             status,\n2051:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2052:           };\n2053: \n2054:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2055:             diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },\n2056:             diffField: 'state_hash',\n2057:           });\n2058:           if (appended) {\n2059:             try {\n2060:               appendObservabilityEvent(observabilityPath, row, {\n2061:                 producer: 'deep-research-auto',\n2062:                 stream: 'single-loop-telemetry',\n2063:                 subject: { label: row.label, sessionId, generation, run },\n2064:                 event: row.event,\n2065:                 status,\n2066:               });\n2067:             } catch {}\n2068:           }\n2069:           EOF\n2070:         working_directory: \"{repo_root}\"\n2071:         outputs:\n2072:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n2073: \n2074:       step_generate_dashboard:\n2075:         action: \"Generate or refresh the human-readable dashboard\"\n2076:         read:\n2077:           - \"{state_paths.state_log}\"\n2078:           - \"{state_paths.registry}\"\n2079:           - \"{state_paths.strategy}\"\n2080:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md\n2081:         output: \"{state_paths.dashboard}\"\n2082:         note: \"Auto-generated from JSONL + reducer registry + strategy. Never manually edited.\"\n2083: \n2084:       step_update_tracking:\n2085:         action: \"Update loop tracking variables\"\n2086:         set:\n2087:           current_iteration: \"{current_iteration + 1}\"\n2088:           stuck_count: \"if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0\"\n2089:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}.\"\n2090: \n2091:       step_loop_decision:\n2092:         action: \"Return to step_read_state for next iteration\"\n2093:         goto: step_read_state\n2094: \n2095:   # ═══════════════════════════════════════════════════════════════\n2096:   # PHASE 3: SYNTHESIS\n2097:   # ═══════════════════════════════════════════════════════════════\n2098:   phase_synthesis:\n2099:     purpose: Compile all iteration findings into final research/research.md\n2100:     steps:\n2101: \n2102:       step_fanout_merge:\n2103:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n2104:         skip_when: \"config.fanout is absent\"\n2105:         command: |\n2106:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n2107:             --loop-type research \\\n2108:             --artifact-dir {artifact_dir}\n2109:         working_directory: \"{repo_root}\"\n2110:         wait_for_completion: true\n2111: \n2112:       step_hydrate_summary_metrics:\n2113:         action: \"Hydrate summary metrics before synthesis\"\n2114:         read:\n2115:           - \"{state_paths.config}\"\n2116:           - \"{state_paths.state_log}\"\n2117:           - \"{state_paths.registry}\"\n2118:           - \"{state_paths.strategy}\"\n2119:         read_patterns:\n2120:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n2121:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n2122:         extract:\n2123:           - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n2124:           - current_iteration: \"iteration_count + 1\"\n2125:           - current_segment: \"Latest segment_start event segment, else 1\"\n2126:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n2127:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n2128:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n2129:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n2130:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n2131:           - answered_count: \"Count answered questions from strategy.md\"\n2132:           - total_questions: \"Count total questions tracked in strategy.md\"\n2133:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n2134:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n2135:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n2136: \n2137:       step_read_all_iterations:\n2138:         action: \"Read all iteration files and strategy\"\n2139:         read_patterns:\n2140:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n2141:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n2142:         read_also: \"{state_paths.strategy}\"\n2143:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n2144:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n2145: \n2146:       step_emit_resource_map:\n2147:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n2148:         branch_on: \"config.fanout\"\n2149:         if_present:\n2150:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n[Output truncated. Continue reading with offset: 2151]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 1451-2150\n1451:           wait_for_completion: true\n1452:           notes:\n1453:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1454:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1455:         if_cli_pi:\n1456:           command: |\n1457:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1458:             import { readFileSync } from 'node:fs';\n1459:             import { createRequire } from 'node:module';\n1460:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1461:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1462:             import {\n1463:               snapshotOutOfScopeDirtyPaths,\n1464:               enforceWriteContainment,\n1465:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1466: \n1467:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1468:             // without this they silently degrade to native. The command builder is the\n1469:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1470:             // headless write-mode flags, and binary preflight stay one source of truth.\n1471:             // It throws (fail closed) when the binary is absent or the model is off the\n1472:             // allowlist, so a requested CLI executor never becomes native.\n1473:             const require = createRequire(import.meta.url);\n1474:             const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1475: \n1476:             const kind = '{config.executor.type}';\n1477:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1478:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1479:             // The iteration must write its own iteration file, delta and state record,\n1480:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1481:             // write-permitting headless flags.\n1482:             const sandboxMode = 'workspace-write';\n1483:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1484:             const lineage = { kind, model, sandboxMode, reasoningEffort };\n1485:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1486:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1487: \n1488:             const repoRoot = '{repo_root}';\n1489:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1490:             const { command, args, input } = buildLineageCommand(\n1491:               lineage,\n1492:               promptBody,\n1493:               resolvedSandbox,\n1494:               resolvedPermission,\n1495:               { env: process.env, cwd: repoRoot },\n1496:             );\n1497: \n1498:             const executor = {\n1499:               kind,\n1500:               model,\n1501:               configDir: null,\n1502:               reasoningEffort,\n1503:               serviceTier: null,\n1504:               sandboxMode,\n1505:               timeoutSeconds,\n1506:               governor: null,\n1507:             };\n1508:             const dispatchId = 'research-i{current_iteration}-g{generation}';\n1509:             const artifactDir = '{artifact_dir}';\n1510:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1511:             const dispatchExit = runAuditedExecutorCommand({\n1512:               command,\n1513:               args,\n1514:               cwd: repoRoot,\n1515:               timeoutSeconds,\n1516:               stateLogPath: '{state_paths.state_log}',\n1517:               executor,\n1518:               iteration: Number('{current_iteration}'),\n1519:               input,\n1520:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1521:               dispatchId,\n1522:             });\n1523:             const containment = enforceWriteContainment({\n1524:               repoRoot,\n1525:               artifactDir,\n1526:               preDispatchDirtyPaths,\n1527:               stateLogPath: '{state_paths.state_log}',\n1528:               iteration: Number('{current_iteration}'),\n1529:               label: dispatchId,\n1530:             });\n1531:             if (containment.violations.length > 0) {\n1532:               console.error(\n1533:                 'write-containment advisory: detected ' + containment.violations.length\n1534:                   + ' out-of-scope path(s), left on disk: '\n1535:                   + containment.violations.map((v) => v.path).join(', '),\n1536:               );\n1537:             }\n1538:             process.exit(dispatchExit);\n1539:             EOF\n1540:           working_directory: \"{repo_root}\"\n1541:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1542:           wait_for_completion: true\n1543:           notes:\n1544:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1545:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1546:             - \"cli-hermes single-executor: the same shared builder emits `hermes chat -Q --oneshot --query-file -` with the prompt on stdin, the two-id llmgateway roster and the max reasoning pin; fails closed when hermes is absent or the model is off the roster\"\n1547:         record_executor_audit:\n1548:           skip_when: \"config.executor.type == 'native'\"\n1549:           target: \"{state_paths.state_log}\"\n1550:           field: \"executor\"\n1551:           value:\n1552:             kind: \"{config.executor.type}\"\n1553:             model: \"{config.executor.model}\"\n1554:             reasoningEffort: \"{config.executor.reasoningEffort}\"\n1555:             serviceTier: \"{config.executor.serviceTier}\"\n1556:         if_cli_opencode:\n1557:           command: |\n1558:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1559:             import { readFileSync } from 'node:fs';\n1560:             import { createHash } from 'node:crypto';\n1561: \n1562:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1563: \n1564:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1565:             const executor = {\n1566:               kind: 'cli-opencode',\n1567:               model: '{config.executor.model}',\n1568:               configDir: null,\n1569:               reasoningEffort,\n1570:               serviceTier: null,\n1571:               sandboxMode: null,\n1572:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1573:               governor: null,\n1574:             };\n1575:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1576:             const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1577:               + '\\n\\n'\n1578:               + promptBody;\n1579:             const args = [\n1580:               'run',\n1581:               '--model',\n1582:               executor.model,\n1583:               '--format',\n1584:               'json',\n1585:               '--dangerously-skip-permissions',\n1586:               '--pure',\n1587:               '--dir',\n1588:               '{repo_root}',\n1589:             ];\n1590:             if (executor.reasoningEffort) {\n1591:               args.push('--variant', executor.reasoningEffort);\n1592:             }\n1593:             args.push(message);\n1594: \n1595:             const dispatchFacts = {\n1596:               command: 'deep/research',\n1597:               mode: 'research',\n1598:               specFolder: '{spec_folder}',\n1599:               artifactDir: '{state_paths.packet_dir}',\n1600:               iteration: Number('{current_iteration}'),\n1601:               executorKind: '{config.executor.type}',\n1602:               branchId: '{config.executor.type}',\n1603:               sessionId: '{config.lineage.sessionId}',\n1604:               generation: Number('{config.lineage.generation}'),\n1605:             };\n1606:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1607:             process.exit(\n1608:               runAuditedExecutorCommand({\n1609:                 command: 'opencode',\n1610:                 args,\n1611:                 cwd: '{repo_root}',\n1612:                 timeoutSeconds: executor.timeoutSeconds,\n1613:                 stateLogPath: '{state_paths.state_log}',\n1614:                 executor,\n1615:                 iteration: Number('{current_iteration}'),\n1616:                 // opencode v1.14.39 reads stdin at startup before session creation;\n1617:                 // an empty input gives EOF stdin, equivalent to </dev/null.\n1618:                 input: '',\n1619:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1620:                 dispatchId,\n1621:               }),\n1622:             );\n1623:             EOF\n1624:           working_directory: \"{repo_root}\"\n1625:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1626:           wait_for_completion: true\n1627:           notes:\n1628:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1629:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n1630:             - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n1631:             - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n1632:             - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n1633:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1634:         if_cli_codex:\n1635:           command: |\n1636:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1637:             import { readFileSync } from 'node:fs';\n1638:             import { execFileSync } from 'node:child_process';\n1639: \n1640:             import {\n1641:               RECURSION_GUARD_EXIT_CODE,\n1642:               formatRecursionGuardRefusal,\n1643:               runAuditedExecutorCommand,\n1644:               validateExecutorDispatchAllowed,\n1645:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1646:             import {\n1647:               snapshotOutOfScopeDirtyPaths,\n1648:               enforceWriteContainment,\n1649:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1650: \n1651:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1652:             // never silently degrade to another executor. Undetected absence is what\n1653:             // got Codex deprecated before, so the branch exits non-zero when the\n1654:             // binary is missing instead of falling through to a native/other path.\n1655:             let codexAvailable = false;\n1656:             try {\n1657:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1658:               codexAvailable = true;\n1659:             } catch {}\n1660:             if (!codexAvailable) {\n1661:               console.error('cli-codex executor unavailable: command -v codex failed');\n1662:               process.exit(1);\n1663:             }\n1664: \n1665:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1666:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1667:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1668:             const executor = {\n1669:               kind: 'cli-codex',\n1670:               model,\n1671:               configDir: null,\n1672:               reasoningEffort,\n1673:               serviceTier,\n1674:               sandboxMode: 'workspace-write',\n1675:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1676:               governor: null,\n1677:             };\n1678: \n1679:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1680:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1681:             // or a codex session must run the iteration itself, not delegate it onward.\n1682:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1683:             if (!guardVerdict.allowed) {\n1684:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1685:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1686:             }\n1687: \n1688:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1689: \n1690:             // codex reads the iteration prompt from stdin via the trailing '-'. A research\n1691:             // iteration must WRITE its own iteration file, delta and state record, so the\n1692:             // sandbox is workspace-write — read-only would block those required writes.\n1693:             // approval_policy=never keeps the run non-interactive.\n1694:             const args = ['exec'];\n1695:             if (model) {\n1696:               args.push('--model', model);\n1697:             }\n1698:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1699:             if (serviceTier) {\n1700:               args.push('-c', 'service_tier=' + serviceTier);\n1701:             }\n1702:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1703: \n1704:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1705:             const repoRoot = '{repo_root}';\n1706:             const artifactDir = '{artifact_dir}';\n1707:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1708:             const dispatchExit = runAuditedExecutorCommand({\n1709:               command: 'codex',\n1710:               args,\n1711:               cwd: repoRoot,\n1712:               timeoutSeconds: executor.timeoutSeconds,\n1713:               stateLogPath: '{state_paths.state_log}',\n1714:               executor,\n1715:               iteration: Number('{current_iteration}'),\n1716:               input: promptBody,\n1717:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1718:               dispatchId,\n1719:             });\n1720:             // Structural write-containment: the artifact-dir boundary is prompt-only, so a\n1721:             // workspace-write leaf can write anywhere in the repo. The guard diffs the tree\n1722:             // after the dispatch and reports every NEW out-of-artifact-dir path. Its remedy\n1723:             // PRESERVES by default -- event recorded, copy quarantined, bytes left on disk --\n1724:             // because a path it cannot attribute may belong to a concurrent writer, so a\n1725:             // revert here would destroy work this lane never wrote; reverting is opt-in per\n1726:             // run and is not implied by this call. Remedy authority, both modes:\n1727:             // runtime/lib/deep-loop/write-containment.ts. A violation is reported below and\n1728:             // left on disk, never made fatal here: what the run does about it is the\n1729:             // verdict's to decide. The leaf's own writes under artifactDir (iteration\n1730:             // file/delta/state record) are never flagged.\n1731:             const containment = enforceWriteContainment({\n1732:               repoRoot,\n1733:               artifactDir,\n1734:               preDispatchDirtyPaths,\n1735:               stateLogPath: '{state_paths.state_log}',\n1736:               iteration: Number('{current_iteration}'),\n1737:               label: dispatchId,\n1738:             });\n1739:             if (containment.violations.length > 0) {\n1740:               console.error(\n1741:                 'write-containment advisory: detected ' + containment.violations.length\n1742:                   + ' out-of-scope path(s), left on disk: '\n1743:                   + containment.violations.map((v) => v.path).join(', '),\n1744:               );\n1745:             }\n1746:             process.exit(dispatchExit);\n1747:             EOF\n1748:           working_directory: \"{repo_root}\"\n1749:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1750:           wait_for_completion: true\n1751:           notes:\n1752:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1753:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1754:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1755:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1756:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1757:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1758:         post_dispatch_validate:\n1759:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1760:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1761:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1762:           assert_exists: \"{state_paths.iteration_pattern}\"\n1763:           assert_appended: \"{state_paths.state_log}\"\n1764:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1765:           route_proof:\n1766:             mode: research\n1767:             target_agent: deep-research\n1768:             agent_definition_loaded: true\n1769:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1770:           dispatchReceipt:\n1771:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1772:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1773:           optional_jsonl_fields:\n1774:             logOffset: \"Byte offset where the seekable log region starts\"\n1775:             logSize: \"Byte length of the seekable log region\"\n1776:             logPath: \"Absolute path to the file containing the seekable log region\"\n1777:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1778:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1779:           assert_canonical_type: \"iteration\"\n1780:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1781:           assert_delta_file_has_iteration_record: true\n1782:           on_failure:\n1783:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1784:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1785:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1786:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n1787:           failure_reasons_reference:\n1788:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1789:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1790:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1791:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1792:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1793:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1794:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1795:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1796:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1797:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1798:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1799:             - \"executor_missing — non-native executor did not record provenance\"\n1800:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1801: \n1802:       step_run_now_restore_check:\n1803:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1804:         command: |\n1805:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1806:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1807:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n1808:           node - \"$EVENT_DIR\" <<'EOF'\n1809:           const { existsSync, readFileSync, writeFileSync } = require('node:fs');\n1810:           const { join } = require('node:path');\n1811: \n1812:           const eventDir = process.argv[2];\n1813:           const stateLogPath = \"{state_paths.state_log}\";\n1814:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n1815:           const sessionId = \"{config.lineage.sessionId}\";\n1816:           const generation = Number(\"{config.lineage.generation}\");\n1817:           const run = Number(\"{current_iteration}\");\n1818: \n1819:           function hasAcceptedCurrentRun() {\n1820:             if (!existsSync(stateLogPath)) return false;\n1821:             const lines = readFileSync(stateLogPath, \"utf8\").trim().split(/\\r?\\n/).filter(Boolean);\n1822:             for (let index = lines.length - 1; index >= 0; index -= 1) {\n1823:               const record = JSON.parse(lines[index]);\n1824:               if (record.run !== run || record.sessionId !== sessionId) continue;\n1825:               if (record.event === \"run_now_accepted\") return true;\n1826:               if (record.event === \"run_now_rejected\") return false;\n1827:             }\n1828:             return false;\n1829:           }\n1830: \n1831:           if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {\n1832:             // The restored-sentinel row is staged for the gateway: the projection is\n1833:             // rebuilt from the ledger, so appending beside it loses the row.\n1834:             writeFileSync(\n1835:               join(eventDir, \"01-run_now_restored.json\"),\n1836:               JSON.stringify({\n1837:                 stem: \"deep_research.run_now_restored\",\n1838:                 scope: { runId: sessionId, lineageId: sessionId },\n1839:                 data: { mode: \"research\", run, sessionId, generation, sentinelPath },\n1840:               }),\n1841:               \"utf8\",\n1842:             );\n1843:           }\n1844:           EOF\n1845:           for eventFile in \"$EVENT_DIR\"/*.json; do\n1846:             [ -e \"$eventFile\" ] || continue\n1847:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n1848:             GATEWAY_STATUS=$?\n1849:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n1850:               rm -rf \"$EVENT_DIR\"\n1851:               exit \"$GATEWAY_STATUS\"\n1852:             fi\n1853:           done\n1854:           rm -rf \"$EVENT_DIR\"\n1855:         outputs:\n1856:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1857: \n1858:       step_reduce_state:\n1859:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1860:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1861:         inputs:\n1862:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1863:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1864:           priorReducedState: \"{state_paths.registry}\"\n1865:         outputs:\n1866:           - \"{state_paths.registry}\"\n1867:           - \"{state_paths.dashboard}\"\n1868:           - \"{state_paths.strategy}\"\n1869:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1870:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1871:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1872:         failure_modes:\n1873:           malformed_delta: \"skip + warn\"\n1874:           missing_iteration_file: \"no-op + error\"\n1875:           schema_mismatch: \"reject + conflict event\"\n1876:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1877:         guarantee: \"Idempotent for identical inputs\"\n1878: \n1879:       step_graph_upsert:\n1880:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1881:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1882:         command: |\n1883:           node <<'EOF'\n1884:           const { existsSync, readFileSync } = require('node:fs');\n1885:           const { join } = require('node:path');\n1886:           const { spawnSync } = require('node:child_process');\n1887: \n1888:           const deltaDir = '{state_paths.delta_dir}';\n1889:           const stateLogPath = '{state_paths.state_log}';\n1890:           const iteration = Number('{current_iteration}');\n1891:           const specFolder = '{spec_folder}';\n1892:           const sessionId = '{config.lineage.sessionId}';\n1893: \n1894:           function parseJsonLines(raw, source) {\n1895:             const records = [];\n1896:             for (const line of raw.split(/\\r?\\n/)) {\n1897:               const trimmed = line.trim();\n1898:               if (!trimmed) continue;\n1899:               try {\n1900:                 records.push(JSON.parse(trimmed));\n1901:               } catch (error) {\n1902:                 process.stderr.write(`deep-research graph upsert: skipped malformed line in ${source}: ${error.message}\\n`);\n1903:               }\n1904:             }\n1905:             return records;\n1906:           }\n1907: \n1908:           function latestGraphEvents(records) {\n1909:             for (let index = records.length - 1; index >= 0; index -= 1) {\n1910:               const record = records[index];\n1911:               if (record && record.type === 'iteration') {\n1912:                 return Array.isArray(record.graphEvents) ? record.graphEvents : [];\n1913:               }\n1914:             }\n1915:             return [];\n1916:           }\n1917: \n1918:           const deltaPath = join(deltaDir, `iter-${String(iteration).padStart(3, '0')}.jsonl`);\n1919:           const sourcePath = existsSync(deltaPath) ? deltaPath : stateLogPath;\n1920:           const records = existsSync(sourcePath) ? parseJsonLines(readFileSync(sourcePath, 'utf8'), sourcePath) : [];\n1921:           const events = latestGraphEvents(records);\n1922: \n1923:           const nodes = [];\n1924:           const edges = [];\n1925:           for (const event of events) {\n1926:             if (!event || typeof event !== 'object') continue;\n1927:             if (event.type === 'node') {\n1928:               nodes.push({ ...event, name: event.label ?? event.name ?? event.id });\n1929:             } else if (event.type === 'edge') {\n1930:               edges.push({\n1931:                 ...event,\n1932:                 sourceId: event.sourceId ?? event.source,\n1933:                 targetId: event.targetId ?? event.target,\n1934:                 relation: String(event.relation ?? '').toUpperCase(),\n1935:               });\n1936:             }\n1937:           }\n1938: \n1939:           if (nodes.length === 0 && edges.length === 0) {\n1940:             process.stdout.write(`deep-research graph upsert: no graph events for iteration ${iteration}; skipping\\n`);\n1941:             process.exit(0);\n1942:           }\n1943: \n1944:           const upsert = spawnSync(\n1945:             process.execPath,\n1946:             [\n1947:               '.skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs',\n1948:               '--spec-folder', specFolder,\n1949:               '--loop-type', 'research',\n1950:               '--session-id', sessionId,\n1951:               '--nodes', JSON.stringify(nodes),\n1952:               '--edges', JSON.stringify(edges),\n1953:             ],\n1954:             { encoding: 'utf8' },\n1955:           );\n1956:           if (upsert.error) {\n1957:             process.stderr.write(`deep-research graph upsert: failed to spawn upsert.cjs: ${upsert.error.message}\\n`);\n1958:           }\n1959:           if (upsert.stdout) process.stdout.write(upsert.stdout);\n1960:           if (upsert.stderr) process.stderr.write(upsert.stderr);\n1961:           process.exit(upsert.status === null ? 1 : upsert.status);\n1962:           EOF\n1963: \n1964:       step_refresh_lineage_context:\n1965:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1966:         read:\n1967:           - \"{state_paths.dashboard}\"\n1968:           - \"{state_paths.registry}\"\n1969:           - \"{state_paths.strategy}\"\n1970:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1971:         use_response:\n1972:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1973:         failure_policy:\n1974:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1975:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1976:         outputs:\n1977:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n1978:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1979: \n1980:       step_evaluate_results:\n1981:         action: \"Verify iteration outputs and extract metrics\"\n1982:         verify:\n1983:           - file_exists: \"{state_paths.iteration_pattern}\"\n1984:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1985:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1986:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1987:         extract:\n1988:           - newInfoRatio: \"From latest JSONL iteration record\"\n1989:           - findings_count: \"From latest JSONL iteration record\"\n1990:           - status: \"From latest JSONL iteration record\"\n1991:           - latest_focus: \"From latest JSONL iteration record\"\n1992:         on_missing_outputs:\n1993:           action: \"Mark iteration as 'error', continue to next\"\n1994:           # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n1995:           # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1996:           append_jsonl: '{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1997: \n1998:       step_telemetry_heartbeat_progress:\n1999:         action: \"Emit a single-loop progress row when iteration state changes\"\n2000:         skip_when: \"config.fanout is present\"\n2001:         command: |\n2002:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2003:           import { existsSync, readFileSync } from 'node:fs';\n2004: \n2005:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2006:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2007: \n2008:           const { appendObservabilityEvent } = observabilityEvents;\n2009:           const stateLogPath = '{state_paths.state_log}';\n2010:           const timestamp = '{ISO_8601_NOW}';\n2011:           const sessionId = '{config.lineage.sessionId}';\n2012:           const generation = Number('{config.lineage.generation}');\n2013:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2014: \n2015:           function readRecords(path) {\n2016:             if (!existsSync(path)) return [];\n2017:             return readFileSync(path, 'utf8')\n2018:               .split(/\\r?\\n/)\n2019:               .map((line) => line.trim())\n2020:               .filter(Boolean)\n2021:               .map((line) => JSON.parse(line));\n2022:           }\n2023: \n2024:           function elapsedSince(value) {\n2025:             const startedAtMs = Date.parse(String(value ?? ''));\n2026:             const nowMs = Date.parse(timestamp);\n2027:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2028:             return Math.max(0, nowMs - startedAtMs);\n2029:           }\n2030: \n2031:           const records = readRecords(stateLogPath);\n2032:           const iterations = records.filter((record) => record.type === 'iteration');\n2033:           const latest = iterations.at(-1) ?? {};\n2034:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2035:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2036:             ?? timestamp;\n2037:           const elapsedMs = elapsedSince(startedAt);\n2038:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2039:           const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');\n2040:           const status = typeof latest.status === 'string' ? latest.status : 'unknown';\n2041:           const row = {\n2042:             event: 'progress',\n2043:             label: 'single',\n2044:             at: timestamp,\n2045:             duration_ms: elapsedMs,\n2046:             loop_type: 'research',\n2047:             sessionId,\n2048:             generation,\n2049:             run,\n2050:             status,\n2051:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2052:           };\n2053: \n2054:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2055:             diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },\n2056:             diffField: 'state_hash',\n2057:           });\n2058:           if (appended) {\n2059:             try {\n2060:               appendObservabilityEvent(observabilityPath, row, {\n2061:                 producer: 'deep-research-auto',\n2062:                 stream: 'single-loop-telemetry',\n2063:                 subject: { label: row.label, sessionId, generation, run },\n2064:                 event: row.event,\n2065:                 status,\n2066:               });\n2067:             } catch {}\n2068:           }\n2069:           EOF\n2070:         working_directory: \"{repo_root}\"\n2071:         outputs:\n2072:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n2073: \n2074:       step_generate_dashboard:\n2075:         action: \"Generate or refresh the human-readable dashboard\"\n2076:         read:\n2077:           - \"{state_paths.state_log}\"\n2078:           - \"{state_paths.registry}\"\n2079:           - \"{state_paths.strategy}\"\n2080:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md\n2081:         output: \"{state_paths.dashboard}\"\n2082:         note: \"Auto-generated from JSONL + reducer registry + strategy. Never manually edited.\"\n2083: \n2084:       step_update_tracking:\n2085:         action: \"Update loop tracking variables\"\n2086:         set:\n2087:           current_iteration: \"{current_iteration + 1}\"\n2088:           stuck_count: \"if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0\"\n2089:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}.\"\n2090: \n2091:       step_loop_decision:\n2092:         action: \"Return to step_read_state for next iteration\"\n2093:         goto: step_read_state\n2094: \n2095:   # ═══════════════════════════════════════════════════════════════\n2096:   # PHASE 3: SYNTHESIS\n2097:   # ═══════════════════════════════════════════════════════════════\n2098:   phase_synthesis:\n2099:     purpose: Compile all iteration findings into final research/research.md\n2100:     steps:\n2101: \n2102:       step_fanout_merge:\n2103:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n2104:         skip_when: \"config.fanout is absent\"\n2105:         command: |\n2106:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n2107:             --loop-type research \\\n2108:             --artifact-dir {artifact_dir}\n2109:         working_directory: \"{repo_root}\"\n2110:         wait_for_completion: true\n2111: \n2112:       step_hydrate_summary_metrics:\n2113:         action: \"Hydrate summary metrics before synthesis\"\n2114:         read:\n2115:           - \"{state_paths.config}\"\n2116:           - \"{state_paths.state_log}\"\n2117:           - \"{state_paths.registry}\"\n2118:           - \"{state_paths.strategy}\"\n2119:         read_patterns:\n2120:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n2121:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n2122:         extract:\n2123:           - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n2124:           - current_iteration: \"iteration_count + 1\"\n2125:           - current_segment: \"Latest segment_start event segment, else 1\"\n2126:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n2127:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n2128:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n2129:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n2130:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n2131:           - answered_count: \"Count answered questions from strategy.md\"\n2132:           - total_questions: \"Count total questions tracked in strategy.md\"\n2133:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n2134:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n2135:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n2136: \n2137:       step_read_all_iterations:\n2138:         action: \"Read all iteration files and strategy\"\n2139:         read_patterns:\n2140:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n2141:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n2142:         read_also: \"{state_paths.strategy}\"\n2143:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n2144:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n2145: \n2146:       step_emit_resource_map:\n2147:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n2148:         branch_on: \"config.fanout\"\n2149:         if_present:\n2150:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n[Output truncated. Continue reading with offset: 2151]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 700, \"offset\": 1451, \"path\": \".skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1793094376393,"end":1793094376730}}}}
{"type":"step_finish","timestamp":1793094377922,"sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","part":{"id":"prt_17cc0e1c200128sJLJCmnApQc2","sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","messageID":"msg_17cc0d1f2001axCR8fQKzzs013","type":"step-finish","reason":"tool-calls","cost":0.0018017999999999999,"tokens":{"input":15977,"output":106,"reasoning":41,"cache":{"read":64000,"write":0}}}}
{"type":"step_start","timestamp":1793094379550,"sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","part":{"id":"prt_17cc0e81e001e4BQCxfB9pengD","sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","messageID":"msg_17cc0e1c8001jSPWPwlN2JXrFP","type":"step-start"}}
{"type":"tool_use","timestamp":1793094380605,"sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","part":{"partID":"prt_17cc0eaf3001D8sfXGuNLrLTd4","sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","messageID":"msg_17cc0e1c8001jSPWPwlN2JXrFP","type":"tool","id":"call_619b89402e3109dfdd7cc464","tool":"read","state":{"status":"completed","input":{"limit":500,"offset":2151,"path":".skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 2151-2450\n2151:           read:\n2152:             - \"{state_paths.config}\"\n2153:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2154:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n2155:         if_absent:\n2156:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n2157:           read:\n2158:             - \"{state_paths.config}\"\n2159:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2160:         write:\n2161:           - \"{state_paths.resource_map_output}\"\n2162:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n2163: \n2164:       step_compile_research:\n2165:         action: \"Compile or finalize research/research.md\"\n2166:         instructions: |\n2167:           If research/research.md exists (progressive synthesis was active):\n2168:             1. Read current research/research.md\n2169:             2. Consolidate and deduplicate findings across all iterations\n2170:             3. Fill any empty sections with findings from iteration files\n2171:             4. Remove redundancy while preserving all unique findings\n2172:             5. Add convergence report as appendix\n2173:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2174:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n2175: \n2176:           If research/research.md does not exist:\n2177:             1. Create research/research.md following 17-section template\n2178:             2. Populate sections from iteration files\n2179:             3. Add citations from original sources\n2180:             4. Note unanswered questions in Open Questions section\n2181:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2182:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n2183:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n2184:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2185:         output: \"{state_paths.research_output}\"\n2186: \n2187:       step_convergence_report:\n2188:         action: \"Generate and append convergence report\"\n2189:         report: |\n2190:           ## Convergence Report\n2191:           - Stop reason: {reason}\n2192:           - Total iterations: {iteration_count}\n2193:           - Questions answered: {answered_count} / {total_questions}\n2194:           - Remaining questions: {remaining_questions}\n2195:           - Last 3 iteration summaries: {last_3_summaries}\n2196:           - Convergence threshold: {convergence_threshold}\n2197:           - Divergence summary: {divergence_summary}\n2198:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2199:         command: |\n2200:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2201:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2202:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2203:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2204:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2205:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n2206:             --artifact-dir \"{state_paths.packet_dir}\" \\\n2207:             --state-log \"{state_paths.state_log}\" \\\n2208:             --registry \"{state_paths.registry}\" \\\n2209:             --output \"{state_paths.research_output}\" \\\n2210:             --dashboard \"{state_paths.dashboard}\" \\\n2211:             --stop-reason \"{reason}\" \\\n2212:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n2213:           NODE_STATUS=$?\n2214:           for eventFile in \"$EVENT_DIR\"/*.json; do\n2215:             [ -e \"$eventFile\" ] || continue\n2216:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n2217:             GATEWAY_STATUS=$?\n2218:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n2219:               rm -rf \"$EVENT_DIR\"\n2220:               exit \"$GATEWAY_STATUS\"\n2221:             fi\n2222:           done\n2223:           rm -rf \"$EVENT_DIR\"\n2224:           exit \"$NODE_STATUS\"\n2225: \n2226:       step_writeback_spec_findings:\n2227:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2228:         edit: \"{spec_folder}/spec.md\"\n2229:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2230:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2231:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2232:         fail_closed_conflict_check:\n2233:           if_existing_generated_fence_present:\n2234:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2235:             on_manual_edit_conflict:\n2236:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2237:               halt: true\n2238:         instructions:\n2239:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2240:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2241:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2242:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2243:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2244:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2245: \n2246:       step_validate_post_synthesis_spec_doc:\n2247:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2248:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2249:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2250: \n2251:       step_update_config_status:\n2252:         action: \"Mark config as complete\"\n2253:         edit: \"{state_paths.config}\"\n2254:         set_field: { status: \"complete\" }\n2255: \n2256:       step_telemetry_heartbeat_terminal:\n2257:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2258:         skip_when: \"config.fanout is present\"\n2259:         terminal_events: [completed, failed, stopped]\n2260:         command: |\n2261:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2262:           import { existsSync, readFileSync } from 'node:fs';\n2263: \n2264:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2265:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2266: \n2267:           const { appendObservabilityEvent } = observabilityEvents;\n2268:           const stateLogPath = '{state_paths.state_log}';\n2269:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n2270:           const timestamp = '{ISO_8601_NOW}';\n2271:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n2272:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n2273:           const reason = '{reason}';\n2274:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2275: \n2276:           function readRecords(path) {\n2277:             if (!existsSync(path)) return [];\n2278:             return readFileSync(path, 'utf8')\n2279:               .split(/\\r?\\n/)\n2280:               .map((line) => line.trim())\n2281:               .filter(Boolean)\n2282:               .map((line) => JSON.parse(line));\n2283:           }\n2284: \n2285:           function elapsedSince(value) {\n2286:             const startedAtMs = Date.parse(String(value ?? ''));\n2287:             const nowMs = Date.parse(timestamp);\n2288:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2289:             return Math.max(0, nowMs - startedAtMs);\n2290:           }\n2291: \n2292:           function terminalEvent(stopReason) {\n2293:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2294:             if (stopReason === 'error') return 'failed';\n2295:             return 'completed';\n2296:           }\n2297: \n2298:           const records = readRecords(stateLogPath);\n2299:           const iterations = records.filter((record) => record.type === 'iteration');\n2300:           const latest = iterations.at(-1) ?? {};\n2301:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2302:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2303:             ?? timestamp;\n2304:           const elapsedMs = elapsedSince(startedAt);\n2305:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2306:           const event = terminalEvent(reason);\n2307:           const row = {\n2308:             event,\n2309:             label: 'single',\n2310:             terminal: true,\n2311:             reason,\n2312:             at: timestamp,\n2313:             duration_ms: elapsedMs,\n2314:             loop_type: 'research',\n2315:             sessionId,\n2316:             generation,\n2317:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2318:           };\n2319: \n2320:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2321:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n2322:             diffField: 'state_hash',\n2323:           });\n2324:           if (appended) {\n2325:             try {\n2326:               appendObservabilityEvent(observabilityPath, row, {\n2327:                 producer: 'deep-research-auto',\n2328:                 stream: 'single-loop-telemetry',\n2329:                 subject: { label: row.label, sessionId, generation, reason },\n2330:                 event,\n2331:                 status: event,\n2332:               });\n2333:             } catch {}\n2334:           }\n2335:           EOF\n2336:         working_directory: \"{repo_root}\"\n2337:         outputs:\n2338:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2339: \n2340:       step_stage_artifact_dir:\n2341:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2342:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2343:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2344:         note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2345:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2346: \n2347:   # ═══════════════════════════════════════════════════════════════\n2348:   # PHASE 4: SAVE\n2349:   # ═══════════════════════════════════════════════════════════════\n2350:   phase_save:\n2351:     purpose: Preserve research context in the packet's canonical continuity documents\n2352:     steps:\n2353: \n2354:       step_compose_save_payload:\n2355:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2356:         output: \"/tmp/save-context-data-<session-id>.json\"\n2357:         requirements:\n2358:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2359:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2360:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2361:         example_payload: |\n2362:           {\n2363:             \"specFolder\": \"{spec_folder}\",\n2364:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2365:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2366:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2367:             \"exchanges\": [],\n2368:             \"toolCalls\": []\n2369:           }\n2370: \n2371:       step_generate_context:\n2372:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2373:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2374:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2375: \n2376:       step_verify_save:\n2377:         action: \"Verify canonical save routed content into the correct spec document\"\n2378:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2379:         on_fail: \"Log warning but do not block completion\"\n2380: \n2381:       step_release_lock:\n2382:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2383:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2384:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2385: \n2386:   # ═══════════════════════════════════════════════════════════════\n2387:   # COMPLETION\n2388:   # ═══════════════════════════════════════════════════════════════\n2389:   completion:\n2390:     message: |\n2391:       Deep research complete.\n2392:       Iterations: {iteration_count} | Stop reason: {reason}\n2393:       Questions answered: {answered_count}/{total_questions}\n2394: \n2395:       Artifacts:\n2396:         - research/research.md (compiled from {iteration_count} iterations)\n2397:         - {iteration_count} iteration files in research/\n2398:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2399:         - Continuity update routed into the canonical spec document\n2400: \n2401:       STATUS=OK PATH={spec_folder}\n2402:     next_steps:\n2403:       - \"/speckit:plan [feature-description]\"\n2404:       - \"/deep:research [new-topic] (for related deep research)\"\n2405:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2406: \n2407: # ─────────────────────────────────────────────────────────────────\n2408: # ERROR RECOVERY\n2409: # ─────────────────────────────────────────────────────────────────\n2410: error_recovery:\n2411:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2412:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2413:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2414:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2415: \n2416: # ─────────────────────────────────────────────────────────────────\n2417: # RULES\n2418: # ─────────────────────────────────────────────────────────────────\n2419: rules:\n2420:   ALWAYS:\n2421:     - follow_workflow_phases_in_order\n2422:     - dispatch_deep_research_agent_per_iteration\n2423:     - check_convergence_before_each_iteration\n2424:     - write_all_state_to_files\n2425:     - refresh_lineage_context_before_next_prompt\n2426:     - write_continuity_after_synthesis\n2427:     - respect_max_iterations_cap\n2428:   NEVER:\n2429:     - skip_convergence_check\n2430:     - dispatch_non_leaf_agents\n2431:     - hold_iteration_findings_in_memory_only\n2432:     - modify_config_after_initialization\n2433:     - overwrite_jsonl_state_log\n2434:     - proceed_without_state_file_verification\n2435: \n2436: # ─────────────────────────────────────────────────────────────────\n2437: # REFERENCE-ONLY APPENDIX\n2438: # ─────────────────────────────────────────────────────────────────\n2439: reference_only_appendix:\n2440:   checkpoint_commit:\n2441:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2442:     commands:\n2443:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n2444:       - 'git commit -m \"chore(deep-research): iteration {NNN} complete\" -m \"{one-line summary of what the iteration found}\"'\n2445:   wave_orchestration:\n2446:     note: \"Wave execution is intentionally excluded from workflow.steps.\"\n2447:     summary:\n2448:       - \"Check whether 3+ independent unanswered questions justify a wave.\"\n2449:       - \"Dispatch up to 3 parallel agents on distinct questions.\"\n2450:       - \"Score wave results by median newInfoRatio and promote top branches.\"","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research-auto.yaml, lines 2151-2450\n2151:           read:\n2152:             - \"{state_paths.config}\"\n2153:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2154:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n2155:         if_absent:\n2156:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n2157:           read:\n2158:             - \"{state_paths.config}\"\n2159:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2160:         write:\n2161:           - \"{state_paths.resource_map_output}\"\n2162:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n2163: \n2164:       step_compile_research:\n2165:         action: \"Compile or finalize research/research.md\"\n2166:         instructions: |\n2167:           If research/research.md exists (progressive synthesis was active):\n2168:             1. Read current research/research.md\n2169:             2. Consolidate and deduplicate findings across all iterations\n2170:             3. Fill any empty sections with findings from iteration files\n2171:             4. Remove redundancy while preserving all unique findings\n2172:             5. Add convergence report as appendix\n2173:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2174:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n2175: \n2176:           If research/research.md does not exist:\n2177:             1. Create research/research.md following 17-section template\n2178:             2. Populate sections from iteration files\n2179:             3. Add citations from original sources\n2180:             4. Note unanswered questions in Open Questions section\n2181:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2182:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n2183:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n2184:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2185:         output: \"{state_paths.research_output}\"\n2186: \n2187:       step_convergence_report:\n2188:         action: \"Generate and append convergence report\"\n2189:         report: |\n2190:           ## Convergence Report\n2191:           - Stop reason: {reason}\n2192:           - Total iterations: {iteration_count}\n2193:           - Questions answered: {answered_count} / {total_questions}\n2194:           - Remaining questions: {remaining_questions}\n2195:           - Last 3 iteration summaries: {last_3_summaries}\n2196:           - Convergence threshold: {convergence_threshold}\n2197:           - Divergence summary: {divergence_summary}\n2198:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2199:         command: |\n2200:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2201:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2202:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2203:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2204:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2205:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n2206:             --artifact-dir \"{state_paths.packet_dir}\" \\\n2207:             --state-log \"{state_paths.state_log}\" \\\n2208:             --registry \"{state_paths.registry}\" \\\n2209:             --output \"{state_paths.research_output}\" \\\n2210:             --dashboard \"{state_paths.dashboard}\" \\\n2211:             --stop-reason \"{reason}\" \\\n2212:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n2213:           NODE_STATUS=$?\n2214:           for eventFile in \"$EVENT_DIR\"/*.json; do\n2215:             [ -e \"$eventFile\" ] || continue\n2216:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n2217:             GATEWAY_STATUS=$?\n2218:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n2219:               rm -rf \"$EVENT_DIR\"\n2220:               exit \"$GATEWAY_STATUS\"\n2221:             fi\n2222:           done\n2223:           rm -rf \"$EVENT_DIR\"\n2224:           exit \"$NODE_STATUS\"\n2225: \n2226:       step_writeback_spec_findings:\n2227:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2228:         edit: \"{spec_folder}/spec.md\"\n2229:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2230:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2231:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2232:         fail_closed_conflict_check:\n2233:           if_existing_generated_fence_present:\n2234:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2235:             on_manual_edit_conflict:\n2236:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2237:               halt: true\n2238:         instructions:\n2239:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2240:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2241:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2242:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2243:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2244:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2245: \n2246:       step_validate_post_synthesis_spec_doc:\n2247:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2248:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2249:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2250: \n2251:       step_update_config_status:\n2252:         action: \"Mark config as complete\"\n2253:         edit: \"{state_paths.config}\"\n2254:         set_field: { status: \"complete\" }\n2255: \n2256:       step_telemetry_heartbeat_terminal:\n2257:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2258:         skip_when: \"config.fanout is present\"\n2259:         terminal_events: [completed, failed, stopped]\n2260:         command: |\n2261:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2262:           import { existsSync, readFileSync } from 'node:fs';\n2263: \n2264:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2265:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2266: \n2267:           const { appendObservabilityEvent } = observabilityEvents;\n2268:           const stateLogPath = '{state_paths.state_log}';\n2269:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n2270:           const timestamp = '{ISO_8601_NOW}';\n2271:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n2272:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n2273:           const reason = '{reason}';\n2274:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2275: \n2276:           function readRecords(path) {\n2277:             if (!existsSync(path)) return [];\n2278:             return readFileSync(path, 'utf8')\n2279:               .split(/\\r?\\n/)\n2280:               .map((line) => line.trim())\n2281:               .filter(Boolean)\n2282:               .map((line) => JSON.parse(line));\n2283:           }\n2284: \n2285:           function elapsedSince(value) {\n2286:             const startedAtMs = Date.parse(String(value ?? ''));\n2287:             const nowMs = Date.parse(timestamp);\n2288:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2289:             return Math.max(0, nowMs - startedAtMs);\n2290:           }\n2291: \n2292:           function terminalEvent(stopReason) {\n2293:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2294:             if (stopReason === 'error') return 'failed';\n2295:             return 'completed';\n2296:           }\n2297: \n2298:           const records = readRecords(stateLogPath);\n2299:           const iterations = records.filter((record) => record.type === 'iteration');\n2300:           const latest = iterations.at(-1) ?? {};\n2301:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2302:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2303:             ?? timestamp;\n2304:           const elapsedMs = elapsedSince(startedAt);\n2305:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2306:           const event = terminalEvent(reason);\n2307:           const row = {\n2308:             event,\n2309:             label: 'single',\n2310:             terminal: true,\n2311:             reason,\n2312:             at: timestamp,\n2313:             duration_ms: elapsedMs,\n2314:             loop_type: 'research',\n2315:             sessionId,\n2316:             generation,\n2317:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2318:           };\n2319: \n2320:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2321:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n2322:             diffField: 'state_hash',\n2323:           });\n2324:           if (appended) {\n2325:             try {\n2326:               appendObservabilityEvent(observabilityPath, row, {\n2327:                 producer: 'deep-research-auto',\n2328:                 stream: 'single-loop-telemetry',\n2329:                 subject: { label: row.label, sessionId, generation, reason },\n2330:                 event,\n2331:                 status: event,\n2332:               });\n2333:             } catch {}\n2334:           }\n2335:           EOF\n2336:         working_directory: \"{repo_root}\"\n2337:         outputs:\n2338:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2339: \n2340:       step_stage_artifact_dir:\n2341:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2342:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2343:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2344:         note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2345:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2346: \n2347:   # ═══════════════════════════════════════════════════════════════\n2348:   # PHASE 4: SAVE\n2349:   # ═══════════════════════════════════════════════════════════════\n2350:   phase_save:\n2351:     purpose: Preserve research context in the packet's canonical continuity documents\n2352:     steps:\n2353: \n2354:       step_compose_save_payload:\n2355:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2356:         output: \"/tmp/save-context-data-<session-id>.json\"\n2357:         requirements:\n2358:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2359:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2360:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2361:         example_payload: |\n2362:           {\n2363:             \"specFolder\": \"{spec_folder}\",\n2364:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2365:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2366:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2367:             \"exchanges\": [],\n2368:             \"toolCalls\": []\n2369:           }\n2370: \n2371:       step_generate_context:\n2372:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2373:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2374:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2375: \n2376:       step_verify_save:\n2377:         action: \"Verify canonical save routed content into the correct spec document\"\n2378:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2379:         on_fail: \"Log warning but do not block completion\"\n2380: \n2381:       step_release_lock:\n2382:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2383:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2384:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2385: \n2386:   # ═══════════════════════════════════════════════════════════════\n2387:   # COMPLETION\n2388:   # ═══════════════════════════════════════════════════════════════\n2389:   completion:\n2390:     message: |\n2391:       Deep research complete.\n2392:       Iterations: {iteration_count} | Stop reason: {reason}\n2393:       Questions answered: {answered_count}/{total_questions}\n2394: \n2395:       Artifacts:\n2396:         - research/research.md (compiled from {iteration_count} iterations)\n2397:         - {iteration_count} iteration files in research/\n2398:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2399:         - Continuity update routed into the canonical spec document\n2400: \n2401:       STATUS=OK PATH={spec_folder}\n2402:     next_steps:\n2403:       - \"/speckit:plan [feature-description]\"\n2404:       - \"/deep:research [new-topic] (for related deep research)\"\n2405:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2406: \n2407: # ─────────────────────────────────────────────────────────────────\n2408: # ERROR RECOVERY\n2409: # ─────────────────────────────────────────────────────────────────\n2410: error_recovery:\n2411:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2412:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2413:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2414:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2415: \n2416: # ─────────────────────────────────────────────────────────────────\n2417: # RULES\n2418: # ─────────────────────────────────────────────────────────────────\n2419: rules:\n2420:   ALWAYS:\n2421:     - follow_workflow_phases_in_order\n2422:     - dispatch_deep_research_agent_per_iteration\n2423:     - check_convergence_before_each_iteration\n2424:     - write_all_state_to_files\n2425:     - refresh_lineage_context_before_next_prompt\n2426:     - write_continuity_after_synthesis\n2427:     - respect_max_iterations_cap\n2428:   NEVER:\n2429:     - skip_convergence_check\n2430:     - dispatch_non_leaf_agents\n2431:     - hold_iteration_findings_in_memory_only\n2432:     - modify_config_after_initialization\n2433:     - overwrite_jsonl_state_log\n2434:     - proceed_without_state_file_verification\n2435: \n2436: # ─────────────────────────────────────────────────────────────────\n2437: # REFERENCE-ONLY APPENDIX\n2438: # ─────────────────────────────────────────────────────────────────\n2439: reference_only_appendix:\n2440:   checkpoint_commit:\n2441:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2442:     commands:\n2443:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n2444:       - 'git commit -m \"chore(deep-research): iteration {NNN} complete\" -m \"{one-line summary of what the iteration found}\"'\n2445:   wave_orchestration:\n2446:     note: \"Wave execution is intentionally excluded from workflow.steps.\"\n2447:     summary:\n2448:       - \"Check whether 3+ independent unanswered questions justify a wave.\"\n2449:       - \"Dispatch up to 3 parallel agents on distinct questions.\"\n2450:       - \"Score wave results by median newInfoRatio and promote top branches.\""}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 500, \"offset\": 2151, \"path\": \".skilled/commands/deep/assets/deep-research-auto.yaml\"}"},"time":{"start":1793094380275,"end":1793094380605}}}}
