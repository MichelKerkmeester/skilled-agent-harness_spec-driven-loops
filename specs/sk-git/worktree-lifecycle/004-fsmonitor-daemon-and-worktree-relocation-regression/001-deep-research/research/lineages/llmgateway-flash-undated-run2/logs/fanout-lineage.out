((line) => {\n28:     const match = line.match(/^-\\s+\\*\\*F\\d+\\*\\*:\\s*(.+)$/);\n29:     return match ? [match[1]] : [];\n30:   });\n31:   const findingTexts = [subheadingFindings, numberedFindings, bulletFindings]\n32:     .find((texts) => texts.length > 0) ?? [];\n33:   return findingTexts.map((text, index) => ({\n34:     id: `iteration-${run}-finding-${index + 1}`,\n35:     title: text,\n36:     text,\n37:     addedAtIteration: run,\n38:     _iteration_source: sourcePath,\n39:   }));\n40: }\n41: \n42: // Append-only logs can contain corrected attempts. Keep the last record for each\n43: // numeric iteration so the gate, the merge and the closeout share one state view.\n44: function latestIterationRecords(records) {\n45:   const lastIndexByIteration = new Map();\n46:   records.forEach((record, index) => {\n47:     if (!record || record.type !== 'iteration') return;\n48:     const iteration = Number(record.iteration ?? record.run);\n49:     if (Number.isSafeInteger(iteration)) lastIndexByIteration.set(iteration, index);\n50:   });\n51:   return records.filter((record, index) => {\n52:     if (!record || record.type !== 'iteration') return true;\n53:     const iteration = Number(record.iteration ?? record.run);\n54:     return !Number.isSafeInteger(iteration) || lastIndexByIteration.get(iteration) === index;\n55:   });\n56: }\n57: \n58: // A delta row is filed under its own iteration, and under the delta file's number\n59: // only when it names none.\n60: function deltaRowIteration(row, fileRun) {\n61:   const iterationNumber = Number(row?.iteration);\n62:   return Number.isFinite(iterationNumber) ? Math.floor(iterationNumber) : fileRun;\n63: }\n64: \n65: function normalizeFindingKey(value) {\n66:   return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n67: }\n68: \n69: // Every identity a finding can be matched by. The closeout and the merge must agree\n70: // on what makes a state finding present in a registry, so both read these keys.\n71: function findingKeys(candidate) {\n72:   if (typeof candidate === 'string') {\n73:     const key = normalizeFindingKey(candidate);\n74:     return key ? [key] : [];\n75:   }\n76:   if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n77:   return [...new Set([\n78:     candidate.id,\n79:     candidate.findingId,\n80:     candidate.title,\n[Output truncated. Continue reading with offset: 81]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 80, \"path\": \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/iteration-findings.cjs\"}"},"time":{"start":1793094440091,"end":1793094440550}}}}
