} with unreadable output: ${(spawned.stdout || spawned.stderr || '').slice(0, 200)}` };\n304: }\n305: \n306: // Structural ledger-backing check. Under ledger authority the gateway roots the\n307: // mode's own append-only ledger ({leaf}-ledger) at its run directory and writes an\n308: // event there for every iteration it records. A complete-looking projection record\n309: // with no such ledger behind it is a leaf that wrote the projection directly, so the\n310: // ledger and the projection have silently diverged. The run directory is the artifact\n311: // dir for lineage-rooted modes and its parent for packet-rooted ones, so the ledger\n312: // is accepted at either level; its total absence is the divergence signal. Returns\n313: // 'not-enforced' before a mode moves to ledger authority (the legacy writer is\n314: // sanctioned then), and 'skipped' when authority cannot be read (fail-open).\n315: function checkLedgerBacking(loopType, artifactDir, legacyFilePath) {\n316:   const leaf = LEAF_BY_LOOP[loopType];\n317:   if (!leaf || !ARTIFACT_ID_BY_LOOP[loopType]) return { status: 'skipped' };\n318:   const authority = checkGatewayReceipt(loopType, artifactDir, legacyFilePath);\n319:   if (authority.status !== 'violation' && authority.status !== 'ok') {\n320:     return { status: 'not-enforced', authority: authority.status };\n321:   }\n322:   const roots = [\n323:     { root: artifactDir, kind: 'artifact-dir' },\n324:     { root: path.dirname(artifactDir), kind: 'parent-of-lineage' },\n325:   ];\n326:   const match = roots.find(({ root }) => {\n327:     const framesDir = path.join(root, `${leaf}-ledger`, 'frames');\n328:     try {\n329:       return fs.existsSync(framesDir) && fs.readdirSync(framesDir).some((f) => f.endsWith('.frame'));\n330:     } catch (_) {\n331:       return false;\n332:     }\n333:   });\n334:   if (!match) return { status: 'unbacked' };\n335:   return {\n336:     status: 'backed',\n337:     framesRoot: path.join(match.root, `${leaf}-ledger`, 'frames'),\n338:     framesRootKind: match.kind,\n339:   };\n[Output truncated. Continue reading with offset: 340]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 220, \"offset\": 120, \"path\": \".skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs\"}"},"time":{"start":1793094598039,"end":1793094598502}}}}
