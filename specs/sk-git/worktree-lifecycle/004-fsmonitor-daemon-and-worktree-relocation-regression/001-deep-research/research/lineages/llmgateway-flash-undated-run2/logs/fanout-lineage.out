he toolchain has a checker to miss.\n432-    if _in_toolchain_repo; then\n433-      echo \"WARNING [gate:skill-root-metadata]: checker is missing: $SKILL_GATE; push gate failed open.\" >&2\n434-    fi\n435-  elif [[ -f \"$SKILL_GATE\" && \"$SKILL_CHANGES_PUSHED\" -eq 1 ]]; then\n436-    if ! node \"$SKILL_GATE\" >&2; then\n437-      {\n438-        echo \"\"\n--\n443-          echo \"WARNING [gate:skill-root-metadata]: skill-root metadata is stale for skills being pushed.\"\n444-          echo \"Not blocking: CI enforces this on every push to main and skilled/v*.\"\n445-        fi\n446:        echo \"Fix with:  node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs --fix\"\n447-        echo \"\"\n448-      } >&2\n449-    fi\n450-  fi\n451-fi\n452-\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"L=\\\"specs/sk-git/035-fsmonitor-daemon-and-worktree-relocation-regression/001-deep-research/research/lineages/llmgateway-flash-undated-run2\\\"; ls \\\"$L/steer.md\\\" 2>&1; echo \\\"=== manifest builder 115-145 ===\\\"; sed -n '115,145p' .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs; echo \\\"=== hook pre-push (gate block) ===\\\"; grep -n -B3 -A12 \\\"SPECKIT_SKIP_PREPUSH_SKILL_GATE\\\\|ci-skill-root-metadata\\\" ~/.config/git/hooks/pre-push 2>/dev/null | head -50\"}"},"time":{"start":1793095128091,"end":1793095129787}}}}
