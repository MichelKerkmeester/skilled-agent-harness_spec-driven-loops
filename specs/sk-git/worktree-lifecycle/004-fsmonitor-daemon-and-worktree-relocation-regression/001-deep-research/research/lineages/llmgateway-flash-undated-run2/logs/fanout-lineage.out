lag] of modeFlags) {\n117:     if (args[key] === undefined) {\n118:       throw new Error(`missing required flag: ${flag}`);\n119:     }\n120:   }\n121: }\n122: \n123: // A symlink is not a synthesis artifact. Following it would let a file outside\n124: // the run satisfy the close.\n125: function hasFile(filePath) {\n126:   try {\n127:     return existsSync(filePath)\n128:       && !lstatSync(filePath).isSymbolicLink()\n129:       && lstatSync(filePath).isFile();\n130:   } catch {\n131:     return false;\n132:   }\n133: }\n134: \n135: function readJson(filePath) {\n136:   try {\n137:     return JSON.parse(readFileSync(filePath, 'utf8'));\n138:   } catch {\n139:     return null;\n140:   }\n141: }\n142: \n143: function readJsonl(filePath) {\n144:   if (!hasFile(filePath)) return { records: [], parseFailures: 0 };\n145:   const records = [];\n146:   let parseFailures = 0;\n147:   for (const line of readFileSync(filePath, 'utf8').split(/\\r?\\n/)) {\n148:     const trimmed = line.trim();\n149:     if (!trimmed) continue;\n150:     try {\n151:       records.push(JSON.parse(trimmed));\n152:     } catch {\n153:       parseFailures += 1;\n154:     }\n155:   }\n156:   return { records, parseFailures };\n157: }\n158: \n159: \n160: // Lineage logs are the iteration record when a run fans out. The root log then\n161: // holds compatibility rows, so it is read only when no lineage log exists.\n162: function lineageStateLogs(artifactDir, mode) {\n163:   const lineagesDir = join(artifactDir, 'lineages');\n164:   if (!existsSync(lineagesDir)) return [];\n165:   if (lstatSync(lineagesDir).isSymbolicLink() || !lstatSync(lineagesDir).isDirectory()) {\n166:     throw new Error(`lineages must be a real directory: ${lineagesDir}`);\n167:   }\n168:   const root = realpathSync(resolve(artifactDir));\n169:   return readdirSync(lineagesDir, { withFileTypes: true })\n170:     .map((entry) => {\n171:       if (entry.isSymbolicLink()) {\n172:         throw new Error(`lineage must be a real directory: ${join(lineagesDir, entry.name)}`);\n173:       }\n174:       return entry;\n175:     })\n176:     .filter((entry) => entry.isDirectory())\n177:     .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true }))\n178:     .flatMap((entry) => {\n179:       const candidate = join(lineagesDir, entry.name, `deep-${mode}-state.jsonl`);\n180:       if (!hasFile(candidate)) return [];\n181:       const candidatePath = realpathSync(candidate);\n182:       const rel = relative(root, candidatePath);\n183:       if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {\n184:         throw new Error(`lineage state resolves outside the artifact directory: ${candidate}`);\n185:       }\n186:       return [candidatePath];\n187:     });\n188: }\n189: \n190: function countIterationFindings(record, fields) {\n191:   if (!record || record.type !== 'iteration') return 0;\n192:   const numeric = Number(record.findingsCount);\n193:   if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n194:   for (const field of fields) {\n195:     if (Array.isArray(record[field])) return record[field].length;\n196:   }\n197:   return 0;\n198: }\n199: \n200: function collectIterationFindingGroups(record, fields) {\n201:   if (!record || record.type !== 'iteration') return [];\n202:   const structured = fields\n203:     .map((field) => record[field])\n204:     .find((value) => Array.isArray(value) && value.length > 0);\n205:   if (!Array.isArray(structured)) return [];\n206:   return structured\n207:     .map(findingKeys)\n208:     .filter((keys) => keys.length > 0);\n209: }\n210: \n211: // Cumulative review snapshots and repeatedFindings (a subset of openFindings) need\n212: // one count per finding identity.\n213: function countDistinctFindings(findings) {\n214:   const identities = new Set();\n215:   let unkeyedCount = 0;\n216:   for (const finding of findings) {\n217:     const identity = findingKeys(finding)[0];\n218:     if (identity) identities.add(identity);\n219:     else unkeyedCount += 1;\n220:   }\n221:   return identities.size + unkeyedCount;\n222: }\n223: \n224: function registryEvidence(mode, registry) {\n225:   if (mode === 'research') {\n226:     const present = Array.isArray(registry?.keyFindings);\n227:     return {\n228:       registryFindingCount: present ? countDistinctFindings(registry.keyFindings) : null,\n229:       keys: present ? registry.keyFindings.flatMap(findingKeys) : [],\n230:       missingCode: 'registry_missing_keyFindings',\n231:     };\n232:   }\n233:   const openFindings = Array.isArray(registry?.openFindings) ? registry.openFindings : null;\n234:   const registryFindings = [registry?.openFindings, registry?.resolvedFindings, registry?.repeatedFindings]\n235:     .filter(Array.isArray)\n236:     .flat();\n237:   return {\n238:     registryFindingCount: openFindings === null ? null : countDistinctFindings(registryFindings),\n239:     keys: registryFindings.flatMap(findingKeys),\n240:     missingCode: 'registry_missing_openFindings',\n241:   };\n242: }\n243: \n244: // Count-only rows carry a findingsCount and no structured list. Research\n245: // reconstruction also treats a review-shaped list as structured so those rows\n246: // are not asked to be rebuilt from the count.\n247: function countOnlyFindings(records) {\n248:   return records.reduce((sum, record) => {\n249:     if (!record || record.type !== 'iteration') return sum;\n250:     const structured = [record.keyFindings, record.findings, record.findingDetails]\n251:       .find((value) => Array.isArray(value) && value.length > 0);\n252:     if (structured) return sum;\n253:     return sum + countIterationFindings(record, FINDING_FIELDS.research);\n254:   }, 0);\n255: }\n256: \n257: // The artifact directory name is the run-stable token this step can derive\n258: // from the state-log path it was handed.\n259: function buildStem(mode, eventName, scopeRunId) {\n260:   const builders = {\n261:     research: (name) => ({\n262:       stem: `deep_research.${name}`,\n263:       scope: { runId: scopeRunId, lineageId: scopeRunId },\n264:     }),\n265:     review: (name) => ({\n266:       stem: `deep_review.${name}`,\n267:       scope: { runId: scopeRunId, sessionId: scopeRunId },\n268:     }),\n269:   };\n270:   return builders[mode](eventName);\n271: }\n272: \n273: // The state log is a projection the gateway rebuilds. The staged ledger event\n274: // is what survives the next refresh.\n275: function stage(eventDir, scopeRunId, mode, eventRecord) {\n276:   const eventName = eventRecord.event;\n277:   const data = { ...eventRecord };\n278:   delete data.event;\n279:   const built = buildStem(mode, eventName, scopeRunId);\n280:   writeFileSync(\n281:     join(eventDir, `${eventName}.json`),\n282:     JSON.stringify({ stem: built.stem, scope: built.scope, data }),\n283:     'utf8',\n284:   );\n285: }\n286: \n287: // ───────────────────────────────────────────────────────────────────\n288: // 4. CORE LOGIC\n289: // ───────────────────────────────────────────────────────────────────\n290: \n291: function closeOut(args) {\n292:   const mode = args.mode;\n293:   const fields = FINDING_FIELDS[mode];\n294:   const scopeRunId = basename(dirname(args.stateLog)) || mode;\n295:   const registry = readJson(args.registry);\n296:   const evidence = registryEvidence(mode, registry);\n297:   const lineageLogs = lineageStateLogs(args.artifactDir, mode);\n298:   const parsedState = (lineageLogs.length > 0 ? lineageLogs : [args.stateLog])\n299:     .map(readJsonl)\n300:     .map((entry) => ({ ...entry, records: latestIterationRecords(entry.records) }));\n301:   const stateRecords = parsedState.flatMap((entry) => entry.records);\n302:   const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n303:   const totalIterations = stateRecords.filter((record) => record && record.type === 'iteration').length;\n304:   const iterationFindingCount = stateRecords.reduce(\n305:     (sum, record) => sum + countIterationFindings(record, fields),\n306:     0,\n307:   );\n308:   const identifiableFindingGroups = stateRecords.flatMap(\n309:     (record) => collectIterationFindingGroups(record, fields),\n310:   );\n311:   const registryFindingKeys = new Set(evidence.keys);\n312:   const missingStructuredFindingGroups = identifiableFindingGroups\n313:     .filter((keys) => !keys.some((key) => registryFindingKeys.has(key)));\n314:   const missingStructuredFindingCount = countDistinctFindings(\n315:     missingStructuredFindingGroups.map((keys) => keys[0]),\n316:   );\n317:   const identifiableFindingCount = countDistinctFindings(\n318:     identifiableFindingGroups.map((keys) => keys[0]),\n319:   );\n320:   // The root dashboard is a single-executor artifact. Fan-out stores one\n321:   // beside each lineage, so it is required only when the close reads the root log.\n322:   const missingArtifacts = [\n323:     ['registry', args.registry],\n324:     [mode, args.output],\n325:     ...(lineageLogs.length > 0 ? [] : [['dashboard', args.dashboard]]),\n326:   ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n327: \n328:   const invariantFailures = [];\n329:   if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n[Output truncated. Continue reading with offset: 330]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs, lines 80-329\n80:     }\n81:     const value = argv[index + 1];\n82:     if (value === undefined || value.startsWith('--')) {\n83:       const label = PATH_FLAGS.some(([, flag]) => flag === token)\n84:         ? 'missing required path'\n85:         : 'missing required flag';\n86:       throw new Error(`${label}: ${token}`);\n87:     }\n88:     args[FLAG_KEYS[token]] = value;\n89:     index += 1;\n90:   }\n91:   return args;\n92