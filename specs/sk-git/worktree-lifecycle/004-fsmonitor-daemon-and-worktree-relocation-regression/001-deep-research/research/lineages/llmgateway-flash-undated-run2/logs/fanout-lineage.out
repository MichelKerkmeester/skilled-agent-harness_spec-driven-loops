equired`);\n84: }\n85: \n86: // Key order carries no meaning in an event the caller hands over, so the\n87: // digest sorts keys before hashing.\n88: function stableJson(value) {\n89:   if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;\n90:   if (value !== null && typeof value === 'object') {\n91:     return `{${Object.keys(value).sort()\n92:       .map((key) => `${JSON.stringify(key)}:${stableJson(value[key])}`)\n93:       .join(',')}}`;\n94:   }\n95:   return JSON.stringify(value);\n96: }\n97: \n98: function jsonOut(payload) {\n99:   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n100: }\n101: \n102: function normalizeMode(mode) {\n103:   if (!mode || typeof mode !== 'string') return '';\n104:   const trimmed = mode.trim();\n105:   if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n106:   if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n107:   if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n108:   return trimmed;\n109: }\n110: \n111: async function resolveModeAdapter(mode) {\n112:   const normalized = normalizeMode(mode);\n113:   switch (normalized) {\n114:     case 'deep-research': {\n115:       const mod = await import('../lib/deep-research-ledger-schema/index.ts');\n116:       return {\n117:         normalizedMode: 'deep-research',\n118:         createRegistry: mod.createDeepResearchEventRegistry,\n119:         prepareEvent: mod.prepareDeepResearchEvent,\n120:         isEventStem: mod.isDeepResearchEventStem,\n[Output truncated. Continue reading with offset: 121]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\", \"limit\": 120}"},"time":{"start":1793094386229,"end":1793094386648}}}}
{"type":"tool_use","timestamp":1793094386650,"sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","part":{"partID":"prt_17cc1008e0026bOPS1bPP25EXG","sessionID":"ses_e833fbb1effewOnhN31WYdpXxT","messageID":"msg_17cc0f123001Wzq1lfxTXYDsb5","type":"tool","id":"call_2e1bab634019433144b519f3","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","limit":150},"output":"Read file .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs, lines 1-150\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ Deep Research State Reducer                                              ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: \n5: 'use strict';\n6: \n7: // ─────────────────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ─────────────────────────────────────────────────────────────────────────────\n10: \n11: const fs = require('node:fs');\n12: const os = require('node:os');\n13: const path = require('node:path');\n14: const crypto = require('node:crypto');\n15: const { spawnSync } = require('node:child_process');\n16: const { emitResourceMap } = require('../../shared/synthesis/resource-map.cjs');\n17: const { resolveArtifactRoot } = require('../../runtime/lib/deep-loop/artifact-root.cjs');\n18: const {\n19:   buildCarriedForwardOpenQuestions,\n20:   deriveNextFocusFromContinuity,\n21:   formatCarriedForwardOpenQuestions,\n22: } = require('../../runtime/lib/deep-loop/continuity-thread.cjs');\n23: const { filterCompletionBearingRecords } = require('../../shared/progress/progress-record.cjs');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. HELPERS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const APPEND_GATEWAY = path.resolve(__dirname, '..', '..', 'runtime', 'scripts', 'append-mode-event.cjs');\n30: // The gateway binds each append to the checkout's identity and commit, so it\n31: // runs from the repository root whatever directory the reducer was started in.\n32: const REPOSITORY_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n33: const LEDGER_SCOPE_TOKEN = /^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$/;\n34: \n35: /**\n36:  * True when the state log sits beside a ledger with records, which makes the\n37:  * file a projection the append gateway rebuilds from that ledger. A row written\n38:  * straight into such a file is dropped the next time the projection replaces it.\n39:  */\n40: function stateLogHasLedger(stateLogPath) {\n41:   try {\n42:     return fs.readdirSync(path.join(path.dirname(stateLogPath), 'deep-research-ledger', 'frames'))\n43:       .some((name) => name.endsWith('.frame'));\n44:   } catch {\n45:     return false;\n46:   }\n47: }\n48: \n49: function ledgerScopeId(sessionId, stateLogPath) {\n50:   return typeof sessionId === 'string' && LEDGER_SCOPE_TOKEN.test(sessionId)\n51:     ? sessionId\n52:     : path.basename(path.dirname(stateLogPath));\n53: }\n54: \n55: function appendThroughGateway(stateLogPath, event) {\n56:   const eventDir = fs.mkdtempSync(path.join(os.tmpdir(), 'deep-research-reducer-event-'));\n57:   const eventPath = path.join(eventDir, 'event.json');\n58:   try {\n59:     fs.writeFileSync(eventPath, JSON.stringify(event), 'utf8');\n60:     const result = spawnSync(process.execPath, [\n61:       APPEND_GATEWAY,\n62:       '--mode', 'research',\n63:       '--run-directory', path.dirname(stateLogPath),\n64:       '--event-json', eventPath,\n65:     ], { cwd: REPOSITORY_ROOT, encoding: 'utf8' });\n66:     if (result.status !== 0) {\n67:       const outcome = String(result.stdout || '').trim().split('\\n').at(-1) || String(result.stderr || '').trim();\n68:       throw new Error(`[deep-research] append gateway refused the reducer's ${event.stem} row: ${outcome}`);\n69:     }\n70:   } finally {\n71:     fs.rmSync(eventDir, { recursive: true, force: true });\n72:   }\n73: }\n74: \n75: /**\n76:  * Record the reducer's own bookkeeping rows. A ledger-backed state log takes\n77:  * them through the append gateway as registered events, so the projection\n78:  * carries them; a state log with no ledger has no projection to replace it and\n79:  * keeps the direct append.\n80:  *\n81:  * @param {string} stateLogPath - The run's state log.\n82:  * @param {Object[]} rows - Legacy-shaped rows, as a direct append writes them.\n83:  * @param {(row: Object) => { stem: string, idempotencyKey: string }} identify - The row's stem and stable key.\n84:  */\n85: function recordReducerRows(stateLogPath, rows, identify) {\n86:   if (!rows.length) return;\n87:   if (!stateLogHasLedger(stateLogPath)) {\n88:     fs.appendFileSync(stateLogPath, `${rows.map((row) => JSON.stringify(row)).join('\\n')}\\n`, 'utf8');\n89:     return;\n90:   }\n91:   for (const row of rows) {\n92:     const { type: _type, event: _event, timestamp, ...data } = row;\n93:     const scopeId = ledgerScopeId(row.sessionId, stateLogPath);\n94:     const { stem, idempotencyKey } = identify(row);\n95:     appendThroughGateway(stateLogPath, {\n96:       stem,\n97:       scope: { runId: scopeId, lineageId: scopeId },\n98:       data,\n99:       occurredAt: timestamp,\n100:       idempotencyKey,\n101:     });\n102:   }\n103: }\n104: \n105: const DEFAULT_SPARKLINE_WIDTH = 20;\n106: const DEFAULT_TREND_FLATLINE_WINDOW = 3;\n107: const DEFAULT_REJECTED_PATTERN_CATEGORY = 'general';\n108: const DEFAULT_REJECTED_PATTERN_FUZZY_THRESHOLD = 0.85;\n109: const DEFAULT_MIN_IDEA_OBSERVATIONS = 2;\n110: const MIN_IDEA_OBSERVATIONS = 1;\n111: const MAX_IDEA_OBSERVATIONS = 10;\n112: const INBOX_FILE_NAME = 'inbox.jsonl';\n113: const DEFAULT_INBOX_SOURCE = 'research-inbox';\n114: const LEGACY_IMPORT_ORIGIN = 'legacy-import';\n115: const LEGACY_IMPORT_SOURCE = 'key-questions';\n116: const QUESTION_CONFLICT_EVENT = 'question_conflict';\n117: const DEFAULT_QUESTION_DECISION = 'needs_decision';\n118: const MAX_REJECTED_PATTERNS = 100;\n119: const REJECTED_PATTERN_CANDIDATE_FIELDS = ['text', 'focus', 'nextFocus', 'pattern', 'idea', 'title'];\n120: const REJECTED_PATTERN_EVENT_FIELDS = ['pattern', 'idea', 'text', 'candidate'];\n121: const IDEA_EVENT_TEXT_FIELDS = ['idea', 'text', 'title', 'pattern', 'candidate'];\n122: const IDEA_OBSERVED_EVENTS = new Set(['idea_observed', 'ideaObserved']);\n123: const IDEA_PROMOTED_EVENTS = new Set(['idea_promoted', 'ideaPromoted']);\n124: const IDEA_REJECTED_EVENTS = new Set(['idea_rejected', 'ideaRejected']);\n125: const IDEA_REJECTED_REMOVED_EVENTS = new Set(['idea_rejected_removed', 'ideaRejectedRemoved']);\n126: const IDEA_REJECTED_RESET_EVENTS = new Set(['idea_rejected_reset', 'ideaRejectedReset']);\n127: const VALID_QUESTION_ORIGINS = new Set([\n128:   'angle-bank',\n129:   'analyst-strategy',\n130:   'operator',\n131:   LEGACY_IMPORT_ORIGIN,\n132: ]);\n133: const VALID_QUESTION_DECISIONS = new Set([\n134:   'accepted',\n135:   'rejected',\n136:   'superseded',\n137:   DEFAULT_QUESTION_DECISION,\n138: ]);\n139: const SPARKLINE_BLOCKS = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];\n140: \n141: function readUtf8(filePath) {\n142:   return fs.readFileSync(filePath, 'utf8');\n143: }\n144: \n145: function writeUtf8(filePath, content) {\n146:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n147:   fs.writeFileSync(filePath, content, 'utf8');\n148: }\n149: \n150: function writeUtf8Atomic(filePath, content) {\n[Output truncated. Continue reading with offset: 151]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs, lines 1-150\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ Deep Research State Reducer                                              ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: \n5: 'use strict';\n6: \n7: // ─────────────────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ─────────────────────────────────────────────────────────────────────────────\n10: \n11: const fs = require('node:fs');\n12: const os = require('node:os');\n13: const path = require('node:path');\n14: const crypto = require('node:crypto');\n15: const { spawnSync } = require('node:child_process');\n16: const { emitResourceMap } = require('../../shared/synthesis/resource-map.cjs');\n17: const { resolveArtifactRoot } = require('../../runtime/lib/deep-loop/artifact-root.cjs');\n18: const {\n19:   buildCarriedForwardOpenQuestions,\n20:   deriveNextFocusFromContinuity,\n21:   formatCarriedForwardOpenQuestions,\n22: } = require('../../runtime/lib/deep-loop/continuity-thread.cjs');\n23: const { filterCompletionBearingRecords } = require('../../shared/progress/progress-record.cjs');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. HELPERS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const APPEND_GATEWAY = path.resolve(__dirname, '..', '..', 'runtime', 'scripts', 'append-mode-event.cjs');\n30: // The gateway binds each append to the checkout's identity and commit, so it\n31: // runs from the repository root whatever directory the reducer was started in.\n32: const REPOSITORY_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n33: const LEDGER_SCOPE_TOKEN = /^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$/;\n34: \n35: /**\n36:  * True when the state log sits beside a ledger with records, which makes the\n37:  * file a projection the append gateway rebuilds from that ledger. A row written\n38:  * straight into such a file is dropped the next time the projection replaces it.\n39:  */\n40: function stateLogHasLedger(stateLogPath) {\n41:   try {\n42:     return fs.readdirSync(path.join(path.dirname(stateLogPath), 'deep-research-ledger', 'frames'))\n43:       .some((name) => name.endsWith('.frame'));\n44:   } catch {\n45:     return false;\n46:   }\n47: }\n48: \n49: function ledgerScopeId(sessionId, stateLogPath) {\n50:   return typeof sessionId === 'string' && LEDGER_SCOPE_TOKEN.test(sessionId)\n51:     ? sessionId\n52:     : path.basename(path.dirname(stateLogPath));\n53: }\n54: \n55: function appendThroughGateway(stateLogPath, event) {\n56:   const eventDir = fs.mkdtempSync(path.join(os.tmpdir(), 'deep-research-reducer-event-'));\n57:   const eventPath = path.join(eventDir, 'event.json');\n58:   try {\n59:     fs.writeFileSync(eventPath, JSON.stringify(event), 'utf8');\n60:     const result = spawnSync(process.execPath, [\n61:       APPEND_GATEWAY,\n62:       '--mode', 'research',\n63:       '--run-directory', path.dirname(stateLogPath),\n64:       '--event-json', eventPath,\n65:     ], { cwd: REPOSITORY_ROOT, encoding: 'utf8' });\n66:     if (result.status !== 0) {\n67:       const outcome = String(result.stdout || '').trim().split('\\n').at(-1) || String(result.stderr || '').trim();\n68:       throw new Error(`[deep-research] append gateway refused the reducer's ${event.stem} row: ${outcome}`);\n69:     }\n70:   } finally {\n71:     fs.rmSync(eventDir, { recursive: true, force: true });\n72:   }\n73: }\n74: \n75: /**\n76:  * Record the reducer's own bookkeeping rows. A ledger-backed state log takes\n77:  * them through the append gateway as registered events, so the projection\n78:  * carries them; a state log with no ledger has no projection to replace it and\n79:  * keeps the direct append.\n80:  *\n81:  * @param {string} stateLogPath - The run's state log.\n82:  * @param {Object[]} rows - Legacy-shaped rows, as a direct append writes them.\n83:  * @param {(row: Object) => { stem: string, idempotencyKey: string }} identify - The row's stem and stable key.\n84:  */\n85: function recordReducerRows(stateLogPath, rows, identify) {\n86:   if (!rows.length) return;\n87:   if (!stateLogHasLedger(stateLogPath)) {\n88:     fs.appendFileSync(stateLogPath, `${rows.map((row) => JSON.stringify(row)).join('\\n')}\\n`, 'utf8');\n89:     return;\n90:   }\n91:   for (const row of rows) {\n92:     const { type: _type, event: _event, timestamp, ...data } = row;\n93:     const scopeId = ledgerScopeId(row.sessionId, stateLogPath);\n94:     const { stem, idempotencyKey } = identify(row);\n95:     appendThroughGateway(stateLogPath, {\n96:       stem,\n97:       scope: { runId: scopeId, lineageId: scopeId },\n98:       data,\n99:       occurredAt: timestamp,\n100:       idempotencyKey,\n101:     });\n102:   }\n103: }\n104: \n105: const DEFAULT_SPARKLINE_WIDTH = 20;\n106: const DEFAULT_TREND_FLATLINE_WINDOW = 3;\n107: const DEFAULT_REJECTED_PATTERN_CATEGORY = 'general';\n108: const DEFAULT_REJECTED_PATTERN_FUZZY_THRESHOLD = 0.85;\n109: const DEFAULT_MIN_IDEA_OBSERVATIONS = 2;\n110: const MIN_IDEA_OBSERVATIONS = 1;\n111: const MAX_IDEA_OBSERVATIONS = 10;\n112: const INBOX_FILE_NAME = 'inbox.jsonl';\n113: const DEFAULT_INBOX_SOURCE = 'research-inbox';\n114: const LEGACY_IMPORT_ORIGIN = 'legacy-import';\n115: const LEGACY_IMPORT_SOURCE = 'key-questions';\n116: const QUESTION_CONFLICT_EVENT = 'question_conflict';\n117: const DEFAULT_QUESTION_DECISION = 'needs_decision';\n118: const MAX_REJECTED_PATTERNS = 100;\n119: const REJECTED_PATTERN_CANDIDATE_FIELDS = ['text', 'focus', 'nextFocus', 'pattern', 'idea', 'title'];\n120: const REJECTED_PATTERN_EVENT_FIELDS = ['pattern', 'idea', 'text', 'candidate'];\n121: const IDEA_EVENT_TEXT_FIELDS = ['idea', 'text', 'title', 'pattern', 'candidate'];\n122: const IDEA_OBSERVED_EVENTS = new Set(['idea_observed', 'ideaObserved']);\n123: const IDEA_PROMOTED_EVENTS = new Set(['idea_promoted', 'ideaPromoted']);\n124: const IDEA_REJECTED_EVENTS = new Set(['idea_rejected', 'ideaRejected']);\n125: const IDEA_REJECTED_REMOVED_EVENTS = new Set(['idea_rejected_removed', 'ideaRejectedRemoved']);\n126: const IDEA_REJECTED_RESET_EVENTS = new Set(['idea_rejected_reset', 'ideaRejectedReset']);\n127: const VALID_QUESTION_ORIGINS = new Set([\n128:   'angle-bank',\n129:   'analyst-strategy',\n130:   'operator',\n131:   LEGACY_IMPORT_ORIGIN,\n132: ]);\n133: const VALID_QUESTION_DECISIONS = new Set([\n134:   'accepted',\n135:   'rejected',\n136:   'superseded',\n137:   DEFAULT_QUESTION_DECISION,\n138: ]);\n139: const SPARKLINE_BLOCKS = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];\n140: \n141: function readUtf8(filePath) {\n142:   return fs.readFileSync(filePath, 'utf8');\n143: }\n144: \n145: function writeUtf8(filePath, content) {\n146:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n147:   fs.writeFileSync(filePath, content, 'utf8');\n148: }\n149: \n150: function writeUtf8Atomic(filePath, content) {\n[Output truncated. Continue reading with offset: 151]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs\", \"limit\": 150}"},"time":{"start":1793094385806,"end":1793094386650}}}}
