gh\"\n  }\n]","metadata":{"todos":[{"content":"Initialize detached research lineage state","status":"completed","priority":"high"},{"content":"Run iteration 1: operation and pre-state inventory","status":"completed","priority":"high"},{"content":"Run iteration 2: destructive history and recovery risks","status":"completed","priority":"high"},{"content":"Run iteration 3: staging and commit semantics","status":"completed","priority":"high"},{"content":"Run iteration 4: worktree, remote, and account coordination","status":"completed","priority":"high"},{"content":"Run iteration 5: history-measured noise and recommendation threshold","status":"in_progress","priority":"high"},{"content":"Synthesize, validate, and close detached lineage","status":"pending","priority":"high"}],"truncated":false},"title":"2 todos","time":{"start":1785180998238,"end":1785180998240}},"metadata":{"openai":{"itemId":"fc_0c7c1bb65b42bb00016a67b343ea1c8191aca41154b7a7002a"}},"id":"prt_fa5144191001JnXycFg2FBTG28","sessionID":"ses_05b144ddbffeTP8bqXDQv88HuN","messageID":"msg_fa514249e001lRVqP5OqJ5DvtQ"}}
