,\n1621:     resolvedSandbox,\n1622:     resolvedPermission,\n1623:     webSearch: effectiveWebSearchPolicy(lineage),\n1624:   });\n1625: }\n1626: \n1627: function buildOpencodeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1628:   const model = lineage.model || 'anthropic/claude-opus-4-8';\n1629:   const args = [\n1630:     'run',\n1631:     '--model',\n1632:     model,\n1633:     '--format',\n1634:     'json',\n1635:     // The full runtime is required because the workflow writes isolated lineage state.\n1636:     '--dir',\n1637:     process.cwd(),\n1638:   ];\n1639:   const useDangerousBypass = resolvedSandbox === 'danger-full-access';\n1640:   if (useDangerousBypass) {\n1641:     args.push('--dangerously-skip-permissions');\n1642:     process.stderr.write(\n1643:       `FATAL WARN: lineage ${lineage.label || '(cli-opencode)'} runs with --dangerously-skip-permissions. `\n1644:         + `The lineageDir write boundary is prompt-only, not sandbox-enforced.\\n`,\n1645:     );\n1646:   }\n1647:   if (lineage.reasoningEffort) {\n1648:     args.push('--variant', lineage.reasoningEffort);\n1649:   }\n1650:   args.push(prompt);\n1651:   return finalizeLineageCommand({\n1652:     kind: lineage.kind,\n1653:     command: 'opencode',\n1654:     args,\n1655:     input: '',\n1656:     prompt,\n1657:     promptArgIndexes: [args.length - 1],\n1658:     executableVersion: resolveExecutableVersion('opencode', options),\n1659:     model,\n1660:     reasoningEffort: lineage.reasoningEffort || null,\n1661:     serviceTier: null,\n1662:     resolvedSandbox,\n1663:     resolvedPermission,\n1664:     webSearch: effectiveWebSearchPolicy(lineage),\n1665:   });\n1666: }\n1667: \n1668: // Mirrors CURSOR_SUPPORTED_MODELS in executor-config.ts. Duplicated as a plain\n1669: // JS literal (rather than dynamically imported) so buildCursorLineageCommand\n1670: // stays synchronous and directly unit-testable, matching this file's existing\n1671: // convention of hand-duplicating small per-kind cursor facts (see\n1672: // SPECKIT_STATE_ENV_BY_KIND above) instead of threading an async import\n1673: // through a sync call path.\n1674: const CURSOR_ALLOWED_MODELS = new Set([\n1675:   'cursor-grok-4.5-low',\n1676:   'cursor-grok-4.5-low-fast',\n1677:   'cursor-grok-4.5-medium',\n1678:   'cursor-grok-4.5-medium-fast',\n1679:   'cursor-grok-4.5-high',\n1680:   'cursor-grok-4.5-high-fast',\n1681:   'composer-2.5',\n1682:   'composer-2.5-fast',\n1683:   'glm-5.2-high',\n1684:   'glm-5.2-max',\n1685: ]);\n1686: const CURSOR_DEFAULT_MODEL = 'composer-2.5';\n1687: \n1688: // Mirrors PI_SUPPORTED_MODELS in executor-config.ts. Pi is a provider\n1689: // pass-through with no house model, so this synchronous duplicate keeps\n1690: // command construction fail-closed without importing the TypeScript module.\n1691: const PI_ALLOWED_MODELS = new Set([\n1692:   'deepseek-v4-pro',\n1693:   'minimax-m3',\n1694:   'gpt-5.6-luna',\n1695:   'gpt-5.6-sol',\n1696:   'gpt-5.6-terra',\n1697:   'mimo-v2.5-pro',\n1698:   'mimo-v2.5-pro-ultraspeed',\n1699: ]);\n1700: const PI_DEFAULT_MODEL = 'deepseek-v4-pro';\n1701: \n1702: function buildCursorLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1703:   if (!isCursorBinaryAvailable(options.env || process.env)) {\n1704:     throw inputError('cli-cursor executor unavailable: command -v cursor-agent failed');\n1705:   }\n1706:   const webSearch = effectiveWebSearchPolicy(lineage);\n1707:   const model = lineage.model || CURSOR_DEFAULT_MODEL;\n1708:   if (!CURSOR_ALLOWED_MODELS.has(model)) {\n1709:     throw inputError(\n1710:       `cli-cursor model '${model}' is not in the enforced allowlist: ${[...CURSOR_ALLOWED_MODELS].join(', ')}`,\n1711:     );\n1712:   }\n1713:   // Cursor has no --reasoning-effort flag and rejects the parameterized\n1714:   // model[effort=...] bracket outright (\"Cannot use this model\", live-verified\n1715:   // 2026-07-24 against cursor-agent 2026.07.23-e383d2b) — effort tiers are baked\n1716:   // into the model id itself (e.g. gpt-5.2-high), so reasoningEffort is never\n1717:   // forwarded here (also unsupported at the executor-config.ts flag-support\n1718:   // layer). The approval-flag mapping below intentionally mirrors\n1719:   // resolveCursorApprovalMode() in executor-config.ts (kept independent rather\n1720:   // than imported, matching how the codex/opencode adapters above already\n1721:   // derive their own kind-specific flags from resolvedSandbox rather than\n1722:   // calling a shared resolver): read-only leaves Cursor's own prompt-and-block\n1723:   // default in place (no flag — nothing unattended can answer the prompt),\n1724:   // workspace-write uses --auto-review (\"Smart Auto\"), danger-full-access uses\n1725:   // --force (\"Run Everything\"). --sandbox tracks the same 2-way OS toggle.\n1726:   const args = ['-p', prompt, '--output-format', 'text', '--model', model];\n1727:   if (resolvedSandbox === 'danger-full-access') {\n1728:     args.push('--force', '--sandbox', 'disabled');\n1729:   } else if (resolvedSandbox === 'read-only') {\n1730:     args.push('--sandbox', 'enabled');\n1731:   } else {\n1732:     args.push('--auto-review', '--sandbox', 'enabled');\n1733:   }\n1734:   return finalizeLineageCommand({\n1735:     kind: lineage.kind,\n1736:     command: 'cursor-agent',\n1737:     args,\n1738:     input: undefined,\n1739:     prompt,\n1740:     promptArgIndexes: [1],\n1741:     executableVersion: resolveExecutableVersion('cursor-agent', options),\n1742:     model,\n1743:     reasoningEffort: null,\n1744:     serviceTier: null,\n1745:     resolvedSandbox,\n1746:     resolvedPermission,\n1747:     webSearch,\n1748:   });\n1749: }\n1750: \n1751: // Mirrors DEVIN_SUPPORTED_MODELS in executor-config.ts, duplicated as a plain JS\n1752: // literal for the same reason CURSOR_ALLOWED_MODELS is: buildDevinLineageCommand\n1753: // stays synchronous and directly unit-testable.\n1754: const DEVIN_ALLOWED_MODELS = new Set([\n1755:   'adaptive',\n1756:   'opus',\n1757:   'sonnet',\n1758:   'claude',\n1759:   'haiku',\n1760:   'swe',\n1761:   'gpt',\n1762:   'gemini',\n1763:   'codex',\n1764:   'glm-5-2',\n1765:   'glm-5-2-max',\n1766:   'glm-5-2-1m',\n1767:   'swe-1-7',\n1768:   'swe-1-7-medium',\n1769:   'swe-1-6',\n1770: ]);\n1771: const DEVIN_DEFAULT_MODEL = 'adaptive';\n1772: \n1773: function buildDevinLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1774:   if (!isDevinBinaryAvailable(options.env || process.env)) {\n1775:     throw inputError('cli-devin executor unavailable: command -v devin failed');\n1776:   }\n1777:   const webSearch = effectiveWebSearchPolicy(lineage);\n1778:   const model = lineage.model || DEVIN_DEFAULT_MODEL;\n1779:   if (!DEVIN_ALLOWED_MODELS.has(model)) {\n1780:     throw inputError(\n1781:       `cli-devin model '${model}' is not in the enforced allowlist: ${[...DEVIN_ALLOWED_MODELS].join(', ')}`,\n1782:     );\n1783:   }\n1784:   // Devin has no --reasoning-effort and no service-tier flag: both the thinking\n1785:   // tier and priority routing are encoded in the model uid itself (`glm-5-2` vs\n1786:   // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority`), so\n1787:   // reasoningEffort/serviceTier are never forwarded here — matching the\n1788:   // flag-support declaration in executor-config.ts.\n1789:   //\n1790:   // Permission mapping, from the live `devin --help` mode descriptions: \"auto\"\n1791:   // auto-approves read-only tools, \"accept-edits\" also auto-approves workspace\n1792:   // edits, \"dangerous\" auto-approves all tools. --sandbox is a boolean opt-in\n1793:   // that enforces the active Read/Write scopes at the OS level, so it is set for\n1794:   // the two bounded modes and dropped for full access.\n1795:   const args = ['-p', prompt, '--model', model];\n1796:   if (resolvedSandbox === 'danger-full-access') {\n1797:     args.push('--permission-mode', 'dangerous');\n1798:   } else if (resolvedSandbox === 'read-only') {\n1799:     args.push('--permission-mode', 'auto', '--sandbox');\n1800:   } else {\n1801:     args.push('--permission-mode', 'accept-edits', '--sandbox');\n1802:   }\n1803:   return finalizeLineageCommand({\n1804:     kind: lineage.kind,\n1805:     command: 'devin',\n1806:     args,\n1807:     input: undefined,\n1808:     prompt,\n1809:     promptArgIndexes: [1],\n1810:     executableVersion: resolveExecutableVersion('devin', options),\n1811:     model,\n1812:     reasoningEffort: null,\n1813:     serviceTier: null,\n1814:     resolvedSandbox,\n1815:     resolvedPermission,\n1816:     webSearch,\n1817:   });\n1818: }\n1819: \n1820: function buildPiLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1821:   if (!isPiBinaryAvailable(options.env || process.env)) {\n1822:     throw inputError('cli-pi executor unavailable: command -v pi failed');\n1823:   }\n1824:   const model = lineage.model || PI_DEFAULT_MODEL;\n1825:   if (!PI_ALLOWED_MODELS.has(model)) {\n1826:     throw inputError(\n1827:       `cli-pi model '${model}' is not in the enforced allowlist: ${[...PI_ALLOWED_MODELS].join(', ')}`,\n1828:     );\n1829:   }\n1830:   // TODO: Build args only after Pi's headless command contract is confirmed.\n1831:   // Do not treat a subprocess exit code alone as proof of a successful dispatch.\n1832:   throw inputError('cli-pi command construction is unavailable until its headless invocation contract is confirmed');\n1833: }\n1834: \n1835: const LINEAGE_COMMAND_ADAPTERS = Object.freeze({\n1836:   native: buildNativeLineageCommand,\n1837:   'cli-codex': buildCodexLineageCommand,\n1838:   'cli-claude-code': buildClaudeLineageCommand,\n1839:   'cli-opencode': buildOpencodeLineageCommand,\n1840:   'cli-cursor': buildCursorLineageCommand,\n1841:   'cli-devin': buildDevinLineageCommand,\n1842:   'cli-pi': buildPiLineageCommand,\n1843: });\n1844: \n1845: /**\n1846:  * Build the subprocess command and deterministic invocation identity for a lineage.\n1847:  *\n1848:  * @returns {{command:string,args:string[],input?:string,effectiveConfig:Object,invocationFingerprint:string}}\n1849:  */\n1850: function buildLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options = {}) {\n1851:   const adapter = LINEAGE_COMMAND_ADAPTERS[lineage.kind];\n1852:   if (!adapter) {\n1853:     throw inputError(`Unknown fan-out executor kind: ${lineage.kind}`);\n1854:   }\n1855:   return adapter(lineage, prompt, resolvedSandbox, resolvedPermission, options);\n1856: }\n1857: \n1858: function isCodexBinaryAvailable(env = process.env) {\n1859:   const result = spawnSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], {\n1860:     env,\n1861:     stdio: 'ignore',\n1862:   });\n1863:   return result.status === 0;\n1864: }\n1865: \n1866: // `cursor-agent -p` exits 0 even on an auth failure, so this PATH preflight is\n1867: // the only availability signal buildCursorLineageCommand may use — never the\n1868: // dispatch exit code.\n1869: function isCursorBinaryAvailable(env = process.env) {\n1870:   const result = spawnSync('/bin/sh', ['-c', 'command -v cursor-agent >/dev/null 2>&1'], {\n1871:     env,\n1872:     stdio: 'ignore',\n1873:   });\n1874:   return result.status === 0;\n1875: }\n1876: \n1877: // PATH preflight only. Devin auth lives in a credentials file rather than the\n1878: // environment, so an authenticated shell and an unauthenticated one look\n1879: // identical here — `devin auth status` is the operator-facing check, not\n\n(Showing lines 1580-1879 of 2516. Use offset=1880 to continue.)\n</content>","metadata":{"preview":"    executableVersion: resolveExecutableVersion('claude', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildNativeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  // Native fan-out uses the command host so the workflow owns init, loop, and synthesis.\n  const args = [\n    'run',\n    '--format',\n    'json',\n    '--dangerously-skip-permissions',\n    '--dir',\n    process.cwd(),\n    '--command',","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","text":"    executableVersion: resolveExecutableVersion('claude', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildNativeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  // Native fan-out uses the command host so the workflow owns init, loop, and synthesis.\n  const args = [\n    'run',\n    '--format',\n    'json',\n    '--dangerously-skip-permissions',\n    '--dir',\n    process.cwd(),\n    '--command',\n    `deep/${options.loopType || 'review'}`,\n  ];\n  const commandInput = buildNativeCommandInput(\n    options.loopType || 'review',\n    options.specFolder || '',\n    options.lineageDir || '',\n    lineage,\n    options,\n  );\n  args.push(commandInput);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'opencode',\n    args,\n    input: '',\n    prompt: commandInput,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('opencode', options),\n    model: null,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildOpencodeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  const model = lineage.model || 'anthropic/claude-opus-4-8';\n  const args = [\n    'run',\n    '--model',\n    model,\n    '--format',\n    'json',\n    // The full runtime is required because the workflow writes isolated lineage state.\n    '--dir',\n    process.cwd(),\n  ];\n  const useDangerousBypass = resolvedSandbox === 'danger-full-access';\n  if (useDangerousBypass) {\n    args.push('--dangerously-skip-permissions');\n    process.stderr.write(\n      `FATAL WARN: lineage ${lineage.label || '(cli-opencode)'} runs with --dangerously-skip-permissions. `\n        + `The lineageDir write boundary is prompt-only, not sandbox-enforced.\\n`,\n    );\n  }\n  if (lineage.reasoningEffort) {\n    args.push('--variant', lineage.reasoningEffort);\n  }\n  args.push(prompt);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'opencode',\n    args,\n    input: '',\n    prompt,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('opencode', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\n// Mirrors CURSOR_SUPPORTED_MODELS in executor-config.ts. Duplicated as a plain\n// JS literal (rather than dynamically imported) so buildCursorLineageCommand\n// stays synchronous and directly unit-testable, matching this file's existing\n// convention of hand-duplicating small per-kind cursor facts (see\n// SPECKIT_STATE_ENV_BY_KIND above) instead of threading an async import\n// through a sync call path.\nconst CURSOR_ALLOWED_MODELS = new Set([\n  'cursor-grok-4.5-low',\n  'cursor-grok-4.5-low-fast',\n  'cursor-grok-4.5-medium',\n  'cursor-grok-4.5-medium-fast',\n  'cursor-grok-4.5-high',\n  'cursor-grok-4.5-high-fast',\n  'composer-2.5',\n  'composer-2.5-fast',\n  'glm-5.2-high',\n  'glm-5.2-max',\n]);\nconst CURSOR_DEFAULT_MODEL = 'composer-2.5';\n\n// Mirrors PI_SUPPORTED_MODELS in executor-config.ts. Pi is a provider\n// pass-through with no house model, so this synchronous duplicate keeps\n// command construction fail-closed without importing the TypeScript module.\nconst PI_ALLOWED_MODELS = new Set([\n  'deepseek-v4-pro',\n  'minimax-m3',\n  'gpt-5.6-luna',\n  'gpt-5.6-sol',\n  'gpt-5.6-terra',\n  'mimo-v2.5-pro',\n  'mimo-v2.5-pro-ultraspeed',\n]);\nconst PI_DEFAULT_MODEL = 'deepseek-v4-pro';\n\nfunction buildCursorLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isCursorBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-cursor executor unavailable: command -v cursor-agent failed');\n  }\n  const webSearch = effectiveWebSearchPolicy(lineage);\n  const model = lineage.model || CURSOR_DEFAULT_MODEL;\n  if (!CURSOR_ALLOWED_MODELS.has(model)) {\n    throw inputError(\n      `cli-cursor model '${model}' is not in the enforced allowlist: ${[...CURSOR_ALLOWED_MODELS].join(', ')}`,\n    );\n  }\n  // Cursor has no --reasoning-effort flag and rejects the parameterized\n  // model[effort=...] bracket outright (\"Cannot use this model\", live-verified\n  // 2026-07-24 against cursor-agent 2026.07.23-e383d2b) — effort tiers are baked\n  // into the model id itself (e.g. gpt-5.2-high), so reasoningEffort is never\n  // forwarded here (also unsupported at the executor-config.ts flag-support\n  // layer). The approval-flag mapping below intentionally mirrors\n  // resolveCursorApprovalMode() in executor-config.ts (kept independent rather\n  // than imported, matching how the codex/opencode adapters above already\n  // derive their own kind-specific flags from resolvedSandbox rather than\n  // calling a shared resolver): read-only leaves Cursor's own prompt-and-block\n  // default in place (no flag — nothing unattended can answer the prompt),\n  // workspace-write uses --auto-review (\"Smart Auto\"), danger-full-access uses\n  // --force (\"Run Everything\"). --sandbox tracks the same 2-way OS toggle.\n  const args = ['-p', prompt, '--output-format', 'text', '--model', model];\n  if (resolvedSandbox === 'danger-full-access') {\n    args.push('--force', '--sandbox', 'disabled');\n  } else if (resolvedSandbox === 'read-only') {\n    args.push('--sandbox', 'enabled');\n  } else {\n    args.push('--auto-review', '--sandbox', 'enabled');\n  }\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'cursor-agent',\n    args,\n    input: undefined,\n    prompt,\n    promptArgIndexes: [1],\n    executableVersion: resolveExecutableVersion('cursor-agent', options),\n    model,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\n// Mirrors DEVIN_SUPPORTED_MODELS in executor-config.ts, duplicated as a plain JS\n// literal for the same reason CURSOR_ALLOWED_MODELS is: buildDevinLineageCommand\n// stays synchronous and directly unit-testable.\nconst DEVIN_ALLOWED_MODELS = new Set([\n  'adaptive',\n  'opus',\n  'sonnet',\n  'claude',\n  'haiku',\n  'swe',\n  'gpt',\n  'gemini',\n  'codex',\n  'glm-5-2',\n  'glm-5-2-max',\n  'glm-5-2-1m',\n  'swe-1-7',\n  'swe-1-7-medium',\n  'swe-1-6',\n]);\nconst DEVIN_DEFAULT_MODEL = 'adaptive';\n\nfunction buildDevinLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isDevinBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-devin executor unavailable: command -v devin failed');\n  }\n  const webSearch = effectiveWebSearchPolicy(lineage);\n  const model = lineage.model || DEVIN_DEFAULT_MODEL;\n  if (!DEVIN_ALLOWED_MODELS.has(model)) {\n    throw inputError(\n      `cli-devin model '${model}' is not in the enforced allowlist: ${[...DEVIN_ALLOWED_MODELS].join(', ')}`,\n    );\n  }\n  // Devin has no --reasoning-effort and no service-tier flag: both the thinking\n  // tier and priority routing are encoded in the model uid itself (`glm-5-2` vs\n  // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority`), so\n  // reasoningEffort/serviceTier are never forwarded here — matching the\n  // flag-support declaration in executor-config.ts.\n  //\n  // Permission mapping, from the live `devin --help` mode descriptions: \"auto\"\n  // auto-approves read-only tools, \"accept-edits\" also auto-approves workspace\n  // edits, \"dangerous\" auto-approves all tools. --sandbox is a boolean opt-in\n  // that enforces the active Read/Write scopes at the OS level, so it is set for\n  // the two bounded modes and dropped for full access.\n  const args = ['-p', prompt, '--model', model];\n  if (resolvedSandbox === 'danger-full-access') {\n    args.push('--permission-mode', 'dangerous');\n  } else if (resolvedSandbox === 'read-only') {\n    args.push('--permission-mode', 'auto', '--sandbox');\n  } else {\n    args.push('--permission-mode', 'accept-edits', '--sandbox');\n  }\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'devin',\n    args,\n    input: undefined,\n    prompt,\n    promptArgIndexes: [1],\n    executableVersion: resolveExecutableVersion('devin', options),\n    model,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\nfunction buildPiLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isPiBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-pi executor unavailable: command -v pi failed');\n  }\n  const model = lineage.model || PI_DEFAULT_MODEL;\n  if (!PI_ALLOWED_MODELS.has(model)) {\n    throw inputError(\n      `cli-pi model '${model}' is not in the enforced allowlist: ${[...PI_ALLOWED_MODELS].join(', ')}`,\n    );\n  }\n  // TODO: Build args only after Pi's headless command contract is confirmed.\n  // Do not treat a subprocess exit code alone as proof of a successful dispatch.\n  throw inputError('cli-pi command construction is unavailable until its headless invocation contract is confirmed');\n}\n\nconst LINEAGE_COMMAND_ADAPTERS = Object.freeze({\n  native: buildNativeLineageCommand,\n  'cli-codex': buildCodexLineageCommand,\n  'cli-claude-code': buildClaudeLineageCommand,\n  'cli-opencode': buildOpencodeLineageCommand,\n  'cli-cursor': buildCursorLineageCommand,\n  'cli-devin': buildDevinLineageCommand,\n  'cli-pi': buildPiLineageCommand,\n});\n\n/**\n * Build the subprocess command and deterministic invocation identity for a lineage.\n *\n * @returns {{command:string,args:string[],input?:string,effectiveConfig:Object,invocationFingerprint:string}}\n */\nfunction buildLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options = {}) {\n  const adapter = LINEAGE_COMMAND_ADAPTERS[lineage.kind];\n  if (!adapter) {\n    throw inputError(`Unknown fan-out executor kind: ${lineage.kind}`);\n  }\n  return adapter(lineage, prompt, resolvedSandbox, resolvedPermission, options);\n}\n\nfunction isCodexBinaryAvailable(env = process.env) {\n  const result = spawnSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], {\n    env,\n    stdio: 'ignore',\n  });\n  return result.status === 0;\n}\n\n// `cursor-agent -p` exits 0 even on an auth failure, so this PATH preflight is\n// the only availability signal buildCursorLineageCommand may use — never the\n// dispatch exit code.\nfunction isCursorBinaryAvailable(env = process.env) {\n  const result = spawnSync('/bin/sh', ['-c', 'command -v cursor-agent >/dev/null 2>&1'], {\n    env,\n    stdio: 'ignore',\n  });\n  return result.status === 0;\n}\n\n// PATH preflight only. Devin auth lives in a credentials file rather than the\n// environment, so an authenticated shell and an unauthenticated one look\n// identical here — `devin auth status` is the operator-facing check, not","lineStart":1580,"lineEnd":1879,"totalLines":2516,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","time":{"start":1785178474524,"end":1785178474530}},"metadata":{"openai":{"itemId":"fc_0bf6e445cc87d13f016a67a96981dc819195e41cec6c261f66"}},"id":"prt_fa4edc436001ItIyHGTeeFY4oe","sessionID":"ses_05b144ddbffeTP8bqXDQv88HuN","messageID":"msg_fa4edb8ae001F6uNSLVZ3OUaip"}}
