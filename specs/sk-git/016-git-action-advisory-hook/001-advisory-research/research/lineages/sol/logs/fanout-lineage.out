tionId\": null,\n71:       \"addedAtIteration\": 0,\n72:       \"resolvedAtIteration\": 5,\n73:       \"resolved\": true\n74:     }\n75:   ],\n76:   \"openQuestions\": [],\n77:   \"resolvedQuestions\": [\n78:     {\n79:       \"id\": \"question-1-what-is-the-complete-12-skill-by-eight-file-root-level-census-and-who-produces-e\",\n80:       \"inboxId\": null,\n81:       \"text\": \"What is the complete 12-skill by eight-file root-level census, and who produces each file type?\",\n82:       \"origin\": \"legacy-import\",\n83:       \"source\": \"key-questions\",\n84:       \"injectedAtIteration\": 0,\n85:       \"promotedQuestionId\": null,\n86:       \"addedAtIteration\": 0,\n87:       \"resolvedAtIteration\": 1\n88:     },\n89:     {\n90:       \"id\": \"question-2-what-schema-and-complete-consumer-call-site-set-governs-each-file-type-including\",\n91:       \"inboxId\": null,\n92:       \"text\": \"What schema and complete consumer call-site set governs each file type, including advisor, benchmark, doctor, and tests?\",\n93:       \"origin\": \"legacy-import\",\n94:       \"source\": \"key-questions\",\n95:       \"injectedAtIteration\": 0,\n96:       \"promotedQuestionId\": null,\n97:       \"addedAtIteration\": 0,\n98:       \"resolvedAtIteration\": 3\n99:     },\n100:     {\n101:       \"id\": \"question-3-what-consumer-derived-skill-class-taxonomy-maps-all-12-skills-and-makes-each-pre\",\n102:       \"inboxId\": null,\n103:       \"text\": \"What consumer-derived skill class taxonomy maps all 12 skills and makes each presence difference either required, optional by class, or defective?\",\n104:       \"origin\": \"legacy-import\",\n105:       \"source\": \"key-questions\",\n106:       \"injectedAtIteration\": 0,\n107:       \"promotedQuestionId\": null,\n108:       \"addedAtIteration\": 0,\n109:       \"resolvedAtIteration\": 4\n110:     },\n111:     {\n112:       \"id\": \"question-4-how-should-the-five-graph-only-skills-leaf-aliases-json-command-metadata-json-an\",\n113:       \"inboxId\": null,\n114:       \"text\": \"How should the five graph-only skills, `leaf-aliases.json`, `command-metadata.json`, and sparse `sk-git` be classified after behavior-impact checks?\",\n115:       \"origin\": \"legacy-import\",\n116:       \"source\": \"key-questions\",\n117:       \"injectedAtIteration\": 0,\n118:       \"promotedQuestionId\": null,\n119:       \"addedAtIteration\": 0,\n120:       \"resolvedAtIteration\": 5\n121:     },\n122:     {\n123:       \"id\": \"question-5-where-should-the-canonical-contract-live-in-sk-doc-create-skill-what-can-be-gene\",\n124:       \"inboxId\": null,\n125:       \"text\": \"Where should the canonical contract live in `sk-doc/create-skill`, what can be generated/backfilled, and what fleet-wide presence-plus-freshness gate should enforce it?\",\n126:       \"origin\": \"legacy-import\",\n127:       \"source\": \"key-questions\",\n128:       \"injectedAtIteration\": 0,\n129:       \"promotedQuestionId\": null,\n130:       \"addedAtIteration\": 0,\n131:       \"resolvedAtIteration\": 5\n132:     }\n133:   ],\n134:   \"carriedForwardOpenQuestions\": [\n135:     {\n136:       \"text\": \"What complete consumer and schema set governs each type?\",\n137:       \"addedAtIteration\": 1,\n138:       \"source\": \"iteration-markdown\"\n139:     },\n140:     {\n141:       \"text\": \"What behavior impact determines whether graph-only, alias, command, and sparse cases are required, optional, or defective?\",\n142:       \"addedAtIteration\": 1,\n143:       \"source\": \"iteration-markdown\"\n144:     },\n145:     {\n146:       \"text\": \"What class taxonomy explains every presence difference?\",\n147:       \"addedAtIteration\": 1,\n148:       \"source\": \"iteration-markdown\"\n149:     },\n150:     {\n151:       \"text\": \"Which consumer or history evidence conclusively owns `command-metadata.json`?\",\n152:       \"addedAtIteration\": 1,\n153:       \"source\": \"iteration-markdown\"\n154:     },\n155:     {\n156:       \"text\": \"Where should the canonical contract and fleet enforcement live?\",\n157:       \"addedAtIteration\": 1,\n158:       \"source\": \"iteration-markdown\"\n159:     },\n160:     {\n161:       \"text\": \"What schemas and complete consumer sets govern `leaf-manifest.json`, `leaf-manifest.config.json`, `leaf-aliases.json`, and `command-metadata.json`?\",\n162:       \"addedAtIteration\": 2,\n163:       \"source\": \"iteration-markdown\"\n164:     },\n165:     {\n166:       \"text\": \"Where should the canonical contract and fleet-wide freshness gate live?\",\n167:       \"addedAtIteration\": 2,\n168:       \"source\": \"iteration-markdown\"\n169:     },\n170:     {\n171:       \"text\": \"What consumer-derived class taxonomy explains all 12 roots?\",\n172:       \"addedAtIteration\": 2,\n173:       \"source\": \"iteration-markdown\"\n174:     },\n175:     {\n176:       \"text\": \"Which exceptional presence cases are required, optional, or defective?\",\n177:       \"addedAtIteration\": 2,\n178:       \"source\": \"iteration-markdown\"\n179:     },\n180:     {\n181:       \"text\": \"What consumer-derived skill class taxonomy maps all 12 roots and classifies every presence difference?\",\n182:       \"addedAtIteration\": 3,\n183:       \"source\": \"iteration-markdown\"\n184:     },\n185:     {\n186:       \"text\": \"Where should the canonical contract and fleet-wide presence-plus-freshness gate live?\",\n187:       \"addedAtIteration\": 3,\n188:       \"source\": \"iteration-markdown\"\n189:     },\n190:     {\n191:       \"text\": \"Which exceptional graph-only, alias, command, and sparse cases are required, optional, or defective?\",\n192:       \"addedAtIteration\": 3,\n193:       \"source\": \"iteration-markdown\"\n194:     },\n195:     {\n196:       \"text\": \"Where should the canonical two-class contract live, what can be generated/backfilled, and what presence-plus-freshness gate should enforce it?\",\n197:       \"addedAtIteration\": 4,\n198:       \"source\": \"iteration-markdown\"\n199:     },\n200:     {\n201:       \"text\": \"No key research questions remain. Implementation still must prove the proposed classifier and gate against all 12 live roots and negative fixtures.\",\n202:       \"addedAtIteration\": 5,\n203:       \"source\": \"iteration-markdown\"\n204:     }\n205:   ],\n206:   \"uncoveredQuestions\": [],\n207:   \"keyFindings\": [\n208:     {\n209:       \"id\": \"finding-1-5-command-metadata-json-is-a-singleton-confined-to-sk-design-its-two-entries-descr\",\n210:       \"text\": \"`command-metadata.json` is a singleton confined to `sk-design`; its two entries describe `/interface:design` and `/interface:design-reference`. No producer reference was found in `sk-doc/create-command` or `.opencode/commands`, so current evidence classifies it as hand-authored, not generated; this classification should remain provisional until consumer/schema research traces its ownership history. [SOURCE: .opencode/skills/sk-design/command-metadata.json:1-16] [SOURCE: .opencode/skills/sk-design/command-metadata.json:374-386] [INFERENCE: exact searches for `command-metadata` under `.opencode/skills/sk-doc/create-command` and `.opencode/commands` returned no matches]\",\n211:       \"addedAtIteration\": 1,\n212:       \"sources\": [\n213:         \"`.opencode/skills/` direct directory inventory\",\n214:         \"`Glob .opencode/skills/*/*.json`\",\n215:         \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n216:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n217:         \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n218:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n219:         \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n220:       ]\n221:     },\n222:     {\n223:       \"id\": \"finding-1-4-leaf-manifest-json-is-the-one-clearly-derived-artifact-generate-leaf-manifest-cj\",\n224:       \"text\": \"`leaf-manifest.json` is the one clearly derived artifact: `generate-leaf-manifest.cjs --write` builds it from `mode-registry.json` for hubs or from `leaf-manifest.config.json` for registry-less standalone skills, optionally incorporating authored `leaf-aliases.json` for hubs, and writes canonical bytes. The script explicitly calls aliases “authored,” while standalone config is an input declaration rather than generated output. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-19] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:50-68] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:173-218]\",\n225:       \"addedAtIteration\": 1,\n226:       \"sources\": [\n227:         \"`.opencode/skills/` direct directory inventory\",\n228:         \"`Glob .opencode/skills/*/*.json`\",\n229:         \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n230:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n231:         \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n232:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n233:         \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n234:       ]\n235:     },\n236:     {\n237:       \"id\": \"finding-1-2-fleet-totals-are-description-json-7-12-graph-metadata-json-12-12-leaf-manifest-j\",\n238:       \"text\": \"Fleet totals are: `description.json` 7/12, `graph-metadata.json` 12/12, `leaf-manifest.json` 11/12, `leaf-manifest.config.json` 4/12, `leaf-aliases.json` 5/12, `mode-registry.json` 7/12, `hub-router.json` 7/12, and `command-metadata.json` 1/12. Thus `graph-metadata.json` is the only universally present type; `sk-git` is the sole graph-only root. [INFERENCE: arithmetic over the exact matrix in Finding 1; the `sk-git` graph node is present at `.opencode/skills/sk-git/graph-metadata.json:1`]\",\n239:       \"addedAtIteration\": 1,\n240:       \"sources\": [\n241:         \"`.opencode/skills/` direct directory inventory\",\n242:         \"`Glob .opencode/skills/*/*.json`\",\n243:         \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n244:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n245:         \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n246:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n247:         \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n248:       ]\n249:     },\n250:     {\n251:       \"id\": \"finding-1-3-four-file-types-have-explicit-parent-hub-scaffold-producer-evidence-init-skill-p\",\n252:       \"text\": \"Four file types have explicit parent-hub scaffold producer evidence: `init_skill.py --kind parent` writes `mode-registry.json`, `hub-router.json`, `graph-metadata.json`, and `description.json` at the new hub root. These are scaffold outputs, though their checked-in values remain author-maintained after creation. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/init_skill.py:528-553]\",\n253:       \"addedAtIteration\": 1,\n254:       \"sources\": [\n255:         \"`.opencode/skills/` direct directory inventory\",\n256:         \"`Glob .opencode/skills/*/*.json`\",\n257:         \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n258:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n259:         \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n260:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n261:         \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n262:       ]\n263:     },\n264:     {\n265:       \"id\": \"finding-1-1-the-exact-root-level-census-is-below-y-means-the-direct-child-file-exists-means-\",\n266:       \"text\": \"The exact root-level census is below. `Y` means the direct-child file exists; `—` means the exact direct-child glob returned no such file. Nested packet/mode metadata was excluded. [INFERENCE: exact direct-child inventory from `Glob .opencode/skills/*/*.json`, cross-checked against the 12 entries returned by reading `.opencode/skills/`]\",\n267:       \"addedAtIteration\": 1,\n268:       \"sources\": [\n269:         \"`.opencode/skills/` direct directory inventory\",\n270:         \"`Glob .opencode/skills/*/*.json`\",\n271:         \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n272:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n273:         \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n274:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n275:         \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n276:       ]\n277:     },\n278:     {\n279:       \"id\": \"finding-2-2-graph-metadata-json-is-the-advisor-s-only-direct-root-identity-scoring-source-am\",\n280:       \"text\": \"`graph-metadata.json` is the advisor's only direct root identity/scoring source among these four: the indexer parses every discovered skill-shaped file, enforces one non-nested identity, and stores node domains, intent signals, derived metadata, and graph edges in SQLite; scorer lanes consume that projection rather than `description.json`. Doctor independently enforces one root graph file, folder identity, family, and no nested graph/description identities; benchmark vocabulary sync also reads graph trigger phrases. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:946-1005] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:1037-1133] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:252-313] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/parent-hub-vocab-sync.cjs:322-354]\",\n281:       \"addedAtIteration\": 2,\n282:       \"sources\": [\n283:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n284:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n285:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n286:         \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n287:         \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n288:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n289:         \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n290:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n291:         \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n292:       ]\n293:     },\n294:     {\n295:       \"id\": \"finding-2-4-hub-router-json-is-the-declarative-routing-table-its-required-top-level-shape-is\",\n296:       \"text\": \"`hub-router.json` is the declarative routing table. Its required top-level shape is `skill`, `version`, `routerPolicy`, `routerSignals`, and `vocabularyClasses`; signal keys must equal registry modes, classes and resources must resolve, tie-break must be an exact mode permutation, and outcomes/default mode must conform. Production consumers are benchmark `projectHubRouter`, vocabulary sync, doctor check 5, the compiled-route manifest and per-hub compilers, plus the hub's own SKILL router. [SOURCE: .opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-57] [SOURCE: .opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:160-178] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:803-934] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:127-163] [SOURCE: .opencode/bin/lib/compiled-route-manifest.cjs:400-434]\",\n297:       \"addedAtIteration\": 2,\n298:       \"sources\": [\n299:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n300:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n301:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n302:         \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n303:         \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n304:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n305:         \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n306:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n307:         \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n308:       ]\n309:     },\n310:     {\n311:       \"id\": \"finding-2-3-mode-registry-json-is-the-packet-source-of-truth-not-advisor-identity-metadata-i\",\n312:       \"text\": \"`mode-registry.json` is the packet source of truth, not advisor identity metadata. Its canonical schema is one `modes[]` array whose entries carry `workflowMode`, `packetKind`, `backendKind`, `toolSurface`, packet/name identity, aliases, and `advisorRouting`, with optional declared extensions. Production consumers are: create-skill's leaf-manifest generator; doctor packet/discriminator/alias/tool validation; advisor executor delegation for CLI mode aliases; generated deep-loop advisor projection; benchmark router replay and vocabulary sync; and compiled-routing manifest/compiler inputs. [SOURCE: .opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-registry-template.json:1-20] [SOURCE: .opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-registry-template.json:21-164] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:174-193] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:316-411] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:160-180] [SOURCE: .opencode/skills/system-skill-advisor/feature-catalog/scorer-fusion/projection.md:24-30]\",\n313:       \"addedAtIteration\": 2,\n314:       \"sources\": [\n315:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n316:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n317:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n318:         \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n319:         \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n320:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n321:         \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n322:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n323:         \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n324:       ]\n325:     },\n326:     {\n327:       \"id\": \"finding-2-5-tests-and-fixtures-verify-consumers-but-are-not-themselves-production-consumers-\",\n328:       \"text\": \"Tests and fixtures verify consumers but are not themselves production consumers: parent-check mutation tests red invalid graph family, duplicate registry aliases, router defaults, and description registry duplication; compiled-manifest tests require exactly `SKILL.md`, registry, and router inputs and fail closed on missing/malformed/mismatched files. No production advisor code in the targeted `mcp-server` search read skill `description.json`; current evidence therefore classifies it as scaffold/doctor/discovery prose rather than a scorer input. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105] [SOURCE: .opencode/bin/tests/compiled-route-manifest.test.cjs:49-79] [SOURCE: .opencode/bin/tests/compiled-route-manifest.test.cjs:191-229] [INFERENCE: the targeted production search under `.opencode/skills/system-skill-advisor/mcp-server` found graph and mode-registry consumers but no skill-root `description.json` consumer]\",\n329:       \"addedAtIteration\": 2,\n330:       \"sources\": [\n331:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n332:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n333:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n334:         \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n335:         \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n336:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n337:         \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n338:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n339:         \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n340:       ]\n341:     },\n342:     {\n343:       \"id\": \"finding-2-1-the-two-identity-filenames-do-not-imply-one-shared-schema-skill-description-json\",\n344:       \"text\": \"The two identity filenames do not imply one shared schema. Skill `description.json` has a small hub-facing contract: `name`, `description`, `version`, and array-valued `keywords` are enforced; `modes` and `backend_kinds` are forbidden duplicate sources of registry truth. The scaffold additionally recommends `importance_tier`, `trigger_examples`, `lastUpdated`, and hub-specific arrays, but doctor does not require them. Skill `graph-metadata.json` is identified by `skill_id`, `family`, or `edges`, then strictly requires schema version 1 or 2, folder-matching `skill_id`, an allowed family, category, domains, intent signals, derived data, and typed edges. This content discriminator is what excludes same-named spec continuity metadata from advisor ingestion. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1020-1045] [SOURCE: .opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-description-template.json:1-32] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:960-979]\",\n345:       \"addedAtIteration\": 2,\n346:       \"sources\": [\n347:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n348:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n349:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n350:         \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n351:         \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n352:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n353:         \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n354:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n355:         \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n356:       ]\n357:     },\n358:     {\n359:       \"id\": \"finding-3-5-command-metadata-json-remains-an-authored-sk-design-specific-contract-rather-tha\",\n360:       \"text\": \"`command-metadata.json` remains an authored, `sk-design`-specific contract rather than a fleet schema. Its validator requires an array containing exactly the two `/interface:*` records, all 27 named top-level fields, registry-matching `ownerMode`/command bindings, typed nested argument/choreography/policy/output structures, unique commands/aliases, and graph consistency. Git history introduces the file in commit `2aa5fcff4a` as an `sk-design` metadata SSOT, with no generator. The prompt's “four consumers” is accurate only when the validator and its unit test are grouped as one surface: current source contains five direct reader files across four consumer surfaces. (a) the production design surface validator and its own unit test derive the enclosing `sk-design` root; (b) the interface contract test derives that same root; (c) the benchmark test hardcodes `SKDESIGN`; and (d) the command-binding test loops a fixed four-hub allowlist (`sk-code`, `sk-design`, `sk-doc`, `system-deep-loop`). None discovers all N skill roots dynamically. [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-40] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-179] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:306-415] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-59] [SOURCE: .opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65] [INFERENCE: bounded `git log --follow --diff-filter=A` and `git show` identify commit `2aa5fcff4a` as the file's introduction]\",\n361:       \"addedAtIteration\": 3,\n362:       \"sources\": [\n363:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n364:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n365:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n366:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n367:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n368:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n369:         \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n370:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n371:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n372:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n373:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n374:         \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n375:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n376:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n377:         \"Git introduction commit `2aa5fcff4a`\"\n378:       ]\n379:     },\n380:     {\n381:       \"id\": \"finding-3-4-leaf-aliases-json-is-not-redundant-with-registry-config-data-its-accepted-root-i\",\n382:       \"text\": \"`leaf-aliases.json` is not redundant with registry/config data: its accepted root is either an array or `{aliases:[...]}`, and each record is the authored triple `{workflowMode, leafResourceId, diskPath}` with a contained hub-relative `diskPath`. For hubs, the generator injects alias leaf identities into the generated manifest; doctor uses aliases to prove missing manifest leaves resolve on disk; benchmark replay is the runtime-like consumer that maps shared/legacy resource strings to typed pairs. Standalone generation deliberately does not merge aliases, but replay still reads them, so standalone same-path rows act as explicit legacy-string compatibility mappings rather than corpus declarations. Registry/config can name modes, packets, and roots but cannot express that three-way mapping. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:50-68] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:130-168] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1180-1207] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:240-261] [SOURCE: .opencode/skills/sk-doc/leaf-aliases.json:1-31] [SOURCE: .opencode/skills/mcp-code-mode/leaf-aliases.json:1-36]\",\n383:       \"addedAtIteration\": 3,\n384:       \"sources\": [\n385:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n386:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n387:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n388:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n389:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n390:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n391:         \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n392:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n393:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n394:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n395:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n396:         \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n397:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n398:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n399:         \"Git introduction commit `2aa5fcff4a`\"\n400:       ]\n401:     },\n402:     {\n403:       \"id\": \"finding-3-3-leaf-manifest-config-json-is-a-durable-authored-input-for-registry-less-single-m\",\n404:       \"text\": \"`leaf-manifest.config.json` is a durable authored input for registry-less, single-mode skills. Its enforced shape requires non-empty string `workflowMode`; optional non-empty `packet` defaults to `.`; non-empty `leafRoots` defaults to `references`/`assets` and is restricted to the four legal roots; `excludeIndexFiles` defaults true; and `resourceContractVersion` defaults to contract version 1. The only direct production reader is `generate-leaf-manifest.cjs`; doctor and fleet CI consume it indirectly through regeneration. All four root instances use this schema, and the root-name test supplies a minimal accepted fixture. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [SOURCE: .opencode/skills/mcp-code-mode/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-code-graph/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-skill-advisor/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-spec-kit/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:124-126]\",\n405:       \"addedAtIteration\": 3,\n406:       \"sources\": [\n407:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n408:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n409:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n410:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n411:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n412:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n413:         \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n414:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n415:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n416:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n417:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n418:         \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n419:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n420:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n421:         \"Git introduction commit `2aa5fcff4a`\"\n422:       ]\n423:     },\n424:     {\n425:       \"id\": \"finding-3-1-leaf-manifest-json-is-generated-not-authored-source-contract-version-1-defines-a\",\n426:       \"text\": \"`leaf-manifest.json` is generated, not authored source. Contract version 1 defines a top-level `{resourceContractVersion, modes[]}` object; every mode is `{workflowMode, packet, leaves[]}`, leaves are deduplicated/sorted packet-relative paths under `references/`, `assets/`, `feature-catalog/`, or `manual-testing-playbook/`, modes sort by `workflowMode`, and canonical bytes recursively sort keys with two-space indentation and one trailing newline. The generator derives hub manifests from `mode-registry.json` plus optional aliases and standalone manifests from `leaf-manifest.config.json`, while `--write` is the sole writer and `--check` byte-compares regeneration. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-69] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:316-364] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:173-239]\",\n427:       \"addedAtIteration\": 3,\n428:       \"sources\": [\n429:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n430:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n431:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n432:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n433:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n434:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n435:         \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n436:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n437:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n438:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n439:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n440:         \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n441:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n442:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n443:         \"Git introduction commit `2aa5fcff4a`\"\n444:       ]\n445:     },\n446:     {\n447:       \"id\": \"finding-3-2-its-executable-consumer-set-has-distinct-enforcement-roles-doctor-validates-sour\",\n448:       \"text\": \"Its executable consumer set has distinct enforcement roles: doctor validates source shape/version, regenerability, canonical-byte freshness, collision/target resolution, and bidirectional registry reachability; the fleet CI gate discovers every committed manifest and byte-checks all of them; benchmark router replay emits typed resource pairs and fail-closed unresolved strings, while the playbook loader derives typed gold from registered manifest leaves; compiled routing and topology/scenario validators also ingest the manifest. Tests cover all four doctor guards, alias dual-read, absent-manifest no-regression, selected-mode caps, and compiled-routing parity. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1071-1233] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-261] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658] [SOURCE: .opencode/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/registry-compiler.cjs:75] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/validate-playbook-topology.cjs:213-215] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/validate-compiled-routing-scenarios.cjs:199-204] [SOURCE: .opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:178-272] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:84-159]\",\n449:       \"addedAtIteration\": 3,\n450:       \"sources\": [\n451:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n452:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n453:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n454:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n455:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n456:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n457:         \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n458:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n459:         \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n460:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n461:         \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n462:         \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n463:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n464:         \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n465:         \"Git introduction commit `2aa5fcff4a`\"\n466:       ]\n467:     },\n468:     {\n469:       \"id\": \"finding-4-5-command-metadata-json-remains-an-authored-sk-design-extension-command-ownership-\",\n470:       \"text\": \"**`command-metadata.json` remains an authored `sk-design` extension; command ownership is not a class rule.** Generic hub commands already live in registries (`sk-doc`, `system-deep-loop`). The sole multi-hub reader treats command metadata as optional over a fixed four-hub list and excludes registry-less `system-spec-kit`; production validation is path-bound to `sk-design` interface semantics. Generalization would require a new schema/consumer, not copying the singleton. [SOURCE: .opencode/skills/sk-doc/mode-registry.json:20-40] [SOURCE: .opencode/skills/sk-doc/mode-registry.json:67-76] [SOURCE: .opencode/skills/system-deep-loop/mode-registry.json:35-76] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-64] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-179]\",\n471:       \"addedAtIteration\": 4,\n472:       \"sources\": [\n473:         \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n474:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n475:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n476:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n477:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n478:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n479:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n480:         \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n481:         \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n482:         \"Command binding test and `sk-design` command surface validator\"\n483:       ]\n484:     },\n485:     {\n486:       \"id\": \"finding-4-4-aliases-stay-authored-as-a-capability-overlay-the-resolver-refuses-to-infer-shar\",\n487:       \"text\": \"**Aliases stay authored as a capability overlay.** The resolver refuses to infer shared ownership and accepts legacy/shared paths only through explicit `{workflowMode, leafResourceId, diskPath}` rows. Hubs resolve packet-qualified strings from registries, so `sk-doc` needs aliases only for relocated shared resources; registry-less Class S roots need same-path rows to attach a workflow mode to untyped replay input. This policy mapping is not safe generated inventory. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-260] [SOURCE: .opencode/skills/sk-doc/leaf-aliases.json:1-31] [SOURCE: .opencode/skills/mcp-code-mode/leaf-aliases.json:1-36]\",\n488:       \"addedAtIteration\": 4,\n489:       \"sources\": [\n490:         \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n491:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n492:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n493:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n494:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n495:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n496:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n497:         \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n498:         \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n499:         \"Command binding test and `sk-design` command surface validator\"\n500:       ]\n501:     },\n502:     {\n503:       \"id\": \"finding-4-2-class-h-requires-skill-md-graph-description-registry-and-router-all-seven-curren\",\n504:       \"text\": \"**Class H requires `SKILL.md`, graph, description, registry, and router; all seven current hubs also require their generated manifest because they adopted typed leaf routing.** Doctor explicitly requires hub description, but production advisor ingestion reads graph metadata—not root description. Adding description to Class S therefore cannot directly change current advisor scoring/routing. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1020-1045] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1074] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:1037-1099] [INFERENCE: exact production search under `.opencode/skills/system-skill-advisor/mcp-server` found no `description.json` reader]\",\n505:       \"addedAtIteration\": 4,\n506:       \"sources\": [\n507:         \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n508:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n509:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n510:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n511:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n512:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n513:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n514:         \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n515:         \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n516:         \"Command binding test and `sk-design` command surface validator\"\n517:       ]\n518:     },\n519:     {\n520:       \"id\": \"finding-4-3-class-s-requires-skill-md-graph-standalone-config-generated-manifest-and-aliases\",\n521:       \"text\": \"**Class S requires `SKILL.md`, graph, standalone config, generated manifest, and aliases when raw strings need the absent workflow mode—which all five current resource routers do.** The four configured roots state the one-mode contract. `sk-git` has the same `RESOURCE_MAP` pattern and routed references/assets/package corpus but lacks config, manifest, and aliases; the freshness gate misses this because it discovers only committed manifests. Thus `sk-git` is the most non-conforming Class S root, not a legitimate sparse class; missing description is not its defect. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-147] [SOURCE: .opencode/skills/mcp-code-mode/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-code-graph/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-skill-advisor/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-spec-kit/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/sk-git/SKILL.md:42-95] [SOURCE: .opencode/skills/sk-git/graph-metadata.json:143-152] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-71]\",\n522:       \"addedAtIteration\": 4,\n523:       \"sources\": [\n524:         \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n525:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n526:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n527:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n528:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n529:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n530:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n531:         \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n532:         \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n533:         \"Command binding test and `sk-design` command surface validator\"\n534:       ]\n535:     },\n536:     {\n537:       \"id\": \"finding-4-1-two-classes-explain-all-12-roots-no-sparse-third-class-is-needed-class-h-is-a-pa\",\n538:       \"text\": \"**Two classes explain all 12 roots; no sparse third class is needed.** Class H is a packet hub (seven roots); Class S is a registry-less single-mode skill with routed leaves (five roots, including `sk-git`). Graph metadata is universal because advisor nodes and scoring fields come from skill-shaped graph files; standalone config is the one-mode substitute for a registry. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:946-970] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [INFERENCE: these behavior rules reconcile the census at research/lineages/sol-high-fast/iterations/iteration-001.md:15-28]\",\n539:       \"addedAtIteration\": 4,\n540:       \"sources\": [\n541:         \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n542:         \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n543:         \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n544:         \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n545:         \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n546:         \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n547:         \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n548:         \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n549:         \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n550:         \"Command binding test and `sk-design` command surface validator\"\n551:       ]\n552:     },\n553:     {\n554:       \"id\": \"finding-5-3-a-class-first-gate-closes-the-missing-manifest-hole-by-discovering-roots-before-\",\n\n(Output capped at 50 KB. Showing lines 1-554. Use offset=555 to continue.)\n</content>","metadata":{"preview":"{\n  \"sessionId\": \"fanout-sol-high-fast-1785174758167-rdrppf\",\n  \"parentSessionId\": null,\n  \"lineageMode\": \"new\",\n  \"generation\": 1,\n  \"continuedFromRun\": null,\n  \"terminalStop\": {\n    \"stopReason\": \"converged\",\n    \"totalIterations\": 5,\n    \"answeredCount\": 5,\n    \"totalQuestions\": 5,\n    \"timestamp\": \"2026-07-27T18:35:07Z\"\n  },\n  \"keyQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-complete-12-skill-by-eight-file-root-level-census-and-who-produces-e\",\n      \"inboxId\": null,\n      \"text\": \"What is the complete 12-skill by eight-file root-level census, and who produces each file type?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast/findings-registry.json","text":"{\n  \"sessionId\": \"fanout-sol-high-fast-1785174758167-rdrppf\",\n  \"parentSessionId\": null,\n  \"lineageMode\": \"new\",\n  \"generation\": 1,\n  \"continuedFromRun\": null,\n  \"terminalStop\": {\n    \"stopReason\": \"converged\",\n    \"totalIterations\": 5,\n    \"answeredCount\": 5,\n    \"totalQuestions\": 5,\n    \"timestamp\": \"2026-07-27T18:35:07Z\"\n  },\n  \"keyQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-complete-12-skill-by-eight-file-root-level-census-and-who-produces-e\",\n      \"inboxId\": null,\n      \"text\": \"What is the complete 12-skill by eight-file root-level census, and who produces each file type?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 1,\n      \"resolved\": true\n    },\n    {\n      \"id\": \"question-2-what-schema-and-complete-consumer-call-site-set-governs-each-file-type-including\",\n      \"inboxId\": null,\n      \"text\": \"What schema and complete consumer call-site set governs each file type, including advisor, benchmark, doctor, and tests?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 3,\n      \"resolved\": true\n    },\n    {\n      \"id\": \"question-3-what-consumer-derived-skill-class-taxonomy-maps-all-12-skills-and-makes-each-pre\",\n      \"inboxId\": null,\n      \"text\": \"What consumer-derived skill class taxonomy maps all 12 skills and makes each presence difference either required, optional by class, or defective?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 4,\n      \"resolved\": true\n    },\n    {\n      \"id\": \"question-4-how-should-the-five-graph-only-skills-leaf-aliases-json-command-metadata-json-an\",\n      \"inboxId\": null,\n      \"text\": \"How should the five graph-only skills, `leaf-aliases.json`, `command-metadata.json`, and sparse `sk-git` be classified after behavior-impact checks?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 5,\n      \"resolved\": true\n    },\n    {\n      \"id\": \"question-5-where-should-the-canonical-contract-live-in-sk-doc-create-skill-what-can-be-gene\",\n      \"inboxId\": null,\n      \"text\": \"Where should the canonical contract live in `sk-doc/create-skill`, what can be generated/backfilled, and what fleet-wide presence-plus-freshness gate should enforce it?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 5,\n      \"resolved\": true\n    }\n  ],\n  \"openQuestions\": [],\n  \"resolvedQuestions\": [\n    {\n      \"id\": \"question-1-what-is-the-complete-12-skill-by-eight-file-root-level-census-and-who-produces-e\",\n      \"inboxId\": null,\n      \"text\": \"What is the complete 12-skill by eight-file root-level census, and who produces each file type?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 1\n    },\n    {\n      \"id\": \"question-2-what-schema-and-complete-consumer-call-site-set-governs-each-file-type-including\",\n      \"inboxId\": null,\n      \"text\": \"What schema and complete consumer call-site set governs each file type, including advisor, benchmark, doctor, and tests?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 3\n    },\n    {\n      \"id\": \"question-3-what-consumer-derived-skill-class-taxonomy-maps-all-12-skills-and-makes-each-pre\",\n      \"inboxId\": null,\n      \"text\": \"What consumer-derived skill class taxonomy maps all 12 skills and makes each presence difference either required, optional by class, or defective?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 4\n    },\n    {\n      \"id\": \"question-4-how-should-the-five-graph-only-skills-leaf-aliases-json-command-metadata-json-an\",\n      \"inboxId\": null,\n      \"text\": \"How should the five graph-only skills, `leaf-aliases.json`, `command-metadata.json`, and sparse `sk-git` be classified after behavior-impact checks?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 5\n    },\n    {\n      \"id\": \"question-5-where-should-the-canonical-contract-live-in-sk-doc-create-skill-what-can-be-gene\",\n      \"inboxId\": null,\n      \"text\": \"Where should the canonical contract live in `sk-doc/create-skill`, what can be generated/backfilled, and what fleet-wide presence-plus-freshness gate should enforce it?\",\n      \"origin\": \"legacy-import\",\n      \"source\": \"key-questions\",\n      \"injectedAtIteration\": 0,\n      \"promotedQuestionId\": null,\n      \"addedAtIteration\": 0,\n      \"resolvedAtIteration\": 5\n    }\n  ],\n  \"carriedForwardOpenQuestions\": [\n    {\n      \"text\": \"What complete consumer and schema set governs each type?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"What behavior impact determines whether graph-only, alias, command, and sparse cases are required, optional, or defective?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"What class taxonomy explains every presence difference?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Which consumer or history evidence conclusively owns `command-metadata.json`?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Where should the canonical contract and fleet enforcement live?\",\n      \"addedAtIteration\": 1,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"What schemas and complete consumer sets govern `leaf-manifest.json`, `leaf-manifest.config.json`, `leaf-aliases.json`, and `command-metadata.json`?\",\n      \"addedAtIteration\": 2,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Where should the canonical contract and fleet-wide freshness gate live?\",\n      \"addedAtIteration\": 2,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"What consumer-derived class taxonomy explains all 12 roots?\",\n      \"addedAtIteration\": 2,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Which exceptional presence cases are required, optional, or defective?\",\n      \"addedAtIteration\": 2,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"What consumer-derived skill class taxonomy maps all 12 roots and classifies every presence difference?\",\n      \"addedAtIteration\": 3,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Where should the canonical contract and fleet-wide presence-plus-freshness gate live?\",\n      \"addedAtIteration\": 3,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Which exceptional graph-only, alias, command, and sparse cases are required, optional, or defective?\",\n      \"addedAtIteration\": 3,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"Where should the canonical two-class contract live, what can be generated/backfilled, and what presence-plus-freshness gate should enforce it?\",\n      \"addedAtIteration\": 4,\n      \"source\": \"iteration-markdown\"\n    },\n    {\n      \"text\": \"No key research questions remain. Implementation still must prove the proposed classifier and gate against all 12 live roots and negative fixtures.\",\n      \"addedAtIteration\": 5,\n      \"source\": \"iteration-markdown\"\n    }\n  ],\n  \"uncoveredQuestions\": [],\n  \"keyFindings\": [\n    {\n      \"id\": \"finding-1-5-command-metadata-json-is-a-singleton-confined-to-sk-design-its-two-entries-descr\",\n      \"text\": \"`command-metadata.json` is a singleton confined to `sk-design`; its two entries describe `/interface:design` and `/interface:design-reference`. No producer reference was found in `sk-doc/create-command` or `.opencode/commands`, so current evidence classifies it as hand-authored, not generated; this classification should remain provisional until consumer/schema research traces its ownership history. [SOURCE: .opencode/skills/sk-design/command-metadata.json:1-16] [SOURCE: .opencode/skills/sk-design/command-metadata.json:374-386] [INFERENCE: exact searches for `command-metadata` under `.opencode/skills/sk-doc/create-command` and `.opencode/commands` returned no matches]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"`.opencode/skills/` direct directory inventory\",\n        \"`Glob .opencode/skills/*/*.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n        \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-4-leaf-manifest-json-is-the-one-clearly-derived-artifact-generate-leaf-manifest-cj\",\n      \"text\": \"`leaf-manifest.json` is the one clearly derived artifact: `generate-leaf-manifest.cjs --write` builds it from `mode-registry.json` for hubs or from `leaf-manifest.config.json` for registry-less standalone skills, optionally incorporating authored `leaf-aliases.json` for hubs, and writes canonical bytes. The script explicitly calls aliases “authored,” while standalone config is an input declaration rather than generated output. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-19] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:50-68] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:173-218]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"`.opencode/skills/` direct directory inventory\",\n        \"`Glob .opencode/skills/*/*.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n        \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-2-fleet-totals-are-description-json-7-12-graph-metadata-json-12-12-leaf-manifest-j\",\n      \"text\": \"Fleet totals are: `description.json` 7/12, `graph-metadata.json` 12/12, `leaf-manifest.json` 11/12, `leaf-manifest.config.json` 4/12, `leaf-aliases.json` 5/12, `mode-registry.json` 7/12, `hub-router.json` 7/12, and `command-metadata.json` 1/12. Thus `graph-metadata.json` is the only universally present type; `sk-git` is the sole graph-only root. [INFERENCE: arithmetic over the exact matrix in Finding 1; the `sk-git` graph node is present at `.opencode/skills/sk-git/graph-metadata.json:1`]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"`.opencode/skills/` direct directory inventory\",\n        \"`Glob .opencode/skills/*/*.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n        \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-3-four-file-types-have-explicit-parent-hub-scaffold-producer-evidence-init-skill-p\",\n      \"text\": \"Four file types have explicit parent-hub scaffold producer evidence: `init_skill.py --kind parent` writes `mode-registry.json`, `hub-router.json`, `graph-metadata.json`, and `description.json` at the new hub root. These are scaffold outputs, though their checked-in values remain author-maintained after creation. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/init_skill.py:528-553]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"`.opencode/skills/` direct directory inventory\",\n        \"`Glob .opencode/skills/*/*.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n        \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n      ]\n    },\n    {\n      \"id\": \"finding-1-1-the-exact-root-level-census-is-below-y-means-the-direct-child-file-exists-means-\",\n      \"text\": \"The exact root-level census is below. `Y` means the direct-child file exists; `—` means the exact direct-child glob returned no such file. Nested packet/mode metadata was excluded. [INFERENCE: exact direct-child inventory from `Glob .opencode/skills/*/*.json`, cross-checked against the 12 entries returned by reading `.opencode/skills/`]\",\n      \"addedAtIteration\": 1,\n      \"sources\": [\n        \"`.opencode/skills/` direct directory inventory\",\n        \"`Glob .opencode/skills/*/*.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/init_skill.py:490-553`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:7-218`\",\n        \"`.opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:1-180`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"Exact `command-metadata` searches under `.opencode/skills/sk-doc/create-command` and `.opencode/commands`\"\n      ]\n    },\n    {\n      \"id\": \"finding-2-2-graph-metadata-json-is-the-advisor-s-only-direct-root-identity-scoring-source-am\",\n      \"text\": \"`graph-metadata.json` is the advisor's only direct root identity/scoring source among these four: the indexer parses every discovered skill-shaped file, enforces one non-nested identity, and stores node domains, intent signals, derived metadata, and graph edges in SQLite; scorer lanes consume that projection rather than `description.json`. Doctor independently enforces one root graph file, folder identity, family, and no nested graph/description identities; benchmark vocabulary sync also reads graph trigger phrases. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:946-1005] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:1037-1133] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:252-313] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/parent-hub-vocab-sync.cjs:322-354]\",\n      \"addedAtIteration\": 2,\n      \"sources\": [\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n        \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n        \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n        \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n      ]\n    },\n    {\n      \"id\": \"finding-2-4-hub-router-json-is-the-declarative-routing-table-its-required-top-level-shape-is\",\n      \"text\": \"`hub-router.json` is the declarative routing table. Its required top-level shape is `skill`, `version`, `routerPolicy`, `routerSignals`, and `vocabularyClasses`; signal keys must equal registry modes, classes and resources must resolve, tie-break must be an exact mode permutation, and outcomes/default mode must conform. Production consumers are benchmark `projectHubRouter`, vocabulary sync, doctor check 5, the compiled-route manifest and per-hub compilers, plus the hub's own SKILL router. [SOURCE: .opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-57] [SOURCE: .opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:160-178] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:803-934] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:127-163] [SOURCE: .opencode/bin/lib/compiled-route-manifest.cjs:400-434]\",\n      \"addedAtIteration\": 2,\n      \"sources\": [\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n        \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n        \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n        \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n      ]\n    },\n    {\n      \"id\": \"finding-2-3-mode-registry-json-is-the-packet-source-of-truth-not-advisor-identity-metadata-i\",\n      \"text\": \"`mode-registry.json` is the packet source of truth, not advisor identity metadata. Its canonical schema is one `modes[]` array whose entries carry `workflowMode`, `packetKind`, `backendKind`, `toolSurface`, packet/name identity, aliases, and `advisorRouting`, with optional declared extensions. Production consumers are: create-skill's leaf-manifest generator; doctor packet/discriminator/alias/tool validation; advisor executor delegation for CLI mode aliases; generated deep-loop advisor projection; benchmark router replay and vocabulary sync; and compiled-routing manifest/compiler inputs. [SOURCE: .opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-registry-template.json:1-20] [SOURCE: .opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-registry-template.json:21-164] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:174-193] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:316-411] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:160-180] [SOURCE: .opencode/skills/system-skill-advisor/feature-catalog/scorer-fusion/projection.md:24-30]\",\n      \"addedAtIteration\": 2,\n      \"sources\": [\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n        \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n        \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n        \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n      ]\n    },\n    {\n      \"id\": \"finding-2-5-tests-and-fixtures-verify-consumers-but-are-not-themselves-production-consumers-\",\n      \"text\": \"Tests and fixtures verify consumers but are not themselves production consumers: parent-check mutation tests red invalid graph family, duplicate registry aliases, router defaults, and description registry duplication; compiled-manifest tests require exactly `SKILL.md`, registry, and router inputs and fail closed on missing/malformed/mismatched files. No production advisor code in the targeted `mcp-server` search read skill `description.json`; current evidence therefore classifies it as scaffold/doctor/discovery prose rather than a scorer input. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105] [SOURCE: .opencode/bin/tests/compiled-route-manifest.test.cjs:49-79] [SOURCE: .opencode/bin/tests/compiled-route-manifest.test.cjs:191-229] [INFERENCE: the targeted production search under `.opencode/skills/system-skill-advisor/mcp-server` found graph and mode-registry consumers but no skill-root `description.json` consumer]\",\n      \"addedAtIteration\": 2,\n      \"sources\": [\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n        \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n        \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n        \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n      ]\n    },\n    {\n      \"id\": \"finding-2-1-the-two-identity-filenames-do-not-imply-one-shared-schema-skill-description-json\",\n      \"text\": \"The two identity filenames do not imply one shared schema. Skill `description.json` has a small hub-facing contract: `name`, `description`, `version`, and array-valued `keywords` are enforced; `modes` and `backend_kinds` are forbidden duplicate sources of registry truth. The scaffold additionally recommends `importance_tier`, `trigger_examples`, `lastUpdated`, and hub-specific arrays, but doctor does not require them. Skill `graph-metadata.json` is identified by `skill_id`, `family`, or `edges`, then strictly requires schema version 1 or 2, folder-matching `skill_id`, an allowed family, category, domains, intent signals, derived data, and typed edges. This content discriminator is what excludes same-named spec continuity metadata from advisor ingestion. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1020-1045] [SOURCE: .opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-description-template.json:1-32] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:960-979]\",\n      \"addedAtIteration\": 2,\n      \"sources\": [\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-411,803-1045`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:740-828,946-1133`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:147-336`\",\n        \"`.opencode/skills/sk-doc/create-skill/assets/parent-skill/parent-skill-{description,graph-metadata,registry}-template.json`\",\n        \"`.opencode/skills/sk-doc/create-skill/references/parent-skill/parent-hub-router-schema.md:21-337`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/{router-replay,parent-hub-vocab-sync}.cjs`\",\n        \"`.opencode/bin/lib/compiled-route-manifest.cjs:400-434`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/parent-skill-check-fixtures.vitest.ts:53-105`\",\n        \"`.opencode/bin/tests/compiled-route-manifest.test.cjs:49-79,191-229`\"\n      ]\n    },\n    {\n      \"id\": \"finding-3-5-command-metadata-json-remains-an-authored-sk-design-specific-contract-rather-tha\",\n      \"text\": \"`command-metadata.json` remains an authored, `sk-design`-specific contract rather than a fleet schema. Its validator requires an array containing exactly the two `/interface:*` records, all 27 named top-level fields, registry-matching `ownerMode`/command bindings, typed nested argument/choreography/policy/output structures, unique commands/aliases, and graph consistency. Git history introduces the file in commit `2aa5fcff4a` as an `sk-design` metadata SSOT, with no generator. The prompt's “four consumers” is accurate only when the validator and its unit test are grouped as one surface: current source contains five direct reader files across four consumer surfaces. (a) the production design surface validator and its own unit test derive the enclosing `sk-design` root; (b) the interface contract test derives that same root; (c) the benchmark test hardcodes `SKDESIGN`; and (d) the command-binding test loops a fixed four-hub allowlist (`sk-code`, `sk-design`, `sk-doc`, `system-deep-loop`). None discovers all N skill roots dynamically. [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-40] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-179] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:306-415] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-59] [SOURCE: .opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65] [INFERENCE: bounded `git log --follow --diff-filter=A` and `git show` identify commit `2aa5fcff4a` as the file's introduction]\",\n      \"addedAtIteration\": 3,\n      \"sources\": [\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n        \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n        \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n        \"Git introduction commit `2aa5fcff4a`\"\n      ]\n    },\n    {\n      \"id\": \"finding-3-4-leaf-aliases-json-is-not-redundant-with-registry-config-data-its-accepted-root-i\",\n      \"text\": \"`leaf-aliases.json` is not redundant with registry/config data: its accepted root is either an array or `{aliases:[...]}`, and each record is the authored triple `{workflowMode, leafResourceId, diskPath}` with a contained hub-relative `diskPath`. For hubs, the generator injects alias leaf identities into the generated manifest; doctor uses aliases to prove missing manifest leaves resolve on disk; benchmark replay is the runtime-like consumer that maps shared/legacy resource strings to typed pairs. Standalone generation deliberately does not merge aliases, but replay still reads them, so standalone same-path rows act as explicit legacy-string compatibility mappings rather than corpus declarations. Registry/config can name modes, packets, and roots but cannot express that three-way mapping. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:50-68] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:130-168] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1180-1207] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:240-261] [SOURCE: .opencode/skills/sk-doc/leaf-aliases.json:1-31] [SOURCE: .opencode/skills/mcp-code-mode/leaf-aliases.json:1-36]\",\n      \"addedAtIteration\": 3,\n      \"sources\": [\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n        \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n        \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n        \"Git introduction commit `2aa5fcff4a`\"\n      ]\n    },\n    {\n      \"id\": \"finding-3-3-leaf-manifest-config-json-is-a-durable-authored-input-for-registry-less-single-m\",\n      \"text\": \"`leaf-manifest.config.json` is a durable authored input for registry-less, single-mode skills. Its enforced shape requires non-empty string `workflowMode`; optional non-empty `packet` defaults to `.`; non-empty `leafRoots` defaults to `references`/`assets` and is restricted to the four legal roots; `excludeIndexFiles` defaults true; and `resourceContractVersion` defaults to contract version 1. The only direct production reader is `generate-leaf-manifest.cjs`; doctor and fleet CI consume it indirectly through regeneration. All four root instances use this schema, and the root-name test supplies a minimal accepted fixture. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [SOURCE: .opencode/skills/mcp-code-mode/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-code-graph/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-skill-advisor/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-spec-kit/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:124-126]\",\n      \"addedAtIteration\": 3,\n      \"sources\": [\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n        \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n        \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n        \"Git introduction commit `2aa5fcff4a`\"\n      ]\n    },\n    {\n      \"id\": \"finding-3-1-leaf-manifest-json-is-generated-not-authored-source-contract-version-1-defines-a\",\n      \"text\": \"`leaf-manifest.json` is generated, not authored source. Contract version 1 defines a top-level `{resourceContractVersion, modes[]}` object; every mode is `{workflowMode, packet, leaves[]}`, leaves are deduplicated/sorted packet-relative paths under `references/`, `assets/`, `feature-catalog/`, or `manual-testing-playbook/`, modes sort by `workflowMode`, and canonical bytes recursively sort keys with two-space indentation and one trailing newline. The generator derives hub manifests from `mode-registry.json` plus optional aliases and standalone manifests from `leaf-manifest.config.json`, while `--write` is the sole writer and `--check` byte-compares regeneration. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-69] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:316-364] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:173-239]\",\n      \"addedAtIteration\": 3,\n      \"sources\": [\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n        \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n        \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n        \"Git introduction commit `2aa5fcff4a`\"\n      ]\n    },\n    {\n      \"id\": \"finding-3-2-its-executable-consumer-set-has-distinct-enforcement-roles-doctor-validates-sour\",\n      \"text\": \"Its executable consumer set has distinct enforcement roles: doctor validates source shape/version, regenerability, canonical-byte freshness, collision/target resolution, and bidirectional registry reachability; the fleet CI gate discovers every committed manifest and byte-checks all of them; benchmark router replay emits typed resource pairs and fail-closed unresolved strings, while the playbook loader derives typed gold from registered manifest leaves; compiled routing and topology/scenario validators also ingest the manifest. Tests cover all four doctor guards, alias dual-read, absent-manifest no-regression, selected-mode caps, and compiled-routing parity. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1071-1233] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-261] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658] [SOURCE: .opencode/bin/lib/compiled-routing/009-parent-hub-rollout/002-system-deep-loop/lib/registry-compiler.cjs:75] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/validate-playbook-topology.cjs:213-215] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/validate-compiled-routing-scenarios.cjs:199-204] [SOURCE: .opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:178-272] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:84-159]\",\n      \"addedAtIteration\": 3,\n      \"sources\": [\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:46-239`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:51-440`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1233`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:1-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:180-289`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/load-playbook-scenarios.cjs:607-658`\",\n        \"`.opencode/commands/doctor/scripts/tests/parent-skill-check-leaf-manifest.test.cjs:140-272`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/sk-doc-leaf-routing-contract.vitest.ts:35-159`\",\n        \"`.opencode/skills/sk-design/command-metadata.json:1-574`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:8-179,306-519`\",\n        \"`.opencode/skills/sk-design/shared/scripts/design-command-surface-check.test.mjs:20-73`\",\n        \"`.opencode/skills/sk-design/shared/scripts/interface-command-contract.test.mjs:5-49`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/skill-benchmark.vitest.ts:343-361`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65`\",\n        \"Git introduction commit `2aa5fcff4a`\"\n      ]\n    },\n    {\n      \"id\": \"finding-4-5-command-metadata-json-remains-an-authored-sk-design-extension-command-ownership-\",\n      \"text\": \"**`command-metadata.json` remains an authored `sk-design` extension; command ownership is not a class rule.** Generic hub commands already live in registries (`sk-doc`, `system-deep-loop`). The sole multi-hub reader treats command metadata as optional over a fixed four-hub list and excludes registry-less `system-spec-kit`; production validation is path-bound to `sk-design` interface semantics. Generalization would require a new schema/consumer, not copying the singleton. [SOURCE: .opencode/skills/sk-doc/mode-registry.json:20-40] [SOURCE: .opencode/skills/sk-doc/mode-registry.json:67-76] [SOURCE: .opencode/skills/system-deep-loop/mode-registry.json:35-76] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-64] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-179]\",\n      \"addedAtIteration\": 4,\n      \"sources\": [\n        \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n        \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n        \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n        \"Command binding test and `sk-design` command surface validator\"\n      ]\n    },\n    {\n      \"id\": \"finding-4-4-aliases-stay-authored-as-a-capability-overlay-the-resolver-refuses-to-infer-shar\",\n      \"text\": \"**Aliases stay authored as a capability overlay.** The resolver refuses to infer shared ownership and accepts legacy/shared paths only through explicit `{workflowMode, leafResourceId, diskPath}` rows. Hubs resolve packet-qualified strings from registries, so `sk-doc` needs aliases only for relocated shared resources; registry-less Class S roots need same-path rows to attach a workflow mode to untyped replay input. This policy mapping is not safe generated inventory. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299] [SOURCE: .opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-260] [SOURCE: .opencode/skills/sk-doc/leaf-aliases.json:1-31] [SOURCE: .opencode/skills/mcp-code-mode/leaf-aliases.json:1-36]\",\n      \"addedAtIteration\": 4,\n      \"sources\": [\n        \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n        \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n        \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n        \"Command binding test and `sk-design` command surface validator\"\n      ]\n    },\n    {\n      \"id\": \"finding-4-2-class-h-requires-skill-md-graph-description-registry-and-router-all-seven-curren\",\n      \"text\": \"**Class H requires `SKILL.md`, graph, description, registry, and router; all seven current hubs also require their generated manifest because they adopted typed leaf routing.** Doctor explicitly requires hub description, but production advisor ingestion reads graph metadata—not root description. Adding description to Class S therefore cannot directly change current advisor scoring/routing. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1020-1045] [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1063-1074] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:1037-1099] [INFERENCE: exact production search under `.opencode/skills/system-skill-advisor/mcp-server` found no `description.json` reader]\",\n      \"addedAtIteration\": 4,\n      \"sources\": [\n        \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n        \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n        \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n        \"Command binding test and `sk-design` command surface validator\"\n      ]\n    },\n    {\n      \"id\": \"finding-4-3-class-s-requires-skill-md-graph-standalone-config-generated-manifest-and-aliases\",\n      \"text\": \"**Class S requires `SKILL.md`, graph, standalone config, generated manifest, and aliases when raw strings need the absent workflow mode—which all five current resource routers do.** The four configured roots state the one-mode contract. `sk-git` has the same `RESOURCE_MAP` pattern and routed references/assets/package corpus but lacks config, manifest, and aliases; the freshness gate misses this because it discovers only committed manifests. Thus `sk-git` is the most non-conforming Class S root, not a legitimate sparse class; missing description is not its defect. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-147] [SOURCE: .opencode/skills/mcp-code-mode/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-code-graph/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-skill-advisor/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/system-spec-kit/leaf-manifest.config.json:1-8] [SOURCE: .opencode/skills/sk-git/SKILL.md:42-95] [SOURCE: .opencode/skills/sk-git/graph-metadata.json:143-152] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-71]\",\n      \"addedAtIteration\": 4,\n      \"sources\": [\n        \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n        \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n        \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n        \"Command binding test and `sk-design` command surface validator\"\n      ]\n    },\n    {\n      \"id\": \"finding-4-1-two-classes-explain-all-12-roots-no-sparse-third-class-is-needed-class-h-is-a-pa\",\n      \"text\": \"**Two classes explain all 12 roots; no sparse third class is needed.** Class H is a packet hub (seven roots); Class S is a registry-less single-mode skill with routed leaves (five roots, including `sk-git`). Graph metadata is universal because advisor nodes and scoring fields come from skill-shaped graph files; standalone config is the one-mode substitute for a registry. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:946-970] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [INFERENCE: these behavior rules reconcile the census at research/lineages/sol-high-fast/iterations/iteration-001.md:15-28]\",\n      \"addedAtIteration\": 4,\n      \"sources\": [\n        \"`iterations/iteration-001.md:15-34`, `iteration-002.md:12-17`, `iteration-003.md:13-18`\",\n        \"`.opencode/commands/doctor/scripts/parent-skill-check.cjs:252-321,1020-1074`\",\n        \"`.opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:753-828,946-970,1037-1099`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-208`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-105`\",\n        \"`.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs:204-294`\",\n        \"`.opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299`\",\n        \"`.opencode/skills/sk-git/SKILL.md:42-95`, `graph-metadata.json:143-152`\",\n        \"Standalone configs/aliases; `sk-doc` aliases; `sk-doc` and `system-deep-loop` registries\",\n        \"Command binding test and `sk-design` command surface validator\"\n      ]\n    },\n    {\n      \"id\": \"finding-5-3-a-class-first-gate-closes-the-missing-manifest-hole-by-discovering-roots-before-\",","lineStart":1,"lineEnd":554,"totalLines":555,"truncated":true}},"title":".opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast/findings-registry.json","time":{"start":1785178497731,"end":1785178497770}},"metadata":{"openai":{"itemId":"fc_0a0be5da93b7ff13016a67a9818e448191a66372b08aaf5c39"}},"id":"prt_fa4ee22bd001mOcS8OeE03Tb7K","sessionID":"ses_05b144ddbffeTP8bqXDQv88HuN","messageID":"msg_fa4edd1df001YgPZKpNsnWSFc7"}}
{"type":"tool_use","timestamp":1785178497810,"sessionID":"ses_05b144ddbffeTP8bqXDQv88HuN","part":{"type":"tool","tool":"read","callID":"call_Nas46Iy1g8X1cOLw6tuPJK27","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast/deep-research-dashboard.md"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast/deep-research-dashboard.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: Deep Research Dashboard\n3: description: Auto-generated reducer view over the research packet.\n4: ---\n5: \n6: # Deep Research Dashboard - Session Overview\n7: \n8: Auto-generated from JSONL state log, iteration files, findings registry, and strategy state. Never manually edited.\n9: \n10: <!-- ANCHOR:overview -->\n11: ## 1. OVERVIEW\n12: \n13: Reducer-generated observability surface for the active research packet.\n14: \n15: <!-- /ANCHOR:overview -->\n16: <!-- ANCHOR:status -->\n17: ## 2. STATUS\n18: - Topic: Root-level skill metadata JSON contract for .opencode/skills/ across all 12 skills\n19: - Started: 2026-07-27T17:56:03Z\n20: - Status: COMPLETE\n21: - Iteration: 5 of 10\n22: - Session ID: fanout-sol-high-fast-1785174758167-rdrppf\n23: - Parent Session: none\n24: - Lifecycle Mode: new\n25: - Generation: 1\n26: - continuedFromRun: none\n27: - stopReason: converged\n28: \n29: <!-- /ANCHOR:status -->\n30: <!-- ANCHOR:progress -->\n31: ## 3. PROGRESS\n32: \n33: | # | Focus | Track | Ratio | Findings | Status |\n34: |---|-------|-------|-------|----------|--------|\n35: | 1 | Build the exact 12-skill by eight-file root-level presence census and identify producer evidence for each file type. | metadata-census | 1.00 | 5 | complete |\n36: | 2 | Trace consumers and schemas for description.json, graph-metadata.json, mode-registry.json, and hub-router.json. | hub-metadata-consumers | 1.00 | 5 | complete |\n37: | 3 | Complete schemas and consumer call sites for leaf-manifest.json, leaf-manifest.config.json, leaf-aliases.json, and command-metadata.json. | leaf-command-contracts | 1.00 | 5 | complete |\n38: | 4 | Derive the consumer-based skill taxonomy and resolve every exceptional presence case. | skill-class-taxonomy | 0.80 | 5 | complete |\n39: | 5 | Canonical documentation, safe generation/backfill ownership, and a fleet presence-plus-freshness gate. | contract-and-enforcement | 0.90 | 5 | complete |\n40: \n41: - iterationsCompleted: 5\n42: - keyFindings: 25\n43: - openQuestions: 0\n44: - resolvedQuestions: 5\n45: \n46: <!-- /ANCHOR:progress -->\n47: <!-- ANCHOR:questions -->\n48: ## 4. QUESTIONS\n49: - Answered: 5/5\n50: - [x] What is the complete 12-skill by eight-file root-level census, and who produces each file type?\n51: - [x] What schema and complete consumer call-site set governs each file type, including advisor, benchmark, doctor, and tests?\n52: - [x] What consumer-derived skill class taxonomy maps all 12 skills and makes each presence difference either required, optional by class, or defective?\n53: - [x] How should the five graph-only skills, `leaf-aliases.json`, `command-metadata.json`, and sparse `sk-git` be classified after behavior-impact checks?\n54: - [x] Where should the canonical contract live in `sk-doc/create-skill`, what can be generated/backfilled, and what fleet-wide presence-plus-freshness gate should enforce it?\n55: \n56: <!-- /ANCHOR:questions -->\n57: <!-- ANCHOR:uncovered-questions -->\n58: ## Uncovered Questions\n59: - Count: 0\n60: - None\n61: \n62: <!-- /ANCHOR:uncovered-questions -->\n63: <!-- ANCHOR:trend -->\n64: ## 5. TREND\n65: - newInfoRatio sparkline: ██████████▇▆▄▃▁▂▂▃▄▅\n66: - score sparkline: ██████████▇▆▄▃▁▂▂▃▄▅\n67: - Last 3 ratios: 1.00 -> 0.80 -> 0.90\n68: - Stuck count: 0\n69: - Guard violations: none recorded by the reducer pass\n70: - convergenceScore: 0.90\n71: - coverageBySources: {\"code\":112,\"other\":9}\n72: - Advisory events: none\n73: \n74: <!-- /ANCHOR:trend -->\n75: <!-- ANCHOR:dead-ends -->\n76: ## 6. DEAD ENDS\n77: - A broad `command-metadata.json` search produced oversized output; narrowing to the create-command and command trees found no producer. Future work should search its consumers and Git history rather than repeat the broad search. (iteration 1)\n78: - Counting `package.json`, `package-lock.json`, or `tsconfig.json`: they are root JSON files but not among the eight named metadata types. (iteration 1)\n79: - Counting nested mode/packet JSON: excluded by the focus contract and direct-child glob. (iteration 1)\n80: - The similarly named root-name consumer-matrix test concerns catalog/playbook directory names, not this eight-file metadata census. [SOURCE: .opencode/skills/sk-doc/scripts/tests/test-root-name-consumer-matrix.cjs:80-138] (iteration 1)\n81: - Treating `leaf-manifest.config.json` or `leaf-aliases.json` as generated because the manifest generator reads them: the implementation identifies them as authored inputs and only writes `leaf-manifest.json`. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:50-68] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-127] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:215-218] (iteration 1)\n82: - Repository-wide filename searches exceeded output limits because spec continuity metadata and historical documentation dominate results. Narrowing to executable ownership surfaces recovered precise call sites; repeating the broad search is not useful. (iteration 2)\n83: - Treating every filename mention in specs, docs, fixtures, or generated records as a production call site; only executable reads and runtime/compiler inputs were classified as consumers. [INFERENCE: comparison of exact filename search results with the executable reads cited above] (iteration 2)\n84: - Treating the advisor as a runtime consumer of every hub JSON file; it directly ingests graph metadata, reads selected mode registries for projection/delegation, and has no located runtime read of skill description or generic hub-router files. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/skill-graph/skill-graph-db.ts:952-970] [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/lib/scorer/executor-delegation.ts:160-180] (iteration 2)\n85: - Counting only four direct reader files is stale: there are five; four is defensible only as the number of consumer surfaces after grouping a validator with its unit test. [INFERENCE: exact executable search results reconciled with the five reader files cited in Finding 5] (iteration 3)\n86: - No standalone JSON Schema or create-command generator owns `command-metadata.json`; its executable schema is embedded in the `sk-design` surface validator, and bounded Git history confirms a hand-authored introduction. [INFERENCE: exact executable filename search plus introduction commit `2aa5fcff4a`] (iteration 3)\n87: - Treating `command-metadata.json` as a generic advisor fleet input: the only multi-hub reader is a test with a fixed four-hub list, while production validation is local to `sk-design`. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-65] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-179] (iteration 3)\n88: - Treating `leaf-aliases.json` as equivalent to registry aliases or standalone root config: neither alternative carries the `{workflowMode, leafResourceId, diskPath}` legacy-resolution mapping. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299] (iteration 3)\n89: - Treating `leaf-manifest.json` as authored truth: all enforcement regenerates it from authored source and checks canonical bytes. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:74-91] (iteration 3)\n90: - Fleet command metadata based only on command ownership: registry commands are already generic, while the singleton validator is interface-specific. [SOURCE: .opencode/skills/sk-doc/mode-registry.json:20-40] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-179] (iteration 4)\n91: - Generating aliases from file presence would erase explicit workflow-mode/shared ownership policy. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/lib/leaf-resource-contract.cjs:242-299] (iteration 4)\n92: - Legitimate sparse `sk-git` class: its router/corpus triggers the configured standalone contract. [SOURCE: .opencode/skills/sk-git/SKILL.md:42-95] [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:95-147] (iteration 4)\n93: - Running the current freshness gate cannot classify missing-manifest eligibility because it enumerates only existing manifests. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-71] (iteration 4)\n94: - Standalone-description class: descriptions are enforced for hubs but absent from advisor scoring ingestion. [SOURCE: .opencode/commands/doctor/scripts/parent-skill-check.cjs:1020-1045] [INFERENCE: exact production advisor search found no reader] (iteration 4)\n95: - A generic command-metadata backfill remains unjustified because there is no fleet production consumer or shared schema to generate toward. [SOURCE: .opencode/skills/system-skill-advisor/mcp-server/tests/command-binding-existence.vitest.ts:44-64] [SOURCE: .opencode/skills/sk-design/shared/scripts/design-command-surface-check.mjs:121-180] (iteration 5)\n96: - Creating a third sparse class for `sk-git`: class-first discovery makes it a failing S root and exposes the three missing files. [SOURCE: research/lineages/sol-high-fast/iterations/iteration-004.md:15-15] (iteration 5)\n97: - Extending the current manifest-first scanner alone: it cannot see a required output that does not exist. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/ci-leaf-manifest-freshness.cjs:54-71] (iteration 5)\n98: - Inferring H/S from `graph-metadata.json.family` is not reliable: live families describe domains (`cli`, `mcp`, `sk-hub`, `system`, and others), not the H/S file contract. [INFERENCE: bounded `jq` inventory of `.opencode/skills/*/graph-metadata.json` in this iteration] (iteration 5)\n99: - Treating all eight files as generated: aliases, registries, routers, graph intent, and command policy contain authored semantics. [SOURCE: .opencode/skills/sk-doc/create-skill/scripts/generate-leaf-manifest.cjs:50-68] [SOURCE: .opencode/skills/sk-doc/create-skill/references/parent-skill/parent-skills-nested-packets.md:94-126] (iteration 5)\n100: \n101: <!-- /ANCHOR:dead-ends -->\n102: <!-- ANCHOR:divergent-pivots -->\n103: ## 6A. DIVERGENT PIVOTS\n104: - Completed pivots: 0\n105: - Failed pivots: 0\n106: - Audited overrides: 0\n107: - Saturated: none yet\n108: - Pivot lineage: none yet\n109: - Remaining frontier: none recorded\n110: \n111: <!-- /ANCHOR:divergent-pivots -->\n112: <!-- ANCHOR:next-focus -->\n113: ## 7. NEXT FOCUS\n114: [All tracked questions are resolved]\n115: \n116: <!-- /ANCHOR:next-focus -->\n117: <!-- ANCHOR:active-risks -->\n118: ## 8. ACTIVE RISKS\n119: - None active beyond normal research uncertainty.\n120: \n121: <!-- /ANCHOR:active-risks -->\n122: <!-- ANCHOR:blocked-stops -->\n123: ## 9. BLOCKED STOPS\n124: No blocked-stop events recorded.\n125: \n126: <!-- /ANCHOR:blocked-stops -->\n127: <!-- ANCHOR:graph-convergence -->\n128: ## 10. GRAPH CONVERGENCE\n129: - graphConvergenceScore: 0.00\n130: - graphDecision: [Not recorded]\n131: - graphBlockers: none recorded\n132: \n133: <!-- /ANCHOR:graph-convergence -->\n\n(End of file - total 133 lines)\n</content>","metadata":{"preview":"---\ntitle: Deep Research Dashboard\ndescription: Auto-ge