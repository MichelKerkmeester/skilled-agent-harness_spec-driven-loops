   990	              step_finalize_divergent_pivot:
   991	                action: "Finalize the prepared pivot after all missing native seats are durable"
   992	                skip_when: "pivot_prepare_status != 'pending'"
   993	                command: |
   994	                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
   995	                  import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
   996	                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\n`);
   997	                  EOF
   998	                working_directory: "{repo_root}"
   999	                outputs:
  1000	                  - pivot_finalize_json: "The complete parsed final result"
  1001	
  1002	              step_resolve_divergent_pivot_result:
  1003	                action: "Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result"
  1004	                branch_on: "pivot_prepare_status"
  1005	                if_pending: { bind: { pivot_result: "{pivot_finalize_json}" } }
  1006	                if_completed_or_failed: { bind: { pivot_result: "{pivot_prepare_json}" } }
  1007	
  1008	              step_apply_divergent_pivot_result:
  1009	                action: "Adopt a successful focus or fail closed to the existing synthesis path"
  1010	                branch_on: "pivot_result.status"
  1011	                if_completed:
  1012	                  set:
  1013	                    next_focus: "{pivot_result.restoredFocus}"
  1014	                    pivot_lineage: "Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}."
  1015	                    saturated_directions: "{pivot_result.completedEvent.saturatedDirections}"
  1016	                  command: "node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}"
  1017	                  log: "Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}."
  1018	                  proceed_to: step_rejected_pattern_cache
  1019	                if_failed:
  1020	                  log: "Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis."
  1021	                  skip_to: phase_synthesis
  1022	            on_error:
  1023	              log: "Divergent pivot integration error; failing closed to the existing synthesis path."
  1024	              skip_to: phase_synthesis
  1025	          if_existing_terminal_path:
  1026	            log: "Loop stopping. Reason: {reason}"
  1027	            skip_to: phase_synthesis
  1028	        if_stuck_recovery:
  1029	          bookkeeping_log: '{"type":"event","event":"stuckRecovery","mode":"research","run":{current_iteration},"stopReason":"stuckRecovery","fromIteration":{current_iteration},"outcome":"recovered","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
  1030	          log: "Stuck detected ({stuck_count} consecutive no-progress). Entering recovery."
  1031	          set: { next_focus: "RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}" }
  1032	          reset: { stuck_count: 0 }
  1033	        if_continue:
  1034	          log: "Iteration {current_iteration}: Continuing. Focus: {next_focus}"
  1035	
  1036	      step_rejected_pattern_cache:
  1037	        action: "Apply reducer-derived rejected-pattern suppression before dispatch candidate selection"
  1038	        read:
  1039	          - "{state_paths.state_log}"
  1040	          - "{state_paths.registry}"
  1041	          - "{state_paths.strategy}"
  1042	        candidate_sources:
  1043	          next_focus:
  1044	            category: "next-focus"
  1045	            values:
  1046	              - "{next_focus}"
  1047	              - "{remaining_questions_list}"
  1048	              - "{carried_forward_open_questions}"
  1049	          recovery:
  1050	            category: "recovery"
  1051	            values:
  1052	              - "{recovery_strategy}"
  1053	              - "{least_explored}"
  1054	          ideas:
  1055	            category: "ideas"
  1056	            values:
  1057	              - "{promoted_ideas_list}"
  1058	            optional_file: "{state_paths.packet_dir}/research-ideas.md"
  1059	        algorithm: |
  1060	          Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest
  1061	          reducer pass as the source of truth.
  1062	          Compare normalized exact text first. Then compare fuzzy similarity with
  1063	          rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories
  1064	          are compatible. Remove suppressed candidates from next_focus, recovery, and ideas
  1065	          selection before rendering the dispatch prompt. If all candidates are suppressed,
  1066	          halt for operator input instead of reusing a rejected idea.
  1067	        outputs:
  1068	          - accepted_next_focus: "First unsuppressed next-focus candidate, or null"
  1069	          - accepted_recovery_candidate: "First unsuppressed recovery candidate, or null"
  1070	          - accepted_idea_candidate: "First unsuppressed ideas candidate, or null"
  1071	          - rejected_candidate_matches: "Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches"
  1072	        if_next_focus_suppressed:
  1073	          set: { next_focus: "{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}" }
  1074	          log: "Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate."
  1075	        if_all_candidates_suppressed:
  1076	          halt: true
  1077	          message: "All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus."
  1078	
  1079	      step_ideas_backlog_lifecycle:
  1080	        action: "Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch"
  1081	        read:
  1082	          - "{state_paths.state_log}"
  1083	          - "{state_paths.registry}"
  1084	          - "{state_paths.config}"
  1085	        lifecycle:
  1086	          observed_event: "idea_observed"
  1087	          promoted_event: "idea_promoted"
  1088	          rejected_event: "idea_rejected"
  1089	          min_observations: "{min_idea_observations}"
  1090	          authority: "Leaf agents emit observations only; reducer emits promotions and owns ranking."
  1091	        validate:
  1092	          - "If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted."
  1093	          - "If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea."
  1094	          - "If suppressed_ideas_count > 0, do not render those ideas into dispatch context."
  1095	        outputs:
  1096	          - observed_ideas_count: "Reducer-derived observed ideas count"
  1097	          - promoted_ideas_count: "Reducer-derived promoted ideas count after minIdeaObservations"
  1098	          - suppressed_ideas_count: "Reducer-derived rejected/suppressed ideas count"
  1099	          - accepted_idea_candidate: "First unsuppressed promoted idea, or null"
  1100	
  1101	      step_normalize_pause_events:
  1102	        action: "Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time"
  1103	        stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]
  1104	        rule_pause_sentinel:
  1105	          raw_event_forbidden: '{"type":"event","event":"paused"}'
  1106	          canonical_event: '{"type":"event","event":"userPaused","mode":"research","run":{current_iteration},"stopReason":"userPaused","sentinelPath":"{state_paths.pause_sentinel}","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
  1107	        rule_stuck_recovery:
  1108	          raw_event_forbidden: '{"type":"event","event":"stuck_recovery"}'
  1109	          canonical_event: '{"type":"event","event":"stuckRecovery","mode":"research","run":{current_iteration},"stopReason":"stuckRecovery","fromIteration":{current_iteration},"outcome":"recovered","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
  1110	
  1111	      step_marker_scan:
  1112	        action: "H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker"
  1113	        canonical_header: "DEEP-RESEARCH"
  1114	        nested_marker_pattern: "^(DEEP-REVIEW|CODE-REVIEW)$"
  1115	        algorithm: |
  1116	          if current_iteration > 1:
  1117	            PREV_PROMPT_PATH = "{state_paths.prompt_dir}/iteration-{previous_iteration}.md"
  1118	            if file_exists(PREV_PROMPT_PATH):
  1119	              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH
  1120	              if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:
  1121	                log "ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting."
  1122	                halt with exit code 2
  1123	        note: |
  1124	          False-positive prevention: a research prompt that starts with its own canonical
  1125	          header is this loop's own iteration output, never a nested dispatch; only a review
  1126	          marker is, so the guard matches nested_marker_pattern rather than the canonical
  1127	          header. Markers appearing in comments or body text are ignored. True-positive
  1128	          triggers only when a previous iteration's rendered prompt literally starts with a
  1129	          review marker, indicating a nested research-of-review dispatch.
  1130	
  1131	      step_dispatch_iteration:
  1132	        action: "Dispatch one iteration via the selected executor"
  1133	        resolve_executor:
  1134	          source: "config.executor"
  1135	          loader: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig"
  1136	        pre_dispatch:
  1137	          generate_summary: |
  1138	            STATE SUMMARY (auto-generated):
  1139	            Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}
  1140	            Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}
  1141	            Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}
  1142	            {resource_map_prompt_line}
  1143	            {lineage_context_prompt_line}
  1144	            Next focus: {next_focus}
  1145	          render_prompt_pack:
  1146	            template_path: ".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl"
  1147	            renderer: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack"
  1148	            output_path: "{state_paths.prompt_dir}/iteration-{current_iteration}.md"
  1149	            variables:
  1150	              state_summary: "{state_summary}"
  1151	              research_topic: "{research_topic}"
  1152	              current_iteration: "{current_iteration}"
  1153	              max_iterations: "{max_iterations}"
  1154	              next_focus: "{next_focus}"
  1155	              remaining_questions_list: "{remaining_questions_list}"
  1156	              carried_forward_open_questions: "{carried_forward_open_questions}"
  1157	              last_3_summaries: "{last_3_summaries}"
  1158	              pivot_lineage: "{pivot_lineage}"
  1159	              saturated_directions: "{saturated_directions}"
  1160	              state_paths_config: "{state_paths.config}"
  1161	              state_paths_state_log: "{state_paths.state_log}"
  1162	              state_paths_strategy: "{state_paths.strategy}"
  1163	              state_paths_registry: "{state_paths.registry}"
  1164	              state_paths_iteration_pattern: "{state_paths.iteration_pattern}"
  1165	              state_paths_delta_pattern: "{state_paths.delta_pattern}"
  1166	        pre_dispatch_audit:
  1167	          skip_when: "config.executor.type == 'native'"
  1168	          call: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor"
  1169	          args:
  1170	            stateLogPath: "{state_paths.state_log}"
  1171	            executor: "{config.executor}"
  1172	            iteration: "{current_iteration}"
  1173	        branch_on: "config.executor.type"
  1174	        if_native:
  1175	          dispatch:
  1176	            agent: deep-research
  1177	            model: opus
  1178	            context_source: "rendered_prompt_pack"
  1179	          wait_for_completion: true
  1180	        if_cli_claude_code:
  1181	          command: |
  1182	            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
  1183	            import { readFileSync } from 'node:fs';
  1184	            import { createHash } from 'node:crypto';
  1185	
  1186	            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
  1187	            import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
  1188	
  1189	            const executor = {
  1190	              kind: 'cli-claude-code',
  1191	              model: '{config.executor.model}',
  1192	              reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',
