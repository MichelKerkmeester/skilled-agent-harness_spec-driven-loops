   966	                  wait_for_completion: true
   967	                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003."
   968	                outputs:
   969	                  - pivot_seat_003_dispatch_status: "fulfilled or rejected"
   970	                  - pivot_seat_003_output_json: "Raw native return serialized as JSON when fulfilled"
   971	                  - pivot_seat_003_error_json: "{name,message} when rejected"
   972	                  - pivot_seat_003_started_at_iso: "Dispatch start timestamp"
   973	                  - pivot_seat_003_completed_at_iso: "Dispatch completion timestamp"
   974	                  - pivot_seat_003_duration_ms: "Dispatch duration in milliseconds"
   975	
   976	              step_record_pivot_seat_003:
   977	                action: "Durably record the seat-003 native dispatch outcome"
   978	                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'"
   979	                command: |
   980	                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
   981	                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
   982	                  const status = '{pivot_seat_003_dispatch_status}';
