  1255	
  1256	            // cursor-agent/devin/pi have no single-executor branch of their own, so
  1257	            // without this they silently degrade to native. The command builder is the
  1258	            // same one the fan-out lineage path uses, so the enforced model allowlist,
  1259	            // headless write-mode flags, and binary preflight stay one source of truth.
  1260	            // It throws (fail closed) when the binary is absent or the model is off the
  1261	            // allowlist, so a requested CLI executor never becomes native.
  1262	            const require = createRequire(import.meta.url);
  1263	            const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');
  1264	
  1265	            const kind = '{config.executor.type}';
  1266	            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
  1267	            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
  1268	            // The iteration must write its own iteration file, delta and state record,
  1269	            // so the leaf runs workspace-write; the builder maps that to each CLI's real
  1270	            // write-permitting headless flags.
  1271	            const sandboxMode = 'workspace-write';
  1272	            const lineage = { kind, model, sandboxMode };
  1273	            const resolvedSandbox = resolveSandboxMode(sandboxMode);
  1274	            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);
  1275	
  1276	            const repoRoot = '{repo_root}';
  1277	            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
  1278	            const { command, args, input } = buildLineageCommand(
  1279	              lineage,
  1280	              promptBody,
  1281	              resolvedSandbox,
  1282	              resolvedPermission,
  1283	              { env: process.env, cwd: repoRoot },
  1284	            );
  1285	
  1286	            const executor = {
  1287	              kind,
  1288	              model,
  1289	              configDir: null,
  1290	              reasoningEffort: null,
  1291	              serviceTier: null,
  1292	              sandboxMode,
  1293	              timeoutSeconds,
  1294	              governor: null,
  1295	            };
  1296	            const dispatchId = 'research-i{current_iteration}-g{generation}';
  1297	            const artifactDir = '{artifact_dir}';
  1298	            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
  1299	            const dispatchExit = runAuditedExecutorCommand({
  1300	              command,
  1301	              args,
  1302	              cwd: repoRoot,
  1303	              timeoutSeconds,
  1304	              stateLogPath: '{state_paths.state_log}',
  1305	              executor,
  1306	              iteration: Number('{current_iteration}'),
  1307	              input,
  1308	              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
  1309	              dispatchId,
  1310	            });
  1311	            const containment = enforceWriteContainment({
  1312	              repoRoot,
  1313	              artifactDir,
  1314	              preDispatchDirtyPaths,
  1315	              stateLogPath: '{state_paths.state_log}',
  1316	              iteration: Number('{current_iteration}'),
  1317	              label: dispatchId,
  1318	            });
  1319	            if (containment.violations.length > 0) {
  1320	              console.error(
  1321	                'write-containment advisory: detected ' + containment.violations.length
  1322	                  + ' out-of-scope path(s), left on disk: '
  1323	                  + containment.violations.map((v) => v.path).join(', '),
  1324	              );
  1325	            }
  1326	            process.exit(dispatchExit);
  1327	            EOF
