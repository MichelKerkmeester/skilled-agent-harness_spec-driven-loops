  1247	            import { readFileSync } from 'node:fs';
  1248	            import { createRequire } from 'node:module';
  1249	            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
