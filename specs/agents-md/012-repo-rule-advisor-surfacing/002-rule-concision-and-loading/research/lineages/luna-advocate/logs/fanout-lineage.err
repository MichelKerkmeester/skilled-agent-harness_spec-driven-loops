     1	# ─────────────────────────────────────────────────────────────────
     2	# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)
     3	# ─────────────────────────────────────────────────────────────────
     4	# YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):
     5	# - This asset does not currently use typed BooleanExpr predicates under
     6	#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,
     7	#   `on_restart`, etc.). Retain the existing shape.
     8	# - `after:` carries prose timing / narrative notes if needed; `when:` in
     9	#   this file is reserved for future typed predicates and must NOT carry
    10	#   free-form narrative prose.
    11	# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`
    12	#   for the canonical BooleanExpr grammar.
    13	#
    14	# GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):
    15	# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files
    16	#   and JSONL state-log appends. The workflow classifies resume as
    17	#   write-path below (see `gate3_classification` fields) so Gate 3 trigger
    18	#   extraction can surface resume correctly rather than false-negative.
    19	# ─────────────────────────────────────────────────────────────────
    20	role: Deep Research Loop Manager
    21	purpose: Iterative deep research with convergence detection
    22	action: Run deep-research loop from initialization through synthesis
    23	operating_mode:
    24	  workflow: iterative_loop
    25	  workflow_compliance: MANDATORY
    26	  workflow_execution: autonomous
    27	  approvals: none
    28	  tracking: progressive_research_state
    29	  validation: convergence_detection
    30	
    31	# ─────────────────────────────────────────────────────────────────
    32	# OPERATING PRINCIPLES
    33	# ─────────────────────────────────────────────────────────────────
    34	operating_principles:
    35	  core: "Fresh context per iteration + externalized state = no context degradation"
    36	  approach: "Dispatch focused agent, evaluate convergence, repeat or stop"
    37	  mandate: "Never hold findings in memory; write everything to files"
    38	
    39	# ─────────────────────────────────────────────────────────────────
    40	# USER INPUTS (from setup phase)
    41	# ─────────────────────────────────────────────────────────────────
    42	user_inputs:
    43	  research_topic: "[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED."
    44	  spec_folder: "[SPEC_FOLDER] - Spec folder path. REQUIRED."
    45	  max_iterations: "[MAX_ITERATIONS] - Maximum loop iterations. Default: 10."
    46	  convergence_threshold: "[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05."
    47	  convergence_mode: "[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default."
    48	  stop_policy: "[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence."
    49	
    50	# ─────────────────────────────────────────────────────────────────
    51	# CONTEXT LOADING
    52	# ─────────────────────────────────────────────────────────────────
    53	context_loading:
    54	  trigger: "At workflow START, before phase_init"
    55	  purpose: "Load prior research context for the topic and buffer it until strategy.md exists"
    56	  retrieval:
    57	    mechanism: "continuity-ladder-then-ripgrep"
    58	    note: "File reads only. Nothing here needs a running daemon, and every step is reproducible by hand."
    59	    ladder:
    60	      - "{spec_folder}/handover.md when present"
    61	      - "the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md"
    62	      - "the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open"
    63	    free_text_recipe: "rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled"
    64	    recipe_contract: ".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md"
    65	    exit_status: "0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit"
    66	    ranking: "Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5."
    67	  when_to_skip: ["User says 'skip context' or 'fresh start'"]
    68	  behavior:
    69	    if_context_found: "Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created."
    70	    if_no_context: "Set prior_context and prior_context_summary to 'None' and continue."
    71	
    72	# ─────────────────────────────────────────────────────────────────
    73	# SKILL REFERENCE
    74	# ─────────────────────────────────────────────────────────────────
    75	skill_reference:
    76	  skill: system-deep-loop
    77	  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md
    78	  references:
    79	    loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md
    80	    spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md
    81	    state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md
    82	    convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md
    83	  templates:
    84	    config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json
    85	    strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md
    86	
    87	# ─────────────────────────────────────────────────────────────────
    88	# AGENT CONFIGURATION
    89	# ─────────────────────────────────────────────────────────────────
    90	agent_config:
    91	  agent: deep-research
    92	  agent_file: ".skilled/agents/deep-research.md"
    93	  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.
    94	  model: opus
    95	  leaf_only: true
    96	  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]
    97	  mcp_servers: []
    98	  tool_call_budget: { target: 12, max: 24 }
    99	
   100	# ─────────────────────────────────────────────────────────────────
   101	# STATE FILE PATHS
   102	# ─────────────────────────────────────────────────────────────────
   103	# ─────────────────────────────────────────────────────────────────
   104	# CANONICAL STATE WRITE MECHANISM
   105	# ─────────────────────────────────────────────────────────────────
   106	state_write_protocol:
   107	  mechanism: "append-gateway"
   108	  command: "node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>"
   109	  applies_to: "every append_to_jsonl and append_jsonl directive in this workflow"
   110	  refusal_handling: "halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed."
   111	  pinned_bookkeeping:
   112	    events: [config_warning, graph_convergence, lock_released, migration, min_iterations_guard_pass, stuckRecovery]
   113	    directive: "bookkeeping_log"
   114	    handling: "These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition."
   115	  contract: |
   116	    The directives below specify WHAT to record; this block specifies the mechanism. The
   117	    command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an
   118	    `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,
   119	    which it upcasts before appending. Where the upcast is lossy it returns a warning, and
   120	    the warning is surfaced rather than swallowed. Some directives below record workflow
   121	    bookkeeping rather than research semantics: the schema deliberately pins several of them
   122	    to the legacy path and the upcaster has no registered stem for the rest. Those rows are
   123	    declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never
   124	    routed here. A refusal names its own reason, so the caller can tell a deliberate pin from
   125	    a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the
   126	    reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next
   127	    paragraph: exit 1 means the input never reached authority, exit 2 means authority refused
   128	    it.
   129	
   130	    The gateway authorizes the write against the mode's durable authority record, serialises it
   131	    behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0
   132	    means the record is durable. Exit 2 means it was refused, and the refusal names the check
   133	    that failed.
   134	
   135	    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers
   136	    can then interleave with no shared ordering, and a record nobody authorized carries no
   137	    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal
   138	    is a halt, never a reason to write the file directly.
   139	
   140	    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and
   141	    the synthesis reconciliation rows are canonical ledger events, because state_log is a
   142	    projection the gateway rebuilds from the ledger and a row written beside it is dropped by
   143	    the next refresh.
   144	
   145	state_paths:
   146	  # Template paths document the canonical packet layout. Runtime resolution happens via
   147	  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local
   148	  # research/ and child phases keep local research/ packet directories.
   149	  packet_dir: "{artifact_dir}"
   150	  config: "{artifact_dir}/deep-research-config.json"
   151	  state_log: "{artifact_dir}/deep-research-state.jsonl"
   152	  status_ledger: "{artifact_dir}/orchestration-status.log"
   153	  strategy: "{artifact_dir}/deep-research-strategy.md"
   154	  registry: "{artifact_dir}/findings-registry.json"
   155	  dashboard: "{artifact_dir}/deep-research-dashboard.md"
   156	  pause_sentinel: "{artifact_dir}/.deep-research-pause"
   157	  run_now_sentinel: "{artifact_dir}/.deep-research-run-now"
   158	  lock_file: "{artifact_dir}/.deep-research.lock"
   159	  prompt_dir: "{artifact_dir}/prompts"
   160	  iteration_dir: "{artifact_dir}/iterations"
   161	  iteration_pattern: "{artifact_dir}/iterations/iteration-{NNN}.md"
   162	  # Per-iteration structured delta stream (one file per iteration) — complement to the
   163	  # canonical state_log append. The delta file MUST contain at least one record whose
   164	  # `type === "iteration"` so the reducer can rehydrate iteration state after a partial
   165	  # run. Variants like `"iteration_delta"` are silently dropped by the reducer; the
   166	  # post_dispatch_validate step enforces the canonical type below.
   167	  delta_dir: "{artifact_dir}/deltas"
   168	  delta_pattern: "{artifact_dir}/deltas/iter-{NNN}.jsonl"
   169	  research_output: "{artifact_dir}/research.md"
   170	  resource_map_output: "{artifact_dir}/resource-map.md"
   171	  archive_root: "{artifact_archive_root}"
   172	  synthesis_snapshot_pattern: "{artifact_dir}/synthesis-v{generation}.md"
   173	
   174	# ─────────────────────────────────────────────────────────────────
   175	# WORKFLOW
   176	# ─────────────────────────────────────────────────────────────────
   177	workflow:
   178	
   179	  step_resolve_artifact_root:
   180	    description: "Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder"
   181	    note: "Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/."
   182	    branch_on: "config.fanout_lineage_artifact_dir"
   183	    if_present:
   184	      bind:
   185	        artifact_dir: "{config.fanout_lineage_artifact_dir}"
   186	        artifact_root_dir: "{config.fanout_lineage_artifact_dir}"
   187	        artifact_subfolder: null
   188	        artifact_archive_root: "{config.fanout_lineage_artifact_dir}/_archive"
   189	    if_absent:
   190	      command: "node -e \"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\""
   191	      outputs:
   192	        - artifact_root_dir: "Resolved local research owner directory"
   193	        - artifact_subfolder: "Local packet subfolder ({ownerSlug}-pt-{NN}), else null"
   194	        - artifact_dir: "Resolved research packet directory for this target"
   195	        - artifact_archive_root: "Resolved local research archive directory for this target"
   196	
   197	  step_fanout_spawn:
   198	    description: "Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor"
   199	    skip_when: "config.fanout is absent"
   200	    instructions: |
   201	      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own
   202	      isolated sub-packet under {artifact_dir}/lineages/{label}/.
   203	      fanout-run.cjs owns native and CLI lineage execution; native is run through the
   204	      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF
   205	      deep-research agent is used only for individual iterations, never as a full-loop
   206	      sub-agent or pasted phase-running prompt.
   207	      After all lineages complete, jump directly to phase_synthesis — skip phase_init and
   208	      phase_main_loop entirely (those are the single-executor path). The merge step in
   209	      phase_synthesis will consolidate results across all lineages.
   210	    sub_steps:
   211	      step_fanout_spawn_cli:
   212	        description: "Spawn all native and CLI lineages in capped worker pool"
   213	        skip_when: "no entries in config.fanout.executors"
   214	        command: |
   215	          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \
   216	            --spec-folder {spec_folder} \
   217	            --loop-type research \
   218	            --research-topic "{research_topic}" \
   219	            --fanout-config-json '{config.fanout_json}' \
   220	            --base-artifact-dir {artifact_dir} \
   221	            --convergence-threshold {convergence_threshold} \
   222	            --stop-policy {stop_policy} \
   223	            --convergence-mode {convergence_mode}
   224	        working_directory: "{repo_root}"
   225	        wait_for_completion: true
   226	
   227	  # ═══════════════════════════════════════════════════════════════
   228	  # PHASE 1: INITIALIZATION
   229	  # ═══════════════════════════════════════════════════════════════
   230	  phase_init:
   231	    purpose: Create all state files for the research session
   232	    steps:
   233	
   234	      step_preflight_contract:
   235	        action: "Validate required setup bindings and executable workflow contract before any file writes"
   236	        verify:
   237	          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]
   238	          - spec_folder_is_within: "specs/ or .opencode/specs/ (canonicalize alias roots before validation)"
   239	          - unresolved_placeholders: "FAIL if any user-facing template references placeholders not produced by earlier steps"
   240	          - tool_contract: "FAIL if executable steps reference tools outside the command allowlist"
   241	        on_fail: "Halt with STATUS=FAIL and report the missing binding or unsupported contract reference"
   242	
   243	      step_create_directories:
   244	        action: "Create spec folder and research packet directories if they don't exist"
   245	        command: "mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}"
   246	
   247	      step_detect_resource_map:
   248	        action: "Detect resource-map.md before config creation so init can persist the flag and seed Known Context"
   249	        inspect:
   250	          - "{spec_folder}/resource-map.md"
   251	        classify:
   252	          present: "resource-map.md exists at init"
   253	          absent: "resource-map.md does not exist at init"
   254	        outputs:
   255	          - resource_map_present: "Boolean true when {spec_folder}/resource-map.md exists, else false"
   256	          - resource_map_known_context: "When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'."
   257	
   258	      step_resolve_canonical_names:
   259	        action: "Resolve canonical research packet artifact names before classification"
   260	        inspect_legacy:
   261	          - "{state_paths.packet_dir}/config.json"
   262	          - "{state_paths.packet_dir}/state.jsonl"
   263	          - "{state_paths.packet_dir}/strategy.md"
   264	          - "{state_paths.packet_dir}/dashboard.md"
   265	          - "{state_paths.packet_dir}/.pause"
   266	        migration_policy: "dual-read / single-write for 4 weeks"
   267	        on_legacy_read:
   268	          bookkeeping_log: '{"type":"event","event":"migration","legacyPath":"{legacy_path}","canonicalPath":"{canonical_path}","timestamp":"{ISO_8601_NOW}"}'
   269	
   270	      step_acquire_lock:
   271	        action: "Acquire the single-writer advisory lock before session classification"
   272	        command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder}"
   273	        on_acquire: "Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet."
   274	        note: "Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls; stale-lock override is confirm-only or explicit recovery-only."
   275	        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.
   276	        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.
   277	        on_halt:
   278	          action: "Release the lock before any terminal halt branch returns control"
   279	          applies_to: ["step_classify_session.on_invalid_state", "step_classify_session.on_completed_session", "step_preinit_spec_branch.conflict-detected"]
   280	          command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt"
   281	        on_cancel:
   282	          action: "Release the lock on user cancel or pause-sentinel detection before sentinel processing"
   283	          command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result"
   284	        on_workflow_exit:
   285	          action: "Release the lock as the final step of any workflow exit path (success or failure)"
   286	          command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released"
   287	
   288	      step_classify_session:
   289	        action: "Classify the session before writing files"
   290	        inspect:
   291	          - "{state_paths.config}"
   292	          - "{state_paths.state_log}"
   293	          - "{state_paths.strategy}"
   294	        classify:
   295	          fresh: "None of the three state artifacts exist"
   296	          resume: "Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null"
   297	          completed-session: "Resume artifacts exist and config.status == 'complete'"
   298	          invalid-state: "Any partial, missing, or contradictory combination"
   299	        outputs:
   300	          - session_state: "fresh | resume | completed-session | invalid-state"
   301	        on_resume:
   302	          # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.
   303	          # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).
   304	          gate3_classification: write-path
   305	          gate3_rationale: "resume produces iteration-NNN.md writes and JSONL state-log appends"
   306	          log: "Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive)."
   307	          append_jsonl: '{"type":"event","event":"resumed","mode":"research","sessionId":"{session_id}","parentSessionId":"{session_id}","lineageMode":"resume","continuedFromRun":{iteration_count},"generation":{generation},"archivedPath":null,"timestamp":"{ISO_8601_NOW}"}'
   308	          skip_to: phase_loop
   309	        on_restart:
   310	          action: "Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1."
   311	          command: "if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi"
   312	          set:
   313	            lineage_mode: "restart"
   314	            parent_session_id: "{prior_session_id}"
   315	            generation: "{prior_generation + 1}"
   316	          append_jsonl: '{"type":"event","event":"restarted","mode":"research","sessionId":"{session_id}","parentSessionId":"{prior_session_id}","lineageMode":"restart","generation":{generation},"archivedPath":"{state_paths.archive_root}/{timestamp_slug}","timestamp":"{ISO_8601_NOW}"}'
   317	          skip_to: step_create_config
   318	        note_deferred_branches: "fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract."
   319	        on_completed_session:
   320	          log: "Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead."
   321	          halt: true
   322	          message: "Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session."
   323	        on_invalid_state:
   324	          halt: true
   325	          message: "Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing."
   326	        on_fresh:
   327	          action: "Proceed with a new session"
   328	
   329	      step_resolve_session_id:
   330	        action: "Resolve init session id from caller when supplied, else preserve the auto-generated fallback"
   331	        branch_on: "session_id"
   332	        if_present:
   333	          bind:
   334	            session_id_init: "{session_id}"
   335	        if_absent:
   336	          bind:
   337	            # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.
   338	            AUTO_SESSION_ID: "{ISO_8601_NOW}"
   339	            session_id_init: "{AUTO_SESSION_ID}"
   340	
   341	      step_create_config:
   342	        action: "Create deep-research-config.json from template"
   343	        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json
   344	        populate:
   345	          topic: "{research_topic}"
   346	          maxIterations: "{max_iterations}"
   347	          minIterations: 3
   348	          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §"Convergence Threshold Semantics".
   349	          convergenceThreshold: "{convergence_threshold}"
   350	          stopPolicy: "{stop_policy}"
   351	          antiConvergence.convergenceMode: "{convergence_mode}"
   352	          antiConvergence.divergent: {}
   353	          stuckThreshold: 3
   354	          minIdeaObservations: 2
   355	          maxDurationMinutes: 120
   356	          specFolder: "{spec_folder}"
   357	          resource_map_present: "{resource_map_present}"
   358	          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).
   359	          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.
   360	          resource_map.emit: "{resource_map_emit}"
   361	          createdAt: "{ISO_8601_NOW}"
   362	          status: "initialized"
   363	          executionMode: "auto"
   364	          lineage.sessionId: "{session_id_init}"
   365	          lineage.parentSessionId: null
   366	          lineage.lineageMode: "new"
   367	          lineage.generation: 1
   368	          lineage.continuedFromRun: null
   369	          nextRunAt: null
   370	          remainingDelayMs: null
   371	        output: "{state_paths.config}"
   372	
   373	      step_create_state_log:
   374	        action: "Open the research run by appending deep_research.run_initialized through the gateway"
   375	        note: |
   376	          The state log is a projection rebuilt by the gateway. Recording the run's opening in
   377	          the ledger gives every later state append the same authorized, ordered source.
   378	        command: |
   379	          GATEWAY=".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"
   380	          [ -f "$GATEWAY" ] || GATEWAY="scripts/append-mode-event.cjs"
   381	          EVENT_FILE="$(mktemp "${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX")"
   382	          node -e '
   383	            const fs = require("fs"), crypto = require("crypto");
   384	            const [configPath] = process.argv.slice(1);
   385	            const raw = fs.readFileSync(configPath);
   386	            const config = JSON.parse(raw);
   387	            const sha = (value) => crypto.createHash("sha256").update(value).digest("hex");
   388	            const lineage = config.lineage || {};
   389	            const sessionId = lineage.sessionId;
   390	            const lineageId = lineage.parentSessionId || sessionId;
   391	            const generation = Number(lineage.generation) || 1;
   392	            const configDigest = sha(raw);
   393	            const event = {
   394	              stem: "deep_research.run_initialized",
   395	              scope: { runId: sessionId, lineageId },
   396	              data: {
   397	                generation,
   398	                charterDigest: sha(Buffer.from(JSON.stringify({
   399	                  topic: config.topic,
   400	                  specFolder: config.specFolder || "",
   401	                }))),
   402	                configDigest,
   403	                executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),
   404	                replayFingerprint: sha(Buffer.from(JSON.stringify({
   405	                  runId: sessionId,
   406	                  lineageId,
   407	                  generation,
   408	                  configDigest,
   409	                }))),
   410	                maxIterations: Number(config.maxIterations),
   411	                convergencePolicyVersion: "convergence-policy@" + (
   412	                  (config.antiConvergence && config.antiConvergence.convergenceMode) || "default"
   413	                ),
   414	              },
   415	            };
   416	            process.stdout.write(JSON.stringify(event));
   417	          ' "{state_paths.config}" > "$EVENT_FILE" || { rm -f "$EVENT_FILE"; exit 1; }
   418	          node "$GATEWAY" --mode research --run-directory "$(dirname "{state_paths.state_log}")" --event-json "$EVENT_FILE"
   419	          STATUS=$?
   420	          rm -f "$EVENT_FILE"
   421	          exit "$STATUS"
   422	        output: "{state_paths.state_log}"
   423	
   424	      step_create_strategy:
   425	        action: "Create strategy file from template with initial questions"
   426	        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md
   427	        populate:
   428	          topic: "{research_topic}"
   429	          key_questions: "Derive 3-5 key questions from the research topic"
   430	          known_context: "None"
   431	          known_context_summary: "None"
   432	          max_iterations: "{max_iterations}"
   433	          convergence_threshold: "{convergence_threshold}"
   434	        output: "{state_paths.strategy}"
   435	
   436	      step_create_registry:
   437	        action: "Initialize reducer-owned findings registry"
   438	        content: '{"openQuestions":[],"resolvedQuestions":[],"keyFindings":[],"ruledOutDirections":[],"metrics":{"iterationsCompleted":0,"openQuestions":0,"resolvedQuestions":0,"keyFindings":0,"convergenceScore":0,"coverageBySources":{}}}'
   439	        output: "{state_paths.registry}"
   440	
   441	      step_enrich_strategy_context:
   442	        action: "Ensure Known Context is written only after strategy.md exists"
   443	        condition: "prior_context_found"
   444	        edit: "{state_paths.strategy}"
   445	        note: "Append or replace the Known Context section with prior_context_summary and retained detail from prior_context"
   446	
   447	      step_enrich_strategy_resource_map:
   448	        action: "Inject resource-map status into Known Context after strategy.md exists"
   449	        edit: "{state_paths.strategy}"
   450	        note: "When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'."
   451	
   452	      step_detect_spec_present:
   453	        action: "Classify late-INIT spec.md state after the durable research packet exists"
   454	        inspect:
   455	          - "{spec_folder}/spec.md"
   456	          - "{state_paths.lock_file}"
   457	        classify:
   458	          no-spec: "spec.md is absent before any pre-init mutation"
   459	          spec-present: "spec.md exists and approved host anchors are available for bounded mutation"
   460	          spec-just-created-by-this-run: "spec.md already carries this run's DR seed markers and should not be reseeded"
   461	          conflict-detected: "missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe"
   462	        outputs:
   463	          - folder_state: "no-spec | spec-present | spec-just-created-by-this-run | conflict-detected"
   464	          - normalized_topic: "Trim, lowercase, and collapse whitespace in research_topic before dedupe checks"
   465	        append_to_jsonl: '{"type":"event","event":"spec_check_result","folder_state":"{folder_state}","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","lockPath":"{state_paths.lock_file}","timestamp":"{ISO_8601_NOW}"}'
   466	
   467	      step_preinit_spec_branch:
   468	        action: "Run the bounded pre-init spec branch required by spec_check_protocol"
   469	        protocol_reference: ".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md"
   470	        branches:
   471	          no-spec:
   472	            create: "{spec_folder}/spec.md"
   473	            seed_markers:
   474	              - "<!-- DR-SEED:REQUIREMENTS -->"
   475	              - "<!-- DR-SEED:SCOPE -->"
   476	            requirements_host: "Seed Requirements from the research ask without broadening scope"
   477	            scope_host: "Seed Scope from the research ask without inventing implementation details"
   478	            set:
   479	              folder_state: "spec-just-created-by-this-run"
   480	              validate_spec_doc: true
   481	            append_to_jsonl: '{"type":"spec_mutation","event":"spec_seed_created","folder_state":"spec-just-created-by-this-run","anchors_touched":["Requirements","Scope"],"diff_summary":"Seeded Level 1 spec.md from research topic with DR seed markers.","seed_markers":["DR-SEED:REQUIREMENTS","DR-SEED:SCOPE"],"timestamp":"{ISO_8601_NOW}"}'
   482	          spec-present:
   483	            edit: "{spec_folder}/spec.md"
   484	            set:
   485	              validate_spec_doc: true
   486	            idempotency_check:
   487	              host_anchor: "Open Questions"
   488	              normalized_match: "Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}."
   489	              if_match:
   490	                skip_append: true
   491	                append_to_jsonl: '{"type":"spec_mutation","event":"spec_preinit_context_deduped","folder_state":"spec-present","anchors_touched":["Open Questions"],"diff_summary":"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
   492	              if_no_match:
   493	                append_only:
   494	                  - host_anchor: "Open Questions"
   495	                    content: "Add the normalized research topic only if it is not already present."
   496	                  - host_anchor: "Research Context"
   497	                    content: "Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical."
   498	                append_to_jsonl: '{"type":"spec_mutation","event":"spec_preinit_context_added","folder_state":"spec-present","anchors_touched":["Open Questions","Research Context"],"diff_summary":"Appended bounded pre-init research context for the normalized topic.","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
   499	          spec-just-created-by-this-run:
   500	            verify_markers:
   501	              - "<!-- DR-SEED:REQUIREMENTS -->"
   502	              - "<!-- DR-SEED:SCOPE -->"
   503	            set:
   504	              validate_spec_doc: false
   505	            note: "Treat already-seeded spec.md as a no-op guard and continue."
   506	          conflict-detected:
   507	            append_to_jsonl: '{"type":"spec_mutation","event":"spec_mutation_conflict","folder_state":"conflict-detected","reason":"Pre-init spec.md mutation is ambiguous or unsafe.","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
   508	            halt: true
   509	
   510	      step_validate_preinit_spec_doc:
   511	        action: "Run targeted strict validation after any deep-research pre-init spec.md mutation"
   512	        condition: "validate_spec_doc"
   513	        command: "SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict"
   514	        note: "This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness."
   515	
   516	      step_telemetry_heartbeat_started:
   517	        action: "Emit a single-loop started row in the orchestration status ledger"
   518	        skip_when: "config.fanout is present"
   519	        canonical_lifecycle_event: "iteration_start"
   520	        command: |
   521	          node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
   522	          import { readFileSync } from 'node:fs';
   523	
   524	          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';
   525	          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';
   526	
   527	          const { appendObservabilityEvent } = observabilityEvents;
   528	          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));
   529	          const timestamp = '{ISO_8601_NOW}';
   530	          const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');
   531	          const generation = Number(config.lineage?.generation ?? 1);
   532	          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';
   533	          const row = {
   534	            event: 'started',
   535	            label: 'single',
   536	            at: timestamp,
   537	            duration_ms: 0,
   538	            loop_type: 'research',
   539	            sessionId,
   540	            generation,
   541	            gauges: { iterations: 0, elapsed_ms: 0, score: 0 },
   542	          };
   543	
   544	          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {
   545	            diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },
   546	            diffField: 'state_hash',
   547	          });
   548	          if (appended) {
   549	            try {
   550	              appendObservabilityEvent(observabilityPath, row, {
   551	                producer: 'deep-research-auto',
   552	                stream: 'single-loop-telemetry',
   553	                subject: { label: row.label, sessionId, generation },
   554	                event: row.event,
   555	                status: 'running',
   556	              });
   557	            } catch {}
   558	          }
   559	          EOF
   560	        working_directory: "{repo_root}"
   561	        outputs:
   562	          - status_ledger_started: "A fan-out-shaped status row with label single and event started"
   563	
   564	      step_init_complete:
   565	        log: "Initialization complete. Config, state, and strategy files created."
   566	        set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }
   567	
   568	  # ═══════════════════════════════════════════════════════════════
   569	  # PHASE 2: ITERATION LOOP
   570	  # ═══════════════════════════════════════════════════════════════
   571	  phase_loop:
   572	    purpose: Dispatch agent iterations until convergence
   573	    repeat: true
   574	    max_repeats: "{max_iterations}"
   575	    steps:
   576	
   577	      step_read_state:
   578	        action: "Read current state from JSONL and strategy"
   579	        read:
   580	          - "{state_paths.state_log}"
   581	          - "{state_paths.strategy}"
   582	          - "{state_paths.config}"
   583	        extract:
   584	          - iteration_count: "Count lines where type === 'iteration'"
   585	          - current_iteration: "iteration_count + 1"
   586	          - current_segment: "Latest segment_start event segment, else 1"
   587	          - last_newInfoRatio: "Extract newInfoRatio from last iteration record"
   588	          - last_focus: "Extract focus from latest iteration record, else 'none yet'"
   589	          - ratio_prev: "Extract newInfoRatio from second-latest iteration record, else 'N/A'"
   590	          - ratio_latest: "Extract newInfoRatio from latest iteration record, else 'N/A'"
   591	          - next_focus: "Extract 'Next Focus' section from strategy.md"
   592	          - remaining_questions: "Count unchecked items in 'Key Questions'"
   593	          - remaining_questions_list: "List unchecked key questions from strategy.md"
   594	          - carried_forward_open_questions: "Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'"
   595	          - answered_count: "Count answered questions from strategy.md"
   596	          - total_questions: "Count total questions tracked in strategy.md"
   597	          - resource_map_present: "Extract boolean from deep-research-config.json, default false"
   598	          - resource_map_prompt_line: "If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'"
   599	          - lineage_context_prompt_line: "If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'"
   600	          - least_explored: "First unanswered question not covered by the most recent iteration focus, else first unanswered question"
   601	          - last_3_summaries: "Summarize the latest 3 iteration records as 'run N: focus (ratio)'"
   602	          - latest_status: "Extract status from latest iteration record, else 'none yet'"
   603	          - nextRunAt: "Extract nullable nextRunAt from deep-research-config.json, default null"
   604	          - remainingDelayMs: "Extract nullable remainingDelayMs from deep-research-config.json, default null"
   605	          - min_iterations_present: "Boolean true when deep-research-config.json has a numeric minIterations field"
   606	          - min_iterations_missing_warning: "Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior"
   607	          - min_iterations_raw: "Extract numeric minIterations from deep-research-config.json when present, default 0"
   608	          - effective_min_iterations: "Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations"
   609	          - min_iterations_clamped: "Boolean true when min_iterations_raw > max_iterations"
   610	          - min_iterations_guard_already_passed: "Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations"
   611	          - convergence_mode: "Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'"
   612	          - stop_policy: "Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations."
   613	          - convergence_mode_warning: "Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'"
   614	          - rejected_patterns_count: "Read registry.rejectedPatterns length when registry exists, else 0"
   615	          - rejected_candidate_matches: "Read registry.suppressedCandidates when registry exists, else []"
   616	          - rejected_pattern_fuzzy_threshold: "Read config.rejectedPatternFuzzyThreshold when present, else 0.85"
   617	          - min_idea_observations: "Read config.minIdeaObservations when present, default 2; clamp to 1..10"
   618	          - observed_ideas_count: "Read registry.observedIdeas length when registry exists, else 0"
   619	          - promoted_ideas_count: "Read registry.promotedIdeas length when registry exists, else 0"
   620	          - promoted_ideas_list: "Read registry.promotedIdeas idea text in rank order when registry exists, else []"
   621	          - suppressed_ideas_count: "Read registry.suppressedIdeas length when registry exists, else 0"
   622	          - pivot_lineage: "Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'"
   623	          - saturated_directions: "List registry.divergence.saturatedDirections; else 'none yet'"
   624	
   625	      step_run_now_check:
   626	        action: "Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch"
   627	        command: |
   628	          GATEWAY=".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"
   629	          [ -f "$GATEWAY" ] || GATEWAY="scripts/append-mode-event.cjs"
   630	          EVENT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX")"
   631	          node - "$EVENT_DIR" <<'EOF'
   632	          const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');
   633	          const { join } = require('node:path');
   634	
   635	          const eventDir = process.argv[2];
   636	          const sentinelPath = "{state_paths.run_now_sentinel}";
   637	          const pausePath = "{state_paths.pause_sentinel}";
   638	          const sessionId = "{config.lineage.sessionId}";
   639	          const generation = Number("{config.lineage.generation}");
   640	          const run = Number("{current_iteration}");
   641	
   642	          // The state log is a projection the gateway rebuilds from the ledger, so a
   643	          // run-now row is staged as a canonical ledger event and appended by the
   644	          // gateway; a write beside the projection is dropped by the next refresh.
   645	          // The loop boundary has no lineage identity yet, so the session names both
   646	          // scope halves rather than inventing a second identifier.
   647	          const scope = { runId: sessionId, lineageId: sessionId };
   648	
   649	          let sequence = 0;
   650	
   651	          function record(event, fields) {
   652	            sequence += 1;
   653	            writeFileSync(
   654	              join(eventDir, `${String(sequence).padStart(2, "0")}-${event}.json`),
   655	              JSON.stringify({
   656	                stem: `deep_research.${event}`,
   657	                scope,
   658	                data: { mode: "research", run, sessionId, generation, ...fields },
   659	              }),
   660	              "utf8",
   661	            );
   662	          }
   663	
   664	          if (existsSync(sentinelPath)) {
   665	            record("run_now_requested", { sentinelPath });
   666	            if (existsSync(pausePath)) {
   667	              record("run_now_rejected", {
   668	                sentinelPath,
   669	                reason: "loop_paused",
   670	                pauseSentinelPath: pausePath,
   671	              });
   672	            } else {
   673	              const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;
   674	              try {
   675	                renameSync(sentinelPath, claimPath);
   676	                unlinkSync(claimPath);
   677	                record("run_now_accepted", {
   678	                  sentinelPath,
   679	                  dispatchEvent: "iteration_start",
   680	                });
   681	              } catch (error) {
   682	                if (!error || error.code !== "ENOENT") {
   683	                  throw error;
   684	                }
   685	              }
   686	            }
   687	          }
   688	          EOF
   689	          for eventFile in "$EVENT_DIR"/*.json; do
   690	            [ -e "$eventFile" ] || continue
   691	            node "$GATEWAY" --mode research --run-directory "$(dirname "{state_paths.state_log}")" --event-json "$eventFile"
   692	            GATEWAY_STATUS=$?
   693	            if [ "$GATEWAY_STATUS" -ne 0 ]; then
   694	              rm -rf "$EVENT_DIR"
   695	              exit "$GATEWAY_STATUS"
   696	            fi
   697	          done
   698	          rm -rf "$EVENT_DIR"
   699	        outputs:
   700	          - run_now_requested: "Emitted when {state_paths.run_now_sentinel} exists at the loop boundary"
   701	          - run_now_accepted: "Emitted after the sentinel is atomically renamed and deleted before dispatch"
   702	          - run_now_rejected: "Emitted with reason loop_paused when pause takes precedence; sentinel remains present"
   703	
   704	      step_check_pause_sentinel:
   705	        action: "Check for pause sentinel file"
   706	        check: "Does {state_paths.pause_sentinel} exist?"
   707	        if_exists:
   708	          log_event: '{"type":"event","event":"userPaused","mode":"research","run":{current_iteration},"stopReason":"userPaused","sentinelPath":"{state_paths.pause_sentinel}","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   709	          message: "Research paused. Delete research/.deep-research-pause to resume."
   710	          halt: true
   711	        if_not_exists:
   712	          proceed: true
   713	
   714	      step_validate_convergence_config:
   715	        action: "Validate convergence floor settings when loading config"
   716	        if_min_iterations_missing:
   717	          bookkeeping_log: '{"type":"event","event":"config_warning","mode":"research","field":"minIterations","fallback":0,"message":"minIterations missing; using no convergence floor for backward compatibility.","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   718	          log: "minIterations missing; using no convergence floor for backward compatibility."
   719	        if_min_iterations_clamped:
   720	          bookkeeping_log: '{"type":"event","event":"config_warning","mode":"research","field":"minIterations","configured":{min_iterations_raw},"effective":{effective_min_iterations},"maxIterations":{max_iterations},"message":"minIterations exceeds maxIterations; clamping to the hard cap.","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   721	          log: "minIterations exceeds maxIterations; clamping to the hard cap."
   722	        if_convergence_mode_invalid:
   723	          bookkeeping_log: '{"type":"event","event":"config_warning","mode":"research","field":"convergenceMode","fallback":"default","message":"Unsupported convergenceMode; using default convergence behavior.","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   724	          log: "Unsupported convergenceMode; using default convergence behavior."
   725	
   726	      step_graph_convergence:
   727	        action: "Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot"
   728	        bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder "{spec_folder}" --loop-type "research" --session-id "{config.lineage.sessionId}" --convergence-mode "{convergence_mode}" --persist-snapshot --iteration "{current_iteration}"'
   729	        note: "Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent."
   730	        outputs:
   731	          - graph_decision: "Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable"
   732	          - graph_decision_json: "JSON-encoded graph decision string, else null"
   733	          - graph_signals_json: "Tool signals object, else {}"
   734	          - graph_blockers_json: "Tool blockers array, else []"
   735	          - graph_trace_json: "Tool trace payload, else []"
   736	          - graph_convergence_score: "signals.blendedScore when present, else the best available graph score, else 0"
   737	        bookkeeping_log: '{"type":"event","event":"graph_convergence","mode":"research","run":{current_iteration},"decision":{graph_decision_json},"signals":{graph_signals_json},"blockers":{graph_blockers_json},"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   738	
   739	      step_check_convergence:
   740	        action: "Evaluate stop conditions and combine the inline 3-signal vote with graph convergence"
   741	        algorithm: |
   742	          1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.
   743	          2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY
   744	          3. if convergence_mode == "off": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.
   745	          3a. if stop_policy == "max-iterations" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = "CONTINUE" and choose a broader next focus.
   746	          4. if remaining_questions == 0: STOP (all_questions_answered)
   747	          5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:
   748	               step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.
   749	               The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.
   750	               signals = []
   751	               Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)
   752	               a) Rolling average (w=0.30, needs 3+ iterations):
   753	                  avg = mean(last 3 newInfoRatios)
   754	                  stop if avg < convergence_threshold
   755	               b) MAD noise floor (w=0.35, needs 4+ iterations):
   756	                  noiseFloor = MAD(all ratios) * 1.4826
   757	                  stop if latest ratio <= noiseFloor
   758	               c) Question entropy (w=0.35):
   759	                  coverage = answered / total questions
   760	                  stop if coverage >= 0.85
   761	               Redistribute weights for unavailable signals.
   762	               if weighted_stop_score > 0.60: inline_stop_candidate = true
   763	               Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.
   764	               if inline_stop_candidate and graph_decision == "STOP_BLOCKED":
   765	                 decision = "BLOCKED"
   766	                 reason = "blockedStop"
   767	                 stop_blocked = true
   768	                 blocked_by_json = JSON array derived from graph_blockers_json
   769	                 blocked_by_csv = comma-separated blocker names derived from graph_blockers_json
   770	                 gate_convergence_pass = false
   771	                 gate_convergence_score = graph_convergence_score
   772	                 gate_key_question_coverage_pass = no blocker named questionCoverage
   773	                 gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth
   774	                 gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0
   775	                 gate_hotspot_saturation_pass = true
   776	                 recovery_strategy = first blocker reason/message, else "Collect deeper graph evidence before stopping."
   777	               else if inline_stop_candidate and (graph_decision == "STOP_ALLOWED" or graph_decision is absent):
   778	                 decision = "STOP"
   779	                 reason = "composite_converged"
   780	                 stop_blocked = false
   781	          6. else: CONTINUE
   782	          7. if decision == "STOP" and reason != "maxIterationsReached" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:
   783	               decision = "CONTINUE"
   784	               reason = "minIterationsNotReached"
   785	               min_iterations_guard_blocked = true
   786	               min_iterations_guard_pass = false
   787	          8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:
   788	               min_iterations_guard_pass = true
   789	          9. if decision == "STOP" and reason != "maxIterationsReached":
   790	               guardResult = checkQualityGuards(state, strategy)
   791	               if not guardResult.passed:
   792	                 log: "Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE."
   793	                 decision = "CONTINUE"
   794	          See convergence.md for full pseudocode and signal definitions.
   795	          Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.
   796	        outputs:
   797	          - decision: "STOP | BLOCKED | STUCK_RECOVERY | CONTINUE"
   798	          - reason: "Human-readable stop reason"
   799	          - stop_blocked: "Boolean marker set when graph convergence vetoes an inline STOP candidate"
   800	          - blocked_by_json: "JSON array of graph blocker names when decision == BLOCKED"
   801	          - blocked_by_csv: "Comma-separated graph blocker names when decision == BLOCKED"
   802	          - gate_convergence_pass: "Boolean pass/fail for the graph-assisted convergence gate"
   803	          - gate_convergence_score: "Numeric score recorded from graph convergence"
   804	          - gate_key_question_coverage_pass: "Boolean pass/fail derived from graph blocker coverage signals"
   805	          - gate_evidence_density_pass: "Boolean pass/fail derived from graph blocker evidence-depth signals"
   806	          - gate_evidence_density_sources: "Source-diversity count or equivalent evidence-depth proxy"
   807	          - gate_hotspot_saturation_pass: "Research placeholder gate; true unless an explicit blocker sets otherwise"
   808	          - recovery_strategy: "One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY"
   809	          - min_iterations_guard_pass: "Boolean true when the configured convergence floor has cleared for the first time"
   810	          - min_iterations_guard_blocked: "Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE"
   811	
   812	      step_emit_min_iterations_guard_pass:
   813	        action: "Persist a first-class event when the convergence floor clears"
   814	        if_pass:
   815	          bookkeeping_log: '{"type":"event","event":"min_iterations_guard_pass","mode":"research","run":{current_iteration},"iterationCount":{iteration_count},"minIterations":{effective_min_iterations},"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   816	          log: "Minimum iteration floor cleared for convergence stopping."
   817	
   818	      step_emit_blocked_stop:
   819	        action: "Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked"
   820	        if_blocked:
   821	          append_to_jsonl: '{"type":"event","event":"blocked_stop","mode":"research","run":{current_iteration},"blockedBy":{blocked_by_json},"gateResults":{"convergence":{"pass":{gate_convergence_pass},"score":{gate_convergence_score}},"keyQuestionCoverage":{"pass":{gate_key_question_coverage_pass},"answered":{answered_count},"total":{total_questions}},"evidenceDensity":{"pass":{gate_evidence_density_pass},"sources":{gate_evidence_density_sources}},"hotspotSaturation":{"pass":{gate_hotspot_saturation_pass}}},"recoveryStrategy":"{recovery_strategy}","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
   822	          log: "Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}"
   823	          set:
   824	            decision: "CONTINUE"
   825	            reason: "blockedStop"
   826	            stop_blocked: false
   827	
   828	      step_handle_convergence:
   829	        action: "Act on convergence decision"
   830	        if_stop:
   831	          branch_on: "convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']"
   832	          if_divergent_eligible:
   833	            eligibility_contract:
   834	              required_decision: "STOP"
   835	              eligible_reasons: [composite_converged, all_questions_answered]
   836	              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]
   837	              fail_closed: "Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot."
   838	            steps:
   839	              step_prepare_divergent_pivot:
   840	                action: "Generate state-grounded research candidates and prepare or resume the pivot transaction"
   841	                command: |
   842	                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
   843	                  import {
   844	                    buildResearchPivotPreparationInput,
   845	                    renderResearchPivotSeatPrompt,
   846	                  } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';
   847	                  import {
   848	                    preparePivotTransaction,
   849	                  } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
   850	
   851	                  const input = buildResearchPivotPreparationInput({
   852	                    artifactRoot: '{state_paths.packet_dir}',
   853	                    configPath: '{state_paths.config}',
   854	                    stateLogPath: '{state_paths.state_log}',
   855	                    strategyPath: '{state_paths.strategy}',
   856	                    registryPath: '{state_paths.registry}',
   857	                    currentIteration: Number('{current_iteration}'),
   858	                    maxIterations: Number('{max_iterations}'),
   859	                    triggerReason: '{reason}',
   860	                  });
   861	                  const prepared = await preparePivotTransaction(input);
   862	                  const seatPrompts = prepared.status === 'pending'
   863	                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [
   864	                        seat.id,
   865	                        renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),
   866	                      ]))
   867	                    : {};
   868	                  process.stdout.write(`${JSON.stringify({
   869	                    ...prepared,
   870	                    seatPrompts,
   871	                    boundaryRejections: input.boundaryRejections,
   872	                  })}\n`);
   873	                  EOF
   874	                working_directory: "{repo_root}"
   875	                outputs:
   876	                  - pivot_prepare_json: "The complete parsed JSON result"
   877	                  - pivot_prepare_status: "status from the prepare result"
   878	                  - pivot_id: "pivotId from the prepare result"
   879	                  - pivot_paths_json: "paths from the prepare result as JSON"
   880	                  - pivot_resumed: "resumed from the prepare result"
   881	                  - pivot_missing_seat_ids: "missingSeats ids from a pending result"
   882	                  - pivot_seat_001_json: "The seat-001 mandate object from missingSeats"
   883	                  - pivot_seat_002_json: "The seat-002 mandate object from missingSeats"
   884	                  - pivot_seat_003_json: "The seat-003 mandate object from missingSeats"
   885	                  - pivot_seat_001_prompt: "seatPrompts['seat-001']"
   886	                  - pivot_seat_002_prompt: "seatPrompts['seat-002']"
   887	                  - pivot_seat_003_prompt: "seatPrompts['seat-003']"
   888	                  - pivot_dispatch_context_json: "dispatchContext from a pending result as JSON"
   889	                short_circuit: "When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result."
   890	
   891	              step_dispatch_pivot_seat_001:
   892	                action: "Natively dispatch the analytical research direction-selection seat"
   893	                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'"
   894	                capture_timing: true
   895	                if_native:
   896	                  dispatch:
   897	                    agent: deep-research
   898	                    model: opus
   899	                    context_source: "pivot_seat_001_prompt"
   900	                  wait_for_completion: true
   901	                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001."
   902	                outputs:
   903	                  - pivot_seat_001_dispatch_status: "fulfilled or rejected"
   904	                  - pivot_seat_001_output_json: "Raw native return serialized as JSON when fulfilled"
   905	                  - pivot_seat_001_error_json: "{name,message} when rejected"
   906	                  - pivot_seat_001_started_at_iso: "Dispatch start timestamp"
   907	                  - pivot_seat_001_completed_at_iso: "Dispatch completion timestamp"
   908	                  - pivot_seat_001_duration_ms: "Dispatch duration in milliseconds"
   909	
   910	              step_record_pivot_seat_001:
   911	                action: "Durably record the seat-001 native dispatch outcome"
   912	                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'"
   913	                command: |
   914	                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
   915	                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
   916	                  const status = '{pivot_seat_001_dispatch_status}';
   917	                  const outcome = status === 'fulfilled'
   918	                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }
   919	                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };
   920	                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\n`);
   921	                  EOF
   922	                working_directory: "{repo_root}"
   923	
   924	              step_dispatch_pivot_seat_002:
   925	                action: "Natively dispatch the critical research direction-selection seat"
   926	                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'"
   927	                capture_timing: true
   928	                if_native:
   929	                  dispatch:
