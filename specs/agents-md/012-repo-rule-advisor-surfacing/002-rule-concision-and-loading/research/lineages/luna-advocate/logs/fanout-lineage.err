  1602	        if_cli_codex:
  1603	          command: |
  1604	            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
  1605	            import { readFileSync } from 'node:fs';
  1606	            import { execFileSync } from 'node:child_process';
  1607	
  1608	            import {
  1609	              RECURSION_GUARD_EXIT_CODE,
  1610	              formatRecursionGuardRefusal,
  1611	              runAuditedExecutorCommand,
  1612	              validateExecutorDispatchAllowed,
  1613	            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
  1614	            import {
  1615	              snapshotOutOfScopeDirtyPaths,
  1616	              enforceWriteContainment,
  1617	            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';
  1618	
  1619	            // Fail closed: a requested codex executor must dispatch codex or abort,
  1620	            // never silently degrade to another executor. Undetected absence is what
  1621	            // got Codex deprecated before, so the branch exits non-zero when the
  1622	            // binary is missing instead of falling through to a native/other path.
  1623	            let codexAvailable = false;
  1624	            try {
  1625	              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });
  1626	              codexAvailable = true;
