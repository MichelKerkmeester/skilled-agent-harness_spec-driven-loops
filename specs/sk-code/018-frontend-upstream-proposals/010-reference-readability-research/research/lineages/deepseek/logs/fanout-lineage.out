l":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"ls .skilled/skills/sk-code/sk-code-ci/assets/; echo \\\"===CI SKILL===\\\"; grep -n '^#\\\\{1,3\\\\} ' .skilled/skills/sk-code/sk-code-ci/SKILL.md; echo \\\"===CI ROUTER===\\\"; grep -n '^#\\\\{1,3\\\\} ' .skilled/skills/sk-code/sk-code-ci/ROUTER.md; echo \\\"===DBL BLANK===\\\"; grep -rn 'assets/workflow-template.yml' .skilled/skills/sk-code/sk-code-ci/ | head\"}"},"time":{"start":1793742598782,"end":1793742599038}}}}
