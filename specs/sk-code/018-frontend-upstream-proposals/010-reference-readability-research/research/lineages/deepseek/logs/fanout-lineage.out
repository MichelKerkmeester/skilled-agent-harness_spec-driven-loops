ion_targets\"\n      ],\n      \"routerRequiredSections\": [\n        \"owned_assets\",\n        \"presentation_boundary\"\n      ],\n      \"routerRecommendedSections\": [\n        \"router_contract\",\n        \"mode_routing\",\n        \"execution_targets\",\n        \"workflow_summary\"\n      ],\n      \"recommendedSections\": [\n        \"contract\",\n        \"examples\",\n        \"notes\"\n      ],\n      \"optionalSections\": [\n        \"workflow\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"grep -n '\\\"reference\\\":' .skilled/skills/sk-doc/shared/assets/template-rules.json; sed -n '148,178p' .skilled/skills/sk-doc/shared/assets/template-rules.json\"}"},"time":{"start":1793742902142,"end":1793742902175}}}}
