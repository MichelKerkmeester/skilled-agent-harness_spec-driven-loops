{"type":"tool_use","timestamp":1793742867999,"sessionID":"ses_e5ca055c6ffeOZO66b0AKuGGW6","part":{"partID":"prt_1a3680dc9001fR1tXe4dT0gbVB","sessionID":"ses_e5ca055c6ffeOZO66b0AKuGGW6","messageID":"msg_1a36805c7001JsmmnaCqsdd1OA","type":"tool","id":"call_00_efsz3d4pbk9itl0y7ei1btj8","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/sk-doc/scripts/validate_document.py","offset":603,"limit":345},"output":"Read file .skilled/skills/sk-doc/scripts/validate_document.py, lines 603-947\n603: # 4. HEADER VALIDATION\n604: # ───────────────────────────────────────────────────────────────\n605: \n606: def _fenced_line_numbers(content: str) -> set:\n607:     \"\"\"1-based line numbers that fall inside fenced code blocks.\n608: \n609:     Tracks the opening fence's backtick length so a longer outer fence (```` )\n610:     keeps shorter inner fences (```) literal, and a closing fence must be at least\n611:     as long as its opener with no info string. This is why a naive \"any ``` opens,\n612:     a bare ``` closes\" scan mis-nests 4-backtick doc examples. Used so section\n613:     numbering ignores numbered headers shown inside a copy-able template example —\n614:     they are content, not document sections.\n615:     \"\"\"\n616:     fenced = set()\n617:     fence_len = 0\n618:     for i, line in enumerate(content.split('\\n'), start=1):\n619:         stripped = line.strip()\n620:         if stripped.startswith('```'):\n621:             ticks = len(stripped) - len(stripped.lstrip('`'))\n622:             info = stripped[ticks:].strip()\n623:             fenced.add(i)\n624:             if fence_len == 0:\n625:                 fence_len = ticks\n626:             elif ticks >= fence_len and info == '':\n627:                 fence_len = 0\n628:             continue\n629:         if fence_len > 0:\n630:             fenced.add(i)\n631:     return fenced\n632: \n633: \n634: _STRUCTURE_ENFORCEMENT_ENV = 'SKDOC_ENFORCE_STRUCTURE'\n635: \n636: \n637: def is_repo_root_readme(file_path: str) -> bool:\n638:     \"\"\"Whether the file is the README at a repository root, the directory that holds\n639:     `.git` (a folder in a checkout, a file in a linked worktree). That README separates\n640:     its sections with `&nbsp;` lines instead of `---` rules, so the divider rule skips it.\"\"\"\n641:     path = Path(file_path).resolve()\n642:     return path.name.lower() == 'readme.md' and (path.parent / '.git').exists()\n643: \n644: \n645: def _structure_enforcement_enabled() -> bool:\n646:     \"\"\"Whether the general-path structure rules are enforced: a `---` divider between\n647:     numbered ALL-CAPS H2 sections, no Table of Contents, and no navigation-anchor\n648:     comments. Enforced by default. Set SKDOC_ENFORCE_STRUCTURE=0 to opt out, e.g. while\n649:     migrating a doc set whose section structure has not been normalized yet.\"\"\"\n650:     return os.environ.get(_STRUCTURE_ENFORCEMENT_ENV, '1') != '0'\n651: \n652: \n653: def _transparent_structure_line(line: str) -> bool:\n654:     \"\"\"Return whether a line is transparent when checking a section boundary.\"\"\"\n655:     stripped = line.strip()\n656:     return not stripped or bool(re.fullmatch(r'<!--.*-->', stripped))\n657: \n658: \n659: def _section_caps_ignoring_qualifier(title: str) -> bool:\n660:     \"\"\"A numbered H2 counts as a section heading when its text, minus any parenthetical\n661:     qualifier, is uppercase. This keeps headings like \"FILE-LAYER SURFACE (what the AI\n662:     edits)\" in scope while leaving genuinely title-case headings out.\"\"\"\n663:     core = re.sub(r'\\([^)]*\\)', '', title).strip()\n664:     return bool(core) and core == core.upper()\n665: \n666: \n667: def validate_general_structure(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n668:     \"\"\"Validate staged divider and navigation rules for the general path.\"\"\"\n669:     if not _structure_enforcement_enabled():\n670:         return []\n671: \n672:     errors: List[Dict[str, Any]] = []\n673:     lines = content.splitlines()\n674:     fenced_lines = _fenced_line_numbers(content)\n675: \n676:     if doc_type_rules.get('h2DividerRequired', False):\n677:         h2_pattern = re.compile(r'^##\\s+(\\d+)\\.\\s+(.+?)\\s*$')\n678:         numbered_h2_lines = []\n679:         for line_number, line in enumerate(lines, start=1):\n680:             if line_number in fenced_lines:\n681:                 continue\n682:             match = h2_pattern.match(line)\n683:             if match and _section_caps_ignoring_qualifier(match.group(2)):\n684:                 numbered_h2_lines.append(line_number)\n685: \n686:         for line_number in numbered_h2_lines[1:]:\n687:             previous = line_number - 1\n688:             while previous > 0 and _transparent_structure_line(lines[previous - 1]):\n689:                 previous -= 1\n690:             if previous == 0 or lines[previous - 1].strip() != '---':\n691:                 errors.append({\n692:                     'type': 'general_h2_separator',\n693:                     'rule_id': 'general_h2_separator',\n694:                     'severity': 'blocking',\n695:                     'message': 'Numbered ALL-CAPS H2 sections must be separated by `---`.',\n696:                     'line': lines[line_number - 1],\n697:                     'line_number': line_number,\n698:                     'fix_hint': 'Add `---` immediately above the numbered H2 section.',\n699:                 })\n700: \n701:     outside_body = '\\n'.join(\n702:         line for line_number, line in enumerate(lines, start=1)\n703:         if line_number not in fenced_lines\n704:     )\n705:     if doc_type_rules.get('tocForbidden', False) and re.search(\n706:         r'(?im)^\\s*(?:#{1,6}\\s+)?(?:\\d+\\.\\s+)?TABLE OF CONTENTS\\b',\n707:         outside_body,\n708:     ):\n709:         errors.append({\n710:             'type': 'general_no_toc',\n711:             'rule_id': 'general_no_toc',\n712:             'severity': 'blocking',\n713:             'message': 'This document type must not contain a Table of Contents.',\n714:             'fix_hint': 'Remove the Table of Contents and use numbered H2 sections for navigation.',\n715:         })\n716:     if doc_type_rules.get('anchorNavigationForbidden', False) and re.search(\n717:         r'^[ \\t]*<!--[ \\t]*/?ANCHOR:[^>\\r\\n]*-->[ \\t]*$',\n718:         outside_body,\n719:         re.IGNORECASE | re.MULTILINE,\n720:     ):\n721:         errors.append({\n722:             'type': 'general_no_anchor',\n723:             'rule_id': 'general_no_anchor',\n724:             'severity': 'blocking',\n725:             'message': 'This document type must not contain anchor-comment navigation.',\n726:             'fix_hint': 'Remove navigation anchor comments and use numbered H2 sections instead.',\n727:         })\n728: \n729:     return errors\n730: \n731: \n732: def validate_h2_headers(content: str, doc_type_rules: Dict[str, Any], rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n733:     \"\"\"Validate H2 header format and emojis.\"\"\"\n734:     errors = []\n735: \n736:     h2_pattern = re.compile(r'^## (\\d+)\\.\\s+(.+)$', re.MULTILINE)\n737:     matches = list(h2_pattern.finditer(content))\n738:     fenced_lines = _fenced_line_numbers(content)\n739: \n740:     if not matches:\n741:         # No numbered H2 headers found - check if this is expected\n742:         # Some documents might use different header styles\n743:         return errors\n744: \n745:     expected_num = 1\n746:     emoji_required = doc_type_rules.get('h2EmojiRequired', True)\n747:     section_emojis = doc_type_rules.get('sectionEmojis', {})\n748:     section_aliases = doc_type_rules.get('sectionAliases', {})\n749: \n750:     for match in matches:\n751:         num = int(match.group(1))\n752:         title = match.group(2).strip()\n753:         line = match.group(0)\n754: \n755:         # A numbered header inside a fenced example (a copy-able skeleton) is\n756:         # content, not a section, so it must not break or advance the outer\n757:         # document sequence. Emoji/uppercase checks below intentionally still\n758:         # apply to every match, keeping their behavior unchanged.\n759:         header_line = content.count('\\n', 0, match.start()) + 1\n760:         if header_line not in fenced_lines:\n761:             if num != expected_num:\n762:                 errors.append({\n763:                     'type': 'non_sequential_numbering',\n764:                     'severity': 'warning',\n765:                     'message': f'Non-sequential section number: expected {expected_num}, found {num}',\n766:                     'line': line\n767:                 })\n768:             expected_num = num + 1\n769: \n770:         if emoji_required:\n771:             title_has_emoji = has_emoji(title)\n772: \n773:             if not title_has_emoji:\n774:                 section_name = normalize_section_name(title)\n775: \n776:                 if section_name in section_aliases:\n777:                     section_name = section_aliases[section_name]\n778: \n779:                 expected_emoji = section_emojis.get(section_name)\n780: \n781:                 # Fallback: match ignoring underscores for flexibility\n782:                 if not expected_emoji:\n783:                     section_name_no_underscore = section_name.replace('_', '')\n784:                     for key, emoji in section_emojis.items():\n785:                         if key.replace('_', '') == section_name_no_underscore:\n786:                             expected_emoji = emoji\n787:                             break\n788: \n789:                 errors.append({\n790:                     'type': 'missing_h2_emoji',\n791:                     'severity': 'blocking',\n792:                     'message': f'H2 header missing emoji: \"{line}\"',\n793:                     'line': line,\n794:                     'section_name': section_name,\n795:                     'expected_emoji': expected_emoji,\n796:                     'auto_fixable': expected_emoji is not None,\n797:                     'fix': f'## {num}. {expected_emoji} {title}' if expected_emoji else None,\n798:                     'fix_hint': f'Add {expected_emoji} after \"{num}.\"' if expected_emoji else 'Add appropriate emoji after section number'\n799:                 })\n800: \n801:         # Check for ALL CAPS (only for document types that require it)\n802:         uppercase_required = doc_type_rules.get('h2UppercaseRequired', False)\n803:         if uppercase_required and not is_uppercase_section(title):\n804:             section_text = extract_section_name_text(title)\n805:             # Extract emoji if present\n806:             emoji = extract_first_emoji(title)\n807: \n808:             if emoji:\n809:                 # Has emoji: \"EMOJI name\" -> \"EMOJI NAME\"\n810:                 title_after_emoji = EMOJI_PATTERN.sub('', title).strip()\n811:                 fixed_title = f'{emoji} {title_after_emoji.upper()}'\n812:             else:\n813:                 # No emoji: just uppercase\n814:                 fixed_title = title.upper()\n815: \n816:             errors.append({\n817:                 'type': 'h2_not_uppercase',\n818:                 'severity': 'blocking',\n819:                 'message': f'H2 header not ALL CAPS: \"{line}\"',\n820:                 'line': line,\n821:                 'auto_fixable': True,\n822:                 'fix': f'## {num}. {fixed_title}',\n823:                 'fix_hint': f'Change \"{section_text}\" to \"{section_text.upper()}\"'\n824:             })\n825: \n826:     return errors\n827: \n828: \n829: # ───────────────────────────────────────────────────────────────\n830: # 5. SECTION VALIDATION\n831: # ───────────────────────────────────────────────────────────────\n832: \n833: def validate_required_sections(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n834:     \"\"\"Check that required sections are present.\"\"\"\n835:     errors = []\n836: \n837:     required = doc_type_rules.get('requiredSections', [])\n838:     section_aliases = doc_type_rules.get('sectionAliases', {})\n839: \n840:     # Compiled-contract commands are thin runtime dispatchers whose section content is\n841:     # rendered from a compiled source at invocation, not written in the .md file, so\n842:     # there is no prose section shape to require here.\n843:     contract_marker = doc_type_rules.get('compiledContractMarker')\n844:     if contract_marker and contract_marker in content:\n845:         return errors\n846: \n847:     # Build reverse alias map\n848:     reverse_aliases = {}\n849:     for alias, canonical in section_aliases.items():\n850:         reverse_aliases.setdefault(canonical, []).append(alias)\n851: \n852:     h2_pattern = re.compile(r'^## \\d+\\.\\s+[^\\n]+', re.MULTILINE)\n853:     headers = h2_pattern.findall(content)\n854: \n855:     # Keep both normalized and raw names for partial matching fallback\n856:     found_sections = set()\n857:     found_sections_raw = []\n858:     for header in headers:\n859:         match = re.search(r'^## \\d+\\.\\s+(?:[^\\w\\s]\\s+)?(.+)$', header)\n860:         if match:\n861:             raw_name = match.group(1).strip().lower()\n862:             section_name = normalize_section_name(raw_name)\n863:             found_sections.add(section_name)\n864:             found_sections_raw.append(raw_name)\n865: \n866:             if section_name in section_aliases:\n867:                 found_sections.add(section_aliases[section_name])\n868: \n869:     # A router command is a thin dispatcher (verify agent -> resolve mode/args -> hand\n870:     # off to owned presentation/workflow assets). It carries a router-specific section\n871:     # vocabulary instead of the general purpose/instructions sections, so detect that\n872:     # shape and require only the minimal router core, treating the rest as recommended.\n873:     # A section counts as present if its canonical name is a found header OR a known\n874:     # space-form alias of it normalizes (space->underscore) to a found header.\n875:     def section_present(canonical: str) -> bool:\n876:         if canonical in found_sections:\n877:             return True\n878:         for alias in reverse_aliases.get(canonical, []):\n879:             if alias.replace(' ', '_') in found_sections:\n880:                 return True\n881:         return False\n882: \n883:     detect_primary = doc_type_rules.get('routerDetectPrimary', [])\n884:     structural = doc_type_rules.get('routerStructuralSections', [])\n885:     is_router = (\n886:         any(section_present(sig) for sig in detect_primary)\n887:         or sum(1 for sig in structural if section_present(sig)) >= 2\n888:     )\n889:     if is_router:\n890:         required = doc_type_rules.get('routerRequiredSections', required)\n891: \n892:     # A surface packet is a read-only evidence base a parent hub bundles beside a\n893:     # workflow mode, not a workflow of its own, so it carries no WHEN TO USE, SMART\n894:     # ROUTING or HOW IT WORKS. Its opening section says when the hub bundles it, which\n895:     # marks the shape, and the packet is held to its evidence core instead.\n896:     if any(section_present(sig) for sig in doc_type_rules.get('surfaceDetectPrimary', [])):\n897:         required = doc_type_rules.get('surfaceRequiredSections', required)\n898: \n899:     for req_section in required:\n900:         found = req_section in found_sections\n901: \n902:         if not found:\n903:             aliases = reverse_aliases.get(req_section, [])\n904:             for alias in aliases:\n905:                 if alias.replace(' ', '_') in found_sections:\n906:                     found = True\n907:                     break\n908: \n909:         # Fuzzy match: accept if all required words appear in section name\n910:         if not found:\n911:             req_words = req_section.replace('_', ' ').split()\n912:             for raw_section in found_sections_raw:\n913:                 if all(word in raw_section for word in req_words):\n914:                     found = True\n915:                     break\n916: \n917:         if not found:\n918:             errors.append({\n919:                 'type': 'missing_required_section',\n920:                 'severity': 'blocking',\n921:                 'message': f'Missing required section: {req_section}',\n922:                 'fix_hint': f'Add section with name containing \"{req_section}\"'\n923:             })\n924: \n925:     # Router shape beyond the minimal core is recommended, not required: surface any\n926:     # missing canonical router section as a non-blocking warning so authors converge on\n927:     # the full vocabulary without failing incremental migrations.\n928:     if is_router:\n929:         for rec_section in doc_type_rules.get('routerRecommendedSections', []):\n930:             if not section_present(rec_section):\n931:                 errors.append({\n932:                     'type': 'missing_recommended_router_section',\n933:                     'severity': 'warning',\n934:                     'message': f'Missing recommended router section: {rec_section}',\n935:                     'fix_hint': f'Add a \"{rec_section}\" section (recommended for router commands)'\n936:                 })\n937: \n938:     return errors\n939: \n940: \n941: # ───────────────────────────────────────────────────────────────\n942: # 6. AUTO-FIX\n943: # ───────────────────────────────────────────────────────────────\n944: \n945: def apply_fixes(content: str, errors: List[Dict[str, Any]]) -> Tuple[str, List[Dict[str, Any]]]:\n946:     \"\"\"\n947:     Apply auto-fixes to content.\n[Output truncated. Continue reading with offset: 948]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/sk-doc/scripts/validate_document.py, lines 603-947\n603: # 4. HEADER VALIDATION\n604: # ───────────────────────────────────────────────────────────────\n605: \n606: def _fenced_line_numbers(content: str) -> set:\n607:     \"\"\"1-based line numbers that fall inside fenced code blocks.\n608: \n609:     Tracks the opening fence's backtick length so a longer outer fence (```` )\n610:     keeps shorter inner fences (```) literal, and a closing fence must be at least\n611:     as long as its opener with no info string. This is why a naive \"any ``` opens,\n612:     a bare ``` closes\" scan mis-nests 4-backtick doc examples. Used so section\n613:     numbering ignores numbered headers shown inside a copy-able template example —\n614:     they are content, not document sections.\n615:     \"\"\"\n616:     fenced = set()\n617:     fence_len = 0\n618:     for i, line in enumerate(content.split('\\n'), start=1):\n619:         stripped = line.strip()\n620:         if stripped.startswith('```'):\n621:             ticks = len(stripped) - len(stripped.lstrip('`'))\n622:             info = stripped[ticks:].strip()\n623:             fenced.add(i)\n624:             if fence_len == 0:\n625:                 fence_len = ticks\n626:             elif ticks >= fence_len and info == '':\n627:                 fence_len = 0\n628:             continue\n629:         if fence_len > 0:\n630:             fenced.add(i)\n631:     return fenced\n632: \n633: \n634: _STRUCTURE_ENFORCEMENT_ENV = 'SKDOC_ENFORCE_STRUCTURE'\n635: \n636: \n637: def is_repo_root_readme(file_path: str) -> bool:\n638:     \"\"\"Whether the file is the README at a repository root, the directory that holds\n639:     `.git` (a folder in a checkout, a file in a linked worktree). That README separates\n640:     its sections with `&nbsp;` lines instead of `---` rules, so the divider rule skips it.\"\"\"\n641:     path = Path(file_path).resolve()\n642:     return path.name.lower() == 'readme.md' and (path.parent / '.git').exists()\n643: \n644: \n645: def _structure_enforcement_enabled() -> bool:\n646:     \"\"\"Whether the general-path structure rules are enforced: a `---` divider between\n647:     numbered ALL-CAPS H2 sections, no Table of Contents, and no navigation-anchor\n648:     comments. Enforced by default. Set SKDOC_ENFORCE_STRUCTURE=0 to opt out, e.g. while\n649:     migrating a doc set whose section structure has not been normalized yet.\"\"\"\n650:     return os.environ.get(_STRUCTURE_ENFORCEMENT_ENV, '1') != '0'\n651: \n652: \n653: def _transparent_structure_line(line: str) -> bool:\n654:     \"\"\"Return whether a line is transparent when checking a section boundary.\"\"\"\n655:     stripped = line.strip()\n656:     return not stripped or bool(re.fullmatch(r'<!--.*-->', stripped))\n657: \n658: \n659: def _section_caps_ignoring_qualifier(title: str) -> bool:\n660:     \"\"\"A numbered H2 counts as a section heading when its text, minus any parenthetical\n661:     qualifier, is uppercase. This keeps headings like \"FILE-LAYER SURFACE (what the AI\n662:     edits)\" in scope while leaving genuinely title-case headings out.\"\"\"\n663:     core = re.sub(r'\\([^)]*\\)', '', title).strip()\n664:     return bool(core) and core == core.upper()\n665: \n666: \n667: def validate_general_structure(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n668:     \"\"\"Validate staged divider and navigation rules for the general path.\"\"\"\n669:     if not _structure_enforcement_enabled():\n670:         return []\n671: \n672:     errors: List[Dict[str, Any]] = []\n673:     lines = content.splitlines()\n674:     fenced_lines = _fenced_line_numbers(content)\n675: \n676:     if doc_type_rules.get('h2DividerRequired', False):\n677:         h2_pattern = re.compile(r'^##\\s+(\\d+)\\.\\s+(.+?)\\s*$')\n678:         numbered_h2_lines = []\n679:         for line_number, line in enumerate(lines, start=1):\n680:             if line_number in fenced_lines:\n681:                 continue\n682:             match = h2_pattern.match(line)\n683:             if match and _section_caps_ignoring_qualifier(match.group(2)):\n684:                 numbered_h2_lines.append(line_number)\n685: \n686:         for line_number in numbered_h2_lines[1:]:\n687:             previous = line_number - 1\n688:             while previous > 0 and _transparent_structure_line(lines[previous - 1]):\n689:                 previous -= 1\n690:             if previous == 0 or lines[previous - 1].strip() != '---':\n691:                 errors.append({\n692:                     'type': 'general_h2_separator',\n693:                     'rule_id': 'general_h2_separator',\n694:                     'severity': 'blocking',\n695:                     'message': 'Numbered ALL-CAPS H2 sections must be separated by `---`.',\n696:                     'line': lines[line_number - 1],\n697:                     'line_number': line_number,\n698:                     'fix_hint': 'Add `---` immediately above the numbered H2 section.',\n699:                 })\n700: \n701:     outside_body = '\\n'.join(\n702:         line for line_number, line in enumerate(lines, start=1)\n703:         if line_number not in fenced_lines\n704:     )\n705:     if doc_type_rules.get('tocForbidden', False) and re.search(\n706:         r'(?im)^\\s*(?:#{1,6}\\s+)?(?:\\d+\\.\\s+)?TABLE OF CONTENTS\\b',\n707:         outside_body,\n708:     ):\n709:         errors.append({\n710:             'type': 'general_no_toc',\n711:             'rule_id': 'general_no_toc',\n712:             'severity': 'blocking',\n713:             'message': 'This document type must not contain a Table of Contents.',\n714:             'fix_hint': 'Remove the Table of Contents and use numbered H2 sections for navigation.',\n715:         })\n716:     if doc_type_rules.get('anchorNavigationForbidden', False) and re.search(\n717:         r'^[ \\t]*<!--[ \\t]*/?ANCHOR:[^>\\r\\n]*-->[ \\t]*$',\n718:         outside_body,\n719:         re.IGNORECASE | re.MULTILINE,\n720:     ):\n721:         errors.append({\n722:             'type': 'general_no_anchor',\n723:             'rule_id': 'general_no_anchor',\n724:             'severity': 'blocking',\n725:             'message': 'This document type must not contain anchor-comment navigation.',\n726:             'fix_hint': 'Remove navigation anchor comments and use numbered H2 sections instead.',\n727:         })\n728: \n729:     return errors\n730: \n731: \n732: def validate_h2_headers(content: str, doc_type_rules: Dict[str, Any], rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n733:     \"\"\"Validate H2 header format and emojis.\"\"\"\n734:     errors = []\n735: \n736:     h2_pattern = re.compile(r'^## (\\d+)\\.\\s+(.+)$', re.MULTILINE)\n737:     matches = list(h2_pattern.finditer(content))\n738:     fenced_lines = _fenced_line_numbers(content)\n739: \n740:     if not matches:\n741:         # No numbered H2 headers found - check if this is expected\n742:         # Some documents might use different header styles\n743:         return errors\n744: \n745:     expected_num = 1\n746:     emoji_required = doc_type_rules.get('h2EmojiRequired', True)\n747:     section_emojis = doc_type_rules.get('sectionEmojis', {})\n748:     section_aliases = doc_type_rules.get('sectionAliases', {})\n749: \n750:     for match in matches:\n751:         num = int(match.group(1))\n752:         title = match.group(2).strip()\n753:         line = match.group(0)\n754: \n755:         # A numbered header inside a fenced example (a copy-able skeleton) is\n756:         # content, not a section, so it must not break or advance the outer\n757:         # document sequence. Emoji/uppercase checks below intentionally still\n758:         # apply to every match, keeping their behavior unchanged.\n759:         header_line = content.count('\\n', 0, match.start()) + 1\n760:         if header_line not in fenced_lines:\n761:             if num != expected_num:\n762:                 errors.append({\n763:                     'type': 'non_sequential_numbering',\n764:                     'severity': 'warning',\n765:                     'message': f'Non-sequential section number: expected {expected_num}, found {num}',\n766:                     'line': line\n767:                 })\n768:             expected_num = num + 1\n769: \n770:         if emoji_required:\n771:             title_has_emoji = has_emoji(title)\n772: \n773:             if not title_has_emoji:\n774:                 section_name = normalize_section_name(title)\n775: \n776:                 if section_name in section_aliases:\n777:                     section_name = section_aliases[section_name]\n778: \n779:                 expected_emoji = section_emojis.get(section_name)\n780: \n781:                 # Fallback: match ignoring underscores for flexibility\n782:                 if not expected_emoji:\n783:                     section_name_no_underscore = section_name.replace('_', '')\n784:                     for key, emoji in section_emojis.items():\n785:                         if key.replace('_', '') == section_name_no_underscore:\n786:                             expected_emoji = emoji\n787:                             break\n788: \n789:                 errors.append({\n790:                     'type': 'missing_h2_emoji',\n791:                     'severity': 'blocking',\n792:                     'message': f'H2 header missing emoji: \"{line}\"',\n793:                     'line': line,\n794:                     'section_name': section_name,\n795:                     'expected_emoji': expected_emoji,\n796:                     'auto_fixable': expected_emoji is not None,\n797:                     'fix': f'## {num}. {expected_emoji} {title}' if expected_emoji else None,\n798:                     'fix_hint': f'Add {expected_emoji} after \"{num}.\"' if expected_emoji else 'Add appropriate emoji after section number'\n799:                 })\n800: \n801:         # Check for ALL CAPS (only for document types that require it)\n802:         uppercase_required = doc_type_rules.get('h2UppercaseRequired', False)\n803:         if uppercase_required and not is_uppercase_section(title):\n804:             section_text = extract_section_name_text(title)\n805:             # Extract emoji if present\n806:             emoji = extract_first_emoji(title)\n807: \n808:             if emoji:\n809:                 # Has emoji: \"EMOJI name\" -> \"EMOJI NAME\"\n810:                 title_after_emoji = EMOJI_PATTERN.sub('', title).strip()\n811:                 fixed_title = f'{emoji} {title_after_emoji.upper()}'\n812:             else:\n813:                 # No emoji: just uppercase\n814:                 fixed_title = title.upper()\n815: \n816:             errors.append({\n817:                 'type': 'h2_not_uppercase',\n818:                 'severity': 'blocking',\n819:                 'message': f'H2 header not ALL CAPS: \"{line}\"',\n820:                 'line': line,\n821:                 'auto_fixable': True,\n822:                 'fix': f'## {num}. {fixed_title}',\n823:                 'fix_hint': f'Change \"{section_text}\" to \"{section_text.upper()}\"'\n824:             })\n825: \n826:     return errors\n827: \n828: \n829: # ───────────────────────────────────────────────────────────────\n830: # 5. SECTION VALIDATION\n831: # ───────────────────────────────────────────────────────────────\n832: \n833: def validate_required_sections(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n834:     \"\"\"Check that required sections are present.\"\"\"\n835:     errors = []\n836: \n837:     required = doc_type_rules.get('requiredSections', [])\n838:     section_aliases = doc_type_rules.get('sectionAliases', {})\n839: \n840:     # Compiled-contract commands are thin runtime dispatchers whose section content is\n841:     # rendered from a compiled source at invocation, not written in the .md file, so\n842:     # there is no prose section shape to require here.\n843:     contract_marker = doc_type_rules.get('compiledContractMarker')\n844:     if contract_marker and contract_marker in content:\n845:         return errors\n846: \n847:     # Build reverse alias map\n848:     reverse_aliases = {}\n849:     for alias, canonical in section_aliases.items():\n850:         reverse_aliases.setdefault(canonical, []).append(alias)\n851: \n852:     h2_pattern = re.compile(r'^## \\d+\\.\\s+[^\\n]+', re.MULTILINE)\n853:     headers = h2_pattern.findall(content)\n854: \n855:     # Keep both normalized and raw names for partial matching fallback\n856:     found_sections = set()\n857:     found_sections_raw = []\n858:     for header in headers:\n859:         match = re.search(r'^## \\d+\\.\\s+(?:[^\\w\\s]\\s+)?(.+)$', header)\n860:         if match:\n861:             raw_name = match.group(1).strip().lower()\n862:             section_name = normalize_section_name(raw_name)\n863:             found_sections.add(section_name)\n864:             found_sections_raw.append(raw_name)\n865: \n866:             if section_name in section_aliases:\n867:                 found_sections.add(section_aliases[section_name])\n868: \n869:     # A router command is a thin dispatcher (verify agent -> resolve mode/args -> hand\n870:     # off to owned presentation/workflow assets). It carries a router-specific section\n871:     # vocabulary instead of the general purpose/instructions sections, so detect that\n872:     # shape and require only the minimal router core, treating the rest as recommended.\n873:     # A section counts as present if its canonical name is a found header OR a known\n874:     # space-form alias of it normalizes (space->underscore) to a found header.\n875:     def section_present(canonical: str) -> bool:\n876:         if canonical in found_sections:\n877:             return True\n878:         for alias in reverse_aliases.get(canonical, []):\n879:             if alias.replace(' ', '_') in found_sections:\n880:                 return True\n881:         return False\n882: \n883:     detect_primary = doc_type_rules.get('routerDetectPrimary', [])\n884:     structural = doc_type_rules.get('routerStructuralSections', [])\n885:     is_router = (\n886:         any(section_present(sig) for sig in detect_primary)\n887:         or sum(1 for sig in structural if section_present(sig)) >= 2\n888:     )\n889:     if is_router:\n890:         required = doc_type_rules.get('routerRequiredSections', required)\n891: \n892:     # A surface packet is a read-only evidence base a parent hub bundles beside a\n893:     # workflow mode, not a workflow of its own, so it carries no WHEN TO USE, SMART\n894:     # ROUTING or HOW IT WORKS. Its opening section says when the hub bundles it, which\n895:     # marks the shape, and the packet is held to its evidence core instead.\n896:     if any(section_present(sig) for sig in doc_type_rules.get('surfaceDetectPrimary', [])):\n897:         required = doc_type_rules.get('surfaceRequiredSections', required)\n898: \n899:     for req_section in required:\n900:         found = req_section in found_sections\n901: \n902:         if not found:\n903:             aliases = reverse_aliases.get(req_section, [])\n904:             for alias in aliases:\n905:                 if alias.replace(' ', '_') in found_sections:\n906:                     found = True\n907:                     break\n908: \n909:         # Fuzzy match: accept if all required words appear in section name\n910:         if not found:\n911:             req_words = req_section.replace('_', ' ').split()\n912:             for raw_section in found_sections_raw:\n913:                 if all(word in raw_section for word in req_words):\n914:                     found = True\n915:                     break\n916: \n917:         if not found:\n918:             errors.append({\n919:                 'type': 'missing_required_section',\n920:                 'severity': 'blocking',\n921:                 'message': f'Missing required section: {req_section}',\n922:                 'fix_hint': f'Add section with name containing \"{req_section}\"'\n923:             })\n924: \n925:     # Router shape beyond the minimal core is recommended, not required: surface any\n926:     # missing canonical router section as a non-blocking warning so authors converge on\n927:     # the full vocabulary without failing incremental migrations.\n928:     if is_router:\n929:         for rec_section in doc_type_rules.get('routerRecommendedSections', []):\n930:             if not section_present(rec_section):\n931:                 errors.append({\n932:                     'type': 'missing_recommended_router_section',\n933:                     'severity': 'warning',\n934:                     'message': f'Missing recommended router section: {rec_section}',\n935:                     'fix_hint': f'Add a \"{rec_section}\" section (recommended for router commands)'\n936:                 })\n937: \n938:     return errors\n939: \n940: \n941: # ───────────────────────────────────────────────────────────────\n942: # 6. AUTO-FIX\n943: # ───────────────────────────────────────────────────────────────\n944: \n945: def apply_fixes(content: str, errors: List[Dict[str, Any]]) -> Tuple[str, List[Dict[str, Any]]]:\n946:     \"\"\"\n947:     Apply auto-fixes to content.\n[Output truncated. Continue reading with offset: 948]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/sk-doc/scripts/validate_document.py\", \"offset\": 603, \"limit\": 345}"},"time":{"start":1793742867913,"end":1793742867999}}}}
