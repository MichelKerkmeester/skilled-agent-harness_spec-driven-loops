{"type":"tool_use","timestamp":1793742865171,"sessionID":"ses_e5ca055c6ffeOZO66b0AKuGGW6","part":{"partID":"prt_1a36802ef001DUhMRenKMHYsHZ","sessionID":"ses_e5ca055c6ffeOZO66b0AKuGGW6","messageID":"msg_1a367f0f7001sDAMCjZwHA057z","type":"tool","id":"call_01_coukoybdpvow8rqnuk6y7dde","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,80p' .skilled/skills/sk-doc/scripts/validate_document.py"},"output":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: README/DOCUMENTATION FORMAT VALIDATOR\n# ───────────────────────────────────────────────────────────────\n\n\"\"\"\nREADME/Documentation Format Validator\n\nValidates markdown documentation against template rules to ensure\nconsistent formatting with proper TOC, H2 emojis, and section structure.\n\nUsage:\n    python validate_document.py <document.md> [--type readme|code_folder|skill|reference|asset|agent|command|install_guide|security_policy|skill_router|spec|changelog]\n    python validate_document.py <document.md> --json\n    python validate_document.py <document.md> --fix [--dry-run]\n    python validate_document.py <document.md> --blocking-only\n\nExit Codes:\n    0 - Valid (no blocking errors)\n    1 - Invalid (blocking errors found)\n    2 - File not found or parse error\n\nCitation drift advisory:\n    The human report ends with any `cite-drift advisory:` lines that\n    cite-drift-scan.mjs --advise prints for the document's file-and-line\n    citations. They never change the exit code, and --json and\n    --blocking-only skip them. JEV_FEATURE_CITE_DRIFT=0 and JEV_FEATURES=0\n    skip the check, as does the older SKDOC_CITE_DRIFT_CHECK=0;\n    SKDOC_CITE_DRIFT_OUT=<dir> records its model calls in <dir>/calls.jsonl.\n\nExamples:\n    python validate_document.py README.md\n    python validate_document.py SKILL.md --type skill\n    python validate_document.py doc.md --json\n    python validate_document.py doc.md --fix --dry-run\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any, Dict, List, Optional, Tuple\n\n\n# Command frontmatter shares its description-budget, quote handling, and MCP-token\n# rules with the sibling skill validator so the two never diverge on the same\n# frontmatter. The sibling lives next to this file; fall back to local copies only if\n# it cannot be imported, so this validator always stays runnable on its own.\ntry:\n    sys.path.insert(0, str(Path(__file__).resolve().parent))\n    from quick_validate import (  # type: ignore\n        check_description_length as _check_description_length,\n        strip_matching_quotes as _strip_matching_quotes,\n        is_non_fq_mcp_token as _is_non_fq_mcp_token,\n        iter_allowed_tools as _iter_allowed_tools,\n        DESCRIPTION_SOFT_TARGET_COMMAND as _DESC_SOFT_COMMAND,\n        DESCRIPTION_HARD_CAP as _DESC_HARD_CAP,\n    )\nexcept Exception:  # pragma: no cover - defensive fallback if the sibling is unavailable\n    _DESC_SOFT_COMMAND, _DESC_HARD_CAP = 110, 1536\n\n    def _strip_matching_quotes(value: str) -> str:\n        value = value.strip()\n        if len(value) >= 2 and value[0] == value[-1] and value[0] in ('\"', \"'\"):\n            return value[1:-1]\n        return value\n\n    def _check_description_length(description, soft_target, hard_cap=_DESC_HARD_CAP):\n        length = len(description)\n        if length > hard_cap:\n            return (\n                f\"Description is {length} chars, exceeds hard cap of {hard_cap} chars.\",\n                None,\n            )\n        if length > soft_target:\n            return (None, f\"Description is {length} chars, exceeds soft target of {soft_target}.\")\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: README/DOCUMENTATION FORMAT VALIDATOR\n# ───────────────────────────────────────────────────────────────\n\n\"\"\"\nREADME/Documentation Format Validator\n\nValidates markdown documentation against template rules to ensure\nconsistent formatting with proper TOC, H2 emojis, and section structure.\n\nUsage:\n    python validate_document.py <document.md> [--type readme|code_folder|skill|reference|asset|agent|command|install_guide|security_policy|skill_router|spec|changelog]\n    python validate_document.py <document.md> --json\n    python validate_document.py <document.md> --fix [--dry-run]\n    python validate_document.py <document.md> --blocking-only\n\nExit Codes:\n    0 - Valid (no blocking errors)\n    1 - Invalid (blocking errors found)\n    2 - File not found or parse error\n\nCitation drift advisory:\n    The human report ends with any `cite-drift advisory:` lines that\n    cite-drift-scan.mjs --advise prints for the document's file-and-line\n    citations. They never change the exit code, and --json and\n    --blocking-only skip them. JEV_FEATURE_CITE_DRIFT=0 and JEV_FEATURES=0\n    skip the check, as does the older SKDOC_CITE_DRIFT_CHECK=0;\n    SKDOC_CITE_DRIFT_OUT=<dir> records its model calls in <dir>/calls.jsonl.\n\nExamples:\n    python validate_document.py README.md\n    python validate_document.py SKILL.md --type skill\n    python validate_document.py doc.md --json\n    python validate_document.py doc.md --fix --dry-run\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any, Dict, List, Optional, Tuple\n\n\n# Command frontmatter shares its description-budget, quote handling, and MCP-token\n# rules with the sibling skill validator so the two never diverge on the same\n# frontmatter. The sibling lives next to this file; fall back to local copies only if\n# it cannot be imported, so this validator always stays runnable on its own.\ntry:\n    sys.path.insert(0, str(Path(__file__).resolve().parent))\n    from quick_validate import (  # type: ignore\n        check_description_length as _check_description_length,\n        strip_matching_quotes as _strip_matching_quotes,\n        is_non_fq_mcp_token as _is_non_fq_mcp_token,\n        iter_allowed_tools as _iter_allowed_tools,\n        DESCRIPTION_SOFT_TARGET_COMMAND as _DESC_SOFT_COMMAND,\n        DESCRIPTION_HARD_CAP as _DESC_HARD_CAP,\n    )\nexcept Exception:  # pragma: no cover - defensive fallback if the sibling is unavailable\n    _DESC_SOFT_COMMAND, _DESC_HARD_CAP = 110, 1536\n\n    def _strip_matching_quotes(value: str) -> str:\n        value = value.strip()\n        if len(value) >= 2 and value[0] == value[-1] and value[0] in ('\"', \"'\"):\n            return value[1:-1]\n        return value\n\n    def _check_description_length(description, soft_target, hard_cap=_DESC_HARD_CAP):\n        length = len(description)\n        if length > hard_cap:\n            return (\n                f\"Description is {length} chars, exceeds hard cap of {hard_cap} chars.\",\n                None,\n            )\n        if length > soft_target:\n            return (None, f\"Description is {length} chars, exceeds soft target of {soft_target}.\")\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '1,80p' .skilled/skills/sk-doc/scripts/validate_document.py\"}"},"time":{"start":1793742865135,"end":1793742865171}}}}
{"type":"tool_use","timestamp":1793742865177,"sessionID":"ses_e5ca055c6ffeOZO66b0AKuGGW6","part":{"partID":"prt_1a3680294001hCGAP6vn5vw3Hc","sessionID":"ses_e5ca055c6ffeOZO66b0AKuGGW6","messageID":"msg_1a367f0f7001sDAMCjZwHA057z","type":"tool","id":"call_00_zfm8odq9f6ryg5sigwmjg1jh","tool":"shell","state":{"status":"completed","input":{"command":"grep -n '^def \\|^class \\|^RULE\\|^CHECKS\\|add_argument\\|VALID\\|INVALID\\|def validate' .skilled/skills/sk-doc/scripts/validate_document.py | head -80"},"output":"3:# COMPONENT: README/DOCUMENTATION FORMAT VALIDATOR\n212:def should_exclude_path(file_path: str) -> Tuple[bool, Optional[str]]:\n260:def load_template_rules(script_dir: Path) -> Dict[str, Any]:\n271:def load_rules() -> Dict[str, Any]:\n276:def _detect_document_type_with_source(file_path: str, content: str, rules: Dict[str, Any]) -> Tuple[str, str]:\n351:def detect_document_type(file_path: str, content: str, rules: Dict[str, Any]) -> str:\n356:def has_emoji(text: str) -> bool:\n361:def extract_first_emoji(text: str) -> Optional[str]:\n367:def normalize_section_name(name: str) -> str:\n375:def extract_section_name_text(text: str) -> str:\n407:def _is_identifier_or_proper_noun(token: str) -> bool:\n417:def _strip_nonprose(text: str) -> str:\n477:def is_uppercase_section(text: str) -> bool:\n512:def make_uppercase_section(text: str) -> str:\n525:# 3. TOC VALIDATION\n528:def validate_toc(content: str, doc_type_rules: Dict[str, Any], rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n603:# 4. HEADER VALIDATION\n606:def _fenced_line_numbers(content: str) -> set:\n637:def is_repo_root_readme(file_path: str) -> bool:\n645:def _structure_enforcement_enabled() -> bool:\n653:def _transparent_structure_line(line: str) -> bool:\n659:def _section_caps_ignoring_qualifier(title: str) -> bool:\n667:def validate_general_structure(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n732:def validate_h2_headers(content: str, doc_type_rules: Dict[str, Any], rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n830:# 5. SECTION VALIDATION\n833:def validate_required_sections(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n945:def apply_fixes(content: str, errors: List[Dict[str, Any]]) -> Tuple[str, List[Dict[str, Any]]]:\n1004:# 7. CODE-FOLDER VALIDATION\n1016:def _code_folder_fence_lines(content: str) -> Tuple[set, List[Dict[str, Any]]]:\n1066:def _code_folder_error(rule_id: str, message: str, line_number: Optional[int] = None) -> Dict[str, Any]:\n1078:def _code_folder_has_tree(content: str, fenced: set) -> bool:\n1087:def _code_folder_has_flat_inventory(content: str, fenced: set, folder: Path) -> bool:\n1104:def _code_folder_heading_errors(content: str, fenced: set) -> List[Dict[str, Any]]:\n1156:def _code_folder_reference_candidates(folder: Path, raw: str) -> List[Path]:\n1172:def _code_folder_reference_errors(content: str, file_path: Path, fenced: set) -> List[Dict[str, Any]]:\n1206:def _code_folder_durability_errors(content: str, fenced: set) -> List[Dict[str, Any]]:\n1228:def validate_code_folder(content: str, file_path: str) -> List[Dict[str, Any]]:\n1268:# 8. MAIN VALIDATION\n1271:def validate_feature_catalog_table(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n1328:def validate_agent_frontmatter(content: str, file_path: str) -> List[Dict[str, Any]]:\n1414:def validate_command_frontmatter(\n1555:def _skip_leading_trivia(content: str) -> int:\n1576:def _changelog_trigger_phrases(frontmatter: str) -> List[str]:\n1597:def validate_changelog_frontmatter(\n1680:def validate_changelog_omissions(content: str, file_path: str) -> List[Dict[str, Any]]:\n1732:def _load_frontmatter_values() -> Any:\n1758:def _frontmatter_scalar(raw: str) -> str:\n1771:def _frontmatter_block(content: str) -> Tuple[Optional[str], int]:\n1787:def _has_unescaped_inner_quote(value: str) -> bool:\n1806:def _fallback_yaml_problem(block: str) -> Optional[Tuple[int, str, str]]:\n1850:def validate_frontmatter_yaml(content: str) -> List[Dict[str, Any]]:\n1892:def validate_frontmatter_values(content: str, values: Any) -> List[Dict[str, Any]]:\n1937:def validate_document(\n2077:def print_cite_drift_advisory(file_path: str) -> None:\n2115:def main() -> None:\n2121:    parser.add_argument('file', help='Markdown file to validate')\n2122:    parser.add_argument('--type', choices=['readme', 'code_folder', 'code-folder', 'skill', 'reference', 'asset', 'agent', 'command', 'install_guide', 'security_policy', 'skill_router', 'spec', 'changelog', 'playbook', 'playbook_feature', 'feature_catalog', 'benchmark_companion'],\n2124:    parser.add_argument('--json', action='store_true', help='Output results as JSON')\n2125:    parser.add_argument('--blocking-only', action='store_true', help='Show only blocking errors')\n2126:    parser.add_argument('--fix', action='store_true', help='Apply auto-fixes')\n2127:    parser.add_argument('--dry-run', action='store_true', help='Show fixes without applying (use with --fix)')\n2128:    parser.add_argument('--no-exclude', action='store_true',\n2199:        status = \"✅ VALID\" if result['valid'] else \"❌ INVALID\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"3:# COMPONENT: README/DOCUMENTATION FORMAT VALIDATOR\n212:def should_exclude_path(file_path: str) -> Tuple[bool, Optional[str]]:\n260:def load_template_rules(script_dir: Path) -> Dict[str, Any]:\n271:def load_rules() -> Dict[str, Any]:\n276:def _detect_document_type_with_source(file_path: str, content: str, rules: Dict[str, Any]) -> Tuple[str, str]:\n351:def detect_document_type(file_path: str, content: str, rules: Dict[str, Any]) -> str:\n356:def has_emoji(text: str) -> bool:\n361:def extract_first_emoji(text: str) -> Optional[str]:\n367:def normalize_section_name(name: str) -> str:\n375:def extract_section_name_text(text: str) -> str:\n407:def _is_identifier_or_proper_noun(token: str) -> bool:\n417:def _strip_nonprose(text: str) -> str:\n477:def is_uppercase_section(text: str) -> bool:\n512:def make_uppercase_section(text: str) -> str:\n525:# 3. TOC VALIDATION\n528:def validate_toc(content: str, doc_type_rules: Dict[str, Any], rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n603:# 4. HEADER VALIDATION\n606:def _fenced_line_numbers(content: str) -> set:\n637:def is_repo_root_readme(file_path: str) -> bool:\n645:def _structure_enforcement_enabled() -> bool:\n653:def _transparent_structure_line(line: str) -> bool:\n659:def _section_caps_ignoring_qualifier(title: str) -> bool:\n667:def validate_general_structure(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n732:def validate_h2_headers(content: str, doc_type_rules: Dict[str, Any], rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n830:# 5. SECTION VALIDATION\n833:def validate_required_sections(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n945:def apply_fixes(content: str, errors: List[Dict[str, Any]]) -> Tuple[str, List[Dict[str, Any]]]:\n1004:# 7. CODE-FOLDER VALIDATION\n1016:def _code_folder_fence_lines(content: str) -> Tuple[set, List[Dict[str, Any]]]:\n1066:def _code_folder_error(rule_id: str, message: str, line_number: Optional[int] = None) -> Dict[str, Any]:\n1078:def _code_folder_has_tree(content: str, fenced: set) -> bool:\n1087:def _code_folder_has_flat_inventory(content: str, fenced: set, folder: Path) -> bool:\n1104:def _code_folder_heading_errors(content: str, fenced: set) -> List[Dict[str, Any]]:\n1156:def _code_folder_reference_candidates(folder: Path, raw: str) -> List[Path]:\n1172:def _code_folder_reference_errors(content: str, file_path: Path, fenced: set) -> List[Dict[str, Any]]:\n1206:def _code_folder_durability_errors(content: str, fenced: set) -> List[Dict[str, Any]]:\n1228:def validate_code_folder(content: str, file_path: str) -> List[Dict[str, Any]]:\n1268:# 8. MAIN VALIDATION\n1271:def validate_feature_catalog_table(content: str, doc_type_rules: Dict[str, Any]) -> List[Dict[str, Any]]:\n1328:def validate_agent_frontmatter(content: str, file_path: str) -> List[Dict[str, Any]]:\n1414:def validate_command_frontmatter(\n1555:def _skip_leading_trivia(content: str) -> int:\n1576:def _changelog_trigger_phrases(frontmatter: str) -> List[str]:\n1597:def validate_changelog_frontmatter(\n1680:def validate_changelog_omissions(content: str, file_path: str) -> List[Dict[str, Any]]:\n1732:def _load_frontmatter_values() -> Any:\n1758:def _frontmatter_scalar(raw: str) -> str:\n1771:def _frontmatter_block(content: str) -> Tuple[Optional[str], int]:\n1787:def _has_unescaped_inner_quote(value: str) -> bool:\n1806:def _fallback_yaml_problem(block: str) -> Optional[Tuple[int, str, str]]:\n1850:def validate_frontmatter_yaml(content: str) -> List[Dict[str, Any]]:\n1892:def validate_frontmatter_values(content: str, values: Any) -> List[Dict[str, Any]]:\n1937:def validate_document(\n2077:def print_cite_drift_advisory(file_path: str) -> None:\n2115:def main() -> None:\n2121:    parser.add_argument('file', help='Markdown file to validate')\n2122:    parser.add_argument('--type', choices=['readme', 'code_folder', 'code-folder', 'skill', 'reference', 'asset', 'agent', 'command', 'install_guide', 'security_policy', 'skill_router', 'spec', 'changelog', 'playbook', 'playbook_feature', 'feature_catalog', 'benchmark_companion'],\n2124:    parser.add_argument('--json', action='store_true', help='Output results as JSON')\n2125:    parser.add_argument('--blocking-only', action='store_true', help='Show only blocking errors')\n2126:    parser.add_argument('--fix', action='store_true', help='Apply auto-fixes')\n2127:    parser.add_argument('--dry-run', action='store_true', help='Show fixes without applying (use with --fix)')\n2128:    parser.add_argument('--no-exclude', action='store_true',\n2199:        status = \"✅ VALID\" if result['valid'] else \"❌ INVALID\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \