sion\":1,\"streamId\":\"deep-research-ledger\",\"streamSequence\":6,\"committedAt\":\"2026-11-03T21:53:32.716Z\"},\"projectionRefreshed\":true,\"projectionError\":null,\"warnings\":[\"Trusted evidence yield was absent and remains explicitly zero.\"]}\n  \"resourceMapPath\": null,\n  \"resourceMapSkipped\": null,\n  \"resourceMapSkipReason\": null,\n  \"deltaSourceCount\": null\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory specs/sk-code/018-frontend-upstream-proposals/010-reference-readability-research/research/lineages/deepseek --event-json specs/sk-code/018-frontend-upstream-proposals/010-reference-readability-research/research/lineages/deepseek/.executor-state/iter-005-event.json | head -2; node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs specs/sk-code/018-frontend-upstream-proposals/010-reference-readability-research --artifact-dir specs/sk-code/018-frontend-upstream-proposals/010-reference-readability-research/research/lineages/deepseek 2>&1 | tail -5\"}"},"time":{"start":1793742812136,"end":1793742813090}}}}
