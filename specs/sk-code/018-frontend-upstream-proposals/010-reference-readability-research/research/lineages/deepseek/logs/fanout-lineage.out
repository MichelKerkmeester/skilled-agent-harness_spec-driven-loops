\\\"Add render_related_last for references and assets, but first reconcile the asset template must-be-last clause with the reference template silence and the rule data recommended-only status.\\\",\\\"iteration\\\":8,\\\"sources\\\":[\\\".skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-asset-template.md:166\\\",\\\".skilled/skills/sk-doc/shared/assets/template-rules.json:323\\\",\\\".skilled/skills/sk-code/ROUTER.md:218\\\"]}\\n{\\\"type\\\":\\\"finding\\\",\\\"id\\\":\\\"f-iter008-005\\\",\\\"label\\\":\\\"Add a warning-level render_bare_url check for unfenced http(s) URLs not inside a markdown link or autolink; zero current hits and nine in the pre-fix control.\\\",\\\"iteration\\\":8,\\\"sources\\\":[\\\".skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-reference-template.md:58\\\",\\\".skilled/skills/sk-code/sk-code-frontend/references/web-cascade-and-selectors.md:28 (at cd00629166)\\\"]}\\n{\\\"type\\\":\\\"finding\\\",\\\"id\\\":\\\"f-iter008-006\\\",\\\"label\\\":\\\"Add a warning-level duplicate-block check for identical paragraphs or repeated bold labels; semantic boilerplate across files needs a batch heuristic plus editorial review, not a blocking gate.\\\",\\\"iteration\\\":8,\\\"sources\\\":[\\\".skilled/skills/sk-code/sk-code-frontend/references/web-performance-and-loading.md:130\\\",\\\".skilled/skills/sk-code/sk-code-skilled/references/shell/style-guide/overview-structure-and-naming.md:170\\\",\\\".skilled/skills/sk-code/sk-code-skilled/references/rust/style-guide/naming-conventions.md:22\\\"]}\\n{\\\"type\\\":\\\"finding\\\",\\\"id\\\":\\\"f-iter008-007\\\",\\\"label\\\":\\\"Extend the H2 regex to accept and reject letter suffixes, make non-sequential numbers blocking, and add a warning rule-id monotonic check; this catches 2b, pr-state numbering, P10 before P8 and the I8 gap.\\\",\\\"iteration\\\":8,\\\"sources\\\":[\\\".skilled/skills/sk-doc/scripts/validate_document.py:736\\\",\\\".skilled/skills/sk-code/sk-code-frontend/referenc