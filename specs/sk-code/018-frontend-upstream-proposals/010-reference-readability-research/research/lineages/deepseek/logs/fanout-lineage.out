md:218\",\".skilled/skills/sk-code/ROUTER.md:227\",\".skilled/skills/sk-code/ROUTER.md:450\"]}\n{\"type\":\"finding\",\"id\":\"f-iter001-003\",\"label\":\"runner-contract.md opens with OVERVIEW AND CLI and immediately shows a code fence, so the overview section has no overview, no Purpose and no When to Use.\",\"iteration\":1,\"sources\":[\".skilled/skills/sk-code/sk-code-quality/references/runner-contract.md:20\",\".skilled/skills/sk-code/sk-code-quality/references/runner-contract.md:22\"]}\n{\"type\":\"finding\",\"id\":\"f-iter001-004\",\"label\":\"stack-detection.md omits the template-required Purpose and When to Use subsections, opening its OVERVIEW with Core Principle and a Surfaces table.\",\"iteration\":1,\"sources\":[\".skilled/skills/sk-code/shared/references/stack-detection.md:20\",\".skilled/skills/sk-code/shared/references/stack-detection.md:22\",\".skilled/skills/sk-code/shared/references/stack-detection.md:26\",\".skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-reference-template.md:100\"]}\n{\"type\":\"finding\",\"id\":\"f-iter001-005\",\"label\":\"OVERVIEW subheading order diverges across four sibling references: phase-detection Purpose/When/Core, workflow-implement Purpose/Core/When, workflow-verify Purpose/Iron Law/When, code-quality-standards Purpose/Core/When.\",\"iteration\":1,\"sources\":[\".skilled/skills/sk-code/shared/references/phase-detection.md:22\",\".skilled/skills/sk-code/shared/references/workflow-implement.md:22\",\".skilled/skills/sk-code/shared/references/workflow-verify.md:22\",\".skilled/skills/sk-code/shared/references/universal/code-quality-standards.md:23\"]}\n","path":"specs/sk-code/018-frontend-upstream-proposals/010-reference-readability-research/research/lineages/deepseek/deltas/iter-001.jsonl"},"output":"Created file successfully: specs/sk-code/018-frontend-upstream-proposals/010-reference-readability-research/research/lineages/deepseek/deltas/iter-001.jsonl","title":"write","metadata":{"metadata":{"truncated":fa