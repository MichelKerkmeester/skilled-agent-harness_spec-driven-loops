\"},{\"type\":\"node\",\"id\":\"f-quality-walls\",\"kind\":\"FINDING\",\"label\":\"Paragraph walls in runner contract\"},{\"type\":\"edge\",\"id\":\"e-iter004-001\",\"source\":\"f-quality-no-related\",\"target\":\"q-quality-family\",\"relation\":\"ANSWERS\"},{\"type\":\"edge\",\"id\":\"e-iter004-002\",\"source\":\"f-quality-walls\",\"target\":\"q-quality-family\",\"relation\":\"ANSWERS\"}]}\n{\"type\":\"finding\",\"id\":\"f-iter004-001\",\"label\":\"runner-contract.md and quality-config.md end without a Related Resources section, while only code-style-guide.md closes with one, so two of three quality references leave the reader with no next step.\",\"iteration\":4,\"sources\":[\".skilled/skills/sk-code/sk-code-quality/references/runner-contract.md:269\",\".skilled/skills/sk-code/sk-code-quality/references/quality-config.md:196\",\".skilled/skills/sk-code/sk-code-quality/references/code-style-guide.md:189\"]}\n{\"type\":\"finding\",\"id\":\"f-iter004-002\",\"label\":\"runner-contract.md has single prose lines of 1,296 (53), 780 (55), 971 (103), 1,657 (113) and 815 (118) characters, rendering as unbroken paragraph walls that hide the option-to-effect mapping.\",\"iteration\":4,\"sources\":[\".skilled/skills/sk-code/sk-code-quality/references/runner-contract.md:53\",\".skilled/skills/sk-code/sk-code-quality/references/runner-contract.md:113\",\".skilled/skills/sk-code/sk-code-quality/references/runner-contract.md:118\"]}\n{\"type\":\"finding\",\"id\":\"f-iter004-003\",\"label\":\"quality-config.md's entire OVERVIEW is one 121-word paragraph with no Purpose and no When to Use, so scope and applicability are buried in the first block.\",\"iteration\":4,\"sources\":[\".skilled/skills/sk-code/sk-code-quality/references/quality-config.md:16\",\".skilled/skills/sk-code/sk-code-quality/references/quality-config.md:18\"]}\n{\"type\":\"finding\",\"id\":\"f-iter004-004\",\"label\":\"code-style-guide.md packs rule id, rationale and a before/after pair into one 408-character parag