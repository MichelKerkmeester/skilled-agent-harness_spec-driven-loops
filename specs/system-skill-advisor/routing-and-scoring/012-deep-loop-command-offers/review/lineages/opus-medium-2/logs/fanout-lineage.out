system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\n+++ b/.skilled/skills/system-skill-advisor/hooks/lib/skill-advisor-cli-fallback.ts\n@@ -390,6 +390,9 @@ function recommendationFromCli(value: unknown, thresholds: { readonly confidence\n     // A hub that held back its command for want of a mode keeps that signal, so\n     // the head can say why no command came with it.\n     ...(value.needsMode === true ? { needsMode: true } : {}),\n+    // A command the reader typed already carries their choice of mode, so the\n+    // head must know it was typed to leave the offer options off.\n+    ...(value.typed === true ? { typed: true as const } : {}),\n     // A floored route is held back against the session's earlier route, so the\n     // floor has to survive the trip from the CLI.\n     ...(value.confidenceFloored === true ? { confidenceFloored: true as const } : {}),","is_error":false}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:51:32.120Z","tool_use_result":{"stdout":"commit c8eee36a1f56ca99e29daa4de730c40d040a4626\nAuthor: Michel Kerkmeester <<email>>\nDate:   Mon Nov 23 20:24:30 2026 +0100\n\n    fix(system-skill-advisor): withhold deep-loop offers on refusals and subjects\n    \n    The deep-loop gate offered /deep:research or /deep:review when a prompt\n    turned the loop down in words, asked how many passes the loop runs, named\n    the loop's own code or results, or used a count to describe a subject. It\n    also missed the hyphen spelling and a curly apostrophe, and read \"not\n    stuck\" as a stuck run. The gate now reads each loop phrase on its own and\n    skips one that a refusal leads or follows, or that names the request's\n    subject. The Python fallback carries the same rules and now reads a typed\n    command with the TypeScript boundary and mention checks.\n    \n    A typed deep-loop command now carries a typed flag through the recommend\n    output, so the brief prints plain (as