{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017kmo8GwBPVsCwGTspnULex","type":"tool_result","content":"1\t// ───────────────────────────────────────────────────────────────\n2\t// MODULE: Slash command attached to a hub's recommendation\n3\t// ───────────────────────────────────────────────────────────────\n4\t//\n5\t// The advisor can name the workflow mode a hub would route a prompt to, but the\n6\t// reader still has to translate that mode into the slash command that acts on\n7\t// it. This module owns that translation and nothing else, kept free of imports\n8\t// so the recommend path and a test read the same semantics.\n9\t//\n10\t// The mode-to-command table is generated rather than hand-maintained: each row is\n11\t// derived from a hub's own command files, so a hub that adds or renames a mode\n12\t// regenerates its row instead of drifting from a copy someone forgot to update.\n13\t\n14\t// BEGIN GENERATED MODE COMMANDS\n15\texport const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16\t  'sk-design': {\n17\t    'sk-design-chart': '/design:chart',\n18\t    'sk-design-diagram': '/design:diagram',\n19\t    'sk-design-md-generator': '/design:extract',\n20\t  },\n21\t  'sk-doc': {\n22\t    'sk-create-agent': '/create:agent',\n23\t    'sk-create-benchmark': '/create:benchmark',\n24\t    'sk-create-changelog': '/create:changelog',\n25\t    'sk-create-command': '/create:command',\n26\t    'sk-create-diff': '/create:diff',\n27\t    'sk-create-feature-catalog': '/create:feature-catalog',\n28\t    'sk-create-goal': '/create:goal',\n29\t    'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30\t    'sk-create-readme': '/create:readme',\n31\t    'sk-create-repo-rule': '/create:repo-rule',\n32\t    'sk-create-skill': '/create:sk-skill',\n33\t    'sk-create-skill-parent': '/create:skill-parent',\n34\t    'sk-create-with-human-voice': '/create:with-human-voice',\n35\t  },\n36\t  'system-deep-loop': {\n37\t    'research': '/deep:research',\n38\t    'review': '/deep:review',\n39\t  },\n40\t};\n41\t// END GENERATED MODE COMMANDS\n42\t\n43\t// One row of the command table: the runnable slash command, the policy that says\n44\t// whether it runs, asks or starts a session, the class that says what the run\n45\t// writes, and the skill that owns it. The rows are generated, so only the shape\n46\t// lives here.\n47\texport interface CommandRow {\n48\t  readonly command: string;\n49\t  readonly policy?: 'run' | 'start' | 'ask';\n50\t  readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n51\t  readonly ownerSkillId: string;\n52\t}\n53\t\n54\t// The table below covers every tracked command, whether or not its bridge is\n55\t// active, so a typed command always has a policy and an owner. `scorerRow` says\n56\t// whether a scorer can also return the command on its own.\n57\texport interface TrackedCommand {\n58\t  readonly policy: 'run' | 'start' | 'ask';\n59\t  readonly ownerSkillId: string;\n60\t  readonly scorerRow: boolean;\n61\t}\n62\t\n63\t// BEGIN GENERATED COMMAND ROWS\n64\texport const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n65\t  'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n66\t  'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67\t  'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68\t  'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69\t  'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70\t  'command-create-sk-skill': { command: '/create:sk-skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71\t  'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n72\t  'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73\t  'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n74\t  'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n75\t  'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76\t  'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n77\t  'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n78\t  'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79\t  'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n80\t  'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n81\t  'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n82\t  'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n83\t  'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n84\t  'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n85\t  'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86\t  'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n87\t  'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88\t  'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89\t  'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90\t  'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n91\t  'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92\t  'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93\t  'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n94\t  'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n95\t  'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n96\t  'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n97\t  'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n98\t  'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99\t  'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100\t  'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n101\t  'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102\t  'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n103\t  'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n104\t  'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n105\t  'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n106\t  'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n107\t  'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108\t  'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n109\t  'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n110\t  'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n111\t  'command-speckit-ai-council': { command: '/speckit:ai-council', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n112\t  'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n113\t  'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114\t  'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115\t  'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116\t  'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117\t  'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118\t  'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n119\t  'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n120\t  'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121\t};\n122\texport const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n123\t  '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n124\t  '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n125\t  '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n126\t  '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n127\t  '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n128\t  '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n129\t  '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n130\t  '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n131\t  '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n132\t  '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n133\t  '/create:sk-skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n134\t  '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n135\t  '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n136\t  '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n137\t  '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n138\t  '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n139\t  '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n140\t  '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n141\t  '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n142\t  '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n143\t  '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n144\t  '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n145\t  '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n146\t  '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n147\t  '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n148\t  '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n149\t  '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n150\t  '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n151\t  '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n152\t  '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n153\t  '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n154\t  '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n155\t  '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n156\t  '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n157\t  '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n158\t  '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n159\t  '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n160\t  '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n161\t  '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n162\t  '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n163\t  '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n164\t  '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n165\t  '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n166\t  '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n167\t  '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168\t  '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169\t  '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170\t  '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171\t  '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n172\t  '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n173\t  '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n174\t  '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175\t  '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176\t  '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n177\t  '/speckit:ai-council': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n178\t  '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n179\t  '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n180\t  '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181\t  '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182\t  '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183\t  '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184\t  '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185\t};\n186\t// END GENERATED COMMAND ROWS\n187\t\n188\t// The row for an id a recommendation carries, or undefined when that id names no\n189\t// command. Own-key lookup because the table is generated data, so an inherited\n190\t// name such as `constructor` must not resolve to a row nobody declared.\n191\texport function commandRowFor(id: string): CommandRow | undefined {\n192\t  return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n193\t}\n194\t\n195\t// The deep-loop hub owns one diagnosis command besides its two run commands.\n196\tconst DEEP_LOOP_DOCTOR_COMMAND = '/doctor:deep-loop';\n197\t\n198\t// A typed command is the reader's own wording, so it counts only where a command\n199\t// can start and where it ends on a boundary. That keeps a path such as\n200\t// `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n201\t// command, and the longest key wins so `/group:name-parent` is never reduced to\n202\t// its `/group:name` prefix. A dot or a slash followed by a word character\n203\t// continues a file name or a path, while a sentence-ending period does not.\n204\t// A mode suffix and a `:with-*` modifier end the command name the way a space\n205\t// does, after any tracked command. The argument hints say which commands take\n206\t// which, but a modifier typed on a command that does not take it still names\n207\t// that command. The hints chain them, as in `:auto:with-research`, so a run of\n208\t// them counts as one suffix.\n209\tconst COMMAND_START_BOUNDARY = /[\\s`'\"(*[~>\\u201c\\u2018\\u00ab\\u2032\\u2039]/;\n210\tconst COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n211\tconst WORD_CHARACTER = /[a-z0-9_]/;\n212\tconst MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n213\t\n214\t// A command that was renamed is still typed from habit. Its old name reads as\n215\t// the command that replaced it, so the reader lands on the live workflow and\n216\t// not on whatever skill the leftover words happen to score for. The old name\n217\t// gets no command file of its own: this table is the only place it lives.\n218\tconst RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n219\t  '/create:skill': '/create:sk-skill',\n220\t};\n221\t\n222\texport function typedCommandIn(prompt: string): string | undefined {\n223\t  const lowered = prompt.toLowerCase();\n224\t  let found: string | undefined;\n225\t  for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n226\t    let index = lowered.indexOf(key);\n227\t    while (index !== -1) {\n228\t      const before = index === 0 ? '' : lowered[index - 1];\n229\t      const after = lowered[index + key.length] ?? '';\n230\t      const next = lowered[index + key.length + 1] ?? '';\n231\t      const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n232\t      const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n233\t      const continuesName =\n234\t        !hasModeSuffix\n235\t        && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n236\t      const endsAtBoundary = after === '' || !continuesName;\n237\t      if (startsAtBoundary && endsAtBoundary) {\n238\t        if (found === undefined || key.length > found.length) found = key;\n239\t        break;\n240\t      }\n241\t      index = lowered.indexOf(key, index + 1);\n242\t    }\n243\t  }\n244\t  if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n245\t  return found;\n246\t}\n247\t\n248\t// A typed command travels on the recommendation that leads, so it is delivered\n249\t// only when the leading skill owns the command or carries the same command row.\n250\t// A leading skill unrelated to the command must not carry it.\n251\texport interface TypedCommand {\n252\t  readonly command: string;\n253\t  readonly policy: 'run' | 'start' | 'ask';\n254\t  readonly ownerSkillId: string;\n255\t}\n256\t\n257\texport function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n258\t  const command = typedCommandIn(prompt);\n259\t  if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n260\t  if (commandOnlyMentioned(prompt, command)) return undefined;\n261\t  const row = TRACKED_COMMANDS[command];\n262\t  const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n263\t  if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n264\t  return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n265\t}\n266\t\n267\t// Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n268\t// that merely mentions the topic spends the reader's budget on work they never\n269\t// asked for. The list below is the vocabulary that counts as asking for it, and\n270\t// it names the loop itself: a deep loop by name, iterations, or more than one\n271\t// pass. Depth wording such as `thorough` or `in depth` asks for care inside a\n272\t// single pass, and a bare topic word such as `research` or `review` says what\n273\t// to look at, so neither qualifies on its own.\n274\t//\n275\t// The phrases live in a data list, one per line, so the vocabulary a reviewer\n276\t// has to judge stays visible and cheap to correct.\n277\texport const LOOP_WORDING: readonly string[] = [\n278\t  'deep research',\n279\t  'deep-research',\n280\t  'deep review',\n281\t  'deep-review',\n282\t  'multi-pass',\n283\t];\n284\t\n285\t// `iterative` and an uncounted `iterations` are also how a prompt describes its\n286\t// subject, as in \"the iterative solver\" or \"the last iterations of the plan\", so\n287\t// they ask for the loop only where they say how a review or research runs: on\n288\t// the activity itself (\"iterative review\", \"a looped investigation\"), as the\n289\t// manner of a review or research verb (\"audit it iteratively\"), or as the work's\n290\t// unit (\"in several iterations\", \"more iterations\"). Counted iterations are\n291\t// LOOP_COUNT's.\n292\tconst ITERATIVE_ACTIVITY = '(?:deep[- ])?(?:review|research|audit|investigation|analysis|inspection|check|pass(?:es)?|rounds?|loop)';\n293\tconst ITERATIVE_VERB = '(?:review|research|audit|investigate|inspect|check|scan|examine|analy[sz]e|look into|go over)';\n294\texport const ITERATIVE_ASK = new RegExp(\n295\t  `\\\\b(?:iterative|looped) ${ITERATIVE_ACTIVITY}\\\\b`\n296\t  + `|\\\\biteratively ${ITERATIVE_VERB}\\\\b`\n297\t  + `|\\\\b${ITERATIVE_VERB}\\\\b(?: [\\\\w./'-]+){0,6}? iteratively\\\\b`\n298\t  + '|\\\\b(?:in|over|through) (?:(?:several|multiple|many|a few|successive|repeated) )?iterations\\\\b'\n299\t  // \"the model needed more iterations to converge\" reports what a process took,\n300\t  // so a verb of taking or using before the amount leaves it a description.\n301\t  + '|\\\\b(?<!\\\\b(?:needed|took|takes|required|requires|used|ran|had|after) )(?:several|multiple|(?<!\\\\bhow )many|a few|successive|repeated|more) iterations\\\\b',\n302\t);\n303\t\n304\t// Passes and rounds are also things a prompt can be about, as in \"three funding\n305\t// rounds\" or \"several rounds of layoffs\", so they ask for the loop only when\n306\t// nothing but a loop word stands between the count and the noun, and an \"of\"\n307\t// after them names the review, the research or the target rather than another\n308\t// subject. Rounds of a named thing are that thing's rounds, as in \"3 rounds of\n309\t// the clinical trial\", so after \"of\" a round takes only a pronoun, the loop\n310\t// noun itself or one named review, as in \"rounds of the security audit\". The\n311\t// named review needs its determiner and has to end there, because \"rounds of\n312\t// peer review\" and \"rounds of the peer review process\" name the subject. A pass\n313\t// may still take its target, as in \"passes of the code\".\n314\tconst PASS_GAP = '(?:(?:more|extra|additional|full|deep|review|research|audit|iterative) ){0,2}';\n315\tconst PASS_NOUN = '(?:passes\\\\b(?! of (?!(?:review|research|audit|investigation|the|it|this|that|these|those|my|our)\\\\b)[a-z])'\n316\t  + '|rounds\\\\b(?! of (?!(?:(?:the|this|that|my|our) )?(?:review|research|audit|investigation|analysis|deep)\\\\b'\n317\t  + '|(?:the|this|that|my|our) [a-z-]+ (?:review|research|audit|investigation|analysis)\\\\b(?! (?!(?:on|of|for|in|with|to|and|then|until|so|at|across|against|over|before|after)\\\\b)[a-z])'\n318\t  + '|(?:it|this|that)\\\\b(?! [a-z]))[a-z]))';\n319\t\n320\t// More than one pass or round asks for the loop the way iterations do. \"How\n321\t// many passes does it run\" asks about the loop, so `many` counts only where no\n322\t// `how` stands before it.\n323\texport const MULTI_PASS = new RegExp(`\\\\b(?:multiple|several|(?<!\\\\bhow )many) ${PASS_GAP}${PASS_NOUN}`);\n324\t\n325\t// An iteration count asks for the loop whether it is typed as a digit or spelled\n326\t// out, and a hyphen may join the two, as in \"twelve-iteration\". A count counts\n327\t// from two up, because \"in one iteration\" asks for a single pass, and one counts\n328\t// only as one more, as in \"do one more iteration\". A pass or a round counts the\n329\t// same way, and the singular counts only when hyphen-joined, as in \"two-pass\",\n330\t// because \"3 tests pass\" uses it as a verb. A count after a word that points\n331\t// back, as in \"the first 2 iterations\", or after \"after\", as in \"failed after 3\n332\t// iterations\", names runs that already happened rather than asking for more,\n333\t// while \"stop after 10 iterations\" sets the length of the run it asks for.\n334\tconst COUNT_BACK_POINTER = '(?<!\\\\b(?:first|last|previous|past|prior|earlier|those|these|the|both|(?<!\\\\bstop )after) )';\n335\tconst COUNT_WORDS = '(?:two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|(?:a )?dozen)';\n336\tconst LOOP_COUNT_LEAD = `${COUNT_BACK_POINTER}(?:[2-9]|\\\\d{2,}|${COUNT_WORDS}|(?:1|one)(?= (?:more|extra|additional|further)\\\\b))`;\n337\texport const LOOP_COUNT = new RegExp(\n338\t  `\\\\b${LOOP_COUNT_LEAD}[- ](?:[a-z-]+ ){0,2}?iterations?\\\\b`\n339\t  + `|\\\\b${LOOP_COUNT_LEAD}(?:-(?:rounds?|pass(?:es)?)\\\\b| ${PASS_GAP}${PASS_NOUN})`,\n340\t);\n341\t\n342\t// A loop's own name is how a reader asks about the loop as often as how they ask\n343\t// to run one, so \"how does the research loop decide when it has enough\" stays a\n344\t// question. The name counts as asking for the run only behind a use verb, as in\n345\t// \"start a research loop\".\n346\texport const LOOP_NAMES: readonly string[] = [\n347\t  'deep loop',\n348\t  'research loop',\n349\t  'review loop',\n350\t];\n351\t\n352\t// A creation workflow scaffolds, reviews and validates a whole document, which is\n353\t// the wrong size for a correction inside one. The list below is the vocabulary\n354\t// that marks that correction, and a line number points at one the same way.\n355\texport const SMALL_EDIT_WORDING: readonly string[] = [\n356\t  'typo',\n357\t  'typos',\n358\t  'spelling',\n359\t  'misspelled',\n360\t  'misspelling',\n361\t  'grammar',\n362\t  'punctuation',\n363\t  'wording',\n364\t  'broken link',\n365\t  'broken links',\n366\t  'dead link',\n367\t  'dead links',\n368\t  'one line',\n369\t  'single line',\n370\t];\n371\t\n372\t// A phrase may carry punctuation a regex would read as a metacharacter, so it is\n373\t// escaped before it is trusted as a pattern.\n374\tfunction escapePhrase(phrase: string): string {\n375\t  return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n376\t}\n377\t\n378\t// One word that names a deep-loop mode. A route that defers on a loop request\n379\t// still names its mode when the prompt carries exactly one of these cues.\n380\t// A check or an inspection aimed at defects is a review in plain words, so it\n381\t// counts beside review and audit. The defect noun is required, because \"check\n382\t// that the build passes\" asks for no review at all. The scorer reads the defect\n383\t// check on its own as well, because its verbs also read as a request to explain.\n384\texport const DEFECT_CHECK = /\\b(?:check|inspect|scan|examine|go over|look over)\\b(?:\\s+[\\w./-]+){0,5}?\\s+for\\s+(?:[\\w-]+\\s+){0,2}?(?:bugs?|defects?|mistakes?|errors?|vulnerabilit(?:y|ies)|issues?|problems?|regressions?|flaws?)\\b/;\n385\t// The -ing form carries the cue too, as in \"a deep loop reviewing the session store\".\n386\texport const MODE_CUES: Readonly<Record<string, RegExp>> = {\n387\t  research: /\\b(?:research(?:ing)?|investigat(?:e|es|ing|ion)|look into|find out)\\b/,\n388\t  review: new RegExp(`\\\\b(?:review(?:ing)?|audit(?:ing)?)\\\\b|${DEFECT_CHECK.source}`),\n389\t};\n390\t\n391\t// A run that is stuck, never converges or whose graph looks stale is a fault in\n392\t// an existing run, so it asks for a diagnosis rather than for a new run. The\n393\t// subject has to name a deep run or its state, because \"my build is stuck\" is\n394\t// not about the loop, and a use verb right before the subject turns it back\n395\t// into a request, as in \"run deep research on why sockets hang\". An audit loop\n396\t// is the review loop by another name, and \"the review I started\" names a run the\n397\t// reader launched, while \"the test runner I started\" names no deep run at all.\n398\t// Convergence and a coverage graph belong to training runs and test reports as\n399\t// much as to the loop, so they name a deep run only beside a review or research\n400\t// noun, as in \"the research convergence\" or \"the coverage graph for my review\".\n401\tconst LOOP_RUN_SUBJECT = /\\b(?:deep[- ](?:research|review|loop)|(?:research|review|audit) (?:loop|run)|(?:research|review|audit)(?: (?:loop|run))? (?:i|we) (?:just )?(?:started|launched|kicked off|ran|began|set off|set up)|(?:the|my|our|this|that) (?:research|review|audit)(?:'s)? (?:coverage graph|convergence)|(?:coverage graph|convergence) (?:of|for|in|on) (?:(?:the|my|our|this|that) )?(?:research|review|audit))\\b/;\n402\t// \"keep going\" asks for more of a run, so it is not among the symptoms, and\n403\t// \"spinning up\" starts a run rather than describing one that is stuck. A state\n404\t// word that a negation leads, as in \"the run is not stuck\", denies the symptom,\n405\t// while the negated verbs further on, as in \"not converging\", are symptoms.\n406\tconst LOOP_RUN_SYMPTOM = /\\b(?:(?<!\\b(?:not|isn't|wasn't|aren't|weren't|longer|never) )(?:stuck|hangs?|hanging|hung|frozen|stalled|stalls|spins|spinning(?! up)|stale|empty)|never (?:converges?|finishes|stops|ends|fires)|(?:not|isn't|is not|won't|will not|doesn't|does not|didn't|did not|can't|cannot|without) (?:converg\\w*|finish\\w*|progress\\w*|mov\\w*|fir\\w*)|stopped (?:converg\\w*|progress\\w*|moving)|keeps? (?:running|repeating|looping)|(?:hasn't|has not|haven't|have not) (?:moved|changed|converged|progressed)|no progress)\\b/;\n407\tconst LOOP_RUN_REQUESTED = /\\b(?:run|start|use|launch|kick off|do|rerun|re-run) (?:[a-z0-9'-]+ ){0,2}(?:deep[- ](?:research|review|loop)|(?:research|review|audit) (?:loop|run))\\b/;\n408\t\n409\t// The deep loop's doctor reads a deep run's own state, so a prompt that names no\n410\t// deep run, as in \"the model needed more iterations to converge\", has nothing for\n411\t// it to read, however many of its keywords the prompt shares.\n412\texport function namesDeepRun(text: string): boolean {\n413\t  return LOOP_RUN_SUBJECT.test(text.toLowerCase().replace(/[‘’]/g, \"'\"));\n414\t}\n415\t\n416\t// A counted run ask, as in \"run 5 more iterations\", asks for more of the run\n417\t// whatever state the reader reports it in, so it cancels the stuck reading\n418\t// unless a refusal leads it.\n419\texport function isStuckRunComplaint(text: string): boolean {\n420\t  const lower = text.toLowerCase().replace(/[‘’]/g, \"'\");\n421\t  return LOOP_RUN_SUBJECT.test(lower) && LOOP_RUN_SYMPTOM.test(lower) && !LOOP_RUN_REQUESTED.test(lower)\n422\t    && ![...lower.matchAll(COUNTED_RUN_ASK)].some((match) => !RUN_ASK_NEGATED.test(lower.slice(0, match.index)));\n423\t}\n424\t\n425\t// A run asked for in so many words: a use verb on a deep loop's name, or on a\n426\t// count of iterations, rounds or passes, as in \"run 10 research iterations\".\n427\tconst COUNTED_RUN_ASK = new RegExp(\n428\t  `\\\\b(?:run|start|launch|kick off|do|rerun|re-run) (?:(?:an?|another) )?(?:${LOOP_COUNT.source})`,\n429\t  'g',\n430\t);\n431\tconst EXPLICIT_RUN_ASK = new RegExp(`${LOOP_RUN_REQUESTED.source}|${COUNTED_RUN_ASK.source}`, 'g');\n432\t\n433\t// A run ask with a negation close before it, as in \"but do not run another deep\n434\t// review\", forbids the run rather than asking for it. The negation has to sit\n435\t// within two words of the ask, because \"do not summarize it but run a deep\n436\t// review\" negates the summary and still asks for the run. A bare \"no\" refuses\n437\t// only the loop name right after it, as in \"no deep review, please\", and \"not\n438\t// asking for\" refuses what it names, while a bare \"not\" is left out because\n439\t// \"why not run a deep review\" proposes the run.\n440\tconst RUN_ASK_NEGATED = /(?:\\b(?:do not|don't|dont|never|no need to|need not|needn't|without|not asking for|not looking for)\\s+(?:[\\w'-]+\\s+){0,2}|\\bno\\s+)$/;\n441\t\n442\t// A refusal can also follow the loop name, as in \"a deep review is not needed\".\n443\t// It keys on a need word, so \"the deep research run is not stuck\" stays a\n444\t// statement about the run.\n445\tconst LOOP_ASK_REFUSED_AFTER = /^(?: (?:run|loop|pass|iterations?))? (?:(?:is|are|was|were) (?:not|no longer)|isn't|aren't|wasn't|weren't|not) (?:needed|necessary|required|wanted|warranted|called for)\\b/;\n446\t\n447\t// The past-run and writing-about readings below describe a prompt's purpose, so\n448\t// an explicit run ask outranks them when it comes first, as in \"run deep\n449\t// research to explain why the last CI run failed\", or when it opens a clause of\n450\t// its own after them. A run ask inside the topic, as in \"write a blog post about\n451\t// how to run a deep review\", is part of what the piece covers.\n452\tfunction explicitRunOutranks(lower: string, readingAt: number): boolean {\n453\t  for (const match of lower.matchAll(EXPLICIT_RUN_ASK)) {\n454\t    if (RUN_ASK_NEGATED.test(lower.slice(0, match.index))) continue;\n455\t    if (match.index < readingAt) return true;\n456\t    if (/[,.;!?\\n]/.test(lower.slice(readingAt, match.index))) return true;\n457\t  }\n458\t  return false;\n459\t}\n460\t\n461\t// A request to read, summarize or explain what a past run produced wants that\n462\t// output, not another run. A continue, resume or extend verb asks for the run\n463\t// again, so it keeps the offer.\n464\tconst PAST_RUN_READ_VERB = /\\b(?:summari[sz]e|summary|recap|explain|read|tell me|walk me through|go through|what did|show me|pull out|extract)\\b/;\n465\tconst PAST_RUN_OUTPUT = /\\b(?:last|previous|prior|earlier|yesterday's|finished|completed) (?:[\\w'-]+ ){0,2}?(?:deep[- ])?(?:research|review|loop|run)\\b|\\b(?:research|review(?:-report)?)\\.md\\b|\\b(?:research|review) report\\b|\\bdeep[- ](?:research|review) (?:output|report|results|findings|produced|concluded|found|wrote)\\b/;\n466\tconst RUN_CONTINUED = /\\b(?:continue|resume|extend|rerun|re-run|more iterations?|\\d+ more)\\b/;\n467\t\n468\texport function isPastRunRead(text: string): boolean {\n469\t  const lower = text.toLowerCase().replace(/[‘’]/g, \"'\");\n470\t  const readVerb = PAST_RUN_READ_VERB.exec(lower);\n471\t  return readVerb !== null && PAST_RUN_OUTPUT.test(lower) && !RUN_CONTINUED.test(lower)\n472\t    && !explicitRunOutranks(lower, readVerb.index);\n473\t}\n474\t\n475\t// Writing a piece about a loop method names the loop as a topic. The genre noun\n476\t// is what marks it, so \"write up the findings\" after a run still asks for one.\n477\tconst WRITING_ABOUT_TOPIC = /\\b(?:write|draft|compose|author|prepare|publish|outline)\\b (?:[\\w'-]+ ){0,3}?(?:blog(?: post)?|article|essay|newsletter(?: section| issue)?|tweet(?: thread)?|thread|post|talk|presentation|slides?|deck|tutorial|op-ed|piece|whitepaper|white paper|primer|explainer)s?\\b (?:[\\w'-]+ ){0,3}?(?:about|on|explaining|covering|describing|introducing|why|how)\\b/;\n478\t\n479\t// Many keyboards type a contraction with a curly apostrophe, and the gate's\n480\t// patterns spell it straight, so each exported test reads the text lowercased\n481\t// and folded to the straight form.\n482\tfunction lowerFolded(text: string): string {\n483\t  return text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\");\n484\t}\n485\t\n486\texport function isWritingAboutTopic(text: string): boolean {\n487\t  const lower = lowerFolded(text);\n488\t  const writing = WRITING_ABOUT_TOPIC.exec(lower);\n489\t  return writing !== null && !explicitRunOutranks(lower, writing.index);\n490\t}\n491\t\n492\t// The line alternative is a pattern rather than a phrase, so it is appended raw\n493\t// beside the escaped vocabulary instead of being escaped with it.\n494\tconst SMALL_EDIT_REQUEST = new RegExp(\n495\t  `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n496\t);\n497\t\n498\t// A request that asks for a document to be created or written wants the whole\n499\t// document, even when it names a correction to make afterwards, so this check\n500\t// stands the small-edit gate down.\n501\tconst CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n502\t\n503\t// A small edit names the correction to make, so the verb is what marks one.\n504\tconst CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n505\t\n506\t// These three creation commands write a whole document that is later corrected in\n507\t// place, so a correction request names an edit to it rather than a new one. Every\n508\t// other creation command names a purpose that a correction word belongs to.\n509\tconst SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n510\t\n511\t// Wording that asks for an answer and rules out a change. One pattern serves\n512\t// every gate that has to honour it, so a new gate cannot drift from the first.\n513\t// Words alone cannot tell \"make no changes to the files\" from a change request\n514\t// that says what to leave alone, so both read as no change: losing an offer\n515\t// costs less than offering a mutating command on a prompt that ruled one out.\n516\t// A negated write verb counts only with an object that names nothing in\n517\t// particular, because \"don't add tools\" limits a change and does not refuse it.\n518\texport const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't|dont) (?:make (?:any )?changes|change|edit|modify|touch|(?:create|write|add|delete|remove) (?:it|this|that|anything|any files?))|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n519\t\n520\t// Many keyboards type the contraction with a curly apostrophe, so the text is\n521\t// folded to the straight form before the pattern reads it.\n522\texport function isNoEditRequest(text: string): boolean {\n523\t  return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n524\t}\n525\t\n526\t// A refusal or a question reaches its command through a use verb, so the two\n527\t// lists below share this one. A gap holds one or two plain words and no\n528\t// punctuation, because a comma ends the clause that holds the lead.\n529\texport const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\n530\texport const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n531\t\n532\t// A loop name also asks for the run when the reader says they want one, as in\n533\t// \"I'd like a research loop on X\". The article has to follow the want verb at\n534\t// once, so \"I'd like to know what a review loop is\" stays a question.\n535\t// \"Set up\" also configures a standing process, so it asks for a run only when\n536\t// the loop name is not followed by what the process serves, as in \"set up a\n537\t// review loop for PR approvals\". A wanted loop that serves every item or that a\n538\t// clause describes, as in \"we need a review loop for every PR\" or \"a review\n539\t// loop that approves PRs\", is that standing process too, while \"a research\n540\t// loop on cache eviction\" or \"a deep loop for the parser\" still names a run.\n541\texport const LOOP_WANT_LEADS: readonly string[] = [\n542\t  \"i'd like\",\n543\t  'i would like',\n544\t  \"we'd like\",\n545\t  'we would like',\n546\t  'i want',\n547\t  'we want',\n548\t  'i need',\n549\t  'we need',\n550\t  'give me',\n551\t  'spin up',\n552\t];\n553\tconst LOOP_WANT_LEAD = `(?:${LOOP_WANT_LEADS.map(escapePhrase).join('|')})`;\n554\t\n555\t// A continue, resume or extend verb asks for a run the reader already has.\n556\tconst LOOP_CONTINUE_VERB = '(?:continue|resume|extend|restart)';\n557\t\n558\t// The loop name has to be the verb's own object, so the words between them\n559\t// hold no preposition or clause word: \"run tests until the review loop passes\"\n560\t// runs the tests.\n561\tconst LOOP_OBJECT_GAP = \"(?:(?!(?:until|while|when|whenever|unless|if|once|before|after|because|so|then|and|but|or|for|on|in|of|with|against|to|into|over|through|from|by|at)\\\\b)[a-z0-9'-]+ ){0,3}\";\n562\t\n563\t// One alternation over the loop wording keeps the gate a single test per\n564\t// prompt, and the boundary markers keep a phrase from firing inside a longer\n565\t// word while a multi-word phrase still has to match as a whole. A wording\n566\t// phrase also stops at a path or a file name, so `deep-review.md` and\n567\t// `system-deep-review/` name files rather than the loop. An iterative ask, an\n568\t// iteration count, more than one pass, and a loop name behind a use, continue\n569\t// or want verb each ask for the loop, so they are appended raw as patterns\n570\t// beside the escaped vocabulary.\n571\tconst LOOP_NAME_PATTERN = `(?:${LOOP_NAMES.map(escapePhrase).join('|')})`;\n572\texport const LOOP_REQUEST = new RegExp(\n573\t  `(?<![\\\\w/.-])(?:${LOOP_WORDING.map(escapePhrase).join('|')})(?![\\\\w-]|[./]\\\\w)`\n574\t  + `|\\\\b(?:(?:${COMMAND_USE_VERB}|${LOOP_CONTINUE_VERB}) ${LOOP_OBJECT_GAP}${LOOP_NAME_PATTERN}`\n575\t  + `|${LOOP_WANT_LEAD} (?:an?|another) (?:[a-z0-9'-]+ ){0,2}?${LOOP_NAME_PATTERN}(?! (?:that|which|for (?:every|each|all|any))\\\\b)`\n576\t  + `|set up (?:an?|another) (?:[a-z0-9'-]+ ){0,2}?${LOOP_NAME_PATTERN}(?! (?:for|that|which|to)\\\\b))\\\\b`\n577\t  + `|${ITERATIVE_ASK.source}|${MULTI_PASS.source}|${LOOP_COUNT.source}`,\n578\t);\n579\tconst LOOP_REQUEST_ALL = new RegExp(LOOP_REQUEST.source, 'g');\n580\t\n581\t// A loop name can be the subject of the request rather than what it asks for:\n582\t// an edit or fix verb leads it, as in \"refactor the deep research scorer\", or a\n583\t// code, file or result noun or a result verb follows it, as in \"open the review\n584\t// loop config\" or \"fix the bugs the deep review found\". The edit verb reaches\n585\t// the name across the same gap a use verb does, so \"fix the parser with a deep\n586\t// review\" still asks for the run.\n587\tconst LOOP_EDIT_LEAD = new RegExp(`\\\\b(?:refactor|fix|edit|modify|rewrite|debug|patch|rename|tweak|tune|clean up) ${LOOP_OBJECT_GAP}$`);\n588\tconst LOOP_ARTIFACT_AFTER = /^(?:'s)? (?:scorer|scoring|config|configs|configuration|settings|module|script|scripts|implementation|prompt|prompts|template|templates|schema|runner|reducer|logic|tests|docs|documentation|yaml|json|findings|results|dashboard|command file|found|flagged|reported|raised|produced|surfaced|returned|generated|turned up)\\b/;\n589\t\n590\t// A hyphen count or `multi-pass` is an adjective, so it measures the loop only\n591\t// when it qualifies the loop's own work or ends the phrase, as in \"a three-pass\n592\t// review\" or \"review it multi-pass\", and not when it describes a subject, as in\n593\t// \"three-pass vs two-pass compilers\" or \"our multi-pass compiler\". Up to three\n594\t// words may stand before the loop's noun, as in \"a multi-pass security and\n595\t// correctness audit\".\n596\tconst HYPHEN_COUNT = /-(?:pass(?:es)?|rounds?|iterations?)$/;\n597\tconst HYPHEN_COUNT_MEASURES_LOOP = /^(?:$|\\s*[,.;:!?)\\n]| (?:[a-z-]+ ){0,3}?(?:deep[- ])?(?:review|research|audit|investigation|analysis|inspection|check|scan|sweep|loop|run|approach)(?:s|es)?\\b| (?:on|of|over|across|through|for|at|against|with|in|into|until|and|then|to|please|now)\\b)/;\n598\t\n599\t// A count of iterations of something that is not the loop, as in \"compare 10\n600\t// iterations of the model\", counts the subject's versions, and a count that\n601\t// does something, as in \"several passes of the linter failed\", reports runs\n602\t// that already happened.\n603\tconst COUNT_NOUN = /(?:pass(?:es)?|rounds?|iterations?)$/;\n604\tconst ITERATIONS_OF_SUBJECT = /^ of (?!(?:(?:the|this|that|my|our|a|an) )?(?:deep[- ])?(?:review|research|audit|investigation|analysis|loop)\\b|(?:it|this|that)\\b|(?:the|this|that|my|our) [a-z-]+ (?:review|research|audit|investigation|analysis)\\b)/;\n605\tconst COUNT_AS_SUBJECT = /^(?: of (?:[\\w'-]+ ){0,2}?[\\w'-]+)? (?:failed|ran|took|were|was|had|showed|found|produced|returned|crashed|broke|timed out|succeeded|completed|finished|didn't|did not)\\b/;\n606\t\n607\tfunction namesLoopSubject(phrase: string, before: string, after: string): boolean {\n608\t  if (LOOP_EDIT_LEAD.test(before) || LOOP_ARTIFACT_AFTER.test(after)) return true;\n609\t  if (HYPHEN_COUNT.test(phrase) && !HYPHEN_COUNT_MEASURES_LOOP.test(after)) return true;\n610\t  if (/iterations?$/.test(phrase) && ITERATIONS_OF_SUBJECT.test(after)) return true;\n611\t  return COUNT_NOUN.test(phrase) && COUNT_AS_SUBJECT.test(after);\n612\t}\n613\t\n614\t// Any one loop phrase that is neither refused nor the request's subject asks\n615\t// for the run, so \"don't summarize it, run a deep review\" still asks.\n616\tfunction hasLoopAsk(lowered: string): boolean {\n617\t  for (const match of lowered.matchAll(LOOP_REQUEST_ALL)) {\n618\t    const before = lowered.slice(0, match.index);\n619\t    const after = lowered.slice(match.index + match[0].length);\n620\t    if (RUN_ASK_NEGATED.test(before) || LOOP_ASK_REFUSED_AFTER.test(after)) continue;\n621\t    if (namesLoopSubject(match[0], before, after)) continue;\n622\t    return true;\n623\t  }\n624\t  return false;\n625\t}\n626\t\n627\t// Loop wording also names a loop the reader is not asking to start: a past run\n628\t// whose output they want read, a stuck run they want diagnosed, or a method they\n629\t// want to write about. Both deep-loop offer paths read this one test, so the\n630\t// routed mode and the deferred mode cannot disagree on what counts as the ask.\n631\t// The want leads spell their contractions with a straight apostrophe, so a curly\n632\t// one is folded first, and every exception below reads the folded text too.\n633\texport function asksForLoopRun(prompt: string): boolean {\n634\t  const lowered = lowerFolded(prompt);\n635\t  return hasLoopAsk(lowered)\n636\t    && !isPastRunRead(lowered)\n637\t    && !isStuckRunComplaint(lowered)\n638\t    && !isWritingAboutTopic(lowered)\n639\t    && !isLoopQuestion(lowered);\n640\t}\n641\t\n642\t// A question about how the loop works names it the way a request to run it\n643\t// does, as in \"how does the deep review decide it has converged\". It asks for\n644\t// the run only when it also tells the loop to start or gives an iteration count.\n645\t// A negated question, as in \"why doesn't my deep review converge\", asks about\n646\t// the loop the same way. The loop has to be what the question is about, so\n647\t// \"deep research: how do vector databases handle hybrid search\" still asks for\n648\t// a run on that topic.\n649\tconst LOOP_SUBJECT = '(?:[\\\\w\\'-]+ ){0,2}?(?:deep[- ](?:research|review|loop)|(?:research|review) loop)\\\\b';\n650\t// \"How many\" asks about the loop's length, as in \"how many passes does the deep\n651\t// review do\".\n652\tconst LOOP_QUESTION = new RegExp(\n653\t  `\\\\b(?:how|why|when|what) (?:does|do|is|are|did|makes|doesn't|don't|isn't|aren't|didn't|won't|can't) ${LOOP_SUBJECT}`\n654\t  + `|\\\\bhow many (?:[\\\\w'-]+ ){0,2}?(?:does|do|is|are|did|will|would|should|can) ${LOOP_SUBJECT}`\n655\t  + `|\\\\b(?:explain|describe) (?:how|what|why|when) ${LOOP_SUBJECT}`,\n656\t);\n657\t// Only a digit count turns the question back into a request. The spelled count\n658\t// is left out on purpose, so a question about the loop that quotes one, as in\n659\t// \"why does the deep review stop after ten iterations\", stays the question it\n660\t// was before spelled counts were read as a loop ask. A question that names no\n661\t// loop is not a loop question at all, so \"why does it stop after ten\n662\t// iterations\" still reads its count as a request for a run.\n663\tconst ITERATION_COUNT = /\\b\\d+ (?:[a-z-]+ ){0,2}iterations?\\b/;\n664\t// A later clause that opens with a use verb on \"one\" or \"it\" asks for the loop\n665\t// the question named, as in \"what is a deep review? run one on the parser\".\n666\tconst LOOP_RUN_BY_PRONOUN = /(?:^|[,.;!?\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*(?:run|start|launch|do|kick off) (?:one|it|another)\\b/;\n667\t\n668\tfunction isLoopQuestion(lowered: string): boolean {\n669\t  return LOOP_QUESTION.test(lowered)\n670\t    && !LOOP_RUN_REQUESTED.test(lowered)\n671\t    && !ITERATION_COUNT.test(lowered)\n672\t    && !LOOP_RUN_BY_PRONOUN.test(lowered);\n673\t}\n674\t\n675\t// `why not` proposes the command rather than refusing it, so the word refuses\n676\t// only where no `why` stands before it.\n677\tconst COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n678\t\n679\t// A command the reader refuses is named without being asked for, so this list\n680\t// holds the leads that mark that naming. A lead must sit directly before the\n681\t// command so a later clause cannot refuse an earlier request, and a gap holds\n682\t// plain words only so a refusal before a comma cannot swallow the request after\n683\t// it. A reader who stops using a command names it only to refuse it.\n684\texport const COMMAND_DECLINE_LEADS: readonly string[] = [\n685\t  `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n686\t  `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n687\t];\n688\t\n689\t// A refusal or a question over an or-list covers every command the list joins,\n690\t// while a second use verb opens a clause of its own, so the list joins only `or`\n691\t// and `, or`. A listed command may carry `the` before it and\n692\t// `command` after it, and the command after the last `or` may carry `the`. A\n693\t// listed command may also carry one plain word after it, such as the subcommand a\n694\t// doctor command takes, so `do not run /x now or /y` refuses both.\n695\tconst COMMAND_OR_LIST = '(?:(?:the )?\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?: [a-z][a-z0-9_-]*)?(?: command)?,? or (?:the )?)*';\n696\t\n697\t// A command the reader asks about is named without being asked for, so this list\n698\t// holds the leads that mark that naming. A lead must sit directly before the\n699\t// command so a later clause cannot turn an earlier request into a question, and\n700\t// a gap holds plain words only so a question before a comma cannot swallow the\n701\t// request after it.\n702\texport const COMMAND_ASK_LEADS: readonly string[] = [\n703\t  \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n704\t  `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n705\t];\n706\t\n707\t// A bare ask word opens a statement as often as a question, so it marks a naming\n708\t// only when the command it precedes is followed by a question mark before the\n709\t// sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n710\t// A question often names the command after `the`, as in `is the /x command safe`.\n711\texport const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) (?:the )?';\n712\t\n713\t// A clause that opens with a use verb and `it` asks for the command an earlier\n714\t// clause only named, so a naming such as `not run /x yet, please start it`\n715\t// becomes a request. The clause has to open that way so `I will run it` stays a\n716\t// statement.\n717\tconst COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n718\t\n719\t// A refusal can come after the name, as in \"/create:readme is not what I want, do\n720\t// not run it\" or \"run /doctor:git setup but do not actually run it\". The clause\n721\t// opens a new sentence or follows \"but\", \"and\" or \"so\", and refuses \"it\" with a\n722\t// use verb, so \"run /speckit:save and don't skip it\" stays a request. The refusal\n723\t// has to end its clause, because \"don't run it twice\" or \"never run it without a\n724\t// budget\" limits the run rather than refusing it.\n725\tconst COMMAND_DECLINED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]|\\\\b(?:but|and|so|though)\\\\b) *(?:(?:please|just|then|still) )*(?:do not|don't|dont|never)(?: (?:actually|really|yet|ever|even))? ${COMMAND_USE_VERB} it(?: (?:yet|now|for now|at all|please))? *(?:$|[,.;!?\\\\n])`);\n726\t\n727\t// A command named as a document is read about, not run: \"read the /create:readme\n728\t// document\", \"open the /deep:review command file\". The name needs a determiner\n729\t// before it, because a typed request puts its argument there instead, as in\n730\t// \"/create:diff file a.md b.md\". A naming followed by \"then\" goes on to ask for\n731\t// work, as in \"read the /deep:review docs, then do a thorough review\", so it is"}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:45:29.691Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Slash command attached to a hub's recommendation\n// ───────────────────────────────────────────────────────────────\n//\n// The advisor can name the workflow mode a hub would route a prompt to, but the\n// reader still has to translate that mode into the slash command that acts on\n// it. This module owns that translation and nothing else, kept free of imports\n// so the recommend path and a test read the same semantics.\n//\n// The mode-to-command table is generated rather than hand-maintained: each row is\n// derived from a hub's own command files, so a hub that adds or renames a mode\n// regenerates its row instead of drifting from a copy someone forgot to update.\n\n// BEGIN GENERATED MODE COMMANDS\nexport const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n  'sk-design': {\n    'sk-design-chart': '/design:chart',\n    'sk-design-diagram': '/design:diagram',\n    'sk-design-md-generator': '/design:extract',\n  },\n  'sk-doc': {\n    'sk-create-agent': '/create:agent',\n    'sk-create-benchmark': '/create:benchmark',\n    'sk-create-changelog': '/create:changelog',\n    'sk-create-command': '/create:command',\n    'sk-create-diff': '/create:diff',\n    'sk-create-feature-catalog': '/create:feature-catalog',\n    'sk-create-goal': '/create:goal',\n    'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n    'sk-create-readme': '/create:readme',\n    'sk-create-repo-rule': '/create:repo-rule',\n    'sk-create-skill': '/create:sk-skill',\n    'sk-create-skill-parent': '/create:skill-parent',\n    'sk-create-with-human-voice': '/create:with-human-voice',\n  },\n  'system-deep-loop': {\n    'research': '/deep:research',\n    'review': '/deep:review',\n  },\n};\n// END GENERATED MODE COMMANDS\n\n// One row of the command table: the runnable slash command, the policy that says\n// whether it runs, asks or starts a session, the class that says what the run\n// writes, and the skill that owns it. The rows are generated, so only the shape\n// lives here.\nexport interface CommandRow {\n  readonly command: string;\n  readonly policy?: 'run' | 'start' | 'ask';\n  readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n  readonly ownerSkillId: string;\n}\n\n// The table below covers every tracked command, whether or not its bridge is\n// active, so a typed command always has a policy and an owner. `scorerRow` says\n// whether a scorer can also return the command on its own.\nexport interface TrackedCommand {\n  readonly policy: 'run' | 'start' | 'ask';\n  readonly ownerSkillId: string;\n  readonly scorerRow: boolean;\n}\n\n// BEGIN GENERATED COMMAND ROWS\nexport const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n  'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-create-sk-skill': { command: '/create:sk-skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n  'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n  'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n  'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n  'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n  'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n  'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n  'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n  'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n  'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n  'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n  'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n  'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n  'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n  'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n  'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n  'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n  'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n  'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n  'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n  'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n  'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n  'command-speckit-ai-council': { command: '/speckit:ai-council', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n  'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n  'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n  'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n};\nexport const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n  '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n  '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n  '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:sk-skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n  '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n  '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n  '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n  '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n  '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n  '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n  '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n  '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n  '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n  '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n  '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n  '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n  '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n  '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n  '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n  '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n  '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n  '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n  '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n  '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n  '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n  '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n  '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n  '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n  '/speckit:ai-council': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n  '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n};\n// END GENERATED COMMAND ROWS\n\n// The row for an id a recommendation carries, or undefined when that id names no\n// command. Own-key lookup because the table is generated data, so an inherited\n// name such as `constructor` must not resolve to a row nobody declared.\nexport function commandRowFor(id: string): CommandRow | undefined {\n  return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n}\n\n// The deep-loop hub owns one diagnosis command besides its two run commands.\nconst DEEP_LOOP_DOCTOR_COMMAND = '/doctor:deep-loop';\n\n// A typed command is the reader's own wording, so it counts only where a command\n// can start and where it ends on a boundary. That keeps a path such as\n// `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n// command, and the longest key wins so `/group:name-parent` is never reduced to\n// its `/group:name` prefix. A dot or a slash followed by a word character\n// continues a file name or a path, while a sentence-ending period does not.\n// A mode suffix and a `:with-*` modifier end the command name the way a space\n// does, after any tracked command. The argument hints say which commands take\n// which, but a modifier typed on a command that does not take it still names\n// that command. The hints chain them, as in `:auto:with-research`, so a run of\n// them counts as one suffix.\nconst COMMAND_START_BOUNDARY = /[\\s`'\"(*[~>\\u201c\\u2018\\u00ab\\u2032\\u2039]/;\nconst COMMAND_CONTINUATION = /[a-z0-9_:-]/;\nconst WORD_CHARACTER = /[a-z0-9_]/;\nconst MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n\n// A command that was renamed is still typed from habit. Its old name reads as\n// the command that replaced it, so the reader lands on the live workflow and\n// not on whatever skill the leftover words happen to score for. The old name\n// gets no command file of its own: this table is the only place it lives.\nconst RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n  '/create:skill': '/create:sk-skill',\n};\n\nexport function typedCommandIn(prompt: string): string | undefined {\n  const lowered = prompt.toLowerCase();\n  let found: string | undefined;\n  for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n    let index = lowered.indexOf(key);\n    while (index !== -1) {\n      const before = index === 0 ? '' : lowered[index - 1];\n      const after = lowered[index + key.length] ?? '';\n      const next = lowered[index + key.length + 1] ?? '';\n      const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n      const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n      const continuesName =\n        !hasModeSuffix\n        && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n      const endsAtBoundary = after === '' || !continuesName;\n      if (startsAtBoundary && endsAtBoundary) {\n        if (found === undefined || key.length > found.length) found = key;\n        break;\n      }\n      index = lowered.indexOf(key, index + 1);\n    }\n  }\n  if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n  return found;\n}\n\n// A typed command travels on the recommendation that leads, so it is delivered\n// only when the leading skill owns the command or carries the same command row.\n// A leading skill unrelated to the command must not carry it.\nexport interface TypedCommand {\n  readonly command: string;\n  readonly policy: 'run' | 'start' | 'ask';\n  readonly ownerSkillId: string;\n}\n\nexport function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n  const command = typedCommandIn(prompt);\n  if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n  if (commandOnlyMentioned(prompt, command)) return undefined;\n  const row = TRACKED_COMMANDS[command];\n  const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n  if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n  return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n}\n\n// Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n// that merely mentions the topic spends the reader's budget on work they never\n// asked for. The list below is the vocabulary that counts as asking for it, and\n// it names the loop itself: a deep loop by name, iterations, or more than one\n// pass. Depth wording such as `thorough` or `in depth` asks for care inside a\n// single pass, and a bare topic word such as `research` or `review` says what\n// to look at, so neither qualifies on its own.\n//\n// The phrases live in a data list, one per line, so the vocabulary a reviewer\n// has to judge stays visible and cheap to correct.\nexport const LOOP_WORDING: readonly string[] = [\n  'deep research',\n  'deep-research',\n  'deep review',\n  'deep-review',\n  'multi-pass',\n];\n\n// `iterative` and an uncounted `iterations` are also how a prompt describes its\n// subject, as in \"the iterative solver\" or \"the last iterations of the plan\", so\n// they ask for the loop only where they say how a review or research runs: on\n// the activity itself (\"iterative review\", \"a looped investigation\"), as the\n// manner of a review or research verb (\"audit it iteratively\"), or as the work's\n// unit (\"in several iterations\", \"more iterations\"). Counted iterations are\n// LOOP_COUNT's.\nconst ITERATIVE_ACTIVITY = '(?:deep[- ])?(?:review|research|audit|investigation|analysis|inspection|check|pass(?:es)?|rounds?|loop)';\nconst ITERATIVE_VERB = '(?:review|research|audit|investigate|inspect|check|scan|examine|analy[sz]e|look into|go over)';\nexport const ITERATIVE_ASK = new RegExp(\n  `\\\\b(?:iterative|looped) ${ITERATIVE_ACTIVITY}\\\\b`\n  + `|\\\\biteratively ${ITERATIVE_VERB}\\\\b`\n  + `|\\\\b${ITERATIVE_VERB}\\\\b(?: [\\\\w./'-]+){0,6}? iteratively\\\\b`\n  + '|\\\\b(?:in|over|through) (?:(?:several|multiple|many|a few|successive|repeated) )?iterations\\\\b'\n  // \"the model needed more iterations to converge\" reports what a process took,\n  // so a verb of taking or using before the amount leaves it a description.\n  + '|\\\\b(?<!\\\\b(?:needed|took|takes|required|requires|used|ran|had|after) )(?:several|multiple|(?<!\\\\bhow )many|a few|successive|repeated|more) iterations\\\\b',\n);\n\n// Passes and rounds are also things a prompt can be about, as in \"three funding\n// rounds\" or \"several rounds of layoffs\", so they ask for the loop only when\n// nothing but a loop word stands between the count and the noun, and an \"of\"\n// after them names the review, the research or the target rather than another\n// subject. Rounds of a named thing are that thing's rounds, as in \"3 rounds of\n// the clinical trial\", so after \"of\" a round takes only a pronoun, the loop\n// noun itself or one named review, as in \"rounds of the security audit\". The\n// named review needs its determiner and has to end there, because \"rounds of\n// peer review\" and \"rounds of the peer review process\" name the subject. A pass\n// may still take its target, as in \"passes of the code\".\nconst PASS_GAP = '(?:(?:more|extra|additional|full|deep|review|research|audit|iterative) ){0,2}';\nconst PASS_NOUN = '(?:passes\\\\b(?! of (?!(?:review|research|audit|investigation|the|it|this|that|these|those|my|our)\\\\b)[a-z])'\n  + '|rounds\\\\b(?! of (?!(?:(?:the|this|that|my|our) )?(?:review|research|audit|investigation|analysis|deep)\\\\b'\n  + '|(?:the|this|that|my|our) [a-z-]+ (?:review|research|audit|investigation|analysis)\\\\b(?! (?!(?:on|of|for|in|with|to|and|then|until|so|at|across|against|over|before|after)\\\\b)[a-z])'\n  + '|(?:it|this|that)\\\\b(?! [a-z]))[a-z]))';\n\n// More than one pass or round asks for the loop the way iterations do. \"How\n// many passes does it run\" asks about the loop, so `many` counts only where no\n// `how` stands before it.\nexport const MULTI_PASS = new RegExp(`\\\\b(?:multiple|several|(?<!\\\\bhow )many) ${PASS_GAP}${PASS_NOUN}`);\n\n// An iteration count asks for the loop whether it is typed as a digit or spelled\n// out, and a hyphen may join the two, as in \"twelve-iteration\". A count counts\n// from two up, because \"in one iteration\" asks for a single pass, and one counts\n// only as one more, as in \"do one more iteration\". A pass or a round counts the\n// same way, and the singular counts only when hyphen-joined, as in \"two-pass\",\n// because \"3 tests pass\" uses it as a verb. A count after a word that points\n// back, as in \"the first 2 iterations\", or after \"after\", as in \"failed after 3\n// iterations\", names runs that already happened rather than asking for more,\n// while \"stop after 10 iterations\" sets the length of the run it asks for.\nconst COUNT_BACK_POINTER = '(?<!\\\\b(?:first|last|previous|past|prior|earlier|those|these|the|both|(?<!\\\\bstop )after) )';\nconst COUNT_WORDS = '(?:two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|(?:a )?dozen)';\nconst LOOP_COUNT_LEAD = `${COUNT_BACK_POINTER}(?:[2-9]|\\\\d{2,}|${COUNT_WORDS}|(?:1|one)(?= (?:more|extra|additional|further)\\\\b))`;\nexport const LOOP_COUNT = new RegExp(\n  `\\\\b${LOOP_COUNT_LEAD}[- ](?:[a-z-]+ ){0,2}?iterations?\\\\b`\n  + `|\\\\b${LOOP_COUNT_LEAD}(?:-(?:rounds?|pass(?:es)?)\\\\b| ${PASS_GAP}${PASS_NOUN})`,\n);\n\n// A loop's own name is how a reader asks about the loop as often as how they ask\n// to run one, so \"how does the research loop decide when it has enough\" stays a\n// question. The name counts as asking for the run only behind a use verb, as in\n// \"start a research loop\".\nexport const LOOP_NAMES: readonly string[] = [\n  'deep loop',\n  'research loop',\n  'review loop',\n];\n\n// A creation workflow scaffolds, reviews and validates a whole document, which is\n// the wrong size for a correction inside one. The list below is the vocabulary\n// that marks that correction, and a line number points at one the same way.\nexport const SMALL_EDIT_WORDING: readonly string[] = [\n  'typo',\n  'typos',\n  'spelling',\n  'misspelled',\n  'misspelling',\n  'grammar',\n  'punctuation',\n  'wording',\n  'broken link',\n  'broken links',\n  'dead link',\n  'dead links',\n  'one line',\n  'single line',\n];\n\n// A phrase may carry punctuation a regex would read as a metacharacter, so it is\n// escaped before it is trusted as a pattern.\nfunction escapePhrase(phrase: string): string {\n  return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\n// One word that names a deep-loop mode. A route that defers on a loop request\n// still names its mode when the prompt carries exactly one of these cues.\n// A check or an inspection aimed at defects is a review in plain words, so it\n// counts beside review and audit. The defect noun is required, because \"check\n// that the build passes\" asks for no review at all. The scorer reads the defect\n// check on its own as well, because its verbs also read as a request to explain.\nexport const DEFECT_CHECK = /\\b(?:check|inspect|scan|examine|go over|look over)\\b(?:\\s+[\\w./-]+){0,5}?\\s+for\\s+(?:[\\w-]+\\s+){0,2}?(?:bugs?|defects?|mistakes?|errors?|vulnerabilit(?:y|ies)|issues?|problems?|regressions?|flaws?)\\b/;\n// The -ing form carries the cue too, as in \"a deep loop reviewing the session store\".\nexport const MODE_CUES: Readonly<Record<string, RegExp>> = {\n  research: /\\b(?:research(?:ing)?|investigat(?:e|es|ing|ion)|look into|find out)\\b/,\n  review: new RegExp(`\\\\b(?:review(?:ing)?|audit(?:ing)?)\\\\b|${DEFECT_CHECK.source}`),\n};\n\n// A run that is stuck, never converges or whose graph looks stale is a fault in\n// an existing run, so it asks for a diagnosis rather than for a new run. The\n// subject has to name a deep run or its state, because \"my build is stuck\" is\n// not about the loop, and a use verb right before the subject turns it back\n// into a request, as in \"run deep research on why sockets hang\". An audit loop\n// is the review loop by another name, and \"the review I started\" names a run the\n// reader launched, while \"the test runner I started\" names no deep run at all.\n// Convergence and a coverage graph belong to training runs and test reports as\n// much as to the loop, so they name a deep run only beside a review or research\n// noun, as in \"the research convergence\" or \"the coverage graph for my review\".\nconst LOOP_RUN_SUBJECT = /\\b(?:deep[- ](?:research|review|loop)|(?:research|review|audit) (?:loop|run)|(?:research|review|audit)(?: (?:loop|run))? (?:i|we) (?:just )?(?:started|launched|kicked off|ran|began|set off|set up)|(?:the|my|our|this|that) (?:research|review|audit)(?:'s)? (?:coverage graph|convergence)|(?:coverage graph|convergence) (?:of|for|in|on) (?:(?:the|my|our|this|that) )?(?:research|review|audit))\\b/;\n// \"keep going\" asks for more of a run, so it is not among the symptoms, and\n// \"spinning up\" starts a run rather than describing one that is stuck. A state\n// word that a negation leads, as in \"the run is not stuck\", denies the symptom,\n// while the negated verbs further on, as in \"not converging\", are symptoms.\nconst LOOP_RUN_SYMPTOM = /\\b(?:(?<!\\b(?:not|isn't|wasn't|aren't|weren't|longer|never) )(?:stuck|hangs?|hanging|hung|frozen|stalled|stalls|spins|spinning(?! up)|stale|empty)|never (?:converges?|finishes|stops|ends|fires)|(?:not|isn't|is not|won't|will not|doesn't|does not|didn't|did not|can't|cannot|without) (?:converg\\w*|finish\\w*|progress\\w*|mov\\w*|fir\\w*)|stopped (?:converg\\w*|progress\\w*|moving)|keeps? (?:running|repeating|looping)|(?:hasn't|has not|haven't|have not) (?:moved|changed|converged|progressed)|no progress)\\b/;\nconst LOOP_RUN_REQUESTED = /\\b(?:run|start|use|launch|kick off|do|rerun|re-run) (?:[a-z0-9'-]+ ){0,2}(?:deep[- ](?:research|review|loop)|(?:research|review|audit) (?:loop|run))\\b/;\n\n// The deep loop's doctor reads a deep run's own state, so a prompt that names no\n// deep run, as in \"the model needed more iterations to converge\", has nothing for\n// it to read, however many of its keywords the prompt shares.\nexport function namesDeepRun(text: string): boolean {\n  return LOOP_RUN_SUBJECT.test(text.toLowerCase().replace(/[‘’]/g, \"'\"));\n}\n\n// A counted run ask, as in \"run 5 more iterations\", asks for more of the run\n// whatever state the reader reports it in, so it cancels the stuck reading\n// unless a refusal leads it.\nexport function isStuckRunComplaint(text: string): boolean {\n  const lower = text.toLowerCase().replace(/[‘’]/g, \"'\");\n  return LOOP_RUN_SUBJECT.test(lower) && LOOP_RUN_SYMPTOM.test(lower) && !LOOP_RUN_REQUESTED.test(lower)\n    && ![...lower.matchAll(COUNTED_RUN_ASK)].some((match) => !RUN_ASK_NEGATED.test(lower.slice(0, match.index)));\n}\n\n// A run asked for in so many words: a use verb on a deep loop's name, or on a\n// count of iterations, rounds or passes, as in \"run 10 research iterations\".\nconst COUNTED_RUN_ASK = new RegExp(\n  `\\\\b(?:run|start|launch|kick off|do|rerun|re-run) (?:(?:an?|another) )?(?:${LOOP_COUNT.source})`,\n  'g',\n);\nconst EXPLICIT_RUN_ASK = new RegExp(`${LOOP_RUN_REQUESTED.source}|${COUNTED_RUN_ASK.source}`, 'g');\n\n// A run ask with a negation close before it, as in \"but do not run another deep\n// review\", forbids the run rather than asking for it. The negation has to sit\n// within two words of the ask, because \"do not summarize it but run a deep\n// review\" negates the summary and still asks for the run. A bare \"no\" refuses\n// only the loop name right after it, as in \"no deep review, please\", and \"not\n// asking for\" refuses what it names, while a bare \"not\" is left out because\n// \"why not run a deep review\" proposes the run.\nconst RUN_ASK_NEGATED = /(?:\\b(?:do not|don't|dont|never|no need to|need not|needn't|without|not asking for|not looking for)\\s+(?:[\\w'-]+\\s+){0,2}|\\bno\\s+)$/;\n\n// A refusal can also follow the loop name, as in \"a deep review is not needed\".\n// It keys on a need word, so \"the deep research run is not stuck\" stays a\n// statement about the run.\nconst LOOP_ASK_REFUSED_AFTER = /^(?: (?:run|loop|pass|iterations?))? (?:(?:is|are|was|were) (?:not|no longer)|isn't|aren't|wasn't|weren't|not) (?:needed|necessary|required|wanted|warranted|called for)\\b/;\n\n// The past-run and writing-about readings below describe a prompt's purpose, so\n// an explicit run ask outranks them when it comes first, as in \"run deep\n// research to explain why the last CI run failed\", or when it opens a clause of\n// its own after them. A run ask inside the topic, as in \"write a blog post about\n// how to run a deep review\", is part of what the piece covers.\nfunction explicitRunOutranks(lower: string, readingAt: number): boolean {\n  for (const match of lower.matchAll(EXPLICIT_RUN_ASK)) {\n    if (RUN_ASK_NEGATED.test(lower.slice(0, match.index))) continue;\n    if (match.index < readingAt) return true;\n    if (/[,.;!?\\n]/.test(lower.slice(readingAt, match.index))) return true;\n  }\n  return false;\n}\n\n// A request to read, summarize or explain what a past run produced wants that\n// output, not another run. A continue, resume or extend verb asks for the run\n// again, so it keeps the offer.\nconst PAST_RUN_READ_VERB = /\\b(?:summari[sz]e|summary|recap|explain|read|tell me|walk me through|go through|what did|show me|pull out|extract)\\b/;\nconst PAST_RUN_OUTPUT = /\\b(?:last|previous|prior|earlier|yesterday's|finished|completed) (?:[\\w'-]+ ){0,2}?(?:deep[- ])?(?:research|review|loop|run)\\b|\\b(?:research|review(?:-report)?)\\.md\\b|\\b(?:research|review) report\\b|\\bdeep[- ](?:research|review) (?:output|report|results|findings|produced|concluded|found|wrote)\\b/;\nconst RUN_CONTINUED = /\\b(?:continue|resume|extend|rerun|re-run|more iterations?|\\d+ more)\\b/;\n\nexport function isPastRunRead(text: string): boolean {\n  const lower = text.toLowerCase().replace(/[‘’]/g, \"'\");\n  const readVerb = PAST_RUN_READ_VERB.exec(lower);\n  return readVerb !== null && PAST_RUN_OUTPUT.test(lower) && !RUN_CONTINUED.test(lower)\n    && !explicitRunOutranks(lower, readVerb.index);\n}\n\n// Writing a piece about a loop method names the loop as a topic. The genre noun\n// is what marks it, so \"write up the findings\" after a run still asks for one.\nconst WRITING_ABOUT_TOPIC = /\\b(?:write|draft|compose|author|prepare|publish|outline)\\b (?:[\\w'-]+ ){0,3}?(?:blog(?: post)?|article|essay|newsletter(?: section| issue)?|tweet(?: thread)?|thread|post|talk|presentation|slides?|deck|tutorial|op-ed|piece|whitepaper|white paper|primer|explainer)s?\\b (?:[\\w'-]+ ){0,3}?(?:about|on|explaining|covering|describing|introducing|why|how)\\b/;\n\n// Many keyboards type a contraction with a curly apostrophe, and the gate's\n// patterns spell it straight, so each exported test reads the text lowercased\n// and folded to the straight form.\nfunction lowerFolded(text: string): string {\n  return text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\");\n}\n\nexport function isWritingAboutTopic(text: string): boolean {\n  const lower = lowerFolded(text);\n  const writing = WRITING_ABOUT_TOPIC.exec(lower);\n  return writing !== null && !explicitRunOutranks(lower, writing.index);\n}\n\n// The line alternative is a pattern rather than a phrase, so it is appended raw\n// beside the escaped vocabulary instead of being escaped with it.\nconst SMALL_EDIT_REQUEST = new RegExp(\n  `\\\\b(?:${SMALL_EDIT_WORDING.map(escapePhrase).join('|')}|line \\\\d+)\\\\b`,\n);\n\n// A request that asks for a document to be created or written wants the whole\n// document, even when it names a correction to make afterwards, so this check\n// stands the small-edit gate down.\nconst CREATION_REQUEST = /\\b(?:creat(?:e|es|ing)|writ(?:e|es|ing)|author(?:ing)?|draft(?:ing)?|scaffold(?:ing)?|generat(?:e|es|ing)|mak(?:e|es|ing)|new|build(?:ing)?|set up|add an?|need an?)\\b/;\n\n// A small edit names the correction to make, so the verb is what marks one.\nconst CORRECTION_VERB = /\\b(?:fix|correct|update|edit|change|tweak|repair)\\b/;\n\n// These three creation commands write a whole document that is later corrected in\n// place, so a correction request names an edit to it rather than a new one. Every\n// other creation command names a purpose that a correction word belongs to.\nconst SMALL_EDIT_GATED_COMMANDS: ReadonlySet<string> = new Set(['/create:readme', '/create:feature-catalog', '/create:manual-testing-playbook']);\n\n// Wording that asks for an answer and rules out a change. One pattern serves\n// every gate that has to honour it, so a new gate cannot drift from the first.\n// Words alone cannot tell \"make no changes to the files\" from a change request\n// that says what to leave alone, so both read as no change: losing an offer\n// costs less than offering a mutating command on a prompt that ruled one out.\n// A negated write verb counts only with an object that names nothing in\n// particular, because \"don't add tools\" limits a change and does not refuse it.\nexport const NO_EDIT_REQUEST = /\\b(no edits?|make no changes|no changes yet|without making changes|(?:do not|don't|dont) (?:make (?:any )?changes|change|edit|modify|touch|(?:create|write|add|delete|remove) (?:it|this|that|anything|any files?))|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n\n// Many keyboards type the contraction with a curly apostrophe, so the text is\n// folded to the straight form before the pattern reads it.\nexport function isNoEditRequest(text: string): boolean {\n  return NO_EDIT_REQUEST.test(text.toLowerCase().replace(/[\\u2018\\u2019]/g, \"'\"));\n}\n\n// A refusal or a question reaches its command through a use verb, so the two\n// lists below share this one. A gap holds one or two plain words and no\n// punctuation, because a comma ends the clause that holds the lead.\nexport const COMMAND_USE_VERB = '(?:run|start|use|invoke|launch|execute|call|trigger|open|rerun|re-run|kick off)';\nexport const COMMAND_GAP_WORDS = \"(?:[a-z']+ ){0,2}\";\n\n// A loop name also asks for the run when the reader says they want one, as in\n// \"I'd like a research loop on X\". The article has to follow the want verb at\n// once, so \"I'd like to know what a review loop is\" stays a question.\n// \"Set up\" also configures a standing process, so it asks for a run only when\n// the loop name is not followed by what the process serves, as in \"set up a\n// review loop for PR approvals\". A wanted loop that serves every item or that a\n// clause describes, as in \"we need a review loop for every PR\" or \"a review\n// loop that approves PRs\", is that standing process too, while \"a research\n// loop on cache eviction\" or \"a deep loop for the parser\" still names a run.\nexport const LOOP_WANT_LEADS: readonly string[] = [\n  \"i'd like\",\n  'i would like',\n  \"we'd like\",\n  'we would like',\n  'i want',\n  'we want',\n  'i need',\n  'we need',\n  'give me',\n  'spin up',\n];\nconst LOOP_WANT_LEAD = `(?:${LOOP_WANT_LEADS.map(escapePhrase).join('|')})`;\n\n// A continue, resume or extend verb asks for a run the reader already has.\nconst LOOP_CONTINUE_VERB = '(?:continue|resume|extend|restart)';\n\n// The loop name has to be the verb's own object, so the words between them\n// hold no preposition or clause word: \"run tests until the review loop passes\"\n// runs the tests.\nconst LOOP_OBJECT_GAP = \"(?:(?!(?:until|while|when|whenever|unless|if|once|before|after|because|so|then|and|but|or|for|on|in|of|with|against|to|into|over|through|from|by|at)\\\\b)[a-z0-9'-]+ ){0,3}\";\n\n// One alternation over the loop wording keeps the gate a single test per\n// prompt, and the boundary markers keep a phrase from firing inside a longer\n// word while a multi-word phrase still has to match as a whole. A wording\n// phrase also stops at a path or a file name, so `deep-review.md` and\n// `system-deep-review/` name files rather than the loop. An iterative ask, an\n// iteration count, more than one pass, and a loop name behind a use, continue\n// or want verb each ask for the loop, so they are appended raw as patterns\n// beside the escaped vocabulary.\nconst LOOP_NAME_PATTERN = `(?:${LOOP_NAMES.map(escapePhrase).join('|')})`;\nexport const LOOP_REQUEST = new RegExp(\n  `(?<![\\\\w/.-])(?:${LOOP_WORDING.map(escapePhrase).join('|')})(?![\\\\w-]|[./]\\\\w)`\n  + `|\\\\b(?:(?:${COMMAND_USE_VERB}|${LOOP_CONTINUE_VERB}) ${LOOP_OBJECT_GAP}${LOOP_NAME_PATTERN}`\n  + `|${LOOP_WANT_LEAD} (?:an?|another) (?:[a-z0-9'-]+ ){0,2}?${LOOP_NAME_PATTERN}(?! (?:that|which|for (?:every|each|all|any))\\\\b)`\n  + `|set up (?:an?|another) (?:[a-z0-9'-]+ ){0,2}?${LOOP_NAME_PATTERN}(?! (?:for|that|which|to)\\\\b))\\\\b`\n  + `|${ITERATIVE_ASK.source}|${MULTI_PASS.source}|${LOOP_COUNT.source}`,\n);\nconst LOOP_REQUEST_ALL = new RegExp(LOOP_REQUEST.source, 'g');\n\n// A loop name can be the subject of the request rather than what it asks for:\n// an edit or fix verb leads it, as in \"refactor the deep research scorer\", or a\n// code, file or result noun or a result verb follows it, as in \"open the review\n// loop config\" or \"fix the bugs the deep review found\". The edit verb reaches\n// the name across the same gap a use verb does, so \"fix the parser with a deep\n// review\" still asks for the run.\nconst LOOP_EDIT_LEAD = new RegExp(`\\\\b(?:refactor|fix|edit|modify|rewrite|debug|patch|rename|tweak|tune|clean up) ${LOOP_OBJECT_GAP}$`);\nconst LOOP_ARTIFACT_AFTER = /^(?:'s)? (?:scorer|scoring|config|configs|configuration|settings|module|script|scripts|implementation|prompt|prompts|template|templates|schema|runner|reducer|logic|tests|docs|documentation|yaml|json|findings|results|dashboard|command file|found|flagged|reported|raised|produced|surfaced|returned|generated|turned up)\\b/;\n\n// A hyphen count or `multi-pass` is an adjective, so it measures the loop only\n// when it qualifies the loop's own work or ends the phrase, as in \"a three-pass\n// review\" or \"review it multi-pass\", and not when it describes a subject, as in\n// \"three-pass vs two-pass compilers\" or \"our multi-pass compiler\". Up to three\n// words may stand before the loop's noun, as in \"a multi-pass security and\n// correctness audit\".\nconst HYPHEN_COUNT = /-(?:pass(?:es)?|rounds?|iterations?)$/;\nconst HYPHEN_COUNT_MEASURES_LOOP = /^(?:$|\\s*[,.;:!?)\\n]| (?:[a-z-]+ ){0,3}?(?:deep[- ])?(?:review|research|audit|investigation|analysis|inspection|check|scan|sweep|loop|run|approach)(?:s|es)?\\b| (?:on|of|over|across|through|for|at|against|with|in|into|until|and|then|to|please|now)\\b)/;\n\n// A count of iterations of something that is not the loop, as in \"compare 10\n// iterations of the model\", counts the subject's versions, and a count that\n// does something, as in \"several passes of the linter failed\", reports runs\n// that already happened.\nconst COUNT_NOUN = /(?:pass(?:es)?|rounds?|iterations?)$/;\nconst ITERATIONS_OF_SUBJECT = /^ of (?!(?:(?:the|this|that|my|our|a|an) )?(?:deep[- ])?(?:review|research|audit|investigation|analysis|loop)\\b|(?:it|this|that)\\b|(?:the|this|that|my|our) [a-z-]+ (?:review|research|audit|investigation|analysis)\\b)/;\nconst COUNT_AS_SUBJECT = /^(?: of (?:[\\w'-]+ ){0,2}?[\\w'-]+)? (?:failed|ran|took|were|was|had|showed|found|produced|returned|crashed|broke|timed out|succeeded|completed|finished|didn't|did not)\\b/;\n\nfunction namesLoopSubject(phrase: string, before: string, after: string): boolean {\n  if (LOOP_EDIT_LEAD.test(before) || LOOP_ARTIFACT_AFTER.test(after)) return true;\n  if (HYPHEN_COUNT.test(phrase) && !HYPHEN_COUNT_MEASURES_LOOP.test(after)) return true;\n  if (/iterations?$/.test(phrase) && ITERATIONS_OF_SUBJECT.test(after)) return true;\n  return COUNT_NOUN.test(phrase) && COUNT_AS_SUBJECT.test(after);\n}\n\n// Any one loop phrase that is neither refused nor the request's subject asks\n// for the run, so \"don't summarize it, run a deep review\" still asks.\nfunction hasLoopAsk(lowered: string): boolean {\n  for (const match of lowered.matchAll(LOOP_REQUEST_ALL)) {\n    const before = lowered.slice(0, match.index);\n    const after = lowered.slice(match.index + match[0].length);\n    if (RUN_ASK_NEGATED.test(before) || LOOP_ASK_REFUSED_AFTER.test(after)) continue;\n    if (namesLoopSubject(match[0], before, after)) continue;\n    return true;\n  }\n  return false;\n}\n\n// Loop wording also names a loop the reader is not asking to start: a past run\n// whose output they want read, a stuck run they want diagnosed, or a method they\n// want to write about. Both deep-loop offer paths read this one test, so the\n// routed mode and the deferred mode cannot disagree on what counts as the ask.\n// The want leads spell their contractions with a straight apostrophe, so a curly\n// one is folded first, and every exception below reads the folded text too.\nexport function asksForLoopRun(prompt: string): boolean {\n  const lowered = lowerFolded(prompt);\n  return hasLoopAsk(lowered)\n    && !isPastRunRead(lowered)\n    && !isStuckRunComplaint(lowered)\n    && !isWritingAboutTopic(lowered)\n    && !isLoopQuestion(lowered);\n}\n\n// A question about how the loop works names it the way a request to run it\n// does, as in \"how does the deep review decide it has converged\". It asks for\n// the run only when it also tells the loop to start or gives an iteration count.\n// A negated question, as in \"why doesn't my deep review converge\", asks about\n// the loop the same way. The loop has to be what the question is about, so\n// \"deep research: how do vector databases handle hybrid search\" still asks for\n// a run on that topic.\nconst LOOP_SUBJECT = '(?:[\\\\w\\'-]+ ){0,2}?(?:deep[- ](?:research|review|loop)|(?:research|review) loop)\\\\b';\n// \"How many\" asks about the loop's length, as in \"how many passes does the deep\n// review do\".\nconst LOOP_QUESTION = new RegExp(\n  `\\\\b(?:how|why|when|what) (?:does|do|is|are|did|makes|doesn't|don't|isn't|aren't|didn't|won't|can't) ${LOOP_SUBJECT}`\n  + `|\\\\bhow many (?:[\\\\w'-]+ ){0,2}?(?:does|do|is|are|did|will|would|should|can) ${LOOP_SUBJECT}`\n  + `|\\\\b(?:explain|describe) (?:how|what|why|when) ${LOOP_SUBJECT}`,\n);\n// Only a digit count turns the question back into a request. The spelled count\n// is left out on purpose, so a question about the loop that quotes one, as in\n// \"why does the deep review stop after ten iterations\", stays the question it\n// was before spelled counts were read as a loop ask. A question that names no\n// loop is not a loop question at all, so \"why does it stop after ten\n// iterations\" still reads its count as a request for a run.\nconst ITERATION_COUNT = /\\b\\d+ (?:[a-z-]+ ){0,2}iterations?\\b/;\n// A later clause that opens with a use verb on \"one\" or \"it\" asks for the loop\n// the question named, as in \"what is a deep review? run one on the parser\".\nconst LOOP_RUN_BY_PRONOUN = /(?:^|[,.;!?\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*(?:run|start|launch|do|kick off) (?:one|it|another)\\b/;\n\nfunction isLoopQuestion(lowered: string): boolean {\n  return LOOP_QUESTION.test(lowered)\n    && !LOOP_RUN_REQUESTED.test(lowered)\n    && !ITERATION_COUNT.test(lowered)\n    && !LOOP_RUN_BY_PRONOUN.test(lowered);\n}\n\n// `why not` proposes the command rather than refusing it, so the word refuses\n// only where no `why` stands before it.\nconst COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n\n// A command the reader refuses is named without being asked for, so this list\n// holds the leads that mark that naming. A lead must sit directly before the\n// command so a later clause cannot refuse an earlier request, and a gap holds\n// plain words only so a refusal before a comma cannot swallow the request after\n// it. A reader who stops using a command names it only to refuse it.\nexport const COMMAND_DECLINE_LEADS: readonly string[] = [\n  `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n  `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n];\n\n// A refusal or a question over an or-list covers every command the list joins,\n// while a second use verb opens a clause of its own, so the list joins only `or`\n// and `, or`. A listed command may carry `the` before it and\n// `command` after it, and the command after the last `or` may carry `the`. A\n// listed command may also carry one plain word after it, such as the subcommand a\n// doctor command takes, so `do not run /x now or /y` refuses both.\nconst COMMAND_OR_LIST = '(?:(?:the )?\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?: [a-z][a-z0-9_-]*)?(?: command)?,? or (?:the )?)*';\n\n// A command the reader asks about is named without being asked for, so this list\n// holds the leads that mark that naming. A lead must sit directly before the\n// command so a later clause cannot turn an earlier request into a question, and\n// a gap holds plain words only so a question before a comma cannot swallow the\n// request after it.\nexport const COMMAND_ASK_LEADS: readonly string[] = [\n  \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n  `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n];\n\n// A bare ask word opens a statement as often as a question, so it marks a naming\n// only when the command it precedes is followed by a question mark before the\n// sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n// A question often names the command after `the`, as in `is the /x command safe`.\nexport const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) (?:the )?';\n\n// A clause that opens with a use verb and `it` asks for the command an earlier\n// clause only named, so a naming such as `not run /x yet, please start it`\n// becomes a request. The clause has to open that way so `I will run it` stays a\n// statement.\nconst COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n\n// A refusal can come after the name, as in \"/create:readme is not what I want, do\n// not run it\" or \"run /doctor:git setup but do not actually run it\". The clause\n// opens a new sentence or follows \"but\", \"and\" or \"so\", and refuses \"it\" with a\n// use verb, so \"run /speckit:save and don't skip it\" stays a request. The refusal\n// has to end its clause, because \"don't run it twice\" or \"never run it without a\n// budget\" limits the run rather than refusing it.\nconst COMMAND_DECLINED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]|\\\\b(?:but|and|so|though)\\\\b) *(?:(?:please|just|then|still) )*(?:do not|don't|dont|never)(?: (?:actually|really|yet|ever|even))? ${COMMAND_USE_VERB} it(?: (?:yet|now|for now|at all|please))? *(?:$|[,.;!?\\\\n])`);\n\n// A command named as a document is read about, not run: \"read the /create:readme\n// document\", \"open the /deep:review command file\". The name needs a determiner\n// before it, because a typed request puts its argument there instead, as in\n// \"/create:diff file a.md b.md\". A naming followed by \"then\" goes on to ask for\n// work, as in \"read the /deep:review docs, then do a thorough review\", so it is","numLines":731,"startLine":1,"totalLines":942,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_017kmo8GwBPVsCwGTspnULex","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChM9LHYmgTK8BLnVmdBJy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MtwWcxWA2n4i2gguE2Wb6d","name":"Read","input":{"file_path":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","offset":731},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":39889,"cache_read_input_tokens":128073,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":39889},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:45:34.632Z","request_id":"<redacted>","wire_tool_inputs":{"toolu_01MtwWcxWA2n4i2gguE2Wb6d":{"file_path":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","offset":731}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MtwWcxWA2n4i2gguE2Wb6d","type":"tool_result","content":"731\t// work, as in \"read the /deep:review docs, then do a thorough review\", so it is\n732\t// not only a read.\n733\tconst COMMAND_AS_DOCUMENT = /^(?: command)?(?:'s)? (?:doc|docs|document|documentation|file|page|source|definition|markdown)\\b/;\n734\t\n735\t// A command whose policy is run acts without asking, so an unled naming of it is\n736\t// read as a request only on positive evidence: a use verb shortly before it, or\n737\t// the name opening the prompt or a sentence. \"no need for /doctor:deep-loop\"\n738\t// names no lead the lists know, and must not start the command on that alone.\n739\t// The words after the name can still take the request back or turn it into a\n740\t// question, as in \"/doctor:speckit, cancel that\" or \"/doctor:install - is it\n741\t// safe?\", so any of those after the name leaves the naming a mention.\n742\tconst RUN_COMMAND_WITHDRAWN = /\\?|\\b(?:not|don't|dont|never|cancel|scratch that|hold off|wait|undo|is it|should i|nevermind|never mind)\\b/;\n743\t\n744\tfunction runCommandRequested(before: string, after: string, name: string): boolean {\n745\t  if (RUN_COMMAND_WITHDRAWN.test(after)) return false;\n746\t  return new RegExp(`(?:^|[.!?;:\\\\n] *)(?:(?:please|now|just|then|and) )*${name}$`).test(before)\n747\t    || new RegExp(`\\\\b${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}(?:the )?${name}$`).test(before);\n748\t}\n749\t\n750\t// A prompt names a command to refuse it or to ask about it as often as it names\n751\t// one to run it, so an offer must read the naming before it trusts the name. The\n752\t// text is folded first, because a keyed apostrophe or a run of spaces must not\n753\t// hide the lead, while a line break survives as the sentence end it is. Inline\n754\t// code, bold, strike, brackets, parentheses, guillemets, primes and quote marks\n755\t// around a name are dropped for the same reason, so a refusal of a wrapped\n756\t// command reads as the plain refusal does. An underscore stays, because a\n757\t// command name may hold one. A single quote goes only where it\n758\t// opens or closes a command name, because the same mark is the apostrophe of a\n759\t// lead such as \"don't\" or \"what's\". A retired name is read beside the current\n760\t// one, because a reader who refuses the old spelling refuses the command it now\n761\t// maps to. The\n762\t// boundary before the lead keeps a command name from matching inside a word or a\n763\t// path, and the boundary after it keeps a longer command name from reading as the\n764\t// shorter one or a doc path such as `/create:readme.md` from reading as a naming.\n765\t// Every occurrence has to carry a lead, because one led naming does not turn a\n766\t// later unled naming into a request.\n767\texport function commandOnlyMentioned(prompt: string, command: string): boolean {\n768\t  const text = prompt\n769\t    .toLowerCase()\n770\t    .replace(/<\\/?(?:code|kbd|samp|tt)>/g, '')\n771\t    .replace(/[`*\"\\u201c\\u201d[\\]()~\\u00ab\\u00bb\\u2032\\u2039\\u203a]/g, '')\n772\t    .replace(/[\\u2018\\u2019]/g, \"'\")\n773\t    .replace(/(^|[^a-z0-9])'(?=\\/[a-z])/g, '$1')\n774\t    .replace(/(\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)*(?: [a-z][a-z0-9_-]*)?)'(?![a-z0-9])/g, '$1')\n775\t    .replace(/[^\\S\\n]+/g, ' ')\n776\t    .replace(/ *\\n\\s*/g, '\\n');\n777\t  const current = command.toLowerCase();\n778\t  const spellings = [current, ...Object.keys(RETIRED_COMMANDS).filter((retired) => RETIRED_COMMANDS[retired] === current)]\n779\t    .sort((left, right) => right.length - left.length);\n780\t  const name = `(?:${spellings.map(escapePhrase).join('|')})`;\n781\t  const runsWithoutAsking = TRACKED_COMMANDS[current]?.policy === 'run';\n782\t  const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-]|[./][a-z0-9])`, 'g'))];\n783\t  if (occurrences.length === 0) return false;\n784\t  return occurrences.every((occurrence) => {\n785\t    const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n786\t    const before = text.slice(0, nameEnd);\n787\t    const tail = text.slice(nameEnd);\n788\t    const clause = tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0];\n789\t    if (COMMAND_DECLINED_BY_PRONOUN.test(clause)) return true;\n790\t    if (COMMAND_ASKED_BY_PRONOUN.test(clause)) return false;\n791\t    if (COMMAND_AS_DOCUMENT.test(tail) && !/\\bthen\\b/.test(clause)\n792\t      && new RegExp(`\\\\b(?:the|this|that) ${name}$`).test(before)) return true;\n793\t    const led = COMMAND_DECLINE_LEADS.some((lead) => (\n794\t      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n795\t    )) || COMMAND_ASK_LEADS.some((lead) => (\n796\t      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n797\t    ));\n798\t    if (led) return true;\n799\t    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n800\t    if (!bareLead) return runsWithoutAsking && !runCommandRequested(before, tail, name);\n801\t    const sentenceEnd = tail.search(/[.!\\n]/);\n802\t    const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n803\t    // A chat question often leaves the question mark off, so a bare ask word that\n804\t    // opens a sentence still asks about the command.\n805\t    return sentence.includes('?')\n806\t      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n807\t  });\n808\t}\n809\t\n810\t// A compiled route arrives as unvalidated JSON from a separate process, so the\n811\t// shape is narrowed here rather than trusted. Arrays count as objects in\n812\t// JavaScript and would let `action` read off an unrelated field, so they are\n813\t// excluded explicitly.\n814\tfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n815\t  if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n816\t  return value as Record<string, unknown>;\n817\t}\n818\t\n819\t// The command for a hub's recommendation, or undefined when the route does not\n820\t// single out one mode. Only a single-mode route names a command unambiguously:\n821\t// a bundle or a multi-target route has more than one answer, and asking the\n822\t// reader to pick belongs to the recommend path, not here. Never throws, because\n823\t// a missing command must degrade to \"no command offered\" rather than break\n824\t// routing. The prompt decides whether a costly deep-loop command is offered at\n825\t// all: a reader who only asks about the topic gets no command, rather than one\n826\t// that would launch work they never requested.\n827\texport function attachCommand(\n828\t  skillId: string,\n829\t  compiledRoute: unknown,\n830\t  prompt: string,\n831\t  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n832\t): string | undefined {\n833\t  const route = asRecord(compiledRoute);\n834\t  if (!route) return undefined;\n835\t  // A complaint about a stuck run is answered by the hub's own diagnosis command,\n836\t  // whichever mode the route picked, because a new run would repeat the fault.\n837\t  if (skillId === 'system-deep-loop' && isStuckRunComplaint(prompt)) {\n838\t    return isNoEditRequest(prompt) || commandOnlyMentioned(prompt, DEEP_LOOP_DOCTOR_COMMAND)\n839\t      ? undefined\n840\t      : DEEP_LOOP_DOCTOR_COMMAND;\n841\t  }\n842\t  if (skillId === 'system-deep-loop' && (route.action === 'defer' || route.action === 'clarify')) {\n843\t    return deferredLoopCommand(skillId, prompt, modeCommands);\n844\t  }\n845\t  if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n846\t\n847\t  const targets = route.targets;\n848\t  if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n849\t\n850\t  const onlyTarget = asRecord(targets[0]);\n851\t  if (!onlyTarget) return undefined;\n852\t\n853\t  const workflowMode = onlyTarget.workflowMode;\n854\t  if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n855\t\n856\t  // A reader who rules out a change gets no command from either path, so the hub\n857\t  // route never offers what the scorer already withholds.\n858\t  if (isNoEditRequest(prompt)) return undefined;\n859\t\n860\t  // Own-key lookup on both levels: the table is data read from a generated\n861\t  // object, so an inherited name such as `constructor` must not resolve to a\n862\t  // command the hub never declared.\n863\t  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n864\t  const commands = modeCommands[skillId];\n865\t  if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n866\t\n867\t  // A route can pick the mode because the prompt named its command, so a naming\n868\t  // that refused or asked about the command must not produce the offer.\n869\t  if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n870\t\n871\t  // A correction inside one document is not a request for a creation workflow,\n872\t  // which scaffolds, reviews and validates a whole one.\n873\t  if (\n874\t    SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n875\t    && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n876\t    && !CREATION_REQUEST.test(prompt.toLowerCase())\n877\t    && CORRECTION_VERB.test(prompt.toLowerCase())\n878\t  ) return undefined;\n879\t\n880\t  // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n881\t  // run, so they are offered only when the prompt asks for the loop itself.\n882\t  // Typing the command being attached is itself the ask, while typing another\n883\t  // deep-loop command asks for that command, not this one. Every other hub\n884\t  // answers a short question with a short answer, so no other skill consults the\n885\t  // wording list.\n886\t  if (skillId === 'system-deep-loop') {\n887\t    const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n888\t    if (!typesThisCommand && !asksForLoopRun(prompt)) return undefined;\n889\t  }\n890\t\n891\t  return commands[workflowMode];\n892\t}\n893\t\n894\t// The hub's router reads fixed phrases, so it defers on \"run 8 more review\n895\t// iterations\" though the prompt asks for the loop and names one mode. A loop\n896\t// request with exactly one mode cue names that mode as surely as a router\n897\t// phrase does, while a cue for both modes or for neither leaves the choice to\n898\t// the reader. The refusal and mention guards apply here as on a routed mode.\n899\tfunction deferredLoopCommand(\n900\t  skillId: string,\n901\t  prompt: string,\n902\t  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>>,\n903\t): string | undefined {\n904\t  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n905\t  const lowered = prompt.toLowerCase();\n906\t  if (!asksForLoopRun(prompt) || isNoEditRequest(prompt)) return undefined;\n907\t  const commands = modeCommands[skillId];\n908\t  const named = new Set([...lowered.matchAll(NAMED_LOOP_MODE)].map((match) => (\n909\t    (match[1] ?? match[2]) === 'research' ? 'research' : 'review'\n910\t  )));\n911\t  const cued = named.size === 1\n912\t    ? [...named].filter((mode) => Object.prototype.hasOwnProperty.call(commands, mode))\n913\t    : Object.keys(MODE_CUES).filter((mode) => (\n914\t      MODE_CUES[mode].test(lowered) && Object.prototype.hasOwnProperty.call(commands, mode)\n915\t    ));\n916\t  if (cued.length !== 1) return undefined;\n917\t  const command = commands[cued[0]];\n918\t  return commandOnlyMentioned(prompt, command) ? undefined : command;\n919\t}\n920\t\n921\t// A mode word that qualifies the loop's own unit names the mode outright, as in\n922\t// \"run 5 research iterations on review tooling\", where \"review\" is the topic.\n923\t// One such name settles the mode before the looser topic cues are counted.\n924\tconst NAMED_LOOP_MODE = /\\b(?:deep[- ](research|review)|(research|review|audit)[- ](?:loop|iterations?|passes|rounds|runs?))\\b/g;\n925\t\n926\t// A hub that withholds its command because the prompt names no single mode must\n927\t// still tell the reader why no command came with it, and only a hub whose modes\n928\t// map to commands withholds one. A hub that tops a prompt which never named it\n929\t// is the scorer's guess, so the label would point at modes the reader did not\n930\t// ask about.\n931\texport function routeNeedsMode(\n932\t  skillId: string,\n933\t  compiledRoute: unknown,\n934\t  namedSkills: readonly string[],\n935\t): boolean {\n936\t  if (!namedSkills.includes(skillId)) return false;\n937\t  const route = asRecord(compiledRoute);\n938\t  if (!route) return false;\n939\t  if (route.action !== 'defer' && route.action !== 'clarify') return false;\n940\t  return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n941\t}\n942\t"}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:45:34.723Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","content":"// work, as in \"read the /deep:review docs, then do a thorough review\", so it is\n// not only a read.\nconst COMMAND_AS_DOCUMENT = /^(?: command)?(?:'s)? (?:doc|docs|document|documentation|file|page|source|definition|markdown)\\b/;\n\n// A command whose policy is run acts without asking, so an unled naming of it is\n// read as a request only on positive evidence: a use verb shortly before it, or\n// the name opening the prompt or a sentence. \"no need for /doctor:deep-loop\"\n// names no lead the lists know, and must not start the command on that alone.\n// The words after the name can still take the request back or turn it into a\n// question, as in \"/doctor:speckit, cancel that\" or \"/doctor:install - is it\n// safe?\", so any of those after the name leaves the naming a mention.\nconst RUN_COMMAND_WITHDRAWN = /\\?|\\b(?:not|don't|dont|never|cancel|scratch that|hold off|wait|undo|is it|should i|nevermind|never mind)\\b/;\n\nfunction runCommandRequested(before: string, after: string, name: string): boolean {\n  if (RUN_COMMAND_WITHDRAWN.test(after)) return false;\n  return new RegExp(`(?:^|[.!?;:\\\\n] *)(?:(?:please|now|just|then|and) )*${name}$`).test(before)\n    || new RegExp(`\\\\b${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}(?:the )?${name}$`).test(before);\n}\n\n// A prompt names a command to refuse it or to ask about it as often as it names\n// one to run it, so an offer must read the naming before it trusts the name. The\n// text is folded first, because a keyed apostrophe or a run of spaces must not\n// hide the lead, while a line break survives as the sentence end it is. Inline\n// code, bold, strike, brackets, parentheses, guillemets, primes and quote marks\n// around a name are dropped for the same reason, so a refusal of a wrapped\n// command reads as the plain refusal does. An underscore stays, because a\n// command name may hold one. A single quote goes only where it\n// opens or closes a command name, because the same mark is the apostrophe of a\n// lead such as \"don't\" or \"what's\". A retired name is read beside the current\n// one, because a reader who refuses the old spelling refuses the command it now\n// maps to. The\n// boundary before the lead keeps a command name from matching inside a word or a\n// path, and the boundary after it keeps a longer command name from reading as the\n// shorter one or a doc path such as `/create:readme.md` from reading as a naming.\n// Every occurrence has to carry a lead, because one led naming does not turn a\n// later unled naming into a request.\nexport function commandOnlyMentioned(prompt: string, command: string): boolean {\n  const text = prompt\n    .toLowerCase()\n    .replace(/<\\/?(?:code|kbd|samp|tt)>/g, '')\n    .replace(/[`*\"\\u201c\\u201d[\\]()~\\u00ab\\u00bb\\u2032\\u2039\\u203a]/g, '')\n    .replace(/[\\u2018\\u2019]/g, \"'\")\n    .replace(/(^|[^a-z0-9])'(?=\\/[a-z])/g, '$1')\n    .replace(/(\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)*(?: [a-z][a-z0-9_-]*)?)'(?![a-z0-9])/g, '$1')\n    .replace(/[^\\S\\n]+/g, ' ')\n    .replace(/ *\\n\\s*/g, '\\n');\n  const current = command.toLowerCase();\n  const spellings = [current, ...Object.keys(RETIRED_COMMANDS).filter((retired) => RETIRED_COMMANDS[retired] === current)]\n    .sort((left, right) => right.length - left.length);\n  const name = `(?:${spellings.map(escapePhrase).join('|')})`;\n  const runsWithoutAsking = TRACKED_COMMANDS[current]?.policy === 'run';\n  const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-]|[./][a-z0-9])`, 'g'))];\n  if (occurrences.length === 0) return false;\n  return occurrences.every((occurrence) => {\n    const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n    const before = text.slice(0, nameEnd);\n    const tail = text.slice(nameEnd);\n    const clause = tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0];\n    if (COMMAND_DECLINED_BY_PRONOUN.test(clause)) return true;\n    if (COMMAND_ASKED_BY_PRONOUN.test(clause)) return false;\n    if (COMMAND_AS_DOCUMENT.test(tail) && !/\\bthen\\b/.test(clause)\n      && new RegExp(`\\\\b(?:the|this|that) ${name}$`).test(before)) return true;\n    const led = COMMAND_DECLINE_LEADS.some((lead) => (\n      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n    )) || COMMAND_ASK_LEADS.some((lead) => (\n      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n    ));\n    if (led) return true;\n    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n    if (!bareLead) return runsWithoutAsking && !runCommandRequested(before, tail, name);\n    const sentenceEnd = tail.search(/[.!\\n]/);\n    const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n    // A chat question often leaves the question mark off, so a bare ask word that\n    // opens a sentence still asks about the command.\n    return sentence.includes('?')\n      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n  });\n}\n\n// A compiled route arrives as unvalidated JSON from a separate process, so the\n// shape is narrowed here rather than trusted. Arrays count as objects in\n// JavaScript and would let `action` read off an unrelated field, so they are\n// excluded explicitly.\nfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n  if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n  return value as Record<string, unknown>;\n}\n\n// The command for a hub's recommendation, or undefined when the route does not\n// single out one mode. Only a single-mode route names a command unambiguously:\n// a bundle or a multi-target route has more than one answer, and asking the\n// reader to pick belongs to the recommend path, not here. Never throws, because\n// a missing command must degrade to \"no command offered\" rather than break\n// routing. The prompt decides whether a costly deep-loop command is offered at\n// all: a reader who only asks about the topic gets no command, rather than one\n// that would launch work they never requested.\nexport function attachCommand(\n  skillId: string,\n  compiledRoute: unknown,\n  prompt: string,\n  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n): string | undefined {\n  const route = asRecord(compiledRoute);\n  if (!route) return undefined;\n  // A complaint about a stuck run is answered by the hub's own diagnosis command,\n  // whichever mode the route picked, because a new run would repeat the fault.\n  if (skillId === 'system-deep-loop' && isStuckRunComplaint(prompt)) {\n    return isNoEditRequest(prompt) || commandOnlyMentioned(prompt, DEEP_LOOP_DOCTOR_COMMAND)\n      ? undefined\n      : DEEP_LOOP_DOCTOR_COMMAND;\n  }\n  if (skillId === 'system-deep-loop' && (route.action === 'defer' || route.action === 'clarify')) {\n    return deferredLoopCommand(skillId, prompt, modeCommands);\n  }\n  if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n\n  const targets = route.targets;\n  if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n\n  const onlyTarget = asRecord(targets[0]);\n  if (!onlyTarget) return undefined;\n\n  const workflowMode = onlyTarget.workflowMode;\n  if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n\n  // A reader who rules out a change gets no command from either path, so the hub\n  // route never offers what the scorer already withholds.\n  if (isNoEditRequest(prompt)) return undefined;\n\n  // Own-key lookup on both levels: the table is data read from a generated\n  // object, so an inherited name such as `constructor` must not resolve to a\n  // command the hub never declared.\n  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n  const commands = modeCommands[skillId];\n  if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n\n  // A route can pick the mode because the prompt named its command, so a naming\n  // that refused or asked about the command must not produce the offer.\n  if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n\n  // A correction inside one document is not a request for a creation workflow,\n  // which scaffolds, reviews and validates a whole one.\n  if (\n    SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n    && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n    && !CREATION_REQUEST.test(prompt.toLowerCase())\n    && CORRECTION_VERB.test(prompt.toLowerCase())\n  ) return undefined;\n\n  // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n  // run, so they are offered only when the prompt asks for the loop itself.\n  // Typing the command being attached is itself the ask, while typing another\n  // deep-loop command asks for that command, not this one. Every other hub\n  // answers a short question with a short answer, so no other skill consults the\n  // wording list.\n  if (skillId === 'system-deep-loop') {\n    const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n    if (!typesThisCommand && !asksForLoopRun(prompt)) return undefined;\n  }\n\n  return commands[workflowMode];\n}\n\n// The hub's router reads fixed phrases, so it defers on \"run 8 more review\n// iterations\" though the prompt asks for the loop and names one mode. A loop\n// request with exactly one mode cue names that mode as surely as a router\n// phrase does, while a cue for both modes or for neither leaves the choice to\n// the reader. The refusal and mention guards apply here as on a routed mode.\nfunction deferredLoopCommand(\n  skillId: string,\n  prompt: string,\n  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>>,\n): string | undefined {\n  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n  const lowered = prompt.toLowerCase();\n  if (!asksForLoopRun(prompt) || isNoEditRequest(prompt)) return undefined;\n  const commands = modeCommands[skillId];\n  const named = new Set([...lowered.matchAll(NAMED_LOOP_MODE)].map((match) => (\n    (match[1] ?? match[2]) === 'research' ? 'research' : 'review'\n  )));\n  const cued = named.size === 1\n    ? [...named].filter((mode) => Object.prototype.hasOwnProperty.call(commands, mode))\n    : Object.keys(MODE_CUES).filter((mode) => (\n      MODE_CUES[mode].test(lowered) && Object.prototype.hasOwnProperty.call(commands, mode)\n    ));\n  if (cued.length !== 1) return undefined;\n  const command = commands[cued[0]];\n  return commandOnlyMentioned(prompt, command) ? undefined : command;\n}\n\n// A mode word that qualifies the loop's own unit names the mode outright, as in\n// \"run 5 research iterations on review tooling\", where \"review\" is the topic.\n// One such name settles the mode before the looser topic cues are counted.\nconst NAMED_LOOP_MODE = /\\b(?:deep[- ](research|review)|(research|review|audit)[- ](?:loop|iterations?|passes|rounds|runs?))\\b/g;\n\n// A hub that withholds its command because the prompt names no single mode must\n// still tell the reader why no command came with it, and only a hub whose modes\n// map to commands withholds one. A hub that tops a prompt which never named it\n// is the scorer's guess, so the label would point at modes the reader did not\n// ask about.\nexport function routeNeedsMode(\n  skillId: string,\n  compiledRoute: unknown,\n  namedSkills: readonly string[],\n): boolean {\n  if (!namedSkills.includes(skillId)) return false;\n  const route = asRecord(compiledRoute);\n  if (!route) return false;\n  if (route.action !== 'defer' && route.action !== 'clarify') return false;\n  return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n}\n","numLines":212,"startLine":731,"totalLines":942}},"tool_result_meta":[{"id":"toolu_01MtwWcxWA2n4i2gguE2Wb6d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
