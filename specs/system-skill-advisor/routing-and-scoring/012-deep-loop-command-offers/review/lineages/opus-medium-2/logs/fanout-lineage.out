{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PdjMDhJE11FpfaCbd9953X","type":"tool_result","content":"    confidence_threshold: float = 0.8,\n    uncertainty_threshold: float = 0.35,\n    confidence_only: bool = False,\n) -> Optional[List[Dict[str, Any]]]:\n    \"\"\"Return native recommendations when the compiled advisor runtime is available.\"\"\"\n    # Drop a pasted earlier reply before the head cut and the routing layers below,\n    # so a long paste cannot push the task past the cut or steer the layers.\n    prompt = strip_leading_pasted_reply(prompt)\n    response = _run_native_bridge({\n        \"mode\": \"recommend\",\n        \"workspaceRoot\": REPO_ROOT,\n        \"prompt\": _advisor_prompt_head(prompt),\n        \"topK\": 10,\n        \"confidenceThreshold\": confidence_threshold,\n        \"uncertaintyThreshold\": 1.0 if confidence_only else uncertainty_threshold,\n    })\ndef analyze_request(prompt: str) -> List[Dict[str, Any]]:\n    \"\"\"Analyze user request and return ranked skill recommendations.\n\n    Args:\n        prompt: The user request text.\n    \"\"\"\n    if not prompt:\n        return []\n\n    prompt = strip_leading_pasted_reply(prompt)\n    prompt_lower = prompt.lower()\n    all_tokens = re.findall(r'\\b\\w+\\b', _strip_command_mode_suffixes(prompt_lower))\n    skills = get_skills()\n    explicit_command_intent = detect_explicit_command_intent(prompt_lower)\n\n    # Intent boosts calculated BEFORE stop word filtering - question words (how, why, what)\n    # are important signals for semantic search but would otherwise be filtered\n1068:        prompt_lower = prompt.lower()\n3627:    prompt_lower = prompt.lower()\n3707:    prompt_lower = prompt.lower()\n4396:    prompt_lower = _mask_runtime_surfaces(\n5306:    prompt_lower = prompt.lower()\n5317:        prompt_lower=prompt_lower,\n9:  printf '%s' \"how does authentication work\" | python skill_advisor.py --stdin\n12:  python skill_advisor.py --batch-file pro