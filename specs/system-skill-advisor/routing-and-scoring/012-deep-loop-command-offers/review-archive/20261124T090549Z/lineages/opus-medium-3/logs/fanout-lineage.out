{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011u35DZJ3RVUy9wUzuqxzPG","type":"tool_result","content":"195\t// The deep-loop hub owns one diagnosis command besides its two run commands.\n196\tconst DEEP_LOOP_DOCTOR_COMMAND = '/doctor:deep-loop';\n197\t\n198\t// A typed command is the reader's own wording, so it counts only where a command\n199\t// can start and where it ends on a boundary. That keeps a path such as\n200\t// `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n201\t// command, and the longest key wins so `/group:name-parent` is never reduced to\n202\t// its `/group:name` prefix. A dot or a slash followed by a word character\n203\t// continues a file name or a path, while a sentence-ending period does not.\n204\t// A mode suffix and a `:with-*` modifier end the command name the way a space\n205\t// does, after any tracked command. The argument hints say which commands take\n206\t// which, but a modifier typed on a command that does not take it still names\n207\t// that command. The hints chain them, as in `:auto:with-research`, so a run of\n208\t// them counts as one suffix.\n209\tconst COMMAND_START_BOUNDARY = /[\\s`'\"(*[~>\\u201c\\u2018\\u00ab\\u2032\\u2039]/;\n210\tconst COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n211\tconst WORD_CHARACTER = /[a-z0-9_]/;\n212\tconst MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n213\t\n214\t// A command that was renamed is still typed from habit. Its old name reads as\n215\t// the command that replaced it, so the reader lands on the live workflow and\n216\t// not on whatever skill the leftover words happen to score for. The old name\n217\t// gets no command file of its own: this table is the only place it lives.\n218\tconst RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n219\t  '/create:skill': '/create:sk-skill',\n220\t};\n221\t\n222\texport function typedCommandIn(prompt: string): string | undefined {\n223\t  const lowered = prompt.toLowerCase();\n224\t  let found: string | undefined;\n225\t  for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n226\t    let index = lowered.indexOf(key);\n227\t    while (index !== -1) {\n228\t      const before = index === 0 ? '' : lowered[index - 1];\n229\t      const after = lowered[index + key.length] ?? '';\n230\t      const next = lowered[index + key.length + 1] ?? '';\n231\t      const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n232\t      const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n233\t      const continuesName =\n234\t        !hasModeSuffix\n235\t        && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n236\t      const endsAtBoundary = after === '' || !continuesName;\n237\t      if (startsAtBoundary && endsAtBoundary) {\n238\t        if (found === undefined || key.length > found.length) found = key;\n239\t        break;\n240\t      }\n241\t      index = lowered.indexOf(key, index + 1);\n242\t    }\n243\t  }\n244\t  if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n245\t  return found;\n246\t}\n247\t\n248\t// A typed command travels on the recommendation that leads, so it is delivered\n249\t// only when the leading skill owns the command or carries the same command row.\n250\t// A leading skill unrelated to the command must not carry it.\n251\texport interface TypedCommand {\n252\t  readonly command: string;\n253\t  readonly policy: 'run' | 'start' | 'ask';\n254\t  readonly ownerSkillId: string;\n255\t}\n256\t\n257\texport function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n258\t  const command = typedCommandIn(prompt);\n259\t  if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n260\t  if (commandOnlyMentioned(prompt, command)) return undefined;\n261\t  const row = TRACKED_COMMANDS[command];\n262\t  const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n263\t  if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n264\t  return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n265\t}\n266\t\n267\t// Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n268\t// that merely mentions the topic spends the reader's budget on work they never\n269\t// asked for. The list below is the vocabulary that counts as asking for it, and\n270\t// it names the loop itself: a deep loop by name, iterations, or more than one\n271\t// pass. Depth wording such as `thorough` or `in depth` asks for care inside a\n272\t// single pass, and a bare topic word such as `research` or `review` says what\n273\t// to look at, so neither qualifies on its own.\n274\t//\n275\t// The phrases live in a data list, one per line, so the vocabulary a reviewer\n276\t// has to judge stays visible and cheap to correct.\n277\texport const LOOP_WORDING: readonly string[] = [\n278\t  'deep research',\n279\t  'deep-research',\n280\t  'deep review',\n281\t  'deep-review',\n282\t  'multi-pass',\n283\t];\n284\t"}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:45:47.780Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","content":"// The deep-loop hub owns one diagnosis command besides its two run commands.\nconst DEEP_LOOP_DOCTOR_COMMAND = '/doctor:deep-loop';\n\n// A typed command is the reader's own wording, so it counts only where a command\n// can start and where it ends on a boundary. That keeps a path such as\n// `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n// command, and the longest key wins so `/group:name-parent` is never reduced to\n// its `/group:name` prefix. A dot or a slash followed by a word character\n// continues a file name or a path, while a sentence-ending period does not.\n// A mode suffix and a `:with-*` modifier end the command name the way a space\n// does, after any tracked command. The argument hints say which commands take\n// which, but a modifier typed on a command that does not take it still names\n// that command. The hints chain them, as in `:auto:with-research`, so a run of\n// them counts as one suffix.\nconst COMMAND_START_BOUNDARY = /[\\s`'\"(*[~>\\u201c\\u2018\\u00ab\\u2032\\u2039]/;\nconst COMMAND_CONTINUATION = /[a-z0-9_:-]/;\nconst WORD_CHARACTER = /[a-z0-9_]/;\nconst MODE_SUFFIX = /^(?::(?:auto|confirm|autopilot|unattended|with-(?:context|phases|research)))+(?![a-z0-9_:-])/;\n\n// A command that was renamed is still typed from habit. Its old name reads as\n// the command that replaced it, so the reader lands on the live workflow and\n// not on whatever skill the leftover words happen to score for. The old name\n// gets no command file of its own: this table is the only place it lives.\nconst RETIRED_COMMANDS: Readonly<Record<string, string>> = {\n  '/create:skill': '/create:sk-skill',\n};\n\nexport function typedCommandIn(prompt: string): string | undefined {\n  const lowered = prompt.toLowerCase();\n  let found: string | undefined;\n  for (const key of [...Object.keys(TRACKED_COMMANDS), ...Object.keys(RETIRED_COMMANDS)]) {\n    let index = lowered.indexOf(key);\n    while (index !== -1) {\n      const before = index === 0 ? '' : lowered[index - 1];\n      const after = lowered[index + key.length] ?? '';\n      const next = lowered[index + key.length + 1] ?? '';\n      const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n      const hasModeSuffix = MODE_SUFFIX.test(lowered.slice(index + key.length));\n      const continuesName =\n        !hasModeSuffix\n        && (COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next)));\n      const endsAtBoundary = after === '' || !continuesName;\n      if (startsAtBoundary && endsAtBoundary) {\n        if (found === undefined || key.length > found.length) found = key;\n        break;\n      }\n      index = lowered.indexOf(key, index + 1);\n    }\n  }\n  if (found !== undefined && Object.hasOwn(RETIRED_COMMANDS, found)) return RETIRED_COMMANDS[found];\n  return found;\n}\n\n// A typed command travels on the recommendation that leads, so it is delivered\n// only when the leading skill owns the command or carries the same command row.\n// A leading skill unrelated to the command must not carry it.\nexport interface TypedCommand {\n  readonly command: string;\n  readonly policy: 'run' | 'start' | 'ask';\n  readonly ownerSkillId: string;\n}\n\nexport function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n  const command = typedCommandIn(prompt);\n  if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n  if (commandOnlyMentioned(prompt, command)) return undefined;\n  const row = TRACKED_COMMANDS[command];\n  const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n  if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n  return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n}\n\n// Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n// that merely mentions the topic spends the reader's budget on work they never\n// asked for. The list below is the vocabulary that counts as asking for it, and\n// it names the loop itself: a deep loop by name, iterations, or more than one\n// pass. Depth wording such as `thorough` or `in depth` asks for care inside a\n// single pass, and a bare topic word such as `research` or `review` says what\n// to look at, so neither qualifies on its own.\n//\n// The phrases live in a data list, one per line, so the vocabulary a reviewer\n// has to judge stays visible and cheap to correct.\nexport const LOOP_WORDING: readonly string[] = [\n  'deep research',\n  'deep-research',\n  'deep review',\n  'deep-review',\n  'multi-pass',\n];\n","numLines":90,"startLine":195,"totalLines":942}},"tool_result_meta":[{"id":"toolu_011u35DZJ3RVUy9wUzuqxzPG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChM9MGw5p2BPCccERWwP1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WKTdna26BR9vN1YXikhBhj","name":"Read","input":{"file_path":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","offset":610,"limit":332},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6779,"cache_read_input_tokens":139888,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6779},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:45:48.164Z","request_id":"<redacted>","wire_tool_inputs":{"toolu_01WKTdna26BR9vN1YXikhBhj":{"file_path":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","offset":610,"limit":332}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WKTdna26BR9vN1YXikhBhj","type":"tool_result","content":"610\t  if (/iterations?$/.test(phrase) && ITERATIONS_OF_SUBJECT.test(after)) return true;\n611\t  return COUNT_NOUN.test(phrase) && COUNT_AS_SUBJECT.test(after);\n612\t}\n613\t\n614\t// Any one loop phrase that is neither refused nor the request's subject asks\n615\t// for the run, so \"don't summarize it, run a deep review\" still asks.\n616\tfunction hasLoopAsk(lowered: string): boolean {\n617\t  for (const match of lowered.matchAll(LOOP_REQUEST_ALL)) {\n618\t    const before = lowered.slice(0, match.index);\n619\t    const after = lowered.slice(match.index + match[0].length);\n620\t    if (RUN_ASK_NEGATED.test(before) || LOOP_ASK_REFUSED_AFTER.test(after)) continue;\n621\t    if (namesLoopSubject(match[0], before, after)) continue;\n622\t    return true;\n623\t  }\n624\t  return false;\n625\t}\n626\t\n627\t// Loop wording also names a loop the reader is not asking to start: a past run\n628\t// whose output they want read, a stuck run they want diagnosed, or a method they\n629\t// want to write about. Both deep-loop offer paths read this one test, so the\n630\t// routed mode and the deferred mode cannot disagree on what counts as the ask.\n631\t// The want leads spell their contractions with a straight apostrophe, so a curly\n632\t// one is folded first, and every exception below reads the folded text too.\n633\texport function asksForLoopRun(prompt: string): boolean {\n634\t  const lowered = lowerFolded(prompt);\n635\t  return hasLoopAsk(lowered)\n636\t    && !isPastRunRead(lowered)\n637\t    && !isStuckRunComplaint(lowered)\n638\t    && !isWritingAboutTopic(lowered)\n639\t    && !isLoopQuestion(lowered);\n640\t}\n641\t\n642\t// A question about how the loop works names it the way a request to run it\n643\t// does, as in \"how does the deep review decide it has converged\". It asks for\n644\t// the run only when it also tells the loop to start or gives an iteration count.\n645\t// A negated question, as in \"why doesn't my deep review converge\", asks about\n646\t// the loop the same way. The loop has to be what the question is about, so\n647\t// \"deep research: how do vector databases handle hybrid search\" still asks for\n648\t// a run on that topic.\n649\tconst LOOP_SUBJECT = '(?:[\\\\w\\'-]+ ){0,2}?(?:deep[- ](?:research|review|loop)|(?:research|review) loop)\\\\b';\n650\t// \"How many\" asks about the loop's length, as in \"how many passes does the deep\n651\t// review do\".\n652\tconst LOOP_QUESTION = new RegExp(\n653\t  `\\\\b(?:how|why|when|what) (?:does|do|is|are|did|makes|doesn't|don't|isn't|aren't|didn't|won't|can't) ${LOOP_SUBJECT}`\n654\t  + `|\\\\bhow many (?:[\\\\w'-]+ ){0,2}?(?:does|do|is|are|did|will|would|should|can) ${LOOP_SUBJECT}`\n655\t  + `|\\\\b(?:explain|describe) (?:how|what|why|when) ${LOOP_SUBJECT}`,\n656\t);\n657\t// Only a digit count turns the question back into a request. The spelled count\n658\t// is left out on purpose, so a question about the loop that quotes one, as in\n659\t// \"why does the deep review stop after ten iterations\", stays the question it\n660\t// was before spelled counts were read as a loop ask. A question that names no\n661\t// loop is not a loop question at all, so \"why does it stop after ten\n662\t// iterations\" still reads its count as a request for a run.\n663\tconst ITERATION_COUNT = /\\b\\d+ (?:[a-z-]+ ){0,2}iterations?\\b/;\n664\t// A later clause that opens with a use verb on \"one\" or \"it\" asks for the loop\n665\t// the question named, as in \"what is a deep review? run one on the parser\".\n666\tconst LOOP_RUN_BY_PRONOUN = /(?:^|[,.;!?\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*(?:run|start|launch|do|kick off) (?:one|it|another)\\b/;\n667\t\n668\tfunction isLoopQuestion(lowered: string): boolean {\n669\t  return LOOP_QUESTION.test(lowered)\n670\t    && !LOOP_RUN_REQUESTED.test(lowered)\n671\t    && !ITERATION_COUNT.test(lowered)\n672\t    && !LOOP_RUN_BY_PRONOUN.test(lowered);\n673\t}\n674\t\n675\t// `why not` proposes the command rather than refusing it, so the word refuses\n676\t// only where no `why` stands before it.\n677\tconst COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n678\t\n679\t// A command the reader refuses is named without being asked for, so this list\n680\t// holds the leads that mark that naming. A lead must sit directly before the\n681\t// command so a later clause cannot refuse an earlier request, and a gap holds\n682\t// plain words only so a refusal before a comma cannot swallow the request after\n683\t// it. A reader who stops using a command names it only to refuse it.\n684\texport const COMMAND_DECLINE_LEADS: readonly string[] = [\n685\t  `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n686\t  `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n687\t];\n688\t\n689\t// A refusal or a question over an or-list covers every command the list joins,\n690\t// while a second use verb opens a clause of its own, so the list joins only `or`\n691\t// and `, or`. A listed command may carry `the` before it and\n692\t// `command` after it, and the command after the last `or` may carry `the`. A\n693\t// listed command may also carry one plain word after it, such as the subcommand a\n694\t// doctor command takes, so `do not run /x now or /y` refuses both.\n695\tconst COMMAND_OR_LIST = '(?:(?:the )?\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?: [a-z][a-z0-9_-]*)?(?: command)?,? or (?:the )?)*';\n696\t\n697\t// A command the reader asks about is named without being asked for, so this list\n698\t// holds the leads that mark that naming. A lead must sit directly before the\n699\t// command so a later clause cannot turn an earlier request into a question, and\n700\t// a gap holds plain words only so a question before a comma cannot swallow the\n701\t// request after it.\n702\texport const COMMAND_ASK_LEADS: readonly string[] = [\n703\t  \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n704\t  `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n705\t];\n706\t\n707\t// A bare ask word opens a statement as often as a question, so it marks a naming\n708\t// only when the command it precedes is followed by a question mark before the\n709\t// sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n710\t// A question often names the command after `the`, as in `is the /x command safe`.\n711\texport const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) (?:the )?';\n712\t\n713\t// A clause that opens with a use verb and `it` asks for the command an earlier\n714\t// clause only named, so a naming such as `not run /x yet, please start it`\n715\t// becomes a request. The clause has to open that way so `I will run it` stays a\n716\t// statement.\n717\tconst COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n718\t\n719\t// A refusal can come after the name, as in \"/create:readme is not what I want, do\n720\t// not run it\" or \"run /doctor:git setup but do not actually run it\". The clause\n721\t// opens a new sentence or follows \"but\", \"and\" or \"so\", and refuses \"it\" with a\n722\t// use verb, so \"run /speckit:save and don't skip it\" stays a request. The refusal\n723\t// has to end its clause, because \"don't run it twice\" or \"never run it without a\n724\t// budget\" limits the run rather than refusing it.\n725\tconst COMMAND_DECLINED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]|\\\\b(?:but|and|so|though)\\\\b) *(?:(?:please|just|then|still) )*(?:do not|don't|dont|never)(?: (?:actually|really|yet|ever|even))? ${COMMAND_USE_VERB} it(?: (?:yet|now|for now|at all|please))? *(?:$|[,.;!?\\\\n])`);\n726\t\n727\t// A command named as a document is read about, not run: \"read the /create:readme\n728\t// document\", \"open the /deep:review command file\". The name needs a determiner\n729\t// before it, because a typed request puts its argument there instead, as in\n730\t// \"/create:diff file a.md b.md\". A naming followed by \"then\" goes on to ask for\n731\t// work, as in \"read the /deep:review docs, then do a thorough review\", so it is\n732\t// not only a read.\n733\tconst COMMAND_AS_DOCUMENT = /^(?: command)?(?:'s)? (?:doc|docs|document|documentation|file|page|source|definition|markdown)\\b/;\n734\t\n735\t// A command whose policy is run acts without asking, so an unled naming of it is\n736\t// read as a request only on positive evidence: a use verb shortly before it, or\n737\t// the name opening the prompt or a sentence. \"no need for /doctor:deep-loop\"\n738\t// names no lead the lists know, and must not start the command on that alone.\n739\t// The words after the name can still take the request back or turn it into a\n740\t// question, as in \"/doctor:speckit, cancel that\" or \"/doctor:install - is it\n741\t// safe?\", so any of those after the name leaves the naming a mention.\n742\tconst RUN_COMMAND_WITHDRAWN = /\\?|\\b(?:not|don't|dont|never|cancel|scratch that|hold off|wait|undo|is it|should i|nevermind|never mind)\\b/;\n743\t\n744\tfunction runCommandRequested(before: string, after: string, name: string): boolean {\n745\t  if (RUN_COMMAND_WITHDRAWN.test(after)) return false;\n746\t  return new RegExp(`(?:^|[.!?;:\\\\n] *)(?:(?:please|now|just|then|and) )*${name}$`).test(before)\n747\t    || new RegExp(`\\\\b${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}(?:the )?${name}$`).test(before);\n748\t}\n749\t\n750\t// A prompt names a command to refuse it or to ask about it as often as it names\n751\t// one to run it, so an offer must read the naming before it trusts the name. The\n752\t// text is folded first, because a keyed apostrophe or a run of spaces must not\n753\t// hide the lead, while a line break survives as the sentence end it is. Inline\n754\t// code, bold, strike, brackets, parentheses, guillemets, primes and quote marks\n755\t// around a name are dropped for the same reason, so a refusal of a wrapped\n756\t// command reads as the plain refusal does. An underscore stays, because a\n757\t// command name may hold one. A single quote goes only where it\n758\t// opens or closes a command name, because the same mark is the apostrophe of a\n759\t// lead such as \"don't\" or \"what's\". A retired name is read beside the current\n760\t// one, because a reader who refuses the old spelling refuses the command it now\n761\t// maps to. The\n762\t// boundary before the lead keeps a command name from matching inside a word or a\n763\t// path, and the boundary after it keeps a longer command name from reading as the\n764\t// shorter one or a doc path such as `/create:readme.md` from reading as a naming.\n765\t// Every occurrence has to carry a lead, because one led naming does not turn a\n766\t// later unled naming into a request.\n767\texport function commandOnlyMentioned(prompt: string, command: string): boolean {\n768\t  const text = prompt\n769\t    .toLowerCase()\n770\t    .replace(/<\\/?(?:code|kbd|samp|tt)>/g, '')\n771\t    .replace(/[`*\"\\u201c\\u201d[\\]()~\\u00ab\\u00bb\\u2032\\u2039\\u203a]/g, '')\n772\t    .replace(/[\\u2018\\u2019]/g, \"'\")\n773\t    .replace(/(^|[^a-z0-9])'(?=\\/[a-z])/g, '$1')\n774\t    .replace(/(\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)*(?: [a-z][a-z0-9_-]*)?)'(?![a-z0-9])/g, '$1')\n775\t    .replace(/[^\\S\\n]+/g, ' ')\n776\t    .replace(/ *\\n\\s*/g, '\\n');\n777\t  const current = command.toLowerCase();\n778\t  const spellings = [current, ...Object.keys(RETIRED_COMMANDS).filter((retired) => RETIRED_COMMANDS[retired] === current)]\n779\t    .sort((left, right) => right.length - left.length);\n780\t  const name = `(?:${spellings.map(escapePhrase).join('|')})`;\n781\t  const runsWithoutAsking = TRACKED_COMMANDS[current]?.policy === 'run';\n782\t  const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-]|[./][a-z0-9])`, 'g'))];\n783\t  if (occurrences.length === 0) return false;\n784\t  return occurrences.every((occurrence) => {\n785\t    const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n786\t    const before = text.slice(0, nameEnd);\n787\t    const tail = text.slice(nameEnd);\n788\t    const clause = tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0];\n789\t    if (COMMAND_DECLINED_BY_PRONOUN.test(clause)) return true;\n790\t    if (COMMAND_ASKED_BY_PRONOUN.test(clause)) return false;\n791\t    if (COMMAND_AS_DOCUMENT.test(tail) && !/\\bthen\\b/.test(clause)\n792\t      && new RegExp(`\\\\b(?:the|this|that) ${name}$`).test(before)) return true;\n793\t    const led = COMMAND_DECLINE_LEADS.some((lead) => (\n794\t      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n795\t    )) || COMMAND_ASK_LEADS.some((lead) => (\n796\t      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n797\t    ));\n798\t    if (led) return true;\n799\t    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n800\t    if (!bareLead) return runsWithoutAsking && !runCommandRequested(before, tail, name);\n801\t    const sentenceEnd = tail.search(/[.!\\n]/);\n802\t    const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n803\t    // A chat question often leaves the question mark off, so a bare ask word that\n804\t    // opens a sentence still asks about the command.\n805\t    return sentence.includes('?')\n806\t      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n807\t  });\n808\t}\n809\t\n810\t// A compiled route arrives as unvalidated JSON from a separate process, so the\n811\t// shape is narrowed here rather than trusted. Arrays count as objects in\n812\t// JavaScript and would let `action` read off an unrelated field, so they are\n813\t// excluded explicitly.\n814\tfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n815\t  if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n816\t  return value as Record<string, unknown>;\n817\t}\n818\t\n819\t// The command for a hub's recommendation, or undefined when the route does not\n820\t// single out one mode. Only a single-mode route names a command unambiguously:\n821\t// a bundle or a multi-target route has more than one answer, and asking the\n822\t// reader to pick belongs to the recommend path, not here. Never throws, because\n823\t// a missing command must degrade to \"no command offered\" rather than break\n824\t// routing. The prompt decides whether a costly deep-loop command is offered at\n825\t// all: a reader who only asks about the topic gets no command, rather than one\n826\t// that would launch work they never requested.\n827\texport function attachCommand(\n828\t  skillId: string,\n829\t  compiledRoute: unknown,\n830\t  prompt: string,\n831\t  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n832\t): string | undefined {\n833\t  const route = asRecord(compiledRoute);\n834\t  if (!route) return undefined;\n835\t  // A complaint about a stuck run is answered by the hub's own diagnosis command,\n836\t  // whichever mode the route picked, because a new run would repeat the fault.\n837\t  if (skillId === 'system-deep-loop' && isStuckRunComplaint(prompt)) {\n838\t    return isNoEditRequest(prompt) || commandOnlyMentioned(prompt, DEEP_LOOP_DOCTOR_COMMAND)\n839\t      ? undefined\n840\t      : DEEP_LOOP_DOCTOR_COMMAND;\n841\t  }\n842\t  if (skillId === 'system-deep-loop' && (route.action === 'defer' || route.action === 'clarify')) {\n843\t    return deferredLoopCommand(skillId, prompt, modeCommands);\n844\t  }\n845\t  if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n846\t\n847\t  const targets = route.targets;\n848\t  if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n849\t\n850\t  const onlyTarget = asRecord(targets[0]);\n851\t  if (!onlyTarget) return undefined;\n852\t\n853\t  const workflowMode = onlyTarget.workflowMode;\n854\t  if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n855\t\n856\t  // A reader who rules out a change gets no command from either path, so the hub\n857\t  // route never offers what the scorer already withholds.\n858\t  if (isNoEditRequest(prompt)) return undefined;\n859\t\n860\t  // Own-key lookup on both levels: the table is data read from a generated\n861\t  // object, so an inherited name such as `constructor` must not resolve to a\n862\t  // command the hub never declared.\n863\t  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n864\t  const commands = modeCommands[skillId];\n865\t  if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n866\t\n867\t  // A route can pick the mode because the prompt named its command, so a naming\n868\t  // that refused or asked about the command must not produce the offer.\n869\t  if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n870\t\n871\t  // A correction inside one document is not a request for a creation workflow,\n872\t  // which scaffolds, reviews and validates a whole one.\n873\t  if (\n874\t    SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n875\t    && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n876\t    && !CREATION_REQUEST.test(prompt.toLowerCase())\n877\t    && CORRECTION_VERB.test(prompt.toLowerCase())\n878\t  ) return undefined;\n879\t\n880\t  // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n881\t  // run, so they are offered only when the prompt asks for the loop itself.\n882\t  // Typing the command being attached is itself the ask, while typing another\n883\t  // deep-loop command asks for that command, not this one. Every other hub\n884\t  // answers a short question with a short answer, so no other skill consults the\n885\t  // wording list.\n886\t  if (skillId === 'system-deep-loop') {\n887\t    const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n888\t    if (!typesThisCommand && !asksForLoopRun(prompt)) return undefined;\n889\t  }\n890\t\n891\t  return commands[workflowMode];\n892\t}\n893\t\n894\t// The hub's router reads fixed phrases, so it defers on \"run 8 more review\n895\t// iterations\" though the prompt asks for the loop and names one mode. A loop\n896\t// request with exactly one mode cue names that mode as surely as a router\n897\t// phrase does, while a cue for both modes or for neither leaves the choice to\n898\t// the reader. The refusal and mention guards apply here as on a routed mode.\n899\tfunction deferredLoopCommand(\n900\t  skillId: string,\n901\t  prompt: string,\n902\t  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>>,\n903\t): string | undefined {\n904\t  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n905\t  const lowered = prompt.toLowerCase();\n906\t  if (!asksForLoopRun(prompt) || isNoEditRequest(prompt)) return undefined;\n907\t  const commands = modeCommands[skillId];\n908\t  const named = new Set([...lowered.matchAll(NAMED_LOOP_MODE)].map((match) => (\n909\t    (match[1] ?? match[2]) === 'research' ? 'research' : 'review'\n910\t  )));\n911\t  const cued = named.size === 1\n912\t    ? [...named].filter((mode) => Object.prototype.hasOwnProperty.call(commands, mode))\n913\t    : Object.keys(MODE_CUES).filter((mode) => (\n914\t      MODE_CUES[mode].test(lowered) && Object.prototype.hasOwnProperty.call(commands, mode)\n915\t    ));\n916\t  if (cued.length !== 1) return undefined;\n917\t  const command = commands[cued[0]];\n918\t  return commandOnlyMentioned(prompt, command) ? undefined : command;\n919\t}\n920\t\n921\t// A mode word that qualifies the loop's own unit names the mode outright, as in\n922\t// \"run 5 research iterations on review tooling\", where \"review\" is the topic.\n923\t// One such name settles the mode before the looser topic cues are counted.\n924\tconst NAMED_LOOP_MODE = /\\b(?:deep[- ](research|review)|(research|review|audit)[- ](?:loop|iterations?|passes|rounds|runs?))\\b/g;\n925\t\n926\t// A hub that withholds its command because the prompt names no single mode must\n927\t// still tell the reader why no command came with it, and only a hub whose modes\n928\t// map to commands withholds one. A hub that tops a prompt which never named it\n929\t// is the scorer's guess, so the label would point at modes the reader did not\n930\t// ask about.\n931\texport function routeNeedsMode(\n932\t  skillId: string,\n933\t  compiledRoute: unknown,\n934\t  namedSkills: readonly string[],\n935\t): boolean {\n936\t  if (!namedSkills.includes(skillId)) return false;\n937\t  const route = asRecord(compiledRoute);\n938\t  if (!route) return false;\n939\t  if (route.action !== 'defer' && route.action !== 'clarify') return false;\n940\t  return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n941\t}"}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:45:48.279Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/michelkerkmeester/worktrees/public/533-deep-loop-offers-deep-review/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts","content":"  if (/iterations?$/.test(phrase) && ITERATIONS_OF_SUBJECT.test(after)) return true;\n  return COUNT_NOUN.test(phrase) && COUNT_AS_SUBJECT.test(after);\n}\n\n// Any one loop phrase that is neither refused nor the request's subject asks\n// for the run, so \"don't summarize it, run a deep review\" still asks.\nfunction hasLoopAsk(lowered: string): boolean {\n  for (const match of lowered.matchAll(LOOP_REQUEST_ALL)) {\n    const before = lowered.slice(0, match.index);\n    const after = lowered.slice(match.index + match[0].length);\n    if (RUN_ASK_NEGATED.test(before) || LOOP_ASK_REFUSED_AFTER.test(after)) continue;\n    if (namesLoopSubject(match[0], before, after)) continue;\n    return true;\n  }\n  return false;\n}\n\n// Loop wording also names a loop the reader is not asking to start: a past run\n// whose output they want read, a stuck run they want diagnosed, or a method they\n// want to write about. Both deep-loop offer paths read this one test, so the\n// routed mode and the deferred mode cannot disagree on what counts as the ask.\n// The want leads spell their contractions with a straight apostrophe, so a curly\n// one is folded first, and every exception below reads the folded text too.\nexport function asksForLoopRun(prompt: string): boolean {\n  const lowered = lowerFolded(prompt);\n  return hasLoopAsk(lowered)\n    && !isPastRunRead(lowered)\n    && !isStuckRunComplaint(lowered)\n    && !isWritingAboutTopic(lowered)\n    && !isLoopQuestion(lowered);\n}\n\n// A question about how the loop works names it the way a request to run it\n// does, as in \"how does the deep review decide it has converged\". It asks for\n// the run only when it also tells the loop to start or gives an iteration count.\n// A negated question, as in \"why doesn't my deep review converge\", asks about\n// the loop the same way. The loop has to be what the question is about, so\n// \"deep research: how do vector databases handle hybrid search\" still asks for\n// a run on that topic.\nconst LOOP_SUBJECT = '(?:[\\\\w\\'-]+ ){0,2}?(?:deep[- ](?:research|review|loop)|(?:research|review) loop)\\\\b';\n// \"How many\" asks about the loop's length, as in \"how many passes does the deep\n// review do\".\nconst LOOP_QUESTION = new RegExp(\n  `\\\\b(?:how|why|when|what) (?:does|do|is|are|did|makes|doesn't|don't|isn't|aren't|didn't|won't|can't) ${LOOP_SUBJECT}`\n  + `|\\\\bhow many (?:[\\\\w'-]+ ){0,2}?(?:does|do|is|are|did|will|would|should|can) ${LOOP_SUBJECT}`\n  + `|\\\\b(?:explain|describe) (?:how|what|why|when) ${LOOP_SUBJECT}`,\n);\n// Only a digit count turns the question back into a request. The spelled count\n// is left out on purpose, so a question about the loop that quotes one, as in\n// \"why does the deep review stop after ten iterations\", stays the question it\n// was before spelled counts were read as a loop ask. A question that names no\n// loop is not a loop question at all, so \"why does it stop after ten\n// iterations\" still reads its count as a request for a run.\nconst ITERATION_COUNT = /\\b\\d+ (?:[a-z-]+ ){0,2}iterations?\\b/;\n// A later clause that opens with a use verb on \"one\" or \"it\" asks for the loop\n// the question named, as in \"what is a deep review? run one on the parser\".\nconst LOOP_RUN_BY_PRONOUN = /(?:^|[,.;!?\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*(?:run|start|launch|do|kick off) (?:one|it|another)\\b/;\n\nfunction isLoopQuestion(lowered: string): boolean {\n  return LOOP_QUESTION.test(lowered)\n    && !LOOP_RUN_REQUESTED.test(lowered)\n    && !ITERATION_COUNT.test(lowered)\n    && !LOOP_RUN_BY_PRONOUN.test(lowered);\n}\n\n// `why not` proposes the command rather than refusing it, so the word refuses\n// only where no `why` stands before it.\nconst COMMAND_NOT_WORD = '(?<!\\\\bwhy )not';\n\n// A command the reader refuses is named without being asked for, so this list\n// holds the leads that mark that naming. A lead must sit directly before the\n// command so a later clause cannot refuse an earlier request, and a gap holds\n// plain words only so a refusal before a comma cannot swallow the request after\n// it. A reader who stops using a command names it only to refuse it.\nexport const COMMAND_DECLINE_LEADS: readonly string[] = [\n  `(?:do not|don't|dont|never|${COMMAND_NOT_WORD}|won't|wont|no longer|cannot|can't|no need to|need not|needn't) (?!(?:forget|hesitate|fail|mind)\\\\b)${COMMAND_GAP_WORDS}${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}`,\n  `(?:skip|skipping|without|instead of|rather than|avoid|stop|stopped|quit|${COMMAND_NOT_WORD}) (?:(?!${COMMAND_USE_VERB}\\\\b)[a-z']+ ){0,2}`,\n];\n\n// A refusal or a question over an or-list covers every command the list joins,\n// while a second use verb opens a clause of its own, so the list joins only `or`\n// and `, or`. A listed command may carry `the` before it and\n// `command` after it, and the command after the last `or` may carry `the`. A\n// listed command may also carry one plain word after it, such as the subcommand a\n// doctor command takes, so `do not run /x now or /y` refuses both.\nconst COMMAND_OR_LIST = '(?:(?:the )?\\\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?: [a-z][a-z0-9_-]*)?(?: command)?,? or (?:the )?)*';\n\n// A command the reader asks about is named without being asked for, so this list\n// holds the leads that mark that naming. A lead must sit directly before the\n// command so a later clause cannot turn an earlier request into a question, and\n// a gap holds plain words only so a question before a comma cannot swallow the\n// request after it.\nexport const COMMAND_ASK_LEADS: readonly string[] = [\n  \"(?:what does|what is|what's|what would|what will|what did|how does|how did|why does|why did|explain|describe|tell me what|tell me how|tell me about|tell me why|difference between|differ from|differs from|different from|undo what|ran|already ran|was running) (?:the )?(?:command )?\",\n  `(?:should i|should we|do i need to|when would i) ${COMMAND_USE_VERB} (?:the )?(?:command )?`,\n];\n\n// A bare ask word opens a statement as often as a question, so it marks a naming\n// only when the command it precedes is followed by a question mark before the\n// sentence ends, or when the lead itself opens a sentence, which a question mark ends as a full stop does.\n// A question often names the command after `the`, as in `is the /x command safe`.\nexport const COMMAND_BARE_ASK_LEAD = '(?:is|does|can|will|would) (?:the )?';\n\n// A clause that opens with a use verb and `it` asks for the command an earlier\n// clause only named, so a naming such as `not run /x yet, please start it`\n// becomes a request. The clause has to open that way so `I will run it` stays a\n// statement.\nconst COMMAND_ASKED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]) *(?:(?:and|then|so|please|now|just|go ahead and) )*${COMMAND_USE_VERB} it\\\\b`);\n\n// A refusal can come after the name, as in \"/create:readme is not what I want, do\n// not run it\" or \"run /doctor:git setup but do not actually run it\". The clause\n// opens a new sentence or follows \"but\", \"and\" or \"so\", and refuses \"it\" with a\n// use verb, so \"run /speckit:save and don't skip it\" stays a request. The refusal\n// has to end its clause, because \"don't run it twice\" or \"never run it without a\n// budget\" limits the run rather than refusing it.\nconst COMMAND_DECLINED_BY_PRONOUN = new RegExp(`(?:^|[,.;!?\\\\n]|\\\\b(?:but|and|so|though)\\\\b) *(?:(?:please|just|then|still) )*(?:do not|don't|dont|never)(?: (?:actually|really|yet|ever|even))? ${COMMAND_USE_VERB} it(?: (?:yet|now|for now|at all|please))? *(?:$|[,.;!?\\\\n])`);\n\n// A command named as a document is read about, not run: \"read the /create:readme\n// document\", \"open the /deep:review command file\". The name needs a determiner\n// before it, because a typed request puts its argument there instead, as in\n// \"/create:diff file a.md b.md\". A naming followed by \"then\" goes on to ask for\n// work, as in \"read the /deep:review docs, then do a thorough review\", so it is\n// not only a read.\nconst COMMAND_AS_DOCUMENT = /^(?: command)?(?:'s)? (?:doc|docs|document|documentation|file|page|source|definition|markdown)\\b/;\n\n// A command whose policy is run acts without asking, so an unled naming of it is\n// read as a request only on positive evidence: a use verb shortly before it, or\n// the name opening the prompt or a sentence. \"no need for /doctor:deep-loop\"\n// names no lead the lists know, and must not start the command on that alone.\n// The words after the name can still take the request back or turn it into a\n// question, as in \"/doctor:speckit, cancel that\" or \"/doctor:install - is it\n// safe?\", so any of those after the name leaves the naming a mention.\nconst RUN_COMMAND_WITHDRAWN = /\\?|\\b(?:not|don't|dont|never|cancel|scratch that|hold off|wait|undo|is it|should i|nevermind|never mind)\\b/;\n\nfunction runCommandRequested(before: string, after: string, name: string): boolean {\n  if (RUN_COMMAND_WITHDRAWN.test(after)) return false;\n  return new RegExp(`(?:^|[.!?;:\\\\n] *)(?:(?:please|now|just|then|and) )*${name}$`).test(before)\n    || new RegExp(`\\\\b${COMMAND_USE_VERB} ${COMMAND_GAP_WORDS}(?:the )?${name}$`).test(before);\n}\n\n// A prompt names a command to refuse it or to ask about it as often as it names\n// one to run it, so an offer must read the naming before it trusts the name. The\n// text is folded first, because a keyed apostrophe or a run of spaces must not\n// hide the lead, while a line break survives as the sentence end it is. Inline\n// code, bold, strike, brackets, parentheses, guillemets, primes and quote marks\n// around a name are dropped for the same reason, so a refusal of a wrapped\n// command reads as the plain refusal does. An underscore stays, because a\n// command name may hold one. A single quote goes only where it\n// opens or closes a command name, because the same mark is the apostrophe of a\n// lead such as \"don't\" or \"what's\". A retired name is read beside the current\n// one, because a reader who refuses the old spelling refuses the command it now\n// maps to. The\n// boundary before the lead keeps a command name from matching inside a word or a\n// path, and the boundary after it keeps a longer command name from reading as the\n// shorter one or a doc path such as `/create:readme.md` from reading as a naming.\n// Every occurrence has to carry a lead, because one led naming does not turn a\n// later unled naming into a request.\nexport function commandOnlyMentioned(prompt: string, command: string): boolean {\n  const text = prompt\n    .toLowerCase()\n    .replace(/<\\/?(?:code|kbd|samp|tt)>/g, '')\n    .replace(/[`*\"\\u201c\\u201d[\\]()~\\u00ab\\u00bb\\u2032\\u2039\\u203a]/g, '')\n    .replace(/[\\u2018\\u2019]/g, \"'\")\n    .replace(/(^|[^a-z0-9])'(?=\\/[a-z])/g, '$1')\n    .replace(/(\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)*(?: [a-z][a-z0-9_-]*)?)'(?![a-z0-9])/g, '$1')\n    .replace(/[^\\S\\n]+/g, ' ')\n    .replace(/ *\\n\\s*/g, '\\n');\n  const current = command.toLowerCase();\n  const spellings = [current, ...Object.keys(RETIRED_COMMANDS).filter((retired) => RETIRED_COMMANDS[retired] === current)]\n    .sort((left, right) => right.length - left.length);\n  const name = `(?:${spellings.map(escapePhrase).join('|')})`;\n  const runsWithoutAsking = TRACKED_COMMANDS[current]?.policy === 'run';\n  const occurrences = [...text.matchAll(new RegExp(`(?:^|[^a-z0-9_/])${name}(?![a-z0-9_-]|[./][a-z0-9])`, 'g'))];\n  if (occurrences.length === 0) return false;\n  return occurrences.every((occurrence) => {\n    const nameEnd = (occurrence.index ?? 0) + occurrence[0].length;\n    const before = text.slice(0, nameEnd);\n    const tail = text.slice(nameEnd);\n    const clause = tail.split(/(?:^|[\\s,;(])\\/[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?(?![a-z0-9_\\/-]|\\.[a-z0-9])/)[0];\n    if (COMMAND_DECLINED_BY_PRONOUN.test(clause)) return true;\n    if (COMMAND_ASKED_BY_PRONOUN.test(clause)) return false;\n    if (COMMAND_AS_DOCUMENT.test(tail) && !/\\bthen\\b/.test(clause)\n      && new RegExp(`\\\\b(?:the|this|that) ${name}$`).test(before)) return true;\n    const led = COMMAND_DECLINE_LEADS.some((lead) => (\n      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n    )) || COMMAND_ASK_LEADS.some((lead) => (\n      new RegExp(`(?:^|[^a-z0-9_/])${lead}${COMMAND_OR_LIST}${name}$`).test(before)\n    ));\n    if (led) return true;\n    const bareLead = new RegExp(`(?:^|[^a-z0-9_/])${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n    if (!bareLead) return runsWithoutAsking && !runCommandRequested(before, tail, name);\n    const sentenceEnd = tail.search(/[.!\\n]/);\n    const sentence = sentenceEnd === -1 ? tail : tail.slice(0, sentenceEnd);\n    // A chat question often leaves the question mark off, so a bare ask word that\n    // opens a sentence still asks about the command.\n    return sentence.includes('?')\n      || new RegExp(`(?:^|[.!?\\\\n] *)${COMMAND_BARE_ASK_LEAD}${COMMAND_OR_LIST}${name}$`).test(before);\n  });\n}\n\n// A compiled route arrives as unvalidated JSON from a separate process, so the\n// shape is narrowed here rather than trusted. Arrays count as objects in\n// JavaScript and would let `action` read off an unrelated field, so they are\n// excluded explicitly.\nfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n  if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n  return value as Record<string, unknown>;\n}\n\n// The command for a hub's recommendation, or undefined when the route does not\n// single out one mode. Only a single-mode route names a command unambiguously:\n// a bundle or a multi-target route has more than one answer, and asking the\n// reader to pick belongs to the recommend path, not here. Never throws, because\n// a missing command must degrade to \"no command offered\" rather than break\n// routing. The prompt decides whether a costly deep-loop command is offered at\n// all: a reader who only asks about the topic gets no command, rather than one\n// that would launch work they never requested.\nexport function attachCommand(\n  skillId: string,\n  compiledRoute: unknown,\n  prompt: string,\n  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n): string | undefined {\n  const route = asRecord(compiledRoute);\n  if (!route) return undefined;\n  // A complaint about a stuck run is answered by the hub's own diagnosis command,\n  // whichever mode the route picked, because a new run would repeat the fault.\n  if (skillId === 'system-deep-loop' && isStuckRunComplaint(prompt)) {\n    return isNoEditRequest(prompt) || commandOnlyMentioned(prompt, DEEP_LOOP_DOCTOR_COMMAND)\n      ? undefined\n      : DEEP_LOOP_DOCTOR_COMMAND;\n  }\n  if (skillId === 'system-deep-loop' && (route.action === 'defer' || route.action === 'clarify')) {\n    return deferredLoopCommand(skillId, prompt, modeCommands);\n  }\n  if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n\n  const targets = route.targets;\n  if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n\n  const onlyTarget = asRecord(targets[0]);\n  if (!onlyTarget) return undefined;\n\n  const workflowMode = onlyTarget.workflowMode;\n  if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n\n  // A reader who rules out a change gets no command from either path, so the hub\n  // route never offers what the scorer already withholds.\n  if (isNoEditRequest(prompt)) return undefined;\n\n  // Own-key lookup on both levels: the table is data read from a generated\n  // object, so an inherited name such as `constructor` must not resolve to a\n  // command the hub never declared.\n  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n  const commands = modeCommands[skillId];\n  if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n\n  // A route can pick the mode because the prompt named its command, so a naming\n  // that refused or asked about the command must not produce the offer.\n  if (commandOnlyMentioned(prompt, commands[workflowMode])) return undefined;\n\n  // A correction inside one document is not a request for a creation workflow,\n  // which scaffolds, reviews and validates a whole one.\n  if (\n    SMALL_EDIT_GATED_COMMANDS.has(commands[workflowMode])\n    && SMALL_EDIT_REQUEST.test(prompt.toLowerCase())\n    && !CREATION_REQUEST.test(prompt.toLowerCase())\n    && CORRECTION_VERB.test(prompt.toLowerCase())\n  ) return undefined;\n\n  // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n  // run, so they are offered only when the prompt asks for the loop itself.\n  // Typing the command being attached is itself the ask, while typing another\n  // deep-loop command asks for that command, not this one. Every other hub\n  // answers a short question with a short answer, so no other skill consults the\n  // wording list.\n  if (skillId === 'system-deep-loop') {\n    const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n    if (!typesThisCommand && !asksForLoopRun(prompt)) return undefined;\n  }\n\n  return commands[workflowMode];\n}\n\n// The hub's router reads fixed phrases, so it defers on \"run 8 more review\n// iterations\" though the prompt asks for the loop and names one mode. A loop\n// request with exactly one mode cue names that mode as surely as a router\n// phrase does, while a cue for both modes or for neither leaves the choice to\n// the reader. The refusal and mention guards apply here as on a routed mode.\nfunction deferredLoopCommand(\n  skillId: string,\n  prompt: string,\n  modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>>,\n): string | undefined {\n  if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n  const lowered = prompt.toLowerCase();\n  if (!asksForLoopRun(prompt) || isNoEditRequest(prompt)) return undefined;\n  const commands = modeCommands[skillId];\n  const named = new Set([...lowered.matchAll(NAMED_LOOP_MODE)].map((match) => (\n    (match[1] ?? match[2]) === 'research' ? 'research' : 'review'\n  )));\n  const cued = named.size === 1\n    ? [...named].filter((mode) => Object.prototype.hasOwnProperty.call(commands, mode))\n    : Object.keys(MODE_CUES).filter((mode) => (\n      MODE_CUES[mode].test(lowered) && Object.prototype.hasOwnProperty.call(commands, mode)\n    ));\n  if (cued.length !== 1) return undefined;\n  const command = commands[cued[0]];\n  return commandOnlyMentioned(prompt, command) ? undefined : command;\n}\n\n// A mode word that qualifies the loop's own unit names the mode outright, as in\n// \"run 5 research iterations on review tooling\", where \"review\" is the topic.\n// One such name settles the mode before the looser topic cues are counted.\nconst NAMED_LOOP_MODE = /\\b(?:deep[- ](research|review)|(research|review|audit)[- ](?:loop|iterations?|passes|rounds|runs?))\\b/g;\n\n// A hub that withholds its command because the prompt names no single mode must\n// still tell the reader why no command came with it, and only a hub whose modes\n// map to commands withholds one. A hub that tops a prompt which never named it\n// is the scorer's guess, so the label would point at modes the reader did not\n// ask about.\nexport function routeNeedsMode(\n  skillId: string,\n  compiledRoute: unknown,\n  namedSkills: readonly string[],\n): boolean {\n  if (!namedSkills.includes(skillId)) return false;\n  const route = asRecord(compiledRoute);\n  if (!route) return false;\n  if (route.action !== 'defer' && route.action !== 'clarify') return false;\n  return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n}","numLines":332,"startLine":610,"totalLines":942}},"tool_result_meta":[{"id":"toolu_01WKTdna26BR9vN1YXikhBhj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
