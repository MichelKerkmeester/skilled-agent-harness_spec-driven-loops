{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CH9QhMQcYeK33db6gqypy9","type":"tool_result","content":"  }\n}\n\n// The local scorer names command ids, but a reader can only act on a command they\n// typed or on the skill that owns it. A row whose bare slash command appears in\n// the prompt keeps its command fields, and every other row collapses to its owner\n// skill so the degraded brief names a skill that exists instead of a raw row id.\nexport function degradedRecommendations(\n  entries: readonly AdvisorRecommendation[],\n  prompt: string,\n): Array<Record<string, unknown>> {\n  const offeredSkills = new Set<string>();\n  const recommendations: Array<Record<string, unknown>> = [];\n  // A command named only in a pasted earlier reply is not one the user typed.\n  const task = stripLeadingPastedReply(prompt);\n\n  for (const entry of entries) {\n    if (entry.passes_threshold !== true) continue;\n    const base = {\n      confidence: entry.confidence,\n      uncertainty: entry.uncertainty,\n      reason: entry.reason ?? '',\n    };\n    const row = commandRowFor(entry.skill);\n\n    if (row && task.includes(row.command.split(' ')[0])) {\n      recommendations.push({\n        skillId: entry.skill,\n        kind: 'command',\n        command: row.command,\n        ...(row.policy ? { policy: row.policy } : {}),\n        ownerSkillId: row.ownerSkillId,\n        ...base,\n      });\n      offeredSkills.add(entry.skill);\n      continue;\n    }\n\n    if (row) {\n      if (offeredSkills.has(row.ownerSkillId)) continue;\n      recommendations.push({\n        skillId: row.ownerSkillId,\n        kind: 'skill',\n        ...base,\n      });\n      offeredSkills.add(row.ownerSkillId);\n      continue;\n    }\n\n    recommendations.push({ skillId: entry.skill, ...base });\n    offeredSkills.add(entry.skill);\n  }\n\n  return recommendations;\n}\n\n// Request options added after the daemon protocol was fixed, oldest first.\nconst COMPILED_ROUTE_OPTION_KEYS = ['includeCompiledRoute', 'compiledRouteTopOnly'] as const;\n\nasync function invokeAdvisorRecommendPayload(\n  args: Record<string, unknown>,\n  timeoutMs: number,\n  trusted: boolean,\n  warmOnly: boolean,\n): Promise<ToolPayloadResult> {\n  // The switch belongs to the caller. A daemon reads its own environment and the\n  // local scorer reads none, so the client answers before it touches either.\n  const disabled = disabledRecommendOutput(args);\n  if (disabled) return { payload: { status: 'ok', data: disabled }, isError: false };\n  try {","is_error":false}]},"parent_tool_use_id":null,"session_id":"<redacted>","uuid":"<redacted>","timestamp":"2026-11-24T04:47:57.225Z","tool_use_result":{"stdout":"  }\n}\n\n// The local scorer names command ids, but a reader can only act on a command they\n// typed or on the skill that owns it. A row whose bare slash command appears in\n// the prompt keeps its command fields, and every other row collapses to its owner\n// skill so the degraded brief names a skill that exists instead of a raw row id.\nexport function degradedRecommendations(\n  entries: readonly AdvisorRecommendation[],\n  prompt: string,\n): Array<Record<string, unknown>> {\n  const offeredSkills = new Set<string>();\n  const recommendations: Array<Record<string, unknown>> = [];\n  // A command named only in a pasted earlier reply is not one the user typed.\n  const task = stripLeadingPastedReply(prompt);\n\n  for (const entry of entries) {\n    if (entry.passes_threshold !== true) continue;\n    const base = {\n      confidence: entry.confidence,\n      uncertainty: entry.uncertainty,\n      reason: entry.reason ?? '',\n    };\n    const row = commandRowFor(entry.skill);\n\n    if (row && task.includes(row.command.split(' ')[0])) {\n      recommendations.push({\n        skillId: entry.skill,\n        kind: 'command',\n        command: row.command,\n        ...(row.policy ? { policy: row.policy } : {}),\n        ownerSkillId: row.ownerSkillId,\n        ...base,\n      });\n      offeredSkills.add(entry.skill);\n      continue;\n    }\n\n    if (row) {\n      if (offeredSkills.has(row.ownerSkillId)) continue;\n      recommendations.push({\n        skillId: row.ownerSkillId,\n        kind: 'skill',\n        ...base,\n      });\n      offeredSkills.add(row.ownerSkillId);\n      continue;\n    }\n\n    recommendations.push({ skillId: entry.skill, ...base });\n    offeredSkills.add(entry.skill);\n  }\n\n  return recommendations;\n}\n\n// Request options added after the daemon protocol was fixed, oldest first.\nconst COMPILED_ROUTE_OPTION_KEYS = ['includeCompiledRoute', 'compiledRouteTopOnly'] as const;\n\nasync function invokeAdvisorRecommendPayload(\n  args: Record<string, unknown>,\n  timeoutMs: number,\n  trusted: boolean,\n  warmOnly: boolean,\n): Promise<ToolPayloadResult> {\n  // The switch belongs to the caller. A daemon reads its own environment and the\n  // local scorer reads none, so the client answers before it touches either.\n  const disabled = disabledRecommendOutput(args);\n  if (disabled) return { payload: { status: 'ok', data: disabled }, isError: false };\n  try {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CH9QhMQcYeK33db6gqypy9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
