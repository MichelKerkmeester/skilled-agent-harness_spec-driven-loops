indings'],\n580:  ])('offers the doctor on a stuck %s run: %s', (mode, prompt) => {\n592:  it('withholds the doctor on a stuck run when the reader rules out a change', () => {\n593:    expect(attachCommand('system-deep-loop', SINGLE('review'), 'the deep review is stuck, make no changes')).toBeUndefined();\n677:    ['review', 'the review I started is stuck on iteration 4'],\n680:  ])('offers the doctor on a stuck %s run named in other words: %s', (mode, prompt) => {\n686:    'the CI job is stuck',\n690:  ])('withholds the doctor when the stuck thing is no deep run: %s', (prompt) => {\n696:    'my k-means convergence is stuck, help me debug the code',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AyeoCZD9eyVhYpFWGCtbCM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
