 succeeded in 0ms:
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
            };
            const args = [
              '-p',
              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),
              '--model',
              executor.model,
              '--permission-mode',
              resolveClaudePermissionMode(executor.sandboxMode),
              '--output-format',
              'text',
            ];
            if (executor.reasoningEffort) {
              args.push('--effort', executor.reasoningEffort);
            }

            const dispatchFacts = {
              command: 'deep/research',
              mode: 'research',
              specFolder: '{spec_folder}',
              artifactDir: '{state_paths.packet_dir}',
              iteration: Number('{current_iteration}'),
              executorKind: '{config.executor.type}',
              branchId: '{config.executor.type}',
              sessionId: '{config.lineage.sessionId}',
              generation: Number('{config.lineage.generation}'),
            };
            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';
            process.exit(
              runAuditedExecutorCommand({
                command: 'claude',
                args,
                cwd: '{repo_root}',
                timeoutSeconds: executor.timeoutSeconds,
                stateLogPath: '{state_paths.state_log}',
                executor,
                iteration: Number('{current_iteration}'),
                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
                dispatchId,
              }),
            );
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions"
            - "claude-code has no serviceTier flag"
            - "claude-code supports --effort for reasoning depth"
        if_cli_cursor:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.type}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'research-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native"
        if_cli_devin:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
