            const dispatchId = 'research-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native"
        record_executor_audit:
          skip_when: "config.executor.type == 'native'"
          target: "{state_paths.state_log}"
          field: "executor"
          value:
            kind: "{config.executor.type}"
            model: "{config.executor.model}"
            reasoningEffort: "{config.executor.reasoningEffort}"
            serviceTier: "{config.executor.serviceTier}"
        if_cli_opencode:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createHash } from 'node:crypto';

            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';

            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';
            const executor = {
              kind: 'cli-opencode',
              model: '{config.executor.model}',
              configDir: null,
              reasoningEffort,
              serviceTier: null,
              sandboxMode: null,
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
              governor: null,
            };
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'
              + '\n\n'
              + promptBody;
            const args = [
              'run',
              '--model',
              executor.model,
              '--format',
              'json',
              '--dangerously-skip-permissions',
              '--pure',
              '--dir',
              '{repo_root}',
            ];
            if (executor.reasoningEffort) {
              args.push('--variant', executor.reasoningEffort);
            }
            args.push(message);

            const dispatchFacts = {
              command: 'deep/research',
              mode: 'research',
              specFolder: '{spec_folder}',
              artifactDir: '{state_paths.packet_dir}',
              iteration: Number('{current_iteration}'),
              executorKind: '{config.executor.type}',
              branchId: '{config.executor.type}',
              sessionId: '{config.lineage.sessionId}',
              generation: Number('{config.lineage.generation}'),
            };
            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';
            process.exit(
              runAuditedExecutorCommand({
                command: 'opencode',
                args,
                cwd: '{repo_root}',
                timeoutSeconds: executor.timeoutSeconds,
                stateLogPath: '{state_paths.state_log}',
                executor,
                iteration: Number('{current_iteration}'),
                // opencode v1.14.39 reads stdin at startup before session creation;
                // an empty input gives EOF stdin, equivalent to </dev/null.
                input: '',
                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
                dispatchId,
              }),
            );
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv"
            - "input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)"
            - "opencode run takes a positional message; prompt is the route-proof preamble + iteration body"
            - "--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)"
            - "--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)"
            - "cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate"
        if_cli_codex:
          command: |
            node --experimental-strip-types --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { execFileSync } from 'node:child_process';

            import {
              RECURSION_GUARD_EXIT_CODE,
              formatRecursionGuardRefusal,
              runAuditedExecutorCommand,
              validateExecutorDispatchAllowed,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // Fail closed: a requested codex executor must dispatch codex or abort,
            // never silently degrade to another executor. Undetected absence is what
            // got Codex deprecated before, so the branch exits non-zero when the
            // binary is missing instead of falling through to a native/other path.
            let codexAvailable = false;
            try {
              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });
              codexAvailable = true;
            } catch {}
            if (!codexAvailable) {
              console.error('cli-codex executor unavailable: command -v codex failed');
              process.exit(1);
            }

            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';
            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const executor = {
              kind: 'cli-codex',
              model,
              configDir: null,
              reasoningEffort,
              serviceTier,
              sandboxMode: 'workspace-write',
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
              governor: null,
            };

            // Refuse before any spawn and before any receipt is written, so a refusal can
            // never be mistaken for a real attempt. A process that is already a CLI lineage
            // or a codex session must run the iteration itself, not delegate it onward.
            const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });
            if (!guardVerdict.allowed) {
              console.error(formatRecursionGuardRefusal(guardVerdict, executor));
              process.exit(RECURSION_GUARD_EXIT_CODE);
            }

            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');

            // codex reads the iteration prompt from stdin via the trailing '-'. A research
            // iteration must WRITE its own iteration file, delta and state record, so the
            // sandbox is workspace-write — read-only would block those required writes.
            // approval_policy=never keeps the run non-interactive.
            const args = ['exec'];
            if (model) {
              args.push('--model', model);
            }
            args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));
            if (serviceTier) {
              args.push('-c', 'service_tier=' + serviceTier);
            }
            args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');

            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';
            const repoRoot = '{repo_root}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command: 'codex',
              args,
              cwd: repoRoot,
              timeoutSeconds: executor.timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input: promptBody,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            // Structural write-containment: a workspace-write codex leaf can write
            // anywhere in the repo. Revert any NEW out-of-artifact-dir change it
            // made, append a containment_violation event to the state log, and
            // fail the iteration fail-closed. The leaf's own writes under
            // artifactDir (iteration file/delta/state record) are never flagged.
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment violation: reverted ' + containment.violations.length
                  + ' out-of-scope path(s): '
                  + containment.violations.map((v) => v.path).join(', '),
              );
              process.exit(1);
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, and write the iteration file, the delta and the state record exactly as the leaf contract requires, then continue to post_dispatch_validate."
            - "Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure."
            - "Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv"
            - "Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native"
            - "codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured"
            - "--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies"
        post_dispatch_validate:
          validator: ".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs"
          command: "node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}"
          command_note: "Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once."
          assert_exists: "{state_paths.iteration_pattern}"
          assert_appended: "{state_paths.state_log}"
          assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]
          route_proof:
            mode: research
            target_agent: deep-research
            agent_definition_loaded: true
            resolved_route: "Resolved route: mode=research target_agent=deep-research"
          dispatchReceipt:
            receiptDir: "{state_paths.packet_dir}/dispatch-receipts"
            dispatchId: "research-i{current_iteration}-g{config.lineage.generation}"
          optional_jsonl_fields:
            logOffset: "Byte offset where the seekable log region starts"
            logSize: "Byte length of the seekable log region"
            logPath: "Absolute path to the file containing the seekable log region"
            skippedCount: "Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed"
            slotDurationMs: "Monotonic elapsed duration for the completed dispatch slot"
          assert_canonical_type: "iteration"
          assert_delta_file_exists: "{state_paths.delta_pattern}"
          assert_delta_file_has_iteration_record: true
          on_failure:
            action: "emit schema_mismatch canonical conflict event"
            redispatch_once: "On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once."
            escalation: "After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context"
          failure_reasons_reference:
            - "iteration_file_missing — iteration narrative markdown not written"
            - "iteration_file_empty — iteration narrative markdown is zero bytes"
            - "jsonl_not_appended — state log file did not grow since pre-dispatch snapshot"
            - "jsonl_missing_fields — last state-log record omits required schema fields"
            - "jsonl_parse_error — last state-log line is not valid JSON"
            - "jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop"
            - "delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written"
            - "delta_file_empty — per-iteration delta file exists but has zero bytes"
            - "delta_file_missing_iteration_record — delta file lacks any record with type='iteration'"
            - "route_proof_missing — state-log or delta iteration record omits route-proof fields"
            - "route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route"
            - "executor_missing — non-native executor did not record provenance"
            - "dispatch_failure_logged — last record is an explicit dispatch_failure event"

      step_run_now_restore_check:
        action: "Record a run-now sentinel recreated during the completed dispatch"
        command: |
          node <<'EOF'
          const { appendFileSync, existsSync, readFileSync } = require('node:fs');

          const stateLogPath = "{state_paths.state_log}";
          const sentinelPath = "{state_paths.run_now_sentinel}";
          const timestamp = "{ISO_8601_NOW}";
          const sessionId = "{config.lineage.sessionId}";
          const generation = Number("{config.lineage.generation}");
          const run = Number("{current_iteration}");

          function hasAcceptedCurrentRun() {
            if (!existsSync(stateLogPath)) return false;
            const lines = readFileSync(stateLogPath, "utf8").trim().split(/\r?\n/).filter(Boolean);
            for (let index = lines.length - 1; index >= 0; index -= 1) {
              const record = JSON.parse(lines[index]);
              if (record.run !== run || record.sessionId !== sessionId) continue;
              if (record.event === "run_now_accepted") return true;
              if (record.event === "run_now_rejected") return false;
            }
            return false;
          }

          if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {
            appendFileSync(
              stateLogPath,
              `${JSON.stringify({
                type: "event",
                event: "run_now_restored",
                mode: "research",
                run,
                sentinelPath,
                timestamp,
                sessionId,
                generation,

hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "sed -n '1735,2075p' .opencode/commands/deep/assets/deep-research-auto.yaml" in /Users/michelkerkmeester/MEGA/Development/Code_Environment/Public
 succeeded in 0ms:
                generation,
              })}\n`,
              "utf8",
            );
          }
          EOF
        outputs:
          - run_now_restored: "Emitted when an operator recreates the sentinel before the accepted dispatch completes"

      step_reduce_state:
        action: "Run the reducer to synchronize registry, dashboard, and strategy"
        command: "node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}"
        inputs:
          latestJSONLDelta: "Latest JSONL records written since the previous iteration"
          newIterationFile: "{state_paths.iteration_pattern}"
          priorReducedState: "{state_paths.registry}"
        outputs:
          - "{state_paths.registry}"
          - "{state_paths.dashboard}"
          - "{state_paths.strategy}"
          - "{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text"
          - "{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations"
          - "{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events"
        failure_modes:
          malformed_delta: "skip + warn"
          missing_iteration_file: "no-op + error"
          schema_mismatch: "reject + conflict event"
          question_conflict: "keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision"
        guarantee: "Idempotent for identical inputs"

      step_graph_upsert:
        action: "Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists"
        read:
          - "{state_paths.state_log}"
        extract:
          - latest_graph_events: "Read graphEvents from the latest iteration record, else []"
          - graph_upsert_nodes_json: "Map latest_graph_events where type == 'node' to node payloads with label -> name and preserve remaining node fields"
          - graph_upsert_edges_json: "Map latest_graph_events where type == 'edge' to edge payloads with source -> sourceId, target -> targetId, relation -> uppercase(relation), and preserve remaining edge fields"
          - graph_upsert_event_count: "Count mapped node and edge events"
        if_graph_events_present:
          bash: "node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --nodes '{graph_upsert_nodes_json}' --edges '{graph_upsert_edges_json}'"
          note: "Skip silently when graphEvents is missing or empty."
        if_graph_events_missing:
          proceed: true

      step_refresh_lineage_context:
        action: "Refresh the focused context line from lineage-local state before the next prompt render"
        read:
          - "{state_paths.dashboard}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        source_note: "step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved."
        use_response:
          - "Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary."
        failure_policy:
          missing_state_file: "non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line"
          unreadable_state_file: "non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line"
        outputs:
          - lineage_context_prompt_line: "Fresh focused context summary for the next iteration prompt"
          - lineage_context_refresh_status: "refreshed | advisory_error"

      step_evaluate_results:
        action: "Verify iteration outputs and extract metrics"
        verify:
          - file_exists: "{state_paths.iteration_pattern}"
          - jsonl_appended: "New iteration record in state.jsonl"
          - strategy_updated: "Reducer refreshed strategy machine-owned sections"
          - registry_updated: "Reducer refreshed findings-registry.json"
        extract:
          - newInfoRatio: "From latest JSONL iteration record"
          - findings_count: "From latest JSONL iteration record"
          - status: "From latest JSONL iteration record"
          - latest_focus: "From latest JSONL iteration record"
        on_missing_outputs:
          action: "Mark iteration as 'error', continue to next"
          # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions
          # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.
          append_jsonl: '{"type":"iteration","run":{current_iteration},"mode":"research","status":"error","focus":"{next_focus}","findingsCount":0,"newInfoRatio":0.0,"keyQuestions":[],"answeredQuestions":[],"durationMs":0,"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'

      step_telemetry_heartbeat_progress:
        action: "Emit a single-loop progress row when iteration state changes"
        skip_when: "config.fanout is present"
        command: |
          node --experimental-strip-types --input-type=module <<'EOF'
          import { existsSync, readFileSync } from 'node:fs';

          import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';
          import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';

          const { appendObservabilityEvent } = observabilityEvents;
          const stateLogPath = '{state_paths.state_log}';
          const timestamp = '{ISO_8601_NOW}';
          const sessionId = '{config.lineage.sessionId}';
          const generation = Number('{config.lineage.generation}');
          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';

          function readRecords(path) {
            if (!existsSync(path)) return [];
            return readFileSync(path, 'utf8')
              .split(/\r?\n/)
              .map((line) => line.trim())
              .filter(Boolean)
              .map((line) => JSON.parse(line));
          }

          function elapsedSince(value) {
            const startedAtMs = Date.parse(String(value ?? ''));
            const nowMs = Date.parse(timestamp);
            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;
            return Math.max(0, nowMs - startedAtMs);
          }

          const records = readRecords(stateLogPath);
          const iterations = records.filter((record) => record.type === 'iteration');
          const latest = iterations.at(-1) ?? {};
          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt
            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp
            ?? timestamp;
          const elapsedMs = elapsedSince(startedAt);
          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;
          const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');
          const status = typeof latest.status === 'string' ? latest.status : 'unknown';
          const row = {
            event: 'progress',
            label: 'single',
            at: timestamp,
            duration_ms: elapsedMs,
            loop_type: 'research',
            sessionId,
            generation,
            run,
            status,
            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },
          };

          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {
            diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },
            diffField: 'state_hash',
          });
          if (appended) {
            try {
              appendObservabilityEvent(observabilityPath, row, {
                producer: 'deep-research-auto',
                stream: 'single-loop-telemetry',
                subject: { label: row.label, sessionId, generation, run },
                event: row.event,
                status,
              });
            } catch {}
          }
          EOF
        working_directory: "{repo_root}"
        outputs:
          - status_ledger_progress: "A fan-out-shaped status row with label single and event progress"

      step_generate_dashboard:
        action: "Generate or refresh the human-readable dashboard"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md
        output: "{state_paths.dashboard}"
        note: "Auto-generated from JSONL + reducer registry + strategy. Never manually edited."

      step_update_tracking:
        action: "Update loop tracking variables"
        set:
          current_iteration: "{current_iteration + 1}"
          stuck_count: "if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0"
        log: "Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}."

      step_loop_decision:
        action: "Return to step_read_state for next iteration"
        goto: step_read_state

  # ═══════════════════════════════════════════════════════════════
  # PHASE 3: SYNTHESIS
  # ═══════════════════════════════════════════════════════════════
  phase_synthesis:
    purpose: Compile all iteration findings into final research/research.md
    steps:

      step_fanout_merge:
        description: "Merge N lineage registries into one consolidated registry; skip when single-executor"
        skip_when: "config.fanout is absent"
        command: |
          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \
            --loop-type research \
            --artifact-dir {artifact_dir}
        working_directory: "{repo_root}"
        wait_for_completion: true

      step_hydrate_summary_metrics:
        action: "Hydrate summary metrics before synthesis"
        read:
          - "{state_paths.config}"
          - "{state_paths.state_log}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        read_patterns:
          - "{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl"
          - "{state_paths.packet_dir}/lineages/*/deep-research-strategy.md"
        extract:
          - iteration_count: "When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records."
          - current_iteration: "iteration_count + 1"
          - current_segment: "Latest segment_start event segment, else 1"
          - last_focus: "Extract focus from latest iteration record, else 'none yet'"
          - ratio_prev: "Extract newInfoRatio from second-latest iteration record, else 'N/A'"
          - ratio_latest: "Extract newInfoRatio from latest iteration record, else 'N/A'"
          - remaining_questions: "Count unchecked items in 'Key Questions'"
          - remaining_questions_list: "List unchecked key questions from strategy.md"
          - answered_count: "Count answered questions from strategy.md"
          - total_questions: "Count total questions tracked in strategy.md"
          - last_3_summaries: "Summarize the latest 3 iteration records as 'run N: focus (ratio)'"
          - divergence_summary: "Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'"
          - reason: "Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)"

      step_read_all_iterations:
        action: "Read all iteration files and strategy"
        read_patterns:
          - "{state_paths.iteration_dir}/iteration-*.md"
          - "{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md"
        read_also: "{state_paths.strategy}"
        identity: "Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them."
        selection: "When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations."

      step_emit_resource_map:
        action: "Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false"
        branch_on: "config.fanout"
        if_present:
          command: "node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only"
          read:
            - "{state_paths.config}"
            - "{state_paths.delta_dir}/iter-*.jsonl"
            - "{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl"
        if_absent:
          command: "node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map"
          read:
            - "{state_paths.config}"
            - "{state_paths.delta_dir}/iter-*.jsonl"
        write:
          - "{state_paths.resource_map_output}"
        guarantee: "Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged."

      step_compile_research:
        action: "Compile or finalize research/research.md"
        instructions: |
          If research/research.md exists (progressive synthesis was active):
            1. Read current research/research.md
            2. Consolidate and deduplicate findings across all iterations
            3. Fill any empty sections with findings from iteration files
            4. Remove redundancy while preserving all unique findings
            5. Add convergence report as appendix
            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation
            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.

          If research/research.md does not exist:
            1. Create research/research.md following 17-section template
            2. Populate sections from iteration files
            3. Add citations from original sources
            4. Note unanswered questions in Open Questions section
            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation
            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.
          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.
          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)
        output: "{state_paths.research_output}"

      step_convergence_report:
        action: "Generate and append convergence report"
        report: |
          ## Convergence Report
          - Stop reason: {reason}
          - Total iterations: {iteration_count}
          - Questions answered: {answered_count} / {total_questions}
          - Remaining questions: {remaining_questions}
          - Last 3 iteration summaries: {last_3_summaries}
          - Convergence threshold: {convergence_threshold}
          - Divergence summary: {divergence_summary}
          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.
        command: |
          node --input-type=module <<'EOF'
          import { appendFileSync, existsSync, lstatSync, readFileSync, realpathSync, readdirSync } from 'node:fs';
          import { isAbsolute, join, relative, resolve, sep } from 'node:path';

          const paths = {
            artifactDir: String.raw`{state_paths.packet_dir}`,
            stateLog: String.raw`{state_paths.state_log}`,
            registry: String.raw`{state_paths.registry}`,
            research: String.raw`{state_paths.research_output}`,
            dashboard: String.raw`{state_paths.dashboard}`,
          };

          function hasFile(filePath) {
            try {
              return existsSync(filePath) && !lstatSync(filePath).isSymbolicLink() && lstatSync(filePath).isFile();
            } catch {
              return false;
            }
          }

          function readJson(filePath) {
            try {
              return JSON.parse(readFileSync(filePath, 'utf8'));
            } catch {
              return null;
            }
          }

          function readJsonl(filePath) {
            if (!hasFile(filePath)) return { records: [], parseFailures: 0 };
            const records = [];
            let parseFailures = 0;
            for (const line of readFileSync(filePath, 'utf8').split(/\r?\n/).map((entry) => entry.trim()).filter(Boolean)) {
              try {
                records.push(JSON.parse(line));
              } catch {
                parseFailures += 1;
              }
            }
            return { records, parseFailures };
          }

          function lineageStateLogs(artifactDir) {
            const lineagesDir = join(artifactDir, 'lineages');
            if (!existsSync(lineagesDir)) return [];
            if (lstatSync(lineagesDir).isSymbolicLink() || !lstatSync(lineagesDir).isDirectory()) {
              throw new Error(`lineages must be a real directory: ${lineagesDir}`);
            }
            const root = realpathSync(resolve(artifactDir));
            return readdirSync(lineagesDir, { withFileTypes: true })
              .map((entry) => {
                if (entry.isSymbolicLink()) throw new Error(`lineage must be a real directory: ${join(lineagesDir, entry.name)}`);
                return entry;
              })
              .filter((entry) => entry.isDirectory())
              .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true }))
              .flatMap((entry) => {
                const label = entry.name;
                const candidate = join(lineagesDir, label, 'deep-research-state.jsonl');
                if (!hasFile(candidate)) return [];

