{"type":"tool_use","timestamp":1794531697042,"sessionID":"ses_e2d9479afffe1hhk77mYJ4dg2W","part":{"partID":"prt_1d26ca00a001ynP1ylexH8ECW5","sessionID":"ses_e2d9479afffe1hhk77mYJ4dg2W","messageID":"msg_1d26c816c001MbFxy5on4QuzwF","type":"tool","id":"chatcmpl-tool-a287b2725faed98b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/parent-skill-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/parent-skill-check.cjs, lines 1-1053\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Parent Skill Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * Read-only structural audit for the canonical \"parent hub with nested\n9:  * packets\" pattern.\n10:  *\n11:  * A parent hub keeps ONE advisor identity at the hub and routes to N\n12:  * non-discoverable packets through a declarative mode-registry, with a\n13:  * hub-router describing how a prompt picks/bundles modes. Every packet is a\n14:  * modes[] entry with a required packetKind discriminator (workflow | surface | transport);\n15:  * surface packets are read-only, advisor-invisible evidence bases. Deep-loop's\n16:  * 3-tier machinery is expressed as named `extensions` that activate in-place\n17:  * fields, so the checks are family-agnostic: they run FULL on every hub and\n18:  * only demand extension-specific fields when the hub declares that extension.\n19:  *\n20:  * A hub can sit at a repository root, beside repository files such as spec\n21:  * packets and exports. It declares the repo-root-hub extension, listing those\n22:  * top-level entries in repoPaths. The identity walk and the child-directory\n23:  * check then skip them, and the hub id is the folder name in kebab case, since\n24:  * a repository folder is named for people (\"Product Owner\") rather than tools.\n25:  *\n26:  * Usage:\n27:  *   node parent-skill-check.cjs [parent-skill-dir]\n28:  *   PARENT_HUB_CHECK_STRICT=0 node parent-skill-check.cjs [dir]   # advisory findings as WARN\n29:  *   PARENT_HUB_CHECK_COMMANDS_DIR=<dir> node parent-skill-check.cjs [dir]\n30:  *     # resolve bound /ns:name commands from <dir>/<ns>/<name>.md instead of\n31:  *     # the repository's .skilled/commands (lets a fixture tree exercise 3k)\n32:  *\n33:  * The audit checks hub-router and registry consistency, changelog shape,\n34:  * required hub metadata, playbook and benchmark baseline, leaf-manifest\n35:  * freshness and reachability, skill-root metadata class, routing shape, and\n36:  * routing-version consistency. PARENT_HUB_CHECK_STRICT=0 downgrades advisory\n37:  * findings only; hard failures remain failures.\n38:  *\n39:  * Output: one `PASS: <id>: ...`, `FAIL: <id>: ...`, `WARN: <id>: ...` or\n40:  * `INFO: <id>: ...` line per finding. This format is the documented exemption\n41:  * from bracketed logging: the doctor workflow, CI and the test suites parse\n42:  * the verdict prefix and invariant id at the start of each line.\n43:  *\n44:  * Tool exemption: 3k ignores NON_CAPABILITY_TOOLS (TodoWrite) when it compares\n45:  * a bound command's allowed-tools with its mode's toolSurface.allowed, because\n46:  * a tool that only manages the agent's own task list grants no capability over\n47:  * the workspace and so cannot escalate the mode.\n48:  *\n49:  * Exit codes:\n50:  *   0  every hard invariant passed (warnings allowed)\n51:  *   1  at least one invariant failed\n52:  *   2  target directory missing or unreadable, target is not a parent hub, or the audit could not finish\n53:  */\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 1. IMPORTS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: const fs = require('fs');\n60: const path = require('path');\n61: const { execFileSync } = require('child_process');\n62: // The framework copy is the one holding the authored sentinel under `.skilled` or\n63: // `.opencode`. Resolving from the script's own directory therefore follows the\n64: // copy it was launched from, even when another repository's git root sits above it.\n65: const { findRepoRoot } = require(\n66:   '../../../skills/system-spec-kit/shared/workspace/repo-root.mjs',\n67: );\n68: \n69: // ─────────────────────────────────────────────────────────────────────────────\n70: // 2. CONSTANTS\n71: // ─────────────────────────────────────────────────────────────────────────────\n72: \n73: const EXIT_OK = 0;\n74: const EXIT_INVARIANT_FAILED = 1;\n75: const EXIT_CHECKER_ERROR = 2;\n76: \n77: // Targets and helper paths are repo-root-relative. Resolving them against the\n78: // framework copy that holds the authored sentinel, not process.cwd(), keeps a\n79: // non-root working directory from false-failing 4a or missing the hub entirely.\n80: const REPO_ROOT = findRepoRoot(__dirname);\n81: \n82: // Families the skill-graph compiler accepts for a discoverable identity.\n83: // Mirrors ALLOWED_FAMILIES in skill_graph_compiler.py / skill-graph-db.ts;\n84: // a family outside this set makes the hub undiscoverable.\n85: const ALLOWED_FAMILIES = ['cli', 'mcp', 'sk-code', 'sk-hub', 'deep-loop', 'sk-util', 'system'];\n86: \n87: // The advisor reaches a mode through one of these classes; the registry\n88: // declares it per mode so the projection maps stay auditable. 'metadata' is the\n89: // default for new hubs and for every surface packet (advisor-invisible).\n90: const VALID_ROUTING_CLASSES = ['lexical', 'alias-fold', 'metadata', 'command-bridge'];\n91: \n92: // The graph-backed convergence loop keys consumed by a runtime-loop backend.\n93: // null is the explicit value for host/adapter modes; only demanded when the hub\n94: // declares the runtime-loop extension.\n95: const VALID_RUNTIME_LOOP_TYPES = ['research', 'review', 'council', null];\n96: \n97: // Read-only tool set a surface packet's toolSurface.allowed must stay within,\n98: // and the tools every non-mutating packet (surface or transport) must forbid.\n99: const SURFACE_ALLOWED_TOOLS = ['Read', 'Bash', 'Grep', 'Glob'];\n100: const NON_MUTATING_FORBIDDEN_TOOLS = ['Write', 'Edit', 'Task'];\n101: \n102: // Tools a command may grant beyond its mode without escalating it (3k).\n103: // TodoWrite edits only the agent's own task list, never the workspace.\n104: const NON_CAPABILITY_TOOLS = ['TodoWrite'];\n105: \n106: // The extension a hub at a repository root declares, and the files a hub root\n107: // owns, which repoPaths can never name.\n108: const REPO_ROOT_HUB_EXTENSION = 'repo-root-hub';\n109: const HUB_ROOT_FILES = new Set([\n110:   'SKILL.md', 'ROUTER.md', 'README.md', 'mode-registry.json', 'hub-router.json', 'description.json',\n111:   'graph-metadata.json', 'leaf-manifest.json', 'leaf-aliases.json', 'changelog', 'manual-testing-playbook',\n112: ]);\n113: \n114: // Directories allowed at a hub root without being a registered packet.\n115: const DIRECTORY_ALLOWLIST = new Set([\n116:   'shared', 'changelog', 'benchmark',\n117:   'manual-testing-playbook', 'feature-catalog',\n118:   'references', 'assets', 'node_modules', 'scripts', 'templates', 'dist', 'runtime', 'styles',\n119: ]);\n120: \n121: // The deep-loop reference drift-guard. A hub with lexical/alias-fold modes must\n122: // point at ITS OWN drift-guard (advisorRoutingContract.driftGuard or the\n123: // advisor-projection extension); this is only the fallback for deep-loop.\n124: const DEEP_LOOP_DRIFT_GUARD =\n125:   '.skilled/skills/system-skill-advisor/runtime/tests/routing-registry-drift-guard.vitest.ts';\n126: \n127: // Advisor entrypoint for the dynamic cross-check of the registry's lexical\n128: // projection against the live hardcoded map.\n129: const ADVISOR_SCRIPT =\n130:   '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py';\n131: const ADVISOR_SCRIPT_ABS = path.resolve(REPO_ROOT, ADVISOR_SCRIPT);\n132: \n133: // The advisor dump imports the scorer, which takes seconds on a cold cache.\n134: // Past this budget the cross-check is reported as unable to run.\n135: const ADVISOR_DUMP_TIMEOUT_MS = 15000;\n136: \n137: // The single global advisor projection map only mirrors this hub, so the\n138: // dynamic 4b equality check applies to it; every other hub gets the inert-route\n139: // coverage check (4c) instead.\n140: const GLOBAL_MAP_OWNER = 'system-deep-loop';\n141: \n142: const DEFAULT_TARGET = '.skilled/skills/system-deep-loop';\n143: \n144: // Shared contract libraries and the leaf-manifest generator live once in the\n145: // repository under sk-doc. They are resolved from the repo root so a hub\n146: // outside .skilled/skills, such as a fixture, audits against the same code.\n147: const SK_CREATE_SKILL_SCRIPTS = path.join(REPO_ROOT, '.skilled', 'skills', 'sk-doc', 'sk-create-skill', 'scripts');\n148: const LEAF_GENERATOR_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'generate-leaf-manifest.cjs');\n149: const LEAF_CONTRACT_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'leaf-resource-contract.cjs');\n150: // The compiled-routing tree keeps one canary fixture per parent hub, each in a folder named `<number>-<hub>`.\n151: const CANARY_FIXTURE_ROOT = path.join(REPO_ROOT, '.skilled/bin/lib/compiled-routing/009-parent-hub-rollout');\n152: const ROOT_METADATA_CONTRACT_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'skill-root-metadata-contract.cjs');\n153: const ROOT_ROUTER_CONTRACT_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'root-router-contract.cjs');\n154: // The known-debt ledger reader is shared with the fleet gate, so both JS checks\n155: // read a skill's recorded shape the same way.\n156: const { loadRoutingShapeDebt } = require(path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'routing-shape-debt.cjs'));\n157: \n158: // Bound commands resolve from here; the override lets a fixture supply them.\n159: const COMMANDS_DIR = process.env.PARENT_HUB_CHECK_COMMANDS_DIR\n160:   ? path.resolve(process.env.PARENT_HUB_CHECK_COMMANDS_DIR)\n161:   : path.join(REPO_ROOT, '.skilled', 'commands');\n162: \n163: // A slash command id: /namespace:name, both kebab-case.\n164: const COMMAND_PATTERN = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n165: const FOUR_PART_VERSION = /^[0-9]+(?:\\.[0-9]+){3}$/;\n166: \n167: // Advisory hub-canon findings are FAIL by default. The strict opt-out changes\n168: // only their severity; hard failures remain failures.\n169: const STRICT_HUB_CANON = process.env.PARENT_HUB_CHECK_STRICT !== '0';\n170: \n171: // ─────────────────────────────────────────────────────────────────────────────\n172: // 3. OUTPUT HELPERS\n173: // ─────────────────────────────────────────────────────────────────────────────\n174: \n175: const IS_TTY = Boolean(process.stdout.isTTY);\n176: function color(text, code) {\n177:   return IS_TTY ? `\\x1b[${code}m${text}\\x1b[0m` : text;\n178: }\n179: const red = (s) => color(s, '31');\n180: const green = (s) => color(s, '32');\n181: const yellow = (s) => color(s, '33');\n182: const blue = (s) => color(s, '34');\n183: \n184: let fails = 0;\n185: let warns = 0;\n186: function pass(msg) {\n187:   console.log(`${green('PASS')}: ${msg}`);\n188: }\n189: function fail(msg) {\n190:   console.error(`${red('FAIL')}: ${msg}`);\n191:   fails += 1;\n192: }\n193: function warn(msg) {\n194:   console.error(`${yellow('WARN')}: ${msg}`);\n195:   warns += 1;\n196: }\n197: function info(msg) {\n198:   console.log(`${blue('INFO')}: ${msg}`);\n199: }\n200: // Canon severity: FAIL by default (STRICT_HUB_CANON), WARN only when a\n201: // work-in-progress hub opts out via PARENT_HUB_CHECK_STRICT=0.\n202: function softFail(msg) {\n203:   (STRICT_HUB_CANON ? fail : warn)(msg);\n204: }\n205: \n206: // ─────────────────────────────────────────────────────────────────────────────\n207: // 4. FILE AND PARSE HELPERS\n208: // ─────────────────────────────────────────────────────────────────────────────\n209: \n210: function isPlainObject(value) {\n211:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n212: }\n213: \n214: // \"Product Owner\" -> \"product-owner\".\n215: function kebabCase(name) {\n216:   return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\n217: }\n218: \n219: // The repo-root-hub declaration, read before the identity check needs it. A\n220: // malformed registry or extension reads as undeclared here, and 3a or 3f reports it.\n221: function readRepoRootHub(target) {\n222:   let registry;\n223:   try {\n224:     registry = readJson(path.join(target, 'mode-registry.json'));\n225:   } catch {\n226:     return { declared: false, repoPaths: new Set() };\n227:   }\n228:   const extensions = isPlainObject(registry) && isPlainObject(registry.extensions) ? registry.extensions : {};\n229:   if (!Object.prototype.hasOwnProperty.call(extensions, REPO_ROOT_HUB_EXTENSION)) {\n230:     return { declared: false, repoPaths: new Set() };\n231:   }\n232:   const declaration = extensions[REPO_ROOT_HUB_EXTENSION];\n233:   const listed = isPlainObject(declaration) && Array.isArray(declaration.repoPaths) ? declaration.repoPaths : [];\n234:   return { declared: true, repoPaths: new Set(listed.filter((p) => typeof p === 'string')) };\n235: }\n236: \n237: function describeJson(value) {\n238:   if (value === null) return 'null';\n239:   return Array.isArray(value) ? 'an array' : typeof value;\n240: }\n241: \n242: function readJson(file) {\n243:   return JSON.parse(fs.readFileSync(file, 'utf8'));\n244: }\n245: \n246: // Parse a file that must hold a JSON object. A literal null or an array is a\n247: // defect of the file, not an absent value, so it is returned as an error.\n248: function readJsonObject(file) {\n249:   let parsed;\n250:   try {\n251:     parsed = readJson(file);\n252:   } catch (e) {\n253:     return { value: null, error: `is not valid JSON: ${e.message}` };\n254:   }\n255:   if (!isPlainObject(parsed)) {\n256:     return { value: null, error: `is not a JSON object (got ${describeJson(parsed)})` };\n257:   }\n258:   return { value: parsed, error: null };\n259: }\n260: \n261: function isDirectory(p) {\n262:   try {\n263:     return fs.statSync(p).isDirectory();\n264:   } catch {\n265:     return false;\n266:   }\n267: }\n268: \n269: function isSymlink(p) {\n270:   try {\n271:     return fs.lstatSync(p).isSymbolicLink();\n272:   } catch {\n273:     return false;\n274:   }\n275: }\n276: \n277: // Recursively collect every regular file whose name is in `names`, keyed by name.\n278: // `skipTopLevel` names entries directly under `dir` that are never entered.\n279: function collectFilesNamed(dir, names, skipTopLevel = new Set()) {\n280:   const found = new Map(names.map((name) => [name, []]));\n281:   const stack = [dir];\n282:   while (stack.length > 0) {\n283:     const current = stack.pop();\n284:     let entries;\n285:     try {\n286:       entries = fs.readdirSync(current, { withFileTypes: true });\n287:     } catch {\n288:       continue;\n289:     }\n290:     for (const entry of entries) {\n291:       const full = path.join(current, entry.name);\n292:       if (current === dir && skipTopLevel.has(entry.name)) continue;\n293:       if (entry.isDirectory()) {\n294:         stack.push(full);\n295:       } else if (entry.isFile() && found.has(entry.name)) {\n296:         found.get(entry.name).push(full);\n297:       }\n298:     }\n299:   }\n300:   return found;\n301: }\n302: \n303: // Every changelog file that is a symlink, beneath a changelog/ directory.\n304: function symlinkedChangelogs(root) {\n305:   const out = [];\n306:   const stack = [root];\n307:   while (stack.length > 0) {\n308:     const current = stack.pop();\n309:     let entries;\n310:     try {\n311:       entries = fs.readdirSync(current, { withFileTypes: true });\n312:     } catch {\n313:       continue;\n314:     }\n315:     for (const entry of entries) {\n316:       const full = path.join(current, entry.name);\n317:       if (entry.isSymbolicLink()) {\n318:         if (current.split(path.sep).includes('changelog') || entry.name.startsWith('CHANGELOG')) {\n319:           out.push(full);\n320:         }\n321:       } else if (entry.isDirectory() && entry.name !== 'node_modules') {\n322:         stack.push(full);\n323:       }\n324:     }\n325:   }\n326:   return out;\n327: }\n328: \n329: // Flatten a validated leaf-manifest.json object into its (workflowMode,\n330: // leafResourceId) pairs.\n331: function manifestCompositePairs(manifestObject) {\n332:   const pairs = [];\n333:   for (const mode of (manifestObject && Array.isArray(manifestObject.modes) ? manifestObject.modes : [])) {\n334:     for (const leaf of (Array.isArray(mode.leaves) ? mode.leaves : [])) {\n335:       pairs.push({ workflowMode: mode.workflowMode, leafResourceId: leaf, packet: mode.packet });\n336:     }\n337:   }\n338:   return pairs;\n339: }\n340: \n341: function escapeRegExp(text) {\n342:   return text.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n343: }\n344: \n345: // Word-boundary match so a longer neighbouring id or command cannot satisfy a\n346: // shorter one (\"review\" inside \"sk-code-review\", \"/a:b\" inside \"/a:b-two\").\n347: function tokenPattern(token) {\n348:   return new RegExp(`(^|[^A-Za-z0-9_-])${escapeRegExp(token)}([^A-Za-z0-9_-]|$)`);\n349: }\n350: \n351: // The id a mode-table row is about: the first identifier in its first cell,\n352: // with markdown emphasis and code ticks stripped.\n353: function firstCellId(row) {\n354:   const cell = row.trim().replace(/^\\|/, '').split('|')[0] || '';\n355:   const match = cell.match(/^[\\s*_`]*([A-Za-z0-9_.:-]+)/);\n356:   return match ? match[1] : null;\n357: }\n358: \n359: function isToolSurface(ts) {\n360:   return isPlainObject(ts) && Array.isArray(ts.allowed) && Array.isArray(ts.forbidden)\n361:     && typeof ts.mutatesWorkspace === 'boolean' && Array.isArray(ts.bashAllowlist);\n362: }\n363: \n364: // A tool list from a toolSurface, or [] when the field is not an array; the\n365: // malformed shape itself is reported once by 3d.\n366: function toolList(ts, field) {\n367:   return isPlainObject(ts) && Array.isArray(ts[field]) ? ts[field] : [];\n368: }\n369: \n370: // A packet value must name one directory directly under the hub.\n371: function isDirectChildName(packet) {\n372:   const trimmed = packet.replace(/[\\\\/]+$/, '');\n373:   return trimmed.length > 0 && trimmed !== '.' && trimmed !== '..'\n374:     && !/[\\\\/]/.test(trimmed) && !path.isAbsolute(packet);\n375: }\n376: \n377: // The tools a frontmatter `allowed-tools` field grants, read the three ways\n378: // YAML writes a list: a flow list ([Read, Write]), a bare comma string\n379: // (Read, Write) or a block sequence. Null when there is no field to read.\n380: function parseAllowedTools(source) {\n381:   const frontmatter = source.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n382:   if (!frontmatter) return null;\n383:   const lines = frontmatter[1].split(/\\r?\\n/);\n384:   const index = lines.findIndex((line) => /^allowed-tools:/.test(line));\n385:   if (index === -1) return null;\n386:   const inline = lines[index].slice('allowed-tools:'.length).replace(/\\s+#.*$/, '').trim();\n387:   const items = [];\n388:   if (inline) {\n389:     items.push(...inline.replace(/^\\[/, '').replace(/\\]$/, '').split(','));\n390:   } else {\n391:     for (const line of lines.slice(index + 1)) {\n392:       const entry = line.match(/^\\s+-\\s*(.*)$/);\n393:       if (!entry) break;\n394:       items.push(entry[1]);\n395:     }\n396:   }\n397:   return items.map((t) => t.trim().replace(/^(['\"])(.*)\\1$/, '$2').trim()).filter(Boolean);\n398: }\n399: \n400: function loadModule(file) {\n401:   if (!fs.existsSync(file)) return { module: null, missing: true, error: null };\n402:   try {\n403:     // eslint-disable-next-line global-require, import/no-dynamic-require\n404:     return { module: require(file), missing: false, error: null };\n405:   } catch (e) {\n406:     return { module: null, missing: false, error: e };\n407:   }\n408: }\n409: \n410: // ─────────────────────────────────────────────────────────────────────────────\n411: // 5. IDENTITY CHECKS (1a-1c, 2a-2b)\n412: // ─────────────────────────────────────────────────────────────────────────────\n413: \n414: function checkIdentity(ctx) {\n415:   const { target, basename } = ctx;\n416:   const found = collectFilesNamed(target, ['graph-metadata.json', 'description.json'], ctx.repoRootHub.repoPaths);\n417:   const metaFiles = found.get('graph-metadata.json');\n418:   const hubMeta = path.join(target, 'graph-metadata.json');\n419: \n420:   if (metaFiles.length === 1 && metaFiles[0] === hubMeta) {\n421:     pass('1a: exactly one graph-metadata.json, located at the hub root');\n422:   } else if (metaFiles.length === 0) {\n423:     fail('1a: no graph-metadata.json found — the hub has no discoverable identity');\n424:   } else {\n425:     const rel = metaFiles.map((f) => path.relative(target, f) || '.');\n426:     fail(`1a: expected exactly one graph-metadata.json at the hub root; found ${metaFiles.length}: ${rel.join(', ')}`);\n427:   }\n428: \n429:   if (fs.existsSync(hubMeta)) {\n430:     const { value: meta, error } = readJsonObject(hubMeta);\n431:     if (error) {\n432:       fail(`1b: hub graph-metadata.json ${error}`);\n433:     } else {\n434:       if (meta.skill_id === basename) {\n435:         pass(`1b: hub skill_id \"${meta.skill_id}\" matches directory name`);\n436:       } else {\n437:         const named = ctx.repoRootHub.declared\n438:           ? `the kebab-case directory name \"${basename}\"`\n439:           : `directory name \"${basename}\"`;\n440:         fail(`1b: hub skill_id \"${meta.skill_id}\" does not match ${named}`);\n441:       }\n442:       if (ALLOWED_FAMILIES.includes(meta.family)) {\n443:         pass(`1c: hub family \"${meta.family}\" is in the allowed set`);\n444:       } else {\n445:         fail(`1c: hub family \"${meta.family}\" not in allowed set {${ALLOWED_FAMILIES.join(', ')}}`);\n446:       }\n447:     }\n448:   } else {\n449:     fail('1b: no hub graph-metadata.json at the root — cannot check identity');\n450:   }\n451: \n452:   // 2a: a nested graph-metadata.json re-introduces a second identity.\n453:   const nested = metaFiles.filter((f) => f !== hubMeta);\n454:   if (nested.length === 0) {\n455:     pass('2a: no nested graph-metadata.json inside any packet or shared/');\n456:   } else {\n457:     const rel = nested.map((f) => path.relative(target, f));\n458:     fail(`2a: nested graph-metadata.json found (re-introduces a second identity): ${rel.join(', ')}`);\n459:   }\n460: \n461:   // 2b: the advisor identity is hub-only; a nested description.json is dead residue.\n462:   const nestedDesc = found.get('description.json').filter((f) => f !== path.join(target, 'description.json'));\n463:   if (nestedDesc.length === 0) {\n464:     pass('2b: no nested description.json inside any packet or shared/');\n465:   } else {\n466:     const rel = nestedDesc.map((f) => path.relative(target, f));\n467:     fail(`2b: nested description.json found (re-introduces a second advisor identity): ${rel.join(', ')}`);\n468:   }\n469: }\n470: \n471: // ─────────────────────────────────────────────────────────────────────────────\n472: // 6. REGISTRY CHECKS (3a-3k)\n473: // ─────────────────────────────────────────────────────────────────────────────\n474: \n475: // 3a: load mode-registry.json and derive the per-hub facts later checks share.\n476: function loadRegistry(ctx) {\n477:   const registryPath = path.join(ctx.target, 'mode-registry.json');\n478:   if (!fs.existsSync(registryPath)) {\n479:     fail('3a: mode-registry.json is missing');\n480:     return;\n481:   }\n482:   const { value, error } = readJsonObject(registryPath);\n483:   if (error) {\n484:     fail(`3a: mode-registry.json ${error}`);\n485:     return;\n486:   }\n487:   pass('3a: mode-registry.json exists and parses as JSON');\n488:   ctx.registry = value;\n489:   ctx.extensions = isPlainObject(value.extensions) ? value.extensions : {};\n490:   const declares = (name) => Object.prototype.hasOwnProperty.call(ctx.extensions, name);\n491:   ctx.ext = {\n492:     runtimeLoop: declares('runtime-loop'),\n493:     advisorProjection: declares('advisor-projection'),\n494:     surfaceAxis: declares('surface-axis'),\n495:     transportAxis: declares('transport-axis'),\n496:     commandSubworkflows: declares('command-subworkflows'),\n497:     repoRootHub: declares(REPO_ROOT_HUB_EXTENSION),\n498:   };\n499:   ctx.rawModes = Array.isArray(value.modes) ? value.modes : [];\n500:   ctx.modes = ctx.rawModes.filter(isPlainObject);\n501:   ctx.registryModeSet = new Set(ctx.modes.map((m) => m.workflowMode).filter(Boolean));\n502: }\n503: \n504: function newModeState() {\n505:   return {\n506:     packetOk: true,\n507:     discriminatorOk: true, // hard: workflowMode + backendKind presence\n508:     canonOk: true, // canon (FAIL by default): packetKind, toolSurface, names, aliases, runtimeLoopType\n509:     routingOk: true,\n510:     surfaceOk: true,\n511:     transportOk: true,\n512:     transportCount: 0,\n513:     writeOk: true,\n514:     commandOk: true,\n515:     commandsCompared: 0,\n516:     folderNameOk: true, // folder == packetSkillName unless grandfatheredFolderMismatch\n517:     frontmatterNameOk: true, // packet SKILL.md frontmatter name == packetSkillName\n518:     frontmatterNamesChecked: 0,\n519:     packetFilesOk: true, // each packet carries SKILL.md + README.md + changelog/\n520:     aliasOk: true, // aliases unique across all modes\n521:     aliasSeen: new Map(), // alias (lowercased) → first mode that declared it\n522:   };\n523: }\n524: \n525: // 3c: every mode's packet value must be a DIRECT child sub-dir.\n526: function checkModePacket(ctx, mode, label, state) {\n527:   const { packet } = mode;\n528:   if (!packet || typeof packet !== 'string') {\n529:     fail(`3c: mode \"${label}\" has no packet value`);\n530:     state.packetOk = false;\n531:     return false;\n532:   }\n533:   if (!isDirectChildName(packet)) {\n534:     fail(`3c: mode \"${label}\" packet \"${packet}\" must be a direct child directory (no absolute, nested, \".\" or \"../\" paths)`);\n535:     state.packetOk = false;\n536:     return false;\n537:   }\n538:   ctx.registeredPackets.add(packet.replace(/[\\\\/]+$/, ''));\n539:   if (!isDirectory(path.join(ctx.target, packet))) {\n540:     fail(`3c: mode \"${label}\" packet \"${packet}\" is not an existing sub-directory; if this surface packet was removed on purpose, finish the removal with the README.md block \"What Adapting \\`sk-code\\` Looks Like\"`);\n541:     state.packetOk = false;\n542:     return false;\n543:   }\n544:   return true;\n545: }\n546: \n547: // 3d: two-axis discriminator. HARD: workflowMode + backendKind presence.\n548: // CANON (softFail): packetKind, grandfatheredFolderMismatch, packetSkillName\n549: // and aliases, the fields each hub carries once it adopts the two-axis shape.\n550: function checkModeDiscriminator(mode, label, state) {\n551:   const kind = mode.packetKind;\n552:   if (typeof mode.workflowMode !== 'string' || mode.workflowMode.length === 0) {\n553:     fail(`3d: mode \"${label}\" is missing workflowMode`);\n554:     state.discriminatorOk = false;\n555:   }\n556:   // backendKind is presence-checked only: hub families name their own\n557:   // descriptive backends; the one constrained case is a surface packet (3g).\n558:   if (typeof mode.backendKind !== 'string' || mode.backendKind.length === 0) {\n559:     fail(`3d: mode \"${label}\" is missing backendKind`);\n560:     state.discriminatorOk = false;\n561:   }\n562:   if (kind !== 'workflow' && kind !== 'surface' && kind !== 'transport') {\n563:     softFail(`3d: mode \"${label}\" has invalid packetKind ${JSON.stringify(kind)} (expected \"workflow\", \"surface\", or \"transport\")`);\n564:     state.canonOk = false;\n565:   }\n566:   if (typeof mode.grandfatheredFolderMismatch !== 'boolean') {\n567:     softFail(`3d: mode \"${label}\" is missing the grandfatheredFolderMismatch boolean`);\n568:     state.canonOk = false;\n569:   }\n570:   if (typeof mode.packetSkillName !== 'string' || mode.packetSkillName.length === 0) {\n571:     softFail(`3d: mode \"${label}\" is missing packetSkillName (the packet SKILL.md name)`);\n572:     state.canonOk = false;\n573:   }\n574:   if (!Array.isArray(mode.aliases) || mode.aliases.some((a) => typeof a !== 'string' || a.trim().length === 0)) {\n575:     softFail(`3d: mode \"${label}\" is missing an aliases array of non-empty strings`);\n576:     state.canonOk = false;\n577:   }\n578: }\n579: \n580: // 3d-name: folder == packetSkillName unless the mismatch is explicitly\n581: // grandfathered, and the packet SKILL.md frontmatter name agrees.\n582: function checkModeNaming(ctx, mode, label, state, packetUsable) {\n583:   if (typeof mode.packet !== 'string' || typeof mode.packetSkillName !== 'string') return;\n584:   // A mode may not ship grandfatheredFolderMismatch:false while its folder and\n585:   // packetSkillName actually diverge: that is a silent, un-grandfathered mismatch.\n586:   const folderLeaf = mode.packet.replace(/[\\\\/]+$/, '').split(/[\\\\/]/).pop();\n587:   const nameMismatch = folderLeaf !== mode.packetSkillName;\n588:   if (mode.grandfatheredFolderMismatch === false && nameMismatch) {\n589:     softFail(`3d-name: mode \"${label}\" folder \"${folderLeaf}\" != packetSkillName \"${mode.packetSkillName}\" but grandfatheredFolderMismatch is false (set it true to preserve a real mismatch)`);\n590:     state.folderNameOk = false;\n591:   } else if (mode.grandfatheredFolderMismatch === true && !nameMismatch) {\n592:     softFail(`3d-name: mode \"${label}\" sets grandfatheredFolderMismatch:true but folder \"${folderLeaf}\" == packetSkillName (stale flag — set it false; a blanket-true flag would mask a real future mismatch)`);\n593:     state.folderNameOk = false;\n594:   }\n595:   if (!packetUsable) return;\n596:   // Missing frontmatter/name is owned by a separate check.\n597:   const skillFile = path.join(ctx.target, mode.packet, 'SKILL.md');\n598:   if (!fs.existsSync(skillFile) || !fs.statSync(skillFile).isFile()) return;\n599:   const frontmatter = fs.readFileSync(skillFile, 'utf8').match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n600:   const nameMatch = frontmatter && frontmatter[1].match(/^name:\\s*(.+)$/m);\n601:   if (!nameMatch) return;\n602:   const frontmatterName = nameMatch[1].trim().replace(/^(['\"])(.*)\\1$/, '$2').trim();\n603:   state.frontmatterNamesChecked += 1;\n604:   if (frontmatterName !== mode.packetSkillName) {\n605:     softFail(`3d-name-frontmatter: packet \"${mode.packet}\" SKILL.md frontmatter name \"${frontmatterName}\" != packetSkillName \"${mode.packetSkillName}\"`);\n606:     state.folderNameOk = false;\n607:     state.frontmatterNameOk = false;\n608:   }\n609: }\n610: \n611: // 3d-files: every packet carries its companion files.\n612: function checkModeFiles(ctx, mode, state) {\n613:   const pdir = path.join(ctx.target, mode.packet);\n614:   for (const companion of ['SKILL.md', 'README.md']) {\n615:     if (!fs.existsSync(path.join(pdir, companion))) {\n616:       softFail(`3d-files: packet \"${mode.packet}\" is missing companion ${companion}`);\n617:       state.packetFilesOk = false;\n618:     }\n619:   }\n620:   if (!isDirectory(path.join(pdir, 'changelog'))) {\n621:     softFail(`3d-files: packet \"${mode.packet}\" is missing a changelog/ directory`);\n622:     state.packetFilesOk = false;\n623:   }\n624: }\n625: \n626: // 3d-alias: aliases are unique across modes and lowercase. The router matches\n627: // vocabulary case-folded, so a mixed-case alias cannot mirror its vocabulary\n628: // class; that half is advisory (WARN) because live hubs still carry them.\n629: function checkModeAliases(mode, label, state) {\n630:   for (const a of (Array.isArray(mode.aliases) ? mode.aliases : [])) {\n631:     if (typeof a !== 'string') continue;\n632:     const key = a.toLowerCase();\n633:     if (state.aliasSeen.has(key)) {\n634:       softFail(`3d-alias: alias ${JSON.stringify(a)} on mode \"${label}\" duplicates mode \"${state.aliasSeen.get(key)}\" (aliases must be unique across modes)`);\n635:       state.aliasOk = false;\n636:     } else {\n637:       state.aliasSeen.set(key, label);\n638:     }\n639:     if (a !== key) {\n640:       warn(`3d-alias: alias ${JSON.stringify(a)} on mode \"${label}\" is not lowercase (router vocabulary is matched case-folded)`);\n641:     }\n642:   }\n643: }\n644: \n645: // 3d: toolSurface shape on every mode, and runtimeLoopType only where the\n646: // runtime-loop extension activates it.\n647: function checkModeToolSurface(ctx, mode, label, state) {\n648:   if (!isToolSurface(mode.toolSurface)) {\n649:     softFail(`3d: mode \"${label}\" has a malformed toolSurface (need {allowed[], forbidden[], mutatesWorkspace:bool, bashAllowlist[]})`);\n650:     state.canonOk = false;\n651:   }\n652:   const hasLoopType = 'runtimeLoopType' in mode;\n653:   if (ctx.ext.runtimeLoop && mode.packetKind === 'workflow') {\n654:     if (!hasLoopType) {\n655:       softFail(`3d: mode \"${label}\" is missing runtimeLoopType (runtime-loop extension declared; null is allowed, absence is not)`);\n656:       state.canonOk = false;\n657:     } else if (!VALID_RUNTIME_LOOP_TYPES.includes(mode.runtimeLoopType)) {\n658:       softFail(`3d: mode \"${label}\" has invalid runtimeLoopType ${JSON.stringify(mode.runtimeLoopType)} (expected one of {research, review, council, null})`);\n659:       state.canonOk = false;\n660:     }\n661:   } else if (hasLoopType && !ctx.ext.runtimeLoop) {\n662:     softFail(`3d: mode \"${label}\" declares runtimeLoopType but the hub does not declare the runtime-loop extension`);\n663:     state.canonOk = false;\n664:   } else if (hasLoopType && !VALID_RUNTIME_LOOP_TYPES.includes(mode.runtimeLoopType)) {\n665:     softFail(`3d: mode \"${label}\" declares runtimeLoopType ${JSON.stringify(mode.runtimeLoopType)} outside the valid set`);\n666:     state.canonOk = false;\n667:   }\n668: }\n669: \n670: // 3e: advisorRouting block with a valid routingClass.\n671: function checkModeRouting(mode, label, state) {\n672:   const routing = mode.advisorRouting;\n673:   if (!isPlainObject(routing)) {\n674:     fail(`3e: mode \"${label}\" is missing an advisorRouting block`);\n675:     state.routingOk = false;\n676:   } else if (!VALID_ROUTING_CLASSES.includes(routing.routingClass)) {\n677:     fail(`3e: mode \"${label}\" has invalid routingClass ${JSON.stringify(routing.routingClass)} (expected one of {${VALID_ROUTING_CLASSES.join(', ')}})`);\n678:     state.routingOk = false;\n679:   }\n680: }\n681: \n682: // 3g: surface packets are read-only, evidence-base, advisor-invisible.\n683: function checkSurfaceMode(mode, label, state) {\n684:   const routing = mode.advisorRouting;\n685:   const ts = mode.toolSurface;\n686:   if (mode.backendKind !== 'evidence-base') {\n687:     softFail(`3g: surface packet \"${label}\" must be backendKind \"evidence-base\" (got ${JSON.stringify(mode.backendKind)})`);\n688:     state.surfaceOk = false;\n689:   }\n690:   if (isPlainObject(routing) && routing.routingClass !== 'metadata') {\n691:     softFail(`3g: surface packet \"${label}\" must be routingClass \"metadata\" (advisor-invisible)`);\n692:     state.surfaceOk = false;\n693:   }\n694:   if (!isPlainObject(ts)) return;\n695:   if (ts.mutatesWorkspace !== false) {\n696:     softFail(`3g: surface packet \"${label}\" toolSurface must be read-only (mutatesWorkspace:false)`);\n697:     state.surfaceOk = false;\n698:   }\n699:   const strayAllowed = toolList(ts, 'allowed').filter((t) => !SURFACE_ALLOWED_TOOLS.includes(t));\n700:   if (strayAllowed.length > 0) {\n701:     softFail(`3g: surface packet \"${label}\" allows non-read-only tools [${strayAllowed.join(', ')}] (allowed ⊆ {${SURFACE_ALLOWED_TOOLS.join(', ')}})`);\n702:     state.surfaceOk = false;\n703:   }\n704:   const forbidden = toolList(ts, 'forbidden');\n705:   const missingForbidden = NON_MUTATING_FORBIDDEN_TOOLS.filter((t) => !forbidden.includes(t));\n706:   if (missingForbidden.length > 0) {\n707:     softFail(`3g: surface packet \"${label}\" must forbid [${missingForbidden.join(', ')}]`);\n708:     state.surfaceOk = false;\n709:   }\n710: }\n711: \n712: // 3h: transport packets bridge to an external tool's CLI/MCP surface:\n713: // metadata-routed (advisor-invisible), non-mutating in THIS repo (writes\n714: // land in the external tool), never orchestrating, and declared on the\n715: // transport-axis extension so the axis is registered, not ad-hoc.\n716: function checkTransportMode(ctx, mode, label, state) {\n717:   const routing = mode.advisorRouting;\n718:   const ts = mode.toolSurface;\n719:   state.transportCount += 1;\n720:   if (isPlainObject(routing) && routing.routingClass !== 'metadata') {\n721:     softFail(`3h: transport packet \"${label}\" must be routingClass \"metadata\" (advisor-invisible)`);\n722:     state.transportOk = false;\n723:   }\n724:   if (isPlainObject(ts) && ts.mutatesWorkspace !== false) {\n725:     softFail(`3h: transport packet \"${label}\" toolSurface must be mutatesWorkspace:false (writes land in the external tool, not this repo)`);\n726:     state.transportOk = false;\n727:   }\n728:   const forbidden = toolList(ts, 'forbidden');\n729:   const missing = NON_MUTATING_FORBIDDEN_TOOLS.filter((t) => !forbidden.includes(t));\n730:   if (missing.length > 0) {\n731:     softFail(`3h: transport packet \"${label}\" must forbid [${missing.join(', ')}]`);\n732:     state.transportOk = false;\n733:   }\n734:   const axis = ctx.extensions['transport-axis'];\n735:   if (!isPlainObject(axis) || !Array.isArray(axis.transports) || !axis.transports.includes(mode.workflowMode)) {\n736:     softFail(`3h: transport packet \"${label}\" is not declared in the transport-axis extension's transports[]`);\n737:     state.transportOk = false;\n738:   }\n739: }\n740: \n741: // 3i: a mode that grants Write must declare mutatesWorkspace:true (writing a\n742: // file mutates the workspace) UNLESS it carries a writeScopeNote documenting a\n743: // non-project Write scope (e.g. an ephemeral, untracked cache).\n744: function checkWriteGrant(mode, label, state) {\n745:   const ts = mode.toolSurface;\n746:   if (!toolList(ts, 'allowed').includes('Write')) return;\n747:   const annotated = typeof ts.writeScopeNote === 'string' && ts.writeScopeNote.trim().length > 0;\n748:   if (ts.mutatesWorkspace !== true && !annotated) {\n749:     softFail(`3i: mode \"${label}\" grants Write but is mutatesWorkspace:false with no writeScopeNote (Write mutates the workspace — set mutatesWorkspace:true or annotate a non-project Write scope)`);\n750:     state.writeOk = false;\n751:   }\n752: }\n753: \n754: // 3k: a bound command's frontmatter must not grant tools beyond the mode's\n755: // toolSurface.allowed; the command is an entrypoint into the mode, and a wider\n756: // grant silently escalates the mode's declared tool contract.\n757: function checkCommandGrant(mode, label, state) {\n758:   const ts = mode.toolSurface;\n759:   if (typeof mode.command !== 'string' || !isPlainObject(ts) || !Array.isArray(ts.allowed)) return;\n760:   const cm = mode.command.match(COMMAND_PATTERN);\n761:   const cmdFile = cm ? path.join(COMMANDS_DIR, cm[1], `${cm[2]}.md`) : null;\n762:   if (!cmdFile || !fs.existsSync(cmdFile)) return;\n763:   const granted = parseAllowedTools(fs.readFileSync(cmdFile, 'utf8'));\n764:   if (!granted) return;\n765:   state.commandsCompared += 1;\n766:   const modeAllowed = new Set(ts.allowed);\n767:   const over = granted.filter((t) => !modeAllowed.has(t) && !NON_CAPABILITY_TOOLS.includes(t));\n768:   if (over.length > 0) {\n769:     softFail(`3k: command ${mode.command} frontmatter grants tool(s) [${over.join(', ')}] beyond mode \"${label}\" toolSurface.allowed`);\n770:     state.commandOk = false;\n771:   }\n772: }\n773: \n774: function reportModeState(ctx, state) {\n775:   if (state.packetOk) pass('3c: every mode packet resolves to an existing sub-directory');\n776:   if (state.discriminatorOk) pass('3d: every mode carries the hard discriminator (workflowMode + backendKind)');\n777:   if (state.canonOk) pass('3d-canon: every mode carries packetKind + toolSurface + grandfatheredFolderMismatch + packetSkillName + aliases');\n778:   if (state.folderNameOk) pass('3d-name: every mode folder matches packetSkillName (or is grandfathered)');\n779:   if (state.frontmatterNameOk) pass(`3d-name-frontmatter: all ${state.frontmatterNamesChecked} packet SKILL.md frontmatter name(s) match packetSkillName`);\n780:   if (state.packetFilesOk) pass('3d-files: every packet carries SKILL.md, README.md, and changelog/');\n781:   if (state.aliasOk) pass(`3d-alias: all ${state.aliasSeen.size} aliases are unique across modes`);\n782:   if (state.routingOk) pass('3e: every mode has an advisorRouting block with a valid routingClass');\n783:   if (ctx.surfaceCount === 0) {\n784:     info('3g: hub declares no surface packets');\n785:   } else if (state.surfaceOk) {\n786:     pass(`3g: all ${ctx.surfaceCount} surface packet(s) are read-only evidence-base and advisor-invisible`);\n787:   }\n788:   if (state.transportCount === 0) {\n789:     info('3h: hub declares no transport packets');\n790:   } else if (state.transportOk) {\n791:     pass(`3h: all ${state.transportCount} transport packet(s) are metadata-routed, non-mutating and declared on the transport axis`);\n792:   }\n793:   if (state.writeOk) pass('3i: every mode that grants Write declares mutatesWorkspace:true or a writeScopeNote');\n794:   if (state.commandsCompared === 0) {\n795:     info('3k: no bound command declares an allowed-tools list to compare');\n796:   } else if (state.commandOk) {\n797:     pass(`3k: all ${state.commandsCompared} bound command(s) stay within their mode toolSurface.allowed`);\n798:   }\n799: }\n800: \n801: // 3b-3k: per-mode registry contract.\n802: function checkModes(ctx) {\n803:   if (!ctx.registry) return;\n804:   if (ctx.rawModes.length === 0) {\n805:     fail('3b: mode-registry.json has no modes array');\n806:     return;\n807:   }\n808:   pass(`3b: mode-registry.json declares ${ctx.rawModes.length} modes`);\n809: \n810:   const state = newModeState();\n811:   ctx.rawModes.forEach((mode, index) => {\n812:     if (!isPlainObject(mode)) {\n813:       fail(`3d: modes[${index}] is not an object (got ${describeJson(mode)})`);\n814:       state.discriminatorOk = false;\n815:       return;\n816:     }\n817:     const label = mode.workflowMode || '<unnamed>';\n818:     if (mode.packetKind === 'surface') ctx.surfaceCount += 1;\n819: \n820:     const packetUsable = checkModePacket(ctx, mode, label, state);\n821:     checkModeDiscriminator(mode, label, state);\n822:     checkModeNaming(ctx, mode, label, state, packetUsable);\n823:     if (packetUsable) checkModeFiles(ctx, mode, state);\n824:     checkModeAliases(mode, label, state);\n825:     checkModeToolSurface(ctx, mode, label, state);\n826:     checkModeRouting(mode, label, state);\n827:     if (mode.packetKind === 'surface') checkSurfaceMode(mode, label, state);\n828:     if (mode.packetKind === 'transport') checkTransportMode(ctx, mode, label, state);\n829:     checkWriteGrant(mode, label, state);\n830:     checkCommandGrant(mode, label, state);\n831:   });\n832:   reportModeState(ctx, state);\n833: }\n834: \n835: // Issues in the command-subworkflows extension and its declared entries.\n836: function commandSubworkflowIssues(ctx, commandSubworkflows) {\n837:   const cfg = ctx.extensions['command-subworkflows'];\n838:   const registeredModeIds = new Set(ctx.modes.map((mode) => mode.workflowMode));\n839:   const seenIds = new Set();\n840:   const seenCommands = new Set();\n841:   const issues = [];\n842:   if (!isPlainObject(cfg) || cfg.declaredField !== 'commandSubworkflows') {\n843:     issues.push('extension must declare declaredField \"commandSubworkflows\"');\n844:   }\n845:   if (commandSubworkflows.length === 0) {\n846:     issues.push('commandSubworkflows must be a non-empty array');\n847:   }\n848:   for (const subworkflow of commandSubworkflows) {\n849:     const id = isPlainObject(subworkflow) ? subworkflow.id : undefined;\n850:     if (typeof id !== 'string' || id.length === 0) {\n851:       issues.push('each command subworkflow needs a non-empty id');\n852:       continue;\n853:     }\n854:     if (seenIds.has(id)) issues.push(`duplicate command subworkflow id \"${id}\"`);\n855:     seenIds.add(id);\n856:     if (registeredModeIds.has(id)) issues.push(`command subworkflow \"${id}\" must not also be a registered mode`);\n857:     if (!registeredModeIds.has(subworkflow.ownerMode)) issues.push(`command subworkflow \"${id}\" has unknown ownerMode \"${subworkflow.ownerMode}\"`);\n858:     if (typeof subworkflow.command !== 'string' || !COMMAND_PATTERN.test(subworkflow.command)) {\n859:       issues.push(`command subworkflow \"${id}\" has an invalid command`);\n860:     } else if (seenCommands.has(subworkflow.command)) {\n861:       issues.push(`duplicate command subworkflow command \"${subworkflow.command}\"`);\n862:     } else {\n863:       seenCommands.add(subworkflow.command);\n864:     }\n865:     for (const field of ['contract', 'proceduresPath', 'referencesPath', 'assetsPath']) {\n866:       const value = subworkflow[field];\n867:       if (typeof value !== 'string' || value.length === 0 || !fs.existsSync(path.join(ctx.target, value))) {\n868:         issues.push(`command subworkflow \"${id}\" ${field} does not resolve on disk`);\n869:       }\n870:     }\n871:     if (typeof subworkflow.contract === 'string' && path.basename(subworkflow.contract) !== 'contract.md') {\n872:       issues.push(`command subworkflow \"${id}\" contract must end in contract.md`);\n873:     }\n874:     if (!isToolSurface(subworkflow.toolSurface)) {\n875:       issues.push(`command subworkflow \"${id}\" has a malformed toolSurface`);\n876:     }\n877:   }\n878:   const declaredCommands = new Set(isPlainObject(cfg) && Array.isArray(cfg.commands) ? cfg.commands : []);\n879:   if (declaredCommands.size !== seenCommands.size\n880:       || [...declaredCommands].some((command) => !seenCommands.has(command))) {\n881:     issues.push('extension commands[] must exactly match commandSubworkflows commands');\n882:   }\n883:   return issues;\n884: }\n885: \n886: // 3f: extensions-consistency: a declared extension activates its fields.\n887: // 3f: repoPaths must name plain top-level entries that belong to the repository,\n888: // never a packet or a file the hub root owns, or the walk would skip the skill itself.\n889: function repoRootHubIssues(ctx, declaration) {\n890:   if (!isPlainObject(declaration) || !Array.isArray(declaration.repoPaths) || declaration.repoPaths.length === 0) {\n891:     return [`${REPO_ROOT_HUB_EXTENSION} extension must be an object with a non-empty repoPaths array`];\n892:   }\n893:   const issues = [];\n894:   for (const entry of declaration.repoPaths) {\n895:     if (typeof entry !== 'string' || entry.length === 0 || /[\\\\/]/.test(entry) || entry.startsWith('.')) {\n896:       issues.push(`${REPO_ROOT_HUB_EXTENSION} repoPaths entry ${JSON.stringify(entry)} is not a plain top-level name`);\n897:     } else if (ctx.registeredPackets.has(entry) || HUB_ROOT_FILES.has(entry)) {\n898:       issues.push(`${REPO_ROOT_HUB_EXTENSION} repoPaths entry \"${entry}\" is part of the hub, not the repository`);\n899:     }\n900:   }\n901:   return issues;\n902: }\n903: \n904: function checkExtensions(ctx) {\n905:   if (!ctx.registry) return;\n906:   const { extensions, ext } = ctx;\n907:   let extOk = true;\n908:   if (ext.surfaceAxis && ctx.surfaceCount === 0) {\n909:     fail('3f: surface-axis extension declared but no packetKind \"surface\" mode exists');\n910:     extOk = false;\n911:   }\n912:   if (!ext.surfaceAxis && ctx.surfaceCount > 0) {\n913:     softFail('3f: surface packets present but the surface-axis extension is not declared');\n914:     extOk = false;\n915:   }\n916:   if (ext.transportAxis) {\n917:     const axis = extensions['transport-axis'];\n918:     const listed = isPlainObject(axis) && Array.isArray(axis.transports) ? axis.transports : [];\n919:     const kindByMode = new Map(ctx.modes.map((m) => [m.workflowMode, m.packetKind]));\n920:     const unregistered = listed.filter((id) => kindByMode.get(id) !== 'transport');\n921:     if (unregistered.length > 0) {\n922:       softFail(`3f: transport-axis transports[] lists [${unregistered.map(String).join(', ')}], which are not registered packetKind \"transport\" modes`);\n923:       extOk = false;\n924:     }\n925:   }\n926:   if (ext.runtimeLoop && !isPlainObject(extensions['runtime-loop'])) {\n927:     fail('3f: runtime-loop extension must be an object describing the convergence backend');\n928:     extOk = false;\n929:   }\n930:   if (ext.advisorProjection) {\n931:     const cfg = extensions['advisor-projection'];\n932:     const guard = isPlainObject(cfg) ? cfg.driftGuard : null;\n933:     if (!guard || typeof guard !== 'string') {\n934:       fail('3f: advisor-projection extension must declare a driftGuard test path');\n935:       extOk = false;\n936:     }\n937:   }\n938:   if (ext.repoRootHub) {\n939:     const issues = repoRootHubIssues(ctx, extensions[REPO_ROOT_HUB_EXTENSION]);\n940:     for (const issue of issues) fail(`3f: ${issue}`);\n941:     if (issues.length > 0) extOk = false;\n942:   }\n943:   const commandSubworkflows = Array.isArray(ctx.registry.commandSubworkflows)\n944:     ? ctx.registry.commandSubworkflows\n945:     : [];\n946:   if (ext.commandSubworkflows) {\n947:     const issues = commandSubworkflowIssues(ctx, commandSubworkflows);\n948:     for (const issue of issues) fail(`3f: ${issue}`);\n949:     if (issues.length > 0) extOk = false;\n950:   } else if (commandSubworkflows.length > 0) {\n951:     fail('3f: commandSubworkflows present but command-subworkflows extension is not declared');\n952:     extOk = false;\n953:   }\n954:   const declared = Object.keys(extensions);\n955:   if (extOk && declared.length > 0) {\n956:     pass(`3f: extensions {${declared.join(', ')}} are internally consistent`);\n957:   } else if (declared.length === 0) {\n958:     info('3f: hub declares no extensions (pure 2-tier)');\n959:   }\n960: }\n961: \n962: // 3j: the routing-only hub must grant exactly the tools its modes can use: no\n963: // tool that NO mode declares (an over-grant like a stray Task the hub never\n964: // dispatches to), and every tool some mode needs (so the hub can enact it).\n965: function checkHubToolGrant(ctx) {\n966:   if (!ctx.registry || ctx.rawModes.length === 0) return;\n967:   let hubTools = null;\n968:   try {\n969:     hubTools = parseAllowedTools(fs.readFileSync(path.join(ctx.target, 'SKILL.md'), 'utf8'));\n970:   } catch { /* missing SKILL.md is reported by an earlier structural check */ }\n971:   if (!hubTools) {\n972:     softFail('3j: could not read allowed-tools[] from the hub SKILL.md frontmatter');\n973:     return;\n974:   }\n975:   const union = new Set();\n976:   for (const mode of ctx.modes) {\n977:     for (const t of toolList(mode.toolSurface, 'allowed')) union.add(t);\n978:   }\n979:   const overGrant = hubTools.filter((t) => !union.has(t));\n980:   const underGrant = [...union].filter((t) => !hubTools.includes(t));\n981:   if (overGrant.length === 0 && underGrant.length === 0) {\n982:     pass('3j: hub allowed-tools equals the union of mode tool surfaces');\n983:     return;\n984:   }\n985:   if (overGrant.length > 0) softFail(`3j: hub SKILL.md grants tool(s) no mode declares: [${overGrant.join(', ')}] (routing-only hub must not over-grant)`);\n986:   if (underGrant.length > 0) softFail(`3j: hub SKILL.md is missing tool(s) a mode needs: [${underGrant.join(', ')}]`);\n987: }\n988: \n989: // ─────────────────────────────────────────────────────────────────────────────\n990: // 7. ADVISOR PROJECTION CHECKS (4a-4c)\n991: // ─────────────────────────────────────────────────────────────────────────────\n992: \n993: // 4a: drift-guard wired when the hub has lexical/alias-fold modes.\n994: function checkDriftGuard(ctx, projectedModes) {\n995:   const { registry, extensions } = ctx;\n996:   // The hub's own declared drift-guard path (falls back to the deep-loop\n997:   // reference only for the global-map owner).\n998:   const contract = registry && isPlainObject(registry.advisorRoutingContract) ? registry.advisorRoutingContract : {};\n999:   const projection = isPlainObject(extensions['advisor-projection']) ? extensions['advisor-projection'] : {};\n1000:   const rawGuard = contract.driftGuard\n1001:     || (ctx.ext.advisorProjection && projection.driftGuard)\n1002:     || (ctx.basename === GLOBAL_MAP_OWNER ? DEEP_LOOP_DRIFT_GUARD : null);\n1003:   // The driftGuard field may carry a path followed by descriptive prose; the\n1004:   // path is the first whitespace-delimited token.\n1005:   const declaredGuard = typeof rawGuard === 'string' ? rawGuard.trim().split(/\\s+/)[0] : rawGuard;\n1006: \n1007:   if (projectedModes.length === 0) {\n1008:     info('4a: hub declares no lexical/alias-fold modes — no advisor drift-guard required');\n1009:   } else if (!declaredGuard) {\n1010:     fail(`4a: hub has ${projectedModes.length} lexical/alias-fold mode(s) [${projectedModes.join(', ')}] but declares no driftGuard path (advisorRoutingContract.driftGuard or advisor-projection extension)`);\n1011:   } else if (fs.existsSync(path.resolve(REPO_ROOT, declaredGuard))) {\n1012:     pass(`4a: routing-registry drift-guard present at ${declaredGuard}`);\n1013:   } else {\n1014:     fail(`4a: declared drift-guard test missing at ${declaredGuard} — registry/maps parity is unguarded`);\n1015:   }\n1016: }\n1017: \n1018: // The advisor's live lexical map, or null after reporting why it is unavailable.\n1019: // A lexical projection that cannot be verified is a failure, not a skip: the\n1020: // cross-check is the only gate that reads the map the advisor actually serves.\n1021: function dumpAdvisorMap() {\n1022:   if (!fs.existsSync(ADVISOR_SCRIPT_ABS)) {\n1023:     fail(`4b: advisor script not found at ${ADVISOR_SCRIPT}; the lexical projection cannot be verified`);\n1024:     return null;\n1025:   }\n1026:   try {\n1027:     const raw = execFileSync('python3', [ADVISOR_SCRIPT_ABS, '--dump-routing-maps'], {\n1028:       encoding: 'utf8',\n1029:       stdio: ['ignore', 'pipe', 'ignore'],\n1030:       timeout: ADVISOR_DUMP_TIMEOUT_MS,\n1031:     });\n1032:     return JSON.parse(raw).DEEP_ROUTING_MODE_BY_KEY || {};\n1033:   } catch (e) {\n1034:     fail(`4b: could not dump advisor routing maps (${e.message.split('\\n')[0]}); the lexical projection cannot be verified`);\n1035:     return null;\n1036:   }\n1037: }\n1038: \n1039: // 4b/4c: dynamic cross-check against the live advisor map.\n1040: function checkAdvisorMap(ctx, lexicalIds) {\n1041:   const ids = Object.keys(lexicalIds);\n1042:   if (ids.length === 0) {\n1043:     info('4b: registry declares no lexical modes; nothing to cross-check against the advisor');\n1044:     return;\n1045:   }\n1046:   const dumped = dumpAdvisorMap();\n1047:   if (!dumped) return;\n1048:   if (ctx.basename === GLOBAL_MAP_OWNER) {\n1049:     const expectedKeys = [...ids].sort();\n1050:     const dumpedKeys = Object.keys(dumped).sort();\n1051:     const match = expectedKeys.length === dumpedKeys.length && expectedKeys.every((k) => dumped[k] === lexicalIds[k]);\n1052:     if (match) {\n1053:       pass(`4b: registry lexical projection matches advisor DEEP_ROUTING_MODE_BY_KEY (${expectedKeys.length} keys)`);\n[Output truncated. Continue reading with offset: 1054]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/parent-skill-check.cjs, lines 1-1053\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Parent Skill Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * Read-only structural audit for the canonical \"parent hub with nested\n9:  * packets\" pattern.\n10:  *\n11:  * A parent hub keeps ONE advisor identity at the hub and routes to N\n12:  * non-discoverable packets through a declarative mode-registry, with a\n13:  * hub-router describing how a prompt picks/bundles modes. Every packet is a\n14:  * modes[] entry with a required packetKind discriminator (workflow | surface | transport);\n15:  * surface packets are read-only, advisor-invisible evidence bases. Deep-loop's\n16:  * 3-tier machinery is expressed as named `extensions` that activate in-place\n17:  * fields, so the checks are family-agnostic: they run FULL on every hub and\n18:  * only demand extension-specific fields when the hub declares that extension.\n19:  *\n20:  * A hub can sit at a repository root, beside repository files such as spec\n21:  * packets and exports. It declares the repo-root-hub extension, listing those\n22:  * top-level entries in repoPaths. The identity walk and the child-directory\n23:  * check then skip them, and the hub id is the folder name in kebab case, since\n24:  * a repository folder is named for people (\"Product Owner\") rather than tools.\n25:  *\n26:  * Usage:\n27:  *   node parent-skill-check.cjs [parent-skill-dir]\n28:  *   PARENT_HUB_CHECK_STRICT=0 node parent-skill-check.cjs [dir]   # advisory findings as WARN\n29:  *   PARENT_HUB_CHECK_COMMANDS_DIR=<dir> node parent-skill-check.cjs [dir]\n30:  *     # resolve bound /ns:name commands from <dir>/<ns>/<name>.md instead of\n31:  *     # the repository's .skilled/commands (lets a fixture tree exercise 3k)\n32:  *\n33:  * The audit checks hub-router and registry consistency, changelog shape,\n34:  * required hub metadata, playbook and benchmark baseline, leaf-manifest\n35:  * freshness and reachability, skill-root metadata class, routing shape, and\n36:  * routing-version consistency. PARENT_HUB_CHECK_STRICT=0 downgrades advisory\n37:  * findings only; hard failures remain failures.\n38:  *\n39:  * Output: one `PASS: <id>: ...`, `FAIL: <id>: ...`, `WARN: <id>: ...` or\n40:  * `INFO: <id>: ...` line per finding. This format is the documented exemption\n41:  * from bracketed logging: the doctor workflow, CI and the test suites parse\n42:  * the verdict prefix and invariant id at the start of each line.\n43:  *\n44:  * Tool exemption: 3k ignores NON_CAPABILITY_TOOLS (TodoWrite) when it compares\n45:  * a bound command's allowed-tools with its mode's toolSurface.allowed, because\n46:  * a tool that only manages the agent's own task list grants no capability over\n47:  * the workspace and so cannot escalate the mode.\n48:  *\n49:  * Exit codes:\n50:  *   0  every hard invariant passed (warnings allowed)\n51:  *   1  at least one invariant failed\n52:  *   2  target directory missing or unreadable, target is not a parent hub, or the audit could not finish\n53:  */\n54: \n55: // ─────────────────────────────────────────────────────────────────────────────\n56: // 1. IMPORTS\n57: // ─────────────────────────────────────────────────────────────────────────────\n58: \n59: const fs = require('fs');\n60: const path = require('path');\n61: const { execFileSync } = require('child_process');\n62: // The framework copy is the one holding the authored sentinel under `.skilled` or\n63: // `.opencode`. Resolving from the script's own directory therefore follows the\n64: // copy it was launched from, even when another repository's git root sits above it.\n65: const { findRepoRoot } = require(\n66:   '../../../skills/system-spec-kit/shared/workspace/repo-root.mjs',\n67: );\n68: \n69: // ─────────────────────────────────────────────────────────────────────────────\n70: // 2. CONSTANTS\n71: // ─────────────────────────────────────────────────────────────────────────────\n72: \n73: const EXIT_OK = 0;\n74: const EXIT_INVARIANT_FAILED = 1;\n75: const EXIT_CHECKER_ERROR = 2;\n76: \n77: // Targets and helper paths are repo-root-relative. Resolving them against the\n78: // framework copy that holds the authored sentinel, not process.cwd(), keeps a\n79: // non-root working directory from false-failing 4a or missing the hub entirely.\n80: const REPO_ROOT = findRepoRoot(__dirname);\n81: \n82: // Families the skill-graph compiler accepts for a discoverable identity.\n83: // Mirrors ALLOWED_FAMILIES in skill_graph_compiler.py / skill-graph-db.ts;\n84: // a family outside this set makes the hub undiscoverable.\n85: const ALLOWED_FAMILIES = ['cli', 'mcp', 'sk-code', 'sk-hub', 'deep-loop', 'sk-util', 'system'];\n86: \n87: // The advisor reaches a mode through one of these classes; the registry\n88: // declares it per mode so the projection maps stay auditable. 'metadata' is the\n89: // default for new hubs and for every surface packet (advisor-invisible).\n90: const VALID_ROUTING_CLASSES = ['lexical', 'alias-fold', 'metadata', 'command-bridge'];\n91: \n92: // The graph-backed convergence loop keys consumed by a runtime-loop backend.\n93: // null is the explicit value for host/adapter modes; only demanded when the hub\n94: // declares the runtime-loop extension.\n95: const VALID_RUNTIME_LOOP_TYPES = ['research', 'review', 'council', null];\n96: \n97: // Read-only tool set a surface packet's toolSurface.allowed must stay within,\n98: // and the tools every non-mutating packet (surface or transport) must forbid.\n99: const SURFACE_ALLOWED_TOOLS = ['Read', 'Bash', 'Grep', 'Glob'];\n100: const NON_MUTATING_FORBIDDEN_TOOLS = ['Write', 'Edit', 'Task'];\n101: \n102: // Tools a command may grant beyond its mode without escalating it (3k).\n103: // TodoWrite edits only the agent's own task list, never the workspace.\n104: const NON_CAPABILITY_TOOLS = ['TodoWrite'];\n105: \n106: // The extension a hub at a repository root declares, and the files a hub root\n107: // owns, which repoPaths can never name.\n108: const REPO_ROOT_HUB_EXTENSION = 'repo-root-hub';\n109: const HUB_ROOT_FILES = new Set([\n110:   'SKILL.md', 'ROUTER.md', 'README.md', 'mode-registry.json', 'hub-router.json', 'description.json',\n111:   'graph-metadata.json', 'leaf-manifest.json', 'leaf-aliases.json', 'changelog', 'manual-testing-playbook',\n112: ]);\n113: \n114: // Directories allowed at a hub root without being a registered packet.\n115: const DIRECTORY_ALLOWLIST = new Set([\n116:   'shared', 'changelog', 'benchmark',\n117:   'manual-testing-playbook', 'feature-catalog',\n118:   'references', 'assets', 'node_modules', 'scripts', 'templates', 'dist', 'runtime', 'styles',\n119: ]);\n120: \n121: // The deep-loop reference drift-guard. A hub with lexical/alias-fold modes must\n122: // point at ITS OWN drift-guard (advisorRoutingContract.driftGuard or the\n123: // advisor-projection extension); this is only the fallback for deep-loop.\n124: const DEEP_LOOP_DRIFT_GUARD =\n125:   '.skilled/skills/system-skill-advisor/runtime/tests/routing-registry-drift-guard.vitest.ts';\n126: \n127: // Advisor entrypoint for the dynamic cross-check of the registry's lexical\n128: // projection against the live hardcoded map.\n129: const ADVISOR_SCRIPT =\n130:   '.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py';\n131: const ADVISOR_SCRIPT_ABS = path.resolve(REPO_ROOT, ADVISOR_SCRIPT);\n132: \n133: // The advisor dump imports the scorer, which takes seconds on a cold cache.\n134: // Past this budget the cross-check is reported as unable to run.\n135: const ADVISOR_DUMP_TIMEOUT_MS = 15000;\n136: \n137: // The single global advisor projection map only mirrors this hub, so the\n138: // dynamic 4b equality check applies to it; every other hub gets the inert-route\n139: // coverage check (4c) instead.\n140: const GLOBAL_MAP_OWNER = 'system-deep-loop';\n141: \n142: const DEFAULT_TARGET = '.skilled/skills/system-deep-loop';\n143: \n144: // Shared contract libraries and the leaf-manifest generator live once in the\n145: // repository under sk-doc. They are resolved from the repo root so a hub\n146: // outside .skilled/skills, such as a fixture, audits against the same code.\n147: const SK_CREATE_SKILL_SCRIPTS = path.join(REPO_ROOT, '.skilled', 'skills', 'sk-doc', 'sk-create-skill', 'scripts');\n148: const LEAF_GENERATOR_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'generate-leaf-manifest.cjs');\n149: const LEAF_CONTRACT_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'leaf-resource-contract.cjs');\n150: // The compiled-routing tree keeps one canary fixture per parent hub, each in a folder named `<number>-<hub>`.\n151: const CANARY_FIXTURE_ROOT = path.join(REPO_ROOT, '.skilled/bin/lib/compiled-routing/009-parent-hub-rollout');\n152: const ROOT_METADATA_CONTRACT_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'skill-root-metadata-contract.cjs');\n153: const ROOT_ROUTER_CONTRACT_PATH = path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'root-router-contract.cjs');\n154: // The known-debt ledger reader is shared with the fleet gate, so both JS checks\n155: // read a skill's recorded shape the same way.\n156: const { loadRoutingShapeDebt } = require(path.join(SK_CREATE_SKILL_SCRIPTS, 'lib', 'routing-shape-debt.cjs'));\n157: \n158: // Bound commands resolve from here; the override lets a fixture supply them.\n159: const COMMANDS_DIR = process.env.PARENT_HUB_CHECK_COMMANDS_DIR\n160:   ? path.resolve(process.env.PARENT_HUB_CHECK_COMMANDS_DIR)\n161:   : path.join(REPO_ROOT, '.skilled', 'commands');\n162: \n163: // A slash command id: /namespace:name, both kebab-case.\n164: const COMMAND_PATTERN = /^\\/([a-z][a-z0-9-]*):([a-z0-9-]+)$/;\n165: const FOUR_PART_VERSION = /^[0-9]+(?:\\.[0-9]+){3}$/;\n166: \n167: // Advisory hub-canon findings are FAIL by default. The strict opt-out changes\n168: // only their severity; hard failures remain failures.\n169: const STRICT_HUB_CANON = process.env.PARENT_HUB_CHECK_STRICT !== '0';\n170: \n171: // ─────────────────────────────────────────────────────────────────────────────\n172: // 3. OUTPUT HELPERS\n173: // ─────────────────────────────────────────────────────────────────────────────\n174: \n175: const IS_TTY = Boolean(process.stdout.isTTY);\n176: function color(text, code) {\n177:   return IS_TTY ? `\\x1b[${code}m${text}\\x1b[0m` : text;\n178: }\n179: const red = (s) => color(s, '31');\n180: const green = (s) => color(s, '32');\n181: const yellow = (s) => color(s, '33');\n182: const blue = (s) => color(s, '34');\n183: \n184: let fails = 0;\n185: let warns = 0;\n186: function pass(msg) {\n187:   console.log(`${green('PASS')}: ${msg}`);\n188: }\n189: function fail(msg) {\n190:   console.error(`${red('FAIL')}: ${msg}`);\n191:   fails += 1;\n192: }\n193: function warn(msg) {\n194:   console.error(`${yellow('WARN')}: ${msg}`);\n195:   warns += 1;\n196: }\n197: function info(msg) {\n198:   console.log(`${blue('INFO')}: ${msg}`);\n199: }\n200: // Canon severity: FAIL by default (STRICT_HUB_CANON), WARN only when a\n201: // work-in-progress hub opts out via PARENT_HUB_CHECK_STRICT=0.\n202: function softFail(msg) {\n203:   (STRICT_HUB_CANON ? fail : warn)(msg);\n204: }\n205: \n206: // ─────────────────────────────────────────────────────────────────────────────\n207: // 4. FILE AND PARSE HELPERS\n208: // ─────────────────────────────────────────────────────────────────────────────\n209: \n210: function isPlainObject(value) {\n211:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n212: }\n213: \n214: // \"Product Owner\" -> \"product-owner\".\n215: function kebabCase(name) {\n216:   return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\n217: }\n218: \n219: // The repo-root-hub declaration, read before the identity check needs it. A\n220: // malformed registry or extension reads as undeclared here, and 3a or 3f reports it.\n221: function readRepoRootHub(target) {\n222:   let registry;\n223:   try {\n224:     registry = readJson(path.join(target, 'mode-registry.json'));\n225:   } catch {\n226:     return { declared: false, repoPaths: new Set() };\n227:   }\n228:   const extensions = isPlainObject(registry) && isPlainObject(registry.extensions) ? registry.extensions : {};\n229:   if (!Object.prototype.hasOwnProperty.call(extensions, REPO_ROOT_HUB_EXTENSION)) {\n230:     return { declared: false, repoPaths: new Set() };\n231:   }\n232:   const declaration = extensions[REPO_ROOT_HUB_EXTENSION];\n233:   const listed = isPlainObject(declaration) && Array.isArray(declaration.repoPaths) ? declaration.repoPaths : [];\n234:   return { declared: true, repoPaths: new Set(listed.filter((p) => typeof p === 'string')) };\n235: }\n236: \n237: function describeJson(value) {\n238:   if (value === null) return 'null';\n239:   return Array.isArray(value) ? 'an array' : typeof value;\n240: }\n241: \n242: function readJson(file) {\n243:   return JSON.parse(fs.readFileSync(file, 'utf8'));\n244: }\n245: \n246: // Parse a file that must hold a JSON object. A literal null or an array is a\n247: // defect of the file, not an absent value, so it is returned as an error.\n248: function readJsonObject(file) {\n249:   let parsed;\n250:   try {\n251:     parsed = readJson(file);\n252:   } catch (e) {\n253:     return { value: null, error: `is not valid JSON: ${e.message}` };\n254:   }\n255:   if (!isPlainObject(parsed)) {\n256:     return { value: null, error: `is not a JSON object (got ${describeJson(parsed)})` };\n257:   }\n258:   return { value: parsed, error: null };\n259: }\n260: \n261: function isDirectory(p) {\n262:   try {\n263:     return fs.statSync(p).isDirectory();\n264:   } catch {\n265:     return false;\n266:   }\n267: }\n268: \n269: function isSymlink(p) {\n270:   try {\n271:     return fs.lstatSync(p).isSymbolicLink();\n272:   } catch {\n273:     return false;\n274:   }\n275: }\n276: \n277: // Recursively collect every regular file whose name is in `names`, keyed by name.\n278: // `skipTopLevel` names entries directly under `dir` that are never entered.\n279: function collectFilesNamed(dir, names, skipTopLevel = new Set()) {\n280:   const found = new Map(names.map((name) => [name, []]));\n281:   const stack = [dir];\n282:   while (stack.length > 0) {\n283:     const current = stack.pop();\n284:     let entries;\n285:     try {\n286:       entries = fs.readdirSync(current, { withFileTypes: true });\n287:     } catch {\n288:       continue;\n289:     }\n290:     for (const entry of entries) {\n291:       const full = path.join(current, entry.name);\n292:       if (current === dir && skipTopLevel.has(entry.name)) continue;\n293:       if (entry.isDirectory()) {\n294:         stack.push(full);\n295:       } else if (entry.isFile() && found.has(entry.name)) {\n296:         found.get(entry.name).push(full);\n297:       }\n298:     }\n299:   }\n300:   return found;\n301: }\n302: \n303: // Every changelog file that is a symlink, beneath a changelog/ directory.\n304: function symlinkedChangelogs(root) {\n305:   const out = [];\n306:   const stack = [root];\n307:   while (stack.length > 0) {\n308:     const current = stack.pop();\n309:     let entries;\n310:     try {\n311:       entries = fs.readdirSync(current, { withFileTypes: true });\n312:     } catch {\n313:       continue;\n314:     }\n315:     for (const entry of entries) {\n316:       const full = path.join(current, entry.name);\n317:       if (entry.isSymbolicLink()) {\n318:         if (current.split(path.sep).includes('changelog') || entry.name.startsWith('CHANGELOG')) {\n319:           out.push(full);\n320:         }\n321:       } else if (entry.isDirectory() && entry.name !== 'node_modules') {\n322:         stack.push(full);\n323:       }\n324:     }\n325:   }\n326:   return out;\n327: }\n328: \n329: // Flatten a validated leaf-manifest.json object into its (workflowMode,\n330: // leafResourceId) pairs.\n331: function manifestCompositePairs(manifestObject) {\n332:   const pairs = [];\n333:   for (const mode of (manifestObject && Array.isArray(manifestObject.modes) ? manifestObject.modes : [])) {\n334:     for (const leaf of (Array.isArray(mode.leaves) ? mode.leaves : [])) {\n335:       pairs.push({ workflowMode: mode.workflowMode, leafResourceId: leaf, packet: mode.packet });\n336:     }\n337:   }\n338:   return pairs;\n339: }\n340: \n341: function escapeRegExp(text) {\n342:   return text.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n343: }\n344: \n345: // Word-boundary match so a longer neighbouring id or command cannot satisfy a\n346: // shorter one (\"review\" inside \"sk-code-review\", \"/a:b\" inside \"/a:b-two\").\n347: function tokenPattern(token) {\n348:   return new RegExp(`(^|[^A-Za-z0-9_-])${escapeRegExp(token)}([^A-Za-z0-9_-]|$)`);\n349: }\n350: \n351: // The id a mode-table row is about: the first identifier in its first cell,\n352: // with markdown emphasis and code ticks stripped.\n353: function firstCellId(row) {\n354:   const cell = row.trim().replace(/^\\|/, '').split('|')[0] || '';\n355:   const match = cell.match(/^[\\s*_`]*([A-Za-z0-9_.:-]+)/);\n356:   return match ? match[1] : null;\n357: }\n358: \n359: function isToolSurface(ts) {\n360:   return isPlainObject(ts) && Array.isArray(ts.allowed) && Array.isArray(ts.forbidden)\n361:     && typeof ts.mutatesWorkspace === 'boolean' && Array.isArray(ts.bashAllowlist);\n362: }\n363: \n364: // A tool list from a toolSurface, or [] when the field is not an array; the\n365: // malformed shape itself is reported once by 3d.\n366: function toolList(ts, field) {\n367:   return isPlainObject(ts) && Array.isArray(ts[field]) ? ts[field] : [];\n368: }\n369: \n370: // A packet value must name one directory directly under the hub.\n371: function isDirectChildName(packet) {\n372:   const trimmed = packet.replace(/[\\\\/]+$/, '');\n373:   return trimmed.length > 0 && trimmed !== '.' && trimmed !== '..'\n374:     && !/[\\\\/]/.test(trimmed) && !path.isAbsolute(packet);\n375: }\n376: \n377: // The tools a frontmatter `allowed-tools` field grants, read the three ways\n378: // YAML writes a list: a flow list ([Read, Write]), a bare comma string\n379: // (Read, Write) or a block sequence. Null when there is no field to read.\n380: function parseAllowedTools(source) {\n381:   const frontmatter = source.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n382:   if (!frontmatter) return null;\n383:   const lines = frontmatter[1].split(/\\r?\\n/);\n384:   const index = lines.findIndex((line) => /^allowed-tools:/.test(line));\n385:   if (index === -1) return null;\n386:   const inline = lines[index].slice('allowed-tools:'.length).replace(/\\s+#.*$/, '').trim();\n387:   const items = [];\n388:   if (inline) {\n389:     items.push(...inline.replace(/^\\[/, '').replace(/\\]$/, '').split(','));\n390:   } else {\n391:     for (const line of lines.slice(index + 1)) {\n392:       const entry = line.match(/^\\s+-\\s*(.*)$/);\n393:       if (!entry) break;\n394:       items.push(entry[1]);\n395:     }\n396:   }\n397:   return items.map((t) => t.trim().replace(/^(['\"])(.*)\\1$/, '$2').trim()).filter(Boolean);\n398: }\n399: \n400: function loadModule(file) {\n401:   if (!fs.existsSync(file)) return { module: null, missing: true, error: null };\n402:   try {\n403:     // eslint-disable-next-line global-require, import/no-dynamic-require\n404:     return { module: require(file), missing: false, error: null };\n405:   } catch (e) {\n406:     return { module: null, missing: false, error: e };\n407:   }\n408: }\n409: \n410: // ─────────────────────────────────────────────────────────────────────────────\n411: // 5. IDENTITY CHECKS (1a-1c, 2a-2b)\n412: // ─────────────────────────────────────────────────────────────────────────────\n413: \n414: function checkIdentity(ctx) {\n415:   const { target, basename } = ctx;\n416:   const found = collectFilesNamed(target, ['graph-metadata.json', 'description.json'], ctx.repoRootHub.repoPaths);\n417:   const metaFiles = found.get('graph-metadata.json');\n418:   const hubMeta = path.join(target, 'graph-metadata.json');\n419: \n420:   if (metaFiles.length === 1 && metaFiles[0] === hubMeta) {\n421:     pass('1a: exactly one graph-metadata.json, located at the hub root');\n422:   } else if (metaFiles.length === 0) {\n423:     fail('1a: no graph-metadata.json found — the hub has no discoverable identity');\n424:   } else {\n425:     const rel = metaFiles.map((f) => path.relative(target, f) || '.');\n426:     fail(`1a: expected exactly one graph-metadata.json at the hub root; found ${metaFiles.length}: ${rel.join(', ')}`);\n427:   }\n428: \n429:   if (fs.existsSync(hubMeta)) {\n430:     const { value: meta, error } = readJsonObject(hubMeta);\n431:     if (error) {\n432:       fail(`1b: hub graph-metadata.json ${error}`);\n433:     } else {\n434:       if (meta.skill_id === basename) {\n435:         pass(`1b: hub skill_id \"${meta.skill_id}\" matches directory name`);\n436:       } else {\n437:         const named = ctx.repoRootHub.declared\n438:           ? `the kebab-case directory name \"${basename}\"`\n439:           : `directory name \"${basename}\"`;\n440:         fail(`1b: hub skill_id \"${meta.skill_id}\" does not match ${named}`);\n441:       }\n442:       if (ALLOWED_FAMILIES.includes(meta.family)) {\n443:         pass(`1c: hub family \"${meta.family}\" is in the allowed set`);\n444:       } else {\n445:         fail(`1c: hub family \"${meta.family}\" not in allowed set {${ALLOWED_FAMILIES.join(', ')}}`);\n446:       }\n447:     }\n448:   } else {\n449:     fail('1b: no hub graph-metadata.json at the root — cannot check identity');\n450:   }\n451: \n452:   // 2a: a nested graph-metadata.json re-introduces a second identity.\n453:   const nested = metaFiles.filter((f) => f !== hubMeta);\n454:   if (nested.length === 0) {\n455:     pass('2a: no nested graph-metadata.json inside any packet or shared/');\n456:   } else {\n457:     const rel = nested.map((f) => path.relative(target, f));\n458:     fail(`2a: nested graph-metadata.json found (re-introduces a second identity): ${rel.join(', ')}`);\n459:   }\n460: \n461:   // 2b: the advisor identity is hub-only; a nested description.json is dead residue.\n462:   const nestedDesc = found.get('description.json').filter((f) => f !== path.join(target, 'description.json'));\n463:   if (nestedDesc.length === 0) {\n464:     pass('2b: no nested description.json inside any packet or shared/');\n465:   } else {\n466:     const rel = nestedDesc.map((f) => path.relative(target, f));\n467:     fail(`2b: nested description.json found (re-introduces a second advisor identity): ${rel.join(', ')}`);\n468:   }\n469: }\n470: \n471: // ─────────────────────────────────────────────────────────────────────────────\n472: // 6. REGISTRY CHECKS (3a-3k)\n473: // ─────────────────────────────────────────────────────────────────────────────\n474: \n475: // 3a: load mode-registry.json and derive the per-hub facts later checks share.\n476: function loadRegistry(ctx) {\n477:   const registryPath = path.join(ctx.target, 'mode-registry.json');\n478:   if (!fs.existsSync(registryPath)) {\n479:     fail('3a: mode-registry.json is missing');\n480:     return;\n481:   }\n482:   const { value, error } = readJsonObject(registryPath);\n483:   if (error) {\n484:     fail(`3a: mode-registry.json ${error}`);\n485:     return;\n486:   }\n487:   pass('3a: mode-registry.json exists and parses as JSON');\n488:   ctx.registry = value;\n489:   ctx.extensions = isPlainObject(value.extensions) ? value.extensions : {};\n490:   const declares = (name) => Object.prototype.hasOwnProperty.call(ctx.extensions, name);\n491:   ctx.ext = {\n492:     runtimeLoop: declares('runtime-loop'),\n493:     advisorProjection: declares('advisor-projection'),\n494:     surfaceAxis: declares('surface-axis'),\n495:     transportAxis: declares('transport-axis'),\n496:     commandSubworkflows: declares('command-subworkflows'),\n497:     repoRootHub: declares(REPO_ROOT_HUB_EXTENSION),\n498:   };\n499:   ctx.rawModes = Array.isArray(value.modes) ? value.modes : [];\n500:   ctx.modes = ctx.rawModes.filter(isPlainObject);\n501:   ctx.registryModeSet = new Set(ctx.modes.map((m) => m.workflowMode).filter(Boolean));\n502: }\n503: \n504: function newModeState() {\n505:   return {\n506:     packetOk: true,\n507:     discriminatorOk: true, // hard: workflowMode + backendKind presence\n508:     canonOk: true, // canon (FAIL by default): packetKind, toolSurface, names, aliases, runtimeLoopType\n509:     routingOk: true,\n510:     surfaceOk: true,\n511:     transportOk: true,\n512:     transportCount: 0,\n513:     writeOk: true,\n514:     commandOk: true,\n515:     commandsCompared: 0,\n516:     folderNameOk: true, // folder == packetSkillName unless grandfatheredFolderMismatch\n517:     frontmatterNameOk: true, // packet SKILL.md frontmatter name == packetSkillName\n518:     frontmatterNamesChecked: 0,\n519:     packetFilesOk: true, // each packet carries SKILL.md + README.md + changelog/\n520:     aliasOk: true, // aliases unique across all modes\n521:     aliasSeen: new Map(), // alias (lowercased) → first mode that declared it\n522:   };\n523: }\n524: \n525: // 3c: every mode's packet value must be a DIRECT child sub-dir.\n526: function checkModePacket(ctx, mode, label, state) {\n527:   const { packet } = mode;\n528:   if (!packet || typeof packet !== 'string') {\n529:     fail(`3c: mode \"${label}\" has no packet value`);\n530:     state.packetOk = false;\n531:     return false;\n532:   }\n533:   if (!isDirectChildName(packet)) {\n534:     fail(`3c: mode \"${label}\" packet \"${packet}\" must be a direct child directory (no absolute, nested, \".\" or \"../\" paths)`);\n535:     state.packetOk = false;\n536:     return false;\n537:   }\n538:   ctx.registeredPackets.add(packet.replace(/[\\\\/]+$/, ''));\n539:   if (!isDirectory(path.join(ctx.target, packet))) {\n540:     fail(`3c: mode \"${label}\" packet \"${packet}\" is not an existing sub-directory; if this surface packet was removed on purpose, finish the removal with the README.md block \"What Adapting \\`sk-code\\` Looks Like\"`);\n541:     state.packetOk = false;\n542:     return false;\n543:   }\n544:   return true;\n545: }\n546: \n547: // 3d: two-axis discriminator. HARD: workflowMode + backendKind presence.\n548: // CANON (softFail): packetKind, grandfatheredFolderMismatch, packetSkillName\n549: // and aliases, the fields each hub carries once it adopts the two-axis shape.\n550: function checkModeDiscriminator(mode, label, state) {\n551:   const kind = mode.packetKind;\n552:   if (typeof mode.workflowMode !== 'string' || mode.workflowMode.length === 0) {\n553:     fail(`3d: mode \"${label}\" is missing workflowMode`);\n554:     state.discriminatorOk = false;\n555:   }\n556:   // backendKind is presence-checked only: hub families name their own\n557:   // descriptive backends; the one constrained case is a surface packet (3g).\n558:   if (typeof mode.backendKind !== 'string' || mode.backendKind.length === 0) {\n559:     fail(`3d: mode \"${label}\" is missing backendKind`);\n560:     state.discriminatorOk = false;\n561:   }\n562:   if (kind !== 'workflow' && kind !== 'surface' && kind !== 'transport') {\n563:     softFail(`3d: mode \"${label}\" has invalid packetKind ${JSON.stringify(kind)} (expected \"workflow\", \"surface\", or \"transport\")`);\n564:     state.canonOk = false;\n565:   }\n566:   if (typeof mode.grandfatheredFolderMismatch !== 'boolean') {\n567:     softFail(`3d: mode \"${label}\" is missing the grandfatheredFolderMismatch boolean`);\n568:     state.canonOk = false;\n569:   }\n570:   if (typeof mode.packetSkillName !== 'string' || mode.packetSkillName.length === 0) {\n571:     softFail(`3d: mode \"${label}\" is missing packetSkillName (the packet SKILL.md name)`);\n572:     state.canonOk = false;\n573:   }\n574:   if (!Array.isArray(mode.aliases) || mode.aliases.some((a) => typeof a !== 'string' || a.trim().length === 0)) {\n575:     softFail(`3d: mode \"${label}\" is missing an aliases array of non-empty strings`);\n576:     state.canonOk = false;\n577:   }\n578: }\n579: \n580: // 3d-name: folder == packetSkillName unless the mismatch is explicitly\n581: // grandfathered, and the packet SKILL.md frontmatter name agrees.\n582: function checkModeNaming(ctx, mode, label, state, packetUsable) {\n583:   if (typeof mode.packet !== 'string' || typeof mode.packetSkillName !== 'string') return;\n584:   // A mode may not ship grandfatheredFolderMismatch:false while its folder and\n585:   // packetSkillName actually diverge: that is a silent, un-grandfathered mismatch.\n586:   const folderLeaf = mode.packet.replace(/[\\\\/]+$/, '').split(/[\\\\/]/).pop();\n587:   const nameMismatch = folderLeaf !== mode.packetSkillName;\n588:   if (mode.grandfatheredFolderMismatch === false && nameMismatch) {\n589:     softFail(`3d-name: mode \"${label}\" folder \"${folderLeaf}\" != packetSkillName \"${mode.packetSkillName}\" but grandfatheredFolderMismatch is false (set it true to preserve a real mismatch)`);\n590:     state.folderNameOk = false;\n591:   } else if (mode.grandfatheredFolderMismatch === true && !nameMismatch) {\n592:     softFail(`3d-name: mode \"${label}\" sets grandfatheredFolderMismatch:true but folder \"${folderLeaf}\" == packetSkillName (stale flag — set it false; a blanket-true flag would mask a real future mismatch)`);\n593:     state.folderNameOk = false;\n594:   }\n595:   if (!packetUsable) return;\n596:   // Missing frontmatter/name is owned by a separate check.\n597:   const skillFile = path.join(ctx.target, mode.packet, 'SKILL.md');\n598:   if (!fs.existsSync(skillFile) || !fs.statSync(skillFile).isFile()) return;\n599:   const frontmatter = fs.readFileSync(skillFile, 'utf8').match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n600:   const nameMatch = frontmatter && frontmatter[1].match(/^name:\\s*(.+)$/m);\n601:   if (!nameMatch) return;\n602:   const frontmatterName = nameMatch[1].trim().replace(/^(['\"])(.*)\\1$/, '$2').trim();\n603:   state.frontmatterNamesChecked += 1;\n604:   if (frontmatterName !== mode.packetSkillName) {\n605:     softFail(`3d-name-frontmatter: packet \"${mode.packet}\" SKILL.md frontmatter name \"${frontmatterName}\" != packetSkillName \"${mode.packetSkillName}\"`);\n606:     state.folderNameOk = false;\n607:     state.frontmatterNameOk = false;\n608:   }\n609: }\n610: \n611: // 3d-files: every packet carries its companion files.\n612: function checkModeFiles(ctx, mode, state) {\n613:   const pdir = path.join(ctx.target, mode.packet);\n614:   for (const companion of ['SKILL.md', 'README.md']) {\n615:     if (!fs.existsSync(path.join(pdir, companion))) {\n616:       softFail(`3d-files: packet \"${mode.packet}\" is missing companion ${companion}`);\n617:       state.packetFilesOk = false;\n618:     }\n619:   }\n620:   if (!isDirectory(path.join(pdir, 'changelog'))) {\n621:     softFail(`3d-files: packet \"${mode.packet}\" is missing a changelog/ directory`);\n622:     state.packetFilesOk = false;\n623:   }\n624: }\n625: \n626: // 3d-alias: aliases are unique across modes and lowercase. The router matches\n627: // vocabulary case-folded, so a mixed-case alias cannot mirror its vocabulary\n628: // class; that half is advisory (WARN) because live hubs still carry them.\n629: function checkModeAliases(mode, label, state) {\n630:   for (const a of (Array.isArray(mode.aliases) ? mode.aliases : [])) {\n631:     if (typeof a !== 'string') continue;\n632:     const key = a.toLowerCase();\n633:     if (state.aliasSeen.has(key)) {\n634:       softFail(`3d-alias: alias ${JSON.stringify(a)} on mode \"${label}\" duplicates mode \"${state.aliasSeen.get(key)}\" (aliases must be unique across modes)`);\n635:       state.aliasOk = false;\n636:     } else {\n637:       state.aliasSeen.set(key, label);\n638:     }\n639:     if (a !== key) {\n640:       warn(`3d-alias: alias ${JSON.stringify(a)} on mode \"${label}\" is not lowercase (router vocabulary is matched case-folded)`);\n641:     }\n642:   }\n643: }\n644: \n645: // 3d: toolSurface shape on every mode, and runtimeLoopType only where the\n646: // runtime-loop extension activates it.\n647: function checkModeToolSurface(ctx, mode, label, state) {\n648:   if (!isToolSurface(mode.toolSurface)) {\n649:     softFail(`3d: mode \"${label}\" has a malformed toolSurface (need {allowed[], forbidden[], mutatesWorkspace:bool, bashAllowlist[]})`);\n650:     state.canonOk = false;\n651:   }\n652:   const hasLoopType = 'runtimeLoopType' in mode;\n653:   if (ctx.ext.runtimeLoop && mode.packetKind === 'workflow') {\n654:     if (!hasLoopType) {\n655:       softFail(`3d: mode \"${label}\" is missing runtimeLoopType (runtime-loop extension declared; null is allowed, absence is not)`);\n656:       state.canonOk = false;\n657:     } else if (!VALID_RUNTIME_LOOP_TYPES.includes(mode.runtimeLoopType)) {\n658:       softFail(`3d: mode \"${label}\" has invalid runtimeLoopType ${JSON.stringify(mode.runtimeLoopType)} (expected one of {research, review, council, null})`);\n659:       state.canonOk = false;\n660:     }\n661:   } else if (hasLoopType && !ctx.ext.runtimeLoop) {\n662:     softFail(`3d: mode \"${label}\" declares runtimeLoopType but the hub does not declare the runtime-loop extension`);\n663:     state.canonOk = false;\n664:   } else if (hasLoopType && !VALID_RUNTIME_LOOP_TYPES.includes(mode.runtimeLoopType)) {\n665:     softFail(`3d: mode \"${label}\" declares runtimeLoopType ${JSON.stringify(mode.runtimeLoopType)} outside the valid set`);\n666:     state.canonOk = false;\n667:   }\n668: }\n669: \n670: // 3e: advisorRouting block with a valid routingClass.\n671: function checkModeRouting(mode, label, state) {\n672:   const routing = mode.advisorRouting;\n673:   if (!isPlainObject(routing)) {\n674:     fail(`3e: mode \"${label}\" is missing an advisorRouting block`);\n675:     state.routingOk = false;\n676:   } else if (!VALID_ROUTING_CLASSES.includes(routing.routingClass)) {\n677:     fail(`3e: mode \"${label}\" has invalid routingClass ${JSON.stringify(routing.routingClass)} (expected one of {${VALID_ROUTING_CLASSES.join(', ')}})`);\n678:     state.routingOk = false;\n679:   }\n680: }\n681: \n682: // 3g: surface packets are read-only, evidence-base, advisor-invisible.\n683: function checkSurfaceMode(mode, label, state) {\n684:   const routing = mode.advisorRouting;\n685:   const ts = mode.toolSurface;\n686:   if (mode.backendKind !== 'evidence-base') {\n687:     softFail(`3g: surface packet \"${label}\" must be backendKind \"evidence-base\" (got ${JSON.stringify(mode.backendKind)})`);\n688:     state.surfaceOk = false;\n689:   }\n690:   if (isPlainObject(routing) && routing.routingClass !== 'metadata') {\n691:     softFail(`3g: surface packet \"${label}\" must be routingClass \"metadata\" (advisor-invisible)`);\n692:     state.surfaceOk = false;\n693:   }\n694:   if (!isPlainObject(ts)) return;\n695:   if (ts.mutatesWorkspace !== false) {\n696:     softFail(`3g: surface packet \"${label}\" toolSurface must be read-only (mutatesWorkspace:false)`);\n697:     state.surfaceOk = false;\n698:   }\n699:   const strayAllowed = toolList(ts, 'allowed').filter((t) => !SURFACE_ALLOWED_TOOLS.includes(t));\n700:   if (strayAllowed.length > 0) {\n701:     softFail(`3g: surface packet \"${label}\" allows non-read-only tools [${strayAllowed.join(', ')}] (allowed ⊆ {${SURFACE_ALLOWED_TOOLS.join(', ')}})`);\n702:     state.surfaceOk = false;\n703:   }\n704:   const forbidden = toolList(ts, 'forbidden');\n705:   const missingForbidden = NON_MUTATING_FORBIDDEN_TOOLS.filter((t) => !forbidden.includes(t));\n706:   if (missingForbidden.length > 0) {\n707:     softFail(`3g: surface packet \"${label}\" must forbid [${missingForbidden.join(', ')}]`);\n708:     state.surfaceOk = false;\n709:   }\n710: }\n711: \n712: // 3h: transport packets bridge to an external tool's CLI/MCP surface:\n713: // metadata-routed (advisor-invisible), non-mutating in THIS repo (writes\n714: // land in the external tool), never orchestrating, and declared on the\n715: // transport-axis extension so the axis is registered, not ad-hoc.\n716: function checkTransportMode(ctx, mode, label, state) {\n717:   const routing = mode.advisorRouting;\n718:   const ts = mode.toolSurface;\n719:   state.transportCount += 1;\n720:   if (isPlainObject(routing) && routing.routingClass !== 'metadata') {\n721:     softFail(`3h: transport packet \"${label}\" must be routingClass \"metadata\" (advisor-invisible)`);\n722:     state.transportOk = false;\n723:   }\n724:   if (isPlainObject(ts) && ts.mutatesWorkspace !== false) {\n725:     softFail(`3h: transport packet \"${label}\" toolSurface must be mutatesWorkspace:false (writes land in the external tool, not this repo)`);\n726:     state.transportOk = false;\n727:   }\n728:   const forbidden = toolList(ts, 'forbidden');\n729:   const missing = NON_MUTATING_FORBIDDEN_TOOLS.filter((t) => !forbidden.includes(t));\n730:   if (missing.length > 0) {\n731:     softFail(`3h: transport packet \"${label}\" must forbid [${missing.join(', ')}]`);\n732:     state.transportOk = false;\n733:   }\n734:   const axis = ctx.extensions['transport-axis'];\n735:   if (!isPlainObject(axis) || !Array.isArray(axis.transports) || !axis.transports.includes(mode.workflowMode)) {\n736:     softFail(`3h: transport packet \"${label}\" is not declared in the transport-axis extension's transports[]`);\n737:     state.transportOk = false;\n738:   }\n739: }\n740: \n741: // 3i: a mode that grants Write must declare mutatesWorkspace:true (writing a\n742: // file mutates the workspace) UNLESS it carries a writeScopeNote documenting a\n743: // non-project Write scope (e.g. an ephemeral, untracked cache).\n744: function checkWriteGrant(mode, label, state) {\n745:   const ts = mode.toolSurface;\n746:   if (!toolList(ts, 'allowed').includes('Write')) return;\n747:   const annotated = typeof ts.writeScopeNote === 'string' && ts.writeScopeNote.trim().length > 0;\n748:   if (ts.mutatesWorkspace !== true && !annotated) {\n749:     softFail(`3i: mode \"${label}\" grants Write but is mutatesWorkspace:false with no writeScopeNote (Write mutates the workspace — set mutatesWorkspace:true or annotate a non-project Write scope)`);\n750:     state.writeOk = false;\n751:   }\n752: }\n753: \n754: // 3k: a bound command's frontmatter must not grant tools beyond the mode's\n755: // toolSurface.allowed; the command is an entrypoint into the mode, and a wider\n756: // grant silently escalates the mode's declared tool contract.\n757: function checkCommandGrant(mode, label, state) {\n758:   const ts = mode.toolSurface;\n759:   if (typeof mode.command !== 'string' || !isPlainObject(ts) || !Array.isArray(ts.allowed)) return;\n760:   const cm = mode.command.match(COMMAND_PATTERN);\n761:   const cmdFile = cm ? path.join(COMMANDS_DIR, cm[1], `${cm[2]}.md`) : null;\n762:   if (!cmdFile || !fs.existsSync(cmdFile)) return;\n763:   const granted = parseAllowedTools(fs.readFileSync(cmdFile, 'utf8'));\n764:   if (!granted) return;\n765:   state.commandsCompared += 1;\n766:   const modeAllowed = new Set(ts.allowed);\n767:   const over = granted.filter((t) => !modeAllowed.has(t) && !NON_CAPABILITY_TOOLS.includes(t));\n768:   if (over.length > 0) {\n769:     softFail(`3k: command ${mode.command} frontmatter grants tool(s) [${over.join(', ')}] beyond mode \"${label}\" toolSurface.allowed`);\n770:     state.commandOk = false;\n771:   }\n772: }\n773: \n774: function reportModeState(ctx, state) {\n775:   if (state.packetOk) pass('3c: every mode packet resolves to an existing sub-directory');\n776:   if (state.discriminatorOk) pass('3d: every mode carries the hard discriminator (workflowMode + backendKind)');\n777:   if (state.canonOk) pass('3d-canon: every mode carries packetKind + toolSurface + grandfatheredFolderMismatch + packetSkillName + aliases');\n778:   if (state.folderNameOk) pass('3d-name: every mode folder matches packetSkillName (or is grandfathered)');\n779:   if (state.frontmatterNameOk) pass(`3d-name-frontmatter: all ${state.frontmatterNamesChecked} packet SKILL.md frontmatter name(s) match packetSkillName`);\n780:   if (state.packetFilesOk) pass('3d-files: every packet carries SKILL.md, README.md, and changelog/');\n781:   if (state.aliasOk) pass(`3d-alias: all ${state.aliasSeen.size} aliases are unique across modes`);\n782:   if (state.routingOk) pass('3e: every mode has an advisorRouting block with a valid routingClass');\n783:   if (ctx.surfaceCount === 0) {\n784:     info('3g: hub declares no surface packets');\n785:   } else if (state.surfaceOk) {\n786:     pass(`3g: all ${ctx.surfaceCount} surface packet(s) are read-only evidence-base and advisor-invisible`);\n787:   }\n788:   if (state.transportCount === 0) {\n789:     info('3h: hub declares no transport packets');\n790:   } else if (state.transportOk) {\n791:     pass(`3h: all ${state.transportCount} transport packet(s) are metadata-routed, non-mutating and declared on the transport axis`);\n792:   }\n793:   if (state.writeOk) pass('3i: every mode that grants Write declares mutatesWorkspace:true or a writeScopeNote');\n794:   if (state.commandsCompared === 0) {\n795:     info('3k: no bound command declares an allowed-tools list to compare');\n796:   } else if (state.commandOk) {\n797:     pass(`3k: all ${state.commandsCompared} bound command(s) stay within their mode toolSurface.allowed`);\n798:   }\n799: }\n800: \n801: // 3b-3k: per-mode registry contract.\n802: function checkModes(ctx) {\n803:   if (!ctx.registry) return;\n804:   if (ctx.rawModes.length === 0) {\n805:     fail('3b: mode-registry.json has no modes array');\n806:     return;\n807:   }\n808:   pass(`3b: mode-registry.json declares ${ctx.rawModes.length} modes`);\n809: \n810:   const state = newModeState();\n811:   ctx.rawModes.forEach((mode, index) => {\n812:     if (!isPlainObject(mode)) {\n813:       fail(`3d: modes[${index}] is not an object (got ${describeJson(mode)})`);\n814:       state.discriminatorOk = false;\n815:       return;\n816:     }\n817:     const label = mode.workflowMode || '<unnamed>';\n818:     if (mode.packetKind === 'surface') ctx.surfaceCount += 1;\n819: \n820:     const packetUsable = checkModePacket(ctx, mode, label, state);\n821:     checkModeDiscriminator(mode, label, state);\n822:     checkModeNaming(ctx, mode, label, state, packetUsable);\n823:     if (packetUsable) checkModeFiles(ctx, mode, state);\n824:     checkModeAliases(mode, label, state);\n825:     checkModeToolSurface(ctx, mode, label, state);\n826:     checkModeRouting(mode, label, state);\n827:     if (mode.packetKind === 'surface') checkSurfaceMode(mode, label, state);\n828:     if (mode.packetKind === 'transport') checkTransportMode(ctx, mode, label, state);\n829:     checkWriteGrant(mode, label, state);\n830:     checkCommandGrant(mode, label, state);\n831:   });\n832:   reportModeState(ctx, state);\n833: }\n834: \n835: // Issues in the command-subworkflows extension and its declared entries.\n836: function commandSubworkflowIssues(ctx, commandSubworkflows) {\n837:   const cfg = ctx.extensions['command-subworkflows'];\n838:   const registeredModeIds = new Set(ctx.modes.map((mode) => mode.workflowMode));\n839:   const seenIds = new Set();\n840:   const seenCommands = new Set();\n841:   const issues = [];\n842:   if (!isPlainObject(cfg) || cfg.declaredField !== 'commandSubworkflows') {\n843:     issues.push('extension must declare declaredField \"commandSubworkflows\"');\n844:   }\n845:   if (commandSubworkflows.length === 0) {\n846:     issues.push('commandSubworkflows must be a non-empty array');\n847:   }\n848:   for (const subworkflow of commandSubworkflows) {\n849:     const id = isPlainObject(subworkflow) ? subworkflow.id : undefined;\n850:     if (typeof id !== 'string' || id.length === 0) {\n851:       issues.push('each command subworkflow needs a non-empty id');\n852:       continue;\n853:     }\n854:     if (seenIds.has(id)) issues.push(`duplicate command subworkflow id \"${id}\"`);\n855:     seenIds.add(id);\n856:     if (registeredModeIds.has(id)) issues.push(`command subworkflow \"${id}\" must not also be a registered mode`);\n857:     if (!registeredModeIds.has(subworkflow.ownerMode)) issues.push(`command subworkflow \"${id}\" has unknown ownerMode \"${subworkflow.ownerMode}\"`);\n858:     if (typeof subworkflow.command !== 'string' || !COMMAND_PATTERN.test(subworkflow.command)) {\n859:       issues.push(`command subworkflow \"${id}\" has an invalid command`);\n860:     } else if (seenCommands.has(subworkflow.command)) {\n861:       issues.push(`duplicate command subworkflow command \"${subworkflow.command}\"`);\n862:     } else {\n863:       seenCommands.add(subworkflow.command);\n864:     }\n865:     for (const field of ['contract', 'proceduresPath', 'referencesPath', 'assetsPath']) {\n866:       const value = subworkflow[field];\n867:       if (typeof value !== 'string' || value.length === 0 || !fs.existsSync(path.join(ctx.target, value))) {\n868:         issues.push(`command subworkflow \"${id}\" ${field} does not resolve on disk`);\n869:       }\n870:     }\n871:     if (typeof subworkflow.contract === 'string' && path.basename(subworkflow.contract) !== 'contract.md') {\n872:       issues.push(`command subworkflow \"${id}\" contract must end in contract.md`);\n873:     }\n874:     if (!isToolSurface(subworkflow.toolSurface)) {\n875:       issues.push(`command subworkflow \"${id}\" has a malformed toolSurface`);\n876:     }\n877:   }\n878:   const declaredCommands = new Set(isPlainObject(cfg) && Array.isArray(cfg.commands) ? cfg.commands : []);\n879:   if (declaredCommands.size !== seenCommands.size\n880:       || [...declaredCommands].some((command) => !seenCommands.has(command))) {\n881:     issues.push('extension commands[] must exactly match commandSubworkflows commands');\n882:   }\n883:   return issues;\n884: }\n885: \n886: // 3f: extensions-consistency: a declared extension activates its fields.\n887: // 3f: repoPaths must name plain top-level entries that belong to the repository,\n888: // never a packet or a file the hub root owns, or the walk would skip the skill itself.\n889: function repoRootHubIssues(ctx, declaration) {\n890:   if (!isPlainObject(declaration) || !Array.isArray(declaration.repoPaths) || declaration.repoPaths.length === 0) {\n891:     return [`${REPO_ROOT_HUB_EXTENSION} extension must be an object with a non-empty repoPaths array`];\n892:   }\n893:   const issues = [];\n894:   for (const entry of declaration.repoPaths) {\n895:     if (typeof entry !== 'string' || entry.length === 0 || /[\\\\/]/.test(entry) || entry.startsWith('.')) {\n896:       issues.push(`${REPO_ROOT_HUB_EXTENSION} repoPaths entry ${JSON.stringify(entry)} is not a plain top-level name`);\n897:     } else if (ctx.registeredPackets.has(entry) || HUB_ROOT_FILES.has(entry)) {\n898:       issues.push(`${REPO_ROOT_HUB_EXTENSION} repoPaths entry \"${entry}\" is part of the hub, not the repository`);\n899:     }\n900:   }\n901:   return issues;\n902: }\n903: \n904: function checkExtensions(ctx) {\n905:   if (!ctx.registry) return;\n906:   const { extensions, ext } = ctx;\n907:   let extOk = true;\n908:   if (ext.surfaceAxis && ctx.surfaceCount === 0) {\n909:     fail('3f: surface-axis extension declared but no packetKind \"surface\" mode exists');\n910:     extOk = false;\n911:   }\n912:   if (!ext.surfaceAxis && ctx.surfaceCount > 0) {\n913:     softFail('3f: surface packets present but the surface-axis extension is not declared');\n914:     extOk = false;\n915:   }\n916:   if (ext.transportAxis) {\n917:     const axis = extensions['transport-axis'];\n918:     const listed = isPlainObject(axis) && Array.isArray(axis.transports) ? axis.transports : [];\n919:     const kindByMode = new Map(ctx.modes.map((m) => [m.workflowMode, m.packetKind]));\n920:     const unregistered = listed.filter((id) => kindByMode.get(id) !== 'transport');\n921:     if (unregistered.length > 0) {\n922:       softFail(`3f: transport-axis transports[] lists [${unregistered.map(String).join(', ')}], which are not registered packetKind \"transport\" modes`);\n923:       extOk = false;\n924:     }\n925:   }\n926:   if (ext.runtimeLoop && !isPlainObject(extensions['runtime-loop'])) {\n927:     fail('3f: runtime-loop extension must be an object describing the convergence backend');\n928:     extOk = false;\n929:   }\n930:   if (ext.advisorProjection) {\n931:     const cfg = extensions['advisor-projection'];\n932:     const guard = isPlainObject(cfg) ? cfg.driftGuard : null;\n933:     if (!guard || typeof guard !== 'string') {\n934:       fail('3f: advisor-projection extension must declare a driftGuard test path');\n935:       extOk = false;\n936:     }\n937:   }\n938:   if (ext.repoRootHub) {\n939:     const issues = repoRootHubIssues(ctx, extensions[REPO_ROOT_HUB_EXTENSION]);\n940:     for (const issue of issues) fail(`3f: ${issue}`);\n941:     if (issues.length > 0) extOk = false;\n942:   }\n943:   const commandSubworkflows = Array.isArray(ctx.registry.commandSubworkflows)\n944:     ? ctx.registry.commandSubworkflows\n945:     : [];\n946:   if (ext.commandSubworkflows) {\n947:     const issues = commandSubworkflowIssues(ctx, commandSubworkflows);\n948:     for (const issue of issues) fail(`3f: ${issue}`);\n949:     if (issues.length > 0) extOk = false;\n950:   } else if (commandSubworkflows.length > 0) {\n951:     fail('3f: commandSubworkflows present but command-subworkflows extension is not declared');\n952:     extOk = false;\n953:   }\n954:   const declared = Object.keys(extensions);\n955:   if (extOk && declared.length > 0) {\n956:     pass(`3f: extensions {${declared.join(', ')}} are internally consistent`);\n957:   } else if (declared.length === 0) {\n958:     info('3f: hub declares no extensions (pure 2-tier)');\n959:   }\n960: }\n961: \n962: // 3j: the routing-only hub must grant exactly the tools its modes can use: no\n963: // tool that NO mode declares (an over-grant like a stray Task the hub never\n964: // dispatches to), and every tool some mode needs (so the hub can enact it).\n965: function checkHubToolGrant(ctx) {\n966:   if (!ctx.registry || ctx.rawModes.length === 0) return;\n967:   let hubTools = null;\n968:   try {\n969:     hubTools = parseAllowedTools(fs.readFileSync(path.join(ctx.target, 'SKILL.md'), 'utf8'));\n970:   } catch { /* missing SKILL.md is reported by an earlier structural check */ }\n971:   if (!hubTools) {\n972:     softFail('3j: could not read allowed-tools[] from the hub SKILL.md frontmatter');\n973:     return;\n974:   }\n975:   const union = new Set();\n976:   for (const mode of ctx.modes) {\n977:     for (const t of toolList(mode.toolSurface, 'allowed')) union.add(t);\n978:   }\n979:   const overGrant = hubTools.filter((t) => !union.has(t));\n980:   const underGrant = [...union].filter((t) => !hubTools.includes(t));\n981:   if (overGrant.length === 0 && underGrant.length === 0) {\n982:     pass('3j: hub allowed-tools equals the union of mode tool surfaces');\n983:     return;\n984:   }\n985:   if (overGrant.length > 0) softFail(`3j: hub SKILL.md grants tool(s) no mode declares: [${overGrant.join(', ')}] (routing-only hub must not over-grant)`);\n986:   if (underGrant.length > 0) softFail(`3j: hub SKILL.md is missing tool(s) a mode needs: [${underGrant.join(', ')}]`);\n987: }\n988: \n989: // ─────────────────────────────────────────────────────────────────────────────\n990: // 7. ADVISOR PROJECTION CHECKS (4a-4c)\n991: // ─────────────────────────────────────────────────────────────────────────────\n992: \n993: // 4a: drift-guard wired when the hub has lexical/alias-fold modes.\n994: function checkDriftGuard(ctx, projectedModes) {\n995:   const { registry, extensions } = ctx;\n996:   // The hub's own declared drift-guard path (falls back to the deep-loop\n997:   // reference only for the global-map owner).\n998:   const contract = registry && isPlainObject(registry.advisorRoutingContract) ? registry.advisorRoutingContract : {};\n999:   const projection = isPlainObject(extensions['advisor-projection']) ? extensions['advisor-projection'] : {};\n1000:   const rawGuard = contract.driftGuard\n1001:     || (ctx.ext.advisorProjection && projection.driftGuard)\n1002:     || (ctx.basename === GLOBAL_MAP_OWNER ? DEEP_LOOP_DRIFT_GUARD : null);\n1003:   // The driftGuard field may carry a path followed by descriptive prose; the\n1004:   // path is the first whitespace-delimited token.\n1005:   const declaredGuard = typeof rawGuard === 'string' ? rawGuard.trim().split(/\\s+/)[0] : rawGuard;\n1006: \n1007:   if (projectedModes.length === 0) {\n1008:     info('4a: hub declares no lexical/alias-fold modes — no advisor drift-guard required');\n1009:   } else if (!declaredGuard) {\n1010:     fail(`4a: hub has ${projectedModes.length} lexical/alias-fold mode(s) [${projectedModes.join(', ')}] but declares no driftGuard path (advisorRoutingContract.driftGuard or advisor-projection extension)`);\n1011:   } else if (fs.existsSync(path.resolve(REPO_ROOT, declaredGuard))) {\n1012:     pass(`4a: routing-registry drift-guard present at ${declaredGuard}`);\n1013:   } else {\n1014:     fail(`4a: declared drift-guard test missing at ${declaredGuard} — registry/maps parity is unguarded`);\n1015:   }\n1016: }\n1017: \n1018: // The advisor's live lexical map, or null after reporting why it is unavailable.\n1019: // A lexical projection that cannot be verified is a failure, not a skip: the\n1020: // cross-check is the only gate that reads the map the advisor actually serves.\n1021: function dumpAdvisorMap() {\n1022:   if (!fs.existsSync(ADVISOR_SCRIPT_ABS)) {\n1023:     fail(`4b: advisor script not found at ${ADVISOR_SCRIPT}; the lexical projection cannot be verified`);\n1024:     return null;\n1025:   }\n1026:   try {\n1027:     const raw = execFileSync('python3', [ADVISOR_SCRIPT_ABS, '--dump-routing-maps'], {\n1028:       encoding: 'utf8',\n1029:       stdio: ['ignore', 'pipe', 'ignore'],\n1030:       timeout: ADVISOR_DUMP_TIMEOUT_MS,\n1031:     });\n1032:     return JSON.parse(raw).DEEP_ROUTING_MODE_BY_KEY || {};\n1033:   } catch (e) {\n1034:     fail(`4b: could not dump advisor routing maps (${e.message.split('\\n')[0]}); the lexical projection cannot be verified`);\n1035:     return null;\n1036:   }\n1037: }\n1038: \n1039: // 4b/4c: dynamic cross-check against the live advisor map.\n1040: function checkAdvisorMap(ctx, lexicalIds) {\n1041:   const ids = Object.keys(lexicalIds);\n1042:   if (ids.length === 0) {\n1043:     info('4b: registry declares no lexical modes; nothing to cross-check against the advisor');\n1044:     return;\n1045:   }\n1046:   const dumped = dumpAdvisorMap();\n1047:   if (!dumped) return;\n1048:   if (ctx.basename === GLOBAL_MAP_OWNER) {\n1049:     const expectedKeys = [...ids].sort();\n1050:     const dumpedKeys = Object.keys(dumped).sort();\n1051:     const match = expectedKeys.length === dumpedKeys.length && expectedKeys.every((k) => dumped[k] === lexicalIds[k]);\n1052:     if (match) {\n1053:       pass(`4b: registry lexical projection matches advisor DEEP_ROUTING_MODE_BY_KEY (${expectedKeys.length} keys)`);\n[Output truncated. Continue reading with offset: 1054]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/parent-skill-check.cjs\"}"},"time":{"start":1794531696650,"end":1794531697042}}}}
