ART_COMMAND, END_COMMAND);\\n  if (bounds !== null) {\\n    if (block !== null) return `${content.slice(0, bounds.start)}${block}${content.slice(bounds.end)}`;\\n    const before = content.slice(0, bounds.start).replace(/\\\\n\\\\n$/u, '');\\n    const after = content.slice(bounds.end).replace(/^\\\\n/u, '');\\n    return `${before}${after}`;\\n  }\\n  if (block === null) return content;\\n  const gateOne = splitBlock(content);\\n  if (gateOne.block === null) return content;\\n  const insertAt = gateOne.before.length + gateOne.block.length;\\n  return `${content.slice(0, insertAt)}\\\\n\\\\n${block}${content.slice(insertAt)}`;\\n}\\n\\n/** The content without the generated command block, its separator blank line and its own line ending. */\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs\"}"},"time":{"start":1794531882883,"end":1794531885080}}}}
