 spec-kit:gate1-pointer:start -->');\n43:     expect(text).toContain('lookup-trigger-index.mjs --json -- \"<prompt>\"');\n44:     // The text that was there before the block is untouched.\n45:     expect(text.startsWith(CURSOR_RULE)).toBe(true);\n46: \n47:     const after = run(root, '--check');\n48:     expect(after.status, after.stderr).toBe(0);\n49:     expect(after.stdout).toMatch(/PASS/u);\n50:   });\n51: \n52:   it('reports drift when a pointer block is edited by hand and is idempotent when rewritten', () => {\n53:     const cursorRule = path.join(root, '.cursor', 'rules', 'skill-routing.md');\n54:     const clean = fs.readFileSync(cursorRule, 'utf8');\n55:     fs.writeFileSync(cursorRule, clean.replace('lookup-trigger-index.mjs', 'lookup-trigger-index-old.mjs'));\n56:     const drifted = run(root, '--check');\n57:     expect(drifted.status).toBe(1);\n58:     expect(drifted.stderr).toMatch(/skill-routing\\.md: pointer block differs/u);\n59: \n60:     expect(run(root).status).toBe(0);\n61:     expect(fs.readFileSync(cursorRule, 'utf8')).toBe(clean);\n62:     expect(run(root).status).toBe(0);\n63:     expect(fs.readFileSync(cursorRule, 'utf8')).toBe(clean);\n64:   });\n65: \n66:   it('follows the root line when it changes', () => {\n67:     const rootAgents = path.join(root, 'AGENTS.md');\n68:     fs.writeFileSync(rootAgents, fs.readFileSync(rootAgents, 'utf8').replace('--json --', '--json --scope specs --'));\n69:     expect(run(root, '--check').status).toBe(1);\n70:     expect(run(root).status).toBe(0);\n71:     expect(fs.readFileSync(path.join(root, '.cursor', 'rules', 'skill-routing.md'), 'utf8')).toContain('--json --scope specs --');\n72:   });\n73: \n74:   it('exits 2 when the root AGENTS.md carries no Gate 1 line', () => {\n75:     const bare = fs.mkdtempSync(path.join(tmpdir(), 'gate1-pointer-bare-'));\n76:     try {\n77:       fs.writeFileSync(path.join(bare, 'AGENTS.md'), '# nothing here\\n');\n78:       const result = run(bare, '--check');\n79:       expect(result.status).toBe(2);\n80:       expect(result.stderr).toMatch(/carries no line naming lookup-trigger-index\\.mjs/u);\n81:     } finally {\n82:       fs.rmSync(bare, { recursive: true, force: true });\n83:     }\n84:   });\n85: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/tests/gate1-pointer-sync.vitest.ts\"}"},"time":{"start":1794531694471,"end":1794531695167}}}}
