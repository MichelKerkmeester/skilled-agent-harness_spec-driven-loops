{"type":"tool_use","timestamp":1794531879175,"sessionID":"ses_e2d9477f5ffe1omxWesfR9bi0G","part":{"partID":"prt_1d26f674f001LZP0GD3hRz3DeS","sessionID":"ses_e2d9477f5ffe1omxWesfR9bi0G","messageID":"msg_1d26f61ee001Ylcv4Fz1lTaQQi","type":"tool","id":"call_66819f4a3acd46db9762e936","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs, lines 1-247\n1: #!/usr/bin/env node\n2: 'use strict';\n3: // ───────────────────────────────────────────────────────────────────\n4: // MODULE: Gate 1 pointer synchronizer\n5: // ───────────────────────────────────────────────────────────────────\n6: // The Gate 1 trigger-index lookup instruction lives once, in the root\n7: // AGENTS.md. Claude reads that file directly, Pi loads it from the working\n8: // directory and Codex loads it as project instructions. The Cursor\n9: // rule that Cursor and Devin share is read on its own, so it carries pointer\n10: // blocks generated from the root lines rather than a hand-kept copy. The\n11: // second block carries the Gate 2 command rule and the direct advisor call\n12: // that replaces the per-prompt brief those clients do not receive. Write mode\n13: // rewrites the blocks in place; --check reports drift and writes nothing.\n14: //\n15: // Usage:\n16: //   node sync-gate1-pointers.cjs [--check] [--root <repo-root>]\n17: // Exit: 0 in sync (or written), 1 drift under --check, 2 usage or missing source.\n18: \n19: const fs = require('node:fs');\n20: const path = require('node:path');\n21: const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n22: \n23: const TAG = '[gate1-pointer-sync]';\n24: const START = '<!-- spec-kit:gate1-pointer:start -->';\n25: const END = '<!-- spec-kit:gate1-pointer:end -->';\n26: const START_COMMAND = '<!-- spec-kit:gate2-command-pointer:start -->';\n27: const END_COMMAND = '<!-- spec-kit:gate2-command-pointer:end -->';\n28: const SOURCE_FILE = 'AGENTS.md';\n29: const SOURCE_MARKER = 'lookup-trigger-index.mjs';\n30: const GATE_TWO_CALL_MARKER = 'skill-advisor.cjs advisor_recommend';\n31: const GATE_TWO_COMMAND_MARKER = '**Command in the brief.**';\n32: const GENERATED_BY = 'Generated by `node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs`; edit the root `AGENTS.md` line, not this block.';\n33: \n34: /** The instruction files that carry generated pointer blocks, relative to the repo root. */\n35: const TARGETS = [\n36:   {\n37:     file: path.join('.cursor', 'rules', 'skill-routing.md'),\n38:     intro: 'Gate 1 of the root `AGENTS.md` applies on every new prompt; before routing to a packet, run the lookup it names:',\n39:     commandIntro: 'Cursor gets no per-prompt advisor brief under the tested build. Before acting, run the direct call below, then apply the command rule:',\n40:   },\n41: ];\n42: \n43: function parseArgs(argv) {\n44:   const options = { check: false, root: null };\n45:   for (let index = 0; index < argv.length; index += 1) {\n46:     const arg = argv[index];\n47:     if (arg === '--check') options.check = true;\n48:     else if (arg === '--root') { options.root = argv[index + 1]; index += 1; }\n49:     else throw new Error(`Usage: node sync-gate1-pointers.cjs [--check] [--root <repo-root>] (unknown argument: ${arg})`);\n50:   }\n51:   if (options.root === undefined) throw new Error('--root requires a path');\n52:   return options;\n53: }\n54: \n55: /** The first root AGENTS.md line holding the marker, with a leading list number stripped, or null. */\n56: function readMarkedLine(repoRoot, marker) {\n57:   const sourcePath = path.join(repoRoot, SOURCE_FILE);\n58:   if (!fs.existsSync(sourcePath)) return null;\n59:   const line = fs.readFileSync(sourcePath, 'utf8').split(/\\r?\\n/u).find((candidate) => candidate.includes(marker));\n60:   return line ? line.trim().replace(/^\\d+\\.\\s*/u, '') : null;\n61: }\n62: \n63: /** The Gate 1 lookup line as the root AGENTS.md states it, or null when the file carries none. */\n64: function readGateOneLine(repoRoot) {\n65:   return readMarkedLine(repoRoot, SOURCE_MARKER);\n66: }\n67: \n68: /** The Gate 1 block each target carries, built from the root line so the two can never disagree. */\n69: function renderBlock(intro, gateOneLine) {\n70:   return [\n71:     START,\n72:     '## Gate 1 lookup (generated from the root AGENTS.md)',\n73:     '',\n74:     intro,\n75:     '',\n76:     gateOneLine,\n77:     '',\n78:     GENERATED_BY,\n79:     END,\n80:   ].join('\\n');\n81: }\n82: \n83: /** The Gate 2 command block, built from the root call and command lines so the two can never disagree. */\n84: function renderCommandBlock(commandIntro, callLine, commandLine) {\n85:   return [\n86:     START_COMMAND,\n87:     '## Gate 2 command routing (generated from the root AGENTS.md)',\n88:     '',\n89:     commandIntro,\n90:     '',\n91:     callLine,\n92:     '',\n93:     commandLine,\n94:     '',\n95:     GENERATED_BY,\n96:     END_COMMAND,\n97:   ].join('\\n');\n98: }\n99: \n100: /** The span of a tagged block, or null when either tag is missing or they appear out of order. */\n101: function blockBounds(content, startTag, endTag) {\n102:   const start = content.indexOf(startTag);\n103:   if (start === -1) return null;\n104:   const end = content.indexOf(endTag, start + startTag.length);\n105:   if (end === -1) return null;\n106:   return { start, end: end + endTag.length };\n107: }\n108: \n109: function splitBlock(content) {\n110:   const bounds = blockBounds(content, START, END);\n111:   if (bounds === null) return { before: content, block: null, after: '' };\n112:   return {\n113:     before: content.slice(0, bounds.start),\n114:     block: content.slice(bounds.start, bounds.end),\n115:     after: content.slice(bounds.end),\n116:   };\n117: }\n118: \n119: /** The file content with the generated block replaced or appended after the existing text. */\n120: function applyBlock(content, block) {\n121:   const parts = splitBlock(content);\n122:   if (parts.block !== null) return `${parts.before}${block}${parts.after}`;\n123:   const trimmed = content.replace(/\\s*$/u, '');\n124:   return `${trimmed}\\n\\n${block}\\n`;\n125: }\n126: \n127: /** The content with the command block placed after the Gate 1 block, replaced in place, or removed. */\n128: function applyCommandBlock(content, block) {\n129:   const bounds = blockBounds(content, START_COMMAND, END_COMMAND);\n130:   if (bounds !== null) {\n131:     if (block !== null) return `${content.slice(0, bounds.start)}${block}${content.slice(bounds.end)}`;\n132:     const before = content.slice(0, bounds.start).replace(/\\n\\n$/u, '');\n133:     const after = content.slice(bounds.end).replace(/^\\n/u, '');\n134:     return `${before}${after}`;\n135:   }\n136:   if (block === null) return content;\n137:   const gateOne = splitBlock(content);\n138:   if (gateOne.block === null) return content;\n139:   const insertAt = gateOne.before.length + gateOne.block.length;\n140:   return `${content.slice(0, insertAt)}\\n\\n${block}${content.slice(insertAt)}`;\n141: }\n142: \n143: /** The content without the generated command block, its separator blank line and its own line ending. */\n144: function removeCommandBlock(content) {\n145:   const bounds = blockBounds(content, START_COMMAND, END_COMMAND);\n146:   if (bounds === null) return content;\n147:   const lineStart = content.lastIndexOf('\\n', bounds.start - 1) + 1;\n148:   let lineEnd = bounds.end;\n149:   if (content.startsWith('\\n', lineEnd)) lineEnd += 1;\n150:   const before = content.slice(0, lineStart);\n151:   const trimmed = before.endsWith('\\n\\n') ? before.slice(0, -1) : before;\n152:   return `${trimmed}${content.slice(lineEnd)}`;\n153: }\n154: \n155: /** The command block as the target carries it, or null when the block is absent. */\n156: function readCommandBlock(content) {\n157:   const bounds = blockBounds(content, START_COMMAND, END_COMMAND);\n158:   return bounds === null ? null : content.slice(bounds.start, bounds.end);\n159: }\n160: \n161: /** The content with the command block right after the Gate 1 block, or without it when there is none to write. */\n162: function applyCommandBlock(content, block) {\n163:   const withoutCommand = removeCommandBlock(content);\n164:   if (block === null) return withoutCommand;\n165:   const gateOne = splitBlock(withoutCommand);\n166:   if (gateOne.block === null) return withoutCommand;\n167:   const at = gateOne.before.length + gateOne.block.length;\n168:   const tail = withoutCommand.slice(at).replace(/^\\n\\n?/u, '');\n169:   return `${withoutCommand.slice(0, at)}\\n\\n${block}${tail === '' ? '\\n' : `\\n\\n${tail}`}`;\n170: }\n171: \n172: function main(argv) {\n173:   const options = parseArgs(argv);\n174:   const repoRoot = options.root ? path.resolve(options.root) : findRepoRoot(__dirname);\n175:   const gateOneLine = readGateOneLine(repoRoot);\n176:   if (!gateOneLine) {\n177:     console.error(`${TAG} ERROR: ${SOURCE_FILE} under ${repoRoot} carries no line naming ${SOURCE_MARKER}`);\n178:     return 2;\n179:   }\n180:   const callLine = readMarkedLine(repoRoot, GATE_TWO_CALL_MARKER);\n181:   const commandLine = readMarkedLine(repoRoot, GATE_TWO_COMMAND_MARKER);\n182: \n183:   const drift = [];\n184:   let written = 0;\n185:   for (const target of TARGETS) {\n186:     const targetPath = path.join(repoRoot, target.file);\n187:     if (!fs.existsSync(targetPath)) {\n188:       drift.push(`${target.file}: missing`);\n189:       continue;\n190:     }\n191:     const current = fs.readFileSync(targetPath, 'utf8');\n192:     const gateOneBlock = renderBlock(target.intro, gateOneLine);\n193:     const commandBlock = callLine && commandLine ? renderCommandBlock(target.commandIntro, callLine, commandLine) : null;\n194:     const expected = applyCommandBlock(applyBlock(current, gateOneBlock), commandBlock);\n195:     if (current === expected) continue;\n196:     if (options.check) {\n197:       const driftStart = drift.length;\n198:       const gateOneCurrent = splitBlock(current).block;\n199:       if (gateOneCurrent !== gateOneBlock) {\n200:         drift.push(`${target.file}: ${gateOneCurrent === null ? 'no Gate 1 pointer block' : 'pointer block differs from the root AGENTS.md line'}`);\n201:       }\n202:       const commandCurrent = readCommandBlock(current);\n203:       if (commandCurrent !== commandBlock) {\n204:         drift.push(`${target.file}: ${commandCurrent === null ? 'no Gate 2 command block' : 'pointer block differs from the root AGENTS.md Gate 2 lines'}`);\n205:       }\n206:       if (drift.length === driftStart) drift.push(`${target.file}: pointer block differs from the root AGENTS.md Gate 2 lines`);\n207:       continue;\n208:     }\n209:     fs.writeFileSync(targetPath, expected, 'utf8');\n210:     written += 1;\n211:   }\n212: \n213:   if (drift.length > 0) {\n214:     console.error(`${TAG} Drift detected:`);\n215:     for (const item of drift) console.error(`${TAG} ${item}`);\n216:     return 1;\n217:   }\n218:   if (options.check) console.log(`${TAG} PASS: ${TARGETS.length} instruction files carry the root Gate 1 and Gate 2 pointers.`);\n219:   else console.log(`${TAG} Wrote ${written} of ${TARGETS.length} pointer blocks.`);\n220:   return 0;\n221: }\n222: \n223: if (require.main === module) {\n224:   try {\n225:     process.exitCode = main(process.argv.slice(2));\n226:   } catch (error) {\n227:     console.error(`${TAG} ERROR: ${error.message}`);\n228:     process.exitCode = 2;\n229:   }\n230: }\n231: \n232: module.exports = {\n233:   TARGETS,\n234:   START,\n235:   END,\n236:   START_COMMAND,\n237:   END_COMMAND,\n238:   GATE_TWO_CALL_MARKER,\n239:   GATE_TWO_COMMAND_MARKER,\n2