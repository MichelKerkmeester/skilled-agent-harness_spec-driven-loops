rectory; 64\n78: // bits of it is what makes two different plans sharing one a non-event.\n79: const BACKUP_NAME_CHARS = 16;\n80: // How many of this composition's directories a plan will step past before it gives up. The\n81: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n82: // a normal one.\n83: const BACKUP_ATTEMPTS = 64;\n84: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n85: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n86: \n87: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n88: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n89: // and every removal is checked against this list by `assertWritable` before it happens.\n90: const ALLOWLIST = [\n91:   'AGENTS.md',\n92:   'CLAUDE.md',\n93:   '.codex/AGENTS.md',\n94:   '.cursor/rules/repo-local.md',\n95:   '.cursor/rules/skill-routing.md',\n96:   'REPO RULES.md',\n97: ];\n98: \n99: // A copy at one of these paths is read for its unique lines and then removed. Every other\n[Output truncated. Continue reading with offset: 100]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 55-99\n55:   sha256,\n56: } = require('./lib/agents-md-sections.cjs');\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: const TAG = '[agents-md-embed]';\n63: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n64: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n65: \n66: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n67: // its generator, and the router verdict belongs to th