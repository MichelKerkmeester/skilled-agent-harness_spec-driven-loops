{"type":"tool_use","timestamp":1794531941993,"sessionID":"ses_e2d9477f5ffe1omxWesfR9bi0G","part":{"partID":"prt_1d2705b74001KUIv7hI4Cec6BA","sessionID":"ses_e2d9477f5ffe1omxWesfR9bi0G","messageID":"msg_1d27055ec001oG326L9sqfbuvA","type":"tool","id":"call_04d7be735bcf4c36adc9f3f8","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs b/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs\nindex 1528e7bc2b..96f3d2a506 100644\n--- a/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs\n@@ -6,9 +6,11 @@\n // The Gate 1 trigger-index lookup instruction lives once, in the root\n // AGENTS.md. Claude reads that file directly, Pi loads it from the working\n // directory and Codex loads it as project instructions. The Cursor\n-// rule that Cursor and Devin share is read on its own, so it carries a pointer\n-// block generated from the root line rather than a hand-kept copy. Write mode\n-// rewrites the block in place; --check reports drift and writes nothing.\n+// rule that Cursor and Devin share is read on its own, so it carries pointer\n+// blocks generated from the root lines rather than a hand-kept copy. The\n+// second block carries the Gate 2 command rule and the direct advisor call\n+// that replaces the per-prompt brief those clients do not receive. Write mode\n+// rewrites the blocks in place; --check reports drift and writes nothing.\n //\n // Usage:\n //   node sync-gate1-pointers.cjs [--check] [--root <repo-root>]\n@@ -21,14 +23,20 @@ const { findRepoRoot } = require('@spec-kit/shared/workspace/repo-root.mjs');\n const TAG = '[gate1-pointer-sync]';\n const START = '<!-- spec-kit:gate1-pointer:start -->';\n const END = '<!-- spec-kit:gate1-pointer:end -->';\n+const START_COMMAND = '<!-- spec-kit:gate2-command-pointer:start -->';\n+const END_COMMAND = '<!-- spec-kit:gate2-command-pointer:end -->';\n const SOURCE_FILE = 'AGENTS.md';\n const SOURCE_MARKER = 'lookup-trigger-index.mjs';\n+const GATE_TWO_CALL_MARKER = 'skill-advisor.cjs advisor_recommend';\n+const GATE_TWO_COMMAND_MARKER = '**Command in the brief.**';\n+const GENERATED_BY = 'Generated by `node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs`; edit the root `AGENTS.md` line, not this block.';\n \n-/** The instruction files that carry a generated pointer block, relative to the repo root. */\n+/** The instruction files that carry generated pointer blocks, relative to the repo root. */\n const TARGETS = [\n   {\n     file: path.join('.cursor', 'rules', 'skill-routing.md'),\n     intro: 'Gate 1 of the root `AGENTS.md` applies on every new prompt; before routing to a packet, run the lookup it names:',\n+    commandIntro: 'Cursor gets no per-prompt advisor brief under the tested build. Before acting, run the direct call below, then apply the command rule:',\n   },\n ];\n \n@@ -44,15 +52,20 @@ function parseArgs(argv) {\n   return options;\n }\n \n-/** The Gate 1 lookup line as the root AGENTS.md states it, or null when the file carries none. */\n-function readGateOneLine(repoRoot) {\n+/** The first root AGENTS.md line holding the marker, with a leading list number stripped, or null. */\n+function readMarkedLine(repoRoot, marker) {\n   const sourcePath = path.join(repoRoot, SOURCE_FILE);\n   if (!fs.existsSync(sourcePath)) return null;\n-  const line = fs.readFileSync(sourcePath, 'utf8').split(/\\r?\\n/u).find((candidate) => candidate.includes(SOURCE_MARKER));\n+  const line = fs.readFileSync(sourcePath, 'utf8').split(/\\r?\\n/u).find((candidate) => candidate.includes(marker));\n   return line ? line.trim().replace(/^\\d+\\.\\s*/u, '') : null;\n }\n \n-/** The block each target carries, built from the root line so the two can never disagree. */\n+/** The Gate 1 lookup line as the root AGENTS.md states it, or null when the file carries none. */\n+function readGateOneLine(repoRoot) {\n+  return readMarkedLine(repoRoot, SOURCE_MARKER);\n+}\n+\n+/** The Gate 1 block each target carries, built from the root line so the two can never disagree. */\n function renderBlock(intro, gateOneLine) {\n   return [\n     START,\n@@ -62,19 +75,44 @@ function renderBlock(intro, gateOneLine) {\n     '',\n     gateOneLine,\n     '',\n-    `Generated by \\`node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs\\`; edit the root \\`AGENTS.md\\` line, not this block.`,\n+    GENERATED_BY,\n     END,\n   ].join('\\n');\n }\n \n+/** The Gate 2 command block, built from the root call and command lines so the two can never disagree. */\n+function renderCommandBlock(commandIntro, callLine, commandLine) {\n+  return [\n+    START_COMMAND,\n+    '## Gate 2 command routing (generated from the root AGENTS.md)',\n+    '',\n+    commandIntro,\n+    '',\n+    callLine,\n+    '',\n+    commandLine,\n+    '',\n+    GENERATED_BY,\n+    END_COMMAND,\n+  ].join('\\n');\n+}\n+\n+/** The span of a tagged block, or null when either tag is missing or they appear out of order. */\n+function blockBounds(content, startTag, endTag) {\n+  const start = content.indexOf(startTag);\n+  if (start === -1) return null;\n+  const end = content.indexOf(endTag, start + startTag.length);\n+  if (end === -1) return null;\n+  return { start, end: end + endTag.length };\n+}\n+\n function splitBlock(content) {\n-  const start = content.indexOf(START);\n-  const end = content.indexOf(END);\n-  if (start === -1 || end === -1 || end < start) return { before: content, block: null, after: '' };\n+  const bounds = blockBounds(content, START, END);\n+  if (bounds === null) return { before: content, block: null, after: '' };\n   return {\n-    before: content.slice(0, start),\n-    block: content.slice(start, end + END.length),\n-    after: content.slice(end + END.length),\n+    before: content.slice(0, bounds.start),\n+    block: content.slice(bounds.start, bounds.end),\n+    after: content.slice(bounds.end),\n   };\n }\n \n@@ -86,6 +124,35 @@ function applyBlock(content, block) {\n   return `${trimmed}\\n\\n${block}\\n`;\n }\n \n+/** The content without the generated command block, its separator blank line and its own line ending. */\n+function removeCommandBlock(content) {\n+  const bounds = blockBounds(content, START_COMMAND, END_COMMAND);\n+  if (bounds === null) return content;\n+  const lineStart = content.lastIndexOf('\\n', bounds.start - 1) + 1;\n+  let lineEnd = bounds.end;\n+  if (content.startsWith('\\n', lineEnd)) lineEnd += 1;\n+  const before = content.slice(0, lineStart);\n+  const trimmed = before.endsWith('\\n\\n') ? before.slice(0, -1) : before;\n+  return `${trimmed}${content.slice(lineEnd)}`;\n+}\n+\n+/** The command block as the target carries it, or null when the block is absent. */\n+function readCommandBlock(content) {\n+  const bounds = blockBounds(content, START_COMMAND, END_COMMAND);\n+  return bounds === null ? null : content.slice(bounds.start, bounds.end);\n+}\n+\n+/** The content with the command block right after the Gate 1 block, or without it when there is none to write. */\n+function applyCommandBlock(content, block) {\n+  const withoutCommand = removeCommandBlock(content);\n+  if (block === null) return withoutCommand;\n+  const gateOne = splitBlock(withoutCommand);\n+  if (gateOne.block === null) return withoutCommand;\n+  const at = gateOne.before.length + gateOne.block.length;\n+  const tail = withoutCommand.slice(at).replace(/^\\n\\n?/u, '');\n+  return `${withoutCommand.slice(0, at)}\\n\\n${block}${tail === '' ? '\\n' : `\\n\\n${tail}`}`;\n+}\n+\n function main(argv) {\n   const options