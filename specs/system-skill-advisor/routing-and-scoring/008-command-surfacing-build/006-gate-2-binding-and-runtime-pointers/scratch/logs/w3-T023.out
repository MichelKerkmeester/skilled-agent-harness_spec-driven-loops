{"type":"tool_use","timestamp":1794532723242,"sessionID":"ses_e2d850773ffebCIKUSdB78wWlS","part":{"partID":"prt_1d27c2a960012bRL68w6g48YET","sessionID":"ses_e2d850773ffebCIKUSdB78wWlS","messageID":"msg_1d27bed9d001fl72LfONrz7D5k","type":"tool","id":"call_205c38a62e6c4c9987e223cd","tool":"write","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Child Session Brief Render Tests\n// ───────────────────────────────────────────────────────────────\n\nimport { afterEach, describe, expect, it, vi } from 'vitest';\nimport {\n  DIRECTIVES_LABEL,\n  HYGIENE_DIRECTIVE,\n  renderAdvisorBrief,\n} from '../lib/render.js';\n\ntype AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n\nfunction expectedBrief(summary: string): string {\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n}\n\n// One passing recommendation isolates the label form from threshold filtering.\nfunction advisorResult(skill: string): AdvisorBriefResult {\n  return {\n    status: 'ok',\n    freshness: 'live',\n    recommendations: [{\n      skill,\n      kind: 'command',\n      confidence: 0.85,\n      uncertainty: 0.2,\n      passes_threshold: true,\n    }],\n    metrics: { tokenCap: 80 },\n  };\n}\n\ndescribe('child session command brief', () => {\n  afterEach(() => {\n    vi.unstubAllEnvs();\n  });\n\n  it('renders a start command as parent-named only', () => {\n    vi.stubEnv('AI_SESSION_CHILD', '1');\n\n    const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\n    ));\n  });\n\n  it('renders an ask command as parent-named only', () => {\n    vi.stubEnv('AI_SESSION_CHILD', '1');\n\n    const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\n    ));\n  });\n\n  it('keeps the policy word for a read-only run', () => {\n    vi.stubEnv('AI_SESSION_CHILD', '1');\n\n    const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\n\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\n    ));\n  });\n\n  it('renders a run command that adds files as parent-named only', () => {\n    vi.stubEnv('AI_SESSION_CHILD', '1');\n\n    const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\n\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\n    ));\n  });\n\n  it('matches the non-child render when the variable is 0', () => {\n    vi.stubEnv('AI_SESSION_CHILD', '0');\n    const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n\n    const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n\n    expect(rendered).toBe(baseline);\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\n    ));\n  });\n\n  it('matches the non-child render when the variable is unset', () => {\n    vi.stubEnv('AI_SESSION_CHILD', undefined);\n    const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\n\n    const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n\n    expect(rendered).toBe(baseline);\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\n    ));\n  });\n\n  it('renders a doctor bridge at the top as parent-named only', () => {\n    vi.stubEnv('AI_SESSION_CHILD', '1');\n\n    const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\n\n    expect(rendered).toBe(expectedBrief(\n      'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n    ));\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Child Session Brief Render Tests\\n// ───────────────────────────────────────────────────────────────\\n\\nimport { afterEach, describe, expect, it, vi } from 'vitest';\\nimport {\\n  DIRECTIVES_LABEL,\\n  HYGIENE_DIRECTIVE,\\n  renderAdvisorBrief,\\n} from '../lib/render.js';\\n\\ntype AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\\n\\nfunction expectedBrief(summary: string): string {\\n  return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\\n}\\n\\n// One passing recommendation isolates the label form from threshold filtering.\\nfunction advisorResult(skill: string): AdvisorBriefResult {\\n  return {\\n    status: 'ok',\\n    freshness: 'live',\\n    recommendations: [{\\n      skill,\\n      kind: 'command',\\n      confidence: 0.85,\\n      uncertainty: 0.2,\\n      passes_threshold: true,\\n    }],\\n    metrics: { tokenCap: 80 },\\n  };\\n}\\n\\ndescribe('child session command brief', () => {\\n  afterEach(() => {\\n    vi.unstubAllEnvs();\\n  });\\n\\n  it('renders a start command as parent-named only', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', '1');\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\\n\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\\n    ));\\n  });\\n\\n  it('renders an ask command as parent-named only', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', '1');\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\\n\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\\n    ));\\n  });\\n\\n  it('keeps the policy word for a read-only run', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', '1');\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\\n\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\\n    ));\\n  });\\n\\n  it('renders a run command that adds files as parent-named only', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', '1');\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\\n\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\\n    ));\\n  });\\n\\n  it('matches the non-child render when the variable is 0', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', '0');\\n    const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\\n\\n    expect(rendered).toBe(baseline);\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\\n    ));\\n  });\\n\\n  it('matches the non-child render when the variable is unset', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', undefined);\\n    const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\\n\\n    expect(rendered).toBe(baseline);\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\\n    ));\\n  });\\n\\n  it('renders a doctor bridge at the top as parent-named only', () => {\\n    vi.stubEnv('AI_SESSION_CHILD', '1');\\n\\n    const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\\n\\n    expect(rendered).toBe(expectedBrief(\\n      'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\\n    ));\\n  });\\n});\\n\"}"},"time":{"start":1794532715158,"end":1794532723242}}}}
