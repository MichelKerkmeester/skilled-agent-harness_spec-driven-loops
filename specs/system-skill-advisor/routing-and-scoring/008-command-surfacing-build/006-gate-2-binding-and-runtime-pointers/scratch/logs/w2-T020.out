otice = [\n310:     'SPEC FOLDER QUESTION - this session has no bound spec folder and a file mutation is about to run.',\n311:     'Ask the operator once where this change should live. Recommend one option first and say why, never a neutral menu. Then continue:',\n312:     'A) Use an existing spec folder - reply with its path, e.g. specs/<track>/<NNN-name>',\n313:     'B) Create a new spec folder for new or unrelated work - reply with its path, e.g. specs/<track>/<NNN-name> (it does not have to exist yet)',\n314:     'C) A related folder, a phase child, or a series parent for a different change to the same artifact as an existing packet in the same track - reply with its path',\n315:     'D) Skip - no spec folder needed for this change',\n316:     'The answer holds for the rest of this session: do not ask this again on later turns.',\n317:     'Once the folder is chosen, write its spec documents by following .skilled/skills/system-spec-kit/references/workflows/spec-authoring-card.md.',\n318:   ].join('\\n');\n319:   assert.deepEqual(Buffer.from(core.GATE_3_QUESTION, 'utf8'), Buffer.from(baseline, 'utf8'));\n320:   assert.deepEqual(Buffer.from(core.GATE_3_MUTATION_NOTICE, 'utf8'), Buffer.from(mutationNotice, 'utf8'));\n321:   assert.equal(core.GATE_3_CHOICE_EXISTING, 'Use an existing spec folder');\n322:   assert.equal(core.GATE_3_CHOICE_NEW, 'Create a new spec folder for new or unrelated work');\n323:   assert.equal(core.GATE_3_CHOICE_RELATED, 'Use a related folder, phase child, or a series parent for a different change to the same artifact as an existing packet in the same track');\n324:   assert.equal(core.GATE_3_CHOICE_SKIP, 'Skip - no spec folder needed for this change');\n325:   assert.equal(core.buildGate3ObservedReceipt().plannedHash, 'a180a01a7ea3ceda3a5557b0486b07d28a09d0b21edf5f985c058099006bbf29');\n326:   const seededRequest = observedGate3Request();\n327:   core.observeGate3QuestionDelivery(seededRequest);\n328:   const result = core.observeGate3QuestionDelivery({ ...seededRequest, env: { [core.CHILD_SESSION_ENV]: '0' } });\n329: \n330:   assert.deepEqual(Buffer.from(result.question, 'utf8'), Buffer.from(baseline, 'utf8'));\n331:   assert.equal(result.suppressionEligible, false);\n332:   assert.equal(result.suppressionConsumed, false);\n333:   assert.equal(core.getGate3ShadowReceipts().length, 1);\n334: \n335:   const reenabled = core.observeGate3QuestionDelivery({\n336:     ...seededRequest,\n337:     receipt: undefined,\n338:   });\n339:   assert.equal(reenabled.suppressionEligible, false, 'turning the flag off must clear delivery state');\n340:   assert.deepEqual(Buffer.from(reenabled.question, 'utf8'), Buffer.from(baseline, 'utf8'));\n341: });\n342: \n343: test('Gate-3 shadow receipt records the planned and emitted full relay', () => {\n344:   core.resetGate3DeliveryShadow();\n345:   const receipts = [];\n346:   const firstRequest = observedGate3Request({\n347:     sessionID: 'receipt-session',\n348:     lifecycleEpoch: 1,\n349:     onShadowReceipt: (receipt) => receipts.push(receipt),\n[Output truncated. Continue reading with offset: 350]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-core.test.mjs\",\"offset\":270,\"limit\":80}"},"time":{"start":1794532165733,"end":1794532166306}}}}
