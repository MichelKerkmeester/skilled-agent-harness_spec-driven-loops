.md\n M .skilled/skills/system-skill-advisor/runtime/bench/hook-brief-signal-noise.bench.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/advisor-runtime-values.ts\n M .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n M .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n M .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n M .skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-observability.vitest.ts\n M .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/README.md\n M .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs\n M .skilled/skills/system-spec-kit/runtime/cli/spec/create.sh\n M .skilled/skills/system-spec-kit/runtime/cli/tests/gate1-pointer-sync.vitest.ts\n M .skilled/skills/system-spec-kit/runtime/hooks/lib/spec-gate/spec-gate-core.mjs\n M .skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-core.test.mjs\n M AGENTS.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/acceptance-criteria.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/implementation-summary.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/spec.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/005-recommendation-contract-and-brief/tasks.md\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/006-gate-2-binding-and-runtime-pointers/graph-metadata.json\n M specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/006-gate-2-binding-and-runtime-pointers/tasks.md\n M specs/system-skill-advisor/routing-and-scoring/008-command