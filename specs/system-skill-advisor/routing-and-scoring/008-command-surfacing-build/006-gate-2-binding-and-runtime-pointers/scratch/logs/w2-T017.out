"ts\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"add gate 2 pointer sync test cases to gate1 pointer sync vitest ts\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"add\",\n    \"gate\",\n    \"pointer\",\n    \"sync\",\n    \"test\",\n    \"cases\",\n    \"gate1\",\n    \"vitest\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 236,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"add gate 2 pointer sync test cases to gate1-pointer-sync.vitest.ts\\\" 2>&1 | head -40\"}"},"time":{"start":1794532205434,"end":1794532206735}}}}
