', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n102:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n103:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n104:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n105:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n106:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n107:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n108:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n109:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n110:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n111:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n112: };\n113: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n114:   '/create:agent': 'start',\n115:   '/create:changelog': 'ask',\n116:   '/create:feature-catalog': 'start',\n117:   '/create:manual-testing-playbook': 'start',\n118:   '/create:readme': 'start',\n119:   '/create:skill': 'start',\n120:   '/deep:research': 'ask',\n121:   '/deep:review': 'ask',\n122:   '/doctor:agents-md check': 'run',\n123:   '/doctor:agents-md embed': 'ask',\n124:   '/doctor:agents-md restore': 'ask',\n125:   '/doctor:ci report': 'run',\n126:   '/doctor:ci scaffold': 'ask',\n127:   '/doctor:ci toggle': 'ask',\n128:   '/doctor:deep-loop': 'run',\n129:   '/doctor:env list': 'run',\n130:   '/doctor:git hooks': 'ask',\n131:   '/doctor:git setup': 'run',\n132:   '/doctor:git standards': 'ask',\n133:   '/doctor:helper': 'run',\n134:   '/doctor:install': 'run',\n135:   '/doctor:mcp debug': 'ask',\n136:   '/doctor:mcp install': 'ask',\n137:   '/doctor:overlay apply': 'ask',\n138:   '/doctor:overlay repin': 'ask',\n139:   '/doctor:overlay status': 'run',\n140:   '/doctor:runtime-mirrors': 'run',\n141:   '/doctor:setup': 'run',\n142:   '/doctor:sk-code quality': 'ask',\n143:   '/doctor:sk-code setup': 'run',\n144:   '/doctor:sk-skill check': 'run',\n145:   '/doctor:sk-skill convert': 'ask',\n146:   '/doctor:skill-advisor parent-skill': 'run',\n147:   '/doctor:skill-advisor rebuild': 'ask',\n148:   '/doctor:skill-advisor router-reach': 'run',\n149:   '/doctor:skill-advisor skill-budget': 'run',\n150:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n151:   '/doctor:skill-advisor tune': 'ask',\n152:   '/doctor:speckit': 'run',\n153:   '/doctor:symlink check': 'run',\n154:   '/doctor:symlink link': 'ask',\n155:   '/doctor:symlink unlink': 'ask',\n156:   '/doctor:update': 'ask',\n157:   '/prompt:improve': 'start',\n158:   '/speckit:complete': 'start',\n159:   '/speckit:handoff': 'ask',\n160:   '/speckit:implement': 'start',\n161:   '/speckit:plan': 'start',\n162:   '/speckit:resume': 'start',\n163:   '/speckit:save': 'start',\n164:   '/speckit:search': 'run',\n165: };\n166: // END GENERATED COMMAND ROWS\n167: \n168: // The row for an id a recommendation carries, or undefined when that id names no\n169: // command. Own-key lookup because the table is generated data, so an inherited\n170: // name such as `constructor` must not resolve to a row nobody declared.\n171: export function commandRowFor(id: string): CommandRow | undefined {\n172:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n173: }\n174: \n175: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n176: // that merely mentions the topic spends the reader's budget on work they never\n177: // asked for. The list below is the vocabulary that counts as asking for it, and\n178: // it holds only effort wording: a bare topic word such as `research`, `review`\n179: // or `council` says what to look at, never how far to go, so it never qualifies\n180: // on its own.\n181: //\n182: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n183: // has to judge stays visible and cheap to correct.\n184: export const DEPTH_WORDING: readonly string[] = [\n185:   'in depth',\n186:   'deep dive',\n187:   'deep research',\n188:   'deep review',\n189:   'thorough',\n190:   'thoroughly',\n191:   'exhaustive',\n192:   'iteratively',\n193:   'multiple passes',\n194:   'many passes',\n195:   'several passes',\n196:   'ask the council',\n197:   'convene',\n198:   'several models',\n199:   'final verdict',\n200:   'everything you can',\n201: ];\n202: \n203: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n204: // escaped before it is trusted as a pattern.\n205: function escapePhrase(phrase: string): string {\n206:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n207: }\n208: \n209: // One alternation over the list keeps the gate a single test per prompt, and the\n210: // boundary markers keep `thorough` from firing inside a longer word while a\n211: // multi-word phrase still has to match as a whole.\n212: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n213: \n214: // A compiled route arrives as unvalidated JSON from a separate process, so the\n215: // shape is narrowed here rather than trusted. Arrays count as objects in\n216: // JavaScript and would let `action` read off an unrelated field, so they are\n217: // excluded explicitly.\n218: function asRecord(value: unknown): Record<string, unknown> | undefined {\n219:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n220:   return value as Record<string, unknown>;\n221: }\n222: \n223: // The command for a hub's recommendation, or undefined when the route does not\n224: // single out one mode. Only a single-mode route names a command unambiguously:\n225: // a bundle or a multi-target route has more than one answer, and asking the\n226: // reader to pick belongs to the recommend path, not here. Never throws, because\n227: // a missing command must degrade to \"no command offered\" rather than break\n228: // routing. The prompt decides whether a costly deep-loop command is offered at\n229: // all: a reader who only asks about the topic gets no command, rather than one\n230: // that would launch work they never requested.\n231: export function attachCommand(\n232:   skillId: string,\n233:   compiledRoute: unknown,\n234:   prompt: string,\n235:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n236: ): string | undefined {\n237:   const route = asRecord(compiledRoute);\n238:   if (!route) return undefined;\n239:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n240: \n241:   const targets = route.targets;\n242:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n243: \n244:   const onlyTarget = asRecord(targets[0]);\n245:   if (!onlyTarget) return undefined;\n246: \n247:   const workflowMode = onlyTarget.workflowMode;\n248:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n249: \n250:   // Own-key lookup on both levels: the table is data read from a generated\n251:   // object, so an inherited name such as `constructor` must not resolve to a\n252:   // command the hub never declared.\n253:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n254:   const commands = modeCommands[skillId];\n255:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n256: \n257:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n258:   // run, so they are offered only when the prompt asks for that effort. Typing\n259:   // the slash command is itself the ask, and every other hub answers a short\n260:   // question with a short answer, so no other skill consults the wording list.\n261:   if (skillId === 'system-deep-loop') {\n262:     const lowered = prompt.toLowerCase();\n263:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n264:   }\n265: \n266:   return commands[workflowMode];\n267: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794532176546,"end":1794532177381}}}}
{"type":"tool_use","timestamp":1794532177385,"sessionID":"ses_e2d8e593affeqxRun8M4iooLPr","part":{"partID":"prt_1d273f45b001G2fzsGvAq1e7ff","sessionID":"ses_e2d8e593affeqxRun8M4iooLPr","messageID":"msg_1d273d3550017dmdkB72878Nje","type":"tool","id":"call_23ad8320b9304535aa68b01b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-146\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   doctorCommandString,\n8:   renderAdvisorBrief,\n9:   renderAdvisorFallbackDirective,\n10:   sanitizeSkillLabel,\n11: } from '../lib/render.js';\n12: \n13: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n14: // Every brief ends with the always-delivered hygiene capsule that\n15: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n16: const DIRECTIVES_LABEL = '\\nDirectives:';\n17: \n18: function expectedBrief(summary: string): string {\n19:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n20: }\n21: \n22: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n23: \n24: interface RecommendationInput {\n25:   readonly skill: string;\n26:   readonly kind: 'skill' | 'command';\n27:   readonly confidence: number;\n28:   readonly uncertainty: number;\n29: }\n30: \n31: // Every recommendation is marked as passing so each case isolates label\n32: // rendering instead of threshold filtering.\n33: function advisorResult(\n34:   recommendations: readonly RecommendationInput[],\n35:   tokenCap: number = 80,\n36: ): AdvisorBriefResult {\n37:   return {\n38:     status: 'ok',\n39:     freshness: 'live',\n40:     recommendations: recommendations.map((recommendation) => ({\n41:       ...recommendation,\n42:       passes_threshold: true,\n43:     })),\n44:     metrics: { tokenCap },\n45:   };\n46: }\n47: \n48: describe('doctor command brief', () => {\n49:   it('renders a top doctor bridge as its runnable command', () => {\n50:     const rendered = renderAdvisorBrief(advisorResult([\n51:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n52:     ]));\n53: \n54:     expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n55:   });\n56: \n57:   it('keeps the complete companion before directives under the default cap', () => {\n58:     const rendered = renderAdvisorBrief(advisorResult([\n59:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n60:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n61:     ]));\n62: \n63:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n64:   });\n65: \n66:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n67:     const rendered = renderAdvisorBrief(advisorResult([\n68:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n69:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n70:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n71:     ])) ?? '';\n72: \n73:     expect(rendered).toContain('\\nAlso: /doctor:update');\n74:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n75:   });\n76: \n77:   it('never renders a raw or unmapped doctor id', () => {\n78:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n79:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n80:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n81:     ]));\n82:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n83: \n84:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n85:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n86:     ]));\n87:     expect(unmappedBridgeAlone).toBeNull();\n88: \n89:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n90:       expect(rendered).not.toContain('command-doctor-');\n91:     }\n92:   });\n93: \n94:   it('renders no companion line when no doctor bridge passes', () => {\n95:     const rendered = renderAdvisorBrief(advisorResult([\n96:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n97:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n98:     ]));\n99: \n100:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n101:   });\n102: \n103:   it('drops the entire companion when it does not fit the character cap', () => {\n104:     const rendered = renderAdvisorBrief(advisorResult([\n105:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n106:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n107:     ], 20)) ?? '';\n108:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n109:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n110: \n111:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n112:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n113:     expect(cappedPortion).not.toContain('Also:');\n114:     expect(cappedPortion).not.toContain('/doctor:');\n115:   });\n116: \n117:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n118:     const bridgeIds = [\n119:       'command-doctor-setup',\n120:       'command-doctor-env',\n121:       'command-doctor-git-setup',\n122:       'command-doctor-git-hooks',\n123:       'command-doctor-update',\n124:     ];\n125:     let mappedCount = 0;\n126:     for (const bridgeId of bridgeIds) {\n127:       const command = doctorCommandString(bridgeId);\n128:       if (command === null) {\n129:         continue;\n130:       }\n131:       mappedCount += 1;\n132:       expect(sanitizeSkillLabel(command)).toBe(command);\n133:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n134:     }\n135:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts, lines 1-146\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import {\n7:   doctorCommandString,\n8:   renderAdvisorBrief,\n9:   renderAdvisorFallbackDirective,\n10:   sanitizeSkillLabel,\n11: } from '../lib/render.js';\n12: \n13: const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n14: // Every brief ends with the always-delivered hygiene capsule that\n15: // renderAdvisorBrief appends after the capped advisor portion (lib/render.ts).\n16: const DIRECTIVES_LABEL = '\\nDirectives:';\n17: \n18: function expectedBrief(summary: string): string {\n19:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n20: }\n21: \n22: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n23: \n24: interface RecommendationInput {\n25:   readonly skill: string;\n26:   readonly kind: 'skill' | 'command';\n27:   readonly confidence: number;\n28:   readonly uncertainty: number;\n29: }\n30: \n31: // Every recommendation is marked as passing so each case isolates label\n32: // rendering instead of threshold filtering.\n33: function advisorResult(\n34:   recommendations: readonly RecommendationInput[],\n35:   tokenCap: number = 80,\n36: ): AdvisorBriefResult {\n37:   return {\n38:     status: 'ok',\n39:     freshness: 'live',\n40:     recommendations: recommendations.map((recommendation) => ({\n41:       ...recommendation,\n42:       passes_threshold: true,\n43:     })),\n44:     metrics: { tokenCap },\n45:   };\n46: }\n47: \n48: describe('doctor command brief', () => {\n49:   it('renders a top doctor bridge as its runnable command', () => {\n50:     const rendered = renderAdvisorBrief(advisorResult([\n51:       { skill: 'command-doctor-setup', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n52:     ]));\n53: \n54:     expect(rendered).toBe(expectedBrief('Advisor: live; use system-skilled-doctor → /doctor:setup (run) 0.85/0.20 pass.'));\n55:   });\n56: \n57:   it('keeps the complete companion before directives under the default cap', () => {\n58:     const rendered = renderAdvisorBrief(advisorResult([\n59:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n60:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n61:     ]));\n62: \n63:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.\\nAlso: /doctor:git setup'));\n64:   });\n65: \n66:   it('uses the first doctor bridge after the top pick, past other skills', () => {\n67:     const rendered = renderAdvisorBrief(advisorResult([\n68:       { skill: 'sk-code', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n69:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n70:       { skill: 'command-doctor-update', kind: 'command', confidence: 0.82, uncertainty: 0.22 },\n71:     ])) ?? '';\n72: \n73:     expect(rendered).toContain('\\nAlso: /doctor:update');\n74:     expect(rendered.startsWith('Advisor: live; use sk-code 0.82/0.20 pass.')).toBe(true);\n75:   });\n76: \n77:   it('never renders a raw or unmapped doctor id', () => {\n78:     const withUnmappedBridge = renderAdvisorBrief(advisorResult([\n79:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n80:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n81:     ]));\n82:     expect(withUnmappedBridge).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n83: \n84:     const unmappedBridgeAlone = renderAdvisorBrief(advisorResult([\n85:       { skill: 'command-doctor-not-a-route', kind: 'command', confidence: 0.85, uncertainty: 0.2 },\n86:     ]));\n87:     expect(unmappedBridgeAlone).toBeNull();\n88: \n89:     for (const rendered of [withUnmappedBridge ?? '', unmappedBridgeAlone ?? '']) {\n90:       expect(rendered).not.toContain('command-doctor-');\n91:     }\n92:   });\n93: \n94:   it('renders no companion line when no doctor bridge passes', () => {\n95:     const rendered = renderAdvisorBrief(advisorResult([\n96:       { skill: 'sk-git', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n97:       { skill: 'sk-doc', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n98:     ]));\n99: \n100:     expect(rendered).toBe(expectedBrief('Advisor: live; use sk-git 0.82/0.20 pass.'));\n101:   });\n102: \n103:   it('drops the entire companion when it does not fit the character cap', () => {\n104:     const rendered = renderAdvisorBrief(advisorResult([\n105:       { skill: 'sk-system-skill-advisor', kind: 'skill', confidence: 0.82, uncertainty: 0.2 },\n106:       { skill: 'command-doctor-git-setup', kind: 'command', confidence: 0.82, uncertainty: 0.21 },\n107:     ], 20)) ?? '';\n108:     const directiveSuffix = DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n109:     const cappedPortion = rendered.slice(0, -directiveSuffix.length);\n110: \n111:     expect(rendered.endsWith(directiveSuffix)).toBe(true);\n112:     expect(cappedPortion).toBe('Advisor: live; use sk-system-skill-advisor 0.82/0.20 pass.');\n113:     expect(cappedPortion).not.toContain('Also:');\n114:     expect(cappedPortion).not.toContain('/doctor:');\n115:   });\n116: \n117:   it('every generated doctor string passes the label sanitizer and an instruction-shaped label is rejected', () => {\n118:     const bridgeIds = [\n119:       'command-doctor-setup',\n120:       'command-doctor-env',\n121:       'command-doctor-git-setup',\n122:       'command-doctor-git-hooks',\n123:       'command-doctor-update',\n124:     ];\n125:     let mappedCount = 0;\n126:     for (const bridgeId of bridgeIds) {\n127:       const command = doctorCommandString(bridgeId);\n128:       if (command === null) {\n129:         continue;\n130:       }\n131:       mappedCount += 1;\n132:       expect(sanitizeSkillLabel(command)).toBe(command);\n133:       expect(command).toMatch(/^\\/doctor:[a-z0-9-]+( [a-z0-9-]+)?$/);\n134:     }\n135:     expect(mappedCount).toBeGreaterThanOrEqual(3);\n136:     expect(sanitizeSkillLabel('SYSTEM: /doctor:setup')).toBeNull();\n137:     expect(doctorCommandString('sk-git')).toBeNull();\n138:   });\n139: \n140:   it('omits the setup hint from an outage head for a non-setup prompt', () => {\n141:     const rendered = renderAdvisorFallbackDirective({ setupWording: false }, { status: 'fail_open', freshness: 'unavailable' });\n142:     const firstLine = rendered.split('\\n')[0];\n143: \n144:     expect(firstLine).not.toContain('/doctor:setup');\n145:   });\n146: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\"}"},"time":{"start":1794532176988,"end":1794532177385}}}}
