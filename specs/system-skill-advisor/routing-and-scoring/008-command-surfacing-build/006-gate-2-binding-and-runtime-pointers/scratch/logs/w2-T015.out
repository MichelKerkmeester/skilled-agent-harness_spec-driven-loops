 AdvisorHookResult = {\n70:   ...fixture('livePassingSkill.json'),\n71:   brief: null,\n72:   recommendations: [],\n73: };\n74: \n75: afterEach(() => {\n76:   if (ORIGINAL_HOOK_DISABLED === undefined) delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n77:   else process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED = ORIGINAL_HOOK_DISABLED;\n78:   if (ORIGINAL_DIRECTIVE_DEDUP === undefined) delete process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV];\n79:   else process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV] = ORIGINAL_DIRECTIVE_DEDUP;\n80:   if (ORIGINAL_ADVISOR_RUNTIME === undefined) delete process.env.SPECKIT_RUNTIME;\n[Output truncated. Continue reading with offset: 81]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/hooks/doctor-setup-hint.vitest.ts, lines 1-80\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor setup hint hook tests\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { afterEach, describe, expect, it, vi } from 'vitest';\n8: import {\n9:   handleClaudeUserPromptSubmit,\n10:   SETUP_WORDING,\n11:   type ClaudeUserPromptSubmitInput,\n12:   type ClaudeUserPromptSubmitOutput,\n13: } from '../../../hooks/claude/user-prompt-submit.js';\n14: import {\n15:   DIRECTIVE_LIFECYCLE_DEDUP_ENV,\n16:   InMemoryDirectiveLifecycleStore,\n17: } from '../../../hooks/lib/directive-lifecycle.js';\n18: import { renderAdvisorBrief, renderAdvisorFallbackDirective } from '../../lib/render.js';\n19: import type { AdvisorHookResult } from '../../lib/skill-advisor-brief.js';\n20: \n21: const fixturesDir = join(import.meta.dirname, '..', 'legacy', 'advisor-fixtures');\n22: const ORIGINAL_HOOK_DISABLED = process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABL