{"type":"tool_use","timestamp":1794532177381,"sessionID":"ses_e2d8e593affeqxRun8M4iooLPr","part":{"partID":"prt_1d273f2a2001al6bAJTf9ZHgE2","sessionID":"ses_e2d8e593affeqxRun8M4iooLPr","messageID":"msg_1d273d3550017dmdkB72878Nje","type":"tool","id":"call_fdcb7965807c46d99ecc5e3a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-267\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // BEGIN GENERATED COMMAND ROWS\n56: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n57:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n58:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n59:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n60:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n61:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n62:   'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n63:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n64:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n65:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n66:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n67:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n68:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n69:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n70:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n71:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n72:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n73:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n74:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n75:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n76:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n78:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n79:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n80:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n81:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n83:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n84:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n85:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n86:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n87:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n88:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n89:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n90:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n91:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n92:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n93:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n94:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n95:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n96:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n97:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n98:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n99:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n100:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n101:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n102:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n103:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n104:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n105:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n106:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n107:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n108:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n109:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n110:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n111:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n112: };\n113: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n114:   '/create:agent': 'start',\n115:   '/create:changelog': 'ask',\n116:   '/create:feature-catalog': 'start',\n117:   '/create:manual-testing-playbook': 'start',\n118:   '/create:readme': 'start',\n119:   '/create:skill': 'start',\n120:   '/deep:research': 'ask',\n121:   '/deep:review': 'ask',\n122:   '/doctor:agents-md check': 'run',\n123:   '/doctor:agents-md embed': 'ask',\n124:   '/doctor:agents-md restore': 'ask',\n125:   '/doctor:ci report': 'run',\n126:   '/doctor:ci scaffold': 'ask',\n127:   '/doctor:ci toggle': 'ask',\n128:   '/doctor:deep-loop': 'run',\n129:   '/doctor:env list': 'run',\n130:   '/doctor:git hooks': 'ask',\n131:   '/doctor:git setup': 'run',\n132:   '/doctor:git standards': 'ask',\n133:   '/doctor:helper': 'run',\n134:   '/doctor:install': 'run',\n135:   '/doctor:mcp debug': 'ask',\n136:   '/doctor:mcp install': 'ask',\n137:   '/doctor:overlay apply': 'ask',\n138:   '/doctor:overlay repin': 'ask',\n139:   '/doctor:overlay status': 'run',\n140:   '/doctor:runtime-mirrors': 'run',\n141:   '/doctor:setup': 'run',\n142:   '/doctor:sk-code quality': 'ask',\n143:   '/doctor:sk-code setup': 'run',\n144:   '/doctor:sk-skill check': 'run',\n145:   '/doctor:sk-skill convert': 'ask',\n146:   '/doctor:skill-advisor parent-skill': 'run',\n147:   '/doctor:skill-advisor rebuild': 'ask',\n148:   '/doctor:skill-advisor router-reach': 'run',\n149:   '/doctor:skill-advisor skill-budget': 'run',\n150:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n151:   '/doctor:skill-advisor tune': 'ask',\n152:   '/doctor:speckit': 'run',\n153:   '/doctor:symlink check': 'run',\n154:   '/doctor:symlink link': 'ask',\n155:   '/doctor:symlink unlink': 'ask',\n156:   '/doctor:update': 'ask',\n157:   '/prompt:improve': 'start',\n158:   '/speckit:complete': 'start',\n159:   '/speckit:handoff': 'ask',\n160:   '/speckit:implement': 'start',\n161:   '/speckit:plan': 'start',\n162:   '/speckit:resume': 'start',\n163:   '/speckit:save': 'start',\n164:   '/speckit:search': 'run',\n165: };\n166: // END GENERATED COMMAND ROWS\n167: \n168: // The row for an id a recommendation carries, or undefined when that id names no\n169: // command. Own-key lookup because the table is generated data, so an inherited\n170: // name such as `constructor` must not resolve to a row nobody declared.\n171: export function commandRowFor(id: string): CommandRow | undefined {\n172:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n173: }\n174: \n175: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n176: // that merely mentions the topic spends the reader's budget on work they never\n177: // asked for. The list below is the vocabulary that counts as asking for it, and\n178: // it holds only effort wording: a bare topic word such as `research`, `review`\n179: // or `council` says what to look at, never how far to go, so it never qualifies\n180: // on its own.\n181: //\n182: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n183: // has to judge stays visible and cheap to correct.\n184: export const DEPTH_WORDING: readonly string[] = [\n185:   'in depth',\n186:   'deep dive',\n187:   'deep research',\n188:   'deep review',\n189:   'thorough',\n190:   'thoroughly',\n191:   'exhaustive',\n192:   'iteratively',\n193:   'multiple passes',\n194:   'many passes',\n195:   'several passes',\n196:   'ask the council',\n197:   'convene',\n198:   'several models',\n199:   'final verdict',\n200:   'everything you can',\n201: ];\n202: \n203: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n204: // escaped before it is trusted as a pattern.\n205: function escapePhrase(phrase: string): string {\n206:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n207: }\n208: \n209: // One alternation over the list keeps the gate a single test per prompt, and the\n210: // boundary markers keep `thorough` from firing inside a longer word while a\n211: // multi-word phrase still has to match as a whole.\n212: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n213: \n214: // A compiled route arrives as unvalidated JSON from a separate process, so the\n215: // shape is narrowed here rather than trusted. Arrays count as objects in\n216: // JavaScript and would let `action` read off an unrelated field, so they are\n217: // excluded explicitly.\n218: function asRecord(value: unknown): Record<string, unknown> | undefined {\n219:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n220:   return value as Record<string, unknown>;\n221: }\n222: \n223: // The command for a hub's recommendation, or undefined when the route does not\n224: // single out one mode. Only a single-mode route names a command unambiguously:\n225: // a bundle or a multi-target route has more than one answer, and asking the\n226: // reader to pick belongs to the recommend path, not here. Never throws, because\n227: // a missing command must degrade to \"no command offered\" rather than break\n228: // routing. The prompt decides whether a costly deep-loop command is offered at\n229: // all: a reader who only asks about the topic gets no command, rather than one\n230: // that would launch work they never requested.\n231: export function attachCommand(\n232:   skillId: string,\n233:   compiledRoute: unknown,\n234:   prompt: string,\n235:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n236: ): string | undefined {\n237:   const route = asRecord(compiledRoute);\n238:   if (!route) return undefined;\n239:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n240: \n241:   const targets = route.targets;\n242:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n243: \n244:   const onlyTarget = asRecord(targets[0]);\n245:   if (!onlyTarget) return undefined;\n246: \n247:   const workflowMode = onlyTarget.workflowMode;\n248:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n249: \n250:   // Own-key lookup on both levels: the table is data read from a generated\n251:   // object, so an inherited name such as `constructor` must not resolve to a\n252:   // command the hub never declared.\n253:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n254:   const commands = modeCommands[skillId];\n255:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n256: \n257:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n258:   // run, so they are offered only when the prompt asks for that effort. Typing\n259:   // the slash command is itself the ask, and every other hub answers a short\n260:   // question with a short answer, so no other skill consults the wording list.\n261:   if (skillId === 'system-deep-loop') {\n262:     const lowered = prompt.toLowerCase();\n263:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n264:   }\n265: \n266:   return commands[workflowMode];\n267: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-267\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // BEGIN GENERATED COMMAND ROWS\n56: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n57:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n58:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n59:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n60:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n61:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n62:   'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n63:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n64:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n65:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n66:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n67:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n68:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n69:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n70:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n71:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n72:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n73:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n74:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n75:   'command-doctor-git-standards': { comma