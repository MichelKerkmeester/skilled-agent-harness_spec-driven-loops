and renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   const row = commandRowFor(recommendation.skill);\n225:   const command = recommendation.command ?? row?.command;\n226:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n227:   const policy = recommendation.policy ?? row?.policy;\n228:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n229:   const ownerPart = sanitizeSkillLabel(owner);\n230:   if (!commandPart || !ownerPart) {\n231:     return null;\n232:   }\n233:   const policyPart = policyWord(policy, row?.mutating, childSession);\n234:   return policyPart === null\n235:     ? `${ownerPart} → ${commandPart}`\n236:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n237: }\n238: \n239: // A doctor bridge renders as its runnable command and never as its raw id; an\n240: // unmapped doctor id renders nothing.\n241: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n242:   return commandLabel(recommendation, childSession)\n243:     ?? (isDoctorBridgeId(recommendation.skill)\n244:       ? doctorCommandString(recommendation.skill)\n245:       : sanitizeSkillLabel(recommendation.skill));\n246: }\n247: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n255:   const row = commandRowFor(skillId);\n256:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n257:     ? `${command} (${PARENT_NAMED_POLICY})`\n258:     : command;\n259: }\n260: \n261: function formatScore(value: number): string {\n262:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n263: }\n264: \n[Output truncated. Continue reading with offset: 265]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 185-264\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   const row = commandRowFor(recommendation.skill);\n225:   const command = recommendation.command ?? row?.command;\n226:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n227:   const policy = recommendation.policy ?? row?.policy;\n228:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n229:   const ownerPart = sanitizeSkillLabel(owner);\n230:   if (!commandPart || !ownerPart) {\n231:     return null;\n232:   }\n233:   const policyPart = policyWord(policy, row?.mutating, childSession);\n234:   return policyPart === null\n235:     ? `${ownerPart} → ${commandPart}`\n236:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n237: }\n238: \n239: // A doctor bridge renders as its runnable command and never as its raw id; an\n240: // unmapped doctor id renders nothing.\n241: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n242:   return commandLabel(recommendation, childSession)\n243:     ?? (isDoctorBridgeId(recommendation.skill)\n244:       ? doctorCommandString(recommendation.skill)\n245:       : sanitizeSkillLabel(recommendation.skill));\n246: }\n247: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n255:   const row = comman