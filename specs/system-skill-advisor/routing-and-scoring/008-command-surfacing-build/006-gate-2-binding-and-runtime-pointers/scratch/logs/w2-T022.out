hSection {\n468:   const lastInvocations = records.slice(-MAX_HEALTH_RECORDS);\n469:   const cacheHits = lastInvocations.filter((record) => record.cacheHit).length;\n470:   const failOpen = lastInvocations.filter((record) => record.status === 'fail_open').length;\n471:   return {\n472:     key: 'advisor-hook-health',\n473:     lastInvocations,\n474:     rollingCacheHitRate: lastInvocations.length > 0 ? cacheHits / lastInvocations.length : 0,\n475:     rollingP95Ms: percentile(\n476:       lastInvocations.filter((record) => record.cacheHit).map((record) => record.durationMs),\n477:       95,\n478:     ),\n479:     rollingFailOpenRate: lastInvocations.length > 0 ? failOpen / lastInvocations.length : 0,\n480:   };\n481: }\n482: \n483: export function readAdvisorHookHealthSection(workspaceRoot: string): AdvisorHookHealthSection {\n484:   return buildAdvisorHookHealthSection(readAdvisorHookDiagnosticRecords(workspaceRoot));\n485: }\n486: \n487: export function advisorHookDiagnosticsPath(workspaceRoot: string): string {\n488:   return durableMetricsPath(workspaceRoot, 'diagnostics');\n489: }\n490: \n491: // Persists only sanitized skill labels + the accept/correct/ignore signal,\n492: // never the prompt or scenario — deliberate prompt-safety. Real misroutes\n493: // therefore cannot be reconstructed into gold cases from this telemetry; that\n494: // is an accepted capability tradeoff, not an omission to fix by capturing\n495: // prompts (which would breach the prompt-safety invariant).\n496: export function createAdvisorHookOutcomeRecord(input: {\n497:   readonly runtime: AdvisorRuntime;\n498:   readonly outcome: AdvisorOutcome;\n499:   readonly skillLabel: string;\n500:   readonly correctedSkillLabel?: string | null;\n501:   readonly timestamp?: string;\n502: }): AdvisorHookOutcomeRecord {\n503:   return {\n504:     timestamp: input.timestamp ?? new Date().toISOString(),\n505:     runtime: input.runtime,\n506:     outcome: input.outcome,\n507:     skillLabel: sanitizeSkillLabel(input.skillLabel) ?? 'unknown-skill',\n508:     ...(sanitizeSkillLabel(input.correctedSkillLabel) ? { correctedSkillLabel: sanitizeSkillLabel(input.correctedSkillLabel) } : {}),\n509:   };\n510: }\n511: \n512: export function validateAdvisorHookOutcomeRecord(value: unknown): value is AdvisorHookOutcomeRecord {\n513:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n514:     return false;\n515:   }\n516:   const record = value as Record<string, unknown>;\n517:   return typeof record.timestamp === 'string'\n518:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n519:     && (record.outcome === 'accepted' || record.outcome === 'corrected' || record.outcome === 'ignored')\n520:     && typeof record.skillLabel === 'string'\n521:     && (record.correctedSkillLabel === undefined || typeof record.correctedSkillLabel === 'string');\n522: }\n523: \n524: export async function persistAdvisorHookOutcomeRecord(\n525:   workspaceRoot: string,\n526:   record: AdvisorHookOutcomeRecord,\n527: ): Promise<string> {\n528:   const path = durableMetricsPath(workspaceRoot, 'outcomes');\n529:   await writeBoundedJsonl(path, JSON.stringify(record), MAX_DURABLE_OUTCOME_RECORDS, { requireDebug: false });\n530:   return path;\n531: }\n532: \n533: export function readAdvisorHookOutcomeRecords(\n534:   workspaceRoot: string,\n535:   limit = MAX_DURABLE_OUTCOME_RECORDS,\n536: ): AdvisorHookOutcomeRecord[] {\n537:   return readJsonlLines(durableMetricsPath(workspaceRoot, 'outcomes'))\n538:     .slice(-limit)\n539:     .map((line) => tryParseJsonLine(line))\n540:     .filter(validateAdvisorHookOutcomeRecord);\n541: }\n542: \n543: export function summarizeAdvisorHookOutcomeRecords(\n544:   workspaceRoot: string,\n545: ): AdvisorHookOutcomeSummary {\n546:   const records = readAdvisorHookOutcomeRecords(workspaceRoot);\n547:   const totals = {\n548:     accepted: records.filter((record) => record.outcome === 'accepted').length,\n549:     corrected: records.filter((record) => record.outcome === 'corrected').length,\n550:     ignored: records.filter((record) => record.outcome === 'ignored').length,\n551:   };\n552:   return { records, totals };\n553: }\n554: \n555: export function advisorHookOutcomesPath(workspaceRoot: string): string {\n556:   return durableMetricsPath(workspaceRoot, 'outcomes');\n557: }\n558: \n559: // Mirrors createAdvisorHookOutcomeRecord but for execution success, not\n560: // recommendation acceptance. Persistence lives in the skill-outcome store, not\n561: // here, so the acceptance write-path (debug-gated, bounded) is left untouched.\n562: export function createSkillExecutionOutcomeRecord(input: {\n563:   readonly runtime: AdvisorRuntime;\n564:   readonly skillId: string;\n565:   readonly success: boolean;\n566:   readonly eventId: string;\n567:   readonly failureMode?: string | null;\n568:   readonly contextTags?: readonly string[] | null;\n569:   readonly timestamp?: string;\n570: }): SkillExecutionOutcomeRecord {\n571:   const timestamp = input.timestamp ?? new Date().toISOString();\n572:   const skillId = sanitizeSkillLabel(input.skillId) ?? 'unknown-skill';\n573:   const eventId = sanitizeSkillLabel(input.eventId) ?? `${skillId}:${timestamp}`;\n574:   const failureMode = sanitizeSkillLabel(input.failureMode);\n575:   const contextTags = sanitizeContextTags(input.contextTags);\n576:   return {\n577:     timestamp,\n578:     runtime: input.runtime,\n579:     skillId,\n580:     success: input.success === true,\n581:     eventId,\n582:     ...(failureMode ? { failureMode } : {}),\n583:     ...(contextTags.length > 0 ? { contextTags } : {}),\n584:   };\n585: }\n586: \n587: export function validateSkillExecutionOutcomeRecord(value: unknown): value is SkillExecutionOutcomeRecord {\n588:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n589:     return false;\n590:   }\n591:   const record = value as Record<string, unknown>;\n592:   return typeof record.timestamp === 'string'\n593:     && enumIncludes(ADVISOR_RUNTIME_VALUES, record.runtime)\n594:     && typeof record.skillId === 'string'\n595:     && typeof record.success === 'boolean'\n596:     && typeof record.eventId === 'string'\n597:     && (record.failureMode === undefined || typeof record.failureMode === 'string')\n598:     && (record.contextTags === undefined\n599:       || (Array.isArray(record.contextTags) && record.contextTags.every((tag) => typeof tag === 'string')));\n600: }\n601: \n602: /** Small in-memory collector for advisor hook metrics and health snapshots. */\n603: export class AdvisorHookMetricsCollector {\n604:   private readonly records: AdvisorHookDiagnosticRecord[] = [];\n605: \n606:   record(record: AdvisorHookDiagnosticRecord): void {\n607:     if (!validateAdvisorHookDiagnosticRecord(record)) {\n608:       throw new Error(\n609:         `AdvisorHookDiagnosticRecord: expected prompt-free closed-schema diagnostic record; actual ${typeof record}.`,\n610:       );\n611:     }\n612:     this.records.push(record);\n613:   }\n614: \n615:   snapshot(): AdvisorHookMetricSnapshot {\n616:     return {\n617:       definitions: ADVISOR_HOOK_METRIC_DEFINITIONS,\n618:       records: [...this.records],\n619:     };\n620:   }\n621: \n622:   healthSection(): AdvisorHookHealthSection {\n623:     return buildAdvisorHookHealthSection(this.records);\n624:   }\n625: \n626:   reset(): void {\n627:     this.records.length = 0;\n628:   }\n629: }\n[Output truncated. Continue reading with offset: 630]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\",\"offset\":330,\"limit\":300}"},"time":{"start":1794532188130,"end":1794532188749}}}}
