 status: AdvisorHookStatus;\n54:   readonly freshness: AdvisorHookFreshness;\n55:   readonly durationMs: number;\n56:   readonly cacheHit: boolean;\n57:   readonly errorCode?: AdvisorErrorCode;\n58:   readonly errorDetails?: string;\n59:   readonly skillLabel?: string;\n60:   readonly generation?: number;\n61:   readonly emittedBytes?: number;\n62:   readonly directivesSuppressed?: boolean;\n63: }\n64: \n65: export interface AdvisorHookHealthSection {\n66:   readonly key: 'advisor-hook-health';\n67:   readonly lastInvocations: readonly AdvisorHookDiagnosticRecord[];\n68:   readonly rollingCacheHitRate: number;\n69:   readonly rollingP95Ms: number;\n70:   readonly rollingFailOpenRate: number;\n71: }\n72: \n73: export interface AdvisorHookAlertThresholds {\n74:   readonly failOpenWarnRate: number;\n75:   readonly failOpenPageRate: number;\n76:   readonly cacheHitP95WarnMs: number;\n77:   readonly cacheHitP95PageMs: number;\n78: }\n79: \n80: export interface AdvisorHookMetricSnapshot {\n81:   readonly definitions: readonly AdvisorMetricDefinition[];\n82:   readonly records: readonly AdvisorHookDiagnosticRecord[];\n83: }\n84: \n85: export interface AdvisorHookOutcomeRecord {\n86:   readonly timestamp: string;\n87:   readonly runtime: AdvisorRuntime;\n88:   readonly outcome: AdvisorOutcome;\n89:   readonly skillLabel: string;\n90:   readonly correctedSkillLabel?: string;\n91: }\n92: \n93: export interface AdvisorHookOutcomeSummary {\n94:   readonly records: readonly AdvisorHookOutcomeRecord[];\n95:   readonly totals: {\n96:     readonly accepted: number;\n97:     readonly corrected: number;\n98:     readonly ignored: number;\n99:   };\n100: }\n101: \n102: // Execution-success outcome — a different signal from AdvisorHookOutcomeRecord\n103: // above. That record captures whether a *recommendation* was accepted\n104: // (accepted/corrected/ignored); this one captures whether the recommended\n105: // skill's TASK actually succeeded or failed. Accepting a recommendation says