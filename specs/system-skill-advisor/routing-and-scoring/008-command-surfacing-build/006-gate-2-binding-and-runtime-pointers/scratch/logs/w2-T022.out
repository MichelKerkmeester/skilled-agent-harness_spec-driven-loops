without leaking it',\n33:   'write a validation test because my password is hunter2',\n34: ] as const;\n35: \n36: function freshness(): AdvisorFreshnessResult {\n37:   return {\n38:     state: 'live',\n39:     generation: 7,\n40:     sourceSignature: 'privacy-source-signature',\n[Output truncated. Continue reading with offset: 41]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-privacy.vitest.ts, lines 1-40\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Privacy Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it, vi, beforeEach } from 'vitest';\n6: import { createAdvisorPromptCacheKey } from '../../lib/prompt-cache.js';\n7: import {\n8:   buildSkillAdvisorBrief,\n9:   clearAdvisorBriefCacheForTests,\n10: } from '../../lib/skill-advisor-brief.js';\n11: import type { AdvisorFreshnessResult } from '../../lib/freshness.js';\n12: import { getAdvisorFreshness } from '../../lib/freshness.js';\n13: import { runAdvisorSubprocess } from '../../lib/subprocess.js';\n14: import { renderAdvisorBrief } from '../../lib/render.js';\n15: import {\n16:   buildAdvisorHookHealthSection,\n17:   createAdvisorHookDiagnosticRecord,\n18:   getAdvisorHookMetricDefinitions,\n19:   serializeAdvisorHookDiagnosticRecord,\n20: } from '../../lib/metrics.js';\n21: \n22: vi.mock('../../lib/freshness.js', () => ({\n23:   getAdvisorFreshness: vi.fn(),\n24: }));\n25: \n26: vi.mock('../../lib/subprocess.js', () => ({\n27:   runAdvisorSubprocess: vi.fn(),\n28: }));\n29: \n30: const workspaceRoot = '/tmp/advisor-privacy';\n31: const sensitivePrompts = [\n32:   'implement config handling for api_key=SECRET_ABC123 without leaking it',\n33:   'write a validation test because my password is hunter2',\n34: ] as c