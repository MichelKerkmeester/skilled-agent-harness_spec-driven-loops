TER_CORRUPT',\n33:   'PYTHON_MISSING',\n34:   'NONZERO_EXIT',\n35:   'SQLITE_BUSY_EXHAUSTED',\n36:   'DELETED_SKILL',\n37:   'UNKNOWN',\n38: ] as const;\n39: \n40: export type AdvisorErrorCode = (typeof ADVISOR_ERROR_CODE_VALUES)[number];\n41: export type AdvisorMetricType = 'counter' | 'histogram' | 'gauge';\n42: export type AdvisorOutcome = 'accepted' | 'corrected' | 'ignored';\n43: \n44: export interface AdvisorMetricDefinition {\n45:   readonly name: string;\n46:   readonly type: AdvisorMetricType;\n47:   readonly labels: readonly string[];\n48: }\n49: \n50: export interface AdvisorHookDiagnosticRecord {\n51:   readonly timestamp: string;\n52:   readonly runtime: AdvisorRuntime;\n53:   readonly status: AdvisorHookStatus;\n54:   readonly freshness: AdvisorHookFreshness;\n55:   readonly durationMs: number;\n56:   readonly cacheHit: boolean;\n57:   readonly errorCode?: AdvisorErrorCode;\n58:   readonly errorDetails?: string;\n59:   readonly skillLabel?: string;\n60:   readonly generation?: number;\n61:   readonly emittedBytes?: number;\n62:   readonly directivesSuppressed?: boolean;\n63: }\n64: \n65: export interface AdvisorHookHealthSection {\n66:   readonly key: 'advisor-hook-health';\n67:   readonly lastInvocations: readonly AdvisorHookDiagnosticRecord[];\n68:   readonly rollingCacheHitRate: number;\n69:   readonly rollingP95Ms: number;\n70:   readonly rollingFailOpenRate: number;\n71: }\n72: \n73: export interface AdvisorHookAlertThresholds {\n74:   readonly failOpenWarnRate: number;\n75:   readonly failOpenPageRate: number;\n76:   readonly cacheHitP95WarnMs: number;\n77:   readonly cacheHitP95PageMs: number;\n78: }\n79: \n80: export interface AdvisorHookMetricSnapshot {\n81:   readonly definitions: readonly AdvisorMetricDefinition[];\n82:   readonly records: readonly AdvisorHookDiagnosticRecord[];\n83: }\n84: \n85: export interface AdvisorHookOutcomeRecord {\n86:   readonly timestamp: string;\n87:   readonly runtime: AdvisorRuntime;\n88:   readonly outcome: AdvisorOutcome;\n89:   readonly skillLabel: string;\n90:   readonly correctedSkillLabel?: string;\n91: }\n92: \n93: export interface AdvisorHookOutcomeSummary {\n94:   readonly records: readonly AdvisorHookOutcomeRecord[];\n95:   readonly totals: {\n96:     readonly accepted: number;\n97:     readonly corrected: number;\n98:     readonly ignored: number;\n99:   };\n100: }\n101: \n102: // Execution-success outcome — a different signal from AdvisorHookOutcomeRecord\n103: // above. That record captures whether a *recommendation* was accepted\n104: // (accepted/corrected/ignored); this one captures whether the recommended\n105: // skill's TASK actually succeeded or failed. Accepting a recommendation says\n106: // nothing about whether the skill then completed the task, so a\n107: // reliability-over-execution ranking needs this distinct signal. Kept\n108: // prompt-free for the same prompt-safety reason the acceptance record is: only\n109: // a sanitized skill id, a boolean outcome, an idempotency key, and optional\n110: // bounded context tags the caller has already deemed safe to persist.\n111: export interface SkillExecutionOutcomeRecord {\n112:   readonly timestamp: string;\n113:   readonly runtime: AdvisorRuntime;\n114:   readonly skillId: string;\n115:   readonly success: boolean;\n116:   // Idempotency key: a replayed or double-delivered event carrying the same id\n117:   // folds to the same counts (no double-count).\n118:   readonly eventId: string;\n119:   // Optional failure-mode tag for query-scored recall (\"how this skill tends\n120:   // to fail on inputs like yours\"). Advisory only — never a hard demotion.\n[Output truncated. Continue reading with offset: 121]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts, lines 1-120\n1: // ─────────────────────────────────────────────