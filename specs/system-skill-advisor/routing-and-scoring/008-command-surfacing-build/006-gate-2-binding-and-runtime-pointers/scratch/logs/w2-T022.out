────────\n\nimport path from 'node:path';\n\nconst TEST_TIMEOUT_MS = 30_000;\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n// The stress suites are excluded from the default run because they are slow, not\n// because they are unwanted. Without a way to opt in they were unreachable: no\n// script and no pattern selected them, so 21 files sat in the tree running never.\n// Opting in REPLACES the default set rather than adding to it: these suites churn\n// the daemon, its socket and its lease, and running them beside the ordinary\n// suites fails a handful of those on shared state rather than on their own logic.\nconst INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n\n// A plain object export instead of vitest's defineConfig wrapper: the config is\n// loaded by node's own module graph, where a bare `vitest` import resolves to\n// whatever node_modules sits next to this file. CI's routing job runs the suites\n// under a vitest pinned through npx, which can differ from the runtime's own\n// vitest range, so importing from the package here could load a second vitest\n// copy. defineConfig is an identity type-helper; dropping it changes nothing at\n// runtime.\nexport default ({\n  root: import.meta.dirname,\n  test: {\n    include: [\n      ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n      ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n    ],\n    exclude: [\n      'node_modules',\n      'dist',\n      ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n    ],\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n    },\n  },\n});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"name\": \"@spec-kit/system-skill-advisor\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"main\": \"./dist/runtime/advisor-server.js\",\n  \"engines\": {\n    \"node\": \"^22.23.4 || ^24.22.1 || >=26.12.1\"\n  },\n  \"scripts\": {\n    \"clean\": \"rm -rf dist\",\n    \"prebuild\": \"node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs prepare-build --package system-skill-advisor/runtime --entry default && node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs prepare-build --package system-skill-advisor/runtime --entry skill-advisor-cli\",\n    \"build\": \"npm --prefix ../../system-spec-kit/shared run build && ../../system-spec-kit/node_modules/.bin/tsc -p tsconfig.build.json\",\n    \"postbuild\": \"mkdir -p dist/runtime/data && cp data/*.json dist/runtime/data/ && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry default || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'default'});if(r.status!=='cached')throw new Error(r.message)\\\") && (node ../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs record-build --package system-skill-advisor/runtime --entry skill-advisor-cli || node -e \\\"const r=require('../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs').writePackageSourceHashCache('system-skill-advisor/runtime',{entry:'skill-advisor-cli'});if(r.status!=='cached')throw new Error(r.message)\\\")\",\n    \"typecheck\": \"../../system-spec-kit/node_modules/.bin/tsc --noEmit --composite false -p tsconfig.build.json\",\n    \"test\": \"vitest run\",\n    \"test:stress\": \"SPECKIT_RUN_STRESS=true vitest run\"\n  },\n  \"dependencies\": {\n    \"@huggingface/transformers\": \"^3.8.1\",\n    \"@spec-kit/shared\": \"file:../../system-spec-kit/shared\",\n    \"better-sqlite3\": \"^12.11.1\",\n    \"chokidar\": \"^4.0.3\",\n    \"zod\": \"^4.6.7\"\n  },\n  \"overrides\": {\n    \"@hono/node-server\": \"^2.0.5\",\n    \"fast-uri\": \"^3.1.5\",\n    \"hono\": \"^4.12.34\",\n    \"ip-address\": \"^10.3.1\",\n    \"nanoid\": \"3.3.20\",\n    \"postcss\": \"^8.5.23\",\n    \"vite\": \"^8.1.2\",\n    \"protobufjs\": \"^7.6.4\",\n    \"tar\": \"^7.5.19\",\n    \"sharp\": \"^0.35.4\"\n  },\n  \"devDependencies\": {\n    \"vitest\": \"^4.1.12\"\n  }\n}\n---\n{\n  \"extends\": \"../../system-spec-kit/runtime/tsconfig.json\",\n  \"compilerOptions\": {\n    \"ignoreDeprecations\": \"5.0\",\n    \"outDir\": \"./dist\",\n    \"baseUrl\": \".\",\n    \"typeRoots\": [\n      \"../../system-spec-kit/node_modules/@types\",\n      \"../../system-spec-kit/runtime/node_modules/@types\"\n    ],\n    \"paths\": {\n      \"better-sqlite3\": [\"./types/better-sqlite3.d.ts\"],\n      \"chokidar\": [\"../../system-spec-kit/runtime/node_modules/chokidar/index.d.ts\"],\n      \"vitest/config\": [\"../../system-spec-kit/runtime/node_modules/vitest/config.d.ts\"]\n    }\n  },\n  \"include\": [\"**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\", \"bench\", \"**/__tests__\"]\n}\n---\n// ───────────────────────────────────────────────────────────────\n// MODULE: System Skill Advisor Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nconst TEST_TIMEOUT_MS = 30_000;\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n// The stress suites are excluded from the default run because they are slow, not\n// because they are unwanted. Without a way to opt in they were unreachable: no\n// script and no pattern selected them, so 21 files sat in the tree running never.\n// Opting in REPLACES the default set rather than adding to it: these suites churn\n// the daemon, its socket and its lease, and running them beside the ordinary\n// suites fails a handful of those on shared state rather than on their own logic.\nconst INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n\n// A plain object export instead of vitest's defineConfig wrapper: the config is\n// loaded by node's own module graph, where a bare `vitest` import resolves to\n// whatever node_modules sits next to this file. CI's routing job runs the suites\n// under a vitest pinned through npx, which can differ from the runtime's own\n// vitest range, so importing from the package here could load a second vitest\n// copy. defineConfig is an identity type-helper; dropping it changes nothing at\n// runtime.\nexport default ({\n  root: import.meta.dirname,\n  test: {\n    include: [\n      ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n      ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n    ],\n    exclude: [\n      'node_modules',\n      'dist',\n      ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n    ],\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n    },\n  },\n});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cat .skilled/skills/system-skill-advisor/runtime/package.json; echo ---; cat .skilled/skills/system-skill-advisor/runtime/tsconfig.json 2>/dev/null | head -40; echo ---; cat .skilled/skills/system-skill-advisor/runtime/vitest.config.ts 2>/dev/null\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794532213669,"end":1794532214484}}}}
