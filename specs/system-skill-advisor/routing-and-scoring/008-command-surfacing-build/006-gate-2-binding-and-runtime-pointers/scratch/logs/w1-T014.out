{"type":"tool_use","timestamp":1794531735126,"sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","part":{"partID":"prt_1d26d3443001zVlHjyQ5JlhQqm","sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","messageID":"msg_1d26d1aec001H6T75E0Qpnd5sj","type":"tool","id":"chatcmpl-tool-95de597ea41df0ec","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts, lines 1-169\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Brief Golden Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: import { renderAdvisorBrief } from '../lib/render.js';\n7: \n8: const DIRECTIVES_LABEL = '\\nDirectives:';\n9: // The advisor portion is capped at 80 tokens and the renderer estimates four\n10: // characters per token, so a longer head has already lost the command it offered.\n11: const HEAD_CHARACTER_CAP = 320;\n12: \n13: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n14: \n15: interface RecommendationInput {\n16:   readonly skill: string;\n17:   readonly kind?: 'skill' | 'command';\n18:   readonly command?: string;\n19:   readonly policy?: 'run' | 'start' | 'ask';\n20:   readonly ownerSkillId?: string;\n21:   readonly confidence: number;\n22:   readonly uncertainty: number;\n23: }\n24: \n25: interface HeadCase {\n26:   readonly name: string;\n27:   readonly recommendation: RecommendationInput;\n28:   readonly expectedHead: string;\n29: }\n30: \n31: const HEAD_CASES: readonly HeadCase[] = [\n32:   {\n33:     name: 'a documentation request names the owning skill, the command and its policy',\n34:     recommendation: {\n35:       skill: 'sk-doc',\n36:       kind: 'command',\n37:       command: '/create:readme',\n38:       policy: 'start',\n39:       ownerSkillId: 'sk-doc',\n40:       confidence: 0.95,\n41:       uncertainty: 0.12,\n42:     },\n43:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n44:   },\n45:   {\n46:     name: 'a research hub names the deep workflow it would start',\n47:     recommendation: {\n48:       skill: 'system-deep-loop',\n49:       kind: 'command',\n50:       command: '/deep:research',\n51:       policy: 'ask',\n52:       ownerSkillId: 'system-deep-loop',\n53:       confidence: 0.82,\n54:       uncertainty: 0.16,\n55:     },\n56:     expectedHead: 'Advisor: live; use system-deep-loop → /deep:research (ask) 0.82/0.16 pass.',\n57:   },\n58:   {\n59:     name: 'a design request names the chart mode',\n60:     recommendation: {\n61:       skill: 'sk-design',\n62:       kind: 'command',\n63:       command: '/design:chart',\n64:       policy: 'start',\n65:       ownerSkillId: 'sk-design',\n66:       confidence: 0.9,\n67:       uncertainty: 0.12,\n68:     },\n69:     expectedHead: 'Advisor: live; use sk-design → /design:chart (start) 0.90/0.12 pass.',\n70:   },\n71:   {\n72:     name: 'a doctor bridge names the owning skill and the runnable subcommand',\n73:     recommendation: {\n74:       skill: 'command-doctor-git-hooks',\n75:       kind: 'command',\n76:       command: '/doctor:git hooks',\n77:       policy: 'ask',\n78:       ownerSkillId: 'sk-git',\n79:       confidence: 0.82,\n80:       uncertainty: 0.12,\n81:     },\n82:     expectedHead: 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.',\n83:   },\n84:   {\n85:     name: 'a memory save names the spec workflow',\n86:     recommendation: {\n87:       skill: 'system-spec-kit',\n88:       kind: 'command',\n89:       command: '/speckit:save',\n90:       policy: 'start',\n91:       ownerSkillId: 'system-spec-kit',\n92:       confidence: 0.89,\n93:       uncertainty: 0.12,\n94:     },\n95:     expectedHead: 'Advisor: live; use system-spec-kit → /speckit:save (start) 0.89/0.12 pass.',\n96:   },\n97:   {\n98:     name: 'a prompt rewrite names the prompt skill',\n99:     recommendation: {\n100:       skill: 'sk-prompt',\n101:       kind: 'command',\n102:       command: '/prompt:improve',\n103:       policy: 'start',\n104:       ownerSkillId: 'sk-prompt',\n105:       confidence: 0.89,\n106:       uncertainty: 0.12,\n107:     },\n108:     expectedHead: 'Advisor: live; use sk-prompt → /prompt:improve (start) 0.89/0.12 pass.',\n109:   },\n110:   {\n111:     name: 'a row id with no fields is filled from the generated command table',\n112:     recommendation: {\n113:       skill: 'command-create-readme',\n114:       kind: 'command',\n115:       confidence: 0.91,\n116:       uncertainty: 0.11,\n117:     },\n118:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.91/0.11 pass.',\n119:   },\n120:   {\n121:     name: 'an id with no row keeps the plain skill head',\n122:     recommendation: {\n123:       skill: 'sk-review',\n124:       confidence: 0.61,\n125:       uncertainty: 0.28,\n126:     },\n127:     expectedHead: 'Advisor: live; use sk-review 0.61/0.28 pass.',\n128:   },\n129:   {\n130:     name: 'a command with no known policy drops the parenthesis',\n131:     recommendation: {\n132:       skill: 'command-doctor-review-gate',\n133:       kind: 'command',\n134:       command: '/doctor:review gate',\n135:       ownerSkillId: 'sk-code',\n136:       confidence: 0.77,\n137:       uncertainty: 0.2,\n138:     },\n139:     expectedHead: 'Advisor: live; use sk-code → /doctor:review gate 0.77/0.20 pass.',\n140:   },\n141: ];\n142: \n143: // Every recommendation is marked as passing so each case isolates the head form\n144: // instead of threshold filtering.\n145: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n146:   return {\n147:     status: 'ok',\n148:     freshness: 'live',\n149:  