{"type":"tool_use","timestamp":1794531690854,"sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","part":{"partID":"prt_1d26c8952001fj64E1aYtqCQMe","sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","messageID":"msg_1d26c7d14001hw9lalwbR0keUE","type":"tool","id":"call_ed3137ac7cbc4b1fa589a269","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-265\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, and the skill that owns it. The\n46: // rows are generated, so only the shape lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly ownerSkillId: string;\n51: }\n52: \n53: // BEGIN GENERATED COMMAND ROWS\n54: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n55:   'command-create-agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n56:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', ownerSkillId: 'sk-doc' },\n57:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', ownerSkillId: 'sk-doc' },\n58:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n59:   'command-create-readme': { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' },\n60:   'command-create-skill': { command: '/create:skill', policy: 'start', ownerSkillId: 'sk-doc' },\n61:   'command-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n62:   'command-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n63:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n64:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n65:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n66:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', ownerSkillId: 'sk-code' },\n67:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', ownerSkillId: 'sk-code' },\n68:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', ownerSkillId: 'sk-code' },\n69:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', ownerSkillId: 'system-deep-loop' },\n70:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n71:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', ownerSkillId: 'sk-git' },\n72:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', ownerSkillId: 'sk-git' },\n73:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', ownerSkillId: 'sk-git' },\n74:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-install': { command: '/doctor:install', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n78:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n79:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n80:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n81:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n83:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', ownerSkillId: 'sk-code' },\n84:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', ownerSkillId: 'sk-code' },\n85:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', ownerSkillId: 'sk-doc' },\n86:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', ownerSkillId: 'sk-doc' },\n87:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n88:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n89:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n90:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n91:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n92:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n93:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n95:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n96:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n97:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n98:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', ownerSkillId: 'sk-prompt' },\n99:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n100:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n101:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', ownerSkillId: 'system-spec-kit' },\n102:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', ownerSkillId: 'system-spec-kit' },\n103:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', ownerSkillId: 'system-spec-kit' },\n104:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', ownerSkillId: 'system-spec-kit' },\n105:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' },\n106:   'command-speckit-save': { command: '/speckit:save', policy: 'start', ownerSkillId: 'system-spec-kit' },\n107:   'command-speckit-search': { command: '/speckit:search', policy: 'run', ownerSkillId: 'system-spec-kit' },\n108:   'create:agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n109:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n110: };\n111: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n112:   '/create:agent': 'start',\n113:   '/create:changelog': 'ask',\n114:   '/create:feature-catalog': 'start',\n115:   '/create:manual-testing-playbook': 'start',\n116:   '/create:readme': 'start',\n117:   '/create:skill': 'start',\n118:   '/deep:research': 'ask',\n119:   '/deep:review': 'ask',\n120:   '/doctor:agents-md check': 'run',\n121:   '/doctor:agents-md embed': 'ask',\n122:   '/doctor:agents-md restore': 'ask',\n123:   '/doctor:ci report': 'run',\n124:   '/doctor:ci scaffold': 'ask',\n125:   '/doctor:ci toggle': 'ask',\n126:   '/doctor:deep-loop': 'run',\n127:   '/doctor:env list': 'run',\n128:   '/doctor:git hooks': 'ask',\n129:   '/doctor:git setup': 'run',\n130:   '/doctor:git standards': 'ask',\n131:   '/doctor:helper': 'run',\n132:   '/doctor:install': 'run',\n133:   '/doctor:mcp debug': 'ask',\n134:   '/doctor:mcp install': 'ask',\n135:   '/doctor:overlay apply': 'ask',\n136:   '/doctor:overlay repin': 'ask',\n137:   '/doctor:overlay status': 'run',\n138:   '/doctor:runtime-mirrors': 'run',\n139:   '/doctor:setup': 'run',\n140:   '/doctor:sk-code quality': 'ask',\n141:   '/doctor:sk-code setup': 'run',\n142:   '/doctor:sk-skill check': 'run',\n143:   '/doctor:sk-skill convert': 'ask',\n144:   '/doctor:skill-advisor parent-skill': 'run',\n145:   '/doctor:skill-advisor rebuild': 'ask',\n146:   '/doctor:skill-advisor router-reach': 'run',\n147:   '/doctor:skill-advisor skill-budget': 'run',\n148:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n149:   '/doctor:skill-advisor tune': 'ask',\n150:   '/doctor:speckit': 'run',\n151:   '/doctor:symlink check': 'run',\n152:   '/doctor:symlink link': 'ask',\n153:   '/doctor:symlink unlink': 'ask',\n154:   '/doctor:update': 'ask',\n155:   '/prompt:improve': 'start',\n156:   '/speckit:complete': 'start',\n157:   '/speckit:handoff': 'ask',\n158:   '/speckit:implement': 'start',\n159:   '/speckit:plan': 'start',\n160:   '/speckit:resume': 'start',\n161:   '/speckit:save': 'start',\n162:   '/speckit:search': 'run',\n163: };\n164: // END GENERATED COMMAND ROWS\n165: \n166: // The row for an id a recommendation carries, or undefined when that id names no\n167: // command. Own-key lookup because the table is generated data, so an inherited\n168: // name such as `constructor` must not resolve to a row nobody declared.\n169: export function commandRowFor(id: string): CommandRow | undefined {\n170:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n171: }\n172: \n173: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n174: // that merely mentions the topic spends the reader's budget on work they never\n175: // asked for. The list below is the vocabulary that counts as asking for it, and\n176: // it holds only effort wording: a bare topic word such as `research`, `review`\n177: // or `council` says what to look at, never how far to go, so it never qualifies\n178: // on its own.\n179: //\n180: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n181: // has to judge stays visible and cheap to correct.\n182: export const DEPTH_WORDING: readonly string[] = [\n183:   'in depth',\n184:   'deep dive',\n185:   'deep research',\n186:   'deep review',\n187:   'thorough',\n188:   'thoroughly',\n189:   'exhaustive',\n190:   'iteratively',\n191:   'multiple passes',\n192:   'many passes',\n193:   'several passes',\n194:   'ask the council',\n195:   'convene',\n196:   'several models',\n197:   'final verdict',\n198:   'everything you can',\n199: ];\n200: \n201: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n202: // escaped before it is trusted as a pattern.\n203: function escapePhrase(phrase: string): string {\n204:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n205: }\n206: \n207: // One alternation over the list keeps the gate a single test per prompt, and the\n208: // boundary markers keep `thorough` from firing inside a longer word while a\n209: // multi-word phrase still has to match as a whole.\n210: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n211: \n212: // A compiled route arrives as unvalidated JSON from a separate process, so the\n213: // shape is narrowed here rather than trusted. Arrays count as objects in\n214: // JavaScript and would let `action` read off an unrelated field, so they are\n215: // excluded explicitly.\n216: function asRecord(value: unknown): Record<string, unknown> | undefined {\n217:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n218:   return value as Record<string, unknown>;\n219: }\n220: \n221: // The command for a hub's recommendation, or undefined when the route does not\n222: // single out one mode. Only a single-mode route names a command unambiguously:\n223: // a bundle or a multi-target route has more than one answer, and asking the\n224: // reader to pick belongs to the recommend path, not here. Never throws, because\n225: // a missing command must degrade to \"no command offered\" rather than break\n226: // routing. The prompt decides whether a costly deep-loop command is offered at\n227: // all: a reader who only asks about the topic gets no command, rather than one\n228: // that would launch work they never requested.\n229: export function attachCommand(\n230:   skillId: string,\n231:   compiledRoute: unknown,\n232:   prompt: string,\n233:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n234: ): string | undefined {\n235:   const route = asRecord(compiledRoute);\n236:   if (!route) return undefined;\n237:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n238: \n239:   const targets = route.targets;\n240:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n241: \n242:   const onlyTarget = asRecord(targets[0]);\n243:   if (!onlyTarget) return undefined;\n244: \n245:   const workflowMode = onlyTarget.workflowMode;\n246:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n247: \n248:   // Own-key lookup on both levels: the table is data read from a generated\n249:   // object, so an inherited name such as `constructor` must not resolve to a\n250:   // command the hub never declared.\n251:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n252:   const commands = modeCommands[skillId];\n253:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n254: \n255:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n256:   // run, so they are offered only when the prompt asks for that effort. Typing\n257:   // the slash command is itself the ask, and every other hub answers a short\n258:   // question with a short answer, so no other skill consults the wording list.\n259:   if (skillId === 'system-deep-loop') {\n260:     const lowered = prompt.toLowerCase();\n261:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n262:   }\n263: \n264:   return commands[workflowMode];\n265: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-265\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, and the skill that owns it. The\n46: // rows are generated, so only the shape lives here.\n47: export interface CommandRow {\n48:   readonly command: string;\n49:   readonly policy?: 'run' | 'start' | 'ask';\n50:   readonly ownerSkillId: string;\n51: }\n52: \n53: // BEGIN GENERATED COMMAND ROWS\n54: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n55:   'command-create-agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n56:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', ownerSkillId: 'sk-doc' },\n57:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', ownerSkillId: 'sk-doc' },\n58:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n59:   'command-create-readme': { command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc' },\n60:   'command-create-skill': { command: '/create:skill', policy: 'start', ownerSkillId: 'sk-doc' },\n61:   'command-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n62:   'command-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n63:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n64:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n65:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n66:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', ownerSkillId: 'sk-code' },\n67:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', ownerSkillId: 'sk-code' },\n68:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', ownerSkillId: 'sk-code' },\n69:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', ownerSkillId: 'system-deep-loop' },\n70:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n71:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', ownerSkillId: 'sk-git' },\n72:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', ownerSkillId: 'sk-git' },\n73:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', ownerSkillId: 'sk-git' },\n74:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-install': { command: '/doctor:install', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n78:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n79:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n80:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n81:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n83:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', ownerSkillId: 'sk-code' },\n84:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', ownerSkillId: 'sk-code' },\n85:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', ownerSkillId: 'sk-doc' },\n86:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', ownerSkillId: 'sk-doc' },\n87:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n88:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n89:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n90:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n91:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', ownerSkillId: 'system-skill-advisor' },\n92:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', ownerSkillId: 'system-skill-advisor' },\n93:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', ownerSkillId: 'system-skilled-doctor' },\n95:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n96:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n97:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', ownerSkillId: 'system-skilled-doctor' },\n98:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', ownerSkillId: 'sk-prompt' },\n99:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n100:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', ownerSkillId: 'system-deep-loop' },\n101:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', ownerSkillId: 'system-spec-kit' },\n102:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', ownerSkillId: 'system-spec-kit' },\n103:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', ownerSkillId: 'system-spec-kit' },\n104:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', ownerSkillId: 'system-spec-kit' },\n105:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', ownerSkillId: 'system-spec-kit' },\n106:   'command-speckit-save': { command: '/speckit:save', policy: 'start', ownerSkillId: 'system-spec-kit' },\n107:   'command-speckit-search': { command: '/speckit:search', policy: 'run', ownerSkillId: 'system-spec-kit' },\n108:   'create:agent': { command: '/create:agent', policy: 'start', ownerSkillId: 'sk-doc' },\n109:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', ownerSkillId: 'sk-doc' },\n110: };\n111: export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\n112:   '/create:agent': 'start',\n113:   '/create:changelog': 'ask',\n114:   '/create:feature-catalog': 'start',\n115:   '/create:manual-testing-playbook': 'start',\n116:   '/create:readme': 'start',\n117:   '/create:skill': 'start',\n118:   '/deep:research': 'ask',\n119:   '/deep:review': 'ask',\n120:   '/doctor:agents-md check': 'run',\n121:   '/doctor:agents-md embed': 'ask',\n122:   '/doctor:agents-md restore': 'ask',\n123:   '/doctor:ci report': 'run',\n124:   '/doctor:ci scaffold': 'ask',\n125:   '/doctor:ci toggle': 'ask',\n126:   '/doctor:deep-loop': 'run',\n127:   '/doctor:env list': 'run',\n128:   '/doctor:git hooks': 'ask',\n129:   '/doctor:git setup': 'run',\n130:   '/doctor:git standards': 'ask',\n131:   '/doctor:helper': 'run',\n132:   '/doctor:install': 'run',\n133:   '/doctor:mcp debug': 'ask',\n134:   '/doctor:mcp install': 'ask',\n135:   '/doctor:overlay apply': 'ask',\n136:   '/doctor:overlay repin': 'ask',\n137:   '/doctor:overlay status': 'run',\n138:   '/doctor:runtime-mirrors': 'run',\n139:   '/doctor:setup': 'run',\n140:   '/doctor:sk-code quality': 'ask',\n141:   '/doctor:sk-code setup': 'run',\n142:   '/doctor:sk-skill check': 'run',\n143:   '/doctor:sk-skill convert': 'ask',\n144:   '/doctor:skill-advisor parent-skill': 'run',\n145:   '/doctor:skill-advisor rebuild': 'ask',\n146:   '/doctor:skill-advisor router-reach': 'run',\n147:   '/doctor:skill-advisor skill-budget': 'run',\n148:   '/doctor:skill-advisor skill-graph-freshness': 'run',\n149:   '/doctor:skill-advisor tune': 'ask',\n150:   '/doctor:speckit': 'run',\n151:   '/doctor:symlink check': 'run',\n152:   '/doctor:symlink link': 'ask',\n153:   '/doctor:symlink unlink': 'ask',\n154:   '/doctor:update': 'ask',\n155:   '/prompt:improve': 'start',\n156:   '/speckit:complete': 'start',\n157:   '/speckit:handoff': 'ask',\n158:   '/speckit:implement': 'start',\n159:   '/speckit:plan': 'start',\n160:   '/speckit:resume': 'start',\n161:   '/speckit:save': 'start',\n162:   '/speckit:search': 'run',\n163: };\n164: // END GENERATED COMMAND ROWS\n165: \n166: // The row for an id a recommendation carries, or undefined when that id names no\n167: // command. Own-key lookup because the table is generated data, so an inherited\n168: // name such as `constructor` must not resolve to a row nobody declared.\n169: export function commandRowFor(id: string): CommandRow | undefined {\n170:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n171: }\n172: \n173: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n174: // that merely mentions the topic spends the reader's budget on work they never\n175: // asked for. The list below is the vocabulary that counts as asking for it, and\n176: // it holds only effort wording: a bare topic word such as `research`, `review`\n177: // or `council` says what to look at, never how far to go, so it never qualifies\n178: // on its own.\n179: //\n180: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n181: // has to judge stays visible and cheap to correct.\n182: export const DEPTH_WORDING: readonly string[] = [\n183:   'in depth',\n184:   'deep dive',\n185:   'deep research',\n186:   'deep review',\n187:   'thorough',\n188:   'thoroughly',\n189:   'exhaustive',\n190:   'iteratively',\n191:   'multiple passes',\n192:   'many passes',\n193:   'several passes',\n194:   'ask the council',\n195:   'convene',\n196:   'several models',\n197:   'final verdict',\n198:   'everything you can',\n199: ];\n200: \n201: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n202: // escaped before it is trusted as a pattern.\n203: function escapePhrase(phrase: string): string {\n204:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n205: }\n206: \n207: // One alternation over the list keeps the gate a single test per prompt, and the\n208: // boundary markers keep `thorough` from firing inside a longer word while a\n209: // multi-word phrase still has to match as a whole.\n210: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n211: \n212: // A compiled route arrives as unvalidated JSON from a separate process, so the\n213: // shape is narrowed here rather than trusted. Arrays count as objects in\n214: // JavaScript and would let `action` read off an unrelated field, so they are\n215: // excluded explicitly.\n216: function asRecord(value: unknown): Record<string, unknown> | undefined {\n217:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n218:   return value as Record<string, unknown>;\n219: }\n220: \n221: // The command for a hub's recommendation, or undefined when the route does not\n222: // single out one mode. Only a single-mode route names a command unambiguously:\n223: // a bundle or a multi-target route has more than one answer, and asking the\n224: // reader to pick belongs to the recommend path, not here. Never throws, because\n225: // a missing command must degrade to \"no command offered\" rather than break\n226: // routing. The prompt decides whether a costly deep-loop command is offered at\n227: // all: a reader who only asks about the topic gets no command, rather than one\n228: // that would launch work they never requested.\n229: export function attachCommand(\n230:   skillId: string,\n231:   compiledRoute: unknown,\n232:   prompt: string,\n233:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n234: ): string | undefined {\n235:   const route = asRecord(compiledRoute);\n236:   if (!route) return undefined;\n237:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n238: \n239:   const targets = route.targets;\n240:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n241: \n242:   const onlyTarget = asRecord(targets[0]);\n243:   if (!onlyTarget) return undefined;\n244: \n245:   const workflowMode = onlyTarget.workflowMode;\n246:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n247: \n248:   // Own-key lookup on both levels: the table is data read from a generated\n249:   // object, so an inherited name such as `constructor` must not resolve to a\n250:   // command the hub never declared.\n251:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n252:   const commands = modeCommands[skillId];\n253:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n254: \n255:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n256:   // run, so they are offered only when the prompt asks for that effort. Typing\n257:   // the slash command is itself the ask, and every other hub answers a short\n258:   // question with a short answer, so no other skill consults the wording list.\n259:   if (skillId === 'system-deep-loop') {\n260:     const lowered = prompt.toLowerCase();\n261:     if (!lowered.includes('/deep:') && !DEPTH_REQUEST.test(lowered)) return undefined;\n262:   }\n263: \n264:   return commands[workflowMode];\n265: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794531690834,"end":1794531690854}}}}
{"type":"tool_use","timestamp":1794531690861,"sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","part":{"partID":"prt_1d26c8951002TgAU5Z0suoDhpm","sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","messageID":"msg_1d26c7d14001hw9lalwbR0keUE","type":"tool","id":"call_008c91f8d3a845568a336c65","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1-1296\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Derive Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: const { existsSync, readFileSync, readdirSync, writeFileSync } = require('node:fs');\n12: const { join, relative, resolve, sep } = require('node:path');\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: \n18: const COMMAND_BRIDGES_DIR = __dirname;\n19: const REPO_ROOT = resolve(COMMAND_BRIDGES_DIR, '../../../../../..');\n20: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n21: // One folder per command group, one Markdown file per command: the tree the\n22: // inventory identity check reads.\n23: const COMMANDS_ROOT = join(REPO_ROOT, '.skilled', 'commands');\n24: const DOCTOR_COMMANDS_DIR = join(COMMANDS_ROOT, 'doctor');\n25: const DOCTOR_ROUTES_PATH = join(DOCTOR_COMMANDS_DIR, '_routes.yaml');\n26: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n27: const OUTPUT_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n28: const TS_PROJECTION_PATH = join(\n29:   SKILLS_ROOT,\n30:   'system-skill-advisor',\n31:   'runtime',\n32:   'lib',\n33:   'scorer',\n34:   'projection.ts',\n35: );\n36: const PY_ADVISOR_PATH = join(\n37:   SKILLS_ROOT,\n38:   'system-skill-advisor',\n39:   'runtime',\n40:   'scripts',\n41:   'skill_advisor.py',\n42: );\n43: const TS_GENERATED_START = '// BEGIN GENERATED COMMAND BRIDGES';\n44: const TS_GENERATED_END = '// END GENERATED COMMAND BRIDGES';\n45: const PY_GENERATED_START = '# BEGIN GENERATED COMMAND BRIDGES';\n46: const PY_GENERATED_END = '# END GENERATED COMMAND BRIDGES';\n47: const DOCTOR_PREFIX = 'command-doctor-';\n48: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n49: \n50: // Closed vocabularies: an unrecognised value has to fail loudly, because a\n51: // silent fallthrough would hand a mutating command the read-only policy (or the\n52: // reverse) and nothing downstream would notice.\n53: const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n54: const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n55: const WRITE_SCOPES = ['spec-folder'];\n56: // A command with several routes and no target typed answers for its strictest\n57: // route, because the reader gave the bridge no way to narrow the run.\n58: const POLICY_STRICTNESS = ['run', 'start', 'ask'];\n59: // A lead phrase outranks a passing skill, which is only safe when the prompt asks\n60: // about the state of something. A phrase that names no state or health word could\n61: // outrank the skill on an ordinary task, so it belongs only on a route that\n62: // already asks before it runs.\n63: const LEAD_PHRASE_STATE_WORDS = [\n64:   'check',\n65:   'state',\n66:   'status',\n67:   'report',\n68:   'health',\n69:   'off',\n70:   'on',\n71:   'which',\n72:   'show',\n73:   'list',\n74:   'inventory',\n75:   'drift',\n76:   'stale',\n77:   'missing',\n78:   'failing',\n79:   'broken',\n80: ];\n81: const COMMAND_ATTACH_PATH = join(\n82:   SKILLS_ROOT,\n83:   'system-skill-advisor',\n84:   'runtime',\n85:   'lib',\n86:   'command-attach.ts',\n87: );\n88: const COMMAND_ATTACH_GENERATED_START = '// BEGIN GENERATED MODE COMMANDS';\n89: const COMMAND_ATTACH_GENERATED_END = '// END GENERATED MODE COMMANDS';\n90: const COMMAND_ROWS_GENERATED_START = '// BEGIN GENERATED COMMAND ROWS';\n91: const COMMAND_ROWS_GENERATED_END = '// END GENERATED COMMAND ROWS';\n92: \n93: // Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n94: // The inventory entries keep their five-key shape; the projection merge reads here.\n95: const DOCTOR_DETAILS = new Map();\n96: \n97: // Meaning text per command, taken from the metadata record that already states\n98: // what the command does in the words a person uses.\n99: const METADATA_MEANING = new Map();\n100: \n101: // ───────────────────────────────────────────────────────────────────\n102: // 3. HELPERS\n103: // ───────────────────────────────────────────────────────────────────\n104: \n105: function readJson(filePath) {\n106:   try {\n107:     return JSON.parse(readFileSync(filePath, 'utf8'));\n108:   } catch (error) {\n109:     throw new Error(`[command-bridges] Failed to read JSON ${filePath}: ${error.message}`);\n110:   }\n111: }\n112: \n113: function bridgeId(command) {\n114:   if (!/^\\/[a-z][a-z0-9-]*:[a-z0-9-]+$/.test(command)) {\n115:     throw new Error(`[command-bridges] Invalid command id: ${command}`);\n116:   }\n117:   return `command-${command.slice(1).replace(':', '-')}`;\n118: }\n119: \n120: function sourcePath(filePath) {\n121:   return relative(REPO_ROOT, filePath).split(sep).join('/');\n122: }\n123: \n124: function metadataEntries(skillsRoot = SKILLS_ROOT) {\n125:   METADATA_MEANING.clear();\n126:   const entries = [];\n127:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n128:     // A private skill is local to one checkout and must never reach a tracked bridge file.\n129:     // Only a private skill may be a link, so any other linked folder is not a skill source.\n130:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n131:     .map((entry) => entry.name)\n132:     .sort();\n133:   for (const skillId of skillIds) {\n134:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n135:     if (!existsSync(filePath)) continue;\n136: \n137:     // A skill with no mode registry has no hub to route its commands, so its\n138:     // metadata is the whole declaration of what each command reaches.\n139:     const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n140:     const metadata = readJson(filePath);\n141:     if (!Array.isArray(metadata)) {\n142:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n143:     }\n144:     for (const [index, entry] of metadata.entries()) {\n145:       if (!entry || typeof entry !== 'object') {\n146:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n147:       }\n148:       const { command, ownerMode } = entry;\n149:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n150:         throw new Error(\n151:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n152:         );\n153:       }\n154:       const description = entry.description === undefined ? '' : entry.description;\n155:       if (typeof description !== 'string') {\n156:         throw new Error(\n157:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n158:         );\n159:       }\n160:       // The phrases a person types instead of the command are declared once, in\n161:       // the metadata, so the bridge reads them here instead of restating them.\n162:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n163:         ? stringArray(\n164:           entry.userIntent.ownedSignals,\n165:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n166:         )\n167:         : [];\n168:       // The job is prose about the outcome a person wants, so it describes the\n169:       // command in words none of the identifiers do. An absent job is a record\n170:       // that says less, not a broken one.\n171:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n172:         ? entry.userIntent.job\n173:         : '';\n174:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n175:       entries.push({\n176:         id: bridgeId(command),\n177:         command,\n178:         skillId,\n179:         ownerMode,\n180:         description,\n181:         ownedSignals: [...ownedSignals],\n182:         standalone,\n183:         mutating: entry.mutating,\n184:         source: sourcePath(filePath),\n185:       });\n186:     }\n187:   }\n188:   return entries;\n189: }\n190: \n191: function doctorSkillAgent(name) {\n192:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n193:   const tag = existsSync(routerPath)\n194:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n195:     : null;\n196:   if (!tag) {\n197:     throw new Error(\n198:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n199:         + 'a doctor bridge needs its owning skill',\n200:     );\n201:   }\n202:   return tag[1];\n203: }\n204: \n205: // A router names its own purpose in the frontmatter sentence a person reads\n206: // before anything else, so the bridge embeds that sentence rather than a second\n207: // copy written for the scorer to drift from.\n208: function doctorCommandDescription(name) {\n209:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n210:   const match = existsSync(routerPath)\n211:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n212:     : null;\n213:   // Required lazily for the same reason as the route manifest: an\n214:   // argument-rejecting run must exit before this module needs a YAML parser.\n215:   const YAML = require('yaml');\n216:   let frontmatter = null;\n217:   if (match) {\n218:     try {\n219:       frontmatter = YAML.parse(match[1]);\n220:     } catch (error) {\n221:       throw new Error(\n222:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n223:       );\n224:     }\n225:   }\n226:   const description = frontmatter && frontmatter.description;\n227:   if (typeof description !== 'string' || !description.trim()) {\n228:     throw new Error(\n229:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n230:         + 'a doctor bridge needs the sentence it embeds',\n231:     );\n232:   }\n233:   return description.trim();\n234: }\n235: \n236: function doctorCommandName(command, label) {\n237:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n238:   if (!match) {\n239:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n240:   }\n241:   return match[1];\n242: }\n243: \n244: function doctorRouteEntries() {\n245:   DOCTOR_DETAILS.clear();\n246:   // Required lazily: an argument-rejecting run must exit before this module\n247:   // ever needs a YAML parser.\n248:   const YAML = require('yaml');\n249:   let manifest;\n250:   try {\n251:     manifest = YAML.parse(readFileSync(DOCTOR_ROUTES_PATH, 'utf8'));\n252:   } catch (error) {\n253:     throw new Error(\n254:       `[command-bridges] Failed to read ${sourcePath(DOCTOR_ROUTES_PATH)}: ${error.message}`,\n255:     );\n256:   }\n257:   const routes = manifest && manifest.routes;\n258:   if (!Array.isArray(routes)) {\n259:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n260:   }\n261:   const names = routes.map((route, index) => (\n262:     doctorCommandName(route.command, `_routes.yaml routes[${index}]`)\n263:   ));\n264:   const totals = new Map();\n265:   for (const name of names) {\n266:     totals.set(name, (totals.get(name) || 0) + 1);\n267:   }\n268: \n269:   const entries = [];\n270:   routes.forEach((route, index) => {\n271:     const label = `_routes.yaml routes[${index}]`;\n272:     if (typeof route.target !== 'string' || !route.target) {\n273:       throw new Error(`[command-bridges] ${label} requires a non-empty string target`);\n274:     }\n275:     // A command with several targets needs one bridge per target; a\n276:     // single-target command takes the command's own id.\n277:     const multiTarget = totals.get(names[index]) > 1;\n278:     const id = multiTarget\n279:       ? `command-doctor-${names[index]}-${route.target}`\n280:       : `command-doctor-${names[index]}`;\n281:     const skillId = doctorSkillAgent(names[index]);\n282:     const phrases = stringArray(route.trigger_phrases, `${label}.trigger_phrases`);\n283:     const leadPhrases = doctorLeadPhrases(route, label, phrases);\n284:     DOCTOR_DETAILS.set(id, {\n285:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n286:       bareCommand: doctorDefaultTarget(route, label, multiTarget),\n287:       description: doctorCommandDescription(names[index]),\n288:       phrases,\n289:       leadPhrases,\n290:       readOnly: isReadOnlyRoute(route),\n291:     });\n292:     entries.push({\n293:       id,\n294:       command: route.command,\n295:       skillId,\n296:       ownerMode: skillId,\n297:       source: sourcePath(DOCTOR_ROUTES_PATH),\n298:     });\n299:   });\n300: \n301:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n302:   if (!Array.isArray(standalone)) {\n303:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n304:   }\n305:   standalone.forEach((item, index) => {\n306:     if (!item || typeof item !== 'object') return;\n307:     const label = `_routes.yaml standalone[${index}]`;\n308:     const phrases = Object.prototype.hasOwnProperty.call(item, 'trigger_phrases')\n309:       ? stringArray(item.trigger_phrases, `${label}.trigger_phrases`)\n310:       : [];\n311:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n312:     if (typeof item.command !== 'string') return;\n313:     const name = doctorCommandName(item.command, label);\n314:     const skillId = doctorSkillAgent(name);\n315:     const runnable = typeof item.runnable === 'string' && item.runnable\n316:       ? item.runnable\n317:       : item.command;\n318:     DOCTOR_DETAILS.set(`command-doctor-${name}`, {\n319:       runnable,\n320:       description: doctorCommandDescription(name),\n321:       phrases,\n322:       leadPhrases,\n323:       readOnly: isReadOnlyRoute(item),\n324:     });\n325:     entries.push({\n326:       id: `command-doctor-${name}`,\n327:       command: item.command,\n328:       skillId,\n329:       ownerMode: skillId,\n330:       source: sourcePath(DOCTOR_ROUTES_PATH),\n331:     });\n332:   });\n333: \n334:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n335:   if (!Array.isArray(mcpSubroutes)) {\n336:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n337:   }\n338:   mcpSubroutes.forEach((item, index) => {\n339:     const label = `_routes.yaml mcp_subroutes[${index}]`;\n340:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) {\n341:       throw new Error(`[command-bridges] ${label} requires a non-empty string sub_action`);\n342:     }\n343:     const commandName = doctorCommandName(DOCTOR_MCP_COMMAND, label);\n344:     const skillId = doctorSkillAgent(commandName);\n345:     const id = `${DOCTOR_PREFIX}${commandName}-${item.sub_action}`;\n346:     const runnable = `${DOCTOR_MCP_COMMAND} ${item.sub_action}`;\n347:     const phrases = stringArray(item.trigger_phrases, `${label}.trigger_phrases`);\n348:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n349:     DOCTOR_DETAILS.set(id, {\n350:       runnable,\n351:       description: doctorCommandDescription(commandName),\n352:       phrases,\n353:       leadPhrases,\n354:       readOnly: isReadOnlyRoute(item),\n355:     });\n356:     entries.push({\n357:       id,\n358:       command: DOCTOR_MCP_COMMAND,\n359:       skillId,\n360:       ownerMode: skillId,\n361:       source: sourcePath(DOCTOR_ROUTES_PATH),\n362:     });\n363:   });\n364: \n365:   return entries;\n366: }\n367: \n368: // A command exists when its router file exists: the folder directly under the\n369: // commands root names the group and a Markdown file inside it names the action.\n370: // A README and a .contract.md describe a command instead of being one, a file\n371: // directly in the root names no command at all, and a local- name belongs to a\n372: // single checkout, so none of them count.\n373: function commandTreeNames(commandsRoot = COMMANDS_ROOT) {\n374:   const commands = [];\n375:   const groups = readdirSync(commandsRoot, { withFileTypes: true })\n376:     .filter((entry) => entry.isDirectory() && !entry.name.startsWith('local-'))\n377:     .map((entry) => entry.name)\n378:     .sort();\n379:   for (const group of groups) {\n380:     const files = readdirSync(join(commandsRoot, group), { withFileTypes: true })\n381:       .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n382:       .filter((entry) => (\n383:         entry.name !== 'README.md'\n384:         && !entry.name.endsWith('.contract.md')\n385:         && !entry.name.startsWith('local-')\n386:       ))\n387:       .map((entry) => `/${group}:${entry.name.slice(0, -'.md'.length)}`);\n388:     commands.push(...files);\n389:   }\n390:   return commands.sort();\n391: }\n392: \n393: // A hub's mode registry is the only place that pairs a workflow mode with the\n394: // command that runs it, so the reader's reverse lookup is derived from the hubs\n395: // themselves rather than transcribed into the consumer and left to drift.\n396: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n397:   const commandNames = new Set(commandTreeNames(commandsRoot));\n398:   const records = [];\n399:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n400:     // The same skill folders as the bridge metadata, for the same reason: a\n401:     // private skill is local to one checkout and a linked folder is not a skill\n402:     // source.\n403:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n404:     .map((entry) => entry.name)\n405:     .sort();\n406:   for (const hubId of hubIds) {\n407:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n408:     if (!existsSync(filePath)) continue;\n409: \n410:     const registry = readJson(filePath);\n411:     const modes = registry && registry.modes;\n412:     if (!Array.isArray(modes)) {\n413:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n414:     }\n415:     const seen = new Set();\n416:     for (const [index, mode] of modes.entries()) {\n417:       const label = `${sourcePath(filePath)} modes[${index}]`;\n418:       const workflowMode = mode && mode.workflowMode;\n419:       if (typeof workflowMode !== 'string' || !workflowMode) {\n420:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n421:       }\n422:       // One key per hub: a repeated workflow mode would leave the lookup holding\n423:       // whichever row the table happened to keep, so the registry has to say it\n424:       // once.\n425:       if (seen.has(workflowMode)) {\n426:         throw new Error(\n427:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n428:         );\n429:       }\n430:       seen.add(workflowMode);\n431: \n432:       const { command } = mode;\n433:       // A null command is a mode with no dedicated slash command, which is a\n434:       // declared state rather than a mistake, so it contributes no row.\n435:       if (typeof command !== 'string' || !command) continue;\n436:       // A command with no router file is one the reader cannot type, so naming\n437:       // it here would promise a surface that does not exist.\n438:       if (!commandNames.has(command)) {\n439:         throw new Error(\n440:           `[command-bridges] ${label} names ${command}, which has no command file`,\n441:         );\n442:       }\n443:       records.push({ hubId, workflowMode, command });\n444:     }\n445:   }\n446:   // The generated file is compared byte for byte, so the order has to be total.\n447:   return records.sort((left, right) => (\n448:     left.hubId === right.hubId\n449:       ? left.workflowMode.localeCompare(right.workflowMode)\n450:       : left.hubId.localeCompare(right.hubId)\n451:   ));\n452: }\n453: \n454: // The policy ladder reads only these keys, so a wrong value has to fail here\n455: // rather than fall through to a branch that merely looks safe.\n456: function validateRiskKeys(record, label, requireTarget = false) {\n457:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n458:     throw new Error(\n459:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n460:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n461:     );\n462:   }\n463:   if (record.ask_first !== undefined) {\n464:     const askFirst = record.ask_first;\n465:     if (!Array.isArray(askFirst) || askFirst.some((value) => !ASK_FIRST_REASONS.includes(value))) {\n466:       throw new Error(\n467:         `[command-bridges] ${label} has ask_first ${JSON.stringify(askFirst)}; `\n468:           + `expected an array of ${ASK_FIRST_REASONS.join(', ')}`,\n469:       );\n470:     }\n471:   }\n472:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n473:     throw new Error(\n474:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n475:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n476:     );\n477:   }\n478:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n479:     throw new Error(\n480:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n481:     );\n482:   }\n483: }\n484: \n485: // One policy per command, decided from the risk keys alone so the answer never\n486: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n487: // that mutates asks because its repair is the operator's call, and only a\n488: // read-only route or an add-only route confined to the spec folder may run\n489: // unprompted. Everything else starts as an ordinary task.\n490: function derivePolicy(record) {\n491:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n492:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n493:   if (record.mutating === 'read-only') return 'run';\n494:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n495:   return 'start';\n496: }\n497: \n498: // The same skill folders as the bridge metadata, for the same reason: a private\n499: // skill is local to a checkout and a linked folder is not a skill source. A\n500: // metadata command is reachable by typing its name, so it must also name where\n501: // its writes land before its policy may be derived.\n502: function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n503:   const records = [];\n504:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n505:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n506:     .map((entry) => entry.name)\n507:     .sort();\n508:   for (const skillId of skillIds) {\n509:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n510:     if (!existsSync(filePath)) continue;\n511:     const metadata = readJson(filePath);\n512:     if (!Array.isArray(metadata)) {\n513:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n514:     }\n515:     for (const [index, entry] of metadata.entries()) {\n516:       if (!entry || typeof entry !== 'object') {\n517:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n518:       }\n519:       validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n520:       records.push({\n521:         command: entry.command,\n522:         route: null,\n523:         mutating: entry.mutating,\n524:         ask_first: entry.ask_first || [],\n525:         write_scope: entry.write_scope,\n526:         doctor: false,\n527:       });\n528:     }\n529:   }\n530:   return records;\n531: }\n532: \n533: // The manifest is the doctor half of the same surface. Requiring YAML lazily\n534: // keeps an argument-rejecting run from ever loading a parser.\n535: function doctorRiskRecords(routesPath = DOCTOR_ROUTES_PATH) {\n536:   const YAML = require('yaml');\n537:   let manifest;\n538:   try {\n539:     manifest = YAML.parse(readFileSync(routesPath, 'utf8'));\n540:   } catch (error) {\n541:     throw new Error(\n542:       `[command-bridges] Failed to read ${sourcePath(routesPath)}: ${error.message}`,\n543:     );\n544:   }\n545: \n546:   const records = [];\n547:   const addRecord = (fields, label) => {\n548:     const record = {\n549:       command: fields.command,\n550:       route: fields.route,\n551:       mutating: fields.mutating,\n552:       ask_first: fields.ask_first || [],\n553:       write_scope: fields.write_scope,\n554:       doctor: true,\n555:     };\n556:     validateRiskKeys(record, label);\n557:     records.push(record);\n558:   };\n559: \n560:   const routes = manifest && manifest.routes;\n561:   if (!Array.isArray(routes)) {\n562:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n563:   }\n564:   routes.forEach((route, index) => {\n565:     addRecord({\n566:       command: route.command,\n567:       route: route.target,\n568:       mutating: route.mutating,\n569:       ask_first: route.ask_first,\n570:       write_scope: route.write_scope,\n571:     }, `${sourcePath(routesPath)} routes[${index}]`);\n572:   });\n573: \n574:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n575:   if (!Array.isArray(mcpSubroutes)) {\n576:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n577:   }\n578:   mcpSubroutes.forEach((item, index) => {\n579:     addRecord({\n580:       command: DOCTOR_MCP_COMMAND,\n581:       route: item?.sub_action,\n582:       mutating: item?.mutating,\n583:       ask_first: item?.ask_first,\n584:       write_scope: item?.write_scope,\n585:     }, `${sourcePath(routesPath)} mcp_subroutes[${index}]`);\n586:   });\n587: \n588:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n589:   if (!Array.isArray(standalone)) {\n590:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n591:   }\n592:   standalone.forEach((item, index) => {\n593:     if (!item || typeof item.command !== 'string') return;\n594:     const label = `${sourcePath(routesPath)} standalone[${index}]`;\n595:     const actions = item.actions;\n596:     // One command, several actions: the action carries the class because the\n597:     // bare command name cannot say what the run will do.\n598:     if (actions && typeof actions === 'object' && !Array.isArray(actions)) {\n599:       for (const [action, entry] of Object.entries(actions)) {\n600:         addRecord({\n601:           command: item.command,\n602:           route: action,\n603:           mutating: entry?.mutating,\n604:           ask_first: entry?.ask_first,\n605:           write_scope: entry?.write_scope,\n606:         }, `${label}.actions.${action}`);\n607:       }\n608:       return;\n609:     }\n610:     addRecord({\n611:       command: item.command,\n612:       route: null,\n613:       mutating: item.mutating,\n614:       ask_first: item.ask_first,\n615:       write_scope: item.write_scope,\n616:     }, label);\n617:   });\n618: \n619:   return records;\n620: }\n621: \n622: // Three views of one surface. A name in the tree that neither declaration\n623: // carries is a command nothing can suggest; a declared name with no file is a\n624: // bridge to a command the operator cannot type. Either way the inventory lies,\n625: // so both directions are reported together.\n626: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n627:   const tree = new Set(treeCommands);\n628:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n629:   const violations = [];\n630:   for (const command of tree) {\n631:     if (!declared.has(command)) {\n632:       violations.push(\n633:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n634:       );\n635:     }\n636:   }\n637:   for (const command of declared) {\n638:     if (!tree.has(command)) {\n639:       violations.push(\n640:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n641:       );\n642:     }\n643:   }\n644:   return violations.sort();\n645: }\n646: \n647: // The generated file is compared byte for byte, so the order has to be total:\n648: // command name first, then the bare route before its named ones.\n649: function commandPolicies(skillsRoot, routesPath) {\n650:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n651:     .map((record) => ({\n652:       command: record.command,\n653:       route: record.route,\n654:       mutating: record.mutating,\n655:       askFirst: record.ask_first,\n656:       policy: derivePolicy(record),\n657:     }))\n658:     .sort((left, right) => {\n659:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n660:       if (left.route === right.route) return 0;\n661:       if (left.route === null) return -1;\n662:       if (right.route === null) return 1;\n663:       return left.route.localeCompare(right.route);\n664:     });\n665: }\n666: \n667: function assertUniqueIds(entries) {\n668:   const seen = new Map();\n669:   for (const entry of entries) {\n670:     const previous = seen.get(entry.id);\n671:     if (previous) {\n672:       throw new Error(\n673:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n674:       );\n675:     }\n676:     seen.set(entry.id, entry);\n677:   }\n678: }\n679: \n680: function stringArray(value, label) {\n681:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n682:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n683:   }\n684:   return value;\n685: }\n686: \n687: // A vector has to describe the job a command does, so the slash form is dropped\n688: // before the text is built. A name left in would hand the scorer a second copy\n689: // of the token it already matches literally.\n690: function commandEmbeddingText({ description, job, ownedSignals }) {\n691:   // Each part is cleaned before the join: a part that was only a slash command,\n692:   // or one that already ends in a full stop, would otherwise leave stray\n693:   // punctuation in text whose only reader is an embedder.\n694:   // A prompt is written in the asker's voice, and so are the job sentence and\n695:   // the owned phrases. The description is written in the command's voice and\n696:   // carries mode and step notes no asker types, so it stands in only when a\n697:   // record states no job.\n698:   const lead = typeof job === 'string' && job.trim() ? job : description;\n699:   return [lead, ...ownedSignals]\n700:     .filter((part) => typeof part === 'string')\n701:     .map((part) => part\n702:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n703:       .replace(/\\s+/g, ' ')\n704:       .trim()\n705:       .replace(/[.\\s]+$/, ''))\n706:     .filter(Boolean)\n707:     .join('. ');\n708: }\n709: \n710: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n711: // depends on the row: a metadata row states it in its own record, while a doctor\n712: // row states it in the router sentence and the route phrases it already declares.\n713: function entryMeaning(entryId, command, isDoctor) {\n714:   if (!isDoctor) return METADATA_MEANING.get(command);\n715:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n716:   return { description, ownedSignals: phrases };\n717: }\n718: \n719: // Only a route the manifest classes as read-only may answer a list or show\n720: // question; add-only and mutating routes keep the read-only confidence floor.\n721: function isReadOnlyRoute(item) {\n722:   return item.mutating === 'read-only';\n723: }\n724: \n725: // A command with several targets runs only as `<command> <target>`, yet its router binds one\n726: // target when none is typed. A route marked default_target also answers the bare command, so\n727: // the typed command alone still reaches a bridge.\n728: function doctorDefaultTarget(route, label, multiTarget) {\n729:   if (!Object.prototype.hasOwnProperty.call(route, 'default_target')) return null;\n730:   if (typeof route.default_target !== 'boolean') {\n731:     throw new Error(`[command-bridges] ${label}.default_target must be a boolean`);\n732:   }\n733:   if (!route.default_target) return null;\n734:   if (!multiTarget) {\n735:     throw new Error(\n736:       `[command-bridges] ${label}.default_target is only valid on a command with several targets`,\n737:     );\n738:   }\n739:   return route.command;\n740: }\n741: \n742: // A lead phrase is matched against the whole prompt, so the state word has to be\n743: // a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n744: // nothing about state.\n745: function hasStateWord(phrase) {\n746:   return phrase\n747:     .toLowerCase()\n748:     .split(/[^a-z0-9]+/)\n749:     .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n750: }\n751: \n752: // A route that asks first may lead with a phrase that names no state or health\n753: // word, because the ask already keeps the run behind a decision.\n754: function doctorLeadPhrases(item, label, triggerPhrases) {\n755:   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n756:     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n757:     : [];\n758:   const asksFirst = derivePolicy({\n759:     doctor: true,\n760:     mutating: item.mutating,\n761:     ask_first: item.ask_first,\n762:     write_scope: item.write_scope,\n763:   }) === 'ask';\n764:   for (const phrase of leadPhrases) {\n765:     if (!triggerPhrases.includes(phrase)) {\n766:       throw new Error(\n767:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n768:       );\n769:     }\n770:     if (!asksFirst && !hasStateWord(phrase)) {\n771:       throw new Error(\n772:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n773:       );\n774:     }\n775:   }\n776:   return leadPhrases;\n777: }\n778: \n779: function compatibilityByInventoryId(entries, inventoryIds, platform) {\n780:   if (!Array.isArray(entries)) {\n781:     throw new Error(`[command-bridges] scoring-compatibility.json ${platform} must be an array`);\n782:   }\n783:   const byInventoryId = new Map();\n784:   const orders = new Set();\n785:   for (const [index, entry] of entries.entries()) {\n786:     if (!entry || typeof entry !== 'object') {\n787:       throw new Error(`[command-bridges] ${platform}[${index}] must be an object`);\n788:     }\n789:     const { inventoryId, order, id, description } = entry;\n790:     if (\n791:       typeof inventoryId !== 'string'\n792:       || !inventoryIds.has(inventoryId)\n793:       || !Number.isInteger(order)\n794:       || order < 0\n795:       || typeof id !== 'string'\n796:       || !id\n797:       || typeof description !== 'string'\n798:     ) {\n799:       throw new Error(\n800:         `[command-bridges] ${platform}[${index}] requires a known inventoryId, ` +\n801:           'non-negative integer order, id, and description',\n802:       );\n803:     }\n804:     if (byInventoryId.has(inventoryId)) {\n805:       throw new Error(`[command-bridges] Duplicate ${platform} inventoryId ${inventoryId}`);\n806:     }\n807:     if (orders.has(order)) {\n808:       throw new Error(`[command-bridges] Duplicate ${platform} order ${order}`);\n809:     }\n810:     const isDoctor = inventoryId.startsWith(DOCTOR_PREFIX);\n811:     if (isDoctor && id !== inventoryId) {\n812:       throw new Error(\n813:         `[command-bridges] ${platform}[${index}] doctor bridge id must equal its inventoryId`,\n814:       );\n815:     }\n816:     if (platform === 'typescript') {\n817:       if (!isDoctor) {\n818:         if (typeof entry.name !== 'string' || !entry.name) {\n819:           throw new Error(`[command-bridges] typescript[${index}] requires name`);\n820:         }\n821:         stringArray(entry.keywords, `typescript[${index}].keywords`);\n822:         stringArray(entry.domains, `typescript[${index}].domains`);\n823:         stringArray(entry.intentSignals, `typescript[${index}].intentSignals`);\n824:       }\n825:     } else {\n826:       if (!isDoctor) {\n827:         stringArray(entry.slashMarkers, `python[${index}].slashMarkers`);\n828:       }\n829:       if ('owningSkill' in entry && (typeof entry.owningSkill !== 'string' || !entry.owningSkill)) {\n830:         throw new Error(`[command-bridges] python[${index}].owningSkill must be a non-empty string`);\n831:       }\n832:       if ('deprecated' in entry && typeof entry.deprecated !== 'boolean') {\n833:         throw new Error(`[command-bridges] python[${index}].deprecated must be boolean`);\n834:       }\n835:     }\n836:     byInventoryId.set(inventoryId, entry);\n837:     orders.add(order);\n838:   }\n839:   return byInventoryId;\n840: }\n841: \n842: // A standalone skill has no hub registry, so the only record of what its\n843: // commands reach is its own metadata. The match is by command rather than by id\n844: // because one command can enter the inventory under a row that carries its own\n845: // historical id.\n846: function standaloneCommandRecords(entries, metadata) {\n847:   const byCommand = new Map();\n848:   for (const record of metadata) {\n849:     if (record.standalone) byCommand.set(record.command, record);\n850:   }\n851:   return entries\n852:     .filter((entry) => byCommand.has(entry.command))\n853:     .sort((left, right) => left.id.localeCompare(right.id))\n854:     .map((entry) => ({ entry, record: byCommand.get(entry.command) }));\n855: }\n856: \n857: // A generated row is the command's only reach, so one phrase would leave it\n858: // indistinguishable from every other command and the activation would claim a\n859: // surface the scorer cannot actually offer.\n860: function assertPlainChatSignals(records) {\n861:   for (const { entry, record } of records) {\n862:     if (record.ownedSignals.length < 2) {\n863:       throw new Error(\n864:         `[command-bridges] ${entry.command} needs at least two userIntent.ownedSignals `\n865:           + `in ${record.source}, found ${record.ownedSignals.length}`,\n866:       );\n867:     }\n868:   }\n869: }\n870: \n871: function commandNamespace(command) {\n872:   return command.slice(1, command.indexOf(':'));\n873: }\n874: \n875: // A standalone skill's commands are active by construction: the metadata already\n876: // names the phrases a person types, so a hand row would be a second copy left to\n877: // drift. A hand row still wins where one exists, because a curated row can carry\n878: // phrases the metadata cannot know. Orders start past the highest hand-written\n879: // one so a later hand row never has to renumber a generated one.\n880: function activateStandaloneCommands(byInventoryId, records, platform) {\n881:   let nextOrder = 0;\n882:   for (const row of byInventoryId.values()) {\n883:     nextOrder = Math.max(nextOrder, row.order + 1);\n884:   }\n885:   for (const { entry, record } of records) {\n886:     if (byInventoryId.has(entry.id)) continue;\n887:     byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n888:     nextOrder += 1;\n889:   }\n890: }\n891: \n892: function standaloneRuntimeRow(entry, record, order, platform) {\n893:   if (platform === 'typescript') {\n894:     return {\n895:       inventoryId: entry.id,\n896:       order,\n897:       id: entry.id,\n898:       name: entry.id,\n899:       description: record.description,\n900:       keywords: [...record.ownedSignals],\n901:       domains: [commandNamespace(entry.command), 'command'],\n902:       intentSignals: [...record.ownedSignals],\n903:       // The class decides this for every command, not only a doctor route.\n904:       ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\n905:     };\n906:   }\n907:   return {\n908:     inventoryId: entry.id,\n909:     order,\n910:     id: entry.id,\n911:     description: record.description,\n912:     slashMarkers: [entry.command, entry.command.slice(1)],\n913:     owningSkill: record.skillId,\n914:   };\n915: }\n916: \n917: function runtimeCompatibility(entries, metadata) {\n918:   const compatibility = readJson(COMPATIBILITY_PATH);\n919:   if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\n920:     throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\n921:   }\n922:   const inventoryIds = new Set(entries.map((entry) => entry.id));\n923:   const typescript = compatibilityByInventoryId(\n924:     compatibility.typescript,\n925:     inventoryIds,\n926:     'typescript',\n927:   );\n928:   const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\n929:   const standalone = standaloneCommandRecords(entries, metadata);\n930:   assertPlainChatSignals(standalone);\n931:   activateStandaloneCommands(typescript, standalone, 'typescript');\n932:   activateStandaloneCommands(python, standalone, 'python');\n933:   const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\n934:   if (\n935:     !pythonOwnerNormalization\n936:     || typeof pythonOwnerNormalization !== 'object'\n937:     || Array.isArray(pythonOwnerNormalization)\n938:     || Object.entries(pythonOwnerNormalization).some(\n939:       ([key, value]) => !key || typeof value !== 'string' || !value,\n940:     )\n941:   ) {\n942:     throw new Error(\n943:       '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\n944:     );\n945:   }\n946:   const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\n947:   for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\n948:     if (!activePythonIds.has(runtimeId)) {\n949:       throw new Error(\n950:         `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\n951:       );\n952:     }\n953:   }\n954:   return { typescript, python, pythonOwnerNormalization };\n955: }\n956: \n957: function tsString(value) {\n958:   return `'${value.replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"\\\\'\")}'`;\n959: }\n960: \n961: function tsArray(values) {\n962:   return `[${values.map((value) => tsString(value)).join(', ')}]`;\n963: }\n964: \n965: function doctorRuntime(entryId, platform, compat) {\n966:   const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n967:   if (platform === 'typescript') {\n968:     return {\n969:       ...compat,\n970:       name: runnable,\n971:       keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n972:       intentSignals: [runnable],\n973:       ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n974:       ...(readOnly ? { readOnly: true } : {}),\n975:       domains: ['doctor', 'command'],\n976:     };\n977:   }\n978:   return {\n979:     ...compat,\n980:     slashMarkers: bareCommand ? [runnable, bareCommand] : [runnable],\n981:     ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n982:   };\n983: }\n984: \n985: function runtimeOrdered(entries, platform) {\n986:   return [...entries].sort((left, right) => {\n987:     const leftRuntime = left.runtime[platform];\n988:     const rightRuntime = right.runtime[platform];\n989:     if (leftRuntime.enabled !== rightRuntime.enabled) {\n990:       return leftRuntime.enabled ? -1 : 1;\n991:     }\n992:     if (leftRuntime.enabled && rightRuntime.enabled) {\n993:       return leftRuntime.order - rightRuntime.order;\n994:     }\n995:     return left.id.localeCompare(right.id);\n996:   });\n997: }\n998: \n999: function renderTypescriptBridge(entry) {\n1000:   const runtime = entry.runtime.typescript;\n1001:   const active = runtime.enabled;\n1002:   const id = active ? runtime.id : entry.id;\n1003:   const name = active ? runtime.name : entry.id;\n1004:   const description = active ? runtime.description : '';\n1005:   const keywords = active ? runtime.keywords : [];\n1006:   const domains = active ? runtime.domains : [];\n1007:   const intentSignals = active ? runtime.intentSignals : [];\n1008:   const lines = [\n1009:     '  {',\n1010:     `    inventoryId: ${tsString(entry.id)},`,\n1011:     `    ownerSkill: ${tsString(entry.skillId)},`,\n1012:     `    routingEnabled: ${active},`,\n1013:     `    id: ${tsString(id)},`,\n1014:     \"    kind: 'command',\",\n1015:     \"    family: 'system',\",\n1016:     \"    category: 'command',\",\n1017:     `    name: ${tsString(name)},`,\n1018:     `    description: ${tsString(description)},`,\n1019:     `    keywords: ${tsArray(keywords)},`,\n1020:     `    domains: ${tsArray(domains)},`,\n1021:     `    intentSignals: ${tsArray(intentSignals)},`,\n1022:   ];\n1023:   if (active && runtime.leadPhrases?.length) {\n1024:     lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1025:   }\n1026:   if (active && runtime.readOnly === true) {\n1027:     lines.push('    readOnly: true,');\n1028:   }\n1029:   lines.push(\n1030:     '    derivedTriggers: [],',\n1031:     '    derivedKeywords: [],',\n1032:     '    sourcePath: null,',\n1033:     \"    lifecycleStatus: 'active',\",\n1034:     '  },',\n1035:   );\n1036:   return lines.join('\\n');\n1037: }\n1038: \n1039: function renderTypescriptProjection(entries) {\n1040:   const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1041:   return `export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\\n${body}\\n];`;\n1042: }\n1043: \n1044: function pythonString(value) {\n1045:   return JSON.stringify(value);\n1046: }\n1047: \n1048: function pythonList(values) {\n1049:   return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1050: }\n1051: \n1052: function renderPythonBridge(entry) {\n1053:   const runtime = entry.runtime.python;\n1054:   const active = runtime.enabled;\n1055:   const runtimeId = active ? runtime.id : entry.id;\n1056:   const description = active ? runtime.description : '';\n1057:   const slashMarkers = active ? runtime.slashMarkers : [entry.command];\n1058:   const lines = [\n1059:     `    ${pythonString(runtimeId)}: {`,\n1060:     `        \"description\": ${pythonString(description)},`,\n1061:     `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1062:   ];\n1063:   if (active && runtime.leadPhrases?.length) {\n1064:     lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1065:   }\n1066:   if (active && runtime.deprecated === true) {\n1067:     lines.push('        \"deprecated\": True,');\n1068:   }\n1069:   if (active && typeof runtime.owningSkill === 'string') {\n1070:     lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1071:   }\n1072:   lines.push(\n1073:     `        \"inventory_id\": ${pythonString(entry.id)},`,\n1074:     `        \"command\": ${pythonString(entry.command)},`,\n1075:     `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1076:     `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1077:     `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1078:     '    },',\n1079:   );\n1080:   return lines.join('\\n');\n1081: }\n1082: \n1083: function renderPythonProjection(entries, pythonOwnerNormalization) {\n1084:   const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1085:   const normalization = Object.entries(pythonOwnerNormalization)\n1086:     .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1087:     .join('\\n');\n1088:   return [\n1089:     'GENERATED_COMMAND_BRIDGES = {',\n1090:     body,\n1091:     '}',\n1092:     '',\n1093:     'GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {',\n1094:     normalization,\n1095:     '}',\n1096:   ].join('\\n');\n1097: }\n1098: \n1099: function replaceMarkedBlock(content, startMarker, endMarker, replacement, filePath) {\n1100:   const start = content.indexOf(startMarker);\n1101:   const end = content.indexOf(endMarker);\n1102:   if (start < 0 || end < 0 || end < start) {\n1103:     throw new Error(`[command-bridges] Missing generated markers in ${sourcePath(filePath)}`);\n1104:   }\n1105:   const bodyStart = start + startMarker.length;\n1106:   return `${content.slice(0, bodyStart)}\\n${replacement}\\n${content.slice(end)}`;\n1107: }\n1108: \n1109: // The command a reader can type for an entry: a doctor bridge runs under the\n1110: // runnable its manifest names, while a metadata command is typed as declared.\n1111: function entryRunnable(entry) {\n1112:   const doctor = DOCTOR_DETAILS.get(entry.id);\n1113:   return doctor ? doctor.runnable : entry.command;\n1114: }\n1115: \n1116: // A runnable names its target after the command, so the policy is read from the\n1117: // same string the reader types. A command typed alone takes its route-null\n1118: // record when one exists. A command with several routes and no route-null\n1119: // record offers no way to narrow the run, so the strictest route decides.\n1120: function runnablePolicy(runnable, policies) {\n1121:   const space = runnable.indexOf(' ');\n1122:   const command = space === -1 ? runnable : runnable.slice(0, space);\n1123:   const target = space === -1 ? null : runnable.slice(space + 1);\n1124:   const records = policies.filter((record) => record.command === command);\n1125:   if (records.length === 0) {\n1126:     throw new Error(`[command-bridges] No policy record for ${runnable}`);\n1127:   }\n1128:   if (target !== null) {\n1129:     const match = records.find((record) => record.route === target);\n1130:     if (!match) {\n1131:       throw new Error(`[command-bridges] No policy record for ${runnable}`);\n1132:     }\n1133:     return match.policy;\n1134:   }\n1135:   const bare = records.find((record) => record.route === null);\n1136:   if (bare) return bare.policy;\n1137:   return records.reduce((strictest, record) => (\n1138:     POLICY_STRICTNESS.indexOf(record.policy) > POLICY_STRICTNESS.indexOf(strictest)\n1139:       ? record.policy\n1140:       : strictest\n1141:   ), 'run');\n1142: }\n1143: \n1144: // Every id a scorer can return gets a row, because the reader sees whichever id\n1145: // the active runtime produced. The two runtime ids and the inventory id can all\n1146: // differ, so all three are emitted and an id repeated within one entry collapses\n1147: // to a single row.\n1148: function renderCommandRows(entries, policies) {\n1149:   const rows = new Map();\n1150:   const runnablePolicies = new Map();\n1151:   for (const entry of entries) {\n1152:     const { typescript, python } = entry.runtime;\n1153:     if (!typescript.enabled && !python.enabled) continue;\n1154:     const runnable = entryRunnable(entry);\n1155:     const policy = runnablePolicy(runnable, policies);\n1156:     runnablePolicies.set(runnable, policy);\n1157:     const ids = new Set([entry.id]);\n1158:     if (typescript.enabled) ids.add(typescript.id);\n1159:     if (python.enabled) ids.add(python.id);\n1160:     const row = { command: runnable, policy, ownerSkillId: entry.skillId };\n1161:     for (const id of ids) {\n1162:       const previous = rows.get(id);\n1163:       if (previous && previous !== row) {\n1164:         throw new Error(`[command-bridges] Duplicate command row id ${id}`);\n1165:       }\n1166:       rows.set(id, row);\n1167:     }\n1168:   }\n1169:   const rowLines = [...rows.entries()]\n1170:     .sort(([left], [right]) => left.localeCompare(right))\n1171:     .map(([id, row]) => (\n1172:       `  ${tsString(id)}: { command: ${tsString(row.command)}, policy: ${tsString(row.policy)}, `\n1173:         + `ownerSkillId: ${tsString(row.ownerSkillId)} },`\n1174:     ));\n1175:   const policyLines = [...runnablePolicies.entries()]\n1176:     .sort(([left], [right]) => left.localeCompare(right))\n1177:     .map(([runnable, policy]) => `  ${tsString(runnable)}: ${tsString(policy)},`);\n1178:   return [\n1179:     'export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {',\n1180:     ...rowLines,\n1181:     '};',\n1182:     \"export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\",\n1183:     ...policyLines,\n1184:     '};',\n1185:   ].join('\\n');\n1186: }\n1187: \n1188: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1189: // records arrive already ordered so the block is byte-identical between runs.\n1190: function renderModeCommands(records) {\n1191:   const lines = [\n1192:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1193:   ];\n1194:   let hubId = null;\n1195:   for (const record of records) {\n1196:     if (record.hubId !== hubId) {\n1197:       if (hubId !== null) lines.push('  },');\n1198:       hubId = record.hubId;\n1199:       lines.push(`  ${tsString(hubId)}: {`);\n1200:     }\n1201:     lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n1202:   }\n1203:   if (hubId !== null) lines.push('  },');\n1204:   lines.push('};');\n1205:   return lines.join('\\n');\n1206: }\n1207: \n1208: function generatedSources(entries, pythonOwnerNormalization, modeCommands, policies) {\n1209:   const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1210:   const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1211:   const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n1212:   // Two blocks share this file, so the second replacement starts from the first\n1213:   // one's output rather than the file on disk, or one block would overwrite the\n1214:   // other's fresh render.\n1215:   const commandAttachWithRows = replaceMarkedBlock(\n1216:     commandAttach,\n1217:     COMMAND_ROWS_GENERATED_START,\n1218:     COMMAND_ROWS_GENERATED_END,\n1219:     renderCommandRows(entries, policies),\n1220:     COMMAND_ATTACH_PATH,\n1221:   );\n1222:   return [\n1223:     {\n1224:       path: TS_PROJECTION_PATH,\n1225:       current: typescript,\n1226:       next: replaceMarkedBlock(\n1227:         typescript,\n1228:         TS_GENERATED_START,\n1229:         TS_GENERATED_END,\n1230:         renderTypescriptProjection(entries),\n1231:         TS_PROJECTION_PATH,\n1232:       ),\n1233:     },\n1234:     {\n1235:       path: PY_ADVISOR_PATH,\n1236:       current: python,\n1237:       next: replaceMarkedBlock(\n1238:         python,\n1239:         PY_GENERATED_START,\n1240:         PY_GENERATED_END,\n1241:         renderPythonProjection(entries, pythonOwnerNormalization),\n1242:         PY_ADVISOR_PATH,\n1243:       ),\n1244:     },\n1245:     {\n1246:       path: COMMAND_ATTACH_PATH,\n1247:       current: commandAttach,\n1248:       next: replaceMarkedBlock(\n1249:         commandAttachWithRows,\n1250:         COMMAND_ATTACH_GENERATED_START,\n1251:         COMMAND_ATTACH_GENERATED_END,\n1252:         renderModeCommands(modeCommands),\n1253:         COMMAND_ATTACH_PATH,\n1254:       ),\n1255:     },\n1256:   ];\n1257: }\n1258: \n1259: // ───────────────────────────────────────────────────────────────────\n1260: // 4. CORE LOGIC\n1261: // ───────────────────────────────────────────────────────────────────\n1262: \n1263: function main() {\n1264:   // CLI-only rejection: requiring this module (for example from tests) must\n1265:   // not exit on arguments belonging to the host process.\n1266:   if (require.main === module) {\n1267:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1268:     if (unknownArg !== undefined) {\n1269:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1270:       console.error('usage: derive-command-bridges.cjs [--check]');\n1271:       process.exit(2);\n1272:     }\n1273:   }\n1274:   const checkOnly = process.argv.includes('--check');\n1275:   const metadata = metadataEntries();\n1276:   const doctor = doctorRouteEntries();\n1277:   const tree = commandTreeNames();\n1278:   const metadataRisk = metadataRiskRecords();\n1279:   const doctorRisk = doctorRiskRecords();\n1280:   const modeCommands = modeCommandRecords();\n1281:   const violations = identityViolations({\n1282:     treeCommands: tree,\n1283:     metadataCommands: metadataRisk.map((record) => record.command),\n1284:     doctorCommands: doctorRisk.map((record) => record.command),\n1285:   });\n1286:   if (violations.length > 0) {\n1287:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1288:   }\n1289:   const inventory = [...metadata, ...doctor]\n1290:     .sort((left, right) => left.id.localeCompare(right.id));\n1291:   assertUniqueIds(inventory);\n1292:   const compatibility = runtimeCompatibility(inventory, metadata);\n1293:   const entries = inventory.map((entry) => {\n1294:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1295:     const typescript = compatibility.typescript.get(entry.id);\n1296:     const python = compatibility.python.get(entry.id);\n[Output truncated. Continue reading with offset: 1297]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1-1296\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Derive Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: const { existsSync, readFileSync, readdirSync, writeFileSync } = require('node:fs');\n12: const { join, relative, resolve, sep } = require('node:path');\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: \n18: const COMMAND_BRIDGES_DIR = __dirname;\n19: const REPO_ROOT = resolve(COMMAND_BRIDGES_DIR, '../../../../../..');\n20: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n21: // One folder per command group, one Markdown file per command: the tree the\n22: // inventory identity check reads.\n23: const COMMANDS_ROOT = join(REPO_ROOT, '.skilled', 'commands');\n24: const DOCTOR_COMMANDS_DIR = join(COMMANDS_ROOT, 'doctor');\n25: const DOCTOR_ROUTES_PATH = join(DOCTOR_COMMANDS_DIR, '_routes.yaml');\n26: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n27: const OUTPUT_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n28: const TS_PROJECTION_PATH = join(\n29:   SKILLS_ROOT,\n30:   'system-skill-advisor',\n31:   'runtime',\n32:   'lib',\n33:   'scorer',\n34:   'projection.ts',\n35: );\n36: const PY_ADVISOR_PATH = join(\n37:   SKILLS_ROOT,\n38:   'system-skill-advisor',\n39:   'runtime',\n40:   'scripts',\n41:   'skill_advisor.py',\n42: );\n43: const TS_GENERATED_START = '// BEGIN GENERATED COMMAND BRIDGES';\n44: const TS_GENERATED_END = '// END GENERATED COMMAND BRIDGES';\n45: const PY_GENERATED_START = '# BEGIN GENERATED COMMAND BRIDGES';\n46: const PY_GENERATED_END = '# END GENERATED COMMAND BRIDGES';\n47: const DOCTOR_PREFIX = 'command-doctor-';\n48: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n49: \n50: // Closed vocabularies: an unrecognised value has to fail loudly, because a\n51: // silent fallthrough would hand a mutating command the read-only policy (or the\n52: // reverse) and nothing downstream would notice.\n53: const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n54: const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n55: const WRITE_SCOPES = ['spec-folder'];\n56: // A command with several routes and no target typed answers for its strictest\n57: // route, because the reader gave the bridge no way to narrow the run.\n58: const POLICY_STRICTNESS = ['run', 'start', 'ask'];\n59: // A lead phrase outranks a passing skill, which is only safe when the prompt asks\n60: // about the state of something. A phrase that names no state or health word could\n61: // outrank the skill on an ordinary task, so it belongs only on a route that\n62: // already asks before it runs.\n63: const LEAD_PHRASE_STATE_WORDS = [\n64:   'check',\n65:   'state',\n66:   'status',\n67:   'report',\n68:   'health',\n69:   'off',\n70:   'on',\n71:   'which',\n72:   'show',\n73:   'list',\n74:   'inventory',\n75:   'drift',\n76:   'stale',\n77:   'missing',\n78:   'failing',\n79:   'broken',\n80: ];\n81: const COMMAND_ATTACH_PATH = join(\n82:   SKILLS_ROOT,\n83:   'system-skill-advisor',\n84:   'runtime',\n85:   'lib',\n86:   'command-attach.ts',\n87: );\n88: const COMMAND_ATTACH_GENERATED_START = '// BEGIN GENERATED MODE COMMANDS';\n89: const COMMAND_ATTACH_GENERATED_END = '// END GENERATED MODE COMMANDS';\n90: const COMMAND_ROWS_GENERATED_START = '// BEGIN GENERATED COMMAND ROWS';\n91: const COMMAND_ROWS_GENERATED_END = '// END GENERATED COMMAND ROWS';\n92: \n93: // Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n94: // The inventory entries keep their five-key shape; the projection merge reads here.\n95: const DOCTOR_DETAILS = new Map();\n96: \n97: // Meaning text per command, taken from the metadata record that already states\n98: // what the command does in the words a person uses.\n99: const METADATA_MEANING = new Map();\n100: \n101: // ───────────────────────────────────────────────────────────────────\n102: // 3. HELPERS\n103: // ───────────────────────────────────────────────────────────────────\n104: \n105: function readJson(filePath) {\n106:   try {\n107:     return JSON.parse(readFileSync(filePath, 'utf8'));\n108:   } catch (error) {\n109:     throw new Error(`[command-bridges] Failed to read JSON ${filePath}: ${error.message}`);\n110:   }\n111: }\n112: \n113: function bridgeId(command) {\n114:   if (!/^\\/[a-z][a-z0-9-]*:[a-z0-9-]+$/.test(command)) {\n115:     throw new Error(`[command-bridges] Invalid command id: ${command}`);\n116:   }\n117:   return `command-${command.slice(1).replace(':', '-')}`;\n118: }\n119: \n120: function sourcePath(filePath) {\n121:   return relative(REPO_ROOT, filePath).split(sep).join('/');\n122: }\n123: \n124: function metadataEntries(skillsRoot = SKILLS_ROOT) {\n125:   METADATA_MEANING.clear();\n126:   const entries = [];\n127:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n128:     // A private skill is local to one checkout and must never reach a tracked bridge file.\n129:     // Only a private skill may be a link, so any other linked folder is not a skill source.\n130:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n131:     .map((entry) => entry.name)\n132:     .sort();\n133:   for (const skillId of skillIds) {\n134:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n135:     if (!existsSync(filePath)) continue;\n136: \n137:     // A skill with no mode registry has no hub to route its commands, so its\n138:     // metadata is the whole declaration of what each command reaches.\n139:     const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n140:     const metadata = readJson(filePath);\n141:     if (!Array.isArray(metadata)) {\n142:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n143:     }\n144:     for (const [index, entry] of metadata.entries()) {\n145:       if (!entry || typeof entry !== 'object') {\n146:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n147:       }\n148:       const { command, ownerMode } = entry;\n149:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n150:         throw new Error(\n151:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n152:         );\n153:       }\n154:       const description = entry.description === undefined ? '' : entry.description;\n155:       if (typeof description !== 'string') {\n156:         throw new Error(\n157:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n158:         );\n159:       }\n160:       // The phrases a person types instead of the command are declared once, in\n161:       // the metadata, so the bridge reads them here instead of restating them.\n162:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n163:         ? stringArray(\n164:           entry.userIntent.ownedSignals,\n165:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n166:         )\n167:         : [];\n168:       // The job is prose about the outcome a person wants, so it describes the\n169:       // command in words none of the identifiers do. An absent job is a record\n170:       // that says less, not a broken one.\n171:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n172:         ? entry.userIntent.job\n173:         : '';\n174:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n175:       entries.push({\n176:         id: bridgeId(command),\n177:         command,\n178:         skillId,\n179:         ownerMode,\n180:         description,\n181:         ownedSignals: [...ownedSignals],\n182:         standalone,\n183:         mutating: entry.mutating,\n184:         source: sourcePath(filePath),\n185:       });\n186:     }\n187:   }\n188:   return entries;\n189: }\n190: \n191: function doctorSkillAgent(name) {\n192:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n193:   const tag = existsSync(routerPath)\n194:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n195:     : null;\n196:   if (!tag) {\n197:     throw new Error(\n198:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n199:         + 'a doctor bridge needs its owning skill',\n200:     );\n201:   }\n202:   return tag[1];\n203: }\n204: \n205: // A router names its own purpose in the frontmatter sentence a person reads\n206: // before anything else, so the bridge embeds that sentence rather than a second\n207: // copy written for the scorer to drift from.\n208: function doctorCommandDescription(name) {\n209:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n210:   const match = existsSync(routerPath)\n211:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n212:     : null;\n213:   // Required lazily for the same reason as the route manifest: an\n214:   // argument-rejecting run must exit before this module needs a YAML parser.\n215:   const YAML = require('yaml');\n216:   let frontmatter = null;\n217:   if (match) {\n218:     try {\n219:       frontmatter = YAML.parse(match[1]);\n220:     } catch (error) {\n221:       throw new Error(\n222:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n223:       );\n224:     }\n225:   }\n226:   const description = frontmatter && frontmatter.description;\n227:   if (typeof description !== 'string' || !description.trim()) {\n228:     throw new Error(\n229:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n230:         + 'a doctor bridge needs the sentence it embeds',\n231:     );\n232:   }\n233:   return description.trim();\n234: }\n235: \n236: function doctorCommandName(command, label) {\n237:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n238:   if (!match) {\n239:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n240:   }\n241:   return match[1];\n242: }\n243: \n244: function doctorRouteEntries() {\n245:   DOCTOR_DETAILS.clear();\n246:   // Required lazily: an argument-rejecting run must exit before this module\n247:   // ever needs a YAML parser.\n248:   const YAML = require('yaml');\n249:   let manifest;\n250:   try {\n251:     manifest = YAML.parse(readFileSync(DOCTOR_ROUTES_PATH, 'utf8'));\n252:   } catch (error) {\n253:     throw new Error(\n254:       `[command-bridges] Failed to read ${sourcePath(DOCTOR_ROUTES_PATH)}: ${error.message}`,\n255:     );\n256:   }\n257:   const routes = manifest && manifest.routes;\n258:   if (!Array.isArray(routes)) {\n259:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n260:   }\n261:   const names = routes.map((route, index) => (\n262:     doctorCommandName(route.command, `_routes.yaml routes[${index}]`)\n263:   ));\n264:   const totals = new Map();\n265:   for (const name of names) {\n266:     totals.set(name, (totals.get(name) || 0) + 1);\n267:   }\n268: \n269:   const entries = [];\n270:   routes.forEach((route, index) => {\n271:     const label = `_routes.yaml routes[${index}]`;\n272:     if (typeof route.target !== 'string' || !route.target) {\n273:       throw new Error(`[command-bridges] ${label} requires a non-empty string target`);\n274:     }\n275:     // A command with several targets needs one bridge per target; a\n276:     // single-target command takes the command's own id.\n277:     const multiTarget = totals.get(names[index]) > 1;\n278:     const id = multiTarget\n279:       ? `command-doctor-${names[index]}-${route.target}`\n280:       : `command-doctor-${names[index]}`;\n281:     const skillId = doctorSkillAgent(names[index]);\n282:     const phrases = stringArray(route.trigger_phrases, `${label}.trigger_phrases`);\n283:     const leadPhrases = doctorLeadPhrases(route, label, phrases);\n284:     DOCTOR_DETAILS.set(id, {\n285:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n286:       bareCommand: doctorDefaultTarget(route, label, multiTarget),\n287:       description: doctorCommandDescription(names[index]),\n288:       phrases,\n289:       leadPhrases,\n290:       readOnly: isReadOnlyRoute(route),\n291:     });\n292:     entries.push({\n293:       id,\n294:       command: route.command,\n295:       skillId,\n296:       ownerMode: skillId,\n297:       source: sourcePath(DOCTOR_ROUTES_PATH),\n298:     });\n299:   });\n300: \n301:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n302:   if (!Array.isArray(standalone)) {\n303:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n304:   }\n305:   standalone.forEach((item, index) => {\n306:     if (!item || typeof item !== 'object') return;\n307:     const label = `_routes.yaml standalone[${index}]`;\n308:     const phrases = Object.prototype.hasOwnProperty.call(item, 'trigger_phrases')\n309:       ? stringArray(item.trigger_phrases, `${label}.trigger_phrases`)\n310:       : [];\n311:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n312:     if (typeof item.command !== 'string') return;\n313:     const name = doctorCommandName(item.command, label);\n314:     const skillId = doctorSkillAgent(name);\n315:     const runnable = typeof item.runnable === 'string' && item.runnable\n316:       ? item.runnable\n317:       : item.command;\n318:     DOCTOR_DETAILS.set(`command-doctor-${name}`, {\n319:       runnable,\n320:       description: doctorCommandDescription(name),\n321:       phrases,\n322:       leadPhrases,\n323:       readOnly: isReadOnlyRoute(item),\n324:     });\n325:     entries.push({\n326:       id: `command-doctor-${name}`,\n327:       command: item.command,\n328:       skillId,\n329:       ownerMode: skillId,\n330:       source: sourcePath(DOCTOR_ROUTES_PATH),\n331:     });\n332:   });\n333: \n334:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n335:   if (!Array.isArray(mcpSubroutes)) {\n336:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n337:   }\n338:   mcpSubroutes.forEach((item, index) => {\n339:     const label = `_routes.yaml mcp_subroutes[${index}]`;\n340:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) {\n341:       throw new Error(`[command-bridges] ${label} requires a non-empty string sub_action`);\n342:     }\n343:     const commandName = doctorCommandName(DOCTOR_MCP_COMMAND, label);\n344:     const skillId = doctorSkillAgent(commandName);\n345:     const id = `${DOCTOR_PREFIX}${commandName}-${item.sub_action}`;\n346:     const runnable = `${DOCTOR_MCP_COMMAND} ${item.sub_action}`;\n347:     const phrases = stringArray(item.trigger_phrases, `${label}.trigger_phrases`);\n348:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n349:     DOCTOR_DETAILS.set(id, {\n350:       runnable,\n351:       description: doctorCommandDescription(commandName),\n352:       phrases,\n353:       leadPhrases,\n354:       readOnly: isReadOnlyRoute(item),\n355:     });\n356:     entries.push({\n357:       id,\n358:       command: DOCTOR_MCP_COMMAND,\n359:       skillId,\n360:       ownerMode: skillId,\n361:       source: sourcePath(DOCTOR_ROUTES_PATH),\n362:     });\n363:   });\n364: \n365:   return entries;\n366: }\n367: \n368: // A command exists when its router file exists: the folder directly under the\n369: // commands root names the group and a Markdown file inside it names the action.\n370: // A README and a .contract.md describe a command instead of being one, a file\n371: // directly in the root names no command at all, and a local- name belongs to a\n372: // single checkout, so none of them count.\n373: function commandTreeNames(commandsRoot = COMMANDS_ROOT) {\n374:   const commands = [];\n375:   const groups = readdirSync(commandsRoot, { withFileTypes: true })\n376:     .filter((entry) => entry.isDirectory() && !entry.name.startsWith('local-'))\n377:     .map((entry) => entry.name)\n378:     .sort();\n379:   for (const group of groups) {\n380:     const files = readdirSync(join(commandsRoot, group), { withFileTypes: true })\n381:       .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n382:       .filter((entry) => (\n383:         entry.name !== 'README.md'\n384:         && !entry.name.endsWith('.contract.md')\n385:         && !entry.name.startsWith('local-')\n386:       ))\n387:       .map((entry) => `/${group}:${entry.name.slice(0, -'.md'.length)}`);\n388:     commands.push(...files);\n389:   }\n390:   return commands.sort();\n391: }\n392: \n393: // A hub's mode registry is the only place that pairs a workflow mode with the\n394: // command that runs it, so the reader's reverse lookup is derived from the hubs\n395: // themselves rather than transcribed into the consumer and left to drift.\n396: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n397:   const commandNames = new Set(commandTreeNames(commandsRoot));\n398:   const records = [];\n399:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n400:     // The same skill folders as the bridge metadata, for the same reason: a\n401:     // private skill is local to one checkout and a linked folder is not a skill\n402:     // source.\n403:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n404:     .map((entry) => entry.name)\n405:     .sort();\n406:   for (const hubId of hubIds) {\n407:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n408:     if (!existsSync(filePath)) continue;\n409: \n410:     const registry = readJson(filePath);\n411:     const modes = registry && registry.modes;\n412:     if (!Array.isArray(modes)) {\n413:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n414:     }\n415:     const seen = new Set();\n416:     for (const [index, mode] of modes.entries()) {\n417:       const label = `${sourcePath(filePath)} modes[${index}]`;\n418:       const workflowMode = mode && mode.workflowMode;\n419:       if (typeof workflowMode !== 'string' || !workflowMode) {\n420:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n421:       }\n422:       // One key per hub: a repeated workflow mode would leave the lookup holding\n423:       // whichever row the table happened to keep, so the registry has to say it\n424:       // once.\n425:       if (seen.has(workflowMode)) {\n426:         throw new Error(\n427:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n428:         );\n429:       }\n430:       seen.add(workflowMode);\n431: \n432:       const { command } = mode;\n433:       // A null command is a mode with no dedicated slash command, which is a\n434:       // declared state rather than a mistake, so it contributes no row.\n435:       if (typeof command !== 'string' || !command) continue;\n436:       // A command with no router file is one the reader cannot type, so naming\n437:       // it here would promise a surface that does not exist.\n438:       if (!commandNames.has(command)) {\n439:         throw new Error(\n440:           `[command-bridges] ${label} names ${command}, which has no command file`,\n441:         );\n442:       }\n443:       records.push({ hubId, workflowMode, command });\n444:     }\n445:   }\n446:   // The generated file is compared byte for byte, so the order has to be total.\n447:   return records.sort((left, right) => (\n448:     left.hubId === right.hubId\n449:       ? left.workflowMode.localeCompare(right.workflowMode)\n450:       : left.hubId.localeCompare(right.hubId)\n451:   ));\n452: }\n453: \n454: // The policy ladder reads only these keys, so a wrong value has to fail here\n455: // rather than fall through to a branch that merely looks safe.\n456: function validateRiskKeys(record, label, requireTarget = false) {\n457:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n458:     throw new Error(\n459:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n460:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n461:     );\n462:   }\n463:   if (record.ask_first !== undefined) {\n464:     const askFirst = record.ask_first;\n465:     if (!Array.isArray(askFirst) || askFirst.some((value) => !ASK_FIRST_REASONS.includes(value))) {\n466:       throw new Error(\n467:         `[command-bridges] ${label} has ask_first ${JSON.stringify(askFirst)}; `\n468:           + `expected an array of ${ASK_FIRST_REASONS.join(', ')}`,\n469:       );\n470:     }\n471:   }\n472:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n473:     throw new Error(\n474:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n475:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n476:     );\n477:   }\n478:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n479:     throw new Error(\n480:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n481:     );\n482:   }\n483: }\n484: \n485: // One policy per command, decided from the risk keys alone so the answer never\n486: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n487: // that mutates asks because its repair is the operator's call, and only a\n488: // read-only route or an add-only route confined to the spec folder may run\n489: // unprompted. Everything else starts as an ordinary task.\n490: function derivePolicy(record) {\n491:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n492:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n493:   if (record.mutating === 'read-only') return 'run';\n494:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n495:   return 'start';\n496: }\n497: \n498: // The same skill folders as the bridge metadata, for the same reason: a private\n499: // skill is local to a checkout and a linked folder is not a skill source. A\n500: // metadata command is reachable by typing its name, so it must also name where\n501: // its writes land before its policy may be derived.\n502: function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n503:   const records = [];\n504:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n505:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n506:     .map((entry) => entry.name)\n507:     .sort();\n508:   for (const skillId of skillIds) {\n509:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n510:     if (!existsSync(filePath)) continue;\n511:     const metadata = readJson(filePath);\n512:     if (!Array.isArray(metadata)) {\n513:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n514:     }\n515:     for (const [index, entry] of metadata.entries()) {\n516:       if (!entry || typeof entry !== 'object') {\n517:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n518:       }\n519:       validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n520:       records.push({\n521:         command: entry.command,\n522:         route: null,\n523:         mutating: entry.mutating,\n524:         ask_first: entry.ask_first || [],\n525:         write_scope: entry.write_scope,\n526:         doctor: false,\n527:       });\n528:     }\n529:   }\n530:   return records;\n531: }\n532: \n533: // The manifest is the doctor half of the same surface. Requiring YAML lazily\n534: // keeps an argument-rejecting run from ever loading a parser.\n535: function doctorRiskRecords(routesPath = DOCTOR_ROUTES_PATH) {\n536:   const YAML = require('yaml');\n537:   let manifest;\n538:   try {\n539:     manifest = YAML.parse(readFileSync(routesPath, 'utf8'));\n540:   } catch (error) {\n541:     throw new Error(\n542:       `[command-bridges] Failed to read ${sourcePath(routesPath)}: ${error.message}`,\n543:     );\n544:   }\n545: \n546:   const records = [];\n547:   const addRecord = (fields, label) => {\n548:     const record = {\n549:       command: fields.command,\n550:       route: fields.route,\n551:       mutating: fields.mutating,\n552:       ask_first: fields.ask_first || [],\n553:       write_scope: fields.write_scope,\n554:       doctor: true,\n555:     };\n556:     validateRiskKeys(record, label);\n557:     records.push(record);\n558:   };\n559: \n560:   const routes = manifest && manifest.routes;\n561:   if (!Array.isArray(routes)) {\n562:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n563:   }\n564:   routes.forEach((route, index) => {\n565:     addRecord({\n566:       command: route.command,\n567:       route: route.target,\n568:       mutating: route.mutating,\n569:       ask_first: route.ask_first,\n570:       write_scope: route.write_scope,\n571:     }, `${sourcePath(routesPath)} routes[${index}]`);\n572:   });\n573: \n574:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n575:   if (!Array.isArray(mcpSubroutes)) {\n576:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n577:   }\n578:   mcpSubroutes.forEach((item, index) => {\n579:     addRecord({\n580:       command: DOCTOR_MCP_COMMAND,\n581:       route: item?.sub_action,\n582:       mutating: item?.mutating,\n583:       ask_first: item?.ask_first,\n584:       write_scope: item?.write_scope,\n585:     }, `${sourcePath(routesPath)} mcp_subroutes[${index}]`);\n586:   });\n587: \n588:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n589:   if (!Array.isArray(standalone)) {\n590:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n591:   }\n592:   standalone.forEach((item, index) => {\n593:     if (!item || typeof item.command !== 'string') return;\n594:     const label = `${sourcePath(routesPath)} standalone[${index}]`;\n595:     const actions = item.actions;\n596:     // One command, several actions: the action carries the class because the\n597:     // bare command name cannot say what the run will do.\n598:     if (actions && typeof actions === 'object' && !Array.isArray(actions)) {\n599:       for (const [action, entry] of Object.entries(actions)) {\n600:         addRecord({\n601:           command: item.command,\n602:           route: action,\n603:           mutating: entry?.mutating,\n604:           ask_first: entry?.ask_first,\n605:           write_scope: entry?.write_scope,\n606:         }, `${label}.actions.${action}`);\n607:       }\n608:       return;\n609:     }\n610:     addRecord({\n611:       command: item.command,\n612:       route: null,\n613:       mutating: item.mutating,\n614:       ask_first: item.ask_first,\n615:       write_scope: item.write_scope,\n616:     }, label);\n617:   });\n618: \n619:   return records;\n620: }\n621: \n622: // Three views of one surface. A name in the tree that neither declaration\n623: // carries is a command nothing can suggest; a declared name with no file is a\n624: // bridge to a command the operator cannot type. Either way the inventory lies,\n625: // so both directions are reported together.\n626: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n627:   const tree = new Set(treeCommands);\n628:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n629:   const violations = [];\n630:   for (const command of tree) {\n631:     if (!declared.has(command)) {\n632:       violations.push(\n633:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n634:       );\n635:     }\n636:   }\n637:   for (const command of declared) {\n638:     if (!tree.has(command)) {\n639:       violations.push(\n640:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n641:       );\n642:     }\n643:   }\n644:   return violations.sort();\n645: }\n646: \n647: // The generated file is compared byte for byte, so the order has to be total:\n648: // command name first, then the bare route before its named ones.\n649: function commandPolicies(skillsRoot, routesPath) {\n650:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n651:     .map((record) => ({\n652:       command: record.command,\n653:       route: record.route,\n654:       mutating: record.mutating,\n655:       askFirst: record.ask_first,\n656:       policy: derivePolicy(record),\n657:     }))\n658:     .sort((left, right) => {\n659:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n660:       if (left.route === right.route) return 0;\n661:       if (left.route === null) return -1;\n662:       if (right.route === null) return 1;\n663:       return left.route.localeCompare(right.route);\n664:     });\n665: }\n666: \n667: function assertUniqueIds(entries) {\n668:   const seen = new Map();\n669:   for (const entry of entries) {\n670:     const previous = seen.get(entry.id);\n671:     if (previous) {\n672:       throw new Error(\n673:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n674:       );\n675:     }\n676:     seen.set(entry.id, entry);\n677:   }\n678: }\n679: \n680: function stringArray(value, label) {\n681:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n682:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n683:   }\n684:   return value;\n685: }\n686: \n687: // A vector has to describe the job a command does, so the slash form is dropped\n688: // before the text is built. A name left in would hand the scorer a second copy\n689: // of the token it already matches literally.\n690: function commandEmbeddingText({ description, job, ownedSignals }) {\n691:   // Each part is cleaned before the join: a part that was only a slash command,\n692:   // or one that already ends in a full stop, would otherwise leave stray\n693:   // punctuation in text whose only reader is an embedder.\n694:   // A prompt is written in the asker's voice, and so are the job sentence and\n695:   // the owned phrases. The description is written in the command's voice and\n696:   // carries mode and step notes no asker types, so it stands in only when a\n697:   // record states no job.\n698:   const lead = typeof job === 'string' && job.trim() ? job : description;\n699:   return [lead, ...ownedSignals]\n700:     .filter((part) => typeof part === 'string')\n701:     .map((part) => part\n702:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n703:       .replace(/\\s+/g, ' ')\n704:       .trim()\n705:       .replace(/[.\\s]+$/, ''))\n706:     .filter(Boolean)\n707:     .join('. ');\n708: }\n709: \n710: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n711: // depends on the row: a metadata row states it in its own record, while a doctor\n712: // row states it in the router sentence and the route phrases it already declares.\n713: function entryMeaning(entryId, command, isDoctor) {\n714:   if (!isDoctor) return METADATA_MEANING.get(command);\n715:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n716:   return { description, ownedSignals: phrases };\n717: }\n718: \n719: // Only a route the manifest classes as read-only may answer a list or show\n720: // question; add-only and mutating routes keep the read-only confidence floor.\n721: function isReadOnlyRoute(item) {\n722:   return item.mutating === 'read-only';\n723: }\n724: \n725: // A command with several targets runs only as `<command> <target>`, yet its router binds one\n726: // target when none is typed. A route marked default_target also answers the bare command, so\n727: // the typed command alone still reaches a bridge.\n728: function doctorDefaultTarget(route, label, multiTarget) {\n729:   if (!Object.prototype.hasOwnProperty.call(route, 'default_target')) return null;\n730:   if (typeof route.default_target !== 'boolean') {\n731:     throw new Error(`[command-bridges] ${label}.default_target must be a boolean`);\n732:   }\n733:   if (!route.default_target) return null;\n734:   if (!multiTarget) {\n735:     throw new Error(\n736:       `[command-bridges] ${label}.default_target is only valid on a command with several targets`,\n737:     );\n738:   }\n739:   return route.command;\n740: }\n741: \n742: // A lead phrase is matched against the whole prompt, so the state word has to be\n743: // a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n744: // nothing about state.\n745: function hasStateWord(phrase) {\n746:   return phrase\n747:     .toLowerCase()\n748:     .split(/[^a-z0-9]+/)\n749:     .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n750: }\n751: \n752: // A route that asks first may lead with a phrase that names no state or health\n753: // word, because the ask already keeps the run behind a decision.\n754: function doctorLeadPhrases(item, label, triggerPhrases) {\n755:   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n756:     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n757:     : [];\n758:   const asksFirst = derivePolicy({\n759:     doctor: true,\n760:     mutating: item.mutating,\n761:     ask_first: item.ask_first,\n762:     write_scope: item.write_scope,\n763:   }) === 'ask';\n764:   for (const phrase of leadPhrases) {\n765:     if (!triggerPhrases.includes(phrase)) {\n766:       throw new Error(\n767:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n768:       );\n769:     }\n770:     if (!asksFirst && !hasStateWord(phrase)) {\n771:       throw new Error(\n772:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n773:       );\n774:     }\n775:   }\n776:   return leadPhrases;\n777: }\n778: \n779: function compatibilityByInventoryId(entries, inventoryIds, platform) {\n780:   if (!Array.isArray(entries)) {\n781:     throw new Error(`[command-bridges] scoring-compatibility.json ${platform} must be an array`);\n782:   }\n783:   const byInventoryId = new Map();\n784:   const orders = new Set();\n785:   for (const [index, entry] of entries.entries()) {\n786:     if (!entry || typeof entry !== 'object') {\n787:       throw new Error(`[command-bridges] ${platform}[${index}] must be an object`);\n788:     }\n789:     const { inventoryId, order, id, description } = entry;\n790:     if (\n791:       typeof inventoryId !== 'string'\n792:       || !inventoryIds.has(inventoryId)\n793:       || !Number.isInteger(order)\n794:       || order < 0\n795:       || typeof id !== 'string'\n796:       || !id\n797:       || typeof description !== 'string'\n798:     ) {\n799:       throw new Error(\n800:         `[command-bridges] ${platform}[${index}] requires a known inventoryId, ` +\n801:           'non-negative integer order, id, and description',\n802:       );\n803:     }\n804:     if (byInventoryId.has(inventoryId)) {\n805:       throw new Error(`[command-bridges] Duplicate ${platform} inventoryId ${inventoryId}`);\n806:     }\n807:     if (orders.has(order)) {\n808:       throw new Error(`[command-bridges] Duplicate ${platform} order ${order}`);\n809:     }\n810:     const isDoctor = inventoryId.startsWith(DOCTOR_PREFIX);\n811:     if (isDoctor && id !== inventoryId) {\n812:       throw new Error(\n813:         `[command-bridges] ${platform}[${index}] doctor bridge id must equal its inventoryId`,\n814:       );\n815:     }\n816:     if (platform === 'typescript') {\n817:       if (!isDoctor) {\n818:         if (typeof entry.name !== 'string' || !entry.name) {\n819:           throw new Error(`[command-bridges] typescript[${index}] requires name`);\n820:         }\n821:         stringArray(entry.keywords, `typescript[${index}].keywords`);\n822:         stringArray(entry.domains, `typescript[${index}].domains`);\n823:         stringArray(entry.intentSignals, `typescript[${index}].intentSignals`);\n824:       }\n825:     } else {\n826:       if (!isDoctor) {\n827:         stringArray(entry.slashMarkers, `python[${index}].slashMarkers`);\n828:       }\n829:       if ('owningSkill' in entry && (typeof entry.owningSkill !== 'string' || !entry.owningSkill)) {\n830:         throw new Error(`[command-bridges] python[${index}].owningSkill must be a non-empty string`);\n831:       }\n832:       if ('deprecated' in entry && typeof entry.deprecated !== 'boolean') {\n833:         throw new Error(`[command-bridges] python[${index}].deprecated must be boolean`);\n834:       }\n835:     }\n836:     byInventoryId.set(inventoryId, entry);\n837:     orders.add(order);\n838:   }\n839:   return byInventoryId;\n840: }\n841: \n842: // A standalone skill has no hub registry, so the only record of what its\n843: // commands reach is its own metadata. The match is by command rather than by id\n844: // because one command can enter the inventory under a row that carries its own\n845: // historical id.\n846: function standaloneCommandRecords(entries, metadata) {\n847:   const byCommand = new Map();\n848:   for (const record of metadata) {\n849:     if (record.standalone) byCommand.set(record.command, record);\n850:   }\n851:   return entries\n852:     .filter((entry) => byCommand.has(entry.command))\n853:     .sort((left, right) => left.id.localeCompare(right.id))\n854:     .map((entry) => ({ entry, record: byCommand.get(entry.command) }));\n855: }\n856: \n857: // A generated row is the command's only reach, so one phrase would leave it\n858: // indistinguishable from every other command and the activation would claim a\n859: // surface the scorer cannot actually offer.\n860: function assertPlainChatSignals(records) {\n861:   for (const { entry, record } of records) {\n862:     if (record.ownedSignals.length < 2) {\n863:       throw new Error(\n864:         `[command-bridges] ${entry.command} needs at least two userIntent.ownedSignals `\n865:           + `in ${record.source}, found ${record.ownedSignals.length}`,\n866:       );\n867:     }\n868:   }\n869: }\n870: \n871: function commandNamespace(command) {\n872:   return command.slice(1, command.indexOf(':'));\n873: }\n874: \n875: // A standalone skill's commands are active by construction: the metadata already\n876: // names the phrases a person types, so a hand row would be a second copy left to\n877: // drift. A hand row still wins where one exists, because a curated row can carry\n878: // phrases the metadata cannot know. Orders start past the highest hand-written\n879: // one so a later hand row never has to renumber a generated one.\n880: function activateStandaloneCommands(byInventoryId, records, platform) {\n881:   let nextOrder = 0;\n882:   for (const row of byInventoryId.values()) {\n883:     nextOrder = Math.max(nextOrder, row.order + 1);\n884:   }\n885:   for (const { entry, record } of records) {\n886:     if (byInventoryId.has(entry.id)) continue;\n887:     byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n888:     nextOrder += 1;\n889:   }\n890: }\n891: \n892: function standaloneRuntimeRow(entry, record, order, platform) {\n893:   if (platform === 'typescript') {\n894:     return {\n895:       inventoryId: entry.id,\n896:       order,\n897:       id: entry.id,\n898:       name: entry.id,\n899:       description: record.description,\n900:       keywords: [...record.ownedSignals],\n901:       domains: [commandNamespace(entry.command), 'command'],\n902:       intentSignals: [...record.ownedSignals],\n903:       // The class decides this for every command, not only a doctor route.\n904:       ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\n905:     };\n906:   }\n907:   return {\n908:     inventoryId: entry.id,\n909:     order,\n910:     id: entry.id,\n911:     description: record.description,\n912:     slashMarkers: [entry.command, entry.command.slice(1)],\n913:     owningSkill: record.skillId,\n914:   };\n915: }\n916: \n917: function runtimeCompatibility(entries, metadata) {\n918:   const compatibility = readJson(COMPATIBILITY_PATH);\n919:   if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\n920:     throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\n921:   }\n922:   const inventoryIds = new Set(entries.map((entry) => entry.id));\n923:   const typescript = compatibilityByInventoryId(\n924:     compatibility.typescript,\n925:     inventoryIds,\n926:     'typescript',\n927:   );\n928:   const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\n929:   const standalone = standaloneCommandRecords(entries, metadata);\n930:   assertPlainChatSignals(standalone);\n931:   activateStandaloneCommands(typescript, standalone, 'typescript');\n932:   activateStandaloneCommands(python, standalone, 'python');\n933:   const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\n934:   if (\n935:     !pythonOwnerNormalization\n936:     || typeof pythonOwnerNormalization !== 'object'\n937:     || Array.isArray(pythonOwnerNormalization)\n938:     || Object.entries(pythonOwnerNormalization).some(\n939:       ([key, value]) => !key || typeof value !== 'string' || !value,\n940:     )\n941:   ) {\n942:     throw new Error(\n943:       '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\n944:     );\n945:   }\n946:   const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\n947:   for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\n948:     if (!activePythonIds.has(runtimeId)) {\n949:       throw new Error(\n950:         `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\n951:       );\n952:     }\n953:   }\n954:   return { typescript, python, pythonOwnerNormalization };\n955: }\n956: \n957: function tsString(value) {\n958:   return `'${value.replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"\\\\'\")}'`;\n959: }\n960: \n961: function tsArray(values) {\n962:   return `[${values.map((value) => tsString(value)).join(', ')}]`;\n963: }\n964: \n965: function doctorRuntime(entryId, platform, compat) {\n966:   const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n967:   if (platform === 'typescript') {\n968:     return {\n969:       ...compat,\n970:       name: runnable,\n971:       keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n972:       intentSignals: [runnable],\n973:       ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n974:       ...(readOnly ? { readOnly: true } : {}),\n975:       domains: ['doctor', 'command'],\n976:     };\n977:   }\n978:   return {\n979:     ...compat,\n980:     slashMarkers: bareCommand ? [runnable, bareCommand] : [runnable],\n981:     ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n982:   };\n983: }\n984: \n985: function runtimeOrdered(entries, platform) {\n986:   return [...entries].sort((left, right) => {\n987:     const leftRuntime = left.runtime[platform];\n988:     const rightRuntime = right.runtime[platform];\n989:     if (leftRuntime.enabled !== rightRuntime.enabled) {\n990:       return leftRuntime.enabled ? -1 : 1;\n991:     }\n992:     if (leftRuntime.enabled && rightRuntime.enabled) {\n993:       return leftRuntime.order - rightRuntime.order;\n994:     }\n995:     return left.id.localeCompare(right.id);\n996:   });\n997: }\n998: \n999: function renderTypescriptBridge(entry) {\n1000:   const runtime = entry.runtime.typescript;\n1001:   const active = runtime.enabled;\n1002:   const id = active ? runtime.id : entry.id;\n1003:   const name = active ? runtime.name : entry.id;\n1004:   const description = active ? runtime.description : '';\n1005:   const keywords = active ? runtime.keywords : [];\n1006:   const domains = active ? runtime.domains : [];\n1007:   const intentSignals = active ? runtime.intentSignals : [];\n1008:   const lines = [\n1009:     '  {',\n1010:     `    inventoryId: ${tsString(entry.id)},`,\n1011:     `    ownerSkill: ${tsString(entry.skillId)},`,\n1012:     `    routingEnabled: ${active},`,\n1013:     `    id: ${tsString(id)},`,\n1014:     \"    kind: 'command',\",\n1015:     \"    family: 'system',\",\n1016:     \"    category: 'command',\",\n1017:     `    name: ${tsString(name)},`,\n1018:     `    description: ${tsString(description)},`,\n1019:     `    keywords: ${tsArray(keywords)},`,\n1020:     `    domains: ${tsArray(domains)},`,\n1021:     `    intentSignals: ${tsArray(intentSignals)},`,\n1022:   ];\n1023:   if (active && runtime.leadPhrases?.length) {\n1024:     lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1025:   }\n1026:   if (active && runtime.readOnly === true) {\n1027:     lines.push('    readOnly: true,');\n1028:   }\n1029:   lines.push(\n1030:     '    derivedTriggers: [],',\n1031:     '    derivedKeywords: [],',\n1032:     '    sourcePath: null,',\n1033:     \"    lifecycleStatus: 'active',\",\n1034:     '  },',\n1035:   );\n1036:   return lines.join('\\n');\n1037: }\n1038: \n1039: function renderTypescriptProjection(entries) {\n1040:   const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1041:   return `export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\\n${body}\\n];`;\n1042: }\n1043: \n1044: function pythonString(value) {\n1045:   return JSON.stringify(value);\n1046: }\n1047: \n1048: function pythonList(values) {\n1049:   return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1050: }\n1051: \n1052: function renderPythonBridge(entry) {\n1053:   const runtime = entry.runtime.python;\n1054:   const active = runtime.enabled;\n1055:   const runtimeId = active ? runtime.id : entry.id;\n1056:   const description = active ? runtime.description : '';\n1057:   const slashMarkers = active ? runtime.slashMarkers : [entry.command];\n1058:   const lines = [\n1059:     `    ${pythonString(runtimeId)}: {`,\n1060:     `        \"description\": ${pythonString(description)},`,\n1061:     `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1062:   ];\n1063:   if (active && runtime.leadPhrases?.length) {\n1064:     lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1065:   }\n1066:   if (active && runtime.deprecated === true) {\n1067:     lines.push('        \"deprecated\": True,');\n1068:   }\n1069:   if (active && typeof runtime.owningSkill === 'string') {\n1070:     lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1071:   }\n1072:   lines.push(\n1073:     `        \"inventory_id\": ${pythonString(entry.id)},`,\n1074:     `        \"command\": ${pythonString(entry.command)},`,\n1075:     `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1076:     `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1077:     `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1078:     '    },',\n1079:   );\n1080:   return lines.join('\\n');\n1081: }\n1082: \n1083: function renderPythonProjection(entries, pythonOwnerNormalization) {\n1084:   const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1085:   const normalization = Object.entries(pythonOwnerNormalization)\n1086:     .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1087:     .join('\\n');\n1088:   return [\n1089:     'GENERATED_COMMAND_BRIDGES = {',\n1090:     body,\n1091:     '}',\n1092:     '',\n1093:     'GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {',\n1094:     normalization,\n1095:     '}',\n1096:   ].join('\\n');\n1097: }\n1098: \n1099: function replaceMarkedBlock(content, startMarker, endMarker, replacement, filePath) {\n1100:   const start = content.indexOf(startMarker);\n1101:   const end = content.indexOf(endMarker);\n1102:   if (start < 0 || end < 0 || end < start) {\n1103:     throw new Error(`[command-bridges] Missing generated markers in ${sourcePath(filePath)}`);\n1104:   }\n1105:   const bodyStart = start + startMarker.length;\n1106:   return `${content.slice(0, bodyStart)}\\n${replacement}\\n${content.slice(end)}`;\n1107: }\n1108: \n1109: // The command a reader can type for an entry: a doctor bridge runs under the\n1110: // runnable its manifest names, while a metadata command is typed as declared.\n1111: function entryRunnable(entry) {\n1112:   const doctor = DOCTOR_DETAILS.get(entry.id);\n1113:   return doctor ? doctor.runnable : entry.command;\n1114: }\n1115: \n1116: // A runnable names its target after the command, so the policy is read from the\n1117: // same string the reader types. A command typed alone takes its route-null\n1118: // record when one exists. A command with several routes and no route-null\n1119: // record offers no way to narrow the run, so the strictest route decides.\n1120: function runnablePolicy(runnable, policies) {\n1121:   const space = runnable.indexOf(' ');\n1122:   const command = space === -1 ? runnable : runnable.slice(0, space);\n1123:   const target = space === -1 ? null : runnable.slice(space + 1);\n1124:   const records = policies.filter((record) => record.command === command);\n1125:   if (records.length === 0) {\n1126:     throw new Error(`[command-bridges] No policy record for ${runnable}`);\n1127:   }\n1128:   if (target !== null) {\n1129:     const match = records.find((record) => record.route === target);\n1130:     if (!match) {\n1131:       throw new Error(`[command-bridges] No policy record for ${runnable}`);\n1132:     }\n1133:     return match.policy;\n1134:   }\n1135:   const bare = records.find((record) => record.route === null);\n1136:   if (bare) return bare.policy;\n1137:   return records.reduce((strictest, record) => (\n1138:     POLICY_STRICTNESS.indexOf(record.policy) > POLICY_STRICTNESS.indexOf(strictest)\n1139:       ? record.policy\n1140:       : strictest\n1141:   ), 'run');\n1142: }\n1143: \n1144: // Every id a scorer can return gets a row, because the reader sees whichever id\n1145: // the active runtime produced. The two runtime ids and the inventory id can all\n1146: // differ, so all three are emitted and an id repeated within one entry collapses\n1147: // to a single row.\n1148: function renderCommandRows(entries, policies) {\n1149:   const rows = new Map();\n1150:   const runnablePolicies = new Map();\n1151:   for (const entry of entries) {\n1152:     const { typescript, python } = entry.runtime;\n1153:     if (!typescript.enabled && !python.enabled) continue;\n1154:     const runnable = entryRunnable(entry);\n1155:     const policy = runnablePolicy(runnable, policies);\n1156:     runnablePolicies.set(runnable, policy);\n1157:     const ids = new Set([entry.id]);\n1158:     if (typescript.enabled) ids.add(typescript.id);\n1159:     if (python.enabled) ids.add(python.id);\n1160:     const row = { command: runnable, policy, ownerSkillId: entry.skillId };\n1161:     for (const id of ids) {\n1162:       const previous = rows.get(id);\n1163:       if (previous && previous !== row) {\n1164:         throw new Error(`[command-bridges] Duplicate command row id ${id}`);\n1165:       }\n1166:       rows.set(id, row);\n1167:     }\n1168:   }\n1169:   const rowLines = [...rows.entries()]\n1170:     .sort(([left], [right]) => left.localeCompare(right))\n1171:     .map(([id, row]) => (\n1172:       `  ${tsString(id)}: { command: ${tsString(row.command)}, policy: ${tsString(row.policy)}, `\n1173:         + `ownerSkillId: ${tsString(row.ownerSkillId)} },`\n1174:     ));\n1175:   const policyLines = [...runnablePolicies.entries()]\n1176:     .sort(([left], [right]) => left.localeCompare(right))\n1177:     .map(([runnable, policy]) => `  ${tsString(runnable)}: ${tsString(policy)},`);\n1178:   return [\n1179:     'export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {',\n1180:     ...rowLines,\n1181:     '};',\n1182:     \"export const COMMAND_POLICIES: Readonly<Record<string, 'run' | 'start' | 'ask'>> = {\",\n1183:     ...policyLines,\n1184:     '};',\n1185:   ].join('\\n');\n1186: }\n1187: \n1188: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1189: // records arrive already ordered so the block is byte-identical between runs.\n1190: function renderModeCommands(records) {\n1191:   const lines = [\n1192:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1193:   ];\n1194:   let hubId = null;\n1195:   for (const record of records) {\n1196:     if (record.hubId !== hubId) {\n1197:       if (hubId !== null) lines.push('  },');\n1198:       hubId = record.hubId;\n1199:       lines.push(`  ${tsString(hubId)}: {`);\n1200:     }\n1201:     lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n1202:   }\n1203:   if (hubId !== null) lines.push('  },');\n1204:   lines.push('};');\n1205:   return lines.join('\\n');\n1206: }\n1207: \n1208: function generatedSources(entries, pythonOwnerNormalization, modeCommands, policies) {\n1209:   const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1210:   const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1211:   const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n1212:   // Two blocks share this file, so the second replacement starts from the first\n1213:   // one's output rather than the file on disk, or one block would overwrite the\n1214:   // other's fresh render.\n1215:   const commandAttachWithRows = replaceMarkedBlock(\n1216:     commandAttach,\n1217:     COMMAND_ROWS_GENERATED_START,\n1218:     COMMAND_ROWS_GENERATED_END,\n1219:     renderCommandRows(entries, policies),\n1220:     COMMAND_ATTACH_PATH,\n1221:   );\n1222:   return [\n1223:     {\n1224:       path: TS_PROJECTION_PATH,\n1225:       current: typescript,\n1226:       next: replaceMarkedBlock(\n1227:         typescript,\n1228:         TS_GENERATED_START,\n1229:         TS_GENERATED_END,\n1230:         renderTypescriptProjection(entries),\n1231:         TS_PROJECTION_PATH,\n1232:       ),\n1233:     },\n1234:     {\n1235:       path: PY_ADVISOR_PATH,\n1236:       current: python,\n1237:       next: replaceMarkedBlock(\n1238:         python,\n1239:         PY_GENERATED_START,\n1240:         PY_GENERATED_END,\n1241:         renderPythonProjection(entries, pythonOwnerNormalization),\n1242:         PY_ADVISOR_PATH,\n1243:       ),\n1244:     },\n1245:     {\n1246:       path: COMMAND_ATTACH_PATH,\n1247:       current: commandAttach,\n1248:       next: replaceMarkedBlock(\n1249:         commandAttachWithRows,\n1250:         COMMAND_ATTACH_GENERATED_START,\n1251:         COMMAND_ATTACH_GENERATED_END,\n1252:         renderModeCommands(modeCommands),\n1253:         COMMAND_ATTACH_PATH,\n1254:       ),\n1255:     },\n1256:   ];\n1257: }\n1258: \n1259: // ───────────────────────────────────────────────────────────────────\n1260: // 4. CORE LOGIC\n1261: // ───────────────────────────────────────────────────────────────────\n1262: \n1263: function main() {\n1264:   // CLI-only rejection: requiring this module (for example from tests) must\n1265:   // not exit on arguments belonging to the host process.\n1266:   if (require.main === module) {\n1267:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1268:     if (unknownArg !== undefined) {\n1269:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1270:       console.error('usage: derive-command-bridges.cjs [--check]');\n1271:       process.exit(2);\n1272:     }\n1273:   }\n1274:   const checkOnly = process.argv.includes('--check');\n1275:   const metadata = metadataEntries();\n1276:   const doctor = doctorRouteEntries();\n1277:   const tree = commandTreeNames();\n1278:   const metadataRisk = metadataRiskRecords();\n1279:   const doctorRisk = doctorRiskRecords();\n1280:   const modeCommands = modeCommandRecords();\n1281:   const violations = identityViolations({\n1282:     treeCommands: tree,\n1283:     metadataCommands: metadataRisk.map((record) => record.command),\n1284:     doctorCommands: doctorRisk.map((record) => record.command),\n1285:   });\n1286:   if (violations.length > 0) {\n1287:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1288:   }\n1289:   const inventory = [...metadata, ...doctor]\n1290:     .sort((left, right) => left.id.localeCompare(right.id));\n1291:   assertUniqueIds(inventory);\n1292:   const compatibility = runtimeCompatibility(inventory, metadata);\n1293:   const entries = inventory.map((entry) => {\n1294:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1295:     const typescript = compatibility.typescript.get(entry.id);\n1296:     const python = compatibility.python.get(entry.id);\n[Output truncated. Continue reading with offset: 1297]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794531690833,"end":1794531690861}}}}
