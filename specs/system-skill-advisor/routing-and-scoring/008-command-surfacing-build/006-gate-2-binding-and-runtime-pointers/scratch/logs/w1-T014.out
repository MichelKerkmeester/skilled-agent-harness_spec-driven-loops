s (ask) 0.82/0.12 pass.',\n83:   },\n84:   {\n85:     name: 'a memory save names the spec workflow',\n86:     recommendation: {\n87:       skill: 'system-spec-kit',\n88:       kind: 'command',\n89:       command: '/speckit:save',\n90:       policy: 'start',\n91:       ownerSkillId: 'system-spec-kit',\n92:       confidence: 0.89,\n93:       uncertainty: 0.12,\n94:     },\n95:     expectedHead: 'Advisor: live; use system-spec-kit → /speckit:save (start) 0.89/0.12 pass.',\n96:   },\n97:   {\n98:     name: 'a prompt rewrite names the prompt skill',\n99:     recommendation: {\n100:       skill: 'sk-prompt',\n101:       kind: 'command',\n102:       command: '/prompt:improve',\n103:       policy: 'start',\n104:       ownerSkillId: 'sk-prompt',\n105:       confidence: 0.89,\n106:       uncertainty: 0.12,\n107:     },\n108:     expectedHead: 'Advisor: live; use sk-prompt → /prompt:improve (start) 0.89/0.12 pass.',\n109:   },\n110:   {\n111:     name: 'a row id with no fields is filled from the generated command table',\n112:     recommendation: {\n113:       skill: 'command-create-readme',\n114:       kind: 'command',\n115:       confidence: 0.91,\n116:       uncertainty: 0.11,\n117:     },\n118:     expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.91/0.11 pass.',\n119:   },\n120:   {\n121:     name: 'an id with no row keeps the plain skill head',\n122:     recommendation: {\n123:       skill: 'sk-review',\n124:       confidence: 0.61,\n125:       uncertainty: 0.28,\n126:     },\n127:     expectedHead: 'Advisor: live; use sk-review 0.61/0.28 pass.',\n128:   },\n129:   {\n130:     name: 'a command with no known policy drops the parenthesis',\n131:     recommendation: {\n132:       skill: 'command-doctor-review-gate',\n133:       kind: 'command',\n134:       command: '/doctor:review gate',\n135:       ownerSkillId: 'sk-code',\n136:       confidence: 0.77,\n137:       uncertainty: 0.2,\n138:     },\n139:     expectedHead: 'Advisor: live; use sk-code → /doctor:review gate 0.77/0.20 pass.',\n140:   },\n141: ];\n142: \n143: // Every recommendation is marked as passing so each case isolates the head form\n144: // instead of threshold filtering.\n145: function advisorResult(recommendation: RecommendationInput): AdvisorBriefResult {\n146:   return {\n147:     status: 'ok',\n148:     freshness: 'live',\n149:     recommendations: [{ ...recommendation, passes_threshold: true }],\n150:     metrics: { tokenCap: 80 },\n151:   };\n152: }\n153: \n154: function headOf(rendered: string | null): string {\n155:   if (rendered === null) {\n156:     throw new Error('expected a rendered brief');\n157:   }\n158:   return rendered.split(DIRECTIVES_LABEL)[0];\n159: }\n160: \n161: describe('command brief golden heads', () => {\n162:   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n163:     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n164: \n165:     expect(head).toBe(expectedHead);\n166:     expect(head.length).toBeLessThanOrEqual(HEAD_CHARACTER_CAP);\n167:     expect(head).not.toContain('command-');\n168:   });\n169: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\"}"},"time":{"start":1794531734595,"end":1794531735126}}}}
{"type":"tool_use","timestamp":1794531735132,"sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","part":{"partID":"prt_1d26d3404001cjAcSHGsry1B9W","sessionID":"ses_e2d947514ffe5OrPhqo7f5giqK","messageID":"msg_1d26d1aec001H6T75E0Qpnd5sj","type":"tool","id":"chatcmpl-tool-8575876b97269411","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts, lines 1-268\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: \n8: import { describe, expect, it } from 'vitest';\n9: import { parse as parseYaml } from 'yaml';\n10: \n11: import { COMMAND_ROWS } from '../lib/command-attach.js';\n12: import { GENERATED_COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n13: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n14: \n15: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n16: const DOCTOR_ROUTES_PATH = join(REPO_ROOT, '.skilled', 'commands', 'doctor', '_routes.yaml');\n17: const GENERATED_PATH = join(\n18:   REPO_ROOT,\n19:   '.skilled',\n20:   'skills',\n21:   'system-skill-advisor',\n22:   'runtime',\n23:   'scripts',\n24:   'command-bridges',\n25:   'command-bridges.generated.json',\n26: );\n27: const DOCTOR_PREFIX = 'command-doctor-';\n28: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n29: \n30: interface DoctorBridgeExpectation {\n31:   readonly runnable: string;\n32:   readonly bareCommand?: string;\n33:   readonly phrases: readonly string[];\n34:   readonly leadPhrases?: readonly string[];\n35:   readonly readOnly: boolean;\n36: }\n37: \n38: interface DoctorManifest {\n39:   readonly routes: readonly {\n40:     readonly command: string;\n41:     readonly target: string;\n42:     readonly trigger_phrases: readonly string[];\n43:     readonly lead_phrases?: readonly string[];\n44:     readonly default_target?: boolean;\n45:     readonly mutating?: string;\n46:   }[];\n47:   readonly standalone?: readonly {\n48:     readonly command?: string;\n49:     readonly runnable?: string;\n50:     readonly trigger_phrases?: readonly string[];\n51:     readonly lead_phrases?: readonly string[];\n52:     readonly mutating?: string;\n53:   }[];\n54:   readonly mcp_subroutes?: readonly {\n55:     readonly sub_action: string;\n56:     readonly trigger_phrases: readonly string[];\n57:     readonly lead_phrases?: readonly string[];\n58:     readonly mutating?: string;\n59:   }[];\n60: }\n61: \n62: interface GeneratedDoctorBridge {\n63:   readonly id: string;\n64:   readonly runtime: {\n65:     readonly python: {\n66:       readonly enabled: boolean;\n67:       readonly slashMarkers?: readonly string[];\n68:     };\n69:   };\n70: }\n71: \n72: function doctorName(command: string): string {\n73:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n74:   if (!match) throw new Error(`Unrecognized doctor command: ${command}`);\n75:   return match[1] as string;\n76: }\n77: \n78: // Expectations are recomputed from the route manifest rather than read back from\n79: // the generated artifacts, so a generator defect cannot hide behind its own output.\n80: function manifestDoctorBridges(): Map<string, DoctorBridgeExpectation> {\n81:   const manifest = parseYaml(readFileSync(DOCTOR_ROUTES_PATH, 'utf8')) as DoctorManifest;\n82:   const routeCounts = new Map<string, number>();\n83:   for (const route of manifest.routes) {\n84:     const name = doctorName(route.command);\n85:     routeCounts.set(name, (routeCounts.get(name) ?? 0) + 1);\n86:   }\n87: \n88:   const bridges = new Map<string, DoctorBridgeExpectation>();\n89:   for (const route of manifest.routes) {\n90:     const name = doctorName(route.command);\n91:     const multiTarget = (routeCounts.get(name) ?? 0) > 1;\n92:     bridges.set(multiTarget ? `${DOCTOR_PREFIX}${name}-${route.target}` : `${DOCTOR_PREFIX}${name}`, {\n93:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n94:       bareCommand: route.default_target === true ? route.command : undefined,\n95:       phrases: route.trigger_phrases,\n96:       leadPhrases: route.lead_phrases?.length ? route.lead_phrases : undefined,\n97:       readOnly: route.mutating === 'read-only',\n98:     });\n99:   }\n100: \n101:   for (const item of manifest.standalone ?? []) {\n102:     if (typeof item.command !== 'string') continue;\n103:     const name = doctorName(item.command);\n104:     const runnable = typeof item.runnable === 'string' && item.runnable ? item.runnable : item.command;\n105:     bridges.set(`${DOCTOR_PREFIX}${name}`, {\n106:       runnable,\n107:       phrases: Array.isArray(item.trigger_phrases) ? item.trigger_phrases : [],\n108:       leadPhrases: item.lead_phrases?.length ? item.lead_phrases : undefined,\n109:       readOnly: item.mutating === 'read-only',\n110:     });\n111:   }\n112: \n113:   for (const item of manifest.mcp_subroutes ?? []) {\n114:     const id = `${DOCTOR_PREFIX}${doctorName(DOCTOR_MCP_COMMAND)}-${item.sub_action}`;\n115:     bridges.set(id, {\n116:       runnable: `${DOCTOR_MCP_COMMAND} ${item.sub_action}`,\n117:       phrases: item.trigger_phrases,\n118:       leadPhrases: item.lead_phrases?.length ? item.lead_phrases : undefined,\n119:       readOnly: item.mutating === 'read-only',\n120:     });\n121:   }\n122: \n123:   return bridges;\n124: }\n125: \n126: function renderedDoctorStrings(): Map<string, string> {\n127:   const strings = new Map<string, string>();\n128:   for (const [id, row] of Object.entries(COMMAND_ROWS)) {\n129:     if (id.startsWith(DOCTOR_PREFIX)) strings.set(id, row.command);\n130:   }\n131:   return strings;\n132: }\n133: \n134: function sortedPairs(entries: Iterable<readonly [string, string]>): [string, string][] {\n135:   return [...entries]\n136:     .map(([key, value]) => [key, value] as [string, string])\n137:     .sort(([left], [right]) => left.localeCompare(right));\n138: }\n139: \n140: describe('doctor command bridges', () => {\n141:   it('the renderer lookup holds the runnable string of every doctor bridge in the manifest', () => {\n142:     const rendered = renderedDoctorStrings();\n143:     const expected = sortedPairs(\n144:       [...manifestDoctorBridges()].map(([id, { runnable }]) => [id, runnable] as const),\n145:     );\n146: \n147:     expect(rendered.size).toBeGreaterThan(10);\n148:     expect(sortedPairs(rendered)).toEqual(expected);\n149:   });\n150: \n151:   it('every active TypeScript doctor bridge carries its manifest phrases and runnable string', () => {\n152:     const manifest = manifestDoctorBridges();\n153:     const failures: string[] = [];\n154: \n155:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n156:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n157:       const expected = manifest.get(entry.id);\n158:       if (!expected) {\n159:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n160:         continue;\n161:       }\n162: \n163:       if (entry.name !== expected.runnable) {\n164:         failures.push(`${entry.id}: name ${entry.name} !== runnable ${expected.runnable}`);\n165:       }\n166: \n167:       const keywords = [...entry.keywords].sort();\n168:       const phrases = [\n169:         ...expected.phrases,\n170:         ...(expected.bareCommand ? [expected.bareCommand] : []),\n171:       ].sort();\n172:       if (JSON.stringify(keywords) !== JSON.stringify(phrases)) {\n173:         failures.push(\n174:           `${entry.id}: keywords ${JSON.stringify(keywords)} !== phrases ${JSON.stringify(phrases)}`,\n175:         );\n176:       }\n177: \n178:       if (JSON.stringify(entry.intentSignals) !== JSON.stringify([expected.runnable])) {\n179:         failures.push(\n180:           `${entry.id}: intentSignals ${JSON.stringify(entry.intentSignals)} !== ${JSON.stringify([expected.runnable])}`,\n181:         );\n182:       }\n183:     }\n184: \n185:     expect(failures).toEqual([]);\n186:   });\n187: \n188:   it('every active TypeScript doctor bridge carries its manifest lead phrases', () => {\n189:     const manifest = manifestDoctorBridges();\n190:     const failures: string[] = [];\n191: \n192:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n193:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n194:       const expected = manifest.get(entry.id);\n195:       if (!expected) {\n196:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n197:         continue;\n198:       }\n199: \n200:       if (JSON.stringify(entry.leadPhrases) !== JSON.stringify(expected.leadPhrases)) {\n201:         failures.push(\n202:           `${entry.id}: leadPhrases ${JSON.stringify(entry.leadPhrases)} !== ${JSON.stringify(expected.leadPhrases)}`,\n203:         );\n204:       }\n205:     }\n206: \n207:     expect(failures).toEqual([]);\n208:     const envBridge = GENERATED_COMMAND_BRIDGES.find((entry) => entry.id === 'command-doctor-env');\n209:     expect(envBridge?.leadPhrases).toEqual(['check my environment variables']);\n210:   });\n211: \n212:   it('every active TypeScript doctor bridge is read-only exactly when its manifest route is', () => {\n213:     const manifest = manifestDoctorBridges();\n214:     const failures: string[] = [];\n215: \n216:     for (const entry of GENERATED_COMMAND_BRIDGES) {\n217:       if (entry.routingEnabled === false || !entry.id.startsWith(DOCTOR_PREFIX)) continue;\n218:       const expected = manifest.get(entry.id);\n219:       if (!expected) {\n220:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n221:         continue;\n222:       }\n223:       if ((entry.readOnly === true) !== expected.readOnly) {\n224:         failures.push(`${entry.id}: readOnly ${String(entry.readOnly)} !== ${String(expected.readOnly)}`);\n225:       }\n226:     }\n227: \n228:     expect(failures).toEqual([]);\n229:     const byId = (id: string) => GENERATED_COMMAND_BRIDGES.find((entry) => entry.id === id);\n230:     expect(byId('command-doctor-ci-report')?.readOnly).toBe(true);\n231:     expect(byId('command-doctor-ci-scaffold')?.readOnly).toBeUndefined();\n232:     expect(byId('command-doctor-ci-toggle')?.readOnly).toBeUndefined();\n233:   });\n234: \n235:   it('every active Python doctor bridge matches only on its runnable slash string', () => {\n236:     const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as {\n237:       readonly entries: readonly GeneratedDoctorBridge[];\n238:     };\n239:     const manifest = manifestDoctorBridges();\n240:     const failures: string[] = [];\n241: \n242:     for (const entry of generated.entries) {\n243:       if (!entry.id.startsWith(DOCTOR_PREFIX) || entry.runtime.python.enabled !== true) continue;\n244:       const expected = manifest.get(entry.id);\n245:       if (!expected) {\n246:         failures.push(`${entry.id}: no bridge in the doctor route manifest`);\n247:         continue;\n248:       }\n249: \n250:       const markers = entry.runtime.python.slashMarkers ?? [];\n251:       const expectedMarkers = expected.bareCommand\n252:         ? [expected.runnable, expected.bareCommand]\n253:         : [expected.runnable];\n254:       if (JSON.stringify(markers) !== JSON.stringify(expectedMarkers)) {\n255:         failures.push(\n256:           `${entry.id}: slashMarkers ${JSON.stringify(markers)} !== ${JSON.stringify(expectedMarkers)}`,\n257:         );\n258:       }\n259:       for (const marker of markers) {\n260:         if (!marker.startsWith('/doctor:')) {\n261:           failures.push(`${entry.id}: slash marker ${marker} does not start with /doctor:`);\n262:         }\n263:       }\n264:     }\n265: \n266:     expect(failures).toEqual([]);\n267:   });\n268: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts, lines 1-268\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { readFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: \n8: import { describe, expect, it } from 'vitest';\n9: import { parse as parseYaml } from 'yaml';\n10: \n11: import { COMMAND_ROWS } from '../lib/command-attach.js';\n12: import { GENERATED_COMMAND_BRIDGES } from '../lib/scorer/projection.js';\n13: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n14: \n15: const REPO_ROOT = findAdvisorWorkspaceRoot(import.meta.dirname);\n16: const DOCTOR_ROUTES_PATH = join(REPO_ROOT, '.skilled', 'commands', 'doctor', '_routes.yaml');\n17: const GENERATED_PATH = join(\n18:   REPO_ROOT,\n19:   '.skilled',\n20:   'skills',\n21:   'system-skill-advisor',\n22:   'runtime',\n23:   'scripts',\n24:   'command-bridges',\n25:   'command-bridges.generated.json',\n26: );\n27: const DOCTOR_PREFIX = 'command-doctor-';\n28: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n29: \n30: interface DoctorBridgeExpectation {\n31:   readonly runnable: string;\n32:   readonly bareCommand?: string;\n33:   readonly phrases: readonly string[];\n34:   readonly leadPhrases?: readonly string[];\n35:   readonly readOnly: boolean;\n36: }\n37: \n38: interface DoctorManifest {\n39:   readonly routes: readonly {\n40:     readonly command: string;\n41:     readonly target: string;\n42:     readonly trigger_phr