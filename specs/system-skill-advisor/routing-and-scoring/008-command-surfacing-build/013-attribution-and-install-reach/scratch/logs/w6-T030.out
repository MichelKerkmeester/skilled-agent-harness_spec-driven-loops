', () => {\n\n  Line 600: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n\n  Line 679: describe('run log summary', () => {\n\n  Line 685:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n\n  Line 699:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n\n  Line 718:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n\n  Line 777:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n\n  Line 796:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n\n  Line 816:           rowId: SUMMARY_ROW,\n\n  Line 846:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: loadableSession(root) },\n\n  Line 859:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n\n  Line 870:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n\n  Line 884:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n\n  Line 886:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\",\"pattern\":\"normalize|startState|SUMMARY_ROW|describe\\\\(|import \",\"limit\":100}"},"time":{"start":1794547509067,"end":1794547509807}}}}
