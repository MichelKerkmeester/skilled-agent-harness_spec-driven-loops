nt":[{"type":"text","text":"G2 claude:\n0 of 6\nPOST now:\n{\"claude\":\"4 of 12\",\"codex\":\"0 of 12\",\"devin\":\"3 of 9\",\"dsh\":\"6 of 12\",\"opencode\":\"1 of 5\",\"pi\":\"2 of 10\"}\nPRE now:\n{\"claude\":\"3 of 12\",\"codex\":\"0 of 12\",\"devin\":\"1 of 8\",\"dsh\":\"6 of 12\",\"opencode\":\"2 of 7\",\"pi\":\"0 of 11\"}\nPOST before:\n{\"claude\":\"4 of 12\",\"codex\":\"0 of 12\",\"devin\":\"3 of 9\",\"dsh\":\"6 of 12\",\"opencode\":\"1 of 5\",\"pi\":\"2 of 10\"}\nPRE before:\n{\"claude\":\"3 of 12\",\"codex\":\"0 of 12\",\"devin\":\"1 of 8\",\"dsh\":\"6 of 12\",\"opencode\":\"2 of 7\",\"pi\":\"0 of 11\"}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && ADV=.skilled/skills/system-skill-advisor/runtime && S=$ADV/scripts/routing-accuracy/score-command-transcripts.mjs && P7=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/007-per-runtime-behaviour-proof/scratch && SP=specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/013-attribution-and-install-reach/scratch && echo \\\"G2 claude:\\\" && node $S --summary $P7/runs-g2.jsonl --json | jq -r '.claude.g2.startRate' && echo \\\"POST now:\\\" && node $S --summary $P7/runs-post-final.jsonl --json | jq -cS 'map_values(.post.startRate)' && echo \\\"PRE now:\\\" && node $S --summary $P7/runs-pre-final.jsonl --json | jq -cS 'map_values(.pre.startRate)' && echo \\\"POST before:\\\" && jq -cS 'map_values(.post.startRate)' $SP/summary-post-before.json && echo \\\"PRE before:\\\" && jq -cS 'map_values(.pre.startRate)' $SP/summary-pre-before.json\"}"},"time":{"start":1794547546548,"end":1794547548452}}}}
