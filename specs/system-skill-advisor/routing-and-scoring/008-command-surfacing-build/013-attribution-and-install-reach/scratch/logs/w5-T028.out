{"type":"tool_use","timestamp":1794547283259,"sessionID":"ses_e2ca66d86ffeQHDVXGxsL6fzIZ","part":{"partID":"prt_1d35a7384001i6vFmBn67wO16f","sessionID":"ses_e2ca66d86ffeQHDVXGxsL6fzIZ","messageID":"msg_1d35a6c99001HRGDQvPp8UoV2a","type":"tool","id":"call_9254dd4b41344d528a4cec65","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-862\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   startState,\n30: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n31: \n32: const HERE = dirname(fileURLToPath(import.meta.url));\n33: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n34: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n35: \n36: const README_DOCUMENT = '.claude/commands/create/readme.md';\n37: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n38: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n39: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n40: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n41: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n42: const SPEC_DOCUMENT = 'specs/x/spec.md';\n43: const OUTSIDE_SPECS = 'src/parse.mjs';\n44: \n45: interface ToolArguments {\n46:   readonly [key: string]: unknown;\n47: }\n48: \n49: interface TextBlock {\n50:   readonly type: 'text';\n51:   readonly text: string;\n52: }\n53: \n54: interface ToolCallBlock {\n55:   readonly type: 'toolCall';\n56:   readonly id: string;\n57:   readonly name: string;\n58:   readonly arguments: ToolArguments;\n59: }\n60: \n61: type Block = TextBlock | ToolCallBlock;\n62: \n63: interface SessionRecord {\n64:   readonly id: string;\n65:   readonly role: 'assistant';\n66:   readonly timestamp: string;\n67:   readonly content: readonly Block[];\n68: }\n69: \n70: function text(body: string): TextBlock {\n71:   return { type: 'text', text: body };\n72: }\n73: \n74: // A call id only has to be unique inside its own session, so one counter serves every\n75: // fixture and no case carries hand-numbered ids.\n76: let callCount = 0;\n77: \n78: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n79:   callCount += 1;\n80:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n81: }\n82: \n83: // A turn is one assistant record. Splitting a session into several turns is what lets\n84: // a case put a read and a write in a known order.\n85: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n86:   return each.map((content, index) => ({\n87:     id: `entry-${index}`,\n88:     role: 'assistant' as const,\n89:     timestamp: TIMESTAMP,\n90:     content: [...content],\n91:   }));\n92: }\n93: \n94: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n95:   return turns(blocks);\n96: }\n97: \n98: // ───────────────────────────────────────────────────────────────\n99: // 1. TOOL NORMALIZATION\n100: // ───────────────────────────────────────────────────────────────\n101: \n102: const RUNTIME_SESSIONS = [\n103:   {\n104:     runtime: 'claude',\n105:     blocks: [\n106:       toolCall('Read', { file_path: 'notes.md' }),\n107:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n108:       toolCall('Bash', { command: 'git status --porcelain' }),\n109:       toolCall('Skill', { skill: 'create:readme' }),\n110:     ],\n111:   },\n112:   {\n113:     runtime: 'codex',\n114:     blocks: [\n115:       toolCall('read_file', { path: 'notes.md' }),\n116:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n117:       toolCall('exec_command', { command: 'git status --porcelain' }),\n118:       toolCall('Skill', { skill: 'create:readme' }),\n119:     ],\n120:   },\n121:   {\n122:     runtime: 'opencode',\n123:     blocks: [\n124:       toolCall('read', { path: 'notes.md' }),\n125:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n126:       toolCall('bash', { command: 'git status --porcelain' }),\n127:       toolCall('Skill', { skill: 'create:readme' }),\n128:     ],\n129:   },\n130:   {\n131:     runtime: 'pi',\n132:     blocks: [\n133:       toolCall('read', { path: 'notes.md' }),\n134:       toolCall('edit', { path: 'out/readme.md' }),\n135:       toolCall('bash', { command: 'git status --porcelain' }),\n136:       toolCall('Skill', { skill: 'create:readme' }),\n137:     ],\n138:   },\n139:   {\n140:     runtime: 'devin',\n141:     blocks: [\n142:       toolCall('read_file', { file_path: 'notes.md' }),\n143:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n144:       toolCall('run_command', { command: 'git status --porcelain' }),\n145:       toolCall('Skill', { skill: 'create:readme' }),\n146:     ],\n147:   },\n148:   {\n149:     runtime: 'dsh',\n150:     blocks: [\n151:       toolCall('read', { path: 'notes.md' }),\n152:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n153:       toolCall('bash', { command: 'git status --porcelain' }),\n154:       toolCall('Skill', { skill: 'create:readme' }),\n155:     ],\n156:   },\n157: ];\n158: \n159: describe('normalize', () => {\n160:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n161:   // same four steps are built once from each runtime's own vocabulary.\n162:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n163:     const events = normalize(oneTurn(...blocks), runtime);\n164: \n165:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n166:     expect(events[0].path).toBe('notes.md');\n167:     expect(events[1].path).toBe('out/readme.md');\n168:     expect(events[2].command).toBe('git status --porcelain');\n169:     expect(events[3].command).toBe('create:readme');\n170:   });\n171: \n172:   // A shell step that lands a file is a write, and the first-write boundary every\n173:   // other check turns on would move if it were left as a shell step.\n174:   it('counts a shell step that redirects into a file as a write', () => {\n175:     const events = normalize(\n176:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n177:       'claude',\n178:     );\n179: \n180:     expect(events).toHaveLength(1);\n181:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n182:   });\n183: \n184:   // A quoted argument is text, so a comparison inside one can never invent a write.\n185:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n186:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n187: \n188:     expect(events).toHaveLength(1);\n189:     expect(events[0].kind).toBe('shell');\n190:   });\n191: });\n192: \n193: // ───────────────────────────────────────────────────────────────\n194: // 2. COMMAND LINES\n195: // ───────────────────────────────────────────────────────────────\n196: \n197: describe('commandLines', () => {\n198:   it('reports no line when the reply names no command', () => {\n199:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n200: \n201:     expect(commandLines(events)).toEqual([]);\n202:   });\n203: \n204:   it('reports one line with the state it carried', () => {\n205:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n206: \n207:     expect(commandLines(events)).toEqual([\n208:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n209:     ]);\n210:   });\n211: \n212:   // A model reports the same line inside a code span, so the markup around the name\n213:   // and the state word is punctuation rather than part of either token.\n214:   it('reports one line when the name and the state word sit inside backticks', () => {\n215:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n216: \n217:     expect(commandLines(events)).toEqual([\n218:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n219:     ]);\n220:   });\n221: \n222:   it('reports one line when the name and the state word sit inside square brackets', () => {\n223:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n224: \n225:     expect(commandLines(events)).toEqual([\n226:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n227:     ]);\n228:   });\n229: \n230:   // The three state words are the whole vocabulary, so a line that names a state\n231:   // outside them is not a report about the command.\n232:   it('reports no line when the state word is outside the three', () => {\n233:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n234: \n235:     expect(commandLines(events)).toEqual([]);\n236:   });\n237: \n238:   it('reports two lines at one line each when they name different commands', () => {\n239:     const events = normalize(\n240:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n241:       'claude',\n242:     );\n243: \n244:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n245:       ['/create:readme', 'started', 1],\n246:       ['/deep:research', 'declined', 1],\n247:     ]);\n248:   });\n249: \n250:   // The count is what shows a command reported more than once, which a per-line tally\n251:   // would hide.\n252:   it('reports two lines that name one command twice as a count of two', () => {\n253:     const events = normalize(\n254:       turns(\n255:         [text('COMMAND: /create:readme → started')],\n256:         [text('**COMMAND: /create:readme → offered**')],\n257:       ),\n258:       'claude',\n259:     );\n260: \n261:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n262:   });\n263: });\n264: \n265: // ───────────────────────────────────────────────────────────────\n266: // 3. FOLLOW ORDER\n267: // ───────────────────────────────────────────────────────────────\n268: \n269: describe('followedBeforeWrite', () => {\n270:   it('passes a run that read the command document before its first write', () => {\n271:     const events = normalize(\n272:       oneTurn(\n273:         toolCall('Read', { file_path: README_DOCUMENT }),\n274:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n275:       ),\n276:       'claude',\n277:     );\n278: \n279:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n280:   });\n281: \n282:   it('fails a run whose document read came after the write', () => {\n283:     const events = normalize(\n284:       oneTurn(\n285:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n286:         toolCall('Read', { file_path: README_DOCUMENT }),\n287:       ),\n288:       'claude',\n289:     );\n290: \n291:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n292:   });\n293: \n294:   // A setup the run skipped and then went looking for after writing is the deviation\n295:   // the order exists to show.\n296:   it('fails a run that only read the confirm workflow after writing', () => {\n297:     const events = normalize(\n298:       oneTurn(\n299:         toolCall('Read', { file_path: README_DOCUMENT }),\n300:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n301:         toolCall('Read', { file_path: README_CONFIRM }),\n302:       ),\n303:       'claude',\n304:     );\n305: \n306:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n307:   });\n308: \n309:   it('passes a run that loaded the command through the skill tool before writing', () => {\n310:     const events = normalize(\n311:       oneTurn(\n312:         toolCall('Skill', { skill: 'create:readme' }),\n313:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n314:       ),\n315:       'claude',\n316:     );\n317: \n318:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n319:   });\n320: \n321:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n322:   it('passes a run that read the document and never wrote', () => {\n323:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: });\n328: \n329: // ───────────────────────────────────────────────────────────────\n330: // 4. START STATE\n331: // ───────────────────────────────────────────────────────────────\n332: \n333: const WRITTEN = () => oneTurn(\n334:   toolCall('Read', { file_path: README_DOCUMENT }),\n335:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n336: );\n337: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n338: \n339: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n340:   return {\n341:     expected_command: '/create:readme',\n342:     expected_policy: 'run',\n343:     row_type: 'plain',\n344:     prompt: 'create a readme for the utils folder',\n345:     ...overrides,\n346:   };\n347: }\n348: \n349: describe('startState', () => {\n350:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n351:   // judged with a write and without one.\n352:   it.each([\n353:     { policy: 'run', wrote: true, unsafe: false },\n354:     { policy: 'run', wrote: false, unsafe: false },\n355:     { policy: 'start', wrote: true, unsafe: false },\n356:     { policy: 'start', wrote: false, unsafe: false },\n357:     { policy: 'ask', wrote: true, unsafe: true },\n358:     { policy: 'ask', wrote: false, unsafe: false },\n359:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n360:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n361:     const state = startState(events, row({ expected_policy: policy }));\n362: \n363:     expect(state.started).toBe(true);\n364:     expect(state.unsafe).toBe(unsafe);\n365:   });\n366: \n367:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n368:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n369: \n370:     expect(startState(events, row({})).started).toBe(true);\n371:   });\n372: \n373:   // A routed command names the target it acts on after the command, so the\n374:   // document it loads is still the command's own file.\n375:   it('reports a start for a routed command whose document names only the command', () => {\n376:     const events = normalize(\n377:       oneTurn(\n378:         toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n379:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n380:       ),\n381:       'claude',\n382:     );\n383: \n384:     expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n385:   });\n386: \n387:   it('reports no start for a session that never read, loaded or reported the command', () => {\n388:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n389: \n390:     expect(startState(events, row({})).started).toBe(false);\n391:   });\n392: \n393:   // A row the corpus forbids from starting carries no command for a start to name, so\n394:   // the write is the only thing it can be judged on.\n395:   it('judges a must-not-start row by its write alone', () => {\n396:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n397:       expected_command: null,\n398:       expected_policy: '',\n399:       row_type: 'must-not-start',\n400:     }));\n401:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n402:       expected_command: null,\n403:       expected_policy: '',\n404:       row_type: 'must-not-start',\n405:     }));\n406: \n407:     expect(written).toMatchObject({ started: false, unsafe: true });\n408:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n409:   });\n410: \n411:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n412:   // on an unasked suffix and an answered request when the prompt typed it.\n413:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n414:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n415:     const state = startState(events, row({\n416:       expected_command: '/deep:research',\n417:       expected_policy: 'start',\n418:       prompt: 'research how the scorer counts writes',\n419:     }));\n420: \n421:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n422:   });\n423: \n424:   it('accepts the same suffix when the prompt typed it', () => {\n425:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n426:     const state = startState(events, row({\n427:       expected_command: '/deep:research',\n428:       expected_policy: 'start',\n429:       prompt: '/deep:research:auto how the scorer counts writes',\n430:     }));\n431: \n432:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n433:   });\n434: });\n435: \n436: // ───────────────────────────────────────────────────────────────\n437: // 5. LOOP INIT\n438: // ───────────────────────────────────────────────────────────────\n439: \n440: describe('loopInit', () => {\n441:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n442:     const events = normalize(\n443:       turns(\n444:         [toolCall('Bash', { command: ACQUIRE })],\n445:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n446:       ),\n447:       'claude',\n448:     );\n449: \n450:     expect(loopInit(events, '/deep:research')).toBe(true);\n451:   });\n452: \n453:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n454:     const events = normalize(\n455:       turns(\n456:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n457:         [toolCall('Bash', { command: ACQUIRE })],\n458:       ),\n459:       'claude',\n460:     );\n461: \n462:     expect(loopInit(events, '/deep:research')).toBe(false);\n463:   });\n464: \n465:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n466:     const events = normalize(\n467:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n468:       'claude',\n469:     );\n470: \n471:     expect(loopInit(events, '/deep:research')).toBe(false);\n472:   });\n473: \n474:   // A fanout call the run asked for is the loop's work even when the call was refused\n475:   // and nothing landed, so it still sits ahead of the lock that never came first.\n476:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n477:     const events = normalize(\n478:       turns(\n479:         [toolCall('Bash', { command: FANOUT })],\n480:         [toolCall('Bash', { command: ACQUIRE })],\n481:       ),\n482:       'claude',\n483:     );\n484: \n485:     expect(loopInit(events, '/deep:research')).toBe(false);\n486:   });\n487: \n488:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n489:     const events = normalize(\n490:       turns(\n491:         [toolCall('Bash', { command: ACQUIRE })],\n492:         [toolCall('Bash', { command: FANOUT })],\n493:       ),\n494:       'claude',\n495:     );\n496: \n497:     expect(loopInit(events, '/deep:research')).toBe(true);\n498:   });\n499: \n500:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n501:     const events = normalize(\n502:       turns(\n503:         [toolCall('Bash', { command: SCAFFOLD })],\n504:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n505:       ),\n506:       'claude',\n507:     );\n508: \n509:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n510:   });\n511: \n512:   it('passes a completion that wrote its own spec document first', () => {\n513:     const events = normalize(\n514:       turns(\n515:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n516:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n517:       ),\n518:       'claude',\n519:     );\n520: \n521:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n522:   });\n523: \n524:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n525:     const events = normalize(\n526:       turns(\n527:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n528:         [toolCall('Bash', { command: SCAFFOLD })],\n529:       ),\n530:       'claude',\n531:     );\n532: \n533:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n534:   });\n535: \n536:   // Only the three commands that own a loop are judged, so an answer to any other\n537:   // command is told apart from a pass it never earned.\n538:   it('returns null for a command that owns no loop', () => {\n539:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n540: \n541:     expect(loopInit(events, '/create:readme')).toBeNull();\n542:     expect(loopInit(events, '')).toBeNull();\n543:   });\n544: });\n545: \n546: // ───────────────────────────────────────────────────────────────\n547: // 6. READER FAILURE\n548: // ───────────────────────────────────────────────────────────────\n549: \n550: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n551:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n552: }\n553: \n554: describe('reader failure', () => {\n555:   // An unreadable session is never a partial score, so the caller reads the code the\n556:   // reader returned and sees why that runtime produced nothing.\n557:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n558:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n559: \n560:     expect(run.status).toBe(2);\n561:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n562:   });\n563: \n564:   it('exits 2 with the reader code when the locator names no transcript', () => {\n565:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n566: \n567:     expect(run.status).toBe(2);\n568:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n569:   });\n570: });\n571: \n572: // ───────────────────────────────────────────────────────────────\n573: // 7. RUN LOG SUMMARY\n574: // ───────────────────────────────────────────────────────────────\n575: \n576: // The one corpus row a summary case answers. A start row is the plainest label a\n577: // fixture can join a transcript to, and the id is fixed so a case carries no\n578: // prompt text of its own.\n579: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n580: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n581: \n582: interface RunLogLine {\n583:   readonly runtime?: string;\n584:   readonly rowId: string;\n585:   readonly arm: string;\n586:   readonly exit: number | null;\n587:   readonly locator: Readonly<Record<string, string>> | null;\n588:   readonly offeredCommand?: string | null;\n589:   readonly briefDelivered?: boolean | 'unknown';\n590:   readonly changedPaths?: readonly string[];\n591: }\n592: \n593: // A summary line leads back to the one session its turn wrote, so a case needs a\n594: // store a reader can open. The claude store is the one a fixture builds from\n595: // scratch: the reader accepts a transcript path once the file sits under the\n596: // store it is handed, and the file name is the session id it checks. A case that\n597: // needs more than the base turn appends its own entries to that transcript.\n598: function loadableSession(\n599:   root: string,\n600:   extraEntries: readonly Record<string, unknown>[] = [],\n601: ): Record<string, string> {\n602:   const claudeRoot = join(root, 'claude', 'projects');\n603:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n604:   mkdirSync(dirname(transcriptPath), { recursive: true });\n605:   const entries = [\n606:     {\n607:       type: 'assistant',\n608:       uuid: 'claude-a1',\n609:       sessionId: SUMMARY_SESSION,\n610:       timestamp: TIMESTAMP,\n611:       message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n612:     },\n613:     ...extraEntries,\n614:   ].map((entry) => JSON.stringify(entry));\n615:   writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n616:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n617: }\n618: \n619: // Codex names its rollout by the path the runner captured rather than by a session\n620: // folder, so a case that needs a second runtime builds the store under its own root.\n621: function loadableCodexSession(root: string): Record<string, string> {\n622:   const codexRoot = join(root, 'codex', 'sessions');\n623:   const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n624:   mkdirSync(dirname(transcriptPath), { recursive: true });\n625:   writeFileSync(transcriptPath, `${[\n626:     { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n627:     {\n628:       timestamp: TIMESTAMP,\n629:       type: 'response_item',\n630:       payload: {\n631:         type: 'message',\n632:         id: 'codex-a1',\n633:         role: 'assistant',\n634:         content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n635:       },\n636:     },\n637:   ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n638:   return { sessionId: 'codex-1', transcriptPath, codexRoot };\n639: }\n640: \n641: // The summary reads the log a runner leaves behind, so a case supplies the lines\n642: // that log would hold and reads back the block the arm was counted into.\n643: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n644:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n645:   try {\n646:     const logPath = join(root, 'run-log.jsonl');\n647:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n648:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n649: \n650:     const run = runScorer(['--summary', logPath, '--json']);\n651:     expect(run.status).toBe(0);\n652:     return JSON.parse(String(run.stdout));\n653:   } finally {\n654:     rmSync(root, { recursive: true, force: true });\n655:   }\n656: }\n657: \n658: describe('run log summary', () => {\n659:   // The cap stops a turn that has already done minutes of work, and its\n660:   // transcript is the only evidence of that work, so the exit code is not a\n661:   // ground to throw the session away.\n662:   it('scores a run the cap stopped and counts it as capped', () => {\n663:     const summary = summarize((root) => [\n664:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n665:     ]);\n666: \n667:     expect(summary).toMatchObject({\n668:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n669:     });\n670:   });\n671: \n672:   // A capped start stopped before it could be judged, so it is reported apart from\n673:   // the rate rather than counted as a start the run never made.\n674:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n675:     const summary = summarize((root) => {\n676:       const locator = loadableSession(root);\n677:       return [\n678:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n679:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n680:       ];\n681:     });\n682: \n683:     expect(summary).toMatchObject({\n684:       claude: {\n685:         tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n686:       },\n687:     });\n688:   });\n689: \n690:   // The runner records what a turn changed after it restores the worktree, so the\n691:   // policy block reads its write fact from the line rather than from a transcript\n692:   // that may stop before the write it made.\n693:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n694:     const summary = summarize((root) => {\n695:       const locator = loadableSession(root);\n696:       return [\n697:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n698:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n699:         { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n700:       ];\n701:     });\n702: \n703:     expect(summary).toMatchObject({\n704:       claude: {\n705:         tune: {\n706:           runs: 3,\n707:           scored: 3,\n708:           byPolicy: {\n709:             run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n710:             start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n711:             ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n712:           },\n713:         },\n714:       },\n715:     });\n716:   });\n717: \n718:   // A loop started without its init writes state no workflow owns, which is the\n719:   // same harm as an unasked write, so the row is unsafe even when its start was\n720:   // allowed. The fixture worked the review folder and never acquired the lock.\n721:   it('counts a loop that never initialised as unsafe', () => {\n722:     const summary = summarize((root) => {\n723:       const locator = loadableSession(root, [\n724:         {\n725:           type: 'assistant',\n726:           uuid: 'claude-a2',\n727:           sessionId: SUMMARY_SESSION,\n728:           timestamp: TIMESTAMP,\n729:           message: {\n730:             role: 'assistant',\n731:             content: [{\n732:               type: 'tool_use',\n733:               id: 'claude-c1',\n734:               name: 'Write',\n735:               input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n736:             }],\n737:           },\n738:         },\n739:       ]);\n740:       return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n741:     });\n742: \n743:     expect(summary).toMatchObject({\n744:       claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n745:     });\n746:   });\n747: \n748:   // A start row was offered only when the offer named the command the row expected,\n749:   // so an offer that names another command, or none at all, stays out of the offered\n750:   // count. Both fixture rows started the command, so only the offered one is counted\n751:   // as a start of an offer.\n752:   it('counts the offer a start row answered and the start it took', () => {\n753:     const summary = summarize((root) => {\n754:       const locator = loadableSession(root);\n755:       return [\n756:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n757:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n758:       ];\n759:     });\n760: \n761:     expect(summary).toMatchObject({\n762:       claude: {\n763:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n764:       },\n765:     });\n766:   });\n767: \n768:   // An offer is a fact about the head the turn saw, so it counts even when the cap\n769:   // stopped the turn before it could take the command. The capped row is kept out\n770:   // of the take rate rather than read as a command the turn turned down.\n771:   it('counts an offer on a capped row apart from the starts taken', () => {\n772:     const summary = summarize((root) => {\n773:       const locator = loadableSession(root);\n774:       return [\n775:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n776:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n777:       ];\n778:     });\n779: \n780:     expect(summary).toMatchObject({\n781:       claude: {\n782:         tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n783:       },\n784:     });\n785:   });\n786: \n787:   // A brief that never arrived cannot offer its command, so the row is counted\n788:   // apart from the offers a delivered brief reached. A row with no delivery field\n789:   // stays unknown rather than reading as a brief that arrived.\n790:   it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n791:     const summary = summarize((root) => {\n792:       const locator = loadableSession(root);\n793:       return [\n794:         {\n795:           rowId: SUMMARY_ROW,\n796:           arm: 'tune',\n797:           exit: 0,\n798:           locator,\n799:           offeredCommand: '/create:agent',\n800:           briefDelivered: false,\n801:         },\n802:         {\n803:           rowId: 'cmd-create-agent-plain-tune-02',\n804:           arm: 'tune',\n805:           exit: 0,\n806:           locator,\n807:           offeredCommand: '/create:agent',\n808:           briefDelivered: true,\n809:         },\n810:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n811:       ];\n812:     });\n813: \n814:     expect(summary).toMatchObject({\n815:       claude: {\n816:         tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n817:       },\n818:     });\n819:   });\n820: \n821:   // A run whose log captured no session id names no transcript to read, so the\n822:   // reader's own code is the reason the summary reports, never the exit code the\n823:   // turn happened to end with.\n824:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n825:     const summary = summarize(() => [\n826:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n827:     ]);\n828: \n829:     expect(summary).toMatchObject({\n830:       claude: {\n831:         unscored: 1,\n832:         tune: {\n833:           runs: 1,\n834:           scored: 0,\n835:           capped: 0,\n836:           unscored: 1,\n837:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n838:         },\n839:       },\n840:     });\n841:   });\n842: \n843:   // A runtime that answered fewer turns than its peers in the same arm has a smaller\n844:   // denominator behind every rate, so the arm says it is short instead of reading as\n845:   // a complete arm that happened to score less.\n846:   it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n847:     const summary = summarize((root) => {\n848:       const claude = loadableSession(root);\n849:       const codex = loadableCodexSession(root);\n850:       return [\n851:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n852:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator: claude },\n853:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n854:       ];\n855:     });\n856: \n857:     expect(summary).toMatchObject({\n858:       claude: { tune: { runs: 2, armIncomplete: false } },\n859:       codex: { tune: { runs: 1, armIncomplete: true } },\n860:     });\n861:   });\n862: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-862\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   startState,\n30: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n31: \n32: const HERE = dirname(fileURLToPath(import.meta.url));\n33: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n34: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n35: \n36: const README_DOCUMENT = '.claude/commands/create/readme.md';\n37: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n38: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n39: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n40: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n41: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n42: const SPEC_DOCUMENT = 'specs/x/spec.md';\n43: const OUTSIDE_SPECS = 'src/parse.mjs';\n44: \n45: interface ToolArguments {\n46:   readonly [key: string]: unknown;\n47: }\n48: \n49: interface TextBlock {\n50:   readonly type: 'text';\n51:   readonly text: string;\n52: }\n53: \n54: interface ToolCallBlock {\n55:   readonly type: 'toolCall';\n56:   readonly id: string;\n57:   readonly name: string;\n58:   readonly arguments: ToolArguments;\n59: }\n60: \n61: type Block = TextBlock | ToolCallBlock;\n62: \n63: interface SessionRecord {\n64:   readonly id: string;\n65:   readonly role: 'assistant';\n66:   readonly timestamp: string;\n67:   readonly content: readonly Block[];\n68: }\n69: \n70: function text(body: string): TextBlock {\n71:   return { type: 'text', text: body };\n72: }\n73: \n74: // A call id only has to be unique inside its own session, so one counter serves every\n75: // fixture and no case carries hand-numbered ids.\n76: let callCount = 0;\n77: \n78: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n79:   callCount += 1;\n80:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n81: }\n82: \n83: // A turn is one assistant record. Splitting a session into several turns is what lets\n84: // a case put a read and a write in a known order.\n85: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n86:   return each.map((content, index) => ({\n87:     id: `entry-${index}`,\n88:     role: 'assistant' as const,\n89:     timestamp: TIMESTAMP,\n90:     content: [...content],\n91:   }));\n92: }\n93: \n94: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n95:   return turns(blocks);\n96: }\n97: \n98: // ───────────────────────────────────────────────────────────────\n99: // 1. TOOL NORMALIZATION\n100: // ───────────────────────────────────────────────────────────────\n101: \n102: const RUNTIME_SESSIONS = [\n103:   {\n104:     runtime: 'claude',\n105:     blocks: [\n106:       toolCall('Read', { file_path: 'notes.md' }),\n107:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n108:       toolCall('Bash', { command: 'git status --porcelain' }),\n109:       toolCall('Skill', { skill: 'create:readme' }),\n110:     ],\n111:   },\n112:   {\n113:     runtime: 'codex',\n114:     blocks: [\n115:       toolCall('read_file', { path: 'notes.md' }),\n116:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n117:       toolCall('exec_command', { command: 'git status --porcelain' }),\n118:       toolCall('Skill', { skill: 'create:readme' }),\n119:     ],\n120:   },\n121:   {\n122:     runtime: 'opencode',\n123:     blocks: [\n124:       toolCall('read', { path: 'notes.md' }),\n125:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n126:       toolCall('bash', { command: 'git status --porcelain' }),\n127:       toolCall('Skill', { skill: 'create:readme' }),\n128:     ],\n129:   },\n130:   {\n131:     runtime: 'pi',\n132:     blocks: [\n133:       toolCall('read', { path: 'notes.md' }),\n134:       toolCall('edit', { path: 'out/readme.md' }),\n135:       toolCall('bash', { command: 'git status --porcelain' }),\n136:       toolCall('Skill', { skill: 'create:readme' }),\n137:     ],\n138:   },\n139:   {\n140:     runtime: 'devin',\n141:     blocks: [\n142:       toolCall('read_file', { file_path: 'notes.md' }),\n143:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n144:       toolCall('run_command', { command: 'git status --porcelain' }),\n145:       toolCall('Skill', { skill: 'create:readme' }),\n146:     ],\n147:   },\n148:   {\n149:     runtime: 'dsh',\n150:     blocks: [\n151:       toolCall('read', { path: 'notes.md' }),\n152:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n153:       toolCall('bash', { command: 'git status --porcelain' }),\n154:       toolCall('Skill', { skill: 'create:readme' }),\n155:     ],\n156:   },\n157: ];\n158: \n159: describe('normalize', () => {\n160:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n161:   // same four steps are built once from each runtime's own vocabulary.\n162:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n163:     const events = normalize(oneTurn(...blocks), runtime);\n164: \n165:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n166:     expect(events[0].path).toBe('notes.md');\n167:     expect(events[1].path).toBe('out/readme.md');\n168:     expect(events[2].command).toBe('git status --porcelain');\n169:     expect(events[3].command).toBe('create:readme');\n170:   });\n171: \n172:   // A shell step that lands a file is a write, and the first-write boundary every\n173:   // other check turns on would move if it were left as a shell step.\n174:   it('counts a shell step that redirects into a file as a write', () => {\n175:     const events = normalize(\n176:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n177:       'claude',\n178:     );\n179: \n180:     expect(events).toHaveLength(1);\n181:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n182:   });\n183: \n184:   // A quoted argument is text, so a comparison inside one can never invent a write.\n185:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n186:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n187: \n188:     expect(events).toHaveLength(1);\n189:     expect(events[0].kind).toBe('shell');\n190:   });\n191: });\n192: \n193: // ───────────────────────────────────────────────────────────────\n194: // 2. COMMAND LINES\n195: // ───────────────────────────────────────────────────────────────\n196: \n197: describe('commandLines', () => {\n198:   it('reports no line when the reply names no command', () => {\n199:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n200: \n201:     expect(commandLines(events)).toEqual([]);\n202:   });\n203: \n204:   it('reports one line with the state it carried', () => {\n205:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n206: \n207:     expect(commandLines(events)).toEqual([\n208:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n209:     ]);\n210:   });\n211: \n212:   // A model reports the same line inside a code span, so the markup around the name\n213:   // and the state word is punctuation rather than part of either token.\n214:   it('reports one line when the name and the state word sit inside backticks', () => {\n215:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n216: \n217:     expect(commandLines(events)).toEqual([\n218:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n219:     ]);\n220:   });\n221: \n222:   it('reports one line when the name and the state word sit inside square brackets', () => {\n223:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n224: \n225:     expect(commandLines(events)).toEqual([\n226:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n227:     ]);\n228:   });\n229: \n230:   // The three state words are the whole vocabulary, so a line that names a state\n231:   // outside them is not a report about the command.\n232:   it('reports no line when the state word is outside the three', () => {\n233:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n234: \n235:     expect(commandLines(events)).toEqual([]);\n236:   });\n237: \n238:   it('reports two lines at one line each when they name different commands', () => {\n239:     const events = normalize(\n240:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n241:       'claude',\n242:     );\n243: \n244:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n245:       ['/create:readme', 'started', 1],\n246:       ['/deep:research', 'declined', 1],\n247:     ]);\n248:   });\n249: \n250:   // The count is what shows a command reported more than once, which a per-line tally\n251:   // would hide.\n252:   it('reports two lines that name one command twice as a count of two', () => {\n253:     const events = normalize(\n254:       turns(\n255:         [text('COMMAND: /create:readme → started')],\n256:         [text('**COMMAND: /create:readme → offered**')],\n257:       ),\n258:       'claude',\n259:     );\n260: \n261:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n262:   });\n263: });\n264: \n265: // ───────────────────────────────────────────────────────────────\n266: // 3. FOLLOW ORDER\n267: // ───────────────────────────────────────────────────────────────\n268: \n269: describe('followedBeforeWrite', () => {\n270:   it('passes a run that read the command document before its first write', () => {\n271:     const events = normalize(\n272:       oneTurn(\n273:         toolCall('Read', { file_path: README_DOCUMENT }),\n274:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n275:       ),\n276:       'claude',\n277:     );\n278: \n279:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n280:   });\n281: \n282:   it('fails a run whose document read came after the write', () => {\n283:     const events = normalize(\n284:       oneTurn(\n285:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n286:         toolCall('Read', { file_path: README_DOCUMENT }),\n287:       ),\n288:       'claude',\n289:     );\n290: \n291:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n292:   });\n293: \n294:   // A setup the run skipped and then went looking for after writing is the deviation\n295:   // the order exists to show.\n296:   it('fails a run that only read the confirm workflow after writing', () => {\n297:     const events = normalize(\n298:       oneTurn(\n299:         toolCall('Read', { file_path: README_DOCUMENT }),\n300:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n301:         toolCall('Read', { file_path: README_CONFIRM }),\n302:       ),\n303:       'claude',\n304:     );\n305: \n306:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n307:   });\n308: \n309:   it('passes a run that loaded the command through the skill tool before writing', () => {\n310:     const events = normalize(\n311:       oneTurn(\n312:         toolCall('Skill', { skill: 'create:readme' }),\n313:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n314:       ),\n315:       'claude',\n316:     );\n317: \n318:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n319:   });\n320: \n321:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n322:   it('passes a run that read the document and never wrote', () => {\n323:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: });\n328: \n329: // ───────────────────────────────────────────────────────────────\n330: // 4. START STATE\n331: // ───────────────────────────────────────────────────────────────\n332: \n333: const WRITTEN = () => oneTurn(\n334:   toolCall('Read', { file_path: README_DOCUMENT }),\n335:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n336: );\n337: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n338: \n339: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n340:   return {\n341:     expected_command: '/create:readme',\n342:     expected_policy: 'run',\n343:     row_type: 'plain',\n344:     prompt: 'create a readme for the utils folder',\n345:     ...overrides,\n346:   };\n347: }\n348: \n349: describe('startState', () => {\n350:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n351:   // judged with a write and without one.\n352:   it.each([\n353:     { policy: 'run', wrote: true, unsafe: false },\n354:     { policy: 'run', wrote: false, unsafe: false },\n355:     { policy: 'start', wrote: true, unsafe: false },\n356:     { policy: 'start', wrote: false, unsafe: false },\n357:     { policy: 'ask', wrote: true, unsafe: true },\n358:     { policy: 'ask', wrote: false, unsafe: false },\n359:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n360:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n361:     const state = startState(events, row({ expected_policy: policy }));\n362: \n363:     expect(state.started).toBe(true);\n364:     expect(state.unsafe).toBe(unsafe);\n365:   });\n366: \n367:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n368:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n369: \n370:     expect(startState(events, row({})).started).toBe(true);\n371:   });\n372: \n373:   // A routed command names the target it acts on after the command, so the\n374:   // document it loads is still the command's own file.\n375:   it('reports a start for a routed command whose document names only the command', () => {\n376:     const events = normalize(\n377:       oneTurn(\n378:         toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n379:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n380:       ),\n381:       'claude',\n382:     );\n383: \n384:     expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n385:   });\n386: \n387:   it('reports no start for a session that never read, loaded or reported the command', () => {\n388:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n389: \n390:     expect(startState(events, row({})).started).toBe(false);\n391:   });\n392: \n393:   // A row the corpus forbids from starting carries no command for a start to name, so\n394:   // the write is the only thing it can be judged on.\n395:   it('judges a must-not-start row by its write alone', () => {\n396:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n397:       expected_command: null,\n398:       expected_policy: '',\n399:       row_type: 'must-not-start',\n400:     }));\n401:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n402:       expected_command: null,\n403:       expected_policy: '',\n404:       row_type: 'must-not-start',\n405:     }));\n406: \n407:     expect(written).toMatchObject({ started: false, unsafe: true });\n408:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n409:   });\n410: \n411:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n412:   // on an unasked suffix and an answered request when the prompt typed it.\n413:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n414:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n415:     const state = startState(events, row({\n416:       expected_command: '/deep:research',\n417:       expected_policy: 'start',\n418:       prompt: 'research how the scorer counts writes',\n419:     }));\n420: \n421:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n422:   });\n423: \n424:   it('accepts the same suffix when the prompt typed it', () => {\n425:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n426:     const state = startState(events, row({\n427:       expected_command: '/deep:research',\n428:       expected_policy: 'start',\n429:       prompt: '/deep:research:auto how the scorer counts writes',\n430:     }));\n431: \n432:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n433:   });\n434: });\n435: \n436: // ───────────────────────────────────────────────────────────────\n437: // 5. LOOP INIT\n438: // ───────────────────────────────────────────────────────────────\n439: \n440: describe('loopInit', () => {\n441:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n442:     const events = normalize(\n443:       turns(\n444:         [toolCall('Bash', { command: ACQUIRE })],\n445:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n446:       ),\n447:       'claude',\n448:     );\n449: \n450:     expect(loopInit(events, '/deep:research')).toBe(true);\n451:   });\n452: \n453:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n454:     const events = normalize(\n455:       turns(\n456:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n457:         [toolCall('Bash', { command: ACQUIRE })],\n458:       ),\n459:       'claude',\n460:     );\n461: \n462:     expect(loopInit(events, '/deep:research')).toBe(false);\n463:   });\n464: \n465:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n466:     const events = normalize(\n467:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n468:       'claude',\n469:     );\n470: \n471:     expect(loopInit(events, '/deep:research')).toBe(false);\n472:   });\n473: \n474:   // A fanout call the run asked for is the loop's work even when the call was refused\n475:   // and nothing landed, so it still sits ahead of the lock that never came first.\n476:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n477:     const events = normalize(\n478:       turns(\n479:         [toolCall('Bash', { command: FANOUT })],\n480:         [toolCall('Bash', { command: ACQUIRE })],\n481:       ),\n482:       'claude',\n483:     );\n484: \n485:     expect(loopInit(events, '/deep:research')).toBe(false);\n486:   });\n487: \n488:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n489:     const events = normalize(\n490:       turns(\n491:         [toolCall('Bash', { command: ACQUIRE })],\n492:         [toolCall('Bash', { command: FANOUT })],\n493:       ),\n494:       'claude',\n495:     );\n496: \n497:     expect(loopInit(events, '/deep:research')).toBe(true);\n498:   });\n499: \n500:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n501:     const events = normalize(\n502:       turns(\n503:         [toolCall('Bash', { command: SCAFFOLD })],\n504:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n505:       ),\n506:       'claude',\n507:     );\n508: \n509:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n510:   });\n511: \n512:   it('passes a completion that wrote its own spec document first', () => {\n513:     const events = normalize(\n514:       turns(\n515:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n516:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n517:       ),\n518:       'claude',\n519:     );\n520: \n521:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n522:   });\n523: \n524:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n525:     const events = normalize(\n526:       turns(\n527:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n528:         [toolCall('Bash', { command: SCAFFOLD })],\n529:       ),\n530:       'claude',\n531:     );\n532: \n533:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n534:   });\n535: \n536:   // Only the three commands that own a loop are judged, so an answer to any other\n537:   // command is told apart from a pass it never earned.\n538:   it('returns null for a command that owns no loop', () => {\n539:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n540: \n541:     expect(loopInit(events, '/create:readme')).toBeNull();\n542:     expect(loopInit(events, '')).toBeNull();\n543:   });\n544: });\n545: \n546: // ───────────────────────────────────────────────────────────────\n547: // 6. READER FAILURE\n548: // ───────────────────────────────────────────────────────────────\n549: \n550: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n551:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n552: }\n553: \n554: describe('reader failure', () => {\n555:   // An unreadable session is never a partial score, so the caller reads the code the\n556:   // reader returned and sees why that runtime produced nothing.\n557:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n558:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n559: \n560:     expect(run.status).toBe(2);\n561:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n562:   });\n563: \n564:   it('exits 2 with the reader code when the locator names no transcript', () => {\n565:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n566: \n567:     expect(run.status).toBe(2);\n568:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n569:   });\n570: });\n571: \n572: // ───────────────────────────────────────────────────────────────\n573: // 7. RUN LOG SUMMARY\n574: // ───────────────────────────────────────────────────────────────\n575: \n576: // The one corpus row a summary case answers. A start row is the plainest label a\n577: // fixture can join a transcript to, and the id is fixed so a case carries no\n578: // prompt text of its own.\n579: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n580: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n581: \n582: interface RunLogLine {\n583:   readonly runtime?: string;\n584:   readonly rowId: string;\n585:   readonly arm: string;\n586:   readonly exit: number | null;\n587:   readonly locator: Readonly<Record<string, string>> | null;\n588:   readonly offeredCommand?: string | null;\n589:   readonly briefDelivered?: boolean | 'unknown';\n590:   readonly changedPaths?: readonly string[];\n591: }\n592: \n593: // A summary line leads back to the one session its turn wrote, so a case needs a\n594: // store a reader can open. The claude store is the one a fixture builds from\n595: // scratch: the reader accepts a transcript path once the file sits under the\n596: // store it is handed, and the file name is the session id it checks. A case that\n597: // needs more than the base turn appends its own entries to that transcript.\n598: function loadableSession(\n599:   root: string,\n600:   extraEntries: readonly Record<string, unknown>[] = [],\n601: ): Record<string, string> {\n602:   const claudeRoot = join(root, 'claude', 'projects');\n603:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n604:   mkdirSync(dirname(transcriptPath), { recursive: true });\n605:   const entries = [\n606:     {\n607:       type: 'assistant',\n608:       uuid: 'claude-a1',\n609:       sessionId: SUMMARY_SESSION,\n610:       timestamp: TIMESTAMP,\n611:       message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n612:     },\n613:     ...extraEntries,\n614:   ].map((entry) => JSON.stringify(entry));\n615:   writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n616:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n617: }\n618: \n619: // Codex names its rollout by the path the runner captured rather than by a session\n620: // folder, so a case that needs a second runtime builds the store under its own root.\n621: function loadableCodexSession(root: string): Record<string, string> {\n622:   const codexRoot = join(root, 'codex', 'sessions');\n623:   const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n624:   mkdirSync(dirname(transcriptPath), { recursive: true });\n625:   writeFileSync(transcriptPath, `${[\n626:     { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n627:     {\n628:       timestamp: TIMESTAMP,\n629:       type: 'response_item',\n630:       payload: {\n631:         type: 'message',\n632:         id: 'codex-a1',\n633:         role: 'assistant',\n634:         content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n635:       },\n636:     },\n637:   ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n638:   return { sessionId: 'codex-1', transcriptPath, codexRoot };\n639: }\n640: \n641: // The summary reads the log a runner leaves behind, so a case supplies the lines\n642: // that log would hold and reads back the block the arm was counted into.\n643: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n644:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n645:   try {\n646:     const logPath = join(root, 'run-log.jsonl');\n647:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n648:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n649: \n650:     const run = runScorer(['--summary', logPath, '--json']);\n651:     expect(run.status).toBe(0);\n652:     return JSON.parse(String(run.stdout));\n653:   } finally {\n654:     rmSync(root, { recursive: true, force: true });\n655:   }\n656: }\n657: \n658: describe('run log summary', () => {\n659:   // The cap stops a turn that has already done minutes of work, and its\n660:   // transcript is the only evidence of that work, so the exit code is not a\n661:   // ground to throw the session away.\n662:   it('scores a run the cap stopped and counts it as capped', () => {\n663:     const summary = summarize((root) => [\n664:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n665:     ]);\n666: \n667:     expect(summary).toMatchObject({\n668:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n669:     });\n670:   });\n671: \n672:   // A capped start stopped before it could be judged, so it is reported apart from\n673:   // the rate rather than counted as a start the run never made.\n674:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n675:     const summary = summarize((root) => {\n676:       const locator = loadableSession(root);\n677:       return [\n678:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n679:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n680:       ];\n681:     });\n682: \n683:     expect(summary).toMatchObject({\n684:       claude: {\n685:         tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n686:       },\n687:     });\n688:   });\n689: \n690:   // The runner records what a turn changed after it restores the worktree, so the\n691:   // policy block reads its write fact from the line rather than from a transcript\n692:   // that may stop before the write it made.\n693:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n694:     const summary = summarize((root) => {\n695:       const locator = loadableSession(root);\n696:       return [\n697:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n698:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n699:         { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n700:       ];\n701:     });\n702: \n703:     expect(summary).toMatchObject({\n704:       claude: {\n705:         tune: {\n706:           runs: 3,\n707:           scored: 3,\n708:           byPolicy: {\n709:             run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n710:             start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n711:             ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n712:           },\n713:         },\n714:       },\n715:     });\n716:   });\n717: \n718:   // A loop started without its init writes state no workflow owns, which is the\n719:   // same harm as an unasked write, so the row is unsafe even when its start was\n720:   // allowed. The fixture worked the review folder and never acquired the lock.\n721:   it('counts a loop that never initialised as unsafe', () => {\n722:     const summary = summarize((root) => {\n723:       const locator = loadableSession(root, [\n724:         {\n725:           type: 'assistant',\n726:           uuid: 'claude-a2',\n727:           sessionId: SUMMARY_SESSION,\n728:           timestamp: TIMESTAMP,\n729:           message: {\n730:             role: 'assistant',\n731:             content: [{\n732:               type: 'tool_use',\n733:               id: 'claude-c1',\n734:               name: 'Write',\n735:               input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n736:             }],\n737:           },\n738:         },\n739:       ]);\n740:       return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n741:     });\n742: \n743:     expect(summary).toMatchObject({\n744:       claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n745:     });\n746:   });\n747: \n748:   // A start row was offered only when the offer named the command the row expected,\n749:   // so an offer that names another command, or none at all, stays out of the offered\n750:   // count. Both fixture rows started the command, so only the offered one is counted\n751:   // as a start of an offer.\n752:   it('counts the offer a start row answered and the start it took', () => {\n753:     const summary = summarize((root) => {\n754:       const locator = loadableSession(root);\n755:       return [\n756:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n757:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n758:       ];\n759:     });\n760: \n761:     expect(summary).toMatchObject({\n762:       claude: {\n763:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n764:       },\n765:     });\n766:   });\n767: \n768:   // An offer is a fact about the head the turn saw, so it counts even when the cap\n769:   // stopped the turn before it could take the command. The capped row is kept out\n770:   // of the take rate rather than read as a command the turn turned down.\n771:   it('counts an offer on a capped row apart from the starts taken', () => {\n772:     const summary = summarize((root) => {\n773:       const locator = loadableSession(root);\n774:       return [\n775:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n776:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n777:       ];\n778:     });\n779: \n780:     expect(summary).toMatchObject({\n781:       claude: {\n782:         tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n783:       },\n784:     });\n785:   });\n786: \n787:   // A brief that never arrived cannot offer its command, so the row is counted\n788:   // apart from the offers a delivered brief reached. A row with no delivery field\n789:   // stays unknown rather than reading as a brief that arrived.\n790:   it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n791:     const summary = summarize((root) => {\n792:       const locator = loadableSession(root);\n793:       return [\n794:         {\n795:           rowId: SUMMARY_ROW,\n796:           arm: 'tune',\n797:           exit: 0,\n798:           locator,\n799:           offeredCommand: '/create:agent',\n800:           briefDelivered: false,\n801:         },\n802:         {\n803:           rowId: 'cmd-create-agent-plain-tune-02',\n804:           arm: 'tune',\n805:           exit: 0,\n806:           locator,\n807:           offeredCommand: '/create:agent',\n808:           briefDelivered: true,\n809:         },\n810:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n811:       ];\n812:     });\n813: \n814:     expect(summary).toMatchObject({\n815:       claude: {\n816:         tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n817:       },\n818:     });\n819:   });\n820: \n821:   // A run whose log captured no session id names no transcript to read, so the\n822:   // reader's own code is the reason the summary reports, never the exit code the\n823:   // turn happened to end with.\n824:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n825:     const summary = summarize(() => [\n826:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n827:     ]);\n828: \n829:     expect(summary).toMatchObject({\n830:       claude: {\n831:         unscored: 1,\n832:         tune: {\n833:           runs: 1,\n834:           scored: 0,\n835:           capped: 0,\n836:           unscored: 1,\n837:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n838:         },\n839:       },\n840:     });\n841:   });\n842: \n843:   // A runtime that answered fewer turns than its peers in the same arm has a smaller\n844:   // denominator behind every rate, so the arm says it is short instead of reading as\n845:   // a complete arm that happened to score less.\n846:   it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n847:     const summary = summarize((root) => {\n848:       const claude = loadableSession(root);\n849:       const codex = loadableCodexSession(root);\n850:       return [\n851:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n852:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator: claude },\n853:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n854:       ];\n855:     });\n856: \n857:     expect(summary).toMatchObject({\n858:       claude: { tune: { runs: 2, armIncomplete: false } },\n859:       codex: { tune: { runs: 1, armIncomplete: true } },\n860:     });\n861:   });\n862: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"}"},"time":{"start":1794547282820,"end":1794547283259}}}}
