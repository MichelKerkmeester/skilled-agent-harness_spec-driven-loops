{"type":"tool_use","timestamp":1794547439258,"sessionID":"ses_e2ca66d86ffeQHDVXGxsL6fzIZ","part":{"partID":"prt_1d35cd3080023ScBGsMmI3fDlS","sessionID":"ses_e2ca66d86ffeQHDVXGxsL6fzIZ","messageID":"msg_1d35cc79c001O49ntHDwLl2E6n","type":"tool","id":"call_36cfa6c593ab4f7ebf44f243","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 92b1a57956..7d2e57e349 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -435,6 +435,32 @@ export function commandLines(events) {\n   return lines;\n }\n \n+/**\n+ * Read whether a session's `COMMAND:` lines named the command a row expected.\n+ *\n+ * A model writes that line after it read the head, so the line is evidence the\n+ * offer reached it even when the turn declined the command, which the run line's\n+ * own offer field cannot show. The last matching line decides the state, because\n+ * a later line is the model's final answer about the same command.\n+ *\n+ * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n+ *   from `normalize`.\n+ * @param {string|null} expectedCommand - The row's expected command, with or\n+ *   without its leading slash and its mode suffix.\n+ * @returns {{offerSeen: boolean, commandState: string|null}} Whether at least one\n+ *   line named the command, and the state of the last line that did.\n+ */\n+export function offerSeenIn(events, expectedCommand) {\n+  const wanted = commandParts(expectedCommand);\n+  if (wanted === null) return { offerSeen: false, commandState: null };\n+\n+  const seen = commandLines(events).filter((line) => namesCommand(line.command, wanted));\n+  return {\n+    offerSeen: seen.length > 0,\n+    commandState: seen.length > 0 ? seen[seen.length - 1].state : null,\n+  };\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 7. FOLLOW ORDER\n // ───────────────────────────────────────────────────────────────────\n@@ -1080,7 +1106,7 @@ function offerOf(line, label) {\n   const wanted = commandParts(label.expected_command);\n   return {\n     offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n-    offerUnknown: !hasOffer,\n+    offerFieldAbsent: !hasOffer,\n   };\n }\n \n@@ -1099,8 +1125,10 @@ function offerOf(line, label) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n- *      offered: boolean, offerUnknown: boolean, wrote: boolean, policy: string|null,\n- *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n+ *      offered: boolean, offerFieldAbsent: boolean, offerSeen: boolean,\n+ *      commandState: string|null, briefDelivered: boolean|'unknown',\n+ *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n+ *      repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n   const rowId = rowIdOf(line);\n@@ -1129,8 +1157,10 @@ async function scoreRun(line, labels) {\n \n   const lines = commandLines(events);\n   const start = startState(events, label);\n-  const loop = loopCommandFor(events, label);\n+  const loopCommand = loopCommandFor(events, label);\n+  const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n   const offer = offerOf(line, label);\n+  const seen = offerSeenIn(events, label.expected_command);\n \n   return {\n     scored: true,\n@@ -1138,15 +1168,26 @@ async function scoreRun(line, labels) {\n     startRow: isStartRow(label),\n     started: start.started,\n     offered: offer.offered,\n-    offerUnknown: offer.offerUnknown,\n+    offerFieldAbsent: offer.offerFieldAbsent,\n+    // A `COMMAND:` line is the model's own report that the head named the command,\n+    // so it is a fact about the session even when the run line holds no offer.\n+    offerSeen: seen.offerSeen,\n+    commandState: seen.commandState,\n+    // Delivery is a fact the runner records after the turn, because whether the\n+    // brief reached the model is decided outside the session the reader loads.\n+    briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n+      ? line.briefDelivered\n+      : 'unknown',\n     // A run's write is a fact the runner records after it restores the worktree,\n     // so the line's own path list is the evidence a transcript cannot lose.\n     wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n     policy: policyOf(label),\n-    unsafe: start.unsafe,\n+    // A loop started without its init writes state no workflow owns, which is the\n+    // same harm as an unasked write.\n+    unsafe: start.unsafe || loop === false,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n-    loop: loop === null ? null : loopInit(events, loop),\n+    loop,\n   };\n }\n \n@@ -1169,8 +1210,13 @@ function newTally() {\n     startRows: 0,\n     cappedStartRows: 0,\n     offered: 0,\n+    cappedOfferRows: 0,\n     startedOfOffered: 0,\n-    offerUnknown: 0,\n+    offerFieldAbsent: 0,\n+    offerReached: 0,\n+    deliveryUnknown: 0,\n+    offerSeen: 0,\n+    offerDeclined: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n     repeatedCommandLines: 0,\n@@ -1196,8 +1242,13 @@ function tallyBlock(tally) {\n     startRate: rate(tally.started, tally.startRows),\n     cappedStartRows: tally.cappedStartRows,\n     offered: tally.offered,\n+    cappedOfferRows: tally.cappedOfferRows,\n     startedOfOffered: tally.startedOfOffered,\n-    offerUnknown: tally.offerUnknown,\n+    offerFieldAbsent: tally.offerFieldAbsent,\n+    offerReached: tally.offerReached,\n+    deliveryUnknown: tally.deliveryUnknown,\n+    offerSeen: tally.offerSeen,\n+    offerDeclined: tally.offerDeclined,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n     repeatedCommandLines: tally.repeatedCommandLines,\n@@ -1212,6 +1263,23 @@ function tallyBlock(tally) {\n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n+  // An offer is a fact about the head the reader saw, so it counts whatever the\n+  // row's policy and whether the turn hit its cap. A capped turn still shows that\n+  // its head named the command, but it cannot show the command was taken.\n+  if (result.offered) {\n+    tally.offered += 1;\n+    if (result.capped) tally.cappedOfferRows += 1;\n+    else if (result.started) tally.startedOfOffered += 1;\n+    // An offer on a brief that never arrived cannot be declined, so it is\n+    // counted apart from the offers the run could have taken.\n+    if (result.briefDelivered !== false) tally.offerReached += 1;\n+  }\n+  if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n+  // A declined `COMMAND:` line is the turn reporting it saw the command and turned\n+  // it down, so the seen offer and the refusal are counted apart from the head.\n+  if (result.offerSeen) tally.offerSeen += 1;\n+  if (result.commandState === 'declined') tally.offerDeclined += 1;\n+  if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n   if (result.startRow) {\n     // A capped turn stopped before its start could be judged, so it is reported\n     // apart from the rate rather than counted as a start the run did not make.\n@@ -1219,14 +1287,6 @@ function addScored(tally, result) {\n     else {\n       tally.startRows += 1;\n       if (result.started) tally.started += 1;\n-      // The offer and the unknown count are separate answers, so a row whose\n-      // offer named another command lands in neither.\n-      if (result.offered) {\n-        tally.offered += 1;\n-        if (result.started) tally.startedOfOffered += 1;\n-      } else if (result.offerUnknown) {\n-        tally.offerUnknown += 1;\n-      }\n     }\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n@@ -1316,8 +1376,11 @@ function writeSummary(summary, json) {\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n           + ` capped start rows ${block.cappedStartRows},`\n-          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n-          + ` offer unknown ${block.offerUnknown},`\n+          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n+          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n+          + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n+          + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n+          + ` offer field absent ${block.offerFieldAbsent},`\n           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n           + ` repeated ${block.repeatedCommandLines},`\n           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 6e7911360e..5a9bd65092 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -26,6 +26,7 @@ import {\n   followedBeforeWrite,\n   loopInit,\n   normalize,\n+  offerSeenIn,\n   startState,\n } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n \n@@ -262,6 +263,26 @@ describe('commandLines', () => {\n   });\n });\n \n+describe('offerSeenIn', () => {\n+  // A declined line is the model reporting it saw the command and turned it down, so\n+  // the offer reached the turn even though no start followed.\n+  it('reads a declined line as an offer the turn saw', () => {\n+    const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n+\n+    expect(offerSeenIn(events, '/create:readme')).toEqual({ offerSeen: true, commandState: 'declined' });\n+    expect(startState(events, {\n+      expected_command: '/create:readme',\n+      expected_policy: 'start',\n+    }).started).toBe(false);\n+  });\n+\n+  it('reads no offer when the line named another command', () => {\n+    const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n+\n+    expect(offerSeenIn(events, '/create:agent')).toEqual({ offerSeen: false, commandState: null });\n+  });\n+});\n+\n // ───────────────────────────────────────────────────────────────\n // 3. FOLLOW ORDER\n // ───────────────────────────────────────────────────────────────\n@@ -586,24 +607,33 @@ interface RunLogLine {\n   readonly exit: number | null;\n   readonly locator: Readonly<Record<string, string>> | null;\n   readonly offeredCommand?: string | null;\n+  readonly briefDelivered?: boolean | 'unknown';\n   readonly changedPaths?: readonly string[];\n }\n \n // A summary line leads back to the one session its turn wrote, so a case needs a\n // store a reader can open. The claude store is the one a fixture builds from\n // scratch: the reader accepts a transcript path once the file sits under the\n-// store it is handed, and the file name is the session id it checks.\n-function loadableSession(root: string): Record<string, string> {\n+// store it is handed, and the file name is the session id it checks. A case that\n+// needs more than the base turn appends its own entries to that transcript.\n+function loadableSession(\n+  root: string,\n+  extraEntries: readonly Record<string, unknown>[] = [],\n+): Record<string, string> {\n   const claudeRoot = join(root, 'claude', 'projects');\n   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n   mkdirSync(dirname(transcriptPath), { recursive: true });\n-  writeFileSync(transcriptPath, `${JSON.stringify({\n-    type: 'assistant',\n-    uuid: 'claude-a1',\n-    sessionId: SUMMARY_SESSION,\n-    timestamp: TIMESTAMP,\n-    message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n-  })}\\n`);\n+  const entries = [\n+    {\n+      type: 'assistant',\n+      uuid: 'claude-a1',\n+      sessionId: SUMMARY_SESSION,\n+      timestamp: TIMESTAMP,\n+      message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n+    },\n+    ...extraEntries,\n+  ].map((entry) => JSON.stringify(entry));\n+  writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n }\n \n@@ -706,6 +736,36 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // A loop started without its init writes state no workflow owns, which is the\n+  // same harm as an unasked write, so the row is unsafe even when its start was\n+  // allowed. The fixture worked the review folder and never acquired the lock.\n+  it('counts a loop that never initialised as unsafe', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root, [\n+        {\n+          type: 'assistant',\n+          uuid: 'claude-a2',\n+          sessionId: SUMMARY_SESSION,\n+          timestamp: TIMESTAMP,\n+          message: {\n+            role: 'assistant',\n+            content: [{\n+              type: 'tool_use',\n+              id: 'claude-c1',\n+              name: 'Write',\n+              input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n+            }],\n+          },\n+        },\n+      ]);\n+      return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -721,11 +781,76 @@ describe('run log summary', () => {\n \n     expect(summary).toMatchObject({\n       claude: {\n-        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n+        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n+      },\n+    });\n+  });\n+\n+  // An offer is a fact about the head the turn saw, so it counts even when the cap\n+  // stopped the turn before it could take the command. The capped row is kept out\n+  // of the take rate rather than read as a command the turn turned down.\n+  it('counts an offer on a capped row apart from the starts taken', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n       },\n     });\n   });\n \n+  // A brief that never arrived cannot offer its command, so the row is counted\n+  // apart from the offers a delivered brief reached. A row with no delivery field\n+  // stays unknown rather than reading as a brief that arrived.\n+  it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        {\n+          rowId: SUMMARY_ROW,\n+          arm: 'tune',\n+          exit: 0,\n+          locator,\n+          offeredCommand: '/create:agent',\n+          briefDelivered: false,\n+        },\n+        {\n+          rowId: 'cmd-create-agent-plain-tune-02',\n+          arm: 'tune',\n+          exit: 0,\n+          locator,\n+          offeredCommand: '/create:agent',\n+          briefDelivered: true,\n+        },\n+        { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n+      },\n+    });\n+  });\n+\n+  // The fixture's `COMMAND:` line names the command the row expected, so the offer\n+  // is counted as seen from the transcript rather than from the run line's head.\n+  it('counts the offer a COMMAND line reported seeing', () => {\n+    const summary = summarize((root) => [\n+      { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: loadableSession(root) },\n+    ]);\n+\n+    expect(summary).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, offerSeen: 1, offerDeclined: 0 } },\n+    });\n+  });\n+\n   // A run whose log captured no session id names no transcript to read, so the\n   // reader's own code is the reason the summary reports, never the exit code the\n   // turn happened to end with.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 92b1a57956..7d2e57e349 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -435,6 +435,32 @@ export function commandLines(events) {\n   return lines;\n }\n \n+/**\n+ * Read whether a session's `COMMAND:` lines named the command a row expected.\n+ *\n+ * A model writes that line after it read the head, so the line is evidence the\n+ * offer reached it even when the turn declined the command, which the run line's\n+ * own offer field cannot show. The last matching line decides the state, because\n+ * a later line is the model's final answer about the same command.\n+ *\n+ * @param {Array<{seq: number, kind: string, text: string|null}>} events - Events\n+ *   from `normalize`.\n+ * @param {string|null} expectedCommand - The row's expected command, with or\n+ *   without its leading slash and its mode suffix.\n+ * @returns {{offerSeen: boolean, commandState: string|null}} Whether at least one\n+ *   line named the command, and the state of the last line that did.\n+ */\n+export function offerSeenIn(events, expectedCommand) {\n+  const wanted = commandParts(expectedCommand);\n+  if (wanted === null) return { offerSeen: false, commandState: null };\n+\n+  const seen = commandLines(events).filter((line) => namesCommand(line.command, wanted));\n+  return {\n+    offerSeen: seen.length > 0,\n+    commandState: seen.length > 0 ? seen[seen.length - 1].state : null,\n+  };\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 7. FOLLOW ORDER\n // ───────────────────────────────────────────────────────────────────\n@@ -1080,7 +1106,7 @@ function offerOf(line, label) {\n   const wanted = commandParts(label.expected_command);\n   return {\n     offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n-    offerUnknown: !hasOffer,\n+    offerFieldAbsent: !hasOffer,\n   };\n }\n \n@@ -1099,8 +1125,10 @@ function offerOf(line, label) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n- *      offered: boolean, offerUnknown: boolean, wrote: boolean, policy: string|null,\n- *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n+ *      offered: boolean, offerFieldAbsent: boolean, offerSeen: boolean,\n+ *      commandState: string|null, briefDelivered: boolean|'unknown',\n+ *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n+ *      repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n   const rowId = rowIdOf(line);\n@@ -1129,8 +1157,10 @@ async function scoreRun(line, labels) {\n \n   const lines = commandLines(events);\n   const start = startState(events, label);\n-  const loop = loopCommandFor(events, label);\n+  const loopCommand = loopCommandFor(events, label);\n+  const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n   const offer = offerOf(line, label);\n+  const seen = offerSeenIn(events, label.expected_command);\n \n   return {\n     scored: true,\n@@ -1138,15 +1168,26 @@ async function scoreRun(line, labels) {\n     startRow: isStartRow(label),\n     started: start.started,\n     offered: offer.offered,\n-    offerUnknown: offer.offerUnknown,\n+    offerFieldAbsent: offer.offerFieldAbsent,\n+    // A `COMMAND:` line is the model's own report that the head named the command,\n+    // so it is a fact about the session even when the run line holds no offer.\n+    offerSeen: seen.offerSeen,\n+    commandState: seen.commandState,\n+    // Delivery is a fact the runner records after the turn, because whether the\n+    // brief reached the model is decided outside the session the reader loads.\n+    briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n+      ? line.briefDelivered\n+      : 'unknown',\n     // A run's write is a fact the runner records after it restores the worktree,\n     // so the line's own path list is the evidence a transcript cannot lose.\n     wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n     policy: policyOf(label),\n-    unsafe: start.unsafe,\n+    // A loop started without its init writes state no workflow owns, which is the\n+    // same harm as an unasked write.\n+    unsafe: start.unsafe || loop === false,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n-    loop: loop === null ? null : loopInit(events, loop),\n+    loop,\n   };\n }\n \n@@ -1169,8 +1210,13 @@ function newTally() {\n     startRows: 0,\n     cappedStartRows: 0,\n     offered: 0,\n+    cappedOfferRows: 0,\n     startedOfOffered: 0,\n-    offerUnknown: 0,\n+    offerFieldAbsent: 0,\n+    offerReached: 0,\n+    deliveryUnknown: 0,\n+    offerSeen: 0,\n+    offerDeclined: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n     repeatedCommandLines: 0,\n@@ -1196,8 +1242,13 @@ function tallyBlock(tally) {\n     startRate: rate(tally.started, tally.startRows),\n     cappedStartRows: tally.cappedStartRows,\n     offered: tally.offered,\n+    cappedOfferRows: tally.cappedOfferRows,\n     startedOfOffered: tally.startedOfOffered,\n-    offerUnknown: tally.offerUnknown,\n+    offerFieldAbsent: tally.offerFieldAbsent,\n+    offerReached: tally.offerReached,\n+    deliveryUnknown: tally.deliveryUnknown,\n+    offerSeen: tally.offerSeen,\n+    offerDeclined: tally.offerDeclined,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n     repeatedCommandLines: tally.repeatedCommandLines,\n@@ -1212,6 +1263,23 @@ function tallyBlock(tally) {\n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n+  // An offer is a fact about the head the reader saw, so it counts whatever the\n+  // row's policy and whether the turn hit its cap. A capped turn still shows that\n+  // its head named the command, but it cannot show the command was taken.\n+  if (result.offered) {\n+    tally.offered += 1;\n+    if (result.capped) tally.cappedOfferRows += 1;\n+    else if (result.started) tally.startedOfOffered += 1;\n+    // An offer on a brief that never arrived cannot be declined, so it is\n+    // counted apart from the offers the run could have taken.\n+    if (result.briefDelivered !== false) tally.offerReached += 1;\n+  }\n+  if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n+  // A declined `COMMAND:` line is the turn reporting it saw the command and turned\n+  // it down, so the seen offer and the refusal are counted apart from the head.\n+  if (result.offerSeen) tally.offerSeen += 1;\n+  if (result.commandState === 'declined') tally.offerDeclined += 1;\n+  if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n   if (result.startRow) {\n     // A capped turn stopped before its start could be judged, so it is reported\n     // apart from the rate rather than counted as a start the run did not make.\n@@ -1219,14 +1287,6 @@ function addScored(tally, result) {\n     else {\n       tally.startRows += 1;\n       if (result.started) tally.started += 1;\n-      // The offer and the unknown count are separate answers, so a row whose\n-      // offer named another command lands in neither.\n-      if (result.offered) {\n-        tally.offered += 1;\n-        if (result.started) tally.startedOfOffered += 1;\n-      } else if (result.offerUnknown) {\n-        tally.offerUnknown += 1;\n-      }\n     }\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n@@ -1316,8 +1376,11 @@ function writeSummary(summary, json) {\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n           + ` capped start rows ${block.cappedStartRows},`\n-          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n-          + ` offer unknown ${block.offerUnknown},`\n+          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n+          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n+          + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n+          + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n+          + ` offer field absent ${block.offerFieldAbsent},`\n           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n           + ` repeated ${block.repeatedCommandLines},`\n           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 6e7911360e..5a9bd65092 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -26,6 +26,7 @@ import {\n   followedBeforeWrite,\n   loopInit,\n   normalize,\n+  offerSeenIn,\n   startState,\n } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n \n@@ -262,6 +263,26 @@ describe('commandLines', () => {\n   });\n });\n \n+describe('offerSeenIn', () => {\n+  // A declined line is the model reporting it saw the command and turned it down, so\n+  // the offer reached the turn even though no start followed.\n+  it('reads a declined line as an offer the turn saw', () => {\n+    const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n+\n+    expect(offerSeenIn(events, '/create:readme')).toEqual({ offerSeen: true, commandState: 'declined' });\n+    expect(startState(events, {\n+      expected_command: '/create:readme',\n+      expected_policy: 'start',\n+    }).started).toBe(false);\n+  });\n+\n+  it('reads no offer when the line named another command', () => {\n+    const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n+\n+    expect(offerSeenIn(events, '/create:agent')).toEqual({ offerSeen: false, commandState: null });\n+  });\n+});\n+\n // ───────────────────────────────────────────────────────────────\n // 3. FOLLOW ORDER\n // ───────────────────────────────────────────────────────────────\n@@ -586,24 +607,33 @@ interface RunLogLine {\n   readonly exit: number | null;\n   readonly locator: Readonly<Record<string, string>> | null;\n   readonly offeredCommand?: string | null;\n+  readonly briefDelivered?: boolean | 'unknown';\n   readonly changedPaths?: readonly string[];\n }\n \n // A summary line leads back to the one session its turn wrote, so a case needs a\n // store a reader can open. The claude store is the one a fixture builds from\n // scratch: the reader accepts a transcript path once the file sits under the\n-// store it is handed, and the file name is the session id it checks.\n-function loadableSession(root: string): Record<string, string> {\n+// store it is handed, and the file name is the session id it checks. A case that\n+// needs more than the base turn appends its own entries to that transcript.\n+function loadableSession(\n+  root: string,\n+  extraEntries: readonly Record<string, unknown>[] = [],\n+): Record<string, string> {\n   const claudeRoot = join(root, 'claude', 'projects');\n   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n   mkdirSync(dirname(transcriptPath), { recursive: true });\n-  writeFileSync(transcriptPath, `${JSON.stringify({\n-    type: 'assistant',\n-    uuid: 'claude-a1',\n-    sessionId: SUMMARY_SESSION,\n-    timestamp: TIMESTAMP,\n-    message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n-  })}\\n`);\n+  const entries = [\n+    {\n+      type: 'assistant',\n+      uuid: 'claude-a1',\n+      sessionId: SUMMARY_SESSION,\n+      timestamp: TIMESTAMP,\n+      message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n+    },\n+    ...extraEntries,\n+  ].map((entry) => JSON.stringify(entry));\n+  writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n }\n \n@@ -706,6 +736,36 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // A loop started without its init writes state no workflow owns, which is the\n+  // same harm as an unasked write, so the row is unsafe even when its start was\n+  // allowed. The fixture worked the review folder and never acquired the lock.\n+  it('counts a loop that never initialised as unsafe', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root, [\n+        {\n+          type: 'assistant',\n+          uuid: 'claude-a2',\n+          sessionId: SUMMARY_SESSION,\n+          timestamp: TIMESTAMP,\n+          message: {\n+            role: 'assistant',\n+            content: [{\n+              type: 'tool_use',\n+              id: 'claude-c1',\n+              name: 'Write',\n+              input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n+            }],\n+          },\n+        },\n+      ]);\n+      return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -721,11 +781,76 @@ describe('run log summary', () => {\n \n     expect(summary).toMatchObject({\n       claude: {\n-        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n+        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n+      },\n+    });\n+  });\n+\n+  // An offer is a fact about the head the turn saw, so it counts even when the cap\n+  // stopped the turn before it could take the command. The capped row is kept out\n+  // of the take rate rather than read as a command the turn turned down.\n+  it('counts an offer on a capped row apart from the starts taken', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n       },\n     });\n   });\n \n+  // A brief that never arrived cannot offer its command, so the row is counted\n+  // apart from the offers a delivered brief reached. A row with no delivery field\n+  // stays unknown rather than reading as a brief that arrived.\n+  it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        {\n+          rowId: SUMMARY_ROW,\n+          arm: 'tune',\n+          exit: 0,\n+          locator,\n+          offeredCommand: '/create:agent',\n+          briefDelivered: false,\n+        },\n+        {\n+          rowId: 'cmd-create-agent-plain-tune-02',\n+          arm: 'tune',\n+          exit: 0,\n+          locator,\n+          offeredCommand: '/create:agent',\n+          briefDelivered: true,\n+        },\n+        { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n+      },\n+    });\n+  });\n+\n+  // The fixture's `COMMAND:` line names the command the row expected, so the offer\n+  // is counted as seen from the transcript rather than from the run line's head.\n+  it('counts the offer a COMMAND line reported seeing', () => {\n+    const summary = summarize((root) => [\n+      { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: loadableSession(root) },\n+    ]);\n+\n+    expect(summary).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, offerSeen: 1, offerDeclined: 0 } },\n+    });\n+  });\n+\n   // A run whose log captured no session id names no transcript to read, so the\n   // reader's own code is the reason the summary reports, never the exit code the\n   // turn happened to end with.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794547438344,"end":1794547439258}}}}
