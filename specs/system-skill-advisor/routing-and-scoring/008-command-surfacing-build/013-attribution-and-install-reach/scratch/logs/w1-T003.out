{"type":"tool_use","timestamp":1794545792241,"sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","part":{"partID":"prt_1d343b28f001yTY10zeYfp25Wg","sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","messageID":"msg_1d343a88a001H7wOoc1Xg6npn2","type":"tool","id":"call_b8b51aa34fae4fddacbe43e6","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs, lines 1-200\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Injected User Text Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // Every runtime injects harness context alongside operator prompts. A reader\n5: // may drop that injected content, but only where the store or a known tag says\n6: // it is injected; operator text that merely opens with '<' must survive.\n7: \n8: import assert from 'node:assert/strict';\n9: import { appendFileSync, mkdirSync, readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: import { DatabaseSync } from 'node:sqlite';\n12: import { test } from 'node:test';\n13: \n14: import { readSession } from '../../session-readers/index.mjs';\n15: import {\n16:   codexSession,\n17:   devinSession,\n18:   dshSession,\n19:   NOW,\n20:   opencodeSession,\n21:   piSession,\n22:   SESSION,\n23:   T0,\n24: } from './fixtures.mjs';\n25: import { withTempAsync, writeJson } from './helpers.mjs';\n26: \n27: function appendJsonLines(filePath, rows) {\n28:   appendFileSync(filePath, rows.map((row) => `${JSON.stringify(row)}\\n`).join(''));\n29: }\n30: \n31: test('Codex keeps operator text that opens with a tag and drops only injected context', async () => {\n32:   await withTempAsync('codex-injected-text', async (root) => {\n33:     const fixture = codexSession({ root });\n34:     appendJsonLines(fixture.filePath, [\n35:       {\n36:         timestamp: NOW,\n37:         type: 'response_item',\n38:         payload: {\n39:           type: 'message',\n40:           id: 'codex-environment',\n41:           role: 'user',\n42:           content: [{ type: 'input_text', text: '<environment_context>\\n<cwd>/workspace</cwd>\\n</environment_context>' }],\n43:         },\n44:       },\n45:       {\n46:         timestamp: NOW,\n47:         type: 'response_item',\n48:         payload: {\n49:           type: 'message',\n50:           id: 'codex-instructions',\n51:           role: 'user',\n52:           content: [{ type: 'input_text', text: '<user_instructions>Attached instructions.</user_instructions>' }],\n53:         },\n54:       },\n55:       {\n56:         timestamp: NOW,\n57:         type: 'response_item',\n58:         payload: {\n59:           type: 'message',\n60:           id: 'codex-permissions',\n61:           role: 'user',\n62:           content: [{ type: 'input_text', text: '<permissions instructions>Sandboxed.</permissions instructions>' }],\n63:         },\n64:       },\n65:       {\n66:         timestamp: NOW,\n67:         type: 'response_item',\n68:         payload: {\n69:           type: 'message',\n70:           id: 'codex-div',\n71:           role: 'user',\n72:           content: [{ type: 'input_text', text: '<div>hello</div>' }],\n73:         },\n74:       },\n75:     ]);\n76: \n77:     const result = await readSession({ runtime: 'codex', sessionId: SESSION, ...fixture.options });\n78:     assert.equal(result.ok, true);\n79:     const ids = result.items.map((item) => item.id);\n80:     assert.equal(ids.includes('codex-environment'), false);\n81:     assert.equal(ids.includes('codex-instructions'), false);\n82:     assert.equal(ids.includes('codex-permissions'), false);\n83:     assert.equal(result.items.find((item) => item.id === 'codex-div')?.content[0].text, '<div>hello</div>');\n84:   });\n85: });\n86: \n87: test('Pi keeps operator text that opens with a tag and ignores custom messages', async () => {\n88:   await withTempAsync('pi-injected-text', async (root) => {\n89:     const projectDir = join(root, 'project');\n90:     mkdirSync(projectDir, { recursive: true });\n91:     const fixture = piSession({ root, projectDir });\n92:     appendJsonLines(fixture.filePath, [\n93:       {\n94:         type: 'custom_message',\n95:         customType: 'session-start-context',\n96:         id: 'pi-context',\n97:         timestamp: NOW,\n98:         content: '<system-reminder>injected</system-reminder>',\n99:       },\n100:       {\n101:         type: 'message',\n102:         id: 'pi-div',\n103:         timestamp: NOW,\n104:         message: { role: 'user', content: [{ type: 'text', text: '<div>hello</div>' }] },\n105:       },\n106:     ]);\n107: \n108:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n109:     assert.equal(result.ok, true);\n110:     assert.equal(result.items.some((item) => item.id === 'pi-context'), false);\n111:     assert.equal(result.items.find((item) => item.id === 'pi-div')?.content[0].text, '<div>hello</div>');\n112:   });\n113: });\n114: \n115: test('Devin keeps an operator step that opens with a tag and ignores system steps in a transcript-only store', async () => {\n116:   await withTempAsync('devin-injected-text', async (root) => {\n117:     const projectDir = join(root, 'project');\n118:     mkdirSync(projectDir, { recursive: true });\n119:     const fixture = devinSession({ root, projectDir, withSessionsRow: false });\n120:     const transcript = JSON.parse(readFileSync(fixture.filePath, 'utf8'));\n121:     transcript.steps.push(\n122:       { step_id: 90, timestamp: NOW, source: 'system', message: '<system>injected</system>' },\n123:       { step_id: 91, timestamp: NOW, source: 'user', message: '<div>hello</div>' },\n124:     );\n125:     writeJson(fixture.filePath, transcript);\n126: \n127:     const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n128:     assert.equal(result.ok, true);\n129:     assert.equal(result.items.some((item) => item.id === 'devin-90'), false);\n130:     assert.equal(result.items.find((item) => item.id === 'devin-91')?.content[0].text, '<div>hello</div>');\n131:   });\n132: });\n133: \n134: test('DSH keeps an operator message that opens with a tag and ignores injected source kinds', async () => {\n135:   await withTempAsync('dsh-injected-text', async (root) => {\n136:     const projectDir = join(root, 'project');\n137:     mkdirSync(projectDir, { recursive: true });\n138:     const fixture = dshSession({ root, projectDir });\n139:     appendJsonLines(fixture.filePath, [\n140:       {\n141:         type: 'user/message',\n142:         seq: 5,\n143:         data: {\n144:           role: 'user',\n145:           id: 'dsh-injected',\n146:           source: { kind: 'repo-guards' },\n147:           content: [{ type: 'text', text: '<system>injected</system>' }],\n148:         },\n149:       },\n150:       {\n151:         type: 'user/message',\n152:         seq: 6,\n153:         data: {\n154:           role: 'user',\n155:           id: 'dsh-div',\n156:           source: { kind: 'user' },\n157:           content: [{ type: 'text', text: '<div>hello</div>' }],\n158:         },\n159:       },\n160:     ]);\n161: \n162:     const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n163:     assert.equal(result.ok, true);\n164:     assert.equal(result.items.some((item) => item.id === 'dsh-injected'), false);\n165:     assert.equal(result.items.find((item) => item.id === 'dsh-div')?.content[0].text, '<div>hello</div>');\n166:   });\n167: });\n168: \n169: test('OpenCode keeps an operator row that opens with a tag and ignores synthetic rows', async () => {\n170:   await withTempAsync('opencode-injected-text', async (root) => {\n171:     const fixture = opencodeSession({ root });\n172:     const database = new DatabaseSync(fixture.dbPath);\n173:     try {\n174:       const insert = database.prepare(\n175:         'INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)',\n176:       );\n177:       insert.run(\n178:         'oc-synthetic',\n179:         SESSION,\n180:         'synthetic',\n181:         3,\n182:         JSON.stringify({ text: '<system>injected</system>', time: { created: T0 + 3000 } }),\n183:       );\n184:       insert.run(\n185:         'oc-div',\n186:         SESSION,\n187:         'user',\n188:         4,\n189:         JSON.stringify({ text: '<div>hello</div>', time: { created: T0 + 4000 } }),\n190:       );\n191:     } finally {\n192:       database.close();\n193:     }\n194: \n195:     const result = await readSession({ runtime: 'opencode', sessionId: SESSION, ...fixture.options });\n196:     assert.equal(result.ok, true);\n197:     assert.equal(result.items.some((item) => item.id === 'oc-synthetic'), false);\n198:     assert.equal(result.items.find((item) => item.id === 'oc-div')?.content[0].text, '<div>hello</div>');\n199:   });\n200: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs, lines 1-200\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Injected User Text Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // Every runtime injects harness context alongside operator prompts. A reader\n5: // may drop that injected content, but only where the store or a known tag says\n6: // it is injected; operator text that merely opens with '<' must survive.\n7: \n8: import assert from 'node:assert/strict';\n9: import { appendFileSync, mkdirSync, readFileSync } from 'node:fs';\n10: import { join } from 'nod