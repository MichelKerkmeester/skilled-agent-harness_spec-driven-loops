{"type":"tool_use","timestamp":1794545755217,"sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","part":{"partID":"prt_1d34322d6001fMxuJtN0W3rgvE","sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","messageID":"msg_1d3430fb1001FR2zwmzpgfsnIz","type":"tool","id":"call_f7b8135baf5c439a897bbe4b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/project.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/project.mjs, lines 1-229\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Projection\n3: // ───────────────────────────────────────────────────────────────────\n4: // Readers hand over neutral entries in the store's own order. This module\n5: // owns the one entry-list contract those entries become: stable ids, a\n6: // zero-based sequence, an ISO timestamp, role-discriminated content blocks,\n7: // and the tool-call/result pairing rule. A pairing defect fails the whole\n8: // read so a caller never receives a partial conversation.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. CONSTANTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: export const PROJECTION_ERRORS = Object.freeze({\n15:   DUPLICATE_ENTRY_ID: 'DUPLICATE_ENTRY_ID',\n16:   INVALID_ENTRY: 'INVALID_ENTRY',\n17:   DUPLICATE_TOOL_CALL: 'DUPLICATE_TOOL_CALL',\n18:   ORPHAN_TOOL_RESULT: 'ORPHAN_TOOL_RESULT',\n19:   DUPLICATE_TOOL_RESULT: 'DUPLICATE_TOOL_RESULT',\n20:   MISMATCHED_TOOL_RESULT: 'MISMATCHED_TOOL_RESULT',\n21:   INCOMPLETE_TOOL_RESULTS: 'INCOMPLETE_TOOL_RESULTS',\n22: });\n23: \n24: const ROLES = new Set(['user', 'assistant', 'toolResult']);\n25: const MAX_ID_LENGTH = 128;\n26: const EPOCH = new Date(0).toISOString();\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 2. BLOCK HELPERS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: export function textBlock(text) {\n33:   return { type: 'text', text: String(text) };\n34: }\n35: \n36: export function thinkingBlock(thinking) {\n37:   return { type: 'thinking', thinking: String(thinking) };\n38: }\n39: \n40: export function toolCallBlock({ id, name, arguments: args } = {}) {\n41:   return {\n42:     type: 'toolCall',\n43:     id: String(id),\n44:     name: String(name),\n45:     arguments: args && typeof args === 'object' && !Array.isArray(args) ? args : {},\n46:   };\n47: }\n48: \n49: export function imageBlock({ data, mimeType } = {}) {\n50:   return { type: 'image', data: String(data), mimeType: String(mimeType) };\n51: }\n52: \n53: function isRecord(value) {\n54:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n55: }\n56: \n57: function validBlock(block) {\n58:   if (!isRecord(block) || typeof block.type !== 'string') return false;\n59:   if (block.type === 'text') return typeof block.text === 'string';\n60:   if (block.type === 'thinking') return typeof block.thinking === 'string';\n61:   if (block.type === 'toolCall') {\n62:     return typeof block.id === 'string'\n63:       && block.id.length > 0\n64:       && typeof block.name === 'string'\n65:       && block.name.length > 0\n66:       && isRecord(block.arguments);\n67:   }\n68:   if (block.type === 'image') {\n69:     return typeof block.data === 'string' && typeof block.mimeType === 'string';\n70:   }\n71:   return false;\n72: }\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 3. STORE PARSING HELPERS\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: export function parseJsonObject(value) {\n79:   if (typeof value !== 'string' || !value.trim()) return null;\n80:   try {\n81:     const parsed = JSON.parse(value);\n82:     return isRecord(parsed) ? parsed : null;\n83:   } catch {\n84:     return null;\n85:   }\n86: }\n87: \n88: // A killed process can leave a torn final line, so a malformed line is skipped\n89: // rather than failing a read that still holds every complete entry.\n90: export function parseJsonLines(text) {\n91:   const lines = [];\n92:   for (const line of String(text).split('\\n')) {\n93:     if (!line.trim()) continue;\n94:     const parsed = parseJsonObject(line);\n95:     if (parsed) lines.push(parsed);\n96:   }\n97:   return lines;\n98: }\n99: \n100: export function contentText(content) {\n101:   if (typeof content === 'string') return content;\n102:   if (!Array.isArray(content)) return '';\n103:   return content\n104:     .filter((item) => isRecord(item) && item.type === 'text' && typeof item.text === 'string')\n105:     .map((item) => item.text)\n106:     .join('\\n');\n107: }\n108: \n109: // ─────────────────────────────────────────────────────────────────────────────\n110: // 4. TIMESTAMP NORMALIZATION\n111: // ─────────────────────────────────────────────────────────────────────────────\n112: \n113: export function isoOr(value, fallback = EPOCH) {\n114:   if (typeof value === 'string' && value.trim()) {\n115:     const parsed = Date.parse(value);\n116:     if (!Number.isNaN(parsed)) return new Date(parsed).toISOString();\n117:   }\n118:   if (typeof value === 'number' && Number.isFinite(value)) {\n119:     // A finite number can still sit outside the Date range, so the constructed\n120:     // date is checked before serializing rather than trusting the guard alone.\n121:     const date = new Date(value);\n122:     if (!Number.isNaN(date.getTime())) return date.toISOString();\n123:   }\n124:   return fallback;\n125: }\n126: \n127: // ─────────────────────────────────────────────────────────────────────────────\n128: // 5. PAIRING VALIDATION\n129: // ─────────────────────────────────────────────────────────────────────────────\n130: \n131: function fail(reason) {\n132:   return { ok: false, reason };\n133: }\n134: \n135: function checkedRecord(record) {\n136:   if (!isRecord(record)) return false;\n137:   if (typeof record.id !== 'string' || !record.id || record.id.length > MAX_ID_LENGTH) return false;\n138:   if (!ROLES.has(record.role)) return false;\n139:   if (!Array.isArray(record.content) || !record.content.every(validBlock)) return false;\n140:   if (record.role === 'toolResult') {\n141:     if (typeof record.toolCallId !== 'string' || !record.toolCallId) return false;\n142:     if (record.isError !== undefined && typeof record.isError !== 'boolean') return false;\n143:   }\n144:   return true;\n145: }\n146: \n147: // The order is the store's order. An assistant entry owns the tool results that\n148: // immediately follow it; a result that arrives without that owner, twice, or\n149: // under a call id the owner never made is a broken projection, not a skippable\n150: // line. A turn still streaming at the end of the file is the one incomplete\n151: // case that is accepted, because its result may not be written yet.\n152: export function projectEntries(records) {\n153:   if (!Array.isArray(records)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n154: \n155:   const items = [];\n156:   const seenIds = new Set();\n157:   const seenCallIds = new Set();\n158:   let lastTimestamp = EPOCH;\n159: \n160:   for (let index = 0; index < records.length; index += 1) {\n161:     const record = records[index];\n162:     if (!checkedRecord(record)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n163:     if (seenIds.has(record.id)) return fail(PROJECTION_ERRORS.DUPLICATE_ENTRY_ID);\n164:     seenIds.add(record.id);\n165: \n166:     lastTimestamp = isoOr(record.timestamp, lastTimestamp);\n167: \n168:     if (record.role !== 'assistant') {\n169:       if (record.role === 'toolResult') return fail(PROJECTION_ERRORS.ORPHAN_TOOL_RESULT);\n170:       items.push({\n171:         id: record.id,\n172:         role: record.role,\n173:         sequence: items.length,\n174:         timestamp: lastTimestamp,\n175:         content: record.content,\n176:       });\n177:       continue;\n178:     }\n179: \n180:     const calls = record.content.filter((block) => block.type === 'toolCall');\n181:     const expected = new Set();\n182:     for (const call of calls) {\n183:       if (seenCallIds.has(call.id)) return fail(PROJECTION_ERRORS.DUPLICATE_TOOL_CALL);\n184:       seenCallIds.add(call.id);\n185:       expected.add(call.id);\n186:     }\n187: \n188:     items.push({\n189:       id: record.id,\n190:       role: record.role,\n191:       sequence: items.length,\n192:       timestamp: lastTimestamp,\n193:       content: record.content,\n194:     });\n195: \n196:     const seenResults = new Set();\n197:     let cursor = index + 1;\n198:     while (cursor < records.length && isRecord(records[cursor]) && records[cursor].role === 'toolResult') {\n199:       const result = records[cursor];\n200:       if (!checkedRecord(result)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n201:       if (seenIds.has(result.id)) return fail(PROJECTION_ERRORS.DUPLICATE_ENTRY_ID);\n202:       seenIds.add(result.id);\n203: \n204:       if (!expected.has(result.toolCallId)) return fail(PROJECTION_ERRORS.MISMATCHED_TOOL_RESULT);\n205:       if (seenResults.has(result.toolCallId)) return fail(PROJECTION_ERRORS.DUPLICATE_TOOL_RESULT);\n206:       seenResults.add(result.toolCallId);\n207: \n208:       lastTimestamp = isoOr(result.timestamp, lastTimestamp);\n209:       const item = {\n210:         id: result.id,\n211:         role: 'toolResult',\n212:         sequence: items.length,\n213:         timestamp: lastTimestamp,\n214:         content: result.content,\n215:         toolCallId: result.toolCallId,\n216:       };\n217:       if (result.isError === true) item.isError = true;\n218:       items.push(item);\n219:       cursor += 1;\n220:     }\n221: \n222:     if (seenResults.size !== expected.size && cursor < records.length) {\n223:       return fail(PROJECTION_ERRORS.INCOMPLETE_TOOL_RESULTS);\n224:     }\n225:     index = cursor - 1;\n226:   }\n227: \n228:   return { ok: true, items };\n229: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/project.mjs, lines 1-229\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Projection\n3: // ───────────────────────────────────────────────────────────────────\n4: // Readers hand over neutral entries in the store's own order. This module\n5: // owns the one entry-list contract those entries become: stable ids, a\n6: // zero-based sequence, an ISO timestamp, role-discriminated content blocks,\n7: // and the tool-call/result pairing rule. A pairing defect fails the whole\n8: // read so a caller never receives a partial conversation.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. CONSTANTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: export const PROJECTION_ERRORS = Object.freeze({\n15:   DUPLICATE_ENTRY_ID: 'DUPLICATE_ENTRY_ID',\n16:   INVALID_ENTRY: 'INVALID_ENTRY',\n17:   DUPLICATE_TOOL_CALL: 'DUPLICATE_TOOL_CALL',\n18:   ORPHAN_TOOL_RESULT: 'ORPHAN_TOOL_RESULT',\n19:   DUPLICATE_TOOL_RESULT: 'DUPLICATE_TOOL_RESULT',\n20:   MISMATCHED_TOOL_RESULT: 'MISMATCHED_TOOL_RESULT',\n21:   INCOMPLETE_TOOL_RESULTS: 'INCOMPLETE_TOOL_RESULTS',\n22: });\n23: \n24: const ROLES = new Set(['user', 'assistant', 'toolResult']);\n25: const MAX_ID_LENGTH = 128;\n26: const EPOCH = new Date(0).toISOString();\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 2. BLOCK HELPERS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: export function textBlock(text) {\n33:   return { type: 'text', text: String(text) };\n34: }\n35: \n36: export function thinkingBlock(thinking) {\n37:   return { type: 'thinking', thinking: String(thinking) };\n38: }\n39: \n40: export function toolCallBlock({ id, name, arguments: args } = {}) {\n41:   return {\n42:     type: 'toolCall',\n43:     id: String(id),\n44:     name: String(name),\n45:     arguments: args && typeof args === 'object' && !Array.isArray(args) ? args : {},\n46:   };\n47: }\n48: \n49: export function imageBlock({ data, mimeType } = {}) {\n50:   return { type: 'image', data: String(data), mimeType: String(mimeType) };\n51: }\n52: \n53: function isRecord(value) {\n54:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n55: }\n56: \n57: function validBlock(block) {\n58:   if (!isRecord(block) || typeof block.type !== 'string') return false;\n59:   if (block.type === 'text') return typeof block.text === 'string';\n60:   if (block.type === 'thinking') return typeof block.thinking === 'string';\n61:   if (block.type === 'toolCall') {\n62:     return typeof block.id === 'string'\n63:       && block.id.length > 0\n64:       && typeof block.name === 'string'\n65:       && block.name.length > 0\n66:       && isRecord(block.arguments);\n67:   }\n68:   if (block.type === 'image') {\n69:     return typeof block.data === 'string' && typeof block.mimeType === 'string';\n70:   }\n71:   return false;\n72: }\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 3. STORE PARSING HELPERS\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: export function parseJsonObject(value) {\n79:   if (typeof value !== 'string' || !value.trim()) return null;\n80:   try {\n81:     const parsed = JSON.parse(value);\n82:     return isRecord(parsed) ? parsed : null;\n83:   } catch {\n84:     return null;\n85:   }\n86: }\n87: \n88: // A killed process can leave a torn final line, so a malformed line is skipped\n89: // rather than failing a read that still holds every complete entry.\n90: export function parseJsonLines(text) {\n91:   const lines = [];\n92:   for (const line of String(text).split('\\n')) {\n93:     if (!line.trim()) continue;\n94:     const parsed = parseJsonObject(line);\n95:     if (parsed) lines.push(parsed);\n96:   }\n97:   return lines;\n98: }\n99: \n100: export function contentText(content) {\n101:   if (typeof content === 'string') return content;\n102:   if (!Array.isArray(content)) return '';\n103:   return content\n104:     .filter((item) => isRecord(item) && item.type === 'text' && typeof item.text === 'string')\n105:     .map((item) => item.text)\n106:     .join('\\n');\n107: }\n108: \n109: // ─────────────────────────────────────────────────────────────────────────────\n110: // 4. TIMESTAMP NORMALIZATION\n111: // ─────────────────────────────────────────────────────────────────────────────\n112: \n113: export function isoOr(value, fallback = EPOCH) {\n114:   if (typeof value === 'string' && value.trim()) {\n115:     const parsed = Date.parse(value);\n116:     if (!Number.isNaN(parsed)) return new Date(parsed).toISOString();\n117:   }\n118:   if (typeof value === 'number' && Number.isFinite(value)) {\n119:     // A finite number can still sit outside the Date range, so the constructed\n120:     // date is checked before serializing rather than trusting the guard alone.\n121:     const date = new Date(value);\n122:     if (!Number.isNaN(date.getTime())) return date.toISOString();\n123:   }\n124:   return fallback;\n125: }\n126: \n127: // ─────────────────────────────────────────────────────────────────────────────\n128: // 5. PAIRING VALIDATION\n129: // ─────────────────────────────────────────────────────────────────────────────\n130: \n131: function fail(reason) {\n132:   return { ok: false, reason };\n133: }\n134: \n135: function checkedRecord(record) {\n136:   if (!isRecord(record)) return false;\n137:   if (typeof record.id !== 'string' || !record.id || record.id.length > MAX_ID_LENGTH) return false;\n138:   if (!ROLES.has(record.role)) return false;\n139:   if (!Array.isArray(record.content) || !record.content.every(validBlock)) return false;\n140:   if (record.role === 'toolResult') {\n141:     if (typeof record.toolCallId !== 'string' || !record.toolCallId) return false;\n142:     if (record.isError !== undefined && typeof record.isError !== 'boolean') return false;\n143:   }\n144:   return true;\n145: }\n146: \n147: // The order is the store's order. An assistant entry owns the tool results that\n148: // immediately follow it; a result that arrives without that owner, twice, or\n149: // under a call id the owner never made is a broken projection, not a skippable\n150: // line. A turn still streaming at the end of the file is the one incomplete\n151: // case that is accepted, because its result may not be written yet.\n152: export function projectEntries(records) {\n153:   if (!Array.isArray(records)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n154: \n155:   const items = [];\n156:   const seenIds = new Set();\n157:   const seenCallIds = new Set();\n158:   let lastTimestamp = EPOCH;\n159: \n160:   for (let index = 0; index < records.length; index += 1) {\n161:     const record = records[index];\n162:     if (!checkedRecord(record)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n163:     if (seenIds.has(record.id)) return fail(PROJECTION_ERRORS.DUPLICATE_ENTRY_ID);\n164:     seenIds.add(record.id);\n165: \n166:     lastTimestamp = isoOr(record.timestamp, lastTimestamp);\n167: \n168:     if (record.role !== 'assistant') {\n169:       if (record.role === 'toolResult') return fail(PROJECTION_ERRORS.ORPHAN_TOOL_RESULT);\n170:       items.push({\n171:         id: record.id,\n172:         role: record.role,\n173:         sequence: items.length,\n174:         timestamp: lastTimestamp,\n175:         content: record.content,\n176:       });\n177:       continue;\n178:     }\n179: \n180:     const calls = record.content.filter((block) => block.type === 'toolCall');\n181:     const expected = new Set();\n182:     for (const call of calls) {\n183:       if (seenCallIds.has(call.id)) return fail(PROJECTION_ERRORS.DUPLICATE_TOOL_CALL);\n184:       seenCallIds.add(call.id);\n185:       expected.add(call.id);\n186:     }\n187: \n188:     items.push({\n189:       id: record.id,\n190:       role: record.role,\n191:       sequence: items.length,\n192:       timestamp: lastTimestamp,\n193:       content: record.content,\n194:     });\n195: \n196:     const seenResults = new Set();\n197:     let cursor = index + 1;\n198:     while (cursor < records.length && isRecord(records[cursor]) && records[cursor].role === 'toolResult') {\n199:       const result = records[cursor];\n200:       if (!checkedRecord(result)) return fail(PROJECTION_ERRORS.INVALID_ENTRY);\n201:       if (seenIds.has(result.id)) return fail(PROJECTION_ERRORS.DUPLICATE_ENTRY_ID);\n202:       seenIds.add(result.id);\n203: \n204:       if (!expected.has(result.toolCallId)) return fail(PROJECTION_ERRORS.MISMATCHED_TOOL_RESULT);\n205:       if (seenResults.has(result.toolCallId)) return fail(PROJECTION_ERRORS.DUPLICATE_TOOL_RESULT);\n206:       seenResults.add(result.toolCallId);\n207: \n208:       lastTimestamp = isoOr(result.timestamp, lastTimestamp);\n209:       const item = {\n210:         id: result.id,\n211:         role: 'toolResult',\n212:         sequence: items.length,\n213:         timestamp: lastTimestamp,\n214:         content: result.content,\n215:         toolCallId: result.toolCallId,\n216:       };\n217:       if (result.isError === true) item.isError = true;\n218:       items.push(item);\n219:       cursor += 1;\n220:     }\n221: \n222:     if (seenResults.size !== expected.size && cursor < records.length) {\n223:       return fail(PROJECTION_ERRORS.INCOMPLETE_TOOL_RESULTS);\n224:     }\n225:     index = cursor - 1;\n226:   }\n227: \n228:   return { ok: true, items };\n229: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/project.mjs\"}"},"time":{"start":1794545754838,"end":1794545755217}}}}
{"type":"tool_use","timestamp":1794545755242,"sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","part":{"partID":"prt_1d3432165001uw4jEnRA36cd1V","sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","messageID":"msg_1d3430fb1001FR2zwmzpgfsnIz","type":"tool","id":"call_6ef2d062e1be4407adae8f26","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/fixtures.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/fixtures.mjs, lines 1-410\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Fixtures\n3: // ───────────────────────────────────────────────────────────────────\n4: // Each builder writes one runtime store in a temp root and returns the options\n5: // its reader needs. The shapes follow the live store contracts the decision\n6: // capture sweeps already parse, trimmed to the entries a history read needs.\n7: \n8: import { mkdirSync } from 'node:fs';\n9: import { DatabaseSync } from 'node:sqlite';\n10: import { join } from 'node:path';\n11: import { dshProjectKey } from '../../session-readers/dsh.mjs';\n12: import { piProjectDirectory } from '../../session-readers/pi.mjs';\n13: import { writeJson, writeJsonl } from './helpers.mjs';\n14: \n15: export const SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n16: export const DECOY = 'bbbbbbbb-2222-4222-8222-222222222222';\n17: export const NOW = '2026-11-07T12:00:00.000Z';\n18: export const T0 = Date.parse(NOW);\n19: \n20: function iso(offset) {\n21:   return new Date(T0 + offset).toISOString();\n22: }\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 1. CLAUDE\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: export function claudeSession({ root, sessionId = SESSION, headerId = sessionId, fileName, subagents = false, resultText = null } = {}) {\n29:   const claudeRoot = join(root, 'claude', 'projects');\n30:   const filePath = subagents\n31:     ? join(claudeRoot, sessionId, 'subagents', 'agent-1.jsonl')\n32:     : join(claudeRoot, sessionId, fileName ?? `${sessionId}.jsonl`);\n33: \n34:   writeJsonl(filePath, [\n35:     { type: 'user', uuid: 'claude-u1', sessionId: headerId, timestamp: iso(0), message: { role: 'user', content: [{ type: 'text', text: 'Read the file.' }] } },\n36:     {\n37:       type: 'assistant',\n38:       uuid: 'claude-a1',\n39:       sessionId: headerId,\n40:       timestamp: iso(1000),\n41:       message: {\n42:         role: 'assistant',\n43:         content: [\n44:           { type: 'text', text: 'Reading it now.' },\n45:           { type: 'tool_use', id: 'claude-call-1', name: 'Read', input: { path: 'file.txt' } },\n46:         ],\n47:       },\n48:     },\n49:     {\n50:       type: 'user',\n51:       uuid: 'claude-u2',\n52:       sessionId: headerId,\n53:       timestamp: iso(2000),\n54:       toolUseResult: { content: 'file contents' },\n55:       message: {\n56:         role: 'user',\n57:         content: [\n58:           ...(resultText ? [{ type: 'text', text: resultText }] : []),\n59:           { type: 'tool_result', tool_use_id: 'claude-call-1', content: 'file contents' },\n60:         ],\n61:       },\n62:     },\n63:     {\n64:       type: 'assistant',\n65:       uuid: 'claude-a2',\n66:       sessionId: headerId,\n67:       timestamp: iso(3000),\n68:       message: { role: 'assistant', content: [{ type: 'text', text: 'The file holds one line.' }] },\n69:     },\n70:   ]);\n71: \n72:   return { root: claudeRoot, filePath, options: { claudeRoot, transcriptPath: filePath } };\n73: }\n74: \n75: // ─────────────────────────────────────────────────────────────────────────────\n76: // 2. CODEX\n77: // ─────────────────────────────────────────────────────────────────────────────\n78: \n79: export function codexSession({ root, sessionId = SESSION, headerId = sessionId, fileName, projectDir = '/fixture/project' } = {}) {\n80:   const codexRoot = join(root, 'codex', 'sessions');\n81:   const filePath = join(codexRoot, '2026', '11', '07', fileName ?? `rollout-2026-11-07T12-00-00-${sessionId}.jsonl`);\n82: \n83:   writeJsonl(filePath, [\n84:     { timestamp: iso(0), type: 'session_meta', payload: { id: headerId, session_id: headerId, cwd: projectDir } },\n85:     {\n86:       timestamp: iso(1000),\n87:       type: 'response_item',\n88:       payload: { type: 'message', id: 'codex-u1', role: 'user', content: [{ type: 'input_text', text: 'Read the file.' }] },\n89:     },\n90:     {\n91:       timestamp: iso(2000),\n92:       type: 'response_item',\n93:       payload: { type: 'function_call', call_id: 'codex-call-1', name: 'shell', arguments: '{\"command\":\"cat file.txt\"}' },\n94:     },\n95:     {\n96:       timestamp: iso(3000),\n97:       type: 'response_item',\n98:       payload: { type: 'function_call_output', call_id: 'codex-call-1', output: 'file contents' },\n99:     },\n100:     {\n101:       timestamp: iso(4000),\n102:       type: 'response_item',\n103:       payload: { type: 'message', id: 'codex-a1', role: 'assistant', content: [{ type: 'output_text', text: 'The file holds one line.' }] },\n104:     },\n105:   ]);\n106: \n107:   return { root: codexRoot, filePath, options: { codexRoot, transcriptPath: filePath } };\n108: }\n109: \n110: // ─────────────────────────────────────────────────────────────────────────────\n111: // 3. PI\n112: // ─────────────────────────────────────────────────────────────────────────────\n113: \n114: export function piSession({ root, projectDir, sessionId = SESSION, headerId = sessionId, headerCwd = projectDir, fileNameId = sessionId, createdAt = T0 } = {}) {\n115:   const piRoot = join(root, 'pi', 'sessions');\n116:   const filePath = join(piRoot, piProjectDirectory(projectDir), `${createdAt}_${fileNameId}.jsonl`);\n117: \n118:   writeJsonl(filePath, [\n119:     { type: 'session', version: 3, id: headerId, timestamp: iso(0), cwd: headerCwd },\n120:     {\n121:       type: 'message',\n122:       id: 'pi-u1',\n123:       timestamp: iso(1000),\n124:       message: { role: 'user', content: [{ type: 'text', text: 'Read the file.' }] },\n125:     },\n126:     {\n127:       type: 'message',\n128:       id: 'pi-a1',\n129:       timestamp: iso(2000),\n130:       message: {\n131:         role: 'assistant',\n132:         content: [\n133:           { type: 'text', text: 'Reading it now.' },\n134:           { type: 'toolCall', id: 'pi-call-1', name: 'read', arguments: { path: 'file.txt' } },\n135:         ],\n136:       },\n137:     },\n138:     {\n139:       type: 'message',\n140:       id: 'pi-r1',\n141:       timestamp: iso(3000),\n142:       message: { role: 'toolResult', toolCallId: 'pi-call-1', isError: false, content: [{ type: 'text', text: 'file contents' }] },\n143:     },\n144:     {\n145:       type: 'message',\n146:       id: 'pi-a2',\n147:       timestamp: iso(4000),\n148:       message: { role: 'assistant', content: [{ type: 'text', text: 'The file holds one line.' }] },\n149:     },\n150:   ]);\n151: \n152:   return { root: piRoot, filePath, options: { piRoot, projectDir } };\n153: }\n154: \n155: // ─────────────────────────────────────────────────────────────────────────────\n156: // 4. OPENCODE\n157: // ─────────────────────────────────────────────────────────────────────────────\n158: \n159: export function opencodeSession({ root, projectDir = '/fixture/project', sessionId = SESSION, withSession = true, withPart = true, withUserTextPart = false } = {}) {\n160:   const opencodeRoot = join(root, 'opencode');\n161:   const dbPath = join(opencodeRoot, 'opencode.db');\n162:   mkdirSync(opencodeRoot, { recursive: true });\n163: \n164:   const database = new DatabaseSync(dbPath);\n165:   try {\n166:     database.exec('CREATE TABLE session_v2 (id TEXT, directory TEXT, time_updated INTEGER)');\n167:     database.exec('CREATE TABLE part (id TEXT, message_id TEXT, session_id TEXT, time_created INTEGER, data TEXT)');\n168:     database.exec('CREATE TABLE session_message (id TEXT, session_id TEXT, type TEXT, seq INTEGER, data TEXT)');\n169: \n170:     if (withSession) {\n171:       database\n172:         .prepare('INSERT INTO session_v2 (id, directory, time_updated) VALUES (?, ?, ?)')\n173:         .run(sessionId, projectDir, T0 + 5000);\n174:     }\n175: \n176:     database\n177:       .prepare('INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)')\n178:       .run('oc-u1', sessionId, 'user', 1, JSON.stringify({ text: 'Read the file.', time: { created: T0 + 1000 } }));\n179: \n180:     database\n181:       .prepare('INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)')\n182:       .run('oc-a1', sessionId, 'assistant', 2, JSON.stringify({\n183:         time: { created: T0 + 2000 },\n184:         content: [{ type: 'text', text: 'The file holds one line.' }],\n185:       }));\n186: \n187:     if (withUserTextPart) {\n188:       database\n189:         .prepare('INSERT INTO part (id, message_id, session_id, time_created, data) VALUES (?, ?, ?, ?, ?)')\n190:         .run('oc-p0', 'oc-u1', sessionId, T0 + 500, JSON.stringify({\n191:           id: 'oc-p0',\n192:           type: 'text',\n193:           text: 'Read the file.',\n194:         }));\n195:     }\n196: \n197:     if (withPart) {\n198:       database\n199:         .prepare('INSERT INTO part (id, message_id, session_id, time_created, data) VALUES (?, ?, ?, ?, ?)')\n200:         .run('oc-p1', 'oc-a1', sessionId, T0 + 3000, JSON.stringify({\n201:           id: 'oc-p1',\n202:           type: 'tool',\n203:           callID: 'oc-call-1',\n204:           tool: 'read',\n205:           state: { status: 'completed', input: { path: 'file.txt' }, output: 'file contents' },\n206:         }));\n207:     }\n208:   } finally {\n209:     database.close();\n210:   }\n211: \n212:   return { root: opencodeRoot, dbPath, options: { opencodeRoot, dbPath } };\n213: }\n214: \n215: // ─────────────────────────────────────────────────────────────────────────────\n216: // 5. DEVIN\n217: // ─────────────────────────────────────────────────────────────────────────────\n218: \n219: export function devinSession({\n220:   root,\n221:   projectDir,\n222:   sessionId = SESSION,\n223:   transcriptId = sessionId,\n224:   rowId = sessionId,\n225:   workingDirectory = projectDir,\n226:   withSessionsRow = true,\n227:   compacted = false,\n228: } = {}) {\n229:   const dataDir = join(root, 'devin', 'cli');\n230:   const filePath = join(dataDir, 'transcripts', `${sessionId}.json`);\n231: \n232:   writeJson(filePath, {\n233:     schema_version: 'ATIF-v1.7',\n234:     session_id: transcriptId,\n235:     steps: [\n236:       { step_id: 1, timestamp: iso(0), source: 'user', message: 'Read the file.' },\n237:       {\n238:         step_id: 2,\n239:         timestamp: iso(1000),\n240:         source: 'agent',\n241:         message: '',\n242:         tool_calls: [{ tool_call_id: 'devin-call-1', function_name: 'read_file', arguments: { path: 'file.txt' } }],\n243:         observation: { results: [{ source_call_id: 'devin-call-1', content: 'file contents' }] },\n244:       },\n245:       { step_id: 3, timestamp: iso(2000), source: 'agent', message: 'The file holds one line.' },\n246:     ],\n247:   });\n248: \n249:   mkdirSync(dataDir, { recursive: true });\n250:   const dbPath = join(dataDir, 'sessions.db');\n251:   const database = new DatabaseSync(dbPath);\n252:   try {\n253:     database.exec('CREATE TABLE sessions (id TEXT PRIMARY KEY, working_directory TEXT NOT NULL, main_chain_id INTEGER)');\n254:     database.exec(`\n255:       CREATE TABLE message_nodes (\n256:         row_id INTEGER PRIMARY KEY AUTOINCREMENT,\n257:         session_id TEXT NOT NULL,\n258:         node_id INTEGER NOT NULL,\n259:         parent_node_id INTEGER,\n260:         chat_message TEXT NOT NULL,\n261:         created_at INTEGER NOT NULL,\n262:         metadata TEXT,\n263:         UNIQUE(session_id, node_id)\n264:       )\n265:     `);\n266: \n267:     const nodes = [\n268:       {\n269:         nodeId: 0,\n270:         parentId: null,\n271:         message: { message_id: 'devin-user-1', role: 'user', content: 'Read the file.', metadata: { is_user_input: true, created_at: iso(0) } },\n272:         createdAt: Math.floor(T0 / 1000),\n273:       },\n274:       {\n275:         nodeId: 1,\n276:         parentId: 0,\n277:         message: {\n278:           message_id: 'devin-assistant-1',\n279:           role: 'assistant',\n280:           content: '',\n281:           tool_calls: [{ id: 'devin-call-1', name: 'read_file', arguments: { path: 'file.txt' }, index: 0, kind: 'function' }],\n282:           metadata: { created_at: iso(1000) },\n283:         },\n284:         createdAt: Math.floor((T0 + 1000) / 1000),\n285:       },\n286:       {\n287:         nodeId: 2,\n288:         parentId: 1,\n289:         message: { message_id: 'devin-tool-1', role: 'tool', content: 'file contents', tool_call_id: 'devin-call-1', metadata: { created_at: iso(1500) } },\n290:         createdAt: Math.floor((T0 + 1500) / 1000),\n291:       },\n292:       {\n293:         nodeId: 3,\n294:         parentId: 2,\n295:         message: { message_id: 'devin-assistant-2', role: 'assistant', content: 'The file holds one line.', metadata: { created_at: iso(2000) } },\n296:         createdAt: Math.floor((T0 + 2000) / 1000),\n297:       },\n298:     ];\n299: \n300:     // A compaction starts a new thread with no parent; its continuation node\n301:     // names the last node of the thread it summarized.\n302:     if (compacted) {\n303:       nodes.push(\n304:         {\n305:           nodeId: 4,\n306:           parentId: null,\n307:           message: { message_id: 'devin-continue-1', role: 'system', content: 'You are continuing work from a previous conversation thread.' },\n308:           metadata: { summarized_from: 3 },\n309:           createdAt: Math.floor((T0 + 3000) / 1000),\n310:         },\n311:         {\n312:           nodeId: 5,\n313:           parentId: 4,\n314:           message: { message_id: 'devin-user-2', role: 'user', content: 'Where were we?', metadata: { is_user_input: true, created_at: iso(4000) } },\n315:           createdAt: Math.floor((T0 + 4000) / 1000),\n316:         },\n317:       );\n318:     }\n319: \n320:     if (withSessionsRow) {\n321:       database\n322:         .prepare('INSERT INTO sessions (id, working_directory, main_chain_id) VALUES (?, ?, ?)')\n323:         .run(rowId, workingDirectory, nodes[nodes.length - 1].nodeId);\n324: \n325:       const insert = database.prepare(\n326:         'INSERT INTO message_nodes (session_id, node_id, parent_node_id, chat_message, created_at, metadata) VALUES (?, ?, ?, ?, ?, ?)',\n327:       );\n328:       for (const node of nodes) {\n329:         insert.run(\n330:           rowId,\n331:           node.nodeId,\n332:           node.parentId,\n333:           JSON.stringify(node.message),\n334:           node.createdAt,\n335:           node.metadata ? JSON.stringify(node.metadata) : null,\n336:         );\n337:       }\n338:     }\n339:   } finally {\n340:     database.close();\n341:   }\n342: \n343:   return { root: dataDir, filePath, dbPath, options: { devinDataHome: dataDir, projectDir } };\n344: }\n345: \n346: // ─────────────────────────────────────────────────────────────────────────────\n347: // 6. DSH\n348: // ─────────────────────────────────────────────────────────────────────────────\n349: \n350: export function dshSession({ root, projectDir, sessionId = SESSION, headerId = sessionId, headerCwd = projectDir, directoryName = sessionId } = {}) {\n351:   const dshRoot = join(root, 'dsh', 'sessions');\n352:   const filePath = join(dshRoot, dshProjectKey(projectDir), directoryName, 'session.v1.jsonl');\n353: \n354:   writeJsonl(filePath, [\n355:     { type: 'session', version: 4, id: headerId, timestamp: iso(0), cwd: headerCwd },\n356:     {\n357:       type: 'user/message',\n358:       seq: 1,\n359:       data: { role: 'user', id: 'dsh-u1', source: { kind: 'user' }, content: [{ type: 'text', text: 'Read the file.' }] },\n360:     },\n361:     {\n362:       type: 'assistant/message',\n363:       seq: 2,\n364:       data: {\n365:         turn: 1,\n366:         step: 1,\n367:         message: {\n368:           role: 'assistant',\n369:           id: 'dsh-a1',\n370:           content: [{ type: 'tool-call', id: 'dsh-call-1', name: 'read', arguments: '{\"path\":\"file.txt\"}' }],\n371:         },\n372:       },\n373:     },\n374:     {\n375:       type: 'tool/result',\n376:       seq: 3,\n377:       data: { turn: 1, step: 1, message: { role: 'tool', toolCallId: 'dsh-call-1', isError: false, content: [{ type: 'text', text: 'file contents' }] } },\n378:     },\n379:     {\n380:       type: 'assistant/message',\n381:       seq: 4,\n382:       data: { turn: 1, step: 2, message: { role: 'assistant', id: 'dsh-a2', content: [{ type: 'text', text: 'The file holds one line.' }] } },\n383:     },\n384:   ]);\n385: \n386:   return { root: dshRoot, filePath, options: { dshRoot, projectDir } };\n387: }\n388: \n389: // ─────────────────────────────────────────────────────────────────────────────\n390: // 7. ALL SEVEN PRESENT STORES\n391: // ─────────────────────────────────────────────────────────────────────────────\n392: \n393: export function presentStores({ root, projectDir }) {\n394:   const claude = claudeSession({ root });\n395:   const codex = codexSession({ root });\n396:   const pi = piSession({ root, projectDir });\n397:   const opencode = opencodeSession({ root, projectDir });\n398:   const devin = devinSession({ root, projectDir });\n399:   const dsh = dshSession({ root, projectDir });\n400: \n401:   return {\n402:     claude,\n403:     codex,\n404:     pi,\n405:     opencode,\n406:     devin,\n407:     dsh,\n408:     storePaths: [claude.filePath, codex.filePath, pi.filePath, opencode.dbPath, devin.filePath, devin.dbPath, dsh.filePath],\n409:   };\n410: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/fixtures.mjs, lines 1-410\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Reader Fixtures\n3: // ───────────────────────────────────────────────────────────────────\n4: // Each builder writes one runtime store in a temp root and returns the options\n5: // its reader needs. The shapes follow the live store contracts the decision\n6: // capture sweeps already parse, trimmed to the entries a history read needs.\n7: \n8: import { mkdirSync } from 'node:fs';\n9: import { DatabaseSync } from 'node:sqlite';\n10: import { join } from 'node:path';\n11: import { dshProjectKey } from '../../session-readers/dsh.mjs';\n12: import { piProjectDirectory } from '../../session-readers/pi.mjs';\n13: import { writeJson, writeJsonl } from './helpers.mjs';\n14: \n15: export const SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n16: export const DECOY = 'bbbbbbbb-2222-4222-8222-222222222222';\n17: export const NOW = '2026-11-07T12:00:00.000Z';\n18: export const T0 = Date.parse(NOW);\n19: \n20: function iso(offset) {\n21:   return new Date(T0 + offset).toISOString();\n22: }\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 1. CLAUDE\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: export function claudeSession({ root, sessionId = SESSION, headerId = sessionId, fileName, subagents = false, resultText = null } = {}) {\n29:   const claudeRoot = join(root, 'claude', 'projects');\n30:   const filePath = subagents\n31:     ? join(claudeRoot, sessionId, 'subagents', 'agent-1.jsonl')\n32:     : join(claudeRoot, sessionId, fileName ?? `${sessionId}.jsonl`);\n33: \n34:   writeJsonl(filePath, [\n35:     { type: 'user', uuid: 'claude-u1', sessionId: headerId, timestamp: iso(0), message: { role: 'user', content: [{ type: 'text', text: 'Read the file.' }] } },\n36:     {\n37:       type: 'assistant',\n38:       uuid: 'claude-a1',\n39:       sessionId: headerId,\n40:       timestamp: iso(1000),\n41:       message: {\n42:         role: 'assistant',\n43:         content: [\n44:           { type: 'text', text: 'Reading it now.' },\n45:           { type: 'tool_use', id: 'claude-call-1', name: 'Read', input: { path: 'file.txt' } },\n46:         ],\n47:       },\n48:     },\n49:     {\n50:       type: 'user',\n51:       uuid: 'claude-u2',\n52:       sessionId: headerId,\n53:       timestamp: iso(2000),\n54:       toolUseResult: { content: 'file contents' },\n55:       message: {\n56:         role: 'user',\n57:         content: [\n58:           ...(resultText ? [{ type: 'text', text: resultText }] : []),\n59:           { type: 'tool_result', tool_use_id: 'claude-call-1', content: 'file contents' },\n60:         ],\n61:       },\n62:     },\n63:     {\n64:       type: 'assistant',\n65:       uuid: 'claude-a2',\n66:       sessionId: headerId,\n67:       timestamp: iso(3000),\n68:       message: { role: 'assistant', content: [{ type: 'text', text: 'The file holds one line.' }] },\n69:     },\n70:   ]);\n71: \n72:   return { root: claudeRoot, filePath, options: { claudeRoot, transcriptPath: filePath } };\n73: }\n74: \n75: // ─────────────────────────────────────────────────────────────────────────────\n76: // 2. CODEX\n77: // ─────────────────────────────────────────────────────────────────────────────\n78: \n79: export function codexSession({ root, sessionId = SESSION, headerId = sessionId, fileName, projectDir = '/fixture/project' } = {}) {\n80:   const codexRoot = join(root, 'codex', 'sessions');\n81:   const filePath = join(codexRoot, '2026', '11', '07', fileName ?? `rollout-2026-11-07T12-00-00-${sessionId}.jsonl`);\n82: \n83:   writeJsonl(filePath, [\n84:     { timestamp: iso(0), type: 'session_meta', payload: { id: headerId, session_id: headerId, cwd: projectDir } },\n85:     {\n86:       timestamp: iso(1000),\n87:       type: 'response_item',\n88:       payload: { type: 'message', id: 'codex-u1', role: 'user', content: [{ type: 'input_text', text: 'Read the file.' }] },\n89:     },\n90:     {\n91:       timestamp: iso(2000),\n92:       type: 'response_item',\n93:       payload: { type: 'function_call', call_id: 'codex-call-1', name: 'shell', arguments: '{\"command\":\"cat file.txt\"}' },\n94:     },\n95:     {\n96:       timestamp: iso(3000),\n97:       type: 'response_item',\n98:       payload: { type: 'function_call_output', call_id: 'codex-call-1', output: 'file contents' },\n99:     },\n100:     {\n101:       timestamp: iso(4000),\n102:       type: 'response_item',\n103:       payload: { type: 'message', id: 'codex-a1', role: 'assistant', content: [{ type: 'output_text', text: 'The file holds one line.' }] },\n104:     },\n105:   ]);\n106: \n107:   return { root: codexRoot, filePath, options: { codexRoot, transcriptPath: filePath } };\n108: }\n109: \n110: // ─────────────────────────────────────────────────────────────────────────────\n111: // 3. PI\n112: // ─────────────────────────────────────────────────────────────────────────────\n113: \n114: export function piSession({ root, projectDir, sessionId = SESSION, headerId = sessionId, headerCwd = projectDir, fileNameId = sessionId, createdAt = T0 } = {}) {\n115:   const piRoot = join(root, 'pi', 'sessions');\n116:   const filePath = join(piRoot, piProjectDirectory(projectDir), `${createdAt}_${fileNameId}.jsonl`);\n117: \n118:   writeJsonl(filePath, [\n119:     { type: 'session', version: 3, id: headerId, timestamp: iso(0), cwd: headerCwd },\n120:     {\n121:       type: 'message',\n122:       id: 'pi-u1',\n123:       timestamp: iso(1000),\n124:       message: { role: 'user', content: [{ type: 'text', text: 'Read the file.' }] },\n125:     },\n126:     {\n127:       type: 'message',\n128:       id: 'pi-a1',\n129:       timestamp: iso(2000),\n130:       message: {\n131:         role: 'assistant',\n132:         content: [\n133:           { type: 'text', text: 'Reading it now.' },\n134:           { type: 'toolCall', id: 'pi-call-1', name: 'read', arguments: { path: 'file.txt' } },\n135:         ],\n136:       },\n137:     },\n138:     {\n139:       type: 'message',\n140:       id: 'pi-r1',\n141:       timestamp: iso(3000),\n142:       message: { role: 'toolResult', toolCallId: 'pi-call-1', isError: false, content: [{ type: 'text', text: 'file contents' }] },\n143:     },\n144:     {\n145:       type: 'message',\n146:       id: 'pi-a2',\n147:       timestamp: iso(4000),\n148:       message: { role: 'assistant', content: [{ type: 'text', text: 'The file holds one line.' }] },\n149:     },\n150:   ]);\n151: \n152:   return { root: piRoot, filePath, options: { piRoot, projectDir } };\n153: }\n154: \n155: // ─────────────────────────────────────────────────────────────────────────────\n156: // 4. OPENCODE\n157: // ─────────────────────────────────────────────────────────────────────────────\n158: \n159: export function opencodeSession({ root, projectDir = '/fixture/project', sessionId = SESSION, withSession = true, withPart = true, withUserTextPart = false } = {}) {\n160:   const opencodeRoot = join(root, 'opencode');\n161:   const dbPath = join(opencodeRoot, 'opencode.db');\n162:   mkdirSync(opencodeRoot, { recursive: true });\n163: \n164:   const database = new DatabaseSync(dbPath);\n165:   try {\n166:     database.exec('CREATE TABLE session_v2 (id TEXT, directory TEXT, time_updated INTEGER)');\n167:     database.exec('CREATE TABLE part (id TEXT, message_id TEXT, session_id TEXT, time_created INTEGER, data TEXT)');\n168:     database.exec('CREATE TABLE session_message (id TEXT, session_id TEXT, type TEXT, seq INTEGER, data TEXT)');\n169: \n170:     if (withSession) {\n171:       database\n172:         .prepare('INSERT INTO session_v2 (id, directory, time_updated) VALUES (?, ?, ?)')\n173:         .run(sessionId, projectDir, T0 + 5000);\n174:     }\n175: \n176:     database\n177:       .prepare('INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)')\n178:       .run('oc-u1', sessionId, 'user', 1, JSON.stringify({ text: 'Read the file.', time: { created: T0 + 1000 } }));\n179: \n180:     database\n181:       .prepare('INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)')\n182:       .run('oc-a1', sessionId, 'assistant', 2, JSON.stringify({\n183:         time: { created: T0 + 2000 },\n184:         content: [{ type: 'text', text: 'The file holds one line.' }],\n185:       }));\n186: \n187:     if (withUserTextPart) {\n188:       database\n189:         .prepare('INSERT INTO part (id, message_id, session_id, time_created, data) VALUES (?, ?, ?, ?, ?)')\n190:         .run('oc-p0', 'oc-u1', sessionId, T0 + 500, JSON.stringify({\n191:           id: 'oc-p0',\n192:           type: 'text',\n193:           text: 'Read the file.',\n194:         }));\n195:     }\n196: \n197:     if (withPart) {\n198:       database\n199:         .prepare('INSERT INTO part (id, message_id, session_id, time_created, data) VALUES (?, ?, ?, ?, ?)')\n200:         .run('oc-p1', 'oc-a1', sessionId, T0 + 3000, JSON.stringify({\n201:           id: 'oc-p1',\n202:           type: 'tool',\n203:           callID: 'oc-call-1',\n204:           tool: 'read',\n205:           state: { status: 'completed', input: { path: 'file.txt' }, output: 'file contents' },\n206:         }));\n207:     }\n208:   } finally {\n209:     database.close();\n210:   }\n211: \n212:   return { root: opencodeRoot, dbPath, options: { opencodeRoot, dbPath } };\n213: }\n214: \n215: // ─────────────────────────────────────────────────────────────────────────────\n216: // 5. DEVIN\n217: // ─────────────────────────────────────────────────────────────────────────────\n218: \n219: export function devinSession({\n220:   root,\n221:   projectDir,\n222:   sessionId = SESSION,\n223:   transcriptId = sessionId,\n224:   rowId = sessionId,\n225:   workingDirectory = projectDir,\n226:   withSessionsRow = true,\n227:   compacted = false,\n228: } = {}) {\n229:   const dataDir = join(root, 'devin', 'cli');\n230:   const filePath = join(dataDir, 'transcripts', `${sessionId}.json`);\n231: \n232:   writeJson(filePath, {\n233:     schema_version: 'ATIF-v1.7',\n234:     session_id: transcriptId,\n235:     steps: [\n236:       { step_id: 1, timestamp: iso(0), source: 'user', message: 'Read the file.' },\n237:       {\n238:         step_id: 2,\n239:         timestamp: iso(1000),\n240:         source: 'agent',\n241:         message: '',\n242:         tool_calls: [{ tool_call_id: 'devin-call-1', function_name: 'read_file', arguments: { path: 'file.txt' } }],\n243:         observation: { results: [{ source_call_id: 'devin-call-1', content: 'file contents' }] },\n244:       },\n245:       { step_id: 3, timestamp: iso(2000), source: 'agent', message: 'The file holds one line.' },\n246:     ],\n247:   });\n248: \n249:   mkdirSync(dataDir, { recursive: true });\n250:   const dbPath = join(dataDir, 'sessions.db');\n251:   const database = new DatabaseSync(dbPath);\n252:   try {\n253:     database.exec('CREATE TABLE sessions (id TEXT PRIMARY KEY, working_directory TEXT NOT NULL, main_chain_id INTEGER)');\n254:     database.exec(`\n255:       CREATE TABLE message_nodes (\n256:         row_id INTEGER PRIMARY KEY AUTOINCREMENT,\n257:         session_id TEXT NOT NULL,\n258:         node_id INTEGER NOT NULL,\n259:         parent_node_id INTEGER,\n260:         chat_message TEXT NOT NULL,\n261:         created_at INTEGER NOT NULL,\n262:         metadata TEXT,\n263:         UNIQUE(session_id, node_id)\n264:       )\n265:     `);\n266: \n267:     const nodes = [\n268:       {\n269:         nodeId: 0,\n270:         parentId: null,\n271:         message: { message_id: 'devin-user-1', role: 'user', content: 'Read the file.', metadata: { is_user_input: true, created_at: iso(0) } },\n272:         createdAt: Math.floor(T0 / 1000),\n273:       },\n274:       {\n275:         nodeId: 1,\n276:         parentId: 0,\n277:         message: {\n278:           message_id: 'devin-assistant-1',\n279:           role: 'assistant',\n280:           content: '',\n281:           tool_calls: [{ id: 'devin-call-1', name: 'read_file', arguments: { path: 'file.txt' }, index: 0, kind: 'function' }],\n282:           metadata: { created_at: iso(1000) },\n283:         },\n284:         createdAt: Math.floor((T0 + 1000) / 1000),\n285:       },\n286:       {\n287:         nodeId: 2,\n288:         parentId: 1,\n289:         message: { message_id: 'devin-tool-1', role: 'tool', content: 'file contents', tool_call_id: 'devin-call-1', metadata: { created_at: iso(1500) } },\n290:         createdAt: Math.floor((T0 + 1500) / 1000),\n291:       },\n292:       {\n293:         nodeId: 3,\n294:         parentId: 2,\n295:         message: { message_id: 'devin-assistant-2', role: 'assistant', content: 'The file holds one line.', metadata: { created_at: iso(2000) } },\n296:         createdAt: Math.floor((T0 + 2000) / 1000),\n297:       },\n298:     ];\n299: \n300:     // A compaction starts a new thread with no parent; its continuation node\n301:     // names the last node of the thread it summarized.\n302:     if (compacted) {\n303:       nodes.push(\n304:         {\n305:           nodeId: 4,\n306:           parentId: null,\n307:           message: { message_id: 'devin-continue-1', role: 'system', content: 'You are continuing work from a previous conversation thread.' },\n308:           metadata: { summarized_from: 3 },\n309:           createdAt: Math.floor((T0 + 3000) / 1000),\n310:         },\n311:         {\n312:           nodeId: 5,\n313:           parentId: 4,\n314:           message: { message_id: 'devin-user-2', role: 'user', content: 'Where were we?', metadata: { is_user_input: true, created_at: iso(4000) } },\n315:           createdAt: Math.floor((T0 + 4000) / 1000),\n316:         },\n317:       );\n318:     }\n319: \n320:     if (withSessionsRow) {\n321:       database\n322:         .prepare('INSERT INTO sessions (id, working_directory, main_chain_id) VALUES (?, ?, ?)')\n323:         .run(rowId, workingDirectory, nodes[nodes.length - 1].nodeId);\n324: \n325:       const insert = database.prepare(\n326:         'INSERT INTO message_nodes (session_id, node_id, parent_node_id, chat_message, created_at, metadata) VALUES (?, ?, ?, ?, ?, ?)',\n327:       );\n328:       for (const node of nodes) {\n329:         insert.run(\n330:           rowId,\n331:           node.nodeId,\n332:           node.parentId,\n333:           JSON.stringify(node.message),\n334:           node.createdAt,\n335:           node.metadata ? JSON.stringify(node.metadata) : null,\n336:         );\n337:       }\n338:     }\n339:   } finally {\n340:     database.close();\n341:   }\n342: \n343:   return { root: dataDir, filePath, dbPath, options: { devinDataHome: dataDir, projectDir } };\n344: }\n345: \n346: // ─────────────────────────────────────────────────────────────────────────────\n347: // 6. DSH\n348: // ─────────────────────────────────────────────────────────────────────────────\n349: \n350: export function dshSession({ root, projectDir, sessionId = SESSION, headerId = sessionId, headerCwd = projectDir, directoryName = sessionId } = {}) {\n351:   const dshRoot = join(root, 'dsh', 'sessions');\n352:   const filePath = join(dshRoot, dshProjectKey(projectDir), directoryName, 'session.v1.jsonl');\n353: \n354:   writeJsonl(filePath, [\n355:     { type: 'session', version: 4, id: headerId, timestamp: iso(0), cwd: headerCwd },\n356:     {\n357:       type: 'user/message',\n358:       seq: 1,\n359:       data: { role: 'user', id: 'dsh-u1', source: { kind: 'user' }, content: [{ type: 'text', text: 'Read the file.' }] },\n360:     },\n361:     {\n362:       type: 'assistant/message',\n363:       seq: 2,\n364:       data: {\n365:         turn: 1,\n366:         step: 1,\n367:         message: {\n368:           role: 'assistant',\n369:           id: 'dsh-a1',\n370:           content: [{ type: 'tool-call', id: 'dsh-call-1', name: 'read', arguments: '{\"path\":\"file.txt\"}' }],\n371:         },\n372:       },\n373:     },\n374:     {\n375:       type: 'tool/result',\n376:       seq: 3,\n377:       data: { turn: 1, step: 1, message: { role: 'tool', toolCallId: 'dsh-call-1', isError: false, content: [{ type: 'text', text: 'file contents' }] } },\n378:     },\n379:     {\n380:       type: 'assistant/message',\n381:       seq: 4,\n382:       data: { turn: 1, step: 2, message: { role: 'assistant', id: 'dsh-a2', content: [{ type: 'text', text: 'The file holds one line.' }] } },\n383:     },\n384:   ]);\n385: \n386:   return { root: dshRoot, filePath, options: { dshRoot, projectDir } };\n387: }\n388: \n389: // ─────────────────────────────────────────────────────────────────────────────\n390: // 7. ALL SEVEN PRESENT STORES\n391: // ─────────────────────────────────────────────────────────────────────────────\n392: \n393: export function presentStores({ root, projectDir }) {\n394:   const claude = claudeSession({ root });\n395:   const codex = codexSession({ root });\n396:   const pi = piSession({ root, projectDir });\n397:   const opencode = opencodeSession({ root, projectDir });\n398:   const devin = devinSession({ root, projectDir });\n399:   const dsh = dshSession({ root, projectDir });\n400: \n401:   return {\n402:     claude,\n403:     codex,\n404:     pi,\n405:     opencode,\n406:     devin,\n407:     dsh,\n408:     storePaths: [claude.filePath, codex.filePath, pi.filePath, opencode.dbPath, devin.filePath, devin.dbPath, dsh.filePath],\n409:   };\n410: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/fixtures.mjs\"}"},"time":{"start":1794545754469,"end":1794545755242}}}}
