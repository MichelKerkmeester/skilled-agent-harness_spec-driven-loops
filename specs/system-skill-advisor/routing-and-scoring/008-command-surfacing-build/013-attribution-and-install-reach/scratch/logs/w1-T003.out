{"type":"tool_use","timestamp":1794545862180,"sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","part":{"partID":"prt_1d344c35b001X5vdlP1RUKN5ny","sessionID":"ses_e2cbe0a45ffeC9C8e26lVMH2DA","messageID":"msg_1d344bb24001dUsQAKzpNA8o5c","type":"tool","id":"call_e557e6dce55f402a9eb66807","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/hooks/shared/session-readers/claude.mjs .skilled/hooks/shared/tests/session-readers/claude.test.mjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/hooks/shared/session-readers/claude.mjs b/.skilled/hooks/shared/session-readers/claude.mjs\nindex cee7accde0..246a011755 100644\n--- a/.skilled/hooks/shared/session-readers/claude.mjs\n+++ b/.skilled/hooks/shared/session-readers/claude.mjs\n@@ -158,6 +158,30 @@ function recordsFromEntries(entries) {\n   return records;\n }\n \n+// Claude records the context a hook adds as an attachment entry rather than a\n+// message, so the history never carried it. A caller that asks whether the\n+// advisor brief reached the turn needs that text, and it has to stay apart from\n+// the operator and assistant records.\n+function attachmentText(content) {\n+  if (typeof content === 'string') return content;\n+  if (!Array.isArray(content)) return '';\n+  return content\n+    .map((item) => (typeof item === 'string' ? item : item?.text))\n+    .filter((text) => typeof text === 'string' && text.length > 0)\n+    .join('\\n');\n+}\n+\n+function injectedFromEntries(entries) {\n+  const injected = [];\n+  for (const entry of entries) {\n+    if (!entry || typeof entry !== 'object') continue;\n+    if (entry.type !== 'attachment' || entry?.attachment?.type !== 'hook_additional_context') continue;\n+    const text = attachmentText(entry.attachment.content);\n+    if (text) injected.push({ source: 'hook_additional_context', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 5. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -220,5 +244,6 @@ export function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}\n       storePath,\n     },\n     records: recordsFromEntries(entries),\n+    injected: injectedFromEntries(entries),\n   };\n }\ndiff --git a/.skilled/hooks/shared/tests/session-readers/claude.test.mjs b/.skilled/hooks/shared/tests/session-readers/claude.test.mjs\nindex f4559443b8..a9650f5ae9 100644\n--- a/.skilled/hooks/shared/tests/session-readers/claude.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/claude.test.mjs\n@@ -11,9 +11,12 @@ import { join } from 'node:path';\n import { test } from 'node:test';\n \n import { readSession } from '../../session-readers/index.mjs';\n+import { loadClaudeSession } from '../../session-readers/claude.mjs';\n import { claudeSession, DECOY, NOW, SESSION } from './fixtures.mjs';\n import { trackFileOpens, withTemp, withTempAsync, writeJsonl } from './helpers.mjs';\n \n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n test('a parent transcript resolves by its recorded session id', () => {\n   withTemp('claude-reader', (root) => {\n     const fixture = claudeSession({ root });\n@@ -145,3 +148,26 @@ test('a local command report stays out of the history and the typed command stay\n     assert.equal(ids.includes('claude-out'), false);\n   });\n });\n+\n+test('a hook additional context attachment is returned as injected text', () => {\n+  withTemp('claude-injected', (root) => {\n+    const plain = claudeSession({ root: join(root, 'plain') });\n+    const contextual = claudeSession({ root: join(root, 'context') });\n+    appendFileSync(contextual.filePath, `${JSON.stringify({\n+      type: 'attachment',\n+      attachment: {\n+        type: 'hook_additional_context',\n+        hookEvent: 'UserPromptSubmit',\n+        content: [BRIEF],\n+      },\n+    })}\\n`);\n+\n+    const plainLoaded = loadClaudeSession({ sessionId: SESSION, ...plain.options });\n+    const contextualLoaded = loadClaudeSession({ sessionId: SESSION, ...contextual.options });\n+\n+    assert.equal(plainLoaded.ok, true);\n+    assert.equal(contextualLoaded.ok, true);\n+    assert.deepEqual(contextualLoaded.injected, [{ source: 'hook_additional_context', text: BRIEF }]);\n+    assert.equal(contextualLoaded.records.length, plainLoaded.records.length);\n+  });\n+});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/hooks/shared/session-readers/claude.mjs b/.skilled/hooks/shared/session-readers/claude.mjs\nindex cee7accde0..246a011755 100644\n--- a/.skilled/hooks/shared/session-readers/claude.mjs\n+++ b/.skilled/hooks/shared/session-readers/claude.mjs\n@@ -158,6 +158,30 @@ function recordsFromEntries(entries) {\n   return records;\n }\n \n+// Claude records the context a hook adds as an attachment entry rather than a\n+// message, so the history never carried it. A caller that asks whether the\n+// advisor brief reached the turn needs that text, and it has to stay apart from\n+// the operator and assistant records.\n+function attachmentText(content) {\n+  if (typeof content === 'string') return content;\n+  if (!Array.isArray(content)) return '';\n+  return content\n+    .map((item) => (typeof item === 'string' ? item : item?.text))\n+    .filter((text) => typeof text === 'string' && text.length > 0)\n+    .join('\\n');\n+}\n+\n+function injectedFromEntries(entries) {\n+  const injected = [];\n+  for (const entry of entries) {\n+    if (!entry || typeof entry !== 'object') continue;\n+    if (entry.type !== 'attachment' || entry?.attachment?.type !== 'hook_additional_context') continue;\n+    const text = attachmentText(entry.attachment.content);\n+    if (text) injected.push({ source: 'hook_additional_context', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 5. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -220,5 +244,6 @@ export function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}\n       storePath,\n     },\n     records: recordsFromEntries(entries),\n+    injected: injectedFromEntries(entries),\n   };\n }\ndiff --git a/.skilled/hooks/shared/tests/session-readers/claude.test.mjs b/.skilled/hooks/shared/tests/session-readers/claude.test.mjs\nindex f4559443b8..a9650f5ae9 100644\n--- a/.skilled/hooks/shared/tests/session-readers/claude.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/claude.test.mjs\n@@ -11,9 +11,12 @@ import { join } from 'node:path';\n import { test } from 'node:test';\n \n import { readSession } from '../../session-readers/index.mjs';\n+import { loadClaudeSession } from '../../session-readers/claude.mjs';\n import { claudeSession, DECOY, NOW, SESSION } from './fixtures.mjs';\n import { trackFileOpens, withTemp, withTempAsync, writeJsonl } from './helpers.mjs';\n \n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n test('a parent transcript resolves by its recorded session id', () => {\n   withTemp('claude-reader', (root) => {\n     const fixture = claudeSession({ root });\n@@ -145,3 +148,26 @@ test('a local command report stays out of the history and the typed command stay\n     assert.equal(ids.includes('claude-out'), false);\n   });\n });\n+\n+test('a hook additional context attachment is returned as injected text', () => {\n+  withTemp('claude-injected', (root) => {\n+    const plain = claudeSession({ root: join(root, 'plain') });\n+    const contextual = claudeSession({ root: join(root, 'context') });\n+    appendFileSync(contextual.filePath, `${JSON.stringify({\n+      type: 'attachment',\n+      attachment: {\n+        type: 'hook_additional_context',\n+        hookEvent: 'UserPromptSubmit',\n+        content: [BRIEF],\n+      },\n+    })}\\n`);\n+\n+    const plainLoaded = loadClaudeSession({ sessionId: SESSION, ...plain.options });\n+    const contextualLoaded = loadClaudeSession({ sessionId: SESSION, ...contextual.options });\n+\n+    assert.equal(plainLoaded.ok, true);\n+    assert.equal(contextualLoaded.ok, true);\n+    assert.deepEqual(contextualLoaded.injected, [{ source: 'hook_additional_context', text: BRIEF }]);\n+    assert.equal(contextualLoaded.records.length, plainLoaded.records.length);\n+  });\n+});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/hooks/shared/session-readers/claude.mjs .skilled/hooks/shared/tests/session-readers/claude.test.mjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794545861467,"end":1794545862180}}}}
