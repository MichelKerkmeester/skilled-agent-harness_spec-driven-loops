project's Codex approval check whether its advisor hook can run.\n160:  *\n161:  * Codex skips an unapproved project hook without a warning, so a wired hook can\n162:  * still deliver nothing. The check reports the approval recorded in the config\n163:  * file it reads, and this wrapper turns that verdict into the answer the\n164:  * delivery decision needs.\n165:  *\n166:  * @param {object} [options]\n167:  * @param {string} [options.projectDir] - Project root whose hooks file is read.\n168:  * @param {string} [options.configPath] - Codex config file, defaulting to the\n169:  *   environment's Codex home.\n170:  * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n171:  */\n172: export function codexHookApproval({ projectDir, configPath } = {}) {\n173:   if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n174: \n175:   const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n176:   if (configPath) args.push('--config', configPath);\n177:   const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n178:   if (result.error || typeof result.stdout !== 'string') return 'unknown';\n179: \n180:   let verdict;\n181:   try {\n182:     verdict = JSON.parse(result.stdout);\n183:   } catch {\n184:     return 'unknown';\n185:   }\n186: \n187:   switch (verdict?.code) {\n188:     case 'codex-hooks-approved':\n189:       return 'approved';\n190:     case 'codex-hooks-unapproved':\n191:       return 'unapproved';\n192:     case 'codex-advisor-hook-absent':\n193:       return 'absent';\n194:     case 'no-codex-hooks':\n195:       return 'no-hooks';\n196:     default:\n197:       return 'unknown';\n198:   }\n199: }\n200: \n201: /**\n202:  * Decide whether the advisor brief reached the session that ran the turn.\n203:  *\n204:  * A Claude transcript records the hook context as its own attachment line, so a\n205:  * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n206:  * session store, either as a record or as injected context beside it, and Codex\n207:  * answers from its approval plus whatever its store holds. OpenCode stays\n208:  * `unknown`, because its plugin adds the brief in memory and the store keeps no\n209:  * copy.\n210:  *\n211:  * @param {object} options\n212:  * @param {string} options.runtime - The measured runtime.\n213:  * @param {object|null} [options.locator] - The locator the run line recorded.\n214:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n215:  *   lives in session records rather than a transcript file.\n216:  * @param {string} [options.codexConfig] - Codex config file the approval is\n217:  *   read from, defaulting to the environment's Codex home.\n218:  * @returns {Promise<boolean | 'unknown'>}\n219:  */\n220: export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n221:   if (runtime === 'claude') {\n222:     const transcriptPath = locator?.transcriptPath;\n223:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n224:       return 'unknown';\n225:     }\n226: \n227:     let raw;\n228:     try {\n229:       raw = readFileSync(transcriptPath, 'utf8');\n[Output truncated. Continue reading with offset: 230]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 130-229\n130:   return { ...parseOffer(firstLine), offerError: null };\n131: }\n132: \n133: function contentHasBrief(content) {\n134:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n135:   if (!Array.isArray(content)) return false;\n136:   return content.some((part) => {\n137:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n138:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n139:   }