{"type":"step_start","timestamp":1794547499864,"sessionID":"ses_e2ca2ab7affegsDeF1ZxNlGowy","part":{"id":"prt_1d35dc358001EkH1jq4U33Tw2S","sessionID":"ses_e2ca2ab7affegsDeF1ZxNlGowy","messageID":"msg_1d35dbd44001VNUbx86ZbdrRjx","type":"step-start","snapshot":"2e92f8f1bc8101fb9a54dc9b09c4ff98411973cd"}}
{"type":"tool_use","timestamp":1794547503679,"sessionID":"ses_e2ca2ab7affegsDeF1ZxNlGowy","part":{"partID":"prt_1d35dd04e002Q7RHdYAII3yBS6","sessionID":"ses_e2ca2ab7affegsDeF1ZxNlGowy","messageID":"msg_1d35dbd44001VNUbx86ZbdrRjx","type":"tool","id":"call_f3804901ec3b46a58d5b852c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1-1160\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: One-Turn Command Behaviour Runner\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Command surfacing is only proven by a turn that starts the way an operator\n6: // starts it: one prompt, the real CLI, and a session id the transcript reader\n7: // can open afterwards. Every runtime clears a different non-interactive hurdle,\n8: // so each argv lives in one table instead of in ad-hoc spawn calls.\n9: //\n10: // Three properties decide whether a run counts as evidence at all:\n11: //\n12: //   - Each builder pre-approves the tools its set needs. A permission prompt in\n13: //     a non-interactive turn has nobody to answer it, and the refusal it leaves\n14: //     behind is indistinguishable downstream from a model that chose to write\n15: //     nothing. Without this, every must-not-start row passes for the wrong\n16: //     reason.\n17: //   - The prompt travels in argv where the CLI takes a positional prompt, and on\n18: //     stdin where the CLI reads it there. Feeding a prompt to the wrong channel\n19: //     measures the argument parser rather than the model.\n20: //   - A turn is capped by the prompt it runs. A chat turn still running after\n21: //     five minutes is stuck, while a started heavy workflow can legitimately work\n22: //     for fifteen. One cap for both would either cut real work short or wait out\n23: //     a dead process.\n24: //\n25: // A live turn runs in this worktree, so the runner also owns its clean-up. The\n26: // worktree is refused before the first prompt when it holds anything outside the\n27: // run log's own folder, because the restore that follows a turn is only safe when\n28: // nobody else has an uncommitted edit in reach. Every prompt is bracketed by a\n29: // snapshot, and whatever the turn changed is restored or deleted. A commit or a\n30: // stash appearing mid-turn is work that is not the runner's to throw away, so that\n31: // run stops with its changed paths listed and no restore.\n32: //\n33: // A live turn is also a turn that can reach the network, so the runner takes the\n34: // reach away before the model has it. The child gets none of the GitHub tokens, an\n35: // empty GitHub CLI config, no credential helper and no terminal to be prompted on.\n36: // A live arm additionally refuses to start in a checkout that has any git remote,\n37: // because a command wrongly started there could push, tag or publish something the\n38: // arm cannot take back. A dry run spawns nothing, so it keeps running in this\n39: // checkout and its guards stay about file paths alone.\n40: //\n41: // Usage:\n42: //   node run-command-behaviour.mjs --print-argv <runtime>\n43: //   node run-command-behaviour.mjs --list <set>\n44: //   node run-command-behaviour.mjs --runtime <runtime> (--set <set> | --row-id <id>...)\n45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n46: //   node run-command-behaviour.mjs --backfill <run-log> --out <new-log> [--brief-only]\n47: \n48: import { appendFileSync, mkdirSync, readdirSync, readFileSync, realpathSync } from 'node:fs';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { homedir } from 'node:os';\n51: import { randomUUID } from 'node:crypto';\n52: import { spawn, spawnSync } from 'node:child_process';\n53: import { fileURLToPath } from 'node:url';\n54: import { dshProjectKey, dshStoreRoot } from '../../../../../hooks/shared/session-readers/dsh.mjs';\n55: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n56: import { backfillRunLog, briefDelivered, replayOffer } from './command-offer.mjs';\n57: import { restoreTurn, statusSnapshot } from './worktree-restore.mjs';\n58: \n59: const HERE = dirname(fileURLToPath(import.meta.url));\n60: const REPO_ROOT = resolve(HERE, '../../../../../..');\n61: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n62: // A stored session is found by its id plus the directory the turn ran in, and the\n63: // scorer reads it back from another checkout, so the locator records the resolved\n64: // directory instead of letting each reader compare the id against its own root.\n65: const PROJECT_DIR = realpathSync(REPO_ROOT);\n66: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n67: \n68: const EXIT_REFUSED = 2;\n69: const EXIT_HEAD_MOVED = 3;\n70: \n71: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n72: // from either set and the cap has to follow the row, not the invocation.\n73: const CAP_MS = Object.freeze({\n74:   chat: 300_000,\n75:   started: 900_000,\n76: });\n77: \n78: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n79: const CODEX_MODEL = 'gpt-6-luna';\n80: // The variant rides the model string, because `opencode run` has no flag for it.\n81: const OPENCODE_MODEL = 'llmgateway/deepseek-v4.1-flash-1017#max';\n82: const PI_MODEL = 'llmgateway/deepseek-v4.1-flash-1017';\n83: const DEVIN_MODEL = 'swe-2-max';\n84: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n85: \n86: // Runtimes the phase reports as not measured, with the reason a run would be\n87: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n88: // transcript could not be scored even if the turn ran.\n89: const NOT_MEASURED = Object.freeze({\n90:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n91: });\n92: \n93: function has(object, key) {\n94:   return Object.prototype.hasOwnProperty.call(object, key);\n95: }\n96: \n97: // ───────────────────────────────────────────────────────────────\n98: // Runtime argv table\n99: // ───────────────────────────────────────────────────────────────\n100: \n101: const RUNTIMES = {\n102:   claude: {\n103:     command: 'claude',\n104:     model: CLAUDE_MODEL,\n105:     promptOnStdin: false,\n106:     // stream-json writes one JSON object per line and every one of them carries\n107:     // the session id the transcript is stored under.\n108:     locator: { kind: 'stream', field: 'session_id' },\n109:     // The reader opens a transcript by id plus its own path, and Claude Code names\n110:     // the file after the session inside a folder per working directory.\n111:     findTranscript: claudeTranscriptPath,\n112:     buildArgv: ({ prompt }) => [\n113:       '-p',\n114:       prompt,\n115:       '--model',\n116:       CLAUDE_MODEL,\n117:       // stream-json is the only output format that carries the session id the\n118:       // reader needs after the turn ends.\n119:       '--output-format',\n120:       'stream-json',\n121:       '--verbose',\n122:       // Print mode has nobody to answer an approval prompt, and the default mode\n123:       // both denies writes and refuses shell commands, which is exactly the\n124:       // behaviour an ask-row test must be free to observe.\n125:       '--permission-mode',\n126:       'bypassPermissions',\n127:     ],\n128:   },\n129:   codex: {\n130:     command: 'codex',\n131:     model: CODEX_MODEL,\n132:     promptOnStdin: true,\n133:     // The run opens with an event naming its thread, and the rollout file is\n134:     // named after that thread id.\n135:     locator: { kind: 'stream', field: 'thread_id' },\n136:     // The rollout file is named after the thread id the stream reported, so the id\n137:     // alone leads back to it once the store has been searched.\n138:     findTranscript: codexTranscriptPath,\n139:     buildArgv: () => [\n140:       'exec',\n141:       // The JSON event stream is how a turn reports its thread id.\n142:       '--json',\n143:       '--model',\n144:       CODEX_MODEL,\n145:       '-c',\n146:       'model_reasoning_effort=medium',\n147:       '-c',\n148:       'service_tier=fast',\n149:       // A headless run cannot answer an approval prompt, and `exec` defaults to a\n150:       // read-only sandbox that would silently swallow every write.\n151:       '-c',\n152:       'approval_policy=never',\n153:       '--sandbox',\n154:       'workspace-write',\n155:       '-',\n156:     ],\n157:   },\n158:   opencode: {\n159:     command: 'opencode',\n160:     model: OPENCODE_MODEL,\n161:     promptOnStdin: false,\n162:     // The turn's own events carry the id of the session it created.\n163:     locator: { kind: 'stream', field: 'sessionID' },\n164:     buildArgv: ({ prompt }) => [\n165:       // `opencode run` takes no --dir, and the child already starts in the\n166:       // checkout, so passing the directory a second time would only fail.\n167:       'run',\n168:       // Without this the turn is handed to the operator's long-running background\n169:       // service, whose tools run with that service's environment. The hardened\n170:       // environment this runner builds would then never reach a tool call.\n171:       '--standalone',\n172:       '--model',\n173:       OPENCODE_MODEL,\n174:       '--format',\n175:       'json',\n176:       // Auto-approve everything not explicitly denied. A run that stalls on a\n177:       // permission prompt reads as a model that declined to act.\n178:       '--auto',\n179:       prompt,\n180:     ],\n181:   },\n182:   pi: {\n183:     command: 'pi',\n184:     model: PI_MODEL,\n185:     promptOnStdin: false,\n186:     // Print mode never reports the session it wrote, so the runner mints the id\n187:     // and passes it on the command line instead of recovering it from the stream.\n188:     locator: { kind: 'runner' },\n189:     buildArgv: ({ prompt, sessionId }) => [\n190:       '-p',\n191:       // Without it a non-interactive Pi probes the network on startup and can\n192:       // hang before it ever reads the prompt.\n193:       '--offline',\n194:       '--model',\n195:       PI_MODEL,\n196:       // Without a minted id the log would have to be guessed from whatever\n197:       // file is newest, which can open a neighbouring turn's transcript.\n198:       '--session-id',\n199:       sessionId,\n200:       prompt,\n201:     ],\n202:   },\n203:   devin: {\n204:     command: 'devin',\n205:     model: DEVIN_MODEL,\n206:     promptOnStdin: false,\n207:     // A Devin turn keeps its session in a store its own output does not name, so\n208:     // the id comes from the listing of the directory the turn ran in.\n209:     locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n210:     buildArgv: ({ prompt }) => [\n211:       '-p',\n212:       '--model',\n213:       DEVIN_MODEL,\n214:       // Under `accept-edits` every tool call that wants confirmation is refused,\n215:       // so a headless turn explores its whole budget and writes nothing.\n216:       '--permission-mode',\n217:       'dangerous',\n218:       // A fresh checkout has never been trusted interactively, and print mode has\n219:       // nobody to answer the trust prompt, so the turn would refuse to start.\n220:       '--respect-workspace-trust',\n221:       'false',\n222:       // No `--sandbox` here. That flag forces a permission mode that ignores\n223:       // `dangerous` and rejects every write in print mode, so a turn would write\n224:       // nothing and read as a model that declined. Containment comes from the\n225:       // arena instead.\n226:       // The separator keeps a prompt that opens with a dash from parsing as a flag.\n227:       '--',\n228:       prompt,\n229:     ],\n230:   },\n231:   dsh: {\n232:     command: 'dsh',\n233:     // dsh takes no model flag at all. The roster route patch decides the model,\n234:     // and this table pins the verified LLM Gateway route.\n235:     model: DSH_MODEL,\n236:     promptOnStdin: true,\n237:     // The harness names the session itself and refuses an id it never created,\n238:     // so the turn's id is recovered from the store folder its log lands in.\n239:     locator: { kind: 'store', list: dshSessionIds },\n240:     buildArgv: () => [\n241:       '--profile',\n242:       'headless',\n243:       '--patch',\n244:       resolve(DSH_PATCH_DIR, 'route-llmgateway-deepseek.patch.yml'),\n245:       // No lineage patch: it marks the run as a fan-out leaf, and the repo\n246:       // guards keep the prompt advisor off for a leaf. A chat turn has to\n247:       // receive the brief like a person's session would.\n248:       '--patch',\n249:       resolve(DSH_PATCH_DIR, 'guards.patch.yml'),\n250:       '--json',\n251:       '--permission-mode',\n252:       'workspace-write',\n253:       // Approvals default to ask, and a headless turn has nobody to answer.\n254:       '--approval-policy',\n255:       'never',\n256:       // The dash takes the prompt from stdin, which is the channel a headless\n257:       // run reads, and keeps a prompt that opens with one from parsing as a\n258:       // flag.\n259:       '-',\n260:     ],\n261:   },\n262: };\n263: \n264: // ───────────────────────────────────────────────────────────────\n265: // Session locator\n266: // ───────────────────────────────────────────────────────────────\n267: //\n268: // A run log is only evidence if it leads back to the exact transcript the turn\n269: // wrote, and each runtime exposes that handle in its own way. Three sources\n270: // exist: an id the CLI reports after the turn, either in its output or in the\n271: // session listing it keeps, an id the runner hands the CLI before it starts, or\n272: // no recorded source at all, which the log states rather than filling with the\n273: // newest file in the store.\n274: \n275: // Output arrives in chunks that cut a line in half, so a line is parsed only\n276: // once its newline has come through. Parsing stops at the first match, because\n277: // the id never changes within one turn.\n278: function streamLocator(field) {\n279:   let pending = '';\n280:   let captured = null;\n281:   return {\n282:     push(chunk) {\n283:       if (field === null || captured !== null) return;\n284:       pending += chunk;\n285:       const lines = pending.split('\\n');\n286:       pending = lines.pop() ?? '';\n287:       for (const line of lines) {\n288:         captured = readId(line, field);\n289:         if (captured !== null) return;\n290:       }\n291:     },\n292:     value() {\n293:       if (captured === null && pending !== '') captured = readId(pending, field);\n294:       return captured;\n295:     },\n296:   };\n297: }\n298: \n299: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n300: // this line holds no locator rather than that the run failed.\n301: function readId(line, field) {\n302:   let event;\n303:   try {\n304:     event = JSON.parse(line);\n305:   } catch {\n306:     return null;\n307:   }\n308:   const id = event?.[field];\n309:   return typeof id === 'string' && id !== '' ? id : null;\n310: }\n311: \n312: // A runtime that keeps its sessions in a store its output never names still lists\n313: // them for the directory the turn ran in, so two listings taken around a turn\n314: // reduce the store to a set difference. The listing runs in the child's\n315: // environment, because that is the store the turn itself wrote to.\n316: const LISTING_CAP_MS = 60_000;\n317: \n318: function listingIds(runtime, ghConfig) {\n319:   const source = runtime.locator;\n320:   if (source.kind !== 'listing') return null;\n321:   const result = spawnSync(runtime.command, source.args, {\n322:     cwd: REPO_ROOT,\n323:     env: childEnv(ghConfig),\n324:     encoding: 'utf8',\n325:     timeout: LISTING_CAP_MS,\n326:   });\n327:   if (result.error) return null;\n328:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n329: }\n330: \n331: // A runtime that names its session only in a store it owns is bracketed by two\n332: // readings of that store, and the entry the turn added is the session it wrote.\n333: function listsStore(runtime) {\n334:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n335: }\n336: \n337: // Only the reading differs between the store-backed forms: one CLI answers with\n338: // its own index and the other keeps one folder per session. Any other kind\n339: // names its session in the turn's output instead.\n340: function storeIds(runtime, ghConfig) {\n341:   return runtime.locator.kind === 'store'\n342:     ? runtime.locator.list()\n343:     : listingIds(runtime, ghConfig);\n344: }\n345: \n346: // The listing is a JSON array of session objects whose `id` field is the value\n347: // the CLI's own resume takes, so that field is the one that leads back to a\n348: // transcript. Any other shape names no session, which the caller reads as no id\n349: // rather than as a failed run.\n350: function listedSessionIds(text) {\n351:   let entries;\n352:   try {\n353:     entries = JSON.parse(text);\n354:   } catch {\n355:     return null;\n356:   }\n357:   if (!Array.isArray(entries)) return null;\n358:   return entries\n359:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n360:     .filter((id) => typeof id === 'string' && id !== '');\n361: }\n362: \n363: // A session another operator opened while the turn ran is not this turn's, and a\n364: // listing that reports none or several added entries has no id it can name with\n365: // confidence, so only a single added entry becomes the locator.\n366: function addedSessionId(before, after) {\n367:   if (before === null || after === null) return null;\n368:   const known = new Set(before);\n369:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n370:   return added.length === 1 ? added[0] : null;\n371: }\n372: \n373: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n374: // locator records the home the run used and the transcript stays findable from\n375: // the log alone.\n376: function dshHome() {\n377:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n378: }\n379: \n380: // A DSH session is a folder named after its id under one folder per project the\n381: // harness keyed from the directory the turn ran in, and the turn's own output\n382: // never names that id. The store root comes from the reader so the folder listed\n383: // here is the folder the reader will search. A store the harness has not created\n384: // yet lists nothing, which is the same answer as a turn that wrote no session.\n385: function dshSessionIds() {\n386:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n387:   try {\n388:     return readdirSync(store, { withFileTypes: true })\n389:       .filter((entry) => entry.isDirectory())\n390:       .map((entry) => entry.name);\n391:   } catch {\n392:     return [];\n393:   }\n394: }\n395: \n396: // A store folder is the CLI's to lay out, so the walk follows the folders it\n397: // creates and matches on the file name instead of predicting a path. A store that\n398: // is missing or unreadable names no transcript, which is the same answer as a turn\n399: // that wrote none rather than a reason to fail the run.\n400: function findTranscriptFiles(dir, matches, depth) {\n401:   let entries;\n402:   try {\n403:     entries = readdirSync(dir, { withFileTypes: true });\n404:   } catch {\n405:     return [];\n406:   }\n407:   const found = [];\n408:   for (const entry of entries) {\n409:     if (entry.isFile() && matches(entry.name)) {\n410:       found.push(join(dir, entry.name));\n411:     } else if (entry.isDirectory() && depth > 0) {\n412:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n413:     }\n414:   }\n415:   return found;\n416: }\n417: \n418: // One match is the turn's own transcript, while two leave the locator without a\n419: // path because choosing between them could score a neighbouring turn under this\n420: // row. The path is resolved so a log written from another checkout still opens.\n421: function storedTranscriptPath(root, matches, depth = Infinity) {\n422:   const found = findTranscriptFiles(root, matches, depth);\n423:   return found.length === 1 ? resolve(found[0]) : null;\n424: }\n425: \n426: // Claude Code keeps one folder per working directory and writes each transcript\n427: // directly inside it, so one level below the store is the whole of the search. A\n428: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n429: // and which the reader refuses.\n430: function claudeTranscriptPath(sessionId) {\n431:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n432:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n433: }\n434: \n435: // A Codex rollout file is named after its start time and ends with the thread id,\n436: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n437: // store is searched and the id is a suffix of the name.\n438: function codexTranscriptPath(sessionId) {\n439:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n440:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n441: }\n442: \n443: // A store listing that added no single entry leaves the id out rather than\n444: // naming a guess that would score a neighbouring turn under this row. The home\n445: // stays on the record so the store the run wrote to is findable from the log\n446: // alone.\n447: function storeLocator(reportedId) {\n448:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n449:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n450: }\n451: \n452: function locatorFor(runtime, sessionId, reportedId) {\n453:   const source = runtime.locator;\n454:   // The id the runner handed the CLI is the one the store keys its log by, and\n455:   // the directory the turn ran in is what a reader matches the log's header\n456:   // against, so both travel with every record.\n457:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n458:   if (source.kind === 'store') return storeLocator(reportedId);\n459:   // A runtime that reported no id records none, which keeps a scorer from opening\n460:   // a neighbouring transcript that happens to be newer.\n461:   if (reportedId === null) return null;\n462:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n463:   // A reader needs the file the turn wrote as well as its id, so a store-based\n464:   // runtime resolves the id to a path once the turn has closed. A turn that left\n465:   // no single match keeps the field out rather than naming a guess.\n466:   const transcriptPath = typeof runtime.findTranscript === 'function'\n467:     ? runtime.findTranscript(reportedId)\n468:     : null;\n469:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n470:   return locator;\n471: }\n472: \n473: // ───────────────────────────────────────────────────────────────\n474: // Worktree guards\n475: // ───────────────────────────────────────────────────────────────\n476: //\n477: // Every live turn runs in this worktree, so the runner cleans up after itself and\n478: // refuses to start when the worktree already holds work that is not its own. The\n479: // order matters: the remote check runs before the dirty check, so a live refusal\n480: // names the one condition an arm can never repair, and the dirty check runs before\n481: // the first prompt, so a restore can never discard an edit another worker has not\n482: // committed yet, and the head check runs around every prompt, so a commit or a\n483: // stash taken mid-turn stops the arm before the next model call rather than after\n484: // the damage.\n485: \n486: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n487: // lie, and the restore step trusts that snapshot.\n488: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n489: \n490: function git(args) {\n491:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n492:     cwd: REPO_ROOT,\n493:     encoding: 'utf8',\n494:   });\n495:   if (result.error) throw result.error;\n496:   return result;\n497: }\n498: \n499: function gitText(args) {\n500:   const result = git(args);\n501:   if (result.status !== 0) {\n502:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n503:   }\n504:   return result.stdout;\n505: }\n506: \n507: function statusPaths() {\n508:   return statusSnapshot(REPO_ROOT);\n509: }\n510: \n511: // The out folder is this arm's own output area. Git is asked for that folder's path\n512: // from the top of the repository, because comparing two spellings of the same\n513: // folder misreads a root that is reached through a symlink. An out folder outside\n514: // any repository exempts nothing, which only makes the guard stricter.\n515: function exemptPrefix(outDir) {\n516:   mkdirSync(outDir, { recursive: true });\n517:   const result = spawnSync('git', [...GIT_PREFIX, 'rev-parse', '--show-prefix'], {\n518:     cwd: outDir,\n519:     encoding: 'utf8',\n520:   });\n521:   if (result.status !== 0) return null;\n522:   const prefix = result.stdout.trim();\n523:   if (prefix === '') return null;\n524:   return prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;\n525: }\n526: \n527: function isUnderExempt(path, prefix) {\n528:   if (prefix === null) return false;\n529:   const trimmed = path.endsWith('/') ? path.slice(0, -1) : path;\n530:   return trimmed === prefix || trimmed.startsWith(`${prefix}/`);\n531: }\n532: \n533: function dirtyPaths(paths, prefix) {\n534:   return [...paths.keys()]\n535:     .filter((path) => !isUnderExempt(path, prefix))\n536:     .sort();\n537: }\n538: \n539: // A path counts as changed when its status code differs, so a file that was already\n540: // dirty before the run is never reverted on another worker's behalf.\n541: function changedPaths(before, after) {\n542:   const changed = [];\n543:   for (const [path, code] of after) {\n544:     if (before.get(path) !== code) changed.push(path);\n545:   }\n546:   return changed.sort();\n547: }\n548: \n549: // The head and the stash are the two places another operator's git work can hide.\n550: function gitSnapshot() {\n551:   return {\n552:     head: gitText(['rev-parse', 'HEAD']).trim(),\n553:     stash: gitText(['stash', 'list']),\n554:   };\n555: }\n556: \n557: // A remote is the one piece of git state a turn could use to reach outside the\n558: // checkout, so its presence is read rather than the branch's tracking state.\n559: function remoteNames() {\n560:   return gitText(['remote'])\n561:     .split('\\n')\n562:     .map((name) => name.trim())\n563:     .filter((name) => name !== '');\n564: }\n565: \n566: // ───────────────────────────────────────────────────────────────\n567: // Prompt source and run log\n568: // ───────────────────────────────────────────────────────────────\n569: \n570: /** A refusal the operator can act on without a stack trace. */\n571: class Refusal extends Error {\n572:   constructor(code, message) {\n573:     super(message);\n574:     this.code = code;\n575:   }\n576: }\n577: \n578: // A row is read one line at a time so a holdout row is refused before its prompt\n579: // reaches a child process or the run log. Discarding the text after reading it\n580: // would still have put an unmeasured prompt in the arm's path. The guard sits in\n581: // the lookup itself, so a run, a selection and a listing all answer a refused id\n582: // the same way instead of one of them getting there through a usage error.\n583: function findRow(rowId) {\n584:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n585:     if (line.trim() === '') continue;\n586:     const row = JSON.parse(line);\n587:     if (row.id !== rowId) continue;\n588:     if (row.split === 'holdout') {\n589:       throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n590:     }\n591:     return row;\n592:   }\n593:   throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n594: }\n595: \n596: function lookupPrompt(rowId) {\n597:   const row = findRow(rowId);\n598:   if (typeof row.prompt !== 'string' || row.prompt === '') {\n599:     throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n600:   }\n601:   return { prompt: row.prompt };\n602: }\n603: \n604: // Selection reads the labels only, so no picker walks a structure that carries a\n605: // prompt.\n606: function rowLabels() {\n607:   const labels = [];\n608:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n609:     if (line.trim() === '') continue;\n610:     const row = JSON.parse(line);\n611:     labels.push({ id: row.id, split: row.split, rowType: row.row_type, policy: row.expected_policy });\n612:   }\n613:   return labels;\n614: }\n615: \n616: // The log is written after the closing snapshot, so the file the runner creates is\n617: // never a changed path it then tries to restore.\n618: function appendRunLine(outPath, line) {\n619:   mkdirSync(dirname(outPath), { recursive: true });\n620:   appendFileSync(outPath, `${JSON.stringify(line)}\\n`, 'utf8');\n621: }\n622: \n623: // ───────────────────────────────────────────────────────────────\n624: // Prompt sets\n625: // ───────────────────────────────────────────────────────────────\n626: //\n627: // A set is a whole arm's worth of prompts, so naming one is how a run says which\n628: // question it answers. The chat set is drawn from the measured corpus and shows\n629: // where a command is started, offered or declined. The started-command set is\n630: // fixed instead, because it asks something the corpus cannot: once a heavy\n631: // workflow begins, does it take its lock before its first write. Each command it\n632: // covers appears twice, as a plain request and with the autonomous mode spelled\n633: // out, so a start the model chose is told apart from one it was told to make. The\n634: // two loops are capped at one iteration, because a deeper run buries the first\n635: // write under the later ones the run made.\n636: \n637: // The chat set is as wide as one arm can afford on every measured runtime and no\n638: // wider: enough start rows to show a rate, the offered and declined policies in\n639: // proportion, and a safety probe for each must-not-start shape.\n640: const CHAT_PICKS = Object.freeze([\n641:   { policy: 'start', count: 8 },\n642:   { policy: 'run', count: 4 },\n643:   { policy: 'ask', count: 4 },\n644: ]);\n645: const CHAT_PROBE_COUNT = 8;\n646: \n647: // A short bucket means the corpus changed under the set, and a rate over fewer\n648: // rows than the arm claims would misreport the phase. It stops here instead.\n649: function sortedPick(labels, count, bucket) {\n650:   const ids = labels.map((label) => label.id).sort().slice(0, count);\n651:   if (ids.length < count) {\n652:     throw new Refusal('set_short', `${bucket}: expected ${count} rows, found ${ids.length}`);\n653:   }\n654:   return ids;\n655: }\n656: \n657: function chatRowIds() {\n658:   const labels = rowLabels();\n659:   const plain = labels.filter((label) => label.split === 'tune' && label.rowType === 'plain');\n660:   const ids = [];\n661:   for (const pick of CHAT_PICKS) {\n662:     const bucket = plain.filter((label) => label.policy === pick.policy);\n663:     ids.push(...sortedPick(bucket, pick.count, `chat ${pick.policy}`));\n664:   }\n665:   const probes = labels.filter((label) => label.rowType === 'must-not-start');\n666:   ids.push(...sortedPick(probes, CHAT_PROBE_COUNT, 'chat must-not-start'));\n667:   return ids;\n668: }\n669: \n670: // The fixture sits beside the run log, so the log and the folder it measured\n671: // travel together and an operator can move both without editing a prompt.\n672: const G2_SET = 'g2';\n673: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n674: const FIXTURE_TOKEN = '{fixture}';\n675: \n676: const G2_ROWS = Object.freeze([\n677:   {\n678:     id: 'g2-deep-research-ask',\n679:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n680:   },\n681:   {\n682:     id: 'g2-deep-research-typed',\n683:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n684:   },\n685:   {\n686:     id: 'g2-deep-review-ask',\n687:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n688:   },\n689:   {\n690:     id: 'g2-deep-review-typed',\n691:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n692:   },\n693:   {\n694:     id: 'g2-speckit-complete-ask',\n695:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n696:   },\n697:   {\n698:     id: 'g2-speckit-complete-typed',\n699:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n700:   },\n701: ]);\n702: \n703: const G2_PROMPTS = new Map(G2_ROWS.map((row) => [row.id, row.prompt]));\n704: \n705: const SETS = Object.freeze({\n706:   chat: chatRowIds,\n707:   [G2_SET]: () => G2_ROWS.map((row) => row.id),\n708: });\n709: \n710: // `--list` and `--set` name the same thing. One prints the rows and the other\n711: // runs them, and an invocation that asks for both lists what it would run.\n712: function setNameOf(options) {\n713:   return options.list === null ? options.set : options.list;\n714: }\n715: \n716: function setRowIds(setName) {\n717:   if (!has(SETS, setName)) throw new UsageError(`unknown set: ${setName}`);\n718:   return SETS[setName]();\n719: }\n720: \n721: // A fixed prompt carries its own text, so its id needs no corpus row. Every other\n722: // id passes the lookup a run would use, so an id arriving on the command line and\n723: // nothing else is still checked before it can become an arm's row.\n724: function assertRunnable(rowId) {\n725:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n726:   return rowId;\n727: }\n728: \n729: function selectedRowIds(options) {\n730:   const setName = setNameOf(options);\n731:   const fromSet = setName === null ? [] : setRowIds(setName);\n732:   const explicit = options.rowIds.map(assertRunnable);\n733:   return [...new Set([...fromSet, ...explicit])];\n734: }\n735: \n736: function fixtureDir(options) {\n737:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n738: }\n739: \n740: // A placeholder keeps the fixed prompts free of a path that only exists on the\n741: // machine the arm runs on.\n742: function promptFor(rowId, fixture) {\n743:   const fixed = G2_PROMPTS.get(rowId);\n744:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n745:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n746: }\n747: \n748: // The cap belongs to the prompt rather than to the invocation, so an arm that\n749: // mixes the two sets still gives a started workflow the time it needs.\n750: function capForRow(rowId) {\n751:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n752: }\n753: \n754: // ───────────────────────────────────────────────────────────────\n755: // One turn\n756: // ───────────────────────────────────────────────────────────────\n757: \n758: // A dispatched worker's marker makes a CLI answer as a child session, and a child\n759: // session is not the chat start an arm measures. The rest of the environment stays,\n760: // so each CLI finds its own home, account and route.\n761: //\n762: // The network credentials are the exception, because a turn that reaches a forge\n763: // with the operator's identity is a side effect no transcript can undo. The token\n764: // variables go, the GitHub CLI is pointed at an empty folder beside the run log\n765: // rather than the operator's authenticated one, and an empty credential helper\n766: // replaces whatever a global git config would have offered. A missing credential\n767: // then fails at once instead of waiting on a terminal nobody is sitting at.\n768: const GITHUB_TOKEN_VARS = Object.freeze(['GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN']);\n769: \n770: const GIT_CREDENTIAL_OVERRIDES = Object.freeze({\n771:   GIT_CONFIG_COUNT: '1',\n772:   GIT_CONFIG_KEY_0: 'credential.helper',\n773:   GIT_CONFIG_VALUE_0: '',\n774: });\n775: \n776: // The empty folder lives beside the run log, so a run leaves its own directory\n777: // behind instead of a path in the operator's home that the next run inherits.\n778: function ghConfigDir(outPath) {\n779:   return join(dirname(outPath), 'gh-config-empty');\n780: }\n781: \n782: function childEnv(ghConfig) {\n783:   const env = { ...process.env };\n784:   delete env.AI_SESSION_CHILD;\n785:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n786:   env.GH_CONFIG_DIR = ghConfig;\n787:   env.GIT_TERMINAL_PROMPT = '0';\n788:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n789:   return env;\n790: }\n791: \n792: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n793:   return new Promise((settle) => {\n794:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n795:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n796:     // input nobody types until the cap runs out into an empty transcript.\n797:     const child = spawn(runtime.command, argv, {\n798:       cwd: REPO_ROOT,\n799:       env: childEnv(ghConfig),\n800:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n801:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n802:       // A chat turn still running after its cap is stuck, while a started workflow\n803:       // legitimately needs the longer one. The prompt decides which it gets.\n804:       timeout: capMs,\n805:     });\n806:     // The prompt is written and the stream closed at once, so a CLI that reads until\n807:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n808:     // broken pipe behind, and that write error is the CLI's failure to report rather\n809:     // than an uncaught error that would end the run early.\n810:     if (child.stdin !== null) {\n811:       child.stdin.on('error', () => {});\n812:       child.stdin.end(prompt);\n813:     }\n814:     const locator = streamLocator(runtime.locator.field ?? null);\n815:     // The turn's own output is still shown, and the locator is read out of the\n816:     // same bytes, so watching a run and recording it never diverge.\n817:     child.stdout.setEncoding('utf8');\n818:     child.stdout.on('data', (chunk) => {\n819:       locator.push(chunk);\n820:       process.stdout.write(chunk);\n821:     });\n822:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n823:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n824:   });\n825: }\n826: \n827: // ───────────────────────────────────────────────────────────────\n828: // CLI\n829: // ───────────────────────────────────────────────────────────────\n830: \n831: class UsageError extends Error {}\n832: \n833: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n834: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n835: const SAMPLE_SESSION_ID = 'sample-session-id';\n836: \n837: // An arm label decides how a later scorer groups a whole log, so a typo would\n838: // quietly invent a third arm. The set is closed for that reason.\n839: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n840: \n841: // The pre-change arm is the default because it is the one that can run before the\n842: // brief lands. A post-change run has to say which arm it belongs to. The\n843: // started-command set carries its own arm, so a run of it cannot land in the\n844: // change comparison by omission.\n845: const DEFAULT_ARM = 'pre';\n846: \n847: const USAGE = [\n848:   `usage: ${SCRIPT_NAME} --print-argv <runtime>`,\n849:   `       ${SCRIPT_NAME} --list <set>`,\n850:   `       ${SCRIPT_NAME} --runtime <runtime> (--set <set> | --row-id <id>...)`,\n851:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n852:   `       ${SCRIPT_NAME} --backfill <run-log> --out <new-log> [--brief-only]`,\n853: ].join('\\n');\n854: \n855: function resolveRuntime(name) {\n856:   if (has(RUNTIMES, name)) {\n857:     return RUNTIMES[name];\n858:   }\n859:   if (has(NOT_MEASURED, name)) {\n860:     throw new UsageError(`runtime ${name} is not measured: ${NOT_MEASURED[name]}`);\n861:   }\n862:   throw new UsageError(`unknown runtime: ${name}`);\n863: }\n864: \n865: function valueAfter(argv, index, flag) {\n866:   const value = argv[index];\n867:   if (typeof value !== 'string' || value.startsWith('--')) {\n868:     throw new UsageError(`${flag}: a value is required`);\n869:   }\n870:   return value;\n871: }\n872: \n873: // A set that has its own arm names it, so a started-command run cannot join the\n874: // change comparison because nobody passed `--arm`.\n875: function armFor(options) {\n876:   if (options.arm !== null) return options.arm;\n877:   return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n878: }\n879: \n880: function parseOptions(argv) {\n881:   const options = {\n882:     printArgv: null,\n883:     list: null,\n884:     set: null,\n885:     runtime: null,\n886:     rowIds: [],\n887:     arm: null,\n888:     out: null,\n889:     backfill: null,\n890:     fixture: null,\n891:     dryRun: false,\n892:     briefOnly: false,\n893:   };\n894:   for (let index = 0; index < argv.length; index += 1) {\n895:     const token = argv[index];\n896:     if (token === '--print-argv') {\n897:       index += 1;\n898:       options.printArgv = valueAfter(argv, index, '--print-argv');\n899:     } else if (token === '--list') {\n900:       index += 1;\n901:       options.list = valueAfter(argv, index, '--list');\n902:     } else if (token === '--set') {\n903:       index += 1;\n904:       options.set = valueAfter(argv, index, '--set');\n905:     } else if (token === '--runtime') {\n906:       index += 1;\n907:       options.runtime = valueAfter(argv, index, '--runtime');\n908:     } else if (token === '--row-id') {\n909:       index += 1;\n910:       options.rowIds.push(valueAfter(argv, index, '--row-id'));\n911:     } else if (token === '--arm') {\n912:       index += 1;\n913:       const arm = valueAfter(argv, index, '--arm');\n914:       if (!ARMS.includes(arm)) {\n915:         throw new UsageError(`--arm: expected one of ${ARMS.join(', ')}`);\n916:       }\n917:       options.arm = arm;\n918:     } else if (token === '--out') {\n919:       index += 1;\n920:       options.out = resolve(valueAfter(argv, index, '--out'));\n921:     } else if (token === '--backfill') {\n922:       index += 1;\n923:       options.backfill = resolve(valueAfter(argv, index, '--backfill'));\n924:     } else if (token === '--fixture') {\n925:       index += 1;\n926:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n927:     } else if (token === '--dry-run') {\n928:       options.dryRun = true;\n929:     } else if (token === '--brief-only') {\n930:       options.briefOnly = true;\n931:     } else {\n932:       throw new UsageError(`unknown option: ${token}`);\n933:     }\n934:   }\n935:   return options;\n936: }\n937: \n938: // One mode per invocation. Asking for an argv and a run at once would hide which\n939: // one the operator meant, and a run with no log has nowhere to record its proof.\n940: function selectMode(options) {\n941:   // Only a backfill rewrites delivery, so the flag on any other invocation would\n942:   // parse and then quietly change nothing.\n943:   if (options.briefOnly && options.backfill === null) {\n944:     throw new UsageError('--brief-only needs --backfill');\n945:   }\n946:   if (options.printArgv !== null) return 'print-argv';\n947:   if (options.list !== null) return 'list';\n948:   if (options.backfill !== null) {\n949:     if (options.out === null) throw new UsageError('--out is required');\n950:     return 'backfill';\n951:   }\n952:   if (options.runtime === null) throw new UsageError('--runtime is required');\n953:   if (options.set === null && options.rowIds.length === 0) {\n954:     throw new UsageError('--set or --row-id is required');\n955:   }\n956:   if (options.out === null) throw new UsageError('--out is required');\n957:   return 'run';\n958: }\n959: \n960: function writeJson(value) {\n961:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n962: }\n963: \n964: function writeRowIds(rowIds) {\n965:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n966: }\n967: \n968: function writeArgv(runtimeName) {\n969:   const runtime = resolveRuntime(runtimeName);\n970:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n971:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n972:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n973:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n974:   }\n975:   writeJson(argv);\n976: }\n977: \n978: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n979: // fires, so a broken precondition never spends another model call.\n980: async function runTurn(job, options, exempt, isFirst) {\n981:   const before = { status: statusPaths(), ...gitSnapshot() };\n982:   if (isFirst) {\n983:     // A live turn can push, so it may only start where there is no remote to push\n984:     // to. A dry run spawns nothing and keeps running in this checkout.\n985:     if (!options.dryRun) {\n986:       const remotes = remoteNames();\n987:       if (remotes.length > 0) {\n988:         return {\n989:           status: EXIT_REFUSED,\n990:           refusal: { ok: false, code: 'remote_present', remotes },\n991:         };\n992:       }\n993:     }\n994:     const dirty = dirtyPaths(before.status, exempt);\n995:     if (dirty.length > 0) {\n996:       return {\n997:         status: EXIT_REFUSED,\n998:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n999:       };\n1000:     }\n1001:   }\n1002: \n1003:   const sessionId = randomUUID();\n1004:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1005:   // A runtime that names its session only in its own store is bracketed by a\n1006:   // listing, and the entry the turn added is the session it wrote. A dry run\n1007:   // starts no CLI, so it has nothing to list.\n1008:   const listed = !options.dryRun && listsStore(job.runtime);\n1009:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1010:   const turn = options.dryRun\n1011:     ? { exit: null, error: null, streamId: null }\n1012:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1013:   const reportedId = listed\n1014:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1015:     : turn.streamId;\n1016: \n1017:   const after = { status: statusPaths(), ...gitSnapshot() };\n1018:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1019:   const changed = changedPaths(before.status, after.status);\n1020:   // The locator is kept in hand because the brief reader opens the same session\n1021:   // the line records, and resolving it twice could name a different file.\n1022:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1023:   const line = {\n1024:     runtime: job.runtimeName,\n1025:     rowId: job.rowId,\n1026:     arm: options.arm,\n1027:     locator,\n1028:     exit: turn.exit,\n1029:     changedPaths: changed,\n1030:   };\n1031: \n1032:   if (headMoved) {\n1033:     // The worktree the restore was written for is gone. Restoring now could discard\n1034:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1035:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1036:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1037:   }\n1038: \n1039:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1040:   // honestly report as left as found.\n1041:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\n1042:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\n1043:   // The head the reader saw is the only place the offer was named, and not every\n1044:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1045:   // replays it, which lets an operator read the offer without paying for a model\n1046:   // call, while the brief stays `unknown` because no session exists to read.\n1047:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1048:   // Pi, Devin and DSH keep the brief in their session store rather than in the\n1049:   // turn records, so the delivery check needs the reader that opens that store.\n1050:   const delivered = options.dryRun\n1051:     ? 'unknown'\n1052:     : await briefDelivered({ runtime: job.runtimeName, locator, loadSession: loadSharedSession });\n1053:   appendRunLine(options.out, {\n1054:     ...line,\n1055:     offeredCommand: offer.offeredCommand,\n1056:     offeredPolicy: offer.offeredPolicy,\n1057:     briefDelivered: delivered,\n1058:     restored,\n1059:     ...(restore !== null && restore.leftoverPaths.length > 0\n1060:       ? { leftoverPaths: restore.leftoverPaths }\n1061:       : {}),\n1062:   });\n1063: \n1064:   if (turn.error !== null) {\n1065:     const detail = turn.error.message;\n1066:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1067:   }\n1068:   if (!restored) {\n1069:     return {\n1070:       status: 1,\n1071:       refusal: {\n1072:         ok: false,\n1073:         code: 'restore_failed',\n1074:         rowId: job.rowId,\n1075:         paths: changed,\n1076:         ...(restore === null ? {} : { leftoverPaths: restore.leftoverPaths }),\n1077:       },\n1078:     };\n1079:   }\n1080:   return { status: 0, refusal: null };\n1081: }\n1082: \n1083: async function runArm(options, rowIds) {\n1084:   const exempt = exemptPrefix(dirname(options.out));\n1085:   const runtime = resolveRuntime(options.runtime);\n1086:   const fixture = fixtureDir(options);\n1087:   // Created once before the first snapshot, so the folder a turn needs is never\n1088:   // read back as a path the turn itself changed.\n1089:   const ghConfig = ghConfigDir(options.out);\n1090:   mkdirSync(ghConfig, { recursive: true });\n1091:   for (let index = 0; index < rowIds.length; index += 1) {\n1092:     const rowId = rowIds[index];\n1093:     const prompt = promptFor(rowId, fixture);\n1094:     const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n1095:     const result = await runTurn(job, options, exempt, index === 0);\n1096:     if (result.refusal !== null) writeJson(result.refusal);\n1097:     if (result.status !== 0) return result.status;\n1098:   }\n1099:   return 0;\n1100: }\n1101: \n1102: // A finished log is rewritten from its recorded lines alone, and the fixture folder\n1103: // still sits beside the log the arm wrote. The corpus lookup runs before the first\n1104: // line is written, so a row the dataset guard refuses leaves no output file behind.\n1105: async function backfillLog(options) {\n1106:   const fixture = resolve(dirname(options.backfill), G2_FIXTURE_DIRNAME);\n1107:   const result = await backfillRunLog({\n1108:     inPath: options.backfill,\n1109:     outPath: options.out,\n1110:     promptFor: (rowId) => promptFor(rowId, fixture),\n1111:     briefOnly: options.briefOnly,\n1112:   });\n1113:   writeJson(result);\n1114:   return result.ok ? 0 : EXIT_REFUSED;\n1115: }\n1116: \n1117: async function main(argv) {\n1118:   try {\n1119:     const options = parseOptions(argv);\n1120:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1121:     // answered by that guard rather than by whichever usage check would run first.\n1122:     const rowIds = selectedRowIds(options);\n1123:     const mode = selectMode(options);\n1124:     options.arm = armFor(options);\n1125: \n1126:     if (mode === 'print-argv') {\n1127:       writeArgv(options.printArgv);\n1128:       return 0;\n1129:     }\n1130:     if (mode === 'list') {\n1131:       writeRowIds(rowIds);\n1132:       return 0;\n1133:     }\n1134:     if (mode === 'backfill') {\n1135:       return await backfillLog(options);\n1136:     }\n1137:     return await runArm(options, rowIds);\n1138:   } catch (error) {\n1139:     if (error instanceof UsageError) {\n1140:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1141:       return EXIT_REFUSED;\n1142:     }\n1143:     if (error instanceof Refusal) {\n1144:       writeJson({ ok: false, code: error.code, detail: error.message });\n1145:       return EXIT_REFUSED;\n1146:     }\n1147:     throw error;\n1148:   }\n1149: }\n1150: \n1151: try {\n1152:   process.exitCode = await main(process.argv.slice(2));\n1153: } catch (error) {\n1154:   if (error instanceof UsageError) {\n1155:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1156:     process.exitCode = EXIT_REFUSED;\n1157:   } else {\n1158:     throw error;\n1159:   }\n1160: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1-1160\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: One-Turn Command Behaviour Runner\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Command surfacing is only proven by a turn that starts the way an operator\n6: // starts it: one prompt, the real CLI, and a session id the transcript reader\n7: // can open afterwards. Every runtime clears a different non-interactive hurdle,\n8: // so each argv lives in one table instead of in ad-hoc spawn calls.\n9: //\n10: // Three properties decide whether a run counts as evidence at all:\n11: //\n12: //   - Each builder pre-approves the tools its set needs. A permission prompt in\n13: //     a non-interactive turn has nobody to answer it, and the refusal it leaves\n14: //     behind is indistinguishable downstream from a model that chose to write\n15: //     nothing. Without this, every must-not-start row passes for the wrong\n16: //     reason.\n17: //   - The prompt travels in argv where the CLI takes a positional prompt, and on\n18: //     stdin where the CLI reads it there. Feeding a prompt to the wrong channel\n19: //     measures the argument parser rather than the model.\n20: //   - A turn is capped by the prompt it runs. A chat turn still running after\n21: //     five minutes is stuck, while a started heavy workflow can legitimately work\n22: //     for fifteen. One cap for both would either cut real work short or wait out\n23: //     a dead process.\n24: //\n25: // A live turn runs in this worktree, so the runner also owns its clean-up. The\n26: // worktree is refused before the first prompt when it holds anything outside the\n27: // run log's own folder, because the restore that follows a turn is only safe when\n28: // nobody else has an uncommitted edit in reach. Every prompt is bracketed by a\n29: // snapshot, and whatever the turn changed is restored or deleted. A commit or a\n30: // stash appearing mid-turn is work that is not the runner's to throw away, so that\n31: // run stops with its changed paths listed and no restore.\n32: //\n33: // A live turn is also a turn that can reach the network, so the runner takes the\n34: // reach away before the model has it. The child gets none of the GitHub tokens, an\n35: // empty GitHub CLI config, no credential helper and no terminal to be prompted on.\n36: // A live arm additionally refuses to start in a checkout that has any git remote,\n37: // because a command wrongly started there could push, tag or publish something the\n38: // arm cannot take back. A dry run spawns nothing, so it keeps running in this\n39: // checkout and its guards stay about file paths alone.\n40: //\n41: // Usage:\n42: //   node run-command-behaviour.mjs --print-argv <runtime>\n43: //   node run-command-behaviour.mjs --list <set>\n44: //   node run-command-behaviour.mjs --runtime <runtime> (--set <set> | --row-id <id>...)\n45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n46: //   node run-command-behaviour.mjs --backfill <run-log> --out <new-log> [--brief-only]\n47: \n48: import { appendFileSync, mkdirSync, readdirSync, readFileSync, realpathSync } from 'node:fs';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { homedir } from 'node:os';\n51: import { randomUUID } from 'node:crypto';\n52: import { spawn, spawnSync } from 'node:child_process';\n53: import { fileURLToPath } from 'node:url';\n54: import { dshProjectKey, dshStoreRoot } from '../../../../../hooks/shared/session-readers/dsh.mjs';\n55: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n56: import { backfillRunLog, briefDelivered, replayOffer } from './command-offer.mjs';\n57: import { restoreTurn, statusSnapshot } from './worktree-restore.mjs';\n58: \n59: const HERE = dirname(fileURLToPath(import.meta.url));\n60: const REPO_ROOT = resolve(HERE, '../../../../../..');\n61: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n62: // A stored session is found by its id plus the directory the turn ran in, and the\n63: // scorer reads it back from another checkout, so the locator records the resolved\n64: // directory instead of letting each reader compare the id against its own root.\n65: const PROJECT_DIR = realpathSync(REPO_ROOT);\n66: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n67: \n68: const EXIT_REFUSED = 2;\n69: const EXIT_HEAD_MOVED = 3;\n70: \n71: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n72: // from either set and the cap has to follow the row, not the invocation.\n73: const CAP_MS = Object.freeze({\n74:   chat: 300_000,\n75:   started: 900_000,\n76: });\n77: \n78: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n79: const CODEX_MODEL = 'gpt-6-luna';\n80: // The variant rides the model string, because `opencode run` has no flag for it.\n81: const OPENCODE_MODEL = 'llmgateway/deepseek-v4.1-flash-1017#max';\n82: const PI_MODEL = 'llmgateway/deepseek-v4.1-flash-1017';\n83: const DEVIN_MODEL = 'swe-2-max';\n84: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n85: \n86: // Runtimes the phase reports as not measured, with the reason a run would be\n87: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n88: // transcript could not be scored even if the turn ran.\n89: const NOT_MEASURED = Object.freeze({\n90:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n91: });\n92: \n93: function has(object, key) {\n94:   return Object.prototype.hasOwnProperty.call(object, key);\n95: }\n96: \n97: // ───────────────────────────────────────────────────────────────\n98: // Runtime argv table\n99: // ───────────────────────────────────────────────────────────────\n100: \n101: const RUNTIMES = {\n102:   claude: {\n103:     command: 'claude',\n104:     model: CLAUDE_MODEL,\n105:     promptOnStdin: false,\n106:     // stream-json writes one JSON object per line and every one of them carries\n107:     // the session id the transcript is stored under.\n108:     locator: { kind: 'stream', field: 'session_id' },\n109:     // The reader opens a transcript by id plus its own path, and Claude Code names\n110:     // the file after the session inside a folder per working directory.\n111:     findTranscript: claudeTranscriptPath,\n112:     buildArgv: ({ prompt }) => [\n113:       '-p',\n114:       prompt,\n115:       '--model',\n116:       CLAUDE_MODEL,\n117:       // stream-json is the only output format that carries the session id the\n118:       // reader needs after the turn ends.\n119:       '--output-format',\n120:       'stream-json',\n121:       '--verbose',\n122:       // Print mode has nobody to answer an approval prompt, and the default mode\n123:       // both denies writes and refuses shell commands, which is exactly the\n124:       // behaviour an ask-row test must be free to observe.\n125:       '--permission-mode',\n126:       'bypassPermissions',\n127:     ],\n128:   },\n129:   codex: {\n130:     command: 'codex',\n131:     model: CODEX_MODEL,\n132:     promptOnStdin: true,\n133:     // The run opens with an event naming its thread, and the rollout file is\n134:     // named after that thread id.\n135:     locator: { kind: 'stream', field: 'thread_id' },\n136:     // The rollout file is named after the thread id the stream reported, so the id\n137:     // alone leads back to it once the store has been searched.\n138:     findTranscript: codexTranscriptPath,\n139:     buildArgv: () => [\n140:       'exec',\n141:       // The JSON event stream is how a turn reports its thread id.\n142:       '--json',\n143:       '--model',\n144:       CODEX_MODEL,\n145:       '-c',\n146:       'model_reasoning_effort=medium',\n147:       '-c',\n148:       'service_tier=fast',\n149:       // A headless run cannot answer an approval prompt, and `exec` defaults to a\n150:       // read-only sandbox that would silently swallow every write.\n151:       '-c',\n152:       'approval_policy=never',\n153:       '--sandbox',\n154:       'workspace-write',\n155:       '-',\n156:     ],\n157:   },\n158:   opencode: {\n159:     command: 'opencode',\n160:     model: OPENCODE_MODEL,\n161:     promptOnStdin: false,\n162:     // The turn's own events carry the id of the session it created.\n163:     locator: { kind: 'stream', field: 'sessionID' },\n164:     buildArgv: ({ prompt }) => [\n165:       // `opencode run` takes no --dir, and the child already starts in the\n166:       // checkout, so passing the directory a second time would only fail.\n167:       'run',\n168:       // Without this the turn is handed to the operator's long-running background\n169:       // service, whose tools run with that service's environment. The hardened\n170:       // environment this runner builds would then never reach a tool call.\n171:       '--standalone',\n172:       '--model',\n173:       OPENCODE_MODEL,\n174:       '--format',\n175:       'json',\n176:       // Auto-approve everything not explicitly denied. A run that stalls on a\n177:       // permission prompt reads as a model that declined to act.\n178:       '--auto',\n179:       prompt,\n180:     ],\n181:   },\n182:   pi: {\n183:     command: 'pi',\n184:     model: PI_MODEL,\n185:     promptOnStdin: false,\n186:     // Print mode never reports the session it wrote, so the runner mints the id\n187:     // and passes it on the command line instead of recovering it from the stream.\n188:     locator: { kind: 'runner' },\n189:     buildArgv: ({ prompt, sessionId }) => [\n190:       '-p',\n191:       // Without it a non-interactive Pi probes the network on startup and can\n192:       // hang before it ever reads the prompt.\n193:       '--offline',\n194:       '--model',\n195:       PI_MODEL,\n196:       // Without a minted id the log would have to be guessed from whatever\n197:       // file is newest, which can open a neighbouring turn's transcript.\n198:       '--session-id',\n199:       sessionId,\n200:       prompt,\n201:     ],\n202:   },\n203:   devin: {\n204:     command: 'devin',\n205:     model: DEVIN_MODEL,\n206:     promptOnStdin: false,\n207:     // A Devin turn keeps its session in a store its own output does not name, so\n208:     // the id comes from the listing of the directory the turn ran in.\n209:     locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n210:     buildArgv: ({ prompt }) => [\n211:       '-p',\n212:       '--model',\n213:       DEVIN_MODEL,\n214:       // Under `accept-edits` every tool call that wants confirmation is refused,\n215:       // so a headless turn explores its whole budget and writes nothing.\n216:       '--permission-mode',\n217:       'dangerous',\n218:       // A fresh checkout has never been trusted interactively, and print mode has\n219:       // nobody to answer the trust prompt, so the turn would refuse to start.\n220:       '--respect-workspace-trust',\n221:       'false',\n222:       // No `--sandbox` here. That flag forces a permission mode that ignores\n223:       // `dangerous` and rejects every write in print mode, so a turn would write\n224:       // nothing and read as a model that declined. Containment comes from the\n225:       // arena instead.\n226:       // The separator keeps a prompt that opens with a dash from parsing as a flag.\n227:       '--',\n228:       prompt,\n229:     ],\n230:   },\n231:   dsh: {\n232:     command: 'dsh',\n233:     // dsh takes no model flag at all. The roster route patch decides the model,\n234:     // and this table pins the verified LLM Gateway route.\n235:     model: DSH_MODEL,\n236:     promptOnStdin: true,\n237:     // The harness names the session itself and refuses an id it never created,\n238:     // so the turn's id is recovered from the store folder its log lands in.\n239:     locator: { kind: 'store', list: dshSessionIds },\n240:     buildArgv: () => [\n241:       '--profile',\n242:       'headless',\n243:       '--patch',\n244:       resolve(DSH_PATCH_DIR, 'route-llmgateway-deepseek.patch.yml'),\n245:       // No lineage patch: it marks the run as a fan-out leaf, and the repo\n246:       // guards keep the prompt advisor off for a leaf. A chat turn has to\n247:       // receive the brief like a person's session would.\n248:       '--patch',\n249:       resolve(DSH_PATCH_DIR, 'guards.patch.yml'),\n250:       '--json',\n251:       '--permission-mode',\n252:       'workspace-write',\n253:       // Approvals default to ask, and a headless turn has nobody to answer.\n254:       '--approval-policy',\n255:       'never',\n256:       // The dash takes the prompt from stdin, which is the channel a headless\n257:       // run reads, and keeps a prompt that opens with one from parsing as a\n258:       // flag.\n259:       '-',\n260:     ],\n261:   },\n262: };\n263: \n264: // ───────────────────────────────────────────────────────────────\n265: // Session locator\n266: // ───────────────────────────────────────────────────────────────\n267: //\n268: // A run log is only evidence if it leads back to the exact transcript the turn\n269: // wrote, and each runtime exposes that handle in its own way. Three sources\n270: // exist: an id the CLI reports after the turn, either in its output or in the\n271: // session listing it keeps, an id the runner hands the CLI before it starts, or\n272: // no recorded source at all, which the log states rather than filling with the\n273: // newest file in the store.\n274: \n275: // Output arrives in chunks that cut a line in half, so a line is parsed only\n276: // once its newline has come through. Parsing stops at the first match, because\n277: // the id never changes within one turn.\n278: function streamLocator(field) {\n279:   let pending = '';\n280:   let captured = null;\n281:   return {\n282:     push(chunk) {\n283:       if (field === null || captured !== null) return;\n284:       pending += chunk;\n285:       const lines = pending.split('\\n');\n286:       pending = lines.pop() ?? '';\n287:       for (const line of lines) {\n288:         captured = readId(line, field);\n289:         if (captured !== null) return;\n290:       }\n291:     },\n292:     value() {\n293:       if (captured === null && pending !== '') captured = readId(pending, field);\n294:       return captured;\n295:     },\n296:   };\n297: }\n298: \n299: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n300: // this line holds no locator rather than that the run failed.\n301: function readId(line, field) {\n302:   let event;\n303:   try {\n304:     event = JSON.parse(line);\n305:   } catch {\n306:     return null;\n307:   }\n308:   const id = event?.[field];\n309:   return typeof id === 'string' && id !== '' ? id : null;\n310: }\n311: \n312: // A runtime that keeps its sessions in a store its output never names still lists\n313: // them for the directory the turn ran in, so two listings taken around a turn\n314: // reduce the store to a set difference. The listing runs in the child's\n315: // environment, because that is the store the turn itself wrote to.\n316: const LISTING_CAP_MS = 60_000;\n317: \n318: function listingIds(runtime, ghConfig) {\n319:   const source = runtime.locator;\n320:   if (source.kind !== 'listing') return null;\n321:   const result = spawnSync(runtime.command, source.args, {\n322:     cwd: REPO_ROOT,\n323:     env: childEnv(ghConfig),\n324:     encoding: 'utf8',\n325:     timeout: LISTING_CAP_MS,\n326:   });\n327:   if (result.error) return null;\n328:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n329: }\n330: \n331: // A runtime that names its session only in a store it owns is bracketed by two\n332: // readings of that store, and the entry the turn added is the session it wrote.\n333: function listsStore(runtime) {\n334:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n335: }\n336: \n337: // Only the reading differs between the store-backed forms: one CLI answers with\n338: // its own index and the other keeps one folder per session. Any other kind\n339: // names its session in the turn's output instead.\n340: function storeIds(runtime, ghConfig) {\n341:   return runtime.locator.kind === 'store'\n342:     ? runtime.locator.list()\n343:     : listingIds(runtime, ghConfig);\n344: }\n345: \n346: // The listing is a JSON array of session objects whose `id` field is the value\n347: // the CLI's own resume takes, so that field is the one that leads back to a\n348: // transcript. Any other shape names no session, which the caller reads as no id\n349: // rather than as a failed run.\n350: function listedSessionIds(text) {\n351:   let entries;\n352:   try {\n353:     entries = JSON.parse(text);\n354:   } catch {\n355:     return null;\n356:   }\n357:   if (!Array.isArray(entries)) return null;\n358:   return entries\n359:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n360:     .filter((id) => typeof id === 'string' && id !== '');\n361: }\n362: \n363: // A session another operator opened while the turn ran is not this turn's, and a\n364: // listing that reports none or several added entries has no id it can name with\n365: // confidence, so only a single added entry becomes the locator.\n366: function addedSessionId(before, after) {\n367:   if (before === null || after === null) return null;\n368:   const known = new Set(before);\n369:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n370:   return added.length === 1 ? added[0] : null;\n371: }\n372: \n373: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n374: // locator records the home the run used and the transcript stays findable from\n375: // the log alone.\n376: function dshHome() {\n377:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n378: }\n379: \n380: // A DSH session is a folder named after its id under one folder per project the\n381: // harness keyed from the directory the turn ran in, and the turn's own output\n382: // never names that id. The store root comes from the reader so the folder listed\n383: // here is the folder the reader will search. A store the harness has not created\n384: // yet lists nothing, which is the same answer as a turn that wrote no session.\n385: function dshSessionIds() {\n386:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n387:   try {\n388:     return readdirSync(store, { withFileTypes: true })\n389:       .filter((entry) => entry.isDirectory())\n390:       .map((entry) => entry.name);\n391:   } catch {\n392:     return [];\n393:   }\n394: }\n395: \n396: // A store folder is the CLI's to lay out, so the walk follows the folders it\n397: // creates and matches on the file name instead of predicting a path. A store that\n398: // is missing or unreadable names no transcript, which is the same answer as a turn\n399: // that wrote none rather than a reason to fail the run.\n400: function findTranscriptFiles(dir, matches, depth) {\n401:   let entries;\n402:   try {\n403:     entries = readdirSync(dir, { withFileTypes: true });\n404:   } catch {\n405:     return [];\n406:   }\n407:   const found = [];\n408:   for (const entry of entries) {\n409:     if (entry.isFile() && matches(entry.name)) {\n410:       found.push(join(dir, entry.name));\n411:     } else if (entry.isDirectory() && depth > 0) {\n412:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n413:     }\n414:   }\n415:   return found;\n416: }\n417: \n418: // One match is the turn's own transcript, while two leave the locator without a\n419: // path because choosing between them could score a neighbouring turn under this\n420: // row. The path is resolved so a log written from another checkout still opens.\n421: function storedTranscriptPath(root, matches, depth = Infinity) {\n422:   const found = findTranscriptFiles(root, matches, depth);\n423:   return found.length === 1 ? resolve(found[0]) : null;\n424: }\n425: \n426: // Claude Code keeps one folder per working directory and writes each transcript\n427: // directly inside it, so one level below the store is the whole of the search. A\n428: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n429: // and which the reader refuses.\n430: function claudeTranscriptPath(sessionId) {\n431:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n432:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n433: }\n434: \n435: // A Codex rollout file is named after its start time and ends with the thread id,\n436: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n437: // store is searched and the id is a suffix of the name.\n438: function codexTranscriptPath(sessionId) {\n439:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n440:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n441: }\n442: \n443: // A store listing that added no single entry leaves the id out rather than\n444: // naming a guess that would score a neighbouring turn under this row. The home\n445: // stays on the record so the store the run wrote to is findable from the log\n446: // alone.\n447: function storeLocator(reportedId) {\n448:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n449:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n450: }\n451: \n452: function locatorFor(runtime, sessionId, reportedId) {\n453:   const source = runtime.locator;\n454:   // The id the runner handed the CLI is the one the store keys its log by, and\n455:   // the directory the turn ran in is what a reader matches the log's header\n456:   // against, so both travel with every record.\n457:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n458:   if (source.kind === 'store') return storeLocator(reportedId);\n459:   // A runtime that reported no id records none, which keeps a scorer from opening\n460:   // a neighbouring transcript that happens to be newer.\n461:   if (reportedId === null) return null;\n462:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n463:   // A reader needs the file the turn wrote as well as its id, so a store-based\n464:   // runtime resolves the id to a path once the turn has closed. A turn that left\n465:   // no single match keeps the field out rather than naming a guess.\n466:   const transcriptPath = typeof runtime.findTranscript === 'function'\n467:     ? runtime.findTranscript(reportedId)\n468:     : null;\n469:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n470:   return locator;\n471: }\n472: \n473: // ───────────────────────────────────────────────────────────────\n474: // Worktree guards\n475: // ───────────────────────────────────────────────────────────────\n476: //\n477: // Every live turn runs in this worktree, so the runner cleans up after itself and\n478: // refuses to start when the worktree already holds work that is not its own. The\n479: // order matters: the remote check runs before the dirty check, so a live refusal\n480: // names the one condition an arm can never repair, and the dirty check runs before\n481: // the first prompt, so a restore can never discard an edit another worker has not\n482: // committed yet, and the head check runs around every prompt, so a commit or a\n483: // stash taken mid-turn stops the arm before the next model call rather than after\n484: // the damage.\n485: \n486: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n487: // lie, and the restore step trusts that snapshot.\n488: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n489: \n490: function git(args) {\n491:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n492:     cwd: REPO_ROOT,\n493:     encoding: 'utf8',\n494:   });\n495:   if (result.error) throw result.error;\n496:   return result;\n497: }\n498: \n499: function gitText(args) {\n500:   const result = git(args);\n501:   if (result.status !== 0) {\n502:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n503:   }\n504:   return result.stdout;\n505: }\n506: \n507: function statusPaths() {\n508:   return statusSnapshot(REPO_ROOT);\n509: }\n510: \n511: // The out folder is this arm's own output area. Git is asked for that folder's path\n512: // from the top of the repository, because comparing two spellings of the same\n513: // folder misreads a root that is reached through a symlink. An out folder outside\n514: // any repository exempts nothing, which only makes the guard stricter.\n515: function exemptPrefix(outDir) {\n516:   mkdirSync(outDir, { recursive: true });\n517:   const result = spawnSync('git', [...GIT_PREFIX, 'rev-parse', '--show-prefix'], {\n518:     cwd: outDir,\n519:     encoding: 'utf8',\n520:   });\n521:   if (result.status !== 0) return null;\n522:   const prefix = result.stdout.trim();\n523:   if (prefix === '') return null;\n524:   return prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;\n525: }\n526: \n527: function isUnderExempt(path, prefix) {\n528:   if (prefix === null) return false;\n529:   const trimmed = path.endsWith('/') ? path.slice(0, -1) : path;\n530:   return trimmed === prefix || trimmed.startsWith(`${prefix}/`);\n531: }\n532: \n533: function dirtyPaths(paths, prefix) {\n534:   return [...paths.keys()]\n535:     .filter((path) => !isUnderExempt(path, prefix))\n536:     .sort();\n537: }\n538: \n539: // A path counts as changed when its status code differs, so a file that was already\n540: // dirty before the run is never reverted on another worker's behalf.\n541: function changedPaths(before, after) {\n542:   const changed = [];\n543:   for (const [path, code] of after) {\n544:     if (before.get(path) !== code) changed.push(path);\n545:   }\n546:   return changed.sort();\n547: }\n548: \n549: // The head and the stash are the two places another operator's git work can hide.\n550: function gitSnapshot() {\n551:   return {\n552:     head: gitText(['rev-parse', 'HEAD']).trim(),\n553:     stash: gitText(['stash', 'list']),\n554:   };\n555: }\n556: \n557: // A remote is the one piece of git state a turn could use to reach outside the\n558: // checkout, so its presence is read rather than the branch's tracking state.\n559: function remoteNames() {\n560:   return gitText(['remote'])\n561:     .split('\\n')\n562:     .map((name) => name.trim())\n563:     .filter((name) => name !== '');\n564: }\n565: \n566: // ───────────────────────────────────────────────────────────────\n567: // Prompt source and run log\n568: // ───────────────────────────────────────────────────────────────\n569: \n570: /** A refusal the operator can act on without a stack trace. */\n571: class Refusal extends Error {\n572:   constructor(code, message) {\n573:     super(message);\n574:     this.code = code;\n575:   }\n576: }\n577: \n578: // A row is read one line at a time so a holdout row is refused before its prompt\n579: // reaches a child process or the run log. Discarding the text after reading it\n580: // would still have put an unmeasured prompt in the arm's path. The guard sits in\n581: // the lookup itself, so a run, a selection and a listing all answer a refused id\n582: // the same way instead of one of them getting there through a usage error.\n583: function findRow(rowId) {\n584:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n585:     if (line.trim() === '') continue;\n586:     const row = JSON.parse(line);\n587:     if (row.id !== rowId) continue;\n588:     if (row.split === 'holdout') {\n589:       throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n590:     }\n591:     return row;\n592:   }\n593:   throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n594: }\n595: \n596: function lookupPrompt(rowId) {\n597:   const row = findRow(rowId);\n598:   if (typeof row.prompt !== 'string' || row.prompt === '') {\n599:     throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n600:   }\n601:   return { prompt: row.prompt };\n602: }\n603: \n604: // Selection reads the labels only, so no picker walks a structure that carries a\n605: // prompt.\n606: function rowLabels() {\n607:   const labels = [];\n608:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n609:     if (line.trim() === '') continue;\n610:     const row = JSON.parse(line);\n611:     labels.push({ id: row.id, split: row.split, rowType: row.row_type, policy: row.expected_policy });\n612:   }\n613:   return labels;\n614: }\n615: \n616: // The log is written after the closing snapshot, so the file the runner creates is\n617: // never a changed path it then tries to restore.\n618: function appendRunLine(outPath, line) {\n619:   mkdirSync(dirname(outPath), { recursive: true });\n620:   appendFileSync(outPath, `${JSON.stringify(line)}\\n`, 'utf8');\n621: }\n622: \n623: // ───────────────────────────────────────────────────────────────\n624: // Prompt sets\n625: // ───────────────────────────────────────────────────────────────\n626: //\n627: // A set is a whole arm's worth of prompts, so naming one is how a run says which\n628: // question it answers. The chat set is drawn from the measured corpus and shows\n629: // where a command is started, offered or declined. The started-command set is\n630: // fixed instead, because it asks something the corpus cannot: once a heavy\n631: // workflow begins, does it take its lock before its first write. Each command it\n632: // covers appears twice, as a plain request and with the autonomous mode spelled\n633: // out, so a start the model chose is told apart from one it was told to make. The\n634: // two loops are capped at one iteration, because a deeper run buries the first\n635: // write under the later ones the run made.\n636: \n637: // The chat set is as wide as one arm can afford on every measured runtime and no\n638: // wider: enough start rows to show a rate, the offered and declined policies in\n639: // proportion, and a safety probe for each must-not-start shape.\n640: const CHAT_PICKS = Object.freeze([\n641:   { policy: 'start', count: 8 },\n642:   { policy: 'run', count: 4 },\n643:   { policy: 'ask', count: 4 },\n644: ]);\n645: const CHAT_PROBE_COUNT = 8;\n646: \n647: // A short bucket means the corpus changed under the set, and a rate over fewer\n648: // rows than the arm claims would misreport the phase. It stops here instead.\n649: function sortedPick(labels, count, bucket) {\n650:   const ids = labels.map((label) => label.id).sort().slice(0, count);\n651:   if (ids.length < count) {\n652:     throw new Refusal('set_short', `${bucket}: expected ${count} rows, found ${ids.length}`);\n653:   }\n654:   return ids;\n655: }\n656: \n657: function chatRowIds() {\n658:   const labels = rowLabels();\n659:   const plain = labels.filter((label) => label.split === 'tune' && label.rowType === 'plain');\n660:   const ids = [];\n661:   for (const pick of CHAT_PICKS) {\n662:     const bucket = plain.filter((label) => label.policy === pick.policy);\n663:     ids.push(...sortedPick(bucket, pick.count, `chat ${pick.policy}`));\n664:   }\n665:   const probes = labels.filter((label) => label.rowType === 'must-not-start');\n666:   ids.push(...sortedPick(probes, CHAT_PROBE_COUNT, 'chat must-not-start'));\n667:   return ids;\n668: }\n669: \n670: // The fixture sits beside the run log, so the log and the folder it measured\n671: // travel together and an operator can move both without editing a prompt.\n672: const G2_SET = 'g2';\n673: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n674: const FIXTURE_TOKEN = '{fixture}';\n675: \n676: const G2_ROWS = Object.freeze([\n677:   {\n678:     id: 'g2-deep-research-ask',\n679:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n680:   },\n681:   {\n682:     id: 'g2-deep-research-typed',\n683:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n684:   },\n685:   {\n686:     id: 'g2-deep-review-ask',\n687:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n688:   },\n689:   {\n690:     id: 'g2-deep-review-typed',\n691:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n692:   },\n693:   {\n694:     id: 'g2-speckit-complete-ask',\n695:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n696:   },\n697:   {\n698:     id: 'g2-speckit-complete-typed',\n699:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n700:   },\n701: ]);\n702: \n703: const G2_PROMPTS = new Map(G2_ROWS.map((row) => [row.id, row.prompt]));\n704: \n705: const SETS = Object.freeze({\n706:   chat: chatRowIds,\n707:   [G2_SET]: () => G2_ROWS.map((row) => row.id),\n708: });\n709: \n710: // `--list` and `--set` name the same thing. One prints the rows and the other\n711: // runs them, and an invocation that asks for both lists what it would run.\n712: function setNameOf(options) {\n713:   return options.list === null ? options.set : options.list;\n714: }\n715: \n716: function setRowIds(setName) {\n717:   if (!has(SETS, setName)) throw new UsageError(`unknown set: ${setName}`);\n718:   return SETS[setName]();\n719: }\n720: \n721: // A fixed prompt carries its own text, so its id needs no corpus row. Every other\n722: // id passes the lookup a run would use, so an id arriving on the command line and\n723: // nothing else is still checked before it can become an arm's row.\n724: function assertRunnable(rowId) {\n725:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n726:   return rowId;\n727: }\n728: \n729: function selectedRowIds(options) {\n730:   const setName = setNameOf(options);\n731:   const fromSet = setName === null ? [] : setRowIds(setName);\n732:   const explicit = options.rowIds.map(assertRunnable);\n733:   return [...new Set([...fromSet, ...explicit])];\n734: }\n735: \n736: function fixtureDir(options) {\n737:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n738: }\n739: \n740: // A placeholder keeps the fixed prompts free of a path that only exists on the\n741: // machine the arm runs on.\n742: function promptFor(rowId, fixture) {\n743:   const fixed = G2_PROMPTS.get(rowId);\n744:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n745:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n746: }\n747: \n748: // The cap belongs to the prompt rather than to the invocation, so an arm that\n749: // mixes the two sets still gives a started workflow the time it needs.\n750: function capForRow(rowId) {\n751:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n752: }\n753: \n754: // ───────────────────────────────────────────────────────────────\n755: // One turn\n756: // ───────────────────────────────────────────────────────────────\n757: \n758: // A dispatched worker's marker makes a CLI answer as a child session, and a child\n759: // session is not the chat start an arm measures. The rest of the environment stays,\n760: // so each CLI finds its own home, account and route.\n761: //\n762: // The network credentials are the exception, because a turn that reaches a forge\n763: // with the operator's identity is a side effect no transcript can undo. The token\n764: // variables go, the GitHub CLI is pointed at an empty folder beside the run log\n765: // rather than the operator's authenticated one, and an empty credential helper\n766: // replaces whatever a global git config would have offered. A missing credential\n767: // then fails at once instead of waiting on a terminal nobody is sitting at.\n768: const GITHUB_TOKEN_VARS = Object.freeze(['GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN']);\n769: \n770: const GIT_CREDENTIAL_OVERRIDES = Object.freeze({\n771:   GIT_CONFIG_COUNT: '1',\n772:   GIT_CONFIG_KEY_0: 'credential.helper',\n773:   GIT_CONFIG_VALUE_0: '',\n774: });\n775: \n776: // The empty folder lives beside the run log, so a run leaves its own directory\n777: // behind instead of a path in the operator's home that the next run inherits.\n778: function ghConfigDir(outPath) {\n779:   return join(dirname(outPath), 'gh-config-empty');\n780: }\n781: \n782: function childEnv(ghConfig) {\n783:   const env = { ...process.env };\n784:   delete env.AI_SESSION_CHILD;\n785:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n786:   env.GH_CONFIG_DIR = ghConfig;\n787:   env.GIT_TERMINAL_PROMPT = '0';\n788:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n789:   return env;\n790: }\n791: \n792: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n793:   return new Promise((settle) => {\n794:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n795:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n796:     // input nobody types until the cap runs out into an empty transcript.\n797:     const child = spawn(runtime.command, argv, {\n798:       cwd: REPO_ROOT,\n799:       env: childEnv(ghConfig),\n800:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n801:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n802:       // A chat turn still running after its cap is stuck, while a started workflow\n803:       // legitimately needs the longer one. The prompt decides which it gets.\n804:       timeout: capMs,\n805:     });\n806:     // The prompt is written and the stream closed at once, so a CLI that reads until\n807:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n808:     // broken pipe behind, and that write error is the CLI's failure to report rather\n809:     // than an uncaught error that would end the run early.\n810:     if (child.stdin !== null) {\n811:       child.stdin.on('error', () => {});\n812:       child.stdin.end(prompt);\n813:     }\n814:     const locator = streamLocator(runtime.locator.field ?? null);\n815:     // The turn's own output is still shown, and the locator is read out of the\n816:     // same bytes, so watching a run and recording it never diverge.\n817:     child.stdout.setEncoding('utf8');\n818:     child.stdout.on('data', (chunk) => {\n819:       locator.push(chunk);\n820:       process.stdout.write(chunk);\n821:     });\n822:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n823:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n824:   });\n825: }\n826: \n827: // ───────────────────────────────────────────────────────────────\n828: // CLI\n829: // ───────────────────────────────────────────────────────────────\n830: \n831: class UsageError extends Error {}\n832: \n833: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n834: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n835: const SAMPLE_SESSION_ID = 'sample-session-id';\n836: \n837: // An arm label decides how a later scorer groups a whole log, so a typo would\n838: // quietly invent a third arm. The set is closed for that reason.\n839: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n840: \n841: // The pre-change arm is the default because it is the one that can run before the\n842: // brief lands. A post-change run has to say which arm it belongs to. The\n843: // started-command set carries its own arm, so a run of it cannot land in the\n844: // change comparison by omission.\n845: const DEFAULT_ARM = 'pre';\n846: \n847: const USAGE = [\n848:   `usage: ${SCRIPT_NAME} --print-argv <runtime>`,\n849:   `       ${SCRIPT_NAME} --list <set>`,\n850:   `       ${SCRIPT_NAME} --runtime <runtime> (--set <set> | --row-id <id>...)`,\n851:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n852:   `       ${SCRIPT_NAME} --backfill <run-log> --out <new-log> [--brief-only]`,\n853: ].join('\\n');\n854: \n855: function resolveRuntime(name) {\n856:   if (has(RUNTIMES, name)) {\n857:     return RUNTIMES[name];\n858:   }\n859:   if (has(NOT_MEASURED, name)) {\n860:     throw new UsageError(`runtime ${name} is not measured: ${NOT_MEASURED[name]}`);\n861:   }\n862:   throw new UsageError(`unknown runtime: ${name}`);\n863: }\n864: \n865: function valueAfter(argv, index, flag) {\n866:   const value = argv[index];\n867:   if (typeof value !== 'string' || value.startsWith('--')) {\n868:     throw new UsageError(`${flag}: a value is required`);\n869:   }\n870:   return value;\n871: }\n872: \n873: // A set that has its own arm names it, so a started-command run cannot join the\n874: // change comparison because nobody passed `--arm`.\n875: function armFor(options) {\n876:   if (options.arm !== null) return options.arm;\n877:   return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n878: }\n879: \n880: function parseOptions(argv) {\n881:   const options = {\n882:     printArgv: null,\n883:     list: null,\n884:     set: null,\n885:     runtime: null,\n886:     rowIds: [],\n887:     arm: null,\n888:     out: null,\n889:     backfill: null,\n890:     fixture: null,\n891:     dryRun: false,\n892:     briefOnly: false,\n893:   };\n894:   for (let index = 0; index < argv.length; index += 1) {\n895:     const token = argv[index];\n896:     if (token === '--print-argv') {\n897:       index += 1;\n898:       options.printArgv = valueAfter(argv, index, '--print-argv');\n899:     } else if (token === '--list') {\n900:       index += 1;\n901:       options.list = valueAfter(argv, index, '--list');\n902:     } else if (token === '--set') {\n903:       index += 1;\n904:       options.set = valueAfter(argv, index, '--set');\n905:     } else if (token === '--runtime') {\n906:       index += 1;\n907:       options.runtime = valueAfter(argv, index, '--runtime');\n908:     } else if (token === '--row-id') {\n909:       index += 1;\n910:       options.rowIds.push(valueAfter(argv, index, '--row-id'));\n911:     } else if (token === '--arm') {\n912:       index += 1;\n913:       const arm = valueAfter(argv, index, '--arm');\n914:       if (!ARMS.includes(arm)) {\n915:         throw new UsageError(`--arm: expected one of ${ARMS.join(', ')}`);\n916:       }\n917:       options.arm = arm;\n918:     } else if (token === '--out') {\n919:       index += 1;\n920:       options.out = resolve(valueAfter(argv, index, '--out'));\n921:     } else if (token === '--backfill') {\n922:       index += 1;\n923:       options.backfill = resolve(valueAfter(argv, index, '--backfill'));\n924:     } else if (token === '--fixture') {\n925:       index += 1;\n926:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n927:     } else if (token === '--dry-run') {\n928:       options.dryRun = true;\n929:     } else if (token === '--brief-only') {\n930:       options.briefOnly = true;\n931:     } else {\n932:       throw new UsageError(`unknown option: ${token}`);\n933:     }\n934:   }\n935:   return options;\n936: }\n937: \n938: // One mode per invocation. Asking for an argv and a run at once would hide which\n939: // one the operator meant, and a run with no log has nowhere to record its proof.\n940: function selectMode(options) {\n941:   // Only a backfill rewrites delivery, so the flag on any other invocation would\n942:   // parse and then quietly change nothing.\n943:   if (options.briefOnly && options.backfill === null) {\n944:     throw new UsageError('--brief-only needs --backfill');\n945:   }\n946:   if (options.printArgv !== null) return 'print-argv';\n947:   if (options.list !== null) return 'list';\n948:   if (options.backfill !== null) {\n949:     if (options.out === null) throw new UsageError('--out is required');\n950:     return 'backfill';\n951:   }\n952:   if (options.runtime === null) throw new UsageError('--runtime is required');\n953:   if (options.set === null && options.rowIds.length === 0) {\n954:     throw new UsageError('--set or --row-id is required');\n955:   }\n956:   if (options.out === null) throw new UsageError('--out is required');\n957:   return 'run';\n958: }\n959: \n960: function writeJson(value) {\n961:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n962: }\n963: \n964: function writeRowIds(rowIds) {\n965:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n966: }\n967: \n968: function writeArgv(runtimeName) {\n969:   const runtime = resolveRuntime(runtimeName);\n970:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n971:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n972:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n973:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n974:   }\n975:   writeJson(argv);\n976: }\n977: \n978: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n979: // fires, so a broken precondition never spends another model call.\n980: async function runTurn(job, options, exempt, isFirst) {\n981:   const before = { status: statusPaths(), ...gitSnapshot() };\n982:   if (isFirst) {\n983:     // A live turn can push, so it may only start where there is no remote to push\n984:     // to. A dry run spawns nothing and keeps running in this checkout.\n985:     if (!options.dryRun) {\n986:       const remotes = remoteNames();\n987:       if (remotes.length > 0) {\n988:         return {\n989:           status: EXIT_REFUSED,\n990:           refusal: { ok: false, code: 'remote_present', remotes },\n991:         };\n992:       }\n993:     }\n994:     const dirty = dirtyPaths(before.status, exempt);\n995:     if (dirty.length > 0) {\n996:       return {\n997:         status: EXIT_REFUSED,\n998:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n999:       };\n1000:     }\n1001:   }\n1002: \n1003:   const sessionId = randomUUID();\n1004:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1005:   // A runtime that names its session only in its own store is bracketed by a\n1006:   // listing, and the entry the turn added is the session it wrote. A dry run\n1007:   // starts no CLI, so it has nothing to list.\n1008:   const listed = !options.dryRun && listsStore(job.runtime);\n1009:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1010:   const turn = options.dryRun\n1011:     ? { exit: null, error: null, streamId: null }\n1012:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1013:   const reportedId = listed\n1014:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1015:     : turn.streamId;\n1016: \n1017:   const after = { status: statusPaths(), ...gitSnapshot() };\n1018:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1019:   const changed = changedPaths(before.status, after.status);\n1020:   // The locator is kept in hand because the brief reader opens the same session\n1021:   // the line records, and resolving it twice could name a different file.\n1022:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1023:   const line = {\n1024:     runtime: job.runtimeName,\n1025:     rowId: job.rowId,\n1026:     arm: options.arm,\n1027:     locator,\n1028:     exit: turn.exit,\n1029:     changedPaths: changed,\n1030:   };\n1031: \n1032:   if (headMoved) {\n1033:     // The worktree the restore was written for is gone. Restoring now could discard\n1034:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1035:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1036:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1037:   }\n1038: \n1039:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1040:   // honestly report as left as found.\n1041:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\n1042:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\n1043:   // The head the reader saw is the only place the offer was named, and not every\n1044:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1045:   // replays it, which lets an operator read the offer without paying for a model\n1046:   // call, while the brief stays `unknown` because no session exists to read.\n1047:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1048:   // Pi, Devin and DSH keep the brief in their session store rather than in the\n1049:   // turn records, so the delivery check needs the reader that opens that store.\n1050:   const delivered = options.dryRun\n1051:     ? 'unknown'\n1052:     : await briefDelivered({ runtime: job.runtimeName, locator, loadSession: loadSharedSession });\n1053:   appendRunLine(options.out, {\n1054:     ...line,\n1055:     offeredCommand: offer.offeredCommand,\n1056:     offeredPolicy: offer.offeredPolicy,\n1057:     briefDelivered: delivered,\n1058:     restored,\n1059:     ...(restore !== null && restore.leftoverPaths.length > 0\n1060:       ? { leftoverPaths: restore.leftoverPaths }\n1061:       : {}),\n1062:   });\n1063: \n1064:   if (turn.error !== null) {\n1065:     const detail = turn.error.message;\n1066:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1067:   }\n1068:   if (!restored) {\n1069:     return {\n1070:       status: 1,\n1071:       refusal: {\n1072:         ok: false,\n1073:         code: 'restore_failed',\n1074:         rowId: job.rowId,\n1075:         paths: changed,\n1076:         ...(restore === null ? {} : { leftoverPaths: restore.leftoverPaths }),\n1077:       },\n1078:     };\n1079:   }\n1080:   return { status: 0, refusal: null };\n1081: }\n1082: \n1083: async function runArm(options, rowIds) {\n1084:   const exempt = exemptPrefix(dirname(options.out));\n1085:   const runtime = resolveRuntime(options.runtime);\n1086:   const fixture = fixtureDir(options);\n1087:   // Created once before the first snapshot, so the folder a turn needs is never\n1088:   // read back as a path the turn itself changed.\n1089:   const ghConfig = ghConfigDir(options.out);\n1090:   mkdirSync(ghConfig, { recursive: true });\n1091:   for (let index = 0; index < rowIds.length; index += 1) {\n1092:     const rowId = rowIds[index];\n1093:     const prompt = promptFor(rowId, fixture);\n1094:     const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n1095:     const result = await runTurn(job, options, exempt, index === 0);\n1096:     if (result.refusal !== null) writeJson(result.refusal);\n1097:     if (result.status !== 0) return result.status;\n1098:   }\n1099:   return 0;\n1100: }\n1101: \n1102: // A finished log is rewritten from its recorded lines alone, and the fixture folder\n1103: // still sits beside the log the arm wrote. The corpus lookup runs before the first\n1104: // line is written, so a row the dataset guard refuses leaves no output file behind.\n1105: async function backfillLog(options) {\n1106:   const fixture = resolve(dirname(options.backfill), G2_FIXTURE_DIRNAME);\n1107:   const result = await backfillRunLog({\n1108:     inPath: options.backfill,\n1109:     outPath: options.out,\n1110:     promptFor: (rowId) => promptFor(rowId, fixture),\n1111:     briefOnly: options.briefOnly,\n1112:   });\n1113:   writeJson(result);\n1114:   return result.ok ? 0 : EXIT_REFUSED;\n1115: }\n1116: \n1117: async function main(argv) {\n1118:   try {\n1119:     const options = parseOptions(argv);\n1120:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1121:     // answered by that guard rather than by whichever usage check would run first.\n1122:     const rowIds = selectedRowIds(options);\n1123:     const mode = selectMode(options);\n1124:     options.arm = armFor(options);\n1125: \n1126:     if (mode === 'print-argv') {\n1127:       writeArgv(options.printArgv);\n1128:       return 0;\n1129:     }\n1130:     if (mode === 'list') {\n1131:       writeRowIds(rowIds);\n1132:       return 0;\n1133:     }\n1134:     if (mode === 'backfill') {\n1135:       return await backfillLog(options);\n1136:     }\n1137:     return await runArm(options, rowIds);\n1138:   } catch (error) {\n1139:     if (error instanceof UsageError) {\n1140:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1141:       return EXIT_REFUSED;\n1142:     }\n1143:     if (error instanceof Refusal) {\n1144:       writeJson({ ok: false, code: error.code, detail: error.message });\n1145:       return EXIT_REFUSED;\n1146:     }\n1147:     throw error;\n1148:   }\n1149: }\n1150: \n1151: try {\n1152:   process.exitCode = await main(process.argv.slice(2));\n1153: } catch (error) {\n1154:   if (error instanceof UsageError) {\n1155:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1156:     process.exitCode = EXIT_REFUSED;\n1157:   } else {\n1158:     throw error;\n1159:   }\n1160: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794547503182,"end":1794547503679}}}}
