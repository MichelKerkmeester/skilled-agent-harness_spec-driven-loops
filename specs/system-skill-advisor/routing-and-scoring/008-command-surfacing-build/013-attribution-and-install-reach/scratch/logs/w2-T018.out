{"type":"step_start","timestamp":1794546201405,"sessionID":"ses_e2cb7c199ffeiTQQulRLptPwQW","part":{"id":"prt_1d349f33d001H6XBMsT2GZ0ceB","sessionID":"ses_e2cb7c199ffeiTQQulRLptPwQW","messageID":"msg_1d349e94c001DSLjPC21B53FlU","type":"step-start","snapshot":"d4ff5b320f82e2badb5392b2b0fef10ff251863b"}}
{"type":"tool_use","timestamp":1794546209422,"sessionID":"ses_e2cb7c199ffeiTQQulRLptPwQW","part":{"partID":"prt_1d34a1159001S7XtBqDKgZiUJg","sessionID":"ses_e2cb7c199ffeiTQQulRLptPwQW","messageID":"msg_1d349e94c001DSLjPC21B53FlU","type":"tool","id":"call_e12e5813592448e0a70dcb76","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-agents-md-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-agents-md-contract.test.cjs, lines 1-823\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Agents-MD Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Holds /doctor:agents-md together: the three routes in the manifest, the router,\n8: // the presentation contract, the three workflows and the command contract must\n9: // agree on the targets, the mutation classes, the asset paths, the engines they\n10: // name and the order a write happens in.\n11: //\n12: // The route validator checks structure and the engines' own suites check the bytes\n13: // they produce. What nothing else can see is the promise between the two: that the\n14: // writing workflow is shaped as plan, digest, yes and only then a write, that a no\n15: // leaves the tree exactly as it was, that the workflow's allowlist is the engine's\n16: // own list rather than a second one that drifts from it, and that the router stays\n17: // a router. This suite asserts those promises by reading the files.\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 1. IMPORTS AND FIXTURES\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: const assert = require('node:assert/strict');\n24: const { spawnSync } = require('node:child_process');\n25: const fs = require('node:fs');\n26: const os = require('node:os');\n27: const path = require('node:path');\n28: const test = require('node:test');\n29: const { parse: parseYaml } = require('yaml');\n30: \n31: const { composeFixture } = require('./fixtures/agents-md/compose-fixture.cjs');\n32: \n33: const DOCTOR = path.resolve(__dirname, '..', '..');\n34: const ASSETS = path.join(DOCTOR, 'assets');\n35: const SCRIPTS = path.join(DOCTOR, 'scripts');\n36: const COMMANDS = path.resolve(DOCTOR, '..');\n37: const SKILL_DOC_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n38: \n39: const read = (file) => fs.readFileSync(file, 'utf8');\n40: \n41: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n42: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:agents-md');\n43: const routeFor = (target) => ROUTES.find((route) => route.target === target);\n44: \n45: const ROUTER = read(path.join(DOCTOR, 'agents-md.md'));\n46: const PRESENTATION = read(path.join(ASSETS, 'doctor-agents-md-presentation.txt'));\n47: const CHECK_YAML = read(path.join(ASSETS, 'doctor-agents-md-check.yaml'));\n48: const EMBED_YAML = read(path.join(ASSETS, 'doctor-agents-md-embed.yaml'));\n49: const RESTORE_YAML = read(path.join(ASSETS, 'doctor-agents-md-restore.yaml'));\n50: const SETUP_PRESENTATION = read(path.join(ASSETS, 'doctor-setup-presentation.txt'));\n51: const UPDATE_PRESENTATION = read(path.join(ASSETS, 'doctor-update-presentation.txt'));\n52: const CATALOG = read(path.join(COMMANDS, 'README.txt'));\n53: \n54: const CONTRACT = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.json')));\n55: const SCHEMA = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.schema.json')));\n56: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n57: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n58: \n59: const CHECK_ENGINE = '.skilled/commands/doctor/scripts/agents-md-check.cjs';\n60: const EMBED_ENGINE = '.skilled/commands/doctor/scripts/agents-md-embed.cjs';\n61: const HELPER = path.join(SCRIPTS, 'doctor-helper-match.cjs');\n62: const EMBED_SCRIPT = path.join(SCRIPTS, 'agents-md-embed.cjs');\n63: \n64: // The engine's own write boundary, read from the engine. A second copy in the\n65: // workflow is the drift this suite exists to catch, so the allowlist cases compare\n66: // against this list rather than against a literal here.\n67: const { ALLOWLIST } = require(path.join(SCRIPTS, 'agents-md-embed.cjs'));\n68: \n69: const engineOf = (entry) => entry.match(/\\.skilled\\/\\S+\\.cjs/)[0];\n70: \n71: const CHECK_WORKFLOW = parseYaml(CHECK_YAML);\n72: const EMBED_WORKFLOW = parseYaml(EMBED_YAML);\n73: const RESTORE_WORKFLOW = parseYaml(RESTORE_YAML);\n74: const EMBED_PHASES = Object.keys(EMBED_WORKFLOW.workflow);\n75: const RESTORE_PHASES = Object.keys(RESTORE_WORKFLOW.workflow);\n76: \n77: const yamlStrings = (node, out = []) => {\n78:   if (Array.isArray(node)) {\n79:     for (const value of node) yamlStrings(value, out);\n80:   } else if (node && typeof node === 'object') {\n81:     for (const [key, value] of Object.entries(node)) {\n82:       out.push(key);\n83:       yamlStrings(value, out);\n84:     }\n85:   } else if (typeof node === 'string') {\n86:     out.push(node);\n87:   }\n88:   return out;\n89: };\n90: \n91: const phaseText = (workflow, phase) => yamlStrings(workflow.workflow[phase]).join('\\n');\n92: \n93: // ─────────────────────────────────────────────────────────────────────────────\n94: // 2. THE ROUTES\n95: // ─────────────────────────────────────────────────────────────────────────────\n96: \n97: test('the manifest holds a check, an embed and a restore route, and only check answers the bare command', () => {\n98:   assert.deepEqual(ROUTES.map((route) => route.target), ['check', 'embed', 'restore']);\n99:   // Three targets make the command multi-target, so the read-only one has to claim\n100:   // the bare invocation: without the flag a typed /doctor:agents-md would reach no\n101:   // bridge at all, and a bare invocation must never reach a route that writes.\n102:   assert.equal(routeFor('check').default_target, true);\n103:   assert.equal(routeFor('embed').default_target, undefined);\n104:   assert.equal(routeFor('restore').default_target, undefined);\n105:   assert.equal(routeFor('check').mutating, 'read-only');\n106:   assert.match(routeFor('check').gate3_location, /^n\\/a/);\n107:   assert.equal(routeFor('embed').mutating, 'mutates');\n108:   assert.equal(routeFor('restore').mutating, 'mutates');\n109:   for (const route of ROUTES) {\n110:     assert.equal(route.yaml, `doctor-agents-md-${route.target}.yaml`);\n111:     assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n112:     assert.deepEqual(route.mcp_tools, []);\n113:   }\n114:   assert.deepEqual(routeFor('check').allowed_flags, ['--json', '--root <dir>']);\n115:   assert.deepEqual([...routeFor('embed').allowed_flags].sort(), [\n116:     '--create-router',\n117:     '--dry-run',\n118:     '--keep-claude-md',\n119:     '--plan-digest <digest>',\n120:     '--remove-claude-md',\n121:     '--root <dir>',\n122:   ].sort());\n123:   assert.deepEqual([...routeFor('restore').allowed_flags].sort(), ['--dry-run', '--run <dir>', '--yes'].sort());\n124: });\n125: \n126: // The header is the file's own table of contents, and a reader who trusts it misses every\n127: // router it omits. The count is the folder's, so a new router file fails here until the\n128: // header names it.\n129: test('the route manifest header lists every router file in the folder', () => {\n130:   const header = read(path.join(DOCTOR, '_routes.yaml')).split(/^schema_version:/m)[0];\n131:   const listed = [...header.matchAll(/^#   \\/doctor:(\\S+)\\s+\\S+\\.md$/gm)].map((match) => match[1]).sort();\n132:   const routers = fs.readdirSync(DOCTOR)\n133:     .filter((file) => file.endsWith('.md') && !file.startsWith('local-'))\n134:     .map((file) => file.replace(/\\.md$/, ''))\n135:     .sort();\n136:   assert.deepEqual(listed, routers, 'the header names every router or the count in it is wrong');\n137: });\n138: \n139: test('the writing routes name every place the engines write and nothing else', () => {\n140:   const embed = routeFor('embed').gate3_location;\n141:   // Exactly the six allowlisted paths, the backup that makes the write reversible and\n142:   // the digest that decides whether the approved bytes are the bytes on disk.\n143:   for (const expected of [\n144:     /AGENTS\\.md/,\n145:     /CLAUDE\\.md/,\n146:     /\\.codex\\/AGENTS\\.md/,\n147:     /\\.cursor\\/rules\\/repo-local\\.md/,\n148:     /\\.cursor\\/rules\\/skill-routing\\.md/,\n149:     /REPO RULES\\.md/,\n150:     /backup/i,\n151:     /plan digest/i,\n152:   ]) {\n153:     assert.match(embed, expected);\n154:   }\n155:   // A release unit belongs to /doctor:update, and no embed run stages a commit.\n156:   assert.doesNotMatch(embed, /\\.skilled\\/skills|the git index|commit/i);\n157: \n158:   const restore = routeFor('restore').gate3_location;\n159:   assert.match(restore, /manifest\\.json/);\n160:   assert.match(restore, /allowlist/);\n161:   assert.match(restore, /recorded/);\n162: });\n163: \n164: test('every route names the engine calls its workflow runs and every trigger phrase carries three or more words', () => {\n165:   for (const route of ROUTES) {\n166:     for (const phrase of route.trigger_phrases) {\n167:       assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n168:     }\n169:   }\n170:   // The check route reads, and only reads.\n171:   assert.deepEqual(routeFor('check').script_invocations.map(engineOf), [CHECK_ENGINE]);\n172: \n173:   // The plan writes nothing, the apply carries the digest the plan printed, and the\n174:   // re-read proves what landed. A plan call that already carried the digest would\n175:   // make the approval a formality, so it never does.\n176:   const embedCalls = routeFor('embed').script_invocations;\n177:   assert.deepEqual(embedCalls.map(engineOf), [EMBED_ENGINE, EMBED_ENGINE, CHECK_ENGINE]);\n178:   assert.match(embedCalls[0], /agents-md-embed\\.cjs plan/);\n179:   assert.doesNotMatch(embedCalls[0], /--plan-digest/);\n180:   assert.match(embedCalls[1], /agents-md-embed\\.cjs apply/);\n181:   assert.match(embedCalls[1], /--plan-digest <digest>/);\n182: \n183:   // The restore plan is the engine's own dry run, and the write repeats the record\n184:   // path the operator was shown.\n185:   const restoreCalls = routeFor('restore').script_invocations;\n186:   assert.deepEqual(restoreCalls.map(engineOf), [EMBED_ENGINE, EMBED_ENGINE, CHECK_ENGINE]);\n187:   assert.match(restoreCalls[0], /agents-md-embed\\.cjs restore --run=<dir> --dry-run/);\n188:   assert.match(restoreCalls[1], /agents-md-embed\\.cjs restore --run=<dir> --yes/);\n189:   assert.doesNotMatch(restoreCalls[0], /--yes/);\n190: });\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 3. ROUTER AND PRESENTATION\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n197:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n198:   assert.deepEqual(headings, [\n199:     'ROUTER CONTRACT',\n200:     'OWNED ASSETS',\n201:     'MODE ROUTING',\n202:     'EXECUTION TARGETS',\n203:     'PRESENTATION BOUNDARY',\n204:     'WORKFLOW SUMMARY',\n205:   ]);\n206:   // A fenced block or a status line in the router would put a dashboard or a result\n207:   // template inline, where the presentation contract is the only place they belong.\n208:   assert.doesNotMatch(ROUTER, /```/);\n209:   assert.doesNotMatch(ROUTER, /STATUS=/);\n210: });\n211: \n212: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n213:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n214:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n215:   assert.doesNotMatch(description, /[<>]/);\n216:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n217:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n218:   for (const token of ['[check|embed|restore]', '[--json]', '[--root <dir>]', '[--dry-run]', '[--plan-digest <digest>]', '[--run <dir>]', '[--yes]']) {\n219:     assert.ok(hint.includes(token), token);\n220:   }\n221:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n222:   assert.deepEqual(tools, ['Read', 'Bash']);\n223:   // Instruction-document authoring is sk-doc's, so that is the one skill tag here.\n224:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n225: });\n226: \n227: test('the router binds each target to the workflow asset its route names', () => {\n228:   for (const route of ROUTES) {\n229:     assert.match(\n230:       ROUTER,\n231:       new RegExp(`^\\\\| \\`${route.target}\\` \\\\| \\`\\\\.skilled/commands/doctor/assets/${route.yaml}\\` \\\\|$`, 'm'),\n232:       route.target,\n233:     );\n234:   }\n235: });\n236: \n237: test('the router names both engines as owned assets and composes nothing itself', () => {\n238:   const owned = ROUTER.split('## 2. OWNED ASSETS')[1].split('## 3.')[0];\n239:   assert.ok(owned.includes(CHECK_ENGINE), CHECK_ENGINE);\n240:   assert.ok(owned.includes(EMBED_ENGINE), EMBED_ENGINE);\n241:   assert.match(ROUTER, /Do not compose an `AGENTS\\.md` byte/);\n242: });\n243: \n244: test('the router resolves the bare command to check and keeps every write behind the digest and a yes', () => {\n245:   assert.match(ROUTER, /`default_target`/);\n246:   assert.match(ROUTER, /A bare `\\/doctor:agents-md` never reaches `embed` or `restore`, which write/);\n247:   assert.match(ROUTER, /never runs `apply` without the digest its own plan printed/);\n248:   assert.match(ROUTER, /never runs a writing target without its yes/);\n249: });\n250: \n251: test('the router step list runs the real order: plan, digest, yes, apply, re-read', () => {\n252:   const summary = ROUTER.split('## 6. WORKFLOW SUMMARY')[1];\n253:   const steps = summary.split('\\n').map((line) => line.trim()).filter((line) => /^\\d+\\. /.test(line));\n254:   const at = (pattern) => {\n255:     const index = steps.findIndex((step) => pattern.test(step));\n256:     assert.ok(index >= 0, `no step names ${pattern}`);\n257:     return index;\n258:   };\n259:   const plan = at(/agents-md-embed\\.cjs plan/);\n260:   const digest = at(/the plan digest/);\n261:   const question = at(/asks the embed question/);\n262:   const apply = at(/agents-md-embed\\.cjs apply --plan-digest/);\n263:   const reread = at(/re-reads the written repository/);\n264:   assert.ok(plan < digest, 'the plan is printed before its digest is offered');\n265:   assert.ok(digest < question, 'the digest is named before the question');\n266:   assert.ok(question < apply, 'the apply runs only after the question');\n267:   assert.ok(apply < reread, 'the re-read follows the write');\n268:   const stepText = steps.join('\\n');\n269:   assert.match(stepText, /ends the run as cancelled/);\n270:   assert.match(stepText, /nothing is written/);\n271:   assert.match(stepText, /restore/);\n272: });\n273: \n274: test('the presentation carries the menu, the accepted answers, the manifest rows and the valid targets line', () => {\n275:   assert.match(PRESENTATION, /^## 1\\. Argument Failure$/m);\n276:   assert.match(PRESENTATION, /^1\\) check$/m);\n277:   assert.match(PRESENTATION, /^2\\) embed$/m);\n278:   assert.match(PRESENTATION, /^3\\) restore$/m);\n279:   assert.match(PRESENTATION, /^\\| `1` \\| target = `check` \\|/m);\n280:   assert.match(PRESENTATION, /^\\| `2` \\| target = `embed` \\|/m);\n281:   assert.match(PRESENTATION, /^\\| `3` \\| target = `restore` \\|/m);\n282:   assert.match(PRESENTATION, /^Valid targets: check, embed, restore$/m);\n283:   assert.match(PRESENTATION, /^\\| `check` \\| `doctor-agents-md-check\\.yaml` \\| read-only \\|/m);\n284:   assert.match(PRESENTATION, /^\\| `embed` \\| `doctor-agents-md-embed\\.yaml` \\| mutates \\|/m);\n285:   assert.match(PRESENTATION, /^\\| `restore` \\| `doctor-agents-md-restore\\.yaml` \\| mutates \\|/m);\n286: });\n287: \n288: // A failure the router promises to catch has to have wording, or the agent invents one and\n289: // the operand hears a sentence the contract never approved. A value flag at the end of the\n290: // line and a second positional are the two an operator reaches by hand.\n291: test('the argument table defines a missing value and a second positional for every target', () => {\n292:   const table = PRESENTATION.split('## 1. Argument Failure')[1].split(/\\n## 2\\./u)[0];\n293:   const rows = table.split('\\n').filter((line) => line.startsWith('| '));\n294: \n295:   const missing = rows.find((line) => /value flag/u.test(line));\n296:   assert.ok(missing, 'no row for a value flag given without its value');\n297:   for (const flag of ['--plan-digest', '--root']) assert.ok(missing.includes(flag), `${flag} is not named`);\n298:   assert.match(missing, /STATUS=FAIL ERROR=\"missing_argument\"/u);\n299:   assert.match(missing, /Try: /u);\n300: \n301:   const second = rows.find((line) => /second positional/u.test(line));\n302:   assert.ok(second, 'no row for a second positional');\n303:   // One suggestion per target, because the right next command differs by target.\n304:   assert.match(second, /\\/doctor:agents-md check \\[--json\\] \\[--root <dir>\\]/u);\n305:   assert.match(second, /\\/doctor:agents-md embed \\[--dry-run\\]/u);\n306:   assert.match(second, /\\/doctor:agents-md restore --run=<dir>/u);\n307:   assert.match(second, /STATUS=FAIL ERROR=\"too_many_arguments\"/u);\n308: \n309:   // The router promises this table covers both cases, so it has to name them.\n310:   assert.match(ROUTER, /a value flag without its value/u);\n311:   assert.match(ROUTER, /a second positional/u);\n312: });\n313: \n314: // The engine has three outcomes for an exit 1 and the route has to mirror all three: a row\n315: // that could not be answered is not a finding, and reporting it as one sends the operator\n316: // looking for a fault that was never found.\n317: test('an unproven row ends the check as UNKNOWN, never as a finding', () => {\n318:   assert.match(PRESENTATION, /^Status: \\[OK\\|FINDINGS\\|UNKNOWN\\|ERROR\\]$/mu);\n319:   assert.match(PRESENTATION, /^STATUS=\\[OK\\|FINDINGS\\|UNKNOWN\\]$/mu);\n320:   assert.match(PRESENTATION, /exit 1 with `findings=0` ends `STATUS=UNKNOWN`/u);\n321:   assert.match(PRESENTATION, /never `STATUS=FINDINGS`/u);\n322:   const { output } = CHECK_WORKFLOW;\n323:   assert.match(output, /STATUS=UNKNOWN/u);\n324:   assert.match(output, /findings=0/u);\n325: });\n326: \n327: test('the presentation keeps the check table, the JSON passthrough and the digest it makes the operator approve', () => {\n328:   assert.match(PRESENTATION, /^Agents instruction check: \\[the root the engine read\\]$/m);\n329:   assert.match(PRESENTATION, /^DOCTOR TARGET UNCHANGED$/m);\n330:   assert.ok(PRESENTATION.includes(\"With `--json` print the engine's JSON and nothing else\"));\n331:   assert.match(PRESENTATION, /^Plan digest: \\[the engine's plan-digest line\\]$/m);\n332:   assert.match(PRESENTATION, /Embed these files now\\? \\[yes\\/no\\]$/m);\n333:   assert.match(PRESENTATION, /Restore these paths from that backup now\\? \\[yes\\/no\\]$/m);\n334:   // The digest is what the operator approves, so the wording has to say so.\n335:   assert.match(PRESENTATION, /the digest on screen is the digest the apply repeats/);\n336:   assert.match(PRESENTATION, /never compose a plan digest/);\n337: });\n338: \n339: test('the presentation closes on the unchanged, cancelled, dry-run, restored and failed templates', () => {\n340:   // Every status a route can print appears as its own line, because a workflow that\n341:   // ends on one of them must have been told the exact string.\n342:   for (const status of ['STATUS=OK', 'STATUS=FINDINGS', 'STATUS=UNKNOWN', 'STATUS=CANCELLED ACTION=cancelled', 'STATUS=FAIL ERROR=\"[code]\"', 'STATUS=ERROR ERROR=\"[message]\"']) {\n343:     assert.match(PRESENTATION, new RegExp(`^${status.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}$`, 'm'), status);\n344:   }\n345:   assert.match(PRESENTATION, /^STATUS=CANCELLED ACTION=cancelled$/m);\n346:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[code\\]\"$/m);\n347:   assert.match(PRESENTATION, /^STATUS=ERROR ERROR=\"\\[message\\]\"$/m);\n348:   assert.match(PRESENTATION, /Declined: \\[the embed \\| the restore\\]/);\n349:   assert.match(PRESENTATION, /^End interactive presentations with: `What would you like to do next\\?`$/m);\n350: });\n351: \n352: // ─────────────────────────────────────────────────────────────────────────────\n353: // 4. THE CHECK WORKFLOW\n354: // ─────────────────────────────────────────────────────────────────────────────\n355: \n356: test('the check workflow is read-only and runs the check engine the route declares', () => {\n357:   assert.equal(CHECK_WORKFLOW.operating_mode.execution, 'read_only');\n358:   assert.equal(CHECK_WORKFLOW.mutation_boundaries.read_only, true);\n359:   assert.deepEqual(CHECK_WORKFLOW.mutation_boundaries.allowed_targets, []);\n360:   assert.ok(CHECK_YAML.includes(CHECK_ENGINE), CHECK_ENGINE);\n361: });\n362: \n363: test('the check workflow declares every variable its route resolves', () => {\n364:   for (const key of routeFor('check').setup_vars) {\n365:     assert.ok(key in CHECK_WORKFLOW.inputs, `inputs.${key} is missing`);\n366:   }\n367: });\n368: \n369: test('the check workflow passes --json and --root only when the operator asked', () => {\n370:   assert.match(CHECK_WORKFLOW.inputs.json_output, /true when --json is passed/);\n371:   assert.match(CHECK_YAML, /--json when the operator/);\n372:   assert.doesNotMatch(CHECK_YAML, /agents-md-check\\.cjs --json/);\n373:   assert.match(CHECK_WORKFLOW.inputs.root, /--root <dir>/);\n374:   // The default root is the repository the operator is in, so an unconditional\n375:   // --root would classify somebody else's tree.\n376:   assert.doesNotMatch(CHECK_YAML, /agents-md-check\\.cjs --root/);\n377: });\n378: \n379: test('the check workflow maps the engine exit classes to a route status', () => {\n380:   const { output } = CHECK_WORKFLOW;\n381:   assert.match(output, /STATUS=OK/);\n382:   assert.match(output, /STATUS=FINDINGS/);\n383:   // Exit 1 covers two outcomes, and the route has to keep them apart: a row nobody could\n384:   // answer is not a finding, and calling it one sends the operator after a fault that was\n385:   // never found.\n386:   assert.match(output, /STATUS=UNKNOWN/);\n387:   assert.match(output, /findings=0/);\n388:   assert.match(output, /STATUS=ERROR/);\n389: });\n390: \n391: // ─────────────────────────────────────────────────────────────────────────────\n392: // 5. THE EMBED AND RESTORE WORKFLOWS\n393: // ─────────────────────────────────────────────────────────────────────────────\n394: \n395: test('the embed workflow is interactive, writes only on a yes and never commits', () => {\n396:   assert.equal(EMBED_WORKFLOW.operating_mode.execution, 'interactive');\n397:   assert.equal(EMBED_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n398:   assert.equal(EMBED_WORKFLOW.operating_mode.dry_run, 'print_the_plan_then_status_ok_without_asking');\n399:   assert.equal(EMBED_WORKFLOW.operating_mode.never_commit, true);\n400:   assert.deepEqual(EMBED_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n401:   assert.equal(EMBED_WORKFLOW.output.presentation, '.skilled/commands/doctor/assets/doctor-agents-md-presentation.txt');\n402: });\n403: \n404: test('the embed workflow runs its phases in the read, plan, approval, write, re-read, report order', () => {\n405:   assert.deepEqual(EMBED_PHASES, [\n406:     'phase_1_read',\n407:     'phase_2_plan',\n408:     'phase_3_approval',\n409:     'phase_4_write',\n410:     'phase_5_reread',\n411:     'phase_6_report',\n412:   ]);\n413:   assert.equal(EMBED_WORKFLOW.mutation_boundaries.read_only, false);\n414: });\n415: \n416: test('the embed allowlist is the engine own list and nothing beside it', () => {\n417:   const boundaries = EMBED_WORKFLOW.mutation_boundaries;\n418:   const allowed = boundaries.allowed_targets.join('\\n');\n419:   for (const file of ALLOWLIST) {\n420:     assert.ok(allowed.includes(file), `${file} is missing from the workflow allowlist`);\n421:   }\n422:   const namedPaths = boundaries.allowed_targets\n423:     .map((entry) => entry.split(/[,:]/)[0].trim())\n424:     .filter((first) => first.endsWith('.md'));\n425:   assert.deepEqual([...namedPaths].sort(), [...ALLOWLIST].sort());\n426:   const forbidden = boundaries.forbidden_targets.join('\\n');\n427:   assert.match(forbidden, /agents-md-embed\\.cjs/);\n428:   assert.match(forbidden, /the git index/);\n429:   assert.match(forbidden, /\\.skilled\\/\\*\\*, which \\/doctor:update owns/);\n430: });\n431: \n432: test('the embed workflow writes only after the printed plan, its digest and the yes', () => {\n433:   const plan = phaseText(EMBED_WORKFLOW, 'phase_2_plan');\n434:   assert.match(plan, new RegExp(`${EMBED_ENGINE} plan`));\n435:   assert.doesNotMatch(plan, /--plan-digest/);\n436:   assert.match(plan, /plan-digest/);\n437: \n438:   const approval = phaseText(EMBED_WORKFLOW, 'phase_3_approval');\n439:   assert.match(approval, /Ask the embed question once/);\n440:   assert.match(approval, /the plan the operator has just read/);\n441:   assert.match(approval, /STATUS=CANCELLED ACTION=cancelled/);\n442:   assert.match(approval, /naming the declined embed/);\n443:   assert.match(approval, /Nothing is written/);\n444: \n445:   const write = phaseText(EMBED_WORKFLOW, 'phase_4_write');\n446:   assert.match(write, /only after the embed yes/);\n447:   assert.match(write, /--plan-digest/);\n448:   assert.match(write, /does not match/);\n449:   assert.ok(EMBED_PHASES.indexOf('phase_3_approval') < EMBED_PHASES.indexOf('phase_4_write'));\n450:   // The write switch is the engine's own apply subcommand, and the digest is the\n451:   // plan's, so a plan approved at one tree cannot be applied at another.\n452:   assert.doesNotMatch(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /apply --plan-digest/);\n453: });\n454: \n455: test('a no at the embed question ends the run with nothing written, and a dry run ends at OK', () => {\n456:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_3_approval'), /Any answer other than yes is a no/);\n457:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /If dry_run is true/);\n458:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /STATUS=OK/);\n459:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /asks nothing and writes nothing/);\n460:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /NOTHING TO DO/);\n461: });\n462: \n463: test('the embed workflow hands the undo block back instead of composing one', () => {\n464:   const report = phaseText(EMBED_WORKFLOW, 'phase_6_report');\n465:   assert.match(report, /undo block the engine printed/);\n466:   assert.match(report, /Undo:/);\n467:   assert.match(report, /Never run the undo inside this route/);\n468:   assert.match(report, /the operator commits/i);\n469: });\n470: \n471: test('the restore workflow asks once, plans from the engine, and writes only after that yes', () => {\n472:   assert.equal(RESTORE_WORKFLOW.operating_mode.execution, 'interactive');\n473:   assert.equal(RESTORE_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n474:   assert.equal(RESTORE_WORKFLOW.operating_mode.never_commit, true);\n475:   assert.deepEqual(RESTORE_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n476:   assert.deepEqual(RESTORE_PHASES, [\n477:     'phase_1_read',\n478:     'phase_2_plan',\n479:     'phase_3_approval',\n480:     'phase_4_write',\n481:     'phase_5_reread',\n482:     'phase_6_report',\n483:   ]);\n484:   for (const key of routeFor('restore').setup_vars) {\n485:     assert.ok(key in RESTORE_WORKFLOW.inputs, `inputs.${key} is missing`);\n486:   }\n487:   const plan = phaseText(RESTORE_WORKFLOW, 'phase_2_plan');\n488:   assert.match(plan, /restore --run=\\{run_dir\\} --dry-run/);\n489:   assert.doesNotMatch(plan, /--yes/);\n490:   const write = phaseText(RESTORE_WORKFLOW, 'phase_4_write');\n491:   assert.match(write, /restore --run=\\{run_dir\\} --yes/);\n492:   assert.match(write, /only after the restore yes/);\n493:   const approval = phaseText(RESTORE_WORKFLOW, 'phase_3_approval');\n494:   assert.match(approval, /STATUS=CANCELLED ACTION=cancelled/);\n495:   assert.match(approval, /naming the declined restore/);\n496:   assert.match(approval, /Nothing is written/);\n497: });\n498: \n499: test('the restore workflow restores only what one run recorded, and reads the hash first', () => {\n500:   const boundaries = RESTORE_WORKFLOW.mutation_boundaries;\n501:   const allowed = boundaries.allowed_targets.join('\\n');\n502:   assert.match(allowed, /manifest\\.json/);\n503:   assert.match(allowed, /allowlist/);\n504:   const forbidden = boundaries.forbidden_targets.join('\\n');\n505:   assert.match(forbidden, /agents-md-embed\\.cjs/);\n506:   assert.match(forbidden, /the git index/);\n507:   assert.match(boundaries.invariant, /recorded hash/);\n508:   assert.match(boundaries.invariant, /STATUS=CANCELLED/);\n509:   // A restore never reads a backup directory the operator was not shown.\n510:   assert.match(phaseText(RESTORE_WORKFLOW, 'phase_1_read'), /manifest\\.json/);\n511: });\n512: \n513: // ─────────────────────────────────────────────────────────────────────────────\n514: // 6. THE COMMAND CONTRACT, THE SETUP LIST AND THE CATALOG\n515: // ─────────────────────────────────────────────────────────────────────────────\n516: \n517: test('the doctor contract entry carries every field its schema requires and nothing it forbids', () => {\n518:   for (const key of FAMILY_SCHEMA.required) {\n519:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n520:   }\n521:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n522:   assert.deepEqual(\n523:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n524:     [],\n525:     'the schema forbids an additional property',\n526:   );\n527:   assert.ok(FAMILY_SCHEMA.properties.topology.enum.includes(DOCTOR_CONTRACT.topology));\n528: });\n529: \n530: test('the contract names the router, the three workflows, the presentation, the hint and the alias', () => {\n531:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/agents-md.md'));\n532:   for (const asset of ['doctor-agents-md-check.yaml', 'doctor-agents-md-embed.yaml', 'doctor-agents-md-restore.yaml']) {\n533:     assert.ok(DOCTOR_CONTRACT.execution_targets.some((entry) => entry.target.endsWith(asset)), asset);\n534:     assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.endsWith(asset)), asset);\n535:   }\n536:   assert.ok(DOCTOR_CONTRACT.owned_assets\n537:     .some((entry) => entry.purpose === 'presentation' && entry.path.endsWith('doctor-agents-md-presentation.txt')));\n538:   // A script asset carries its one-line purpose beside the path, the way the helper's\n539:   // does, so the path is matched inside the cell rather than at its end.\n540:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes('agents-md-check.cjs')));\n541:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes('agents-md-embed.cjs')));\n542:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n543:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (agents-md)`));\n544:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(`/doctor:agents-md ${hint}`));\n545:   const lines = DOCTOR_CONTRACT.loader_requirements.filter((line) => line.includes('/doctor:agents-md'));\n546:   const text = lines.join('\\n');\n547:   assert.match(text, /check is the read-only default target/);\n548:   assert.match(text, /plan digest/i);\n549:   assert.match(text, /restore/);\n550:   assert.match(text, /STATUS=CANCELLED/);\n551:   assert.ok(DOCTOR_CONTRACT.destructive_policy.operations.some((line) => line.includes('agents-md embed')));\n552:   assert.ok(DOCTOR_CONTRACT.destructive_policy.operations.some((line) => line.includes('agents-md restore')));\n553: });\n554: \n555: test('the setup target list carries one agents-md row and keeps the rest of the family', () => {\n556:   const rows = SETUP_PRESENTATION.split('\\n').filter((line) => line.includes('/doctor:agents-md'));\n557:   assert.equal(rows.length, 1);\n558:   assert.match(rows[0], /^\\| `\\/doctor:agents-md \\[check\\|embed\\|restore\\]/);\n559:   // The family's own reach check requires one row per doctor router, so a row here\n560:   // and a router file there are the same decision.\n561:   const routers = fs.readdirSync(DOCTOR)\n562:     .filter((file) => file.endsWith('.md'))\n563:     .map((file) => file.replace(/\\.md$/, ''))\n564:     .filter((name) => name !== 'helper' && !name.startsWith('local-'));\n565:   const missing = routers.filter((name) => !SETUP_PRESENTATION.includes(`/doctor:${name}`));\n566:   assert.deepEqual(missing, []);\n567: });\n568: \n569: test('the update presentation gains one line naming the check target', () => {\n570:   const lines = UPDATE_PRESENTATION.split('\\n').filter((line) => line.includes('/doctor:agents-md'));\n571:   assert.equal(lines.length, 1);\n572:   assert.match(lines[0], /\\/doctor:agents-md check$/);\n573: });\n574: \n575: test('the commands catalog lists the router and counts the folder it lives in', () => {\n576:   const rows = CATALOG.split('\\n').filter((line) => line.includes('/doctor:agents-md'));\n577:   assert.equal(rows.length, 1);\n578:   const routers = fs.readdirSync(DOCTOR).filter((file) => file.endsWith('.md') && !file.startsWith('local-'));\n579:   const groupRow = CATALOG.split('\\n').find((line) => /^\\| \\*\\*doctor\\*\\* \\|/.test(line));\n580:   assert.ok(groupRow, 'the doctor group row is missing from the catalog');\n581:   assert.equal(Number(groupRow.split('|')[3].trim()), routers.length);\n582: });\n583: \n584: // ─────────────────────────────────────────────────────────────────────────────\n585: // 7. REACH: THE PROBLEMS AN OPERATOR ACTUALLY WRITES\n586: // ─────────────────────────────────────────────────────────────────────────────\n587: \n588: const rank = (problem) => {\n589:   const result = spawnSync(process.execPath, [HELPER, '--json', '--', problem], { encoding: 'utf8' });\n590:   return { status: result.status, report: JSON.parse(result.stdout) };\n591: };\n592: \n593: test('three plain-language AGENTS.md problems reach the three new routes', () => {\n594:   const cases = [\n595:     ['my agents md still has the old shipped sections and I want to know which ones are stale', '/doctor:agents-md check'],\n596:     ['embed the new shipped instructions into my agents md', '/doctor:agents-md embed'],\n597:     ['undo the agents md embed and bring back the file I had before', '/doctor:agents-md restore'],\n598:   ];\n599:   for (const [problem, runnable] of cases) {\n600:     const { status, report } = rank(problem);\n601:     assert.equal(status, 0, `${problem}: exit ${status}`);\n602:     assert.equal(report.status, 'match', problem);\n603:     assert.equal(report.candidates[0].runnable, runnable, `${problem} -> ${report.candidates[0].runnable}`);\n604:   }\n605: });\n606: \n607: test('every phrase on the three routes ranks its own route first', () => {\n608:   const { loadEntries, rankProblem } = require(HELPER);\n609:   const { entries } = loadEntries(path.resolve(DOCTOR, '..', '..', '..'));\n610:   const routable = entries.filter((entry) => entry.command !== '/doctor:helper');\n611:   const misses = [];\n612:   for (const route of ROUTES) {\n613:     const runnable = `/doctor:agents-md ${route.target}`;\n614:     assert.ok(routable.some((entry) => entry.runnable === runnable), `${runnable} has no helper entry`);\n615:     for (const phrase of route.trigger_phrases) {\n616:       const top = rankProblem(routable, phrase, {}).candidates[0];\n617:       if (!top || top.runnable !== runnable) misses.push(`\"${phrase}\" -> ${top ? top.runnable : 'no match'}`);\n618:     }\n619:   }\n620:   assert.deepEqual(misses, []);\n621: });\n622: \n623: // ─────────────────────────────────────────────────────────────────────────────\n624: // 8. THE LINES THE ENGINES PRINT AND THE FIELDS THAT CARRY THEM\n625: // ─────────────────────────────────────────────────────────────────────────────\n626: \n627: // A line an engine prints and neither the workflow keep-list nor the presentation names is\n628: // a line an agent can only drop, and a dropped pointer-sync line is a mirror reported as\n629: // verified when nothing wrote it.\n630: const embedRun = (args) => {\n631:   const result = spawnSync(process.execPath, [EMBED_SCRIPT, ...args], { encoding: 'utf8', input: '' });\n632:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n633: };\n634: \n635: const printField = (text, name) => {\n636:   const match = new RegExp(`^${name}: (.*)$`, 'mu').exec(text);\n637:   return match === null ? null : match[1].trim();\n638: };\n639: \n640: // One composed repository per case, in a directory the case removes. Composition reads the\n641: // manifest, so a case describes the template that ships today rather than a stored copy.\n642: const composedTree = (t, name) => {\n643:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `doctor-agents-md-contract-${name}-`));\n644:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n645:   const dir = path.join(parent, name);\n646:   composeFixture(name, dir);\n647:   return dir;\n648: };\n649: \n650: // The engine never deletes a backup, so the case does: only the directory a run printed,\n651: // and only when it sits under the temporary directory it was created in.\n652: const trackBackup = (t, text) => {\n653:   for (const line of text.split('\\n')) {\n654:     const hit = /^backup: (\\S+)$/u.exec(line);\n655:     if (hit === null) continue;\n656:     const dir = hit[1];\n657:     t.after(() => {\n658:       if (!dir.startsWith(os.tmpdir() + path.sep)) return;\n659:       fs.rmSync(dir, { recursive: true, force: true });\n660:     });\n661:   }\n662: };\n663: \n664: // The label of each field line an engine prints, read off its output rather than off its\n665: // source, so a line one of them gains arrives here as a failure with its own name. The\n666: // block body is skipped: its first word is the repository's, not the engine's.\n667: const printedLabels = (text) => {\n668:   const labels = new Set();\n669:   let inBlock = false;\n670:   for (const line of text.split('\\n')) {\n671:     if (line === 'block:') { inBlock = true; continue; }\n672:     if (line === 'block-end:') { inBlock = false; labels.add('block-end'); continue; }\n673:     if (inBlock) continue;\n674:     const hit = /^([a-z][a-z-]*)\\b/u.exec(line);\n675:     if (hit !== null) labels.add(hit[1]);\n676:   }\n677:   return labels;\n678: };\n679: \n680: // Where an operator meets each field line: the presentation's own field, and the phrase the\n681: // workflow keep-list uses. `note` and `finding` are pinned here too, though the fixtures\n682: // below happen not to print them, because the field has to exist for the run that does.\n683: const PRINTED_FIELDS = new Map([\n684:   ['target', { shown: /^Targets: /mu, kept: /the target list/u }],\n685:   ['note', { shown: /^Notes: /mu, kept: /each note/u }],\n686:   ['diff', { shown: /a `diff` per path/u, kept: /each diff/u }],\n687:   ['block', { shown: /^Block: /mu, kept: /`block:` and `block-end:`/u }],\n688:   ['block-end', { shown: /^Block: /mu, kept: /`block:` and `block-end:`/u }],\n689:   ['budget', { shown: /^Budget: /mu, kept: /the budget line/u }],\n690:   ['finding', { shown: /^Findings: /mu, kept: /each finding line/u }],\n691:   ['preservation', { shown: /^Preservation: /mu, kept: /the preservation line/u }],\n692:   ['backup', { shown: /^Backup folder: /mu, kept: /the backup line/u }],\n693:   ['backup-fallback', { shown: /^Backup note: /mu, kept: /the backup-fallback line/u }],\n694:   ['undo', { shown: /^Undo: /mu, kept: /the undo line/u }],\n695:   ['plan-digest', { shown: /^Plan digest: /mu, kept: /the plan-digest line/u }],\n696:   ['wrote', { shown: /^Files changed: /mu, kept: /one wrote or removed line per path/u }],\n697:   ['removed', { shown: /^Files changed: /mu, kept: /one wrote or removed line per path/u }],\n698:   ['pointer-sync', { shown: /^Pointer sync: /mu, kept: /the pointer-sync line/u }],\n699:   ['repo-rules', { shown: /^Router: /mu, kept: /the repo-rules line/u }],\n700:   ['check-after', { shown: /^Re-read: /mu, kept: /the check-after line/u }],\n701:   ['cp', { shown: /one copy line per overwritten file/u, kept: /one copy line per overwritten file/u }],\n702: ]);\n703: \n704: // The restore prints its own lines, so its plan and result templates are held to the same\n705: // rule: a folder a run created is a line an agent can only drop unless a field carries it.\n706: const RESTORE_FIELDS = new Map([\n707:   ['restore', { shown: /^Put back: /mu, kept: /one restore line per path/u }],\n708:   ['dry-run', { shown: /^Dry run: nothing was written and nothing was asked\\.$/mu, kept: /dry-run result/u }],\n709: ]);\n710: \n711: test('every field the writing engines print has a field in the presentation and a line in the keep-list', (t) => {\n712:   const dir = composedTree(t, 'claude-only');\n713:   const planned = embedRun(['plan', '--create-router', '--root', dir]);\n714:   trackBackup(t, planned.out);\n715:   assert.equal(planned.code, 0, planned.err);\n716:   const digest = printField(planned.out, 'plan-digest');\n717:   assert.match(digest || '', /^[0-9a-f]{64}$/u, 'the plan prints its digest');\n718: \n719:   const applied = embedRun(['apply', '--create-router', '--root', dir, '--plan-digest', digest]);\n720:   trackBackup(t, applied.out);\n721:   assert.equal(applied.code, 0, applied.err);\n722: \n723:   // The directory is named after the digest rather than after a clock reading, so the\n724:   // folder and the undo the operator approved are the ones apply used. A clock re-resolved\n725:   // at apply time named a directory no run ever created, and the approved undo exited 2.\n726:   assert.equal(printField(applied.out, 'backup'), printField(planned.out, 'backup'), 'apply backs up where the plan pointed');\n727:   assert.equal(printField(applied.out, 'undo'), printField(planned.out, 'undo'), 'the undo that was approved is the undo apply printed');\n728: \n729:   // The generator rewrites an existing pointer file and never creates a missing one, so a\n730:   // repository without one carries a nonzero verdict on a run that still ends STATUS=OK.\n731:   // That is the case the result template has to be able to show.\n732:   assert.match(applied.out, /^pointer-sync: exit 1 \\(.*skill-routing\\.md: missing/mu);\n733:   assert.doesNotMatch(applied.out, /wrote \\.cursor\\/rules\\/skill-routing\\.md/u);\n734: \n735:   const printed = [...printedLabels(planned.out), ...printedLabels(applied.out)];\n736:   const unnamed = [...new Set(printed)].filter((label) => !PRINTED_FIELDS.has(label)).sort();\n737:   assert.deepEqual(unnamed, [], 'an engine line no field carries');\n738: \n739:   const kept = `${phaseText(EMBED_WORKFLOW, 'phase_2_plan')}\\n${phaseText(EMBED_WORKFLOW, 'phase_4_write')}`;\n740:   for (const [label, where] of PRINTED_FIELDS) {\n741:     assert.ok(where.kept.test(kept), `${label}: the workflow keep-list does not name it`);\n742:     assert.ok(where.shown.test(PRESENTATION), `${label}: the presentation shows no field for it`);\n743:   }\n744: \n745:   // The restore templates carry the same obligation. The apply above created a .cursor\n746:   // folder for the mirror, so its plan prints the folder lines the result has to be able\n747:   // to show, and the run that removes them prints the other form of the same line.\n748:   const backup = printField(applied.out, 'backup');\n749:   const restorePlan = embedRun(['restore', `--run=${backup}`, '--root', dir, '--dry-run']);\n750:   assert.equal(restorePlan.code, 0, restorePlan.err);\n751:   assert.match(restorePlan.out, /^restore \\.cursor\\/rules\\/: remove if empty \\(this run created it\\)$/mu);\n752: \n753:   const restored = embedRun(['restore', `--run=${backup}`, '--root', dir, '--yes']);\n754:   assert.equal(restored.code, 0, restored.err);\n755:   assert.match(restored.out, /^restore \\.cursor\\/rules\\/: removed the empty folder this run created$/mu);\n756: \n757:   const restorePrinted = [...printedLabels(restorePlan.out), ...printedLabels(restored.out)];\n758:   const restoreUnnamed = [...new Set(restorePrinted)].filter((label) => !RESTORE_FIELDS.has(label)).sort();\n759:   assert.deepEqual(restoreUnnamed, [], 'a restore line no field carries');\n760: \n761:   const restoreKept = `${phaseText(RESTORE_WORKFLOW, 'phase_2_plan')}\\n${phaseText(RESTORE_WORKFLOW, 'phase_4_write')}`;\n762:   for (const [label, where] of RESTORE_FIELDS) {\n763:     assert.ok(where.kept.test(restoreKept), `${label}: the restore keep-list does not name it`);\n764:     assert.ok(where.shown.test(PRESENTATION), `${label}: the restore templates show no field for it`);\n765:   }\n766: \n767:   // A record names its own root, and a restore that runs against another one is refused,\n768:   // so the plan template, the result template and the route all name where that ends.\n769:   const refused = embedRun(['restore', `--run=${backup}`, '--yes']);\n770:   assert.equal(refused.code, 2, 'a restore against another root exits 2');\n771:   assert.match(refused.err, /ERROR: the record names the root .*pass --root/u);\n772:   const restorePlanTemplate = PRESENTATION.split('## 5. Restore Plan and Approval')[1].split(/\\n## 6\\./u)[0];\n773:   const restoredTemplate = PRESENTATION.split('### Restored')[1].split('### Failure Summary')[0];\n774:   assert.match(restorePlanTemplate, /^Folders: /mu, 'the plan template has no field for the folder lines');\n775:   assert.match(restoredTemplate, /^Folders: /mu, 'the result template has no field for the folder lines');\n776:   assert.match(restorePlanTemplate, /names another root/u);\n777:   assert.match(PRESENTATION, /^\\| A restore reports that the record names another root \\|/mu);\n778:   assert.match(phaseText(RESTORE_WORKFLOW, 'phase_2_plan'), /names a root other than the one this restore runs against/u);\n779:   assert.match(phaseText(RESTORE_WORKFLOW, 'phase_4_write'), /names another root/u);\n780: });\n781: \n782: test('a plan on a repository with no router names the absent target and the backup note', (t) => {\n783:   const dir = composedTree(t, 'foreign');\n784:   const planned = embedRun(['plan', '--root', dir]);\n785:   assert.equal(planned.code, 0, planned.err);\n786: \n787:   // Two lines a plan prints that no field carried: the fifth target action, and the note\n788:   // that explains a backup placed outside the repository.\n789:   assert.match(planned.out, /^target REPO RULES\\.md: absent$/mu);\n790:   assert.match(planned.out, /^note: /mu);\n791:   assert.match(planned.out, /^backup-fallback: /mu);\n792: \n793:   assert.match(PRESENTATION, /<create\\|replace\\|remove\\|unchanged\\|absent>/u);\n794:   assert.match(PRESENTATION, /`absent` means the path is not there/u);\n795:   assert.match(PRESENTATION, /^Backup note: /mu);\n796:   const plan = phaseText(EMBED_WORKFLOW, 'phase_2_plan');\n797:   assert.match(plan, /absent/u);\n798:   assert.match(plan, /backup-fallback/u);\n799: });\n800: \n801: test('an embed whose pointer sync did not verify names the mirror it could not write', () => {\n802:   const embedded = PRESENTATION.split('### Embedded')[1].split('### Unchanged')[0];\n803:   for (const name of ['Pointer sync:', 'Router:', 'Next:']) {\n804:     assert.match(embedded, new RegExp(`^${name} `, 'mu'), `${name} is not a field of the result`);\n805:   }\n806: \n807:   const write = phaseText(EMBED_WORKFLOW, 'phase_4_write');\n808:   assert.match(write, /nonzero/u);\n809:   assert.match(write, /Next:.*\\/doctor:runtime-mirrors/u, 'a nonzero pointer sync names the mirror route as the next step');\n810:   assert.match(write, /never creates/u, 'the generator cannot create a missing pointer file');\n811:   assert.match(write, /Files changed/u, 'the file it cannot create is never listed as written');\n812: \n813:   // A repair for the row the re-read still reports, and a next step for the line that says\n814:   // why: the check route can only report that row again.\n815:   const troubleshooting = PRESENTATION.split('## 7. Troubleshooting Display')[1].split(/\\n## 8\\./u)[0];\n816:   const row = troubleshooting.split('\\n').find((line) => /^\\| `A10`/u.test(line));\n817:   assert.ok(row, 'the troubleshooting table has no A10 row');\n818:   assert.match(row, /\\/doctor:runtime-mirrors/u);\n819: \n820:   const nextRow = PRESENTATION.split('## 8. Next Step')[1].split('\\n').find((line) => /pointer-sync/u.test(line));\n821:   assert.ok(nextRow, 'the next-step table has no pointer-sync row');\n822:   assert.match(nextRow, /\\/doctor:runtime-mirrors/u);\n823: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-agents-md-contract.test.cjs, lines 1-823\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Agents-MD Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Holds /doctor:agents-md together: the three routes in the manifest, the router,\n8: // the presentation contract, the three workflows and the command contract must\n9: // agree on the targets, the mutation classes, the asset paths, the engines they\n10: // name and the order a write happens in.\n11: //\n12: // The route validator checks structure and the engines' own suites check the bytes\n13: // they produce. What nothing else can see is the promise between the two: that the\n14: // writing workflow is shaped as plan, digest, yes and only then a write, that a no\n15: // leaves the tree exactly as it was, that the workflow's allowlist is the engine's\n16: // own list rather than a second one that drifts from it, and that the router stays\n17: // a router. This suite asserts those promises by reading the files.\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 1. IMPORTS AND FIXTURES\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: const assert = require('node:assert/strict');\n24: const { spawnSync } = require('node:child_process');\n25: const fs = require('node:fs');\n26: const os = require('node:os');\n27: const path = require('node:path');\n28: const test = require('node:test');\n29: const { parse: parseYaml } = require('yaml');\n30: \n31: const { composeFixture } = require('./fixtures/agents-md/compose-fixture.cjs');\n32: \n33: const DOCTOR = path.resolve(__dirname, '..', '..');\n34: const ASSETS = path.join(DOCTOR, 'assets');\n35: const SCRIPTS = path.join(DOCTOR, 'scripts');\n36: const COMMANDS = path.resolve(DOCTOR, '..');\n37: const SKILL_DOC_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n38: \n39: const read = (file) => fs.readFileSync(file, 'utf8');\n40: \n41: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n42: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:agents-md');\n43: const routeFor = (target) => ROUTES.find((route) => route.target === target);\n44: \n45: const ROUTER = read(path.join(DOCTOR, 'agents-md.md'));\n46: const PRESENTATION = read(path.join(ASSETS, 'doctor-agents-md-presentation.txt'));\n47: const CHECK_YAML = read(path.join(ASSETS, 'doctor-agents-md-check.yaml'));\n48: const EMBED_YAML = read(path.join(ASSETS, 'doctor-agents-md-embed.yaml'));\n49: const RESTORE_YAML = read(path.join(ASSETS, 'doctor-agents-md-restore.yaml'));\n50: const SETUP_PRESENTATION = read(path.join(ASSETS, 'doctor-setup-presentation.txt'));\n51: const UPDATE_PRESENTATION = read(path.join(ASSETS, 'doctor-update-presentation.txt'));\n52: const CATALOG = read(path.join(COMMANDS, 'README.txt'));\n53: \n54: const CONTRACT = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.json')));\n55: const SCHEMA = JSON.parse(read(path.join(SKILL_DOC_ASSETS, 'command-contract.schema.json')));\n56: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n57: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n58: \n59: const CHECK_ENGINE = '.skilled/commands/doctor/scripts/agents-md-check.cjs';\n60: const EMBED_ENGINE = '.skilled/commands/doctor/scripts/agents-md-embed.cjs';\n61: const HELPER = path.join(SCRIPTS, 'doctor-helper-match.cjs');\n62: const EMBED_SCRIPT = path.join(SCRIPTS, 'agents-md-embed.cjs');\n63: \n64: // The engine's own write boundary, read from the engine. A second copy in the\n65: // workflow is the drift this suite exists to catch, so the allowlist cases compare\n66: // against this list rather than against a literal here.\n67: const { ALLOWLIST } = require(path.join(SCRIPTS, 'agents-md-embed.cjs'));\n68: \n69: const engineOf = (entry) => entry.match(/\\.skilled\\/\\S+\\.cjs/)[0];\n70: \n71: const CHECK_WORKFLOW = parseYaml(CHECK_YAML);\n72: const EMBED_WORKFLOW = parseYaml(EMBED_YAML);\n73: const RESTORE_WORKFLOW = parseYaml(RESTORE_YAML);\n74: const EMBED_PHASES = Object.keys(EMBED_WORKFLOW.workflow);\n75: const RESTORE_PHASES = Object.keys(RESTORE_WORKFLOW.workflow);\n76: \n77: const yamlStrings = (node, out = []) => {\n78:   if (Array.isArray(node)) {\n79:     for (const value of node) yamlStrings(value, out);\n80:   } else if (node && typeof node === 'object') {\n81:     for (const [key, value] of Object.entries(node)) {\n82:       out.push(key);\n83:       yamlStrings(value, out);\n84:     }\n85:   } else if (typeof node === 'string') {\n86:     out.push(node);\n87:   }\n88:   return out;\n89: };\n90: \n91: const phaseText = (workflow, phase) => yamlStrings(workflow.workflow[phase]).join('\\n');\n92: \n93: // ─────────────────────────────────────────────────────────────────────────────\n94: // 2. THE ROUTES\n95: // ─────────────────────────────────────────────────────────────────────────────\n96: \n97: test('the manifest holds a check, an embed and a restore route, and only check answers the bare command', () => {\n98:   assert.deepEqual(ROUTES.map((route) => route.target), ['check', 'embed', 'restore']);\n99:   // Three targets make the command multi-target, so the read-only one has to claim\n100:   // the bare invocation: without the flag a typed /doctor:agents-md would reach no\n101:   // bridge at all, and a bare invocation must never reach a route that writes.\n102:   assert.equal(routeFor('check').default_target, true);\n103:   assert.equal(routeFor('embed').default_target, undefined);\n104:   assert.equal(routeFor('restore').default_target, undefined);\n105:   assert.equal(routeFor('check').mutating, 'read-only');\n106:   assert.match(routeFor('check').gate3_location, /^n\\/a/);\n107:   assert.equal(routeFor('embed').mutating, 'mutates');\n108:   assert.equal(routeFor('restore').mutating, 'mutates');\n109:   for (const route of ROUTES) {\n110:     assert.equal(route.yaml, `doctor-agents-md-${route.target}.yaml`);\n111:     assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n112:     assert.deepEqual(route.mcp_tools, []);\n113:   }\n114:   assert.deepEqual(routeFor('check').allowed_flags, ['--json', '--root <dir>']);\n115:   assert.deepEqual([...routeFor('embed').allowed_flags].sort(), [\n116:     '--create-router',\n117:     '--dry-run',\n118:     '--keep-claude-md',\n119:     '--plan-digest <digest>',\n120:     '--remove-claude-md',\n121:     '--root <dir>',\n122:   ].sort());\n123:   assert.deepEqual([...routeFor('restore').allowed_flags].sort(), ['--dry-run', '--run <dir>', '--yes'].sort());\n124: });\n125: \n126: // The header is the file's own table of contents, and a reader who trusts it misses every\n127: // router it omits. The count is the folder's, so a new router file fails here until the\n128: // header names it.\n129: test('the route manifest header lists every router file in the folder', () => {\n130:   const header = read(path.join(DOCTOR, '_routes.yaml')).split(/^schema_version:/m)[0];\n131:   const listed = [...header.matchAll(/^#   \\/doctor:(\\S+)\\s+\\S+\\.md$/gm)].map((match) => match[1]).sort();\n132:   const routers = fs.readdirSync(DOCTOR)\n133:     .filter((file) => file.endsWith('.md') && !file.startsWith('local-'))\n134:     .map((file) => file.replace(/\\.md$/, ''))\n135:     .sort();\n136:   assert.deepEqual(listed, routers, 'the header names every router or the count in it is wrong');\n137: });\n138: \n139: test('the writing routes name every place the engines write and nothing else', () => {\n140:   const embed = routeFor('embed').gate3_location;\n141:   // Exactly the six allowlisted paths, the backup that makes the write reversible and\n142:   // the digest that decides whether the approved bytes are the bytes on disk.\n143:   for (const expected of [\n144:     /AGENTS\\.md/,\n145:     /CLAUDE\\.md/,\n146:     /\\.codex\\/AGENTS\\.md/,\n147:     /\\.cursor\\/rules\\/repo-local\\.md/,\n148:     /\\.cursor\\/rules\\/skill-routing\\.md/,\n149:     /REPO RULES\\.md/,\n150:     /backup/i,\n151:     /plan digest/i,\n152:   ]) {\n153:     assert.match(embed, expected);\n154:   }\n155:   // A release unit belongs to /doctor:update, and no embed run stages a commit.\n156:   assert.doesNotMatch(embed, /\\.skilled\\/skills|the git index|commit/i);\n157: \n158:   const restore = routeFor('restore').gate3_location;\n159:   assert.match(restore, /manifest\\.json/);\n160:   assert.match(restore, /allowlist/);\n161:   assert.match(restore, /recorded/);\n162: });\n163: \n164: test('every route names the engine calls its workflow runs and every trigger phrase carries three or more words', () => {\n165:   for (const route of ROUTES) {\n166:     for (const phrase of route.trigger_phrases) {\n167:       assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n168:     }\n169:   }\n170:   // The check route reads, and only reads.\n171:   assert.deepEqual(routeFor('check').script_invocations.map(engineOf), [CHECK_ENGINE]);\n172: \n173:   // The plan writes nothing, the apply carries the digest the plan printed, and the\n174:   // re-read proves what landed. A plan call that already carried the digest would\n175:   // make the approval a formality, so it never does.\n176:   const embedCalls = routeFor('embed').script_invocations;\n177:   assert.deepEqual(embedCalls.map(engineOf), [EMBED_ENGINE, EMBED_ENGINE, CHECK_ENGINE]);\n178:   assert.match(embedCalls[0], /agents-md-embed\\.cjs plan/);\n179:   assert.doesNotMatch(embedCalls[0], /--plan-digest/);\n180:   assert.match(embedCalls[1], /agents-md-embed\\.cjs apply/);\n181:   assert.match(embedCalls[1], /--plan-digest <digest>/);\n182: \n183:   // The restore plan is the engine's own dry run, and the write repeats the record\n184:   // path the operator was shown.\n185:   const restoreCalls = routeFor('restore').script_invocations;\n186:   assert.deepEqual(restoreCalls.map(engineOf), [EMBED_ENGINE, EMBED_ENGINE, CHECK_ENGINE]);\n187:   assert.match(restoreCalls[0], /agents-md-embed\\.cjs restore --run=<dir> --dry-run/);\n188:   assert.match(restoreCalls[1], /agents-md-embed\\.cjs restore --run=<dir> --yes/);\n189:   assert.doesNotMatch(restoreCalls[0], /--yes/);\n190: });\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 3. ROUTER AND PRESENTATION\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n197:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n198:   assert.deepEqual(headings, [\n199:     'ROUTER CONTRACT',\n200:     'OWNED ASSETS',\n201:     'MODE ROUTING',\n202:     'EXECUTION TARGETS',\n203:     'PRESENTATION BOUNDARY',\n204:     'WORKFLOW SUMMARY',\n205:   ]);\n206:   // A fenced block or a status line in the router would put a dashboard or a result\n207:   // template inline, where the presentation contract is the only place they belong.\n208:   assert.doesNotMatch(ROUTER, /```/);\n209:   assert.doesNotMatch(ROUTER, /STATUS=/);\n210: });\n211: \n212: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n213:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n214:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n215:   assert.doesNotMatch(description, /[<>]/);\n216:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n217:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n218:   for (const token of ['[check|embed|restore]', '[--json]', '[--root <dir>]', '[--dry-run]', '[--plan-digest <digest>]', '[--run <dir>]', '[--yes]']) {\n219:     assert.ok(hint.includes(token), token);\n220:   }\n221:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n222:   assert.deepEqual(tools, ['Read', 'Bash']);\n223:   // Instruction-document authoring is sk-doc's, so that is the one skill tag here.\n224:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n225: });\n226: \n227: test('the router binds each target to the workflow asset its route names', () => {\n228:   for (const route of ROUTES) {\n229:     assert.match(\n230:       ROUTER,\n231:       new RegExp(`^\\\\| \\`${route.target}\\` \\\\| \\`\\\\.skilled/commands/doctor/assets/${route.yaml}\\` \\\\|$`, 'm'),\n232:       route.target,\n233:     );\n234:   }\n235: });\n236: \n237: test('the router names both engines as owned assets and composes nothing itself', () => {\n238:   const owned = ROUTER.split('## 2. OWNED ASSETS')[1].split('## 3.')[0];\n239:   assert.ok(owned.includes(CHECK_ENGINE), CHECK_ENGINE);\n240:   assert.ok(owned.includes(EMBED_ENGINE), EMBED_ENGINE);\n241:   assert.match(ROUTER, /Do not compose an `AGENTS\\.md` byte/);\n242: });\n243: \n244: test('the router resolves the bare command to check and keeps every write behind the digest and a yes', () => {\n245:   assert.match(ROUTER, /`default_target`/);\n246:   assert.match(ROUTER, /A bare `\\/doctor:agents-md` never reaches `embed` or `restore`, which write/);\n247:   assert.match(ROUTER, /never runs `apply` without the digest its own plan printed/);\n248:   assert.match(ROUTER, /never runs a writing target without its yes/);\n249: });\n250: \n251: test('the router step list runs the real order: plan, digest, yes, apply, re-read', () => {\n252:   const summary = ROUTER.split('## 6. WORKFLOW SUMMARY')[1];\n253:   const steps = summary.split('\\n').map((line) => line.trim()).filter((line) => /^\\d+\\. /.test(line));\n254:   const at = (pattern) => {\n255:     const index = steps.findIndex((step) => pattern.test(step));\n256:     assert.ok(index >= 0, `no step names ${pattern}`);\n257:     return index;\n258:   };\n259:   const plan = at(/agents-md-embed\\.cjs plan/);\n260:   const digest = at(/the plan digest/);\n261:   const question = at(/asks the embed question/);\n262:   const apply = at(/agents-md-embed\\.cjs apply --plan-digest/);\n263:   const reread = at(/re-reads the written repository/);\n264:   assert.ok(plan < digest, 'the plan is printed before its digest is offered');\n265:   assert.ok(digest < question, 'the digest is named before the question');\n266:   assert.ok(question < apply, 'the apply runs only after the question');\n267:   assert.ok(apply < reread, 'the re-read follows the write');\n268:   const stepText = steps.join('\\n');\n269:   assert.match(stepText, /ends the run as cancelled/);\n270:   assert.match(stepText, /nothing is written/);\n271:   assert.match(stepText, /restore/);\n272: });\n273: \n274: test('the presentation carries the menu, the accepted answers, the manifest rows and the valid targets line', () => {\n275:   assert.match(PRESENTATION, /^## 1\\. Argument Failure$/m);\n276:   assert.match(PRESENTATION, /^1\\) check$/m);\n277:   assert.match(PRESENTATION, /^2\\) embed$/m);\n278:   assert.match(PRESENTATION, /^3\\) restore$/m);\n279:   assert.match(PRESENTATION, /^\\| `1` \\| target = `check` \\|/m);\n280:   assert.match(PRESENTATION, /^\\| `2` \\| target = `embed` \\|/m);\n281:   assert.match(PRESENTATION, /^\\| `3` \\| target = `restore` \\|/m);\n282:   assert.match(PRESENTATION, /^Valid targets: check, embed, restore$/m);\n283:   assert.match(PRESENTATION, /^\\| `check` \\| `doctor-agents-md-check\\.yaml` \\| read-only \\|/m);\n284:   assert.match(PRESENTATION, /^\\| `embed` \\| `doctor-agents-md-embed\\.yaml` \\| mutates \\|/m);\n285:   assert.match(PRESENTATION, /^\\| `restore` \\| `doctor-agents-md-restore\\.yaml` \\| mutates \\|/m);\n286: });\n287: \n288: // A failure the router promises to catch has to have wording, or the agent invents one and\n289: // the operand hears a sentence the contract never approved. A value flag at the end of the\n290: // line and a second positional are the two an operator reaches by hand.\n291: test('the argument table defines a missing value and a second positional for every target', () => {\n292:   const table = PRESENTATION.split('## 1. Argument Failure')[1].split(/\\n## 2\\./u)[0];\n293:   const rows = table.split('\\n').filter((line) => line.startsWith('| '));\n294: \n295:   const missing = rows.find((line) => /value flag/u.test(line));\n296:   assert.ok(missing, 'no row for a value flag given without its value');\n297:   for (const flag of ['--plan-digest', '--root']) assert.ok(missing.includes(flag), `${flag} is not named`);\n298:   assert.match(missing, /STATUS=FAIL ERROR=\"missing_argument\"/u);\n299:   assert.match(missing, /Try: /u);\n300: \n301:   const second = rows.find((line) => /second positional/u.test(line));\n302:   assert.ok(second, 'no row for a second positional');\n303:   // One suggestion per target, because the right next command differs by target.\n304:   assert.match(second, /\\/doctor:agents-md check \\[--json\\] \\[--root <dir>\\]/u);\n305:   assert.match(second, /\\/doctor:agents-md embed \\[--dry-run\\]/u);\n306:   assert.match(second, /\\/doctor:agents-md restore --run=<dir>/u);\n307:   assert.match(second, /STATUS=FAIL ERROR=\"too_many_arguments\"/u);\n308: \n309:   // The router promises this table covers both cases, so it has to name them.\n310:   assert.match(ROUTER, /a value flag without its value/u);\n311:   assert.match(ROUTER, /a second positional/u);\n312: });\n313: \n314: // The engine has three outcomes for an exit 1 and the route has to mirror all three: a row\n315: // that could not be answered is not a finding, and reporting it as one sends the operator\n316: // looking for a fault that was never found.\n317: test('an unproven row ends the check as UNKNOWN, never as a finding', () => {\n318:   assert.match(PRESENTATION, /^Status: \\[OK\\|FINDINGS\\|UNKNOWN\\|ERROR\\]$/mu);\n319:   assert.match(PRESENTATION, /^STATUS=\\[OK\\|FINDINGS\\|UNKNOWN\\]$/mu);\n320:   assert.match(PRESENTATION, /exit 1 with `findings=0` ends `STATUS=UNKNOWN`/u);\n321:   assert.match(PRESENTATION, /never `STATUS=FINDINGS`/u);\n322:   const { output } = CHECK_WORKFLOW;\n323:   assert.match(output, /STATUS=UNKNOWN/u);\n324:   assert.match(output, /findings=0/u);\n325: });\n326: \n327: test('the presentation keeps the check table, the JSON passthrough and the digest it makes the operator approve', () => {\n328:   assert.match(PRESENTATION, /^Agents instruction check: \\[the root the engine read\\]$/m);\n329:   assert.match(PRESENTATION, /^DOCTOR TARGET UNCHANGED$/m);\n330:   assert.ok(PRESENTATION.includes(\"With `--json` print the engine's JSON and nothing else\"));\n331:   assert.match(PRESENTATION, /^Plan digest: \\[the engine's plan-digest line\\]$/m);\n332:   assert.match(PRESENTATION, /Embed these files now\\? \\[yes\\/no\\]$/m);\n333:   assert.match(PRESENTATION, /Restore these paths from that backup now\\? \\[yes\\/no\\]$/m);\n334:   // The digest is what the operator approves, so the wording has to say so.\n335:   assert.match(PRESENTATION, /the digest on screen is the digest the apply repeats/);\n336:   assert.match(PRESENTATION, /never compose a plan digest/);\n337: });\n338: \n339: test('the presentation closes on the unchanged, cancelled, dry-run, restored and failed templates', () => {\n340:   // Every status a route can print appears as its own line, because a workflow that\n341:   // ends on one of them must have been told the exact string.\n342:   for (const status of ['STATUS=OK', 'STATUS=FINDINGS', 'STATUS=UNKNOWN', 'STATUS=CANCELLED ACTION=cancelled', 'STATUS=FAIL ERROR=\"[code]\"', 'STATUS=ERROR ERROR=\"[message]\"']) {\n343:     assert.match(PRESENTATION, new RegExp(`^${status.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}$`, 'm'), status);\n344:   }\n345:   assert.match(PRESENTATION, /^STATUS=CANCELLED ACTION=cancelled$/m);\n346:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[code\\]\"$/m);\n347:   assert.match(PRESENTATION, /^STATUS=ERROR ERROR=\"\\[message\\]\"$/m);\n348:   assert.match(PRESENTATION, /Declined: \\[the embed \\| the restore\\]/);\n349:   assert.match(PRESENTATION, /^End interactive presentations with: `What would you like to do next\\?`$/m);\n350: });\n351: \n352: // ─────────────────────────────────────────────────────────────────────────────\n353: // 4. THE CHECK WORKFLOW\n354: // ─────────────────────────────────────────────────────────────────────────────\n355: \n356: test('the check workflow is read-only and runs the check engine the route declares', () => {\n357:   assert.equal(CHECK_WORKFLOW.operating_mode.execution, 'read_only');\n358:   assert.equal(CHECK_WORKFLOW.mutation_boundaries.read_only, true);\n359:   assert.deepEqual(CHECK_WORKFLOW.mutation_boundaries.allowed_targets, []);\n360:   assert.ok(CHECK_YAML.includes(CHECK_ENGINE), CHECK_ENGINE);\n361: });\n362: \n363: test('the check workflow declares every variable its route resolves', () => {\n364:   for (const key of routeFor('check').setup_vars) {\n365:     assert.ok(key in CHECK_WORKFLOW.inputs, `inputs.${key} is missing`);\n366:   }\n367: });\n368: \n369: test('the check workflow passes --json and --root only when the operator asked', () => {\n370:   assert.match(CHECK_WORKFLOW.inputs.json_output, /true when --json is passed/);\n371:   assert.match(CHECK_YAML, /--json when the operator/);\n372:   assert.doesNotMatch(CHECK_YAML, /agents-md-check\\.cjs --json/);\n373:   assert.match(CHECK_WORKFLOW.inputs.root, /--root <dir>/);\n374:   // The default root is the repository the operator is in, so an unconditional\n375:   // --root would classify somebody else's tree.\n376:   assert.doesNotMatch(CHECK_YAML, /agents-md-check\\.cjs --root/);\n377: });\n378: \n379: test('the check workflow maps the engine exit classes to a route status', () => {\n380:   const { output } = CHECK_WORKFLOW;\n381:   assert.match(output, /STATUS=OK/);\n382:   assert.match(output, /STATUS=FINDINGS/);\n383:   // Exit 1 covers two outcomes, and the route has to keep them apart: a row nobody could\n384:   // answer is not a finding, and calling it one sends the operator after a fault that was\n385:   // never found.\n386:   assert.match(output, /STATUS=UNKNOWN/);\n387:   assert.match(output, /findings=0/);\n388:   assert.match(output, /STATUS=ERROR/);\n389: });\n390: \n391: // ─────────────────────────────────────────────────────────────────────────────\n392: // 5. THE EMBED AND RESTORE WORKFLOWS\n393: // ─────────────────────────────────────────────────────────────────────────────\n394: \n395: test('the embed workflow is interactive, writes only on a yes and never commits', () => {\n396:   assert.equal(EMBED_WORKFLOW.operating_mode.execution, 'interactive');\n397:   assert.equal(EMBED_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n398:   assert.equal(EMBED_WORKFLOW.operating_mode.dry_run, 'print_the_plan_then_status_ok_without_asking');\n399:   assert.equal(EMBED_WORKFLOW.operating_mode.never_commit, true);\n400:   assert.deepEqual(EMBED_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n401:   assert.equal(EMBED_WORKFLOW.output.presentation, '.skilled/commands/doctor/assets/doctor-agents-md-presentation.txt');\n402: });\n403: \n404: test('the embed workflow runs its phases in the read, plan, approval, write, re-read, report order', () => {\n405:   assert.deepEqual(EMBED_PHASES, [\n406:     'phase_1_read',\n407:     'phase_2_plan',\n408:     'phase_3_approval',\n409:     'phase_4_write',\n410:     'phase_5_reread',\n411:     'phase_6_report',\n412:   ]);\n413:   assert.equal(EMBED_WORKFLOW.mutation_boundaries.read_only, false);\n414: });\n415: \n416: test('the embed allowlist is the engine own list and nothing beside it', () => {\n417:   const boundaries = EMBED_WORKFLOW.mutation_boundaries;\n418:   const allowed = boundaries.allowed_targets.join('\\n');\n419:   for (const file of ALLOWLIST) {\n420:     assert.ok(allowed.includes(file), `${file} is missing from the workflow allowlist`);\n421:   }\n422:   const namedPaths = boundaries.allowed_targets\n423:     .map((entry) => entry.split(/[,:]/)[0].trim())\n424:     .filter((first) => first.endsWith('.md'));\n425:   assert.deepEqual([...namedPaths].sort(), [...ALLOWLIST].sort());\n426:   const forbidden = boundaries.forbidden_targets.join('\\n');\n427:   assert.match(forbidden, /agents-md-embed\\.cjs/);\n428:   assert.match(forbidden, /the git index/);\n429:   assert.match(forbidden, /\\.skilled\\/\\*\\*, which \\/doctor:update owns/);\n430: });\n431: \n432: test('the embed workflow writes only after the printed plan, its digest and the yes', () => {\n433:   const plan = phaseText(EMBED_WORKFLOW, 'phase_2_plan');\n434:   assert.match(plan, new RegExp(`${EMBED_ENGINE} plan`));\n435:   assert.doesNotMatch(plan, /--plan-digest/);\n436:   assert.match(plan, /plan-digest/);\n437: \n438:   const approval = phaseText(EMBED_WORKFLOW, 'phase_3_approval');\n439:   assert.match(approval, /Ask the embed question once/);\n440:   assert.match(approval, /the plan the operator has just read/);\n441:   assert.match(approval, /STATUS=CANCELLED ACTION=cancelled/);\n442:   assert.match(approval, /naming the declined embed/);\n443:   assert.match(approval, /Nothing is written/);\n444: \n445:   const write = phaseText(EMBED_WORKFLOW, 'phase_4_write');\n446:   assert.match(write, /only after the embed yes/);\n447:   assert.match(write, /--plan-digest/);\n448:   assert.match(write, /does not match/);\n449:   assert.ok(EMBED_PHASES.indexOf('phase_3_approval') < EMBED_PHASES.indexOf('phase_4_write'));\n450:   // The write switch is the engine's own apply subcommand, and the digest is the\n451:   // plan's, so a plan approved at one tree cannot be applied at another.\n452:   assert.doesNotMatch(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /apply --plan-digest/);\n453: });\n454: \n455: test('a no at the embed question ends the run with nothing written, and a dry run ends at OK', () => {\n456:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_3_approval'), /Any answer other than yes is a no/);\n457:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /If dry_run is true/);\n458:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /STATUS=OK/);\n459:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /asks nothing and writes nothing/);\n460:   assert.match(phaseText(EMBED_WORKFLOW, 'phase_2_plan'), /NOTHING TO DO/);\n461: });\n462: \n463: test('the embed workflow hands the undo block back instead of composing one', () => {\n464:   const report = phaseText(EMBED_WORKFLOW, 'phase_6_report');\n465:   assert.match(report, /undo block the engine printed/);\n466:   assert.match(report, /Undo:/);\n467:   assert.match(report, /Never run the undo inside this route/);\n468:   assert.match(report, /the operator commits/i);\n469: });\n470: \n471: test('the restore workflow asks once, plans from the engine, and writes only after that yes', () => {\n472:   assert.equal(RESTORE_WORKFLOW.operating_mode.execution, 'interactive');\n473:   assert.equal(RESTORE_WORKFLOW.operating_mode.approvals, 'explicit_yes');\n474:   assert.equal(RESTORE_WORKFLOW.operating_mode.never_commit, true);\n475:   assert.deepEqual(RESTORE_WORKFLOW.output.statuses, ['OK', 'CANCELLED', 'FAIL']);\n476:   assert.deepEqual(RESTORE_PHASES, [\n477:     'phase_1_read',\n478:     'phase_2_plan',\n479:     'phase_3_approval',\n480:     'phase_4_write',\n481:     'phase_5_reread',\n482:     'phase_6_report',\n483:   ]);\n484:   for (const key of routeFor('restore').setup_vars) {\n485:     assert.ok(key in RESTORE_WORKFLOW.inputs, `inputs.${key} is missing`);\n486:   }\n487:   const plan = phaseText(RESTORE_WORKFLOW, 'phase_2_plan');\n488:   assert.match(plan, /restore --run=\\{run_dir\\} --dry-run/);\n489:   assert.doesNotMatch(plan, /--yes/);\n490:   const write = phaseText(RESTORE_WORKFLOW, 'phase_4_write');\n491:   assert.match(write, /restore --run=\\{run_dir\\} --yes/);\n492:   assert.match(write, /only after the restore yes/);\n493:   const approval = phaseText(RESTORE_WORKFLOW, 'phase_3_approval');\n494:   assert.match(approval, /STATUS=CANCELLED ACTION=cancelled/);\n495:   assert.match(approval, /naming the declined restore/);\n496:   assert.match(approval, /Nothing is written/);\n497: });\n498: \n499: test('the restore workflow restores only what one run recorded, and reads the hash first', () => {\n500:   const boundaries = RESTORE_WORKFLOW.mutation_boundaries;\n501:   const allowed = boundaries.allowed_targets.join('\\n');\n502:   assert.match(allowed, /manifest\\.json/);\n503:   assert.match(allowed, /allowlist/);\n504:   const forbidden = boundaries.forbidden_targets.join('\\n');\n505:   assert.match(forbidden, /agents-md-embed\\.cjs/);\n506:   assert.match(forbidden, /the git index/);\n507:   assert.match(boundaries.invariant, /recorded hash/);\n508:   assert.match(boundaries.invariant, /STATUS=CANCELLED/);\n509:   // A restore never reads a backup directory the operator was not shown.\n510:   assert.match(phaseText(RESTORE_WORKFLOW, 'phase_1_read'), /manifest\\.json/);\n511: });\n512: \n513: // ─────────────────────────────────────────────────────────────────────────────\n514: // 6. THE COMMAND CONTRACT, THE SETUP LIST AND THE CATALOG\n515: // ─────────────────────────────────────────────────────────────────────────────\n516: \n517: test('the doctor contract entry carries every field its schema requires and nothing it forbids', () => {\n518:   for (const key of FAMILY_SCHEMA.required) {\n519:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n520:   }\n521:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n522:   assert.deepEqual(\n523:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n524:     [],\n525:     'the schema forbids an additional property',\n526:   );\n527:   assert.ok(FAMILY_SCHEMA.properties.topology.enum.includes(DOCTOR_CONTRACT.topology));\n528: });\n529: \n530: test('the contract names the router, the three workflows, the presentation, the hint and the alias', () => {\n531:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/agents-md.md'));\n532:   for (const asset of ['doctor-agents-md-check.yaml', 'doctor-agents-md-embed.yaml', 'doctor-agents-md-restore.yaml']) {\n533:     assert.ok(DOCTOR_CONTRACT.execution_targets.some((entry) => entry.target.endsWith(asset)), asset);\n534:     assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.endsWith(asset)), asset);\n535:   }\n536:   assert.ok(DOCTOR_CONTRACT.owned_assets\n537:     .some((entry) => entry.purpose === 'presentation' && entry.path.endsWith('doctor-agents-md-presentation.txt')));\n538:   // A script asset carries its one-line purpose beside the path, the way the helper's\n539:   // does, so the path is matched inside the cell rather than at its end.\n540:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes('agents-md-check.cjs')));\n541:   assert.ok(DOCTOR_CONTRACT.owned_assets.some((entry) => entry.path.includes('agents-md-embed.cjs')));\n542:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n543:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (agents-md)`));\n544:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(`/doctor:agents-md ${hint}`));\n545:   const lines = DOCTOR_CONTRACT.loader_requirements.filter((line) => line.includes('/doctor:agents-md'));\n546:   const text = lines.join('\\n');\n547:   assert.match(text, /check is the read-only default target/);\n548:   assert.match(text, /plan digest/i);\n549:   assert.match(text, /restore/);\n550:   assert.match(text, /STATUS=CANCELLED/);\n551:   assert.ok(DOCTOR_CONTRACT.destructive_policy.operations.some((line) => line.includes('agents-md embed')));\n552:   assert.ok(DOCTOR_CONTRACT.destructive_policy.operations.some((line) => line.includes('agents-md restore')));\n553: });\n554: \n555: test('the setup target list carries one agents-md row and keeps the rest of the family', () => {\n556:   const rows = SETUP_PRESENTATION.split('\\n').filter((line) => line.includes('/doctor:agents-md'));\n557:   assert.equal(rows.length, 1);\n558:   assert.match(rows[0], /^\\| `\\/doctor:agents-md \\[check\\|embed\\|restore\\]/);\n559:   // The family's own reach check requires one row per doctor router, so a row here\n560:   // and a router file there are the same decision.\n561:   const routers = fs.readdirSync(DOCTOR)\n562:     .filter((file) => file.endsWith('.md'))\n563:     .map((file) => file.replace(/\\.md$/, ''))\n564:     .filter((name) => name !== 'helper' && !name.startsWith('local-'));\n565:   const missing = routers.filter((name) => !SETUP_PRESENTATION.includes(`/doctor:${name}`));\n566:   assert.deepEqual(missing, []);\n567: });\n568: \n569: test('the update presentation gains one line naming the check target', () => {\n570:   const lines = UPDATE_PRESENTATION.split('\\n').filter((line) => line.includes('/doctor:agents-md'));\n571:   assert.equal(lines.length, 1);\n572:   assert.match(lines[0], /\\/doctor:agents-md check$/);\n573: });\n574: \n575: test('the commands catalog lists the router and counts the folder it lives in', () => {\n576:   const rows = CATALOG.split('\\n').filter((line) => line.includes('/doctor:agents-md'));\n577:   assert.equal(rows.length, 1);\n578:   const routers = fs.readdirSync(DOCTOR).filter((file) => file.endsWith('.md') && !file.startsWith('local-'));\n579:   const groupRow = CATALOG.split('\\n').find((line) => /^\\| \\*\\*doctor\\*\\* \\|/.test(line));\n580:   assert.ok(groupRow, 'the doctor group row is missing from the catalog');\n581:   assert.equal(Number(groupRow.split('|')[3].trim()), routers.length);\n582: });\n583: \n584: // ─────────────────────────────────────────────────────────────────────────────\n585: // 7. REACH: THE PROBLEMS AN OPERATOR ACTUALLY WRITES\n586: // ─────────────────────────────────────────────────────────────────────────────\n587: \n588: const rank = (problem) => {\n589:   const result = spawnSync(process.execPath, [HELPER, '--json', '--', problem], { encoding: 'utf8' });\n590:   return { status: result.status, report: JSON.parse(result.stdout) };\n591: };\n592: \n593: test('three plain-language AGENTS.md problems reach the three new routes', () => {\n594:   const cases = [\n595:     ['my agents md still has the old shipped sections and I want to know which ones are stale', '/doctor:agents-md check'],\n596:     ['embed the new shipped instructions into my agents md', '/doctor:agents-md embed'],\n597:     ['undo the agents md embed and bring back the file I had before', '/doctor:agents-md restore'],\n598:   ];\n599:   for (const [problem, runnable] of cases) {\n600:     const { status, report } = rank(problem);\n601:     assert.equal(status, 0, `${problem}: exit ${status}`);\n602:     assert.equal(report.status, 'match', problem);\n603:     assert.equal(report.candidates[0].runnable, runnable, `${problem} -> ${report.candidates[0].runnable}`);\n604:   }\n605: });\n606: \n607: test('every phrase on the three routes ranks its own route first', () => {\n608:   const { loadEntries, rankProblem } = require(HELPER);\n609:   const { entries } = loadEntries(path.resolve(DOCTOR, '..', '..', '..'));\n610:   const routable = entries.filter((entry) => entry.command !== '/doctor:helper');\n611:   const misses = [];\n612:   for (const route of ROUTES) {\n613:     const runnable = `/doctor:agents-md ${route.target}`;\n614:     assert.ok(routable.some((entry) => entry.runnable === runnable), `${runnable} has no helper entry`);\n615:     for (const phrase of route.trigger_phrases) {\n616:       const top = rankProblem(routable, phrase, {}).candidates[0];\n617:       if (!top || top.runnable !== runnable) misses.push(`\"${phrase}\" -> ${top ? top.runnable : 'no match'}`);\n618:     }\n619:   }\n620:   assert.deepEqual(misses, []);\n621: });\n622: \n623: // ─────────────────────────────────────────────────────────────────────────────\n624: // 8. THE LINES THE ENGINES PRINT AND THE FIELDS THAT CARRY THEM\n625: // ─────────────────────────────────────────────────────────────────────────────\n626: \n627: // A line an engine prints and neither the workflow keep-list nor the presentation names is\n628: // a line an agent can only drop, and a dropped pointer-sync line is a mirror reported as\n629: // verified when nothing wrote it.\n630: const embedRun = (args) => {\n631:   const result = spawnSync(process.execPath, [EMBED_SCRIPT, ...args], { encoding: 'utf8', input: '' });\n632:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n633: };\n634: \n635: const printField = (text, name) => {\n636:   const match = new RegExp(`^${name}: (.*)$`, 'mu').exec(text);\n637:   return match === null ? null : match[1].trim();\n638: };\n639: \n640: // One composed repository per case, in a directory the case removes. Composition reads the\n641: // manifest, so a case describes the template that ships today rather than a stored copy.\n642: const composedTree = (t, name) => {\n643:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `doctor-agents-md-contract-${name}-`));\n644:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n645:   const dir = path.join(parent, name);\n646:   composeFixture(name, dir);\n647:   return dir;\n648: };\n649: \n650: // The engine never deletes a backup, so the case does: only the directory a run printed,\n651: // and only when it sits under the temporary directory it was created in.\n652: const trackBackup = (t, text) => {\n653:   for (const line of text.split('\\n')) {\n654:     const hit = /^backup: (\\S+)$/u.exec(line);\n655:     if (hit === null) continue;\n656:     const dir = hit[1];\n657:     t.after(() => {\n658:       if (!dir.startsWith(os.tmpdir() + path.sep)) return;\n659:       fs.rmSync(dir, { recursive: true, force: true });\n660:     });\n661:   }\n662: };\n663: \n664: // The label of each field line an engine prints, read off its output rather than off its\n665: // source, so a line one of them gains arrives here as a failure with its own name. The\n666: // block body is skipped: its first word is the repository's, not the engine's.\n667: const printedLabels = (text) => {\n668:   const labels = new Set();\n669:   let inBlock = false;\n670:   for (const line of text.split('\\n')) {\n671:     if (line === 'block:') { inBlock = true; continue; }\n672:     if (line === 'block-end:') { inBlock = false; labels.add('block-end'); continue; }\n673:     if (inBlock) continue;\n674:     const hit = /^([a-z][a-z-]*)\\b/u.exec(line);\n675:     if (hit !== null) labels.add(hit[1]);\n676:   }\n677:   return labels;\n678: };\n679: \n680: // Where an operator meets each field line: the presentation's own field, and the phrase the\n681: // workflow keep-list uses. `note` and `finding` are pinned here too, though the fixtures\n682: // below happen not to print them, because the field has to exist for the run that does.\n683: const PRINTED_FIELDS = new Map([\n684:   ['target', { shown: /^Targets: /mu, kept: /the target list/u }],\n685:   ['note', { shown: /^Notes: /mu, kept: /each note/u }],\n686:   ['diff', { shown: /a `diff` per path/u, kept: /each diff/u }],\n687:   ['block', { shown: /^Block: /mu, kept: /`block:` and `block-end:`/u }],\n688:   ['block-end', { shown: /^Block: /mu, kept: /`block:` and `block-end:`/u }],\n689:   ['budget', { shown: /^Budget: /mu, kept: /the budget line/u }],\n690:   ['finding', { shown: /^Findings: /mu, kept: /each finding line/u }],\n691:   ['preservation', { shown: /^Preservation: /mu, kept: /the preservation line/u }],\n692:   ['backup', { shown: /^Backup folder: /mu, kept: /the backup line/u }],\n693:   ['backup-fallback', { shown: /^Backup note: /mu, kept: /the backup-fallback line/u }],\n694:   ['undo', { shown: /^Undo: /mu, kept: /the undo line/u }],\n695:   ['plan-digest', { shown: /^Plan digest: /mu, kept: /the plan-digest line/u }],\n696:   ['wrote', { shown: /^Files changed: /mu, kept: /one wrote or removed line per path/u }],\n697:   ['removed', { shown: /^Files changed: /mu, kept: /one wrote or removed line per path/u }],\n698:   ['pointer-sync', { shown: /^Pointer sync: /mu, kept: /the pointer-sync line/u }],\n699:   ['repo-rules', { shown: /^Router: /mu, kept: /the repo-rules line/u }],\n700:   ['check-after', { shown: /^Re-read: /mu, kept: /the check-after line/u }],\n701:   ['cp', { shown: /one copy line per overwritten file/u, kept: /one copy line per overwritten file/u }],\n702: ]);\n703: \n704: // The restore prints its own lines, so its plan and result templates are held to the same\n705: // rule: a folder a run created is a line an agent can only drop unless a field carries it.\n706: const RESTORE_FIELDS = new Map([\n707:   ['restore', { shown: /^Put back: /mu, kept: /one restore line per path/u }],\n708:   ['dry-run', { shown: /^Dry run: nothing was written and nothing was asked\\.$/mu, kept: /dry-run result/u }],\n709: ]);\n710: \n711: test('every field the writing engines print has a field in the presentation and a line in the keep-list', (t) => {\n712:   const dir = composedTree(t, 'claude-only');\n713:   const planned = embedRun(['plan', '--create-router', '--root', dir]);\n714:   trackBackup(t, planned.out);\n715:   assert.equal(planned.code, 0, planned.err);\n716:   const digest = printField(planned.out, 'plan-digest');\n717:   assert.match(digest || '', /^[0-9a-f]{64}$/u, 'the plan prints its digest');\n718: \n719:   const applied = embedRun(['apply', '--create-router', '--root', dir, '--plan-digest', digest]);\n720:   trackBackup(t, applied.out);\n721:   assert.equal(applied.code, 0, applied.err);\n722: \n723:   // The directory is named after the digest rather than after a clock reading, so the\n724:   // folder and the undo the operator approved are the ones apply used. A clock re-resolved\n725:   // at apply time named a directory no run ever created, and the approved undo exited 2.\n726:   assert.equal(printField(applied.out, 'backup'), printField(planned.out, 'backup'), 'apply backs up where the plan pointed');\n727:   assert.equal(printField(applied.out, 'undo'), printField(planned.out, 'undo'), 'the undo that was approved is the undo apply printed');\n728: \n729:   // The generator rewrites an existing pointer file and never creates a missing one, so a\n730:   // repository without one carries a nonzero verdict on a run that still ends STATUS=OK.\n731:   // That is the case the result template has to be able to show.\n732:   assert.match(applied.out, /^pointer-sync: exit 1 \\(.*skill-routing\\.md: missing/mu);\n733:   assert.doesNotMatch(applied.out, /wrote \\.cursor\\/rules\\/skill-routing\\.md/u);\n734: \n735:   const printed = [...printedLabels(planned.out), ...printedLabels(applied.out)];\n736:   const unnamed = [...new Set(printed)].filter((label) => !PRINTED_FIELDS.has(label)).sort();\n737:   assert.deepEqual(unnamed, [], 'an engine line no field carries');\n738: \n739:   const kept = `${phaseText(EMBED_WORKFLOW, 'phase_2_plan')}\\n${phaseText(EMBED_WORKFLOW, 'phase_4_write')}`;\n740:   for (const [label, where] of PRINTED_FIELDS) {\n741:     assert.ok(where.kept.test(kept), `${label}: the workflow keep-list does not name it`);\n742:     assert.ok(where.shown.test(PRESENTATION), `${label}: the presentation shows no field for it`);\n743:   }\n744: \n745:   // The restore templates carry the same obligation. The apply above created a .cursor\n746:   // folder for the mirror, so its plan prints the folder lines the result has to be able\n747:   // to show, and the run that removes them prints the other form of the same line.\n748:   const backup = printField(applied.out, 'backup');\n749:   const restorePlan = embedRun(['restore', `--run=${backup}`, '--root', dir, '--dry-run']);\n750:   assert.equal(restorePlan.code, 0, restorePlan.err);\n751:   assert.match(restorePlan.out, /^restore \\.cursor\\/rules\\/: remove if empty \\(this run created it\\)$/mu);\n752: \n753:   const restored = embedRun(['restore', `--run=${backup}`, '--root', dir, '--yes']);\n754:   assert.equal(restored.code, 0, restored.err);\n755:   assert.match(restored.out, /^restore \\.cursor\\/rules\\/: removed the empty folder this run created$/mu);\n756: \n757:   const restorePrinted = [...printedLabels(restorePlan.out), ...printedLabels(restored.out)];\n758:   const restoreUnnamed = [...new Set(restorePrinted)].filter((label) => !RESTORE_FIELDS.has(label)).sort();\n759:   assert.deepEqual(restoreUnnamed, [], 'a restore line no field carries');\n760: \n761:   const restoreKept = `${phaseText(RESTORE_WORKFLOW, 'phase_2_plan')}\\n${phaseText(RESTORE_WORKFLOW, 'phase_4_write')}`;\n762:   for (const [label, where] of RESTORE_FIELDS) {\n763:     assert.ok(where.kept.test(restoreKept), `${label}: the restore keep-list does not name it`);\n764:     assert.ok(where.shown.test(PRESENTATION), `${label}: the restore templates show no field for it`);\n765:   }\n766: \n767:   // A record names its own root, and a restore that runs against another one is refused,\n768:   // so the plan template, the result template and the route all name where that ends.\n769:   const refused = embedRun(['restore', `--run=${backup}`, '--yes']);\n770:   assert.equal(refused.code, 2, 'a restore against another root exits 2');\n771:   assert.match(refused.err, /ERROR: the record names the root .*pass --root/u);\n772:   const restorePlanTemplate = PRESENTATION.split('## 5. Restore Plan and Approval')[1].split(/\\n## 6\\./u)[0];\n773:   const restoredTemplate = PRESENTATION.split('### Restored')[1].split('### Failure Summary')[0];\n774:   assert.match(restorePlanTemplate, /^Folders: /mu, 'the plan template has no field for the folder lines');\n775:   assert.match(restoredTemplate, /^Folders: /mu, 'the result template has no field for the folder lines');\n776:   assert.match(restorePlanTemplate, /names another root/u);\n777:   assert.match(PRESENTATION, /^\\| A restore reports that the record names another root \\|/mu);\n778:   assert.match(phaseText(RESTORE_WORKFLOW, 'phase_2_plan'), /names a root other than the one this restore runs against/u);\n779:   assert.match(phaseText(RESTORE_WORKFLOW, 'phase_4_write'), /names another root/u);\n780: });\n781: \n782: test('a plan on a repository with no router names the absent target and the backup note', (t) => {\n783:   const dir = composedTree(t, 'foreign');\n784:   const planned = embedRun(['plan', '--root', dir]);\n785:   assert.equal(planned.code, 0, planned.err);\n786: \n787:   // Two lines a plan prints that no field carried: the fifth target action, and the note\n788:   // that explains a backup placed outside the repository.\n789:   assert.match(planned.out, /^target REPO RULES\\.md: absent$/mu);\n790:   assert.match(planned.out, /^note: /mu);\n791:   assert.match(planned.out, /^backup-fallback: /mu);\n792: \n793:   assert.match(PRESENTATION, /<create\\|replace\\|remove\\|unchanged\\|absent>/u);\n794:   assert.match(PRESENTATION, /`absent` means the path is not there/u);\n795:   assert.match(PRESENTATION, /^Backup note: /mu);\n796:   const plan = phaseText(EMBED_WORKFLOW, 'phase_2_plan');\n797:   assert.match(plan, /absent/u);\n798:   assert.match(plan, /backup-fallback/u);\n799: });\n800: \n801: test('an embed whose pointer sync did not verify names the mirror it could not write', () => {\n802:   const embedded = PRESENTATION.split('### Embedded')[1].split('### Unchanged')[0];\n803:   for (const name of ['Pointer sync:', 'Router:', 'Next:']) {\n804:     assert.match(embedded, new RegExp(`^${name} `, 'mu'), `${name} is not a field of the result`);\n805:   }\n806: \n807:   const write = phaseText(EMBED_WORKFLOW, 'phase_4_write');\n808:   assert.match(write, /nonzero/u);\n809:   assert.match(write, /Next:.*\\/doctor:runtime-mirrors/u, 'a nonzero pointer sync names the mirror route as the next step');\n810:   assert.match(write, /never creates/u, 'the generator cannot create a missing pointer file');\n811:   assert.match(write, /Files changed/u, 'the file it cannot create is never listed as written');\n812: \n813:   // A repair for the row the re-read still reports, and a next step for the line that says\n814:   // why: the check route can only report that row again.\n815:   const troubleshooting = PRESENTATION.split('## 7. Troubleshooting Display')[1].split(/\\n## 8\\./u)[0];\n816:   const row = troubleshooting.split('\\n').find((line) => /^\\| `A10`/u.test(line));\n817:   assert.ok(row, 'the troubleshooting table has no A10 row');\n818:   assert.match(row, /\\/doctor:runtime-mirrors/u);\n819: \n820:   const nextRow = PRESENTATION.split('## 8. Next Step')[1].split('\\n').find((line) => /pointer-sync/u.test(line));\n821:   assert.ok(nextRow, 'the next-step table has no pointer-sync row');\n822:   assert.match(nextRow, /\\/doctor:runtime-mirrors/u);\n823: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-agents-md-contract.test.cjs\"}"},"time":{"start":1794546209113,"end":1794546209422}}}}
