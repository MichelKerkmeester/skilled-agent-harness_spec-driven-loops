-n \\\"git init|\\\\bgit\\\\b.*init\\\" .skilled/skills/system-skill-advisor/runtime/tests .skilled/commands/doctor/scripts/tests 2>/dev/null | head -20\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794545808081,"end":1794545809348}}}}
