{"type":"tool_use","timestamp":1794545775742,"sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","part":{"partID":"prt_1d3437302001fb6p189n3flyvR","sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","messageID":"msg_1d3435c64001DJu1KqcLYAroDU","type":"tool","id":"call_37894418ec344a45a09611d0","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-328\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: \n29: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n30: \n31: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n32: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n33: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n34: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n35: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n36: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n37: const DEFAULT_TIMEOUT_MS = 30_000;\n38: const MAX_OUTPUT_BYTES = 1024 * 1024;\n39: \n40: function failedOffer(offerError) {\n41:   return { offeredCommand: null, offeredPolicy: null, offerError };\n42: }\n43: \n44: /**\n45:  * Read the command and the policy out of the first line of a head.\n46:  *\n47:  * The policy only counts when it directly follows the command, so a `(ask)`\n48:  * that belongs to a later clause cannot attach itself to an earlier match.\n49:  *\n50:  * @param {string} head - One line of advisor output.\n51:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n52:  */\n53: export function parseOffer(head) {\n54:   const text = typeof head === 'string' ? head : '';\n55:   const match = text.match(OFFER_PATTERN);\n56:   if (!match) {\n57:     return { offeredCommand: null, offeredPolicy: null };\n58:   }\n59:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n60:   return {\n61:     offeredCommand: match[0],\n62:     offeredPolicy: policy ? policy[1] : null,\n63:   };\n64: }\n65: \n66: /**\n67:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n68:  *\n69:  * The hook is resolved from the checkout rather than from this module, so a\n70:  * backfill records what that checkout's advisor would have offered at the time\n71:  * of the run, not what the current working copy happens to say.\n72:  *\n73:  * @param {object} options\n74:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n75:  * @param {string} options.prompt - The prompt to replay.\n76:  * @param {string} options.sessionId - Session id for the hook payload.\n77:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n78:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n79:  */\n80: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n81:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n82:   if (!existsSync(hookPath)) {\n83:     return failedOffer('hook_missing');\n84:   }\n85: \n86:   const payload = {\n87:     prompt,\n88:     cwd: checkoutDir,\n89:     hook_event_name: 'UserPromptSubmit',\n90:     session_id: sessionId,\n91:   };\n92: \n93:   let result;\n94:   try {\n95:     result = spawnSync('node', [hookPath], {\n96:       cwd: checkoutDir,\n97:       input: JSON.stringify(payload),\n98:       encoding: 'utf8',\n99:       timeout: timeoutMs,\n100:       maxBuffer: MAX_OUTPUT_BYTES,\n101:     });\n102:   } catch {\n103:     return failedOffer('hook_failed');\n104:   }\n105: \n106:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   let output;\n111:   try {\n112:     output = JSON.parse(result.stdout);\n113:   } catch {\n114:     return failedOffer('hook_failed');\n115:   }\n116: \n117:   const context = output?.hookSpecificOutput?.additionalContext;\n118:   if (typeof context !== 'string') {\n119:     return failedOffer('no_head');\n120:   }\n121: \n122:   const [firstLine = ''] = context.split(/\\r?\\n/);\n123:   if (!firstLine.trim()) {\n124:     return failedOffer('no_head');\n125:   }\n126: \n127:   return { ...parseOffer(firstLine), offerError: null };\n128: }\n129: \n130: function contentHasBrief(content) {\n131:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n132:   if (!Array.isArray(content)) return false;\n133:   return content.some((part) => {\n134:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n135:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n136:   });\n137: }\n138: \n139: // Neutral records keep their text in content blocks, and the block shape differs\n140: // by runtime, so the serialized record is the one place the brief is found\n141: // whichever block carries it.\n142: function recordsHaveBrief(records) {\n143:   return (Array.isArray(records) ? records : []).some((record) =>\n144:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n145: }\n146: \n147: /**\n148:  * Decide whether the advisor brief reached the session that ran the turn.\n149:  *\n150:  * A Claude transcript records the hook context as its own attachment line, so a\n151:  * missing attachment is a real miss. Pi keeps delivery in its session records\n152:  * and needs the caller's reader. Every other runtime has no confirmed record of\n153:  * delivery, so its answer stays `unknown` and never counts as a miss.\n154:  *\n155:  * @param {object} options\n156:  * @param {string} options.runtime - The measured runtime.\n157:  * @param {object|null} [options.locator] - The locator the run line recorded.\n158:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n159:  *   lives in session records rather than a transcript file.\n160:  * @returns {Promise<boolean | 'unknown'>}\n161:  */\n162: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n163:   if (runtime === 'claude') {\n164:     const transcriptPath = locator?.transcriptPath;\n165:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n166:       return 'unknown';\n167:     }\n168: \n169:     let raw;\n170:     try {\n171:       raw = readFileSync(transcriptPath, 'utf8');\n172:     } catch {\n173:       return 'unknown';\n174:     }\n175: \n176:     for (const line of raw.split('\\n')) {\n177:       if (!line.trim()) continue;\n178:       let entry;\n179:       try {\n180:         entry = JSON.parse(line);\n181:       } catch {\n182:         continue;\n183:       }\n184:       if (entry?.type !== 'attachment') continue;\n185:       const attachment = entry.attachment;\n186:       if (attachment?.type !== 'hook_additional_context') continue;\n187:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n188:       if (contentHasBrief(attachment.content)) return true;\n189:     }\n190:     return false;\n191:   }\n192: \n193:   if (runtime === 'pi') {\n194:     if (typeof loadSession !== 'function') return 'unknown';\n195:     let loaded;\n196:     try {\n197:       loaded = await loadSession({ ...locator, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n220:     'node',\n221:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n222:     {\n223:       cwd: checkoutDir,\n224:       encoding: 'utf8',\n225:       timeout: DEFAULT_TIMEOUT_MS,\n226:       maxBuffer: MAX_OUTPUT_BYTES,\n227:     },\n228:   );\n229: }\n230: \n231: function refused(code, detail) {\n232:   return { ok: false, code, detail };\n233: }\n234: \n235: /**\n236:  * Add the offer, its policy and the brief to every line of a run log.\n237:  *\n238:  * The prompts are resolved before the first line is written, so a row the\n239:  * corpus refuses leaves no output file behind. A line whose locator names no\n240:  * checkout keeps null offer fields and its own error code, and the rest of the\n241:  * log is still written.\n242:  *\n243:  * @param {object} options\n244:  * @param {string} options.inPath - Run log to read.\n245:  * @param {string} options.outPath - New run log to write.\n246:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n247:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n248:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n249:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n250:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n251:  *   injectable for tests.\n252:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n253:  *   | { ok: false, code: string, detail: string }>}\n254:  */\n255: export async function backfillRunLog({\n256:   inPath,\n257:   outPath,\n258:   promptFor,\n259:   replay = replayOffer,\n260:   brief = briefDelivered,\n261:   warm = warmCheckout,\n262: }) {\n263:   if (resolve(outPath) === resolve(inPath)) {\n264:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n265:   }\n266: \n267:   const rows = [];\n268:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n269:     if (raw.trim() === '') continue;\n270:     rows.push(JSON.parse(raw));\n271:   }\n272: \n273:   const prompts = [];\n274:   for (const row of rows) {\n275:     try {\n276:       prompts.push(promptFor(row.rowId));\n277:     } catch (error) {\n278:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n279:     }\n280:   }\n281: \n282:   const warmed = new Set();\n283:   const output = [];\n284:   for (let index = 0; index < rows.length; index += 1) {\n285:     const line = rows[index];\n286:     const rowId = line.rowId;\n287:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n288:       ? line.locator\n289:       : null;\n290:     const projectDir = locator?.projectDir;\n291:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n292: \n293:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n294:     if (checkoutDir !== null) {\n295:       if (!warmed.has(checkoutDir)) {\n296:         warmed.add(checkoutDir);\n297:         try {\n298:           await warm(checkoutDir);\n299:         } catch {\n300:           // A failed warm-up still lets the replay report its own miss.\n301:         }\n302:       }\n303:       offer = await replay({\n304:         checkoutDir,\n305:         prompt: prompts[index],\n306:         sessionId: `backfill-${rowId}`,\n307:       });\n308:     }\n309: \n310:     // Pi keeps its brief in a session store rather than a transcript, so the\n311:     // shared reader travels with every call. A runtime that has no reader for\n312:     // its store ignores it and answers `unknown`.\n313:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n314: \n315:     output.push({\n316:       ...line,\n317:       offeredCommand: offer.offeredCommand ?? null,\n318:       offeredPolicy: offer.offeredPolicy ?? null,\n319:       offerError: offer.offerError ?? null,\n320:       briefDelivered: delivered,\n321:       offerBackfilled: true,\n322:     });\n323:   }\n324: \n325:   mkdirSync(dirname(outPath), { recursive: true });\n326:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n327:   return { ok: true, lines: output.length, outPath };\n328: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-328\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: \n29: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n30: \n31: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n32: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n33: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n34: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n35: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n36: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n37: const DEFAULT_TIMEOUT_MS = 30_000;\n38: const MAX_OUTPUT_BYTES = 1024 * 1024;\n39: \n40: function failedOffer(offerError) {\n41:   return { offeredCommand: null, offeredPolicy: null, offerError };\n42: }\n43: \n44: /**\n45:  * Read the command and the policy out of the first line of a head.\n46:  *\n47:  * The policy only counts when it directly follows the command, so a `(ask)`\n48:  * that belongs to a later clause cannot attach itself to an earlier match.\n49:  *\n50:  * @param {string} head - One line of advisor output.\n51:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n52:  */\n53: export function parseOffer(head) {\n54:   const text = typeof head === 'string' ? head : '';\n55:   const match = text.match(OFFER_PATTERN);\n56:   if (!match) {\n57:     return { offeredCommand: null, offeredPolicy: null };\n58:   }\n59:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n60:   return {\n61:     offeredCommand: match[0],\n62:     offeredPolicy: policy ? policy[1] : null,\n63:   };\n64: }\n65: \n66: /**\n67:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n68:  *\n69:  * The hook is resolved from the checkout rather than from this module, so a\n70:  * backfill records what that checkout's advisor would have offered at the time\n71:  * of the run, not what the current working copy happens to say.\n72:  *\n73:  * @param {object} options\n74:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n75:  * @param {string} options.prompt - The prompt to replay.\n76:  * @param {string} options.sessionId - Session id for the hook payload.\n77:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n78:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n79:  */\n80: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n81:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n82:   if (!existsSync(hookPath)) {\n83:     return failedOffer('hook_missing');\n84:   }\n85: \n86:   const payload = {\n87:     prompt,\n88:     cwd: checkoutDir,\n89:     hook_event_name: 'UserPromptSubmit',\n90:     session_id: sessionId,\n91:   };\n92: \n93:   let result;\n94:   try {\n95:     result = spawnSync('node', [hookPath], {\n96:       cwd: checkoutDir,\n97:       input: JSON.stringify(payload),\n98:       encoding: 'utf8',\n99:       timeout: timeoutMs,\n100:       maxBuffer: MAX_OUTPUT_BYTES,\n101:     });\n102:   } catch {\n103:     return failedOffer('hook_failed');\n104:   }\n105: \n106:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   let output;\n111:   try {\n112:     output = JSON.parse(result.stdout);\n113:   } catch {\n114:     return failedOffer('hook_failed');\n115:   }\n116: \n117:   const context = output?.hookSpecificOutput?.additionalContext;\n118:   if (typeof context !== 'string') {\n119:     return failedOffer('no_head');\n120:   }\n121: \n122:   const [firstLine = ''] = context.split(/\\r?\\n/);\n123:   if (!firstLine.trim()) {\n124:     return failedOffer('no_head');\n125:   }\n126: \n127:   return { ...parseOffer(firstLine), offerError: null };\n128: }\n129: \n130: function contentHasBrief(content) {\n131:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n132:   if (!Array.isArray(content)) return false;\n133:   return content.some((part) => {\n134:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n135:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n136:   });\n137: }\n138: \n139: // Neutral records keep their text in content blocks, and the block shape differs\n140: // by runtime, so the serialized record is the one place the brief is found\n141: // whichever block carries it.\n142: function recordsHaveBrief(records) {\n143:   return (Array.isArray(records) ? records : []).some((record) =>\n144:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n145: }\n146: \n147: /**\n148:  * Decide whether the advisor brief reached the session that ran the turn.\n149:  *\n150:  * A Claude transcript records the hook context as its own attachment line, so a\n151:  * missing attachment is a real miss. Pi keeps delivery in its session records\n152:  * and needs the caller's reader. Every other runtime has no confirmed record of\n153:  * delivery, so its answer stays `unknown` and never counts as a miss.\n154:  *\n155:  * @param {object} options\n156:  * @param {string} options.runtime - The measured runtime.\n157:  * @param {object|null} [options.locator] - The locator the run line recorded.\n158:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n159:  *   lives in session records rather than a transcript file.\n160:  * @returns {Promise<boolean | 'unknown'>}\n161:  */\n162: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n163:   if (runtime === 'claude') {\n164:     const transcriptPath = locator?.transcriptPath;\n165:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n166:       return 'unknown';\n167:     }\n168: \n169:     let raw;\n170:     try {\n171:       raw = readFileSync(transcriptPath, 'utf8');\n172:     } catch {\n173:       return 'unknown';\n174:     }\n175: \n176:     for (const line of raw.split('\\n')) {\n177:       if (!line.trim()) continue;\n178:       let entry;\n179:       try {\n180:         entry = JSON.parse(line);\n181:       } catch {\n182:         continue;\n183:       }\n184:       if (entry?.type !== 'attachment') continue;\n185:       const attachment = entry.attachment;\n186:       if (attachment?.type !== 'hook_additional_context') continue;\n187:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n188:       if (contentHasBrief(attachment.content)) return true;\n189:     }\n190:     return false;\n191:   }\n192: \n193:   if (runtime === 'pi') {\n194:     if (typeof loadSession !== 'function') return 'unknown';\n195:     let loaded;\n196:     try {\n197:       loaded = await loadSession({ ...locator, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n220:     'node',\n221:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n222:     {\n223:       cwd: checkoutDir,\n224:       encoding: 'utf8',\n225:       timeout: DEFAULT_TIMEOUT_MS,\n226:       maxBuffer: MAX_OUTPUT_BYTES,\n227:     },\n228:   );\n229: }\n230: \n231: function refused(code, detail) {\n232:   return { ok: false, code, detail };\n233: }\n234: \n235: /**\n236:  * Add the offer, its policy and the brief to every line of a run log.\n237:  *\n238:  * The prompts are resolved before the first line is written, so a row the\n239:  * corpus refuses leaves no output file behind. A line whose locator names no\n240:  * checkout keeps null offer fields and its own error code, and the rest of the\n241:  * log is still written.\n242:  *\n243:  * @param {object} options\n244:  * @param {string} options.inPath - Run log to read.\n245:  * @param {string} options.outPath - New run log to write.\n246:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n247:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n248:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n249:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n250:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n251:  *   injectable for tests.\n252:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n253:  *   | { ok: false, code: string, detail: string }>}\n254:  */\n255: export async function backfillRunLog({\n256:   inPath,\n257:   outPath,\n258:   promptFor,\n259:   replay = replayOffer,\n260:   brief = briefDelivered,\n261:   warm = warmCheckout,\n262: }) {\n263:   if (resolve(outPath) === resolve(inPath)) {\n264:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n265:   }\n266: \n267:   const rows = [];\n268:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n269:     if (raw.trim() === '') continue;\n270:     rows.push(JSON.parse(raw));\n271:   }\n272: \n273:   const prompts = [];\n274:   for (const row of rows) {\n275:     try {\n276:       prompts.push(promptFor(row.rowId));\n277:     } catch (error) {\n278:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n279:     }\n280:   }\n281: \n282:   const warmed = new Set();\n283:   const output = [];\n284:   for (let index = 0; index < rows.length; index += 1) {\n285:     const line = rows[index];\n286:     const rowId = line.rowId;\n287:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n288:       ? line.locator\n289:       : null;\n290:     const projectDir = locator?.projectDir;\n291:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n292: \n293:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n294:     if (checkoutDir !== null) {\n295:       if (!warmed.has(checkoutDir)) {\n296:         warmed.add(checkoutDir);\n297:         try {\n298:           await warm(checkoutDir);\n299:         } catch {\n300:           // A failed warm-up still lets the replay report its own miss.\n301:         }\n302:       }\n303:       offer = await replay({\n304:         checkoutDir,\n305:         prompt: prompts[index],\n306:         sessionId: `backfill-${rowId}`,\n307:       });\n308:     }\n309: \n310:     // Pi keeps its brief in a session store rather than a transcript, so the\n311:     // shared reader travels with every call. A runtime that has no reader for\n312:     // its store ignores it and answers `unknown`.\n313:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n314: \n315:     output.push({\n316:       ...line,\n317:       offeredCommand: offer.offeredCommand ?? null,\n318:       offeredPolicy: offer.offeredPolicy ?? null,\n319:       offerError: offer.offerError ?? null,\n320:       briefDelivered: delivered,\n321:       offerBackfilled: true,\n322:     });\n323:   }\n324: \n325:   mkdirSync(dirname(outPath), { recursive: true });\n326:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n327:   return { ok: true, lines: output.length, outPath };\n328: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794545775362,"end":1794545775742}}}}
{"type":"tool_use","timestamp":1794545775751,"sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","part":{"partID":"prt_1d34370e1001hugHdm97gI73bK","sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","messageID":"msg_1d3435c64001DJu1KqcLYAroDU","type":"tool","id":"call_8238d931ff9f401aa0255fd9","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1-1168\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: One-Turn Command Behaviour Runner\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Command surfacing is only proven by a turn that starts the way an operator\n6: // starts it: one prompt, the real CLI, and a session id the transcript reader\n7: // can open afterwards. Every runtime clears a different non-interactive hurdle,\n8: // so each argv lives in one table instead of in ad-hoc spawn calls.\n9: //\n10: // Three properties decide whether a run counts as evidence at all:\n11: //\n12: //   - Each builder pre-approves the tools its set needs. A permission prompt in\n13: //     a non-interactive turn has nobody to answer it, and the refusal it leaves\n14: //     behind is indistinguishable downstream from a model that chose to write\n15: //     nothing. Without this, every must-not-start row passes for the wrong\n16: //     reason.\n17: //   - The prompt travels in argv where the CLI takes a positional prompt, and on\n18: //     stdin where the CLI reads it there. Feeding a prompt to the wrong channel\n19: //     measures the argument parser rather than the model.\n20: //   - A turn is capped by the prompt it runs. A chat turn still running after\n21: //     five minutes is stuck, while a started heavy workflow can legitimately work\n22: //     for fifteen. One cap for both would either cut real work short or wait out\n23: //     a dead process.\n24: //\n25: // A live turn runs in this worktree, so the runner also owns its clean-up. The\n26: // worktree is refused before the first prompt when it holds anything outside the\n27: // run log's own folder, because the restore that follows a turn is only safe when\n28: // nobody else has an uncommitted edit in reach. Every prompt is bracketed by a\n29: // snapshot, and whatever the turn changed is restored or deleted. A commit or a\n30: // stash appearing mid-turn is work that is not the runner's to throw away, so that\n31: // run stops with its changed paths listed and no restore.\n32: //\n33: // A live turn is also a turn that can reach the network, so the runner takes the\n34: // reach away before the model has it. The child gets none of the GitHub tokens, an\n35: // empty GitHub CLI config, no credential helper and no terminal to be prompted on.\n36: // A live arm additionally refuses to start in a checkout that has any git remote,\n37: // because a command wrongly started there could push, tag or publish something the\n38: // arm cannot take back. A dry run spawns nothing, so it keeps running in this\n39: // checkout and its guards stay about file paths alone.\n40: //\n41: // Usage:\n42: //   node run-command-behaviour.mjs --print-argv <runtime>\n43: //   node run-command-behaviour.mjs --list <set>\n44: //   node run-command-behaviour.mjs --runtime <runtime> (--set <set> | --row-id <id>...)\n45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n46: //   node run-command-behaviour.mjs --backfill <run-log> --out <new-log>\n47: \n48: import { appendFileSync, mkdirSync, readdirSync, readFileSync, realpathSync, rmSync } from 'node:fs';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { homedir } from 'node:os';\n51: import { randomUUID } from 'node:crypto';\n52: import { spawn, spawnSync } from 'node:child_process';\n53: import { fileURLToPath } from 'node:url';\n54: import { dshProjectKey, dshStoreRoot } from '../../../../../hooks/shared/session-readers/dsh.mjs';\n55: import { backfillRunLog, briefDelivered, replayOffer } from './command-offer.mjs';\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const REPO_ROOT = resolve(HERE, '../../../../../..');\n59: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n60: // A stored session is found by its id plus the directory the turn ran in, and the\n61: // scorer reads it back from another checkout, so the locator records the resolved\n62: // directory instead of letting each reader compare the id against its own root.\n63: const PROJECT_DIR = realpathSync(REPO_ROOT);\n64: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n65: \n66: const EXIT_REFUSED = 2;\n67: const EXIT_HEAD_MOVED = 3;\n68: \n69: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n70: // from either set and the cap has to follow the row, not the invocation.\n71: const CAP_MS = Object.freeze({\n72:   chat: 300_000,\n73:   started: 900_000,\n74: });\n75: \n76: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n77: const CODEX_MODEL = 'gpt-6-luna';\n78: // The variant rides the model string, because `opencode run` has no flag for it.\n79: const OPENCODE_MODEL = 'llmgateway/deepseek-v4.1-flash-1017#max';\n80: const PI_MODEL = 'llmgateway/deepseek-v4.1-flash-1017';\n81: const DEVIN_MODEL = 'swe-2-max';\n82: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n83: \n84: // Runtimes the phase reports as not measured, with the reason a run would be\n85: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n86: // transcript could not be scored even if the turn ran.\n87: const NOT_MEASURED = Object.freeze({\n88:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n89: });\n90: \n91: function has(object, key) {\n92:   return Object.prototype.hasOwnProperty.call(object, key);\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────\n96: // Runtime argv table\n97: // ───────────────────────────────────────────────────────────────\n98: \n99: const RUNTIMES = {\n100:   claude: {\n101:     command: 'claude',\n102:     model: CLAUDE_MODEL,\n103:     promptOnStdin: false,\n104:     // stream-json writes one JSON object per line and every one of them carries\n105:     // the session id the transcript is stored under.\n106:     locator: { kind: 'stream', field: 'session_id' },\n107:     // The reader opens a transcript by id plus its own path, and Claude Code names\n108:     // the file after the session inside a folder per working directory.\n109:     findTranscript: claudeTranscriptPath,\n110:     buildArgv: ({ prompt }) => [\n111:       '-p',\n112:       prompt,\n113:       '--model',\n114:       CLAUDE_MODEL,\n115:       // stream-json is the only output format that carries the session id the\n116:       // reader needs after the turn ends.\n117:       '--output-format',\n118:       'stream-json',\n119:       '--verbose',\n120:       // Print mode has nobody to answer an approval prompt, and the default mode\n121:       // both denies writes and refuses shell commands, which is exactly the\n122:       // behaviour an ask-row test must be free to observe.\n123:       '--permission-mode',\n124:       'bypassPermissions',\n125:     ],\n126:   },\n127:   codex: {\n128:     command: 'codex',\n129:     model: CODEX_MODEL,\n130:     promptOnStdin: true,\n131:     // The run opens with an event naming its thread, and the rollout file is\n132:     // named after that thread id.\n133:     locator: { kind: 'stream', field: 'thread_id' },\n134:     // The rollout file is named after the thread id the stream reported, so the id\n135:     // alone leads back to it once the store has been searched.\n136:     findTranscript: codexTranscriptPath,\n137:     buildArgv: () => [\n138:       'exec',\n139:       // The JSON event stream is how a turn reports its thread id.\n140:       '--json',\n141:       '--model',\n142:       CODEX_MODEL,\n143:       '-c',\n144:       'model_reasoning_effort=medium',\n145:       '-c',\n146:       'service_tier=fast',\n147:       // A headless run cannot answer an approval prompt, and `exec` defaults to a\n148:       // read-only sandbox that would silently swallow every write.\n149:       '-c',\n150:       'approval_policy=never',\n151:       '--sandbox',\n152:       'workspace-write',\n153:       '-',\n154:     ],\n155:   },\n156:   opencode: {\n157:     command: 'opencode',\n158:     model: OPENCODE_MODEL,\n159:     promptOnStdin: false,\n160:     // The turn's own events carry the id of the session it created.\n161:     locator: { kind: 'stream', field: 'sessionID' },\n162:     buildArgv: ({ prompt }) => [\n163:       // `opencode run` takes no --dir, and the child already starts in the\n164:       // checkout, so passing the directory a second time would only fail.\n165:       'run',\n166:       // Without this the turn is handed to the operator's long-running background\n167:       // service, whose tools run with that service's environment. The hardened\n168:       // environment this runner builds would then never reach a tool call.\n169:       '--standalone',\n170:       '--model',\n171:       OPENCODE_MODEL,\n172:       '--format',\n173:       'json',\n174:       // Auto-approve everything not explicitly denied. A run that stalls on a\n175:       // permission prompt reads as a model that declined to act.\n176:       '--auto',\n177:       prompt,\n178:     ],\n179:   },\n180:   pi: {\n181:     command: 'pi',\n182:     model: PI_MODEL,\n183:     promptOnStdin: false,\n184:     // Print mode never reports the session it wrote, so the runner mints the id\n185:     // and passes it on the command line instead of recovering it from the stream.\n186:     locator: { kind: 'runner' },\n187:     buildArgv: ({ prompt, sessionId }) => [\n188:       '-p',\n189:       // Without it a non-interactive Pi probes the network on startup and can\n190:       // hang before it ever reads the prompt.\n191:       '--offline',\n192:       '--model',\n193:       PI_MODEL,\n194:       // Without a minted id the log would have to be guessed from whatever\n195:       // file is newest, which can open a neighbouring turn's transcript.\n196:       '--session-id',\n197:       sessionId,\n198:       prompt,\n199:     ],\n200:   },\n201:   devin: {\n202:     command: 'devin',\n203:     model: DEVIN_MODEL,\n204:     promptOnStdin: false,\n205:     // A Devin turn keeps its session in a store its own output does not name, so\n206:     // the id comes from the listing of the directory the turn ran in.\n207:     locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n208:     buildArgv: ({ prompt }) => [\n209:       '-p',\n210:       '--model',\n211:       DEVIN_MODEL,\n212:       // Under `accept-edits` every tool call that wants confirmation is refused,\n213:       // so a headless turn explores its whole budget and writes nothing.\n214:       '--permission-mode',\n215:       'dangerous',\n216:       // A fresh checkout has never been trusted interactively, and print mode has\n217:       // nobody to answer the trust prompt, so the turn would refuse to start.\n218:       '--respect-workspace-trust',\n219:       'false',\n220:       // No `--sandbox` here. That flag forces a permission mode that ignores\n221:       // `dangerous` and rejects every write in print mode, so a turn would write\n222:       // nothing and read as a model that declined. Containment comes from the\n223:       // arena instead.\n224:       // The separator keeps a prompt that opens with a dash from parsing as a flag.\n225:       '--',\n226:       prompt,\n227:     ],\n228:   },\n229:   dsh: {\n230:     command: 'dsh',\n231:     // dsh takes no model flag at all. The roster route patch decides the model,\n232:     // and this table pins the verified LLM Gateway route.\n233:     model: DSH_MODEL,\n234:     promptOnStdin: true,\n235:     // The harness names the session itself and refuses an id it never created,\n236:     // so the turn's id is recovered from the store folder its log lands in.\n237:     locator: { kind: 'store', list: dshSessionIds },\n238:     buildArgv: () => [\n239:       '--profile',\n240:       'headless',\n241:       '--patch',\n242:       resolve(DSH_PATCH_DIR, 'route-llmgateway-deepseek.patch.yml'),\n243:       // No lineage patch: it marks the run as a fan-out leaf, and the repo\n244:       // guards keep the prompt advisor off for a leaf. A chat turn has to\n245:       // receive the brief like a person's session would.\n246:       '--patch',\n247:       resolve(DSH_PATCH_DIR, 'guards.patch.yml'),\n248:       '--json',\n249:       '--permission-mode',\n250:       'workspace-write',\n251:       // Approvals default to ask, and a headless turn has nobody to answer.\n252:       '--approval-policy',\n253:       'never',\n254:       // The dash takes the prompt from stdin, which is the channel a headless\n255:       // run reads, and keeps a prompt that opens with one from parsing as a\n256:       // flag.\n257:       '-',\n258:     ],\n259:   },\n260: };\n261: \n262: // ───────────────────────────────────────────────────────────────\n263: // Session locator\n264: // ───────────────────────────────────────────────────────────────\n265: //\n266: // A run log is only evidence if it leads back to the exact transcript the turn\n267: // wrote, and each runtime exposes that handle in its own way. Three sources\n268: // exist: an id the CLI reports after the turn, either in its output or in the\n269: // session listing it keeps, an id the runner hands the CLI before it starts, or\n270: // no recorded source at all, which the log states rather than filling with the\n271: // newest file in the store.\n272: \n273: // Output arrives in chunks that cut a line in half, so a line is parsed only\n274: // once its newline has come through. Parsing stops at the first match, because\n275: // the id never changes within one turn.\n276: function streamLocator(field) {\n277:   let pending = '';\n278:   let captured = null;\n279:   return {\n280:     push(chunk) {\n281:       if (field === null || captured !== null) return;\n282:       pending += chunk;\n283:       const lines = pending.split('\\n');\n284:       pending = lines.pop() ?? '';\n285:       for (const line of lines) {\n286:         captured = readId(line, field);\n287:         if (captured !== null) return;\n288:       }\n289:     },\n290:     value() {\n291:       if (captured === null && pending !== '') captured = readId(pending, field);\n292:       return captured;\n293:     },\n294:   };\n295: }\n296: \n297: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n298: // this line holds no locator rather than that the run failed.\n299: function readId(line, field) {\n300:   let event;\n301:   try {\n302:     event = JSON.parse(line);\n303:   } catch {\n304:     return null;\n305:   }\n306:   const id = event?.[field];\n307:   return typeof id === 'string' && id !== '' ? id : null;\n308: }\n309: \n310: // A runtime that keeps its sessions in a store its output never names still lists\n311: // them for the directory the turn ran in, so two listings taken around a turn\n312: // reduce the store to a set difference. The listing runs in the child's\n313: // environment, because that is the store the turn itself wrote to.\n314: const LISTING_CAP_MS = 60_000;\n315: \n316: function listingIds(runtime, ghConfig) {\n317:   const source = runtime.locator;\n318:   if (source.kind !== 'listing') return null;\n319:   const result = spawnSync(runtime.command, source.args, {\n320:     cwd: REPO_ROOT,\n321:     env: childEnv(ghConfig),\n322:     encoding: 'utf8',\n323:     timeout: LISTING_CAP_MS,\n324:   });\n325:   if (result.error) return null;\n326:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n327: }\n328: \n329: // A runtime that names its session only in a store it owns is bracketed by two\n330: // readings of that store, and the entry the turn added is the session it wrote.\n331: function listsStore(runtime) {\n332:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n333: }\n334: \n335: // Only the reading differs between the store-backed forms: one CLI answers with\n336: // its own index and the other keeps one folder per session. Any other kind\n337: // names its session in the turn's output instead.\n338: function storeIds(runtime, ghConfig) {\n339:   return runtime.locator.kind === 'store'\n340:     ? runtime.locator.list()\n341:     : listingIds(runtime, ghConfig);\n342: }\n343: \n344: // The listing is a JSON array of session objects whose `id` field is the value\n345: // the CLI's own resume takes, so that field is the one that leads back to a\n346: // transcript. Any other shape names no session, which the caller reads as no id\n347: // rather than as a failed run.\n348: function listedSessionIds(text) {\n349:   let entries;\n350:   try {\n351:     entries = JSON.parse(text);\n352:   } catch {\n353:     return null;\n354:   }\n355:   if (!Array.isArray(entries)) return null;\n356:   return entries\n357:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n358:     .filter((id) => typeof id === 'string' && id !== '');\n359: }\n360: \n361: // A session another operator opened while the turn ran is not this turn's, and a\n362: // listing that reports none or several added entries has no id it can name with\n363: // confidence, so only a single added entry becomes the locator.\n364: function addedSessionId(before, after) {\n365:   if (before === null || after === null) return null;\n366:   const known = new Set(before);\n367:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n368:   return added.length === 1 ? added[0] : null;\n369: }\n370: \n371: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n372: // locator records the home the run used and the transcript stays findable from\n373: // the log alone.\n374: function dshHome() {\n375:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n376: }\n377: \n378: // A DSH session is a folder named after its id under one folder per project the\n379: // harness keyed from the directory the turn ran in, and the turn's own output\n380: // never names that id. The store root comes from the reader so the folder listed\n381: // here is the folder the reader will search. A store the harness has not created\n382: // yet lists nothing, which is the same answer as a turn that wrote no session.\n383: function dshSessionIds() {\n384:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n385:   try {\n386:     return readdirSync(store, { withFileTypes: true })\n387:       .filter((entry) => entry.isDirectory())\n388:       .map((entry) => entry.name);\n389:   } catch {\n390:     return [];\n391:   }\n392: }\n393: \n394: // A store folder is the CLI's to lay out, so the walk follows the folders it\n395: // creates and matches on the file name instead of predicting a path. A store that\n396: // is missing or unreadable names no transcript, which is the same answer as a turn\n397: // that wrote none rather than a reason to fail the run.\n398: function findTranscriptFiles(dir, matches, depth) {\n399:   let entries;\n400:   try {\n401:     entries = readdirSync(dir, { withFileTypes: true });\n402:   } catch {\n403:     return [];\n404:   }\n405:   const found = [];\n406:   for (const entry of entries) {\n407:     if (entry.isFile() && matches(entry.name)) {\n408:       found.push(join(dir, entry.name));\n409:     } else if (entry.isDirectory() && depth > 0) {\n410:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n411:     }\n412:   }\n413:   return found;\n414: }\n415: \n416: // One match is the turn's own transcript, while two leave the locator without a\n417: // path because choosing between them could score a neighbouring turn under this\n418: // row. The path is resolved so a log written from another checkout still opens.\n419: function storedTranscriptPath(root, matches, depth = Infinity) {\n420:   const found = findTranscriptFiles(root, matches, depth);\n421:   return found.length === 1 ? resolve(found[0]) : null;\n422: }\n423: \n424: // Claude Code keeps one folder per working directory and writes each transcript\n425: // directly inside it, so one level below the store is the whole of the search. A\n426: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n427: // and which the reader refuses.\n428: function claudeTranscriptPath(sessionId) {\n429:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n430:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n431: }\n432: \n433: // A Codex rollout file is named after its start time and ends with the thread id,\n434: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n435: // store is searched and the id is a suffix of the name.\n436: function codexTranscriptPath(sessionId) {\n437:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n438:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n439: }\n440: \n441: // A store listing that added no single entry leaves the id out rather than\n442: // naming a guess that would score a neighbouring turn under this row. The home\n443: // stays on the record so the store the run wrote to is findable from the log\n444: // alone.\n445: function storeLocator(reportedId) {\n446:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n447:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n448: }\n449: \n450: function locatorFor(runtime, sessionId, reportedId) {\n451:   const source = runtime.locator;\n452:   // The id the runner handed the CLI is the one the store keys its log by, and\n453:   // the directory the turn ran in is what a reader matches the log's header\n454:   // against, so both travel with every record.\n455:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n456:   if (source.kind === 'store') return storeLocator(reportedId);\n457:   // A runtime that reported no id records none, which keeps a scorer from opening\n458:   // a neighbouring transcript that happens to be newer.\n459:   if (reportedId === null) return null;\n460:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n461:   // A reader needs the file the turn wrote as well as its id, so a store-based\n462:   // runtime resolves the id to a path once the turn has closed. A turn that left\n463:   // no single match keeps the field out rather than naming a guess.\n464:   const transcriptPath = typeof runtime.findTranscript === 'function'\n465:     ? runtime.findTranscript(reportedId)\n466:     : null;\n467:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n468:   return locator;\n469: }\n470: \n471: // ───────────────────────────────────────────────────────────────\n472: // Worktree guards\n473: // ───────────────────────────────────────────────────────────────\n474: //\n475: // Every live turn runs in this worktree, so the runner cleans up after itself and\n476: // refuses to start when the worktree already holds work that is not its own. The\n477: // order matters: the remote check runs before the dirty check, so a live refusal\n478: // names the one condition an arm can never repair, and the dirty check runs before\n479: // the first prompt, so a restore can never discard an edit another worker has not\n480: // committed yet, and the head check runs around every prompt, so a commit or a\n481: // stash taken mid-turn stops the arm before the next model call rather than after\n482: // the damage.\n483: \n484: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n485: // lie, and the restore step trusts that snapshot.\n486: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n487: \n488: function git(args) {\n489:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n490:     cwd: REPO_ROOT,\n491:     encoding: 'utf8',\n492:   });\n493:   if (result.error) throw result.error;\n494:   return result;\n495: }\n496: \n497: function gitText(args) {\n498:   const result = git(args);\n499:   if (result.status !== 0) {\n500:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n501:   }\n502:   return result.stdout;\n503: }\n504: \n505: function statusPaths() {\n506:   const paths = new Map();\n507:   for (const line of gitText(['status', '--porcelain']).split('\\n')) {\n508:     if (line.length < 4) continue;\n509:     // A rename carries both sides, and both have to be put back.\n510:     for (const path of line.slice(3).split(' -> ')) {\n511:       paths.set(path, line.slice(0, 2));\n512:     }\n513:   }\n514:   return paths;\n515: }\n516: \n517: // The out folder is this arm's own output area. Git is asked for that folder's path\n518: // from the top of the repository, because comparing two spellings of the same\n519: // folder misreads a root that is reached through a symlink. An out folder outside\n520: // any repository exempts nothing, which only makes the guard stricter.\n521: function exemptPrefix(outDir) {\n522:   mkdirSync(outDir, { recursive: true });\n523:   const result = spawnSync('git', [...GIT_PREFIX, 'rev-parse', '--show-prefix'], {\n524:     cwd: outDir,\n525:     encoding: 'utf8',\n526:   });\n527:   if (result.status !== 0) return null;\n528:   const prefix = result.stdout.trim();\n529:   if (prefix === '') return null;\n530:   return prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;\n531: }\n532: \n533: function isUnderExempt(path, prefix) {\n534:   if (prefix === null) return false;\n535:   const trimmed = path.endsWith('/') ? path.slice(0, -1) : path;\n536:   return trimmed === prefix || trimmed.startsWith(`${prefix}/`);\n537: }\n538: \n539: function dirtyPaths(paths, prefix) {\n540:   return [...paths.keys()]\n541:     .filter((path) => !isUnderExempt(path, prefix))\n542:     .sort();\n543: }\n544: \n545: // A path counts as changed when its status code differs, so a file that was already\n546: // dirty before the run is never reverted on another worker's behalf.\n547: function changedPaths(before, after) {\n548:   const changed = [];\n549:   for (const [path, code] of after) {\n550:     if (before.get(path) !== code) changed.push(path);\n551:   }\n552:   return changed.sort();\n553: }\n554: \n555: // The head and the stash are the two places another operator's git work can hide.\n556: function gitSnapshot() {\n557:   return {\n558:     head: gitText(['rev-parse', 'HEAD']).trim(),\n559:     stash: gitText(['stash', 'list']),\n560:   };\n561: }\n562: \n563: // A remote is the one piece of git state a turn could use to reach outside the\n564: // checkout, so its presence is read rather than the branch's tracking state.\n565: function remoteNames() {\n566:   return gitText(['remote'])\n567:     .split('\\n')\n568:     .map((name) => name.trim())\n569:     .filter((name) => name !== '');\n570: }\n571: \n572: function pathIsTracked(path) {\n573:   return git(['ls-files', '--error-unmatch', '--', path]).status === 0;\n574: }\n575: \n576: function restorePath(path) {\n577:   if (pathIsTracked(path)) {\n578:     const result = git(['checkout', '--', path]);\n579:     return result.status === 0 ? null : `checkout ${path}: ${(result.stderr ?? '').trim()}`;\n580:   }\n581:   try {\n582:     rmSync(resolve(REPO_ROOT, path), { recursive: true, force: true });\n583:     return null;\n584:   } catch (error) {\n585:     return `delete ${path}: ${error.message}`;\n586:   }\n587: }\n588: \n589: function restorePaths(paths) {\n590:   const failures = [];\n591:   for (const path of paths) {\n592:     const failure = restorePath(path);\n593:     if (failure !== null) failures.push(failure);\n594:   }\n595:   return failures;\n596: }\n597: \n598: // ───────────────────────────────────────────────────────────────\n599: // Prompt source and run log\n600: // ───────────────────────────────────────────────────────────────\n601: \n602: /** A refusal the operator can act on without a stack trace. */\n603: class Refusal extends Error {\n604:   constructor(code, message) {\n605:     super(message);\n606:     this.code = code;\n607:   }\n608: }\n609: \n610: // A row is read one line at a time so a holdout row is refused before its prompt\n611: // reaches a child process or the run log. Discarding the text after reading it\n612: // would still have put an unmeasured prompt in the arm's path. The guard sits in\n613: // the lookup itself, so a run, a selection and a listing all answer a refused id\n614: // the same way instead of one of them getting there through a usage error.\n615: function findRow(rowId) {\n616:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n617:     if (line.trim() === '') continue;\n618:     const row = JSON.parse(line);\n619:     if (row.id !== rowId) continue;\n620:     if (row.split === 'holdout') {\n621:       throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n622:     }\n623:     return row;\n624:   }\n625:   throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n626: }\n627: \n628: function lookupPrompt(rowId) {\n629:   const row = findRow(rowId);\n630:   if (typeof row.prompt !== 'string' || row.prompt === '') {\n631:     throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n632:   }\n633:   return { prompt: row.prompt };\n634: }\n635: \n636: // Selection reads the labels only, so no picker walks a structure that carries a\n637: // prompt.\n638: function rowLabels() {\n639:   const labels = [];\n640:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n641:     if (line.trim() === '') continue;\n642:     const row = JSON.parse(line);\n643:     labels.push({ id: row.id, split: row.split, rowType: row.row_type, policy: row.expected_policy });\n644:   }\n645:   return labels;\n646: }\n647: \n648: // The log is written after the closing snapshot, so the file the runner creates is\n649: // never a changed path it then tries to restore.\n650: function appendRunLine(outPath, line) {\n651:   mkdirSync(dirname(outPath), { recursive: true });\n652:   appendFileSync(outPath, `${JSON.stringify(line)}\\n`, 'utf8');\n653: }\n654: \n655: // ───────────────────────────────────────────────────────────────\n656: // Prompt sets\n657: // ───────────────────────────────────────────────────────────────\n658: //\n659: // A set is a whole arm's worth of prompts, so naming one is how a run says which\n660: // question it answers. The chat set is drawn from the measured corpus and shows\n661: // where a command is started, offered or declined. The started-command set is\n662: // fixed instead, because it asks something the corpus cannot: once a heavy\n663: // workflow begins, does it take its lock before its first write. Each command it\n664: // covers appears twice, as a plain request and with the autonomous mode spelled\n665: // out, so a start the model chose is told apart from one it was told to make. The\n666: // two loops are capped at one iteration, because a deeper run buries the first\n667: // write under the later ones the run made.\n668: \n669: // The chat set is as wide as one arm can afford on every measured runtime and no\n670: // wider: enough start rows to show a rate, the offered and declined policies in\n671: // proportion, and a safety probe for each must-not-start shape.\n672: const CHAT_PICKS = Object.freeze([\n673:   { policy: 'start', count: 8 },\n674:   { policy: 'run', count: 4 },\n675:   { policy: 'ask', count: 4 },\n676: ]);\n677: const CHAT_PROBE_COUNT = 8;\n678: \n679: // A short bucket means the corpus changed under the set, and a rate over fewer\n680: // rows than the arm claims would misreport the phase. It stops here instead.\n681: function sortedPick(labels, count, bucket) {\n682:   const ids = labels.map((label) => label.id).sort().slice(0, count);\n683:   if (ids.length < count) {\n684:     throw new Refusal('set_short', `${bucket}: expected ${count} rows, found ${ids.length}`);\n685:   }\n686:   return ids;\n687: }\n688: \n689: function chatRowIds() {\n690:   const labels = rowLabels();\n691:   const plain = labels.filter((label) => label.split === 'tune' && label.rowType === 'plain');\n692:   const ids = [];\n693:   for (const pick of CHAT_PICKS) {\n694:     const bucket = plain.filter((label) => label.policy === pick.policy);\n695:     ids.push(...sortedPick(bucket, pick.count, `chat ${pick.policy}`));\n696:   }\n697:   const probes = labels.filter((label) => label.rowType === 'must-not-start');\n698:   ids.push(...sortedPick(probes, CHAT_PROBE_COUNT, 'chat must-not-start'));\n699:   return ids;\n700: }\n701: \n702: // The fixture sits beside the run log, so the log and the folder it measured\n703: // travel together and an operator can move both without editing a prompt.\n704: const G2_SET = 'g2';\n705: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n706: const FIXTURE_TOKEN = '{fixture}';\n707: \n708: const G2_ROWS = Object.freeze([\n709:   {\n710:     id: 'g2-deep-research-ask',\n711:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n712:   },\n713:   {\n714:     id: 'g2-deep-research-typed',\n715:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n716:   },\n717:   {\n718:     id: 'g2-deep-review-ask',\n719:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n720:   },\n721:   {\n722:     id: 'g2-deep-review-typed',\n723:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n724:   },\n725:   {\n726:     id: 'g2-speckit-complete-ask',\n727:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n728:   },\n729:   {\n730:     id: 'g2-speckit-complete-typed',\n731:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n732:   },\n733: ]);\n734: \n735: const G2_PROMPTS = new Map(G2_ROWS.map((row) => [row.id, row.prompt]));\n736: \n737: const SETS = Object.freeze({\n738:   chat: chatRowIds,\n739:   [G2_SET]: () => G2_ROWS.map((row) => row.id),\n740: });\n741: \n742: // `--list` and `--set` name the same thing. One prints the rows and the other\n743: // runs them, and an invocation that asks for both lists what it would run.\n744: function setNameOf(options) {\n745:   return options.list === null ? options.set : options.list;\n746: }\n747: \n748: function setRowIds(setName) {\n749:   if (!has(SETS, setName)) throw new UsageError(`unknown set: ${setName}`);\n750:   return SETS[setName]();\n751: }\n752: \n753: // A fixed prompt carries its own text, so its id needs no corpus row. Every other\n754: // id passes the lookup a run would use, so an id arriving on the command line and\n755: // nothing else is still checked before it can become an arm's row.\n756: function assertRunnable(rowId) {\n757:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n758:   return rowId;\n759: }\n760: \n761: function selectedRowIds(options) {\n762:   const setName = setNameOf(options);\n763:   const fromSet = setName === null ? [] : setRowIds(setName);\n764:   const explicit = options.rowIds.map(assertRunnable);\n765:   return [...new Set([...fromSet, ...explicit])];\n766: }\n767: \n768: function fixtureDir(options) {\n769:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n770: }\n771: \n772: // A placeholder keeps the fixed prompts free of a path that only exists on the\n773: // machine the arm runs on.\n774: function promptFor(rowId, fixture) {\n775:   const fixed = G2_PROMPTS.get(rowId);\n776:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n777:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n778: }\n779: \n780: // The cap belongs to the prompt rather than to the invocation, so an arm that\n781: // mixes the two sets still gives a started workflow the time it needs.\n782: function capForRow(rowId) {\n783:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n784: }\n785: \n786: // ───────────────────────────────────────────────────────────────\n787: // One turn\n788: // ───────────────────────────────────────────────────────────────\n789: \n790: // A dispatched worker's marker makes a CLI answer as a child session, and a child\n791: // session is not the chat start an arm measures. The rest of the environment stays,\n792: // so each CLI finds its own home, account and route.\n793: //\n794: // The network credentials are the exception, because a turn that reaches a forge\n795: // with the operator's identity is a side effect no transcript can undo. The token\n796: // variables go, the GitHub CLI is pointed at an empty folder beside the run log\n797: // rather than the operator's authenticated one, and an empty credential helper\n798: // replaces whatever a global git config would have offered. A missing credential\n799: // then fails at once instead of waiting on a terminal nobody is sitting at.\n800: const GITHUB_TOKEN_VARS = Object.freeze(['GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN']);\n801: \n802: const GIT_CREDENTIAL_OVERRIDES = Object.freeze({\n803:   GIT_CONFIG_COUNT: '1',\n804:   GIT_CONFIG_KEY_0: 'credential.helper',\n805:   GIT_CONFIG_VALUE_0: '',\n806: });\n807: \n808: // The empty folder lives beside the run log, so a run leaves its own directory\n809: // behind instead of a path in the operator's home that the next run inherits.\n810: function ghConfigDir(outPath) {\n811:   return join(dirname(outPath), 'gh-config-empty');\n812: }\n813: \n814: function childEnv(ghConfig) {\n815:   const env = { ...process.env };\n816:   delete env.AI_SESSION_CHILD;\n817:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n818:   env.GH_CONFIG_DIR = ghConfig;\n819:   env.GIT_TERMINAL_PROMPT = '0';\n820:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n821:   return env;\n822: }\n823: \n824: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n825:   return new Promise((settle) => {\n826:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n827:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n828:     // input nobody types until the cap runs out into an empty transcript.\n829:     const child = spawn(runtime.command, argv, {\n830:       cwd: REPO_ROOT,\n831:       env: childEnv(ghConfig),\n832:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n833:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n834:       // A chat turn still running after its cap is stuck, while a started workflow\n835:       // legitimately needs the longer one. The prompt decides which it gets.\n836:       timeout: capMs,\n837:     });\n838:     // The prompt is written and the stream closed at once, so a CLI that reads until\n839:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n840:     // broken pipe behind, and that write error is the CLI's failure to report rather\n841:     // than an uncaught error that would end the run early.\n842:     if (child.stdin !== null) {\n843:       child.stdin.on('error', () => {});\n844:       child.stdin.end(prompt);\n845:     }\n846:     const locator = streamLocator(runtime.locator.field ?? null);\n847:     // The turn's own output is still shown, and the locator is read out of the\n848:     // same bytes, so watching a run and recording it never diverge.\n849:     child.stdout.setEncoding('utf8');\n850:     child.stdout.on('data', (chunk) => {\n851:       locator.push(chunk);\n852:       process.stdout.write(chunk);\n853:     });\n854:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n855:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n856:   });\n857: }\n858: \n859: // ───────────────────────────────────────────────────────────────\n860: // CLI\n861: // ───────────────────────────────────────────────────────────────\n862: \n863: class UsageError extends Error {}\n864: \n865: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n866: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n867: const SAMPLE_SESSION_ID = 'sample-session-id';\n868: \n869: // An arm label decides how a later scorer groups a whole log, so a typo would\n870: // quietly invent a third arm. The set is closed for that reason.\n871: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n872: \n873: // The pre-change arm is the default because it is the one that can run before the\n874: // brief lands. A post-change run has to say which arm it belongs to. The\n875: // started-command set carries its own arm, so a run of it cannot land in the\n876: // change comparison by omission.\n877: const DEFAULT_ARM = 'pre';\n878: \n879: const USAGE = [\n880:   `usage: ${SCRIPT_NAME} --print-argv <runtime>`,\n881:   `       ${SCRIPT_NAME} --list <set>`,\n882:   `       ${SCRIPT_NAME} --runtime <runtime> (--set <set> | --row-id <id>...)`,\n883:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n884:   `       ${SCRIPT_NAME} --backfill <run-log> --out <new-log>`,\n885: ].join('\\n');\n886: \n887: function resolveRuntime(name) {\n888:   if (has(RUNTIMES, name)) {\n889:     return RUNTIMES[name];\n890:   }\n891:   if (has(NOT_MEASURED, name)) {\n892:     throw new UsageError(`runtime ${name} is not measured: ${NOT_MEASURED[name]}`);\n893:   }\n894:   throw new UsageError(`unknown runtime: ${name}`);\n895: }\n896: \n897: function valueAfter(argv, index, flag) {\n898:   const value = argv[index];\n899:   if (typeof value !== 'string' || value.startsWith('--')) {\n900:     throw new UsageError(`${flag}: a value is required`);\n901:   }\n902:   return value;\n903: }\n904: \n905: // A set that has its own arm names it, so a started-command run cannot join the\n906: // change comparison because nobody passed `--arm`.\n907: function armFor(options) {\n908:   if (options.arm !== null) return options.arm;\n909:   return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n910: }\n911: \n912: function parseOptions(argv) {\n913:   const options = {\n914:     printArgv: null,\n915:     list: null,\n916:     set: null,\n917:     runtime: null,\n918:     rowIds: [],\n919:     arm: null,\n920:     out: null,\n921:     backfill: null,\n922:     fixture: null,\n923:     dryRun: false,\n924:   };\n925:   for (let index = 0; index < argv.length; index += 1) {\n926:     const token = argv[index];\n927:     if (token === '--print-argv') {\n928:       index += 1;\n929:       options.printArgv = valueAfter(argv, index, '--print-argv');\n930:     } else if (token === '--list') {\n931:       index += 1;\n932:       options.list = valueAfter(argv, index, '--list');\n933:     } else if (token === '--set') {\n934:       index += 1;\n935:       options.set = valueAfter(argv, index, '--set');\n936:     } else if (token === '--runtime') {\n937:       index += 1;\n938:       options.runtime = valueAfter(argv, index, '--runtime');\n939:     } else if (token === '--row-id') {\n940:       index += 1;\n941:       options.rowIds.push(valueAfter(argv, index, '--row-id'));\n942:     } else if (token === '--arm') {\n943:       index += 1;\n944:       const arm = valueAfter(argv, index, '--arm');\n945:       if (!ARMS.includes(arm)) {\n946:         throw new UsageError(`--arm: expected one of ${ARMS.join(', ')}`);\n947:       }\n948:       options.arm = arm;\n949:     } else if (token === '--out') {\n950:       index += 1;\n951:       options.out = resolve(valueAfter(argv, index, '--out'));\n952:     } else if (token === '--backfill') {\n953:       index += 1;\n954:       options.backfill = resolve(valueAfter(argv, index, '--backfill'));\n955:     } else if (token === '--fixture') {\n956:       index += 1;\n957:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n958:     } else if (token === '--dry-run') {\n959:       options.dryRun = true;\n960:     } else {\n961:       throw new UsageError(`unknown option: ${token}`);\n962:     }\n963:   }\n964:   return options;\n965: }\n966: \n967: // One mode per invocation. Asking for an argv and a run at once would hide which\n968: // one the operator meant, and a run with no log has nowhere to record its proof.\n969: function selectMode(options) {\n970:   if (options.printArgv !== null) return 'print-argv';\n971:   if (options.list !== null) return 'list';\n972:   if (options.backfill !== null) {\n973:     if (options.out === null) throw new UsageError('--out is required');\n974:     return 'backfill';\n975:   }\n976:   if (options.runtime === null) throw new UsageError('--runtime is required');\n977:   if (options.set === null && options.rowIds.length === 0) {\n978:     throw new UsageError('--set or --row-id is required');\n979:   }\n980:   if (options.out === null) throw new UsageError('--out is required');\n981:   return 'run';\n982: }\n983: \n984: function writeJson(value) {\n985:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n986: }\n987: \n988: function writeRowIds(rowIds) {\n989:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n990: }\n991: \n992: function writeArgv(runtimeName) {\n993:   const runtime = resolveRuntime(runtimeName);\n994:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n995:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n996:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n997:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n998:   }\n999:   writeJson(argv);\n1000: }\n1001: \n1002: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n1003: // fires, so a broken precondition never spends another model call.\n1004: async function runTurn(job, options, exempt, isFirst) {\n1005:   const before = { status: statusPaths(), ...gitSnapshot() };\n1006:   if (isFirst) {\n1007:     // A live turn can push, so it may only start where there is no remote to push\n1008:     // to. A dry run spawns nothing and keeps running in this checkout.\n1009:     if (!options.dryRun) {\n1010:       const remotes = remoteNames();\n1011:       if (remotes.length > 0) {\n1012:         return {\n1013:           status: EXIT_REFUSED,\n1014:           refusal: { ok: false, code: 'remote_present', remotes },\n1015:         };\n1016:       }\n1017:     }\n1018:     const dirty = dirtyPaths(before.status, exempt);\n1019:     if (dirty.length > 0) {\n1020:       return {\n1021:         status: EXIT_REFUSED,\n1022:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n1023:       };\n1024:     }\n1025:   }\n1026: \n1027:   const sessionId = randomUUID();\n1028:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1029:   // A runtime that names its session only in its own store is bracketed by a\n1030:   // listing, and the entry the turn added is the session it wrote. A dry run\n1031:   // starts no CLI, so it has nothing to list.\n1032:   const listed = !options.dryRun && listsStore(job.runtime);\n1033:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1034:   const turn = options.dryRun\n1035:     ? { exit: null, error: null, streamId: null }\n1036:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1037:   const reportedId = listed\n1038:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1039:     : turn.streamId;\n1040: \n1041:   const after = { status: statusPaths(), ...gitSnapshot() };\n1042:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1043:   const changed = changedPaths(before.status, after.status);\n1044:   // The locator is kept in hand because the brief reader opens the same session\n1045:   // the line records, and resolving it twice could name a different file.\n1046:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1047:   const line = {\n1048:     runtime: job.runtimeName,\n1049:     rowId: job.rowId,\n1050:     arm: options.arm,\n1051:     locator,\n1052:     exit: turn.exit,\n1053:     changedPaths: changed,\n1054:   };\n1055: \n1056:   if (headMoved) {\n1057:     // The worktree the restore was written for is gone. Restoring now could discard\n1058:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1059:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1060:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1061:   }\n1062: \n1063:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1064:   // honestly report as left as found.\n1065:   const restored = options.dryRun ? changed.length === 0 : restorePaths(changed).length === 0;\n1066:   // The head the reader saw is the only place the offer was named, and not every\n1067:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1068:   // replays it, which lets an operator read the offer without paying for a model\n1069:   // call, while the brief stays `unknown` because no session exists to read.\n1070:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1071:   const delivered = options.dryRun\n1072:     ? 'unknown'\n1073:     : await briefDelivered({ runtime: job.runtimeName, locator });\n1074:   appendRunLine(options.out, {\n1075:     ...line,\n1076:     offeredCommand: offer.offeredCommand,\n1077:     offeredPolicy: offer.offeredPolicy,\n1078:     briefDelivered: delivered,\n1079:     restored,\n1080:   });\n1081: \n1082:   if (turn.error !== null) {\n1083:     const detail = turn.error.message;\n1084:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1085:   }\n1086:   if (!restored) {\n1087:     return { status: 1, refusal: { ok: false, code: 'restore_failed', rowId: job.rowId, paths: changed } };\n1088:   }\n1089:   return { status: 0, refusal: null };\n1090: }\n1091: \n1092: async function runArm(options, rowIds) {\n1093:   const exempt = exemptPrefix(dirname(options.out));\n1094:   const runtime = resolveRuntime(options.runtime);\n1095:   const fixture = fixtureDir(options);\n1096:   // Created once before the first snapshot, so the folder a turn needs is never\n1097:   // read back as a path the turn itself changed.\n1098:   const ghConfig = ghConfigDir(options.out);\n1099:   mkdirSync(ghConfig, { recursive: true });\n1100:   for (let index = 0; index < rowIds.length; index += 1) {\n1101:     const rowId = rowIds[index];\n1102:     const prompt = promptFor(rowId, fixture);\n1103:     const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n1104:     const result = await runTurn(job, options, exempt, index === 0);\n1105:     if (result.refusal !== null) writeJson(result.refusal);\n1106:     if (result.status !== 0) return result.status;\n1107:   }\n1108:   return 0;\n1109: }\n1110: \n1111: // A finished log is rewritten from its recorded lines alone, and the fixture folder\n1112: // still sits beside the log the arm wrote. The corpus lookup runs before the first\n1113: // line is written, so a row the dataset guard refuses leaves no output file behind.\n1114: async function backfillLog(options) {\n1115:   const fixture = resolve(dirname(options.backfill), G2_FIXTURE_DIRNAME);\n1116:   const result = await backfillRunLog({\n1117:     inPath: options.backfill,\n1118:     outPath: options.out,\n1119:     promptFor: (rowId) => promptFor(rowId, fixture),\n1120:   });\n1121:   writeJson(result);\n1122:   return result.ok ? 0 : EXIT_REFUSED;\n1123: }\n1124: \n1125: async function main(argv) {\n1126:   try {\n1127:     const options = parseOptions(argv);\n1128:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1129:     // answered by that guard rather than by whichever usage check would run first.\n1130:     const rowIds = selectedRowIds(options);\n1131:     const mode = selectMode(options);\n1132:     options.arm = armFor(options);\n1133: \n1134:     if (mode === 'print-argv') {\n1135:       writeArgv(options.printArgv);\n1136:       return 0;\n1137:     }\n1138:     if (mode === 'list') {\n1139:       writeRowIds(rowIds);\n1140:       return 0;\n1141:     }\n1142:     if (mode === 'backfill') {\n1143:       return await backfillLog(options);\n1144:     }\n1145:     return await runArm(options, rowIds);\n1146:   } catch (error) {\n1147:     if (error instanceof UsageError) {\n1148:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1149:       return EXIT_REFUSED;\n1150:     }\n1151:     if (error instanceof Refusal) {\n1152:       writeJson({ ok: false, code: error.code, detail: error.message });\n1153:       return EXIT_REFUSED;\n1154:     }\n1155:     throw error;\n1156:   }\n1157: }\n1158: \n1159: try {\n1160:   process.exitCode = await main(process.argv.slice(2));\n1161: } catch (error) {\n1162:   if (error instanceof UsageError) {\n1163:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1164:     process.exitCode = EXIT_REFUSED;\n1165:   } else {\n1166:     throw error;\n1167:   }\n1168: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1-1168\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: One-Turn Command Behaviour Runner\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // Command surfacing is only proven by a turn that starts the way an operator\n6: // starts it: one prompt, the real CLI, and a session id the transcript reader\n7: // can open afterwards. Every runtime clears a different non-interactive hurdle,\n8: // so each argv lives in one table instead of in ad-hoc spawn calls.\n9: //\n10: // Three properties decide whether a run counts as evidence at all:\n11: //\n12: //   - Each builder pre-approves the tools its set needs. A permission prompt in\n13: //     a non-interactive turn has nobody to answer it, and the refusal it leaves\n14: //     behind is indistinguishable downstream from a model that chose to write\n15: //     nothing. Without this, every must-not-start row passes for the wrong\n16: //     reason.\n17: //   - The prompt travels in argv where the CLI takes a positional prompt, and on\n18: //     stdin where the CLI reads it there. Feeding a prompt to the wrong channel\n19: //     measures the argument parser rather than the model.\n20: //   - A turn is capped by the prompt it runs. A chat turn still running after\n21: //     five minutes is stuck, while a started heavy workflow can legitimately work\n22: //     for fifteen. One cap for both would either cut real work short or wait out\n23: //     a dead process.\n24: //\n25: // A live turn runs in this worktree, so the runner also owns its clean-up. The\n26: // worktree is refused before the first prompt when it holds anything outside the\n27: // run log's own folder, because the restore that follows a turn is only safe when\n28: // nobody else has an uncommitted edit in reach. Every prompt is bracketed by a\n29: // snapshot, and whatever the turn changed is restored or deleted. A commit or a\n30: // stash appearing mid-turn is work that is not the runner's to throw away, so that\n31: // run stops with its changed paths listed and no restore.\n32: //\n33: // A live turn is also a turn that can reach the network, so the runner takes the\n34: // reach away before the model has it. The child gets none of the GitHub tokens, an\n35: // empty GitHub CLI config, no credential helper and no terminal to be prompted on.\n36: // A live arm additionally refuses to start in a checkout that has any git remote,\n37: // because a command wrongly started there could push, tag or publish something the\n38: // arm cannot take back. A dry run spawns nothing, so it keeps running in this\n39: // checkout and its guards stay about file paths alone.\n40: //\n41: // Usage:\n42: //   node run-command-behaviour.mjs --print-argv <runtime>\n43: //   node run-command-behaviour.mjs --list <set>\n44: //   node run-command-behaviour.mjs --runtime <runtime> (--set <set> | --row-id <id>...)\n45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n46: //   node run-command-behaviour.mjs --backfill <run-log> --out <new-log>\n47: \n48: import { appendFileSync, mkdirSync, readdirSync, readFileSync, realpathSync, rmSync } from 'node:fs';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { homedir } from 'node:os';\n51: import { randomUUID } from 'node:crypto';\n52: import { spawn, spawnSync } from 'node:child_process';\n53: import { fileURLToPath } from 'node:url';\n54: import { dshProjectKey, dshStoreRoot } from '../../../../../hooks/shared/session-readers/dsh.mjs';\n55: import { backfillRunLog, briefDelivered, replayOffer } from './command-offer.mjs';\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const REPO_ROOT = resolve(HERE, '../../../../../..');\n59: const DSH_PATCH_DIR = resolve(REPO_ROOT, '.dsh/patches');\n60: // A stored session is found by its id plus the directory the turn ran in, and the\n61: // scorer reads it back from another checkout, so the locator records the resolved\n62: // directory instead of letting each reader compare the id against its own root.\n63: const PROJECT_DIR = realpathSync(REPO_ROOT);\n64: const PROMPTS_PATH = resolve(HERE, 'command-prompts.jsonl');\n65: \n66: const EXIT_REFUSED = 2;\n67: const EXIT_HEAD_MOVED = 3;\n68: \n69: // Keyed by prompt kind rather than by set name, because one arm can hold rows\n70: // from either set and the cap has to follow the row, not the invocation.\n71: const CAP_MS = Object.freeze({\n72:   chat: 300_000,\n73:   started: 900_000,\n74: });\n75: \n76: const CLAUDE_MODEL = 'claude-sonnet-5-5';\n77: const CODEX_MODEL = 'gpt-6-luna';\n78: // The variant rides the model string, because `opencode run` has no flag for it.\n79: const OPENCODE_MODEL = 'llmgateway/deepseek-v4.1-flash-1017#max';\n80: const PI_MODEL = 'llmgateway/deepseek-v4.1-flash-1017';\n81: const DEVIN_MODEL = 'swe-2-max';\n82: const DSH_MODEL = 'deepseek-v4.1-flash-1017';\n83: \n84: // Runtimes the phase reports as not measured, with the reason a run would be\n85: // wasted work rather than evidence. Cursor's reader never leaves gated, so its\n86: // transcript could not be scored even if the turn ran.\n87: const NOT_MEASURED = Object.freeze({\n88:   cursor: 'its session reader is gated, so no produced transcript can be scored',\n89: });\n90: \n91: function has(object, key) {\n92:   return Object.prototype.hasOwnProperty.call(object, key);\n93: }\n94: \n95: // ───────────────────────────────────────────────────────────────\n96: // Runtime argv table\n97: // ───────────────────────────────────────────────────────────────\n98: \n99: const RUNTIMES = {\n100:   claude: {\n101:     command: 'claude',\n102:     model: CLAUDE_MODEL,\n103:     promptOnStdin: false,\n104:     // stream-json writes one JSON object per line and every one of them carries\n105:     // the session id the transcript is stored under.\n106:     locator: { kind: 'stream', field: 'session_id' },\n107:     // The reader opens a transcript by id plus its own path, and Claude Code names\n108:     // the file after the session inside a folder per working directory.\n109:     findTranscript: claudeTranscriptPath,\n110:     buildArgv: ({ prompt }) => [\n111:       '-p',\n112:       prompt,\n113:       '--model',\n114:       CLAUDE_MODEL,\n115:       // stream-json is the only output format that carries the session id the\n116:       // reader needs after the turn ends.\n117:       '--output-format',\n118:       'stream-json',\n119:       '--verbose',\n120:       // Print mode has nobody to answer an approval prompt, and the default mode\n121:       // both denies writes and refuses shell commands, which is exactly the\n122:       // behaviour an ask-row test must be free to observe.\n123:       '--permission-mode',\n124:       'bypassPermissions',\n125:     ],\n126:   },\n127:   codex: {\n128:     command: 'codex',\n129:     model: CODEX_MODEL,\n130:     promptOnStdin: true,\n131:     // The run opens with an event naming its thread, and the rollout file is\n132:     // named after that thread id.\n133:     locator: { kind: 'stream', field: 'thread_id' },\n134:     // The rollout file is named after the thread id the stream reported, so the id\n135:     // alone leads back to it once the store has been searched.\n136:     findTranscript: codexTranscriptPath,\n137:     buildArgv: () => [\n138:       'exec',\n139:       // The JSON event stream is how a turn reports its thread id.\n140:       '--json',\n141:       '--model',\n142:       CODEX_MODEL,\n143:       '-c',\n144:       'model_reasoning_effort=medium',\n145:       '-c',\n146:       'service_tier=fast',\n147:       // A headless run cannot answer an approval prompt, and `exec` defaults to a\n148:       // read-only sandbox that would silently swallow every write.\n149:       '-c',\n150:       'approval_policy=never',\n151:       '--sandbox',\n152:       'workspace-write',\n153:       '-',\n154:     ],\n155:   },\n156:   opencode: {\n157:     command: 'opencode',\n158:     model: OPENCODE_MODEL,\n159:     promptOnStdin: false,\n160:     // The turn's own events carry the id of the session it created.\n161:     locator: { kind: 'stream', field: 'sessionID' },\n162:     buildArgv: ({ prompt }) => [\n163:       // `opencode run` takes no --dir, and the child already starts in the\n164:       // checkout, so passing the directory a second time would only fail.\n165:       'run',\n166:       // Without this the turn is handed to the operator's long-running background\n167:       // service, whose tools run with that service's environment. The hardened\n168:       // environment this runner builds would then never reach a tool call.\n169:       '--standalone',\n170:       '--model',\n171:       OPENCODE_MODEL,\n172:       '--format',\n173:       'json',\n174:       // Auto-approve everything not explicitly denied. A run that stalls on a\n175:       // permission prompt reads as a model that declined to act.\n176:       '--auto',\n177:       prompt,\n178:     ],\n179:   },\n180:   pi: {\n181:     command: 'pi',\n182:     model: PI_MODEL,\n183:     promptOnStdin: false,\n184:     // Print mode never reports the session it wrote, so the runner mints the id\n185:     // and passes it on the command line instead of recovering it from the stream.\n186:     locator: { kind: 'runner' },\n187:     buildArgv: ({ prompt, sessionId }) => [\n188:       '-p',\n189:       // Without it a non-interactive Pi probes the network on startup and can\n190:       // hang before it ever reads the prompt.\n191:       '--offline',\n192:       '--model',\n193:       PI_MODEL,\n194:       // Without a minted id the log would have to be guessed from whatever\n195:       // file is newest, which can open a neighbouring turn's transcript.\n196:       '--session-id',\n197:       sessionId,\n198:       prompt,\n199:     ],\n200:   },\n201:   devin: {\n202:     command: 'devin',\n203:     model: DEVIN_MODEL,\n204:     promptOnStdin: false,\n205:     // A Devin turn keeps its session in a store its own output does not name, so\n206:     // the id comes from the listing of the directory the turn ran in.\n207:     locator: { kind: 'listing', args: ['list', '--format', 'json'] },\n208:     buildArgv: ({ prompt }) => [\n209:       '-p',\n210:       '--model',\n211:       DEVIN_MODEL,\n212:       // Under `accept-edits` every tool call that wants confirmation is refused,\n213:       // so a headless turn explores its whole budget and writes nothing.\n214:       '--permission-mode',\n215:       'dangerous',\n216:       // A fresh checkout has never been trusted interactively, and print mode has\n217:       // nobody to answer the trust prompt, so the turn would refuse to start.\n218:       '--respect-workspace-trust',\n219:       'false',\n220:       // No `--sandbox` here. That flag forces a permission mode that ignores\n221:       // `dangerous` and rejects every write in print mode, so a turn would write\n222:       // nothing and read as a model that declined. Containment comes from the\n223:       // arena instead.\n224:       // The separator keeps a prompt that opens with a dash from parsing as a flag.\n225:       '--',\n226:       prompt,\n227:     ],\n228:   },\n229:   dsh: {\n230:     command: 'dsh',\n231:     // dsh takes no model flag at all. The roster route patch decides the model,\n232:     // and this table pins the verified LLM Gateway route.\n233:     model: DSH_MODEL,\n234:     promptOnStdin: true,\n235:     // The harness names the session itself and refuses an id it never created,\n236:     // so the turn's id is recovered from the store folder its log lands in.\n237:     locator: { kind: 'store', list: dshSessionIds },\n238:     buildArgv: () => [\n239:       '--profile',\n240:       'headless',\n241:       '--patch',\n242:       resolve(DSH_PATCH_DIR, 'route-llmgateway-deepseek.patch.yml'),\n243:       // No lineage patch: it marks the run as a fan-out leaf, and the repo\n244:       // guards keep the prompt advisor off for a leaf. A chat turn has to\n245:       // receive the brief like a person's session would.\n246:       '--patch',\n247:       resolve(DSH_PATCH_DIR, 'guards.patch.yml'),\n248:       '--json',\n249:       '--permission-mode',\n250:       'workspace-write',\n251:       // Approvals default to ask, and a headless turn has nobody to answer.\n252:       '--approval-policy',\n253:       'never',\n254:       // The dash takes the prompt from stdin, which is the channel a headless\n255:       // run reads, and keeps a prompt that opens with one from parsing as a\n256:       // flag.\n257:       '-',\n258:     ],\n259:   },\n260: };\n261: \n262: // ───────────────────────────────────────────────────────────────\n263: // Session locator\n264: // ───────────────────────────────────────────────────────────────\n265: //\n266: // A run log is only evidence if it leads back to the exact transcript the turn\n267: // wrote, and each runtime exposes that handle in its own way. Three sources\n268: // exist: an id the CLI reports after the turn, either in its output or in the\n269: // session listing it keeps, an id the runner hands the CLI before it starts, or\n270: // no recorded source at all, which the log states rather than filling with the\n271: // newest file in the store.\n272: \n273: // Output arrives in chunks that cut a line in half, so a line is parsed only\n274: // once its newline has come through. Parsing stops at the first match, because\n275: // the id never changes within one turn.\n276: function streamLocator(field) {\n277:   let pending = '';\n278:   let captured = null;\n279:   return {\n280:     push(chunk) {\n281:       if (field === null || captured !== null) return;\n282:       pending += chunk;\n283:       const lines = pending.split('\\n');\n284:       pending = lines.pop() ?? '';\n285:       for (const line of lines) {\n286:         captured = readId(line, field);\n287:         if (captured !== null) return;\n288:       }\n289:     },\n290:     value() {\n291:       if (captured === null && pending !== '') captured = readId(pending, field);\n292:       return captured;\n293:     },\n294:   };\n295: }\n296: \n297: // A line that is not a JSON object is ordinary chatter, so a parse failure says\n298: // this line holds no locator rather than that the run failed.\n299: function readId(line, field) {\n300:   let event;\n301:   try {\n302:     event = JSON.parse(line);\n303:   } catch {\n304:     return null;\n305:   }\n306:   const id = event?.[field];\n307:   return typeof id === 'string' && id !== '' ? id : null;\n308: }\n309: \n310: // A runtime that keeps its sessions in a store its output never names still lists\n311: // them for the directory the turn ran in, so two listings taken around a turn\n312: // reduce the store to a set difference. The listing runs in the child's\n313: // environment, because that is the store the turn itself wrote to.\n314: const LISTING_CAP_MS = 60_000;\n315: \n316: function listingIds(runtime, ghConfig) {\n317:   const source = runtime.locator;\n318:   if (source.kind !== 'listing') return null;\n319:   const result = spawnSync(runtime.command, source.args, {\n320:     cwd: REPO_ROOT,\n321:     env: childEnv(ghConfig),\n322:     encoding: 'utf8',\n323:     timeout: LISTING_CAP_MS,\n324:   });\n325:   if (result.error) return null;\n326:   return result.status === 0 ? listedSessionIds(result.stdout) : null;\n327: }\n328: \n329: // A runtime that names its session only in a store it owns is bracketed by two\n330: // readings of that store, and the entry the turn added is the session it wrote.\n331: function listsStore(runtime) {\n332:   return runtime.locator.kind === 'listing' || runtime.locator.kind === 'store';\n333: }\n334: \n335: // Only the reading differs between the store-backed forms: one CLI answers with\n336: // its own index and the other keeps one folder per session. Any other kind\n337: // names its session in the turn's output instead.\n338: function storeIds(runtime, ghConfig) {\n339:   return runtime.locator.kind === 'store'\n340:     ? runtime.locator.list()\n341:     : listingIds(runtime, ghConfig);\n342: }\n343: \n344: // The listing is a JSON array of session objects whose `id` field is the value\n345: // the CLI's own resume takes, so that field is the one that leads back to a\n346: // transcript. Any other shape names no session, which the caller reads as no id\n347: // rather than as a failed run.\n348: function listedSessionIds(text) {\n349:   let entries;\n350:   try {\n351:     entries = JSON.parse(text);\n352:   } catch {\n353:     return null;\n354:   }\n355:   if (!Array.isArray(entries)) return null;\n356:   return entries\n357:     .map((entry) => (entry !== null && typeof entry === 'object' ? entry.id : null))\n358:     .filter((id) => typeof id === 'string' && id !== '');\n359: }\n360: \n361: // A session another operator opened while the turn ran is not this turn's, and a\n362: // listing that reports none or several added entries has no id it can name with\n363: // confidence, so only a single added entry becomes the locator.\n364: function addedSessionId(before, after) {\n365:   if (before === null || after === null) return null;\n366:   const known = new Set(before);\n367:   const added = [...new Set(after.filter((id) => !known.has(id)))];\n368:   return added.length === 1 ? added[0] : null;\n369: }\n370: \n371: // DSH keeps its session logs under DSH_HOME, which an operator can move, so the\n372: // locator records the home the run used and the transcript stays findable from\n373: // the log alone.\n374: function dshHome() {\n375:   return process.env.DSH_HOME || join(homedir(), '.dsh');\n376: }\n377: \n378: // A DSH session is a folder named after its id under one folder per project the\n379: // harness keyed from the directory the turn ran in, and the turn's own output\n380: // never names that id. The store root comes from the reader so the folder listed\n381: // here is the folder the reader will search. A store the harness has not created\n382: // yet lists nothing, which is the same answer as a turn that wrote no session.\n383: function dshSessionIds() {\n384:   const store = join(dshStoreRoot(), dshProjectKey(PROJECT_DIR));\n385:   try {\n386:     return readdirSync(store, { withFileTypes: true })\n387:       .filter((entry) => entry.isDirectory())\n388:       .map((entry) => entry.name);\n389:   } catch {\n390:     return [];\n391:   }\n392: }\n393: \n394: // A store folder is the CLI's to lay out, so the walk follows the folders it\n395: // creates and matches on the file name instead of predicting a path. A store that\n396: // is missing or unreadable names no transcript, which is the same answer as a turn\n397: // that wrote none rather than a reason to fail the run.\n398: function findTranscriptFiles(dir, matches, depth) {\n399:   let entries;\n400:   try {\n401:     entries = readdirSync(dir, { withFileTypes: true });\n402:   } catch {\n403:     return [];\n404:   }\n405:   const found = [];\n406:   for (const entry of entries) {\n407:     if (entry.isFile() && matches(entry.name)) {\n408:       found.push(join(dir, entry.name));\n409:     } else if (entry.isDirectory() && depth > 0) {\n410:       found.push(...findTranscriptFiles(join(dir, entry.name), matches, depth - 1));\n411:     }\n412:   }\n413:   return found;\n414: }\n415: \n416: // One match is the turn's own transcript, while two leave the locator without a\n417: // path because choosing between them could score a neighbouring turn under this\n418: // row. The path is resolved so a log written from another checkout still opens.\n419: function storedTranscriptPath(root, matches, depth = Infinity) {\n420:   const found = findTranscriptFiles(root, matches, depth);\n421:   return found.length === 1 ? resolve(found[0]) : null;\n422: }\n423: \n424: // Claude Code keeps one folder per working directory and writes each transcript\n425: // directly inside it, so one level below the store is the whole of the search. A\n426: // helper transcript sits deeper inside `subagents/`, which belongs to another turn\n427: // and which the reader refuses.\n428: function claudeTranscriptPath(sessionId) {\n429:   const store = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'), 'projects');\n430:   return storedTranscriptPath(store, (name) => name === `${sessionId}.jsonl`, 1);\n431: }\n432: \n433: // A Codex rollout file is named after its start time and ends with the thread id,\n434: // and it sits under a date folder whose depth is the CLI's to choose, so the whole\n435: // store is searched and the id is a suffix of the name.\n436: function codexTranscriptPath(sessionId) {\n437:   const store = join(process.env.CODEX_HOME || join(homedir(), '.codex'), 'sessions');\n438:   return storedTranscriptPath(store, (name) => name.endsWith(`-${sessionId}.jsonl`));\n439: }\n440: \n441: // A store listing that added no single entry leaves the id out rather than\n442: // naming a guess that would score a neighbouring turn under this row. The home\n443: // stays on the record so the store the run wrote to is findable from the log\n444: // alone.\n445: function storeLocator(reportedId) {\n446:   const store = { dshHome: dshHome(), projectDir: PROJECT_DIR };\n447:   return reportedId === null ? store : { sessionId: reportedId, ...store };\n448: }\n449: \n450: function locatorFor(runtime, sessionId, reportedId) {\n451:   const source = runtime.locator;\n452:   // The id the runner handed the CLI is the one the store keys its log by, and\n453:   // the directory the turn ran in is what a reader matches the log's header\n454:   // against, so both travel with every record.\n455:   if (source.kind === 'runner') return { sessionId, projectDir: PROJECT_DIR };\n456:   if (source.kind === 'store') return storeLocator(reportedId);\n457:   // A runtime that reported no id records none, which keeps a scorer from opening\n458:   // a neighbouring transcript that happens to be newer.\n459:   if (reportedId === null) return null;\n460:   const locator = { sessionId: reportedId, projectDir: PROJECT_DIR };\n461:   // A reader needs the file the turn wrote as well as its id, so a store-based\n462:   // runtime resolves the id to a path once the turn has closed. A turn that left\n463:   // no single match keeps the field out rather than naming a guess.\n464:   const transcriptPath = typeof runtime.findTranscript === 'function'\n465:     ? runtime.findTranscript(reportedId)\n466:     : null;\n467:   if (transcriptPath !== null) locator.transcriptPath = transcriptPath;\n468:   return locator;\n469: }\n470: \n471: // ───────────────────────────────────────────────────────────────\n472: // Worktree guards\n473: // ───────────────────────────────────────────────────────────────\n474: //\n475: // Every live turn runs in this worktree, so the runner cleans up after itself and\n476: // refuses to start when the worktree already holds work that is not its own. The\n477: // order matters: the remote check runs before the dirty check, so a live refusal\n478: // names the one condition an arm can never repair, and the dirty check runs before\n479: // the first prompt, so a restore can never discard an edit another worker has not\n480: // committed yet, and the head check runs around every prompt, so a commit or a\n481: // stash taken mid-turn stops the arm before the next model call rather than after\n482: // the damage.\n483: \n484: // A filesystem monitor that decides a path is unchanged makes a status snapshot\n485: // lie, and the restore step trusts that snapshot.\n486: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n487: \n488: function git(args) {\n489:   const result = spawnSync('git', [...GIT_PREFIX, ...args], {\n490:     cwd: REPO_ROOT,\n491:     encoding: 'utf8',\n492:   });\n493:   if (result.error) throw result.error;\n494:   return result;\n495: }\n496: \n497: function gitText(args) {\n498:   const result = git(args);\n499:   if (result.status !== 0) {\n500:     throw new Error(`git ${args.join(' ')} failed: ${(result.stderr ?? '').trim()}`);\n501:   }\n502:   return result.stdout;\n503: }\n504: \n505: function statusPaths() {\n506:   const paths = new Map();\n507:   for (const line of gitText(['status', '--porcelain']).split('\\n')) {\n508:     if (line.length < 4) continue;\n509:     // A rename carries both sides, and both have to be put back.\n510:     for (const path of line.slice(3).split(' -> ')) {\n511:       paths.set(path, line.slice(0, 2));\n512:     }\n513:   }\n514:   return paths;\n515: }\n516: \n517: // The out folder is this arm's own output area. Git is asked for that folder's path\n518: // from the top of the repository, because comparing two spellings of the same\n519: // folder misreads a root that is reached through a symlink. An out folder outside\n520: // any repository exempts nothing, which only makes the guard stricter.\n521: function exemptPrefix(outDir) {\n522:   mkdirSync(outDir, { recursive: true });\n523:   const result = spawnSync('git', [...GIT_PREFIX, 'rev-parse', '--show-prefix'], {\n524:     cwd: outDir,\n525:     encoding: 'utf8',\n526:   });\n527:   if (result.status !== 0) return null;\n528:   const prefix = result.stdout.trim();\n529:   if (prefix === '') return null;\n530:   return prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;\n531: }\n532: \n533: function isUnderExempt(path, prefix) {\n534:   if (prefix === null) return false;\n535:   const trimmed = path.endsWith('/') ? path.slice(0, -1) : path;\n536:   return trimmed === prefix || trimmed.startsWith(`${prefix}/`);\n537: }\n538: \n539: function dirtyPaths(paths, prefix) {\n540:   return [...paths.keys()]\n541:     .filter((path) => !isUnderExempt(path, prefix))\n542:     .sort();\n543: }\n544: \n545: // A path counts as changed when its status code differs, so a file that was already\n546: // dirty before the run is never reverted on another worker's behalf.\n547: function changedPaths(before, after) {\n548:   const changed = [];\n549:   for (const [path, code] of after) {\n550:     if (before.get(path) !== code) changed.push(path);\n551:   }\n552:   return changed.sort();\n553: }\n554: \n555: // The head and the stash are the two places another operator's git work can hide.\n556: function gitSnapshot() {\n557:   return {\n558:     head: gitText(['rev-parse', 'HEAD']).trim(),\n559:     stash: gitText(['stash', 'list']),\n560:   };\n561: }\n562: \n563: // A remote is the one piece of git state a turn could use to reach outside the\n564: // checkout, so its presence is read rather than the branch's tracking state.\n565: function remoteNames() {\n566:   return gitText(['remote'])\n567:     .split('\\n')\n568:     .map((name) => name.trim())\n569:     .filter((name) => name !== '');\n570: }\n571: \n572: function pathIsTracked(path) {\n573:   return git(['ls-files', '--error-unmatch', '--', path]).status === 0;\n574: }\n575: \n576: function restorePath(path) {\n577:   if (pathIsTracked(path)) {\n578:     const result = git(['checkout', '--', path]);\n579:     return result.status === 0 ? null : `checkout ${path}: ${(result.stderr ?? '').trim()}`;\n580:   }\n581:   try {\n582:     rmSync(resolve(REPO_ROOT, path), { recursive: true, force: true });\n583:     return null;\n584:   } catch (error) {\n585:     return `delete ${path}: ${error.message}`;\n586:   }\n587: }\n588: \n589: function restorePaths(paths) {\n590:   const failures = [];\n591:   for (const path of paths) {\n592:     const failure = restorePath(path);\n593:     if (failure !== null) failures.push(failure);\n594:   }\n595:   return failures;\n596: }\n597: \n598: // ───────────────────────────────────────────────────────────────\n599: // Prompt source and run log\n600: // ───────────────────────────────────────────────────────────────\n601: \n602: /** A refusal the operator can act on without a stack trace. */\n603: class Refusal extends Error {\n604:   constructor(code, message) {\n605:     super(message);\n606:     this.code = code;\n607:   }\n608: }\n609: \n610: // A row is read one line at a time so a holdout row is refused before its prompt\n611: // reaches a child process or the run log. Discarding the text after reading it\n612: // would still have put an unmeasured prompt in the arm's path. The guard sits in\n613: // the lookup itself, so a run, a selection and a listing all answer a refused id\n614: // the same way instead of one of them getting there through a usage error.\n615: function findRow(rowId) {\n616:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n617:     if (line.trim() === '') continue;\n618:     const row = JSON.parse(line);\n619:     if (row.id !== rowId) continue;\n620:     if (row.split === 'holdout') {\n621:       throw new Refusal('holdout_row', `${rowId}: a holdout row is never run`);\n622:     }\n623:     return row;\n624:   }\n625:   throw new Refusal('unknown_row', `${rowId}: no row holds that id`);\n626: }\n627: \n628: function lookupPrompt(rowId) {\n629:   const row = findRow(rowId);\n630:   if (typeof row.prompt !== 'string' || row.prompt === '') {\n631:     throw new Refusal('unknown_row', `${rowId}: row holds no prompt`);\n632:   }\n633:   return { prompt: row.prompt };\n634: }\n635: \n636: // Selection reads the labels only, so no picker walks a structure that carries a\n637: // prompt.\n638: function rowLabels() {\n639:   const labels = [];\n640:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n641:     if (line.trim() === '') continue;\n642:     const row = JSON.parse(line);\n643:     labels.push({ id: row.id, split: row.split, rowType: row.row_type, policy: row.expected_policy });\n644:   }\n645:   return labels;\n646: }\n647: \n648: // The log is written after the closing snapshot, so the file the runner creates is\n649: // never a changed path it then tries to restore.\n650: function appendRunLine(outPath, line) {\n651:   mkdirSync(dirname(outPath), { recursive: true });\n652:   appendFileSync(outPath, `${JSON.stringify(line)}\\n`, 'utf8');\n653: }\n654: \n655: // ───────────────────────────────────────────────────────────────\n656: // Prompt sets\n657: // ───────────────────────────────────────────────────────────────\n658: //\n659: // A set is a whole arm's worth of prompts, so naming one is how a run says which\n660: // question it answers. The chat set is drawn from the measured corpus and shows\n661: // where a command is started, offered or declined. The started-command set is\n662: // fixed instead, because it asks something the corpus cannot: once a heavy\n663: // workflow begins, does it take its lock before its first write. Each command it\n664: // covers appears twice, as a plain request and with the autonomous mode spelled\n665: // out, so a start the model chose is told apart from one it was told to make. The\n666: // two loops are capped at one iteration, because a deeper run buries the first\n667: // write under the later ones the run made.\n668: \n669: // The chat set is as wide as one arm can afford on every measured runtime and no\n670: // wider: enough start rows to show a rate, the offered and declined policies in\n671: // proportion, and a safety probe for each must-not-start shape.\n672: const CHAT_PICKS = Object.freeze([\n673:   { policy: 'start', count: 8 },\n674:   { policy: 'run', count: 4 },\n675:   { policy: 'ask', count: 4 },\n676: ]);\n677: const CHAT_PROBE_COUNT = 8;\n678: \n679: // A short bucket means the corpus changed under the set, and a rate over fewer\n680: // rows than the arm claims would misreport the phase. It stops here instead.\n681: function sortedPick(labels, count, bucket) {\n682:   const ids = labels.map((label) => label.id).sort().slice(0, count);\n683:   if (ids.length < count) {\n684:     throw new Refusal('set_short', `${bucket}: expected ${count} rows, found ${ids.length}`);\n685:   }\n686:   return ids;\n687: }\n688: \n689: function chatRowIds() {\n690:   const labels = rowLabels();\n691:   const plain = labels.filter((label) => label.split === 'tune' && label.rowType === 'plain');\n692:   const ids = [];\n693:   for (const pick of CHAT_PICKS) {\n694:     const bucket = plain.filter((label) => label.policy === pick.policy);\n695:     ids.push(...sortedPick(bucket, pick.count, `chat ${pick.policy}`));\n696:   }\n697:   const probes = labels.filter((label) => label.rowType === 'must-not-start');\n698:   ids.push(...sortedPick(probes, CHAT_PROBE_COUNT, 'chat must-not-start'));\n699:   return ids;\n700: }\n701: \n702: // The fixture sits beside the run log, so the log and the folder it measured\n703: // travel together and an operator can move both without editing a prompt.\n704: const G2_SET = 'g2';\n705: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n706: const FIXTURE_TOKEN = '{fixture}';\n707: \n708: const G2_ROWS = Object.freeze([\n709:   {\n710:     id: 'g2-deep-research-ask',\n711:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n712:   },\n713:   {\n714:     id: 'g2-deep-research-typed',\n715:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n716:   },\n717:   {\n718:     id: 'g2-deep-review-ask',\n719:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n720:   },\n721:   {\n722:     id: 'g2-deep-review-typed',\n723:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n724:   },\n725:   {\n726:     id: 'g2-speckit-complete-ask',\n727:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n728:   },\n729:   {\n730:     id: 'g2-speckit-complete-typed',\n731:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n732:   },\n733: ]);\n734: \n735: const G2_PROMPTS = new Map(G2_ROWS.map((row) => [row.id, row.prompt]));\n736: \n737: const SETS = Object.freeze({\n738:   chat: chatRowIds,\n739:   [G2_SET]: () => G2_ROWS.map((row) => row.id),\n740: });\n741: \n742: // `--list` and `--set` name the same thing. One prints the rows and the other\n743: // runs them, and an invocation that asks for both lists what it would run.\n744: function setNameOf(options) {\n745:   return options.list === null ? options.set : options.list;\n746: }\n747: \n748: function setRowIds(setName) {\n749:   if (!has(SETS, setName)) throw new UsageError(`unknown set: ${setName}`);\n750:   return SETS[setName]();\n751: }\n752: \n753: // A fixed prompt carries its own text, so its id needs no corpus row. Every other\n754: // id passes the lookup a run would use, so an id arriving on the command line and\n755: // nothing else is still checked before it can become an arm's row.\n756: function assertRunnable(rowId) {\n757:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n758:   return rowId;\n759: }\n760: \n761: function selectedRowIds(options) {\n762:   const setName = setNameOf(options);\n763:   const fromSet = setName === null ? [] : setRowIds(setName);\n764:   const explicit = options.rowIds.map(assertRunnable);\n765:   return [...new Set([...fromSet, ...explicit])];\n766: }\n767: \n768: function fixtureDir(options) {\n769:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n770: }\n771: \n772: // A placeholder keeps the fixed prompts free of a path that only exists on the\n773: // machine the arm runs on.\n774: function promptFor(rowId, fixture) {\n775:   const fixed = G2_PROMPTS.get(rowId);\n776:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n777:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n778: }\n779: \n780: // The cap belongs to the prompt rather than to the invocation, so an arm that\n781: // mixes the two sets still gives a started workflow the time it needs.\n782: function capForRow(rowId) {\n783:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n784: }\n785: \n786: // ───────────────────────────────────────────────────────────────\n787: // One turn\n788: // ───────────────────────────────────────────────────────────────\n789: \n790: // A dispatched worker's marker makes a CLI answer as a child session, and a child\n791: // session is not the chat start an arm measures. The rest of the environment stays,\n792: // so each CLI finds its own home, account and route.\n793: //\n794: // The network credentials are the exception, because a turn that reaches a forge\n795: // with the operator's identity is a side effect no transcript can undo. The token\n796: // variables go, the GitHub CLI is pointed at an empty folder beside the run log\n797: // rather than the operator's authenticated one, and an empty credential helper\n798: // replaces whatever a global git config would have offered. A missing credential\n799: // then fails at once instead of waiting on a terminal nobody is sitting at.\n800: const GITHUB_TOKEN_VARS = Object.freeze(['GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN']);\n801: \n802: const GIT_CREDENTIAL_OVERRIDES = Object.freeze({\n803:   GIT_CONFIG_COUNT: '1',\n804:   GIT_CONFIG_KEY_0: 'credential.helper',\n805:   GIT_CONFIG_VALUE_0: '',\n806: });\n807: \n808: // The empty folder lives beside the run log, so a run leaves its own directory\n809: // behind instead of a path in the operator's home that the next run inherits.\n810: function ghConfigDir(outPath) {\n811:   return join(dirname(outPath), 'gh-config-empty');\n812: }\n813: \n814: function childEnv(ghConfig) {\n815:   const env = { ...process.env };\n816:   delete env.AI_SESSION_CHILD;\n817:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n818:   env.GH_CONFIG_DIR = ghConfig;\n819:   env.GIT_TERMINAL_PROMPT = '0';\n820:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n821:   return env;\n822: }\n823: \n824: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n825:   return new Promise((settle) => {\n826:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n827:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n828:     // input nobody types until the cap runs out into an empty transcript.\n829:     const child = spawn(runtime.command, argv, {\n830:       cwd: REPO_ROOT,\n831:       env: childEnv(ghConfig),\n832:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n833:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n834:       // A chat turn still running after its cap is stuck, while a started workflow\n835:       // legitimately needs the longer one. The prompt decides which it gets.\n836:       timeout: capMs,\n837:     });\n838:     // The prompt is written and the stream closed at once, so a CLI that reads until\n839:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n840:     // broken pipe behind, and that write error is the CLI's failure to report rather\n841:     // than an uncaught error that would end the run early.\n842:     if (child.stdin !== null) {\n843:       child.stdin.on('error', () => {});\n844:       child.stdin.end(prompt);\n845:     }\n846:     const locator = streamLocator(runtime.locator.field ?? null);\n847:     // The turn's own output is still shown, and the locator is read out of the\n848:     // same bytes, so watching a run and recording it never diverge.\n849:     child.stdout.setEncoding('utf8');\n850:     child.stdout.on('data', (chunk) => {\n851:       locator.push(chunk);\n852:       process.stdout.write(chunk);\n853:     });\n854:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n855:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n856:   });\n857: }\n858: \n859: // ───────────────────────────────────────────────────────────────\n860: // CLI\n861: // ───────────────────────────────────────────────────────────────\n862: \n863: class UsageError extends Error {}\n864: \n865: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n866: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n867: const SAMPLE_SESSION_ID = 'sample-session-id';\n868: \n869: // An arm label decides how a later scorer groups a whole log, so a typo would\n870: // quietly invent a third arm. The set is closed for that reason.\n871: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n872: \n873: // The pre-change arm is the default because it is the one that can run before the\n874: // brief lands. A post-change run has to say which arm it belongs to. The\n875: // started-command set carries its own arm, so a run of it cannot land in the\n876: // change comparison by omission.\n877: const DEFAULT_ARM = 'pre';\n878: \n879: const USAGE = [\n880:   `usage: ${SCRIPT_NAME} --print-argv <runtime>`,\n881:   `       ${SCRIPT_NAME} --list <set>`,\n882:   `       ${SCRIPT_NAME} --runtime <runtime> (--set <set> | --row-id <id>...)`,\n883:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n884:   `       ${SCRIPT_NAME} --backfill <run-log> --out <new-log>`,\n885: ].join('\\n');\n886: \n887: function resolveRuntime(name) {\n888:   if (has(RUNTIMES, name)) {\n889:     return RUNTIMES[name];\n890:   }\n891:   if (has(NOT_MEASURED, name)) {\n892:     throw new UsageError(`runtime ${name} is not measured: ${NOT_MEASURED[name]}`);\n893:   }\n894:   throw new UsageError(`unknown runtime: ${name}`);\n895: }\n896: \n897: function valueAfter(argv, index, flag) {\n898:   const value = argv[index];\n899:   if (typeof value !== 'string' || value.startsWith('--')) {\n900:     throw new UsageError(`${flag}: a value is required`);\n901:   }\n902:   return value;\n903: }\n904: \n905: // A set that has its own arm names it, so a started-command run cannot join the\n906: // change comparison because nobody passed `--arm`.\n907: function armFor(options) {\n908:   if (options.arm !== null) return options.arm;\n909:   return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n910: }\n911: \n912: function parseOptions(argv) {\n913:   const options = {\n914:     printArgv: null,\n915:     list: null,\n916:     set: null,\n917:     runtime: null,\n918:     rowIds: [],\n919:     arm: null,\n920:     out: null,\n921:     backfill: null,\n922:     fixture: null,\n923:     dryRun: false,\n924:   };\n925:   for (let index = 0; index < argv.length; index += 1) {\n926:     const token = argv[index];\n927:     if (token === '--print-argv') {\n928:       index += 1;\n929:       options.printArgv = valueAfter(argv, index, '--print-argv');\n930:     } else if (token === '--list') {\n931:       index += 1;\n932:       options.list = valueAfter(argv, index, '--list');\n933:     } else if (token === '--set') {\n934:       index += 1;\n935:       options.set = valueAfter(argv, index, '--set');\n936:     } else if (token === '--runtime') {\n937:       index += 1;\n938:       options.runtime = valueAfter(argv, index, '--runtime');\n939:     } else if (token === '--row-id') {\n940:       index += 1;\n941:       options.rowIds.push(valueAfter(argv, index, '--row-id'));\n942:     } else if (token === '--arm') {\n943:       index += 1;\n944:       const arm = valueAfter(argv, index, '--arm');\n945:       if (!ARMS.includes(arm)) {\n946:         throw new UsageError(`--arm: expected one of ${ARMS.join(', ')}`);\n947:       }\n948:       options.arm = arm;\n949:     } else if (token === '--out') {\n950:       index += 1;\n951:       options.out = resolve(valueAfter(argv, index, '--out'));\n952:     } else if (token === '--backfill') {\n953:       index += 1;\n954:       options.backfill = resolve(valueAfter(argv, index, '--backfill'));\n955:     } else if (token === '--fixture') {\n956:       index += 1;\n957:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n958:     } else if (token === '--dry-run') {\n959:       options.dryRun = true;\n960:     } else {\n961:       throw new UsageError(`unknown option: ${token}`);\n962:     }\n963:   }\n964:   return options;\n965: }\n966: \n967: // One mode per invocation. Asking for an argv and a run at once would hide which\n968: // one the operator meant, and a run with no log has nowhere to record its proof.\n969: function selectMode(options) {\n970:   if (options.printArgv !== null) return 'print-argv';\n971:   if (options.list !== null) return 'list';\n972:   if (options.backfill !== null) {\n973:     if (options.out === null) throw new UsageError('--out is required');\n974:     return 'backfill';\n975:   }\n976:   if (options.runtime === null) throw new UsageError('--runtime is required');\n977:   if (options.set === null && options.rowIds.length === 0) {\n978:     throw new UsageError('--set or --row-id is required');\n979:   }\n980:   if (options.out === null) throw new UsageError('--out is required');\n981:   return 'run';\n982: }\n983: \n984: function writeJson(value) {\n985:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n986: }\n987: \n988: function writeRowIds(rowIds) {\n989:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n990: }\n991: \n992: function writeArgv(runtimeName) {\n993:   const runtime = resolveRuntime(runtimeName);\n994:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n995:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n996:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n997:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n998:   }\n999:   writeJson(argv);\n1000: }\n1001: \n1002: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n1003: // fires, so a broken precondition never spends another model call.\n1004: async function runTurn(job, options, exempt, isFirst) {\n1005:   const before = { status: statusPaths(), ...gitSnapshot() };\n1006:   if (isFirst) {\n1007:     // A live turn can push, so it may only start where there is no remote to push\n1008:     // to. A dry run spawns nothing and keeps running in this checkout.\n1009:     if (!options.dryRun) {\n1010:       const remotes = remoteNames();\n1011:       if (remotes.length > 0) {\n1012:         return {\n1013:           status: EXIT_REFUSED,\n1014:           refusal: { ok: false, code: 'remote_present', remotes },\n1015:         };\n1016:       }\n1017:     }\n1018:     const dirty = dirtyPaths(before.status, exempt);\n1019:     if (dirty.length > 0) {\n1020:       return {\n1021:         status: EXIT_REFUSED,\n1022:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n1023:       };\n1024:     }\n1025:   }\n1026: \n1027:   const sessionId = randomUUID();\n1028:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1029:   // A runtime that names its session only in its own store is bracketed by a\n1030:   // listing, and the entry the turn added is the session it wrote. A dry run\n1031:   // starts no CLI, so it has nothing to list.\n1032:   const listed = !options.dryRun && listsStore(job.runtime);\n1033:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1034:   const turn = options.dryRun\n1035:     ? { exit: null, error: null, streamId: null }\n1036:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1037:   const reportedId = listed\n1038:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1039:     : turn.streamId;\n1040: \n1041:   const after = { status: statusPaths(), ...gitSnapshot() };\n1042:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1043:   const changed = changedPaths(before.status, after.status);\n1044:   // The locator is kept in hand because the brief reader opens the same session\n1045:   // the line records, and resolving it twice could name a different file.\n1046:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1047:   const line = {\n1048:     runtime: job.runtimeName,\n1049:     rowId: job.rowId,\n1050:     arm: options.arm,\n1051:     locator,\n1052:     exit: turn.exit,\n1053:     changedPaths: changed,\n1054:   };\n1055: \n1056:   if (headMoved) {\n1057:     // The worktree the restore was written for is gone. Restoring now could discard\n1058:     // whatever the commit or stash brought in, so the paths stay listed instead.\n1059:     appendRunLine(options.out, { ...line, restored: false, headMoved: true });\n1060:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1061:   }\n1062: \n1063:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1064:   // honestly report as left as found.\n1065:   const restored = options.dryRun ? changed.length === 0 : restorePaths(changed).length === 0;\n1066:   // The head the reader saw is the only place the offer was named, and not every\n1067:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1068:   // replays it, which lets an operator read the offer without paying for a model\n1069:   // call, while the brief stays `unknown` because no session exists to read.\n1070:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1071:   const delivered = options.dryRun\n1072:     ? 'unknown'\n1073:     : await briefDelivered({ runtime: job.runtimeName, locator });\n1074:   appendRunLine(options.out, {\n1075:     ...line,\n1076:     offeredCommand: offer.offeredCommand,\n1077:     offeredPolicy: offer.offeredPolicy,\n1078:     briefDelivered: delivered,\n1079:     restored,\n1080:   });\n1081: \n1082:   if (turn.error !== null) {\n1083:     const detail = turn.error.message;\n1084:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1085:   }\n1086:   if (!restored) {\n1087:     return { status: 1, refusal: { ok: false, code: 'restore_failed', rowId: job.rowId, paths: changed } };\n1088:   }\n1089:   return { status: 0, refusal: null };\n1090: }\n1091: \n1092: async function runArm(options, rowIds) {\n1093:   const exempt = exemptPrefix(dirname(options.out));\n1094:   const runtime = resolveRuntime(options.runtime);\n1095:   const fixture = fixtureDir(options);\n1096:   // Created once before the first snapshot, so the folder a turn needs is never\n1097:   // read back as a path the turn itself changed.\n1098:   const ghConfig = ghConfigDir(options.out);\n1099:   mkdirSync(ghConfig, { recursive: true });\n1100:   for (let index = 0; index < rowIds.length; index += 1) {\n1101:     const rowId = rowIds[index];\n1102:     const prompt = promptFor(rowId, fixture);\n1103:     const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n1104:     const result = await runTurn(job, options, exempt, index === 0);\n1105:     if (result.refusal !== null) writeJson(result.refusal);\n1106:     if (result.status !== 0) return result.status;\n1107:   }\n1108:   return 0;\n1109: }\n1110: \n1111: // A finished log is rewritten from its recorded lines alone, and the fixture folder\n1112: // still sits beside the log the arm wrote. The corpus lookup runs before the first\n1113: // line is written, so a row the dataset guard refuses leaves no output file behind.\n1114: async function backfillLog(options) {\n1115:   const fixture = resolve(dirname(options.backfill), G2_FIXTURE_DIRNAME);\n1116:   const result = await backfillRunLog({\n1117:     inPath: options.backfill,\n1118:     outPath: options.out,\n1119:     promptFor: (rowId) => promptFor(rowId, fixture),\n1120:   });\n1121:   writeJson(result);\n1122:   return result.ok ? 0 : EXIT_REFUSED;\n1123: }\n1124: \n1125: async function main(argv) {\n1126:   try {\n1127:     const options = parseOptions(argv);\n1128:     // Selection runs before the mode check, so an id the dataset guard refuses is\n1129:     // answered by that guard rather than by whichever usage check would run first.\n1130:     const rowIds = selectedRowIds(options);\n1131:     const mode = selectMode(options);\n1132:     options.arm = armFor(options);\n1133: \n1134:     if (mode === 'print-argv') {\n1135:       writeArgv(options.printArgv);\n1136:       return 0;\n1137:     }\n1138:     if (mode === 'list') {\n1139:       writeRowIds(rowIds);\n1140:       return 0;\n1141:     }\n1142:     if (mode === 'backfill') {\n1143:       return await backfillLog(options);\n1144:     }\n1145:     return await runArm(options, rowIds);\n1146:   } catch (error) {\n1147:     if (error instanceof UsageError) {\n1148:       process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}\\n`);\n1149:       return EXIT_REFUSED;\n1150:     }\n1151:     if (error instanceof Refusal) {\n1152:       writeJson({ ok: false, code: error.code, detail: error.message });\n1153:       return EXIT_REFUSED;\n1154:     }\n1155:     throw error;\n1156:   }\n1157: }\n1158: \n1159: try {\n1160:   process.exitCode = await main(process.argv.slice(2));\n1161: } catch (error) {\n1162:   if (error instanceof UsageError) {\n1163:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n`);\n1164:     process.exitCode = EXIT_REFUSED;\n1165:   } else {\n1166:     throw error;\n1167:   }\n1168: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794545774817,"end":1794545775751}}}}
{"type":"step_finish","timestamp":1794545778811,"sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","part":{"id":"prt_1d343807b0015WCrR0nv9g4Cov","sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","messageID":"msg_1d3435c64001DJu1KqcLYAroDU","type":"step-finish","reason":"tool-calls","snapshot":"2eac9cb58506b9ff5efbd5db162aea8a439a101d","cost":0,"tokens":{"input":1587,"output":157,"reasoning":152,"cache":{"read":34560,"write":0}}}}
{"type":"step_start","timestamp":1794545788177,"sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","part":{"id":"prt_1d343a5110013mrpx10lI836pf","sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","messageID":"msg_1d3438084001Ib7bN3G1T2ZREJ","type":"step-start","snapshot":"1e8b80a7926956422ddb1e581aef3b0a6a7ebe79"}}
{"type":"tool_use","timestamp":1794545790180,"sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","part":{"partID":"prt_1d343a8be0015CK1F9UQo12EPr","sessionID":"ses_e2cbe01f9ffetVZsN2mLpqzB8H","messageID":"msg_1d3438084001Ib7bN3G1T2ZREJ","type":"tool","id":"call_50377b5361b54ee5a5716e1b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts","limit":160},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-160\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss. The backfill cases pin that a line keeps its place\n14: // when its checkout is gone, that a refused row leaves no output behind, and\n15: // that the new log never replaces the one it reads.\n16: \n17: import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { join } from 'node:path';\n20: \n21: import { describe, expect, it } from 'vitest';\n22: \n23: import { backfillRunLog, briefDelivered, parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\n24: \n25: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n26: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n27: const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n28: \n29: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n30:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n31:   const transcriptPath = join(dir, 'session.jsonl');\n32:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n33:   return { dir, transcriptPath };\n34: }\n35: \n36: function writeRunLog(dir: string, lines: unknown[]): string {\n37:   const inPath = join(dir, 'runs.jsonl');\n38:   writeFileSync(inPath, lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n');\n39:   return inPath;\n40: }\n41: \n42: describe('parseOffer', () => {\n43:   it('reads the command and the policy a head offers', () => {\n44:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n45:       offeredCommand: '/doctor:git hooks',\n46:       offeredPolicy: 'ask',\n47:     });\n48:   });\n49: \n50:   it('reads the command but no policy under an ambiguous head', () => {\n51:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n52:       offeredCommand: '/doctor:git hooks',\n53:       offeredPolicy: null,\n54:     });\n55:   });\n56: \n57:   it('reads no command when the head names none', () => {\n58:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n59:       offeredCommand: null,\n60:       offeredPolicy: null,\n61:     });\n62:   });\n63: });\n64: \n65: describe('replayOffer', () => {\n66:   it('reports a checkout without the prompt hook instead of throwing', () => {\n67:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n68:     try {\n69:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n70:         offeredCommand: null,\n71:         offeredPolicy: null,\n72:         offerError: 'hook_missing',\n73:       });\n74:     } finally {\n75:       rmSync(checkoutDir, { recursive: true, force: true });\n76:     }\n77:   });\n78: });\n79: \n80: describe('briefDelivered', () => {\n81:   it('finds the advisor context in a Claude transcript attachment', async () => {\n82:     const { dir, transcriptPath } = writeTranscript([\n83:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n84:       {\n85:         type: 'attachment',\n86:         attachment: {\n87:           type: 'hook_additional_context',\n88:           hookEvent: 'UserPromptSubmit',\n89:           content: [OFFERED_HEAD],\n90:         },\n91:       },\n92:     ]);\n93:     try {\n94:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n95:     } finally {\n96:       rmSync(dir, { recursive: true, force: true });\n97:     }\n98:   });\n99: \n100:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n101:     const { dir, transcriptPath } = writeTranscript([\n102:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n103:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n104:     ]);\n105:     try {\n106:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n107:     } finally {\n108:       rmSync(dir, { recursive: true, force: true });\n109:     }\n110:   });\n111: \n112:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n113:     await expect(briefDelivered({\n114:       runtime: 'devin',\n115:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n116:     })).resolves.toBe('unknown');\n117:   });\n118: });\n119: \n120: describe('backfillRunLog', () => {\n121:   it('adds the offer and the brief to every line and warms each checkout once', async () => {\n122:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n123:     const outPath = join(dir, 'runs-out.jsonl');\n124:     const inPath = writeRunLog(dir, [\n125:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n126:       { runtime: 'claude', rowId: 'row-two', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n127:     ]);\n128:     const before = readFileSync(inPath, 'utf8');\n129:     const warmed: string[] = [];\n130:     const replayed: Array<{ checkoutDir: string; prompt: string; sessionId: string }> = [];\n131:     const seen: Array<{ runtime: string; locator: unknown }> = [];\n132:     try {\n133:       const result = await backfillRunLog({\n134:         inPath,\n135:         outPath,\n136:         promptFor: (rowId: string) => `prompt for ${rowId}`,\n137:         warm: async (checkoutDir: string) => {\n138:           warmed.push(checkoutDir);\n139:         },\n140:         replay: async ({ checkoutDir, prompt, sessionId }: { checkoutDir: string; prompt: string; sessionId: string }) => {\n141:           replayed.push({ checkoutDir, prompt, sessionId });\n142:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'ask', offerError: null };\n143:         },\n144:         brief: async ({ runtime, locator }: { runtime: string; locator: unknown }) => {\n145:           seen.push({ runtime, locator });\n146:           return true;\n147:         },\n148:       });\n149: \n150:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n151:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n152:       expect(written).toHaveLength(2);\n153:       expect(written[0]).toMatchObject({\n154:         rowId: 'row-one',\n155:         offeredCommand: '/doctor:git hooks',\n156:         offeredPolicy: 'ask',\n157:         offerError: null,\n158:         briefDelivered: true,\n159:         offerBackfilled: true,\n160:       });\n[Output truncated. Continue reading with offset: 161]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-160\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss. The backfill cases pin that a line keeps its place\n14: // when its checkout is gone, that a refused row leaves no output behind, and\n15: // that the new log never replaces the one it reads.\n16: \n17: import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { join } from 'node:path';\n20: \n21: import { describe, expect, it } from 'vitest';\n22: \n23: import { backfillRunLog, briefDelivered, parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\n24: \n25: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n26: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n27: const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n28: \n29: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n30:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n31:   const transcriptPath = join(dir, 'session.jsonl');\n32:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n33:   return { dir, transcriptPath };\n34: }\n35: \n36: function writeRunLog(dir: string, lines: unknown[]): string {\n37:   const inPath = join(dir, 'runs.jsonl');\n38:   writeFileSync(inPath, lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n');\n39:   return inPath;\n40: }\n41: \n42: describe('parseOffer', () => {\n43:   it('reads the command and the policy a head offers', () => {\n44:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n45:       offeredCommand: '/doctor:git hooks',\n46:       offeredPolicy: 'ask',\n47:     });\n48:   });\n49: \n50:   it('reads the command but no policy under an ambiguous head', () => {\n51:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n52:       offeredCommand: '/doctor:git hooks',\n53:       offeredPolicy: null,\n54:     });\n55:   });\n56: \n57:   it('reads no command when the head names none', () => {\n58:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n59:       offeredCommand: null,\n60:       offeredPolicy: null,\n61:     });\n62:   });\n63: });\n64: \n65: describe('replayOffer', () => {\n66:   it('reports a checkout without the prompt hook instead of throwing', () => {\n67:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n68:     try {\n69:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n70:         offeredCommand: null,\n71:         offeredPolicy: null,\n72:         offerError: 'hook_missing',\n73:       });\n74:     } finally {\n75:       rmSync(checkoutDir, { recursive: true, force: true });\n76:     }\n77:   });\n78: });\n79: \n80: describe('briefDelivered', () => {\n81:   it('finds the advisor context in a Claude transcript attachment', async () => {\n82:     const { dir, transcriptPath } = writeTranscript([\n83:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n84:       {\n85:         type: 'attachment',\n86:         attachment: {\n87:           type: 'hook_additional_context',\n88:           hookEvent: 'UserPromptSubmit',\n89:           content: [OFFERED_HEAD],\n90:         },\n91:       },\n92:     ]);\n93:     try {\n94:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n95:     } finally {\n96:       rmSync(dir, { recursive: true, force: true });\n97:     }\n98:   });\n99: \n100:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n101:     const { dir, transcriptPath } = writeTranscript([\n102:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n103:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n104:     ]);\n105:     try {\n106:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n107:     } finally {\n108:       rmSync(dir, { recursive: true, force: true });\n109:     }\n110:   });\n111: \n112:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n113:     await expect(briefDelivered({\n114:       runtime: 'devin',\n115:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n116:     })).resolves.toBe('unknown');\n117:   });\n118: });\n119: \n120: describe('backfillRunLog', () => {\n121:   it('adds the offer and the brief to every line and warms each checkout once', async () => {\n122:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n123:     const outPath = join(dir, 'runs-out.jsonl');\n124:     const inPath = writeRunLog(dir, [\n125:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n126:       { runtime: 'claude', rowId: 'row-two', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n127:     ]);\n128:     const before = readFileSync(inPath, 'utf8');\n129:     const warmed: string[] = [];\n130:     const replayed: Array<{ checkoutDir: string; prompt: string; sessionId: string }> = [];\n131:     const seen: Array<{ runtime: string; locator: unknown }> = [];\n132:     try {\n133:       const result = await backfillRunLog({\n134:         inPath,\n135:         outPath,\n136:         promptFor: (rowId: string) => `prompt for ${rowId}`,\n137:         warm: async (checkoutDir: string) => {\n138:           warmed.push(checkoutDir);\n139:         },\n140:         replay: async ({ checkoutDir, prompt, sessionId }: { checkoutDir: string; prompt: string; sessionId: string }) => {\n141:           replayed.push({ checkoutDir, prompt, sessionId });\n142:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'ask', offerError: null };\n143:         },\n144:         brief: async ({ runtime, locator }: { runtime: string; locator: unknown }) => {\n145:           seen.push({ runtime, locator });\n146:           return true;\n147:         },\n148:       });\n149: \n150:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n151:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n152:       expect(written).toHaveLength(2);\n153:       expect(written[0]).toMatchObject({\n154:         rowId: 'row-one',\n155:         offeredCommand: '/doctor:git hooks',\n156:         offeredPolicy: 'ask',\n157:         offerError: null,\n158:         briefDelivered: true,\n159:         offerBackfilled: true,\n160:       });\n[Output truncated. Continue reading with offset: 161]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\",\"limit\":160}"},"time":{"start":1794545789118,"end":1794545790180}}}}
