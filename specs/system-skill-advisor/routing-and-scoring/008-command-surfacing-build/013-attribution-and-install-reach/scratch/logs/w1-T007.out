{"type":"tool_use","timestamp":1794545778977,"sessionID":"ses_e2cbe0d40ffeJEGbl89dN2X2ox","part":{"partID":"prt_1d3437f290013k5vZMlQytaT3g","sessionID":"ses_e2cbe0d40ffeJEGbl89dN2X2ox","messageID":"msg_1d3437053001qOqBpPGqYVKi0L","type":"tool","id":"call_8c274adc2f85415d97ee207b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-328\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: \n29: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n30: \n31: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n32: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n33: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n34: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n35: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n36: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n37: const DEFAULT_TIMEOUT_MS = 30_000;\n38: const MAX_OUTPUT_BYTES = 1024 * 1024;\n39: \n40: function failedOffer(offerError) {\n41:   return { offeredCommand: null, offeredPolicy: null, offerError };\n42: }\n43: \n44: /**\n45:  * Read the command and the policy out of the first line of a head.\n46:  *\n47:  * The policy only counts when it directly follows the command, so a `(ask)`\n48:  * that belongs to a later clause cannot attach itself to an earlier match.\n49:  *\n50:  * @param {string} head - One line of advisor output.\n51:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n52:  */\n53: export function parseOffer(head) {\n54:   const text = typeof head === 'string' ? head : '';\n55:   const match = text.match(OFFER_PATTERN);\n56:   if (!match) {\n57:     return { offeredCommand: null, offeredPolicy: null };\n58:   }\n59:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n60:   return {\n61:     offeredCommand: match[0],\n62:     offeredPolicy: policy ? policy[1] : null,\n63:   };\n64: }\n65: \n66: /**\n67:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n68:  *\n69:  * The hook is resolved from the checkout rather than from this module, so a\n70:  * backfill records what that checkout's advisor would have offered at the time\n71:  * of the run, not what the current working copy happens to say.\n72:  *\n73:  * @param {object} options\n74:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n75:  * @param {string} options.prompt - The prompt to replay.\n76:  * @param {string} options.sessionId - Session id for the hook payload.\n77:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n78:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n79:  */\n80: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n81:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n82:   if (!existsSync(hookPath)) {\n83:     return failedOffer('hook_missing');\n84:   }\n85: \n86:   const payload = {\n87:     prompt,\n88:     cwd: checkoutDir,\n89:     hook_event_name: 'UserPromptSubmit',\n90:     session_id: sessionId,\n91:   };\n92: \n93:   let result;\n94:   try {\n95:     result = spawnSync('node', [hookPath], {\n96:       cwd: checkoutDir,\n97:       input: JSON.stringify(payload),\n98:       encoding: 'utf8',\n99:       timeout: timeoutMs,\n100:       maxBuffer: MAX_OUTPUT_BYTES,\n101:     });\n102:   } catch {\n103:     return failedOffer('hook_failed');\n104:   }\n105: \n106:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   let output;\n111:   try {\n112:     output = JSON.parse(result.stdout);\n113:   } catch {\n114:     return failedOffer('hook_failed');\n115:   }\n116: \n117:   const context = output?.hookSpecificOutput?.additionalContext;\n118:   if (typeof context !== 'string') {\n119:     return failedOffer('no_head');\n120:   }\n121: \n122:   const [firstLine = ''] = context.split(/\\r?\\n/);\n123:   if (!firstLine.trim()) {\n124:     return failedOffer('no_head');\n125:   }\n126: \n127:   return { ...parseOffer(firstLine), offerError: null };\n128: }\n129: \n130: function contentHasBrief(content) {\n131:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n132:   if (!Array.isArray(content)) return false;\n133:   return content.some((part) => {\n134:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n135:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n136:   });\n137: }\n138: \n139: // Neutral records keep their text in content blocks, and the block shape differs\n140: // by runtime, so the serialized record is the one place the brief is found\n141: // whichever block carries it.\n142: function recordsHaveBrief(records) {\n143:   return (Array.isArray(records) ? records : []).some((record) =>\n144:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n145: }\n146: \n147: /**\n148:  * Decide whether the advisor brief reached the session that ran the turn.\n149:  *\n150:  * A Claude transcript records the hook context as its own attachment line, so a\n151:  * missing attachment is a real miss. Pi keeps delivery in its session records\n152:  * and needs the caller's reader. Every other runtime has no confirmed record of\n153:  * delivery, so its answer stays `unknown` and never counts as a miss.\n154:  *\n155:  * @param {object} options\n156:  * @param {string} options.runtime - The measured runtime.\n157:  * @param {object|null} [options.locator] - The locator the run line recorded.\n158:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n159:  *   lives in session records rather than a transcript file.\n160:  * @returns {Promise<boolean | 'unknown'>}\n161:  */\n162: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n163:   if (runtime === 'claude') {\n164:     const transcriptPath = locator?.transcriptPath;\n165:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n166:       return 'unknown';\n167:     }\n168: \n169:     let raw;\n170:     try {\n171:       raw = readFileSync(transcriptPath, 'utf8');\n172:     } catch {\n173:       return 'unknown';\n174:     }\n175: \n176:     for (const line of raw.split('\\n')) {\n177:       if (!line.trim()) continue;\n178:       let entry;\n179:       try {\n180:         entry = JSON.parse(line);\n181:       } catch {\n182:         continue;\n183:       }\n184:       if (entry?.type !== 'attachment') continue;\n185:       const attachment = entry.attachment;\n186:       if (attachment?.type !== 'hook_additional_context') continue;\n187:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n188:       if (contentHasBrief(attachment.content)) return true;\n189:     }\n190:     return false;\n191:   }\n192: \n193:   if (runtime === 'pi') {\n194:     if (typeof loadSession !== 'function') return 'unknown';\n195:     let loaded;\n196:     try {\n197:       loaded = await loadSession({ ...locator, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n220:     'node',\n221:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n222:     {\n223:       cwd: checkoutDir,\n224:       encoding: 'utf8',\n225:       timeout: DEFAULT_TIMEOUT_MS,\n226:       maxBuffer: MAX_OUTPUT_BYTES,\n227:     },\n228:   );\n229: }\n230: \n231: function refused(code, detail) {\n232:   return { ok: false, code, detail };\n233: }\n234: \n235: /**\n236:  * Add the offer, its policy and the brief to every line of a run log.\n237:  *\n238:  * The prompts are resolved before the first line is written, so a row the\n239:  * corpus refuses leaves no output file behind. A line whose locator names no\n240:  * checkout keeps null offer fields and its own error code, and the rest of the\n241:  * log is still written.\n242:  *\n243:  * @param {object} options\n244:  * @param {string} options.inPath - Run log to read.\n245:  * @param {string} options.outPath - New run log to write.\n246:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n247:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n248:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n249:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n250:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n251:  *   injectable for tests.\n252:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n253:  *   | { ok: false, code: string, detail: string }>}\n254:  */\n255: export async function backfillRunLog({\n256:   inPath,\n257:   outPath,\n258:   promptFor,\n259:   replay = replayOffer,\n260:   brief = briefDelivered,\n261:   warm = warmCheckout,\n262: }) {\n263:   if (resolve(outPath) === resolve(inPath)) {\n264:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n265:   }\n266: \n267:   const rows = [];\n268:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n269:     if (raw.trim() === '') continue;\n270:     rows.push(JSON.parse(raw));\n271:   }\n272: \n273:   const prompts = [];\n274:   for (const row of rows) {\n275:     try {\n276:       prompts.push(promptFor(row.rowId));\n277:     } catch (error) {\n278:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n279:     }\n280:   }\n281: \n282:   const warmed = new Set();\n283:   const output = [];\n284:   for (let index = 0; index < rows.length; index += 1) {\n285:     const line = rows[index];\n286:     const rowId = line.rowId;\n287:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n288:       ? line.locator\n289:       : null;\n290:     const projectDir = locator?.projectDir;\n291:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n292: \n293:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n294:     if (checkoutDir !== null) {\n295:       if (!warmed.has(checkoutDir)) {\n296:         warmed.add(checkoutDir);\n297:         try {\n298:           await warm(checkoutDir);\n299:         } catch {\n300:           // A failed warm-up still lets the replay report its own miss.\n301:         }\n302:       }\n303:       offer = await replay({\n304:         checkoutDir,\n305:         prompt: prompts[index],\n306:         sessionId: `backfill-${rowId}`,\n307:       });\n308:     }\n309: \n310:     // Pi keeps its brief in a session store rather than a transcript, so the\n311:     // shared reader travels with every call. A runtime that has no reader for\n312:     // its store ignores it and answers `unknown`.\n313:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n314: \n315:     output.push({\n316:       ...line,\n317:       offeredCommand: offer.offeredCommand ?? null,\n318:       offeredPolicy: offer.offeredPolicy ?? null,\n319:       offerError: offer.offerError ?? null,\n320:       briefDelivered: delivered,\n321:       offerBackfilled: true,\n322:     });\n323:   }\n324: \n325:   mkdirSync(dirname(outPath), { recursive: true });\n326:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n327:   return { ok: true, lines: output.length, outPath };\n328: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-328\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: \n29: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n30: \n31: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n32: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n33: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n34: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n35: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n36: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n37: const DEFAULT_TIMEOUT_MS = 30_000;\n38: const MAX_OUTPUT_BYTES = 1024 * 1024;\n39: \n40: function failedOffer(offerError) {\n41:   return { offeredCommand: null, offeredPolicy: null, offerError };\n42: }\n43: \n44: /**\n45:  * Read the command and the policy out of the first line of a head.\n46:  *\n47:  * The policy only counts when it directly follows the command, so a `(ask)`\n48:  * that belongs to a later clause cannot attach itself to an earlier match.\n49:  *\n50:  * @param {string} head - One line of advisor output.\n51:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n52:  */\n53: export function parseOffer(head) {\n54:   const text = typeof head === 'string' ? head : '';\n55:   const match = text.match(OFFER_PATTERN);\n56:   if (!match) {\n57:     return { offeredCommand: null, offeredPolicy: null };\n58:   }\n59:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n60:   return {\n61:     offeredCommand: match[0],\n62:     offeredPolicy: policy ? policy[1] : null,\n63:   };\n64: }\n65: \n66: /**\n67:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n68:  *\n69:  * The hook is resolved from the checkout rather than from this module, so a\n70:  * backfill records what that checkout's advisor would have offered at the time\n71:  * of the run, not what the current working copy happens to say.\n72:  *\n73:  * @param {object} options\n74:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n75:  * @param {string} options.prompt - The prompt to replay.\n76:  * @param {string} options.sessionId - Session id for the hook payload.\n77:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n78:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n79:  */\n80: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n81:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n82:   if (!existsSync(hookPath)) {\n83:     return failedOffer('hook_missing');\n84:   }\n85: \n86:   const payload = {\n87:     prompt,\n88:     cwd: checkoutDir,\n89:     hook_event_name: 'UserPromptSubmit',\n90:     session_id: sessionId,\n91:   };\n92: \n93:   let result;\n94:   try {\n95:     result = spawnSync('node', [hookPath], {\n96:       cwd: checkoutDir,\n97:       input: JSON.stringify(payload),\n98:       encoding: 'utf8',\n99:       timeout: timeoutMs,\n100:       maxBuffer: MAX_OUTPUT_BYTES,\n101:     });\n102:   } catch {\n103:     return failedOffer('hook_failed');\n104:   }\n105: \n106:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n107:     return failedOffer('hook_failed');\n108:   }\n109: \n110:   let output;\n111:   try {\n112:     output = JSON.parse(result.stdout);\n113:   } catch {\n114:     return failedOffer('hook_failed');\n115:   }\n116: \n117:   const context = output?.hookSpecificOutput?.additionalContext;\n118:   if (typeof context !== 'string') {\n119:     return failedOffer('no_head');\n120:   }\n121: \n122:   const [firstLine = ''] = context.split(/\\r?\\n/);\n123:   if (!firstLine.trim()) {\n124:     return failedOffer('no_head');\n125:   }\n126: \n127:   return { ...parseOffer(firstLine), offerError: null };\n128: }\n129: \n130: function contentHasBrief(content) {\n131:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n132:   if (!Array.isArray(content)) return false;\n133:   return content.some((part) => {\n134:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n135:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n136:   });\n137: }\n138: \n139: // Neutral records keep their text in content blocks, and the block shape differs\n140: // by runtime, so the serialized record is the one place the brief is found\n141: // whichever block carries it.\n142: function recordsHaveBrief(records) {\n143:   return (Array.isArray(records) ? records : []).some((record) =>\n144:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n145: }\n146: \n147: /**\n148:  * Decide whether the advisor brief reached the session that ran the turn.\n149:  *\n150:  * A Claude transcript records the hook context as its own attachment line, so a\n151:  * missing attachment is a real miss. Pi keeps delivery in its session records\n152:  * and needs the caller's reader. Every other runtime has no confirmed record of\n153:  * delivery, so its answer stays `unknown` and never counts as a miss.\n154:  *\n155:  * @param {object} options\n156:  * @param {string} options.runtime - The measured runtime.\n157:  * @param {object|null} [options.locator] - The locator the run line recorded.\n158:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n159:  *   lives in session records rather than a transcript file.\n160:  * @returns {Promise<boolean | 'unknown'>}\n161:  */\n162: export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n163:   if (runtime === 'claude') {\n164:     const transcriptPath = locator?.transcriptPath;\n165:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n166:       return 'unknown';\n167:     }\n168: \n169:     let raw;\n170:     try {\n171:       raw = readFileSync(transcriptPath, 'utf8');\n172:     } catch {\n173:       return 'unknown';\n174:     }\n175: \n176:     for (const line of raw.split('\\n')) {\n177:       if (!line.trim()) continue;\n178:       let entry;\n179:       try {\n180:         entry = JSON.parse(line);\n181:       } catch {\n182:         continue;\n183:       }\n184:       if (entry?.type !== 'attachment') continue;\n185:       const attachment = entry.attachment;\n186:       if (attachment?.type !== 'hook_additional_context') continue;\n187:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n188:       if (contentHasBrief(attachment.content)) return true;\n189:     }\n190:     return false;\n191:   }\n192: \n193:   if (runtime === 'pi') {\n194:     if (typeof loadSession !== 'function') return 'unknown';\n195:     let loaded;\n196:     try {\n197:       loaded = await loadSession({ ...locator, runtime });\n198:     } catch {\n199:       return 'unknown';\n200:     }\n201:     if (!loaded?.ok) return 'unknown';\n202:     return recordsHaveBrief(loaded.records);\n203:   }\n204: \n205:   return 'unknown';\n206: }\n207: \n208: // ───────────────────────────────────────────────────────────────\n209: // Run-log backfill\n210: // ───────────────────────────────────────────────────────────────\n211: \n212: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n213: // each checkout to start one before it replays. The status call writes nothing,\n214: // and its failure is ignored because a replay that finds no daemon records its\n215: // own error instead of losing the line.\n216: function warmCheckout(checkoutDir) {\n217:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n218:   if (!existsSync(cliPath)) return;\n219:   spawnSync(\n220:     'node',\n221:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n222:     {\n223:       cwd: checkoutDir,\n224:       encoding: 'utf8',\n225:       timeout: DEFAULT_TIMEOUT_MS,\n226:       maxBuffer: MAX_OUTPUT_BYTES,\n227:     },\n228:   );\n229: }\n230: \n231: function refused(code, detail) {\n232:   return { ok: false, code, detail };\n233: }\n234: \n235: /**\n236:  * Add the offer, its policy and the brief to every line of a run log.\n237:  *\n238:  * The prompts are resolved before the first line is written, so a row the\n239:  * corpus refuses leaves no output file behind. A line whose locator names no\n240:  * checkout keeps null offer fields and its own error code, and the rest of the\n241:  * log is still written.\n242:  *\n243:  * @param {object} options\n244:  * @param {string} options.inPath - Run log to read.\n245:  * @param {string} options.outPath - New run log to write.\n246:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n247:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n248:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n249:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n250:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n251:  *   injectable for tests.\n252:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n253:  *   | { ok: false, code: string, detail: string }>}\n254:  */\n255: export async function backfillRunLog({\n256:   inPath,\n257:   outPath,\n258:   promptFor,\n259:   replay = replayOffer,\n260:   brief = briefDelivered,\n261:   warm = warmCheckout,\n262: }) {\n263:   if (resolve(outPath) === resolve(inPath)) {\n264:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n265:   }\n266: \n267:   const rows = [];\n268:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n269:     if (raw.trim() === '') continue;\n270:     rows.push(JSON.parse(raw));\n271:   }\n272: \n273:   const prompts = [];\n274:   for (const row of rows) {\n275:     try {\n276:       prompts.push(promptFor(row.rowId));\n277:     } catch (error) {\n278:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n279:     }\n280:   }\n281: \n282:   const warmed = new Set();\n283:   const output = [];\n284:   for (let index = 0; index < rows.length; index += 1) {\n285:     const line = rows[index];\n286:     const rowId = line.rowId;\n287:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n288:       ? line.locator\n289:       : null;\n290:     const projectDir = locator?.projectDir;\n291:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n292: \n293:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n294:     if (checkoutDir !== null) {\n295:       if (!warmed.has(checkoutDir)) {\n296:         warmed.add(checkoutDir);\n297:         try {\n298:           await warm(checkoutDir);\n299:         } catch {\n300:           // A failed warm-up still lets the replay report its own miss.\n301:         }\n302:       }\n303:       offer = await replay({\n304:         checkoutDir,\n305:         prompt: prompts[index],\n306:         sessionId: `backfill-${rowId}`,\n307:       });\n308:     }\n309: \n310:     // Pi keeps its brief in a session store rather than a transcript, so the\n311:     // shared reader travels with every call. A runtime that has no reader for\n312:     // its store ignores it and answers `unknown`.\n313:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n314: \n315:     output.push({\n316:       ...line,\n317:       offeredCommand: offer.offeredCommand ?? null,\n318:       offeredPolicy: offer.offeredPolicy ?? null,\n319:       offerError: offer.offerError ?? null,\n320:       briefDelivered: delivered,\n321:       offerBackfilled: true,\n322:     });\n323:   }\n324: \n325:   mkdirSync(dirname(outPath), { recursive: true });\n326:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n327:   return { ok: true, lines: output.length, outPath };\n328: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794545778473,"end":1794545778977}}}}
