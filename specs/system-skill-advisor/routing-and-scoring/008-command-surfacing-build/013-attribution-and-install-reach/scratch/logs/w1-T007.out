{"type":"tool_use","timestamp":1794545792455,"sessionID":"ses_e2cbe0d40ffeJEGbl89dN2X2ox","part":{"partID":"prt_1d343b413001hm2ZJ1m8Qk6MaJ","sessionID":"ses_e2cbe0d40ffeJEGbl89dN2X2ox","messageID":"msg_1d343a0b0001hfSBcyrj69sqtP","type":"tool","id":"call_dcdc33a35aad4227858dd4b1","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs, lines 1-214\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Codex runs a project hook only after the operator approves that exact entry.\n8: // The approval lives in config.toml under a hooks.state key as a trusted_hash,\n9: // and an unapproved entry is skipped without a warning. A wired advisor hook can\n10: // therefore be present in .codex/hooks.json and still never deliver a brief,\n11: // which no diff can tell apart from a hook that was never wired.\n12: //\n13: // This check is read-only on purpose. The approval belongs to the /hooks review\n14: // in a Codex session, so the repair line names that step instead of offering to\n15: // copy a hash. The hash value stays out of every output because echoing a\n16: // credential serves no diagnostic purpose.\n17: //\n18: // Exit codes:\n19: //   0  the project has no hooks file, or the advisor entry is approved\n20: //   1  the advisor entry is absent, or present and unapproved\n21: //   2  bad argument\n22: //\n23: // Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n24: //   --root    project root whose .codex/hooks.json is read, defaults to the cwd\n25: //   --config  Codex config file, defaults to $CODEX_HOME/config.toml\n26: //   --json    print one JSON object instead of the text lines\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: const fs = require('node:fs');\n33: const os = require('node:os');\n34: const path = require('node:path');\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const ADVISOR_MARKER = 'hooks/codex/user-prompt-submit.js';\n41: const EVENT_KEY = 'user_prompt_submit';\n42: const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n43: \n44: // ─────────────────────────────────────────────────────────────────────────────\n45: // 3. HELPERS\n46: // ─────────────────────────────────────────────────────────────────────────────\n47: \n48: // A misspelled or value-less flag must fail loudly rather than read another root.\n49: function parseArgs(argv) {\n50:   const options = { root: process.cwd(), config: null, json: false };\n51:   for (let index = 0; index < argv.length; index += 1) {\n52:     const arg = argv[index];\n53:     if (arg === '--json') {\n54:       options.json = true;\n55:       continue;\n56:     }\n57:     if (arg === '--root' || arg === '--config') {\n58:       const value = argv[index + 1];\n59:       if (value === undefined || value === '') return null;\n60:       options[arg.slice(2)] = value;\n61:       index += 1;\n62:       continue;\n63:     }\n64:     return null;\n65:   }\n66:   return options;\n67: }\n68: \n69: function defaultConfigFile() {\n70:   const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');\n71:   return path.join(codexHome, 'config.toml');\n72: }\n73: \n74: function trimSeparators(value) {\n75:   const trimmed = value.replace(/[\\\\/]+$/, '');\n76:   return trimmed === '' ? value : trimmed;\n77: }\n78: \n79: // Codex keys an approval by the hooks file, the event, the group and the hook\n80: // index, so any edit that moves the advisor entry needs a fresh approval. The\n81: // caller may pass a relative or symlinked root while Codex recorded the real\n82: // path, so both forms are tried.\n83: function hookStateKeys(root, group, index) {\n84:   const roots = [trimSeparators(root)];\n85:   try {\n86:     roots.push(trimSeparators(fs.realpathSync(root)));\n87:   } catch {\n88:     // A root that cannot be resolved has only the form the caller gave.\n89:   }\n90:   const keys = [];\n91:   for (const base of roots) {\n92:     const key = `${base}/.codex/hooks.json:${EVENT_KEY}:${group}:${index}`;\n93:     if (!keys.includes(key)) keys.push(key);\n94:   }\n95:   return keys;\n96: }\n97: \n98: // An unparseable hooks file cannot hold a findable entry, so it takes the same\n99: // verdict as a file that lacks the entry. Either way the hook cannot run.\n100: function findAdvisorEntry(hooksFile) {\n101:   if (!fs.existsSync(hooksFile)) return { kind: 'skip' };\n102:   let document;\n103:   try {\n104:     document = JSON.parse(fs.readFileSync(hooksFile, 'utf8'));\n105:   } catch {\n106:     return { kind: 'absent' };\n107:   }\n108:   const groups = document?.hooks?.UserPromptSubmit;\n109:   if (!Array.isArray(groups)) return { kind: 'absent' };\n110:   for (const [groupIndex, group] of groups.entries()) {\n111:     const hooks = Array.isArray(group?.hooks) ? group.hooks : [];\n112:     for (const [hookIndex, hook] of hooks.entries()) {\n113:       if (typeof hook?.command === 'string' && hook.command.includes(ADVISOR_MARKER)) {\n114:         return { kind: 'present', group: groupIndex, index: hookIndex };\n115:       }\n116:     }\n117:   }\n118:   return { kind: 'absent' };\n119: }\n120: \n121: // The approval block ends at the next TOML header, so a trusted_hash recorded\n122: // under a different hooks.state key must not count for this entry.\n123: function approvalFound(configFile, keys) {\n124:   let text;\n125:   try {\n126:     text = fs.readFileSync(configFile, 'utf8');\n127:   } catch {\n128:     return false;\n129:   }\n130:   const lines = text.split(/\\r?\\n/);\n131:   const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n132:   for (let index = 0; index < lines.length; index += 1) {\n133:     if (!headers.has(lines[index].trim())) continue;\n134:     for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n135:       const line = lines[cursor].trim();\n136:       if (line.startsWith('[')) break;\n137:       if (/^trusted_hash\\s*=/.test(line)) return true;\n138:     }\n139:   }\n140:   return false;\n141: }\n142: \n143: function report(options, verdict, lines) {\n144:   if (options.json) {\n145:     process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n146:     return;\n147:   }\n148:   for (const line of lines) process.stdout.write(`${line}\\n`);\n149: }\n150: \n151: // ─────────────────────────────────────────────────────────────────────────────\n152: // 4. CORE LOGIC\n153: // ─────────────────────────────────────────────────────────────────────────────\n154: \n155: function main(argv) {\n156:   const options = parseArgs(argv);\n157:   if (options === null) {\n158:     process.stderr.write(USAGE);\n159:     return 2;\n160:   }\n161: \n162:   const root = options.root;\n163:   const hooksFile = path.join(root, '.codex', 'hooks.json');\n164:   const entry = findAdvisorEntry(hooksFile);\n165: \n166:   if (entry.kind === 'skip') {\n167:     report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n168:     return 0;\n169:   }\n170: \n171:   if (entry.kind === 'absent') {\n172:     report(options, {\n173:       status: 'warn',\n174:       code: 'codex-advisor-hook-absent',\n175:       root,\n176:       hooksFile,\n177:     }, ['WARN codex-advisor-hook-absent']);\n178:     return 1;\n179:   }\n180: \n181:   const configFile = options.config || defaultConfigFile();\n182:   const keys = hookStateKeys(root, entry.group, entry.index);\n183:   if (approvalFound(configFile, keys)) {\n184:     report(options, {\n185:       status: 'pass',\n186:       code: 'codex-hooks-approved',\n187:       root,\n188:       group: entry.group,\n189:       index: entry.index,\n190:       config: configFile,\n191:     }, ['PASS codex-hooks-approved']);\n192:     return 0;\n193:   }\n194: \n195:   const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n196:   report(options, {\n197:     status: 'warn',\n198:     code: 'codex-hooks-unapproved',\n199:     root,\n200:     group: entry.group,\n201:     index: entry.index,\n202:     config: configFile,\n203:     repair,\n204:   }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n205:   return 1;\n206: }\n207: \n208: // ─────────────────────────────────────────────────────────────────────────────\n209: // 5. ENTRY POINT\n210: // ─────────────────────────────────────────────────────────────────────────────\n211: \n212: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n213: \n214: module.exports = { main, findAdvisorEntry, approvalFound };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs, lines 1-214\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Codex runs a project hook only after the operator approves that exact entry.\n8: // The approval lives in config.toml under a hooks.state key as a trusted_hash,\n9: // and an unapproved entry is skipped without a warning. A wired advisor hook can\n10: // therefore be present in .codex/hooks.json and still never deliver a brief,\n11: // which no diff can tell apart from a hook that was never wired.\n12: //\n13: // This check is read-only on purpose. The approval belongs to the /hooks review\n14: // in a Codex session, so the repair line names that step instead of offering to\n15: // copy a hash. The hash value stays out of every output because echoing a\n16: // credential serves no diagnostic purpose.\n17: //\n18: // Exit codes:\n19: //   0  the project has no hooks file, or the advisor entry is approved\n20: //   1  the advisor entry is absent, or present and unapproved\n21: //   2  bad argument\n22: //\n23: // Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n24: //   --root    project root whose .codex/hooks.json is read, defaults to the cwd\n25: //   --config  Codex config file, defaults to $CODEX_HOME/config.toml\n26: //   --json    print one JSON object instead of the text lines\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: const fs = require('node:fs');\n33: const os = require('node:os');\n34: const path = require('node:path');\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const ADVISOR_MARKER = 'hooks/codex/user-prompt-submit.js';\n41: const EVENT_KEY = 'user_prompt_submit';\n42: const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n43: \n44: // ─────────────────────────────────────────────────────────────────────────────\n45: // 3. HELPERS\n46: // ─────────────────────────────────────────────────────────────────────────────\n47: \n48: // A misspelled or value-less flag must fail loudly rather than read another root.\n49: function parseArgs(argv) {\n50:   const options = { root: process.cwd(), config: null, json: false };\n51:   for (let index = 0; index < argv.length; index += 1) {\n52:     const arg = argv[index];\n53:     if (arg === '--json') {\n54:       options.json = true;\n55:       continue;\n56:     }\n57:     if (arg === '--root' || arg === '--config') {\n58:       const value = argv[index + 1];\n59:       if (value === undefined || value === '') return null;\n60:       options[arg.slice(2)] = value;\n61:       index += 1;\n62:       continue;\n63:     }\n64:     return null;\n65:   }\n66:   return options;\n67: }\n68: \n69: function defaultConfigFile() {\n70:   const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');\n71:   return path.join(codexHome, 'config.toml');\n72: }\n73: \n74: function trimSeparators(value) {\n75:   const trimmed = value.replace(/[\\\\/]+$/, '');\n76:   return trimmed === '' ? value : trimmed;\n77: }\n78: \n79: // Codex keys an approval by the hooks file, the event, the group and the hook\n80: // index, so any edit that moves the advisor entry needs a fresh approval. The\n81: // caller may pass a relative or symlinked root while Codex recorded the real\n82: // path, so both forms are tried.\n83: function hookStateKeys(root, group, index) {\n84:   const roots = [trimSeparators(root)];\n85:   try {\n86:     roots.push(trimSeparators(fs.realpathSync(root)));\n87:   } catch {\n88:     // A root that cannot be resolved has only the form the caller gave.\n89:   }\n90:   const keys = [];\n91:   for (const base of roots) {\n92:     const key = `${base}/.codex/hooks.json:${EVENT_KEY}:${group}:${index}`;\n93:     if (!keys.includes(key)) keys.push(key);\n94:   }\n95:   return keys;\n96: }\n97: \n98: // An unparseable hooks file cannot hold a findable entry, so it takes the same\n99: // verdict as a file that lacks the entry. Either way the hook cannot run.\n100: function findAdvisorEntry(hooksFile) {\n101:   if (!fs.existsSync(hooksFile)) return { kind: 'skip' };\n102:   let document;\n103:   try {\n104:     document = JSON.parse(fs.readFileSync(hooksFile, 'utf8'));\n105:   } catch {\n106:     return { kind: 'absent' };\n107:   }\n108:   const groups = document?.hooks?.UserPromptSubmit;\n109:   if (!Array.isArray(groups)) return { kind: 'absent' };\n110:   for (const [groupIndex, group] of groups.entries()) {\n111:     const hooks = Array.isArray(group?.hooks) ? group.hooks : [];\n112:     for (const [hookIndex, hook] of hooks.entries()) {\n113:       if (typeof hook?.command === 'string' && hook.command.includes(ADVISOR_MARKER)) {\n114:         return { kind: 'present', group: groupIndex, index: hookIndex };\n115:       }\n116:     }\n117:   }\n118:   return { kind: 'absent' };\n119: }\n120: \n121: // The approval block ends at the next TOML header, so a trusted_hash recorded\n122: // under a different hooks.state key must not count for this entry.\n123: function approvalFound(configFile, keys) {\n124:   let text;\n125:   try {\n126:     text = fs.readFileSync(configFile, 'utf8');\n127:   } catch {\n128:     return false;\n129:   }\n130:   const lines = text.split(/\\r?\\n/);\n131:   const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n132:   for (let index = 0; index < lines.length; index += 1) {\n133:     if (!headers.has(lines[index].trim())) continue;\n134:     for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n135:       const line = lines[cursor].trim();\n136:       if (line.startsWith('[')) break;\n137:       if (/^trusted_hash\\s*=/.test(line)) return true;\n138:     }\n139:   }\n140:   return false;\n141: }\n142: \n143: function report(options, verdict, lines) {\n144:   if (options.json) {\n145:     process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n146:     return;\n147:   }\n148:   for (const line of lines) process.stdout.write(`${line}\\n`);\n149: }\n150: \n151: // ─────────────────────────────────────────────────────────────────────────────\n152: // 4. CORE LOGIC\n153: // ─────────────────────────────────────────────────────────────────────────────\n154: \n155: function main(argv) {\n156:   const options = parseArgs(argv);\n157:   if (options === null) {\n158:     process.stderr.write(USAGE);\n159:     return 2;\n160:   }\n161: \n162:   const root = options.root;\n163:   const hooksFile = path.join(root, '.codex', 'hooks.json');\n164:   const entry = findAdvisorEntry(hooksFile);\n165: \n166:   if (entry.kind === 'skip') {\n167:     report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n168:     return 0;\n169:   }\n170: \n171:   if (entry.kind === 'absent') {\n172:     report(options, {\n173:       status: 'warn',\n174:       code: 'codex-advisor-hook-absent',\n175:       root,\n176:       hooksFile,\n177:     }, ['WARN codex-advisor-hook-absent']);\n178:     return 1;\n179:   }\n180: \n181:   const configFile = options.config || defaultConfigFile();\n182:   const keys = hookStateKeys(root, entry.group, entry.index);\n183:   if (approvalFound(configFile, keys)) {\n184:     report(options, {\n185:       status: 'pass',\n186:       code: 'codex-hooks-approved',\n187:       root,\n188:       group: entry.group,\n189:       index: entry.index,\n190:       config: configFile,\n191:     }, ['PASS codex-hooks-approved']);\n192:     return 0;\n193:   }\n194: \n195:   const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n196:   report(options, {\n197:     status: 'warn',\n198:     code: 'codex-hooks-unapproved',\n199:     root,\n200:     group: entry.group,\n201:     index: entry.index,\n202:     config: configFile,\n203:     repair,\n204:   }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n205:   return 1;\n206: }\n207: \n208: // ─────────────────────────────────────────────────────────────────────────────\n209: // 5. ENTRY POINT\n210: // ─────────────────────────────────────────────────────────────────────────────\n211: \n212: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n213: \n214: module.exports = { main, findAdvisorEntry, approvalFound };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\"}"},"time":{"start":1794545792020,"end":1794545792455}}}}
