line of a head.\n49:  *\n50:  * The policy only counts when it directly follows the command, so a `(ask)`\n51:  * that belongs to a later clause cannot attach itself to an earlier match.\n52:  *\n53:  * @param {string} head - One line of advisor output.\n54:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n55:  */\n56: export function parseOffer(head) {\n57:   const text = typeof head === 'string' ? head : '';\n58:   const match = text.match(OFFER_PATTERN);\n59:   if (!match) {\n60:     return { offeredCommand: null, offeredPolicy: null };\n61:   }\n62:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n63:   return {\n64:     offeredCommand: match[0],\n65:     offeredPolicy: policy ? policy[1] : null,\n66:   };\n67: }\n68: \n69: /**\n70:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n71:  *\n72:  * The hook is resolved from the checkout rather than from this module, so a\n73:  * backfill records what that checkout's advisor would have offered at the time\n[Output truncated. Continue reading with offset: 74]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 24-73\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: import { fileURLToPath } from 'node:url';\n29: \n30: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n31: \n32: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n33: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n34: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?