{"type":"tool_use","timestamp":1794545753766,"sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","part":{"partID":"prt_1d3431cf6001XNbHIrIY5l4gID","sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","messageID":"msg_1d34311c2001Loxu94Lba6cR7v","type":"tool","id":"call_204bd3d8bb1f47e4baf22fb9","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1045\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template can be in any of seven\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\n9: // release behind, or edited in place; its own content may sit in the marked block or be\n10: // scattered between shipped sections; it may have no root document at all. Without that\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\n13: // without writing a byte, what the repository holds against the manifest.\n14: //\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n18: // tests and an owner, so each is run as a child process and its own lines are carried\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\n20: // from the first. The rest are pure classifiers over one read of the target tree.\n21: //\n22: // The run is read-only by construction: the only paths it opens for reading are under\n23: // the target root plus the manifest, and the three child tools it runs are read-only\n24: // modes. A repository that cannot be classified at all (no manifest, no target\n25: // directory, an unreadable root document) is a failed precondition and exits 2, because\n26: // an empty report would read like a clean one.\n27: //\n28: // Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n29: //   --root <dir>      classify this repository instead of the one this script ships in\n30: //   --manifest <path> read this manifest instead of the shipped one\n31: //   --source          run the template-purity row even outside the source repository\n32: //   --json            print one JSON object instead of the text report\n33: // Exit codes: 0 nothing to report, 1 at least one finding or an unproven row,\n34: //             2 a precondition failed\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 1. IMPORTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const { spawnSync } = require('node:child_process');\n41: const fs = require('node:fs');\n42: const path = require('node:path');\n43: \n44: const {\n45:   classifyBody,\n46:   deliveryAnchorEnd,\n47:   matchSections,\n48:   segment,\n49: } = require('./lib/agents-md-sections.cjs');\n50: const { sourceStatus } = require('./agents-md-manifest.cjs');\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const TAG = '[agents-md-check]';\n57: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n58: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n60: // The router checker ships beside the skill that authors rules, and the manifest links\n61: // it only through the router's own row, so its path is named here once.\n62: const REPO_RULES_CHECKER = path.resolve(\n63:   REPO_ROOT,\n64:   '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n65: );\n66: // The checker's own tag prefix. Matching on it is what keeps this row a carrier of that\n67: // tool's verdict instead of a second implementation of its checks.\n68: const REPO_RULES_TAG = '[repo-rules-check]';\n69: const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n70: const TOOL_TIMEOUT_MS = 120000;\n71: \n72: // A repository where fewer than half the shipped sections survive is carrying its own\n73: // document, not a copy of the template. Above the line the question becomes which parts\n74: // of the template are still there, which is a per-section answer.\n75: const FOREIGN_SHARE = 0.5;\n76: \n77: const PASS = 'PASS';\n78: const FINDING = 'FINDING';\n79: const UNKNOWN = 'UNKNOWN';\n80: const INFO = 'INFO';\n81: \n82: class UsageError extends Error {}\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 3. ARGUMENTS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function parseArgs(argv) {\n89:   const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n90:   for (let index = 0; index < argv.length; index += 1) {\n91:     const argument = argv[index];\n92:     if (argument === '--root') {\n93:       const value = argv[index + 1];\n94:       if (!value || value.startsWith('--')) throw new UsageError('--root needs a directory');\n95:       options.root = path.resolve(value);\n96:       index += 1;\n97:     } else if (argument === '--manifest') {\n98:       const value = argv[index + 1];\n99:       if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n100:       options.manifest = path.resolve(value);\n101:       index += 1;\n102:     } else if (argument === '--source') {\n103:       options.source = true;\n104:     } else if (argument === '--json') {\n105:       options.json = true;\n106:     } else if (argument === '--help' || argument === '-h') {\n107:       options.help = true;\n108:     } else {\n109:       throw new UsageError(`unknown argument: ${argument}`);\n110:     }\n111:   }\n112:   return options;\n113: }\n114: \n115: // ─────────────────────────────────────────────────────────────────────────────\n116: // 4. READING THE TARGET ONCE\n117: // ─────────────────────────────────────────────────────────────────────────────\n118: \n119: // Section offsets are byte offsets because the delivery budget is a byte count, while a\n120: // reader opens the file by line number. One conversion, in one place.\n121: function lineNumberAt(text, byteOffset) {\n122:   return Buffer.from(text, 'utf8').subarray(0, byteOffset).toString('utf8').split('\\n').length;\n123: }\n124: \n125: function trimmedLines(text) {\n126:   const lines = new Set();\n127:   for (const raw of String(text).split('\\n')) {\n128:     const line = raw.trim();\n129:     if (line !== '' && line !== '---') lines.add(line);\n130:   }\n131:   return lines;\n132: }\n133: \n134: // The repository's own lines, in order and with repeats. A set would report one line for\n135: // two occurrences, and a replacement loses both, so a duplicate is a second line to keep.\n136: function localLinesOf(body, reference) {\n137:   const known = trimmedLines(reference);\n138:   const local = [];\n139:   for (const raw of body.split('\\n')) {\n140:     const line = raw.trim();\n141:     if (line === '' || line === '---' || known.has(line)) continue;\n142:     local.push(line);\n143:   }\n144:   return local;\n145: }\n146: \n147: function knownBodies(manifest) {\n148:   const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n149:   return {\n150:     current: Object.keys(sections).map((id) => ({ id, sha256: sections[id].sha256, body: sections[id].body })),\n151:     history: (manifest.derived && manifest.derived.history) || [],\n152:   };\n153: }\n154: \n155: // The block carries a heading and a note that the template itself ships, so \"the block is\n156: // empty\" means nothing beyond those two lines, not that the markers bracket no text.\n157: function blockHasContent(block, markers) {\n158:   if (!block || !block.complete) return false;\n159:   const shipped = new Set([markers.heading.trim(), markers.note.trim()]);\n160:   for (const raw of block.content.split('\\n')) {\n161:     const line = raw.trim();\n162:     if (line === '' || shipped.has(line)) continue;\n163:     return true;\n164:   }\n165:   return false;\n166: }\n167: \n168: /**\n169:  * Read the target tree once and keep what every row needs.\n170:  *\n171:  * @param {{root: string, manifest: Object}} input\n172:  * @returns {Object|null} Null when the root directory is not there.\n173:  */\n174: function readTarget({ root, manifest }) {\n175:   if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) return null;\n176: \n177:   const rootPath = path.join(root, manifest.root_file);\n178:   const exists = fs.existsSync(rootPath);\n179:   const text = exists ? fs.readFileSync(rootPath, 'utf8') : null;\n180:   const segmentation = exists\n181:     ? segment(text, manifest.markers, manifest.sections)\n182:     : { sections: [], block: null, prelude: null };\n183:   const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n184: \n185:   return {\n186:     root,\n187:     rootPath,\n188:     exists,\n189:     text,\n190:     totalBytes: exists ? Buffer.byteLength(text, 'utf8') : 0,\n191:     block: segmentation.block,\n192:     prelude: segmentation.prelude,\n193:     sections: segmentation.sections,\n194:     matched: pairing.matched,\n195:     unregistered: pairing.unregistered,\n196:     unmatched: pairing.unmatched,\n197:     conflicts: pairing.conflicts,\n198:     currency: pairing.matched.map((row) => ({\n199:       id: row.entry.id,\n200:       section: row.section,\n201:       ...classifyBody(row.section.body, knownBodies(manifest)),\n202:     })),\n203:     blockContent: blockHasContent(segmentation.block, manifest.markers),\n204:   };\n205: }\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. THE TWELVE ROWS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: function row(id, name, state, detail, extra = {}) {\n212:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n213: }\n214: \n215: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n216: function rowInstallState(context, manifest) {\n217:   const claudePath = path.join(context.root, 'CLAUDE.md');\n218:   if (!context.exists) {\n219:     if (fs.existsSync(claudePath)) {\n220:       return row('A1', 'install state', FINDING, 'claude-only',\n221:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n222:     }\n223:     return row('A1', 'install state', FINDING, 'absent',\n224:       { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n225:   }\n226: \n227:   const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n228:   if (share < FOREIGN_SHARE) {\n229:     return row('A1', 'install state', FINDING, 'foreign', {\n230:       lines: [\n231:         `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n232:         'the root document is the repository\\'s own file',\n233:       ],\n234:     });\n235:   }\n236: \n237:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n238:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n239:   // A local edit outranks a missed release in the reading order: it is the shape that\n240:   // loses text if somebody replaces the document, and staleness only loses a patch.\n241:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n242:     const lines = [];\n243:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n244:     for (const entry of context.unregistered) {\n245:       lines.push(entry.heading === null\n246:         ? 'unmarked text before the first heading'\n247:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n248:     }\n249:     return row('A1', 'install state', FINDING, 'forked', { lines });\n250:   }\n251:   if (behind.length > 0) {\n252:     return row('A1', 'install state', FINDING, 'stale',\n253:       { lines: behind.map((entry) => `${entry.id}: ${entry.state}`) });\n254:   }\n255:   if (context.blockContent) {\n256:     return row('A1', 'install state', PASS, 'adopted',\n257:       { lines: ['every shipped section is current and the repository block carries content'] });\n258:   }\n259:   return row('A1', 'install state', PASS, 'pure',\n260:     { lines: ['every shipped section is current and the repository block is empty'] });\n261: }\n262: \n263: // A2. Which shipped sections survived, by the prefix each authored entry carries.\n264: function rowSectionsPresent(context, manifest) {\n265:   const present = new Set(context.matched.map((row_) => row_.entry.id));\n266:   const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n267:   const detail = `${present.size}/${manifest.sections.length} matched`;\n268:   if (missing.length === 0 && context.conflicts.length === 0) {\n269:     return row('A2', 'sections present', PASS, detail);\n270:   }\n271:   const lines = missing.map((id) => `missing section ${id}`);\n272:   for (const conflict of context.conflicts) lines.push(conflict.message);\n273:   return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n274:     lines,\n275:     entries: missing.map((id) => ({ id, present: false })),\n276:   });\n277: }\n278: \n279: // The byte offset of the first line that is exactly this text, or -1 when the document\n280: // does not carry it.\n281: function firstLineOffset(text, needle) {\n282:   if (text.startsWith(needle)) return 0;\n283:   const at = text.indexOf(`\\n${needle}`);\n284:   return at === -1 ? -1 : at + 1;\n285: }\n286: \n287: // The shipped numbering, read from the pin that names it. Hundreds of files cite these\n288: // numbers, and the document carries its fourth section before its third, so the citation\n289: // order is not the reading order and only the pin carries the expected one.\n290: function numberingReport(context, manifest) {\n291:   if (!context.exists) return { state: INFO, detail: 'no root document to number', lines: [] };\n292: \n293:   const pin = (manifest.pins || []).find((entry) => entry.kind === 'order');\n294:   if (!pin) return { state: INFO, detail: 'the manifest declares no numbering pin', lines: [] };\n295: \n296:   const found = [];\n297:   const absent = [];\n298:   for (const text of pin.texts) {\n299:     const at = firstLineOffset(context.text, text);\n300:     if (at === -1) absent.push(text.trim());\n301:     else found.push({ text: text.trim(), at });\n302:   }\n303:   const expected = pin.texts.map((text) => text.trim()).filter((text) => found.some((entry) => entry.text === text));\n304:   const actual = found.slice().sort((left, right) => left.at - right.at).map((entry) => entry.text);\n305: \n306:   const lines = absent.map((text) => `missing section number ${JSON.stringify(text)}`);\n307:   if (expected.join('|') !== actual.join('|')) {\n308:     lines.push(`the numbers appear as ${actual.join(', ')} instead of ${expected.join(', ')}`);\n309:   }\n310:   return { state: lines.length === 0 ? PASS : FINDING, detail: `${found.length}/${pin.texts.length} section numbers in place`, lines };\n311: }\n312: \n313: // A3. Shipped sections in manifest order, and section numbers unchanged.\n314: function rowOrderAndNumbering(context, manifest) {\n315:   const order = manifest.sections.map((entry) => entry.id);\n316:   const seen = context.matched.map((entry) => entry.entry.id);\n317:   const expected = order.filter((id) => seen.includes(id));\n318:   const numbering = numberingReport(context, manifest);\n319: \n320:   const lines = [...numbering.lines];\n321:   if (expected.join('|') !== seen.join('|')) {\n322:     const first = seen.findIndex((id, index) => id !== expected[index]);\n323:     lines.unshift(`section order differs at position ${first + 1}: found ${seen[first]}, expected ${expected[first]}`);\n324:   }\n325:   const state = lines.length === 0 ? PASS : FINDING;\n326:   return row('A3', 'order and numbering', state, state === PASS ? 'manifest order and section numbers unchanged' : 'order or numbering drifted', { lines });\n327: }\n328: \n329: // A4. Per section, whether the body is the shipped one, an older release, a local edit\n330: // or something with no base to name.\n331: function rowCurrency(context) {\n332:   const counts = { current: 0, 'stale-known': 0, edited: 0, 'unknown-base': 0 };\n333:   const entries = [];\n334:   for (const entry of context.currency) {\n335:     counts[entry.state] += 1;\n336:     entries.push({ id: entry.id, state: entry.state, base: entry.base || null });\n337:   }\n338:   // Nothing to classify is not a clean bill: the rows around this one report the empty or\n339:   // foreign document, and a pass here would read as currency that was checked.\n340:   if (entries.length === 0) {\n341:     return row('A4', 'section currency', INFO, 'no shipped section matched, so there is no body to classify');\n342:   }\n343:   const detail = `${counts.current} current, ${counts['stale-known']} stale-known, ${counts.edited} edited, ${counts['unknown-base']} unknown-base`;\n344:   const lines = [];\n345:   for (const entry of context.currency) {\n346:     if (entry.state === 'current') continue;\n347:     const base = entry.base ? entry.base.slice(0, 12) : 'none';\n348:     lines.push(`${entry.id}: ${entry.state} (closest known body ${base})`);\n349:   }\n350:   return row('A4', 'section currency', lines.length === 0 ? PASS : FINDING, detail, { lines, entries });\n351: }\n352: \n353: // A5. Every string downstream tooling greps out of the document, checked by its rule.\n354: function rowPins(context, manifest) {\n355:   const entries = [];\n356:   const byId = new Map(context.matched.map((entry) => [entry.entry.id, entry.section]));\n357: \n358:   for (const pin of manifest.pins || []) {\n359:     const verdict = pinVerdict(pin, context, manifest, byId);\n360:     entries.push({ id: pin.id, kind: pin.kind, state: verdict.state, detail: verdict.detail });\n361:   }\n362: \n363:   const failed = entries.filter((entry) => entry.state === FINDING);\n364:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n365:   const lines = failed.map((entry) => `${entry.id} (${entry.kind}): ${entry.detail}`);\n366:   for (const entry of unmeasured) lines.push(`${entry.id} (${entry.kind}): ${entry.detail}`);\n367:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n368:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} pins hold${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n369:   return row('A5', 'pins', state, detail, { lines, entries });\n370: }\n371: \n372: function pinVerdict(pin, context, manifest, byId) {\n373:   const section = pin.section ? byId.get(pin.section) : null;\n374:   if (pin.section && !section) {\n375:     return { state: FINDING, detail: `the section ${pin.section} that carries this pin is missing` };\n376:   }\n377: \n378:   switch (pin.kind) {\n379:     case 'exact': {\n380:       const missing = pin.texts.filter((text) => !section.body.includes(text));\n381:       return missing.length === 0\n382:         ? { state: PASS, detail: `all ${pin.texts.length} strings present in ${pin.section}` }\n383:         : { state: FINDING, detail: `missing ${JSON.stringify(missing[0])} in ${pin.section}` };\n384:     }\n385:     case 'line': {\n386:       const required = (pin.requires || pin.texts).map((text) => text.toLowerCase());\n387:       const hit = section.body.split('\\n').some((line) => {\n388:         const lower = line.toLowerCase();\n389:         return required.every((text) => lower.includes(text));\n390:       });\n391:       return hit\n392:         ? { state: PASS, detail: `a line in ${pin.section} carries ${required.join(', ')}` }\n393:         : { state: FINDING, detail: `no line in ${pin.section} carries ${required.join(', ')}` };\n394:     }\n395:     case 'first-occurrence': {\n396:       const at = context.text.indexOf(pin.texts[0]);\n397:       const inside = at >= section.start && at < section.end;\n398:       if (inside) return { state: PASS, detail: `the first occurrence sits inside ${pin.section}` };\n399:       return {\n400:         state: FINDING,\n401:         detail: at === -1\n402:           ? `the text ${JSON.stringify(pin.texts[0])} is absent`\n403:           : `the first occurrence at byte ${at} sits outside ${pin.section} (${section.start}..${section.end}), so anything reading the first line of the document follows it instead`,\n404:       };\n405:     }\n406:     case 'delivery-anchor': {\n407:       const end = deliveryAnchorEnd(section, pin);\n408:       if (end === null) return { state: FINDING, detail: `the anchor text is absent from ${pin.section}` };\n409:       const limit = manifest.budget.prefix_bytes;\n410:       return end <= limit\n411:         ? { state: PASS, detail: `${pin.section} ends at byte ${end}, inside ${limit}` }\n412:         : { state: FINDING, detail: `${pin.section} ends at byte ${end}, past the ${limit}-byte delivery prefix` };\n413:     }\n414:     case 'budget': {\n415:       const declared = manifest.budget[pin.limit_key];\n416:       const pinned = Number(pin.texts[0]);\n417:       return declared === pinned\n418:         ? { state: PASS, detail: `${pin.limit_key} is ${declared}` }\n419:         : { state: FINDING, detail: `${pin.limit_key} reads ${declared}, the pin says ${pinned}` };\n420:     }\n421:     case 'order': {\n422:       const numbering = numberingReport(context, manifest);\n423:       return { state: numbering.state, detail: numbering.detail };\n424:     }\n425:     case 'file': {\n426:       const target = path.join(context.root, pin.path);\n427:       return fs.existsSync(target)\n428:         ? { state: PASS, detail: `${pin.path} exists` }\n429:         : { state: FINDING, detail: `${pin.path} is missing` };\n430:     }\n431:     default:\n432:       // A kind the engine has no rule for is a pin nobody measured. Counting it as a hold\n433:       // would report a manifest edit as verified.\n434:       return { state: UNKNOWN, detail: `no rule for a pin of kind ${pin.kind}` };\n435:   }\n436: }\n437: \n438: // A6. The delivery budget: the canary's own AGENTS.md lines, plus the two measurements\n439: // the report needs. Only this row's file is kept, because the canary also pins the skill\n440: // it ships in and a consumer legitimately has none of those.\n441: function rowBudget(context, manifest, tools) {\n442:   if (typeof tools.canary !== 'string' || !fs.existsSync(tools.canary)) {\n443:     return row('A6', 'delivery budget', UNKNOWN,\n444:       `the rule-copy canary is not installed at ${tools.canary || '(no path)'}; the budget cannot be measured`);\n445:   }\n446: \n447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n448:     encoding: 'utf8',\n449:     timeout: TOOL_TIMEOUT_MS,\n450:     maxBuffer: 16 * 1024 * 1024,\n451:   });\n452:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n453:   if (run.error || (run.status !== 0 && run.status !== 1)) {\n454:     return row('A6', 'delivery budget', UNKNOWN,\n455:       `the rule-copy canary could not run: ${run.error ? run.error.message : `exit ${run.status}`}`);\n456:   }\n457: \n458:   // The canary prints its verdict, an anchor table and its findings. Only the findings\n459:   // that name this document belong to this row; its PASS and table lines are its own\n460:   // report, and the anchor end byte is measured below instead of parsed back out.\n461:   const own = output\n462:     .filter((line) => line.includes(manifest.root_file))\n463:     .filter((line) => /^(MISSING|BLOCKED):/u.test(line));\n464:   const elsewhere = output.filter((line) => !line.includes(manifest.root_file));\n465: \n466:   const limit = manifest.budget.prefix_bytes;\n467:   const ceiling = manifest.budget.max_bytes;\n468:   const prefixEnd = (manifest.pins || [])\n469:     .filter((pin) => pin.kind === 'delivery-anchor')\n470:     .reduce((max, pin) => {\n471:       const section = context.matched.find((entry) => entry.entry.id === pin.section);\n472:       if (!section) return max;\n473:       const end = deliveryAnchorEnd(section.section, pin);\n474:       return end === null ? max : Math.max(max, end);\n475:     }, 0);\n476: \n477:   const failures = [...own];\n478:   // The canary already names whatever it measured, so this row adds a figure only for a\n479:   // defect the canary did not report, instead of printing the same ceiling twice.\n480:   if (prefixEnd > limit && !own.some((line) => line.includes('delivery prefix'))) {\n481:     failures.push(`the last anchor ends at byte ${prefixEnd}, past the ${limit}-byte delivery prefix`);\n482:   }\n483:   if (context.totalBytes > ceiling && !own.some((line) => line.includes('ceiling'))) {\n484:     failures.push(`${context.totalBytes} bytes exceeds the ${ceiling}-byte ceiling`);\n485:   }\n486:   // A failing canary that names other files only is still a fact worth stating, because\n487:   // its exit status would otherwise read as this row's verdict. A passing one needs no\n488:   // note: its remaining lines are its own anchor table.\n489:   const notes = failures.length === 0 && run.status !== 0 && elsewhere.length > 0\n490:     ? [`the canary exits ${run.status} over ${elsewhere.length} line(s) outside ${manifest.root_file}, which belong to other files' pins`]\n491:     : [];\n492: \n493:   return row('A6', 'delivery budget', failures.length === 0 ? PASS : FINDING,\n494:     `${prefixEnd} of ${limit} bytes to the last anchor, ${context.totalBytes} of ${ceiling} bytes total`,\n495:     { lines: [...failures, ...notes] });\n496: }\n497: \n498: // A7. The repository block: one start marker line, one end marker line, in that order,\n499: // after every shipped section, small enough to leave headroom. A marker is the whole line,\n500: // so the same bytes quoted inside a sentence are prose and do not make a second block.\n501: function rowBlock(context, manifest) {\n502:   const { budget } = manifest;\n503:   const block = context.block;\n504:   const starts = block === null ? 0 : block.markerLines.start.length;\n505:   const ends = block === null ? 0 : block.markerLines.end.length;\n506: \n507:   if (starts === 0 && ends === 0) {\n508:     return row('A7', 'repo-local block', PASS, `no block; ${context.totalBytes} of ${budget.max_bytes} bytes used`);\n509:   }\n510:   if (starts !== 1 || ends !== 1) {\n511:     const lines = ['the block cannot be placed, so nothing inside it can be carried'];\n512:     const where = [];\n513:     if (block !== null && starts > 0) where.push(`the start marker sits on line ${block.markerLines.start.join(' and line ')}`);\n514:     if (block !== null && ends > 0) where.push(`the end marker on line ${block.markerLines.end.join(' and line ')}`);\n515:     if (where.length > 0) lines.push(where.join(', '));\n516:     return row('A7', 'repo-local block', FINDING,\n517:       `expected one start and one end marker line, found ${starts} and ${ends}`, { lines });\n518:   }\n519: \n520:   const lines = [];\n521:   if (!block || !block.complete) {\n522:     lines.push('the end marker sits before the start marker, so the block is out of order and unreadable');\n523:   }\n524:   // Whatever the document carries below the block is content a replacement has to place\n525:   // around the block, so a block above it cannot be the one block a rewrite writes last.\n526:   const following = block === null ? [] : context.sections.filter((section) => section.start > block.start);\n527:   if (block && block.complete && following.length > 0) {\n528:     lines.push(`the block starts at byte ${block.start}, before ${following.length} section(s) that follow it (the first is ${JSON.stringify(following[0].heading)} at byte ${following[0].start})`);\n529:   }\n530:   if (block && block.complete && block.start < budget.prefix_bytes) {\n531:     lines.push(`the block starts at byte ${block.start}, inside the ${budget.prefix_bytes}-byte delivery prefix`);\n532:   }\n533:   if (context.totalBytes > budget.max_bytes) {\n534:     lines.push(`${context.totalBytes} bytes exceeds the ${budget.max_bytes}-byte ceiling`);\n535:   }\n536: \n537:   const size = block && block.complete ? Buffer.byteLength(block.content, 'utf8') : 0;\n538:   const headroom = budget.max_bytes - context.totalBytes;\n539:   const detail = block && block.complete\n540:     ? `block ${size} bytes, ${headroom} bytes of headroom`\n541:     : `block unreadable, ${headroom} bytes of headroom`;\n542:   return row('A7', 'repo-local block', lines.length === 0 ? PASS : FINDING, detail,\n543:     { lines, entries: [{ size, headroom, complete: Boolean(block && block.complete) }] });\n544: }\n545: \n546: // A8. Repository content outside the block that matches no shipped section. This is the\n547: // content a replacement would drop, so it is reported by line and byte range. The text\n548: // above the first heading has no heading to match, and arrives here with a null one.\n549: function rowUnmarked(context, manifest) {\n550:   const prefixBytes = manifest.budget.prefix_bytes;\n551:   const entries = context.unregistered.map((entry) => ({\n552:     heading: entry.heading,\n553:     line_start: lineNumberAt(context.text, entry.start),\n554:     line_end: lineNumberAt(context.text, Math.max(entry.start, entry.end - 1)),\n555:     byte_start: entry.start,\n556:     byte_end: entry.end,\n557:     in_prefix: entry.start < prefixBytes,\n558:   }));\n559:   if (entries.length === 0) return row('A8', 'unmarked repo-unique content', PASS, 'no section outside the block');\n560: \n561:   const headings = entries.filter((entry) => entry.heading !== null).length;\n562:   const detail = [];\n563:   if (headings > 0) detail.push(`${headings} section(s) outside the block match no shipped section`);\n564:   if (entries.length > headings) detail.push('the text above the first heading is repository content no section carries');\n565: \n566:   return row('A8', 'unmarked repo-unique content', FINDING,\n567:     detail.join('; '),\n568:     {\n569:       lines: entries.map((entry) => `${entry.heading === null ? 'text before the first heading' : JSON.stringify(entry.heading)}: lines ${entry.line_start}-${entry.line_end}, bytes ${entry.byte_start}-${entry.byte_end}${entry.in_prefix ? ', inside the delivery prefix' : ''}`),\n570:       entries,\n571:     });\n572: }\n573: \n574: // The line where two bodies first part company, with the two raw lines. A body can carry\n575: // every line the shipped body carries and still not be it — an extra space on an indent, a\n576: // line written twice, two lines swapped — and the operator needs the line to look at\n577: // rather than a finding with nothing under it.\n578: function bodyDifference(actual, expected) {\n579:   const left = String(actual).split('\\n');\n580:   const right = String(expected).split('\\n');\n581:   const last = Math.max(left.length, right.length);\n582:   for (let index = 0; index < last; index += 1) {\n583:     if (left[index] === right[index]) continue;\n584:     return {\n585:       line: index + 1,\n586:       actual: left[index] === undefined ? null : left[index],\n587:       shipped: right[index] === undefined ? null : right[index],\n588:     };\n589:   }\n590:   return null;\n591: }\n592: \n593: // A9. For a section that is not the shipped body, the lines the shipped body does not\n594: // carry, once per occurrence. A body that carries every shipped line can still differ, so\n595: // the row names that difference by line instead of reporting a finding with no line under\n596: // it: a finding nobody can act on reads like a bug in the checker.\n597: function rowUnmarkedEdits(context, manifest) {\n598:   const entries = [];\n599:   for (const entry of context.currency) {\n600:     if (entry.state !== 'edited' && entry.state !== 'unknown-base') continue;\n601:     const shipped = manifest.derived.sections[entry.id];\n602:     const body = shipped ? shipped.body : '';\n603:     const lines = localLinesOf(entry.section.body, body);\n604:     entries.push({\n605:       id: entry.id,\n606:       state: entry.state,\n607:       lines,\n608:       difference: lines.length === 0 ? bodyDifference(entry.section.body, body) : null,\n609:     });\n610:   }\n611:   if (entries.length === 0) return row('A9', 'unmarked local edits', PASS, 'no edited section');\n612: \n613:   const total = entries.reduce((sum, entry) => sum + entry.lines.length, 0);\n614:   const formatting = entries.filter((entry) => entry.lines.length === 0).length;\n615:   const detail = [`${entries.length} section(s) carry ${total} local line(s)`];\n616:   if (formatting > 0) detail.push(`${formatting} of them differ only in whitespace, order or a repeat`);\n617: \n618:   const lines = [];\n619:   for (const entry of entries) {\n620:     for (const line of entry.lines) lines.push(`${entry.id}: ${line}`);\n621:     if (entry.difference === null) continue;\n622:     lines.push(`${entry.id}: only whitespace, order or a repeat differs from the shipped body, at line ${entry.difference.line}: shipped ${JSON.stringify(entry.difference.shipped)}, the document carries ${JSON.stringify(entry.difference.actual)}`);\n623:   }\n624:   return row('A9', 'unmarked local edits', lines.length === 0 ? INFO : FINDING,\n625:     detail.join('; '), { lines, entries });\n626: }\n627: \n628: // A10. The copies each runtime loads. Claude reads the root document directly, so a full\n629: // CLAUDE.md double-loads and drifts; the Cursor rule is generated and alone carries the\n630: // gate 1 lookup to Cursor and Devin, so it is checked by its own generator.\n631: function rowRuntimeCopies(context, manifest, tools) {\n632:   const entries = [];\n633:   const lines = [];\n634: \n635:   for (const expected of manifest.runtime_copies || []) {\n636:     const verdict = copyVerdict(expected, context, manifest, tools);\n637:     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\n638:     // A copy nobody could measure is printed like a finding: a pass line with no detail\n639:     // reads as a copy that was checked and found right.\n640:     if (verdict.state === FINDING || verdict.state === UNKNOWN) {\n641:       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\n642:     }\n643:   }\n644: \n645:   const failed = entries.filter((entry) => entry.state === FINDING);\n646:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n647:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n648:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n649:   return row('A10', 'runtime copies', state, detail, { lines, entries });\n650: }\n651: \n652: function copyVerdict(expected, context, manifest, tools) {\n653:   if (expected.report_only) {\n654:     return { state: INFO, kind: 'reported only', detail: 'outside the checklist this command rewrites' };\n655:   }\n656:   if (expected.path.startsWith('~')) {\n657:     return { state: INFO, kind: 'outside the repository', detail: 'reported, never read' };\n658:   }\n659: \n660:   const target = path.join(context.root, expected.path);\n661:   if (expected.path.endsWith('.md') && expected.expect.includes('gate1-block-in-sync')) {\n662:     if (typeof tools.pointerSync !== 'string' || !fs.existsSync(tools.pointerSync)) {\n663:       return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: `the pointer sync is not installed at ${tools.pointerSync || '(no path)'}` };\n664:     }\n665:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n666:       encoding: 'utf8',\n667:       timeout: TOOL_TIMEOUT_MS,\n668:     });\n669:     const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n670:     if (run.status === 0) return { state: PASS, kind: 'gate1 block in sync', detail: 'the generator reports no drift' };\n671:     if (run.status === 1) return { state: FINDING, kind: 'gate1 block out of sync', detail: output.join('; ') };\n672:     return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: output.join('; ') || `the pointer sync exited ${run.status}` };\n673:   }\n674: \n675:   const exists = fs.existsSync(target) || isSymlink(target);\n676:   const expectsAbsent = expected.expect.length === 1 && expected.expect[0] === 'absent';\n677: \n678:   if (expected.path === '.cursor/rules/repo-local.md') {\n679:     if (context.blockContent) {\n680:       if (!exists) return { state: FINDING, kind: 'mirror missing', detail: 'the block carries content and nothing mirrors it' };\n681:       const mirror = fs.readFileSync(target, 'utf8');\n682:       const missing = [...trimmedLines(context.block.content)].filter((line) => !mirror.includes(line));\n683:       return missing.length === 0\n684:         ? { state: PASS, kind: 'mirror current', detail: 'the mirror carries the block' }\n685:         : { state: FINDING, kind: 'mirror behind', detail: `${missing.length} block line(s) are not in the mirror` };\n686:     }\n687:     return exists\n688:       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\n689:       : { state: PASS, kind: 'absent', detail: 'no block content to mirror' };\n690:   }\n691: \n692:   if (!exists) {\n693:     return expectsAbsent\n694:       ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\n695:       : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n696:   }\n697: \n698:   if (isSymlink(target)) {\n699:     const link = fs.readlinkSync(target);\n700:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n701:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n702:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n703:   }\n704: \n705:   const content = fs.readFileSync(target, 'utf8');\n706:   if (!context.exists) {\n707:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n708:   }\n709:   if (content === context.text) {\n710:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n711:   }\n712: \n713:   const unique = localLinesOf(content, context.text);\n714:   const rootLines = trimmedLines(context.text);\n715:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n716:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n717:   // A pointer is a file that carries no shipped line and names the root document. Anything\n718:   // else is either a copy or a copy plus local lines, and both drift: the second also\n719:   // loses text when it is replaced, so the lines only it carries are listed.\n720:   if (!sharesShippedLine && namesRoot) {\n721:     return { state: PASS, kind: 'pointer', detail: `every line names ${manifest.root_file}` };\n722:   }\n723:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n724: }\n725: \n726: function isSymlink(target) {\n727:   try {\n728:     return fs.lstatSync(target).isSymbolicLink();\n729:   } catch {\n730:     return false;\n731:   }\n732: }\n733: \n734: // A11. The router: present, carrying the rows the template ships, and passing its own\n735: // checker. The checker's summary line is carried through, never rebuilt.\n736: function rowRouter(context, manifest, tools) {\n737:   const routerPath = path.join(context.root, manifest.router_file);\n738:   if (!fs.existsSync(routerPath)) {\n739:     return row('A11', 'REPO RULES.md', FINDING, 'absent',\n740:       { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n741:   }\n742: \n743:   const text = fs.readFileSync(routerPath, 'utf8');\n744:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n745:   const lines = [];\n746:   const missing = [\n747:     ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n748:     ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n749:   ];\n750:   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n751: \n752:   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n753:     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n754:       { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n755:   }\n756: \n757:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n758:     encoding: 'utf8',\n759:     timeout: TOOL_TIMEOUT_MS,\n760:   });\n761:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n762:   const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n763: \n764:   if (run.status === 2 || !summary) {\n765:     return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n766:       { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n767:   }\n768:   if (run.status !== 0) {\n769:     return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n770:       { lines: [...lines, summary] });\n771:   }\n772:   return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n773:     `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n774: }\n775: \n776: // The router's own table, read the same way the manifest's rows were derived. Comparing\n777: // shipped rows to the file is the only way to say which of them a consumer dropped.\n778: function parseTableRows(text, anchor) {\n779:   const lines = text.split('\\n');\n780:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n781:   if (start === -1) return [];\n782: \n783:   const rows = [];\n784:   let width = 0;\n785:   for (let index = start + 1; index < lines.length; index += 1) {\n786:     const line = lines[index].trim();\n787:     if (line.startsWith('#')) break;\n788:     if (!line.startsWith('|')) {\n789:       if (rows.length > 0 && line === '') break;\n790:       continue;\n791:     }\n792:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n793:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n794:     if (width === 0) {\n795:       width = cells.length;\n796:       continue;\n797:     }\n798:     if (cells.length !== width) continue;\n799:     rows.push(cells);\n800:   }\n801:   return rows;\n802: }\n803: \n804: function rulePathOf(cells) {\n805:   for (const cell of cells) {\n806:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n807:     if (linked) return linked[1];\n808:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n809:     if (bare) return bare[1];\n810:   }\n811:   return null;\n812: }\n813: \n814: function missingRows(shipped, present, kind) {\n815:   const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n816:   const missing = [];\n817:   for (const cells of shipped) {\n818:     const rule = rulePathOf(cells) || cells.join(' | ');\n819:     if (!found.has(rule)) missing.push({ kind, rule });\n820:   }\n821:   return missing;\n822: }\n823: \n824: // A12. The source repository's own two promises: its block stays empty, and its derived\n825: // copy of the template is fresh. A consumer's block is its own, so this row reports INFO\n826: // there instead of telling it what to do with its own file.\n827: function rowTemplatePurity(context, manifest, tools, options) {\n828:   let source = { isSource: false, reason: `origin was not compared` };\n829:   try {\n830:     source = sourceStatus({ root: context.root, manifest });\n831:   } catch (error) {\n832:     source = { isSource: false, reason: error.message };\n833:   }\n834: \n835:   if (!options.source && !source.isSource) {\n836:     return row('A12', 'template purity', INFO,\n837:       `runs only in the source repository; ${source.reason || 'the origin differs'}`);\n838:   }\n839: \n840:   const lines = [];\n841:   if (context.blockContent) lines.push('the source repository block carries content, and every line here ships to every consumer');\n842:   if (context.block && !context.block.complete) lines.push('the source repository block is not well formed');\n843: \n844:   if (typeof tools.generator !== 'string' || !fs.existsSync(tools.generator)) {\n845:     return row('A12', 'template purity', UNKNOWN,\n846:       `the manifest generator is not installed at ${tools.generator || '(no path)'}`);\n847:   }\n848:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n849:     encoding: 'utf8',\n850:     timeout: TOOL_TIMEOUT_MS,\n851:   });\n852:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n853:   if (run.status !== 0) lines.push(...output);\n854: \n855:   const state = lines.length === 0 ? PASS : FINDING;\n856:   return row('A12', 'template purity', state,\n857:     state === PASS ? 'block empty and the derived copy is fresh' : 'the source template is not pure', { lines });\n858: }\n859: \n860: // ─────────────────────────────────────────────────────────────────────────────\n861: // 6. REPORT\n862: // ─────────────────────────────────────────────────────────────────────────────\n863: \n864: function defaultTools(manifest) {\n865:   const canaryPin = (manifest.pins || []).find((pin) => String(pin.consumer || '').endsWith('check-rule-copies.js'));\n866:   const pointerPin = (manifest.pins || []).find((pin) => pin.kind === 'first-occurrence');\n867:   return {\n868:     canary: canaryPin ? path.join(REPO_ROOT, canaryPin.consumer) : null,\n869:     pointerSync: pointerPin ? path.join(REPO_ROOT, pointerPin.consumer) : null,\n870:     repoRules: REPO_RULES_CHECKER,\n871:     generator: GENERATOR,\n872:   };\n873: }\n874: \n875: /**\n876:  * Classify one repository.\n877:  *\n878:  * @param {{root?: string, manifestPath?: string, source?: boolean, tools?: Object}} [input]\n879:  * @returns {{root: string, manifest: string, state: string, status: string, exitCode: number,\n880:  *   findings: number, unknown: number, rows: Array<Object>} | null} Null when the root\n881:  *   directory or the manifest is not readable.\n882:  */\n883: function buildReport(input = {}) {\n884:   const root = input.root ? path.resolve(input.root) : REPO_ROOT;\n885:   const manifestPath = input.manifestPath ? path.resolve(input.manifestPath) : MANIFEST_PATH;\n886:   if (!fs.existsSync(manifestPath)) return null;\n887: \n888:   let manifest;\n889:   try {\n890:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n891:   } catch {\n892:     return null;\n893:   }\n894: \n895:   const context = readTarget({ root, manifest });\n896:   if (context === null) return null;\n897: \n898:   const tools = { ...defaultTools(manifest), ...(input.tools || {}) };\n899:   const rows = [\n900:     rowInstallState(context, manifest),\n901:     rowSectionsPresent(context, manifest),\n902:     rowOrderAndNumbering(context, manifest),\n903:     rowCurrency(context),\n904:     rowPins(context, manifest),\n905:     rowBudget(context, manifest, tools),\n906:     rowBlock(context, manifest),\n907:     rowUnmarked(context, manifest),\n908:     rowUnmarkedEdits(context, manifest),\n909:     rowRuntimeCopies(context, manifest, tools),\n910:     rowRouter(context, manifest, tools),\n911:     rowTemplatePurity(context, manifest, tools, { source: Boolean(input.source), manifest: manifestPath }),\n912:   ];\n913: \n914:   const findings = rows.filter((entry) => entry.state === FINDING).length;\n915:   const unknown = rows.filter((entry) => entry.state === UNKNOWN).length;\n916:   const exitCode = findings > 0 || unknown > 0 ? 1 : 0;\n917:   const status = exitCode === 0 ? 'OK' : (findings > 0 ? 'FINDINGS' : 'UNKNOWN');\n918: \n919:   return {\n920:     root,\n921:     manifest: manifestPath,\n922:     state: rows[0].detail,\n923:     status,\n924:     exitCode,\n925:     findings,\n926:     unknown,\n927:     rows,\n928:   };\n929: }\n930: \n931: // A long row is a list, not a wall: the report keeps every line in the JSON form and\n932: // prints the first few here, so a reader sees the shape before the volume.\n933: const PRINTED_LINES = 20;\n934: \n935: function renderText(report) {\n936:   const lines = [];\n937:   for (const entry of report.rows) {\n938:     lines.push(`${entry.id} ${entry.name}: ${entry.detail}   (${entry.state})`);\n939:     for (const line of entry.lines.slice(0, PRINTED_LINES)) lines.push(`  ${line}`);\n940:     if (entry.lines.length > PRINTED_LINES) {\n941:       lines.push(`  ... ${entry.lines.length - PRINTED_LINES} more line(s), all of them in the JSON report`);\n942:     }\n943:   }\n944:   lines.push(`STATUS=${report.status} rows=${report.rows.length} findings=${report.findings} unknown=${report.unknown}`);\n945:   return `${lines.join('\\n')}\\n`;\n946: }\n947: \n948: function renderJson(report) {\n949:   const shaped = {\n950:     root: report.root,\n951:     manifest: report.manifest,\n952:     state: report.state,\n953:     status: report.status,\n954:     exit_code: report.exitCode,\n955:     findings: report.findings,\n956:     unknown: report.unknown,\n957:     rows: report.rows.map((entry) => ({\n958:       id: entry.id,\n959:       name: entry.name,\n960:       state: entry.state,\n961:       detail: entry.detail,\n962:       lines: entry.lines,\n963:       entries: entry.entries,\n964:     })),\n965:   };\n966:   return `${JSON.stringify(shaped, null, 2)}\\n`;\n967: }\n968: \n969: // ─────────────────────────────────────────────────────────────────────────────\n970: // 7. MAIN\n971: // ─────────────────────────────────────────────────────────────────────────────\n972: \n973: /**\n974:  * @param {string[]} argv\n975:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n976:  * @returns {number} the process exit code\n977:  */\n978: function main(argv, hooks = {}) {\n979:   const options = parseArgs(argv);\n980:   if (options.help) {\n981:     console.log(USAGE);\n982:     return 0;\n983:   }\n984: \n985:   if (!fs.existsSync(options.manifest)) {\n986:     console.error(`${TAG} ERROR: the manifest is missing at ${options.manifest}`);\n987:     return 2;\n988:   }\n989:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n990:     console.error(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n991:     return 2;\n992:   }\n993:   // The root file's name is the manifest's to declare, so this precondition reads the same\n994:   // declaration every other read does instead of a name of its own.\n995:   let rootFile = null;\n996:   try {\n997:     rootFile = JSON.parse(fs.readFileSync(options.manifest, 'utf8')).root_file || null;\n998:   } catch {\n999:     // An unreadable manifest is refused below, where the run has no report to print.\n1000:     rootFile = null;\n1001:   }\n1002:   const rootPath = rootFile === null ? null : path.join(options.root, rootFile);\n1003:   if (rootPath !== null && fs.existsSync(rootPath)) {\n1004:     try {\n1005:       fs.readFileSync(rootPath, 'utf8');\n1006:     } catch (error) {\n1007:       console.error(`${TAG} ERROR: cannot read ${rootPath}: ${error.message}`);\n1008:       return 2;\n1009:     }\n1010:   }\n1011: \n1012:   const report = buildReport({\n1013:     root: options.root,\n1014:     manifestPath: options.manifest,\n1015:     source: options.source,\n1016:     tools: hooks.tools || {},\n1017:   });\n1018:   if (report === null) {\n1019:     // A manifest that cannot be parsed leaves nothing to compare against, and an empty\n1020:     // report would read like a clean one.\n1021:     console.error(`${TAG} ERROR: cannot classify ${options.root}: the manifest at ${options.manifest} could not be read as JSON`);\n1022:     return 2;\n1023:   }\n1024: \n1025:   process.stdout.write(options.json ? renderJson(report) : renderText(report));\n1026:   return report.exitCode;\n1027: }\n1028: \n1029: if (require.main === module) {\n1030:   try {\n1031:     process.exitCode = main(process.argv.slice(2));\n1032:   } catch (error) {\n1033:     console.error(`${TAG} ERROR: ${error.message}`);\n1034:     if (error instanceof UsageError) console.error(USAGE);\n1035:     process.exitCode = 2;\n1036:   }\n1037: }\n1038: \n1039: module.exports = {\n1040:   MANIFEST_PATH,\n1041:   buildReport,\n1042:   main,\n1043:   renderJson,\n1044:   renderText,\n1045: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1045\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template can be in any of seven\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\n9: // release behind, or edited in place; its own content may sit in the marked block or be\n10: // scattered between shipped sections; it may have no root document at all. Without that\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\n13: // without writing a byte, what the repository holds against the manifest.\n14: //\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\n18: // tests and an owner, so each is run as a child process and its own lines are carried\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\n20: // from the first. The rest are pure classifiers over one read of the target tree.\n21: //\n22: // The run is read-only by construction: the only paths it opens for reading are under\n23: // the target root plus the manifest, and the three child tools it runs are read-only\n24: // modes. A repository that cannot be classified at all (no manifest, no target\n25: // directory, an unreadable root document) is a failed precondition and exits 2, because\n26: // an empty report would read like a clean one.\n27: //\n28: // Usage: agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]\n29: //   --root <dir>      classify this repository instead of the one this script ships in\n30: //   --manifest <path> read this manifest instead of the shipped one\n31: //   --source          run the template-purity row even outside the source repository\n32: //   --json            print one JSON object instead of the text report\n33: // Exit codes: 0 nothing to report, 1 at least one finding or an unproven row,\n34: //             2 a precondition failed\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 1. IMPORTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const { spawnSync } = require('node:child_process');\n41: const fs = require('node:fs');\n42: const path = require('node:path');\n43: \n44: const {\n45:   classifyBody,\n46:   deliveryAnchorEnd,\n47:   matchSections,\n48:   segment,\n49: } = require('./lib/agents-md-sections.cjs');\n50: const { sourceStatus } = require('./agents-md-manifest.cjs');\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. CONSTANTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const TAG = '[agents-md-check]';\n57: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n58: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n60: // The router checker ships beside the skill that authors rules, and the manifest links\n61: // it only through the router's own row, so its path is named here once.\n62: const REPO_RULES_CHECKER = path.resolve(\n63:   REPO_ROOT,\n64:   '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs',\n65: );\n66: // The checker's own tag prefix. Matching on it is what keeps this row a carrier of that\n67: // tool's verdict instead of a second implementation of its checks.\n68: const REPO_RULES_TAG = '[repo-rules-check]';\n69: const USAGE = 'Usage: node .skilled/commands/doctor/scripts/agents-md-check.cjs [--root <dir>] [--manifest <path>] [--source] [--json]';\n70: const TOOL_TIMEOUT_MS = 120000;\n71: \n72: // A repository where fewer than half the shipped sections survive is carrying its own\n73: // document, not a copy of the template. Above the line the question becomes which parts\n74: // of the template are still there, which is a per-section answer.\n75: const FOREIGN_SHARE = 0.5;\n76: \n77: const PASS = 'PASS';\n78: const FINDING = 'FINDING';\n79: const UNKNOWN = 'UNKNOWN';\n80: const INFO = 'INFO';\n81: \n82: class UsageError extends Error {}\n83: \n84: // ─────────────────────────────────────────────────────────────────────────────\n85: // 3. ARGUMENTS\n86: // ─────────────────────────────────────────────────────────────────────────────\n87: \n88: function parseArgs(argv) {\n89:   const options = { root: REPO_ROOT, manifest: MANIFEST_PATH, source: false, json: false, help: false };\n90:   for (let index = 0; index < argv.length; index += 1) {\n91:     const argument = argv[index];\n92:     if (argument === '--root') {\n93:       const value = argv[index + 1];\n94:       if (!value || value.startsWith('--')) throw new UsageError('--root needs a directory');\n95:       options.root = path.resolve(value);\n96:       index += 1;\n97:     } else if (argument === '--manifest') {\n98:       const value = argv[index + 1];\n99:       if (!value || value.startsWith('--')) throw new UsageError('--manifest needs a file path');\n100:       options.manifest = path.resolve(value);\n101:       index += 1;\n102:     } else if (argument === '--source') {\n103:       options.source = true;\n104:     } else if (argument === '--json') {\n105:       options.json = true;\n106:     } else if (argument === '--help' || argument === '-h') {\n107:       options.help = true;\n108:     } else {\n109:       throw new UsageError(`unknown argument: ${argument}`);\n110:     }\n111:   }\n112:   return options;\n113: }\n114: \n115: // ─────────────────────────────────────────────────────────────────────────────\n116: // 4. READING THE TARGET ONCE\n117: // ─────────────────────────────────────────────────────────────────────────────\n118: \n119: // Section offsets are byte offsets because the delivery budget is a byte count, while a\n120: // reader opens the file by line number. One conversion, in one place.\n121: function lineNumberAt(text, byteOffset) {\n122:   return Buffer.from(text, 'utf8').subarray(0, byteOffset).toString('utf8').split('\\n').length;\n123: }\n124: \n125: function trimmedLines(text) {\n126:   const lines = new Set();\n127:   for (const raw of String(text).split('\\n')) {\n128:     const line = raw.trim();\n129:     if (line !== '' && line !== '---') lines.add(line);\n130:   }\n131:   return lines;\n132: }\n133: \n134: // The repository's own lines, in order and with repeats. A set would report one line for\n135: // two occurrences, and a replacement loses both, so a duplicate is a second line to keep.\n136: function localLinesOf(body, reference) {\n137:   const known = trimmedLines(reference);\n138:   const local = [];\n139:   for (const raw of body.split('\\n')) {\n140:     const line = raw.trim();\n141:     if (line === '' || line === '---' || known.has(line)) continue;\n142:     local.push(line);\n143:   }\n144:   return local;\n145: }\n146: \n147: function knownBodies(manifest) {\n148:   const sections = manifest.derived && manifest.derived.sections ? manifest.derived.sections : {};\n149:   return {\n150:     current: Object.keys(sections).map((id) => ({ id, sha256: sections[id].sha256, body: sections[id].body })),\n151:     history: (manifest.derived && manifest.derived.history) || [],\n152:   };\n153: }\n154: \n155: // The block carries a heading and a note that the template itself ships, so \"the block is\n156: // empty\" means nothing beyond those two lines, not that the markers bracket no text.\n157: function blockHasContent(block, markers) {\n158:   if (!block || !block.complete) return false;\n159:   const shipped = new Set([markers.heading.trim(), markers.note.trim()]);\n160:   for (const raw of block.content.split('\\n')) {\n161:     const line = raw.trim();\n162:     if (line === '' || shipped.has(line)) continue;\n163:     return true;\n164:   }\n165:   return false;\n166: }\n167: \n168: /**\n169:  * Read the target tree once and keep what every row needs.\n170:  *\n171:  * @param {{root: string, manifest: Object}} input\n172:  * @returns {Object|null} Null when the root directory is not there.\n173:  */\n174: function readTarget({ root, manifest }) {\n175:   if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) return null;\n176: \n177:   const rootPath = path.join(root, manifest.root_file);\n178:   const exists = fs.existsSync(rootPath);\n179:   const text = exists ? fs.readFileSync(rootPath, 'utf8') : null;\n180:   const segmentation = exists\n181:     ? segment(text, manifest.markers, manifest.sections)\n182:     : { sections: [], block: null, prelude: null };\n183:   const pairing = matchSections(segmentation.sections, manifest.sections, segmentation.prelude);\n184: \n185:   return {\n186:     root,\n187:     rootPath,\n188:     exists,\n189:     text,\n190:     totalBytes: exists ? Buffer.byteLength(text, 'utf8') : 0,\n191:     block: segmentation.block,\n192:     prelude: segmentation.prelude,\n193:     sections: segmentation.sections,\n194:     matched: pairing.matched,\n195:     unregistered: pairing.unregistered,\n196:     unmatched: pairing.unmatched,\n197:     conflicts: pairing.conflicts,\n198:     currency: pairing.matched.map((row) => ({\n199:       id: row.entry.id,\n200:       section: row.section,\n201:       ...classifyBody(row.section.body, knownBodies(manifest)),\n202:     })),\n203:     blockContent: blockHasContent(segmentation.block, manifest.markers),\n204:   };\n205: }\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. THE TWELVE ROWS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: function row(id, name, state, detail, extra = {}) {\n212:   return { id, name, state, detail, lines: extra.lines || [], entries: extra.entries || [] };\n213: }\n214: \n215: // A1. The one row an operator reads first: which of the seven shapes this repository is.\n216: function rowInstallState(context, manifest) {\n217:   const claudePath = path.join(context.root, 'CLAUDE.md');\n218:   if (!context.exists) {\n219:     if (fs.existsSync(claudePath)) {\n220:       return row('A1', 'install state', FINDING, 'claude-only',\n221:         { lines: [`no ${manifest.root_file}; CLAUDE.md is the only instruction file`] });\n222:     }\n223:     return row('A1', 'install state', FINDING, 'absent',\n224:       { lines: [`no ${manifest.root_file} and no CLAUDE.md`] });\n225:   }\n226: \n227:   const share = manifest.sections.length === 0 ? 0 : context.matched.length / manifest.sections.length;\n228:   if (share < FOREIGN_SHARE) {\n229:     return row('A1', 'install state', FINDING, 'foreign', {\n230:       lines: [\n231:         `${context.matched.length} of ${manifest.sections.length} shipped sections match, under the ${Math.round(FOREIGN_SHARE * 100)}% floor`,\n232:         'the root document is the repository\\'s own file',\n233:       ],\n234:     });\n235:   }\n236: \n237:   const localEdits = context.currency.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n238:   const behind = context.currency.filter((entry) => entry.state === 'stale-known');\n239:   // A local edit outranks a missed release in the reading order: it is the shape that\n240:   // loses text if somebody replaces the document, and staleness only loses a patch.\n241:   if (localEdits.length > 0 || context.unregistered.length > 0) {\n242:     const lines = [];\n243:     for (const entry of localEdits) lines.push(`${entry.id}: ${entry.state}`);\n244:     for (const entry of context.unregistered) {\n245:       lines.push(entry.heading === null\n246:         ? 'unmarked text before the first heading'\n247:         : `unmarked section ${JSON.stringify(entry.heading)}`);\n248:     }\n249:     return row('A1', 'install state', FINDING, 'forked', { lines });\n250:   }\n251:   if (behind.length > 0) {\n252:     return row('A1', 'install state', FINDING, 'stale',\n253:       { lines: behind.map((entry) => `${entry.id}: ${entry.state}`) });\n254:   }\n255:   if (context.blockContent) {\n256:     return row('A1', 'install state', PASS, 'adopted',\n257:       { lines: ['every shipped section is current and the repository block carries content'] });\n258:   }\n259:   return row('A1', 'install state', PASS, 'pure',\n260:     { lines: ['every shipped section is current and the repository block is empty'] });\n261: }\n262: \n263: // A2. Which shipped sections survived, by the prefix each authored entry carries.\n264: function rowSectionsPresent(context, manifest) {\n265:   const present = new Set(context.matched.map((row_) => row_.entry.id));\n266:   const missing = manifest.sections.map((entry) => entry.id).filter((id) => !present.has(id));\n267:   const detail = `${present.size}/${manifest.sections.length} matched`;\n268:   if (missing.length === 0 && context.conflicts.length === 0) {\n269:     return row('A2', 'sections present', PASS, detail);\n270:   }\n271:   const lines = missing.map((id) => `missing section ${id}`);\n272:   for (const conflict of context.conflicts) lines.push(conflict.message);\n273:   return row('A2', 'sections present', FINDING, `${present.size}/${manifest.sections.length} matched, ${missing.length} missing`, {\n274:     lines,\n275:     entries: missing.map((id) => ({ id, present: false })),\n276:   });\n277: }\n278: \n279: // The byte offset of the first line that is exactly this text, or -1 when the document\n280: // does not carry it.\n281: function firstLineOffset(text, needle) {\n282:   if (text.startsWith(needle)) return 0;\n283:   const at = text.indexOf(`\\n${needle}`);\n284:   return at === -1 ? -1 : at + 1;\n285: }\n286: \n287: // The shipped numbering, read from the pin that names it. Hundreds of files cite these\n288: // numbers, and the document carries its fourth section before its third, so the citation\n289: // order is not the reading order and only the pin carries the expected one.\n290: function numberingReport(context, manifest) {\n291:   if (!context.exists) return { state: INFO, detail: 'no root document to number', lines: [] };\n292: \n293:   const pin = (manifest.pins || []).find((entry) => entry.kind === 'order');\n294:   if (!pin) return { state: INFO, detail: 'the manifest declares no numbering pin', lines: [] };\n295: \n296:   const found = [];\n297:   const absent = [];\n298:   for (const text of pin.texts) {\n299:     const at = firstLineOffset(context.text, text);\n300:     if (at === -1) absent.push(text.trim());\n301:     else found.push({ text: text.trim(), at });\n302:   }\n303:   const expected = pin.texts.map((text) => text.trim()).filter((text) => found.some((entry) => entry.text === text));\n304:   const actual = found.slice().sort((left, right) => left.at - right.at).map((entry) => entry.text);\n305: \n306:   const lines = absent.map((text) => `missing section number ${JSON.stringify(text)}`);\n307:   if (expected.join('|') !== actual.join('|')) {\n308:     lines.push(`the numbers appear as ${actual.join(', ')} instead of ${expected.join(', ')}`);\n309:   }\n310:   return { state: lines.length === 0 ? PASS : FINDING, detail: `${found.length}/${pin.texts.length} section numbers in place`, lines };\n311: }\n312: \n313: // A3. Shipped sections in manifest order, and section numbers unchanged.\n314: function rowOrderAndNumbering(context, manifest) {\n315:   const order = manifest.sections.map((entry) => entry.id);\n316:   const seen = context.matched.map((entry) => entry.entry.id);\n317:   const expected = order.filter((id) => seen.includes(id));\n318:   const numbering = numberingReport(context, manifest);\n319: \n320:   const lines = [...numbering.lines];\n321:   if (expected.join('|') !== seen.join('|')) {\n322:     const first = seen.findIndex((id, index) => id !== expected[index]);\n323:     lines.unshift(`section order differs at position ${first + 1}: found ${seen[first]}, expected ${expected[first]}`);\n324:   }\n325:   const state = lines.length === 0 ? PASS : FINDING;\n326:   return row('A3', 'order and numbering', state, state === PASS ? 'manifest order and section numbers unchanged' : 'order or numbering drifted', { lines });\n327: }\n328: \n329: // A4. Per section, whether the body is the shipped one, an older release, a local edit\n330: // or something with no base to name.\n331: function rowCurrency(context) {\n332:   const counts = { current: 0, 'stale-known': 0, edited: 0, 'unknown-base': 0 };\n333:   const entries = [];\n334:   for (const entry of context.currency) {\n335:     counts[entry.state] += 1;\n336:     entries.push({ id: entry.id, state: entry.state, base: entry.base || null });\n337:   }\n338:   // Nothing to classify is not a clean bill: the rows around this one report the empty or\n339:   // foreign document, and a pass here would read as currency that was checked.\n340:   if (entries.length === 0) {\n341:     return row('A4', 'section currency', INFO, 'no shipped section matched, so there is no body to classify');\n342:   }\n343:   const detail = `${counts.current} current, ${counts['stale-known']} stale-known, ${counts.edited} edited, ${counts['unknown-base']} unknown-base`;\n344:   const lines = [];\n345:   for (const entry of context.currency) {\n346:     if (entry.state === 'current') continue;\n347:     const base = entry.base ? entry.base.slice(0, 12) : 'none';\n348:     lines.push(`${entry.id}: ${entry.state} (closest known body ${base})`);\n349:   }\n350:   return row('A4', 'section currency', lines.length === 0 ? PASS : FINDING, detail, { lines, entries });\n351: }\n352: \n353: // A5. Every string downstream tooling greps out of the document, checked by its rule.\n354: function rowPins(context, manifest) {\n355:   const entries = [];\n356:   const byId = new Map(context.matched.map((entry) => [entry.entry.id, entry.section]));\n357: \n358:   for (const pin of manifest.pins || []) {\n359:     const verdict = pinVerdict(pin, context, manifest, byId);\n360:     entries.push({ id: pin.id, kind: pin.kind, state: verdict.state, detail: verdict.detail });\n361:   }\n362: \n363:   const failed = entries.filter((entry) => entry.state === FINDING);\n364:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n365:   const lines = failed.map((entry) => `${entry.id} (${entry.kind}): ${entry.detail}`);\n366:   for (const entry of unmeasured) lines.push(`${entry.id} (${entry.kind}): ${entry.detail}`);\n367:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n368:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} pins hold${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n369:   return row('A5', 'pins', state, detail, { lines, entries });\n370: }\n371: \n372: function pinVerdict(pin, context, manifest, byId) {\n373:   const section = pin.section ? byId.get(pin.section) : null;\n374:   if (pin.section && !section) {\n375:     return { state: FINDING, detail: `the section ${pin.section} that carries this pin is missing` };\n376:   }\n377: \n378:   switch (pin.kind) {\n379:     case 'exact': {\n380:       const missing = pin.texts.filter((text) => !section.body.includes(text));\n381:       return missing.length === 0\n382:         ? { state: PASS, detail: `all ${pin.texts.length} strings present in ${pin.section}` }\n383:         : { state: FINDING, detail: `missing ${JSON.stringify(missing[0])} in ${pin.section}` };\n384:     }\n385:     case 'line': {\n386:       const required = (pin.requires || pin.texts).map((text) => text.toLowerCase());\n387:       const hit = section.body.split('\\n').some((line) => {\n388:         const lower = line.toLowerCase();\n389:         return required.every((text) => lower.includes(text));\n390:       });\n391:       return hit\n392:         ? { state: PASS, detail: `a line in ${pin.section} carries ${required.join(', ')}` }\n393:         : { state: FINDING, detail: `no line in ${pin.section} carries ${required.join(', ')}` };\n394:     }\n395:     case 'first-occurrence': {\n396:       const at = context.text.indexOf(pin.texts[0]);\n397:       const inside = at >= section.start && at < section.end;\n398:       if (inside) return { state: PASS, detail: `the first occurrence sits inside ${pin.section}` };\n399:       return {\n400:         state: FINDING,\n401:         detail: at === -1\n402:           ? `the text ${JSON.stringify(pin.texts[0])} is absent`\n403:           : `the first occurrence at byte ${at} sits outside ${pin.section} (${section.start}..${section.end}), so anything reading the first line of the document follows it instead`,\n404:       };\n405:     }\n406:     case 'delivery-anchor': {\n407:       const end = deliveryAnchorEnd(section, pin);\n408:       if (end === null) return { state: FINDING, detail: `the anchor text is absent from ${pin.section}` };\n409:       const limit = manifest.budget.prefix_bytes;\n410:       return end <= limit\n411:         ? { state: PASS, detail: `${pin.section} ends at byte ${end}, inside ${limit}` }\n412:         : { state: FINDING, detail: `${pin.section} ends at byte ${end}, past the ${limit}-byte delivery prefix` };\n413:     }\n414:     case 'budget': {\n415:       const declared = manifest.budget[pin.limit_key];\n416:       const pinned = Number(pin.texts[0]);\n417:       return declared === pinned\n418:         ? { state: PASS, detail: `${pin.limit_key} is ${declared}` }\n419:         : { state: FINDING, detail: `${pin.limit_key} reads ${declared}, the pin says ${pinned}` };\n420:     }\n421:     case 'order': {\n422:       const numbering = numberingReport(context, manifest);\n423:       return { state: numbering.state, detail: numbering.detail };\n424:     }\n425:     case 'file': {\n426:       const target = path.join(context.root, pin.path);\n427:       return fs.existsSync(target)\n428:         ? { state: PASS, detail: `${pin.path} exists` }\n429:         : { state: FINDING, detail: `${pin.path} is missing` };\n430:     }\n431:     default:\n432:       // A kind the engine has no rule for is a pin nobody measured. Counting it as a hold\n433:       // would report a manifest edit as verified.\n434:       return { state: UNKNOWN, detail: `no rule for a pin of kind ${pin.kind}` };\n435:   }\n436: }\n437: \n438: // A6. The delivery budget: the canary's own AGENTS.md lines, plus the two measurements\n439: // the report needs. Only this row's file is kept, because the canary also pins the skill\n440: // it ships in and a consumer legitimately has none of those.\n441: function rowBudget(context, manifest, tools) {\n442:   if (typeof tools.canary !== 'string' || !fs.existsSync(tools.canary)) {\n443:     return row('A6', 'delivery budget', UNKNOWN,\n444:       `the rule-copy canary is not installed at ${tools.canary || '(no path)'}; the budget cannot be measured`);\n445:   }\n446: \n447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n448:     encoding: 'utf8',\n449:     timeout: TOOL_TIMEOUT_MS,\n450:     maxBuffer: 16 * 1024 * 1024,\n451:   });\n452:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n453:   if (run.error || (run.status !== 0 && run.status !== 1)) {\n454:     return row('A6', 'delivery budget', UNKNOWN,\n455:       `the rule-copy canary could not run: ${run.error ? run.error.message : `exit ${run.status}`}`);\n456:   }\n457: \n458:   // The canary prints its verdict, an anchor table and its findings. Only the findings\n459:   // that name this document belong to this row; its PASS and table lines are its own\n460:   // report, and the anchor end byte is measured below instead of parsed back out.\n461:   const own = output\n462:     .filter((line) => line.includes(manifest.root_file))\n463:     .filter((line) => /^(MISSING|BLOCKED):/u.test(line));\n464:   const elsewhere = output.filter((line) => !line.includes(manifest.root_file));\n465: \n466:   const limit = manifest.budget.prefix_bytes;\n467:   const ceiling = manifest.budget.max_bytes;\n468:   const prefixEnd = (manifest.pins || [])\n469:     .filter((pin) => pin.kind === 'delivery-anchor')\n470:     .reduce((max, pin) => {\n471:       const section = context.matched.find((entry) => entry.entry.id === pin.section);\n472:       if (!section) return max;\n473:       const end = deliveryAnchorEnd(section.section, pin);\n474:       return end === null ? max : Math.max(max, end);\n475:     }, 0);\n476: \n477:   const failures = [...own];\n478:   // The canary already names whatever it measured, so this row adds a figure only for a\n479:   // defect the canary did not report, instead of printing the same ceiling twice.\n480:   if (prefixEnd > limit && !own.some((line) => line.includes('delivery prefix'))) {\n481:     failures.push(`the last anchor ends at byte ${prefixEnd}, past the ${limit}-byte delivery prefix`);\n482:   }\n483:   if (context.totalBytes > ceiling && !own.some((line) => line.includes('ceiling'))) {\n484:     failures.push(`${context.totalBytes} bytes exceeds the ${ceiling}-byte ceiling`);\n485:   }\n486:   // A failing canary that names other files only is still a fact worth stating, because\n487:   // its exit status would otherwise read as this row's verdict. A passing one needs no\n488:   // note: its remaining lines are its own anchor table.\n489:   const notes = failures.length === 0 && run.status !== 0 && elsewhere.length > 0\n490:     ? [`the canary exits ${run.status} over ${elsewhere.length} line(s) outside ${manifest.root_file}, which belong to other files' pins`]\n491:     : [];\n492: \n493:   return row('A6', 'delivery budget', failures.length === 0 ? PASS : FINDING,\n494:     `${prefixEnd} of ${limit} bytes to the last anchor, ${context.totalBytes} of ${ceiling} bytes total`,\n495:     { lines: [...failures, ...notes] });\n496: }\n497: \n498: // A7. The repository block: one start marker line, one end marker line, in that order,\n499: // after every shipped section, small enough to leave headroom. A marker is the whole line,\n500: // so the same bytes quoted inside a sentence are prose and do not make a second block.\n501: function rowBlock(context, manifest) {\n502:   const { budget } = manifest;\n503:   const block = context.block;\n504:   const starts = block === null ? 0 : block.markerLines.start.length;\n505:   const ends = block === null ? 0 : block.markerLines.end.length;\n506: \n507:   if (starts === 0 && ends === 0) {\n508:     return row('A7', 'repo-local block', PASS, `no block; ${context.totalBytes} of ${budget.max_bytes} bytes used`);\n509:   }\n510:   if (starts !== 1 || ends !== 1) {\n511:     const lines = ['the block cannot be placed, so nothing inside it can be carried'];\n512:     const where = [];\n513:     if (block !== null && starts > 0) where.push(`the start marker sits on line ${block.markerLines.start.join(' and line ')}`);\n514:     if (block !== null && ends > 0) where.push(`the end marker on line ${block.markerLines.end.join(' and line ')}`);\n515:     if (where.length > 0) lines.push(where.join(', '));\n516:     return row('A7', 'repo-local block', FINDING,\n517:       `expected one start and one end marker line, found ${starts} and ${ends}`, { lines });\n518:   }\n519: \n520:   const lines = [];\n521:   if (!block || !block.complete) {\n522:     lines.push('the end marker sits before the start marker, so the block is out of order and unreadable');\n523:   }\n524:   // Whatever the document carries below the block is content a replacement has to place\n525:   // around the block, so a block above it cannot be the one block a rewrite writes last.\n526:   const following = block === null ? [] : context.sections.filter((section) => section.start > block.start);\n527:   if (block && block.complete && following.length > 0) {\n528:     lines.push(`the block starts at byte ${block.start}, before ${following.length} section(s) that follow it (the first is ${JSON.stringify(following[0].heading)} at byte ${following[0].start})`);\n529:   }\n530:   if (block && block.complete && block.start < budget.prefix_bytes) {\n531:     lines.push(`the block starts at byte ${block.start}, inside the ${budget.prefix_bytes}-byte delivery prefix`);\n532:   }\n533:   if (context.totalBytes > budget.max_bytes) {\n534:     lines.push(`${context.totalBytes} bytes exceeds the ${budget.max_bytes}-byte ceiling`);\n535:   }\n536: \n537:   const size = block && block.complete ? Buffer.byteLength(block.content, 'utf8') : 0;\n538:   const headroom = budget.max_bytes - context.totalBytes;\n539:   const detail = block && block.complete\n540:     ? `block ${size} bytes, ${headroom} bytes of headroom`\n541:     : `block unreadable, ${headroom} bytes of headroom`;\n542:   return row('A7', 'repo-local block', lines.length === 0 ? PASS : FINDING, detail,\n543:     { lines, entries: [{ size, headroom, complete: Boolean(block && block.complete) }] });\n544: }\n545: \n546: // A8. Repository content outside the block that matches no shipped section. This is the\n547: // content a replacement would drop, so it is reported by line and byte range. The text\n548: // above the first heading has no heading to match, and arrives here with a null one.\n549: function rowUnmarked(context, manifest) {\n550:   const prefixBytes = manifest.budget.prefix_bytes;\n551:   const entries = context.unregistered.map((entry) => ({\n552:     heading: entry.heading,\n553:     line_start: lineNumberAt(context.text, entry.start),\n554:     line_end: lineNumberAt(context.text, Math.max(entry.start, entry.end - 1)),\n555:     byte_start: entry.start,\n556:     byte_end: entry.end,\n557:     in_prefix: entry.start < prefixBytes,\n558:   }));\n559:   if (entries.length === 0) return row('A8', 'unmarked repo-unique content', PASS, 'no section outside the block');\n560: \n561:   const headings = entries.filter((entry) => entry.heading !== null).length;\n562:   const detail = [];\n563:   if (headings > 0) detail.push(`${headings} section(s) outside the block match no shipped section`);\n564:   if (entries.length > headings) detail.push('the text above the first heading is repository content no section carries');\n565: \n566:   return row('A8', 'unmarked repo-unique content', FINDING,\n567:     detail.join('; '),\n568:     {\n569:       lines: entries.map((entry) => `${entry.heading === null ? 'text before the first heading' : JSON.stringify(entry.heading)}: lines ${entry.line_start}-${entry.line_end}, bytes ${entry.byte_start}-${entry.byte_end}${entry.in_prefix ? ', inside the delivery prefix' : ''}`),\n570:       entries,\n571:     });\n572: }\n573: \n574: // The line where two bodies first part company, with the two raw lines. A body can carry\n575: // every line the shipped body carries and still not be it — an extra space on an indent, a\n576: // line written twice, two lines swapped — and the operator needs the line to look at\n577: // rather than a finding with nothing under it.\n578: function bodyDifference(actual, expected) {\n579:   const left = String(actual).split('\\n');\n580:   const right = String(expected).split('\\n');\n581:   const last = Math.max(left.length, right.length);\n582:   for (let index = 0; index < last; index += 1) {\n583:     if (left[index] === right[index]) continue;\n584:     return {\n585:       line: index + 1,\n586:       actual: left[index] === undefined ? null : left[index],\n587:       shipped: right[index] === undefined ? null : right[index],\n588:     };\n589:   }\n590:   return null;\n591: }\n592: \n593: // A9. For a section that is not the shipped body, the lines the shipped body does not\n594: // carry, once per occurrence. A body that carries every shipped line can still differ, so\n595: // the row names that difference by line instead of reporting a finding with no line under\n596: // it: a finding nobody can act on reads like a bug in the checker.\n597: function rowUnmarkedEdits(context, manifest) {\n598:   const entries = [];\n599:   for (const entry of context.currency) {\n600:     if (entry.state !== 'edited' && entry.state !== 'unknown-base') continue;\n601:     const shipped = manifest.derived.sections[entry.id];\n602:     const body = shipped ? shipped.body : '';\n603:     const lines = localLinesOf(entry.section.body, body);\n604:     entries.push({\n605:       id: entry.id,\n606:       state: entry.state,\n607:       lines,\n608:       difference: lines.length === 0 ? bodyDifference(entry.section.body, body) : null,\n609:     });\n610:   }\n611:   if (entries.length === 0) return row('A9', 'unmarked local edits', PASS, 'no edited section');\n612: \n613:   const total = entries.reduce((sum, entry) => sum + entry.lines.length, 0);\n614:   const formatting = entries.filter((entry) => entry.lines.length === 0).length;\n615:   const detail = [`${entries.length} section(s) carry ${total} local line(s)`];\n616:   if (formatting > 0) detail.push(`${formatting} of them differ only in whitespace, order or a repeat`);\n617: \n618:   const lines = [];\n619:   for (const entry of entries) {\n620:     for (const line of entry.lines) lines.push(`${entry.id}: ${line}`);\n621:     if (entry.difference === null) continue;\n622:     lines.push(`${entry.id}: only whitespace, order or a repeat differs from the shipped body, at line ${entry.difference.line}: shipped ${JSON.stringify(entry.difference.shipped)}, the document carries ${JSON.stringify(entry.difference.actual)}`);\n623:   }\n624:   return row('A9', 'unmarked local edits', lines.length === 0 ? INFO : FINDING,\n625:     detail.join('; '), { lines, entries });\n626: }\n627: \n628: // A10. The copies each runtime loads. Claude reads the root document directly, so a full\n629: // CLAUDE.md double-loads and drifts; the Cursor rule is generated and alone carries the\n630: // gate 1 lookup to Cursor and Devin, so it is checked by its own generator.\n631: function rowRuntimeCopies(context, manifest, tools) {\n632:   const entries = [];\n633:   const lines = [];\n634: \n635:   for (const expected of manifest.runtime_copies || []) {\n636:     const verdict = copyVerdict(expected, context, manifest, tools);\n637:     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\n638:     // A copy nobody could measure is printed like a finding: a pass line with no detail\n639:     // reads as a copy that was checked and found right.\n640:     if (verdict.state === FINDING || verdict.state === UNKNOWN) {\n641:       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\n642:     }\n643:   }\n644: \n645:   const failed = entries.filter((entry) => entry.state === FINDING);\n646:   const unmeasured = entries.filter((entry) => entry.state === UNKNOWN);\n647:   const state = failed.length > 0 ? FINDING : (unmeasured.length > 0 ? UNKNOWN : PASS);\n648:   const detail = `${entries.length - failed.length - unmeasured.length}/${entries.length} copies as expected${unmeasured.length > 0 ? `, ${unmeasured.length} unmeasured` : ''}`;\n649:   return row('A10', 'runtime copies', state, detail, { lines, entries });\n650: }\n651: \n652: function copyVerdict(expected, context, manifest, tools) {\n653:   if (expected.report_only) {\n654:     return { state: INFO, kind: 'reported only', detail: 'outside the checklist this command rewrites' };\n655:   }\n656:   if (expected.path.startsWith('~')) {\n657:     return { state: INFO, kind: 'outside the repository', detail: 'reported, never read' };\n658:   }\n659: \n660:   const target = path.join(context.root, expected.path);\n661:   if (expected.path.endsWith('.md') && expected.expect.includes('gate1-block-in-sync')) {\n662:     if (typeof tools.pointerSync !== 'string' || !fs.existsSync(tools.pointerSync)) {\n663:       return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: `the pointer sync is not installed at ${tools.pointerSync || '(no path)'}` };\n664:     }\n665:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n666:       encoding: 'utf8',\n667:       timeout: TOOL_TIMEOUT_MS,\n668:     });\n669:     const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n670:     if (run.status === 0) return { state: PASS, kind: 'gate1 block in sync', detail: 'the generator reports no drift' };\n671:     if (run.status === 1) return { state: FINDING, kind: 'gate1 block out of sync', detail: output.join('; ') };\n672:     return { state: UNKNOWN, kind: 'gate1 block unmeasured', detail: output.join('; ') || `the pointer sync exited ${run.status}` };\n673:   }\n674: \n675:   const exists = fs.existsSync(target) || isSymlink(target);\n676:   const expectsAbsent = expected.expect.length === 1 && expected.expect[0] === 'absent';\n677: \n678:   if (expected.path === '.cursor/rules/repo-local.md') {\n679:     if (context.blockContent) {\n680:       if (!exists) return { state: FINDING, kind: 'mirror missing', detail: 'the block carries content and nothing mirrors it' };\n681:       const mirror = fs.readFileSync(target, 'utf8');\n682:       const missing = [...trimmedLines(context.block.content)].filter((line) => !mirror.includes(line));\n683:       return missing.length === 0\n684:         ? { state: PASS, kind: 'mirror current', detail: 'the mirror carries the block' }\n685:         : { state: FINDING, kind: 'mirror behind', detail: `${missing.length} block line(s) are not in the mirror` };\n686:     }\n687:     return exists\n688:       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\n689:       : { state: PASS, kind: 'absent', detail: 'no block content to mirror' };\n690:   }\n691: \n692:   if (!exists) {\n693:     return expectsAbsent\n694:       ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\n695:       : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\n696:   }\n697: \n698:   if (isSymlink(target)) {\n699:     const link = fs.readlinkSync(target);\n700:     const pointsAtRoot = path.basename(link) === manifest.root_file;\n701:     if (pointsAtRoot) return { state: PASS, kind: 'symlink', detail: `links to ${link}` };\n702:     return { state: FINDING, kind: 'symlink elsewhere', detail: `links to ${link} instead of ${manifest.root_file}` };\n703:   }\n704: \n705:   const content = fs.readFileSync(target, 'utf8');\n706:   if (!context.exists) {\n707:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n708:   }\n709:   if (content === context.text) {\n710:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n711:   }\n712: \n713:   const unique = localLinesOf(content, context.text);\n714:   const rootLines = trimmedLines(context.text);\n715:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n716:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n717:   // A pointer is a file that carries no shipped line and names the root document. Anything\n718:   // else is either a copy or a copy plus local lines, and both drift: the second also\n719:   // loses text when it is replaced, so the lines only it carries are listed.\n720:   if (!sharesShippedLine && namesRoot) {\n721:     return { state: PASS, kind: 'pointer', detail: `every line names ${manifest.root_file}` };\n722:   }\n723:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n724: }\n725: \n726: function isSymlink(target) {\n727:   try {\n728:     return fs.lstatSync(target).isSymbolicLink();\n729:   } catch {\n730:     return false;\n731:   }\n732: }\n733: \n734: // A11. The router: present, carrying the rows the template ships, and passing its own\n735: // checker. The checker's summary line is carried through, never rebuilt.\n736: function rowRouter(context, manifest, tools) {\n737:   const routerPath = path.join(context.root, manifest.router_file);\n738:   if (!fs.existsSync(routerPath)) {\n739:     return row('A11', 'REPO RULES.md', FINDING, 'absent',\n740:       { lines: [`no ${manifest.router_file}: no repository rule can load`], entries: [{ path: manifest.router_file, present: false }] });\n741:   }\n742: \n743:   const text = fs.readFileSync(routerPath, 'utf8');\n744:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n745:   const lines = [];\n746:   const missing = [\n747:     ...missingRows(shipped.trigger_rows, parseTableRows(text, 'TRIGGER TABLE'), 'trigger'),\n748:     ...missingRows(shipped.index_rows, parseTableRows(text, 'INDEX'), 'index'),\n749:   ];\n750:   for (const entry of missing) lines.push(`missing ${entry.kind} row for ${entry.rule}`);\n751: \n752:   if (typeof tools.repoRules !== 'string' || !fs.existsSync(tools.repoRules)) {\n753:     return row('A11', 'REPO RULES.md', UNKNOWN, 'present; the repo-rules checker is not installed',\n754:       { lines: [...lines, `the checker is not installed at ${tools.repoRules || '(no path)'}`] });\n755:   }\n756: \n757:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n758:     encoding: 'utf8',\n759:     timeout: TOOL_TIMEOUT_MS,\n760:   });\n761:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n762:   const summary = output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:'));\n763: \n764:   if (run.status === 2 || !summary) {\n765:     return row('A11', 'REPO RULES.md', UNKNOWN, 'the repo-rules checker could not run',\n766:       { lines: [...lines, ...output.filter((line) => line.includes(REPO_RULES_TAG))] });\n767:   }\n768:   if (run.status !== 0) {\n769:     return row('A11', 'REPO RULES.md', FINDING, `${missing.length} shipped row(s) missing; the checker fails`,\n770:       { lines: [...lines, summary] });\n771:   }\n772:   return row('A11', 'REPO RULES.md', lines.length === 0 ? PASS : FINDING,\n773:     `${missing.length} shipped row(s) missing; ${summary}`, { lines: [...lines, summary] });\n774: }\n775: \n776: // The router's own table, read the same way the manifest's rows were derived. Comparing\n777: // shipped rows to the file is the only way to say which of them a consumer dropped.\n778: function parseTableRows(text, anchor) {\n779:   const lines = text.split('\\n');\n780:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n781:   if (start === -1) return [];\n782: \n783:   const rows = [];\n784:   let width = 0;\n785:   for (let index = start + 1; index < lines.length; index += 1) {\n786:     const line = lines[index].trim();\n787:     if (line.startsWith('#')) break;\n788:     if (!line.startsWith('|')) {\n789:       if (rows.length > 0 && line === '') break;\n790:       continue;\n791:     }\n792:     const cells = line.replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n793:     if (cells.every((cell) => /^:?-+:?$/u.test(cell) || cell === '')) continue;\n794:     if (width === 0) {\n795:       width = cells.length;\n796:       continue;\n797:     }\n798:     if (cells.length !== width) continue;\n799:     rows.push(cells);\n800:   }\n801:   return rows;\n802: }\n803: \n804: function rulePathOf(cells) {\n805:   for (const cell of cells) {\n806:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n807:     if (linked) return linked[1];\n808:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n809:     if (bare) return bare[1];\n810:   }\n811:   return null;\n812: }\n813: \n814: function missingRows(shipped, present, kind) {\n815:   const found = new Set(present.map((cells) => rulePathOf(cells) || cells.join(' | ')));\n816:   const missing = [];\n817:   for (const cells of shipped) {\n818:     const rule = rulePathOf(cells) || cells.join(' | ');\n819:     if (!found.has(rule)) missing.push({ kind, rule });\n820:   }\n821:   return missing;\n822: }\n823: \n824: // A12. The source repository's own two promises: its block stays empty, and its derived\n825: // copy of the template is fresh. A consumer's block is its own, so this row reports INFO\n826: // there instead of telling it what to do with its own file.\n827: function rowTemplatePurity(context, manifest, tools, options) {\n828:   let source = { isSource: false, reason: `origin was not compared` };\n829:   try {\n830:     source = sourceStatus({ root: context.root, manifest });\n831:   } catch (error) {\n832:     source = { isSource: false, reason: error.message };\n833:   }\n834: \n835:   if (!options.source && !source.isSource) {\n836:     return row('A12', 'template purity', INFO,\n837:       `runs only in the source repository; ${source.reason || 'the origin differs'}`);\n838:   }\n839: \n840:   const lines = [];\n841:   if (context.blockContent) lines.push('the source repository block carries content, and every line here ships to every consumer');\n842:   if (context.block && !context.block.complete) lines.push('the source repository block is not well formed');\n843: \n844:   if (typeof tools.generator !== 'string' || !fs.existsSync(tools.generator)) {\n845:     return row('A12', 'template purity', UNKNOWN,\n846:       `the manifest generator is not installed at ${tools.generator || '(no path)'}`);\n847:   }\n848:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n849:     encoding: 'utf8',\n850:     timeout: TOOL_TIMEOUT_MS,\n851:   });\n852:   const output = `${run.stdout || ''}\\n${run.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n853:   if (run.status !== 0) lines.push(...output);\n854: \n855:   const state = lines.length === 0 ? PASS : FINDING;\n856:   return row('A12', 'template purity', state,\n857:     state === PASS ? 'block empty and the derived copy is fresh' : 'the source template is not pure', { lines });\n858: }\n859: \n860: // ─────────────────────────────────────────────────────────────────────────────\n861: // 6. REPORT\n862: // ─────────────────────────────────────────────────────────────────────────────\n863: \n864: function defaultTools(manifest) {\n865:   const canaryPin = (manifest.pins || []).find((pin) => String(pin.consumer || '').endsWith('check-rule-copies.js'));\n866:   const pointerPin = (manifest.pins || []).find((pin) => pin.kind === 'first-occurrence');\n867:   return {\n868:     canary: canaryPin ? path.join(REPO_ROOT, canaryPin.consumer) : null,\n869:     pointerSync: pointerPin ? path.join(REPO_ROOT, pointerPin.consumer) : null,\n870:     repoRules: REPO_RULES_CHECKER,\n871:     generator: GENERATOR,\n872:   };\n873: }\n874: \n875: /**\n876:  * Classify one repository.\n877:  *\n878:  * @param {{root?: string, manifestPath?: string, source?: boolean, tools?: Object}} [input]\n879:  * @returns {{root: string, manifest: string, state: string, status: string, exitCode: number,\n880:  *   findings: number, unknown: number, rows: Array<Object>} | null} Null when the root\n881:  *   directory or the manifest is not readable.\n882:  */\n883: function buildReport(input = {}) {\n884:   const root = input.root ? path.resolve(input.root) : REPO_ROOT;\n885:   const manifestPath = input.manifestPath ? path.resolve(input.manifestPath) : MANIFEST_PATH;\n886:   if (!fs.existsSync(manifestPath)) return null;\n887: \n888:   let manifest;\n889:   try {\n890:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n891:   } catch {\n892:     return null;\n893:   }\n894: \n895:   const context = readTarget({ root, manifest });\n896:   if (context === null) return null;\n897: \n898:   const tools = { ...defaultTools(manifest), ...(input.tools || {}) };\n899:   const rows = [\n900:     rowInstallState(context, manifest),\n901:     rowSectionsPresent(context, manifest),\n902:     rowOrderAndNumbering(context, manifest),\n903:     rowCurrency(context),\n904:     rowPins(context, manifest),\n905:     rowBudget(context, manifest, tools),\n906:     rowBlock(context, manifest),\n907:     rowUnmarked(context, manifest),\n908:     rowUnmarkedEdits(context, manifest),\n909:     rowRuntimeCopies(context, manifest, tools),\n910:     rowRouter(context, manifest, tools),\n911:     rowTemplatePurity(context, manifest, tools, { source: Boolean(input.source), manifest: manifestPath }),\n912:   ];\n913: \n914:   const findings = rows.filter((entry) => entry.state === FINDING).length;\n915:   const unknown = rows.filter((entry) => entry.state === UNKNOWN).length;\n916:   const exitCode = findings > 0 || unknown > 0 ? 1 : 0;\n917:   const status = exitCode === 0 ? 'OK' : (findings > 0 ? 'FINDINGS' : 'UNKNOWN');\n918: \n919:   return {\n920:     root,\n921:     manifest: manifestPath,\n922:     state: rows[0].detail,\n923:     status,\n924:     exitCode,\n925:     findings,\n926:     unknown,\n927:     rows,\n928:   };\n929: }\n930: \n931: // A long row is a list, not a wall: the report keeps every line in the JSON form and\n932: // prints the first few here, so a reader sees the shape before the volume.\n933: const PRINTED_LINES = 20;\n934: \n935: function renderText(report) {\n936:   const lines = [];\n937:   for (const entry of report.rows) {\n938:     lines.push(`${entry.id} ${entry.name}: ${entry.detail}   (${entry.state})`);\n939:     for (const line of entry.lines.slice(0, PRINTED_LINES)) lines.push(`  ${line}`);\n940:     if (entry.lines.length > PRINTED_LINES) {\n941:       lines.push(`  ... ${entry.lines.length - PRINTED_LINES} more line(s), all of them in the JSON report`);\n942:     }\n943:   }\n944:   lines.push(`STATUS=${report.status} rows=${report.rows.length} findings=${report.findings} unknown=${report.unknown}`);\n945:   return `${lines.join('\\n')}\\n`;\n946: }\n947: \n948: function renderJson(report) {\n949:   const shaped = {\n950:     root: report.root,\n951:     manifest: report.manifest,\n952:     state: report.state,\n953:     status: report.status,\n954:     exit_code: report.exitCode,\n955:     findings: report.findings,\n956:     unknown: report.unknown,\n957:     rows: report.rows.map((entry) => ({\n958:       id: entry.id,\n959:       name: entry.name,\n960:       state: entry.state,\n961:       detail: entry.detail,\n962:       lines: entry.lines,\n963:       entries: entry.entries,\n964:     })),\n965:   };\n966:   return `${JSON.stringify(shaped, null, 2)}\\n`;\n967: }\n968: \n969: // ─────────────────────────────────────────────────────────────────────────────\n970: // 7. MAIN\n971: // ─────────────────────────────────────────────────────────────────────────────\n972: \n973: /**\n974:  * @param {string[]} argv\n975:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n976:  * @returns {number} the process exit code\n977:  */\n978: function main(argv, hooks = {}) {\n979:   const options = parseArgs(argv);\n980:   if (options.help) {\n981:     console.log(USAGE);\n982:     return 0;\n983:   }\n984: \n985:   if (!fs.existsSync(options.manifest)) {\n986:     console.error(`${TAG} ERROR: the manifest is missing at ${options.manifest}`);\n987:     return 2;\n988:   }\n989:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n990:     console.error(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n991:     return 2;\n992:   }\n993:   // The root file's name is the manifest's to declare, so this precondition reads the same\n994:   // declaration every other read does instead of a name of its own.\n995:   let rootFile = null;\n996:   try {\n997:     rootFile = JSON.parse(fs.readFileSync(options.manifest, 'utf8')).root_file || null;\n998:   } catch {\n999:     // An unreadable manifest is refused below, where the run has no report to print.\n1000:     rootFile = null;\n1001:   }\n1002:   const rootPath = rootFile === null ? null : path.join(options.root, rootFile);\n1003:   if (rootPath !== null && fs.existsSync(rootPath)) {\n1004:     try {\n1005:       fs.readFileSync(rootPath, 'utf8');\n1006:     } catch (error) {\n1007:       console.error(`${TAG} ERROR: cannot read ${rootPath}: ${error.message}`);\n1008:       return 2;\n1009:     }\n1010:   }\n1011: \n1012:   const report = buildReport({\n1013:     root: options.root,\n1014:     manifestPath: options.manifest,\n1015:     source: options.source,\n1016:     tools: hooks.tools || {},\n1017:   });\n1018:   if (report === null) {\n1019:     // A manifest that cannot be parsed leaves nothing to compare against, and an empty\n1020:     // report would read like a clean one.\n1021:     console.error(`${TAG} ERROR: cannot classify ${options.root}: the manifest at ${options.manifest} could not be read as JSON`);\n1022:     return 2;\n1023:   }\n1024: \n1025:   process.stdout.write(options.json ? renderJson(report) : renderText(report));\n1026:   return report.exitCode;\n1027: }\n1028: \n1029: if (require.main === module) {\n1030:   try {\n1031:     process.exitCode = main(process.argv.slice(2));\n1032:   } catch (error) {\n1033:     console.error(`${TAG} ERROR: ${error.message}`);\n1034:     if (error instanceof UsageError) console.error(USAGE);\n1035:     process.exitCode = 2;\n1036:   }\n1037: }\n1038: \n1039: module.exports = {\n1040:   MANIFEST_PATH,\n1041:   buildReport,\n1042:   main,\n1043:   renderJson,\n1044:   renderText,\n1045: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\"}"},"time":{"start":1794545753334,"end":1794545753766}}}}
{"type":"tool_use","timestamp":1794545753907,"sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","part":{"partID":"prt_1d34319de002kh34Xs1R3d7kli","sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","messageID":"msg_1d34311c2001Loxu94Lba6cR7v","type":"tool","id":"call_0b9d68de032f48eb8214c4b3","tool":"shell","state":{"status":"completed","input":{"command":"node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"implement a pointer-missing verdict in the agents-md check CJS module and add a test case\" 2>&1 | head -30","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"{\"hubId\":\"sk-code\",\"action\":\"defer\",\"selectionKind\":null,\"targets\":[],\"effectivePolicyHash\":\"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\"generation\":2}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"hubId\":\"sk-code\",\"action\":\"defer\",\"selectionKind\":null,\"targets\":[],\"effectivePolicyHash\":\"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\"generation\":2}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \\\"implement a pointer-missing verdict in the agents-md check CJS module and add a test case\\\" 2>&1 | head -30\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794545752542,"end":1794545753907}}}}
