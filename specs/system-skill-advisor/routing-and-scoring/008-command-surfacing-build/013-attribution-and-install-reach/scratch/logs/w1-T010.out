repository puts its block wherever it likes, and both engines have to read the same\n134: // document the same way wherever that is. Moving the one block a composed recipe already\n135: // carries is how a case plants a block that is not last, without a second template.\n136: function moveBlockBefore(text, headingPrefix) {\n137:   const { markers } = manifest;\n138:   const from = text.indexOf(markers.start);\n139:   const to = text.indexOf(markers.end);\n140:   if (from === -1 || to === -1 || to < from) {\n141:     throw new Error('moveBlockBefore: the document carries no well-formed block');\n142:   }\n143:   const block = text.slice(from, to + markers.end.length);\n144:   // The markers own their own lines, so the newline after the end marker leaves with them\n145:   // instead of surviving as a blank line at the end of the section above.\n146:   const after = to + markers.end.length;\n147:   const cut = text.startsWith('\\n', after) ? after + 1 : after;\n148:   const rest = `${text.slice(0, from)}${text.slice(cut)}`;\n149:   const at = rest.indexOf(`\\n${headingPrefix}`);\n150:   if (at === -1) throw new Error(`moveBlockBefore: no line starts with ${JSON.stringify(headingPrefix)}`);\n151:   return `${rest.slice(0, at + 1)}${block}\\n${rest.slice(at + 1)}`;\n152: }\n153: \n154: // ─────────────────────────────────────────────────────────────────────────────\n155: // 3. THE RUNTIME MIRRORS\n156: // ─────────────────────────────────────────────────────────────────────────────\n157: \n158: // The Cursor rule every runtime mirror is generated from. Writing it with the sync's own\n159: // renderer is what makes the fixture a repository that has run the generator, instead of\n160: // one carrying a hand-copied block that would only prove the copy.\n161: function writePointerMirror(dir) {\n162:   const line = readGateOneLine(dir);\n163:   if (!line) return null;\n164:   const target = path.join(dir, TARGETS[0].file);\n165:   fs.mkdirSync(path.dirname(target), { recursive: true });\n166:   fs.writeFileSync(target, applyBlock('', renderBlock(TARGETS[0].intro, line)), 'utf8');\n167:   return path.relative(dir, target).split(path.sep).join('/');\n168: }\n169: \n170: // Devin never sees past the delivery prefix of the root document, so a repository with a\n171: // non-empty block is expected to carry the generated mirror of it.\n172: function writeRepoLocalMirror(dir, recipe) {\n173:   if (!recipe.block || recipe.block.markers === 'reversed') return null;\n174:   const target = path.join(dir, '.cursor/rules/repo-local.md');\n175:   fs.mkdirSync(path.dirname(target), { recursive: true });\n176:   fs.writeFileSync(target, `---\\nalwaysApply: true\\n---\\n${blockText(recipe)}\\n`, 'utf8');\n177:   return path.relative(dir, target).split(path.sep).join('/');\n178: }\n179: \n[Output truncated. Continue reading with offset: 180]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs, lines 100-179\n100:       ? historyBody(entry.id)\n101:       : derivedBody(entry.id);\n102:     for (const line of (recipe.section_edits || {})[entry.id] || []) {\n103:       body = insertIntoSection(body, line);\n104:     }\n105:     for (const row of recipe.insert_sections || []) {\n106:       if (row.before === entry.id) parts.push(row.text);\n107:     }\n108:     parts.push(body);\n109:   }\n110:   return parts.join('');\n111: }\n112: \n113: function blockText(recipe) {\n114:   const { markers } = manifest;\n115:   return `\\n${markers.heading}\\n\\n${markers.note}\\n${recipe.block.text || ''}`.trimEnd();\n116: }\n117: \n118: function composeDocumentWithBlock(recipe) {\n119:   const shipped = composeDocument(recipe);\n120:   if (!recipe.block) return shipped;\n121: \n122:   const { markers } = manifest;\n123:   if (recipe.block.markers === 'reversed') {\n124:    