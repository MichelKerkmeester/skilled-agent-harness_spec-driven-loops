{"type":"step_start","timestamp":1794545760743,"sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","part":{"id":"prt_1d34339e7001uUBReFvenDMpTe","sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","messageID":"msg_1d3432dd10017e0qzBmIEfrUwS","type":"step-start","snapshot":"73b9bdbd01ad8c3d6d048a93652ff0c1dce9058b"}}
{"type":"tool_use","timestamp":1794545760787,"sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","part":{"partID":"prt_1d34339ed002eZJSclXhrYjw4e","sessionID":"ses_e2cbe000fffeUqJQnXGz6lLg3F","messageID":"msg_1d3432dd10017e0qzBmIEfrUwS","type":"tool","id":"call_258ba0461c1145c3af04be88","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-629\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: \n48: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n49: \n50: // The rows every report carries, in the order the engine prints them.\n51: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n52: \n53: // ─────────────────────────────────────────────────────────────────────────────\n54: // 2. FIXTURE TREES\n55: // ─────────────────────────────────────────────────────────────────────────────\n56: \n57: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n58: // can read a stale copy of a document, and the tree a case runs against is always the\n59: // template that ships in this repository.\n60: function buildFixture(t, name) {\n61:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n62:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n63:   const dir = path.join(parent, name);\n64:   composeFixture(name, dir);\n65:   const documentPath = path.join(dir, manifest.root_file);\n66:   return {\n67:     dir,\n68:     recipe: loadRecipe(name),\n69:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n70:   };\n71: }\n72: \n73: // ─────────────────────────────────────────────────────────────────────────────\n74: // 3. RUNNERS AND READERS\n75: // ─────────────────────────────────────────────────────────────────────────────\n76: \n77: function runCheck(args) {\n78:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n79:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n80: }\n81: \n82: function runJson(args) {\n83:   const run = runCheck([...args, '--json']);\n84:   let report = null;\n85:   try {\n86:     report = JSON.parse(run.out);\n87:   } catch {\n88:     report = null;\n89:   }\n90:   return { ...run, report };\n91: }\n92: \n93: function rowOf(report, id) {\n94:   const row = report.rows.find((entry) => entry.id === id);\n95:   assert.ok(row, `the report carries row ${id}`);\n96:   return row;\n97: }\n98: \n99: // The text form prints one line per row, ending in the row's verdict, so the two\n100: // renderers can be compared without re-implementing either.\n101: function textRowStates(out) {\n102:   const states = {};\n103:   for (const line of out.split('\\n')) {\n104:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n105:     if (hit) states[hit[1]] = hit[2];\n106:   }\n107:   return states;\n108: }\n109: \n110: function listFiles(dir) {\n111:   const files = [];\n112:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n113:     const target = path.join(dir, entry.name);\n114:     if (entry.isDirectory()) files.push(...listFiles(target));\n115:     else files.push(target);\n116:   }\n117:   return files;\n118: }\n119: \n120: // A fixture's document is rewritten by a case that needs a shape no recipe describes,\n121: // so the tree a case reads is always the template the manifest ships today.\n122: function rewriteDocument(fixture, text) {\n123:   fs.writeFileSync(path.join(fixture.dir, manifest.root_file), text, 'utf8');\n124: }\n125: \n126: // A throwaway manifest: pin kinds and root file names are the two places a case needs a\n127: // declaration the shipped manifest does not carry.\n128: function writeManifest(t, patch) {\n129:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-manifest-'));\n130:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n131:   const target = path.join(dir, 'agents-md-manifest.json');\n132:   fs.writeFileSync(target, `${JSON.stringify({ ...manifest, ...patch }, null, 2)}\\n`, 'utf8');\n133:   return target;\n134: }\n135: \n136: function treeDigest(dir) {\n137:   const hash = crypto.createHash('sha256');\n138:   for (const file of listFiles(dir).sort()) {\n139:     hash.update(path.relative(dir, file));\n140:     hash.update(fs.readFileSync(file));\n141:   }\n142:   return hash.digest('hex');\n143: }\n144: \n145: // ─────────────────────────────────────────────────────────────────────────────\n146: // 4. THE FIXTURES ARE RECIPES, NOT COPIES\n147: // ─────────────────────────────────────────────────────────────────────────────\n148: \n149: // A composed tree committed beside its recipe would be a second copy of the template,\n150: // and the copy is what the repository would then have to keep: relative links would\n151: // resolve against the fixture folder, a runtime loading nested instruction files would\n152: // read it as somebody's own document, and each template edit would need a regeneration\n153: // commit. This case holds the rule the fixtures are arranged by.\n154: test('every fixture folder holds its recipe and no composed tree', () => {\n155:   const stray = [];\n156:   for (const name of fixtureNames()) {\n157:     for (const entry of fs.readdirSync(path.join(FIXTURES, name), { withFileTypes: true })) {\n158:       if (entry.name !== 'fixture.json' || entry.isDirectory()) stray.push(`${name}/${entry.name}`);\n159:     }\n160:   }\n161:   assert.deepEqual(stray, [],\n162:     'compose a fixture into a temporary folder with the suite\\'s composer instead of committing the tree it describes');\n163: });\n164: \n165: test('composer: the pure fixture rebuilds the shipped document from the manifest', (t) => {\n166:   const fixture = buildFixture(t, 'pure');\n167:   const { sections } = segment(fixture.document, manifest.markers, manifest.sections);\n168: \n169:   assert.equal(sections.length, manifest.sections.length, 'the composed document carries every shipped section');\n170:   for (const section of sections) {\n171:     assert.ok(section.id, `the composed heading ${JSON.stringify(section.heading)} matches a manifest entry`);\n172:     assert.equal(section.sha256, manifest.derived.sections[section.id].sha256,\n173:       `section ${section.id} is byte-identical to the manifest's derived body`);\n174:   }\n175:   const rootDocument = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n176:   assert.ok(rootDocument.startsWith(fixture.document),\n177:     'the composed document is the root document up to its repository block');\n178: });\n179: \n180: test('composer: each fixture declares the install state it plants', () => {\n181:   const names = fixtureNames();\n182:   assert.equal(names.length, 9, 'there are nine fixture recipes');\n183:   for (const name of names) {\n184:     const recipe = loadRecipe(name);\n185:     assert.equal(recipe.name, name, `${name} names itself`);\n186:     assert.ok(recipe.expect_state, `${name} declares its expected install state`);\n187:     assert.ok(recipe.notes, `${name} says what defect it plants`);\n188:   }\n189: });\n190: \n191: // ─────────────────────────────────────────────────────────────────────────────\n192: // 5. A1 INSTALL STATE, ONE FIXTURE PER STATE\n193: // ─────────────────────────────────────────────────────────────────────────────\n194: \n195: for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n196:   test(`A1 install state: the ${name} fixture classifies as ${loadRecipe(name).expect_state}`, (t) => {\n197:     const fixture = buildFixture(t, name);\n198:     const run = runJson(['--root', fixture.dir]);\n199: \n200:     assert.ok(run.report, `the engine prints a JSON report for ${name}; stderr: ${run.err}`);\n201:     assert.equal(run.report.state, fixture.recipe.expect_state);\n202:     assert.match(run.out, new RegExp(`\"state\": \"${fixture.recipe.expect_state}\"`));\n203:   });\n204: }\n205: \n206: test('A1 install state: this repository is the source template and classifies as pure', () => {\n207:   const report = buildReport({ root: REPO_ROOT });\n208:   assert.equal(report.state, 'pure', 'the shipped template carries every section current and an empty block');\n209: });\n210: \n211: // ─────────────────────────────────────────────────────────────────────────────\n212: // 6. UNMARKED CONTENT AND UNMARKED EDITS\n213: // ─────────────────────────────────────────────────────────────────────────────\n214: \n215: test('forked: A8 lists the unmarked section with its byte range and A9 lists the local line', (t) => {\n216:   const fixture = buildFixture(t, 'forked');\n217:   const run = runJson(['--root', fixture.dir]);\n218: \n219:   assert.equal(run.code, 1, 'a forked repository is a finding, not a pass');\n220:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n221: \n222:   const unmarked = rowOf(run.report, 'A8');\n223:   assert.equal(unmarked.state, 'FINDING');\n224:   const section = unmarked.entries.find((entry) => entry.heading.includes('Local release checklist'));\n225:   assert.ok(section, \"A8 lists the repository's own section by heading\");\n226:   assert.ok(section.byte_start > 0 && section.byte_end > section.byte_start, 'A8 gives the section a byte range');\n227:   assert.equal(section.line_start, fixture.document.split('\\n').indexOf('## Local release checklist') + 1,\n228:     'A8 gives the section a line range that a reader can open');\n229:   assert.equal(section.in_prefix, false, 'the section sits outside the delivery prefix');\n230: \n231:   const edits = rowOf(run.report, 'A9');\n232:   assert.equal(edits.state, 'FINDING');\n233:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n234:   assert.ok(edited, 'A9 names the edited section');\n235:   assert.equal(edited.state, 'edited');\n236:   assert.deepEqual(edited.lines, ['Local rule: name the packet in the first line of every pull request.']);\n237: });\n238: \n239: // The same sentence written twice is two lines a replacement would lose, so the row\n240: // counts occurrences: a set would report one line and hide the other.\n241: test('A9 counts a repeated local line once per occurrence', (t) => {\n242:   const fixture = buildFixture(t, 'forked');\n243:   const line = 'Local rule: name the packet in the first line of every pull request.';\n244:   rewriteDocument(fixture, fixture.document.replace(line, `${line}\\n${line}`));\n245: \n246:   const run = runJson(['--root', fixture.dir]);\n247:   const edits = rowOf(run.report, 'A9');\n248:   assert.equal(edits.state, 'FINDING');\n249:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n250:   assert.deepEqual(edited.lines, [line, line], 'the repeated line is listed twice');\n251:   assert.match(edits.detail, /1 section\\(s\\) carry 2 local line\\(s\\)/);\n252: });\n253: \n254: // A repository that wrote its block between two shipped sections still carries every\n255: // shipped section, and the block is in the one place the template does not put it. Read\n256: // only above the block, the document looks like somebody else's file and the position is\n257: // never named.\n258: test('a block placed between shipped sections is reported by A7 with its position', (t) => {\n259:   const fixture = buildFixture(t, 'adopted');\n260:   const moved = moveBlockBefore(fixture.document, '#### The Four Laws');\n261:   rewriteDocument(fixture, moved);\n262: \n263:   const run = runJson(['--root', fixture.dir]);\n264:   assert.equal(rowOf(run.report, 'A1').detail, 'adopted', 'every shipped section is still current');\n265:   assert.equal(rowOf(run.report, 'A2').detail, '44/44 matched', 'the sections below the block are shipped ones');\n266:   assert.equal(rowOf(run.report, 'A8').state, 'PASS', 'nothing below the block is unmarked content');\n267: \n268:   const block = rowOf(run.report, 'A7');\n269:   assert.equal(block.state, 'FINDING');\n270:   const position = block.lines.join(' ');\n271:   // Offsets in the report are bytes, and the template carries multi-byte headings above\n272:   // the block, so the character index is not the figure to compare against.\n273:   const blockByte = Buffer.byteLength(moved.slice(0, moved.indexOf(manifest.markers.start)), 'utf8');\n274:   assert.ok(position.includes(`byte ${blockByte}`), `A7 names where the block sits: ${position}`);\n275:   assert.match(position, /The Four Laws/, 'A7 names the shipped section the block sits in front of');\n276: });\n277: \n278: // The end marker is not the end of the file: a line typed below it is the repository's\n279: // own, and a rewrite that keeps only the block would drop it without a word.\n280: test('a line after the block end marker is reported as a local edit', (t) => {\n281:   const fixture = buildFixture(t, 'adopted');\n282:   const line = 'Ship the release note in the same commit as the tag.';\n283:   rewriteDocument(fixture, `${fixture.document}${line}\\n`);\n284: \n285:   const run = runJson(['--root', fixture.dir]);\n286:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n287: \n288:   const edits = rowOf(run.report, 'A9');\n289:   assert.equal(edits.state, 'FINDING');\n290:   const carrier = edits.entries.find((entry) => entry.lines.includes(line));\n291:   assert.ok(carrier, `A9 lists the line below the end marker: ${JSON.stringify(edits.entries)}`);\n292: });\n293: \n294: // Text above the first heading belongs to no section, so it is the one piece of\n295: // repository content a heading-shaped comparison cannot see. Left unreported, a document\n296: // carrying it reads as a pure template and a rewrite drops it.\n297: test('text before the first shipped heading is reported as unmarked repository content', (t) => {\n298:   const fixture = buildFixture(t, 'pure');\n299:   const line = 'Read me first.';\n300:   rewriteDocument(fixture, `${line}\\n${fixture.document}`);\n301: \n302:   const run = runJson(['--root', fixture.dir]);\n303:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n304: \n305:   const unmarked = rowOf(run.report, 'A8');\n306:   assert.equal(unmarked.state, 'FINDING');\n307:   const prelude = unmarked.entries.find((entry) => entry.heading === null);\n308:   assert.ok(prelude, `A8 names the text above the first heading: ${JSON.stringify(unmarked.entries)}`);\n309:   assert.equal(prelude.byte_start, 0, 'the region starts at the first byte');\n310:   assert.equal(prelude.line_start, 1);\n311:   assert.match(unmarked.lines.join(' '), /before the first heading/);\n312: });\n313: \n314: // A body can carry every line the shipped body carries and still not be it: one extra\n315: // space on an indented bullet is a real difference and a rewrite replaces it. A finding\n316: // with nothing under it names no line to look at, so the row says what the difference is\n317: // and where the two bodies part company.\n318: test('A9 names a body that differs only in whitespace, by line', (t) => {\n319:   const fixture = buildFixture(t, 'pure');\n320:   const shipped = manifest.derived.sections['gate-3'].body;\n321:   const lines = shipped.split('\\n');\n322:   const indented = lines.findIndex((row) => row.startsWith('  '));\n323:   assert.notEqual(indented, -1, 'the shipped body carries an indented line');\n324:   lines[indented] = ` ${lines[indented]}`;\n325:   assert.notEqual(lines[indented], shipped.split('\\n')[indented]);\n326:   rewriteDocument(fixture, fixture.document.replace(shipped, lines.join('\\n')));\n327: \n328:   const run = runJson(['--root', fixture.dir]);\n329:   assert.equal(rowOf(run.report, 'A4').entries.find((entry) => entry.id === 'gate-3').state, 'edited', 'the body is not the shipped one');\n330: \n331:   const edits = rowOf(run.report, 'A9');\n332:   assert.equal(edits.state, 'FINDING', 'the section is not the shipped one, so the row reports it');\n333:   assert.ok(edits.lines.length > 0, 'a finding names at least one line to act on');\n334:   assert.match(edits.lines[0], /gate-3/u, 'the line names the section');\n335:   assert.match(edits.lines[0], new RegExp(`line ${indented + 1}\\\\b`, 'u'), 'and the line of the body where the two differ');\n336:   assert.match(edits.lines[0], /whitespace/u, 'and says the difference is whitespace');\n337: \n338:   const text = runCheck(['--root', fixture.dir]);\n339:   assert.match(text.out, /A9 unmarked local edits: .*\\(FINDING\\)/u);\n340:   assert.match(text.out, /gate-3: only whitespace/u, 'the text form prints the same line');\n341: });\n342: \n343: // A marker is the whole line, so a sentence that quotes both markers is prose. Counting\n344: // the bytes instead would report a document with no block as carrying two of them, which\n345: // is a finding about a file nobody can fix.\n346: test('A7 counts marker lines, not the marker text quoted inside a sentence', (t) => {\n347:   const fixture = buildFixture(t, 'pure');\n348:   const sentence = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n349:   rewriteDocument(fixture, `${fixture.document}${sentence}\\n`);\n350: \n351:   const run = runJson(['--root', fixture.dir]);\n352:   const block = rowOf(run.report, 'A7');\n353:   assert.equal(block.state, 'PASS', `a sentence quoting both markers is prose, not a block: ${block.lines.join(' | ')}`);\n354:   assert.match(block.detail, /no block/u, 'the document carries no block, because neither marker is a line of its own');\n355: });\n356: \n357: // ─────────────────────────────────────────────────────────────────────────────\n358: // 7. PINS, BUDGET AND BLOCK SHAPE\n359: // ─────────────────────────────────────────────────────────────────────────────\n360: \n361: test('shadowed-pin: A5 fails because the local lookup line comes before Gate 1', (t) => {\n362:   const fixture = buildFixture(t, 'shadowed-pin');\n363:   const run = runJson(['--root', fixture.dir]);\n364: \n365:   const pins = rowOf(run.report, 'A5');\n366:   assert.equal(pins.state, 'FINDING');\n367:   const pin = pins.entries.find((entry) => entry.id === 'gate1-lookup');\n368:   assert.ok(pin, 'A5 names the pin the local line shadows');\n369:   assert.equal(pin.state, 'FINDING');\n370:   assert.match(pin.detail, /first occurrence/i);\n371: });\n372: \n373: test('over-budget: A6 and A7 both fail', (t) => {\n374:   const fixture = buildFixture(t, 'over-budget');\n375:   const total = Buffer.byteLength(fixture.document, 'utf8');\n376:   assert.ok(total > manifest.budget.max_bytes, `the fixture is ${total} bytes, past the ${manifest.budget.max_bytes}-byte ceiling`);\n377: \n378:   const run = runJson(['--root', fixture.dir]);\n379:   assert.equal(rowOf(run.report, 'A6').state, 'FINDING');\n380:   const block = rowOf(run.report, 'A7');\n381:   assert.equal(block.state, 'FINDING');\n382:   assert.match(block.lines.join(' '), /end marker sits before the start marker/i);\n383:   assert.match(block.lines.join(' '), /exceeds the 32768-byte ceiling/);\n384: });\n385: \n386: // A pin the engine has no rule for is a pin nobody measured. Counting it as a hold is\n387: // how a manifest edit that adds a kind is reported as verified instead of unmeasured.\n388: test('a pin kind with no rule is UNKNOWN, never a hold', (t) => {\n389:   const fixture = buildFixture(t, 'pure');\n390:   const manifestPath = writeManifest(t, {\n391:     pins: [...manifest.pins, { id: 'invented-pin', kind: 'invented', texts: ['nothing'] }],\n392:   });\n393: \n394:   const run = runJson(['--root', fixture.dir, '--manifest', manifestPath]);\n395:   const pins = rowOf(run.report, 'A5');\n396:   assert.equal(pins.state, 'UNKNOWN');\n397:   const entry = pins.entries.find((candidate) => candidate.id === 'invented-pin');\n398:   assert.equal(entry.state, 'UNKNOWN', 'the entry is not recorded as a pass');\n399:   assert.match(pins.detail, /1 unmeasured/);\n400:   assert.equal(run.report.unknown, 1);\n401:   assert.match(run.out, /\"unknown\": 1/);\n402: });\n403: \n404: // An empty classification is not a verified one. The rows around it already say the\n405: // document is empty or foreign, so a PASS here reads as \"currency checked, all current\".\n406: test('A4 reports INFO when there is no matched section to classify', (t) => {\n407:   const fixture = buildFixture(t, 'foreign');\n408:   const run = runJson(['--root', fixture.dir]);\n409: \n410:   const currency = rowOf(run.report, 'A4');\n411:   assert.equal(currency.state, 'INFO');\n412:   assert.match(currency.detail, /no shipped section/i);\n413: });\n414: \n415: test('a missing canary leaves A6 UNKNOWN, never a pass, and fails the run', (t) => {\n416:   const report = buildReport({\n417:     root: REPO_ROOT,\n418:     tools: { canary: path.join(REPO_ROOT, 'no-such-canary.js') },\n419:   });\n420: \n421:   const budget = report.rows.find((row) => row.id === 'A6');\n422:   assert.equal(budget.state, 'UNKNOWN', 'an absent canary cannot be reported as a pass');\n423:   assert.match(budget.detail, /not installed|absent|missing/i);\n424:   assert.equal(report.exitCode, 1, 'a row that could not be proven keeps the run from claiming a pass');\n425:   assert.equal(report.status, 'UNKNOWN');\n426: \n427:   // Installed on a throwaway root, the same row measures instead of giving up.\n428:   const fixture = buildFixture(t, 'pure');\n429:   assert.notEqual(rowOf(runJson(['--root', fixture.dir]).report, 'A6').state, 'UNKNOWN');\n430: });\n431: \n432: // ─────────────────────────────────────────────────────────────────────────────\n433: // 8. RUNTIME COPIES\n434: // ─────────────────────────────────────────────────────────────────────────────\n435: \n436: test('a divergent CLAUDE.md fails A10 and lists the lines only it carries', (t) => {\n437:   const fixture = buildFixture(t, 'adopted');\n438:   const run = runJson(['--root', fixture.dir]);\n439: \n440:   const copies = rowOf(run.report, 'A10');\n441:   assert.equal(copies.state, 'FINDING');\n442:   const copy = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n443:   assert.ok(copy, 'A10 names the CLAUDE.md row');\n444:   assert.equal(copy.state, 'FINDING');\n445:   assert.equal(copy.kind, 'divergent copy');\n446:   assert.deepEqual(copy.lines, [\n447:     '# Project notes',\n448:     'Run `make check` before you open a pull request.',\n449:     'Update the changelog in the same commit as the code.',\n450:   ]);\n451: });\n452: \n453: test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n454:   const fixture = buildFixture(t, 'pure');\n455:   fs.writeFileSync(\n456:     path.join(fixture.dir, 'CLAUDE.md'),\n457:     '# Claude\\n\\nAll project instructions live in `AGENTS.md`.\\n',\n458:     'utf8',\n459:   );\n460:   const report = buildReport({ root: fixture.dir });\n461: \n462:   const copies = report.rows.find((row) => row.id === 'A10');\n463:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n464:   assert.equal(claude.kind, 'pointer');\n465:   assert.equal(claude.state, 'PASS');\n466:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n467:   assert.equal(codex.kind, 'absent');\n468:   assert.equal(codex.state, 'PASS');\n469: });\n470: \n471: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n472: // prints as a pass line with no detail and leaves the run reporting unknown=0.\n473: test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n474:   const fixture = buildFixture(t, 'pure');\n475:   const report = buildReport({\n476:     root: fixture.dir,\n477:     tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n478:   });\n479: \n480:   const copies = report.rows.find((row) => row.id === 'A10');\n481:   assert.equal(copies.state, 'UNKNOWN', 'a copy that could not be checked is not a pass');\n482:   const entry = copies.entries.find((candidate) => candidate.path === '.cursor/rules/skill-routing.md');\n483:   assert.equal(entry.state, 'UNKNOWN');\n484:   assert.ok(copies.lines.some((line) => line.includes('.cursor/rules/skill-routing.md')),\n485:     `the unmeasured copy is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n486:   assert.equal(report.unknown, 1);\n487:   assert.equal(report.exitCode, 1);\n488:   assert.match(renderText(report), /unknown=1/u);\n489: });\n490: \n491: // ─────────────────────────────────────────────────────────────────────────────\n492: // 9. EXIT CODES AND THE READ-ONLY PROMISE\n493: // ─────────────────────────────────────────────────────────────────────────────\n494: \n495: test('exit codes: 0 on this repository, 1 on a finding, 2 on a failed precondition', (t) => {\n496:   const clean = runCheck([]);\n497:   assert.equal(clean.code, 0, `this repository reports no finding; output: ${clean.out}`);\n498: \n499:   const fixture = buildFixture(t, 'forked');\n500:   const finding = runCheck(['--root', fixture.dir]);\n501:   assert.equal(finding.code, 1, 'a finding exits 1');\n502: \n503:   const missingRoot = runCheck(['--root', path.join(fixture.dir, 'no-such-directory')]);\n504:   assert.equal(missingRoot.code, 2, 'a missing root is a failed precondition');\n505:   assert.match(missingRoot.err, /no-such-directory/, 'the failure names the path it could not read');\n506: \n507:   const missingManifest = runCheck(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'no-such-manifest.json')]);\n508:   assert.equal(missingManifest.code, 2, 'a missing manifest is a failed precondition');\n509:   assert.match(missingManifest.err, /no-such-manifest\\.json/);\n510: });\n511: \n512: test('exit codes: an absent instruction file is a finding, not a precondition failure', (t) => {\n513:   const fixture = buildFixture(t, 'absent');\n514:   const run = runCheck(['--root', fixture.dir]);\n515:   assert.equal(run.code, 1, 'nothing to compare is an answer about the repository, not a broken run');\n516: });\n517: \n518: // The root file's name is the manifest's to declare. Naming it here means a manifest that\n519: // moves the document leaves this precondition reading a file nobody ships.\n520: test('the readability precondition reads the manifest\\'s root file, not a fixed name', (t) => {\n521:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-root-file-'));\n522:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n523:   // A directory under the name the script used to hardcode: reading it throws, so a run\n524:   // that reads it exits 2 instead of classifying the tree.\n525:   fs.mkdirSync(path.join(root, 'AGENTS.md'));\n526:   const manifestPath = writeManifest(t, { root_file: 'GUIDE.md' });\n527: \n528:   const run = runCheck(['--root', root, '--manifest', manifestPath]);\n529:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n530:   assert.doesNotMatch(run.err, /cannot read/u);\n531: });\n532: \n533: test('the write-spy records no filesystem write while every row executes', (t) => {\n534:   const fixture = buildFixture(t, 'forked');\n535:   const watched = [\n536:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n537:     'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n538:     'writeFile', 'appendFile', 'mkdir', 'rm', 'unlink', 'copyFile', 'rename', 'openSync',\n539:   ];\n540:   const calls = [];\n541:   const originals = new Map();\n542:   for (const name of watched) {\n543:     if (typeof fs[name] !== 'function') continue;\n544:     originals.set(name, fs[name]);\n545:     fs[name] = (...args) => {\n546:       calls.push(`${name}(${String(args[0])})`);\n547:       return originals.get(name).apply(fs, args);\n548:     };\n549:   }\n550: \n551:   let report = null;\n552:   try {\n553:     report = buildReport({ root: fixture.dir });\n554:   } finally {\n555:     for (const [name, original] of originals) fs[name] = original;\n556:   }\n557: \n558:   assert.deepEqual(calls, [], 'the run wrote nothing');\n559:   assert.equal(report.rows.length, ROWS.length, 'every row ran with the spy in place');\n560: });\n561: \n562: test('every fixture run leaves its tree byte-identical', (t) => {\n563:   for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n564:     const fixture = buildFixture(t, name);\n565:     const before = treeDigest(fixture.dir);\n566:     runCheck(['--root', fixture.dir, '--json']);\n567:     runCheck(['--root', fixture.dir]);\n568:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n569:   }\n570: });\n571: \n572: // ─────────────────────────────────────────────────────────────────────────────\n573: // 10. REPORT SHAPE\n574: // ─────────────────────────────────────────────────────────────────────────────\n575: \n576: test('every row appears in the report, once, in order', (t) => {\n577:   const fixture = buildFixture(t, 'pure');\n578:   const run = runCheck(['--root', fixture.dir]);\n579:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n580:   assert.deepEqual(printed, ROWS);\n581: \n582:   const report = buildReport({ root: fixture.dir });\n583:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n584: });\n585: \n586: test('--json carries the same rows and the same state as the text form', (t) => {\n587:   const fixture = buildFixture(t, 'forked');\n588:   const text = runCheck(['--root', fixture.dir]);\n589:   const json = runJson(['--root', fixture.dir]);\n590: \n591:   assert.equal(json.code, text.code, 'the two forms agree on the exit code');\n592:   assert.equal(json.report.state, 'forked');\n593:   const fromText = textRowStates(text.out);\n594:   assert.deepEqual(Object.keys(fromText).sort(), ROWS.slice().sort());\n595:   for (const row of json.report.rows) {\n596:     assert.equal(row.state, fromText[row.id], `row ${row.id} reads the same in both forms`);\n597:   }\n598: });\n599: \n600: test('this repository reports STATUS=OK and a pure install state', () => {\n601:   const run = runCheck([]);\n602:   assert.equal(run.code, 0);\n603:   assert.match(run.out, /^STATUS=OK/m);\n604:   assert.match(run.out, /^A1 install state: pure/m);\n605: });\n606: \n607: test('A11 embeds the repo-rules checker\\'s own summary line instead of re-deriving it', () => {\n608:   const report = buildReport({ root: REPO_ROOT });\n609:   const row = report.rows.find((entry) => entry.id === 'A11');\n610:   assert.equal(row.state, 'PASS');\n611:   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n612: });\n613: \n614: test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n615:   const fixture = buildFixture(t, 'pure');\n616:   const outside = buildReport({ root: fixture.dir });\n617:   const row = outside.rows.find((entry) => entry.id === 'A12');\n618:   assert.equal(row.state, 'INFO');\n619:   assert.match(row.detail, /source repository/);\n620: \n621:   const inside = buildReport({ root: REPO_ROOT });\n622:   assert.equal(inside.rows.find((entry) => entry.id === 'A12').state, 'PASS');\n623: });\n624: \n625: test('a precondition failure exits 2 rather than printing an empty report', (t) => {\n626:   const fixture = buildFixture(t, 'pure');\n627:   const code = main(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'missing.json')]);\n628:   assert.equal(code, 2);\n629: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-629\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: \n48: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n49: \n50: // The rows every report carries, in the order the engine prints them.\n51: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n52: \n53: // ─────────────────────────────────────────────────────────────────────────────\n54: // 2. FIXTURE TREES\n55: // ─────────────────────────────────────────────────────────────────────────────\n56: \n57: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n58: // can read a stale copy of a document, and the tree a case runs against is always the\n59: // template that ships in this repository.\n60: function buildFixture(t, name) {\n61:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n62:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n63:   const dir = path.join(parent, name);\n64:   composeFixture(name, dir);\n65:   const documentPath = path.join(dir, manifest.root_file);\n66:   return {\n67:     dir,\n68:     recipe: loadRecipe(name),\n69:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n70:   };\n71: }\n72: \n73: // ─────────────────────────────────────────────────────────────────────────────\n74: // 3. RUNNERS AND READERS\n75: // ─────────────────────────────────────────────────────────────────────────────\n76: \n77: function runCheck(args) {\n78:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n79:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n80: }\n81: \n82: function runJson(args) {\n83:   const run = runCheck([...args, '--json']);\n84:   let report = null;\n85:   try {\n86:     report = JSON.parse(run.out);\n87:   } catch {\n88:     report = null;\n89:   }\n90:   return { ...run, report };\n91: }\n92: \n93: function rowOf(report, id) {\n94:   const row = report.rows.find((entry) => entry.id === id);\n95:   assert.ok(row, `the report carries row ${id}`);\n96:   return row;\n97: }\n98: \n99: // The text form prints one line per row, ending in the row's verdict, so the two\n100: // renderers can be compared without re-implementing either.\n101: function textRowStates(out) {\n102:   const states = {};\n103:   for (const line of out.split('\\n')) {\n104:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n105:     if (hit) states[hit[1]] = hit[2];\n106:   }\n107:   return states;\n108: }\n109: \n110: function listFiles(dir) {\n111:   const files = [];\n112:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n113:     const target = path.join(dir, entry.name);\n114:     if (entry.isDirectory()) files.push(...listFiles(target));\n115:     else files.push(target);\n116:   }\n117:   return files;\n118: }\n119: \n120: // A fixture's document is rewritten by a case that needs a shape no recipe describes,\n121: // so the tree a case reads is always the template the manifest ships today.\n122: function rewriteDocument(fixture, text) {\n123:   fs.writeFileSync(path.join(fixture.dir, manifest.root_file), text, 'utf8');\n124: }\n125: \n126: // A throwaway manifest: pin kinds and root file names are the two places a case needs a\n127: // declaration the shipped manifest does not carry.\n128: function writeManifest(t, patch) {\n129:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-manifest-'));\n130:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n131:   const target = path.join(dir, 'agents-md-manifest.json');\n132:   fs.writeFileSync(target, `${JSON.stringify({ ...manifest, ...patch }, null, 2)}\\n`, 'utf8');\n133:   return target;\n134: }\n135: \n136: function treeDigest(dir) {\n137:   const hash = crypto.createHash('sha256');\n138:   for (const file of listFiles(dir).sort()) {\n139:     hash.update(path.relative(dir, file));\n140:     hash.update(fs.readFileSync(file));\n141:   }\n142:   return hash.digest('hex');\n143: }\n144: \n145: // ─────────────────────────────────────────────────────────────────────────────\n146: // 4. THE FIXTURES ARE RECIPES, NOT COPIES\n147: // ─────────────────────────────────────────────────────────────────────────────\n148: \n149: // A composed tree committed beside its recipe would be a second copy of the template,\n150: // and the copy is what the repository would then have to keep: relative links would\n151: // resolve against the fixture folder, a runtime loading nested instruction files would\n152: // read it as somebody's own document, and each template edit would need a regeneration\n153: // commit. This case holds the rule the fixtures are arranged by.\n154: test('every fixture folder holds its recipe and no composed tree', () => {\n155:   const stray = [];\n156:   for (const name of fixtureNames()) {\n157:     for (const entry of fs.readdirSync(path.join(FIXTURES, name), { withFileTypes: true })) {\n158:       if (entry.name !== 'fixture.json' || entry.isDirectory()) stray.push(`${name}/${entry.name}`);\n159:     }\n160:   }\n161:   assert.deepEqual(stray, [],\n162:     'compose a fixture into a temporary folder with the suite\\'s composer instead of committing the tree it describes');\n163: });\n164: \n165: test('composer: the pure fixture rebuilds the shipped document from the manifest', (t) => {\n166:   const fixture = buildFixture(t, 'pure');\n167:   const { sections } = segment(fixture.document, manifest.markers, manifest.sections);\n168: \n169:   assert.equal(sections.length, manifest.sections.length, 'the composed document carries every shipped section');\n170:   for (const section of sections) {\n171:     assert.ok(section.id, `the composed heading ${JSON.stringify(section.heading)} matches a manifest entry`);\n172:     assert.equal(section.sha256, manifest.derived.sections[section.id].sha256,\n173:       `section ${section.id} is byte-identical to the manifest's derived body`);\n174:   }\n175:   const rootDocument = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n176:   assert.ok(rootDocument.startsWith(fixture.document),\n177:     'the composed document is the root document up to its repository block');\n178: });\n179: \n180: test('composer: each fixture declares the install state it plants', () => {\n181:   const names = fixtureNames();\n182:   assert.equal(names.length, 9, 'there are nine fixture recipes');\n183:   for (const name of names) {\n184:     const recipe = loadRecipe(name);\n185:     assert.equal(recipe.name, name, `${name} names itself`);\n186:     assert.ok(recipe.expect_state, `${name} declares its expected install state`);\n187:     assert.ok(recipe.notes, `${name} says what defect it plants`);\n188:   }\n189: });\n190: \n191: // ─────────────────────────────────────────────────────────────────────────────\n192: // 5. A1 INSTALL STATE, ONE FIXTURE PER STATE\n193: // ─────────────────────────────────────────────────────────────────────────────\n194: \n195: for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n196:   test(`A1 install state: the ${name} fixture classifies as ${loadRecipe(name).expect_state}`, (t) => {\n197:     const fixture = buildFixture(t, name);\n198:     const run = runJson(['--root', fixture.dir]);\n199: \n200:     assert.ok(run.report, `the engine prints a JSON report for ${name}; stderr: ${run.err}`);\n201:     assert.equal(run.report.state, fixture.recipe.expect_state);\n202:     assert.match(run.out, new RegExp(`\"state\": \"${fixture.recipe.expect_state}\"`));\n203:   });\n204: }\n205: \n206: test('A1 install state: this repository is the source template and classifies as pure', () => {\n207:   const report = buildReport({ root: REPO_ROOT });\n208:   assert.equal(report.state, 'pure', 'the shipped template carries every section current and an empty block');\n209: });\n210: \n211: // ─────────────────────────────────────────────────────────────────────────────\n212: // 6. UNMARKED CONTENT AND UNMARKED EDITS\n213: // ─────────────────────────────────────────────────────────────────────────────\n214: \n215: test('forked: A8 lists the unmarked section with its byte range and A9 lists the local line', (t) => {\n216:   const fixture = buildFixture(t, 'forked');\n217:   const run = runJson(['--root', fixture.dir]);\n218: \n219:   assert.equal(run.code, 1, 'a forked repository is a finding, not a pass');\n220:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n221: \n222:   const unmarked = rowOf(run.report, 'A8');\n223:   assert.equal(unmarked.state, 'FINDING');\n224:   const section = unmarked.entries.find((entry) => entry.heading.includes('Local release checklist'));\n225:   assert.ok(section, \"A8 lists the repository's own section by heading\");\n226:   assert.ok(section.byte_start > 0 && section.byte_end > section.byte_start, 'A8 gives the section a byte range');\n227:   assert.equal(section.line_start, fixture.document.split('\\n').indexOf('## Local release checklist') + 1,\n228:     'A8 gives the section a line range that a reader can open');\n229:   assert.equal(section.in_prefix, false, 'the section sits outside the delivery prefix');\n230: \n231:   const edits = rowOf(run.report, 'A9');\n232:   assert.equal(edits.state, 'FINDING');\n233:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n234:   assert.ok(edited, 'A9 names the edited section');\n235:   assert.equal(edited.state, 'edited');\n236:   assert.deepEqual(edited.lines, ['Local rule: name the packet in the first line of every pull request.']);\n237: });\n238: \n239: // The same sentence written twice is two lines a replacement would lose, so the row\n240: // counts occurrences: a set would report one line and hide the other.\n241: test('A9 counts a repeated local line once per occurrence', (t) => {\n242:   const fixture = buildFixture(t, 'forked');\n243:   const line = 'Local rule: name the packet in the first line of every pull request.';\n244:   rewriteDocument(fixture, fixture.document.replace(line, `${line}\\n${line}`));\n245: \n246:   const run = runJson(['--root', fixture.dir]);\n247:   const edits = rowOf(run.report, 'A9');\n248:   assert.equal(edits.state, 'FINDING');\n249:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n250:   assert.deepEqual(edited.lines, [line, line], 'the repeated line is listed twice');\n251:   assert.match(edits.detail, /1 section\\(s\\) carry 2 local line\\(s\\)/);\n252: });\n253: \n254: // A repository that wrote its block between two shipped sections still carries every\n255: // shipped section, and the block is in the one place the template does not put it. Read\n256: // only above the block, the document looks like somebody else's file and the position is\n257: // never named.\n258: test('a block placed between shipped sections is reported by A7 with its position', (t) => {\n259:   const fixture = buildFixture(t, 'adopted');\n260:   const moved = moveBlockBefore(fixture.document, '#### The Four Laws');\n261:   rewriteDocument(fixture, moved);\n262: \n263:   const run = runJson(['--root', fixture.dir]);\n264:   assert.equal(rowOf(run.report, 'A1').detail, 'adopted', 'every shipped section is still current');\n265:   assert.equal(rowOf(run.report, 'A2').detail, '44/44 matched', 'the sections below the block are shipped ones');\n266:   assert.equal(rowOf(run.report, 'A8').state, 'PASS', 'nothing below the block is unmarked content');\n267: \n268:   const block = rowOf(run.report, 'A7');\n269:   assert.equal(block.state, 'FINDING');\n270:   const position = block.lines.join(' ');\n271:   // Offsets in the report are bytes, and the template carries multi-byte headings above\n272:   // the block, so the character index is not the figure to compare against.\n273:   const blockByte = Buffer.byteLength(moved.slice(0, moved.indexOf(manifest.markers.start)), 'utf8');\n274:   assert.ok(position.includes(`byte ${blockByte}`), `A7 names where the block sits: ${position}`);\n275:   assert.match(position, /The Four Laws/, 'A7 names the shipped section the block sits in front of');\n276: });\n277: \n278: // The end marker is not the end of the file: a line typed below it is the repository's\n279: // own, and a rewrite that keeps only the block would drop it without a word.\n280: test('a line after the block end marker is reported as a local edit', (t) => {\n281:   const fixture = buildFixture(t, 'adopted');\n282:   const line = 'Ship the release note in the same commit as the tag.';\n283:   rewriteDocument(fixture, `${fixture.document}${line}\\n`);\n284: \n285:   const run = runJson(['--root', fixture.dir]);\n286:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n287: \n288:   const edits = rowOf(run.report, 'A9');\n289:   assert.equal(edits.state, 'FINDING');\n290:   const carrier = edits.entries.find((entry) => entry.lines.includes(line));\n291:   assert.ok(carrier, `A9 lists the line below the end marker: ${JSON.stringify(edits.entries)}`);\n292: });\n293: \n294: // Text above the first heading belongs to no section, so it is the one piece of\n295: // repository content a heading-shaped comparison cannot see. Left unreported, a document\n296: // carrying it reads as a pure template and a rewrite drops it.\n297: test('text before the first shipped heading is reported as unmarked repository content', (t) => {\n298:   const fixture = buildFixture(t, 'pure');\n299:   const line = 'Read me first.';\n300:   rewriteDocument(fixture, `${line}\\n${fixture.document}`);\n301: \n302:   const run = runJson(['--root', fixture.dir]);\n303:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n304: \n305:   const unmarked = rowOf(run.report, 'A8');\n306:   assert.equal(unmarked.state, 'FINDING');\n307:   const prelude = unmarked.entries.find((entry) => entry.heading === null);\n308:   assert.ok(prelude, `A8 names the text above the first heading: ${JSON.stringify(unmarked.entries)}`);\n309:   assert.equal(prelude.byte_start, 0, 'the region starts at the first byte');\n310:   assert.equal(prelude.line_start, 1);\n311:   assert.match(unmarked.lines.join(' '), /before the first heading/);\n312: });\n313: \n314: // A body can carry every line the shipped body carries and still not be it: one extra\n315: // space on an indented bullet is a real difference and a rewrite replaces it. A finding\n316: // with nothing under it names no line to look at, so the row says what the difference is\n317: // and where the two bodies part company.\n318: test('A9 names a body that differs only in whitespace, by line', (t) => {\n319:   const fixture = buildFixture(t, 'pure');\n320:   const shipped = manifest.derived.sections['gate-3'].body;\n321:   const lines = shipped.split('\\n');\n322:   const indented = lines.findIndex((row) => row.startsWith('  '));\n323:   assert.notEqual(indented, -1, 'the shipped body carries an indented line');\n324:   lines[indented] = ` ${lines[indented]}`;\n325:   assert.notEqual(lines[indented], shipped.split('\\n')[indented]);\n326:   rewriteDocument(fixture, fixture.document.replace(shipped, lines.join('\\n')));\n327: \n328:   const run = runJson(['--root', fixture.dir]);\n329:   assert.equal(rowOf(run.report, 'A4').entries.find((entry) => entry.id === 'gate-3').state, 'edited', 'the body is not the shipped one');\n330: \n331:   const edits = rowOf(run.report, 'A9');\n332:   assert.equal(edits.state, 'FINDING', 'the section is not the shipped one, so the row reports it');\n333:   assert.ok(edits.lines.length > 0, 'a finding names at least one line to act on');\n334:   assert.match(edits.lines[0], /gate-3/u, 'the line names the section');\n335:   assert.match(edits.lines[0], new RegExp(`line ${indented + 1}\\\\b`, 'u'), 'and the line of the body where the two differ');\n336:   assert.match(edits.lines[0], /whitespace/u, 'and says the difference is whitespace');\n337: \n338:   const text = runCheck(['--root', fixture.dir]);\n339:   assert.match(text.out, /A9 unmarked local edits: .*\\(FINDING\\)/u);\n340:   assert.match(text.out, /gate-3: only whitespace/u, 'the text form prints the same line');\n341: });\n342: \n343: // A marker is the whole line, so a sentence that quotes both markers is prose. Counting\n344: // the bytes instead would report a document with no block as carrying two of them, which\n345: // is a finding about a file nobody can fix.\n346: test('A7 counts marker lines, not the marker text quoted inside a sentence', (t) => {\n347:   const fixture = buildFixture(t, 'pure');\n348:   const sentence = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n349:   rewriteDocument(fixture, `${fixture.document}${sentence}\\n`);\n350: \n351:   const run = runJson(['--root', fixture.dir]);\n352:   const block = rowOf(run.report, 'A7');\n353:   assert.equal(block.state, 'PASS', `a sentence quoting both markers is prose, not a block: ${block.lines.join(' | ')}`);\n354:   assert.match(block.detail, /no block/u, 'the document carries no block, because neither marker is a line of its own');\n355: });\n356: \n357: // ─────────────────────────────────────────────────────────────────────────────\n358: // 7. PINS, BUDGET AND BLOCK SHAPE\n359: // ─────────────────────────────────────────────────────────────────────────────\n360: \n361: test('shadowed-pin: A5 fails because the local lookup line comes before Gate 1', (t) => {\n362:   const fixture = buildFixture(t, 'shadowed-pin');\n363:   const run = runJson(['--root', fixture.dir]);\n364: \n365:   const pins = rowOf(run.report, 'A5');\n366:   assert.equal(pins.state, 'FINDING');\n367:   const pin = pins.entries.find((entry) => entry.id === 'gate1-lookup');\n368:   assert.ok(pin, 'A5 names the pin the local line shadows');\n369:   assert.equal(pin.state, 'FINDING');\n370:   assert.match(pin.detail, /first occurrence/i);\n371: });\n372: \n373: test('over-budget: A6 and A7 both fail', (t) => {\n374:   const fixture = buildFixture(t, 'over-budget');\n375:   const total = Buffer.byteLength(fixture.document, 'utf8');\n376:   assert.ok(total > manifest.budget.max_bytes, `the fixture is ${total} bytes, past the ${manifest.budget.max_bytes}-byte ceiling`);\n377: \n378:   const run = runJson(['--root', fixture.dir]);\n379:   assert.equal(rowOf(run.report, 'A6').state, 'FINDING');\n380:   const block = rowOf(run.report, 'A7');\n381:   assert.equal(block.state, 'FINDING');\n382:   assert.match(block.lines.join(' '), /end marker sits before the start marker/i);\n383:   assert.match(block.lines.join(' '), /exceeds the 32768-byte ceiling/);\n384: });\n385: \n386: // A pin the engine has no rule for is a pin nobody measured. Counting it as a hold is\n387: // how a manifest edit that adds a kind is reported as verified instead of unmeasured.\n388: test('a pin kind with no rule is UNKNOWN, never a hold', (t) => {\n389:   const fixture = buildFixture(t, 'pure');\n390:   const manifestPath = writeManifest(t, {\n391:     pins: [...manifest.pins, { id: 'invented-pin', kind: 'invented', texts: ['nothing'] }],\n392:   });\n393: \n394:   const run = runJson(['--root', fixture.dir, '--manifest', manifestPath]);\n395:   const pins = rowOf(run.report, 'A5');\n396:   assert.equal(pins.state, 'UNKNOWN');\n397:   const entry = pins.entries.find((candidate) => candidate.id === 'invented-pin');\n398:   assert.equal(entry.state, 'UNKNOWN', 'the entry is not recorded as a pass');\n399:   assert.match(pins.detail, /1 unmeasured/);\n400:   assert.equal(run.report.unknown, 1);\n401:   assert.match(run.out, /\"unknown\": 1/);\n402: });\n403: \n404: // An empty classification is not a verified one. The rows around it already say the\n405: // document is empty or foreign, so a PASS here reads as \"currency checked, all current\".\n406: test('A4 reports INFO when there is no matched section to classify', (t) => {\n407:   const fixture = buildFixture(t, 'foreign');\n408:   const run = runJson(['--root', fixture.dir]);\n409: \n410:   const currency = rowOf(run.report, 'A4');\n411:   assert.equal(currency.state, 'INFO');\n412:   assert.match(currency.detail, /no shipped section/i);\n413: });\n414: \n415: test('a missing canary leaves A6 UNKNOWN, never a pass, and fails the run', (t) => {\n416:   const report = buildReport({\n417:     root: REPO_ROOT,\n418:     tools: { canary: path.join(REPO_ROOT, 'no-such-canary.js') },\n419:   });\n420: \n421:   const budget = report.rows.find((row) => row.id === 'A6');\n422:   assert.equal(budget.state, 'UNKNOWN', 'an absent canary cannot be reported as a pass');\n423:   assert.match(budget.detail, /not installed|absent|missing/i);\n424:   assert.equal(report.exitCode, 1, 'a row that could not be proven keeps the run from claiming a pass');\n425:   assert.equal(report.status, 'UNKNOWN');\n426: \n427:   // Installed on a throwaway root, the same row measures instead of giving up.\n428:   const fixture = buildFixture(t, 'pure');\n429:   assert.notEqual(rowOf(runJson(['--root', fixture.dir]).report, 'A6').state, 'UNKNOWN');\n430: });\n431: \n432: // ─────────────────────────────────────────────────────────────────────────────\n433: // 8. RUNTIME COPIES\n434: // ─────────────────────────────────────────────────────────────────────────────\n435: \n436: test('a divergent CLAUDE.md fails A10 and lists the lines only it carries', (t) => {\n437:   const fixture = buildFixture(t, 'adopted');\n438:   const run = runJson(['--root', fixture.dir]);\n439: \n440:   const copies = rowOf(run.report, 'A10');\n441:   assert.equal(copies.state, 'FINDING');\n442:   const copy = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n443:   assert.ok(copy, 'A10 names the CLAUDE.md row');\n444:   assert.equal(copy.state, 'FINDING');\n445:   assert.equal(copy.kind, 'divergent copy');\n446:   assert.deepEqual(copy.lines, [\n447:     '# Project notes',\n448:     'Run `make check` before you open a pull request.',\n449:     'Update the changelog in the same commit as the code.',\n450:   ]);\n451: });\n452: \n453: test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n454:   const fixture = buildFixture(t, 'pure');\n455:   fs.writeFileSync(\n456:     path.join(fixture.dir, 'CLAUDE.md'),\n457:     '# Claude\\n\\nAll project instructions live in `AGENTS.md`.\\n',\n458:     'utf8',\n459:   );\n460:   const report = buildReport({ root: fixture.dir });\n461: \n462:   const copies = report.rows.find((row) => row.id === 'A10');\n463:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n464:   assert.equal(claude.kind, 'pointer');\n465:   assert.equal(claude.state, 'PASS');\n466:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n467:   assert.equal(codex.kind, 'absent');\n468:   assert.equal(codex.state, 'PASS');\n469: });\n470: \n471: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n472: // prints as a pass line with no detail and leaves the run reporting unknown=0.\n473: test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n474:   const fixture = buildFixture(t, 'pure');\n475:   const report = buildReport({\n476:     root: fixture.dir,\n477:     tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n478:   });\n479: \n480:   const copies = report.rows.find((row) => row.id === 'A10');\n481:   assert.equal(copies.state, 'UNKNOWN', 'a copy that could not be checked is not a pass');\n482:   const entry = copies.entries.find((candidate) => candidate.path === '.cursor/rules/skill-routing.md');\n483:   assert.equal(entry.state, 'UNKNOWN');\n484:   assert.ok(copies.lines.some((line) => line.includes('.cursor/rules/skill-routing.md')),\n485:     `the unmeasured copy is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n486:   assert.equal(report.unknown, 1);\n487:   assert.equal(report.exitCode, 1);\n488:   assert.match(renderText(report), /unknown=1/u);\n489: });\n490: \n491: // ─────────────────────────────────────────────────────────────────────────────\n492: // 9. EXIT CODES AND THE READ-ONLY PROMISE\n493: // ─────────────────────────────────────────────────────────────────────────────\n494: \n495: test('exit codes: 0 on this repository, 1 on a finding, 2 on a failed precondition', (t) => {\n496:   const clean = runCheck([]);\n497:   assert.equal(clean.code, 0, `this repository reports no finding; output: ${clean.out}`);\n498: \n499:   const fixture = buildFixture(t, 'forked');\n500:   const finding = runCheck(['--root', fixture.dir]);\n501:   assert.equal(finding.code, 1, 'a finding exits 1');\n502: \n503:   const missingRoot = runCheck(['--root', path.join(fixture.dir, 'no-such-directory')]);\n504:   assert.equal(missingRoot.code, 2, 'a missing root is a failed precondition');\n505:   assert.match(missingRoot.err, /no-such-directory/, 'the failure names the path it could not read');\n506: \n507:   const missingManifest = runCheck(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'no-such-manifest.json')]);\n508:   assert.equal(missingManifest.code, 2, 'a missing manifest is a failed precondition');\n509:   assert.match(missingManifest.err, /no-such-manifest\\.json/);\n510: });\n511: \n512: test('exit codes: an absent instruction file is a finding, not a precondition failure', (t) => {\n513:   const fixture = buildFixture(t, 'absent');\n514:   const run = runCheck(['--root', fixture.dir]);\n515:   assert.equal(run.code, 1, 'nothing to compare is an answer about the repository, not a broken run');\n516: });\n517: \n518: // The root file's name is the manifest's to declare. Naming it here means a manifest that\n519: // moves the document leaves this precondition reading a file nobody ships.\n520: test('the readability precondition reads the manifest\\'s root file, not a fixed name', (t) => {\n521:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-root-file-'));\n522:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n523:   // A directory under the name the script used to hardcode: reading it throws, so a run\n524:   // that reads it exits 2 instead of classifying the tree.\n525:   fs.mkdirSync(path.join(root, 'AGENTS.md'));\n526:   const manifestPath = writeManifest(t, { root_file: 'GUIDE.md' });\n527: \n528:   const run = runCheck(['--root', root, '--manifest', manifestPath]);\n529:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n530:   assert.doesNotMatch(run.err, /cannot read/u);\n531: });\n532: \n533: test('the write-spy records no filesystem write while every row executes', (t) => {\n534:   const fixture = buildFixture(t, 'forked');\n535:   const watched = [\n536:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n537:     'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n538:     'writeFile', 'appendFile', 'mkdir', 'rm', 'unlink', 'copyFile', 'rename', 'openSync',\n539:   ];\n540:   const calls = [];\n541:   const originals = new Map();\n542:   for (const name of watched) {\n543:     if (typeof fs[name] !== 'function') continue;\n544:     originals.set(name, fs[name]);\n545:     fs[name] = (...args) => {\n546:       calls.push(`${name}(${String(args[0])})`);\n547:       return originals.get(name).apply(fs, args);\n548:     };\n549:   }\n550: \n551:   let report = null;\n552:   try {\n553:     report = buildReport({ root: fixture.dir });\n554:   } finally {\n555:     for (const [name, original] of originals) fs[name] = original;\n556:   }\n557: \n558:   assert.deepEqual(calls, [], 'the run wrote nothing');\n559:   assert.equal(report.rows.length, ROWS.length, 'every row ran with the spy in place');\n560: });\n561: \n562: test('every fixture run leaves its tree byte-identical', (t) => {\n563:   for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n564:     const fixture = buildFixture(t, name);\n565:     const before = treeDigest(fixture.dir);\n566:     runCheck(['--root', fixture.dir, '--json']);\n567:     runCheck(['--root', fixture.dir]);\n568:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n569:   }\n570: });\n571: \n572: // ─────────────────────────────────────────────────────────────────────────────\n573: // 10. REPORT SHAPE\n574: // ─────────────────────────────────────────────────────────────────────────────\n575: \n576: test('every row appears in the report, once, in order', (t) => {\n577:   const fixture = buildFixture(t, 'pure');\n578:   const run = runCheck(['--root', fixture.dir]);\n579:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n580:   assert.deepEqual(printed, ROWS);\n581: \n582:   const report = buildReport({ root: fixture.dir });\n583:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n584: });\n585: \n586: test('--json carries the same rows and the same state as the text form', (t) => {\n587:   const fixture = buildFixture(t, 'forked');\n588:   const text = runCheck(['--root', fixture.dir]);\n589:   const json = runJson(['--root', fixture.dir]);\n590: \n591:   assert.equal(json.code, text.code, 'the two forms agree on the exit code');\n592:   assert.equal(json.report.state, 'forked');\n593:   const fromText = textRowStates(text.out);\n594:   assert.deepEqual(Object.keys(fromText).sort(), ROWS.slice().sort());\n595:   for (const row of json.report.rows) {\n596:     assert.equal(row.state, fromText[row.id], `row ${row.id} reads the same in both forms`);\n597:   }\n598: });\n599: \n600: test('this repository reports STATUS=OK and a pure install state', () => {\n601:   const run = runCheck([]);\n602:   assert.equal(run.code, 0);\n603:   assert.match(run.out, /^STATUS=OK/m);\n604:   assert.match(run.out, /^A1 install state: pure/m);\n605: });\n606: \n607: test('A11 embeds the repo-rules checker\\'s own summary line instead of re-deriving it', () => {\n608:   const report = buildReport({ root: REPO_ROOT });\n609:   const row = report.rows.find((entry) => entry.id === 'A11');\n610:   assert.equal(row.state, 'PASS');\n611:   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n612: });\n613: \n614: test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n615:   const fixture = buildFixture(t, 'pure');\n616:   const outside = buildReport({ root: fixture.dir });\n617:   const row = outside.rows.find((entry) => entry.id === 'A12');\n618:   assert.equal(row.state, 'INFO');\n619:   assert.match(row.detail, /source repository/);\n620: \n621:   const inside = buildReport({ root: REPO_ROOT });\n622:   assert.equal(inside.rows.find((entry) => entry.id === 'A12').state, 'PASS');\n623: });\n624: \n625: test('a precondition failure exits 2 rather than printing an empty report', (t) => {\n626:   const fixture = buildFixture(t, 'pure');\n627:   const code = main(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'missing.json')]);\n628:   assert.equal(code, 2);\n629: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\"}"},"time":{"start":1794545760749,"end":1794545760787}}}}
