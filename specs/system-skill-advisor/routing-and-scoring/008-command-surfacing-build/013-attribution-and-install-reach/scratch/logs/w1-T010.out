w) => row.id === id);\n78:   if (!entry) throw new Error(`the manifest declares no section ${id}`);\n79:   const hit = manifest.derived.history.find((row) => row.body.split('\\n')[0].includes(entry.match));\n80:   if (!hit) throw new Error(`the manifest's history holds no older body for ${id}`);\n81:   return hit.body;\n82: }\n83: \n84: // A local line belongs inside the section it was written into, ahead of the divider that\n85: // closes it, so the fixture reads like an edit somebody made rather than a line appended\n86: // after the rule.\n87: function insertIntoSection(body, line) {\n88:   const divider = body.lastIndexOf('\\n---\\n');\n89:   if (divider === -1) return `${body}${line}\\n`;\n90:   return `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n91: }\n92: \n93: function composeDocument(recipe) {\n94:   if (recipe.base === 'none') return null;\n95:   if (recipe.base === 'own') return recipe.own_document;\n96: \n97:   const parts = [];\n98:   for (const entry of manifest.sections) {\n99:     let body = (recipe.replace_with_history || []).includes(entry.id)\n100:       ? historyBody(entry.id)\n[Output truncated. Continue reading with offset: 101]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":100,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs\"}"},"time":{"start":1794545908013,"end":1794545908033}}}}
