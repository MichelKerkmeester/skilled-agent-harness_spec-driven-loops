     ...(restore !== null && restore.leftoverPaths.length > 0\n1057:       ? { leftoverPaths: restore.leftoverPaths }\n1058:       : {}),\n1059:   });\n1060: \n1061:   if (turn.error !== null) {\n1062:     const detail = turn.error.message;\n1063:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1064:   }\n1065:   if (!restored) {\n1066:     return {\n1067:       status: 1,\n1068:       refusal: {\n1069:         ok: false,\n1070:         code: 'restore_failed',\n1071:         rowId: job.rowId,\n1072:         paths: changed,\n1073:         ...(restore === null ? {} : { leftoverPaths: restore.leftoverPaths }),\n1074:       },\n[Output truncated. Continue reading with offset: 1075]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 1035-1074\n1035:     return { status: EXIT_HEAD_MOVED, refusal: { ok: false, code: 'head_moved', rowId: job.rowId } };\n1036:   }\n1037: \n1038:   // A dry run spawns nothing, so an unchanged worktree is the only thing it can\n1039:   // honestly report as left as found.\n1040:   const restore = options.dryRun ? null : restoreTurn({ cwd: REPO_ROOT, before: before.status });\n1041:   const restored = options.dryRun ? changed.length === 0 : restore.restored;\n1042:   // The head the reader saw is the only place the offer was named, and not every\n1043:   // runtime keeps it, so the offer is replayed after the turn. A dry run still\n1044:   // replays it, which lets an operator read the offer without paying for a model\n1045:   // call, while the brief stays `unknown` because no session exists to read.\n1046:   const offer = replayOffer({ checkoutDir: PROJECT_DIR, prompt: job.prompt, sessionId });\n1047:   const delivered = options.dryRun\n1048:     ? 'unknown'\n1049:     : await briefDelivered({ runtime: job.runtimeName, locator });\n1050:   appendRunLine(options.out, {\n1051:     ...line,\n1052:     offeredCommand: offer.offeredCommand,\n1053:     offeredPolicy: offer.offeredPolicy,\n1054:     briefDelivered: delivered,\n1055:     restored,\n1056:     ...(restore !== null && restore.leftoverPaths.length > 0\n1057:       ? { leftoverPaths: restore.leftoverPaths }\n1058:       : {}),\n1059:   });\n1060: \n1061:   if (turn.error !== null) {\n1062:     const detail = turn.error.message;\n1063:     return { status: 1, refusal: { ok: false, code: 'spawn_failed', runtime: job.runtimeName, detail } };\n1064:   }\n1065:   if (!restored) {\n1066:     return {\n1067:       status: 1,\n1068:       refusal: {\n1069:         ok: false,\n1070:         code: 'restore_failed',\n1071:         rowId: job.rowId,\n1072:         paths: changed,\n1073:         ...(restore === null ? {} : { leftoverPaths: restore.leftoverPaths }),\n1074:       },\n[Output truncated. Continue reading with offset: 1075]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":40,\"offset\":1035,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\"}"},"time":{"start":1794547248990,"end":1794547249566}}}}
