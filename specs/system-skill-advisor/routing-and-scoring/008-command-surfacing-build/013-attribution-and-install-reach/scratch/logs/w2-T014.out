text sits beside the records rather than inside them, so a reader\n+// that reports it gives the brief a second place to be found.\n+function injectedHasBrief(injected) {\n+  return (Array.isArray(injected) ? injected : []).some(\n+    (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n+  );\n+}\n+\n /**\n  * Ask the project's Codex approval check whether its advisor hook can run.\n  *\n  * Codex skips an unapproved project hook without a warning, so a wired hook can\n","status":"modified","additions":8,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\",\"oldString\":\"function recordsHaveBrief(records) {\\n  return (Array.isArray(records) ? records : []).some((record) =>\\n    BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\\n}\",\"newString\":\"function recordsHaveBrief(records) {\\n  return (Array.isArray(records) ? records : []).some((record) =>\\n    BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\\n}\\n\\n// Injected context sits beside the records rather than inside them, so a reader\\n// that reports it gives the brief a second place to be found.\\nfunction injectedHasBrief(injected) {\\n  return (Array.isArray(injected) ? injected : []).some(\\n    (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\\n  );\\n}\"}"},"time":{"start":1794546216924,"end":1794546218434}}}}
