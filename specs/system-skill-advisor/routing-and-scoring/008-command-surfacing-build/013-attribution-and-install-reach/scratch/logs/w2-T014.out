{"type":"tool_use","timestamp":1794546270786,"sessionID":"ses_e2cb7c6f5ffey4sV46stYIlJse","part":{"partID":"prt_1d34aed05001kX8no8FL19VLHk","sessionID":"ses_e2cb7c6f5ffey4sV46stYIlJse","messageID":"msg_1d34ae3e5001bthTPu157fogxt","type":"tool","id":"call_41c9189413a74e8ba081222b","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\nindex e91ab30d6e..7eb78ac80e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n@@ -25,6 +25,7 @@\n import { spawnSync } from 'node:child_process';\n import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n import { dirname, join, resolve } from 'node:path';\n+import { fileURLToPath } from 'node:url';\n \n import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n \n@@ -36,6 +37,8 @@ const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n const DEFAULT_TIMEOUT_MS = 30_000;\n const MAX_OUTPUT_BYTES = 1024 * 1024;\n+const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../../..');\n+const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n \n function failedOffer(offerError) {\n   return { offeredCommand: null, offeredPolicy: null, offerError };\n@@ -144,22 +147,77 @@ function recordsHaveBrief(records) {\n     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n }\n \n+// Injected context sits beside the records rather than inside them, so a reader\n+// that reports it gives the brief a second place to be found.\n+function injectedHasBrief(injected) {\n+  return (Array.isArray(injected) ? injected : []).some(\n+    (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n+  );\n+}\n+\n+/**\n+ * Ask the project's Codex approval check whether its advisor hook can run.\n+ *\n+ * Codex skips an unapproved project hook without a warning, so a wired hook can\n+ * still deliver nothing. The check reports the approval recorded in the config\n+ * file it reads, and this wrapper turns that verdict into the answer the\n+ * delivery decision needs.\n+ *\n+ * @param {object} [options]\n+ * @param {string} [options.projectDir] - Project root whose hooks file is read.\n+ * @param {string} [options.configPath] - Codex config file, defaulting to the\n+ *   environment's Codex home.\n+ * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n+ */\n+export function codexHookApproval({ projectDir, configPath } = {}) {\n+  if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n+\n+  const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n+  if (configPath) args.push('--config', configPath);\n+  const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n+  if (result.error || typeof result.stdout !== 'string') return 'unknown';\n+\n+  let verdict;\n+  try {\n+    verdict = JSON.parse(result.stdout);\n+  } catch {\n+    return 'unknown';\n+  }\n+\n+  switch (verdict?.code) {\n+    case 'codex-hooks-approved':\n+      return 'approved';\n+    case 'codex-hooks-unapproved':\n+      return 'unapproved';\n+    case 'codex-advisor-hook-absent':\n+      return 'absent';\n+    case 'no-codex-hooks':\n+      return 'no-hooks';\n+    default:\n+      return 'unknown';\n+  }\n+}\n+\n /**\n  * Decide whether the advisor brief reached the session that ran the turn.\n  *\n  * A Claude transcript records the hook context as its own attachment line, so a\n- * missing attachment is a real miss. Pi keeps delivery in its session records\n- * and needs the caller's reader. Every other runtime has no confirmed record of\n- * delivery, so its answer stays `unknown` and never counts as a miss.\n+ * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n+ * session store, either as a record or as injected context beside it, and Codex\n+ * answers from its approval plus whatever its store holds. OpenCode stays\n+ * `unknown`, because its plugin adds the brief in memory and the store keeps no\n+ * copy.\n  *\n  * @param {object} options\n  * @param {string} options.runtime - The measured runtime.\n  * @param {object|null} [options.locator] - The locator the run line recorded.\n  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n  *   lives in session records rather than a transcript file.\n+ * @param {string} [options.codexConfig] - Codex config file the approval is\n+ *   read from, defaulting to the environment's Codex home.\n  * @returns {Promise<boolean | 'unknown'>}\n  */\n-export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n+export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n   if (runtime === 'claude') {\n     const transcriptPath = locator?.transcriptPath;\n     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n@@ -190,7 +248,25 @@ export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n     return false;\n   }\n \n-  if (runtime === 'pi') {\n+  if (runtime === 'pi' || runtime === 'devin' || runtime === 'dsh') {\n+    if (typeof loadSession !== 'function') return 'unknown';\n+    let loaded;\n+    try {\n+      loaded = await loadSession({ ...locator, runtime });\n+    } catch {\n+      return 'unknown';\n+    }\n+    if (!loaded?.ok) return 'unknown';\n+    return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected);\n+  }\n+\n+  if (runtime === 'codex') {\n+    // An unapproved project hook never runs, so the brief cannot have arrived.\n+    // An approved one may store its context where no reader looks yet.\n+    if (codexHookApproval({ projectDir: locator?.projectDir, configPath: codexConfig }) === 'unapproved') {\n+      return false;\n+    }\n+\n     if (typeof loadSession !== 'function') return 'unknown';\n     let loaded;\n     try {\n@@ -199,7 +275,9 @@ export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n       return 'unknown';\n     }\n     if (!loaded?.ok) return 'unknown';\n-    return recordsHaveBrief(loaded.records);\n+    return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected)\n+      ? true\n+      : 'unknown';\n   }\n \n   return 'unknown';\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex b1adccb8c3..fbb0423ceb 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -14,17 +14,31 @@\n // when its checkout is gone, that a refused row leaves no output behind, and\n // that the new log never replaces the one it reads.\n \n-import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n+import { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n import { tmpdir } from 'node:os';\n import { join } from 'node:path';\n \n import { describe, expect, it } from 'vitest';\n \n-import { backfillRunLog, briefDelivered, parseOffer, replayOffer } from '../scripts/routing-accuracy/command-offer.mjs';\n+import {\n+  backfillRunLog,\n+  briefDelivered,\n+  codexHookApproval,\n+  parseOffer,\n+  replayOffer,\n+} from '../scripts/routing-accuracy/command-offer.mjs';\n \n const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n+const CODEX_HOOKS = {\n+  hooks: {\n+    UserPromptSubmit: [\n+      { hooks: [{ command: 'node x/hooks/codex/user-prompt-submit.js' }] },\n+    ],\n+  },\n+};\n \n function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n@@ -39,6 +53,22 @@ function writeRunLog(dir: string, lines: unknown[]): string {\n   return inPath;\n }\n \n+function writeCodexRoot(withHooks: boolean): { dir: string; hooksPath: string } {\n+  const dir = mkdtempSync(join(tmpdir(), 'command-offer-codex-'));\n+  const hooksPath = join(dir, '.codex', 'hooks.json');\n+  if (withHooks) {\n+    mkdirSync(join(dir, '.codex'), { recursive: true });\n+    writeFileSync(hooksPath, JSON.stringify(CODEX_HOOKS));\n+  }\n+  return { dir, hooksPath };\n+}\n+\n+function writeCodexConfig(dir: string, lines: string[]): string {\n+  const configPath = join(dir, 'config.toml');\n+  writeFileSync(configPath, lines.map((line) => `${line}\\n`).join(''));\n+  return configPath;\n+}\n+\n describe('parseOffer', () => {\n   it('reads the command and the policy a head offers', () => {\n     expect(parseOffer(OFFERED_HEAD)).toEqual({\n@@ -77,6 +107,40 @@ describe('replayOffer', () => {\n   });\n });\n \n+describe('codexHookApproval', () => {\n+  it('reports an advisor hook that no config entry approves as unapproved', () => {\n+    const { dir } = writeCodexRoot(true);\n+    try {\n+      const configPath = writeCodexConfig(dir, []);\n+      expect(codexHookApproval({ projectDir: dir, configPath })).toBe('unapproved');\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n+  it('reports an advisor hook approved by a trusted hash as approved', () => {\n+    const { dir, hooksPath } = writeCodexRoot(true);\n+    try {\n+      const configPath = writeCodexConfig(dir, [\n+        `[hooks.state.\"${realpathSync(hooksPath)}:user_prompt_submit:0:0\"]`,\n+        'trusted_hash = \"x\"',\n+      ]);\n+      expect(codexHookApproval({ projectDir: dir, configPath })).toBe('approved');\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n+  it('reports a root with no hooks file as no-hooks', () => {\n+    const { dir } = writeCodexRoot(false);\n+    try {\n+      expect(codexHookApproval({ projectDir: dir })).toBe('no-hooks');\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+});\n+\n describe('briefDelivered', () => {\n   it('finds the advisor context in a Claude transcript attachment', async () => {\n     const { dir, transcriptPath } = writeTranscript([\n@@ -115,6 +179,48 @@ describe('briefDelivered', () => {\n       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n     })).resolves.toBe('unknown');\n   });\n+\n+  it('finds the advisor context in Devin injected nodes', async () => {\n+    await expect(briefDelivered({\n+      runtime: 'devin',\n+      locator: {},\n+      loadSession: async () => ({ ok: true, records: [], injected: [{ source: 'system', text: BRIEF }] }),\n+    })).resolves.toBe(true);\n+  });\n+\n+  it('returns false for a DSH session whose injected context holds no brief', async () => {\n+    await expect(briefDelivered({\n+      runtime: 'dsh',\n+      locator: {},\n+      loadSession: async () => ({\n+        ok: true,\n+        records: [],\n+        injected: [{ source: 'repo-guards', text: 'Repository guard rules apply.' }],\n+      }),\n+    })).resolves.toBe(false);\n+  });\n+\n+  it('stays unknown for an OpenCode session that holds the brief in its records', async () => {\n+    await expect(briefDelivered({\n+      runtime: 'opencode',\n+      locator: {},\n+      loadSession: async () => ({ ok: true, records: [{ role: 'system', content: BRIEF }], injected: [] }),\n+    })).resolves.toBe('unknown');\n+  });\n+\n+  it('returns false for a Codex hook the config never approved', async () => {\n+    const { dir } = writeCodexRoot(true);\n+    try {\n+      const configPath = writeCodexConfig(dir, []);\n+      await expect(briefDelivered({\n+        runtime: 'codex',\n+        locator: { projectDir: dir },\n+        codexConfig: configPath,\n+      })).resolves.toBe(false);\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n });\n \n describe('backfillRunLog', () => {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\nindex e91ab30d6e..7eb78ac80e 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n@@ -25,6 +25,7 @@\n import { spawnSync } from 'node:child_process';\n import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n import { dirname, join, resolve } from 'node:path';\n+import { fileURLToPath } from 'node:url';\n \n import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n \n@@ -36,6 +37,8 @@ const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n const DEFAULT_TIMEOUT_MS = 30_000;\n const MAX_OUTPUT_BYTES = 1024 * 1024;\n+const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../../..');\n+const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n \n function failedOffer(offerError) {\n   return { offeredCommand: null, offeredPolicy: null, offerError };\n@@ -144,22 +147,77 @@ function recordsHaveBrief(records) {\n     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n }\n \n+// Injected context sits beside the records rather than inside them, so a reader\n+// that reports it gives the brief a second place to be found.\n+function injectedHasBrief(injected) {\n+  return (Array.isArray(injected) ? injected : []).some(\n+    (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n+  );\n+}\n+\n+/**\n+ * Ask the project's Codex approval check whether its advisor hook can run.\n+ *\n+ * Codex skips an unapproved project hook without a warning, so a wired hook can\n+ * still deliver nothing. The check reports the approval recorded in the config\n+ * file it reads, and this wrapper turns that verdict into the answer the\n+ * delivery decision needs.\n+ *\n+ * @param {object} [options]\n+ * @param {string} [options.projectDir] - Project root whose hooks file is read.\n+ * @param {string} [options.configPath] - Codex config file, defaulting to the\n+ *   environment's Codex home.\n+ * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n+ */\n+export function codexHookApproval({ projectDir, configPath } = {}) {\n+  if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n+\n+  const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n+  if (configPath) args.push('--config', configPath);\n+  const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n+  if (result.error || typeof result.stdout !== 'string') return 'unknown';\n+\n+  let verdict;\n+  try {\n+    verdict = JSON.parse(result.stdout);\n+  } catch {\n+    return 'unknown';\n+  }\n+\n+  switch (verdict?.code) {\n+    case 'codex-hooks-approved':\n+      return 'approved';\n+    case 'codex-hooks-unapproved':\n+      return 'unapproved';\n+    case 'codex-advisor-hook-absent':\n+      return 'absent';\n+    case 'no-codex-hooks':\n+      return 'no-hooks';\n+    default:\n+      return 'unknown';\n+  }\n+}\n+\n /**\n  * Decide whether the advisor brief reached the session that ran the turn.\n  *\n  * A Claude transcript records the hook context as its own attachment line, so a\n- * missing attachment is a real miss. Pi keeps delivery in its session records\n- * and needs the caller's reader. Every other runtime has no confirmed record of\n- * delivery, so its answer stays `unknown` and never counts as a miss.\n+ * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n+ * session store, either as a record or as injected context beside it, and Codex\n+ * answers from its approval plus whatever its store holds. OpenCode stays\n+ * `unknown`, because its plugin adds the brief in memory and the store keeps no\n+ * copy.\n  *\n  * @param {object} options\n  * @param {string} options.runtime - The measured runtime.\n  * @param {object|null} [options.locator] - The locator the run line recorded.\n  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n  *   lives in session records rather than a transcript file.\n+ * @param {string} [options.codexConfig] - Codex config file the approval is\n+ *   read from, defaulting to the environment's Codex home.\n  * @returns {Promise<boolean | 'unknown'>}\n  */\n-export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n+export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n   if (runtime === 'claude') {\n     const transcriptPath = locator?.transcriptPath;\n     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n@@ -190,7 +248,25 @@ export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n     return false;\n   }\n \n-  if (runtime === 'pi') {\n+  if (runtime === 'pi' || runtime === 'devin' || runtime === 'dsh') {\n+    if (typeof loadSession !== 'function') return 'unknown';\n+    let loaded;\n+    try {\n+      loaded = await loadSession({ ...locator, runtime });\n+    } catch {\n+      return 'unknown';\n+    }\n+    if (!loaded?.ok) return 'unknown';\n+    return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected);\n+  }\n+\n+  if (runtime === 'codex') {\n+    // An unapproved project hook never runs, so the brief cannot have arrived.\n+    // An approved one may store its context where no reader looks yet.\n+    if (codexHookApproval({ projectDir: locator?.projectDir, configPath: codexConfig }) === 'unapproved') {\n+      return false;\n+    }\n+\n     if (typeof loadSession !== 'function') return 'unknown';\n     let loaded;\n     try {\n@@ -199,7 +275,9 @@ export async function briefDelivered({ runtime, locator, loadSession } = {}) {\n       return 'unknown';\n     }\n     if (!loaded?.ok) return 'unknown';\n-    return recordsHaveBrief(loaded.records);\n+    return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected)\n+      ? true\n+      : 'unknown';\n   }\n \n   return 'unknown';\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex b1adccb8c3..fbb0423ceb 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -14,17 +14,31 @@\n // when its checkout is gone, that a refused row leaves no output behind, and\n // that the new log never replaces the one it reads.\n \n-import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n+import { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n import { tmpdir } from 'node:os';\n import { join } from 