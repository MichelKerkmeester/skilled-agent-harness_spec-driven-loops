{"type":"tool_use","timestamp":1794546565213,"sessionID":"ses_e2cb172abffelzYZkz2FqDnqf9","part":{"partID":"prt_1d34f7fb5001X9JnprdP2xBJoK","sessionID":"ses_e2cb172abffelzYZkz2FqDnqf9","messageID":"msg_1d34f6e05001cZmNpTULYisO0o","type":"tool","id":"call_00_isef18r84flo1omcpdeec220","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts","limit":120},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts, lines 1-120\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Plugin Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { EventEmitter } from 'node:events';\n6: import { mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n7: import { tmpdir } from 'node:os';\n8: import { join, resolve } from 'node:path';\n9: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n10: \n11: const mockedBridge = vi.hoisted(() => ({\n12:   spawn: vi.fn(),\n13: }));\n14: \n15: vi.mock('node:child_process', () => ({\n16:   spawn: mockedBridge.spawn,\n17: }));\n18: \n19: import * as skillAdvisorPlugin from '../../../../../.opencode/plugins/system-skill-advisor.js';\n20: import * as skillAdvisorRender from '../../../../../.opencode/plugins/lib/skill-advisor-render.js';\n21: import { renderAdvisorFallbackDirective } from '../lib/render.js';\n22: import { SETUP_WORDING as HOOK_SETUP_WORDING } from '../../hooks/claude/user-prompt-submit.js';\n23: \n24: const MkSkillAdvisorPlugin = skillAdvisorPlugin.default.server;\n25: \n26: type PluginFallbackResult = NonNullable<Parameters<typeof renderAdvisorFallbackDirective>[1]>;\n27: type PluginFallbackRenderer = (\n28:   result?: PluginFallbackResult,\n29:   options?: { setupWording?: boolean },\n30: ) => string;\n31: const renderPluginFallbackDirective = (\n32:   skillAdvisorRender as unknown as { renderPluginFallbackDirective?: PluginFallbackRenderer }\n33: ).renderPluginFallbackDirective;\n34: \n35: const DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n36: const HUB_SKILLS_DIR = resolve(import.meta.dirname, '..', '..', '..');\n37: const CONTRACT_VECTORS = JSON.parse(readFileSync(resolve(\n38:   import.meta.dirname,\n39:   '../../hooks/lib/directive-lifecycle-vectors.json',\n40: ), 'utf8')) as {\n41:   vectors: Array<{\n42:     name: string;\n43:     identity: Record<string, unknown>;\n44:     steps: string[];\n45:     expected: string[];\n46:   }>;\n47: };\n48: const ORIGINAL_ENV = new Map([\n49:   ['SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED', process.env.SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED],\n50:   ['SPECKIT_SKILL_ADVISOR_HOOK_DISABLED', process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED],\n51:   ['SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP', process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP],\n52:   ['SPECKIT_PRIVATE_SKILL_ROOTS', process.env.SPECKIT_PRIVATE_SKILL_ROOTS],\n53: ]);\n54: // The dynamic route line kept when the constant directive block is dropped on a\n55: // same-content repeat within one lifecycle epoch.\n56: const ROUTE_ONLY_CONTEXT = 'Advisor: live; use sk-code 0.91/0.23 pass.';\n57: // The route brief and fallbacks share this suffix so lifecycle tests use the\n58: // production directive block.\n59: const DIRECTIVES_BLOCK = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n60: const NO_MATCH_FALLBACK_HEAD = 'Advisor: no skill matched.';\n61: const NO_MATCH_FALLBACK_CONTEXT = `Advisor: no skill matched.${DIRECTIVES_BLOCK}`;\n62: const SKIPPED_FALLBACK_CONTEXT = `Advisor: prompt skipped.${DIRECTIVES