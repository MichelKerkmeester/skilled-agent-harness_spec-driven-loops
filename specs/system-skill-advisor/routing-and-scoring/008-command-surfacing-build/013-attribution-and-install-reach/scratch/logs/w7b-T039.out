{"type":"tool_use","timestamp":1794546522593,"sessionID":"ses_e2cb172abffelzYZkz2FqDnqf9","part":{"partID":"prt_1d34ed802002FPl61zCYvkpe8v","sessionID":"ses_e2cb172abffelzYZkz2FqDnqf9","messageID":"msg_1d34ebadc001wDV4PNepCD7LBf","type":"tool","id":"chatcmpl-tool-89c6ab5fa3334105","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js, lines 1-1214\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: Skill Advisor OpenCode Plugin (system-skill-advisor)              ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Inject skill advisor brief into OpenCode model context per      ║\n5: // ║          prompt; expose status tool; manage per-instance state,          ║\n6: // ║          in-flight dedup, and bounded prompt/brief/cache sizes.           ║\n7: // ╚══════════════════════════════════════════════════════════════════════════╝\n8: 'use strict';\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: import { createHash } from 'node:crypto';\n15: import { spawn } from 'node:child_process';\n16: import { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'node:fs';\n17: import { resolve as resolvePath } from 'node:path';\n18: import { readFile } from 'node:fs/promises';\n19: import { homedir } from 'node:os';\n20: import { dirname, join, sep } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: import { createRequire } from 'node:module';\n23: \n24: import { tool } from './lib/tool-identity.js';\n25: import { dualPlugin } from './lib/v2-bridge.js';\n26: \n27: import * as messageIdentity from './lib/opencode-message-identity.js';\n28: import {\n29:   FALLBACK_DIRECTIVE,\n30:   SETUP_WORDING,\n31:   renderCompiledRouteSummaryLine,\n32:   renderPluginFallbackDirective,\n33: } from './lib/skill-advisor-render.js';\n34: import { findRepoRoot, findSourceRoot } from '../skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const PLUGIN_ID = 'system-skill-advisor';\n41: const DEFAULT_CACHE_TTL_MS = 5 * 60 * 1000;\n42: const DEFAULT_THRESHOLD_CONFIDENCE = 0.8;\n43: // Mirrors the compat contract's uncertainty ceiling. The CLI request and the\n44: // brief render must carry the same bound, or a recommendation can pass one and\n45: // fail the other.\n46: const DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\n47: const DEFAULT_MAX_TOKENS = 80;\n48: const AMBIGUOUS_TOKEN_CAP = 120;\n49: const DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\n50: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n51: const DEFAULT_NODE_BINARY = 'node';\n52: const DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n53: // advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n54: // rather than refused and reported as an outage.\n55: const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n56: const DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\n57: const DEFAULT_MAX_CACHE_ENTRIES = 1000;\n58: const MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n59: // Unique prompts each need their own advisor child, so a burst must not multiply\n60: // live processes without limit.\n61: const MAX_CONCURRENT_ADVISOR_RUNS = 2;\n62: const BRIDGE_TERMINATION_GRACE_MS = 250;\n63: const COMPILED_ROUTE_BOUNDING_ENV = 'SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING';\n64: const DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\n65: const DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\n66: const LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\n67: const LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n68: \n69: // Directive-lifecycle dedup: this plugin is a plain-JS mirror of the canonical\n70: // rule in hooks/lib/directive-lifecycle.ts (same separator, same fail-open\n71: // semantics). Deliver the full brief on the first message of a session and\n72: // after every lifecycle boundary; on a same-content repeat keep the dynamic\n73: // Advisor: route line and drop the constant directive block. The canonical\n74: // copy stays in directive-lifecycle.ts; when that module gains a compiled\n75: // dist, prefer importing it over extending this mirror.\n76: const DIRECTIVE_LIFECYCLE_DEDUP_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP';\n77: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n78: const MAX_DIRECTIVE_DEDUP_SESSIONS = 64;\n79: const pluginRequire = createRequire(import.meta.url);\n80: const { isHookEnabled } = pluginRequire('../hooks/shared/hook-flags.cjs');\n81: \n82: // The compiled-routing helper resolves from whichever adapter root actually\n83: // carries it: .opencode/bin is a link that a copied tree may lack, so a single\n84: // relative ../bin probe would spawn a broken module pair in a half-migrated tree.\n85: function resolveCompiledRouteStatusModule() {\n86:   const here = dirname(fileURLToPath(import.meta.url));\n87:   for (const candidate of [\n88:     join(here, '..', 'bin', 'compiled-route-status.cjs'),\n89:     join(here, '..', '..', '.skilled', 'bin', 'compiled-route-status.cjs'),\n90:   ]) {\n91:     if (existsSync(candidate)) return candidate;\n92:   }\n93:   return join(here, '..', 'bin', 'compiled-route-status.cjs');\n94: }\n95: \n96: // Compact, prompt-safe per-hub compiled-routing serving summary. Reads the\n97: // promoted runtime status (file-only, no engine load, no subprocess) and fails\n98: // closed to a single 'unavailable' line so the status tool never throws.\n99: function compiledRoutingStatusLines() {\n100:   try {\n101:     const statusPath = resolveCompiledRouteStatusModule();\n102:     const { computeAllStatus } = pluginRequire(statusPath);\n103:     const rows = computeAllStatus({ probeEngine: false });\n104:     const served = rows.filter((r) => r.servingAuthority === 'compiled').length;\n105:     const broken = rows.filter((r) => r.causeCode === 'engine-throw').length;\n106:     const lines = [\n107:       `compiled_routing_hubs=${rows.length}`,\n108:       `compiled_serving=${served}`,\n109:       `compiled_broken=${broken}`,\n110:     ];\n111:     for (const r of rows) lines.push(`compiled_hub_${r.hubId}=${r.servingAuthority}/${r.causeCode}`);\n112:     return lines;\n113:   } catch (err) {\n114:     return [`compiled_routing=unavailable(${err && err.message ? err.message : 'error'})`];\n115:   }\n116: }\n117: \n118: // Stable fingerprint of the current per-hub serving state, consumed from the\n119: // promoted status probe (the single source of serving truth). A manifest flip or\n120: // a kill-switch changes a hub's servingAuthority/causeCode/manifestFingerprint\n121: // here, so folding this into the advisor-brief cache key guarantees a miss and a\n122: // stale compiled brief is never re-served. Fails closed to a stable sentinel so\n123: // the degraded case still caches deterministically.\n124: function compiledServingSignature() {\n125:   try {\n126:     const statusPath = resolveCompiledRouteStatusModule();\n127:     const { computeAllStatus } = pluginRequire(statusPath);\n128:     const rows = computeAllStatus({ probeEngine: false });\n129:     const canonical = rows\n130:       .map((r) => `${r.hubId}:${r.servingAuthority}:${r.causeCode}:${r.manifestFingerprint ?? ''}:${r.effectivePolicyHash ?? ''}`)\n131:       .join('|');\n132:     return createHash('sha256').update(canonical).digest('hex');\n133:   } catch {\n134:     return 'serving-unavailable';\n135:   }\n136: }\n137: \n138: const ADVISOR_CLI_PATH = fileURLToPath(new URL('../bin/skill-advisor.cjs', import.meta.url));\n139: // Cache-signature paths follow the standalone advisor package to ensure\n140: // consistent cache invalidation across CLI and daemon builds. The CLI entry\n141: // belongs in the signature because it is the plugin's only advisor entrypoint.\n142: const ADVISOR_SOURCE_PATHS = [\n143:   ADVISOR_CLI_PATH,\n144:   fileURLToPath(new URL('../bin/system-skill-advisor-launcher.cjs', import.meta.url)),\n145:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/advisor-server.ts', import.meta.url)),\n146:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/dist/runtime/advisor-server.js', import.meta.url)),\n147: ];\n148: // Relative to the source root the workspace carries, which the signature selects.\n149: const SKILL_ROOT_RELATIVE_PATH = 'skills';\n150: const ADVISOR_ROOT_RELATIVE_PATH = join(SKILL_ROOT_RELATIVE_PATH, 'system-skill-advisor', 'runtime');\n151: const ADVISOR_JSON_RELATIVE_PATH = join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill-graph.json');\n152: const ADVISOR_SCRIPT_RELATIVE_PATHS = [\n153:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor.py'),\n154:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor_runtime.py'),\n155:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_graph_compiler.py'),\n156: ];\n157: const SHADOW_RENDERER_URL = new URL(\n158:   '../skills/system-skill-advisor/runtime/dist/runtime/lib/render.js',\n159:   import.meta.url,\n160: );\n161: let shadowRendererPromise;\n162: \n163: function loadShadowRenderer() {\n164:   shadowRendererPromise ??= import(SHADOW_RENDERER_URL).catch(() => null);\n165:   return shadowRendererPromise;\n166: }\n167: \n168: async function loadConfig() {\n169:   const path = join(homedir(), '.config', 'opencode', 'plugin', 'system-skill-advisor.json');\n170:   try {\n171:     const raw = await readFile(path, 'utf-8');\n172:     const parsed = JSON.parse(raw);\n173:     if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n174:       return { values: {}, status: 'error', errorCode: 'CONFIG_PARSE_ERROR' };\n175:     }\n176:     return { values: parsed, status: 'loaded', errorCode: null };\n177:   } catch (error) {\n178:     if (error?.code === 'ENOENT') {\n179:       return { values: {}, status: 'absent', errorCode: null };\n180:     }\n181:     return {\n182:       values: {},\n183:       status: 'error',\n184:       errorCode: error instanceof SyntaxError ? 'CONFIG_PARSE_ERROR' : 'CONFIG_READ_ERROR',\n185:     };\n186:   }\n187: }\n188: \n189: const configPromise = loadConfig();\n190: \n191: // ─────────────────────────────────────────────────────────────────────────────\n192: // 3. PURE UTILITIES\n193: // ─────────────────────────────────────────────────────────────────────────────\n194: \n195: function normalizePositiveInt(value, fallback) {\n196:   return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n197: }\n198: \n199: function normalizeThreshold(value) {\n200:   if (!Number.isFinite(value)) {\n201:     return DEFAULT_THRESHOLD_CONFIDENCE;\n202:   }\n203:   return Math.min(1, Math.max(0, Number(value)));\n204: }\n205: \n206: function envDisablesPlugin() {\n207:   return !isHookEnabled('skill-advisor');\n208: }\n209: \n210: function isDirectiveLifecycleDedupEnabled() {\n211:   const value = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV]?.trim().toLowerCase();\n212:   return value !== '0' && value !== 'false' && value !== 'off' && value !== 'no';\n213: }\n214: \n215: function splitDirectiveBrief(context) {\n216:   const index = context.indexOf(DIRECTIVE_SEPARATOR);\n217:   // index <= 0 means no directive block or no non-empty head before it.\n218:   if (index <= 0) return null;\n219:   return { head: context.slice(0, index), directives: context.slice(index) };\n220: }\n221: \n222: /** Reduce policy only for one primitive, non-conflicting session identity. */\n223: function decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n224:   if (!isDirectiveLifecycleDedupEnabled() || !identity.confirmed) {\n225:     return { suppressed: false, reduced: null };\n226:   }\n227:   const parts = splitDirectiveBrief(brief);\n228:   if (!parts?.head.trim()) return { suppressed: false, reduced: null };\n229: \n230:   const sessionID = identity.sessionID;\n231:   const generation = state.directiveGeneration;\n232:   const epoch = state.directiveEpochBySession.get(sessionID) ?? 0;\n233:   const boundary = lifecycleEvent === 'startup'\n234:     || lifecycleEvent === 'resume'\n235:     || lifecycleEvent === 'compact';\n236:   const last = state.directiveDedupBySession.get(sessionID);\n237:   if (boundary\n238:     || !last\n239:     || last.directives !== parts.directives\n240:     || last.generation !== generation\n241:     || last.epoch !== epoch) {\n242:     while (state.directiveDedupBySession.size >= MAX_DIRECTIVE_DEDUP_SESSIONS) {\n243:       const oldest = state.directiveDedupBySession.keys().next().value;\n244:       if (typeof oldest !== 'string') break;\n245:       state.directiveDedupBySession.delete(oldest);\n246:     }\n247:     state.directiveDedupBySession.set(sessionID, {\n248:       directives: parts.directives,\n249:       generation,\n250:       epoch,\n251:     });\n252:     return { suppressed: false, reduced: null };\n253:   }\n254:   return { suppressed: true, reduced: parts.head };\n255: }\n256: \n257: function disabledEnvName() {\n258:   if (process.env[DISABLED_ENV] === '1') {\n259:     return DISABLED_ENV;\n260:   }\n261:   if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n262:     return DISABLED_ENV_PLUGIN;\n263:   }\n264:   if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n265:     return LEGACY_HOOK_DISABLED_ENV;\n266:   }\n267:   if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n268:     return LEGACY_PLUGIN_DISABLED_ENV;\n269:   }\n270:   return null;\n271: }\n272: \n273: // The signature runs on every advisor lookup, so the digest of a file whose\n274: // identity is unchanged is reused instead of read and hashed again. A difference\n275: // in mtimeMs, ctimeMs, size or ino falls back to the read, and a stat or read\n276: // failure stays missing.\n277: const fileDigestCache = new Map();\n278: \n279: function fileDigest(sourcePath, stat) {\n280:   const cached = fileDigestCache.get(sourcePath);\n281:   if (cached\n282:     && cached.mtimeMs === stat.mtimeMs\n283:     && cached.ctimeMs === stat.ctimeMs\n284:     && cached.size === stat.size\n285:     && cached.ino === stat.ino) {\n286:     return cached.digest;\n287:   }\n288:   const digest = createHash('sha256').update(readFileSync(sourcePath)).digest('hex');\n289:   fileDigestCache.set(sourcePath, {\n290:     mtimeMs: stat.mtimeMs,\n291:     ctimeMs: stat.ctimeMs,\n292:     size: stat.size,\n293:     ino: stat.ino,\n294:     digest,\n295:   });\n296:   return digest;\n297: }\n298: \n299: function addFileSignature(hash, label, sourcePath) {\n300:   try {\n301:     const stat = statSync(sourcePath);\n302:     if (!stat.isFile()) {\n303:       throw new Error('not a file');\n304:     }\n305:     hash.update(label);\n306:     hash.update('\\u001f');\n307:     hash.update(sourcePath);\n308:     hash.update('\\u001f');\n309:     hash.update(String(stat.mtimeMs));\n310:     hash.update('\\u001f');\n311:     hash.update(String(stat.size));\n312:     hash.update('\\u001f');\n313:     hash.update(fileDigest(sourcePath, stat));\n314:     hash.update('\\u001e');\n315:   } catch {\n316:     hash.update(label);\n317:     hash.update('\\u001fmissing\\u001e');\n318:   }\n319: }\n320: \n321: function advisorSourceSignature(workspaceRoot) {\n322:   // Hashing the skills under a source-root name the workspace lacks records the same\n323:   // absent marker on every call, so cached advice would outlive any change to them. With\n324:   // no source root the signature is refused, and a refused signature is never cached.\n325:   // The workspace may be any directory inside the checkout, so the source root is found\n326:   // from the repository root above it.\n327:   const sourceRoot = findSourceRoot(findRepoRoot(workspaceRoot));\n328:   if (!sourceRoot) throw new Error(`no source root under ${workspaceRoot}`);\n329:   const hash = createHash('sha256');\n330:   for (const sourcePath of ADVISOR_SOURCE_PATHS) {\n331:     addFileSignature(hash, `implementation:${sourcePath}`, sourcePath);\n332:   }\n333: \n334:   const skillRoot = join(sourceRoot, SKILL_ROOT_RELATIVE_PATH);\n335:   try {\n336:     const skillSlugs = readdirSync(skillRoot, { withFileTypes: true })\n337:       .filter((entry) => entry.isDirectory() && !entry.name.startsWith('.'))\n338:       .map((entry) => entry.name)\n339:       .sort((left, right) => left.localeCompare(right));\n340:     for (const skillSlug of skillSlugs) {\n341:       const skillDir = join(skillRoot, skillSlug);\n342:       addFileSignature(hash, `skill:${skillSlug}:SKILL.md`, join(skillDir, 'SKILL.md'));\n343:       addFileSignature(hash, `skill:${skillSlug}:graph-metadata.json`, join(skillDir, 'graph-metadata.json'));\n344:       // ROUTER.md is optional, so a skill without one keeps the signature it had\n345:       // before this probe existed; only a skill that carries the file adds a part.\n346:       const routerMdPath = join(skillDir, 'ROUTER.md');\n347:       if (existsSync(routerMdPath)) {\n348:         addFileSignature(hash, `skill:${skillSlug}:ROUTER.md`, routerMdPath);\n349:       }\n350:     }\n351:   } catch {\n352:     hash.update(`${SKILL_ROOT_RELATIVE_PATH}\\u001fmissing\\u001e`);\n353:   }\n354: \n355:   for (const relativePath of ADVISOR_SCRIPT_RELATIVE_PATHS) {\n356:     addFileSignature(hash, relativePath, join(sourceRoot, relativePath));\n357:   }\n358:   const dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n359:     ?? join(sourceRoot, ADVISOR_ROOT_RELATIVE_PATH, 'database');\n360:   addFileSignature(hash, 'skill-graph.sqlite', join(dbDir, 'skill-graph.sqlite'));\n361:   addFileSignature(hash, ADVISOR_JSON_RELATIVE_PATH, join(sourceRoot, ADVISOR_JSON_RELATIVE_PATH));\n362:   return hash.digest('hex');\n363: }\n364: \n365: function normalizeOptions(rawOptions) {\n366:   const options = rawOptions && typeof rawOptions === 'object' ? rawOptions : {};\n367:   const configuredTtl = options.cacheTTLMs ?? options.cacheTtlMs;\n368:   const enabled = options.enabled !== false && !envDisablesPlugin();\n369:   const configuredTransformDedup = typeof options.deduplicateTransforms === 'boolean'\n370:     ? options.deduplicateTransforms\n371:     : undefined;\n372: \n373:   const envCacheTTLMs = Number(process.env.SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS);\n374:   const envThreshold = Number(process.env.SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE);\n375:   const envMaxTokens = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_TOKENS);\n376:   const envBridgeTimeoutMs = Number(process.env.SYSTEM_SKILL_ADVISOR_BRIDGE_TIMEOUT_MS);\n377:   const envMaxPromptBytes = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES);\n378:   const envMaxBriefChars = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_BRIEF_CHARS);\n379:   const envMaxCacheEntries = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_CACHE_ENTRIES);\n380:   const configuredBounding = typeof options.boundedCompiledRouteSummary === 'boolean'\n381:     ? options.boundedCompiledRouteSummary\n382:     : undefined;\n383: \n384:   return {\n385:     enabled,\n386:     cacheTTLMs: normalizePositiveInt(configuredTtl, normalizePositiveInt(envCacheTTLMs, DEFAULT_CACHE_TTL_MS)),\n387:     thresholdConfidence: normalizeThreshold(options.thresholdConfidence ?? (Number.isFinite(envThreshold) ? envThreshold : undefined)),\n388:     maxTokens: normalizePositiveInt(options.maxTokens, normalizePositiveInt(envMaxTokens, DEFAULT_MAX_TOKENS)),\n389:     nodeBinary: typeof options.nodeBinaryOverride === 'string' && options.nodeBinaryOverride.trim()\n390:       ? options.nodeBinaryOverride.trim()\n391:       : (process.env.SYSTEM_SKILL_ADVISOR_NODE_BINARY || process.env.SPEC_KIT_PLUGIN_NODE_BINARY || DEFAULT_NODE_BINARY),\n392:     bridgeTimeoutMs: normalizePositiveInt(options.bridgeTimeoutMs, normalizePositiveInt(envBridgeTimeoutMs, DEFAULT_BRIDGE_TIMEOUT_MS)),\n393:     maxPromptBytes: normalizePositiveInt(options.maxPromptBytes, normalizePositiveInt(envMaxPromptBytes, DEFAULT_MAX_PROMPT_BYTES)),\n394:     maxBriefChars: normalizePositiveInt(options.maxBriefChars, normalizePositiveInt(envMaxBriefChars, DEFAULT_MAX_BRIEF_CHARS)),\n395:     maxCacheEntries: normalizePositiveInt(options.maxCacheEntries, normalizePositiveInt(envMaxCacheEntries, DEFAULT_MAX_CACHE_ENTRIES)),\n396:     boundedCompiledRouteSummary: configuredBounding ?? process.env[COMPILED_ROUTE_BOUNDING_ENV] === '1',\n397:     deduplicateTransforms: configuredTransformDedup\n398:       ?? process.env[messageIdentity.OPENCODE_TRANSFORM_DEDUP_ENV] === '1',\n399:     sourceSignatureOverride: typeof options.sourceSignatureOverride === 'string'\n400:       ? options.sourceSignatureOverride\n401:       : null,\n402:     sourceSignatureProvider: typeof options.sourceSignatureProvider === 'function'\n403:       ? options.sourceSignatureProvider\n404:       : advisorSourceSignature,\n405:     spawnAdvisor: typeof options.spawnOverride === 'function' ? options.spawnOverride : spawn,\n406:   };\n407: }\n408: \n409: function sessionIdFrom(input) {\n410:   if (!input || typeof input !== 'object') {\n411:     return '__global__';\n412:   }\n413:   return normalizeSessionID(input.sessionID\n414:     || input.sessionId\n415:     || input.session?.id\n416:     || input.properties?.sessionID\n417:     || input.properties?.info?.sessionID\n418:     || input.properties?.info?.id\n419:     || '__global__');\n420: }\n421: \n422: function directiveSessionIdentityFrom(input) {\n423:   if (!input || typeof input !== 'object') {\n424:     return { sessionID: '__global__', confirmed: false };\n425:   }\n426:   const candidates = [\n427:     input.sessionID,\n428:     input.sessionId,\n429:     input.session?.id,\n430:     input.properties?.sessionID,\n431:     input.properties?.sessionId,\n432:     input.properties?.info?.sessionID,\n433:     input.properties?.info?.id,\n434:   ].filter((value) => value !== undefined && value !== null && value !== '');\n435:   const primitive = candidates.filter((value) => typeof value === 'string' || typeof value === 'number');\n436:   const normalized = [...new Set(primitive.map((value) => String(value).trim()).filter(Boolean))];\n437:   const ambiguous = candidates.some((value) => typeof value === 'object')\n438:     || input.sessionIdentityAmbiguous === true\n439:     || input.session_identity_ambiguous === true;\n440:   const conflicting = normalized.length !== 1 || primitive.length !== candidates.length;\n441:   const explicitlyRejected = input.sessionIdentityConfirmed === false\n442:     || input.session_identity_confirmed === false;\n443:   return {\n444:     sessionID: normalized.length === 1 ? normalized[0] : '__global__',\n445:     confirmed: normalized[0] !== '__global__'\n446:       && !ambiguous\n447:       && !conflicting\n448:       && !explicitlyRejected,\n449:   };\n450: }\n451: \n452: function advanceOpenCodeDirectiveBoundary(state, input) {\n453:   const identity = directiveSessionIdentityFrom(input);\n454:   if (identity.confirmed) {\n455:     const epoch = state.directiveEpochBySession.get(identity.sessionID) ?? 0;\n456:     state.directiveEpochBySession.set(identity.sessionID, epoch + 1);\n457:     state.directiveDedupBySession.delete(identity.sessionID);\n458:   } else {\n459:     state.directiveGeneration += 1;\n460:     state.directiveDedupBySession.clear();\n461:     state.directiveEpochBySession.clear();\n462:   }\n463:   return identity;\n464: }\n465: \n466: function stableStringify(value) {\n467:   if (!value || typeof value !== 'object') {\n468:     return JSON.stringify(String(value));\n469:   }\n470: \n471:   if (Array.isArray(value)) {\n472:     return `[${value.map((entry) => stableStringify(entry)).join(',')}]`;\n473:   }\n474: \n475:   return `{${Object.keys(value)\n476:     .sort()\n477:     .map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`)\n478:     .join(',')}}`;\n479: }\n480: \n481: function normalizeSessionID(value) {\n482:   if (value === null || value === undefined || value === '') {\n483:     return '__global__';\n484:   }\n485:   if (typeof value === 'object') {\n486:     return stableStringify(value);\n487:   }\n488:   return String(value);\n489: }\n490: \n491: function normalizeWorkspaceRoot(workspaceRoot) {\n492:   if (typeof workspaceRoot === 'string' && workspaceRoot.trim()) {\n493:     return resolvePath(workspaceRoot.trim());\n494:   }\n495:   return resolvePath(process.cwd());\n496: }\n497: \n498: function statusSafeBinary(binary) {\n499:   if (typeof binary === 'string' && (binary.includes('/') || binary.includes('\\\\'))) {\n500:     return '[configured-node]';\n501:   }\n502:   return binary;\n503: }\n504: \n505: function cacheKeyForPrompt(prompt, options, sessionID, sourceSignature, workspaceRoot, servingSignature) {\n506:   const sessionKey = normalizeSessionID(sessionID);\n507:   const promptKey = createHash('sha256')\n508:     .update(prompt)\n509:     .update('\\u001f')\n510:     .update(String(options.thresholdConfidence))\n511:     .update('\\u001f')\n512:     .update(String(options.maxTokens))\n513:     .update('\\u001f')\n514:     .update(sourceSignature)\n515:     .update('\\u001f')\n516:     .update(workspaceRoot)\n517:     .update('\u001f')\n518:     .update(String(servingSignature ?? ''))\n519:     .digest('hex');\n520:   return `${String(sessionKey)}::${promptKey}`;\n521: }\n522: \n523: function extractPrompt(input) {\n524:   if (typeof input === 'string') {\n525:     return input;\n526:   }\n527:   if (!input || typeof input !== 'object') {\n528:     return null;\n529:   }\n530: \n531:   const candidates = [\n532:     input.prompt,\n533:     input.text,\n534:     input.userPrompt,\n535:     input.message,\n536:     input.input,\n537:     input.properties?.prompt,\n538:     input.properties?.message,\n539:     input.request?.prompt,\n540:     input.request?.message,\n541:   ];\n542: \n543:   for (const candidate of candidates) {\n544:     if (typeof candidate === 'string' && candidate.trim()) {\n545:       return candidate;\n546:     }\n547:     if (candidate && typeof candidate === 'object') {\n548:       const content = candidate.content ?? candidate.text;\n549:       if (typeof content === 'string' && content.trim()) {\n550:         return content;\n551:       }\n552:     }\n553:   }\n554: \n555:   return null;\n556: }\n557: \n558: function cliRecommendations(data, options) {\n559:   if (!Array.isArray(data?.recommendations)) {\n560:     return [];\n561:   }\n562:   return data.recommendations\n563:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n564:     .map((recommendation) => {\n565:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n566:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n567:       return {\n568:         skill: recommendation.skillId,\n569:         confidence,\n570:         uncertainty,\n571:         // The CLI's public recommendations carry no verdict field, so the caller\n572:         // decides it from the same thresholds the renderer enforces.\n573:         passes_threshold: confidence >= options.thresholdConfidence\n574:           && uncertainty <= DEFAULT_THRESHOLD_UNCERTAINTY,\n575:         ...(Array.isArray(recommendation.ambiguousWith)\n576:           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n577:           : {}),\n578:       };\n579:     });\n580: }\n581: \n582: // Compact the served compiled decision the advisor attached to a recommendation.\n583: // Returns null when no recommendation carried a route, which keeps the injected\n584: // context byte-identical to the legacy brief.\n585: function compiledRouteSummary(data) {\n586:   if (!Array.isArray(data?.recommendations)) return null;\n587:   for (const recommendation of data.recommendations) {\n588:     const route = recommendation?.compiledRoute;\n589:     if (!route || typeof route !== 'object' || typeof route.action !== 'string') continue;\n590:     return {\n591:       outcome: route.action,\n592:       hubId: typeof route.hubId === 'string' ? route.hubId : null,\n593:       targets: Array.isArray(route.targets) ? route.targets.filter((target) => typeof target === 'string') : [],\n594:       servingAuthority: 'compiled',\n595:     };\n596:   }\n597:   return null;\n598: }\n599: \n600: /**\n601:  * Parse the advisor CLI's stdout and render its brief.\n602:  *\n603:  * @param {string} stdout - Raw CLI stdout text\n604:  * @param {Object} options - Normalized plugin options\n605:  * @returns {Promise<Object>} Response with `brief`, `status`, and `metadata`\n606:  */\n607: async function parseCliResponse(stdout, options) {\n608:   if (!stdout.trim()) {\n609:     return { brief: null, status: 'fail_open', error: 'EMPTY_STDOUT', metadata: {} };\n610:   }\n611: \n612:   let parsed;\n613:   try {\n614:     parsed = JSON.parse(stdout.trim());\n615:   } catch {\n616:     return { brief: null, status: 'fail_open', error: 'PARSE_FAIL', metadata: {} };\n617:   }\n618: \n619:   const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : null;\n620:   if (parsed?.status !== 'ok' || !data) {\n621:     return { brief: null, status: 'fail_open', error: 'UNEXPECTED_PAYLOAD', metadata: {} };\n622:   }\n623: \n624:   const recommendations = cliRecommendations(data, options);\n625:   const top = recommendations[0] ?? null;\n626:   // The CLI reports no freshness when it answered from the local scorer instead\n627:   // of the daemon; 'stale' keeps that brief renderable and honest.\n628:   const freshness = data.freshness === 'live' || data.freshness === 'stale'\n629:     ? data.freshness\n630:     : (parsed.degraded === true ? 'stale' : 'unavailable');\n631:   const tokenCap = data.ambiguous === true ? AMBIGUOUS_TOKEN_CAP : options.maxTokens;\n632:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n633:   const renderBrief = typeof renderer?.renderAdvisorBrief === 'function' ? renderer.renderAdvisorBrief : null;\n634:   const rendered = renderBrief\n635:     ? renderBrief({\n636:       status: 'ok',\n637:       freshness,\n638:       recommendations,\n639:       ambiguous: data.ambiguous === true,\n640:       metrics: { tokenCap },\n641:       sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n642:     }, {\n643:       tokenCap,\n644:       thresholdConfig: {\n645:         confidenceThreshold: options.thresholdConfidence,\n646:         uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n647:       },\n648:     })\n649:     : null;\n650:   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n651:   const routeSummary = compiledRouteSummary(data);\n652: \n653:   return {\n654:     brief,\n655:     status: brief ? 'ok' : 'skipped',\n656:     metadata: {\n657:       route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n658:       freshness,\n659:       recommendationCount: recommendations.length,\n660:       tokenCap,\n661:       skillLabel: top?.skill ?? null,\n662:       cacheHit: Boolean(data.cache?.hit),\n663:       ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n664:     },\n665:   };\n666: }\n667: \n668: // ─────────────────────────────────────────────────────────────────────────────\n669: // 4. SIZE-CAP HELPERS\n670: // ─────────────────────────────────────────────────────────────────────────────\n671: \n672: /**\n673:  * Clamp advisor brief text by JavaScript character count.\n674:  *\n675:  * @param {string} brief - Advisor brief text to clamp\n676:  * @param {number} maxChars - Maximum character count to retain\n677:  * @returns {string} Original brief or truncated prefix within the limit\n678:  */\n679: function clampBrief(brief, maxChars) {\n680:   if (typeof brief !== 'string' || brief.length <= maxChars) {\n681:     return brief;\n682:   }\n683:   return brief.slice(0, maxChars);\n684: }\n685: \n686: /**\n687:  * Insert a cache value and evict oldest entries by insertion order.\n688:  *\n689:  * @param {Map<string, Object>} cache - Cache map using insertion order as LRU state\n690:  * @param {string} key - Cache key to insert or refresh\n691:  * @param {Object} value - Cache value to store\n692:  * @param {number} maxEntries - Maximum entries retained after insertion\n693:  * @returns {void}\n694:  */\n695: function insertWithEviction(cache, key, value, maxEntries) {\n696:   cache.set(key, value);\n697:   while (cache.size > maxEntries) {\n698:     const oldest = cache.keys().next().value;\n699:     cache.delete(oldest);\n700:   }\n701: }\n702: \n703: // The advisor CLI reads its request from stdin (`--json -`), so the prompt never\n704: // appears in argv, which any local user can read from the process table.\n705: function advisorCliArgs() {\n706:   return [ADVISOR_CLI_PATH, 'advisor_recommend', '--json', '-', '--format', 'json'];\n707: }\n708: \n709: // Build the stdin request, or null when the byte budget cannot hold even one prompt\n710: // character beside the request's fixed part. The prompt keeps at most\n711: // ADVISOR_PROMPT_MAX_CHARS characters and is clamped by its escaped size, because JSON\n712: // writes a quote or newline as two bytes and a control character as six.\n713: // The hub's own `.skilled` directory, resolved once. The plugin loads from `.opencode/plugins`,\n714: // one level below the repository root.\n715: let hubSkilledRoot;\n716: function resolveHubSkilledRoot() {\n717:   if (hubSkilledRoot === undefined) {\n718:     try {\n719:       hubSkilledRoot = realpathSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '.skilled'));\n720:     } catch {\n721:       hubSkilledRoot = null;\n722:     }\n723:   }\n724:   return hubSkilledRoot;\n725: }\n726: \n727: // The sk-code surfaces declared for detection, in the order detection tries them:\n728: // every specific surface first, the hub registry's in registry order and then those\n729: // of outside skills whose graph-metadata.json names the sk-code family, by skill_id,\n730: // and the hub's one fallback last. An outside block that claims the fallback role is\n731: // ignored, because the fallback is the hub's own code.\n732: const SK_CODE_HUB = 'sk-code';\n733: const EXTENSION_MARKER = /^\\.[a-z0-9]+$/i;\n734: \n735: function readJsonFile(file) {\n736:   try {\n737:     const value = JSON.parse(readFileSync(file, 'utf8'));\n738:     return value && typeof value === 'object' ? value : null;\n739:   } catch {\n740:     return null;\n741:   }\n742: }\n743: \n744: // A block with no marker of any kind declares no surface, as the hub reader drops it too, so the\n745: // two readers list the same surfaces. Only path and file markers are kept for matching here.\n746: function surfaceEntry(block) {\n747:   if (!block || typeof block !== 'object' || typeof block.label !== 'string' || !block.label.trim()) return null;\n748:   const markerList = (list) => (Array.isArray(list) ? list : [])\n749:     .filter((marker) => typeof marker === 'string' && marker.length > 0);\n750:   const markers = [block.pathMarkers, block.fileMarkers].flatMap(markerList);\n751:   if (markers.length === 0 && markerList(block.contentMarkers).length === 0) return null;\n752:   return { label: block.label.toUpperCase(), role: block.role, markers };\n753: }\n754: \n755: // The trusted-root rule for a private link lives in the advisor runtime as plain\n756: // CommonJS, so both skills-root readers apply one copy of it on every supported Node\n757: // version. When the module cannot load, the check rejects every link, which keeps an\n758: // unverified target out of detection, and one stderr line records the lost rule.\n759: let privateSkillTarget;\n760: function loadPrivateSkillTarget() {\n761:   if (privateSkillTarget === undefined) {\n762:     try {\n763:       const hubRoot = resolveHubSkilledRoot();\n764:       privateSkillTarget = hubRoot\n765:         ? pluginRequire(join(hubRoot, ADVISOR_ROOT_RELATIVE_PATH, 'lib', 'private-skill-target.cjs'))\n766:         : null;\n767:     } catch (error) {\n768:       privateSkillTarget = null;\n769:       process.stderr.write(`[${PLUGIN_ID}] private-skill trusted-root rule failed to load, so every local-* link is skipped: ${error.message}\\n`);\n770:     }\n771:   }\n772:   return privateSkillTarget;\n773: }\n774: \n775: function privateSkillLinkCheck(skillsDir) {\n776:   const lib = loadPrivateSkillTarget();\n777:   return lib && typeof lib.createPrivateSkillLinkCheck === 'function'\n778:     ? lib.createPrivateSkillLinkCheck(skillsDir)\n779:     : () => false;\n780: }\n781: \n782: function declaredSurfaces(hubRoot) {\n783:   const skillsDir = join(hubRoot, 'skills');\n784:   const registry = readJsonFile(join(skillsDir, SK_CODE_HUB, 'mode-registry.json'));\n785:   const hub = (registry && Array.isArray(registry.modes) ? registry.modes : [])\n786:     .map((mode) => surfaceEntry(mode && mode.surfaceDetection))\n787:     .filter(Boolean);\n788:   const outside = [];\n789:   let entries = [];\n790:   try {\n791:     entries = readdirSync(skillsDir, { withFileTypes: true });\n792:   } catch {\n793:     entries = [];\n794:   }\n795:   // A skill is a real directory, or a `local-*` link whose real target the advisor's\n796:   // trusted-root rule accepts. Any other link is skipped, as the replay library skips it.\n797:   let isTrustedLink = null;\n798:   for (const dirent of entries) {\n799:     const name = dirent.name;\n800:     if (!dirent.isDirectory()) {\n801:       if (!name.startsWith('local-') || !dirent.isSymbolicLink()) continue;\n802:       isTrustedLink = isTrustedLink || privateSkillLinkCheck(skillsDir);\n803:       if (!isTrustedLink(join(skillsDir, name))) continue;\n804:     }\n805:     const meta = readJsonFile(join(skillsDir, name, 'graph-metadata.json'));\n806:     if (!meta || meta.family !== SK_CODE_HUB || meta.skill_id === SK_CODE_HUB) continue;\n807:     const entry = surfaceEntry(meta.surface_detection);\n808:     if (entry && entry.role === 'specific') outside.push({ ...entry, skillId: String(meta.skill_id || name) });\n809:   }\n810:   outside.sort((a, b) => (a.skillId < b.skillId ? -1 : a.skillId > b.skillId ? 1 : 0));\n811:   return [\n812:     ...hub.filter((entry) => entry.role === 'specific'),\n813:     ...outside,\n814:     ...hub.filter((entry) => entry.role === 'fallback'),\n815:   ];\n816: }\n817: \n818: // A specific surface matches when the resolved workspace holds one of its path or\n819: // file markers, or sits inside a folder a path marker names. Extension and content\n820: // markers need the files a task touches, which a workspace check does not have.\n821: function workspaceHasMarker(real, entry) {\n822:   return entry.markers.some((marker) => {\n823:     if (EXTENSION_MARKER.test(marker)) return false;\n824:     const rel = marker.replace(/\\/+$/, '');\n825:     if (!rel) return false;\n826:     return existsSync(join(real, rel)) || `${real}${sep}`.includes(`${sep}${rel.split('/').join(sep)}${sep}`);\n827:   });\n828: }\n829: \n830: // The sk-code surface a session works in, read from its workspace. A specific\n831: // surface whose markers the workspace holds wins, so a surface another repository\n832: // adds always leads the hub's own. The fallback holds only when the resolved\n833: // workspace lies inside the hub's own .skilled directory, so a symlinked local\n834: // skill or a .skilled folder in another repository is never read as hub code. Any\n835: // other workspace sends no hint, so the compiled tie-break order applies. The\n836: // result is cached per workspace because the check runs before every uncached\n837: // advisor call.\n838: const workspaceSurfaceCache = new Map();\n839: function detectWorkspaceSurface(projectDir) {\n840:   if (typeof projectDir !== 'string' || projectDir.length === 0) return null;\n841:   if (workspaceSurfaceCache.has(projectDir)) return workspaceSurfaceCache.get(projectDir);\n842:   let surface = null;\n843:   try {\n844:     const real = realpathSync(projectDir);\n845:     const hubRoot = resolveHubSkilledRoot();\n846:     const insideHub = Boolean(hubRoot) && (real === hubRoot || real.startsWith(`${hubRoot}${sep}`));\n847:     const match = hubRoot\n848:       ? declaredSurfaces(hubRoot).find((entry) => (\n849:         entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n850:       ))\n851:       : null;\n852:     surface = match ? match.label : null;\n853:   } catch {\n854:     surface = null;\n855:   }\n856:   workspaceSurfaceCache.set(projectDir, surface);\n857:   return surface;\n858: }\n859: \n860: function advisorCliRequest({ prompt, options, surfaceHint = null }) {\n861:   const requestOptions = {\n862:     // Three recommendations keep the two-target ambiguity line available without\n863:     // asking the advisor for a longer list than the brief can use.\n864:     topK: 3,\n865:     includeAttribution: false,\n866:     includeAbstainReasons: true,\n867:     confidenceThreshold: options.thresholdConfidence,\n868:     uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n869:     ...(surfaceHint ? { surfaceHint } : {}),\n870:   };\n871:   const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n872:   let remaining = options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n873:   let end = 0;\n874:   for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n875:     remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n876:     if (remaining < 0) break;\n877:     end += char.length;\n878:   }\n879:   return end > 0 ? request(prompt.slice(0, end)) : null;\n880: }\n881: \n882: // ─────────────────────────────────────────────────────────────────────────────\n883: // 5. EVENT HELPERS\n884: // ─────────────────────────────────────────────────────────────────────────────\n885: \n886: function eventPayloadFrom(event) {\n887:   if (event?.payload && typeof event.payload === 'object') {\n888:     return event.payload;\n889:   }\n890:   return event;\n891: }\n892: \n893: function eventTypeFrom(event) {\n894:   const payload = eventPayloadFrom(event);\n895:   return typeof payload?.type === 'string' ? payload.type : null;\n896: }\n897: \n898: function lifecycleEventFrom(input, eventType = null) {\n899:   const candidates = [\n900:     input?.lifecycleEvent,\n901:     input?.lifecycle_event,\n902:     input?.lifecycleSource,\n903:     input?.lifecycle_source,\n904:     input?.source,\n905:     input?.properties?.source,\n906:   ];\n907:   for (const candidate of candidates) {\n908:     if (candidate === 'startup' || candidate === 'resume' || candidate === 'compact') {\n909:       return candidate;\n910:     }\n911:   }\n912:   if (eventType === 'session.created') return 'startup';\n913:   if (eventType === 'session.resumed') return 'resume';\n914:   if (eventType === 'session.compacted' || eventType === 'session.compact') return 'compact';\n915:   return undefined;\n916: }\n917: \n918: function rawSessionValueFrom(input) {\n919:   return input?.sessionID\n920:     ?? input?.sessionId\n921:     ?? input?.session?.id\n922:     ?? input?.properties?.sessionID\n923:     ?? input?.properties?.sessionId;\n924: }\n925: \n926: function shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed) {\n927:   const rawSession = rawSessionValueFrom(input);\n928:   const ambiguous = Boolean(\n929:     input?.sessionIdentityAmbiguous\n930:       || input?.session_identity_ambiguous\n931:       || (rawSession && typeof rawSession === 'object'),\n932:   );\n933:   const explicitConfirmation = input?.sessionIdentityConfirmed\n934:     ?? input?.session_identity_confirmed;\n935:   const sessionKnown = sessionID !== '__global__'\n936:     && !ambiguous\n937:     && explicitConfirmation !== false;\n938:   return {\n939:     sessionId: sessionKnown ? sessionID : undefined,\n940:     sessionIdentityConfirmed: sessionKnown,\n941:     sessionIdentityAmbiguous: ambiguous,\n942:     lifecycleEvent,\n943:     scopeChanged: input?.scopeChanged === true || input?.scope_changed === true,\n944:     policySetChanged: input?.policySetChanged === true || input?.policy_set_changed === true,\n945:     goalChanged: input?.goalChanged === true || input?.goal_changed === true,\n946:     deliveryConfirmed,\n947:   };\n948: }\n949: \n950: async function observeShadowDeliveryForRuntime(\n951:   rendered,\n952:   input,\n953:   sessionID,\n954:   lifecycleEvent,\n955:   deliveryConfirmed = false,\n956: ) {\n957:   try {\n958:     const renderer = await loadShadowRenderer();\n959:     if (typeof renderer?.observeShadowDelivery !== 'function') return;\n960:     renderer.observeShadowDelivery(\n961:       typeof rendered === 'string' ? rendered : null,\n962:       shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed),\n963:     );\n964:   } catch {\n965:     // Shadow planning must never alter the active OpenCode transform.\n966:   }\n967: }\n968: \n969: async function observeEmittedAdvisorBlock(\n970:   rendered,\n971:   input,\n972:   sessionID,\n973:   lifecycleEvent,\n974: ) {\n975:   try {\n976:     const renderer = await loadShadowRenderer();\n977:     if (typeof renderer?.observeEmittedAdvisorPolicy !== 'function') return;\n978:     renderer.observeEmittedAdvisorPolicy(\n979:       typeof rendered === 'string' ? rendered : null,\n980:       {\n981:         ...shadowDeliveryStateFor(input, sessionID, lifecycleEvent, true),\n982:         runtime: 'OpenCode',\n983:         candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n984:       },\n985:     );\n986:   } catch {\n987:     // Host observation must never alter the active OpenCode transform.\n988:   }\n989: }\n990: \n991: function transformContributionDecision(input, options, blockId, content, order) {\n992:   if (!options.deduplicateTransforms) {\n993:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n994:   }\n995:   const identity = messageIdentity.resolveMessageIdentity(input);\n996:   const contentHash = messageIdentity.hashPolicyBlockContent(blockId, content, order);\n997:   if (!identity || !contentHash) {\n998:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n999:   }\n1000:   const decision = messageIdentity.recordTransformContribution({\n1001:     identity,\n1002:     blockId,\n1003:     contentHash,\n1004:     transform: PLUGIN_ID,\n1005:   });\n1006:   return {\n1007:     ...decision,\n1008:     identity,\n1009:     blockId,\n1010:     contentHash,\n1011:   };\n1012: }\n1013: \n1014: function commitTransformContribution(decision) {\n1015:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1016:   if (decision.duplicate || decision.shouldDeliver) {\n1017:     messageIdentity.commitTransformDelivery(\n1018:       decision.identity,\n1019:       decision.blockId,\n1020:       decision.contentHash,\n1021:       { transform: PLUGIN_ID },\n1022:     );\n1023:     return;\n1024:   }\n1025:   messageIdentity.releaseTransformReservation(\n1026:     decision.identity,\n1027:     decision.blockId,\n1028:     decision.contentHash,\n1029:   );\n1030: }\n1031: \n1032: function releaseTransformContribution(decision) {\n1033:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1034:   messageIdentity.releaseTransformReservation(\n1035:     decision.identity,\n1036:     decision.blockId,\n1037:     decision.contentHash,\n1038:   );\n1039: }\n1040: \n1041: function deliverTransformContribution(decision, deliver) {\n1042:   if (!decision?.shouldDeliver) {\n1043:     commitTransformContribution(decision);\n1044:     return;\n1045:   }\n1046:   try {\n1047:     deliver();\n1048:     commitTransformContribution(decision);\n1049:   } catch (error) {\n1050:     releaseTransformContribution(decision);\n1051:     throw error;\n1052:   }\n1053: }\n1054: \n1055: // ─────────────────────────────────────────────────────────────────────────────\n1056: // 6. PLUGIN FACTORY\n1057: // ─────────────────────────────────────────────────────────────────────────────\n1058: \n1059: /**\n1060:  * Create the Spec Kit skill advisor OpenCode plugin hooks.\n1061:  *\n1062:  * @param {import('@opencode-ai/plugin').PluginInput} ctx - OpenCode plugin context\n1063:  * @param {Object} [rawOptions] - Plugin options\n1064:  * @param {boolean} [rawOptions.enabled] - Whether the plugin should inject advisor briefs\n1065:  * @param {number} [rawOptions.cacheTTLMs] - Advisor cache TTL in milliseconds\n1066:  * @param {number} [rawOptions.cacheTtlMs] - Advisor cache TTL alias in milliseconds\n1067:  * @param {number} [rawOptions.thresholdConfidence] - Minimum advisor confidence threshold\n1068:  * @param {number} [rawOptions.maxTokens] - Maximum advisor brief tokens requested from the advisor CLI\n1069:  * @param {string} [rawOptions.nodeBinaryOverride] - Node binary used for the advisor CLI subprocess\n1070:  * @param {number} [rawOptions.bridgeTimeoutMs] - Advisor CLI subprocess timeout in milliseconds\n1071:  * @param {number} [rawOptions.maxPromptBytes] - Maximum UTF-8 bytes of the stdin request sent to the advisor CLI, prompt included\n1072:  * @param {number} [rawOptions.maxBriefChars] - Maximum injected advisor brief characters\n1073:  * @param {number} [rawOptions.maxCacheEntries] - Maximum advisor cache entries\n1074:  * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Bound long compiled-route target lists\n1075:  * @param {boolean} [rawOptions.deduplicateTransforms] - Suppress duplicate same-message system blocks\n1076:  * @param {string} [rawOptions.sourceSignatureOverride] - Test override for advisor source signature\n1077:  * @returns {Promise<Object>} Hooks with `event`, `experimental.chat.system.transform`, and `tool`\n1078:  */\n1079: async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n1080:   const fileConfig = await configPromise;\n1081:   const merged = { ...fileConfig.values, ...rawOptions };\n1082:   const options = normalizeOptions(merged);\n1083:   const projectDir = normalizeWorkspaceRoot(ctx?.directory);\n1084: \n1085:   // Per-instance state so two plugin instances loaded in the same process maintain independent caches/metrics.\n1086:   const state = {\n1087:     advisorCache: new Map(),\n1088:     // In-flight promise dedup: concurrent identical-key requests share one advisor CLI spawn.\n1089:     inFlight: new Map(),\n1090:     // Live advisor CLI runs and the FIFO of callers waiting for a free slot.\n1091:     activeAdvisorRuns: 0,\n1092:     advisorRunWaiters: [],\n1093:     // Per-session record of the constant directive block last delivered in\n1094:     // full, keyed by normalized session id. Cleared on session lifecycle\n1095:     // boundaries (created/resumed/compacted/deleted) so the full block is\n1096:     // re-delivered on the first message after each boundary.\n1097:     directiveDedupBySession: new Map(),\n1098:     directiveEpochBySession: new Map(),\n1099:     directiveGeneration: 0,\n1100:     epoch: 0,\n1101:     runtimeReady: false,\n1102:     lastBridgeStatus: 'uninitialized',\n1103:     lastErrorCode: null,\n1104:     lastDurationMs: 0,\n1105:     bridgeInvocations: 0,\n1106:     cacheHits: 0,\n1107:     cacheMisses: 0,\n1108:     advisorLookups: 0,\n1109:     configStatus: fileConfig.status,\n1110:     configErrorCode: fileConfig.errorCode,\n1111:     disabledReason: !options.enabled\n1112:       ? (disabledEnvName() ?? 'config_enabled_false')\n1113:       : null,\n1114:   };\n1115: \n1116:   function acquireAdvisorRunSlot(sessionID, timeoutMs) {\n1117:     if (state.activeAdvisorRuns < MAX_CONCURRENT_ADVISOR_RUNS) {\n1118:       state.activeAdvisorRuns += 1;\n1119:       return Promise.resolve({ granted: true });\n1120:     }\n1121:     return new Promise((resolve) => {\n1122:       const waiter = {\n1123:         sessionID,\n1124:         // A wall-clock step can move a deadline backwards, so elapsed queue time\n1125:         // must come from a monotonic clock.\n1126:         deadline: performance.now() + timeoutMs,\n1127:         settled: false,\n1128:         timer: null,\n1129:         grant() {\n1130:           if (waiter.settled) {\n1131:             // The deadline already answered this caller, so the slot has to go\n1132:             // to the next waiter instead of disappearing with nobody holding it.\n1133:             releaseAdvisorRunSlot();\n1134:             return;\n1135:           }\n1136:           waiter.settled = true;\n1137:           clearTimeout(waiter.timer);\n1138:           resolve({ granted: true });\n1139:         },\n1140:         deny(error) {\n1141:           if (waiter.settled) {\n1142:             return;\n1143:           }\n1144:           waiter.settled = true;\n1145:           clearTimeout(waiter.timer);\n1146:           const index = state.advisorRunWaiters.indexOf(waiter);\n1147:           if (index !== -1) {\n1148:             state.advisorRunWaiters.splice(index, 1);\n1149:           }\n1150:           resolve({ granted: false, error });\n1151:         },\n1152:       };\n1153:       // Queue time counts against the same budget as the run, or a backlog makes\n1154:       // the host transform wait far past the bridge timeout it was promised.\n1155:       waiter.timer = setTimeout(() => waiter.deny('QUEUE_TIMEOUT'), timeoutMs);\n1156:       waiter.timer.unref?.();\n1157:       state.advisorRunWaiters.push(waiter);\n1158:     });\n1159:   }\n1160: \n1161:   function releaseAdvisorRunSlot() {\n1162:     while (state.advisorRunWaiters.length > 0) {\n1163:       const next = state.advisorRunWaiters.shift();\n1164:       if (next.deadline > performance.now()) {\n1165:         // Hand the slot to the oldest waiter still in time so the live count never dips.\n1166:         next.grant();\n1167:         return;\n1168:       }\n1169:       // A slot can free after a waiter's deadline but before its timer fires, and\n1170:       // granting then would run the overdue lookup with a fresh timeout.\n1171:       next.deny('QUEUE_TIMEOUT');\n1172:     }\n1173:     state.activeAdvisorRuns = Math.max(0, state.activeAdvisorRuns - 1);\n1174:   }\n1175: \n1176:   // A reset must release queued callers, or their host transforms never settle.\n1177:   function cancelAdvisorRunWaiters() {\n1178:     while (state.advisorRunWaiters.length > 0) {\n1179:       state.advisorRunWaiters.shift().deny('RUNTIME_RESET');\n1180:     }\n1181:   }\n1182: \n1183:   // Queued transforms for a deleted session fail open now instead of holding a\n1184:   // queue position until their deadline.\n1185:   function cancelAdvisorRunWaitersForSession(sessionID) {\n1186:     for (const waiter of [...state.advisorRunWaiters]) {\n1187:       if (waiter.sessionID === sessionID) {\n1188:         waiter.deny('SESSION_DELETED');\n1189:       }\n1190:     }\n1191:   }\n1192: \n1193:   /**\n1194:    * Run the advisor CLI and render its JSON response.\n1195:    * The CLI receives the request on stdin from `advisorCliRequest`, returns stdout\n1196:    * JSON parsed by `parseCliResponse`, gets SIGTERM shortly before the deadline,\n1197:    * and gets SIGKILL at the deadline if the process has not settled.\n1198:    *\n1199:    * @param {Object} params - CLI invocation parameters\n1200:    * @param {string} params.projectDir - Working directory for the advisor CLI subprocess\n1201:    * @param {string} params.prompt - Prompt passed to the advisor CLI\n1202:    * @param {string} params.sessionID - Session that owns the queued slot request\n1203:    * @param {Object} params.options - Normalized plugin options\n1204:    * @param {string} params.options.nodeBinary - Node binary used to spawn the advisor CLI\n1205:    * @param {number} params.options.bridgeTimeoutMs - Timeout before SIGTERM is sent, and the queue wait bound\n1206:    * @returns {Promise<Object>} Rendered response with `brief`, `status`, and `metadata`\n1207:    */\n1208:   async function runAdvisorCli({ projectDir, prompt, sessionID, options }) {\n1209:     const slot = await acquireAdvisorRunSlot(sessionID, options.bridgeTimeoutMs);\n1210:     if (!slot.granted) {\n1211:       // A reset already reported itself; only a queue-side denial still needs the\n1212:       // fail-open signal the other non-delivering paths leave in status.\n1213:       if (slot.error !== 'RUNTIME_RESET') {\n1214:         state.lastBridgeStatus = 'fail_open';\n[Output truncated. Continue reading with offset: 1215]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js, lines 1-1214\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: Skill Advisor OpenCode Plugin (system-skill-advisor)              ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Inject skill advisor brief into OpenCode model context per      ║\n5: // ║          prompt; expose status tool; manage per-instance state,          ║\n6: // ║          in-flight dedup, and bounded prompt/brief/cache sizes.           ║\n7: // ╚══════════════════════════════════════════════════════════════════════════╝\n8: 'use strict';\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: import { createHash } from 'node:crypto';\n15: import { spawn } from 'node:child_process';\n16: import { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'node:fs';\n17: import { resolve as resolvePath } from 'node:path';\n18: import { readFile } from 'node:fs/promises';\n19: import { homedir } from 'node:os';\n20: import { dirname, join, sep } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: import { createRequire } from 'node:module';\n23: \n24: import { tool } from './lib/tool-identity.js';\n25: import { dualPlugin } from './lib/v2-bridge.js';\n26: \n27: import * as messageIdentity from './lib/opencode-message-identity.js';\n28: import {\n29:   FALLBACK_DIRECTIVE,\n30:   SETUP_WORDING,\n31:   renderCompiledRouteSummaryLine,\n32:   renderPluginFallbackDirective,\n33: } from './lib/skill-advisor-render.js';\n34: import { findRepoRoot, findSourceRoot } from '../skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const PLUGIN_ID = 'system-skill-advisor';\n41: const DEFAULT_CACHE_TTL_MS = 5 * 60 * 1000;\n42: const DEFAULT_THRESHOLD_CONFIDENCE = 0.8;\n43: // Mirrors the compat contract's uncertainty ceiling. The CLI request and the\n44: // brief render must carry the same bound, or a recommendation can pass one and\n45: // fail the other.\n46: const DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\n47: const DEFAULT_MAX_TOKENS = 80;\n48: const AMBIGUOUS_TOKEN_CAP = 120;\n49: const DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\n50: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n51: const DEFAULT_NODE_BINARY = 'node';\n52: const DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n53: // advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n54: // rather than refused and reported as an outage.\n55: const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n56: const DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\n57: const DEFAULT_MAX_CACHE_ENTRIES = 1000;\n58: const MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n59: // Unique prompts each need their own advisor child, so a burst must not multiply\n60: // live processes without limit.\n61: const MAX_CONCURRENT_ADVISOR_RUNS = 2;\n62: const BRIDGE_TERMINATION_GRACE_MS = 250;\n63: const COMPILED_ROUTE_BOUNDING_ENV = 'SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING';\n64: const DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\n65: const DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\n66: const LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\n67: const LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n68: \n69: // Directive-lifecycle dedup: this plugin is a plain-JS mirror of the canonical\n70: // rule in hooks/lib/directive-lifecycle.ts (same separator, same fail-open\n71: // semantics). Deliver the full brief on the first message of a session and\n72: // after every lifecycle boundary; on a same-content repeat keep the dynamic\n73: // Advisor: route line and drop the constant directive block. The canonical\n74: // copy stays in directive-lifecycle.ts; when that module gains a compiled\n75: // dist, prefer importing it over extending this mirror.\n76: const DIRECTIVE_LIFECYCLE_DEDUP_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP';\n77: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n78: const MAX_DIRECTIVE_DEDUP_SESSIONS = 64;\n79: const pluginRequire = createRequire(import.meta.url);\n80: const { isHookEnabled } = pluginRequire('../hooks/shared/hook-flags.cjs');\n81: \n82: // The compiled-routing helper resolves from whichever adapter root actually\n83: // carries it: .opencode/bin is a link that a copied tree may lack, so a single\n84: // relative ../bin probe would spawn a broken module pair in a half-migrated tree.\n85: function resolveCompiledRouteStatusModule() {\n86:   const here = dirname(fileURLToPath(import.meta.url));\n87:   for (const candidate of [\n88:     join(here, '..', 'bin', 'compiled-route-status.cjs'),\n89:     join(here, '..', '..', '.skilled', 'bin', 'compiled-route-status.cjs'),\n90:   ]) {\n91:     if (existsSync(candidate)) return candidate;\n92:   }\n93:   return join(here, '..', 'bin', 'compiled-route-status.cjs');\n94: }\n95: \n96: // Compact, prompt-safe per-hub compiled-routing serving summary. Reads the\n97: // promoted runtime status (file-only, no engine load, no subprocess) and fails\n98: // closed to a single 'unavailable' line so the status tool never throws.\n99: function compiledRoutingStatusLines() {\n100:   try {\n101:     const statusPath = resolveCompiledRouteStatusModule();\n102:     const { computeAllStatus } = pluginRequire(statusPath);\n103:     const rows = computeAllStatus({ probeEngine: false });\n104:     const served = rows.filter((r) => r.servingAuthority === 'compiled').length;\n105:     const broken = rows.filter((r) => r.causeCode === 'engine-throw').length;\n106:     const lines = [\n107:       `compiled_routing_hubs=${rows.length}`,\n108:       `compiled_serving=${served}`,\n109:       `compiled_broken=${broken}`,\n110:     ];\n111:     for (const r of rows) lines.push(`compiled_hub_${r.hubId}=${r.servingAuthority}/${r.causeCode}`);\n112:     return lines;\n113:   } catch (err) {\n114:     return [`compiled_routing=unavailable(${err && err.message ? err.message : 'error'})`];\n115:   }\n116: }\n117: \n118: // Stable fingerprint of the current per-hub serving state, consumed from the\n119: // promoted status probe (the single source of serving truth). A manifest flip or\n120: // a kill-switch changes a hub's servingAuthority/causeCode/manifestFingerprint\n121: // here, so folding this into the advisor-brief cache key guarantees a miss and a\n122: // stale compiled brief is never re-served. Fails closed to a stable sentinel so\n123: // the degraded case still caches deterministically.\n124: function compiledServingSignature() {\n125:   try {\n126:     const statusPath = resolveCompiledRouteStatusModule();\n127:     const { computeAllStatus } = pluginRequire(statusPath);\n128:     const rows = computeAllStatus({ probeEngine: false });\n129:     const canonical = rows\n130:       .map((r) => `${r.hubId}:${r.servingAuthority}:${r.causeCode}:${r.manifestFingerprint ?? ''}:${r.effectivePolicyHash ?? ''}`)\n131:       .join('|');\n132:     return createHash('sha256').update(canonical).digest('hex');\n133:   } catch {\n134:     return 'serving-unavailable';\n135:   }\n136: }\n137: \n138: const ADVISOR_CLI_PATH = fileURLToPath(new URL('../bin/skill-advisor.cjs', import.meta.url));\n139: // Cache-signature paths follow the standalone advisor package to ensure\n140: // consistent cache invalidation across CLI and daemon builds. The CLI entry\n141: // belongs in the signature because it is the plugin's only advisor entrypoint.\n142: const ADVISOR_SOURCE_PATHS = [\n143:   ADVISOR_CLI_PATH,\n144:   fileURLToPath(new URL('../bin/system-skill-advisor-launcher.cjs', import.meta.url)),\n145:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/advisor-server.ts', import.meta.url)),\n146:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/dist/runtime/advisor-server.js', import.meta.url)),\n147: ];\n148: // Relative to the source root the workspace carries, which the signature selects.\n149: const SKILL_ROOT_RELATIVE_PATH = 'skills';\n150: const ADVISOR_ROOT_RELATIVE_PATH = join(SKILL_ROOT_RELATIVE_PATH, 'system-skill-advisor', 'runtime');\n151: const ADVISOR_JSON_RELATIVE_PATH = join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill-graph.json');\n152: const ADVISOR_SCRIPT_RELATIVE_PATHS = [\n153:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor.py'),\n154:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor_runtime.py'),\n155:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_graph_compiler.py'),\n156: ];\n157: const SHADOW_RENDERER_URL = new URL(\n158:   '../skills/system-skill-advisor/runtime/dist/runtime/lib/render.js',\n159:   import.meta.url,\n160: );\n161: let shadowRendererPromise;\n162: \n163: function loadShadowRenderer() {\n164:   shadowRendererPromise ??= import(SHADOW_RENDERER_URL).catch(() => null);\n165:   return shadowRendererPromise;\n166: }\n167: \n168: async function loadConfig() {\n169:   const path = join(homedir(), '.config', 'opencode', 'plugin', 'system-skill-advisor.json');\n170:   try {\n171:     const raw = await readFile(path, 'utf-8');\n172:     const parsed = JSON.parse(raw);\n173:     if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n174:       return { values: {}, status: 'error', errorCode: 'CONFIG_PARSE_ERROR' };\n175:     }\n176:     return { values: parsed, status: 'loaded', errorCode: null };\n177:   } catch (error) {\n178:     if (error?.code === 'ENOENT') {\n179:       return { values: {}, status: 'absent', errorCode: null };\n180:     }\n181:     return {\n182:       values: {},\n183:       status: 'error',\n184:       errorCode: error instanceof SyntaxError ? 'CONFIG_PARSE_ERROR' : 'CONFIG_READ_ERROR',\n185:     };\n186:   }\n187: }\n188: \n189: const configPromise = loadConfig();\n190: \n191: // ─────────────────────────────────────────────────────────────────────────────\n192: // 3. PURE UTILITIES\n193: // ─────────────────────────────────────────────────────────────────────────────\n194: \n195: function normalizePositiveInt(value, fallback) {\n196:   return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n197: }\n198: \n199: function normalizeThreshold(value) {\n200:   if (!Number.isFinite(value)) {\n201:     return DEFAULT_THRESHOLD_CONFIDENCE;\n202:   }\n203:   return Math.min(1, Math.max(0, Number(value)));\n204: }\n205: \n206: function envDisablesPlugin() {\n207:   return !isHookEnabled('skill-advisor');\n208: }\n209: \n210: function isDirectiveLifecycleDedupEnabled() {\n211:   const value = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV]?.trim().toLowerCase();\n212:   return value !== '0' && value !== 'false' && value !== 'off' && value !== 'no';\n213: }\n214: \n215: function splitDirectiveBrief(context) {\n216:   const index = context.indexOf(DIRECTIVE_SEPARATOR);\n217:   // index <= 0 means no directive block or no non-empty head before it.\n218:   if (index <= 0) return null;\n219:   return { head: context.slice(0, index), directives: context.slice(index) };\n220: }\n221: \n222: /** Reduce policy only for one primitive, non-conflicting session identity. */\n223: function decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n224:   if (!isDirectiveLifecycleDedupEnabled() || !identity.confirmed) {\n225:     return { suppressed: false, reduced: null };\n226:   }\n227:   const parts = splitDirectiveBrief(brief);\n228:   if (!parts?.head.trim()) return { suppressed: false, reduced: null };\n229: \n230:   const sessionID = identity.sessionID;\n231:   const generation = state.directiveGeneration;\n232:   const epoch = state.directiveEpochBySession.get(sessionID) ?? 0;\n233:   const boundary = lifecycleEvent === 'startup'\n234:     || lifecycleEvent === 'resume'\n235:     || lifecycleEvent === 'compact';\n236:   const last = state.directiveDedupBySession.get(sessionID);\n237:   if (boundary\n238:     || !last\n239:     || last.directives !== parts.directives\n240:     || last.generation !== generation\n241:     || last.epoch !== epoch) {\n242:     while (state.directiveDedupBySession.size >= MAX_DIRECTIVE_DEDUP_SESSIONS) {\n243:       const oldest = state.directiveDedupBySession.keys().next().value;\n244:       if (typeof oldest !== 'string') break;\n245:       state.directiveDedupBySession.delete(oldest);\n246:     }\n247:     state.directiveDedupBySession.set(sessionID, {\n248:       directives: parts.directives,\n249:       generation,\n250:       epoch,\n251:     });\n252:     return { suppressed: false, reduced: null };\n253:   }\n254:   return { suppressed: true, reduced: parts.head };\n255: }\n256: \n257: function disabledEnvName() {\n258:   if (process.env[DISABLED_ENV] === '1') {\n259:     return DISABLED_ENV;\n260:   }\n261:   if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n262:     return DISABLED_ENV_PLUGIN;\n263:   }\n264:   if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n265:     return LEGACY_HOOK_DISABLED_ENV;\n266:   }\n267:   if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n268:     return LEGACY_PLUGIN_DISABLED_ENV;\n269:   }\n270:   return null;\n271: }\n272: \n273: // The signature runs on every advisor lookup, so the digest of a file whose\n274: // identity is unchanged is reused instead of read and hashed again. A difference\n275: // in mtimeMs, ctimeMs, size or ino falls back to the read, and a stat or read\n276: // failure stays missing.\n277: const fileDigestCache = new Map();\n278: \n279: function fileDigest(sourcePath, stat) {\n280:   const cached = fileDigestCache.get(sourcePath);\n281:   if (cached\n282:     && cached.mtimeMs === stat.mtimeMs\n283:     && cached.ctimeMs === stat.ctimeMs\n284:     && cached.size === stat.size\n285:     && cached.ino === stat.ino) {\n286:     return cached.digest;\n287:   }\n288:   const digest = createHash('sha256').update(readFileSync(sourcePath)).digest('hex');\n289:   fileDigestCache.set(sourcePath, {\n290:     mtimeMs: stat.mtimeMs,\n291:     ctimeMs: stat.ctimeMs,\n292:     size: stat.size,\n293:     ino: stat.ino,\n294:     digest,\n295:   });\n296:   return digest;\n297: }\n298: \n299: function addFileSignature(hash, label, sourcePath) {\n300:   try {\n301:     const stat = statSync(sourcePath);\n302:     if (!stat.isFile()) {\n303:       throw new Error('not a file');\n304:     }\n305:     hash.update(label);\n306:     hash.update('\\u001f');\n307:     hash.update(sourcePath);\n308:     hash.update('\\u001f');\n309:     hash.update(String(stat.mtimeMs));\n310:     hash.update('\\u001f');\n311:     hash.update(String(stat.size));\n312:     hash.update('\\u001f');\n313:     hash.update(fileDigest(sourcePath, stat));\n314:     hash.update('\\u001e');\n315:   } catch {\n316:     hash.update(label);\n317:     hash.update('\\u001fmissing\\u001e');\n318:   }\n319: }\n320: \n321: function advisorSourceSignature(workspaceRoot) {\n322:   // Hashing the skills under a source-root name the workspace lacks records the same\n323:   // absent marker on every call, so cached advice would outlive any change to them. With\n324:   // no source root the signature is refused, and a refused signature is never cached.\n325:   // The workspace may be any directory inside the checkout, so the source root is found\n326:   // from the repository root above it.\n327:   const sourceRoot = findSourceRoot(findRepoRoot(workspaceRoot));\n328:   if (!sourceRoot) throw new Error(`no source root under ${workspaceRoot}`);\n329:   const hash = createHash('sha256');\n330:   for (const sourcePath of ADVISOR_SOURCE_PATHS) {\n331:     addFileSignature(hash, `implementation:${sourcePath}`, sourcePath);\n332:   }\n333: \n334:   const skillRoot = join(sourceRoot, SKILL_ROOT_RELATIVE_PATH);\n335:   try {\n336:     const skillSlugs = readdirSync(skillRoot, { withFileTypes: true })\n337:       .filter((entry) => entry.isDirectory() && !entry.name.startsWith('.'))\n338:       .map((entry) => entry.name)\n339:       .sort((left, right) => left.localeCompare(right));\n340:     for (const skillSlug of skillSlugs) {\n341:       const skillDir = join(skillRoot, skillSlug);\n342:       addFileSignature(hash, `skill:${skillSlug}:SKILL.md`, join(skillDir, 'SKILL.md'));\n343:       addFileSignature(hash, `skill:${skillSlug}:graph-metadata.json`, join(skillDir, 'graph-metadata.json'));\n344:       // ROUTER.md is optional, so a skill without one keeps the signature it had\n345:       // before this probe existed; only a skill that carries the file adds a part.\n346:       const routerMdPath = join(skillDir, 'ROUTER.md');\n347:       if (existsSync(routerMdPath)) {\n348:         addFileSignature(hash, `skill:${skillSlug}:ROUTER.md`, routerMdPath);\n349:       }\n350:     }\n351:   } catch {\n352:     hash.update(`${SKILL_ROOT_RELATIVE_PATH}\\u001fmissing\\u001e`);\n353:   }\n354: \n355:   for (const relativePath of ADVISOR_SCRIPT_RELATIVE_PATHS) {\n356:     addFileSignature(hash, relativePath, join(sourceRoot, relativePath));\n357:   }\n358:   const dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n359:     ?? join(sourceRoot, ADVISOR_ROOT_RELATIVE_PATH, 'database');\n360:   addFileSignature(hash, 'skill-graph.sqlite', join(dbDir, 'skill-graph.sqlite'));\n361:   addFileSignature(hash, ADVISOR_JSON_RELATIVE_PATH, join(sourceRoot, ADVISOR_JSON_RELATIVE_PATH));\n362:   return hash.digest('hex');\n363: }\n364: \n365: function normalizeOptions(rawOptions) {\n366:   const options = rawOptions && typeof rawOptions === 'object' ? rawOptions : {};\n367:   const configuredTtl = options.cacheTTLMs ?? options.cacheTtlMs;\n368:   const enabled = options.enabled !== false && !envDisablesPlugin();\n369:   const configuredTransformDedup = typeof options.deduplicateTransforms === 'boolean'\n370:     ? options.deduplicateTransforms\n371:     : undefined;\n372: \n373:   const envCacheTTLMs = Number(process.env.SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS);\n374:   const envThreshold = Number(process.env.SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE);\n375:   const envMaxTokens = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_TOKENS);\n376:   const envBridgeTimeoutMs = Number(process.env.SYSTEM_SKILL_ADVISOR_BRIDGE_TIMEOUT_MS);\n377:   const envMaxPromptBytes = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES);\n378:   const envMaxBriefChars = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_BRIEF_CHARS);\n379:   const envMaxCacheEntries = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_CACHE_ENTRIES);\n380:   const configuredBounding = typeof options.boundedCompiledRouteSummary === 'boolean'\n381:     ? options.boundedCompiledRouteSummary\n382:     : undefined;\n383: \n384:   return {\n385:     enabled,\n386:     cacheTTLMs: normalizePositiveInt(configuredTtl, normalizePositiveInt(envCacheTTLMs, DEFAULT_CACHE_TTL_MS)),\n387:     thresholdConfidence: normalizeThreshold(options.thresholdConfidence ?? (Number.isFinite(envThreshold) ? envThreshold : undefined)),\n388:     maxTokens: normalizePositiveInt(options.maxTokens, normalizePositiveInt(envMaxTokens, DEFAULT_MAX_TOKENS)),\n389:     nodeBinary: typeof options.nodeBinaryOverride === 'string' && options.nodeBinaryOverride.trim()\n390:       ? options.nodeBinaryOverride.trim()\n391:       : (process.env.SYSTEM_SKILL_ADVISOR_NODE_BINARY || process.env.SPEC_KIT_PLUGIN_NODE_BINARY || DEFAULT_NODE_BINARY),\n392:     bridgeTimeoutMs: normalizePositiveInt(options.bridgeTimeoutMs, normalizePositiveInt(envBridgeTimeoutMs, DEFAULT_BRIDGE_TIMEOUT_MS)),\n393:     maxPromptBytes: normalizePositiveInt(options.maxPromptBytes, normalizePositiveInt(envMaxPromptBytes, DEFAULT_MAX_PROMPT_BYTES)),\n394:     maxBriefChars: normalizePositiveInt(options.maxBriefChars, normalizePositiveInt(envMaxBriefChars, DEFAULT_MAX_BRIEF_CHARS)),\n395:     maxCacheEntries: normalizePositiveInt(options.maxCacheEntries, normalizePositiveInt(envMaxCacheEntries, DEFAULT_MAX_CACHE_ENTRIES)),\n396:     boundedCompiledRouteSummary: configuredBounding ?? process.env[COMPILED_ROUTE_BOUNDING_ENV] === '1',\n397:     deduplicateTransforms: configuredTransformDedup\n398:       ?? process.env[messageIdentity.OPENCODE_TRANSFORM_DEDUP_ENV] === '1',\n399:     sourceSignatureOverride: typeof options.sourceSignatureOverride === 'string'\n400:       ? options.sourceSignatureOverride\n401:       : null,\n402:     sourceSignatureProvider: typeof options.sourceSignatureProvider === 'function'\n403:       ? options.sourceSignatureProvider\n404:       : advisorSourceSignature,\n405:     spawnAdvisor: typeof options.spawnOverride === 'function' ? options.spawnOverride : spawn,\n406:   };\n407: }\n408: \n409: function sessionIdFrom(input) {\n410:   if (!input || typeof input !== 'object') {\n411:     return '__global__';\n412:   }\n413:   return normalizeSessionID(input.sessionID\n414:     || input.sessionId\n415:     || input.session?.id\n416:     || input.properties?.sessionID\n417:     || input.properties?.info?.sessionID\n418:     || input.properties?.info?.id\n419:     || '__global__');\n420: }\n421: \n422: function directiveSessionIdentityFrom(input) {\n423:   if (!input || typeof input !== 'object') {\n424:     return { sessionID: '__global__', confirmed: false };\n425:   }\n426:   const candidates = [\n427:     input.sessionID,\n428:     input.sessionId,\n429:     input.session?.id,\n430:     input.properties?.sessionID,\n431:     input.properties?.sessionId,\n432:     input.properties?.info?.sessionID,\n433:     input.properties?.info?.id,\n434:   ].filter((value) => value !== undefined && value !== null && value !== '');\n435:   const primitive = candidates.filter((value) => typeof value === 'string' || typeof value === 'number');\n436:   const normalized = [...new Set(primitive.map((value) => String(value).trim()).filter(Boolean))];\n437:   const ambiguous = candidates.some((value) => typeof value === 'object')\n438:     || input.sessionIdentityAmbiguous === true\n439:     || input.session_identity_ambiguous === true;\n440:   const conflicting = normalized.length !== 1 || primitive.length !== candidates.length;\n441:   const explicitlyRejected = input.sessionIdentityConfirmed === false\n442:     || input.session_identity_confirmed === false;\n443:   return {\n444:     sessionID: normalized.length === 1 ? normalized[0] : '__global__',\n445:     confirmed: normalized[0] !== '__global__'\n446:       && !ambiguous\n447:       && !conflicting\n448:       && !explicitlyRejected,\n449:   };\n450: }\n451: \n452: function advanceOpenCodeDirectiveBoundary(state, input) {\n453:   const identity = directiveSessionIdentityFrom(input);\n454:   if (identity.confirmed) {\n455:     const epoch = state.directiveEpochBySession.get(identity.sessionID) ?? 0;\n456:     state.directiveEpochBySession.set(identity.sessionID, epoch + 1);\n457:     state.directiveDedupBySession.delete(identity.sessionID);\n458:   } else {\n459:     state.directiveGeneration += 1;\n460:     state.directiveDedupBySession.clear();\n461:     state.directiveEpochBySession.clear();\n462:   }\n463:   return identity;\n464: }\n465: \n466: function stableStringify(value) {\n467:   if (!value || typeof value !== 'object') {\n468:     return JSON.stringify(String(value));\n469:   }\n470: \n471:   if (Array.isArray(value)) {\n472:     return `[${value.map((entry) => stableStringify(entry)).join(',')}]`;\n473:   }\n474: \n475:   return `{${Object.keys(value)\n476:     .sort()\n477:     .map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`)\n478:     .join(',')}}`;\n479: }\n480: \n481: function normalizeSessionID(value) {\n482:   if (value === null || value === undefined || value === '') {\n483:     return '__global__';\n484:   }\n485:   if (typeof value === 'object') {\n486:     return stableStringify(value);\n487:   }\n488:   return String(value);\n489: }\n490: \n491: function normalizeWorkspaceRoot(workspaceRoot) {\n492:   if (typeof workspaceRoot === 'string' && workspaceRoot.trim()) {\n493:     return resolvePath(workspaceRoot.trim());\n494:   }\n495:   return resolvePath(process.cwd());\n496: }\n497: \n498: function statusSafeBinary(binary) {\n499:   if (typeof binary === 'string' && (binary.includes('/') || binary.includes('\\\\'))) {\n500:     return '[configured-node]';\n501:   }\n502:   return binary;\n503: }\n504: \n505: function cacheKeyForPrompt(prompt, options, sessionID, sourceSignature, workspaceRoot, servingSignature) {\n506:   const sessionKey = normalizeSessionID(sessionID);\n507:   const promptKey = createHash('sha256')\n508:     .update(prompt)\n509:     .update('\\u001f')\n510:     .update(String(options.thresholdConfidence))\n511:     .update('\\u001f')\n512:     .update(String(options.maxTokens))\n513:     .update('\\u001f')\n514:     .update(sourceSignature)\n515:     .update('\\u001f')\n516:     .update(workspaceRoot)\n517:     .update('\u001f')\n518:     .update(String(servingSignature ?? ''))\n519:     .digest('hex');\n520:   return `${String(sessionKey)}::${promptKey}`;\n521: }\n522: \n523: function extractPrompt(input) {\n524:   if (typeof input === 'string') {\n525:     return input;\n526:   }\n527:   if (!input || typeof input !== 'object') {\n528:     return null;\n529:   }\n530: \n531:   const candidates = [\n532:     input.prompt,\n533:     input.text,\n534:     input.userPrompt,\n535:     input.message,\n536:     input.input,\n537:     input.properties?.prompt,\n538:     input.properties?.message,\n539:     input.request?.prompt,\n540:     input.request?.message,\n541:   ];\n542: \n543:   for (const candidate of candidates) {\n544:     if (typeof candidate === 'string' && candidate.trim()) {\n545:       return candidate;\n546:     }\n547:     if (candidate && typeof candidate === 'object') {\n548:       const content = candidate.content ?? candidate.text;\n549:       if (typeof content === 'string' && content.trim()) {\n550:         return content;\n551:       }\n552:     }\n553:   }\n554: \n555:   return null;\n556: }\n557: \n558: function cliRecommendations(data, options) {\n559:   if (!Array.isArray(data?.recommendations)) {\n560:     return [];\n561:   }\n562:   return data.recommendations\n563:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n564:     .map((recommendation) => {\n565:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n566:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n567:       return {\n568:         skill: recommendation.skillId,\n569:         confidence,\n570:         uncertainty,\n571:         // The CLI's public recommendations carry no verdict field, so the caller\n572:         // decides it from the same thresholds the renderer enforces.\n573:         passes_threshold: confidence >= options.thresholdConfidence\n574:           && uncertainty <= DEFAULT_THRESHOLD_UNCERTAINTY,\n575:         ...(Array.isArray(recommendation.ambiguousWith)\n576:           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n577:           : {}),\n578:       };\n579:     });\n580: }\n581: \n582: // Compact the served compiled decision the advisor attached to a recommendation.\n583: // Returns null when no recommendation carried a route, which keeps the injected\n584: // context byte-identical to the legacy brief.\n585: function compiledRouteSummary(data) {\n586:   if (!Array.isArray(data?.recommendations)) return null;\n587:   for (const recommendation of data.recommendations) {\n588:     const route = recommendation?.compiledRoute;\n589:     if (!route || typeof route !== 'object' || typeof route.action !== 'string') continue;\n590:     return {\n591:       outcome: route.action,\n592:       hubId: typeof route.hubId === 'string' ? route.hubId : null,\n593:       targets: Array.isArray(route.targets) ? route.targets.filter((target) => typeof target === 'string') : [],\n594:       servingAuthority: 'compiled',\n595:     };\n596:   }\n597:   return null;\n598: }\n599: \n600: /**\n601:  * Parse the advisor CLI's stdout and render its brief.\n602:  *\n603:  * @param {string} stdout - Raw CLI stdout text\n604:  * @param {Object} options - Normalized plugin options\n605:  * @returns {Promise<Object>} Response with `brief`, `status`, and `metadata`\n606:  */\n607: async function parseCliResponse(stdout, options) {\n608:   if (!stdout.trim()) {\n609:     return { brief: null, status: 'fail_open', error: 'EMPTY_STDOUT', metadata: {} };\n610:   }\n611: \n612:   let parsed;\n613:   try {\n614:     parsed = JSON.parse(stdout.trim());\n615:   } catch {\n616:     return { brief: null, status: 'fail_open', error: 'PARSE_FAIL', metadata: {} };\n617:   }\n618: \n619:   const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : null;\n620:   if (parsed?.status !== 'ok' || !data) {\n621:     return { brief: null, status: 'fail_open', error: 'UNEXPECTED_PAYLOAD', metadata: {} };\n622:   }\n623: \n624:   const recommendations = cliRecommendations(data, options);\n625:   const top = recommendations[0] ?? null;\n626:   // The CLI reports no freshness when it answered from the local scorer instead\n627:   // of the daemon; 'stale' keeps that brief renderable and honest.\n628:   const freshness = data.freshness === 'live' || data.freshness === 'stale'\n629:     ? data.freshness\n630:     : (parsed.degraded === true ? 'stale' : 'unavailable');\n631:   const tokenCap = data.ambiguous === true ? AMBIGUOUS_TOKEN_CAP : options.maxTokens;\n632:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n633:   const renderBrief = typeof renderer?.renderAdvisorBrief === 'function' ? renderer.renderAdvisorBrief : null;\n634:   const rendered = renderBrief\n635:     ? renderBrief({\n636:       status: 'ok',\n637:       freshness,\n638:       recommendations,\n639:       ambiguous: data.ambiguous === true,\n640:       metrics: { tokenCap },\n641:       sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n642:     }, {\n643:       tokenCap,\n644:       thresholdConfig: {\n645:         confidenceThreshold: options.thresholdConfidence,\n646:         uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n647:       },\n648:     })\n649:     : null;\n650:   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n651:   const routeSummary = compiledRouteSummary(data);\n652: \n653:   return {\n654:     brief,\n655:     status: brief ? 'ok' : 'skipped',\n656:     metadata: {\n657:       route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n658:       freshness,\n659:       recommendationCount: recommendations.length,\n660:       tokenCap,\n661:       skillLabel: top?.skill ?? null,\n662:       cacheHit: Boolean(data.cache?.hit),\n663:       ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n664:     },\n665:   };\n666: }\n667: \n668: // ─────────────────────────────────────────────────────────────────────────────\n669: // 4. SIZE-CAP HELPERS\n670: // ─────────────────────────────────────────────────────────────────────────────\n671: \n672: /**\n673:  * Clamp advisor brief text by JavaScript character count.\n674:  *\n675:  * @param {string} brief - Advisor brief text to clamp\n676:  * @param {number} maxChars - Maximum character count to retain\n677:  * @returns {string} Original brief or truncated prefix within the limit\n678:  */\n679: function clampBrief(brief, maxChars) {\n680:   if (typeof brief !== 'string' || brief.length <= maxChars) {\n681:     return brief;\n682:   }\n683:   return brief.slice(0, maxChars);\n684: }\n685: \n686: /**\n687:  * Insert a cache value and evict oldest entries by insertion order.\n688:  *\n689:  * @param {Map<string, Object>} cache - Cache map using insertion order as LRU state\n690:  * @param {string} key - Cache key to insert or refresh\n691:  * @param {Object} value - Cache value to store\n692:  * @param {number} maxEntries - Maximum entries retained after insertion\n693:  * @returns {void}\n694:  */\n695: function insertWithEviction(cache, key, value, maxEntries) {\n696:   cache.set(key, value);\n697:   while (cache.size > maxEntries) {\n698:     const oldest = cache.keys().next().value;\n699:     cache.delete(oldest);\n700:   }\n701: }\n702: \n703: // The advisor CLI reads its request from stdin (`--json -`), so the prompt never\n704: // appears in argv, which any local user can read from the process table.\n705: function advisorCliArgs() {\n706:   return [ADVISOR_CLI_PATH, 'advisor_recommend', '--json', '-', '--format', 'json'];\n707: }\n708: \n709: // Build the stdin request, or null when the byte budget cannot hold even one prompt\n710: // character beside the request's fixed part. The prompt keeps at most\n711: // ADVISOR_PROMPT_MAX_CHARS characters and is clamped by its escaped size, because JSON\n712: // writes a quote or newline as two bytes and a control character as six.\n713: // The hub's own `.skilled` directory, resolved once. The plugin loads from `.opencode/plugins`,\n714: // one level below the repository root.\n715: let hubSkilledRoot;\n716: function resolveHubSkilledRoot() {\n717:   if (hubSkilledRoot === undefined) {\n718:     try {\n719:       hubSkilledRoot = realpathSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '.skilled'));\n720:     } catch {\n721:       hubSkilledRoot = null;\n722:     }\n723:   }\n724:   return hubSkilledRoot;\n725: }\n726: \n727: // The sk-code surfaces declared for detection, in the order detection tries them:\n728: // every specific surface first, the hub registry's in registry order and then those\n729: // of outside skills whose graph-metadata.json names the sk-code family, by skill_id,\n730: // and the hub's one fallback last. An outside block that claims the fallback role is\n731: // ignored, because the fallback is the hub's own code.\n732: const SK_CODE_HUB = 'sk-code';\n733: const EXTENSION_MARKER = /^\\.[a-z0-9]+$/i;\n734: \n735: function readJsonFile(file) {\n736:   try {\n737:     const value = JSON.parse(readFileSync(file, 'utf8'));\n738:     return value && typeof value === 'object' ? value : null;\n739:   } catch {\n740:     return null;\n741:   }\n742: }\n743: \n744: // A block with no marker of any kind declares no surface, as the hub reader drops it too, so the\n745: // two readers list the same surfaces. Only path and file markers are kept for matching here.\n746: function surfaceEntry(block) {\n747:   if (!block || typeof block !== 'object' || typeof block.label !== 'string' || !block.label.trim()) return null;\n748:   const markerList = (list) => (Array.isArray(list) ? list : [])\n749:     .filter((marker) => typeof marker === 'string' && marker.length > 0);\n750:   const markers = [block.pathMarkers, block.fileMarkers].flatMap(markerList);\n751:   if (markers.length === 0 && markerList(block.contentMarkers).length === 0) return null;\n752:   return { label: block.label.toUpperCase(), role: block.role, markers };\n753: }\n754: \n755: // The trusted-root rule for a private link lives in the advisor runtime as plain\n756: // CommonJS, so both skills-root readers apply one copy of it on every supported Node\n757: // version. When the module cannot load, the check rejects every link, which keeps an\n758: // unverified target out of detection, and one stderr line records the lost rule.\n759: let privateSkillTarget;\n760: function loadPrivateSkillTarget() {\n761:   if (privateSkillTarget === undefined) {\n762:     try {\n763:       const hubRoot = resolveHubSkilledRoot();\n764:       privateSkillTarget = hubRoot\n765:         ? pluginRequire(join(hubRoot, ADVISOR_ROOT_RELATIVE_PATH, 'lib', 'private-skill-target.cjs'))\n766:         : null;\n767:     } catch (error) {\n768:       privateSkillTarget = null;\n769:       process.stderr.write(`[${PLUGIN_ID}] private-skill trusted-root rule failed to load, so every local-* link is skipped: ${error.message}\\n`);\n770:     }\n771:   }\n772:   return privateSkillTarget;\n773: }\n774: \n775: function privateSkillLinkCheck(skillsDir) {\n776:   const lib = loadPrivateSkillTarget();\n777:   return lib && typeof lib.createPrivateSkillLinkCheck === 'function'\n778:     ? lib.createPrivateSkillLinkCheck(skillsDir)\n779:     : () => false;\n780: }\n781: \n782: function declaredSurfaces(hubRoot) {\n783:   const skillsDir = join(hubRoot, 'skills');\n784:   const registry = readJsonFile(join(skillsDir, SK_CODE_HUB, 'mode-registry.json'));\n785:   const hub = (registry && Array.isArray(registry.modes) ? registry.modes : [])\n786:     .map((mode) => surfaceEntry(mode && mode.surfaceDetection))\n787:     .filter(Boolean);\n788:   const outside = [];\n789:   let entries = [];\n790:   try {\n791:     entries = readdirSync(skillsDir, { withFileTypes: true });\n792:   } catch {\n793:     entries = [];\n794:   }\n795:   // A skill is a real directory, or a `local-*` link whose real target the advisor's\n796:   // trusted-root rule accepts. Any other link is skipped, as the replay library skips it.\n797:   let isTrustedLink = null;\n798:   for (const dirent of entries) {\n799:     const name = dirent.name;\n800:     if (!dirent.isDirectory()) {\n801:       if (!name.startsWith('local-') || !dirent.isSymbolicLink()) continue;\n802:       isTrustedLink = isTrustedLink || privateSkillLinkCheck(skillsDir);\n803:       if (!isTrustedLink(join(skillsDir, name))) continue;\n804:     }\n805:     const meta = readJsonFile(join(skillsDir, name, 'graph-metadata.json'));\n806:     if (!meta || meta.family !== SK_CODE_HUB || meta.skill_id === SK_CODE_HUB) continue;\n807:     const entry = surfaceEntry(meta.surface_detection);\n808:     if (entry && entry.role === 'specific') outside.push({ ...entry, skillId: String(meta.skill_id || name) });\n809:   }\n810:   outside.sort((a, b) => (a.skillId < b.skillId ? -1 : a.skillId > b.skillId ? 1 : 0));\n811:   return [\n812:     ...hub.filter((entry) => entry.role === 'specific'),\n813:     ...outside,\n814:     ...hub.filter((entry) => entry.role === 'fallback'),\n815:   ];\n816: }\n817: \n818: // A specific surface matches when the resolved workspace holds one of its path or\n819: // file markers, or sits inside a folder a path marker names. Extension and content\n820: // markers need the files a task touches, which a workspace check does not have.\n821: function workspaceHasMarker(real, entry) {\n822:   return entry.markers.some((marker) => {\n823:     if (EXTENSION_MARKER.test(marker)) return false;\n824:     const rel = marker.replace(/\\/+$/, '');\n825:     if (!rel) return false;\n826:     return existsSync(join(real, rel)) || `${real}${sep}`.includes(`${sep}${rel.split('/').join(sep)}${sep}`);\n827:   });\n828: }\n829: \n830: // The sk-code surface a session works in, read from its workspace. A specific\n831: // surface whose markers the workspace holds wins, so a surface another repository\n832: // adds always leads the hub's own. The fallback holds only when the resolved\n833: // workspace lies inside the hub's own .skilled directory, so a symlinked local\n834: // skill or a .skilled folder in another repository is never read as hub code. Any\n835: // other workspace sends no hint, so the compiled tie-break order applies. The\n836: // result is cached per workspace because the check runs before every uncached\n837: // advisor call.\n838: const workspaceSurfaceCache = new Map();\n839: function detectWorkspaceSurface(projectDir) {\n840:   if (typeof projectDir !== 'string' || projectDir.length === 0) return null;\n841:   if (workspaceSurfaceCache.has(projectDir)) return workspaceSurfaceCache.get(projectDir);\n842:   let surface = null;\n843:   try {\n844:     const real = realpathSync(projectDir);\n845:     const hubRoot = resolveHubSkilledRoot();\n846:     const insideHub = Boolean(hubRoot) && (real === hubRoot || real.startsWith(`${hubRoot}${sep}`));\n847:     const match = hubRoot\n848:       ? declaredSurfaces(hubRoot).find((entry) => (\n849:         entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n850:       ))\n851:       : null;\n852:     surface = match ? match.label : null;\n853:   } catch {\n854:     surface = null;\n855:   }\n856:   workspaceSurfaceCache.set(projectDir, surface);\n857:   return surface;\n858: }\n859: \n860: function advisorCliRequest({ prompt, options, surfaceHint = null }) {\n861:   const requestOptions = {\n862:     // Three recommendations keep the two-target ambiguity line available without\n863:     // asking the advisor for a longer list than the brief can use.\n864:     topK: 3,\n865:     includeAttribution: false,\n866:     includeAbstainReasons: true,\n867:     confidenceThreshold: options.thresholdConfidence,\n868:     uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n869:     ...(surfaceHint ? { surfaceHint } : {}),\n870:   };\n871:   const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n872:   let remaining = options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n873:   let end = 0;\n874:   for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n875:     remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n876:     if (remaining < 0) break;\n877:     end += char.length;\n878:   }\n879:   return end > 0 ? request(prompt.slice(0, end)) : null;\n880: }\n881: \n882: // ─────────────────────────────────────────────────────────────────────────────\n883: // 5. EVENT HELPERS\n884: // ─────────────────────────────────────────────────────────────────────────────\n885: \n886: function eventPayloadFrom(event) {\n887:   if (event?.payload && typeof event.payload === 'object') {\n888:     return event.payload;\n889:   }\n890:   return event;\n891: }\n892: \n893: function eventTypeFrom(event) {\n894:   const payload = eventPayloadFrom(event);\n895:   return typeof payload?.type === 'string' ? payload.type : null;\n896: }\n897: \n898: function lifecycleEventFrom(input, eventType = null) {\n899:   const candidates = [\n900:     input?.lifecycleEvent,\n901:     input?.lifecycle_event,\n902:     input?.lifecycleSource,\n903:     input?.lifecycle_source,\n904:     input?.source,\n905:     input?.properties?.source,\n906:   ];\n907:   for (const candidate of candidates) {\n908:     if (candidate === 'startup' || candidate === 'resume' || candidate === 'compact') {\n909:       return candidate;\n910:     }\n911:   }\n912:   if (eventType === 'session.created') return 'startup';\n913:   if (eventType === 'session.resumed') return 'resume';\n914:   if (eventType === 'session.compacted' || eventType === 'session.compact') return 'compact';\n915:   return undefined;\n916: }\n917: \n918: function rawSessionValueFrom(input) {\n919:   return input?.sessionID\n920:     ?? input?.sessionId\n921:     ?? input?.session?.id\n922:     ?? input?.properties?.sessionID\n923:     ?? input?.properties?.sessionId;\n924: }\n925: \n926: function shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed) {\n927:   const rawSession = rawSessionValueFrom(input);\n928:   const ambiguous = Boolean(\n929:     input?.sessionIdentityAmbiguous\n930:       || input?.session_identity_ambiguous\n931:       || (rawSession && typeof rawSession === 'object'),\n932:   );\n933:   const explicitConfirmation = input?.sessionIdentityConfirmed\n934:     ?? input?.session_identity_confirmed;\n935:   const sessionKnown = sessionID !== '__global__'\n936:     && !ambiguous\n937:     && explicitConfirmation !== false;\n938:   return {\n939:     sessionId: sessionKnown ? sessionID : undefined,\n940:     sessionIdentityConfirmed: sessionKnown,\n941:     sessionIdentityAmbiguous: ambiguous,\n942:     lifecycleEvent,\n943:     scopeChanged: input?.scopeChanged === true || input?.scope_changed === true,\n944:     policySetChanged: input?.policySetChanged === true || input?.policy_set_changed === true,\n945:     goalChanged: input?.goalChanged === true || input?.goal_changed === true,\n946:     deliveryConfirmed,\n947:   };\n948: }\n949: \n950: async function observeShadowDeliveryForRuntime(\n951:   rendered,\n952:   input,\n953:   sessionID,\n954:   lifecycleEvent,\n955:   deliveryConfirmed = false,\n956: ) {\n957:   try {\n958:     const renderer = await loadShadowRenderer();\n959:     if (typeof renderer?.observeShadowDelivery !== 'function') return;\n960:     renderer.observeShadowDelivery(\n961:       typeof rendered === 'string' ? rendered : null,\n962:       shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed),\n963:     );\n964:   } catch {\n965:     // Shadow planning must never alter the active OpenCode transform.\n966:   }\n967: }\n968: \n969: async function observeEmittedAdvisorBlock(\n970:   rendered,\n971:   input,\n972:   sessionID,\n973:   lifecycleEvent,\n974: ) {\n975:   try {\n976:     const renderer = await loadShadowRenderer();\n977:     if (typeof renderer?.observeEmittedAdvisorPolicy !== 'function') return;\n978:     renderer.observeEmittedAdvisorPolicy(\n979:       typeof rendered === 'string' ? rendered : null,\n980:       {\n981:         ...shadowDeliveryStateFor(input, sessionID, lifecycleEvent, true),\n982:         runtime: 'OpenCode',\n983:         candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n984:       },\n985:     );\n986:   } catch {\n987:     // Host observation must never alter the active OpenCode transform.\n988:   }\n989: }\n990: \n991: function transformContributionDecision(input, options, blockId, content, order) {\n992:   if (!options.deduplicateTransforms) {\n993:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n994:   }\n995:   const identity = messageIdentity.resolveMessageIdentity(input);\n996:   const contentHash = messageIdentity.hashPolicyBlockContent(blockId, content, order);\n997:   if (!identity || !contentHash) {\n998:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n999:   }\n1000:   const decision = messageIdentity.recordTransformContribution({\n1001:     identity,\n1002:     blockId,\n1003:     contentHash,\n1004:     transform: PLUGIN_ID,\n1005:   });\n1006:   return {\n1007:     ...decision,\n1008:     identity,\n1009:     blockId,\n1010:     contentHash,\n1011:   };\n1012: }\n1013: \n1014: function commitTransformContribution(decision) {\n1015:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1016:   if (decision.duplicate || decision.shouldDeliver) {\n1017:     messageIdentity.commitTransformDelivery(\n1018:       decision.identity,\n1019:       decision.blockId,\n1020:       decision.contentHash,\n1021:       { transform: PLUGIN_ID },\n1022:     );\n1023:     return;\n1024:   }\n1025:   messageIdentity.releaseTransformReservation(\n1026:     decision.identity,\n1027:     decision.blockId,\n1028:     decision.contentHash,\n1029:   );\n1030: }\n1031: \n1032: function releaseTransformContribution(decision) {\n1033:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1034:   messageIdentity.releaseTransformReservation(\n1035:     decision.identity,\n1036:     decision.blockId,\n1037:     decision.contentHash,\n1038:   );\n1039: }\n1040: \n1041: function deliverTransformContribution(decision, deliver) {\n1042:   if (!decision?.shouldDeliver) {\n1043:     commitTransformContribution(decision);\n1044:     return;\n1045:   }\n1046:   try {\n1047:     deliver();\n1048:     commitTransformContribution(decision);\n1049:   } catch (error) {\n1050:     releaseTransformContribution(decision);\n1051:     throw error;\n1052:   }\n1053: }\n1054: \n1055: // ─────────────────────────────────────────────────────────────────────────────\n1056: // 6. PLUGIN FACTORY\n1057: // ─────────────────────────────────────────────────────────────────────────────\n1058: \n1059: /**\n1060:  * Create the Spec Kit skill advisor OpenCode plugin hooks.\n1061:  *\n1062:  * @param {import('@opencode-ai/plugin').PluginInput} ctx - OpenCode plugin context\n1063:  * @param {Object} [rawOptions] - Plugin options\n1064:  * @param {boolean} [rawOptions.enabled] - Whether the plugin should inject advisor briefs\n1065:  * @param {number} [rawOptions.cacheTTLMs] - Advisor cache TTL in milliseconds\n1066:  * @param {number} [rawOptions.cacheTtlMs] - Advisor cache TTL alias in milliseconds\n1067:  * @param {number} [rawOptions.thresholdConfidence] - Minimum advisor confidence threshold\n1068:  * @param {number} [rawOptions.maxTokens] - Maximum advisor brief tokens requested from the advisor CLI\n1069:  * @param {string} [rawOptions.nodeBinaryOverride] - Node binary used for the advisor CLI subprocess\n1070:  * @param {number} [rawOptions.bridgeTimeoutMs] - Advisor CLI subprocess timeout in milliseconds\n1071:  * @param {number} [rawOptions.maxPromptBytes] - Maximum UTF-8 bytes of the stdin request sent to the advisor CLI, prompt included\n1072:  * @param {number} [rawOptions.maxBriefChars] - Maximum injected advisor brief characters\n1073:  * @param {number} [rawOptions.maxCacheEntries] - Maximum advisor cache entries\n1074:  * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Bound long compiled-route target lists\n1075:  * @param {boolean} [rawOptions.deduplicateTransforms] - Suppress duplicate same-message system blocks\n1076:  * @param {string} [rawOptions.sourceSignatureOverride] - Test override for advisor source signature\n1077:  * @returns {Promise<Object>} Hooks with `event`, `experimental.chat.system.transform`, and `tool`\n1078:  */\n1079: async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n1080:   const fileConfig = await configPromise;\n1081:   const merged = { ...fileConfig.values, ...rawOptions };\n1082:   const options = normalizeOptions(merged);\n1083:   const projectDir = normalizeWorkspaceRoot(ctx?.directory);\n1084: \n1085:   // Per-instance state so two plugin instances loaded in the same process maintain independent caches/metrics.\n1086:   const state = {\n1087:     advisorCache: new Map(),\n1088:     // In-flight promise dedup: concurrent identical-key requests share one advisor CLI spawn.\n1089:     inFlight: new Map(),\n1090:     // Live advisor CLI runs and the FIFO of callers waiting for a free slot.\n1091:     activeAdvisorRuns: 0,\n1092:     advisorRunWaiters: [],\n1093:     // Per-session record of the constant directive block last delivered in\n1094:     // full, keyed by normalized session id. Cleared on session lifecycle\n1095:     // boundaries (created/resumed/compacted/deleted) so the full block is\n1096:     // re-delivered on the first message after each boundary.\n1097:     directiveDedupBySession: new Map(),\n1098:     directiveEpochBySession: new Map(),\n1099:     directiveGeneration: 0,\n1100:     epoch: 0,\n1101:     runtimeReady: false,\n1102:     lastBridgeStatus: 'uninitialized',\n1103:     lastErrorCode: null,\n1104:     lastDurationMs: 0,\n1105:     bridgeInvocations: 0,\n1106:     cacheHits: 0,\n1107:     cacheMisses: 0,\n1108:     advisorLookups: 0,\n1109:     configStatus: fileConfig.status,\n1110:     configErrorCode: fileConfig.errorCode,\n1111:     disabledReason: !options.enabled\n1112:       ? (disabledEnvName() ?? 'config_enabled_false')\n1113:       : null,\n1114:   };\n1115: \n1116:   function acquireAdvisorRunSlot(sessionID, timeoutMs) {\n1117:     if (state.activeAdvisorRuns < MAX_CONCURRENT_ADVISOR_RUNS) {\n1118:       state.activeAdvisorRuns += 1;\n1119:       return Promise.resolve({ granted: true });\n1120:     }\n1121:     return new Promise((resolve) => {\n1122:       const waiter = {\n1123:         sessionID,\n1124:         // A wall-clock step can move a deadline backwards, so elapsed queue time\n1125:         // must come from a monotonic clock.\n1126:         deadline: performance.now() + timeoutMs,\n1127:         settled: false,\n1128:         timer: null,\n1129:         grant() {\n1130:           if (waiter.settled) {\n1131:             // The deadline already answered this caller, so the slot has to go\n1132:             // to the next waiter instead of disappearing with nobody holding it.\n1133:             releaseAdvisorRunSlot();\n1134:             return;\n1135:           }\n1136:           waiter.settled = true;\n1137:           clearTimeout(waiter.timer);\n1138:           resolve({ granted: true });\n1139:         },\n1140:         deny(error) {\n1141:           if (waiter.settled) {\n1142:             return;\n1143:           }\n1144:           waiter.settled = true;\n1145:           clearTimeout(waiter.timer);\n1146:           const index = state.advisorRunWaiters.indexOf(waiter);\n1147:           if (index !== -1) {\n1148:             state.advisorRunWaiters.splice(index, 1);\n1149:           }\n1150:           resolve({ granted: false, error });\n1151:         },\n1152:       };\n1153:       // Queue time counts against the same budget as the run, or a backlog makes\n1154:       // the host transform wait far past the bridge timeout it was promised.\n1155:       waiter.timer = setTimeout(() => waiter.deny('QUEUE_TIMEOUT'), timeoutMs);\n1156:       waiter.timer.unref?.();\n1157:       state.advisorRunWaiters.push(waiter);\n1158:     });\n1159:   }\n1160: \n1161:   function releaseAdvisorRunSlot() {\n1162:     while (state.advisorRunWaiters.length > 0) {\n1163:       const next = state.advisorRunWaiters.shift();\n1164:       if (next.deadline > performance.now()) {\n1165:         // Hand the slot to the oldest waiter still in time so the live count never dips.\n1166:         next.grant();\n1167:         return;\n1168:       }\n1169:       // A slot can free after a waiter's deadline but before its timer fires, and\n1170:       // granting then would run the overdue lookup with a fresh timeout.\n1171:       next.deny('QUEUE_TIMEOUT');\n1172:     }\n1173:     state.activeAdvisorRuns = Math.max(0, state.activeAdvisorRuns - 1);\n1174:   }\n1175: \n1176:   // A reset must release queued callers, or their host transforms never settle.\n1177:   function cancelAdvisorRunWaiters() {\n1178:     while (state.advisorRunWaiters.length > 0) {\n1179:       state.advisorRunWaiters.shift().deny('RUNTIME_RESET');\n1180:     }\n1181:   }\n1182: \n1183:   // Queued transforms for a deleted session fail open now instead of holding a\n1184:   // queue position until their deadline.\n1185:   function cancelAdvisorRunWaitersForSession(sessionID) {\n1186:     for (const waiter of [...state.advisorRunWaiters]) {\n1187:       if (waiter.sessionID === sessionID) {\n1188:         waiter.deny('SESSION_DELETED');\n1189:       }\n1190:     }\n1191:   }\n1192: \n1193:   /**\n1194:    * Run the advisor CLI and render its JSON response.\n1195:    * The CLI receives the request on stdin from `advisorCliRequest`, returns stdout\n1196:    * JSON parsed by `parseCliResponse`, gets SIGTERM shortly before the deadline,\n1197:    * and gets SIGKILL at the deadline if the process has not settled.\n1198:    *\n1199:    * @param {Object} params - CLI invocation parameters\n1200:    * @param {string} params.projectDir - Working directory for the advisor CLI subprocess\n1201:    * @param {string} params.prompt - Prompt passed to the advisor CLI\n1202:    * @param {string} params.sessionID - Session that owns the queued slot request\n1203:    * @param {Object} params.options - Normalized plugin options\n1204:    * @param {string} params.options.nodeBinary - Node binary used to spawn the advisor CLI\n1205:    * @param {number} params.options.bridgeTimeoutMs - Timeout before SIGTERM is sent, and the queue wait bound\n1206:    * @returns {Promise<Object>} Rendered response with `brief`, `status`, and `metadata`\n1207:    */\n1208:   async function runAdvisorCli({ projectDir, prompt, sessionID, options }) {\n1209:     const slot = await acquireAdvisorRunSlot(sessionID, options.bridgeTimeoutMs);\n1210:     if (!slot.granted) {\n1211:       // A reset already reported itself; only a queue-side denial still needs the\n1212:       // fail-open signal the other non-delivering paths leave in status.\n1213:       if (slot.error !== 'RUNTIME_RESET') {\n1214:         state.lastBridgeStatus = 'fail_open';\n[Output truncated. Continue reading with offset: 1215]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js\"}"},"time":{"start":1794546522114,"end":1794546522593}}}}
