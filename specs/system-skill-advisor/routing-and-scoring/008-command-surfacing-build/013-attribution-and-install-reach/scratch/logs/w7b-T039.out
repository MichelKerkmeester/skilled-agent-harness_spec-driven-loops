{"type":"tool_use","timestamp":1794546700238,"sessionID":"ses_e2cb172abffelzYZkz2FqDnqf9","part":{"partID":"prt_1d3518e59001qXds7f79uyckpp","sessionID":"ses_e2cb172abffelzYZkz2FqDnqf9","messageID":"msg_1d3517d92001ITeYek2FbfzYmA","type":"tool","id":"call_00_fi2fyuu1yma639i95ezb0ysa","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .opencode/plugins/system-skill-advisor.js .skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.opencode/plugins/system-skill-advisor.js b/.opencode/plugins/system-skill-advisor.js\nindex f245aae8a7..6a6dcbb8a0 100644\n--- a/.opencode/plugins/system-skill-advisor.js\n+++ b/.opencode/plugins/system-skill-advisor.js\n@@ -575,6 +575,13 @@ function cliRecommendations(data, options) {\n         ...(Array.isArray(recommendation.ambiguousWith)\n           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n           : {}),\n+        // The renderer prints a command, its policy and its owner only from these\n+        // fields. A skill row such as sk-doc has no generated command row to refill\n+        // them, so a dropped field hides the command the advisor attached.\n+        ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n+        ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n+        ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n+        ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n       };\n     });\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\nindex 3be04f3ed2..e1e94eaaf0 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\n@@ -260,6 +260,26 @@ describe('system-skill-advisor OpenCode plugin', () => {\n     expect(result.output.system[0]).toContain('sk-code');\n   });\n \n+  it.each([\n+    {\n+      name: 'a skill row keeps the command and policy the advisor attached',\n+      recommendation: { skillId: 'sk-doc', kind: 'skill', command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc', confidence: 0.95, uncertainty: 0.12 },\n+      expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n+    },\n+    {\n+      name: 'a hub row keeps the flag that says it needs a mode',\n+      recommendation: { skillId: 'system-deep-loop', confidence: 0.82, uncertainty: 0.2, needsMode: true },\n+      expectedHead: 'Advisor: live; use system-deep-loop (needs a mode) 0.82/0.20 pass.',\n+    },\n+  ])('$name', async ({ recommendation, expectedHead }) => {\n+    mockBridgeSuccess(cliResponse([recommendation]));\n+    const hooks = await makePlugin();\n+\n+    const result = await runPrompt(hooks, { prompt: `route ${recommendation.skillId} for the utils folder` });\n+\n+    expect(result.additionalContext?.split('\\n')[0]).toBe(expectedHead);\n+  });\n+\n   it('pushes the standalone hygiene context when advisor returns an empty brief', async () => {\n     mockBridgeSuccess(cliResponse([]));\n     const hooks = await makePlugin();\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.opencode/plugins/system-skill-advisor.js b/.opencode/plugins/system-skill-advisor.js\nindex f245aae8a7..6a6dcbb8a0 100644\n--- a/.opencode/plugins/system-skill-advisor.js\n+++ b/.opencode/plugins/system-skill-advisor.js\n@@ -575,6 +575,13 @@ function cliRecommendations(data, options) {\n         ...(Array.isArray(recommendation.ambiguousWith)\n           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n           : {}),\n+        // The renderer prints a command, its policy and its owner only from these\n+        // fields. A skill row such as sk-doc has no generated command row to refill\n+        // them, so a dropped field hides the command the advisor attached.\n+        ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n+        ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n+        ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n+        ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n       };\n     });\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\nindex 3be04f3ed2..e1e94eaaf0 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\n@@ -260,6 +260,26 @@ describe('system-skill-advisor OpenCode plugin', () => {\n     expect(result.output.system[0]).toContain('sk-code');\n   });\n \n+  it.each([\n+    {\n+      name: 'a skill row keeps the command and policy the advisor attached',\n+      recommendation: { skillId: 'sk-doc', kind: 'skill', command: '/create:readme', policy: 'start', ownerSkillId: 'sk-doc', confidence: 0.95, uncertainty: 0.12 },\n+      expectedHead: 'Advisor: live; use sk-doc → /create:readme (start) 0.95/0.12 pass.',\n+    },\n+    {\n+      name: 'a hub row keeps the flag that says it needs a mode',\n+      recommendation: { skillId: 'system-deep-loop', confidence: 0.82, uncertainty: 0.2, needsMode: true },\n+      expectedHead: 'Advisor: live; use system-deep-loop (needs a mode) 0.82/0.20 pass.',\n+    },\n+  ])('$name', async ({ recommendation, expectedHead }) => {\n+    mockBridgeSuccess(cliResponse([recommendation]));\n+    const hooks = await makePlugin();\n+\n+    const result = await runPrompt(hooks, { prompt: `route ${recommendation.skillId} for the utils folder` });\n+\n+    expect(result.additionalContext?.split('\\n')[0]).toBe(expectedHead);\n+  });\n+\n   it('pushes the standalone hygiene context when advisor returns an empty brief', async () => {\n     mockBridgeSuccess(cliResponse([]));\n     const hooks = await makePlugin();\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -c core.fsmonitor=false diff -- .opencode/plugins/system-skill-advisor.js .skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794546699865,"end":1794546700238}}}}
