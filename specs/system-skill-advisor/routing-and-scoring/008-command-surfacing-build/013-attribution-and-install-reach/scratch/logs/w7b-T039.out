: }\n160: \n161: function statusMetric(status: string | undefined, key: string) {\n162:   const match = status?.match(new RegExp(`^${key}=(\\\\d+(?:\\\\.\\\\d+)?)$`, 'm'));\n163:   if (!match) {\n164:     throw new Error(`Missing status metric: ${key}`);\n165:   }\n166:   return Number(match[1]);\n167: }\n168: \n169: function cliPromptAt(index: number): string {\n170:   const child = mockedBridge.spawn.mock.results[index]?.value as { stdin?: { end?: ReturnType<typeof vi.fn> } } | undefined;\n171:   const request = child?.stdin?.end?.mock.calls[0]?.[0];\n172:   if (typeof request !== 'string') return '';\n173:   const parsed = JSON.parse(request) as { prompt?: unknown };\n174:   return typeof parsed.prompt === 'string' ? parsed.prompt : '';\n175: }\n176: \n177: describe('system-skill-advisor OpenCode plugin', () => {\n178:   beforeEach(async () => {\n179:     vi.useRealTimers();\n180:     vi.clearAllMocks();\n181:     delete process.env.SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED;\n182:     delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n183:     delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n184:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n185:     const resetHooks = await MkSkillAdvisorPlugin({ directory: process.cwd() }, {});\n186:     await resetHooks.event?.({\n187:       event: {\n188:         type: 'server.instance.disposed',\n189:         properties: { directory: process.cwd() },\n190:       } as never,\n191:     });\n192:     mockBridgeSuccess();\n193:   });\n194: \n195:   afterEach(async () => {\n196:     vi.useRealTimers();\n197:     const resetHooks = await MkSkillAdvisorPlugin({ directory: process.cwd() }, {});\n198:     await resetHooks.event?.({\n199:       event: {\n200:         type: 'server.instance.disposed',\n201:         properties: { directory: process.cwd() },\n202:       } as never,\n203:     });\n204:     for (const [key, value] of ORIGINAL_ENV) {\n205:       if (value === undefined) delete process.env[key];\n206:       else process.env[key] = value;\n207:     }\n208:   });\n209: \n210:   it('returns the canonical OpenCode hook surface and keeps status tool registration', async () => {\n211:     const hooks = await makePlugin();\n212: \n213:     for (const key of CANONICAL_OPENCODE_PLUGIN_SURFACE) {\n214:       expect(hooks).toHaveProperty(key);\n215:     }\n216:     for (const key of LEGACY_OPENCODE_LIFECYCLE_KEYS) {\n217:       expect(hooks).not.toHaveProperty(key);\n218:     }\n219:     expect(hooks.tool?.spec_kit_skill_advisor_status).toBeDefined();\n220:   });\n221: \n222:   it.each(FALLBACK_PARITY_CASES)(\n223:     'matches the canonical fallback for $status status and $freshness freshness',\n224:     (result) => {\n225:       expect(renderPluginFallbackDirective).toBeTypeOf('function');\n226:       expect(renderPluginFallbackDirective?.(result)).toBe(\n227:         renderAdvisorFallbackDirective({}, result),\n228:       );\n229:     },\n230:   );\n231: \n232:   it.each(FALLBACK_PARITY_CASES)(\n233:     'matches the canonical setup-wording fallback for $status status and $freshness freshness',\n234:     (result) => {\n235:       expect(renderPluginFallbackDirective?.(result, { setupWording: true })).toBe(\n236:         renderAdvisorFallbackDirective({ setupWording: true }, result),\n237:       );\n238:     },\n239:   );\n240: \n241:   it('keeps the setup-wording regex equal to the Claude hook check', () => {\n242:     const pluginSetupWording = (\n243:       skillAdvisorRender as unknown as { SETUP_WORDING?: RegExp }\n244:     ).SETUP_WORDING;\n245:     expect(pluginSetupWording?.source).toBe(HOOK_SETUP_WORDING.source);\n246:     expect(pluginSetupWording?.flags).toBe(HOOK_SETUP_WORDING.flags);\n247:   });\n248: \n249:   it('matches the canonical fail-open fallback when no result is available', () => {\n250:     expect(renderPluginFallbackDirective).toBeTypeOf('function');\n251:     expect(renderPluginFallbackDirective?.()).toBe(renderAdvisorFallbackDirective());\n252:   });\n2