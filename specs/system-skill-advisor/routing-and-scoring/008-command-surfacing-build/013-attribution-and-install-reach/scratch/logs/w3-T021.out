{"type":"tool_use","timestamp":1794546502819,"sessionID":"ses_e2cb1fb21ffe0SRrGmqNzgsjny","part":{"partID":"prt_1d34e8c5f001iCOH7xiruDRsjN","sessionID":"ses_e2cb1fb21ffe0SRrGmqNzgsjny","messageID":"msg_1d34e571b001BHoz7T3skGaWg0","type":"tool","id":"chatcmpl-tool-a8ed91cba527c9a8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-406\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: import { fileURLToPath } from 'node:url';\n29: \n30: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n31: \n32: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n33: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n34: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n35: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n36: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n37: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n38: const DEFAULT_TIMEOUT_MS = 30_000;\n39: const MAX_OUTPUT_BYTES = 1024 * 1024;\n40: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../../..');\n41: const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n42: \n43: function failedOffer(offerError) {\n44:   return { offeredCommand: null, offeredPolicy: null, offerError };\n45: }\n46: \n47: /**\n48:  * Read the command and the policy out of the first line of a head.\n49:  *\n50:  * The policy only counts when it directly follows the command, so a `(ask)`\n51:  * that belongs to a later clause cannot attach itself to an earlier match.\n52:  *\n53:  * @param {string} head - One line of advisor output.\n54:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n55:  */\n56: export function parseOffer(head) {\n57:   const text = typeof head === 'string' ? head : '';\n58:   const match = text.match(OFFER_PATTERN);\n59:   if (!match) {\n60:     return { offeredCommand: null, offeredPolicy: null };\n61:   }\n62:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n63:   return {\n64:     offeredCommand: match[0],\n65:     offeredPolicy: policy ? policy[1] : null,\n66:   };\n67: }\n68: \n69: /**\n70:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n71:  *\n72:  * The hook is resolved from the checkout rather than from this module, so a\n73:  * backfill records what that checkout's advisor would have offered at the time\n74:  * of the run, not what the current working copy happens to say.\n75:  *\n76:  * @param {object} options\n77:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n78:  * @param {string} options.prompt - The prompt to replay.\n79:  * @param {string} options.sessionId - Session id for the hook payload.\n80:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n81:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n82:  */\n83: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n84:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n85:   if (!existsSync(hookPath)) {\n86:     return failedOffer('hook_missing');\n87:   }\n88: \n89:   const payload = {\n90:     prompt,\n91:     cwd: checkoutDir,\n92:     hook_event_name: 'UserPromptSubmit',\n93:     session_id: sessionId,\n94:   };\n95: \n96:   let result;\n97:   try {\n98:     result = spawnSync('node', [hookPath], {\n99:       cwd: checkoutDir,\n100:       input: JSON.stringify(payload),\n101:       encoding: 'utf8',\n102:       timeout: timeoutMs,\n103:       maxBuffer: MAX_OUTPUT_BYTES,\n104:     });\n105:   } catch {\n106:     return failedOffer('hook_failed');\n107:   }\n108: \n109:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n110:     return failedOffer('hook_failed');\n111:   }\n112: \n113:   let output;\n114:   try {\n115:     output = JSON.parse(result.stdout);\n116:   } catch {\n117:     return failedOffer('hook_failed');\n118:   }\n119: \n120:   const context = output?.hookSpecificOutput?.additionalContext;\n121:   if (typeof context !== 'string') {\n122:     return failedOffer('no_head');\n123:   }\n124: \n125:   const [firstLine = ''] = context.split(/\\r?\\n/);\n126:   if (!firstLine.trim()) {\n127:     return failedOffer('no_head');\n128:   }\n129: \n130:   return { ...parseOffer(firstLine), offerError: null };\n131: }\n132: \n133: function contentHasBrief(content) {\n134:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n135:   if (!Array.isArray(content)) return false;\n136:   return content.some((part) => {\n137:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n138:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n139:   });\n140: }\n141: \n142: // Neutral records keep their text in content blocks, and the block shape differs\n143: // by runtime, so the serialized record is the one place the brief is found\n144: // whichever block carries it.\n145: function recordsHaveBrief(records) {\n146:   return (Array.isArray(records) ? records : []).some((record) =>\n147:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n148: }\n149: \n150: // Injected context sits beside the records rather than inside them, so a reader\n151: // that reports it gives the brief a second place to be found.\n152: function injectedHasBrief(injected) {\n153:   return (Array.isArray(injected) ? injected : []).some(\n154:     (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n155:   );\n156: }\n157: \n158: /**\n159:  * Ask the project's Codex approval check whether its advisor hook can run.\n160:  *\n161:  * Codex skips an unapproved project hook without a warning, so a wired hook can\n162:  * still deliver nothing. The check reports the approval recorded in the config\n163:  * file it reads, and this wrapper turns that verdict into the answer the\n164:  * delivery decision needs.\n165:  *\n166:  * @param {object} [options]\n167:  * @param {string} [options.projectDir] - Project root whose hooks file is read.\n168:  * @param {string} [options.configPath] - Codex config file, defaulting to the\n169:  *   environment's Codex home.\n170:  * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n171:  */\n172: export function codexHookApproval({ projectDir, configPath } = {}) {\n173:   if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n174: \n175:   const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n176:   if (configPath) args.push('--config', configPath);\n177:   const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n178:   if (result.error || typeof result.stdout !== 'string') return 'unknown';\n179: \n180:   let verdict;\n181:   try {\n182:     verdict = JSON.parse(result.stdout);\n183:   } catch {\n184:     return 'unknown';\n185:   }\n186: \n187:   switch (verdict?.code) {\n188:     case 'codex-hooks-approved':\n189:       return 'approved';\n190:     case 'codex-hooks-unapproved':\n191:       return 'unapproved';\n192:     case 'codex-advisor-hook-absent':\n193:       return 'absent';\n194:     case 'no-codex-hooks':\n195:       return 'no-hooks';\n196:     default:\n197:       return 'unknown';\n198:   }\n199: }\n200: \n201: /**\n202:  * Decide whether the advisor brief reached the session that ran the turn.\n203:  *\n204:  * A Claude transcript records the hook context as its own attachment line, so a\n205:  * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n206:  * session store, either as a record or as injected context beside it, and Codex\n207:  * answers from its approval plus whatever its store holds. OpenCode stays\n208:  * `unknown`, because its plugin adds the brief in memory and the store keeps no\n209:  * copy.\n210:  *\n211:  * @param {object} options\n212:  * @param {string} options.runtime - The measured runtime.\n213:  * @param {object|null} [options.locator] - The locator the run line recorded.\n214:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n215:  *   lives in session records rather than a transcript file.\n216:  * @param {string} [options.codexConfig] - Codex config file the approval is\n217:  *   read from, defaulting to the environment's Codex home.\n218:  * @returns {Promise<boolean | 'unknown'>}\n219:  */\n220: export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n221:   if (runtime === 'claude') {\n222:     const transcriptPath = locator?.transcriptPath;\n223:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n224:       return 'unknown';\n225:     }\n226: \n227:     let raw;\n228:     try {\n229:       raw = readFileSync(transcriptPath, 'utf8');\n230:     } catch {\n231:       return 'unknown';\n232:     }\n233: \n234:     for (const line of raw.split('\\n')) {\n235:       if (!line.trim()) continue;\n236:       let entry;\n237:       try {\n238:         entry = JSON.parse(line);\n239:       } catch {\n240:         continue;\n241:       }\n242:       if (entry?.type !== 'attachment') continue;\n243:       const attachment = entry.attachment;\n244:       if (attachment?.type !== 'hook_additional_context') continue;\n245:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n246:       if (contentHasBrief(attachment.content)) return true;\n247:     }\n248:     return false;\n249:   }\n250: \n251:   if (runtime === 'pi' || runtime === 'devin' || runtime === 'dsh') {\n252:     if (typeof loadSession !== 'function') return 'unknown';\n253:     let loaded;\n254:     try {\n255:       loaded = await loadSession({ ...locator, runtime });\n256:     } catch {\n257:       return 'unknown';\n258:     }\n259:     if (!loaded?.ok) return 'unknown';\n260:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected);\n261:   }\n262: \n263:   if (runtime === 'codex') {\n264:     // An unapproved project hook never runs, so the brief cannot have arrived.\n265:     // An approved one may store its context where no reader looks yet.\n266:     if (codexHookApproval({ projectDir: locator?.projectDir, configPath: codexConfig }) === 'unapproved') {\n267:       return false;\n268:     }\n269: \n270:     if (typeof loadSession !== 'function') return 'unknown';\n271:     let loaded;\n272:     try {\n273:       loaded = await loadSession({ ...locator, runtime });\n274:     } catch {\n275:       return 'unknown';\n276:     }\n277:     if (!loaded?.ok) return 'unknown';\n278:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected)\n279:       ? true\n280:       : 'unknown';\n281:   }\n282: \n283:   return 'unknown';\n284: }\n285: \n286: // ───────────────────────────────────────────────────────────────\n287: // Run-log backfill\n288: // ───────────────────────────────────────────────────────────────\n289: \n290: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n291: // each checkout to start one before it replays. The status call writes nothing,\n292: // and its failure is ignored because a replay that finds no daemon records its\n293: // own error instead of losing the line.\n294: function warmCheckout(checkoutDir) {\n295:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n296:   if (!existsSync(cliPath)) return;\n297:   spawnSync(\n298:     'node',\n299:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n300:     {\n301:       cwd: checkoutDir,\n302:       encoding: 'utf8',\n303:       timeout: DEFAULT_TIMEOUT_MS,\n304:       maxBuffer: MAX_OUTPUT_BYTES,\n305:     },\n306:   );\n307: }\n308: \n309: function refused(code, detail) {\n310:   return { ok: false, code, detail };\n311: }\n312: \n313: /**\n314:  * Add the offer, its policy and the brief to every line of a run log.\n315:  *\n316:  * The prompts are resolved before the first line is written, so a row the\n317:  * corpus refuses leaves no output file behind. A line whose locator names no\n318:  * checkout keeps null offer fields and its own error code, and the rest of the\n319:  * log is still written.\n320:  *\n321:  * @param {object} options\n322:  * @param {string} options.inPath - Run log to read.\n323:  * @param {string} options.outPath - New run log to write.\n324:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n325:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n326:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n327:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n328:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n329:  *   injectable for tests.\n330:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n331:  *   | { ok: false, code: string, detail: string }>}\n332:  */\n333: export async function backfillRunLog({\n334:   inPath,\n335:   outPath,\n336:   promptFor,\n337:   replay = replayOffer,\n338:   brief = briefDelivered,\n339:   warm = warmCheckout,\n340: }) {\n341:   if (resolve(outPath) === resolve(inPath)) {\n342:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n343:   }\n344: \n345:   const rows = [];\n346:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n347:     if (raw.trim() === '') continue;\n348:     rows.push(JSON.parse(raw));\n349:   }\n350: \n351:   const prompts = [];\n352:   for (const row of rows) {\n353:     try {\n354:       prompts.push(promptFor(row.rowId));\n355:     } catch (error) {\n356:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n357:     }\n358:   }\n359: \n360:   const warmed = new Set();\n361:   const output = [];\n362:   for (let index = 0; index < rows.length; index += 1) {\n363:     const line = rows[index];\n364:     const rowId = line.rowId;\n365:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n366:       ? line.locator\n367:       : null;\n368:     const projectDir = locator?.projectDir;\n369:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n370: \n371:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n372:     if (checkoutDir !== null) {\n373:       if (!warmed.has(checkoutDir)) {\n374:         warmed.add(checkoutDir);\n375:         try {\n376:           await warm(checkoutDir);\n377:         } catch {\n378:           // A failed warm-up still lets the replay report its own miss.\n379:         }\n380:       }\n381:       offer = await replay({\n382:         checkoutDir,\n383:         prompt: prompts[index],\n384:         sessionId: `backfill-${rowId}`,\n385:       });\n386:     }\n387: \n388:     // Pi keeps its brief in a session store rather than a transcript, so the\n389:     // shared reader travels with every call. A runtime that has no reader for\n390:     // its store ignores it and answers `unknown`.\n391:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n392: \n393:     output.push({\n394:       ...line,\n395:       offeredCommand: offer.offeredCommand ?? null,\n396:       offeredPolicy: offer.offeredPolicy ?? null,\n397:       offerError: offer.offerError ?? null,\n398:       briefDelivered: delivered,\n399:       offerBackfilled: true,\n400:     });\n401:   }\n402: \n403:   mkdirSync(dirname(outPath), { recursive: true });\n404:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n405:   return { ok: true, lines: output.length, outPath };\n406: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs, lines 1-406\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer from an advisor head\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A run line records which command the advisor offered and the policy it named,\n6: // so a start rate can be read as \"did the reader follow the offer\" rather than\n7: // only \"did a command run\". The offer is recovered by replaying the Claude\n8: // prompt hook after the turn, because the head is the only text that names both\n9: // the command and the policy, and a replay keeps the recorded value independent\n10: // of whatever the session reader happened to retain.\n11: //\n12: // A failed replay returns null fields plus an offerError, so a backfill over a\n13: // checkout without the hook, or a hook that crashes, still produces a readable\n14: // line instead of aborting the run.\n15: //\n16: // The offer alone cannot tell a reader who ignored it from a brief the session\n17: // never received, so the same module also reports whether the brief landed. A\n18: // runtime with no confirmed place to look reports `unknown` rather than a miss,\n19: // because a missing record there measures the reader, not the delivery.\n20: //\n21: // A log written before those fields existed gets them from a backfill, which\n22: // resolves every prompt before it writes, so a refused row leaves no partial log\n23: // behind and each line still answers for its own checkout.\n24: \n25: import { spawnSync } from 'node:child_process';\n26: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n27: import { dirname, join, resolve } from 'node:path';\n28: import { fileURLToPath } from 'node:url';\n29: \n30: import { loadSession as loadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n31: \n32: const HOOK_RELATIVE = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n33: const ADVISOR_CLI_RELATIVE = '.skilled/bin/skill-advisor.cjs';\n34: const OFFER_PATTERN = /\\/[a-z][a-z-]*:[a-z][a-z-]*(?: [a-z][a-z-]*)?/;\n35: const POLICY_PATTERN = /^ *(?:\\((run|start|ask)\\))/;\n36: const BRIEF_PATTERN = /Advisor: [a-z]+[;. ]/;\n37: const CLAUDE_ATTACHMENT_EVENT = 'UserPromptSubmit';\n38: const DEFAULT_TIMEOUT_MS = 30_000;\n39: const MAX_OUTPUT_BYTES = 1024 * 1024;\n40: const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../../..');\n41: const CODEX_CHECK = join(REPO_ROOT, '.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs');\n42: \n43: function failedOffer(offerError) {\n44:   return { offeredCommand: null, offeredPolicy: null, offerError };\n45: }\n46: \n47: /**\n48:  * Read the command and the policy out of the first line of a head.\n49:  *\n50:  * The policy only counts when it directly follows the command, so a `(ask)`\n51:  * that belongs to a later clause cannot attach itself to an earlier match.\n52:  *\n53:  * @param {string} head - One line of advisor output.\n54:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null }}\n55:  */\n56: export function parseOffer(head) {\n57:   const text = typeof head === 'string' ? head : '';\n58:   const match = text.match(OFFER_PATTERN);\n59:   if (!match) {\n60:     return { offeredCommand: null, offeredPolicy: null };\n61:   }\n62:   const policy = text.slice(match.index + match[0].length).match(POLICY_PATTERN);\n63:   return {\n64:     offeredCommand: match[0],\n65:     offeredPolicy: policy ? policy[1] : null,\n66:   };\n67: }\n68: \n69: /**\n70:  * Replay the Claude prompt hook for one prompt and parse the offer it prints.\n71:  *\n72:  * The hook is resolved from the checkout rather than from this module, so a\n73:  * backfill records what that checkout's advisor would have offered at the time\n74:  * of the run, not what the current working copy happens to say.\n75:  *\n76:  * @param {object} options\n77:  * @param {string} options.checkoutDir - Root of the checkout whose hook runs.\n78:  * @param {string} options.prompt - The prompt to replay.\n79:  * @param {string} options.sessionId - Session id for the hook payload.\n80:  * @param {number} [options.timeoutMs] - Hook timeout before the replay fails.\n81:  * @returns {{ offeredCommand: string | null, offeredPolicy: string | null, offerError: string | null }}\n82:  */\n83: export function replayOffer({ checkoutDir, prompt, sessionId, timeoutMs = DEFAULT_TIMEOUT_MS }) {\n84:   const hookPath = join(checkoutDir, HOOK_RELATIVE);\n85:   if (!existsSync(hookPath)) {\n86:     return failedOffer('hook_missing');\n87:   }\n88: \n89:   const payload = {\n90:     prompt,\n91:     cwd: checkoutDir,\n92:     hook_event_name: 'UserPromptSubmit',\n93:     session_id: sessionId,\n94:   };\n95: \n96:   let result;\n97:   try {\n98:     result = spawnSync('node', [hookPath], {\n99:       cwd: checkoutDir,\n100:       input: JSON.stringify(payload),\n101:       encoding: 'utf8',\n102:       timeout: timeoutMs,\n103:       maxBuffer: MAX_OUTPUT_BYTES,\n104:     });\n105:   } catch {\n106:     return failedOffer('hook_failed');\n107:   }\n108: \n109:   if (result.error || result.status !== 0 || typeof result.stdout !== 'string') {\n110:     return failedOffer('hook_failed');\n111:   }\n112: \n113:   let output;\n114:   try {\n115:     output = JSON.parse(result.stdout);\n116:   } catch {\n117:     return failedOffer('hook_failed');\n118:   }\n119: \n120:   const context = output?.hookSpecificOutput?.additionalContext;\n121:   if (typeof context !== 'string') {\n122:     return failedOffer('no_head');\n123:   }\n124: \n125:   const [firstLine = ''] = context.split(/\\r?\\n/);\n126:   if (!firstLine.trim()) {\n127:     return failedOffer('no_head');\n128:   }\n129: \n130:   return { ...parseOffer(firstLine), offerError: null };\n131: }\n132: \n133: function contentHasBrief(content) {\n134:   if (typeof content === 'string') return BRIEF_PATTERN.test(content);\n135:   if (!Array.isArray(content)) return false;\n136:   return content.some((part) => {\n137:     if (typeof part === 'string') return BRIEF_PATTERN.test(part);\n138:     return typeof part?.text === 'string' && BRIEF_PATTERN.test(part.text);\n139:   });\n140: }\n141: \n142: // Neutral records keep their text in content blocks, and the block shape differs\n143: // by runtime, so the serialized record is the one place the brief is found\n144: // whichever block carries it.\n145: function recordsHaveBrief(records) {\n146:   return (Array.isArray(records) ? records : []).some((record) =>\n147:     BRIEF_PATTERN.test(JSON.stringify(record ?? null)));\n148: }\n149: \n150: // Injected context sits beside the records rather than inside them, so a reader\n151: // that reports it gives the brief a second place to be found.\n152: function injectedHasBrief(injected) {\n153:   return (Array.isArray(injected) ? injected : []).some(\n154:     (entry) => typeof entry?.text === 'string' && BRIEF_PATTERN.test(entry.text),\n155:   );\n156: }\n157: \n158: /**\n159:  * Ask the project's Codex approval check whether its advisor hook can run.\n160:  *\n161:  * Codex skips an unapproved project hook without a warning, so a wired hook can\n162:  * still deliver nothing. The check reports the approval recorded in the config\n163:  * file it reads, and this wrapper turns that verdict into the answer the\n164:  * delivery decision needs.\n165:  *\n166:  * @param {object} [options]\n167:  * @param {string} [options.projectDir] - Project root whose hooks file is read.\n168:  * @param {string} [options.configPath] - Codex config file, defaulting to the\n169:  *   environment's Codex home.\n170:  * @returns {'approved' | 'unapproved' | 'absent' | 'no-hooks' | 'unknown'}\n171:  */\n172: export function codexHookApproval({ projectDir, configPath } = {}) {\n173:   if (typeof projectDir !== 'string' || projectDir === '') return 'unknown';\n174: \n175:   const args = [CODEX_CHECK, '--root', projectDir, '--json'];\n176:   if (configPath) args.push('--config', configPath);\n177:   const result = spawnSync('node', args, { encoding: 'utf8', timeout: 10_000 });\n178:   if (result.error || typeof result.stdout !== 'string') return 'unknown';\n179: \n180:   let verdict;\n181:   try {\n182:     verdict = JSON.parse(result.stdout);\n183:   } catch {\n184:     return 'unknown';\n185:   }\n186: \n187:   switch (verdict?.code) {\n188:     case 'codex-hooks-approved':\n189:       return 'approved';\n190:     case 'codex-hooks-unapproved':\n191:       return 'unapproved';\n192:     case 'codex-advisor-hook-absent':\n193:       return 'absent';\n194:     case 'no-codex-hooks':\n195:       return 'no-hooks';\n196:     default:\n197:       return 'unknown';\n198:   }\n199: }\n200: \n201: /**\n202:  * Decide whether the advisor brief reached the session that ran the turn.\n203:  *\n204:  * A Claude transcript records the hook context as its own attachment line, so a\n205:  * missing attachment is a real miss. Pi, Devin and DSH keep the brief in their\n206:  * session store, either as a record or as injected context beside it, and Codex\n207:  * answers from its approval plus whatever its store holds. OpenCode stays\n208:  * `unknown`, because its plugin adds the brief in memory and the store keeps no\n209:  * copy.\n210:  *\n211:  * @param {object} options\n212:  * @param {string} options.runtime - The measured runtime.\n213:  * @param {object|null} [options.locator] - The locator the run line recorded.\n214:  * @param {Function} [options.loadSession] - Reader for a runtime whose brief\n215:  *   lives in session records rather than a transcript file.\n216:  * @param {string} [options.codexConfig] - Codex config file the approval is\n217:  *   read from, defaulting to the environment's Codex home.\n218:  * @returns {Promise<boolean | 'unknown'>}\n219:  */\n220: export async function briefDelivered({ runtime, locator, loadSession, codexConfig } = {}) {\n221:   if (runtime === 'claude') {\n222:     const transcriptPath = locator?.transcriptPath;\n223:     if (typeof transcriptPath !== 'string' || transcriptPath.length === 0) {\n224:       return 'unknown';\n225:     }\n226: \n227:     let raw;\n228:     try {\n229:       raw = readFileSync(transcriptPath, 'utf8');\n230:     } catch {\n231:       return 'unknown';\n232:     }\n233: \n234:     for (const line of raw.split('\\n')) {\n235:       if (!line.trim()) continue;\n236:       let entry;\n237:       try {\n238:         entry = JSON.parse(line);\n239:       } catch {\n240:         continue;\n241:       }\n242:       if (entry?.type !== 'attachment') continue;\n243:       const attachment = entry.attachment;\n244:       if (attachment?.type !== 'hook_additional_context') continue;\n245:       if (attachment.hookEvent !== CLAUDE_ATTACHMENT_EVENT) continue;\n246:       if (contentHasBrief(attachment.content)) return true;\n247:     }\n248:     return false;\n249:   }\n250: \n251:   if (runtime === 'pi' || runtime === 'devin' || runtime === 'dsh') {\n252:     if (typeof loadSession !== 'function') return 'unknown';\n253:     let loaded;\n254:     try {\n255:       loaded = await loadSession({ ...locator, runtime });\n256:     } catch {\n257:       return 'unknown';\n258:     }\n259:     if (!loaded?.ok) return 'unknown';\n260:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected);\n261:   }\n262: \n263:   if (runtime === 'codex') {\n264:     // An unapproved project hook never runs, so the brief cannot have arrived.\n265:     // An approved one may store its context where no reader looks yet.\n266:     if (codexHookApproval({ projectDir: locator?.projectDir, configPath: codexConfig }) === 'unapproved') {\n267:       return false;\n268:     }\n269: \n270:     if (typeof loadSession !== 'function') return 'unknown';\n271:     let loaded;\n272:     try {\n273:       loaded = await loadSession({ ...locator, runtime });\n274:     } catch {\n275:       return 'unknown';\n276:     }\n277:     if (!loaded?.ok) return 'unknown';\n278:     return recordsHaveBrief(loaded.records) || injectedHasBrief(loaded.injected)\n279:       ? true\n280:       : 'unknown';\n281:   }\n282: \n283:   return 'unknown';\n284: }\n285: \n286: // ───────────────────────────────────────────────────────────────\n287: // Run-log backfill\n288: // ───────────────────────────────────────────────────────────────\n289: \n290: // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n291: // each checkout to start one before it replays. The status call writes nothing,\n292: // and its failure is ignored because a replay that finds no daemon records its\n293: // own error instead of losing the line.\n294: function warmCheckout(checkoutDir) {\n295:   const cliPath = join(checkoutDir, ADVISOR_CLI_RELATIVE);\n296:   if (!existsSync(cliPath)) return;\n297:   spawnSync(\n298:     'node',\n299:     [cliPath, 'advisor_status', '--workspace-root', checkoutDir, '--format', 'json', '--no-warm-only'],\n300:     {\n301:       cwd: checkoutDir,\n302:       encoding: 'utf8',\n303:       timeout: DEFAULT_TIMEOUT_MS,\n304:       maxBuffer: MAX_OUTPUT_BYTES,\n305:     },\n306:   );\n307: }\n308: \n309: function refused(code, detail) {\n310:   return { ok: false, code, detail };\n311: }\n312: \n313: /**\n314:  * Add the offer, its policy and the brief to every line of a run log.\n315:  *\n316:  * The prompts are resolved before the first line is written, so a row the\n317:  * corpus refuses leaves no output file behind. A line whose locator names no\n318:  * checkout keeps null offer fields and its own error code, and the rest of the\n319:  * log is still written.\n320:  *\n321:  * @param {object} options\n322:  * @param {string} options.inPath - Run log to read.\n323:  * @param {string} options.outPath - New run log to write.\n324:  * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n325:  *   refuses an unknown or holdout row by throwing an error with a `code`.\n326:  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n327:  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n328:  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n329:  *   injectable for tests.\n330:  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n331:  *   | { ok: false, code: string, detail: string }>}\n332:  */\n333: export async function backfillRunLog({\n334:   inPath,\n335:   outPath,\n336:   promptFor,\n337:   replay = replayOffer,\n338:   brief = briefDelivered,\n339:   warm = warmCheckout,\n340: }) {\n341:   if (resolve(outPath) === resolve(inPath)) {\n342:     return refused('same_path', `${outPath}: the backfill writes a new log`);\n343:   }\n344: \n345:   const rows = [];\n346:   for (const raw of readFileSync(inPath, 'utf8').split('\\n')) {\n347:     if (raw.trim() === '') continue;\n348:     rows.push(JSON.parse(raw));\n349:   }\n350: \n351:   const prompts = [];\n352:   for (const row of rows) {\n353:     try {\n354:       prompts.push(promptFor(row.rowId));\n355:     } catch (error) {\n356:       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n357:     }\n358:   }\n359: \n360:   const warmed = new Set();\n361:   const output = [];\n362:   for (let index = 0; index < rows.length; index += 1) {\n363:     const line = rows[index];\n364:     const rowId = line.rowId;\n365:     const locator = line.locator !== null && typeof line.locator === 'object' && !Array.isArray(line.locator)\n366:       ? line.locator\n367:       : null;\n368:     const projectDir = locator?.projectDir;\n369:     const checkoutDir = typeof projectDir === 'string' && projectDir !== '' ? projectDir : null;\n370: \n371:     let offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n372:     if (checkoutDir !== null) {\n373:       if (!warmed.has(checkoutDir)) {\n374:         warmed.add(checkoutDir);\n375:         try {\n376:           await warm(checkoutDir);\n377:         } catch {\n378:           // A failed warm-up still lets the replay report its own miss.\n379:         }\n380:       }\n381:       offer = await replay({\n382:         checkoutDir,\n383:         prompt: prompts[index],\n384:         sessionId: `backfill-${rowId}`,\n385:       });\n386:     }\n387: \n388:     // Pi keeps its brief in a session store rather than a transcript, so the\n389:     // shared reader travels with every call. A runtime that has no reader for\n390:     // its store ignores it and answers `unknown`.\n391:     const delivered = await brief({ runtime: line.runtime, locator, loadSession: loadSharedSession });\n392: \n393:     output.push({\n394:       ...line,\n395:       offeredCommand: offer.offeredCommand ?? null,\n396:       offeredPolicy: offer.offeredPolicy ?? null,\n397:       offerError: offer.offerError ?? null,\n398:       briefDelivered: delivered,\n399:       offerBackfilled: true,\n400:     });\n401:   }\n402: \n403:   mkdirSync(dirname(outPath), { recursive: true });\n404:   writeFileSync(outPath, output.map((line) => `${JSON.stringify(line)}\\n`).join(''), 'utf8');\n405:   return { ok: true, lines: output.length, outPath };\n406: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\"}"},"time":{"start":1794546502751,"end":1794546502819}}}}
