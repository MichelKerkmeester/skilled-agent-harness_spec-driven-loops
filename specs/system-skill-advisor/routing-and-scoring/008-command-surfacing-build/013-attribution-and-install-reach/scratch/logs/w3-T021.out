ne\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\",\n        \"needsMode\": true\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 162,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"status\": \"ok\",\n  \"data\": {\n    \"workspaceRoot\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\",\n    \"effectiveThresholds\": {\n      \"confidenceThreshold\": 0.8,\n      \"uncertaintyThreshold\": 0.35,\n      \"confidenceOnly\": false\n    },\n    \"recommendations\": [\n      {\n        \"skillId\": \"sk-code\",\n        \"score\": 0.650964,\n        \"confidence\": 0.8699,\n        \"uncertainty\": 0.16,\n        \"dominantLane\": \"explicit_author\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-code\",\n          \"action\": \"route\",\n          \"selectionKind\": \"single\",\n          \"targets\": [\n            {\n              \"backendKind\": \"evidence-base\",\n              \"packetId\": \"sk-code-skilled\",\n              \"packetKind\": \"surface\",\n              \"skillId\": \"sk-code\",\n              \"workflowMode\": \"sk-code-skilled\"\n            }\n          ],\n          \"effectivePolicyHash\": \"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\n          \"generation\": 2\n        },\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-doc\",\n        \"score\": 0.115355,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.18,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\",\n        \"needsMode\": true\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 162,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"Add a brief-only backfill option to backfillRunLog in command-offer.mjs and a test case in command-offer.vitest.ts\\\"}' --format json 2>&1 | head -60\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794546541366,"end":1794546541682}}}}
