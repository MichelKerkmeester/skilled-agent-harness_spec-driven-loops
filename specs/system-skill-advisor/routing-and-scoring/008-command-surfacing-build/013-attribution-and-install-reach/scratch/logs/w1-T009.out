\n          \"liveScore\": 0.120306,\n          \"shadowScore\": 0.123263,\n          \"delta\": 0.002957,\n          \"dominantShadowLane\": \"lexical\"\n        },\n        {\n          \"skillId\": \"command-doctor-agents-md-embed\",\n          \"liveScore\": 0.131935,\n          \"shadowScore\": 0.121935,\n          \"delta\": -0.01,\n          \"dominantShadowLane\": \"lexical\"\n        }\n      ]\n    }\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"Leave an @AGENTS.md pointer where embed would remove or never write CLAUDE.md (agents-md-embed.cjs and its test)\\\"}' --format json\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794545745698,"end":1794545746603}}}}
