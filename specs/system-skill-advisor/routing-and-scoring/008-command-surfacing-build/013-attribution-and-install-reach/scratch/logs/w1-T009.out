{"type":"tool_use","timestamp":1794545754398,"sessionID":"ses_e2cbe0f67ffeARtW3ynN5Ce39R","part":{"partID":"prt_1d3431fb5001iv06s5biZr8VSY","sessionID":"ses_e2cbe0f67ffeARtW3ynN5Ce39R","messageID":"msg_1d3430c89001D5fWDLKYz1GCrR","type":"tool","id":"call_85e06de54c9a4601b3bb7517","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1062\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: const { spawnSync } = require('node:child_process');\n44: const crypto = require('node:crypto');\n45: const fs = require('node:fs');\n46: const os = require('node:os');\n47: const path = require('node:path');\n48: \n49: const { buildReport } = require('./agents-md-check.cjs');\n50: const { classifyFile } = require('./release-update.cjs');\n51: const {\n52:   deliveryAnchorEnd,\n53:   findBlock,\n54:   segment,\n55:   sha256,\n56: } = require('./lib/agents-md-sections.cjs');\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: const TAG = '[agents-md-embed]';\n63: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n64: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n65: \n66: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n67: // its generator, and the router verdict belongs to the checker that ships with the skill\n68: // authoring rules.\n69: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n70: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n71: const REPO_RULES_TAG = '[repo-rules-check]';\n72: const TOOL_TIMEOUT_MS = 120000;\n73: \n74: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n75: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n76: // The digest is 64 hex characters and a path segment is better short, so the directory is\n77: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n78: // bits of it is what makes two different plans sharing one a non-event.\n79: const BACKUP_NAME_CHARS = 16;\n80: // How many of this composition's directories a plan will step past before it gives up. The\n81: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n82: // a normal one.\n83: const BACKUP_ATTEMPTS = 64;\n84: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n85: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n86: \n87: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n88: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n89: // and every removal is checked against this list by `assertWritable` before it happens.\n90: const ALLOWLIST = [\n91:   'AGENTS.md',\n92:   'CLAUDE.md',\n93:   '.codex/AGENTS.md',\n94:   '.cursor/rules/repo-local.md',\n95:   '.cursor/rules/skill-routing.md',\n96:   'REPO RULES.md',\n97: ];\n98: \n99: // A copy at one of these paths is read for its unique lines and then removed. Every other\n100: // runtime-copy row is reported by the check engine and left alone here.\n101: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n102: \n103: const USAGE = [\n104:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n105:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n106:   '                             budget, the survival ledger and the plan digest; write nothing',\n107:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n108:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n109:   'Options:',\n110:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n111:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n112:   '  --remove-claude-md         fold it and remove it (the default)',\n113:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n114:   '  --dry-run                  print the plan and write nothing',\n115:   '  --yes                      take the restore confirmation as given',\n116:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n117:   '            2 a precondition failed or a path fell outside the allowlist',\n118: ].join('\\n');\n119: \n120: // ─────────────────────────────────────────────────────────────────────────────\n121: // 3. ERRORS\n122: // ─────────────────────────────────────────────────────────────────────────────\n123: \n124: class UsageError extends Error {}\n125: class PreconditionError extends Error {}\n126: class AllowlistError extends Error {}\n127: \n128: // ─────────────────────────────────────────────────────────────────────────────\n129: // 4. ARGUMENTS\n130: // ─────────────────────────────────────────────────────────────────────────────\n131: \n132: function readValue(argv, index, flag) {\n133:   const argument = argv[index];\n134:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n135:   if (inline !== null) return { value: inline, next: index };\n136:   const value = argv[index + 1];\n137:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n138:   return { value, next: index + 1 };\n139: }\n140: \n141: function parseArgs(argv) {\n142:   const options = {\n143:     command: null,\n144:     root: REPO_ROOT,\n145:     digest: null,\n146:     run: null,\n147:     keepClaudeMd: false,\n148:     createRouter: false,\n149:     dryRun: false,\n150:     yes: false,\n151:     help: false,\n152:   };\n153: \n154:   const commands = [];\n155:   for (let index = 0; index < argv.length; index += 1) {\n156:     const argument = argv[index];\n157:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n158:     else if (argument === '--root') {\n159:       const read = readValue(argv, index, '--root');\n160:       options.root = path.resolve(read.value);\n161:       index = read.next;\n162:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n163:       const read = readValue(argv, index, '--plan-digest');\n164:       options.digest = read.value.trim();\n165:       index = read.next;\n166:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n167:       const read = readValue(argv, index, '--run');\n168:       options.run = path.resolve(read.value);\n169:       index = read.next;\n170:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n171:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n172:     else if (argument === '--create-router') options.createRouter = true;\n173:     else if (argument === '--dry-run') options.dryRun = true;\n174:     else if (argument === '--yes') options.yes = true;\n175:     else if (argument === '--help' || argument === '-h') options.help = true;\n176:     else throw new UsageError(`unknown argument: ${argument}`);\n177:   }\n178: \n179:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n180:   options.command = commands.length === 1 ? commands[0] : null;\n181:   return options;\n182: }\n183: \n184: // ─────────────────────────────────────────────────────────────────────────────\n185: // 5. SMALL SHARED READERS\n186: // ─────────────────────────────────────────────────────────────────────────────\n187: \n188: function loadManifest() {\n189:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n190:   try {\n191:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n192:   } catch (error) {\n193:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n194:   }\n195: }\n196: \n197: function isSymlink(target) {\n198:   try {\n199:     return fs.lstatSync(target).isSymbolicLink();\n200:   } catch {\n201:     return false;\n202:   }\n203: }\n204: \n205: function sameDirectory(a, b) {\n206:   try {\n207:     return fs.realpathSync(a) === fs.realpathSync(b);\n208:   } catch {\n209:     return false;\n210:   }\n211: }\n212: \n213: // The undo a run prints must work as printed. A restore runs against this engine's own\n214: // repository unless told otherwise, so the line names the root whenever it is another one.\n215: function undoCommand(dir, root) {\n216:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n217:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n218: }\n219: \n220: // A line is compared trimmed, and the two lines that carry no content of their own are\n221: // dropped, because a composition may legitimately re-place either of them.\n222: function countLines(text) {\n223:   const counts = new Map();\n224:   for (const raw of String(text).split('\\n')) {\n225:     const line = raw.trim();\n226:     if (line === '' || line === '---') continue;\n227:     counts.set(line, (counts.get(line) || 0) + 1);\n228:   }\n229:   return counts;\n230: }\n231: \n232: function lineSet(text) {\n233:   return new Set(countLines(text).keys());\n234: }\n235: \n236: function uniqueLines(text) {\n237:   return [...countLines(text).keys()];\n238: }\n239: \n240: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n241: // same sentence written twice is two lines to keep.\n242: function lineCount(text) {\n243:   let total = 0;\n244:   for (const count of countLines(text).values()) total += count;\n245:   return total;\n246: }\n247: \n248: // The lines of one body that its reference does not carry, in order and with repeats,\n249: // because the proof counts occurrences rather than membership. The comparison is trimmed\n250: // and the line comes back as it was written: the proof cares that the line survived, and\n251: // the indentation is what makes a nested bullet or a code sample read as one.\n252: function localLinesOf(body, reference) {\n253:   const known = lineSet(reference);\n254:   const lines = [];\n255:   for (const raw of String(body).split('\\n')) {\n256:     const line = raw.trim();\n257:     if (line === '' || line === '---' || known.has(line)) continue;\n258:     lines.push(raw);\n259:   }\n260:   return lines;\n261: }\n262: \n263: function chunkText(text) {\n264:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n265: }\n266: \n267: // ─────────────────────────────────────────────────────────────────────────────\n268: // 6. THE REPOSITORY BLOCK\n269: // ─────────────────────────────────────────────────────────────────────────────\n270: \n271: // What the block holds once the template's own heading and note are set aside. A block a\n272: // previous release wrote opens with both, so recognising them is what keeps a second run\n273: // from nesting one heading inside another.\n274: function blockBody(content, markers) {\n275:   let rest = String(content).replace(/^\\n+/u, '');\n276:   const heading = markers.heading.trim();\n277:   const note = markers.note.trim();\n278:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n279:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n280:   return chunkText(rest);\n281: }\n282: \n283: function renderBlock(markers, body) {\n284:   const text = chunkText(body);\n285:   const between = text === '' ? '' : `${text}\\n`;\n286:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n287: }\n288: \n289: // Devin never sees past the delivery prefix of the root document, so a repository with\n290: // something of its own gets the same block as a Cursor rule that applies always.\n291: function renderMirror(markers, body) {\n292:   const text = chunkText(body);\n293:   const between = text === '' ? '' : `${text}\\n`;\n294:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n295: }\n296: \n297: // A document carrying two blocks has no single block to carry out of, and replacing it\n298: // would have to choose one of them. Naming both positions is what makes the refusal\n299: // actionable: reporting the second block's marker bytes as repository lines the run\n300: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n301: function duplicateBlockMessage(rootFile, block) {\n302:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n303:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n304:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n305: }\n306: \n307: // ─────────────────────────────────────────────────────────────────────────────\n308: // 7. THE ROUTER\n309: // ─────────────────────────────────────────────────────────────────────────────\n310: \n311: function cellsOf(line) {\n312:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n313: }\n314: \n315: // The rule a row points at, which is the identity the checker also compares. Matching on\n316: // the resolved path rather than the whole row is what lets a repository reword a summary\n317: // without the row reading as missing.\n318: function rulePathOf(cells) {\n319:   for (const cell of cells) {\n320:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n321:     if (linked) return linked[1];\n322:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n323:     if (bare) return bare[1];\n324:   }\n325:   return null;\n326: }\n327: \n328: function rowKey(cells) {\n329:   return rulePathOf(cells) || cells.join(' | ');\n330: }\n331: \n332: /**\n333:  * The rows of one router table, with the line each sits on.\n334:  *\n335:  * @param {string} text - The router document.\n336:  * @param {string} anchor - Text that identifies the table's heading.\n337:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n338:  *   Null when the document carries no such table.\n339:  */\n340: function routerTable(text, anchor) {\n341:   const lines = text.split('\\n');\n342:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n343:   if (start === -1) return null;\n344: \n345:   const rows = [];\n346:   let separator = -1;\n347:   let lastRow = -1;\n348:   for (let index = start + 1; index < lines.length; index += 1) {\n349:     const line = lines[index].trim();\n350:     if (line.startsWith('#')) break;\n351:     if (line === '') {\n352:       if (rows.length > 0) break;\n353:       continue;\n354:     }\n355:     if (!line.startsWith('|')) continue;\n356:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n357:       separator = index;\n358:       continue;\n359:     }\n360:     rows.push({ line: index, cells: cellsOf(line) });\n361:     lastRow = index;\n362:   }\n363: \n364:   const anchorLine = rows.length > 0 ? lastRow : separator;\n365:   if (anchorLine === -1) return null;\n366:   return { lines, rows, insertAfter: anchorLine };\n367: }\n368: \n369: /**\n370:  * The router with the shipped rows it is missing, added at the end of each table.\n371:  *\n372:  * @param {string} text\n373:  * @param {Object} manifest\n374:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n375:  */\n376: function addRouterRows(text, manifest) {\n377:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n378:   const tables = [\n379:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n380:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n381:   ];\n382: \n383:   let next = text;\n384:   const added = { trigger: 0, index: 0 };\n385:   const notes = [];\n386: \n387:   for (const table of tables) {\n388:     const found = routerTable(next, table.anchor);\n389:     if (found === null) {\n390:       // A router without the table is a different document shape; appending one would\n391:       // number a second section and break the checker's own reading of the file.\n392:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n393:       continue;\n394:     }\n395:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n396:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n397:     if (missing.length === 0) continue;\n398:     const lines = found.lines.slice();\n399:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n400:     next = lines.join('\\n');\n401:     added[table.kind] = missing.length;\n402:   }\n403: \n404:   return { text: next, added, notes };\n405: }\n406: \n407: // A repository with no router loads no rule at all, so the missing file is created from\n408: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n409: function renderRouter(manifest) {\n410:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n411:   return [\n412:     '# REPO RULES',\n413:     '',\n414:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n415:     'before your first write of the session. This document then routes you to every rule',\n416:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n417:     'holds no rules of its own.',\n418:     '',\n419:     '---',\n420:     '',\n421:     '## 1. HOW TO USE THIS',\n422:     '',\n423:     '1. **Match on the action you are about to take**, not the topic of the request.',\n424:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n425:     '3. **A file already in context is not re-read.**',\n426:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n427:     '',\n428:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n429:     'the same tables, authored one rule at a time.',\n430:     '',\n431:     '---',\n432:     '',\n433:     '## 2. TRIGGER TABLE',\n434:     '',\n435:     '| You are about to… | Load | It settles |',\n436:     '|-------------------|------|-----------|',\n437:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n438:     '',\n439:     '---',\n440:     '',\n441:     '## 3. INDEX',\n442:     '',\n443:     '| Rule | Summary |',\n444:     '|------|---------|',\n445:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n446:     '',\n447:     '---',\n448:     '',\n449:     'Each file the rows name is part of the installation and is replaced by a release.',\n450:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n451:     '',\n452:   ].join('\\n');\n453: }\n454: \n455: // ─────────────────────────────────────────────────────────────────────────────\n456: // 8. THE PLAN DIGEST\n457: // ─────────────────────────────────────────────────────────────────────────────\n458: \n459: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n460: // composed for and by the backup directory the plan takes: the same plan replayed against\n461: // an edited tree composes something else and cannot match, and a plan whose directory an\n462: // earlier run already owns is a different plan, so the digest covers which one it is.\n463: function planDigest(composition, plan) {\n464:   const written = composition.files\n465:     .filter((file) => file.action === 'create' || file.action === 'replace')\n466:     .map((file) => [file.path, file.action, sha256(file.content)])\n467:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n468:   const removed = composition.files\n469:     .filter((file) => file.action === 'remove')\n470:     .map((file) => [file.path, file.action, null])\n471:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n472:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n473: }\n474: \n475: // Where each line of the old document sat, so a lost line is reported with the part it\n476: // belonged to. The block wins over the section it interrupts, because those bytes are the\n477: // repository's and not the section's.\n478: function placementOf(before) {\n479:   const places = new Map();\n480:   for (const section of before.sections) {\n481:     const place = section.id === null\n482:       ? { part: 1, from: 'unmarked section' }\n483:       : { part: 2, from: section.id };\n484:     for (const index of section.rows || []) places.set(index, place);\n485:   }\n486:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n487:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n488:   if (before.block && before.block.complete && before.block.rows) {\n489:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n490:   }\n491:   return places;\n492: }\n493: \n494: // ─────────────────────────────────────────────────────────────────────────────\n495: // 9. THE PRESERVATION PROOF\n496: // ─────────────────────────────────────────────────────────────────────────────\n497: \n498: /**\n499:  * Prove that a composition lost nothing the repository had.\n500:  *\n501:  * Four claims, one per part of the returned record: every line of the old document no\n502:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n503:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n504:  * removed runtime copy still sit in the new document; and every line of the new document\n505:  * outside the block is one the template ships. Pure by construction: same inputs, same\n506:  * answer, no file read.\n507:  *\n508:  * The claim is read from the old document's own lines, in reading order, rather than from\n509:  * the parts the segmentation produced. A proof built from those parts can require only\n510:  * what the reader managed to place, so a line it placed nowhere would be required by\n511:  * nothing and a composition that lost it would still report `dropped 0`.\n512:  *\n513:  * @param {string|null} oldText - The document as it was.\n514:  * @param {string} newText - The document as it would be, or as it now is.\n515:  * @param {Object} manifest\n516:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n517:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n518:  *   foreign: Array<{line: string}>}}\n519:  */\n520: function preservationCheck(oldText, newText, manifest, options = {}) {\n521:   const markers = manifest.markers;\n522:   const dropped = [];\n523:   const knownShipped = new Set();\n524:   for (const entry of Object.values(manifest.derived.sections || {})) {\n525:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n526:   }\n527:   for (const entry of manifest.derived.history || []) {\n528:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n529:   }\n530: \n531:   // The framework's own bytes: the two markers and the heading and note that come with\n532:   // them. The new document carries one of each whatever the old one carried, so requiring\n533:   // them would report a duplicated block as repository lines the run dropped.\n534:   const framework = new Set([\n535:     markers.start.trim(),\n536:     markers.end.trim(),\n537:     markers.heading.trim(),\n538:     markers.note.trim(),\n539:   ]);\n540: \n541:   const before = oldText === null || oldText === undefined\n542:     ? { sections: [], block: null, prelude: null }\n543:     : segment(oldText, markers, manifest.sections);\n544:   const after = segment(newText, markers, manifest.sections);\n545:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n546:   const newBlockCounts = countLines(newBlock);\n547:   const newDocumentCounts = countLines(newText);\n548: \n549:   const require = (line, part, from, need) => {\n550:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n551:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n552:   };\n553: \n554:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n555:   // the new block at least as often as it was there. Where the line sat decides only which\n556:   // part names it when it goes missing.\n557:   const places = placementOf(before);\n558:   const needed = new Map();\n559:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n560:   for (let index = 0; index < oldLines.length; index += 1) {\n561:     const line = oldLines[index].trim();\n562:     if (line === '' || line === '---') continue;\n563:     if (framework.has(line) || knownShipped.has(line)) continue;\n564:     const place = places.get(index) || { part: 1, from: 'the document' };\n565:     const entry = needed.get(line);\n566:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n567:     else entry.need += 1;\n568:   }\n569:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n570: \n571:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n572:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n573:   for (const copy of options.removed || []) {\n574:     for (const [line, count] of countLines(copy.content)) {\n575:       if (framework.has(line)) continue;\n576:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n577:       require(line, 3, copy.path, count);\n578:     }\n579:   }\n580: \n581:   // Part 4. Nothing above the block that the template does not ship.\n582:   const currentOnly = new Set();\n583:   for (const entry of Object.values(manifest.derived.sections || {})) {\n584:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n585:   }\n586:   const foreign = [];\n587:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n588:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n589:   const newBytes = Buffer.from(newText, 'utf8');\n590:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n591:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n592:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n593:   for (const line of uniqueLines(outside)) {\n594:     if (!currentOnly.has(line)) foreign.push({ line });\n595:   }\n596: \n597:   return { dropped, foreign };\n598: }\n599: \n600: // ─────────────────────────────────────────────────────────────────────────────\n601: // 10. COMPOSITION\n602: // ─────────────────────────────────────────────────────────────────────────────\n603: \n604: function rowOf(report, id) {\n605:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n606: }\n607: \n608: function fileState(text) {\n609:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n610: }\n611: \n612: function historyBodyOf(manifest, hash) {\n613:   if (!hash) return null;\n614:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n615:   return entry ? entry.body : null;\n616: }\n617: \n618: function prefixEndOf(text, manifest) {\n619:   if (text === null) return 0;\n620:   const { sections } = segment(text, manifest.markers, manifest.sections);\n621:   const byId = new Map();\n622:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n623:   let end = 0;\n624:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n625:     const section = byId.get(pin.section);\n626:     if (!section) continue;\n627:     const measured = deliveryAnchorEnd(section, pin);\n628:     if (measured !== null) end = Math.max(end, measured);\n629:   }\n630:   return end;\n631: }\n632: \n633: /**\n634:  * Build every target of one repository in memory, with the ledger and the digest.\n635:  *\n636:  * Nothing here writes; the caller decides what to do with the answer.\n637:  *\n638:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n639:  * @returns {Object} the composition\n640:  */\n641: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n642:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n643:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n644: \n645:   const markers = manifest.markers;\n646:   const rootFile = manifest.root_file;\n647:   const rootPath = path.join(root, rootFile);\n648:   // Writing through a link would change a file this repository does not own, and the backup\n649:   // could not put the link back.\n650:   if (isSymlink(rootPath)) {\n651:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n652:   }\n653:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n654: \n655:   const block = oldText === null ? null : findBlock(oldText, markers);\n656:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n657:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n658:   }\n659:   if (block !== null && block.complete === false) {\n660:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n661:   }\n662: \n663:   const oldSegmentation = oldText === null\n664:     ? { sections: [], block: null, prelude: null }\n665:     : segment(oldText, markers, manifest.sections);\n666:   const oldSections = oldSegmentation.sections;\n667:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n668:   const notes = [];\n669:   const chunks = [];\n670: \n671:   // (a) Whatever the block already held.\n672:   if (block !== null && block.complete) {\n673:     const body = blockBody(block.content, markers);\n674:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n675:   }\n676: \n677:   // Text above the first heading belongs to no section, and a replacement would drop it.\n678:   // The segmenter reports it apart from the sections because no heading covers it.\n679:   if (oldSegmentation.prelude !== null) {\n680:     const preamble = chunkText(oldSegmentation.prelude.text);\n681:     if (preamble !== '') {\n682:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n683:     }\n684:   }\n685: \n686:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n687:   // the first heading is already carried as the preamble, and its byte range would reach\n688:   // a block written above the template, so it is the one entry skipped here.\n689:   const unmarkedRow = rowOf(report, 'A8');\n690:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n691:   const unmarked = unmarkedRow.entries\n692:     .filter((entry) => entry.heading !== null)\n693:     .sort((left, right) => left.byte_start - right.byte_start);\n694:   for (const entry of unmarked) {\n695:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n696:     if (text === '') continue;\n697:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n698:   }\n699: \n700:   // (c) The local lines of a section somebody edited, each under its own id.\n701:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n702:   for (const entry of edited) {\n703:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n704:     if (!section) continue;\n705:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n706:     const lines = localLinesOf(section.body, shippedBody);\n707:     if (lines.length === 0) continue;\n708:     chunks.push({\n709:       kind: 'edited',\n710:       id: entry.id,\n711:       lines: lines.length,\n712:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n713:     });\n714: \n715:     // A clean merge would leave the section edited forever, so it is offered as a reading\n716:     // of the same bytes and never as the default.\n717:     const base = historyBodyOf(manifest, entry.base);\n718:     if (base !== null) {\n719:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n720:       if (merged.conflictKind === 'mergeable') {\n721:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n722:       }\n723:     }\n724:   }\n725: \n726:   // (d) The unique lines of a runtime copy that is folded away.\n727:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n728:   const removedCopies = [];\n729:   for (const copy of copies) {\n730:     const absolute = path.join(root, copy.path);\n731:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n732:     if (copy.state !== 'FINDING') continue;\n733:     const content = fs.readFileSync(absolute, 'utf8');\n734:     // With no root document every line of the copy is its own, and the count has to survive:\n735:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n736:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n737:     if (lines.length > 0) {\n738:       chunks.push({\n739:         kind: 'copy',\n740:         path: copy.path,\n741:         lines: lines.length,\n742:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n743:       });\n744:     }\n745:     removedCopies.push({ path: copy.path, content });\n746:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n747:       removedCopies.pop();\n748:       if (lines.length > 0) {\n749:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n750:       }\n751:     }\n752:   }\n753: \n754:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n755:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n756: \n757:   // The template with nothing of the repository's own in it gains nothing from the two\n758:   // marker lines, so that difference alone is not a reason to write: the markers appear\n759:   // with the first line worth keeping.\n760:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n761:   if (templateOnly) {\n762:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n763:   }\n764: \n765:   const files = [];\n766:   if (templateOnly || oldText === composed) {\n767:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n768:   } else {\n769:     files.push({\n770:       path: rootFile,\n771:       action: oldText === null ? 'create' : 'replace',\n772:       content: composed,\n773:       before: oldText,\n774:     });\n775:   }\n776: \n777:   // The router gains the shipped rows it is missing, or is created from them when asked.\n778:   const routerPath = path.join(root, manifest.router_file);\n779:   let routerAction = 'unchanged';\n780:   let routerText = null;\n781:   if (fs.existsSync(routerPath)) {\n782:     const current = fs.readFileSync(routerPath, 'utf8');\n783:     const result = addRouterRows(current, manifest);\n784:     notes.push(...result.notes);\n785:     if (result.text !== current) {\n786:       routerText = result.text;\n787:       routerAction = 'replace';\n788:       if (result.added.trigger > 0 || result.added.index > 0) {\n789:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n790:       }\n791:     }\n792:   } else if (createRouter) {\n793:     routerText = renderRouter(manifest);\n794:     routerAction = 'create';\n795:   } else {\n796:     routerAction = 'absent';\n797:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n798:   }\n799:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n800: \n801:   // The Cursor mirror exists exactly when the block carries something, because an empty\n802:   // block has nothing a runtime that cannot read past the prefix would miss.\n803:   const mirrorPath = path.join(root, MIRROR_FILE);\n804:   const mirrorExists = fs.existsSync(mirrorPath);\n805:   let mirrorAction = 'unchanged';\n806:   let mirrorText = null;\n807:   if (blockText !== '') {\n808:     mirrorText = renderMirror(markers, blockText);\n809:     if (!mirrorExists) mirrorAction = 'create';\n810:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n811:   } else if (mirrorExists) {\n812:     mirrorAction = 'remove';\n813:   }\n814:   if (mirrorAction !== 'unchanged') {\n815:     files.push({\n816:       path: MIRROR_FILE,\n817:       action: mirrorAction,\n818:       content: mirrorText,\n819:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n820:     });\n821:   }\n822: \n823:   for (const copy of removedCopies) {\n824:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n825:   }\n826: \n827:   const composition = {\n828:     root,\n829:     state: report.state,\n830:     report,\n831:     markers,\n832:     rootFile,\n833:     oldText,\n834:     composed,\n835:     block: { text: renderBlock(markers, blockText), body: blockText },\n836:     chunks,\n837:     removedCopies,\n838:     notes,\n839:     files,\n840:     budget: {\n841:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n842:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n843:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n844:     },\n845:     ledger: {\n846:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n847:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n848:       shippedReplaced: manifest.sections.length,\n849:       dropped: 0,\n850:     },\n851:   };\n852: \n853:   // What the run would put on disk, which is exactly the three actions a target can take.\n854:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n855:   return composition;\n856: }\n857: \n858: // ─────────────────────────────────────────────────────────────────────────────\n859: // 11. THE WRITE ALLOWLIST\n860: // ─────────────────────────────────────────────────────────────────────────────\n861: \n862: /**\n863:  * Resolve one path a run wants to touch, or refuse it.\n864:  *\n865:  * Containment is checked before membership, so a path that climbs out of the root is\n866:  * reported as what it is rather than as a missing allowlist entry.\n867:  *\n868:  * @param {string} root\n869:  * @param {string} relative\n870:  * @returns {string} the absolute path\n871:  */\n872: function assertWritable(root, relative) {\n873:   const base = path.resolve(root);\n874:   const normalized = String(relative).split(path.sep).join('/');\n875:   const absolute = path.resolve(base, normalized);\n876:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n877:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n878:   }\n879:   if (!ALLOWLIST.includes(normalized)) {\n880:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n881:   }\n882:   // Every path a run reaches must sit inside the root where the root really is, not only\n883:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n884:   const realBase = fs.realpathSync(base);\n885:   const realTarget = resolveThroughLinks(absolute);\n886:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n887:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n888:   }\n889:   return absolute;\n890: }\n891: \n892: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n893: // and the rest of the name is appended to it.\n894: function resolveThroughLinks(absolute) {\n895:   try {\n896:     return fs.realpathSync(absolute);\n897:   } catch {\n898:     const parent = path.dirname(absolute);\n899:     if (parent === absolute) return absolute;\n900:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n901:   }\n902: }\n903: \n904: // ─────────────────────────────────────────────────────────────────────────────\n905: // 12. BACKUPS\n906: // ─────────────────────────────────────────────────────────────────────────────\n907: \n908: function utcStamp(date = new Date()) {\n909:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n910: }\n911: \n912: /**\n913:  * The directory a plan's backup sits in, named after the plan digest.\n914:  *\n915:  * Named by the digest rather than by a clock reading because apply has to land exactly\n916:  * where the plan pointed and the digest is the only thing the operator carries across. The\n917:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n918:  * taken and moves to the next ordinal instead of writing beside it.\n919:  *\n920:  * @param {string} base\n921:  * @param {string} digest\n922:  * @returns {string}\n923:  */\n924: function backupDirectoryOf(base, digest) {\n925:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n926: }\n927: \n928: /**\n929:  * Where a run's backup goes, without creating anything.\n930:  *\n931:  * The output directory is used only when git ignores it, because a backup inside a tracked\n932:  * path is a backup the next commit publishes. Everything else leaves the repository.\n933:  *\n934:  * @param {{root: string}} input\n935:  * @returns {{dir: string, fallback: boolean, reason: string}}\n936:  */\n937: function backupBase({ root }) {\n938:   const candidate = path.join(root, BACKUP_DIR);\n939:   // The question is the one the run depends on: would a plan directory under this one be\n940:   // published by the next commit? Asking about the base alone would miss a rule written as\n941:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n942:   // the probe is a path of the same shape as the one the plan takes.\n943:   const probe = path.join(candidate, 'probe');\n944:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n945:     encoding: 'utf8',\n946:     timeout: TOOL_TIMEOUT_MS,\n947:   });\n948:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n949:   const reason = ignored.status === 1\n950:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n951:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n952:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n953: }\n954: \n955: /**\n956:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n957:  * that says both.\n958:  *\n959:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n960:  * suffixed into a second name, because the printed undo command would then point at that\n961:  * run's bytes; the next ordinal is a different plan with a different digest and a\n962:  * directory of its own.\n963:  *\n964:  * @param {Object} composition\n965:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n966:  */\n967: function planFor(composition) {\n968:   const base = backupBase({ root: composition.root });\n969:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n970:     const digest = planDigest(composition, { ordinal, base: base.dir });\n971:     const dir = backupDirectoryOf(base.dir, digest);\n972:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n973:   }\n974:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n975: }\n976: \n977: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n978: // only these, so on a record the run wrote, a folder that was there before the run is never\n979: // taken away with it.\n980: function missingParents(root, relative) {\n981:   const missing = [];\n982:   let dir = path.posix.dirname(relative);\n983:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n984:     missing.push(dir);\n985:     dir = path.posix.dirname(dir);\n986:   }\n987:   return missing;\n988: }\n989: \n990: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n991: // entry's own allowlisted path; the list stops at the first one that is not.\n992: function recordedCreatedDirs(entry) {\n993:   const dirs = [];\n994:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n995:   for (const dir of entry.createdDirs) {\n996:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n997:     dirs.push(dir);\n998:   }\n999:   return dirs;\n1000: }\n1001: \n1002: // Runs after every file is back, because two new files can share one new folder. Only the\n1003: // folders above a file this restore just deleted are considered, and only an empty one is\n1004: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1005: // file the run created.\n1006: function removeCreatedDirs(root, entries, deleted) {\n1007:   const removed = [];\n1008:   for (const entry of entries) {\n1009:     if (!deleted.has(entry.path)) continue;\n1010:     for (const dir of recordedCreatedDirs(entry)) {\n1011:       const absolute = path.join(root, dir);\n1012:       let names;\n1013:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1014:       if (names.length > 0) break;\n1015:       fs.rmdirSync(absolute);\n1016:       removed.push(dir);\n1017:     }\n1018:   }\n1019:   return removed;\n1020: }\n1021: \n1022: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1023: // copy rather than a reconstruction.\n1024: function backupEntry(root, file) {\n1025:   const absolute = path.join(root, file.path);\n1026:   const exists = fs.existsSync(absolute);\n1027:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1028:   if (!exists) {\n1029:     entry.createdDirs = missingParents(root, file.path);\n1030:     return entry;\n1031:   }\n1032:   const stats = fs.lstatSync(absolute);\n1033:   entry.mode = stats.mode.toString(8).slice(-4);\n1034:   entry.symlink = stats.isSymbolicLink();\n1035:   const bytes = fs.readFileSync(absolute);\n1036:   entry.sha256 = sha256(bytes.toString('utf8'));\n1037:   entry.backup = path.posix.join('files', file.path);\n1038:   return entry;\n1039: }\n1040: \n1041: function writeBackup({ root, manifest, composition, plan }) {\n1042:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1043:   // finishing first: writing beside its record would make the undo ambiguous.\n1044:   if (fs.existsSync(plan.dir)) {\n1045:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1046:   }\n1047:   fs.mkdirSync(plan.dir, { recursive: true });\n1048: \n1049:   const entries = [];\n1050:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n1051:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1052:   // would touch it, even though this engine composes nothing for it.\n1053:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1054:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1055:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1056:   }\n1057: \n1058:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1059:   // the rollback must not share a path with the writer it exists to undo.\n1060:   for (const entry of entries) {\n1061:     if (!entry.existed) continue;\n1062:     const destination = path.join(plan.dir, entry.backup);\n[Output truncated. Continue reading with offset: 1063]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1062\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: const { spawnSync } = require('node:child_process');\n44: const crypto = require('node:crypto');\n45: const fs = require('node:fs');\n46: const os = require('node:os');\n47: const path = require('node:path');\n48: \n49: const { buildReport } = require('./agents-md-check.cjs');\n50: const { classifyFile } = require('./release-update.cjs');\n51: const {\n52:   deliveryAnchorEnd,\n53:   findBlock,\n54:   segment,\n55:   sha256,\n56: } = require('./lib/agents-md-sections.cjs');\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: const TAG = '[agents-md-embed]';\n63: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n64: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n65: \n66: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n67: // its generator, and the router verdict belongs to the checker that ships with the skill\n68: // authoring rules.\n69: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n70: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n71: const REPO_RULES_TAG = '[repo-rules-check]';\n72: const TOOL_TIMEOUT_MS = 120000;\n73: \n74: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n75: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n76: // The digest is 64 hex characters and a path segment is better short, so the directory is\n77: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n78: // bits of it is what makes two different plans sharing one a non-event.\n79: const BACKUP_NAME_CHARS = 16;\n80: // How many of this composition's directories a plan will step past before it gives up. The\n81: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n82: // a normal one.\n83: const BACKUP_ATTEMPTS = 64;\n84: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n85: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n86: \n87: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n88: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n89: // and every removal is checked against this list by `assertWritable` before it happens.\n90: const ALLOWLIST = [\n91:   'AGENTS.md',\n92:   'CLAUDE.md',\n93:   '.codex/AGENTS.md',\n94:   '.cursor/rules/repo-local.md',\n95:   '.cursor/rules/skill-routing.md',\n96:   'REPO RULES.md',\n97: ];\n98: \n99: // A copy at one of these paths is read for its unique lines and then removed. Every other\n100: // runtime-copy row is reported by the check engine and left alone here.\n101: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n102: \n103: const USAGE = [\n104:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n105:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n106:   '                             budget, the survival ledger and the plan digest; write nothing',\n107:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n108:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n109:   'Options:',\n110:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n111:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n112:   '  --remove-claude-md         fold it and remove it (the default)',\n113:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n114:   '  --dry-run                  print the plan and write nothing',\n115:   '  --yes                      take the restore confirmation as given',\n116:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n117:   '            2 a precondition failed or a path fell outside the allowlist',\n118: ].join('\\n');\n119: \n120: // ─────────────────────────────────────────────────────────────────────────────\n121: // 3. ERRORS\n122: // ─────────────────────────────────────────────────────────────────────────────\n123: \n124: class UsageError extends Error {}\n125: class PreconditionError extends Error {}\n126: class AllowlistError extends Error {}\n127: \n128: // ─────────────────────────────────────────────────────────────────────────────\n129: // 4. ARGUMENTS\n130: // ─────────────────────────────────────────────────────────────────────────────\n131: \n132: function readValue(argv, index, flag) {\n133:   const argument = argv[index];\n134:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n135:   if (inline !== null) return { value: inline, next: index };\n136:   const value = argv[index + 1];\n137:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n138:   return { value, next: index + 1 };\n139: }\n140: \n141: function parseArgs(argv) {\n142:   const options = {\n143:     command: null,\n144:     root: REPO_ROOT,\n145:     digest: null,\n146:     run: null,\n147:     keepClaudeMd: false,\n148:     createRouter: false,\n149:     dryRun: false,\n150:     yes: false,\n151:     help: false,\n152:   };\n153: \n154:   const commands = [];\n155:   for (let index = 0; index < argv.length; index += 1) {\n156:     const argument = argv[index];\n157:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n158:     else if (argument === '--root') {\n159:       const read = readValue(argv, index, '--root');\n160:       options.root = path.resolve(read.value);\n161:       index = read.next;\n162:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n163:       const read = readValue(argv, index, '--plan-digest');\n164:       options.digest = read.value.trim();\n165:       index = read.next;\n166:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n167:       const read = readValue(argv, index, '--run');\n168:       options.run = path.resolve(read.value);\n169:       index = read.next;\n170:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n171:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n172:     else if (argument === '--create-router') options.createRouter = true;\n173:     else if (argument === '--dry-run') options.dryRun = true;\n174:     else if (argument === '--yes') options.yes = true;\n175:     else if (argument === '--help' || argument === '-h') options.help = true;\n176:     else throw new UsageError(`unknown argument: ${argument}`);\n177:   }\n178: \n179:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n180:   options.command = commands.length === 1 ? commands[0] : null;\n181:   return options;\n182: }\n183: \n184: // ─────────────────────────────────────────────────────────────────────────────\n185: // 5. SMALL SHARED READERS\n186: // ─────────────────────────────────────────────────────────────────────────────\n187: \n188: function loadManifest() {\n189:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n190:   try {\n191:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n192:   } catch (error) {\n193:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n194:   }\n195: }\n196: \n197: function isSymlink(target) {\n198:   try {\n199:     return fs.lstatSync(target).isSymbolicLink();\n200:   } catch {\n201:     return false;\n202:   }\n203: }\n204: \n205: function sameDirectory(a, b) {\n206:   try {\n207:     return fs.realpathSync(a) === fs.realpathSync(b);\n208:   } catch {\n209:     return false;\n210:   }\n211: }\n212: \n213: // The undo a run prints must work as printed. A restore runs against this engine's own\n214: // repository unless told otherwise, so the line names the root whenever it is another one.\n215: function undoCommand(dir, root) {\n216:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n217:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n218: }\n219: \n220: // A line is compared trimmed, and the two lines that carry no content of their own are\n221: // dropped, because a composition may legitimately re-place either of them.\n222: function countLines(text) {\n223:   const counts = new Map();\n224:   for (const raw of String(text).split('\\n')) {\n225:     const line = raw.trim();\n226:     if (line === '' || line === '---') continue;\n227:     counts.set(line, (counts.get(line) || 0) + 1);\n228:   }\n229:   return counts;\n230: }\n231: \n232: function lineSet(text) {\n233:   return new Set(countLines(text).keys());\n234: }\n235: \n236: function uniqueLines(text) {\n237:   return [...countLines(text).keys()];\n238: }\n239: \n240: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n241: // same sentence written twice is two lines to keep.\n242: function lineCount(text) {\n243:   let total = 0;\n244:   for (const count of countLines(text).values()) total += count;\n245:   return total;\n246: }\n247: \n248: // The lines of one body that its reference does not carry, in order and with repeats,\n249: // because the proof counts occurrences rather than membership. The comparison is trimmed\n250: // and the line comes back as it was written: the proof cares that the line survived, and\n251: // the indentation is what makes a nested bullet or a code sample read as one.\n252: function localLinesOf(body, reference) {\n253:   const known = lineSet(reference);\n254:   const lines = [];\n255:   for (const raw of String(body).split('\\n')) {\n256:     const line = raw.trim();\n257:     if (line === '' || line === '---' || known.has(line)) continue;\n258:     lines.push(raw);\n259:   }\n260:   return lines;\n261: }\n262: \n263: function chunkText(text) {\n264:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n265: }\n266: \n267: // ─────────────────────────────────────────────────────────────────────────────\n268: // 6. THE REPOSITORY BLOCK\n269: // ─────────────────────────────────────────────────────────────────────────────\n270: \n271: // What the block holds once the template's own heading and note are set aside. A block a\n272: // previous release wrote opens with both, so recognising them is what keeps a second run\n273: // from nesting one heading inside another.\n274: function blockBody(content, markers) {\n275:   let rest = String(content).replace(/^\\n+/u, '');\n276:   const heading = markers.heading.trim();\n277:   const note = markers.note.trim();\n278:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n279:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n280:   return chunkText(rest);\n281: }\n282: \n283: function renderBlock(markers, body) {\n284:   const text = chunkText(body);\n285:   const between = text === '' ? '' : `${text}\\n`;\n286:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n287: }\n288: \n289: // Devin never sees past the delivery prefix of the root document, so a repository with\n290: // something of its own gets the same block as a Cursor rule that applies always.\n291: function renderMirror(markers, body) {\n292:   const text = chunkText(body);\n293:   const between = text === '' ? '' : `${text}\\n`;\n294:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n295: }\n296: \n297: // A document carrying two blocks has no single block to carry out of, and replacing it\n298: // would have to choose one of them. Naming both positions is what makes the refusal\n299: // actionable: reporting the second block's marker bytes as repository lines the run\n300: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n301: function duplicateBlockMessage(rootFile, block) {\n302:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n303:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n304:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n305: }\n306: \n307: // ─────────────────────────────────────────────────────────────────────────────\n308: // 7. THE ROUTER\n309: // ─────────────────────────────────────────────────────────────────────────────\n310: \n311: function cellsOf(line) {\n312:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n313: }\n314: \n315: // The rule a row points at, which is the identity the checker also compares. Matching on\n316: // the resolved path rather than the whole row is what lets a repository reword a summary\n317: // without the row reading as missing.\n318: function rulePathOf(cells) {\n319:   for (const cell of cells) {\n320:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n321:     if (linked) return linked[1];\n322:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n323:     if (bare) return bare[1];\n324:   }\n325:   return null;\n326: }\n327: \n328: function rowKey(cells) {\n329:   return rulePathOf(cells) || cells.join(' | ');\n330: }\n331: \n332: /**\n333:  * The rows of one router table, with the line each sits on.\n334:  *\n335:  * @param {string} text - The router document.\n336:  * @param {string} anchor - Text that identifies the table's heading.\n337:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n338:  *   Null when the document carries no such table.\n339:  */\n340: function routerTable(text, anchor) {\n341:   const lines = text.split('\\n');\n342:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n343:   if (start === -1) return null;\n344: \n345:   const rows = [];\n346:   let separator = -1;\n347:   let lastRow = -1;\n348:   for (let index = start + 1; index < lines.length; index += 1) {\n349:     const line = lines[index].trim();\n350:     if (line.startsWith('#')) break;\n351:     if (line === '') {\n352:       if (rows.length > 0) break;\n353:       continue;\n354:     }\n355:     if (!line.startsWith('|')) continue;\n356:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n357:       separator = index;\n358:       continue;\n359:     }\n360:     rows.push({ line: index, cells: cellsOf(line) });\n361:     lastRow = index;\n362:   }\n363: \n364:   const anchorLine = rows.length > 0 ? lastRow : separator;\n365:   if (anchorLine === -1) return null;\n366:   return { lines, rows, insertAfter: anchorLine };\n367: }\n368: \n369: /**\n370:  * The router with the shipped rows it is missing, added at the end of each table.\n371:  *\n372:  * @param {string} text\n373:  * @param {Object} manifest\n374:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n375:  */\n376: function addRouterRows(text, manifest) {\n377:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n378:   const tables = [\n379:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n380:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n381:   ];\n382: \n383:   let next = text;\n384:   const added = { trigger: 0, index: 0 };\n385:   const notes = [];\n386: \n387:   for (const table of tables) {\n388:     const found = routerTable(next, table.anchor);\n389:     if (found === null) {\n390:       // A router without the table is a different document shape; appending one would\n391:       // number a second section and break the checker's own reading of the file.\n392:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n393:       continue;\n394:     }\n395:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n396:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n397:     if (missing.length === 0) continue;\n398:     const lines = found.lines.slice();\n399:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n400:     next = lines.join('\\n');\n401:     added[table.kind] = missing.length;\n402:   }\n403: \n404:   return { text: next, added, notes };\n405: }\n406: \n407: // A repository with no router loads no rule at all, so the missing file is created from\n408: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n409: function renderRouter(manifest) {\n410:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n411:   return [\n412:     '# REPO RULES',\n413:     '',\n414:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n415:     'before your first write of the session. This document then routes you to every rule',\n416:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n417:     'holds no rules of its own.',\n418:     '',\n419:     '---',\n420:     '',\n421:     '## 1. HOW TO USE THIS',\n422:     '',\n423:     '1. **Match on the action you are about to take**, not the topic of the request.',\n424:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n425:     '3. **A file already in context is not re-read.**',\n426:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n427:     '',\n428:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n429:     'the same tables, authored one rule at a time.',\n430:     '',\n431:     '---',\n432:     '',\n433:     '## 2. TRIGGER TABLE',\n434:     '',\n435:     '| You are about to… | Load | It settles |',\n436:     '|-------------------|------|-----------|',\n437:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n438:     '',\n439:     '---',\n440:     '',\n441:     '## 3. INDEX',\n442:     '',\n443:     '| Rule | Summary |',\n444:     '|------|---------|',\n445:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n446:     '',\n447:     '---',\n448:     '',\n449:     'Each file the rows name is part of the installation and is replaced by a release.',\n450:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n451:     '',\n452:   ].join('\\n');\n453: }\n454: \n455: // ─────────────────────────────────────────────────────────────────────────────\n456: // 8. THE PLAN DIGEST\n457: // ─────────────────────────────────────────────────────────────────────────────\n458: \n459: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n460: // composed for and by the backup directory the plan takes: the same plan replayed against\n461: // an edited tree composes something else and cannot match, and a plan whose directory an\n462: // earlier run already owns is a different plan, so the digest covers which one it is.\n463: function planDigest(composition, plan) {\n464:   const written = composition.files\n465:     .filter((file) => file.action === 'create' || file.action === 'replace')\n466:     .map((file) => [file.path, file.action, sha256(file.content)])\n467:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n468:   const removed = composition.files\n469:     .filter((file) => file.action === 'remove')\n470:     .map((file) => [file.path, file.action, null])\n471:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n472:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n473: }\n474: \n475: // Where each line of the old document sat, so a lost line is reported with the part it\n476: // belonged to. The block wins over the section it interrupts, because those bytes are the\n477: // repository's and not the section's.\n478: function placementOf(before) {\n479:   const places = new Map();\n480:   for (const section of before.sections) {\n481:     const place = section.id === null\n482:       ? { part: 1, from: 'unmarked section' }\n483:       : { part: 2, from: section.id };\n484:     for (const index of section.rows || []) places.set(index, place);\n485:   }\n486:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n487:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n488:   if (before.block && before.block.complete && before.block.rows) {\n489:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n490:   }\n491:   return places;\n492: }\n493: \n494: // ─────────────────────────────────────────────────────────────────────────────\n495: // 9. THE PRESERVATION PROOF\n496: // ─────────────────────────────────────────────────────────────────────────────\n497: \n498: /**\n499:  * Prove that a composition lost nothing the repository had.\n500:  *\n501:  * Four claims, one per part of the returned record: every line of the old document no\n502:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n503:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n504:  * removed runtime copy still sit in the new document; and every line of the new document\n505:  * outside the block is one the template ships. Pure by construction: same inputs, same\n506:  * answer, no file read.\n507:  *\n508:  * The claim is read from the old document's own lines, in reading order, rather than from\n509:  * the parts the segmentation produced. A proof built from those parts can require only\n510:  * what the reader managed to place, so a line it placed nowhere would be required by\n511:  * nothing and a composition that lost it would still report `dropped 0`.\n512:  *\n513:  * @param {string|null} oldText - The document as it was.\n514:  * @param {string} newText - The document as it would be, or as it now is.\n515:  * @param {Object} manifest\n516:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n517:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n518:  *   foreign: Array<{line: string}>}}\n519:  */\n520: function preservationCheck(oldText, newText, manifest, options = {}) {\n521:   const markers = manifest.markers;\n522:   const dropped = [];\n523:   const knownShipped = new Set();\n524:   for (const entry of Object.values(manifest.derived.sections || {})) {\n525:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n526:   }\n527:   for (const entry of manifest.derived.history || []) {\n528:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n529:   }\n530: \n531:   // The framework's own bytes: the two markers and the heading and note that come with\n532:   // them. The new document carries one of each whatever the old one carried, so requiring\n533:   // them would report a duplicated block as repository lines the run dropped.\n534:   const framework = new Set([\n535:     markers.start.trim(),\n536:     markers.end.trim(),\n537:     markers.heading.trim(),\n538:     markers.note.trim(),\n539:   ]);\n540: \n541:   const before = oldText === null || oldText === undefined\n542:     ? { sections: [], block: null, prelude: null }\n543:     : segment(oldText, markers, manifest.sections);\n544:   const after = segment(newText, markers, manifest.sections);\n545:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n546:   const newBlockCounts = countLines(newBlock);\n547:   const newDocumentCounts = countLines(newText);\n548: \n549:   const require = (line, part, from, need) => {\n550:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n551:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n552:   };\n553: \n554:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n555:   // the new block at least as often as it was there. Where the line sat decides only which\n556:   // part names it when it goes missing.\n557:   const places = placementOf(before);\n558:   const needed = new Map();\n559:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n560:   for (let index = 0; index < oldLines.length; index += 1) {\n561:     const line = oldLines[index].trim();\n562:     if (line === '' || line === '---') continue;\n563:     if (framework.has(line) || knownShipped.has(line)) continue;\n564:     const place = places.get(index) || { part: 1, from: 'the document' };\n565:     const entry = needed.get(line);\n566:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n567:     else entry.need += 1;\n568:   }\n569:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n570: \n571:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n572:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n573:   for (const copy of options.removed || []) {\n574:     for (const [line, count] of countLines(copy.content)) {\n575:       if (framework.has(line)) continue;\n576:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n577:       require(line, 3, copy.path, count);\n578:     }\n579:   }\n580: \n581:   // Part 4. Nothing above the block that the template does not ship.\n582:   const currentOnly = new Set();\n583:   for (const entry of Object.values(manifest.derived.sections || {})) {\n584:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n585:   }\n586:   const foreign = [];\n587:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n588:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n589:   const newBytes = Buffer.from(newText, 'utf8');\n590:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n591:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n592:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n593:   for (const line of uniqueLines(outside)) {\n594:     if (!currentOnly.has(line)) foreign.push({ line });\n595:   }\n596: \n597:   return { dropped, foreign };\n598: }\n599: \n600: // ─────────────────────────────────────────────────────────────────────────────\n601: // 10. COMPOSITION\n602: // ─────────────────────────────────────────────────────────────────────────────\n603: \n604: function rowOf(report, id) {\n605:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n606: }\n607: \n608: function fileState(text) {\n609:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n610: }\n611: \n612: function historyBodyOf(manifest, hash) {\n613:   if (!hash) return null;\n614:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n615:   return entry ? entry.body : null;\n616: }\n617: \n618: function prefixEndOf(text, manifest) {\n619:   if (text === null) return 0;\n620:   const { sections } = segment(text, manifest.markers, manifest.sections);\n621:   const byId = new Map();\n622:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n623:   let end = 0;\n624:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n625:     const section = byId.get(pin.section);\n626:     if (!section) continue;\n627:     const measured = deliveryAnchorEnd(section, pin);\n628:     if (measured !== null) end = Math.max(end, measured);\n629:   }\n630:   return end;\n631: }\n632: \n633: /**\n634:  * Build every target of one repository in memory, with the ledger and the digest.\n635:  *\n636:  * Nothing here writes; the caller decides what to do with the answer.\n637:  *\n638:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n639:  * @returns {Object} the composition\n640:  */\n641: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n642:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n643:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n644: \n645:   const markers = manifest.markers;\n646:   const rootFile = manifest.root_file;\n647:   const rootPath = path.join(root, rootFile);\n648:   // Writing through a link would change a file this repository does not own, and the backup\n649:   // could not put the link back.\n650:   if (isSymlink(rootPath)) {\n651:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n652:   }\n653:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n654: \n655:   const block = oldText === null ? null : findBlock(oldText, markers);\n656:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n657:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n658:   }\n659:   if (block !== null && block.complete === false) {\n660:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n661:   }\n662: \n663:   const oldSegmentation = oldText === null\n664:     ? { sections: [], block: null, prelude: null }\n665:     : segment(oldText, markers, manifest.sections);\n666:   const oldSections = oldSegmentation.sections;\n667:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n668:   const notes = [];\n669:   const chunks = [];\n670: \n671:   // (a) Whatever the block already held.\n672:   if (block !== null && block.complete) {\n673:     const body = blockBody(block.content, markers);\n674:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n675:   }\n676: \n677:   // Text above the first heading belongs to no section, and a replacement would drop it.\n678:   // The segmenter reports it apart from the sections because no heading covers it.\n679:   if (oldSegmentation.prelude !== null) {\n680:     const preamble = chunkText(oldSegmentation.prelude.text);\n681:     if (preamble !== '') {\n682:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n683:     }\n684:   }\n685: \n686:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n687:   // the first heading is already carried as the preamble, and its byte range would reach\n688:   // a block written above the template, so it is the one entry skipped here.\n689:   const unmarkedRow = rowOf(report, 'A8');\n690:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n691:   const unmarked = unmarkedRow.entries\n692:     .filter((entry) => entry.heading !== null)\n693:     .sort((left, right) => left.byte_start - right.byte_start);\n694:   for (const entry of unmarked) {\n695:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n696:     if (text === '') continue;\n697:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n698:   }\n699: \n700:   // (c) The local lines of a section somebody edited, each under its own id.\n701:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n702:   for (const entry of edited) {\n703:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n704:     if (!section) continue;\n705:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n706:     const lines = localLinesOf(section.body, shippedBody);\n707:     if (lines.length === 0) continue;\n708:     chunks.push({\n709:       kind: 'edited',\n710:       id: entry.id,\n711:       lines: lines.length,\n712:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n713:     });\n714: \n715:     // A clean merge would leave the section edited forever, so it is offered as a reading\n716:     // of the same bytes and never as the default.\n717:     const base = historyBodyOf(manifest, entry.base);\n718:     if (base !== null) {\n719:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n720:       if (merged.conflictKind === 'mergeable') {\n721:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n722:       }\n723:     }\n724:   }\n725: \n726:   // (d) The unique lines of a runtime copy that is folded away.\n727:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n728:   const removedCopies = [];\n729:   for (const copy of copies) {\n730:     const absolute = path.join(root, copy.path);\n731:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n732:     if (copy.state !== 'FINDING') continue;\n733:     const content = fs.readFileSync(absolute, 'utf8');\n734:     // With no root document every line of the copy is its own, and the count has to survive:\n735:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n736:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n737:     if (lines.length > 0) {\n738:       chunks.push({\n739:         kind: 'copy',\n740:         path: copy.path,\n741:         lines: lines.length,\n742:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n743:       });\n744:     }\n745:     removedCopies.push({ path: copy.path, content });\n746:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n747:       removedCopies.pop();\n748:       if (lines.length > 0) {\n749:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n750:       }\n751:     }\n752:   }\n753: \n754:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n755:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n756: \n757:   // The template with nothing of the repository's own in it gains nothing from the two\n758:   // marker lines, so that difference alone is not a reason to write: the markers appear\n759:   // with the first line worth keeping.\n760:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n761:   if (templateOnly) {\n762:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n763:   }\n764: \n765:   const files = [];\n766:   if (templateOnly || oldText === composed) {\n767:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n768:   } else {\n769:     files.push({\n770:       path: rootFile,\n771:       action: oldText === null ? 'create' : 'replace',\n772:       content: composed,\n773:       before: oldText,\n774:     });\n775:   }\n776: \n777:   // The router gains the shipped rows it is missing, or is created from them when asked.\n778:   const routerPath = path.join(root, manifest.router_file);\n779:   let routerAction = 'unchanged';\n780:   let routerText = null;\n781:   if (fs.existsSync(routerPath)) {\n782:     const current = fs.readFileSync(routerPath, 'utf8');\n783:     const result = addRouterRows(current, manifest);\n784:     notes.push(...result.notes);\n785:     if (result.text !== current) {\n786:       routerText = result.text;\n787:       routerAction = 'replace';\n788:       if (result.added.trigger > 0 || result.added.index > 0) {\n789:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n790:       }\n791:     }\n792:   } else if (createRouter) {\n793:     routerText = renderRouter(manifest);\n794:     routerAction = 'create';\n795:   } else {\n796:     routerAction = 'absent';\n797:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n798:   }\n799:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n800: \n801:   // The Cursor mirror exists exactly when the block carries something, because an empty\n802:   // block has nothing a runtime that cannot read past the prefix would miss.\n803:   const mirrorPath = path.join(root, MIRROR_FILE);\n804:   const mirrorExists = fs.existsSync(mirrorPath);\n805:   let mirrorAction = 'unchanged';\n806:   let mirrorText = null;\n807:   if (blockText !== '') {\n808:     mirrorText = renderMirror(markers, blockText);\n809:     if (!mirrorExists) mirrorAction = 'create';\n810:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n811:   } else if (mirrorExists) {\n812:     mirrorAction = 'remove';\n813:   }\n814:   if (mirrorAction !== 'unchanged') {\n815:     files.push({\n816:       path: MIRROR_FILE,\n817:       action: mirrorAction,\n818:       content: mirrorText,\n819:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n820:     });\n821:   }\n822: \n823:   for (const copy of removedCopies) {\n824:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n825:   }\n826: \n827:   const composition = {\n828:     root,\n829:     state: report.state,\n830:     report,\n831:     markers,\n832:     rootFile,\n833:     oldText,\n834:     composed,\n835:     block: { text: renderBlock(markers, blockText), body: blockText },\n836:     chunks,\n837:     removedCopies,\n838:     notes,\n839:     files,\n840:     budget: {\n841:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n842:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n843:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n844:     },\n845:     ledger: {\n846:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n847:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n848:       shippedReplaced: manifest.sections.length,\n849:       dropped: 0,\n850:     },\n851:   };\n852: \n853:   // What the run would put on disk, which is exactly the three actions a target can take.\n854:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n855:   return composition;\n856: }\n857: \n858: // ─────────────────────────────────────────────────────────────────────────────\n859: // 11. THE WRITE ALLOWLIST\n860: // ─────────────────────────────────────────────────────────────────────────────\n861: \n862: /**\n863:  * Resolve one path a run wants to touch, or refuse it.\n864:  *\n865:  * Containment is checked before membership, so a path that climbs out of the root is\n866:  * reported as what it is rather than as a missing allowlist entry.\n867:  *\n868:  * @param {string} root\n869:  * @param {string} relative\n870:  * @returns {string} the absolute path\n871:  */\n872: function assertWritable(root, relative) {\n873:   const base = path.resolve(root);\n874:   const normalized = String(relative).split(path.sep).join('/');\n875:   const absolute = path.resolve(base, normalized);\n876:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n877:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n878:   }\n879:   if (!ALLOWLIST.includes(normalized)) {\n880:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n881:   }\n882:   // Every path a run reaches must sit inside the root where the root really is, not only\n883:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n884:   const realBase = fs.realpathSync(base);\n885:   const realTarget = resolveThroughLinks(absolute);\n886:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n887:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n888:   }\n889:   return absolute;\n890: }\n891: \n892: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n893: // and the rest of the name is appended to it.\n894: function resolveThroughLinks(absolute) {\n895:   try {\n896:     return fs.realpathSync(absolute);\n897:   } catch {\n898:     const parent = path.dirname(absolute);\n899:     if (parent === absolute) return absolute;\n900:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n901:   }\n902: }\n903: \n904: // ─────────────────────────────────────────────────────────────────────────────\n905: // 12. BACKUPS\n906: // ─────────────────────────────────────────────────────────────────────────────\n907: \n908: function utcStamp(date = new Date()) {\n909:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n910: }\n911: \n912: /**\n913:  * The directory a plan's backup sits in, named after the plan digest.\n914:  *\n915:  * Named by the digest rather than by a clock reading because apply has to land exactly\n916:  * where the plan pointed and the digest is the only thing the operator carries across. The\n917:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n918:  * taken and moves to the next ordinal instead of writing beside it.\n919:  *\n920:  * @param {string} base\n921:  * @param {string} digest\n922:  * @returns {string}\n923:  */\n924: function backupDirectoryOf(base, digest) {\n925:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n926: }\n927: \n928: /**\n929:  * Where a run's backup goes, without creating anything.\n930:  *\n931:  * The output directory is used only when git ignores it, because a backup inside a tracked\n932:  * path is a backup the next commit publishes. Everything else leaves the repository.\n933:  *\n934:  * @param {{root: string}} input\n935:  * @returns {{dir: string, fallback: boolean, reason: string}}\n936:  */\n937: function backupBase({ root }) {\n938:   const candidate = path.join(root, BACKUP_DIR);\n939:   // The question is the one the run depends on: would a plan directory under this one be\n940:   // published by the next commit? Asking about the base alone would miss a rule written as\n941:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n942:   // the probe is a path of the same shape as the one the plan takes.\n943:   const probe = path.join(candidate, 'probe');\n944:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n945:     encoding: 'utf8',\n946:     timeout: TOOL_TIMEOUT_MS,\n947:   });\n948:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n949:   const reason = ignored.status === 1\n950:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n951:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n952:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n953: }\n954: \n955: /**\n956:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n957:  * that says both.\n958:  *\n959:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n960:  * suffixed into a second name, because the printed undo command would then point at that\n961:  * run's bytes; the next ordinal is a different plan with a different digest and a\n962:  * directory of its own.\n963:  *\n964:  * @param {Object} composition\n965:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n966:  */\n967: function planFor(composition) {\n968:   const base = backupBase({ root: composition.root });\n969:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n970:     const digest = planDigest(composition, { ordinal, base: base.dir });\n971:     const dir = backupDirectoryOf(base.dir, digest);\n972:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n973:   }\n974:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n975: }\n976: \n977: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n978: // only these, so on a record the run wrote, a folder that was there before the run is never\n979: // taken away with it.\n980: function missingParents(root, relative) {\n981:   const missing = [];\n982:   let dir = path.posix.dirname(relative);\n983:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n984:     missing.push(dir);\n985:     dir = path.posix.dirname(dir);\n986:   }\n987:   return missing;\n988: }\n989: \n990: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n991: // entry's own allowlisted path; the list stops at the first one that is not.\n992: function recordedCreatedDirs(entry) {\n993:   const dirs = [];\n994:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n995:   for (const dir of entry.createdDirs) {\n996:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n997:     dirs.push(dir);\n998:   }\n999:   return dirs;\n1000: }\n1001: \n1002: // Runs after every file is back, because two new files can share one new folder. Only the\n1003: // folders above a file this restore just deleted are considered, and only an empty one is\n1004: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1005: // file the run created.\n1006: function removeCreatedDirs(root, entries, deleted) {\n1007:   const removed = [];\n1008:   for (const entry of entries) {\n1009:     if (!deleted.has(entry.path)) continue;\n1010:     for (const dir of recordedCreatedDirs(entry)) {\n1011:       const absolute = path.join(root, dir);\n1012:       let names;\n1013:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1014:       if (names.length > 0) break;\n1015:       fs.rmdirSync(absolute);\n1016:       removed.push(dir);\n1017:     }\n1018:   }\n1019:   return removed;\n1020: }\n1021: \n1022: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1023: // copy rather than a reconstruction.\n1024: function backupEntry(root, file) {\n1025:   const absolute = path.join(root, file.path);\n1026:   const exists = fs.existsSync(absolute);\n1027:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1028:   if (!exists) {\n1029:     entry.createdDirs = missingParents(root, file.path);\n1030:     return entry;\n1031:   }\n1032:   const stats = fs.lstatSync(absolute);\n1033:   entry.mode = stats.mode.toString(8).slice(-4);\n1034:   entry.symlink = stats.isSymbolicLink();\n1035:   const bytes = fs.readFileSync(absolute);\n1036:   entry.sha256 = sha256(bytes.toString('utf8'));\n1037:   entry.backup = path.posix.join('files', file.path);\n1038:   return entry;\n1039: }\n1040: \n1041: function writeBackup({ root, manifest, composition, plan }) {\n1042:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1043:   // finishing first: writing beside its record would make the undo ambiguous.\n1044:   if (fs.existsSync(plan.dir)) {\n1045:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1046:   }\n1047:   fs.mkdirSync(plan.dir, { recursive: true });\n1048: \n1049:   const entries = [];\n1050:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n1051:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1052:   // would touch it, even though this engine composes nothing for it.\n1053:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1054:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1055:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1056:   }\n1057: \n1058:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1059:   // the rollback must not share a path with the writer it exists to undo.\n1060:   for (const entry of entries) {\n1061:     if (!entry.existed) continue;\n1062:     const destination = path.join(plan.dir, entry.backup);\n[Output truncated. Continue reading with offset: 1063]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794545754037,"end":1794545754398}}}}
