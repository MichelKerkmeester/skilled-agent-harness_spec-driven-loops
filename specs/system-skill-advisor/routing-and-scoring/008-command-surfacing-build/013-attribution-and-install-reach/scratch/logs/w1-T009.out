{"type":"tool_use","timestamp":1794545801530,"sessionID":"ses_e2cbe0f67ffeARtW3ynN5Ce39R","part":{"partID":"prt_1d343d6ca001j1ib1KHaxmNoQJ","sessionID":"ses_e2cbe0f67ffeARtW3ynN5Ce39R","messageID":"msg_1d343cd3f001djUwsX0WCTjt9f","type":"tool","id":"call_a4a377dddfae415cbe252f50","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs","offset":470,"limit":200},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 470-669\n470:   assert.equal(occurrences(composed, 'Run `make verify` and post the result in the release channel before tagging.'), 1);\n471: \n472:   const checked = embed.preservationCheck(original, composed, manifest);\n473:   assert.deepEqual(checked.dropped, []);\n474:   assert.deepEqual(checked.foreign, []);\n475: });\n476: \n477: test('a released body is replaced with no carry', (t) => {\n478:   const dir = composeTree(t, 'stale');\n479:   const applied = planAndApply(dir).applied;\n480:   trackBackup(t, applied.out);\n481:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n482: \n483:   const composed = readInside(dir, manifest.root_file);\n484:   const current = manifest.derived.sections['operational-mandates'].body;\n485:   assert.ok(composed.includes(current), 'the current body replaced the released one');\n486:   assert.ok(!composed.includes('### Carried from operational-mandates'), 'nothing is carried from a released body');\n487: });\n488: \n489: // A block is the repository's block wherever it sits. Left above the point a rewrite cuts, its\n490: // content is the first thing a replacement loses, and every shipped section below it is\n491: // invisible, so the rewrite would duplicate them into the block instead of recognising them.\n492: test('a block placed between shipped sections is carried into the block at the end', (t) => {\n493:   const dir = composeTree(t, 'adopted');\n494:   const original = moveBlockBefore(readInside(dir, manifest.root_file), '#### The Four Laws');\n495:   writeInside(dir, manifest.root_file, original);\n496:   const carried = 'Our stack is Node 20 with no web framework.';\n497: \n498:   const applied = planAndApply(dir).applied;\n499:   trackBackup(t, applied.out);\n500:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n501:   assert.match(applied.out, /\\(state: adopted\\)/u, 'the sections below the block are recognised as the template\\'s');\n502:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n503: \n504:   const composed = readInside(dir, manifest.root_file);\n505:   assert.equal(occurrences(composed, manifest.markers.start), 1, 'exactly one block survives');\n506:   const block = blockIn(composed);\n507:   assert.equal(occurrences(block, carried), 1, 'the block content moved into the one block at the end');\n508:   assert.equal(occurrences(composed, carried), 1, 'it is not also left where it was');\n509:   for (const id of ['four-laws', 's2-mandatory-gates', 'operational-mandates']) {\n510:     assert.equal(occurrences(composed, manifest.derived.sections[id].body), 1, `the shipped body ${id} appears once, below the block`);\n511:   }\n512: \n513:   const checked = embed.preservationCheck(original, composed, manifest);\n514:   assert.deepEqual(checked.dropped, []);\n515:   assert.deepEqual(checked.foreign, []);\n516: });\n517: \n518: // The end marker is not the end of the file. A line typed below it is the repository's own,\n519: // and a rewrite that keeps only the block and the shipped sections drops it silently.\n520: test('a line after the end marker is carried into the block', (t) => {\n521:   const dir = composeTree(t, 'adopted');\n522:   const line = 'Ship the release note in the same commit as the tag.';\n523:   const original = `${readInside(dir, manifest.root_file)}${line}\\n`;\n524:   writeInside(dir, manifest.root_file, original);\n525: \n526:   const applied = planAndApply(dir).applied;\n527:   trackBackup(t, applied.out);\n528:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n529:   assert.match(applied.out, /dropped 0/u);\n530: \n531:   const composed = readInside(dir, manifest.root_file);\n532:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n533:   assert.equal(occurrences(composed, line), 1, 'it is not also left below the block');\n534: \n535:   const checked = embed.preservationCheck(original, composed, manifest);\n536:   assert.deepEqual(checked.dropped, []);\n537:   assert.deepEqual(checked.foreign, []);\n538: });\n539: \n540: // Text above the first heading belongs to no section, so nothing but the block can keep it.\n541: // Carried nowhere, it is gone at the first rewrite while the document still reads as pure.\n542: test('text before the first heading is carried into the block', (t) => {\n543:   const dir = composeTree(t, 'pure');\n544:   const line = 'Read me first.';\n545:   const original = `${line}\\n${readInside(dir, manifest.root_file)}`;\n546:   writeInside(dir, manifest.root_file, original);\n547: \n548:   const applied = planAndApply(dir).applied;\n549:   trackBackup(t, applied.out);\n550:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n551:   assert.match(applied.out, /\\(state: forked\\)/u, 'the text above the template is repository content, not a pure template');\n552:   assert.match(applied.out, /dropped 0/u);\n553: \n554:   const composed = readInside(dir, manifest.root_file);\n555:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n556:   assert.equal(occurrences(composed, line), 1, 'it is not also left above the template');\n557: \n558:   const checked = embed.preservationCheck(original, composed, manifest);\n559:   assert.deepEqual(checked.dropped, []);\n560:   assert.deepEqual(checked.foreign, []);\n561: \n562:   // The proof has to miss it too, or the next composition that drops the prelude ends in\n563:   // the same silence: the line is gone and nothing was named.\n564:   const lost = embed.preservationCheck(original, composed.replace(`${line}\\n`, ''), manifest);\n565:   assert.ok(lost.dropped.some((entry) => entry.line === line), `the proof counts the text above the template as repository content: ${JSON.stringify(lost.dropped)}`);\n566: });\n567: \n568: // ─────────────────────────────────────────────────────────────────────────────\n569: // 10. THE PROOF, AND WHAT HAPPENS WHEN IT FAILS\n570: // ─────────────────────────────────────────────────────────────────────────────\n571: \n572: // The seam stands in for a writer that loses a line: the composition is intact, the\n573: // digest matches, and the bytes that reach the disk are one line short. Only the\n574: // post-write proof can catch that, which is exactly what it exists for.\n575: function dropALineOnWrite(captured) {\n576:   return (file, content) => {\n577:     const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n578:     const text = bytes.toString('utf8');\n579:     const written = file.endsWith(manifest.root_file)\n580:       ? text.replace('- Never commit a generated file.\\n', '')\n581:       : text;\n582:     captured.push({ file, dropped: written !== text });\n583:     fs.writeFileSync(file, written, 'utf8');\n584:   };\n585: }\n586: \n587: test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:   const dir = composeTree(t, 'foreign');\n589:   const original = readInside(dir, manifest.root_file);\n590:   const out = [];\n591:   const written = [];\n592:   const hooks = {\n593:     log: (line) => out.push(line),\n594:     warn: (line) => out.push(line),\n595:     write: dropALineOnWrite(written),\n596:   };\n597: \n598:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n599:   const digest = field(out.join('\\n'), 'plan-digest');\n600:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n601:   out.length = 0;\n602: \n603:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n604:   const text = out.join('\\n');\n605:   trackBackup(t, text);\n606: \n607:   assert.equal(code, 1, 'a drop is a failed run');\n608:   assert.ok(written.some((entry) => entry.dropped), 'the seam lost a line on the way to the disk');\n609:   assert.match(text, /STATUS=FAIL/u);\n610:   assert.match(text, /- Never commit a generated file\\./u, 'the dropped line is printed');\n611:   assert.match(text, /restored/u);\n612:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n613: });\n614: \n615: test('restore puts every recorded file back byte for byte', (t) => {\n616:   const dir = composeTree(t, 'foreign');\n617:   const before = treeDigest(dir);\n618: \n619:   const applied = planAndApply(dir).applied;\n620:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n621:   const backup = trackBackup(t, applied.out);\n622:   assert.ok(fs.existsSync(backup), 'the backup exists after the run');\n623:   assert.ok(treeDigest(dir) !== before, 'the run changed the tree');\n624: \n625:   const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n626:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n627:   assert.match(restored.out, /restore: /u);\n628:   assert.equal(treeDigest(dir), before, 'every recorded file is byte-identical to its backup');\n629:   assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n630: });\n631: \n632: test('restore recreates a removed file and deletes a file the run created', (t) => {\n633:   const dir = composeTree(t, 'claude-only');\n634:   const claude = readInside(dir, 'CLAUDE.md');\n635:   const applied = planAndApply(dir).applied;\n636:   const backup = trackBackup(t, applied.out);\n637:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n638:   assert.equal(existsInside(dir, 'CLAUDE.md'), false, 'the folded copy is gone');\n639:   assert.equal(existsInside(dir, manifest.root_file), true, 'the root document was created');\n640: \n641:   const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n642:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n643:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n644:   assert.equal(existsInside(dir, manifest.root_file), false, 'the created file is removed again');\n645: });\n646: \n647: test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n648:   const fresh = composeTree(t, 'claude-only');\n649:   const freshApplied = planAndApply(fresh).applied;\n650:   assert.equal(freshApplied.code, 0, `${freshApplied.err}${freshApplied.out}`);\n651:   const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n652:   assert.equal(freshRestored.code, 0, `${freshRestored.err}${freshRestored.out}`);\n653:   assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n654: \n655:   const kept = composeTree(t, 'claude-only');\n656:   fs.mkdirSync(path.join(kept, '.cursor'));\n657:   const keptApplied = planAndApply(kept).applied;\n658:   assert.equal(keptApplied.code, 0, `${keptApplied.err}${keptApplied.out}`);\n659:   const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n660:   assert.equal(keptRestored.code, 0, `${keptRestored.err}${keptRestored.out}`);\n661:   assert.equal(existsInside(kept, '.cursor'), true, 'an empty folder that predates the run stays');\n662:   assert.equal(existsInside(kept, '.cursor/rules'), false, 'the folder the run made inside it is gone');\n663: });\n664: \n665: test('restore refuses a record whose root is not the one it runs against', (t) => {\n666:   const dir = composeTree(t, 'foreign');\n667:   const applied = planAndApply(dir).applied;\n668:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n669:   const backup = trackBackup(t, applied.out);\n[Output truncated. Continue reading with offset: 670]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 470-669\n470:   assert.equal(occurrences(composed, 'Run `make verify` and post the result in the release channel before tagging.'), 1);\n471: \n472:   const checked = embed.preservationCheck(original, composed, manifest);\n473:   assert.deepEqual(checked.dropped, []);\n474:   assert.deepEqual(checked.foreign, []);\n475: });\n476: \n477: test('a released body is replaced with no carry', (t) => {\n478:   const dir = composeTree(t, 'stale');\n479:   const applied = planAndApply(dir).applied;\n480:   trackBackup(t, applied.out);\n481:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n482: \n483:   const composed = readInside(dir, manifest.root_file);\n484:   const current = manifest.derived.sections['operational-mandates'].body;\n485:   assert.ok(composed.includes(current), 'the current body replaced the released one');\n486:   assert.ok(!composed.includes('### Carried from operational-mandates'), 'nothing is carried from a released body');\n487: });\n488: \n489: // A block is the repository's block wherever it sits. Left above the point a rewrite cuts, its\n490: // content is the first thing a replacement loses, and every shipped section below it is\n491: // invisible, so the rewrite would duplicate them into the block instead of recognising them.\n492: test('a block placed between shipped sections is carried into the block at the end', (t) => {\n493:   const dir = composeTree(t, 'adopted');\n494:   const original = moveBlockBefore(readInside(dir, manifest.root_file), '#### The Four Laws');\n495:   writeInside(dir, manifest.root_file, original);\n496:   const carried = 'Our stack is Node 20 with no web framework.';\n497: \n498:   const applied = planAndApply(dir).applied;\n499:   trackBackup(t, applied.out);\n500:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n501:   assert.match(applied.out, /\\(state: adopted\\)/u, 'the sections below the block are recognised as the template\\'s');\n502:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n503: \n504:   const composed = readInside(dir, manifest.root_file);\n505:   assert.equal(occurrences(composed, manifest.markers.start), 1, 'exactly one block survives');\n506:   const block = blockIn(composed);\n507:   assert.equal(occurrences(block, carried), 1, 'the block content moved into the one block at the end');\n508:   assert.equal(occurrences(composed, carried), 1, 'it is not also left where it was');\n509:   for (const id of ['four-laws', 's2-mandatory-gates', 'operational-mandates']) {\n510:     assert.equal(occurrences(composed, manifest.derived.sections[id].body), 1, `the shipped body ${id} appears once, below the block`);\n511:   }\n512: \n513:   const checked = embed.preservationCheck(original, composed, manifest);\n514:   assert.deepEqual(checked.dropped, []);\n515:   assert.deepEqual(checked.foreign, []);\n516: });\n517: \n518: // The end marker is not the end of the file. A line typed below it is the repository's own,\n519: // and a rewrite that keeps only the block and the shipped sections drops it silently.\n520: test('a line after the end marker is carried into the block', (t) => {\n521:   const dir = composeTree(t, 'adopted');\n522:   const line = 'Ship the release note in the same commit as the tag.';\n523:   const original = `${readInside(dir, manifest.root_file)}${line}\\n`;\n524:   writeInside(dir, manifest.root_file, original);\n525: \n526:   const applied = planAndApply(dir).applied;\n527:   trackBackup(t, applied.out);\n528:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n529:   assert.match(applied.out, /dropped 0/u);\n530: \n531:   const composed = readInside(dir, manifest.root_file);\n532:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n533:   assert.equal(occurrences(composed, line), 1, 'it is not also left below the block');\n534: \n535:   const checked = embed.preservationCheck(original, composed, manifest);\n536:   assert.deepEqual(checked.dropped, []);\n537:   assert.deepEqual(checked.foreign, []);\n538: });\n539: \n540: // Text above the first heading belongs to no section, so nothing but the block can keep it.\n541: // Carried nowhere, it is gone at the first rewrite while the document still reads as pure.\n542: test('text before the first heading is carried into the block', (t) => {\n543:   const dir = composeTree(t, 'pure');\n544:   const line = 'Read me first.';\n545:   const original = `${line}\\n${readInside(dir, manifest.root_file)}`;\n546:   writeInside(dir, manifest.root_file, original);\n547: \n548:   const applied = planAndApply(dir).applied;\n549:   trackBackup(t, applied.out);\n550:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n551:   assert.match(applied.out, /\\(state: forked\\)/u, 'the text above the template is repository content, not a pure template');\n552:   assert.match(applied.out, /dropped 0/u);\n553: \n554:   const composed = readInside(dir, manifest.root_file);\n555:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n556:   assert.equal(occurrences(composed, line), 1, 'it is not also left above the template');\n557: \n558:   const checked = embed.preservationCheck(original, composed, manifest);\n559:   assert.deepEqual(checked.dropped, []);\n560:   assert.deepEqual(checked.foreign, []);\n561: \n562:   // The proof has to miss it too, or the next composition that drops the prelude ends in\n563:   // the same silence: the line is gone and nothing was named.\n564:   const lost = embed.preservationCheck(original, composed.replace(`${line}\\n`, ''), manifest);\n565:   assert.ok(lost.dropped.some((entry) => entry.line === line), `the proof counts the text above the template as repository content: ${JSON.stringify(lost.dropped)}`);\n566: });\n567: \n568: // ─────────────────────────────────────────────────────────────────────────────\n569: // 10. THE PROOF, AND WHAT HAPPENS WHEN IT FAILS\n570: // ─────────────────────────────────────────────────────────────────────────────\n571: \n572: // The seam stands in for a writer that loses a line: the composition is intact, the\n573: // digest matches, and the bytes that reach the disk are one line short. Only the\n574: // post-write proof can catch that, which is exactly what it exists for.\n575: function dropALineOnWrite(captured) {\n576:   return (file, content) => {\n577:     const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n578:     const text = bytes.toString('utf8');\n579:     const written = file.endsWith(manifest.root_file)\n580:       ? text.replace('- Never commit a generated file.\\n', '')\n581:       : text;\n582:     captured.push({ file, dropped: written !== text });\n583:     fs.writeFileSync(file, written, 'utf8');\n584:   };\n585: }\n586: \n587: test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:   const dir = composeTree(t, 'foreign');\n589:   const original = readInside(dir, manifest.root_file);\n590:   const out = [];\n591:   const written = [];\n592:   const hooks = {\n593:     log: (line) => out.push(line),\n594:     warn: (line) => out.push(line),\n595:     write: dropALineOnWrite(written),\n596:   };\n597: \n598:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n599:   const digest = field(out.join('\\n'), 'plan-digest');\n600:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n601:   out.length = 0;\n602: \n603:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n604:   const text = out.join('\\n');\n605:   trackBackup(t, text);\n606: \n607:   assert.equal(code, 1, 'a drop is a failed run');\n608:   assert.ok(written.some((entry) => entry.dropped), 'the seam lost a line on the way to the disk');\n609:   assert.match(text, /STATUS=FAIL/u);\n610:   assert.match(text, /- Never commit a generated file\\./u, 'the dropped line is printed');\n611:   assert.match(text, /restored/u);\n612:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n613: });\n614: \n615: test('restore puts every recorded file back byte for byte', (t) => {\n616:   const dir = composeTree(t, 'foreign');\n617:   const before = treeDigest(dir);\n618: \n619:   const applied = planAndApply(dir).applied;\n620:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n621:   const backup = trackBackup(t, applied.out);\n622:   assert.ok(fs.existsSync(backup), 'the backup exists after the run');\n623:   assert.ok(treeDigest(dir) !== before, 'the run changed the tree');\n624: \n625:   const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n626:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n627:   assert.match(restored.out, /restore: /u);\n628:   assert.equal(treeDigest(dir), before, 'every recorded file is byte-identical to its backup');\n629:   assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n630: });\n631: \n632: test('restore recreates a removed file and deletes a file the run created', (t) => {\n633:   const dir = composeTree(t, 'claude-only');\n634:   const claude = readInside(dir, 'CLAUDE.md');\n635:   const applied = planAndApply(dir).applied;\n636:   const backup = trackBackup(t, applied.out);\n637:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n638:   assert.equal(existsInside(dir, 'CLAUDE.md'), false, 'the folded copy is gone');\n639:   assert.equal(existsInside(dir, manifest.root_file), true, 'the root document was created');\n640: \n641:   const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n642:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n643:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n644:   assert.equal(existsInside(dir, manifest.root_file), false, 'the created file is removed again');\n645: });\n646: \n647: test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n648:   const fresh = composeTree(t, 'claude-only');\n649:   const freshApplied = planAndApply(fresh).applied;\n650:   assert.equal(freshApplied.code, 0, `${freshApplied.err}${freshApplied.out}`);\n651:   const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n652:   assert.equal(freshRestored.code, 0, `${freshRestored.err}${freshRestored.out}`);\n653:   assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n654: \n655:   const kept = composeTree(t, 'claude-only');\n656:   fs.mkdirSync(path.join(kept, '.cursor'));\n657:   const keptApplied = planAndApply(kept).applied;\n658:   assert.equal(keptApplied.code, 0, `${keptApplied.err}${keptApplied.out}`);\n659:   const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n660:   assert.equal(keptRestored.code, 0, `${keptRestored.err}${keptRestored.out}`);\n661:   assert.equal(existsInside(kept, '.cursor'), true, 'an empty folder that predates the run stays');\n662:   assert.equal(existsInside(kept, '.cursor/rules'), false, 'the folder the run made inside it is gone');\n663: });\n664: \n665: test('restore refuses a record whose root is not the one it runs against', (t) => {\n666:   const dir = composeTree(t, 'foreign');\n667:   const applied = planAndApply(dir).applied;\n668:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n669:   const backup = trackBackup(t, applied.out);\n[Output truncated. Continue reading with offset: 670]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\",\"offset\":470,\"limit\":200}"},"time":{"start":1794545800906,"end":1794545801530}}}}
