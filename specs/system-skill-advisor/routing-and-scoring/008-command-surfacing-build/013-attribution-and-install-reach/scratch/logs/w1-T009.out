{"type":"tool_use","timestamp":1794545859436,"sessionID":"ses_e2cbe0f67ffeARtW3ynN5Ce39R","part":{"partID":"prt_1d344b93a0019Pz8uJyM844VBM","sessionID":"ses_e2cbe0f67ffeARtW3ynN5Ce39R","messageID":"msg_1d3448942001or5YErF37D1Xoj","type":"tool","id":"call_396e3478fe9b4da782d62698","tool":"read","state":{"status":"completed","input":{"offset":1063,"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1063-1583\n1063:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1064:     fs.copyFileSync(path.join(root, entry.path), destination);\n1065:   }\n1066: \n1067:   const record = {\n1068:     schema: 1,\n1069:     root,\n1070:     created_at: utcStamp(),\n1071:     plan_digest: plan.digest,\n1072:     paths: entries,\n1073:   };\n1074:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1075:   return record;\n1076: }\n1077: \n1078: // ─────────────────────────────────────────────────────────────────────────────\n1079: // 13. THE DIFF\n1080: // ─────────────────────────────────────────────────────────────────────────────\n1081: \n1082: function diffLines(text) {\n1083:   if (text === null) return [];\n1084:   const lines = String(text).split('\\n');\n1085:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1086:   return lines;\n1087: }\n1088: \n1089: function diffOps(left, right) {\n1090:   const rows = left.length + 1;\n1091:   const columns = right.length + 1;\n1092:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1093:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1094:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1095:       table[i][j] = left[i] === right[j]\n1096:         ? table[i + 1][j + 1] + 1\n1097:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1098:     }\n1099:   }\n1100:   const ops = [];\n1101:   let i = 0;\n1102:   let j = 0;\n1103:   while (i < left.length && j < right.length) {\n1104:     if (left[i] === right[j]) {\n1105:       ops.push({ kind: ' ', text: left[i] });\n1106:       i += 1;\n1107:       j += 1;\n1108:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1109:       ops.push({ kind: '-', text: left[i] });\n1110:       i += 1;\n1111:     } else {\n1112:       ops.push({ kind: '+', text: right[j] });\n1113:       j += 1;\n1114:     }\n1115:   }\n1116:   while (i < left.length) {\n1117:     ops.push({ kind: '-', text: left[i] });\n1118:     i += 1;\n1119:   }\n1120:   while (j < right.length) {\n1121:     ops.push({ kind: '+', text: right[j] });\n1122:     j += 1;\n1123:   }\n1124:   return ops;\n1125: }\n1126: \n1127: /**\n1128:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1129:  *\n1130:  * @param {string|null} beforeText\n1131:  * @param {string|null} afterText\n1132:  * @param {string} relative\n1133:  * @returns {string[]}\n1134:  */\n1135: function unifiedDiff(beforeText, afterText, relative) {\n1136:   const left = diffLines(beforeText);\n1137:   const right = diffLines(afterText);\n1138:   const ops = diffOps(left, right);\n1139:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1140: \n1141:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1142:   const hunks = [];\n1143:   for (const index of changed) {\n1144:     const start = Math.max(0, index - 3);\n1145:     const end = Math.min(ops.length, index + 4);\n1146:     const last = hunks[hunks.length - 1];\n1147:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1148:     else hunks.push({ start, end });\n1149:   }\n1150: \n1151:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1152:   let consumed = 0;\n1153:   for (const hunk of hunks) {\n1154:     // A create has no left side and a removal has no right side, so their cursors start at\n1155:     // zero rather than at the first line of a file that is not there.\n1156:     let leftCursor = beforeText === null ? 0 : 1;\n1157:     let rightCursor = afterText === null ? 0 : 1;\n1158:     for (let index = 0; index < hunk.start; index += 1) {\n1159:       if (ops[index].kind !== '+') leftCursor += 1;\n1160:       if (ops[index].kind !== '-') rightCursor += 1;\n1161:     }\n1162:     const slice = ops.slice(hunk.start, hunk.end);\n1163:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1164:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1165:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1166:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1167:     consumed += slice.length;\n1168:   }\n1169:   return consumed === 0 ? [] : output;\n1170: }\n1171: \n1172: // ─────────────────────────────────────────────────────────────────────────────\n1173: // 14. THE PLAN\n1174: // ─────────────────────────────────────────────────────────────────────────────\n1175: \n1176: function renderTargets(composition) {\n1177:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1178: }\n1179: \n1180: function renderPlan(composition, plan) {\n1181:   const lines = [];\n1182:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1183:   lines.push(...renderTargets(composition));\n1184:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1185: \n1186:   for (const file of composition.writes) {\n1187:     if (file.action === 'remove') {\n1188:       lines.push(`diff ${file.path}:`);\n1189:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1190:       continue;\n1191:     }\n1192:     const diff = unifiedDiff(file.before, file.content, file.path);\n1193:     lines.push(`diff ${file.path}:`);\n1194:     if (diff.length === 0) lines.push('  (no line changes)');\n1195:     lines.push(...diff);\n1196:   }\n1197: \n1198:   lines.push('block:');\n1199:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1200:   lines.push('block-end:');\n1201: \n1202:   const { before, after, limits } = composition.budget;\n1203:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1204:   if (after.total > limits.total) {\n1205:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1206:   }\n1207:   if (after.prefix > limits.prefix) {\n1208:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1209:   }\n1210: \n1211:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1212:   lines.push(`backup: ${plan.dir}`);\n1213:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1214:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1215:   lines.push(`plan-digest: ${plan.digest}`);\n1216:   return lines;\n1217: }\n1218: \n1219: function renderDropped(dropped) {\n1220:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1221: }\n1222: \n1223: // ─────────────────────────────────────────────────────────────────────────────\n1224: // 15. PLAN\n1225: // ─────────────────────────────────────────────────────────────────────────────\n1226: \n1227: function preflight(composition, manifest) {\n1228:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1229: }\n1230: \n1231: function commandPlan(options, output, hooks) {\n1232:   const manifest = loadManifest();\n1233:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1234: \n1235:   const checked = preflight(composition, manifest);\n1236:   composition.ledger.dropped = checked.dropped.length;\n1237: \n1238:   if (composition.writes.length === 0) {\n1239:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1240:     for (const note of composition.notes) output.log(`note: ${note}`);\n1241:     output.log('NOTHING TO DO');\n1242:     return 0;\n1243:   }\n1244: \n1245:   const plan = planFor(composition);\n1246:   for (const line of renderPlan(composition, plan)) output.log(line);\n1247:   if (checked.dropped.length > 0) {\n1248:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1249:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1250:     output.warn('STATUS=FAIL');\n1251:     return 1;\n1252:   }\n1253:   if (options.dryRun) output.log('dry-run: nothing was written');\n1254:   return 0;\n1255: }\n1256: \n1257: // ─────────────────────────────────────────────────────────────────────────────\n1258: // 16. APPLY\n1259: // ─────────────────────────────────────────────────────────────────────────────\n1260: \n1261: function runTool(script, args) {\n1262:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1263:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1264:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1265:   return { code: result.status, output };\n1266: }\n1267: \n1268: function restoreFromBackup({ root, dir, output }) {\n1269:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1270:   let restored = 0;\n1271:   const deleted = new Set();\n1272:   for (const entry of record.paths) {\n1273:     const target = path.join(root, entry.path);\n1274:     if (!entry.existed) {\n1275:       if (fs.existsSync(target)) {\n1276:         fs.rmSync(target);\n1277:         deleted.add(entry.path);\n1278:       }\n1279:       continue;\n1280:     }\n1281:     const source = path.join(dir, entry.backup);\n1282:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1283:     fs.copyFileSync(source, target);\n1284:     restored += 1;\n1285:   }\n1286:   removeCreatedDirs(root, record.paths, deleted);\n1287:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1288:   return restored;\n1289: }\n1290: \n1291: function commandApply(options, output, hooks) {\n1292:   if (!options.digest) {\n1293:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1294:     return 2;\n1295:   }\n1296: \n1297:   const manifest = loadManifest();\n1298:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1299: \n1300:   // A tree already in its target state has nothing a digest could authorise.\n1301:   if (composition.writes.length === 0) {\n1302:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1303:     output.log('NOTHING TO DO');\n1304:     return 0;\n1305:   }\n1306: \n1307:   const plan = planFor(composition);\n1308:   if (plan.digest !== options.digest) {\n1309:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1310:     // already happened gets told which directory holds those bytes instead of a claim\n1311:     // about the tree that would be false.\n1312:     const held = backupDirectoryOf(plan.base, options.digest);\n1313:     if (fs.existsSync(held)) {\n1314:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1315:       return 2;\n1316:     }\n1317:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1318:     return 2;\n1319:   }\n1320: \n1321:   // The same proof the plan ran, because a composition that already loses a line must\n1322:   // never reach a backup, let alone the tree.\n1323:   const checked = preflight(composition, manifest);\n1324:   composition.ledger.dropped = checked.dropped.length;\n1325:   if (checked.dropped.length > 0) {\n1326:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1327:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1328:     output.warn('STATUS=FAIL');\n1329:     return 1;\n1330:   }\n1331: \n1332:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1333:   // the run before a backup exists rather than after a partial write.\n1334:   const targets = [];\n1335:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1336: \n1337:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1338:   // here, where every precondition has already passed and nothing has been created.\n1339:   if (options.dryRun) {\n1340:     for (const line of renderPlan(composition, plan)) output.log(line);\n1341:     output.log('dry-run: nothing was written');\n1342:     return 0;\n1343:   }\n1344: \n1345:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1346:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1347: \n1348:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1349:   for (const target of targets) {\n1350:     if (target.file.action === 'remove') {\n1351:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1352:       output.log(`removed ${target.file.path} (backed up first)`);\n1353:       continue;\n1354:     }\n1355:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1356:     write(target.absolute, target.file.content);\n1357:     output.log(`wrote ${target.file.path}`);\n1358:   }\n1359: \n1360:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1361:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1362:   if (rootTouched) {\n1363:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1364:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1365:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1366:   }\n1367:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1368:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1369:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1370:     output.log(`repo-rules: ${summary}`);\n1371:   }\n1372: \n1373:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1374:   const rootPath = path.join(options.root, manifest.root_file);\n1375:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1376:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1377:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1378: \n1379:   if (after.dropped.length > 0) {\n1380:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1381:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1382:     output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1383:     output.warn('STATUS=FAIL');\n1384:     return 1;\n1385:   }\n1386: \n1387:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1388:   if (report !== null) {\n1389:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1390:   }\n1391:   output.log(`backup: ${plan.dir}`);\n1392:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1393:   for (const entry of record.paths) {\n1394:     if (!entry.existed) continue;\n1395:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1396:   }\n1397:   output.log('STATUS=OK');\n1398:   return 0;\n1399: }\n1400: \n1401: // ─────────────────────────────────────────────────────────────────────────────\n1402: // 17. RESTORE\n1403: // ─────────────────────────────────────────────────────────────────────────────\n1404: \n1405: function readConfirmation() {\n1406:   try {\n1407:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1408:   } catch {\n1409:     return '';\n1410:   }\n1411: }\n1412: \n1413: function commandRestore(options, output, hooks) {\n1414:   if (!options.run) {\n1415:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1416:     return 2;\n1417:   }\n1418:   const recordPath = path.join(options.run, 'manifest.json');\n1419:   if (!fs.existsSync(recordPath)) {\n1420:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1421:     return 2;\n1422:   }\n1423: \n1424:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1425:   const root = record.root;\n1426:   // The record names its own root, and a record is data: it is trusted only when it names\n1427:   // the root this restore runs against, so a record repointed at another folder is refused\n1428:   // instead of written to. Restoring another folder takes --root naming that folder.\n1429:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1430:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1431:     return 2;\n1432:   }\n1433:   const steps = [];\n1434:   for (const entry of record.paths) {\n1435:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1436:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1437:     const absolute = assertWritable(root, entry.path);\n1438:     if (!entry.existed) {\n1439:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1440:       continue;\n1441:     }\n1442:     const source = path.join(options.run, entry.backup);\n1443:     if (!fs.existsSync(source)) {\n1444:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1445:       return 2;\n1446:     }\n1447:     const bytes = fs.readFileSync(source);\n1448:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1449:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1450:       return 2;\n1451:     }\n1452:     steps.push({ entry, absolute, action: 'put back', bytes });\n1453:   }\n1454: \n1455:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1456:   for (const step of steps) {\n1457:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1458:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1459:       : '';\n1460:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1461:   }\n1462:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1463:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1464: \n1465:   if (options.dryRun) {\n1466:     output.log('dry-run: nothing was written');\n1467:     return 0;\n1468:   }\n1469: \n1470:   if (!options.yes) {\n1471:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1472:     if (readConfirmation() !== 'yes') {\n1473:       output.log('cancelled: no confirmation, nothing was written');\n1474:       return 1;\n1475:     }\n1476:   }\n1477: \n1478:   let touched = 0;\n1479:   const deleted = new Set();\n1480:   for (const step of steps) {\n1481:     if (step.action === 'delete') {\n1482:       fs.rmSync(step.absolute);\n1483:       deleted.add(step.entry.path);\n1484:       touched += 1;\n1485:       continue;\n1486:     }\n1487:     if (step.action === 'absent') continue;\n1488:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1489:     fs.writeFileSync(step.absolute, step.bytes);\n1490:     touched += 1;\n1491:   }\n1492:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1493: \n1494:   // Byte equality after the write, measured against the recorded hash rather than against\n1495:   // the copy that was just read.\n1496:   for (const step of steps) {\n1497:     if (step.action === 'delete' || step.action === 'absent') continue;\n1498:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1499:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1500:       output.warn('STATUS=FAIL');\n1501:       return 1;\n1502:     }\n1503:   }\n1504: \n1505:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1506:   output.log('STATUS=OK');\n1507:   return 0;\n1508: }\n1509: \n1510: // ─────────────────────────────────────────────────────────────────────────────\n1511: // 18. MAIN\n1512: // ─────────────────────────────────────────────────────────────────────────────\n1513: \n1514: function outputOf(hooks) {\n1515:   return {\n1516:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1517:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1518:   };\n1519: }\n1520: \n1521: /**\n1522:  * @param {string[]} argv\n1523:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1524:  * @returns {number} the process exit code\n1525:  */\n1526: function main(argv, hooks = {}) {\n1527:   const options = parseArgs(argv);\n1528:   const output = outputOf(hooks);\n1529:   if (options.help) {\n1530:     output.log(USAGE);\n1531:     return 0;\n1532:   }\n1533:   if (options.command === null) {\n1534:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1535:     return 2;\n1536:   }\n1537:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1538:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1539:     return 2;\n1540:   }\n1541: \n1542:   try {\n1543:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1544:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1545:     return commandRestore(options, output, hooks);\n1546:   } catch (error) {\n1547:     if (error instanceof AllowlistError) {\n1548:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1549:       return 2;\n1550:     }\n1551:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1552:       output.warn(`${TAG} ERROR: ${error.message}`);\n1553:       if (error instanceof UsageError) output.warn(USAGE);\n1554:       return 2;\n1555:     }\n1556:     throw error;\n1557:   }\n1558: }\n1559: \n1560: if (require.main === module) {\n1561:   try {\n1562:     process.exitCode = main(process.argv.slice(2));\n1563:   } catch (error) {\n1564:     console.error(`${TAG} ERROR: ${error.message}`);\n1565:     process.exitCode = 2;\n1566:   }\n1567: }\n1568: \n1569: module.exports = {\n1570:   ALLOWLIST,\n1571:   MANIFEST_PATH,\n1572:   addRouterRows,\n1573:   assertWritable,\n1574:   backupBase,\n1575:   compose,\n1576:   main,\n1577:   planDigest,\n1578:   planFor,\n1579:   preservationCheck,\n1580:   renderBlock,\n1581:   renderMirror,\n1582:   renderRouter,\n1583: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1063-1583\n1063:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1064:     fs.copyFileSync(path.join(root, entry.path), destination);\n1065:   }\n1066: \n1067:   const record = {\n1068:     schema: 1,\n1069:     root,\n1070:     created_at: utcStamp(),\n1071:     plan_digest: plan.digest,\n1072:     paths: entries,\n1073:   };\n1074:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1075:   return record;\n1076: }\n1077: \n1078: // ─────────────────────────────────────────────────────────────────────────────\n1079: // 13. THE DIFF\n1080: // ─────────────────────────────────────────────────────────────────────────────\n1081: \n1082: function diffLines(text) {\n1083:   if (text === null) return [];\n1084:   const lines = String(text).split('\\n');\n1085:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1086:   return lines;\n1087: }\n1088: \n1089: function diffOps(left, right) {\n1090:   const rows = left.length + 1;\n1091:   const columns = right.length + 1;\n1092:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1093:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1094:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1095:       table[i][j] = left[i] === right[j]\n1096:         ? table[i + 1][j + 1] + 1\n1097:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1098:     }\n1099:   }\n1100:   const ops = [];\n1101:   let i = 0;\n1102:   let j = 0;\n1103:   while (i < left.length && j < right.length) {\n1104:     if (left[i] === right[j]) {\n1105:       ops.push({ kind: ' ', text: left[i] });\n1106:       i += 1;\n1107:       j += 1;\n1108:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1109:       ops.push({ kind: '-', text: left[i] });\n1110:       i += 1;\n1111:     } else {\n1112:       ops.push({ kind: '+', text: right[j] });\n1113:       j += 1;\n1114:     }\n1115:   }\n1116:   while (i < left.length) {\n1117:     ops.push({ kind: '-', text: left[i] });\n1118:     i += 1;\n1119:   }\n1120:   while (j < right.length) {\n1121:     ops.push({ kind: '+', text: right[j] });\n1122:     j += 1;\n1123:   }\n1124:   return ops;\n1125: }\n1126: \n1127: /**\n1128:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1129:  *\n1130:  * @param {string|null} beforeText\n1131:  * @param {string|null} afterText\n1132:  * @param {string} relative\n1133:  * @returns {string[]}\n1134:  */\n1135: function unifiedDiff(beforeText, afterText, relative) {\n1136:   const left = diffLines(beforeText);\n1137:   const right = diffLines(afterText);\n1138:   const ops = diffOps(left, right);\n1139:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1140: \n1141:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1142:   const hunks = [];\n1143:   for (const index of changed) {\n1144:     const start = Math.max(0, index - 3);\n1145:     const end = Math.min(ops.length, index + 4);\n1146:     const last = hunks[hunks.length - 1];\n1147:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1148:     else hunks.push({ start, end });\n1149:   }\n1150: \n1151:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1152:   let consumed = 0;\n1153:   for (const hunk of hunks) {\n1154:     // A create has no left side and a removal has no right side, so their cursors start at\n1155:     // zero rather than at the first line of a file that is not there.\n1156:     let leftCursor = beforeText === null ? 0 : 1;\n1157:     let rightCursor = afterText === null ? 0 : 1;\n1158:     for (let index = 0; index < hunk.start; index += 1) {\n1159:       if (ops[index].kind !== '+') leftCursor += 1;\n1160:       if (ops[index].kind !== '-') rightCursor += 1;\n1161:     }\n1162:     const slice = ops.slice(hunk.start, hunk.end);\n1163:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1164:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1165:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1166:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1167:     consumed += slice.length;\n1168:   }\n1169:   return consumed === 0 ? [] : output;\n1170: }\n1171: \n1172: // ─────────────────────────────────────────────────────────────────────────────\n1173: // 14. THE PLAN\n1174: // ─────────────────────────────────────────────────────────────────────────────\n1175: \n1176: function renderTargets(composition) {\n1177:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1178: }\n1179: \n1180: function renderPlan(composition, plan) {\n1181:   const lines = [];\n1182:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1183:   lines.push(...renderTargets(composition));\n1184:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1185: \n1186:   for (const file of composition.writes) {\n1187:     if (file.action === 'remove') {\n1188:       lines.push(`diff ${file.path}:`);\n1189:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1190:       continue;\n1191:     }\n1192:     const diff = unifiedDiff(file.before, file.content, file.path);\n1193:     lines.push(`diff ${file.path}:`);\n1194:     if (diff.length === 0) lines.push('  (no line changes)');\n1195:     lines.push(...diff);\n1196:   }\n1197: \n1198:   lines.push('block:');\n1199:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1200:   lines.push('block-end:');\n1201: \n1202:   const { before, after, limits } = composition.budget;\n1203:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1204:   if (after.total > limits.total) {\n1205:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1206:   }\n1207:   if (after.prefix > limits.prefix) {\n1208:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1209:   }\n1210: \n1211:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1212:   lines.push(`backup: ${plan.dir}`);\n1213:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1214:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1215:   lines.push(`plan-digest: ${plan.digest}`);\n1216:   return lines;\n1217: }\n1218: \n1219: function renderDropped(dropped) {\n1220:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1221: }\n1222: \n1223: // ─────────────────────────────────────────────────────────────────────────────\n1224: // 15. PLAN\n1225: // ─────────────────────────────────────────────────────────────────────────────\n1226: \n1227: function preflight(composition, manifest) {\n1228:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1229: }\n1230: \n1231: function commandPlan(options, output, hooks) {\n1232:   const manifest = loadManifest();\n1233:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1234: \n1235:   const checked = preflight(composition, manifest);\n1236:   composition.ledger.dropped = checked.dropped.length;\n1237: \n1238:   if (composition.writes.length === 0) {\n1239:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1240:     for (const note of composition.notes) output.log(`note: ${note}`);\n1241:     output.log('NOTHING TO DO');\n1242:     return 0;\n1243:   }\n1244: \n1245:   const plan = planFor(composition);\n1246:   for (const line of renderPlan(composition, plan)) output.log(line);\n1247:   if (checked.dropped.length > 0) {\n1248:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1249:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1250:     output.warn('STATUS=FAIL');\n1251:     return 1;\n1252:   }\n1253:   if (options.dryRun) output.log('dry-run: nothing was written');\n1254:   return 0;\n1255: }\n1256: \n1257: // ─────────────────────────────────────────────────────────────────────────────\n1258: // 16. APPLY\n1259: // ─────────────────────────────────────────────────────────────────────────────\n1260: \n1261: function runTool(script, args) {\n1262:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1263:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1264:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1265:   return { code: result.status, output };\n1266: }\n1267: \n1268: function restoreFromBackup({ root, dir, output }) {\n1269:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1270:   let restored = 0;\n1271:   const deleted = new Set();\n1272:   for (const entry of record.paths) {\n1273:     const target = path.join(root, entry.path);\n1274:     if (!entry.existed) {\n1275:       if (fs.existsSync(target)) {\n1276:         fs.rmSync(target);\n1277:         deleted.add(entry.path);\n1278:       }\n1279:       continue;\n1280:     }\n1281:     const source = path.join(dir, entry.backup);\n1282:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1283:     fs.copyFileSync(source, target);\n1284:     restored += 1;\n1285:   }\n1286:   removeCreatedDirs(root, record.paths, deleted);\n1287:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1288:   return restored;\n1289: }\n1290: \n1291: function commandApply(options, output, hooks) {\n1292:   if (!options.digest) {\n1293:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1294:     return 2;\n1295:   }\n1296: \n1297:   const manifest = loadManifest();\n1298:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1299: \n1300:   // A tree already in its target state has nothing a digest could authorise.\n1301:   if (composition.writes.length === 0) {\n1302:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1303:     output.log('NOTHING TO DO');\n1304:     return 0;\n1305:   }\n1306: \n1307:   const plan = planFor(composition);\n1308:   if (plan.digest !== options.digest) {\n1309:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1310:     // already happened gets told which directory holds those bytes instead of a claim\n1311:     // about the tree that would be false.\n1312:     const held = backupDirectoryOf(plan.base, options.digest);\n1313:     if (fs.existsSync(held)) {\n1314:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1315:       return 2;\n1316:     }\n1317:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1318:     return 2;\n1319:   }\n1320: \n1321:   // The same proof the plan ran, because a composition that already loses a line must\n1322:   // never reach a backup, let alone the tree.\n1323:   const checked = preflight(composition, manifest);\n1324:   composition.ledger.dropped = checked.dropped.length;\n1325:   if (checked.dropped.length > 0) {\n1326:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1327:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1328:     output.warn('STATUS=FAIL');\n1329:     return 1;\n1330:   }\n1331: \n1332:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1333:   // the run before a backup exists rather than after a partial write.\n1334:   const targets = [];\n1335:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1336: \n1337:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1338:   // here, where every precondition has already passed and nothing has been created.\n1339:   if (options.dryRun) {\n1340:     for (const line of renderPlan(composition, plan)) output.log(line);\n1341:     output.log('dry-run: nothing was written');\n1342:     return 0;\n1343:   }\n1344: \n1345:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1346:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1347: \n1348:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1349:   for (const target of targets) {\n1350:     if (target.file.action === 'remove') {\n1351:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1352:       output.log(`removed ${target.file.path} (backed up first)`);\n1353:       continue;\n1354:     }\n1355:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1356:     write(target.absolute, target.file.content);\n1357:     output.log(`wrote ${target.file.path}`);\n1358:   }\n1359: \n1360:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1361:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1362:   if (rootTouched) {\n1363:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1364:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1365:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1366:   }\n1367:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1368:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1369:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1370:     output.log(`repo-rules: ${summary}`);\n1371:   }\n1372: \n1373:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1374:   const rootPath = path.join(options.root, manifest.root_file);\n1375:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1376:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1377:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1378: \n1379:   if (after.dropped.length > 0) {\n1380:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1381:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1382:     output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1383:     output.warn('STATUS=FAIL');\n1384:     return 1;\n1385:   }\n1386: \n1387:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1388:   if (report !== null) {\n1389:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1390:   }\n1391:   output.log(`backup: ${plan.dir}`);\n1392:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1393:   for (const entry of record.paths) {\n1394:     if (!entry.existed) continue;\n1395:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1396:   }\n1397:   output.log('STATUS=OK');\n1398:   return 0;\n1399: }\n1400: \n1401: // ─────────────────────────────────────────────────────────────────────────────\n1402: // 17. RESTORE\n1403: // ─────────────────────────────────────────────────────────────────────────────\n1404: \n1405: function readConfirmation() {\n1406:   try {\n1407:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1408:   } catch {\n1409:     return '';\n1410:   }\n1411: }\n1412: \n1413: function commandRestore(options, output, hooks) {\n1414:   if (!options.run) {\n1415:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1416:     return 2;\n1417:   }\n1418:   const recordPath = path.join(options.run, 'manifest.json');\n1419:   if (!fs.existsSync(recordPath)) {\n1420:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1421:     return 2;\n1422:   }\n1423: \n1424:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1425:   const root = record.root;\n1426:   // The record names its own root, and a record is data: it is trusted only when it names\n1427:   // the root this restore runs against, so a record repointed at another folder is refused\n1428:   // instead of written to. Restoring another folder takes --root naming that folder.\n1429:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1430:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1431:     return 2;\n1432:   }\n1433:   const steps = [];\n1434:   for (const entry of record.paths) {\n1435:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1436:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1437:     const absolute = assertWritable(root, entry.path);\n1438:     if (!entry.existed) {\n1439:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1440:       continue;\n1441:     }\n1442:     const source = path.join(options.run, entry.backup);\n1443:     if (!fs.existsSync(source)) {\n1444:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1445:       return 2;\n1446:     }\n1447:     const bytes = fs.readFileSync(source);\n1448:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1449:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1450:       return 2;\n1451:     }\n1452:     steps.push({ entry, absolute, action: 'put back', bytes });\n1453:   }\n1454: \n1455:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1456:   for (const step of steps) {\n1457:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1458:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1459:       : '';\n1460:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1461:   }\n1462:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1463:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1464: \n1465:   if (options.dryRun) {\n1466:     output.log('dry-run: nothing was written');\n1467:     return 0;\n1468:   }\n1469: \n1470:   if (!options.yes) {\n1471:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1472:     if (readConfirmation() !== 'yes') {\n1473:       output.log('cancelled: no confirmation, nothing was written');\n1474:       return 1;\n1475:     }\n1476:   }\n1477: \n1478:   let touched = 0;\n1479:   const deleted = new Set();\n1480:   for (const step of steps) {\n1481:     if (step.action === 'delete') {\n1482:       fs.rmSync(step.absolute);\n1483:       deleted.add(step.entry.path);\n1484:       touched += 1;\n1485:       continue;\n1486:     }\n1487:     if (step.action === 'absent') continue;\n1488:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1489:     fs.writeFileSync(step.absolute, step.bytes);\n1490:     touched += 1;\n1491:   }\n1492:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1493: \n1494:   // Byte equality after the write, measured against the recorded hash rather than against\n1495:   // the copy that was just read.\n1496:   for (const step of steps) {\n1497:     if (step.action === 'delete' || step.action === 'absent') continue;\n1498:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1499:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1500:       output.warn('STATUS=FAIL');\n1501:       return 1;\n1502:     }\n1503:   }\n1504: \n1505:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1506:   output.log('STATUS=OK');\n1507:   return 0;\n1508: }\n1509: \n1510: // ─────────────────────────────────────────────────────────────────────────────\n1511: // 18. MAIN\n1512: // ─────────────────────────────────────────────────────────────────────────────\n1513: \n1514: function outputOf(hooks) {\n1515:   return {\n1516:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1517:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1518:   };\n1519: }\n1520: \n1521: /**\n1522:  * @param {string[]} argv\n1523:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1524:  * @returns {number} the process exit code\n1525:  */\n1526: function main(argv, hooks = {}) {\n1527:   const options = parseArgs(argv);\n1528:   const output = outputOf(hooks);\n1529:   if (options.help) {\n1530:     output.log(USAGE);\n1531:     return 0;\n1532:   }\n1533:   if (options.command === null) {\n1534:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1535:     return 2;\n1536:   }\n1537:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1538:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1539:     return 2;\n1540:   }\n1541: \n1542:   try {\n1543:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1544:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1545:     return commandRestore(options, output, hooks);\n1546:   } catch (error) {\n1547:     if (error instanceof AllowlistError) {\n1548:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1549:       return 2;\n1550:     }\n1551:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1552:       output.warn(`${TAG} ERROR: ${error.message}`);\n1553:       if (error instanceof UsageError) output.warn(USAGE);\n1554:       return 2;\n1555:     }\n1556:     throw error;\n1557:   }\n1558: }\n1559: \n1560: if (require.main === module) {\n1561:   try {\n1562:     process.exitCode = main(process.argv.slice(2));\n1563:   } catch (error) {\n1564:     console.error(`${TAG} ERROR: ${error.message}`);\n1565:     process.exitCode = 2;\n1566:   }\n1567: }\n1568: \n1569: module.exports = {\n1570:   ALLOWLIST,\n1571:   MANIFEST_PATH,\n1572:   addRouterRows,\n1573:   assertWritable,\n1574:   backupBase,\n1575:   compose,\n1576:   main,\n1577:   planDigest,\n1578:   planFor,\n1579:   preservationCheck,\n1580:   renderBlock,\n1581:   renderMirror,\n1582:   renderRouter,\n1583: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"offset\":1063,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794545858874,"end":1794545859436}}}}
