w-min-token-length\",\n      \"token\": \"md\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"leg\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"install\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"skilled\"\n    }\n  ],\n  \"indexHash\": \"cac6622b1df8eae3cf5fe37681108fd2e890dfeb637c88211608313d0c4227cd\",\n  \"manifestHash\": \"c243be4138be26b030af5a965ddc587955809ebe6ccd694e69601c9e81a327a8\",\n  \"normalizedQuery\": \"t019 tell the installer about the pointer and the delivery leg install skilled md\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"t019\",\n    \"tell\",\n    \"the\",\n    \"installer\",\n    \"about\",\n    \"pointer\",\n    \"and\",\n    \"delivery\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 249,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"},{"type":"text","text":"Exit code: 1"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"T019 Tell the installer about the pointer and the delivery leg INSTALL-SKILLED.md\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794546178645,"end":1794546180820}}}}
