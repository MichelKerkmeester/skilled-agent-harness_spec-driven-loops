{"type":"tool_use","timestamp":1794546185890,"sessionID":"ses_e2cb7c2a8ffeJgvonzMMJV44b8","part":{"partID":"prt_1d349b537001dhwvuoAgLXDYok","sessionID":"ses_e2cb7c2a8ffeJgvonzMMJV44b8","messageID":"msg_1d3498a0f0019Qj2Wjdkjvxfx2","type":"tool","id":"call_057d137d109947429afb7dfb","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/pi.test.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/pi.test.mjs, lines 1-136\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Reader Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // A Pi session resolves from the live branch when it is the current session,\n5: // and from disk only by an exact header id whose cwd is the caller's project.\n6: // Separator flattening means a project-key collision is possible, so the cwd\n7: // is part of the identity.\n8: \n9: import assert from 'node:assert/strict';\n10: import { appendFileSync, mkdirSync } from 'node:fs';\n11: import { join } from 'node:path';\n12: import { test } from 'node:test';\n13: \n14: import { capabilities, readSession } from '../../session-readers/index.mjs';\n15: import { loadPiSession, piProjectDirectory } from '../../session-readers/pi.mjs';\n16: import { DECOY, piSession, SESSION, T0 } from './fixtures.mjs';\n17: import { withTempAsync } from './helpers.mjs';\n18: \n19: // The head of a live advisor brief, used as the text a harness injects into a\n20: // session through an entry that is not a turn.\n21: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n22: \n23: // The fixtures build store folders with the reader's own key helper, so this\n24: // pins the helper to a folder name a real Pi install wrote.\n25: test('the project folder name matches the one Pi writes', () => {\n26:   assert.equal(\n27:     piProjectDirectory('/Users/michelkerkmeester/MEGA/Development/Skilled'),\n28:     '--Users-michelkerkmeester-MEGA-Development-Skilled--',\n29:   );\n30: });\n31: \n32: test('an older session resolves by header id and matching cwd', async () => {\n33:   await withTempAsync('pi-reader', async (root) => {\n34:     const projectDir = join(root, 'project');\n35:     mkdirSync(projectDir, { recursive: true });\n36:     const fixture = piSession({ root, projectDir });\n37:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n38:     assert.equal(result.ok, true);\n39:     assert.equal(result.source.locatorKind, capabilities.pi.locatorKind);\n40:     assert.equal(result.source.mode, 'disk');\n41:     assert.deepEqual(result.items.map((item) => item.role), ['user', 'assistant', 'toolResult', 'assistant']);\n42:     assert.equal(result.items[2].toolCallId, 'pi-call-1');\n43:   });\n44: });\n45: \n46: test('the current session resolves from the live branch without a disk read', async () => {\n47:   const branch = [\n48:     { type: 'message', id: 'live-u1', timestamp: '2026-11-07T12:00:00.000Z', message: { role: 'user', content: [{ type: 'text', text: 'Hello.' }] } },\n49:     { type: 'message', id: 'live-a1', timestamp: '2026-11-07T12:00:01.000Z', message: { role: 'assistant', content: [{ type: 'text', text: 'Hi.' }] } },\n50:   ];\n51:   const sessionManager = {\n52:     getSessionId: () => SESSION,\n53:     getBranch: () => branch,\n54:     getSessionFile: () => '/live/session.jsonl',\n55:   };\n56:   const result = await readSession({ runtime: 'pi', sessionId: SESSION, sessionManager });\n57:   assert.equal(result.ok, true);\n58:   assert.equal(result.source.locatorKind, capabilities.pi.locatorKind);\n59:   assert.equal(result.source.mode, 'live');\n60:   assert.equal(result.items.length, 2);\n61: });\n62: \n63: test('a project-key collision is rejected by the header cwd', async () => {\n64:   await withTempAsync('pi-collision', async (root) => {\n65:     const projectDir = join(root, 'a', 'b');\n66:     const otherDir = join(root, 'a-b');\n67:     mkdirSync(projectDir, { recursive: true });\n68:     mkdirSync(otherDir, { recursive: true });\n69: \n70:     const fixture = piSession({ root, projectDir, headerCwd: otherDir });\n71:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n72:     assert.equal(result.ok, false);\n73:     assert.equal(result.code, 'session_mismatch');\n74:   });\n75: });\n76: \n77: test('two session files with one id are refused as session_ambiguous', async () => {\n78:   await withTempAsync('pi-ambiguous', async (root) => {\n79:     const projectDir = join(root, 'project');\n80:     mkdirSync(projectDir, { recursive: true });\n81:     const fixture = piSession({ root, projectDir });\n82:     piSession({ root, projectDir, createdAt: T0 - 1000 });\n83:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n84:     assert.equal(result.ok, false);\n85:     assert.equal(result.code, 'session_ambiguous');\n86:   });\n87: });\n88: \n89: test('an absent id is a session_not_found even when a newer session exists', async () => {\n90:   await withTempAsync('pi-absent', async (root) => {\n91:     const projectDir = join(root, 'project');\n92:     mkdirSync(projectDir, { recursive: true });\n93:     piSession({ root, projectDir, sessionId: DECOY });\n94:     const piRoot = join(root, 'pi', 'sessions');\n95:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, piRoot, projectDir });\n96:     assert.equal(result.ok, false);\n97:     assert.equal(result.code, 'session_not_found');\n98:   });\n99: });\n100: \n101: test('a missing store is a store_unreadable', async () => {\n102:   await withTempAsync('pi-unreadable', async (root) => {\n103:     const projectDir = join(root, 'project');\n104:     mkdirSync(projectDir, { recursive: true });\n105:     const result = await readSession({\n106:       runtime: 'pi',\n107:       sessionId: SESSION,\n108:       piRoot: join(root, 'missing-pi-store'),\n109:       projectDir,\n110:     });\n111:     assert.equal(result.ok, false);\n112:     assert.equal(result.code, 'store_unreadable');\n113:   });\n114: });\n115: \n116: test('a custom_message entry is injected context, not a turn', async () => {\n117:   await withTempAsync('pi-injected', async (root) => {\n118:     const projectDir = join(root, 'project');\n119:     mkdirSync(projectDir, { recursive: true });\n120:     const fixture = piSession({ root, projectDir });\n121:     appendFileSync(\n122:       fixture.filePath,\n123:       JSON.stringify({\n124:         type: 'custom_message',\n125:         customType: 'session-start-context',\n126:         id: 'pi-context',\n127:         content: BRIEF,\n128:       }) + '\\n',\n129:     );\n130: \n131:     const result = await loadPiSession({ sessionId: SESSION, ...fixture.options });\n132:     assert.equal(result.ok, true);\n133:     assert.deepEqual(result.injected, [{ source: 'session-start-context', text: BRIEF }]);\n134:     assert.equal(result.records.some((record) => record.id === 'pi-context'), false);\n135:   });\n136: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/pi.test.mjs, lines 1-136\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Reader Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // A Pi session resolves from the live branch when it is the current session,\n5: // and from disk only by an exact header id whose cwd is the caller's project.\n6: // Separator flattening means a project-key collision is possible, so the cwd\n7: // is part of the identity.\n8: \n9: import assert from 'node:assert/strict';\n10: import { appendFileSync, mkdirSync } from 'node:fs';\n11: import { join } from 'node:path';\n12: import { test } from 'node:test';\n13: \n14: import { capabilities, readSession } from '../../session-readers/index.mjs';\n15: import { loadPiSession, piProjectDirectory } from '../../session-readers/pi.mjs';\n16: import { DECOY, piSession, SESSION, T0 } from './fixtures.mjs';\n17: import { withTempAsync } from './helpers.mjs';\n18: \n19: // The head of a live advisor brief, used as the text a harness injects into a\n20: // session through an entry that is not a turn.\n21: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n22: \n23: // The fixtures build store folders with the reader's own key helper, so this\n24: // pins the helper to a folder name a real Pi install wrote.\n25: test('the project folder name matches the one Pi writes', () => {\n26:   assert.equal(\n27:     piProjectDirectory('/Users/michelkerkmeester/MEGA/Development/Skilled'),\n28:     '--Users-michelkerkmeester-MEGA-Development-Skilled--',\n29:   );\n30: });\n31: \n32: test('an older session resolves by header id and matching cwd', async () => {\n33:   await withTempAsync('pi-reader', async (root) => {\n34:     const projectDir = join(root, 'project');\n35:     mkdirSync(projectDir, { recursive: true });\n36:     const fixture = piSession({ root, projectDir });\n37:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n38:     assert.equal(result.ok, true);\n39:     assert.equal(result.source.locatorKind, capabilities.pi.locatorKind);\n40:     assert.equal(result.source.mode, 'disk');\n41:     assert.deepEqual(result.items.map((item) => item.role), ['user', 'assistant', 'toolResult', 'assistant']);\n42:     assert.equal(result.items[2].toolCallId, 'pi-call-1');\n43:   });\n44: });\n45: \n46: test('the current session resolves from the live branch without a disk read', async () => {\n47:   const branch = [\n48:     { type: 'message', id: 'live-u1', timestamp: '2026-11-07T12:00:00.000Z', message: { role: 'user', content: [{ type: 'text', text: 'Hello.' }] } },\n49:     { type: 'message', id: 'live-a1', timestamp: '2026-11-07T12:00:01.000Z', message: { role: 'assistant', content: [{ type: 'text', text: 'Hi.' }] } },\n50:   ];\n51:   const sessionManager = {\n52:     getSessionId: () => SESSION,\n53:     getBranch: () => branch,\n54:     getSessionFile: () => '/live/session.jsonl',\n55:   };\n56:   const result = await readSession({ runtime: 'pi', sessionId: SESSION, sessionManager });\n57:   assert.equal(result.ok, true);\n58:   assert.equal(result.source.locatorKind, capabilities.pi.locatorKind);\n59:   assert.equal(result.source.mode, 'live');\n60:   assert.equal(result.items.length, 2);\n61: });\n62: \n63: test('a project-key collision is rejected by the header cwd', async () => {\n64:   await withTempAsync('pi-collision', async (root) => {\n65:     const projectDir = join(root, 'a', 'b');\n66:     const otherDir = join(root, 'a-b');\n67:     mkdirSync(projectDir, { recursive: true });\n68:     mkdirSync(otherDir, { recursive: true });\n69: \n70:     const fixture = piSession({ root, projectDir, headerCwd: otherDir });\n71:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n72:     assert.equal(result.ok, false);\n73:     assert.equal(result.code, 'session_mismatch');\n74:   });\n75: });\n76: \n77: test('two session files with one id are refused as session_ambiguous', async () => {\n78:   await withTempAsync('pi-ambiguous', async (root) => {\n79:     const projectDir = join(root, 'project');\n80:     mkdirSync(projectDir, { recursive: true });\n81:     const fixture = piSession({ root, projectDir });\n82:     piSession({ root, projectDir, createdAt: T0 - 1000 });\n83:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n84:     assert.equal(result.ok, false);\n85:     assert.equal(result.code, 'session_ambiguous');\n86:   });\n87: });\n88: \n89: test('an absent id is a session_not_found even when a newer session exists', async () => {\n90:   await withTempAsync('pi-absent', async (root) => {\n91:     const projectDir = join(root, 'project');\n92:     mkdirSync(projectDir, { recursive: true });\n93:     piSession({ root, projectDir, sessionId: DECOY });\n94:     const piRoot = join(root, 'pi', 'sessions');\n95:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, piRoot, projectDir });\n96:     assert.equal(result.ok, false);\n97:     assert.equal(result.code, 'session_not_found');\n98:   });\n99: });\n100: \n101: test('a missing store is a store_unreadable', async () => {\n102:   await withTempAsync('pi-unreadable', async (root) => {\n103:     const projectDir = join(root, 'project');\n104:     mkdirSync(projectDir, { recursive: true });\n105:     const result = await readSession({\n106:       runtime: 'pi',\n107:       sessionId: SESSION,\n108:       piRoot: join(root, 'missing-pi-store'),\n109:       projectDir,\n110:     });\n111:     assert.equal(result.ok, false);\n112:     assert.equal(result.code, 'store_unreadable');\n113:   });\n114: });\n115: \n116: test('a custom_message entry is injected context, not a turn', async () => {\n117:   await withTempAsync('pi-injected', async (root) => {\n118:     const projectDir = join(root, 'project');\n119:     mkdirSync(projectDir, { recursive: true });\n120:     const fixture = piSession({ root, projectDir });\n121:     appendFileSync(\n122:       fixture.filePath,\n123:       JSON.stringify({\n124:         type: 'custom_message',\n125:         customType: 'session-start-context',\n126:         id: 'pi-context',\n127:         content: BRIEF,\n128:       }) + '\\n',\n129:     );\n130: \n131:     const result = await loadPiSession({ sessionId: SESSION, ...fixture.options });\n132:     assert.equal(result.ok, true);\n133:     assert.deepEqual(result.injected, [{ source: 'session-start-context', text: BRIEF }]);\n134:     assert.equal(result.records.some((record) => record.id === 'pi-context'), false);\n135:   });\n136: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\"}"},"time":{"start":1794546185527,"end":1794546185890}}}}
{"type":"tool_use","timestamp":1794546185897,"sessionID":"ses_e2cb7c2a8ffeJgvonzMMJV44b8","part":{"partID":"prt_1d349b3b8001KpuKRCd2n6LVQr","sessionID":"ses_e2cb7c2a8ffeJgvonzMMJV44b8","messageID":"msg_1d3498a0f0019Qj2Wjdkjvxfx2","type":"tool","id":"call_2fb7ee3e38d443579c62bd47","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs, lines 1-200\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Injected User Text Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // Every runtime injects harness context alongside operator prompts. A reader\n5: // may drop that injected content, but only where the store or a known tag says\n6: // it is injected; operator text that merely opens with '<' must survive.\n7: \n8: import assert from 'node:assert/strict';\n9: import { appendFileSync, mkdirSync, readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: import { DatabaseSync } from 'node:sqlite';\n12: import { test } from 'node:test';\n13: \n14: import { readSession } from '../../session-readers/index.mjs';\n15: import {\n16:   codexSession,\n17:   devinSession,\n18:   dshSession,\n19:   NOW,\n20:   opencodeSession,\n21:   piSession,\n22:   SESSION,\n23:   T0,\n24: } from './fixtures.mjs';\n25: import { withTempAsync, writeJson } from './helpers.mjs';\n26: \n27: function appendJsonLines(filePath, rows) {\n28:   appendFileSync(filePath, rows.map((row) => `${JSON.stringify(row)}\\n`).join(''));\n29: }\n30: \n31: test('Codex keeps operator text that opens with a tag and drops only injected context', async () => {\n32:   await withTempAsync('codex-injected-text', async (root) => {\n33:     const fixture = codexSession({ root });\n34:     appendJsonLines(fixture.filePath, [\n35:       {\n36:         timestamp: NOW,\n37:         type: 'response_item',\n38:         payload: {\n39:           type: 'message',\n40:           id: 'codex-environment',\n41:           role: 'user',\n42:           content: [{ type: 'input_text', text: '<environment_context>\\n<cwd>/workspace</cwd>\\n</environment_context>' }],\n43:         },\n44:       },\n45:       {\n46:         timestamp: NOW,\n47:         type: 'response_item',\n48:         payload: {\n49:           type: 'message',\n50:           id: 'codex-instructions',\n51:           role: 'user',\n52:           content: [{ type: 'input_text', text: '<user_instructions>Attached instructions.</user_instructions>' }],\n53:         },\n54:       },\n55:       {\n56:         timestamp: NOW,\n57:         type: 'response_item',\n58:         payload: {\n59:           type: 'message',\n60:           id: 'codex-permissions',\n61:           role: 'user',\n62:           content: [{ type: 'input_text', text: '<permissions instructions>Sandboxed.</permissions instructions>' }],\n63:         },\n64:       },\n65:       {\n66:         timestamp: NOW,\n67:         type: 'response_item',\n68:         payload: {\n69:           type: 'message',\n70:           id: 'codex-div',\n71:           role: 'user',\n72:           content: [{ type: 'input_text', text: '<div>hello</div>' }],\n73:         },\n74:       },\n75:     ]);\n76: \n77:     const result = await readSession({ runtime: 'codex', sessionId: SESSION, ...fixture.options });\n78:     assert.equal(result.ok, true);\n79:     const ids = result.items.map((item) => item.id);\n80:     assert.equal(ids.includes('codex-environment'), false);\n81:     assert.equal(ids.includes('codex-instructions'), false);\n82:     assert.equal(ids.includes('codex-permissions'), false);\n83:     assert.equal(result.items.find((item) => item.id === 'codex-div')?.content[0].text, '<div>hello</div>');\n84:   });\n85: });\n86: \n87: test('Pi keeps operator text that opens with a tag and ignores custom messages', async () => {\n88:   await withTempAsync('pi-injected-text', async (root) => {\n89:     const projectDir = join(root, 'project');\n90:     mkdirSync(projectDir, { recursive: true });\n91:     const fixture = piSession({ root, projectDir });\n92:     appendJsonLines(fixture.filePath, [\n93:       {\n94:         type: 'custom_message',\n95:         customType: 'session-start-context',\n96:         id: 'pi-context',\n97:         timestamp: NOW,\n98:         content: '<system-reminder>injected</system-reminder>',\n99:       },\n100:       {\n101:         type: 'message',\n102:         id: 'pi-div',\n103:         timestamp: NOW,\n104:         message: { role: 'user', content: [{ type: 'text', text: '<div>hello</div>' }] },\n105:       },\n106:     ]);\n107: \n108:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n109:     assert.equal(result.ok, true);\n110:     assert.equal(result.items.some((item) => item.id === 'pi-context'), false);\n111:     assert.equal(result.items.find((item) => item.id === 'pi-div')?.content[0].text, '<div>hello</div>');\n112:   });\n113: });\n114: \n115: test('Devin keeps an operator step that opens with a tag and ignores system steps in a transcript-only store', async () => {\n116:   await withTempAsync('devin-injected-text', async (root) => {\n117:     const projectDir = join(root, 'project');\n118:     mkdirSync(projectDir, { recursive: true });\n119:     const fixture = devinSession({ root, projectDir, withSessionsRow: false });\n120:     const transcript = JSON.parse(readFileSync(fixture.filePath, 'utf8'));\n121:     transcript.steps.push(\n122:       { step_id: 90, timestamp: NOW, source: 'system', message: '<system>injected</system>' },\n123:       { step_id: 91, timestamp: NOW, source: 'user', message: '<div>hello</div>' },\n124:     );\n125:     writeJson(fixture.filePath, transcript);\n126: \n127:     const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n128:     assert.equal(result.ok, true);\n129:     assert.equal(result.items.some((item) => item.id === 'devin-90'), false);\n130:     assert.equal(result.items.find((item) => item.id === 'devin-91')?.content[0].text, '<div>hello</div>');\n131:   });\n132: });\n133: \n134: test('DSH keeps an operator message that opens with a tag and ignores injected source kinds', async () => {\n135:   await withTempAsync('dsh-injected-text', async (root) => {\n136:     const projectDir = join(root, 'project');\n137:     mkdirSync(projectDir, { recursive: true });\n138:     const fixture = dshSession({ root, projectDir });\n139:     appendJsonLines(fixture.filePath, [\n140:       {\n141:         type: 'user/message',\n142:         seq: 5,\n143:         data: {\n144:           role: 'user',\n145:           id: 'dsh-injected',\n146:           source: { kind: 'repo-guards' },\n147:           content: [{ type: 'text', text: '<system>injected</system>' }],\n148:         },\n149:       },\n150:       {\n151:         type: 'user/message',\n152:         seq: 6,\n153:         data: {\n154:           role: 'user',\n155:           id: 'dsh-div',\n156:           source: { kind: 'user' },\n157:           content: [{ type: 'text', text: '<div>hello</div>' }],\n158:         },\n159:       },\n160:     ]);\n161: \n162:     const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n163:     assert.equal(result.ok, true);\n164:     assert.equal(result.items.some((item) => item.id === 'dsh-injected'), false);\n165:     assert.equal(result.items.find((item) => item.id === 'dsh-div')?.content[0].text, '<div>hello</div>');\n166:   });\n167: });\n168: \n169: test('OpenCode keeps an operator row that opens with a tag and ignores synthetic rows', async () => {\n170:   await withTempAsync('opencode-injected-text', async (root) => {\n171:     const fixture = opencodeSession({ root });\n172:     const database = new DatabaseSync(fixture.dbPath);\n173:     try {\n174:       const insert = database.prepare(\n175:         'INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)',\n176:       );\n177:       insert.run(\n178:         'oc-synthetic',\n179:         SESSION,\n180:         'synthetic',\n181:         3,\n182:         JSON.stringify({ text: '<system>injected</system>', time: { created: T0 + 3000 } }),\n183:       );\n184:       insert.run(\n185:         'oc-div',\n186:         SESSION,\n187:         'user',\n188:         4,\n189:         JSON.stringify({ text: '<div>hello</div>', time: { created: T0 + 4000 } }),\n190:       );\n191:     } finally {\n192:       database.close();\n193:     }\n194: \n195:     const result = await readSession({ runtime: 'opencode', sessionId: SESSION, ...fixture.options });\n196:     assert.equal(result.ok, true);\n197:     assert.equal(result.items.some((item) => item.id === 'oc-synthetic'), false);\n198:     assert.equal(result.items.find((item) => item.id === 'oc-div')?.content[0].text, '<div>hello</div>');\n199:   });\n200: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs, lines 1-200\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Injected User Text Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // Every runtime injects harness context alongside operator prompts. A reader\n5: // may drop that injected content, but only where the store or a known tag says\n6: // it is injected; operator text that merely opens with '<' must survive.\n7: \n8: import assert from 'node:assert/strict';\n9: import { appendFileSync, mkdirSync, readFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: import { DatabaseSync } from 'node:sqlite';\n12: import { test } from 'node:test';\n13: \n14: import { readSession } from '../../session-readers/index.mjs';\n15: import {\n16:   codexSession,\n17:   devinSession,\n18:   dshSession,\n19:   NOW,\n20:   opencodeSession,\n21:   piSession,\n22:   SESSION,\n23:   T0,\n24: } from './fixtures.mjs';\n25: import { withTempAsync, writeJson } from './helpers.mjs';\n26: \n27: function appendJsonLines(filePath, rows) {\n28:   appendFileSync(filePath, rows.map((row) => `${JSON.stringify(row)}\\n`).join(''));\n29: }\n30: \n31: test('Codex keeps operator text that opens with a tag and drops only injected context', async () => {\n32:   await withTempAsync('codex-injected-text', async (root) => {\n33:     const fixture = codexSession({ root });\n34:     appendJsonLines(fixture.filePath, [\n35:       {\n36:         timestamp: NOW,\n37:         type: 'response_item',\n38:         payload: {\n39:           type: 'message',\n40:           id: 'codex-environment',\n41:           role: 'user',\n42:           content: [{ type: 'input_text', text: '<environment_context>\\n<cwd>/workspace</cwd>\\n</environment_context>' }],\n43:         },\n44:       },\n45:       {\n46:         timestamp: NOW,\n47:         type: 'response_item',\n48:         payload: {\n49:           type: 'message',\n50:           id: 'codex-instructions',\n51:           role: 'user',\n52:           content: [{ type: 'input_text', text: '<user_instructions>Attached instructions.</user_instructions>' }],\n53:         },\n54:       },\n55:       {\n56:         timestamp: NOW,\n57:         type: 'response_item',\n58:         payload: {\n59:           type: 'message',\n60:           id: 'codex-permissions',\n61:           role: 'user',\n62:           content: [{ type: 'input_text', text: '<permissions instructions>Sandboxed.</permissions instructions>' }],\n63:         },\n64:       },\n65:       {\n66:         timestamp: NOW,\n67:         type: 'response_item',\n68:         payload: {\n69:           type: 'message',\n70:           id: 'codex-div',\n71:           role: 'user',\n72:           content: [{ type: 'input_text', text: '<div>hello</div>' }],\n73:         },\n74:       },\n75:     ]);\n76: \n77:     const result = await readSession({ runtime: 'codex', sessionId: SESSION, ...fixture.options });\n78:     assert.equal(result.ok, true);\n79:     const ids = result.items.map((item) => item.id);\n80:     assert.equal(ids.includes('codex-environment'), false);\n81:     assert.equal(ids.includes('codex-instructions'), false);\n82:     assert.equal(ids.includes('codex-permissions'), false);\n83:     assert.equal(result.items.find((item) => item.id === 'codex-div')?.content[0].text, '<div>hello</div>');\n84:   });\n85: });\n86: \n87: test('Pi keeps operator text that opens with a tag and ignores custom messages', async () => {\n88:   await withTempAsync('pi-injected-text', async (root) => {\n89:     const projectDir = join(root, 'project');\n90:     mkdirSync(projectDir, { recursive: true });\n91:     const fixture = piSession({ root, projectDir });\n92:     appendJsonLines(fixture.filePath, [\n93:       {\n94:         type: 'custom_message',\n95:         customType: 'session-start-context',\n96:         id: 'pi-context',\n97:         timestamp: NOW,\n98:         content: '<system-reminder>injected</system-reminder>',\n99:       },\n100:       {\n101:         type: 'message',\n102:         id: 'pi-div',\n103:         timestamp: NOW,\n104:         message: { role: 'user', content: [{ type: 'text', text: '<div>hello</div>' }] },\n105:       },\n106:     ]);\n107: \n108:     const result = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n109:     assert.equal(result.ok, true);\n110:     assert.equal(result.items.some((item) => item.id === 'pi-context'), false);\n111:     assert.equal(result.items.find((item) => item.id === 'pi-div')?.content[0].text, '<div>hello</div>');\n112:   });\n113: });\n114: \n115: test('Devin keeps an operator step that opens with a tag and ignores system steps in a transcript-only store', async () => {\n116:   await withTempAsync('devin-injected-text', async (root) => {\n117:     const projectDir = join(root, 'project');\n118:     mkdirSync(projectDir, { recursive: true });\n119:     const fixture = devinSession({ root, projectDir, withSessionsRow: false });\n120:     const transcript = JSON.parse(readFileSync(fixture.filePath, 'utf8'));\n121:     transcript.steps.push(\n122:       { step_id: 90, timestamp: NOW, source: 'system', message: '<system>injected</system>' },\n123:       { step_id: 91, timestamp: NOW, source: 'user', message: '<div>hello</div>' },\n124:     );\n125:     writeJson(fixture.filePath, transcript);\n126: \n127:     const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n128:     assert.equal(result.ok, true);\n129:     assert.equal(result.items.some((item) => item.id === 'devin-90'), false);\n130:     assert.equal(result.items.find((item) => item.id === 'devin-91')?.content[0].text, '<div>hello</div>');\n131:   });\n132: });\n133: \n134: test('DSH keeps an operator message that opens with a tag and ignores injected source kinds', async () => {\n135:   await withTempAsync('dsh-injected-text', async (root) => {\n136:     const projectDir = join(root, 'project');\n137:     mkdirSync(projectDir, { recursive: true });\n138:     const fixture = dshSession({ root, projectDir });\n139:     appendJsonLines(fixture.filePath, [\n140:       {\n141:         type: 'user/message',\n142:         seq: 5,\n143:         data: {\n144:           role: 'user',\n145:           id: 'dsh-injected',\n146:           source: { kind: 'repo-guards' },\n147:           content: [{ type: 'text', text: '<system>injected</system>' }],\n148:         },\n149:       },\n150:       {\n151:         type: 'user/message',\n152:         seq: 6,\n153:         data: {\n154:           role: 'user',\n155:           id: 'dsh-div',\n156:           source: { kind: 'user' },\n157:           content: [{ type: 'text', text: '<div>hello</div>' }],\n158:         },\n159:       },\n160:     ]);\n161: \n162:     const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n163:     assert.equal(result.ok, true);\n164:     assert.equal(result.items.some((item) => item.id === 'dsh-injected'), false);\n165:     assert.equal(result.items.find((item) => item.id === 'dsh-div')?.content[0].text, '<div>hello</div>');\n166:   });\n167: });\n168: \n169: test('OpenCode keeps an operator row that opens with a tag and ignores synthetic rows', async () => {\n170:   await withTempAsync('opencode-injected-text', async (root) => {\n171:     const fixture = opencodeSession({ root });\n172:     const database = new DatabaseSync(fixture.dbPath);\n173:     try {\n174:       const insert = database.prepare(\n175:         'INSERT INTO session_message (id, session_id, type, seq, data) VALUES (?, ?, ?, ?, ?)',\n176:       );\n177:       insert.run(\n178:         'oc-synthetic',\n179:         SESSION,\n180:         'synthetic',\n181:         3,\n182:         JSON.stringify({ text: '<system>injected</system>', time: { created: T0 + 3000 } }),\n183:       );\n184:       insert.run(\n185:         'oc-div',\n186:         SESSION,\n187:         'user',\n188:         4,\n189:         JSON.stringify({ text: '<div>hello</div>', time: { created: T0 + 4000 } }),\n190:       );\n191:     } finally {\n192:       database.close();\n193:     }\n194: \n195:     const result = await readSession({ runtime: 'opencode', sessionId: SESSION, ...fixture.options });\n196:     assert.equal(result.ok, true);\n197:     assert.equal(result.items.some((item) => item.id === 'oc-synthetic'), false);\n198:     assert.equal(result.items.find((item) => item.id === 'oc-div')?.content[0].text, '<div>hello</div>');\n199:   });\n200: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput"