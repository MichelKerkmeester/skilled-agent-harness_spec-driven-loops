{"type":"tool_use","timestamp":1794546313171,"sessionID":"ses_e2cb7c2a8ffeJgvonzMMJV44b8","part":{"partID":"prt_1d34ba41e001Guxc8EvrX7OykU","sessionID":"ses_e2cb7c2a8ffeJgvonzMMJV44b8","messageID":"msg_1d34b8477001h4o7e4FGLwaDg6","type":"tool","id":"call_425242f74c4a4c4f8de02cf0","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/hooks/shared/session-readers/index.mjs .skilled/hooks/shared/tests/session-readers/injected-text.test.mjs; echo \"---status---\"; git -c core.fsmonitor=false status --short -- .skilled/hooks/shared/session-readers/index.mjs .skilled/hooks/shared/tests/session-readers/injected-text.test.mjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/hooks/shared/session-readers/index.mjs b/.skilled/hooks/shared/session-readers/index.mjs\nindex 2c792b384e..ac4e0fbdde 100644\n--- a/.skilled/hooks/shared/session-readers/index.mjs\n+++ b/.skilled/hooks/shared/session-readers/index.mjs\n@@ -135,7 +135,12 @@ export async function loadSession(input) {\n   try {\n     const loaded = await load(options);\n     if (!loaded.ok) return loaded;\n-    return { ok: true, source: loaded.source, records: loaded.records };\n+    return {\n+      ok: true,\n+      source: loaded.source,\n+      records: loaded.records,\n+      ...(Array.isArray(loaded.injected) ? { injected: loaded.injected } : {}),\n+    };\n   } catch {\n     return failure('store_unreadable');\n   }\ndiff --git a/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs b/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\nindex 3045d8bc93..bdffb3826d 100644\n--- a/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\n@@ -11,7 +11,7 @@ import { join } from 'node:path';\n import { DatabaseSync } from 'node:sqlite';\n import { test } from 'node:test';\n \n-import { readSession } from '../../session-readers/index.mjs';\n+import { loadSession, readSession } from '../../session-readers/index.mjs';\n import {\n   codexSession,\n   devinSession,\n@@ -24,6 +24,10 @@ import {\n } from './fixtures.mjs';\n import { withTempAsync, writeJson } from './helpers.mjs';\n \n+// The head of a live advisor brief, used as the text a harness injects into a\n+// session through an entry that is not a turn.\n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n function appendJsonLines(filePath, rows) {\n   appendFileSync(filePath, rows.map((row) => `${JSON.stringify(row)}\\n`).join(''));\n }\n@@ -112,6 +116,31 @@ test('Pi keeps operator text that opens with a tag and ignores custom messages',\n   });\n });\n \n+test('loadSession carries the Pi custom message while readSession leaves it out', async () => {\n+  await withTempAsync('pi-load-session-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+    appendJsonLines(fixture.filePath, [\n+      {\n+        type: 'custom_message',\n+        customType: 'session-start-context',\n+        id: 'pi-context',\n+        timestamp: NOW,\n+        content: BRIEF,\n+      },\n+    ]);\n+\n+    const loaded = await loadSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n+    assert.equal(loaded.ok, true);\n+    assert.deepEqual(loaded.injected, [{ source: 'session-start-context', text: BRIEF }]);\n+\n+    const projected = await readSession({ runtime: 'pi', sessionId: SESSION, ...fixture.options });\n+    assert.equal(projected.ok, true);\n+    assert.equal(projected.items.some((item) => item.id === 'pi-context'), false);\n+  });\n+});\n+\n test('Devin keeps an operator step that opens with a tag and ignores system steps in a transcript-only store', async () => {\n   await withTempAsync('devin-injected-text', async (root) => {\n     const projectDir = join(root, 'project');\n---status---\n M .skilled/hooks/shared/session-readers/index.mjs\n M .skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/hooks/shared/session-readers/index.mjs b/.skilled/hooks/shared/session-readers/index.mjs\nindex 2c792b384e..ac4e0fbdde 100644\n--- a/.skilled/hooks/shared/session-readers/index.mjs\n+++ b/.skilled/hooks/shared/session-readers/index.mjs\n@@ -135,7 +135,12 @@ export async function loadSession(input) {\n   try {\n     const loaded = await load(options);\n     if (!loaded.ok) return loaded;\n-    return { ok: true, source: loaded.source, records: loaded.records };\n+    return {\n+      ok: true,\n+      source: loaded.source,\n+      records: loaded.records,\n+      ...(Array.isArray(loaded.injected) ? { injected: loaded.injected } : {}),\n+    };\n   } catch {\n     return failure('store_unreadable');\n   }\ndiff --git a/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs b/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\nindex 3045d8bc93..bdffb3826d 100644\n--- a/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/injected-text.test.mjs\n@@ -11,7 +11,7 @@ import { join } from 'node:path';\n import { DatabaseSync } from 'node:sqlite';\n import { test } from 'node:test';\n \n-import { readSession } from '../../session-readers/index.mjs';\n+import { loadSession, readSession } from '../../session-readers/index.mjs';\n import {\n   codexSession,\n   devinSession,\n@@ -24,6 +24,10 @@ import {\n } from './fixtures.mjs';\n import { withTempAsync, writeJson } from './helpers.mjs';\n \n+// The head of a live advisor brief, used as the text a harness injects into a\n+// session through an entry that is not a turn.\n+const BRIEF = 'Advisor: live; use sk-