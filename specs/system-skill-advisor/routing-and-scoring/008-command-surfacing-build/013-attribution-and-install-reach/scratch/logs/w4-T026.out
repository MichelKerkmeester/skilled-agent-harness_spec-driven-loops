ook/references/README.md\",\n353:         \"sk-create-manual-testing-playbook/references/common-pitfalls.md\",\n354:         \"sk-create-manual-testing-playbook/references/conversation-scenarios.md\",\n355:         \"sk-create-manual-testing-playbook/references/examples.md\",\n356:         \"sk-create-manual-testing-playbook/references/prompt-voice.md\",\n357:         \"shared/assets/llmstxt-templates.md\",\n358:         \"shared/references/core-standards.md\",\n359:         \"shared/references/evergreen-packet-id-rule.md\",\n360:         \"shared/references/validation.md\",\n361:         \"sk-create-quality-control/references/README.md\",\n362:         \"sk-create-quality-control/references/optimization.md\",\n363:         \"sk-create-quality-control/references/transformation-patterns.md\",\n364:         \"sk-create-quality-control/references/validation-and-enforcement.md\",\n365:         \"sk-create-quality-control/references/workflow-examples.md\",\n366:         \"sk-create-quality-control/references/workflows.md\",\n367:         \"sk-create-readme/assets/architecture-template.md\",\n368:         \"sk-create-readme/assets/readme-code-template.md\",\n369:         \"sk-create-readme/assets/readme-template.md\",\n370:         \"sk-create-readme/references/README.md\",\n371:         \"sk-create-readme/references/readme/quality-and-checklist.md\",\n372:         \"sk-create-readme/references/readme/types-and-voice.md\",\n373:         \"sk-create-readme/references/readme/writing-patterns.md\",\n374:         \"sk-create-repo-rule/assets/repo-rule-template.md\",\n375:         \"sk-create-repo-rule/assets/repo-rules-router-template.md\",\n376:         \"sk-create-repo-rule/references/README.md\",\n377:         \"sk-create-repo-rule/references/agents-md-integration.md\",\n378:         \"sk-create-repo-rule/references/creation-standards.md\",\n379:         \"sk-create-repo-rule/references/decision-tests.md\",\n380:         \"sk-create-repo-rule/references/rule-anatomy.md\",\n381:         \"sk-create-with-human-voice/assets/voice-report-template.md\",\n382:         \"sk-create-with-human-voice/references/README.md\",\n383:         \"sk-create-with-human-voice/references/hvr-rules.md\",\n384:         \"sk-create-with-human-voice/references/scope-and-exemptions.md\",\n385:         \"sk-create-with-human-voice/references/scoring-and-verification.md\",\n386:         \"sk-create-skill/assets/parent-skill/parent-skill-command-metadata-template.json\",\n387:         \"sk-create-skill/assets/parent-skill/parent-skill-description-template.json\",\n388:         \"sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\",\n389:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\",\n390:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\",\n391:         \"sk-create-skill/assets/parent-skill/parent-skill-leaf-aliases-template.json\",\n392:         \"sk-create-skill/assets/parent-skill/parent-skill-readme-template.md\",\n393:         \"sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\",\n394:         \"sk-create-skill/assets/parent-skill/parent-skill-root-router-template.md\",\n395:         \"sk-create-skill/assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n396:         \"sk-create-skill/assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n397:         \"sk-create-skill/assets/skill/skill-asset-template.md\",\n398:         \"sk-create-skill/assets/skill/skill-graph-metadata-template.json\",\n399:         \"sk-create-skill/assets/skill/skill-leaf-manifest-config-template.json\",\n400:         \"sk-create-skill/assets/skill/skill-md-template.md\",\n401:         \"sk-create-skill/assets/skill/skill-procedure-template.md\",\n402:         \"sk-create-skill/assets/skill/skill-readme-template.md\",\n403:         \"sk-create-skill/assets/skill/skill-reference-template.md\",\n404:         \"sk-create-skill/assets/skill/skill-scaffold-template.md\",\n405:         \"sk-create-skill/assets/skill/skill-smart-router.md\",\n406:         \"sk-create-skill/assets/skill/skill-sync-manifest-template.md\",\n407:         \"sk-create-skill/references/README.md\",\n408:         \"sk-create-skill/references/parent-skill/compiled-routing-architecture.md\",\n409:         \"sk-create-skill/references/parent-skill/compiled-routing-lockstep-surfaces.json\",\n410:         \"sk-create-skill/references/parent-skill/parent-hub-router-schema.md\",\n411:         \"sk-create-skill/references/parent-skill/parent-skills-nested-packets.md\",\n412:         \"sk-create-skill/references/shared/advisor-index-handoff.md\",\n413:         \"sk-create-skill/references/shared/common-pitfalls.md\",\n414:         \"sk-create-skill/references/shared/overview.md\",\n415:         \"sk-create-skill/references/shared/skill-root-metadata-contract.md\",\n416:         \"sk-create-skill/references/shared/validation-and-packaging.md\",\n417:         \"sk-create-skill/references/skill/creation-workflow.md\",\n418:         \"sk-create-skill/references/skill/examples-and-maintenance.md\",\n419:         \"sk-create-skill/references/skill/upgrading-a-skill-to-v4.md\"\n420:     ],\n421: }\n422: ```\n423: \n424: ---\n425: \n426: ## 4. HOW TO READ THIS\n427: \n428: - One dominant intent routes to one mode's leaf set.\n429: - Two near-tied intents (within the ambiguity delta) route to both leaf sets; the\n430:   union is deduped by canonical pair.\n431: - No keyword match is UNKNOWN_FALLBACK: confirm the target artifact and intent\n432:   before loading anything.\n433: - `FULL_INVENTORY` fires only on an explicit \"show the whole toolkit\" request.\n434: - A mode whose `mode-registry.json` row names a `command` has two whole entries: read that command's document in full and follow it under the policy the advisor names, or follow this mode's packet. Pick one and keep to it. A mode whose row has `command: null` has only its packet.\n435: \n436: ---\n437: \n438: ## 5. MACHINE ROUTER\n439: \n440: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 3 stays the only replay source.\n441: \n442: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n443: > ```bash\n444: > node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"\n445: > ```\n446: > Follow the returned decision — `route` (use its `targets`), `clarify`/`defer` (disambiguate), `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-doc`; set `SPECKIT_COMPILED_ROUTING=0` to force legacy routing fleet-wide — the explicit kill-switch.\n447: \n448: ### Surface Router — per-intent leaf sets\n449: \n450: Stage 2 of routing lives in section 3 of this file.\n451: It defines three things:\n452: - The per-intent leaf model: document quality, optimization, skill creation, parent-hub creation, agent creation, command creation, the paired agent-plus-command lane, the human-voice pass, playbooks, playbook conversations, feature catalogs, READMEs, changelogs, benchmarks, diffs, frontmatter, packet goals, repo rules, and the explicit full-toolkit intent.\n453: - The machine-readable `INTENT_SIGNALS` / `RESOURCE_MAP` block that the deterministic router-replay and benchmarks parse.\n454: - The how-to-read rules: a dominant intent gives one leaf set, near-tied intents give a deduped union, and no keyword match gives the hub UNKNOWN fallback, never a silent default.\n455: \n456: Every `RESOURCE_MAP` path is packet-qualified or an authored shared-alias disk path, and each converts to the canonical `(workflowMode, leafResourceId)` pair at the one contract boundary.\n457: \n458: The reason this file stays a separate document from `SKILL.md` and from `hub-router.json` is in [the parent-skill reference](sk-create-skill/references/parent-skill/parent-skills-nested-packets.md#why-the-leaf-router-stays-in-routermd).\n459: \n460: ### The discriminator\n461: - **`workflowMode`** — the public packet key (e.g. `sk-create-skill`, `sk-create-quality-control`). `sk-create-skill-parent` is a second mode over the same `sk-create-skill` packet.\n462: - **`packetKind`** — `workflow` for every sk-doc packet (there is no surface axis; the sk-create-quality-control pipeline is universal doctrine in `shared/`, not orthogonal stack-evidence).\n463: - **`backendKind`** — `template-scaffold` for the create-* generators, `sk-create-quality-control` for the sk-create-quality-control mode.\n464: \n465: ### Routing rule\n466: ```\n467: SKILL_ROOT = path containing this ROUTER.md and its SKILL.md\n468: REGISTRY = SKILL_ROOT / \"mode-registry.json\"\n469: HUB_ROUTER = SKILL_ROOT / \"hub-router.json\"\n470: \n471: UNKNOWN_FALLBACK_CHECKLIST = [\n472:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n473:     \"Confirm the target document or component being authored, scaffolded, or reviewed\",\n474:     \"Provide the available inputs: existing doc, source material, or scaffold parameters\",\n475:     \"Confirm the validation expectations before completion (DQI/HVR scoring, validate.sh, or packet-specific checks)\",\n476: ]\n477: \n478: def _guard_in_skill(relative_path):\n479:   resolved = (SKILL_ROOT / relative_path).resolve()\n480:   resolved.relative_to(SKILL_ROOT)\n481:   if resolved.suffix.lower() not in {\".md\", \".json\"}:\n482:     raise ValueError(\"only skill-local markdown/json router resources are routable\")\n483:   return resolved.relative_to(SKILL_ROOT).as_posix()\n484: \n485: def load_if_available(relative_path, seen):\n486:   guarded = _guard_in_skill(relative_path)\n487:   if guarded not in seen and (SKILL_ROOT / guarded).exists():\n488:     load(guarded)\n489:     seen.add(guarded)\n490:     return True\n491:   return False\n492: \n493: seen = set()\n494: if not REGISTRY.exists() or not HUB_ROUTER.exists():\n495:   return defer(\"router metadata missing; inspect sk-doc/mode-registry.json and sk-doc/hub-router.json\")\n496: \n497: read mode-registry.json and hub-router.json\n498: classify the request to one or more workflowMode values using hub-router.json\n499:   (dominant authoring/quality intent; a command like /create:agent resolves directly)\n500: \n501: if confidence is low, intent is contradictory, or routerPolicy.defaultMode is null and no mode wins:\n502:   for resource in hub_router.routerPolicy.defaultResource:   # the ordered defer set, never hardcoded here\n503:     load_if_available(resource, seen)\n504:   return UNKNOWN_FALLBACK with disambiguation_checklist = UNKNOWN_FALLBACK_CHECKLIST\n505: \n506: for each resolved workflowMode:\n507:   entry = the matching mode-registry.json modes[] item\n508:   if entry is missing or entry.packetKind != \"workflow\":\n509:     return defer(\"unknown sk-doc workflowMode; extend mode-registry.json and create a packet first\")\n510:   if not load_if_available(f\"{entry.packet}/SKILL.md\", seen):\n511:     return defer(\"registered packet SKILL.md is missing; repair the packet before routing\")\n512: \n513: return single or orderedBundle according to hub-router.json routerPolicy.outcomes\n514: ```\n515: `routerPolicy.defaultMode` is `null`: an unclear documentation intent asks for disambiguation rather than forcing a stale default. `hub-router.json` carries the router signals, vocabulary classes, default fallback resource, and bundle rules. Outcomes are `single`, `orderedBundle`, or `defer` — there is no `surfaceBundle` (no surface axis).\n516: \n517: Per-packet behavior is **not flattened**: each packet keeps its own authoring contract, references, assets, scripts, and templates.\n518: \n519: This hub does **not** use keyed resource discovery (`references/<key>/` or `assets/<key>/`) at the hub root.\n520: There are no hub-root `references/` or `assets/` directories, and packet resources stay inside their owning packet or the shared backbone.\n521: If a future workflow needs keyed resource subdirectories, add that behavior inside the owning packet using guarded runtime discovery.\n522: Do not hardcode resource inventories in this hub."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/ROUTER.md\"}"},"time":{"start":1794546919333,"end":1794546919638}}}}
