ction\": \"route\",\n          \"selectionKind\": \"single\",\n          \"targets\": [\n            {\n              \"backendKind\": \"template-scaffold\",\n              \"packetId\": \"sk-create-readme\",\n              \"packetKind\": \"workflow\",\n              \"skillId\": \"sk-doc\",\n              \"workflowMode\": \"sk-create-readme\"\n            }\n          ],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"command\": \"/create:readme\",\n        \"kind\": \"skill\",\n        \"policy\": \"start\"\n      },\n      {\n        \"skillId\": \"system-spec-kit\",\n        \"score\": 0.291197,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.18,\n        \"dominantLane\": \"graph_causal\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 166,\n      \"checkedAt\": \"2026-11-13T05:15:03.950Z\",\n      \"lastLiveAt\": \"2026-11-13T05:09:28.891Z\"\n    },\n    \"generatedAt\": \"2026-11-13T05:15:04.034Z\",\n    \"cache\": {\n      \"hit\": false,\n      \"sourceSignaturePresent\": true\n    },\n    \"_shadow\": {\n      \"model\": \"advisor-shadow-learned-weights-v1\",\n      \"liveWeightsFrozen\": true,\n      \"recommendations\": [\n        {\n          \"skillId\": \"sk-doc\",\n          \"liveScore\": 0.672624,\n          \"shadowScore\": 0.642131,\n          \"delta\": -0.030493,\n          \"dominantShadowLane\": \"explicit_author\"\n        },\n        {\n          \"skillId\": \"system-spec-kit\",\n          \"liveScore\": 0.291197,\n          \"shadowScore\": 0.326117,\n          \"delta\": 0.03492,\n          \"dominantShadowLane\": \"graph_causal\"\n        }\n      ]\n    }\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"Describe injected in the session-readers README: add a short paragraph where the README describes the loadSession result, naming the source of each runtime in one line each\\\"}' --format json\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794546902790,"end":1794546904236}}}}
