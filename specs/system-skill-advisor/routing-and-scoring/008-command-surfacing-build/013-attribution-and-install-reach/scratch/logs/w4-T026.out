cription.md\",\n299:         \"sk-create-frontmatter/assets/fixtures/under-budget-trim-lost-tokens.md\",\n300:         \"sk-create-frontmatter/assets/frontmatter-templates.md\",\n301:         \"sk-create-frontmatter/references/README.md\",\n302:         \"sk-create-frontmatter/references/frontmatter-versioning.md\",\n303:         \"sk-create-goal/assets/goal-exemplars.md\",\n304:         \"sk-create-goal/assets/goal-phase-child-template.md\",\n305:         \"sk-create-goal/assets/goal-phase-parent-template.md\",\n306:         \"sk-create-goal/assets/goal-top-level-template.md\",\n307:         \"sk-create-goal/references/authoring-standards.md\",\n308:         \"sk-create-goal/references/budget-and-handoff.md\",\n309:         \"sk-create-goal/references/parent-and-nested-goals.md\",\n310:         \"sk-create-benchmark/assets/behavior-benchmark/behavior-benchmark-baseline-template.md\",\n311:         \"sk-create-benchmark/assets/behavior-benchmark/behavior-benchmark-index-template.md\",\n312:         \"sk-create-benchmark/assets/behavior-benchmark/behavior-benchmark-scenario-template.md\",\n313:         \"sk-create-benchmark/assets/shared/benchmark-report-template.md\",\n314:         \"sk-create-benchmark/assets/shared/source-template.md\",\n315:         \"sk-create-benchmark/references/behavior-benchmark/behavior-benchmark-guide.md\",\n316:         \"sk-create-benchmark/references/shared/README.md\",\n317:         \"sk-create-benchmark/references/shared/case-studies.md\",\n318:         \"sk-create-benchmark/references/shared/pitfalls.md\",\n319:         \"sk-create-benchmark/references/shared/worked-example.md\",\n320:         \"sk-create-changelog/assets/changelog-template.md\",\n321:         \"sk-create-changelog/references/README.md\",\n322:         \"sk-create-changelog/references/topology-edge-cases.md\",\n323:         \"sk-create-changelog/references/version-bump-rules.md\",\n324:         \"sk-create-changelog/references/worked-examples.md\",\n325:         \"sk