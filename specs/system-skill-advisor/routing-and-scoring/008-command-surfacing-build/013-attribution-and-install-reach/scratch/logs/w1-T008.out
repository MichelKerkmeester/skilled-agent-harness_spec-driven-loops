is a separate answer from the offer: only a row whose\n+      // line carries no offer field at all lands here.\n+      if (result.offerUnknown) tally.offerUnknown += 1;\n     }\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n@@ -1316,7 +1321,8 @@ function writeSummary(summary, json) {\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n           + ` capped start rows ${block.cappedStartRows},`\n-          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n+          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n+          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n           + ` offer unknown ${block.offerUnknown},`\n           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n           + ` repeated ${block.repeatedCommandLines},`\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 6e7911360e..75e7827c95 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -726,6 +726,25 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // An offer is a fact about the head the turn saw, so it counts even when the cap\n+  // stopped the turn before it could take the command. The capped row is kept out\n+  // of the take rate rather than read as a command the turn turned down.\n+  it('counts an offer on a capped row apart from the starts taken', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n+      },\n+    });\n+  });\n+\n   // A run whose log captured no session id names no transcript to read, so the\n   // reader's own code is the reason the summary reports, never the exit code the\n   // turn happened to end with.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"}"},"time":{"start":1794545876301,"end":1794545877285}}}}
