 writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n67: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n68: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n69: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n70: \n71: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n72: const COMMANDS_DIR = '.skilled/commands';\n73: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n74: // beside the commands is itself a command, so the skip is case-sensitive.\n75: const COMMAND_DOC_SKIP = 'README.md';\n76: const COMMAND_DOC_SUFFIX = '.md';\n77: // The compiled route is asked for through the public front door a hub's SKILL.md\n78: // calls, so this measures the decision the runtime actually serves rather than a\n79: // second derivation of it that could disagree with the first.\n80: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n[Output truncated. Continue reading with offset: 81]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\",\"limit\":80}"},"time":{"start":1794544466160,"end":1794544467932}}}}
