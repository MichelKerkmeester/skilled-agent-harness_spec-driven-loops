{"type":"tool_use","timestamp":1794545741850,"sessionID":"ses_e2cbe0c22ffeTFkKaq2FPcs2LC","part":{"partID":"prt_1d342ecee001UOLsdIWto4jnx3","sessionID":"ses_e2cbe0c22ffeTFkKaq2FPcs2LC","messageID":"msg_1d342c148001bVa0SwsID81n7v","type":"tool","id":"call_6134c3df59264e72b41d7c84","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/pi.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/pi.mjs, lines 1-275\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Session Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // Pi exposes its live branch in-process, so the current session needs no disk\n5: // read at all. An older session is found only by an exact header id inside the\n6: // caller's project directory. The header's `cwd` is the tie-breaker because\n7: // separator flattening lets two projects share one directory name.\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: import { Buffer } from 'node:buffer';\n14: import { closeSync, openSync, readFileSync, readSync, readdirSync, statSync } from 'node:fs';\n15: import { join } from 'node:path';\n16: import {\n17:   guardSessionPath,\n18:   homeDir,\n19:   isSafeSessionId,\n20:   samePath,\n21: } from './identity.mjs';\n22: import {\n23:   contentText,\n24:   parseJsonObject,\n25:   textBlock,\n26:   thinkingBlock,\n27:   toolCallBlock,\n28: } from './project.mjs';\n29: \n30: // ─────────────────────────────────────────────────────────────────────────────\n31: // 2. CONSTANTS\n32: // ─────────────────────────────────────────────────────────────────────────────\n33: \n34: const RUNTIME = 'pi';\n35: // One vocabulary across the capability table and both source envelopes.\n36: const LOCATOR_KIND = 'live_branch_or_session_log';\n37: const TRANSCRIPT_EXT = '.jsonl';\n38: const HEADER_PROBE_BYTES = 64 * 1024;\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 3. STORE\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: export function piStoreRoot(options = {}) {\n45:   return options.piRoot ?? join(homeDir(options), '.pi', 'agent', 'sessions');\n46: }\n47: \n48: export function piProjectDirectory(projectDir) {\n49:   const projectKey = projectDir.replace(/^\\/+/, '').replaceAll('/', '-');\n50:   return '--' + projectKey + '--';\n51: }\n52: \n53: function headerOf(filePath) {\n54:   // Only the first line is needed, so the probe reads a bounded prefix rather\n55:   // than a whole session file that may run to many megabytes.\n56:   const buffer = Buffer.alloc(HEADER_PROBE_BYTES);\n57:   const fd = openSync(filePath, 'r');\n58:   let length;\n59:   try {\n60:     length = readSync(fd, buffer, 0, HEADER_PROBE_BYTES, 0);\n61:   } finally {\n62:     closeSync(fd);\n63:   }\n64:   const head = buffer.subarray(0, length).toString('utf8');\n65:   return parseJsonObject(head.split('\\n')[0]);\n66: }\n67: \n68: // Session file names start with their creation time and end with the session\n69: // id, so the id filters candidates before any file is opened.\n70: function idFromFileName(fileName) {\n71:   const withoutExtension = fileName.endsWith(TRANSCRIPT_EXT)\n72:     ? fileName.slice(0, -TRANSCRIPT_EXT.length)\n73:     : fileName;\n74:   const separator = withoutExtension.indexOf('_');\n75:   return separator === -1 ? withoutExtension : withoutExtension.slice(separator + 1) || withoutExtension;\n76: }\n77: \n78: function liveSessionId(sessionManager) {\n79:   if (!sessionManager || typeof sessionManager !== 'object') return null;\n80:   const value = typeof sessionManager.getSessionId === 'function'\n81:     ? sessionManager.getSessionId()\n82:     : sessionManager.sessionId;\n83:   return typeof value === 'string' && value ? value : null;\n84: }\n85: \n86: function branchEntries(sessionManager) {\n87:   if (typeof sessionManager.getBranch === 'function') return sessionManager.getBranch();\n88:   if (Array.isArray(sessionManager.branch)) return sessionManager.branch;\n89:   return null;\n90: }\n91: \n92: // ─────────────────────────────────────────────────────────────────────────────\n93: // 4. ENTRY MAPPING\n94: // ─────────────────────────────────────────────────────────────────────────────\n95: \n96: function assistantBlocks(content) {\n97:   const blocks = [];\n98:   for (const item of Array.isArray(content) ? content : []) {\n99:     if (!item || typeof item !== 'object') continue;\n100:     if (item.type === 'text' && typeof item.text === 'string') {\n101:       blocks.push(textBlock(item.text));\n102:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n103:       blocks.push(thinkingBlock(item.thinking));\n104:     } else if (item.type === 'toolCall' && typeof item.id === 'string' && typeof item.name === 'string') {\n105:       blocks.push(toolCallBlock({ id: item.id, name: item.name, arguments: item.arguments }));\n106:     }\n107:   }\n108:   return blocks;\n109: }\n110: \n111: function recordsFromLines(lines) {\n112:   const records = [];\n113: \n114:   lines.forEach((line, index) => {\n115:     if (line?.type !== 'message' || !line.message || typeof line.message !== 'object') return;\n116:     const message = line.message;\n117:     const id = typeof line.id === 'string' && line.id ? line.id : `pi-entry-${index}`;\n118:     const timestamp = line.timestamp;\n119: \n120:     if (message.role === 'user') {\n121:       const blocks = [];\n122:       for (const item of Array.isArray(message.content) ? message.content : []) {\n123:         if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n124:       }\n125:       // Pi records harness injections as their own `custom_message` entry type,\n126:       // which this mapping never reads, so a user message is operator content\n127:       // even when it opens with '<'.\n128:       const text = contentText(blocks);\n129:       if (!text) return;\n130:       records.push({ id, role: 'user', timestamp, content: blocks });\n131:       return;\n132:     }\n133: \n134:     if (message.role === 'assistant') {\n135:       const blocks = assistantBlocks(message.content);\n136:       if (blocks.length === 0) return;\n137:       records.push({ id, role: 'assistant', timestamp, content: blocks });\n138:       return;\n139:     }\n140: \n141:     if (message.role === 'toolResult') {\n142:       if (typeof message.toolCallId !== 'string' || !message.toolCallId) return;\n143:       const blocks = [];\n144:       for (const item of Array.isArray(message.content) ? message.content : []) {\n145:         if (item?.type === 'text' && typeof item.text === 'string') blocks.push(textBlock(item.text));\n146:       }\n147:       const record = {\n148:         id,\n149:         role: 'toolResult',\n150:         timestamp,\n151:         content: blocks.length > 0 ? blocks : [textBlock(contentText(message.content))],\n152:         toolCallId: message.toolCallId,\n153:       };\n154:       if (message.isError === true) record.isError = true;\n155:       records.push(record);\n156:     }\n157:   });\n158: \n159:   return records;\n160: }\n161: \n162: // ─────────────────────────────────────────────────────────────────────────────\n163: // 5. LOADER\n164: // ─────────────────────────────────────────────────────────────────────────────\n165: \n166: function liveResult({ sessionId, sessionManager, options }) {\n167:   const entries = branchEntries(sessionManager);\n168:   if (!Array.isArray(entries)) return { ok: false, code: 'store_unreadable' };\n169:   if (entries.length === 0) return { ok: false, code: 'session_not_found' };\n170:   return {\n171:     ok: true,\n172:     source: {\n173:       runtime: RUNTIME,\n174:       sessionId,\n175:       locatorKind: LOCATOR_KIND,\n176:       mode: 'live',\n177:       storePath: typeof sessionManager.getSessionFile === 'function'\n178:         ? String(sessionManager.getSessionFile())\n179:         : piStoreRoot(options),\n180:     },\n181:     records: recordsFromLines(entries),\n182:   };\n183: }\n184: \n185: function diskResult({ sessionId, projectDir, options }) {\n186:   if (typeof projectDir !== 'string' || !projectDir.trim()) {\n187:     return { ok: false, code: 'locator_unavailable' };\n188:   }\n189: \n190:   const root = piStoreRoot(options);\n191:   const directory = join(root, piProjectDirectory(projectDir));\n192: \n193:   let names;\n194:   try {\n195:     names = readdirSync(directory);\n196:   } catch {\n197:     // A missing root means the store itself cannot be read; a known root with\n198:     // no project directory means this project simply has no saved session.\n199:     try {\n200:       statSync(root);\n201:       return { ok: false, code: 'session_not_found' };\n202:     } catch {\n203:       return { ok: false, code: 'store_unreadable' };\n204:     }\n205:   }\n206: \n207:   const candidates = names.filter(\n208:     (name) => name.endsWith(TRANSCRIPT_EXT) && idFromFileName(name) === sessionId,\n209:   );\n210:   if (candidates.length === 0) return { ok: false, code: 'session_not_found' };\n211:   // Two files that decode to one id are two possible sessions, and neither the\n212:   // name nor the header can choose between them, so a recovery read refuses\n213:   // rather than guessing.\n214:   if (candidates.length > 1) return { ok: false, code: 'session_ambiguous' };\n215: \n216:   const filePath = join(directory, candidates[0]);\n217:   let header;\n218:   try {\n219:     header = headerOf(filePath);\n220:   } catch {\n221:     return { ok: false, code: 'store_unreadable' };\n222:   }\n223: \n224:   if (header?.type !== 'session' || header.id !== sessionId) {\n225:     return { ok: false, code: 'session_mismatch' };\n226:   }\n227:   if (!samePath(header.cwd, projectDir)) {\n228:     return { ok: false, code: 'session_mismatch' };\n229:   }\n230: \n231:   const guard = guardSessionPath({\n232:     path: filePath,\n233:     root,\n234:     sessionId,\n235:     recordedId: header.id,\n236:   });\n237:   if (!guard.ok) return guard;\n238: \n239:   let raw;\n240:   try {\n241:     raw = readFileSync(filePath, 'utf8');\n242:   } catch {\n243:     return { ok: false, code: 'store_unreadable' };\n244:   }\n245: \n246:   const lines = [];\n247:   for (const line of raw.split('\\n')) {\n248:     if (!line.trim()) continue;\n249:     const parsed = parseJsonObject(line);\n250:     if (parsed) lines.push(parsed);\n251:   }\n252: \n253:   return {\n254:     ok: true,\n255:     source: {\n256:       runtime: RUNTIME,\n257:       sessionId,\n258:       locatorKind: LOCATOR_KIND,\n259:       mode: 'disk',\n260:       storePath: guard.path,\n261:     },\n262:     records: recordsFromLines(lines),\n263:   };\n264: }\n265: \n266: export function loadPiSession({ sessionId, projectDir, sessionManager, ...options } = {}) {\n267:   if (!isSafeSessionId(sessionId)) {\n268:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n269:   }\n270: \n271:   if (sessionManager && liveSessionId(sessionManager) === sessionId) {\n272:     return liveResult({ sessionId, sessionManager, options });\n273:   }\n274:   return diskResult({ sessionId, projectDir, options });\n275: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/pi.mjs, lines 1-275\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Session Reader\n3: // ───────────────────────────────