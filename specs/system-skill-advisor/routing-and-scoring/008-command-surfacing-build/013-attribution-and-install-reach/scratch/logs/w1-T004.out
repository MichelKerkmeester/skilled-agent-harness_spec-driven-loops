{"type":"tool_use","timestamp":1794545853180,"sessionID":"ses_e2cbe0c22ffeTFkKaq2FPcs2LC","part":{"partID":"prt_1d344a020001D6Y0oJFe9F582m","sessionID":"ses_e2cbe0c22ffeTFkKaq2FPcs2LC","messageID":"msg_1d3449003001aF1BYcZIa46MDP","type":"tool","id":"call_66be2f74a12e4fcb87d23f3d","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/hooks/shared/session-readers/pi.mjs .skilled/hooks/shared/tests/session-readers/pi.test.mjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/hooks/shared/session-readers/pi.mjs b/.skilled/hooks/shared/session-readers/pi.mjs\nindex acd7bdaa4a..97d8fe32ba 100644\n--- a/.skilled/hooks/shared/session-readers/pi.mjs\n+++ b/.skilled/hooks/shared/session-readers/pi.mjs\n@@ -159,6 +159,20 @@ function recordsFromLines(lines) {\n   return records;\n }\n \n+// A `custom_message` is context a hook or harness put into the session rather\n+// than a turn the operator wrote, so it stays out of `records` and travels as\n+// its own list. The custom type names the producer when the entry carries one.\n+function injectedFromLines(lines) {\n+  const injected = [];\n+  for (const line of lines) {\n+    if (line?.type !== 'custom_message') continue;\n+    const text = contentText(line.content);\n+    if (!text) continue;\n+    injected.push({ source: line.customType ?? 'custom_message', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 5. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -179,6 +193,7 @@ function liveResult({ sessionId, sessionManager, options }) {\n         : piStoreRoot(options),\n     },\n     records: recordsFromLines(entries),\n+    injected: injectedFromLines(entries),\n   };\n }\n \n@@ -260,6 +275,7 @@ function diskResult({ sessionId, projectDir, options }) {\n       storePath: guard.path,\n     },\n     records: recordsFromLines(lines),\n+    injected: injectedFromLines(lines),\n   };\n }\n \ndiff --git a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\nindex 3863c96376..3068fc3920 100644\n--- a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n@@ -7,15 +7,19 @@\n // is part of the identity.\n \n import assert from 'node:assert/strict';\n-import { mkdirSync } from 'node:fs';\n+import { appendFileSync, mkdirSync } from 'node:fs';\n import { join } from 'node:path';\n import { test } from 'node:test';\n \n import { capabilities, readSession } from '../../session-readers/index.mjs';\n-import { piProjectDirectory } from '../../session-readers/pi.mjs';\n+import { loadPiSession, piProjectDirectory } from '../../session-readers/pi.mjs';\n import { DECOY, piSession, SESSION, T0 } from './fixtures.mjs';\n import { withTempAsync } from './helpers.mjs';\n \n+// The head of a live advisor brief, used as the text a harness injects into a\n+// session through an entry that is not a turn.\n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n // The fixtures build store folders with the reader's own key helper, so this\n // pins the helper to a folder name a real Pi install wrote.\n test('the project folder name matches the one Pi writes', () => {\n@@ -108,3 +112,25 @@ test('a missing store is a store_unreadable', async () => {\n     assert.equal(result.code, 'store_unreadable');\n   });\n });\n+\n+test('a custom_message entry is injected context, not a turn', async () => {\n+  await withTempAsync('pi-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+    appendFileSync(\n+      fixture.filePath,\n+      JSON.stringify({\n+        type: 'custom_message',\n+        customType: 'session-start-context',\n+        id: 'pi-context',\n+        content: BRIEF,\n+      }) + '\\n',\n+    );\n+\n+    const result = await loadPiSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'session-start-context', text: BRIEF }]);\n+    assert.equal(result.records.some((record) => record.id === 'pi-context'), false);\n+  });\n+});\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/hooks/shared/session-readers/pi.mjs b/.skilled/hooks/shared/session-readers/pi.mjs\nindex acd7bdaa4a..97d8fe32ba 100644\n--- a/.skilled/hooks/shared/session-readers/pi.mjs\n+++ b/.skilled/hooks/shared/session-readers/pi.mjs\n@@ -159,6 +159,20 @@ function recordsFromLines(lines) {\n   return records;\n }\n \n+// A `custom_message` is context a hook or harness put into the session rather\n+// than a turn the operator wrote, so it stays out of `records` and travels as\n+// its own list. The custom type names the producer when the entry carries one.\n+function injectedFromLines(lines) {\n+  const injected = [];\n+  for (const line of lines) {\n+    if (line?.type !== 'custom_message') continue;\n+    const text = contentText(line.content);\n+    if (!text) continue;\n+    injected.push({ source: line.customType ?? 'custom_message', text });\n+  }\n+  return injected;\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 5. LOADER\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -179,6 +193,7 @@ function liveResult({ sessionId, sessionManager, options }) {\n         : piStoreRoot(options),\n     },\n     records: recordsFromLines(entries),\n+    injected: injectedFromLines(entries),\n   };\n }\n \n@@ -260,6 +275,7 @@ function diskResult({ sessionId, projectDir, options }) {\n       storePath: guard.path,\n     },\n     records: recordsFromLines(lines),\n+    injected: injectedFromLines(lines),\n   };\n }\n \ndiff --git a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\nindex 3863c96376..3068fc3920 100644\n--- a/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n+++ b/.skilled/hooks/shared/tests/session-readers/pi.test.mjs\n@@ -7,15 +7,19 @@\n // is part of the identity.\n \n import assert from 'node:assert/strict';\n-import { mkdirSync } from 'node:fs';\n+import { appendFileSync, mkdirSync } from 'node:fs';\n import { join } from 'node:path';\n import { test } from 'node:test';\n \n import { capabilities, readSession } from '../../session-readers/index.mjs';\n-import { piProjectDirectory } from '../../session-readers/pi.mjs';\n+import { loadPiSession, piProjectDirectory } from '../../session-readers/pi.mjs';\n import { DECOY, piSession, SESSION, T0 } from './fixtures.mjs';\n import { withTempAsync } from './helpers.mjs';\n \n+// The head of a live advisor brief, used as the text a harness injects into a\n+// session through an entry that is not a turn.\n+const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n+\n // The fixtures build store folders with the reader's own key helper, so this\n // pins the helper to a folder name a real Pi install wrote.\n test('the project folder name matches the one Pi writes', () => {\n@@ -108,3 +112,25 @@ test('a missing store is a store_unreadable', async () => {\n     assert.equal(result.code, 'store_unreadable');\n   });\n });\n+\n+test('a custom_message entry is injected context, not a turn', async () => {\n+  await withTempAsync('pi-injected', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = piSession({ root, projectDir });\n+    appendFileSync(\n+      fixture.filePath,\n+      JSON.stringify({\n+        type: 'custom_message',\n+        customType: 'session-start-context',\n+        id: 'pi-context',\n+        content: BRIEF,\n+      }) + '\\n',\n+    );\n+\n+    const result = await loadPiSession({ sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.deepEqual(result.injected, [{ source: 'session-start-context', text: BRIEF }]);\n+    assert.equal(result.records.some((record) => record.id === 'pi-context'), false);\n+  });\n+});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/hooks/shared/session-readers/pi.mjs .skilled/hooks/shared/tests/session-readers/pi.test.mjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794545852448,"end":1794545853180}}}}
