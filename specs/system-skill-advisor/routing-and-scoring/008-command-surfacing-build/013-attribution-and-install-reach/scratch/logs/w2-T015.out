ds/tsdoc-errors-and-async.md\",\n329:         \"sk-code-skilled/references/typescript/quality-standards/tsconfig-and-modules.md\",\n330:         \"sk-code-skilled/references/typescript/quick-reference/template-naming-and-types.md\",\n331:         \"sk-code-skilled/references/typescript/quick-reference/imports-errors-and-tsconfig.md\",\n332:     ],\n333:     \"PYTHON\": [\n334:         \"sk-code-skilled/references/python/style-guide.md\",\n335:         \"sk-code-skilled/references/python/quality-standards.md\",\n336:         \"sk-code-skilled/references/python/quick-reference.md\",\n337:     ],\n338:     \"SHELL\": [\n339:         \"sk-code-skilled/references/shell/style-guide/overview-structure-and-naming.md\",\n340:         \"sk-code-skilled/references/shell/style-guide/variables-functions-and-output.md\",\n341:         \"sk-code-skilled/references/shell/quality-standards/overview-and-priority-blockers.md\",\n342:         \"sk-code-skilled/references/shell/quality-standards/validation-security-and-shellcheck.md\",\n343:         \"sk-code-skilled/references/shell/quick-reference/template-variables-and-loops.md\",\n344:         \"sk-code-skilled/references/shell/quick-reference/functions-strings-and-checklist.md\",\n345:     ],\n346:     \"RUST\": [\n347:         \"sk-code-skilled/references/rust/style-guide/overview-and-file-header.md\",\n348:         \"sk-code-skilled/references/rust/style-guide/toolchain-and-project-structure.md\",\n349:         \"sk-code-skilled/references/rust/style-guide/naming-conventions.md\",\n350:         \"sk-code-skilled/references/rust/style-guide/formatting-and-imports.md\",\n351:         \"sk-code-skilled/references/rust/style-guide/commenting-and-rustdoc.md\",\n352:         \"sk-code-skilled/references/rust/style-guide/interop-model.md\",\n353:         \"sk-code-skilled/references/rust/style-guide/interop-errors-and-parity.md\",\n354:         \"sk-code-skilled/references/rust/quality-standards/overview-and-data-ownership.md\",\n355:         \"sk-code-skilled/references/rust/quality-standards/modeling-collections-and-api.md\",\n356:         \"sk-code-skilled/references/rust/quality-standards/docs-errors-and-async.md\",\n357:         \"sk-code-skilled/references/rust/quality-standards/build-and-organization.md\",\n358:         \"sk-code-skilled/references/rust/quality-standards/determinism-and-parity.md\",\n359:         \"sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md\",\n360:         \"sk-code-skilled/references/rust/quick-reference/naming-ordering-and-signatures.md\",\n361:         \"sk-code-skilled/references/rust/quick-reference/collections-imports-and-errors.md\",\n362:         \"sk-code-skilled/references/rust/quick-reference/rustdoc-and-cargo.md\",\n363:         \"sk-code-skilled/references/rust/quick-reference/determinism-parity-and-related.md\",\n364:     ],\n365:     \"CI_WORKFLOW\": [\n366:         \"sk-code-ci/references/ci-workflow-standards.md\",\n367:         \"sk-code-ci/references/trigger-and-filter-rules.md\",\n368:         \"sk-code-ci/references/job-shape-rules.md\",\n369:         \"sk-code-ci/references/protected-set.md\",\n370:     ],\n371:     \"FRONTEND_WEB\": [\n372:         \"sk-code-frontend/references/frontend-practice.md\",\n373:         \"sk-code-frontend/references/web-markup-and-css.md\",\n374:     ],\n375:     \"WEB_ELEMENTS\": [\n376:         \"sk-code-frontend/references/frontend-practice.md\",\n377:         \"sk-code-frontend/references/web-markup-and-css.md\",\n378:         \"sk-code-frontend/references/web-elements-and-attributes.md\",\n379:     ],\n380:     \"WEB_CASCADE\": [\n381:         \"sk-code-frontend/references/frontend-practice.md\",\n382:         \"sk-code-frontend/references/web-markup-and-css.md\",\n383:         \"sk-code-frontend/references/web-cascade-and-selectors.md\",\n384:     ],\n385:     \"WEB_LAYOUT\": [\n386:         \"sk-code-frontend/references/frontend-practice.md\",\n387:         \"sk-code-frontend/references/web-markup-and-css.md\",\n388:         \"sk-code-frontend/references/web-layout-and-sizing.md\",\n389:     ],\n390:     \"WEB_A11Y\": [\n391:         \"sk-code-frontend/references/frontend-practice.md\",\n392:         \"sk-code-frontend/references/web-markup-and-css.md\",\n393:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n394:     ],\n395:     \"WEB_PERF\": [\n396:         \"sk-code-frontend/references/frontend-practice.md\",\n397:         \"sk-code-frontend/references/web-markup-and-css.md\",\n398:         \"sk-code-frontend/references/web-performance-and-loading.md\",\n399:     ],\n400:     \"WEB_I18N\": [\n401:         \"sk-code-frontend/references/frontend-practice.md\",\n402:         \"sk-code-frontend/references/web-markup-and-css.md\",\n403:         \"sk-code-frontend/references/web-internationalization.md\",\n404:     ],\n405:     \"WEB_VISUAL_VALUES\": [\n406:         \"sk-code-frontend/references/frontend-practice.md\",\n407:         \"sk-code-frontend/references/web-visual-values.md\",\n408:     ],\n409:     \"WEB_VISUAL_HIERARCHY\": [\n410:         \"sk-code-frontend/references/frontend-practice.md\",\n411:         \"sk-code-frontend/references/web-visual-hierarchy.md\",\n412:         \"sk-code-frontend/references/web-visual-values.md\",\n413:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n414:     ],\n415:     \"WEB_MOTION\": [\n416:         \"sk-code-frontend/references/frontend-practice.md\",\n417:         \"sk-code-frontend/references/web-motion-and-interaction.md\",\n418:     ],\n419:     \"FIGMA_TO_CODE\": [\n420:         \"sk-code-frontend/references/figma-to-code.md\",\n421:         \"sk-code-frontend/references/frontend-practice.md\",\n422:     ],\n423: }\n424: \n425: # Hub-level shared controls, declared once here. This list holds every\n426: # contained shared/ path that RESOURCE_MAP references but that is exempt from\n427: # typed-leaf projection, because it has no single packet owner. The root-router\n428: # contract validates each entry and requires RESOURCE_MAP to reference it.\n429: # DEFAULT_RESOURCE above is the other half of the set: its always-loaded\n430: # preamble paths are hub-level controls too. No other shared/ path is a\n431: # control, so a guard that needs the control set reads these two lists.\n432: SHARED_CONTROL_RESOURCES = [\n433:     \"shared/references/universal/code-quality-standards.md\",\n434:     \"shared/references/universal/rule-overrides.md\",\n435:     \"shared/references/workflow-debug.md\",\n436:     \"shared/references/workflow-verify.md\",\n437: ]\n438: ```\n439: \n440: ### Surface-aware loading (route-time)\n441: \n442: The router does NOT load the whole matched-intent union. After surface detection (§1, `stack-detection.md`), a route loads:\n443: \n444: - the always-loaded `DEFAULT_RESOURCE` preamble (stack/phase detection and the universal quality baseline), plus\n445: - the `shared/` entries the matched intents map (for example `code-quality-standards.md` under CODE_QUALITY, `workflow-debug.md` under DEBUGGING and `workflow-verify.md` under VERIFICATION), never the whole `shared/references/universal/` folder, plus\n446: - only the **detected surface's** slice (`<surface>/references/*`) for the matched intents.\n447: \n448: - It does not load another surface's resources.\n449: - It defers `assets/*` (checklists, recipes, templates) to on-demand rather than the first slice.\n450: - Within SKILLED it slices once more by the **detected language** (§1 sub-detection): a TypeScript task loads `sk-code-skilled/references/typescript/*` plus the language-agnostic `sk-code-skilled/references/shared/*`, not the Python, shell, config, or JavaScript folders.\n451: - An `UNKNOWN` surface falls back to the preamble plus the shared-tier entries its matched intents map.\n452: \n453: This is what stops a routine single-surface task from pulling the full cross-surface set. The deterministic router-replay enforces the same rule, so the benchmark measures it.\n454: \n455: ---\n456: \n457: ## 9. HOW TO READ THIS\n458: \n459: - Every code task first loads the always-on preamble (stack + phase detection and the universal quality baseline); routing then narrows to the detected surface's slice for the matched intents.\n460: - One dominant intent on one surface loads that surface's slice; two near-tied intents (within the router's ambiguity delta) load both intent sets, deduped by canonical pair.\n461: - A single-surface task never pulls another surface's resources.\n462: - No keyword match, or an `UNKNOWN` surface, falls back to the preamble plus the shared-tier entries its matched intents map — confirm the surface and intent before loading more. See §6 (UNKNOWN FALLBACK) and §7 (LOADING DISCIPLINE) for the full rules.\n463: \n464: ---\n465: \n466: ## 10. RELATED RESOURCES\n467: \n468: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) + SKILLED language sub-detection\n469: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and per-phase resource loading\n470: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n471: - Barter equivalent: `barter/.skilled/skills/sk-code/shared/references/smart-routing.md` (different routing key — git-remote project — but same structural pattern)\n472: \n473: ---\n474: \n475: ## 11. MACHINE ROUTER\n476: \n477: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 8 stays the only replay source.\n478: \n479: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n480: > ```bash\n481: > node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"\n482: > ```\n483: > Follow the returned decision: `route` (use its `targets`), `clarify`/`defer` (disambiguate) or `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-code`. Set `SPECKIT_COMPILED_ROUTING=0`, the explicit kill-switch, to force legacy routing fleet-wide.\n484: \n485: **Session surface hint.** Before you call the front door, run the surface detection in [`stack-detection.md`](shared/references/stack-detection.md) on the session's working directory and the files it is editing.\n486: Then add its result as `--surface-hint <SURFACE>`, for example `--surface-hint SKILLED`.\n487: When the prompt's keywords tie between surfaces, a hinted specific surface leads them.\n488: Workflow modes keep first place, and the targets and the bundle kind stay the same.\n489: `SKILLED` is the fallback surface and always ranks last, so a `SKILLED` hint changes nothing.\n490: With `UNKNOWN`, no hint or a surface the prompt did not match, the `routerPolicy.tieBreak` order applies.\n491: \n492: ### Surface Router: per-intent leaf sets\n493: \n494: Root `ROUTER.md` owns the second-stage `INTENT_SIGNALS` / `RESOURCE_MAP`, while packet-owned resources stay typed through `leaf-manifest.json`.\n495: The hub-level shared controls are declared once, in `ROUTER.md` §8: the `SHARED_CONTROL_RESOURCES` list plus the always-loaded `DEFAULT_RESOURCE` preamble. They resolve on disk but never project as leaves.\n496: The hub router keeps stage-one mode selection and its `shared/README.md` fallback.\n497: \n498: ### The discriminator\n499: - **`workflowMode`** - the public mode/packet key: `sk-code-quality`, `sk-code-review` (workflow) or `sk-code-ci`, `sk-code-frontend`, `sk-code-skilled` (surface).\n500: - **`packetKind`** - the axis: `workflow` (a mode that acts) or `surface` (read-only evidence bundled alongside a mode).\n501: - **`backendKind`** - which backend runs the packet: `surface-router` or `review-cache` for workflow modes, `evidence-base` for surface packets.\n502: \n503: Surface packets are advisor-invisible (`routingClass: metadata`, read-only `toolSurface`).\n504: The advisor still routes the single identity `sk-code`, and the hub bundles zero-or-more surfaces as evidence via `routerPolicy.outcomes.surfaceBundle`.\n505: The workflow mode comes first, followed by surfaces.\n506: \"review my typescript module for jank\" → `[sk-code-review, sk-code-skilled]`.\n507: Bundled surfaces follow the `routerPolicy.tieBreak` order. It ranks `sk-code-frontend` ahead of `sk-code-ci`, then `sk-code-skilled` last, because a new surface goes ahead of the existing ones and the SKILLED fallback stays last.\n508: \n509: ### Surface detection\n510: \n511: Surface detection lives once in the hub's `shared/` layer and every mode and surface consumes it.\n512: It tries every declared specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n513: When a specific surface and `SKILLED` both match, the specific one leads and `SKILLED` comes along as second evidence.\n514: Each surface declares its markers in a `surfaceDetection` block in `mode-registry.json`, or in its own `graph-metadata.json` when it lives outside the hub.\n515: Modes own workflow contracts, not surface identity.\n516: `sk-code-ci` and `sk-code-frontend` are the surfaces that stack detection does not select. The hub bundles both from request vocabulary alone: CI through `code-ci-aliases` and `code-ci-runtime`, and Frontend through `code-frontend-aliases` in `hub-router.json`.\n517: \n518: ### Fallback route\n519: \n520: When no workflow mode dominates (a bare implement/debug/verify request), the router defers to a pure surface bundle: it detects the surface, loads that surface's evidence and workflow doctrine, and the agent acts. `routerPolicy.defaultMode` is `null`, so the hub does not force a stale default. An unclear code intent asks for disambiguation.\n521: \n522: Per-mode behavior is **not flattened**: each packet keeps its own code-work contract, standards, evidence rules, and tool-permission guards.\n523: \n524: ### Routing rule\n525: ```python\n526: from pathlib import Path\n527: \n528: SKILL_ROOT = Path(__file__).resolve().parent\n529: UNKNOWN_FALLBACK_CHECKLIST = [\n530:     \"Confirm whether this is sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend or sk-code-skilled work\",\n531:     \"Confirm the target files or runtime surface\",\n532:     \"Confirm the expected action: implement, debug, verify, quality gate, or review\",\n533:     \"Confirm the verification command set before completion\",\n534: ]\n535: \n536: def _guard_in_skill(relative_path: str) -> str:\n537:     resolved = (SKILL_ROOT / relative_path).resolve()\n538:     resolved.relative_to(SKILL_ROOT)\n539:     if resolved.name != \"SKILL.md\" and resolved.suffix.lower() != \".md\":\n540:         raise ValueError(f\"Only markdown skill resources are routable: {relative_path}\")\n541:     return resolved.relative_to(SKILL_ROOT).as_posix()\n542: \n543: def load_if_available(relative_path: str, loaded: list[str], seen: set[str]) -> None:\n544:     guarded = _guard_in_skill(relative_path)\n545:     path = SKILL_ROOT / guarded\n546:     if path.exists() and guarded not in seen:\n547:         load(guarded)\n548:         loaded.append(guarded)\n549:         seen.add(guarded)\n550: \n551: def route(task):\n552:     loaded, seen = [], set()\n553:     registry = read_json(SKILL_ROOT / \"mode-registry.json\")\n554:     workflow_mode = explicit_mode_hint(task) or classify_workflow_mode(task)\n555: \n556:     if not workflow_mode:\n557:         load_if_available(\"shared/README.md\", loaded, seen)\n558:         return {\n559:             \"load_level\": \"UNKNOWN_FALLBACK\",\n560:             \"needs_disambiguation\": True,\n561:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n562:             \"resources\": loaded,\n563:         }\n564: \n565:     entry = find_registry_entry(registry, workflowMode=workflow_mode)\n566:     if not entry:\n567:         load_if_available(\"shared/README.md\", loaded, seen)\n568:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"unknown_mode\": workflow_mode, \"resources\": loaded}\n569: \n570:     packet_skill = f\"{entry['packet']}/SKILL.md\"\n571:     load_if_available(packet_skill, loaded, seen)\n572: \n573:     for surface_mode in surface_bundle_from_hub_router(task):\n574:         surface_entry = find_registry_entry(registry, workflowMode=surface_mode)\n575:         if surface_entry:\n576:             load_if_available(f\"{surface_entry['packet']}/SKILL.md\", loaded, seen)\n577: \n578:     if not loaded:\n579:         load_if_available(\"shared/README.md\", loaded, seen)\n580:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"notice\": \"matched registry but no packet SKILL.md was available\", \"resources\": loaded}\n581: \n582:     return {\"workflowMode\": workflow_mode, \"backendKind\": entry[\"backendKind\"], \"resources\": loaded}\n583: ```","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md, lines 1-583\n1: ---\n2: title: sk-code Surface Router — routing logic and resource maps\n3: description: First-class surface router document at the sk-code hub root (ROUTER.md). hub-router.json selects the workflow mode; this doc maps a request's code intent to the exact packet-local leaf resources that mode should load, emitting canonical (workflowMode, leafResourceId) pairs. Relocated from shared/references/smart-routing.md (v3.5.0.8) as the ROUTER.md consolidation pattern, with the approved sk-code shared-control delta (router self-reference removed, ten hub-shared paths normalized to shared/..., mapped shared controls declared).\n4: trigger_phrases:\n5:   - \"sk-code smart routing\"\n6:   - \"surface resource maps\"\n7:   - \"intent classification routing\"\n8:   - \"load tier resource loading\"\n9:   - \"unknown surface fallback\"\n10: importance_tier: important\n11: contextType: general\n12: version: 2.3.19.0\n13: router_state: active\n14: skill_pointer: SKILL.md\n15: ---\n16: # sk-code Surface Router — routing logic and resource maps\n17: \n18: Leaf-set authority for sk-code. The routing authority is named once in `SKILL.md` §2 SMART ROUTING: `hub-router.json` is the mode vocabulary, and this document is the leaf-set router. Consolidates intent classification + resource loading into the single Barter-style smart-routing entry point. Detection logic lives in [`stack-detection.md`](shared/references/stack-detection.md); phase lifecycle lives in [`phase-detection.md`](shared/references/phase-detection.md).\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: ### Purpose\n25: \n26: The smart router maps a detected surface (a declared specific surface, then the SKILLED fallback, then UNKNOWN) plus a classified intent (IMPLEMENTATION / DEBUGGING / VERIFICATION / etc.) to the exact references, assets, and verification commands needed for the active task. Loads only the smallest relevant set so the active context window stays focused.\n27: \n28: ### When to Use\n29: \n30: - After surface detection (see [`stack-detection.md`](shared/references/stack-detection.md)) determines the surface: a declared specific surface, then the SKILLED fallback, then UNKNOWN\n31: - When classifying task wording into the dominant work intent\n32: - When mapping intent to concrete reference paths\n33: - When picking verification commands for the surface\n34: \n35: ### Core Principle\n36: \n37: Routing is a two-stage decision: **surface-first, intent-second**. Surface narrows the resource family: a declared specific surface first, then the SKILLED fallback, then UNKNOWN. Intent narrows the specific files within that family. The detected surface also goes to the compiled front door as `--surface-hint`. When a prompt ties between surfaces, a hinted specific surface leads the bundle. SKILLED already ranks last, so a SKILLED hint changes nothing (`SKILL.md` §3).\n38: \n39: ### Key Sources\n40: \n41: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) and SKILLED language sub-detection\n42: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and phase-specific resource expectations\n43: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n44: \n45: ---\n46: \n47: ## 2. INTENT MODEL\n48: \n49: Intent classification scores task text against weighted keyword signals to pick the dominant work type after surface detection. The vocabulary and weights are authored once, in the `INTENT_SIGNALS` block of §8 MACHINE-READABLE ROUTER; read them there. This section is the human-facing summary of how that block is scored, never a second copy of its keywords.\n50: \n51: ### Scoring algorithm\n52: \n53: 1. Sum weighted keyword hits from the request, target files, and known task context.\n54: 2. Boost explicit phase signals (verification, debugging, code quality) by +5 when the phase is unambiguous.\n55: 3. Select the top intent.\n56: 4. Select a second intent when the score delta to the next intent is small (`AMBIGUITY_DELTA = 1`).\n57: 5. For SKILLED surface, run language sub-detection after intent selection.\n58: \n59: ### Doc-only edit anti-signals\n60: \n61: Doc-only prose changes subtract from `sk-code` intent scoring and add to `sk-doc` scoring, even when the target file is under `.skilled/skills/`.\n62: \n63: | Prompt signal | Effect |\n64: | --- | --- |\n65: | `update headline`, `rewrite headline`, `headline section` | `sk-code -2`, `sk-doc +3` |\n66: | `clarify description`, `clarify the X model`, `documentation section` | `sk-code -2`, `sk-doc +3` |\n67: | `add a one-line summary`, `add summary at the top` | `sk-code -2`, `sk-doc +3` |\n68: | `improve readme`, `reorganize readme`, `rewrite section` | `sk-code -2`, `sk-doc +3` |\n69: | `SKILL.md` or `README.md` plus prose-only verbs | `sk-code -2`, `sk-doc +3` |\n70: \n71: Do not apply this anti-signal when the same request asks to modify executable code, parser logic, tests, shell behavior, TypeScript/Python entrypoints, JSON schema behavior, or routing algorithms. In that case, keep SKILLED surface detection and load `sk-code`.\n72: \n73: Multi-symptom prompts like `debug the broken jsonc descriptor` should load both DEBUGGING and CONFIG. Prompts like `update TypeScript advisor fixture` should load SKILLED plus TYPESCRIPT and CODE_QUALITY.\n74: \n75: ### Surface-specific intent notes\n76: \n77: - **SKILLED** intent scoring favors language standards, hooks, config, scripts, advisor/tests, metadata, and alignment verification.\n78: - Unsupported surfaces stay UNKNOWN even if intent scoring is strong.\n79: \n80: ---\n81: \n82: ## 3. LOAD TIERS\n83: \n84: | Tier | When | Resources |\n85: | --- | --- | --- |\n86: | ALWAYS | Every invocation | The §8 `DEFAULT_RESOURCE` preamble only: `shared/references/stack-detection.md`, `shared/references/phase-detection.md` and `shared/references/universal/code-quality-standards.md`. The style guide `sk-code-quality/references/code-style-guide.md` loads with CODE_QUALITY, and the shared doctrine loads with its intent: `workflow-debug.md` with DEBUGGING and `workflow-verify.md` with VERIFICATION |\n87: | SURFACE | After SKILLED detection | Surface-specific resources (`sk-code-skilled/references/shared/*`) |\n88: | INTENT | After intent classification | Implementation, debugging, verification, testing, etc. matching the top-1 intent (and top-2 when ambiguous) |\n89: | LANGUAGE | SKILLED only | Split JavaScript, TypeScript, Python, Shell, Rust, and Config standards from the matching `sk-code-skilled/references/<lang>/` resources |\n90: | ON_DEMAND | Explicit deep-dive keywords | Extended checklists and niche references (e.g. `sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md` for boundary templates) |\n91: \n92: ---\n93: \n94: ## 4. SKILLED MAP\n95: \n96: SKILLED loads from `sk-code-skilled/references/` and `sk-code-skilled/assets/`.\n97: \n98: ### Implementation shared tier\n99: \n100: IMPLEMENTATION loads the shared organization and naming baseline:\n101: \n102: - `sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md`\n103: - `sk-code-skilled/references/shared/code-organization/overview-and-module-organization.md`\n104: \n105: ### Intent overlay\n106: \n107: | Intent | Resources |\n108: | --- | --- |\n109: | CODE_QUALITY | SKILLED only: `sk-code-skilled/assets/checklists/universal-checklist.md` plus the language-matching checklist, both when SKILLED is a resolved surface. A foreign surface loads the floor in `code-quality-standards.md` and its own declared rows |\n110: | VERIFICATION | `sk-code-skilled/references/shared/alignment-verification-automation.md`, `sk-code-skilled/assets/scripts/verify_alignment_drift.py` |\n111: | HOOKS | `sk-code-skilled/references/shared/hooks.md` |\n112: | CONFIG | `sk-code-skilled/references/config/*` |\n113: | LANGUAGE_STANDARDS | Detected language folder's `quick-reference.md`, `style-guide.md`, `quality-standards.md` |\n114: \n115: ### Language overlay\n116: \n117: | Language | Resources |\n118: | --- | --- |\n119: | JAVASCRIPT | `sk-code-skilled/references/javascript/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/javascript-checklist.md` |\n120: | TYPESCRIPT | `sk-code-skilled/references/typescript/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/typescript-checklist.md` |\n121: | PYTHON | `sk-code-skilled/references/python/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/python-checklist.md` |\n122: | SHELL | `sk-code-skilled/references/shell/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/shell-checklist.md` |\n123: | RUST | `sk-code-skilled/references/rust/{style_guide,quality_standards,quick_reference}/` (each split into topic parts), `sk-code-skilled/assets/checklists/rust-checklist/` |\n124: | CONFIG | `sk-code-skilled/references/config/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/config-checklist.md` |\n125: \n126: ### Authoring checklist gating\n127: \n128: When SKILLED intent is `authoring-new-X`, additionally load the matching authoring checklist:\n129: \n130: | Authoring target | Checklist |\n131: | --- | --- |\n132: | New skill | `sk-code-skilled/assets/checklists/skill-authoring.md` |\n133: | New agent | `sk-code-skilled/assets/checklists/agent-authoring.md` |\n134: | New command | `sk-code-skilled/assets/checklists/command-authoring.md` |\n135: | New MCP server | `sk-code-skilled/assets/checklists/mcp-server-authoring.md` |\n136: | Spec folder write | Now in system-spec-kit: `system-spec-kit/references/workflows/spec-folder-authoring-checklist.md` + `system-spec-kit/references/workflows/spec-folder-write-recipe.md` |\n137: \n138: ### CI Workflow Map\n139: \n140: When the request names a GitHub Actions workflow, the hub bundles `sk-code-ci` from the request vocabulary and the `CI_WORKFLOW` intent loads its four rule references:\n141: \n142: | Resource | Carries |\n143: | --- | --- |\n144: | `sk-code-ci/references/ci-workflow-standards.md` | The rule index: path parity, SHA pins, README row, `set -euo pipefail`, fork and secret safety, matrix and `fail-fast` |\n145: | `sk-code-ci/references/trigger-and-filter-rules.md` | The twin rule, the rebuild-commit skip rule, push-only scope and the intentional exceptions table |\n146: | `sk-code-ci/references/job-shape-rules.md` | Timeouts, permissions, the concurrency template, the composite setup action and the switch `if:` shape |\n147: | `sk-code-ci/references/protected-set.md` | The repository CI profile and its keys, the workflows protected by function and the rules that follow |\n148: \n149: The map is the packet's own `RESOURCE_MAP` re-prefixed with `sk-code-ci/`, so the two stay equal.\n150: \n151: ### Frontend Map\n152: \n153: When a request asks about web frontend practice, or a Figma-to-code check, the hub bundles `sk-code-frontend` from request vocabulary alone:\n154: \n155: | Resource | Carries |\n156: | --- | --- |\n157: | `sk-code-frontend/references/frontend-practice.md` | The cross-stack core, token precedence, Figma boundary, and Frontend overrides contract |\n158: | `sk-code-frontend/references/web-markup-and-css.md` | The web stack layer for markup, forms, layout, responsive behavior, media, and CSS architecture |\n159: | `sk-code-frontend/references/web-elements-and-attributes.md` | Form autocomplete, dialog, and popover behavior |\n160: | `sk-code-frontend/references/web-cascade-and-selectors.md` | Cascade layers and specificity conflicts |\n161: | `sk-code-frontend/references/web-layout-and-sizing.md` | Container queries and stacking contexts |\n162: | `sk-code-frontend/references/web-accessibility-patterns.md` | Accessibility patterns, visible focus, and live regions |\n163: | `sk-code-frontend/references/web-performance-and-loading.md` | Web font loading and largest contentful paint |\n164: | `sk-code-frontend/references/web-internationalization.md` | Right-to-left layout and bidirectional text |\n165: | `sk-code-frontend/references/web-visual-values.md` | Visual value decisions: spacing, type, weight, colour, shadow, radius, opacity, palettes and token sets |\n166: | `sk-code-frontend/references/web-visual-hierarchy.md` | Visual hierarchy and review: build procedure, symptom-to-fix tables, UX laws and the review pass |\n167: | `sk-code-frontend/references/web-motion-and-interaction.md` | Motion and interaction: animation, input, touch, focus, performance and feedback rules |\n168: | `sk-code-frontend/references/figma-to-code.md` | The five-pass check for comparing a built screen with its Figma frame |\n169: \n170: The map is the packet's own `RESOURCE_MAP` for the web, visual and Figma-to-code intents, re-prefixed with `sk-code-frontend/`, so the two stay equal there.\n171: \n172: ---\n173: \n174: ## 5. VERIFICATION COMMANDS\n175: \n176: | Surface | Required verification evidence |\n177: | --- | --- |\n178: | SKILLED | `python3 .skilled/skills/sk-code/sk-code-skilled/assets/scripts/verify_alignment_drift.py --root <changed-scope>`; plus targeted language/project tests such as vitest, pytest, shellcheck, JSON validation, or spec validation for changed spec folders |\n179: | UNKNOWN | User-selected verification command set before completion claim |\n180: \n181: ---\n182: \n183: ## 6. UNKNOWN FALLBACK\n184: \n185: If no supported surface matches, ask:\n186: \n187: 1. Is this `.skilled/` system code, or an unsupported stack?\n188: 2. Which files or directories are changing?\n189: 3. Which verification command proves the claim?\n190: 4. Should a new `sk-code` route be planned before implementation?\n191: \n192: Canonical sk-code owns the SKILLED surface, the `sk-code-ci` GitHub Actions surface and the stack-agnostic `sk-code-frontend` surface for web practice. Go, Next.js server code and React Native surfaces live in a project fork.\n193: \n194: ### UNKNOWN fallback checklist\n195: \n196: Returned when intent confidence is low (`max(intent_scores) < 0.5`) OR when the user explicitly asks for stack-agnostic guidance:\n197: \n198: - Confirm the detected surface (a declared specific surface, the SKILLED fallback or UNKNOWN)\n199: - Confirm the task intent (implementation / debugging / verification / etc.)\n200: - Provide one concrete input, error, or expected output\n201: - Confirm the verification command set before completion\n202: \n203: ---\n204: \n205: ## 7. LOADING DISCIPLINE (DO / DON'T)\n206: \n207: ### DO\n208: \n209: - Load only references needed for current intent + surface\n210: - Use exact canonical file paths in playbook result YAML (never directory placeholders)\n211: - Cite surface + top-1 intent + loaded resource paths + verification command in your final answer\n212: \n213: ### DON'T\n214: \n215: - Load all of `sk-code-skilled/` indiscriminately (\"just in case\")\n216: - Load Go, Next.js server code or React Native resources from canonical sk-code; those live in a project fork\n217: - Drop directory placeholders in playbook result YAML\n218: \n219: ---\n220: \n221: ## 8. MACHINE-READABLE ROUTER (replay / benchmark source)\n222: \n223: This block is the authored source for the intent vocabulary and weights. §2 explains how it is scored and does not repeat the keywords; §4 renders the same rows as prose. When an intent row changes here, update the matching prose row in §4.\n224: \n225: This projection is intentionally lossy in two documented ways the flat dictionary cannot express, both enforced by the prose contract and the surface-detection pseudocode in this file's §11:\n226: \n227: - **No phase boosts.** The `+5` unambiguous-phase boost from the §2 scoring algorithm is not represented; every keyword carries unit weight here.\n228: - **No doc-only anti-signals.** The `sk-code -2 / sk-doc +3` anti-signals (§2) that route prose-only edits away from this skill are a pre-filter the flat model does not carry.\n229: \n230: ```python\n231: # Always-loaded routing preamble: every code task detects stack, detects phase,\n232: # consults the router, and applies the universal quality baseline before any\n233: # surface-specific resource. These are loaded on every route.\n234: DEFAULT_RESOURCE = [\n235:     \"shared/references/stack-detection.md\",\n236:     \"shared/references/phase-detection.md\",\n237:     \"shared/references/universal/code-quality-standards.md\",\n238: ]\n239: \n240: INTENT_SIGNALS = {\n241:     \"IMPLEMENTATION\":     {\"weight\": 1, \"keywords\": [\"implement\", \"build\", \"create\", \"feature\", \"component\", \"module\", \"authoring\"]},\n242:     \"CODE_QUALITY\":       {\"weight\": 1, \"keywords\": [\"lint\", \"format\", \"quality gate\", \"naming\", \"standards\", \"code smell\", \"comment hygiene\", \"restraint\", \"yagni\", \"simplify\", \"over-engineering\", \"bloat\", \"skipped_untrusted\", \"untrusted repository check\", \"trustrepochecks\", \"quality config\", \"repository/quality.json\", \"configured check\", \"unverified\"]},\n243:     \"DEBUGGING\":          {\"weight\": 1, \"keywords\": [\"debug\", \"broken\", \"failing\", \"stack trace\", \"console error\", \"regression\"]},\n244:     \"VERIFICATION\":       {\"weight\": 1, \"keywords\": [\"verify\", \"passing\", \"type-check\", \"alignment drift\", \"completion claim\"]},\n245:     \"HOOKS\":              {\"weight\": 1, \"keywords\": [\"session-prime\", \"user-prompt-submit\", \"pre-tool-use\", \"post-tool-use\"]},\n246:     \"CONFIG\":             {\"weight\": 1, \"keywords\": [\"jsonc\", \".json\", \".jsonc\", \"descriptor\", \"config schema\"]},\n247:     \"JAVASCRIPT\":         {\"weight\": 1, \"keywords\": [\"javascript\", \"vanilla js\", \".js\", \"commonjs\", \".cjs\", \".mjs\"]},\n248:     \"TYPESCRIPT\":         {\"weight\": 1, \"keywords\": [\"typescript\", \".ts\", \".tsx\"]},\n249:     \"PYTHON\":             {\"weight\": 1, \"keywords\": [\"python\", \".py\", \"docstring\"]},\n250:     \"SHELL\":              {\"weight\": 1, \"keywords\": [\"shell script\", \"bash\", \".sh\"]},\n251:     \"RUST\":               {\"weight\": 1, \"keywords\": [\"rust\", \".rs\", \"cargo.toml\", \"cargo.lock\", \"napi-rs\", \"napi_rs\", \"#[napi]\", \"wasm-bindgen\", \"wasm_bindgen\", \"#[wasm_bindgen]\", \"wasi\", \"cdylib\"]},\n252:     \"CI_WORKFLOW\":        {\"weight\": 4, \"keywords\": [\"github actions workflow\", \"ci workflow\", \"github actions yaml\", \"workflow path filters\", \"github workflow timeout\", \"github workflow concurrency\", \"github workflow permissions\", \"required status check workflow\", \"ci job\", \"action to a sha\", \"sha-pinned action\", \"github actions permissions\", \"ci workflows\", \"ci switch\", \"turn off ci\", \".github/workflows\", \"workflow concurrency\", \"github actions release workflow\", \"github actions deploy workflow\", \"release workflow yaml\", \"deploy workflow yaml\", \"github actions minutes\", \"actions minutes\", \"actions runner minutes\", \"runner minutes\", \"ci workflow cost\", \"ci cost\", \"reduce ci costs\", \"lower ci costs\", \"cut ci costs\", \"reduce our ci costs\", \"lower our ci costs\", \"ci spend\", \"ci bill\", \"ci minutes cost\", \"cut the ci minutes\", \"cut ci minutes\", \"reduce ci minutes\", \"ci pipeline cost\", \"ci pipeline cheaper\", \"ci pipelines cheaper\", \"cheaper ci pipeline\", \"ci runs cheaper\", \"failing ci\", \"failing ci pipeline\", \"ci failure\", \"ci failures\", \"ci is failing\", \"broken ci\", \"debug the ci\", \"debug ci\", \"cost of our ci\", \"make ci cheaper\", \"github actions bill\", \"github actions cost\", \"turn off the ci\", \"turn on the ci\", \"ci review workflow\"]},\n253:     \"FRONTEND_WEB\":        {\"weight\": 4, \"keywords\": [\"semantic html markup\"]},\n254:     \"WEB_ELEMENTS\":        {\"weight\": 4, \"keywords\": [\"html form autocomplete\", \"dialog element\", \"popover attribute\"]},\n255:     \"WEB_CASCADE\":         {\"weight\": 4, \"keywords\": [\"css cascade layers\", \"css specificity conflict\"]},\n256:     \"WEB_LAYOUT\":          {\"weight\": 4, \"keywords\": [\"container query layout\", \"css stacking context\"]},\n257:     \"WEB_A11Y\":            {\"weight\": 4, \"keywords\": [\"web accessibility pattern\", \"focus visible styling\", \"keyboard focus\", \"broken tab order\", \"accessible name\", \"aria live region\", \"focus ring accessibility\", \"focus outline removed\", \"screen reader support\", \"aria label missing\", \"alt text missing\", \"wcag audit\"]},\n258:     \"WEB_PERF\":            {\"weight\": 4, \"keywords\": [\"web font loading\", \"largest contentful paint\"]},\n259:     \"WEB_I18N\":            {\"weight\": 4, \"keywords\": [\"right to left layout\", \"bidirectional text\"]},\n260:     \"WEB_VISUAL_VALUES\": {\"weight\": 4, \"keywords\": [\"what padding should this have\", \"how much padding\", \"what font size should this be\", \"spacing between elements\", \"spacing scale\", \"type scale\", \"build a color palette\", \"shade ramp\", \"box shadow elevation\", \"border radius consistency\", \"contrast ratio failure\", \"grey text on colored background\", \"dark mode palette\", \"concentric border radius\", \"layered shadows\", \"shadow color on dark surface\", \"tabular numbers\", \"what should this button look like\", \"colour decision\", \"color decision\", \"padding\", \"type scale for\", \"font size\", \"colour palette\", \"color palette\", \"contrast ratio\", \"corner radius\", \"box shadow\", \"spacing between\", \"contrast of\", \"check the contrast\", \"colour contrast\", \"color contrast\", \"muted text\"]},\n261:     \"WEB_VISUAL_HIERARCHY\": {\"weight\": 4, \"keywords\": [\"ui looks off\", \"looks amateur\", \"feels cluttered\", \"make this look better\", \"make this ui look designed\", \"visual hierarchy\", \"no visual hierarchy\", \"nothing draws the eye\", \"everything competes for attention\", \"everything looks the same\", \"emphasize by de-emphasizing\", \"how to style a destructive button\", \"this page feels overwhelming\", \"where do i start designing\", \"design a new screen from scratch\", \"how much white space\", \"why does this look wrong\", \"does this look right\", \"critique this design\", \"design critique\", \"visual audit\", \"design review findings\", \"design review\", \"review this design\", \"review this screen\", \"ux laws\", \"cognitive load\", \"progressive disclosure\", \"empty state design\", \"look wrong\", \"looks wrong\", \"looks off\", \"visual review\", \"type hierarchy\"]},\n262:     \"WEB_MOTION\":        {\"weight\": 4, \"keywords\": [\"animation duration\", \"transition duration\", \"easing curve\", \"spring versus easing\", \"twelve principles of animation\", \"when not to animate\", \"response time budget\", \"touch target size\", \"hover state\", \"active pressed state\", \"disabled state styling\", \"button states\", \"animation\", \"transition timing\", \"easing\", \"hover\", \"focus-visible\", \"interaction states\"]},\n263:     \"FIGMA_TO_CODE\":      {\"weight\": 4, \"keywords\": [\"figma to code\", \"check built screen against figma\", \"compare build with figma frame\", \"figma frame\", \"figma frame check\", \"implement a figma design\"]},\n264: }\n265: \n266: RESOURCE_MAP = {\n267:     \"IMPLEMENTATION\": [\n268:         \"sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md\",\n269:         \"sk-code-skilled/references/shared/universal-patterns/organization-security-and-examples.md\",\n270:         \"sk-code-skilled/references/shared/code-organization/overview-and-module-organization.md\",\n271:         \"sk-code-skilled/references/shared/code-organization/imports-and-exports.md\",\n272:         \"sk-code-skilled/references/shared/code-organization/directory-and-test-conventions.md\",\n273:         \"sk-code-skilled/assets/checklists/agent-authoring.md\",\n274:         \"sk-code-skilled/assets/checklists/command-authoring.md\",\n275:         \"sk-code-skilled/assets/checklists/skill-authoring.md\",\n276:         \"sk-code-skilled/assets/checklists/mcp-server-authoring.md\",\n277: \n278:     ],\n279:     \"CODE_QUALITY\": [\n280:         \"shared/references/universal/code-quality-standards.md\",\n281:         \"shared/references/universal/rule-overrides.md\",\n282:         \"sk-code-quality/references/code-style-guide.md\",\n283:         \"sk-code-quality/references/runner-contract.md\",\n284:         \"sk-code-skilled/assets/checklists/universal-checklist.md\",  # SKILLED only: the house checklist loads when SKILLED resolves, never for a foreign surface\n285:         \"sk-code-skilled/assets/checklists/javascript-checklist.md\",\n286:         \"sk-code-skilled/assets/checklists/js-css-style/overview-header-and-comments.md\",\n287:         \"sk-code-skilled/assets/checklists/js-css-style/naming-init-formatting-and-css.md\",\n288:         \"sk-code-skilled/assets/checklists/js-css-style/verification-quick-reference-and-related.md\",\n289:         \"sk-code-skilled/assets/checklists/typescript-checklist.md\",\n290:         \"sk-code-skilled/assets/checklists/python-checklist.md\",\n291:         \"sk-code-skilled/assets/checklists/shell-checklist.md\",\n292:         \"sk-code-skilled/assets/checklists/rust-checklist/overview-and-p0-parity.md\",\n293:         \"sk-code-skilled/assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md\",\n294:         \"sk-code-skilled/assets/checklists/rust-checklist/p1-required.md\",\n295:         \"sk-code-skilled/assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md\",\n296:         \"sk-code-review/assets/code-quality-checklist.md\",\n297: \n298:     ],\n299:     \"DEBUGGING\": [\n300:         \"shared/references/workflow-debug.md\",\n301: \n302:     ],\n303:     \"VERIFICATION\": [\n304:         \"sk-code-skilled/references/shared/alignment-verification-automation.md\",\n305:         \"shared/references/workflow-verify.md\",\n306:         \"sk-code-skilled/assets/scripts/README.md\",\n307: \n308:     ],\n309:     \"HOOKS\": [\n310:         \"sk-code-skilled/references/shared/hooks.md\",\n311:     ],\n312:     \"CONFIG\": [\n313:         \"sk-code-skilled/references/config/style-guide.md\",\n314:         \"sk-code-skilled/references/config/quality-standards.md\",\n315:         \"sk-code-skilled/references/config/quick-reference.md\",\n316:         \"sk-code-skilled/assets/checklists/config-checklist.md\",\n317:     ],\n318:     \"JAVASCRIPT\": [\n319:         \"sk-code-skilled/references/javascript/style-guide.md\",\n320:         \"sk-code-skilled/references/javascript/quality-standards/overview-modules-and-docs.md\",\n321:         \"sk-code-skilled/references/javascript/quality-standards/security-testing-and-exemptions.md\",\n322:         \"sk-code-skilled/references/javascript/quick-reference.md\",\n323:     ],\n324:     \"TYPESCRIPT\": [\n325:         \"sk-code-skilled/references/typescript/style-guide/overview-strict-and-naming.md\",\n326:         \"sk-code-skilled/references/typescript/style-guide/formatting-imports-and-coexistence.md\",\n327:         \"sk-code-skilled/references/typescript/quality-standards/overview-and-type-system.md\",\n328:         \"sk-code-skilled/references/typescript/quality-standards/tsdoc-errors-and-async.md\",\n329:         \"sk-code-skilled/references/typescript/quality-standards/tsconfig-and-modules.md\",\n330:         \"sk-code-skilled/references/typescript/quick-reference/template-naming-and-types.md\",\n331:         \"sk-code-skilled/references/typescript/quick-reference/imports-errors-and-tsconfig.md\",\n332:     ],\n333:     \"PYTHON\": [\n334:         \"sk-code-skilled/references/python/style-guide.md\",\n335:         \"sk-code-skilled/references/python/quality-standards.md\",\n336:         \"sk-code-skilled/references/python/quick-reference.md\",\n337:     ],\n338:     \"SHELL\": [\n339:         \"sk-code-skilled/references/shell/style-guide/overview-structure-and-naming.md\",\n340:         \"sk-code-skilled/references/shell/style-guide/variables-functions-and-output.md\",\n341:         \"sk-code-skilled/references/shell/quality-standards/overview-and-priority-blockers.md\",\n342:         \"sk-code-skilled/references/shell/quality-standards/validation-security-and-shellcheck.md\",\n343:         \"sk-code-skilled/references/shell/quick-reference/template-variables-and-loops.md\",\n344:         \"sk-code-skilled/references/shell/quick-reference/functions-strings-and-checklist.md\",\n345:     ],\n346:     \"RUST\": [\n347:         \"sk-code-skilled/references/rust/style-guide/overview-and-file-header.md\",\n348:         \"sk-code-skilled/references/rust/style-guide/toolchain-and-project-structure.md\",\n349:         \"sk-code-skilled/references/rust/style-guide/naming-conventions.md\",\n350:         \"sk-code-skilled/references/rust/style-guide/formatting-and-imports.md\",\n351:         \"sk-code-skilled/references/rust/style-guide/commenting-and-rustdoc.md\",\n352:         \"sk-code-skilled/references/rust/style-guide/interop-model.md\",\n353:         \"sk-code-skilled/references/rust/style-guide/interop-errors-and-parity.md\",\n354:         \"sk-code-skilled/references/rust/quality-standards/overview-and-data-ownership.md\",\n355:         \"sk-code-skilled/references/rust/quality-standards/modeling-collections-and-api.md\",\n356:         \"sk-code-skilled/references/rust/quality-standards/docs-errors-and-async.md\",\n357:         \"sk-code-skilled/references/rust/quality-standards/build-and-organization.md\",\n358:         \"sk-code-skilled/references/rust/quality-standards/determinism-and-parity.md\",\n359:         \"sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md\",\n360:         \"sk-code-skilled/references/rust/quick-reference/naming-ordering-and-signatures.md\",\n361:         \"sk-code-skilled/references/rust/quick-reference/collections-imports-and-errors.md\",\n362:         \"sk-code-skilled/references/rust/quick-reference/rustdoc-and-cargo.md\",\n363:         \"sk-code-skilled/references/rust/quick-reference/determinism-parity-and-related.md\",\n364:     ],\n365:     \"CI_WORKFLOW\": [\n366:         \"sk-code-ci/references/ci-workflow-standards.md\",\n367:         \"sk-code-ci/references/trigger-and-filter-rules.md\",\n368:         \"sk-code-ci/references/job-shape-rules.md\",\n369:         \"sk-code-ci/references/protected-set.md\",\n370:     ],\n371:     \"FRONTEND_WEB\": [\n372:         \"sk-code-frontend/references/frontend-practice.md\",\n373:         \"sk-code-frontend/references/web-markup-and-css.md\",\n374:     ],\n375:     \"WEB_ELEMENTS\": [\n376:         \"sk-code-frontend/references/frontend-practice.md\",\n377:         \"sk-code-frontend/references/web-markup-and-css.md\",\n378:         \"sk-code-frontend/references/web-elements-and-attributes.md\",\n379:     ],\n380:     \"WEB_CASCADE\": [\n381:         \"sk-code-frontend/references/frontend-practice.md\",\n382:         \"sk-code-frontend/references/web-markup-and-css.md\",\n383:         \"sk-code-frontend/references/web-cascade-and-selectors.md\",\n384:     ],\n385:     \"WEB_LAYOUT\": [\n386:         \"sk-code-frontend/references/frontend-practice.md\",\n387:         \"sk-code-frontend/references/web-markup-and-css.md\",\n388:         \"sk-code-frontend/references/web-layout-and-sizing.md\",\n389:     ],\n390:     \"WEB_A11Y\": [\n391:         \"sk-code-frontend/references/frontend-practice.md\",\n392:         \"sk-code-frontend/references/web-markup-and-css.md\",\n393:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n394:     ],\n395:     \"WEB_PERF\": [\n396:         \"sk-code-frontend/references/frontend-practice.md\",\n397:         \"sk-code-frontend/references/web-markup-and-css.md\",\n398:         \"sk-code-frontend/references/web-performance-and-loading.md\",\n399:     ],\n400:     \"WEB_I18N\": [\n401:         \"sk-code-frontend/references/frontend-practice.md\",\n402:         \"sk-code-frontend/references/web-markup-and-css.md\",\n403:         \"sk-code-frontend/references/web-internationalization.md\",\n404:     ],\n405:     \"WEB_VISUAL_VALUES\": [\n406:         \"sk-code-frontend/references/frontend-practice.md\",\n407:         \"sk-code-frontend/references/web-visual-values.md\",\n408:     ],\n409:     \"WEB_VISUAL_HIERARCHY\": [\n410:         \"sk-code-frontend/references/frontend-practice.md\",\n411:         \"sk-code-frontend/references/web-visual-hierarchy.md\",\n412:         \"sk-code-frontend/references/web-visual-values.md\",\n413:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n414:     ],\n415:     \"WEB_MOTION\": [\n416:         \"sk-code-frontend/references/frontend-practice.md\",\n417:         \"sk-code-frontend/references/web-motion-and-interaction.md\",\n418:     ],\n419:     \"FIGMA_TO_CODE\": [\n420:         \"sk-code-frontend/references/figma-to-code.md\",\n421:         \"sk-code-frontend/references/frontend-practice.md\",\n422:     ],\n423: }\n424: \n425: # Hub-level shared controls, declared once here. This list holds every\n426: # contained shared/ path that RESOURCE_MAP references but that is exempt from\n427: # typed-leaf projection, because it has no single packet owner. The root-router\n428: # contract validates each entry and requires RESOURCE_MAP to reference it.\n429: # DEFAULT_RESOURCE above is the other half of the set: its always-loaded\n430: # preamble paths are hub-level controls too. No other shared/ path is a\n431: # control, so a guard that needs the control set reads these two lists.\n432: SHARED_CONTROL_RESOURCES = [\n433:     \"shared/references/universal/code-quality-standards.md\",\n434:     \"shared/references/universal/rule-overrides.md\",\n435:     \"shared/references/workflow-debug.md\",\n436:     \"shared/references/workflow-verify.md\",\n437: ]\n438: ```\n439: \n440: ### Surface-aware loading (route-time)\n441: \n442: The router does NOT load the whole matched-intent union. After surface detection (§1, `stack-detection.md`), a route loads:\n443: \n444: - the always-loaded `DEFAULT_RESOURCE` preamble (stack/phase detection and the universal quality baseline), plus\n445: - the `shared/` entries the matched intents map (for example `code-quality-standards.md` under CODE_QUALITY, `workflow-debug.md` under DEBUGGING and `workflow-verify.md` under VERIFICATION), never the whole `shared/references/universal/` folder, plus\n446: - only the **detected surface's** slice (`<surface>/references/*`) for the matched intents.\n447: \n448: - It does not load another surface's resources.\n449: - It defers `assets/*` (checklists, recipes, templates) to on-demand rather than the first slice.\n450: - Within SKILLED it slices once more by the **detected language** (§1 sub-detection): a TypeScript task loads `sk-code-skilled/references/typescript/*` plus the language-agnostic `sk-code-skilled/references/shared/*`, not the Python, shell, config, or JavaScript folders.\n451: - An `UNKNOWN` surface falls back to the preamble plus the shared-tier entries its matched intents map.\n452: \n453: This is what stops a routine single-surface task from pulling the full cross-surface set. The deterministic router-replay enforces the same rule, so the benchmark measures it.\n454: \n455: ---\n456: \n457: ## 9. HOW TO READ THIS\n458: \n459: - Every code task first loads the always-on preamble (stack + phase detection and the universal quality baseline); routing then narrows to the detected surface's slice for the matched intents.\n460: - One dominant intent on one surface loads that surface's slice; two near-tied intents (within the router's ambiguity delta) load both intent sets, deduped by canonical pair.\n461: - A single-surface task never pulls another surface's resources.\n462: - No keyword match, or an `UNKNOWN` surface, falls back to the preamble plus the shared-tier entries its matched intents map — confirm the surface and intent before loading more. See §6 (UNKNOWN FALLBACK) and §7 (LOADING DISCIPLINE) for the full rules.\n463: \n464: ---\n465: \n466: ## 10. RELATED RESOURCES\n467: \n468: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) + SKILLED language sub-detection\n469: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and per-phase resource loading\n470: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n471: - Barter equivalent: `barter/.skilled/skills/sk-code/shared/references/smart-routing.md` (different routing key — git-remote project — but same structural pattern)\n472: \n473: ---\n474: \n475: ## 11. MACHINE ROUTER\n476: \n477: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 8 stays the only replay source.\n478: \n479: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n480: > ```bash\n481: > node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"\n482: > ```\n483: > Follow the returned decision: `route` (use its `targets`), `clarify`/`defer` (disambiguate) or `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-code`. Set `SPECKIT_COMPILED_ROUTING=0`, the explicit kill-switch, to force legacy routing fleet-wide.\n484: \n485: **Session surface hint.** Before you call the front door, run the surface detection in [`stack-detection.md`](shared/references/stack-detection.md) on the session's working directory and the files it is editing.\n486: Then add its result as `--surface-hint <SURFACE>`, for example `--surface-hint SKILLED`.\n487: When the prompt's keywords tie between surfaces, a hinted specific surface leads them.\n488: Workflow modes keep first place, and the targets and the bundle kind stay the same.\n489: `SKILLED` is the fallback surface and always ranks last, so a `SKILLED` hint changes nothing.\n490: With `UNKNOWN`, no hint or a surface the prompt did not match, the `routerPolicy.tieBreak` order applies.\n491: \n492: ### Surface Router: per-intent leaf sets\n493: \n494: Root `ROUTER.md` owns the second-stage `INTENT_SIGNALS` / `RESOURCE_MAP`, while packet-owned resources stay typed through `leaf-manifest.json`.\n495: The hub-level shared controls are declared once, in `ROUTER.md` §8: the `SHARED_CONTROL_RESOURCES` list plus the always-loaded `DEFAULT_RESOURCE` preamble. They resolve on disk but never project as leaves.\n496: The hub router keeps stage-one mode selection and its `shared/README.md` fallback.\n497: \n498: ### The discriminator\n499: - **`workflowMode`** - the public mode/packet key: `sk-code-quality`, `sk-code-review` (workflow) or `sk-code-ci`, `sk-code-frontend`, `sk-code-skilled` (surface).\n500: - **`packetKind`** - the axis: `workflow` (a mode that acts) or `surface` (read-only evidence bundled alongside a mode).\n501: - **`backendKind`** - which backend runs the packet: `surface-router` or `review-cache` for workflow modes, `evidence-base` for surface packets.\n502: \n503: Surface packets are advisor-invisible (`routingClass: metadata`, read-only `toolSurface`).\n504: The advisor still routes the single identity `sk-code`, and the hub bundles zero-or-more surfaces as evidence via `routerPolicy.outcomes.surfaceBundle`.\n505: The workflow mode comes first, followed by surfaces.\n506: \"review my typescript module for jank\" → `[sk-code-review, sk-code-skilled]`.\n507: Bundled surfaces follow the `routerPolicy.tieBreak` order. It ranks `sk-code-frontend` ahead of `sk-code-ci`, then `sk-code-skilled` last, because a new surface goes ahead of the existing ones and the SKILLED fallback stays last.\n508: \n509: ### Surface detection\n510: \n511: Surface detection lives once in the hub's `shared/` layer and every mode and surface consumes it.\n512: It tries every declared specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n513: When a specific surface and `SKILLED` both match, the specific one leads and `SKILLED` comes along as second evidence.\n514: Each surface declares its markers in a `surfaceDetection` block in `mode-registry.json`, or in its own `graph-metadata.json` when it lives outside the hub.\n515: Modes own workflow contracts, not surface identity.\n516: `sk-code-ci` and `sk-code-frontend` are the surfaces that stack detection does not select. The hub bundles both from request vocabulary alone: CI through `code-ci-aliases` and `code-ci-runtime`, and Frontend through `code-frontend-aliases` in `hub-router.json`.\n517: \n518: ### Fallback route\n519: \n520: When no workflow mode dominates (a bare implement/debug/verify request), the router defers to a pure surface bundle: it detects the surface, loads that surface's evidence and workflow doctrine, and the agent acts. `routerPolicy.defaultMode` is `null`, so the hub does not force a stale default. An unclear code intent asks for disambiguation.\n521: \n522: Per-mode behavior is **not flattened**: each packet keeps its own code-work contract, standards, evidence rules, and tool-permission guards.\n523: \n524: ### Routing rule\n525: ```python\n526: from pathlib import Path\n527: \n528: SKILL_ROOT = Path(__file__).resolve().parent\n529: UNKNOWN_FALLBACK_CHECKLIST = [\n530:     \"Confirm whether this is sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend or sk-code-skilled work\",\n531:     \"Confirm the target files or runtime surface\",\n532:     \"Confirm the expected action: implement, debug, verify, quality gate, or review\",\n533:     \"Confirm the verification command set before completion\",\n534: ]\n535: \n536: def _guard_in_skill(relative_path: str) -> str:\n537:     resolved = (SKILL_ROOT / relative_path).resolve()\n538:     resolved.relative_to(SKILL_ROOT)\n539:     if resolved.name != \"SKILL.md\" and resolved.suffix.lower() != \".md\":\n540:         raise ValueError(f\"Only markdown skill resources are routable: {relative_path}\")\n541:     return resolved.relative_to(SKILL_ROOT).as_posix()\n542: \n543: def load_if_available(relative_path: str, loaded: list[str], seen: set[str]) -> None:\n544:     guarded = _guard_in_skill(relative_path)\n545:     path = SKILL_ROOT / guarded\n546:     if path.exists() and guarded not in seen:\n547:         load(guarded)\n548:         loaded.append(guarded)\n549:         seen.add(guarded)\n550: \n551: def route(task):\n552:     loaded, seen = [], set()\n553:     registry = read_json(SKILL_ROOT / \"mode-registry.json\")\n554:     workflow_mode = explicit_mode_hint(task) or classify_workflow_mode(task)\n555: \n556:     if not workflow_mode:\n557:         load_if_available(\"shared/README.md\", loaded, seen)\n558:         return {\n559:             \"load_level\": \"UNKNOWN_FALLBACK\",\n560:             \"needs_disambiguation\": True,\n561:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n562:             \"resources\": loaded,\n563:         }\n564: \n565:     entry = find_registry_entry(registry, workflowMode=workflow_mode)\n566:     if not entry:\n567:         load_if_available(\"shared/README.md\", loaded, seen)\n568:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"unknown_mode\": workflow_mode, \"resources\": loaded}\n569: \n570:     packet_skill = f\"{entry['packet']}/SKILL.md\"\n571:     load_if_available(packet_skill, loaded, seen)\n572: \n573:     for surface_mode in surface_bundle_from_hub_router(task):\n574:         surface_entry = find_registry_entry(registry, workflowMode=surface_mode)\n575:         if surface_entry:\n576:             load_if_available(f\"{surface_entry['packet']}/SKILL.md\", loaded, seen)\n577: \n578:     if not loaded:\n579:         load_if_available(\"shared/README.md\", loaded, seen)\n580:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"notice\": \"matched registry but no packet SKILL.md was available\", \"resources\": loaded}\n581: \n582:     return {\"workflowMode\": workflow_mode, \"backendKind\": entry[\"backendKind\"], \"resources\": loaded}\n583: ```"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md\"}"},"time":{"start":1794546212929,"end":1794546213221}}}}
{"type":"tool_use","timestamp":1794546213226,"sessionID":"ses_e2cb7c208ffeMbGpI9gpgiJYne","part":{"partID":"prt_1d34a1dc9002oG5e1meejW5uxH","sessionID":"ses_e2cb7c208ffeMbGpI9gpgiJYne","messageID":"msg_1d349c863001esRsZOWwAuTSKL","type":"tool","id":"call_bf05a340d87341ad9d9f5b90","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/communication.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/communication.md, lines 1-245\n1: ---\n2: title: \"Rule: Communication\"\n3: description: \"Write so the reader can act after one pass: no table in a reply, nothing that does not carry information.\"\n4: trigger_phrases:\n5:   - \"cut filler\"\n6:   - \"empty opener\"\n7:   - \"match length to the question\"\n8:   - \"no tables\"\n9:   - \"can you say that more plainly\"\n10:   - \"I don't follow\"\n11:   - \"too abstract\"\n12:   - \"number the steps\"\n13:   - \"item cap\"\n14:   - \"reply too long\"\n15:   - \"say each fact once\"\n16:   - \"one idea per sentence\"\n17:   - \"plain words\"\n18:   - \"em dash\"\n19:   - \"reads like terminal output\"\n20:   - \"concise is not compressed\"\n21:   - \"recommend one option\"\n22:   - \"buried the verdict\"\n23:   - \"say where you are going\"\n24:   - \"time estimate\"\n25: importance_tier: important\n26: contextType: reference\n27: version: 1.5.0.0\n28: ---\n29: \n30: # Rule: Communication\n31: \n32: > Routed from [`REPO RULES.md`](../../REPO%20RULES.md). Load before writing any substantive reply.\n33: > Expands `AGENTS.md`, never overrides it. Where they appear to disagree, `AGENTS.md` wins and this file is wrong. Say so.\n34: \n35: ## Fires when\n36: \n37: - About to write any substantive reply, an answer, an explanation, a close-out, a status.\n38: - Drafting or editing a sentence a reader will read.\n39: - About to present a recommendation, a fork, or a trade-off.\n40: - About to start a multi-step stretch of work the reader will not see inside.\n41: - About to report what a long autonomous run found.\n42: - The reader says they did not follow or asks for a plainer version.\n43: \n44: ## The rule\n45: \n46: **Write so the reader can act after one pass: the answer first, and nothing in the reply\n47: that does not carry information.**\n48: \n49: ---\n50: \n51: ## 1. THE REGISTER YOU ARE IN\n52: \n53: **While working: clipped.** Act rather than narrate. Open with the result, not with\n54: \"I'll now\" or \"Let me\". Batch the tool calls and report at checkpoints.\n55: \n56: **At a boundary: dense.** You are at a boundary whenever the reader is about to decide\n57: something, act on something or take the work over: a handoff, a close-out, a decision\n58: point. Verdict first, then the receipts. Reason about the problem, not about yourself.\n59: Everything else is working.\n60: \n61: **Complex topic, simple words.** When the subject is technical or layered, explain it plainly the first time, not only after the reader asks: what it is, why it matters to them, what they do next. Use a term only when the reader needs it, and define it on first use. Simpler words, same claim: never drop a caveat or a number to get there.\n62: \n63: The failure this prevents: the wrong register. Narration nobody reads, the verdict buried\n64: in working notes or the working notes inflated into a report.\n65: \n66: ---\n67: \n68: ## 2. LENGTH\n69: \n70: **Match length to the question.** Length is earned by the reader's need, never by the work you did to get there.\n71: \n72: **Choose by reader impact before you write.** Decide who will read this and what they already hold. Keep what the reader would notice, act on or\n73: decide differently because of. Merge the items that have the same effect for them. How the\n74: work was done stays out unless it changes how far the reader can trust the result.\n75: \n76: **Concise is not compressed.** Concise cuts what the reader does not need and stops. Compressed cuts further and takes the connective tissue with it: the because, the second half of a contrast, the noun that a later \"this\" points back to. After a cut, check the joints. Every cut this file asks for answers to that floor.\n77: \n78: The failure this prevents: the answer is in there, and they did not find it, under a\n79: record of the work they never needed. Or the cut went too far, and the reader rebuilds the\n80: argument the reply no longer states.\n81: \n82: **No tables in a reply,** except the in-flight block in\n83: [`communication-handoff.md`](communication-handoff.md) §6. Use a sentence for one or two\n84: facts and bullets for parallel items.\n85: \n86: The failure this prevents: the reader parses a grid to learn what one sentence would\n87: have said.\n88: \n89: ---\n90: \n91: ## 3. CUT FILLER\n92: \n93: Every sentence carries information. The recurring offenders:\n94: \n95: - **Empty openers:** \"Great question\", \"Let me take a look\", \"I'll now\".\n96: - **Restated summaries:** repeating back what you just said, one abstraction level up.\n97: - **Vague warnings:** \"be careful with this\", \"this can be tricky\", naming no failure. A caveat earns its place by naming a failure that can happen here.\n98: - **Corporate and marketing register:** \"robust\", \"seamless\", \"leverage\", \"best-in-class\".\n99: - **Narrating the obvious:** announcing a tool call the reader can see the result of.\n100: - **Leaked scaffolding:** a runtime line that tells you to plan privately, list what you\n101:   need next or batch your calls is answered in reasoning, never in the reply.\n102: \n103: **Say each fact once.** Each part of the reply has one job: the first lines carry the\n104: outcome, the body carries the detail, and the end carries the receipts and the handback. A\n105: sentence that repeats an earlier one goes, or it says something the reader does not know\n106: yet.\n107: \n108: The failure this prevents: filler trains the reader to skim, and then they skim the\n109: sentence that mattered.\n110: \n111: ---\n112: \n113: ## 4. THE ANSWER FIRST\n114: \n115: **The first line carries the payload.** The answer, the verdict or the action, in the\n116: first sentence, not a label for it. Test: read the first line on its own. If it told you the outcome, it did its job. Four habits break it: announcing (\"I will now\n117: check the tests\"), labelling (\"Overview:\"), the fragment opener (\"Context.\") and the set-up\n118: that promises the good part in a moment.\n119: \n120: **The rest of the outcome follows at once.** What the work concluded, what changed and what\n121: to do next are in the reader's hands by the second line. The receipts come after that, and\n122: the handback comes last, per [`communication-handoff.md`](communication-handoff.md) §1.\n123: End when the answer is done. The closing-deletion test: a last line that only asks whether\n124: anything else is needed, or recaps what the reply just said, deletes.\n125: \n126: **Reach the verdict by analysis, then put it first.** The order of the reply is not the order of the thinking. If you cannot state the verdict yet, say that. A named uncertainty is a verdict about the state of the evidence.\n127: \n128: **Recommend one path.** Name its main trade-off, and mention an alternative only when it could change the decision. Mark must-do work apart from nice-to-have. State an assumption you made where evidence was missing, because the reader can correct a visible assumption and cannot correct a silent one.\n129: \n130: **An ambiguous request still gets the answer first.** When two readings lead to different answers, answer the likelier one and say in one line which reading you took. When they lead to materially different work, ask before starting it, per [`uncertainty-and-honesty.md`](uncertainty-and-honesty.md) §1. When you deliver a different version of the ask, the first lines say what changed and why.\n131: \n132: The failure this prevents: a payload that waits behind an announcement or a label, a survey\n133: of options where one recommendation was owed, a swapped or misread request nobody catches,\n134: or a last line that is a farewell and adds nothing.\n135: \n136: ---\n137: \n138: ## 5. HOW THE REPLY MOVES\n139: \n140: **Each paragraph stands alone and carries the reader forward.** A reader who lands mid-reply can act on the paragraph in front of them, and each one picks up where the last one landed: what changed, what it implies, what comes next.\n141: \n142: **Number the steps when there is more than one.** Anything the reader must run, check or\n143: answer gets its own number, one step per line, the number at the start of the line. Numbers\n144: bracketed inside a sentence, (1) then (2) then (3), are a paragraph wearing numbers.\n145: \n146: **No group shows more than five items.** Split a longer set into labelled groups of five or\n147: fewer, or show the five that matter most and say in one line how many are held back, \"the\n148: first five of nine\". The rest is retained, not discarded, and appears when the reader asks.\n149: \n150: **Suppress the tangent.** The reply answers the question it was asked. A second issue worth\n151: raising gets offered once, at the end, in one line. The reader decides whether it happens.\n152: \n153: The failure this prevents: the reader assembles the order themselves, loses track of which\n154: step they have done, mistakes a shortened list for the complete one, or waits for the\n155: answer behind a second issue.\n156: \n157: ---\n158: \n159: ## 6. SENTENCES AND WORDS\n160: \n161: **One idea per sentence.** Short and declarative. When a sentence stacks clauses, split it. Vary the rhythm, and prefer prose when a list would fragment a single argument.\n162: \n163: **State the relation between sentences.** A sentence says how it attaches to the one before: because, but, therefore, for example. When it explains how something works, it names the moving parts: what acts, what it acts on, what changes.\n164: \n165: **Plain words by default.** Reserve exact names for the things that have them: languages, frameworks, APIs, dependencies, commands. Introduce unavoidable jargon one term at a time, in a sentence that defines it by use.\n166: \n167: **No terse machine register.** Replace arrows and symbols standing in for verbs with action words. For stacked noun phrases, say who does what, using the [HVR nominalization guidance](../skills/sk-doc/sk-create-with-human-voice/references/hvr-rules.md#nominalization-and-stacked-compression). Explain each ID, abbreviation or status code in plain words, and say what a bare count or label measures. Turn fragments into complete sentences.\n168: \n169: **Name an identifier only where the reader acts on it.** A path, hash, flag or ID earns its place when the reader will run, open or check it. Elsewhere, say what the thing is. Keep to one or two numbers a sentence, and when the numbers are the point, give each its own sentence or bullet.\n170: \n171: The failure this prevents: a technically correct reply the reader has to decode, where\n172: they supply a link the writer never stated and cannot find the few names and figures they\n173: need.\n174: \n175: ---\n176: \n177: ## 7. PUNCTUATION THE READER TRIPS ON\n178: \n179: - **Never use an em dash.** Use a comma, a full stop or a colon, whichever the sentence wanted.\n180: - **No semicolon.** Two sentences, or a conjunction.\n181: - **No serial comma.** Drop it before the `and` or `or` that closes a list.\n182: \n183: The failure this prevents: dashes read as authored voice to a human and as a tell to a\n184: reader who has seen a lot of generated text.\n185: \n186: The full standard is the Human Voice Rules, which `sk-doc` routes to. Load all of it when writing a document. A reply takes its voice half, the directives, vocabulary lists and tell lists, and leaves its document-structure half.\n187: \n188: ---\n189: \n190: ## 8. LONG STRETCHES AND WHAT THEY FOUND\n191: \n192: **Say where you are going before a long stretch.** Before work the reader cannot see inside, post the intended path: a short numbered list of what you will do and what to expect at each checkpoint. Update it when it changes. Clipped means not narrating each step. It never means starting without saying where you are going.\n193: \n194: **Attach a concrete time estimate when the stretch is long.** Minutes or hours, based on a named earlier run, or marked as an assumption. An estimate informs and never gates. Outside that case, do not open a task with one nobody asked for, and never use one to argue against starting. When the task is too big for one pass, name the smallest slice worth delivering, start there and say what is deferred.\n195: \n196: **A synthesis is not a file path.** When a long run produces findings, the message carries the answer, the few findings behind it, the uncertainty that matters and what was ruled out. The artifact path follows them. Per-iteration narration and internal metrics stay out. Where a run has its own completion contract, as the deep-loop modes do, that contract wins.\n197: \n198: The failure this prevents: twenty minutes of silence, then a result the reader has to\n199: reverse-engineer a plan from, or a path and a count handed over in place of a report.\n200: \n201: ---\n202: \n203: ## 9. WHEN THE READER DID NOT FOLLOW\n204: \n205: \"I don't follow\", \"what?\" or \"too abstract\" calls for a change of modality: a concrete\n206: example, a numbered sequence, a smaller first step or a picture using the runtime's visual\n207: capability. Do not repeat the same explanation at greater length.\n208: \n209: \"say that more plainly\", \"in simple terms\" or \"rewrite that\" calls for a plain\n210: re-render: a copy edit that rewords without reordering, cutting or adding. Every claim,\n211: number, caveat and conclusion keeps its strength. Code, commands, paths, identifiers,\n212: quotations and numbers stay byte-exact. The wording standard is\n213: [hvr-rules.md](../skills/sk-doc/sk-create-with-human-voice/references/hvr-rules.md). If a\n214: plainer word would change what a sentence claims, keep the original.\n215: \n216: The failure this prevents: the same explanation repeats, or the plain rewrite changes the claim.\n217: \n218: ---\n219: \n220: ## 10. WHAT THIS RULE IS NOT\n221: \n222: - **Not a constraint on rigor.** Nothing here softens a claim, a caveat, or a verification standard owned by [`evidence-and-proof.md`](evidence-and-proof.md) or [`uncertainty-and-honesty.md`](uncertainty-and-honesty.md).\n223: - **Not a voice to perform.** When honoring a rule here would weaken the answer, keep the answer.\n224: - **Not a license to omit.** \"Match length to the question\" is about the reader's need,\n225:   never about leaving out what they have to know.\n226: - **Not licence to skip the analysis.** Verdict first is an ordering of the writing, never\n227:   a shortcut in the reasoning.\n228: \n229: ---\n230: \n231: ## 11. SELF-CHECK\n232: \n233: - [ ] The first line carries the answer or the action, not a label, an announcement or a setup, and the outcome is complete by the second line.\n234: - [ ] I reached the verdict by analysis, recommended one path with its trade-off and stated the assumptions I made.\n235: - [ ] Where the request was ambiguous or I delivered a different version of it, the first lines say which reading I took and why.\n236: - [ ] Each paragraph stands alone and carries the reader forward, and multi-step work reads as a numbered list.\n237: - [ ] No group runs past five items, nothing was dropped to keep it under, and a tangent appears once at the end or not at all.\n238: - [ ] Every sentence carries information, each fact appears once, and no runtime instruction to plan privately was copied into the reply.\n239: - [ ] Length matches what the reader asked, no table stands in a reply, and nothing was compressed past the point where the reader has to re-expand it.\n240: - [ ] Every sentence carries one idea in plain words and says how it attaches to the one before.\n241: - [ ] Arrows, bare IDs, counts and fragments were turned into sentences, and every path, hash or flag is one the reader will act on.\n242: - [ ] No em dash, no semicolon, no serial comma.\n243: - [ ] Before a long stretch I said where I was going, with a concrete time estimate when it was long, and no estimate argued against starting.\n244: - [ ] A synthesis I reported carries its findings, not just its path and its counts.\n245: - [ ] When the reader did not follow, I changed modality, and a plain re-render kept every claim, number and caveat at the same strength.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/repo-rules/communication.md, lines 1-245\n1: ---\n2: title: \"Rule: Communication\"\n3: description: \"Write so the reader can act after one pass: no table in a reply, nothing that does not carry information.\"\n4: trigger_phrases:\n5:   - \"cut filler\"\n6:   - \"empty opener\"\n7:   - \"match length to the question\"\n8:   - \"no tables\"\n9:   - \"can you say that more plainly\"\n10:   - \"I don't follow\"\n11:   - \"too abstract\"\n12:   - \"number the steps\"\n13:   - \"item cap\"\n14:   - \"reply too long\"\n15:   - \"say each fact once\"\n16:   - \"one idea per sentence\"\n17:   - \"plain words\"\n18:   - \"em dash\"\n19:   - \"reads like terminal output\"\n20:   - \"concise is not compressed\"\n21:   - \"recommend one option\"\n22:   - \"buried the verdict\"\n23:   - \"say where you are going\"\n24:   - \"time estimate\"\n25: importance_tier: important\n26: contextType: reference\n27: version: 1.5.0.0\n28: ---\n29: \n30: # Rule: Communication\n31: \n32: > Routed from [`REPO RULES.md`](../../REPO%20RULES.md). Load before writing any substantive reply.\n33: > Expands `AGENTS.md`, never overrides it. Where they appear to disagree, `AGENTS.md` wins and this file is wrong. Say so.\n34: \n35: ## Fires when\n36: \n37: - About to write any substantive reply, an answer, an explanation, a close-out, a status.\n38: - Drafting or editing a sentence a reader will read.\n39: - About to present a recommendation, a fork, or a trade-off.\n40: - About to start a multi-step stretch of work the reader will not see inside.\n41: - About to report what a long autonomous run found.\n42: - The reader says they did not follow or asks for a plainer version.\n43: \n44: ## The rule\n45: \n46: **Write so the reader can act after one pass: the answer first, and nothing in the reply\n47: that does not carry information.**\n48: \n49: ---\n50: \n51: ## 1. THE REGISTER YOU ARE IN\n52: \n53: **While working: clipped.** Act rather than narrate. Open with the result, not with\n54: \"I'll now\" or \"Let me\". Batch the tool calls and report at checkpoints.\n55: \n56: **At a boundary: dense.** You are at a boundary whenever the reader is about to decide\n57: something, act on something or take the work over: a handoff, a close-out, a decision\n58: point. Verdict first, then the receipts. Reason about the problem, not about yourself.\n59: Everything else is working.\n60: \n61: **Complex topic, simple words.** When the subject is technical or layered, explain it plainly the first time, not only after the reader asks: what it is, why it matters to them, what they do next. Use a term only when the reader needs it, and define it on first use. Simpler words, same claim: never drop a caveat or a number to get there.\n62: \n63: The failure this prevents: the wrong register. Narration nobody reads, the verdict buried\n64: in working notes or the working notes inflated into a report.\n65: \n66: ---\n67: \n68: ## 2. LENGTH\n69: \n70: **Match length to the question.** Length is earned by the reader's need, never by the work you did to get there.\n71: \n72: **Choose by reader impact before you write.** Decide who will read this and what they already hold. Keep what the reader would notice, act on or\n73: decide differently because of. Merge the items that have the same effect for them. How the\n74: work was done stays out unless it changes how far the reader can trust the result.\n75: \n76: **Concise is not compressed.** Concise cuts what the reader does not need and stops. Compressed cuts further and takes the connective tissue with it: the because, the second half of a contrast, the noun that a later \"this\" points back to. After a cut, check the joints. Every cut this file asks for answers to that floor.\n77: \n78: The failure this prevents: the answer is in there, and they did not find it, under a\n79: record of the work they never needed. Or the cut went too far, and the reader rebuilds the\n80: argument the reply no longer states.\n81: \n82: **No tables in a reply,** except the in-flight block in\n83: [`communication-handoff.md`](communication-handoff.md) §6. Use a sentence for one or two\n84: facts and bullets for parallel items.\n85: \n86: The failure this prevents: the reader parses a grid to learn what one sentence would\n87: have said.\n88: \n89: ---\n90: \n91: ## 3. CUT FILLER\n92: \n93: Every sentence carries information. The recurring offenders:\n94: \n95: - **Empty openers:** \"Great question\", \"Let me take a look\", \"I'll now\".\n96: - **Restated summaries:** repeating back what you just said, one abstraction level up.\n97: - **Vague warnings:** \"be careful with this\", \"this can be tricky\", naming no failure. A caveat earns its place by naming a failure that can happen here.\n98: - **Corporate and marketing register:** \"robust\", \"seamless\", \"leverage\", \"best-in-class\".\n99: - **Narrating the obvious:** announcing a tool call the reader can see the result of.\n100: - **Leaked scaffolding:** a runtime line that tells you to plan privately, list what you\n101:   need next or batch your calls is answered in reasoning, never in the reply.\n102: \n103: **Say each fact once.** Each part of the reply has one job: the first lines carry the\n104: outcome, the body carries the detail, and the end carries the receipts and the handback. A\n105: sentence that repeats an earlier one goes, or it says something the reader does not know\n106: yet.\n107: \n108: The failure this prevents: filler trains the reader to skim, and then they skim the\n109: sentence that mattered.\n110: \n111: ---\n112: \n113: ## 4. THE ANSWER FIRST\n114: \n115: **The first line carries the payload.** The answer, the verdict or the action, in the\n116: first sentence, not a label for it. Test: read the first line on its own. If it told you the outcome, it did its job. Four habits break it: announcing (\"I will now\n117: check the tests\"), labelling (\"Overview:\"), the fragment opener (\"Context.\") and the set-up\n118: that promises the good part in a moment.\n119: \n120: **The rest of the outcome follows at once.** What the work concluded, what changed and what\n121: to do next are in the reader's hands by the second line. The receipts come after that, and\n122: the handback comes last, per [`communication-handoff.md`](communication-handoff.md) §1.\n123: End when the answer is done. The closing-deletion test: a last line that only asks whether\n124: anything else is needed, or recaps what the reply just said, deletes.\n125: \n126: **Reach the verdict by analysis, then put it first.** The order of the reply is not the order of the thinking. If you cannot state the verdict yet, say that. A named uncertainty is a verdict about the state of the evidence.\n127: \n128: **Recommend one path.** Name its main trade-off, and mention an alternative only when it could change the decision. Mark must-do work apart from nice-to-have. State an assumption you made where evidence was missing, because the reader can correct a visible assumption and cannot correct a silent one.\n129: \n130: **An ambiguous request still gets the answer first.** When two readings lead to different answers, answer the likelier one and say in one line which reading you took. When they lead to materially different work, ask before starting it, per [`uncertainty-and-honesty.md`](uncertainty-and-honesty.md) §1. When you deliver a different version of the ask, the first lines say what changed and why.\n131: \n132: The failure this prevents: a payload that waits behind an announcement or a label, a survey\n133: of options where one recommendation was owed, a swapped or misread request nobody catches,\n134: or a last line that is a farewell and adds nothing.\n135: \n136: ---\n137: \n138: ## 5. HOW THE REPLY MOVES\n139: \n140: **Each paragraph stands alone and carries the reader forward.** A reader who lands mid-reply can act on the paragraph in front of them, and each one picks up where the last one landed: what changed, what it implies, what comes next.\n141: \n142: **Number the steps when there is more than one.** Anything the reader must run, check or\n143: answer gets its own number, one step per line, the number at the start of the line. Numbers\n144: bracketed inside a sentence, (1) then (2) then (3), are a paragraph wearing numbers.\n145: \n146: **No group shows more than five items.** Split a longer set into labelled groups of five or\n147: fewer, or show the five that matter most and say in one line how many are held back, \"the\n148: first five of nine\". The rest is retained, not discarded, and appears when the reader asks.\n149: \n150: **Suppress the tangent.** The reply answers the question it was asked. A second issue worth\n151: raising gets offered once, at the end, in one line. The reader decides whether it happens.\n152: \n153: The failure this prevents: the reader assembles the order themselves, loses track of which\n154: step they have done, mistakes a shortened list for the complete one, or waits for the\n155: answer behind a second issue.\n156: \n157: ---\n158: \n159: ## 6. SENTENCES AND WORDS\n160: \n161: **One idea per sentence.** Short and declarative. When a sentence stacks clauses, split it. Vary the rhythm, and prefer prose when a list would fragment a single argument.\n162: \n163: **State the relation between sentences.** A sentence says how it attaches to the one before: because, but, therefore, for example. When it explains how something works, it names the moving parts: what acts, what it acts on, what changes.\n164: \n165: **Plain words by default.** Reserve exact names for the things that have them: languages, frameworks, APIs, dependencies, commands. Introduce unavoidable jargon one term at a time, in a sentence that defines it by use.\n166: \n167: **No terse machine register.** Replace arrows and symbols standing in for verbs with action words. For stacked noun phrases, say who does what, using the [HVR nominalization guidance](../skills/sk-doc/sk-create-with-human-voice/references/hvr-rules.md#nominalization-and-stacked-compression). Explain each ID, abbreviation or status code in plain words, and say what a bare count or label measures. Turn fragments into complete sentences.\n168: \n169: **Name an identifier only where the reader acts on it.** A path, hash, flag or ID earns its place when the reader will run, open or check it. Elsewhere, say what the thing is. Keep to one or two numbers a sentence, and when the numbers are the point, give each its own sentence or bullet.\n170: \n171: The failure this prevents: a technically correct reply the reader has to decode, where\n172: they supply a link the writer never stated and cannot find the few names and figures they\n173: need.\n174: \n175: ---\n176: \n177: ## 7. PUNCTUATION THE READER TRIPS ON\n178: \n179: - **Never use an em dash.** Use a comma, a full stop or a colon, whichever the sentence wanted.\n180: - **No semicolon.** Two sentences, or a conjunction.\n181: - **No serial comma.** Drop it before the `and` or `or` that closes a list.\n182: \n183: The failure this prevents: dashes read as authored voice to a human and as a tell to a\n184: reader who has seen a lot of generated text.\n185: \n186: The full standard is the Human Voice Rules, which `sk-doc` routes to. Load all of it when writing a document. A reply takes its voice half, the directives, vocabulary lists and tell lists, and leaves its document-structure half.\n187: \n188: ---\n189: \n190: ## 8. LONG STRETCHES AND WHAT THEY FOUND\n191: \n192: **Say where you are going before a long stretch.** Before work the reader cannot see inside, post the intended path: a short numbered list of what you will do and what to expect at each checkpoint. Update it when it changes. Clipped means not narrating each step. It never means starting without saying where you are going.\n193: \n194: **Attach a concrete time estimate when the stretch is long.** Minutes or hours, based on a named earlier run, or marked as an assumption. An estimate informs and never gates. Outside that case, do not open a task with one nobody asked for, and never use one to argue against starting. When the task is too big for one pass, name the smallest slice worth delivering, start there and say what is deferred.\n195: \n196: **A synthesis is not a file path.** When a long run produces findings, the message carries the answer, the few findings behind it, the uncertainty that matters and what was ruled out. The artifact path follows them. Per-iteration narration and internal metrics stay out. Where a run has its own completion contract, as the deep-loop modes do, that contract wins.\n197: \n198: The failure this prevents: twenty minutes of silence, then a result the reader has to\n199: reverse-engineer a plan from, or a path and a count handed over in place of a report.\n200: \n201: ---\n202: \n203: ## 9. WHEN THE READER DID NOT FOLLOW\n204: \n205: \"I don't follow\", \"what?\" or \"too abstract\" calls for a change of modality: a concrete\n206: example, a numbered sequence, a smaller first step or a picture using the runtime's visual\n207: capability. Do not repeat the same explanation at greater length.\n208: \n209: \"say that more plainly\", \"in simple terms\" or \"rewrite that\" calls for a plain\n210: re-render: a copy edit that rewords without reordering, cutting or adding. Every claim,\n211: number, caveat and conclusion keeps its strength. Code, commands, paths, identifiers,\n212: quotations and numbers stay byte-exact. The wording standard is\n213: [hvr-rules.md](../skills/sk-doc/sk-create-with-human-voice/references/hvr-rules.md). If a\n214: plainer word would change what a sentence claims, keep the original.\n215: \n216: The failure this prevents: the same explanation repeats, or the plain rewrite changes the claim.\n217: \n218: ---\n219: \n220: ## 10. WHAT THIS RULE IS NOT\n221: \n222: - **Not a constraint on rigor.** Nothing here softens a claim, a caveat, or a verification standard owned by [`evidence-and-proof.md`](evidence-and-proof.md) or [`uncertainty-and-honesty.md`](uncertainty-and-honesty.md).\n223: - **Not a voice to perform.** When honoring a rule here would weaken the answer, keep the answer.\n224: - **Not a license to omit.** \"Match length to the question\" is about the reader's need,\n225:   never about leaving out what they have to know.\n226: - **Not licence to skip the analysis.** Verdict first is an ordering of the writing, never\n227:   a shortcut in the reasoning.\n228: \n229: ---\n230: \n231: ## 11. SELF-CHECK\n232: \n233: - [ ] The first line carries the answer or the action, not a label, an announcement or a setup, and the outcome is complete by the second line.\n234: - [ ] I reached the verdict by analysis, recommended one path with its trade-off and stated the assumptions I made.\n235: - [ ] Where the request was ambiguous or I delivered a different version of it, the first lines say which reading I took and why.\n236: - [ ] Each paragraph stands alone and carries the reader forward, and multi-step work reads as a numbered list.\n237: - [ ] No