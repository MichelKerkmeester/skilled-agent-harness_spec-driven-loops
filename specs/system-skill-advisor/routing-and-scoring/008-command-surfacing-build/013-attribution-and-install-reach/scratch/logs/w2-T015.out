588:   readonly offeredCommand?: string | null;\n589:   readonly changedPaths?: readonly string[];\n590: }\n591: \n592: // A summary line leads back to the one session its turn wrote, so a case needs a\n593: // store a reader can open. The claude store is the one a fixture builds from\n594: // scratch: the reader accepts a transcript path once the file sits under the\n595: // store it is handed, and the file name is the session id it checks.\n596: function loadableSession(root: string): Record<string, string> {\n597:   const claudeRoot = join(root, 'claude', 'projects');\n598:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n599:   mkdirSync(dirname(transcriptPath), { recursive: true });\n600:   writeFileSync(transcriptPath, `${JSON.stringify({\n601:     type: 'assistant',\n602:     uuid: 'claude-a1',\n603:     sessionId: SUMMARY_SESSION,\n604:     timestamp: TIMESTAMP,\n605:     message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n606:   })}\\n`);\n607:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n608: }\n609: \n610: // Codex names its rollout by the path the runner captured rather than by a session\n611: // folder, so a case that needs a second runtime builds the store under its own root.\n612: function loadableCodexSession(root: string): Record<string, string> {\n613:   const codexRoot = join(root, 'codex', 'sessions');\n614:   const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n615:   mkdirSync(dirname(transcriptPath), { recursive: true });\n616:   writeFileSync(transcriptPath, `${[\n617:     { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n618:     {\n619:       timestamp: TIMESTAMP,\n620:       type: 'response_item',\n621:       payload: {\n622:         type: 'message',\n623:         id: 'codex-a1',\n624:         role: 'assistant',\n625:         content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n626:       },\n627:     },\n628:   ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n629:   return { sessionId: 'codex-1', transcriptPath, codexRoot };\n630: }\n631: \n632: // The summary reads the log a runner leaves behind, so a case supplies the lines\n633: // that log would hold and reads back the block the arm was counted into.\n634: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n635:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n636:   try {\n637:     const logPath = join(root, 'run-log.jsonl');\n638:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n639:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n[Output truncated. Continue reading with offset: 640]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 560-639\n560:     expect(run.status).toBe(2);\n561:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n562:   });\n563: \n564:   it('exits 2 with the reader code when the locator names no transcript', () => {\n565:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n566: \n567:     expect(run.status).toBe(2);\n568:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n569:   });\n570: });\n571: \n572: // ───────────────────────────────────────────────────────────────\n573: // 7. RUN LOG SUMMARY\n574: // ───────────────────────────────────────────────────────────────\n575: \n576: // The one corpus row a summary case answers. A start row is the plainest label a\n577: // fixture can join a transcript to, and the id is fixed so a case carries no\n578: // prompt text of its