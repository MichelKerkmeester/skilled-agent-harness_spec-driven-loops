 exit: 0, locator, changedPaths: ['src/readme.md'] },\n\n  Line 709:   // A start row was offered only when the offer named the command the row expected,\n\n  Line 710:   // so an offer that names another command, or none at all, stays out of the offered\n\n  Line 711:   // count. Both fixture rows started the command, so only the offered one is counted\n\n  Line 717:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n\n  Line 718:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n\n  Line 724:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n\n  Line 736:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n\n  Line 737:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n\n  Line 743:         tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n\n  Line 753:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n\n  Line 764:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n\n  Line 778:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n\n  Line 780:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"pattern\":\"SUMMARY_ROW|RunLogLine|offerFieldAbsent|offered|cappedOfferRows\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\",\"limit\":200}"},"time":{"start":1794546538316,"end":1794546538643}}}}
