n\n  Line 453:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n\n  Line 462:     expect(loopInit(events, '/deep:research')).toBe(false);\n\n  Line 465:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n\n  Line 471:     expect(loopInit(events, '/deep:research')).toBe(false);\n\n  Line 476:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n\n  Line 485:     expect(loopInit(events, '/deep:research')).toBe(false);\n\n  Line 488:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n\n  Line 497:     expect(loopInit(events, '/deep:research')).toBe(true);\n\n  Line 500:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n\n  Line 509:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n\n  Line 512:   it('passes a completion that wrote its own spec document first', () => {\n\n  Line 521:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n\n  Line 524:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n\n  Line 533:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n\n  Line 538:   it('returns null for a command that owns no loop', () => {\n\n  Line 541:     expect(loopInit(events, '/create:readme')).toBeNull();\n\n  Line 542:     expect(loopInit(events, '')).toBeNull();\n\n  Line 554: describe('reader failure', () => {\n\n  Line 557:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n\n  Line 564:   it('exits 2 with the reader code when the locator names no transcript', () => {\n\n  Line 579: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n\n  Line 650: describe('run log summary', () => {\n\n  Line 654:   it('scores a run the cap stopped and counts it as capped', () => {\n\n  Line 656:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n\n  Line 666:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n\n  Line 670:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n\n  Line 685:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n\n  Line 689:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n\n  Line 714:   it('counts the offer a start row answered and the start it took', () => {\n\n  Line 718:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n\n  Line 733:   it('counts an offer on a capped row apart from the starts taken', () => {\n\n  Line 737:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n\n  Line 752:   it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n\n  Line 757:           rowId: SUMMARY_ROW,\n\n  Line 786:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n\n  Line 788:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n\n  Line 799:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n\n  Line 808:   it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n\n  Line 813:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n\n  Line 815:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n","title":"grep","metadata":{"metadata":{"matches":79,"truncated":false},"content":[{"type":"text","text":"Found 79 matches\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts:\n  Line 159: describe('normalize', () => {\n\n  Line 174:   it('counts a shell step that redirects into a file as a write', () => {\n\n  Line 185:   it('leaves a redirect inside a quoted argume