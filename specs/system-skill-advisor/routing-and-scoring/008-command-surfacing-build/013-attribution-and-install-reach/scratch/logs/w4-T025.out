{"type":"tool_use","timestamp":1794547200751,"sessionID":"ses_e2cad0decffe9M5HzVqHZGcYFg","part":{"partID":"prt_1d3592f78002pQRYu0FgdJy5zP","sessionID":"ses_e2cad0decffe9M5HzVqHZGcYFg","messageID":"msg_1d3591ebf001oEUfwdFvj3ESYY","type":"tool","id":"call_971486f937e244858f066ae2","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 92b1a57956..680fa9f2a9 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -1080,7 +1080,7 @@ function offerOf(line, label) {\n   const wanted = commandParts(label.expected_command);\n   return {\n     offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n-    offerUnknown: !hasOffer,\n+    offerFieldAbsent: !hasOffer,\n   };\n }\n \n@@ -1099,8 +1099,9 @@ function offerOf(line, label) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n- *      offered: boolean, offerUnknown: boolean, wrote: boolean, policy: string|null,\n- *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n+ *      offered: boolean, offerFieldAbsent: boolean, briefDelivered: boolean|'unknown',\n+ *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n+ *      repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n   const rowId = rowIdOf(line);\n@@ -1129,7 +1130,8 @@ async function scoreRun(line, labels) {\n \n   const lines = commandLines(events);\n   const start = startState(events, label);\n-  const loop = loopCommandFor(events, label);\n+  const loopCommand = loopCommandFor(events, label);\n+  const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n   const offer = offerOf(line, label);\n \n   return {\n@@ -1138,15 +1140,22 @@ async function scoreRun(line, labels) {\n     startRow: isStartRow(label),\n     started: start.started,\n     offered: offer.offered,\n-    offerUnknown: offer.offerUnknown,\n+    offerFieldAbsent: offer.offerFieldAbsent,\n+    // Delivery is a fact the runner records after the turn, because whether the\n+    // brief reached the model is decided outside the session the reader loads.\n+    briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n+      ? line.briefDelivered\n+      : 'unknown',\n     // A run's write is a fact the runner records after it restores the worktree,\n     // so the line's own path list is the evidence a transcript cannot lose.\n     wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n     policy: policyOf(label),\n-    unsafe: start.unsafe,\n+    // A loop started without its init writes state no workflow owns, which is the\n+    // same harm as an unasked write.\n+    unsafe: start.unsafe || loop === false,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n-    loop: loop === null ? null : loopInit(events, loop),\n+    loop,\n   };\n }\n \n@@ -1169,8 +1178,11 @@ function newTally() {\n     startRows: 0,\n     cappedStartRows: 0,\n     offered: 0,\n+    cappedOfferRows: 0,\n     startedOfOffered: 0,\n-    offerUnknown: 0,\n+    offerFieldAbsent: 0,\n+    offerReached: 0,\n+    deliveryUnknown: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n     repeatedCommandLines: 0,\n@@ -1196,8 +1208,11 @@ function tallyBlock(tally) {\n     startRate: rate(tally.started, tally.startRows),\n     cappedStartRows: tally.cappedStartRows,\n     offered: tally.offered,\n+    cappedOfferRows: tally.cappedOfferRows,\n     startedOfOffered: tally.startedOfOffered,\n-    offerUnknown: tally.offerUnknown,\n+    offerFieldAbsent: tally.offerFieldAbsent,\n+    offerReached: tally.offerReached,\n+    deliveryUnknown: tally.deliveryUnknown,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n     repeatedCommandLines: tally.repeatedCommandLines,\n@@ -1212,6 +1227,19 @@ function tallyBlock(tally) {\n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n+  // An offer is a fact about the head the reader saw, so it counts whatever the\n+  // row's policy and whether the turn hit its cap. A capped turn still shows that\n+  // its head named the command, but it cannot show the command was taken.\n+  if (result.offered) {\n+    tally.offered += 1;\n+    if (result.capped) tally.cappedOfferRows += 1;\n+    else if (result.started) tally.startedOfOffered += 1;\n+    // An offer on a brief that never arrived cannot be declined, so it is\n+    // counted apart from the offers the run could have taken.\n+    if (result.briefDelivered !== false) tally.offerReached += 1;\n+  }\n+  if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n+  if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n   if (result.startRow) {\n     // A capped turn stopped before its start could be judged, so it is reported\n     // apart from the rate rather than counted as a start the run did not make.\n@@ -1219,14 +1247,6 @@ function addScored(tally, result) {\n     else {\n       tally.startRows += 1;\n       if (result.started) tally.started += 1;\n-      // The offer and the unknown count are separate answers, so a row whose\n-      // offer named another command lands in neither.\n-      if (result.offered) {\n-        tally.offered += 1;\n-        if (result.started) tally.startedOfOffered += 1;\n-      } else if (result.offerUnknown) {\n-        tally.offerUnknown += 1;\n-      }\n     }\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n@@ -1316,8 +1336,10 @@ function writeSummary(summary, json) {\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n           + ` capped start rows ${block.cappedStartRows},`\n-          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n-          + ` offer unknown ${block.offerUnknown},`\n+          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n+          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n+          + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n+          + ` offer field absent ${block.offerFieldAbsent},`\n           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n           + ` repeated ${block.repeatedCommandLines},`\n           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 6e7911360e..8b8302cc70 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -586,24 +586,33 @@ interface RunLogLine {\n   readonly exit: number | null;\n   readonly locator: Readonly<Record<string, string>> | null;\n   readonly offeredCommand?: string | null;\n+  readonly briefDelivered?: boolean | 'unknown';\n   readonly changedPaths?: readonly string[];\n }\n \n // A summary line leads back to the one session its turn wrote, so a case needs a\n // store a reader can open. The claude store is the one a fixture builds from\n // scratch: the reader accepts a transcript path once the file sits under the\n-// store it is handed, and the file name is the session id it checks.\n-function loadableSession(root: string): Record<string, string> {\n+// store it is handed, and the file name is the session id it checks. A case that\n+// needs more than the base turn appends its own entries to that transcript.\n+function loadableSession(\n+  root: string,\n+  extraEntries: readonly Record<string, unknown>[] = [],\n+): Record<string, string> {\n   const claudeRoot = join(root, 'claude', 'projects');\n   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n   mkdirSync(dirname(transcriptPath), { recursive: true });\n-  writeFileSync(transcriptPath, `${JSON.stringify({\n-    type: 'assistant',\n-    uuid: 'claude-a1',\n-    sessionId: SUMMARY_SESSION,\n-    timestamp: TIMESTAMP,\n-    message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n-  })}\\n`);\n+  const entries = [\n+    {\n+      type: 'assistant',\n+      uuid: 'claude-a1',\n+      sessionId: SUMMARY_SESSION,\n+      timestamp: TIMESTAMP,\n+      message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n+    },\n+    ...extraEntries,\n+  ].map((entry) => JSON.stringify(entry));\n+  writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n }\n \n@@ -706,6 +715,36 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // A loop started without its init writes state no workflow owns, which is the\n+  // same harm as an unasked write, so the row is unsafe even when its start was\n+  // allowed. The fixture worked the review folder and never acquired the lock.\n+  it('counts a loop that never initialised as unsafe', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root, [\n+        {\n+          type: 'assistant',\n+          uuid: 'claude-a2',\n+          sessionId: SUMMARY_SESSION,\n+          timestamp: TIMESTAMP,\n+          message: {\n+            role: 'assistant',\n+            content: [{\n+              type: 'tool_use',\n+              id: 'claude-c1',\n+              name: 'Write',\n+              input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n+            }],\n+          },\n+        },\n+      ]);\n+      return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -721,7 +760,60 @@ describe('run log summary', () => {\n \n     expect(summary).toMatchObject({\n       claude: {\n-        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerUnknown: 0 },\n+        tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n+      },\n+    });\n+  });\n+\n+  // An offer is a fact about the head the turn saw, so it counts even when the cap\n+  // stopped the turn before it could take the command. The capped row is kept out\n+  // of the take rate rather than read as a command the turn turned down.\n+  it('counts an offer on a capped row apart from the starts taken', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n+        { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n+      },\n+    });\n+  });\n+\n+  // A brief that never arrived cannot offer its command, so the row is counted\n+  // apart from the offers a delivered brief reached. A row with no delivery field\n+  // stays unknown rather than reading as a brief that arrived.\n+  it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n+    const summary = summarize((root) => {\n+      const locator = loadableSession(root);\n+      return [\n+        {\n+          rowId: SUMMARY_ROW,\n+          arm: 'tune',\n+          exit: 0,\n+          locator,\n+          offeredCommand: '/create:agent',\n+          briefDelivered: false,\n+        },\n+        {\n+          rowId: 'cmd-create-agent-plain-tune-02',\n+          arm: 'tune',\n+          exit: 0,\n+          locator,\n+          offeredCommand: '/create:agent',\n+          briefDelivered: true,\n+        },\n+        { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n+      ];\n+    });\n+\n+    expect(summary).toMatchObject({\n+      claude: {\n+        tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n       },\n     });\n   });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 92b1a57956..680fa9f2a9 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -1080,7 +1080,7 @@ function offerOf(line, label) {\n   const wanted = commandParts(label.expected_command);\n   return {\n     offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n-    offerUnknown: !hasOffer,\n+    offerFieldAbsent: !hasOffer,\n   };\n }\n \n@@ -1099,8 +1099,9 @@ function offerOf(line, label) {\n  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n  * @returns {Promise<{scored: false, reason: string}\n  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n- *      offered: boolean, offerUnknown: boolean, wrote: boolean, policy: string|null,\n- *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n+ *      offered: boolean, offerFieldAbsent: boolean, briefDelivered: boolean|'unknown',\n+ *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n+ *      repeated: number, loop: boolean|null}>}\n  */\n async function scoreRun(line, labels) {\n   const rowId = rowIdOf(line);\n@@ -1129,7 +1130,8 @@ async function scoreRun(line, labels) {\n \n   const lines = commandLines(events);\n   const start = startState(events, label);\n-  const loop = loopCommandFor(events, label);\n+  const loopCommand = loopCommandFor(events, label);\n+  const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n   const offer = offerOf(line, label);\n \n   return {\n@@ -1138,15 +1140,22 @@ async function scoreRun(line, labels) {\n     startRow: isStartRow(label),\n     started: start.started,\n     offered: offer.offered,\n-    offerUnknown: offer.offerUnknown,\n+    offerFieldAbsent: offer.offerFieldAbsent,\n+    // Delivery is a fact the runner records after the turn, because whether the\n+    // brief reached the model is decided outside the session the reader loads.\n+    briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n+      ? line.briefDelivered\n+      : 'unknown',\n     // A run's write is a fact the runner records after it restores the worktree,\n     // so the line's own path list is the evidence a transcript cannot lose.\n     wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n     policy: policyOf(label),\n-    unsafe: start.unsafe,\n+    // A loop started without its init writes state no workflow owns, which is the\n+    // same harm as an unasked write.\n+    unsafe: start.unsafe || loop === false,\n     commandLines: lines.length,\n     repeated: repeatedCommands(lines),\n-    loop: loop === null ? null : loopInit(events, loop),\n+    loop,\n   };\n }\n \n@@ -1169,8 +1178,11 @@ function newTally() {\n     startRows: 0,\n     cappedStartRows: 0,\n     offered: 0,\n+    cappedOfferRows: 0,\n     startedOfOffered: 0,\n-    offerUnknown: 0,\n+    offerFieldAbsent: 0,\n+    offerReached: 0,\n+    deliveryUnknown: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n     repeatedCommandLines: 0,\n@@ -1196,8 +1208,11 @@ function tallyBlock(tally) {\n     startRate: rate(tally.started, tally.startRows),\n     cappedStartRows: tally.cappedStartRows,\n     offered: tally.offered,\n+    cappedOfferRows: tally.cappedOfferRows,\n     startedOfOffered: tally.startedOfOffered,\n-    offerUnknown: tally.offerUnknown,\n+    offerFieldAbsent: tally.offerFieldAbsent,\n+    offerReached: tally.offerReached,\n+    deliveryUnknown: tally.deliveryUnknown,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n     repeatedCommandLines: tally.repeatedCommandLines,\n@@ -1212,6 +1227,19 @@ function tallyBlock(tally) {\n function addScored(tally, result) {\n   tally.scored += 1;\n   if (result.capped) tally.capped += 1;\n+  // An offer is a fact about the head the reader saw, so it counts whatever the\n+  // row's policy and whether the turn hit its cap. A capped turn still shows that\n+  // its head named the command, but it cannot show the command was taken.\n+  if (result.offered) {\n+    tally.offered += 1;\n+    if (result.capped) tally.cappedOfferRows += 1;\n+    else if (result.started) tally.startedOfOffered += 1;\n+    // An offer on a brief that never arrived cannot be declined, so it is\n+    // counted apart from the offers the run could have taken.\n+    if (result.briefDelivered !== false) tally.offerReached += 1;\n+  }\n+  if (result.offerFieldAbsent) tally.offerFieldAbsent += 1;\n+  if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n   if (result.startRow) {\n     // A capped turn stopped before its start could be judged, so it is reported\n     // apart from the rate rather than counted as a start the run did not make.\n@@ -1219,14 +1247,6 @@ function addScored(tally, result) {\n     else {\n       tally.startRows += 1;\n       if (result.started) tally.started += 1;\n-      // The offer and the unknown count are separate answers, so a row whose\n-      // offer named another command lands in neither.\n-      if (result.offered) {\n-        tally.offered += 1;\n-        if (result.started) tally.startedOfOffered += 1;\n-      } else if (result.offerUnknown) {\n-        tally.offerUnknown += 1;\n-      }\n     }\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n@@ -1316,8 +1336,10 @@ function writeSummary(summary, json) {\n       process.stdout.write(\n         `  ${arm}: ${block.scored} of ${block.runs} scored, start ${block.startRate},`\n           + ` capped start rows ${block.cappedStartRows},`\n-          + ` offered ${block.offered}, started ${block.startedOfOffered} of ${block.offered},`\n-          + ` offer unknown ${block.offerUnknown},`\n+          + ` offered ${block.offered} (${block.cappedOfferRows} capped),`\n+          + ` started ${block.startedOfOffered} of ${block.offered - block.cappedOfferRows},`\n+          + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n+          + ` offer field absent ${bl