== expected && deliveredPolicy !== null;\n505: \n506:       if (row.row_type === 'typed') {\n507:         addRow(typed, top1Hit, top3Hit);\n508:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n509:         typedRowResults[row.id] = {\n510:           expected_command: expected,\n511:           top: ids[0] ?? null,\n512:           carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n513:           command: delivered ?? null,\n514:           policy: deliveredPolicy,\n515:         };\n516:       }\n517:       if (isPlainSplit) {\n518:         addRow(plain[row.split], top1Hit, top3Hit);\n519:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n[Output truncated. Continue reading with offset: 520]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\",\"offset\":460,\"limit\":60}"},"time":{"start":1794547507239,"end":1794547507835}}}}
