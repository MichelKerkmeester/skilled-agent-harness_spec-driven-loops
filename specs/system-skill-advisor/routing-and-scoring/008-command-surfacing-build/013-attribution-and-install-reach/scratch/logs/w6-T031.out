ture threads the same path rather than scoring with\n481:       // the lane blind. Under the fixture regime the lane derives its own\n482:       // deterministic vector and the direct call is the whole behavior.\n483:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n484:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n485:       const ids = recommendationIds(result);\n486:       const landed = ids.map((id) => commandOf(idToCommand, id));\n487:       const expected = row.expected_command ?? null;\n488:       const top1Hit = expected !== null && landed[0] === expected;\n489:       const top3Hit = expected !== null && landed.includes(expected);\n490:       const offered = landed.some((command) => command !== null);\n491:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n492: \n493:       // A hub can name the slash command its route would take, which is reach a\n494:       // reader otherwise gets only by translating the workflow mode by hand.\n495:       const topId = ids[0];\n496:       const attached = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n497:         ? attachCommand(topId, readCompiledRoute(workspaceRoot, topId, row.prompt), row.prompt)\n498:         : undefined;\n499:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n500:       // A typed command is the reader's own wording, so it outranks the hub's\n501:       // route in the delivered command, the same precedence the handler applies.\n502:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n503:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n504:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n505: \n506:       if (row.row_type === 'typed') {\n507:         addRow(typed, top1Hit, top3Hit);\n