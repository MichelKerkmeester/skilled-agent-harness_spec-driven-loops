ed skill.md, in any capitalisation, as one skill, so its\n+ * siblings disappear. Cursor reads every command under a flat name, so nothing\n+ * is hidden there.\n  */\n function commandVisibility(expectedLinks) {\n   const folders = new Map();\n@@ -251,12 +251,13 @@ function commandVisibility(expectedLinks) {\n   let total = 0;\n   for (const names of folders.values()) {\n     total += names.length;\n-    visible += names.includes('skill.md') ? 1 : names.length;\n+    const hidesSiblings = names.some((name) => name.toLowerCase() === 'skill.md');\n+    visible += hidesSiblings ? 1 : names.length;\n   }\n   return { claude: { visible, total }, cursor: { visible: total, total } };\n }\n \n-/** Folders where a skill.md hides the folder's other commands from Claude Code. */\n+/** Folders where a file named skill.md, in any capitalisation, hides the folder's other commands from Claude Code. */\n function collapseDrift(expectedLinks) {\n   const folders = new Map();\n   for (const link of expectedLinks) {\n@@ -269,9 +270,9 @@ function collapseDrift(expectedLinks) {\n   }\n   const drift = [];\n   for (const [folder, names] of folders) {\n-    if (!names.includes('skill.md')) continue;\n-    if (COLLAPSE_ALLOWLIST.has(`${folder}/skill.md`)) continue;\n-    drift.push(`COLLAPSE ${folder}/skill.md hides ${names.length - 1} sibling commands on Claude Code`);\n+    const skillFile = names.find((name) => name.toLowerCase() === 'skill.md');\n+    if (!skillFile) continue;\n+    drift.push(`COLLAPSE ${folder}/${skillFile} hides ${names.length - 1} sibling commands on Claude Code`);\n   }\n   return drift;\n }\ndiff --git a/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs b/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\nindex 78bc201cac..977e68bd2c 100644\n--- a/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\n+++ b/.skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\n@@ -261,7 +261,7 @@ test('derives each DSH adapter link from the hook library and flags a real file\n   }\n });\n \n-test('counts what each runtime shows and allows the known create collapse', () => {\n+test('counts what each runtime shows and flags the create collapse', () => {\n   const expected = [\n     { tree: 'claude-commands', mirror: '.claude/commands/create/skill.md', source: '.skilled/commands/create/skill.md' },\n     { tree: 'claude-commands', mirror: '.claude/commands/create/readme.md', source: '.skilled/commands/create/readme.md' },\n@@ -271,7 +271,9 @@ test('counts what each runtime shows and allows the known create collapse', () =\n     claude: { visible: 2, total: 3 },\n     cursor: { visible: 3, total: 3 },\n   });\n-  assert.deepEqual(collapseDrift(expected), []);\n+  assert.deepEqual(collapseDrift(expected), [\n+    'COLLAPSE create/skill.md hides 1 sibling commands on Claude Code',\n+  ]);\n });\n \n test('flags a command folder whose skill.md hides its siblings on Claude Code', () => {\n@@ -283,3 +285,14 @@ test('flags a command folder whose skill.md hides its siblings on Claude Code',\n     'COLLAPSE design/skill.md hides 1 sibling commands on Claude Code',\n   ]);\n });\n+\n+test('flags a skill file in any capitalisation', () => {\n+  const expected = [\n+    { tree: 'claude-commands', mirror: '.claude/commands/design/SKILL.md', source: '.skilled/commands/design/SKILL.md' },\n+    { tree: 'claude-commands', mirror: '.claude/commands/design/chart.md', source: '.skilled/commands/design/chart.md' },\n+  ];\n+  assert.deepEqual(commandVisibility(expected).claude, { visible: 1, total: 2 });\n+  assert.deepEqual(collapseDrift(expected), [\n+    'COLLAPSE design/SKILL.md hides 1 sibling commands on Claude Code',\n+  ]);\n+});\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -c core.fsmonitor=false diff -- .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/README.md .skilled/skills/system-spec-kit/runtime/cli/tests/sync-runtime-mirrors.test.mjs\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794582918820,"end":1794582919124}}}}
