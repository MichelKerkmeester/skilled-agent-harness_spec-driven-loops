{"type":"tool_use","timestamp":1794584993399,"sessionID":"ses_e2a666a64ffe0MO4YglSgi7g6l","part":{"partID":"prt_1d599dd5f001OozBVrod6k8kXm","sessionID":"ses_e2a666a64ffe0MO4YglSgi7g6l","messageID":"msg_1d599cb0f0011ft2NEh9o7d1yJ","type":"tool","id":"call_d4d6b786f0ba40fe946612d6","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts, lines 1-106\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // A doctor problem worded unlike any bridge phrase reaches /doctor:helper through the helper's\n5: // own ranker. These cases pin the cue tiers and the ranker bridge; the routing slice pins the\n6: // end-to-end ranking.\n7: \n8: import { mkdtempSync } from 'node:fs';\n9: import { tmpdir } from 'node:os';\n10: import { dirname, join } from 'node:path';\n11: import { fileURLToPath } from 'node:url';\n12: \n13: import { describe, expect, it } from 'vitest';\n14: \n15: import { doctorProblemCue, genericRepairCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n16: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n17: \n18: const HERE = dirname(fileURLToPath(import.meta.url));\n19: const WORKSPACE = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: '.skilled' });\n20: \n21: describe('doctor problem cue', () => {\n22:   it('reads a wrong state or a health check as a strong cue', () => {\n23:     expect(doctorProblemCue('code mode mcp is not registered in my runtime')).toBe('strong');\n24:     expect(doctorProblemCue('my deep research run never converges')).toBe('strong');\n25:     expect(doctorProblemCue('the trigger index lookup returns nothing')).toBe('strong');\n26:     expect(doctorProblemCue('turn off one of the github actions workflows')).toBe('strong');\n27:   });\n28: \n29:   // A hook that does not fire is a broken state, not a bare problem word: the\n30:   // operator reports it in exactly this shape, and the cue is what lets the\n31:   // hand-off stand beside a passing skill.\n32:   it('reads a hook that does not fire as a strong cue', () => {\n33:     expect(doctorProblemCue('my hooks are not firing, what do I run')).toBe('strong');\n34:     expect(doctorProblemCue('the git hooks are not triggering on commit')).toBe('strong');\n35:   });\n36: \n37:   // A tool that never appears is the same wrong state as one that does not\n38:   // register, and the operator reports it in the negative rather than with a\n39:   // problem adjective.\n40:   it('reads a tool that does not show up as a strong cue', () => {\n41:     expect(doctorProblemCue('the deploy button is not showing up after the update')).toBe('strong');\n42:     expect(doctorProblemCue(\"my new agent isn't appearing in the picker\")).toBe('strong');\n43:     expect(doctorProblemCue(\"don't show line numbers in the diff\")).toBeNull();\n44:     expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\n45:   });\n46: \n47:   // A loop that stopped converging reports the same wrong state in the past\n48:   // tense, which the \"never <verb>\" form does not cover.\n49:   it('reads a loop that stopped converging as a strong cue', () => {\n50:     expect(doctorProblemCue('my research loop stopped converging and I cannot see why')).toBe('strong');\n51:   });\n52: \n53:   it('reads a bare problem word as a weak cue', () => {\n54:     expect(doctorProblemCue('Fix the broken JSON example and revalidate the packet.')).toBe('weak');\n55:     expect(doctorProblemCue('my AGENTS.md is out of date with the template')).toBe('weak');\n56:   });\n57: \n58:   it('finds no cue in a plain request', () => {\n59:     expect(doctorProblemCue('Start a deep review loop over the packet docs.')).toBeNull();\n60:     expect(doctorProblemCue('my doctor update came in')).toBeNull();\n61:   });\n62: });\n63: \n64: describe('generic repair request cue', () => {\n65:   // A repair route asked for in these words names no problem the ranker knows,\n66:   // and the helper lists every route with its reason.\n67:   it('reads a request for a repair route as a doctor request', () => {\n68:     expect(genericRepairCue('I have a problem and want the right repair path suggested with reasons')).toBe(true);\n69:   });\n70: \n71:   // The same words in a remark about resolved work describe no open problem.\n72:   it('ignores the same words once the problem is fixed', () => {\n73:     expect(genericRepairCue('much appreciated, that fixed the problem completely')).toBe(false);\n74:   });\n75: });\n76: \n77: describe('doctor helper ranker bridge', () => {\n78:   it('returns the command the helper ranks first for a doctor problem', () => {\n79:     const match = matchDoctorProblem('my deep research run never converges', WORKSPACE);\n80:     expect(match?.command).toBe('/doctor:deep-loop');\n81:     expect(match?.score).toBeGreaterThanOrEqual(6);\n82:   });\n83: \n84:   // The manifest phrases are the whole reason this reaches a command: the ranker\n85:   // carries no synonym list of its own.\n86:   it('reaches the git route for hooks that stopped firing', () => {\n87:     const match = matchDoctorProblem('my hooks are not firing, what do I run', WORKSPACE);\n88:     expect(match?.command).toBe('/doctor:git');\n89:     expect(match?.score).toBeGreaterThanOrEqual(6);\n90:   });\n91: \n92:   // The ranker names the runnable with its subcommand, so a hand-off can offer\n93:   // the exact command that runs instead of the helper that lists it.\n94:   it('returns the ranked runnable with its subcommand', () => {\n95:     expect(matchDoctorProblem('confirm the AGENTS.md sections in this repo have not drifted', WORKSPACE)?.runnable).toBe('/doctor:agents-md check');\n96:     expect(matchDoctorProblem('show me every GitHub Actions workflow and whether each is enabled', WORKSPACE)?.runnable).toBe('/doctor:ci report');\n97:   });\n98: \n99:   it('returns null for a prompt the helper does not match', () => {\n100:     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n101:   });\n102: \n103:   it('returns null when the workspace has no doctor helper', () => {\n104:     expect(matchDoctorProblem('my deep research run never converges', mkdtempSync(join(tmpdir(), 'no-doctor-')))).toBeNull();\n105:   });\n106: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts, lines 1-106\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // A doctor problem worded unlike any bridge phrase reaches /doctor:helper through the helper's\n5: // own ranker. These cases pin the cue tiers and the ranker bridge; the routing slice pins the\n6: // end-to-end ranking.\n7: \n8: import { mkdtempSync } from 'node:fs';\n9: import { tmpdir } from 'node:os';\n10: import { dirname, join } from 'node:path';\n11: import { fileURLToPath } from 'node:url';\n12: \n13: import { describe, expect, it } from 'vitest';\n14: \n15: import { doctorProblemCue, genericRepairCue, matchDoctorProblem } from '../lib/scorer/doctor-helper-handoff.js';\n16: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n17: \n18: const HERE = dirname(fileURLToPath(import.meta.url));\n19: const WORKSPACE = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: '.skilled' });\n20: \n21: describe('doctor problem cue', () => {\n22:   it('reads a wrong state or a health check as a strong cue', () => {\n23:     expect(doctorProblemCue('code mode mcp is not registered in my runtime')).toBe('strong');\n24:     expect(doctorProblemCue('my deep research run never converges')).toBe('strong');\n25:     expect(doctorProblemCue('the trigger index lookup returns nothing')).toBe('strong');\n26:     expect(doctorProblemCue('turn off one of the github actions workflows')).toBe('strong');\n27:   });\n28: \n29:   // A hook that does not fire is a broken state, not a bare problem word: the\n30:   // operator reports it in exactly this shape, and the cue is what lets the\n31:   // hand-off stand beside a passing skill.\n32:   it('reads a hook that does not fire as a strong cue', () => {\n33:     expect(doctorProblemCue('my hooks are not firing, what do I run')).toBe('strong');\n34:     expect(doctorProblemCue('the git hooks are not triggering on commit')).toBe('strong');\n35:   });\n36: \n37:   // A tool that never appears is the same wrong state as one that does not\n38:   // register, and the operator reports it in the negative rather than with a\n39:   // problem adjective.\n40:   it('reads a tool that does not show up as a strong cue', () => {\n41:     expect(doctorProblemCue('the deploy button is not showing up after the update')).toBe('strong');\n42:     expect(doctorProblemCue(\"my new agent isn't appearing in the picker\")).toBe('strong');\n43:     expect(doctorProblemCue(\"don't show line numbers in the diff\")).toBeNull();\n44:     expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\n45:   });\n46: \n47:   // A loop that stopped converging reports the same wrong state in the past\n48:   // tense, which the \"never <verb>\" form does not cover.\n49:   it('reads a loop that stopped converging as a strong cue', () => {\n50:     expect(doctorProblemCue('my research loop stopped converging and I cannot see why')).toBe('strong');\n51:   });\n52: \n53:   it('reads a bare problem word as a weak cue', () => {\n54:     expect(doctorProblemCue('Fix the broken JSON example and revalidate the packet.')).toBe('weak');\n55:     expect(doctorProblemCue('my AGENTS.md is out of date with the template')).toBe('weak');\n56:   });\n57: \n58:   it('finds no cue in a plain request', () => {\n59:     expect(doctorProblemCue('Start a deep review loop over the packet docs.')).toBeNull();\n60:     expect(doctorProblemCue('my doctor update came in')).toBeNull();\n61:   });\n62: });\n63: \n64: describe('generic repair request cue', () => {\n65:   // A repair route asked for in these words names no problem the ranker knows,\n66:   // and the helper lists every route with its reason.\n67:   it('reads a request for a repair route as a doctor request', () => {\n68:     expect(genericRepairCue('I have a problem and want the right repair path suggested with reasons')).toBe(true);\n69:   });\n70: \n71:   // The same words in a remark about resolved work describe no open problem.\n72:   it('ignores the same words once the problem is fixed', () => {\n73:     expect(genericRepairCue('much appreciated, that fixed the problem completely')).toBe(false);\n74:   });\n75: });\n76: \n77: describe('doctor helper ranker bridge', () => {\n78:   it('returns the command the helper ranks first for a doctor problem', () => {\n79:     const match = matchDoctorProblem('my deep research run never converges', WORKSPACE);\n80:     expect(match?.command).toBe('/doctor:deep-loop');\n81:     expect(match?.score).toBeGreaterThanOrEqual(6);\n82:   });\n83: \n84:   // The manifest phrases are the whole reason this reaches a command: the ranker\n85:   // carries no synonym list of its own.\n86:   it('reaches the git route for hooks that stopped firing', () => {\n87:     const match = matchDoctorProblem('my hooks are not firing, what do I run', WORKSPACE);\n88:     expect(match?.command).toBe('/doctor:git');\n89:     expect(match?.score).toBeGreaterThanOrEqual(6);\n90:   });\n91: \n92:   // The ranker names the runnable with its subcommand, so a hand-off can offer\n93:   // the exact command that runs instead of the helper that lists it.\n94:   it('returns the ranked runnable with its subcommand', () => {\n95:     expect(matchDoctorProblem('confirm the AGENTS.md sections in this repo have not drifted', WORKSPACE)?.runnable).toBe('/doctor:agents-md check');\n96:     expect(matchDoctorProblem('show me every GitHub Actions workflow and whether each is enabled', WORKSPACE)?.runnable).toBe('/doctor:ci report');\n97:   });\n98: \n99:   it('returns null for a prompt the helper does not match', () => {\n100:     expect(matchDoctorProblem('write me a poem about cats', WORKSPACE)).toBeNull();\n101:   });\n102: \n103:   it('returns null when the workspace has no doctor helper', () => {\n104:     expect(matchDoctorProblem('my deep research run never converges', mkdtempSync(join(tmpdir(), 'no-doctor-')))).toBeNull();\n105:   });\n106: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\"}"},"time":{"start":1794584993119,"end":1794584993399}}}}
{"type":"tool_use","timestamp":1794584993405,"sessionID":"ses_e2a666a64ffe0MO4YglSgi7g6l","part":{"partID":"prt_1d599dc13001MuzyZkzt0Q2ytC","sessionID":"ses_e2a666a64ffe0MO4YglSgi7g6l","messageID":"msg_1d599cb0f0011ft2NEh9o7d1yJ","type":"tool","id":"call_9d315e21296f452181b4060f","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-175\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A tool or command that does\n49: // not show up or appear is that wrong state, like one that is not registered or\n50: // not found. A weak cue is a bare word that ordinary work requests also use\n51: // (\"fix the broken example\"), so it counts only when no skill passes. Every\n52: // hand-off needs at least one cue.\n53: const STRONG_PROBLEM_CUE = new RegExp([\n54:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*|show(?:s|ing)? up|appear(?:s|ing)?)\\\\b\",\n55:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n56:   '\\\\bstopped converg\\\\w*\\\\b',\n57:   '\\\\breturns? nothing\\\\b',\n58:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n59:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n60:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n61: ].join('|'), 'i');\n62: \n63: const WEAK_PROBLEM_CUE = new RegExp([\n64:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n65:   '\\\\bout of (?:date|sync)\\\\b',\n66: ].join('|'), 'i');\n67: \n68: // A request for a repair route that names no problem the ranker knows still\n69: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n70: // phrases are exact, so ordinary work requests never carry them.\n71: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n72: \n73: // ───────────────────────────────────────────────────────────────────\n74: // 3. TYPES\n75: // ───────────────────────────────────────────────────────────────────\n76: \n77: interface HelperCandidate {\n78:   readonly command: string;\n79:   readonly runnable?: string;\n80:   readonly score: number;\n81: }\n82: \n83: interface HelperModule {\n84:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n85:   readonly rankProblem: (\n86:     entries: readonly unknown[],\n87:     text: string,\n88:     options: { readonly top: number },\n89:   ) => { readonly candidates?: readonly HelperCandidate[] };\n90: }\n91: \n92: interface LoadedHelper {\n93:   readonly manifestMtimeMs: number;\n94:   readonly module: HelperModule;\n95:   readonly entries: readonly unknown[];\n96: }\n97: \n98: /** The doctor command the helper ranked first, with its rank score. */\n99: export interface DoctorProblemMatch {\n100:   readonly command: string;\n101:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n102:   readonly runnable: string;\n103:   readonly score: number;\n104: }\n105: \n106: // ───────────────────────────────────────────────────────────────────\n107: // 4. HELPERS\n108: // ───────────────────────────────────────────────────────────────────\n109: \n110: const loadedByRoot = new Map<string, LoadedHelper | null>();\n111: \n112: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n113:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n114:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n115:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n116:   let manifestMtimeMs: number;\n117:   try {\n118:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n119:   } catch {\n120:     return null;\n121:   }\n122:   const cached = loadedByRoot.get(workspaceRoot);\n123:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n124:   try {\n125:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n126:     const loaded: LoadedHelper = {\n127:       manifestMtimeMs,\n128:       module: helper,\n129:       entries: helper.loadEntries(workspaceRoot).entries,\n130:     };\n131:     loadedByRoot.set(workspaceRoot, loaded);\n132:     return loaded;\n133:   } catch {\n134:     loadedByRoot.set(workspaceRoot, null);\n135:     return null;\n136:   }\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────────\n140: // 5. CORE LOGIC\n141: // ───────────────────────────────────────────────────────────────────\n142: \n143: /** The strongest problem cue the prompt carries. */\n144: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n145:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n146:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n147:   return null;\n148: }\n149: \n150: /** True when the prompt asks for a repair route without naming the problem. */\n151: export function genericRepairCue(prompt: string): boolean {\n152:   return GENERIC_REPAIR_CUE.test(prompt);\n153: }\n154: \n155: /**\n156:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n157:  * candidate when that candidate reaches the hand-off score, or null.\n158:  */\n159: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n160:   const loaded = loadHelper(workspaceRoot);\n161:   if (!loaded) return null;\n162:   try {\n163:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n164:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n165:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n166:       ? {\n167:           command: first.command,\n168:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n169:           score: first.score,\n170:         }\n171:       : null;\n172:   } catch {\n173:     return null;\n174:   }\n175: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-175\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A tool or command that does\n49: // not show up or appear is that wrong state, like one that is not registered or\n50: // not found. A weak cue is a bare word that ordinary work requests also use\n51: // (\"fix the broken example\"), so it counts only when no skill passes. Every\n52: // hand-off needs at least one cue.\n53: const STRONG_PROBLEM_CUE = new RegExp([\n54:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*|show(?:s|ing)? up|appear(?:s|ing)?)\\\\b\",\n55:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n56:   '\\\\bstopped converg\\\\w*\\\\b',\n57:   '\\\\breturns? nothing\\\\b',\n58:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n59:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n60:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n61: ].join('|'), 'i');\n62: \n63: const WEAK_PROBLEM_CUE = new RegExp([\n64:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n65:   '\\\\bout of (?:date|sync)\\\\b',\n66: ].join('|'), 'i');\n67: \n68: // A request for a repair route that names no problem the ranker knows still\n69: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n70: // phrases are exact, so ordinary work requests never carry them.\n71: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n72: \n73: // ───────────────────────────────────────────────────────────────────\n74: // 3. TYPES\n75: // ───────────────────────────────────────────────────────────────────\n76: \n77: interface HelperCandidate {\n78:   readonly command: string;\n79:   readonly runnable?: string;\n80:   readonly score: number;\n81: }\n82: \n83: interface HelperModule {\n84:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n85:   readonly rankProblem: (\n86:     entries: readonly unknown[],\n87:     text: string,\n88:     options: { readonly top: number },\n89:   ) => { readonly candidates?: readonly HelperCandidate[] };\n90: }\n91: \n92: interface LoadedHelper {\n93:   readonly manifestMtimeMs: number;\n94:   readonly module: HelperModule;\n95:   readonly entries: readonly unknown[];\n96: }\n97: \n98: /** The doctor command the helper ranked first, with its rank score. */\n99: export interface DoctorProblemMatch {\n100:   readonly command: string;\n101:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n102:   readonly runnable: string;\n103:   readonly score: number;\n104: }\n105: \n106: // ───────────────────────────────────────────────────────────────────\n107: // 4. HELPERS\n108: // ───────────────────────────────────────────────────────────────────\n109: \n110: const loadedByRoot = new Map<string, LoadedHelper | null>();\n111: \n112: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n113:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n114:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n115:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n116:   let manifestMtimeMs: number;\n117:   try {\n118:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n119:   } catch {\n120:     return null;\n121:   }\n122:   const cached = loadedByRoot.get(workspaceRoot);\n123:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n124:   try {\n125:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n126:     const loaded: LoadedHelper = {\n127:       manifestMtimeMs,\n128:       module: helper,\n129:       entries: helper.loadEntries(workspaceRoot).entries,\n130:     };\n131:     loadedByRoot.set(workspaceRoot, loaded);\n132:     return loaded;\n133:   } catch {\n134:     loadedByRoot.set(workspaceRoot, null);\n135:     return null;\n136:   }\n137: }\n138: \n139: // ───────────────────────────────────────────────────────────────────\n140: // 5. CORE LOGIC\n141: // ───────────────────────────────────────────────────────────────────\n142: \n143: /** The strongest problem cue the prompt carries. */\n144: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n145:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n146:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n147:   return null;\n148: }\n149: \n150: /** True when the prompt asks for a repair route without naming the problem. */\n151: export function genericRepairCue(prompt: string): boolean {\n152:   return GENERIC_REPAIR_CUE.test(prompt);\n153: }\n154: \n155: /**\n156:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n157:  * candidate when that candidate reaches the hand-off score, or null.\n158:  */\n159: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n160:   const loaded = loadHelper(workspaceRoot);\n161:   if (!loaded) return null;\n162:   try {\n163:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n164:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n165:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n166:       ? {\n167:           command: first.command,\n168:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n169:           score: first.score,\n170:         }\n171:       : null;\n172:   } catch {\n173:     return null;\n174:   }\n175: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\"}"},"time":{"start":1794584992787,"end":1794584993405}}}}
