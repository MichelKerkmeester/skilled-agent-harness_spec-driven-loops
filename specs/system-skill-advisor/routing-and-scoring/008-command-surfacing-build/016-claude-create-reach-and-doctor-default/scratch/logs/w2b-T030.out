on is not showing up after the update')).toBe('strong');\n     expect(doctorProblemCue(\"my new agent isn't appearing in the picker\")).toBe('strong');\n+    expect(doctorProblemCue(\"it doesn't appear to cover the routing case\")).toBeNull();\n+    expect(doctorProblemCue(\"don't show up-to-date entries only\")).toBeNull();\n+    expect(doctorProblemCue('the linter does not appear in the tool list')).toBe('strong');\n     expect(doctorProblemCue(\"don't show line numbers in the diff\")).toBeNull();\n     expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\n   });\n \n","status":"modified","additions":3,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\",\"oldString\":\"    expect(doctorProblemCue(\\\"my new agent isn't appearing in the picker\\\")).toBe('strong');\\n    expect(doctorProblemCue(\\\"don't show line numbers in the diff\\\")).toBeNull();\\n    expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\",\"newString\":\"    expect(doctorProblemCue(\\\"my new agent isn't appearing in the picker\\\")).toBe('strong');\\n    expect(doctorProblemCue(\\\"it doesn't appear to cover the routing case\\\")).toBeNull();\\n    expect(doctorProblemCue(\\\"don't show up-to-date entries only\\\")).toBeNull();\\n    expect(doctorProblemCue('the linter does not appear in the tool list')).toBe('strong');\\n    expect(doctorProblemCue(\\\"don't show line numbers in the diff\\\")).toBeNull();\\n    expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\"}"},"time":{"start":1794585039002,"end":1794585040934}}}}
