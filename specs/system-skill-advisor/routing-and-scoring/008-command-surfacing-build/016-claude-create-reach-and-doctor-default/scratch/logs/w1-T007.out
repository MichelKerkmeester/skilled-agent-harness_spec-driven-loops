81:         \"sk-create-with-human-voice/assets/voice-report-template.md\",\n382:         \"sk-create-with-human-voice/references/README.md\",\n383:         \"sk-create-with-human-voice/references/hvr-rules.md\",\n384:         \"sk-create-with-human-voice/references/scope-and-exemptions.md\",\n385:         \"sk-create-with-human-voice/references/scoring-and-verification.md\",\n386:         \"sk-create-skill/assets/parent-skill/parent-skill-command-metadata-template.json\",\n387:         \"sk-create-skill/assets/parent-skill/parent-skill-description-template.json\",\n388:         \"sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\",\n389:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\",\n390:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\",\n391:         \"sk-create-skill/assets/parent-skill/parent-skill-leaf-aliases-template.json\",\n392:         \"sk-create-skill/assets/parent-skill/parent-skill-readme-template.md\",\n393:         \"sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\",\n394:         \"sk-create-skill/assets/parent-skill/parent-skill-root-router-template.md\",\n395:         \"sk-create-skill/assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n396:         \"sk-create-skill/assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n397:         \"sk-create-skill/assets/skill/skill-asset-template.md\",\n398:         \"sk-create-skill/assets/skill/skill-graph-metadata-template.json\",\n399:         \"sk-create-skill/assets/skill/skill-leaf-manifest-config-template.json\",\n400:         \"sk-create-skill/assets/skill/skill-md-template.md\",\n401:         \"sk-create-skill/assets/skill/skill-procedure-template.md\",\n402:         \"sk-create-skill/assets/skill/skill-readme-template.md\",\n403:         \"sk-create-skill/assets/skill/skill-reference-template.md\",\n404:         \"sk-create-skill/assets/skill/skill-scaffold-template.md\",\n405:         \"sk-create-skill/assets/skill/skill-smart-router.md\",\n406:         \"sk-create-skill/assets/skill/skill-sync-manifest-template.md\",\n407:         \"sk-create-skill/references/README.md\",\n408:         \"sk-create-skill/references/parent-skill/compiled-routing-architecture.md\",\n409:         \"sk-create-skill/references/parent-skill/compiled-routing-lockstep-surfaces.json\",\n410:         \"sk-create-skill/references/parent-skill/parent-hub-router-schema.md\",\n411:         \"sk-create-skill/references/parent-skill/parent-skills-nested-packets.md\",\n412:         \"sk-create-skill/references/shared/advisor-index-handoff.md\",\n413:         \"sk-create-skill/references/shared/common-pitfalls.md\",\n414:         \"sk-create-skill/references/shared/overview.md\",\n415:         \"sk-create-skill/references/shared/skill-root-metadata-contract.md\",\n416:         \"sk-create-skill/references/shared/validation-and-packaging.md\",\n417:         \"sk-create-skill/references/skill/creation-workflow.md\",\n418:         \"sk-create-skill/references/skill/examples-and-maintenance.md\",\n419:         \"sk-create-skill/references/skill/upgrading-a-skill-to-v4.md\"\n420:     ],\n421: }\n422: ```\n423: \n424: ---\n425: \n426: ## 4. HOW TO READ THIS\n427: \n428: - One dominant intent routes to one mode's leaf set.\n429: - Two near-tied intents (within the ambiguity delta) route to both leaf sets; the\n430:   union is deduped by canonical pair.\n431: - No keyword match is UNKNOWN_FALLBACK: confirm the target artifact and intent\n432:   before loading anything.\n433: - `FULL_INVENTORY` fires only on an explicit \"show the whole toolkit\" request.\n434: - A mode whose `mode-registry.json` row names a `command` has two whole entries: read that command's document in full and follow it under the policy the advisor names, or follow this mode's packet. Pick one and keep to it. A mode whose row has `command: null` has only its packet.\n435: \n436: ---\n437: \n438: ## 5. MACHINE ROUTER\n439: \n440: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 3 stays the only replay source.\n441: \n442: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n443: > ```bash\n444: > node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"\n445: > ```\n446: > Follow the returned decision — `route` (use its `targets`), `clarify`/`defer` (disambiguate), `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-doc`; set `SPECKIT_COMPILED_ROUTING=0` to force legacy routing fleet-wide — the explicit kill-switch.\n447: \n448: ### Surface Router — per-intent leaf sets\n449: \n450: Stage 2 of routing lives in section 3 of this file.\n451: It defines three things:\n452: - The per-intent leaf model: document quality, optimization, skill creation, parent-hub creation, agent creation, command creation, the paired agent-plus-command lane, the human-voice pass, playbooks, playbook conversations, feature catalogs, READMEs, changelogs, benchmarks, diffs, frontmatter, packet goals, repo rules, and the explicit full-toolkit intent.\n453: - The machine-readable `INTENT_SIGNALS` / `RESOURCE_MAP` block that the deterministic router-replay and benchmarks parse.\n454: - The how-to-read rules: a dominant intent gives one leaf set, near-tied intents give a deduped union, and no keyword match gives the hub UNKNOWN fallback, never a silent default.\n455: \n456: Every `RESOURCE_MAP` path is packet-qualified or an authored shared-alias disk path, and each converts to the canonical `(workflowMode, leafResourceId)` pair at the one contract boundary.\n457: \n458: The reason this file stays a separate document from `SKILL.md` and from `hub-router.json` is in [the parent-skill reference](sk-create-skill/references/parent-skill/parent-skills-nested-packets.md#why-the-leaf-router-stays-in-routermd).\n459: \n460: ### The discriminator\n461: - **`workflowMode`** — the public packet key (e.g. `sk-create-skill`, `sk-create-quality-control`). `sk-create-skill-parent` is a second mode over the same `sk-create-skill` packet.\n462: - **`packetKind`** — `workflow` for every sk-doc packet (there is no surface axis; the sk-create-quality-control pipeline is universal doctrine in `shared/`, not orthogonal stack-evidence).\n463: - **`backendKind`** — `template-scaffold` for the create-* generators, `sk-create-quality-control` for the sk-create-quality-control mode.\n464: \n465: ### Routing rule\n466: ```\n467: SKILL_ROOT = path containing this ROUTER.md and its SKILL.md\n468: REGISTRY = SKILL_ROOT / \"mode-registry.json\"\n469: HUB_ROUTER = SKILL_ROOT / \"hub-router.json\"\n470: \n471: UNKNOWN_FALLBACK_CHECKLIST = [\n472:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n473:     \"Confirm the target document or component being authored, scaffolded, or reviewed\",\n474:     \"Provide the available inputs: existing doc, source material, or scaffold parameters\",\n475:     \"Confirm the validation expectations before completion (DQI/HVR scoring, validate.sh, or packet-specific checks)\",\n476: ]\n477: \n478: def _guard_in_skill(relative_path):\n479:   resolved = (SKILL_ROOT / relative_path).resolve()\n480:   resolved.relative_to(SKILL_ROOT)\n481:   if resolved.suffix.lower() not in {\".md\", \".json\"}:\n482:     raise ValueError(\"only skill-local markdown/json router resources are routable\")\n483:   return resolved.relative_to(SKILL_ROOT).as_posix()\n484: \n485: def load_if_available(relative_path, seen):\n486:   guarded = _guard_in_skill(relative_path)\n487:   if guarded not in seen and (SKILL_ROOT / guarded).exists():\n488:     load(guarded)\n489:     seen.add(guarded)\n490:     return True\n491:   return False\n492: \n493: seen = set()\n494: if not REGISTRY.exists() or not HUB_ROUTER.exists():\n495:   return defer(\"router metadata missing; inspect sk-doc/mode-registry.json and sk-doc/hub-router.json\")\n496: \n497: read mode-registry.json and hub-router.json\n498: classify the request to one or more workflowMode values using hub-router.json\n499:   (dominant authoring/quality intent; a command like /create:agent resolves directly)\n500: \n501: if confidence is low, intent is contradictory, or routerPolicy.defaultMode is null and no mode wins:\n502:   for resource in hub_router.routerPolicy.defaultResource:   # the ordered defer set, never hardcoded here\n503:     load_if_available(resource, seen)\n504:   return UNKNOWN_FALLBACK with disambiguation_checklist = UNKNOWN_FALLBACK_CHECKLIST\n505: \n506: for each resolved workflowMode:\n507:   entry = the matching mode-registry.json modes[] item\n508:   if entry is missing or entry.packetKind != \"workflow\":\n509:     return defer(\"unknown sk-doc workflowMode; extend mode-registry.json and create a packet first\")\n510:   if not load_if_available(f\"{entry.packet}/SKILL.md\", seen):\n511:     return defer(\"registered packet SKILL.md is missing; repair the packet before routing\")\n512: \n513: return single or orderedBundle according to hub-router.json routerPolicy.outcomes\n514: ```\n515: `routerPolicy.defaultMode` is `null`: an unclear documentation intent asks for disambiguation rather than forcing a stale default. `hub-router.json` carries the router signals, vocabulary classes, default fallback resource, and bundle rules. Outcomes are `single`, `orderedBundle`, or `defer` — there is no `surfaceBundle` (no surface axis).\n516: \n517: Per-packet behavior is **not flattened**: each packet keeps its own authoring contract, references, assets, scripts, and templates.\n518: \n519: This hub does **not** use keyed resource discovery (`references/<key>/` or `assets/<key>/`) at the hub root.\n520: There are no hub-root `references/` or `assets/` directories, and packet resources stay inside their owning packet or the shared backbone.\n521: If a future workflow needs keyed resource subdirectories, add that behavior inside the owning packet using guarded runtime discovery.\n522: Do not hardcode resource inventories in this hub."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/ROUTER.md\"}"},"time":{"start":1794582795507,"end":1794582797612}}}}
{"type":"tool_use","timestamp":1794582797619,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d578576a001WTOwF9MTHFdsZu","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578445e001E8nsbhhL1Wr8sP","type":"tool","id":"chatcmpl-tool-8cc86ef61a9290a2","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md, lines 1-583\n1: ---\n2: title: sk-code Surface Router — routing logic and resource maps\n3: description: First-class surface router document at the sk-code hub root (ROUTER.md). hub-router.json selects the workflow mode; this doc maps a request's code intent to the exact packet-local leaf resources that mode should load, emitting canonical (workflowMode, leafResourceId) pairs. Relocated from shared/references/smart-routing.md (v3.5.0.8) as the ROUTER.md consolidation pattern, with the approved sk-code shared-control delta (router self-reference removed, ten hub-shared paths normalized to shared/..., mapped shared controls declared).\n4: trigger_phrases:\n5:   - \"sk-code smart routing\"\n6:   - \"surface resource maps\"\n7:   - \"intent classification routing\"\n8:   - \"load tier resource loading\"\n9:   - \"unknown surface fallback\"\n10: importance_tier: important\n11: contextType: general\n12: version: 2.3.19.0\n13: router_state: active\n14: skill_pointer: SKILL.md\n15: ---\n16: # sk-code Surface Router — routing logic and resource maps\n17: \n18: Leaf-set authority for sk-code. The routing authority is named once in `SKILL.md` §2 SMART ROUTING: `hub-router.json` is the mode vocabulary, and this document is the leaf-set router. Consolidates intent classification + resource loading into the single Barter-style smart-routing entry point. Detection logic lives in [`stack-detection.md`](shared/references/stack-detection.md); phase lifecycle lives in [`phase-detection.md`](shared/references/phase-detection.md).\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: ### Purpose\n25: \n26: The smart router maps a detected surface (a declared specific surface, then the SKILLED fallback, then UNKNOWN) plus a classified intent (IMPLEMENTATION / DEBUGGING / VERIFICATION / etc.) to the exact references, assets, and verification commands needed for the active task. Loads only the smallest relevant set so the active context window stays focused.\n27: \n28: ### When to Use\n29: \n30: - After surface detection (see [`stack-detection.md`](shared/references/stack-detection.md)) determines the surface: a declared specific surface, then the SKILLED fallback, then UNKNOWN\n31: - When classifying task wording into the dominant work intent\n32: - When mapping intent to concrete reference paths\n33: - When picking verification commands for the surface\n34: \n35: ### Core Principle\n36: \n37: Routing is a two-stage decision: **surface-first, intent-second**. Surface narrows the resource family: a declared specific surface first, then the SKILLED fallback, then UNKNOWN. Intent narrows the specific files within that family. The detected surface also goes to the compiled front door as `--surface-hint`. When a prompt ties between surfaces, a hinted specific surface leads the bundle. SKILLED already ranks last, so a SKILLED hint changes nothing (`SKILL.md` §3).\n38: \n39: ### Key Sources\n40: \n41: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) and SKILLED language sub-detection\n42: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and phase-specific resource expectations\n43: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n44: \n45: ---\n46: \n47: ## 2. INTENT MODEL\n48: \n49: Intent classification scores task text against weighted keyword signals to pick the dominant work type after surface detection. The vocabulary and weights are authored once, in the `INTENT_SIGNALS` block of §8 MACHINE-READABLE ROUTER; read them there. This section is the human-facing summary of how that block is scored, never a second copy of its keywords.\n50: \n51: ### Scoring algorithm\n52: \n53: 1. Sum weighted keyword hits from the request, target files, and known task context.\n54: 2. Boost explicit phase signals (verification, debugging, code quality) by +5 when the phase is unambiguous.\n55: 3. Select the top intent.\n56: 4. Select a second intent when the score delta to the next intent is small (`AMBIGUITY_DELTA = 1`).\n57: 5. For SKILLED surface, run language sub-detection after intent selection.\n58: \n59: ### Doc-only edit anti-signals\n60: \n61: Doc-only prose changes subtract from `sk-code` intent scoring and add to `sk-doc` scoring, even when the target file is under `.skilled/skills/`.\n62: \n63: | Prompt signal | Effect |\n64: | --- | --- |\n65: | `update headline`, `rewrite headline`, `headline section` | `sk-code -2`, `sk-doc +3` |\n66: | `clarify description`, `clarify the X model`, `documentation section` | `sk-code -2`, `sk-doc +3` |\n67: | `add a one-line summary`, `add summary at the top` | `sk-code -2`, `sk-doc +3` |\n68: | `improve readme`, `reorganize readme`, `rewrite section` | `sk-code -2`, `sk-doc +3` |\n69: | `SKILL.md` or `README.md` plus prose-only verbs | `sk-code -2`, `sk-doc +3` |\n70: \n71: Do not apply this anti-signal when the same request asks to modify executable code, parser logic, tests, shell behavior, TypeScript/Python entrypoints, JSON schema behavior, or routing algorithms. In that case, keep SKILLED surface detection and load `sk-code`.\n72: \n73: Multi-symptom prompts like `debug the broken jsonc descriptor` should load both DEBUGGING and CONFIG. Prompts like `update TypeScript advisor fixture` should load SKILLED plus TYPESCRIPT and CODE_QUALITY.\n74: \n75: ### Surface-specific intent notes\n76: \n77: - **SKILLED** intent scoring favors language standards, hooks, config, scripts, advisor/tests, metadata, and alignment verification.\n78: - Unsupported surfaces stay UNKNOWN even if intent scoring is strong.\n79: \n80: ---\n81: \n82: ## 3. LOAD TIERS\n83: \n84: | Tier | When | Resources |\n85: | --- | --- | --- |\n86: | ALWAYS | Every invocation | The §8 `DEFAULT_RESOURCE` preamble only: `shared/references/stack-detection.md`, `shared/references/phase-detection.md` and `shared/references/universal/code-quality-standards.md`. The style guide `sk-code-quality/references/code-style-guide.md` loads with CODE_QUALITY, and the shared doctrine loads with its intent: `workflow-debug.md` with DEBUGGING and `workflow-verify.md` with VERIFICATION |\n87: | SURFACE | After SKILLED detection | Surface-specific resources (`sk-code-skilled/references/shared/*`) |\n88: | INTENT | After intent classification | Implementation, debugging, verification, testing, etc. matching the top-1 intent (and top-2 when ambiguous) |\n89: | LANGUAGE | SKILLED only | Split JavaScript, TypeScript, Python, Shell, Rust, and Config standards from the matching `sk-code-skilled/references/<lang>/` resources |\n90: | ON_DEMAND | Explicit deep-dive keywords | Extended checklists and niche references (e.g. `sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md` for boundary templates) |\n91: \n92: ---\n93: \n94: ## 4. SKILLED MAP\n95: \n96: SKILLED loads from `sk-code-skilled/references/` and `sk-code-skilled/assets/`.\n97: \n98: ### Implementation shared tier\n99: \n100: IMPLEMENTATION loads the shared organization and naming baseline:\n101: \n102: - `sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md`\n103: - `sk-code-skilled/references/shared/code-organization/overview-and-module-organization.md`\n104: \n105: ### Intent overlay\n106: \n107: | Intent | Resources |\n108: | --- | --- |\n109: | CODE_QUALITY | SKILLED only: `sk-code-skilled/assets/checklists/universal-checklist.md` plus the language-matching checklist, both when SKILLED is a resolved surface. A foreign surface loads the floor in `code-quality-standards.md` and its own declared rows |\n110: | VERIFICATION | `sk-code-skilled/references/shared/alignment-verification-automation.md`, `sk-code-skilled/assets/scripts/verify_alignment_drift.py` |\n111: | HOOKS | `sk-code-skilled/references/shared/hooks.md` |\n112: | CONFIG | `sk-code-skilled/references/config/*` |\n113: | LANGUAGE_STANDARDS | Detected language folder's `quick-reference.md`, `style-guide.md`, `quality-standards.md` |\n114: \n115: ### Language overlay\n116: \n117: | Language | Resources |\n118: | --- | --- |\n119: | JAVASCRIPT | `sk-code-skilled/references/javascript/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/javascript-checklist.md` |\n120: | TYPESCRIPT | `sk-code-skilled/references/typescript/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/typescript-checklist.md` |\n121: | PYTHON | `sk-code-skilled/references/python/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/python-checklist.md` |\n122: | SHELL | `sk-code-skilled/references/shell/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/shell-checklist.md` |\n123: | RUST | `sk-code-skilled/references/rust/{style_guide,quality_standards,quick_reference}/` (each split into topic parts), `sk-code-skilled/assets/checklists/rust-checklist/` |\n124: | CONFIG | `sk-code-skilled/references/config/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/config-checklist.md` |\n125: \n126: ### Authoring checklist gating\n127: \n128: When SKILLED intent is `authoring-new-X`, additionally load the matching authoring checklist:\n129: \n130: | Authoring target | Checklist |\n131: | --- | --- |\n132: | New skill | `sk-code-skilled/assets/checklists/skill-authoring.md` |\n133: | New agent | `sk-code-skilled/assets/checklists/agent-authoring.md` |\n134: | New command | `sk-code-skilled/assets/checklists/command-authoring.md` |\n135: | New MCP server | `sk-code-skilled/assets/checklists/mcp-server-authoring.md` |\n136: | Spec folder write | Now in system-spec-kit: `system-spec-kit/references/workflows/spec-folder-authoring-checklist.md` + `system-spec-kit/references/workflows/spec-folder-write-recipe.md` |\n137: \n138: ### CI Workflow Map\n139: \n140: When the request names a GitHub Actions workflow, the hub bundles `sk-code-ci` from the request vocabulary and the `CI_WORKFLOW` intent loads its four rule references:\n141: \n142: | Resource | Carries |\n143: | --- | --- |\n144: | `sk-code-ci/references/ci-workflow-standards.md` | The rule index: path parity, SHA pins, README row, `set -euo pipefail`, fork and secret safety, matrix and `fail-fast` |\n145: | `sk-code-ci/references/trigger-and-filter-rules.md` | The twin rule, the rebuild-commit skip rule, push-only scope and the intentional exceptions table |\n146: | `sk-code-ci/references/job-shape-rules.md` | Timeouts, permissions, the concurrency template, the composite setup action and the switch `if:` shape |\n147: | `sk-code-ci/references/protected-set.md` | The repository CI profile and its keys, the workflows protected by function and the rules that follow |\n148: \n149: The map is the packet's own `RESOURCE_MAP` re-prefixed with `sk-code-ci/`, so the two stay equal.\n150: \n151: ### Frontend Map\n152: \n153: When a request asks about web frontend practice, or a Figma-to-code check, the hub bundles `sk-code-frontend` from request vocabulary alone:\n154: \n155: | Resource | Carries |\n156: | --- | --- |\n157: | `sk-code-frontend/references/frontend-practice.md` | The cross-stack core, token precedence, Figma boundary, and Frontend overrides contract |\n158: | `sk-code-frontend/references/web-markup-and-css.md` | The web stack layer for markup, forms, layout, responsive behavior, media, and CSS architecture |\n159: | `sk-code-frontend/references/web-elements-and-attributes.md` | Form autocomplete, dialog, and popover behavior |\n160: | `sk-code-frontend/references/web-cascade-and-selectors.md` | Cascade layers and specificity conflicts |\n161: | `sk-code-frontend/references/web-layout-and-sizing.md` | Container queries and stacking contexts |\n162: | `sk-code-frontend/references/web-accessibility-patterns.md` | Accessibility patterns, visible focus, and live regions |\n163: | `sk-code-frontend/references/web-performance-and-loading.md` | Web font loading and largest contentful paint |\n164: | `sk-code-frontend/references/web-internationalization.md` | Right-to-left layout and bidirectional text |\n165: | `sk-code-frontend/references/web-visual-values.md` | Visual value decisions: spacing, type, weight, colour, shadow, radius, opacity, palettes and token sets |\n166: | `sk-code-frontend/references/web-visual-hierarchy.md` | Visual hierarchy and review: build procedure, symptom-to-fix tables, UX laws and the review pass |\n167: | `sk-code-frontend/references/web-motion-and-interaction.md` | Motion and interaction: animation, input, touch, focus, performance and feedback rules |\n168: | `sk-code-frontend/references/figma-to-code.md` | The five-pass check for comparing a built screen with its Figma frame |\n169: \n170: The map is the packet's own `RESOURCE_MAP` for the web, visual and Figma-to-code intents, re-prefixed with `sk-code-frontend/`, so the two stay equal there.\n171: \n172: ---\n173: \n174: ## 5. VERIFICATION COMMANDS\n175: \n176: | Surface | Required verification evidence |\n177: | --- | --- |\n178: | SKILLED | `python3 .skilled/skills/sk-code/sk-code-skilled/assets/scripts/verify_alignment_drift.py --root <changed-scope>`; plus targeted language/project tests such as vitest, pytest, shellcheck, JSON validation, or spec validation for changed spec folders |\n179: | UNKNOWN | User-selected verification command set before completion claim |\n180: \n181: ---\n182: \n183: ## 6. UNKNOWN FALLBACK\n184: \n185: If no supported surface matches, ask:\n186: \n187: 1. Is this `.skilled/` system code, or an unsupported stack?\n188: 2. Which files or directories are changing?\n189: 3. Which verification command proves the claim?\n190: 4. Should a new `sk-code` route be planned before implementation?\n191: \n192: Canonical sk-code owns the SKILLED surface, the `sk-code-ci` GitHub Actions surface and the stack-agnostic `sk-code-frontend` surface for web practice. Go, Next.js server code and React Native surfaces live in a project fork.\n193: \n194: ### UNKNOWN fallback checklist\n195: \n196: Returned when intent confidence is low (`max(intent_scores) < 0.5`) OR when the user explicitly asks for stack-agnostic guidance:\n197: \n198: - Confirm the detected surface (a declared specific surface, the SKILLED fallback or UNKNOWN)\n199: - Confirm the task intent (implementation / debugging / verification / etc.)\n200: - Provide one concrete input, error, or expected output\n201: - Confirm the verification command set before completion\n202: \n203: ---\n204: \n205: ## 7. LOADING DISCIPLINE (DO / DON'T)\n206: \n207: ### DO\n208: \n209: - Load only references needed for current intent + surface\n210: - Use exact canonical file paths in playbook result YAML (never directory placeholders)\n211: - Cite surface + top-1 intent + loaded resource paths + verification command in your final answer\n212: \n213: ### DON'T\n214: \n215: - Load all of `sk-code-skilled/` indiscriminately (\"just in case\")\n216: - Load Go, Next.js server code or React Native resources from canonical sk-code; those live in a project fork\n217: - Drop directory placeholders in playbook result YAML\n218: \n219: ---\n220: \n221: ## 8. MACHINE-READABLE ROUTER (replay / benchmark source)\n222: \n223: This block is the authored source for the intent vocabulary and weights. §2 explains how it is scored and does not repeat the keywords; §4 renders the same rows as prose. When an intent row changes here, update the matching prose row in §4.\n224: \n225: This projection is intentionally lossy in two documented ways the flat dictionary cannot express, both enforced by the prose contract and the surface-detection pseudocode in this file's §11:\n226: \n227: - **No phase boosts.** The `+5` unambiguous-phase boost from the §2 scoring algorithm is not represented; every keyword carries unit weight here.\n228: - **No doc-only anti-signals.** The `sk-code -2 / sk-doc +3` anti-signals (§2) that route prose-only edits away from this skill are a pre-filter the flat model does not carry.\n229: \n230: ```python\n231: # Always-loaded routing preamble: every code task detects stack, detects phase,\n232: # consults the router, and applies the universal quality baseline before any\n233: # surface-specific resource. These are loaded on every route.\n234: DEFAULT_RESOURCE = [\n235:     \"shared/references/stack-detection.md\",\n236:     \"shared/references/phase-detection.md\",\n237:     \"shared/references/universal/code-quality-standards.md\",\n238: ]\n239: \n240: INTENT_SIGNALS = {\n241:     \"IMPLEMENTATION\":     {\"weight\": 1, \"keywords\": [\"implement\", \"build\", \"create\", \"feature\", \"component\", \"module\", \"authoring\"]},\n242:     \"CODE_QUALITY\":       {\"weight\": 1, \"keywords\": [\"lint\", \"format\", \"quality gate\", \"naming\", \"standards\", \"code smell\", \"comment hygiene\", \"restraint\", \"yagni\", \"simplify\", \"over-engineering\", \"bloat\", \"skipped_untrusted\", \"untrusted repository check\", \"trustrepochecks\", \"quality config\", \"repository/quality.json\", \"configured check\", \"unverified\"]},\n243:     \"DEBUGGING\":          {\"weight\": 1, \"keywords\": [\"debug\", \"broken\", \"failing\", \"stack trace\", \"console error\", \"regression\"]},\n244:     \"VERIFICATION\":       {\"weight\": 1, \"keywords\": [\"verify\", \"passing\", \"type-check\", \"alignment drift\", \"completion claim\"]},\n245:     \"HOOKS\":              {\"weight\": 1, \"keywords\": [\"session-prime\", \"user-prompt-submit\", \"pre-tool-use\", \"post-tool-use\"]},\n246:     \"CONFIG\":             {\"weight\": 1, \"keywords\": [\"jsonc\", \".json\", \".jsonc\", \"descriptor\", \"config schema\"]},\n247:     \"JAVASCRIPT\":         {\"weight\": 1, \"keywords\": [\"javascript\", \"vanilla js\", \".js\", \"commonjs\", \".cjs\", \".mjs\"]},\n248:     \"TYPESCRIPT\":         {\"weight\": 1, \"keywords\": [\"typescript\", \".ts\", \".tsx\"]},\n249:     \"PYTHON\":             {\"weight\": 1, \"keywords\": [\"python\", \".py\", \"docstring\"]},\n250:     \"SHELL\":              {\"weight\": 1, \"keywords\": [\"shell script\", \"bash\", \".sh\"]},\n251:     \"RUST\":               {\"weight\": 1, \"keywords\": [\"rust\", \".rs\", \"cargo.toml\", \"cargo.lock\", \"napi-rs\", \"napi_rs\", \"#[napi]\", \"wasm-bindgen\", \"wasm_bindgen\", \"#[wasm_bindgen]\", \"wasi\", \"cdylib\"]},\n252:     \"CI_WORKFLOW\":        {\"weight\": 4, \"keywords\": [\"github actions workflow\", \"ci workflow\", \"github actions yaml\", \"workflow path filters\", \"github workflow timeout\", \"github workflow concurrency\", \"github workflow permissions\", \"required status check workflow\", \"ci job\", \"action to a sha\", \"sha-pinned action\", \"github actions permissions\", \"ci workflows\", \"ci switch\", \"turn off ci\", \".github/workflows\", \"workflow concurrency\", \"github actions release workflow\", \"github actions deploy workflow\", \"release workflow yaml\", \"deploy workflow yaml\", \"github actions minutes\", \"actions minutes\", \"actions runner minutes\", \"runner minutes\", \"ci workflow cost\", \"ci cost\", \"reduce ci costs\", \"lower ci costs\", \"cut ci costs\", \"reduce our ci costs\", \"lower our ci costs\", \"ci spend\", \"ci bill\", \"ci minutes cost\", \"cut the ci minutes\", \"cut ci minutes\", \"reduce ci minutes\", \"ci pipeline cost\", \"ci pipeline cheaper\", \"ci pipelines cheaper\", \"cheaper ci pipeline\", \"ci runs cheaper\", \"failing ci\", \"failing ci pipeline\", \"ci failure\", \"ci failures\", \"ci is failing\", \"broken ci\", \"debug the ci\", \"debug ci\", \"cost of our ci\", \"make ci cheaper\", \"github actions bill\", \"github actions cost\", \"turn off the ci\", \"turn on the ci\", \"ci review workflow\"]},\n253:     \"FRONTEND_WEB\":        {\"weight\": 4, \"keywords\": [\"semantic html markup\"]},\n254:     \"WEB_ELEMENTS\":        {\"weight\": 4, \"keywords\": [\"html form autocomplete\", \"dialog element\", \"popover attribute\"]},\n255:     \"WEB_CASCADE\":         {\"weight\": 4, \"keywords\": [\"css cascade layers\", \"css specificity conflict\"]},\n256:     \"WEB_LAYOUT\":          {\"weight\": 4, \"keywords\": [\"container query layout\", \"css stacking context\"]},\n257:     \"WEB_A11Y\":            {\"weight\": 4, \"keywords\": [\"web accessibility pattern\", \"focus visible styling\", \"keyboard focus\", \"broken tab order\", \"accessible name\", \"aria live region\", \"focus ring accessibility\", \"focus outline removed\", \"screen reader support\", \"aria label missing\", \"alt text missing\", \"wcag audit\"]},\n258:     \"WEB_PERF\":            {\"weight\": 4, \"keywords\": [\"web font loading\", \"largest contentful paint\"]},\n259:     \"WEB_I18N\":            {\"weight\": 4, \"keywords\": [\"right to left layout\", \"bidirectional text\"]},\n260:     \"WEB_VISUAL_VALUES\": {\"weight\": 4, \"keywords\": [\"what padding should this have\", \"how much padding\", \"what font size should this be\", \"spacing between elements\", \"spacing scale\", \"type scale\", \"build a color palette\", \"shade ramp\", \"box shadow elevation\", \"border radius consistency\", \"contrast ratio failure\", \"grey text on colored background\", \"dark mode palette\", \"concentric border radius\", \"layered shadows\", \"shadow color on dark surface\", \"tabular numbers\", \"what should this button look like\", \"colour decision\", \"color decision\", \"padding\", \"type scale for\", \"font size\", \"colour palette\", \"color palette\", \"contrast ratio\", \"corner radius\", \"box shadow\", \"spacing between\", \"contrast of\", \"check the contrast\", \"colour contrast\", \"color contrast\", \"muted text\"]},\n261:     \"WEB_VISUAL_HIERARCHY\": {\"weight\": 4, \"keywords\": [\"ui looks off\", \"looks amateur\", \"feels cluttered\", \"make this look better\", \"make this ui look designed\", \"visual hierarchy\", \"no visual hierarchy\", \"nothing draws the eye\", \"everything competes for attention\", \"everything looks the same\", \"emphasize by de-emphasizing\", \"how to style a destructive button\", \"this page feels overwhelming\", \"where do i start designing\", \"design a new screen from scratch\", \"how much white space\", \"why does this look wrong\", \"does this look right\", \"critique this design\", \"design critique\", \"visual audit\", \"design review findings\", \"design review\", \"review this design\", \"review this screen\", \"ux laws\", \"cognitive load\", \"progressive disclosure\", \"empty state design\", \"look wrong\", \"looks wrong\", \"looks off\", \"visual review\", \"type hierarchy\"]},\n262:     \"WEB_MOTION\":        {\"weight\": 4, \"keywords\": [\"animation duration\", \"transition duration\", \"easing curve\", \"spring versus easing\", \"twelve principles of animation\", \"when not to animate\", \"response time budget\", \"touch target size\", \"hover state\", \"active pressed state\", \"disabled state styling\", \"button states\", \"animation\", \"transition timing\", \"easing\", \"hover\", \"focus-visible\", \"interaction states\"]},\n263:     \"FIGMA_TO_CODE\":      {\"weight\": 4, \"keywords\": [\"figma to code\", \"check built screen against figma\", \"compare build with figma frame\", \"figma frame\", \"figma frame check\", \"implement a figma design\"]},\n264: }\n265: \n266: RESOURCE_MAP = {\n267:     \"IMPLEMENTATION\": [\n268:         \"sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md\",\n269:         \"sk-code-skilled/references/shared/universal-patterns/organization-security-and-examples.md\",\n270:         \"sk-code-skilled/references/shared/code-organization/overview-and-module-organization.md\",\n271:         \"sk-code-skilled/references/shared/code-organization/imports-and-exports.md\",\n272:         \"sk-code-skilled/references/shared/code-organization/directory-and-test-conventions.md\",\n273:         \"sk-code-skilled/assets/checklists/agent-authoring.md\",\n274:         \"sk-code-skilled/assets/checklists/command-authoring.md\",\n275:         \"sk-code-skilled/assets/checklists/skill-authoring.md\",\n276:         \"sk-code-skilled/assets/checklists/mcp-server-authoring.md\",\n277: \n278:     ],\n279:     \"CODE_QUALITY\": [\n280:         \"shared/references/universal/code-quality-standards.md\",\n281:         \"shared/references/universal/rule-overrides.md\",\n282:         \"sk-code-quality/references/code-style-guide.md\",\n283:         \"sk-code-quality/references/runner-contract.md\",\n284:         \"sk-code-skilled/assets/checklists/universal-checklist.md\",  # SKILLED only: the house checklist loads when SKILLED resolves, never for a foreign surface\n285:         \"sk-code-skilled/assets/checklists/javascript-checklist.md\",\n286:         \"sk-code-skilled/assets/checklists/js-css-style/overview-header-and-comments.md\",\n287:         \"sk-code-skilled/assets/checklists/js-css-style/naming-init-formatting-and-css.md\",\n288:         \"sk-code-skilled/assets/checklists/js-css-style/verification-quick-reference-and-related.md\",\n289:         \"sk-code-skilled/assets/checklists/typescript-checklist.md\",\n290:         \"sk-code-skilled/assets/checklists/python-checklist.md\",\n291:         \"sk-code-skilled/assets/checklists/shell-checklist.md\",\n292:         \"sk-code-skilled/assets/checklists/rust-checklist/overview-and-p0-parity.md\",\n293:         \"sk-code-skilled/assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md\",\n294:         \"sk-code-skilled/assets/checklists/rust-checklist/p1-required.md\",\n295:         \"sk-code-skilled/assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md\",\n296:         \"sk-code-review/assets/code-quality-checklist.md\",\n297: \n298:     ],\n299:     \"DEBUGGING\": [\n300:         \"shared/references/workflow-debug.md\",\n301: \n302:     ],\n303:     \"VERIFICATION\": [\n304:         \"sk-code-skilled/references/shared/alignment-verification-automation.md\",\n305:         \"shared/references/workflow-verify.md\",\n306:         \"sk-code-skilled/assets/scripts/README.md\",\n307: \n308:     ],\n309:     \"HOOKS\": [\n310:         \"sk-code-skilled/references/shared/hooks.md\",\n311:     ],\n312:     \"CONFIG\": [\n313:         \"sk-code-skilled/references/config/style-guide.md\",\n314:         \"sk-code-skilled/references/config/quality-standards.md\",\n315:         \"sk-code-skilled/references/config/quick-reference.md\",\n316:         \"sk-code-skilled/assets/checklists/config-checklist.md\",\n317:     ],\n318:     \"JAVASCRIPT\": [\n319:         \"sk-code-skilled/references/javascript/style-guide.md\",\n320:         \"sk-code-skilled/references/javascript/quality-standards/overview-modules-and-docs.md\",\n321:         \"sk-code-skilled/references/javascript/quality-standards/security-testing-and-exemptions.md\",\n322:         \"sk-code-skilled/references/javascript/quick-reference.md\",\n323:     ],\n324:     \"TYPESCRIPT\": [\n325:         \"sk-code-skilled/references/typescript/style-guide/overview-strict-and-naming.md\",\n326:         \"sk-code-skilled/references/typescript/style-guide/formatting-imports-and-coexistence.md\",\n327:         \"sk-code-skilled/references/typescript/quality-standards/overview-and-type-system.md\",\n328:         \"sk-code-skilled/references/typescript/quality-standards/tsdoc-errors-and-async.md\",\n329:         \"sk-code-skilled/references/typescript/quality-standards/tsconfig-and-modules.md\",\n330:         \"sk-code-skilled/references/typescript/quick-reference/template-naming-and-types.md\",\n331:         \"sk-code-skilled/references/typescript/quick-reference/imports-errors-and-tsconfig.md\",\n332:     ],\n333:     \"PYTHON\": [\n334:         \"sk-code-skilled/references/python/style-guide.md\",\n335:         \"sk-code-skilled/references/python/quality-standards.md\",\n336:         \"sk-code-skilled/references/python/quick-reference.md\",\n337:     ],\n338:     \"SHELL\": [\n339:         \"sk-code-skilled/references/shell/style-guide/overview-structure-and-naming.md\",\n340:         \"sk-code-skilled/references/shell/style-guide/variables-functions-and-output.md\",\n341:         \"sk-code-skilled/references/shell/quality-standards/overview-and-priority-blockers.md\",\n342:         \"sk-code-skilled/references/shell/quality-standards/validation-security-and-shellcheck.md\",\n343:         \"sk-code-skilled/references/shell/quick-reference/template-variables-and-loops.md\",\n344:         \"sk-code-skilled/references/shell/quick-reference/functions-strings-and-checklist.md\",\n345:     ],\n346:     \"RUST\": [\n347:         \"sk-code-skilled/references/rust/style-guide/overview-and-file-header.md\",\n348:         \"sk-code-skilled/references/rust/style-guide/toolchain-and-project-structure.md\",\n349:         \"sk-code-skilled/references/rust/style-guide/naming-conventions.md\",\n350:         \"sk-code-skilled/references/rust/style-guide/formatting-and-imports.md\",\n351:         \"sk-code-skilled/references/rust/style-guide/commenting-and-rustdoc.md\",\n352:         \"sk-code-skilled/references/rust/style-guide/interop-model.md\",\n353:         \"sk-code-skilled/references/rust/style-guide/interop-errors-and-parity.md\",\n354:         \"sk-code-skilled/references/rust/quality-standards/overview-and-data-ownership.md\",\n355:         \"sk-code-skilled/references/rust/quality-standards/modeling-collections-and-api.md\",\n356:         \"sk-code-skilled/references/rust/quality-standards/docs-errors-and-async.md\",\n357:         \"sk-code-skilled/references/rust/quality-standards/build-and-organization.md\",\n358:         \"sk-code-skilled/references/rust/quality-standards/determinism-and-parity.md\",\n359:         \"sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md\",\n360:         \"sk-code-skilled/references/rust/quick-reference/naming-ordering-and-signatures.md\",\n361:         \"sk-code-skilled/references/rust/quick-reference/collections-imports-and-errors.md\",\n362:         \"sk-code-skilled/references/rust/quick-reference/rustdoc-and-cargo.md\",\n363:         \"sk-code-skilled/references/rust/quick-reference/determinism-parity-and-related.md\",\n364:     ],\n365:     \"CI_WORKFLOW\": [\n366:         \"sk-code-ci/references/ci-workflow-standards.md\",\n367:         \"sk-code-ci/references/trigger-and-filter-rules.md\",\n368:         \"sk-code-ci/references/job-shape-rules.md\",\n369:         \"sk-code-ci/references/protected-set.md\",\n370:     ],\n371:     \"FRONTEND_WEB\": [\n372:         \"sk-code-frontend/references/frontend-practice.md\",\n373:         \"sk-code-frontend/references/web-markup-and-css.md\",\n374:     ],\n375:     \"WEB_ELEMENTS\": [\n376:         \"sk-code-frontend/references/frontend-practice.md\",\n377:         \"sk-code-frontend/references/web-markup-and-css.md\",\n378:         \"sk-code-frontend/references/web-elements-and-attributes.md\",\n379:     ],\n380:     \"WEB_CASCADE\": [\n381:         \"sk-code-frontend/references/frontend-practice.md\",\n382:         \"sk-code-frontend/references/web-markup-and-css.md\",\n383:         \"sk-code-frontend/references/web-cascade-and-selectors.md\",\n384:     ],\n385:     \"WEB_LAYOUT\": [\n386:         \"sk-code-frontend/references/frontend-practice.md\",\n387:         \"sk-code-frontend/references/web-markup-and-css.md\",\n388:         \"sk-code-frontend/references/web-layout-and-sizing.md\",\n389:     ],\n390:     \"WEB_A11Y\": [\n391:         \"sk-code-frontend/references/frontend-practice.md\",\n392:         \"sk-code-frontend/references/web-markup-and-css.md\",\n393:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n394:     ],\n395:     \"WEB_PERF\": [\n396:         \"sk-code-frontend/references/frontend-practice.md\",\n397:         \"sk-code-frontend/references/web-markup-and-css.md\",\n398:         \"sk-code-frontend/references/web-performance-and-loading.md\",\n399:     ],\n400:     \"WEB_I18N\": [\n401:         \"sk-code-frontend/references/frontend-practice.md\",\n402:         \"sk-code-frontend/references/web-markup-and-css.md\",\n403:         \"sk-code-frontend/references/web-internationalization.md\",\n404:     ],\n405:     \"WEB_VISUAL_VALUES\": [\n406:         \"sk-code-frontend/references/frontend-practice.md\",\n407:         \"sk-code-frontend/references/web-visual-values.md\",\n408:     ],\n409:     \"WEB_VISUAL_HIERARCHY\": [\n410:         \"sk-code-frontend/references/frontend-practice.md\",\n411:         \"sk-code-frontend/references/web-visual-hierarchy.md\",\n412:         \"sk-code-frontend/references/web-visual-values.md\",\n413:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n414:     ],\n415:     \"WEB_MOTION\": [\n416:         \"sk-code-frontend/references/frontend-practice.md\",\n417:         \"sk-code-frontend/references/web-motion-and-interaction.md\",\n418:     ],\n419:     \"FIGMA_TO_CODE\": [\n420:         \"sk-code-frontend/references/figma-to-code.md\",\n421:         \"sk-code-frontend/references/frontend-practice.md\",\n422:     ],\n423: }\n424: \n425: # Hub-level shared controls, declared once here. This list holds every\n426: # contained shared/ path that RESOURCE_MAP references but that is exempt from\n427: # typed-leaf projection, because it has no single packet owner. The root-router\n428: # contract validates each entry and requires RESOURCE_MAP to reference it.\n429: # DEFAULT_RESOURCE above is the other half of the set: its always-loaded\n430: # preamble paths are hub-level controls too. No other shared/ path is a\n431: # control, so a guard that needs the control set reads these two lists.\n432: SHARED_CONTROL_RESOURCES = [\n433:     \"shared/references/universal/code-quality-standards.md\",\n434:     \"shared/references/universal/rule-overrides.md\",\n435:     \"shared/references/workflow-debug.md\",\n436:     \"shared/references/workflow-verify.md\",\n437: ]\n438: ```\n439: \n440: ### Surface-aware loading (route-time)\n441: \n442: The router does NOT load the whole matched-intent union. After surface detection (§1, `stack-detection.md`), a route loads:\n443: \n444: - the always-loaded `DEFAULT_RESOURCE` preamble (stack/phase detection and the universal quality baseline), plus\n445: - the `shared/` entries the matched intents map (for example `code-quality-standards.md` under CODE_QUALITY, `workflow-debug.md` under DEBUGGING and `workflow-verify.md` under VERIFICATION), never the whole `shared/references/universal/` folder, plus\n446: - only the **detected surface's** slice (`<surface>/references/*`) for the matched intents.\n447: \n448: - It does not load another surface's resources.\n449: - It defers `assets/*` (checklists, recipes, templates) to on-demand rather than the first slice.\n450: - Within SKILLED it slices once more by the **detected language** (§1 sub-detection): a TypeScript task loads `sk-code-skilled/references/typescript/*` plus the language-agnostic `sk-code-skilled/references/shared/*`, not the Python, shell, config, or JavaScript folders.\n451: - An `UNKNOWN` surface falls back to the preamble plus the shared-tier entries its matched intents map.\n452: \n453: This is what stops a routine single-surface task from pulling the full cross-surface set. The deterministic router-replay enforces the same rule, so the benchmark measures it.\n454: \n455: ---\n456: \n457: ## 9. HOW TO READ THIS\n458: \n459: - Every code task first loads the always-on preamble (stack + phase detection and the universal quality baseline); routing then narrows to the detected surface's slice for the matched intents.\n460: - One dominant intent on one surface loads that surface's slice; two near-tied intents (within the router's ambiguity delta) load both intent sets, deduped by canonical pair.\n461: - A single-surface task never pulls another surface's resources.\n462: - No keyword match, or an `UNKNOWN` surface, falls back to the preamble plus the shared-tier entries its matched intents map — confirm the surface and intent before loading more. See §6 (UNKNOWN FALLBACK) and §7 (LOADING DISCIPLINE) for the full rules.\n463: \n464: ---\n465: \n466: ## 10. RELATED RESOURCES\n467: \n468: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) + SKILLED language sub-detection\n469: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and per-phase resource loading\n470: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n471: - Barter equivalent: `barter/.skilled/skills/sk-code/shared/references/smart-routing.md` (different routing key — git-remote project — but same structural pattern)\n472: \n473: ---\n474: \n475: ## 11. MACHINE ROUTER\n476: \n477: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 8 stays the only replay source.\n478: \n479: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n480: > ```bash\n481: > node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"\n482: > ```\n483: > Follow the returned decision: `route` (use its `targets`), `clarify`/`defer` (disambiguate) or `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-code`. Set `SPECKIT_COMPILED_ROUTING=0`, the explicit kill-switch, to force legacy routing fleet-wide.\n484: \n485: **Session surface hint.** Before you call the front door, run the surface detection in [`stack-detection.md`](shared/references/stack-detection.md) on the session's working directory and the files it is editing.\n486: Then add its result as `--surface-hint <SURFACE>`, for example `--surface-hint SKILLED`.\n487: When the prompt's keywords tie between surfaces, a hinted specific surface leads them.\n488: Workflow modes keep first place, and the targets and the bundle kind stay the same.\n489: `SKILLED` is the fallback surface and always ranks last, so a `SKILLED` hint changes nothing.\n490: With `UNKNOWN`, no hint or a surface the prompt did not match, the `routerPolicy.tieBreak` order applies.\n491: \n492: ### Surface Router: per-intent leaf sets\n493: \n494: Root `ROUTER.md` owns the second-stage `INTENT_SIGNALS` / `RESOURCE_MAP`, while packet-owned resources stay typed through `leaf-manifest.json`.\n495: The hub-level shared controls are declared once, in `ROUTER.md` §8: the `SHARED_CONTROL_RESOURCES` list plus the always-loaded `DEFAULT_RESOURCE` preamble. They resolve on disk but never project as leaves.\n496: The hub router keeps stage-one mode selection and its `shared/README.md` fallback.\n497: \n498: ### The discriminator\n499: - **`workflowMode`** - the public mode/packet key: `sk-code-quality`, `sk-code-review` (workflow) or `sk-code-ci`, `sk-code-frontend`, `sk-code-skilled` (surface).\n500: - **`packetKind`** - the axis: `workflow` (a mode that acts) or `surface` (read-only evidence bundled alongside a mode).\n501: - **`backendKind`** - which backend runs the packet: `surface-router` or `review-cache` for workflow modes, `evidence-base` for surface packets.\n502: \n503: Surface packets are advisor-invisible (`routingClass: metadata`, read-only `toolSurface`).\n504: The advisor still routes the single identity `sk-code`, and the hub bundles zero-or-more surfaces as evidence via `routerPolicy.outcomes.surfaceBundle`.\n505: The workflow mode comes first, followed by surfaces.\n506: \"review my typescript module for jank\" → `[sk-code-review, sk-code-skilled]`.\n507: Bundled surfaces follow the `routerPolicy.tieBreak` order. It ranks `sk-code-frontend` ahead of `sk-code-ci`, then `sk-code-skilled` last, because a new surface goes ahead of the existing ones and the SKILLED fallback stays last.\n508: \n509: ### Surface detection\n510: \n511: Surface detection lives once in the hub's `shared/` layer and every mode and surface consumes it.\n512: It tries every declared specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n513: When a specific surface and `SKILLED` both match, the specific one leads and `SKILLED` comes along as second evidence.\n514: Each surface declares its markers in a `surfaceDetection` block in `mode-registry.json`, or in its own `graph-metadata.json` when it lives outside the hub.\n515: Modes own workflow contracts, not surface identity.\n516: `sk-code-ci` and `sk-code-frontend` are the surfaces that stack detection does not select. The hub bundles both from request vocabulary alone: CI through `code-ci-aliases` and `code-ci-runtime`, and Frontend through `code-frontend-aliases` in `hub-router.json`.\n517: \n518: ### Fallback route\n519: \n520: When no workflow mode dominates (a bare implement/debug/verify request), the router defers to a pure surface bundle: it detects the surface, loads that surface's evidence and workflow doctrine, and the agent acts. `routerPolicy.defaultMode` is `null`, so the hub does not force a stale default. An unclear code intent asks for disambiguation.\n521: \n522: Per-mode behavior is **not flattened**: each packet keeps its own code-work contract, standards, evidence rules, and tool-permission guards.\n523: \n524: ### Routing rule\n525: ```python\n526: from pathlib import Path\n527: \n528: SKILL_ROOT = Path(__file__).resolve().parent\n529: UNKNOWN_FALLBACK_CHECKLIST = [\n530:     \"Confirm whether this is sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend or sk-code-skilled work\",\n531:     \"Confirm the target files or runtime surface\",\n532:     \"Confirm the expected action: implement, debug, verify, quality gate, or review\",\n533:     \"Confirm the verification command set before completion\",\n534: ]\n535: \n536: def _guard_in_skill(relative_path: str) -> str:\n537:     resolved = (SKILL_ROOT / relative_path).resolve()\n538:     resolved.relative_to(SKILL_ROOT)\n539:     if resolved.name != \"SKILL.md\" and resolved.suffix.lower() != \".md\":\n540:         raise ValueError(f\"Only markdown skill resources are routable: {relative_path}\")\n541:     return resolved.relative_to(SKILL_ROOT).as_posix()\n542: \n543: def load_if_available(relative_path: str, loaded: list[str], seen: set[str]) -> None:\n544:     guarded = _guard_in_skill(relative_path)\n545:     path = SKILL_ROOT / guarded\n546:     if path.exists() and guarded not in seen:\n547:         load(guarded)\n548:         loaded.append(guarded)\n549:         seen.add(guarded)\n550: \n551: def route(task):\n552:     loaded, seen = [], set()\n553:     registry = read_json(SKILL_ROOT / \"mode-registry.json\")\n554:     workflow_mode = explicit_mode_hint(task) or classify_workflow_mode(task)\n555: \n556:     if not workflow_mode:\n557:         load_if_available(\"shared/README.md\", loaded, seen)\n558:         return {\n559:             \"load_level\": \"UNKNOWN_FALLBACK\",\n560:             \"needs_disambiguation\": True,\n561:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n562:             \"resources\": loaded,\n563:         }\n564: \n565:     entry = find_registry_entry(registry, workflowMode=workflow_mode)\n566:     if not entry:\n567:         load_if_available(\"shared/README.md\", loaded, seen)\n568:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"unknown_mode\": workflow_mode, \"resources\": loaded}\n569: \n570:     packet_skill = f\"{entry['packet']}/SKILL.md\"\n571:     load_if_available(packet_skill, loaded, seen)\n572: \n573:     for surface_mode in surface_bundle_from_hub_router(task):\n574:         surface_entry = find_registry_entry(registry, workflowMode=surface_mode)\n575:         if surface_entry:\n576:             load_if_available(f\"{surface_entry['packet']}/SKILL.md\", loaded, seen)\n577: \n578:     if not loaded:\n579:         load_if_available(\"shared/README.md\", loaded, seen)\n580:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"notice\": \"matched registry but no packet SKILL.md was available\", \"resources\": loaded}\n581: \n582:     return {\"workflowMode\": workflow_mode, \"backendKind\": entry[\"backendKind\"], \"resources\": loaded}\n583: ```","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md, lines 1-583\n1: ---\n2: title: sk-code Surface Router — routing logic and resource maps\n3: description: First-class surface router document at the sk-code hub root (ROUTER.md). hub-router.json selects the workflow mode; this doc maps a request's code intent to the exact packet-local leaf resources that mode should load, emitting canonical (workflowMode, leafResourceId) pairs. Relocated from shared/references/smart-routing.md (v3.5.0.8) as the ROUTER.md consolidation pattern, with the approved sk-code shared-control delta (router self-reference removed, ten hub-shared paths normalized to shared/..., mapped shared controls declared).\n4: trigger_phrases:\n5:   - \"sk-code smart routing\"\n6:   - \"surface resource maps\"\n7:   - \"intent classification routing\"\n8:   - \"load tier resource loading\"\n9:   - \"unknown surface fallback\"\n10: importance_tier: important\n11: contextType: general\n12: version: 2.3.19.0\n13: router_state: active\n14: skill_pointer: SKILL.md\n15: ---\n16: # sk-code Surface Router — routing logic and resource maps\n17: \n18: Leaf-set authority for sk-code. The routing authority is named once in `SKILL.md` §2 SMART ROUTING: `hub-router.json` is the mode vocabulary, and this document is the leaf-set router. Consolidates intent classification + resource loading into the single Barter-style smart-routing entry point. Detection logic lives in [`stack-detection.md`](shared/references/stack-detection.md); phase lifecycle lives in [`phase-detection.md`](shared/references/phase-detection.md).\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: ### Purpose\n25: \n26: The smart router maps a detected surface (a declared specific surface, then the SKILLED fallback, then UNKNOWN) plus a classified intent (IMPLEMENTATION / DEBUGGING / VERIFICATION / etc.) to the exact references, assets, and verification commands needed for the active task. Loads only the smallest relevant set so the active context window stays focused.\n27: \n28: ### When to Use\n29: \n30: - After surface detection (see [`stack-detection.md`](shared/references/stack-detection.md)) determines the surface: a declared specific surface, then the SKILLED fallback, then UNKNOWN\n31: - When classifying task wording into the dominant work intent\n32: - When mapping intent to concrete reference paths\n33: - When picking verification commands for the surface\n34: \n35: ### Core Principle\n36: \n37: Routing is a two-stage decision: **surface-first, intent-second**. Surface narrows the resource family: a declared specific surface first, then the SKILLED fallback, then UNKNOWN. Intent narrows the specific files within that family. The detected surface also goes to the compiled front door as `--surface-hint`. When a prompt ties between surfaces, a hinted specific surface leads the bundle. SKILLED already ranks last, so a SKILLED hint changes nothing (`SKILL.md` §3).\n38: \n39: ### Key Sources\n40: \n41: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) and SKILLED language sub-detection\n42: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and phase-specific resource expectations\n43: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n44: \n45: ---\n46: \n47: ## 2. INTENT MODEL\n48: \n49: Intent classification scores task text against weighted keyword signals to pick the dominant work type after surface detection. The vocabulary and weights are authored once, in the `INTENT_SIGNALS` block of §8 MACHINE-READABLE ROUTER; read them there. This section is the human-facing summary of how that block is scored, never a second copy of its keywords.\n50: \n51: ### Scoring algorithm\n52: \n53: 1. Sum weighted keyword hits from the request, target files, and known task context.\n54: 2. Boost explicit phase signals (verification, debugging, code quality) by +5 when the phase is unambiguous.\n55: 3. Select the top intent.\n56: 4. Select a second intent when the score delta to the next intent is small (`AMBIGUITY_DELTA = 1`).\n57: 5. For SKILLED surface, run language sub-detection after intent selection.\n58: \n59: ### Doc-only edit anti-signals\n60: \n61: Doc-only prose changes subtract from `sk-code` intent scoring and add to `sk-doc` scoring, even when the target file is under `.skilled/skills/`.\n62: \n63: | Prompt signal | Effect |\n64: | --- | --- |\n65: | `update headline`, `rewrite headline`, `headline section` | `sk-code -2`, `sk-doc +3` |\n66: | `clarify description`, `clarify the X model`, `documentation section` | `sk-code -2`, `sk-doc +3` |\n67: | `add a one-line summary`, `add summary at the top` | `sk-code -2`, `sk-doc +3` |\n68: | `improve readme`, `reorganize readme`, `rewrite section` | `sk-code -2`, `sk-doc +3` |\n69: | `SKILL.md` or `README.md` plus prose-only verbs | `sk-code -2`, `sk-doc +3` |\n70: \n71: Do not apply this anti-signal when the same request asks to modify executable code, parser logic, tests, shell behavior, TypeScript/Python entrypoints, JSON schema behavior, or routing algorithms. In that case, keep SKILLED surface detection and load `sk-code`.\n72: \n73: Multi-symptom prompts like `debug the broken jsonc descriptor` should load both DEBUGGING and CONFIG. Prompts like `update TypeScript advisor fixture` should load SKILLED plus TYPESCRIPT and CODE_QUALITY.\n74: \n75: ### Surface-specific intent notes\n76: \n77: - **SKILLED** intent scoring favors language standards, hooks, config, scripts, advisor/tests, metadata, and alignment verification.\n78: - Unsupported surfaces stay UNKNOWN even if intent scoring is strong.\n79: \n80: ---\n81: \n82: ## 3. LOAD TIERS\n83: \n84: | Tier | When | Resources |\n85: | --- | --- | --- |\n86: | ALWAYS | Every invocation | The §8 `DEFAULT_RESOURCE` preamble only: `shared/references/stack-detection.md`, `shared/references/phase-detection.md` and `shared/references/universal/code-quality-standards.md`. The style guide `sk-code-quality/references/code-style-guide.md` loads with CODE_QUALITY, and the shared doctrine loads with its intent: `workflow-debug.md` with DEBUGGING and `workflow-verify.md` with VERIFICATION |\n87: | SURFACE | After SKILLED detection | Surface-specific resources (`sk-code-skilled/references/shared/*`) |\n88: | INTENT | After intent classification | Implementation, debugging, verification, testing, etc. matching the top-1 intent (and top-2 when ambiguous) |\n89: | LANGUAGE | SKILLED only | Split JavaScript, TypeScript, Python, Shell, Rust, and Config standards from the matching `sk-code-skilled/references/<lang>/` resources |\n90: | ON_DEMAND | Explicit deep-dive keywords | Extended checklists and niche references (e.g. `sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md` for boundary templates) |\n91: \n92: ---\n93: \n94: ## 4. SKILLED MAP\n95: \n96: SKILLED loads from `sk-code-skilled/references/` and `sk-code-skilled/assets/`.\n97: \n98: ### Implementation shared tier\n99: \n100: IMPLEMENTATION loads the shared organization and naming baseline:\n101: \n102: - `sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md`\n103: - `sk-code-skilled/references/shared/code-organization/overview-and-module-organization.md`\n104: \n105: ### Intent overlay\n106: \n107: | Intent | Resources |\n108: | --- | --- |\n109: | CODE_QUALITY | SKILLED only: `sk-code-skilled/assets/checklists/universal-checklist.md` plus the language-matching checklist, both when SKILLED is a resolved surface. A foreign surface loads the floor in `code-quality-standards.md` and its own declared rows |\n110: | VERIFICATION | `sk-code-skilled/references/shared/alignment-verification-automation.md`, `sk-code-skilled/assets/scripts/verify_alignment_drift.py` |\n111: | HOOKS | `sk-code-skilled/references/shared/hooks.md` |\n112: | CONFIG | `sk-code-skilled/references/config/*` |\n113: | LANGUAGE_STANDARDS | Detected language folder's `quick-reference.md`, `style-guide.md`, `quality-standards.md` |\n114: \n115: ### Language overlay\n116: \n117: | Language | Resources |\n118: | --- | --- |\n119: | JAVASCRIPT | `sk-code-skilled/references/javascript/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/javascript-checklist.md` |\n120: | TYPESCRIPT | `sk-code-skilled/references/typescript/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/typescript-checklist.md` |\n121: | PYTHON | `sk-code-skilled/references/python/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/python-checklist.md` |\n122: | SHELL | `sk-code-skilled/references/shell/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/shell-checklist.md` |\n123: | RUST | `sk-code-skilled/references/rust/{style_guide,quality_standards,quick_reference}/` (each split into topic parts), `sk-code-skilled/assets/checklists/rust-checklist/` |\n124: | CONFIG | `sk-code-skilled/references/config/{style_guide,quality_standards,quick_reference}.md`, `sk-code-skilled/assets/checklists/config-checklist.md` |\n125: \n126: ### Authoring checklist gating\n127: \n128: When SKILLED intent is `authoring-new-X`, additionally load the matching authoring checklist:\n129: \n130: | Authoring target | Checklist |\n131: | --- | --- |\n132: | New skill | `sk-code-skilled/assets/checklists/skill-authoring.md` |\n133: | New agent | `sk-code-skilled/assets/checklists/agent-authoring.md` |\n134: | New command | `sk-code-skilled/assets/checklists/command-authoring.md` |\n135: | New MCP server | `sk-code-skilled/assets/checklists/mcp-server-authoring.md` |\n136: | Spec folder write | Now in system-spec-kit: `system-spec-kit/references/workflows/spec-folder-authoring-checklist.md` + `system-spec-kit/references/workflows/spec-folder-write-recipe.md` |\n137: \n138: ### CI Workflow Map\n139: \n140: When the request names a GitHub Actions workflow, the hub bundles `sk-code-ci` from the request vocabulary and the `CI_WORKFLOW` intent loads its four rule references:\n141: \n142: | Resource | Carries |\n143: | --- | --- |\n144: | `sk-code-ci/references/ci-workflow-standards.md` | The rule index: path parity, SHA pins, README row, `set -euo pipefail`, fork and secret safety, matrix and `fail-fast` |\n145: | `sk-code-ci/references/trigger-and-filter-rules.md` | The twin rule, the rebuild-commit skip rule, push-only scope and the intentional exceptions table |\n146: | `sk-code-ci/references/job-shape-rules.md` | Timeouts, permissions, the concurrency template, the composite setup action and the switch `if:` shape |\n147: | `sk-code-ci/references/protected-set.md` | The repository CI profile and its keys, the workflows protected by function and the rules that follow |\n148: \n149: The map is the packet's own `RESOURCE_MAP` re-prefixed with `sk-code-ci/`, so the two stay equal.\n150: \n151: ### Frontend Map\n152: \n153: When a request asks about web frontend practice, or a Figma-to-code check, the hub bundles `sk-code-frontend` from request vocabulary alone:\n154: \n155: | Resource | Carries |\n156: | --- | --- |\n157: | `sk-code-frontend/references/frontend-practice.md` | The cross-stack core, token precedence, Figma boundary, and Frontend overrides contract |\n158: | `sk-code-frontend/references/web-markup-and-css.md` | The web stack layer for markup, forms, layout, responsive behavior, media, and CSS architecture |\n159: | `sk-code-frontend/references/web-elements-and-attributes.md` | Form autocomplete, dialog, and popover behavior |\n160: | `sk-code-frontend/references/web-cascade-and-selectors.md` | Cascade layers and specificity conflicts |\n161: | `sk-code-frontend/references/web-layout-and-sizing.md` | Container queries and stacking contexts |\n162: | `sk-code-frontend/references/web-accessibility-patterns.md` | Accessibility patterns, visible focus, and live regions |\n163: | `sk-code-frontend/references/web-performance-and-loading.md` | Web font loading and largest contentful paint |\n164: | `sk-code-frontend/references/web-internationalization.md` | Right-to-left layout and bidirectional text |\n165: | `sk-code-frontend/references/web-visual-values.md` | Visual value decisions: spacing, type, weight, colour, shadow, radius, opacity, palettes and token sets |\n166: | `sk-code-frontend/references/web-visual-hierarchy.md` | Visual hierarchy and review: build procedure, symptom-to-fix tables, UX laws and the review pass |\n167: | `sk-code-frontend/references/web-motion-and-interaction.md` | Motion and interaction: animation, input, touch, focus, performance and feedback rules |\n168: | `sk-code-frontend/references/figma-to-code.md` | The five-pass check for comparing a built screen with its Figma frame |\n169: \n170: The map is the packet's own `RESOURCE_MAP` for the web, visual and Figma-to-code intents, re-prefixed with `sk-code-frontend/`, so the two stay equal there.\n171: \n172: ---\n173: \n174: ## 5. VERIFICATION COMMANDS\n175: \n176: | Surface | Required verification evidence |\n177: | --- | --- |\n178: | SKILLED | `python3 .skilled/skills/sk-code/sk-code-skilled/assets/scripts/verify_alignment_drift.py --root <changed-scope>`; plus targeted language/project tests such as vitest, pytest, shellcheck, JSON validation, or spec validation for changed spec folders |\n179: | UNKNOWN | User-selected verification command set before completion claim |\n180: \n181: ---\n182: \n183: ## 6. UNKNOWN FALLBACK\n184: \n185: If no supported surface matches, ask:\n186: \n187: 1. Is this `.skilled/` system code, or an unsupported stack?\n188: 2. Which files or directories are changing?\n189: 3. Which verification command proves the claim?\n190: 4. Should a new `sk-code` route be planned before implementation?\n191: \n192: Canonical sk-code owns the SKILLED surface, the `sk-code-ci` GitHub Actions surface and the stack-agnostic `sk-code-frontend` surface for web practice. Go, Next.js server code and React Native surfaces live in a project fork.\n193: \n194: ### UNKNOWN fallback checklist\n195: \n196: Returned when intent confidence is low (`max(intent_scores) < 0.5`) OR when the user explicitly asks for stack-agnostic guidance:\n197: \n198: - Confirm the detected surface (a declared specific surface, the SKILLED fallback or UNKNOWN)\n199: - Confirm the task intent (implementation / debugging / verification / etc.)\n200: - Provide one concrete input, error, or expected output\n201: - Confirm the verification command set before completion\n202: \n203: ---\n204: \n205: ## 7. LOADING DISCIPLINE (DO / DON'T)\n206: \n207: ### DO\n208: \n209: - Load only references needed for current intent + surface\n210: - Use exact canonical file paths in playbook result YAML (never directory placeholders)\n211: - Cite surface + top-1 intent + loaded resource paths + verification command in your final answer\n212: \n213: ### DON'T\n214: \n215: - Load all of `sk-code-skilled/` indiscriminately (\"just in case\")\n216: - Load Go, Next.js server code or React Native resources from canonical sk-code; those live in a project fork\n217: - Drop directory placeholders in playbook result YAML\n218: \n219: ---\n220: \n221: ## 8. MACHINE-READABLE ROUTER (replay / benchmark source)\n222: \n223: This block is the authored source for the intent vocabulary and weights. §2 explains how it is scored and does not repeat the keywords; §4 renders the same rows as prose. When an intent row changes here, update the matching prose row in §4.\n224: \n225: This projection is intentionally lossy in two documented ways the flat dictionary cannot express, both enforced by the prose contract and the surface-detection pseudocode in this file's §11:\n226: \n227: - **No phase boosts.** The `+5` unambiguous-phase boost from the §2 scoring algorithm is not represented; every keyword carries unit weight here.\n228: - **No doc-only anti-signals.** The `sk-code -2 / sk-doc +3` anti-signals (§2) that route prose-only edits away from this skill are a pre-filter the flat model does not carry.\n229: \n230: ```python\n231: # Always-loaded routing preamble: every code task detects stack, detects phase,\n232: # consults the router, and applies the universal quality baseline before any\n233: # surface-specific resource. These are loaded on every route.\n234: DEFAULT_RESOURCE = [\n235:     \"shared/references/stack-detection.md\",\n236:     \"shared/references/phase-detection.md\",\n237:     \"shared/references/universal/code-quality-standards.md\",\n238: ]\n239: \n240: INTENT_SIGNALS = {\n241:     \"IMPLEMENTATION\":     {\"weight\": 1, \"keywords\": [\"implement\", \"build\", \"create\", \"feature\", \"component\", \"module\", \"authoring\"]},\n242:     \"CODE_QUALITY\":       {\"weight\": 1, \"keywords\": [\"lint\", \"format\", \"quality gate\", \"naming\", \"standards\", \"code smell\", \"comment hygiene\", \"restraint\", \"yagni\", \"simplify\", \"over-engineering\", \"bloat\", \"skipped_untrusted\", \"untrusted repository check\", \"trustrepochecks\", \"quality config\", \"repository/quality.json\", \"configured check\", \"unverified\"]},\n243:     \"DEBUGGING\":          {\"weight\": 1, \"keywords\": [\"debug\", \"broken\", \"failing\", \"stack trace\", \"console error\", \"regression\"]},\n244:     \"VERIFICATION\":       {\"weight\": 1, \"keywords\": [\"verify\", \"passing\", \"type-check\", \"alignment drift\", \"completion claim\"]},\n245:     \"HOOKS\":              {\"weight\": 1, \"keywords\": [\"session-prime\", \"user-prompt-submit\", \"pre-tool-use\", \"post-tool-use\"]},\n246:     \"CONFIG\":             {\"weight\": 1, \"keywords\": [\"jsonc\", \".json\", \".jsonc\", \"descriptor\", \"config schema\"]},\n247:     \"JAVASCRIPT\":         {\"weight\": 1, \"keywords\": [\"javascript\", \"vanilla js\", \".js\", \"commonjs\", \".cjs\", \".mjs\"]},\n248:     \"TYPESCRIPT\":         {\"weight\": 1, \"keywords\": [\"typescript\", \".ts\", \".tsx\"]},\n249:     \"PYTHON\":             {\"weight\": 1, \"keywords\": [\"python\", \".py\", \"docstring\"]},\n250:     \"SHELL\":              {\"weight\": 1, \"keywords\": [\"shell script\", \"bash\", \".sh\"]},\n251:     \"RUST\":               {\"weight\": 1, \"keywords\": [\"rust\", \".rs\", \"cargo.toml\", \"cargo.lock\", \"napi-rs\", \"napi_rs\", \"#[napi]\", \"wasm-bindgen\", \"wasm_bindgen\", \"#[wasm_bindgen]\", \"wasi\", \"cdylib\"]},\n252:     \"CI_WORKFLOW\":        {\"weight\": 4, \"keywords\": [\"github actions workflow\", \"ci workflow\", \"github actions yaml\", \"workflow path filters\", \"github workflow timeout\", \"github workflow concurrency\", \"github workflow permissions\", \"required status check workflow\", \"ci job\", \"action to a sha\", \"sha-pinned action\", \"github actions permissions\", \"ci workflows\", \"ci switch\", \"turn off ci\", \".github/workflows\", \"workflow concurrency\", \"github actions release workflow\", \"github actions deploy workflow\", \"release workflow yaml\", \"deploy workflow yaml\", \"github actions minutes\", \"actions minutes\", \"actions runner minutes\", \"runner minutes\", \"ci workflow cost\", \"ci cost\", \"reduce ci costs\", \"lower ci costs\", \"cut ci costs\", \"reduce our ci costs\", \"lower our ci costs\", \"ci spend\", \"ci bill\", \"ci minutes cost\", \"cut the ci minutes\", \"cut ci minutes\", \"reduce ci minutes\", \"ci pipeline cost\", \"ci pipeline cheaper\", \"ci pipelines cheaper\", \"cheaper ci pipeline\", \"ci runs cheaper\", \"failing ci\", \"failing ci pipeline\", \"ci failure\", \"ci failures\", \"ci is failing\", \"broken ci\", \"debug the ci\", \"debug ci\", \"cost of our ci\", \"make ci cheaper\", \"github actions bill\", \"github actions cost\", \"turn off the ci\", \"turn on the ci\", \"ci review workflow\"]},\n253:     \"FRONTEND_WEB\":        {\"weight\": 4, \"keywords\": [\"semantic html markup\"]},\n254:     \"WEB_ELEMENTS\":        {\"weight\": 4, \"keywords\": [\"html form autocomplete\", \"dialog element\", \"popover attribute\"]},\n255:     \"WEB_CASCADE\":         {\"weight\": 4, \"keywords\": [\"css cascade layers\", \"css specificity conflict\"]},\n256:     \"WEB_LAYOUT\":          {\"weight\": 4, \"keywords\": [\"container query layout\", \"css stacking context\"]},\n257:     \"WEB_A11Y\":            {\"weight\": 4, \"keywords\": [\"web accessibility pattern\", \"focus visible styling\", \"keyboard focus\", \"broken tab order\", \"accessible name\", \"aria live region\", \"focus ring accessibility\", \"focus outline removed\", \"screen reader support\", \"aria label missing\", \"alt text missing\", \"wcag audit\"]},\n258:     \"WEB_PERF\":            {\"weight\": 4, \"keywords\": [\"web font loading\", \"largest contentful paint\"]},\n259:     \"WEB_I18N\":            {\"weight\": 4, \"keywords\": [\"right to left layout\", \"bidirectional text\"]},\n260:     \"WEB_VISUAL_VALUES\": {\"weight\": 4, \"keywords\": [\"what padding should this have\", \"how much padding\", \"what font size should this be\", \"spacing between elements\", \"spacing scale\", \"type scale\", \"build a color palette\", \"shade ramp\", \"box shadow elevation\", \"border radius consistency\", \"contrast ratio failure\", \"grey text on colored background\", \"dark mode palette\", \"concentric border radius\", \"layered shadows\", \"shadow color on dark surface\", \"tabular numbers\", \"what should this button look like\", \"colour decision\", \"color decision\", \"padding\", \"type scale for\", \"font size\", \"colour palette\", \"color palette\", \"contrast ratio\", \"corner radius\", \"box shadow\", \"spacing between\", \"contrast of\", \"check the contrast\", \"colour contrast\", \"color contrast\", \"muted text\"]},\n261:     \"WEB_VISUAL_HIERARCHY\": {\"weight\": 4, \"keywords\": [\"ui looks off\", \"looks amateur\", \"feels cluttered\", \"make this look better\", \"make this ui look designed\", \"visual hierarchy\", \"no visual hierarchy\", \"nothing draws the eye\", \"everything competes for attention\", \"everything looks the same\", \"emphasize by de-emphasizing\", \"how to style a destructive button\", \"this page feels overwhelming\", \"where do i start designing\", \"design a new screen from scratch\", \"how much white space\", \"why does this look wrong\", \"does this look right\", \"critique this design\", \"design critique\", \"visual audit\", \"design review findings\", \"design review\", \"review this design\", \"review this screen\", \"ux laws\", \"cognitive load\", \"progressive disclosure\", \"empty state design\", \"look wrong\", \"looks wrong\", \"looks off\", \"visual review\", \"type hierarchy\"]},\n262:     \"WEB_MOTION\":        {\"weight\": 4, \"keywords\": [\"animation duration\", \"transition duration\", \"easing curve\", \"spring versus easing\", \"twelve principles of animation\", \"when not to animate\", \"response time budget\", \"touch target size\", \"hover state\", \"active pressed state\", \"disabled state styling\", \"button states\", \"animation\", \"transition timing\", \"easing\", \"hover\", \"focus-visible\", \"interaction states\"]},\n263:     \"FIGMA_TO_CODE\":      {\"weight\": 4, \"keywords\": [\"figma to code\", \"check built screen against figma\", \"compare build with figma frame\", \"figma frame\", \"figma frame check\", \"implement a figma design\"]},\n264: }\n265: \n266: RESOURCE_MAP = {\n267:     \"IMPLEMENTATION\": [\n268:         \"sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md\",\n269:         \"sk-code-skilled/references/shared/universal-patterns/organization-security-and-examples.md\",\n270:         \"sk-code-skilled/references/shared/code-organization/overview-and-module-organization.md\",\n271:         \"sk-code-skilled/references/shared/code-organization/imports-and-exports.md\",\n272:         \"sk-code-skilled/references/shared/code-organization/directory-and-test-conventions.md\",\n273:         \"sk-code-skilled/assets/checklists/agent-authoring.md\",\n274:         \"sk-code-skilled/assets/checklists/command-authoring.md\",\n275:         \"sk-code-skilled/assets/checklists/skill-authoring.md\",\n276:         \"sk-code-skilled/assets/checklists/mcp-server-authoring.md\",\n277: \n278:     ],\n279:     \"CODE_QUALITY\": [\n280:         \"shared/references/universal/code-quality-standards.md\",\n281:         \"shared/references/universal/rule-overrides.md\",\n282:         \"sk-code-quality/references/code-style-guide.md\",\n283:         \"sk-code-quality/references/runner-contract.md\",\n284:         \"sk-code-skilled/assets/checklists/universal-checklist.md\",  # SKILLED only: the house checklist loads when SKILLED resolves, never for a foreign surface\n285:         \"sk-code-skilled/assets/checklists/javascript-checklist.md\",\n286:         \"sk-code-skilled/assets/checklists/js-css-style/overview-header-and-comments.md\",\n287:         \"sk-code-skilled/assets/checklists/js-css-style/naming-init-formatting-and-css.md\",\n288:         \"sk-code-skilled/assets/checklists/js-css-style/verification-quick-reference-and-related.md\",\n289:         \"sk-code-skilled/assets/checklists/typescript-checklist.md\",\n290:         \"sk-code-skilled/assets/checklists/python-checklist.md\",\n291:         \"sk-code-skilled/assets/checklists/shell-checklist.md\",\n292:         \"sk-code-skilled/assets/checklists/rust-checklist/overview-and-p0-parity.md\",\n293:         \"sk-code-skilled/assets/checklists/rust-checklist/p0-safety-and-boundary-discipline.md\",\n294:         \"sk-code-skilled/assets/checklists/rust-checklist/p1-required.md\",\n295:         \"sk-code-skilled/assets/checklists/rust-checklist/p2-evidence-validation-and-resources.md\",\n296:         \"sk-code-review/assets/code-quality-checklist.md\",\n297: \n298:     ],\n299:     \"DEBUGGING\": [\n300:         \"shared/references/workflow-debug.md\",\n301: \n302:     ],\n303:     \"VERIFICATION\": [\n304:         \"sk-code-skilled/references/shared/alignment-verification-automation.md\",\n305:         \"shared/references/workflow-verify.md\",\n306:         \"sk-code-skilled/assets/scripts/README.md\",\n307: \n308:     ],\n309:     \"HOOKS\": [\n310:         \"sk-code-skilled/references/shared/hooks.md\",\n311:     ],\n312:     \"CONFIG\": [\n313:         \"sk-code-skilled/references/config/style-guide.md\",\n314:         \"sk-code-skilled/references/config/quality-standards.md\",\n315:         \"sk-code-skilled/references/config/quick-reference.md\",\n316:         \"sk-code-skilled/assets/checklists/config-checklist.md\",\n317:     ],\n318:     \"JAVASCRIPT\": [\n319:         \"sk-code-skilled/references/javascript/style-guide.md\",\n320:         \"sk-code-skilled/references/javascript/quality-standards/overview-modules-and-docs.md\",\n321:         \"sk-code-skilled/references/javascript/quality-standards/security-testing-and-exemptions.md\",\n322:         \"sk-code-skilled/references/javascript/quick-reference.md\",\n323:     ],\n324:     \"TYPESCRIPT\": [\n325:         \"sk-code-skilled/references/typescript/style-guide/overview-strict-and-naming.md\",\n326:         \"sk-code-skilled/references/typescript/style-guide/formatting-imports-and-coexistence.md\",\n327:         \"sk-code-skilled/references/typescript/quality-standards/overview-and-type-system.md\",\n328:         \"sk-code-skilled/references/typescript/quality-standards/tsdoc-errors-and-async.md\",\n329:         \"sk-code-skilled/references/typescript/quality-standards/tsconfig-and-modules.md\",\n330:         \"sk-code-skilled/references/typescript/quick-reference/template-naming-and-types.md\",\n331:         \"sk-code-skilled/references/typescript/quick-reference/imports-errors-and-tsconfig.md\",\n332:     ],\n333:     \"PYTHON\": [\n334:         \"sk-code-skilled/references/python/style-guide.md\",\n335:         \"sk-code-skilled/references/python/quality-standards.md\",\n336:         \"sk-code-skilled/references/python/quick-reference.md\",\n337:     ],\n338:     \"SHELL\": [\n339:         \"sk-code-skilled/references/shell/style-guide/overview-structure-and-naming.md\",\n340:         \"sk-code-skilled/references/shell/style-guide/variables-functions-and-output.md\",\n341:         \"sk-code-skilled/references/shell/quality-standards/overview-and-priority-blockers.md\",\n342:         \"sk-code-skilled/references/shell/quality-standards/validation-security-and-shellcheck.md\",\n343:         \"sk-code-skilled/references/shell/quick-reference/template-variables-and-loops.md\",\n344:         \"sk-code-skilled/references/shell/quick-reference/functions-strings-and-checklist.md\",\n345:     ],\n346:     \"RUST\": [\n347:         \"sk-code-skilled/references/rust/style-guide/overview-and-file-header.md\",\n348:         \"sk-code-skilled/references/rust/style-guide/toolchain-and-project-structure.md\",\n349:         \"sk-code-skilled/references/rust/style-guide/naming-conventions.md\",\n350:         \"sk-code-skilled/references/rust/style-guide/formatting-and-imports.md\",\n351:         \"sk-code-skilled/references/rust/style-guide/commenting-and-rustdoc.md\",\n352:         \"sk-code-skilled/references/rust/style-guide/interop-model.md\",\n353:         \"sk-code-skilled/references/rust/style-guide/interop-errors-and-parity.md\",\n354:         \"sk-code-skilled/references/rust/quality-standards/overview-and-data-ownership.md\",\n355:         \"sk-code-skilled/references/rust/quality-standards/modeling-collections-and-api.md\",\n356:         \"sk-code-skilled/references/rust/quality-standards/docs-errors-and-async.md\",\n357:         \"sk-code-skilled/references/rust/quality-standards/build-and-organization.md\",\n358:         \"sk-code-skilled/references/rust/quality-standards/determinism-and-parity.md\",\n359:         \"sk-code-skilled/references/rust/quick-reference/overview-and-boundary-template.md\",\n360:         \"sk-code-skilled/references/rust/quick-reference/naming-ordering-and-signatures.md\",\n361:         \"sk-code-skilled/references/rust/quick-reference/collections-imports-and-errors.md\",\n362:         \"sk-code-skilled/references/rust/quick-reference/rustdoc-and-cargo.md\",\n363:         \"sk-code-skilled/references/rust/quick-reference/determinism-parity-and-related.md\",\n364:     ],\n365:     \"CI_WORKFLOW\": [\n366:         \"sk-code-ci/references/ci-workflow-standards.md\",\n367:         \"sk-code-ci/references/trigger-and-filter-rules.md\",\n368:         \"sk-code-ci/references/job-shape-rules.md\",\n369:         \"sk-code-ci/references/protected-set.md\",\n370:     ],\n371:     \"FRONTEND_WEB\": [\n372:         \"sk-code-frontend/references/frontend-practice.md\",\n373:         \"sk-code-frontend/references/web-markup-and-css.md\",\n374:     ],\n375:     \"WEB_ELEMENTS\": [\n376:         \"sk-code-frontend/references/frontend-practice.md\",\n377:         \"sk-code-frontend/references/web-markup-and-css.md\",\n378:         \"sk-code-frontend/references/web-elements-and-attributes.md\",\n379:     ],\n380:     \"WEB_CASCADE\": [\n381:         \"sk-code-frontend/references/frontend-practice.md\",\n382:         \"sk-code-frontend/references/web-markup-and-css.md\",\n383:         \"sk-code-frontend/references/web-cascade-and-selectors.md\",\n384:     ],\n385:     \"WEB_LAYOUT\": [\n386:         \"sk-code-frontend/references/frontend-practice.md\",\n387:         \"sk-code-frontend/references/web-markup-and-css.md\",\n388:         \"sk-code-frontend/references/web-layout-and-sizing.md\",\n389:     ],\n390:     \"WEB_A11Y\": [\n391:         \"sk-code-frontend/references/frontend-practice.md\",\n392:         \"sk-code-frontend/references/web-markup-and-css.md\",\n393:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n394:     ],\n395:     \"WEB_PERF\": [\n396:         \"sk-code-frontend/references/frontend-practice.md\",\n397:         \"sk-code-frontend/references/web-markup-and-css.md\",\n398:         \"sk-code-frontend/references/web-performance-and-loading.md\",\n399:     ],\n400:     \"WEB_I18N\": [\n401:         \"sk-code-frontend/references/frontend-practice.md\",\n402:         \"sk-code-frontend/references/web-markup-and-css.md\",\n403:         \"sk-code-frontend/references/web-internationalization.md\",\n404:     ],\n405:     \"WEB_VISUAL_VALUES\": [\n406:         \"sk-code-frontend/references/frontend-practice.md\",\n407:         \"sk-code-frontend/references/web-visual-values.md\",\n408:     ],\n409:     \"WEB_VISUAL_HIERARCHY\": [\n410:         \"sk-code-frontend/references/frontend-practice.md\",\n411:         \"sk-code-frontend/references/web-visual-hierarchy.md\",\n412:         \"sk-code-frontend/references/web-visual-values.md\",\n413:         \"sk-code-frontend/references/web-accessibility-patterns.md\",\n414:     ],\n415:     \"WEB_MOTION\": [\n416:         \"sk-code-frontend/references/frontend-practice.md\",\n417:         \"sk-code-frontend/references/web-motion-and-interaction.md\",\n418:     ],\n419:     \"FIGMA_TO_CODE\": [\n420:         \"sk-code-frontend/references/figma-to-code.md\",\n421:         \"sk-code-frontend/references/frontend-practice.md\",\n422:     ],\n423: }\n424: \n425: # Hub-level shared controls, declared once here. This list holds every\n426: # contained shared/ path that RESOURCE_MAP references but that is exempt from\n427: # typed-leaf projection, because it has no single packet owner. The root-router\n428: # contract validates each entry and requires RESOURCE_MAP to reference it.\n429: # DEFAULT_RESOURCE above is the other half of the set: its always-loaded\n430: # preamble paths are hub-level controls too. No other shared/ path is a\n431: # control, so a guard that needs the control set reads these two lists.\n432: SHARED_CONTROL_RESOURCES = [\n433:     \"shared/references/universal/code-quality-standards.md\",\n434:     \"shared/references/universal/rule-overrides.md\",\n435:     \"shared/references/workflow-debug.md\",\n436:     \"shared/references/workflow-verify.md\",\n437: ]\n438: ```\n439: \n440: ### Surface-aware loading (route-time)\n441: \n442: The router does NOT load the whole matched-intent union. After surface detection (§1, `stack-detection.md`), a route loads:\n443: \n444: - the always-loaded `DEFAULT_RESOURCE` preamble (stack/phase detection and the universal quality baseline), plus\n445: - the `shared/` entries the matched intents map (for example `code-quality-standards.md` under CODE_QUALITY, `workflow-debug.md` under DEBUGGING and `workflow-verify.md` under VERIFICATION), never the whole `shared/references/universal/` folder, plus\n446: - only the **detected surface's** slice (`<surface>/references/*`) for the matched intents.\n447: \n448: - It does not load another surface's resources.\n449: - It defers `assets/*` (checklists, recipes, templates) to on-demand rather than the first slice.\n450: - Within SKILLED it slices once more by the **detected language** (§1 sub-detection): a TypeScript task loads `sk-code-skilled/references/typescript/*` plus the language-agnostic `sk-code-skilled/references/shared/*`, not the Python, shell, config, or JavaScript folders.\n451: - An `UNKNOWN` surface falls back to the preamble plus the shared-tier entries its matched intents map.\n452: \n453: This is what stops a routine single-surface task from pulling the full cross-surface set. The deterministic router-replay enforces the same rule, so the benchmark measures it.\n454: \n455: ---\n456: \n457: ## 9. HOW TO READ THIS\n458: \n459: - Every code task first loads the always-on preamble (stack + phase detection and the universal quality baseline); routing then narrows to the detected surface's slice for the matched intents.\n460: - One dominant intent on one surface loads that surface's slice; two near-tied intents (within the router's ambiguity delta) load both intent sets, deduped by canonical pair.\n461: - A single-surface task never pulls another surface's resources.\n462: - No keyword match, or an `UNKNOWN` surface, falls back to the preamble plus the shared-tier entries its matched intents map — confirm the surface and intent before loading more. See §6 (UNKNOWN FALLBACK) and §7 (LOADING DISCIPLINE) for the full rules.\n463: \n464: ---\n465: \n466: ## 10. RELATED RESOURCES\n467: \n468: - [`stack-detection.md`](shared/references/stack-detection.md): surface detection (a declared specific surface, then the SKILLED fallback, then UNKNOWN) + SKILLED language sub-detection\n469: - [`phase-detection.md`](shared/references/phase-detection.md) — Phase 1/2/3 lifecycle and per-phase resource loading\n470: - `SKILL.md` §2 SMART ROUTING — names the routing authority split and the compiled front door\n471: - Barter equivalent: `barter/.skilled/skills/sk-code/shared/references/smart-routing.md` (different routing key — git-remote project — but same structural pattern)\n472: \n473: ---\n474: \n475: ## 11. MACHINE ROUTER\n476: \n477: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 8 stays the only replay source.\n478: \n479: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n480: > ```bash\n481: > node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"\n482: > ```\n483: > Follow the returned decision: `route` (use its `targets`), `clarify`/`defer` (disambiguate) or `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-code`. Set `SPECKIT_COMPILED_ROUTING=0`, the explicit kill-switch, to force legacy routing fleet-wide.\n484: \n485: **Session surface hint.** Before you call the front door, run the surface detection in [`stack-detection.md`](shared/references/stack-detection.md) on the session's working directory and the files it is editing.\n486: Then add its result as `--surface-hint <SURFACE>`, for example `--surface-hint SKILLED`.\n487: When the prompt's keywords tie between surfaces, a hinted specific surface leads them.\n488: Workflow modes keep first place, and the targets and the bundle kind stay the same.\n489: `SKILLED` is the fallback surface and always ranks last, so a `SKILLED` hint changes nothing.\n490: With `UNKNOWN`, no hint or a surface the prompt did not match, the `routerPolicy.tieBreak` order applies.\n491: \n492: ### Surface Router: per-intent leaf sets\n493: \n494: Root `ROUTER.md` owns the second-stage `INTENT_SIGNALS` / `RESOURCE_MAP`, while packet-owned resources stay typed through `leaf-manifest.json`.\n495: The hub-level shared controls are declared once, in `ROUTER.md` §8: the `SHARED_CONTROL_RESOURCES` list plus the always-loaded `DEFAULT_RESOURCE` preamble. They resolve on disk but never project as leaves.\n496: The hub router keeps stage-one mode selection and its `shared/README.md` fallback.\n497: \n498: ### The discriminator\n499: - **`workflowMode`** - the public mode/packet key: `sk-code-quality`, `sk-code-review` (workflow) or `sk-code-ci`, `sk-code-frontend`, `sk-code-skilled` (surface).\n500: - **`packetKind`** - the axis: `workflow` (a mode that acts) or `surface` (read-only evidence bundled alongside a mode).\n501: - **`backendKind`** - which backend runs the packet: `surface-router` or `review-cache` for workflow modes, `evidence-base` for surface packets.\n502: \n503: Surface packets are advisor-invisible (`routingClass: metadata`, read-only `toolSurface`).\n504: The advisor still routes the single identity `sk-code`, and the hub bundles zero-or-more surfaces as evidence via `routerPolicy.outcomes.surfaceBundle`.\n505: The workflow mode comes first, followed by surfaces.\n506: \"review my typescript module for jank\" → `[sk-code-review, sk-code-skilled]`.\n507: Bundled surfaces follow the `routerPolicy.tieBreak` order. It ranks `sk-code-frontend` ahead of `sk-code-ci`, then `sk-code-skilled` last, because a new surface goes ahead of the existing ones and the SKILLED fallback stays last.\n508: \n509: ### Surface detection\n510: \n511: Surface detection lives once in the hub's `shared/` layer and every mode and surface consumes it.\n512: It tries every declared specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n513: When a specific surface and `SKILLED` both match, the specific one leads and `SKILLED` comes along as second evidence.\n514: Each surface declares its markers in a `surfaceDetection` block in `mode-registry.json`, or in its own `graph-metadata.json` when it lives outside the hub.\n515: Modes own workflow contracts, not surface identity.\n516: `sk-code-ci` and `sk-code-frontend` are the surfaces that stack detection does not select. The hub bundles both from request vocabulary alone: CI through `code-ci-aliases` and `code-ci-runtime`, and Frontend through `code-frontend-aliases` in `hub-router.json`.\n517: \n518: ### Fallback route\n519: \n520: When no workflow mode dominates (a bare implement/debug/verify request), the router defers to a pure surface bundle: it detects the surface, loads that surface's evidence and workflow doctrine, and the agent acts. `routerPolicy.defaultMode` is `null`, so the hub does not force a stale default. An unclear code intent asks for disambiguation.\n521: \n522: Per-mode behavior is **not flattened**: each packet keeps its own code-work contract, standards, evidence rules, and tool-permission guards.\n523: \n524: ### Routing rule\n525: ```python\n526: from pathlib import Path\n527: \n528: SKILL_ROOT = Path(__file__).resolve().parent\n529: UNKNOWN_FALLBACK_CHECKLIST = [\n530:     \"Confirm whether this is sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend or sk-code-skilled work\",\n531:     \"Confirm the target files or runtime surface\",\n532:     \"Confirm the expected action: implement, debug, verify, quality gate, or review\",\n533:     \"Confirm the verification command set before completion\",\n534: ]\n535: \n536: def _guard_in_skill(relative_path: str) -> str:\n537:     resolved = (SKILL_ROOT / relative_path).resolve()\n538:     resolved.relative_to(SKILL_ROOT)\n539:     if resolved.name != \"SKILL.md\" and resolved.suffix.lower() != \".md\":\n540:         raise ValueError(f\"Only markdown skill resources are routable: {relative_path}\")\n541:     return resolved.relative_to(SKILL_ROOT).as_posix()\n542: \n543: def load_if_available(relative_path: str, loaded: list[str], seen: set[str]) -> None:\n544:     guarded = _guard_in_skill(relative_path)\n545:     path = SKILL_ROOT / guarded\n546:     if path.exists() and guarded not in seen:\n547:         load(guarded)\n548:         loaded.append(guarded)\n549:         seen.add(guarded)\n550: \n551: def route(task):\n552:     loaded, seen = [], set()\n553:     registry = read_json(SKILL_ROOT / \"mode-registry.json\")\n554:     workflow_mode = explicit_mode_hint(task) or classify_workflow_mode(task)\n555: \n556:     if not workflow_mode:\n557:         load_if_available(\"shared/README.md\", loaded, seen)\n558:         return {\n559:             \"load_level\": \"UNKNOWN_FALLBACK\",\n560:             \"needs_disambiguation\": True,\n561:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n562:             \"resources\": loaded,\n563:         }\n564: \n565:     entry = find_registry_entry(registry, workflowMode=workflow_mode)\n566:     if not entry:\n567:         load_if_available(\"shared/README.md\", loaded, seen)\n568:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"unknown_mode\": workflow_mode, \"resources\": loaded}\n569: \n570:     packet_skill = f\"{entry['packet']}/SKILL.md\"\n571:     load_if_available(packet_skill, loaded, seen)\n572: \n573:     for surface_mode in surface_bundle_from_hub_router(task):\n574:         surface_entry = find_registry_entry(registry, workflowMode=surface_mode)\n575:         if surface_entry:\n576:             load_if_available(f\"{surface_entry['packet']}/SKILL.md\", loaded, seen)\n577: \n578:     if not loaded:\n579:         load_if_available(\"shared/README.md\", loaded, seen)\n580:         return {\"load_level\": \"UNKNOWN_FALLBACK\", \"notice\": \"matched registry but no packet SKILL.md was available\", \"resources\": loaded}\n581: \n582:     return {\"workflowMode\": workflow_mode, \"backendKind\": entry[\"backendKind\"], \"resources\": loaded}\n583: ```"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/ROUTER.md\"}"},"time":{"start":1794582796138,"end":1794582797619}}}}
{"type":"tool_use","timestamp":1794582797626,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d5785cfd0017mwjD7C96BuH1J","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578445e001E8nsbhhL1Wr8sP","type":"tool","id":"chatcmpl-tool-93f838c70f4b1091","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/SKILL.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/SKILL.md, lines 1-349\n1: ---\n2: name: sk-create-skill\n3: description: Scaffold OpenCode skills and two-axis sk-doc parent hubs, including standalone, nested workflow, and surface packets.\n4: allowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\n5: version: 1.16.0.0\n6: ---\n7: \n8: # Create Skill\n9: \n10: `create-skill` is the skill-authoring workflow packet of the `sk-doc` parent hub. It owns standalone OpenCode skill scaffolding and parent-hub scaffolding through two workflow modes: `create-skill` and `create-skill-parent`.\n11: \n12: ---\n13: \n14: ## 1. WHEN TO USE\n15: \n16: ### Activation Triggers\n17: \n18: Use this packet when the request involves:\n19: - Creating or rebuilding an OpenCode skill under `.skilled/skills/`.\n20: - Running `/create:skill` for a standalone skill with its own advisor identity.\n21: - Running `/create:skill-parent` for a parent hub with nested workflow or surface packets.\n22: - Authoring or repairing `SKILL.md`, `README.md`, `references/`, `assets/`, `scripts/`, or `changelog/` for a skill package.\n23: - Creating parent-hub router files such as `mode-registry.json`, `hub-router.json`, `description.json`, or hub-level `graph-metadata.json`.\n24: - Validating and packaging a skill with `scripts/package_skill.py`.\n25: \n26: Keyword triggers: `create skill`, `/create:skill`, `/create:skill-parent`, `new skill`, `skill scaffold`, `SKILL.md scaffold`, `OpenCode skill`, `sk-skill`, `create sk-`, `reusable capability`, `reusable helper`, `starter reference docs`, `parent skill`, `parent hub`, `mode packet`, `nested workflow packet`, `package skill`.\n27: \n28: ### When NOT to Use\n29: \n30: Use another `sk-doc` packet when:\n31: - The user asks for agent scaffolding, command scaffolding, README creation, benchmark packages, feature catalogs, manual testing playbooks, flowcharts, or changelogs. Use `create-agent`, `create-command`, `create-readme`, `create-benchmark`, `create-feature-catalog`, `create-manual-testing-playbook`, `create-flowchart`, or `create-changelog`.\n32: - The task audits, validates, scores, or optimizes an existing skill document without authoring or rebuilding the skill. Use `create-quality-control`.\n33: - The task is application code implementation. Route to `sk-code`.\n34: - The user only needs conceptual advice and no artifact authoring or validation.\n35: \n36: ### Packet Boundary\n37: \n38: This packet may create and edit skill artifacts. It does not own the sk-doc hub identity, and this nested workflow packet must not carry its own `graph-metadata.json`.\n39: \n40: ---\n41: \n42: ## 2. SMART ROUTING\n43: \n44: The `sk-doc` hub routes skill-authoring requests here: a request to create, rebuild or repair a skill or a parent hub, and the hub's `sk-create-skill` or `sk-create-skill-parent` signal selects this packet.\n45: Choose `create-skill` for one skill with one advisor identity and one runtime contract, and `create-skill-parent` for one advisor-routable hub that dispatches to nested workflow or surface packets.\n46: Ask one focused clarification before authoring when that choice is unclear.\n47: \n48: `references/README.md` is the route map, and the fallback when the mode is unclear.\n49: A resolved mode loads the `references/shared/` set first, then its own `references/<key>/` and `assets/<key>/` trees.\n50: \n51: Read [`ROUTER.md`](./ROUTER.md) before selecting skill-local resources; open only the matched files.\n52: \n53: ---\n54: \n55: ## 3. HOW IT WORKS\n56: \n57: ### Standalone Skill Creation Workflow\n58: \n59: Follow these steps in order, skipping only when the target skill already exists and the skipped step is plainly not applicable.\n60: \n61: 1. Understand the skill through concrete examples.\n62: 2. Identify direct user examples or generate examples and validate them with the user when needed.\n63: 3. Clarify the skill purpose, trigger phrases, output contract, tool needs, and boundaries.\n64: 4. Ask only the most important missing questions first; conclude this step when the supported functionality is clear.\n65: 5. Plan reusable skill contents before writing final instructions.\n66: 6. For each expected use case, decide whether repeated work belongs in `scripts/`, `references/`, or `assets/`.\n67: 7. Put deterministic or repeatedly rewritten code in `scripts/`.\n68: 8. Put domain knowledge, schemas, policies, workflows, and detailed guidance in `references/`.\n69: 9. Put templates, boilerplate, images, or output resources in `assets/`.\n70: 10. Put a private, triggerable procedure in `references/procedures/` using `assets/skill/skill-procedure-template.md` when the skill has multiple distinct, individually-selected internal processes rather than one dominant workflow.\n71: 11. Scaffold a new skill when creating a new folder with `scripts/init_skill.py <skill-name> --path <output-directory>`.\n72: 12. Normalize generated files to this repo's section order after scaffolding.\n73: 13. Delete generated example files and directories that the final skill does not need.\n74: 14. Create reference markdown from `assets/skill/skill-reference-template.md`.\n75: 15. Create asset markdown from `assets/skill/skill-asset-template.md`.\n76: 16. When work creates or reshapes a runtime config dir (`.claude/`, `.codex/`, `.cursor/`, `.devin/`, `.pi/`, or a new runtime), author or update that dir's `SYNC.md` from `assets/skill/skill-sync-manifest-template.md` and cross-link it from every sibling manifest.\n77: 17. Use kebab-case for generated filesystem names in `references/`, `assets/`, and other authored resource trees. Keep Python filenames, Python import-package directories, and tool-mandated names such as `SKILL.md` and `README.md` unchanged.\n78: 18. Create `README.md` from `assets/skill/skill-readme-template.md` when operators need quick start, examples, troubleshooting, or a package map.\n79: 19. Author `SKILL.md` as the executable runtime contract, not as a link farm.\n80: 20. Keep `WHEN TO USE` limited to activation triggers, use cases, keyword triggers, and when-not-to-use boundaries.\n81: 21. Summarize resource selection in `SMART ROUTING`, and put the detection signals, resource domains, loading levels and smart-router pseudocode in the sibling `ROUTER.md`.\n82: 22. Put the ordered execution path and decision points in `HOW IT WORKS`.\n83: 23. Put required actions, forbidden actions, and escalation conditions in `RULES`.\n84: 24. Put completion checks in `SUCCESS CRITERIA`.\n85: 25. Put references only as overflow pointers for deep detail, examples, or schemas.\n86: 26. Run `node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs --fix` after authoring so the manifest and derived aliases are generated and the root passes its class gate.\n87: 27. Replace every slug-only routing default before calling the skill done: `graph-metadata.json` `domains` and `intent_signals` plus the `SKILL.md` keyword comment are the fields the advisor's scorers actually read, so fill them with phrases a user would genuinely type, not the skill name repeated.\n88: 28. Confirm advisor discovery.\n89:    A warm advisor daemon ingests a new root automatically, because its watcher watches the skills root for new top-level directories.\n90:    With no daemon running, the next daemon start ingests it.\n91:    Manual refresh: `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted`.\n92:    Smoke-test routing with `node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<a phrase from your intent signals>\"}' --warm-only --format json` and confirm your skill appears in the recommendations.\n93: 29. Run `scripts/validate_skill_package.py <path/to/skill-folder> --strict` before claiming the skill is complete.\n94: 30. Fix every hard failure and rerun the check until it exits clean.\n95: 31. Package only after validation passes with `scripts/package_skill.py <path/to/skill-folder> <output-directory>`.\n96: 32. Iterate after real usage by improving unclear instructions, adding missing resources, trimming bloated `SKILL.md` content into references, and improving trigger descriptions.\n97: \n98: ### Required Standalone Skill Shape\n99: \n100: ```text\n101: skill-name/\n102: ├── SKILL.md\n103: ├── ROUTER.md                      # sibling machine router\n104: ├── graph-metadata.json\n105: ├── leaf-manifest.config.json\n106: ├── leaf-scopes.json                # optional: narrows the leaf roots to scopes\n107: ├── command-metadata.json           # optional: only when the skill owns slash commands\n108: ├── leaf-manifest.json              # generated\n109: ├── leaf-aliases.json               # generated identity projection\n110: ├── README.md\n111: ├── references/\n112: ├── assets/\n113: ├── scripts/\n114: ├── manual-testing-playbook/          # the scenario corpus — an input\n115: │   └── manual-testing-playbook.md    # the index; per-feature files in category folders\n116: └── benchmark/                        # what running that corpus produced — output\n117:     ├── README.md                     # layout and how to run\n118:     └── reports/\n119:         ├── README.md                 # run index, appended by the harness\n120:         └── <YYYY-MM-DD>--<subject>--<variant>/\n121: ```\n122: \n123: `SKILL.md` is the root marker. Root JSON requirements are class-specific; the complete authored/generated matrix is [skill-root-metadata-contract.md](references/shared/skill-root-metadata-contract.md). `README.md`, `references/`, `assets/`, and `scripts/` are optional only when they are genuinely unnecessary.\n124: \n125: A standalone skill is class **S** under the root-metadata contract, so beyond `graph-metadata.json` it authors `leaf-manifest.config.json` and generates the rest.\n126: That file names its single workflow mode and leaf roots.\n127: `leaf-scopes.json` is the optional second authored metadata file: it narrows those roots for the root's single workflow mode, to a subtree or a single doc, when a configured root also holds runtime code or only some of its docs are routable.\n128: The generator reads it on both the hub and the standalone path, and falls back to its default walk when it is absent, so a root without one needs no change.\n129: A scope must stay under one of the root's declared leaf roots, and the mode it names must be one the root declares, so `OUT_OF_ROOT_LEAF_SCOPE` and `ORPHAN_LEAF_SCOPE_MODE` fail the manifest instead of widening it.\n130: Required, forbidden, and generated-versus-authored rules for every root JSON live in [`references/shared/skill-root-metadata-contract.md`](references/shared/skill-root-metadata-contract.md).\n131: Do not infer them from a sibling skill.\n132: \n133: The last two directories are a pair: `manual-testing-playbook/` holds the corpus a run reads, and\n134: `benchmark/` holds what the run wrote. Keeping them apart is what lets a run be re-executed against\n135: the same scenarios later and compared, so neither one is optional once a skill is benchmarked.\n136: \n137: The scaffolder creates both. Their interiors are owned elsewhere and are not restated here:\n138: [`create-benchmark`](../sk-create-benchmark/SKILL.md) owns the run-folder grammar, the report file set\n139: and the index shape; [`create-manual-testing-playbook`](../sk-create-manual-testing-playbook/SKILL.md)\n140: owns the corpus layout and the results-storage contract. Consult those rather than inferring the rules\n141: from an example.\n142: \n143: ### SKILL.md Frontmatter Contract\n144: \n145: Every `SKILL.md` must include:\n146: - `name`: lowercase hyphen-case and matching the folder name.\n147: - `description`: single-line, specific, non-placeholder routing description.\n148: - `allowed-tools`: YAML array format such as `[Read, Write, Edit, Bash, Grep, Glob]`.\n149: - `version`: four-part `X.Y.Z.W`.\n150: \n151: Every authored `references/*.md` and markdown asset should carry the full reference/asset frontmatter block from the packet templates, including `version`. `README.md` is exempt from the full reference block but still uses the README template frontmatter.\n152: \n153: ### Parent Hub Creation Workflow\n154: \n155: Use the parent-hub path when one public skill identity must dispatch to multiple packets.\n156: \n157: 1. Confirm the hub is one advisor-routable identity, not multiple standalone skills.\n158: 2. Keep the hub routing-only; nested packets own detailed workflows, evidence, examples, tool boundaries, and validation.\n159: 3. Ask whether the generated state must be `legacy` or `ready`; do not silently choose in the authoring workflow. Existing CLI calls remain backward-compatible and default to `legacy`.\n160: 4. Scaffold the selected state with `scripts/init_skill.py <hub-name> --path <parent-directory> --kind parent --compiled-routing legacy|ready`.\n161: 5. Create the hub root with `SKILL.md`, `mode-registry.json`, `hub-router.json`, root `ROUTER.md`, `description.json`, `graph-metadata.json`, and generated `leaf-manifest.json`, plus `changelog/`, `manual-testing-playbook/`, and `benchmark/`. Add `command-metadata.json` only when the hub owns slash commands; when present, it has one entry per owned command.\n162: 6. `init_skill.py --kind parent` always emits the root `ROUTER.md` with `router_state: stage1-only`: empty stage-two maps and a root `SKILL.md` pointer.\n163:    Keep it `stage1-only` until a concrete leaf map is authored.\n164:    Only then replace `router_state` with `active` and add non-empty equal-key `INTENT_SIGNALS`/`RESOURCE_MAP` whose paths resolve and map to typed `leaf-manifest.json` pairs.\n165:    Never synthesize placeholder intents.\n166: 7. Create each nested packet with `SKILL.md`, `README.md`, its own `ROUTER.md`, and `changelog/`.\n167: 8. Add `references/` and `assets/` to surface packets when they carry evidence material.\n168: 9. Give a workflow packet its own `procedures/` folder, using `assets/skill/skill-procedure-template.md`, when it has multiple distinct, individually-triggered internal processes; use `shared/procedures/` only for a card that genuinely coordinates two or more packets.\n169: 10. Do not add `graph-metadata.json` to nested workflow packets or surface packets.\n170: 11. Define every packet in one `mode-registry.json > modes[]` array.\n171: 12. Use `packetKind: \"workflow\"` for lifecycle or process packets.\n172: 13. Use `packetKind: \"surface\"` for read-only evidence packets.\n173: 14. For every `modes[]` entry, define `workflowMode`, `packetKind`, `backendKind`, `toolSurface`, `packet`, `packetSkillName`, `grandfatheredFolderMismatch`, `aliases`, and `advisorRouting`.\n174: 15. Keep `folder == packetSkillName` for all new packets.\n175: 16. Set `grandfatheredFolderMismatch: false` unless preserving an existing mismatch.\n176: 17. Keep aliases unique across all modes.\n177: 18. Put all workflow and surface packets in `modes[]`; never create a second array such as `surfacePackets[]`.\n178: 19. Create `hub-router.json` with `routerPolicy`, `routerSignals`, and `vocabularyClasses`.\n179: 20. Ensure `routerSignals` keys match `mode-registry.json > modes[].workflowMode` exactly.\n180: 21. Ensure `routerPolicy.tieBreak` lists every registry mode once, with workflow modes before surface packets.\n181: 22. Ensure router outcomes include the base three `single`, `orderedBundle`, and `defer`; add `surfaceBundle` only when the hub has surface packets (`surface-axis`).\n182: 23. Ensure all router resources are hub-root-relative, packet-qualified paths that resolve on disk.\n183: 24. Use named `extensions` only when real routing semantics require them; do not add extra directory tiers for extensions.\n184: 25. Treat `legacy (no manifest)` as complete only when no canonical manifest was emitted. For `ready`, the initializer calls `compiled-route-manifest.cjs mint` after the final router inputs exist and then calls `freshness` against the same hub root.\n185: 26. Accept `compiled-ready (fresh manifest verified)` only from a valid, fresh canonical result. A missing minter, failed mint, malformed manifest, or stale manifest is a failed generation and retains legacy fallback; never synthesize a digest or author an activation manifest.\n186: 27. Confirm the finished hub conforms to class **H** of the root-metadata contract with `node scripts/ci-skill-root-metadata.cjs --fix`, then rerun `node scripts/ci-skill-root-metadata.cjs` to prove cleanliness.\n187:    Declaring `mode-registry.json` and `hub-router.json` is what makes a root a hub.\n188:    Declaring only one of them is a half-written declaration the gate rejects.\n189:    Required, forbidden, and generated-versus-authored rules are in [`references/shared/skill-root-metadata-contract.md`](references/shared/skill-root-metadata-contract.md).\n190: 28. Replace every slug-only routing default with phrases a user would genuinely type.\n191:    The advisor's scorers read SKILL.md `keywords`, graph-metadata.json `domains` and `intent_signals`, and per-mode registry aliases.\n192:    No scorer reads `description.json`, so keywords placed only there do not move a route.\n193:    For a hub, `node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-router-intent-signals.cjs --write --hub <hub>` carries the ROUTER.md intent vocabulary into `intent_signals`.\n194: 29. Confirm advisor discovery.\n195:    A warm advisor daemon ingests a new hub automatically, because its watcher watches the skills root for new top-level directories.\n196:    With no daemon running, the next start ingests it.\n197:    Manual refresh: `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted`.\n198:    Smoke-test with `node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<a phrase from your intent signals>\"}' --warm-only --format json`.\n199: \n200: ### Parent Hub Shape\n201: \n202: ```text\n203: parent-hub/\n204: ├── SKILL.md\n205: ├── README.md\n206: ├── mode-registry.json\n207: ├── hub-router.json\n208: ├── ROUTER.md                   # stage-two control; stage1-only on a fresh scaffold\n209: ├── description.json\n210: ├── graph-metadata.json\n211: ├── command-metadata.json          # optional; only when the hub owns slash commands\n212: ├── leaf-manifest.json              # generated\n213: ├── changelog/\n214: ├── manual-testing-playbook/          # the scenario corpus — an input\n215: │   └── manual-testing-playbook.md    # the index; per-feature files in category folders\n216: ├── benchmark/                        # what running that corpus produced — output\n217: │   ├── README.md                     # layout and how to run\n218: │   └── reports/\n219: │       ├── README.md                 # run index, appended by the harness\n220: │       └── <YYYY-MM-DD>--<subject>--<variant>/\n221: ├── workflow-packet/\n222: │   ├── SKILL.md\n223: │   ├── ROUTER.md\n224: │   ├── README.md\n225: │   ├── procedures/       (optional - only if the packet has multiple distinct, triggered procedures)\n226: │   └── changelog/\n227: └── surface-packet/\n228:     ├── SKILL.md\n229:     ├── ROUTER.md\n230:     ├── README.md\n231:     ├── references/\n232:     ├── assets/\n233:     └── changelog/\n234: ```\n235: \n236: Class-H root metadata follows the [skill-root-metadata-contract.md](references/shared/skill-root-metadata-contract.md) matrix, including authored versus generated files.\n237: \n238: A packet may carry its own `benchmark/` in the same shape when it is measured separately from its\n239: hub. The corpus/output pairing and the owning-skill references described under the standalone shape\n240: apply identically here.\n241: \n242: ### Validation And Packaging Gate\n243: \n244: Run the completion gate before any completion claim:\n245: \n246: ```bash\n247: scripts/validate_skill_package.py <path/to/skill-folder> --strict\n248: ```\n249: \n250: It auto-detects skill kind — standalone skills run the package check; parent hubs additionally run the parent-hub structural check and the canonical manifest freshness check. A missing manifest reports the valid legacy state; a valid fresh manifest reports compiled-ready; malformed or stale manifests fail validation.\n251: \n252: `--check` hard-fails on missing SKILL frontmatter or required fields, non-four-part versions, folder/name mismatches, missing required sections, malformed names, and descriptions that are missing, multiline, or contain angle brackets.\n253: Generated package paths that are not kebab-case remain advisory during a debt-tolerant `--check`.\n254: `--strict` and actual packaging promote them to blocking errors.\n255: Python filenames, Python import-package directories, frozen/generated subtrees, and tool-mandated names are exempt.\n256: \n257: Use structure extraction when quality evidence is needed:\n258: \n259: ```bash\n260: ../shared/scripts/extract_structure.py <path/to/skill/SKILL.md>\n261: ```\n262: \n263: Package only after validation passes:\n264: \n265: ```bash\n266: scripts/package_skill.py <path/to/skill-folder> <output-directory>\n267: ```\n268: \n269: ---\n270: \n271: ## 4. RULES\n272: \n273: ### ✅ ALWAYS\n274: \n275: 1. Read existing target skill or hub files before editing them.\n276: 2. Select `create-skill` or `create-skill-parent` before authoring.\n277: 3. Build the skill for another AI agent instance to execute; include information that is beneficial and non-obvious.\n278: 4. Use local templates under `assets/skill/` rather than inventing file shapes from memory.\n279: 5. Keep `SKILL.md` within the Size Limits table in `assets/skill/skill-md-template.md` and focused on activation, routing, core workflow, rules, and success criteria.\n280: 6. Move deep examples, schemas, edge cases, and long guidance into `references/`.\n281: 7. Keep `WHEN TO USE` free of file references and navigation tables.\n282: 8. Keep one authoritative routing source in `SMART ROUTING`.\n283: 9. Delete TODO placeholders and generated example files before validation.\n284: 10. Run `scripts/validate_skill_package.py <path> --strict` before calling the scaffold complete.\n285: 11. Use `assets/skill/skill-procedure-template.md` for a private, triggerable internal procedure; use `assets/skill/skill-reference-template.md` when no trigger-based selection is needed.\n286: \n287: ### ⛔ NEVER\n288: \n289: 1. Never defer the core executable creation workflow out of `SKILL.md`.\n290: 2. Never create multiple advisor identities when the requested artifact is a parent hub.\n291: 3. Never add `graph-metadata.json` to a nested workflow or surface packet.\n292: 4. Never add `surfacePackets[]` or another parallel registry array.\n293: 5. Never create new folder/name mismatches for convenience.\n294: 6. Never use multiline YAML descriptions in skill frontmatter.\n295: 7. Never leave angle-bracket placeholders, TODO text, or generic descriptions in shipped artifacts.\n296: 8. Never claim automatic platform behavior that OpenCode does not provide; document manual verification instead.\n297: 9. Never package or distribute a skill before validation passes.\n298: 10. Never broaden into unrelated sk-doc artifact types.\n299: \n300: ### ⚠️ ESCALATE IF\n301: \n302: 1. It is unclear whether the target should be a standalone skill or parent hub.\n303: 2. Tool permissions, mutation authority, or advisor identity boundaries are ambiguous.\n304: 3. Existing folder names conflict with required `name` or `packetSkillName` rules.\n305: 4. A parent hub needs routing semantics beyond the core two-tier model.\n306: 5. Validation fails for reasons that would require changing the public contract.\n307: \n308: ---\n309: \n310: ## 5. SUCCESS CRITERIA\n311: \n312: - The correct workflow mode was selected: `create-skill` or `create-skill-parent`.\n313: - Concrete trigger examples, boundaries, tool needs, and output contracts are reflected in the artifact.\n314: - Standalone skills contain valid frontmatter, executable `SKILL.md` workflow content, useful resources, and no placeholder examples.\n315: - Parent hubs contain one hub identity, one `modes[]` registry, valid router metadata, one root `ROUTER.md` in a valid `stage1-only` or `active` state, and nested packets without packet-local graph metadata.\n316: - Generated resource paths use kebab-case, with Python and tool-mandated names preserved exactly.\n317: - `scripts/validate_skill_package.py <path> --strict` exits clean, or exact blockers are reported.\n318: - Shared create-quality-control standards from `../shared` were applied when quality evidence was needed.\n319: \n320: ---\n321: \n322: ## 6. REFERENCES\n323: \n324: Use these only for overflow detail, exhaustive examples, or schema checks beyond the core workflow above.\n325: \n326: - `references/README.md` - route map for the full reference set.\n327: - `references/shared/overview.md` - deeper anatomy, layered-doc structure, and resource placement guidance.\n328: - `references/skill/creation-workflow.md` - expanded examples for the six-step standalone workflow.\n329: - `references/skill/upgrading-a-skill-to-v4.md` - adopter guide for reconciling a customized skill to the v4 parent-hub format (convert-vs-keep-single decision, single→parent procedure, sk-code/sk-git cases).\n330: - `references/shared/validation-and-packaging.md` - detailed validation, packaging, and distribution notes.\n331: - `references/shared/skill-root-metadata-contract.md` - the per-class root JSON matrix, authored versus generated ownership, and the optional authored `leaf-scopes.json` that narrows a root's leaf roots to subtrees or single docs.\n332: - `references/shared/common-pitfalls.md` - examples of recurring trigger, YAML, style, and context-budget defects.\n333: - `references/parent-skill/parent-skills-nested-packets.md` - detailed parent-hub and nested-packet model.\n334: - `references/parent-skill/parent-hub-router-schema.md` - full router and registry schema.\n335: - `references/parent-skill/compiled-routing-architecture.md` - which hubs the compiled router serves, the shadow-child-to-cohort chain, and why `--compiled-routing ready` mints onboarding evidence, not compiled-serving.\n336: - `assets/skill/skill-md-template.md` - standalone skill SKILL.md template.\n337: - `assets/skill/skill-readme-template.md` - skill README template.\n338: - `assets/skill/skill-reference-template.md` - reference markdown template.\n339: - `assets/skill/skill-asset-template.md` - asset markdown template.\n340: - `assets/skill/skill-smart-router.md` - resilient smart-router pattern.\n341: - `assets/skill/skill-router-template.md` - sibling `ROUTER.md` template for a standalone skill or mode packet.\n342: - `assets/skill/skill-procedure-template.md` - private procedure card templates and guidelines.\n343: - `assets/parent-skill/parent-skill-*` - parent hub templates.\n344: - `scripts/init_skill.py` - standalone skill scaffold helper.\n345: - `scripts/package_skill.py` - validation and packaging helper.\n346: - `scripts/leaf-route-replay.cjs` - zero-call stage-two keyword replay and read recount. It scores the `ROUTER.md` keyword block against the committed gold scenarios. `--transcripts` recounts reads and `--prose` compares the prose arm.\n347: - `.skilled/commands/doctor/sk-skill.md` - the `/doctor:sk-skill` router outside this packet. Its `check` target reports how far one skill, or the whole fleet, is from this format row by row, or `--into-hub <hub>` reports the eleven surfaces a skill or mode still needs under that hub, and its `convert` target converts an older Skilled skill in place or a plain agent skill into a class S standalone root after a plan and a yes. Both are read-only until `convert` receives `--apply`.\n348: - `../shared/references/core-standards.md` - shared markdown standards.\n349: - `../shared/references/validation.md` - shared validation workflow.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/SKILL.md, lines 1-349\n1: ---\n2: name: sk-create-skill\n3: description: Scaffold OpenCode skills and two-axis sk-doc parent hubs, including standalone, nested workflow, and surface packets.\n4: allowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\n5: version: 1.16.0.0\n6: ---\n7: \n8: # Create Skill\n9: \n10: `create-skill` is the skill-authoring workflow packet of the `sk-doc` parent hub. It owns standalone OpenCode skill scaffolding and parent-hub scaffolding through two workflow modes: `create-skill` and `create-skill-parent`.\n11: \n12: ---\n13: \n14: ## 1. WHEN TO USE\n15: \n16: ### Activation Triggers\n17: \n18: Use this packet when the request involves:\n19: - Creating or rebuilding an OpenCode skill under `.skilled/skills/`.\n20: - Running `/create:skill` for a standalone skill with its own advisor identity.\n21: - Running `/create:skill-parent` for a parent hub with nested workflow or surface packets.\n22: - Authoring or repairing `SKILL.md`, `README.md`, `references/`, `assets/`, `scripts/`, or `changelog/` for a skill package.\n23: - Creating parent-hub router files such as `mode-registry.json`, `hub-router.json`, `description.json`, or hub-level `graph-metadata.json`.\n24: - Validating and packaging a skill with `scripts/package_skill.py`.\n25: \n26: Keyword triggers: `create skill`, `/create:skill`, `/create:skill-parent`, `new skill`, `skill scaffold`, `SKILL.md scaffold`, `OpenCode skill`, `sk-skill`, `create sk-`, `reusable capability`, `reusable helper`, `starter reference docs`, `parent skill`, `parent hub`, `mode packet`, `nested workflow packet`, `package skill`.\n27: \n28: ### When NOT to Use\n29: \n30: Use another `sk-doc` packet when:\n31: - The user asks for agent scaffolding, command scaffolding, README creation, benchmark packages, feature catalogs, manual testing playbooks, flowcharts, or changelogs. Use `create-agent`, `create-command`, `create-readme`, `create-benchmark`, `create-feature-catalog`, `create-manual-testing-playbook`, `create-flowchart`, or `create-changelog`.\n32: - The task audits, validates, scores, or optimizes an existing skill document without authoring or rebuilding the skill. Use `create-quality-control`.\n33: - The task is application code implementation. Route to `sk-code`.\n34: - The user only needs conceptual advice and no artifact authoring or validation.\n35: \n36: ### Packet Boundary\n37: \n38: This packet may create and edit skill artifacts. It does not own the sk-doc hub identity, and this nested workflow packet must not carry its own `graph-metadata.json`.\n39: \n40: ---\n41: \n42: ## 2. SMART ROUTING\n43: \n44: The `sk-doc` hub routes skill-authoring requests here: a request to create, rebuild or repair a skill or a parent hub, and the hub's `sk-create-skill` or `sk-create-skill-parent` signal selects this packet.\n45: Choose `create-skill` for one skill with one advisor identity and one runtime contract, and `create-skill-parent` for one advisor-routable hub that dispatches to nested workflow or surface packets.\n46: Ask one focused clarification before authoring when that choice is unclear.\n47: \n48: `references/README.md` is the route map, and the fallback when the mode is unclear.\n49: A resolved mode loads the `references/shared/` set first, then its own `references/<key>/` and `assets/<key>/` trees.\n50: \n51: Read [`ROUTER.md`](./ROUTER.md) before selecting skill-local resources; open only the matched files.\n52: \n53: ---\n54: \n55: ## 3. HOW IT WORKS\n56: \n57: ### Standalone Skill Creation Workflow\n58: \n59: Follow these steps in order, skipping only when the target skill already exists and the skipped step is plainly not applicable.\n60: \n61: 1. Understand the skill through concrete examples.\n62: 2. Identify direct user examples or generate examples and validate them with the user when needed.\n63: 3. Clarify the skill purpose, trigger phrases, output contract, tool needs, and boundaries.\n64: 4. Ask only the most important missing questions first; conclude this step when the supported functionality is clear.\n65: 5. Plan reusable skill contents before writing final instructions.\n66: 6. For each expected use case, decide whether repeated work belongs in `scripts/`, `references/`, or `assets/`.\n67: 7. Put deterministic or repeatedly rewritten code in `scripts/`.\n68: 8. Put domain knowledge, schemas, policies, workflows, and detailed guidance in `references/`.\n69: 9. Put templates, boilerplate, images, or output resources in `assets/`.\n70: 10. Put a private, triggerable procedure in `references/procedures/` using `assets/skill/skill-procedure-template.md` when the skill has multiple distinct, individually-selected internal processes rather than one dominant workflow.\n71: 11. Scaffold a new skill when creating a new folder with `scripts/init_skill.py <skill-name> --path <output-directory>`.\n72: 12. Normalize generated files to this repo's section order after scaffolding.\n73: 13. Delete generated example files and directories that the final skill does not need.\n74: 14. Create reference markdown from `assets/skill/skill-reference-template.md`.\n75: 15. Create asset markdown from `assets/skill/skill-asset-template.md`.\n76: 16. When work creates or reshapes a runtime config dir (`.claude/`, `.codex/`, `.cursor/`, `.devin/`, `.pi/`, or a new runtime), author or update that dir's `SYNC.md` from `assets/skill/skill-sync-manifest-template.md` and cross-link it from every sibling manifest.\n77: 17. Use kebab-case for generated filesystem names in `references/`, `assets/`, and other authored resource trees. Keep Python filenames, Python import-package directories, and tool-mandated names such as `SKILL.md` and `README.md` unchanged.\n78: 18. Create `README.md` from `assets/skill/skill-readme-template.md` when operators need quick start, examples, troubleshooting, or a package map.\n79: 19. Author `SKILL.md` as the executable runtime contract, not as a link farm.\n80: 20. Keep `WHEN TO USE` limited to activation triggers, use cases, keyword triggers, and when-not-to-use boundaries.\n81: 21. Summarize resource selection in `SMART ROUTING`, and put the detection signals, resource domains, loading levels and smart-router pseudocode in the sibling `ROUTER.md`.\n82: 22. Put the ordered execution path and decision points in `HOW IT WORKS`.\n83: 23. Put required actions, forbidden actions, and escalation conditions in `RULES`.\n84: 24. Put completion checks in `SUCCESS CRITERIA`.\n85: 25. Put references only as overflow pointers for deep detail, examples, or schemas.\n86: 26. Run `node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs --fix` after authoring so the manifest and derived aliases are generated and the root passes its class gate.\n87: 27. Replace every slug-only routing default before calling the skill done: `graph-metadata.json` `domains` and `intent_signals` plus the `SKILL.md` keyword comment are the fields the advisor's scorers actually read, so fill them with phrases a user would genuinely type, not the skill name repeated.\n88: 28. Confirm advisor discovery.\n89:    A warm advisor daemon ingests a new root automatically, because its watcher watches the skills root for new top-level directories.\n90:    With no daemon running, the next daemon start ingests it.\n91:    Manual refresh: `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted`.\n92:    Smoke-test routing with `node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<a phrase from your intent signals>\"}' --warm-only --format json` and confirm your skill appears in the recommendations.\n93: 29. Run `scripts/validate_skill_package.py <path/to/skill-folder> --strict` before claiming the skill is complete.\n94: 30. Fix every hard failure and rerun the check until it exits clean.\n95: 31. Package only after validation passes with `scripts/package_skill.py <path/to/skill-folder> <output-directory>`.\n96: 32. Iterate after real usage by improving unclear instructions, adding missing resources, trimming bloated `SKILL.md` content into references, and improving trigger descriptions.\n97: \n98: ### Required Standalone Skill Shape\n99: \n100: ```text\n101: skill-name/\n102: ├── SKILL.md\n103: ├── ROUTER.md                      # sibling machine router\n104: ├── graph-metadata.json\n105: ├── leaf-manifest.config.json\n106: ├── leaf-scopes.json                # optional: narrows the leaf roots to scopes\n107: ├── command-metadata.json           # optional: only when the skill owns slash commands\n108: ├── leaf-manifest.json              # generated\n109: ├── leaf-aliases.json               # generated identity projection\n110: ├── README.md\n111: ├── references/\n112: ├── assets/\n113: ├── scripts/\n114: ├── manual-testing-playbook/          # the scenario corpus — an input\n115: │   └── manual-testing-playbook.md    # the index; per-feature files in category folders\n116: └── benchmark/                        # what running that corpus produced — output\n117:     ├── README.md                     # layout and how to run\n118:     └── reports/\n119:         ├── README.md                 # run index, appended by the harness\n120:         └── <YYYY-MM-DD>--<subject>--<variant>/\n121: ```\n122: \n123: `SKILL.md` is the root marker. Root JSON requirements are class-specific; the complete authored/generated matrix is [skill-root-metadata-contract.md](references/shared/skill-root-metadata-contract.md). `README.md`, `references/`, `assets/`, and `scripts/` are optional only when they are genuinely unnecessary.\n124: \n125: A standalone skill is class **S** under the root-metadata contract, so beyond `graph-metadata.json` it authors `leaf-manifest.config.json` and generates the rest.\n126: That file names its single workflow mode and leaf roots.\n127: `leaf-scopes.json` is the optional second authored metadata file: it narrows those roots for the root's single workflow mode, to a subtree or a single doc, when a configured root also holds runtime code or only some of its docs are routable.\n128: The generator reads it on both the hub and the standalone path, and falls back to its default walk when it is absent, so a root without one needs no change.\n129: A scope must stay under one of the root's declared leaf roots, and the mode it names must be one the root declares, so `OUT_OF_ROOT_LEAF_SCOPE` and `ORPHAN_LEAF_SCOPE_MODE` fail the manifest instead of widening it.\n130: Required, forbidden, and generated-versus-authored rules for every root JSON live in [`references/shared/skill-root-metadata-contract.md`](references/shared/skill-root-metadata-contract.md).\n131: Do not infer them from a sibling skill.\n132: \n133: The last two directories are a pair: `manual-testing-playbook/` holds the corpus a run reads, and\n134: `benchmark/` holds what the run wrote. Keeping them apart is what lets a run be re-executed against\n135: the same scenarios later and compared, so neither one is optional once a skill is benchmarked.\n136: \n137: The scaffolder creates both. Their interiors are owned elsewhere and are not restated here:\n138: [`create-benchmark`](../sk-create-benchmark/SKILL.md) owns the run-folder grammar, the report file set\n139: and the index shape; [`create-manual-testing-playbook`](../sk-create-manual-testing-playbook/SKILL.md)\n140: owns the corpus layout and the results-storage contract. Consult those rather than inferring the rules\n141: from an example.\n142: \n143: ### SKILL.md Frontmatter Contract\n144: \n145: Every `SKILL.md` must include:\n146: - `name`: lowercase hyphen-case and matching the folder name.\n147: - `description`: single-line, specific, non-placeholder routing description.\n148: - `allowed-tools`: YAML array format such as `[Read, Write, Edit, Bash, Grep, Glob]`.\n149: - `version`: four-part `X.Y.Z.W`.\n150: \n151: Every authored `references/*.md` and markdown asset should carry the full reference/asset frontmatter block from the packet templates, including `version`. `README.md` is exempt from the full reference block but still uses the README template frontmatter.\n152: \n153: ### Parent Hub Creation Workflow\n154: \n155: Use the parent-hub path when one public skill identity must dispatch to multiple packets.\n156: \n157: 1. Confirm the hub is one advisor-routable identity, not multiple standalone skills.\n158: 2. Keep the hub routing-only; nested packets own detailed workflows, evidence, examples, tool boundaries, and validation.\n159: 3. Ask whether the generated state must be `legacy` or `ready`; do not silently choose in the authoring workflow. Existing CLI calls remain backward-compatible and default to `legacy`.\n160: 4. Scaffold the selected state with `scripts/init_skill.py <hub-name> --path <parent-directory> --kind parent --compiled-routing legacy|ready`.\n161: 5. Create the hub root with `SKILL.md`, `mode-registry.json`, `hub-router.json`, root `ROUTER.md`, `description.json`, `graph-metadata.json`, and generated `leaf-manifest.json`, plus `changelog/`, `manual-testing-playbook/`, and `benchmark/`. Add `command-metadata.json` only when the hub owns slash commands; when present, it has one entry per owned command.\n162: 6. `init_skill.py --kind parent` always emits the root `ROUTER.md` with `router_state: stage1-only`: empty stage-two maps and a root `SKILL.md` pointer.\n163:    Keep it `stage1-only` until a concrete leaf map is authored.\n164:    Only then replace `router_state` with `active` and add non-empty equal-key `INTENT_SIGNALS`/`RESOURCE_MAP` whose paths resolve and map to typed `leaf-manifest.json` pairs.\n165:    Never synthesize placeholder intents.\n166: 7. Create each nested packet with `SKILL.md`, `README.md`, its own `ROUTER.md`, and `changelog/`.\n167: 8. Add `references/` and `assets/` to surface packets when they carry evidence material.\n168: 9. Give a workflow packet its own `procedures/` folder, using `assets/skill/skill-procedure-template.md`, when it has multiple distinct, individually-triggered internal processes; use `shared/procedures/` only for a card that genuinely coordinates two or more packets.\n169: 10. Do not add `graph-metadata.json` to nested workflow packets or surface packets.\n170: 11. Define every packet in one `mode-registry.json > modes[]` array.\n171: 12. Use `packetKind: \"workflow\"` for lifecycle or process packets.\n172: 13. Use `packetKind: \"surface\"` for read-only evidence packets.\n173: 14. For every `modes[]` entry, define `workflowMode`, `packetKind`, `backendKind`, `toolSurface`, `packet`, `packetSkillName`, `grandfatheredFolderMismatch`, `aliases`, and `advisorRouting`.\n174: 15. Keep `folder == packetSkillName` for all new packets.\n175: 16. Set `grandfatheredFolderMismatch: false` unless preserving an existing mismatch.\n176: 17. Keep aliases unique across all modes.\n177: 18. Put all workflow and surface packets in `modes[]`; never create a second array such as `surfacePackets[]`.\n178: 19. Create `hub-router.json` with `routerPolicy`, `routerSignals`, and `vocabularyClasses`.\n179: 20. Ensure `routerSignals` keys match `mode-registry.json > modes[].workflowMode` exactly.\n180: 21. Ensure `routerPolicy.tieBreak` lists every registry mode once, with workflow modes before surface packets.\n181: 22. Ensure router outcomes include the base three `single`, `orderedBundle`, and `defer`; add `surfaceBundle` only when the hub has surface packets (`surface-axis`).\n182: 23. Ensure all router resources are hub-root-relative, packet-qualified paths that resolve on disk.\n183: 24. Use named `extensions` only when real routing semantics require them; do not add extra directory tiers for extensions.\n184: 25. Treat `legacy (no manifest)` as complete only when no canonical manifest was emitted. For `ready`, the initializer calls `compiled-route-manifest.cjs mint` after the final router inputs exist and then calls `freshness` against the same hub root.\n185: 26. Accept `compiled-ready (fresh manifest verified)` only from a valid, fresh canonical result. A missing minter, failed mint, malformed manifest, or stale manifest is a failed generation and retains legacy fallback; never synthesize a digest or author an activation manifest.\n186: 27. Confirm the finished hub conforms to class **H** of the root-metadata contract with `node scripts/ci-skill-root-metadata.cjs --fix`, then rerun `node scripts/ci-skill-root-metadata.cjs` to prove cleanliness.\n187:    Declaring `mode-registry.json` and `hub-router.json` is what makes a root a hub.\n188:    Declaring only one of them is a half-written declaration the gate rejects.\n189:    Required, forbidden, and generated-versus-authored rules are in [`references/shared/skill-root-metadata-contract.md`](references/shared/skill-root-metadata-contract.md).\n190: 28. Replace every slug-only routing default with phrases a user would genuinely type.\n191:    The advisor's scorers read SKILL.md `keywords`, graph-metadata.json `domains` and `intent_signals`, and per-mode registry aliases.\n192:    No scorer reads `description.json`, so keywords placed only there do not move a route.\n193:    For a hub, `node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-router-intent-signals.cjs --write --hub <hub>` carries the ROUTER.md intent vocabulary into `intent_signals`.\n194: 29. Confirm advisor discovery.\n195:    A warm advisor daemon ingests a new hub automatically, because its watcher watches the skills root for new top-level directories.\n196:    With no daemon running, the next start ingests it.\n197:    Manual refresh: `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted`.\n198:    Smoke-test with `node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<a phrase from your intent signals>\"}' --warm-only --format json`.\n199: \n200: ### Parent Hub Shape\n201: \n202: ```text\n203: parent-hub/\n204: ├── SKILL.md\n205: ├── README.md\n206: ├── mode-registry.json\n207: ├── hub-router.json\n208: ├── ROUTER.md                   # stage-two control; stage1-only on a fresh scaffold\n209: ├── description.json\n210: ├── graph-metadata.json\n211: ├── command-metadata.json          # optional; only when the hub owns slash commands\n212: ├── leaf-manifest.json              # generated\n213: ├── changelog/\n214: ├── manual-testing-playbook/          # the scenario corpus — an input\n215: │   └── manual-testing-playbook.md    # the index; per-feature files in category folders\n216: ├── benchmark/                        # what running that corpus produced — output\n217: │   ├── README.md                     # layout and how to run\n218: │   └── reports/\n219: │       ├── README.md                 # run index, appended by the harness\n220: │       └── <YYYY-MM-DD>--<subject>--<variant>/\n221: ├── workflow-packet/\n222: │   ├── SKILL.md\n223: │   ├── ROUTER.md\n224: │   ├── README.md\n225: │   ├── procedures/       (optional - only if the packet has multiple distinct, triggered procedures)\n226: │   └── changelog/\n227: └── surface-packet/\n228:     ├── SKILL.md\n229:     ├── ROUTER.md\n230:     ├── README.md\n231:     ├── references/\n232:     ├── assets/\n233:     └── changelog/\n234: ```\n235: \n236: Class-H root metadata follows the [skill-root-metadata-contract.md](references/shared/skill-root-metadata-contract.md) matrix, including authored versus generated files.\n237: \n238: A packet may carry its own `benchmark/` in the same shape when it is measured separately from its\n239: hub. The corpus/output pairing and the owning-skill references described under the standalone shape\n240: apply identically here.\n241: \n242: ### Validation And Packaging Gate\n243: \n244: Run the completion gate before any completion claim:\n245: \n246: ```bash\n247: scripts/validate_skill_package.py <path/to/skill-folder> --strict\n248: ```\n249: \n250: It auto-detects skill kind — standalone skills run the package check; parent hubs additionally run the parent-hub structural check and the canonical manifest freshness check. A missing manifest reports the valid legacy state; a valid fresh manifest reports compiled-ready; malformed or stale manifests fail validation.\n251: \n252: `--check` hard-fails on missing SKILL frontmatter or required fields, non-four-part versions, folder/name mismatches, missing required sections, malformed names, and descriptions that are missing, multiline, or contain angle brackets.\n253: Generated package paths that are not kebab-case remain advisory during a debt-tolerant `--check`.\n254: `--strict` and actual packaging promote them to blocking errors.\n255: Python filenames, Python import-package directories, frozen/generated subtrees, and tool-mandated names are exempt.\n256: \n257: Use structure extraction when quality evidence is needed:\n258: \n259: ```bash\n260: ../shared/scripts/extract_structure.py <path/to/skill/SKILL.md>\n261: ```\n262: \n263: Package only after validation passes:\n264: \n265: ```bash\n266: scripts/package_skill.py <path/to/skill-folder> <output-directory>\n267: ```\n268: \n269: ---\n270: \n271: ## 4. RULES\n272: \n273: ### ✅ ALWAYS\n274: \n275: 1. Read existing target skill or hub files before editing them.\n276: 2. Select `create-skill` or `create-skill-parent` before authoring.\n277: 3. Build the skill for another AI agent instance to execute; include information that is beneficial and non-obvious.\n278: 4. Use local templates under `assets/skill/` rather than inventing file shapes from memory.\n279: 5. Keep `SKILL.md` within the Size Limits table in `assets/skill/skill-md-template.md` and focused on activation, routing, core workflow, rules, and success criteria.\n280: 6. Move deep examples, schemas, edge cases, and long guidance into `references/`.\n281: 7. Keep `WHEN TO USE` free of file references and navigation tables.\n282: 8. Keep one authoritative routing source in `SMART ROUTING`.\n283: 9. Delete TODO placeholders and generated example files before validation.\n284: 10. Run `scripts/validate_skill_package.py <path> --strict` before calling the scaffold complete.\n285: 11. Use `assets/skill/skill-procedure-template.md` for a private, triggerable internal procedure; use `assets/skill/skill-reference-template.md` when no trigger-based selection is needed.\n286: \n287: ### ⛔ NEVER\n288: \n289: 1. Never defer the core executable creation workflow out of `SKILL.md`.\n290: 2. Never create multiple advisor identities when the requested artifact is a parent hub.\n291: 3. Never add `graph-metadata.json` to a nested workflow or surface packet.\n292: 4. Never add `surfacePackets[]` or another parallel registry array.\n293: 5. Never create new folder/name mismatches for convenience.\n294: 6. Never use multiline YAML descriptions in skill frontmatter.\n295: 7. Never leave angle-bracket placeholders, TODO text, or generic descriptions in shipped artifacts.\n296: 8. Never claim automatic platform behavior that OpenCode does not provide; document manual verification instead.\n297: 9. Never package or distribute a skill before validation passes.\n298: 10. Never broaden into unrelated sk-doc artifact types.\n299: \n300: ### ⚠️ ESCALATE IF\n301: \n302: 1. It is unclear whether the target should be a standalone skill or parent hub.\n303: 2. Tool permissions, mutation authority, or advisor identity boundaries are ambiguous.\n304: 3. Existing folder names conflict with required `name` or `packetSkillName` rules.\n305: 4. A parent hub needs routing semantics beyond the core two-tier model.\n306: 5. Validation fails for reasons that would require changing the public contract.\n307: \n308: ---\n309: \n310: ## 5. SUCCESS CRITERIA\n311: \n312: - The correct workflow mode was selected: `create-skill` or `create-skill-parent`.\n313: - Concrete trigger examples, boundaries, tool needs, and output contracts are reflected in the artifact.\n314: - Standalone skills contain valid frontmatter, executable `SKILL.md` workflow content, useful resources, and no placeholder examples.\n315: - Parent hubs contain one hub identity, one `modes[]` registry, valid router metadata, one root `ROUTER.md` in a valid `stage1-only` or `active` state, and nested packets without packet-local graph metadata.\n316: - Generated resource paths use kebab-case, with Python and tool-mandated names preserved exactly.\n317: - `scripts/validate_skill_package.py <path> --strict` exits clean, or exact blockers are reported.\n318: - Shared create-quality-control standards from `../shared` were applied when quality evidence was needed.\n319: \n320: ---\n321: \n322: ## 6. REFERENCES\n323: \n324: Use these only for overflow detail, exhaustive examples, or schema checks beyond the core workflow above.\n325: \n326: - `references/README.md` - route map for the full reference set.\n327: - `references/shared/overview.md` - deeper anatomy, layered-doc structure, and resource placement guidance.\n328: - `references/skill/creation-workflow.md` - expanded examples for the six-step standalone workflow.\n329: - `references/skill/upgrading-a-skill-to-v4.md` - adopter guide for reconciling a customized skill to the v4 parent-hub format (convert-vs-keep-single decision, single→parent procedure, sk-code/sk-git cases).\n330: - `references/shared/validation-and-packaging.md` - detailed validation, packaging, and distribution notes.\n331: - `references/shared/skill-root-metadata-contract.md` - the per-class root JSON matrix, authored versus generated ownership, and the optional authored `leaf-scopes.json` that narrows a root's leaf roots to subtrees or single docs.\n332: - `references/shared/common-pitfalls.md` - examples of recurring trigger, YAML, style, and context-budget defects.\n333: - `references/parent-skill/parent-skills-nested-packets.md` - detailed parent-hub and nested-packet model.\n334: - `references/parent-skill/parent-hub-router-schema.md` - full router and registry schema.\n335: - `references/parent-skill/compiled-routing-architecture.md` - which hubs the compiled router serves, the shadow-child-to-cohort chain, and why `--compiled-routing ready` mints onboarding evidence, not compiled-serving.\n336: - `assets/skill/skill-md-template.md` - standalone skill SKILL.md template.\n337: - `assets/skill/skill-readme-template.md` - skill README template.\n338: - `assets/skill/skill-reference-template.md` - reference markdown template.\n339: - `assets/skill/skill-asset-template.md` - asset markdown template.\n340: - `assets/skill/skill-smart-router.md` - resilient smart-router pattern.\n341: - `assets/skill/skill-router-template.md` - sibling `ROUTER.md` template for a standalone skill or mode packet.\n342: - `assets/skill/skill-procedure-template.md` - private procedure card templates and guidelines.\n343: - `assets/parent-skill/parent-skill-*` - parent hub templates.\n344: - `scripts/init_skill.py` - standalone skill scaffold helper.\n345: - `scripts/package_skill.py` - validation and packaging helper.\n346: - `scripts/leaf-route-replay.cjs` - zero-call stage-two keyword replay and read recount. It scores the `ROUTER.md` keyword block against the committed gold scenarios. `--transcripts` recounts reads and `--prose` compares the prose arm.\n347: - `.skilled/commands/doctor/sk-skill.md` - the `/doctor:sk-skill` router outside this packet. Its `check` target reports how far one skill, or the whole fleet, is from this format row by row, or `--into-hub <hub>` reports the eleven surfaces a skill or mode still needs under that hub, and its `convert` target converts an older Skilled skill in place or a plain agent skill into a class S standalone root after a plan and a yes. Both are read-only until `convert` receives `--apply`.\n348: - `../shared/references/core-standards.md` - shared markdown standards.\n349: - `../shared/references/validation.md` - shared validation workflow."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/SKILL.md\"}"},"time":{"start":1794582797565,"end":1794582797626}}}}
{"type":"tool_use","timestamp":1794582797633,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d57857a7001Hlz8ryNTxxrU5O","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578445e001E8nsbhhL1Wr8sP","type":"tool","id":"chatcmpl-tool-882092c17705a2f6","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/README.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/README.md, lines 1-180\n1: ---\n2: title: \"create-skill\"\n3: description: \"Scaffold, validate and package standalone OpenCode skills and two-axis parent hubs from vetted templates, for anyone building or repairing a skill under .skilled/skills/.\"\n4: trigger_phrases:\n5:   - \"create skill\"\n6:   - \"parent hub\"\n7: version: 1.2.8.0\n8: ---\n9: \n10: # create-skill\n11: \n12: > You get a validated skill or parent hub scaffolded from vetted templates, with routing and metadata already proven, not a blank file and a guess.\n13: \n14: ---\n15: \n16: ## 1. OVERVIEW\n17: \n18: ### At a Glance\n19: \n20: | Aspect | What you get |\n21: |---|---|\n22: | **Use it for** | Scaffolding, validating and packaging OpenCode skills under `.skilled/skills/`, standalone or parent hub |\n23: | **Invoke with** | `/create:skill`, `/create:skill-parent`, \"new skill\", \"parent hub\" |\n24: | **Works on** | New skill folders and existing skill or hub packages that need repair or re-validation |\n25: | **Produces** | `SKILL.md`, `README.md`, `references/`, `assets/` and `scripts/` for a skill, a full parent-hub router set for a hub |\n26: \n27: ### What It Does\n28: \n29: create-skill runs one of two workflow modes from a single packet. `create-skill` scaffolds a standalone skill with its own advisor identity, `SKILL.md`, `README.md`, `references/`, `assets/` and `scripts/`, built with `scripts/init_skill.py` and normalized to this repo's section order. `create-skill-parent` scaffolds a parent hub that dispatches to nested workflow or surface packets, with `mode-registry.json` and `hub-router.json` at the hub root and `graph-metadata.json` only there, never inside a nested packet. Both modes end at the same gate: `scripts/validate_skill_package.py` must exit clean before `scripts/package_skill.py` runs. It does not audit or improve an existing skill's prose quality once the skill already exists and only needs review. That is `create-quality-control`.\n30: \n31: ### Why This Skill Exists\n32: \n33: Hand-rolling a new skill from a blank `SKILL.md` means reinventing frontmatter rules, section order, routing pseudocode and validation gates every single time. The drift shows up as skills that skip a required field, use the wrong version format, bury routing logic where the advisor can never find it or miss a validation gate entirely. A parent hub multiplies that risk across a registry, a router and however many nested packets, all of which have to agree with each other or the hub silently misroutes. create-skill exists to scaffold both shapes from vetted templates and then prove the result is valid before anyone calls it done.\n34: \n35: ### The Two Workflow Modes\n36: \n37: | Mode | What the skill scaffolds |\n38: |---|---|\n39: | **`create-skill`** | a standalone skill folder with its own advisor identity, `SKILL.md`, `README.md`, `references/`, `assets/` and `scripts/` |\n40: | **`create-skill-parent`** | a parent hub root with `mode-registry.json`, `hub-router.json`, root `ROUTER.md` (`stage1-only` on a fresh scaffold), `description.json`, `graph-metadata.json` and `command-metadata.json`, plus a `SKILL.md`, `README.md` and `changelog/` per nested packet |\n41: \n42: ---\n43: \n44: ## 2. QUICK START\n45: \n46: > Run these commands from the repository root.\n47: \n48: **Step 1: Scaffold a standalone skill.**\n49: \n50: ```bash\n51: # --path is the PARENT directory. init_skill.py creates <path>/my-skill\n52: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/init_skill.py my-skill --path .skilled/skills\n53: ```\n54: \n55: `init_skill.py` creates `my-skill/` with `SKILL.md`, `ROUTER.md` and two prepared trees: a `manual-testing-playbook/` corpus index and a `benchmark/reports/` tree carrying its own run index. `README.md`, `references/`, `assets/` and `scripts/` are added by hand as the skill earns them.\n56: \n57: **Step 2: Fill in the real content, then validate.**\n58: \n59: ```bash\n60: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py .skilled/skills/<skill-name> --strict\n61: ```\n62: \n63: Expected output ends with `package_skill.py --check --strict: PASS (exit 0)`.\n64: \n65: **Step 3: Package only after validation passes.**\n66: \n67: ```bash\n68: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/package_skill.py .skilled/skills/<skill-name> <output-directory>\n69: ```\n70: \n71: Expected: ✅ Successfully packaged <file-count> files to: <output-directory>/<skill-name>.zip\n72: \n73: ---\n74: \n75: ## 3. HOW IT WORKS\n76: \n77: ### The Standalone Path\n78: \n79: The standalone path starts with concrete examples of what the skill needs to do, then clarifies purpose, trigger phrases, output contract and boundaries before any file gets written. From there each piece of reusable content gets a home: deterministic or repeatedly-rewritten code goes in `scripts/`, domain knowledge and detailed workflow guidance goes in `references/` and templates or output resources go in `assets/`. `scripts/init_skill.py` scaffolds the folder. Generated files get normalized to the repo's section order and trimmed of anything unneeded, then `SKILL.md` gets authored as an executable contract with `WHEN TO USE`, `SMART ROUTING`, `HOW IT WORKS`, `RULES` and `SUCCESS CRITERIA`. Validation runs before any completion claim. Packaging only runs after validation passes.\n80: \n81: ### The Parent-Hub Path\n82: \n83: The parent-hub path starts by confirming the target really is one advisor-routable identity, not several skills that happen to be related. `scripts/init_skill.py --kind parent` then scaffolds the hub root (`SKILL.md`, `mode-registry.json`, `hub-router.json`, root `ROUTER.md` with `router_state: stage1-only`, `description.json`, `graph-metadata.json`, `command-metadata.json` and the generated `leaf-manifest.json`) and each nested packet gets its own `SKILL.md`, `README.md` and `changelog/`, with no packet-local `graph-metadata.json` anywhere but the root. The root `ROUTER.md` stays `stage1-only` (empty maps, all routing in stage one) until an author promotes it to `active` with a concrete, resolvable leaf map. The scaffolder never fabricates placeholder intents.\n84: \n85: ### Compiled Routing: Legacy Versus Ready\n86: \n87: `--compiled-routing legacy` and `--compiled-routing ready` produce genuinely different on-disk artifacts for the same hub shape. The authoring workflow asks which one you want rather than silently picking. Legacy leaves the router directive in place with no canonical manifest, which is backward compatible with every existing call. Ready mints a canonical manifest with `compiled-route-manifest.cjs mint`, then verifies it is fresh and only reports `compiled-ready` when both steps succeed. A failed mint or a stale manifest falls back to legacy rather than ever hand-authoring a manifest or a digest. Either way, a ready manifest stays inert onboarding evidence: it never activates compiled serving or changes the repository default on its own.\n88: \n89: ### Replaying Stage-Two Leaf Routes\n90: \n91: When a hub's `ROUTER.md` keyword block scores a request, the winning intents pick the leaf routes. [`scripts/leaf-route-replay.cjs`](./scripts/leaf-route-replay.cjs) measures how well those picks match the committed gold scenarios. With no switch it makes no model call. It scores each hub's predicted leaf routes against the gold routes and prints one `hub=` line per hub plus a `total` line. `--transcripts <dir>` counts real `ROUTER.md` reads in a folder you name without printing any text. `--prose <file>` compares the keyword arm against a prose arm and prints one `replay verdict:` line that keeps, drops or stops.\n92: \n93: ```bash\n94: node .skilled/skills/sk-doc/sk-create-skill/scripts/leaf-route-replay.cjs --report <dir> --transcripts <dir> --prose <file>\n95: ```\n96: \n97: ---\n98: \n99: ## 4. INTEGRATION & NAVIGATION\n100: \n101: ### When To Use This Skill\n102: \n103: Reach for create-skill when creating a brand-new OpenCode skill, rebuilding an existing one or authoring a parent hub with nested workflow or surface packets. Reach for it too when repairing broken frontmatter, missing required sections or routing metadata in a package that already exists. Choose `create-skill-parent` specifically when one identity needs to dispatch to multiple nested packets, not merely because two skills feel related. Skip it for application code (that belongs to `sk-code`), for auditing or scoring an existing skill without rebuilding it (that belongs to `create-quality-control`) and for a README refresh on a skill that already has one (that belongs to `create-readme`).\n104: \n105: ### Related Skills\n106: \n107: | Skill | Relationship |\n108: |---|---|\n109: | `create-readme` | Writes or refreshes a skill's README once the skill already exists. create-skill writes the first one while scaffolding. |\n110: | `create-quality-control` | Audits, scores or optimizes an existing skill document without rebuilding the package. |\n111: | `create-agent` | Owns agent scaffolding, a separate artifact family from skills. |\n112: | `sk-code` | Owns application code implementation. create-skill only authors the skill package that may describe that work. |\n113: \n114: ---\n115: \n116: ## 5. TROUBLESHOOTING\n117: \n118: | What you see | Why | Fix |\n119: |---|---|---|\n120: | `validate_skill_package.py` fails on frontmatter | `name`, `description`, `allowed-tools` or `version` is missing. `version` is not four-part. | Fix `SKILL.md` frontmatter to match the four required fields exactly |\n121: | Parent hub validation reports a stale manifest | `--compiled-routing ready` was chosen, then router inputs changed after minting | Re-run `compiled-route-manifest.cjs mint` or fall back to legacy |\n122: | Nested packet fails validation over `graph-metadata.json` | A nested workflow or surface packet was given its own `graph-metadata.json` | Delete it. Only the hub root carries `graph-metadata.json` |\n123: | Generated paths flagged as non-kebab-case under `--strict` | A `references/` or `assets/` file used snake_case or another casing | Rename to kebab-case. Python files and tool-mandated names stay exempt |\n124: | `package_skill.py` refuses to package | `validate_skill_package.py` has not run yet or it failed | Run validation first and fix every hard failure before packaging |\n125: \n126: ---\n127: \n128: ## 6. FAQ\n129: \n130: **Q: Why two workflow modes in one packet instead of two skills?**\n131: \n132: A: Both modes share the same templates, validation gate and packaging helper. Splitting them would duplicate that machinery for what is really one decision: one advisor identity or many nested packets under one identity.\n133: \n134: **Q: When do I choose `create-skill-parent` over adding another standalone skill?**\n135: \n136: A: When several packets need to answer to one advisor identity, one router and one registry. Two genuinely unrelated skills should stay two standalone skills, not get merged into a hub for convenience.\n137: \n138: **Q: What is the real difference between legacy and ready compiled-routing?**\n139: \n140: A: Legacy leaves the router directive in place with no canonical manifest, which is the safe, backward-compatible default. Ready mints and verifies a canonical manifest, but the result stays inert onboarding evidence and never activates compiled serving on its own.\n141: \n142: **Q: Do I need `scripts/`, `references/` and `assets/` for every skill?**\n143: \n144: A: No. `SKILL.md` is the root marker, while each class has required root metadata in the [skill-root-metadata-contract.md](references/shared/skill-root-metadata-contract.md) matrix. Add content directories only when the skill genuinely needs deterministic scripts, deep reference material or template assets.\n145: \n146: ---\n147: \n148: ## 7. VERIFICATION\n149: \n150: Run every command in this table from the repository root.\n151: \n152: | Check | How to run it | Pass looks like |\n153: |---|---|---|\n154: | README structure | `python3 .skilled/skills/sk-doc/shared/scripts/validate_document.py .skilled/skills/sk-doc/sk-create-skill/README.md --type readme` | Reports zero issues |\n155: | Package completion | `python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py <path> --strict` | Ends with `package_skill.py --check --strict: PASS (exit 0)`. Contract and render findings block, staged render findings print as `render advisory:`. Parent hubs also report legacy or compiled-ready state |\n156: | Structure extraction | `python3 .skilled/skills/sk-doc/shared/scripts/extract_structure.py <path/to/SKILL.md>` | Prints the parsed section outline for a fast quality read |\n157: | Leaf-route replay | `node --test .skilled/skills/sk-doc/sk-create-skill/scripts/tests/leaf-route-replay.test.cjs` | `pass 26` and `fail 0` |\n158: \n159: ---\n160: \n161: ## 8. RELATED DOCUMENTS\n162: \n163: | Document | Purpose |\n164: |---|---|\n165: | [`SKILL.md`](./SKILL.md) | Runtime workflow and the full standalone and parent-hub contract |\n166: | [`ROUTER.md`](./ROUTER.md) | Machine router: intent map, resource map and loading levels |\n167: | [`assets/skill/skill-md-template.md`](./assets/skill/skill-md-template.md) | Standalone `SKILL.md` scaffold |\n168: | [`assets/skill/skill-readme-template.md`](./assets/skill/skill-readme-template.md) | Standalone skill README scaffold, the template this file was written from |\n169: | [`assets/skill/skill-router-template.md`](./assets/skill/skill-router-template.md) | Sibling `ROUTER.md` scaffold for a standalone skill or mode packet |\n170: | [`assets/parent-skill/parent-skill-hub-template.md`](./assets/parent-skill/parent-skill-hub-template.md) | Parent hub `SKILL.md` scaffold |\n171: | [`references/README.md`](./references/README.md) | Route map into the `shared/`, `skill/` and `parent-skill/` reference groups |\n172: | [`references/skill/upgrading-a-skill-to-v4.md`](./references/skill/upgrading-a-skill-to-v4.md) | Adopter guide: reconcile a customized skill to the v4 parent-hub format |\n173: | [`scripts/init_skill.py`](./scripts/init_skill.py) | Scaffold helper for new standalone or parent-hub folders |\n174: | [`scripts/package_skill.py`](./scripts/package_skill.py) | Validation and packaging helper |\n175: | [`scripts/leaf-route-replay.cjs`](./scripts/leaf-route-replay.cjs) | Zero-call Stage-Two leaf-route replay, router-read recount and prose comparison |\n176: \n177: <!-- readme-check\n178: allow-ref my-skill/ | the example skill folder init_skill.py creates, not a repo path\n179: allow-ref benchmark/reports/ | a tree inside the example skill init_skill.py creates\n180: -->","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/README.md, lines 1-180\n1: ---\n2: title: \"create-skill\"\n3: description: \"Scaffold, validate and package standalone OpenCode skills and two-axis parent hubs from vetted templates, for anyone building or repairing a skill under .skilled/skills/.\"\n4: trigger_phrases:\n5:   - \"create skill\"\n6:   - \"parent hub\"\n7: version: 1.2.8.0\n8: ---\n9: \n10: # create-skill\n11: \n12: > You get a validated skill or parent hub scaffolded from vetted templates, with routing and metadata already proven, not a blank file and a guess.\n13: \n14: ---\n15: \n16: ## 1. OVERVIEW\n17: \n18: ### At a Glance\n19: \n20: | Aspect | What you get |\n21: |---|---|\n22: | **Use it for** | Scaffolding, validating and packaging OpenCode skills under `.skilled/skills/`, standalone or parent hub |\n23: | **Invoke with** | `/create:skill`, `/create:skill-parent`, \"new skill\", \"parent hub\" |\n24: | **Works on** | New skill folders and existing skill or hub packages that need repair or re-validation |\n25: | **Produces** | `SKILL.md`, `README.md`, `references/`, `assets/` and `scripts/` for a skill, a full parent-hub router set for a hub |\n26: \n27: ### What It Does\n28: \n29: create-skill runs one of two workflow modes from a single packet. `create-skill` scaffolds a standalone skill with its own advisor identity, `SKILL.md`, `README.md`, `references/`, `assets/` and `scripts/`, built with `scripts/init_skill.py` and normalized to this repo's section order. `create-skill-parent` scaffolds a parent hub that dispatches to nested workflow or surface packets, with `mode-registry.json` and `hub-router.json` at the hub root and `graph-metadata.json` only there, never inside a nested packet. Both modes end at the same gate: `scripts/validate_skill_package.py` must exit clean before `scripts/package_skill.py` runs. It does not audit or improve an existing skill's prose quality once the skill already exists and only needs review. That is `create-quality-control`.\n30: \n31: ### Why This Skill Exists\n32: \n33: Hand-rolling a new skill from a blank `SKILL.md` means reinventing frontmatter rules, section order, routing pseudocode and validation gates every single time. The drift shows up as skills that skip a required field, use the wrong version format, bury routing logic where the advisor can never find it or miss a validation gate entirely. A parent hub multiplies that risk across a registry, a router and however many nested packets, all of which have to agree with each other or the hub silently misroutes. create-skill exists to scaffold both shapes from vetted templates and then prove the result is valid before anyone calls it done.\n34: \n35: ### The Two Workflow Modes\n36: \n37: | Mode | What the skill scaffolds |\n38: |---|---|\n39: | **`create-skill`** | a standalone skill folder with its own advisor identity, `SKILL.md`, `README.md`, `references/`, `assets/` and `scripts/` |\n40: | **`create-skill-parent`** | a parent hub root with `mode-registry.json`, `hub-router.json`, root `ROUTER.md` (`stage1-only` on a fresh scaffold), `description.json`, `graph-metadata.json` and `command-metadata.json`, plus a `SKILL.md`, `README.md` and `changelog/` per nested packet |\n41: \n42: ---\n43: \n44: ## 2. QUICK START\n45: \n46: > Run these commands from the repository root.\n47: \n48: **Step 1: Scaffold a standalone skill.**\n49: \n50: ```bash\n51: # --path is the PARENT directory. init_skill.py creates <path>/my-skill\n52: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/init_skill.py my-skill --path .skilled/skills\n53: ```\n54: \n55: `init_skill.py` creates `my-skill/` with `SKILL.md`, `ROUTER.md` and two prepared trees: a `manual-testing-playbook/` corpus index and a `benchmark/reports/` tree carrying its own run index. `README.md`, `references/`, `assets/` and `scripts/` are added by hand as the skill earns them.\n56: \n57: **Step 2: Fill in the real content, then validate.**\n58: \n59: ```bash\n60: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py .skilled/skills/<skill-name> --strict\n61: ```\n62: \n63: Expected output ends with `package_skill.py --check --strict: PASS (exit 0)`.\n64: \n65: **Step 3: Package only after validation passes.**\n66: \n67: ```bash\n68: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/package_skill.py .skilled/skills/<skill-name> <output-directory>\n69: ```\n70: \n71: Expected: ✅ Successfully packaged <file-count> files to: <output-directory>/<skill-name>.zip\n72: \n73: ---\n74: \n75: ## 3. HOW IT WORKS\n76: \n77: ### The Standalone Path\n78: \n79: The standalone path starts with concrete examples of what the skill needs to do, then clarifies purpose, trigger phrases, output contract and boundaries before any file gets written. From there each piece of reusable content gets a home: deterministic or repeatedly-rewritten code goes in `scripts/`, domain knowledge and detailed workflow guidance goes in `references/` and templates or output resources go in `assets/`. `scripts/init_skill.py` scaffolds the folder. Generated files get normalized to the repo's section order and trimmed of anything unneeded, then `SKILL.md` gets authored as an executable contract with `WHEN TO USE`, `SMART ROUTING`, `HOW IT WORKS`, `RULES` and `SUCCESS CRITERIA`. Validation runs before any completion claim. Packaging only runs after validation passes.\n80: \n81: ### The Parent-Hub Path\n82: \n83: The parent-hub path starts by confirming the target really is one advisor-routable identity, not several skills that happen to be related. `scripts/init_skill.py --kind parent` then scaffolds the hub root (`SKILL.md`, `mode-registry.json`, `hub-router.json`, root `ROUTER.md` with `router_state: stage1-only`, `description.json`, `graph-metadata.json`, `command-metadata.json` and the generated `leaf-manifest.json`) and each nested packet gets its own `SKILL.md`, `README.md` and `changelog/`, with no packet-local `graph-metadata.json` anywhere but the root. The root `ROUTER.md` stays `stage1-only` (empty maps, all routing in stage one) until an author promotes it to `active` with a concrete, resolvable leaf map. The scaffolder never fabricates placeholder intents.\n84: \n85: ### Compiled Routing: Legacy Versus Ready\n86: \n87: `--compiled-routing legacy` and `--compiled-routing ready` produce genuinely different on-disk artifacts for the same hub shape. The authoring workflow asks which one you want rather than silently picking. Legacy leaves the router directive in place with no canonical manifest, which is backward compatible with every existing call. Ready mints a canonical manifest with `compiled-route-manifest.cjs mint`, then verifies it is fresh and only reports `compiled-ready` when both steps succeed. A failed mint or a stale manifest falls back to legacy rather than ever hand-authoring a manifest or a digest. Either way, a ready manifest stays inert onboarding evidence: it never activates compiled serving or changes the repository default on its own.\n88: \n89: ### Replaying Stage-Two Leaf Routes\n90: \n91: When a hub's `ROUTER.md` keyword block scores a request, the winning intents pick the leaf routes. [`scripts/leaf-route-replay.cjs`](./scripts/leaf-route-replay.cjs) measures how well those picks match the committed gold scenarios. With no switch it makes no model call. It scores each hub's predicted leaf routes against the gold routes and prints one `hub=` line per hub plus a `total` line. `--transcripts <dir>` counts real `ROUTER.md` reads in a folder you name without printing any text. `--prose <file>` compares the keyword arm against a prose arm and prints one `replay verdict:` line that keeps, drops or stops.\n92: \n93: ```bash\n94: node .skilled/skills/sk-doc/sk-create-skill/scripts/leaf-route-replay.cjs --report <dir> --transcripts <dir> --prose <file>\n95: ```\n96: \n97: ---\n98: \n99: ## 4. INTEGRATION & NAVIGATION\n100: \n101: ### When To Use This Skill\n102: \n103: Reach for create-skill when creating a brand-new OpenCode skill, rebuilding an existing one or authoring a parent hub with nested workflow or surface packets. Reach for it too when repairing broken frontmatter, missing required sections or routing metadata in a package that already exists. Choose `create-skill-parent` specifically when one identity needs to dispatch to multiple nested packets, not merely because two skills feel related. Skip it for application code (that belongs to `sk-code`), for auditing or scoring an existing skill without rebuilding it (that belongs to `create-quality-control`) and for a README refresh on a skill that already has one (that belongs to `create-readme`).\n104: \n105: ### Related Skills\n106: \n107: | Skill | Relationship |\n108: |---|---|\n109: | `create-readme` | Writes or refreshes a skill's README once the skill already exists. create-skill writes the first one while scaffolding. |\n110: | `create-quality-control` | Audits, scores or optimizes an existing skill document without rebuilding the package. |\n111: | `create-agent` | Owns agent scaffolding, a separate artifact family from skills. |\n112: | `sk-code` | Owns application code implementation. create-skill only authors the skill package that may describe that work. |\n113: \n114: ---\n115: \n116: ## 5. TROUBLESHOOTING\n117: \n118: | What you see | Why | Fix |\n119: |---|---|---|\n120: | `validate_skill_package.py` fails on frontmatter | `name`, `description`, `allowed-tools` or `version` is missing. `version` is not four-part. | Fix `SKILL.md` frontmatter to match the four required fields exactly |\n121: | Parent hub validation reports a stale manifest | `--compiled-routing ready` was chosen, then router inputs changed after minting | Re-run `compiled-route-manifest.cjs mint` or fall back to legacy |\n122: | Nested packet fails validation over `graph-metadata.json` | A nested workflow or surface packet was given its own `graph-metadata.json` | Delete it. Only the hub root carries `graph-metadata.json` |\n123: | Generated paths flagged as non-kebab-case under `--strict` | A `references/` or `assets/` file used snake_case or another casing | Rename to kebab-case. Python files and tool-mandated names stay exempt |\n124: | `package_skill.py` refuses to package | `validate_skill_package.py` has not run yet or it failed | Run validation first and fix every hard failure before packaging |\n125: \n126: ---\n127: \n128: ## 6. FAQ\n129: \n130: **Q: Why two workflow modes in one packet instead of two skills?**\n131: \n132: A: Both modes share the same templates, validation gate and packaging helper. Splitting them would duplicate that machinery for what is really one decision: one advisor identity or many nested packets under one identity.\n133: \n134: **Q: When do I choose `create-skill-parent` over adding another standalone skill?**\n135: \n136: A: When several packets need to answer to one advisor identity, one router and one registry. Two genuinely unrelated skills should stay two standalone skills, not get merged into a hub for convenience.\n137: \n138: **Q: What is the real difference between legacy and ready compiled-routing?**\n139: \n140: A: Legacy leaves the router directive in place with no canonical manifest, which is the safe, backward-compatible default. Ready mints and verifies a canonical manifest, but the result stays inert onboarding evidence and never activates compiled serving on its own.\n141: \n142: **Q: Do I need `scripts/`, `references/` and `assets/` for every skill?**\n143: \n144: A: No. `SKILL.md` is the root marker, while each class has required root metadata in the [skill-root-metadata-contract.md](references/shared/skill-root-metadata-contract.md) matrix. Add content directories only when the skill genuinely needs deterministic scripts, deep reference material or template assets.\n145: \n146: ---\n147: \n148: ## 7. VERIFICATION\n149: \n150: Run every command in this table from the repository root.\n151: \n152: | Check | How to run it | Pass looks like |\n153: |---|---|---|\n154: | README structure | `python3 .skilled/skills/sk-doc/shared/scripts/validate_document.py .skilled/skills/sk-doc/sk-create-skill/README.md --type readme` | Reports zero issues |\n155: | Package completion | `python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py <path> --strict` | Ends with `package_skill.py --check --strict: PASS (exit 0)`. Contract and render findings block, staged render findings print as `render advisory:`. Parent hubs also report legacy or compiled-ready state |\n156: | Structure extraction | `python3 .skilled/skills/sk-doc/shared/scripts/extract_structure.py <path/to/SKILL.md>` | Prints the parsed section outline for a fast quality read |\n157: | Leaf-route replay | `node --test .skilled/skills/sk-doc/sk-create-skill/scripts/tests/leaf-route-replay.test.cjs` | `pass 26` and `fail 0` |\n158: \n159: ---\n160: \n161: ## 8. RELATED DOCUMENTS\n162: \n163: | Document | Purpose |\n164: |---|---|\n165: | [`SKILL.md`](./SKILL.md) | Runtime workflow and the full standalone and parent-hub contract |\n166: | [`ROUTER.md`](./ROUTER.md) | Machine router: intent map, resource map and loading levels |\n167: | [`assets/skill/skill-md-template.md`](./assets/skill/skill-md-template.md) | Standalone `SKILL.md` scaffold |\n168: | [`assets/skill/skill-readme-template.md`](./assets/skill/skill-readme-template.md) | Standalone skill README scaffold, the template this file was written from |\n169: | [`assets/skill/skill-router-template.md`](./assets/skill/skill-router-template.md) | Sibling `ROUTER.md` scaffold for a standalone skill or mode packet |\n170: | [`assets/parent-skill/parent-skill-hub-template.md`](./assets/parent-skill/parent-skill-hub-template.md) | Parent hub `SKILL.md` scaffold |\n171: | [`references/README.md`](./references/README.md) | Route map into the `shared/`, `skill/` and `parent-skill/` reference groups |\n172: | [`references/skill/upgrading-a-skill-to-v4.md`](./references/skill/upgrading-a-skill-to-v4.md) | Adopter guide: reconcile a customized skill to the v4 parent-hub format |\n173: | [`scripts/init_skill.py`](./scripts/init_skill.py) | Scaffold helper for new standalone or parent-hub folders |\n174: | [`scripts/package_skill.py`](./scripts/package_skill.py) | Validation and packaging helper |\n175: | [`scripts/leaf-route-replay.cjs`](./scripts/leaf-route-replay.cjs) | Zero-call Stage-Two leaf-route replay, router-read recount and prose comparison |\n176: \n177: <!-- readme-check\n178: allow-ref my-skill/ | the example skill folder init_skill.py creates, not a repo path\n179: allow-ref benchmark/reports/ | a tree inside the example skill init_skill.py creates\n180: -->"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/README.md\"}"},"time":{"start":1794582796199,"end":1794582797633}}}}
{"type":"tool_use","timestamp":1794582797638,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d57859a6001WCps00PAkJt6WN","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578445e001E8nsbhhL1Wr8sP","type":"tool","id":"chatcmpl-tool-8b87bb1555caae72","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/ROUTER.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/ROUTER.md, lines 1-209\n1: ---\n2: title: \"Create Skill Router\"\n3: description: \"Sibling router for sk-create-skill: the intent signals, the resource map and the no-match checklist a reader parses first.\"\n4: trigger_phrases:\n5:   - \"sk-create-skill router\"\n6:   - \"sk-create-skill routing\"\n7: importance_tier: normal\n8: contextType: general\n9: version: 1.0.3.0\n10: router_state: active\n11: skill_pointer: SKILL.md\n12: ---\n13: \n14: # Create Skill Router\n15: \n16: The machine router for [`SKILL.md`](./SKILL.md). `SKILL.md` keeps the short routing prose and the\n17: link that points here; this file holds the declaration a reader parses to decide what loads.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: The router answers one question: given a request, which skill-local resources load, in what order, and\n24: what happens when nothing matches. Every path below stays inside this skill folder, and no resource other than `DEFAULT_RESOURCE`\n25: loads before an intent selects it.\n26: \n27: Requests reach this packet when they ask to create or rebuild an OpenCode skill under `.skilled/skills/`, to run `/create:skill` for a standalone skill or `/create:skill-parent` for a parent hub, to author or repair a skill package's `SKILL.md`, `README.md`, `references/`, `assets/`, `scripts/` or `changelog/`, or to validate and package a skill with `scripts/package_skill.py`. Its vocabulary is `create skill`, `new skill`, `skill scaffold`, `SKILL.md scaffold`, `OpenCode skill`, `parent hub`, `mode packet`, `nested workflow packet` and `package skill`. It routes to two resource families: the `references/shared/` doctrine and its root-metadata contract, which both modes load first, and the mode's own `references/<key>/` plus `assets/<key>/` trees, where `create-skill` resolves the `skill` key and `create-skill-parent` resolves `parent-skill`.\n28: \n29: ---\n30: \n31: ## 2. INTENT MODEL\n32: \n33: - **`SKILL_PACKAGE`** fires on `create skill`, `/create:skill`, `new skill`, `skill scaffold`, `SKILL.md scaffold`, `OpenCode skill`, `sk-skill`, `create sk-`, `reusable capability`, `reusable helper`, `starter reference docs`, `package skill`, `doc rewrite guard`, `doc-rewrite-guard.py`, `render ledger`, `render-known-debt.json`, `exempt from the render checks`, `render exempt map`, `kept every claim` and `kept every original claim` at weight 4. It loads the five shared docs — `references/shared/overview.md`, `references/shared/common-pitfalls.md`, `references/shared/validation-and-packaging.md`, `references/shared/advisor-index-handoff.md`, `references/shared/skill-root-metadata-contract.md` — then `references/skill/creation-workflow.md`, `references/skill/examples-and-maintenance.md`, `references/skill/upgrading-a-skill-to-v4.md`, and the nine `assets/skill/` templates: `assets/skill/skill-md-template.md`, `assets/skill/skill-readme-template.md`, `assets/skill/skill-reference-template.md`, `assets/skill/skill-asset-template.md`, `assets/skill/skill-procedure-template.md`, `assets/skill/skill-scaffold-template.md`, `assets/skill/skill-smart-router.md`, `assets/skill/skill-router-template.md`, `assets/skill/skill-sync-manifest-template.md`.\n34: - **`PARENT_HUB`** fires on `/create:skill-parent`, `parent skill`, `parent hub`, `mode packet`, `nested workflow packet`, `mode-registry.json` and `hub-router.json` at weight 4. It loads the same five shared docs, then `references/parent-skill/parent-skills-nested-packets.md`, `references/parent-skill/parent-hub-router-schema.md`, `references/parent-skill/compiled-routing-architecture.md`, and the five `assets/parent-skill/` templates: `assets/parent-skill/parent-skill-hub-template.md`, `assets/parent-skill/parent-skill-readme-template.md`, `assets/parent-skill/parent-skill-root-router-template.md`, `assets/parent-skill/scaffold/hub-skill-scaffold.md`, `assets/parent-skill/scaffold/packet-skill-scaffold.md`.\n35: \n36: ---\n37: \n38: ## 3. MACHINE ROUTER\n39: \n40: The one machine-readable projection of the intent model above, written as `## MACHINE ROUTER` so every\n41: reader finds it. This section is the last in the file, and it holds the only pseudocode.\n42: \n43: This section holds the packet's mode tree, its route selection, the resource domains it loads and the smart-router pseudocode that reads them.\n44: \n45: ### Primary Detection Signal\n46: \n47: ```text\n48: SKILL AUTHORING REQUEST\n49:     |\n50:     +- Standalone skill -> workflowMode: sk-create-skill\n51:     |   +- scripts/init_skill.py\n52:     |   +- assets/skill/skill-md-template.md\n53:     |   +- assets/skill/skill-readme-template.md\n54:     |   +- assets/skill/skill-sync-manifest-template.md\n55:     |\n56:     +- Parent hub -> workflowMode: sk-create-skill-parent\n57:         +- assets/parent-skill/parent-skill-hub-template.md\n58:         +- assets/parent-skill/parent-skill-registry-template.json\n59:         +- assets/parent-skill/parent-skill-hub-router-template.json\n60: ```\n61: \n62: ### Route Selection\n63: \n64: Choose `create-skill` when the artifact is one skill with one advisor identity and one runtime contract.\n65: \n66: Choose `create-skill-parent` when the artifact is one advisor-routable hub that dispatches to nested workflow packets or read-only surface packets.\n67: \n68: Ask one focused clarification before authoring if it is unclear whether the user wants a standalone skill or a parent hub.\n69: \n70: ### Resource Domains\n71: \n72: | Domain | Core Resources | Use |\n73: | --- | --- | --- |\n74: | Scaffolding | `scripts/init_skill.py`, `assets/skill/skill-md-template.md`, `assets/skill/skill-readme-template.md`, `assets/skill/skill-router-template.md` | Create or normalize standalone skill files. |\n75: | Resource templates | `assets/skill/skill-reference-template.md`, `assets/skill/skill-asset-template.md`, `assets/skill/skill-smart-router.md` | Create routed references, assets, and resilient smart-router pseudocode. |\n76: | Runtime sync manifests | `assets/skill/skill-sync-manifest-template.md` | Document how a runtime config dir derives from the canonical `.skilled` tree (SYNC manifest). |\n77: | Procedure cards | `assets/skill/skill-procedure-template.md` | Add a private, triggerable internal procedure to a skill or mode without a new public identity. |\n78: | Parent hubs | `assets/parent-skill/parent-skill-*` | Create hub SKILL, registry, router, description, and graph metadata files. |\n79: | Validation | `scripts/package_skill.py`, `../shared/scripts/extract_structure.py` | Check completion, package distribution zips, and inspect structure. |\n80: | Leaf-route replay | `scripts/leaf-route-replay.cjs` | Replay the committed stage-two keyword block of each hub's `ROUTER.md` against its gold scenarios with zero model calls. `--transcripts` recounts `ROUTER.md` reads and `--prose` compares the prose arm. |\n81: | Overflow detail | `references/README.md`, `references/{shared,skill,parent-skill}/`, `../shared/` | Load only for edge cases, exhaustive examples, or schema details beyond this SKILL.md. |\n82: \n83: ### Smart Router Pseudocode\n84: \n85: ```python\n86: from pathlib import Path\n87: \n88: SKILL_ROOT = Path(__file__).resolve().parent\n89: RESOURCE_BASES = (SKILL_ROOT / \"references\", SKILL_ROOT / \"assets\")\n90: DEFAULT_RESOURCE = \"references/README.md\"\n91: RESOURCE_KEY_BY_MODE = {\n92:     \"sk-create-skill\": \"skill\",\n93:     \"sk-create-skill-parent\": \"parent-skill\",\n94: }\n95: \n96: INTENT_MODEL = {\n97:     \"SKILL_PACKAGE\": {\"weight\": 4, \"keywords\": [\"create skill\", \"/create:skill\", \"new skill\", \"skill scaffold\", \"skill.md scaffold\", \"opencode skill\", \"sk-skill\", \"create sk-\", \"reusable capability\", \"reusable helper\", \"starter reference docs\", \"package skill\", \"doc rewrite guard\", \"doc-rewrite-guard.py\", \"render ledger\", \"render-known-debt.json\", \"exempt from the render checks\", \"render exempt map\", \"kept every claim\", \"kept every original claim\"]},\n98:     \"PARENT_HUB\": {\"weight\": 4, \"keywords\": [\"/create:skill-parent\", \"parent skill\", \"parent hub\", \"mode packet\", \"nested workflow packet\", \"mode-registry.json\", \"hub-router.json\"]},\n99: }\n100: \n101: # The keyed selection below resolves to exactly these sets. Enumerating them keeps\n102: # the routed inventory legible to a reader and to the connectivity scan, which is\n103: # what catches a new reference that the keyed load silently picks up but no\n104: # documented route names.\n105: RESOURCE_MAP = {\n106:     \"SKILL_PACKAGE\": [\n107:         \"references/shared/overview.md\",\n108:         \"references/shared/common-pitfalls.md\",\n109:         \"references/shared/validation-and-packaging.md\",\n110:         \"references/shared/advisor-index-handoff.md\",\n111:         \"references/shared/skill-root-metadata-contract.md\",\n112:         \"references/skill/creation-workflow.md\",\n113:         \"references/skill/examples-and-maintenance.md\",\n114:         \"references/skill/upgrading-a-skill-to-v4.md\",\n115:         \"assets/skill/skill-md-template.md\",\n116:         \"assets/skill/skill-readme-template.md\",\n117:         \"assets/skill/skill-reference-template.md\",\n118:         \"assets/skill/skill-asset-template.md\",\n119:         \"assets/skill/skill-procedure-template.md\",\n120:         \"assets/skill/skill-scaffold-template.md\",\n121:         \"assets/skill/skill-smart-router.md\",\n122:         \"assets/skill/skill-router-template.md\",\n123:         \"assets/skill/skill-sync-manifest-template.md\",\n124:     ],\n125:     \"PARENT_HUB\": [\n126:         \"references/shared/overview.md\",\n127:         \"references/shared/common-pitfalls.md\",\n128:         \"references/shared/validation-and-packaging.md\",\n129:         \"references/shared/advisor-index-handoff.md\",\n130:         \"references/shared/skill-root-metadata-contract.md\",\n131:         \"references/parent-skill/parent-skills-nested-packets.md\",\n132:         \"references/parent-skill/parent-hub-router-schema.md\",\n133:         \"references/parent-skill/compiled-routing-architecture.md\",\n134:         \"assets/parent-skill/parent-skill-hub-template.md\",\n135:         \"assets/parent-skill/parent-skill-readme-template.md\",\n136:         \"assets/parent-skill/parent-skill-root-router-template.md\",\n137:         \"assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n138:         \"assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n139:     ],\n140: }\n141: UNKNOWN_FALLBACK_CHECKLIST = [\n142:     \"Confirm whether the artifact is a standalone skill or parent hub\",\n143:     \"Confirm the target skill folder and intended advisor identity\",\n144:     \"Provide one concrete trigger, output contract, or resource example\",\n145:     \"Confirm the validation command before completion\",\n146: ]\n147: \n148: def discover_markdown_resources() -> set[str]:\n149:     docs = []\n150:     for base in RESOURCE_BASES:\n151:         if base.exists():\n152:             docs.extend(path for path in base.rglob(\"*.md\") if path.is_file())\n153:     return {doc.relative_to(SKILL_ROOT).as_posix() for doc in docs}\n154: \n155: def _guard_in_skill(relative_path: str) -> str:\n156:     resolved = (SKILL_ROOT / relative_path).resolve()\n157:     resolved.relative_to(SKILL_ROOT)\n158:     if resolved.suffix.lower() != \".md\":\n159:         raise ValueError(f\"Only markdown resources are routable: {relative_path}\")\n160:     return resolved.relative_to(SKILL_ROOT).as_posix()\n161: \n162: def load_if_available(relative_path: str, inventory: set[str], loaded: list[str], seen: set[str]) -> None:\n163:     guarded = _guard_in_skill(relative_path)\n164:     if guarded in inventory and guarded not in seen:\n165:         load(guarded)\n166:         loaded.append(guarded)\n167:         seen.add(guarded)\n168: \n169: def route_skill_authoring_request(request):\n170:     inventory = discover_markdown_resources()\n171:     loaded, seen = [], set()\n172: \n173:     if asks_for_parent_hub_or_mode_registry(request):\n174:         workflow_mode = \"sk-create-skill-parent\"\n175:     elif asks_for_nested_workflow_or_surface_packets(request):\n176:         workflow_mode = \"sk-create-skill-parent\"\n177:     elif asks_for_one_skill_package(request):\n178:         workflow_mode = \"sk-create-skill\"\n179:     elif unclear_standalone_vs_parent(request):\n180:         load_if_available(DEFAULT_RESOURCE, inventory, loaded, seen)\n181:         return {\n182:             \"load_level\": \"UNKNOWN_FALLBACK\",\n183:             \"needs_disambiguation\": True,\n184:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n185:             \"resources\": loaded,\n186:         }\n187:     else:\n188:         load_if_available(DEFAULT_RESOURCE, inventory, loaded, seen)\n189:         return {\"load_level\": \"DEFER\", \"next\": \"matching sk-doc packet\", \"resources\": loaded}\n190: \n191:     routing_key = RESOURCE_KEY_BY_MODE[workflow_mode]\n192:     shared_refs = sorted(path for path in inventory if path.startswith(\"references/shared/\"))\n193:     keyed_refs = sorted(path for path in inventory if path.startswith(f\"references/{routing_key}/\"))\n194:     keyed_assets = sorted(path for path in inventory if path.startswith(f\"assets/{routing_key}/\"))\n195: \n196:     if not keyed_refs and not keyed_assets:\n197:         load_if_available(DEFAULT_RESOURCE, inventory, loaded, seen)\n198:         return {\n199:             \"workflowMode\": workflow_mode,\n200:             \"routing_key\": routing_key,\n201:             \"notice\": f\"No create-skill resources found for routing key '{routing_key}'\",\n202:             \"resources\": loaded,\n203:         }\n204: \n205:     for path in shared_refs + keyed_refs + keyed_assets:\n206:         load_if_available(path, inventory, loaded, seen)\n207: \n208:     return {\"workflowMode\": workflow_mode, \"routing_key\": routing_key, \"resources\": loaded}\n209: ```","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/ROUTER.md, lines 1-209\n1: ---\n2: title: \"Create Skill Router\"\n3: description: \"Sibling router for sk-create-skill: the intent signals, the resource map and the no-match checklist a reader parses first.\"\n4: trigger_phrases:\n5:   - \"sk-create-skill router\"\n6:   - \"sk-create-skill routing\"\n7: importance_tier: normal\n8: contextType: general\n9: version: 1.0.3.0\n10: router_state: active\n11: skill_pointer: SKILL.md\n12: ---\n13: \n14: # Create Skill Router\n15: \n16: The machine router for [`SKILL.md`](./SKILL.md). `SKILL.md` keeps the short routing prose and the\n17: link that points here; this file holds the declaration a reader parses to decide what loads.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: The router answers one question: given a request, which skill-local resources load, in what order, and\n24: what happens when nothing matches. Every path below stays inside this skill folder, and no resource other than `DEFAULT_RESOURCE`\n25: loads before an intent selects it.\n26: \n27: Requests reach this packet when they ask to create or rebuild an OpenCode skill under `.skilled/skills/`, to run `/create:skill` for a standalone skill or `/create:skill-parent` for a parent hub, to author or repair a skill package's `SKILL.md`, `README.md`, `references/`, `assets/`, `scripts/` or `changelog/`, or to validate and package a skill with `scripts/package_skill.py`. Its vocabulary is `create skill`, `new skill`, `skill scaffold`, `SKILL.md scaffold`, `OpenCode skill`, `parent hub`, `mode packet`, `nested workflow packet` and `package skill`. It routes to two resource families: the `references/shared/` doctrine and its root-metadata contract, which both modes load first, and the mode's own `references/<key>/` plus `assets/<key>/` trees, where `create-skill` resolves the `skill` key and `create-skill-parent` resolves `parent-skill`.\n28: \n29: ---\n30: \n31: ## 2. INTENT MODEL\n32: \n33: - **`SKILL_PACKAGE`** fires on `create skill`, `/create:skill`, `new skill`, `skill scaffold`, `SKILL.md scaffold`, `OpenCode skill`, `sk-skill`, `create sk-`, `reusable capability`, `reusable helper`, `starter reference docs`, `package skill`, `doc rewrite guard`, `doc-rewrite-guard.py`, `render ledger`, `render-known-debt.json`, `exempt from the render checks`, `render exempt map`, `kept every claim` and `kept every original claim` at weight 4. It loads the five shared docs — `references/shared/overview.md`, `references/shared/common-pitfalls.md`, `references/shared/validation-and-packaging.md`, `references/shared/advisor-index-handoff.md`, `references/shared/skill-root-metadata-contract.md` — then `references/skill/creation-workflow.md`, `references/skill/examples-and-maintenance.md`, `references/skill/upgrading-a-skill-to-v4.md`, and the nine `assets/skill/` templates: `assets/skill/skill-md-template.md`, `assets/skill/skill-readme-template.md`, `assets/skill/skill-reference-template.md`, `assets/skill/skill-asset-template.md`, `assets/skill/skill-procedure-template.md`, `assets/skill/skill-scaffold-template.md`, `assets/skill/skill-smart-router.md`, `assets/skill/skill-router-template.md`, `assets/skill/skill-sync-manifest-template.md`.\n34: - **`PARENT_HUB`** fires on `/create:skill-parent`, `parent skill`, `parent hub`, `mode packet`, `nested workflow packet`, `mode-registry.json` and `hub-router.json` at weight 4. It loads the same five shared docs, then `references/parent-skill/parent-skills-nested-packets.md`, `references/parent-skill/parent-hub-router-schema.md`, `references/parent-skill/compiled-routing-architecture.md`, and the five `assets/parent-skill/` templates: `assets/parent-skill/parent-skill-hub-template.md`, `assets/parent-skill/parent-skill-readme-template.md`, `assets/parent-skill/parent-skill-root-router-template.md`, `assets/parent-skill/scaffold/hub-skill-scaffold.md`, `assets/parent-skill/scaffold/packet-skill-scaffold.md`.\n35: \n36: ---\n37: \n38: ## 3. MACHINE ROUTER\n39: \n40: The one machine-readable projection of the intent model above, written as `## MACHINE ROUTER` so every\n41: reader finds it. This section is the last in the file, and it holds the only pseudocode.\n42: \n43: This section holds the packet's mode tree, its route selection, the resource domains it loads and the smart-router pseudocode that reads them.\n44: \n45: ### Primary Detection Signal\n46: \n47: ```text\n48: SKILL AUTHORING REQUEST\n49:     |\n50:     +- Standalone skill -> workflowMode: sk-create-skill\n51:     |   +- scripts/init_skill.py\n52:     |   +- assets/skill/skill-md-template.md\n53:     |   +- assets/skill/skill-readme-template.md\n54:     |   +- assets/skill/skill-sync-manifest-template.md\n55:     |\n56:     +- Parent hub -> workflowMode: sk-create-skill-parent\n57:         +- assets/parent-skill/parent-skill-hub-template.md\n58:         +- assets/parent-skill/parent-skill-registry-template.json\n59:         +- assets/parent-skill/parent-skill-hub-router-template.json\n60: ```\n61: \n62: ### Route Selection\n63: \n64: Choose `create-skill` when the artifact is one skill with one advisor identity and one runtime contract.\n65: \n66: Choose `create-skill-parent` when the artifact is one advisor-routable hub that dispatches to nested workflow packets or read-only surface packets.\n67: \n68: Ask one focused clarification before authoring if it is unclear whether the user wants a standalone skill or a parent hub.\n69: \n70: ### Resource Domains\n71: \n72: | Domain | Core Resources | Use |\n73: | --- | --- | --- |\n74: | Scaffolding | `scripts/init_skill.py`, `assets/skill/skill-md-template.md`, `assets/skill/skill-readme-template.md`, `assets/skill/skill-router-template.md` | Create or normalize standalone skill files. |\n75: | Resource templates | `assets/skill/skill-reference-template.md`, `assets/skill/skill-asset-template.md`, `assets/skill/skill-smart-router.md` | Create routed references, assets, and resilient smart-router pseudocode. |\n76: | Runtime sync manifests | `assets/skill/skill-sync-manifest-template.md` | Document how a runtime config dir derives from the canonical `.skilled` tree (SYNC manifest). |\n77: | Procedure cards | `assets/skill/skill-procedure-template.md` | Add a private, triggerable internal procedure to a skill or mode without a new public identity. |\n78: | Parent hubs | `assets/parent-skill/parent-skill-*` | Create hub SKILL, registry, router, description, and graph metadata files. |\n79: | Validation | `scripts/package_skill.py`, `../shared/scripts/extract_structure.py` | Check completion, package distribution zips, and inspect structure. |\n80: | Leaf-route replay | `scripts/leaf-route-replay.cjs` | Replay the committed stage-two keyword block of each hub's `ROUTER.md` against its gold scenarios with zero model calls. `--transcripts` recounts `ROUTER.md` reads and `--prose` compares the prose arm. |\n81: | Overflow detail | `references/README.md`, `references/{shared,skill,parent-skill}/`, `../shared/` | Load only for edge cases, exhaustive examples, or schema details beyond this SKILL.md. |\n82: \n83: ### Smart Router Pseudocode\n84: \n85: ```python\n86: from pathlib import Path\n87: \n88: SKILL_ROOT = Path(__file__).resolve().parent\n89: RESOURCE_BASES = (SKILL_ROOT / \"references\", SKILL_ROOT / \"assets\")\n90: DEFAULT_RESOURCE = \"references/README.md\"\n91: RESOURCE_KEY_BY_MODE = {\n92:     \"sk-create-skill\": \"skill\",\n93:     \"sk-create-skill-parent\": \"parent-skill\",\n94: }\n95: \n96: INTENT_MODEL = {\n97:     \"SKILL_PACKAGE\": {\"weight\": 4, \"keywords\": [\"create skill\", \"/create:skill\", \"new skill\", \"skill scaffold\", \"skill.md scaffold\", \"opencode skill\", \"sk-skill\", \"create sk-\", \"reusable capability\", \"reusable helper\", \"starter reference docs\", \"package skill\", \"doc rewrite guard\", \"doc-rewrite-guard.py\", \"render ledger\", \"render-known-debt.json\", \"exempt from the render checks\", \"render exempt map\", \"kept every claim\", \"kept every original claim\"]},\n98:     \"PARENT_HUB\": {\"weight\": 4, \"keywords\": [\"/create:skill-parent\", \"parent skill\", \"parent hub\", \"mode packet\", \"nested workflow packet\", \"mode-registry.json\", \"hub-router.json\"]},\n99: }\n100: \n101: # The keyed selection below resolves to exactly these sets. Enumerating them keeps\n102: # the routed inventory legible to a reader and to the connectivity scan, which is\n103: # what catches a new reference that the keyed load silently picks up but no\n104: # documented route names.\n105: RESOURCE_MAP = {\n106:     \"SKILL_PACKAGE\": [\n107:         \"references/shared/overview.md\",\n108:         \"references/shared/common-pitfalls.md\",\n109:         \"references/shared/validation-and-packaging.md\",\n110:         \"references/shared/advisor-index-handoff.md\",\n111:         \"references/shared/skill-root-metadata-contract.md\",\n112:         \"references/skill/creation-workflow.md\",\n113:         \"references/skill/examples-and-maintenance.md\",\n114:         \"references/skill/upgrading-a-skill-to-v4.md\",\n115:         \"assets/skill/skill-md-template.md\",\n116:         \"assets/skill/skill-readme-template.md\",\n117:         \"assets/skill/skill-reference-template.md\",\n118:         \"assets/skill/skill-asset-template.md\",\n119:         \"assets/skill/skill-procedure-template.md\",\n120:         \"assets/skill/skill-scaffold-template.md\",\n121:         \"assets/skill/skill-smart-router.md\",\n122:         \"assets/skill/skill-router-template.md\",\n123:         \"assets/skill/skill-sync-manifest-template.md\",\n124:     ],\n125:     \"PARENT_HUB\": [\n126:         \"references/shared/overview.md\",\n127:         \"references/shared/common-pitfalls.md\",\n128:         \"references/shared/validation-and-packaging.md\",\n129:         \"references/shared/advisor-index-handoff.md\",\n130:         \"references/shared/skill-root-metadata-contract.md\",\n131:         \"references/parent-skill/parent-skills-nested-packets.md\",\n132:         \"references/parent-skill/parent-hub-router-schema.md\",\n133:         \"references/parent-skill/compiled-routing-architecture.md\",\n134:         \"assets/parent-skill/parent-skill-hub-template.md\",\n135:         \"assets/parent-skill/parent-skill-readme-template.md\",\n136:         \"assets/parent-skill/parent-skill-root-router-template.md\",\n137:         \"assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n138:         \"assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n139:     ],\n140: }\n141: UNKNOWN_FALLBACK_CHECKLIST = [\n142:     \"Confirm whether the artifact is a standalone skill or parent hub\",\n143:     \"Confirm the target skill folder and intended advisor identity\",\n144:     \"Provide one concrete trigger, output contract, or resource example\",\n145:     \"Confirm the validation command before completion\",\n146: ]\n147: \n148: def discover_markdown_resources() -> set[str]:\n149:     docs = []\n150:     for base in RESOURCE_BASES:\n151:         if base.exists():\n152:             docs.extend(path for path in base.rglob(\"*.md\") if path.is_file())\n153:     return {doc.relative_to(SKILL_ROOT).as_posix() for doc in docs}\n154: \n155: def _guard_in_skill(relative_path: str) -> str:\n156:     resolved = (SKILL_ROOT / relative_path).resolve()\n157:     resolved.relative_to(SKILL_ROOT)\n158:     if resolved.suffix.lower() != \".md\":\n159:         raise ValueError(f\"Only markdown resources are routable: {relative_path}\")\n160:     return resolved.relative_to(SKILL_ROOT).as_posix()\n161: \n162: def load_if_available(relative_path: str, inventory: set[str], loaded: list[str], seen: set[str]) -> None:\n163:     guarded = _guard_in_skill(relative_path)\n164:     if guarded in inventory and guarded not in seen:\n165:         load(guarded)\n166:         loaded.append(guarded)\n167:         seen.add(guarded)\n168: \n169: def route_skill_authoring_request(request):\n170:     inventory = discover_markdown_resources()\n171:     loaded, seen = [], set()\n172: \n173:     if asks_for_parent_hub_or_mode_registry(request):\n174:         workflow_mode = \"sk-create-skill-parent\"\n175:     elif asks_for_nested_workflow_or_surface_packets(request):\n176:         workflow_mode = \"sk-create-skill-parent\"\n177:     elif asks_for_one_skill_package(request):\n178:         workflow_mode = \"sk-create-skill\"\n179:     elif unclear_standalone_vs_parent(request):\n180:         load_if_available(DEFAULT_RESOURCE, inventory, loaded, seen)\n181:         return {\n182:             \"load_level\": \"UNKNOWN_FALLBACK\",\n183:             \"needs_disambiguation\": True,\n184:             \"disambiguation_checklist\": UNKNOWN_FALLBACK_CHECKLIST,\n185:             \"resources\": loaded,\n186:         }\n187:     else:\n188:         load_if_available(DEFAULT_RESOURCE, inventory, loaded, seen)\n189:         return {\"load_level\": \"DEFER\", \"next\": \"matching sk-doc packet\", \"resources\": loaded}\n190: \n191:     routing_key = RESOURCE_KEY_BY_MODE[workflow_mode]\n192:     shared_refs = sorted(path for path in inventory if path.startswith(\"references/shared/\"))\n193:     keyed_refs = sorted(path for path in inventory if path.startswith(f\"references/{routing_key}/\"))\n194:     keyed_assets = sorted(path for path in inventory if path.startswith(f\"assets/{routing_key}/\"))\n195: \n196:     if not keyed_refs and not keyed_assets:\n197:         load_if_available(DEFAULT_RESOURCE, inventory, loaded, seen)\n198:         return {\n199:             \"workflowMode\": workflow_mode,\n200:             \"routing_key\": routing_key,\n201:             \"notice\": f\"No create-skill resources found for routing key '{routing_key}'\",\n202:             \"resources\": loaded,\n203:         }\n204: \n205:     for path in shared_refs + keyed_refs + keyed_assets:\n206:         load_if_available(path, inventory, loaded, seen)\n207: \n208:     return {\"workflowMode\": workflow_mode, \"routing_key\": routing_key, \"resources\": loaded}\n209: ```"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/ROUTER.md\"}"},"time":{"start":1794582796710,"end":1794582797638}}}}
{"type":"step_finish","timestamp":1794582799125,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"id":"prt_1d5786315001kpBbYXuqGIxiQk","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578445e001E8nsbhhL1Wr8sP","type":"step-finish","reason":"tool-calls","cost":0,"tokens":{"input":1739,"output":370,"reasoning":359,"cache":{"read":32512,"write":0}}}}
{"type":"step_start","timestamp":1794582801862,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"id":"prt_1d5786dc6001zHJIeE3pwcIki5","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578631a001E6KGPTUnximQa4","type":"step-start"}}
{"type":"tool_use","timestamp":1794582806891,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d5787550001rDd1pnFuy4N0wG","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578631a001E6KGPTUnximQa4","type":"tool","id":"chatcmpl-tool-ab4109ae42518cda","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/skill/upgrading-a-skill-to-v4.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/skill/upgrading-a-skill-to-v4.md, lines 1-270\n1: ---\n2: title: Upgrading a Customized Skill to v4\n3: description: Adopter guide for reconciling a customized standalone skill with the v4 parent-hub format, or keeping that skill single.\n4: trigger_phrases:\n5:   - \"upgrade skill to v4\"\n6:   - \"convert standalone skill to parent hub\"\n7:   - \"adopter customized sk-code\"\n8:   - \"keep sk-git as a single skill\"\n9:   - \"remove repo parent skill\"\n10: importance_tier: normal\n11: contextType: implementation\n12: version: 1.2.11.0\n13: ---\n14: \n15: # Upgrading a Customized Skill to v4\n16: \n17: Adopters who customized `sk-code` (their stack) or `sk-git` (their conventions) use this guide to decide whether that skill becomes a parent hub or stays a single skill. Most other skills in this framework are internals and need no adopter work.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: ### Purpose\n24: \n25: v4 reshaped `sk-code` into a parent hub: one advisor identity that dispatches to nested workflow-mode packets and read-only surface packets. `sk-git` stayed a single skill. This file is the adopter-facing path for reconciling a customized copy with that split.\n26: \n27: ### When to Use\n28: \n29: - You customized `sk-code` or `sk-git` and a framework update now ships a different shape\n30: - You are deciding whether a flat skill should become a parent hub\n31: - You want to keep a customized skill single and avoid a false migration\n32: - You have a single skill in a plain or older Skilled shape, and you want it converted in place so it passes the format gate\n33: \n34: **Core Principle**: Convert a skill into a parent hub only when it has two or more distinct jobs. Keep it single when it has one job. You may also drop the repo's parent `sk-code` and keep your own single skill.\n35: \n36: **When not to Use**:\n37: - You are creating a brand-new skill from scratch. Use `/create:skill` or `/create:skill-parent` directly. See [creation-workflow.md](creation-workflow.md) and [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md)\n38: - You are only scoring or editing prose in an existing skill. Use `create-quality-control`\n39: - You are tempted to convert framework-internal skills (`sk-doc`, `system-spec-kit`, `system-deep-loop`, and peers). Leave those alone\n40: \n41: **Key Sources**:\n42: - `/create:skill-parent` - parent-hub scaffold (`create` or `update`). Argument order is `<skill-name> [create|update] [--modes <m1,m2,...>] [--surfaces <s1,s2,...>] [--path <dir>]`\n43: - `/create:skill` - standalone scaffold and repair (`full-create`, `full-update`, `reference-only`, `asset-only`)\n44: - [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md) - hub layout, `modes[]`, One-Identity Invariant\n45: - [parent-hub-router-schema.md](../parent-skill/parent-hub-router-schema.md) - `hub-router.json` contract\n46: - [skill-root-metadata-contract.md](../shared/skill-root-metadata-contract.md) - class H (hub) vs class S (standalone) file matrix\n47: - `scripts/validate_skill_package.py` - completion gate\n48: - `.skilled/commands/doctor/scripts/parent-skill-check.cjs` - parent-hub structural and routing audit\n49: - `/doctor:sk-skill convert <name-or-path>` - conversion for a skill that stays single: it plans, waits for your yes, and moves a legacy machine router into the sibling `ROUTER.md`, or stages a plain skill as a new root. It refuses a hub candidate, which it recognises by a hub declaration or a nested packet tree, and a skill that really holds two or more jobs belongs to `/create:skill-parent`\n50: - `/doctor:sk-skill check <name-or-path>` - reads the same requirements row by row without writing, so you can see the gap before converting\n51: \n52: The live layout to copy from is `.skilled/skills/sk-code/` (parent hub) and `.skilled/skills/sk-git/` (single skill).\n53: \n54: ---\n55: \n56: ## 2. DECISION RULE\n57: \n58: Count distinct jobs, not files.\n59: \n60: A **job** is a process the assistant follows (a workflow mode) or a read-only evidence base it loads beside that process (a surface packet). Two quality-gate checklists in the same `SKILL.md` are still one job. Implement versus review, or two different surface evidence sets, are distinct jobs.\n61: \n62: | What you have | What you do |\n63: | --- | --- |\n64: | One job | Keep a single skill (class S). Do not add `mode-registry.json` or `hub-router.json` |\n65: | Two or more distinct jobs | Convert to a parent hub (class H) with `/create:skill-parent` |\n66: | A customized single `sk-code` you want to keep | Remove or ignore the repo's parent `sk-code` and keep your own single skill. See [Section 3](#3-adopter-cases) |\n67: \n68: Choose **workflow** packets for process (quality, review, implement). Choose **surface** packets for read-only stack evidence. The test is in [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md) section 6.\n69: \n70: Do not invent a third class. A root is a hub when both `mode-registry.json` and `hub-router.json` exist, and standalone when neither exists. One file without the other is a partial declaration. `validate_skill_package.py` rejects that as unclassified.\n71: \n72: ---\n73: \n74: ## 3. ADOPTER CASES\n75: \n76: ### `sk-code`: convert to parent, or keep your own single skill\n77: \n78: The repo now ships `sk-code` as a parent hub. Workflow packets `sk-code-quality` and `sk-code-review` act. The surface packets `sk-code-ci`, `sk-code-frontend` and `sk-code-skilled` are read-only evidence. `graph-metadata.json` lives only at `.skilled/skills/sk-code/`. Nested packets have none.\n79: \n80: You have two legal outcomes:\n81: \n82: 1. **Convert-to-parent.** Follow [Section 4](#4-convert-a-single-skill-into-a-parent-hub) so your customized stack becomes nested packets under one hub identity.\n83: 2. **Remove-repo-and-keep-own-single.** Keep your customized standalone `.skilled/skills/sk-code/` (class S: `graph-metadata.json`, `leaf-manifest.config.json` and `ROUTER.md`, with no `mode-registry.json` or `hub-router.json`). When you take a framework update, do not replace that folder with the repo's parent-hub tree.\n84: \n85: `/create:skill-parent` has no convert-in-place flag, so keeping your own single skill is a merge-time choice, not a `/create:*` operation. A skill that stays single does convert in place, and that path is `/doctor:sk-skill convert`.\n86: \n87: ### `sk-git`: the repo ships it single\n88: \n89: The repo ships `sk-git` as a single skill. It has `graph-metadata.json` and `leaf-manifest.config.json`. It has no `mode-registry.json` and no `hub-router.json`.\n90: \n91: Keep it single if git work stays one job (worktree, commit, finish under one contract). Promote it to a parent hub only if you have split that work into two or more distinct jobs and want one advisor identity in front of them. That promotion is your preference, not a framework requirement.\n92: \n93: ### Most other skills need no adopter action\n94: \n95: `sk-doc`, `sk-design`, `sk-prompt`, `system-spec-kit`, `system-skill-advisor`, `system-deep-loop`, `mcp-tooling`, and `cli-external-orchestration` are framework internals. They are repo-agnostic. Do not convert them, flatten them, or \"upgrade\" them to match `sk-code`. Over-migrating those trees is how adopters create rogue advisor identities and routing drift.\n96: \n97: ---\n98: \n99: ## 4. CONVERT A SINGLE SKILL INTO A PARENT HUB\n100: \n101: Use existing tooling only.\n102: - `/create:skill-parent` is the scaffold.\n103: - `create` will not write on top of an occupied folder (`requires_existing_skill: false`).\n104: - There is no in-place `--convert` flag here, because converting a skill into a hub is a scaffold-then-move, not an edit.\n105: - A single skill does convert through `/doctor:sk-skill convert`, in place when it is an older Skilled skill and as a staged new root when it is a plain one, and that command refuses a hub candidate so a skill that really holds two jobs lands here.\n106: \n107: The command requires `@markdown` for template-first generation. Restart with that prefix if the self-check blocks.\n108: \n109: ### Step 1. Inventory jobs and name the packets\n110: \n111: List every distinct job. Mark each as `workflow` or `surface`. Pick hyphen-case mode names.\n112: \n113: **Failure this prevents:** scaffolding one `primary` packet and stuffing every job back into a single `SKILL.md`, which recreates the flat skill under a hub costume.\n114: \n115: ### Step 2. Move the existing skill aside\n116: \n117: Copy the customized folder out of `.skilled/skills/<name>` to a backup path you control. Leave the destination name free.\n118: \n119: **Failure this prevents:** `/create:skill-parent <name> create` stopping because the folder already exists, or the scaffold overwriting your customized `SKILL.md` and references.\n120: \n121: ### Step 3. Scaffold the hub with `/create:skill-parent`\n122: \n123: ```text\n124: @markdown /create:skill-parent <skill-name> create --modes <mode1,mode2,...> [--surfaces <s1,s2,...>] [--path .skilled/skills] [:auto|:confirm]\n125: ```\n126: \n127: `--modes` is required. Do not omit it. `--surfaces` is optional. `--path` defaults to `.skilled/skills/`.\n128: \n129: Example for a customized `sk-code` with quality, review, and two evidence bases:\n130: \n131: ```text\n132: @markdown /create:skill-parent sk-code create --modes quality,review --surfaces acme,opencode\n133: ```\n134: \n135: That command creates:\n136: \n137: - A thin hub `SKILL.md` (routing only)\n138: - `mode-registry.json`, `hub-router.json`, `description.json`, and exactly one hub `graph-metadata.json`\n139: - One workflow packet per distinct mode, folder `[hub-prefix]-<mode>` (so `--modes quality,review` under `sk-code` yields `sk-code-quality` and `sk-code-review`)\n140: - Optional surface packets from `--surfaces` as **bare-noun** folders (`acme`, `opencode`), each `packetKind: surface`\n141: - Hub `changelog/`, `manual-testing-playbook/`, and a non-discoverable `shared/` with `shared/README.md`\n142: - No `graph-metadata.json` inside any packet or inside `shared/`\n143: \n144: **Surface folder names.** The command scaffolds `--surfaces` as bare-noun folders. The published nested-packet convention and the live `sk-code` hub use hub-prefixed surface folders (`sk-code-skilled`, `sk-code-ci`). After scaffold, rename those folders so `folder == packetSkillName` and update `modes[].packet` plus `modes[].packetSkillName`. No `--surface-prefix` flag exists.\n145: \n146: **One-Identity Invariant.** The hub owns exactly one `graph-metadata.json`. Never add one inside a mode packet or inside `shared/`. A nested copy becomes a second advisor identity.\n147: \n148: **Do not use `init_skill.py --kind parent` as a substitute for this step.** That helper exists and takes `--path` plus optional `--compiled-routing legacy|ready`. It scaffolds one `primary` packet and does not accept `--modes` or `--surfaces`. A multi-job conversion needs the slash command above.\n149: \n150: **Failure this prevents:** a hand-rolled hub missing `hub-router.json`, a nested `graph-metadata.json`, or a `surfacePackets[]` array the checker does not read.\n151: \n152: ### Step 4. Move the flat skill body into the matching packet\n153: \n154: Open the backup `SKILL.md`. Keep the hub `SKILL.md` thin (activation, routing, rules, success criteria). Move the executable workflow body into the matching workflow-mode packet `SKILL.md`. If the old skill was only stack evidence, move that body into a surface packet instead.\n155: \n156: Move `references/`, `assets/`, and `scripts/` with the body that uses them. Put a helper in `shared/` only when two or more packets genuinely share it.\n157: \n158: Give each packet its own `SKILL.md`, `README.md`, and `changelog/`. Surface packets also get `references/` and `assets/` when they carry evidence.\n159: \n160: Do not copy `leaf-manifest.config.json` onto the hub. That file is required on a standalone root and **forbidden** on a hub. Class H generates `leaf-manifest.json` from the registry. See [skill-root-metadata-contract.md](../shared/skill-root-metadata-contract.md).\n161: \n162: **Failure this prevents:** a hub `SKILL.md` that still runs the old workflow (the router never reaches the packet) and a `FORBIDDEN_FILE` failure from a leftover standalone manifest config.\n163: \n164: ### Step 5. Register every packet in `mode-registry.json` and keep the router in parity\n165: \n166: Every packet is one `modes[]` entry. Required fields are `workflowMode`, `packetKind`, `backendKind`, `toolSurface`, `packet`, `packetSkillName`, `grandfatheredFolderMismatch`, `aliases`, and `advisorRouting`. New packets keep `folder == packetSkillName` and `grandfatheredFolderMismatch: false`. Keep aliases unique and lowercase.\n167: \n168: Then keep `hub-router.json` aligned:\n169: \n170: - `routerSignals` keys must equal the registry `workflowMode` set both ways\n171: - `routerPolicy.tieBreak` lists every registry mode once, workflow modes before surfaces\n172: - Outcomes include `single`, `orderedBundle`, and `defer`. Add `surfaceBundle` only when the hub has surface packets (`surface-axis`)\n173: - Every `resources[]` path is hub-root-relative and packet-qualified (`sk-code-quality/SKILL.md`, not `SKILL.md`)\n174: \n175: Schema detail lives in [parent-hub-router-schema.md](../parent-skill/parent-hub-router-schema.md). Do not add a second registry array.\n176: \n177: After the registry and packet trees are final, refresh the hub-only leaf manifest:\n178: \n179: ```bash\n180: node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --write .skilled/skills/<hub-name>\n181: ```\n182: \n183: That is the scoped generator `/create:skill-parent` already runs. Do not run fleet `ci-skill-root-metadata.cjs --fix` unless you intend to regenerate generated files across every scanned root.\n184: \n185: **Failure this prevents:** check 5 routing drift (`routerSignals` keys that do not match `modes[].workflowMode`), orphan packets on disk, and a stale `leaf-manifest.json`.\n186: \n187: ### Step 6. Confirm the One-Identity Invariant on disk\n188: \n189: Count `graph-metadata.json` files under the hub. There must be exactly one, at the hub root. Packets and `shared/` must have zero.\n190: \n191: **Failure this prevents:** parent-skill-check `1a` / `2a` failures and a second skill-graph identity for the same folder name.\n192: \n193: ### Step 7. Validate (see [Section 6](#6-validate))\n194: \n195: Run the completion gate until it exits clean. Then run the routing-drift check if you edited aliases or vocabulary classes.\n196: \n197: **Failure this prevents:** shipping a hub that scaffolds but does not pass the same gate `/create:skill-parent` and `/doctor:skill-advisor parent-skill` require.\n198: \n199: If you need another mode later, use `/create:skill-parent <skill-name> update --modes ...`. Do not re-run `create` on the live folder.\n200: \n201: ---\n202: \n203: ## 5. KEEP A SINGLE SKILL\n204: \n205: Stay on class S when the skill still has one job.\n206: \n207: A standalone root keeps `SKILL.md`, `ROUTER.md`, `graph-metadata.json`, and `leaf-manifest.config.json`. Its `SKILL.md` links to `./ROUTER.md`. It must not gain `mode-registry.json`, `hub-router.json` or `description.json`. It may add `command-metadata.json` when it owns slash commands, with each entry's `ownerMode` set to the skill's own id. Repair that package with `/create:skill <skill-name> full-update` (or `reference-only` / `asset-only` for a scoped add). `/create:skill <skill-name> full-create` is only for a folder that does not exist yet.\n208: \n209: **Convert a single skill in place.** When the skill has one job and is still in a plain shape, or its machine router still sits inside `SKILL.md`, run `/doctor:sk-skill convert <name-or-path>`. It prints the plan first and writes only after your yes.\n210: - It adds the four-part `version`.\n211: - It writes an `allowed-tools` list only after you approve the list its plan proposes.\n212: - It moves the machine router section verbatim into the sibling `ROUTER.md` and links to it from Smart Routing.\n213: - It stages a plain skill under its own name as a new root once you approve at least eight intent phrases, and the workflow proves the reshaped prose kept every original body line.\n214: - It stops and restores the pre-edit bytes when the parsed router would come out different.\n215: \n216: Run `/doctor:sk-skill check <name-or-path>` first if you want the gap row by row without any write.\n217: \n218: **Failure this prevents:** a hand conversion that passes the format gate but drops a routing intent, or one that leaves the skill with no `ROUTER.md` at all.\n219: \n220: **Keeping your own `sk-code` while the repo ships a parent hub.** Leave your customized `.skilled/skills/sk-code/` in place. Do not copy the repo hub's `mode-registry.json` or `hub-router.json` into it. Adding only one of those two files makes `validate_skill_package.py` report a partial hub declaration and refuse to classify the root.\n221: \n222: **Failure this prevents:** a customized single skill that the advisor treats as a broken hub, and a framework update that silently replaces your stack conventions.\n223: \n224: ---\n225: \n226: ## 6. VALIDATE\n227: \n228: Run these from the repository root. End on `validate_skill_package.py` for every conversion or keep-single repair. Add the routing-drift check when you changed aliases, vocabulary classes, or `routerSignals`.\n229: \n230: ### Parent hub (after Section 4)\n231: \n232: Structural audit uses the same checker that `/doctor:skill-advisor parent-skill` runs and the same script that `validate_skill_package.py` invokes for a parent root:\n233: \n234: ```bash\n235: node .skilled/commands/doctor/scripts/parent-skill-check.cjs .skilled/skills/<hub-name>\n236: ```\n237: \n238: Pass looks like `OK: parent-skill-check — all hard invariants passed`. Exit 0. This is the routing-parity gate: `routerSignals` vs `modes[]`, `tieBreak` coverage, `surfaceBundle` only with surfaces, on-disk packet paths, and the one-identity rule.\n239: \n240: Completion gate (must exit clean):\n241: \n242: ```bash\n243: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py .skilled/skills/<hub-name>\n244: ```\n245: \n246: For a parent root this runs `package_skill.py --check`, compiled-routing readiness, and `parent-skill-check.cjs`. Pass prints `Detected kind: parent` and each check as `PASS (exit 0)`. The report is clean only when the process itself exits 0.\n247: \n248: Keep the compiled-routing directive block the hub template ships in `SKILL.md`. Removing it fails compiled-routing readiness even if the checker is otherwise green.\n249: \n250: ### Standalone skill (after Section 5)\n251: \n252: ```bash\n253: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py .skilled/skills/<skill-name>\n254: ```\n255: \n256: Pass prints `Detected kind: standalone` and `package_skill.py --check: PASS (exit 0)`. The fleet gate `ci-skill-root-metadata.cjs` also runs the `ROUTER.md` contract on a standalone root and reports `RRC` codes, so a missing file or a missing link fails there. Do not run `parent-skill-check.cjs` on a single skill. That script audits hubs and their packets.\n257: \n258: `--strict` promotes noncanonical generated paths from advisory to blocking. Use it on a newly generated package.\n259: \n260: ---\n261: \n262: ## 7. RELATED RESOURCES\n263: \n264: - [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md) - hub shape, `packetKind`, One-Identity Invariant\n265: - [parent-hub-router-schema.md](../parent-skill/parent-hub-router-schema.md) - `hub-router.json` fields and check 5\n266: - [skill-root-metadata-contract.md](../shared/skill-root-metadata-contract.md) - class H vs class S required and forbidden files\n267: - [validation-and-packaging.md](../shared/validation-and-packaging.md) - completion gate and packaging\n268: - [creation-workflow.md](creation-workflow.md) - standalone create path\n269: - `.skilled/commands/create/skill-parent.md` - `/create:skill-parent` operations `create` and `update`\n270: - `.skilled/commands/create/skill.md` - `/create:skill` operations `full-create`, `full-update`, `reference-only`, `asset-only`","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/skill/upgrading-a-skill-to-v4.md, lines 1-270\n1: ---\n2: title: Upgrading a Customized Skill to v4\n3: description: Adopter guide for reconciling a customized standalone skill with the v4 parent-hub format, or keeping that skill single.\n4: trigger_phrases:\n5:   - \"upgrade skill to v4\"\n6:   - \"convert standalone skill to parent hub\"\n7:   - \"adopter customized sk-code\"\n8:   - \"keep sk-git as a single skill\"\n9:   - \"remove repo parent skill\"\n10: importance_tier: normal\n11: contextType: implementation\n12: version: 1.2.11.0\n13: ---\n14: \n15: # Upgrading a Customized Skill to v4\n16: \n17: Adopters who customized `sk-code` (their stack) or `sk-git` (their conventions) use this guide to decide whether that skill becomes a parent hub or stays a single skill. Most other skills in this framework are internals and need no adopter work.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: ### Purpose\n24: \n25: v4 reshaped `sk-code` into a parent hub: one advisor identity that dispatches to nested workflow-mode packets and read-only surface packets. `sk-git` stayed a single skill. This file is the adopter-facing path for reconciling a customized copy with that split.\n26: \n27: ### When to Use\n28: \n29: - You customized `sk-code` or `sk-git` and a framework update now ships a different shape\n30: - You are deciding whether a flat skill should become a parent hub\n31: - You want to keep a customized skill single and avoid a false migration\n32: - You have a single skill in a plain or older Skilled shape, and you want it converted in place so it passes the format gate\n33: \n34: **Core Principle**: Convert a skill into a parent hub only when it has two or more distinct jobs. Keep it single when it has one job. You may also drop the repo's parent `sk-code` and keep your own single skill.\n35: \n36: **When not to Use**:\n37: - You are creating a brand-new skill from scratch. Use `/create:skill` or `/create:skill-parent` directly. See [creation-workflow.md](creation-workflow.md) and [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md)\n38: - You are only scoring or editing prose in an existing skill. Use `create-quality-control`\n39: - You are tempted to convert framework-internal skills (`sk-doc`, `system-spec-kit`, `system-deep-loop`, and peers). Leave those alone\n40: \n41: **Key Sources**:\n42: - `/create:skill-parent` - parent-hub scaffold (`create` or `update`). Argument order is `<skill-name> [create|update] [--modes <m1,m2,...>] [--surfaces <s1,s2,...>] [--path <dir>]`\n43: - `/create:skill` - standalone scaffold and repair (`full-create`, `full-update`, `reference-only`, `asset-only`)\n44: - [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md) - hub layout, `modes[]`, One-Identity Invariant\n45: - [parent-hub-router-schema.md](../parent-skill/parent-hub-router-schema.md) - `hub-router.json` contract\n46: - [skill-root-metadata-contract.md](../shared/skill-root-metadata-contract.md) - class H (hub) vs class S (standalone) file matrix\n47: - `scripts/validate_skill_package.py` - completion gate\n48: - `.skilled/commands/doctor/scripts/parent-skill-check.cjs` - parent-hub structural and routing audit\n49: - `/doctor:sk-skill convert <name-or-path>` - conversion for a skill that stays single: it plans, waits for your yes, and moves a legacy machine router into the sibling `ROUTER.md`, or stages a plain skill as a new root. It refuses a hub candidate, which it recognises by a hub declaration or a nested packet tree, and a skill that really holds two or more jobs belongs to `/create:skill-parent`\n50: - `/doctor:sk-skill check <name-or-path>` - reads the same requirements row by row without writing, so you can see the gap before converting\n51: \n52: The live layout to copy from is `.skilled/skills/sk-code/` (parent hub) and `.skilled/skills/sk-git/` (single skill).\n53: \n54: ---\n55: \n56: ## 2. DECISION RULE\n57: \n58: Count distinct jobs, not files.\n59: \n60: A **job** is a process the assistant follows (a workflow mode) or a read-only evidence base it loads beside that process (a surface packet). Two quality-gate checklists in the same `SKILL.md` are still one job. Implement versus review, or two different surface evidence sets, are distinct jobs.\n61: \n62: | What you have | What you do |\n63: | --- | --- |\n64: | One job | Keep a single skill (class S). Do not add `mode-registry.json` or `hub-router.json` |\n65: | Two or more distinct jobs | Convert to a parent hub (class H) with `/create:skill-parent` |\n66: | A customized single `sk-code` you want to keep | Remove or ignore the repo's parent `sk-code` and keep your own single skill. See [Section 3](#3-adopter-cases) |\n67: \n68: Choose **workflow** packets for process (quality, review, implement). Choose **surface** packets for read-only stack evidence. The test is in [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md) section 6.\n69: \n70: Do not invent a third class. A root is a hub when both `mode-registry.json` and `hub-router.json` exist, and standalone when neither exists. One file without the other is a partial declaration. `validate_skill_package.py` rejects that as unclassified.\n71: \n72: ---\n73: \n74: ## 3. ADOPTER CASES\n75: \n76: ### `sk-code`: convert to parent, or keep your own single skill\n77: \n78: The repo now ships `sk-code` as a parent hub. Workflow packets `sk-code-quality` and `sk-code-review` act. The surface packets `sk-code-ci`, `sk-code-frontend` and `sk-code-skilled` are read-only evidence. `graph-metadata.json` lives only at `.skilled/skills/sk-code/`. Nested packets have none.\n79: \n80: You have two legal outcomes:\n81: \n82: 1. **Convert-to-parent.** Follow [Section 4](#4-convert-a-single-skill-into-a-parent-hub) so your customized stack becomes nested packets under one hub identity.\n83: 2. **Remove-repo-and-keep-own-single.** Keep your customized standalone `.skilled/skills/sk-code/` (class S: `graph-metadata.json`, `leaf-manifest.config.json` and `ROUTER.md`, with no `mode-registry.json` or `hub-router.json`). When you take a framework update, do not replace that folder with the repo's parent-hub tree.\n84: \n85: `/create:skill-parent` has no convert-in-place flag, so keeping your own single skill is a merge-time choice, not a `/create:*` operation. A skill that stays single does convert in place, and that path is `/doctor:sk-skill convert`.\n86: \n87: ### `sk-git`: the repo ships it single\n88: \n89: The repo ships `sk-git` as a single skill. It has `graph-metadata.json` and `leaf-manifest.config.json`. It has no `mode-registry.json` and no `hub-router.json`.\n90: \n91: Keep it single if git work stays one job (worktree, commit, finish under one contract). Promote it to a parent hub only if you have split that work into two or more distinct jobs and want one advisor identity in front of them. That promotion is your preference, not a framework requirement.\n92: \n93: ### Most other skills need no adopter action\n94: \n95: `sk-doc`, `sk-design`, `sk-prompt`, `system-spec-kit`, `system-skill-advisor`, `system-deep-loop`, `mcp-tooling`, and `cli-external-orchestration` are framework internals. They are repo-agnostic. Do not convert them, flatten them, or \"upgrade\" them to match `sk-code`. Over-migrating those trees is how adopters create rogue advisor identities and routing drift.\n96: \n97: ---\n98: \n99: ## 4. CONVERT A SINGLE SKILL INTO A PARENT HUB\n100: \n101: Use existing tooling only.\n102: - `/create:skill-parent` is the scaffold.\n103: - `create` will not write on top of an occupied folder (`requires_existing_skill: false`).\n104: - There is no in-place `--convert` flag here, because converting a skill into a hub is a scaffold-then-move, not an edit.\n105: - A single skill does convert through `/doctor:sk-skill convert`, in place when it is an older Skilled skill and as a staged new root when it is a plain one, and that command refuses a hub candidate so a skill that really holds two jobs lands here.\n106: \n107: The command requires `@markdown` for template-first generation. Restart with that prefix if the self-check blocks.\n108: \n109: ### Step 1. Inventory jobs and name the packets\n110: \n111: List every distinct job. Mark each as `workflow` or `surface`. Pick hyphen-case mode names.\n112: \n113: **Failure this prevents:** scaffolding one `primary` packet and stuffing every job back into a single `SKILL.md`, which recreates the flat skill under a hub costume.\n114: \n115: ### Step 2. Move the existing skill aside\n116: \n117: Copy the customized folder out of `.skilled/skills/<name>` to a backup path you control. Leave the destination name free.\n118: \n119: **Failure this prevents:** `/create:skill-parent <name> create` stopping because the folder already exists, or the scaffold overwriting your customized `SKILL.md` and references.\n120: \n121: ### Step 3. Scaffold the hub with `/create:skill-parent`\n122: \n123: ```text\n124: @markdown /create:skill-parent <skill-name> create --modes <mode1,mode2,...> [--surfaces <s1,s2,...>] [--path .skilled/skills] [:auto|:confirm]\n125: ```\n126: \n127: `--modes` is required. Do not omit it. `--surfaces` is optional. `--path` defaults to `.skilled/skills/`.\n128: \n129: Example for a customized `sk-code` with quality, review, and two evidence bases:\n130: \n131: ```text\n132: @markdown /create:skill-parent sk-code create --modes quality,review --surfaces acme,opencode\n133: ```\n134: \n135: That command creates:\n136: \n137: - A thin hub `SKILL.md` (routing only)\n138: - `mode-registry.json`, `hub-router.json`, `description.json`, and exactly one hub `graph-metadata.json`\n139: - One workflow packet per distinct mode, folder `[hub-prefix]-<mode>` (so `--modes quality,review` under `sk-code` yields `sk-code-quality` and `sk-code-review`)\n140: - Optional surface packets from `--surfaces` as **bare-noun** folders (`acme`, `opencode`), each `packetKind: surface`\n141: - Hub `changelog/`, `manual-testing-playbook/`, and a non-discoverable `shared/` with `shared/README.md`\n142: - No `graph-metadata.json` inside any packet or inside `shared/`\n143: \n144: **Surface folder names.** The command scaffolds `--surfaces` as bare-noun folders. The published nested-packet convention and the live `sk-code` hub use hub-prefixed surface folders (`sk-code-skilled`, `sk-code-ci`). After scaffold, rename those folders so `folder == packetSkillName` and update `modes[].packet` plus `modes[].packetSkillName`. No `--surface-prefix` flag exists.\n145: \n146: **One-Identity Invariant.** The hub owns exactly one `graph-metadata.json`. Never add one inside a mode packet or inside `shared/`. A nested copy becomes a second advisor identity.\n147: \n148: **Do not use `init_skill.py --kind parent` as a substitute for this step.** That helper exists and takes `--path` plus optional `--compiled-routing legacy|ready`. It scaffolds one `primary` packet and does not accept `--modes` or `--surfaces`. A multi-job conversion needs the slash command above.\n149: \n150: **Failure this prevents:** a hand-rolled hub missing `hub-router.json`, a nested `graph-metadata.json`, or a `surfacePackets[]` array the checker does not read.\n151: \n152: ### Step 4. Move the flat skill body into the matching packet\n153: \n154: Open the backup `SKILL.md`. Keep the hub `SKILL.md` thin (activation, routing, rules, success criteria). Move the executable workflow body into the matching workflow-mode packet `SKILL.md`. If the old skill was only stack evidence, move that body into a surface packet instead.\n155: \n156: Move `references/`, `assets/`, and `scripts/` with the body that uses them. Put a helper in `shared/` only when two or more packets genuinely share it.\n157: \n158: Give each packet its own `SKILL.md`, `README.md`, and `changelog/`. Surface packets also get `references/` and `assets/` when they carry evidence.\n159: \n160: Do not copy `leaf-manifest.config.json` onto the hub. That file is required on a standalone root and **forbidden** on a hub. Class H generates `leaf-manifest.json` from the registry. See [skill-root-metadata-contract.md](../shared/skill-root-metadata-contract.md).\n161: \n162: **Failure this prevents:** a hub `SKILL.md` that still runs the old workflow (the router never reaches the packet) and a `FORBIDDEN_FILE` failure from a leftover standalone manifest config.\n163: \n164: ### Step 5. Register every packet in `mode-registry.json` and keep the router in parity\n165: \n166: Every packet is one `modes[]` entry. Required fields are `workflowMode`, `packetKind`, `backendKind`, `toolSurface`, `packet`, `packetSkillName`, `grandfatheredFolderMismatch`, `aliases`, and `advisorRouting`. New packets keep `folder == packetSkillName` and `grandfatheredFolderMismatch: false`. Keep aliases unique and lowercase.\n167: \n168: Then keep `hub-router.json` aligned:\n169: \n170: - `routerSignals` keys must equal the registry `workflowMode` set both ways\n171: - `routerPolicy.tieBreak` lists every registry mode once, workflow modes before surfaces\n172: - Outcomes include `single`, `orderedBundle`, and `defer`. Add `surfaceBundle` only when the hub has surface packets (`surface-axis`)\n173: - Every `resources[]` path is hub-root-relative and packet-qualified (`sk-code-quality/SKILL.md`, not `SKILL.md`)\n174: \n175: Schema detail lives in [parent-hub-router-schema.md](../parent-skill/parent-hub-router-schema.md). Do not add a second registry array.\n176: \n177: After the registry and packet trees are final, refresh the hub-only leaf manifest:\n178: \n179: ```bash\n180: node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --write .skilled/skills/<hub-name>\n181: ```\n182: \n183: That is the scoped generator `/create:skill-parent` already runs. Do not run fleet `ci-skill-root-metadata.cjs --fix` unless you intend to regenerate generated files across every scanned root.\n184: \n185: **Failure this prevents:** check 5 routing drift (`routerSignals` keys that do not match `modes[].workflowMode`), orphan packets on disk, and a stale `leaf-manifest.json`.\n186: \n187: ### Step 6. Confirm the One-Identity Invariant on disk\n188: \n189: Count `graph-metadata.json` files under the hub. There must be exactly one, at the hub root. Packets and `shared/` must have zero.\n190: \n191: **Failure this prevents:** parent-skill-check `1a` / `2a` failures and a second skill-graph identity for the same folder name.\n192: \n193: ### Step 7. Validate (see [Section 6](#6-validate))\n194: \n195: Run the completion gate until it exits clean. Then run the routing-drift check if you edited aliases or vocabulary classes.\n196: \n197: **Failure this prevents:** shipping a hub that scaffolds but does not pass the same gate `/create:skill-parent` and `/doctor:skill-advisor parent-skill` require.\n198: \n199: If you need another mode later, use `/create:skill-parent <skill-name> update --modes ...`. Do not re-run `create` on the live folder.\n200: \n201: ---\n202: \n203: ## 5. KEEP A SINGLE SKILL\n204: \n205: Stay on class S when the skill still has one job.\n206: \n207: A standalone root keeps `SKILL.md`, `ROUTER.md`, `graph-metadata.json`, and `leaf-manifest.config.json`. Its `SKILL.md` links to `./ROUTER.md`. It must not gain `mode-registry.json`, `hub-router.json` or `description.json`. It may add `command-metadata.json` when it owns slash commands, with each entry's `ownerMode` set to the skill's own id. Repair that package with `/create:skill <skill-name> full-update` (or `reference-only` / `asset-only` for a scoped add). `/create:skill <skill-name> full-create` is only for a folder that does not exist yet.\n208: \n209: **Convert a single skill in place.** When the skill has one job and is still in a plain shape, or its machine router still sits inside `SKILL.md`, run `/doctor:sk-skill convert <name-or-path>`. It prints the plan first and writes only after your yes.\n210: - It adds the four-part `version`.\n211: - It writes an `allowed-tools` list only after you approve the list its plan proposes.\n212: - It moves the machine router section verbatim into the sibling `ROUTER.md` and links to it from Smart Routing.\n213: - It stages a plain skill under its own name as a new root once you approve at least eight intent phrases, and the workflow proves the reshaped prose kept every original body line.\n214: - It stops and restores the pre-edit bytes when the parsed router would come out different.\n215: \n216: Run `/doctor:sk-skill check <name-or-path>` first if you want the gap row by row without any write.\n217: \n218: **Failure this prevents:** a hand conversion that passes the format gate but drops a routing intent, or one that leaves the skill with no `ROUTER.md` at all.\n219: \n220: **Keeping your own `sk-code` while the repo ships a parent hub.** Leave your customized `.skilled/skills/sk-code/` in place. Do not copy the repo hub's `mode-registry.json` or `hub-router.json` into it. Adding only one of those two files makes `validate_skill_package.py` report a partial hub declaration and refuse to classify the root.\n221: \n222: **Failure this prevents:** a customized single skill that the advisor treats as a broken hub, and a framework update that silently replaces your stack conventions.\n223: \n224: ---\n225: \n226: ## 6. VALIDATE\n227: \n228: Run these from the repository root. End on `validate_skill_package.py` for every conversion or keep-single repair. Add the routing-drift check when you changed aliases, vocabulary classes, or `routerSignals`.\n229: \n230: ### Parent hub (after Section 4)\n231: \n232: Structural audit uses the same checker that `/doctor:skill-advisor parent-skill` runs and the same script that `validate_skill_package.py` invokes for a parent root:\n233: \n234: ```bash\n235: node .skilled/commands/doctor/scripts/parent-skill-check.cjs .skilled/skills/<hub-name>\n236: ```\n237: \n238: Pass looks like `OK: parent-skill-check — all hard invariants passed`. Exit 0. This is the routing-parity gate: `routerSignals` vs `modes[]`, `tieBreak` coverage, `surfaceBundle` only with surfaces, on-disk packet paths, and the one-identity rule.\n239: \n240: Completion gate (must exit clean):\n241: \n242: ```bash\n243: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py .skilled/skills/<hub-name>\n244: ```\n245: \n246: For a parent root this runs `package_skill.py --check`, compiled-routing readiness, and `parent-skill-check.cjs`. Pass prints `Detected kind: parent` and each check as `PASS (exit 0)`. The report is clean only when the process itself exits 0.\n247: \n248: Keep the compiled-routing directive block the hub template ships in `SKILL.md`. Removing it fails compiled-routing readiness even if the checker is otherwise green.\n249: \n250: ### Standalone skill (after Section 5)\n251: \n252: ```bash\n253: python3 .skilled/skills/sk-doc/sk-create-skill/scripts/validate_skill_package.py .skilled/skills/<skill-name>\n254: ```\n255: \n256: Pass prints `Detected kind: standalone` and `package_skill.py --check: PASS (exit 0)`. The fleet gate `ci-skill-root-metadata.cjs` also runs the `ROUTER.md` contract on a standalone root and reports `RRC` codes, so a missing file or a missing link fails there. Do not run `parent-skill-check.cjs` on a single skill. That script audits hubs and their packets.\n257: \n258: `--strict` promotes noncanonical generated paths from advisory to blocking. Use it on a newly generated package.\n259: \n260: ---\n261: \n262: ## 7. RELATED RESOURCES\n263: \n264: - [parent-skills-nested-packets.md](../parent-skill/parent-skills-nested-packets.md) - hub shape, `packetKind`, One-Identity Invariant\n265: - [parent-hub-router-schema.md](../parent-skill/parent-hub-router-schema.md) - `hub-router.json` fields and check 5\n266: - [skill-root-metadata-contract.md](../shared/skill-root-metadata-contract.md) - class H vs class S required and forbidden files\n267: - [validation-and-packaging.md](../shared/validation-and-packaging.md) - completion gate and packaging\n268: - [creation-workflow.md](creation-workflow.md) - standalone create path\n269: - `.skilled/commands/create/skill-parent.md` - `/create:skill-parent` operations `create` and `update`\n270: - `.skilled/commands/create/skill.md` - `/create:skill` operations `full-create`, `full-update`, `reference-only`, `asset-only`"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/skill/upgrading-a-skill-to-v4.md\"}"},"time":{"start":1794582803792,"end":1794582806891}}}}
{"type":"tool_use","timestamp":1794582806894,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d57871ac001orF5IAIxMPPr7A","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578631a001E6KGPTUnximQa4","type":"tool","id":"chatcmpl-tool-ab19ca7a4b2fe91a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md, lines 1-122\n1: ---\n2: title: Advisor Index Handoff\n3: description: The shared vocabulary create and doctor render after a skill is scaffolded or diagnosed - metadata ownership, refresh ownership, the verification-state enum, and which branches carry the full handoff versus the narrow leaf-freshness signal.\n4: trigger_phrases:\n5:   - \"advisor index handoff\"\n6:   - \"does create refresh the advisor\"\n7:   - \"skill_graph_scan vs advisor_rebuild\"\n8:   - \"leaf-manifest fresh stale missing\"\n9:   - \"create doctor shared vocabulary\"\n10: importance_tier: normal\n11: contextType: implementation\n12: version: 1.2.3.0\n13: ---\n14: \n15: # Advisor Index Handoff\n16: \n17: The shared field vocabulary that `/create:skill`, `/create:skill-parent`, `/doctor:skill-advisor tune`, and `/doctor:skill-advisor parent-skill` all render after touching a skill root, so that scaffolding a skill and diagnosing its advisor state describe the same reality in the same words.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: ### Purpose\n24: \n25: **Core Principle**: One vocabulary, not one formatter. Create and doctor are separate prompt-asset workflows with genuinely different result shapes (create reports a scaffold; doctor reports a mutating, phase-gated diagnostic run) — see `research.md` Theme F1/F2 in `035-create-doctor-skill-advisor-alignment/001-research/`. What must stay identical across both is the field names, the metadata-ownership statements, and the verification-state enum below, not the surrounding prose or layout.\n26: \n27: ### When to Use\n28: \n29: - Wiring a create or doctor workflow asset's completion/report section (A5 in `002-core-alignment-fixes/plan.md`)\n30: - Writing a contract test that pins the shared vocabulary across adapters (A6)\n31: - Deciding whether a given create branch renders the full handoff or the narrow leaf-freshness signal only (§6)\n32: \n33: > **Advisor refresh is always operator-owned.** No `/create:*` or `/doctor:*` workflow calls `skill_graph_scan` or `advisor_rebuild` as a side effect of scaffolding or diagnosing a skill. Every workflow that touches a skill root reports refresh status as `NOT RUN` and prints the exact command the operator would run — never chains it automatically (research.md Theme B1/B7, \"Questions Answered\").\n34: >\n35: > The one deliberate rebuild is `/doctor:skill-advisor rebuild`. The operator invokes it to run `advisor_rebuild` and then `skill_graph_scan` behind a backup of `skill-graph.sqlite`. It does not touch a skill root and does not render the handoff below.\n36: \n37: ---\n38: \n39: ## 2. METADATA OWNERSHIP\n40: \n41: Four files carry advisor-relevant metadata on a skill root. Each has exactly one producer; none is validated against another's vocabulary.\n42: \n43: | File | Producer | What it is | Advisor relevance |\n44: | --- | --- | --- | --- |\n45: | `description.json` | authored | Descriptive hub-doctor metadata | **None.** Not discovered or validated by the graph compiler. Never becomes advisor input, and never validated against graph vocabulary — see §5 Guardrail. |\n46: | `graph-metadata.json` | authored | Sole hub advisor identity | The only file `skill_graph_scan` discovers and `skill_graph_validate` checks. |\n47: | `leaf-manifest.json` | **generated** | Leaf/resource projection derived from the registry and packet corpus | Never hand-edited. State is `fresh`, `stale`, or `missing` — see §4. |\n48: | `command-metadata.json` | authored, optional on H and S | Slash-command-to-mode binding | Present and validated when the root owns commands, omitted (not empty) when it owns none. On a standalone root each entry's `ownerMode` is the skill's own id. |\n49: \n50: Full generated-versus-authored rules and the H/S class matrix live in `skill-root-metadata-contract.md` in this same directory — this document only states the subset relevant to the create → advisor handoff.\n51: \n52: ---\n53: \n54: ## 3. REFRESH OWNERSHIP\n55: \n56: Refresh is a deliberate, explicit operator choice between two non-equivalent paths — never an unconditional chain, because `advisor_rebuild` already calls the same metadata indexer internally before publishing its own generation (research.md Theme B7).\n57: \n58: ```bash\n59: cd \"<selected_repo>\"\n60: \n61: # Full advisor refresh (rebuild + republish)\n62: node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --workspace-root \"$PWD\" --force true --format json\n63: \n64: # Graph-only refresh (scan without republishing the advisor)\n65: node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --skills-root \"$PWD/.skilled/skills\" --format json\n66: ```\n67: \n68: Verification, run after either refresh path (or on its own to diagnose current state):\n69: \n70: ```bash\n71: node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json\n72: node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json\n73: ```\n74: \n75: `skill_graph_scan` resolves `process.cwd()` as workspace root and rejects paths outside it — the `cd` is load-bearing, not decorative, when the operator is working from a linked worktree (research.md Theme B6).\n76: \n77: ---\n78: \n79: ## 4. VERIFICATION-STATE VOCABULARY\n80: \n81: Every refresh or validation field a create/doctor workflow renders uses exactly one of these four states:\n82: \n83: | State | Meaning |\n84: | --- | --- |\n85: | `NOT RUN` | Operator-owned action was not taken by this workflow (the default for every create-time refresh field). |\n86: | `PASSED` | The action ran and its result was clean. |\n87: | `FAILED` | The action ran and found a real problem (structural graph error, failed test, generation error). |\n88: | `UNAVAILABLE (retryable)` | The call threw, returned a non-ok status, or the payload was malformed — typically the advisor IPC socket being cold (exit 75). Never render this as `FAILED`; it is a transport state, not a finding. |\n89: \n90: `leaf-manifest.json` freshness uses its own three-value state, not the four above, because it describes a generated file's currency rather than a pass/fail check:\n91: \n92: | State | Meaning |\n93: | --- | --- |\n94: | `fresh` | Generated after the current registry/packet corpus; content matches what `generate-leaf-manifest.cjs --write` would produce now. |\n95: | `stale` | Present but predates a later registry/packet change. |\n96: | `missing` | Not present on disk. |\n97: \n98: Doctor severity derivation for `skill_graph_validate` (`pass`/`warn`/`fail`/`unavailable`) and the workflow-level terminal states (`fail`/`partial`/`pass`/`skipped_unverified`) are doctor-specific compositions of this vocabulary, not additional enums — see `doctor-skill-advisor-tune.yaml`'s `phase_4_verify` for the full derivation.\n99: \n100: ---\n101: \n102: ## 5. CLASS APPLICABILITY\n103: \n104: H-only fields render **omitted**, not `N/A` or a false negative, on standalone (class-S) roots — `description.json`, `mode-registry.json` and `hub-router.json` are structurally forbidden there (`skill-root-metadata-contract.md` §3). `command-metadata.json` is optional on both classes, so a standalone result reports it only when the root ships it. A standalone `/create:skill` result that reported `description.json: MISSING` would be wrong; it should not mention the field at all.\n105: \n106: **Guardrail (do not build this):** `description.json` stays descriptive and is never validated against graph vocabulary, and standalone `/create:skill` never asserts parent-hub metadata files. This boundary was raised and re-confirmed across nine iterations of research (Theme C, research.md) specifically because it is the mistake future maintainers are most likely to reintroduce — resist adding a `description.json` ↔ `graph-metadata.json` equality check or a parent-file requirement to a standalone assertion, however tempting it looks as a \"consistency\" improvement.\n107: \n108: ---\n109: \n110: ## 6. BRANCH SCOPE — WHO RENDERS WHAT\n111: \n112: | Branch | Renders |\n113: | --- | --- |\n114: | Standalone `/create:skill` full-create | Full handoff, `standalone` scope (H-only fields omitted) |\n115: | Standalone `/create:skill` full-update | Full handoff, `standalone` scope |\n116: | Parent `/create:skill-parent` create | Full handoff, H-specific values (`leaf-manifest.json` freshness from the scoped generator this workflow just ran) |\n117: | Parent `/create:skill-parent` update | Full handoff, H-specific values |\n118: | Reference-only / asset-only create branches | **Not** the full handoff — only the narrow conditional `node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check <skillDir>` leaf-freshness signal, gated on the changed path falling under a configured leaf root |\n119: | `/doctor:skill-advisor tune` | Full handoff vocabulary, live values from `skill_graph_validate`/`advisor_rebuild`/`advisor_validate` |\n120: | `/doctor:skill-advisor parent-skill` | Full handoff vocabulary, read-only. Distinguishes `leaf-manifest.json` missing from stale and points at the scoped generator, never attempts repair |\n121: \n122: Rendering the full handoff on a reference/asset-only branch would be misleading: those branches touch roots where the H-only fields are forbidden, so most of the handoff would be inapplicable noise around one real signal (research.md Theme F7).","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md, lines 1-122\n1: ---\n2: title: Advisor Index Handoff\n3: description: The shared vocabulary create and doctor render after a skill is scaffolded or diagnosed - metadata ownership, refresh ownership, the verification-state enum, and which branches carry the full handoff versus the narrow leaf-freshness signal.\n4: trigger_phrases:\n5:   - \"advisor index handoff\"\n6:   - \"does create refresh the advisor\"\n7:   - \"skill_graph_scan vs advisor_rebuild\"\n8:   - \"leaf-manifest fresh stale missing\"\n9:   - \"create doctor shared vocabulary\"\n10: importance_tier: normal\n11: contextType: implementation\n12: version: 1.2.3.0\n13: ---\n14: \n15: # Advisor Index Handoff\n16: \n17: The shared field vocabulary that `/create:skill`, `/create:skill-parent`, `/doctor:skill-advisor tune`, and `/doctor:skill-advisor parent-skill` all render after touching a skill root, so that scaffolding a skill and diagnosing its advisor state describe the same reality in the same words.\n18: \n19: ---\n20: \n21: ## 1. OVERVIEW\n22: \n23: ### Purpose\n24: \n25: **Core Principle**: One vocabulary, not one formatter. Create and doctor are separate prompt-asset workflows with genuinely different result shapes (create reports a scaffold; doctor reports a mutating, phase-gated diagnostic run) — see `research.md` Theme F1/F2 in `035-create-doctor-skill-advisor-alignment/001-research/`. What must stay identical across both is the field names, the metadata-ownership statements, and the verification-state enum below, not the surrounding prose or layout.\n26: \n27: ### When to Use\n28: \n29: - Wiring a create or doctor workflow asset's completion/report section (A5 in `002-core-alignment-fixes/plan.md`)\n30: - Writing a contract test that pins the shared vocabulary across adapters (A6)\n31: - Deciding whether a given create branch renders the full handoff or the narrow leaf-freshness signal only (§6)\n32: \n33: > **Advisor refresh is always operator-owned.** No `/create:*` or `/doctor:*` workflow calls `skill_graph_scan` or `advisor_rebuild` as a side effect of scaffolding or diagnosing a skill. Every workflow that touches a skill root reports refresh status as `NOT RUN` and prints the exact command the operator would run — never chains it automatically (research.md Theme B1/B7, \"Questions Answered\").\n34: >\n35: > The one deliberate rebuild is `/doctor:skill-advisor rebuild`. The operator invokes it to run `advisor_rebuild` and then `skill_graph_scan` behind a backup of `skill-graph.sqlite`. It does not touch a skill root and does not render the handoff below.\n36: \n37: ---\n38: \n39: ## 2. METADATA OWNERSHIP\n40: \n41: Four files carry advisor-relevant metadata on a skill root. Each has exactly one producer; none is validated against another's vocabulary.\n42: \n43: | File | Producer | What it is | Advisor relevance |\n44: | --- | --- | --- | --- |\n45: | `description.json` | authored | Descriptive hub-doctor metadata | **None.** Not discovered or validated by the graph compiler. Never becomes advisor input, and never validated against graph vocabulary — see §5 Guardrail. |\n46: | `graph-metadata.json` | authored | Sole hub advisor identity | The only file `skill_graph_scan` discovers and `skill_graph_validate` checks. |\n47: | `leaf-manifest.json` | **generated** | Leaf/resource projection derived from the registry and packet corpus | Never hand-edited. State is `fresh`, `stale`, or `missing` — see §4. |\n48: | `command-metadata.json` | authored, optional on H and S | Slash-command-to-mode binding | Present and validated when the root owns commands, omitted (not empty) when it owns none. On a standalone root each entry's `ownerMode` is the skill's own id. |\n49: \n50: Full generated-versus-authored rules and the H/S class matrix live in `skill-root-metadata-contract.md` in this same directory — this document only states the subset relevant to the create → advisor handoff.\n51: \n52: ---\n53: \n54: ## 3. REFRESH OWNERSHIP\n55: \n56: Refresh is a deliberate, explicit operator choice between two non-equivalent paths — never an unconditional chain, because `advisor_rebuild` already calls the same metadata indexer internally before publishing its own generation (research.md Theme B7).\n57: \n58: ```bash\n59: cd \"<selected_repo>\"\n60: \n61: # Full advisor refresh (rebuild + republish)\n62: node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --workspace-root \"$PWD\" --force true --format json\n63: \n64: # Graph-only refresh (scan without republishing the advisor)\n65: node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --skills-root \"$PWD/.skilled/skills\" --format json\n66: ```\n67: \n68: Verification, run after either refresh path (or on its own to diagnose current state):\n69: \n70: ```bash\n71: node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json\n72: node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json\n73: ```\n74: \n75: `skill_graph_scan` resolves `process.cwd()` as workspace root and rejects paths outside it — the `cd` is load-bearing, not decorative, when the operator is working from a linked worktree (research.md Theme B6).\n76: \n77: ---\n78: \n79: ## 4. VERIFICATION-STATE VOCABULARY\n80: \n81: Every refresh or validation field a create/doctor workflow renders uses exactly one of these four states:\n82: \n83: | State | Meaning |\n84: | --- | --- |\n85: | `NOT RUN` | Operator-owned action was not taken by this workflow (the default for every create-time refresh field). |\n86: | `PASSED` | The action ran and its result was clean. |\n87: | `FAILED` | The action ran and found a real problem (structural graph error, failed test, generation error). |\n88: | `UNAVAILABLE (retryable)` | The call threw, returned a non-ok status, or the payload was malformed — typically the advisor IPC socket being cold (exit 75). Never render this as `FAILED`; it is a transport state, not a finding. |\n89: \n90: `leaf-manifest.json` freshness uses its own three-value state, not the four above, because it describes a generated file's currency rather than a pass/fail check:\n91: \n92: | State | Meaning |\n93: | --- | --- |\n94: | `fresh` | Generated after the current registry/packet corpus; content matches what `generate-leaf-manifest.cjs --write` would produce now. |\n95: | `stale` | Present but predates a later registry/packet change. |\n96: | `missing` | Not present on disk. |\n97: \n98: Doctor severity derivation for `skill_graph_validate` (`pass`/`warn`/`fail`/`unavailable`) and the workflow-level terminal states (`fail`/`partial`/`pass`/`skipped_unverified`) are doctor-specific compositions of this vocabulary, not additional enums — see `doctor-skill-advisor-tune.yaml`'s `phase_4_verify` for the full derivation.\n99: \n100: ---\n101: \n102: ## 5. CLASS APPLICABILITY\n103: \n104: H-only fields render **omitted**, not `N/A` or a false negative, on standalone (class-S) roots — `description.json`, `mode-registry.json` and `hub-router.json` are structurally forbidden there (`skill-root-metadata-contract.md` §3). `command-metadata.json` is optional on both classes, so a standalone result reports it only when the root ships it. A standalone `/create:skill` result that reported `description.json: MISSING` would be wrong; it should not mention the field at all.\n105: \n106: **Guardrail (do not build this):** `description.json` stays descriptive and is never validated against graph vocabulary, and standalone `/create:skill` never asserts parent-hub metadata files. This boundary was raised and re-confirmed across nine iterations of research (Theme C, research.md) specifically because it is the mistake future maintainers are most likely to reintroduce — resist adding a `description.json` ↔ `graph-metadata.json` equality check or a parent-file requirement to a standalone assertion, however tempting it looks as a \"consistency\" improvement.\n107: \n108: ---\n109: \n110: ## 6. BRANCH SCOPE — WHO RENDERS WHAT\n111: \n112: | Branch | Renders |\n113: | --- | --- |\n114: | Standalone `/create:skill` full-create | Full handoff, `standalone` scope (H-only fields omitted) |\n115: | Standalone `/create:skill` full-update | Full handoff, `standalone` scope |\n116: | Parent `/create:skill-parent` create | Full handoff, H-specific values (`leaf-manifest.json` freshness from the scoped generator this workflow just ran) |\n117: | Parent `/create:skill-parent` update | Full handoff, H-specific values |\n118: | Reference-only / asset-only create branches | **Not** the full handoff — only the narrow conditional `node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check <skillDir>` leaf-freshness signal, gated on the changed path falling under a configured leaf root |\n119: | `/doctor:skill-advisor tune` | Full handoff vocabulary, live values from `skill_graph_validate`/`advisor_rebuild`/`advisor_validate` |\n120: | `/doctor:skill-advisor parent-skill` | Full handoff vocabulary, read-only. Distinguishes `leaf-manifest.json` missing from stale and points at the scoped generator, never attempts repair |\n121: \n122: Rendering the full handoff on a reference/asset-only branch would be misleading: those branches touch roots where the H-only fields are forbidden, so most of the handoff would be inapplicable noise around one real signal (research.md Theme F7)."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md\"}"},"time":{"start":1794582802860,"end":1794582806894}}}}
{"type":"tool_use","timestamp":1794582806898,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d5787980001G7mCc4yWKUloZL","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578631a001E6KGPTUnximQa4","type":"tool","id":"chatcmpl-tool-a946f4e60e05a047","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/tests/skill-root-metadata-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/tests/skill-root-metadata-contract.test.cjs, lines 1-1020\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ skill-root-metadata-contract.test — class contract + fleet gate coverage ║\n4: // ╚══════════════════════════════════════════════════════════════════════════╝\n5: 'use strict';\n6: \n7: /**\n8:  * Covers the two halves of the root-metadata contract: the pure classifier\n9:  * (class discrimination, required/forbidden sets, overlay scoping) and the\n10:  * fleet gate that applies it (root discovery from the authored marker, nested\n11:  * identity detection, generated-file freshness, and --fix write scoping).\n12:  *\n13:  * The fleet assertions run against the real skills tree rather than a fixture\n14:  * so the committed contract cannot drift away from the fleet it governs: if a\n15:  * root changes class or stops carrying its required files, this test fails\n16:  * before any consumer notices. A standalone root's missing sibling router is\n17:  * the one expected migration state, recorded in the routing-shape ledger and\n18:  * enforced by the gate, so the shape assertion tolerates only that finding.\n19:  * Negative cases use synthetic roots in a temp dir, since the point is to\n20:  * prove the gate rejects shapes that must never reach the fleet.\n21:  */\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: \n32: const contract = require('../lib/skill-root-metadata-contract.cjs');\n33: const gate = require('../ci-skill-root-metadata.cjs');\n34: \n35: // ─────────────────────────────────────────────────────────────────────────────\n36: // 2. FIXTURES\n37: // ─────────────────────────────────────────────────────────────────────────────\n38: \n39: const SKILLS_DIR = path.resolve(__dirname, '..', '..', '..', '..');\n40: \n41: /** The fleet's expected class map. A change here is a deliberate act. */\n42: const EXPECTED_CLASSES = {\n43:   'cli-classifier': contract.CLASS_HUB,\n44:   'cli-external-orchestration': contract.CLASS_HUB,\n45:   'cli-orca': contract.CLASS_STANDALONE,\n46:   'mcp-code-mode': contract.CLASS_STANDALONE,\n47:   'mcp-tooling': contract.CLASS_HUB,\n48:   'sk-code': contract.CLASS_HUB,\n49:   'sk-design': contract.CLASS_HUB,\n50:   // sk-design-md-generator is a MODE under sk-design, not a root. It carries no\n51:   // graph-metadata.json, which is the authored marker discovery keys on, so listing it\n52:   // here expected a second skill identity the hub canon forbids.\n53:   'sk-doc': contract.CLASS_HUB,\n54:   'sk-git': contract.CLASS_STANDALONE,\n55:   'sk-prompt': contract.CLASS_STANDALONE,\n56:   'system-deep-loop': contract.CLASS_HUB,\n57:   'system-skill-advisor': contract.CLASS_STANDALONE,\n58:   'system-skilled-doctor': contract.CLASS_STANDALONE,\n59:   'system-spec-kit': contract.CLASS_STANDALONE,\n60: };\n61: \n62: let tmpRoot = null;\n63: const HEALTHY_INTENT_SIGNALS = Array.from({ length: 8 }, (_value, index) => `fixture signal ${index + 1}`);\n64: \n65: // A standalone fixture root owns a sibling router with one active intent that\n66: // selects its one reference leaf, so the default fixture satisfies the canon.\n67: const STANDALONE_ROUTER = [\n68:   '---',\n69:   'title: fixture standalone router',\n70:   'version: 1.0.0.0',\n71:   'router_state: active',\n72:   'skill_pointer: SKILL.md',\n73:   '---',\n74:   '',\n75:   '# Fixture Standalone Router',\n76:   '',\n77:   '## 1. OVERVIEW',\n78:   '',\n79:   'The fixture skill routes one reference leaf.',\n80:   '',\n81:   '## 2. INTENT MODEL',\n82:   '',\n83:   '- **FIXTURE** — the reference an intent request loads.',\n84:   '',\n85:   '## 3. MACHINE-READABLE ROUTER',\n86:   '',\n87:   '```python',\n88:   'DEFAULT_RESOURCE = []',\n89:   '',\n90:   'INTENT_SIGNALS = {',\n91:   '    \"FIXTURE\": {\"weight\": 4, \"keywords\": [\"fixture\"]},',\n92:   '}',\n93:   '',\n94:   'RESOURCE_MAP = {',\n95:   '    \"FIXTURE\": [\"references/a.md\"],',\n96:   '}',\n97:   '',\n98:   'SHARED_CONTROL_RESOURCES = []',\n99:   '```',\n100:   '',\n101: ].join('\\n');\n102: \n103: function makeTmpSkillsDir() {\n104:   if (!tmpRoot) tmpRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'skill-root-contract-'));\n105:   return fs.mkdtempSync(path.join(tmpRoot, 'skills-'));\n106: }\n107: \n108: /**\n109:  * Build a synthetic skill root with the named metadata files present.\n110:  *\n111:  * A fixture that declares neither half of the hub discriminator is a\n112:  * standalone root, and the canon requires a sibling router on every root, so\n113:  * it gets the fixture router unless it supplies its own or opts out.\n114:  */\n115: function makeRoot(skillsDir, skillId, files, options = {}) {\n116:   const dir = path.join(skillsDir, skillId);\n117:   fs.mkdirSync(dir, { recursive: true });\n118:   fs.writeFileSync(path.join(dir, contract.SKILL_MARKER), `# ${skillId}\\n`);\n119:   for (const [name, body] of Object.entries(files || {})) {\n120:     const full = path.join(dir, name);\n121:     fs.mkdirSync(path.dirname(full), { recursive: true });\n122:     let content = body;\n123:     if (name === 'graph-metadata.json' && body && typeof body === 'object' && !Array.isArray(body)) {\n124:       const rawDerived = body.derived && typeof body.derived === 'object' && !Array.isArray(body.derived)\n125:         ? body.derived\n126:         : {};\n127:       content = {\n128:         ...body,\n129:         intent_signals: Object.hasOwn(body, 'intent_signals') ? body.intent_signals : HEALTHY_INTENT_SIGNALS,\n130:         derived: {\n131:           ...rawDerived,\n132:           trigger_phrases: Object.hasOwn(rawDerived, 'trigger_phrases')\n133:             ? rawDerived.trigger_phrases\n134:             : HEALTHY_INTENT_SIGNALS,\n135:         },\n136:       };\n137:     }\n138:     fs.writeFileSync(full, typeof content === 'string' ? content : `${JSON.stringify(content, null, 2)}\\n`);\n139:   }\n140:   const declaresHub = Boolean(files && (files['mode-registry.json'] || files['hub-router.json']));\n141:   const suppliesRouter = Boolean(files && Object.hasOwn(files, 'ROUTER.md'));\n142:   if (options.standaloneRouter !== false && !declaresHub && !suppliesRouter) {\n143:     fs.writeFileSync(path.join(dir, 'ROUTER.md'), STANDALONE_ROUTER);\n144:   }\n145:   return dir;\n146: }\n147: \n148: function codesOf(result) {\n149:   return result.violations.map((v) => v.code).sort();\n150: }\n151: \n152: // ─────────────────────────────────────────────────────────────────────────────\n153: // 3. CLASSIFICATION\n154: // ─────────────────────────────────────────────────────────────────────────────\n155: \n156: function testDiscriminatorDecidesClass() {\n157:   const hub = contract.classifyPresence({ 'mode-registry.json': true, 'hub-router.json': true });\n158:   assert.equal(hub.skillClass, contract.CLASS_HUB);\n159: \n160:   const standalone = contract.classifyPresence({});\n161:   assert.equal(standalone.skillClass, contract.CLASS_STANDALONE);\n162: \n163:   // Exactly one half of the coupled declaration is not a third class.\n164:   for (const half of contract.DISCRIMINATOR_FILES) {\n165:     const partial = contract.classifyPresence({ [half]: true });\n166:     assert.equal(partial.skillClass, null, `${half} alone must not classify`);\n167:     assert.match(partial.reason, /partial hub declaration/);\n168:   }\n169: }\n170: \n171: function testClassificationIgnoresGeneratedOutput() {\n172:   // Classification must not consult generated files, or a root whose manifest\n173:   // was never written would classify differently after regeneration and the\n174:   // gate could never report the manifest as missing.\n175:   const withManifest = contract.classifyPresence({ 'leaf-manifest.json': true });\n176:   const without = contract.classifyPresence({});\n177:   assert.equal(withManifest.skillClass, without.skillClass);\n178: }\n179: \n180: function testPresenceAcceptsIterableOrMap() {\n181:   const fromList = contract.classifyPresence(['mode-registry.json', 'hub-router.json']);\n182:   assert.equal(fromList.skillClass, contract.CLASS_HUB);\n183:   const normalized = contract.normalizePresence(['description.json']);\n184:   assert.equal(normalized['description.json'], true);\n185:   assert.equal(normalized['hub-router.json'], false);\n186: }\n187: \n188: // ─────────────────────────────────────────────────────────────────────────────\n189: // 4. REQUIRED / FORBIDDEN / OVERLAY\n190: // ─────────────────────────────────────────────────────────────────────────────\n191: \n192: function testHubRequiresItsFullSet() {\n193:   const missingDescription = contract.evaluateRoot('some-hub', {\n194:     'mode-registry.json': true,\n195:     'hub-router.json': true,\n196:     'ROUTER.md': true,\n197:     'graph-metadata.json': true,\n198:     'leaf-manifest.json': true,\n199:     'command-metadata.json': true,\n200:   });\n201:   assert.deepEqual(codesOf(missingDescription), ['MISSING_REQUIRED_FILE']);\n202:   assert.equal(missingDescription.violations[0].file, 'description.json');\n203: \n204:   // command-metadata is optional for a hub: a hub that owns no slash commands\n205:   // carries no command surface, so its absence is conformant, not a violation.\n206:   const noCommands = contract.evaluateRoot('some-hub', {\n207:     'mode-registry.json': true,\n208:     'hub-router.json': true,\n209:     'ROUTER.md': true,\n210:     'graph-metadata.json': true,\n211:     'description.json': true,\n212:     'leaf-manifest.json': true,\n213:   });\n214:   assert.deepEqual(noCommands.violations, []);\n215: }\n216: \n217: function testStandaloneRequiresItsFullSet() {\n218:   const bare = contract.evaluateRoot('some-standalone', { 'graph-metadata.json': true });\n219:   const files = bare.violations.map((v) => v.file).sort();\n220:   assert.deepEqual(files, ['ROUTER.md', 'leaf-aliases.json', 'leaf-manifest.config.json', 'leaf-manifest.json']);\n221:   // Generated absences are reported under their own code so --fix knows which\n222:   // findings it is allowed to resolve by writing. The router is authored, so\n223:   // it stays a required-file finding.\n224:   const generated = bare.violations.filter((v) => v.code === 'MISSING_GENERATED_FILE').map((v) => v.file).sort();\n225:   assert.deepEqual(generated, ['leaf-aliases.json', 'leaf-manifest.json']);\n226:   const router = bare.violations.find((v) => v.file === 'ROUTER.md');\n227:   assert.equal(router.code, 'MISSING_REQUIRED_FILE');\n228: }\n229: \n230: function testStandaloneFullSetPasses() {\n231:   const result = contract.evaluateRoot('some-standalone', {\n232:     'graph-metadata.json': true,\n233:     'leaf-manifest.config.json': true,\n234:     'ROUTER.md': true,\n235:     'leaf-manifest.json': true,\n236:     'leaf-aliases.json': true,\n237:   });\n238:   assert.deepEqual(result.violations, []);\n239: }\n240: \n241: function testForbiddenFilesAreRejectedPerClass() {\n242:   const hubWithConfig = contract.evaluateRoot('some-hub', {\n243:     'mode-registry.json': true,\n244:     'hub-router.json': true,\n245:     'ROUTER.md': true,\n246:     'graph-metadata.json': true,\n247:     'description.json': true,\n248:     'leaf-manifest.json': true,\n249:     'command-metadata.json': true,\n250:     'leaf-manifest.config.json': true,\n251:   });\n252:   assert.deepEqual(codesOf(hubWithConfig), ['FORBIDDEN_FILE']);\n253:   assert.equal(hubWithConfig.violations[0].file, 'leaf-manifest.config.json');\n254: \n255:   const standaloneWithDescription = contract.evaluateRoot('some-standalone', {\n256:     'graph-metadata.json': true,\n257:     'leaf-manifest.config.json': true,\n258:     'leaf-manifest.json': true,\n259:     'leaf-aliases.json': true,\n260:     'ROUTER.md': true,\n261:     'description.json': true,\n262:   });\n263:   assert.deepEqual(codesOf(standaloneWithDescription), ['FORBIDDEN_FILE']);\n264:   assert.equal(standaloneWithDescription.violations[0].file, 'description.json');\n265: \n266:   // Command metadata is optional rather than forbidden on a standalone: a root\n267:   // that ships its own commands declares them, and ownership falls to the skill\n268:   // id because there is no registry mode to bind to.\n269:   const standaloneWithCommands = contract.evaluateRoot('some-standalone', {\n270:     'graph-metadata.json': true,\n271:     'leaf-manifest.config.json': true,\n272:     'leaf-manifest.json': true,\n273:     'leaf-aliases.json': true,\n274:     'ROUTER.md': true,\n275:     'command-metadata.json': true,\n276:   });\n277:   assert.deepEqual(codesOf(standaloneWithCommands), []);\n278: }\n279: \n280: function testCommandMetadataIsUniformAcrossHubs() {\n281:   // The command surface is class policy, not a per-root overlay: the same\n282:   // conforming hub presence map passes regardless of which hub carries it.\n283:   const conformingHub = {\n284:     'mode-registry.json': true,\n285:     'hub-router.json': true,\n286:     'ROUTER.md': true,\n287:     'graph-metadata.json': true,\n288:     'description.json': true,\n289:     'leaf-manifest.json': true,\n290:     'command-metadata.json': true,\n291:   };\n292:   assert.deepEqual(contract.evaluateRoot('sk-doc', conformingHub).violations, []);\n293:   assert.deepEqual(contract.OVERLAY_FILES, {});\n294: }\n295: \n296: function testGeneratedIsClassSensitive() {\n297:   // Aliases are derivable for a standalone root and authored for a hub. A\n298:   // caller that ignores class would happily overwrite a hub's real remaps.\n299:   assert.equal(contract.isGenerated('leaf-aliases.json', contract.CLASS_STANDALONE), true);\n300:   assert.equal(contract.isGenerated('leaf-aliases.json', contract.CLASS_HUB), false);\n301:   assert.equal(contract.isGenerated('leaf-manifest.json', contract.CLASS_HUB), true);\n302:   assert.equal(contract.isGenerated('description.json', contract.CLASS_HUB), false);\n303:   assert.throws(() => contract.isGenerated('leaf-manifest.json', 'Z'), /unknown skill class/);\n304: }\n305: \n306: function testLegalFilesForClass() {\n307:   // Command metadata is class policy rather than a per-root overlay, so both\n308:   // legal sets carry it: absence is conformant, presence is legal.\n309:   assert.ok(contract.legalFilesForClass(contract.CLASS_HUB, 'sk-doc').includes('command-metadata.json'));\n310:   assert.ok(contract.legalFilesForClass(contract.CLASS_HUB, 'sk-doc').includes('leaf-aliases.json'));\n311:   assert.ok(contract.legalFilesForClass(contract.CLASS_STANDALONE, 'sk-git').includes('command-metadata.json'));\n312: }\n313: \n314: // ─────────────────────────────────────────────────────────────────────────────\n315: // 5. FLEET CONFORMANCE\n316: // ─────────────────────────────────────────────────────────────────────────────\n317: \n318: function testFindSkillRootsSkipsPrivateSkills() {\n319:   const skillsDir = makeTmpSkillsDir();\n320:   makeRoot(skillsDir, 'alpha', { 'graph-metadata.json': { skill_id: 'alpha' } });\n321:   makeRoot(skillsDir, 'local-webflow', { 'graph-metadata.json': { skill_id: 'local-webflow' } });\n322:   const roots = gate.findSkillRoots(skillsDir).map((dir) => path.basename(dir));\n323:   assert.deepEqual(roots, ['alpha']);\n324: }\n325: \n326: function testFleetDiscoveryUsesTheAuthoredMarker() {\n327:   const roots = gate.findSkillRoots(SKILLS_DIR).map((d) => path.basename(d));\n328:   assert.deepEqual(roots, Object.keys(EXPECTED_CLASSES).sort());\n329: }\n330: \n331: function testEveryFleetRootMeetsItsClassShape() {\n332:   for (const [skillId, expectedClass] of Object.entries(EXPECTED_CLASSES)) {\n333:     const presence = gate.readPresence(path.join(SKILLS_DIR, skillId));\n334:     const result = contract.evaluateRoot(skillId, presence);\n335:     assert.equal(result.skillClass, expectedClass, `${skillId} class`);\n336:     // The router requirement is the one canon change an unmoved standalone\n337:     // root cannot meet yet; the ledger records it and the fleet gate enforces\n338:     // the file until the skill moves.\n339:     const unexpected = result.violations.filter((violation) => !(\n340:       expectedClass === contract.CLASS_STANDALONE\n341:       && violation.code === 'MISSING_REQUIRED_FILE'\n342:       && violation.file === 'ROUTER.md'\n343:     ));\n344:     assert.deepEqual(\n345:       unexpected, [],\n346:       `${skillId} must meet its class shape: ${unexpected.map((v) => v.message).join('; ')}`,\n347:     );\n348:   }\n349: }\n350: \n351: function testFleetAliasProjectionsAreIdentityForStandaloneRoots() {\n352:   for (const [skillId, skillClass] of Object.entries(EXPECTED_CLASSES)) {\n353:     if (skillClass !== contract.CLASS_STANDALONE) continue;\n354:     const rows = JSON.parse(fs.readFileSync(path.join(SKILLS_DIR, skillId, 'leaf-aliases.json'), 'utf8'));\n355:     assert.ok(Array.isArray(rows) && rows.length > 0, `${skillId} aliases non-empty`);\n356:     for (const row of rows) {\n357:       assert.equal(row.leafResourceId, row.diskPath, `${skillId} alias must be an identity row`);\n358:       assert.equal(row.workflowMode, skillId, `${skillId} alias mode`);\n359:     }\n360:   }\n361: }\n362: \n363: function testHubAliasesStayAuthored() {\n364:   // sk-doc is the fleet's proof that hub aliases carry information no generator\n365:   // can infer: rows that relocate a mode's resource into the shared tree.\n366:   const rows = JSON.parse(fs.readFileSync(path.join(SKILLS_DIR, 'sk-doc', 'leaf-aliases.json'), 'utf8'));\n367:   assert.ok(rows.some((row) => row.leafResourceId !== row.diskPath),\n368:     'sk-doc must retain at least one relocating alias row');\n369: }\n370: \n371: // ─────────────────────────────────────────────────────────────────────────────\n372: // 6. GATE BEHAVIOUR\n373: // ─────────────────────────────────────────────────────────────────────────────\n374: \n375: function testGateFlagsUnclassifiableRoot() {\n376:   const skillsDir = makeTmpSkillsDir();\n377:   makeRoot(skillsDir, 'half-declared', { 'mode-registry.json': { modes: [] } });\n378:   const result = gate.checkRoot(path.join(skillsDir, 'half-declared'));\n379:   assert.equal(result.skillClass, null);\n380:   assert.deepEqual(codesOf(result), ['UNCLASSIFIABLE_ROOT']);\n381: }\n382: \n383: function testGateDetectsNestedIdentity() {\n384:   const skillsDir = makeTmpSkillsDir();\n385:   makeRoot(skillsDir, 'nested-id', {\n386:     'graph-metadata.json': { skill_id: 'nested-id' },\n387:     'leaf-manifest.config.json': { workflowMode: 'nested-id' },\n388:     'references/a.md': '# a\\n',\n389:     'some-packet/graph-metadata.json': { skill_id: 'nested-id-packet' },\n390:   });\n391:   const result = gate.checkRoot(path.join(skillsDir, 'nested-id'));\n392:   assert.ok(codesOf(result).includes('NESTED_IDENTITY'));\n393: }\n394: \n395: function testGateIgnoresSameNamedContinuityMetadata() {\n396:   // The spec tree uses these filenames for a wholly separate continuity schema.\n397:   // A nested file lacking every skill-shaped key is a neighbour, not a rival.\n398:   const skillsDir = makeTmpSkillsDir();\n399:   makeRoot(skillsDir, 'continuity-neighbour', {\n400:     'graph-metadata.json': { skill_id: 'continuity-neighbour' },\n401:     'leaf-manifest.config.json': { workflowMode: 'continuity-neighbour' },\n402:     'references/a.md': '# a\\n',\n403:     'notes/graph-metadata.json': { packet: 'something', status: 'Planned', children_ids: [] },\n404:   });\n405:   const result = gate.checkRoot(path.join(skillsDir, 'continuity-neighbour'));\n406:   assert.ok(!codesOf(result).includes('NESTED_IDENTITY'));\n407: }\n408: \n409: function testGateRejectsUnknownGraphMetadataKey() {\n410:   const skillsDir = makeTmpSkillsDir();\n411:   const dir = makeRoot(skillsDir, 'unknown-graph-key', {\n412:     'graph-metadata.json': { skill_id: 'unknown-graph-key', manual: { related_to: [] } },\n413:     'leaf-manifest.config.json': { workflowMode: 'unknown-graph-key' },\n414:     'references/a.md': '# a\\n',\n415:   });\n416:   gate.checkRoot(dir, { fix: true });\n417: \n418:   const result = gate.checkRoot(dir);\n419:   assert.equal(result.status, 'fail');\n420:   const violation = result.violations.find((v) => v.code === 'GRAPH_METADATA_UNKNOWN_KEY');\n421:   assert.ok(violation);\n422:   assert.match(violation.message, /manual/);\n423: }\n424: \n425: function testGateAllowsKnownGraphMetadataExtra() {\n426:   const skillsDir = makeTmpSkillsDir();\n427:   const dir = makeRoot(skillsDir, 'known-graph-extra', {\n428:     'graph-metadata.json': { skill_id: 'known-graph-extra', importance_tier: 'important' },\n429:     'leaf-manifest.config.json': { workflowMode: 'known-graph-extra' },\n430:     'references/a.md': '# a\\n',\n431:   });\n432: \n433:   const result = gate.checkRoot(dir, { fix: true });\n434:   assert.equal(result.status, 'pass');\n435:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n436: }\n437: \n438: function testGateAcceptsSurfaceDetectionObject() {\n439:   const skillsDir = makeTmpSkillsDir();\n440:   const dir = makeRoot(skillsDir, 'surface-detection-ok', {\n441:     'graph-metadata.json': {\n442:       skill_id: 'surface-detection-ok',\n443:       surface_detection: { label: 'FIXTURE', role: 'specific', pathMarkers: ['src/fixture/'] },\n444:     },\n445:     'leaf-manifest.config.json': { workflowMode: 'surface-detection-ok' },\n446:     'references/a.md': '# a\\n',\n447:   });\n448: \n449:   const result = gate.checkRoot(dir, { fix: true });\n450:   assert.equal(result.status, 'pass');\n451:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n452:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_INVALID_SURFACE_DETECTION'));\n453: }\n454: \n455: function testGateRejectsNonObjectSurfaceDetection() {\n456:   const skillsDir = makeTmpSkillsDir();\n457:   const dir = makeRoot(skillsDir, 'surface-detection-bad', {\n458:     'graph-metadata.json': { skill_id: 'surface-detection-bad', surface_detection: ['src/fixture/'] },\n459:     'leaf-manifest.config.json': { workflowMode: 'surface-detection-bad' },\n460:     'references/a.md': '# a\\n',\n461:   });\n462: \n463:   const result = gate.checkRoot(dir, { fix: true });\n464:   assert.equal(result.status, 'fail');\n465:   assert.ok(codesOf(result).includes('GRAPH_METADATA_INVALID_SURFACE_DETECTION'));\n466:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n467: }\n468: \n469: /** Check a synthetic root carrying the given surface_detection object. */\n470: function surfaceDetectionViolations(skillId, block) {\n471:   const skillsDir = makeTmpSkillsDir();\n472:   const dir = makeRoot(skillsDir, skillId, {\n473:     'graph-metadata.json': { skill_id: skillId, surface_detection: block },\n474:     'leaf-manifest.config.json': { workflowMode: skillId },\n475:     'references/a.md': '# a\\n',\n476:   });\n477:   const result = gate.checkRoot(dir, { fix: true });\n478:   return result.violations.filter((v) => v.code === 'GRAPH_METADATA_INVALID_SURFACE_DETECTION');\n479: }\n480: \n481: function testGateAcceptsSurfaceDetectionWithEveryMarkerList() {\n482:   const found = surfaceDetectionViolations('surface-detection-full', {\n483:     label: 'FIXTURE',\n484:     role: 'specific',\n485:     pathMarkers: ['src/fixture/'],\n486:     fileMarkers: ['fixture.config.json'],\n487:     // Spaces inside or around a real marker are legal; only a blank one fails.\n488:     contentMarkers: ['fixture-runtime', 'from \"fixture\"', ' fixture-edge '],\n489:   });\n490:   assert.deepEqual(found, []);\n491: }\n492: \n493: function testGateIgnoresAbsentSurfaceDetection() {\n494:   const skillsDir = makeTmpSkillsDir();\n495:   const dir = makeRoot(skillsDir, 'surface-detection-absent', {\n496:     'graph-metadata.json': { skill_id: 'surface-detection-absent' },\n497:     'leaf-manifest.config.json': { workflowMode: 'surface-detection-absent' },\n498:     'references/a.md': '# a\\n',\n499:   });\n500:   const result = gate.checkRoot(dir, { fix: true });\n501:   assert.equal(result.status, 'pass');\n502:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_INVALID_SURFACE_DETECTION'));\n503: }\n504: \n505: function testGateRejectsSurfaceDetectionWithoutLabel() {\n506:   for (const label of [undefined, '', '   ', 7]) {\n507:     const found = surfaceDetectionViolations('surface-detection-no-label', {\n508:       label, role: 'specific', pathMarkers: ['src/fixture/'],\n509:     });\n510:     assert.equal(found.length, 1, `label ${JSON.stringify(label)} must fail once`);\n511:     assert.match(found[0].message, /surface_detection\\.label must be a non-empty string/);\n512:   }\n513: }\n514: \n515: function testGateRejectsSurfaceDetectionWithoutSpecificRole() {\n516:   // The fallback is the hub's own code, so an outside block may only be specific.\n517:   for (const role of [undefined, 'fallback', 'Specific', 'primary']) {\n518:     const found = surfaceDetectionViolations('surface-detection-bad-role', {\n519:       label: 'FIXTURE', role, pathMarkers: ['src/fixture/'],\n520:     });\n521:     assert.equal(found.length, 1, `role ${JSON.stringify(role)} must fail once`);\n522:     assert.match(found[0].message, /surface_detection\\.role must be \"specific\"/);\n523:   }\n524: }\n525: \n526: function testGateRejectsSurfaceDetectionWithoutMarkers() {\n527:   for (const markers of [{}, { pathMarkers: [], fileMarkers: [], contentMarkers: [] }]) {\n528:     const found = surfaceDetectionViolations('surface-detection-no-markers', {\n529:       label: 'FIXTURE', role: 'specific', ...markers,\n530:     });\n531:     assert.equal(found.length, 1, `markers ${JSON.stringify(markers)} must fail once`);\n532:     assert.match(found[0].message, /at least one non-empty marker array/);\n533:   }\n534: }\n535: \n536: function testGateRejectsSurfaceDetectionMarkerEntries() {\n537:   // A usable list elsewhere does not excuse a malformed one beside it.\n538:   for (const bad of ['src/fixture/', [''], [' '], ['\\t'], ['ok', 3], [null]]) {\n539:     const found = surfaceDetectionViolations('surface-detection-bad-entries', {\n540:       label: 'FIXTURE', role: 'specific', pathMarkers: ['src/fixture/'], contentMarkers: bad,\n541:     });\n542:     assert.equal(found.length, 1, `contentMarkers ${JSON.stringify(bad)} must fail once`);\n543:     assert.match(found[0].message, /surface_detection\\.contentMarkers must be an array of non-blank strings/);\n544:   }\n545: }\n546: \n547: function testGateAcceptsQualityBlock() {\n548:   const skillsDir = makeTmpSkillsDir();\n549:   const dir = makeRoot(skillsDir, 'quality-ok', {\n550:     'graph-metadata.json': {\n551:       skill_id: 'quality-ok',\n552:       quality: {\n553:         checklists: [\n554:           { paths: ['src/fixture/'], file: 'references/fixture-surface.md' },\n555:           { extensions: ['.fixture'], contentMarkers: ['fixture-runtime'], file: 'references/fixture-language.md' },\n556:         ],\n557:       },\n558:     },\n559:     'leaf-manifest.config.json': { workflowMode: 'quality-ok' },\n560:     'references/a.md': '# a\\n',\n561:   });\n562: \n563:   const result = gate.checkRoot(dir, { fix: true });\n564:   assert.equal(result.status, 'pass');\n565:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n566:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_INVALID_QUALITY'));\n567: }\n568: \n569: /** Check a synthetic root carrying the given quality block. */\n570: function qualityViolations(skillId, block) {\n571:   const skillsDir = makeTmpSkillsDir();\n572:   const dir = makeRoot(skillsDir, skillId, {\n573:     'graph-metadata.json': { skill_id: skillId, quality: block },\n574:     'leaf-manifest.config.json': { workflowMode: skillId },\n575:     'references/a.md': '# a\\n',\n576:   });\n577:   const result = gate.checkRoot(dir, { fix: true });\n578:   return result.violations.filter((v) => v.code === 'GRAPH_METADATA_INVALID_QUALITY');\n579: }\n580: \n581: function testGateRejectsMalformedQualityBlock() {\n582:   // A row scopes a checklist to files and names the checklist. A command would\n583:   // let a skill run one, and commands come only from the repository's quality\n584:   // config, so every command-shaped key is refused rather than ignored.\n585:   const row = { paths: ['src/fixture/'], file: 'references/a.md' };\n586:   const cases = [\n587:     ['row argv', { checklists: [{ ...row, argv: ['make', 'lint'] }] }, /unknown key argv/],\n588:     ['row command', { checklists: [{ ...row, command: 'make lint' }] }, /unknown key command/],\n589:     ['row run', { checklists: [{ ...row, run: 'make lint' }] }, /unknown key run/],\n590:     ['block command', { checklists: [row], command: 'make lint' }, /quality holds unknown key command/],\n591:     ['no selector', { checklists: [{ file: 'references/a.md' }] }, /names no selector/],\n592:     ['file outside', { checklists: [{ paths: ['src/fixture/'], file: '../a.md' }] }, /relative \\.md path/],\n593:     ['blank selector', { checklists: [{ paths: [' '], file: 'references/a.md' }] }, /must be a non-empty array of non-blank strings/],\n594:   ];\n595:   for (const [name, block, pattern] of cases) {\n596:     const found = qualityViolations('quality-bad', block);\n597:     assert.equal(found.length, 1, `${name} must fail once`);\n598:     assert.match(found[0].message, pattern, name);\n599:   }\n600:   // A present value that is not a usable block fails even before any row.\n601:   for (const block of [['references/a.md'], { checklists: [] }]) {\n602:     const found = qualityViolations('quality-not-a-block', block);\n603:     assert.equal(found.length, 1, `block ${JSON.stringify(block)} must fail once`);\n604:   }\n605: }\n606: \n607: function testGateRejectsIntentSignalsBelowFloor() {\n608:   const skillsDir = makeTmpSkillsDir();\n609:   const dir = makeRoot(skillsDir, 'thin-intent-signals', {\n610:     'graph-metadata.json': {\n611:       skill_id: 'thin-intent-signals',\n612:       intent_signals: ['one', 'two', 'three'],\n613:       derived: { trigger_phrases: ['one', 'two', 'three'] },\n614:     },\n615:     'leaf-manifest.config.json': { workflowMode: 'thin-intent-signals' },\n616:     'references/a.md': '# a\\n',\n617:   });\n618:   const result = gate.checkRoot(dir, { fix: true });\n619:   assert.ok(codesOf(result).includes('INTENT_SIGNALS_BELOW_FLOOR'));\n620: }\n621: \n622: function testGateRejectsEmptyIntentSignalsAndTriggers() {\n623:   const skillsDir = makeTmpSkillsDir();\n624:   const dir = makeRoot(skillsDir, 'empty-routing-signals', {\n625:     'graph-metadata.json': {\n626:       skill_id: 'empty-routing-signals',\n627:       intent_signals: [],\n628:       derived: { trigger_phrases: [] },\n629:     },\n630:     'leaf-manifest.config.json': { workflowMode: 'empty-routing-signals' },\n631:     'references/a.md': '# a\\n',\n632:   });\n633:   const result = gate.checkRoot(dir, { fix: true });\n634:   assert.ok(codesOf(result).includes('INTENT_SIGNALS_AND_TRIGGERS_EMPTY'));\n635: }\n636: \n637: function testGateAcceptsIntentSignalsAtFloor() {\n638:   const skillsDir = makeTmpSkillsDir();\n639:   const dir = makeRoot(skillsDir, 'healthy-routing-signals', {\n640:     'graph-metadata.json': {\n641:       skill_id: 'healthy-routing-signals',\n642:       intent_signals: HEALTHY_INTENT_SIGNALS,\n643:       derived: { trigger_phrases: HEALTHY_INTENT_SIGNALS },\n644:     },\n645:     'leaf-manifest.config.json': { workflowMode: 'healthy-routing-signals' },\n646:     'references/a.md': '# a\\n',\n647:   });\n648:   assert.equal(gate.checkRoot(dir, { fix: true }).status, 'pass');\n649: }\n650: \n651: function testGateValidatesSignalProvenanceLists() {\n652:   const skillsDir = makeTmpSkillsDir();\n653:   const dir = makeRoot(skillsDir, 'signal-provenance-ok', {\n654:     'graph-metadata.json': {\n655:       skill_id: 'signal-provenance-ok',\n656:       intent_signals_generated: ['generated phrase one'],\n657:       intent_signals_keep: ['kept phrase one'],\n658:     },\n659:     'leaf-manifest.config.json': { workflowMode: 'signal-provenance-ok' },\n660:     'references/a.md': '# a\\n',\n661:   });\n662:   const valid = gate.checkRoot(dir, { fix: true });\n663:   assert.equal(valid.status, 'pass');\n664:   assert.ok(!codesOf(valid).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n665:   assert.ok(!codesOf(valid).includes('GRAPH_METADATA_INVALID_SIGNAL_LIST'));\n666: \n667:   const brokenDir = makeRoot(skillsDir, 'signal-provenance-broken', {\n668:     'graph-metadata.json': {\n669:       skill_id: 'signal-provenance-broken',\n670:       intent_signals_generated: ['generated phrase one', '   '],\n671:     },\n672:     'leaf-manifest.config.json': { workflowMode: 'signal-provenance-broken' },\n673:     'references/a.md': '# a\\n',\n674:   });\n675:   const broken = gate.checkRoot(brokenDir, { fix: true });\n676:   assert.equal(broken.status, 'fail');\n677:   assert.ok(!codesOf(broken).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n678:   const found = broken.violations.filter((v) => v.code === 'GRAPH_METADATA_INVALID_SIGNAL_LIST');\n679:   assert.equal(found.length, 1);\n680:   assert.match(found[0].message, /intent_signals_generated must be an array of non-blank strings/);\n681: }\n682: \n683: function testGateDetectsStaleGeneratedManifest() {\n684:   const skillsDir = makeTmpSkillsDir();\n685:   const dir = makeRoot(skillsDir, 'stale-manifest', {\n686:     'graph-metadata.json': { skill_id: 'stale-manifest' },\n687:     'leaf-manifest.config.json': { workflowMode: 'stale-manifest' },\n688:     'references/a.md': '# a\\n',\n689:   });\n690:   // Write a manifest, then add a leaf so the committed bytes fall behind.\n691:   gate.checkRoot(dir, { fix: true });\n692:   fs.writeFileSync(path.join(dir, 'references', 'b.md'), '# b\\n');\n693: \n694:   const stale = gate.checkRoot(dir);\n695:   const staleCodes = stale.violations.filter((v) => v.code === 'STALE_GENERATED_FILE').map((v) => v.file).sort();\n696:   assert.deepEqual(staleCodes, ['leaf-aliases.json', 'leaf-manifest.json']);\n697: \n698:   // --fix resolves both, and a second pass is clean, proving idempotence.\n699:   const fixed = gate.checkRoot(dir, { fix: true });\n700:   assert.deepEqual(fixed.violations, []);\n701:   assert.deepEqual(fixed.written.sort(), ['leaf-aliases.json', 'leaf-manifest.json']);\n702:   assert.deepEqual(gate.checkRoot(dir).violations, []);\n703: }\n704: \n705: function testFixNeverWritesAuthoredFiles() {\n706:   const skillsDir = makeTmpSkillsDir();\n707:   const dir = makeRoot(skillsDir, 'authored-only', {\n708:     'graph-metadata.json': { skill_id: 'authored-only' },\n709:     'references/a.md': '# a\\n',\n710:   });\n711:   // No manifest config: the generator cannot run, and --fix must not invent one.\n712:   const result = gate.checkRoot(dir, { fix: true });\n713:   assert.equal(fs.existsSync(path.join(dir, 'leaf-manifest.config.json')), false);\n714:   assert.ok(codesOf(result).includes('MISSING_REQUIRED_FILE'));\n715:   assert.ok(codesOf(result).includes('MANIFEST_REGENERATION_FAILED'));\n716: }\n717: \n718: function testFixDoesNotTouchHubAliases() {\n719:   const skillsDir = makeTmpSkillsDir();\n720:   const authored = [{ workflowMode: 'm', leafResourceId: 'references/x.md', diskPath: 'shared/references/x.md' }];\n721:   const dir = makeRoot(skillsDir, 'hub-aliases', {\n722:     'graph-metadata.json': { skill_id: 'hub-aliases' },\n723:     'description.json': { name: 'hub-aliases', description: 'd', version: '1.0.0', keywords: [] },\n724:     'mode-registry.json': { modes: [{ workflowMode: 'm', packet: '.' }] },\n725:     'hub-router.json': { skill: 'hub-aliases' },\n726:     'leaf-aliases.json': authored,\n727:     'references/x.md': '# x\\n',\n728:     'shared/references/x.md': '# shared x\\n',\n729:   });\n730:   const before = fs.readFileSync(path.join(dir, 'leaf-aliases.json'));\n731:   gate.checkRoot(dir, { fix: true });\n732:   const after = fs.readFileSync(path.join(dir, 'leaf-aliases.json'));\n733:   assert.equal(Buffer.compare(before, after), 0, 'hub aliases must survive --fix untouched');\n734: }\n735: \n736: function testAliasProjectionIsDeterministicAndSetPreserving() {\n737:   const manifest = Buffer.from(`${JSON.stringify({\n738:     resourceContractVersion: 1,\n739:     modes: [{ workflowMode: 'only', packet: '.', leaves: ['assets/b.md', 'references/a.md'] }],\n740:   }, null, 2)}\\n`);\n741:   const first = gate.buildAliasBytes(manifest);\n742:   const second = gate.buildAliasBytes(manifest);\n743:   assert.equal(Buffer.compare(first, second), 0);\n744:   const rows = JSON.parse(first.toString('utf8'));\n745:   assert.deepEqual(rows.map((r) => r.leafResourceId), ['assets/b.md', 'references/a.md']);\n746:   assert.ok(rows.every((r) => r.leafResourceId === r.diskPath && r.workflowMode === 'only'));\n747: }\n748: \n749: function testGateRunExitsNonZeroOnViolations() {\n750:   const skillsDir = makeTmpSkillsDir();\n751:   makeRoot(skillsDir, 'broken', { 'mode-registry.json': { modes: [] } });\n752:   const originalWrite = process.stdout.write.bind(process.stdout);\n753:   process.stdout.write = () => true;\n754:   let code;\n755:   try {\n756:     code = gate.run({ skillsDir, format: 'json', fix: false });\n757:   } finally {\n758:     process.stdout.write = originalWrite;\n759:   }\n760:   assert.equal(code, 1);\n761: }\n762: \n763: // ─────────────────────────────────────────────────────────────────────────────\n764: // 7. RUN\n765: // ─────────────────────────────────────────────────────────────────────────────\n766: \n767: // ─────────────────────────────────────────────────────────────────────────────\n768: // 6b. COMMAND-METADATA CORE SCHEMA\n769: // ─────────────────────────────────────────────────────────────────────────────\n770: \n771: const commandSchema = require('../lib/command-metadata-schema.cjs');\n772: \n773: function validEntry(overrides) {\n774:   return Object.assign({\n775:     command: '/demo:run',\n776:     ownerMode: 'demo-mode',\n777:     description: 'Run the demo workflow.',\n778:     argumentHint: '<target> [:auto]',\n779:     userIntent: { job: 'I want to run the demo.', ownedSignals: ['run the demo'] },\n780:     choreography: [\n781:       { order: 1, skill: 'demo', resource: 'SKILL.md', action: 'load the hub' },\n782:       { order: 2, skill: 'demo-mode', resource: 'demo-mode/SKILL.md', action: 'apply to $ARGUMENTS' },\n783:     ],\n784:   }, overrides);\n785: }\n786: \n787: function schemaCodes(entries, extra) {\n788:   return commandSchema.validateCommandMetadata(entries, Object.assign({\n789:     skillId: 'demo', registryModes: ['demo-mode'],\n790:   }, extra)).map((v) => v.code).sort();\n791: }\n792: \n793: function testCommandSchemaAcceptsValidAndEmpty() {\n794:   assert.deepEqual(schemaCodes([]), []);\n795:   assert.deepEqual(schemaCodes([validEntry()]), []);\n796:   // Unknown extension fields are deliberately legal — the design hub's richer\n797:   // shape must keep validating without the core knowing its fields.\n798:   assert.deepEqual(schemaCodes([validEntry({ registerPolicy: { accepted: ['brand'] } })]), []);\n799:   // Choreography order is relative, not one-based: a step numbered 0 is legal.\n800:   assert.deepEqual(schemaCodes([validEntry({\n801:     choreography: [\n802:       { order: 0, skill: 'demo', resource: 'SKILL.md', action: 'load' },\n803:       { order: 1, skill: 'demo', resource: 'SKILL.md', action: 'apply' },\n804:     ],\n805:   })]), []);\n806: }\n807: \n808: function testCommandSchemaRejectsCoreViolations() {\n809:   assert.deepEqual(schemaCodes('nope'), ['COMMAND_METADATA_NOT_ARRAY']);\n810:   assert.deepEqual(schemaCodes([{}]).includes('MISSING_FIELD'), true);\n811:   assert.deepEqual(schemaCodes([validEntry({ command: 'create:skill' })]), ['BAD_COMMAND_ID']);\n812:   assert.deepEqual(schemaCodes([validEntry({ ownerMode: 'ghost' })]), ['UNKNOWN_OWNER_MODE']);\n813:   assert.deepEqual(schemaCodes([validEntry(), validEntry()]).includes('DUPLICATE_COMMAND'), true);\n814:   const clash = [\n815:     validEntry(),\n816:     validEntry({ command: '/demo:other', userIntent: { job: 'other job here', ownedSignals: ['Run The Demo'] } }),\n817:   ];\n818:   assert.ok(schemaCodes(clash).includes('DUPLICATE_OWNED_SIGNAL'), 'signal dedup must be case-insensitive');\n819:   assert.deepEqual(schemaCodes([validEntry({ userIntent: { job: 'j', ownedSignals: [] } })]), ['BAD_USER_INTENT']);\n820:   assert.deepEqual(schemaCodes([validEntry({ choreography: [] })]), ['BAD_CHOREOGRAPHY']);\n821:   assert.deepEqual(schemaCodes([validEntry({\n822:     choreography: [\n823:       { order: 2, skill: 'demo', resource: 'SKILL.md', action: 'load' },\n824:       { order: 1, skill: 'demo', resource: 'SKILL.md', action: 'apply' },\n825:     ],\n826:   })]), ['CHOREOGRAPHY_ORDER']);\n827: }\n828: \n829: function testCommandSchemaUsesInjectedProbes() {\n830:   const missingResource = commandSchema.validateCommandMetadata([validEntry()], {\n831:     skillId: 'demo', registryModes: ['demo-mode'], resourceExists: () => false,\n832:   });\n833:   assert.ok(missingResource.some((v) => v.code === 'CHOREOGRAPHY_RESOURCE_MISSING'));\n834:   const missingCommand = commandSchema.validateCommandMetadata([validEntry()], {\n835:     skillId: 'demo', registryModes: ['demo-mode'], commandExists: () => false,\n836:   });\n837:   assert.ok(missingCommand.some((v) => v.code === 'COMMAND_FILE_MISSING'));\n838:   assert.equal(commandSchema.commandDefinitionRelPath('/create:skill'), 'create/skill.md');\n839:   assert.equal(commandSchema.commandDefinitionRelPath('/doctor'), 'doctor.md');\n840: }\n841: \n842: function testCommandSchemaRejectsWithinEntryDuplicateSignal() {\n843:   // A command listing the same signal twice is dead weight, not cross-command\n844:   // ambiguity — it must be flagged under its own code, not silently accepted.\n845:   const codes = schemaCodes([validEntry({\n846:     userIntent: { job: 'I want to run the demo.', ownedSignals: ['run the demo', 'Run The Demo'] },\n847:   })]);\n848:   assert.deepEqual(codes, ['DUPLICATE_OWNED_SIGNAL_WITHIN_ENTRY']);\n849: }\n850: \n851: function testGateRejectsNonDirectorySkillsDir() {\n852:   // A regular file passed as --skills-dir used to be swallowed into a\n853:   // false-green zero-root pass; it must now exit 2 (\"cannot run\").\n854:   const skillsDir = makeTmpSkillsDir();\n855:   const filePath = path.join(skillsDir, 'not-a-dir');\n856:   fs.writeFileSync(filePath, 'x');\n857:   const originalWrite = process.stderr.write.bind(process.stderr);\n858:   process.stderr.write = () => true;\n859:   let code;\n860:   try {\n861:     code = gate.run({ skillsDir: filePath, format: 'json', fix: false });\n862:   } finally {\n863:     process.stderr.write = originalWrite;\n864:   }\n865:   assert.equal(code, 2);\n866: }\n867: \n868: function testStandaloneCommandOwnersAreTheSkillItself() {\n869:   // A standalone root ships no mode registry, so no registry mode can own its\n870:   // commands; the skill's own id is the only coherent owner there. A foreign\n871:   // mode must stay a finding, or the owner check would be one no entry passes.\n872:   const skillId = 'solo-commands';\n873:   const skillsDir = makeTmpSkillsDir();\n874:   const dir = makeRoot(skillsDir, skillId, {\n875:     'graph-metadata.json': { skill_id: skillId },\n876:     'leaf-manifest.config.json': { workflowMode: skillId },\n877:     'references/a.md': '# a\\n',\n878:     'command-metadata.json': [validEntry({ ownerMode: skillId })],\n879:   });\n880: \n881:   // The gate namespaces every command finding under its own file, so the core\n882:   // schema's code reaches a caller prefixed.\n883:   const ownerFindings = (target) => gate.checkCommandMetadata(target)\n884:     .filter((violation) => violation.code === 'COMMAND_METADATA_UNKNOWN_OWNER_MODE');\n885: \n886:   assert.deepEqual(ownerFindings(dir), []);\n887: \n888:   fs.writeFileSync(\n889:     path.join(dir, 'command-metadata.json'),\n890:     `${JSON.stringify([validEntry({ ownerMode: 'some-other-mode' })], null, 2)}\\n`,\n891:   );\n892:   const foreign = ownerFindings(dir);\n893:   assert.equal(foreign.length, 1, JSON.stringify(foreign));\n894:   assert.equal(foreign[0].file, 'command-metadata.json');\n895:   assert.match(foreign[0].message, /some-other-mode/);\n896: }\n897: \n898: // ─────────────────────────────────────────────────────────────────────────────\n899: // 6c. ROUTER MIGRATION DEBT\n900: // ─────────────────────────────────────────────────────────────────────────────\n901: \n902: /** Point the shared ledger reader at a fixture ledger for one check. */\n903: function withDebtLedger(entries, fn) {\n904:   const dir = makeTmpSkillsDir();\n905:   const file = path.join(dir, 'routing-shape-known-debt.json');\n906:   fs.writeFileSync(file, `${JSON.stringify({\n907:     maxSmartRoutingLines: 12,\n908:     maxSmartRoutingWords: 180,\n909:     debt: entries,\n910:   }, null, 2)}\\n`);\n911:   const previous = process.env.ROUTING_SHAPE_DEBT_FILE;\n912:   process.env.ROUTING_SHAPE_DEBT_FILE = file;\n913:   try {\n914:     return fn();\n915:   } finally {\n916:     if (previous === undefined) delete process.env.ROUTING_SHAPE_DEBT_FILE;\n917:     else process.env.ROUTING_SHAPE_DEBT_FILE = previous;\n918:   }\n919: }\n920: \n921: /** A conforming standalone root whose sibling router is still missing. */\n922: function makeUnmovedStandalone(skillsDir, skillId) {\n923:   const dir = makeRoot(skillsDir, skillId, {\n924:     'graph-metadata.json': { skill_id: skillId },\n925:     'leaf-manifest.config.json': { workflowMode: skillId },\n926:     'references/a.md': '# a\\n',\n927:   }, { standaloneRouter: false });\n928:   withDebtLedger({}, () => gate.checkRoot(dir, { fix: true }));\n929:   return dir;\n930: }\n931: \n932: function testGateRequiresRouterWithoutRecordedDebt() {\n933:   const skillsDir = makeTmpSkillsDir();\n934:   const dir = makeUnmovedStandalone(skillsDir, 'router-missing');\n935:   const result = withDebtLedger({}, () => gate.checkRoot(dir));\n936:   assert.ok(codesOf(result).includes('MISSING_REQUIRED_FILE'), JSON.stringify(result.violations));\n937:   assert.ok(codesOf(result).includes('RRC-001'), JSON.stringify(result.violations));\n938:   assert.equal(result.notes.some((note) => note.code === 'RS-004'), false);\n939: }\n940: \n941: function testGateToleratesRouterRecordedAsDebt() {\n942:   const skillsDir = makeTmpSkillsDir();\n943:   const dir = makeUnmovedStandalone(skillsDir, 'router-debt');\n944:   const result = withDebtLedger({\n945:     'router-debt': { lines: 0, words: 0, machineBlocks: 1, codes: ['RS-002', 'RS-004'] },\n946:   }, () => gate.checkRoot(dir));\n947:   assert.equal(result.status, 'pass', JSON.stringify(result.violations));\n948:   assert.ok(!codesOf(result).includes('MISSING_REQUIRED_FILE'));\n949:   assert.ok(!codesOf(result).includes('RRC-001'));\n950:   const note = result.notes.find((entry) => entry.code === 'RS-004');\n951:   assert.ok(note, JSON.stringify(result.notes));\n952:   assert.match(note.message, /router-debt/);\n953: }\n954: \n955: function testGateRejectsRouterDebtWithoutTheRouterCode() {\n956:   // Length debt alone never excuses a missing router: the entry must record\n957:   // the code the missing file would raise.\n958:   const skillsDir = makeTmpSkillsDir();\n959:   const dir = makeUnmovedStandalone(skillsDir, 'router-length-debt');\n960:   const result = withDebtLedger({\n961:     'router-length-debt': { lines: 0, words: 0, machineBlocks: 1, codes: ['RS-001'] },\n962:   }, () => gate.checkRoot(dir));\n963:   assert.ok(codesOf(result).includes('MISSING_REQUIRED_FILE'));\n964:   assert.ok(codesOf(result).includes('RRC-001'));\n965: }\n966: \n967: try {\n968:   testDiscriminatorDecidesClass();\n969:   testClassificationIgnoresGeneratedOutput();\n970:   testPresenceAcceptsIterableOrMap();\n971:   testHubRequiresItsFullSet();\n972:   testStandaloneRequiresItsFullSet();\n973:   testStandaloneFullSetPasses();\n974:   testForbiddenFilesAreRejectedPerClass();\n975:   testCommandMetadataIsUniformAcrossHubs();\n976:   testGeneratedIsClassSensitive();\n977:   testLegalFilesForClass();\n978:   testFleetDiscoveryUsesTheAuthoredMarker();\n979:   testEveryFleetRootMeetsItsClassShape();\n980:   testFleetAliasProjectionsAreIdentityForStandaloneRoots();\n981:   testHubAliasesStayAuthored();\n982:   testGateFlagsUnclassifiableRoot();\n983:   testGateDetectsNestedIdentity();\n984:   testGateIgnoresSameNamedContinuityMetadata();\n985:   testGateRejectsUnknownGraphMetadataKey();\n986:   testGateAllowsKnownGraphMetadataExtra();\n987:   testGateAcceptsSurfaceDetectionObject();\n988:   testGateRejectsNonObjectSurfaceDetection();\n989:   testGateAcceptsSurfaceDetectionWithEveryMarkerList();\n990:   testGateIgnoresAbsentSurfaceDetection();\n991:   testGateRejectsSurfaceDetectionWithoutLabel();\n992:   testGateRejectsSurfaceDetectionWithoutSpecificRole();\n993:   testGateRejectsSurfaceDetectionWithoutMarkers();\n994:   testGateRejectsSurfaceDetectionMarkerEntries();\n995:   testGateAcceptsQualityBlock();\n996:   testGateRejectsMalformedQualityBlock();\n997:   testGateRejectsIntentSignalsBelowFloor();\n998:   testGateRejectsEmptyIntentSignalsAndTriggers();\n999:   testGateAcceptsIntentSignalsAtFloor();\n1000:   testGateValidatesSignalProvenanceLists();\n1001:   testGateDetectsStaleGeneratedManifest();\n1002:   testFixNeverWritesAuthoredFiles();\n1003:   testFixDoesNotTouchHubAliases();\n1004:   testAliasProjectionIsDeterministicAndSetPreserving();\n1005:   testGateRunExitsNonZeroOnViolations();\n1006:   testCommandSchemaAcceptsValidAndEmpty();\n1007:   testCommandSchemaRejectsCoreViolations();\n1008:   testCommandSchemaUsesInjectedProbes();\n1009:   testCommandSchemaRejectsWithinEntryDuplicateSignal();\n1010:   testFindSkillRootsSkipsPrivateSkills();\n1011:   testGateRejectsNonDirectorySkillsDir();\n1012:   testStandaloneCommandOwnersAreTheSkillItself();\n1013:   testGateRequiresRouterWithoutRecordedDebt();\n1014:   testGateToleratesRouterRecordedAsDebt();\n1015:   testGateRejectsRouterDebtWithoutTheRouterCode();\n1016: } finally {\n1017:   if (tmpRoot) fs.rmSync(tmpRoot, { recursive: true, force: true });\n1018: }\n1019: \n1020: console.log('[sk-doc] skill-root-metadata contract + fleet gate coverage passed');","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/tests/skill-root-metadata-contract.test.cjs, lines 1-1020\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ skill-root-metadata-contract.test — class contract + fleet gate coverage ║\n4: // ╚══════════════════════════════════════════════════════════════════════════╝\n5: 'use strict';\n6: \n7: /**\n8:  * Covers the two halves of the root-metadata contract: the pure classifier\n9:  * (class discrimination, required/forbidden sets, overlay scoping) and the\n10:  * fleet gate that applies it (root discovery from the authored marker, nested\n11:  * identity detection, generated-file freshness, and --fix write scoping).\n12:  *\n13:  * The fleet assertions run against the real skills tree rather than a fixture\n14:  * so the committed contract cannot drift away from the fleet it governs: if a\n15:  * root changes class or stops carrying its required files, this test fails\n16:  * before any consumer notices. A standalone root's missing sibling router is\n17:  * the one expected migration state, recorded in the routing-shape ledger and\n18:  * enforced by the gate, so the shape assertion tolerates only that finding.\n19:  * Negative cases use synthetic roots in a temp dir, since the point is to\n20:  * prove the gate rejects shapes that must never reach the fleet.\n21:  */\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: \n32: const contract = require('../lib/skill-root-metadata-contract.cjs');\n33: const gate = require('../ci-skill-root-metadata.cjs');\n34: \n35: // ─────────────────────────────────────────────────────────────────────────────\n36: // 2. FIXTURES\n37: // ─────────────────────────────────────────────────────────────────────────────\n38: \n39: const SKILLS_DIR = path.resolve(__dirname, '..', '..', '..', '..');\n40: \n41: /** The fleet's expected class map. A change here is a deliberate act. */\n42: const EXPECTED_CLASSES = {\n43:   'cli-classifier': contract.CLASS_HUB,\n44:   'cli-external-orchestration': contract.CLASS_HUB,\n45:   'cli-orca': contract.CLASS_STANDALONE,\n46:   'mcp-code-mode': contract.CLASS_STANDALONE,\n47:   'mcp-tooling': contract.CLASS_HUB,\n48:   'sk-code': contract.CLASS_HUB,\n49:   'sk-design': contract.CLASS_HUB,\n50:   // sk-design-md-generator is a MODE under sk-design, not a root. It carries no\n51:   // graph-metadata.json, which is the authored marker discovery keys on, so listing it\n52:   // here expected a second skill identity the hub canon forbids.\n53:   'sk-doc': contract.CLASS_HUB,\n54:   'sk-git': contract.CLASS_STANDALONE,\n55:   'sk-prompt': contract.CLASS_STANDALONE,\n56:   'system-deep-loop': contract.CLASS_HUB,\n57:   'system-skill-advisor': contract.CLASS_STANDALONE,\n58:   'system-skilled-doctor': contract.CLASS_STANDALONE,\n59:   'system-spec-kit': contract.CLASS_STANDALONE,\n60: };\n61: \n62: let tmpRoot = null;\n63: const HEALTHY_INTENT_SIGNALS = Array.from({ length: 8 }, (_value, index) => `fixture signal ${index + 1}`);\n64: \n65: // A standalone fixture root owns a sibling router with one active intent that\n66: // selects its one reference leaf, so the default fixture satisfies the canon.\n67: const STANDALONE_ROUTER = [\n68:   '---',\n69:   'title: fixture standalone router',\n70:   'version: 1.0.0.0',\n71:   'router_state: active',\n72:   'skill_pointer: SKILL.md',\n73:   '---',\n74:   '',\n75:   '# Fixture Standalone Router',\n76:   '',\n77:   '## 1. OVERVIEW',\n78:   '',\n79:   'The fixture skill routes one reference leaf.',\n80:   '',\n81:   '## 2. INTENT MODEL',\n82:   '',\n83:   '- **FIXTURE** — the reference an intent request loads.',\n84:   '',\n85:   '## 3. MACHINE-READABLE ROUTER',\n86:   '',\n87:   '```python',\n88:   'DEFAULT_RESOURCE = []',\n89:   '',\n90:   'INTENT_SIGNALS = {',\n91:   '    \"FIXTURE\": {\"weight\": 4, \"keywords\": [\"fixture\"]},',\n92:   '}',\n93:   '',\n94:   'RESOURCE_MAP = {',\n95:   '    \"FIXTURE\": [\"references/a.md\"],',\n96:   '}',\n97:   '',\n98:   'SHARED_CONTROL_RESOURCES = []',\n99:   '```',\n100:   '',\n101: ].join('\\n');\n102: \n103: function makeTmpSkillsDir() {\n104:   if (!tmpRoot) tmpRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'skill-root-contract-'));\n105:   return fs.mkdtempSync(path.join(tmpRoot, 'skills-'));\n106: }\n107: \n108: /**\n109:  * Build a synthetic skill root with the named metadata files present.\n110:  *\n111:  * A fixture that declares neither half of the hub discriminator is a\n112:  * standalone root, and the canon requires a sibling router on every root, so\n113:  * it gets the fixture router unless it supplies its own or opts out.\n114:  */\n115: function makeRoot(skillsDir, skillId, files, options = {}) {\n116:   const dir = path.join(skillsDir, skillId);\n117:   fs.mkdirSync(dir, { recursive: true });\n118:   fs.writeFileSync(path.join(dir, contract.SKILL_MARKER), `# ${skillId}\\n`);\n119:   for (const [name, body] of Object.entries(files || {})) {\n120:     const full = path.join(dir, name);\n121:     fs.mkdirSync(path.dirname(full), { recursive: true });\n122:     let content = body;\n123:     if (name === 'graph-metadata.json' && body && typeof body === 'object' && !Array.isArray(body)) {\n124:       const rawDerived = body.derived && typeof body.derived === 'object' && !Array.isArray(body.derived)\n125:         ? body.derived\n126:         : {};\n127:       content = {\n128:         ...body,\n129:         intent_signals: Object.hasOwn(body, 'intent_signals') ? body.intent_signals : HEALTHY_INTENT_SIGNALS,\n130:         derived: {\n131:           ...rawDerived,\n132:           trigger_phrases: Object.hasOwn(rawDerived, 'trigger_phrases')\n133:             ? rawDerived.trigger_phrases\n134:             : HEALTHY_INTENT_SIGNALS,\n135:         },\n136:       };\n137:     }\n138:     fs.writeFileSync(full, typeof content === 'string' ? content : `${JSON.stringify(content, null, 2)}\\n`);\n139:   }\n140:   const declaresHub = Boolean(files && (files['mode-registry.json'] || files['hub-router.json']));\n141:   const suppliesRouter = Boolean(files && Object.hasOwn(files, 'ROUTER.md'));\n142:   if (options.standaloneRouter !== false && !declaresHub && !suppliesRouter) {\n143:     fs.writeFileSync(path.join(dir, 'ROUTER.md'), STANDALONE_ROUTER);\n144:   }\n145:   return dir;\n146: }\n147: \n148: function codesOf(result) {\n149:   return result.violations.map((v) => v.code).sort();\n150: }\n151: \n152: // ─────────────────────────────────────────────────────────────────────────────\n153: // 3. CLASSIFICATION\n154: // ─────────────────────────────────────────────────────────────────────────────\n155: \n156: function testDiscriminatorDecidesClass() {\n157:   const hub = contract.classifyPresence({ 'mode-registry.json': true, 'hub-router.json': true });\n158:   assert.equal(hub.skillClass, contract.CLASS_HUB);\n159: \n160:   const standalone = contract.classifyPresence({});\n161:   assert.equal(standalone.skillClass, contract.CLASS_STANDALONE);\n162: \n163:   // Exactly one half of the coupled declaration is not a third class.\n164:   for (const half of contract.DISCRIMINATOR_FILES) {\n165:     const partial = contract.classifyPresence({ [half]: true });\n166:     assert.equal(partial.skillClass, null, `${half} alone must not classify`);\n167:     assert.match(partial.reason, /partial hub declaration/);\n168:   }\n169: }\n170: \n171: function testClassificationIgnoresGeneratedOutput() {\n172:   // Classification must not consult generated files, or a root whose manifest\n173:   // was never written would classify differently after regeneration and the\n174:   // gate could never report the manifest as missing.\n175:   const withManifest = contract.classifyPresence({ 'leaf-manifest.json': true });\n176:   const without = contract.classifyPresence({});\n177:   assert.equal(withManifest.skillClass, without.skillClass);\n178: }\n179: \n180: function testPresenceAcceptsIterableOrMap() {\n181:   const fromList = contract.classifyPresence(['mode-registry.json', 'hub-router.json']);\n182:   assert.equal(fromList.skillClass, contract.CLASS_HUB);\n183:   const normalized = contract.normalizePresence(['description.json']);\n184:   assert.equal(normalized['description.json'], true);\n185:   assert.equal(normalized['hub-router.json'], false);\n186: }\n187: \n188: // ─────────────────────────────────────────────────────────────────────────────\n189: // 4. REQUIRED / FORBIDDEN / OVERLAY\n190: // ─────────────────────────────────────────────────────────────────────────────\n191: \n192: function testHubRequiresItsFullSet() {\n193:   const missingDescription = contract.evaluateRoot('some-hub', {\n194:     'mode-registry.json': true,\n195:     'hub-router.json': true,\n196:     'ROUTER.md': true,\n197:     'graph-metadata.json': true,\n198:     'leaf-manifest.json': true,\n199:     'command-metadata.json': true,\n200:   });\n201:   assert.deepEqual(codesOf(missingDescription), ['MISSING_REQUIRED_FILE']);\n202:   assert.equal(missingDescription.violations[0].file, 'description.json');\n203: \n204:   // command-metadata is optional for a hub: a hub that owns no slash commands\n205:   // carries no command surface, so its absence is conformant, not a violation.\n206:   const noCommands = contract.evaluateRoot('some-hub', {\n207:     'mode-registry.json': true,\n208:     'hub-router.json': true,\n209:     'ROUTER.md': true,\n210:     'graph-metadata.json': true,\n211:     'description.json': true,\n212:     'leaf-manifest.json': true,\n213:   });\n214:   assert.deepEqual(noCommands.violations, []);\n215: }\n216: \n217: function testStandaloneRequiresItsFullSet() {\n218:   const bare = contract.evaluateRoot('some-standalone', { 'graph-metadata.json': true });\n219:   const files = bare.violations.map((v) => v.file).sort();\n220:   assert.deepEqual(files, ['ROUTER.md', 'leaf-aliases.json', 'leaf-manifest.config.json', 'leaf-manifest.json']);\n221:   // Generated absences are reported under their own code so --fix knows which\n222:   // findings it is allowed to resolve by writing. The router is authored, so\n223:   // it stays a required-file finding.\n224:   const generated = bare.violations.filter((v) => v.code === 'MISSING_GENERATED_FILE').map((v) => v.file).sort();\n225:   assert.deepEqual(generated, ['leaf-aliases.json', 'leaf-manifest.json']);\n226:   const router = bare.violations.find((v) => v.file === 'ROUTER.md');\n227:   assert.equal(router.code, 'MISSING_REQUIRED_FILE');\n228: }\n229: \n230: function testStandaloneFullSetPasses() {\n231:   const result = contract.evaluateRoot('some-standalone', {\n232:     'graph-metadata.json': true,\n233:     'leaf-manifest.config.json': true,\n234:     'ROUTER.md': true,\n235:     'leaf-manifest.json': true,\n236:     'leaf-aliases.json': true,\n237:   });\n238:   assert.deepEqual(result.violations, []);\n239: }\n240: \n241: function testForbiddenFilesAreRejectedPerClass() {\n242:   const hubWithConfig = contract.evaluateRoot('some-hub', {\n243:     'mode-registry.json': true,\n244:     'hub-router.json': true,\n245:     'ROUTER.md': true,\n246:     'graph-metadata.json': true,\n247:     'description.json': true,\n248:     'leaf-manifest.json': true,\n249:     'command-metadata.json': true,\n250:     'leaf-manifest.config.json': true,\n251:   });\n252:   assert.deepEqual(codesOf(hubWithConfig), ['FORBIDDEN_FILE']);\n253:   assert.equal(hubWithConfig.violations[0].file, 'leaf-manifest.config.json');\n254: \n255:   const standaloneWithDescription = contract.evaluateRoot('some-standalone', {\n256:     'graph-metadata.json': true,\n257:     'leaf-manifest.config.json': true,\n258:     'leaf-manifest.json': true,\n259:     'leaf-aliases.json': true,\n260:     'ROUTER.md': true,\n261:     'description.json': true,\n262:   });\n263:   assert.deepEqual(codesOf(standaloneWithDescription), ['FORBIDDEN_FILE']);\n264:   assert.equal(standaloneWithDescription.violations[0].file, 'description.json');\n265: \n266:   // Command metadata is optional rather than forbidden on a standalone: a root\n267:   // that ships its own commands declares them, and ownership falls to the skill\n268:   // id because there is no registry mode to bind to.\n269:   const standaloneWithCommands = contract.evaluateRoot('some-standalone', {\n270:     'graph-metadata.json': true,\n271:     'leaf-manifest.config.json': true,\n272:     'leaf-manifest.json': true,\n273:     'leaf-aliases.json': true,\n274:     'ROUTER.md': true,\n275:     'command-metadata.json': true,\n276:   });\n277:   assert.deepEqual(codesOf(standaloneWithCommands), []);\n278: }\n279: \n280: function testCommandMetadataIsUniformAcrossHubs() {\n281:   // The command surface is class policy, not a per-root overlay: the same\n282:   // conforming hub presence map passes regardless of which hub carries it.\n283:   const conformingHub = {\n284:     'mode-registry.json': true,\n285:     'hub-router.json': true,\n286:     'ROUTER.md': true,\n287:     'graph-metadata.json': true,\n288:     'description.json': true,\n289:     'leaf-manifest.json': true,\n290:     'command-metadata.json': true,\n291:   };\n292:   assert.deepEqual(contract.evaluateRoot('sk-doc', conformingHub).violations, []);\n293:   assert.deepEqual(contract.OVERLAY_FILES, {});\n294: }\n295: \n296: function testGeneratedIsClassSensitive() {\n297:   // Aliases are derivable for a standalone root and authored for a hub. A\n298:   // caller that ignores class would happily overwrite a hub's real remaps.\n299:   assert.equal(contract.isGenerated('leaf-aliases.json', contract.CLASS_STANDALONE), true);\n300:   assert.equal(contract.isGenerated('leaf-aliases.json', contract.CLASS_HUB), false);\n301:   assert.equal(contract.isGenerated('leaf-manifest.json', contract.CLASS_HUB), true);\n302:   assert.equal(contract.isGenerated('description.json', contract.CLASS_HUB), false);\n303:   assert.throws(() => contract.isGenerated('leaf-manifest.json', 'Z'), /unknown skill class/);\n304: }\n305: \n306: function testLegalFilesForClass() {\n307:   // Command metadata is class policy rather than a per-root overlay, so both\n308:   // legal sets carry it: absence is conformant, presence is legal.\n309:   assert.ok(contract.legalFilesForClass(contract.CLASS_HUB, 'sk-doc').includes('command-metadata.json'));\n310:   assert.ok(contract.legalFilesForClass(contract.CLASS_HUB, 'sk-doc').includes('leaf-aliases.json'));\n311:   assert.ok(contract.legalFilesForClass(contract.CLASS_STANDALONE, 'sk-git').includes('command-metadata.json'));\n312: }\n313: \n314: // ─────────────────────────────────────────────────────────────────────────────\n315: // 5. FLEET CONFORMANCE\n316: // ─────────────────────────────────────────────────────────────────────────────\n317: \n318: function testFindSkillRootsSkipsPrivateSkills() {\n319:   const skillsDir = makeTmpSkillsDir();\n320:   makeRoot(skillsDir, 'alpha', { 'graph-metadata.json': { skill_id: 'alpha' } });\n321:   makeRoot(skillsDir, 'local-webflow', { 'graph-metadata.json': { skill_id: 'local-webflow' } });\n322:   const roots = gate.findSkillRoots(skillsDir).map((dir) => path.basename(dir));\n323:   assert.deepEqual(roots, ['alpha']);\n324: }\n325: \n326: function testFleetDiscoveryUsesTheAuthoredMarker() {\n327:   const roots = gate.findSkillRoots(SKILLS_DIR).map((d) => path.basename(d));\n328:   assert.deepEqual(roots, Object.keys(EXPECTED_CLASSES).sort());\n329: }\n330: \n331: function testEveryFleetRootMeetsItsClassShape() {\n332:   for (const [skillId, expectedClass] of Object.entries(EXPECTED_CLASSES)) {\n333:     const presence = gate.readPresence(path.join(SKILLS_DIR, skillId));\n334:     const result = contract.evaluateRoot(skillId, presence);\n335:     assert.equal(result.skillClass, expectedClass, `${skillId} class`);\n336:     // The router requirement is the one canon change an unmoved standalone\n337:     // root cannot meet yet; the ledger records it and the fleet gate enforces\n338:     // the file until the skill moves.\n339:     const unexpected = result.violations.filter((violation) => !(\n340:       expectedClass === contract.CLASS_STANDALONE\n341:       && violation.code === 'MISSING_REQUIRED_FILE'\n342:       && violation.file === 'ROUTER.md'\n343:     ));\n344:     assert.deepEqual(\n345:       unexpected, [],\n346:       `${skillId} must meet its class shape: ${unexpected.map((v) => v.message).join('; ')}`,\n347:     );\n348:   }\n349: }\n350: \n351: function testFleetAliasProjectionsAreIdentityForStandaloneRoots() {\n352:   for (const [skillId, skillClass] of Object.entries(EXPECTED_CLASSES)) {\n353:     if (skillClass !== contract.CLASS_STANDALONE) continue;\n354:     const rows = JSON.parse(fs.readFileSync(path.join(SKILLS_DIR, skillId, 'leaf-aliases.json'), 'utf8'));\n355:     assert.ok(Array.isArray(rows) && rows.length > 0, `${skillId} aliases non-empty`);\n356:     for (const row of rows) {\n357:       assert.equal(row.leafResourceId, row.diskPath, `${skillId} alias must be an identity row`);\n358:       assert.equal(row.workflowMode, skillId, `${skillId} alias mode`);\n359:     }\n360:   }\n361: }\n362: \n363: function testHubAliasesStayAuthored() {\n364:   // sk-doc is the fleet's proof that hub aliases carry information no generator\n365:   // can infer: rows that relocate a mode's resource into the shared tree.\n366:   const rows = JSON.parse(fs.readFileSync(path.join(SKILLS_DIR, 'sk-doc', 'leaf-aliases.json'), 'utf8'));\n367:   assert.ok(rows.some((row) => row.leafResourceId !== row.diskPath),\n368:     'sk-doc must retain at least one relocating alias row');\n369: }\n370: \n371: // ─────────────────────────────────────────────────────────────────────────────\n372: // 6. GATE BEHAVIOUR\n373: // ─────────────────────────────────────────────────────────────────────────────\n374: \n375: function testGateFlagsUnclassifiableRoot() {\n376:   const skillsDir = makeTmpSkillsDir();\n377:   makeRoot(skillsDir, 'half-declared', { 'mode-registry.json': { modes: [] } });\n378:   const result = gate.checkRoot(path.join(skillsDir, 'half-declared'));\n379:   assert.equal(result.skillClass, null);\n380:   assert.deepEqual(codesOf(result), ['UNCLASSIFIABLE_ROOT']);\n381: }\n382: \n383: function testGateDetectsNestedIdentity() {\n384:   const skillsDir = makeTmpSkillsDir();\n385:   makeRoot(skillsDir, 'nested-id', {\n386:     'graph-metadata.json': { skill_id: 'nested-id' },\n387:     'leaf-manifest.config.json': { workflowMode: 'nested-id' },\n388:     'references/a.md': '# a\\n',\n389:     'some-packet/graph-metadata.json': { skill_id: 'nested-id-packet' },\n390:   });\n391:   const result = gate.checkRoot(path.join(skillsDir, 'nested-id'));\n392:   assert.ok(codesOf(result).includes('NESTED_IDENTITY'));\n393: }\n394: \n395: function testGateIgnoresSameNamedContinuityMetadata() {\n396:   // The spec tree uses these filenames for a wholly separate continuity schema.\n397:   // A nested file lacking every skill-shaped key is a neighbour, not a rival.\n398:   const skillsDir = makeTmpSkillsDir();\n399:   makeRoot(skillsDir, 'continuity-neighbour', {\n400:     'graph-metadata.json': { skill_id: 'continuity-neighbour' },\n401:     'leaf-manifest.config.json': { workflowMode: 'continuity-neighbour' },\n402:     'references/a.md': '# a\\n',\n403:     'notes/graph-metadata.json': { packet: 'something', status: 'Planned', children_ids: [] },\n404:   });\n405:   const result = gate.checkRoot(path.join(skillsDir, 'continuity-neighbour'));\n406:   assert.ok(!codesOf(result).includes('NESTED_IDENTITY'));\n407: }\n408: \n409: function testGateRejectsUnknownGraphMetadataKey() {\n410:   const skillsDir = makeTmpSkillsDir();\n411:   const dir = makeRoot(skillsDir, 'unknown-graph-key', {\n412:     'graph-metadata.json': { skill_id: 'unknown-graph-key', manual: { related_to: [] } },\n413:     'leaf-manifest.config.json': { workflowMode: 'unknown-graph-key' },\n414:     'references/a.md': '# a\\n',\n415:   });\n416:   gate.checkRoot(dir, { fix: true });\n417: \n418:   const result = gate.checkRoot(dir);\n419:   assert.equal(result.status, 'fail');\n420:   const violation = result.violations.find((v) => v.code === 'GRAPH_METADATA_UNKNOWN_KEY');\n421:   assert.ok(violation);\n422:   assert.match(violation.message, /manual/);\n423: }\n424: \n425: function testGateAllowsKnownGraphMetadataExtra() {\n426:   const skillsDir = makeTmpSkillsDir();\n427:   const dir = makeRoot(skillsDir, 'known-graph-extra', {\n428:     'graph-metadata.json': { skill_id: 'known-graph-extra', importance_tier: 'important' },\n429:     'leaf-manifest.config.json': { workflowMode: 'known-graph-extra' },\n430:     'references/a.md': '# a\\n',\n431:   });\n432: \n433:   const result = gate.checkRoot(dir, { fix: true });\n434:   assert.equal(result.status, 'pass');\n435:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n436: }\n437: \n438: function testGateAcceptsSurfaceDetectionObject() {\n439:   const skillsDir = makeTmpSkillsDir();\n440:   const dir = makeRoot(skillsDir, 'surface-detection-ok', {\n441:     'graph-metadata.json': {\n442:       skill_id: 'surface-detection-ok',\n443:       surface_detection: { label: 'FIXTURE', role: 'specific', pathMarkers: ['src/fixture/'] },\n444:     },\n445:     'leaf-manifest.config.json': { workflowMode: 'surface-detection-ok' },\n446:     'references/a.md': '# a\\n',\n447:   });\n448: \n449:   const result = gate.checkRoot(dir, { fix: true });\n450:   assert.equal(result.status, 'pass');\n451:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n452:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_INVALID_SURFACE_DETECTION'));\n453: }\n454: \n455: function testGateRejectsNonObjectSurfaceDetection() {\n456:   const skillsDir = makeTmpSkillsDir();\n457:   const dir = makeRoot(skillsDir, 'surface-detection-bad', {\n458:     'graph-metadata.json': { skill_id: 'surface-detection-bad', surface_detection: ['src/fixture/'] },\n459:     'leaf-manifest.config.json': { workflowMode: 'surface-detection-bad' },\n460:     'references/a.md': '# a\\n',\n461:   });\n462: \n463:   const result = gate.checkRoot(dir, { fix: true });\n464:   assert.equal(result.status, 'fail');\n465:   assert.ok(codesOf(result).includes('GRAPH_METADATA_INVALID_SURFACE_DETECTION'));\n466:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n467: }\n468: \n469: /** Check a synthetic root carrying the given surface_detection object. */\n470: function surfaceDetectionViolations(skillId, block) {\n471:   const skillsDir = makeTmpSkillsDir();\n472:   const dir = makeRoot(skillsDir, skillId, {\n473:     'graph-metadata.json': { skill_id: skillId, surface_detection: block },\n474:     'leaf-manifest.config.json': { workflowMode: skillId },\n475:     'references/a.md': '# a\\n',\n476:   });\n477:   const result = gate.checkRoot(dir, { fix: true });\n478:   return result.violations.filter((v) => v.code === 'GRAPH_METADATA_INVALID_SURFACE_DETECTION');\n479: }\n480: \n481: function testGateAcceptsSurfaceDetectionWithEveryMarkerList() {\n482:   const found = surfaceDetectionViolations('surface-detection-full', {\n483:     label: 'FIXTURE',\n484:     role: 'specific',\n485:     pathMarkers: ['src/fixture/'],\n486:     fileMarkers: ['fixture.config.json'],\n487:     // Spaces inside or around a real marker are legal; only a blank one fails.\n488:     contentMarkers: ['fixture-runtime', 'from \"fixture\"', ' fixture-edge '],\n489:   });\n490:   assert.deepEqual(found, []);\n491: }\n492: \n493: function testGateIgnoresAbsentSurfaceDetection() {\n494:   const skillsDir = makeTmpSkillsDir();\n495:   const dir = makeRoot(skillsDir, 'surface-detection-absent', {\n496:     'graph-metadata.json': { skill_id: 'surface-detection-absent' },\n497:     'leaf-manifest.config.json': { workflowMode: 'surface-detection-absent' },\n498:     'references/a.md': '# a\\n',\n499:   });\n500:   const result = gate.checkRoot(dir, { fix: true });\n501:   assert.equal(result.status, 'pass');\n502:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_INVALID_SURFACE_DETECTION'));\n503: }\n504: \n505: function testGateRejectsSurfaceDetectionWithoutLabel() {\n506:   for (const label of [undefined, '', '   ', 7]) {\n507:     const found = surfaceDetectionViolations('surface-detection-no-label', {\n508:       label, role: 'specific', pathMarkers: ['src/fixture/'],\n509:     });\n510:     assert.equal(found.length, 1, `label ${JSON.stringify(label)} must fail once`);\n511:     assert.match(found[0].message, /surface_detection\\.label must be a non-empty string/);\n512:   }\n513: }\n514: \n515: function testGateRejectsSurfaceDetectionWithoutSpecificRole() {\n516:   // The fallback is the hub's own code, so an outside block may only be specific.\n517:   for (const role of [undefined, 'fallback', 'Specific', 'primary']) {\n518:     const found = surfaceDetectionViolations('surface-detection-bad-role', {\n519:       label: 'FIXTURE', role, pathMarkers: ['src/fixture/'],\n520:     });\n521:     assert.equal(found.length, 1, `role ${JSON.stringify(role)} must fail once`);\n522:     assert.match(found[0].message, /surface_detection\\.role must be \"specific\"/);\n523:   }\n524: }\n525: \n526: function testGateRejectsSurfaceDetectionWithoutMarkers() {\n527:   for (const markers of [{}, { pathMarkers: [], fileMarkers: [], contentMarkers: [] }]) {\n528:     const found = surfaceDetectionViolations('surface-detection-no-markers', {\n529:       label: 'FIXTURE', role: 'specific', ...markers,\n530:     });\n531:     assert.equal(found.length, 1, `markers ${JSON.stringify(markers)} must fail once`);\n532:     assert.match(found[0].message, /at least one non-empty marker array/);\n533:   }\n534: }\n535: \n536: function testGateRejectsSurfaceDetectionMarkerEntries() {\n537:   // A usable list elsewhere does not excuse a malformed one beside it.\n538:   for (const bad of ['src/fixture/', [''], [' '], ['\\t'], ['ok', 3], [null]]) {\n539:     const found = surfaceDetectionViolations('surface-detection-bad-entries', {\n540:       label: 'FIXTURE', role: 'specific', pathMarkers: ['src/fixture/'], contentMarkers: bad,\n541:     });\n542:     assert.equal(found.length, 1, `contentMarkers ${JSON.stringify(bad)} must fail once`);\n543:     assert.match(found[0].message, /surface_detection\\.contentMarkers must be an array of non-blank strings/);\n544:   }\n545: }\n546: \n547: function testGateAcceptsQualityBlock() {\n548:   const skillsDir = makeTmpSkillsDir();\n549:   const dir = makeRoot(skillsDir, 'quality-ok', {\n550:     'graph-metadata.json': {\n551:       skill_id: 'quality-ok',\n552:       quality: {\n553:         checklists: [\n554:           { paths: ['src/fixture/'], file: 'references/fixture-surface.md' },\n555:           { extensions: ['.fixture'], contentMarkers: ['fixture-runtime'], file: 'references/fixture-language.md' },\n556:         ],\n557:       },\n558:     },\n559:     'leaf-manifest.config.json': { workflowMode: 'quality-ok' },\n560:     'references/a.md': '# a\\n',\n561:   });\n562: \n563:   const result = gate.checkRoot(dir, { fix: true });\n564:   assert.equal(result.status, 'pass');\n565:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n566:   assert.ok(!codesOf(result).includes('GRAPH_METADATA_INVALID_QUALITY'));\n567: }\n568: \n569: /** Check a synthetic root carrying the given quality block. */\n570: function qualityViolations(skillId, block) {\n571:   const skillsDir = makeTmpSkillsDir();\n572:   const dir = makeRoot(skillsDir, skillId, {\n573:     'graph-metadata.json': { skill_id: skillId, quality: block },\n574:     'leaf-manifest.config.json': { workflowMode: skillId },\n575:     'references/a.md': '# a\\n',\n576:   });\n577:   const result = gate.checkRoot(dir, { fix: true });\n578:   return result.violations.filter((v) => v.code === 'GRAPH_METADATA_INVALID_QUALITY');\n579: }\n580: \n581: function testGateRejectsMalformedQualityBlock() {\n582:   // A row scopes a checklist to files and names the checklist. A command would\n583:   // let a skill run one, and commands come only from the repository's quality\n584:   // config, so every command-shaped key is refused rather than ignored.\n585:   const row = { paths: ['src/fixture/'], file: 'references/a.md' };\n586:   const cases = [\n587:     ['row argv', { checklists: [{ ...row, argv: ['make', 'lint'] }] }, /unknown key argv/],\n588:     ['row command', { checklists: [{ ...row, command: 'make lint' }] }, /unknown key command/],\n589:     ['row run', { checklists: [{ ...row, run: 'make lint' }] }, /unknown key run/],\n590:     ['block command', { checklists: [row], command: 'make lint' }, /quality holds unknown key command/],\n591:     ['no selector', { checklists: [{ file: 'references/a.md' }] }, /names no selector/],\n592:     ['file outside', { checklists: [{ paths: ['src/fixture/'], file: '../a.md' }] }, /relative \\.md path/],\n593:     ['blank selector', { checklists: [{ paths: [' '], file: 'references/a.md' }] }, /must be a non-empty array of non-blank strings/],\n594:   ];\n595:   for (const [name, block, pattern] of cases) {\n596:     const found = qualityViolations('quality-bad', block);\n597:     assert.equal(found.length, 1, `${name} must fail once`);\n598:     assert.match(found[0].message, pattern, name);\n599:   }\n600:   // A present value that is not a usable block fails even before any row.\n601:   for (const block of [['references/a.md'], { checklists: [] }]) {\n602:     const found = qualityViolations('quality-not-a-block', block);\n603:     assert.equal(found.length, 1, `block ${JSON.stringify(block)} must fail once`);\n604:   }\n605: }\n606: \n607: function testGateRejectsIntentSignalsBelowFloor() {\n608:   const skillsDir = makeTmpSkillsDir();\n609:   const dir = makeRoot(skillsDir, 'thin-intent-signals', {\n610:     'graph-metadata.json': {\n611:       skill_id: 'thin-intent-signals',\n612:       intent_signals: ['one', 'two', 'three'],\n613:       derived: { trigger_phrases: ['one', 'two', 'three'] },\n614:     },\n615:     'leaf-manifest.config.json': { workflowMode: 'thin-intent-signals' },\n616:     'references/a.md': '# a\\n',\n617:   });\n618:   const result = gate.checkRoot(dir, { fix: true });\n619:   assert.ok(codesOf(result).includes('INTENT_SIGNALS_BELOW_FLOOR'));\n620: }\n621: \n622: function testGateRejectsEmptyIntentSignalsAndTriggers() {\n623:   const skillsDir = makeTmpSkillsDir();\n624:   const dir = makeRoot(skillsDir, 'empty-routing-signals', {\n625:     'graph-metadata.json': {\n626:       skill_id: 'empty-routing-signals',\n627:       intent_signals: [],\n628:       derived: { trigger_phrases: [] },\n629:     },\n630:     'leaf-manifest.config.json': { workflowMode: 'empty-routing-signals' },\n631:     'references/a.md': '# a\\n',\n632:   });\n633:   const result = gate.checkRoot(dir, { fix: true });\n634:   assert.ok(codesOf(result).includes('INTENT_SIGNALS_AND_TRIGGERS_EMPTY'));\n635: }\n636: \n637: function testGateAcceptsIntentSignalsAtFloor() {\n638:   const skillsDir = makeTmpSkillsDir();\n639:   const dir = makeRoot(skillsDir, 'healthy-routing-signals', {\n640:     'graph-metadata.json': {\n641:       skill_id: 'healthy-routing-signals',\n642:       intent_signals: HEALTHY_INTENT_SIGNALS,\n643:       derived: { trigger_phrases: HEALTHY_INTENT_SIGNALS },\n644:     },\n645:     'leaf-manifest.config.json': { workflowMode: 'healthy-routing-signals' },\n646:     'references/a.md': '# a\\n',\n647:   });\n648:   assert.equal(gate.checkRoot(dir, { fix: true }).status, 'pass');\n649: }\n650: \n651: function testGateValidatesSignalProvenanceLists() {\n652:   const skillsDir = makeTmpSkillsDir();\n653:   const dir = makeRoot(skillsDir, 'signal-provenance-ok', {\n654:     'graph-metadata.json': {\n655:       skill_id: 'signal-provenance-ok',\n656:       intent_signals_generated: ['generated phrase one'],\n657:       intent_signals_keep: ['kept phrase one'],\n658:     },\n659:     'leaf-manifest.config.json': { workflowMode: 'signal-provenance-ok' },\n660:     'references/a.md': '# a\\n',\n661:   });\n662:   const valid = gate.checkRoot(dir, { fix: true });\n663:   assert.equal(valid.status, 'pass');\n664:   assert.ok(!codesOf(valid).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n665:   assert.ok(!codesOf(valid).includes('GRAPH_METADATA_INVALID_SIGNAL_LIST'));\n666: \n667:   const brokenDir = makeRoot(skillsDir, 'signal-provenance-broken', {\n668:     'graph-metadata.json': {\n669:       skill_id: 'signal-provenance-broken',\n670:       intent_signals_generated: ['generated phrase one', '   '],\n671:     },\n672:     'leaf-manifest.config.json': { workflowMode: 'signal-provenance-broken' },\n673:     'references/a.md': '# a\\n',\n674:   });\n675:   const broken = gate.checkRoot(brokenDir, { fix: true });\n676:   assert.equal(broken.status, 'fail');\n677:   assert.ok(!codesOf(broken).includes('GRAPH_METADATA_UNKNOWN_KEY'));\n678:   const found = broken.violations.filter((v) => v.code === 'GRAPH_METADATA_INVALID_SIGNAL_LIST');\n679:   assert.equal(found.length, 1);\n680:   assert.match(found[0].message, /intent_signals_generated must be an array of non-blank strings/);\n681: }\n682: \n683: function testGateDetectsStaleGeneratedManifest() {\n684:   const skillsDir = makeTmpSkillsDir();\n685:   const dir = makeRoot(skillsDir, 'stale-manifest', {\n686:     'graph-metadata.json': { skill_id: 'stale-manifest' },\n687:     'leaf-manifest.config.json': { workflowMode: 'stale-manifest' },\n688:     'references/a.md': '# a\\n',\n689:   });\n690:   // Write a manifest, then add a leaf so the committed bytes fall behind.\n691:   gate.checkRoot(dir, { fix: true });\n692:   fs.writeFileSync(path.join(dir, 'references', 'b.md'), '# b\\n');\n693: \n694:   const stale = gate.checkRoot(dir);\n695:   const staleCodes = stale.violations.filter((v) => v.code === 'STALE_GENERATED_FILE').map((v) => v.file).sort();\n696:   assert.deepEqual(staleCodes, ['leaf-aliases.json', 'leaf-manifest.json']);\n697: \n698:   // --fix resolves both, and a second pass is clean, proving idempotence.\n699:   const fixed = gate.checkRoot(dir, { fix: true });\n700:   assert.deepEqual(fixed.violations, []);\n701:   assert.deepEqual(fixed.written.sort(), ['leaf-aliases.json', 'leaf-manifest.json']);\n702:   assert.deepEqual(gate.checkRoot(dir).violations, []);\n703: }\n704: \n705: function testFixNeverWritesAuthoredFiles() {\n706:   const skillsDir = makeTmpSkillsDir();\n707:   const dir = makeRoot(skillsDir, 'authored-only', {\n708:     'graph-metadata.json': { skill_id: 'authored-only' },\n709:     'references/a.md': '# a\\n',\n710:   });\n711:   // No manifest config: the generator cannot run, and --fix must not invent one.\n712:   const result = gate.checkRoot(dir, { fix: true });\n713:   assert.equal(fs.existsSync(path.join(dir, 'leaf-manifest.config.json')), false);\n714:   assert.ok(codesOf(result).includes('MISSING_REQUIRED_FILE'));\n715:   assert.ok(codesOf(result).includes('MANIFEST_REGENERATION_FAILED'));\n716: }\n717: \n718: function testFixDoesNotTouchHubAliases() {\n719:   const skillsDir = makeTmpSkillsDir();\n720:   const authored = [{ workflowMode: 'm', leafResourceId: 'references/x.md', diskPath: 'shared/references/x.md' }];\n721:   const dir = makeRoot(skillsDir, 'hub-aliases', {\n722:     'graph-metadata.json': { skill_id: 'hub-aliases' },\n723:     'description.json': { name: 'hub-aliases', description: 'd', version: '1.0.0', keywords: [] },\n724:     'mode-registry.json': { modes: [{ workflowMode: 'm', packet: '.' }] },\n725:     'hub-router.json': { skill: 'hub-aliases' },\n726:     'leaf-aliases.json': authored,\n727:     'references/x.md': '# x\\n',\n728:     'shared/references/x.md': '# shared x\\n',\n729:   });\n730:   const before = fs.readFileSync(path.join(dir, 'leaf-aliases.json'));\n731:   gate.checkRoot(dir, { fix: true });\n732:   const after = fs.readFileSync(path.join(dir, 'leaf-aliases.json'));\n733:   assert.equal(Buffer.compare(before, after), 0, 'hub aliases must survive --fix untouched');\n734: }\n735: \n736: function testAliasProjectionIsDeterministicAndSetPreserving() {\n737:   const manifest = Buffer.from(`${JSON.stringify({\n738:     resourceContractVersion: 1,\n739:     modes: [{ workflowMode: 'only', packet: '.', leaves: ['assets/b.md', 'references/a.md'] }],\n740:   }, null, 2)}\\n`);\n741:   const first = gate.buildAliasBytes(manifest);\n742:   const second = gate.buildAliasBytes(manifest);\n743:   assert.equal(Buffer.compare(first, second), 0);\n744:   const rows = JSON.parse(first.toString('utf8'));\n745:   assert.deepEqual(rows.map((r) => r.leafResourceId), ['assets/b.md', 'references/a.md']);\n746:   assert.ok(rows.every((r) => r.leafResourceId === r.diskPath && r.workflowMode === 'only'));\n747: }\n748: \n749: function testGateRunExitsNonZeroOnViolations() {\n750:   const skillsDir = makeTmpSkillsDir();\n751:   makeRoot(skillsDir, 'broken', { 'mode-registry.json': { modes: [] } });\n752:   const originalWrite = process.stdout.write.bind(process.stdout);\n753:   process.stdout.write = () => true;\n754:   let code;\n755:   try {\n756:     code = gate.run({ skillsDir, format: 'json', fix: false });\n757:   } finally {\n758:     process.stdout.write = originalWrite;\n759:   }\n760:   assert.equal(code, 1);\n761: }\n762: \n763: // ─────────────────────────────────────────────────────────────────────────────\n764: // 7. RUN\n765: // ─────────────────────────────────────────────────────────────────────────────\n766: \n767: // ─────────────────────────────────────────────────────────────────────────────\n768: // 6b. COMMAND-METADATA CORE SCHEMA\n769: // ─────────────────────────────────────────────────────────────────────────────\n770: \n771: const commandSchema = require('../lib/command-metadata-schema.cjs');\n772: \n773: function validEntry(overrides) {\n774:   return Object.assign({\n775:     command: '/demo:run',\n776:     ownerMode: 'demo-mode',\n777:     description: 'Run the demo workflow.',\n778:     argumentHint: '<target> [:auto]',\n779:     userIntent: { job: 'I want to run the demo.', ownedSignals: ['run the demo'] },\n780:     choreography: [\n781:       { order: 1, skill: 'demo', resource: 'SKILL.md', action: 'load the hub' },\n782:       { order: 2, skill: 'demo-mode', resource: 'demo-mode/SKILL.md', action: 'apply to $ARGUMENTS' },\n783:     ],\n784:   }, overrides);\n785: }\n786: \n787: function schemaCodes(entries, extra) {\n788:   return commandSchema.validateCommandMetadata(entries, Object.assign({\n789:     skillId: 'demo', registryModes: ['demo-mode'],\n790:   }, extra)).map((v) => v.code).sort();\n791: }\n792: \n793: function testCommandSchemaAcceptsValidAndEmpty() {\n794:   assert.deepEqual(schemaCodes([]), []);\n795:   assert.deepEqual(schemaCodes([validEntry()]), []);\n796:   // Unknown extension fields are deliberately legal — the design hub's richer\n797:   // shape must keep validating without the core knowing its fields.\n798:   assert.deepEqual(schemaCodes([validEntry({ registerPolicy: { accepted: ['brand'] } })]), []);\n799:   // Choreography order is relative, not one-based: a step numbered 0 is legal.\n800:   assert.deepEqual(schemaCodes([validEntry({\n801:     choreography: [\n802:       { order: 0, skill: 'demo', resource: 'SKILL.md', action: 'load' },\n803:       { order: 1, skill: 'demo', resource: 'SKILL.md', action: 'apply' },\n804:     ],\n805:   })]), []);\n806: }\n807: \n808: function testCommandSchemaRejectsCoreViolations() {\n809:   assert.deepEqual(schemaCodes('nope'), ['COMMAND_METADATA_NOT_ARRAY']);\n810:   assert.deepEqual(schemaCodes([{}]).includes('MISSING_FIELD'), true);\n811:   assert.deepEqual(schemaCodes([validEntry({ command: 'create:skill' })]), ['BAD_COMMAND_ID']);\n812:   assert.deepEqual(schemaCodes([validEntry({ ownerMode: 'ghost' })]), ['UNKNOWN_OWNER_MODE']);\n813:   assert.deepEqual(schemaCodes([validEntry(), validEntry()]).includes('DUPLICATE_COMMAND'), true);\n814:   const clash = [\n815:     validEntry(),\n816:     validEntry({ command: '/demo:other', userIntent: { job: 'other job here', ownedSignals: ['Run The Demo'] } }),\n817:   ];\n818:   assert.ok(schemaCodes(clash).includes('DUPLICATE_OWNED_SIGNAL'), 'signal dedup must be case-insensitive');\n819:   assert.deepEqual(schemaCodes([validEntry({ userIntent: { job: 'j', ownedSignals: [] } })]), ['BAD_USER_INTENT']);\n820:   assert.deepEqual(schemaCodes([validEntry({ choreography: [] })]), ['BAD_CHOREOGRAPHY']);\n821:   assert.deepEqual(schemaCodes([validEntry({\n822:     choreography: [\n823:       { order: 2, skill: 'demo', resource: 'SKILL.md', action: 'load' },\n824:       { order: 1, skill: 'demo', resource: 'SKILL.md', action: 'apply' },\n825:     ],\n826:   })]), ['CHOREOGRAPHY_ORDER']);\n827: }\n828: \n829: function testCommandSchemaUsesInjectedProbes() {\n830:   const missingResource = commandSchema.validateCommandMetadata([validEntry()], {\n831:     skillId: 'demo', registryModes: ['demo-mode'], resourceExists: () => false,\n832:   });\n833:   assert.ok(missingResource.some((v) => v.code === 'CHOREOGRAPHY_RESOURCE_MISSING'));\n834:   const missingCommand = commandSchema.validateCommandMetadata([validEntry()], {\n835:     skillId: 'demo', registryModes: ['demo-mode'], commandExists: () => false,\n836:   });\n837:   assert.ok(missingCommand.some((v) => v.code === 'COMMAND_FILE_MISSING'));\n838:   assert.equal(commandSchema.commandDefinitionRelPath('/create:skill'), 'create/skill.md');\n839:   assert.equal(commandSchema.commandDefinitionRelPath('/doctor'), 'doctor.md');\n840: }\n841: \n842: function testCommandSchemaRejectsWithinEntryDuplicateSignal() {\n843:   // A command listing the same signal twice is dead weight, not cross-command\n844:   // ambiguity — it must be flagged under its own code, not silently accepted.\n845:   const codes = schemaCodes([validEntry({\n846:     userIntent: { job: 'I want to run the demo.', ownedSignals: ['run the demo', 'Run The Demo'] },\n847:   })]);\n848:   assert.deepEqual(codes, ['DUPLICATE_OWNED_SIGNAL_WITHIN_ENTRY']);\n849: }\n850: \n851: function testGateRejectsNonDirectorySkillsDir() {\n852:   // A regular file passed as --skills-dir used to be swallowed into a\n853:   // false-green zero-root pass; it must now exit 2 (\"cannot run\").\n854:   const skillsDir = makeTmpSkillsDir();\n855:   const filePath = path.join(skillsDir, 'not-a-dir');\n856:   fs.writeFileSync(filePath, 'x');\n857:   const originalWrite = process.stderr.write.bind(process.stderr);\n858:   process.stderr.write = () => true;\n859:   let code;\n860:   try {\n861:     code = gate.run({ skillsDir: filePath, format: 'json', fix: false });\n862:   } finally {\n863:     process.stderr.write = originalWrite;\n864:   }\n865:   assert.equal(code, 2);\n866: }\n867: \n868: function testStandaloneCommandOwnersAreTheSkillItself() {\n869:   // A standalone root ships no mode registry, so no registry mode can own its\n870:   // commands; the skill's own id is the only coherent owner there. A foreign\n871:   // mode must stay a finding, or the owner check would be one no entry passes.\n872:   const skillId = 'solo-commands';\n873:   const skillsDir = makeTmpSkillsDir();\n874:   const dir = makeRoot(skillsDir, skillId, {\n875:     'graph-metadata.json': { skill_id: skillId },\n876:     'leaf-manifest.config.json': { workflowMode: skillId },\n877:     'references/a.md': '# a\\n',\n878:     'command-metadata.json': [validEntry({ ownerMode: skillId })],\n879:   });\n880: \n881:   // The gate namespaces every command finding under its own file, so the core\n882:   // schema's code reaches a caller prefixed.\n883:   const ownerFindings = (target) => gate.checkCommandMetadata(target)\n884:     .filter((violation) => violation.code === 'COMMAND_METADATA_UNKNOWN_OWNER_MODE');\n885: \n886:   assert.deepEqual(ownerFindings(dir), []);\n887: \n888:   fs.writeFileSync(\n889:     path.join(dir, 'command-metadata.json'),\n890:     `${JSON.stringify([validEntry({ ownerMode: 'some-other-mode' })], null, 2)}\\n`,\n891:   );\n892:   const foreign = ownerFindings(dir);\n893:   assert.equal(foreign.length, 1, JSON.stringify(foreign));\n894:   assert.equal(foreign[0].file, 'command-metadata.json');\n895:   assert.match(foreign[0].message, /some-other-mode/);\n896: }\n897: \n898: // ─────────────────────────────────────────────────────────────────────────────\n899: // 6c. ROUTER MIGRATION DEBT\n900: // ─────────────────────────────────────────────────────────────────────────────\n901: \n902: /** Point the shared ledger reader at a fixture ledger for one check. */\n903: function withDebtLedger(entries, fn) {\n904:   const dir = makeTmpSkillsDir();\n905:   const file = path.join(dir, 'routing-shape-known-debt.json');\n906:   fs.writeFileSync(file, `${JSON.stringify({\n907:     maxSmartRoutingLines: 12,\n908:     maxSmartRoutingWords: 180,\n909:     debt: entries,\n910:   }, null, 2)}\\n`);\n911:   const previous = process.env.ROUTING_SHAPE_DEBT_FILE;\n912:   process.env.ROUTING_SHAPE_DEBT_FILE = file;\n913:   try {\n914:     return fn();\n915:   } finally {\n916:     if (previous === undefined) delete process.env.ROUTING_SHAPE_DEBT_FILE;\n917:     else process.env.ROUTING_SHAPE_DEBT_FILE = previous;\n918:   }\n919: }\n920: \n921: /** A conforming standalone root whose sibling router is still missing. */\n922: function makeUnmovedStandalone(skillsDir, skillId) {\n923:   const dir = makeRoot(skillsDir, skillId, {\n924:     'graph-metadata.json': { skill_id: skillId },\n925:     'leaf-manifest.config.json': { workflowMode: skillId },\n926:     'references/a.md': '# a\\n',\n927:   }, { standaloneRouter: false });\n928:   withDebtLedger({}, () => gate.checkRoot(dir, { fix: true }));\n929:   return dir;\n930: }\n931: \n932: function testGateRequiresRouterWithoutRecordedDebt() {\n933:   const skillsDir = makeTmpSkillsDir();\n934:   const dir = makeUnmovedStandalone(skillsDir, 'router-missing');\n935:   const result = withDebtLedger({}, () => gate.checkRoot(dir));\n936:   assert.ok(codesOf(result).includes('MISSING_REQUIRED_FILE'), JSON.stringify(result.violations));\n937:   assert.ok(codesOf(result).includes('RRC-001'), JSON.stringify(result.violations));\n938:   assert.equal(result.notes.some((note) => note.code === 'RS-004'), false);\n939: }\n940: \n941: function testGateToleratesRouterRecordedAsDebt() {\n942:   const skillsDir = makeTmpSkillsDir();\n943:   const dir = makeUnmovedStandalone(skillsDir, 'router-debt');\n944:   const result = withDebtLedger({\n945:     'router-debt': { lines: 0, words: 0, machineBlocks: 1, codes: ['RS-002', 'RS-004'] },\n946:   }, () => gate.checkRoot(dir));\n947:   assert.equal(result.status, 'pass', JSON.stringify(result.violations));\n948:   assert.ok(!codesOf(result).includes('MISSING_REQUIRED_FILE'));\n949:   assert.ok(!codesOf(result).includes('RRC-001'));\n950:   const note = result.notes.find((entry) => entry.code === 'RS-004');\n951:   assert.ok(note, JSON.stringify(result.notes));\n952:   assert.match(note.message, /router-debt/);\n953: }\n954: \n955: function testGateRejectsRouterDebtWithoutTheRouterCode() {\n956:   // Length debt alone never excuses a missing router: the entry must record\n957:   // the code the missing file would raise.\n958:   const skillsDir = makeTmpSkillsDir();\n959:   const dir = makeUnmovedStandalone(skillsDir, 'router-length-debt');\n960:   const result = withDebtLedger({\n961:     'router-length-debt': { lines: 0, words: 0, machineBlocks: 1, codes: ['RS-001'] },\n962:   }, () => gate.checkRoot(dir));\n963:   assert.ok(codesOf(result).includes('MISSING_REQUIRED_FILE'));\n964:   assert.ok(codesOf(result).includes('RRC-001'));\n965: }\n966: \n967: try {\n968:   testDiscriminatorDecidesClass();\n969:   testClassificationIgnoresGeneratedOutput();\n970:   testPresenceAcceptsIterableOrMap();\n971:   testHubRequiresItsFullSet();\n972:   testStandaloneRequiresItsFullSet();\n973:   testStandaloneFullSetPasses();\n974:   testForbiddenFilesAreRejectedPerClass();\n975:   testCommandMetadataIsUniformAcrossHubs();\n976:   testGeneratedIsClassSensitive();\n977:   testLegalFilesForClass();\n978:   testFleetDiscoveryUsesTheAuthoredMarker();\n979:   testEveryFleetRootMeetsItsClassShape();\n980:   testFleetAliasProjectionsAreIdentityForStandaloneRoots();\n981:   testHubAliasesStayAuthored();\n982:   testGateFlagsUnclassifiableRoot();\n983:   testGateDetectsNestedIdentity();\n984:   testGateIgnoresSameNamedContinuityMetadata();\n985:   testGateRejectsUnknownGraphMetadataKey();\n986:   testGateAllowsKnownGraphMetadataExtra();\n987:   testGateAcceptsSurfaceDetectionObject();\n988:   testGateRejectsNonObjectSurfaceDetection();\n989:   testGateAcceptsSurfaceDetectionWithEveryMarkerList();\n990:   testGateIgnoresAbsentSurfaceDetection();\n991:   testGateRejectsSurfaceDetectionWithoutLabel();\n992:   testGateRejectsSurfaceDetectionWithoutSpecificRole();\n993:   testGateRejectsSurfaceDetectionWithoutMarkers();\n994:   testGateRejectsSurfaceDetectionMarkerEntries();\n995:   testGateAcceptsQualityBlock();\n996:   testGateRejectsMalformedQualityBlock();\n997:   testGateRejectsIntentSignalsBelowFloor();\n998:   testGateRejectsEmptyIntentSignalsAndTriggers();\n999:   testGateAcceptsIntentSignalsAtFloor();\n1000:   testGateValidatesSignalProvenanceLists();\n1001:   testGateDetectsStaleGeneratedManifest();\n1002:   testFixNeverWritesAuthoredFiles();\n1003:   testFixDoesNotTouchHubAliases();\n1004:   testAliasProjectionIsDeterministicAndSetPreserving();\n1005:   testGateRunExitsNonZeroOnViolations();\n1006:   testCommandSchemaAcceptsValidAndEmpty();\n1007:   testCommandSchemaRejectsCoreViolations();\n1008:   testCommandSchemaUsesInjectedProbes();\n1009:   testCommandSchemaRejectsWithinEntryDuplicateSignal();\n1010:   testFindSkillRootsSkipsPrivateSkills();\n1011:   testGateRejectsNonDirectorySkillsDir();\n1012:   testStandaloneCommandOwnersAreTheSkillItself();\n1013:   testGateRequiresRouterWithoutRecordedDebt();\n1014:   testGateToleratesRouterRecordedAsDebt();\n1015:   testGateRejectsRouterDebtWithoutTheRouterCode();\n1016: } finally {\n1017:   if (tmpRoot) fs.rmSync(tmpRoot, { recursive: true, force: true });\n1018: }\n1019: \n1020: console.log('[sk-doc] skill-root-metadata contract + fleet gate coverage passed');"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/tests/skill-root-metadata-contract.test.cjs\"}"},"time":{"start":1794582804864,"end":1794582806898}}}}
{"type":"tool_use","timestamp":1794582806903,"sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","part":{"partID":"prt_1d5787562001VkBu1KfKKOkvO8","sessionID":"ses_e2a8827cfffePFfrjkEfSEl2K2","messageID":"msg_1d578631a001E6KGPTUnximQa4","type":"tool","id":"chatcmpl-tool-a8002b8b46ed6260","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/lib/command-metadata-schema.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/lib/command-metadata-schema.cjs, lines 1-219\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ command-metadata-schema — pure hub command-metadata core contract        ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: /**\n7:  * command-metadata-schema.cjs — pure validator for a hub's command-metadata.json.\n8:  *\n9:  * Every hub carries this file as part of its class contract: an array with one\n10:  * entry per slash command the hub owns, or an empty array when it owns none.\n11:  * The file turns each command's routing identity and load choreography into\n12:  * checkable data — before it, that contract lived only in prose that every\n13:  * reader paraphrased slightly differently, and only one hub's version was\n14:  * validated by anything.\n15:  *\n16:  * This module owns the CORE schema: the hub-agnostic fields every entry must\n17:  * carry. A hub may extend entries with domain-specific fields (the design hub\n18:  * carries register policies and task projections, for example); unknown fields\n19:  * are deliberately legal so richer per-hub validators can layer on top without\n20:  * forking the core. The core checks:\n21:  *\n22:  *   - `command`        slash-command id, `/family:name` (or legacy `/name`)\n23:  *   - `ownerMode`      must name a workflowMode in the hub's mode registry\n24:  *   - `description`    non-empty routing description\n25:  *   - `argumentHint`   invocation grammar as shown to the operator\n26:  *   - `userIntent`     `{ job, ownedSignals[] }` — the routing vocabulary\n27:  *   - `choreography`   ordered resource loads `{ order, skill, resource, action }`\n28:  *\n29:  * Cross-entry rules: command ids unique; owned signals unique across entries\n30:  * (two commands claiming one signal makes routing ambiguous by construction).\n31:  *\n32:  * No filesystem access happens here. The caller supplies the registry's mode\n33:  * list and an existence probe, so resource resolution stays testable and the\n34:  * gate stays the single place that touches disk.\n35:  */\n36: \n37: // ─────────────────────────────────────────────────────────────────────────────\n38: // 1. CONSTANTS\n39: // ─────────────────────────────────────────────────────────────────────────────\n40: \n41: const COMMAND_ID_PATTERN = /^\\/[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)?$/;\n42: \n43: const REQUIRED_ENTRY_FIELDS = Object.freeze([\n44:   'command',\n45:   'ownerMode',\n46:   'description',\n47:   'argumentHint',\n48:   'userIntent',\n49:   'choreography',\n50: ]);\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. HELPERS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: function violation(code, command, message) {\n57:   return { code, command, message };\n58: }\n59: \n60: function isNonEmptyString(value) {\n61:   return typeof value === 'string' && value.trim().length > 0;\n62: }\n63: \n64: // ─────────────────────────────────────────────────────────────────────────────\n65: // 3. CORE LOGIC\n66: // ─────────────────────────────────────────────────────────────────────────────\n67: \n68: /**\n69:  * Validate one hub's parsed command-metadata content against the core schema.\n70:  *\n71:  * @param {unknown} entries - parsed JSON content of command-metadata.json.\n72:  * @param {object} context\n73:  * @param {string} context.skillId - hub directory name, for messages.\n74:  * @param {string[]} context.registryModes - workflowMode ids from mode-registry.json.\n75:  * @param {(hubRelativePath: string) => boolean} [context.resourceExists]\n76:  *   - probe for choreography resource paths (repo-root-relative). Omitted in\n77:  *     pure unit tests; when absent, existence checks are skipped.\n78:  * @param {(commandId: string) => boolean} [context.commandExists]\n79:  *   - probe for the command's definition file. Omitted → skipped.\n80:  * @returns {{ code: string, command: string|null, message: string }[]}\n81:  */\n82: function validateCommandMetadata(entries, context) {\n83:   const { skillId, registryModes } = context;\n84:   const violations = [];\n85: \n86:   if (!Array.isArray(entries)) {\n87:     return [violation('COMMAND_METADATA_NOT_ARRAY', null,\n88:       `${skillId}: command-metadata.json must be an array (empty when the hub owns no commands)`)];\n89:   }\n90: \n91:   const modes = new Set(registryModes || []);\n92:   const seenCommands = new Set();\n93:   const seenSignals = new Map();\n94: \n95:   entries.forEach((entry, index) => {\n96:     if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n97:       violations.push(violation('MALFORMED_ENTRY', null, `${skillId}: entry ${index} is not an object`));\n98:       return;\n99:     }\n100:     const id = typeof entry.command === 'string' ? entry.command : `entry ${index}`;\n101: \n102:     for (const field of REQUIRED_ENTRY_FIELDS) {\n103:       if (!(field in entry)) {\n104:         violations.push(violation('MISSING_FIELD', id, `${skillId}: ${id} lacks required field '${field}'`));\n105:       }\n106:     }\n107: \n108:     if ('command' in entry) {\n109:       if (!isNonEmptyString(entry.command) || !COMMAND_ID_PATTERN.test(entry.command)) {\n110:         violations.push(violation('BAD_COMMAND_ID', id,\n111:           `${skillId}: '${entry.command}' is not a /family:name slash-command id`));\n112:       } else if (seenCommands.has(entry.command)) {\n113:         violations.push(violation('DUPLICATE_COMMAND', id, `${skillId}: '${entry.command}' declared twice`));\n114:       } else {\n115:         seenCommands.add(entry.command);\n116:         if (context.commandExists && !context.commandExists(entry.command)) {\n117:           violations.push(violation('COMMAND_FILE_MISSING', id,\n118:             `${skillId}: no command definition found for '${entry.command}' under .skilled/commands/`));\n119:         }\n120:       }\n121:     }\n122: \n123:     if ('ownerMode' in entry && !modes.has(entry.ownerMode)) {\n124:       violations.push(violation('UNKNOWN_OWNER_MODE', id,\n125:         `${skillId}: ownerMode '${entry.ownerMode}' is not a workflowMode in mode-registry.json`));\n126:     }\n127: \n128:     for (const field of ['description', 'argumentHint']) {\n129:       if (field in entry && !isNonEmptyString(entry[field])) {\n130:         violations.push(violation('EMPTY_FIELD', id, `${skillId}: ${id} has an empty '${field}'`));\n131:       }\n132:     }\n133: \n134:     if ('userIntent' in entry) {\n135:       const intent = entry.userIntent;\n136:       if (!intent || typeof intent !== 'object'\n137:           || !isNonEmptyString(intent.job)\n138:           || !Array.isArray(intent.ownedSignals) || intent.ownedSignals.length === 0\n139:           || !intent.ownedSignals.every(isNonEmptyString)) {\n140:         violations.push(violation('BAD_USER_INTENT', id,\n141:           `${skillId}: ${id} userIntent must be { job, ownedSignals[] } with at least one signal`));\n142:       } else {\n143:         const localSignals = new Set();\n144:         for (const signal of intent.ownedSignals) {\n145:           const key = signal.trim().toLowerCase();\n146:           if (localSignals.has(key)) {\n147:             // A command repeating its own signal is dead weight, not routing\n148:             // ambiguity — flag it under its own code so the fix is \"dedup the\n149:             // list\", not \"rename a colliding sibling\".\n150:             violations.push(violation('DUPLICATE_OWNED_SIGNAL_WITHIN_ENTRY', id,\n151:               `${skillId}: ${id} lists signal '${signal}' more than once`));\n152:             continue;\n153:           }\n154:           localSignals.add(key);\n155:           if (seenSignals.has(key) && seenSignals.get(key) !== entry.command) {\n156:             violations.push(violation('DUPLICATE_OWNED_SIGNAL', id,\n157:               `${skillId}: signal '${signal}' claimed by both '${seenSignals.get(key)}' and '${entry.command}' — routing is ambiguous`));\n158:           } else {\n159:             seenSignals.set(key, entry.command);\n160:           }\n161:         }\n162:       }\n163:     }\n164: \n165:     if ('choreography' in entry) {\n166:       const steps = entry.choreography;\n167:       if (!Array.isArray(steps) || steps.length === 0) {\n168:         violations.push(violation('BAD_CHOREOGRAPHY', id,\n169:           `${skillId}: ${id} choreography must be a non-empty ordered array`));\n170:       } else {\n171:         let lastOrder = -Infinity;\n172:         steps.forEach((step, stepIndex) => {\n173:           if (!step || typeof step !== 'object'\n174:               || !Number.isInteger(step.order)\n175:               || !isNonEmptyString(step.skill)\n176:               || !isNonEmptyString(step.resource)\n177:               || !isNonEmptyString(step.action)) {\n178:             violations.push(violation('BAD_CHOREOGRAPHY_STEP', id,\n179:               `${skillId}: ${id} choreography step ${stepIndex} needs { order, skill, resource, action }`));\n180:             return;\n181:           }\n182:           if (step.order <= lastOrder) {\n183:             violations.push(violation('CHOREOGRAPHY_ORDER', id,\n184:               `${skillId}: ${id} choreography orders must strictly increase (step ${stepIndex})`));\n185:           }\n186:           lastOrder = step.order;\n187:           if (context.resourceExists && !context.resourceExists(step.resource)) {\n188:             violations.push(violation('CHOREOGRAPHY_RESOURCE_MISSING', id,\n189:               `${skillId}: ${id} choreography resource does not resolve on disk: ${step.resource}`));\n190:           }\n191:         });\n192:       }\n193:     }\n194:   });\n195: \n196:   return violations;\n197: }\n198: \n199: /**\n200:  * Map a slash-command id to its expected definition path fragment, e.g.\n201:  * `/create:skill` → `create/skill.md` and `/prompt:improve` → `prompt/improve.md`.\n202:  * Legacy single-segment ids map to `<name>.md`.\n203:  */\n204: function commandDefinitionRelPath(commandId) {\n205:   const body = commandId.replace(/^\\//, '');\n206:   const [family, name] = body.split(':');\n207:   return name ? `${family}/${name}.md` : `${body}.md`;\n208: }\n209: \n210: // ─────────────────────────────────────────────────────────────────────────────\n211: // 4. EXPORTS\n212: // ─────────────────────────────────────────────────────────────────────────────\n213: \n214: module.exports = {\n215:   COMMAND_ID_PATTERN,\n216:   REQUIRED_ENTRY_FIELDS,\n217:   validateCommandMetadata,\n218:   commandDefinitionRelPath,\n219: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/lib/command-metadata-schema.cjs, lines 1-219\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ command-metadata-schema — pure hub command-metadata core contract        ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: /**\n7:  * command-metadata-schema.cjs — pure validator for a hub's command-metadata.json.\n8:  *\n9:  * Every hub carries this file as part of its class contract: an array with one\n10:  * entry per slash command the hub owns, or an empty array when it owns none.\n11:  * The file turns each command's routing identity and load choreography into\n12:  * checkable data — before it, that contract lived only in prose that every\n13:  * reader paraphrased slightly differently, and only one hub's version was\n14:  * validated by anything.\n15:  *\n16:  * This module owns the CORE schema: the hub-agnostic fields every entry must\n17:  * carry. A hub may extend entries with domain-specific fields (the design hub\n18:  * carries register policies and task projections, for example); unknown fields\n19:  * are deliberately legal so richer per-hub validators can layer on top without\n20:  * forking the core. The core checks:\n21:  *\n22:  *   - `command`        slash-command id, `/family:name` (or legacy `/name`)\n23:  *   - `ownerMode`      must name a workflowMode in the hub's mode registry\n24:  *   - `description`    non-empty routing description\n25:  *   - `argumentHint`   invocation grammar as shown to the operator\n26:  *   - `userIntent`     `{ job, ownedSignals[] }` — the routing vocabulary\n27:  *   - `choreography`   ordered resource loads `{ order, skill, resource, action }`\n28:  *\n29:  * Cross-entry rules: command ids unique; owned signals unique across entries\n30:  * (two commands claiming one signal makes routing ambiguous by construction).\n31:  *\n32:  * No filesystem access happens here. The caller supplies the registry's mode\n33:  * list and an existence probe, so resource resolution stays testable and the\n34:  * gate stays the single place that touches disk.\n35:  */\n36: \n37: // ─────────────────────────────────────────────────────────────────────────────\n38: // 1. CONSTANTS\n39: // ─────────────────────────────────────────────────────────────────────────────\n40: \n41: const COMMAND_ID_PATTERN = /^\\/[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)?$/;\n42: \n43: const REQUIRED_ENTRY_FIELDS = Object.freeze([\n44:   'command',\n45:   'ownerMode',\n46:   'description',\n47:   'argumentHint',\n48:   'userIntent',\n49:   'choreography',\n50: ]);\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 2. HELPERS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: function violation(code, command, message) {\n57:   return { code, command, message };\n58: }\n59: \n60: function isNonEmptyString(value) {\n61:   return typeof value === 'string' && value.trim().length > 0;\n62: }\n63: \n64: // ─────────────────────────────────────────────────────────────────────────────\n65: // 3. CORE LOGIC\n66: // ─────────────────────────────────────────────────────────────────────────────\n67: \n68: /**\n69:  * Validate one hub's parsed command-metadata content against the core schema.\n70:  *\n71:  * @param {unknown} entries - parsed JSON content of command-metadata.json.\n72:  * @param {object} context\n73:  * @param {string} context.skillId - hub directory name, for messages.\n74:  * @param {string[]} context.registryModes - workflowMode ids from mode-registry.json.\n75:  * @param {(hubRelativePath: string) => boolean} [context.resourceExists]\n76:  *   - probe for choreography resource paths (repo-root-relative). Omitted in\n77:  *     pure unit tests; when absent, existence checks are skipped.\n78:  * @param {(commandId: string) => boolean} [context.commandExists]\n79:  *   - probe for the command's definition file. Omitted → skipped.\n80:  * @returns {{ code: string, command: string|null, message: string }[]}\n81:  */\n82: function validateCommandMetadata(entries, context) {\n83:   const { skillId, registryModes } = context;\n84:   const violations = [];\n85: \n86:   if (!Array.isArray(entries)) {\n87:     return [violation('COMMAND_METADATA_NOT_ARRAY', null,\n88:       `${skillId}: command-metadata.json must be an array (empty when the hub owns no commands)`)];\n89:   }\n90: \n91:   const modes = new Set(registryModes || []);\n92:   const seenCommands = new Set();\n93:   const seenSignals = new Map();\n94: \n95:   entries.forEach((entry, index) => {\n96:     if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n97:       violations.push(violation('MALFORMED_ENTRY', null, `${skillId}: entry ${index} is not an object`));\n98:       return;\n99:     }\n100:     const id = typeof entry.command === 'string' ? entry.command : `entry ${index}`;\n101: \n102:     for (const field of REQUIRED_ENTRY_FIELDS) {\n103:       if (!(field in entry)) {\n104:         violations.push(violation('MISSING_FIELD', id, `${skillId}: ${id} lacks required field '${field}'`));\n105:       }\n106:     }\n107: \n108:     if ('command' in entry) {\n109:       if (!isNonEmptyString(entry.command) || !COMMAND_ID_PATTERN.test(entry.command)) {\n110:         violations.push(violation('BAD_COMMAND_ID', id,\n111:           `${skillId}: '${entry.command}' is not a /family:name slash-command id`));\n112:       } else if (seenCommands.has(entry.command)) {\n113:         violations.push(violation('DUPLICATE_COMMAND', id, `${skillId}: '${entry.command}' declared twice`));\n114:       } else {\n115:         seenCommands.add(entry.command);\n116:         if (context.commandExists && !context.commandExists(entry.command)) {\n117:           violations.push(violation('COMMAND_FILE_MISSING', id,\n118:             `${skillId}: no command definition found for '${entry.command}' under .skilled/commands/`));\n119:         }\n120:       }\n121:     }\n122: \n123:     if ('ownerMode' in entry && !modes.has(entry.ownerMode)) {\n124:       violations.push(violation('UNKNOWN_OWNER_MODE', id,\n125:         `${skillId}: ownerMode '${entry.ownerMode}' is not a workflowMode in mode-registry.json`));\n126:     }\n127: \n128:     for (const field of ['description', 'argumentHint']) {\n129:       if (field in entry && !isNonEmptyString(entry[field])) {\n130:         violations.push(violation('EMPTY_FIELD', id, `${skillId}: ${id} has an empty '${field}'`));\n131:       }\n132:     }\n133: \n134:     if ('userIntent' in entry) {\n135:       const intent = entry.userIntent;\n136:       if (!intent || typeof intent !== 'object'\n137:           || !isNonEmptyString(intent.job)\n138:           || !Array.isArray(intent.ownedSignals) || intent.ownedSignals.length === 0\n139:           || !intent.ownedSignals.every(isNonEmptyString)) {\n140:         violations.push(violation('BAD_USER_INTENT', id,\n141:           `${skillId}: ${id} userIntent must be { job, ownedSignals[] } with at least one signal`));\n142:       } else {\n143:         const localSignals = new Set();\n144:         for (const signal of intent.ownedSignals) {\n145:           const key = signal.trim().toLowerCase();\n146:           if (localSignals.has(key)) {\n147:             // A command repeating its own signal is dead weight, not routing\n148:             // ambiguity — flag it under its own code so the fix is \"dedup the\n149:             // list\", not \"rename a colliding sibling\".\n150:             violations.push(violation('DUPLICATE_OWNED_SIGNAL_WITHIN_ENTRY', id,\n151:               `${skillId}: ${id} lists signal '${signal}' more than once`));\n152:             continue;\n153:           }\n154:           localSignals.add(key);\n155:           if (seenSignals.has(key) && seenSignals.get(key) !== entry.command) {\n156:             violations.push(violation('DUPLICATE_OWNED_SIGNAL', id,\n157:               `${skillId}: signal '${signal}' claimed by both '${seenSignals.get(key)}' and '${entry.command}' — routing is ambiguous`));\n158:           } else {\n159:             seenSignals.set(key, entry.command);\n160:           }\n161:         }\n162:       }\n163:     }\n164: \n165:     if ('choreography' in entry) {\n166:       const steps = entry.choreography;\n167:       if (!Array.isArray(steps) || steps.length === 0) {\n168:         violations.push(violation('BAD_CHOREOGRAPHY', id,\n169:           `${skillId}: ${id} choreography must be a non-empty ordered array`));\n170:       } else {\n171:         let lastOrder = -Infinity;\n172:         steps.forEach((step, stepIndex) => {\n173:           if (!step || typeof step !== 'object'\n174:               || !Number.isInteger(step.order)\n175:               || !isNonEmptyString(step.skill)\n176:               || !isNonEmptyString(step.resource)\n177:               || !isNonEmptyString(step.action)) {\n178:             violations.push(violation('BAD_CHOREOGRAPHY_STEP', id,\n179:               `${skillId}: ${id} choreography step ${stepIndex} needs { order, skill, resource, action }`));\n180:             return;\n181:           }\n182:           if (step.order <= lastOrder) {\n183:             violations.push(violation('CHOREOGRAPHY_ORDER', id,\n184:               `${skillId}: ${id} choreography orders must strictly increase (step ${stepIndex})`));\n185:           }\n186:           lastOrder = step.order;\n187:           if (context.resourceExists && !context.resourceExists(step.resource)) {\n188:             violations.push(violation('CHOREOGRAPHY_RESOURCE_MISSING', id,\n189:               `${skillId}: ${id} choreography resource does not resolve on disk: ${step.resource}`));\n190:           }\n191:         });\n192:       }\n193:     }\n194:   });\n195: \n196:   return violations;\n197: }\n198: \n199: /**\n200:  * Map a slash-command id to its expected definition path fragment, e.g.\n201:  * `/create:skill` → `create/skill.md` and `/prompt:improve` → `prompt/improve.md`.\n202:  * Legacy single-segment ids map to `<name>.md`.\n203:  */\n204: function commandDefinitionRelPath(commandId) {\n205:   const body = commandId.replace(/^\\//, '');\n206:   const [family, name] = body.split(':');\n207:   return name ? `${family}/${name}.md` : `${body}.md`;\n208: }\n209: \n210: // ─────────────────────────────────────────────────────────────────────────────\n211: // 4. EXPORTS\n212: // ─────────────────────────────────────────────────────────────────────────────\n213: \n214: module.exports = {\n215:   COMMAND_ID_PATTERN,\n216:   REQUIRED_ENTRY_FIELDS,\n217:   validateCommandMetadata,\n218:   commandDefinitionRelPath,\n219: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-skill/scripts/lib/command-metadata-schema.cjs\"}"},"time":{"start":1794582803810,"end":1794582806903}}}}
