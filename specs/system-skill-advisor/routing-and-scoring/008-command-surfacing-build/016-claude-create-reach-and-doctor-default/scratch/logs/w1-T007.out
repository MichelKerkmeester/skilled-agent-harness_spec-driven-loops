ersation-scenarios.md\",\n355:         \"sk-create-manual-testing-playbook/references/examples.md\",\n356:         \"sk-create-manual-testing-playbook/references/prompt-voice.md\",\n357:         \"shared/assets/llmstxt-templates.md\",\n358:         \"shared/references/core-standards.md\",\n359:         \"shared/references/evergreen-packet-id-rule.md\",\n360:         \"shared/references/validation.md\",\n361:         \"sk-create-quality-control/references/README.md\",\n362:         \"sk-create-quality-control/references/optimization.md\",\n363:         \"sk-create-quality-control/references/transformation-patterns.md\",\n364:         \"sk-create-quality-control/references/validation-and-enforcement.md\",\n365:         \"sk-create-quality-control/references/workflow-examples.md\",\n366:         \"sk-create-quality-control/references/workflows.md\",\n367:         \"sk-create-readme/assets/architecture-template.md\",\n368:         \"sk-create-readme/assets/readme-code-template.md\",\n369:         \"sk-create-readme/assets/readme-template.md\",\n370:         \"sk-create-readme/references/README.md\",\n371:         \"sk-create-readme/references/readme/quality-and-checklist.md\",\n372:         \"sk-create-readme/references/readme/types-and-voice.md\",\n373:         \"sk-create-readme/references/readme/writing-patterns.md\",\n374:         \"sk-create-repo-rule/assets/repo-rule-template.md\",\n375:         \"sk-create-repo-rule/assets/repo-rules-router-template.md\",\n376:         \"sk-create-repo-rule/references/README.md\",\n377:         \"sk-create-repo-rule/references/agents-md-integration.md\",\n378:         \"sk-create-repo-rule/references/creation-standards.md\",\n379:         \"sk-create-repo-rule/references/decision-tests.md\",\n380:         \"sk-create-repo-rule/references/rule-anatomy.md\",\n381:         \"sk-create-with-human-voice/assets/voice-report-template.md\",\n382:         \"sk-create-with-human-voice/references/README.md\",\n383:         \"sk-create-with-human-voice/references/hvr-rules.md\",\n384:         \"sk-create-with-human-voice/references/scope-and-exemptions.md\",\n385:         \"sk-create-with-human-voice/references/scoring-and-verification.md\",\n386:         \"sk-create-skill/assets/parent-skill/parent-skill-command-metadata-template.json\",\n387:         \"sk-create-skill/assets/parent-skill/parent-skill-description-template.json\",\n388:         \"sk-create-skill/assets/parent-skill/parent-skill-graph-metadata-template.json\",\n389:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-router-template.json\",\n390:         \"sk-create-skill/assets/parent-skill/parent-skill-hub-template.md\",\n391:         \"sk-create-skill/assets/parent-skill/parent-skill-leaf-aliases-template.json\",\n392:         \"sk-create-skill/assets/parent-skill/parent-skill-readme-template.md\",\n393:         \"sk-create-skill/assets/parent-skill/parent-skill-registry-template.json\",\n394:         \"sk-create-skill/assets/parent-skill/parent-skill-root-router-template.md\",\n395:         \"sk-create-skill/assets/parent-skill/scaffold/hub-skill-scaffold.md\",\n396:         \"sk-create-skill/assets/parent-skill/scaffold/packet-skill-scaffold.md\",\n397:         \"sk-create-skill/assets/skill/skill-asset-template.md\",\n398:         \"sk-create-skill/assets/skill/skill-graph-metadata-template.json\",\n399:         \"sk-create-skill/assets/skill/skill-leaf-manifest-config-template.json\",\n400:         \"sk-create-skill/assets/skill/skill-md-template.md\",\n401:         \"sk-create-skill/assets/skill/skill-procedure-template.md\",\n402:         \"sk-create-skill/assets/skill/skill-readme-template.md\",\n403:         \"sk-create-skill/assets/skill/skill-reference-template.md\",\n404:         \"sk-create-skill/assets/skill/skill-scaffold-template.md\",\n405:         \"sk-create-skill/assets/skill/skill-smart-router.md\",\n406:         \"sk-create-skill/assets/skill/skill-sync-manifest-template.md\",\n407:         \"sk-create-skill/references/README.md\",\n408:         \"sk-create-skill/references/parent-skill/compiled-routing-architecture.md\",\n409:         \"sk-create-skill/references/parent-skill/compiled-routing-lockstep-surfaces.json\",\n410:         \"sk-create-skill/references/parent-skill/parent-hub-router-schema.md\",\n411:         \"sk-create-skill/references/parent-skill/parent-skills-nested-packets.md\",\n412:         \"sk-create-skill/references/shared/advisor-index-handoff.md\",\n413:         \"sk-create-skill/references/shared/common-pitfalls.md\",\n414:         \"sk-create-skill/references/shared/overview.md\",\n415:         \"sk-create-skill/references/shared/skill-root-metadata-contract.md\",\n416:         \"sk-create-skill/references/shared/validation-and-packaging.md\",\n417:         \"sk-create-skill/references/skill/creation-workflow.md\",\n418:         \"sk-create-skill/references/skill/examples-and-maintenance.md\",\n419:         \"sk-create-skill/references/skill/upgrading-a-skill-to-v4.md\"\n420:     ],\n421: }\n422: ```\n423: \n424: ---\n425: \n426: ## 4. HOW TO READ THIS\n427: \n428: - One dominant intent routes to one mode's leaf set.\n429: - Two near-tied intents (within the ambiguity delta) route to both leaf sets; the\n430:   union is deduped by canonical pair.\n431: - No keyword match is UNKNOWN_FALLBACK: confirm the target artifact and intent\n432:   before loading anything.\n433: - `FULL_INVENTORY` fires only on an explicit \"show the whole toolkit\" request.\n434: - A mode whose `mode-registry.json` row names a `command` has two whole entries: read that command's document in full and follow it under the policy the advisor names, or follow this mode's packet. Pick one and keep to it. A mode whose row has `command: null` has only its packet.\n435: \n436: ---\n437: \n438: ## 5. MACHINE ROUTER\n439: \n440: The hub's detailed routing prose, moved here from `SKILL.md` so the skill body keeps only a short routing summary and a pointer to this file. It sits last, after the stage-two map above, and it declares no map of its own: the `INTENT_SIGNALS` and `RESOURCE_MAP` block in section 3 stays the only replay source.\n441: \n442: > **Compiled routing (default-on, flag-gated, additive).** Resolve the mode via the compiled router contract first:\n443: > ```bash\n444: > node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"\n445: > ```\n446: > Follow the returned decision — `route` (use its `targets`), `clarify`/`defer` (disambiguate), `reject` (refuse). On a `{\"servingAuthority\":\"legacy\"}` sentinel or any error, use the routing below. The front door self-gates on serving-authority. Compiled routing is now the default for `sk-doc`; set `SPECKIT_COMPILED_ROUTING=0` to force legacy routing fleet-wide — the explicit kill-switch.\n447: \n448: ### Surface Router — per-intent leaf sets\n449: \n450: Stage 2 of routing lives in section 3 of this file.\n451: It defines three things:\n452: - The per-intent leaf model: document quality, optimization, skill creation, parent-hub creation, agent creation, command creation, the paired agent-plus-command lane, the human-voice pass, playbooks, playbook conversations, feature catalogs, READMEs, changelogs, benchmarks, diffs, frontmatter, packet goals, repo rules, and the explicit full-toolkit intent.\n453: - The machine-readable `INTENT_SIGNALS` / `RESOURCE_MAP` block that the deterministic router-replay and benchmarks parse.\n454: - The how-to-read rules: a dominant intent gives one leaf set, near-tied intents give a deduped union, and no keyword match gives the hub UNKNOWN fallback, never a silent default.\n455: \n456: Every `RESOURCE_MAP` path is packet-qualified or an authored shared-alias disk path, and each converts to the canonical `(workflowMode, leafResourceId)` pair at the one contract boundary.\n457: \n458: The reason this file stays a separate document from `SKILL.md` and from `hub-router.json` is in [the parent-skill reference](sk-create-skill/references/parent-skill/parent-skills-nested-packets.md#why-the-leaf-router-stays-in-routermd).\n459: \n460: ### The discriminator\n461: - **`workflowMode`** — the public packet key (e.g. `sk-create-skill`, `sk-create-quality-control`). `sk-create-skill-parent` is a second mode over the same `sk-create-skill` packet.\n462: - **`packetKind`** — `workflow` for every sk-doc packet (there is no surface axis; the sk-create-quality-control pipeline is universal doctrine in `shared/`, not orthogonal stack-evidence).\n463: - **`backendKind`** — `template-scaffold` for the create-* generators, `sk-create-quality-control` for the sk-create-quality-control mode.\n464: \n465: ### Routing rule\n466: ```\n467: SKILL_ROOT = path containing this ROUTER.md and its SKILL.md\n468: REGISTRY = SKILL_ROOT / \"mode-registry.json\"\n469: HUB_ROUTER = SKILL_ROOT / \"hub-router.json\"\n470: \n471: UNKNOWN_FALLBACK_CHECKLIST = [\n472:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n473:     \"Confirm the target document or component being authored, scaffolded, or reviewed\",\n474:     \"Provide the available inputs: existing doc, source material, or scaffold parameters\",\n475:     \"Confirm the validation expectations before completion (DQI/HVR scoring, validate.sh, or packet-specific checks)\",\n476: ]\n477: \n478: def _guard_in_skill(relative_path):\n479:   resolved = (SKILL_ROOT / relative_path).resolve()\n480:   resolved.relative_to(SKILL_ROOT)\n481:   if resolved.suffix.lower() not in {\".md\", \".json\"}:\n482:     raise ValueError(\"only skill-local markdown/json router resources are routable\")\n483:   return resolved.relative_to(SKILL_ROOT).as_posix()\n484: \n485: def load_if_available(relative_path, seen):\n486:   guarded = _guard_in_skill(relative_path)\n487:   if guarded not in seen and (SKILL_ROOT / guarded).exists():\n488:     load(guarded)\n489:     seen.add(guarded)\n490:     return True\n491:   return False\n492: \n493: seen = set()\n494: if not REGISTRY.exists() or not HUB_ROUTER.exists():\n495:   return defer(\"router metadata missing; inspect sk-doc/mode-registry.json and sk-doc/hub-router.json\")\n496: \n497: read mode-registry.json and hub-router.json\n498: classify the request to one or more workflowMode values using hub-router.json\n499:   (dominant authoring/quality intent; a command like /create:agent resolves directly)\n500: \n501: if confidence is low, intent is contradictory, or routerPolicy.defaultMode is null and no mode wins:\n502:   for resource in hub_router.routerPolicy.defaultResource:   # the ordered defer set, never hardcoded here\n503:     load_if_available(resource, seen)\n504:   return UNKNOWN_FALLBACK with disambiguation_checklist = UNKNOWN_FALLBACK_CHECKLIST\n505: \n506: for each resolved workflowMode:\n507:   entry = the matching mode-registry.json modes[] item\n508:   if entry is missing or entry.packetKind != \"workflow\":\n509:     return defer(\"unknown sk-doc workflowMode; extend mode-registry.json and create a packet first\")\n510:   if not load_if_available(f\"{entry.packet}/SKILL.md\", seen):\n511:     return defer(\"registered packet SKILL.md is missing; repair the packet before routing\")\n512: \n513: return single or orderedBundle according to hub-router.json routerPolicy.outcomes\n514: ```\n515: `routerPolicy.defaultMode` is `null`: an unclear documentation intent asks for disambiguation rather than forcing a stale default. `hub-router.json` carries the router signals, vocabulary classes, default fallback resource, and bundle rules. Outcomes are `single`, `orderedBundle`, or `defer` — there is no `surfaceBundle` (no surface axis).\n516: \n517: Per-packet behavior is **not flattened**: each packet keeps its own authoring contract, references, assets, scripts, and templates.\n518: \n519: This hub does **not** use keyed resource discovery (`references/<key>/` or `assets/<key>/`) at the hub root.\n520: There are no hub-root `references/` or `assets/` directories, and packet resources stay inside their owning packet or the shared backbone.\n521: If a future workflow needs keyed resource subdirectories, add that behavior inside the owning packet using guarded runtime discovery.\n522: Do not hardcode resource inventories in this hub.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/ROUTER.md, lines 1-522\n1: ---\n2: title: sk-doc Surface Router — per-intent leaf sets\n3: description: First-class surface router document at the sk-doc hub root (ROUTER.md). hub-router.json selects the workflow mode; this doc maps a request's documentation/authoring intent to the exact packet-local leaf resources that mode should load, emitting canonical (workflowMode, leafResourceId) pairs. Relocated verbatim from shared/references/smart-routing.md (v1.0.0.0) as the ROUTER.md consolidation pattern.\n4: trigger_phrases:\n5:   - \"sk-doc surface router\"\n6:   - \"doc authoring resource map\"\n7:   - \"packet leaf resource routing\"\n8:   - \"surface router pattern\"\n9: importance_tier: important\n10: contextType: implementation\n11: version: 2.4.6.0\n12: router_state: active\n13: skill_pointer: SKILL.md\n14: ---\n15: \n16: # sk-doc Surface Router — per-intent leaf sets\n17: \n18: The machine router for [`SKILL.md`](./SKILL.md). `SKILL.md` keeps the short routing prose and the link that points here; this file holds the declaration a reader parses to decide what loads.\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: This is sk-doc's second-layer (surface) router, first-class at the hub root as\n25: `ROUTER.md`. The hub selects a workflow mode in [`hub-router.json`](hub-router.json)\n26: (sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command,\n27: sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark,\n28: sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter,\n29: sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control);\n30: this doc maps a request's documentation/authoring intent to the exact packet-local\n31: leaf resources that mode should load. Every path is either packet-qualified\n32: (`<packet>/references|assets/…`) or an authored shared-alias disk path (`shared/…`),\n33: and both convert to the canonical `(workflowMode, leafResourceId)` pair at the\n34: contract boundary (`sk-doc/sk-create-skill/scripts/lib/leaf-resource-contract.cjs`).\n35: `FULL_INVENTORY` is the single explicit full-toolkit intent — no other intent\n36: enumerates the whole hub.\n37: \n38: Routing is two stages: the hub picks the WORKFLOW mode (mode telemetry), this\n39: router picks the LEAVES within it. The two layers stay separate — the hub never\n40: emits leaf paths, and this router never re-decides the mode.\n41: \n42: ---\n43: \n44: ## 2. INTENT MODEL\n45: \n46: - **doc-quality leaves** — the validation rules, core standards, evergreen\n47:   packet-id rule, and the quality-control workflow a request to validate, audit,\n48:   or score documentation against sk-doc standards loads. Fired by \"documentation\n49:   quality / validate documentation / validate a document / score this document /\n50:   DQI / document audit / review the docs / document for clarity / audit the docs /\n51:   pass review\"\n52:   requests. The scoring phrases mirror `hub-router.json`, so a request that\n53:   reaches the quality mode at stage one also reaches its leaves at stage two.\n54: - **optimization leaves** — the optimization reference and the llms.txt templates\n55:   a request to compress, trim, or token-optimize a doc, or emit a machine-readable\n56:   index loads. Fired by \"optimize / token efficiency / llms.txt / reduce tokens /\n57:   slim down\" requests.\n58: - **skill-creation leaves** — the skill creation workflow and the skill.md /\n59:   readme / reference templates a request to scaffold or author a new skill loads.\n60:   Fired by \"create a skill / skill.md scaffold / resource_map wiring / package a\n61:   capability\" requests.\n62: - **parent-hub leaves.** The nested-packet contract, the hub-router schema and\n63:   the four parent-hub templates a request to build or rewire a parent hub loads.\n64:   Fired by \"parent hub / parent skill / mode packet / nested workflow packet /\n65:   mode-registry.json / hub-router.json\" requests, the file names spelled in full\n66:   so a bare \"hub router\" in an unrelated sentence does not fire it. This is the leaf set for the\n67:   `sk-create-skill-parent` mode, which shares the `sk-create-skill` packet but\n68:   not its leaves: a plain skill request must not pull the hub templates.\n69: - **render-ledger leaves.** The validation reference that explains the render\n70:   ledger's debt, exempt and pinned records and the doc rewrite guard, and the\n71:   maintenance workflow that runs the guard before a rewrite is committed. Fired\n72:   by \"doc rewrite guard / render ledger / render-known-debt.json / exempt from\n73:   the render checks / kept every claim\" requests. It belongs to the\n74:   `sk-create-skill` mode, which owns the ledger.\n75: - **agent-creation leaves.** The agent README and agent template a request to\n76:   scaffold an OpenCode agent loads. Fired by \"create an agent / new agent /\n77:   agent frontmatter / permission object / @analyze agent\" requests.\n78: - **command-creation leaves.** The command README and command template a\n79:   request to scaffold a slash command loads. Fired by \"create a command / slash\n80:   command / argument-hint / allowed-tools / thin router\" requests.\n81: - **agent-command leaves.** Both packets' READMEs and templates a request to\n82:   author an agent together with its paired `/create` command loads. Fired only\n83:   by the two paired phrases, \"agent and paired\" and \"paired /create\", which no\n84:   single-artifact request carries. The paired intent stays separate rather than\n85:   being expressed as the union of the two above, because the router keeps only\n86:   intents within one point of the top score: a paired request that also names\n87:   the agent would otherwise drop the command half.\n88: - **diagram and chart leaves belong to the `sk-design` hub.** ASCII flowchart,\n89:   decision-tree and standalone HTML chart authoring is `sk-design-diagram` and\n90:   `sk-design-chart` work, and this router declares no intent for it: `/design:diagram`\n91:   and `/design:chart` are the entry points, so \"flowchart\", \"ascii\", \"process diagram\",\n92:   \"create a chart\" and \"plot the data\" reach no key in the two maps below.\n93: - **human-voice leaves** — the scope gate, the scoring method and the Human\n94:   Voice Rules standard a request to apply or score that standard loads. Fired\n95:   by \"hvr / human voice rules / apply human voice / rewrite in human voice /\n96:   make this sound human / sounds ai-generated / remove ai tells\" requests. The\n97:   scope gate is the always-loaded leaf, because deciding what a voice edit may\n98:   touch comes before deciding what to change.\n99: - **playbook leaves** — the manual-testing-playbook README a request to author a\n100:   manual testing playbook loads. Fired by \"playbook system / manual testing\n101:   playbook / testing playbook / playbook scenario / manual test\n102:   scenario\" requests.\n103: - **playbook-conversation leaves** — the conversation-scenario reference and the\n104:   conversation snippet template a request to write a multi-turn json conversation script for\n105:   a playbook scenario loads. Fired by \"playbook conversation / multi-turn\n106:   conversation script / json conversation / conversation runner\" requests. This\n107:   intent scores double. \"manual testing playbook\" also matches \"testing\n108:   playbook\", so that one phrase scores the playbook intent twice, and at equal\n109:   weight a request naming both a playbook and a conversation would load only the\n110:   playbook README. At double weight the two tie and both leaf sets load.\n111: - **feature-catalog leaves** — the feature-catalog README a request to inventory a\n112:   project's features / capabilities loads. Fired by \"feature catalog / feature\n113:   inventory / capabilities\" requests.\n114: - **readme-creation leaves** — the readme README and readme template a request to\n115:   author a project README / front-page overview loads. Fired by \"create a readme /\n116:   readme for / project overview / landing doc\" requests.\n117: - **changelog leaves** — the changelog template a request to author release notes\n118:   / version notes loads. Fired by \"changelog / release notes / what shipped /\n119:   since the last version\" requests.\n120: - **benchmark leaves** — the benchmark shared README, worked example, and report\n121:   template a request to author a behavior benchmark\n122:   loads. Fired by \"create a benchmark / benchmark suite / behavior benchmark\"\n123:   requests.\n124: - **diff leaves** — the diff README, workflow, and worked example a request to\n125:   produce a before/after document diff loads. Fired by \"document diff / before\n126:   and after diff / visual document diff\" requests.\n127: - **repo-rule leaves** — the four decision tests, the rule anatomy contract, the\n128:   creation standards, the wiring contract, the rule and router templates, and the\n129:   packet reference map a\n130:   request to add, change, or remove a repo-local rule loads. Fired by \"repo rule /\n131:   project rule / REPO RULES.md / trigger table / retire a repo rule\" requests. Most such\n132:   requests end in a refusal, so `decision-tests.md` is the always-loaded leaf.\n133: - **frontmatter leaves** — the field reference and the versioning standard a\n134:   request about a frontmatter block itself loads. Fired by \"yaml frontmatter /\n135:   frontmatter block / frontmatter field / description budget / 4-part version /\n136:   frontmatter versioning\" requests. The phrases are qualified rather than bare,\n137:   because `agent frontmatter` belongs to agent-creation and a bare \"frontmatter\"\n138:   would take that route away from it. The field reference is the always-loaded\n139:   leaf, because resolving the document class comes before any field rule.\n140: - **goal-authoring leaves** — the goal authoring standards, the goal exemplars,\n141:   the parent/nested goal workflows and the budget/handoff reference a request to\n142:   author or revise a packet's `goal.md` loads. Fired by \"packet goal / goal.md /\n143:   goal document / author goal.md / phase parent goal / goal criteria /\n144:   completion checks\" requests. The phrases are qualified rather than bare,\n145:   because a bare \"goal\" and the session verbs belong to session-goal management\n146:   (set, bind, update, resend), which the goal hooks and host commands own. The\n147:   authoring standards are the always-loaded leaf, because what a goal must state\n148:   comes before how one is phrased.\n149: - **full-inventory leaves** — the entire sk-doc toolkit. `FULL_INVENTORY` is the\n150:   single explicit full-toolkit intent; no other intent enumerates the whole hub.\n151:   Fired only by an explicit \"show the full sk-doc toolkit / everything sk-doc\n152:   offers\" request.\n153: \n154: A single dominant documentation axis routes to one mode's leaf set; two clearly\n155: separate axes route to both.\n156: \n157: ---\n158: \n159: ## 3. MACHINE-READABLE ROUTER (replay / benchmark source)\n160: \n161: The single machine-readable projection of the intent model above. The prose is the\n162: human-facing contract; this block is the byte-for-byte source the deterministic\n163: router-replay parses. Keep them in sync: when a map row changes above, update the\n164: matching `RESOURCE_MAP` entry here. Every `RESOURCE_MAP` path resolves on disk and\n165: dual-reads to a canonical typed pair through `leaf-manifest.json` or the hub's\n166: `leaf-aliases.json`.\n167: \n168: ```python\n169: INTENT_SIGNALS = {\n170:     \"DOC_QUALITY\": {\"weight\": 4, \"keywords\": [\"documentation quality\", \"doc quality\", \"validate documentation\", \"validate a document\", \"validate this document\", \"validate markdown\", \"validation rules\", \"score this document\", \"score this doc\", \"dqi\", \"document audit\", \"fail sk-doc standards\", \"review the docs\", \"review the documentation\", \"document for clarity\", \"check the docs\", \"check the documentation\", \"audit the docs\", \"documentation review bar\", \"quality bar\", \"flag\", \"meet our standards\", \"audit documentation quality\", \"ai-friendly documentation\", \"extract structure\", \"validate\", \"score\", \"harden\", \"audit\", \"/doc:quality\"]},\n171:     \"OPTIMIZATION\": {\"weight\": 4, \"keywords\": [\"optimize\", \"token efficiency\", \"llms.txt\", \"llmstxt\", \"reduce tokens\", \"fewer tokens\", \"trim\", \"compress the doc\", \"slim down\", \"model's budget\", \"machine-readable index\", \"optimize this doc\"]},\n172:     \"SKILL_CREATION\": {\"weight\": 4, \"keywords\": [\"sk-skill\", \"create a new sk\", \"create sk-\", \"skill.md scaffold\", \"skill.md and starter\", \"resource_map wiring\", \"new skill\", \"create a skill\", \"build a skill\", \"author a skill\", \"scaffold a skill\", \"reusable capability\", \"reusable helper\", \"starter reference docs\", \"new capability\", \"capability module\", \"package a capability\", \"create skill\", \"skill scaffold\", \"opencode skill\", \"package skill\", \"which json files does a skill need\", \"skill root metadata contract\", \"leaf-manifest config aliases required\", \"/create:skill\"]},\n173:     \"PARENT_HUB\": {\"weight\": 4, \"keywords\": [\"parent hub\", \"parent skill\", \"mode packet\", \"mode packets\", \"nested packet\", \"nested workflow packet\", \"mode-registry.json\", \"hub-router.json\", \"hub versus standalone skill class\", \"skill hub\", \"/create:skill-parent\"]},\n174:     \"RENDER_LEDGER\": {\"weight\": 4, \"keywords\": [\"doc rewrite guard\", \"doc-rewrite-guard.py\", \"rewrite guard\", \"render ledger\", \"render-known-debt.json\", \"exempt from the render checks\", \"render exempt map\", \"kept every claim\", \"kept every original claim\"]},\n175:     \"AGENT_CREATION\": {\"weight\": 4, \"keywords\": [\"create an agent\", \"create agent\", \"new agent\", \"author an agent\", \"scaffold an agent\", \"agent file\", \"agent persona\", \"agent frontmatter\", \"agent template\", \"permission object\", \"authority boundary\", \"@analyze agent\", \"opencode agent\", \"claude code agent\", \"/create:agent\"]},\n176:     \"COMMAND_CREATION\": {\"weight\": 4, \"keywords\": [\"create a command\", \"create command\", \"slash command\", \"new slash command\", \"author a command\", \"scaffold a command\", \"argument-hint\", \"allowed-tools\", \"command template\", \"router presentation split\", \"thin router\", \"presentation contract\", \"opencode command\", \"$arguments\", \"/create:command\"]},\n177:     \"AGENT_COMMAND\": {\"weight\": 4, \"keywords\": [\"agent and paired\", \"paired /create\"]},\n178:     \"HVR\": {\"weight\": 4, \"keywords\": [\"hvr\", \"human voice rules\", \"apply human voice\", \"rewrite in human voice\", \"make this sound human\", \"sounds ai-generated\", \"reads like ai wrote it\", \"reads like a machine wrote it\", \"remove ai tells\", \"ai writing tells\", \"voice pass\", \"de-ai the writing\", \"banned word check\", \"human voice\"]},\n179:     \"PLAYBOOK\": {\"weight\": 4, \"keywords\": [\"playbook system\", \"manual testing playbook\", \"testing playbook\", \"deterministic scenario\", \"evidence collection\", \"operator validation\", \"multi-agent execution\", \"release readiness\", \"playbook scenario\", \"manual test scenario\", \"/create:manual-testing-playbook\"]},\n180:     \"PLAYBOOK_CONVERSATION\": {\"weight\": 8, \"keywords\": [\"playbook conversation\", \"multi-turn conversation script\", \"json conversation\", \"conversation runner\", \"run-conversation-scenario\"]},\n181:     \"FEATURE_CATALOG\": {\"weight\": 4, \"keywords\": [\"feature catalog\", \"feature inventory\", \"catalog of features\", \"features overview\", \"capabilities\", \"catalog package\", \"per-feature files\", \"source anchors\", \"root catalog\", \"capability inventory\", \"/create:feature-catalog\"]},\n182:     \"README_CREATION\": {\"weight\": 4, \"keywords\": [\"create a readme\", \"readme for\", \"a readme\", \"front-page overview\", \"project overview\", \"getting started doc\", \"intro doc\", \"overview doc\", \"landing doc\", \"create readme\", \"readme\", \"folder readme\", \"write readme\", \"readme.md\", \"code folder readme\", \"/create:readme\"]},\n183:     \"CHANGELOG\": {\"weight\": 4, \"keywords\": [\"changelog\", \"release notes\", \"version notes\", \"release summary\", \"what shipped\", \"since the last version\", \"changelog entry\", \"nested changelog\", \"packet changelog\", \"packet-local changelog\", \"create changelog\", \"global changelog\", \"vx.y.z.b\", \"/create:changelog\"]},\n184:     \"BENCHMARK\": {\"weight\": 4, \"keywords\": [\"create a benchmark\", \"author a benchmark\", \"benchmark suite\", \"benchmark authoring\", \"behavior benchmark\", \"benchmark-report.md\", \"source.md\", \"mcp-server/benchmarks\", \"behavior-benchmark.md\", \"scenario contract\", \"claude-baseline\", \"benchmark/readme.md\", \"run-label folder\", \"benchmark package\", \"benchmark fixture\", \"benchmark profile\", \"reviewer-prompt fixture\", \"agent quality dimensions\", \"new benchmark\", \"promote benchmark folder\", \"create benchmark\", \"behavior_benchmark\"]},\n185: 