reusable capability\\\", \\\"reusable helper\\\", \\\"starter reference docs\\\", \\\"package skill\\\", \\\"doc rewrite guard\\\", \\\"doc-rewrite-guard.py\\\", \\\"render ledger\\\", \\\"render-known-debt.json\\\", \\\"exempt from the render checks\\\", \\\"render exempt map\\\", \\\"kept every claim\\\", \\\"kept every original claim\\\"]},\", \"newString\": \"    \\\"SKILL_PACKAGE\\\": {\\\"weight\\\": 4, \\\"keywords\\\": [\\\"create skill\\\", \\\"/create:sk-skill\\\", \\\"new skill\\\", \\\"skill scaffold\\\", \\\"skill.md scaffold\\\", \\\"opencode skill\\\", \\\"sk-skill\\\", \\\"create sk-\\\", \\\"reusable capability\\\", \\\"reusable helper\\\", \\\"starter reference docs\\\", \\\"package skill\\\", \\\"doc rewrite guard\\\", \\\"doc-rewrite-guard.py\\\", \\\"render ledger\\\", \\\"render-known-debt.json\\\", \\\"exempt from the render checks\\\", \\\"render exempt map\\\", \\\"kept every claim\\\", \\\"kept every original claim\\\"]},\"}"},"time":{"start":1794582854572,"end":1794582857960}}}}
