{"type":"tool_use","timestamp":1794586681277,"sessionID":"ses_e2a4c9ad2ffeB3X8hiSYrNrhpV","part":{"partID":"prt_1d5b39c5c001h1Hswj3N6VaXrP","sessionID":"ses_e2a4c9ad2ffeB3X8hiSYrNrhpV","messageID":"msg_1d5b387d0001RLQOSmnfuL8yVz","type":"tool","id":"call_f7871f366c3d4d2b9b25c567","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-314\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44: ];\n45: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n46: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n47: \n48: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n49: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n50: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n51: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n52: \n53: const WORKFLOW_ASSET = 'doctor-install.yaml';\n54: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n55: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n56: \n57: const CHECKLIST_STEPS = [\n58:   {\n59:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n60:     owner: '/doctor:symlink',\n61:     target: 'link',\n62:     mutating: 'mutates',\n63:   },\n64:   {\n65:     command: '/doctor:agents-md embed --root <dir>',\n66:     owner: '/doctor:agents-md',\n67:     target: 'embed',\n68:     mutating: 'mutates',\n69:   },\n70:   {\n71:     command: '/doctor:mcp install',\n72:     owner: '/doctor:mcp',\n73:     target: 'install',\n74:     mutating: 'mutates',\n75:   },\n76:   {\n77:     command: '/doctor:git setup',\n78:     owner: '/doctor:git',\n79:     target: 'setup',\n80:     mutating: 'read-only',\n81:   },\n82:   {\n83:     command: '/doctor:skill-advisor embedder',\n84:     owner: '/doctor:skill-advisor',\n85:     target: 'embedder',\n86:     mutating: 'mutates',\n87:   },\n88:   {\n89:     command: '/doctor:setup',\n90:     owner: '/doctor:setup',\n91:     target: 'setup',\n92:     mutating: 'read-only',\n93:   },\n94: ];\n95: \n96: function checklistOwner(step) {\n97:   if (step.owner === '/doctor:mcp') {\n98:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n99:   }\n100:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n101: }\n102: \n103: // ─────────────────────────────────────────────────────────────────────────────\n104: // 2. THE ROUTE\n105: // ─────────────────────────────────────────────────────────────────────────────\n106: \n107: test('the manifest holds one read-only install route matching the frozen contract', () => {\n108:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n109:   const route = installRoute();\n110:   assert.equal(route.target, 'guide');\n111:   assert.equal(route.mutating, 'read-only');\n112:   assert.match(route.gate3_location, /^n\\/a/);\n113:   assert.equal(route.default_target, undefined);\n114:   assert.equal(route.yaml, WORKFLOW_ASSET);\n115:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n116:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n117:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n118:   assert.deepEqual(route.mcp_tools, []);\n119: });\n120: \n121: test('the install route phrases and declared commands agree with the workflow contract', () => {\n122:   for (const phrase of installRoute().trigger_phrases) {\n123:     assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n124:     assert.ok(INSTALL_PHRASES.includes(phrase), phrase);\n125:   }\n126: \n127:   assert.equal(installRoute().script_invocations.length, 3);\n128:   for (const invocation of installRoute().script_invocations) {\n129:     const command = invocation.split('#')[0].trim();\n130:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n131:   }\n132: });\n133: \n134: test('the printed checklist names each route owner with its mutation class and reason', () => {\n135:   for (const [index, step] of CHECKLIST_STEPS.entries()) {\n136:     const owner = checklistOwner(step);\n137:     assert.ok(owner, `${step.owner} ${step.target} has no manifest entry`);\n138:     assert.equal(owner.mutating, step.mutating, step.command);\n139:     assert.ok(WORKFLOW_TEXT.includes(step.command), step.command);\n140: \n141:     const numbered = `${index + 1}) ${step.command}`;\n142:     assert.ok(PRESENTATION.includes(numbered), numbered);\n143:     assert.ok(WORKFLOW_TEXT.includes(numbered), numbered);\n144: \n145:     const lineIndex = PRESENTATION.indexOf(step.command);\n146:     assert.notEqual(lineIndex, -1, step.command);\n147:     const commandLineEnd = PRESENTATION.indexOf('\\n', lineIndex);\n148:     const whyLineEnd = PRESENTATION.indexOf('\\n', commandLineEnd + 1);\n149:     const commandLine = PRESENTATION.slice(lineIndex, commandLineEnd);\n150:     const whyLine = PRESENTATION.slice(commandLineEnd + 1, whyLineEnd);\n151:     assert.match(commandLine, /\\[class\\]$/);\n152:     assert.match(whyLine, /^\\s+Why: .+/);\n153:   }\n154: });\n155: \n156: // ─────────────────────────────────────────────────────────────────────────────\n157: // 3. ROUTER AND PRESENTATION\n158: // ─────────────────────────────────────────────────────────────────────────────\n159: \n160: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n161:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n162:   assert.deepEqual(headings, [\n163:     'ROUTER CONTRACT',\n164:     'OWNED ASSETS',\n165:     'MODE ROUTING',\n166:     'EXECUTION TARGETS',\n167:     'PRESENTATION BOUNDARY',\n168:     'WORKFLOW SUMMARY',\n169:   ]);\n170:   assert.doesNotMatch(ROUTER, /```/);\n171:   assert.doesNotMatch(ROUTER, /STATUS=/);\n172: });\n173: \n174: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n175:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n176:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n177:   assert.doesNotMatch(description, /[<>]/);\n178:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n179:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n180:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n181:   assert.deepEqual(tools, ['Read', 'Bash']);\n182:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n183: });\n184: \n185: test('the router binds its guide target to the workflow asset named by the route', () => {\n186:   const targetRow = `| \\`guide\\` | \\`.skilled/commands/doctor/assets/${WORKFLOW_ASSET}\\` |`;\n187:   assert.ok(ROUTER.includes(targetRow), targetRow);\n188: });\n189: \n190: test('the router keeps shortcuts and flag handling within the frozen interface', () => {\n191:   assert.match(ROUTER, /`list`, `\\?` and `menu` as the whole argument/);\n192:   assert.match(ROUTER, /A second positional token is an argument failure/);\n193:   for (const flag of installRoute().allowed_flags) {\n194:     assert.ok(ROUTER.includes(flag), flag);\n195:   }\n196: });\n197: \n198: test('the presentation carries install errors, the build checks, prompt, inspection and ordered steps', () => {\n199:   for (const heading of [\n200:     '## 1. Argument Failure',\n201:     '## 2. The Build Check',\n202:     '## 3. The Install Prompt',\n203:     '## 4. Accepted Answers',\n204:     '## 5. The Symlink Check',\n205:     '## 6. The Ordered Steps',\n206:     '## 7. The Caveat Line',\n207:     '## 8. Result Templates',\n208:   ]) {\n209:     assert.ok(PRESENTATION.includes(heading), heading);\n210:   }\n211:   assert.ok(PRESENTATION.includes('`STATUS=FAIL ERROR=\"unknown_argument\"`'));\n212:   assert.match(PRESENTATION, /^STATUS=OK STEPS=\\[n\\]$/m);\n213:   assert.match(PRESENTATION, /^1\\) Target repo:/m);\n214:   assert.match(PRESENTATION, /^2\\) Runtimes:/m);\n215:   assert.match(PRESENTATION, /^3\\) Link shape:/m);\n216:   assert.match(PRESENTATION, /^4\\) Instruction file:/m);\n217:   assert.match(PRESENTATION, /DOCTOR INSTALL — BUILDS/);\n218:   assert.match(PRESENTATION, /DOCTOR INSTALL — WHAT IS ALREADY THERE/);\n219: \n220:   const workflowSteps = WORKFLOW.execution.steps.map((step) => step.match(/^([A-Za-z]+):/)[1]);\n221:   assert.deepEqual(workflowSteps, WORKFLOW_STEP_NAMES);\n222: });\n223: \n224: test('the presentation prints writing commands for the operator and closes on the family convention', () => {\n225:   assert.match(PRESENTATION, /A printed step is handed back, never run/);\n226:   assert.match(PRESENTATION, /the operator runs it/);\n227:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[message\\]\"$/m);\n228:   assert.ok(PRESENTATION.includes('End interactive presentations with: `What would you like to do next?`'));\n229: \n230:   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n231: });\n232: \n233: test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n234:   assert.doesNotMatch(PRESENTATION, /outside the seven/);\n235:   assert.ok(PRESENTATION.includes('outside claude, opencode, codex, cursor, devin and pi or the ones already there'));\n236:   assert.ok(PRESENTATION.includes('DSH is not offered, because the link manifest has no DSH row.'));\n237:   assert.match(WORKFLOW.inputs.runtimes, /DSH is not offered/);\n238: });\n239: \n240: // ─────────────────────────────────────────────────────────────────────────────\n241: // 4. THE READ-ONLY WORKFLOW\n242: // ─────────────────────────────────────────────────────────────────────────────\n243: \n244: test('the workflow is read-only, grants no write target and runs the route scripts', () => {\n245:   assert.equal(WORKFLOW.operating_mode.execution, 'read_only');\n246:   assert.equal(WORKFLOW.mutation_boundaries.read_only, true);\n247:   assert.deepEqual(WORKFLOW.mutation_boundaries.allowed_targets, []);\n248:   assert.ok(WORKFLOW_TEXT.includes(ENGINE), ENGINE);\n249: \n250:   for (const invocation of installRoute().script_invocations) {\n251:     const command = invocation.split('#')[0].trim();\n252:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n253:   }\n254: });\n255: \n256: test('the workflow declares every variable its route resolves', () => {\n257:   for (const key of installRoute().setup_vars) {\n258:     assert.ok(key in WORKFLOW.inputs, `inputs.${key} is missing`);\n259:   }\n260: });\n261: \n262: test('the workflow asks once, inspects once and hands all writing steps back', () => {\n263:   const steps = WORKFLOW.execution.steps;\n264:   assert.match(steps[1], /ask once/i);\n265:   assert.match(steps[2], /symlink-engine\\.cjs check/);\n266:   assert.equal((steps[2].match(/symlink-engine\\.cjs check/g) || []).length, 1);\n267:   assert.match(steps[3], /Print these ordered writing steps/);\n268:   assert.match(steps[3], /never run them/);\n269:   assert.match(steps[4], /fixed caveat/);\n270: });\n271: \n272: // ─────────────────────────────────────────────────────────────────────────────\n273: // 5. THE COMMAND CONTRACT\n274: // ─────────────────────────────────────────────────────────────────────────────\n275: \n276: test('the doctor contract carries every field its schema requires and nothing it forbids', () => {\n277:   for (const key of FAMILY_SCHEMA.required) {\n278:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n279:   }\n280:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n281:   assert.deepEqual(\n282:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n283:     [],\n284:     'the schema forbids an additional property',\n285:   );\n286: });\n287: \n288: test('the contract names the install router, workflow, presentation and hint', () => {\n289:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n290:   const presentationPath = `.skilled/commands/doctor/assets/${PRESENTATION_ASSET}`;\n291:   const ownsPresentation = DOCTOR_CONTRACT.owned_assets.some((entry) => (\n292:     entry.purpose === 'presentation'\n293:     && entry.path.replace('doctor-<entry>-presentation.txt', PRESENTATION_ASSET) === presentationPath\n294:   ));\n295: \n296:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/install.md'));\n297:   assert.ok(DOCTOR_CONTRACT.execution_targets\n298:     .some((entry) => entry.target.endsWith(WORKFLOW_ASSET)), WORKFLOW_ASSET);\n299:   assert.ok(ownsPresentation, presentationPath);\n300:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (install)`));\n301: });\n302: \n303: test('the contract publishes the install invocation alias', () => {\n304:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n305:   const alias = `/doctor:install ${hint.replace(/ \\| list \\| \\?$/, '')}`;\n306:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(alias), alias);\n307: });\n308: \n309: test('the contract describes the install loader behavior', () => {\n310:   assert.ok(\n311:     DOCTOR_CONTRACT.loader_requirements.some((line) => line.includes('/doctor:install')),\n312:     '/doctor:install is missing from loader_requirements',\n313:   );\n314: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-314\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44: ];\n45: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n46: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n47: \n48: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n49: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n50: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n51: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n52: \n53: const WORKFLOW_ASSET = 'doctor-install.yaml';\n54: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n55: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n56: \n57: const CHECKLIST_STEPS = [\n58:   {\n59:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n60:     owner: '/doctor:symlink',\n61:     target: 'link',\n62:     mutating: 'mutates',\n63:   },\n64:   {\n65:     command: '/doctor:agents-md embed --root <dir>',\n66:     owner: '/doctor:agents-md',\n67:     target: 'embed',\n68:     mutating: 'mutates',\n69:   },\n70:   {\n71:     command: '/doctor:mcp install',\n72:     owner: '/doctor:mcp',\n73:     target: 'install',\n74:     mutating: 'mutates',\n75:   },\n76:   {\n77:     command: '/doctor:git setup',\n78:     owner: '/doctor:git',\n79:     target: 'setup',\n80:     mutating: 'read-only',\n81:   },\n82:   {\n83:     command: '/doctor:skill-advisor embedder',\n84:     owner: '/doctor:skill-advisor',\n85:     target: 'embedder',\n86:     mutating: 'mutates',\n87:   },\n88:   {\n89:     command: '/doctor:setup',\n90:     owner: '/doctor:setup',\n91:     target: 'setup',\n92:     mutating: 'read-only',\n93:   },\n94: ];\n95: \n96: function checklistOwner(step) {\n97:   if (step.owner === '/doctor:mcp') {\n98:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n99:   }\n100:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n101: }\n102: \n103: // ─────────────────────────────────────────────────────────────────────────────\n104: // 2. THE ROUTE\n105: // ─────────────────────────────────────────────────────────────────────────────\n106: \n107: test('the manifest holds one read-only install route matching the frozen contract', () => {\n108:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n109:   const route = installRoute();\n110:   assert.equal(route.target, 'guide');\n111:   assert.equal(route.mutating, 'read-only');\n112:   assert.match(route.gate3_location, /^n\\/a/);\n113:   assert.equal(route.default_target, undefined);\n114:   assert.equal(route.yaml, WORKFLOW_ASSET);\n115:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n116:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n117:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n118:   assert.deepEqual(route.mcp_tools, []);\n119: });\n120: \n121: test('the install route phrases and declared commands agree with the workflow contract', () => {\n122:   for (const phrase of installRoute().trigger_phrases) {\n123:     assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n124:     assert.ok(INSTALL_PHRASES.includes(phrase), phrase);\n125:   }\n126: \n127:   assert.equal(installRoute().script_invocations.length, 3);\n128:   for (const invocation of installRoute().script_invocations) {\n129:     const command = invocation.split('#')[0].trim();\n130:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n131:   }\n132: });\n133: \n134: test('the printed checklist names each route owner with its mutation class and reason', () => {\n135:   for (const [index, step] of CHECKLIST_STEPS.entries()) {\n136:     const owner = checklistOwner(step);\n137:     assert.ok(owner, `${step.owner} ${step.target} has no manifest entry`);\n138:     assert.equal(owner.mutating, step.mutating, step.command);\n139:     assert.ok(WORKFLOW_TEXT.includes(step.command), step.command);\n140: \n141:     const numbered = `${index + 1}) ${step.command}`;\n142:     assert.ok(PRESENTATION.includes(numbered), numbered);\n143:     assert.ok(WORKFLOW_TEXT.includes(numbered), numbered);\n144: \n145:     const lineIndex = PRESENTATION.indexOf(step.command);\n146:     assert.notEqual(lineIndex, -1, step.command);\n147:     const commandLineEnd = PRESENTATION.indexOf('\\n', lineIndex);\n148:     const whyLineEnd = PRESENTATION.indexOf('\\n', commandLineEnd + 1);\n149:     const commandLine = PRESENTATION.slice(lineIndex, commandLineEnd);\n150:     const whyLine = PRESENTATION.slice(commandLineEnd + 1, whyLineEnd);\n151:     assert.match(commandLine, /\\[class\\]$/);\n152:     assert.match(whyLine, /^\\s+Why: .+/);\n153:   }\n154: });\n155: \n156: // ─────────────────────────────────────────────────────────────────────────────\n157: // 3. ROUTER AND PRESENTATION\n158: // ─────────────────────────────────────────────────────────────────────────────\n159: \n160: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n161:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n162:   assert.deepEqual(headings, [\n163:     'ROUTER CONTRACT',\n164:     'OWNED ASSETS',\n165:     'MODE ROUTING',\n166:     'EXECUTION TARGETS',\n167:     'PRESENTATION BOUNDARY',\n168:     'WORKFLOW SUMMARY',\n169:   ]);\n170:   assert.doesNotMatch(ROUTER, /```/);\n171:   assert.doesNotMatch(ROUTER, /STATUS=/);\n172: });\n173: \n174: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n175:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n176:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n177:   assert.doesNotMatch(description, /[<>]/);\n178:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n179:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n180:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n181:   assert.deepEqual(tools, ['Read', 'Bash']);\n182:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n183: });\n184: \n185: test('the router binds its guide target to the workflow asset named by the route', () => {\n186:   const targetRow = `| \\`guide\\` | \\`.skilled/commands/doctor/assets/${WORKFLOW_ASSET}\\` |`;\n187:   assert.ok(ROUTER.includes(targetRow), targetRow);\n188: });\n189: \n190: test('the router keeps shortcuts and flag handling within the frozen interface', () => {\n191:   assert.match(ROUTER, /`list`, `\\?` and `menu` as the whole argument/);\n192:   assert.match(ROUTER, /A second positional token is an argument failure/);\n193:   for (const flag of installRoute().allowed_flags) {\n194:     assert.ok(ROUTER.includes(flag), flag);\n195:   }\n196: });\n197: \n198: test('the presentation carries install errors, the build checks, prompt, inspection and ordered steps', () => {\n199:   for (const heading of [\n200:     '## 1. Argument Failure',\n201:     '## 2. The Build Check',\n202:     '## 3. The Install Prompt',\n203:     '## 4. Accepted Answers',\n204:     '## 5. The Symlink Check',\n205:     '## 6. The Ordered Steps',\n206:     '## 7. The Caveat Line',\n207:     '## 8. Result Templates',\n208:   ]) {\n209:     assert.ok(PRESENTATION.includes(heading), heading);\n210:   }\n211:   assert.ok(PRESENTATION.includes('`STATUS=FAIL ERROR=\"unknown_argument\"`'));\n212:   assert.match(PRESENTATION, /^STATUS=OK STEPS=\\[n\\]$/m);\n213:   assert.match(PRESENTATION, /^1\\) Target repo:/m);\n214:   assert.match(PRESENTATION, /^2\\) Runtimes:/m);\n215:   assert.match(PRESENTATION, /^3\\) Link shape:/m);\n216:   assert.match(PRESENTATION, /^4\\) Instruction file:/m);\n217:   assert.match(PRESENTATION, /DOCTOR INSTALL — BUILDS/);\n218:   assert.match(PRESENTATION, /DOCTOR INSTALL — WHAT IS ALREADY THERE/);\n219: \n220:   const workflowSteps = WORKFLOW.execution.steps.map((step) => step.match(/^([A-Za-z]+):/)[1]);\n221:   assert.deepEqual(workflowSteps, WORKFLOW_STEP_NAMES);\n222: });\n223: \n224: test('the presentation prints writing commands for the operator and closes on the family convention', () => {\n225:   assert.match(PRESENTATION, /A printed step is handed back, never run/);\n226:   assert.match(PRESENTATION, /the operator runs it/);\n227:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[message\\]\"$/m);\n228:   assert.ok(PRESENTATION.includes('End interactive presentations with: `What would you like to do next?`'));\n229: \n230:   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n231: });\n232: \n233: test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n234:   assert.doesNotMatch(PRESENTATION, /outside the seven/);\n235:   assert.ok(PRESENTATION.includes('outside claude, opencode, codex, cursor, devin and pi or the ones already there'));\n236:   assert.ok(PRESENTATION.includes('DSH is not offered, because the link manifest has no DSH row.'));\n237:   assert.match(WORKFLOW.inputs.runtimes, /DSH is not offered/);\n238: });\n239: \n240: // ─────────────────────────────────────────────────────────────────────────────\n241: // 4. THE READ-ONLY WORKFLOW\n242: // ─────────────────────────────────────────────────────────────────────────────\n243: \n244: test('the workflow is read-only, grants no write target and runs the route scripts', () => {\n245:   assert.equal(WORKFLOW.operating_mode.execution, 'read_only');\n246:   assert.equal(WORKFLOW.mutation_boundaries.read_only, true);\n247:   assert.deepEqual(WORKFLOW.mutation_boundaries.allowed_targets, []);\n248:   assert.ok(WORKFLOW_TEXT.includes(ENGINE), ENGINE);\n249: \n250:   for (const invocation of installRoute().script_invocations) {\n251:     const command = invocation.split('#')[0].trim();\n252:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n253:   }\n254: });\n255: \n256: test('the workflow declares every variable its route resolves', () => {\n257:   for (const key of installRoute().setup_vars) {\n258:     assert.ok(key in WORKFLOW.inputs, `inputs.${key} is missing`);\n259:   }\n260: });\n261: \n262: test('the workflow asks once, inspects once and hands all writing steps back', () => {\n263:   const steps = WORKFLOW.execution.steps;\n264:   assert.match(steps[1], /ask once/i);\n265:   assert.match(steps[2], /symlink-engine\\.cjs check/);\n266:   assert.equal((steps[2].match(/symlink-engine\\.cjs check/g) || []).length, 1);\n267:   assert.match(steps[3], /Print these ordered writing steps/);\n268:   assert.match(steps[3], /never run them/);\n269:   assert.match(steps[4], /fixed caveat/);\n270: });\n271: \n272: // ─────────────────────────────────────────────────────────────────────────────\n273: // 5. THE COMMAND CONTRACT\n274: // ─────────────────────────────────────────────────────────────────────────────\n275: \n276: test('the doctor contract carries every field its schema requires and nothing it forbids', () => {\n277:   for (const key of FAMILY_SCHEMA.required) {\n278:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n279:   }\n280:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n281:   assert.deepEqual(\n282:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n283:     [],\n284:     'the schema forbids an additional property',\n285:   );\n286: });\n287: \n288: test('the contract names the install router, workflow, presentation and hint', () => {\n289:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n290:   const presentationPath = `.skilled/commands/doctor/assets/${PRESENTATION_ASSET}`;\n291:   const ownsPresentation = DOCTOR_CONTRACT.owned_assets.some((entry) => (\n292:     entry.purpose === 'presentation'\n293:     && entry.path.replace('doctor-<entry>-presentation.txt', PRESENTATION_ASSET) === presentationPath\n294:   ));\n295: \n296:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/install.md'));\n297:   assert.ok(DOCTOR_CONTRACT.execution_targets\n298:     .some((entry) => entry.target.endsWith(WORKFLOW_ASSET)), WORKFLOW_ASSET);\n299:   assert.ok(ownsPresentation, presentationPath);\n300:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (install)`));\n301: });\n302: \n303: test('the contract publishes the install invocation alias', () => {\n304:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n305:   const alias = `/doctor:install ${hint.replace(/ \\| list \\| \\?$/, '')}`;\n306:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(alias), alias);\n307: });\n308: \n309: test('the contract describes the install loader behavior', () => {\n310:   assert.ok(\n311:     DOCTOR_CONTRACT.loader_requirements.some((line) => line.includes('/doctor:install')),\n312:     '/doctor:install is missing from loader_requirements',\n313:   );\n314: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\"}"},"time":{"start":1794586680412,"end":1794586681277}}}}
