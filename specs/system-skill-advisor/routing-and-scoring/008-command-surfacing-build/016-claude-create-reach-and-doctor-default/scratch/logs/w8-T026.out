ata.json 3 entries\n  OK   system-spec-kit/command-metadata.json 7 entries\n\n  1 prose divergence(s) reported above; --strict fails on them.\n\nSTATUS=OK command-catalog-mirror: every catalog and hub metadata covers the command tree\n\nexit=0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node .skilled/commands/doctor/scripts/command-catalog-mirror-check.cjs --check; echo \\\"exit=$?\\\"\"}"},"time":{"start":1794585900431,"end":1794585900979}}}}
