\n275:function buildExactSemanticRerankIndex(prompt, projection, recommendations, fusion) {\n34:import { loadAdvisorProjection } from './projection.js';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"projection\\\" .skilled/skills/system-skill-advisor/runtime/dist/runtime/lib/scorer/fusion.js | head -10; rg -n \\\"from './projection|projection'\\\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts | head -10\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794585459255,"end":1794585461017}}}}
