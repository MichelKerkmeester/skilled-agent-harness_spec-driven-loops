rieval/generate-trigger-index.mjs --check --json  # the staleness verdict: exit 0 = fresh, 1 = stale documents named, 2+ = unreadable index; writes nothing'\n76:       - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json -- \"resume work session context\"  # index present AND lookup runs: exit 0 = hits, 1 = clean no-hit, 2+ = missing or unreadable index, reported with stderr and never as a no-hit'\n77:       - \"rg --no-config --hidden --files-with-matches --max-count 1 --fixed-strings --ignore-case --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' --glob '!**/.git/**' --glob '!**/scratch/**' -- 'trigger index generator' specs .skilled  # the section 2.2 recipe, flags verbatim\"\n78:       - 'node .skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs --corpus <all|skills> --moved  # the citation-drift census, run only when the operator picks a scope at the citation_drift_scope gate; zero model calls, writes nothing, exit 2 = bad invocation or unreadable redirect table'\n79:     trigger_phrases:\n80:       - \"trigger index drift\"\n81:       - \"trigger index lookup fails\"\n82:       - \"retrieval conventions doctor\"\n83:       - \"ripgrep recipe check\"\n84:       - \"citation drift summary\"\n85:       - \"is the trigger index fresh\"\n86: \n87:   - command: /doctor:deep-loop\n88:     target: deep-loop\n89:     yaml: doctor-deep-loop.yaml\n90:     setup_vars: [execution_mode, intent, scope]\n91:     allowed_flags: [\"--scope=research|review|council|both|all\"]\n92:     mutating: add-only\n93:     write_scope: spec-folder\n94:     gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n95:     mcp_tools: []\n96:     script_invocations:\n97:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --read-only'\n98:       - 'node .skilled/skills/system-deep-loop/r