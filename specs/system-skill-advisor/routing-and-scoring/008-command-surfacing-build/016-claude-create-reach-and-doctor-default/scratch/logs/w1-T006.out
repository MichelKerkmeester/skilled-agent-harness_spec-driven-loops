-doc parent hub routing table\"\n452:       },\n453:       {\n454:         \"order\": 2,\n455:         \"skill\": \"create-with-human-voice\",\n456:         \"resource\": \".skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md\",\n457:         \"action\": \"load the voice-application mode contract, then apply the workflow to $ARGUMENTS\"\n458:       },\n459:       {\n460:         \"order\": 3,\n461:         \"skill\": \"create-with-human-voice\",\n462:         \"resource\": \".skilled/commands/create/assets/create-with-human-voice-presentation.txt\",\n463:         \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n464:       }\n465:     ],\n466:     \"discriminator\": {\n467:       \"whenToUse\": \"Use this command when the deliverable is prose that has to read as a person wrote it, and the target already exists.\",\n468:       \"preferSiblingWhen\": [\n469:         {\n470:           \"sibling\": \"sk-create-quality-control\",\n471:           \"when\": \"Prefer the document audit mode, which the hub reaches by routing rather than by a command, when the target needs structure, DQI and validator results rather than a voice pass.\"\n472:         },\n473:         {\n474:           \"sibling\": \"/create:readme\",\n475:           \"when\": \"Prefer the README command when the document does not exist yet. Author it first, then run the voice pass over what came out.\"\n476:         }\n477:       ]\n478:     }\n479:   },\n480:   {\n481:     \"command\": \"/create:goal\",\n482:     \"ownerMode\": \"sk-create-goal\",\n483:     \"description\": \"Author or revise a packet goal.md: top-level, phase-parent, child, retrofit, phase-add, amend. :auto/:confirm.\",\n484:     \"argumentHint\": \"<packet path> [top-level|phase-parent|child|retrofit|phase-add|amend] [:auto|:confirm]\",\n485:     \"mutating\": \"mutates\",\n486:     \"gate3_location\": \"a goal.md inside the spec packet the user names\",\n487:     \"userIntent\": {\n488:       \"job\": \"I want a spec packet's goal.md authored, added or revised from that packet's own sources.\",\n489:       \"ownedSignals\": [\n490:         \"write a goal.md for a packet\",\n491:         \"author a phase parent goal\",\n492:         \"add a goal to a packet\",\n493:         \"author a nested child goal\"\n494:       ]\n495:     },\n496:     \"choreography\": [\n497:       {\n498:         \"order\": 1,\n499:         \"skill\": \"sk-doc\",\n500:         \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n501:         \"action\": \"load the sk-doc parent hub routing table\"\n502:       },\n503:       {\n504:         \"order\": 2,\n505:         \"skill\": \"create-goal\",\n506:         \"resource\": \".skilled/skills/sk-doc/sk-create-goal/SKILL.md\",\n507:         \"action\": \"load the packet-goal authoring mode contract, then apply the workflow to $ARGUMENTS\"\n508:       },\n509:       {\n510:         \"order\": 3,\n511:         \"skill\": \"create-goal\",\n512:         \"resource\": \".skilled/commands/create/assets/create-goal-presentation.txt\",\n513:         \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n514:       }\n515:     ],\n516:     \"discriminator\": {\n517:       \"whenToUse\": \"Use this command when the deliverable is a spec packet's goal.md (top-level, phase parent or nested child) authored or revised from that packet's own sources.\",\n518:       \"preferSiblingWhen\": [\n519:         {\n520:           \"sibling\": \"/goal-opencode\",\n521:           \"when\": \"Prefer the goal hooks (/goal, /goal-opencode, /goal-pi, /goal-cursor) or the host's native goal command when the request is to set, bind or resend a session objective; this command authors goal files and never touches session state.\"\n522:         }\n523:       ]\n524:     }\n525:   }\n526: ]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees