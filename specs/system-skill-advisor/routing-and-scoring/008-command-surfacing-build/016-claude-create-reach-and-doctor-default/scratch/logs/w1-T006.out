       ],\n34:       \"loader_requirements\": [\n35:         \"Read the presentation asset before showing any startup question\",\n36:         \"$ARGUMENTS resolved in the router's MODE ROUTING section; the foot-of-file `User request: $ARGUMENTS` raw echo is deprecated\",\n37:         \":auto honors a PRE-BOUND SETUP ANSWERS: marker block for non-interactive setup\",\n38:         \"Stop and report the missing path if any referenced asset is absent\"\n39:       ],\n40:       \"presentation\": { \"owner\": \"presentation-asset\", \"exceptions\": [] },\n41:       \"destructive_policy\": {\n42:         \"has_destructive_ops\": true,\n43:         \"gated\": true,\n44:         \"operations\": [\"writes and overwrites skill and doc files\", \"full-update mutates existing docs\"]\n45:       },\n46:       \"timeout_bounds\": null,\n47:       \"invocation_aliases\": [\"/create:skill\", \"/create:agent\", \"/create:<operation>\", \":auto suffix\", \":confirm suffix\"],\n48:       \"workflow_schema_ref\": null\n49:     },\n50:     \"design\": {\n51:       \"topology\": \"mode-pair\",\n52:       \"router_path\": \".skilled/commands/design/*.md\",\n53:       \"input\": {\n54:         \"required\": true,\n55:         \"gate_owner\": \"router\",\n56:         \"argument_hint\": \"<live-url> --output <dir> [--register brand|product] [:auto|:confirm]\"\n57:       },\n58:       \"execution_targets\": [\n59:         { \"selector\": \":auto | no-suffix with complete args\", \"target\": \".skilled/commands/design/assets/extract-auto.yaml\" },\n60:         { \"selector\": \":confirm | no-suffix with incomplete args\", \"target\": \".skilled/commands/design/assets/extract-confirm.yaml\" }\n61:       ],\n62:       \"mode_matrix\": {\n63:         \"default_policy\": \"conditional-auto\",\n64:         \"supported_modes\": [\":auto\", \":confirm\"]\n65:       },\n66:       \"owned_assets\": [\n67:         { \"purpose\": \"presentation\", \"path\": \".skilled/commands/design/assets/extract-presentation.txt\" },\n68:         { \"purpose\": \"auto_workflow\", \"path\": \".skilled/commands/design/assets/extract-auto.yaml\" },\n69:         { \"purpose\": \"confirm_workflow\", \"path\": \".skilled/commands/design/assets/extract-confirm.yaml\" },\n[Output truncated. Continue reading with offset: 70]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-doc/sk-create-command/assets/command-contract.json\", \"offset\": 30, \"limit\": 40}"},"time":{"start":1794582806273,"end":1794582811557}}}}
