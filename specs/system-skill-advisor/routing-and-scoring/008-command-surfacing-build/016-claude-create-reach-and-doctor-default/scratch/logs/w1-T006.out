 invariants passed, 0 warnings\nall 7 hubs resolve\nall 55 served copies match their authored files\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"rg -l -P --hidden '/create:skill(?![-\\\\w])|(?<![-\\\\w/])create:skill(?![-\\\\w])|create/skill\\\\.md|command-create-skill(?![-\\\\w])' --glob '!specs/**' --glob '!**/node_modules/**' --glob '!**/dist/**' --glob '!.git/**' .skilled/skills/sk-doc/command-metadata.json .skilled/skills/sk-doc/hub-router.json .skilled/skills/sk-doc/mode-registry.json .skilled/skills/sk-doc/README.md .skilled/skills/sk-doc/ROUTER.md .skilled/skills/sk-doc/SKILL.md .skilled/skills/sk-doc/sk-create-command/assets/command-contract.json .skilled/skills/sk-doc/sk-create-frontmatter/SKILL.md\\nprintf 'OLD scan exit=%s (1 means no matches)\\\\n' \\\"$?\\\"\\njq empty .skilled/skills/sk-doc/command-metadata.json .skilled/skills/sk-doc/hub-router.json .skilled/skills/sk-doc/mode-registry.json .skilled/skills/sk-doc/sk-create-command/assets/command-contract.json\\nprintf 'jq empty exit=%s\\\\n' \\\"$?\\\"\\nnode .skilled/commands/doctor/scripts/parent-skill-check.cjs .skilled/skills/sk-doc | tail -2\\nnode .skilled/bin/compiled-route-sync.cjs --check | tail -2\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794582928191,"end":1794582930677}}}}
