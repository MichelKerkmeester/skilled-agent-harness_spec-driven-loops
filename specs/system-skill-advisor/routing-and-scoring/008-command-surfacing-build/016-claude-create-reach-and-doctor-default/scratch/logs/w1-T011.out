{"type":"tool_use","timestamp":1794582782567,"sessionID":"ses_e2a8827bdffecGN51mfmPQmfDl","part":{"partID":"prt_1d57820960024ar0lzKDi4aThk","sessionID":"ses_e2a8827bdffecGN51mfmPQmfDl","messageID":"msg_1d57805d2001rwkfpcnnUvPAg4","type":"tool","id":"chatcmpl-tool-899b5fcca7552c23","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-173\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A weak cue is a bare word\n49: // that ordinary work requests also use (\"fix the broken example\"), so it counts\n50: // only when no skill passes. Every hand-off needs at least one cue.\n51: const STRONG_PROBLEM_CUE = new RegExp([\n52:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n53:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n54:   '\\\\bstopped converg\\\\w*\\\\b',\n55:   '\\\\breturns? nothing\\\\b',\n56:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n57:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n58:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n59: ].join('|'), 'i');\n60: \n61: const WEAK_PROBLEM_CUE = new RegExp([\n62:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n63:   '\\\\bout of (?:date|sync)\\\\b',\n64: ].join('|'), 'i');\n65: \n66: // A request for a repair route that names no problem the ranker knows still\n67: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n68: // phrases are exact, so ordinary work requests never carry them.\n69: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. TYPES\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: interface HelperCandidate {\n76:   readonly command: string;\n77:   readonly runnable?: string;\n78:   readonly score: number;\n79: }\n80: \n81: interface HelperModule {\n82:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n83:   readonly rankProblem: (\n84:     entries: readonly unknown[],\n85:     text: string,\n86:     options: { readonly top: number },\n87:   ) => { readonly candidates?: readonly HelperCandidate[] };\n88: }\n89: \n90: interface LoadedHelper {\n91:   readonly manifestMtimeMs: number;\n92:   readonly module: HelperModule;\n93:   readonly entries: readonly unknown[];\n94: }\n95: \n96: /** The doctor command the helper ranked first, with its rank score. */\n97: export interface DoctorProblemMatch {\n98:   readonly command: string;\n99:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n100:   readonly runnable: string;\n101:   readonly score: number;\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 4. HELPERS\n106: // ───────────────────────────────────────────────────────────────────\n107: \n108: const loadedByRoot = new Map<string, LoadedHelper | null>();\n109: \n110: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n111:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n112:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n113:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n114:   let manifestMtimeMs: number;\n115:   try {\n116:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n117:   } catch {\n118:     return null;\n119:   }\n120:   const cached = loadedByRoot.get(workspaceRoot);\n121:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n122:   try {\n123:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n124:     const loaded: LoadedHelper = {\n125:       manifestMtimeMs,\n126:       module: helper,\n127:       entries: helper.loadEntries(workspaceRoot).entries,\n128:     };\n129:     loadedByRoot.set(workspaceRoot, loaded);\n130:     return loaded;\n131:   } catch {\n132:     loadedByRoot.set(workspaceRoot, null);\n133:     return null;\n134:   }\n135: }\n136: \n137: // ───────────────────────────────────────────────────────────────────\n138: // 5. CORE LOGIC\n139: // ───────────────────────────────────────────────────────────────────\n140: \n141: /** The strongest problem cue the prompt carries. */\n142: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n143:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n144:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n145:   return null;\n146: }\n147: \n148: /** True when the prompt asks for a repair route without naming the problem. */\n149: export function genericRepairCue(prompt: string): boolean {\n150:   return GENERIC_REPAIR_CUE.test(prompt);\n151: }\n152: \n153: /**\n154:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n155:  * candidate when that candidate reaches the hand-off score, or null.\n156:  */\n157: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n158:   const loaded = loadHelper(workspaceRoot);\n159:   if (!loaded) return null;\n160:   try {\n161:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n162:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n163:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n164:       ? {\n165:           command: first.command,\n166:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n167:           score: first.score,\n168:         }\n169:       : null;\n170:   } catch {\n171:     return null;\n172:   }\n173: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts, lines 1-173\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Doctor Helper Hand-off\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // A doctor bridge passes only on its own declared wording, so a doctor problem\n6: // described in other words reaches no doctor command at all. /doctor:helper\n7: // already ranks free-text problems against every doctor route by word overlap.\n8: // When no doctor bridge passes, this module asks that same ranker whether the\n9: // prompt describes a doctor problem, and if it does the advisor offers the command the ranker named, or\n10: // /doctor:helper when that command asks before it runs.\n11: //\n12: // Two durable design choices:\n13: //   1. The ranker is the helper's own script, loaded from the workspace at run\n14: //      time, so the advisor and /doctor:helper can never disagree about what\n15: //      counts as a doctor problem. Any failure to load or rank is a no-match.\n16: //   2. Word overlap alone also fires on ordinary requests that share doctor\n17: //      vocabulary (\"start a deep review loop\"), so a weak match also needs the\n18: //      prompt to name a problem. Beside a passing skill only a strong cue\n19: //      counts, because bare words such as \"missing\" or \"broken\" are common in\n20: //      ordinary work. With no skill passing, a strong ranker match stands in\n21: //      for the cue.\n22: \n23: // ───────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS\n25: // ───────────────────────────────────────────────────────────────────\n26: \n27: import { existsSync, statSync } from 'node:fs';\n28: import { createRequire } from 'node:module';\n29: import { join } from 'node:path';\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 2. CONSTANTS\n33: // ───────────────────────────────────────────────────────────────────\n34: \n35: const HELPER_SCRIPT = join('.skilled', 'commands', 'doctor', 'scripts', 'doctor-helper-match.cjs');\n36: const ROUTE_MANIFEST = join('.skilled', 'commands', 'doctor', '_routes.yaml');\n37: \n38: /** The bridge id the hand-off surfaces. */\n39: export const DOCTOR_HELPER_BRIDGE_ID = 'command-doctor-helper';\n40: \n41: /** Lowest helper rank score that counts as a doctor problem. */\n42: export const DOCTOR_HELPER_MIN_SCORE = 6;\n43: \n44: /** Helper rank score that stands in for a cue when no skill passes. */\n45: export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n46: \n47: // A strong cue says a state is wrong or asks for a health or switch change, so\n48: // it can surface the helper beside a passing skill. A weak cue is a bare word\n49: // that ordinary work requests also use (\"fix the broken example\"), so it counts\n50: // only when no skill passes. Every hand-off needs at least one cue.\n51: const STRONG_PROBLEM_CUE = new RegExp([\n52:   \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n53:   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n54:   '\\\\bstopped converg\\\\w*\\\\b',\n55:   '\\\\breturns? nothing\\\\b',\n56:   '\\\\b(?:healthy|health|diagnos\\\\w*)\\\\b',\n57:   '\\\\bturn(?:ed)? (?:on|off)\\\\b',\n58:   '\\\\bswitch(?:ed)? (?:on|off)\\\\b',\n59: ].join('|'), 'i');\n60: \n61: const WEAK_PROBLEM_CUE = new RegExp([\n62:   '\\\\b(?:broken|breaks?|failing|fails?|failed|wrong|stale|missing|stuck|errors?|drift(?:ed|s|ing)?)\\\\b',\n63:   '\\\\bout of (?:date|sync)\\\\b',\n64: ].join('|'), 'i');\n65: \n66: // A request for a repair route that names no problem the ranker knows still\n67: // belongs to /doctor:helper, which lists the routes and their reasons. The two\n68: // phrases are exact, so ordinary work requests never carry them.\n69: const GENERIC_REPAIR_CUE = /\\b(?:repair path|i have a problem)\\b/i;\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 3. TYPES\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: interface HelperCandidate {\n76:   readonly command: string;\n77:   readonly runnable?: string;\n78:   readonly score: number;\n79: }\n80: \n81: interface HelperModule {\n82:   readonly loadEntries: (root: string) => { readonly entries: readonly unknown[] };\n83:   readonly rankProblem: (\n84:     entries: readonly unknown[],\n85:     text: string,\n86:     options: { readonly top: number },\n87:   ) => { readonly candidates?: readonly HelperCandidate[] };\n88: }\n89: \n90: interface LoadedHelper {\n91:   readonly manifestMtimeMs: number;\n92:   readonly module: HelperModule;\n93:   readonly entries: readonly unknown[];\n94: }\n95: \n96: /** The doctor command the helper ranked first, with its rank score. */\n97: export interface DoctorProblemMatch {\n98:   readonly command: string;\n99:   /** The command with its subcommand, such as `/doctor:agents-md check`. */\n100:   readonly runnable: string;\n101:   readonly score: number;\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 4. HELPERS\n106: // ───────────────────────────────────────────────────────────────────\n107: \n108: const loadedByRoot = new Map<string, LoadedHelper | null>();\n109: \n110: function loadHelper(workspaceRoot: string): LoadedHelper | null {\n111:   const scriptPath = join(workspaceRoot, HELPER_SCRIPT);\n112:   const manifestPath = join(workspaceRoot, ROUTE_MANIFEST);\n113:   if (!existsSync(scriptPath) || !existsSync(manifestPath)) return null;\n114:   let manifestMtimeMs: number;\n115:   try {\n116:     manifestMtimeMs = statSync(manifestPath).mtimeMs;\n117:   } catch {\n118:     return null;\n119:   }\n120:   const cached = loadedByRoot.get(workspaceRoot);\n121:   if (cached && cached.manifestMtimeMs === manifestMtimeMs) return cached;\n122:   try {\n123:     const helper = createRequire(import.meta.url)(scriptPath) as HelperModule;\n124:     const loaded: LoadedHelper = {\n125:       manifestMtimeMs,\n126:       module: helper,\n127:       entries: helper.loadEntries(workspaceRoot).entries,\n128:     };\n129:     loadedByRoot.set(workspaceRoot, loaded);\n130:     return loaded;\n131:   } catch {\n132:     loadedByRoot.set(workspaceRoot, null);\n133:     return null;\n134:   }\n135: }\n136: \n137: // ───────────────────────────────────────────────────────────────────\n138: // 5. CORE LOGIC\n139: // ───────────────────────────────────────────────────────────────────\n140: \n141: /** The strongest problem cue the prompt carries. */\n142: export function doctorProblemCue(prompt: string): 'strong' | 'weak' | null {\n143:   if (STRONG_PROBLEM_CUE.test(prompt)) return 'strong';\n144:   if (WEAK_PROBLEM_CUE.test(prompt)) return 'weak';\n145:   return null;\n146: }\n147: \n148: /** True when the prompt asks for a repair route without naming the problem. */\n149: export function genericRepairCue(prompt: string): boolean {\n150:   return GENERIC_REPAIR_CUE.test(prompt);\n151: }\n152: \n153: /**\n154:  * Ranks the prompt with /doctor:helper's own matcher and returns its first\n155:  * candidate when that candidate reaches the hand-off score, or null.\n156:  */\n157: export function matchDoctorProblem(prompt: string, workspaceRoot: string): DoctorProblemMatch | null {\n158:   const loaded = loadHelper(workspaceRoot);\n159:   if (!loaded) return null;\n160:   try {\n161:     const first = loaded.module.rankProblem(loaded.entries, prompt, { top: 1 }).candidates?.[0];\n162:     if (!first || typeof first.command !== 'string' || typeof first.score !== 'number') return null;\n163:     return first.score >= DOCTOR_HELPER_MIN_SCORE\n164:       ? {\n165:           command: first.command,\n166:           runnable: typeof first.runnable === 'string' && first.runnable !== '' ? first.runnable : first.command,\n167:           score: first.score,\n168:         }\n169:       : null;\n170:   } catch {\n171:     return null;\n172:   }\n173: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\"}"},"time":{"start":1794582782102,"end":1794582782567}}}}
