{"type":"tool_use","timestamp":1794582961188,"sessionID":"ses_e2a8827bdffecGN51mfmPQmfDl","part":{"partID":"prt_1d57ad8400019U5KzJGfkXHcfh","sessionID":"ses_e2a8827bdffecGN51mfmPQmfDl","messageID":"msg_1d57ab389001BPKTptwWDbTkha","type":"tool","id":"call_6ac77529dad64aa1b6c45370","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts .skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\nindex b3e0c6a287..a561f9536d 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/doctor-helper-handoff.ts\n@@ -45,11 +45,13 @@ export const DOCTOR_HELPER_MIN_SCORE = 6;\n export const DOCTOR_HELPER_UNCUED_MIN_SCORE = 10;\n \n // A strong cue says a state is wrong or asks for a health or switch change, so\n-// it can surface the helper beside a passing skill. A weak cue is a bare word\n-// that ordinary work requests also use (\"fix the broken example\"), so it counts\n-// only when no skill passes. Every hand-off needs at least one cue.\n+// it can surface the helper beside a passing skill. A tool or command that does\n+// not show up or appear is that wrong state, like one that is not registered or\n+// not found. A weak cue is a bare word that ordinary work requests also use\n+// (\"fix the broken example\"), so it counts only when no skill passes. Every\n+// hand-off needs at least one cue.\n const STRONG_PROBLEM_CUE = new RegExp([\n-  \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*)\\\\b\",\n+  \"\\\\b(?:not|isn'?t|aren'?t|doesn'?t|don'?t|won'?t|can'?t) (?:\\\\w+ )?(?:work|working|registered|found|load|loading|run|running|active|linked|fir(?:e|es|ing)|trigger(?:s|ing)?|converg\\\\w*|show(?:s|ing)? up|appear(?:s|ing)?)\\\\b\",\n   '\\\\bnever (?:converg\\\\w*|finish\\\\w*|stops?|works?|loads?|runs?)\\\\b',\n   '\\\\bstopped converg\\\\w*\\\\b',\n   '\\\\breturns? nothing\\\\b',\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\nindex 6692626e63..a5e3503f54 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n@@ -34,6 +34,16 @@ describe('doctor problem cue', () => {\n     expect(doctorProblemCue('the git hooks are not triggering on commit')).toBe('strong');\n   });\n \n+  // A tool that never appears is the same wrong state as one that does not\n+  // register, and the operator reports it in the negative rather than with a\n+  // problem adjective.\n+  it('reads a tool that does not show up as a strong cue', () => {\n+    expect(doctorProblemCue('the deploy button is not showing up after the update')).toBe('strong');\n+    expect(doctorProblemCue(\"my new agent isn't appearing in the picker\")).toBe('strong');\n+    expect(doctorProblemCue(\"don't show line numbers in the diff\")).toBeNull();\n+    expect(doctorProblemCue('show me how the advisor ranks skills')).toBeNull();\n+  });\n+\n   // A loop that stopped converging reports the same wrong state in the past\n   // tense, which the \"never <verb>\" form does not cover.\n   it('reads a loop that stopped converging as a strong cue', () => {\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\nindex 3e72fa95d5..0cf0bc6206 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\n@@ -22,6 +22,7 @@ import type {\n const HERE = dirname(fileURLToPath(import.meta.url));\n const ROUTING = resolve(HERE, '../../scripts/routing-accuracy');\n const BASELINE_PATH = join(ROUTING, 'scorer-eval-baseline.json');\n+const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n const DOCTOR_PREFIX = 'command-doctor-';\n \n@@ -111,6 +112,24 @@ describe('doctor hand-off command', () => {\n     expect(ids.slice(0, 2)).toEqual(['system-deep-loop', 'command-doctor-deep-loop']);\n   });\n \n+  // The helper stands beside the skills for a tool that never appears. The row\n+  // is a tune prompt, so its wording may be read here after the split check.\n+  it('offers the helper beside the skills for a tool that does not show up', () => {\n+    const row = readFileSync(CORPUS_PATH, 'utf8')\n+      .split('\\n')\n+      .filter((line) => line.trim() !== '')\n+      .map((line) => JSON.parse(line) as { id: string; split: string; prompt: string })\n+      .find((candidate) => candidate.id === 'cmd-doctor-mcp-plain-tune-01');\n+\n+    expect(row).toBeDefined();\n+    if (!row) return;\n+    expect(row.split).toBe('tune');\n+    const ids = scoredIds(row.prompt);\n+\n+    expect(ids[0]).toBe('mcp-code-mode');\n+    expect(ids.slice(0, 3)).toContain('command-doctor-helper');\n+  });\n+\n   it('falls back to the helper for a repair request with no ranked command', () => {\n     expect(scoredIds('I have a problem and want the right repair path suggested with reasons')[0])\n       .toBe('command-doctor-helper');\n","title"