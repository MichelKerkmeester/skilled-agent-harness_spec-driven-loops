 .filter((line) => line.trim() !== '')\\n      .map((line) => JSON.parse(line) as { readonly id: string; readonly split: string; readonly prompt: string })\\n      .find((candidate) => candidate.id === 'cmd-doctor-mcp-plain-tune-01');\\n\\n    expect(row).toBeDefined();\\n    if (!row) return;\\n    expect(row.split).toBe('tune');\\n    const ids = scoredIds(row.prompt);\\n\\n    expect(ids[0]).toBe('mcp-code-mode');\\n    expect(ids.slice(0, 3)).toContain('command-doctor-helper');\\n  });\\n\\n  it('falls back to the helper for a repair request with no ranked command', () => {\",\"oldString\":\"  it('falls back to the helper for a repair request with no ranked command', () => {\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/doctor-handoff-command.vitest.ts\"}"},"time":{"start":1794582898451,"end":1794582900738}}}}
