rThan(1);\n117: \n118:     mockedChild.execFileSync.mockClear();\n119:     const topOnly = responseData(await handleAdvisorRecommend({\n120:       prompt: hubPrompt,\n[Output truncated. Continue reading with offset: 121]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\",\"limit\":120}"},"time":{"start":1794582866228,"end":1794582866798}}}}
