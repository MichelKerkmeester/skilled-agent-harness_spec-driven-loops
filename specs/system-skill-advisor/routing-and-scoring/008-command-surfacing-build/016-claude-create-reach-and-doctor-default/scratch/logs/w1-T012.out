{"type":"tool_use","timestamp":1794582814584,"sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","part":{"partID":"prt_1d5789db50015wSZUTnqCnp6Af","sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","messageID":"msg_1d5784ad3001rHT6e1nQMoOFnz","type":"tool","id":"call_49e0ca84510f438d81a421e5","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-manifest.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-manifest.test.cjs, lines 1-615\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Manifest and Segmenter Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The manifest claims to hold the template a consumer receives, so its claims have to be\n8: // checkable without trusting the file that makes them: the segmenter must tile the root\n9: // document, the generator must refuse a surface it does not recognise, every pin's\n10: // consumer must still hold the text the pin promises, the authored ceilings must be the\n11: // ones the canary enforces, and the rule-copy canary must find its own AGENTS.md strings\n12: // inside the pin set alone.\n13: //\n14: // The suite ships with the manifest into consumer repositories, whose root AGENTS.md is\n15: // their own file. The cases that read this repository's root document are therefore\n16: // gated on the origin remote naming the manifest's source repository; everywhere else\n17: // they skip and print the reason, so a consumer sees why instead of a wall of failures.\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 1. IMPORTS AND PATHS\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: const assert = require('node:assert/strict');\n24: const { spawnSync } = require('node:child_process');\n25: const fs = require('node:fs');\n26: const os = require('node:os');\n27: const path = require('node:path');\n28: const test = require('node:test');\n29: \n30: const { classifyBody, matchSections, segment, sha256 } = require('../lib/agents-md-sections.cjs');\n31: const {\n32:   MANIFEST_PATH,\n33:   composeDerived,\n34:   dedupeBodies,\n35:   limitDrift,\n36:   main,\n37:   readCanaryLimits,\n38:   sourceStatus,\n39: } = require('../agents-md-manifest.cjs');\n40: \n41: const SCRIPTS_DIR = path.resolve(__dirname, '..');\n42: const REPO_ROOT = path.resolve(SCRIPTS_DIR, '../../../..');\n43: const GENERATOR = path.join(SCRIPTS_DIR, 'agents-md-manifest.cjs');\n44: const CANARY = path.join(REPO_ROOT, '.skilled/skills/sk-code/sk-code-review/scripts/check-rule-copies.js');\n45: const MANIFEST_RELATIVE = '.skilled/commands/doctor/assets/agents-md-manifest.json';\n46: \n47: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n48: const rootText = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n49: \n50: // One answer for every case that reads this repository's own root document.\n51: const source = sourceStatus({ root: REPO_ROOT, manifest });\n52: const NOT_SOURCE = source.isSource ? false : source.reason;\n53: \n54: // ─────────────────────────────────────────────────────────────────────────────\n55: // 2. HELPERS\n56: // ─────────────────────────────────────────────────────────────────────────────\n57: \n58: function runGenerator(args, env = process.env) {\n59:   const result = spawnSync(process.execPath, [GENERATOR, ...args], { encoding: 'utf8', env });\n60:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n61: }\n62: \n63: // A throwaway directory the case removes itself, so a failed assertion never leaves a\n64: // tree behind for the next run to read.\n65: function scratch(t) {\n66:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-manifest-'));\n67:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n68:   return dir;\n69: }\n70: \n71: function copyManifest(dir) {\n72:   const target = path.join(dir, 'agents-md-manifest.json');\n73:   fs.copyFileSync(MANIFEST_PATH, target);\n74:   return target;\n75: }\n76: \n77: // The canary resolves its other pins under --root, so a throwaway root still needs the\n78: // skill tree. A symlink keeps that free; a filesystem without symlinks falls back to a\n79: // copy that skips the installed packages.\n80: function linkSkills(tempRoot) {\n81:   try {\n82:     fs.symlinkSync(path.join(REPO_ROOT, '.skilled'), path.join(tempRoot, '.skilled'), 'dir');\n83:   } catch {\n84:     fs.cpSync(path.join(REPO_ROOT, '.skilled'), path.join(tempRoot, '.skilled'), {\n85:       recursive: true,\n86:       filter: (from) => !from.split(path.sep).includes('node_modules'),\n87:     });\n88:   }\n89: }\n90: \n91: function blockLines(content) {\n92:   return content\n93:     .split('\\n')\n94:     .map((line) => line.trim())\n95:     .filter((line) => line !== '');\n96: }\n97: \n98: function derivedOf(id) {\n99:   const entry = manifest.derived.sections[id];\n100:   assert.ok(entry, `the manifest's derived key holds section ${id}`);\n101:   return entry;\n102: }\n103: \n104: // ─────────────────────────────────────────────────────────────────────────────\n105: // 3. SOURCE-REPOSITORY GATE\n106: // ─────────────────────────────────────────────────────────────────────────────\n107: \n108: test('source gate: a foreign origin yields a skip reason that names it', () => {\n109:   const foreign = 'https://example.invalid/someone-else/their-fork.git';\n110:   const answer = sourceStatus({ root: REPO_ROOT, manifest, readOrigin: () => foreign });\n111: \n112:   assert.equal(answer.isSource, false);\n113:   assert.match(answer.reason, /example\\.invalid\\/someone-else\\/their-fork/, 'the reason names the origin it read');\n114:   assert.match(answer.reason, /manifest\\.source_repository/, 'the reason names what it compared against');\n115: });\n116: \n117: test('source gate: this worktree is the source repository', { skip: NOT_SOURCE }, () => {\n118:   assert.equal(source.isSource, true, `origin ${source.origin} matches the manifest`);\n119:   assert.match(source.identity, /^[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$/);\n120: });\n121: \n122: // ─────────────────────────────────────────────────────────────────────────────\n123: // 4. SEGMENTER\n124: // ─────────────────────────────────────────────────────────────────────────────\n125: \n126: test('segmenter: 44 sections tile the root document and their start bytes match the table', { skip: NOT_SOURCE }, () => {\n127:   const { sections, block } = segment(rootText, manifest.markers, manifest.sections);\n128:   assert.ok(block, 'the published template carries the repository block');\n129: \n130:   assert.equal(sections.length, 44, 'the shipped surface is 44 headings deep');\n131:   assert.equal(manifest.sections.length, 44, 'every authored entry is one shipped section');\n132:   assert.equal(sections[0].start, 0, 'the first section starts at byte 0');\n133: \n134:   for (let index = 0; index < sections.length; index += 1) {\n135:     const section = sections[index];\n136:     const recorded = derivedOf(section.id);\n137:     assert.equal(section.start, recorded.start, `section ${section.id}: start byte`);\n138:     assert.equal(section.end, recorded.end, `section ${section.id}: end byte`);\n139:     assert.equal(section.sha256, recorded.sha256, `section ${section.id}: body hash`);\n140:     assert.equal(section.body, recorded.body, `section ${section.id}: body`);\n141:     if (index > 0) {\n142:       assert.equal(section.start, sections[index - 1].end, `section ${section.id} starts where the previous one ends`);\n143:     }\n144:   }\n145:   assert.equal(sections[sections.length - 1].end, block.start, 'the last section runs to where the repository block begins');\n146: });\n147: \n148: test('segmenter: every authored match prefix finds exactly one section, at its heading', { skip: NOT_SOURCE }, () => {\n149:   const { sections } = segment(rootText, manifest.markers);\n150:   const { matched, unregistered, unmatched } = matchSections(sections, manifest.sections);\n151: \n152:   assert.deepEqual(unregistered, [], 'no heading is left unregistered');\n153:   assert.deepEqual(unmatched, [], 'no authored entry matches nothing');\n154:   assert.equal(matched.length, 44);\n155: \n156:   for (const row of matched) {\n157:     assert.equal(row.section.heading.includes(row.entry.match), true, `${row.entry.id}: the match prefix is part of the heading`);\n158:     assert.equal(row.entry.level, row.section.level, `${row.entry.id}: heading level`);\n159:   }\n160: });\n161: \n162: test('segmenter: the block heading is not a shipped section', () => {\n163:   const text = [\n164:     '# Root',\n165:     '',\n166:     '## Shipped section',\n167:     '',\n168:     'body line',\n169:     '',\n170:     manifest.markers.start,\n171:     manifest.markers.heading,\n172:     '',\n173:     manifest.markers.note,\n174:     manifest.markers.end,\n175:     '',\n176:   ].join('\\n');\n177:   const { sections, block } = segment(text, manifest.markers);\n178: \n179:   assert.equal(sections.length, 2, 'the block heading belongs to the block, not to the shipped surface');\n180:   assert.equal(block.complete, true);\n181:   assert.deepEqual(blockLines(block.content), [manifest.markers.heading, manifest.markers.note], 'the empty block holds no repository content');\n182:   assert.equal(sections[1].end, block.start, 'the last shipped section ends where the block begins');\n183: });\n184: \n185: // A repository documents the block by writing its markers inside a sentence. The same bytes\n186: // are the block's edge only when the line carries nothing else, because an edge in the\n187: // middle of a line leaves the text on either side in no section, in no prelude and in no\n188: // block, where a rewrite deletes it and nothing is left holding a claim about it.\n189: test('segmenter: a marker is the whole line, and the block reports the lines it owns', () => {\n190:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n191:   const quoted = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n192: \n193:   const prose = segment(`${shipped}${quoted}\\n`, manifest.markers, manifest.sections);\n194:   assert.equal(prose.block, null, 'prose that quotes both markers is not a block');\n195:   assert.ok(prose.sections[prose.sections.length - 1].body.includes(quoted), 'the sentence is a line of the section it ends');\n196:   assert.equal(prose.prelude, null, 'nothing sits above the first heading');\n197: \n198:   // Whitespace around a marker does not stop it being one, and the block names the line\n199:   // range it owns so a caller that reports where it sits has the figure already.\n200:   const block = [`  ${manifest.markers.start}`, manifest.markers.heading, '', manifest.markers.note, `  ${manifest.markers.end}`, ''].join('\\n');\n201:   const found = segment(`${shipped}${block}`, manifest.markers);\n202:   assert.equal(found.block.complete, true, 'an indented marker line is still a marker line');\n203:   assert.equal(found.block.markerLines.start.length, 1);\n204:   assert.equal(found.block.rows.last - found.block.rows.first + 1, block.split('\\n').length - 1, 'the block owns its five lines, markers included');\n205: });\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. GENERATOR REFUSALS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: test('generator refusal: a heading no authored entry matches exits 1 and names it', (t) => {\n212:   const dir = scratch(t);\n213:   // Inside the shipped surface, above the repository block: a heading added there would\n214:   // be dropped from every consumer's template at the next release.\n215:   const at = rootText.indexOf(manifest.markers.start);\n216:   const injected = `${rootText.slice(0, at)}#### A Heading The Template Never Shipped\\n\\n${rootText.slice(at)}`;\n217:   fs.writeFileSync(path.join(dir, manifest.root_file), injected);\n218:   const result = runGenerator(['--check', '--root', dir]);\n219: \n220:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n221:   assert.match(`${result.err}${result.out}`, /A Heading The Template Never Shipped/);\n222:   assert.match(`${result.err}${result.out}`, /unregistered/i);\n223: });\n224: \n225: test('generator refusal: an authored entry that matches nothing exits 1 and names it', (t) => {\n226:   const dir = scratch(t);\n227:   const copy = copyManifest(dir);\n228:   const edited = JSON.parse(fs.readFileSync(copy, 'utf8'));\n229:   edited.sections.push({ id: 'a-section-that-does-not-exist', match: '#### Never Written', level: 4, parent: 'four-laws' });\n230:   fs.writeFileSync(copy, `${JSON.stringify(edited, null, 2)}\\n`);\n231: \n232:   const result = runGenerator(['--check', '--root', REPO_ROOT, '--manifest', copy]);\n233:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n234:   assert.match(`${result.err}${result.out}`, /a-section-that-does-not-exist/);\n235:   assert.match(`${result.err}${result.out}`, /no heading matches/i);\n236: });\n237: \n238: test('generator: a missing root file exits 2 with a named cause and writes nothing', (t) => {\n239:   const dir = scratch(t);\n240:   const copy = copyManifest(dir);\n241:   const before = fs.readFileSync(copy, 'utf8');\n242:   const result = runGenerator(['--check', '--root', dir, '--manifest', copy]);\n243: \n244:   assert.equal(result.code, 2, `exit 2, stdout=${result.out} stderr=${result.err}`);\n245:   assert.match(`${result.err}${result.out}`, /AGENTS\\.md/);\n246:   assert.equal(fs.readFileSync(copy, 'utf8'), before, 'the manifest is untouched');\n247: });\n248: \n249: // Text above the first heading belongs to no section, so no derived body can carry it and\n250: // a `--write` would persist a copy of the template that quietly omits the line. The check\n251: // engine reports that text; the generator has to refuse it for the same reason.\n252: test('generator refusal: text above the first heading exits 1 and names the line', (t) => {\n253:   const dir = scratch(t);\n254:   const template = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n255:   const line = 'Read this first: the harness ships these instructions.';\n256:   fs.writeFileSync(path.join(dir, manifest.root_file), `${line}\\n${template}`);\n257: \n258:   const composed = composeDerived({ root: dir, manifest, history: [] });\n259:   assert.equal(composed.ok, false, 'a template with a prelude is not the clean surface the derived key describes');\n260:   const prelude = (composed.errors || []).find((error) => error.code === 'unmarked-prelude');\n261:   assert.ok(prelude, `the refusal names the text above the first heading: ${JSON.stringify(composed.errors)}`);\n262:   assert.match(prelude.message, /before its first heading/u);\n263:   assert.match(prelude.message, /line 1\\b/u, 'the message names the line it sits on');\n264:   assert.ok(prelude.message.includes(line), 'and carries the line itself');\n265: \n266:   const result = runGenerator(['--check', '--root', dir]);\n267:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n268:   assert.match(`${result.err}${result.out}`, /unmarked-prelude/u);\n269:   assert.match(`${result.err}${result.out}`, /before its first heading/u);\n270: });\n271: \n272: test('generator: --write outside the source repository exits 2 and names the origin', (t) => {\n273:   const dir = scratch(t);\n274:   const copy = copyManifest(dir);\n275:   const before = fs.readFileSync(copy, 'utf8');\n276:   const result = runGenerator(['--write', '--root', dir, '--manifest', copy]);\n277: \n278:   assert.equal(result.code, 2, `exit 2, stdout=${result.out} stderr=${result.err}`);\n279:   assert.match(`${result.err}${result.out}`, /source repository/);\n280:   assert.equal(fs.readFileSync(copy, 'utf8'), before, 'the manifest is untouched');\n281: });\n282: \n283: test('generator: a CI job names its own checkout, so another root is still refused', (t) => {\n284:   const dir = scratch(t);\n285:   const copy = copyManifest(dir);\n286:   const env = {\n287:     ...process.env,\n288:     GITHUB_REPOSITORY: manifest.source_repository.replace(/^https:\\/\\/github\\.com\\//, ''),\n289:     GITHUB_WORKSPACE: REPO_ROOT,\n290:   };\n291:   const result = runGenerator(['--write', '--root', dir, '--manifest', copy], env);\n292: \n293:   assert.equal(result.code, 2, `exit 2, stdout=${result.out} stderr=${result.err}`);\n294:   assert.match(`${result.err}${result.out}`, /source repository/);\n295: });\n296: \n297: // ─────────────────────────────────────────────────────────────────────────────\n298: // 6. DERIVED KEY FRESHNESS\n299: // ─────────────────────────────────────────────────────────────────────────────\n300: \n301: test('derived key: --check passes and names the section and pin counts', { skip: NOT_SOURCE }, () => {\n302:   const result = runGenerator(['--check']);\n303:   assert.equal(result.code, 0, `exit 0, stdout=${result.out} stderr=${result.err}`);\n304:   assert.match(result.out, new RegExp(`PASS: 44 sections, ${manifest.pins.length} pins, derived matches AGENTS\\\\.md`));\n305: });\n306: \n307: test('derived key: a one-byte edit to a copy of a derived body exits 1', (t) => {\n308:   const dir = scratch(t);\n309:   const copy = copyManifest(dir);\n310:   const edited = JSON.parse(fs.readFileSync(copy, 'utf8'));\n311:   const id = Object.keys(edited.derived.sections)[10];\n312:   const entry = edited.derived.sections[id];\n313:   const position = entry.body.indexOf('\\n') + 1;\n314:   const flipped = entry.body[position] === 'x' ? 'y' : 'x';\n315:   entry.body = `${entry.body.slice(0, position)}${flipped}${entry.body.slice(position + 1)}`;\n316:   fs.writeFileSync(copy, `${JSON.stringify(edited, null, 2)}\\n`);\n317: \n318:   const result = runGenerator(['--check', '--root', REPO_ROOT, '--manifest', copy]);\n319:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n320:   assert.match(`${result.err}${result.out}`, new RegExp(id), 'the failure names the section that drifted');\n321: });\n322: \n323: test('derived key: --write composes the same derived key and writes only the manifest', { skip: NOT_SOURCE }, (t) => {\n324:   const dir = scratch(t);\n325:   const copy = copyManifest(dir);\n326:   const writes = [];\n327:   const realWrite = fs.writeFileSync;\n328:   fs.writeFileSync = (file, ...rest) => {\n329:     writes.push(path.resolve(String(file)));\n330:     return realWrite(file, ...rest);\n331:   };\n332:   let code;\n333:   try {\n334:     code = main(['--write', '--root', REPO_ROOT, '--manifest', copy]);\n335:   } finally {\n336:     fs.writeFileSync = realWrite;\n337:   }\n338: \n339:   assert.equal(code, 0);\n340:   assert.deepEqual(writes, [path.resolve(copy)], 'exactly one path is written, and it is the manifest');\n341:   const written = JSON.parse(fs.readFileSync(copy, 'utf8'));\n342:   assert.deepEqual(written.derived.sections, manifest.derived.sections);\n343: });\n344: \n345: test('derived key: the router rows come from the router file', { skip: NOT_SOURCE }, () => {\n346:   const composed = composeDerived({ root: REPO_ROOT, manifest });\n347:   assert.equal(composed.ok, true, JSON.stringify(composed.errors));\n348:   assert.ok(composed.derived.repo_rules.trigger_rows.length >= 10, 'the trigger table is carried');\n349:   assert.ok(composed.derived.repo_rules.index_rows.length >= 10, 'the index table is carried');\n350:   assert.deepEqual(composed.derived.repo_rules, manifest.derived.repo_rules);\n351: });\n352: \n353: // ─────────────────────────────────────────────────────────────────────────────\n354: // 7. PINS AND THEIR CONSUMERS\n355: // ─────────────────────────────────────────────────────────────────────────────\n356: \n357: test('pins: every consumer file still holds the text its pin promises', () => {\n358:   assert.ok(manifest.pins.length >= 28, 'the pin set covers the canary strings, the delivery anchors and the tooling reads');\n359:   for (const pin of manifest.pins) {\n360:     const consumerPath = path.join(REPO_ROOT, pin.consumer);\n361:     assert.ok(fs.existsSync(consumerPath), `${pin.id}: consumer ${pin.consumer} exists`);\n362:     assert.ok(\n363:       Array.isArray(pin.consumer_evidence) && pin.consumer_evidence.length > 0,\n364:       `${pin.id}: names the evidence its consumer still holds`,\n365:     );\n366:     const consumerText = fs.readFileSync(consumerPath, 'utf8');\n367:     for (const evidence of pin.consumer_evidence) {\n368:       assert.equal(\n369:         consumerText.includes(evidence),\n370:         true,\n371:         `${pin.id}: ${pin.consumer} no longer holds ${JSON.stringify(evidence)}`,\n372:       );\n373:     }\n374:   }\n375: });\n376: \n377: // A pin whose text nobody reads is a stale copy waiting for a rename to pass unnoticed, so\n378: // the strings are checked where the document itself puts them, not just their consumers.\n379: test('pins: every pinned string still sits inside the section it names', { skip: NOT_SOURCE }, () => {\n380:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n381:   for (const pin of manifest.pins) {\n382:     if (!pin.section) continue;\n383:     const section = sections.find((candidate) => candidate.id === pin.section);\n384:     assert.ok(section, `${pin.id}: names a shipped section`);\n385:     for (const text of pin.texts) {\n386:       assert.equal(section.body.includes(text), true, `${pin.id}: ${pin.section} no longer holds ${JSON.stringify(text)}`);\n387:     }\n388:   }\n389: });\n390: \n391: test('pins: the rule-copy canary finds every AGENTS.md string inside the pin set', { skip: NOT_SOURCE }, (t) => {\n392:   const dir = scratch(t);\n393:   linkSkills(dir);\n394:   // Every pin text, one per line, and nothing else, so a canary string the pin set misses\n395:   // has no other place to come from.\n396:   fs.writeFileSync(path.join(dir, manifest.root_file), `${manifest.pins.flatMap((pin) => pin.texts).join('\\n')}\\n`);\n397: \n398:   const result = spawnSync(process.execPath, [CANARY, '--root', dir], { encoding: 'utf8' });\n399:   const output = `${result.stdout}${result.stderr}`;\n400:   assert.equal(result.status, 0, `the canary passes on the pin set alone:\\n${output}`);\n401:   assert.match(output, /OK: all rule invariants present/);\n402:   assert.doesNotMatch(output, /MISSING: AGENTS\\.md/);\n403: });\n404: \n405: test('pins: the gate 1 lookup first appears inside its named section', { skip: NOT_SOURCE }, () => {\n406:   const pin = manifest.pins.find((entry) => entry.id === 'gate1-lookup');\n407:   assert.ok(pin, 'the gate 1 lookup is a pin');\n408:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n409:   const gateOne = sections.find((section) => section.id === pin.section);\n410:   const first = Buffer.byteLength(rootText.slice(0, rootText.indexOf(pin.texts[0])), 'utf8');\n411:   assert.ok(first >= gateOne.start && first < gateOne.end, `first occurrence at ${first} sits inside ${pin.section}`);\n412: });\n413: \n414: test('pins: each delivery anchor ends inside the delivery prefix', { skip: NOT_SOURCE }, () => {\n415:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n416:   const anchors = manifest.pins.filter((pin) => pin.kind === 'delivery-anchor');\n417:   assert.equal(anchors.length, manifest.budget.anchor_count, 'the pinned anchor count matches the budget key');\n418: \n419:   let deepest = null;\n420:   for (const anchor of anchors) {\n421:     const end = anchorEndByte(anchor, sections);\n422:     assert.notEqual(end, null, `${anchor.id}: the anchor text is present in ${anchor.section}`);\n423:     assert.ok(end <= manifest.budget.prefix_bytes, `${anchor.id}: ends at ${end}, inside ${manifest.budget.prefix_bytes}`);\n424:     if (deepest === null || end > deepest.end) deepest = { id: anchor.id, end };\n425:   }\n426:   assert.equal(deepest.id, manifest.budget.last_anchor_id, 'the deepest anchor is the one the budget names');\n427:   assert.equal(deepest.id, 'anchor-blast-radius-management', 'the deepest anchor is the blast-radius section');\n428: });\n429: \n430: function anchorEndByte(anchor, sections) {\n431:   const section = sections.find((candidate) => candidate.id === anchor.section);\n432:   if (!section) return null;\n433:   if (anchor.scope !== 'line') return section.end;\n434: \n435:   let byte = section.start;\n436:   for (const line of section.body.split('\\n')) {\n437:     const next = byte + Buffer.byteLength(line, 'utf8') + 1;\n438:     if (line.includes(anchor.texts[0])) return next;\n439:     byte = next;\n440:   }\n441:   return null;\n442: }\n443: \n444: test('pins: the recorded delivery-prefix end is the one the canary reports', { skip: NOT_SOURCE }, () => {\n445:   const result = spawnSync(process.execPath, [CANARY], { encoding: 'utf8', cwd: REPO_ROOT });\n446:   assert.equal(result.status, 0, `the canary passes:\\n${result.stdout}${result.stderr}`);\n447: \n448:   const rows = result.stdout\n449:     .split('\\n')\n450:     .map((line) => line.match(/^\\s*(\\d+)\\s+(\\S.*)$/u))\n451:     .filter((match) => match !== null)\n452:     .map((match) => ({ bytes: Number(match[1]), text: match[2] }));\n453:   assert.ok(rows.length >= manifest.budget.anchor_count, 'the canary reports at least every pinned anchor');\n454: \n455:   const deepest = rows.reduce((best, row) => (best === null || row.bytes > best.bytes ? row : best), null);\n456:   assert.equal(deepest.text, '#### Blast-Radius Management', 'the deepest anchor is still the blast-radius clause');\n457:   assert.equal(deepest.bytes, manifest.derived.budget.prefix_end_bytes, 'the manifest records the byte the canary measured');\n458: });\n459: \n460: // ─────────────────────────────────────────────────────────────────────────────\n461: // 8. RELEASE-TAG HISTORY\n462: // ─────────────────────────────────────────────────────────────────────────────\n463: \n464: test('history: bodies are deduped by sha256 and never repeat a current body', () => {\n465:   const bodies = [\n466:     { body: '# One\\n', tag: 'v1' },\n467:     { body: '# One\\n', tag: 'v2' },\n468:     { body: '# Two\\n', tag: 'v3' },\n469:     { body: '# Two\\n', tag: 'v4' },\n470:   ];\n471:   const known = new Set([sha256('# Two\\n')]);\n472:   const deduped = dedupeBodies(bodies, known);\n473: \n474:   assert.equal(deduped.length, 1, 'a body given twice is stored once, and a current body is not stored at all');\n475:   assert.equal(deduped[0].sha256, sha256('# One\\n'));\n476:   assert.equal(deduped[0].first_tag, 'v1', 'the first tag that carried the body is recorded');\n477: });\n478: \n479: test('history: the derived key holds one entry per distinct body', { skip: NOT_SOURCE }, () => {\n480:   const history = manifest.derived.history;\n481:   console.log(`[agents-md-manifest] history bodies: ${history.length}, read from the last ${manifest.history.tags} release tags`);\n482: \n483:   const seen = new Set();\n484:   const current = new Set(Object.values(manifest.derived.sections).map((section) => section.sha256));\n485:   for (const entry of history) {\n486:     assert.equal(seen.has(entry.sha256), false, `history body ${entry.sha256} appears once`);\n487:     seen.add(entry.sha256);\n488:     assert.equal(sha256(entry.body), entry.sha256, 'the recorded hash is the body hash');\n489:     assert.equal(current.has(entry.sha256), false, 'a current body is not repeated in the history');\n490:   }\n491: });\n492: \n493: // A shallow CI checkout fetches no tags. Its empty tag list is not a release that dropped a\n494: // body, so the comparison is skipped there and the gate still passes; this reproduces that\n495: // checkout with the source origin and no tags at all.\n496: test('history: a checkout holding no release tags skips the comparison and passes', { skip: NOT_SOURCE }, (t) => {\n497:   const dir = scratch(t);\n498:   fs.copyFileSync(path.join(REPO_ROOT, manifest.root_file), path.join(dir, manifest.root_file));\n499:   fs.copyFileSync(path.join(REPO_ROOT, manifest.router_file), path.join(dir, manifest.router_file));\n500:   const copy = copyManifest(dir);\n501:   const git = (...args) => spawnSync('git', ['-C', dir, ...args], { encoding: 'utf8' });\n502: \n503:   const init = git('init', '--quiet');\n504:   assert.equal(init.status, 0, `a throwaway repository is initialised: ${init.stderr}`);\n505:   const remote = git('remote', 'add', 'origin', manifest.source_repository);\n506:   assert.equal(remote.status, 0, `the origin names the source repository: ${remote.stderr}`);\n507:   assert.equal(git('tag', '--list').stdout.trim(), '', 'the checkout holds no release tags');\n508: \n509:   const result = runGenerator(['--check', '--root', dir, '--manifest', copy]);\n510:   assert.equal(result.code, 0, `exit 0, stdout=${result.out} stderr=${result.err}`);\n511:   assert.match(result.out, /history was not compared because no release tags are available/);\n512:   assert.match(result.out, /PASS: 44 sections/);\n513: });\n514: \n515: // ─────────────────────────────────────────────────────────────────────────────\n516: // 9. CLASSIFIER\n517: // ─────────────────────────────────────────────────────────────────────────────\n518: \n519: test('classifier: a body is current, stale-known, edited or unknown-base', { skip: NOT_SOURCE }, () => {\n520:   const current = manifest.derived.sections['gate-1'];\n521:   const known = {\n522:     current: Object.entries(manifest.derived.sections).map(([id, entry]) => ({ id, sha256: entry.sha256, body: entry.body })),\n523:     history: manifest.derived.history,\n524:   };\n525: \n526:   assert.equal(classifyBody(current.body, known).state, 'current');\n527: \n528:   const stale = known.history[0];\n529:   const staleAnswer = classifyBody(stale.body, known);\n530:   assert.equal(staleAnswer.state, 'stale-known');\n531:   assert.equal(staleAnswer.base, stale.sha256);\n532: \n533:   const editedLines = current.body.split('\\n');\n534:   editedLines[1] = `- **Local tightening.** ${editedLines[1]}`;\n535:   const edited = classifyBody(editedLines.join('\\n'), known);\n536:   assert.equal(edited.state, 'edited', 'one changed line leaves the closest base identifiable');\n537:   assert.equal(edited.base, current.sha256);\n538: \n539:   assert.equal(classifyBody('# A document from somewhere else\\n\\nNothing shared here.\\n', known).state, 'unknown-base');\n540: });\n541: \n542: // ─────────────────────────────────────────────────────────────────────────────\n543: // 10. MANIFEST SHAPE AND THE TEMPLATE BLOCK\n544: // ─────────────────────────────────────────────────────────────────────────────\n545: \n546: test('manifest: every required key is present and the file sits at its documented path', () => {\n547:   for (const key of ['schema_version', 'source_repository', 'root_file', 'router_file', 'markers', 'budget', 'history', 'sections', 'pins', 'runtime_copies', 'derived']) {\n548:     assert.ok(Object.prototype.hasOwnProperty.call(manifest, key), `manifest key ${key}`);\n549:   }\n550:   assert.equal(manifest.sections.length, 44);\n551:   assert.equal(manifest.root_file, 'AGENTS.md');\n552:   assert.equal(fs.existsSync(path.join(REPO_ROOT, MANIFEST_RELATIVE)), true, 'the manifest lives at its documented path');\n553: });\n554: \n555: test('manifest: the template carries exactly one empty marked block after the last section', { skip: NOT_SOURCE }, () => {\n556:   assert.equal(rootText.split(manifest.markers.start).length - 1, 1, 'exactly one start marker');\n557:   assert.equal(rootText.split(manifest.markers.end).length - 1, 1, 'exactly one end marker');\n558:   assert.ok(rootText.indexOf(manifest.markers.start) < rootText.indexOf(manifest.markers.end), 'start before end');\n559: \n560:   const { sections, block } = segment(rootText, manifest.markers, manifest.sections);\n561:   assert.ok(block, 'the block is present');\n562:   assert.equal(block.complete, true, 'both markers are present and ordered');\n563:   assert.ok(sections[sections.length - 1].end <= block.start, 'the block sits after the last shipped section');\n564:   assert.deepEqual(blockLines(block.content), [manifest.markers.heading, manifest.markers.note], 'the shipped block is empty');\n565: });\n566: \n567: test('manifest: the measured budget is recorded and inside the canary ceiling', { skip: NOT_SOURCE }, () => {\n568:   const limits = readCanaryLimits();\n569:   assert.equal(limits.ok, true, `the canary's ceilings are readable: ${limits.reason}`);\n570:   assert.deepEqual(\n571:     Object.keys(manifest.budget).sort(),\n572:     ['anchor_count', 'last_anchor_id', 'max_bytes', 'prefix_bytes'],\n573:     'the authored budget names decisions; the document size is only ever measured',\n574:   );\n575:   assert.equal(manifest.budget.max_bytes, limits.maxBytes, 'the authored ceiling is the one the canary enforces');\n576: \n577:   const total = Buffer.byteLength(rootText, 'utf8');\n578:   assert.equal(manifest.derived.budget.total_bytes, total, 'the recorded document size is the live one');\n579:   assert.ok(total <= limits.maxBytes, `${total} bytes is inside the canary's ${limits.maxBytes}-byte ceiling`);\n580: \n581:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n582:   const blast = sections.find((section) => section.id === 'blast-radius');\n583:   assert.equal(manifest.derived.budget.prefix_end_bytes, blast.end, 'the recorded delivery-prefix end is the live one');\n584:   assert.ok(blast.end <= manifest.budget.prefix_bytes, `the delivery prefix ends at ${blast.end}, inside ${manifest.budget.prefix_bytes}`);\n585: });\n586: \n587: test('limits: the canary states the ceiling and the concepts the pins claim', { skip: NOT_SOURCE }, () => {\n588:   const limits = readCanaryLimits();\n589:   assert.equal(limits.ok, true, limits.reason);\n590:   assert.equal(manifest.budget.prefix_bytes, limits.prefixBytes, 'the authored delivery prefix is the canary prefixBytes');\n591: \n592:   const ceiling = manifest.pins.find((pin) => pin.id === 'max-bytes');\n593:   assert.equal(ceiling.limit_key, 'max_bytes', 'the byte-ceiling pin names the budget key it is about');\n594:   assert.ok(ceiling.texts.includes(String(limits.maxBytes)), 'the pinned text is the ceiling the canary enforces');\n595: \n596:   const ironLaw = manifest.pins.find((pin) => pin.id === 'iron-law');\n597:   for (const concept of limits.ironLawRequired) {\n598:     assert.ok(ironLaw.requires.includes(concept), `the iron law pin requires ${JSON.stringify(concept)}`);\n599:   }\n600: \n601:   assert.deepEqual(limitDrift(manifest, limits), [], 'the manifest and the canary agree today');\n602: });\n603: \n604: test('limits: a budget ceiling the canary does not state exits 1', { skip: NOT_SOURCE }, (t) => {\n605:   const dir = scratch(t);\n606:   const copy = copyManifest(dir);\n607:   const edited = JSON.parse(fs.readFileSync(copy, 'utf8'));\n608:   edited.budget.max_bytes = 40960;\n609:   fs.writeFileSync(copy, `${JSON.stringify(edited, null, 2)}\\n`);\n610: \n611:   const result = runGenerator(['--check', '--root', REPO_ROOT, '--manifest', copy]);\n612:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n613:   assert.match(`${result.err}${result.out}`, /max_bytes: the manifest states 40960, the canary enforces 32768/);\n614:   assert.doesNotMatch(result.err, /--write/, 'no regeneration is offered, because no write can change an authored ceiling');\n615: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-manifest.test.cjs, lines 1-615\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Manifest and Segmenter Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The manifest claims to hold the template a consumer receives, so its claims have to be\n8: // checkable without trusting the file that makes them: the segmenter must tile the root\n9: // document, the generator must refuse a surface it does not recognise, every pin's\n10: // consumer must still hold the text the pin promises, the authored ceilings must be the\n11: // ones the canary enforces, and the rule-copy canary must find its own AGENTS.md strings\n12: // inside the pin set alone.\n13: //\n14: // The suite ships with the manifest into consumer repositories, whose root AGENTS.md is\n15: // their own file. The cases that read this repository's root document are therefore\n16: // gated on the origin remote naming the manifest's source repository; everywhere else\n17: // they skip and print the reason, so a consumer sees why instead of a wall of failures.\n18: \n19: // ─────────────────────────────────────────────────────────────────────────────\n20: // 1. IMPORTS AND PATHS\n21: // ─────────────────────────────────────────────────────────────────────────────\n22: \n23: const assert = require('node:assert/strict');\n24: const { spawnSync } = require('node:child_process');\n25: const fs = require('node:fs');\n26: const os = require('node:os');\n27: const path = require('node:path');\n28: const test = require('node:test');\n29: \n30: const { classifyBody, matchSections, segment, sha256 } = require('../lib/agents-md-sections.cjs');\n31: const {\n32:   MANIFEST_PATH,\n33:   composeDerived,\n34:   dedupeBodies,\n35:   limitDrift,\n36:   main,\n37:   readCanaryLimits,\n38:   sourceStatus,\n39: } = require('../agents-md-manifest.cjs');\n40: \n41: const SCRIPTS_DIR = path.resolve(__dirname, '..');\n42: const REPO_ROOT = path.resolve(SCRIPTS_DIR, '../../../..');\n43: const GENERATOR = path.join(SCRIPTS_DIR, 'agents-md-manifest.cjs');\n44: const CANARY = path.join(REPO_ROOT, '.skilled/skills/sk-code/sk-code-review/scripts/check-rule-copies.js');\n45: const MANIFEST_RELATIVE = '.skilled/commands/doctor/assets/agents-md-manifest.json';\n46: \n47: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n48: const rootText = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n49: \n50: // One answer for every case that reads this repository's own root document.\n51: const source = sourceStatus({ root: REPO_ROOT, manifest });\n52: const NOT_SOURCE = source.isSource ? false : source.reason;\n53: \n54: // ─────────────────────────────────────────────────────────────────────────────\n55: // 2. HELPERS\n56: // ─────────────────────────────────────────────────────────────────────────────\n57: \n58: function runGenerator(args, env = process.env) {\n59:   const result = spawnSync(process.execPath, [GENERATOR, ...args], { encoding: 'utf8', env });\n60:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n61: }\n62: \n63: // A throwaway directory the case removes itself, so a failed assertion never leaves a\n64: // tree behind for the next run to read.\n65: function scratch(t) {\n66:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-manifest-'));\n67:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n68:   return dir;\n69: }\n70: \n71: function copyManifest(dir) {\n72:   const target = path.join(dir, 'agents-md-manifest.json');\n73:   fs.copyFileSync(MANIFEST_PATH, target);\n74:   return target;\n75: }\n76: \n77: // The canary resolves its other pins under --root, so a throwaway root still needs the\n78: // skill tree. A symlink keeps that free; a filesystem without symlinks falls back to a\n79: // copy that skips the installed packages.\n80: function linkSkills(tempRoot) {\n81:   try {\n82:     fs.symlinkSync(path.join(REPO_ROOT, '.skilled'), path.join(tempRoot, '.skilled'), 'dir');\n83:   } catch {\n84:     fs.cpSync(path.join(REPO_ROOT, '.skilled'), path.join(tempRoot, '.skilled'), {\n85:       recursive: true,\n86:       filter: (from) => !from.split(path.sep).includes('node_modules'),\n87:     });\n88:   }\n89: }\n90: \n91: function blockLines(content) {\n92:   return content\n93:     .split('\\n')\n94:     .map((line) => line.trim())\n95:     .filter((line) => line !== '');\n96: }\n97: \n98: function derivedOf(id) {\n99:   const entry = manifest.derived.sections[id];\n100:   assert.ok(entry, `the manifest's derived key holds section ${id}`);\n101:   return entry;\n102: }\n103: \n104: // ─────────────────────────────────────────────────────────────────────────────\n105: // 3. SOURCE-REPOSITORY GATE\n106: // ─────────────────────────────────────────────────────────────────────────────\n107: \n108: test('source gate: a foreign origin yields a skip reason that names it', () => {\n109:   const foreign = 'https://example.invalid/someone-else/their-fork.git';\n110:   const answer = sourceStatus({ root: REPO_ROOT, manifest, readOrigin: () => foreign });\n111: \n112:   assert.equal(answer.isSource, false);\n113:   assert.match(answer.reason, /example\\.invalid\\/someone-else\\/their-fork/, 'the reason names the origin it read');\n114:   assert.match(answer.reason, /manifest\\.source_repository/, 'the reason names what it compared against');\n115: });\n116: \n117: test('source gate: this worktree is the source repository', { skip: NOT_SOURCE }, () => {\n118:   assert.equal(source.isSource, true, `origin ${source.origin} matches the manifest`);\n119:   assert.match(source.identity, /^[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$/);\n120: });\n121: \n122: // ─────────────────────────────────────────────────────────────────────────────\n123: // 4. SEGMENTER\n124: // ─────────────────────────────────────────────────────────────────────────────\n125: \n126: test('segmenter: 44 sections tile the root document and their start bytes match the table', { skip: NOT_SOURCE }, () => {\n127:   const { sections, block } = segment(rootText, manifest.markers, manifest.sections);\n128:   assert.ok(block, 'the published template carries the repository block');\n129: \n130:   assert.equal(sections.length, 44, 'the shipped surface is 44 headings deep');\n131:   assert.equal(manifest.sections.length, 44, 'every authored entry is one shipped section');\n132:   assert.equal(sections[0].start, 0, 'the first section starts at byte 0');\n133: \n134:   for (let index = 0; index < sections.length; index += 1) {\n135:     const section = sections[index];\n136:     const recorded = derivedOf(section.id);\n137:     assert.equal(section.start, recorded.start, `section ${section.id}: start byte`);\n138:     assert.equal(section.end, recorded.end, `section ${section.id}: end byte`);\n139:     assert.equal(section.sha256, recorded.sha256, `section ${section.id}: body hash`);\n140:     assert.equal(section.body, recorded.body, `section ${section.id}: body`);\n141:     if (index > 0) {\n142:       assert.equal(section.start, sections[index - 1].end, `section ${section.id} starts where the previous one ends`);\n143:     }\n144:   }\n145:   assert.equal(sections[sections.length - 1].end, block.start, 'the last section runs to where the repository block begins');\n146: });\n147: \n148: test('segmenter: every authored match prefix finds exactly one section, at its heading', { skip: NOT_SOURCE }, () => {\n149:   const { sections } = segment(rootText, manifest.markers);\n150:   const { matched, unregistered, unmatched } = matchSections(sections, manifest.sections);\n151: \n152:   assert.deepEqual(unregistered, [], 'no heading is left unregistered');\n153:   assert.deepEqual(unmatched, [], 'no authored entry matches nothing');\n154:   assert.equal(matched.length, 44);\n155: \n156:   for (const row of matched) {\n157:     assert.equal(row.section.heading.includes(row.entry.match), true, `${row.entry.id}: the match prefix is part of the heading`);\n158:     assert.equal(row.entry.level, row.section.level, `${row.entry.id}: heading level`);\n159:   }\n160: });\n161: \n162: test('segmenter: the block heading is not a shipped section', () => {\n163:   const text = [\n164:     '# Root',\n165:     '',\n166:     '## Shipped section',\n167:     '',\n168:     'body line',\n169:     '',\n170:     manifest.markers.start,\n171:     manifest.markers.heading,\n172:     '',\n173:     manifest.markers.note,\n174:     manifest.markers.end,\n175:     '',\n176:   ].join('\\n');\n177:   const { sections, block } = segment(text, manifest.markers);\n178: \n179:   assert.equal(sections.length, 2, 'the block heading belongs to the block, not to the shipped surface');\n180:   assert.equal(block.complete, true);\n181:   assert.deepEqual(blockLines(block.content), [manifest.markers.heading, manifest.markers.note], 'the empty block holds no repository content');\n182:   assert.equal(sections[1].end, block.start, 'the last shipped section ends where the block begins');\n183: });\n184: \n185: // A repository documents the block by writing its markers inside a sentence. The same bytes\n186: // are the block's edge only when the line carries nothing else, because an edge in the\n187: // middle of a line leaves the text on either side in no section, in no prelude and in no\n188: // block, where a rewrite deletes it and nothing is left holding a claim about it.\n189: test('segmenter: a marker is the whole line, and the block reports the lines it owns', () => {\n190:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n191:   const quoted = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n192: \n193:   const prose = segment(`${shipped}${quoted}\\n`, manifest.markers, manifest.sections);\n194:   assert.equal(prose.block, null, 'prose that quotes both markers is not a block');\n195:   assert.ok(prose.sections[prose.sections.length - 1].body.includes(quoted), 'the sentence is a line of the section it ends');\n196:   assert.equal(prose.prelude, null, 'nothing sits above the first heading');\n197: \n198:   // Whitespace around a marker does not stop it being one, and the block names the line\n199:   // range it owns so a caller that reports where it sits has the figure already.\n200:   const block = [`  ${manifest.markers.start}`, manifest.markers.heading, '', manifest.markers.note, `  ${manifest.markers.end}`, ''].join('\\n');\n201:   const found = segment(`${shipped}${block}`, manifest.markers);\n202:   assert.equal(found.block.complete, true, 'an indented marker line is still a marker line');\n203:   assert.equal(found.block.markerLines.start.length, 1);\n204:   assert.equal(found.block.rows.last - found.block.rows.first + 1, block.split('\\n').length - 1, 'the block owns its five lines, markers included');\n205: });\n206: \n207: // ─────────────────────────────────────────────────────────────────────────────\n208: // 5. GENERATOR REFUSALS\n209: // ─────────────────────────────────────────────────────────────────────────────\n210: \n211: test('generator refusal: a heading no authored entry matches exits 1 and names it', (t) => {\n212:   const dir = scratch(t);\n213:   // Inside the shipped surface, above the repository block: a heading added there would\n214:   // be dropped from every consumer's template at the next release.\n215:   const at = rootText.indexOf(manifest.markers.start);\n216:   const injected = `${rootText.slice(0, at)}#### A Heading The Template Never Shipped\\n\\n${rootText.slice(at)}`;\n217:   fs.writeFileSync(path.join(dir, manifest.root_file), injected);\n218:   const result = runGenerator(['--check', '--root', dir]);\n219: \n220:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n221:   assert.match(`${result.err}${result.out}`, /A Heading The Template Never Shipped/);\n222:   assert.match(`${result.err}${result.out}`, /unregistered/i);\n223: });\n224: \n225: test('generator refusal: an authored entry that matches nothing exits 1 and names it', (t) => {\n226:   const dir = scratch(t);\n227:   const copy = copyManifest(dir);\n228:   const edited = JSON.parse(fs.readFileSync(copy, 'utf8'));\n229:   edited.sections.push({ id: 'a-section-that-does-not-exist', match: '#### Never Written', level: 4, parent: 'four-laws' });\n230:   fs.writeFileSync(copy, `${JSON.stringify(edited, null, 2)}\\n`);\n231: \n232:   const result = runGenerator(['--check', '--root', REPO_ROOT, '--manifest', copy]);\n233:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n234:   assert.match(`${result.err}${result.out}`, /a-section-that-does-not-exist/);\n235:   assert.match(`${result.err}${result.out}`, /no heading matches/i);\n236: });\n237: \n238: test('generator: a missing root file exits 2 with a named cause and writes nothing', (t) => {\n239:   const dir = scratch(t);\n240:   const copy = copyManifest(dir);\n241:   const before = fs.readFileSync(copy, 'utf8');\n242:   const result = runGenerator(['--check', '--root', dir, '--manifest', copy]);\n243: \n244:   assert.equal(result.code, 2, `exit 2, stdout=${result.out} stderr=${result.err}`);\n245:   assert.match(`${result.err}${result.out}`, /AGENTS\\.md/);\n246:   assert.equal(fs.readFileSync(copy, 'utf8'), before, 'the manifest is untouched');\n247: });\n248: \n249: // Text above the first heading belongs to no section, so no derived body can carry it and\n250: // a `--write` would persist a copy of the template that quietly omits the line. The check\n251: // engine reports that text; the generator has to refuse it for the same reason.\n252: test('generator refusal: text above the first heading exits 1 and names the line', (t) => {\n253:   const dir = scratch(t);\n254:   const template = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n255:   const line = 'Read this first: the harness ships these instructions.';\n256:   fs.writeFileSync(path.join(dir, manifest.root_file), `${line}\\n${template}`);\n257: \n258:   const composed = composeDerived({ root: dir, manifest, history: [] });\n259:   assert.equal(composed.ok, false, 'a template with a prelude is not the clean surface the derived key describes');\n260:   const prelude = (composed.errors || []).find((error) => error.code === 'unmarked-prelude');\n261:   assert.ok(prelude, `the refusal names the text above the first heading: ${JSON.stringify(composed.errors)}`);\n262:   assert.match(prelude.message, /before its first heading/u);\n263:   assert.match(prelude.message, /line 1\\b/u, 'the message names the line it sits on');\n264:   assert.ok(prelude.message.includes(line), 'and carries the line itself');\n265: \n266:   const result = runGenerator(['--check', '--root', dir]);\n267:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n268:   assert.match(`${result.err}${result.out}`, /unmarked-prelude/u);\n269:   assert.match(`${result.err}${result.out}`, /before its first heading/u);\n270: });\n271: \n272: test('generator: --write outside the source repository exits 2 and names the origin', (t) => {\n273:   const dir = scratch(t);\n274:   const copy = copyManifest(dir);\n275:   const before = fs.readFileSync(copy, 'utf8');\n276:   const result = runGenerator(['--write', '--root', dir, '--manifest', copy]);\n277: \n278:   assert.equal(result.code, 2, `exit 2, stdout=${result.out} stderr=${result.err}`);\n279:   assert.match(`${result.err}${result.out}`, /source repository/);\n280:   assert.equal(fs.readFileSync(copy, 'utf8'), before, 'the manifest is untouched');\n281: });\n282: \n283: test('generator: a CI job names its own checkout, so another root is still refused', (t) => {\n284:   const dir = scratch(t);\n285:   const copy = copyManifest(dir);\n286:   const env = {\n287:     ...process.env,\n288:     GITHUB_REPOSITORY: manifest.source_repository.replace(/^https:\\/\\/github\\.com\\//, ''),\n289:     GITHUB_WORKSPACE: REPO_ROOT,\n290:   };\n291:   const result = runGenerator(['--write', '--root', dir, '--manifest', copy], env);\n292: \n293:   assert.equal(result.code, 2, `exit 2, stdout=${result.out} stderr=${result.err}`);\n294:   assert.match(`${result.err}${result.out}`, /source repository/);\n295: });\n296: \n297: // ─────────────────────────────────────────────────────────────────────────────\n298: // 6. DERIVED KEY FRESHNESS\n299: // ─────────────────────────────────────────────────────────────────────────────\n300: \n301: test('derived key: --check passes and names the section and pin counts', { skip: NOT_SOURCE }, () => {\n302:   const result = runGenerator(['--check']);\n303:   assert.equal(result.code, 0, `exit 0, stdout=${result.out} stderr=${result.err}`);\n304:   assert.match(result.out, new RegExp(`PASS: 44 sections, ${manifest.pins.length} pins, derived matches AGENTS\\\\.md`));\n305: });\n306: \n307: test('derived key: a one-byte edit to a copy of a derived body exits 1', (t) => {\n308:   const dir = scratch(t);\n309:   const copy = copyManifest(dir);\n310:   const edited = JSON.parse(fs.readFileSync(copy, 'utf8'));\n311:   const id = Object.keys(edited.derived.sections)[10];\n312:   const entry = edited.derived.sections[id];\n313:   const position = entry.body.indexOf('\\n') + 1;\n314:   const flipped = entry.body[position] === 'x' ? 'y' : 'x';\n315:   entry.body = `${entry.body.slice(0, position)}${flipped}${entry.body.slice(position + 1)}`;\n316:   fs.writeFileSync(copy, `${JSON.stringify(edited, null, 2)}\\n`);\n317: \n318:   const result = runGenerator(['--check', '--root', REPO_ROOT, '--manifest', copy]);\n319:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n320:   assert.match(`${result.err}${result.out}`, new RegExp(id), 'the failure names the section that drifted');\n321: });\n322: \n323: test('derived key: --write composes the same derived key and writes only the manifest', { skip: NOT_SOURCE }, (t) => {\n324:   const dir = scratch(t);\n325:   const copy = copyManifest(dir);\n326:   const writes = [];\n327:   const realWrite = fs.writeFileSync;\n328:   fs.writeFileSync = (file, ...rest) => {\n329:     writes.push(path.resolve(String(file)));\n330:     return realWrite(file, ...rest);\n331:   };\n332:   let code;\n333:   try {\n334:     code = main(['--write', '--root', REPO_ROOT, '--manifest', copy]);\n335:   } finally {\n336:     fs.writeFileSync = realWrite;\n337:   }\n338: \n339:   assert.equal(code, 0);\n340:   assert.deepEqual(writes, [path.resolve(copy)], 'exactly one path is written, and it is the manifest');\n341:   const written = JSON.parse(fs.readFileSync(copy, 'utf8'));\n342:   assert.deepEqual(written.derived.sections, manifest.derived.sections);\n343: });\n344: \n345: test('derived key: the router rows come from the router file', { skip: NOT_SOURCE }, () => {\n346:   const composed = composeDerived({ root: REPO_ROOT, manifest });\n347:   assert.equal(composed.ok, true, JSON.stringify(composed.errors));\n348:   assert.ok(composed.derived.repo_rules.trigger_rows.length >= 10, 'the trigger table is carried');\n349:   assert.ok(composed.derived.repo_rules.index_rows.length >= 10, 'the index table is carried');\n350:   assert.deepEqual(composed.derived.repo_rules, manifest.derived.repo_rules);\n351: });\n352: \n353: // ─────────────────────────────────────────────────────────────────────────────\n354: // 7. PINS AND THEIR CONSUMERS\n355: // ─────────────────────────────────────────────────────────────────────────────\n356: \n357: test('pins: every consumer file still holds the text its pin promises', () => {\n358:   assert.ok(manifest.pins.length >= 28, 'the pin set covers the canary strings, the delivery anchors and the tooling reads');\n359:   for (const pin of manifest.pins) {\n360:     const consumerPath = path.join(REPO_ROOT, pin.consumer);\n361:     assert.ok(fs.existsSync(consumerPath), `${pin.id}: consumer ${pin.consumer} exists`);\n362:     assert.ok(\n363:       Array.isArray(pin.consumer_evidence) && pin.consumer_evidence.length > 0,\n364:       `${pin.id}: names the evidence its consumer still holds`,\n365:     );\n366:     const consumerText = fs.readFileSync(consumerPath, 'utf8');\n367:     for (const evidence of pin.consumer_evidence) {\n368:       assert.equal(\n369:         consumerText.includes(evidence),\n370:         true,\n371:         `${pin.id}: ${pin.consumer} no longer holds ${JSON.stringify(evidence)}`,\n372:       );\n373:     }\n374:   }\n375: });\n376: \n377: // A pin whose text nobody reads is a stale copy waiting for a rename to pass unnoticed, so\n378: // the strings are checked where the document itself puts them, not just their consumers.\n379: test('pins: every pinned string still sits inside the section it names', { skip: NOT_SOURCE }, () => {\n380:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n381:   for (const pin of manifest.pins) {\n382:     if (!pin.section) continue;\n383:     const section = sections.find((candidate) => candidate.id === pin.section);\n384:     assert.ok(section, `${pin.id}: names a shipped section`);\n385:     for (const text of pin.texts) {\n386:       assert.equal(section.body.includes(text), true, `${pin.id}: ${pin.section} no longer holds ${JSON.stringify(text)}`);\n387:     }\n388:   }\n389: });\n390: \n391: test('pins: the rule-copy canary finds every AGENTS.md string inside the pin set', { skip: NOT_SOURCE }, (t) => {\n392:   const dir = scratch(t);\n393:   linkSkills(dir);\n394:   // Every pin text, one per line, and nothing else, so a canary string the pin set misses\n395:   // has no other place to come from.\n396:   fs.writeFileSync(path.join(dir, manifest.root_file), `${manifest.pins.flatMap((pin) => pin.texts).join('\\n')}\\n`);\n397: \n398:   const result = spawnSync(process.execPath, [CANARY, '--root', dir], { encoding: 'utf8' });\n399:   const output = `${result.stdout}${result.stderr}`;\n400:   assert.equal(result.status, 0, `the canary passes on the pin set alone:\\n${output}`);\n401:   assert.match(output, /OK: all rule invariants present/);\n402:   assert.doesNotMatch(output, /MISSING: AGENTS\\.md/);\n403: });\n404: \n405: test('pins: the gate 1 lookup first appears inside its named section', { skip: NOT_SOURCE }, () => {\n406:   const pin = manifest.pins.find((entry) => entry.id === 'gate1-lookup');\n407:   assert.ok(pin, 'the gate 1 lookup is a pin');\n408:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n409:   const gateOne = sections.find((section) => section.id === pin.section);\n410:   const first = Buffer.byteLength(rootText.slice(0, rootText.indexOf(pin.texts[0])), 'utf8');\n411:   assert.ok(first >= gateOne.start && first < gateOne.end, `first occurrence at ${first} sits inside ${pin.section}`);\n412: });\n413: \n414: test('pins: each delivery anchor ends inside the delivery prefix', { skip: NOT_SOURCE }, () => {\n415:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n416:   const anchors = manifest.pins.filter((pin) => pin.kind === 'delivery-anchor');\n417:   assert.equal(anchors.length, manifest.budget.anchor_count, 'the pinned anchor count matches the budget key');\n418: \n419:   let deepest = null;\n420:   for (const anchor of anchors) {\n421:     const end = anchorEndByte(anchor, sections);\n422:     assert.notEqual(end, null, `${anchor.id}: the anchor text is present in ${anchor.section}`);\n423:     assert.ok(end <= manifest.budget.prefix_bytes, `${anchor.id}: ends at ${end}, inside ${manifest.budget.prefix_bytes}`);\n424:     if (deepest === null || end > deepest.end) deepest = { id: anchor.id, end };\n425:   }\n426:   assert.equal(deepest.id, manifest.budget.last_anchor_id, 'the deepest anchor is the one the budget names');\n427:   assert.equal(deepest.id, 'anchor-blast-radius-management', 'the deepest anchor is the blast-radius section');\n428: });\n429: \n430: function anchorEndByte(anchor, sections) {\n431:   const section = sections.find((candidate) => candidate.id === anchor.section);\n432:   if (!section) return null;\n433:   if (anchor.scope !== 'line') return section.end;\n434: \n435:   let byte = section.start;\n436:   for (const line of section.body.split('\\n')) {\n437:     const next = byte + Buffer.byteLength(line, 'utf8') + 1;\n438:     if (line.includes(anchor.texts[0])) return next;\n439:     byte = next;\n440:   }\n441:   return null;\n442: }\n443: \n444: test('pins: the recorded delivery-prefix end is the one the canary reports', { skip: NOT_SOURCE }, () => {\n445:   const result = spawnSync(process.execPath, [CANARY], { encoding: 'utf8', cwd: REPO_ROOT });\n446:   assert.equal(result.status, 0, `the canary passes:\\n${result.stdout}${result.stderr}`);\n447: \n448:   const rows = result.stdout\n449:     .split('\\n')\n450:     .map((line) => line.match(/^\\s*(\\d+)\\s+(\\S.*)$/u))\n451:     .filter((match) => match !== null)\n452:     .map((match) => ({ bytes: Number(match[1]), text: match[2] }));\n453:   assert.ok(rows.length >= manifest.budget.anchor_count, 'the canary reports at least every pinned anchor');\n454: \n455:   const deepest = rows.reduce((best, row) => (best === null || row.bytes > best.bytes ? row : best), null);\n456:   assert.equal(deepest.text, '#### Blast-Radius Management', 'the deepest anchor is still the blast-radius clause');\n457:   assert.equal(deepest.bytes, manifest.derived.budget.prefix_end_bytes, 'the manifest records the byte the canary measured');\n458: });\n459: \n460: // ─────────────────────────────────────────────────────────────────────────────\n461: // 8. RELEASE-TAG HISTORY\n462: // ─────────────────────────────────────────────────────────────────────────────\n463: \n464: test('history: bodies are deduped by sha256 and never repeat a current body', () => {\n465:   const bodies = [\n466:     { body: '# One\\n', tag: 'v1' },\n467:     { body: '# One\\n', tag: 'v2' },\n468:     { body: '# Two\\n', tag: 'v3' },\n469:     { body: '# Two\\n', tag: 'v4' },\n470:   ];\n471:   const known = new Set([sha256('# Two\\n')]);\n472:   const deduped = dedupeBodies(bodies, known);\n473: \n474:   assert.equal(deduped.length, 1, 'a body given twice is stored once, and a current body is not stored at all');\n475:   assert.equal(deduped[0].sha256, sha256('# One\\n'));\n476:   assert.equal(deduped[0].first_tag, 'v1', 'the first tag that carried the body is recorded');\n477: });\n478: \n479: test('history: the derived key holds one entry per distinct body', { skip: NOT_SOURCE }, () => {\n480:   const history = manifest.derived.history;\n481:   console.log(`[agents-md-manifest] history bodies: ${history.length}, read from the last ${manifest.history.tags} release tags`);\n482: \n483:   const seen = new Set();\n484:   const current = new Set(Object.values(manifest.derived.sections).map((section) => section.sha256));\n485:   for (const entry of history) {\n486:     assert.equal(seen.has(entry.sha256), false, `history body ${entry.sha256} appears once`);\n487:     seen.add(entry.sha256);\n488:     assert.equal(sha256(entry.body), entry.sha256, 'the recorded hash is the body hash');\n489:     assert.equal(current.has(entry.sha256), false, 'a current body is not repeated in the history');\n490:   }\n491: });\n492: \n493: // A shallow CI checkout fetches no tags. Its empty tag list is not a release that dropped a\n494: // body, so the comparison is skipped there and the gate still passes; this reproduces that\n495: // checkout with the source origin and no tags at all.\n496: test('history: a checkout holding no release tags skips the comparison and passes', { skip: NOT_SOURCE }, (t) => {\n497:   const dir = scratch(t);\n498:   fs.copyFileSync(path.join(REPO_ROOT, manifest.root_file), path.join(dir, manifest.root_file));\n499:   fs.copyFileSync(path.join(REPO_ROOT, manifest.router_file), path.join(dir, manifest.router_file));\n500:   const copy = copyManifest(dir);\n501:   const git = (...args) => spawnSync('git', ['-C', dir, ...args], { encoding: 'utf8' });\n502: \n503:   const init = git('init', '--quiet');\n504:   assert.equal(init.status, 0, `a throwaway repository is initialised: ${init.stderr}`);\n505:   const remote = git('remote', 'add', 'origin', manifest.source_repository);\n506:   assert.equal(remote.status, 0, `the origin names the source repository: ${remote.stderr}`);\n507:   assert.equal(git('tag', '--list').stdout.trim(), '', 'the checkout holds no release tags');\n508: \n509:   const result = runGenerator(['--check', '--root', dir, '--manifest', copy]);\n510:   assert.equal(result.code, 0, `exit 0, stdout=${result.out} stderr=${result.err}`);\n511:   assert.match(result.out, /history was not compared because no release tags are available/);\n512:   assert.match(result.out, /PASS: 44 sections/);\n513: });\n514: \n515: // ─────────────────────────────────────────────────────────────────────────────\n516: // 9. CLASSIFIER\n517: // ─────────────────────────────────────────────────────────────────────────────\n518: \n519: test('classifier: a body is current, stale-known, edited or unknown-base', { skip: NOT_SOURCE }, () => {\n520:   const current = manifest.derived.sections['gate-1'];\n521:   const known = {\n522:     current: Object.entries(manifest.derived.sections).map(([id, entry]) => ({ id, sha256: entry.sha256, body: entry.body })),\n523:     history: manifest.derived.history,\n524:   };\n525: \n526:   assert.equal(classifyBody(current.body, known).state, 'current');\n527: \n528:   const stale = known.history[0];\n529:   const staleAnswer = classifyBody(stale.body, known);\n530:   assert.equal(staleAnswer.state, 'stale-known');\n531:   assert.equal(staleAnswer.base, stale.sha256);\n532: \n533:   const editedLines = current.body.split('\\n');\n534:   editedLines[1] = `- **Local tightening.** ${editedLines[1]}`;\n535:   const edited = classifyBody(editedLines.join('\\n'), known);\n536:   assert.equal(edited.state, 'edited', 'one changed line leaves the closest base identifiable');\n537:   assert.equal(edited.base, current.sha256);\n538: \n539:   assert.equal(classifyBody('# A document from somewhere else\\n\\nNothing shared here.\\n', known).state, 'unknown-base');\n540: });\n541: \n542: // ─────────────────────────────────────────────────────────────────────────────\n543: // 10. MANIFEST SHAPE AND THE TEMPLATE BLOCK\n544: // ─────────────────────────────────────────────────────────────────────────────\n545: \n546: test('manifest: every required key is present and the file sits at its documented path', () => {\n547:   for (const key of ['schema_version', 'source_repository', 'root_file', 'router_file', 'markers', 'budget', 'history', 'sections', 'pins', 'runtime_copies', 'derived']) {\n548:     assert.ok(Object.prototype.hasOwnProperty.call(manifest, key), `manifest key ${key}`);\n549:   }\n550:   assert.equal(manifest.sections.length, 44);\n551:   assert.equal(manifest.root_file, 'AGENTS.md');\n552:   assert.equal(fs.existsSync(path.join(REPO_ROOT, MANIFEST_RELATIVE)), true, 'the manifest lives at its documented path');\n553: });\n554: \n555: test('manifest: the template carries exactly one empty marked block after the last section', { skip: NOT_SOURCE }, () => {\n556:   assert.equal(rootText.split(manifest.markers.start).length - 1, 1, 'exactly one start marker');\n557:   assert.equal(rootText.split(manifest.markers.end).length - 1, 1, 'exactly one end marker');\n558:   assert.ok(rootText.indexOf(manifest.markers.start) < rootText.indexOf(manifest.markers.end), 'start before end');\n559: \n560:   const { sections, block } = segment(rootText, manifest.markers, manifest.sections);\n561:   assert.ok(block, 'the block is present');\n562:   assert.equal(block.complete, true, 'both markers are present and ordered');\n563:   assert.ok(sections[sections.length - 1].end <= block.start, 'the block sits after the last shipped section');\n564:   assert.deepEqual(blockLines(block.content), [manifest.markers.heading, manifest.markers.note], 'the shipped block is empty');\n565: });\n566: \n567: test('manifest: the measured budget is recorded and inside the canary ceiling', { skip: NOT_SOURCE }, () => {\n568:   const limits = readCanaryLimits();\n569:   assert.equal(limits.ok, true, `the canary's ceilings are readable: ${limits.reason}`);\n570:   assert.deepEqual(\n571:     Object.keys(manifest.budget).sort(),\n572:     ['anchor_count', 'last_anchor_id', 'max_bytes', 'prefix_bytes'],\n573:     'the authored budget names decisions; the document size is only ever measured',\n574:   );\n575:   assert.equal(manifest.budget.max_bytes, limits.maxBytes, 'the authored ceiling is the one the canary enforces');\n576: \n577:   const total = Buffer.byteLength(rootText, 'utf8');\n578:   assert.equal(manifest.derived.budget.total_bytes, total, 'the recorded document size is the live one');\n579:   assert.ok(total <= limits.maxBytes, `${total} bytes is inside the canary's ${limits.maxBytes}-byte ceiling`);\n580: \n581:   const { sections } = segment(rootText, manifest.markers, manifest.sections);\n582:   const blast = sections.find((section) => section.id === 'blast-radius');\n583:   assert.equal(manifest.derived.budget.prefix_end_bytes, blast.end, 'the recorded delivery-prefix end is the live one');\n584:   assert.ok(blast.end <= manifest.budget.prefix_bytes, `the delivery prefix ends at ${blast.end}, inside ${manifest.budget.prefix_bytes}`);\n585: });\n586: \n587: test('limits: the canary states the ceiling and the concepts the pins claim', { skip: NOT_SOURCE }, () => {\n588:   const limits = readCanaryLimits();\n589:   assert.equal(limits.ok, true, limits.reason);\n590:   assert.equal(manifest.budget.prefix_bytes, limits.prefixBytes, 'the authored delivery prefix is the canary prefixBytes');\n591: \n592:   const ceiling = manifest.pins.find((pin) => pin.id === 'max-bytes');\n593:   assert.equal(ceiling.limit_key, 'max_bytes', 'the byte-ceiling pin names the budget key it is about');\n594:   assert.ok(ceiling.texts.includes(String(limits.maxBytes)), 'the pinned text is the ceiling the canary enforces');\n595: \n596:   const ironLaw = manifest.pins.find((pin) => pin.id === 'iron-law');\n597:   for (const concept of limits.ironLawRequired) {\n598:     assert.ok(ironLaw.requires.includes(concept), `the iron law pin requires ${JSON.stringify(concept)}`);\n599:   }\n600: \n601:   assert.deepEqual(limitDrift(manifest, limits), [], 'the manifest and the canary agree today');\n602: });\n603: \n604: test('limits: a budget ceiling the canary does not state exits 1', { skip: NOT_SOURCE }, (t) => {\n605:   const dir = scratch(t);\n606:   const copy = copyManifest(dir);\n607:   const edited = JSON.parse(fs.readFileSync(copy, 'utf8'));\n608:   edited.budget.max_bytes = 40960;\n609:   fs.writeFileSync(copy, `${JSON.stringify(edited, null, 2)}\\n`);\n610: \n611:   const result = runGenerator(['--check', '--root', REPO_ROOT, '--manifest', copy]);\n612:   assert.equal(result.code, 1, `exit 1, stdout=${result.out} stderr=${result.err}`);\n613:   assert.match(`${result.err}${result.out}`, /max_bytes: the manifest states 40960, the canary enforces 32768/);\n614:   assert.doesNotMatch(result.err, /--write/, 'no regeneration is offered, because no write can change an authored ceiling');\n615: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-manifest.test.cjs\"}"},"time":{"start":1794582814133,"end":1794582814584}}}}
{"type":"step_finish","timestamp":1794582815638,"sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","part":{"id":"prt_1d578a3960015927J2mZXKap6C","sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","messageID":"msg_1d5784ad3001rHT6e1nQMoOFnz","type":"step-finish","reason":"tool-calls","cost":0,"tokens":{"input":21028,"output":99,"reasoning":89,"cache":{"read":12288,"write":0}}}}
{"type":"step_start","timestamp":1794582820888,"sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","part":{"id":"prt_1d578b818001JZFQlQ8Uix2wNw","sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","messageID":"msg_1d578a39a0017YiM5ANudae38e","type":"step-start"}}
{"type":"text","timestamp":1794582824228,"sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","part":{"id":"prt_1d578bfaa001fITB90Kdwatakm","sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","messageID":"msg_1d578a39a0017YiM5ANudae38e","type":"text","text":"Let me inspect the gate-2 section body in the manifest and check the current test baseline.","time":{"start":1794582822826,"end":1794582824228}}}
{"type":"tool_use","timestamp":1794582824260,"sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","part":{"partID":"prt_1d578c0b30012y7AiyVnkU0N7U","sessionID":"ses_e2a8827d0ffeR60t4dE0x3uqVG","messageID":"msg_1d578a39a0017YiM5ANudae38e","type":"tool","id":"call_7098b68cc1234acda1f8ecdb","tool":"shell","state":{"status":"completed","input":{"command":"jq -r '.derived.sections[\"gate-2\"].body' .skilled/commands/doctor/assets/agents-md-manifest.json","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"#### GATE 2: SKILL ROUTING [REQUIRED for non-trivial tasks]\n1. A) Primary: use the Skill Advisor Hook brief the runtime surfaced, when present. See `.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md`.\n2. B) Direct call: run `node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"[request]\"}' --format json` when no hook brief is present or when diagnosing hook behavior.\n3. C) Cite user's explicit direction: \"User specified: [exact quote]\"\n- Confidence ≥ 0.8 → MUST invoke skill | < 0.8 → general approach | User names skill → cite and proceed\n- **Command in the brief.** A brief or advisor result that names a command offers its workflow beside the skill's. Take either path whole, never an improvised one. To take the command, read its document in full and follow it. `run` starts it now. `start` starts it without `:auto`, so its setup asks. `ask` offers it in one question and waits. A typed command or explicit instruction outranks the policy. Output: `COMMAND: [/name] → [started|offered|declined]`\n- **Artifact trigger — binds on what you write, regardless of the advisor score.** Before the FIRST code write, route through `sk-code`. Before the FIRST `.md` write, route through `sk-doc`, except spec-folder docs (`system-spec-kit`'s) and the gitignored runtime state Gate 3 exempts, which no skill owns. Routing means loading what its ROUTER.md resolves, per Gate 5's loading rule. A skill already in context is not re-read. A resolved contract wrong for this case is followed and amended, per PLAN-WORKFLOW LOCK step 4.\n- Output: `SKILL ROUTING: [result]` or `SKILL ROUTING: User directed → [name]`; when the artifact trigger fires, add `ARTIFACT: [skill] → [what its router resolved]`\n- Skip: trivial queries only (greetings, single-line questions). The artifact trigger skips only the §6 exemption class.\n\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#### GATE 2: SKILL ROUTING [REQUIRED for non-trivial tasks]\n1. A) Primary: use the Skill Advisor Hook brief the runtime surfaced, when present. See `.skilled/skills/system-skill-advisor/hooks/skill-advisor-hook.md`.\n2. B) Direct call: run `node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"[request]\"}' --format json` when no hook brief is present or when diagnosing hook behavior.\n3. C) Cite user's explicit direction: \"User specified: [exact quote]\"\n- Confidence ≥ 0.8 → MUST invoke skill | < 0.8 → general approach | User names skill → cite and proceed\n- **Command in the brief.** A brief or advisor result that names a command offers its workflow beside the skill's. Take either path whole, never an improvised one. To take the command, read its document in full and follow it. `run` starts it now. `start` starts it without `:auto`, so its setup asks. `ask` offers it in one question and waits. A typed command or explicit instruction outranks the policy. Output: `COMMAND: [/name] → [started|offered|declined]`\n- **Artifact trigger — binds on what you write, regardless of the advisor score.** Before the FIRST code write, route through `sk-code`. Before the FIRST `.md` write, route through `sk-doc`, except spec-folder docs (`system-spec-kit`'s) and the gitignored runtime state Gate 3 exempts, which no skill owns. Routing means loading what its ROUTER.md resolves, per Gate 5's loading rule. A skill already in context is not re-read. A resolved contract wrong for this case is followed and amended, per PLAN-WORKFLOW LOCK step 4.\n- Output: `SKILL ROUTING: [result]` or `SKILL ROUTING: User directed → [name]`; when the artifact trigger fires, add `ARTIFACT: [skill] → [what its router resolved]`\n- Skip: trivial queries only (greetings, single-line questions). The artifact trigger skips only the §6 exemption class.\n\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"jq -r '.derived.sections[\\\"gate-2\\\"].body' .skilled/commands/doctor/assets/agents-md-manifest.json\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794582823091,"end":1794582824260}}}}
