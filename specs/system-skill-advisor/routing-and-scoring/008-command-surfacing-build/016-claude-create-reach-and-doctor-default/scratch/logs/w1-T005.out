{"type":"tool_use","timestamp":1794582799412,"sessionID":"ses_e2a8827beffe2WRM5fapKnxmNx","part":{"partID":"prt_1d57862f50028fMqhS0Xwr3ihj","sessionID":"ses_e2a8827beffe2WRM5fapKnxmNx","messageID":"msg_1d5785be40012PpYukfhFlggdM","type":"tool","id":"call_00_8uTPyxldk2RCL1KGbRuF8603","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-auto.yaml"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-auto.yaml, lines 1-596\n1: # ─────────────────────────────────────────────────────────────────\n2: # OPENCODE CREATE: SK-SKILL UNIFIED WORKFLOW (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # Mode: autonomous execution (no approval checkpoints)\n5: # Entrypoint: /create:skill\n6: # Operations: full-create | full-update | reference-only | asset-only\n7: # ─────────────────────────────────────────────────────────────────\n8: \n9: role: Unified Skill Creator using sk-doc\n10: purpose: Execute a canonical autonomous workflow for skill creation and skill document updates\n11: action: Route one operation branch with shared gates, validation, and context persistence\n12: \n13: # ─────────────────────────────────────────────────────────────────\n14: # PREREQUISITE: @markdown AGENT VERIFICATION\n15: # ─────────────────────────────────────────────────────────────────\n16: # This workflow REQUIRES the @markdown agent for:\n17: #   - Template-first generation\n18: #   - sk-doc standards enforcement\n19: #   - Root document validation\n20: #\n21: # The command markdown verifies the @markdown agent BEFORE\n22: # this YAML workflow loads. If you are executing this workflow,\n23: # @markdown verification has already passed.\n24: # ─────────────────────────────────────────────────────────────────\n25: \n26: operating_mode:\n27:   workflow: unified_7_step\n28:   workflow_compliance: MANDATORY\n29:   workflow_execution: autonomous\n30:   approvals: none\n31:   tracking: progressive_status_logging\n32:   validation: continuous_self_validation\n33:   supports_operations:\n34:   - full-create\n35:   - full-update\n36:   - reference-only\n37:   - asset-only\n38:   description: |\n39:     Executes the 7-step skill creation workflow without step-by-step approval.\n40:     Pauses only if confidence drops below threshold or operation routing conflicts.\n41: \n42: development_philosophy:\n43:   principle: \"One entrypoint, one router, one quality contract\"\n44:   approach: \"Normalize -> Resolve -> Execute -> Validate -> Integrate -> Persist\"\n45:   mandate: \"Prefer deterministic routing over inferred behavior\"\n46: \n47: runtime_agent_path_resolution:\n48:   default: .skilled/agents\n49:   claude: .claude/agents\n50: \n51: # ─────────────────────────────────────────────────────────────────\n52: # CONFIDENCE & CLARIFICATION FRAMEWORK\n53: # ─────────────────────────────────────────────────────────────────\n54: confidence_framework:\n55:   thresholds:\n56:     high: { range: \"80-100%\", action: \"Proceed with deterministic defaults\" }\n57:     medium: { range: \"40-79%\", action: \"Proceed with caution and log assumptions\" }\n58:     low: { range: \"0-39%\", action: \"STOP and request clarification\" }\n59:   scoring_weights:\n60:     input_completeness: 0.35\n61:     routing_clarity: 0.25\n62:     template_alignment: 0.20\n63:     validation_readiness: 0.20\n64:   low_confidence_behavior:\n65:     action: \"Return to setup gate with explicit missing fields\"\n66: \n67: # ─────────────────────────────────────────────────────────────────\n68: # REQUEST ANALYSIS FRAMEWORK\n69: # ─────────────────────────────────────────────────────────────────\n70: request_analysis_framework:\n71:   solution_flow:\n72:   - \"Parse request shape and normalize fields\"\n73:   - \"Enforce operation/type compatibility\"\n74:   - \"Resolve target path and existence semantics\"\n75:   - \"Execute operation branch with template-first behavior\"\n76:   - \"Run validation and DQI checks\"\n77:   - \"Integrate routing updates into SKILL.md\"\n78:   - \"Persist memory context when spec tracking is active\"\n79:   pre_change_validation:\n80:     items:\n81:     - \"create_agent_verified present\"\n82:     - \"skill_name present and valid\"\n83:     - \"operation present and supported\"\n84:     - \"type present if operation requires type\"\n85:     - \"execution_mode is :auto\"\n86:     stop_conditions:\n87:     - \"Missing required item\"\n88:     - \"Operation/type mismatch\"\n89:     stop_action: \"STOP and return to setup\"\n90: \n91: input_contract:\n92:   required:\n93:   - create_agent_verified\n94:   - skill_name\n95:   - operation\n96:   - execution_mode\n97:   conditional:\n98:     type_required_for:\n99:     - reference-only\n100:     - asset-only\n101:     spec_choice_required_for:\n102:     - full-create\n103:     - full-update\n104:   optional:\n105:   - skill_path\n106:   - spec_choice\n107:   - spec_path\n108:   - memory_choice\n109:   - chained\n110:   - parent_write_verified\n111: \n112: defaults:\n113:   skill_path: .skilled/skills/\n114:   execution_mode: :auto\n115:   dqi_hard_minimum: 75\n116:   dqi_targets:\n117:     full-create: 90\n118:     full-update: 90\n119:     reference-only: 80\n120:     asset-only: 80\n121: \n122: operation_router:\n123:   full-create:\n124:     requires_type: false\n125:     requires_existing_skill: false\n126:     forbidden_if_skill_exists: true\n127:     output_scope:\n128:     - SKILL.md\n129:     - references/\n130:     - assets/\n131:     - scripts/\n132:   full-update:\n133:     requires_type: false\n134:     requires_existing_skill: true\n135:     forbidden_if_skill_exists: false\n136:     output_scope:\n137:     - SKILL.md\n138:     - references/\n139:     - assets/\n140:     - scripts/\n141:   reference-only:\n142:     requires_type: true\n143:     allowed_types:\n144:     - workflow\n145:     - patterns\n146:     - debugging\n147:     - tools\n148:     - quick_ref\n149:     requires_existing_skill: true\n150:     output_scope:\n151:     - references/\n152:     - SKILL.md (routing updates)\n153:   asset-only:\n154:     requires_type: true\n155:     allowed_types:\n156:     - template\n157:     - lookup\n158:     - example\n159:     - guide\n160:     requires_existing_skill: true\n161:     output_scope:\n162:     - assets/\n163:     - SKILL.md (routing updates)\n164: \n165: operation_profiles:\n166:   full-create:\n167:     objective: \"Create a new skill with complete baseline artifacts\"\n168:     required_outcomes:\n169:     - \"Skill scaffold created\"\n170:     - \"SKILL.md populated\"\n171:     - \"Initial resources added\"\n172:   full-update:\n173:     objective: \"Update an existing skill without destabilizing unrelated sections\"\n174:     required_outcomes:\n175:     - \"Target sections updated\"\n176:     - \"Legacy/stale references removed\"\n177:   reference-only:\n178:     objective: \"Create or revise a single reference document\"\n179:     required_outcomes:\n180:     - \"Reference file written\"\n181:     - \"SKILL.md routing updated\"\n182:   asset-only:\n183:     objective: \"Create or revise a single asset document\"\n184:     required_outcomes:\n185:     - \"Asset file written\"\n186:     - \"SKILL.md routing updated\"\n187: \n188: template_sources:\n189:   skill_md: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-md-template.md\n190:   skill_reference: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-reference-template.md\n191:   skill_asset: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-asset-template.md\n192:   skill_smart_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-smart-router.md\n193:   skill_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-router-template.md\n194:   skill_readme: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-readme-template.md\n195: \n196: frontmatter_contract:\n197:   rule: \"Every authored .md ships frontmatter from its template before completion.\"\n198:   skill_md:\n199:     required_fields: [name, description, allowed-tools, version]\n200:     version_format: \"4-part X.Y.Z.W\"\n201:     name_rule: \"hyphen-case, matches folder name\"\n202:   references_and_assets:\n203:     seed_from: [skill_reference, skill_asset]\n204:     required_fields: [title, description, trigger_phrases, importance_tier, contextType, version]\n205:     trigger_phrases: \"3-8 lowercase multi-word phrases\"\n206:     version_format: \"4-part X.Y.Z.W\"\n207:     filename_rule: \"kebab-case for every non-exempt filesystem name\"\n208:   readme:\n209:     seed_from: skill_readme\n210:     required_fields: [title, description, version]\n211:   enforcement: \"package_skill.py --check hard-fails missing version / non-4-part version / name!=folder; generated references/ and assets/ filenames must use kebab-case\"\n212: \n213: validation_scripts:\n214:   quick_validate: .skilled/skills/sk-doc/scripts/quick_validate.py\n215:   validate_document: .skilled/skills/sk-doc/scripts/validate_document.py\n216:   extract_structure: .skilled/skills/sk-doc/scripts/extract_structure.py\n217:   package_skill: .skilled/skills/sk-doc/scripts/package_skill.py\n218:   validate_skill_package: .skilled/skills/sk-doc/scripts/validate_skill_package.py\n219: \n220: quality_standards:\n221:   template_first: required\n222:   sk_doc_alignment: required\n223:   section_boundary_rules:\n224:     when_to_use: \"activation and use-case logic only\"\n225:     smart_routing: \"8 to 12 lines of plain prose, and the machine router lives in the sibling ROUTER.md under a final '## MACHINE ROUTER' heading\"\n226:   validation_pipeline:\n227:     full_flows:\n228:     - \"python3 .skilled/skills/sk-doc/scripts/quick_validate.py [skill_path]/[skill_name] --json\"\n229:     - \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name]\"\n230:     - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [skill_path]/[skill_name]/SKILL.md\"\n231:     doc_only_flows:\n232:     - \"python3 .skilled/skills/sk-doc/scripts/validate_document.py [target_file]\"\n233:     - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [target_file]\"\n234:   dqi_policy:\n235:     hard_minimum: 75\n236:     target_by_operation:\n237:       full-create: 90\n238:       full-update: 90\n239:       reference-only: 80\n240:       asset-only: 80\n241: \n242: gate_logic:\n243:   hard:\n244:     H0_write_or_chained:\n245:       description: \"create_agent_verified must be true or skipped-chained with valid parent marker\"\n246:       fail_action: \"STOP and return to setup\"\n247:     H1_required_fields:\n248:       description: \"All required input fields must be present\"\n249:       fail_action: \"STOP and collect missing fields\"\n250:     H2_operation_type_compatibility:\n251:       description: \"Operation must be supported; type must match operation rules\"\n252:       fail_action: \"STOP and request correction\"\n253:     H3_existence_semantics:\n254:       description: \"Create requires non-existing skill; update/doc-only require existing skill\"\n255:       fail_action: \"STOP and reroute or correct target\"\n256:     H4_validation_gate:\n257:       description: \"DQI >= hard minimum and structural checks pass\"\n258:       fail_action: \"Run fix-and-revalidate loop\"\n259:     H4b_human_voice_gate:\n260:       description: \"No HVR hard blockers and every absolute score >= 85\"\n261:       fail_action: \"Revise or rewrite, re-run hvr_scan.py, then revalidate\"\n262:   soft:\n263:     S1_similarity_discovery:\n264:       description: \"Warn on similar existing skills before full-create\"\n265:       fail_action: \"Warn only\"\n266:     S2_resource_recommendation:\n267:       description: \"Suggest additional references/assets based on current output gaps\"\n268:       fail_action: \"Skip suggestion\"\n269: \n270: # ─────────────────────────────────────────────────────────────────\n271: # CONTEXT LOADING\n272: # ─────────────────────────────────────────────────────────────────\n273: context_loading:\n274:   trigger: \"During UNIFIED SETUP PHASE, non-interactive resolution before Step 1\"\n275:   applies_when: \"spec_path resolves to an existing spec folder (spec_choice A - Existing, or C - Related) that contains handover.md or _memory.continuity in implementation-summary.md; not applicable to a freshly created spec folder (spec_choice B - New) or when spec_choice is D (Skip)\"\n276:   auto_resolution:\n277:     default: \"If prior context exists (handover.md <24h old or _memory.continuity present), load it automatically; sets memory_loaded: handover+continuity. Otherwise skip; sets memory_loaded: skipped.\"\n278:     override: \"Honor memory_choice if explicitly supplied as a command argument\"\n279:   continuity_ladder:\n280:     note: \"Read the packet's own files in order. No background service is involved.\"\n281:     order:\n282:       - \"Read {spec_path}/handover.md when present and recent\"\n283:       - \"Read the _memory.continuity frontmatter block in {spec_path}/implementation-summary.md\"\n284:       - \"Read the packet-first canonical spec docs: spec.md, plan.md, tasks.md, decision-record.md\"\n285:       - \"Only for a still-missing named gap, run the packet-scoped context recipe from .skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md section 2.4 with {spec_path} as the search root\"\n286:     unsupported: \"Semantic paraphrase, vector and BM25 fusion, decay, access tracking and session dedup are not available. The ladder is lexical and file-local; a miss is a clean no-hit reported as such, never a guess.\"\n287:   output: memory_loaded\n288: \n289: workflow_overview:\n290:   steps:\n291:   - id: step_1_preflight\n292:     purpose: \"Normalize inputs and enforce H0-H2\"\n293:   - id: step_2_target_resolution\n294:     purpose: \"Resolve target path and enforce H3\"\n295:   - id: step_3_operation_execution\n296:     purpose: \"Run one operation branch\"\n297:   - id: step_3b_human_voice_score\n298:     purpose: \"Score authored skill documents before validation\"\n299:   - id: step_4_validation_and_quality\n300:     purpose: \"Enforce H4 and DQI policy\"\n301:   - id: step_5_skill_integration\n302:     purpose: \"Sync SKILL.md routing references\"\n303:   - id: step_6_context_save_and_index\n304:     purpose: \"Save and index context when spec path exists\"\n305:   - id: step_7_completion\n306:     purpose: \"Emit deterministic completion report\"\n307: \n308: workflow:\n309:   step_1_preflight:\n310:     purpose: Normalize and verify required fields\n311:     activities:\n312:     - Normalize skill_path to default when omitted\n313:     - Normalize operation token to supported value\n314:     - Validate type for reference-only/asset-only\n315:     - Validate execution_mode is :auto\n316:     - Validate chained handoff completeness if chained=true\n317:     - Resolve memory_choice via the context_loading block (Q4 if applicable); record result as memory_loaded\n318:     outputs:\n319:     - normalized_inputs\n320:     - preflight_passed\n321: \n322:   step_2_target_resolution:\n323:     purpose: Resolve target paths and enforce create/update semantics\n324:     activities:\n325:     - Resolve skill_root as \"[skill_path]/[skill_name]\"\n326:     - Check target existence\n327:     - Block full-create when skill already exists\n328:     - Block full-update/reference-only/asset-only when skill is missing\n329:     - For full-create, run similarity discovery and log result\n330:     checks:\n331:       exists_command: \"ls -d [skill_path]/[skill_name] 2>/dev/null\"\n332:     outputs:\n333:     - skill_root\n334:     - existence_verified\n335:     - similarity_findings\n336: \n337:   step_3_operation_execution:\n338:     purpose: Execute selected operation branch\n339:     branches:\n340:       full-create:\n341:         activities:\n342:         - Run init script: \"python3 .skilled/skills/sk-doc/scripts/init_skill.py [skill_name] --path [skill_path]\"\n343:         - >-\n344:           Read the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n345:           before writing SKILL.md and README.md.\n346:         - Load SKILL.md template and populate required sections\n347:         - Apply section boundary rules\n348:         - \"Seed SKILL.md Section 2 (SMART ROUTING) as 8 to 12 lines of plain prose that say what selects this skill, what it loads first, and that the machine router lives in the sibling ROUTER.md. Take the machine router block (INTENT_SIGNALS and RESOURCE_MAP) from skill-smart-router.md, keep its four resilience patterns (runtime discovery, existence-check-before-load, extensible routing key, multi-tier fallback), adapt the routing key and resource map to this skill, and write the block to ROUTER.md under a final '## MACHINE ROUTER' heading. Add the relative markdown link to ./ROUTER.md in SMART ROUTING. A SMART ROUTING section over 12 lines, a machine router section left in SKILL.md, or a missing ROUTER.md link fails this branch.\"\n349:         - \"Set SKILL.md frontmatter per frontmatter_contract.skill_md: name (==folder), description, allowed-tools, version (4-part X.Y.Z.W)\"\n350:         - \"Create baseline references/assets/scripts from requested scope. Seed every references/*.md from skill_reference and every assets/*.md from skill_asset so each ships the full 5-field + version frontmatter; name non-exempt files in kebab-case. Create README.md from skill_readme if the initializer did not emit it, with title, description, and version.\"\n351:         - Remove placeholders and sample-only content\n352:         outputs:\n353:         - skill_scaffolded\n354:         - skill_content_written\n355:         - smart_router_pseudocode_seeded\n356:         - resources_written\n357: \n358:       full-update:\n359:         activities:\n360:         - Read existing SKILL.md and targeted resource files\n361:         - >-\n362:           Read and apply the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n363:           before editing SKILL.md or README.md.\n364:         - Update requested sections only\n365:         - Preserve existing folder and naming conventions\n366:         - Remove stale references in updated sections\n367:         - \"Run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] to report leaf-manifest.json freshness (fresh|stale|missing) for the completion handoff. This is a read-only drift check, not regeneration — full-update never ran the class-metadata gate, so unlike full-create it cannot assume freshness and must measure it\"\n368:         outputs:\n369:         - skill_updates_applied\n370:         - resource_updates_applied\n371:         - leaf_manifest_freshness_checked\n372: \n373:       reference-only:\n374:         activities:\n375:         - Ensure references/ exists\n376:         - \"Determine reference filename from type and topic; filename MUST be kebab-case\"\n377:         - \"Create or update reference doc seeded from skill_reference template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n378:         - Ensure content depth matches type profile\n379:         - \"references/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n380:         type_templates:\n381:           workflow: { filename_pattern: \"[topic]-workflow.md\" }\n382:           patterns: { filename_pattern: \"[topic]-patterns.md\" }\n383:           debugging: { filename_pattern: \"[topic]-debugging.md\" }\n384:           tools: { filename_pattern: \"[tool]-guide.md\" }\n385:           quick_ref: { filename_pattern: \"quick-reference.md\" }\n386:         outputs:\n387:         - reference_file_written\n388:         - leaf_manifest_freshness_signal\n389: \n390:       asset-only:\n391:         activities:\n392:         - Ensure assets/ exists\n393:         - \"Determine asset filename from type and topic; filename MUST be kebab-case\"\n394:         - \"Create or update asset doc seeded from skill_asset template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n395:         - Ensure examples are practical and immediately reusable\n396:         - \"assets/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n397:         type_templates:\n398:           template: { filename_pattern: \"[topic]-templates.md\" }\n399:           lookup: { filename_pattern: \"[topic]-lookup.md\" }\n400:           example: { filename_pattern: \"[topic]-examples.md\" }\n401:           guide: { filename_pattern: \"[topic]-guide.md\" }\n402:         outputs:\n403:         - asset_file_written\n404:         - leaf_manifest_freshness_signal\n405: \n406:   step_3b_human_voice_score:\n407:     purpose: Score authored skill documents before strict validation\n408:     condition: \"operation is full-create or full-update\"\n409:     activities:\n410:     - Read `.skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md` and follow its score operation, scope gate, mechanical scan, judgment pass, scoring rules, and report shape\n411:     - \"Resolve scan targets from existing files only: full-create requires [skill_root]/SKILL.md and includes [skill_root]/README.md only when present; full-update includes each existing SKILL.md or README.md.\"\n412:     - \"Do not pass a missing path to hvr_scan.py; a missing full-create SKILL.md is a structural failure.\"\n413:     - \"For each target, run `python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]` without extra flags; capture its output and exit code.\"\n414:     - \"Exit 0 means no hard blockers, exit 1 means at least one hard blocker and blocks completion, and exit 2 means the scan could not run and blocks completion. Review the remaining findings for sense and scope, and record justified exceptions.\"\n415:     - \"Compute the score from 100 using first-match-wins. For files up to 400 lines, 85+ is publish-ready, 70-84 requires revision, and below 70 requires rewriting. For longer files, report hard-blocker count and deduction density instead of an absolute score.\"\n416:     - Record each target's scan output and exit code, confirmed blockers, score or length basis, judgment findings, exceptions, and verdict for the presentation\n417:     - \"A target passes only with no hard blockers and a score of at least 85 when an absolute score applies. Revise scores from 70 to 84 and rewrite scores below 70, then run the score operation again.\"\n418:     - \"When a target fails, revise its in-scope prose and repeat the score operation before validation. Stop when the scan exits 2 or a hard blocker remains.\"\n419:     outputs:\n420:     - human_voice_results\n421:     - human_voice_passed\n422:     gate:\n423:       command: \"python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]\"\n424:       blocking: true\n425: \n426:   step_4_validation_and_quality:\n427:     purpose: Enforce operation-specific validation and DQI targets\n428:     activities:\n429:     - Run operation-appropriate validation scripts\n430:     - \"Run the completion gate: python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict . This is the authoritative structural gate (hard-fails missing/non-4-part version, name!=folder, or missing required sections). It MUST pass before completion, and the generated tree must contain no non-exempt underscore path segment.\"\n431:     - \"Run python3 .skilled/skills/sk-doc/scripts/package_skill.py [skill_path]/[skill_name] --check --strict. The strict completion gate runs that check and rejects the old routing shape (RS-001 to RS-005): a SMART ROUTING section over 12 lines or 180 words, a '## MACHINE ROUTER' section left in SKILL.md, that section not last, a missing sibling ROUTER.md or one whose real path leaves the skill folder, and a SKILL.md with no relative link to ./ROUTER.md.\"\n432:     - Capture DQI score and quality band\n433:     - Enforce hard minimum threshold (75)\n434:     - Compare against operation target score\n435:     - Run fix-and-revalidate loop if needed\n436:     gate:\n437:       command: \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict\"\n438:       blocking: true\n439:     thresholds:\n440:       hard_minimum: 75\n441:       operation_targets:\n442:         full-create: 90\n443:         full-update: 90\n444:         reference-only: 80\n445:         asset-only: 80\n446:     fix_loop:\n447:       max_retries: 3\n448:       action: \"Apply fixes, rerun validation, stop on pass or hard failure\"\n449:     outputs:\n450:     - validation_passed\n451:     - dqi_score\n452:     - dqi_band\n453: \n454:   step_5_skill_integration:\n455:     purpose: Keep routing and references synchronized in SKILL.md\n456:     activities:\n457:     - \"Update SMART ROUTING references for new/changed docs, keeping the section at 8 to 12 lines of plain prose, the machine router in the sibling ROUTER.md, and the link to it current\"\n458:     - Keep WHEN TO USE free of file-path navigation content\n459:     - Remove stale links and outdated references\n460:     - Verify referenced files exist after update\n461:     outputs:\n462:     - skill_md_synced\n463:     - routing_links_valid\n464: \n465:   step_6_context_save_and_index:\n466:     purpose: Persist context with system-spec-kit compatibility\n467:     condition: \"spec_path exists\"\n468:     activities:\n469:     - Save context using generate-context.js\n470:     - Regenerate the trigger index when trigger_phrases changed\n471:     - Log the writer path and whether the trigger index was regenerated\n472:     write_continuity:\n473:       command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js [spec_path]\"\n474:       hard_rule: \"Do not create memory files manually\"\n475:     indexing:\n476:       preferred: \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs\"\n477:       note: \"generate-context.js writes the continuity frontmatter; the trigger index is regenerated from that frontmatter. There is no daemon to hand off to and no background indexing step to wait for.\"\n478:     outputs:\n479:     - context_saved\n480:     - context_indexed\n481: \n482:   step_7_completion:\n483:     purpose: Emit deterministic completion summary\n484:     activities:\n485:     - For full-create and full-update, provide human_voice_results and human_voice_passed to the presentation contract\n486:     completion_report_template: |\n487:       Unified Skill Workflow Complete\n488: \n489:       Skill: [skill_name]\n490:       Operation: [operation]\n491:       Type: [type or N/A]\n492:       Mode: :auto\n493:       Target: [skill_root_or_target_file]\n494: \n495:       Validation:\n496:       - DQI: [dqi_score] ([dqi_band])\n497:       - Hard minimum: 75\n498:       - Operation target: [operation_target]\n499: \n500:       [operation == full-create or full-update:]\n501:       Advisor/Index Handoff (operator-owned; this command did not mutate advisor state; standalone scope — H-only fields omitted):\n502:       - graph-metadata.json: sole skill advisor identity; source for graph indexing\n503:       - leaf-manifest.json: [fresh|stale|missing]\n504:       - Refresh choice - run one when the advisor should include this change:\n505:         - Full advisor refresh: node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --workspace-root \"$PWD\" --format json\n506:         - Graph-only refresh: node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --skills-root \"$PWD/.skilled/skills\" --format json\n507:       - Refresh status: NOT RUN (operator-owned; see .skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md)\n508:       [operation == reference-only or asset-only:]\n509:       Leaf-manifest freshness: [fresh|stale|missing] (narrow signal only — see advisor-index-handoff.md § Branch Scope for why this branch does not render the full handoff)\n510: \n511:       Context:\n512:       - Spec path: [spec_path or none]\n513:       - Memory saved: [yes/no]\n514: \n515:       STATUS=OK PATH=[skill_root_or_target_file]\n516: \n517: violation_recovery:\n518:   setup_violation:\n519:     trigger: \"Missing required normalized fields\"\n520:     action:\n521:     - \"Stop\"\n522:     - \"State missing field(s)\"\n523:     - \"Return to setup\"\n524:   routing_violation:\n525:     trigger: \"Operation/type mismatch or wrong existence routing\"\n526:     action:\n527:     - \"Stop\"\n528:     - \"State routing correction\"\n529:     - \"Re-run operation router\"\n530:   validation_violation:\n531:     trigger: \"DQI below threshold or structural errors\"\n532:     action:\n533:     - \"Stop completion\"\n534:     - \"Run fix loop\"\n535:     - \"Revalidate\"\n536: \n537: error_recovery:\n538:   invalid_skill_name:\n539:     action: \"Require explicit hyphen-case skill_name\"\n540:   invalid_operation:\n541:     action: \"Require one of full-create/full-update/reference-only/asset-only\"\n542:   missing_type:\n543:     action: \"Require type for reference-only or asset-only\"\n544:   invalid_type:\n545:     action: \"Show allowed types for selected operation\"\n546:   skill_exists_on_create:\n547:     action: \"Offer reroute to full-update\"\n548:   skill_missing_on_update_or_doc:\n549:     action: \"Offer reroute to full-create or corrected name/path\"\n550:   template_load_failure:\n551:     action: \"Verify sk-doc template paths and retry\"\n552:   validation_failure:\n553:     action: \"Capture script output, fix, retry\"\n554:   integration_failure:\n555:     action: \"Repair SKILL.md links and rerun integration checks\"\n556: \n557: circuit_breaker:\n558:   consecutive_failure_threshold: 3\n559:   states:\n560:     closed: \"Normal operation\"\n561:     open: \"Stop and report failure summary\"\n562:     half_open: \"Single retry with stricter checks\"\n563:   on_open:\n564:     action: \"Stop workflow and return STATUS=FAIL\"\n565: \n566: termination:\n567:   after_step: step_7_completion\n568:   message: \"Unified sk-skill auto workflow complete.\"\n569:   next_steps:\n570:   - condition: \"Need iterative updates\"\n571:     action: \"/create:skill [skill-name] full-update :confirm\"\n572:   - condition: \"Need another reference\"\n573:     action: \"/create:skill [skill-name] reference-only [type] :confirm\"\n574:   - condition: \"Need another asset\"\n575:     action: \"/create:skill [skill-name] asset-only [type] :confirm\"\n576: \n577: rules:\n578:   ALWAYS:\n579:   - \"Enforce @markdown or valid chained handoff\"\n580:   - \"Use canonical operation router\"\n581:   - \"Load templates before writing\"\n582:   - \"Seed every authored .md from its template so frontmatter is present by construction (frontmatter_contract)\"\n583:   - \"Seed SMART ROUTING as 8 to 12 lines of plain prose with a link to ./ROUTER.md, and the machine router block in that sibling file under the final '## MACHINE ROUTER' heading, from skill-smart-router.md, on full-create\"\n584:   - \"Pass validate_skill_package.py before completion\"\n585:   - \"Run validation before completion\"\n586:   - \"Preserve WHEN TO USE vs SMART ROUTING boundaries\"\n587:   - \"Save memory context only through system-spec-kit workflow\"\n588:   NEVER:\n589:   - \"Split setup prompts across turns\"\n590:   - \"Infer missing operation/type values\"\n591:   - \"Bypass hard gates\"\n592:   - \"Write a references/ or assets/ .md without the full 5-field + version frontmatter\"\n593:   - \"Ship a SMART ROUTING section over 12 lines, leave a machine router section in SKILL.md, or omit the sibling ROUTER.md or its link\"\n594:   - \"Use non-kebab-case filenames in references/ or assets/\"\n595:   - \"Create memory files manually\"\n596:   - \"Leave stale routing links in SKILL.md\"","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-auto.yaml, lines 1-596\n1: # ─────────────────────────────────────────────────────────────────\n2: # OPENCODE CREATE: SK-SKILL UNIFIED WORKFLOW (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # Mode: autonomous execution (no approval checkpoints)\n5: # Entrypoint: /create:skill\n6: # Operations: full-create | full-update | reference-only | asset-only\n7: # ─────────────────────────────────────────────────────────────────\n8: \n9: role: Unified Skill Creator using sk-doc\n10: purpose: Execute a canonical autonomous workflow for skill creation and skill document updates\n11: action: Route one operation branch with shared gates, validation, and context persistence\n12: \n13: # ─────────────────────────────────────────────────────────────────\n14: # PREREQUISITE: @markdown AGENT VERIFICATION\n15: # ─────────────────────────────────────────────────────────────────\n16: # This workflow REQUIRES the @markdown agent for:\n17: #   - Template-first generation\n18: #   - sk-doc standards enforcement\n19: #   - Root document validation\n20: #\n21: # The command markdown verifies the @markdown agent BEFORE\n22: # this YAML workflow loads. If you are executing this workflow,\n23: # @markdown verification has already passed.\n24: # ─────────────────────────────────────────────────────────────────\n25: \n26: operating_mode:\n27:   workflow: unified_7_step\n28:   workflow_compliance: MANDATORY\n29:   workflow_execution: autonomous\n30:   approvals: none\n31:   tracking: progressive_status_logging\n32:   validation: continuous_self_validation\n33:   supports_operations:\n34:   - full-create\n35:   - full-update\n36:   - reference-only\n37:   - asset-only\n38:   description: |\n39:     Executes the 7-step skill creation workflow without step-by-step approval.\n40:     Pauses only if confidence drops below threshold or operation routing conflicts.\n41: \n42: development_philosophy:\n43:   principle: \"One entrypoint, one router, one quality contract\"\n44:   approach: \"Normalize -> Resolve -> Execute -> Validate -> Integrate -> Persist\"\n45:   mandate: \"Prefer deterministic routing over inferred behavior\"\n46: \n47: runtime_agent_path_resolution:\n48:   default: .skilled/agents\n49:   claude: .claude/agents\n50: \n51: # ─────────────────────────────────────────────────────────────────\n52: # CONFIDENCE & CLARIFICATION FRAMEWORK\n53: # ─────────────────────────────────────────────────────────────────\n54: confidence_framework:\n55:   thresholds:\n56:     high: { range: \"80-100%\", action: \"Proceed with deterministic defaults\" }\n57:     medium: { range: \"40-79%\", action: \"Proceed with caution and log assumptions\" }\n58:     low: { range: \"0-39%\", action: \"STOP and request clarification\" }\n59:   scoring_weights:\n60:     input_completeness: 0.35\n61:     routing_clarity: 0.25\n62:     template_alignment: 0.20\n63:     validation_readiness: 0.20\n64:   low_confidence_behavior:\n65:     action: \"Return to setup gate with explicit missing fields\"\n66: \n67: # ─────────────────────────────────────────────────────────────────\n68: # REQUEST ANALYSIS FRAMEWORK\n69: # ─────────────────────────────────────────────────────────────────\n70: request_analysis_framework:\n71:   solution_flow:\n72:   - \"Parse request shape and normalize fields\"\n73:   - \"Enforce operation/type compatibility\"\n74:   - \"Resolve target path and existence semantics\"\n75:   - \"Execute operation branch with template-first behavior\"\n76:   - \"Run validation and DQI checks\"\n77:   - \"Integrate routing updates into SKILL.md\"\n78:   - \"Persist memory context when spec tracking is active\"\n79:   pre_change_validation:\n80:     items:\n81:     - \"create_agent_verified present\"\n82:     - \"skill_name present and valid\"\n83:     - \"operation present and supported\"\n84:     - \"type present if operation requires type\"\n85:     - \"execution_mode is :auto\"\n86:     stop_conditions:\n87:     - \"Missing required item\"\n88:     - \"Operation/type mismatch\"\n89:     stop_action: \"STOP and return to setup\"\n90: \n91: input_contract:\n92:   required:\n93:   - create_agent_verified\n94:   - skill_name\n95:   - operation\n96:   - execution_mode\n97:   conditional:\n98:     type_required_for:\n99:     - reference-only\n100:     - asset-only\n101:     spec_choice_required_for:\n102:     - full-create\n103:     - full-update\n104:   optional:\n105:   - skill_path\n106:   - spec_choice\n107:   - spec_path\n108:   - memory_choice\n109:   - chained\n110:   - parent_write_verified\n111: \n112: defaults:\n113:   skill_path: .skilled/skills/\n114:   execution_mode: :auto\n115:   dqi_hard_minimum: 75\n116:   dqi_targets:\n117:     full-create: 90\n118:     full-update: 90\n119:     reference-only: 80\n120:     asset-only: 80\n121: \n122: operation_router:\n123:   full-create:\n124:     requires_type: false\n125:     requires_existing_skill: false\n126:     forbidden_if_skill_exists: true\n127:     output_scope:\n128:     - SKILL.md\n129:     - references/\n130:     - assets/\n131:     - scripts/\n132:   full-update:\n133:     requires_type: false\n134:     requires_existing_skill: true\n135:     forbidden_if_skill_exists: false\n136:     output_scope:\n137:     - SKILL.md\n138:     - references/\n139:     - assets/\n140:     - scripts/\n141:   reference-only:\n142:     requires_type: true\n143:     allowed_types:\n144:     - workflow\n145:     - patterns\n146:     - debugging\n147:     - tools\n148:     - quick_ref\n149:     requires_existing_skill: true\n150:     output_scope:\n151:     - references/\n152:     - SKILL.md (routing updates)\n153:   asset-only:\n154:     requires_type: true\n155:     allowed_types:\n156:     - template\n157:     - lookup\n158:     - example\n159:     - guide\n160:     requires_existing_skill: true\n161:     output_scope:\n162:     - assets/\n163:     - SKILL.md (routing updates)\n164: \n165: operation_profiles:\n166:   full-create:\n167:     objective: \"Create a new skill with complete baseline artifacts\"\n168:     required_outcomes:\n169:     - \"Skill scaffold created\"\n170:     - \"SKILL.md populated\"\n171:     - \"Initial resources added\"\n172:   full-update:\n173:     objective: \"Update an existing skill without destabilizing unrelated sections\"\n174:     required_outcomes:\n175:     - \"Target sections updated\"\n176:     - \"Legacy/stale references removed\"\n177:   reference-only:\n178:     objective: \"Create or revise a single reference document\"\n179:     required_outcomes:\n180:     - \"Reference file written\"\n181:     - \"SKILL.md routing updated\"\n182:   asset-only:\n183:     objective: \"Create or revise a single asset document\"\n184:     required_outcomes:\n185:     - \"Asset file written\"\n186:     - \"SKILL.md routing updated\"\n187: \n188: template_sources:\n189:   skill_md: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-md-template.md\n190:   skill_reference: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-reference-template.md\n191:   skill_asset: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-asset-template.md\n192:   skill_smart_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-smart-router.md\n193:   skill_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-router-template.md\n194:   skill_readme: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-readme-template.md\n195: \n196: frontmatter_contract:\n197:   rule: \"Every authored .md ships frontmatter from its template before completion.\"\n198:   skill_md:\n199:     required_fields: [name, description, allowed-tools, version]\n200:     version_format: \"4-part X.Y.Z.W\"\n201:     name_rule: \"hyphen-case, matches folder name\"\n202:   references_and_assets:\n203:     seed_from: [skill_reference, skill_asset]\n204:     required_fields: [title, description, trigger_phrases, importance_tier, contextType, version]\n205:     trigger_phrases: \"3-8 lowercase multi-word phrases\"\n206:     version_format: \"4-part X.Y.Z.W\"\n207:     filename_rule: \"kebab-case for every non-exempt filesystem name\"\n208:   readme:\n209:     seed_from: skill_readme\n210:     required_fields: [title, description, version]\n211:   enforcement: \"package_skill.py --check hard-fails missing version / non-4-part version / name!=folder; generated references/ and assets/ filenames must use kebab-case\"\n212: \n213: validation_scripts:\n214:   quick_validate: .skilled/skills/sk-doc/scripts/quick_validate.py\n215:   validate_document: .skilled/skills/sk-doc/scripts/validate_document.py\n216:   extract_structure: .skilled/skills/sk-doc/scripts/extract_structure.py\n217:   package_skill: .skilled/skills/sk-doc/scripts/package_skill.py\n218:   validate_skill_package: .skilled/skills/sk-doc/scripts/validate_skill_package.py\n219: \n220: quality_standards:\n221:   template_first: required\n222:   sk_doc_alignment: required\n223:   section_boundary_rules:\n224:     when_to_use: \"activation and use-case logic only\"\n225:     smart_routing: \"8 to 12 lines of plain prose, and the machine router lives in the sibling ROUTER.md under a final '## MACHINE ROUTER' heading\"\n226:   validation_pipeline:\n227:     full_flows:\n228:     - \"python3 .skilled/skills/sk-doc/scripts/quick_validate.py [skill_path]/[skill_name] --json\"\n229:     - \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name]\"\n230:     - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [skill_path]/[skill_name]/SKILL.md\"\n231:     doc_only_flows:\n232:     - \"python3 .skilled/skills/sk-doc/scripts/validate_document.py [target_file]\"\n233:     - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [target_file]\"\n234:   dqi_policy:\n235:     hard_minimum: 75\n236:     target_by_operation:\n237:       full-create: 90\n238:       full-update: 90\n239:       reference-only: 80\n240:       asset-only: 80\n241: \n242: gate_logic:\n243:   hard:\n244:     H0_write_or_chained:\n245:       description: \"create_agent_verified must be true or skipped-chained with valid parent marker\"\n246:       fail_action: \"STOP and return to setup\"\n247:     H1_required_fields:\n248:       description: \"All required input fields must be present\"\n249:       fail_action: \"STOP and collect missing fields\"\n250:     H2_operation_type_compatibility:\n251:       description: \"Operation must be supported; type must match operation rules\"\n252:       fail_action: \"STOP and request correction\"\n253:     H3_existence_semantics:\n254:       description: \"Create requires non-existing skill; update/doc-only require existing skill\"\n255:       fail_action: \"STOP and reroute or correct target\"\n256:     H4_validation_gate:\n257:       description: \"DQI >= hard minimum and structural checks pass\"\n258:       fail_action: \"Run fix-and-revalidate loop\"\n259:     H4b_human_voice_gate:\n260:       description: \"No HVR hard blockers and every absolute score >= 85\"\n261:       fail_action: \"Revise or rewrite, re-run hvr_scan.py, then revalidate\"\n262:   soft:\n263:     S1_similarity_discovery:\n264:       description: \"Warn on similar existing skills before full-create\"\n265:       fail_action: \"Warn only\"\n266:     S2_resource_recommendation:\n267:       description: \"Suggest additional references/assets based on current output gaps\"\n268:       fail_action: \"Skip suggestion\"\n269: \n270: # ─────────────────────────────────────────────────────────────────\n271: # CONTEXT LOADING\n272: # ─────────────────────────────────────────────────────────────────\n273: context_loading:\n274:   trigger: \"During UNIFIED SETUP PHASE, non-interactive resolution before Step 1\"\n275:   applies_when: \"spec_path resolves to an existing spec folder (spec_choice A - Existing, or C - Related) that contains handover.md or _memory.continuity in implementation-summary.md; not applicable to a freshly created spec folder (spec_choice B - New) or when spec_choice is D (Skip)\"\n276:   auto_resolution:\n277:     default: \"If prior context exists (handover.md <24h old or _memory.continuity present), load it automatically; sets memory_loaded: handover+continuity. Otherwise skip; sets memory_loaded: skipped.\"\n278:     override: \"Honor memory_choice if explicitly supplied as a command argument\"\n279:   continuity_ladder:\n280:     note: \"Read the packet's own files in order. No background service is involved.\"\n281:     order:\n282:       - \"Read {spec_path}/handover.md when present and recent\"\n283:       - \"Read the _memory.continuity frontmatter block in {spec_path}/implementation-summary.md\"\n284:       - \"Read the packet-first canonical spec docs: spec.md, plan.md, tasks.md, decision-record.md\"\n285:       - \"Only for a still-missing named gap, run the packet-scoped context recipe from .skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md section 2.4 with {spec_path} as the search root\"\n286:     unsupported: \"Semantic paraphrase, vector and BM25 fusion, decay, access tracking and session dedup are not available. The ladder is lexical and file-local; a miss is a clean no-hit reported as such, never a guess.\"\n287:   output: memory_loaded\n288: \n289: workflow_overview:\n290:   steps:\n291:   - id: step_1_preflight\n292:     purpose: \"Normalize inputs and enforce H0-H2\"\n293:   - id: step_2_target_resolution\n294:     purpose: \"Resolve target path and enforce H3\"\n295:   - id: step_3_operation_execution\n296:     purpose: \"Run one operation branch\"\n297:   - id: step_3b_human_voice_score\n298:     purpose: \"Score authored skill documents before validation\"\n299:   - id: step_4_validation_and_quality\n300:     purpose: \"Enforce H4 and DQI policy\"\n301:   - id: step_5_skill_integration\n302:     purpose: \"Sync SKILL.md routing references\"\n303:   - id: step_6_context_save_and_index\n304:     purpose: \"Save and index context when spec path exists\"\n305:   - id: step_7_completion\n306:     purpose: \"Emit deterministic completion report\"\n307: \n308: workflow:\n309:   step_1_preflight:\n310:     purpose: Normalize and verify required fields\n311:     activities:\n312:     - Normalize skill_path to default when omitted\n313:     - Normalize operation token to supported value\n314:     - Validate type for reference-only/asset-only\n315:     - Validate execution_mode is :auto\n316:     - Validate chained handoff completeness if chained=true\n317:     - Resolve memory_choice via the context_loading block (Q4 if applicable); record result as memory_loaded\n318:     outputs:\n319:     - normalized_inputs\n320:     - preflight_passed\n321: \n322:   step_2_target_resolution:\n323:     purpose: Resolve target paths and enforce create/update semantics\n324:     activities:\n325:     - Resolve skill_root as \"[skill_path]/[skill_name]\"\n326:     - Check target existence\n327:     - Block full-create when skill already exists\n328:     - Block full-update/reference-only/asset-only when skill is missing\n329:     - For full-create, run similarity discovery and log result\n330:     checks:\n331:       exists_command: \"ls -d [skill_path]/[skill_name] 2>/dev/null\"\n332:     outputs:\n333:     - skill_root\n334:     - existence_verified\n335:     - similarity_findings\n336: \n337:   step_3_operation_execution:\n338:     purpose: Execute selected operation branch\n339:     branches:\n340:       full-create:\n341:         activities:\n342:         - Run init script: \"python3 .skilled/skills/sk-doc/scripts/init_skill.py [skill_name] --path [skill_path]\"\n343:         - >-\n344:           Read the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n345:           before writing SKILL.md and README.md.\n346:         - Load SKILL.md template and populate required sections\n347:         - Apply section boundary rules\n348:         - \"Seed SKILL.md Section 2 (SMART ROUTING) as 8 to 12 lines of plain prose that say what selects this skill, what it loads first, and that the machine router lives in the sibling ROUTER.md. Take the machine router block (INTENT_SIGNALS and RESOURCE_MAP) from skill-smart-router.md, keep its four resilience patterns (runtime discovery, existence-check-before-load, extensible routing key, multi-tier fallback), adapt the routing key and resource map to this skill, and write the block to ROUTER.md under a final '## MACHINE ROUTER' heading. Add the relative markdown link to ./ROUTER.md in SMART ROUTING. A SMART ROUTING section over 12 lines, a machine router section left in SKILL.md, or a missing ROUTER.md link fails this branch.\"\n349:         - \"Set SKILL.md frontmatter per frontmatter_contract.skill_md: name (==folder), description, allowed-tools, version (4-part X.Y.Z.W)\"\n350:         - \"Create baseline references/assets/scripts from requested scope. Seed every references/*.md from skill_reference and every assets/*.md from skill_asset so each ships the full 5-field + version frontmatter; name non-exempt files in kebab-case. Create README.md from skill_readme if the initializer did not emit it, with title, description, and version.\"\n351:         - Remove placeholders and sample-only content\n352:         outputs:\n353:         - skill_scaffolded\n354:         - skill_content_written\n355:         - smart_router_pseudocode_seeded\n356:         - resources_written\n357: \n358:       full-update:\n359:         activities:\n360:         - Read existing SKILL.md and targeted resource files\n361:         - >-\n362:           Read and apply the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n363:           before editing SKILL.md or README.md.\n364:         - Update requested sections only\n365:         - Preserve existing folder and naming conventions\n366:         - Remove stale references in updated sections\n367:         - \"Run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] to report leaf-manifest.json freshness (fresh|stale|missing) for the completion handoff. This is a read-only drift check, not regeneration — full-update never ran the class-metadata gate, so unlike full-create it cannot assume freshness and must measure it\"\n368:         outputs:\n369:         - skill_updates_applied\n370:         - resource_updates_applied\n371:         - leaf_manifest_freshness_checked\n372: \n373:       reference-only:\n374:         activities:\n375:         - Ensure references/ exists\n376:         - \"Determine reference filename from type and topic; filename MUST be kebab-case\"\n377:         - \"Create or update reference doc seeded from skill_reference template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n378:         - Ensure content depth matches type profile\n379:         - \"references/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n380:         type_templates:\n381:           workflow: { filename_pattern: \"[topic]-workflow.md\" }\n382:           patterns: { filename_pattern: \"[topic]-patterns.md\" }\n383:           debugging: { filename_pattern: \"[topic]-debugging.md\" }\n384:           tools: { filename_pattern: \"[tool]-guide.md\" }\n385:           quick_ref: { filename_pattern: \"quick-reference.md\" }\n386:         outputs:\n387:         - reference_file_written\n388:         - leaf_manifest_freshness_signal\n389: \n390:       asset-only:\n391:         activities:\n392:         - Ensure assets/ exists\n393:         - \"Determine asset filename from type and topic; filename MUST be kebab-case\"\n394:         - \"Create or update asset doc seeded from skill_asset template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n395:         - Ensure examples are practical and immediately reusable\n396:         - \"assets/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n397:         type_templates:\n398:           template: { filename_pattern: \"[topic]-templates.md\" }\n399:           lookup: { filename_pattern: \"[topic]-lookup.md\" }\n400:           example: { filename_pattern: \"[topic]-examples.md\" }\n401:           guide: { filename_pattern: \"[topic]-guide.md\" }\n402:         outputs:\n403:         - asset_file_written\n404:         - leaf_manifest_freshness_signal\n405: \n406:   step_3b_human_voice_score:\n407:     purpose: Score authored skill documents before strict validation\n408:     condition: \"operation is full-create or full-update\"\n409:     activities:\n410:     - Read `.skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md` and follow its score operation, scope gate, mechanical scan, judgment pass, scoring rules, and report shape\n411:     - \"Resolve scan targets from existing files only: full-create requires [skill_root]/SKILL.md and includes [skill_root]/README.md only when present; full-update includes each existing SKILL.md or README.md.\"\n412:     - \"Do not pass a missing path to hvr_scan.py; a missing full-create SKILL.md is a structural failure.\"\n413:     - \"For each target, run `python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]` without extra flags; capture its output and exit code.\"\n414:     - \"Exit 0 means no hard blockers, exit 1 means at least one hard blocker and blocks completion, and exit 2 means the scan could not run and blocks completion. Review the remaining findings for sense and scope, and record justified exceptions.\"\n415:     - \"Compute the score from 100 using first-match-wins. For files up to 400 lines, 85+ is publish-ready, 70-84 requires revision, and below 70 requires rewriting. For longer files, report hard-blocker count and deduction density instead of an absolute score.\"\n416:     - Record each target's scan output and exit code, confirmed blockers, score or length basis, judgment findings, exceptions, and verdict for the presentation\n417:     - \"A target passes only with no hard blockers and a score of at least 85 when an absolute score applies. Revise scores from 70 to 84 and rewrite scores below 70, then run the score operation again.\"\n418:     - \"When a target fails, revise its in-scope prose and repeat the score operation before validation. Stop when the scan exits 2 or a hard blocker remains.\"\n419:     outputs:\n420:     - human_voice_results\n421:     - human_voice_passed\n422:     gate:\n423:       command: \"python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]\"\n424:       blocking: true\n425: \n426:   step_4_validation_and_quality:\n427:     purpose: Enforce operation-specific validation and DQI targets\n428:     activities:\n429:     - Run operation-appropriate validation scripts\n430:     - \"Run the completion gate: python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict . This is the authoritative structural gate (hard-fails missing/non-4-part version, name!=folder, or missing required sections). It MUST pass before completion, and the generated tree must contain no non-exempt underscore path segment.\"\n431:     - \"Run python3 .skilled/skills/sk-doc/scripts/package_skill.py [skill_path]/[skill_name] --check --strict. The strict completion gate runs that check and rejects the old routing shape (RS-001 to RS-005): a SMART ROUTING section over 12 lines or 180 words, a '## MACHINE ROUTER' section left in SKILL.md, that section not last, a missing sibling ROUTER.md or one whose real path leaves the skill folder, and a SKILL.md with no relative link to ./ROUTER.md.\"\n432:     - Capture DQI score and quality band\n433:     - Enforce hard minimum threshold (75)\n434:     - Compare against operation target score\n435:     - Run fix-and-revalidate loop if needed\n436:     gate:\n437:       command: \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict\"\n438:       blocking: true\n439:     thresholds:\n440:       hard_minimum: 75\n441:       operation_targets:\n442:         full-create: 90\n443:         full-update: 90\n444:         reference-only: 80\n445:         asset-only: 80\n446:     fix_loop:\n447:       max_retries: 3\n448:       action: \"Apply fixes, rerun validation, stop on pass or hard failure\"\n449:     outputs:\n450:     - validation_passed\n451:     - dqi_score\n452:     - dqi_band\n453: \n454:   step_5_skill_integration:\n455:     purpose: Keep routing and references synchronized in SKILL.md\n456:     activities:\n457:     - \"Update SMART ROUTING references for new/changed docs, keeping the section at 8 to 12 lines of plain prose, the machine router in the sibling ROUTER.md, and the link to it current\"\n458:     - Keep WHEN TO USE free of file-path navigation content\n459:     - Remove stale links and outdated references\n460:     - Verify referenced files exist after update\n461:     outputs:\n462:     - skill_md_synced\n463:     - routing_links_valid\n464: \n465:   step_6_context_save_and_index:\n466:     purpose: Persist context with system-spec-kit compatibility\n467:     condition: \"spec_path exists\"\n468:     activities:\n469:     - Save context using generate-context.js\n470:     - Regenerate the trigger index when trigger_phrases changed\n471:     - Log the writer path and whether the trigger index was regenerated\n472:     write_continuity:\n473:       command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js [spec_path]\"\n474:       hard_rule: \"Do not create memory files manually\"\n475:     indexing:\n476:       preferred: \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs\"\n477:       note: \"generate-context.js writes the continuity frontmatter; the trigger index is regenerated from that frontmatter. There is no daemon to hand off to and no background indexing step to wait for.\"\n478:     outputs:\n479:     - context_saved\n480:     - context_indexed\n481: \n482:   step_7_completion:\n483:     purpose: Emit deterministic completion summary\n484:     activities:\n485:     - For full-create and full-update, provide human_voice_results and human_voice_passed to the presentation contract\n486:     completion_report_template: |\n487:       Unified Skill Workflow Complete\n488: \n489:       Skill: [skill_name]\n490:       Operation: [operation]\n491:       Type: [type or N/A]\n492:       Mode: :auto\n493:       Target: [skill_root_or_target_file]\n494: \n495:       Validation:\n496:       - DQI: [dqi_score] ([dqi_band])\n497:       - Hard minimum: 75\n498:       - Operation target: [operation_target]\n499: \n500:       [operation == full-create or full-update:]\n501:       Advisor/Index Handoff (operator-owned; this command did not mutate advisor state; standalone scope — H-only fields omitted):\n502:       - graph-metadata.json: sole skill advisor identity; source for graph indexing\n503:       - leaf-manifest.json: [fresh|stale|missing]\n504:       - Refresh choice - run one when the advisor should include this change:\n505:         - Full advisor refresh: node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --workspace-root \"$PWD\" --format json\n506:         - Graph-only refresh: node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --skills-root \"$PWD/.skilled/skills\" --format json\n507:       - Refresh status: NOT RUN (operator-owned; see .skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md)\n508:       [operation == reference-only or asset-only:]\n509:       Leaf-manifest freshness: [fresh|stale|missing] (narrow signal only — see advisor-index-handoff.md § Branch Scope for why this branch does not render the full handoff)\n510: \n511:       Context:\n512:       - Spec path: [spec_path or none]\n513:       - Memory saved: [yes/no]\n514: \n515:       STATUS=OK PATH=[skill_root_or_target_file]\n516: \n517: violation_recovery:\n518:   setup_violation:\n519:     trigger: \"Missing required normalized fields\"\n520:     action:\n521:     - \"Stop\"\n522:     - \"State missing field(s)\"\n523:     - \"Return to setup\"\n524:   routing_violation:\n525:     trigger: \"Operation/type mismatch or wrong existence routing\"\n526:     action:\n527:     - \"Stop\"\n528:     - \"State routing correction\"\n529:     - \"Re-run operation router\"\n530:   validation_violation:\n531:     trigger: \"DQI below threshold or structural errors\"\n532:     action:\n533:     - \"Stop completion\"\n534:     - \"Run fix loop\"\n535:     - \"Revalidate\"\n536: \n537: error_recovery:\n538:   invalid_skill_name:\n539:     action: \"Require explicit hyphen-case skill_name\"\n540:   invalid_operation:\n541:     action: \"Require one of full-create/full-update/reference-only/asset-only\"\n542:   missing_type:\n543:     action: \"Require type for reference-only or asset-only\"\n544:   invalid_type:\n545:     action: \"Show allowed types for selected operation\"\n546:   skill_exists_on_create:\n547:     action: \"Offer reroute to full-update\"\n548:   skill_missing_on_update_or_doc:\n549:     action: \"Offer reroute to full-create or corrected name/path\"\n550:   template_load_failure:\n551:     action: \"Verify sk-doc template paths and retry\"\n552:   validation_failure:\n553:     action: \"Capture script output, fix, retry\"\n554:   integration_failure:\n555:     action: \"Repair SKILL.md links and rerun integration checks\"\n556: \n557: circuit_breaker:\n558:   consecutive_failure_threshold: 3\n559:   states:\n560:     closed: \"Normal operation\"\n561:     open: \"Stop and report failure summary\"\n562:     half_open: \"Single retry with stricter checks\"\n563:   on_open:\n564:     action: \"Stop workflow and return STATUS=FAIL\"\n565: \n566: termination:\n567:   after_step: step_7_completion\n568:   message: \"Unified sk-skill auto workflow complete.\"\n569:   next_steps:\n570:   - condition: \"Need iterative updates\"\n571:     action: \"/create:skill [skill-name] full-update :confirm\"\n572:   - condition: \"Need another reference\"\n573:     action: \"/create:skill [skill-name] reference-only [type] :confirm\"\n574:   - condition: \"Need another asset\"\n575:     action: \"/create:skill [skill-name] asset-only [type] :confirm\"\n576: \n577: rules:\n578:   ALWAYS:\n579:   - \"Enforce @markdown or valid chained handoff\"\n580:   - \"Use canonical operation router\"\n581:   - \"Load templates before writing\"\n582:   - \"Seed every authored .md from its template so frontmatter is present by construction (frontmatter_contract)\"\n583:   - \"Seed SMART ROUTING as 8 to 12 lines of plain prose with a link to ./ROUTER.md, and the machine router block in that sibling file under the final '## MACHINE ROUTER' heading, from skill-smart-router.md, on full-create\"\n584:   - \"Pass validate_skill_package.py before completion\"\n585:   - \"Run validation before completion\"\n586:   - \"Preserve WHEN TO USE vs SMART ROUTING boundaries\"\n587:   - \"Save memory context only through system-spec-kit workflow\"\n588:   NEVER:\n589:   - \"Split setup prompts across turns\"\n590:   - \"Infer missing operation/type values\"\n591:   - \"Bypass hard gates\"\n592:   - \"Write a references/ or assets/ .md without the full 5-field + version frontmatter\"\n593:   - \"Ship a SMART ROUTING section over 12 lines, leave a machine router section in SKILL.md, or omit the sibling ROUTER.md or its link\"\n594:   - \"Use non-kebab-case filenames in references/ or assets/\"\n595:   - \"Create memory files manually\"\n596:   - \"Leave stale routing links in SKILL.md\""}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-auto.yaml\"}"},"time":{"start":1794582799093,"end":1794582799412}}}}
{"type":"tool_use","timestamp":1794582799426,"sessionID":"ses_e2a8827beffe2WRM5fapKnxmNx","part":{"partID":"prt_1d5786365001itDljJkjDw2UR2","sessionID":"ses_e2a8827beffe2WRM5fapKnxmNx","messageID":"msg_1d5785be40012PpYukfhFlggdM","type":"tool","id":"call_01_aY0QLpBwd9I4lyj1mP5w6758","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-confirm.yaml"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-confirm.yaml, lines 1-652\n1: # ─────────────────────────────────────────────────────────────────\n2: # OPENCODE CREATE: SK-SKILL UNIFIED WORKFLOW (CONFIRM MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # Mode: interactive execution with explicit checkpoints\n5: # Entrypoint: /create:skill\n6: # Operations: full-create | full-update | reference-only | asset-only\n7: # ─────────────────────────────────────────────────────────────────\n8: \n9: role: Unified Skill Creator using sk-doc\n10: purpose: Execute a canonical checkpointed workflow for skill creation and skill document updates\n11: action: Route one operation branch with user checkpoints, hard gates, and validation loops\n12: \n13: # ─────────────────────────────────────────────────────────────────\n14: # PREREQUISITE: @markdown AGENT VERIFICATION\n15: # ─────────────────────────────────────────────────────────────────\n16: # This workflow REQUIRES the @markdown agent for:\n17: #   - Template-first generation\n18: #   - sk-doc standards enforcement\n19: #   - Root document validation\n20: #\n21: # The command markdown verifies the @markdown agent BEFORE\n22: # this YAML workflow loads. If you are executing this workflow,\n23: # @markdown verification has already passed.\n24: # ─────────────────────────────────────────────────────────────────\n25: \n26: operating_mode:\n27:   workflow: unified_7_step\n28:   workflow_compliance: MANDATORY\n29:   workflow_execution: interactive\n30:   approvals: step_by_step\n31:   tracking: checkpoint_decision_log\n32:   validation: checkpoint_based\n33:   supports_operations:\n34:     - full-create\n35:     - full-update\n36:     - reference-only\n37:     - asset-only\n38:   description: |\n39:     Executes the 7-step skill creation workflow with approval gates at each checkpoint.\n40:     User confirms, reviews, or modifies at each step before the workflow advances.\n41: \n42: development_philosophy:\n43:   principle: \"Interactive confidence comes from explicit checkpoints and clear branch contracts\"\n44:   approach: \"Normalize -> Resolve -> Execute -> Validate -> Integrate -> Persist\"\n45:   mandate: \"Never continue past a checkpoint without an explicit outcome\"\n46: \n47: runtime_agent_path_resolution:\n48:   default: .skilled/agents\n49:   claude: .claude/agents\n50: \n51: # ─────────────────────────────────────────────────────────────────\n52: # CONFIDENCE & CLARIFICATION FRAMEWORK\n53: # ─────────────────────────────────────────────────────────────────\n54: confidence_framework:\n55:   thresholds:\n56:     high: { range: \"80-100%\", action: \"Proceed with standard checkpointing\" }\n57:     medium: { range: \"40-79%\", action: \"Proceed with caution and highlight assumptions\" }\n58:     low: { range: \"0-39%\", action: \"Pause and request clarification before next checkpoint\" }\n59:   scoring_weights:\n60:     input_completeness: 0.35\n61:     routing_clarity: 0.25\n62:     template_alignment: 0.20\n63:     validation_readiness: 0.20\n64:   low_confidence_behavior:\n65:     action: \"Return to setup gate or current step with explicit correction options\"\n66: \n67: # ─────────────────────────────────────────────────────────────────\n68: # REQUEST ANALYSIS FRAMEWORK\n69: # ─────────────────────────────────────────────────────────────────\n70: request_analysis_framework:\n71:   solution_flow:\n72:     - \"Parse request shape and normalize fields\"\n73:     - \"Enforce operation/type compatibility\"\n74:     - \"Resolve target path and existence semantics\"\n75:     - \"Execute selected branch with template-first behavior\"\n76:     - \"Run validation and DQI checks\"\n77:     - \"Integrate SKILL.md routing updates\"\n78:     - \"Persist context and finalize\"\n79:   pre_change_validation:\n80:     items:\n81:       - \"create_agent_verified present\"\n82:       - \"skill_name present and valid\"\n83:       - \"operation present and supported\"\n84:       - \"type present if required\"\n85:       - \"execution_mode is :confirm\"\n86:     stop_conditions:\n87:       - \"Missing required item\"\n88:       - \"Operation/type mismatch\"\n89:     stop_action: \"STOP and return to setup\"\n90: \n91: checkpoint_options:\n92:   proceed:\n93:     label: \"Proceed\"\n94:     description: \"Approve and continue\"\n95:   review:\n96:     label: \"Review\"\n97:     description: \"Show details before deciding\"\n98:   modify:\n99:     label: \"Modify\"\n100:     description: \"Change current step output and re-run checks\"\n101:   abort:\n102:     label: \"Abort\"\n103:     description: \"Stop workflow immediately\"\n104: \n105: # ─────────────────────────────────────────────────────────────────\n106: # CONTEXT LOADING\n107: # ─────────────────────────────────────────────────────────────────\n108: context_loading:\n109:   trigger: \"During UNIFIED SETUP PHASE, when memory_choice is answered (Q4 if applicable) and prior context exists\"\n110:   applies_when: \"spec_path resolves to an existing spec folder (Q3 choice A - Existing, or C - Related) that contains handover.md or _memory.continuity in implementation-summary.md; not applicable to a freshly created spec folder (Q3 choice B - New) or when spec_choice is D (Skip)\"\n111:   continuity_ladder:\n112:     note: \"Read the packet's own files in order. No background service is involved.\"\n113:     order:\n114:       - \"Read {spec_path}/handover.md when present and recent\"\n115:       - \"Read the _memory.continuity frontmatter block in {spec_path}/implementation-summary.md\"\n116:       - \"Read the packet-first canonical spec docs: spec.md, plan.md, tasks.md, decision-record.md\"\n117:       - \"Only for a still-missing named gap, run the packet-scoped context recipe from .skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md section 2.4 with {spec_path} as the search root\"\n118:     unsupported: \"Semantic paraphrase, vector and BM25 fusion, decay, access tracking and session dedup are not available. The ladder is lexical and file-local; a miss is a clean no-hit reported as such, never a guess.\"\n119:   behavior:\n120:     memory_choice_A: \"Load handover.md (if <24h old) plus _memory.continuity from implementation-summary.md in {spec_path}; sets memory_loaded: handover+continuity\"\n121:     memory_choice_B: \"Load canonical spec docs (tasks.md, plan.md, decision-record.md) in {spec_path} up to a recent cap (3 most recently modified); sets memory_loaded: spec-docs\"\n122:     memory_choice_C: \"Skip context loading; sets memory_loaded: skipped\"\n123:   when_to_skip: [\"New spec folder (spec_choice == B, Create new) with no prior context\", \"spec_choice == D (Skip documentation)\", \"User says 'skip context' or 'fresh start'\"]\n124:   output: memory_loaded\n125: \n126: checkpoint_decision_matrix:\n127:   proceed:\n128:     action: \"Advance to next step\"\n129:   review:\n130:     action: \"Display details and remain at same checkpoint\"\n131:   modify:\n132:     action: \"Apply requested modifications and re-validate current step\"\n133:   abort:\n134:     action: \"Return STATUS=CANCELLED and stop\"\n135: \n136: input_contract:\n137:   required:\n138:     - create_agent_verified\n139:     - skill_name\n140:     - operation\n141:     - execution_mode\n142:   conditional:\n143:     type_required_for:\n144:       - reference-only\n145:       - asset-only\n146:     spec_choice_required_for:\n147:       - full-create\n148:       - full-update\n149:   optional:\n150:     - skill_path\n151:     - spec_choice\n152:     - spec_path\n153:     - memory_choice\n154:     - chained\n155:     - parent_write_verified\n156: \n157: defaults:\n158:   skill_path: .skilled/skills/\n159:   execution_mode: :confirm\n160:   dqi_hard_minimum: 75\n161:   dqi_targets:\n162:     full-create: 90\n163:     full-update: 90\n164:     reference-only: 80\n165:     asset-only: 80\n166: \n167: operation_router:\n168:   full-create:\n169:     requires_type: false\n170:     requires_existing_skill: false\n171:     forbidden_if_skill_exists: true\n172:   full-update:\n173:     requires_type: false\n174:     requires_existing_skill: true\n175:     forbidden_if_skill_exists: false\n176:   reference-only:\n177:     requires_type: true\n178:     allowed_types:\n179:       - workflow\n180:       - patterns\n181:       - debugging\n182:       - tools\n183:       - quick_ref\n184:     requires_existing_skill: true\n185:   asset-only:\n186:     requires_type: true\n187:     allowed_types:\n188:       - template\n189:       - lookup\n190:       - example\n191:       - guide\n192:     requires_existing_skill: true\n193: \n194: operation_profiles:\n195:   full-create:\n196:     objective: \"Create a new skill with complete baseline artifacts\"\n197:   full-update:\n198:     objective: \"Update existing skill content without regressions\"\n199:   reference-only:\n200:     objective: \"Create or update one reference document\"\n201:   asset-only:\n202:     objective: \"Create or update one asset document\"\n203: \n204: template_sources:\n205:   skill_md: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-md-template.md\n206:   skill_reference: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-reference-template.md\n207:   skill_asset: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-asset-template.md\n208:   skill_smart_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-smart-router.md\n209:   skill_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-router-template.md\n210:   skill_readme: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-readme-template.md\n211: \n212: frontmatter_contract:\n213:   rule: \"Every authored .md ships frontmatter from its template before completion.\"\n214:   skill_md:\n215:     required_fields: [name, description, allowed-tools, version]\n216:     version_format: \"4-part X.Y.Z.W\"\n217:     name_rule: \"hyphen-case, matches folder name\"\n218:   references_and_assets:\n219:     seed_from: [skill_reference, skill_asset]\n220:     required_fields: [title, description, trigger_phrases, importance_tier, contextType, version]\n221:     trigger_phrases: \"3-8 lowercase multi-word phrases\"\n222:     version_format: \"4-part X.Y.Z.W\"\n223:     filename_rule: \"kebab-case for every non-exempt filesystem name\"\n224:   readme:\n225:     seed_from: skill_readme\n226:     required_fields: [title, description, version]\n227:   enforcement: \"package_skill.py --check hard-fails missing version / non-4-part version / name!=folder; generated references/ and assets/ filenames must use kebab-case\"\n228: \n229: validation_scripts:\n230:   quick_validate: .skilled/skills/sk-doc/scripts/quick_validate.py\n231:   validate_document: .skilled/skills/sk-doc/scripts/validate_document.py\n232:   extract_structure: .skilled/skills/sk-doc/scripts/extract_structure.py\n233:   package_skill: .skilled/skills/sk-doc/scripts/package_skill.py\n234:   validate_skill_package: .skilled/skills/sk-doc/scripts/validate_skill_package.py\n235: \n236: quality_standards:\n237:   template_first: required\n238:   sk_doc_alignment: required\n239:   section_boundary_rules:\n240:     when_to_use: \"activation and use-case logic only\"\n241:     smart_routing: \"8 to 12 lines of plain prose, and the machine router lives in the sibling ROUTER.md under a final '## MACHINE ROUTER' heading\"\n242:   validation_pipeline:\n243:     full_flows:\n244:       - \"python3 .skilled/skills/sk-doc/scripts/quick_validate.py [skill_path]/[skill_name] --json\"\n245:       - \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name]\"\n246:       - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [skill_path]/[skill_name]/SKILL.md\"\n247:     doc_only_flows:\n248:       - \"python3 .skilled/skills/sk-doc/scripts/validate_document.py [target_file]\"\n249:       - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [target_file]\"\n250:   dqi_policy:\n251:     hard_minimum: 75\n252:     target_by_operation:\n253:       full-create: 90\n254:       full-update: 90\n255:       reference-only: 80\n256:       asset-only: 80\n257: \n258: gate_logic:\n259:   hard:\n260:     H0_write_or_chained:\n261:       description: \"create_agent_verified must be true or skipped-chained with valid parent marker\"\n262:       fail_action: \"STOP and return to setup\"\n263:     H1_required_fields:\n264:       description: \"All required input fields must be present\"\n265:       fail_action: \"STOP and collect missing fields\"\n266:     H2_operation_type_compatibility:\n267:       description: \"Operation must be supported; type must match operation rules\"\n268:       fail_action: \"STOP and request correction\"\n269:     H3_existence_semantics:\n270:       description: \"Create requires non-existing skill; update/doc-only require existing skill\"\n271:       fail_action: \"STOP and reroute or correct target\"\n272:     H4_validation_gate:\n273:       description: \"DQI >= hard minimum and structural checks pass\"\n274:       fail_action: \"Run fix-and-revalidate loop\"\n275:     H4b_human_voice_gate:\n276:       description: \"No HVR hard blockers and every absolute score >= 85\"\n277:       fail_action: \"Revise or rewrite, re-run hvr_scan.py, then revalidate\"\n278:   soft:\n279:     S1_similarity_discovery:\n280:       description: \"Warn on similar existing skills before full-create\"\n281:       fail_action: \"Warn only\"\n282:     S2_resource_recommendation:\n283:       description: \"Suggest additional references/assets based on output gaps\"\n284:       fail_action: \"Skip suggestion\"\n285: \n286: interactive_execution:\n287:   principle: \"Pause at each checkpoint and wait for explicit decision\"\n288:   user_feedback_handling:\n289:     proceed: \"Continue to next step\"\n290:     review: \"Display details and remain at current step\"\n291:     modify: \"Revise and re-validate current step\"\n292:     abort: \"Cancel workflow\"\n293: \n294: workflow_overview:\n295:   steps:\n296:     - id: step_1_preflight\n297:       purpose: \"Normalize inputs and enforce H0-H2\"\n298:     - id: step_2_target_resolution\n299:       purpose: \"Resolve target path and enforce H3\"\n300:     - id: step_3_operation_execution\n301:       purpose: \"Run one operation branch\"\n302:     - id: step_3b_human_voice_score\n303:       purpose: \"Score authored skill documents before validation\"\n304:     - id: step_4_validation_and_quality\n305:       purpose: \"Enforce H4 and DQI policy\"\n306:     - id: step_5_skill_integration\n307:       purpose: \"Sync SKILL.md routing references\"\n308:     - id: step_6_context_save_and_index\n309:       purpose: \"Save and index context when spec path exists\"\n310:     - id: step_7_completion\n311:       purpose: \"Emit deterministic completion report\"\n312: \n313: workflow:\n314:   step_1_preflight:\n315:     purpose: Normalize and verify required fields\n316:     activities:\n317:       - Normalize skill_path to default when omitted\n318:       - Normalize operation token to supported value\n319:       - Validate type for reference-only/asset-only\n320:       - Validate execution_mode is :confirm\n321:       - Validate chained handoff completeness if chained=true\n322:       - Resolve memory_choice via the context_loading block (Q4 if applicable); record result as memory_loaded\n323:     outputs:\n324:       - normalized_inputs\n325:       - preflight_passed\n326:     checkpoint:\n327:       question: \"Preflight complete for [skill_name] using [operation]. Continue?\"\n328:       options:\n329:         - proceed\n330:         - review\n331:         - modify\n332:         - abort\n333: \n334:   step_2_target_resolution:\n335:     purpose: Resolve target paths and enforce create/update semantics\n336:     activities:\n337:       - Resolve skill_root as \"[skill_path]/[skill_name]\"\n338:       - Check target existence\n339:       - Block full-create when skill already exists\n340:       - Block full-update/reference-only/asset-only when skill is missing\n341:       - For full-create, run similarity discovery and present findings\n342:     checks:\n343:       exists_command: \"ls -d [skill_path]/[skill_name] 2>/dev/null\"\n344:     outputs:\n345:       - skill_root\n346:       - existence_verified\n347:       - similarity_findings\n348:     checkpoint:\n349:       question: \"Target resolution complete. Continue with selected operation?\"\n350:       options:\n351:         - proceed\n352:         - review\n353:         - modify\n354:         - abort\n355: \n356:   step_3_operation_execution:\n357:     purpose: Execute selected operation branch\n358:     branches:\n359:       full-create:\n360:         activities:\n361:           - Run init script: \"python3 .skilled/skills/sk-doc/scripts/init_skill.py [skill_name] --path [skill_path]\"\n362:           - >-\n363:             Read the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n364:             before writing SKILL.md and README.md.\n365:           - Load SKILL.md template and populate required sections\n366:           - Apply section boundary rules\n367:           - \"Seed SKILL.md Section 2 (SMART ROUTING) as 8 to 12 lines of plain prose that say what selects this skill, what it loads first, and that the machine router lives in the sibling ROUTER.md. Take the machine router block (INTENT_SIGNALS and RESOURCE_MAP) from skill-smart-router.md, keep its four resilience patterns (runtime discovery, existence-check-before-load, extensible routing key, multi-tier fallback), adapt the routing key and resource map to this skill, and write the block to ROUTER.md under a final '## MACHINE ROUTER' heading. Add the relative markdown link to ./ROUTER.md in SMART ROUTING. A SMART ROUTING section over 12 lines, a machine router section left in SKILL.md, or a missing ROUTER.md link fails this branch.\"\n368:           - \"Set SKILL.md frontmatter per frontmatter_contract.skill_md: name (==folder), description, allowed-tools, version (4-part X.Y.Z.W)\"\n369:           - \"Create baseline references/assets/scripts from requested scope. Seed every references/*.md from skill_reference and every assets/*.md from skill_asset so each ships the full 5-field + version frontmatter; name non-exempt files in kebab-case. Create README.md from skill_readme if the initializer did not emit it, with title, description, and version.\"\n370:           - Remove placeholders and sample-only content\n371:         outputs:\n372:           - skill_scaffolded\n373:           - skill_content_written\n374:           - smart_router_pseudocode_seeded\n375:           - resources_written\n376: \n377:       full-update:\n378:         activities:\n379:           - Read existing SKILL.md and targeted resource files\n380:           - >-\n381:             Read and apply the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n382:             before editing SKILL.md or README.md.\n383:           - Update requested sections only\n384:           - Preserve existing folder and naming conventions\n385:           - Remove stale references in updated sections\n386:           - \"Run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] to report leaf-manifest.json freshness (fresh|stale|missing) for the completion handoff. This is a read-only drift check, not regeneration — full-update never ran the class-metadata gate, so unlike full-create it cannot assume freshness and must measure it\"\n387:         outputs:\n388:           - skill_updates_applied\n389:           - resource_updates_applied\n390:           - leaf_manifest_freshness_checked\n391: \n392:       reference-only:\n393:         activities:\n394:           - Ensure references/ exists\n395:           - \"Determine reference filename from type and topic; filename MUST be kebab-case\"\n396:           - \"Create or update reference doc seeded from skill_reference template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n397:           - Ensure content depth matches type profile\n398:           - \"references/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n399:         type_templates:\n400:           workflow: { filename_pattern: \"[topic]-workflow.md\" }\n401:           patterns: { filename_pattern: \"[topic]-patterns.md\" }\n402:           debugging: { filename_pattern: \"[topic]-debugging.md\" }\n403:           tools: { filename_pattern: \"[tool]-guide.md\" }\n404:           quick_ref: { filename_pattern: \"quick-reference.md\" }\n405:         outputs:\n406:           - reference_file_written\n407:           - leaf_manifest_freshness_signal\n408: \n409:       asset-only:\n410:         activities:\n411:           - Ensure assets/ exists\n412:           - \"Determine asset filename from type and topic; filename MUST be kebab-case\"\n413:           - \"Create or update asset doc seeded from skill_asset template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n414:           - Ensure examples are practical and immediately reusable\n415:           - \"assets/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n416:         type_templates:\n417:           template: { filename_pattern: \"[topic]-templates.md\" }\n418:           lookup: { filename_pattern: \"[topic]-lookup.md\" }\n419:           example: { filename_pattern: \"[topic]-examples.md\" }\n420:           guide: { filename_pattern: \"[topic]-guide.md\" }\n421:         outputs:\n422:           - asset_file_written\n423:           - leaf_manifest_freshness_signal\n424: \n425:     checkpoint:\n426:       question: \"Operation execution complete. Review artifacts before validation?\"\n427:       options:\n428:         - proceed\n429:         - review\n430:         - modify\n431:         - abort\n432: \n433:   step_3b_human_voice_score:\n434:     purpose: Score authored skill documents before strict validation\n435:     condition: \"operation is full-create or full-update\"\n436:     activities:\n437:       - Read `.skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md` and follow its score operation, scope gate, mechanical scan, judgment pass, scoring rules, and report shape\n438:       - \"Resolve scan targets from existing files only: full-create requires [skill_root]/SKILL.md and includes [skill_root]/README.md only when present; full-update includes each existing SKILL.md or README.md.\"\n439:       - \"Do not pass a missing path to hvr_scan.py; a missing full-create SKILL.md is a structural failure.\"\n440:       - \"For each target, run `python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]` without extra flags; capture its output and exit code.\"\n441:       - \"Exit 0 means no hard blockers, exit 1 means at least one hard blocker and blocks completion, and exit 2 means the scan could not run and blocks completion. Review the remaining findings for sense and scope, and record justified exceptions.\"\n442:       - \"Compute the score from 100 using first-match-wins. For files up to 400 lines, 85+ is publish-ready, 70-84 requires revision, and below 70 requires rewriting. For longer files, report hard-blocker count and deduction density instead of an absolute score.\"\n443:       - Record each target's scan output and exit code, confirmed blockers, score or length basis, judgment findings, exceptions, and verdict for the presentation\n444:       - \"A target passes only with no hard blockers and a score of at least 85 when an absolute score applies. Revise scores from 70 to 84 and rewrite scores below 70, then run the score operation again.\"\n445:       - \"When a target fails, revise its in-scope prose and repeat the score operation before validation. Stop when the scan exits 2 or a hard blocker remains.\"\n446:     outputs:\n447:       - human_voice_results\n448:       - human_voice_passed\n449:     gate:\n450:       command: \"python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]\"\n451:       blocking: true\n452: \n453:   step_4_validation_and_quality:\n454:     purpose: Enforce operation-specific validation and DQI targets\n455:     activities:\n456:       - Run operation-appropriate validation scripts\n457:       - \"Run the completion gate: python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict . This is the authoritative structural gate (hard-fails missing/non-4-part version, name!=folder, or missing required sections). It MUST pass before completion, and the generated tree must contain no non-exempt underscore path segment.\"\n458:       - \"Run python3 .skilled/skills/sk-doc/scripts/package_skill.py [skill_path]/[skill_name] --check --strict. The strict completion gate runs that check and rejects the old routing shape (RS-001 to RS-005): a SMART ROUTING section over 12 lines or 180 words, a '## MACHINE ROUTER' section left in SKILL.md, that section not last, a missing sibling ROUTER.md or one whose real path leaves the skill folder, and a SKILL.md with no relative link to ./ROUTER.md.\"\n459:       - Capture DQI score and quality band\n460:       - Enforce hard minimum threshold (75)\n461:       - Compare against operation target score\n462:       - Run fix-and-revalidate loop if needed\n463:       - \"Description budget check: quick_validate.py warns when description > 130 chars (skill) and hard-fails > 1536 chars. Soft-warning is non-blocking; hard-fail blocks the fix_loop.\"\n464:     gate:\n465:       command: \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict\"\n466:       blocking: true\n467:     thresholds:\n468:       hard_minimum: 75\n469:       operation_targets:\n470:         full-create: 90\n471:         full-update: 90\n472:         reference-only: 80\n473:         asset-only: 80\n474:       description_soft_target_skill: 130\n475:       description_soft_target_command: 110\n476:       description_hard_cap: 1536\n477:     fix_loop:\n478:       max_retries: 3\n479:       action: \"Apply fixes, rerun validation, stop on pass or hard failure. If quick_validate emits a description-length warning, surface the trim suggestion per .skilled/skills/sk-doc/sk-create-frontmatter/assets/frontmatter-templates.md § Description Budget & Trim Style.\"\n480:     outputs:\n481:       - validation_passed\n482:       - dqi_score\n483:       - dqi_band\n484:       - description_length_warnings\n485:     checkpoint:\n486:       question: \"Validation complete (DQI=[dqi_score], band=[dqi_band]). Continue?\"\n487:       options:\n488:         - proceed\n489:         - review\n490:         - modify\n491:         - abort\n492: \n493:   step_5_skill_integration:\n494:     purpose: Keep routing and references synchronized in SKILL.md\n495:     activities:\n496:       - \"Update SMART ROUTING references for new/changed docs, keeping the section at 8 to 12 lines of plain prose, the machine router in the sibling ROUTER.md, and the link to it current\"\n497:       - Keep WHEN TO USE free of file-path navigation content\n498:       - Remove stale links and outdated references\n499:       - Verify referenced files exist after update\n500:     outputs:\n501:       - skill_md_synced\n502:       - routing_links_valid\n503:     checkpoint:\n504:       question: \"SKILL.md routing synchronization complete. Continue to context save?\"\n505:       options:\n506:         - proceed\n507:         - review\n508:         - modify\n509:         - abort\n510: \n511:   step_6_context_save_and_index:\n512:     purpose: Persist context with system-spec-kit compatibility\n513:     condition: \"spec_path exists\"\n514:     activities:\n515:       - Save context using generate-context.js\n516:       - Regenerate the trigger index when trigger_phrases changed\n517:       - Log the writer path and whether the trigger index was regenerated\n518:     write_continuity:\n519:       command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js [spec_path]\"\n520:       hard_rule: \"Do not create memory files manually\"\n521:     indexing:\n522:       preferred: \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs\"\n523:       note: \"generate-context.js writes the continuity frontmatter; the trigger index is regenerated from that frontmatter. There is no daemon to hand off to and no background indexing step to wait for.\"\n524:     outputs:\n525:       - context_saved\n526:       - context_indexed\n527:     checkpoint:\n528:       question: \"Context persistence complete. Finalize workflow?\"\n529:       options:\n530:         - proceed\n531:         - review\n532:         - modify\n533:         - abort\n534: \n535:   step_7_completion:\n536:     purpose: Emit deterministic completion summary\n537:     activities:\n538:       - For full-create and full-update, provide human_voice_results and human_voice_passed to the presentation contract\n539:     completion_report_template: |\n540:       Unified Skill Workflow Complete\n541: \n542:       Skill: [skill_name]\n543:       Operation: [operation]\n544:       Type: [type or N/A]\n545:       Mode: :confirm\n546:       Target: [skill_root_or_target_file]\n547: \n548:       Validation:\n549:       - DQI: [dqi_score] ([dqi_band])\n550:       - Hard minimum: 75\n551:       - Operation target: [operation_target]\n552: \n553:       [operation == full-create or full-update:]\n554:       Advisor/Index Handoff (operator-owned; this command did not mutate advisor state; standalone scope — H-only fields omitted):\n555:       - graph-metadata.json: sole skill advisor identity; source for graph indexing\n556:       - leaf-manifest.json: [fresh|stale|missing]\n557:       - Refresh choice - run one when the advisor should include this change:\n558:         - Full advisor refresh: node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --workspace-root \"$PWD\" --format json\n559:         - Graph-only refresh: node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --skills-root \"$PWD/.skilled/skills\" --format json\n560:       - Refresh status: NOT RUN (operator-owned; see .skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md)\n561:       [operation == reference-only or asset-only:]\n562:       Leaf-manifest freshness: [fresh|stale|missing] (narrow signal only — see advisor-index-handoff.md § Branch Scope for why this branch does not render the full handoff)\n563: \n564:       Context:\n565:       - Spec path: [spec_path or none]\n566:       - Memory saved: [yes/no]\n567: \n568:       STATUS=OK PATH=[skill_root_or_target_file]\n569: \n570: violation_recovery:\n571:   setup_violation:\n572:     trigger: \"Missing required normalized fields\"\n573:     action:\n574:       - \"Stop\"\n575:       - \"State missing field(s)\"\n576:       - \"Return to setup\"\n577:   routing_violation:\n578:     trigger: \"Operation/type mismatch or wrong existence routing\"\n579:     action:\n580:       - \"Stop\"\n581:       - \"State routing correction\"\n582:       - \"Re-run operation router\"\n583:   validation_violation:\n584:     trigger: \"DQI below threshold or structural errors\"\n585:     action:\n586:       - \"Stop completion\"\n587:       - \"Run fix loop\"\n588:       - \"Revalidate\"\n589: \n590: error_recovery:\n591:   invalid_skill_name:\n592:     action: \"Require explicit hyphen-case skill_name\"\n593:   invalid_operation:\n594:     action: \"Require one of full-create/full-update/reference-only/asset-only\"\n595:   missing_type:\n596:     action: \"Require type for reference-only or asset-only\"\n597:   invalid_type:\n598:     action: \"Show allowed types for selected operation\"\n599:   skill_exists_on_create:\n600:     action: \"Offer reroute to full-update\"\n601:   skill_missing_on_update_or_doc:\n602:     action: \"Offer reroute to full-create or corrected name/path\"\n603:   template_load_failure:\n604:     action: \"Verify sk-doc template paths and retry\"\n605:   validation_failure:\n606:     action: \"Capture script output, fix, retry\"\n607:   integration_failure:\n608:     action: \"Repair SKILL.md links and rerun integration checks\"\n609:   user_abort:\n610:     action: \"Return STATUS=CANCELLED\"\n611: \n612: circuit_breaker:\n613:   consecutive_failure_threshold: 3\n614:   states:\n615:     closed: \"Normal operation\"\n616:     open: \"Stop and report failure summary\"\n617:     half_open: \"Single retry with stricter checks\"\n618:   on_open:\n619:     action: \"Stop workflow and return STATUS=FAIL\"\n620: \n621: termination:\n622:   after_step: step_7_completion\n623:   message: \"Unified sk-skill confirm workflow complete.\"\n624:   next_steps:\n625:     - condition: \"Need iterative updates\"\n626:       action: \"/create:skill [skill-name] full-update :confirm\"\n627:     - condition: \"Need another reference\"\n628:       action: \"/create:skill [skill-name] reference-only [type] :confirm\"\n629:     - condition: \"Need another asset\"\n630:       action: \"/create:skill [skill-name] asset-only [type] :confirm\"\n631: \n632: rules:\n633:   ALWAYS:\n634:     - \"Enforce @markdown or valid chained handoff\"\n635:     - \"Use canonical operation router\"\n636:     - \"Pause for explicit checkpoint decisions\"\n637:     - \"Load templates before writing\"\n638:     - \"Seed every authored .md from its template so frontmatter is present by construction (frontmatter_contract)\"\n639:     - \"Seed SMART ROUTING as 8 to 12 lines of plain prose with a link to ./ROUTER.md, and the machine router block in that sibling file under the final '## MACHINE ROUTER' heading, from skill-smart-router.md, on full-create\"\n640:     - \"Pass validate_skill_package.py before completion\"\n641:     - \"Run validation before completion\"\n642:     - \"Preserve WHEN TO USE vs SMART ROUTING boundaries\"\n643:     - \"Save memory context only through system-spec-kit workflow\"\n644:   NEVER:\n645:     - \"Split setup prompts across turns\"\n646:     - \"Infer missing operation/type values\"\n647:     - \"Bypass hard gates\"\n648:     - \"Write a references/ or assets/ .md without the full 5-field + version frontmatter\"\n649:     - \"Ship a SMART ROUTING section over 12 lines, leave a machine router section in SKILL.md, or omit the sibling ROUTER.md or its link\"\n650:     - \"Use non-kebab-case filenames in references/ or assets/\"\n651:     - \"Create memory files manually\"\n652:     - \"Leave stale routing links in SKILL.md\"","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-confirm.yaml, lines 1-652\n1: # ─────────────────────────────────────────────────────────────────\n2: # OPENCODE CREATE: SK-SKILL UNIFIED WORKFLOW (CONFIRM MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # Mode: interactive execution with explicit checkpoints\n5: # Entrypoint: /create:skill\n6: # Operations: full-create | full-update | reference-only | asset-only\n7: # ─────────────────────────────────────────────────────────────────\n8: \n9: role: Unified Skill Creator using sk-doc\n10: purpose: Execute a canonical checkpointed workflow for skill creation and skill document updates\n11: action: Route one operation branch with user checkpoints, hard gates, and validation loops\n12: \n13: # ─────────────────────────────────────────────────────────────────\n14: # PREREQUISITE: @markdown AGENT VERIFICATION\n15: # ─────────────────────────────────────────────────────────────────\n16: # This workflow REQUIRES the @markdown agent for:\n17: #   - Template-first generation\n18: #   - sk-doc standards enforcement\n19: #   - Root document validation\n20: #\n21: # The command markdown verifies the @markdown agent BEFORE\n22: # this YAML workflow loads. If you are executing this workflow,\n23: # @markdown verification has already passed.\n24: # ─────────────────────────────────────────────────────────────────\n25: \n26: operating_mode:\n27:   workflow: unified_7_step\n28:   workflow_compliance: MANDATORY\n29:   workflow_execution: interactive\n30:   approvals: step_by_step\n31:   tracking: checkpoint_decision_log\n32:   validation: checkpoint_based\n33:   supports_operations:\n34:     - full-create\n35:     - full-update\n36:     - reference-only\n37:     - asset-only\n38:   description: |\n39:     Executes the 7-step skill creation workflow with approval gates at each checkpoint.\n40:     User confirms, reviews, or modifies at each step before the workflow advances.\n41: \n42: development_philosophy:\n43:   principle: \"Interactive confidence comes from explicit checkpoints and clear branch contracts\"\n44:   approach: \"Normalize -> Resolve -> Execute -> Validate -> Integrate -> Persist\"\n45:   mandate: \"Never continue past a checkpoint without an explicit outcome\"\n46: \n47: runtime_agent_path_resolution:\n48:   default: .skilled/agents\n49:   claude: .claude/agents\n50: \n51: # ─────────────────────────────────────────────────────────────────\n52: # CONFIDENCE & CLARIFICATION FRAMEWORK\n53: # ─────────────────────────────────────────────────────────────────\n54: confidence_framework:\n55:   thresholds:\n56:     high: { range: \"80-100%\", action: \"Proceed with standard checkpointing\" }\n57:     medium: { range: \"40-79%\", action: \"Proceed with caution and highlight assumptions\" }\n58:     low: { range: \"0-39%\", action: \"Pause and request clarification before next checkpoint\" }\n59:   scoring_weights:\n60:     input_completeness: 0.35\n61:     routing_clarity: 0.25\n62:     template_alignment: 0.20\n63:     validation_readiness: 0.20\n64:   low_confidence_behavior:\n65:     action: \"Return to setup gate or current step with explicit correction options\"\n66: \n67: # ─────────────────────────────────────────────────────────────────\n68: # REQUEST ANALYSIS FRAMEWORK\n69: # ─────────────────────────────────────────────────────────────────\n70: request_analysis_framework:\n71:   solution_flow:\n72:     - \"Parse request shape and normalize fields\"\n73:     - \"Enforce operation/type compatibility\"\n74:     - \"Resolve target path and existence semantics\"\n75:     - \"Execute selected branch with template-first behavior\"\n76:     - \"Run validation and DQI checks\"\n77:     - \"Integrate SKILL.md routing updates\"\n78:     - \"Persist context and finalize\"\n79:   pre_change_validation:\n80:     items:\n81:       - \"create_agent_verified present\"\n82:       - \"skill_name present and valid\"\n83:       - \"operation present and supported\"\n84:       - \"type present if required\"\n85:       - \"execution_mode is :confirm\"\n86:     stop_conditions:\n87:       - \"Missing required item\"\n88:       - \"Operation/type mismatch\"\n89:     stop_action: \"STOP and return to setup\"\n90: \n91: checkpoint_options:\n92:   proceed:\n93:     label: \"Proceed\"\n94:     description: \"Approve and continue\"\n95:   review:\n96:     label: \"Review\"\n97:     description: \"Show details before deciding\"\n98:   modify:\n99:     label: \"Modify\"\n100:     description: \"Change current step output and re-run checks\"\n101:   abort:\n102:     label: \"Abort\"\n103:     description: \"Stop workflow immediately\"\n104: \n105: # ─────────────────────────────────────────────────────────────────\n106: # CONTEXT LOADING\n107: # ─────────────────────────────────────────────────────────────────\n108: context_loading:\n109:   trigger: \"During UNIFIED SETUP PHASE, when memory_choice is answered (Q4 if applicable) and prior context exists\"\n110:   applies_when: \"spec_path resolves to an existing spec folder (Q3 choice A - Existing, or C - Related) that contains handover.md or _memory.continuity in implementation-summary.md; not applicable to a freshly created spec folder (Q3 choice B - New) or when spec_choice is D (Skip)\"\n111:   continuity_ladder:\n112:     note: \"Read the packet's own files in order. No background service is involved.\"\n113:     order:\n114:       - \"Read {spec_path}/handover.md when present and recent\"\n115:       - \"Read the _memory.continuity frontmatter block in {spec_path}/implementation-summary.md\"\n116:       - \"Read the packet-first canonical spec docs: spec.md, plan.md, tasks.md, decision-record.md\"\n117:       - \"Only for a still-missing named gap, run the packet-scoped context recipe from .skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md section 2.4 with {spec_path} as the search root\"\n118:     unsupported: \"Semantic paraphrase, vector and BM25 fusion, decay, access tracking and session dedup are not available. The ladder is lexical and file-local; a miss is a clean no-hit reported as such, never a guess.\"\n119:   behavior:\n120:     memory_choice_A: \"Load handover.md (if <24h old) plus _memory.continuity from implementation-summary.md in {spec_path}; sets memory_loaded: handover+continuity\"\n121:     memory_choice_B: \"Load canonical spec docs (tasks.md, plan.md, decision-record.md) in {spec_path} up to a recent cap (3 most recently modified); sets memory_loaded: spec-docs\"\n122:     memory_choice_C: \"Skip context loading; sets memory_loaded: skipped\"\n123:   when_to_skip: [\"New spec folder (spec_choice == B, Create new) with no prior context\", \"spec_choice == D (Skip documentation)\", \"User says 'skip context' or 'fresh start'\"]\n124:   output: memory_loaded\n125: \n126: checkpoint_decision_matrix:\n127:   proceed:\n128:     action: \"Advance to next step\"\n129:   review:\n130:     action: \"Display details and remain at same checkpoint\"\n131:   modify:\n132:     action: \"Apply requested modifications and re-validate current step\"\n133:   abort:\n134:     action: \"Return STATUS=CANCELLED and stop\"\n135: \n136: input_contract:\n137:   required:\n138:     - create_agent_verified\n139:     - skill_name\n140:     - operation\n141:     - execution_mode\n142:   conditional:\n143:     type_required_for:\n144:       - reference-only\n145:       - asset-only\n146:     spec_choice_required_for:\n147:       - full-create\n148:       - full-update\n149:   optional:\n150:     - skill_path\n151:     - spec_choice\n152:     - spec_path\n153:     - memory_choice\n154:     - chained\n155:     - parent_write_verified\n156: \n157: defaults:\n158:   skill_path: .skilled/skills/\n159:   execution_mode: :confirm\n160:   dqi_hard_minimum: 75\n161:   dqi_targets:\n162:     full-create: 90\n163:     full-update: 90\n164:     reference-only: 80\n165:     asset-only: 80\n166: \n167: operation_router:\n168:   full-create:\n169:     requires_type: false\n170:     requires_existing_skill: false\n171:     forbidden_if_skill_exists: true\n172:   full-update:\n173:     requires_type: false\n174:     requires_existing_skill: true\n175:     forbidden_if_skill_exists: false\n176:   reference-only:\n177:     requires_type: true\n178:     allowed_types:\n179:       - workflow\n180:       - patterns\n181:       - debugging\n182:       - tools\n183:       - quick_ref\n184:     requires_existing_skill: true\n185:   asset-only:\n186:     requires_type: true\n187:     allowed_types:\n188:       - template\n189:       - lookup\n190:       - example\n191:       - guide\n192:     requires_existing_skill: true\n193: \n194: operation_profiles:\n195:   full-create:\n196:     objective: \"Create a new skill with complete baseline artifacts\"\n197:   full-update:\n198:     objective: \"Update existing skill content without regressions\"\n199:   reference-only:\n200:     objective: \"Create or update one reference document\"\n201:   asset-only:\n202:     objective: \"Create or update one asset document\"\n203: \n204: template_sources:\n205:   skill_md: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-md-template.md\n206:   skill_reference: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-reference-template.md\n207:   skill_asset: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-asset-template.md\n208:   skill_smart_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-smart-router.md\n209:   skill_router: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-router-template.md\n210:   skill_readme: .skilled/skills/sk-doc/sk-create-skill/assets/skill/skill-readme-template.md\n211: \n212: frontmatter_contract:\n213:   rule: \"Every authored .md ships frontmatter from its template before completion.\"\n214:   skill_md:\n215:     required_fields: [name, description, allowed-tools, version]\n216:     version_format: \"4-part X.Y.Z.W\"\n217:     name_rule: \"hyphen-case, matches folder name\"\n218:   references_and_assets:\n219:     seed_from: [skill_reference, skill_asset]\n220:     required_fields: [title, description, trigger_phrases, importance_tier, contextType, version]\n221:     trigger_phrases: \"3-8 lowercase multi-word phrases\"\n222:     version_format: \"4-part X.Y.Z.W\"\n223:     filename_rule: \"kebab-case for every non-exempt filesystem name\"\n224:   readme:\n225:     seed_from: skill_readme\n226:     required_fields: [title, description, version]\n227:   enforcement: \"package_skill.py --check hard-fails missing version / non-4-part version / name!=folder; generated references/ and assets/ filenames must use kebab-case\"\n228: \n229: validation_scripts:\n230:   quick_validate: .skilled/skills/sk-doc/scripts/quick_validate.py\n231:   validate_document: .skilled/skills/sk-doc/scripts/validate_document.py\n232:   extract_structure: .skilled/skills/sk-doc/scripts/extract_structure.py\n233:   package_skill: .skilled/skills/sk-doc/scripts/package_skill.py\n234:   validate_skill_package: .skilled/skills/sk-doc/scripts/validate_skill_package.py\n235: \n236: quality_standards:\n237:   template_first: required\n238:   sk_doc_alignment: required\n239:   section_boundary_rules:\n240:     when_to_use: \"activation and use-case logic only\"\n241:     smart_routing: \"8 to 12 lines of plain prose, and the machine router lives in the sibling ROUTER.md under a final '## MACHINE ROUTER' heading\"\n242:   validation_pipeline:\n243:     full_flows:\n244:       - \"python3 .skilled/skills/sk-doc/scripts/quick_validate.py [skill_path]/[skill_name] --json\"\n245:       - \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name]\"\n246:       - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [skill_path]/[skill_name]/SKILL.md\"\n247:     doc_only_flows:\n248:       - \"python3 .skilled/skills/sk-doc/scripts/validate_document.py [target_file]\"\n249:       - \"python3 .skilled/skills/sk-doc/scripts/extract_structure.py [target_file]\"\n250:   dqi_policy:\n251:     hard_minimum: 75\n252:     target_by_operation:\n253:       full-create: 90\n254:       full-update: 90\n255:       reference-only: 80\n256:       asset-only: 80\n257: \n258: gate_logic:\n259:   hard:\n260:     H0_write_or_chained:\n261:       description: \"create_agent_verified must be true or skipped-chained with valid parent marker\"\n262:       fail_action: \"STOP and return to setup\"\n263:     H1_required_fields:\n264:       description: \"All required input fields must be present\"\n265:       fail_action: \"STOP and collect missing fields\"\n266:     H2_operation_type_compatibility:\n267:       description: \"Operation must be supported; type must match operation rules\"\n268:       fail_action: \"STOP and request correction\"\n269:     H3_existence_semantics:\n270:       description: \"Create requires non-existing skill; update/doc-only require existing skill\"\n271:       fail_action: \"STOP and reroute or correct target\"\n272:     H4_validation_gate:\n273:       description: \"DQI >= hard minimum and structural checks pass\"\n274:       fail_action: \"Run fix-and-revalidate loop\"\n275:     H4b_human_voice_gate:\n276:       description: \"No HVR hard blockers and every absolute score >= 85\"\n277:       fail_action: \"Revise or rewrite, re-run hvr_scan.py, then revalidate\"\n278:   soft:\n279:     S1_similarity_discovery:\n280:       description: \"Warn on similar existing skills before full-create\"\n281:       fail_action: \"Warn only\"\n282:     S2_resource_recommendation:\n283:       description: \"Suggest additional references/assets based on output gaps\"\n284:       fail_action: \"Skip suggestion\"\n285: \n286: interactive_execution:\n287:   principle: \"Pause at each checkpoint and wait for explicit decision\"\n288:   user_feedback_handling:\n289:     proceed: \"Continue to next step\"\n290:     review: \"Display details and remain at current step\"\n291:     modify: \"Revise and re-validate current step\"\n292:     abort: \"Cancel workflow\"\n293: \n294: workflow_overview:\n295:   steps:\n296:     - id: step_1_preflight\n297:       purpose: \"Normalize inputs and enforce H0-H2\"\n298:     - id: step_2_target_resolution\n299:       purpose: \"Resolve target path and enforce H3\"\n300:     - id: step_3_operation_execution\n301:       purpose: \"Run one operation branch\"\n302:     - id: step_3b_human_voice_score\n303:       purpose: \"Score authored skill documents before validation\"\n304:     - id: step_4_validation_and_quality\n305:       purpose: \"Enforce H4 and DQI policy\"\n306:     - id: step_5_skill_integration\n307:       purpose: \"Sync SKILL.md routing references\"\n308:     - id: step_6_context_save_and_index\n309:       purpose: \"Save and index context when spec path exists\"\n310:     - id: step_7_completion\n311:       purpose: \"Emit deterministic completion report\"\n312: \n313: workflow:\n314:   step_1_preflight:\n315:     purpose: Normalize and verify required fields\n316:     activities:\n317:       - Normalize skill_path to default when omitted\n318:       - Normalize operation token to supported value\n319:       - Validate type for reference-only/asset-only\n320:       - Validate execution_mode is :confirm\n321:       - Validate chained handoff completeness if chained=true\n322:       - Resolve memory_choice via the context_loading block (Q4 if applicable); record result as memory_loaded\n323:     outputs:\n324:       - normalized_inputs\n325:       - preflight_passed\n326:     checkpoint:\n327:       question: \"Preflight complete for [skill_name] using [operation]. Continue?\"\n328:       options:\n329:         - proceed\n330:         - review\n331:         - modify\n332:         - abort\n333: \n334:   step_2_target_resolution:\n335:     purpose: Resolve target paths and enforce create/update semantics\n336:     activities:\n337:       - Resolve skill_root as \"[skill_path]/[skill_name]\"\n338:       - Check target existence\n339:       - Block full-create when skill already exists\n340:       - Block full-update/reference-only/asset-only when skill is missing\n341:       - For full-create, run similarity discovery and present findings\n342:     checks:\n343:       exists_command: \"ls -d [skill_path]/[skill_name] 2>/dev/null\"\n344:     outputs:\n345:       - skill_root\n346:       - existence_verified\n347:       - similarity_findings\n348:     checkpoint:\n349:       question: \"Target resolution complete. Continue with selected operation?\"\n350:       options:\n351:         - proceed\n352:         - review\n353:         - modify\n354:         - abort\n355: \n356:   step_3_operation_execution:\n357:     purpose: Execute selected operation branch\n358:     branches:\n359:       full-create:\n360:         activities:\n361:           - Run init script: \"python3 .skilled/skills/sk-doc/scripts/init_skill.py [skill_name] --path [skill_path]\"\n362:           - >-\n363:             Read the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n364:             before writing SKILL.md and README.md.\n365:           - Load SKILL.md template and populate required sections\n366:           - Apply section boundary rules\n367:           - \"Seed SKILL.md Section 2 (SMART ROUTING) as 8 to 12 lines of plain prose that say what selects this skill, what it loads first, and that the machine router lives in the sibling ROUTER.md. Take the machine router block (INTENT_SIGNALS and RESOURCE_MAP) from skill-smart-router.md, keep its four resilience patterns (runtime discovery, existence-check-before-load, extensible routing key, multi-tier fallback), adapt the routing key and resource map to this skill, and write the block to ROUTER.md under a final '## MACHINE ROUTER' heading. Add the relative markdown link to ./ROUTER.md in SMART ROUTING. A SMART ROUTING section over 12 lines, a machine router section left in SKILL.md, or a missing ROUTER.md link fails this branch.\"\n368:           - \"Set SKILL.md frontmatter per frontmatter_contract.skill_md: name (==folder), description, allowed-tools, version (4-part X.Y.Z.W)\"\n369:           - \"Create baseline references/assets/scripts from requested scope. Seed every references/*.md from skill_reference and every assets/*.md from skill_asset so each ships the full 5-field + version frontmatter; name non-exempt files in kebab-case. Create README.md from skill_readme if the initializer did not emit it, with title, description, and version.\"\n370:           - Remove placeholders and sample-only content\n371:         outputs:\n372:           - skill_scaffolded\n373:           - skill_content_written\n374:           - smart_router_pseudocode_seeded\n375:           - resources_written\n376: \n377:       full-update:\n378:         activities:\n379:           - Read existing SKILL.md and targeted resource files\n380:           - >-\n381:             Read and apply the [Prose Clarity Checklist](.skilled/skills/sk-doc/sk-create-skill/references/skill/creation-workflow.md#prose-clarity-checklist)\n382:             before editing SKILL.md or README.md.\n383:           - Update requested sections only\n384:           - Preserve existing folder and naming conventions\n385:           - Remove stale references in updated sections\n386:           - \"Run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] to report leaf-manifest.json freshness (fresh|stale|missing) for the completion handoff. This is a read-only drift check, not regeneration — full-update never ran the class-metadata gate, so unlike full-create it cannot assume freshness and must measure it\"\n387:         outputs:\n388:           - skill_updates_applied\n389:           - resource_updates_applied\n390:           - leaf_manifest_freshness_checked\n391: \n392:       reference-only:\n393:         activities:\n394:           - Ensure references/ exists\n395:           - \"Determine reference filename from type and topic; filename MUST be kebab-case\"\n396:           - \"Create or update reference doc seeded from skill_reference template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n397:           - Ensure content depth matches type profile\n398:           - \"references/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n399:         type_templates:\n400:           workflow: { filename_pattern: \"[topic]-workflow.md\" }\n401:           patterns: { filename_pattern: \"[topic]-patterns.md\" }\n402:           debugging: { filename_pattern: \"[topic]-debugging.md\" }\n403:           tools: { filename_pattern: \"[tool]-guide.md\" }\n404:           quick_ref: { filename_pattern: \"quick-reference.md\" }\n405:         outputs:\n406:           - reference_file_written\n407:           - leaf_manifest_freshness_signal\n408: \n409:       asset-only:\n410:         activities:\n411:           - Ensure assets/ exists\n412:           - \"Determine asset filename from type and topic; filename MUST be kebab-case\"\n413:           - \"Create or update asset doc seeded from skill_asset template; the file MUST ship the full 5-field + version frontmatter (title, description, trigger_phrases 3-8, importance_tier, contextType, version 4-part X.Y.Z.W) per frontmatter_contract.references_and_assets\"\n414:           - Ensure examples are practical and immediately reusable\n415:           - \"assets/ is always a leaf root (leaf-resource-contract.cjs LEAF_ROOTS), so this branch always ends with a narrow freshness signal, never the full handoff: run node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check [skill_root] (read-only) and report leaf_manifest_freshness_signal = fresh|stale|missing. Do not render description.json/graph-metadata.json ownership lines or a refresh-choice block here\"\n416:         type_templates:\n417:           template: { filename_pattern: \"[topic]-templates.md\" }\n418:           lookup: { filename_pattern: \"[topic]-lookup.md\" }\n419:           example: { filename_pattern: \"[topic]-examples.md\" }\n420:           guide: { filename_pattern: \"[topic]-guide.md\" }\n421:         outputs:\n422:           - asset_file_written\n423:           - leaf_manifest_freshness_signal\n424: \n425:     checkpoint:\n426:       question: \"Operation execution complete. Review artifacts before validation?\"\n427:       options:\n428:         - proceed\n429:         - review\n430:         - modify\n431:         - abort\n432: \n433:   step_3b_human_voice_score:\n434:     purpose: Score authored skill documents before strict validation\n435:     condition: \"operation is full-create or full-update\"\n436:     activities:\n437:       - Read `.skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md` and follow its score operation, scope gate, mechanical scan, judgment pass, scoring rules, and report shape\n438:       - \"Resolve scan targets from existing files only: full-create requires [skill_root]/SKILL.md and includes [skill_root]/README.md only when present; full-update includes each existing SKILL.md or README.md.\"\n439:       - \"Do not pass a missing path to hvr_scan.py; a missing full-create SKILL.md is a structural failure.\"\n440:       - \"For each target, run `python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]` without extra flags; capture its output and exit code.\"\n441:       - \"Exit 0 means no hard blockers, exit 1 means at least one hard blocker and blocks completion, and exit 2 means the scan could not run and blocks completion. Review the remaining findings for sense and scope, and record justified exceptions.\"\n442:       - \"Compute the score from 100 using first-match-wins. For files up to 400 lines, 85+ is publish-ready, 70-84 requires revision, and below 70 requires rewriting. For longer files, report hard-blocker count and deduction density instead of an absolute score.\"\n443:       - Record each target's scan output and exit code, confirmed blockers, score or length basis, judgment findings, exceptions, and verdict for the presentation\n444:       - \"A target passes only with no hard blockers and a score of at least 85 when an absolute score applies. Revise scores from 70 to 84 and rewrite scores below 70, then run the score operation again.\"\n445:       - \"When a target fails, revise its in-scope prose and repeat the score operation before validation. Stop when the scan exits 2 or a hard blocker remains.\"\n446:     outputs:\n447:       - human_voice_results\n448:       - human_voice_passed\n449:     gate:\n450:       command: \"python3 .skilled/skills/sk-doc/sk-create-with-human-voice/scripts/hvr_scan.py [target_file]\"\n451:       blocking: true\n452: \n453:   step_4_validation_and_quality:\n454:     purpose: Enforce operation-specific validation and DQI targets\n455:     activities:\n456:       - Run operation-appropriate validation scripts\n457:       - \"Run the completion gate: python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict . This is the authoritative structural gate (hard-fails missing/non-4-part version, name!=folder, or missing required sections). It MUST pass before completion, and the generated tree must contain no non-exempt underscore path segment.\"\n458:       - \"Run python3 .skilled/skills/sk-doc/scripts/package_skill.py [skill_path]/[skill_name] --check --strict. The strict completion gate runs that check and rejects the old routing shape (RS-001 to RS-005): a SMART ROUTING section over 12 lines or 180 words, a '## MACHINE ROUTER' section left in SKILL.md, that section not last, a missing sibling ROUTER.md or one whose real path leaves the skill folder, and a SKILL.md with no relative link to ./ROUTER.md.\"\n459:       - Capture DQI score and quality band\n460:       - Enforce hard minimum threshold (75)\n461:       - Compare against operation target score\n462:       - Run fix-and-revalidate loop if needed\n463:       - \"Description budget check: quick_validate.py warns when description > 130 chars (skill) and hard-fails > 1536 chars. Soft-warning is non-blocking; hard-fail blocks the fix_loop.\"\n464:     gate:\n465:       command: \"python3 .skilled/skills/sk-doc/scripts/validate_skill_package.py [skill_path]/[skill_name] --strict\"\n466:       blocking: true\n467:     thresholds:\n468:       hard_minimum: 75\n469:       operation_targets:\n470:         full-create: 90\n471:         full-update: 90\n472:         reference-only: 80\n473:         asset-only: 80\n474:       description_soft_target_skill: 130\n475:       description_soft_target_command: 110\n476:       description_hard_cap: 1536\n477:     fix_loop:\n478:       max_retries: 3\n479:       action: \"Apply fixes, rerun validation, stop on pass or hard failure. If quick_validate emits a description-length warning, surface the trim suggestion per .skilled/skills/sk-doc/sk-create-frontmatter/assets/frontmatter-templates.md § Description Budget & Trim Style.\"\n480:     outputs:\n481:       - validation_passed\n482:       - dqi_score\n483:       - dqi_band\n484:       - description_length_warnings\n485:     checkpoint:\n486:       question: \"Validation complete (DQI=[dqi_score], band=[dqi_band]). Continue?\"\n487:       options:\n488:         - proceed\n489:         - review\n490:         - modify\n491:         - abort\n492: \n493:   step_5_skill_integration:\n494:     purpose: Keep routing and references synchronized in SKILL.md\n495:     activities:\n496:       - \"Update SMART ROUTING references for new/changed docs, keeping the section at 8 to 12 lines of plain prose, the machine router in the sibling ROUTER.md, and the link to it current\"\n497:       - Keep WHEN TO USE free of file-path navigation content\n498:       - Remove stale links and outdated references\n499:       - Verify referenced files exist after update\n500:     outputs:\n501:       - skill_md_synced\n502:       - routing_links_valid\n503:     checkpoint:\n504:       question: \"SKILL.md routing synchronization complete. Continue to context save?\"\n505:       options:\n506:         - proceed\n507:         - review\n508:         - modify\n509:         - abort\n510: \n511:   step_6_context_save_and_index:\n512:     purpose: Persist context with system-spec-kit compatibility\n513:     condition: \"spec_path exists\"\n514:     activities:\n515:       - Save context using generate-context.js\n516:       - Regenerate the trigger index when trigger_phrases changed\n517:       - Log the writer path and whether the trigger index was regenerated\n518:     write_continuity:\n519:       command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js [spec_path]\"\n520:       hard_rule: \"Do not create memory files manually\"\n521:     indexing:\n522:       preferred: \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs\"\n523:       note: \"generate-context.js writes the continuity frontmatter; the trigger index is regenerated from that frontmatter. There is no daemon to hand off to and no background indexing step to wait for.\"\n524:     outputs:\n525:       - context_saved\n526:       - context_indexed\n527:     checkpoint:\n528:       question: \"Context persistence complete. Finalize workflow?\"\n529:       options:\n530:         - proceed\n531:         - review\n532:         - modify\n533:         - abort\n534: \n535:   step_7_completion:\n536:     purpose: Emit deterministic completion summary\n537:     activities:\n538:       - For full-create and full-update, provide human_voice_results and human_voice_passed to the presentation contract\n539:     completion_report_template: |\n540:       Unified Skill Workflow Complete\n541: \n542:       Skill: [skill_name]\n543:       Operation: [operation]\n544:       Type: [type or N/A]\n545:       Mode: :confirm\n546:       Target: [skill_root_or_target_file]\n547: \n548:       Validation:\n549:       - DQI: [dqi_score] ([dqi_band])\n550:       - Hard minimum: 75\n551:       - Operation target: [operation_target]\n552: \n553:       [operation == full-create or full-update:]\n554:       Advisor/Index Handoff (operator-owned; this command did not mutate advisor state; standalone scope — H-only fields omitted):\n555:       - graph-metadata.json: sole skill advisor identity; source for graph indexing\n556:       - leaf-manifest.json: [fresh|stale|missing]\n557:       - Refresh choice - run one when the advisor should include this change:\n558:         - Full advisor refresh: node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --workspace-root \"$PWD\" --format json\n559:         - Graph-only refresh: node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --skills-root \"$PWD/.skilled/skills\" --format json\n560:       - Refresh status: NOT RUN (operator-owned; see .skilled/skills/sk-doc/sk-create-skill/references/shared/advisor-index-handoff.md)\n561:       [operation == reference-only or asset-only:]\n562:       Leaf-manifest freshness: [fresh|stale|missing] (narrow signal only — see advisor-index-handoff.md § Branch Scope for why this branch does not render the full handoff)\n563: \n564:       Context:\n565:       - Spec path: [spec_path or none]\n566:       - Memory saved: [yes/no]\n567: \n568:       STATUS=OK PATH=[skill_root_or_target_file]\n569: \n570: violation_recovery:\n571:   setup_violation:\n572:     trigger: \"Missing required normalized fields\"\n573:     action:\n574:       - \"Stop\"\n575:       - \"State missing field(s)\"\n576:       - \"Return to setup\"\n577:   routing_violation:\n578:     trigger: \"Operation/type mismatch or wrong existence routing\"\n579:     action:\n580:       - \"Stop\"\n581:       - \"State routing correction\"\n582:       - \"Re-run operation router\"\n583:   validation_violation:\n584:     trigger: \"DQI below threshold or structural errors\"\n585:     action:\n586:       - \"Stop completion\"\n587:       - \"Run fix loop\"\n588:       - \"Revalidate\"\n589: \n590: error_recovery:\n591:   invalid_skill_name:\n592:     action: \"Require explicit hyphen-case skill_name\"\n593:   invalid_operation:\n594:     action: \"Require one of full-create/full-update/reference-only/asset-only\"\n595:   missing_type:\n596:     action: \"Require type for reference-only or asset-only\"\n597:   invalid_type:\n598:     action: \"Show allowed types for selected operation\"\n599:   skill_exists_on_create:\n600:     action: \"Offer reroute to full-update\"\n601:   skill_missing_on_update_or_doc:\n602:     action: \"Offer reroute to full-create or corrected name/path\"\n603:   template_load_failure:\n604:     action: \"Verify sk-doc template paths and retry\"\n605:   validation_failure:\n606:     action: \"Capture script output, fix, retry\"\n607:   integration_failure:\n608:     action: \"Repair SKILL.md links and rerun integration checks\"\n609:   user_abort:\n610:     action: \"Return STATUS=CANCELLED\"\n611: \n612: circuit_breaker:\n613:   consecutive_failure_threshold: 3\n614:   states:\n615:     closed: \"Normal operation\"\n616:     open: \"Stop and report failure summary\"\n617:     half_open: \"Single retry with stricter checks\"\n618:   on_open:\n619:     action: \"Stop workflow and return STATUS=FAIL\"\n620: \n621: termination:\n622:   after_step: step_7_completion\n623:   message: \"Unified sk-skill confirm workflow complete.\"\n624:   next_steps:\n625:     - condition: \"Need iterative updates\"\n626:       action: \"/create:skill [skill-name] full-update :confirm\"\n627:     - condition: \"Need another reference\"\n628:       action: \"/create:skill [skill-name] reference-only [type] :confirm\"\n629:     - condition: \"Need another asset\"\n630:       action: \"/create:skill [skill-name] asset-only [type] :confirm\"\n631: \n632: rules:\n633:   ALWAYS:\n634:     - \"Enforce @markdown or valid chained handoff\"\n635:     - \"Use canonical operation router\"\n636:     - \"Pause for explicit checkpoint decisions\"\n637:     - \"Load templates before writing\"\n638:     - \"Seed every authored .md from its template so frontmatter is present by construction (frontmatter_contract)\"\n639:     - \"Seed SMART ROUTING as 8 to 12 lines of plain prose with a link to ./ROUTER.md, and the machine router block in that sibling file under the final '## MACHINE ROUTER' heading, from skill-smart-router.md, on full-create\"\n640:     - \"Pass validate_skill_package.py before completion\"\n641:     - \"Run validation before completion\"\n642:     - \"Preserve WHEN TO USE vs SMART ROUTING boundaries\"\n643:     - \"Save memory context only through system-spec-kit workflow\"\n644:   NEVER:\n645:     - \"Split setup prompts across turns\"\n646:     - \"Infer missing operation/type values\"\n647:     - \"Bypass hard gates\"\n648:     - \"Write a references/ or assets/ .md without the full 5-field + version frontmatter\"\n649:     - \"Ship a SMART ROUTING section over 12 lines, leave a machine router section in SKILL.md, or omit the sibling ROUTER.md or its link\"\n650:     - \"Use non-kebab-case filenames in references/ or assets/\"\n651:     - \"Create memory files manually\"\n652:     - \"Leave stale routing links in SKILL.md\""}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/create/assets/create-skill-confirm.yaml\"}"},"time":{"start":1794582799205,"end":1794582799426}}}}
