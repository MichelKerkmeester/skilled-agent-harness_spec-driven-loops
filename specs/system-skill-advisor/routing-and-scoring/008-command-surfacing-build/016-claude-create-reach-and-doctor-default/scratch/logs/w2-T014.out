kill\": {\n-        \"description\": \"Create or update an OpenCode skill using /create:skill.\",\n-        \"slash_markers\": [\"/create:skill\", \"create:skill\"],\n-        \"inventory_id\": \"command-create-skill\",\n-        \"command\": \"/create:skill\",\n+    \"command-create-sk-skill\": {\n+        \"description\": \"Create or update an OpenCode skill using /create:sk-skill.\",\n+        \"slash_markers\": [\"/create:sk-skill\", \"create:sk-skill\"],\n+        \"inventory_id\": \"command-create-sk-skill\",\n+        \"command\": \"/create:sk-skill\",\n         \"skill_id\": \"sk-doc\",\n         \"owner_mode\": \"sk-create-skill\",\n         \"routing_enabled\": True,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\nindex 7e6aa3892f..09aa2b4503 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts\n@@ -1071,14 +1071,14 @@ export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\n     lifecycleStatus: 'active',\n   },\n   {\n-    inventoryId: 'command-create-skill',\n+    inventoryId: 'command-create-sk-skill',\n     ownerSkill: 'sk-doc',\n     routingEnabled: false,\n-    id: 'command-create-skill',\n+    id: 'command-create-sk-skill',\n     kind: 'command',\n     family: 'system',\n     category: 'command',\n-    name: 'command-create-skill',\n+    name: 'command-create-sk-skill',\n     description: '',\n     keywords: [],\n     domains: [],\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\nindex 076e4e8bc6..0c479199a6 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\n@@ -331,8 +331,8 @@\n       }\n     },\n     {\n-      \"id\": \"command-create-skill\",\n-      \"command\": \"/create:skill\",\n+      \"id\": \"command-create-sk-skill\",\n+      \"command\": \"/create:sk-skill\",\n       \"skillId\": \"sk-doc\",\n       \"ownerMode\": \"sk-create-skill\",\n       \"description\": \"Create or update OpenCode skills via one unified command with operation routing. :auto/:confirm.\",\n@@ -350,13 +350,13 @@\n         },\n         \"python\": {\n           \"enabled\": true,\n-          \"inventoryId\": \"command-create-skill\",\n+          \"inventoryId\": \"command-create-sk-skill\",\n           \"order\": 12,\n-          \"id\": \"command-create-skill\",\n-          \"description\": \"Create or update an OpenCode skill using /create:skill.\",\n+          \"id\": \"command-create-sk-skill\",\n+          \"description\": \"Create or update an OpenCode skill using /create:sk-skill.\",\n           \"slashMarkers\": [\n-            \"/create:skill\",\n-            \"create:skill\"\n+            \"/create:sk-skill\",\n+            \"create:sk-skill\"\n           ]\n         }\n       }\n@@ -2727,7 +2727,7 @@\n       \"policy\": \"start\"\n     },\n     {\n-      \"command\": \"/create:skill\",\n+      \"command\": \"/create:sk-skill\",\n       \"route\": null,\n       \"mutating\": \"mutates\",\n       \"askFirst\": [],\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py b/.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\nindex 94bb9a6272..ee814f4067 100755\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py\n@@ -2378,11 +2378,11 @@ GENERATED_COMMAND_BRIDGES = {\n         \"owner_mode\": \"sk-create-changelog\",\n         \"routing_enabled\": True,\n     },\n-    \"command-create-skill\": {\n-        \"description\": \"Create or update an OpenCode skill using /create:skill.\",\n-        \"slash_markers\": [\"/create:skill\", \"create:skill\"],\n-        \"inventory_id\": \"command-create-skill\",\n-        \"command\": \"/create:skill\",\n+    \"command-create-sk-skill\": {\n+        \"description\": \"Create or update an OpenCode skill using /create:sk-skill.\",\n+        \"slash_markers\": [\"/create:sk-skill\", \"create:sk-skill\"],\n+        \"inventory_id\": \"command-create-sk-skill\",\n+        \"command\": \"/create:sk-skill\",\n         \"skill_id\": \"sk-doc\",\n         \"owner_mode\": \"sk-create-skill\",\n         \"routing_enabled\": True,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/scorer/projection.ts .skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\"}"},"time":{"start":1794584806505,"end":1794584806834}}}}
