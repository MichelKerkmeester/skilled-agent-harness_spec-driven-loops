indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"t014 regenerate command bridges rename typed attach cases command attach ts\",\n  \"results\": [\n    {\n      \"matchClass\": \"query-containment\",\n      \"path\": \".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/README.md\",\n      \"phrases\": [\n        \"command bridge compatibility\",\n        \"command bridges\",\n        \"generated command bridge projection\"\n      ],\n      \"score\": 0.88\n    }\n  ],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"t014\",\n    \"regenerate\",\n    \"command\",\n    \"bridges\",\n    \"rename\",\n    \"typed\",\n    \"attach\",\n    \"cases\"\n  ],\n  \"totalCandidates\": 1,\n  \"truncated\": false\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"T014 regenerate command bridges rename typed attach cases command-attach.ts\\\" 2>&1 | head -40\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794584631351,"end":1794584632978}}}}
