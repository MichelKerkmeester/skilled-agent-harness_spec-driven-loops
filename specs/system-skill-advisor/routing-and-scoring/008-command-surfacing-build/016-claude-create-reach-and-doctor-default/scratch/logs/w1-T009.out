{"type":"tool_use","timestamp":1794583011393,"sessionID":"ses_e2a8827d1ffeTImD0J7JngRHUY","part":{"partID":"prt_1d57ba019001kVtdQ7g2zgGgJZ","sessionID":"ses_e2a8827d1ffeTImD0J7JngRHUY","messageID":"msg_1d57af7c80016bNGaQf5SagkZw","type":"tool","id":"chatcmpl-tool-820b93c21821f83d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/mirror-sync-verify.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/mirror-sync-verify.cjs, lines 1-427\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ mirror-sync-verify — repo-managed agent mirror sync verifier            ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. REQUIRES\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const path = require('node:path');\n12: // The parser ships only as build output. Load it on first use, so a clone that has not built it\n13: // can report that the check could not run, instead of crashing into the drift exit code.\n14: const PARSER_PATH = path.join(\n15:   __dirname, '..', '..', 'skills', 'system-spec-kit', 'shared', 'dist', 'frontmatter', 'parse-frontmatter.js',\n16: );\n17: const NOT_CHECKABLE_CODE = 'MIRROR_SYNC_NOT_CHECKABLE';\n18: let loadedParseFrontmatter = null;\n19: \n20: function parseFrontmatter(content) {\n21:   if (!loadedParseFrontmatter) {\n22:     let reason = null;\n23:     if (!fs.existsSync(PARSER_PATH)) {\n24:       reason = 'is missing';\n25:     } else {\n26:       try {\n27:         const loaded = require(PARSER_PATH).parseFrontmatter;\n28:         if (typeof loaded === 'function') loadedParseFrontmatter = loaded;\n29:         else reason = 'does not export parseFrontmatter';\n30:       } catch (loadError) {\n31:         reason = `failed to load (${loadError && loadError.message ? loadError.message : loadError})`;\n32:       }\n33:     }\n34:     if (reason) {\n35:       const error = new Error(\n36:         `the built frontmatter parser at ${PARSER_PATH} ${reason}; ` +\n37:           'build it with: npm --prefix .skilled/skills/system-spec-kit run build',\n38:       );\n39:       error.code = NOT_CHECKABLE_CODE;\n40:       throw error;\n41:     }\n42:   }\n43:   return loadedParseFrontmatter(content);\n44: }\n45: \n46: // ─────────────────────────────────────────────────────────────────────────────\n47: // 2. CONSTANTS\n48: // ─────────────────────────────────────────────────────────────────────────────\n49: \n50: const RUNTIME_MIRRORS = Object.freeze([\n51:   { runtime: 'opencode', template: '.opencode/agents/{name}.md', format: 'markdown', required: true },\n52:   { runtime: 'claude', template: '.claude/agents/{name}.md', format: 'markdown', required: true },\n53:   { runtime: 'codex', template: '.codex/agents/{name}.toml', format: 'toml', required: false },\n54:   { runtime: 'cursor', template: '.cursor/agents/{name}.md', format: 'markdown', required: false },\n55:   { runtime: 'devin', template: '.devin/agents/{name}/AGENT.md', format: 'markdown', required: false },\n56:   { runtime: 'pi', template: '.pi/agents/{name}.md', format: 'markdown', required: false },\n57:   {\n58:     runtime: 'dsh',\n59:     template: '.dsh/agents/{name}.patch.yml',\n60:     format: 'patch-yaml',\n61:     required: false,\n62:     comparable: false,\n63:   },\n64: ]);\n65: \n66: const LOAD_BEARING_MARKERS = Object.freeze([\n67:   'VALIDATE INPUTS',\n68:   'READ STATE',\n69:   'DETERMINE FOCUS',\n70:   'EXECUTE REVIEW',\n71:   'RESOLVE EDGES',\n72:   'CLASSIFY FINDINGS',\n73:   'WRITE FINDINGS',\n74:   'UPDATE STRATEGY',\n75:   'APPEND JSONL',\n76:   'WRITE DELTA',\n77:   'VERIFY OUTPUTS',\n78:   'RECEIVE',\n79:   'PREPARE',\n80:   'DIVERSIFY',\n81:   'DISPATCH',\n82:   'DELIBERATE',\n83:   'SYNTHESIZE',\n84:   'COMPOSE',\n85:   'DELIVER',\n86: ]);\n87: \n88: // Tools that must be DECLARED by a mirror whenever the agent body mentions them,\n89: // mapped to every spelling a runtime dialect uses for the same tool. An MCP-backed\n90: // tool is bare in OpenCode's permission block and namespaced in Claude's tools\n91: // line, so without this map the same tool reads as drift across the pair.\n92: //\n93: // Empty today: the only entry was an MCP tool whose server was decommissioned, and\n94: // nothing that remains is spelled differently per runtime. Add an entry when a tool\n95: // is both mentioned in an agent body and spelled differently across mirrors.\n96: const TOOL_ALIASES = Object.freeze({});\n97: \n98: // ─────────────────────────────────────────────────────────────────────────────\n99: // 3. HELPERS\n100: // ─────────────────────────────────────────────────────────────────────────────\n101: \n102: function resolveMirrorPath(repoRoot, template, agentName) {\n103:   return path.join(repoRoot, template.replace('{name}', agentName));\n104: }\n105: \n106: /**\n107:  * Strip leading YAML frontmatter from markdown content.\n108:  *\n109:  * @param {string} content - Raw file content.\n110:  * @returns {string} Content with the leading frontmatter block removed.\n111:  */\n112: function stripFrontmatter(content) {\n113:   return parseFrontmatter(String(content || '')).body;\n114: }\n115: \n116: /**\n117:  * Extract the agent body from runtime-mirror content by format.\n118:  *\n119:  * @param {string} content - Raw mirror file content.\n120:  * @param {string} [format] - Mirror format (always 'markdown'; kept as a\n121:  *   parameter so a future non-markdown runtime mirror can extend this\n122:  *   without changing the call sites).\n123:  * @returns {string|null} Trimmed agent body, or null if not extractable.\n124:  */\n125: function extractAgentBody(content, format = 'markdown') {\n126:   if (format === 'toml') {\n127:     const literal = String(content || '').match(\n128:       /^\\s*developer_instructions\\s*=\\s*'''([\\s\\S]*?)'''\\s*$/m,\n129:     );\n130:     if (literal) return literal[1].trim();\n131:     const quoted = String(content || '').match(\n132:       /^\\s*developer_instructions\\s*=\\s*(\"(?:\\\\.|[^\"\\\\])*\")\\s*$/m,\n133:     );\n134:     if (quoted) {\n135:       try {\n136:         return JSON.parse(quoted[1]).trim();\n137:       } catch {\n138:         return null;\n139:       }\n140:     }\n141:     return null;\n142:   }\n143:   return stripFrontmatter(content).trim();\n144: }\n145: \n146: function normalizeRuntimeSpecificText(body) {\n147:   return String(body || '')\n148:     // Agent-file references include literal placeholders like `<name>`, so the\n149:     // name class allows < and >. This normalizes the per-runtime path so a\n150:     // real body difference elsewhere still registers as drift.\n151:     .replace(/\\.(?:skilled|opencode|claude|pi)\\/agents\\/\\*\\.md/g, '<runtime-agent-path>')\n152:     .replace(/\\.(?:skilled|opencode|claude|pi)\\/agents\\/[A-Za-z0-9_<>-]+\\.md/g, '<runtime-agent-file>')\n153:     .replace(/\\.(?:skilled|opencode|claude|pi)\\/agents\\/(?![A-Za-z0-9_<>*-])/g, '<runtime-agent-dir>')\n154:     .replace(/\\.codex\\/agents\\/[A-Za-z0-9_<>-]+\\.toml/g, '<runtime-agent-file>')\n155:     // Each mirror describes itself (\"this runtime's mirror; the canonical source\n156:     // lives in .opencode/agents/\") in a parenthetical the .opencode canonical\n157:     // omits. That is legitimate per-runtime self-description, not body drift, so\n158:     // drop the whole clause before comparing.\n159:     .replace(/\\(this runtime.s mirror;[^)]*\\)/gi, '')\n160:     .replace(/\\r\\n/g, '\\n')\n161:     .replace(/[ \\t]+$/gm, '')\n162:     .trim();\n163: }\n164: \n165: function tokenizeBody(body) {\n166:   const normalized = normalizeRuntimeSpecificText(body).toLowerCase();\n167:   return new Set(normalized.match(/[a-z0-9_./*-]{3,}/g) || []);\n168: }\n169: \n170: function extractLoadBearingSequence(body) {\n171:   const markerPattern = LOAD_BEARING_MARKERS.map((marker) => marker.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('|');\n172:   const sequence = [];\n173:   const linePattern = new RegExp(\n174:     `^\\\\s*(?:\\\\d+[.)]\\\\s+)?[^\\\\n]*?\\\\b(${markerPattern})\\\\b[^\\\\n]*$`,\n175:     'gim',\n176:   );\n177:   for (const match of String(body || '').matchAll(linePattern)) {\n178:     const marker = match[1].toUpperCase();\n179:     const line = match[0];\n180:     if (/^\\s*\\d+[.)]\\s+/.test(line) || /►|->|→/.test(line)) sequence.push(marker);\n181:   }\n182:   return sequence;\n183: }\n184: \n185: function extractDeclaredToolSurface(content, format = 'markdown') {\n186:   if (format !== 'markdown') {\n187:     return { comparable: false, tools: [] };\n188:   }\n189:   // Tool declarations stay line-read verbatim (quoted or comma forms must not\n190:   // be YAML-interpreted); only the fence split comes from the shared parser.\n191:   const parsed = parseFrontmatter(String(content || ''));\n192:   if (parsed.raw === null) return { comparable: false, tools: [] };\n193:   const block = parsed.raw.slice(4, -4);\n194: \n195:   const tools = new Set();\n196:   let listSection = false;\n197:   for (const line of block.split(/\\r?\\n/)) {\n198:     const listStart = line.match(/^\\s*(tools|allowed-tools):\\s*(.*?)\\s*$/i);\n199:     if (listStart) {\n200:       listSection = true;\n201:       for (const token of listStart[2].match(/[A-Za-z][A-Za-z0-9_.*-]*/g) || []) {\n202:         tools.add(token.toLowerCase());\n203:       }\n204:       continue;\n205:     }\n206:     if (listSection && /^\\s+-\\s+/.test(line)) {\n207:       const item = line.match(/^\\s+-\\s+([^\\s#]+)/);\n208:       if (item) tools.add(item[1].toLowerCase());\n209:       continue;\n210:     }\n211:     if (line.trim() && !/^\\s+/.test(line)) listSection = false;\n212: \n213:     const permission = line.match(/^\\s*([A-Za-z][A-Za-z0-9_-]*):\\s*(allow|allowed|true|yes)\\s*$/i);\n214:     if (permission) tools.add(permission[1].toLowerCase());\n215:   }\n216:   return { comparable: true, tools: [...tools].sort() };\n217: }\n218: \n219: function requiredBodyTools(body) {\n220:   return Object.keys(TOOL_ALIASES).filter((tool) => (\n221:     new RegExp(`\\\\b${tool}\\\\b`, 'i').test(String(body || ''))\n222:   ));\n223: }\n224: \n225: function compareToolSurface(expectedContent, actualContent, expectedFormat = 'markdown', actualFormat = 'markdown') {\n226:   const expectedBody = extractAgentBody(expectedContent, expectedFormat);\n227:   const requiredTools = requiredBodyTools(expectedBody || '');\n228:   const actualSurface = extractDeclaredToolSurface(actualContent, actualFormat);\n229:   if (!actualSurface.comparable || requiredTools.length === 0) {\n230:     return { comparable: actualSurface.comparable, matches: true, missingTools: [], requiredTools };\n231:   }\n232:   const actualTools = new Set(actualSurface.tools);\n233:   const missingTools = requiredTools.filter((tool) => (\n234:     !(TOOL_ALIASES[tool] || [tool]).some((alias) => actualTools.has(alias))\n235:   ));\n236:   return {\n237:     comparable: true,\n238:     matches: missingTools.length === 0,\n239:     missingTools,\n240:     requiredTools,\n241:   };\n242: }\n243: \n244: /**\n245:  * Compare two agent bodies by normalized token sets for drift.\n246:  *\n247:  * @param {string} expectedBody - Canonical expected body.\n248:  * @param {string} actualBody - Mirror body to compare against.\n249:  * @returns {Object} Comparison with matches flag and missing/unexpected tokens.\n250:  */\n251: function compareBodyTokens(expectedBody, actualBody) {\n252:   const expectedTokens = tokenizeBody(expectedBody);\n253:   const actualTokens = tokenizeBody(actualBody);\n254:   const missingTokens = [...expectedTokens].filter((token) => !actualTokens.has(token)).sort();\n255:   const unexpectedTokens = [...actualTokens].filter((token) => !expectedTokens.has(token)).sort();\n256:   const expectedLoadBearingSequence = extractLoadBearingSequence(expectedBody);\n257:   const actualLoadBearingSequence = extractLoadBearingSequence(actualBody);\n258:   const orderMatches = expectedLoadBearingSequence.length === 0\n259:     && actualLoadBearingSequence.length === 0\n260:     ? true\n261:     : JSON.stringify(expectedLoadBearingSequence) === JSON.stringify(actualLoadBearingSequence);\n262: \n263:   return {\n264:     matches: missingTokens.length === 0 && unexpectedTokens.length === 0 && orderMatches,\n265:     missingTokenCount: missingTokens.length,\n266:     unexpectedTokenCount: unexpectedTokens.length,\n267:     missingTokens: missingTokens.slice(0, 20),\n268:     unexpectedTokens: unexpectedTokens.slice(0, 20),\n269:     expectedLoadBearingSequence,\n270:     actualLoadBearingSequence,\n271:     orderMatches,\n272:   };\n273: }\n274: \n275: /**\n276:  * Infer the agent name from a mirror file path (basename without extension).\n277:  *\n278:  * @param {string} filePath - Path to a runtime-mirror agent file.\n279:  * @returns {string} Agent name derived from the file basename.\n280:  */\n281: function inferAgentNameFromPath(filePath) {\n282:   const ext = path.extname(filePath);\n283:   return path.basename(filePath, ext);\n284: }\n285: \n286: /**\n287:  * Resolve the per-runtime mirror paths for an agent name.\n288:  *\n289:  * @param {string} agentName - Agent name to expand into mirror paths.\n290:  * @param {string} [repoRoot] - Repository root for absolute path resolution.\n291:  * @returns {Array<Object>} Mirror descriptors with runtime, path, absolutePath, format.\n292:  */\n293: function runtimePaths(agentName, repoRoot = process.cwd()) {\n294:   return RUNTIME_MIRRORS.map((mirror) => ({\n295:     runtime: mirror.runtime,\n296:     path: mirror.template.replace('{name}', agentName),\n297:     absolutePath: resolveMirrorPath(repoRoot, mirror.template, agentName),\n298:     format: mirror.format,\n299:     required: mirror.required,\n300:     comparable: mirror.comparable !== false,\n301:   }));\n302: }\n303: \n304: // ─────────────────────────────────────────────────────────────────────────────\n305: // 4. CORE LOGIC\n306: // ─────────────────────────────────────────────────────────────────────────────\n307: \n308: /**\n309:  * Verify that all repo-managed runtime mirrors of an agent are present and in sync.\n310:  *\n311:  * @param {string} agentName - Agent name to verify across runtime mirrors.\n312:  * @param {string} content - Canonical agent content to compare mirrors against.\n313:  * @param {Object} [options] - Options bag.\n314:  * @param {string} [options.repoRoot] - Repository root for resolving mirror paths.\n315:  * @param {string} [options.expectedFormat] - Format of the canonical content.\n316:  * @returns {Object} Result with present/missing/drift runtimes, allInSync, details.\n317:  */\n318: function verifyMirrorSync(agentName, content, options = {}) {\n319:   const repoRoot = path.resolve(options.repoRoot || process.cwd());\n320:   const expectedFormat = options.expectedFormat || 'markdown';\n321:   const expectedBody = extractAgentBody(content, expectedFormat);\n322:   if (!agentName || typeof agentName !== 'string') {\n323:     throw new Error('verifyMirrorSync requires an agentName');\n324:   }\n325:   if (expectedBody === null || expectedBody.length === 0) {\n326:     throw new Error('verifyMirrorSync requires extractable agent body content');\n327:   }\n328: \n329:   const presentRuntimes = [];\n330:   const missingRuntimes = [];\n331:   const driftRuntimes = [];\n332:   const details = [];\n333:   const canonicalPath = resolveMirrorPath(repoRoot, '.opencode/agents/{name}.md', agentName);\n334:   const canonicalRealPath = fs.existsSync(canonicalPath) ? fs.realpathSync(canonicalPath) : null;\n335: \n336:   for (const mirror of runtimePaths(agentName, repoRoot)) {\n337:     if (!fs.existsSync(mirror.absolutePath)) {\n338:       if (mirror.required !== false) missingRuntimes.push(mirror.runtime);\n339:       details.push({\n340:         runtime: mirror.runtime,\n341:         path: mirror.path,\n342:         status: mirror.required === false ? 'not-shipped' : 'missing',\n343:       });\n344:       continue;\n345:     }\n346: \n347:     presentRuntimes.push(mirror.runtime);\n348:     if (canonicalRealPath && fs.realpathSync(mirror.absolutePath) === canonicalRealPath) {\n349:       details.push({\n350:         runtime: mirror.runtime,\n351:         path: mirror.path,\n352:         status: 'same-file',\n353:       });\n354:       continue;\n355:     }\n356: \n357:     if (!mirror.comparable) {\n358:       details.push({\n359:         runtime: mirror.runtime,\n360:         path: mirror.path,\n361:         status: 'present-but-not-compared',\n362:         reason: 'format-not-comparable',\n363:       });\n364:       continue;\n365:     }\n366: \n367:     const mirrorContent = fs.readFileSync(mirror.absolutePath, 'utf8');\n368:     const mirrorBody = extractAgentBody(mirrorContent, mirror.format);\n369:     if (mirrorBody === null) {\n370:       driftRuntimes.push(mirror.runtime);\n371:       details.push({\n372:         runtime: mirror.runtime,\n373:         path: mirror.path,\n374:         status: 'drift',\n375:         reason: 'body-unextractable',\n376:       });\n377:       continue;\n378:     }\n379: \n380:     const comparison = compareBodyTokens(expectedBody, mirrorBody);\n381:     const surfaceComparison = compareToolSurface(content, mirrorContent, expectedFormat, mirror.format);\n382:     if (!comparison.matches || !surfaceComparison.matches) {\n383:       driftRuntimes.push(mirror.runtime);\n384:       details.push({\n385:         runtime: mirror.runtime,\n386:         path: mirror.path,\n387:         status: 'drift',\n388:         comparison,\n389:         surfaceComparison,\n390:       });\n391:       continue;\n392:     }\n393: \n394:     details.push({\n395:       runtime: mirror.runtime,\n396:       path: mirror.path,\n397:       status: 'in-sync',\n398:       surfaceComparison,\n399:     });\n400:   }\n401: \n402:   return {\n403:     presentRuntimes,\n404:     missingRuntimes,\n405:     driftRuntimes,\n406:     allInSync: missingRuntimes.length === 0 && driftRuntimes.length === 0,\n407:     details,\n408:   };\n409: }\n410: \n411: // ─────────────────────────────────────────────────────────────────────────────\n412: // 5. EXPORTS\n413: // ─────────────────────────────────────────────────────────────────────────────\n414: \n415: module.exports = {\n416:   RUNTIME_MIRRORS,\n417:   NOT_CHECKABLE_CODE,\n418:   compareBodyTokens,\n419:   compareToolSurface,\n420:   extractAgentBody,\n421:   extractDeclaredToolSurface,\n422:   extractLoadBearingSequence,\n423:   inferAgentNameFromPath,\n424:   runtimePaths,\n425:   stripFrontmatter,\n426:   verifyMirrorSync,\n427: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/mirror-sync-verify.cjs, lines 1-427\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ mirror-sync-verify — repo-managed agent mirror sync verifier            ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. REQUIRES\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const path = require('node:path');\n12: // The parser ships only as build output. Load it on first use, so a clone that has not built it\n13: // can report that the check could not run, instead of crashing into the drift exit code.\n14: const PARSER_PATH = path.join(\n15:   __dirname, '..', '..', 'skills', 'system-spec-kit', 'shared', 'dist', 'frontmatter', 'parse-frontmatter.js',\n16: );\n17: const NOT_CHECKABLE_CODE = 'MIRROR_SYNC_NOT_CHECKABLE';\n18: let loadedParseFrontmatter = null;\n19: \n20: function parseFrontmatter(content) {\n21:   if (!loadedParseFrontmatter) {\n22:     let reason = null;\n23:     if (!fs.existsSync(PARSER_PATH)) {\n24:       reason = 'is missing';\n25:     } else {\n26:       try {\n27:         const loaded = require(PARSER_PATH).parseFrontmatter;\n28:         if (typeof loaded === 'function') loadedParseFrontmatter = loaded;\n29:         else reason = 'does not export parseFrontmatter';\n30:       } catch (loadError) {\n31:         reason = `failed to load (${loadError && loadError.message ? loadError.message : loadError})`;\n32:       }\n33:     }\n34:     if (reason) {\n35:       const error = new Error(\n36:         `the built frontmatter parser at ${PARSER_PATH} ${reason}; ` +\n37:           'build it with: npm --prefix .skilled/skills/system-spec-kit run build',\n38:       );\n39:       error.code = NOT_CHECKABLE_CODE;\n40:       throw error;\n41:     }\n42:   }\n43:   return loadedParseFrontmatter(content);\n44: }\n45: \n46: // ─────────────────────────────────────────────────────────────────────────────\n47: // 2. CONSTANTS\n48: // ─────────────────────────────────────────────────────────────────────────────\n49: \n50: const RUNTIME_MIRRORS = Object.freeze([\n51:   { runtime: 'opencode', template: '.opencode/agents/{name}.md', format: 'markdown', required: true },\n52:   { runtime: 'claude', template: '.claude/agents/{name}.md', format: 'markdown', required: true },\n53:   { runtime: 'codex', template: '.codex/agents/{name}.toml', format: 'toml', required: false },\n54:   { runtime: 'cursor', template: '.cursor/agents/{name}.md', format: 'markdown', required: false },\n55:   { runtime: 'devin', template: '.devin/agents/{name}/AGENT.md', format: 'markdown', required: false },\n56:   { runtime: 'pi', template: '.pi/agents/{name}.md', format: 'markdown', required: false },\n57:   {\n58:     runtime: 'dsh',\n59:     template: '.dsh/agents/{name}.patch.yml',\n60:     format: 'patch-yaml',\n61:     required: false,\n62:     comparable: false,\n63:   },\n64: ]);\n65: \n66: const LOAD_BEARING_MARKERS = Object.freeze([\n67:   'VALIDATE INPUTS',\n68:   'READ STATE',\n69:   'DETERMINE FOCUS',\n70:   'EXECUTE REVIEW',\n71:   'RESOLVE EDGES',\n72:   'CLASSIFY FINDINGS',\n73:   'WRITE FINDINGS',\n74:   'UPDATE STRATEGY',\n75:   'APPEND JSONL',\n76:   'WRITE DELTA',\n77:   'VERIFY OUTPUTS',\n78:   'RECEIVE',\n79:   'PREPARE',\n80:   'DIVERSIFY',\n81:   'DISPATCH',\n82:   'DELIBERATE',\n83:   'SYNTHESIZE',\n84:   'COMPOSE',\n85:   'DELIVER',\n86: ]);\n87: \n88: // Tools that must be DECLARED by a mirror whenever the agent body mentions them,\n89: // mapped to every spelling a runtime dialect uses for the same tool. An MCP-backed\n90: // tool is bare in OpenCode's permission block and namespaced in Claude's tools\n91: // line, so without this map the same tool reads as drift across the pair.\n92: //\n93: // Empty today: the only entry was an MCP tool whose server was decommissioned, and\n94: // nothing that remains is spelled differently per runtime. Add an entry when a tool\n95: // is both mentioned in an agent body and spelled differently across mirrors.\n96: const TOOL_ALIASES = Object.freeze({});\n97: \n98: // ─────────────────────────────────────────────────────────────────────────────\n99: // 3. HELPERS\n100: // ─────────────────────────────────────────────────────────────────────────────\n101: \n102: function resolveMirrorPath(repoRoot, template, agentName) {\n103:   return path.join(repoRoot, template.replace('{name}', agentName));\n104: }\n105: \n106: /**\n107:  * Strip leading YAML frontmatter from markdown content.\n108:  *\n109:  * @param {string} content - Raw file content.\n110:  * @returns {string} Content with the leading frontmatter block removed.\n111:  */\n112: function stripFrontmatter(content) {\n113:   return parseFrontmatter(String(content || '')).body;\n114: }\n115: \n116: /**\n117:  * Extract the agent body from runtime-mirror content by format.\n118:  *\n119:  * @param {string} content - Raw mirror file content.\n120:  * @param {string} [format] - Mirror format (always 'markdown'; kept as a\n121:  *   parameter so a future non-markdown runtime mirror can extend this\n122:  *   without changing the call sites).\n123:  * @returns {string|null} Trimmed agent body, or null if not extractable.\n124:  */\n125: function extractAgentBody(content, format = 'markdown') {\n126:   if (format === 'toml') {\n127:     const literal = String(content || '').match(\n128:       /^\\s*developer_instructions\\s*=\\s*'''([\\s\\S]*?)'''\\s*$/m,\n129:     );\n130:     if (literal) return literal[1].trim();\n131:     const quoted = String(content || '').match(\n132:       /^\\s*developer_instructions\\s*=\\s*(\"(?:\\\\.|[^\"\\\\])*\")\\s*$/m,\n133:     );\n134:     if (quoted) {\n135:       try {\n136:         return JSON.parse(quoted[1]).trim();\n137:       } catch {\n138:         return null;\n139:       }\n140:     }\n141:     return null;\n142:   }\n143:   return stripFrontmatter(content).trim();\n144: }\n145: \n146: function normalizeRuntimeSpecificText(body) {\n147:   return String(body || '')\n148:     // Agent-file references include literal placeholders like `<name>`, so the\n149:     // name class allows < and >. This normalizes the per-runtime path so a\n150:     // real body difference elsewhere still registers as drift.\n151:     .replace(/\\.(?:skilled|opencode|claude|pi)\\/agents\\/\\*\\.md/g, '<runtime-agent-path>')\n152:     .replace(/\\.(?:skilled|opencode|claude|pi)\\/agents\\/[A-Za-z0-9_<>-]+\\.md/g, '<runtime-agent-file>')\n153:     .replace(/\\.(?:skilled|opencode|claude|pi)\\/agents\\/(?![A-Za-z0-9_<>*-])/g, '<runtime-agent-dir>')\n154:     .replace(/\\.codex\\/agents\\/[A-Za-z0-9_<>-]+\\.toml/g, '<runtime-agent-file>')\n155:     // Each mirror describes itself (\"this runtime's mirror; the canonical source\n156:     // lives in .opencode/agents/\") in a parenthetical the .opencode canonical\n157:     // omits. That is legitimate per-runtime self-description, not body drift, so\n158:     // drop the whole clause before comparing.\n159:     .replace(/\\(this runtime.s mirror;[^)]*\\)/gi, '')\n160:     .replace(/\\r\\n/g, '\\n')\n161:     .replace(/[ \\t]+$/gm, '')\n162:     .trim();\n163: }\n164: \n165: function tokenizeBody(body) {\n166:   const normalized = normalizeRuntimeSpecificText(body).toLowerCase();\n167:   return new Set(normalized.match(/[a-z0-9_./*-]{3,}/g) || []);\n168: }\n169: \n170: function extractLoadBearingSequence(body) {\n171:   const markerPattern = LOAD_BEARING_MARKERS.map((marker) => marker.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('|');\n172:   const sequence = [];\n173:   const linePattern = new RegExp(\n174:     `^\\\\s*(?:\\\\d+[.)]\\\\s+)?[^\\\\n]*?\\\\b(${markerPattern})\\\\b[^\\\\n]*$`,\n175:     'gim',\n176:   );\n177:   for (const match of String(body || '').matchAll(linePattern)) {\n178:     const marker = match[1].toUpperCase();\n179:     const line = match[0];\n180:     if (/^\\s*\\d+[.)]\\s+/.test(line) || /►|->|→/.test(line)) sequence.push(marker);\n181:   }\n182:   return sequence;\n183: }\n184: \n185: function extractDeclaredToolSurface(content, format = 'markdown') {\n186:   if (format !== 'markdown') {\n187:     return { comparable: false, tools: [] };\n188:   }\n189:   // Tool declarations stay line-read verbatim (quoted or comma forms must not\n190:   // be YAML-interpreted); only the fence split comes from the shared parser.\n191:   const parsed = parseFrontmatter(String(content || ''));\n192:   if (parsed.raw === null) return { comparable: false, tools: [] };\n193:   const block = parsed.raw.slice(4, -4);\n194: \n195:   const tools = new Set();\n196:   let listSection = false;\n197:   for (const line of block.split(/\\r?\\n/)) {\n198:     const listStart = line.match(/^\\s*(tools|allowed-tools):\\s*(.*?)\\s*$/i);\n199:     if (listStart) {\n200:       listSection = true;\n201:       for (const token of listStart[2].match(/[A-Za-z][A-Za-z0-9_.*-]*/g) || []) {\n202:         tools.add(token.toLowerCase());\n203:       }\n204:       continue;\n205:     }\n206:     if (listSection && /^\\s+-\\s+/.test(line)) {\n207:       const item = line.match(/^\\s+-\\s+([^\\s#]+)/);\n208:       if (item) tools.add(item[1].toLowerCase());\n209:       continue;\n210:     }\n211:     if (line.trim() && !/^\\s+/.test(line)) listSection = false;\n212: \n213:     const permission = line.match(/^\\s*([A-Za-z][A-Za-z0-9_-]*):\\s*(allow|allowed|true|yes)\\s*$/i);\n214:     if (permission) tools.add(permission[1].toLowerCase());\n215:   }\n216:   return { comparable: true, tools: [...tools].sort() };\n217: }\n218: \n219: function requiredBodyTools(body) {\n220:   return Object.keys(TOOL_ALIASES).filter((tool) => (\n221:     new RegExp(`\\\\b${tool}\\\\b`, 'i').test(String(body || ''))\n222:   ));\n223: }\n224: \n225: function compareToolSurface(expectedContent, actualContent, expectedFormat = 'markdown', actualFormat = 'markdown') {\n226:   const expectedBody = extractAgentBody(expectedContent, expectedFormat);\n227:   const requiredTools = requiredBodyTools(expectedBody || '');\n228:   const actualSurface = extractDeclaredToolSurface(actualContent, actualFormat);\n229:   if (!actualSurface.comparable || requiredTools.length === 0) {\n230:     return { comparable: actualSurface.comparable, matches: true, missingTools: [], requiredTools };\n231:   }\n232:   const actualTools = new Set(actualSurface.tools);\n233:   const missingTools = requiredTools.filter((tool) => (\n234:     !(TOOL_ALIASES[tool] || [tool]).some((alias) => actualTools.has(alias))\n235:   ));\n236:   return {\n237:     comparable: true,\n238:     matches: missingTools.length === 0,\n239:     missingTools,\n240:     requiredTools,\n241:   };\n242: }\n243: \n244: /**\n245:  * Compare two agent bodies by normalized token sets for drift.\n246:  *\n247:  * @param {string} expectedBody - Canonical expected body.\n248:  * @param {string} actualBody - Mirror body to compare against.\n249:  * @returns {Object} Comparison with matches flag and missing/unexpected tokens.\n250:  */\n251: function compareBodyTokens(expectedBody, actualBody) {\n252:   const expectedTokens = tokenizeBody(expectedBody);\n253:   const actualTokens = tokenizeBody(actualBody);\n254:   const missingTokens = [...expectedTokens].filter((token) => !actualTokens.has(token)).sort();\n255:   const unexpectedTokens = [...actualTokens].filter((token) => !expectedTokens.has(token)).sort();\n256:   const expectedLoadBearingSequence = extractLoadBearingSequence(expectedBody);\n257:   const actualLoadBearingSequence = extractLoadBearingSequence(actualBody);\n258:   const orderMatches = expectedLoadBearingSequence.length === 0\n259:     && actualLoadBearingSequence.length === 0\n260:     ? true\n261:     : JSON.stringify(expectedLoadBearingSequence) === JSON.stringify(actualLoadBearingSequence);\n262: \n263:   return {\n264:     matches: missingTokens.length === 0 && unexpectedTokens.length === 0 && orderMatches,\n265:     missingTokenCount: missingTokens.length,\n266:     unexpectedTokenCount: unexpectedTokens.length,\n267:     missingTokens: missingTokens.slice(0, 20),\n268:     unexpectedTokens: unexpectedTokens.slice(0, 20),\n269:     expectedLoadBearingSequence,\n270:     actualLoadBearingSequence,\n271:     orderMatches,\n272:   };\n273: }\n274: \n275: /**\n276:  * Infer the agent name from a mirror file path (basename without extension).\n277:  *\n278:  * @param {string} filePath - Path to a runtime-mirror agent file.\n279:  * @returns {string} Agent name derived from the file basename.\n280:  */\n281: function inferAgentNameFromPath(filePath) {\n282:   const ext = path.extname(filePath);\n283:   return path.basename(filePath, ext);\n284: }\n285: \n286: /**\n287:  * Resolve the per-runtime mirror paths for an agent name.\n288:  *\n289:  * @param {string} agentName - Agent name to expand into mirror paths.\n290:  * @param {string} [repoRoot] - Repository root for absolute path resolution.\n291:  * @returns {Array<Object>} Mirror descriptors with runtime, path, absolutePath, format.\n292:  */\n293: function runtimePaths(agentName, repoRoot = process.cwd()) {\n294:   return RUNTIME_MIRRORS.map((mirror) => ({\n295:     runtime: mirror.runtime,\n296:     path: mirror.template.replace('{name}', agentName),\n297:     absolutePath: resolveMirrorPath(repoRoot, mirror.template, agentName),\n298:     format: mirror.format,\n299:     required: mirror.required,\n300:     comparable: mirror.comparable !== false,\n301:   }));\n302: }\n303: \n304: // ─────────────────────────────────────────────────────────────────────────────\n305: // 4. CORE LOGIC\n306: // ─────────────────────────────────────────────────────────────────────────────\n307: \n308: /**\n309:  * Verify that all repo-managed runtime mirrors of an agent are present and in sync.\n310:  *\n311:  * @param {string} agentName - Agent name to verify across runtime mirrors.\n312:  * @param {string} content - Canonical agent content to compare mirrors against.\n313:  * @param {Object} [options] - Options bag.\n314:  * @param {string} [options.repoRoot] - Repository root for resolving mirror paths.\n315:  * @param {string} [options.expectedFormat] - Format of the canonical content.\n316:  * @returns {Object} Result with present/missing/drift runtimes, allInSync, details.\n317:  */\n318: function verifyMirrorSync(agentName, content, options = {}) {\n319:   const repoRoot = path.resolve(options.repoRoot || process.cwd());\n320:   const expectedFormat = options.expectedFormat || 'markdown';\n321:   const expectedBody = extractAgentBody(content, expectedFormat);\n322:   if (!agentName || typeof agentName !== 'string') {\n323:     throw new Error('verifyMirrorSync requires an agentName');\n324:   }\n325:   if (expectedBody === null || expectedBody.length === 0) {\n326:     throw new Error('verifyMirrorSync requires extractable agent body content');\n327:   }\n328: \n329:   const presentRuntimes = [];\n330:   const missingRuntimes = [];\n331:   const driftRuntimes = [];\n332:   const details = [];\n333:   const canonicalPath = resolveMirrorPath(repoRoot, '.opencode/agents/{name}.md', agentName);\n334:   const canonicalRealPath = fs.existsSync(canonicalPath) ? fs.realpathSync(canonicalPath) : null;\n335: \n336:   for (const mirror of runtimePaths(agentName, repoRoot)) {\n337:     if (!fs.existsSync(mirror.absolutePath)) {\n338:       if (mirror.required !== false) missingRuntimes.push(mirror.runtime);\n339:       details.push({\n340:         runtime: mirror.runtime,\n341:         path: mirror.path,\n342:         status: mirror.required === false ? 'not-shipped' : 'missing',\n343:       });\n344:       continue;\n345:     }\n346: \n347:     presentRuntimes.push(mirror.runtime);\n348:     if (canonicalRealPath && fs.realpathSync(mirror.absolutePath) === canonicalRealPath) {\n349:       details.push({\n350:         runtime: mirror.runtime,\n351:         path: mirror.path,\n352:         status: 'same-file',\n353:       });\n354:       continue;\n355:     }\n356: \n357:     if (!mirror.comparable) {\n358:       details.push({\n359:         runtime: mirror.runtime,\n360:         path: mirror.path,\n361:         status: 'present-but-not-compared',\n362:         reason: 'format-not-comparable',\n363:       });\n364:       continue;\n365:     }\n366: \n367:     const mirrorContent = fs.readFileSync(mirror.absolutePath, 'utf8');\n368:     const mirrorBody = extractAgentBody(mirrorContent, mirror.format);\n369:     if (mirrorBody === null) {\n370:       driftRuntimes.push(mirror.runtime);\n371:       details.push({\n372:         runtime: mirror.runtime,\n373:         path: mirror.path,\n374:         status: 'drift',\n375:         reason: 'body-unextractable',\n376:       });\n377:       continue;\n378:     }\n379: \n380:     const comparison = compareBodyTokens(expectedBody, mirrorBody);\n381:     const surfaceComparison = compareToolSurface(content, mirrorContent, expectedFormat, mirror.format);\n382:     if (!comparison.matches || !surfaceComparison.matches) {\n383:       driftRuntimes.push(mirror.runtime);\n384:       details.push({\n385:         runtime: mirror.runtime,\n386:         path: mirror.path,\n387:         status: 'drift',\n388:         comparison,\n389:         surfaceComparison,\n390:       });\n391:       continue;\n392:     }\n393: \n394:     details.push({\n395:       runtime: mirror.runtime,\n396:       path: mirror.path,\n397:       status: 'in-sync',\n398:       surfaceComparison,\n399:     });\n400:   }\n401: \n402:   return {\n403:     presentRuntimes,\n404:     missingRuntimes,\n405:     driftRuntimes,\n406:     allInSync: missingRuntimes.length === 0 && driftRuntimes.length === 0,\n407:     details,\n408:   };\n409: }\n410: \n411: // ─────────────────────────────────────────────────────────────────────────────\n412: // 5. EXPORTS\n413: // ─────────────────────────────────────────────────────────────────────────────\n414: \n415: module.exports = {\n416:   RUNTIME_MIRRORS,\n417:   NOT_CHECKABLE_CODE,\n418:   compareBodyTokens,\n419:   compareToolSurface,\n420:   extractAgentBody,\n421:   extractDeclaredToolSurface,\n422:   extractLoadBearingSequence,\n423:   inferAgentNameFromPath,\n424:   runtimePaths,\n425:   stripFrontmatter,\n426:   verifyMirrorSync,\n427: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/bin/lib/mirror-sync-verify.cjs\"}"},"time":{"start":1794583011353,"end":1794583011393}}}}
