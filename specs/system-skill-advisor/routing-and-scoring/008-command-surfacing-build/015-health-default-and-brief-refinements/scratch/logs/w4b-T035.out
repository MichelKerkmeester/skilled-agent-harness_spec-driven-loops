dHit);\n525:         if (publishRow) {\n526:           typedRowResults[row.id] = {\n527:             expected_command: expected,\n528:             top: ids[0] ?? null,\n529:             carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n530:             command: delivered ?? null,\n531:             policy: deliveredPolicy,\n532:           };\n533:         }\n534:       }\n535:       if (isPlainSplit) {\n536:         addRow(plain[row.split], top1Hit, top3Hit);\n537:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n538:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n539:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n540:       }\n541:       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n542:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n543:         sameOwnerAmbiguous.push(row.id);\n544:       }\n545: \n546:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n547:       if (commandTally) {\n548:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n549:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n550:       }\n551: \n552:       if (publishRow) {\n553:         rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n554:       }\n555: \n556:       const isSlashVariant = row.row_type === 'slash-variant';\n557:       // Silence is the requirement for a near miss, a prompt that must not\n558:       // trigger a command, and a partial slash mention that names no command.\n559:       const wantsSilence = row.row_type === 'must-not-start'\n560:         || row.row_type === 'near-miss'\n561:         || (isSlashVariant && expected === null);\n562:       if (wantsSilence) {\n563:         falseOfferTotal += 1;\n564:         if (offered) falseOfferCount += 1;\n565:         if (attached !== undefined) falseOfferAttached += 1;\n566:         if (needsMode) needsModeFloor += 1;\n567:       }\n568: \n569:       if (isSlashVariant) {\n570:         if (expected === null) {\n571:           slashPartialTotal += 1;\n572:           if (offered) slashOfferedOnPartial += 1;\n573:         } else {\n574:           slashNamedTotal += 1;\n575:           if (top3Hit) slashReachedTop3 += 1;\n576:         }\n577:       }\n578: \n579:       // A bridge offered below a skill is correct when the skill that outranked\n580:       // it is the bridge's own owner: the command stays reachable without the\n581:       // bridge displacing the skill the prompt actually asked for.\n582:       if (!idToCommand.has(ids[0])) {\n583:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n584:         if (laterBridgeId !== undefined) {\n585:           agreementTotal += 1;\n586:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n587:         }\n588:       }\n589:     }\n590: \n591:     const commands = {};\n592:     for (const command of [...perCommand.keys()].sort()) {\n593:       commands[command] = perCommand.get(command);\n594:     }\n595: \n596:     // Row ids are keyed in sorted order so a diff between two captures reads as\n597:     // the rows that changed rather than as reordered output.\n598:     const typedRows = {};\n599:     for (const id of Object.keys(typedRowResults).sort()) {\n600:       typedRows[id] = typedRowResults[id];\n601:     }\n602: \n603:     const reachableCommands = new Set();\n604:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n605:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n606: \n607:     const plainByFamily = {};\n608:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n609:       const family = plainAttachedByFamily.get(namespace);\n610:       plainByFamily[namespace] = {\n611:         tune: attachedTallyJson(family.tune),\n612:         holdout: attachedTallyJson(family.holdout),\n613:       };\n614:     }\n615: \n616:     return {\n617:       schemaVersion: 1,\n618:       capturedAt,\n619:       capturedAtSha: readHeadSha(workspaceRoot),\n620:       corpusSha256: sha256File(CORPUS_JSONL),\n621:       bridgeCounts,\n622:       metrics: {\n623:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n624:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n625:         plain_recall_at_1: {\n626:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n627:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n628:         },\n629:         plain_reach_top3: {\n630:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n631:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n632:         },\n633:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n634:         slash_variant: {\n635:           reached_top3: slashReachedTop3,\n636:           named_total: slashNamedTotal,\n637:           offered_on_partial: slashOfferedOnPartial,\n638:           partial_total: slashPartialTotal,\n639:         },\n640:         agreement: { correct: agreementCorrect, total: agreementTotal },\n641:       },\n642:       unreachable,\n643:       commands,\n644:       rows,\n645:       attachedMetrics: {\n646:         plain: {\n647:           tune: attachedTallyJson(plainAttached.tune),\n648:           holdout: attachedTallyJson(plainAttached.holdout),\n649:         },\n650:         plain_by_family: plainByFamily,\n651:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n652:         typed: attachedTallyJson(typedAttached),\n653:         typedRows,\n654:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n655:         attachedRows,\n656:         needs_mode_floor: { count: needsModeFloor, total: falseOfferTotal },\n657:         needsModeRows: needsModeRows.sort(),\n658:       },\n659:     };\n660:   } finally {\n661:     globalThis.Date = RealDate;\n662:     // Removal comes last, after every read that needs the directory has\n663:     // finished; `force` keeps an already-swept directory from turning a\n664:     // completed capture into a failure.\n665:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n666:   }\n667: }\n668: \n669: // ───────────────────────────────────────────────────────────────────\n670: // 7. CLI ENTRY\n671: // ───────────────────────────────────────────────────────────────────\n672: \n673: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n674:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n675: \n676:   const realEmbedding = process.argv.includes('--real-embedding');\n677:   // The committed baseline has to be reproducible on a clean checkout, so it may\n678:   // only come from the fixture regime. A real-embedding run measures this machine's\n679:   // embedder and graph, which is a live probe rather than a ratchet.\n[Output truncated. Continue reading with offset: 680]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\",\"offset\":450,\"limit\":230}"},"time":{"start":1794565762709,"end":1794565766263}}}}
{"type":"step_finish","timestamp":1794565767323,"sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","part":{"id":"prt_1d474809b001Xg46JTJWWRsNst","sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","messageID":"msg_1d4745f67001abqLq3S7EKbsjb","type":"step-finish","reason":"tool-calls","snapshot":"37a758bd88d2b5fce19b9f4b27d817f72cca3c55","cost":0,"tokens":{"input":540,"output":120,"reasoning":0,"cache":{"read":44672,"write":0}}}}
{"type":"step_start","timestamp":1794565773983,"sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","part":{"id":"prt_1d4749a9f001UHQGZiHhQNW1c0","sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","messageID":"msg_1d47480a1001mjzOx0WS9JVvbd","type":"step-start","snapshot":"07f08b4460f0f6332f2d053eb0ef8bf299e64bd4"}}
{"type":"tool_use","timestamp":1794565777493,"sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","part":{"partID":"prt_1d474a4d90015CKQ0Rc0PcnNlG","sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","messageID":"msg_1d47480a1001mjzOx0WS9JVvbd","type":"tool","id":"call_5ec2a310b6334ad5adaf8b1e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md, lines 1-315\n1: ---\n2: title: Universal Patterns - Cross-Language Code Standards\n3: description: Patterns applicable to ALL languages in OpenCode system code including naming principles, commenting philosophy, and reference comment patterns.\n4: trigger_phrases:\n5:   - \"opencode universal patterns\"\n6:   - \"cross language naming principles\"\n7:   - \"commenting philosophy why\"\n8:   - \"reference comment patterns\"\n9: importance_tier: normal\n10: contextType: implementation\n11: version: 1.1.2.0\n12: ---\n13: \n14: # Universal Patterns - Cross-Language Code Standards\n15: \n16: Patterns applicable to ALL languages in OpenCode system code.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: This reference defines patterns that apply universally across JavaScript, TypeScript, Python, Shell, Rust, and JSON/JSONC in the OpenCode codebase. These principles ensure consistency regardless of language choice.\n25: \n26: ### When to Use\n27: \n28: - Before writing any new OpenCode system code\n29: - When reviewing code for consistency\n30: - When onboarding to OpenCode development patterns\n31: - As the foundation before applying language-specific rules\n32: \n33: ### Core Principle\n34: \n35: > **Clarity over cleverness.** Code is read far more often than written. Optimize for the reader, not the writer.\n36: \n37: ### Key Sources (Evidence)\n38: \n39: | Pattern | Source File | Line Reference |\n40: |---------|-------------|----------------|\n41: | Reference comments | `.skilled/skills/system-spec-kit/runtime/lib/search/folder-discovery.ts` | Near file top and import blocks |\n42: | Section organization | `.skilled/skills/system-spec-kit/runtime/cli/core/config.ts` | Numbered divider blocks |\n43: | Naming conventions | `.skilled/skills/system-spec-kit/runtime/lib/config/spec-doc-paths.ts` | Throughout |\n44: | Python docstrings | `.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py` | Module and function docstrings |\n45: \n46: ---\n47: \n48: ## 2. NAMING PRINCIPLES\n49: \n50: ### Descriptive Names\n51: \n52: Names should describe what something IS or DOES without requiring context:\n53: \n54: **Good** (JS/TS use camelCase, Python/Shell use snake_case):\n55: ```javascript\n56: // JavaScript\n57: calculateMemoryScore()\n58: validateInputLengths()\n59: handleMemorySearch()\n60: ```\n61: ```typescript\n62: // TypeScript (same as JS for functions; PascalCase for types)\n63: calculateMemoryScore()\n64: validateInputLengths()\n65: interface SearchResult { }\n66: type MemoryState = 'active' | 'archived';\n67: ```\n68: ```python\n69: # Python\n70: calculate_memory_score()\n71: validate_input_lengths()\n72: handle_trigger_lookup()\n73: ```\n74: \n75: **Bad**:\n76: ```\n77: calcScore()\n78: validateLengths()\n79: handle()\n80: ```\n81: \n82: ### Avoid Abbreviations\n83: \n84: Spell out words unless industry-standard:\n85: \n86: | Use | Don't Use | Exception |\n87: |-----|-----------|-----------|\n88: | `configuration` | `cfg` | - |\n89: | `database` | `db` | OK for `DB` in constants |\n90: | `message` | `msg` | - |\n91: | `request` | `req` | OK in route handlers |\n92: | `response` | `res` | OK in route handlers |\n93: | `HTTP` | `http` | OK - industry standard |\n94: | `URL` | `url` | OK - industry standard |\n95: | `ID` | `id` | OK - industry standard |\n96: \n97: ### Consistency Rule\n98: \n99: Same concept = same name across the entire codebase:\n100: \n101: ```javascript\n102: // GOOD: Consistent naming (JS/TS)\n103: memorySearch()          // in handlers\n104: handleMemorySearch()    // wrapper\n105: MemorySearchResult      // type/interface (PascalCase)\n106: \n107: // BAD: Inconsistent naming\n108: memorySearch()          // in handlers\n109: handle_search()         // wrapper - wrong convention!\n110: SearchMemoryResult      // type - different word order!\n111: ```\n112: \n113: ### Boolean Naming\n114: \n115: Booleans should read as questions:\n116: \n117: ```javascript\n118: // JavaScript / TypeScript (camelCase)\n119: isValid\n120: hasResults\n121: canProceed\n122: shouldRetry\n123: enableDedup\n124: ```\n125: \n126: ```typescript\n127: // TypeScript — with type annotation\n128: const isValid: boolean = true;\n129: const hasResults: boolean = items.length > 0;\n130: ```\n131: \n132: ```python\n133: # Python / Shell (snake_case)\n134: is_valid\n135: has_results\n136: can_proceed\n137: should_retry\n138: enable_dedup\n139: ```\n140: \n141: ```\n142: // BAD (any language)\n143: valid      // is it valid? or make it valid?\n144: results    // what about results?\n145: proceed    // noun or verb?\n146: ```\n147: \n148: ### SKILLED Identifier Convention\n149: \n150: The universal style guide asks each surface to state its identifier scheme. This is the SKILLED one:\n151: \n152: | Language | Identifier convention |\n153: | --- | --- |\n154: | JavaScript and TypeScript | `camelCase` for variables and functions, `PascalCase` for classes and types, `UPPER_SNAKE` for constants |\n155: | Python and Shell | `snake_case` for variables and functions, `PascalCase` for classes, `UPPER_SNAKE` for constants |\n156: \n157: The language checklists under `../../../assets/checklists/` enforce it.\n158: \n159: ### Plural Naming for Collections\n160: \n161: Arrays and collections use plural names:\n162: \n163: ```\n164: // GOOD\n165: const memories = [];\n166: const results = searchResults.items;\n167: for (const entry of entries) { ... }\n168: \n169: // BAD\n170: const memory = [];        // misleading - it's an array\n171: const result = results.items;  // confusing\n172: for (const entry of entry) { ... }  // very confusing\n173: ```\n174: \n175: ---\n176: \n177: ## 3. COMMENTING PHILOSOPHY\n178: \n179: ### Core Principles\n180: \n181: 1. **Quantity limit (Skilled surface setting):** Maximum 3 comments per 10 lines of code. This number is the Skilled surface's budget. The comment-density rule it applies, and the rule that each surface sets its own budget, live in the shared [code style guide](../../../../sk-code-quality/references/code-style-guide.md).\n182: 2. **Focus on purposeful semantics:** Explain WHY something is done, not WHAT it does\n183: 3. **No commented-out code:** Delete unused code (git preserves history)\n184: 4. **Function purpose comments:** Single line above function describing intent\n185: 5. **Capitalization:** Every inline comment sentence MUST start with a capital letter\n186:    - `// Process items in reverse order` (correct)\n187:    - `// process items in reverse order` (wrong)\n188:    - Exception: `eslint-disable`, `@ts-` directives, and technical identifiers (e.g., `// e.g. ...`)\n189: \n190: ### WHY Not WHAT\n191: \n192: Comments explain **reasoning**, not **mechanics**:\n193: \n194: **Bad - describes WHAT**:\n195: ```javascript\n196: // Loop through items\n197: for (const item of items) { ... }\n198: \n199: // Increment counter\n200: counter++;\n201: \n202: // Check if valid\n203: if (isValid) { ... }\n204: ```\n205: \n206: **Good - explains WHY**:\n207: ```javascript\n208: // Process in reverse order for dependency resolution\n209: for (const item of items.reverse()) { ... }\n210: \n211: // Track retry count for exponential backoff control\n212: retryCount++;\n213: \n214: // Skip invalid entries to avoid downstream embedding errors\n215: if (!isValid) return null;\n216: ```\n217: \n218: ### When to Comment\n219: \n220: | Situation | Comment? | Example |\n221: |-----------|----------|---------|\n222: | Non-obvious logic | YES | `// Sort timestamp DESC so newest appears first` |\n223: | Business rule | YES | `// Constitutional tier must always surface regardless of score` |\n224: | Workaround | YES | `// Works around an SDK hang on empty payloads` |\n225: | Security concern | YES | `// SEC: sanitize input to prevent stored XSS (CWE-79)` |\n226: | Self-explanatory code | NO | `const sum = a + b;` needs no comment |\n227: | Obvious loops | NO | `for (let i = 0; i < 10; i++)` needs no comment |\n228: \n229: ### Header Markers\n230: \n231: SKILLED TypeScript files carry a `MODULE:` header where the TypeScript checklist requires one, and the alignment verifier checks that marker. Header forms for the other languages are in each language's style guide.\n232: \n233: ### Intentional-Simplification Marker (`ceiling:`)\n234: \n235: The universal style guide lets a surface define a marker for a deliberate shortcut. SKILLED defines `ceiling:`. Use the neutral `ceiling:` prefix and name the shortcut, its known ceiling and the upgrade path or trigger:\n236: \n237: ```python\n238: # ceiling: global lock; switch to per-account locks if throughput matters\n239: ```\n240: \n241: This is durable WHY, the constraint plus the decision, so the ephemeral-pointer rule allows it: it names no tracking artifact. Two constraints:\n242: \n243: - Use a neutral prefix (`ceiling:` or `intentional-limit:`), never a tool or brand name. A brand prefix reads as a perishable, cargo-cult label.\n244: - Do NOT add `ceiling:` to the comment-hygiene checker's allowed-pattern list. It already passes, because it contains no forbidden id, and allow-listing it would let a forbidden id on the same line slip through, because allowed patterns short-circuit violation detection.\n245: \n246: To list every marker in the tracked code and flag the ones whose trigger can never fire, run `.skilled/skills/sk-code/sk-code-quality/scripts/ceiling-report.sh`.\n247: \n248: ### Comment Placement\n249: \n250: Place comments on the line BEFORE the code they describe:\n251: \n252: ```javascript\n253: // GOOD: Comment before\n254: // Calculate weighted score using decay function\n255: const score = calculateDecay(baseScore, age);\n256: \n257: // BAD: Comment after\n258: const score = calculateDecay(baseScore, age); // weighted decay\n259: ```\n260: \n261: ---\n262: \n263: ## 4. REFERENCE COMMENT PATTERNS\n264: \n265: > **Governed by the canonical rule.** Comments must never embed an ephemeral-artifact pointer: a spec folder/number, a packet/phase/task/checklist/requirement id, a feature-catalog entry, an ADR id, or a ticket id. See [`../../../../sk-code-quality/references/code-style-guide.md`](../../../../sk-code-quality/references/code-style-guide.md) §4 \"No ephemeral-artifact pointers\" for the allowed-vs-forbidden contract. Only a **durable** external standard may be cited in a comment.\n266: \n267: ### Hard-Block Comment-Hygiene Gate\n268: \n269: Comment hygiene is not a soft style preference in OpenCode system code. Ephemeral-artifact pointers are a HARD-BLOCK gate for code comments: do not write spec-folder paths, ADR ids, requirement ids, checklist ids, task ids, packet/phase ids, or ticket-local references into comments. Replace them with the durable WHY that will still be true after a packet is renamed, archived, or deleted.\n270: \n271: This is enforced in two real hooks:\n272: \n273: - `.skilled/scripts/git-hooks/pre-commit` is the installed Git hook selected by the global `core.hooksPath`; it runs the shared checker against staged code files and blocks the commit when violations are found.\n274: - `.skilled/hooks/post-edit-quality/claude/claude-posttooluse.cjs` is the Claude `Write|Edit` adapter wired by `.claude/settings.json`; it runs the shared checker and surfaces immediate comment-hygiene warnings for the edited file.\n275: \n276: The older `.skilled/hooks/git/pre-commit` and `sk-code-quality/scripts/hooks/claude-posttooluse.sh` files remain compatibility helpers for direct tests only; neither is an installed runtime hook.\n277: \n278: ### Allowed Reference Comments\n279: \n280: | Prefix | Purpose | Allowed because | Example |\n281: |--------|---------|-----------------|---------|\n282: | `SEC:` | Security note tied to a stable standard | CWE/CVE/RFC ids are externally versioned and durable | `// SEC: sanitize user input to prevent stored XSS (CWE-79)` |\n283: | `PERF:` | Performance constraint | Names a durable behavioral requirement, no artifact id | `// PERF: debounce to one reflow per frame` |\n284: | `BUG` | Workaround for a durable external bug | Names the symptom + a durable tracker, not a spec-folder bug list | `// Works around an upstream SDK hang on empty payloads` |\n285: \n286: ### Removed prefixes — DO NOT USE\n287: \n288: `T###`, `REQ-###`, and `CHK-###` are **removed**. They point into `tasks.md` / `spec.md` / `checklist.md` inside a spec folder that is renamed or archived independently of the code — exactly the dangling pointer the canonical rule forbids. Replace the id with the durable WHY:\n289: \n290: ```typescript\n291: // BAD — points into an archived spec folder\n292: // T043-T047: Causal Memory Graph handlers\n293: \n294: // GOOD — names the behavior, which never gets archived\n295: // Causal Memory Graph handlers: drift-why, causal-link, causal-stats, causal-unlink\n296: handleMemoryDriftWhy, handleMemoryCausalLink, handleMemoryCausalStats, handleMemoryCausalUnlink,\n297: ```\n298: \n299: ### When to Use Reference Comments\n300: \n301: 1. **Security-sensitive code**: cite the durable standard (CWE/CVE/RFC) and the mitigation.\n302: 2. **Documented workaround**: name the durable external tracker plus the symptom.\n303: 3. **Never** to point at a spec folder, task, requirement, checklist, packet, phase, or ADR — capture the WHY instead.\n304: \n305: ---\n306: \n307: ## 5. DESIGN PRINCIPLES GATE (KISS/DRY/SOLID)\n308: \n309: Apply this gate before finalizing implementation:\n310: \n311: 1. **KISS**: remove speculative layers that do not serve current behavior.\n312: 2. **DRY**: centralize repeated literals/rules into a single source.\n313: 3. **SOLID**: flag SRP/OCP/LSP/ISP/DIP violations and simplify before merge.\n314: \n315: Keep rule constants centralized and make tests import those constants rather than repeat local literals.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md, lines 1-315\n1: ---\n2: title: Universal Patterns - Cross-Language Code Standards\n3: description: Patterns applicable to ALL languages in OpenCode system code including naming principles, commenting philosophy, and reference comment patterns.\n4: trigger_phrases:\n5:   - \"opencode universal patterns\"\n6:   - \"cross language naming principles\"\n7:   - \"commenting philosophy why\"\n8:   - \"reference comment patterns\"\n9: importance_tier: normal\n10: contextType: implementation\n11: version: 1.1.2.0\n12: ---\n13: \n14: # Universal Patterns - Cross-Language Code Standards\n15: \n16: Patterns applicable to ALL languages in OpenCode system code.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: This reference defines patterns that apply universally across JavaScript, TypeScript, Python, Shell, Rust, and JSON/JSONC in the OpenCode codebase. These principles ensure consistency regardless of language choice.\n25: \n26: ### When to Use\n27: \n28: - Before writing any new OpenCode system code\n29: - When reviewing code for consistency\n30: - When onboarding to OpenCode development patterns\n31: - As the foundation before applying language-specific rules\n32: \n33: ### Core Principle\n34: \n35: > **Clarity over cleverness.** Code is read far more often than written. Optimize for the reader, not the writer.\n36: \n37: ### Key Sources (Evidence)\n38: \n39: | Pattern | Source File | Line Reference |\n40: |---------|-------------|----------------|\n41: | Reference comments | `.skilled/skills/system-spec-kit/runtime/lib/search/folder-discovery.ts` | Near file top and import blocks |\n42: | Section organization | `.skilled/skills/system-spec-kit/runtime/cli/core/config.ts` | Numbered divider blocks |\n43: | Naming conventions | `.skilled/skills/system-spec-kit/runtime/lib/config/spec-doc-paths.ts` | Throughout |\n44: | Python docstrings | `.skilled/skills/system-skill-advisor/runtime/scripts/skill_advisor.py` | Module and function docstrings |\n45: \n46: ---\n47: \n48: ## 2. NAMING PRINCIPLES\n49: \n50: ### Descriptive Names\n51: \n52: Names should describe what something IS or DOES without requiring context:\n53: \n54: **Good** (JS/TS use camelCase, Python/Shell use snake_case):\n55: ```javascript\n56: // JavaScript\n57: calculateMemoryScore()\n58: validateInputLengths()\n59: handleMemorySearch()\n60: ```\n61: ```typescript\n62: // TypeScript (same as JS for functions; PascalCase for types)\n63: calculateMemoryScore()\n64: validateInputLengths()\n65: interface SearchResult { }\n66: type MemoryState = 'active' | 'archived';\n67: ```\n68: ```python\n69: # Python\n70: calculate_memory_score()\n71: validate_input_lengths()\n72: handle_trigger_lookup()\n73: ```\n74: \n75: **Bad**:\n76: ```\n77: calcScore()\n78: validateLengths()\n79: handle()\n80: ```\n81: \n82: ### Avoid Abbreviations\n83: \n84: Spell out words unless industry-standard:\n85: \n86: | Use | Don't Use | Exception |\n87: |-----|-----------|-----------|\n88: | `configuration` | `cfg` | - |\n89: | `database` | `db` | OK for `DB` in constants |\n90: | `message` | `msg` | - |\n91: | `request` | `req` | OK in route handlers |\n92: | `response` | `res` | OK in route handlers |\n93: | `HTTP` | `http` | OK - industry standard |\n94: | `URL` | `url` | OK - industry standard |\n95: | `ID` | `id` | OK - industry standard |\n96: \n97: ### Consistency Rule\n98: \n99: Same concept = same name across the entire codebase:\n100: \n101: ```javascript\n102: // GOOD: Consistent naming (JS/TS)\n103: memorySearch()          // in handlers\n104: handleMemorySearch()    // wrapper\n105: MemorySearchResult      // type/interface (PascalCase)\n106: \n107: // BAD: Inconsistent naming\n108: memorySearch()          // in handlers\n109: handle_search()         // wrapper - wrong convention!\n110: SearchMemoryResult      // type - different word order!\n111: ```\n112: \n113: ### Boolean Naming\n114: \n115: Booleans should read as questions:\n116: \n117: ```javascript\n118: // JavaScript / TypeScript (camelCase)\n119: isValid\n120: hasResults\n121: canProceed\n122: shouldRetry\n123: enableDedup\n124: ```\n125: \n126: ```typescript\n127: // TypeScript — with type annotation\n128: const isValid: boolean = true;\n129: const hasResults: boolean = items.length > 0;\n130: ```\n131: \n132: ```python\n133: # Python / Shell (snake_case)\n134: is_valid\n135: has_results\n136: can_proceed\n137: should_retry\n138: enable_dedup\n139: ```\n140: \n141: ```\n142: // BAD (any language)\n143: valid      // is it valid? or make it valid?\n144: results    // what about results?\n145: proceed    // noun or verb?\n146: ```\n147: \n148: ### SKILLED Identifier Convention\n149: \n150: The universal style guide asks each surface to state its identifier scheme. This is the SKILLED one:\n151: \n152: | Language | Identifier convention |\n153: | --- | --- |\n154: | JavaScript and TypeScript | `camelCase` for variables and functions, `PascalCase` for classes and types, `UPPER_SNAKE` for constants |\n155: | Python and Shell | `snake_case` for variables and functions, `PascalCase` for classes, `UPPER_SNAKE` for constants |\n156: \n157: The language checklists under `../../../assets/checklists/` enforce it.\n158: \n159: ### Plural Naming for Collections\n160: \n161: Arrays and collections use plural names:\n162: \n163: ```\n164: // GOOD\n165: const memories = [];\n166: const results = searchResults.items;\n167: for (const entry of entries) { ... }\n168: \n169: // BAD\n170: const memory = [];        // misleading - it's an array\n171: const result = results.items;  // confusing\n172: for (const entry of entry) { ... }  // very confusing\n173: ```\n174: \n175: ---\n176: \n177: ## 3. COMMENTING PHILOSOPHY\n178: \n179: ### Core Principles\n180: \n181: 1. **Quantity limit (Skilled surface setting):** Maximum 3 comments per 10 lines of code. This number is the Skilled surface's budget. The comment-density rule it applies, and the rule that each surface sets its own budget, live in the shared [code style guide](../../../../sk-code-quality/references/code-style-guide.md).\n182: 2. **Focus on purposeful semantics:** Explain WHY something is done, not WHAT it does\n183: 3. **No commented-out code:** Delete unused code (git preserves history)\n184: 4. **Function purpose comments:** Single line above function describing intent\n185: 5. **Capitalization:** Every inline comment sentence MUST start with a capital letter\n186:    - `// Process items in reverse order` (correct)\n187:    - `// process items in reverse order` (wrong)\n188:    - Exception: `eslint-disable`, `@ts-` directives, and technical identifiers (e.g., `// e.g. ...`)\n189: \n190: ### WHY Not WHAT\n191: \n192: Comments explain **reasoning**, not **mechanics**:\n193: \n194: **Bad - describes WHAT**:\n195: ```javascript\n196: // Loop through items\n197: for (const item of items) { ... }\n198: \n199: // Increment counter\n200: counter++;\n201: \n202: // Check if valid\n203: if (isValid) { ... }\n204: ```\n205: \n206: **Good - explains WHY**:\n207: ```javascript\n208: // Process in reverse order for dependency resolution\n209: for (const item of items.reverse()) { ... }\n210: \n211: // Track retry count for exponential backoff control\n212: retryCount++;\n213: \n214: // Skip invalid entries to avoid downstream embedding errors\n215: if (!isValid) return null;\n216: ```\n217: \n218: ### When to Comment\n219: \n220: | Situation | Comment? | Example |\n221: |-----------|----------|---------|\n222: | Non-obvious logic | YES | `// Sort timestamp DESC so newest appears first` |\n223: | Business rule | YES | `// Constitutional tier must always surface regardless of score` |\n224: | Workaround | YES | `// Works around an SDK hang on empty payloads` |\n225: | Security concern | YES | `// SEC: sanitize input to prevent stored XSS (CWE-79)` |\n226: | Self-explanatory code | NO | `const sum = a + b;` needs no comment |\n227: | Obvious loops | NO | `for (let i = 0; i < 10; i++)` needs no comment |\n228: \n229: ### Header Markers\n230: \n231: SKILLED TypeScript files carry a `MODULE:` header where the TypeScript checklist requires one, and the alignment verifier checks that marker. Header forms for the other languages are in each language's style guide.\n232: \n233: ### Intentional-Simplification Marker (`ceiling:`)\n234: \n235: The universal style guide lets a surface define a marker for a deliberate shortcut. SKILLED defines `ceiling:`. Use the neutral `ceiling:` prefix and name the shortcut, its known ceiling and the upgrade path or trigger:\n236: \n237: ```python\n238: # ceiling: global lock; switch to per-account locks if throughput matters\n239: ```\n240: \n241: This is durable WHY, the constraint plus the decision, so the ephemeral-pointer rule allows it: it names no tracking artifact. Two constraints:\n242: \n243: - Use a neutral prefix (`ceiling:` or `intentional-limit:`), never a tool or brand name. A brand prefix reads as a perishable, cargo-cult label.\n244: - Do NOT add `ceiling:` to the comment-hygiene checker's allowed-pattern list. It already passes, because it contains no forbidden id, and allow-listing it would let a forbidden id on the same line slip through, because allowed patterns short-circuit violation detection.\n245: \n246: To list every marker in the tracked code and flag the ones whose trigger can never fire, run `.skilled/skills/sk-code/sk-code-quality/scripts/ceiling-report.sh`.\n247: \n248: ### Comment Placement\n249: \n250: Place comments on the line BEFORE the code they describe:\n251: \n252: ```javascript\n253: // GOOD: Comment before\n254: // Calculate weighted score using decay function\n255: const score = calculateDecay(baseScore, age);\n256: \n257: // BAD: Comment after\n258: const score = calculateDecay(baseScore, age); // weighted decay\n259: ```\n260: \n261: ---\n262: \n263: ## 4. REFERENCE COMMENT PATTERNS\n264: \n265: > **Governed by the canonical rule.** Comments must never embed an ephemeral-artifact pointer: a spec folder/number, a packet/phase/task/checklist/requirement id, a feature-catalog entry, an ADR id, or a ticket id. See [`../../../../sk-code-quality/references/code-style-guide.md`](../../../../sk-code-quality/references/code-style-guide.md) §4 \"No ephemeral-artifact pointers\" for the allowed-vs-forbidden contract. Only a **durable** external standard may be cited in a comment.\n266: \n267: ### Hard-Block Comment-Hygiene Gate\n268: \n269: Comment hygiene is not a soft style preference in OpenCode system code. Ephemeral-artifact pointers are a HARD-BLOCK gate for code comments: do not write spec-folder paths, ADR ids, requirement ids, checklist ids, task ids, packet/phase ids, or ticket-local references into comments. Replace them with the durable WHY that will still be true after a packet is renamed, archived, or deleted.\n270: \n271: This is enforced in two real hooks:\n272: \n273: - `.skilled/scripts/git-hooks/pre-commit` is the installed Git hook selected by the global `core.hooksPath`; it runs the shared checker against staged code files and blocks the commit when violations are found.\n274: - `.skilled/hooks/post-edit-quality/claude/claude-posttooluse.cjs` is the Claude `Write|Edit` adapter wired by `.claude/settings.json`; it runs the shared checker and surfaces immediate comment-hygiene warnings for the edited file.\n275: \n276: The older `.skilled/hooks/git/pre-commit` and `sk-code-quality/scripts/hooks/claude-posttooluse.sh` files remain compatibility helpers for direct tests only; neither is an installed runtime hook.\n277: \n278: ### Allowed Reference Comments\n279: \n280: | Prefix | Purpose | Allowed because | Example |\n281: |--------|---------|-----------------|---------|\n282: | `SEC:` | Security note tied to a stable standard | CWE/CVE/RFC ids are externally versioned and durable | `// SEC: sanitize user input to prevent stored XSS (CWE-79)` |\n283: | `PERF:` | Performance constraint | Names a durable behavioral requirement, no artifact id | `// PERF: debounce to one reflow per frame` |\n284: | `BUG` | Workaround for a durable external bug | Names the symptom + a durable tracker, not a spec-folder bug list | `// Works around an upstream SDK hang on empty payloads` |\n285: \n286: ### Removed prefixes — DO NOT USE\n287: \n288: `T###`, `REQ-###`, and `CHK-###` are **removed**. They point into `tasks.md` / `spec.md` / `checklist.md` inside a spec folder that is renamed or archived independently of the code — exactly the dangling pointer the canonical rule forbids. Replace the id with the durable WHY:\n289: \n290: ```typescript\n291: // BAD — points into an archived spec folder\n292: // T043-T047: Causal Memory Graph handlers\n293: \n294: // GOOD — names the behavior, which never gets archived\n295: // Causal Memory Graph handlers: drift-why, causal-link, causal-stats, causal-unlink\n296: handleMemoryDriftWhy, handleMemoryCausalLink, handleMemoryCausalStats, handleMemoryCausalUnlink,\n297: ```\n298: \n299: ### When to Use Reference Comments\n300: \n301: 1. **Security-sensitive code**: cite the durable standard (CWE/CVE/RFC) and the mitigation.\n302: 2. **Documented workaround**: name the durable external tracker plus the symptom.\n303: 3. **Never** to point at a spec folder, task, requirement, checklist, packet, phase, or ADR — capture the WHY instead.\n304: \n305: ---\n306: \n307: ## 5. DESIGN PRINCIPLES GATE (KISS/DRY/SOLID)\n308: \n309: Apply this gate before finalizing implementation:\n310: \n311: 1. **KISS**: remove speculative layers that do not serve current behavior.\n312: 2. **DRY**: centralize repeated literals/rules into a single source.\n313: 3. **SOLID**: flag SRP/OCP/LSP/ISP/DIP violations and simplify before merge.\n314: \n315: Keep rule constants centralized and make tests import those constants rather than repeat local literals."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/shared/universal-patterns/naming-and-commenting.md\"}"},"time":{"start":1794565776601,"end":1794565777493}}}}
{"type":"tool_use","timestamp":1794565777498,"sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","part":{"partID":"prt_1d474a6b8001qK0PoQIv4NzT5p","sessionID":"ses_e2b8c79c0ffeLCVolj1hMkPIuC","messageID":"msg_1d47480a1001mjzOx0WS9JVvbd","type":"tool","id":"call_d69e55056d1847708e3ede31","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md, lines 1-467\n1: ---\n2: title: JavaScript Style Guide\n3: description: Formatting standards and naming conventions for JavaScript files in the OpenCode development environment.\n4: trigger_phrases:\n5:   - \"opencode javascript style guide\"\n6:   - \"javascript file header format\"\n7:   - \"use strict directive\"\n8:   - \"javascript section organization\"\n9: importance_tier: normal\n10: contextType: implementation\n11: version: 1.0.4.0\n12: ---\n13: \n14: # JavaScript Style Guide\n15: \n16: Open this when you are drafting or reviewing a JavaScript file and need the header, section order, naming rule or formatting detail that settles the point.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Defines consistent styling rules for JavaScript files to ensure readability, maintainability, and alignment across all OpenCode JavaScript code.\n25: \n26: ### When to Use\n27: \n28: Use when writing, reviewing, or resolving style questions for JavaScript files.\n29: \n30: ### Use Cases\n31: \n32: - Writing new JavaScript files\n33: - Reviewing JavaScript code for consistency\n34: - Resolving style disagreements in code review\n35: \n36: ---\n37: \n38: ## 2. FILE HEADER FORMAT\n39: \n40: All JavaScript files MUST begin with a module header identifying the module,\n41: using the divider form below. Module syntax follows the nearest package\n42: boundary and loader contract: `.cjs` is CommonJS, `.mjs` is ESM, and `.js`\n43: follows the nearest package's `type`. OpenCode plugin paths use their ESM\n44: loader contract.\n45: \n46: ### Template\n47: \n48: ```javascript\n49: // ───────────────────────────────────────────────────────────────────\n50: // MODULE: [Module Name]\n51: // ───────────────────────────────────────────────────────────────────\n52: ```\n53: \n54: ### Requirements\n55: \n56: - Divider width: 67 box-drawing characters after `// `\n57: - Module name: after `MODULE:` on the middle line\n58: - A shebang line may precede the header in an executable script\n59: - Immediately followed by `'use strict';` for `.js/.cjs` files, as required by\n60:   this repository's alignment checks; it is redundant in ESM `.js` files\n61: - `.mjs` files do not require `'use strict'`; ESM `.js` plugin files follow the\n62:   `.js` requirement above\n63: - The older 78-character `╔═╗` box is accepted where it already exists; do not\n64:   introduce it in new files\n65: \n66: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs:1-4`,\n67: `.skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs:1-4`\n68: \n69: ---\n70: \n71: ## 3. USE STRICT DIRECTIVE\n72: \n73: Every `.js` and `.cjs` JavaScript file MUST include the strict mode directive.\n74: This repository convention also applies to ESM `.js` files, where it is\n75: redundant because modules are strict by definition. Do not add it to `.mjs`\n76: files; the alignment verifier intentionally skips `.mjs` enforcement.\n77: \n78: ```javascript\n79: 'use strict';\n80: ```\n81: \n82: **Placement**: Immediately after file header, before any other code.\n83: \n84: **Evidence**: `verify_alignment_drift.py` skips `.mjs`; CommonJS-style JS\n85: helpers still use `'use strict'`.\n86: \n87: ---\n88: \n89: ## 4. SECTION ORGANIZATION\n90: \n91: Large files are organized using numbered section dividers.\n92: \n93: ### Section Divider Template\n94: \n95: ```javascript\n96: // ─────────────────────────────────────────────────────────────────────────────\n97: // 1. [SECTION NAME]\n98: // ─────────────────────────────────────────────────────────────────────────────\n99: ```\n100: \n101: ### Standard Section Order\n102: \n103: | Order | Section Name     | Purpose                           |\n104: |-------|------------------|-----------------------------------|\n105: | 1     | IMPORTS          | Module dependencies               |\n106: | 2     | CONSTANTS        | Configuration values, magic numbers |\n107: | 3     | HELPERS          | Internal utility functions        |\n108: | 4     | CORE LOGIC       | Main implementation               |\n109: | 5     | EXPORTS          | Module public interface           |\n110: \n111: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/core/config.ts`\n112: \n113: ---\n114: \n115: ## 5. NAMING CONVENTIONS\n116: \n117: ### Function Names\n118: \n119: **Style**: `camelCase`\n120: \n121: ```javascript\n122: // CORRECT\n123: function loadConfig(path) { }\n124: function memorySearch(query, options) { }\n125: function validateInput(data) { }\n126: \n127: // INCORRECT\n128: function load_config(path) { }     // snake_case\n129: function LoadConfig(path) { }      // PascalCase\n130: function load-config(path) { }     // kebab-case (invalid syntax)\n131: ```\n132: \n133: **Evidence**: MDN Web Docs, Airbnb Style Guide, Node.js core APIs\n134: \n135: ### Constant Names\n136: \n137: **Style**: `UPPER_SNAKE_CASE`\n138: \n139: ```javascript\n140: // CORRECT\n141: const MAX_RETRIES = 3;\n142: const DEFAULT_TIMEOUT = 5000;\n143: const SQLITE_BUSY_TIMEOUT = 30000;\n144: \n145: // INCORRECT\n146: const maxRetries = 3;       // camelCase\n147: const max_retries = 3;      // snake_case (reserved for variables)\n148: ```\n149: \n150: **Evidence**: `.skilled/skills/system-spec-kit/runtime/core/config.ts`\n151: \n152: ### Class Names\n153: \n154: **Style**: `PascalCase`\n155: \n156: ```javascript\n157: // CORRECT\n158: class SpecFolderError extends Error { }\n159: class ConfigLoader { }\n160: class TriggerIndex { }\n161: \n162: // INCORRECT\n163: class specFolderError { }   // camelCase\n164: class spec_folder_error { } // snake_case\n165: ```\n166: \n167: **Evidence**: `.skilled/skills/system-spec-kit/runtime/lib/config/spec-doc-paths.ts`\n168: \n169: ### Variable Names\n170: \n171: | Scope        | Style        | Example                          |\n172: |--------------|--------------|----------------------------------|\n173: | Local        | `camelCase`  | `const searchResults = []`       |\n174: | Module-level | `camelCase`  | `const dbPath = '...'`           |\n175: | Parameters   | `camelCase`  | `function search(query, maxResults)` |\n176: \n177: ### Boolean Names\n178: \n179: **Style**: `camelCase` with `is`/`has`/`can`/`should` prefix\n180: \n181: ```javascript\n182: // CORRECT\n183: const isValid = true;\n184: const hasResults = items.length > 0;\n185: const canProceed = !isBlocked;\n186: const shouldRetry = attempts < MAX_RETRIES;\n187: \n188: // INCORRECT\n189: const is_valid = true;       // snake_case\n190: const valid = true;          // ambiguous\n191: ```\n192: \n193: ### Naming Summary Table\n194: \n195: | Element          | Convention         | Example                |\n196: |------------------|--------------------|------------------------|\n197: | Functions        | `camelCase`        | `loadConfig`           |\n198: | Constants        | `UPPER_SNAKE_CASE` | `MAX_RETRIES`          |\n199: | Classes          | `PascalCase`       | `MemoryError`          |\n200: | Local variables  | `camelCase`        | `searchResults`        |\n201: | Module variables | `camelCase`        | `dbConnection`         |\n202: | Parameters       | `camelCase`        | `queryText`            |\n203: | Booleans         | `is`/`has`/`can`   | `isValid`, `hasItems`  |\n204: \n205: ---\n206: \n207: ## 6. FORMATTING RULES\n208: \n209: ### Indentation\n210: \n211: - **Size**: 2 spaces\n212: - **Tabs**: Never use tabs\n213: \n214: ```javascript\n215: // CORRECT (2 spaces)\n216: function example() {\n217:   if (condition) {\n218:     return value;\n219:   }\n220: }\n221: \n222: // INCORRECT (4 spaces or tabs)\n223: function example() {\n224:     if (condition) {\n225:         return value;\n226:     }\n227: }\n228: ```\n229: \n230: ### Braces\n231: \n232: **Style**: K&R (opening brace on same line)\n233: \n234: ```javascript\n235: // CORRECT (K&R style)\n236: if (condition) {\n237:   // code\n238: } else {\n239:   // code\n240: }\n241: \n242: function example() {\n243:   // code\n244: }\n245: \n246: // INCORRECT (Allman style)\n247: if (condition)\n248: {\n249:   // code\n250: }\n251: ```\n252: \n253: ### Semicolons\n254: \n255: **Rule**: Always use semicolons\n256: \n257: ```javascript\n258: // CORRECT\n259: const value = 42;\n260: return result;\n261: \n262: // INCORRECT (ASI-dependent)\n263: const value = 42\n264: return result\n265: ```\n266: \n267: ### Quotes\n268: \n269: **Rule**: Single quotes for strings\n270: \n271: ```javascript\n272: // CORRECT\n273: const message = 'Hello world';\n274: const template = `Value: ${value}`;  // Template literals OK\n275: \n276: // INCORRECT\n277: const message = \"Hello world\";  // Double quotes\n278: ```\n279: \n280: ### Line Length\n281: \n282: - **Soft limit**: roughly 100 to 120 characters, per the shared formatting rule\n283: - **Preferred**: 80 characters\n284: - **Exception**: URLs and long strings\n285: \n286: ---\n287: \n288: ## 7. COMMENTING RULES\n289: \n290: ### Principles\n291: \n292: 1. **Quantity limit (Skilled surface setting):** Maximum 3 comments per 10 lines of code, this surface's budget for the shared comment-density rule (see [naming and commenting](../shared/universal-patterns/naming-and-commenting.md))\n293: 2. **Focus on purposeful semantics:** Explain WHY something is done, not WHAT it does\n294: 3. **Focus on WHY, not WHAT:** Explain intent, constraints, reasoning\n295: 4. **No commented-out code:** Delete unused code (git preserves history)\n296: \n297: ### Comment Examples\n298: \n299: Use plain comments that explain reasoning:\n300: \n301: - `// Reasoning for non-obvious choice`\n302: - `// Precondition/invariant check`\n303: - `// State that must always hold`\n304: - `// SEC: security note tied to a stable standard (CWE-###)`\n305: - `// Safety, performance, or reliability constraint`\n306: \n307: ### Capitalization\n308: \n309: All comment text MUST start with a capital letter:\n310: \n311: ```javascript\n312: // Reverse order preserves dependency chain     // correct\n313: // reverse order preserves dependency chain     // wrong\n314: ```\n315: \n316: **Exceptions**: `eslint-disable` directives, `@ts-` annotations, and inline code references.\n317: \n318: ### Reference Comments\n319: \n320: Use a bracketed module prefix for inline comments:\n321: \n322: ```javascript\n323: // [module-name] Description of what this does\n324: ```\n325: \n326: Cite only durable references, never a spec-folder-internal id. Comments must not embed a spec folder/number, task/checklist/requirement id (`T###`, `CHK-###`, `REQ-###`), feature-catalog entry, ADR id, or ticket id; see [`../shared/universal-patterns/naming-and-commenting.md`](../shared/universal-patterns/naming-and-commenting.md) §4 and [`../../../sk-code-quality/references/code-style-guide.md`](../../../sk-code-quality/references/code-style-guide.md) §4 \"No ephemeral-artifact pointers\".\n327: \n328: ```javascript\n329: // GOOD — durable WHY, no ephemeral id\n330: // Causal Memory Graph handlers: drift-why, causal-link, causal-stats, causal-unlink\n331: // Recover pending writes on startup so a crash cannot lose data\n332: // SEC: sanitize input to prevent stored XSS (CWE-79)\n333: ```\n334: \n335: ### Function Purpose Comments\n336: \n337: Single line above function describing intent:\n338: \n339: ```javascript\n340: // Load configuration from YAML file, merging with defaults\n341: // Returns validated config object or throws on invalid schema\n342: function loadConfig(configPath) { }\n343: \n344: // Calculate weighted memory score using decay function\n345: // Higher scores indicate more recent and relevant memories\n346: function calculateMemoryScore(memory, currentTime) { }\n347: ```\n348: \n349: ### Inline Comments (WHY, Not WHAT)\n350: \n351: **Good examples (explain reasoning):**\n352: \n353: ```javascript\n354: // Skip if already initialized to prevent double-binding\n355: if (window[INIT_FLAG]) return;\n356: \n357: // Sort by recency so newest memories surface first\n358: results.sort((a, b) => b.timestamp - a.timestamp);\n359: \n360: // Add timeout to prevent hang on unresponsive database\n361: const timeout = new Promise((_, reject) =>\n362:   setTimeout(() => reject(new Error('Timeout')), 30000)\n363: );\n364: \n365: // Close DB connection on all control paths\n366: try {\n367:   await processBatch(items);\n368: } finally {\n369:   db.close();\n370: }\n371: ```\n372: \n373: **Bad examples (narrate implementation):**\n374: \n375: ```javascript\n376: // Set the value to 42\n377: const value = 42;\n378: \n379: // Loop through items\n380: for (const item of items) { }\n381: \n382: // Check if result exists\n383: if (result) { }\n384: \n385: // Add item to array\n386: items.push(item);\n387: ```\n388: \n389: ### Debug Logging Pattern\n390: \n391: ```javascript\n392: // Conditional logging for debug mode\n393: const DEBUG = false;\n394: const LOG_PREFIX = '[ModuleName]';\n395: \n396: function log(...args) {\n397:   if (DEBUG) {\n398:     console.log(LOG_PREFIX, ...args);\n399:   }\n400: }\n401: \n402: // Usage\n403: log('Initialized with config:', config);\n404: log('Processing batch:', batch.length, 'items');\n405: ```\n406: \n407: ### JSDoc Comments\n408: \n409: Required for all exported functions. See `quality-standards.md` for full JSDoc format.\n410: \n411: ```javascript\n412: /**\n413:  * Brief description of function purpose.\n414:  *\n415:  * @param {string} query - Search query text\n416:  * @param {Object} options - Search options\n417:  * @param {number} options.limit - Maximum results to return\n418:  * @returns {Array} Array of search results\n419:  */\n420: function search(query, options = {}) {\n421:   // implementation\n422: }\n423: ```\n424: \n425: ### TODO Comments\n426: \n427: Format for tracking incomplete work.\n428: \n429: ```javascript\n430: // TODO: [description of work needed]\n431: // FIXME: [description of bug to fix]\n432: ```\n433: \n434: ---\n435: \n436: ## 8. IMPORT ORDER\n437: \n438: Organize imports in three groups with blank lines between.\n439: \n440: ```javascript\n441: 'use strict';\n442: \n443: // ─────────────────────────────────────────────────────────────────────────────\n444: // 1. IMPORTS\n445: // ─────────────────────────────────────────────────────────────────────────────\n446: \n447: // Node.js built-ins\n448: const fs = require('fs');\n449: const path = require('path');\n450: \n451: // Third-party modules\n452: const yaml = require('js-yaml');\n453: const sqlite = require('better-sqlite3');\n454: \n455: // Local modules\n456: const { loadConfig } = require('./config');\n457: const logger = require('../utils/logger');\n458: ```\n459: \n460: **Evidence**: `mcp-server/lib/search/folder-discovery.ts:1-26`\n461: \n462: ---\n463: \n464: ## 9. RELATED RESOURCES\n465: \n466: - [quality-standards.md](quality-standards/overview-modules-and-docs.md) - Error handling, JSDoc, security patterns\n467: - [quick-reference.md](./quick-reference.md) - Copy-paste templates and cheat sheets","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md, lines 1-467\n1: ---\n2: title: JavaScript Style Guide\n3: description: Formatting standards and naming conventions for JavaScript files in the OpenCode development environment.\n4: trigger_phrases:\n5:   - \"opencode javascript style guide\"\n6:   - \"javascript file header format\"\n7:   - \"use strict directive\"\n8:   - \"javascript section organization\"\n9: importance_tier: normal\n10: contextType: implementation\n11: version: 1.0.4.0\n12: ---\n13: \n14: # JavaScript Style Guide\n15: \n16: Open this when you are drafting or reviewing a JavaScript file and need the header, section order, naming rule or formatting detail that settles the point.\n17: \n18: ---\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Defines consistent styling rules for JavaScript files to ensure readability, maintainability, and alignment across all OpenCode JavaScript code.\n25: \n26: ### When to Use\n27: \n28: Use when writing, reviewing, or resolving style questions for JavaScript files.\n29: \n30: ### Use Cases\n31: \n32: - Writing new JavaScript files\n33: - Reviewing JavaScript code for consistency\n34: - Resolving style disagreements in code review\n35: \n36: ---\n37: \n38: ## 2. FILE HEADER FORMAT\n39: \n40: All JavaScript files MUST begin with a module header identifying the module,\n41: using the divider form below. Module syntax follows the nearest package\n42: boundary and loader contract: `.cjs` is CommonJS, `.mjs` is ESM, and `.js`\n43: follows the nearest package's `type`. OpenCode plugin paths use their ESM\n44: loader contract.\n45: \n46: ### Template\n47: \n48: ```javascript\n49: // ───────────────────────────────────────────────────────────────────\n50: // MODULE: [Module Name]\n51: // ───────────────────────────────────────────────────────────────────\n52: ```\n53: \n54: ### Requirements\n55: \n56: - Divider width: 67 box-drawing characters after `// `\n57: - Module name: after `MODULE:` on the middle line\n58: - A shebang line may precede the header in an executable script\n59: - Immediately followed by `'use strict';` for `.js/.cjs` files, as required by\n60:   this repository's alignment checks; it is redundant in ESM `.js` files\n61: - `.mjs` files do not require `'use strict'`; ESM `.js` plugin files follow the\n62:   `.js` requirement above\n63: - The older 78-character `╔═╗` box is accepted where it already exists; do not\n64:   introduce it in new files\n65: \n66: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/lib/dist-freshness.cjs:1-4`,\n67: `.skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs:1-4`\n68: \n69: ---\n70: \n71: ## 3. USE STRICT DIRECTIVE\n72: \n73: Every `.js` and `.cjs` JavaScript file MUST include the strict mode directive.\n74: This repository convention also applies to ESM `.js` files, where it is\n75: redundant because modules are strict by definition. Do not add it to `.mjs`\n76: files; the alignment verifier intentionally skips `.mjs` enforcement.\n77: \n78: ```javascript\n79: 'use strict';\n80: ```\n81: \n82: **Placement**: Immediately after file header, before any other code.\n83: \n84: **Evidence**: `verify_alignment_drift.py` skips `.mjs`; CommonJS-style JS\n85: helpers still use `'use strict'`.\n86: \n87: ---\n88: \n89: ## 4. SECTION ORGANIZATION\n90: \n91: Large files are organized using numbered section dividers.\n92: \n93: ### Section Divider Template\n94: \n95: ```javascript\n96: // ─────────────────────────────────────────────────────────────────────────────\n97: // 1. [SECTION NAME]\n98: // ─────────────────────────────────────────────────────────────────────────────\n99: ```\n100: \n101: ### Standard Section Order\n102: \n103: | Order | Section Name     | Purpose                           |\n104: |-------|------------------|-----------------------------------|\n105: | 1     | IMPORTS          | Module dependencies               |\n106: | 2     | CONSTANTS        | Configuration values, magic numbers |\n107: | 3     | HELPERS          | Internal utility functions        |\n108: | 4     | CORE LOGIC       | Main implementation               |\n109: | 5     | EXPORTS          | Module public interface           |\n110: \n111: **Evidence**: `.skilled/skills/system-spec-kit/runtime/cli/core/config.ts`\n112: \n113: ---\n114: \n115: ## 5. NAMING CONVENTIONS\n116: \n117: ### Function Names\n118: \n119: **Style**: `camelCase`\n120: \n121: ```javascript\n122: // CORRECT\n123: function loadConfig(path) { }\n124: function memorySearch(query, options) { }\n125: function validateInput(data) { }\n126: \n127: // INCORRECT\n128: function load_config(path) { }     // snake_case\n129: function LoadConfig(path) { }      // PascalCase\n130: function load-config(path) { }     // kebab-case (invalid syntax)\n131: ```\n132: \n133: **Evidence**: MDN Web Docs, Airbnb Style Guide, Node.js core APIs\n134: \n135: ### Constant Names\n136: \n137: **Style**: `UPPER_SNAKE_CASE`\n138: \n139: ```javascript\n140: // CORRECT\n141: const MAX_RETRIES = 3;\n142: const DEFAULT_TIMEOUT = 5000;\n143: const SQLITE_BUSY_TIMEOUT = 30000;\n144: \n145: // INCORRECT\n146: const maxRetries = 3;       // camelCase\n147: const max_retries = 3;      // snake_case (reserved for variables)\n148: ```\n149: \n150: **Evidence**: `.skilled/skills/system-spec-kit/runtime/core/config.ts`\n151: \n152: ### Class Names\n153: \n154: **Style**: `PascalCase`\n155: \n156: ```javascript\n157: // CORRECT\n158: class SpecFolderError extends Error { }\n159: class ConfigLoader { }\n160: class TriggerIndex { }\n161: \n162: // INCORRECT\n163: class specFolderError { }   // camelCase\n164: class spec_folder_error { } // snake_case\n165: ```\n166: \n167: **Evidence**: `.skilled/skills/system-spec-kit/runtime/lib/config/spec-doc-paths.ts`\n168: \n169: ### Variable Names\n170: \n171: | Scope        | Style        | Example                          |\n172: |--------------|--------------|----------------------------------|\n173: | Local        | `camelCase`  | `const searchResults = []`       |\n174: | Module-level | `camelCase`  | `const dbPath = '...'`           |\n175: | Parameters   | `camelCase`  | `function search(query, maxResults)` |\n176: \n177: ### Boolean Names\n178: \n179: **Style**: `camelCase` with `is`/`has`/`can`/`should` prefix\n180: \n181: ```javascript\n182: // CORRECT\n183: const isValid = true;\n184: const hasResults = items.length > 0;\n185: const canProceed = !isBlocked;\n186: const shouldRetry = attempts < MAX_RETRIES;\n187: \n188: // INCORRECT\n189: const is_valid = true;       // snake_case\n190: const valid = true;          // ambiguous\n191: ```\n192: \n193: ### Naming Summary Table\n194: \n195: | Element          | Convention         | Example                |\n196: |------------------|--------------------|------------------------|\n197: | Functions        | `camelCase`        | `loadConfig`           |\n198: | Constants        | `UPPER_SNAKE_CASE` | `MAX_RETRIES`          |\n199: | Classes          | `PascalCase`       | `MemoryError`          |\n200: | Local variables  | `camelCase`        | `searchResults`        |\n201: | Module variables | `camelCase`        | `dbConnection`         |\n202: | Parameters       | `camelCase`        | `queryText`            |\n203: | Booleans         | `is`/`has`/`can`   | `isValid`, `hasItems`  |\n204: \n205: ---\n206: \n207: ## 6. FORMATTING RULES\n208: \n209: ### Indentation\n210: \n211: - **Size**: 2 spaces\n212: - **Tabs**: Never use tabs\n213: \n214: ```javascript\n215: // CORRECT (2 spaces)\n216: function example() {\n217:   if (condition) {\n218:     return value;\n219:   }\n220: }\n221: \n222: // INCORRECT (4 spaces or tabs)\n223: function example() {\n224:     if (condition) {\n225:         return value;\n226:     }\n227: }\n228: ```\n229: \n230: ### Braces\n231: \n232: **Style**: K&R (opening brace on same line)\n233: \n234: ```javascript\n235: // CORRECT (K&R style)\n236: if (condition) {\n237:   // code\n238: } else {\n239:   // code\n240: }\n241: \n242: function example() {\n243:   // code\n244: }\n245: \n246: // INCORRECT (Allman style)\n247: if (condition)\n248: {\n249:   // code\n250: }\n251: ```\n252: \n253: ### Semicolons\n254: \n255: **Rule**: Always use semicolons\n256: \n257: ```javascript\n258: // CORRECT\n259: const value = 42;\n260: return result;\n261: \n262: // INCORRECT (ASI-dependent)\n263: const value = 42\n264: return result\n265: ```\n266: \n267: ### Quotes\n268: \n269: **Rule**: Single quotes for strings\n270: \n271: ```javascript\n272: // CORRECT\n273: const message = 'Hello world';\n274: const template = `Value: ${value}`;  // Template literals OK\n275: \n276: // INCORRECT\n277: const message = \"Hello world\";  // Double quotes\n278: ```\n279: \n280: ### Line Length\n281: \n282: - **Soft limit**: roughly 100 to 120 characters, per the shared formatting rule\n283: - **Preferred**: 80 characters\n284: - **Exception**: URLs and long strings\n285: \n286: ---\n287: \n288: ## 7. COMMENTING RULES\n289: \n290: ### Principles\n291: \n292: 1. **Quantity limit (Skilled surface setting):** Maximum 3 comments per 10 lines of code, this surface's budget for the shared comment-density rule (see [naming and commenting](../shared/universal-patterns/naming-and-commenting.md))\n293: 2. **Focus on purposeful semantics:** Explain WHY something is done, not WHAT it does\n294: 3. **Focus on WHY, not WHAT:** Explain intent, constraints, reasoning\n295: 4. **No commented-out code:** Delete unused code (git preserves history)\n296: \n297: ### Comment Examples\n298: \n299: Use plain comments that explain reasoning:\n300: \n301: - `// Reasoning for non-obvious choice`\n302: - `// Precondition/invariant check`\n303: - `// State that must always hold`\n304: - `// SEC: security note tied to a stable standard (CWE-###)`\n305: - `// Safety, performance, or reliability constraint`\n306: \n307: ### Capitalization\n308: \n309: All comment text MUST start with a capital letter:\n310: \n311: ```javascript\n312: // Reverse order preserves dependency chain     // correct\n313: // reverse order preserves dependency chain     // wrong\n314: ```\n315: \n316: **Exceptions**: `eslint-disable` directives, `@ts-` annotations, and inline code references.\n317: \n318: ### Reference Comments\n319: \n320: Use a bracketed module prefix for inline comments:\n321: \n322: ```javascript\n323: // [module-name] Description of what this does\n324: ```\n325: \n326: Cite only durable references, never a spec-folder-internal id. Comments must not embed a spec folder/number, task/checklist/requirement id (`T###`, `CHK-###`, `REQ-###`), feature-catalog entry, ADR id, or ticket id; see [`../shared/universal-patterns/naming-and-commenting.md`](../shared/universal-patterns/naming-and-commenting.md) §4 and [`../../../sk-code-quality/references/code-style-guide.md`](../../../sk-code-quality/references/code-style-guide.md) §4 \"No ephemeral-artifact pointers\".\n327: \n328: ```javascript\n329: // GOOD — durable WHY, no ephemeral id\n330: // Causal Memory Graph handlers: drift-why, causal-link, causal-stats, causal-unlink\n331: // Recover pending writes on startup so a crash cannot lose data\n332: // SEC: sanitize input to prevent stored XSS (CWE-79)\n333: ```\n334: \n335: ### Function Purpose Comments\n336: \n337: Single line above function describing intent:\n338: \n339: ```javascript\n340: // Load configuration from YAML file, merging with defaults\n341: // Returns validated config object or throws on invalid schema\n342: function loadConfig(configPath) { }\n343: \n344: // Calculate weighted memory score using decay function\n345: // Higher scores indicate more recent and relevant memories\n346: function calculateMemoryScore(memory, currentTime) { }\n347: ```\n348: \n349: ### Inline Comments (WHY, Not WHAT)\n350: \n351: **Good examples (explain reasoning):**\n352: \n353: ```javascript\n354: // Skip if already initialized to prevent double-binding\n355: if (window[INIT_FLAG]) return;\n356: \n357: // Sort by recency so newest memories surface first\n358: results.sort((a, b) => b.timestamp - a.timestamp);\n359: \n360: // Add timeout to prevent hang on unresponsive database\n361: const timeout = new Promise((_, reject) =>\n362:   setTimeout(() => reject(new Error('Timeout')), 30000)\n363: );\n364: \n365: // Close DB connection on all control paths\n366: try {\n367:   await processBatch(items);\n368: } finally {\n369:   db.close();\n370: }\n371: ```\n372: \n373: **Bad examples (narrate implementation):**\n374: \n375: ```javascript\n376: // Set the value to 42\n377: const value = 42;\n378: \n379: // Loop through items\n380: for (const item of items) { }\n381: \n382: // Check if result exists\n383: if (result) { }\n384: \n385: // Add item to array\n386: items.push(item);\n387: ```\n388: \n389: ### Debug Logging Pattern\n390: \n391: ```javascript\n392: // Conditional logging for debug mode\n393: const DEBUG = false;\n394: const LOG_PREFIX = '[ModuleName]';\n395: \n396: function log(...args) {\n397:   if (DEBUG) {\n398:     console.log(LOG_PREFIX, ...args);\n399:   }\n400: }\n401: \n402: // Usage\n403: log('Initialized with config:', config);\n404: log('Processing batch:', batch.length, 'items');\n405: ```\n406: \n407: ### JSDoc Comments\n408: \n409: Required for all exported functions. See `quality-standards.md` for full JSDoc format.\n410: \n411: ```javascript\n412: /**\n413:  * Brief description of function purpose.\n414:  *\n415:  * @param {string} query - Search query text\n416:  * @param {Object} options - Search options\n417:  * @param {number} options.limit - Maximum results to return\n418:  * @returns {Array} Array of search results\n419:  */\n420: function search(query, options = {}) {\n421:   // implementation\n422: }\n423: ```\n424: \n425: ### TODO Comments\n426: \n427: Format for tracking incomplete work.\n428: \n429: ```javascript\n430: // TODO: [description of work needed]\n431: // FIXME: [description of bug to fix]\n432: ```\n433: \n434: ---\n435: \n436: ## 8. IMPORT ORDER\n437: \n438: Organize imports in three groups with blank lines between.\n439: \n440: ```javascript\n441: 'use strict';\n442: \n443: // ─────────────────────────────────────────────────────────────────────────────\n444: // 1. IMPORTS\n445: // ─────────────────────────────────────────────────────────────────────────────\n446: \n447: // Node.js built-ins\n448: const fs = require('fs');\n449: const path = require('path');\n450: \n451: // Third-party modules\n452: const yaml = require('js-yaml');\n453: const sqlite = require('better-sqlite3');\n454: \n455: // Local modules\n456: const { loadConfig } = require('./config');\n457: const logger = require('../utils/logger');\n458: ```\n459: \n460: **Evidence**: `mcp-server/lib/search/folder-discovery.ts:1-26`\n461: \n462: ---\n463: \n464: ## 9. RELATED RESOURCES\n465: \n466: - [quality-standards.md](quality-standards/overview-modules-and-docs.md) - Error handling, JSDoc, security patterns\n467: - [quick-reference.md](./quick-reference.md) - Copy-paste templates and cheat sheets"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/sk-code-skilled/references/javascript/style-guide.md\"}"},"time":{"start":1794565777080,"end":1794565777498}}}}
