ect.keys(baseline.rows), ...Object.keys(live.rows)]),\n99:     ].filter((id) => !holdoutIds.has(id));\n100:     const drifted: string[] = [];\n101:     for (const id of ids) {\n102:       const baselineJson = rowJson(baseline.rows, id);\n103:       const liveJson = rowJson(live.rows, id);\n104:       if (baselineJson !== liveJson) drifted.push(`${id}: baseline ${baselineJson} live ${liveJson}`);\n105:     }\n106:     expect(\n107:       drifted,\n108:       `command routing rows drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n109:     ).toEqual([]);\n110:   });\n111: \n112:   it('publishes no holdout row', () => {\n113:     // The split exists to keep a holdout prompt's outcome unseen, so the\n114:     // published maps may carry its counts but never the row they were counted\n115:     // from.\n116:     const holdoutIds = new Set(corpus.filter((row) => row.split === 'holdout').map((row) => row.id));\n117:     // An empty set would make the check pass on a corpus that no longer marks\n118:     // its holdout rows.\n119:     expect(\n120:       holdoutIds.size,\n121:       'the corpus marks no holdout row, so this check would pass without testing anything',\n122:     ).toBeGreaterThan(0);\n123:     const attached = baseline.attachedMetrics as {\n124:       readonly attachedRows: Readonly<Record<string, string>>;\n125:       readonly typedRows: Readonly<Record<string, unknown>>;\n126:     };\n127:     const published = [\n128:       ...new Set(\n129:         [\n130:           ...Object.keys(baseline.rows),\n131:           ...Object.keys(attached.attachedRows),\n132:           ...Object.keys(attached.typedRows),\n133:         ].filter((id) => holdoutIds.has(id)),\n134:       ),\n135:     ];\n136:     expect(published, `the baseline publishes a per-row outcome for ${published.length} holdout ids`).toEqual([]);\n137:   });\n138: \n139:   it('matches the captured totals', () => {\n140:     expect(live.metrics).toEqual