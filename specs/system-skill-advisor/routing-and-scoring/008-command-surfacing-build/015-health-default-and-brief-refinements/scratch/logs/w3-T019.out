part.\n101:   readonly degraded?: boolean;\n102: }\n103: \n104: export interface AdvisorHookResult {\n105:   readonly status: AdvisorHookStatus;\n106:   readonly freshness: AdvisorHookFreshness;\n107:   readonly brief: string | null;\n108:   readonly recommendations: AdvisorRecommendation[];\n109:   readonly diagnostics: AdvisorHookDiagnostics | null;\n110:   readonly metrics: AdvisorHookMetrics;\n111:   readonly generatedAt: string;\n112:   readonly sharedPayload: SharedPayloadEnvelope | null;\n113: }\n114: \n115: interface CachedAdvisorHookResult extends AdvisorHookResult {\n116:   readonly status: 'ok';\n117:   readonly brief: string;\n118: }\n119: \n120: // ───────────────────────────────────────────────────────────────────\n121: // 3. CONSTANTS\n122: // ───────────────────────────────────────────────────────────────────\n123: const DEFAULT_TOKEN_CAP = 80;\n124: const HARD_TOKEN_CAP = 120;\n125: export const DEFAULT_ADVISOR_CONFIDENCE_THRESHOLD = resolvedConfidenceThreshold();\n126: export const DEFAULT_ADVISOR_UNCERTAINTY_THRESHOLD = resolvedUncertaintyThreshold();\n127: const DEFAULT_METRICS: AdvisorHookMetrics = {\n128:   durationMs: 0,\n129:   cacheHit: false,\n[Output truncated. Continue reading with offset: 130]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/skill-advisor-brief.ts\",\"offset\":80,\"limit\":50}"},"time":{"start":1794565088623,"end":1794565089966}}}}
{"type":"tool_use","timestamp":1794565089975,"sessionID":"ses_e2b969922ffeL3dekY63kiSmGQ","part":{"partID":"prt_1d46a27dc0018yv4MUgIUSsJVG","sessionID":"ses_e2b969922ffeL3dekY63kiSmGQ","messageID":"msg_1d46a1b0b001w6vTL8jYup1CzT","type":"tool","id":"call_24311fe373f0456ba5050049","tool":"grep","state":{"status":"completed","input":{"pattern":"degraded|createAdvisorHookDiagnosticRecord|AdvisorHookDiagnosticRecordInput|readonly skillLabel","path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts"},"output":"Found 12 matches\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:\n  Line 24: export const ADVISOR_HOOK_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n\n  Line 59:   readonly skillLabel?: string;\n\n  Line 63:   readonly degraded?: boolean;\n\n  Line 92:   readonly skillLabel: string;\n\n  Line 380: export function createAdvisorHookDiagnosticRecord(input: {\n\n  Line 388:   readonly skillLabel?: string | null;\n\n  Line 392:   readonly degraded?: boolean;\n\n  Line 410:     ...(input.degraded === true ? { degraded: true } : {}),\n\n  Line 438:     && (record.degraded === undefined || typeof record.degraded === 'boolean');\n\n  Line 482:   const degraded = lastInvocations.filter((record) => record.degraded === true).length;\n\n  Line 492:     rollingDegradedRate: lastInvocations.length > 0 ? degraded / lastInvocations.length : 0,\n\n  Line 513:   readonly skillLabel: string;\n","title":"grep","metadata":{"metadata":{"matches":12,"truncated":false},"content":[{"type":"text","text":"Found 12 matches\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts:\n  Line 24: export const ADVISOR_HOOK_STATUS_VALUES = ['ok', 'skipped', 'stale', 'degraded', 'fail_open'] as const;\n\n  Line 59:   readonly skillLabel?: string;\n\n  Line 63:   readonly degraded?: boolean;\n\n  Line 92:   readonly skillLabel: string;\n\n  Line 380: export function createAdvisorHookDiagnosticRecord(input: {\n\n  Line 388:   readonly skillLabel?: string | null;\n\n  Line 392:   readonly degraded?: boolean;\n\n  Line 410:     ...(input.degraded === true ? { degraded: true } : {}),\n\n  Line 438:     && (record.degraded === undefined || typeof record.degraded === 'boolean');\n\n  Line 482:   const degraded = lastInvocations.filter((record) => record.degraded === true).length;\n\n  Line 492:     rollingDegradedRate: lastInvocations.length > 0 ? degraded / lastInvocations.length : 0,\n\n  Line 513:   readonly skillLabel: string;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"pattern\":\"degraded|createAdvisorHookDiagnosticRecord|AdvisorHookDiagnosticRecordInput|readonly skillLabel\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\"}"},"time":{"start":1794565089244,"end":1794565089975}}}}
