{"type":"tool_use","timestamp":1794564306164,"sessionID":"ses_e2ba44b7cffeY7DCkwAjaaon0M","part":{"partID":"prt_1d45e332e001B64eqs01tiQd2Q","sessionID":"ses_e2ba44b7cffeY7DCkwAjaaon0M","messageID":"msg_1d45e12910019xxWIuvl6JKU5d","type":"tool","id":"call_107f1687714f4a859c3ef57a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs","limit":130},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs, lines 1-130\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: system-skill-advisor Regression Tests                            ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Exercise cache freshness, bounded subprocess behavior,          ║\n5: // ║          lifecycle races, and cross-runtime directive parity.            ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: const assert = require('node:assert/strict');\n10: const { EventEmitter } = require('node:events');\n11: const fs = require('node:fs');\n12: const { register, registerHooks } = require('node:module');\n13: const os = require('node:os');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { pathToFileURL } = require('node:url');\n17: \n18: const WORKSPACE_ROOT = path.resolve(__dirname, '..', '..', '..');\n19: const PLUGIN_PATH = path.join(WORKSPACE_ROOT, '.opencode', 'plugins', 'system-skill-advisor.js');\n20: const MESSAGE_IDENTITY_PATH = path.join(\n21:   WORKSPACE_ROOT,\n22:   '.opencode',\n23:   'plugins',\n24:   'lib',\n25:   'opencode-message-identity.js',\n26: );\n27: const RENDER_HELPERS_PATH = path.join(\n28:   WORKSPACE_ROOT,\n29:   '.opencode',\n30:   'plugins',\n31:   'lib',\n32:   'skill-advisor-render.js',\n33: );\n34: const RENDERER_PATH = path.join(\n35:   WORKSPACE_ROOT,\n36:   '.skilled',\n37:   'skills',\n38:   'system-skill-advisor',\n39:   'runtime',\n40:   'lib',\n41:   'render.ts',\n42: );\n43: const CLAUDE_HOOK_PATH = path.join(\n44:   WORKSPACE_ROOT,\n45:   '.skilled',\n46:   'skills',\n47:   'system-skill-advisor',\n48:   'hooks',\n49:   'claude',\n50:   'user-prompt-submit.ts',\n51: );\n52: const FALLBACK_DIRECTIVES_BLOCK = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n53: const NO_MATCH_FALLBACK_CONTEXT = `Advisor: no skill matched.${FALLBACK_DIRECTIVES_BLOCK}`;\n54: const SKIPPED_FALLBACK_CONTEXT = `Advisor: prompt skipped.${FALLBACK_DIRECTIVES_BLOCK}`;\n55: const OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT = 'Advisor: outage (fail_open); route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json \\'{\"prompt\":\"<request>\"}\\' --format json' + FALLBACK_DIRECTIVES_BLOCK;\n56: \n57: // A stub replaces one import specifier with inline module source. A stub that names a\n58: // parentURL replaces the specifier only for imports made by that one module.\n59: function findModuleStub(stubs, specifier, parentURL) {\n60:   return stubs.find((stub) => stub.specifier === specifier\n61:     && (stub.parentURL === null || stub.parentURL === parentURL)) ?? null;\n62: }\n63: \n64: // The suite needs the same import stubs on every Node the advisor supports. The\n65: // synchronous in-thread hooks of `module.registerHooks` exist only from Node 22.15\n66: // and 23.5, so older releases get the same resolve rule through `module.register`,\n67: // whose hooks run off the main thread and therefore receive the stubs as data. The\n68: // stub modules themselves still evaluate on the main thread, so a stub that writes\n69: // to `globalThis` reaches the test either way.\n70: function stubModuleResolution(entries) {\n71:   const stubs = entries.map(({ specifier, parentURL = null, source }) => ({\n72:     specifier,\n73:     parentURL,\n74:     url: `data:text/javascript,${encodeURIComponent(source)}`,\n75:   }));\n76:   if (typeof registerHooks === 'function') {\n77:     registerHooks({\n78:       resolve(specifier, context, nextResolve) {\n79:         const stub = findModuleStub(stubs, specifier, context.parentURL);\n80:         return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n81:       },\n82:     });\n83:     return;\n84:   }\n85:   const hooksSource = `\n86: const findModuleStub = ${findModuleStub.toString()};\n87: let stubs = [];\n88: export function initialize(data) { stubs = data; }\n89: export async function resolve(specifier, context, nextResolve) {\n90:   const stub = findModuleStub(stubs, specifier, context.parentURL);\n91:   return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n92: }\n93: `;\n94:   register(`data:text/javascript,${encodeURIComponent(hooksSource)}`, { data: stubs });\n95: }\n96: \n97: stubModuleResolution([\n98:   { specifier: './lib/tool-identity.js', source: 'export const tool = (definition) => definition;' },\n99:   { specifier: '@modelcontextprotocol/sdk/client/index.js', source: 'export class Client {}' },\n100:   { specifier: '@modelcontextprotocol/sdk/client/stdio.js', source: 'export class StdioClientTransport {}' },\n101: ]);\n102: \n103: let pluginModulePromise;\n104: \n105: function loadPlugin() {\n106:   pluginModulePromise ??= import(pathToFileURL(PLUGIN_PATH).href);\n107:   return pluginModulePromise;\n108: }\n109: \n110: let renderHelpersPromise;\n111: \n112: function loadRenderHelpers() {\n113:   renderHelpersPromise ??= import(pathToFileURL(RENDER_HELPERS_PATH).href);\n114:   return renderHelpersPromise;\n115: }\n116: \n117: function bridgeEnvelope(\n118:   brief = 'Advisor: live; use sk-code 0.91/0.23 pass.',\n119:   metadata = { freshness: 'live' },\n120: ) {\n121:   return JSON.stringify({\n122:     brief: brief || null,\n123:     status: brief ? 'ok' : 'skipped',\n124:     metadata,\n125:   });\n126: }\n127: \n128: const CLI_RECOMMENDATION = {\n129:   skillId: 'sk-code',\n130:   score: 0.26,\n[Output truncated. Continue reading with offset: 131]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs, lines 1-130\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: system-skill-advisor Regression Tests                            ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Exercise cache freshness, bounded subprocess behavior,          ║\n5: // ║          lifecycle races, and cross-runtime directive parity.            ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: const assert = require('node:assert/strict');\n10: const { EventEmitter } = require('node:events');\n11: const fs = require('node:fs');\n12: const { register, registerHooks } = require('node:module');\n13: const os = require('node:os');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { pathToFileURL } = require('node:url');\n17: \n18: const WORKSPACE_ROOT = path.resolve(__dirname, '..', '..', '..');\n19: const PLUGIN_PATH = path.join(WORKSPACE_ROOT, '.opencode', 'plugins', 'system-skill-advisor.js');\n20: const MESSAGE_IDENTITY_PATH = path.join(\n21:   WORKSPACE_ROOT,\n22:   '.opencode',\n23:   'plugins',\n24:   'lib',\n25:   'opencode-message-identity.js',\n26: );\n27: const RENDER_HELPERS_PATH = path.join(\n28:   WORKSPACE_ROOT,\n29:   '.opencode',\n30:   'plugins',\n31:   'lib',\n32:   'skill-advisor-render.js',\n33: );\n34: const RENDERER_PATH = path.join(\n35:   WORKSPACE_ROOT,\n36:   '.skilled',\n37:   'skills',\n38:   'system-skill-advisor',\n39:   'runtime',\n40:   'lib',\n41:   'render.ts',\n42: );\n43: const CLAUDE_HOOK_PATH = path.join(\n44:   WORKSPACE_ROOT,\n45:   '.skilled',\n46:   'skills',\n47:   'system-skill-advisor',\n48:   'hooks',\n49:   'claude',\n50:   'user-prompt-submit.ts',\n51: );\n52: const FALLBACK_DIRECTIVES_BLOCK = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n53: const NO_MATCH_FALLBACK_CONTEXT = `Advisor: no skill matched.${FALLBACK_DIRECTIVES_BLOCK}`;\n54: const SKIPPED_FALLBACK_CONTEXT = `Advisor: prompt skipped.${FALLBACK_DIRECTIVES_BLOCK}`;\n55: const OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT = 'Advisor: outage (fail_open); route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json \\'{\"prompt\":\"<request>\"}\\' --format json' + FALLBACK_DIRECTIVES_BLOCK;\n56: \n57: // A stub replaces one import specifier with inline module source. A stub that names a\n58: // parentURL replaces the specifier only for imports made by that one module.\n59: function findModuleStub(stubs, specifier, parentURL) {\n60:   return stubs.find((stub) => stub.specifier === specifier\n61:     && (stub.parentURL === null || stub.parentURL === parentURL)) ?? null;\n62: }\n63: \n64: // The suite needs the same import stubs on every Node the advisor supports. The\n65: // synchronous in-thread hooks of `module.registerHooks` exist only from Node 22.15\n66: // and 23.5, so older releases get the same resolve rule through `module.register`,\n67: // whose hooks run off the main thread and therefore receive the stubs as data. The\n68: // stub modules themselves still evaluate on the main thread, so a stub that writes\n69: // to `globalThis` reaches the test either way.\n70: function stubModuleResolution(entries) {\n71:   const stubs = entries.map(({ specifier, parentURL = null, source }) => ({\n72:     specifier,\n73:     parentURL,\n74:     url: `data:text/javascript,${encodeURIComponent(source)}`,\n75:   }));\n76:   if (typeof registerHooks === 'function') {\n77:     registerHooks({\n78:       resolve(specifier, context, nextResolve) {\n79:         const stub = findModuleStub(stubs, specifier, context.parentURL);\n80:         return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n81:       },\n82:     });\n83:     return;\n84:   }\n85:   const hooksSource = `\n86: const findModuleStub = ${findModuleStub.toString()};\n87: let stubs = [];\n88: export function initialize(data) { stubs = data; }\n89: export async function resolve(specifier, context, nextResolve) {\n90:   const stub = findModuleStub(stubs, specifier, context.parentURL);\n91:   return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n92: }\n93: `;\n94:   register(`data:text/javascript,${encodeURIComponent(hooksSource)}`, { data: stubs });\n95: }\n96: \n97: stubModuleResolution([\n98:   { specifier: './lib/tool-identity.js', source: 'export const tool = (definition) => definition;' },\n99:   { specifier: '@modelcontextprotocol/sdk/client/index.js', source: 'export class Client {}' },\n100:   { specifier: '@modelcontextprotocol/sdk/client/stdio.js', source: 'export class StdioClientTransport {}' },\n101: ]);\n102: \n103: let pluginModulePromise;\n104: \n105: function loadPlugin() {\n106:   pluginModulePromise ??= import(pathToFileURL(PLUGIN_PATH).href);\n107:   return pluginModulePromise;\n108: }\n109: \n110: let renderHelpersPromise;\n111: \n112: function loadRenderHelpers() {\n113:   renderHelpersPromise ??= import(pathToFileURL(RENDER_HELPERS_PATH).href);\n114:   return renderHelpersPromise;\n115: }\n116: \n117: function bridgeEnvelope(\n118:   brief = 'Advisor: live; use sk-code 0.91/0.23 pass.',\n119:   metadata = { freshness: 'live' },\n120: ) {\n121:   return JSON.stringify({\n122:     brief: brief || null,\n123:     status: brief ? 'ok' : 'skipped',\n124:     metadata,\n125:   });\n126: }\n127: \n128: const CLI_RECOMMENDATION = {\n129:   skillId: 'sk-code',\n130:   score: 0.26,\n[Output truncated. Continue reading with offset: 131]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs\",\"limit\":130}"},"time":{"start":1794564305710,"end":1794564306164}}}}
{"type":"tool_use","timestamp":1794564306264,"sessionID":"ses_e2ba44b7cffeY7DCkwAjaaon0M","part":{"partID":"prt_1d45e31a100107Fl3Lmq0A8iDw","sessionID":"ses_e2ba44b7cffeY7DCkwAjaaon0M","messageID":"msg_1d45e12910019xxWIuvl6JKU5d","type":"tool","id":"call_d1a6aaea88004e0bb8aed614","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md, lines 1-176\n1: ---\n2: name: sk-code\n3: description: \"Implement, debug and verify code: TypeScript, Python, shell, JSON; quality and review workflow modes with stack surface packets.\"\n4: allowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\n5: version: 3.11.6.0\n6: metadata:\n7:   family: sk-code\n8: ---\n9: \n10: <!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n11: \n12: # Code Family Hub (sk-code)\n13: \n14: One skill has two axes, one shared surface-detection router and one advisor identity.\n15: The **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\n16: The **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\n17: Each packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\n18: This hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n19: \n20: **Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n21: `description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n22: `ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\n23: The authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\n24: A packet version is independent of this one by design, so a gap between them is not drift.\n25: \n26: ---\n27: \n28: ## 1. WHEN TO USE\n29: \n30: Use this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n31: \n32: **Workflow axis** (modes that act, one of them chosen as primary):\n33: \n34: | Mode | Use it for | Packet |\n35: |------|------------|--------|\n36: | **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n37: | **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n38: \n39: **Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n40: \n41: | Surface | Carries | Packet |\n42: |---------|---------|--------|\n43: | **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n44: | **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n45: | **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n46: \n47: **Surface list.** The hub has exactly three surfaces:\n48: - SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n49: - CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n50: - Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n51: \n52: The hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\n53: Any other sk-code doc that counts surfaces points to this sentence.\n54: \n55: ### When NOT to Use\n56: - Documentation-only changes with no code-work contract - use `sk-doc`.\n57: - Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n58: - Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n59: - For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n60: - When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n61: - Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n62: \n63: ---\n64: \n65: ## 2. SMART ROUTING\n66: \n67: Routing is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\n68: Stage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\n69: Stage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\n70: Both files point back here instead of restating the split.\n71: \n72: The advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\n73: Compiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n74: \n75: A bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\n76: Run the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n77: \n78: ---\n79: \n80: ## 3. HOW IT WORKS\n81: \n82: ### Terms\n83: \n84: - **`workflowMode`**: the public mode or surface key a request resolves to.\n85: - **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n86: - **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n87: - **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n88: - **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n89: - **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n90: - **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n91: - **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n92: - **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n93: - **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n94: - **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n95: - **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n96: \n97: ### Layout\n98: ```\n99: sk-code/\n100:   SKILL.md               # this routing hub (no per-mode code logic)\n101:   README.md              # human-facing front page for the hub\n102:   ROUTER.md              # active stage-two surface router and shared-control declaration\n103:   mode-registry.json     # the two-axis discriminator + advisorRouting contract\n104:   hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n105:   description.json       # hub advisor descriptor\n106:   graph-metadata.json    # the ONE advisor identity for the whole skill\n107:   leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n108:   changelog/             # hub release notes, one v<version>.md per hub release\n109:   feature-catalog/       # current-state inventory of the hub's routing capabilities\n110:   manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n111:   benchmark/             # historical routing benchmark inputs and reports\n112:   sk-code-quality/       # quality mode packet     (workflow)\n113:   sk-code-review/        # review mode packet      (workflow)\n114:   sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n115:   sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n116:   sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n117:   shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n118: ```\n119: \n120: Each mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n121: \n122: ### Backend\n123: The `surface-router` backend is the shared surface-detection router under `shared/`.\n124: It centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\n125: It carries the shared implement → debug → verify workflow doctrine consumed by each surface.\n126: The `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\n127: The `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\n128: The packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\n129: Shared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\n130: It must never gain per-mode workflow contracts.\n131: \n132: The **implement → debug → verify** phases are not standalone modes.\n133: Their surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\n134: Those files are symlinked into each surface, so the active surface carries the full workflow.\n135: A request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\n136: The acting agent applies that doctrine.\n137: \n138: ### Maintenance\n139: \n140: After adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n141: \n142: ---\n143: \n144: ## 4. RULES\n145: \n146: ### ✅ ALWAYS\n147: - **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n148: - **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n149: - **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n150: - **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n151: - **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n152: - **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n153: - **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n154: \n155: ### ⛔ NEVER\n156: - **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n157: - **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n158: - **NEVER** hardcode a router mapping outside `mode-registry.json`.\n159: - **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n160: \n161: ### ⚠️ ESCALATE IF\n162: - A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n163: - Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n164: \n165: ---\n166: \n167: ## 5. REFERENCES\n168: \n169: - Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n170: - Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n171: - Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n172: - Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n173: - Hub router signals + surface bundling: `hub-router.json`.\n174: - Surface router and shared controls: `ROUTER.md`.\n175: - Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n176: - Sibling example: `.skilled/skills/sk-prompt/`.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md, lines 1-176\n1: ---\n2: name: sk-code\n3: description: \"Implement, debug and verify code: TypeScript, Python, shell, JSON; quality and review workflow modes with stack surface packets.\"\n4: allowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\n5: version: 3.11.6.0\n6: metadata:\n7:   family: sk-code\n8: ---\n9: \n10: <!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n11: \n12: # Code Family Hub (sk-code)\n13: \n14: One skill has two axes, one shared surface-detection router and one advisor identity.\n15: The **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\n16: The **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\n17: Each packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\n18: This hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n19: \n20: **Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n21: `description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n22: `ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\n23: The authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\n24: A packet version is independent of this one by design, so a gap between them is not drift.\n25: \n26: ---\n27: \n28: ## 1. WHEN TO USE\n29: \n30: Use this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n31: \n32: **Workflow axis** (modes that act, one of them chosen as primary):\n33: \n34: | Mode | Use it for | Packet |\n35: |------|------------|--------|\n36: | **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n37: | **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n38: \n39: **Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n40: \n41: | Surface | Carries | Packet |\n42: |---------|---------|--------|\n43: | **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n44: | **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n45: | **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n46: \n47: **Surface list.** The hub has exactly three surfaces:\n48: - SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n49: - CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n50: - Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n51: \n52: The hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\n53: Any other sk-code doc that counts surfaces points to this sentence.\n54: \n55: ### When NOT to Use\n56: - Documentation-only changes with no code-work contract - use `sk-doc`.\n57: - Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n58: - Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n59: - For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n60: - When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n61: - Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n62: \n63: ---\n64: \n65: ## 2. SMART ROUTING\n66: \n67: Routing is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\n68: Stage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\n69: Stage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\n70: Both files point back here instead of restating the split.\n71: \n72: The advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\n73: Compiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n74: \n75: A bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\n76: Run the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n77: \n78: ---\n79: \n80: ## 3. HOW IT WORKS\n81: \n82: ### Terms\n83: \n84: - **`workflowMode`**: the public mode or surface key a request resolves to.\n85: - **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n86: - **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n87: - **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n88: - **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n89: - **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n90: - **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n91: - **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n92: - **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n93: - **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n94: - **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n95: - **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n96: \n97: ### Layout\n98: ```\n99: sk-code/\n100:   SKILL.md               # this routing hub (no per-mode code logic)\n101:   README.md              # human-facing front page for the hub\n102:   ROUTER.md              # active stage-two surface router and shared-control declaration\n103:   mode-registry.json     # the two-axis discriminator + advisorRouting contract\n104:   hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n105:   description.json       # hub advisor descriptor\n106:   graph-metadata.json    # the ONE advisor identity for the whole skill\n107:   leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n108:   changelog/             # hub release notes, one v<version>.md per hub release\n109:   feature-catalog/       # current-state inventory of the hub's routing capabilities\n110:   manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n111:   benchmark/             # historical routing benchmark inputs and reports\n112:   sk-code-quality/       # quality mode packet     (workflow)\n113:   sk-code-review/        # review mode packet      (workflow)\n114:   sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n115:   sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n116:   sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n117:   shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n118: ```\n119: \n120: Each mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n121: \n122: ### Backend\n123: The `surface-router` backend is the shared surface-detection router under `shared/`.\n124: It centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\n125: It carries the shared implement → debug → verify workflow doctrine consumed by each surface.\n126: The `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\n127: The `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\n128: The packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\n129: Shared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\n130: It must never gain per-mode workflow contracts.\n131: \n132: The **implement → debug → verify** phases are not standalone modes.\n133: Their surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\n134: Those files are symlinked into each surface, so the active surface carries the full workflow.\n135: A request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\n136: The acting agent applies that doctrine.\n137: \n138: ### Maintenance\n139: \n140: After adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n141: \n142: ---\n143: \n144: ## 4. RULES\n145: \n146: ### ✅ ALWAYS\n147: - **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n148: - **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n149: - **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n150: - **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n151: - **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n152: - **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n153: - **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n154: \n155: ### ⛔ NEVER\n156: - **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n157: - **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n158: - **NEVER** hardcode a router mapping outside `mode-registry.json`.\n159: - **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n160: \n161: ### ⚠️ ESCALATE IF\n162: - A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n163: - Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n164: \n165: ---\n166: \n167: ## 5. REFERENCES\n168: \n169: - Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n170: - Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n171: - Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n172: - Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n173: - Hub router signals + surface bundling: `hub-router.json`.\n174: - Surface router and shared controls: `ROUTER.md`.\n175: - Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n176: - Sibling example: `.skilled/skills/sk-prompt/`."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md\"}"},"time":{"start":1794564305313,"end":1794564306264}}}}
