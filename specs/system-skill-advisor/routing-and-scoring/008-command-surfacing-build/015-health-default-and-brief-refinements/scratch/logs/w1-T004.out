{"type":"tool_use","timestamp":1794564254861,"sessionID":"ses_e2ba44b7cffeY7DCkwAjaaon0M","part":{"partID":"prt_1d45d6b2c001FXQk41Sbl5Uk2T","sessionID":"ses_e2ba44b7cffeY7DCkwAjaaon0M","messageID":"msg_1d45d0d91001jYv2TfSqIF5H2S","type":"tool","id":"chatcmpl-tool-9f827cfa07555d5e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js, lines 1-1209\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: Skill Advisor OpenCode Plugin (system-skill-advisor)              ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Inject skill advisor brief into OpenCode model context per      ║\n5: // ║          prompt; expose status tool; manage per-instance state,          ║\n6: // ║          in-flight dedup, and bounded prompt/brief/cache sizes.           ║\n7: // ╚══════════════════════════════════════════════════════════════════════════╝\n8: 'use strict';\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: import { createHash } from 'node:crypto';\n15: import { spawn } from 'node:child_process';\n16: import { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'node:fs';\n17: import { resolve as resolvePath } from 'node:path';\n18: import { readFile } from 'node:fs/promises';\n19: import { homedir } from 'node:os';\n20: import { dirname, join, sep } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: import { createRequire } from 'node:module';\n23: \n24: import { tool } from './lib/tool-identity.js';\n25: import { dualPlugin } from './lib/v2-bridge.js';\n26: \n27: import * as messageIdentity from './lib/opencode-message-identity.js';\n28: import {\n29:   FALLBACK_DIRECTIVE,\n30:   SETUP_WORDING,\n31:   renderCompiledRouteSummaryLine,\n32:   renderPluginFallbackDirective,\n33: } from './lib/skill-advisor-render.js';\n34: import { findRepoRoot, findSourceRoot } from '../skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const PLUGIN_ID = 'system-skill-advisor';\n41: const DEFAULT_CACHE_TTL_MS = 5 * 60 * 1000;\n42: const DEFAULT_THRESHOLD_CONFIDENCE = 0.8;\n43: // Mirrors the compat contract's uncertainty ceiling. The CLI request and the\n44: // brief render must carry the same bound, or a recommendation can pass one and\n45: // fail the other.\n46: const DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\n47: const DEFAULT_MAX_TOKENS = 80;\n48: const AMBIGUOUS_TOKEN_CAP = 120;\n49: const DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\n50: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n51: const DEFAULT_NODE_BINARY = 'node';\n52: const DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n53: // advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n54: // rather than refused and reported as an outage.\n55: const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n56: const DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\n57: const DEFAULT_MAX_CACHE_ENTRIES = 1000;\n58: const MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n59: // Unique prompts each need their own advisor child, so a burst must not multiply\n60: // live processes without limit.\n61: const MAX_CONCURRENT_ADVISOR_RUNS = 2;\n62: const BRIDGE_TERMINATION_GRACE_MS = 250;\n63: const COMPILED_ROUTE_BOUNDING_ENV = 'SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING';\n64: const DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\n65: const DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\n66: const LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\n67: const LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n68: \n69: // Directive-lifecycle dedup: this plugin is a plain-JS mirror of the canonical\n70: // rule in hooks/lib/directive-lifecycle.ts (same separator, same fail-open\n71: // semantics). Deliver the full brief on the first message of a session and\n72: // after every lifecycle boundary; on a same-content repeat keep the dynamic\n73: // Advisor: route line and drop the constant directive block. The canonical\n74: // copy stays in directive-lifecycle.ts; when that module gains a compiled\n75: // dist, prefer importing it over extending this mirror.\n76: const DIRECTIVE_LIFECYCLE_DEDUP_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP';\n77: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n78: const MAX_DIRECTIVE_DEDUP_SESSIONS = 64;\n79: const pluginRequire = createRequire(import.meta.url);\n80: const { isHookEnabled } = pluginRequire('../hooks/shared/hook-flags.cjs');\n81: \n82: // The compiled-routing helper resolves from whichever adapter root actually\n83: // carries it: .opencode/bin is a link that a copied tree may lack, so a single\n84: // relative ../bin probe would spawn a broken module pair in a half-migrated tree.\n85: function resolveCompiledRouteStatusModule() {\n86:   const here = dirname(fileURLToPath(import.meta.url));\n87:   for (const candidate of [\n88:     join(here, '..', 'bin', 'compiled-route-status.cjs'),\n89:     join(here, '..', '..', '.skilled', 'bin', 'compiled-route-status.cjs'),\n90:   ]) {\n91:     if (existsSync(candidate)) return candidate;\n92:   }\n93:   return join(here, '..', 'bin', 'compiled-route-status.cjs');\n94: }\n95: \n96: // Compact, prompt-safe per-hub compiled-routing serving summary. Reads the\n97: // promoted runtime status (file-only, no engine load, no subprocess) and fails\n98: // closed to a single 'unavailable' line so the status tool never throws.\n99: function compiledRoutingStatusLines() {\n100:   try {\n101:     const statusPath = resolveCompiledRouteStatusModule();\n102:     const { computeAllStatus } = pluginRequire(statusPath);\n103:     const rows = computeAllStatus({ probeEngine: false });\n104:     const served = rows.filter((r) => r.servingAuthority === 'compiled').length;\n105:     const broken = rows.filter((r) => r.causeCode === 'engine-throw').length;\n106:     const lines = [\n107:       `compiled_routing_hubs=${rows.length}`,\n108:       `compiled_serving=${served}`,\n109:       `compiled_broken=${broken}`,\n110:     ];\n111:     for (const r of rows) lines.push(`compiled_hub_${r.hubId}=${r.servingAuthority}/${r.causeCode}`);\n112:     return lines;\n113:   } catch (err) {\n114:     return [`compiled_routing=unavailable(${err && err.message ? err.message : 'error'})`];\n115:   }\n116: }\n117: \n118: // Stable fingerprint of the current per-hub serving state, consumed from the\n119: // promoted status probe (the single source of serving truth). A manifest flip or\n120: // a kill-switch changes a hub's servingAuthority/causeCode/manifestFingerprint\n121: // here, so folding this into the advisor-brief cache key guarantees a miss and a\n122: // stale compiled brief is never re-served. Fails closed to a stable sentinel so\n123: // the degraded case still caches deterministically.\n124: function compiledServingSignature() {\n125:   try {\n126:     const statusPath = resolveCompiledRouteStatusModule();\n127:     const { computeAllStatus } = pluginRequire(statusPath);\n128:     const rows = computeAllStatus({ probeEngine: false });\n129:     const canonical = rows\n130:       .map((r) => `${r.hubId}:${r.servingAuthority}:${r.causeCode}:${r.manifestFingerprint ?? ''}:${r.effectivePolicyHash ?? ''}`)\n131:       .join('|');\n132:     return createHash('sha256').update(canonical).digest('hex');\n133:   } catch {\n134:     return 'serving-unavailable';\n135:   }\n136: }\n137: \n138: const ADVISOR_CLI_PATH = fileURLToPath(new URL('../bin/skill-advisor.cjs', import.meta.url));\n139: // Cache-signature paths follow the standalone advisor package to ensure\n140: // consistent cache invalidation across CLI and daemon builds. The CLI entry\n141: // belongs in the signature because it is the plugin's only advisor entrypoint.\n142: const ADVISOR_SOURCE_PATHS = [\n143:   ADVISOR_CLI_PATH,\n144:   fileURLToPath(new URL('../bin/system-skill-advisor-launcher.cjs', import.meta.url)),\n145:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/advisor-server.ts', import.meta.url)),\n146:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/dist/runtime/advisor-server.js', import.meta.url)),\n147: ];\n148: // Relative to the source root the workspace carries, which the signature selects.\n149: const SKILL_ROOT_RELATIVE_PATH = 'skills';\n150: const ADVISOR_ROOT_RELATIVE_PATH = join(SKILL_ROOT_RELATIVE_PATH, 'system-skill-advisor', 'runtime');\n151: const ADVISOR_JSON_RELATIVE_PATH = join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill-graph.json');\n152: const ADVISOR_SCRIPT_RELATIVE_PATHS = [\n153:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor.py'),\n154:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor_runtime.py'),\n155:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_graph_compiler.py'),\n156: ];\n157: const SHADOW_RENDERER_URL = new URL(\n158:   '../skills/system-skill-advisor/runtime/dist/runtime/lib/render.js',\n159:   import.meta.url,\n160: );\n161: let shadowRendererPromise;\n162: \n163: function loadShadowRenderer() {\n164:   shadowRendererPromise ??= import(SHADOW_RENDERER_URL).catch(() => null);\n165:   return shadowRendererPromise;\n166: }\n167: \n168: async function loadConfig() {\n169:   const path = join(homedir(), '.config', 'opencode', 'plugin', 'system-skill-advisor.json');\n170:   try {\n171:     const raw = await readFile(path, 'utf-8');\n172:     const parsed = JSON.parse(raw);\n173:     if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n174:       return { values: {}, status: 'error', errorCode: 'CONFIG_PARSE_ERROR' };\n175:     }\n176:     return { values: parsed, status: 'loaded', errorCode: null };\n177:   } catch (error) {\n178:     if (error?.code === 'ENOENT') {\n179:       return { values: {}, status: 'absent', errorCode: null };\n180:     }\n181:     return {\n182:       values: {},\n183:       status: 'error',\n184:       errorCode: error instanceof SyntaxError ? 'CONFIG_PARSE_ERROR' : 'CONFIG_READ_ERROR',\n185:     };\n186:   }\n187: }\n188: \n189: const configPromise = loadConfig();\n190: \n191: // ─────────────────────────────────────────────────────────────────────────────\n192: // 3. PURE UTILITIES\n193: // ─────────────────────────────────────────────────────────────────────────────\n194: \n195: function normalizePositiveInt(value, fallback) {\n196:   return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n197: }\n198: \n199: function normalizeThreshold(value) {\n200:   if (!Number.isFinite(value)) {\n201:     return DEFAULT_THRESHOLD_CONFIDENCE;\n202:   }\n203:   return Math.min(1, Math.max(0, Number(value)));\n204: }\n205: \n206: function envDisablesPlugin() {\n207:   return !isHookEnabled('skill-advisor');\n208: }\n209: \n210: function isDirectiveLifecycleDedupEnabled() {\n211:   const value = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV]?.trim().toLowerCase();\n212:   return value !== '0' && value !== 'false' && value !== 'off' && value !== 'no';\n213: }\n214: \n215: function splitDirectiveBrief(context) {\n216:   const index = context.indexOf(DIRECTIVE_SEPARATOR);\n217:   // index <= 0 means no directive block or no non-empty head before it.\n218:   if (index <= 0) return null;\n219:   return { head: context.slice(0, index), directives: context.slice(index) };\n220: }\n221: \n222: /** Reduce policy only for one primitive, non-conflicting session identity. */\n223: function decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n224:   if (!isDirectiveLifecycleDedupEnabled() || !identity.confirmed) {\n225:     return { suppressed: false, reduced: null };\n226:   }\n227:   const parts = splitDirectiveBrief(brief);\n228:   if (!parts?.head.trim()) return { suppressed: false, reduced: null };\n229: \n230:   const sessionID = identity.sessionID;\n231:   const generation = state.directiveGeneration;\n232:   const epoch = state.directiveEpochBySession.get(sessionID) ?? 0;\n233:   const boundary = lifecycleEvent === 'startup'\n234:     || lifecycleEvent === 'resume'\n235:     || lifecycleEvent === 'compact';\n236:   const last = state.directiveDedupBySession.get(sessionID);\n237:   if (boundary\n238:     || !last\n239:     || last.directives !== parts.directives\n240:     || last.generation !== generation\n241:     || last.epoch !== epoch) {\n242:     while (state.directiveDedupBySession.size >= MAX_DIRECTIVE_DEDUP_SESSIONS) {\n243:       const oldest = state.directiveDedupBySession.keys().next().value;\n244:       if (typeof oldest !== 'string') break;\n245:       state.directiveDedupBySession.delete(oldest);\n246:     }\n247:     state.directiveDedupBySession.set(sessionID, {\n248:       directives: parts.directives,\n249:       generation,\n250:       epoch,\n251:     });\n252:     return { suppressed: false, reduced: null };\n253:   }\n254:   return { suppressed: true, reduced: parts.head };\n255: }\n256: \n257: function disabledEnvName() {\n258:   if (process.env[DISABLED_ENV] === '1') {\n259:     return DISABLED_ENV;\n260:   }\n261:   if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n262:     return DISABLED_ENV_PLUGIN;\n263:   }\n264:   if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n265:     return LEGACY_HOOK_DISABLED_ENV;\n266:   }\n267:   if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n268:     return LEGACY_PLUGIN_DISABLED_ENV;\n269:   }\n270:   return null;\n271: }\n272: \n273: // The signature runs on every advisor lookup, so the digest of a file whose\n274: // identity is unchanged is reused instead of read and hashed again. A difference\n275: // in mtimeMs, ctimeMs, size or ino falls back to the read, and a stat or read\n276: // failure stays missing.\n277: const fileDigestCache = new Map();\n278: \n279: function fileDigest(sourcePath, stat) {\n280:   const cached = fileDigestCache.get(sourcePath);\n281:   if (cached\n282:     && cached.mtimeMs === stat.mtimeMs\n283:     && cached.ctimeMs === stat.ctimeMs\n284:     && cached.size === stat.size\n285:     && cached.ino === stat.ino) {\n286:     return cached.digest;\n287:   }\n288:   const digest = createHash('sha256').update(readFileSync(sourcePath)).digest('hex');\n289:   fileDigestCache.set(sourcePath, {\n290:     mtimeMs: stat.mtimeMs,\n291:     ctimeMs: stat.ctimeMs,\n292:     size: stat.size,\n293:     ino: stat.ino,\n294:     digest,\n295:   });\n296:   return digest;\n297: }\n298: \n299: function addFileSignature(hash, label, sourcePath) {\n300:   try {\n301:     const stat = statSync(sourcePath);\n302:     if (!stat.isFile()) {\n303:       throw new Error('not a file');\n304:     }\n305:     hash.update(label);\n306:     hash.update('\\u001f');\n307:     hash.update(sourcePath);\n308:     hash.update('\\u001f');\n309:     hash.update(String(stat.mtimeMs));\n310:     hash.update('\\u001f');\n311:     hash.update(String(stat.size));\n312:     hash.update('\\u001f');\n313:     hash.update(fileDigest(sourcePath, stat));\n314:     hash.update('\\u001e');\n315:   } catch {\n316:     hash.update(label);\n317:     hash.update('\\u001fmissing\\u001e');\n318:   }\n319: }\n320: \n321: function advisorSourceSignature(workspaceRoot) {\n322:   // Hashing the skills under a source-root name the workspace lacks records the same\n323:   // absent marker on every call, so cached advice would outlive any change to them. With\n324:   // no source root the signature is refused, and a refused signature is never cached.\n325:   // The workspace may be any directory inside the checkout, so the source root is found\n326:   // from the repository root above it.\n327:   const sourceRoot = findSourceRoot(findRepoRoot(workspaceRoot));\n328:   if (!sourceRoot) throw new Error(`no source root under ${workspaceRoot}`);\n329:   const hash = createHash('sha256');\n330:   for (const sourcePath of ADVISOR_SOURCE_PATHS) {\n331:     addFileSignature(hash, `implementation:${sourcePath}`, sourcePath);\n332:   }\n333: \n334:   const skillRoot = join(sourceRoot, SKILL_ROOT_RELATIVE_PATH);\n335:   try {\n336:     const skillSlugs = readdirSync(skillRoot, { withFileTypes: true })\n337:       .filter((entry) => entry.isDirectory() && !entry.name.startsWith('.'))\n338:       .map((entry) => entry.name)\n339:       .sort((left, right) => left.localeCompare(right));\n340:     for (const skillSlug of skillSlugs) {\n341:       const skillDir = join(skillRoot, skillSlug);\n342:       addFileSignature(hash, `skill:${skillSlug}:SKILL.md`, join(skillDir, 'SKILL.md'));\n343:       addFileSignature(hash, `skill:${skillSlug}:graph-metadata.json`, join(skillDir, 'graph-metadata.json'));\n344:       // ROUTER.md is optional, so a skill without one keeps the signature it had\n345:       // before this probe existed; only a skill that carries the file adds a part.\n346:       const routerMdPath = join(skillDir, 'ROUTER.md');\n347:       if (existsSync(routerMdPath)) {\n348:         addFileSignature(hash, `skill:${skillSlug}:ROUTER.md`, routerMdPath);\n349:       }\n350:     }\n351:   } catch {\n352:     hash.update(`${SKILL_ROOT_RELATIVE_PATH}\\u001fmissing\\u001e`);\n353:   }\n354: \n355:   for (const relativePath of ADVISOR_SCRIPT_RELATIVE_PATHS) {\n356:     addFileSignature(hash, relativePath, join(sourceRoot, relativePath));\n357:   }\n358:   const dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n359:     ?? join(sourceRoot, ADVISOR_ROOT_RELATIVE_PATH, 'database');\n360:   addFileSignature(hash, 'skill-graph.sqlite', join(dbDir, 'skill-graph.sqlite'));\n361:   addFileSignature(hash, ADVISOR_JSON_RELATIVE_PATH, join(sourceRoot, ADVISOR_JSON_RELATIVE_PATH));\n362:   return hash.digest('hex');\n363: }\n364: \n365: function normalizeOptions(rawOptions) {\n366:   const options = rawOptions && typeof rawOptions === 'object' ? rawOptions : {};\n367:   const configuredTtl = options.cacheTTLMs ?? options.cacheTtlMs;\n368:   const enabled = options.enabled !== false && !envDisablesPlugin();\n369:   const configuredTransformDedup = typeof options.deduplicateTransforms === 'boolean'\n370:     ? options.deduplicateTransforms\n371:     : undefined;\n372: \n373:   const envCacheTTLMs = Number(process.env.SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS);\n374:   const envThreshold = Number(process.env.SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE);\n375:   const envMaxTokens = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_TOKENS);\n376:   const envBridgeTimeoutMs = Number(process.env.SYSTEM_SKILL_ADVISOR_BRIDGE_TIMEOUT_MS);\n377:   const envMaxPromptBytes = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES);\n378:   const envMaxBriefChars = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_BRIEF_CHARS);\n379:   const envMaxCacheEntries = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_CACHE_ENTRIES);\n380:   const configuredBounding = typeof options.boundedCompiledRouteSummary === 'boolean'\n381:     ? options.boundedCompiledRouteSummary\n382:     : undefined;\n383: \n384:   return {\n385:     enabled,\n386:     cacheTTLMs: normalizePositiveInt(configuredTtl, normalizePositiveInt(envCacheTTLMs, DEFAULT_CACHE_TTL_MS)),\n387:     thresholdConfidence: normalizeThreshold(options.thresholdConfidence ?? (Number.isFinite(envThreshold) ? envThreshold : undefined)),\n388:     maxTokens: normalizePositiveInt(options.maxTokens, normalizePositiveInt(envMaxTokens, DEFAULT_MAX_TOKENS)),\n389:     nodeBinary: typeof options.nodeBinaryOverride === 'string' && options.nodeBinaryOverride.trim()\n390:       ? options.nodeBinaryOverride.trim()\n391:       : (process.env.SYSTEM_SKILL_ADVISOR_NODE_BINARY || process.env.SPEC_KIT_PLUGIN_NODE_BINARY || DEFAULT_NODE_BINARY),\n392:     bridgeTimeoutMs: normalizePositiveInt(options.bridgeTimeoutMs, normalizePositiveInt(envBridgeTimeoutMs, DEFAULT_BRIDGE_TIMEOUT_MS)),\n393:     maxPromptBytes: normalizePositiveInt(options.maxPromptBytes, normalizePositiveInt(envMaxPromptBytes, DEFAULT_MAX_PROMPT_BYTES)),\n394:     maxBriefChars: normalizePositiveInt(options.maxBriefChars, normalizePositiveInt(envMaxBriefChars, DEFAULT_MAX_BRIEF_CHARS)),\n395:     maxCacheEntries: normalizePositiveInt(options.maxCacheEntries, normalizePositiveInt(envMaxCacheEntries, DEFAULT_MAX_CACHE_ENTRIES)),\n396:     boundedCompiledRouteSummary: configuredBounding ?? process.env[COMPILED_ROUTE_BOUNDING_ENV] === '1',\n397:     deduplicateTransforms: configuredTransformDedup\n398:       ?? process.env[messageIdentity.OPENCODE_TRANSFORM_DEDUP_ENV] === '1',\n399:     sourceSignatureOverride: typeof options.sourceSignatureOverride === 'string'\n400:       ? options.sourceSignatureOverride\n401:       : null,\n402:     sourceSignatureProvider: typeof options.sourceSignatureProvider === 'function'\n403:       ? options.sourceSignatureProvider\n404:       : advisorSourceSignature,\n405:     spawnAdvisor: typeof options.spawnOverride === 'function' ? options.spawnOverride : spawn,\n406:   };\n407: }\n408: \n409: function sessionIdFrom(input) {\n410:   if (!input || typeof input !== 'object') {\n411:     return '__global__';\n412:   }\n413:   return normalizeSessionID(input.sessionID\n414:     || input.sessionId\n415:     || input.session?.id\n416:     || input.properties?.sessionID\n417:     || input.properties?.info?.sessionID\n418:     || input.properties?.info?.id\n419:     || '__global__');\n420: }\n421: \n422: function directiveSessionIdentityFrom(input) {\n423:   if (!input || typeof input !== 'object') {\n424:     return { sessionID: '__global__', confirmed: false };\n425:   }\n426:   const candidates = [\n427:     input.sessionID,\n428:     input.sessionId,\n429:     input.session?.id,\n430:     input.properties?.sessionID,\n431:     input.properties?.sessionId,\n432:     input.properties?.info?.sessionID,\n433:     input.properties?.info?.id,\n434:   ].filter((value) => value !== undefined && value !== null && value !== '');\n435:   const primitive = candidates.filter((value) => typeof value === 'string' || typeof value === 'number');\n436:   const normalized = [...new Set(primitive.map((value) => String(value).trim()).filter(Boolean))];\n437:   const ambiguous = candidates.some((value) => typeof value === 'object')\n438:     || input.sessionIdentityAmbiguous === true\n439:     || input.session_identity_ambiguous === true;\n440:   const conflicting = normalized.length !== 1 || primitive.length !== candidates.length;\n441:   const explicitlyRejected = input.sessionIdentityConfirmed === false\n442:     || input.session_identity_confirmed === false;\n443:   return {\n444:     sessionID: normalized.length === 1 ? normalized[0] : '__global__',\n445:     confirmed: normalized[0] !== '__global__'\n446:       && !ambiguous\n447:       && !conflicting\n448:       && !explicitlyRejected,\n449:   };\n450: }\n451: \n452: function advanceOpenCodeDirectiveBoundary(state, input) {\n453:   const identity = directiveSessionIdentityFrom(input);\n454:   if (identity.confirmed) {\n455:     const epoch = state.directiveEpochBySession.get(identity.sessionID) ?? 0;\n456:     state.directiveEpochBySession.set(identity.sessionID, epoch + 1);\n457:     state.directiveDedupBySession.delete(identity.sessionID);\n458:   } else {\n459:     state.directiveGeneration += 1;\n460:     state.directiveDedupBySession.clear();\n461:     state.directiveEpochBySession.clear();\n462:   }\n463:   return identity;\n464: }\n465: \n466: function stableStringify(value) {\n467:   if (!value || typeof value !== 'object') {\n468:     return JSON.stringify(String(value));\n469:   }\n470: \n471:   if (Array.isArray(value)) {\n472:     return `[${value.map((entry) => stableStringify(entry)).join(',')}]`;\n473:   }\n474: \n475:   return `{${Object.keys(value)\n476:     .sort()\n477:     .map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`)\n478:     .join(',')}}`;\n479: }\n480: \n481: function normalizeSessionID(value) {\n482:   if (value === null || value === undefined || value === '') {\n483:     return '__global__';\n484:   }\n485:   if (typeof value === 'object') {\n486:     return stableStringify(value);\n487:   }\n488:   return String(value);\n489: }\n490: \n491: function normalizeWorkspaceRoot(workspaceRoot) {\n492:   if (typeof workspaceRoot === 'string' && workspaceRoot.trim()) {\n493:     return resolvePath(workspaceRoot.trim());\n494:   }\n495:   return resolvePath(process.cwd());\n496: }\n497: \n498: function statusSafeBinary(binary) {\n499:   if (typeof binary === 'string' && (binary.includes('/') || binary.includes('\\\\'))) {\n500:     return '[configured-node]';\n501:   }\n502:   return binary;\n503: }\n504: \n505: function cacheKeyForPrompt(prompt, options, sessionID, sourceSignature, workspaceRoot, servingSignature) {\n506:   const sessionKey = normalizeSessionID(sessionID);\n507:   const promptKey = createHash('sha256')\n508:     .update(prompt)\n509:     .update('\\u001f')\n510:     .update(String(options.thresholdConfidence))\n511:     .update('\\u001f')\n512:     .update(String(options.maxTokens))\n513:     .update('\\u001f')\n514:     .update(sourceSignature)\n515:     .update('\\u001f')\n516:     .update(workspaceRoot)\n517:     .update('\u001f')\n518:     .update(String(servingSignature ?? ''))\n519:     .digest('hex');\n520:   return `${String(sessionKey)}::${promptKey}`;\n521: }\n522: \n523: function extractPrompt(input) {\n524:   if (typeof input === 'string') {\n525:     return input;\n526:   }\n527:   if (!input || typeof input !== 'object') {\n528:     return null;\n529:   }\n530: \n531:   const candidates = [\n532:     input.prompt,\n533:     input.text,\n534:     input.userPrompt,\n535:     input.message,\n536:     input.input,\n537:     input.properties?.prompt,\n538:     input.properties?.message,\n539:     input.request?.prompt,\n540:     input.request?.message,\n541:   ];\n542: \n543:   for (const candidate of candidates) {\n544:     if (typeof candidate === 'string' && candidate.trim()) {\n545:       return candidate;\n546:     }\n547:     if (candidate && typeof candidate === 'object') {\n548:       const content = candidate.content ?? candidate.text;\n549:       if (typeof content === 'string' && content.trim()) {\n550:         return content;\n551:       }\n552:     }\n553:   }\n554: \n555:   return null;\n556: }\n557: \n558: function cliRecommendations(data, options) {\n559:   if (!Array.isArray(data?.recommendations)) {\n560:     return [];\n561:   }\n562:   return data.recommendations\n563:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n564:     .map((recommendation) => {\n565:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n566:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n567:       return {\n568:         skill: recommendation.skillId,\n569:         confidence,\n570:         uncertainty,\n571:         // The CLI's public recommendations carry no verdict field, so the caller\n572:         // decides it from the same thresholds the renderer enforces.\n573:         passes_threshold: confidence >= options.thresholdConfidence\n574:           && uncertainty <= DEFAULT_THRESHOLD_UNCERTAINTY,\n575:         ...(Array.isArray(recommendation.ambiguousWith)\n576:           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n577:           : {}),\n578:         // The renderer prints a command, its policy and its owner only from these\n579:         // fields. A skill row such as sk-doc has no generated command row to refill\n580:         // them, so a dropped field hides the command the advisor attached.\n581:         ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n582:         ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n583:         ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n584:         ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n585:       };\n586:     });\n587: }\n588: \n589: // Compact the served compiled decision the advisor attached to a recommendation.\n590: // Returns null when no recommendation carried a route, which keeps the injected\n591: // context byte-identical to the legacy brief.\n592: function compiledRouteSummary(data) {\n593:   if (!Array.isArray(data?.recommendations)) return null;\n594:   for (const recommendation of data.recommendations) {\n595:     const route = recommendation?.compiledRoute;\n596:     if (!route || typeof route !== 'object' || typeof route.action !== 'string') continue;\n597:     return {\n598:       outcome: route.action,\n599:       hubId: typeof route.hubId === 'string' ? route.hubId : null,\n600:       targets: Array.isArray(route.targets) ? route.targets.filter((target) => typeof target === 'string') : [],\n601:       servingAuthority: 'compiled',\n602:     };\n603:   }\n604:   return null;\n605: }\n606: \n607: /**\n608:  * Parse the advisor CLI's stdout and render its brief.\n609:  *\n610:  * @param {string} stdout - Raw CLI stdout text\n611:  * @param {Object} options - Normalized plugin options\n612:  * @returns {Promise<Object>} Response with `brief`, `status`, and `metadata`\n613:  */\n614: async function parseCliResponse(stdout, options) {\n615:   if (!stdout.trim()) {\n616:     return { brief: null, status: 'fail_open', error: 'EMPTY_STDOUT', metadata: {} };\n617:   }\n618: \n619:   let parsed;\n620:   try {\n621:     parsed = JSON.parse(stdout.trim());\n622:   } catch {\n623:     return { brief: null, status: 'fail_open', error: 'PARSE_FAIL', metadata: {} };\n624:   }\n625: \n626:   const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : null;\n627:   if (parsed?.status !== 'ok' || !data) {\n628:     return { brief: null, status: 'fail_open', error: 'UNEXPECTED_PAYLOAD', metadata: {} };\n629:   }\n630: \n631:   const recommendations = cliRecommendations(data, options);\n632:   const top = recommendations[0] ?? null;\n633:   // The CLI reports no freshness when it answered from the local scorer instead\n634:   // of the daemon; 'stale' keeps that brief renderable and honest.\n635:   const freshness = data.freshness === 'live' || data.freshness === 'stale'\n636:     ? data.freshness\n637:     : (parsed.degraded === true ? 'stale' : 'unavailable');\n638:   const tokenCap = data.ambiguous === true ? AMBIGUOUS_TOKEN_CAP : options.maxTokens;\n639:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n640:   const renderBrief = typeof renderer?.renderAdvisorBrief === 'function' ? renderer.renderAdvisorBrief : null;\n641:   const rendered = renderBrief\n642:     ? renderBrief({\n643:       status: 'ok',\n644:       freshness,\n645:       recommendations,\n646:       ambiguous: data.ambiguous === true,\n647:       metrics: { tokenCap },\n648:       sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n649:     }, {\n650:       tokenCap,\n651:       thresholdConfig: {\n652:         confidenceThreshold: options.thresholdConfidence,\n653:         uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n654:       },\n655:     })\n656:     : null;\n657:   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n658:   const routeSummary = compiledRouteSummary(data);\n659: \n660:   return {\n661:     brief,\n662:     status: brief ? 'ok' : 'skipped',\n663:     metadata: {\n664:       route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n665:       freshness,\n666:       recommendationCount: recommendations.length,\n667:       tokenCap,\n668:       skillLabel: top?.skill ?? null,\n669:       cacheHit: Boolean(data.cache?.hit),\n670:       ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n671:     },\n672:   };\n673: }\n674: \n675: // ─────────────────────────────────────────────────────────────────────────────\n676: // 4. SIZE-CAP HELPERS\n677: // ─────────────────────────────────────────────────────────────────────────────\n678: \n679: /**\n680:  * Clamp advisor brief text by JavaScript character count.\n681:  *\n682:  * @param {string} brief - Advisor brief text to clamp\n683:  * @param {number} maxChars - Maximum character count to retain\n684:  * @returns {string} Original brief or truncated prefix within the limit\n685:  */\n686: function clampBrief(brief, maxChars) {\n687:   if (typeof brief !== 'string' || brief.length <= maxChars) {\n688:     return brief;\n689:   }\n690:   return brief.slice(0, maxChars);\n691: }\n692: \n693: /**\n694:  * Insert a cache value and evict oldest entries by insertion order.\n695:  *\n696:  * @param {Map<string, Object>} cache - Cache map using insertion order as LRU state\n697:  * @param {string} key - Cache key to insert or refresh\n698:  * @param {Object} value - Cache value to store\n699:  * @param {number} maxEntries - Maximum entries retained after insertion\n700:  * @returns {void}\n701:  */\n702: function insertWithEviction(cache, key, value, maxEntries) {\n703:   cache.set(key, value);\n704:   while (cache.size > maxEntries) {\n705:     const oldest = cache.keys().next().value;\n706:     cache.delete(oldest);\n707:   }\n708: }\n709: \n710: // The advisor CLI reads its request from stdin (`--json -`), so the prompt never\n711: // appears in argv, which any local user can read from the process table.\n712: function advisorCliArgs() {\n713:   return [ADVISOR_CLI_PATH, 'advisor_recommend', '--json', '-', '--format', 'json'];\n714: }\n715: \n716: // Build the stdin request, or null when the byte budget cannot hold even one prompt\n717: // character beside the request's fixed part. The prompt keeps at most\n718: // ADVISOR_PROMPT_MAX_CHARS characters and is clamped by its escaped size, because JSON\n719: // writes a quote or newline as two bytes and a control character as six.\n720: // The hub's own `.skilled` directory, resolved once. The plugin loads from `.opencode/plugins`,\n721: // one level below the repository root.\n722: let hubSkilledRoot;\n723: function resolveHubSkilledRoot() {\n724:   if (hubSkilledRoot === undefined) {\n725:     try {\n726:       hubSkilledRoot = realpathSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '.skilled'));\n727:     } catch {\n728:       hubSkilledRoot = null;\n729:     }\n730:   }\n731:   return hubSkilledRoot;\n732: }\n733: \n734: // The sk-code surfaces declared for detection, in the order detection tries them:\n735: // every specific surface first, the hub registry's in registry order and then those\n736: // of outside skills whose graph-metadata.json names the sk-code family, by skill_id,\n737: // and the hub's one fallback last. An outside block that claims the fallback role is\n738: // ignored, because the fallback is the hub's own code.\n739: const SK_CODE_HUB = 'sk-code';\n740: const EXTENSION_MARKER = /^\\.[a-z0-9]+$/i;\n741: \n742: function readJsonFile(file) {\n743:   try {\n744:     const value = JSON.parse(readFileSync(file, 'utf8'));\n745:     return value && typeof value === 'object' ? value : null;\n746:   } catch {\n747:     return null;\n748:   }\n749: }\n750: \n751: // A block with no marker of any kind declares no surface, as the hub reader drops it too, so the\n752: // two readers list the same surfaces. Only path and file markers are kept for matching here.\n753: function surfaceEntry(block) {\n754:   if (!block || typeof block !== 'object' || typeof block.label !== 'string' || !block.label.trim()) return null;\n755:   const markerList = (list) => (Array.isArray(list) ? list : [])\n756:     .filter((marker) => typeof marker === 'string' && marker.length > 0);\n757:   const markers = [block.pathMarkers, block.fileMarkers].flatMap(markerList);\n758:   if (markers.length === 0 && markerList(block.contentMarkers).length === 0) return null;\n759:   return { label: block.label.toUpperCase(), role: block.role, markers };\n760: }\n761: \n762: // The trusted-root rule for a private link lives in the advisor runtime as plain\n763: // CommonJS, so both skills-root readers apply one copy of it on every supported Node\n764: // version. When the module cannot load, the check rejects every link, which keeps an\n765: // unverified target out of detection, and one stderr line records the lost rule.\n766: let privateSkillTarget;\n767: function loadPrivateSkillTarget() {\n768:   if (privateSkillTarget === undefined) {\n769:     try {\n770:       const hubRoot = resolveHubSkilledRoot();\n771:       privateSkillTarget = hubRoot\n772:         ? pluginRequire(join(hubRoot, ADVISOR_ROOT_RELATIVE_PATH, 'lib', 'private-skill-target.cjs'))\n773:         : null;\n774:     } catch (error) {\n775:       privateSkillTarget = null;\n776:       process.stderr.write(`[${PLUGIN_ID}] private-skill trusted-root rule failed to load, so every local-* link is skipped: ${error.message}\\n`);\n777:     }\n778:   }\n779:   return privateSkillTarget;\n780: }\n781: \n782: function privateSkillLinkCheck(skillsDir) {\n783:   const lib = loadPrivateSkillTarget();\n784:   return lib && typeof lib.createPrivateSkillLinkCheck === 'function'\n785:     ? lib.createPrivateSkillLinkCheck(skillsDir)\n786:     : () => false;\n787: }\n788: \n789: function declaredSurfaces(hubRoot) {\n790:   const skillsDir = join(hubRoot, 'skills');\n791:   const registry = readJsonFile(join(skillsDir, SK_CODE_HUB, 'mode-registry.json'));\n792:   const hub = (registry && Array.isArray(registry.modes) ? registry.modes : [])\n793:     .map((mode) => surfaceEntry(mode && mode.surfaceDetection))\n794:     .filter(Boolean);\n795:   const outside = [];\n796:   let entries = [];\n797:   try {\n798:     entries = readdirSync(skillsDir, { withFileTypes: true });\n799:   } catch {\n800:     entries = [];\n801:   }\n802:   // A skill is a real directory, or a `local-*` link whose real target the advisor's\n803:   // trusted-root rule accepts. Any other link is skipped, as the replay library skips it.\n804:   let isTrustedLink = null;\n805:   for (const dirent of entries) {\n806:     const name = dirent.name;\n807:     if (!dirent.isDirectory()) {\n808:       if (!name.startsWith('local-') || !dirent.isSymbolicLink()) continue;\n809:       isTrustedLink = isTrustedLink || privateSkillLinkCheck(skillsDir);\n810:       if (!isTrustedLink(join(skillsDir, name))) continue;\n811:     }\n812:     const meta = readJsonFile(join(skillsDir, name, 'graph-metadata.json'));\n813:     if (!meta || meta.family !== SK_CODE_HUB || meta.skill_id === SK_CODE_HUB) continue;\n814:     const entry = surfaceEntry(meta.surface_detection);\n815:     if (entry && entry.role === 'specific') outside.push({ ...entry, skillId: String(meta.skill_id || name) });\n816:   }\n817:   outside.sort((a, b) => (a.skillId < b.skillId ? -1 : a.skillId > b.skillId ? 1 : 0));\n818:   return [\n819:     ...hub.filter((entry) => entry.role === 'specific'),\n820:     ...outside,\n821:     ...hub.filter((entry) => entry.role === 'fallback'),\n822:   ];\n823: }\n824: \n825: // A specific surface matches when the resolved workspace holds one of its path or\n826: // file markers, or sits inside a folder a path marker names. Extension and content\n827: // markers need the files a task touches, which a workspace check does not have.\n828: function workspaceHasMarker(real, entry) {\n829:   return entry.markers.some((marker) => {\n830:     if (EXTENSION_MARKER.test(marker)) return false;\n831:     const rel = marker.replace(/\\/+$/, '');\n832:     if (!rel) return false;\n833:     return existsSync(join(real, rel)) || `${real}${sep}`.includes(`${sep}${rel.split('/').join(sep)}${sep}`);\n834:   });\n835: }\n836: \n837: // The sk-code surface a session works in, read from its workspace. A specific\n838: // surface whose markers the workspace holds wins, so a surface another repository\n839: // adds always leads the hub's own. The fallback holds only when the resolved\n840: // workspace lies inside the hub's own .skilled directory, so a symlinked local\n841: // skill or a .skilled folder in another repository is never read as hub code. Any\n842: // other workspace sends no hint, so the compiled tie-break order applies. The\n843: // result is cached per workspace because the check runs before every uncached\n844: // advisor call.\n845: const workspaceSurfaceCache = new Map();\n846: function detectWorkspaceSurface(projectDir) {\n847:   if (typeof projectDir !== 'string' || projectDir.length === 0) return null;\n848:   if (workspaceSurfaceCache.has(projectDir)) return workspaceSurfaceCache.get(projectDir);\n849:   let surface = null;\n850:   try {\n851:     const real = realpathSync(projectDir);\n852:     const hubRoot = resolveHubSkilledRoot();\n853:     const insideHub = Boolean(hubRoot) && (real === hubRoot || real.startsWith(`${hubRoot}${sep}`));\n854:     const match = hubRoot\n855:       ? declaredSurfaces(hubRoot).find((entry) => (\n856:         entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n857:       ))\n858:       : null;\n859:     surface = match ? match.label : null;\n860:   } catch {\n861:     surface = null;\n862:   }\n863:   workspaceSurfaceCache.set(projectDir, surface);\n864:   return surface;\n865: }\n866: \n867: function advisorCliRequest({ prompt, options, surfaceHint = null }) {\n868:   const requestOptions = {\n869:     // Three recommendations keep the two-target ambiguity line available without\n870:     // asking the advisor for a longer list than the brief can use.\n871:     topK: 3,\n872:     includeAttribution: false,\n873:     includeAbstainReasons: true,\n874:     confidenceThreshold: options.thresholdConfidence,\n875:     uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n876:     ...(surfaceHint ? { surfaceHint } : {}),\n877:   };\n878:   const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n879:   let remaining = options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n880:   let end = 0;\n881:   for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n882:     remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n883:     if (remaining < 0) break;\n884:     end += char.length;\n885:   }\n886:   return end > 0 ? request(prompt.slice(0, end)) : null;\n887: }\n888: \n889: // ─────────────────────────────────────────────────────────────────────────────\n890: // 5. EVENT HELPERS\n891: // ─────────────────────────────────────────────────────────────────────────────\n892: \n893: function eventPayloadFrom(event) {\n894:   if (event?.payload && typeof event.payload === 'object') {\n895:     return event.payload;\n896:   }\n897:   return event;\n898: }\n899: \n900: function eventTypeFrom(event) {\n901:   const payload = eventPayloadFrom(event);\n902:   return typeof payload?.type === 'string' ? payload.type : null;\n903: }\n904: \n905: function lifecycleEventFrom(input, eventType = null) {\n906:   const candidates = [\n907:     input?.lifecycleEvent,\n908:     input?.lifecycle_event,\n909:     input?.lifecycleSource,\n910:     input?.lifecycle_source,\n911:     input?.source,\n912:     input?.properties?.source,\n913:   ];\n914:   for (const candidate of candidates) {\n915:     if (candidate === 'startup' || candidate === 'resume' || candidate === 'compact') {\n916:       return candidate;\n917:     }\n918:   }\n919:   if (eventType === 'session.created') return 'startup';\n920:   if (eventType === 'session.resumed') return 'resume';\n921:   if (eventType === 'session.compacted' || eventType === 'session.compact') return 'compact';\n922:   return undefined;\n923: }\n924: \n925: function rawSessionValueFrom(input) {\n926:   return input?.sessionID\n927:     ?? input?.sessionId\n928:     ?? input?.session?.id\n929:     ?? input?.properties?.sessionID\n930:     ?? input?.properties?.sessionId;\n931: }\n932: \n933: function shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed) {\n934:   const rawSession = rawSessionValueFrom(input);\n935:   const ambiguous = Boolean(\n936:     input?.sessionIdentityAmbiguous\n937:       || input?.session_identity_ambiguous\n938:       || (rawSession && typeof rawSession === 'object'),\n939:   );\n940:   const explicitConfirmation = input?.sessionIdentityConfirmed\n941:     ?? input?.session_identity_confirmed;\n942:   const sessionKnown = sessionID !== '__global__'\n943:     && !ambiguous\n944:     && explicitConfirmation !== false;\n945:   return {\n946:     sessionId: sessionKnown ? sessionID : undefined,\n947:     sessionIdentityConfirmed: sessionKnown,\n948:     sessionIdentityAmbiguous: ambiguous,\n949:     lifecycleEvent,\n950:     scopeChanged: input?.scopeChanged === true || input?.scope_changed === true,\n951:     policySetChanged: input?.policySetChanged === true || input?.policy_set_changed === true,\n952:     goalChanged: input?.goalChanged === true || input?.goal_changed === true,\n953:     deliveryConfirmed,\n954:   };\n955: }\n956: \n957: async function observeShadowDeliveryForRuntime(\n958:   rendered,\n959:   input,\n960:   sessionID,\n961:   lifecycleEvent,\n962:   deliveryConfirmed = false,\n963: ) {\n964:   try {\n965:     const renderer = await loadShadowRenderer();\n966:     if (typeof renderer?.observeShadowDelivery !== 'function') return;\n967:     renderer.observeShadowDelivery(\n968:       typeof rendered === 'string' ? rendered : null,\n969:       shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed),\n970:     );\n971:   } catch {\n972:     // Shadow planning must never alter the active OpenCode transform.\n973:   }\n974: }\n975: \n976: async function observeEmittedAdvisorBlock(\n977:   rendered,\n978:   input,\n979:   sessionID,\n980:   lifecycleEvent,\n981: ) {\n982:   try {\n983:     const renderer = await loadShadowRenderer();\n984:     if (typeof renderer?.observeEmittedAdvisorPolicy !== 'function') return;\n985:     renderer.observeEmittedAdvisorPolicy(\n986:       typeof rendered === 'string' ? rendered : null,\n987:       {\n988:         ...shadowDeliveryStateFor(input, sessionID, lifecycleEvent, true),\n989:         runtime: 'OpenCode',\n990:         candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n991:       },\n992:     );\n993:   } catch {\n994:     // Host observation must never alter the active OpenCode transform.\n995:   }\n996: }\n997: \n998: function transformContributionDecision(input, options, blockId, content, order) {\n999:   if (!options.deduplicateTransforms) {\n1000:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n1001:   }\n1002:   const identity = messageIdentity.resolveMessageIdentity(input);\n1003:   const contentHash = messageIdentity.hashPolicyBlockContent(blockId, content, order);\n1004:   if (!identity || !contentHash) {\n1005:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n1006:   }\n1007:   const decision = messageIdentity.recordTransformContribution({\n1008:     identity,\n1009:     blockId,\n1010:     contentHash,\n1011:     transform: PLUGIN_ID,\n1012:   });\n1013:   return {\n1014:     ...decision,\n1015:     identity,\n1016:     blockId,\n1017:     contentHash,\n1018:   };\n1019: }\n1020: \n1021: function commitTransformContribution(decision) {\n1022:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1023:   if (decision.duplicate || decision.shouldDeliver) {\n1024:     messageIdentity.commitTransformDelivery(\n1025:       decision.identity,\n1026:       decision.blockId,\n1027:       decision.contentHash,\n1028:       { transform: PLUGIN_ID },\n1029:     );\n1030:     return;\n1031:   }\n1032:   messageIdentity.releaseTransformReservation(\n1033:     decision.identity,\n1034:     decision.blockId,\n1035:     decision.contentHash,\n1036:   );\n1037: }\n1038: \n1039: function releaseTransformContribution(decision) {\n1040:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1041:   messageIdentity.releaseTransformReservation(\n1042:     decision.identity,\n1043:     decision.blockId,\n1044:     decision.contentHash,\n1045:   );\n1046: }\n1047: \n1048: function deliverTransformContribution(decision, deliver) {\n1049:   if (!decision?.shouldDeliver) {\n1050:     commitTransformContribution(decision);\n1051:     return;\n1052:   }\n1053:   try {\n1054:     deliver();\n1055:     commitTransformContribution(decision);\n1056:   } catch (error) {\n1057:     releaseTransformContribution(decision);\n1058:     throw error;\n1059:   }\n1060: }\n1061: \n1062: // ─────────────────────────────────────────────────────────────────────────────\n1063: // 6. PLUGIN FACTORY\n1064: // ─────────────────────────────────────────────────────────────────────────────\n1065: \n1066: /**\n1067:  * Create the Spec Kit skill advisor OpenCode plugin hooks.\n1068:  *\n1069:  * @param {import('@opencode-ai/plugin').PluginInput} ctx - OpenCode plugin context\n1070:  * @param {Object} [rawOptions] - Plugin options\n1071:  * @param {boolean} [rawOptions.enabled] - Whether the plugin should inject advisor briefs\n1072:  * @param {number} [rawOptions.cacheTTLMs] - Advisor cache TTL in milliseconds\n1073:  * @param {number} [rawOptions.cacheTtlMs] - Advisor cache TTL alias in milliseconds\n1074:  * @param {number} [rawOptions.thresholdConfidence] - Minimum advisor confidence threshold\n1075:  * @param {number} [rawOptions.maxTokens] - Maximum advisor brief tokens requested from the advisor CLI\n1076:  * @param {string} [rawOptions.nodeBinaryOverride] - Node binary used for the advisor CLI subprocess\n1077:  * @param {number} [rawOptions.bridgeTimeoutMs] - Advisor CLI subprocess timeout in milliseconds\n1078:  * @param {number} [rawOptions.maxPromptBytes] - Maximum UTF-8 bytes of the stdin request sent to the advisor CLI, prompt included\n1079:  * @param {number} [rawOptions.maxBriefChars] - Maximum injected advisor brief characters\n1080:  * @param {number} [rawOptions.maxCacheEntries] - Maximum advisor cache entries\n1081:  * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Bound long compiled-route target lists\n1082:  * @param {boolean} [rawOptions.deduplicateTransforms] - Suppress duplicate same-message system blocks\n1083:  * @param {string} [rawOptions.sourceSignatureOverride] - Test override for advisor source signature\n1084:  * @returns {Promise<Object>} Hooks with `event`, `experimental.chat.system.transform`, and `tool`\n1085:  */\n1086: async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n1087:   const fileConfig = await configPromise;\n1088:   const merged = { ...fileConfig.values, ...rawOptions };\n1089:   const options = normalizeOptions(merged);\n1090:   const projectDir = normalizeWorkspaceRoot(ctx?.directory);\n1091: \n1092:   // Per-instance state so two plugin instances loaded in the same process maintain independent caches/metrics.\n1093:   const state = {\n1094:     advisorCache: new Map(),\n1095:     // In-flight promise dedup: concurrent identical-key requests share one advisor CLI spawn.\n1096:     inFlight: new Map(),\n1097:     // Live advisor CLI runs and the FIFO of callers waiting for a free slot.\n1098:     activeAdvisorRuns: 0,\n1099:     advisorRunWaiters: [],\n1100:     // Per-session record of the constant directive block last delivered in\n1101:     // full, keyed by normalized session id. Cleared on session lifecycle\n1102:     // boundaries (created/resumed/compacted/deleted) so the full block is\n1103:     // re-delivered on the first message after each boundary.\n1104:     directiveDedupBySession: new Map(),\n1105:     directiveEpochBySession: new Map(),\n1106:     directiveGeneration: 0,\n1107:     epoch: 0,\n1108:     runtimeReady: false,\n1109:     lastBridgeStatus: 'uninitialized',\n1110:     lastErrorCode: null,\n1111:     lastDurationMs: 0,\n1112:     bridgeInvocations: 0,\n1113:     cacheHits: 0,\n1114:     cacheMisses: 0,\n1115:     advisorLookups: 0,\n1116:     configStatus: fileConfig.status,\n1117:     configErrorCode: fileConfig.errorCode,\n1118:     disabledReason: !options.enabled\n1119:       ? (disabledEnvName() ?? 'config_enabled_false')\n1120:       : null,\n1121:   };\n1122: \n1123:   function acquireAdvisorRunSlot(sessionID, timeoutMs) {\n1124:     if (state.activeAdvisorRuns < MAX_CONCURRENT_ADVISOR_RUNS) {\n1125:       state.activeAdvisorRuns += 1;\n1126:       return Promise.resolve({ granted: true });\n1127:     }\n1128:     return new Promise((resolve) => {\n1129:       const waiter = {\n1130:         sessionID,\n1131:         // A wall-clock step can move a deadline backwards, so elapsed queue time\n1132:         // must come from a monotonic clock.\n1133:         deadline: performance.now() + timeoutMs,\n1134:         settled: false,\n1135:         timer: null,\n1136:         grant() {\n1137:           if (waiter.settled) {\n1138:             // The deadline already answered this caller, so the slot has to go\n1139:             // to the next waiter instead of disappearing with nobody holding it.\n1140:             releaseAdvisorRunSlot();\n1141:             return;\n1142:           }\n1143:           waiter.settled = true;\n1144:           clearTimeout(waiter.timer);\n1145:           resolve({ granted: true });\n1146:         },\n1147:         deny(error) {\n1148:           if (waiter.settled) {\n1149:             return;\n1150:           }\n1151:           waiter.settled = true;\n1152:           clearTimeout(waiter.timer);\n1153:           const index = state.advisorRunWaiters.indexOf(waiter);\n1154:           if (index !== -1) {\n1155:             state.advisorRunWaiters.splice(index, 1);\n1156:           }\n1157:           resolve({ granted: false, error });\n1158:         },\n1159:       };\n1160:       // Queue time counts against the same budget as the run, or a backlog makes\n1161:       // the host transform wait far past the bridge timeout it was promised.\n1162:       waiter.timer = setTimeout(() => waiter.deny('QUEUE_TIMEOUT'), timeoutMs);\n1163:       waiter.timer.unref?.();\n1164:       state.advisorRunWaiters.push(waiter);\n1165:     });\n1166:   }\n1167: \n1168:   function releaseAdvisorRunSlot() {\n1169:     while (state.advisorRunWaiters.length > 0) {\n1170:       const next = state.advisorRunWaiters.shift();\n1171:       if (next.deadline > performance.now()) {\n1172:         // Hand the slot to the oldest waiter still in time so the live count never dips.\n1173:         next.grant();\n1174:         return;\n1175:       }\n1176:       // A slot can free after a waiter's deadline but before its timer fires, and\n1177:       // granting then would run the overdue lookup with a fresh timeout.\n1178:       next.deny('QUEUE_TIMEOUT');\n1179:     }\n1180:     state.activeAdvisorRuns = Math.max(0, state.activeAdvisorRuns - 1);\n1181:   }\n1182: \n1183:   // A reset must release queued callers, or their host transforms never settle.\n1184:   function cancelAdvisorRunWaiters() {\n1185:     while (state.advisorRunWaiters.length > 0) {\n1186:       state.advisorRunWaiters.shift().deny('RUNTIME_RESET');\n1187:     }\n1188:   }\n1189: \n1190:   // Queued transforms for a deleted session fail open now instead of holding a\n1191:   // queue position until their deadline.\n1192:   function cancelAdvisorRunWaitersForSession(sessionID) {\n1193:     for (const waiter of [...state.advisorRunWaiters]) {\n1194:       if (waiter.sessionID === sessionID) {\n1195:         waiter.deny('SESSION_DELETED');\n1196:       }\n1197:     }\n1198:   }\n1199: \n1200:   /**\n1201:    * Run the advisor CLI and render its JSON response.\n1202:    * The CLI receives the request on stdin from `advisorCliRequest`, returns stdout\n1203:    * JSON parsed by `parseCliResponse`, gets SIGTERM shortly before the deadline,\n1204:    * and gets SIGKILL at the deadline if the process has not settled.\n1205:    *\n1206:    * @param {Object} params - CLI invocation parameters\n1207:    * @param {string} params.projectDir - Working directory for the advisor CLI subprocess\n1208:    * @param {string} params.prompt - Prompt passed to the advisor CLI\n1209:    * @param {string} params.sessionID - Session that owns the queued slot request\n[Output truncated. Continue reading with offset: 1210]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js, lines 1-1209\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: Skill Advisor OpenCode Plugin (system-skill-advisor)              ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Inject skill advisor brief into OpenCode model context per      ║\n5: // ║          prompt; expose status tool; manage per-instance state,          ║\n6: // ║          in-flight dedup, and bounded prompt/brief/cache sizes.           ║\n7: // ╚══════════════════════════════════════════════════════════════════════════╝\n8: 'use strict';\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: import { createHash } from 'node:crypto';\n15: import { spawn } from 'node:child_process';\n16: import { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'node:fs';\n17: import { resolve as resolvePath } from 'node:path';\n18: import { readFile } from 'node:fs/promises';\n19: import { homedir } from 'node:os';\n20: import { dirname, join, sep } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: import { createRequire } from 'node:module';\n23: \n24: import { tool } from './lib/tool-identity.js';\n25: import { dualPlugin } from './lib/v2-bridge.js';\n26: \n27: import * as messageIdentity from './lib/opencode-message-identity.js';\n28: import {\n29:   FALLBACK_DIRECTIVE,\n30:   SETUP_WORDING,\n31:   renderCompiledRouteSummaryLine,\n32:   renderPluginFallbackDirective,\n33: } from './lib/skill-advisor-render.js';\n34: import { findRepoRoot, findSourceRoot } from '../skills/system-spec-kit/runtime/hooks/lib/workspace/repo-root.mjs';\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const PLUGIN_ID = 'system-skill-advisor';\n41: const DEFAULT_CACHE_TTL_MS = 5 * 60 * 1000;\n42: const DEFAULT_THRESHOLD_CONFIDENCE = 0.8;\n43: // Mirrors the compat contract's uncertainty ceiling. The CLI request and the\n44: // brief render must carry the same bound, or a recommendation can pass one and\n45: // fail the other.\n46: const DEFAULT_THRESHOLD_UNCERTAINTY = 0.35;\n47: const DEFAULT_MAX_TOKENS = 80;\n48: const AMBIGUOUS_TOKEN_CAP = 120;\n49: const DEFAULT_BRIDGE_TIMEOUT_MS = 2500;\n50: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n51: const DEFAULT_NODE_BINARY = 'node';\n52: const DEFAULT_MAX_PROMPT_BYTES = 64 * 1024;\n53: // advisor_recommend refuses a longer prompt, so a longer one is sent as its head\n54: // rather than refused and reported as an outage.\n55: const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n56: const DEFAULT_MAX_BRIEF_CHARS = 2 * 1024;\n57: const DEFAULT_MAX_CACHE_ENTRIES = 1000;\n58: const MAX_BRIDGE_STDOUT_BYTES = 256 * 1024;\n59: // Unique prompts each need their own advisor child, so a burst must not multiply\n60: // live processes without limit.\n61: const MAX_CONCURRENT_ADVISOR_RUNS = 2;\n62: const BRIDGE_TERMINATION_GRACE_MS = 250;\n63: const COMPILED_ROUTE_BOUNDING_ENV = 'SYSTEM_SKILL_ADVISOR_COMPILED_ROUTE_BOUNDING';\n64: const DISABLED_ENV = 'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED';\n65: const DISABLED_ENV_PLUGIN = 'SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED';\n66: const LEGACY_HOOK_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED';\n67: const LEGACY_PLUGIN_DISABLED_ENV = 'SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED';\n68: \n69: // Directive-lifecycle dedup: this plugin is a plain-JS mirror of the canonical\n70: // rule in hooks/lib/directive-lifecycle.ts (same separator, same fail-open\n71: // semantics). Deliver the full brief on the first message of a session and\n72: // after every lifecycle boundary; on a same-content repeat keep the dynamic\n73: // Advisor: route line and drop the constant directive block. The canonical\n74: // copy stays in directive-lifecycle.ts; when that module gains a compiled\n75: // dist, prefer importing it over extending this mirror.\n76: const DIRECTIVE_LIFECYCLE_DEDUP_ENV = 'SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP';\n77: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n78: const MAX_DIRECTIVE_DEDUP_SESSIONS = 64;\n79: const pluginRequire = createRequire(import.meta.url);\n80: const { isHookEnabled } = pluginRequire('../hooks/shared/hook-flags.cjs');\n81: \n82: // The compiled-routing helper resolves from whichever adapter root actually\n83: // carries it: .opencode/bin is a link that a copied tree may lack, so a single\n84: // relative ../bin probe would spawn a broken module pair in a half-migrated tree.\n85: function resolveCompiledRouteStatusModule() {\n86:   const here = dirname(fileURLToPath(import.meta.url));\n87:   for (const candidate of [\n88:     join(here, '..', 'bin', 'compiled-route-status.cjs'),\n89:     join(here, '..', '..', '.skilled', 'bin', 'compiled-route-status.cjs'),\n90:   ]) {\n91:     if (existsSync(candidate)) return candidate;\n92:   }\n93:   return join(here, '..', 'bin', 'compiled-route-status.cjs');\n94: }\n95: \n96: // Compact, prompt-safe per-hub compiled-routing serving summary. Reads the\n97: // promoted runtime status (file-only, no engine load, no subprocess) and fails\n98: // closed to a single 'unavailable' line so the status tool never throws.\n99: function compiledRoutingStatusLines() {\n100:   try {\n101:     const statusPath = resolveCompiledRouteStatusModule();\n102:     const { computeAllStatus } = pluginRequire(statusPath);\n103:     const rows = computeAllStatus({ probeEngine: false });\n104:     const served = rows.filter((r) => r.servingAuthority === 'compiled').length;\n105:     const broken = rows.filter((r) => r.causeCode === 'engine-throw').length;\n106:     const lines = [\n107:       `compiled_routing_hubs=${rows.length}`,\n108:       `compiled_serving=${served}`,\n109:       `compiled_broken=${broken}`,\n110:     ];\n111:     for (const r of rows) lines.push(`compiled_hub_${r.hubId}=${r.servingAuthority}/${r.causeCode}`);\n112:     return lines;\n113:   } catch (err) {\n114:     return [`compiled_routing=unavailable(${err && err.message ? err.message : 'error'})`];\n115:   }\n116: }\n117: \n118: // Stable fingerprint of the current per-hub serving state, consumed from the\n119: // promoted status probe (the single source of serving truth). A manifest flip or\n120: // a kill-switch changes a hub's servingAuthority/causeCode/manifestFingerprint\n121: // here, so folding this into the advisor-brief cache key guarantees a miss and a\n122: // stale compiled brief is never re-served. Fails closed to a stable sentinel so\n123: // the degraded case still caches deterministically.\n124: function compiledServingSignature() {\n125:   try {\n126:     const statusPath = resolveCompiledRouteStatusModule();\n127:     const { computeAllStatus } = pluginRequire(statusPath);\n128:     const rows = computeAllStatus({ probeEngine: false });\n129:     const canonical = rows\n130:       .map((r) => `${r.hubId}:${r.servingAuthority}:${r.causeCode}:${r.manifestFingerprint ?? ''}:${r.effectivePolicyHash ?? ''}`)\n131:       .join('|');\n132:     return createHash('sha256').update(canonical).digest('hex');\n133:   } catch {\n134:     return 'serving-unavailable';\n135:   }\n136: }\n137: \n138: const ADVISOR_CLI_PATH = fileURLToPath(new URL('../bin/skill-advisor.cjs', import.meta.url));\n139: // Cache-signature paths follow the standalone advisor package to ensure\n140: // consistent cache invalidation across CLI and daemon builds. The CLI entry\n141: // belongs in the signature because it is the plugin's only advisor entrypoint.\n142: const ADVISOR_SOURCE_PATHS = [\n143:   ADVISOR_CLI_PATH,\n144:   fileURLToPath(new URL('../bin/system-skill-advisor-launcher.cjs', import.meta.url)),\n145:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/advisor-server.ts', import.meta.url)),\n146:   fileURLToPath(new URL('../skills/system-skill-advisor/runtime/dist/runtime/advisor-server.js', import.meta.url)),\n147: ];\n148: // Relative to the source root the workspace carries, which the signature selects.\n149: const SKILL_ROOT_RELATIVE_PATH = 'skills';\n150: const ADVISOR_ROOT_RELATIVE_PATH = join(SKILL_ROOT_RELATIVE_PATH, 'system-skill-advisor', 'runtime');\n151: const ADVISOR_JSON_RELATIVE_PATH = join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill-graph.json');\n152: const ADVISOR_SCRIPT_RELATIVE_PATHS = [\n153:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor.py'),\n154:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_advisor_runtime.py'),\n155:   join(ADVISOR_ROOT_RELATIVE_PATH, 'scripts', 'skill_graph_compiler.py'),\n156: ];\n157: const SHADOW_RENDERER_URL = new URL(\n158:   '../skills/system-skill-advisor/runtime/dist/runtime/lib/render.js',\n159:   import.meta.url,\n160: );\n161: let shadowRendererPromise;\n162: \n163: function loadShadowRenderer() {\n164:   shadowRendererPromise ??= import(SHADOW_RENDERER_URL).catch(() => null);\n165:   return shadowRendererPromise;\n166: }\n167: \n168: async function loadConfig() {\n169:   const path = join(homedir(), '.config', 'opencode', 'plugin', 'system-skill-advisor.json');\n170:   try {\n171:     const raw = await readFile(path, 'utf-8');\n172:     const parsed = JSON.parse(raw);\n173:     if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n174:       return { values: {}, status: 'error', errorCode: 'CONFIG_PARSE_ERROR' };\n175:     }\n176:     return { values: parsed, status: 'loaded', errorCode: null };\n177:   } catch (error) {\n178:     if (error?.code === 'ENOENT') {\n179:       return { values: {}, status: 'absent', errorCode: null };\n180:     }\n181:     return {\n182:       values: {},\n183:       status: 'error',\n184:       errorCode: error instanceof SyntaxError ? 'CONFIG_PARSE_ERROR' : 'CONFIG_READ_ERROR',\n185:     };\n186:   }\n187: }\n188: \n189: const configPromise = loadConfig();\n190: \n191: // ─────────────────────────────────────────────────────────────────────────────\n192: // 3. PURE UTILITIES\n193: // ─────────────────────────────────────────────────────────────────────────────\n194: \n195: function normalizePositiveInt(value, fallback) {\n196:   return Number.isFinite(value) && value > 0 ? Math.trunc(value) : fallback;\n197: }\n198: \n199: function normalizeThreshold(value) {\n200:   if (!Number.isFinite(value)) {\n201:     return DEFAULT_THRESHOLD_CONFIDENCE;\n202:   }\n203:   return Math.min(1, Math.max(0, Number(value)));\n204: }\n205: \n206: function envDisablesPlugin() {\n207:   return !isHookEnabled('skill-advisor');\n208: }\n209: \n210: function isDirectiveLifecycleDedupEnabled() {\n211:   const value = process.env[DIRECTIVE_LIFECYCLE_DEDUP_ENV]?.trim().toLowerCase();\n212:   return value !== '0' && value !== 'false' && value !== 'off' && value !== 'no';\n213: }\n214: \n215: function splitDirectiveBrief(context) {\n216:   const index = context.indexOf(DIRECTIVE_SEPARATOR);\n217:   // index <= 0 means no directive block or no non-empty head before it.\n218:   if (index <= 0) return null;\n219:   return { head: context.slice(0, index), directives: context.slice(index) };\n220: }\n221: \n222: /** Reduce policy only for one primitive, non-conflicting session identity. */\n223: function decideOpenCodeDirectiveLifecycle(brief, identity, lifecycleEvent, state) {\n224:   if (!isDirectiveLifecycleDedupEnabled() || !identity.confirmed) {\n225:     return { suppressed: false, reduced: null };\n226:   }\n227:   const parts = splitDirectiveBrief(brief);\n228:   if (!parts?.head.trim()) return { suppressed: false, reduced: null };\n229: \n230:   const sessionID = identity.sessionID;\n231:   const generation = state.directiveGeneration;\n232:   const epoch = state.directiveEpochBySession.get(sessionID) ?? 0;\n233:   const boundary = lifecycleEvent === 'startup'\n234:     || lifecycleEvent === 'resume'\n235:     || lifecycleEvent === 'compact';\n236:   const last = state.directiveDedupBySession.get(sessionID);\n237:   if (boundary\n238:     || !last\n239:     || last.directives !== parts.directives\n240:     || last.generation !== generation\n241:     || last.epoch !== epoch) {\n242:     while (state.directiveDedupBySession.size >= MAX_DIRECTIVE_DEDUP_SESSIONS) {\n243:       const oldest = state.directiveDedupBySession.keys().next().value;\n244:       if (typeof oldest !== 'string') break;\n245:       state.directiveDedupBySession.delete(oldest);\n246:     }\n247:     state.directiveDedupBySession.set(sessionID, {\n248:       directives: parts.directives,\n249:       generation,\n250:       epoch,\n251:     });\n252:     return { suppressed: false, reduced: null };\n253:   }\n254:   return { suppressed: true, reduced: parts.head };\n255: }\n256: \n257: function disabledEnvName() {\n258:   if (process.env[DISABLED_ENV] === '1') {\n259:     return DISABLED_ENV;\n260:   }\n261:   if (process.env[DISABLED_ENV_PLUGIN] === '1') {\n262:     return DISABLED_ENV_PLUGIN;\n263:   }\n264:   if (process.env[LEGACY_HOOK_DISABLED_ENV] === '1') {\n265:     return LEGACY_HOOK_DISABLED_ENV;\n266:   }\n267:   if (process.env[LEGACY_PLUGIN_DISABLED_ENV] === '1') {\n268:     return LEGACY_PLUGIN_DISABLED_ENV;\n269:   }\n270:   return null;\n271: }\n272: \n273: // The signature runs on every advisor lookup, so the digest of a file whose\n274: // identity is unchanged is reused instead of read and hashed again. A difference\n275: // in mtimeMs, ctimeMs, size or ino falls back to the read, and a stat or read\n276: // failure stays missing.\n277: const fileDigestCache = new Map();\n278: \n279: function fileDigest(sourcePath, stat) {\n280:   const cached = fileDigestCache.get(sourcePath);\n281:   if (cached\n282:     && cached.mtimeMs === stat.mtimeMs\n283:     && cached.ctimeMs === stat.ctimeMs\n284:     && cached.size === stat.size\n285:     && cached.ino === stat.ino) {\n286:     return cached.digest;\n287:   }\n288:   const digest = createHash('sha256').update(readFileSync(sourcePath)).digest('hex');\n289:   fileDigestCache.set(sourcePath, {\n290:     mtimeMs: stat.mtimeMs,\n291:     ctimeMs: stat.ctimeMs,\n292:     size: stat.size,\n293:     ino: stat.ino,\n294:     digest,\n295:   });\n296:   return digest;\n297: }\n298: \n299: function addFileSignature(hash, label, sourcePath) {\n300:   try {\n301:     const stat = statSync(sourcePath);\n302:     if (!stat.isFile()) {\n303:       throw new Error('not a file');\n304:     }\n305:     hash.update(label);\n306:     hash.update('\\u001f');\n307:     hash.update(sourcePath);\n308:     hash.update('\\u001f');\n309:     hash.update(String(stat.mtimeMs));\n310:     hash.update('\\u001f');\n311:     hash.update(String(stat.size));\n312:     hash.update('\\u001f');\n313:     hash.update(fileDigest(sourcePath, stat));\n314:     hash.update('\\u001e');\n315:   } catch {\n316:     hash.update(label);\n317:     hash.update('\\u001fmissing\\u001e');\n318:   }\n319: }\n320: \n321: function advisorSourceSignature(workspaceRoot) {\n322:   // Hashing the skills under a source-root name the workspace lacks records the same\n323:   // absent marker on every call, so cached advice would outlive any change to them. With\n324:   // no source root the signature is refused, and a refused signature is never cached.\n325:   // The workspace may be any directory inside the checkout, so the source root is found\n326:   // from the repository root above it.\n327:   const sourceRoot = findSourceRoot(findRepoRoot(workspaceRoot));\n328:   if (!sourceRoot) throw new Error(`no source root under ${workspaceRoot}`);\n329:   const hash = createHash('sha256');\n330:   for (const sourcePath of ADVISOR_SOURCE_PATHS) {\n331:     addFileSignature(hash, `implementation:${sourcePath}`, sourcePath);\n332:   }\n333: \n334:   const skillRoot = join(sourceRoot, SKILL_ROOT_RELATIVE_PATH);\n335:   try {\n336:     const skillSlugs = readdirSync(skillRoot, { withFileTypes: true })\n337:       .filter((entry) => entry.isDirectory() && !entry.name.startsWith('.'))\n338:       .map((entry) => entry.name)\n339:       .sort((left, right) => left.localeCompare(right));\n340:     for (const skillSlug of skillSlugs) {\n341:       const skillDir = join(skillRoot, skillSlug);\n342:       addFileSignature(hash, `skill:${skillSlug}:SKILL.md`, join(skillDir, 'SKILL.md'));\n343:       addFileSignature(hash, `skill:${skillSlug}:graph-metadata.json`, join(skillDir, 'graph-metadata.json'));\n344:       // ROUTER.md is optional, so a skill without one keeps the signature it had\n345:       // before this probe existed; only a skill that carries the file adds a part.\n346:       const routerMdPath = join(skillDir, 'ROUTER.md');\n347:       if (existsSync(routerMdPath)) {\n348:         addFileSignature(hash, `skill:${skillSlug}:ROUTER.md`, routerMdPath);\n349:       }\n350:     }\n351:   } catch {\n352:     hash.update(`${SKILL_ROOT_RELATIVE_PATH}\\u001fmissing\\u001e`);\n353:   }\n354: \n355:   for (const relativePath of ADVISOR_SCRIPT_RELATIVE_PATHS) {\n356:     addFileSignature(hash, relativePath, join(sourceRoot, relativePath));\n357:   }\n358:   const dbDir = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR\n359:     ?? join(sourceRoot, ADVISOR_ROOT_RELATIVE_PATH, 'database');\n360:   addFileSignature(hash, 'skill-graph.sqlite', join(dbDir, 'skill-graph.sqlite'));\n361:   addFileSignature(hash, ADVISOR_JSON_RELATIVE_PATH, join(sourceRoot, ADVISOR_JSON_RELATIVE_PATH));\n362:   return hash.digest('hex');\n363: }\n364: \n365: function normalizeOptions(rawOptions) {\n366:   const options = rawOptions && typeof rawOptions === 'object' ? rawOptions : {};\n367:   const configuredTtl = options.cacheTTLMs ?? options.cacheTtlMs;\n368:   const enabled = options.enabled !== false && !envDisablesPlugin();\n369:   const configuredTransformDedup = typeof options.deduplicateTransforms === 'boolean'\n370:     ? options.deduplicateTransforms\n371:     : undefined;\n372: \n373:   const envCacheTTLMs = Number(process.env.SYSTEM_SKILL_ADVISOR_CACHE_TTL_MS);\n374:   const envThreshold = Number(process.env.SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE);\n375:   const envMaxTokens = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_TOKENS);\n376:   const envBridgeTimeoutMs = Number(process.env.SYSTEM_SKILL_ADVISOR_BRIDGE_TIMEOUT_MS);\n377:   const envMaxPromptBytes = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_PROMPT_BYTES);\n378:   const envMaxBriefChars = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_BRIEF_CHARS);\n379:   const envMaxCacheEntries = Number(process.env.SYSTEM_SKILL_ADVISOR_MAX_CACHE_ENTRIES);\n380:   const configuredBounding = typeof options.boundedCompiledRouteSummary === 'boolean'\n381:     ? options.boundedCompiledRouteSummary\n382:     : undefined;\n383: \n384:   return {\n385:     enabled,\n386:     cacheTTLMs: normalizePositiveInt(configuredTtl, normalizePositiveInt(envCacheTTLMs, DEFAULT_CACHE_TTL_MS)),\n387:     thresholdConfidence: normalizeThreshold(options.thresholdConfidence ?? (Number.isFinite(envThreshold) ? envThreshold : undefined)),\n388:     maxTokens: normalizePositiveInt(options.maxTokens, normalizePositiveInt(envMaxTokens, DEFAULT_MAX_TOKENS)),\n389:     nodeBinary: typeof options.nodeBinaryOverride === 'string' && options.nodeBinaryOverride.trim()\n390:       ? options.nodeBinaryOverride.trim()\n391:       : (process.env.SYSTEM_SKILL_ADVISOR_NODE_BINARY || process.env.SPEC_KIT_PLUGIN_NODE_BINARY || DEFAULT_NODE_BINARY),\n392:     bridgeTimeoutMs: normalizePositiveInt(options.bridgeTimeoutMs, normalizePositiveInt(envBridgeTimeoutMs, DEFAULT_BRIDGE_TIMEOUT_MS)),\n393:     maxPromptBytes: normalizePositiveInt(options.maxPromptBytes, normalizePositiveInt(envMaxPromptBytes, DEFAULT_MAX_PROMPT_BYTES)),\n394:     maxBriefChars: normalizePositiveInt(options.maxBriefChars, normalizePositiveInt(envMaxBriefChars, DEFAULT_MAX_BRIEF_CHARS)),\n395:     maxCacheEntries: normalizePositiveInt(options.maxCacheEntries, normalizePositiveInt(envMaxCacheEntries, DEFAULT_MAX_CACHE_ENTRIES)),\n396:     boundedCompiledRouteSummary: configuredBounding ?? process.env[COMPILED_ROUTE_BOUNDING_ENV] === '1',\n397:     deduplicateTransforms: configuredTransformDedup\n398:       ?? process.env[messageIdentity.OPENCODE_TRANSFORM_DEDUP_ENV] === '1',\n399:     sourceSignatureOverride: typeof options.sourceSignatureOverride === 'string'\n400:       ? options.sourceSignatureOverride\n401:       : null,\n402:     sourceSignatureProvider: typeof options.sourceSignatureProvider === 'function'\n403:       ? options.sourceSignatureProvider\n404:       : advisorSourceSignature,\n405:     spawnAdvisor: typeof options.spawnOverride === 'function' ? options.spawnOverride : spawn,\n406:   };\n407: }\n408: \n409: function sessionIdFrom(input) {\n410:   if (!input || typeof input !== 'object') {\n411:     return '__global__';\n412:   }\n413:   return normalizeSessionID(input.sessionID\n414:     || input.sessionId\n415:     || input.session?.id\n416:     || input.properties?.sessionID\n417:     || input.properties?.info?.sessionID\n418:     || input.properties?.info?.id\n419:     || '__global__');\n420: }\n421: \n422: function directiveSessionIdentityFrom(input) {\n423:   if (!input || typeof input !== 'object') {\n424:     return { sessionID: '__global__', confirmed: false };\n425:   }\n426:   const candidates = [\n427:     input.sessionID,\n428:     input.sessionId,\n429:     input.session?.id,\n430:     input.properties?.sessionID,\n431:     input.properties?.sessionId,\n432:     input.properties?.info?.sessionID,\n433:     input.properties?.info?.id,\n434:   ].filter((value) => value !== undefined && value !== null && value !== '');\n435:   const primitive = candidates.filter((value) => typeof value === 'string' || typeof value === 'number');\n436:   const normalized = [...new Set(primitive.map((value) => String(value).trim()).filter(Boolean))];\n437:   const ambiguous = candidates.some((value) => typeof value === 'object')\n438:     || input.sessionIdentityAmbiguous === true\n439:     || input.session_identity_ambiguous === true;\n440:   const conflicting = normalized.length !== 1 || primitive.length !== candidates.length;\n441:   const explicitlyRejected = input.sessionIdentityConfirmed === false\n442:     || input.session_identity_confirmed === false;\n443:   return {\n444:     sessionID: normalized.length === 1 ? normalized[0] : '__global__',\n445:     confirmed: normalized[0] !== '__global__'\n446:       && !ambiguous\n447:       && !conflicting\n448:       && !explicitlyRejected,\n449:   };\n450: }\n451: \n452: function advanceOpenCodeDirectiveBoundary(state, input) {\n453:   const identity = directiveSessionIdentityFrom(input);\n454:   if (identity.confirmed) {\n455:     const epoch = state.directiveEpochBySession.get(identity.sessionID) ?? 0;\n456:     state.directiveEpochBySession.set(identity.sessionID, epoch + 1);\n457:     state.directiveDedupBySession.delete(identity.sessionID);\n458:   } else {\n459:     state.directiveGeneration += 1;\n460:     state.directiveDedupBySession.clear();\n461:     state.directiveEpochBySession.clear();\n462:   }\n463:   return identity;\n464: }\n465: \n466: function stableStringify(value) {\n467:   if (!value || typeof value !== 'object') {\n468:     return JSON.stringify(String(value));\n469:   }\n470: \n471:   if (Array.isArray(value)) {\n472:     return `[${value.map((entry) => stableStringify(entry)).join(',')}]`;\n473:   }\n474: \n475:   return `{${Object.keys(value)\n476:     .sort()\n477:     .map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`)\n478:     .join(',')}}`;\n479: }\n480: \n481: function normalizeSessionID(value) {\n482:   if (value === null || value === undefined || value === '') {\n483:     return '__global__';\n484:   }\n485:   if (typeof value === 'object') {\n486:     return stableStringify(value);\n487:   }\n488:   return String(value);\n489: }\n490: \n491: function normalizeWorkspaceRoot(workspaceRoot) {\n492:   if (typeof workspaceRoot === 'string' && workspaceRoot.trim()) {\n493:     return resolvePath(workspaceRoot.trim());\n494:   }\n495:   return resolvePath(process.cwd());\n496: }\n497: \n498: function statusSafeBinary(binary) {\n499:   if (typeof binary === 'string' && (binary.includes('/') || binary.includes('\\\\'))) {\n500:     return '[configured-node]';\n501:   }\n502:   return binary;\n503: }\n504: \n505: function cacheKeyForPrompt(prompt, options, sessionID, sourceSignature, workspaceRoot, servingSignature) {\n506:   const sessionKey = normalizeSessionID(sessionID);\n507:   const promptKey = createHash('sha256')\n508:     .update(prompt)\n509:     .update('\\u001f')\n510:     .update(String(options.thresholdConfidence))\n511:     .update('\\u001f')\n512:     .update(String(options.maxTokens))\n513:     .update('\\u001f')\n514:     .update(sourceSignature)\n515:     .update('\\u001f')\n516:     .update(workspaceRoot)\n517:     .update('\u001f')\n518:     .update(String(servingSignature ?? ''))\n519:     .digest('hex');\n520:   return `${String(sessionKey)}::${promptKey}`;\n521: }\n522: \n523: function extractPrompt(input) {\n524:   if (typeof input === 'string') {\n525:     return input;\n526:   }\n527:   if (!input || typeof input !== 'object') {\n528:     return null;\n529:   }\n530: \n531:   const candidates = [\n532:     input.prompt,\n533:     input.text,\n534:     input.userPrompt,\n535:     input.message,\n536:     input.input,\n537:     input.properties?.prompt,\n538:     input.properties?.message,\n539:     input.request?.prompt,\n540:     input.request?.message,\n541:   ];\n542: \n543:   for (const candidate of candidates) {\n544:     if (typeof candidate === 'string' && candidate.trim()) {\n545:       return candidate;\n546:     }\n547:     if (candidate && typeof candidate === 'object') {\n548:       const content = candidate.content ?? candidate.text;\n549:       if (typeof content === 'string' && content.trim()) {\n550:         return content;\n551:       }\n552:     }\n553:   }\n554: \n555:   return null;\n556: }\n557: \n558: function cliRecommendations(data, options) {\n559:   if (!Array.isArray(data?.recommendations)) {\n560:     return [];\n561:   }\n562:   return data.recommendations\n563:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n564:     .map((recommendation) => {\n565:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n566:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n567:       return {\n568:         skill: recommendation.skillId,\n569:         confidence,\n570:         uncertainty,\n571:         // The CLI's public recommendations carry no verdict field, so the caller\n572:         // decides it from the same thresholds the renderer enforces.\n573:         passes_threshold: confidence >= options.thresholdConfidence\n574:           && uncertainty <= DEFAULT_THRESHOLD_UNCERTAINTY,\n575:         ...(Array.isArray(recommendation.ambiguousWith)\n576:           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n577:           : {}),\n578:         // The renderer prints a command, its policy and its owner only from these\n579:         // fields. A skill row such as sk-doc has no generated command row to refill\n580:         // them, so a dropped field hides the command the advisor attached.\n581:         ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n582:         ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n583:         ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n584:         ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n585:       };\n586:     });\n587: }\n588: \n589: // Compact the served compiled decision the advisor attached to a recommendation.\n590: // Returns null when no recommendation carried a route, which keeps the injected\n591: // context byte-identical to the legacy brief.\n592: function compiledRouteSummary(data) {\n593:   if (!Array.isArray(data?.recommendations)) return null;\n594:   for (const recommendation of data.recommendations) {\n595:     const route = recommendation?.compiledRoute;\n596:     if (!route || typeof route !== 'object' || typeof route.action !== 'string') continue;\n597:     return {\n598:       outcome: route.action,\n599:       hubId: typeof route.hubId === 'string' ? route.hubId : null,\n600:       targets: Array.isArray(route.targets) ? route.targets.filter((target) => typeof target === 'string') : [],\n601:       servingAuthority: 'compiled',\n602:     };\n603:   }\n604:   return null;\n605: }\n606: \n607: /**\n608:  * Parse the advisor CLI's stdout and render its brief.\n609:  *\n610:  * @param {string} stdout - Raw CLI stdout text\n611:  * @param {Object} options - Normalized plugin options\n612:  * @returns {Promise<Object>} Response with `brief`, `status`, and `metadata`\n613:  */\n614: async function parseCliResponse(stdout, options) {\n615:   if (!stdout.trim()) {\n616:     return { brief: null, status: 'fail_open', error: 'EMPTY_STDOUT', metadata: {} };\n617:   }\n618: \n619:   let parsed;\n620:   try {\n621:     parsed = JSON.parse(stdout.trim());\n622:   } catch {\n623:     return { brief: null, status: 'fail_open', error: 'PARSE_FAIL', metadata: {} };\n624:   }\n625: \n626:   const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : null;\n627:   if (parsed?.status !== 'ok' || !data) {\n628:     return { brief: null, status: 'fail_open', error: 'UNEXPECTED_PAYLOAD', metadata: {} };\n629:   }\n630: \n631:   const recommendations = cliRecommendations(data, options);\n632:   const top = recommendations[0] ?? null;\n633:   // The CLI reports no freshness when it answered from the local scorer instead\n634:   // of the daemon; 'stale' keeps that brief renderable and honest.\n635:   const freshness = data.freshness === 'live' || data.freshness === 'stale'\n636:     ? data.freshness\n637:     : (parsed.degraded === true ? 'stale' : 'unavailable');\n638:   const tokenCap = data.ambiguous === true ? AMBIGUOUS_TOKEN_CAP : options.maxTokens;\n639:   const renderer = freshness === 'unavailable' ? null : await loadShadowRenderer();\n640:   const renderBrief = typeof renderer?.renderAdvisorBrief === 'function' ? renderer.renderAdvisorBrief : null;\n641:   const rendered = renderBrief\n642:     ? renderBrief({\n643:       status: 'ok',\n644:       freshness,\n645:       recommendations,\n646:       ambiguous: data.ambiguous === true,\n647:       metrics: { tokenCap },\n648:       sharedPayload: { metadata: { skillLabel: top?.skill ?? null } },\n649:     }, {\n650:       tokenCap,\n651:       thresholdConfig: {\n652:         confidenceThreshold: options.thresholdConfidence,\n653:         uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n654:       },\n655:     })\n656:     : null;\n657:   const brief = typeof rendered === 'string' && rendered.trim() ? rendered : null;\n658:   const routeSummary = compiledRouteSummary(data);\n659: \n660:   return {\n661:     brief,\n662:     status: brief ? 'ok' : 'skipped',\n663:     metadata: {\n664:       route: parsed.degraded === true ? 'cli-local-scorer' : 'cli',\n665:       freshness,\n666:       recommendationCount: recommendations.length,\n667:       tokenCap,\n668:       skillLabel: top?.skill ?? null,\n669:       cacheHit: Boolean(data.cache?.hit),\n670:       ...(routeSummary ? { compiledRouteSummary: routeSummary } : {}),\n671:     },\n672:   };\n673: }\n674: \n675: // ─────────────────────────────────────────────────────────────────────────────\n676: // 4. SIZE-CAP HELPERS\n677: // ─────────────────────────────────────────────────────────────────────────────\n678: \n679: /**\n680:  * Clamp advisor brief text by JavaScript character count.\n681:  *\n682:  * @param {string} brief - Advisor brief text to clamp\n683:  * @param {number} maxChars - Maximum character count to retain\n684:  * @returns {string} Original brief or truncated prefix within the limit\n685:  */\n686: function clampBrief(brief, maxChars) {\n687:   if (typeof brief !== 'string' || brief.length <= maxChars) {\n688:     return brief;\n689:   }\n690:   return brief.slice(0, maxChars);\n691: }\n692: \n693: /**\n694:  * Insert a cache value and evict oldest entries by insertion order.\n695:  *\n696:  * @param {Map<string, Object>} cache - Cache map using insertion order as LRU state\n697:  * @param {string} key - Cache key to insert or refresh\n698:  * @param {Object} value - Cache value to store\n699:  * @param {number} maxEntries - Maximum entries retained after insertion\n700:  * @returns {void}\n701:  */\n702: function insertWithEviction(cache, key, value, maxEntries) {\n703:   cache.set(key, value);\n704:   while (cache.size > maxEntries) {\n705:     const oldest = cache.keys().next().value;\n706:     cache.delete(oldest);\n707:   }\n708: }\n709: \n710: // The advisor CLI reads its request from stdin (`--json -`), so the prompt never\n711: // appears in argv, which any local user can read from the process table.\n712: function advisorCliArgs() {\n713:   return [ADVISOR_CLI_PATH, 'advisor_recommend', '--json', '-', '--format', 'json'];\n714: }\n715: \n716: // Build the stdin request, or null when the byte budget cannot hold even one prompt\n717: // character beside the request's fixed part. The prompt keeps at most\n718: // ADVISOR_PROMPT_MAX_CHARS characters and is clamped by its escaped size, because JSON\n719: // writes a quote or newline as two bytes and a control character as six.\n720: // The hub's own `.skilled` directory, resolved once. The plugin loads from `.opencode/plugins`,\n721: // one level below the repository root.\n722: let hubSkilledRoot;\n723: function resolveHubSkilledRoot() {\n724:   if (hubSkilledRoot === undefined) {\n725:     try {\n726:       hubSkilledRoot = realpathSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '.skilled'));\n727:     } catch {\n728:       hubSkilledRoot = null;\n729:     }\n730:   }\n731:   return hubSkilledRoot;\n732: }\n733: \n734: // The sk-code surfaces declared for detection, in the order detection tries them:\n735: // every specific surface first, the hub registry's in registry order and then those\n736: // of outside skills whose graph-metadata.json names the sk-code family, by skill_id,\n737: // and the hub's one fallback last. An outside block that claims the fallback role is\n738: // ignored, because the fallback is the hub's own code.\n739: const SK_CODE_HUB = 'sk-code';\n740: const EXTENSION_MARKER = /^\\.[a-z0-9]+$/i;\n741: \n742: function readJsonFile(file) {\n743:   try {\n744:     const value = JSON.parse(readFileSync(file, 'utf8'));\n745:     return value && typeof value === 'object' ? value : null;\n746:   } catch {\n747:     return null;\n748:   }\n749: }\n750: \n751: // A block with no marker of any kind declares no surface, as the hub reader drops it too, so the\n752: // two readers list the same surfaces. Only path and file markers are kept for matching here.\n753: function surfaceEntry(block) {\n754:   if (!block || typeof block !== 'object' || typeof block.label !== 'string' || !block.label.trim()) return null;\n755:   const markerList = (list) => (Array.isArray(list) ? list : [])\n756:     .filter((marker) => typeof marker === 'string' && marker.length > 0);\n757:   const markers = [block.pathMarkers, block.fileMarkers].flatMap(markerList);\n758:   if (markers.length === 0 && markerList(block.contentMarkers).length === 0) return null;\n759:   return { label: block.label.toUpperCase(), role: block.role, markers };\n760: }\n761: \n762: // The trusted-root rule for a private link lives in the advisor runtime as plain\n763: // CommonJS, so both skills-root readers apply one copy of it on every supported Node\n764: // version. When the module cannot load, the check rejects every link, which keeps an\n765: // unverified target out of detection, and one stderr line records the lost rule.\n766: let privateSkillTarget;\n767: function loadPrivateSkillTarget() {\n768:   if (privateSkillTarget === undefined) {\n769:     try {\n770:       const hubRoot = resolveHubSkilledRoot();\n771:       privateSkillTarget = hubRoot\n772:         ? pluginRequire(join(hubRoot, ADVISOR_ROOT_RELATIVE_PATH, 'lib', 'private-skill-target.cjs'))\n773:         : null;\n774:     } catch (error) {\n775:       privateSkillTarget = null;\n776:       process.stderr.write(`[${PLUGIN_ID}] private-skill trusted-root rule failed to load, so every local-* link is skipped: ${error.message}\\n`);\n777:     }\n778:   }\n779:   return privateSkillTarget;\n780: }\n781: \n782: function privateSkillLinkCheck(skillsDir) {\n783:   const lib = loadPrivateSkillTarget();\n784:   return lib && typeof lib.createPrivateSkillLinkCheck === 'function'\n785:     ? lib.createPrivateSkillLinkCheck(skillsDir)\n786:     : () => false;\n787: }\n788: \n789: function declaredSurfaces(hubRoot) {\n790:   const skillsDir = join(hubRoot, 'skills');\n791:   const registry = readJsonFile(join(skillsDir, SK_CODE_HUB, 'mode-registry.json'));\n792:   const hub = (registry && Array.isArray(registry.modes) ? registry.modes : [])\n793:     .map((mode) => surfaceEntry(mode && mode.surfaceDetection))\n794:     .filter(Boolean);\n795:   const outside = [];\n796:   let entries = [];\n797:   try {\n798:     entries = readdirSync(skillsDir, { withFileTypes: true });\n799:   } catch {\n800:     entries = [];\n801:   }\n802:   // A skill is a real directory, or a `local-*` link whose real target the advisor's\n803:   // trusted-root rule accepts. Any other link is skipped, as the replay library skips it.\n804:   let isTrustedLink = null;\n805:   for (const dirent of entries) {\n806:     const name = dirent.name;\n807:     if (!dirent.isDirectory()) {\n808:       if (!name.startsWith('local-') || !dirent.isSymbolicLink()) continue;\n809:       isTrustedLink = isTrustedLink || privateSkillLinkCheck(skillsDir);\n810:       if (!isTrustedLink(join(skillsDir, name))) continue;\n811:     }\n812:     const meta = readJsonFile(join(skillsDir, name, 'graph-metadata.json'));\n813:     if (!meta || meta.family !== SK_CODE_HUB || meta.skill_id === SK_CODE_HUB) continue;\n814:     const entry = surfaceEntry(meta.surface_detection);\n815:     if (entry && entry.role === 'specific') outside.push({ ...entry, skillId: String(meta.skill_id || name) });\n816:   }\n817:   outside.sort((a, b) => (a.skillId < b.skillId ? -1 : a.skillId > b.skillId ? 1 : 0));\n818:   return [\n819:     ...hub.filter((entry) => entry.role === 'specific'),\n820:     ...outside,\n821:     ...hub.filter((entry) => entry.role === 'fallback'),\n822:   ];\n823: }\n824: \n825: // A specific surface matches when the resolved workspace holds one of its path or\n826: // file markers, or sits inside a folder a path marker names. Extension and content\n827: // markers need the files a task touches, which a workspace check does not have.\n828: function workspaceHasMarker(real, entry) {\n829:   return entry.markers.some((marker) => {\n830:     if (EXTENSION_MARKER.test(marker)) return false;\n831:     const rel = marker.replace(/\\/+$/, '');\n832:     if (!rel) return false;\n833:     return existsSync(join(real, rel)) || `${real}${sep}`.includes(`${sep}${rel.split('/').join(sep)}${sep}`);\n834:   });\n835: }\n836: \n837: // The sk-code surface a session works in, read from its workspace. A specific\n838: // surface whose markers the workspace holds wins, so a surface another repository\n839: // adds always leads the hub's own. The fallback holds only when the resolved\n840: // workspace lies inside the hub's own .skilled directory, so a symlinked local\n841: // skill or a .skilled folder in another repository is never read as hub code. Any\n842: // other workspace sends no hint, so the compiled tie-break order applies. The\n843: // result is cached per workspace because the check runs before every uncached\n844: // advisor call.\n845: const workspaceSurfaceCache = new Map();\n846: function detectWorkspaceSurface(projectDir) {\n847:   if (typeof projectDir !== 'string' || projectDir.length === 0) return null;\n848:   if (workspaceSurfaceCache.has(projectDir)) return workspaceSurfaceCache.get(projectDir);\n849:   let surface = null;\n850:   try {\n851:     const real = realpathSync(projectDir);\n852:     const hubRoot = resolveHubSkilledRoot();\n853:     const insideHub = Boolean(hubRoot) && (real === hubRoot || real.startsWith(`${hubRoot}${sep}`));\n854:     const match = hubRoot\n855:       ? declaredSurfaces(hubRoot).find((entry) => (\n856:         entry.role === 'fallback' ? insideHub : workspaceHasMarker(real, entry)\n857:       ))\n858:       : null;\n859:     surface = match ? match.label : null;\n860:   } catch {\n861:     surface = null;\n862:   }\n863:   workspaceSurfaceCache.set(projectDir, surface);\n864:   return surface;\n865: }\n866: \n867: function advisorCliRequest({ prompt, options, surfaceHint = null }) {\n868:   const requestOptions = {\n869:     // Three recommendations keep the two-target ambiguity line available without\n870:     // asking the advisor for a longer list than the brief can use.\n871:     topK: 3,\n872:     includeAttribution: false,\n873:     includeAbstainReasons: true,\n874:     confidenceThreshold: options.thresholdConfidence,\n875:     uncertaintyThreshold: DEFAULT_THRESHOLD_UNCERTAINTY,\n876:     ...(surfaceHint ? { surfaceHint } : {}),\n877:   };\n878:   const request = (text) => JSON.stringify({ prompt: text, options: requestOptions });\n879:   let remaining = options.maxPromptBytes - Buffer.byteLength(request(''), 'utf8');\n880:   let end = 0;\n881:   for (const char of prompt.slice(0, ADVISOR_PROMPT_MAX_CHARS)) {\n882:     remaining -= Buffer.byteLength(JSON.stringify(char), 'utf8') - 2;\n883:     if (remaining < 0) break;\n884:     end += char.length;\n885:   }\n886:   return end > 0 ? request(prompt.slice(0, end)) : null;\n887: }\n888: \n889: // ─────────────────────────────────────────────────────────────────────────────\n890: // 5. EVENT HELPERS\n891: // ─────────────────────────────────────────────────────────────────────────────\n892: \n893: function eventPayloadFrom(event) {\n894:   if (event?.payload && typeof event.payload === 'object') {\n895:     return event.payload;\n896:   }\n897:   return event;\n898: }\n899: \n900: function eventTypeFrom(event) {\n901:   const payload = eventPayloadFrom(event);\n902:   return typeof payload?.type === 'string' ? payload.type : null;\n903: }\n904: \n905: function lifecycleEventFrom(input, eventType = null) {\n906:   const candidates = [\n907:     input?.lifecycleEvent,\n908:     input?.lifecycle_event,\n909:     input?.lifecycleSource,\n910:     input?.lifecycle_source,\n911:     input?.source,\n912:     input?.properties?.source,\n913:   ];\n914:   for (const candidate of candidates) {\n915:     if (candidate === 'startup' || candidate === 'resume' || candidate === 'compact') {\n916:       return candidate;\n917:     }\n918:   }\n919:   if (eventType === 'session.created') return 'startup';\n920:   if (eventType === 'session.resumed') return 'resume';\n921:   if (eventType === 'session.compacted' || eventType === 'session.compact') return 'compact';\n922:   return undefined;\n923: }\n924: \n925: function rawSessionValueFrom(input) {\n926:   return input?.sessionID\n927:     ?? input?.sessionId\n928:     ?? input?.session?.id\n929:     ?? input?.properties?.sessionID\n930:     ?? input?.properties?.sessionId;\n931: }\n932: \n933: function shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed) {\n934:   const rawSession = rawSessionValueFrom(input);\n935:   const ambiguous = Boolean(\n936:     input?.sessionIdentityAmbiguous\n937:       || input?.session_identity_ambiguous\n938:       || (rawSession && typeof rawSession === 'object'),\n939:   );\n940:   const explicitConfirmation = input?.sessionIdentityConfirmed\n941:     ?? input?.session_identity_confirmed;\n942:   const sessionKnown = sessionID !== '__global__'\n943:     && !ambiguous\n944:     && explicitConfirmation !== false;\n945:   return {\n946:     sessionId: sessionKnown ? sessionID : undefined,\n947:     sessionIdentityConfirmed: sessionKnown,\n948:     sessionIdentityAmbiguous: ambiguous,\n949:     lifecycleEvent,\n950:     scopeChanged: input?.scopeChanged === true || input?.scope_changed === true,\n951:     policySetChanged: input?.policySetChanged === true || input?.policy_set_changed === true,\n952:     goalChanged: input?.goalChanged === true || input?.goal_changed === true,\n953:     deliveryConfirmed,\n954:   };\n955: }\n956: \n957: async function observeShadowDeliveryForRuntime(\n958:   rendered,\n959:   input,\n960:   sessionID,\n961:   lifecycleEvent,\n962:   deliveryConfirmed = false,\n963: ) {\n964:   try {\n965:     const renderer = await loadShadowRenderer();\n966:     if (typeof renderer?.observeShadowDelivery !== 'function') return;\n967:     renderer.observeShadowDelivery(\n968:       typeof rendered === 'string' ? rendered : null,\n969:       shadowDeliveryStateFor(input, sessionID, lifecycleEvent, deliveryConfirmed),\n970:     );\n971:   } catch {\n972:     // Shadow planning must never alter the active OpenCode transform.\n973:   }\n974: }\n975: \n976: async function observeEmittedAdvisorBlock(\n977:   rendered,\n978:   input,\n979:   sessionID,\n980:   lifecycleEvent,\n981: ) {\n982:   try {\n983:     const renderer = await loadShadowRenderer();\n984:     if (typeof renderer?.observeEmittedAdvisorPolicy !== 'function') return;\n985:     renderer.observeEmittedAdvisorPolicy(\n986:       typeof rendered === 'string' ? rendered : null,\n987:       {\n988:         ...shadowDeliveryStateFor(input, sessionID, lifecycleEvent, true),\n989:         runtime: 'OpenCode',\n990:         candidate: OBSERVED_ADVISOR_POLICY_CANDIDATE,\n991:       },\n992:     );\n993:   } catch {\n994:     // Host observation must never alter the active OpenCode transform.\n995:   }\n996: }\n997: \n998: function transformContributionDecision(input, options, blockId, content, order) {\n999:   if (!options.deduplicateTransforms) {\n1000:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n1001:   }\n1002:   const identity = messageIdentity.resolveMessageIdentity(input);\n1003:   const contentHash = messageIdentity.hashPolicyBlockContent(blockId, content, order);\n1004:   if (!identity || !contentHash) {\n1005:     return { shouldDeliver: true, identity: null, blockId: null, contentHash: null };\n1006:   }\n1007:   const decision = messageIdentity.recordTransformContribution({\n1008:     identity,\n1009:     blockId,\n1010:     contentHash,\n1011:     transform: PLUGIN_ID,\n1012:   });\n1013:   return {\n1014:     ...decision,\n1015:     identity,\n1016:     blockId,\n1017:     contentHash,\n1018:   };\n1019: }\n1020: \n1021: function commitTransformContribution(decision) {\n1022:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1023:   if (decision.duplicate || decision.shouldDeliver) {\n1024:     messageIdentity.commitTransformDelivery(\n1025:       decision.identity,\n1026:       decision.blockId,\n1027:       decision.contentHash,\n1028:       { transform: PLUGIN_ID },\n1029:     );\n1030:     return;\n1031:   }\n1032:   messageIdentity.releaseTransformReservation(\n1033:     decision.identity,\n1034:     decision.blockId,\n1035:     decision.contentHash,\n1036:   );\n1037: }\n1038: \n1039: function releaseTransformContribution(decision) {\n1040:   if (!decision?.identity || !decision.blockId || !decision.contentHash) return;\n1041:   messageIdentity.releaseTransformReservation(\n1042:     decision.identity,\n1043:     decision.blockId,\n1044:     decision.contentHash,\n1045:   );\n1046: }\n1047: \n1048: function deliverTransformContribution(decision, deliver) {\n1049:   if (!decision?.shouldDeliver) {\n1050:     commitTransformContribution(decision);\n1051:     return;\n1052:   }\n1053:   try {\n1054:     deliver();\n1055:     commitTransformContribution(decision);\n1056:   } catch (error) {\n1057:     releaseTransformContribution(decision);\n1058:     throw error;\n1059:   }\n1060: }\n1061: \n1062: // ─────────────────────────────────────────────────────────────────────────────\n1063: // 6. PLUGIN FACTORY\n1064: // ─────────────────────────────────────────────────────────────────────────────\n1065: \n1066: /**\n1067:  * Create the Spec Kit skill advisor OpenCode plugin hooks.\n1068:  *\n1069:  * @param {import('@opencode-ai/plugin').PluginInput} ctx - OpenCode plugin context\n1070:  * @param {Object} [rawOptions] - Plugin options\n1071:  * @param {boolean} [rawOptions.enabled] - Whether the plugin should inject advisor briefs\n1072:  * @param {number} [rawOptions.cacheTTLMs] - Advisor cache TTL in milliseconds\n1073:  * @param {number} [rawOptions.cacheTtlMs] - Advisor cache TTL alias in milliseconds\n1074:  * @param {number} [rawOptions.thresholdConfidence] - Minimum advisor confidence threshold\n1075:  * @param {number} [rawOptions.maxTokens] - Maximum advisor brief tokens requested from the advisor CLI\n1076:  * @param {string} [rawOptions.nodeBinaryOverride] - Node binary used for the advisor CLI subprocess\n1077:  * @param {number} [rawOptions.bridgeTimeoutMs] - Advisor CLI subprocess timeout in milliseconds\n1078:  * @param {number} [rawOptions.maxPromptBytes] - Maximum UTF-8 bytes of the stdin request sent to the advisor CLI, prompt included\n1079:  * @param {number} [rawOptions.maxBriefChars] - Maximum injected advisor brief characters\n1080:  * @param {number} [rawOptions.maxCacheEntries] - Maximum advisor cache entries\n1081:  * @param {boolean} [rawOptions.boundedCompiledRouteSummary] - Bound long compiled-route target lists\n1082:  * @param {boolean} [rawOptions.deduplicateTransforms] - Suppress duplicate same-message system blocks\n1083:  * @param {string} [rawOptions.sourceSignatureOverride] - Test override for advisor source signature\n1084:  * @returns {Promise<Object>} Hooks with `event`, `experimental.chat.system.transform`, and `tool`\n1085:  */\n1086: async function MkSkillAdvisorPlugin(ctx, rawOptions) {\n1087:   const fileConfig = await configPromise;\n1088:   const merged = { ...fileConfig.values, ...rawOptions };\n1089:   const options = normalizeOptions(merged);\n1090:   const projectDir = normalizeWorkspaceRoot(ctx?.directory);\n1091: \n1092:   // Per-instance state so two plugin instances loaded in the same process maintain independent caches/metrics.\n1093:   const state = {\n1094:     advisorCache: new Map(),\n1095:     // In-flight promise dedup: concurrent identical-key requests share one advisor CLI spawn.\n1096:     inFlight: new Map(),\n1097:     // Live advisor CLI runs and the FIFO of callers waiting for a free slot.\n1098:     activeAdvisorRuns: 0,\n1099:     advisorRunWaiters: [],\n1100:     // Per-session record of the constant directive block last delivered in\n1101:     // full, keyed by normalized session id. Cleared on session lifecycle\n1102:     // boundaries (created/resumed/compacted/deleted) so the full block is\n1103:     // re-delivered on the first message after each boundary.\n1104:     directiveDedupBySession: new Map(),\n1105:     directiveEpochBySession: new Map(),\n1106:     directiveGeneration: 0,\n1107:     epoch: 0,\n1108:     runtimeReady: false,\n1109:     lastBridgeStatus: 'uninitialized',\n1110:     lastErrorCode: null,\n1111:     lastDurationMs: 0,\n1112:     bridgeInvocations: 0,\n1113:     cacheHits: 0,\n1114:     cacheMisses: 0,\n1115:     advisorLookups: 0,\n1116:     configStatus: fileConfig.status,\n1117:     configErrorCode: fileConfig.errorCode,\n1118:     disabledReason: !options.enabled\n1119:       ? (disabledEnvName() ?? 'config_enabled_false')\n1120:       : null,\n1121:   };\n1122: \n1123:   function acquireAdvisorRunSlot(sessionID, timeoutMs) {\n1124:     if (state.activeAdvisorRuns < MAX_CONCURRENT_ADVISOR_RUNS) {\n1125:       state.activeAdvisorRuns += 1;\n1126:       return Promise.resolve({ granted: true });\n1127:     }\n1128:     return new Promise((resolve) => {\n1129:       const waiter = {\n1130:         sessionID,\n1131:         // A wall-clock step can move a deadline backwards, so elapsed queue time\n1132:         // must come from a monotonic clock.\n1133:         deadline: performance.now() + timeoutMs,\n1134:         settled: false,\n1135:         timer: null,\n1136:         grant() {\n1137:           if (waiter.settled) {\n1138:             // The deadline already answered this caller, so the slot has to go\n1139:             // to the next waiter instead of disappearing with nobody holding it.\n1140:             releaseAdvisorRunSlot();\n1141:             return;\n1142:           }\n1143:           waiter.settled = true;\n1144:           clearTimeout(waiter.timer);\n1145:           resolve({ granted: true });\n1146:         },\n1147:         deny(error) {\n1148:           if (waiter.settled) {\n1149:             return;\n1150:           }\n1151:           waiter.settled = true;\n1152:           clearTimeout(waiter.timer);\n1153:           const index = state.advisorRunWaiters.indexOf(waiter);\n1154:           if (index !== -1) {\n1155:             state.advisorRunWaiters.splice(index, 1);\n1156:           }\n1157:           resolve({ granted: false, error });\n1158:         },\n1159:       };\n1160:       // Queue time counts against the same budget as the run, or a backlog makes\n1161:       // the host transform wait far past the bridge timeout it was promised.\n1162:       waiter.timer = setTimeout(() => waiter.deny('QUEUE_TIMEOUT'), timeoutMs);\n1163:       waiter.timer.unref?.();\n1164:       state.advisorRunWaiters.push(waiter);\n1165:     });\n1166:   }\n1167: \n1168:   function releaseAdvisorRunSlot() {\n1169:     while (state.advisorRunWaiters.length > 0) {\n1170:       const next = state.advisorRunWaiters.shift();\n1171:       if (next.deadline > performance.now()) {\n1172:         // Hand the slot to the oldest waiter still in time so the live count never dips.\n1173:         next.grant();\n1174:         return;\n1175:       }\n1176:       // A slot can free after a waiter's deadline but before its timer fires, and\n1177:       // granting then would run the overdue lookup with a fresh timeout.\n1178:       next.deny('QUEUE_TIMEOUT');\n1179:     }\n1180:     state.activeAdvisorRuns = Math.max(0, state.activeAdvisorRuns - 1);\n1181:   }\n1182: \n1183:   // A reset must release queued callers, or their host transforms never settle.\n1184:   function cancelAdvisorRunWaiters() {\n1185:     while (state.advisorRunWaiters.length > 0) {\n1186:       state.advisorRunWaiters.shift().deny('RUNTIME_RESET');\n1187:     }\n1188:   }\n1189: \n1190:   // Queued transforms for a deleted session fail open now instead of holding a\n1191:   // queue position until their deadline.\n1192:   function cancelAdvisorRunWaitersForSession(sessionID) {\n1193:     for (const waiter of [...state.advisorRunWaiters]) {\n1194:       if (waiter.sessionID === sessionID) {\n1195:         waiter.deny('SESSION_DELETED');\n1196:       }\n1197:     }\n1198:   }\n1199: \n1200:   /**\n1201:    * Run the advisor CLI and render its JSON response.\n1202:    * The CLI receives the request on stdin from `advisorCliRequest`, returns stdout\n1203:    * JSON parsed by `parseCliResponse`, gets SIGTERM shortly before the deadline,\n1204:    * and gets SIGKILL at the deadline if the process has not settled.\n1205:    *\n1206:    * @param {Object} params - CLI invocation parameters\n1207:    * @param {string} params.projectDir - Working directory for the advisor CLI subprocess\n1208:    * @param {string} params.prompt - Prompt passed to the advisor CLI\n1209:    * @param {string} params.sessionID - Session that owns the queued slot request\n[Output truncated. Continue reading with offset: 1210]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js\"}"},"time":{"start":1794564254508,"end":1794564254861}}}}
