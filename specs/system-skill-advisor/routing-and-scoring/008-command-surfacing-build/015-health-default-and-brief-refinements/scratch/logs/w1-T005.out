es: headValues.length === 0 ? 0 : Math.max(...headValues),\\n  };\\n}\",\"oldString\":\"function summarise(rows) {\\n  const values = rows.map((row) => row.bytes);\\n  return {\\n    rows,\\n    totalBytes: values.reduce((sum, value) => sum + value, 0),\\n    medianBytes: median(values),\\n    maxBytes: values.length === 0 ? 0 : Math.max(...values),\\n  };\\n}\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs\"}"},"time":{"start":1794564593286,"end":1794564595422}}}}
