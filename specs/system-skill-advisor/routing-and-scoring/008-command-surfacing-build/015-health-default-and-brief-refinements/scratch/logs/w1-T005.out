\n+      );\n+      process.exitCode = 2;\n+    } else {\n+      process.stdout.write(`${JSON.stringify(summary)}\\n`);\n+    }\n   } finally {\n     stopSandboxProcesses(socketDir);\n     rmSync(socketDir, { recursive: true, force: true });\n M .skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs\n?? .skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs && git -c core.fsmonitor=false status --short -- .skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs .skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794564630496,"end":1794564631603}}}}
