 \"generation\": 197,\n      \"checkedAt\": \"2026-11-13T10:33:19.059Z\",\n      \"lastLiveAt\": \"2026-11-13T10:28:31.707Z\"\n    },\n    \"generatedAt\": \"2026-11-13T10:33:19.250Z\",\n    \"cache\": {\n      \"hit\": false,\n      \"sourceSignaturePresent\": true\n    },\n    \"_shadow\": {\n      \"model\": \"advisor-shadow-learned-weights-v1\",\n      \"liveWeightsFrozen\": true,\n      \"recommendations\": [\n        {\n          \"skillId\": \"sk-doc\",\n          \"liveScore\": 0.668343,\n          \"shadowScore\": 0.629144,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"Describe the new keys and the refusal in the routing-accuracy README\\\"}' --format json 2>&1 | head -60\"}"},"time":{"start":1794565998235,"end":1794565999477}}}}
