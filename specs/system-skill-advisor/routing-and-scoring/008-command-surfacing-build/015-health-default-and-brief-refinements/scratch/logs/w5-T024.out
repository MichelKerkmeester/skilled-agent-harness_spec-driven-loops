{"type":"tool_use","timestamp":1794566021635,"sessionID":"ses_e2b88d3f9ffe7JDxWguwirnDeF","part":{"partID":"prt_1d4785b15002YaVVr6xMsXn8y3","sessionID":"ses_e2b88d3f9ffe7JDxWguwirnDeF","messageID":"msg_1d4782ce8001NdcUuukvUOKz3r","type":"tool","id":"call_dee0fabdc70149ce8f4bbdec","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs","offset":420,"limit":280},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 420-699\n420:     // a build whose freshness cannot be assessed.\n421:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n422:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n423:     if (freshness.status !== 'fresh') {\n424:       throw new Error(freshness.message);\n425:     }\n426: \n427:     // Real scoring is the only mode that reads this machine, so it is the only one\n428:     // that has to prove the machine can answer before walking the corpus. Without\n429:     // the flag nothing here runs and the prompt embedding is the direct call below.\n430:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n431: \n432:     const commandNames = readCommandFileNames(workspaceRoot);\n433:     const commandSet = new Set(commandNames);\n434:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n435:     const corpus = readCorpus(CORPUS_JSONL);\n436: \n437:     // A label naming a command that does not exist would silently score as a\n438:     // permanent miss, so it fails the capture instead of deflating a metric.\n439:     for (const row of corpus) {\n440:       if (row.expected_command === null || row.expected_command === undefined) continue;\n441:       if (!commandSet.has(row.expected_command)) {\n442:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n443:       }\n444:     }\n445: \n446:     const perCommand = new Map();\n447:     for (const command of commandNames) {\n448:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n449:     }\n450: \n451:     const typed = emptyTally();\n452:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n453:     let falseOfferCount = 0;\n454:     let falseOfferTotal = 0;\n455:     let slashReachedTop3 = 0;\n456:     let slashNamedTotal = 0;\n457:     let slashOfferedOnPartial = 0;\n458:     let slashPartialTotal = 0;\n459:     let agreementCorrect = 0;\n460:     let agreementTotal = 0;\n461:     // Per-row results sit beside the totals because a total can hold still\n462:     // while one row is gained and another lost, and a changed label has to\n463:     // surface under the id of the row it belongs to.\n464:     const rows = {};\n465:     // Attached reach: what a hub's own route adds on the same rows, split the\n466:     // same way, plus the rows that had to stay silent and the ties a bridge\n467:     // leaves with its own owner.\n468:     const attachedRows = {};\n469:     // A typed command reaches the reader through the recommendation that leads,\n470:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n471:     // already landed and `attached` is one delivered by the reader's own typed\n472:     // command. Its resolution follows the recommend handler exactly.\n473:     const typedAttached = emptyAttachedTally();\n474:     const typedRowResults = {};\n475:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n476:     const plainAttachedByFamily = new Map();\n477:     const sameOwnerAmbiguous = [];\n478:     let falseOfferAttached = 0;\n479:     const needsModeRows = [];\n480:     let needsModeFloor = 0;\n481: \n482:     for (const row of corpus) {\n483:       // The recommend path supplies the semantic lane's prompt vector through this\n484:       // wrapper, so a real capture threads the same path rather than scoring with\n485:       // the lane blind. Under the fixture regime the lane derives its own\n486:       // deterministic vector and the direct call is the whole behavior.\n487:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n488:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n489:       const ids = recommendationIds(result);\n490:       const landed = ids.map((id) => commandOf(idToCommand, id));\n491:       const expected = row.expected_command ?? null;\n492:       const top1Hit = expected !== null && landed[0] === expected;\n493:       const top3Hit = expected !== null && landed.includes(expected);\n494:       // True when any of the top three recommendations maps to a command bridge,\n495:       // so this is a reach measure. It is not whether a brief head offered the\n496:       // command, which the behaviour run line records as `offeredCommand`.\n497:       const offered = landed.some((command) => command !== null);\n498:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n499:       // A holdout row's outcome is what the split exists to keep unseen, so\n500:       // only its counts are published.\n501:       const publishRow = row.split !== 'holdout';\n502: \n503:       // A hub can name the slash command its route would take, which is reach a\n504:       // reader otherwise gets only by translating the workflow mode by hand.\n505:       const topId = ids[0];\n506:       const route = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n507:         ? readCompiledRoute(workspaceRoot, topId, row.prompt)\n508:         : undefined;\n509:       const attached = route !== undefined ? attachCommand(topId, route, row.prompt) : undefined;\n510:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n511:       // A typed command is the reader's own wording, so it outranks the hub's\n512:       // route in the delivered command, the same precedence the handler applies.\n513:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n514:       // A head shows that label only when nothing else names a command, so a row\n515:       // counts only when neither the typed command nor the route delivered one. A\n516:       // silent row that carries it shows a label nobody asked for.\n517:       const needsMode = route !== undefined && delivered === undefined && routeNeedsMode(topId, route, extractMetalinguisticSkillMentions(row.prompt));\n518:       // The list names rows with their outcome, so a holdout row stays out of it\n519:       // as it stays out of the row maps.\n520:       if (needsMode && publishRow) needsModeRows.push(row.id);\n521:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n522:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n523: \n524:       if (row.row_type === 'typed') {\n525:         addRow(typed, top1Hit, top3Hit);\n526:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n527:         if (publishRow) {\n528:           typedRowResults[row.id] = {\n529:             expected_command: expected,\n530:             top: ids[0] ?? null,\n531:             carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n532:             command: delivered ?? null,\n533:             policy: deliveredPolicy,\n534:           };\n535:         }\n536:       }\n537:       if (isPlainSplit) {\n538:         addRow(plain[row.split], top1Hit, top3Hit);\n539:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n540:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n541:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n542:       }\n543:       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n544:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n545:         sameOwnerAmbiguous.push(row.id);\n546:       }\n547: \n548:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n549:       if (commandTally) {\n550:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n551:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n552:       }\n553: \n554:       if (publishRow) {\n555:         rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n556:       }\n557: \n558:       const isSlashVariant = row.row_type === 'slash-variant';\n559:       // Silence is the requirement for a near miss, a prompt that must not\n560:       // trigger a command, and a partial slash mention that names no command.\n561:       const wantsSilence = row.row_type === 'must-not-start'\n562:         || row.row_type === 'near-miss'\n563:         || (isSlashVariant && expected === null);\n564:       if (wantsSilence) {\n565:         falseOfferTotal += 1;\n566:         if (offered) falseOfferCount += 1;\n567:         if (attached !== undefined) falseOfferAttached += 1;\n568:         if (needsMode) needsModeFloor += 1;\n569:       }\n570: \n571:       if (isSlashVariant) {\n572:         if (expected === null) {\n573:           slashPartialTotal += 1;\n574:           if (offered) slashOfferedOnPartial += 1;\n575:         } else {\n576:           slashNamedTotal += 1;\n577:           if (top3Hit) slashReachedTop3 += 1;\n578:         }\n579:       }\n580: \n581:       // A bridge offered below a skill is correct when the skill that outranked\n582:       // it is the bridge's own owner: the command stays reachable without the\n583:       // bridge displacing the skill the prompt actually asked for.\n584:       if (!idToCommand.has(ids[0])) {\n585:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n586:         if (laterBridgeId !== undefined) {\n587:           agreementTotal += 1;\n588:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n589:         }\n590:       }\n591:     }\n592: \n593:     const commands = {};\n594:     for (const command of [...perCommand.keys()].sort()) {\n595:       commands[command] = perCommand.get(command);\n596:     }\n597: \n598:     // Row ids are keyed in sorted order so a diff between two captures reads as\n599:     // the rows that changed rather than as reordered output.\n600:     const typedRows = {};\n601:     for (const id of Object.keys(typedRowResults).sort()) {\n602:       typedRows[id] = typedRowResults[id];\n603:     }\n604: \n605:     const reachableCommands = new Set();\n606:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n607:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n608: \n609:     const plainByFamily = {};\n610:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n611:       const family = plainAttachedByFamily.get(namespace);\n612:       plainByFamily[namespace] = {\n613:         tune: attachedTallyJson(family.tune),\n614:         holdout: attachedTallyJson(family.holdout),\n615:       };\n616:     }\n617: \n618:     return {\n619:       schemaVersion: 1,\n620:       capturedAt,\n621:       capturedAtSha: readHeadSha(workspaceRoot),\n622:       corpusSha256: sha256File(CORPUS_JSONL),\n623:       bridgeCounts,\n624:       metrics: {\n625:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n626:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n627:         plain_recall_at_1: {\n628:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n629:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n630:         },\n631:         plain_reach_top3: {\n632:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n633:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n634:         },\n635:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n636:         slash_variant: {\n637:           reached_top3: slashReachedTop3,\n638:           named_total: slashNamedTotal,\n639:           offered_on_partial: slashOfferedOnPartial,\n640:           partial_total: slashPartialTotal,\n641:         },\n642:         agreement: { correct: agreementCorrect, total: agreementTotal },\n643:       },\n644:       unreachable,\n645:       commands,\n646:       rows,\n647:       attachedMetrics: {\n648:         plain: {\n649:           tune: attachedTallyJson(plainAttached.tune),\n650:           holdout: attachedTallyJson(plainAttached.holdout),\n651:         },\n652:         plain_by_family: plainByFamily,\n653:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n654:         typed: attachedTallyJson(typedAttached),\n655:         typedRows,\n656:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n657:         attachedRows,\n658:         needs_mode_floor: { count: needsModeFloor, total: falseOfferTotal },\n659:         needsModeRows: needsModeRows.sort(),\n660:       },\n661:     };\n662:   } finally {\n663:     globalThis.Date = RealDate;\n664:     // Removal comes last, after every read that needs the directory has\n665:     // finished; `force` keeps an already-swept directory from turning a\n666:     // completed capture into a failure.\n667:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n668:   }\n669: }\n670: \n671: // ───────────────────────────────────────────────────────────────────\n672: // 7. CLI ENTRY\n673: // ───────────────────────────────────────────────────────────────────\n674: \n675: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n676:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n677: \n678:   const realEmbedding = process.argv.includes('--real-embedding');\n679:   // The committed baseline has to be reproducible on a clean checkout, so it may\n680:   // only come from the fixture regime. A real-embedding run measures this machine's\n681:   // embedder and graph, which is a live probe rather than a ratchet.\n682:   if (realEmbedding && process.argv.includes('--write')) {\n683:     process.stderr.write('capture-command-routing-baseline.mjs: --write cannot be combined with --real-embedding; the committed baseline is captured under the fixture regime only\\n');\n684:     process.exit(2);\n685:   }\n686: \n687:   try {\n688:     const baseline = await scoreCommandCorpus({ realEmbedding });\n689:     const serialized = `${JSON.stringify(baseline, null, 2)}\\n`;\n690:     if (process.argv.includes('--write')) {\n691:       writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n692:       console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n693:     }\n694:     console.log(serialized);\n695:   } catch (error) {\n696:     process.stderr.write(`capture-command-routing-baseline.mjs: ${error.message}\\n`);\n697:     process.exit(2);\n698:   }\n699: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 420-699\n420:     // a build whose freshness cannot be assessed.\n421:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n422:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n423:     if (freshness.status !== 'fresh') {\n424:       throw new Error(freshness.message);\n425:     }\n426: \n427:     // Real scoring is the only mode that reads this machine, so it is the only one\n428:     // that has to prove the machine can answer before walking the corpus. Without\n429:     // the flag nothing here runs and the prompt embedding is the direct call below.\n430:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n431: \n432:     const commandNames = readCommandFileNames(workspaceRoot);\n433:     const commandSet = new Set(commandNames);\n434:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n435:     const corpus = readCorpus(CORPUS_JSONL);\n436: \n437:     // A label naming a command that does not exist would silently score as a\n438:     // permanent miss, so it fails the capture instead of deflating a metric.\n439:     for (const row of corpus) {\n440:       if (row.expected_command === null || row.expected_command === undefined) continue;\n441:       if (!commandSet.has(row.expected_command)) {\n442:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n443:       }\n444:     }\n445: \n446:     const perCommand = new Map();\n447:     for (const command of commandNames) {\n448:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n449:     }\n450: \n451:     const typed = emptyTally();\n452:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n453:     let falseOfferCount = 0;\n454:     let falseOfferTotal = 0;\n455:     let slashReachedTop3 = 0;\n456:     let slashNamedTotal = 0;\n457:     let slashOfferedOnPartial = 0;\n458:     let slashPartialTotal = 0;\n459:     let agreementCorrect = 0;\n460:     let agreementTotal = 0;\n461:     // Per-row results sit beside the totals because a total can hold still\n462:     // while one row is gained and another lost, and a changed label has to\n463:     // surface under the id of the row it belongs to.\n464:     const rows = {};\n465:     // Attached reach: what a hub's own route adds on the same rows, split the\n466:     // same way, plus the rows that had to stay silent and the ties a bridge\n467:     // leaves with its own owner.\n468:     const attachedRows = {};\n469:     // A typed command reaches the reader through the recommendation that leads,\n470:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n471:     // already landed and `attached` is one delivered by the reader's own typed\n472:     // command. Its resolution follows the recommend handler exactly.\n473:     const typedAttached = emptyAttachedTally();\n474:     const typedRowResults = {};\n475:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n476:     const plainAttachedByFamily = new Map();\n477:     const sameOwnerAmbiguous = [];\n478:     let falseOfferAttached = 0;\n479:     const needsModeRows = [];\n480:     let needsModeFloor = 0;\n481: \n482:     for (const row of corpus) {\n483:       // The recommend path supplies the semantic lane's prompt vector through this\n484:       // wrapper, so a real capture threads the same path rather than scoring with\n485:       // the lane blind. Under the fixture regime the lane derives its own\n486:       // deterministic vector and the direct call is the whole behavior.\n487:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n488:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n489:       const ids = recommendationIds(result);\n490:       const landed = ids.map((id) => commandOf(idToCommand, id));\n491:       const expected = row.expected_command ?? null;\n492:       const top1Hit = expected !== null && landed[0] === expected;\n493:       const top3Hit = expected !== null && landed.includes(expected);\n494:       // True when any of the top three recommendations maps to a command bridge,\n495:       // so this is a reach measure. It is not whether a brief head offered the\n496:       // command, which the behaviour run line records as `offeredCommand`.\n497:       const offered = landed.some((command) => command !== null);\n498:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n499:       // A holdout row's outcome is what the split exists to keep unseen, so\n500:       // only its counts are published.\n501:       const publishRow = row.split !== 'holdout';\n502: \n503:       // A hub can name the slash command its route would take, which is reach a\n504:       // reader otherwise gets only by translating the workflow mode by hand.\n505:       const topId = ids[0];\n506:       const route = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n507:         ? readCompiledRoute(workspaceRoot, topId, row.prompt)\n508:         : undefined;\n509:       const attached = route !== undefined ? attachCommand(topId, route, row.prompt) : undefined;\n510:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n511:       // A typed command is the reader's own wording, so it outranks the hub's\n512:       // route in the delivered command, the same precedence the handler applies.\n513:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n514:       // A head shows that label only when nothing else names a command, so a row\n515:       // counts only when neither the typed command nor the route delivered one. A\n516:       // silent row that carries it shows a label nobody asked for.\n517:       const needsMode = route !== undefined && delivered === undefined && routeNeedsMode(topId, route, extractMetalinguisticSkillMentions(row.prompt));\n518:       // The list names rows with their outcome, so a holdout row stays out of it\n519:       // as it stays out of the row maps.\n520:       if (needsMode && publishRow) needsModeRows.push(row.id);\n521:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n522:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n523: \n524:       if (row.row_type === 'typed') {\n525:         addRow(typed, top1Hit, top3Hit);\n526:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n527:         if (publishRow) {\n528:           typedRowResults[row.id] = {\n529:             expected_command: expected,\n530:             top: ids[0] ?? null,\n531:             carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n532:             command: delivered ?? null,\n533:             policy: deliveredPolicy,\n534:           };\n535:         }\n536:       }\n537:       if (isPlainSplit) {\n538:         addRow(plain[row.split], top1Hit, top3Hit);\n539:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n540:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n541:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n542:       }\n543:       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n544:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n545:         sameOwnerAmbiguous.push(row.id);\n546:       }\n547: \n548:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n549:       if (commandTally) {\n550:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n551:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n552:       }\n553: \n554:       if (publishRow) {\n555:         rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n556:       }\n557: \n558:       const isSlashVariant = row.row_type === 'slash-variant';\n559:       // Silence is the requirement for a near miss, a prompt that must not\n560:       // trigger a command, and a partial slash mention that names no command.\n561:       const wantsSilence = row.row_type === 'must-not-start'\n562:         || row.row_type === 'near-miss'\n563:         || (isSlashVariant && expected === null);\n564:       if (wantsSilence) {\n565:         falseOfferTotal += 1;\n566:         if (offered) falseOfferCount += 1;\n567:         if (attached !== undefined) falseOfferAttached += 1;\n568:         if (needsMode) needsModeFloor += 1;\n569:       }\n570: \n571:       if (isSlashVariant) {\n572:         if (expected === null) {\n573:           slashPartialTotal += 1;\n574:           if (offered) slashOfferedOnPartial += 1;\n575:         } else {\n576:           slashNamedTotal += 1;\n577:           if (top3Hit) slashReachedTop3 += 1;\n578:         }\n579:       }\n580: \n581:       // A bridge offered below a skill is correct when the skill that outranked\n582:       // it is the bridge's own owner: the command stays reachable without the\n583:       // bridge displacing the skill the prompt actually asked for.\n584:       if (!idToCommand.has(ids[0])) {\n585:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n586:         if (laterBridgeId !== undefined) {\n587:           agreementTotal += 1;\n588:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n589:         }\n590:       }\n591:     }\n592: \n593:     const commands = {};\n594:     for (const command of [...perCommand.keys()].sort()) {\n595:       commands[command] = perCommand.get(command);\n596:     }\n597: \n598:     // Row ids are keyed in sorted order so a diff between two captures reads as\n599:     // the rows that changed rather than as reordered output.\n600:     const typedRows = {};\n601:     for (const id of Object.keys(typedRowResults).sort()) {\n602:       typedRows[id] = typedRowResults[id];\n603:     }\n604: \n605:     const reachableCommands = new Set();\n606:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n607:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n608: \n609:     const plainByFamily = {};\n610:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n611:       const family = plainAttachedByFamily.get(namespace);\n612:       plainByFamily[namespace] = {\n613:         tune: attachedTallyJson(family.tune),\n614:         holdout: attachedTallyJson(family.holdout),\n615:       };\n616:     }\n617: \n618:     return {\n619:       schemaVersion: 1,\n620:       capturedAt,\n621:       capturedAtSha: readHeadSha(workspaceRoot),\n622:       corpusSha256: sha256File(CORPUS_JSONL),\n623:       bridgeCounts,\n624:       metrics: {\n625:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n626:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n627:         plain_recall_at_1: {\n628:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n629:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n630:         },\n631:         plain_reach_top3: {\n632:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n633:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n634:         },\n635:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n636:         slash_variant: {\n637:           reached_top3: slashReachedTop3,\n638:           named_total: slashNamedTotal,\n639:           offered_on_partial: slashOfferedOnPartial,\n640:           partial_total: slashPartialTotal,\n641:         },\n642:         agreement: { correct: agreementCorrect, total: agreementTotal },\n643:       },\n644:       unreachable,\n645:       commands,\n646:       rows,\n647:       attachedMetrics: {\n648:         plain: {\n649:           tune: attachedTallyJson(plainAttached.tune),\n650:           holdout: attachedTallyJson(plainAttached.holdout),\n651:         },\n652:         plain_by_family: plainByFamily,\n653:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n654:         typed: attachedTallyJson(typedAttached),\n655:         typedRows,\n656:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n657:         attachedRows,\n658:         needs_mode_floor: { count: needsModeFloor, total: falseOfferTotal },\n659:         needsModeRows: needsModeRows.sort(),\n660:       },\n661:     };\n662:   } finally {\n663:     globalThis.Date = RealDate;\n664:     // Removal comes last, after every read that needs the directory has\n665:     // finished; `force` keeps an already-swept directory from turning a\n666:     // completed capture into a failure.\n667:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n668:   }\n669: }\n670: \n671: // ───────────────────────────────────────────────────────────────────\n672: // 7. CLI ENTRY\n673: // ───────────────────────────────────────────────────────────────────\n674: \n675: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n676:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n677: \n678:   const realEmbedding = process.argv.includes('--real-embedding');\n679:   // The committed baseline has to be reproducible on a clean checkout, so it may\n680:   // only come from the fixture regime. A real-embedding run measures this machine's\n681:   // embedder and graph, which is a live probe rather than a ratchet.\n682:   if (realEmbedding && process.argv.includes('--write')) {\n683:     process.stderr.write('capture-command-routing-baseline.mjs: --write cannot be combined with --real-embedding; the committed baseline is captured under the fixture regime only\\n');\n684:     process.exit(2);\n685:   }\n686: \n687:   try {\n688:     const baseline = await scoreCommandCorpus({ realEmbedding });\n689:     const serialized = `${JSON.stringify(baseline, null, 2)}\\n`;\n690:     if (process.argv.includes('--write')) {\n691:       writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n692:       console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n693:     }\n694:     console.log(serialized);\n695:   } catch (error) {\n696:     process.stderr.write(`capture-command-routing-baseline.mjs: ${error.message}\\n`);\n697:     process.exit(2);\n698:   }\n699: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\",\"offset\":420,\"limit\":280}"},"time":{"start":1794566019861,"end":1794566021635}}}}
