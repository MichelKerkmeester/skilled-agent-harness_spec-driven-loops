{"type":"tool_use","timestamp":1794566806267,"sessionID":"ses_e2b7c5d22ffe0WJtGxywW4faG2","part":{"partID":"prt_1d4845919001tyPau1cgsczmWw","sessionID":"ses_e2b7c5d22ffe0WJtGxywW4faG2","messageID":"msg_1d483f9c500116dm90jks7DaA3","type":"tool","id":"call_76082f275df04fb5b164df0b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts, lines 1-119\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Compiled Routing Consumption\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // Effective-consumption invariants for compiled routing:\n6: //   - the OpenCode plugin renders the served compiled outcome into the injected\n7: //     system-context\n8: //   - a =0 kill invalidates a previously-cached compiled brief\n9: \n10: import { EventEmitter } from 'node:events';\n11: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n12: \n13: const mockedChild = vi.hoisted(() => ({ spawn: vi.fn() }));\n14: vi.mock('node:child_process', () => ({ spawn: mockedChild.spawn }));\n15: \n16: import skillAdvisorPlugin from '../../../../../.opencode/plugins/system-skill-advisor.js';\n17: \n18: const FLAG = 'SPECKIT_COMPILED_ROUTING';\n19: \n20: // ── Plugin render + cache invalidation (end-to-end via mocked advisor child) ─\n21: \n22: function makeChild(stdout: string) {\n23:   const child = new EventEmitter() as EventEmitter & {\n24:     stdout: EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n25:     stderr: EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n26:     stdin: { end: ReturnType<typeof vi.fn> };\n27:     kill: ReturnType<typeof vi.fn>;\n28:   };\n29:   child.stdout = new EventEmitter() as EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n30:   child.stderr = new EventEmitter() as EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n31:   child.stdout.setEncoding = vi.fn();\n32:   child.stderr.setEncoding = vi.fn();\n33:   child.stdin = { end: vi.fn() };\n34:   child.kill = vi.fn(() => true);\n35:   queueMicrotask(() => {\n36:     child.stdout.emit('data', stdout);\n37:     child.emit('close', 0);\n38:   });\n39:   return child;\n40: }\n41: \n42: function childStdout(compiledRoute?: Record<string, unknown>) {\n43:   return JSON.stringify({\n44:     status: 'ok',\n45:     data: {\n46:       freshness: 'live',\n47:       recommendations: [{\n48:         skillId: 'sk-code',\n49:         confidence: 0.91,\n50:         uncertainty: 0.23,\n51:         ...(compiledRoute ? { compiledRoute } : {}),\n52:       }],\n53:     },\n54:   });\n55: }\n56: \n57: function mockAdvisorChild(stdout: string) {\n58:   mockedChild.spawn.mockImplementation(() => makeChild(stdout));\n59: }\n60: \n61: async function makePlugin(options: Record<string, unknown> = {}) {\n62:   return await skillAdvisorPlugin.server({ directory: process.cwd() } as never, {\n63:     sourceSignatureOverride: 'fixed-signature',\n64:     cacheTTLMs: 60_000,\n65:     ...options,\n66:   } as never);\n67: }\n68: \n69: async function runPrompt(hooks: Awaited<ReturnType<typeof makePlugin>>, prompt: string) {\n70:   const output = { system: [] as string[] };\n71:   await hooks['experimental.chat.system.transform']?.(\n72:     { sessionID: 's-test', prompt } as never,\n73:     output as never,\n74:   );\n75:   return output.system;\n76: }\n77: \n78: describe('plugin renders the served compiled outcome into system-context', () => {\n79:   beforeEach(async () => {\n80:     vi.clearAllMocks();\n81:     delete process.env.SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED;\n82:     delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n83:     const reset = await skillAdvisorPlugin.server({ directory: process.cwd() } as never, {} as never);\n84:     await reset.event?.({ event: { type: 'server.instance.disposed', properties: { directory: process.cwd() } } } as never);\n85:   });\n86:   afterEach(() => { delete process.env[FLAG]; });\n87: \n88:   it('injects an additive compiled-routing line when a decision is served', async () => {\n89:     mockAdvisorChild(childStdout({ action: 'route', hubId: 'sk-code', targets: ['quality'], servingAuthority: 'compiled', fingerprint: 'abc123', generation: 3 }));\n90:     const system = await runPrompt(await makePlugin(), 'implement feature X');\n91:     const compiledLine = system.find((line) => line.startsWith('Compiled routing'));\n92:     expect(compiledLine).toBeTruthy();\n93:     expect(compiledLine).toContain('outcome=route');\n94:     expect(compiledLine).toContain('hub=sk-code');\n95:   });\n96: \n97:   it('injects no compiled line when no decision is served (byte-identical legacy brief)', async () => {\n98:     mockAdvisorChild(childStdout());\n99:     const system = await runPrompt(await makePlugin(), 'implement feature X');\n100:     expect(system.some((line) => line.startsWith('Compiled routing'))).toBe(false);\n101:     // Exactly the legacy single brief entry.\n102:     expect(system).toHaveLength(1);\n103:   });\n104: \n105:   it('=0 kill invalidates a previously-cached compiled brief (not re-served)', async () => {\n106:     mockAdvisorChild(childStdout({ action: 'route', hubId: 'sk-code', targets: ['quality'], servingAuthority: 'compiled', fingerprint: 'abc123', generation: 3 }));\n107:     process.env[FLAG] = '1';\n108:     const hooks = await makePlugin();\n109: \n110:     await runPrompt(hooks, 'implement feature X');\n111:     const afterFirst = mockedChild.spawn.mock.calls.length;\n112:     await runPrompt(hooks, 'implement feature X');\n113:     expect(mockedChild.spawn.mock.calls.length).toBe(afterFirst); // served from cache, no respawn\n114: \n115:     process.env[FLAG] = '0';\n116:     await runPrompt(hooks, 'implement feature X');\n117:     expect(mockedChild.spawn.mock.calls.length).toBeGreaterThan(afterFirst); // kill flips serving fingerprint -> cache miss\n118:   });\n119: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts, lines 1-119\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Compiled Routing Consumption\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // Effective-consumption invariants for compiled routing:\n6: //   - the OpenCode plugin renders the served compiled outcome into the injected\n7: //     system-context\n8: //   - a =0 kill invalidates a previously-cached compiled brief\n9: \n10: import { EventEmitter } from 'node:events';\n11: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n12: \n13: const mockedChild = vi.hoisted(() => ({ spawn: vi.fn() }));\n14: vi.mock('node:child_process', () => ({ spawn: mockedChild.spawn }));\n15: \n16: import skillAdvisorPlugin from '../../../../../.opencode/plugins/system-skill-advisor.js';\n17: \n18: const FLAG = 'SPECKIT_COMPILED_ROUTING';\n19: \n20: // ── Plugin render + cache invalidation (end-to-end via mocked advisor child) ─\n21: \n22: function makeChild(stdout: string) {\n23:   const child = new EventEmitter() as EventEmitter & {\n24:     stdout: EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n25:     stderr: EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n26:     stdin: { end: ReturnType<typeof vi.fn> };\n27:     kill: ReturnType<typeof vi.fn>;\n28:   };\n29:   child.stdout = new EventEmitter() as EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n30:   child.stderr = new EventEmitter() as EventEmitter & { setEncoding: ReturnType<typeof vi.fn> };\n31:   child.stdout.setEncoding = vi.fn();\n32:   child.stderr.setEncoding = vi.fn();\n33:   child.stdin = { end: vi.fn() };\n34:   child.kill = vi.fn(() => true);\n35:   queueMicrotask(() => {\n36:     child.stdout.emit('data', stdout);\n37:     child.emit('close', 0);\n38:   });\n39:   return child;\n40: }\n41: \n42: function childStdout(compiledRoute?: Record<string, unknown>) {\n43:   return JSON.stringify({\n44:     status: 'ok',\n45:     data: {\n46:       freshness: 'live',\n47:       recommendations: [{\n48:         skillId: 'sk-code',\n49:         confidence: 0.91,\n50:         uncertainty: 0.23,\n51:         ...(compiledRoute ? { compiledRoute } : {}),\n52:       }],\n53:     },\n54:   });\n55: }\n56: \n57: function mockAdvisorChild(stdout: string) {\n58:   mockedChild.spawn.mockImplementation(() => makeChild(stdout));\n59: }\n60: \n61: async function makePlugin(options: Record<string, unknown> = {}) {\n62:   return await skillAdvisorPlugin.server({ directory: process.cwd() } as never, {\n63:     sourceSignatureOverride: 'fixed-signature',\n64:     cacheTTLMs: 60_000,\n65:     ...options,\n66:   } as never);\n67: }\n68: \n69: async function runPrompt(hooks: Awaited<ReturnType<typeof makePlugin>>, prompt: string) {\n70:   const output = { system: [] as string[] };\n71:   await hooks['experimental.chat.system.transform']?.(\n72:     { sessionID: 's-test', prompt } as never,\n73:     output as never,\n74:   );\n75:   return output.system;\n76: }\n77: \n78: describe('plugin renders the served compiled outcome into system-context', () => {\n79:   beforeEach(async () => {\n80:     vi.clearAllMocks();\n81:     delete process.env.SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED;\n82:     delete process.env.SPECKIT_SKILL_ADVISOR_HOOK_DISABLED;\n83:     const reset = await skillAdvisorPlugin.server({ directory: process.cwd() } as never, {} as never);\n84:     await reset.event?.({ event: { type: 'server.instance.disposed', properties: { directory: process.cwd() } } } as never);\n85:   });\n86:   afterEach(() => { delete process.env[FLAG]; });\n87: \n88:   it('injects an additive compiled-routing line when a decision is served', async () => {\n89:     mockAdvisorChild(childStdout({ action: 'route', hubId: 'sk-code', targets: ['quality'], servingAuthority: 'compiled', fingerprint: 'abc123', generation: 3 }));\n90:     const system = await runPrompt(await makePlugin(), 'implement feature X');\n91:     const compiledLine = system.find((line) => line.startsWith('Compiled routing'));\n92:     expect(compiledLine).toBeTruthy();\n93:     expect(compiledLine).toContain('outcome=route');\n94:     expect(compiledLine).toContain('hub=sk-code');\n95:   });\n96: \n97:   it('injects no compiled line when no decision is served (byte-identical legacy brief)', async () => {\n98:     mockAdvisorChild(childStdout());\n99:     const system = await runPrompt(await makePlugin(), 'implement feature X');\n100:     expect(system.some((line) => line.startsWith('Compiled routing'))).toBe(false);\n101:     // Exactly the legacy single brief entry.\n102:     expect(system).toHaveLength(1);\n103:   });\n104: \n105:   it('=0 kill invalidates a previously-cached compiled brief (not re-served)', async () => {\n106:     mockAdvisorChild(childStdout({ action: 'route', hubId: 'sk-code', targets: ['quality'], servingAuthority: 'compiled', fingerprint: 'abc123', generation: 3 }));\n107:     process.env[FLAG] = '1';\n108:     const hooks = await makePlugin();\n109: \n110:     await runPrompt(hooks, 'implement feature X');\n111:     const afterFirst = mockedChild.spawn.mock.calls.length;\n112:     await runPrompt(hooks, 'implement feature X');\n113:     expect(mockedChild.spawn.mock.calls.length).toBe(afterFirst); // served from cache, no respawn\n114: \n115:     process.env[FLAG] = '0';\n116:     await runPrompt(hooks, 'implement feature X');\n117:     expect(mockedChild.spawn.mock.calls.length).toBeGreaterThan(afterFirst); // kill flips serving fingerprint -> cache miss\n118:   });\n119: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts\"}"},"time":{"start":1794566805785,"end":1794566806267}}}}
