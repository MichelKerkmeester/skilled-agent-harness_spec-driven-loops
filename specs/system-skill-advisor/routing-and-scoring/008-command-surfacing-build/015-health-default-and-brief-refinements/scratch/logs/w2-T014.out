{"type":"tool_use","timestamp":1794564967152,"sessionID":"ses_e2b9b7711ffeciERLuiGti9fHu","part":{"partID":"prt_1d468441a002Wde1cJznbmVkDE","sessionID":"ses_e2b9b7711ffeciERLuiGti9fHu","messageID":"msg_1d46827bc001rW4TYj7vaHrjQh","type":"tool","id":"call_a72b4404d1bf441b895b1645","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts .skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\nindex bcd2be3603..44aeec98d9 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n@@ -12,6 +12,7 @@ import { resolve } from 'node:path';\n \n import { TRACKED_COMMANDS, attachCommand, commandRowFor, routeNeedsMode, typedCommandForTop } from '../lib/command-attach.js';\n import { advisorPromptCache } from '../lib/prompt-cache.js';\n+import { extractMetalinguisticSkillMentions } from '../lib/prompt-policy.js';\n import {\n   resolveAdvisorThresholdConfig,\n } from '../lib/skill-advisor-brief.js';\n@@ -446,6 +447,7 @@ function enrichCompiledRoutes(\n   // returned unchanged.\n   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n   if (!anyEligible) return output;\n+  const namedSkills = extractMetalinguisticSkillMentions(prompt);\n   // A command row that already ranks in this result offers its command by itself,\n   // so the owning hub must not offer the same one again and spend a second slot on it.\n   const alreadyOffered = new Set<string>();\n@@ -477,7 +479,7 @@ function enrichCompiledRoutes(\n           command,\n           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n         }\n-        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute) ? { needsMode: true as const } : {}) };\n+        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n     }),\n   });\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\nindex 6ca1863612..fb42c0050a 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\n@@ -350,8 +350,15 @@ export function attachCommand(\n \n // A hub that withholds its command because the prompt names no single mode must\n // still tell the reader why no command came with it, and only a hub whose modes\n-// map to commands withholds one.\n-export function routeNeedsMode(skillId: string, compiledRoute: unknown): boolean {\n+// map to commands withholds one. A hub that tops a prompt which never named it\n+// is the scorer's guess, so the label would point at modes the reader did not\n+// ask about.\n+export function routeNeedsMode(\n+  skillId: string,\n+  compiledRoute: unknown,\n+  namedSkills: readonly string[],\n+): boolean {\n+  if (!namedSkills.includes(skillId)) return false;\n   const route = asRecord(compiledRoute);\n   if (!route) return false;\n   if (route.action !== 'defer' && route.action !== 'clarify') return false;\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\nindex b56d9c6d77..6e454dc302 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-attach.vitest.ts\n@@ -193,14 +193,15 @@ describe('typed command on the leading recommendation', () => {\n // not fire for a deferral that never named a mode in the first place.\n describe('a route that waits for a mode', () => {\n   it('flags a defer or clarify on a hub whose modes map to commands', () => {\n-    expect(routeNeedsMode('system-deep-loop', { action: 'defer' })).toBe(true);\n-    expect(routeNeedsMode('sk-doc', { action: 'clarify' })).toBe(true);\n+    expect(routeNeedsMode('system-deep-loop', { action: 'defer' }, ['system-deep-loop'])).toBe(true);\n+    expect(routeNeedsMode('sk-doc', { action: 'clarify' }, ['sk-doc'])).toBe(true);\n   });\n \n   it('stays quiet for a routed mode, a hub outside the table and a shape that is no route', () => {\n-    expect(routeNeedsMode('sk-doc', singleRoute('sk-create-readme'))).toBe(false);\n-    expect(routeNeedsMode('sk-code', { action: 'defer' })).toBe(false);\n-    expect(routeNeedsMode('sk-doc', undefined)).toBe(false);\n-    expect(routeNeedsMode('sk-doc', ['defer'])).toBe(false);\n+    expect(routeNeedsMode('sk-doc', singleRoute('sk-create-readme'), ['sk-doc'])).toBe(false);\n+    expect(routeNeedsMode('sk-code', { action: 'defer' }, ['sk-code'])).toBe(false);\n+    expect(routeNeedsMode('sk-doc', undefined, ['sk-doc'])).toBe(false);\n+    expect(routeNeedsMode('sk-doc', ['defer'], ['sk-doc'])).toBe(false);\n+    expect(routeNeedsMode('sk-doc', { action: 'clarify' }, [])).toBe(false);\n   });\n });\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\nindex 661a115338..2df8c6707d 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/