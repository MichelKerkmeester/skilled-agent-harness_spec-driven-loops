d: 'sk-doc', scorerRow: true },\n166:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n167:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n172:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n173:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n174:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n177:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n178:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n179:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n180:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n201: // its `/create:skill` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n204: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n205: const WORD_CHARACTER = /[a-z0-9_]/;\n206: \n207: export function typedCommandIn(prompt: string): string | undefined {\n208:   const lowered = prompt.toLowerCase();\n209:   let found: string | undefined;\n210:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n211:     let index = lowered.indexOf(key);\n212:     while (index !== -1) {\n213:       const before = index === 0 ? '' : lowered[index - 1];\n214:       const after = lowered[index + key.length] ?? '';\n215:       const next = lowered[index + key.length + 1] ?? '';\n216:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n217:       const continuesName =\n218:         COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next));\n219:       const endsAtBoundary = after === '' || !continuesName;\n220:       if (startsAtBoundary && endsAtBoundary) {\n221:         if (found === undefined || key.length > found.length) found = key;\n222:         break;\n223:       }\n224:       index = lowered.indexOf(key, index + 1);\n225:     }\n226:   }\n227:   return found;\n228: }\n229: \n230: // A typed command travels on the recommendation that leads, so it is delivered\n231: // only when the leading skill owns the command or carries the same command row.\n232: // A leading skill unrelated to the command must not carry it.\n233: export interface TypedCommand {\n234:   readonly command: string;\n235:   readonly policy: 'run' | 'start' | 'ask';\n236:   readonly ownerSkillId: string;\n237: }\n238: \n239: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n240:   const command = typedCommandIn(prompt);\n241:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n242:   const row = TRACKED_COMMANDS[command];\n243:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n244:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n245:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n246: }\n247: \n248: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n249: // that merely mentions the topic spends the reader's budget on work they never\n250: // asked for. The list below is the vocabulary that counts as asking for it, and\n251: // it holds only effort wording: a bare topic word such as `research`, `review`\n252: // or `council` says what to look at, never how far to go, so it never qualifies\n253: // on its own.\n254: //\n255: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n256: // has to judge stays visible and cheap to correct.\n257: export const DEPTH_WORDING: readonly string[] = [\n258:   'in depth',\n259:   'deep dive',\n260:   'deep research',\n261:   'deep review',\n262:   'thorough',\n263:   'thoroughly',\n264:   'exhaustive',\n265:   'iteratively',\n266:   'multiple passes',\n267:   'many passes',\n268:   'several passes',\n269:   'ask the council',\n270:   'convene',\n271:   'several models',\n272:   'final verdict',\n273:   'everything you can',\n274: ];\n275: \n276: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n277: // escaped before it is trusted as a pattern.\n278: function escapePhrase(phrase: string): string {\n279:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n280: }\n281: \n282: // One alternation over the list keeps the gate a single test per prompt, and the\n283: // boundary markers keep `thorough` from firing inside a longer word while a\n284: // multi-word phrase still has to match as a whole.\n285: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n286: \n287: // Wording that asks for an answer and rules out a change. One pattern serves\n288: // every gate that has to honour it, so a new gate cannot drift from the first.\n289: export const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n290: \n291: // A compiled route arrives as unvalidated JSON from a separate process, so the\n292: // shape is narrowed here rather than trusted. Arrays count as objects in\n293: // JavaScript and would let `action` read off an unrelated field, so they are\n294: // excluded explicitly.\n295: function asRecord(value: unknown): Record<string, unknown> | undefined {\n296:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n297:   return value as Record<string, unknown>;\n298: }\n299: \n300: // The command for a hub's recommendation, or undefined when the route does not\n301: // single out one mode. Only a single-mode route names a command unambiguously:\n302: // a bundle or a multi-target route has more than one answer, and asking the\n303: // reader to pick belongs to the recommend path, not here. Never throws, because\n304: // a missing command must degrade to \"no command offered\" rather than break\n305: // routing. The prompt decides whether a costly deep-loop command is offered at\n306: // all: a reader who only asks about the topic gets no command, rather than one\n307: // that would launch work they never requested.\n308: export function attachCommand(\n309:   skillId: string,\n310:   compiledRoute: unknown,\n311:   prompt: string,\n312:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n313: ): string | undefined {\n314:   const route = asRecord(compiledRoute);\n315:   if (!route) return undefined;\n316:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n317: \n318:   const targets = route.targets;\n319:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n320: \n321:   const onlyTarget = asRecord(targets[0]);\n322:   if (!onlyTarget) return undefined;\n323: \n324:   const workflowMode = onlyTarget.workflowMode;\n325:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n326: \n327:   // A reader who rules out a change gets no command from either path, so the hub\n328:   // route never offers what the scorer already withholds.\n329:   if (NO_EDIT_REQUEST.test(prompt.toLowerCase())) return undefined;\n330: \n331:   // Own-key lookup on both levels: the table is data read from a generated\n332:   // object, so an inherited name such as `constructor` must not resolve to a\n333:   // command the hub never declared.\n334:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n335:   const commands = modeCommands[skillId];\n336:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n337: \n338:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n339:   // run, so they are offered only when the prompt asks for that effort. Typing\n340:   // the command being attached is itself the ask, while typing another deep-loop\n341:   // command asks for that command, not this one. Every other hub answers a short\n342:   // question with a short answer, so no other skill consults the wording list.\n343:   if (skillId === 'system-deep-loop') {\n344:     const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n345:     if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n346:   }\n347: \n348:   return commands[workflowMode];\n349: }\n350: \n351: // A hub that withholds its command because the prompt names no single mode must\n352: // still tell the reader why no command came with it, and only a hub whose modes\n353: // map to commands withholds one.\n354: export function routeNeedsMode(skillId: string, compiledRoute: unknown): boolean {\n355:   const route = asRecord(compiledRoute);\n356:   if (!route) return false;\n357:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n358:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n359: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts, lines 1-359\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Slash command attached to a hub's recommendation\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // The advisor can name the workflow mode a hub would route a prompt to, but the\n6: // reader still has to translate that mode into the slash command that acts on\n7: // it. This module owns that translation and nothing else, kept free of imports\n8: // so the recommend path and a test read the same semantics.\n9: //\n10: // The mode-to-command table is generated rather than hand-maintained: each row is\n11: // derived from a hub's own command files, so a hub that adds or renames a mode\n12: // regenerates its row instead of drifting from a copy someone forgot to update.\n13: \n14: // BEGIN GENERATED MODE COMMANDS\n15: export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {\n16:   'sk-design': {\n17:     'sk-design-chart': '/design:chart',\n18:     'sk-design-diagram': '/design:diagram',\n19:     'sk-design-md-generator': '/design:extract',\n20:   },\n21:   'sk-doc': {\n22:     'sk-create-agent': '/create:agent',\n23:     'sk-create-benchmark': '/create:benchmark',\n24:     'sk-create-changelog': '/create:changelog',\n25:     'sk-create-command': '/create:command',\n26:     'sk-create-diff': '/create:diff',\n27:     'sk-create-feature-catalog': '/create:feature-catalog',\n28:     'sk-create-goal': '/create:goal',\n29:     'sk-create-manual-testing-playbook': '/create:manual-testing-playbook',\n30:     'sk-create-readme': '/create:readme',\n31:     'sk-create-repo-rule': '/create:repo-rule',\n32:     'sk-create-skill': '/create:skill',\n33:     'sk-create-skill-parent': '/create:skill-parent',\n34:     'sk-create-with-human-voice': '/create:with-human-voice',\n35:   },\n36:   'system-deep-loop': {\n37:     'ai-council': '/deep:ai-council',\n38:     'research': '/deep:research',\n39:     'review': '/deep:review',\n40:   },\n41: };\n42: // END GENERATED MODE COMMANDS\n43: \n44: // One row of the command table: the runnable slash command, the policy that says\n45: // whether it runs, asks or starts a session, the class that says what the run\n46: // writes, and the skill that owns it. The rows are generated, so only the shape\n47: // lives here.\n48: export interface CommandRow {\n49:   readonly command: string;\n50:   readonly policy?: 'run' | 'start' | 'ask';\n51:   readonly mutating?: 'read-only' | 'add-only' | 'mutates';\n52:   readonly ownerSkillId: string;\n53: }\n54: \n55: // The table below covers every tracked command, whether or not its bridge is\n56: // active, so a typed command always has a policy and an owner. `scorerRow` says\n57: // whether a scorer can also return the command on its own.\n58: export interface TrackedCommand {\n59:   readonly policy: 'run' | 'start' | 'ask';\n60:   readonly ownerSkillId: string;\n61:   readonly scorerRow: boolean;\n62: }\n63: \n64: // BEGIN GENERATED COMMAND ROWS\n65: export const COMMAND_ROWS: Readonly<Record<string, CommandRow>> = {\n66:   'command-create-agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n67:   'command-create-changelog': { command: '/create:changelog', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n68:   'command-create-feature-catalog': { command: '/create:feature-catalog', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n69:   'command-create-manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n70:   'command-create-readme': { command: '/create:readme', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n71:   'command-create-skill': { command: '/create:skill', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n72:   'command-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n73:   'command-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n74:   'command-doctor-agents-md-check': { command: '/doctor:agents-md check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n75:   'command-doctor-agents-md-embed': { command: '/doctor:agents-md embed', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n76:   'command-doctor-agents-md-restore': { command: '/doctor:agents-md restore', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n77:   'command-doctor-ci-report': { command: '/doctor:ci report', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n78:   'command-doctor-ci-scaffold': { command: '/doctor:ci scaffold', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n79:   'command-doctor-ci-toggle': { command: '/doctor:ci toggle', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n80:   'command-doctor-deep-loop': { command: '/doctor:deep-loop', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-deep-loop' },\n81:   'command-doctor-env': { command: '/doctor:env list', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n82:   'command-doctor-git-hooks': { command: '/doctor:git hooks', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n83:   'command-doctor-git-setup': { command: '/doctor:git setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-git' },\n84:   'command-doctor-git-standards': { command: '/doctor:git standards', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-git' },\n85:   'command-doctor-helper': { command: '/doctor:helper', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n86:   'command-doctor-install': { command: '/doctor:install', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n87:   'command-doctor-mcp-debug': { command: '/doctor:mcp debug', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n88:   'command-doctor-mcp-install': { command: '/doctor:mcp install', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n89:   'command-doctor-overlay-apply': { command: '/doctor:overlay apply', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n90:   'command-doctor-overlay-repin': { command: '/doctor:overlay repin', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n91:   'command-doctor-overlay-status': { command: '/doctor:overlay status', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n92:   'command-doctor-runtime-mirrors': { command: '/doctor:runtime-mirrors', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n93:   'command-doctor-setup': { command: '/doctor:setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n94:   'command-doctor-sk-code-quality': { command: '/doctor:sk-code quality', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-code' },\n95:   'command-doctor-sk-code-setup': { command: '/doctor:sk-code setup', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-code' },\n96:   'command-doctor-sk-skill-check': { command: '/doctor:sk-skill check', policy: 'run', mutating: 'read-only', ownerSkillId: 'sk-doc' },\n97:   'command-doctor-sk-skill-convert': { command: '/doctor:sk-skill convert', policy: 'ask', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n98:   'command-doctor-skill-advisor-embedder': { command: '/doctor:skill-advisor embedder', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n99:   'command-doctor-skill-advisor-parent-skill': { command: '/doctor:skill-advisor parent-skill', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n100:   'command-doctor-skill-advisor-rebuild': { command: '/doctor:skill-advisor rebuild', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n101:   'command-doctor-skill-advisor-router-reach': { command: '/doctor:skill-advisor router-reach', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n102:   'command-doctor-skill-advisor-skill-budget': { command: '/doctor:skill-advisor skill-budget', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n103:   'command-doctor-skill-advisor-skill-graph-freshness': { command: '/doctor:skill-advisor skill-graph-freshness', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skill-advisor' },\n104:   'command-doctor-skill-advisor-tune': { command: '/doctor:skill-advisor tune', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skill-advisor' },\n105:   'command-doctor-speckit': { command: '/doctor:speckit', policy: 'run', mutating: 'add-only', ownerSkillId: 'system-skilled-doctor' },\n106:   'command-doctor-symlink-check': { command: '/doctor:symlink check', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-skilled-doctor' },\n107:   'command-doctor-symlink-link': { command: '/doctor:symlink link', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n108:   'command-doctor-symlink-unlink': { command: '/doctor:symlink unlink', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n109:   'command-doctor-update': { command: '/doctor:update', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-skilled-doctor' },\n110:   'command-prompt-improve': { command: '/prompt:improve', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-prompt' },\n111:   'command-spec-kit-deep-research': { command: '/deep:research', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n112:   'command-spec-kit-deep-review': { command: '/deep:review', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-deep-loop' },\n113:   'command-speckit-complete': { command: '/speckit:complete', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n114:   'command-speckit-handoff': { command: '/speckit:handoff', policy: 'ask', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n115:   'command-speckit-implement': { command: '/speckit:implement', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n116:   'command-speckit-plan': { command: '/speckit:plan', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n117:   'command-speckit-resume': { command: '/speckit:resume', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n118:   'command-speckit-save': { command: '/speckit:save', policy: 'start', mutating: 'mutates', ownerSkillId: 'system-spec-kit' },\n119:   'command-speckit-search': { command: '/speckit:search', policy: 'run', mutating: 'read-only', ownerSkillId: 'system-spec-kit' },\n120:   'create:agent': { command: '/create:agent', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n121:   'create:manual-testing-playbook': { command: '/create:manual-testing-playbook', policy: 'start', mutating: 'mutates', ownerSkillId: 'sk-doc' },\n122: };\n123: export const TRACKED_COMMANDS: Readonly<Record<string, TrackedCommand>> = {\n124:   '/create:agent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n125:   '/create:benchmark': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n126:   '/create:changelog': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: false },\n127:   '/create:command': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n128:   '/create:diff': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n129:   '/create:feature-catalog': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n130:   '/create:goal': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n131:   '/create:manual-testing-playbook': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: true },\n132:   '/create:readme': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n133:   '/create:repo-rule': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n134:   '/create:skill': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n135:   '/create:skill-parent': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n136:   '/create:with-human-voice': { policy: 'start', ownerSkillId: 'sk-doc', scorerRow: false },\n137:   '/deep:ai-council': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n138:   '/deep:research': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n139:   '/deep:review': { policy: 'ask', ownerSkillId: 'system-deep-loop', scorerRow: false },\n140:   '/design:chart': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n141:   '/design:diagram': { policy: 'start', ownerSkillId: 'sk-design', scorerRow: false },\n142:   '/design:extract': { policy: 'ask', ownerSkillId: 'sk-design', scorerRow: false },\n143:   '/doctor:agents-md check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n144:   '/doctor:agents-md embed': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n145:   '/doctor:agents-md restore': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n146:   '/doctor:ci report': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n147:   '/doctor:ci scaffold': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n148:   '/doctor:ci toggle': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n149:   '/doctor:deep-loop': { policy: 'run', ownerSkillId: 'system-deep-loop', scorerRow: true },\n150:   '/doctor:env list': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n151:   '/doctor:git hooks': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n152:   '/doctor:git setup': { policy: 'run', ownerSkillId: 'sk-git', scorerRow: true },\n153:   '/doctor:git standards': { policy: 'ask', ownerSkillId: 'sk-git', scorerRow: true },\n154:   '/doctor:helper': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n155:   '/doctor:install': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n156:   '/doctor:mcp debug': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n157:   '/doctor:mcp install': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n158:   '/doctor:overlay apply': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n159:   '/doctor:overlay repin': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n160:   '/doctor:overlay status': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n161:   '/doctor:runtime-mirrors': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n162:   '/doctor:setup': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n163:   '/doctor:sk-code quality': { policy: 'ask', ownerSkillId: 'sk-code', scorerRow: true },\n164:   '/doctor:sk-code setup': { policy: 'run', ownerSkillId: 'sk-code', scorerRow: true },\n165:   '/doctor:sk-skill check': { policy: 'run', ownerSkillId: 'sk-doc', scorerRow: true },\n166:   '/doctor:sk-skill convert': { policy: 'ask', ownerSkillId: 'sk-doc', scorerRow: true },\n167:   '/doctor:skill-advisor embedder': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n168:   '/doctor:skill-advisor parent-skill': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n169:   '/doctor:skill-advisor rebuild': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n170:   '/doctor:skill-advisor router-reach': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n171:   '/doctor:skill-advisor skill-budget': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n172:   '/doctor:skill-advisor skill-graph-freshness': { policy: 'run', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n173:   '/doctor:skill-advisor tune': { policy: 'ask', ownerSkillId: 'system-skill-advisor', scorerRow: true },\n174:   '/doctor:speckit': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n175:   '/doctor:symlink check': { policy: 'run', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n176:   '/doctor:symlink link': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n177:   '/doctor:symlink unlink': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n178:   '/doctor:update': { policy: 'ask', ownerSkillId: 'system-skilled-doctor', scorerRow: true },\n179:   '/prompt:improve': { policy: 'start', ownerSkillId: 'sk-prompt', scorerRow: true },\n180:   '/speckit:complete': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n181:   '/speckit:handoff': { policy: 'ask', ownerSkillId: 'system-spec-kit', scorerRow: true },\n182:   '/speckit:implement': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n183:   '/speckit:plan': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n184:   '/speckit:resume': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n185:   '/speckit:save': { policy: 'start', ownerSkillId: 'system-spec-kit', scorerRow: true },\n186:   '/speckit:search': { policy: 'run', ownerSkillId: 'system-spec-kit', scorerRow: true },\n187: };\n188: // END GENERATED COMMAND ROWS\n189: \n190: // The row for an id a recommendation carries, or undefined when that id names no\n191: // command. Own-key lookup because the table is generated data, so an inherited\n192: // name such as `constructor` must not resolve to a row nobody declared.\n193: export function commandRowFor(id: string): CommandRow | undefined {\n194:   return Object.hasOwn(COMMAND_ROWS, id) ? COMMAND_ROWS[id] : undefined;\n195: }\n196: \n197: // A typed command is the reader's own wording, so it counts only where a command\n198: // can start and where it ends on a boundary. That keeps a path such as\n199: // `docs/create:goal.md` and a prefix such as `/create:sk` from reading as a\n200: // command, and the longest key wins so `/create:skill-parent` is never reduced to\n201: // its `/create:skill` prefix. A dot or a slash followed by a word character\n202: // continues a file name or a path, while a sentence-ending period does not.\n203: const COMMAND_START_BOUNDARY = /[\\s`'\"(]/;\n204: const COMMAND_CONTINUATION = /[a-z0-9_:-]/;\n205: const WORD_CHARACTER = /[a-z0-9_]/;\n206: \n207: export function typedCommandIn(prompt: string): string | undefined {\n208:   const lowered = prompt.toLowerCase();\n209:   let found: string | undefined;\n210:   for (const key of Object.keys(TRACKED_COMMANDS)) {\n211:     let index = lowered.indexOf(key);\n212:     while (index !== -1) {\n213:       const before = index === 0 ? '' : lowered[index - 1];\n214:       const after = lowered[index + key.length] ?? '';\n215:       const next = lowered[index + key.length + 1] ?? '';\n216:       const startsAtBoundary = before === '' || COMMAND_START_BOUNDARY.test(before);\n217:       const continuesName =\n218:         COMMAND_CONTINUATION.test(after) || ((after === '/' || after === '.') && WORD_CHARACTER.test(next));\n219:       const endsAtBoundary = after === '' || !continuesName;\n220:       if (startsAtBoundary && endsAtBoundary) {\n221:         if (found === undefined || key.length > found.length) found = key;\n222:         break;\n223:       }\n224:       index = lowered.indexOf(key, index + 1);\n225:     }\n226:   }\n227:   return found;\n228: }\n229: \n230: // A typed command travels on the recommendation that leads, so it is delivered\n231: // only when the leading skill owns the command or carries the same command row.\n232: // A leading skill unrelated to the command must not carry it.\n233: export interface TypedCommand {\n234:   readonly command: string;\n235:   readonly policy: 'run' | 'start' | 'ask';\n236:   readonly ownerSkillId: string;\n237: }\n238: \n239: export function typedCommandForTop(topSkillId: string, prompt: string): TypedCommand | undefined {\n240:   const command = typedCommandIn(prompt);\n241:   if (command === undefined || !Object.hasOwn(TRACKED_COMMANDS, command)) return undefined;\n242:   const row = TRACKED_COMMANDS[command];\n243:   const sameCommandRow = commandRowFor(topSkillId)?.command === command;\n244:   if (topSkillId !== row.ownerSkillId && !sameCommandRow) return undefined;\n245:   return { command, policy: row.policy, ownerSkillId: row.ownerSkillId };\n246: }\n247: \n248: // Deep-loop commands open a long, multi-pass run, so one attached to a prompt\n249: // that merely mentions the topic spends the reader's budget on work they never\n250: // asked for. The list below is the vocabulary that counts as asking for it, and\n251: // it holds only effort wording: a bare topic word such as `research`, `review`\n252: // or `council` says what to look at, never how far to go, so it never qualifies\n253: // on its own.\n254: //\n255: // The phrases live in a data list, one per line, so the vocabulary a reviewer\n256: // has to judge stays visible and cheap to correct.\n257: export const DEPTH_WORDING: readonly string[] = [\n258:   'in depth',\n259:   'deep dive',\n260:   'deep research',\n261:   'deep review',\n262:   'thorough',\n263:   'thoroughly',\n264:   'exhaustive',\n265:   'iteratively',\n266:   'multiple passes',\n267:   'many passes',\n268:   'several passes',\n269:   'ask the council',\n270:   'convene',\n271:   'several models',\n272:   'final verdict',\n273:   'everything you can',\n274: ];\n275: \n276: // A phrase may carry punctuation a regex would read as a metacharacter, so it is\n277: // escaped before it is trusted as a pattern.\n278: function escapePhrase(phrase: string): string {\n279:   return phrase.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n280: }\n281: \n282: // One alternation over the list keeps the gate a single test per prompt, and the\n283: // boundary markers keep `thorough` from firing inside a longer word while a\n284: // multi-word phrase still has to match as a whole.\n285: const DEPTH_REQUEST = new RegExp(`\\\\b(?:${DEPTH_WORDING.map(escapePhrase).join('|')})\\\\b`);\n286: \n287: // Wording that asks for an answer and rules out a change. One pattern serves\n288: // every gate that has to honour it, so a new gate cannot drift from the first.\n289: export const NO_EDIT_REQUEST = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/;\n290: \n291: // A compiled route arrives as unvalidated JSON from a separate process, so the\n292: // shape is narrowed here rather than trusted. Arrays count as objects in\n293: // JavaScript and would let `action` read off an unrelated field, so they are\n294: // excluded explicitly.\n295: function asRecord(value: unknown): Record<string, unknown> | undefined {\n296:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined;\n297:   return value as Record<string, unknown>;\n298: }\n299: \n300: // The command for a hub's recommendation, or undefined when the route does not\n301: // single out one mode. Only a single-mode route names a command unambiguously:\n302: // a bundle or a multi-target route has more than one answer, and asking the\n303: // reader to pick belongs to the recommend path, not here. Never throws, because\n304: // a missing command must degrade to \"no command offered\" rather than break\n305: // routing. The prompt decides whether a costly deep-loop command is offered at\n306: // all: a reader who only asks about the topic gets no command, rather than one\n307: // that would launch work they never requested.\n308: export function attachCommand(\n309:   skillId: string,\n310:   compiledRoute: unknown,\n311:   prompt: string,\n312:   modeCommands: Readonly<Record<string, Readonly<Record<string, string>>>> = MODE_COMMANDS,\n313: ): string | undefined {\n314:   const route = asRecord(compiledRoute);\n315:   if (!route) return undefined;\n316:   if (route.action !== 'route' || route.selectionKind !== 'single') return undefined;\n317: \n318:   const targets = route.targets;\n319:   if (!Array.isArray(targets) || targets.length !== 1) return undefined;\n320: \n321:   const onlyTarget = asRecord(targets[0]);\n322:   if (!onlyTarget) return undefined;\n323: \n324:   const workflowMode = onlyTarget.workflowMode;\n325:   if (typeof workflowMode !== 'string' || workflowMode === '') return undefined;\n326: \n327:   // A reader who rules out a change gets no command from either path, so the hub\n328:   // route never offers what the scorer already withholds.\n329:   if (NO_EDIT_REQUEST.test(prompt.toLowerCase())) return undefined;\n330: \n331:   // Own-key lookup on both levels: the table is data read from a generated\n332:   // object, so an inherited name such as `constructor` must not resolve to a\n333:   // command the hub never declared.\n334:   if (!Object.prototype.hasOwnProperty.call(modeCommands, skillId)) return undefined;\n335:   const commands = modeCommands[skillId];\n336:   if (!Object.prototype.hasOwnProperty.call(commands, workflowMode)) return undefined;\n337: \n338:   // Deep-loop commands are the ones that commit the reader to a long, multi-pass\n339:   // run, so they are offered only when the prompt asks for that effort. Typing\n340:   // the command being attached is itself the ask, while typing another deep-loop\n341:   // command asks for that command, not this one. Every other hub answers a short\n342:   // question with a short answer, so no other skill consults the wording list.\n343:   if (skillId === 'system-deep-loop') {\n344:     const typesThisCommand = typedCommandIn(prompt) === commands[workflowMode];\n345:     if (!typesThisCommand && !DEPTH_REQUEST.test(prompt.toLowerCase())) return undefined;\n346:   }\n347: \n348:   return commands[workflowMode];\n349: }\n350: \n351: // A hub that withholds its command because the prompt names no single mode must\n352: // still tell the reader why no command came with it, and only a hub whose modes\n353: // map to commands withholds one.\n354: export function routeNeedsMode(skillId: string, compiledRoute: unknown): boolean {\n355:   const route = asRecord(compiledRoute);\n356:   if (!route) return false;\n357:   if (route.action !== 'defer' && route.action !== 'clarify') return false;\n358:   return Object.prototype.hasOwnProperty.call(MODE_COMMANDS, skillId);\n359: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-attach.ts\"}"},"time":{"start":1794564787445,"end":1794564787978}}}}
{"type":"tool_use","timestamp":1794564788087,"sessionID":"ses_e2b9b7711ffeciERLuiGti9fHu","part":{"partID":"prt_1d4658a5f001vTcnzT0lX1sRpw","sessionID":"ses_e2b9b7711ffeciERLuiGti9fHu","messageID":"msg_1d4657fe20019vuWh2OWL9E2Lv","type":"tool","id":"call_b76ac4998f8146bba38ffac5","tool":"shell","state":{"status":"completed","input":{"command":"node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"Implement a guarded needsMode label that requires the prompt to name the hub, editing command-attach and advisor-recommend plus their tests\" 2>&1 | head -40"},"output":"{\"hubId\":\"sk-code\",\"action\":\"defer\",\"selectionKind\":null,\"targets\":[],\"effectivePolicyHash\":\"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\"generation\":2}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"hubId\":\"sk-code\",\"action\":\"defer\",\"selectionKind\":null,\"targets\":[],\"effectivePolicyHash\":\"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\"generation\":2}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \\\"Implement a guarded needsMode label that requires the prompt to name the hub, editing command-attach and advisor-recommend plus their tests\\\" 2>&1 | head -40\"}"},"time":{"start":1794564786783,"end":1794564788087}}}}
