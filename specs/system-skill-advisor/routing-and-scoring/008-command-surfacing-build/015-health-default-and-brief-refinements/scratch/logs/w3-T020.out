egradedrate and lastrecordat to hookhealth schema and handler test\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"report\",\n    \"the\",\n    \"degraded\",\n    \"share\",\n    \"and\",\n    \"newest\",\n    \"record\",\n    \"time\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 167,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":1},"content":[{"type":"text","text":"{\n  \"candidatePhraseCount\": 5765,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"in\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"to\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"advisor\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"status\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"add\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"rollingdegradedrate\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"lastrecordat\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"hookhealth\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"schema\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"handler\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"test\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"report the degraded share and the newest record time in advisor status add rollingdegradedrate and lastrecordat to hookhealth schema and handler test\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"report\",\n    \"the\",\n    \"degraded\",\n    \"share\",\n    \"and\",\n    \"newest\",\n    \"record\",\n    \"time\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 167,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"},{"type":"text","text":"Exit code: 1"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"report the degraded share and the newest record time in advisor_status, add rollingDegradedRate and lastRecordAt to hookHealth schema and handler test\\\"\"}"},"time":{"start":1794565090211,"end":1794565091852}}}}
