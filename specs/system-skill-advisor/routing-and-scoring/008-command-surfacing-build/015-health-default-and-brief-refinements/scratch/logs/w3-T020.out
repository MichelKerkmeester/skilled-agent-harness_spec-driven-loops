lthSection.rollingDegradedRate,\n+              lastRecordAt: hookHealthSection.lastRecordAt,\n             },\n           }\n         : {}),\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts b/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\nindex a11f658259..eb817c9c12 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\n@@ -453,6 +453,8 @@ export const AdvisorStatusOutputSchema = z.object({\n     rollingP95Ms: z.number().nonnegative(),\n     rollingFailOpenRate: z.number().min(0).max(1),\n     rollingCacheHitRate: z.number().min(0).max(1),\n+    rollingDegradedRate: z.number().min(0).max(1),\n+    lastRecordAt: z.string(),\n   }).strict().optional(),\n   daemonPid: z.number().int().positive().optional(),\n   errors: z.array(z.string()).optional(),\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\nindex 29a57f0fa8..6738efa728 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n@@ -28,6 +28,7 @@ vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n import {\n+  advisorHookDiagnosticsPath,\n   createAdvisorHookDiagnosticRecord,\n   persistAdvisorHookDiagnosticRecord,\n } from '../../lib/metrics.js';\n@@ -533,6 +534,86 @@ describe('advisor_status handler', () => {\n     }\n   });\n \n+  it('writes a health record without the debug variable and keeps the skill label out', async () => {\n+    const root = workspace('hook-health-default');\n+    const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n+    delete process.env.SKILL_ADVISOR_DEBUG;\n+    try {\n+      await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+        runtime: 'claude',\n+        status: 'ok',\n+        freshness: 'live',\n+        durationMs: 12,\n+        cacheHit: true,\n+        skillLabel: 'sk-doc',\n+        errorDetails: 'probe detail',\n+        degraded: true,\n+      }));\n+\n+      const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n+      expect(lines).toHaveLength(1);\n+      const record = JSON.parse(lines[0] ?? '{}') as Record<string, unknown>;\n+      expect(record).not.toHaveProperty('skillLabel');\n+      expect(record).not.toHaveProperty('errorDetails');\n+      expect(record.degraded).toBe(true);\n+      expect(readAdvisorStatus({ workspaceRoot: root }).hookHealth?.invocations).toBe(1);\n+    } finally {\n+      if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n+      else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n+    }\n+  });\n+\n+  it('trims the default health log to 200 records', async () => {\n+    const root = workspace('hook-health-trim');\n+    const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n+    delete process.env.SKILL_ADVISOR_DEBUG;\n+    try {\n+      for (let index = 0; index < 301; index += 1) {\n+        await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+          runtime: 'claude',\n+          status: 'ok',\n+          freshness: 'live',\n+          durationMs: index,\n+          cacheHit: true,\n+        }));\n+      }\n+\n+      const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n+      expect(lines).toHaveLength(200);\n+    } finally {\n+      if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n+      else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n+    }\n+  });\n+\n+  it('reports the newest record time and the degraded share', async () => {\n+    const root = workspace('hook-health-degraded');\n+    await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+      runtime: 'claude',\n+      status: 'ok',\n+      freshness: 'live',\n+      durationMs: 10,\n+      cacheHit: true,\n+      timestamp: '2026-11-13T08:00:00.000Z',\n+      degraded: true,\n+    }));\n+    await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+      runtime: 'claude',\n+      status: 'ok',\n+      freshness: 'live',\n+      durationMs: 30,\n+      cacheHit: true,\n+      timestamp: '2026-11-13T08:00:05.000Z',\n+    }));\n+\n+    const status = readAdvisorStatus({ workspaceRoot: root });\n+    const parsed = AdvisorStatusOutputSchema.parse(status);\n+\n+    expect(parsed.hookHealth?.invocations).toBe(2);\n+    expect(parsed.hookHealth?.lastRecordAt).toBe('2026-11-13T08:00:05.000Z');\n+    expect(parsed.hookHealth?.rollingDegradedRate).toBe(0.5);\n+  });\n+\n   it('omits hook health when no diagnostic records exist', () => {\n     const root = workspace('hook-health-absent');\n \n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\nindex 41eab3304a..61ebe4bf5a 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\n@@ -496,13 +496,17 @@ export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutpu\n       laneWeights: DEFAULT_SCORER_WEIGHTS,\n       // The p95 counts cache-hit invocations only, because a miss pays the\n       // child-process cost that the alert thresholds are not set against.\n-      ...(hookHealthSection.lastInvocations.length > 0\n+      // A timestamp exists exactly when a record does, which is the condition\n+      // that decides whether the hook has reported anything yet.\n+      ...(hookHealthSection.lastRecordAt !== null\n         ? {\n             hookHealth: {\n               invocations: hookHealthSection.lastInvocations.length,\n               rollingP95Ms: hookHealthSection.rollingP95Ms,\n               rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n               rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n+              rollingDegradedRate: hookHealthSection.rollingDegradedRate,\n+              lastRecordAt: hookHealthSection.lastRecordAt,\n             },\n           }\n         : {}),\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts b/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\nindex a11f658259..eb817c9c12 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts\n@@ -453,6 +453,8 @@ export const AdvisorStatusOutputSchema = z.object({\n     rollingP95Ms: z.number().nonnegative(),\n     rollingFailOpenRate: z.number().min(0).max(1),\n     rollingCacheHitRate: z.number().min(0).max(1),\n+    rollingDegradedRate: z.number().min(0).max(1),\n+    lastRecordAt: z.string(),\n   }).strict().optional(),\n   daemonPid: z.number().int().positive().optional(),\n   errors: z.array(z.string()).optional(),\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\nindex 29a57f0fa8..6738efa728 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n@@ -28,6 +28,7 @@ vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n import {\n+  advisorHookDiagnosticsPath,\n   createAdvisorHookDiagnosticRecord,\n   persistAdvisorHookDiagnosticRecord,\n } from '../../lib/metrics.js';\n@@ -533,6 +534,86 @@ describe('advisor_status handler', () => {\n     }\n   });\n \n+  it('writes a health record without the debug variable and keeps the skill label out', async () => {\n+    const root = workspace('hook-health-default');\n+    const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n+    delete process.env.SKILL_ADVISOR_DEBUG;\n+    try {\n+      await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+        runtime: 'claude',\n+        status: 'ok',\n+        freshness: 'live',\n+        durationMs: 12,\n+        cacheHit: true,\n+        skillLabel: 'sk-doc',\n+        errorDetails: 'probe detail',\n+        degraded: true,\n+      }));\n+\n+      const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n+      expect(lines).toHaveLength(1);\n+      const record = JSON.parse(lines[0] ?? '{}') as Record<string, unknown>;\n+      expect(record).not.toHaveProperty('skillLabel');\n+      expect(record).not.toHaveProperty('errorDetails');\n+      expect(record.degraded).toBe(true);\n+      expect(readAdvisorStatus({ workspaceRoot: root }).hookHealth?.invocations).toBe(1);\n+    } finally {\n+      if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n+      else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n+    }\n+  });\n+\n+  it('trims the default health log to 200 records', async () => {\n+    const root = workspace('hook-health-trim');\n+    const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n+    delete process.env.SKILL_ADVISOR_DEBUG;\n+    try {\n+      for (let index = 0; index < 301; index += 1) {\n+        await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+          runtime: 'claude',\n+          status: 'ok',\n+          freshness: 'live',\n+          durationMs: index,\n+          cacheHit: true,\n+        }));\n+      }\n+\n+      const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n+      expect(lines).toHaveLength(200);\n+    } finally {\n+      if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n+      else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n+    }\n+  });\n+\n+  it('reports the newest record time and the degraded share', async () => {\n+    const root = workspace('hook-health-degraded');\n+    await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+      runtime: 'claude',\n+      status: 'ok',\n+      freshness: 'live',\n+      durationMs: 10,\n+      cacheHit: true,\n+      timestamp: '2026-11-13T08:00:00.000Z',\n+      degraded: true,\n+    }));\n+    await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n+      runtime: 'claude',\n+      status: 'ok',\n+      freshness: 'live',\n+      durationMs: 30,\n+      cacheHit: true,\n+      timestamp: '2026-11-13T08:00:05.000Z',\n+    }));\n+\n+    const status = readAdvisorStatus({ workspaceRoot: root });\n+    const parsed = AdvisorStatusOutputSchema.parse(status);\n+\n+    expect(parsed.hookHealth?.invocations).toBe(2);\n+    expect(parsed.hookHealth?.lastRecordAt).toBe('2026-11-13T08:00:05.000Z');\n+    expect(parsed.hookHealth?.rollingDegradedRate).toBe(0.5);\n+  });\n+\n   it('omits hook health when no diagnostic records exist', () => {\n     const root = workspace('hook-health-absent');\n \n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts .skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794565180688,"end":1794565181644}}}}
{"type":"tool_use","timestamp":1794565183000,"sessionID":"ses_e2b9698caffeLgfL2URRQHee3D","part":{"partID":"prt_1d46b8a9c002l17itrtcpM1w6Y","sessionID":"ses_e2b9698caffeLgfL2URRQHee3D","messageID":"msg_1d46b6e58001th5CGymE2fGjBe","type":"tool","id":"call_91d0639ac2324a2a9e8d99da","tool":"shell","state":{"status":"completed","input":{"command":"npm run typecheck >/dev/null 2>&1 && echo \"TYPECHECK_EXIT=0\"","timeout":600000,"workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime"},"output":"TYPECHECK_EXIT=0\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"TYPECHECK_EXIT=0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"npm run typecheck >/dev/null 2>&1 && echo \\\"TYPECHECK_EXIT=0\\\"\",\"timeout\":600000,\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime\"}"},"time":{"start":1794565180060,"end":1794565183000}}}}
