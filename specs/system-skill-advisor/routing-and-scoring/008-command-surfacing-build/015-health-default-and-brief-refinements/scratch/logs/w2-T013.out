              \"packetKind\": \"workflow\",\n              \"skillId\": \"sk-doc\",\n              \"workflowMode\": \"sk-create-quality-control\"\n            }\n          ],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\"\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 195,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"status\": \"ok\",\n  \"data\": {\n    \"workspaceRoot\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\",\n    \"effectiveThresholds\": {\n      \"confidenceThreshold\": 0.8,\n      \"uncertaintyThreshold\": 0.35,\n      \"confidenceOnly\": false\n    },\n    \"recommendations\": [\n      {\n        \"skillId\": \"system-skill-advisor\",\n        \"score\": 0.529239,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.12,\n        \"dominantLane\": \"explicit_author\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"system-spec-kit\",\n        \"score\": 0.193317,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.18,\n        \"dominantLane\": \"graph_causal\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-doc\",\n        \"score\": 0.155736,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.18,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"route\",\n          \"selectionKind\": \"single\",\n          \"targets\": [\n            {\n              \"backendKind\": \"create-quality-control\",\n              \"packetId\": \"sk-create-quality-control\",\n              \"packetKind\": \"workflow\",\n              \"skillId\": \"sk-doc\",\n              \"workflowMode\": \"sk-create-quality-control\"\n            }\n          ],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\"\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 195,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"Add a degraded boolean flag to AdvisorHookMetrics in the skill advisor brief module\\\"}' --format json 2>&1 | head -60\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794564756363,"end":1794564757394}}}}
