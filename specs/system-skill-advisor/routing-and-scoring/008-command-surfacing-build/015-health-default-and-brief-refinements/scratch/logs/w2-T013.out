N_CAP);\n149: }\n[Output truncated. Continue reading with offset: 150]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/skill-advisor-brief.ts, lines 70-149\n70: // ───────────────────────────────────────────────────────────────────\n71: export type AdvisorHookStatus = AdvisorEnvelopeStatus;\n72: export type AdvisorHookFreshness = AdvisorEnvelopeFreshness;\n73: \n74: export interface SkillAdvisorBriefOptions {\n75:   readonly workspaceRoot: string;\n76:   readonly runtime: AdvisorRuntime;\n77:   readonly maxTokens?: number;\n78:   readonly thresholdConfig?: AdvisorThresholds;\n79:   readonly subprocessTimeoutMs?: number;\n80: }\n81: \n82: export interface AdvisorHookDiagnostics {\n83:   readonly reason?: string;\n84:   readonly errorCode?: AdvisorSubprocessErrorCode | 'UNCAUGHT_EXCEPTION' | 'ADVISOR_FRESHNESS_UNAVAILABLE';\n85:   readonly errorClass?: AdvisorErrorClass;\n86:   readonly errorMessage?: string;\n87:   readonly policyReason?: string;\n88:   readonly metalinguisticMention?: readonly string[];\n89:   readonly skillNameSuppressions?: readonly string[];\n90:   readonly staleReason?: string;\n91: }\n92: \n93: export interface AdvisorHookMetrics {\n94:   readonly durationMs: number;\n95:   readonly cacheHit: boolean;\n96:   readonly subprocessInvoked: boolean;\n97:   readonly retriesAttempted: number;\n98:   readonly recommendationCount: number;\n99:   readonly tokenCap: number;\n100: }\n101: \n102: export interface AdvisorHookResult {\n103:   readonly status: AdvisorHookStatus;\n104:   readonly freshness: AdvisorHookFreshness;\n105:   readonly brief: string | null;\n106:   readonly recommendations: AdvisorRecommendation[];\n107:   readonly diagnostics: AdvisorHookDiagnostics | null;\n108:   readonly metrics: AdvisorHookMetrics;\n109:   readonly generatedAt: string;\n110:   readonly shar