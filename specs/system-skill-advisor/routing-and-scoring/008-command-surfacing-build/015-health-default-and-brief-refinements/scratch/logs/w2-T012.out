-skill-advisor/runtime/lib/metrics.ts\n+++ .skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\n@@ -450,9 +450,14 @@\n   workspaceRoot: string,\n   record: AdvisorHookDiagnosticRecord,\n ): Promise<string> {\n   const path = durableMetricsPath(workspaceRoot, 'diagnostics');\n-  await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(record), MAX_DURABLE_DIAGNOSTIC_RECORDS);\n+  // A health record answers how the hook runs, which needs no prompt, skill or\n+  // error text, so it is written on every prompt, and the debug variable adds the\n+  // two fields that say what the prompt was about.\n+  const { skillLabel: _skillLabel, errorDetails: _errorDetails, ...promptFreeRecord } = record;\n+  const persisted = process.env.SKILL_ADVISOR_DEBUG ? record : promptFreeRecord;\n+  await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(persisted), MAX_DURABLE_DIAGNOSTIC_RECORDS, { requireDebug: false });\n   return path;\n }\n \n export function readAdvisorHookDiagnosticRecords(\n","status":"modified","additions":6,"deletions":1}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/lib/metrics.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/metrics.ts\",\"oldString\":\"export async function persistAdvisorHookDiagnosticRecord(\\n  workspaceRoot: string,\\n  record: AdvisorHookDiagnosticRecord,\\n): Promise<string> {\\n  const path = durableMetricsPath(workspaceRoot, 'diagnostics');\\n  await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(record), MAX_DURABLE_DIAGNOSTIC_RECORDS);\\n  return path;\\n}\",\"newString\":\"export async function persistAdvisorHookDiagnosticRecord(\\n  workspaceRoot: string,\\n  record: AdvisorHookDiagnosticRecord,\\n): Promise<string> {\\n  const path = durableMetricsPath(workspaceRoot, 'diagnostics');\\n  // A health record answers how the hook runs, which needs no prompt, skill or\\n  // error text, so it is written on every prompt, and the debug variable adds the\\n  // two fields that say what the prompt was about.\\n  const { skillLabel: _skillLabel, errorDetails: _errorDetails, ...promptFreeRecord } = record;\\n  const persisted = process.env.SKILL_ADVISOR_DEBUG ? record : promptFreeRecord;\\n  await writeBoundedJsonl(path, serializeAdvisorHookDiagnosticRecord(persisted), MAX_DURABLE_DIAGNOSTIC_RECORDS, { requireDebug: false });\\n  return path;\\n}\"}"},"time":{"start":1794564973169,"end":1794564975285}}}}
