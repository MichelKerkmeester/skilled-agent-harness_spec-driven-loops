       invocations: hookHealthSection.lastInvocations.length,\n503:               rollingP95Ms: hookHealthSection.rollingP95Ms,\n504:               rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n505:               rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n506:             },\n507:           }\n508:         : {}),\n509:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n510:       ...(daemonPid ? { daemonPid } : {}),\n511:       ...(errors.length > 0 ? { errors } : {}),\n512:     };\n513:     return AdvisorStatusOutputSchema.parse(output);\n514:   } catch (error: unknown) {\n515:     const message = redactDiagnosticText(errorMessage(error));\n516:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n517:     const trustState = createTrustState({\n518:       hasSources: existsSync(skillRoot),\n519:       hasArtifact: existsSync(dbPath),\n520:       sourceChanged: false,\n521:       daemonAvailable: false,\n522:       generation: 0,\n523:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n524:     });\n525:     const output: AdvisorStatusOutput = {\n526:       freshness: 'unavailable',\n527:       generation: 0,\n528:       trustState,\n529:       lastGenerationBump: null,\n[Output truncated. Continue reading with offset: 530]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\",\"offset\":470,\"limit\":60}"},"time":{"start":1794564818346,"end":1794564818824}}}}
