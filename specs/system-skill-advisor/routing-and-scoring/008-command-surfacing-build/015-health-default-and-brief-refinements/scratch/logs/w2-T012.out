rd.degraded).toBe(true);\n      expect(readAdvisorStatus({ workspaceRoot: root }).hookHealth?.invocations).toBe(1);\n    } finally {\n      if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n      else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n    }\n  });\n\n  it('trims the default health log to 200 records', async () => {\n    const root = workspace('hook-health-trim');\n    const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n    delete process.env.SKILL_ADVISOR_DEBUG;\n    try {\n      for (let index = 0; index < 301; index += 1) {\n        await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n          runtime: 'claude',\n          status: 'ok',\n          freshness: 'live',\n          durationMs: index,\n          cacheHit: true,\n        }));\n      }\n\n      const lines = readFileSync(advisorHookDiagnosticsPath(root), 'utf8').trimEnd().split('\\n');\n      expect(lines).toHaveLength(200);\n    } finally {\n      if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n      else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n    }\n  });\n\n  it('omits hook health when no diagnostic records exist', () => {"},"output":"Edited .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":".skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts","patch":"Index: .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n===================================================================\n--- .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n+++ .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\n@@ -533,8 +533,60 @@\n       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n     }\n   });\n \n+  it('writes a health record without the debug variable and keep