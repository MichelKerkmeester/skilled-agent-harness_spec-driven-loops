{"type":"tool_use","timestamp":1794564785445,"sessionID":"ses_e2b9b778effeSQq4IId0PmqU0C","part":{"partID":"prt_1d46582c60016uR7hCZ4T0pM2Y","sessionID":"ses_e2b9b778effeSQq4IId0PmqU0C","messageID":"msg_1d4657499001SKI3OwSPfKOy9B","type":"tool","id":"call_94deaa6c55764e16aefa7c98","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-667\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { beforeEach, describe, expect, it, vi } from 'vitest';\n11: \n12: const ollamaMocks = vi.hoisted(() => ({\n13:   probeOllamaModel: vi.fn(),\n14:   resolveOllamaBaseUrl: vi.fn(() => 'http://127.0.0.1:11434'),\n15: }));\n16: \n17: // The handler is the only caller that probes a backend, so the mock keeps\n18: // every other status case free of network access.\n19: vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n20:   const actual = await importOriginal<typeof import('../../lib/embedders/adapters/ollama.js')>();\n21:   return {\n22:     ...actual,\n23:     probeOllamaModel: ollamaMocks.probeOllamaModel,\n24:     resolveOllamaBaseUrl: ollamaMocks.resolveOllamaBaseUrl,\n25:   };\n26: });\n27: \n28: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n29: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n30: import {\n31:   createAdvisorHookDiagnosticRecord,\n32:   persistAdvisorHookDiagnosticRecord,\n33: } from '../../lib/metrics.js';\n34: import {\n35:   computeSkillMetadataContentHash,\n36:   readCommandEmbeddingSources,\n37: } from '../../lib/skill-graph/skill-graph-db.js';\n38: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n39: \n40: const ADVISOR_DB_RELATIVE_PATH = join(\n41:   '.skilled',\n42:   'skills',\n43:   'system-skill-advisor',\n44:   'runtime',\n45:   'database',\n46:   'skill-graph.sqlite',\n47: );\n48: \n49: function workspace(name: string): string {\n50:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n51:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n52:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n53:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n54:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n55:   return root;\n56: }\n57: \n58: function writeGeneration(\n59:   root: string,\n60:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n61:   generation = 1,\n62:   sourceSignature: string | null = null,\n63: ): void {\n64:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n65:     generation,\n66:     updatedAt: '2026-04-20T00:00:00.000Z',\n67:     sourceSignature,\n68:     reason: `${state.toUpperCase()}_FIXTURE`,\n69:     state,\n70:   })}\\n`, 'utf8');\n71: }\n72: \n73: function writeDb(root: string): void {\n74:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n75: }\n76: \n77: function writeIndexDb(root: string, contentHash: string | null): void {\n78:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n79:   try {\n80:     database.exec(`\n81:       CREATE TABLE skill_nodes (\n82:         id TEXT PRIMARY KEY,\n83:         source_path TEXT,\n84:         content_hash TEXT\n85:       );\n86:     `);\n87:     database.prepare(`\n88:       INSERT INTO skill_nodes (id, source_path, content_hash)\n89:       VALUES (?, ?, ?)\n90:     `).run(\n91:       'alpha',\n92:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n93:       contentHash,\n94:     );\n95:   } finally {\n96:     database.close();\n97:   }\n98: }\n99: \n100: function writeHealthDb(root: string): void {\n101:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n102:   try {\n103:     database.exec(`\n104:       CREATE TABLE skill_nodes (\n105:         id TEXT PRIMARY KEY,\n106:         embedding BLOB,\n107:         embedding_model_id TEXT,\n108:         embedding_content_hash TEXT\n109:       );\n110:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n111:       CREATE TABLE vec_768 (\n112:         skill_id TEXT PRIMARY KEY,\n113:         embedding BLOB NOT NULL,\n114:         model_id TEXT NOT NULL,\n115:         content_hash TEXT NOT NULL,\n116:         updated_at TEXT DEFAULT (datetime('now'))\n117:       );\n118:     `);\n119:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n120:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n121:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n122:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n123:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n124:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n125:   } finally {\n126:     database.close();\n127:   }\n128: }\n129: \n130: function writeCommandVectorTable(root: string, rows: number): void {\n131:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n132:   try {\n133:     database.exec(`\n134:       CREATE TABLE vec_cmd_768 (\n135:         command_id TEXT PRIMARY KEY,\n136:         embedding BLOB NOT NULL,\n137:         model_id TEXT NOT NULL,\n138:         content_hash TEXT NOT NULL,\n139:         updated_at TEXT DEFAULT (datetime('now'))\n140:       );\n141:     `);\n142:     const insert = database.prepare(`\n143:       INSERT INTO vec_cmd_768 (command_id, embedding, model_id, content_hash)\n144:       VALUES (?, ?, ?, ?)\n145:     `);\n146:     for (let index = 0; index < rows; index += 1) {\n147:       insert.run(`command-${index}`, Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', `hash-${index}`);\n148:     }\n149:   } finally {\n150:     database.close();\n151:   }\n152: }\n153: \n154: function writeDimMismatchHealthDb(root: string): void {\n155:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n156:   try {\n157:     database.exec(`\n158:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n159:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n160:       CREATE TABLE vec_123 (\n161:         skill_id TEXT PRIMARY KEY,\n162:         embedding BLOB NOT NULL,\n163:         model_id TEXT NOT NULL,\n164:         content_hash TEXT NOT NULL,\n165:         updated_at TEXT DEFAULT (datetime('now'))\n166:       );\n167:     `);\n168:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n169:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n170:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n171:   } finally {\n172:     database.close();\n173:   }\n174: }\n175: \n176: describe('advisor_status handler', () => {\n177:   beforeEach(() => {\n178:     ollamaMocks.probeOllamaModel.mockReset();\n179:     ollamaMocks.resolveOllamaBaseUrl.mockReset();\n180:     ollamaMocks.resolveOllamaBaseUrl.mockReturnValue('http://127.0.0.1:11434');\n181:   });\n182: \n183:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n184:     const root = workspace('linked');\n185:     const skills = join(root, '.skilled', 'skills');\n186:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n187:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n188:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n189:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n190:     const before = computeAdvisorSourceSignature(root);\n191:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n192:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n193:   });\n194: \n195:   it('ignores a private skill linked from outside every trusted root', () => {\n196:     const root = workspace('outside');\n197:     const skills = join(root, '.skilled', 'skills');\n198:     const outside = join(root, 'outside-beta');\n199:     mkdirSync(outside, { recursive: true });\n200:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n201:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n202:     symlinkSync(outside, join(skills, 'local-beta'));\n203:     const before = computeAdvisorSourceSignature(root);\n204:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n205:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n206:   });\n207: \n208:   it('includes a private skill linked into a declared external root', () => {\n209:     const root = workspace('declared');\n210:     const skills = join(root, '.skilled', 'skills');\n211:     const external = join(root, 'private-repos');\n212:     const target = join(external, 'sk-code-webflow');\n213:     mkdirSync(target, { recursive: true });\n214:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n215:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n216:     symlinkSync(target, join(skills, 'local-webflow'));\n217:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n218:     try {\n219:       const before = computeAdvisorSourceSignature(root);\n220:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n221:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n222:     } finally {\n223:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n224:     }\n225:   });\n226: \n227:   // drift: verified against shipped behavior during Unit H\n228:   it('reports live freshness', () => {\n229:     const root = workspace('live');\n230:     writeDb(root);\n231:     writeGeneration(root, 'live', 3);\n232: \n233:     const status = readAdvisorStatus({ workspaceRoot: root });\n234: \n235:     expect(status.freshness).toBe('live');\n236:     expect(status.trustState.state).toBe('live');\n237:     expect(status.generation).toBe(3);\n238:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n239:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n240:     expect(status.skillCount).toBe(1);\n241:     expect(status.laneWeights.explicit_author).toBe(0.42);\n242:     expect(status.semanticLaneHealth).toBeUndefined();\n243:   });\n244: \n245:   it('reports fresh index hashes without changing a live generation', () => {\n246:     const root = workspace('index-fresh');\n247:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n248:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n249:     writeIndexDb(root, contentHash);\n250:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n251: \n252:     const status = readAdvisorStatus({ workspaceRoot: root });\n253: \n254:     expect(status.freshness).toBe('live');\n255:     expect(status.indexStaleness).toEqual({\n256:       state: 'fresh',\n257:       reason: null,\n258:       trackedSkills: 1,\n259:       freshSourceFiles: 1,\n260:       changedSourceFiles: 0,\n261:       missingSourceFiles: 0,\n262:       staleSkillIds: [],\n263:     });\n264:   });\n265: \n266:   it('marks live generations stale when index hashes differ from disk', () => {\n267:     const root = workspace('index-stale');\n268:     writeIndexDb(root, 'outdated-hash');\n269:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n270: \n271:     const status = readAdvisorStatus({ workspaceRoot: root });\n272: \n273:     expect(status.freshness).toBe('stale');\n274:     expect(status.trustState.state).toBe('stale');\n275:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n276:       state: 'stale',\n277:       reason: 'source_hash_mismatch',\n278:       changedSourceFiles: 1,\n279:     }));\n280:     expect(status.errors).toContain(\n281:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n282:     );\n283:   });\n284: \n285:   it('reports unavailable index staleness when the database is absent', () => {\n286:     const root = workspace('index-absent');\n287:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n288: \n289:     const status = readAdvisorStatus({ workspaceRoot: root });\n290: \n291:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n292:       state: 'unavailable',\n293:       reason: 'database_absent',\n294:     }));\n295:   });\n296: \n297:   it('reports semantic-lane health only when requested', () => {\n298:     const root = workspace('semantic-health');\n299:     writeHealthDb(root);\n300:     writeGeneration(root, 'live', 8);\n301: \n302:     const compact = readAdvisorStatus({ workspaceRoot: root });\n303:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n304: \n305:     expect(compact.semanticLaneHealth).toBeUndefined();\n306:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n307:       activeEmbedder: expect.objectContaining({\n308:         name: 'nomic-embed-text-v1.5',\n309:         dim: 768,\n310:         adapterDim: 768,\n311:       }),\n312:       vectorCoverage: {\n313:         embedded: 1,\n314:         total: 2,\n315:         ratio: 0.5,\n316:       },\n317:       dimMismatch: false,\n318:       lastRefresh: '2026-04-20T00:00:00.000Z',\n319:       disabledReason: null,\n320:       laneEnabled: true,\n321:     }));\n322:   });\n323: \n324:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n325:     const root = workspace('semantic-dim-mismatch');\n326:     writeDimMismatchHealthDb(root);\n327:     writeGeneration(root, 'live', 9);\n328: \n329:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n330: \n331:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n332:       activeEmbedder: expect.objectContaining({\n333:         name: 'nomic-embed-text-v1.5',\n334:         dim: 123,\n335:         adapterDim: 768,\n336:       }),\n337:       dimMismatch: true,\n338:       disabledReason: 'dim_mismatch',\n339:       laneEnabled: false,\n340:     }));\n341:   });\n342: \n343:   it('reports zero command-vector coverage when no command table exists', () => {\n344:     const root = workspace('command-coverage-absent');\n345:     writeHealthDb(root);\n346:     writeGeneration(root, 'live', 10);\n347: \n348:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n349:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n350: \n351:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n352:       embedded: 0,\n353:       total: sourceTotal,\n354:     });\n355:   });\n356: \n357:   it('counts command-vector rows when the command table exists', () => {\n358:     const root = workspace('command-coverage-present');\n359:     writeHealthDb(root);\n360:     writeCommandVectorTable(root, 3);\n361:     writeGeneration(root, 'live', 10);\n362: \n363:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n364:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n365: \n366:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n367:       embedded: 3,\n368:       total: sourceTotal,\n369:     });\n370:   });\n371: \n372:   it('reports a reachable backend when the model is loaded', async () => {\n373:     const root = workspace('backend-reachable');\n374:     writeHealthDb(root);\n375:     writeGeneration(root, 'live', 14);\n376:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: true });\n377: \n378:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n379:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n380:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n381: \n382:     expect(ollamaMocks.probeOllamaModel).toHaveBeenCalledWith(\n383:       'http://127.0.0.1:11434',\n384:       'nomic-embed-text:v1.5',\n385:       500,\n386:     );\n387:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'reachable', reason: null });\n388:     expect(status.semanticLaneHealth?.laneEnabled).toBe(true);\n389:   });\n390: \n391:   it('reports an unreachable backend when the probe cannot connect', async () => {\n392:     const root = workspace('backend-unreachable');\n393:     writeHealthDb(root);\n394:     writeGeneration(root, 'live', 14);\n395:     const reason = 'Ollama backend unreachable at http://127.0.0.1:11434: fetch failed';\n396:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n397: \n398:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n399:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n400:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n401: \n402:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'unreachable', reason });\n403:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n404:   });\n405: \n406:   it('reports a missing model when the server answers without it', async () => {\n407:     const root = workspace('backend-model-missing');\n408:     writeHealthDb(root);\n409:     writeGeneration(root, 'live', 14);\n410:     const reason = 'Ollama model is not loaded: nomic-embed-text:v1.5';\n411:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n412: \n413:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n414:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n415:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n416: \n417:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'model_missing', reason });\n418:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n419:   });\n420: \n421:   // drift: verified against shipped behavior during Unit H\n422:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n423:     const root = workspace('signed-live');\n424:     writeDb(root);\n425:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n426:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n427:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n428:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n429:     const sourceSignature = computeAdvisorSourceSignature(root);\n430:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n431:       generation: 9,\n432:       updatedAt: '2026-04-22T00:00:00.000Z',\n433:       sourceSignature,\n434:       reason: 'advisor_rebuild',\n435:       state: 'live',\n436:     })}\\n`, 'utf8');\n437: \n438:     const status = readAdvisorStatus({ workspaceRoot: root });\n439: \n440:     expect(status.freshness).toBe('live');\n441:     expect(status.trustState.state).toBe('live');\n442:   });\n443: \n444:   // drift: verified against shipped behavior during Unit H\n445:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n446:     const root = workspace('nested-mtime');\n447:     writeDb(root);\n448:     writeGeneration(root, 'live', 6);\n449:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n450:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n451:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n452:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n453: \n454:     const status = readAdvisorStatus({ workspaceRoot: root });\n455: \n456:     expect(status.freshness).toBe('stale');\n457:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n458:   });\n459: \n460:   // drift: verified against shipped behavior during Unit H\n461:   it('reports stale freshness', () => {\n462:     const root = workspace('stale');\n463:     writeDb(root);\n464:     writeGeneration(root, 'stale', 4);\n465: \n466:     const status = readAdvisorStatus({ workspaceRoot: root });\n467: \n468:     expect(status.freshness).toBe('stale');\n469:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n470:   });\n471: \n472:   it('reports absent freshness when no artifact exists', () => {\n473:     const root = workspace('absent');\n474:     writeGeneration(root, 'absent', 0);\n475: \n476:     const status = readAdvisorStatus({ workspaceRoot: root });\n477: \n478:     expect(status.freshness).toBe('absent');\n479:   });\n480: \n481:   // drift: verified against shipped behavior during Unit H\n482:   it('reports unavailable for corrupt generation metadata', () => {\n483:     const root = workspace('unavailable');\n484:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n485: \n486:     const status = readAdvisorStatus({ workspaceRoot: root });\n487: \n488:     expect(status.freshness).toBe('unavailable');\n489:     expect(status.errors?.length).toBeGreaterThan(0);\n490:   });\n491: \n492:   it('does not leak prompt content in status output', async () => {\n493:     const root = workspace('privacy');\n494:     writeDb(root);\n495:     writeGeneration(root, 'live', 5);\n496: \n497:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n498: \n499:     expect(raw).not.toContain('prompt');\n500:     expect(raw).not.toContain('secret@example.com');\n501:   });\n502: \n503:   it('omits embeddings health when the option is absent', async () => {\n504:     const root = workspace('embeddings-health-omitted');\n505:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n506:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n507:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n508: \n509:     expect(status).not.toHaveProperty('embeddingsHealth');\n510:   });\n511: \n512:   it('reports hook health from durable diagnostic records', async () => {\n513:     const root = workspace('hook-health');\n514:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n515:     process.env.SKILL_ADVISOR_DEBUG = '1';\n516:     try {\n517:       for (const durationMs of [10, 30]) {\n518:         await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n519:           runtime: 'claude',\n520:           status: 'ok',\n521:           freshness: 'live',\n522:           durationMs,\n523:           cacheHit: true,\n524:         }));\n525:       }\n526: \n527:       const status = readAdvisorStatus({ workspaceRoot: root });\n528: \n529:       expect(status.hookHealth?.invocations).toBe(2);\n530:     } finally {\n531:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n532:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n533:     }\n534:   });\n535: \n536:   it('omits hook health when no diagnostic records exist', () => {\n537:     const root = workspace('hook-health-absent');\n538: \n539:     const status = readAdvisorStatus({ workspaceRoot: root });\n540: \n541:     expect(status).not.toHaveProperty('hookHealth');\n542:   });\n543: \n544:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n545:     const root = workspace('embeddings-health-unavailable');\n546:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n547: \n548:     try {\n549:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n550:       const response = await handleAdvisorStatus({\n551:         workspaceRoot: root,\n552:         includeEmbeddingsHealth: true,\n553:       });\n554:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n555:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n556: \n557:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n558:     } finally {\n559:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n560:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n561:     }\n562:   });\n563: \n564:   // drift: verified against shipped behavior during Unit H\n565:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n566:     const root = workspace('scan-cap');\n567:     writeDb(root);\n568:     writeGeneration(root, 'live', 7);\n569:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n570:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n571: \n572:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n573: \n574:     expect(status.skillCount).toBe(1);\n575:     expect(status.errors).toEqual([\n576:       expect.stringContaining('metadata scan capped at 1 files'),\n577:     ]);\n578:   });\n579: \n580:   it('counts only depth-one skill roots with graph metadata', () => {\n581:     const root = workspace('root-only-scan');\n582:     writeDb(root);\n583:     writeGeneration(root, 'live', 7);\n584:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n585:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n586:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n587:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n588: \n589:     const status = readAdvisorStatus({ workspaceRoot: root });\n590: \n591:     expect(status.skillCount).toBe(2);\n592:   });\n593: \n594:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n595:     const root = workspace('private-link-scan');\n596:     writeDb(root);\n597:     writeGeneration(root, 'live', 7);\n598:     const skills = join(root, '.skilled', 'skills');\n599:     const inside = join(skills, '.private', 'private-beta');\n600:     const outside = join(root, 'outside', 'private-evil');\n601:     for (const dir of [inside, outside]) {\n602:       mkdirSync(dir, { recursive: true });\n603:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n604:     }\n605:     symlinkSync(inside, join(skills, 'local-beta'));\n606:     symlinkSync(outside, join(skills, 'local-evil'));\n607: \n608:     const status = readAdvisorStatus({ workspaceRoot: root });\n609: \n610:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n611:     expect(status.skillCount).toBe(2);\n612:   });\n613: \n614:   it('probes the env-override artifact path the writer uses, read live', () => {\n615:     // The probe must target the file the writing daemon actually opens. With an\n616:     // env override set, the writer resolves there; the probe must too, even\n617:     // when called with an unrelated workspaceRoot. A healthy DB under the\n618:     // workspace would mask a corrupt override DB if the probe used the wrong\n619:     // base.\n620:     const workspaceRootDir = workspace('override-probe-workspace');\n621:     writeDb(workspaceRootDir);\n622:     writeGeneration(workspaceRootDir, 'live', 11);\n623: \n624:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n625:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n626:     // The generation counter follows the DB dir override, so the live\n627:     // generation the writing daemon published sits beside its database.\n628:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n629:       generation: 11,\n630:       updatedAt: '2026-04-20T00:00:00.000Z',\n631:       sourceSignature: null,\n632:       reason: 'LIVE_FIXTURE',\n633:       state: 'live',\n634:     })}\\n`, 'utf8');\n635: \n636:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n637:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n638:     try {\n639:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n640:       // Corruption is read from the OVERRIDE artifact, not the healthy\n641:       // workspace-relative DB, so freshness downgrades to stale.\n642:       expect(status.freshness).toBe('stale');\n643:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n644:     } finally {\n645:       if (previous === undefined) {\n646:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n647:       } else {\n648:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n649:       }\n650:     }\n651:   });\n652: \n653:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n654:     const root = workspace('corrupt-artifact');\n655:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n656:     writeGeneration(root, 'live', 12);\n657: \n658:     // Without the integrity opt-in the generation counters alone report live.\n659:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n660:     expect(optimistic.freshness).toBe('live');\n661: \n662:     // The recommend path opts in, so the same corrupt artifact reads stale.\n663:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n664:     expect(guarded.freshness).toBe('stale');\n665:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n666:   });\n667: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-667\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { beforeEach, describe, expect, it, vi } from 'vitest';\n11: \n12: const ollamaMocks = vi.hoisted(() => ({\n13:   probeOllamaModel: vi.fn(),\n14:   resolveOllamaBaseUrl: vi.fn(() => 'http://127.0.0.1:11434'),\n15: }));\n16: \n17: // The handler is the only caller that probes a backend, so the mock keeps\n18: // every other status case free of network access.\n19: vi.mock('../../lib/embedders/adapters/ollama.js', async (importOriginal) => {\n20:   const actual = await importOriginal<typeof import('../../lib/embedders/adapters/ollama.js')>();\n21:   return {\n22:     ...actual,\n23:     probeOllamaModel: ollamaMocks.probeOllamaModel,\n24:     resolveOllamaBaseUrl: ollamaMocks.resolveOllamaBaseUrl,\n25:   };\n26: });\n27: \n28: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n29: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n30: import {\n31:   createAdvisorHookDiagnosticRecord,\n32:   persistAdvisorHookDiagnosticRecord,\n33: } from '../../lib/metrics.js';\n34: import {\n35:   computeSkillMetadataContentHash,\n36:   readCommandEmbeddingSources,\n37: } from '../../lib/skill-graph/skill-graph-db.js';\n38: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n39: \n40: const ADVISOR_DB_RELATIVE_PATH = join(\n41:   '.skilled',\n42:   'skills',\n43:   'system-skill-advisor',\n44:   'runtime',\n45:   'database',\n46:   'skill-graph.sqlite',\n47: );\n48: \n49: function workspace(name: string): string {\n50:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n51:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n52:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n53:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n54:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n55:   return root;\n56: }\n57: \n58: function writeGeneration(\n59:   root: string,\n60:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n61:   generation = 1,\n62:   sourceSignature: string | null = null,\n63: ): void {\n64:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n65:     generation,\n66:     updatedAt: '2026-04-20T00:00:00.000Z',\n67:     sourceSignature,\n68:     reason: `${state.toUpperCase()}_FIXTURE`,\n69:     state,\n70:   })}\\n`, 'utf8');\n71: }\n72: \n73: function writeDb(root: string): void {\n74:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n75: }\n76: \n77: function writeIndexDb(root: string, contentHash: string | null): void {\n78:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n79:   try {\n80:     database.exec(`\n81:       CREATE TABLE skill_nodes (\n82:         id TEXT PRIMARY KEY,\n83:         source_path TEXT,\n84:         content_hash TEXT\n85:       );\n86:     `);\n87:     database.prepare(`\n88:       INSERT INTO skill_nodes (id, source_path, content_hash)\n89:       VALUES (?, ?, ?)\n90:     `).run(\n91:       'alpha',\n92:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n93:       contentHash,\n94:     );\n95:   } finally {\n96:     database.close();\n97:   }\n98: }\n99: \n100: function writeHealthDb(root: string): void {\n101:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n102:   try {\n103:     database.exec(`\n104:       CREATE TABLE skill_nodes (\n105:         id TEXT PRIMARY KEY,\n106:         embedding BLOB,\n107:         embedding_model_id TEXT,\n108:         embedding_content_hash TEXT\n109:       );\n110:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n111:       CREATE TABLE vec_768 (\n112:         skill_id TEXT PRIMARY KEY,\n113:         embedding BLOB NOT NULL,\n114:         model_id TEXT NOT NULL,\n115:         content_hash TEXT NOT NULL,\n116:         updated_at TEXT DEFAULT (datetime('now'))\n117:       );\n118:     `);\n119:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n120:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n121:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n122:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n123:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n124:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n125:   } finally {\n126:     database.close();\n127:   }\n128: }\n129: \n130: function writeCommandVectorTable(root: string, rows: number): void {\n131:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n132:   try {\n133:     database.exec(`\n134:       CREATE TABLE vec_cmd_768 (\n135:         command_id TEXT PRIMARY KEY,\n136:         embedding BLOB NOT NULL,\n137:         model_id TEXT NOT NULL,\n138:         content_hash TEXT NOT NULL,\n139:         updated_at TEXT DEFAULT (datetime('now'))\n140:       );\n141:     `);\n142:     const insert = database.prepare(`\n143:       INSERT INTO vec_cmd_768 (command_id, embedding, model_id, content_hash)\n144:       VALUES (?, ?, ?, ?)\n145:     `);\n146:     for (let index = 0; index < rows; index += 1) {\n147:       insert.run(`command-${index}`, Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', `hash-${index}`);\n148:     }\n149:   } finally {\n150:     database.close();\n151:   }\n152: }\n153: \n154: function writeDimMismatchHealthDb(root: string): void {\n155:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n156:   try {\n157:     database.exec(`\n158:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n159:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n160:       CREATE TABLE vec_123 (\n161:         skill_id TEXT PRIMARY KEY,\n162:         embedding BLOB NOT NULL,\n163:         model_id TEXT NOT NULL,\n164:         content_hash TEXT NOT NULL,\n165:         updated_at TEXT DEFAULT (datetime('now'))\n166:       );\n167:     `);\n168:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n169:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n170:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n171:   } finally {\n172:     database.close();\n173:   }\n174: }\n175: \n176: describe('advisor_status handler', () => {\n177:   beforeEach(() => {\n178:     ollamaMocks.probeOllamaModel.mockReset();\n179:     ollamaMocks.resolveOllamaBaseUrl.mockReset();\n180:     ollamaMocks.resolveOllamaBaseUrl.mockReturnValue('http://127.0.0.1:11434');\n181:   });\n182: \n183:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n184:     const root = workspace('linked');\n185:     const skills = join(root, '.skilled', 'skills');\n186:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n187:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n188:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n189:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n190:     const before = computeAdvisorSourceSignature(root);\n191:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n192:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n193:   });\n194: \n195:   it('ignores a private skill linked from outside every trusted root', () => {\n196:     const root = workspace('outside');\n197:     const skills = join(root, '.skilled', 'skills');\n198:     const outside = join(root, 'outside-beta');\n199:     mkdirSync(outside, { recursive: true });\n200:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n201:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n202:     symlinkSync(outside, join(skills, 'local-beta'));\n203:     const before = computeAdvisorSourceSignature(root);\n204:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n205:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n206:   });\n207: \n208:   it('includes a private skill linked into a declared external root', () => {\n209:     const root = workspace('declared');\n210:     const skills = join(root, '.skilled', 'skills');\n211:     const external = join(root, 'private-repos');\n212:     const target = join(external, 'sk-code-webflow');\n213:     mkdirSync(target, { recursive: true });\n214:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n215:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n216:     symlinkSync(target, join(skills, 'local-webflow'));\n217:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n218:     try {\n219:       const before = computeAdvisorSourceSignature(root);\n220:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n221:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n222:     } finally {\n223:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n224:     }\n225:   });\n226: \n227:   // drift: verified against shipped behavior during Unit H\n228:   it('reports live freshness', () => {\n229:     const root = workspace('live');\n230:     writeDb(root);\n231:     writeGeneration(root, 'live', 3);\n232: \n233:     const status = readAdvisorStatus({ workspaceRoot: root });\n234: \n235:     expect(status.freshness).toBe('live');\n236:     expect(status.trustState.state).toBe('live');\n237:     expect(status.generation).toBe(3);\n238:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n239:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n240:     expect(status.skillCount).toBe(1);\n241:     expect(status.laneWeights.explicit_author).toBe(0.42);\n242:     expect(status.semanticLaneHealth).toBeUndefined();\n243:   });\n244: \n245:   it('reports fresh index hashes without changing a live generation', () => {\n246:     const root = workspace('index-fresh');\n247:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n248:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n249:     writeIndexDb(root, contentHash);\n250:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n251: \n252:     const status = readAdvisorStatus({ workspaceRoot: root });\n253: \n254:     expect(status.freshness).toBe('live');\n255:     expect(status.indexStaleness).toEqual({\n256:       state: 'fresh',\n257:       reason: null,\n258:       trackedSkills: 1,\n259:       freshSourceFiles: 1,\n260:       changedSourceFiles: 0,\n261:       missingSourceFiles: 0,\n262:       staleSkillIds: [],\n263:     });\n264:   });\n265: \n266:   it('marks live generations stale when index hashes differ from disk', () => {\n267:     const root = workspace('index-stale');\n268:     writeIndexDb(root, 'outdated-hash');\n269:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n270: \n271:     const status = readAdvisorStatus({ workspaceRoot: root });\n272: \n273:     expect(status.freshness).toBe('stale');\n274:     expect(status.trustState.state).toBe('stale');\n275:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n276:       state: 'stale',\n277:       reason: 'source_hash_mismatch',\n278:       changedSourceFiles: 1,\n279:     }));\n280:     expect(status.errors).toContain(\n281:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n282:     );\n283:   });\n284: \n285:   it('reports unavailable index staleness when the database is absent', () => {\n286:     const root = workspace('index-absent');\n287:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n288: \n289:     const status = readAdvisorStatus({ workspaceRoot: root });\n290: \n291:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n292:       state: 'unavailable',\n293:       reason: 'database_absent',\n294:     }));\n295:   });\n296: \n297:   it('reports semantic-lane health only when requested', () => {\n298:     const root = workspace('semantic-health');\n299:     writeHealthDb(root);\n300:     writeGeneration(root, 'live', 8);\n301: \n302:     const compact = readAdvisorStatus({ workspaceRoot: root });\n303:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n304: \n305:     expect(compact.semanticLaneHealth).toBeUndefined();\n306:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n307:       activeEmbedder: expect.objectContaining({\n308:         name: 'nomic-embed-text-v1.5',\n309:         dim: 768,\n310:         adapterDim: 768,\n311:       }),\n312:       vectorCoverage: {\n313:         embedded: 1,\n314:         total: 2,\n315:         ratio: 0.5,\n316:       },\n317:       dimMismatch: false,\n318:       lastRefresh: '2026-04-20T00:00:00.000Z',\n319:       disabledReason: null,\n320:       laneEnabled: true,\n321:     }));\n322:   });\n323: \n324:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n325:     const root = workspace('semantic-dim-mismatch');\n326:     writeDimMismatchHealthDb(root);\n327:     writeGeneration(root, 'live', 9);\n328: \n329:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n330: \n331:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n332:       activeEmbedder: expect.objectContaining({\n333:         name: 'nomic-embed-text-v1.5',\n334:         dim: 123,\n335:         adapterDim: 768,\n336:       }),\n337:       dimMismatch: true,\n338:       disabledReason: 'dim_mismatch',\n339:       laneEnabled: false,\n340:     }));\n341:   });\n342: \n343:   it('reports zero command-vector coverage when no command table exists', () => {\n344:     const root = workspace('command-coverage-absent');\n345:     writeHealthDb(root);\n346:     writeGeneration(root, 'live', 10);\n347: \n348:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n349:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n350: \n351:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n352:       embedded: 0,\n353:       total: sourceTotal,\n354:     });\n355:   });\n356: \n357:   it('counts command-vector rows when the command table exists', () => {\n358:     const root = workspace('command-coverage-present');\n359:     writeHealthDb(root);\n360:     writeCommandVectorTable(root, 3);\n361:     writeGeneration(root, 'live', 10);\n362: \n363:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n364:     const sourceTotal = readCommandEmbeddingSources()?.length ?? 0;\n365: \n366:     expect(status.semanticLaneHealth?.commandVectorCoverage).toEqual({\n367:       embedded: 3,\n368:       total: sourceTotal,\n369:     });\n370:   });\n371: \n372:   it('reports a reachable backend when the model is loaded', async () => {\n373:     const root = workspace('backend-reachable');\n374:     writeHealthDb(root);\n375:     writeGeneration(root, 'live', 14);\n376:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: true });\n377: \n378:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n379:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n380:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n381: \n382:     expect(ollamaMocks.probeOllamaModel).toHaveBeenCalledWith(\n383:       'http://127.0.0.1:11434',\n384:       'nomic-embed-text:v1.5',\n385:       500,\n386:     );\n387:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'reachable', reason: null });\n388:     expect(status.semanticLaneHealth?.laneEnabled).toBe(true);\n389:   });\n390: \n391:   it('reports an unreachable backend when the probe cannot connect', async () => {\n392:     const root = workspace('backend-unreachable');\n393:     writeHealthDb(root);\n394:     writeGeneration(root, 'live', 14);\n395:     const reason = 'Ollama backend unreachable at http://127.0.0.1:11434: fetch failed';\n396:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n397: \n398:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n399:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n400:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n401: \n402:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'unreachable', reason });\n403:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n404:   });\n405: \n406:   it('reports a missing model when the server answers without it', async () => {\n407:     const root = workspace('backend-model-missing');\n408:     writeHealthDb(root);\n409:     writeGeneration(root, 'live', 14);\n410:     const reason = 'Ollama model is not loaded: nomic-embed-text:v1.5';\n411:     ollamaMocks.probeOllamaModel.mockResolvedValue({ available: false, reason });\n412: \n413:     const response = await handleAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n414:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n415:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n416: \n417:     expect(status.semanticLaneHealth?.backend).toEqual({ state: 'model_missing', reason });\n418:     expect(status.semanticLaneHealth?.laneEnabled).toBe(false);\n419:   });\n420: \n421:   // drift: verified against shipped behavior during Unit H\n422:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n423:     const root = workspace('signed-live');\n424:     writeDb(root);\n425:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n426:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n427:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n428:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n429:     const sourceSignature = computeAdvisorSourceSignature(root);\n430:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n431:       generation: 9,\n432:       updatedAt: '2026-04-22T00:00:00.000Z',\n433:       sourceSignature,\n434:       reason: 'advisor_rebuild',\n435:       state: 'live',\n436:     })}\\n`, 'utf8');\n437: \n438:     const status = readAdvisorStatus({ workspaceRoot: root });\n439: \n440:     expect(status.freshness).toBe('live');\n441:     expect(status.trustState.state).toBe('live');\n442:   });\n443: \n444:   // drift: verified against shipped behavior during Unit H\n445:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n446:     const root = workspace('nested-mtime');\n447:     writeDb(root);\n448:     writeGeneration(root, 'live', 6);\n449:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n450:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n451:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n452:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n453: \n454:     const status = readAdvisorStatus({ workspaceRoot: root });\n455: \n456:     expect(status.freshness).toBe('stale');\n457:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n458:   });\n459: \n460:   // drift: verified against shipped behavior during Unit H\n461:   it('reports stale freshness', () => {\n462:     const root = workspace('stale');\n463:     writeDb(root);\n464:     writeGeneration(root, 'stale', 4);\n465: \n466:     const status = readAdvisorStatus({ workspaceRoot: root });\n467: \n468:     expect(status.freshness).toBe('stale');\n469:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n470:   });\n471: \n472:   it('reports absent freshness when no artifact exists', () => {\n473:     const root = workspace('absent');\n474:     writeGeneration(root, 'absent', 0);\n475: \n476:     const status = readAdvisorStatus({ workspaceRoot: root });\n477: \n478:     expect(status.freshness).toBe('absent');\n479:   });\n480: \n481:   // drift: verified against shipped behavior during Unit H\n482:   it('reports unavailable for corrupt generation metadata', () => {\n483:     const root = workspace('unavailable');\n484:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n485: \n486:     const status = readAdvisorStatus({ workspaceRoot: root });\n487: \n488:     expect(status.freshness).toBe('unavailable');\n489:     expect(status.errors?.length).toBeGreaterThan(0);\n490:   });\n491: \n492:   it('does not leak prompt content in status output', async () => {\n493:     const root = workspace('privacy');\n494:     writeDb(root);\n495:     writeGeneration(root, 'live', 5);\n496: \n497:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n498: \n499:     expect(raw).not.toContain('prompt');\n500:     expect(raw).not.toContain('secret@example.com');\n501:   });\n502: \n503:   it('omits embeddings health when the option is absent', async () => {\n504:     const root = workspace('embeddings-health-omitted');\n505:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n506:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n507:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n508: \n509:     expect(status).not.toHaveProperty('embeddingsHealth');\n510:   });\n511: \n512:   it('reports hook health from durable diagnostic records', async () => {\n513:     const root = workspace('hook-health');\n514:     const previousDebug = process.env.SKILL_ADVISOR_DEBUG;\n515:     process.env.SKILL_ADVISOR_DEBUG = '1';\n516:     try {\n517:       for (const durationMs of [10, 30]) {\n518:         await persistAdvisorHookDiagnosticRecord(root, createAdvisorHookDiagnosticRecord({\n519:           runtime: 'claude',\n520:           status: 'ok',\n521:           freshness: 'live',\n522:           durationMs,\n523:           cacheHit: true,\n524:         }));\n525:       }\n526: \n527:       const status = readAdvisorStatus({ workspaceRoot: root });\n528: \n529:       expect(status.hookHealth?.invocations).toBe(2);\n530:     } finally {\n531:       if (previousDebug === undefined) delete process.env.SKILL_ADVISOR_DEBUG;\n532:       else process.env.SKILL_ADVISOR_DEBUG = previousDebug;\n533:     }\n534:   });\n535: \n536:   it('omits hook health when no diagnostic records exist', () => {\n537:     const root = workspace('hook-health-absent');\n538: \n539:     const status = readAdvisorStatus({ workspaceRoot: root });\n540: \n541:     expect(status).not.toHaveProperty('hookHealth');\n542:   });\n543: \n544:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n545:     const root = workspace('embeddings-health-unavailable');\n546:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n547: \n548:     try {\n549:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n550:       const response = await handleAdvisorStatus({\n551:         workspaceRoot: root,\n552:         includeEmbeddingsHealth: true,\n553:       });\n554:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n555:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n556: \n557:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n558:     } finally {\n559:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n560:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n561:     }\n562:   });\n563: \n564:   // drift: verified against shipped behavior during Unit H\n565:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n566:     const root = workspace('scan-cap');\n567:     writeDb(root);\n568:     writeGeneration(root, 'live', 7);\n569:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n570:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n571: \n572:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n573: \n574:     expect(status.skillCount).toBe(1);\n575:     expect(status.errors).toEqual([\n576:       expect.stringContaining('metadata scan capped at 1 files'),\n577:     ]);\n578:   });\n579: \n580:   it('counts only depth-one skill roots with graph metadata', () => {\n581:     const root = workspace('root-only-scan');\n582:     writeDb(root);\n583:     writeGeneration(root, 'live', 7);\n584:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n585:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n586:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n587:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n588: \n589:     const status = readAdvisorStatus({ workspaceRoot: root });\n590: \n591:     expect(status.skillCount).toBe(2);\n592:   });\n593: \n594:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n595:     const root = workspace('private-link-scan');\n596:     writeDb(root);\n597:     writeGeneration(root, 'live', 7);\n598:     const skills = join(root, '.skilled', 'skills');\n599:     const inside = join(skills, '.private', 'private-beta');\n600:     const outside = join(root, 'outside', 'private-evil');\n601:     for (const dir of [inside, outside]) {\n602:       mkdirSync(dir, { recursive: true });\n603:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n604:     }\n605:     symlinkSync(inside, join(skills, 'local-beta'));\n606:     symlinkSync(outside, join(skills, 'local-evil'));\n607: \n608:     const status = readAdvisorStatus({ workspaceRoot: root });\n609: \n610:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n611:     expect(status.skillCount).toBe(2);\n612:   });\n613: \n614:   it('probes the env-override artifact path the writer uses, read live', () => {\n615:     // The probe must target the file the writing daemon actually opens. With an\n616:     // env override set, the writer resolves there; the probe must too, even\n617:     // when called with an unrelated workspaceRoot. A healthy DB under the\n618:     // workspace would mask a corrupt override DB if the probe used the wrong\n619:     // base.\n620:     const workspaceRootDir = workspace('override-probe-workspace');\n621:     writeDb(workspaceRootDir);\n622:     writeGeneration(workspaceRootDir, 'live', 11);\n623: \n624:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n625:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n626:     // The generation counter follows the DB dir override, so the live\n627:     // generation the writing daemon published sits beside its database.\n628:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n629:       generation: 11,\n630:       updatedAt: '2026-04-20T00:00:00.000Z',\n631:       sourceSignature: null,\n632:       reason: 'LIVE_FIXTURE',\n633:       state: 'live',\n634:     })}\\n`, 'utf8');\n635: \n636:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n637:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n638:     try {\n639:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n640:       // Corruption is read from the OVERRIDE artifact, not the healthy\n641:       // workspace-relative DB, so freshness downgrades to stale.\n642:       expect(status.freshness).toBe('stale');\n643:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n644:     } finally {\n645:       if (previous === undefined) {\n646:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n647:       } else {\n648:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n649:       }\n650:     }\n651:   });\n652: \n653:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n654:     const root = workspace('corrupt-artifact');\n655:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n656:     writeGeneration(root, 'live', 12);\n657: \n658:     // Without the integrity opt-in the generation counters alone report live.\n659:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n660:     expect(optimistic.freshness).toBe('live');\n661: \n662:     // The recommend path opts in, so the same corrupt artifact reads stale.\n663:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n664:     expect(guarded.freshness).toBe('stale');\n665:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n666:   });\n667: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\"}"},"time":{"start":1794564784838,"end":1794564785445}}}}
