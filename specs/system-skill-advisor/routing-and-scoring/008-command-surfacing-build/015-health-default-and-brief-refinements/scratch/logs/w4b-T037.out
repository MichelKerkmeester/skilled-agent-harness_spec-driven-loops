{"type":"tool_use","timestamp":1794565734809,"sessionID":"ses_e2b8c797effexFRuALsrXCS7qn","part":{"partID":"prt_1d4740013001fALQj0U2lOa7tD","sessionID":"ses_e2b8c797effexFRuALsrXCS7qn","messageID":"msg_1d473c1bd001YDpvRuoTLwuoAM","type":"tool","id":"call_37b53a70b370498dbd2040fc","tool":"read","state":{"status":"error","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-offer.ts"},"error":"File not found: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-offer.ts","metadata":{"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/command-offer.ts\"}"},"time":{"start":1794565734419,"end":1794565734809}}}}
{"type":"tool_use","timestamp":1794565734832,"sessionID":"ses_e2b8c797effexFRuALsrXCS7qn","part":{"partID":"prt_1d473fe48001fsB6e8aNkrAams","sessionID":"ses_e2b8c797effexFRuALsrXCS7qn","messageID":"msg_1d473c1bd001YDpvRuoTLwuoAM","type":"tool","id":"call_904a282649da43fc9052aae4","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-424\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss. The backfill cases pin that a line keeps its place\n14: // when its checkout is gone, that a refused row leaves no output behind, and\n15: // that the new log never replaces the one it reads.\n16: \n17: import { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { join } from 'node:path';\n20: \n21: import { describe, expect, it } from 'vitest';\n22: \n23: import {\n24:   backfillRunLog,\n25:   briefDelivered,\n26:   codexHookApproval,\n27:   parseOffer,\n28:   replayOffer,\n29: } from '../scripts/routing-accuracy/command-offer.mjs';\n30: \n31: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n32: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n33: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n34: const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n35: const CODEX_HOOKS = {\n36:   hooks: {\n37:     UserPromptSubmit: [\n38:       { hooks: [{ command: 'node x/hooks/codex/user-prompt-submit.js' }] },\n39:     ],\n40:   },\n41: };\n42: \n43: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n44:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n45:   const transcriptPath = join(dir, 'session.jsonl');\n46:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n47:   return { dir, transcriptPath };\n48: }\n49: \n50: function writeRunLog(dir: string, lines: unknown[]): string {\n51:   const inPath = join(dir, 'runs.jsonl');\n52:   writeFileSync(inPath, lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n');\n53:   return inPath;\n54: }\n55: \n56: function writeCodexRoot(withHooks: boolean): { dir: string; hooksPath: string } {\n57:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-codex-'));\n58:   const hooksPath = join(dir, '.codex', 'hooks.json');\n59:   if (withHooks) {\n60:     mkdirSync(join(dir, '.codex'), { recursive: true });\n61:     writeFileSync(hooksPath, JSON.stringify(CODEX_HOOKS));\n62:   }\n63:   return { dir, hooksPath };\n64: }\n65: \n66: function writeCodexConfig(dir: string, lines: string[]): string {\n67:   const configPath = join(dir, 'config.toml');\n68:   writeFileSync(configPath, lines.map((line) => `${line}\\n`).join(''));\n69:   return configPath;\n70: }\n71: \n72: describe('parseOffer', () => {\n73:   it('reads the command and the policy a head offers', () => {\n74:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n75:       offeredCommand: '/doctor:git hooks',\n76:       offeredPolicy: 'ask',\n77:     });\n78:   });\n79: \n80:   it('reads the command but no policy under an ambiguous head', () => {\n81:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n82:       offeredCommand: '/doctor:git hooks',\n83:       offeredPolicy: null,\n84:     });\n85:   });\n86: \n87:   it('reads no command when the head names none', () => {\n88:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n89:       offeredCommand: null,\n90:       offeredPolicy: null,\n91:     });\n92:   });\n93: });\n94: \n95: describe('replayOffer', () => {\n96:   it('reports a checkout without the prompt hook instead of throwing', () => {\n97:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n98:     try {\n99:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n100:         offeredCommand: null,\n101:         offeredPolicy: null,\n102:         offerError: 'hook_missing',\n103:       });\n104:     } finally {\n105:       rmSync(checkoutDir, { recursive: true, force: true });\n106:     }\n107:   });\n108: });\n109: \n110: describe('codexHookApproval', () => {\n111:   it('reports an advisor hook that no config entry approves as unapproved', () => {\n112:     const { dir } = writeCodexRoot(true);\n113:     try {\n114:       const configPath = writeCodexConfig(dir, []);\n115:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('unapproved');\n116:     } finally {\n117:       rmSync(dir, { recursive: true, force: true });\n118:     }\n119:   });\n120: \n121:   it('reports an advisor hook approved by a trusted hash as approved', () => {\n122:     const { dir, hooksPath } = writeCodexRoot(true);\n123:     try {\n124:       const configPath = writeCodexConfig(dir, [\n125:         `[hooks.state.\"${realpathSync(hooksPath)}:user_prompt_submit:0:0\"]`,\n126:         'trusted_hash = \"x\"',\n127:       ]);\n128:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('approved');\n129:     } finally {\n130:       rmSync(dir, { recursive: true, force: true });\n131:     }\n132:   });\n133: \n134:   it('reports a root with no hooks file as no-hooks', () => {\n135:     const { dir } = writeCodexRoot(false);\n136:     try {\n137:       expect(codexHookApproval({ projectDir: dir })).toBe('no-hooks');\n138:     } finally {\n139:       rmSync(dir, { recursive: true, force: true });\n140:     }\n141:   });\n142: });\n143: \n144: describe('briefDelivered', () => {\n145:   it('finds the advisor context in a Claude transcript attachment', async () => {\n146:     const { dir, transcriptPath } = writeTranscript([\n147:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n148:       {\n149:         type: 'attachment',\n150:         attachment: {\n151:           type: 'hook_additional_context',\n152:           hookEvent: 'UserPromptSubmit',\n153:           content: [OFFERED_HEAD],\n154:         },\n155:       },\n156:     ]);\n157:     try {\n158:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n159:     } finally {\n160:       rmSync(dir, { recursive: true, force: true });\n161:     }\n162:   });\n163: \n164:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n165:     const { dir, transcriptPath } = writeTranscript([\n166:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n167:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n168:     ]);\n169:     try {\n170:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n171:     } finally {\n172:       rmSync(dir, { recursive: true, force: true });\n173:     }\n174:   });\n175: \n176:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n177:     await expect(briefDelivered({\n178:       runtime: 'devin',\n179:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n180:     })).resolves.toBe('unknown');\n181:   });\n182: \n183:   it('finds the advisor context in Devin injected nodes', async () => {\n184:     await expect(briefDelivered({\n185:       runtime: 'devin',\n186:       locator: {},\n187:       loadSession: async () => ({ ok: true, records: [], injected: [{ source: 'system', text: BRIEF }] }),\n188:     })).resolves.toBe(true);\n189:   });\n190: \n191:   it('returns false for a DSH session whose injected context holds no brief', async () => {\n192:     await expect(briefDelivered({\n193:       runtime: 'dsh',\n194:       locator: {},\n195:       loadSession: async () => ({\n196:         ok: true,\n197:         records: [],\n198:         injected: [{ source: 'repo-guards', text: 'Repository guard rules apply.' }],\n199:       }),\n200:     })).resolves.toBe(false);\n201:   });\n202: \n203:   it('stays unknown for an OpenCode session that holds the brief in its records', async () => {\n204:     await expect(briefDelivered({\n205:       runtime: 'opencode',\n206:       locator: {},\n207:       loadSession: async () => ({ ok: true, records: [{ role: 'system', content: BRIEF }], injected: [] }),\n208:     })).resolves.toBe('unknown');\n209:   });\n210: \n211:   it('returns false for a Codex hook the config never approved', async () => {\n212:     const { dir } = writeCodexRoot(true);\n213:     try {\n214:       const configPath = writeCodexConfig(dir, []);\n215:       await expect(briefDelivered({\n216:         runtime: 'codex',\n217:         locator: { projectDir: dir },\n218:         codexConfig: configPath,\n219:       })).resolves.toBe(false);\n220:     } finally {\n221:       rmSync(dir, { recursive: true, force: true });\n222:     }\n223:   });\n224: });\n225: \n226: describe('backfillRunLog', () => {\n227:   it('adds the offer and the brief to every line and warms each checkout once', async () => {\n228:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n229:     const outPath = join(dir, 'runs-out.jsonl');\n230:     const inPath = writeRunLog(dir, [\n231:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n232:       { runtime: 'claude', rowId: 'row-two', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n233:     ]);\n234:     const before = readFileSync(inPath, 'utf8');\n235:     const warmed: string[] = [];\n236:     const replayed: Array<{ checkoutDir: string; prompt: string; sessionId: string }> = [];\n237:     const seen: Array<{ runtime: string; locator: unknown }> = [];\n238:     try {\n239:       const result = await backfillRunLog({\n240:         inPath,\n241:         outPath,\n242:         promptFor: (rowId: string) => `prompt for ${rowId}`,\n243:         warm: async (checkoutDir: string) => {\n244:           warmed.push(checkoutDir);\n245:         },\n246:         replay: async ({ checkoutDir, prompt, sessionId }: { checkoutDir: string; prompt: string; sessionId: string }) => {\n247:           replayed.push({ checkoutDir, prompt, sessionId });\n248:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'ask', offerError: null };\n249:         },\n250:         brief: async ({ runtime, locator }: { runtime: string; locator: unknown }) => {\n251:           seen.push({ runtime, locator });\n252:           return true;\n253:         },\n254:       });\n255: \n256:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n257:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n258:       expect(written).toHaveLength(2);\n259:       expect(written[0]).toMatchObject({\n260:         rowId: 'row-one',\n261:         offeredCommand: '/doctor:git hooks',\n262:         offeredPolicy: 'ask',\n263:         offerError: null,\n264:         briefDelivered: true,\n265:         offerBackfilled: true,\n266:       });\n267:       expect(written[1].rowId).toBe('row-two');\n268:       expect(warmed).toEqual(['/checkout-one']);\n269:       expect(replayed.map((call) => call.sessionId)).toEqual(['backfill-row-one', 'backfill-row-two']);\n270:       expect(replayed[0]).toMatchObject({ checkoutDir: '/checkout-one', prompt: 'prompt for row-one' });\n271:       expect(seen).toHaveLength(2);\n272:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n273:     } finally {\n274:       rmSync(dir, { recursive: true, force: true });\n275:     }\n276:   });\n277: \n278:   it('recomputes only the brief when the offers are already recorded', async () => {\n279:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n280:     const outPath = join(dir, 'runs-out.jsonl');\n281:     const inPath = writeRunLog(dir, [\n282:       {\n283:         runtime: 'claude',\n284:         rowId: 'row-with-offer',\n285:         arm: 'post',\n286:         locator: { projectDir: '/checkout-one' },\n287:         exit: 0,\n288:         changedPaths: [],\n289:         offeredCommand: '/create:readme',\n290:         offeredPolicy: 'start',\n291:         offerBackfilled: true,\n292:       },\n293:       { runtime: 'codex', rowId: 'row-without-offer', arm: 'post', locator: null, exit: 0, changedPaths: [] },\n294:     ]);\n295:     let warmed = 0;\n296:     let replayed = 0;\n297:     try {\n298:       const result = await backfillRunLog({\n299:         inPath,\n300:         outPath,\n301:         briefOnly: true,\n302:         promptFor: () => 'prompt',\n303:         warm: async () => {\n304:           warmed += 1;\n305:         },\n306:         replay: async () => {\n307:           replayed += 1;\n308:           return { offeredCommand: '/create:readme', offeredPolicy: 'start', offerError: null };\n309:         },\n310:         brief: async () => true,\n311:       });\n312: \n313:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n314:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n315:       expect(written[0]).toMatchObject({\n316:         rowId: 'row-with-offer',\n317:         offeredCommand: '/create:readme',\n318:         offeredPolicy: 'start',\n319:         briefDelivered: true,\n320:         briefBackfilled: true,\n321:       });\n322:       expect(written[0]).not.toHaveProperty('offerError');\n323:       expect(written[1]).toMatchObject({\n324:         rowId: 'row-without-offer',\n325:         briefDelivered: true,\n326:         briefBackfilled: true,\n327:       });\n328:       expect(written[1]).not.toHaveProperty('offeredCommand');\n329:       expect(written[1]).not.toHaveProperty('offerError');\n330:       expect(warmed).toBe(0);\n331:       expect(replayed).toBe(0);\n332:     } finally {\n333:       rmSync(dir, { recursive: true, force: true });\n334:     }\n335:   });\n336: \n337:   it('marks a line whose locator names no checkout instead of replaying it', async () => {\n338:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n339:     const outPath = join(dir, 'runs-out.jsonl');\n340:     const inPath = writeRunLog(dir, [\n341:       { runtime: 'codex', rowId: 'row-no-checkout', arm: 'pre', locator: null, exit: 0, changedPaths: [] },\n342:     ]);\n343:     let warmed = 0;\n344:     let replayed = 0;\n345:     try {\n346:       const result = await backfillRunLog({\n347:         inPath,\n348:         outPath,\n349:         promptFor: () => 'prompt',\n350:         warm: async () => {\n351:           warmed += 1;\n352:         },\n353:         replay: async () => {\n354:           replayed += 1;\n355:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'run', offerError: null };\n356:         },\n357:         brief: async () => 'unknown',\n358:       });\n359: \n360:       expect(result).toMatchObject({ ok: true, lines: 1 });\n361:       const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n362:       expect(written).toMatchObject({\n363:         offeredCommand: null,\n364:         offeredPolicy: null,\n365:         offerError: 'no_checkout',\n366:         briefDelivered: 'unknown',\n367:         offerBackfilled: true,\n368:       });\n369:       expect(warmed).toBe(0);\n370:       expect(replayed).toBe(0);\n371:     } finally {\n372:       rmSync(dir, { recursive: true, force: true });\n373:     }\n374:   });\n375: \n376:   it('refuses a row the prompt lookup rejects before it writes anything', async () => {\n377:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n378:     const outPath = join(dir, 'runs-out.jsonl');\n379:     const inPath = writeRunLog(dir, [\n380:       { runtime: 'claude', rowId: 'row-plain', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n381:       { runtime: 'claude', rowId: 'row-holdout', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n382:     ]);\n383:     let replayed = 0;\n384:     try {\n385:       const result = await backfillRunLog({\n386:         inPath,\n387:         outPath,\n388:         promptFor: (rowId: string) => {\n389:           if (rowId === 'row-holdout') {\n390:             throw Object.assign(new Error(`${rowId}: a holdout row is never run`), { code: 'holdout_row' });\n391:           }\n392:           return 'prompt';\n393:         },\n394:         replay: async () => {\n395:           replayed += 1;\n396:           return { offeredCommand: null, offeredPolicy: null, offerError: null };\n397:         },\n398:         brief: async () => 'unknown',\n399:       });\n400: \n401:       expect(result).toMatchObject({ ok: false, code: 'holdout_row' });\n402:       expect(existsSync(outPath)).toBe(false);\n403:       expect(replayed).toBe(0);\n404:     } finally {\n405:       rmSync(dir, { recursive: true, force: true });\n406:     }\n407:   });\n408: \n409:   it('refuses to write over its own input', async () => {\n410:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n411:     const inPath = writeRunLog(dir, [\n412:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n413:     ]);\n414:     const before = readFileSync(inPath, 'utf8');\n415:     try {\n416:       const result = await backfillRunLog({ inPath, outPath: inPath, promptFor: () => 'prompt' });\n417: \n418:       expect(result).toMatchObject({ ok: false, code: 'same_path' });\n419:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n420:     } finally {\n421:       rmSync(dir, { recursive: true, force: true });\n422:     }\n423:   });\n424: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-424\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss. The backfill cases pin that a line keeps its place\n14: // when its checkout is gone, that a refused row leaves no output behind, and\n15: // that the new log never replaces the one it reads.\n16: \n17: import { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { join } from 'node:path';\n20: \n21: import { describe, expect, it } from 'vitest';\n22: \n23: import {\n24:   backfillRunLog,\n25:   briefDelivered,\n26:   codexHookApproval,\n27:   parseOffer,\n28:   replayOffer,\n29: } from '../scripts/routing-accuracy/command-offer.mjs';\n30: \n31: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n32: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n33: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n34: const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n35: const CODEX_HOOKS = {\n36:   hooks: {\n37:     UserPromptSubmit: [\n38:       { hooks: [{ command: 'node x/hooks/codex/user-prompt-submit.js' }] },\n39:     ],\n40:   },\n41: };\n42: \n43: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n44:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n45:   const transcriptPath = join(dir, 'session.jsonl');\n46:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n47:   return { dir, transcriptPath };\n48: }\n49: \n50: function writeRunLog(dir: string, lines: unknown[]): string {\n51:   const inPath = join(dir, 'runs.jsonl');\n52:   writeFileSync(inPath, lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n');\n53:   return inPath;\n54: }\n55: \n56: function writeCodexRoot(withHooks: boolean): { dir: string; hooksPath: string } {\n57:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-codex-'));\n58:   const hooksPath = join(dir, '.codex', 'hooks.json');\n59:   if (withHooks) {\n60:     mkdirSync(join(dir, '.codex'), { recursive: true });\n61:     writeFileSync(hooksPath, JSON.stringify(CODEX_HOOKS));\n62:   }\n63:   return { dir, hooksPath };\n64: }\n65: \n66: function writeCodexConfig(dir: string, lines: string[]): string {\n67:   const configPath = join(dir, 'config.toml');\n68:   writeFileSync(configPath, lines.map((line) => `${line}\\n`).join(''));\n69:   return configPath;\n70: }\n71: \n72: describe('parseOffer', () => {\n73:   it('reads the command and the policy a head offers', () => {\n74:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n75:       offeredCommand: '/doctor:git hooks',\n76:       offeredPolicy: 'ask',\n77:     });\n78:   });\n79: \n80:   it('reads the command but no policy under an ambiguous head', () => {\n81:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n82:       offeredCommand: '/doctor:git hooks',\n83:       offeredPolicy: null,\n84:     });\n85:   });\n86: \n87:   it('reads no command when the head names none', () => {\n88:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n89:       offeredCommand: null,\n90:       offeredPolicy: null,\n91:     });\n92:   });\n93: });\n94: \n95: describe('replayOffer', () => {\n96:   it('reports a checkout without the prompt hook instead of throwing', () => {\n97:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n98:     try {\n99:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n100:         offeredCommand: null,\n101:         offeredPolicy: null,\n102:         offerError: 'hook_missing',\n103:       });\n104:     } finally {\n105:       rmSync(checkoutDir, { recursive: true, force: true });\n106:     }\n107:   });\n108: });\n109: \n110: describe('codexHookApproval', () => {\n111:   it('reports an advisor hook that no config entry approves as unapproved', () => {\n112:     const { dir } = writeCodexRoot(true);\n113:     try {\n114:       const configPath = writeCodexConfig(dir, []);\n115:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('unapproved');\n116:     } finally {\n117:       rmSync(dir, { recursive: true, force: true });\n118:     }\n119:   });\n120: \n121:   it('reports an advisor hook approved by a trusted hash as approved', () => {\n122:     const { dir, hooksPath } = writeCodexRoot(true);\n123:     try {\n124:       const configPath = writeCodexConfig(dir, [\n125:         `[hooks.state.\"${realpathSync(hooksPath)}:user_prompt_submit:0:0\"]`,\n126:         'trusted_hash = \"x\"',\n127:       ]);\n128:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('approved');\n129:     } finally {\n130:       rmSync(dir, { recursive: true, force: true });\n131:     }\n132:   });\n133: \n134:   it('reports a root with no hooks file as no-hooks', () => {\n135:     const { dir } = writeCodexRoot(false);\n136:     try {\n137:       expect(codexHookApproval({ projectDir: dir })).toBe('no-hooks');\n138:     } finally {\n139:       rmSync(dir, { recursive: true, force: true });\n140:     }\n141:   });\n142: });\n143: \n144: describe('briefDelivered', () => {\n145:   it('finds the advisor context in a Claude transcript attachment', async () => {\n146:     const { dir, transcriptPath } = writeTranscript([\n147:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n148:       {\n149:         type: 'attachment',\n150:         attachment: {\n151:           type: 'hook_additional_context',\n152:           hookEvent: 'UserPromptSubmit',\n153:           content: [OFFERED_HEAD],\n154:         },\n155:       },\n156:     ]);\n157:     try {\n158:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n159:     } finally {\n160:       rmSync(dir, { recursive: true, force: true });\n161:     }\n162:   });\n163: \n164:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n165:     const { dir, transcriptPath } = writeTranscript([\n166:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n167:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n168:     ]);\n169:     try {\n170:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n171:     } finally {\n172:       rmSync(dir, { recursive: true, force: true });\n173:     }\n174:   });\n175: \n176:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n177:     await expect(briefDelivered({\n178:       runtime: 'devin',\n179:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n180:     })).resolves.toBe('unknown');\n181:   });\n182: \n183:   it('finds the advisor context in Devin injected nodes', async () => {\n184:     await expect(briefDelivered({\n185:       runtime: 'devin',\n186:       locator: {},\n187:       loadSession: async () => ({ ok: true, records: [], injected: [{ source: 'system', text: BRIEF }] }),\n188:     })).resolves.toBe(true);\n189:   });\n190: \n191:   it('returns false for a DSH session whose injected context holds no brief', async () => {\n192:     await expect(briefDelivered({\n193:       runtime: 'dsh',\n194:       locator: {},\n195:       loadSession: async () => ({\n196:         ok: true,\n197:         records: [],\n198:         injected: [{ source: 'repo-guards', text: 'Repository guard rules apply.' }],\n199:       }),\n200:     })).resolves.toBe(false);\n201:   });\n202: \n203:   it('stays unknown for an OpenCode session that holds the brief in its records', async () => {\n204:     await expect(briefDelivered({\n205:       runtime: 'opencode',\n206:       locator: {},\n207:       loadSession: async () => ({ ok: true, records: [{ role: 'system', content: BRIEF }], injected: [] }),\n208:     })).resolves.toBe('unknown');\n209:   });\n210: \n211:   it('returns false for a Codex hook the config never approved', async () => {\n212:     const { dir } = writeCodexRoot(true);\n213:     try {\n214:       const configPath = writeCodexConfig(dir, []);\n215:       await expect(briefDelivered({\n216:         runtime: 'codex',\n217:         locator: { projectDir: dir },\n218:         codexConfig: configPath,\n219:       })).resolves.toBe(false);\n220:     } finally {\n221:       rmSync(dir, { recursive: true, force: true });\n222:     }\n223:   });\n224: });\n225: \n226: describe('backfillRunLog', () => {\n227:   it('adds the offer and the brief to every line and warms each checkout once', async () => {\n228:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n229:     const outPath = join(dir, 'runs-out.jsonl');\n230:     const inPath = writeRunLog(dir, [\n231:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n232:       { runtime: 'claude', rowId: 'row-two', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n233:     ]);\n234:     const before = readFileSync(inPath, 'utf8');\n235:     const warmed: string[] = [];\n236:     const replayed: Array<{ checkoutDir: string; prompt: string; sessionId: string }> = [];\n237:     const seen: Array<{ runtime: string; locator: unknown }> = [];\n238:     try {\n239:       const result = await backfillRunLog({\n240:         inPath,\n241:         outPath,\n242:         promptFor: (rowId: string) => `prompt for ${rowId}`,\n243:         warm: async (checkoutDir: string) => {\n244:           warmed.push(checkoutDir);\n245:         },\n246:         replay: async ({ checkoutDir, prompt, sessionId }: { checkoutDir: string; prompt: string; sessionId: string }) => {\n247:           replayed.push({ checkoutDir, prompt, sessionId });\n248:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'ask', offerError: null };\n249:         },\n250:         brief: async ({ runtime, locator }: { runtime: string; locator: unknown }) => {\n251:           seen.push({ runtime, locator });\n252:           return true;\n253:         },\n254:       });\n255: \n256:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n257:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n258:       expect(written).toHaveLength(2);\n259:       expect(written[0]).toMatchObject({\n260:         rowId: 'row-one',\n261:         offeredCommand: '/doctor:git hooks',\n262:         offeredPolicy: 'ask',\n263:         offerError: null,\n264:         briefDelivered: true,\n265:         offerBackfilled: true,\n266:       });\n267:       expect(written[1].rowId).toBe('row-two');\n268:       expect(warmed).toEqual(['/checkout-one']);\n269:       expect(replayed.map((call) => call.sessionId)).toEqual(['backfill-row-one', 'backfill-row-two']);\n270:       expect(replayed[0]).toMatchObject({ checkoutDir: '/checkout-one', prompt: 'prompt for row-one' });\n271:       expect(seen).toHaveLength(2);\n272:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n273:     } finally {\n274:       rmSync(dir, { recursive: true, force: true });\n275:     }\n276:   });\n277: \n278:   it('recomputes only the brief when the offers are already recorded', async () => {\n279:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n280:     const outPath = join(dir, 'runs-out.jsonl');\n281:     const inPath = writeRunLog(dir, [\n282:       {\n283:         runtime: 'claude',\n284:         rowId: 'row-with-offer',\n285:         arm: 'post',\n286:         locator: { projectDir: '/checkout-one' },\n287:         exit: 0,\n288:         changedPaths: [],\n289:         offeredCommand: '/create:readme',\n290:         offeredPolicy: 'start',\n291:         offerBackfilled: true,\n292:       },\n293:       { runtime: 'codex', rowId: 'row-without-offer', arm: 'post', locator: null, exit: 0, changedPaths: [] },\n294:     ]);\n295:     let warmed = 0;\n296:     let replayed = 0;\n297:     try {\n298:       const result = await backfillRunLog({\n299:         inPath,\n300:         outPath,\n301:         briefOnly: true,\n302:         promptFor: () => 'prompt',\n303:         warm: async () => {\n304:           warmed += 1;\n305:         },\n306:         replay: async () => {\n307:           replayed += 1;\n308:           return { offeredCommand: '/create:readme', offeredPolicy: 'start', offerError: null };\n309:         },\n310:         brief: async () => true,\n311:       });\n312: \n313:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n314:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n315:       expect(written[0]).toMatchObject({\n316:         rowId: 'row-with-offer',\n317:         offeredCommand: '/create:readme',\n318:         offeredPolicy: 'start',\n319:         briefDelivered: true,\n320:         briefBackfilled: true,\n321:       });\n322:       expect(written[0]).not.toHaveProperty('offerError');\n323:       expect(written[1]).toMatchObject({\n324:         rowId: 'row-without-offer',\n325:         briefDelivered: true,\n326:         briefBackfilled: true,\n327:       });\n328:       expect(written[1]).not.toHaveProperty('offeredCommand');\n329:       expect(written[1]).not.toHaveProperty('offerError');\n330:       expect(warmed).toBe(0);\n331:       expect(replayed).toBe(0);\n332:     } finally {\n333:       rmSync(dir, { recursive: true, force: true });\n334:     }\n335:   });\n336: \n337:   it('marks a line whose locator names no checkout instead of replaying it', async () => {\n338:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n339:     const outPath = join(dir, 'runs-out.jsonl');\n340:     const inPath = writeRunLog(dir, [\n341:       { runtime: 'codex', rowId: 'row-no-checkout', arm: 'pre', locator: null, exit: 0, changedPaths: [] },\n342:     ]);\n343:     let warmed = 0;\n344:     let replayed = 0;\n345:     try {\n346:       const result = await backfillRunLog({\n347:         inPath,\n348:         outPath,\n349:         promptFor: () => 'prompt',\n350:         warm: async () => {\n351:           warmed += 1;\n352:         },\n353:         replay: async () => {\n354:           replayed += 1;\n355:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'run', offerError: null };\n356:         },\n357:         brief: async () => 'unknown',\n358:       });\n359: \n360:       expect(result).toMatchObject({ ok: true, lines: 1 });\n361:       const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n362:       expect(written).toMatchObject({\n363:         offeredCommand: null,\n364:         offeredPolicy: null,\n365:         offerError: 'no_checkout',\n366:         briefDelivered: 'unknown',\n367:         offerBackfilled: true,\n368:       });\n369:       expect(warmed).toBe(0);\n370:       expect(replayed).toBe(0);\n371:     } finally {\n372:       rmSync(dir, { recursive: true, force: true });\n373:     }\n374:   });\n375: \n376:   it('refuses a row the prompt lookup rejects before it writes anything', async () => {\n377:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n378:     const outPath = join(dir, 'runs-out.jsonl');\n379:     const inPath = writeRunLog(dir, [\n380:       { runtime: 'claude', rowId: 'row-plain', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n381:       { runtime: 'claude', rowId: 'row-holdout', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n382:     ]);\n383:     let replayed = 0;\n384:     try {\n385:       const result = await backfillRunLog({\n386:         inPath,\n387:         outPath,\n388:         promptFor: (rowId: string) => {\n389:           if (rowId === 'row-holdout') {\n390:             throw Object.assign(new Error(`${rowId}: a holdout row is never run`), { code: 'holdout_row' });\n391:           }\n392:           return 'prompt';\n393:         },\n394:         replay: async () => {\n395:           replayed += 1;\n396:           return { offeredCommand: null, offeredPolicy: null, offerError: null };\n397:         },\n398:         brief: async () => 'unknown',\n399:       });\n400: \n401:       expect(result).toMatchObject({ ok: false, code: 'holdout_row' });\n402:       expect(existsSync(outPath)).toBe(false);\n403:       expect(replayed).toBe(0);\n404:     } finally {\n405:       rmSync(dir, { recursive: true, force: true });\n406:     }\n407:   });\n408: \n409:   it('refuses to write over its own input', async () => {\n410:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n411:     const inPath = writeRunLog(dir, [\n412:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n413:     ]);\n414:     const before = readFileSync(inPath, 'utf8');\n415:     try {\n416:       const result = await backfillRunLog({ inPath, outPath: inPath, promptFor: () => 'prompt' });\n417: \n418:       expect(result).toMatchObject({ ok: false, code: 'same_path' });\n419:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n420:     } finally {\n421:       rmSync(dir, { recursive: true, force: true });\n422:     }\n423:   });\n424: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\"}"},"time":{"start":1794565733960,"end":1794565734832}}}}
