 () => 'write a README for the ledger module',\n+    })).resolves.toBeNull();\n+  });\n+\n+  it('treats a candidate whose first user message cannot be read as no match', async () => {\n+    await expect(promptSessionId({\n+      before: [],\n+      after: ['session-torn', 'session-two'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => {\n+        if (id === 'session-torn') throw new Error('unreadable session');\n+        return 'write a README for the ledger module';\n+      },\n+    })).resolves.toBe('session-two');\n+  });\n+});\n+\n describe('replayOffer', () => {\n   it('reports a checkout without the prompt hook instead of throwing', () => {\n     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex c66bae3796..4e58e52bf1 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -25,6 +25,7 @@ import {\n   briefDelivered,\n   codexHookApproval,\n   parseOffer,\n+  promptSessionId,\n   replayOffer,\n } from '../scripts/routing-accuracy/command-offer.mjs';\n \n@@ -92,6 +93,40 @@ describe('parseOffer', () => {\n   });\n });\n \n+describe('promptSessionId', () => {\n+  it('returns the one added session whose first user message is the prompt', async () => {\n+    await expect(promptSessionId({\n+      before: ['session-one'],\n+      after: ['session-one', 'session-two', 'session-three'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => (\n+        id === 'session-two' ? 'write a README for the ledger module' : 'a helper turn'\n+      ),\n+    })).resolves.toBe('session-two');\n+  });\n+\n+  it('returns no session when two added sessions both hold the prompt', async () => {\n+    await expect(promptSessionId({\n+      before: ['session-one'],\n+      after: ['session-one', 'session-two', 'session-three'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async () => 'write a README for the ledger module',\n+    })).resolves.toBeNull();\n+  });\n+\n+  it('treats a candidate whose first user message cannot be read as no match', async () => {\n+    await expect(promptSessionId({\n+      before: [],\n+      after: ['session-torn', 'session-two'],\n+      prompt: 'write a README for the ledger module',\n+      firstUserText: async (id: string) => {\n+        if (id === 'session-torn') throw new Error('unreadable session');\n+        return 'write a README for the ledger module';\n+      },\n+    })).resolves.toBe('session-two');\n+  });\n+});\n+\n describe('replayOffer', () => {\n   it('reports a checkout without the prompt hook instead of throwing', () => {\n     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794565815646,"end":1794565816366}}}}
