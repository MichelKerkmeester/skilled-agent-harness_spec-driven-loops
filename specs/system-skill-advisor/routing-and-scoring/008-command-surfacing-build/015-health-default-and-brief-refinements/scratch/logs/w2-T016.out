n    \"available\": true,\n    \"files\": 167,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":1},"content":[{"type":"text","text":"{\n  \"candidatePhraseCount\": 3992,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"to\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"verify\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"with\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"node\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"check\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"the\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"vitest\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"add exported promptsessionid helper to command offer mjs and verify with node check and the command offer vitest\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"add\",\n    \"exported\",\n    \"promptsessionid\",\n    \"helper\",\n    \"command\",\n    \"offer\",\n    \"mjs\",\n    \"and\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 167,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"},{"type":"text","text":"Exit code: 1"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Add exported promptSessionId helper to command-offer.mjs and verify with node --check and the command-offer vitest\\\"\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794564749069,"end":1794564750481}}}}
