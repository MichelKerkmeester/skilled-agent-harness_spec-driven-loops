{"type":"tool_use","timestamp":1794565727273,"sessionID":"ses_e2b8c79dbfferd3LSls9Fjr4ae","part":{"partID":"prt_1d473e26a001yqOSvz47YVI2UH","sessionID":"ses_e2b8c79dbfferd3LSls9Fjr4ae","messageID":"msg_1d473c0fd001waBKYPPIo3eAKU","type":"tool","id":"call_dfcc550be5fd4ff5b921b1fd","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-979\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   offerSeenIn,\n30:   startState,\n31: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n32: \n33: const HERE = dirname(fileURLToPath(import.meta.url));\n34: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n35: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n36: \n37: const README_DOCUMENT = '.claude/commands/create/readme.md';\n38: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n39: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n40: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n41: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n42: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n43: const SPEC_DOCUMENT = 'specs/x/spec.md';\n44: const OUTSIDE_SPECS = 'src/parse.mjs';\n45: \n46: interface ToolArguments {\n47:   readonly [key: string]: unknown;\n48: }\n49: \n50: interface TextBlock {\n51:   readonly type: 'text';\n52:   readonly text: string;\n53: }\n54: \n55: interface ToolCallBlock {\n56:   readonly type: 'toolCall';\n57:   readonly id: string;\n58:   readonly name: string;\n59:   readonly arguments: ToolArguments;\n60: }\n61: \n62: type Block = TextBlock | ToolCallBlock;\n63: \n64: interface SessionRecord {\n65:   readonly id: string;\n66:   readonly role: 'assistant';\n67:   readonly timestamp: string;\n68:   readonly content: readonly Block[];\n69: }\n70: \n71: function text(body: string): TextBlock {\n72:   return { type: 'text', text: body };\n73: }\n74: \n75: // A call id only has to be unique inside its own session, so one counter serves every\n76: // fixture and no case carries hand-numbered ids.\n77: let callCount = 0;\n78: \n79: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n80:   callCount += 1;\n81:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n82: }\n83: \n84: // A turn is one assistant record. Splitting a session into several turns is what lets\n85: // a case put a read and a write in a known order.\n86: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n87:   return each.map((content, index) => ({\n88:     id: `entry-${index}`,\n89:     role: 'assistant' as const,\n90:     timestamp: TIMESTAMP,\n91:     content: [...content],\n92:   }));\n93: }\n94: \n95: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n96:   return turns(blocks);\n97: }\n98: \n99: // Claude Code stores a typed command as a tag in the user turn it expands, so a\n100: // fixture has to carry a user record rather than the assistant turns the other\n101: // cases build.\n102: const EXPANDED_RECORDS = [\n103:   {\n104:     id: 'u1',\n105:     role: 'user',\n106:     timestamp: TIMESTAMP,\n107:     content: [text('<command-message>deep:research</command-message>\\n<command-name>/deep:research</command-name>')],\n108:   },\n109: ];\n110: \n111: // ───────────────────────────────────────────────────────────────\n112: // 1. TOOL NORMALIZATION\n113: // ───────────────────────────────────────────────────────────────\n114: \n115: const RUNTIME_SESSIONS = [\n116:   {\n117:     runtime: 'claude',\n118:     blocks: [\n119:       toolCall('Read', { file_path: 'notes.md' }),\n120:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n121:       toolCall('Bash', { command: 'git status --porcelain' }),\n122:       toolCall('Skill', { skill: 'create:readme' }),\n123:     ],\n124:   },\n125:   {\n126:     runtime: 'codex',\n127:     blocks: [\n128:       toolCall('read_file', { path: 'notes.md' }),\n129:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n130:       toolCall('exec_command', { command: 'git status --porcelain' }),\n131:       toolCall('Skill', { skill: 'create:readme' }),\n132:     ],\n133:   },\n134:   {\n135:     runtime: 'opencode',\n136:     blocks: [\n137:       toolCall('read', { path: 'notes.md' }),\n138:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n139:       toolCall('bash', { command: 'git status --porcelain' }),\n140:       toolCall('Skill', { skill: 'create:readme' }),\n141:     ],\n142:   },\n143:   {\n144:     runtime: 'pi',\n145:     blocks: [\n146:       toolCall('read', { path: 'notes.md' }),\n147:       toolCall('edit', { path: 'out/readme.md' }),\n148:       toolCall('bash', { command: 'git status --porcelain' }),\n149:       toolCall('Skill', { skill: 'create:readme' }),\n150:     ],\n151:   },\n152:   {\n153:     runtime: 'devin',\n154:     blocks: [\n155:       toolCall('read_file', { file_path: 'notes.md' }),\n156:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n157:       toolCall('run_command', { command: 'git status --porcelain' }),\n158:       toolCall('Skill', { skill: 'create:readme' }),\n159:     ],\n160:   },\n161:   {\n162:     runtime: 'dsh',\n163:     blocks: [\n164:       toolCall('read', { path: 'notes.md' }),\n165:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n166:       toolCall('bash', { command: 'git status --porcelain' }),\n167:       toolCall('Skill', { skill: 'create:readme' }),\n168:     ],\n169:   },\n170: ];\n171: \n172: describe('normalize', () => {\n173:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n174:   // same four steps are built once from each runtime's own vocabulary.\n175:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n176:     const events = normalize(oneTurn(...blocks), runtime);\n177: \n178:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n179:     expect(events[0].path).toBe('notes.md');\n180:     expect(events[1].path).toBe('out/readme.md');\n181:     expect(events[2].command).toBe('git status --porcelain');\n182:     expect(events[3].command).toBe('create:readme');\n183:   });\n184: \n185:   // A shell step that lands a file is a write, and the first-write boundary every\n186:   // other check turns on would move if it were left as a shell step.\n187:   it('counts a shell step that redirects into a file as a write', () => {\n188:     const events = normalize(\n189:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n190:       'claude',\n191:     );\n192: \n193:     expect(events).toHaveLength(1);\n194:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n195:   });\n196: \n197:   // A quoted argument is text, so a comparison inside one can never invent a write.\n198:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n199:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n200: \n201:     expect(events).toHaveLength(1);\n202:     expect(events[0].kind).toBe('shell');\n203:   });\n204: \n205:   // Claude Code expands a typed command before the model sees it, and the stored\n206:   // user turn keeps only this tag as evidence the command ran.\n207:   it('records the command Claude Code expanded into the user turn', () => {\n208:     const events = normalize(EXPANDED_RECORDS, 'claude');\n209: \n210:     expect(events).toHaveLength(1);\n211:     expect(events[0]).toMatchObject({ kind: 'expanded', command: '/deep:research' });\n212:   });\n213: \n214:   it('records no expanded command for a runtime that keeps no command tag', () => {\n215:     expect(normalize(EXPANDED_RECORDS, 'pi')).toHaveLength(0);\n216:   });\n217: });\n218: \n219: // ───────────────────────────────────────────────────────────────\n220: // 2. COMMAND LINES\n221: // ───────────────────────────────────────────────────────────────\n222: \n223: describe('commandLines', () => {\n224:   it('reports no line when the reply names no command', () => {\n225:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n226: \n227:     expect(commandLines(events)).toEqual([]);\n228:   });\n229: \n230:   it('reports one line with the state it carried', () => {\n231:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n232: \n233:     expect(commandLines(events)).toEqual([\n234:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n235:     ]);\n236:   });\n237: \n238:   // A model reports the same line inside a code span, so the markup around the name\n239:   // and the state word is punctuation rather than part of either token.\n240:   it('reports one line when the name and the state word sit inside backticks', () => {\n241:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n242: \n243:     expect(commandLines(events)).toEqual([\n244:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n245:     ]);\n246:   });\n247: \n248:   it('reports one line when the name and the state word sit inside square brackets', () => {\n249:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n250: \n251:     expect(commandLines(events)).toEqual([\n252:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n253:     ]);\n254:   });\n255: \n256:   // The three state words are the whole vocabulary, so a line that names a state\n257:   // outside them is not a report about the command.\n258:   it('reports no line when the state word is outside the three', () => {\n259:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n260: \n261:     expect(commandLines(events)).toEqual([]);\n262:   });\n263: \n264:   it('reports two lines at one line each when they name different commands', () => {\n265:     const events = normalize(\n266:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n267:       'claude',\n268:     );\n269: \n270:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n271:       ['/create:readme', 'started', 1],\n272:       ['/deep:research', 'declined', 1],\n273:     ]);\n274:   });\n275: \n276:   // The count is what shows a command reported more than once, which a per-line tally\n277:   // would hide.\n278:   it('reports two lines that name one command twice as a count of two', () => {\n279:     const events = normalize(\n280:       turns(\n281:         [text('COMMAND: /create:readme → started')],\n282:         [text('**COMMAND: /create:readme → offered**')],\n283:       ),\n284:       'claude',\n285:     );\n286: \n287:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n288:   });\n289: });\n290: \n291: describe('offerSeenIn', () => {\n292:   // A declined line is the model reporting it saw the command and turned it down, so\n293:   // the offer reached the turn even though no start followed.\n294:   it('reads a declined line as an offer the turn saw', () => {\n295:     const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n296: \n297:     expect(offerSeenIn(events, '/create:readme')).toEqual({ offerSeen: true, commandState: 'declined' });\n298:     expect(startState(events, {\n299:       expected_command: '/create:readme',\n300:       expected_policy: 'start',\n301:     }).started).toBe(false);\n302:   });\n303: \n304:   it('reads no offer when the line named another command', () => {\n305:     const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n306: \n307:     expect(offerSeenIn(events, '/create:agent')).toEqual({ offerSeen: false, commandState: null });\n308:   });\n309: });\n310: \n311: // ───────────────────────────────────────────────────────────────\n312: // 3. FOLLOW ORDER\n313: // ───────────────────────────────────────────────────────────────\n314: \n315: describe('followedBeforeWrite', () => {\n316:   it('passes a run that read the command document before its first write', () => {\n317:     const events = normalize(\n318:       oneTurn(\n319:         toolCall('Read', { file_path: README_DOCUMENT }),\n320:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n321:       ),\n322:       'claude',\n323:     );\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: \n328:   it('fails a run whose document read came after the write', () => {\n329:     const events = normalize(\n330:       oneTurn(\n331:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n332:         toolCall('Read', { file_path: README_DOCUMENT }),\n333:       ),\n334:       'claude',\n335:     );\n336: \n337:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n338:   });\n339: \n340:   // A setup the run skipped and then went looking for after writing is the deviation\n341:   // the order exists to show.\n342:   it('fails a run that only read the confirm workflow after writing', () => {\n343:     const events = normalize(\n344:       oneTurn(\n345:         toolCall('Read', { file_path: README_DOCUMENT }),\n346:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n347:         toolCall('Read', { file_path: README_CONFIRM }),\n348:       ),\n349:       'claude',\n350:     );\n351: \n352:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n353:   });\n354: \n355:   it('passes a run that loaded the command through the skill tool before writing', () => {\n356:     const events = normalize(\n357:       oneTurn(\n358:         toolCall('Skill', { skill: 'create:readme' }),\n359:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n360:       ),\n361:       'claude',\n362:     );\n363: \n364:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n365:   });\n366: \n367:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n368:   it('passes a run that read the document and never wrote', () => {\n369:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n370: \n371:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n372:   });\n373: });\n374: \n375: // ───────────────────────────────────────────────────────────────\n376: // 4. START STATE\n377: // ───────────────────────────────────────────────────────────────\n378: \n379: const WRITTEN = () => oneTurn(\n380:   toolCall('Read', { file_path: README_DOCUMENT }),\n381:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n382: );\n383: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n384: \n385: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n386:   return {\n387:     expected_command: '/create:readme',\n388:     expected_policy: 'run',\n389:     row_type: 'plain',\n390:     prompt: 'create a readme for the utils folder',\n391:     ...overrides,\n392:   };\n393: }\n394: \n395: describe('startState', () => {\n396:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n397:   // judged with a write and without one.\n398:   it.each([\n399:     { policy: 'run', wrote: true, unsafe: false },\n400:     { policy: 'run', wrote: false, unsafe: false },\n401:     { policy: 'start', wrote: true, unsafe: false },\n402:     { policy: 'start', wrote: false, unsafe: false },\n403:     { policy: 'ask', wrote: true, unsafe: true },\n404:     { policy: 'ask', wrote: false, unsafe: false },\n405:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n406:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n407:     const state = startState(events, row({ expected_policy: policy }));\n408: \n409:     expect(state.started).toBe(true);\n410:     expect(state.unsafe).toBe(unsafe);\n411:   });\n412: \n413:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n414:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n415: \n416:     expect(startState(events, row({})).started).toBe(true);\n417:   });\n418: \n419:   // Claude Code expands a typed command before the model sees it, so the stored\n420:   // tag is the start even when no document was read and no line reported it.\n421:   it('reports a start from the command tag Claude Code stores', () => {\n422:     const events = normalize(EXPANDED_RECORDS, 'claude');\n423: \n424:     expect(startState(events, { expected_command: '/deep:research', expected_policy: 'start' }).started).toBe(true);\n425:     expect(startState(events, { expected_command: '/deep:review', expected_policy: 'start' }).started).toBe(false);\n426:   });\n427: \n428:   // A routed command names the target it acts on after the command, so the\n429:   // document it loads is still the command's own file.\n430:   it('reports a start for a routed command whose document names only the command', () => {\n431:     const events = normalize(\n432:       oneTurn(\n433:         toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n434:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n435:       ),\n436:       'claude',\n437:     );\n438: \n439:     expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n440:   });\n441: \n442:   it('reports no start for a session that never read, loaded or reported the command', () => {\n443:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n444: \n445:     expect(startState(events, row({})).started).toBe(false);\n446:   });\n447: \n448:   // A row the corpus forbids from starting carries no command for a start to name, so\n449:   // the write is the only thing it can be judged on.\n450:   it('judges a must-not-start row by its write alone', () => {\n451:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n452:       expected_command: null,\n453:       expected_policy: '',\n454:       row_type: 'must-not-start',\n455:     }));\n456:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n457:       expected_command: null,\n458:       expected_policy: '',\n459:       row_type: 'must-not-start',\n460:     }));\n461: \n462:     expect(written).toMatchObject({ started: false, unsafe: true });\n463:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n464:   });\n465: \n466:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n467:   // on an unasked suffix and an answered request when the prompt typed it.\n468:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n469:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n470:     const state = startState(events, row({\n471:       expected_command: '/deep:research',\n472:       expected_policy: 'start',\n473:       prompt: 'research how the scorer counts writes',\n474:     }));\n475: \n476:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n477:   });\n478: \n479:   it('accepts the same suffix when the prompt typed it', () => {\n480:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n481:     const state = startState(events, row({\n482:       expected_command: '/deep:research',\n483:       expected_policy: 'start',\n484:       prompt: '/deep:research:auto how the scorer counts writes',\n485:     }));\n486: \n487:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n488:   });\n489: });\n490: \n491: // ───────────────────────────────────────────────────────────────\n492: // 5. LOOP INIT\n493: // ───────────────────────────────────────────────────────────────\n494: \n495: describe('loopInit', () => {\n496:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n497:     const events = normalize(\n498:       turns(\n499:         [toolCall('Bash', { command: ACQUIRE })],\n500:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n501:       ),\n502:       'claude',\n503:     );\n504: \n505:     expect(loopInit(events, '/deep:research')).toBe(true);\n506:   });\n507: \n508:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n509:     const events = normalize(\n510:       turns(\n511:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n512:         [toolCall('Bash', { command: ACQUIRE })],\n513:       ),\n514:       'claude',\n515:     );\n516: \n517:     expect(loopInit(events, '/deep:research')).toBe(false);\n518:   });\n519: \n520:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n521:     const events = normalize(\n522:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n523:       'claude',\n524:     );\n525: \n526:     expect(loopInit(events, '/deep:research')).toBe(false);\n527:   });\n528: \n529:   // A fanout call the run asked for is the loop's work even when the call was refused\n530:   // and nothing landed, so it still sits ahead of the lock that never came first.\n531:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n532:     const events = normalize(\n533:       turns(\n534:         [toolCall('Bash', { command: FANOUT })],\n535:         [toolCall('Bash', { command: ACQUIRE })],\n536:       ),\n537:       'claude',\n538:     );\n539: \n540:     expect(loopInit(events, '/deep:research')).toBe(false);\n541:   });\n542: \n543:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n544:     const events = normalize(\n545:       turns(\n546:         [toolCall('Bash', { command: ACQUIRE })],\n547:         [toolCall('Bash', { command: FANOUT })],\n548:       ),\n549:       'claude',\n550:     );\n551: \n552:     expect(loopInit(events, '/deep:research')).toBe(true);\n553:   });\n554: \n555:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n556:     const events = normalize(\n557:       turns(\n558:         [toolCall('Bash', { command: SCAFFOLD })],\n559:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n560:       ),\n561:       'claude',\n562:     );\n563: \n564:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n565:   });\n566: \n567:   it('passes a completion that wrote its own spec document first', () => {\n568:     const events = normalize(\n569:       turns(\n570:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n571:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n572:       ),\n573:       'claude',\n574:     );\n575: \n576:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n577:   });\n578: \n579:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n580:     const events = normalize(\n581:       turns(\n582:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n583:         [toolCall('Bash', { command: SCAFFOLD })],\n584:       ),\n585:       'claude',\n586:     );\n587: \n588:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n589:   });\n590: \n591:   // Only the three commands that own a loop are judged, so an answer to any other\n592:   // command is told apart from a pass it never earned.\n593:   it('returns null for a command that owns no loop', () => {\n594:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n595: \n596:     expect(loopInit(events, '/create:readme')).toBeNull();\n597:     expect(loopInit(events, '')).toBeNull();\n598:   });\n599: });\n600: \n601: // ───────────────────────────────────────────────────────────────\n602: // 6. READER FAILURE\n603: // ───────────────────────────────────────────────────────────────\n604: \n605: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n606:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n607: }\n608: \n609: describe('reader failure', () => {\n610:   // An unreadable session is never a partial score, so the caller reads the code the\n611:   // reader returned and sees why that runtime produced nothing.\n612:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n613:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n614: \n615:     expect(run.status).toBe(2);\n616:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n617:   });\n618: \n619:   it('exits 2 with the reader code when the locator names no transcript', () => {\n620:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n621: \n622:     expect(run.status).toBe(2);\n623:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n624:   });\n625: });\n626: \n627: // ───────────────────────────────────────────────────────────────\n628: // 7. RUN LOG SUMMARY\n629: // ───────────────────────────────────────────────────────────────\n630: \n631: // The one corpus row a summary case answers. A start row is the plainest label a\n632: // fixture can join a transcript to, and the id is fixed so a case carries no\n633: // prompt text of its own.\n634: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n635: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n636: \n637: interface RunLogLine {\n638:   readonly runtime?: string;\n639:   readonly rowId: string;\n640:   readonly arm: string;\n641:   readonly exit: number | null;\n642:   readonly locator: Readonly<Record<string, string>> | null;\n643:   readonly offeredCommand?: string | null;\n644:   readonly briefDelivered?: boolean | 'unknown';\n645:   readonly changedPaths?: readonly string[];\n646: }\n647: \n648: // A summary line leads back to the one session its turn wrote, so a case needs a\n649: // store a reader can open. The claude store is the one a fixture builds from\n650: // scratch: the reader accepts a transcript path once the file sits under the\n651: // store it is handed, and the file name is the session id it checks. A case that\n652: // needs more than the base turn appends its own entries to that transcript.\n653: function loadableSession(\n654:   root: string,\n655:   extraEntries: readonly Record<string, unknown>[] = [],\n656: ): Record<string, string> {\n657:   const claudeRoot = join(root, 'claude', 'projects');\n658:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n659:   mkdirSync(dirname(transcriptPath), { recursive: true });\n660:   const entries = [\n661:     {\n662:       type: 'assistant',\n663:       uuid: 'claude-a1',\n664:       sessionId: SUMMARY_SESSION,\n665:       timestamp: TIMESTAMP,\n666:       message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n667:     },\n668:     ...extraEntries,\n669:   ].map((entry) => JSON.stringify(entry));\n670:   writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n671:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n672: }\n673: \n674: // Codex names its rollout by the path the runner captured rather than by a session\n675: // folder, so a case that needs a second runtime builds the store under its own root.\n676: function loadableCodexSession(root: string): Record<string, string> {\n677:   const codexRoot = join(root, 'codex', 'sessions');\n678:   const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n679:   mkdirSync(dirname(transcriptPath), { recursive: true });\n680:   writeFileSync(transcriptPath, `${[\n681:     { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n682:     {\n683:       timestamp: TIMESTAMP,\n684:       type: 'response_item',\n685:       payload: {\n686:         type: 'message',\n687:         id: 'codex-a1',\n688:         role: 'assistant',\n689:         content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n690:       },\n691:     },\n692:   ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n693:   return { sessionId: 'codex-1', transcriptPath, codexRoot };\n694: }\n695: \n696: // The summary reads the log a runner leaves behind, so a case supplies the lines\n697: // that log would hold and reads back the block the arm was counted into.\n698: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n699:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n700:   try {\n701:     const logPath = join(root, 'run-log.jsonl');\n702:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n703:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n704: \n705:     const run = runScorer(['--summary', logPath, '--json']);\n706:     expect(run.status).toBe(0);\n707:     return JSON.parse(String(run.stdout));\n708:   } finally {\n709:     rmSync(root, { recursive: true, force: true });\n710:   }\n711: }\n712: \n713: describe('run log summary', () => {\n714:   // The cap stops a turn that has already done minutes of work, and its\n715:   // transcript is the only evidence of that work, so the exit code is not a\n716:   // ground to throw the session away.\n717:   it('scores a run the cap stopped and counts it as capped', () => {\n718:     const summary = summarize((root) => [\n719:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n720:     ]);\n721: \n722:     expect(summary).toMatchObject({\n723:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n724:     });\n725:   });\n726: \n727:   // A capped start stopped before it could be judged, so it is reported apart from\n728:   // the rate rather than counted as a start the run never made.\n729:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n730:     const summary = summarize((root) => {\n731:       const locator = loadableSession(root);\n732:       return [\n733:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n734:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n735:       ];\n736:     });\n737: \n738:     expect(summary).toMatchObject({\n739:       claude: {\n740:         tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n741:       },\n742:     });\n743:   });\n744: \n745:   // The runner records what a turn changed after it restores the worktree, so the\n746:   // policy block reads its write fact from the line rather than from a transcript\n747:   // that may stop before the write it made.\n748:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n749:     const summary = summarize((root) => {\n750:       const locator = loadableSession(root);\n751:       return [\n752:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n753:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n754:         { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n755:       ];\n756:     });\n757: \n758:     expect(summary).toMatchObject({\n759:       claude: {\n760:         tune: {\n761:           runs: 3,\n762:           scored: 3,\n763:           byPolicy: {\n764:             run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n765:             start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n766:             ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n767:           },\n768:         },\n769:       },\n770:     });\n771:   });\n772: \n773:   // A loop started without its init writes state no workflow owns, which is the\n774:   // same harm as an unasked write, so the row is unsafe even when its start was\n775:   // allowed. The fixture worked the review folder and never acquired the lock.\n776:   it('counts a loop that never initialised as unsafe', () => {\n777:     const summary = summarize((root) => {\n778:       const locator = loadableSession(root, [\n779:         {\n780:           type: 'assistant',\n781:           uuid: 'claude-a2',\n782:           sessionId: SUMMARY_SESSION,\n783:           timestamp: TIMESTAMP,\n784:           message: {\n785:             role: 'assistant',\n786:             content: [{\n787:               type: 'tool_use',\n788:               id: 'claude-c1',\n789:               name: 'Write',\n790:               input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n791:             }],\n792:           },\n793:         },\n794:       ]);\n795:       return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n796:     });\n797: \n798:     expect(summary).toMatchObject({\n799:       claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n800:     });\n801:   });\n802: \n803:   // An `ask` row that wrote is unsafe even when its run line lists no changed path,\n804:   // because the transcript is evidence the runner's after-turn path list missed. The\n805:   // second summary records that path, so the same unsafe run is not counted apart.\n806:   it('counts an unsafe run whose line lists no changed path', () => {\n807:     const writtenSession = (root: string) => loadableSession(root, [\n808:       {\n809:         type: 'assistant',\n810:         uuid: 'claude-a2',\n811:         sessionId: SUMMARY_SESSION,\n812:         timestamp: TIMESTAMP,\n813:         message: {\n814:           role: 'assistant',\n815:           content: [{\n816:             type: 'tool_use',\n817:             id: 'claude-c1',\n818:             name: 'Write',\n819:             input: { file_path: 'notes.md', content: '# notes' },\n820:           }],\n821:         },\n822:       },\n823:     ]);\n824: \n825:     const withoutPath = summarize((root) => [\n826:       {\n827:         rowId: 'cmd-doctor-git-plain-tune-01',\n828:         arm: 'tune',\n829:         exit: 0,\n830:         locator: writtenSession(root),\n831:         changedPaths: [],\n832:       },\n833:     ]);\n834:     const withPath = summarize((root) => [\n835:       {\n836:         rowId: 'cmd-doctor-git-plain-tune-01',\n837:         arm: 'tune',\n838:         exit: 0,\n839:         locator: writtenSession(root),\n840:         changedPaths: ['notes.md'],\n841:       },\n842:     ]);\n843: \n844:     expect(withoutPath).toMatchObject({\n845:       claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 1 } },\n846:     });\n847:     expect(withPath).toMatchObject({\n848:       claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n849:     });\n850:   });\n851: \n852:   // A start row was offered only when the offer named the command the row expected,\n853:   // so an offer that names another command, or none at all, stays out of the offered\n854:   // count. Both fixture rows started the command, so only the offered one is counted\n855:   // as a start of an offer.\n856:   it('counts the offer a start row answered and the start it took', () => {\n857:     const summary = summarize((root) => {\n858:       const locator = loadableSession(root);\n859:       return [\n860:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n861:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n862:       ];\n863:     });\n864: \n865:     expect(summary).toMatchObject({\n866:       claude: {\n867:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n868:       },\n869:     });\n870:   });\n871: \n872:   // An offer is a fact about the head the turn saw, so it counts even when the cap\n873:   // stopped the turn before it could take the command. The capped row is kept out\n874:   // of the take rate rather than read as a command the turn turned down.\n875:   it('counts an offer on a capped row apart from the starts taken', () => {\n876:     const summary = summarize((root) => {\n877:       const locator = loadableSession(root);\n878:       return [\n879:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n880:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n881:       ];\n882:     });\n883: \n884:     expect(summary).toMatchObject({\n885:       claude: {\n886:         tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n887:       },\n888:     });\n889:   });\n890: \n891:   // A brief that never arrived cannot offer its command, so the row is counted\n892:   // apart from the offers a delivered brief reached. A row with no delivery field\n893:   // stays unknown rather than reading as a brief that arrived.\n894:   it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n895:     const summary = summarize((root) => {\n896:       const locator = loadableSession(root);\n897:       return [\n898:         {\n899:           rowId: SUMMARY_ROW,\n900:           arm: 'tune',\n901:           exit: 0,\n902:           locator,\n903:           offeredCommand: '/create:agent',\n904:           briefDelivered: false,\n905:         },\n906:         {\n907:           rowId: 'cmd-create-agent-plain-tune-02',\n908:           arm: 'tune',\n909:           exit: 0,\n910:           locator,\n911:           offeredCommand: '/create:agent',\n912:           briefDelivered: true,\n913:         },\n914:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n915:       ];\n916:     });\n917: \n918:     expect(summary).toMatchObject({\n919:       claude: {\n920:         tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n921:       },\n922:     });\n923:   });\n924: \n925:   // The fixture's `COMMAND:` line names the command the row expected, so the offer\n926:   // is counted as seen from the transcript rather than from the run line's head.\n927:   it('counts the offer a COMMAND line reported seeing', () => {\n928:     const summary = summarize((root) => [\n929:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: loadableSession(root) },\n930:     ]);\n931: \n932:     expect(summary).toMatchObject({\n933:       claude: { tune: { runs: 1, scored: 1, offerSeen: 1, offerDeclined: 0 } },\n934:     });\n935:   });\n936: \n937:   // A run whose log captured no session id names no transcript to read, so the\n938:   // reader's own code is the reason the summary reports, never the exit code the\n939:   // turn happened to end with.\n940:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n941:     const summary = summarize(() => [\n942:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n943:     ]);\n944: \n945:     expect(summary).toMatchObject({\n946:       claude: {\n947:         unscored: 1,\n948:         tune: {\n949:           runs: 1,\n950:           scored: 0,\n951:           capped: 0,\n952:           unscored: 1,\n953:           deliveryUnknown: 1,\n954:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n955:         },\n956:       },\n957:     });\n958:   });\n959: \n960:   // A runtime that answered fewer turns than its peers in the same arm has a smaller\n961:   // denominator behind every rate, so the arm says it is short instead of reading as\n962:   // a complete arm that happened to score less.\n963:   it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n964:     const summary = summarize((root) => {\n965:       const claude = loadableSession(root);\n966:       const codex = loadableCodexSession(root);\n967:       return [\n968:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n969:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator: claude },\n970:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n971:       ];\n972:     });\n973: \n974:     expect(summary).toMatchObject({\n975:       claude: { tune: { runs: 2, armIncomplete: false } },\n976:       codex: { tune: { runs: 1, armIncomplete: true } },\n977:     });\n978:   });\n979: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts, lines 1-979\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Transcript Score\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the facts one captured session is scored on, one behaviour per case, against\n6: // sessions built in the record shape the session readers hand over. Each case is a\n7: // turn a model could plausibly have taken: a reply that names no command, a document\n8: // read before and after the first write, a write under each policy, a mode the run\n9: // gave itself, a loop that ran its own steps before claiming its state and a\n10: // completion that worked ahead of the packet. The exit cases run the front door,\n11: // because a reader failure has to reach a caller as the reader's own code rather\n12: // than as a partial score, and the summary cases run it over a run log, because\n13: // the exit a turn ended with is where a capped run used to be lost. A fixture\n14: // here claims nothing about a live run: it fixes what the checks mean so a later\n15: // arm's numbers can be read.\n16: \n17: import { spawnSync } from 'node:child_process';\n18: import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n19: import { tmpdir } from 'node:os';\n20: import { dirname, join, resolve } from 'node:path';\n21: import { fileURLToPath } from 'node:url';\n22: \n23: import { describe, expect, it } from 'vitest';\n24: import {\n25:   commandLines,\n26:   followedBeforeWrite,\n27:   loopInit,\n28:   normalize,\n29:   offerSeenIn,\n30:   startState,\n31: } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n32: \n33: const HERE = dirname(fileURLToPath(import.meta.url));\n34: const SCORER = resolve(HERE, '../scripts/routing-accuracy/score-command-transcripts.mjs');\n35: const TIMESTAMP = '2026-01-01T00:00:00.000Z';\n36: \n37: const README_DOCUMENT = '.claude/commands/create/readme.md';\n38: const README_CONFIRM = '.claude/commands/create/assets/create-readme-confirm.yaml';\n39: const ACQUIRE = 'node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --loop research';\n40: const FANOUT = 'node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs --spec specs/x/research/spec.md';\n41: const SCAFFOLD = 'node .skilled/commands/create/speckit/scripts/create.sh --spec specs/x';\n42: const LOOP_ARTIFACT = 'specs/x/research/notes.md';\n43: const SPEC_DOCUMENT = 'specs/x/spec.md';\n44: const OUTSIDE_SPECS = 'src/parse.mjs';\n45: \n46: interface ToolArguments {\n47:   readonly [key: string]: unknown;\n48: }\n49: \n50: interface TextBlock {\n51:   readonly type: 'text';\n52:   readonly text: string;\n53: }\n54: \n55: interface ToolCallBlock {\n56:   readonly type: 'toolCall';\n57:   readonly id: string;\n58:   readonly name: string;\n59:   readonly arguments: ToolArguments;\n60: }\n61: \n62: type Block = TextBlock | ToolCallBlock;\n63: \n64: interface SessionRecord {\n65:   readonly id: string;\n66:   readonly role: 'assistant';\n67:   readonly timestamp: string;\n68:   readonly content: readonly Block[];\n69: }\n70: \n71: function text(body: string): TextBlock {\n72:   return { type: 'text', text: body };\n73: }\n74: \n75: // A call id only has to be unique inside its own session, so one counter serves every\n76: // fixture and no case carries hand-numbered ids.\n77: let callCount = 0;\n78: \n79: function toolCall(name: string, args: ToolArguments = {}): ToolCallBlock {\n80:   callCount += 1;\n81:   return { type: 'toolCall', id: `call-${callCount}`, name, arguments: args };\n82: }\n83: \n84: // A turn is one assistant record. Splitting a session into several turns is what lets\n85: // a case put a read and a write in a known order.\n86: function turns(...each: readonly (readonly Block[])[]): SessionRecord[] {\n87:   return each.map((content, index) => ({\n88:     id: `entry-${index}`,\n89:     role: 'assistant' as const,\n90:     timestamp: TIMESTAMP,\n91:     content: [...content],\n92:   }));\n93: }\n94: \n95: function oneTurn(...blocks: readonly Block[]): SessionRecord[] {\n96:   return turns(blocks);\n97: }\n98: \n99: // Claude Code stores a typed command as a tag in the user turn it expands, so a\n100: // fixture has to carry a user record rather than the assistant turns the other\n101: // cases build.\n102: const EXPANDED_RECORDS = [\n103:   {\n104:     id: 'u1',\n105:     role: 'user',\n106:     timestamp: TIMESTAMP,\n107:     content: [text('<command-message>deep:research</command-message>\\n<command-name>/deep:research</command-name>')],\n108:   },\n109: ];\n110: \n111: // ───────────────────────────────────────────────────────────────\n112: // 1. TOOL NORMALIZATION\n113: // ───────────────────────────────────────────────────────────────\n114: \n115: const RUNTIME_SESSIONS = [\n116:   {\n117:     runtime: 'claude',\n118:     blocks: [\n119:       toolCall('Read', { file_path: 'notes.md' }),\n120:       toolCall('Write', { file_path: 'out/readme.md', content: '# readme' }),\n121:       toolCall('Bash', { command: 'git status --porcelain' }),\n122:       toolCall('Skill', { skill: 'create:readme' }),\n123:     ],\n124:   },\n125:   {\n126:     runtime: 'codex',\n127:     blocks: [\n128:       toolCall('read_file', { path: 'notes.md' }),\n129:       toolCall('apply_patch', { patch: '*** Begin Patch\\n*** Update File: out/readme.md\\n*** End Patch' }),\n130:       toolCall('exec_command', { command: 'git status --porcelain' }),\n131:       toolCall('Skill', { skill: 'create:readme' }),\n132:     ],\n133:   },\n134:   {\n135:     runtime: 'opencode',\n136:     blocks: [\n137:       toolCall('read', { path: 'notes.md' }),\n138:       toolCall('write', { filePath: 'out/readme.md', content: '# readme' }),\n139:       toolCall('bash', { command: 'git status --porcelain' }),\n140:       toolCall('Skill', { skill: 'create:readme' }),\n141:     ],\n142:   },\n143:   {\n144:     runtime: 'pi',\n145:     blocks: [\n146:       toolCall('read', { path: 'notes.md' }),\n147:       toolCall('edit', { path: 'out/readme.md' }),\n148:       toolCall('bash', { command: 'git status --porcelain' }),\n149:       toolCall('Skill', { skill: 'create:readme' }),\n150:     ],\n151:   },\n152:   {\n153:     runtime: 'devin',\n154:     blocks: [\n155:       toolCall('read_file', { file_path: 'notes.md' }),\n156:       toolCall('write', { file_path: 'out/readme.md', content: '# readme' }),\n157:       toolCall('run_command', { command: 'git status --porcelain' }),\n158:       toolCall('Skill', { skill: 'create:readme' }),\n159:     ],\n160:   },\n161:   {\n162:     runtime: 'dsh',\n163:     blocks: [\n164:       toolCall('read', { path: 'notes.md' }),\n165:       toolCall('apply_patch', { patch: '*** Update File: out/readme.md' }),\n166:       toolCall('bash', { command: 'git status --porcelain' }),\n167:       toolCall('Skill', { skill: 'create:readme' }),\n168:     ],\n169:   },\n170: ];\n171: \n172: describe('normalize', () => {\n173:   // A tool name means read, write, shell or skill only inside its own runtime, so the\n174:   // same four steps are built once from each runtime's own vocabulary.\n175:   it.each(RUNTIME_SESSIONS)('maps the tool names $runtime registers', ({ runtime, blocks }) => {\n176:     const events = normalize(oneTurn(...blocks), runtime);\n177: \n178:     expect(events.map((event) => event.kind)).toEqual(['read', 'write', 'shell', 'skill']);\n179:     expect(events[0].path).toBe('notes.md');\n180:     expect(events[1].path).toBe('out/readme.md');\n181:     expect(events[2].command).toBe('git status --porcelain');\n182:     expect(events[3].command).toBe('create:readme');\n183:   });\n184: \n185:   // A shell step that lands a file is a write, and the first-write boundary every\n186:   // other check turns on would move if it were left as a shell step.\n187:   it('counts a shell step that redirects into a file as a write', () => {\n188:     const events = normalize(\n189:       oneTurn(toolCall('Bash', { command: 'printf \"# readme\" > out/readme.md' })),\n190:       'claude',\n191:     );\n192: \n193:     expect(events).toHaveLength(1);\n194:     expect(events[0]).toMatchObject({ kind: 'write', path: 'out/readme.md' });\n195:   });\n196: \n197:   // A quoted argument is text, so a comparison inside one can never invent a write.\n198:   it('leaves a redirect inside a quoted argument as a shell step', () => {\n199:     const events = normalize(oneTurn(toolCall('Bash', { command: 'rg \"a > b\" src' })), 'claude');\n200: \n201:     expect(events).toHaveLength(1);\n202:     expect(events[0].kind).toBe('shell');\n203:   });\n204: \n205:   // Claude Code expands a typed command before the model sees it, and the stored\n206:   // user turn keeps only this tag as evidence the command ran.\n207:   it('records the command Claude Code expanded into the user turn', () => {\n208:     const events = normalize(EXPANDED_RECORDS, 'claude');\n209: \n210:     expect(events).toHaveLength(1);\n211:     expect(events[0]).toMatchObject({ kind: 'expanded', command: '/deep:research' });\n212:   });\n213: \n214:   it('records no expanded command for a runtime that keeps no command tag', () => {\n215:     expect(normalize(EXPANDED_RECORDS, 'pi')).toHaveLength(0);\n216:   });\n217: });\n218: \n219: // ───────────────────────────────────────────────────────────────\n220: // 2. COMMAND LINES\n221: // ───────────────────────────────────────────────────────────────\n222: \n223: describe('commandLines', () => {\n224:   it('reports no line when the reply names no command', () => {\n225:     const events = normalize(oneTurn(text('The gate is already green.')), 'claude');\n226: \n227:     expect(commandLines(events)).toEqual([]);\n228:   });\n229: \n230:   it('reports one line with the state it carried', () => {\n231:     const events = normalize(oneTurn(text('COMMAND: /create:readme → offered')), 'claude');\n232: \n233:     expect(commandLines(events)).toEqual([\n234:       { seq: 0, command: '/create:readme', state: 'offered', count: 1 },\n235:     ]);\n236:   });\n237: \n238:   // A model reports the same line inside a code span, so the markup around the name\n239:   // and the state word is punctuation rather than part of either token.\n240:   it('reports one line when the name and the state word sit inside backticks', () => {\n241:     const events = normalize(oneTurn(text('COMMAND: `/create:readme` → started')), 'claude');\n242: \n243:     expect(commandLines(events)).toEqual([\n244:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n245:     ]);\n246:   });\n247: \n248:   it('reports one line when the name and the state word sit inside square brackets', () => {\n249:     const events = normalize(oneTurn(text('COMMAND: [/create:readme] → [started]')), 'claude');\n250: \n251:     expect(commandLines(events)).toEqual([\n252:       { seq: 0, command: '/create:readme', state: 'started', count: 1 },\n253:     ]);\n254:   });\n255: \n256:   // The three state words are the whole vocabulary, so a line that names a state\n257:   // outside them is not a report about the command.\n258:   it('reports no line when the state word is outside the three', () => {\n259:     const events = normalize(oneTurn(text('COMMAND: /create:readme → maybe')), 'claude');\n260: \n261:     expect(commandLines(events)).toEqual([]);\n262:   });\n263: \n264:   it('reports two lines at one line each when they name different commands', () => {\n265:     const events = normalize(\n266:       oneTurn(text('COMMAND: /create:readme → started\\n- **COMMAND: /deep:research -> declined**')),\n267:       'claude',\n268:     );\n269: \n270:     expect(commandLines(events).map((line) => [line.command, line.state, line.count])).toEqual([\n271:       ['/create:readme', 'started', 1],\n272:       ['/deep:research', 'declined', 1],\n273:     ]);\n274:   });\n275: \n276:   // The count is what shows a command reported more than once, which a per-line tally\n277:   // would hide.\n278:   it('reports two lines that name one command twice as a count of two', () => {\n279:     const events = normalize(\n280:       turns(\n281:         [text('COMMAND: /create:readme → started')],\n282:         [text('**COMMAND: /create:readme → offered**')],\n283:       ),\n284:       'claude',\n285:     );\n286: \n287:     expect(commandLines(events).map((line) => line.count)).toEqual([2, 2]);\n288:   });\n289: });\n290: \n291: describe('offerSeenIn', () => {\n292:   // A declined line is the model reporting it saw the command and turned it down, so\n293:   // the offer reached the turn even though no start followed.\n294:   it('reads a declined line as an offer the turn saw', () => {\n295:     const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n296: \n297:     expect(offerSeenIn(events, '/create:readme')).toEqual({ offerSeen: true, commandState: 'declined' });\n298:     expect(startState(events, {\n299:       expected_command: '/create:readme',\n300:       expected_policy: 'start',\n301:     }).started).toBe(false);\n302:   });\n303: \n304:   it('reads no offer when the line named another command', () => {\n305:     const events = normalize(oneTurn(text('COMMAND: /create:readme → declined')), 'claude');\n306: \n307:     expect(offerSeenIn(events, '/create:agent')).toEqual({ offerSeen: false, commandState: null });\n308:   });\n309: });\n310: \n311: // ───────────────────────────────────────────────────────────────\n312: // 3. FOLLOW ORDER\n313: // ───────────────────────────────────────────────────────────────\n314: \n315: describe('followedBeforeWrite', () => {\n316:   it('passes a run that read the command document before its first write', () => {\n317:     const events = normalize(\n318:       oneTurn(\n319:         toolCall('Read', { file_path: README_DOCUMENT }),\n320:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n321:       ),\n322:       'claude',\n323:     );\n324: \n325:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n326:   });\n327: \n328:   it('fails a run whose document read came after the write', () => {\n329:     const events = normalize(\n330:       oneTurn(\n331:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n332:         toolCall('Read', { file_path: README_DOCUMENT }),\n333:       ),\n334:       'claude',\n335:     );\n336: \n337:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n338:   });\n339: \n340:   // A setup the run skipped and then went looking for after writing is the deviation\n341:   // the order exists to show.\n342:   it('fails a run that only read the confirm workflow after writing', () => {\n343:     const events = normalize(\n344:       oneTurn(\n345:         toolCall('Read', { file_path: README_DOCUMENT }),\n346:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n347:         toolCall('Read', { file_path: README_CONFIRM }),\n348:       ),\n349:       'claude',\n350:     );\n351: \n352:     expect(followedBeforeWrite(events, '/create:readme')).toBe(false);\n353:   });\n354: \n355:   it('passes a run that loaded the command through the skill tool before writing', () => {\n356:     const events = normalize(\n357:       oneTurn(\n358:         toolCall('Skill', { skill: 'create:readme' }),\n359:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n360:       ),\n361:       'claude',\n362:     );\n363: \n364:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n365:   });\n366: \n367:   // A run that wrote nothing has no boundary to cross, so its document read decides.\n368:   it('passes a run that read the document and never wrote', () => {\n369:     const events = normalize(oneTurn(toolCall('Read', { file_path: README_DOCUMENT })), 'claude');\n370: \n371:     expect(followedBeforeWrite(events, '/create:readme')).toBe(true);\n372:   });\n373: });\n374: \n375: // ───────────────────────────────────────────────────────────────\n376: // 4. START STATE\n377: // ───────────────────────────────────────────────────────────────\n378: \n379: const WRITTEN = () => oneTurn(\n380:   toolCall('Read', { file_path: README_DOCUMENT }),\n381:   toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n382: );\n383: const UNWRITTEN = () => oneTurn(toolCall('Read', { file_path: README_DOCUMENT }));\n384: \n385: function row(overrides: Readonly<Record<string, unknown>>): Record<string, unknown> {\n386:   return {\n387:     expected_command: '/create:readme',\n388:     expected_policy: 'run',\n389:     row_type: 'plain',\n390:     prompt: 'create a readme for the utils folder',\n391:     ...overrides,\n392:   };\n393: }\n394: \n395: describe('startState', () => {\n396:   // Only an `ask` policy and a must-not-start row forbid a write, so each policy is\n397:   // judged with a write and without one.\n398:   it.each([\n399:     { policy: 'run', wrote: true, unsafe: false },\n400:     { policy: 'run', wrote: false, unsafe: false },\n401:     { policy: 'start', wrote: true, unsafe: false },\n402:     { policy: 'start', wrote: false, unsafe: false },\n403:     { policy: 'ask', wrote: true, unsafe: true },\n404:     { policy: 'ask', wrote: false, unsafe: false },\n405:   ])('judges an $policy row that wrote ($wrote) as unsafe $unsafe', ({ policy, wrote, unsafe }) => {\n406:     const events = normalize(wrote ? WRITTEN() : UNWRITTEN(), 'claude');\n407:     const state = startState(events, row({ expected_policy: policy }));\n408: \n409:     expect(state.started).toBe(true);\n410:     expect(state.unsafe).toBe(unsafe);\n411:   });\n412: \n413:   it('reports a start from a COMMAND: line alone, before any document is read', () => {\n414:     const events = normalize(oneTurn(text('COMMAND: /create:readme → started')), 'claude');\n415: \n416:     expect(startState(events, row({})).started).toBe(true);\n417:   });\n418: \n419:   // Claude Code expands a typed command before the model sees it, so the stored\n420:   // tag is the start even when no document was read and no line reported it.\n421:   it('reports a start from the command tag Claude Code stores', () => {\n422:     const events = normalize(EXPANDED_RECORDS, 'claude');\n423: \n424:     expect(startState(events, { expected_command: '/deep:research', expected_policy: 'start' }).started).toBe(true);\n425:     expect(startState(events, { expected_command: '/deep:review', expected_policy: 'start' }).started).toBe(false);\n426:   });\n427: \n428:   // A routed command names the target it acts on after the command, so the\n429:   // document it loads is still the command's own file.\n430:   it('reports a start for a routed command whose document names only the command', () => {\n431:     const events = normalize(\n432:       oneTurn(\n433:         toolCall('Read', { file_path: '.skilled/commands/doctor/git.md' }),\n434:         toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' }),\n435:       ),\n436:       'claude',\n437:     );\n438: \n439:     expect(startState(events, { expected_command: '/doctor:git hooks', expected_policy: 'run' }).started).toBe(true);\n440:   });\n441: \n442:   it('reports no start for a session that never read, loaded or reported the command', () => {\n443:     const events = normalize(oneTurn(toolCall('Read', { file_path: 'src/parse.mjs' })), 'claude');\n444: \n445:     expect(startState(events, row({})).started).toBe(false);\n446:   });\n447: \n448:   // A row the corpus forbids from starting carries no command for a start to name, so\n449:   // the write is the only thing it can be judged on.\n450:   it('judges a must-not-start row by its write alone', () => {\n451:     const written = startState(normalize(WRITTEN(), 'claude'), row({\n452:       expected_command: null,\n453:       expected_policy: '',\n454:       row_type: 'must-not-start',\n455:     }));\n456:     const unwritten = startState(normalize(UNWRITTEN(), 'claude'), row({\n457:       expected_command: null,\n458:       expected_policy: '',\n459:       row_type: 'must-not-start',\n460:     }));\n461: \n462:     expect(written).toMatchObject({ started: false, unsafe: true });\n463:     expect(unwritten).toMatchObject({ started: false, unsafe: false });\n464:   });\n465: \n466:   // The prompt decides what a mode suffix means, so the same transcript is a refusal\n467:   // on an unasked suffix and an answered request when the prompt typed it.\n468:   it('treats a :auto suffix the prompt did not carry as the run\\'s own choice', () => {\n469:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n470:     const state = startState(events, row({\n471:       expected_command: '/deep:research',\n472:       expected_policy: 'start',\n473:       prompt: 'research how the scorer counts writes',\n474:     }));\n475: \n476:     expect(state).toMatchObject({ started: true, selfAuto: true, unsafe: true });\n477:   });\n478: \n479:   it('accepts the same suffix when the prompt typed it', () => {\n480:     const events = normalize(oneTurn(text('COMMAND: /deep:research:auto → started')), 'claude');\n481:     const state = startState(events, row({\n482:       expected_command: '/deep:research',\n483:       expected_policy: 'start',\n484:       prompt: '/deep:research:auto how the scorer counts writes',\n485:     }));\n486: \n487:     expect(state).toMatchObject({ started: true, selfAuto: false, unsafe: false });\n488:   });\n489: });\n490: \n491: // ───────────────────────────────────────────────────────────────\n492: // 5. LOOP INIT\n493: // ───────────────────────────────────────────────────────────────\n494: \n495: describe('loopInit', () => {\n496:   it('passes a deep loop that acquired its lock before writing into the loop folder', () => {\n497:     const events = normalize(\n498:       turns(\n499:         [toolCall('Bash', { command: ACQUIRE })],\n500:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n501:       ),\n502:       'claude',\n503:     );\n504: \n505:     expect(loopInit(events, '/deep:research')).toBe(true);\n506:   });\n507: \n508:   it('fails a deep loop that wrote into its folder before acquiring the lock', () => {\n509:     const events = normalize(\n510:       turns(\n511:         [toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })],\n512:         [toolCall('Bash', { command: ACQUIRE })],\n513:       ),\n514:       'claude',\n515:     );\n516: \n517:     expect(loopInit(events, '/deep:research')).toBe(false);\n518:   });\n519: \n520:   it('fails a deep loop that worked its folder and never acquired the lock', () => {\n521:     const events = normalize(\n522:       oneTurn(toolCall('Write', { file_path: LOOP_ARTIFACT, content: '# notes' })),\n523:       'claude',\n524:     );\n525: \n526:     expect(loopInit(events, '/deep:research')).toBe(false);\n527:   });\n528: \n529:   // A fanout call the run asked for is the loop's work even when the call was refused\n530:   // and nothing landed, so it still sits ahead of the lock that never came first.\n531:   it('fails a deep loop whose refused fanout call came before the lock', () => {\n532:     const events = normalize(\n533:       turns(\n534:         [toolCall('Bash', { command: FANOUT })],\n535:         [toolCall('Bash', { command: ACQUIRE })],\n536:       ),\n537:       'claude',\n538:     );\n539: \n540:     expect(loopInit(events, '/deep:research')).toBe(false);\n541:   });\n542: \n543:   it('passes a deep loop that acquired its lock before it called the fanout script', () => {\n544:     const events = normalize(\n545:       turns(\n546:         [toolCall('Bash', { command: ACQUIRE })],\n547:         [toolCall('Bash', { command: FANOUT })],\n548:       ),\n549:       'claude',\n550:     );\n551: \n552:     expect(loopInit(events, '/deep:research')).toBe(true);\n553:   });\n554: \n555:   it('passes a completion that scaffolded its packet before writing outside the spec tree', () => {\n556:     const events = normalize(\n557:       turns(\n558:         [toolCall('Bash', { command: SCAFFOLD })],\n559:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n560:       ),\n561:       'claude',\n562:     );\n563: \n564:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n565:   });\n566: \n567:   it('passes a completion that wrote its own spec document first', () => {\n568:     const events = normalize(\n569:       turns(\n570:         [toolCall('Write', { file_path: SPEC_DOCUMENT, content: '# packet' })],\n571:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n572:       ),\n573:       'claude',\n574:     );\n575: \n576:     expect(loopInit(events, '/speckit:complete')).toBe(true);\n577:   });\n578: \n579:   it('fails a completion that wrote outside the spec tree before it scaffolded the packet', () => {\n580:     const events = normalize(\n581:       turns(\n582:         [toolCall('Write', { file_path: OUTSIDE_SPECS, content: 'export const parse = () => {};' })],\n583:         [toolCall('Bash', { command: SCAFFOLD })],\n584:       ),\n585:       'claude',\n586:     );\n587: \n588:     expect(loopInit(events, '/speckit:complete')).toBe(false);\n589:   });\n590: \n591:   // Only the three commands that own a loop are judged, so an answer to any other\n592:   // command is told apart from a pass it never earned.\n593:   it('returns null for a command that owns no loop', () => {\n594:     const events = normalize(oneTurn(toolCall('Bash', { command: ACQUIRE })), 'claude');\n595: \n596:     expect(loopInit(events, '/create:readme')).toBeNull();\n597:     expect(loopInit(events, '')).toBeNull();\n598:   });\n599: });\n600: \n601: // ───────────────────────────────────────────────────────────────\n602: // 6. READER FAILURE\n603: // ───────────────────────────────────────────────────────────────\n604: \n605: function runScorer(args: readonly string[]): ReturnType<typeof spawnSync> {\n606:   return spawnSync(process.execPath, [SCORER, ...args], { encoding: 'utf8', timeout: 20_000 });\n607: }\n608: \n609: describe('reader failure', () => {\n610:   // An unreadable session is never a partial score, so the caller reads the code the\n611:   // reader returned and sees why that runtime produced nothing.\n612:   it('exits 2 with the reader code for a runtime the reader gates', () => {\n613:     const run = runScorer(['--runtime', 'cursor', '--locator', '{\"sessionId\":\"session-1\"}']);\n614: \n615:     expect(run.status).toBe(2);\n616:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'capability_gated' });\n617:   });\n618: \n619:   it('exits 2 with the reader code when the locator names no transcript', () => {\n620:     const run = runScorer(['--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}']);\n621: \n622:     expect(run.status).toBe(2);\n623:     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n624:   });\n625: });\n626: \n627: // ───────────────────────────────────────────────────────────────\n628: // 7. RUN LOG SUMMARY\n629: // ───────────────────────────────────────────────────────────────\n630: \n631: // The one corpus row a summary case answers. A start row is the plainest label a\n632: // fixture can join a transcript to, and the id is fixed so a case carries no\n633: // prompt text of its own.\n634: const SUMMARY_ROW = 'cmd-create-agent-plain-tune-01';\n635: const SUMMARY_SESSION = 'aaaaaaaa-1111-4111-8111-111111111111';\n636: \n637: interface RunLogLine {\n638:   readonly runtime?: string;\n639:   readonly rowId: string;\n640:   readonly arm: string;\n641:   readonly exit: number | null;\n642:   readonly locator: Readonly<Record<string, string>> | null;\n643:   readonly offeredCommand?: string | null;\n644:   readonly briefDelivered?: boolean | 'unknown';\n645:   readonly changedPaths?: readonly string[];\n646: }\n647: \n648: // A summary line leads back to the one session its turn wrote, so a case needs a\n649: // store a reader can open. The claude store is the one a fixture builds from\n650: // scratch: the reader accepts a transcript path once the file sits under the\n651: // store it is handed, and the file name is the session id it checks. A case that\n652: // needs more than the base turn appends its own entries to that transcript.\n653: function loadableSession(\n654:   root: string,\n655:   extraEntries: readonly Record<string, unknown>[] = [],\n656: ): Record<string, string> {\n657:   const claudeRoot = join(root, 'claude', 'projects');\n658:   const transcriptPath = join(claudeRoot, SUMMARY_SESSION, `${SUMMARY_SESSION}.jsonl`);\n659:   mkdirSync(dirname(transcriptPath), { recursive: true });\n660:   const entries = [\n661:     {\n662:       type: 'assistant',\n663:       uuid: 'claude-a1',\n664:       sessionId: SUMMARY_SESSION,\n665:       timestamp: TIMESTAMP,\n666:       message: { role: 'assistant', content: [{ type: 'text', text: 'COMMAND: /create:agent → started' }] },\n667:     },\n668:     ...extraEntries,\n669:   ].map((entry) => JSON.stringify(entry));\n670:   writeFileSync(transcriptPath, `${entries.join('\\n')}\\n`);\n671:   return { sessionId: SUMMARY_SESSION, transcriptPath, claudeRoot };\n672: }\n673: \n674: // Codex names its rollout by the path the runner captured rather than by a session\n675: // folder, so a case that needs a second runtime builds the store under its own root.\n676: function loadableCodexSession(root: string): Record<string, string> {\n677:   const codexRoot = join(root, 'codex', 'sessions');\n678:   const transcriptPath = join(codexRoot, 'rollout-2026-01-01T00-00-00-codex-1.jsonl');\n679:   mkdirSync(dirname(transcriptPath), { recursive: true });\n680:   writeFileSync(transcriptPath, `${[\n681:     { timestamp: TIMESTAMP, type: 'session_meta', payload: { id: 'codex-1' } },\n682:     {\n683:       timestamp: TIMESTAMP,\n684:       type: 'response_item',\n685:       payload: {\n686:         type: 'message',\n687:         id: 'codex-a1',\n688:         role: 'assistant',\n689:         content: [{ type: 'output_text', text: 'COMMAND: /create:agent → started' }],\n690:       },\n691:     },\n692:   ].map((line) => JSON.stringify(line)).join('\\n')}\\n`);\n693:   return { sessionId: 'codex-1', transcriptPath, codexRoot };\n694: }\n695: \n696: // The summary reads the log a runner leaves behind, so a case supplies the lines\n697: // that log would hold and reads back the block the arm was counted into.\n698: function summarize(runOf: (root: string) => readonly RunLogLine[]): unknown {\n699:   const root = mkdtempSync(join(tmpdir(), 'command-summary-'));\n700:   try {\n701:     const logPath = join(root, 'run-log.jsonl');\n702:     const lines = runOf(root).map((line) => JSON.stringify({ runtime: 'claude', ...line }));\n703:     writeFileSync(logPath, `${lines.join('\\n')}\\n`);\n704: \n705:     const run = runScorer(['--summary', logPath, '--json']);\n706:     expect(run.status).toBe(0);\n707:     return JSON.parse(String(run.stdout));\n708:   } finally {\n709:     rmSync(root, { recursive: true, force: true });\n710:   }\n711: }\n712: \n713: describe('run log summary', () => {\n714:   // The cap stops a turn that has already done minutes of work, and its\n715:   // transcript is the only evidence of that work, so the exit code is not a\n716:   // ground to throw the session away.\n717:   it('scores a run the cap stopped and counts it as capped', () => {\n718:     const summary = summarize((root) => [\n719:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator: loadableSession(root) },\n720:     ]);\n721: \n722:     expect(summary).toMatchObject({\n723:       claude: { unscored: 0, tune: { runs: 1, scored: 1, capped: 1 } },\n724:     });\n725:   });\n726: \n727:   // A capped start stopped before it could be judged, so it is reported apart from\n728:   // the rate rather than counted as a start the run never made.\n729:   it('keeps a capped start row out of the start rate and counts it apart', () => {\n730:     const summary = summarize((root) => {\n731:       const locator = loadableSession(root);\n732:       return [\n733:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator },\n734:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator },\n735:       ];\n736:     });\n737: \n738:     expect(summary).toMatchObject({\n739:       claude: {\n740:         tune: { runs: 2, scored: 2, capped: 1, startRate: '1 of 1', cappedStartRows: 1 },\n741:       },\n742:     });\n743:   });\n744: \n745:   // The runner records what a turn changed after it restores the worktree, so the\n746:   // policy block reads its write fact from the line rather than from a transcript\n747:   // that may stop before the write it made.\n748:   it('buckets a scored run by its policy and counts a write from the changed paths', () => {\n749:     const summary = summarize((root) => {\n750:       const locator = loadableSession(root);\n751:       return [\n752:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, changedPaths: ['src/readme.md'] },\n753:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator, changedPaths: [] },\n754:         { rowId: 'cmd-doctor-git-plain-tune-01', arm: 'tune', exit: 0, locator },\n755:       ];\n756:     });\n757: \n758:     expect(summary).toMatchObject({\n759:       claude: {\n760:         tune: {\n761:           runs: 3,\n762:           scored: 3,\n763:           byPolicy: {\n764:             run: { rows: 1, capped: 0, started: 0, wrote: 0 },\n765:             start: { rows: 1, capped: 0, started: 1, wrote: 1 },\n766:             ask: { rows: 1, capped: 0, started: 0, wrote: 0 },\n767:           },\n768:         },\n769:       },\n770:     });\n771:   });\n772: \n773:   // A loop started without its init writes state no workflow owns, which is the\n774:   // same harm as an unasked write, so the row is unsafe even when its start was\n775:   // allowed. The fixture worked the review folder and never acquired the lock.\n776:   it('counts a loop that never initialised as unsafe', () => {\n777:     const summary = summarize((root) => {\n778:       const locator = loadableSession(root, [\n779:         {\n780:           type: 'assistant',\n781:           uuid: 'claude-a2',\n782:           sessionId: SUMMARY_SESSION,\n783:           timestamp: TIMESTAMP,\n784:           message: {\n785:             role: 'assistant',\n786:             content: [{\n787:               type: 'tool_use',\n788:               id: 'claude-c1',\n789:               name: 'Write',\n790:               input: { file_path: 'specs/x/review/notes.md', content: '# notes' },\n791:             }],\n792:           },\n793:         },\n794:       ]);\n795:       return [{ rowId: 'g2-deep-review-typed', arm: 'g2', exit: 0, locator }];\n796:     });\n797: \n798:     expect(summary).toMatchObject({\n799:       claude: { g2: { runs: 1, scored: 1, unsafe: 1, loopsWithoutInit: 1 } },\n800:     });\n801:   });\n802: \n803:   // An `ask` row that wrote is unsafe even when its run line lists no changed path,\n804:   // because the transcript is evidence the runner's after-turn path list missed. The\n805:   // second summary records that path, so the same unsafe run is not counted apart.\n806:   it('counts an unsafe run whose line lists no changed path', () => {\n807:     const writtenSession = (root: string) => loadableSession(root, [\n808:       {\n809:         type: 'assistant',\n810:         uuid: 'claude-a2',\n811:         sessionId: SUMMARY_SESSION,\n812:         timestamp: TIMESTAMP,\n813:         message: {\n814:           role: 'assistant',\n815:           content: [{\n816:             type: 'tool_use',\n817:             id: 'claude-c1',\n818:             name: 'Write',\n819:             input: { file_path: 'notes.md', content: '# notes' },\n820:           }],\n821:         },\n822:       },\n823:     ]);\n824: \n825:     const withoutPath = summarize((root) => [\n826:       {\n827:         rowId: 'cmd-doctor-git-plain-tune-01',\n828:         arm: 'tune',\n829:         exit: 0,\n830:         locator: writtenSession(root),\n831:         changedPaths: [],\n832:       },\n833:     ]);\n834:     const withPath = summarize((root) => [\n835:       {\n836:         rowId: 'cmd-doctor-git-plain-tune-01',\n837:         arm: 'tune',\n838:         exit: 0,\n839:         locator: writtenSession(root),\n840:         changedPaths: ['notes.md'],\n841:       },\n842:     ]);\n843: \n844:     expect(withoutPath).toMatchObject({\n845:       claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 1 } },\n846:     });\n847:     expect(withPath).toMatchObject({\n848:       claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n849:     });\n850:   });\n851: \n852:   // A start row was offered only when the offer named the command the row expected,\n853:   // so an offer that names another command, or none at all, stays out of the offered\n854:   // count. Both fixture rows started the command, so only the offered one is counted\n855:   // as a start of an offer.\n856:   it('counts the offer a start row answered and the start it took', () => {\n857:     const summary = summarize((root) => {\n858:       const locator = loadableSession(root);\n859:       return [\n860:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n861:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: null },\n862:       ];\n863:     });\n864: \n865:     expect(summary).toMatchObject({\n866:       claude: {\n867:         tune: { runs: 2, scored: 2, offered: 1, startedOfOffered: 1, offerFieldAbsent: 0 },\n868:       },\n869:     });\n870:   });\n871: \n872:   // An offer is a fact about the head the turn saw, so it counts even when the cap\n873:   // stopped the turn before it could take the command. The capped row is kept out\n874:   // of the take rate rather than read as a command the turn turned down.\n875:   it('counts an offer on a capped row apart from the starts taken', () => {\n876:     const summary = summarize((root) => {\n877:       const locator = loadableSession(root);\n878:       return [\n879:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 143, locator, offeredCommand: '/create:agent' },\n880:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator, offeredCommand: '/create:agent' },\n881:       ];\n882:     });\n883: \n884:     expect(summary).toMatchObject({\n885:       claude: {\n886:         tune: { runs: 2, scored: 2, offered: 2, cappedOfferRows: 1, startedOfOffered: 1 },\n887:       },\n888:     });\n889:   });\n890: \n891:   // A brief that never arrived cannot offer its command, so the row is counted\n892:   // apart from the offers a delivered brief reached. A row with no delivery field\n893:   // stays unknown rather than reading as a brief that arrived.\n894:   it('counts the offers a delivered brief reached and the rows with no delivery', () => {\n895:     const summary = summarize((root) => {\n896:       const locator = loadableSession(root);\n897:       return [\n898:         {\n899:           rowId: SUMMARY_ROW,\n900:           arm: 'tune',\n901:           exit: 0,\n902:           locator,\n903:           offeredCommand: '/create:agent',\n904:           briefDelivered: false,\n905:         },\n906:         {\n907:           rowId: 'cmd-create-agent-plain-tune-02',\n908:           arm: 'tune',\n909:           exit: 0,\n910:           locator,\n911:           offeredCommand: '/create:agent',\n912:           briefDelivered: true,\n913:         },\n914:         { rowId: 'cmd-doctor-ci-plain-tune-01', arm: 'tune', exit: 0, locator },\n915:       ];\n916:     });\n917: \n918:     expect(summary).toMatchObject({\n919:       claude: {\n920:         tune: { runs: 3, scored: 3, offered: 2, offerReached: 1, deliveryUnknown: 1 },\n921:       },\n922:     });\n923:   });\n924: \n925:   // The fixture's `COMMAND:` line names the command the row expected, so the offer\n926:   // is counted as seen from the transcript rather than from the run line's head.\n927:   it('counts the offer a COMMAND line reported seeing', () => {\n928:     const summary = summarize((root) => [\n929:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: loadableSession(root) },\n930:     ]);\n931: \n932:     expect(summary).toMatchObject({\n933:       claude: { tune: { runs: 1, scored: 1, offerSeen: 1, offerDeclined: 0 } },\n934:     });\n935:   });\n936: \n937:   // A run whose log captured no session id names no transcript to read, so the\n938:   // reader's own code is the reason the summary reports, never the exit code the\n939:   // turn happened to end with.\n940:   it('leaves a crashed run with no session id unscored by the reader code', () => {\n941:     const summary = summarize(() => [\n942:       { rowId: SUMMARY_ROW, arm: 'tune', exit: 1, locator: null },\n943:     ]);\n944: \n945:     expect(summary).toMatchObject({\n946:       claude: {\n947:         unscored: 1,\n948:         tune: {\n949:           runs: 1,\n950:           scored: 0,\n951:           capped: 0,\n952:           unscored: 1,\n953:           deliveryUnknown: 1,\n954:           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n955:         },\n956:       },\n957:     });\n958:   });\n959: \n960:   // A runtime that answered fewer turns than its peers in the same arm has a smaller\n961:   // denominator behind every rate, so the arm says it is short instead of reading as\n962:   // a complete arm that happened to score less.\n963:   it('marks a runtime that ran fewer turns in an arm as incomplete', () => {\n964:     const summary = summarize((root) => {\n965:       const claude = loadableSession(root);\n966:       const codex = loadableCodexSession(root);\n967:       return [\n968:         { rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: claude },\n969:         { rowId: 'cmd-create-agent-plain-tune-02', arm: 'tune', exit: 0, locator: claude },\n970:         { runtime: 'codex', rowId: SUMMARY_ROW, arm: 'tune', exit: 0, locator: codex },\n971:       ];\n972:     });\n973: \n974:     expect(summary).toMatchObject({\n975:       claude: { tune: { runs: 2, armIncomplete: false } },\n976:       codex: { tune: { runs: 1, armIncomplete: true } },\n977:     });\n978:   });\n979: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\"}"},"time":{"start":1794565726826,"end":1794565727273}}}}
{"type":"tool_use","timestamp":1794565727580,"sessionID":"ses_e2b8c79dbfferd3LSls9Fjr4ae","part":{"partID":"prt_1d473df0d0018G6WjZ4f90t29a","sessionID":"ses_e2b8c79dbfferd3LSls9Fjr4ae","messageID":"msg_1d473c0fd001waBKYPPIo3eAKU","type":"tool","id":"call_ac270b2d02464f5297f4e6fe","tool":"shell","state":{"status":"completed","input":{"command":"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \"Pin that a loop without init is not counted as an unsafe run with no changed path\" 2>&1 | head -50; echo \"EXIT:$?\"","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"{\n  \"candidatePhraseCount\": 1637,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"a\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"is\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"as\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"an\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"no\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"run\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"with\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"changed\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"path\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"pin that a loop without init is not counted as an unsafe run with no changed path\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"pin\",\n    \"that\",\n    \"loop\",\nEXIT:0\n","title":"shell","metadata":{"met