{"type":"tool_use","timestamp":1794565253366,"sessionID":"ses_e2b969798ffeOhgXFij3UsleJR","part":{"partID":"prt_1d46ca383001I2D4VFq2F0D8Yr","sessionID":"ses_e2b969798ffeOhgXFij3UsleJR","messageID":"msg_1d46c8e63001qfdXiY56oeDEyA","type":"tool","id":"call_5d22161970d6431eacbe7e9e","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff --stat -- .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts && git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":" .../runtime/handlers/advisor-recommend.ts          |  9 +++-\n ...visor-recommend-compiled-route-option.vitest.ts | 53 ++++++++++++++++++++--\n 2 files changed, 57 insertions(+), 5 deletions(-)\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\nindex bcd2be3603..b04b2b207a 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n@@ -12,6 +12,7 @@ import { resolve } from 'node:path';\n \n import { TRACKED_COMMANDS, attachCommand, commandRowFor, routeNeedsMode, typedCommandForTop } from '../lib/command-attach.js';\n import { advisorPromptCache } from '../lib/prompt-cache.js';\n+import { extractMetalinguisticSkillMentions } from '../lib/prompt-policy.js';\n import {\n   resolveAdvisorThresholdConfig,\n } from '../lib/skill-advisor-brief.js';\n@@ -446,6 +447,7 @@ function enrichCompiledRoutes(\n   // returned unchanged.\n   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n   if (!anyEligible) return output;\n+  const namedSkills = extractMetalinguisticSkillMentions(prompt);\n   // A command row that already ranks in this result offers its command by itself,\n   // so the owning hub must not offer the same one again and spend a second slot on it.\n   const alreadyOffered = new Set<string>();\n@@ -470,14 +472,17 @@ function enrichCompiledRoutes(\n       // types to run it, so it rides along only when the route names exactly one mode\n       // that has a command. A broader route leaves the key off rather than guessing.\n       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n-      return command && !alreadyOffered.has(command)\n+      // A caller that asks for the top pick alone renders that head and no row\n+      // below it, so a command only a lower row carries would never reach the\n+      // reader. The head keeps the command when it is the only row served.\n+      return command && (!alreadyOffered.has(command) || (topOnly && index === 0))\n         ? {\n           ...recommendation,\n           compiledRoute,\n           command,\n           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n         }\n-        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute) ? { needsMode: true as const } : {}) };\n+        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n     }),\n   });\n }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":" .../runtime/handlers/advisor-recommend.ts          |  9 +++-\n ...visor-recommend-compiled-route-option.vitest.ts | 53 ++++++++++++++++++++--\n 2 files changed, 57 insertions(+), 5 deletions(-)\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\nindex bcd2be3603..b04b2b207a 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\n@@ -12,6 +12,7 @@ import { resolve } from 'node:path';\n \n import { TRACKED_COMMANDS, attachCommand, commandRowFor, routeNeedsMode, typedCommandForTop } from '../lib/command-attach.js';\n import { advisorPromptCache } from '../lib/prompt-cache.js';\n+import { extractMetalinguisticSkillMentions } from '../lib/prompt-policy.js';\n import {\n   resolveAdvisorThresholdConfig,\n } from '../lib/skill-advisor-brief.js';\n@@ -446,6 +447,7 @@ function enrichCompiledRoutes(\n   // returned unchanged.\n   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n   if (!anyEligible) return output;\n+  const namedSkills = extractMetalinguisticSkillMentions(prompt);\n   // A command row that already ranks in this result offers its command by itself,\n   // so the owning hub must not offer the same one again and spend a second slot on it.\n   const alreadyOffered = new Set<string>();\n@@ -470,14 +472,17 @@ function enrichCompiledRoutes(\n       // types to run it, so it rides along only when the route names exactly one mode\n       // that has a command. A broader route leaves the key off rather than guessing.\n       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n-      return command && !alreadyOffered.has(command)\n+      // A caller that asks for the top pick alone renders that head and no row\n+      // below it, so a command only a lower row carries would never reach the\n+      // reader. The head keeps the command when it is the only row served.\n+      return command && (!alreadyOffered.has(command) || (topOnly && index === 0))\n         ? {\n           ...recommendation,\n           compiledRoute,\n           command,\n           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n         }\n-        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute) ? { needsMode: true as const } : {}) };\n+        : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n     }),\n   });\n }\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false diff --stat -- .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts .skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts && git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794565251971,"end":1794565253366}}}}
