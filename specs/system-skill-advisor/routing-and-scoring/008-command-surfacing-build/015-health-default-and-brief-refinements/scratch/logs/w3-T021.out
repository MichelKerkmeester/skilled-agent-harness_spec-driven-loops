{"type":"tool_use","timestamp":1794565080193,"sessionID":"ses_e2b969798ffeOhgXFij3UsleJR","part":{"partID":"prt_1d46a00f4001mSHS79slJhE2AQ","sessionID":"ses_e2b969798ffeOhgXFij3UsleJR","messageID":"msg_1d469c691001gacOspaOw4XoHk","type":"tool","id":"call_a842e0a1ef0f46c582aad428","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-734\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { TRACKED_COMMANDS, attachCommand, commandRowFor, routeNeedsMode, typedCommandForTop } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import { extractMetalinguisticSkillMentions } from '../lib/prompt-policy.js';\n16: import {\n17:   resolveAdvisorThresholdConfig,\n18: } from '../lib/skill-advisor-brief.js';\n19: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n20: import {\n21:   DEEP_ROUTING_PROJECTION_HASH,\n22:   MERGED_DEEP_SKILL_ID,\n23:   modeForAlias,\n24:   modeForPromptAlias,\n25: } from '../lib/scorer/aliases.js';\n26: import {\n27:   getSemanticShadowRuntimeHealth,\n28:   withSemanticShadowPromptEmbedding,\n29: } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n31: import { sanitizeSkillLabel } from '../lib/render.js';\n32: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n33: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n34: import {\n35:   AdvisorRecommendInputSchema,\n36:   AdvisorRecommendOutputSchema,\n37:   type AdvisorRecommendInput,\n38:   type AdvisorRecommendOutput,\n39: } from '../schemas/advisor-tool-schemas.js';\n40: import { readAdvisorStatus } from './advisor-status.js';\n41: import {\n42:   COMPILED_ROUTING_HUBS,\n43:   compiledRoutingEnabledForHub,\n44:   parseCompiledRoutingFlagMode,\n45: } from '../lib/compiled-routing-flag.js';\n46: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n47: \n48: // ───────────────────────────────────────────────────────────────────\n49: // 2. TYPE DEFINITIONS\n50: // ───────────────────────────────────────────────────────────────────\n51: \n52: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n53: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n54: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n55: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n56: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n57: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 3. HELPERS\n61: // ───────────────────────────────────────────────────────────────────\n62: \n63: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n64: // stdout or the tool response, and never changes the recommendation outcome.\n65: function emitCompiledRoutingBreadcrumb(message: string): void {\n66:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n67:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n68:   }\n69: }\n70: \n71: function findWorkspaceRoot(start = process.cwd()): string {\n72:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n73: }\n74: \n75: // Canonicalize a caller-supplied workspaceRoot via realpath.\n76: // The schema-level allowlist refinement runs against the same canonical\n77: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n78: // post-symlink before downstream code uses it.\n79: function canonicalizeWorkspaceRoot(input: string): string {\n80:   const resolved = resolve(input);\n81:   try {\n82:     return realpathSync.native(resolved);\n83:   } catch {\n84:     return resolved;\n85:   }\n86: }\n87: \n88: function cacheSourceSignature(status: AdvisorStatus): string {\n89:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n90: }\n91: \n92: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n93:   return output.recommendations.map((recommendation) => recommendation.skillId);\n94: }\n95: \n96: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n97:   return {\n98:     state: 'unavailable',\n99:     reason,\n100:     generation: 0,\n101:     checkedAt: new Date().toISOString(),\n102:     lastLiveAt: null,\n103:   };\n104: }\n105: \n106: function publicThresholds(args: {\n107:   confidenceThreshold?: number;\n108:   uncertaintyThreshold?: number;\n109: }): PublicThresholds {\n110:   const resolved = resolveAdvisorThresholdConfig(args);\n111:   return {\n112:     confidenceThreshold: resolved.confidenceThreshold,\n113:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n114:     confidenceOnly: resolved.confidenceOnly,\n115:   };\n116: }\n117: \n118: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n119:   if (status.freshness !== 'stale') {\n120:     return undefined;\n121:   }\n122:   return {\n123:     graph_causal: {\n124:       status: 'runtime_degraded',\n125:       reason: status.trustState.reason ?? 'skill_graph_stale',\n126:     },\n127:   };\n128: }\n129: \n130: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n131:   const trustState = status.trustState.state;\n132:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n133:     return { ...status, freshness: trustState };\n134:   }\n135:   return status;\n136: }\n137: \n138: function emptyOutput(args: {\n139:   workspaceRoot: string;\n140:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n141:   freshness: AdvisorRecommendOutput['freshness'];\n142:   trustState: AdvisorRecommendOutput['trustState'];\n143:   warnings?: readonly string[];\n144:   abstainReasons?: readonly string[];\n145: }): AdvisorRecommendOutput {\n146:   return AdvisorRecommendOutputSchema.parse({\n147:     workspaceRoot: args.workspaceRoot,\n148:     effectiveThresholds: args.effectiveThresholds,\n149:     recommendations: [],\n150:     ambiguous: false,\n151:     freshness: args.freshness,\n152:     trustState: args.trustState,\n153:     generatedAt: new Date().toISOString(),\n154:     cache: {\n155:       hit: false,\n156:       sourceSignaturePresent: false,\n157:     },\n158:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n159:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n160:   });\n161: }\n162: \n163: // The canonical flag is checked first so the reason names it when both are set.\n164: const ADVISOR_DISABLED_FLAGS = [\n165:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n166:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n167: ] as const;\n168: \n169: function disabledOutput(\n170:   workspaceRoot: string,\n171:   effectiveThresholds: PublicThresholds,\n172:   disabledBy: string,\n173: ): AdvisorRecommendOutput {\n174:   return emptyOutput({\n175:     workspaceRoot,\n176:     effectiveThresholds,\n177:     freshness: 'unavailable',\n178:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n179:     warnings: ['ADVISOR_DISABLED'],\n180:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n181:   });\n182: }\n183: \n184: function absentOutput(\n185:   status: AdvisorStatus,\n186:   workspaceRoot: string,\n187:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n188: ): AdvisorRecommendOutput {\n189:   return emptyOutput({\n190:     workspaceRoot,\n191:     effectiveThresholds,\n192:     freshness: 'absent',\n193:     trustState: status.trustState,\n194:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n195:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n196:   });\n197: }\n198: \n199: function unavailableOutput(\n200:   status: AdvisorStatus,\n201:   workspaceRoot: string,\n202:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n203: ): AdvisorRecommendOutput {\n204:   return emptyOutput({\n205:     workspaceRoot,\n206:     effectiveThresholds,\n207:     freshness: 'unavailable',\n208:     trustState: {\n209:       ...status.trustState,\n210:       state: 'unavailable',\n211:       reason: 'advisor_unavailable',\n212:     },\n213:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n214:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n215:   });\n216: }\n217: \n218: function safeMany(values: readonly string[] | undefined): string[] {\n219:   return (values ?? [])\n220:     .map((value) => sanitizeSkillLabel(value))\n221:     .filter((value): value is string => Boolean(value));\n222: }\n223: \n224: function evidenceFeature(value: string): string {\n225:   const prefix = value.split(':', 1)[0];\n226:   switch (prefix) {\n227:     case 'phrase':\n228:       return 'phrase_match';\n229:     case 'token':\n230:       return 'token_match';\n231:     case 'hint':\n232:       return 'category_hint';\n233:     case 'derived':\n234:       return 'derived_skill_signal';\n235:     case 'doc':\n236:       return 'doc_reference_signal';\n237:     case 'cosine':\n238:       return 'semantic_similarity';\n239:     default:\n240:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n241:       if (value.includes('surface')) return 'surface_signal';\n242:       if (value.includes('intent')) return 'intent_signal';\n243:       if (value.includes('loop')) return 'workflow_signal';\n244:       return 'scorer_signal';\n245:   }\n246: }\n247: \n248: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n249:   const positiveLanes = recommendation.laneContributions\n250:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n251:     .sort((left, right) => right.weightedScore - left.weightedScore)\n252:     .slice(0, 4);\n253:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n254:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n255:       lane: lane.lane,\n256:       feature,\n257:     }))\n258:   ));\n259:   const dominant = recommendation.dominantLane;\n260:   return {\n261:     reason: dominant\n262:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n263:       : 'Recommended from ranker signals without a single dominant live lane.',\n264:     dominantLane: dominant,\n265:     topLanes: positiveLanes.map((lane) => ({\n266:       lane: lane.lane,\n267:       rawScore: lane.rawScore,\n268:       weightedScore: lane.weightedScore,\n269:       weight: lane.weight,\n270:       shadowOnly: lane.shadowOnly,\n271:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n272:       evidenceCount: lane.evidence.length,\n273:     })),\n274:     matchedSkillFeatures,\n275:   };\n276: }\n277: \n278: // Doc evidence entries are skill-relative markdown paths emitted by the\n279: // derived lane as `doc:<path>`. The allowlist rejects anything that\n280: // could smuggle prompt content or path traversal into the response.\n281: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n282: \n283: export function matchedDocsFromContributions(\n284:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n285: ): string[] {\n286:   const docs: string[] = [];\n287:   for (const lane of recommendation.laneContributions) {\n288:     for (const entry of lane.evidence) {\n289:       if (!entry.startsWith('doc:')) continue;\n290:       const path = entry.slice(4);\n291:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n292:       if (!docs.includes(path)) docs.push(path);\n293:       if (docs.length >= 3) return docs;\n294:     }\n295:   }\n296:   return docs;\n297: }\n298: \n299: function workflowModeForRecommendation(\n300:   recommendation: ScoredRecommendation,\n301:   prompt: string,\n302: ): string | undefined {\n303:   const directMode = modeForAlias(recommendation.skill);\n304:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n305:     ? modeForPromptAlias(prompt)\n306:     : null;\n307:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n308:   return workflowMode || undefined;\n309: }\n310: \n311: function publicRecommendation(\n312:   recommendation: ScoredRecommendation,\n313:   includeAttribution: boolean,\n314:   prompt: string,\n315: ) {\n316:   const skillId = sanitizeSkillLabel(recommendation.skill);\n317:   if (!skillId) return null;\n318:   const commandRow = commandRowFor(recommendation.skill);\n319:   const matchedDocs = matchedDocsFromContributions(recommendation);\n320:   const redirectFrom = safeMany(recommendation.redirectFrom);\n321:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n322:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n323:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n324:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n325:     || sanitizedStatus === 'deprecated'\n326:     || sanitizedStatus === 'archived'\n327:     || sanitizedStatus === 'future'\n328:     ? sanitizedStatus as PublicRecommendationStatus\n329:     : undefined;\n330:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n331:   return {\n332:     skillId,\n333:     kind: recommendation.kind,\n334:     score: recommendation.score,\n335:     confidence: recommendation.confidence,\n336:     uncertainty: recommendation.uncertainty,\n337:     dominantLane: recommendation.dominantLane,\n338:     ...(includeAttribution ? {\n339:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n340:         lane: lane.lane,\n341:         rawScore: lane.rawScore,\n342:         weightedScore: lane.weightedScore,\n343:         weight: lane.weight,\n344:         shadowOnly: lane.shadowOnly,\n345:       })),\n346:       why_recommended: publicWhyRecommended(recommendation),\n347:     } : {}),\n348:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n349:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n350:     ...(redirectTo ? { redirectTo } : {}),\n351:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n352:     // command already ranked below its seed has to say so here.\n353:     ...(heldBelow ? { heldBelow } : {}),\n354:     ...(status ? { status } : {}),\n355:     ...(workflowMode ? { workflowMode } : {}),\n356:     // A command row is the contract a reader acts on, so its runnable string,\n357:     // policy and owner travel with the pick. An id with no row adds nothing.\n358:     ...(commandRow ? {\n359:       command: commandRow.command,\n360:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n361:       ownerSkillId: commandRow.ownerSkillId,\n362:     } : {}),\n363:   };\n364: }\n365: \n366: // The front door runs from the request's workspaceRoot, and a caller may name\n367: // another checkout there, such as a worktree under the repository root. Its copy\n368: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n369: // gets no compiled route rather than the prompt in argv.\n370: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n371:   try {\n372:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n373:   } catch {\n374:     return false;\n375:   }\n376: }\n377: \n378: function compiledRouteForRecommendation(\n379:   skillId: string,\n380:   prompt: string,\n381:   workspaceRoot: string,\n382:   surfaceHint?: string,\n383: ): Record<string, unknown> | undefined {\n384:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n385:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n386:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n387:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n388:     return undefined;\n389:   }\n390:   try {\n391:     const args = [\n392:       frontDoor,\n393:       '--hub',\n394:       skillId,\n395:       '--prompt-stdin',\n396:     ];\n397:     // A hint the caller already holds is forwarded as its own argv element;\n398:     // the front door ignores a value that names no known surface.\n399:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n400:     const output = execFileSync(process.execPath, args, {\n401:       cwd: workspaceRoot,\n402:       encoding: 'utf8',\n403:       input: prompt,\n404:       stdio: ['pipe', 'pipe', 'pipe'],\n405:       timeout: 5_000,\n406:       maxBuffer: 1_048_576,\n407:     });\n408:     const parsed: unknown = JSON.parse(output.trim());\n409:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n410:       return undefined;\n411:     }\n412:     const compiledRoute = parsed as Record<string, unknown>;\n413:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n414:   } catch (error) {\n415:     // Surface the otherwise-silent fallback (debug-gated), including any child\n416:     // stderr the pipe above now captures instead of discarding. The served\n417:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n418:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n419:     const detail = typeof childStderr === 'string' && childStderr.trim()\n420:       ? ` child-stderr=${childStderr.trim()}`\n421:       : '';\n422:     emitCompiledRoutingBreadcrumb(\n423:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n424:     );\n425:     return undefined;\n426:   }\n427: }\n428: \n429: function enrichCompiledRoutes(\n430:   output: AdvisorRecommendOutput,\n431:   prompt: string,\n432:   workspaceRoot: string,\n433:   surfaceHint?: string,\n434:   topOnly = false,\n435: ): AdvisorRecommendOutput {\n436:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n437:   if (mode === 'invalid') {\n438:     emitCompiledRoutingBreadcrumb(\n439:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n440:     );\n441:   }\n442:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n443:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n444:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n445:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n446:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n447:   // returned unchanged.\n448:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n449:   if (!anyEligible) return output;\n450:   const namedSkills = extractMetalinguisticSkillMentions(prompt);\n451:   // A command row that already ranks in this result offers its command by itself,\n452:   // so the owning hub must not offer the same one again and spend a second slot on it.\n453:   const alreadyOffered = new Set<string>();\n454:   for (const recommendation of output.recommendations) {\n455:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n456:   }\n457:   return AdvisorRecommendOutputSchema.parse({\n458:     ...output,\n459:     recommendations: output.recommendations.map((recommendation, index) => {\n460:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n461:       // pays for that one and no more.\n462:       if (topOnly && index > 0) return recommendation;\n463:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n464:       const compiledRoute = compiledRouteForRecommendation(\n465:         recommendation.skillId,\n466:         prompt,\n467:         workspaceRoot,\n468:         surfaceHint,\n469:       );\n470:       if (!compiledRoute) return recommendation;\n471:       // The route answers which mode the hub would take; the command is what a reader\n472:       // types to run it, so it rides along only when the route names exactly one mode\n473:       // that has a command. A broader route leaves the key off rather than guessing.\n474:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n475:       return command && !alreadyOffered.has(command)\n476:         ? {\n477:           ...recommendation,\n478:           compiledRoute,\n479:           command,\n480:           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n481:         }\n482:         : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n483:     }),\n484:   });\n485: }\n486: \n487: // A typed command is the reader's own choice, so it outranks a routed mode: the\n488: // reader already named the command, and a compiled route only guesses which mode\n489: // they meant. The top recommendation carries it because that is the row a reader\n490: // acts on, and an unrelated top keeps the output it had.\n491: export function attachTypedCommand(\n492:   output: AdvisorRecommendOutput,\n493:   prompt: string,\n494: ): AdvisorRecommendOutput {\n495:   const top = output.recommendations[0];\n496:   if (!top) return output;\n497:   const typed = typedCommandForTop(top.skillId, prompt);\n498:   if (!typed) return output;\n499:   return AdvisorRecommendOutputSchema.parse({\n500:     ...output,\n501:     recommendations: [\n502:       {\n503:         ...top,\n504:         command: typed.command,\n505:         policy: typed.policy,\n506:         ownerSkillId: typed.ownerSkillId,\n507:       },\n508:       ...output.recommendations.slice(1),\n509:     ],\n510:   });\n511: }\n512: \n513: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n514:   const shadowRecommendations: ShadowRecommendation[] = [];\n515:   for (const recommendation of recommendations) {\n516:     const skillId = sanitizeSkillLabel(recommendation.skill);\n517:     if (!skillId) continue;\n518:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n519:       lane: lane.lane,\n520:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n521:     }));\n522:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n523:     const dominant = shadowContributions\n524:       .filter((lane) => lane.weightedScore > 0)\n525:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n526:     shadowRecommendations.push({\n527:         skillId,\n528:         liveScore: recommendation.score,\n529:         shadowScore,\n530:         delta: roundScore(shadowScore - recommendation.score),\n531:         dominantShadowLane: dominant,\n532:     });\n533:   }\n534:   return shadowRecommendations\n535:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n536:     .slice(0, topK);\n537: }\n538: \n539: function roundScore(value: number): number {\n540:   return Math.round(value * 1_000_000) / 1_000_000;\n541: }\n542: \n543: // A semantic lane that fell back to phrase scoring still answers, so the reason\n544: // it declined travels as a warning rather than changing the recommendation.\n545: export function semanticLaneOffWarning(reason: string | null): string[] {\n546:   return reason ? [`semantic_lane_off:${reason}`] : [];\n547: }\n548: \n549: function outputWarnings(\n550:   status: AdvisorStatus,\n551:   result: ReturnType<typeof scoreAdvisorPrompt>,\n552:   semanticLaneOffReason: string | null,\n553: ): string[] {\n554:   const degradedLanes = result.metrics.degradedLanes ?? [];\n555:   return [\n556:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n557:     ...(degradedLanes.length > 0\n558:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n559:       : []),\n560:     ...semanticLaneOffWarning(semanticLaneOffReason),\n561:   ];\n562: }\n563: \n564: function outputAbstainReasons(\n565:   input: AdvisorRecommendInput,\n566:   result: ReturnType<typeof scoreAdvisorPrompt>,\n567: ): string[] {\n568:   if (!input.options?.includeAbstainReasons) return [];\n569:   return [\n570:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n571:     ...(result.abstainReasons ?? []),\n572:   ];\n573: }\n574: \n575: // ───────────────────────────────────────────────────────────────────\n576: // 4. CORE LOGIC\n577: // ───────────────────────────────────────────────────────────────────\n578: \n579: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n580:   // Canonicalize via realpath after the schema allowlist check.\n581:   const workspaceRoot = input.workspaceRoot\n582:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n583:     : findWorkspaceRoot();\n584:   const effectiveThresholds = publicThresholds({\n585:     confidenceThreshold: input.options?.confidenceThreshold,\n586:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n587:   });\n588:   // Detect on-disk corruption here too: without it a malformed artifact reads\n589:   // 'live' from the generation counters and the recommend path would serve\n590:   // results as fresh. The verdict is cached per generation, so the quick_check\n591:   // runs at most once per rebuild rather than on every recommendation.\n592:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n593:   if (status.freshness === 'unavailable') {\n594:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n595:   }\n596:   if (status.freshness === 'absent') {\n597:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n598:   }\n599:   const sourceSignature = cacheSourceSignature(status);\n600:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n601:   const key = advisorPromptCache.makeKey({\n602:     canonicalPrompt: input.prompt.trim(),\n603:     sourceSignature,\n604:     workspaceRoot,\n605:     runtime: 'mcp',\n606:     maxTokens: input.options?.topK,\n607:     thresholdConfig: {\n608:       confidenceThreshold: input.options?.confidenceThreshold,\n609:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n610:       includeAttribution: input.options?.includeAttribution,\n611:       includeAbstainReasons: input.options?.includeAbstainReasons,\n612:     },\n613:   });\n614:   const cached = advisorPromptCache.get(key);\n615:   if (cached) {\n616:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n617:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n618:       ...cachedOutput,\n619:       workspaceRoot,\n620:       effectiveThresholds,\n621:       cache: {\n622:         ...cachedOutput.cache,\n623:         hit: true,\n624:       },\n625:     });\n626:     return attachTypedCommand(\n627:       input.options?.includeCompiledRoute === false\n628:         ? parsedCachedOutput\n629:         : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n630:       input.prompt,\n631:     );\n632:   }\n633: \n634:   const topK = input.options?.topK ?? 3;\n635:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n636:     workspaceRoot,\n637:     confidenceThreshold: input.options?.confidenceThreshold,\n638:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n639:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n640:   }));\n641:   // The lane records its health while the scored call runs, so the reason is\n642:   // read right after that call settles to describe this call's own fallback.\n643:   const semanticLaneOffReason = getSemanticShadowRuntimeHealth().disabledReason;\n644:   const recommendations = result.recommendations\n645:     .map((recommendation) => publicRecommendation(\n646:       recommendation,\n647:       Boolean(input.options?.includeAttribution),\n648:       input.prompt,\n649:     ))\n650:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n651:     .slice(0, topK);\n652:   const degradedLanes = result.metrics.degradedLanes ?? [];\n653:   const warnings = outputWarnings(status, result, semanticLaneOffReason);\n654:   const abstainReasons = outputAbstainReasons(input, result);\n655:   const output: AdvisorRecommendOutput = {\n656:     workspaceRoot,\n657:     effectiveThresholds,\n658:     recommendations,\n659:     ambiguous: result.ambiguous,\n660:     freshness: status.freshness,\n661:     trustState: status.trustState,\n662:     generatedAt: new Date().toISOString(),\n663:     cache: {\n664:       hit: false,\n665:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n666:     },\n667:     _shadow: {\n668:       model: 'advisor-shadow-learned-weights-v1',\n669:       liveWeightsFrozen: true,\n670:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n671:     },\n672:     ...(degradedLanes.length > 0 ? {\n673:       runtimeLaneHealth: {\n674:         liveLaneCount: result.metrics.liveLaneCount,\n675:         degradedLanes: [...degradedLanes],\n676:       },\n677:     } : {}),\n678:     ...(warnings.length > 0 ? { warnings } : {}),\n679:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n680:   };\n681:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n682:   if (shadowDeltaSinkEnabled()) {\n683:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n684:       recordShadowDelta({\n685:         prompt: `hmac:${key}`,\n686:         recommendation: shadow.skillId,\n687:         liveScore: shadow.liveScore,\n688:         shadowScore: shadow.shadowScore,\n689:         delta: shadow.delta,\n690:         dominantLane: shadow.dominantShadowLane,\n691:         timestamp: parsed.generatedAt,\n692:       });\n693:     }\n694:   }\n695:   advisorPromptCache.set({\n696:     key,\n697:     sourceSignature,\n698:     value: parsed,\n699:     skillLabels: recommendationLabels(parsed),\n700:   });\n701:   return attachTypedCommand(\n702:     input.options?.includeCompiledRoute === false\n703:       ? parsed\n704:       : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n705:     input.prompt,\n706:   );\n707: }\n708: \n709: // ───────────────────────────────────────────────────────────────────\n710: // 5. EXPORTS\n711: // ───────────────────────────────────────────────────────────────────\n712: \n713: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n714:   const input = AdvisorRecommendInputSchema.parse(args);\n715:   // Canonicalize via realpath after the schema allowlist check.\n716:   const workspaceRoot = input.workspaceRoot\n717:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n718:     : findWorkspaceRoot();\n719:   const effectiveThresholds = publicThresholds({\n720:     confidenceThreshold: input.options?.confidenceThreshold,\n721:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n722:   });\n723:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n724:   const data = disabledBy\n725:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n726:     : await computeRecommendationOutput(input);\n727:   return {\n728:     content: [{\n729:       type: 'text',\n730:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n731:     }],\n732:   };\n733: }\n734: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-734\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { TRACKED_COMMANDS, attachCommand, commandRowFor, routeNeedsMode, typedCommandForTop } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import { extractMetalinguisticSkillMentions } from '../lib/prompt-policy.js';\n16: import {\n17:   resolveAdvisorThresholdConfig,\n18: } from '../lib/skill-advisor-brief.js';\n19: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n20: import {\n21:   DEEP_ROUTING_PROJECTION_HASH,\n22:   MERGED_DEEP_SKILL_ID,\n23:   modeForAlias,\n24:   modeForPromptAlias,\n25: } from '../lib/scorer/aliases.js';\n26: import {\n27:   getSemanticShadowRuntimeHealth,\n28:   withSemanticShadowPromptEmbedding,\n29: } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n31: import { sanitizeSkillLabel } from '../lib/render.js';\n32: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n33: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n34: import {\n35:   AdvisorRecommendInputSchema,\n36:   AdvisorRecommendOutputSchema,\n37:   type AdvisorRecommendInput,\n38:   type AdvisorRecommendOutput,\n39: } from '../schemas/advisor-tool-schemas.js';\n40: import { readAdvisorStatus } from './advisor-status.js';\n41: import {\n42:   COMPILED_ROUTING_HUBS,\n43:   compiledRoutingEnabledForHub,\n44:   parseCompiledRoutingFlagMode,\n45: } from '../lib/compiled-routing-flag.js';\n46: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n47: \n48: // ───────────────────────────────────────────────────────────────────\n49: // 2. TYPE DEFINITIONS\n50: // ───────────────────────────────────────────────────────────────────\n51: \n52: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n53: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n54: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n55: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n56: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n57: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n58: \n59: // ───────────────────────────────────────────────────────────────────\n60: // 3. HELPERS\n61: // ───────────────────────────────────────────────────────────────────\n62: \n63: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n64: // stdout or the tool response, and never changes the recommendation outcome.\n65: function emitCompiledRoutingBreadcrumb(message: string): void {\n66:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n67:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n68:   }\n69: }\n70: \n71: function findWorkspaceRoot(start = process.cwd()): string {\n72:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n73: }\n74: \n75: // Canonicalize a caller-supplied workspaceRoot via realpath.\n76: // The schema-level allowlist refinement runs against the same canonical\n77: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n78: // post-symlink before downstream code uses it.\n79: function canonicalizeWorkspaceRoot(input: string): string {\n80:   const resolved = resolve(input);\n81:   try {\n82:     return realpathSync.native(resolved);\n83:   } catch {\n84:     return resolved;\n85:   }\n86: }\n87: \n88: function cacheSourceSignature(status: AdvisorStatus): string {\n89:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n90: }\n91: \n92: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n93:   return output.recommendations.map((recommendation) => recommendation.skillId);\n94: }\n95: \n96: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n97:   return {\n98:     state: 'unavailable',\n99:     reason,\n100:     generation: 0,\n101:     checkedAt: new Date().toISOString(),\n102:     lastLiveAt: null,\n103:   };\n104: }\n105: \n106: function publicThresholds(args: {\n107:   confidenceThreshold?: number;\n108:   uncertaintyThreshold?: number;\n109: }): PublicThresholds {\n110:   const resolved = resolveAdvisorThresholdConfig(args);\n111:   return {\n112:     confidenceThreshold: resolved.confidenceThreshold,\n113:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n114:     confidenceOnly: resolved.confidenceOnly,\n115:   };\n116: }\n117: \n118: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n119:   if (status.freshness !== 'stale') {\n120:     return undefined;\n121:   }\n122:   return {\n123:     graph_causal: {\n124:       status: 'runtime_degraded',\n125:       reason: status.trustState.reason ?? 'skill_graph_stale',\n126:     },\n127:   };\n128: }\n129: \n130: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n131:   const trustState = status.trustState.state;\n132:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n133:     return { ...status, freshness: trustState };\n134:   }\n135:   return status;\n136: }\n137: \n138: function emptyOutput(args: {\n139:   workspaceRoot: string;\n140:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n141:   freshness: AdvisorRecommendOutput['freshness'];\n142:   trustState: AdvisorRecommendOutput['trustState'];\n143:   warnings?: readonly string[];\n144:   abstainReasons?: readonly string[];\n145: }): AdvisorRecommendOutput {\n146:   return AdvisorRecommendOutputSchema.parse({\n147:     workspaceRoot: args.workspaceRoot,\n148:     effectiveThresholds: args.effectiveThresholds,\n149:     recommendations: [],\n150:     ambiguous: false,\n151:     freshness: args.freshness,\n152:     trustState: args.trustState,\n153:     generatedAt: new Date().toISOString(),\n154:     cache: {\n155:       hit: false,\n156:       sourceSignaturePresent: false,\n157:     },\n158:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n159:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n160:   });\n161: }\n162: \n163: // The canonical flag is checked first so the reason names it when both are set.\n164: const ADVISOR_DISABLED_FLAGS = [\n165:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n166:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n167: ] as const;\n168: \n169: function disabledOutput(\n170:   workspaceRoot: string,\n171:   effectiveThresholds: PublicThresholds,\n172:   disabledBy: string,\n173: ): AdvisorRecommendOutput {\n174:   return emptyOutput({\n175:     workspaceRoot,\n176:     effectiveThresholds,\n177:     freshness: 'unavailable',\n178:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n179:     warnings: ['ADVISOR_DISABLED'],\n180:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n181:   });\n182: }\n183: \n184: function absentOutput(\n185:   status: AdvisorStatus,\n186:   workspaceRoot: string,\n187:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n188: ): AdvisorRecommendOutput {\n189:   return emptyOutput({\n190:     workspaceRoot,\n191:     effectiveThresholds,\n192:     freshness: 'absent',\n193:     trustState: status.trustState,\n194:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n195:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n196:   });\n197: }\n198: \n199: function unavailableOutput(\n200:   status: AdvisorStatus,\n201:   workspaceRoot: string,\n202:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n203: ): AdvisorRecommendOutput {\n204:   return emptyOutput({\n205:     workspaceRoot,\n206:     effectiveThresholds,\n207:     freshness: 'unavailable',\n208:     trustState: {\n209:       ...status.trustState,\n210:       state: 'unavailable',\n211:       reason: 'advisor_unavailable',\n212:     },\n213:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n214:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n215:   });\n216: }\n217: \n218: function safeMany(values: readonly string[] | undefined): string[] {\n219:   return (values ?? [])\n220:     .map((value) => sanitizeSkillLabel(value))\n221:     .filter((value): value is string => Boolean(value));\n222: }\n223: \n224: function evidenceFeature(value: string): string {\n225:   const prefix = value.split(':', 1)[0];\n226:   switch (prefix) {\n227:     case 'phrase':\n228:       return 'phrase_match';\n229:     case 'token':\n230:       return 'token_match';\n231:     case 'hint':\n232:       return 'category_hint';\n233:     case 'derived':\n234:       return 'derived_skill_signal';\n235:     case 'doc':\n236:       return 'doc_reference_signal';\n237:     case 'cosine':\n238:       return 'semantic_similarity';\n239:     default:\n240:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n241:       if (value.includes('surface')) return 'surface_signal';\n242:       if (value.includes('intent')) return 'intent_signal';\n243:       if (value.includes('loop')) return 'workflow_signal';\n244:       return 'scorer_signal';\n245:   }\n246: }\n247: \n248: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n249:   const positiveLanes = recommendation.laneContributions\n250:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n251:     .sort((left, right) => right.weightedScore - left.weightedScore)\n252:     .slice(0, 4);\n253:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n254:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n255:       lane: lane.lane,\n256:       feature,\n257:     }))\n258:   ));\n259:   const dominant = recommendation.dominantLane;\n260:   return {\n261:     reason: dominant\n262:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n263:       : 'Recommended from ranker signals without a single dominant live lane.',\n264:     dominantLane: dominant,\n265:     topLanes: positiveLanes.map((lane) => ({\n266:       lane: lane.lane,\n267:       rawScore: lane.rawScore,\n268:       weightedScore: lane.weightedScore,\n269:       weight: lane.weight,\n270:       shadowOnly: lane.shadowOnly,\n271:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n272:       evidenceCount: lane.evidence.length,\n273:     })),\n274:     matchedSkillFeatures,\n275:   };\n276: }\n277: \n278: // Doc evidence entries are skill-relative markdown paths emitted by the\n279: // derived lane as `doc:<path>`. The allowlist rejects anything that\n280: // could smuggle prompt content or path traversal into the response.\n281: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n282: \n283: export function matchedDocsFromContributions(\n284:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n285: ): string[] {\n286:   const docs: string[] = [];\n287:   for (const lane of recommendation.laneContributions) {\n288:     for (const entry of lane.evidence) {\n289:       if (!entry.startsWith('doc:')) continue;\n290:       const path = entry.slice(4);\n291:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n292:       if (!docs.includes(path)) docs.push(path);\n293:       if (docs.length >= 3) return docs;\n294:     }\n295:   }\n296:   return docs;\n297: }\n298: \n299: function workflowModeForRecommendation(\n300:   recommendation: ScoredRecommendation,\n301:   prompt: string,\n302: ): string | undefined {\n303:   const directMode = modeForAlias(recommendation.skill);\n304:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n305:     ? modeForPromptAlias(prompt)\n306:     : null;\n307:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n308:   return workflowMode || undefined;\n309: }\n310: \n311: function publicRecommendation(\n312:   recommendation: ScoredRecommendation,\n313:   includeAttribution: boolean,\n314:   prompt: string,\n315: ) {\n316:   const skillId = sanitizeSkillLabel(recommendation.skill);\n317:   if (!skillId) return null;\n318:   const commandRow = commandRowFor(recommendation.skill);\n319:   const matchedDocs = matchedDocsFromContributions(recommendation);\n320:   const redirectFrom = safeMany(recommendation.redirectFrom);\n321:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n322:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n323:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n324:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n325:     || sanitizedStatus === 'deprecated'\n326:     || sanitizedStatus === 'archived'\n327:     || sanitizedStatus === 'future'\n328:     ? sanitizedStatus as PublicRecommendationStatus\n329:     : undefined;\n330:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n331:   return {\n332:     skillId,\n333:     kind: recommendation.kind,\n334:     score: recommendation.score,\n335:     confidence: recommendation.confidence,\n336:     uncertainty: recommendation.uncertainty,\n337:     dominantLane: recommendation.dominantLane,\n338:     ...(includeAttribution ? {\n339:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n340:         lane: lane.lane,\n341:         rawScore: lane.rawScore,\n342:         weightedScore: lane.weightedScore,\n343:         weight: lane.weight,\n344:         shadowOnly: lane.shadowOnly,\n345:       })),\n346:       why_recommended: publicWhyRecommended(recommendation),\n347:     } : {}),\n348:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n349:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n350:     ...(redirectTo ? { redirectTo } : {}),\n351:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n352:     // command already ranked below its seed has to say so here.\n353:     ...(heldBelow ? { heldBelow } : {}),\n354:     ...(status ? { status } : {}),\n355:     ...(workflowMode ? { workflowMode } : {}),\n356:     // A command row is the contract a reader acts on, so its runnable string,\n357:     // policy and owner travel with the pick. An id with no row adds nothing.\n358:     ...(commandRow ? {\n359:       command: commandRow.command,\n360:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n361:       ownerSkillId: commandRow.ownerSkillId,\n362:     } : {}),\n363:   };\n364: }\n365: \n366: // The front door runs from the request's workspaceRoot, and a caller may name\n367: // another checkout there, such as a worktree under the repository root. Its copy\n368: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n369: // gets no compiled route rather than the prompt in argv.\n370: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n371:   try {\n372:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n373:   } catch {\n374:     return false;\n375:   }\n376: }\n377: \n378: function compiledRouteForRecommendation(\n379:   skillId: string,\n380:   prompt: string,\n381:   workspaceRoot: string,\n382:   surfaceHint?: string,\n383: ): Record<string, unknown> | undefined {\n384:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n385:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n386:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n387:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n388:     return undefined;\n389:   }\n390:   try {\n391:     const args = [\n392:       frontDoor,\n393:       '--hub',\n394:       skillId,\n395:       '--prompt-stdin',\n396:     ];\n397:     // A hint the caller already holds is forwarded as its own argv element;\n398:     // the front door ignores a value that names no known surface.\n399:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n400:     const output = execFileSync(process.execPath, args, {\n401:       cwd: workspaceRoot,\n402:       encoding: 'utf8',\n403:       input: prompt,\n404:       stdio: ['pipe', 'pipe', 'pipe'],\n405:       timeout: 5_000,\n406:       maxBuffer: 1_048_576,\n407:     });\n408:     const parsed: unknown = JSON.parse(output.trim());\n409:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n410:       return undefined;\n411:     }\n412:     const compiledRoute = parsed as Record<string, unknown>;\n413:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n414:   } catch (error) {\n415:     // Surface the otherwise-silent fallback (debug-gated), including any child\n416:     // stderr the pipe above now captures instead of discarding. The served\n417:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n418:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n419:     const detail = typeof childStderr === 'string' && childStderr.trim()\n420:       ? ` child-stderr=${childStderr.trim()}`\n421:       : '';\n422:     emitCompiledRoutingBreadcrumb(\n423:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n424:     );\n425:     return undefined;\n426:   }\n427: }\n428: \n429: function enrichCompiledRoutes(\n430:   output: AdvisorRecommendOutput,\n431:   prompt: string,\n432:   workspaceRoot: string,\n433:   surfaceHint?: string,\n434:   topOnly = false,\n435: ): AdvisorRecommendOutput {\n436:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n437:   if (mode === 'invalid') {\n438:     emitCompiledRoutingBreadcrumb(\n439:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n440:     );\n441:   }\n442:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n443:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n444:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n445:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n446:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n447:   // returned unchanged.\n448:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n449:   if (!anyEligible) return output;\n450:   const namedSkills = extractMetalinguisticSkillMentions(prompt);\n451:   // A command row that already ranks in this result offers its command by itself,\n452:   // so the owning hub must not offer the same one again and spend a second slot on it.\n453:   const alreadyOffered = new Set<string>();\n454:   for (const recommendation of output.recommendations) {\n455:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n456:   }\n457:   return AdvisorRecommendOutputSchema.parse({\n458:     ...output,\n459:     recommendations: output.recommendations.map((recommendation, index) => {\n460:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n461:       // pays for that one and no more.\n462:       if (topOnly && index > 0) return recommendation;\n463:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n464:       const compiledRoute = compiledRouteForRecommendation(\n465:         recommendation.skillId,\n466:         prompt,\n467:         workspaceRoot,\n468:         surfaceHint,\n469:       );\n470:       if (!compiledRoute) return recommendation;\n471:       // The route answers which mode the hub would take; the command is what a reader\n472:       // types to run it, so it rides along only when the route names exactly one mode\n473:       // that has a command. A broader route leaves the key off rather than guessing.\n474:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n475:       return command && !alreadyOffered.has(command)\n476:         ? {\n477:           ...recommendation,\n478:           compiledRoute,\n479:           command,\n480:           ...(Object.hasOwn(TRACKED_COMMANDS, command) ? { policy: TRACKED_COMMANDS[command].policy } : {}),\n481:         }\n482:         : { ...recommendation, compiledRoute, ...(!command && routeNeedsMode(recommendation.skillId, compiledRoute, namedSkills) ? { needsMode: true as const } : {}) };\n483:     }),\n484:   });\n485: }\n486: \n487: // A typed command is the reader's own choice, so it outranks a routed mode: the\n488: // reader already named the command, and a compiled route only guesses which mode\n489: // they meant. The top recommendation carries it because that is the row a reader\n490: // acts on, and an unrelated top keeps the output it had.\n491: export function attachTypedCommand(\n492:   output: AdvisorRecommendOutput,\n493:   prompt: string,\n494: ): AdvisorRecommendOutput {\n495:   const top = output.recommendations[0];\n496:   if (!top) return output;\n497:   const typed = typedCommandForTop(top.skillId, prompt);\n498:   if (!typed) return output;\n499:   return AdvisorRecommendOutputSchema.parse({\n500:     ...output,\n501:     recommendations: [\n502:       {\n503:         ...top,\n504:         command: typed.command,\n505:         policy: typed.policy,\n506:         ownerSkillId: typed.ownerSkillId,\n507:       },\n508:       ...output.recommendations.slice(1),\n509:     ],\n510:   });\n511: }\n512: \n513: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n514:   const shadowRecommendations: ShadowRecommendation[] = [];\n515:   for (const recommendation of recommendations) {\n516:     const skillId = sanitizeSkillLabel(recommendation.skill);\n517:     if (!skillId) continue;\n518:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n519:       lane: lane.lane,\n520:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n521:     }));\n522:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n523:     const dominant = shadowContributions\n524:       .filter((lane) => lane.weightedScore > 0)\n525:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n526:     shadowRecommendations.push({\n527:         skillId,\n528:         liveScore: recommendation.score,\n529:         shadowScore,\n530:         delta: roundScore(shadowScore - recommendation.score),\n531:         dominantShadowLane: dominant,\n532:     });\n533:   }\n534:   return shadowRecommendations\n535:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n536:     .slice(0, topK);\n537: }\n538: \n539: function roundScore(value: number): number {\n540:   return Math.round(value * 1_000_000) / 1_000_000;\n541: }\n542: \n543: // A semantic lane that fell back to phrase scoring still answers, so the reason\n544: // it declined travels as a warning rather than changing the recommendation.\n545: export function semanticLaneOffWarning(reason: string | null): string[] {\n546:   return reason ? [`semantic_lane_off:${reason}`] : [];\n547: }\n548: \n549: function outputWarnings(\n550:   status: AdvisorStatus,\n551:   result: ReturnType<typeof scoreAdvisorPrompt>,\n552:   semanticLaneOffReason: string | null,\n553: ): string[] {\n554:   const degradedLanes = result.metrics.degradedLanes ?? [];\n555:   return [\n556:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n557:     ...(degradedLanes.length > 0\n558:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n559:       : []),\n560:     ...semanticLaneOffWarning(semanticLaneOffReason),\n561:   ];\n562: }\n563: \n564: function outputAbstainReasons(\n565:   input: AdvisorRecommendInput,\n566:   result: ReturnType<typeof scoreAdvisorPrompt>,\n567: ): string[] {\n568:   if (!input.options?.includeAbstainReasons) return [];\n569:   return [\n570:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n571:     ...(result.abstainReasons ?? []),\n572:   ];\n573: }\n574: \n575: // ───────────────────────────────────────────────────────────────────\n576: // 4. CORE LOGIC\n577: // ───────────────────────────────────────────────────────────────────\n578: \n579: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n580:   // Canonicalize via realpath after the schema allowlist check.\n581:   const workspaceRoot = input.workspaceRoot\n582:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n583:     : findWorkspaceRoot();\n584:   const effectiveThresholds = publicThresholds({\n585:     confidenceThreshold: input.options?.confidenceThreshold,\n586:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n587:   });\n588:   // Detect on-disk corruption here too: without it a malformed artifact reads\n589:   // 'live' from the generation counters and the recommend path would serve\n590:   // results as fresh. The verdict is cached per generation, so the quick_check\n591:   // runs at most once per rebuild rather than on every recommendation.\n592:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n593:   if (status.freshness === 'unavailable') {\n594:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n595:   }\n596:   if (status.freshness === 'absent') {\n597:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n598:   }\n599:   const sourceSignature = cacheSourceSignature(status);\n600:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n601:   const key = advisorPromptCache.makeKey({\n602:     canonicalPrompt: input.prompt.trim(),\n603:     sourceSignature,\n604:     workspaceRoot,\n605:     runtime: 'mcp',\n606:     maxTokens: input.options?.topK,\n607:     thresholdConfig: {\n608:       confidenceThreshold: input.options?.confidenceThreshold,\n609:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n610:       includeAttribution: input.options?.includeAttribution,\n611:       includeAbstainReasons: input.options?.includeAbstainReasons,\n612:     },\n613:   });\n614:   const cached = advisorPromptCache.get(key);\n615:   if (cached) {\n616:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n617:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n618:       ...cachedOutput,\n619:       workspaceRoot,\n620:       effectiveThresholds,\n621:       cache: {\n622:         ...cachedOutput.cache,\n623:         hit: true,\n624:       },\n625:     });\n626:     return attachTypedCommand(\n627:       input.options?.includeCompiledRoute === false\n628:         ? parsedCachedOutput\n629:         : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n630:       input.prompt,\n631:     );\n632:   }\n633: \n634:   const topK = input.options?.topK ?? 3;\n635:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n636:     workspaceRoot,\n637:     confidenceThreshold: input.options?.confidenceThreshold,\n638:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n639:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n640:   }));\n641:   // The lane records its health while the scored call runs, so the reason is\n642:   // read right after that call settles to describe this call's own fallback.\n643:   const semanticLaneOffReason = getSemanticShadowRuntimeHealth().disabledReason;\n644:   const recommendations = result.recommendations\n645:     .map((recommendation) => publicRecommendation(\n646:       recommendation,\n647:       Boolean(input.options?.includeAttribution),\n648:       input.prompt,\n649:     ))\n650:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n651:     .slice(0, topK);\n652:   const degradedLanes = result.metrics.degradedLanes ?? [];\n653:   const warnings = outputWarnings(status, result, semanticLaneOffReason);\n654:   const abstainReasons = outputAbstainReasons(input, result);\n655:   const output: AdvisorRecommendOutput = {\n656:     workspaceRoot,\n657:     effectiveThresholds,\n658:     recommendations,\n659:     ambiguous: result.ambiguous,\n660:     freshness: status.freshness,\n661:     trustState: status.trustState,\n662:     generatedAt: new Date().toISOString(),\n663:     cache: {\n664:       hit: false,\n665:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n666:     },\n667:     _shadow: {\n668:       model: 'advisor-shadow-learned-weights-v1',\n669:       liveWeightsFrozen: true,\n670:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n671:     },\n672:     ...(degradedLanes.length > 0 ? {\n673:       runtimeLaneHealth: {\n674:         liveLaneCount: result.metrics.liveLaneCount,\n675:         degradedLanes: [...degradedLanes],\n676:       },\n677:     } : {}),\n678:     ...(warnings.length > 0 ? { warnings } : {}),\n679:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n680:   };\n681:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n682:   if (shadowDeltaSinkEnabled()) {\n683:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n684:       recordShadowDelta({\n685:         prompt: `hmac:${key}`,\n686:         recommendation: shadow.skillId,\n687:         liveScore: shadow.liveScore,\n688:         shadowScore: shadow.shadowScore,\n689:         delta: shadow.delta,\n690:         dominantLane: shadow.dominantShadowLane,\n691:         timestamp: parsed.generatedAt,\n692:       });\n693:     }\n694:   }\n695:   advisorPromptCache.set({\n696:     key,\n697:     sourceSignature,\n698:     value: parsed,\n699:     skillLabels: recommendationLabels(parsed),\n700:   });\n701:   return attachTypedCommand(\n702:     input.options?.includeCompiledRoute === false\n703:       ? parsed\n704:       : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true),\n705:     input.prompt,\n706:   );\n707: }\n708: \n709: // ───────────────────────────────────────────────────────────────────\n710: // 5. EXPORTS\n711: // ───────────────────────────────────────────────────────────────────\n712: \n713: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n714:   const input = AdvisorRecommendInputSchema.parse(args);\n715:   // Canonicalize via realpath after the schema allowlist check.\n716:   const workspaceRoot = input.workspaceRoot\n717:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n718:     : findWorkspaceRoot();\n719:   const effectiveThresholds = publicThresholds({\n720:     confidenceThreshold: input.options?.confidenceThreshold,\n721:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n722:   });\n723:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n724:   const data = disabledBy\n725:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n726:     : await computeRecommendationOutput(input);\n727:   return {\n728:     content: [{\n729:       type: 'text',\n730:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n731:     }],\n732:   };\n733: }\n734: "}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794565079284,"end":1794565080193}}}}
{"type":"tool_use","timestamp":1794565080197,"sessionID":"ses_e2b969798ffeOhgXFij3UsleJR","part":{"partID":"prt_1d46a02c2001zz8P9GrtFDsG9t","sessionID":"ses_e2b969798ffeOhgXFij3UsleJR","messageID":"msg_1d469c691001gacOspaOw4XoHk","type":"tool","id":"call_4f0a6ad229144a9c91d13bf5","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts, lines 1-207\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Compiled-Route Option Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedChild = vi.hoisted(() => ({ execFileSync: vi.fn() }));\n11: vi.mock('node:child_process', () => ({ execFileSync: mockedChild.execFileSync }));\n12: \n13: import { frontDoorReadsPromptFromStdin, handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n14: import { MODE_COMMANDS } from '../../lib/command-attach.js';\n15: \n16: const COMPILED_ROUTING_FLAG = 'SPECKIT_COMPILED_ROUTING';\n17: const prompt = 'Implement a TypeScript feature with focused tests.';\n18: \n19: type RecommendResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n20: type ResponsePayload = {\n21:   data?: {\n22:     recommendations?: Array<{ skillId: string; command?: string; needsMode?: boolean }>;\n23:     cache?: { hit: boolean };\n24:   };\n25: };\n26: \n27: function responseData(response: RecommendResponse): ResponsePayload {\n28:   return JSON.parse(response.content[0]?.text ?? '{}') as ResponsePayload;\n29: }\n30: \n31: function compiledRouteCallCount(): number {\n32:   return mockedChild.execFileSync.mock.calls.filter(([, args]) => (\n33:     Array.isArray(args)\n34:       && args.some((argument) => (\n35:         typeof argument === 'string' && argument.endsWith('compiled-route.cjs')\n36:       ))\n37:   )).length;\n38: }\n39: \n40: function callsCompiledRoute(): boolean {\n41:   return compiledRouteCallCount() > 0;\n42: }\n43: \n44: describe('advisor_recommend compiled-route option', () => {\n45:   let previousCompiledRoutingFlag: string | undefined;\n46: \n47:   beforeEach(() => {\n48:     previousCompiledRoutingFlag = process.env[COMPILED_ROUTING_FLAG];\n49:     delete process.env[COMPILED_ROUTING_FLAG];\n50:     vi.clearAllMocks();\n51:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n52:       action: 'route',\n53:       hubId: 'sk-code',\n54:       targets: ['quality'],\n55:       servingAuthority: 'compiled',\n56:       fingerprint: 'abc123',\n57:       generation: 3,\n58:     }));\n59:   });\n60: \n61:   afterEach(() => {\n62:     if (previousCompiledRoutingFlag === undefined) {\n63:       delete process.env[COMPILED_ROUTING_FLAG];\n64:     } else {\n65:       process.env[COMPILED_ROUTING_FLAG] = previousCompiledRoutingFlag;\n66:     }\n67:   });\n68: \n69:   it('skips compiled-route enrichment on fresh and cached results when requested', async () => {\n70:     const withoutOption = await handleAdvisorRecommend({\n71:       prompt,\n72:       options: { includeAttribution: true },\n73:     });\n74:     expect(responseData(withoutOption).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n75:     expect(callsCompiledRoute()).toBe(true);\n76: \n77:     mockedChild.execFileSync.mockClear();\n78:     const withoutCompiledRoute = await handleAdvisorRecommend({\n79:       prompt,\n80:       options: { includeCompiledRoute: false },\n81:     });\n82:     expect(responseData(withoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n83:     expect(responseData(withoutCompiledRoute).data?.cache?.hit).toBe(false);\n84:     expect(callsCompiledRoute()).toBe(false);\n85: \n86:     const cachedWithoutCompiledRoute = await handleAdvisorRecommend({\n87:       prompt,\n88:       options: { includeCompiledRoute: false },\n89:     });\n90:     expect(responseData(cachedWithoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n91:     expect(responseData(cachedWithoutCompiledRoute).data?.cache?.hit).toBe(true);\n92:     expect(callsCompiledRoute()).toBe(false);\n93:   });\n94: \n95:   it('sends the prompt to the compiled-route front door on stdin, never in argv', async () => {\n96:     await handleAdvisorRecommend({ prompt, options: { includeAttribution: true } });\n97:     const call = mockedChild.execFileSync.mock.calls.find(([, args]) => (\n98:       Array.isArray(args) && args.some((argument) => typeof argument === 'string' && argument.endsWith('compiled-route.cjs'))\n99:     ));\n100:     expect(call).toBeDefined();\n101:     if (!call) return;\n102:     const [, args, options] = call as [string, string[], { input?: string }];\n103:     expect(args).toContain('--prompt-stdin');\n104:     expect(args).not.toContain(prompt);\n105:     expect(options.input).toBe(prompt);\n106:   });\n107: \n108:   it('looks up the route for the first recommendation alone when asked to', async () => {\n109:     const hubPrompt = 'create a new agent for code review';\n110:     await handleAdvisorRecommend({ prompt: hubPrompt, options: { includeCompiledRoute: true } });\n111:     const everyHub = compiledRouteCallCount();\n112:     expect(everyHub, 'the prompt ranks more than one hub').toBeGreaterThan(1);\n113: \n114:     mockedChild.execFileSync.mockClear();\n115:     const topOnly = responseData(await handleAdvisorRecommend({\n116:       prompt: hubPrompt,\n117:       options: { includeCompiledRoute: true, compiledRouteTopOnly: true },\n118:     })).data?.recommendations ?? [];\n119:     expect(compiledRouteCallCount()).toBeLessThanOrEqual(1);\n120:     expect(topOnly.slice(1).every((row) => !('compiledRoute' in row))).toBe(true);\n121:   });\n122: \n123:   it('never offers one command through both its own row and the owning hub', async () => {\n124:     const command = '/create:agent';\n125:     const mode = Object.entries(MODE_COMMANDS['sk-doc']).find(([, value]) => value === command)?.[0];\n126:     expect(mode, 'sk-doc declares a mode for /create:agent').toBeTruthy();\n127:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n128:       action: 'route',\n129:       hubId: 'sk-doc',\n130:       selectionKind: 'single',\n131:       targets: [{ workflowMode: mode }],\n132:     }));\n133: \n134:     // The command row ranks beside the hub here, so the hub stays silent.\n135:     const both = responseData(await handleAdvisorRecommend({\n136:       prompt: 'create a new agent for code review',\n137:       options: { includeCompiledRoute: true },\n138:     })).data?.recommendations ?? [];\n139:     expect(both.map((row) => row.skillId)).toContain('create:agent');\n140:     const hubBesideRow = both.find((row) => row.skillId === 'sk-doc');\n141:     expect(hubBesideRow, 'the hub still ranks').toBeDefined();\n142:     expect(hubBesideRow?.command).toBeUndefined();\n143: \n144:     // With no command row in the result the same route does carry the command,\n145:     // which is what proves the silence above came from the collision.\n146:     const hubOnly = responseData(await handleAdvisorRecommend({\n147:       prompt: 'Write a README for the payments module',\n148:       options: { includeCompiledRoute: true },\n149:     })).data?.recommendations ?? [];\n150:     expect(hubOnly.map((row) => row.skillId)).not.toContain('create:agent');\n151:     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n152:   });\n153: \n154:   it('marks a hub that needs a mode without marking a hub that has none', async () => {\n155:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n156:       action: 'defer',\n157:       hubId: 'sk-doc',\n158:       selectionKind: null,\n159:       targets: [],\n160:     }));\n161: \n162:     const withModeFlag = responseData(await handleAdvisorRecommend({\n163:       prompt: 'Use the sk-doc skill to write a README for the ledger module',\n164:       options: { includeCompiledRoute: true },\n165:     })).data?.recommendations ?? [];\n166:     const skDoc = withModeFlag.find((row) => row.skillId === 'sk-doc');\n167:     expect(skDoc, 'sk-doc ranks for the request').toBeDefined();\n168:     expect(skDoc?.needsMode).toBe(true);\n169:     expect(skDoc?.command).toBeUndefined();\n170: \n171:     const withoutNamedHub = responseData(await handleAdvisorRecommend({\n172:       prompt: 'Write a README for the ledger module',\n173:       options: { includeCompiledRoute: true },\n174:     })).data?.recommendations ?? [];\n175:     const guessedSkDoc = withoutNamedHub.find((row) => row.skillId === 'sk-doc');\n176:     expect(guessedSkDoc, 'sk-doc still ranks without being named').toBeDefined();\n177:     expect(guessedSkDoc).not.toHaveProperty('needsMode');\n178: \n179:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n180:       action: 'defer',\n181:       hubId: 'sk-code',\n182:       selectionKind: null,\n183:       targets: [],\n184:     }));\n185: \n186:     const withoutModeFlag = responseData(await handleAdvisorRecommend({\n187:       prompt: 'Implement a TypeScript feature with focused tests for the ledger.',\n188:       options: { includeCompiledRoute: true },\n189:     })).data?.recommendations ?? [];\n190:     const skCode = withoutModeFlag.find((row) => row.skillId === 'sk-code');\n191:     expect(skCode, 'sk-code ranks for the request').toBeDefined();\n192:     expect(skCode).not.toHaveProperty('needsMode');\n193:   });\n194: \n195:   it('recognizes only a front door that reads the prompt from stdin', () => {\n196:     const dir = mkdtempSync(join(tmpdir(), 'front-door-'));\n197:     try {\n198:       writeFileSync(join(dir, 'current.cjs'), \"const promptFromStdin = args.includes('--prompt-stdin');\\n\");\n199:       writeFileSync(join(dir, 'older.cjs'), \"const promptIdx = args.indexOf('--prompt');\\n\");\n200:       expect(frontDoorReadsPromptFromStdin(join(dir, 'current.cjs'))).toBe(true);\n201:       expect(frontDoorReadsPromptFromStdin(join(dir, 'older.cjs'))).toBe(false);\n202:       expect(frontDoorReadsPromptFromStdin(join(dir, 'missing.cjs'))).toBe(false);\n203:     } finally {\n204:       rmSync(dir, { recursive: true, force: true });\n205:     }\n206:   });\n207: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts, lines 1-207\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Recommend Compiled-Route Option Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedChild = vi.hoisted(() => ({ execFileSync: vi.fn() }));\n11: vi.mock('node:child_process', () => ({ execFileSync: mockedChild.execFileSync }));\n12: \n13: import { frontDoorReadsPromptFromStdin, handleAdvisorRecommend } from '../../handlers/advisor-recommend.js';\n14: import { MODE_COMMANDS } from '../../lib/command-attach.js';\n15: \n16: const COMPILED_ROUTING_FLAG = 'SPECKIT_COMPILED_ROUTING';\n17: const prompt = 'Implement a TypeScript feature with focused tests.';\n18: \n19: type RecommendResponse = Awaited<ReturnType<typeof handleAdvisorRecommend>>;\n20: type ResponsePayload = {\n21:   data?: {\n22:     recommendations?: Array<{ skillId: string; command?: string; needsMode?: boolean }>;\n23:     cache?: { hit: boolean };\n24:   };\n25: };\n26: \n27: function responseData(response: RecommendResponse): ResponsePayload {\n28:   return JSON.parse(response.content[0]?.text ?? '{}') as ResponsePayload;\n29: }\n30: \n31: function compiledRouteCallCount(): number {\n32:   return mockedChild.execFileSync.mock.calls.filter(([, args]) => (\n33:     Array.isArray(args)\n34:       && args.some((argument) => (\n35:         typeof argument === 'string' && argument.endsWith('compiled-route.cjs')\n36:       ))\n37:   )).length;\n38: }\n39: \n40: function callsCompiledRoute(): boolean {\n41:   return compiledRouteCallCount() > 0;\n42: }\n43: \n44: describe('advisor_recommend compiled-route option', () => {\n45:   let previousCompiledRoutingFlag: string | undefined;\n46: \n47:   beforeEach(() => {\n48:     previousCompiledRoutingFlag = process.env[COMPILED_ROUTING_FLAG];\n49:     delete process.env[COMPILED_ROUTING_FLAG];\n50:     vi.clearAllMocks();\n51:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n52:       action: 'route',\n53:       hubId: 'sk-code',\n54:       targets: ['quality'],\n55:       servingAuthority: 'compiled',\n56:       fingerprint: 'abc123',\n57:       generation: 3,\n58:     }));\n59:   });\n60: \n61:   afterEach(() => {\n62:     if (previousCompiledRoutingFlag === undefined) {\n63:       delete process.env[COMPILED_ROUTING_FLAG];\n64:     } else {\n65:       process.env[COMPILED_ROUTING_FLAG] = previousCompiledRoutingFlag;\n66:     }\n67:   });\n68: \n69:   it('skips compiled-route enrichment on fresh and cached results when requested', async () => {\n70:     const withoutOption = await handleAdvisorRecommend({\n71:       prompt,\n72:       options: { includeAttribution: true },\n73:     });\n74:     expect(responseData(withoutOption).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n75:     expect(callsCompiledRoute()).toBe(true);\n76: \n77:     mockedChild.execFileSync.mockClear();\n78:     const withoutCompiledRoute = await handleAdvisorRecommend({\n79:       prompt,\n80:       options: { includeCompiledRoute: false },\n81:     });\n82:     expect(responseData(withoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n83:     expect(responseData(withoutCompiledRoute).data?.cache?.hit).toBe(false);\n84:     expect(callsCompiledRoute()).toBe(false);\n85: \n86:     const cachedWithoutCompiledRoute = await handleAdvisorRecommend({\n87:       prompt,\n88:       options: { includeCompiledRoute: false },\n89:     });\n90:     expect(responseData(cachedWithoutCompiledRoute).data?.recommendations?.[0]?.skillId).toBe('sk-code');\n91:     expect(responseData(cachedWithoutCompiledRoute).data?.cache?.hit).toBe(true);\n92:     expect(callsCompiledRoute()).toBe(false);\n93:   });\n94: \n95:   it('sends the prompt to the compiled-route front door on stdin, never in argv', async () => {\n96:     await handleAdvisorRecommend({ prompt, options: { includeAttribution: true } });\n97:     const call = mockedChild.execFileSync.mock.calls.find(([, args]) => (\n98:       Array.isArray(args) && args.some((argument) => typeof argument === 'string' && argument.endsWith('compiled-route.cjs'))\n99:     ));\n100:     expect(call).toBeDefined();\n101:     if (!call) return;\n102:     const [, args, options] = call as [string, string[], { input?: string }];\n103:     expect(args).toContain('--prompt-stdin');\n104:     expect(args).not.toContain(prompt);\n105:     expect(options.input).toBe(prompt);\n106:   });\n107: \n108:   it('looks up the route for the first recommendation alone when asked to', async () => {\n109:     const hubPrompt = 'create a new agent for code review';\n110:     await handleAdvisorRecommend({ prompt: hubPrompt, options: { includeCompiledRoute: true } });\n111:     const everyHub = compiledRouteCallCount();\n112:     expect(everyHub, 'the prompt ranks more than one hub').toBeGreaterThan(1);\n113: \n114:     mockedChild.execFileSync.mockClear();\n115:     const topOnly = responseData(await handleAdvisorRecommend({\n116:       prompt: hubPrompt,\n117:       options: { includeCompiledRoute: true, compiledRouteTopOnly: true },\n118:     })).data?.recommendations ?? [];\n119:     expect(compiledRouteCallCount()).toBeLessThanOrEqual(1);\n120:     expect(topOnly.slice(1).every((row) => !('compiledRoute' in row))).toBe(true);\n121:   });\n122: \n123:   it('never offers one command through both its own row and the owning hub', async () => {\n124:     const command = '/create:agent';\n125:     const mode = Object.entries(MODE_COMMANDS['sk-doc']).find(([, value]) => value === command)?.[0];\n126:     expect(mode, 'sk-doc declares a mode for /create:agent').toBeTruthy();\n127:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n128:       action: 'route',\n129:       hubId: 'sk-doc',\n130:       selectionKind: 'single',\n131:       targets: [{ workflowMode: mode }],\n132:     }));\n133: \n134:     // The command row ranks beside the hub here, so the hub stays silent.\n135:     const both = responseData(await handleAdvisorRecommend({\n136:       prompt: 'create a new agent for code review',\n137:       options: { includeCompiledRoute: true },\n138:     })).data?.recommendations ?? [];\n139:     expect(both.map((row) => row.skillId)).toContain('create:agent');\n140:     const hubBesideRow = both.find((row) => row.skillId === 'sk-doc');\n141:     expect(hubBesideRow, 'the hub still ranks').toBeDefined();\n142:     expect(hubBesideRow?.command).toBeUndefined();\n143: \n144:     // With no command row in the result the same route does carry the command,\n145:     // which is what proves the silence above came from the collision.\n146:     const hubOnly = responseData(await handleAdvisorRecommend({\n147:       prompt: 'Write a README for the payments module',\n148:       options: { includeCompiledRoute: true },\n149:     })).data?.recommendations ?? [];\n150:     expect(hubOnly.map((row) => row.skillId)).not.toContain('create:agent');\n151:     expect(hubOnly.find((row) => row.skillId === 'sk-doc')?.command).toBe(command);\n152:   });\n153: \n154:   it('marks a hub that needs a mode without marking a hub that has none', async () => {\n155:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n156:       action: 'defer',\n157:       hubId: 'sk-doc',\n158:       selectionKind: null,\n159:       targets: [],\n160:     }));\n161: \n162:     const withModeFlag = responseData(await handleAdvisorRecommend({\n163:       prompt: 'Use the sk-doc skill to write a README for the ledger module',\n164:       options: { includeCompiledRoute: true },\n165:     })).data?.recommendations ?? [];\n166:     const skDoc = withModeFlag.find((row) => row.skillId === 'sk-doc');\n167:     expect(skDoc, 'sk-doc ranks for the request').toBeDefined();\n168:     expect(skDoc?.needsMode).toBe(true);\n169:     expect(skDoc?.command).toBeUndefined();\n170: \n171:     const withoutNamedHub = responseData(await handleAdvisorRecommend({\n172:       prompt: 'Write a README for the ledger module',\n173:       options: { includeCompiledRoute: true },\n174:     })).data?.recommendations ?? [];\n175:     const guessedSkDoc = withoutNamedHub.find((row) => row.skillId === 'sk-doc');\n176:     expect(guessedSkDoc, 'sk-doc still ranks without being named').toBeDefined();\n177:     expect(guessedSkDoc).not.toHaveProperty('needsMode');\n178: \n179:     mockedChild.execFileSync.mockReturnValue(JSON.stringify({\n180:       action: 'defer',\n181:       hubId: 'sk-code',\n182:       selectionKind: null,\n183:       targets: [],\n184:     }));\n185: \n186:     const withoutModeFlag = responseData(await handleAdvisorRecommend({\n187:       prompt: 'Implement a TypeScript feature with focused tests for the ledger.',\n188:       options: { includeCompiledRoute: true },\n189:     })).data?.recommendations ?? [];\n190:     const skCode = withoutModeFlag.find((row) => row.skillId === 'sk-code');\n191:     expect(skCode, 'sk-code ranks for the request').toBeDefined();\n192:     expect(skCode).not.toHaveProperty('needsMode');\n193:   });\n194: \n195:   it('recognizes only a front door that reads the prompt from stdin', () => {\n196:     const dir = mkdtempSync(join(tmpdir(), 'front-door-'));\n197:     try {\n198:       writeFileSync(join(dir, 'current.cjs'), \"const promptFromStdin = args.includes('--prompt-stdin');\\n\");\n199:       writeFileSync(join(dir, 'older.cjs'), \"const promptIdx = args.indexOf('--prompt');\\n\");\n200:       expect(frontDoorReadsPromptFromStdin(join(dir, 'current.cjs'))).toBe(true);\n201:       expect(frontDoorReadsPromptFromStdin(join(dir, 'older.cjs'))).toBe(false);\n202:       expect(frontDoorReadsPromptFromStdin(join(dir, 'missing.cjs'))).toBe(false);\n203:     } finally {\n204:       rmSync(dir, { recursive: true, force: true });\n205:     }\n206:   });\n207: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-recommend-compiled-route-option.vitest.ts\"}"},"time":{"start":1794565079746,"end":1794565080197}}}}
