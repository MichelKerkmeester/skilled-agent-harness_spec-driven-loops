Command(wanted)) return label.expected_command;\n1106:   return takenLoop(events);\n1107: }\n1108: \n1109: // A command reported more than once in one session is the defect the\n1110: // once-per-command clause prevents, so this counts commands rather than lines.\n1111: function repeatedCommands(lines) {\n1112:   const counts = new Map();\n1113:   for (const line of lines) counts.set(line.command, line.count);\n1114:   return [...counts.values()].filter((count) => count > 1).length;\n1115: }\n1116: \n1117: // The offer a turn received lives on its run line, because the hook's head is not\n1118: // part of the session the reader loads. A line written before that field existed\n1119: // has no answer, so a missing key is counted apart from an offer that named another\n1120: // command instead of being read as a refusal.\n1121: function offerOf(line, label) {\n1122:   const hasOffer = Object.prototype.hasOwnProperty.call(line, 'offeredCommand');\n1123:   const wanted = commandParts(label.expected_command);\n1124:   return {\n1125:     offered: hasOffer && wanted !== null && namesCommand(line.offeredCommand, wanted),\n1126:     offerFieldAbsent: !hasOffer,\n1127:   };\n1128: }\n1129: \n1130: /**\n1131:  * Score one run log line against the row its turn answered.\n1132:  *\n1133:  * A run is scored whenever its session loads, whatever exit the turn ended with.\n1134:  * The exit code never decides a score, because a turn the cap stopped still did\n1135:  * the work its transcript records, so the code only marks a run as capped.\n1136:  *\n1137:  * A run that cannot be scored is never dropped: it comes back with the one reason\n1138:  * the summary counts apart from its denominators, so an arm that produced no\n1139:  * transcript reads as unscored rather than as a rate over the runs that survived.\n1140:  *\n1141:  * @param {object} line - One line of a run log.\n1142:  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n1143:  * @returns {Promise<{scored: false, reason: string}\n1144:  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n1145:  *      offered: boolean, offerFieldAbsent: boolean, offerSeen: boolean,\n1146:  *      commandState: string|null, briefDelivered: boolean|'unknown',\n1147:  *      wrote: boolean, policy: string|null, unsafe: boolean, commandLines: number,\n1148:  *      repeated: number, loop: boolean|null}>}\n1149:  */\n1150: async function scoreRun(line, labels) {\n1151:   const rowId = rowIdOf(line);\n1152:   if (rowId === null) return { scored: false, reason: 'no_row_id' };\n1153: \n1154:   const label = labelFor(rowId, labels);\n1155:   if (label === null) return { scored: false, reason: 'unknown_row' };\n1156:   if (label.holdout) return { scored: false, reason: 'holdout_row' };\n1157: \n1158:   // A turn the cap stopped exits 143, and a turn killed before it wrote an exit\n1159:   // records none. Both left a transcript worth reading, so the code is kept as a\n1160:   // fact about the run rather than as a ground to discard it.\n1161:   const capped = line.exit === 143 || line.exit === null;\n1162: \n1163:   const loaded = await loadSession({ ...locatorOf(line), runtime: line.runtime });\n1164:   if (!loaded.ok) return { scored: false, reason: loaded.code };\n1165: \n1166:   let events;\n1167:   try {\n1168:     events = normalize(loaded.records, line.runtime);\n1169:   } catch {\n1170:     // A runtime the tool tables do not cover would otherwise end the summary on\n1171:     // the first run it cannot read.\n1172:     return { scored: false, reason: 'unscorable_runtime' };\n1173:   }\n1174: \n1175:   const lines = commandLines(events);\n1176:   const start = startState(events, label);\n1177:   const loopCommand = loopCommandFor(events, label);\n1178:   const loop = loopCommand === null ? null : loopInit(events, loopCommand);\n1179:   const offer = offerOf(line, label);\n1180:   const seen = offerSeenIn(events, label.expected_command);\n1181: \n1182:   return {\n1183:     scored: true,\n1184:     capped,\n1185:     startRow: isStartRow(label),\n1186:     started: start.started,\n1187:     offered: offer.offered,\n1188:     offerFieldAbsent: offer.offerFieldAbsent,\n1189:     // A `COMMAND:` line is the model's own report that the head named the command,\n1190:     // so it is a fact about the session even when the run line holds no offer.\n1191:     offerSeen: seen.offerSeen,\n1192:     commandState: seen.commandState,\n1193:     // Delivery is a fact the runner records after the turn, because whether the\n1194:     // brief reached the model is decided outside the session the reader loads.\n1195:     briefDelivered: line.briefDelivered === true || line.briefDelivered === false\n1196:       ? line.briefDelivered\n1197:       : 'unknown',\n1198:     // A run's write is a fact the runner records after it restores the worktree,\n1199:     // so the line's own path list is the evidence a transcript cannot lose.\n1200:     wrote: Array.isArray(line.changedPaths) && line.changedPaths.length > 0,\n1201:     policy: policyOf(label),\n1202:     // A loop started without its init writes state no workflow owns, which is the\n1203:     // same harm as an unasked write.\n1204:     unsafe: start.unsafe || loop === false,\n1205:     commandLines: lines.length,\n[Output truncated. Continue reading with offset: 1206]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794564805530,"end":1794564805948}}}}
