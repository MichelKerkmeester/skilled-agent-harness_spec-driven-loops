OfOffered} of ${block.offered - block.cappedOfferRows},`\n1400:           + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n1401:           + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n1402:           + ` offer field absent ${block.offerFieldAbsent},`\n1403:           + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n1404:           + ` repeated ${block.repeatedCommandLines},`\n1405:           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n1406:           + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\n1407:       );\n1408:       for (const miss of block.unscoredRuns) {\n1409:         process.stdout.write(`    unscored ${miss.rowId}: ${miss.reason}\\n`);\n1410:       }\n1411:       for (const name of POLICY_KEYS) {\n1412:         const policy = block.byPolicy[name];\n1413:         process.stdout.write(\n1414:           `    policy ${name}: ${policy.rows} rows, ${policy.capped} capped,`\n1415:             + ` ${policy.started} started, ${policy.wrote} wrote\\n`,\n1416:         );\n1417:       }\n1418:     }\n1419:   }\n1420: }\n1421: \n1422: // ───────────────────────────────────────────────────────────────────\n1423: // 14. RUN\n1424: // ───────────────────────────────────────────────────────────────────\n1425: \n1426: async function main(argv) {\n1427:   let options;\n1428:   let mode;\n1429:   try {\n1430:     options = parseArgs(argv);\n1431:     mode = selectMode(options);\n1432:   } catch (error) {\n1433:     if (!(error instanceof UsageError)) throw error;\n1434:     process.stderr.write(`${SCRIPT_NAME}: ${error.message}\\n${USAGE}`);\n1435:     return EXIT_UNREADABLE;\n1436:   }\n1437: \n1438:   if (mode === 'summary') {\n1439:     try {\n1440:       writeSummary(await summarize(options), options.json);\n1441:     } catch (error) {\n1442:       if (!(error instanceof LogError)) throw error;\n1443:       writeRefusal(error.code);\n1444:       return EXIT_UNREADABLE;\n1445:     }\n1446:     return 0;\n1447:   }\n1448:   return scoreSession(options);\n1449: }\n1450: \n1451: // The scorer's facts are exported for direct tests, so the CLI runs only when\n1452: // this file is the entry point. An imported module that parsed the host's argv\n1453: // would refuse on flags it never received. The entry path is compared after\n1454: // resolving links, because Node names a linked entry by its real path.\n1455: const invokedDirectly = (() => {\n1456:   if (typeof process.argv[1] !== 'string') return false;\n1457:   try {\n1458:     return realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));\n1459:   } catch {\n1460:     return false;\n1461:   }\n1462: })();\n1463: \n1464: if (invokedDirectly) process.exitCode = await main(process.argv.slice(2));"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\",\"offset\":1206}"},"time":{"start":1794564810873,"end":1794564811415}}}}
