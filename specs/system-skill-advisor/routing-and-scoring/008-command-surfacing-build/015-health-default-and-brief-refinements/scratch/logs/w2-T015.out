ax-query-tokens\",\n      \"token\": \"path\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"score\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"command\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"transcripts\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"t015 count unsafe run whose line lists no changed path score command transcripts\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"t015\",\n    \"count\",\n    \"unsafe\",\n    \"run\",\n    \"whose\",\n    \"line\",\n    \"lists\",\n    \"changed\"\n  ],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"T015 count unsafe run whose line lists no changed path score-command-transcripts\\\" 2>&1 | head -40\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794564761563,"end":1794564764333}}}}
