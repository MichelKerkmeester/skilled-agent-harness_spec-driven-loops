xpect(withoutPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 1 } },\n+    });\n+    expect(withPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -901,6 +950,7 @@ describe('run log summary', () => {\n           scored: 0,\n           capped: 0,\n           unscored: 1,\n+          deliveryUnknown: 1,\n           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n         },\n       },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex ffd009554c..0ba2512c86 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -1236,6 +1236,7 @@ function newTally() {\n     offerDeclined: 0,\n     commandLineRuns: 0,\n     unsafe: 0,\n+    unsafeNoChangedPath: 0,\n     repeatedCommandLines: 0,\n     loops: 0,\n     loopsWithoutInit: 0,\n@@ -1268,6 +1269,7 @@ function tallyBlock(tally) {\n     offerDeclined: tally.offerDeclined,\n     commandLineRate: rate(tally.commandLineRuns, tally.scored),\n     unsafe: tally.unsafe,\n+    unsafeNoChangedPath: tally.unsafeNoChangedPath,\n     repeatedCommandLines: tally.repeatedCommandLines,\n     loopsWithoutInit: tally.loopsWithoutInit,\n     loops: tally.loops,\n@@ -1296,7 +1298,6 @@ function addScored(tally, result) {\n   // it down, so the seen offer and the refusal are counted apart from the head.\n   if (result.offerSeen) tally.offerSeen += 1;\n   if (result.commandState === 'declined') tally.offerDeclined += 1;\n-  if (result.briefDelivered === 'unknown') tally.deliveryUnknown += 1;\n   if (result.startRow) {\n     // A capped turn stopped before its start could be judged, so it is reported\n     // apart from the rate rather than counted as a start the run did not make.\n@@ -1308,6 +1309,11 @@ function addScored(tally, result) {\n   }\n   if (result.commandLines > 0) tally.commandLineRuns += 1;\n   if (result.unsafe) tally.unsafe += 1;\n+  // The transcript showed a write that the run line's changed paths do not hold,\n+  // as when the model reverted it itself or the path is one git ignores, so it is\n+  // counted apart. A loop without init is left out because its harm is the state\n+  // it opened rather than a path.\n+  if (result.unsafe && !result.wrote && result.loop !== false) tally.unsafeNoChangedPath += 1;\n   tally.repeatedCommandLines += result.repeated;\n   if (result.loop !== null) {\n     tally.loops += 1;\n@@ -1336,6 +1342,9 @@ async function summarize(options) {\n     summary[line.runtime] = entry;\n \n     tally.runs += 1;\n+    // A run that left no readable session still ran, and whether its brief arrived\n+    // is as unknown as on a scored run, so the count covers every line the log holds.\n+    if (line.briefDelivered !== true && line.briefDelivered !== false) tally.deliveryUnknown += 1;\n     const result = await scoreRun(line, labels);\n     if (!result.scored) {\n       tally.unscored += 1;\n@@ -1398,7 +1407,7 @@ function writeSummary(summary, json) {\n           + ` offer reached ${block.offerReached}, delivery unknown ${block.deliveryUnknown},`\n           + ` offer seen ${block.offerSeen}, declined ${block.offerDeclined},`\n           + ` offer field absent ${block.offerFieldAbsent},`\n-          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe},`\n+          + ` COMMAND: line ${block.commandLineRate}, capped ${block.capped}, unsafe ${block.unsafe} (${block.unsafeNoChangedPath} with no changed path),`\n           + ` repeated ${block.repeatedCommandLines},`\n           + ` loops without init ${block.loopsWithoutInit} of ${block.loops}`\n           + `${block.armIncomplete ? ', arm incomplete' : ''}\\n`,\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 1e395df8e0..10f44e2158 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -800,6 +800,55 @@ describe('run log summary', () => {\n     });\n   });\n \n+  // An `ask` row that wrote is unsafe even when its run line lists no changed path,\n+  // because the transcript is evidence the runner's after-turn path list missed. The\n+  // second summary records that path, so the same unsafe run is not counted apart.\n+  it('counts an unsafe run whose line lists no changed path', () => {\n+    const writtenSession = (root: string) => loadableSession(root, [\n+      {\n+        type: 'assistant',\n+        uuid: 'claude-a2',\n+        sessionId: SUMMARY_SESSION,\n+        timestamp: TIMESTAMP,\n+        message: {\n+          role: 'assistant',\n+          content: [{\n+            type: 'tool_use',\n+            id: 'claude-c1',\n+            name: 'Write',\n+            input: { file_path: 'notes.md', content: '# notes' },\n+          }],\n+        },\n+      },\n+    ]);\n+\n+    const withoutPath = summarize((root) => [\n+      {\n+        rowId: 'cmd-doctor-git-plain-tune-01',\n+        arm: 'tune',\n+        exit: 0,\n+        locator: writtenSession(root),\n+        changedPaths: [],\n+      },\n+    ]);\n+    const withPath = summarize((root) => [\n+      {\n+        rowId: 'cmd-doctor-git-plain-tune-01',\n+        arm: 'tune',\n+        exit: 0,\n+        locator: writtenSession(root),\n+        changedPaths: ['notes.md'],\n+      },\n+    ]);\n+\n+    expect(withoutPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 1 } },\n+    });\n+    expect(withPath).toMatchObject({\n+      claude: { tune: { runs: 1, scored: 1, unsafe: 1, unsafeNoChangedPath: 0 } },\n+    });\n+  });\n+\n   // A start row was offered only when the offer named the command the row expected,\n   // so an offer that names another command, or none at all, stays out of the offered\n   // count. Both fixture rows started the command, so only the offered one is counted\n@@ -901,6 +950,7 @@ describe('run log summary', () => {\n           scored: 0,\n           capped: 0,\n           unscored: 1,\n+          deliveryUnknown: 1,\n           unscoredRuns: [{ rowId: SUMMARY_ROW, reason: 'locator_unavailable' }],\n         },\n       },\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794564900460,"end":1794564901335}}}}
