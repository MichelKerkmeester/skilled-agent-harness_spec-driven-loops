devin-db-damaged', async (root) => {\n+    const projectDir = join(root, 'project');\n+    mkdirSync(projectDir, { recursive: true });\n+    const fixture = devinSession({ root, projectDir });\n+    writeFileSync(fixture.dbPath, 'not a database');\n+    const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\n+    assert.equal(result.ok, true);\n+    assert.equal(result.source.locatorKind, 'transcript_file');\n+    assert.equal(result.items[0].content[0].text, 'Read the file.');\n+  });\n+});\n+\n test('a transcript outside the store is refused without reading it', async () => {\n   await withTempAsync('devin-outside', async (root) => {\n     const projectDir = join(root, 'project');\n     mkdirSync(projectDir, { recursive: true });\n","status":"modified","additions":13,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/hooks/shared/tests/session-readers/devin.test.mjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/devin.test.mjs\",\"oldString\":\"test('a transcript outside the store is refused without reading it', async () => {\",\"newString\":\"test('a damaged sessions database falls back to its transcript', async () => {\\n  await withTempAsync('devin-db-damaged', async (root) => {\\n    const projectDir = join(root, 'project');\\n    mkdirSync(projectDir, { recursive: true });\\n    const fixture = devinSession({ root, projectDir });\\n    writeFileSync(fixture.dbPath, 'not a database');\\n    const result = await readSession({ runtime: 'devin', sessionId: SESSION, ...fixture.options });\\n    assert.equal(result.ok, true);\\n    assert.equal(result.source.locatorKind, 'transcript_file');\\n    assert.equal(result.items[0].content[0].text, 'Read the file.');\\n  });\\n});\\n\\ntest('a transcript outside the st