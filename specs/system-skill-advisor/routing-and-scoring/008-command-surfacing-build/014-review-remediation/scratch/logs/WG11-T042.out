{"type":"tool_use","timestamp":1794558664320,"sessionID":"ses_e2bf948e7ffenifDgTfvJ4O3eR","part":{"partID":"prt_1d4081c4d001Bi7MNh6h2FzFqd","sessionID":"ses_e2bf948e7ffenifDgTfvJ4O3eR","messageID":"msg_1d4080df3001GIpnW8ejS8tTuc","type":"tool","id":"call_86216fcb609c459eac7aae8a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/fixtures.mjs","offset":190,"limit":180},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/fixtures.mjs, lines 190-369\n190:         .run('oc-p0', 'oc-u1', sessionId, T0 + 500, JSON.stringify({\n191:           id: 'oc-p0',\n192:           type: 'text',\n193:           text: 'Read the file.',\n194:         }));\n195:     }\n196: \n197:     if (withPart) {\n198:       database\n199:         .prepare('INSERT INTO part (id, message_id, session_id, time_created, data) VALUES (?, ?, ?, ?, ?)')\n200:         .run('oc-p1', 'oc-a1', sessionId, T0 + 3000, JSON.stringify({\n201:           id: 'oc-p1',\n202:           type: 'tool',\n203:           callID: 'oc-call-1',\n204:           tool: 'read',\n205:           state: { status: 'completed', input: { path: 'file.txt' }, output: 'file contents' },\n206:         }));\n207:     }\n208:   } finally {\n209:     database.close();\n210:   }\n211: \n212:   return { root: opencodeRoot, dbPath, options: { opencodeRoot, dbPath } };\n213: }\n214: \n215: // ─────────────────────────────────────────────────────────────────────────────\n216: // 5. DEVIN\n217: // ─────────────────────────────────────────────────────────────────────────────\n218: \n219: export function devinSession({\n220:   root,\n221:   projectDir,\n222:   sessionId = SESSION,\n223:   transcriptId = sessionId,\n224:   rowId = sessionId,\n225:   workingDirectory = projectDir,\n226:   withSessionsRow = true,\n227:   compacted = false,\n228: } = {}) {\n229:   const dataDir = join(root, 'devin', 'cli');\n230:   const filePath = join(dataDir, 'transcripts', `${sessionId}.json`);\n231: \n232:   writeJson(filePath, {\n233:     schema_version: 'ATIF-v1.7',\n234:     session_id: transcriptId,\n235:     steps: [\n236:       { step_id: 1, timestamp: iso(0), source: 'user', message: 'Read the file.' },\n237:       {\n238:         step_id: 2,\n239:         timestamp: iso(1000),\n240:         source: 'agent',\n241:         message: '',\n242:         tool_calls: [{ tool_call_id: 'devin-call-1', function_name: 'read_file', arguments: { path: 'file.txt' } }],\n243:         observation: { results: [{ source_call_id: 'devin-call-1', content: 'file contents' }] },\n244:       },\n245:       { step_id: 3, timestamp: iso(2000), source: 'agent', message: 'The file holds one line.' },\n246:     ],\n247:   });\n248: \n249:   mkdirSync(dataDir, { recursive: true });\n250:   const dbPath = join(dataDir, 'sessions.db');\n251:   const database = new DatabaseSync(dbPath);\n252:   try {\n253:     database.exec('CREATE TABLE sessions (id TEXT PRIMARY KEY, working_directory TEXT NOT NULL, main_chain_id INTEGER)');\n254:     database.exec(`\n255:       CREATE TABLE message_nodes (\n256:         row_id INTEGER PRIMARY KEY AUTOINCREMENT,\n257:         session_id TEXT NOT NULL,\n258:         node_id INTEGER NOT NULL,\n259:         parent_node_id INTEGER,\n260:         chat_message TEXT NOT NULL,\n261:         created_at INTEGER NOT NULL,\n262:         metadata TEXT,\n263:         UNIQUE(session_id, node_id)\n264:       )\n265:     `);\n266: \n267:     const nodes = [\n268:       {\n269:         nodeId: 0,\n270:         parentId: null,\n271:         message: { message_id: 'devin-user-1', role: 'user', content: 'Read the file.', metadata: { is_user_input: true, created_at: iso(0) } },\n272:         createdAt: Math.floor(T0 / 1000),\n273:       },\n274:       {\n275:         nodeId: 1,\n276:         parentId: 0,\n277:         message: {\n278:           message_id: 'devin-assistant-1',\n279:           role: 'assistant',\n280:           content: '',\n281:           tool_calls: [{ id: 'devin-call-1', name: 'read_file', arguments: { path: 'file.txt' }, index: 0, kind: 'function' }],\n282:           metadata: { created_at: iso(1000) },\n283:         },\n284:         createdAt: Math.floor((T0 + 1000) / 1000),\n285:       },\n286:       {\n287:         nodeId: 2,\n288:         parentId: 1,\n289:         message: { message_id: 'devin-tool-1', role: 'tool', content: 'file contents', tool_call_id: 'devin-call-1', metadata: { created_at: iso(1500) } },\n290:         createdAt: Math.floor((T0 + 1500) / 1000),\n291:       },\n292:       {\n293:         nodeId: 3,\n294:         parentId: 2,\n295:         message: { message_id: 'devin-assistant-2', role: 'assistant', content: 'The file holds one line.', metadata: { created_at: iso(2000) } },\n296:         createdAt: Math.floor((T0 + 2000) / 1000),\n297:       },\n298:     ];\n299: \n300:     // A compaction starts a new thread with no parent; its continuation node\n301:     // names the last node of the thread it summarized.\n302:     if (compacted) {\n303:       nodes.push(\n304:         {\n305:           nodeId: 4,\n306:           parentId: null,\n307:           message: { message_id: 'devin-continue-1', role: 'system', content: 'You are continuing work from a previous conversation thread.' },\n308:           metadata: { summarized_from: 3 },\n309:           createdAt: Math.floor((T0 + 3000) / 1000),\n310:         },\n311:         {\n312:           nodeId: 5,\n313:           parentId: 4,\n314:           message: { message_id: 'devin-user-2', role: 'user', content: 'Where were we?', metadata: { is_user_input: true, created_at: iso(4000) } },\n315:           createdAt: Math.floor((T0 + 4000) / 1000),\n316:         },\n317:       );\n318:     }\n319: \n320:     if (withSessionsRow) {\n321:       database\n322:         .prepare('INSERT INTO sessions (id, working_direc