onst name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n605:     const fixture = buildFixture(t, name);\n606:     const before = treeDigest(fixture.dir);\n607:     runCheck(['--root', fixture.dir, '--json']);\n608:     runCheck(['--root', fixture.dir]);\n609:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n610:   }\n611: });\n612: \n613: // ─────────────────────────────────────────────────────────────────────────────\n614: // 10. REPORT SHAPE\n615: // ─────────────────────────────────────────────────────────────────────────────\n616: \n617: test('every row appears in the report, once, in order', (t) => {\n618:   const fixture = buildFixture(t, 'pure');\n619:   const run = runCheck(['--root', fixture.dir]);\n620:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n621:   assert.deepEqual(printed, ROWS);\n622: \n623:   const report = buildReport({ root: fixture.dir });\n624:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n625: });\n626: \n627: test('--json carries the same rows and the same state as the text form', (t) => {\n628:   const fixture = buildFixture(t, 'forked');\n629:   const text = runCheck(['--root', fixture.dir]);\n[Output truncated. Continue reading with offset: 630]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 570-629\n570:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n571:   assert.doesNotMatch(run.err, /cannot read/u);\n572: });\n573: \n574: test('the write-spy records no filesystem write while every row executes', (t) => {\n575:   const fixture = buildFixture(t, 'forked');\n576:   const watched = [\n577:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n578: 