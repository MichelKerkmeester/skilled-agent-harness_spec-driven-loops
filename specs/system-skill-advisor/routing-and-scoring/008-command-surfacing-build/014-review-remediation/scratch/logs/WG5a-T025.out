-`));\n69:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n70:   const dir = path.join(parent, name);\n71:   composeFixture(name, dir);\n72:   const documentPath = path.join(dir, manifest.root_file);\n73:   return {\n74:     dir,\n75:     recipe: loadRecipe(name),\n76:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n77:   };\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 3. RUNNERS AND READERS\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function runCheck(args) {\n85:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n86:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n87: }\n88: \n89: function runJson(args) {\n90:   const run = runCheck([...args, '--json']);\n91:   let report = null;\n92:   try {\n93:     report = JSON.parse(run.out);\n94:   } catch {\n95:     report = null;\n96:   }\n97:   return { ...run, report };\n98: }\n99: \n100: function rowOf(report, id) {\n101:   const row = report.rows.find((entry) => entry.id === id);\n102:   assert.ok(row, `the report carries row ${id}`);\n103:   return row;\n104: }\n105: \n106: // The text form prints one line per row, ending in the row's verdict, so the two\n107: // renderers can be compared without re-implementing either.\n108: function textRowStates(out) {\n109:   const states = {};\n110:   for (const line of out.split('\\n')) {\n111:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n112:     if (hit) states[hit[1]] = hit[2];\n113:   }\n114:   return states;\n115: }\n116: \n117: function listFiles(dir) {\n118:   const files = [];\n119:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n120:     const target = path.join(dir, entry.name);\n121:     if (entry.isDirectory()) files.push(...listFiles(target));\n122:     else f