.ownerSkillId ?? recommendation.skill;\n227:   const policy = recommendation.policy ?? row?.policy;\n228:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n229:   const ownerPart = sanitizeSkillLabel(owner);\n230:   if (!commandPart || !ownerPart) {\n231:     return null;\n232:   }\n233:   const policyPart = policyWord(policy, row?.mutating, childSession);\n234:   return policyPart === null\n235:     ? `${ownerPart} → ${commandPart}`\n236:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n237: }\n238: \n239: // A doctor bridge renders as its runnable command and never as its raw id; an\n240: // unmapped doctor id renders nothing.\n241: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n242:   return commandLabel(recommendation, childSession)\n243:     ?? (isDoctorBridgeId(recommendation.skill)\n244:       ? doctorCommandString(recommendation.skill)\n245:       : sanitizeSkillLabel(recommendation.skill));\n246: }\n247: \n248: // The companion line normally shows only the runnable command. A child gets the\n249: // downgrade marker appended because that command must not be started there.\n250: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n251:   const command = doctorCommandString(skillId);\n252:   if (command === null) {\n253:     return null;\n254:   }\n[Output truncated. Continue reading with offset: 255]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":70,\"offset\":185,\"path\":\".skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794558854729,"end":1794558855207}}}}
