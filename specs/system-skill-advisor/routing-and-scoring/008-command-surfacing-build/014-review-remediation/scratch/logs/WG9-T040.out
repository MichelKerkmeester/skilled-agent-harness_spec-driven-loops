+    expect(published, `the baseline publishes a per-row outcome for ${published.length} holdout ids`).toEqual([]);\n+  });\n+\n   it('matches the captured totals', () => {\n     expect(live.metrics).toEqual(baseline.metrics);\n     expect(live.unreachable).toEqual(baseline.unreachable);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\nindex 9ed377507f..aba01f7013 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n@@ -492,6 +492,9 @@ export async function scoreCommandCorpus(options = {}) {\n       // command, which the behaviour run line records as `offeredCommand`.\n       const offered = landed.some((command) => command !== null);\n       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n+      // A holdout row's outcome is what the split exists to keep unseen, so\n+      // only its counts are published.\n+      const publishRow = row.split !== 'holdout';\n \n       // A hub can name the slash command its route would take, which is reach a\n       // reader otherwise gets only by translating the workflow mode by hand.\n@@ -509,13 +512,15 @@ export async function scoreCommandCorpus(options = {}) {\n       if (row.row_type === 'typed') {\n         addRow(typed, top1Hit, top3Hit);\n         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n-        typedRowResults[row.id] = {\n-          expected_command: expected,\n-          top: ids[0] ?? null,\n-          carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n-       