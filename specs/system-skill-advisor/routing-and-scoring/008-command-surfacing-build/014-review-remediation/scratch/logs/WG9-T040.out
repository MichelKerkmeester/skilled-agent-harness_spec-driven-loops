{"type":"tool_use","timestamp":1794560377738,"sessionID":"ses_e2bde2a21ffe162q7QQoGTpivB","part":{"partID":"prt_1d422401e002iAjsbU65QDud5l","sessionID":"ses_e2bde2a21ffe162q7QQoGTpivB","messageID":"msg_1d42225be001WXJTMVujpm5FPT","type":"tool","id":"call_8598882d3dd14b1ab121ca8b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts, lines 1-141\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Routing Slice\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Ratchets live command routing against the committed capture. An aggregate can\n6: // hold still while one row is gained and another lost, so the rows are compared\n7: // one by one and the corpus hash pins the prompts the capture was measured\n8: // against: a scoring change, a bridge-metadata change or a corpus edit has to\n9: // surface here instead of drifting in silently.\n10: \n11: import { readFileSync } from 'node:fs';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { beforeAll, describe, expect, it } from 'vitest';\n16: import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n17: \n18: const HERE = dirname(fileURLToPath(import.meta.url));\n19: const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n20: const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n21: const BASELINE_PATH = join(ROUTING, 'command-routing-baseline.json');\n22: const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n23: \n24: interface CorpusRow {\n25:   readonly id: string;\n26:   readonly row_type: string;\n27:   readonly split: string;\n28: }\n29: \n30: interface SplitTally {\n31:   readonly rows: number;\n32:   readonly top1: number;\n33:   readonly top3: number;\n34: }\n35: \n36: interface CommandTally {\n37:   readonly typed: SplitTally;\n38:   readonly plain: { readonly tune: SplitTally; readonly holdout: SplitTally };\n39: }\n40: \n41: interface CommandRow {\n42:   readonly expected_command: string | null;\n43:   readonly top: string | null;\n44:   readonly top1: boolean;\n45:   readonly top3: boolean;\n46:   readonly offered: boolean;\n47: }\n48: \n49: interface CommandRoutingBaseline {\n50:   readonly schemaVersion: number;\n51:   readonly capturedAt: string;\n52:   readonly capturedAtSha: string;\n53:   readonly corpusSha256: string;\n54:   readonly bridgeCounts: Readonly<Record<string, number>>;\n55:   readonly metrics: Readonly<Record<string, unknown>>;\n56:   readonly unreachable: readonly string[];\n57:   readonly commands: Readonly<Record<string, CommandTally>>;\n58:   readonly rows: Readonly<Record<string, CommandRow>>;\n59:   readonly attachedMetrics: Readonly<Record<string, unknown>>;\n60: }\n61: \n62: // The capture script is plain JavaScript with no declaration file of its own, so\n63: // the shape it returns is declared here and the import is cast to that shape\n64: // rather than left implicitly `any` at every call site.\n65: const scoreCommandCorpus = captureCommandCorpus as unknown as () => Promise<CommandRoutingBaseline>;\n66: \n67: function readJsonl<T>(path: string): T[] {\n68:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n69: }\n70: \n71: // A row that vanished from one side has no JSON to print, and an absent row is\n72: // exactly the drift worth naming, so it is labelled instead of rendered empty.\n73: function rowJson(rows: Readonly<Record<string, CommandRow>>, id: string): string {\n74:   return Object.hasOwn(rows, id) ? JSON.stringify(rows[id]) : '<missing>';\n75: }\n76: \n77: let live: CommandRoutingBaseline;\n78: let baseline: CommandRoutingBaseline;\n79: let corpus: CorpusRow[] = [];\n80: \n81: describe('command routing slice', () => {\n82:   beforeAll(async () => {\n83:     baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as CommandRoutingBaseline;\n84:     corpus = readJsonl<CorpusRow>(CORPUS_PATH);\n85:     // The capture owns its own environment projection and scoring clock, so it\n86:     // re-scores under the same regime the baseline was recorded in. Doing that\n87:     // setup again here would double it and let the two drift apart.\n88:     live = await scoreCommandCorpus();\n89:   }, 120_000);\n90: \n91:   it('matches the captured baseline row by row', () => {\n92:     // Corpus ids come first because a prompt added to the corpus but never\n93:     // captured is absent from both sides and would be invisible to a comparison\n94:     // of the two row maps alone.\n95:     const ids = [\n96:       ...new Set([...corpus.map((row) => row.id), ...Object.keys(baseline.rows), ...Object.keys(live.rows)]),\n97:     ];\n98:     const drifted: string[] = [];\n99:     for (const id of ids) {\n100:       const baselineJson = rowJson(baseline.rows, id);\n101:       const liveJson = rowJson(live.rows, id);\n102:       if (baselineJson !== liveJson) drifted.push(`${id}: baseline ${baselineJson} live ${liveJson}`);\n103:     }\n104:     expect(\n105:       drifted,\n106:       `command routing rows drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n107:     ).toEqual([]);\n108:   });\n109: \n110:   it('matches the captured totals', () => {\n111:     expect(live.metrics).toEqual(baseline.metrics);\n112:     expect(live.unreachable).toEqual(baseline.unreachable);\n113:     // `capturedAtSha` is deliberately not compared: it names the commit of the\n114:     // checkout that ran the capture, not anything the scorer decided.\n115:     expect(live.commands).toEqual(baseline.commands);\n116:     // The attached keys sit outside `metrics` and `commands` by design: they\n117:     // measure what a hub's own compiled route adds on the same rows, kept apart\n118:     // so the bridge numbers above cannot absorb a row the route reached.\n119:     expect(\n120:       live.attachedMetrics,\n121:       `command routing attached reach drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n122:     ).toEqual(baseline.attachedMetrics);\n123:   });\n124: \n125:   it('pins the corpus the baseline was captured against', () => {\n126:     // Row comparison can only catch a prompt that stopped routing as expected.\n127:     // The corpus hash catches the other direction: an edited, added or removed\n128:     // prompt that leaves every surviving row untouched.\n129:     expect(live.corpusSha256).toBe(baseline.corpusSha256);\n130:   });\n131: \n132:   it('has a typed row and both plain splits for every command file', () => {\n133:     // A command with an empty split carries no evidence either way, so its\n134:     // recall reads as a pass while the corpus never exercised it.\n135:     const uncovered = Object.keys(live.commands).filter((command) => {\n136:       const tally = live.commands[command];\n137:       return tally.typed.rows < 1 || tally.plain.tune.rows < 1 || tally.plain.holdout.rows < 1;\n138:     });\n139:     expect(uncovered).toEqual([]);\n140:   });\n141: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts, lines 1-141\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command Routing Slice\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Ratchets live command routing against the committed capture. An aggregate can\n6: // hold still while one row is gained and another lost, so the rows are compared\n7: // one by one and the corpus hash pins the prompts the capture was measured\n8: // against: a scoring change, a bridge-metadata change or a corpus edit has to\n9: // surface here instead of drifting in silently.\n10: \n11: import { readFileSync } from 'node:fs';\n12: import { dirname, join, resolve } from 'node:path';\n13: import { fileURLToPath } from 'node:url';\n14: \n15: import { beforeAll, describe, expect, it } from 'vitest';\n16: import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n17: \n18: const HERE = dirname(fileURLToPath(import.meta.url));\n19: const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n20: const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n21: const BASELINE_PATH = join(ROUTING, 'command-routing-baseline.json');\n22: const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n23: \n24: interface CorpusRow {\n25:   readonly id: string;\n26:   readonly row_type: string;\n27:   readonly split: string;\n28: }\n29: \n30: interface SplitTally {\n31:   readonly rows: number;\n32:   readonly top1: number;\n33:   readonly top3: number;\n34: }\n35: \n36: interface CommandTally {\n37:   readonly typed: SplitTally;\n38:   readonly plain: { readonly tune: SplitTally; readonly holdout: SplitTally };\n39: }\n40: \n41: interface CommandRow {\n42:   readonly expected_command: string | null;\n43:   readonly top: string | null;\n44:   readonly top1: boolean;\n45:   readonly top3: boolean;\n46:   readonly offered: boolean;\n47: }\n48: \n49: interface CommandRoutingBaseline {\n50:   readonly schemaVersion: number;\n51:   readonly capturedAt: string;\n52:   readonly capturedAtSha: string;\n53:   readonly corpusSha256: string;\n54:   readonly bridgeCounts: Readonly<Record<string, number>>;\n55:   readonly metrics: Readonly<Record<string, unknown>>;\n56:   readonly unreachable: readonly string[];\n57:   readonly commands: Readonly<Record<string, CommandTally>>;\n58:   readonly rows: Readonly<Record<string, CommandRow>>;\n59:   readonly attachedMetrics: Readonly<Record<string, unknown>>;\n60: }\n61: \n62: // The capture script is plain JavaScript with no declaration file of its own, so\n63: // the shape it returns is declared here and the import is cast to that shape\n64: // rather than left implicitly `any` at every call site.\n65: const scoreCommandCorpus = captureCommandCorpus as unknown as () => Promise<CommandRoutingBaseline>;\n66: \n67: function readJsonl<T>(path: string): T[] {\n68:   return readFileSync(path, 'utf8').trim().split('\\n').filter(Boolean).map((line) => JSON.parse(line) as T);\n69: }\n70: \n71: // A row that vanished from one side has no JSON to print, and an absent row is\n72: // exactly the drift worth naming, so it is labelled instead of rendered empty.\n73: function rowJson(rows: Readonly<Record<string, CommandRow>>, id: string): string {\n74:   return Object.hasOwn(rows, id) ? JSON.stringify(rows[id]) : '<missing>';\n75: }\n76: \n77: let live: CommandRoutingBaseline;\n78: let baseline: CommandRoutingBaseline;\n79: let corpus: CorpusRow[] = [];\n80: \n81: describe('command routing slice', () => {\n82:   beforeAll(async () => {\n83:     baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf8')) as CommandRoutingBaseline;\n84:     corpus = readJsonl<CorpusRow>(CORPUS_PATH);\n85:     // The capture owns its own environment projection and scoring clock, so it\n86:     // re-scores under the same regime the baseline was recorded in. Doing that\n87:     // setup again here would double it and let the two drift apart.\n88:     live = await scoreCommandCorpus();\n89:   }, 120_000);\n90: \n91:   it('matches the captured baseline row by row', () => {\n92:     // Corpus ids come first because a prompt added to the corpus but never\n93:     // captured is absent from both sides and would be invisible to a comparison\n94:     // of the two row maps alone.\n95:     const ids = [\n96:       ...new Set([...corpus.map((row) => row.id), ...Object.keys(baseline.rows), ...Object.keys(live.rows)]),\n97:     ];\n98:     const drifted: string[] = [];\n99:     for (const id of ids) {\n100:       const baselineJson = rowJson(baseline.rows, id);\n101:       const liveJson = rowJson(live.rows, id);\n102:       if (baselineJson !== liveJson) drifted.push(`${id}: baseline ${baselineJson} live ${liveJson}`);\n103:     }\n104:     expect(\n105:       drifted,\n106:       `command routing rows drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n107:     ).toEqual([]);\n108:   });\n109: \n110:   it('matches the captured totals', () => {\n111:     expect(live.metrics).toEqual(baseline.metrics);\n112:     expect(live.unreachable).toEqual(baseline.unreachable);\n113:     // `capturedAtSha` is deliberately not compared: it names the commit of the\n114:     // checkout that ran the capture, not anything the scorer decided.\n115:     expect(live.commands).toEqual(baseline.commands);\n116:     // The attached keys sit outside `metrics` and `commands` by design: they\n117:     // measure what a hub's own compiled route adds on the same rows, kept apart\n118:     // so the bridge numbers above cannot absorb a row the route reached.\n119:     expect(\n120:       live.attachedMetrics,\n121:       `command routing attached reach drifted from the committed baseline; re-capture with \\`${RECAPTURE}\\` when the change is intended`,\n122:     ).toEqual(baseline.attachedMetrics);\n123:   });\n124: \n125:   it('pins the corpus the baseline was captured against', () => {\n126:     // Row comparison can only catch a prompt that stopped routing as expected.\n127:     // The corpus hash catches the other direction: an edited, added or removed\n128:     // prompt that leaves every surviving row untouched.\n129:     expect(live.corpusSha256).toBe(baseline.corpusSha256);\n130:   });\n131: \n132:   it('has a typed row and both plain splits for every command file', () => {\n133:     // A command with an empty split carries no evidence either way, so its\n134:     // recall reads as a pass while the corpus never exercised it.\n135:     const uncovered = Object.keys(live.commands).filter((command) => {\n136:       const tally = live.commands[command];\n137:       return tally.typed.rows < 1 || tally.plain.tune.rows < 1 || tally.plain.holdout.rows < 1;\n138:     });\n139:     expect(uncovered).toEqual([]);\n140:   });\n141: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\"}"},"time":{"start":1794560376862,"end":1794560377738}}}}
{"type":"tool_use","timestamp":1794560377757,"sessionID":"ses_e2bde2a21ffe162q7QQoGTpivB","part":{"partID":"prt_1d42241c80015cnZ21w7SSJu68","sessionID":"ses_e2bde2a21ffe162q7QQoGTpivB","messageID":"msg_1d42225be001WXJTMVujpm5FPT","type":"tool","id":"call_70cc14267b49487ba7de9dbd","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-677\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n67: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n68: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n69: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n70: \n71: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n72: const COMMANDS_DIR = '.skilled/commands';\n73: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n74: // beside the commands is itself a command, so the skip is case-sensitive.\n75: const COMMAND_DOC_SKIP = 'README.md';\n76: const COMMAND_DOC_SUFFIX = '.md';\n77: // The compiled route is asked for through the public front door a hub's SKILL.md\n78: // calls, so this measures the decision the runtime actually serves rather than a\n79: // second derivation of it that could disagree with the first.\n80: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n81: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n82: \n83: // A real capture talks to the same embedder the recommend path does, so the probe\n84: // asks that daemon directly and names the model family the routing vectors come\n85: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n86: // table whose name carries the embedder dimension.\n87: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n88: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n89: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n90: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n91: \n92: // ───────────────────────────────────────────────────────────────────\n93: // 3. RUNTIME SETUP\n94: // ───────────────────────────────────────────────────────────────────\n95: //\n96: // Only the value lookups live here; the mutations themselves are deferred into\n97: // scoreCommandCorpus() so importing this module has no side effects.\n98: \n99: function isCalendarDate(value) {\n100:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n101:   const parsed = new Date(`${value}T00:00:00Z`);\n102:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n103: }\n104: \n105: // The derived lane halves each skill's score every 90 days of age, measured\n106: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n107: // scores move with the calendar. The scoring date is therefore inherited from\n108: // the scorer-eval baseline and pinned, never read from the wall clock: a\n109: // recapture on any day replays the recorded date and reproduces the same\n110: // numbers, which keeps the two baselines directly comparable.\n111: function readPinnedScoringDate() {\n112:   let recorded;\n113:   try {\n114:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n115:   } catch {\n116:     recorded = undefined;\n117:   }\n118:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n119:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n120:   }\n121:   return recorded;\n122: }\n123: \n124: // ───────────────────────────────────────────────────────────────────\n125: // 4. REAL EMBEDDING PREFLIGHT\n126: // ───────────────────────────────────────────────────────────────────\n127: //\n128: // A real capture scores whatever this machine's cosine lane can see, so both\n129: // halves of that lane are proved before a single row is scored: an embedder that\n130: // answers and a populated command vector table. Each half is named as itself when\n131: // it is missing, because a silent cosine lane reads exactly like a scoring change.\n132: \n133: async function assertEmbedderAnswers() {\n134:   const listed = [];\n135:   try {\n136:     const response = await fetch(EMBEDDER_TAGS_URL, { signal: AbortSignal.timeout(EMBEDDER_PROBE_TIMEOUT_MS) });\n137:     if (!response.ok) throw new Error(`HTTP ${response.status}`);\n138:     const payload = await response.json();\n139:     for (const model of Array.isArray(payload?.models) ? payload.models : []) {\n140:       if (typeof model?.name === 'string') listed.push(model.name);\n141:     }\n142:   } catch (error) {\n143:     const message = error instanceof Error ? error.message : String(error);\n144:     throw new Error(`real embedding needs a live embedder: GET ${EMBEDDER_TAGS_URL} failed (${message})`);\n145:   }\n146:   // The stored vectors were built with this model family, so a daemon serving some\n147:   // other model cannot answer them no matter how well the dimensions line up.\n148:   if (!listed.some((name) => name.startsWith(EMBEDDER_MODEL_PREFIX))) {\n149:     throw new Error(`real embedding needs an embedder serving ${EMBEDDER_MODEL_PREFIX}*: GET ${EMBEDDER_TAGS_URL} lists ${listed.length > 0 ? listed.join(', ') : 'no models'}`);\n150:   }\n151: }\n152: \n153: function assertCommandVectorsPresent(database, databasePath) {\n154:   if (!database) {\n155:     throw new Error(`real embedding needs command vectors: the skill graph database is absent (${databasePath})`);\n156:   }\n157:   // GLOB keeps the trailing underscore of the prefix literal, so the match is the\n158:   // `vec_cmd_<dim>` family alone rather than any name shaped like it.\n159:   const tables = database\n160:     .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name GLOB ?\")\n161:     .all(`${COMMAND_VECTOR_TABLE_PREFIX}*`)\n162:     .map((table) => table.name);\n163:   if (tables.length === 0) {\n164:     throw new Error(`real embedding needs command vectors: no ${COMMAND_VECTOR_TABLE_PREFIX}* table in ${databasePath}`);\n165:   }\n166:   const populated = tables.filter((name) => database.prepare(`SELECT COUNT(*) AS rowCount FROM \"${name}\"`).get().rowCount > 0);\n167:   if (populated.length === 0) {\n168:     throw new Error(`real embedding needs command vectors: ${tables.join(', ')} has no rows in ${databasePath}`);\n169:   }\n170: }\n171: \n172: // The wrapper, the embedder and the command vectors are resolved together because\n173: // a real capture needs all three or it measures nothing worth reporting.\n174: async function prepareRealEmbeddingScoring() {\n175:   if (!existsSync(SEMANTIC_SHADOW_MODULE)) {\n176:     throw new Error(`built semantic-shadow file missing: ${SEMANTIC_SHADOW_MODULE}`);\n177:   }\n178:   const { withSemanticShadowPromptEmbedding } = await import(pathToFileURL(SEMANTIC_SHADOW_MODULE).href);\n179:   const { getDbReadOnly, getSkillGraphDbPath } = await import(pathToFileURL(SKILL_GRAPH_DB_MODULE).href);\n180:   await assertEmbedderAnswers();\n181:   assertCommandVectorsPresent(getDbReadOnly(), getSkillGraphDbPath());\n182:   return withSemanticShadowPromptEmbedding;\n183: }\n184: \n185: // ───────────────────────────────────────────────────────────────────\n186: // 5. HELPERS\n187: // ───────────────────────────────────────────────────────────────────\n188: \n189: function sha256File(path) {\n190:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n191: }\n192: \n193: // Line numbers are reported as the physical line a bad row sits on, so a\n194: // parse failure points at the line to repair rather than at a row ordinal.\n195: function readCorpus(path) {\n196:   if (!existsSync(path)) throw new Error(`corpus file missing: ${path}`);\n197:   const lines = readFileSync(path, 'utf8').split('\\n');\n198:   const rows = [];\n199:   for (let index = 0; index < lines.length; index += 1) {\n200:     const line = lines[index].trim();\n201:     if (line === '') continue;\n202:     try {\n203:       rows.push(JSON.parse(line));\n204:     } catch (error) {\n205:       throw new Error(`invalid JSON on corpus line ${index + 1} of ${path}: ${error.message}`);\n206:     }\n207:   }\n208:   if (rows.length === 0) throw new Error(`corpus file empty: ${path}`);\n209:   return rows;\n210: }\n211: \n212: // Commands live exactly two levels deep, `<namespace>/<name>.md`, and become\n213: // `/<namespace>:<name>`. Anything directly in the commands root is a document\n214: // rather than a command, and deeper nesting is a command's own assets.\n215: function readCommandFileNames(workspaceRoot) {\n216:   const commandsRoot = resolve(workspaceRoot, COMMANDS_DIR);\n217:   const commands = [];\n218:   for (const namespace of readdirSync(commandsRoot, { withFileTypes: true })) {\n219:     if (!namespace.isDirectory()) continue;\n220:     for (const file of readdirSync(join(commandsRoot, namespace.name), { withFileTypes: true })) {\n221:       if (!file.isFile()) continue;\n222:       if (!file.name.endsWith(COMMAND_DOC_SUFFIX) || file.name === COMMAND_DOC_SKIP) continue;\n223:       commands.push(`/${namespace.name}:${file.name.slice(0, -COMMAND_DOC_SUFFIX.length)}`);\n224:     }\n225:   }\n226:   return commands.sort();\n227: }\n228: \n229: // The TypeScript inventory id is what the scorer actually emits, and it differs\n230: // from the human command name, so the bridge id is the map key. A command with\n231: // only the Python runtime enabled has no TypeScript id to emit and is reported\n232: // as unreachable instead.\n233: function readBridgeMap(path) {\n234:   const bridges = JSON.parse(readFileSync(path, 'utf8'));\n235:   const idToCommand = new Map();\n236:   for (const entry of bridges.entries ?? []) {\n237:     const typescript = entry.runtime?.typescript;\n238:     if (typescript?.enabled !== true || typeof typescript.id !== 'string') continue;\n239:     idToCommand.set(typescript.id, { command: entry.command, skillId: entry.skillId });\n240:   }\n241:   return { bridgeCounts: bridges.counts ?? {}, idToCommand };\n242: }\n243: \n244: function commandOf(idToCommand, id) {\n245:   return idToCommand.get(id)?.command ?? null;\n246: }\n247: \n248: // The route arrives from a separate process, so a spawn that fails, times out or\n249: // prints anything unparsable yields no route: a broken read must degrade to \"no\n250: // command offered\" rather than to an invented one.\n251: function readCompiledRoute(workspaceRoot, hubId, prompt) {\n252:   try {\n253:     const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n254:       cwd: workspaceRoot,\n255:       input: prompt,\n256:       encoding: 'utf8',\n257:       timeout: COMPILED_ROUTE_TIMEOUT_MS,\n258:       stdio: ['pipe', 'pipe', 'ignore'],\n259:     });\n260:     const route = JSON.parse(stdout);\n261:     return typeof route === 'object' && route !== null ? route : undefined;\n262:   } catch {\n263:     return undefined;\n264:   }\n265: }\n266: \n267: // A bridge that outranks nothing still stays reachable: when the two leaders are\n268: // a bridge and the skill that owns it, the reader gets the command without the\n269: // bridge displacing the skill the prompt actually asked for. The order is\n270: // irrelevant because the scorer's tie-break says nothing about ownership.\n271: function isBridgeOwnerPair(idToCommand, ids, expected) {\n272:   const [first, second] = ids;\n273:   if (first === undefined || second === undefined) return false;\n274:   const leading = idToCommand.get(first);\n275:   if (leading && leading.command === expected && leading.skillId === second) return true;\n276:   const trailing = idToCommand.get(second);\n277:   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n278: }\n279: \n280: // The scorer reports ranked recommendations when the projection produced a\n281: // list, and only a top pick otherwise; both shapes have to be scorable.\n282: function recommendationIds(result) {\n283:   if (Array.isArray(result?.recommendations)) {\n284:     return result.recommendations.slice(0, 3).map((recommendation) => recommendation.skill);\n285:   }\n286:   return result?.topSkill === null || result?.topSkill === undefined ? [] : [result.topSkill];\n287: }\n288: \n289: function emptyTally() {\n290:   return { rows: 0, top1: 0, top3: 0 };\n291: }\n292: \n293: function addRow(tally, top1Hit, top3Hit) {\n294:   tally.rows += 1;\n295:   if (top1Hit) tally.top1 += 1;\n296:   if (top3Hit) tally.top3 += 1;\n297: }\n298: \n299: // Attached reach is kept apart from bridge reach and only ever counts a row the\n300: // ranked bridge did not already land, so `own` and `attached` partition the rows\n301: // and their sum is real reach rather than one row claimed twice.\n302: function emptyAttachedTally() {\n303:   return { own: 0, attached: 0, total: 0 };\n304: }\n305: \n306: function addAttachedRow(tally, ownHit, attachedHit) {\n307:   tally.total += 1;\n308:   if (ownHit) tally.own += 1;\n309:   if (attachedHit) tally.attached += 1;\n310: }\n311: \n312: function attachedTallyJson(tally) {\n313:   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n314: }\n315: \n316: // Commands are named `<namespace>:<name>`, so the namespace is the workflow\n317: // family a reach number belongs to.\n318: function commandNamespace(command) {\n319:   if (typeof command !== 'string' || !command.startsWith('/')) return null;\n320:   const colon = command.indexOf(':');\n321:   return colon > 1 ? command.slice(1, colon) : null;\n322: }\n323: \n324: // Individual rows roll up to a family only when their command names one, so a\n325: // command outside the `<namespace>:<name>` grammar still counts in the split\n326: // total without inventing a family for itself.\n327: function attachedFamilyTally(byFamily, command) {\n328:   const namespace = commandNamespace(command);\n329:   if (namespace === null) return undefined;\n330:   if (!byFamily.has(namespace)) {\n331:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n332:   }\n333:   return byFamily.get(namespace);\n334: }\n335: \n336: function readHeadSha(workspaceRoot) {\n337:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n338:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n339: }\n340: \n341: // ───────────────────────────────────────────────────────────────────\n342: // 6. CORE LOGIC\n343: // ───────────────────────────────────────────────────────────────────\n344: \n345: export async function scoreCommandCorpus(options = {}) {\n346:   const realEmbedding = options.realEmbedding === true;\n347:   const RealDate = Date;\n348:   // The projection needs an existing, empty cache directory, and that directory\n349:   // is scratch space this run owns. It is created before the `try` so a failure\n350:   // to create it has nothing left to remove, and removed in the `finally` so\n351:   // repeated captures do not leave one behind per run. A real capture reads the\n352:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n353:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n354:   try {\n355:     // Environment projection. That empty directory makes the SQLite loader\n356:     // return null, so the projection is built from committed metadata alone,\n357:     // which is the only state a clean checkout can reproduce. A real capture reads\n358:     // the operator's own skill graph and embedder instead, so the three variables\n359:     // that select the projection are exactly the three it leaves unset.\n360:     if (!realEmbedding) {\n361:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n362:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n363:       // Match the test-harness regime: the semantic-shadow lane substitutes\n364:       // deterministic fixture vectors under the harness flag (real embeddings are\n365:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n366:       // must be captured under the same regime the ratchet re-scores it in.\n367:       process.env.VITEST = 'true';\n368:     }\n369:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n370:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n371:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n372:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n374:     // Private `local-*` skills linked in through this variable live outside the\n375:     // checkout, so a baseline measured on a clean checkout must not see them.\n376:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n377: \n378:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n379:     const capturedAt = readPinnedScoringDate();\n380:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n381:     globalThis.Date = class extends RealDate {\n382:       constructor(...args) {\n383:         if (args.length === 0) super(scoringInstant);\n384:         else super(...args);\n385:       }\n386: \n387:       static now() {\n388:         return scoringInstant;\n389:       }\n390:     };\n391: \n392:     if (!existsSync(FUSION_MODULE)) {\n393:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n394:     }\n395:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE]) {\n396:       if (!existsSync(modulePath)) {\n397:         throw new Error(`built command-attach file missing: ${modulePath}`);\n398:       }\n399:     }\n400: \n401:     // Imported after the clock is pinned so the compiled scorer initializes\n402:     // against the pinned date, and only after it is known to exist so a missing\n403:     // build is reported as such rather than as a module-resolution failure.\n404:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n405:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n406:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n407:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n408:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n409: \n410:     // A missing front door would make every spawn fail and report the same zero\n411:     // as a hub with nothing to attach, so it fails the capture instead.\n412:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n413:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n414:     }\n415: \n416:     // A build older than its source scores code that no longer exists, so its\n417:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n418:     // a build whose freshness cannot be assessed.\n419:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n420:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n421:     if (freshness.status !== 'fresh') {\n422:       throw new Error(freshness.message);\n423:     }\n424: \n425:     // Real scoring is the only mode that reads this machine, so it is the only one\n426:     // that has to prove the machine can answer before walking the corpus. Without\n427:     // the flag nothing here runs and the prompt embedding is the direct call below.\n428:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n429: \n430:     const commandNames = readCommandFileNames(workspaceRoot);\n431:     const commandSet = new Set(commandNames);\n432:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n433:     const corpus = readCorpus(CORPUS_JSONL);\n434: \n435:     // A label naming a command that does not exist would silently score as a\n436:     // permanent miss, so it fails the capture instead of deflating a metric.\n437:     for (const row of corpus) {\n438:       if (row.expected_command === null || row.expected_command === undefined) continue;\n439:       if (!commandSet.has(row.expected_command)) {\n440:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n441:       }\n442:     }\n443: \n444:     const perCommand = new Map();\n445:     for (const command of commandNames) {\n446:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n447:     }\n448: \n449:     const typed = emptyTally();\n450:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n451:     let falseOfferCount = 0;\n452:     let falseOfferTotal = 0;\n453:     let slashReachedTop3 = 0;\n454:     let slashNamedTotal = 0;\n455:     let slashOfferedOnPartial = 0;\n456:     let slashPartialTotal = 0;\n457:     let agreementCorrect = 0;\n458:     let agreementTotal = 0;\n459:     // Per-row results sit beside the totals because a total can hold still\n460:     // while one row is gained and another lost, and a changed label has to\n461:     // surface under the id of the row it belongs to.\n462:     const rows = {};\n463:     // Attached reach: what a hub's own route adds on the same rows, split the\n464:     // same way, plus the rows that had to stay silent and the ties a bridge\n465:     // leaves with its own owner.\n466:     const attachedRows = {};\n467:     // A typed command reaches the reader through the recommendation that leads,\n468:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n469:     // already landed and `attached` is one delivered by the reader's own typed\n470:     // command. Its resolution follows the recommend handler exactly.\n471:     const typedAttached = emptyAttachedTally();\n472:     const typedRowResults = {};\n473:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n474:     const plainAttachedByFamily = new Map();\n475:     const sameOwnerAmbiguous = [];\n476:     let falseOfferAttached = 0;\n477: \n478:     for (const row of corpus) {\n479:       // The recommend path supplies the semantic lane's prompt vector through this\n480:       // wrapper, so a real capture threads the same path rather than scoring with\n481:       // the lane blind. Under the fixture regime the lane derives its own\n482:       // deterministic vector and the direct call is the whole behavior.\n483:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n484:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n485:       const ids = recommendationIds(result);\n486:       const landed = ids.map((id) => commandOf(idToCommand, id));\n487:       const expected = row.expected_command ?? null;\n488:       const top1Hit = expected !== null && landed[0] === expected;\n489:       const top3Hit = expected !== null && landed.includes(expected);\n490:       // True when any of the top three recommendations maps to a command bridge,\n491:       // so this is a reach measure. It is not whether a brief head offered the\n492:       // command, which the behaviour run line records as `offeredCommand`.\n493:       const offered = landed.some((command) => command !== null);\n494:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n495: \n496:       // A hub can name the slash command its route would take, which is reach a\n497:       // reader otherwise gets only by translating the workflow mode by hand.\n498:       const topId = ids[0];\n499:       const attached = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n500:         ? attachCommand(topId, readCompiledRoute(workspaceRoot, topId, row.prompt), row.prompt)\n501:         : undefined;\n502:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n503:       // A typed command is the reader's own wording, so it outranks the hub's\n504:       // route in the delivered command, the same precedence the handler applies.\n505:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n506:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n507:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n508: \n509:       if (row.row_type === 'typed') {\n510:         addRow(typed, top1Hit, top3Hit);\n511:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n512:         typedRowResults[row.id] = {\n513:           expected_command: expected,\n514:           top: ids[0] ?? null,\n515:           carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n516:           command: delivered ?? null,\n517:           policy: deliveredPolicy,\n518:         };\n519:       }\n520:       if (isPlainSplit) {\n521:         addRow(plain[row.split], top1Hit, top3Hit);\n522:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n523:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n524:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n525:       }\n526:       if (attached !== undefined) attachedRows[row.id] = attached;\n527:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n528:         sameOwnerAmbiguous.push(row.id);\n529:       }\n530: \n531:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n532:       if (commandTally) {\n533:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n534:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n535:       }\n536: \n537:       rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n538: \n539:       const isSlashVariant = row.row_type === 'slash-variant';\n540:       // Silence is the requirement for a near miss, a prompt that must not\n541:       // trigger a command, and a partial slash mention that names no command.\n542:       const wantsSilence = row.row_type === 'must-not-start'\n543:         || row.row_type === 'near-miss'\n544:         || (isSlashVariant && expected === null);\n545:       if (wantsSilence) {\n546:         falseOfferTotal += 1;\n547:         if (offered) falseOfferCount += 1;\n548:         if (attached !== undefined) falseOfferAttached += 1;\n549:       }\n550: \n551:       if (isSlashVariant) {\n552:         if (expected === null) {\n553:           slashPartialTotal += 1;\n554:           if (offered) slashOfferedOnPartial += 1;\n555:         } else {\n556:           slashNamedTotal += 1;\n557:           if (top3Hit) slashReachedTop3 += 1;\n558:         }\n559:       }\n560: \n561:       // A bridge offered below a skill is correct when the skill that outranked\n562:       // it is the bridge's own owner: the command stays reachable without the\n563:       // bridge displacing the skill the prompt actually asked for.\n564:       if (!idToCommand.has(ids[0])) {\n565:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n566:         if (laterBridgeId !== undefined) {\n567:           agreementTotal += 1;\n568:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n569:         }\n570:       }\n571:     }\n572: \n573:     const commands = {};\n574:     for (const command of [...perCommand.keys()].sort()) {\n575:       commands[command] = perCommand.get(command);\n576:     }\n577: \n578:     // Row ids are keyed in sorted order so a diff between two captures reads as\n579:     // the rows that changed rather than as reordered output.\n580:     const typedRows = {};\n581:     for (const id of Object.keys(typedRowResults).sort()) {\n582:       typedRows[id] = typedRowResults[id];\n583:     }\n584: \n585:     const reachableCommands = new Set();\n586:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n587:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n588: \n589:     const plainByFamily = {};\n590:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n591:       const family = plainAttachedByFamily.get(namespace);\n592:       plainByFamily[namespace] = {\n593:         tune: attachedTallyJson(family.tune),\n594:         holdout: attachedTallyJson(family.holdout),\n595:       };\n596:     }\n597: \n598:     return {\n599:       schemaVersion: 1,\n600:       capturedAt,\n601:       capturedAtSha: readHeadSha(workspaceRoot),\n602:       corpusSha256: sha256File(CORPUS_JSONL),\n603:       bridgeCounts,\n604:       metrics: {\n605:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n606:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n607:         plain_recall_at_1: {\n608:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n609:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n610:         },\n611:         plain_reach_top3: {\n612:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n613:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n614:         },\n615:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n616:         slash_variant: {\n617:           reached_top3: slashReachedTop3,\n618:           named_total: slashNamedTotal,\n619:           offered_on_partial: slashOfferedOnPartial,\n620:           partial_total: slashPartialTotal,\n621:         },\n622:         agreement: { correct: agreementCorrect, total: agreementTotal },\n623:       },\n624:       unreachable,\n625:       commands,\n626:       rows,\n627:       attachedMetrics: {\n628:         plain: {\n629:           tune: attachedTallyJson(plainAttached.tune),\n630:           holdout: attachedTallyJson(plainAttached.holdout),\n631:         },\n632:         plain_by_family: plainByFamily,\n633:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n634:         typed: attachedTallyJson(typedAttached),\n635:         typedRows,\n636:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n637:         attachedRows,\n638:       },\n639:     };\n640:   } finally {\n641:     globalThis.Date = RealDate;\n642:     // Removal comes last, after every read that needs the directory has\n643:     // finished; `force` keeps an already-swept directory from turning a\n644:     // completed capture into a failure.\n645:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n646:   }\n647: }\n648: \n649: // ───────────────────────────────────────────────────────────────────\n650: // 7. CLI ENTRY\n651: // ───────────────────────────────────────────────────────────────────\n652: \n653: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n654:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n655: \n656:   const realEmbedding = process.argv.includes('--real-embedding');\n657:   // The committed baseline has to be reproducible on a clean checkout, so it may\n658:   // only come from the fixture regime. A real-embedding run measures this machine's\n659:   // embedder and graph, which is a live probe rather than a ratchet.\n660:   if (realEmbedding && process.argv.includes('--write')) {\n661:     process.stderr.write('capture-command-routing-baseline.mjs: --write cannot be combined with --real-embedding; the committed baseline is captured under the fixture regime only\\n');\n662:     process.exit(2);\n663:   }\n664: \n665:   try {\n666:     const baseline = await scoreCommandCorpus({ realEmbedding });\n667:     const serialized = `${JSON.stringify(baseline, null, 2)}\\n`;\n668:     if (process.argv.includes('--write')) {\n669:       writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n670:       console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n671:     }\n672:     console.log(serialized);\n673:   } catch (error) {\n674:     process.stderr.write(`capture-command-routing-baseline.mjs: ${error.message}\\n`);\n675:     process.exit(2);\n676:   }\n677: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-677\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n67: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n68: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n69: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n70: \n71: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n72: const COMMANDS_DIR = '.skilled/commands';\n73: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n74: // beside the commands is itself a command, so the skip is case-sensitive.\n75: const COMMAND_DOC_SKIP = 'README.md';\n76: const COMMAND_DOC_SUFFIX = '.md';\n77: // The compiled route is asked for through the public front door a hub's SKILL.md\n78: // calls, so this measures the decision the runtime actually serves rather than a\n79: // second derivation of it that could disagree with the first.\n80: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n81: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n82: \n83: // A real capture talks to the same embedder the recommend path does, so the probe\n84: // asks that daemon directly and names the model family the routing vectors come\n85: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n86: // table whose name carries the embedder dimension.\n87: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n88: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n89: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n90: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n91: \n92: // ───────────────────────────────────────────────────────────────────\n93: // 3. RUNTIME SETUP\n94: // ───────────────────────────────────────────────────────────────────\n95: //\n96: // Only the value lookups live here; the mutations themselves are deferred into\n97: // scoreCommandCorpus() so importing this module has no side effects.\n98: \n99: function isCalendarDate(value) {\n100:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n101:   const parsed = new Date(`${value}T00:00:00Z`);\n102:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n103: }\n104: \n105: // The derived lane halves each skill's score every 90 days of age, measured\n106: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n107: // scores move with the calendar. The scoring date is therefore inherited from\n108: // the scorer-eval baseline and pinned, never read from the wall clock: a\n109: // recapture on any day replays the recorded date and reproduces the same\n110: // numbers, which keeps the two baselines directly comparable.\n111: function readPinnedScoringDate() {\n112:   let recorded;\n113:   try {\n114:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n115:   } catch {\n116:     recorded = undefined;\n117:   }\n118:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n119:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n120:   }\n121:   return recorded;\n122: }\n123: \n124: // ───────────────────────────────────────────────────────────────────\n125: // 4. REAL EMBEDDING PREFLIGHT\n126: // ───────────────────────────────────────────────────────────────────\n127: //\n128: // A real capture scores whatever this machine's cosine lane can see, so both\n129: // halves of that lane are proved before a single row is scored: an embedder that\n130: // answers and a populated command vector table. Each half is named as itself when\n131: // it is missing, because a silent cosine lane reads exactly like a scoring change.\n132: \n133: async function assertEmbedderAnswers() {\n134:   const listed = [];\n135:   try {\n136:     const response = await fetch(EMBEDDER_TAGS_URL, { signal: AbortSignal.timeout(EMBEDDER_PROBE_TIMEOUT_MS) });\n137:     if (!response.ok) throw new Error(`HTTP ${response.status}`);\n138:     const payload = await response.json();\n139:     for (const model of Array.isArray(payload?.models) ? payload.models : []) {\n140:       if (typeof model?.name === 'string') listed.push(model.name);\n141:     }\n142:   } catch (error) {\n143:     const message = error instanceof Error ? error.message : String(error);\n144:     throw new Error(`real embedding needs a live embedder: GET ${EMBEDDER_TAGS_URL} failed (${message})`);\n145:   }\n146:   // The stored vectors were built with this model family, so a daemon serving some\n147:   // other model cannot answer them no matter how well the dimensions line up.\n148:   if (!listed.some((name) => name.startsWith(EMBEDDER_MODEL_PREFIX))) {\n149:     throw new Error(`real embedding needs an embedder serving ${EMBEDDER_MODEL_PREFIX}*: GET ${EMBEDDER_TAGS_URL} lists ${listed.length > 0 ? listed.join(', ') : 'no models'}`);\n150:   }\n151: }\n152: \n153: function assertCommandVectorsPresent(database, databasePath) {\n154:   if (!database) {\n155:     throw new Error(`real embedding needs command vectors: the skill graph database is absent (${databasePath})`);\n156:   }\n157:   // GLOB keeps the trailing underscore of the prefix literal, so the match is the\n158:   // `vec_cmd_<dim>` family alone rather than any name shaped like it.\n159:   const tables = database\n160:     .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name GLOB ?\")\n161:     .all(`${COMMAND_VECTOR_TABLE_PREFIX}*`)\n162:     .map((table) => table.name);\n163:   if (tables.length === 0) {\n164:     throw new Error(`real embedding needs command vectors: no ${COMMAND_VECTOR_TABLE_PREFIX}* table in ${databasePath}`);\n165:   }\n166:   const populated = tables.filter((name) => database.prepare(`SELECT COUNT(*) AS rowCount FROM \"${name}\"`).get().rowCount > 0);\n167:   if (populated.length === 0) {\n168:     throw new Error(`real embedding needs command vectors: ${tables.join(', ')} has no rows in ${databasePath}`);\n169:   }\n170: }\n171: \n172: // The wrapper, the embedder and the command vectors are resolved together because\n173: // a real capture needs all three or it measures nothing worth reporting.\n174: async function prepareRealEmbeddingScoring() {\n175:   if (!existsSync(SEMANTIC_SHADOW_MODULE)) {\n176:     throw new Error(`built semantic-shadow file missing: ${SEMANTIC_SHADOW_MODULE}`);\n177:   }\n178:   const { withSemanticShadowPromptEmbedding } = await import(pathToFileURL(SEMANTIC_SHADOW_MODULE).href);\n179:   const { getDbReadOnly, getSkillGraphDbPath } = await import(pathToFileURL(SKILL_GRAPH_DB_MODULE).href);\n180:   await assertEmbedderAnswers();\n181:   assertCommandVectorsPresent(getDbReadOnly(), getSkillGraphDbPath());\n182:   return withSemanticShadowPromptEmbedding;\n183: }\n184: \n185: // ───────────────────────────────────────────────────────────────────\n186: // 5. HELPERS\n187: // ───────────────────────────────────────────────────────────────────\n188: \n189: function sha256File(path) {\n190:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n191: }\n192: \n193: // Line numbers are reported as the physical line a bad row sits on, so a\n194: // parse failure points at the line to repair rather than at a row ordinal.\n195: function readCorpus(path) {\n196:   if (!existsSync(path)) throw new Error(`corpus file missing: ${path}`);\n197:   const lines = readFileSync(path, 'utf8').split('\\n');\n198:   const rows = [];\n199:   for (let index = 0; index < lines.length; index += 1) {\n200:     const line = lines[index].trim();\n201:     if (line === '') continue;\n202:     try {\n203:       rows.push(JSON.parse(line));\n204:     } catch (error) {\n205:       throw new Error(`invalid JSON on corpus line ${index + 1} of ${path}: ${error.message}`);\n206:     }\n207:   }\n208:   if (rows.length === 0) throw new Error(`corpus file empty: ${path}`);\n209:   return rows;\n210: }\n211: \n212: // Commands live exactly two levels deep, `<namespace>/<name>.md`, and become\n213: // `/<namespace>:<name>`. Anything directly in the commands root is a document\n214: // rather than a command, and deeper nesting is a command's own assets.\n215: function readCommandFileNames(workspaceRoot) {\n216:   const commandsRoot = resolve(workspaceRoot, COMMANDS_DIR);\n217:   const commands = [];\n218:   for (const namespace of readdirSync(commandsRoot, { withFileTypes: true })) {\n219:     if (!namespace.isDirectory()) continue;\n220:     for (const file of readdirSync(join(commandsRoot, namespace.name), { withFileTypes: true })) {\n221:       if (!file.isFile()) continue;\n222:       if (!file.name.endsWith(COMMAND_DOC_SUFFIX) || file.name === COMMAND_DOC_SKIP) continue;\n223:       commands.push(`/${namespace.name}:${file.name.slice(0, -COMMAND_DOC_SUFFIX.length)}`);\n224:     }\n225:   }\n226:   return commands.sort();\n227: }\n228: \n229: // The TypeScript inventory id is what the scorer actually emits, and it differs\n230: // from the human command name, so the bridge id is the map key. A command with\n231: // only the Python runtime enabled has no TypeScript id to emit and is reported\n232: // as unreachable instead.\n233: function readBridgeMap(path) {\n234:   const bridges = JSON.parse(readFileSync(path, 'utf8'));\n235:   const idToCommand = new Map();\n236:   for (const entry of bridges.entries ?? []) {\n237:     const typescript = entry.runtime?.typescript;\n238:     if (typescript?.enabled !== true || typeof typescript.id !== 'string') continue;\n239:     idToCommand.set(typescript.id, { command: entry.command, skillId: entry.skillId });\n240:   }\n241:   return { bridgeCounts: bridges.counts ?? {}, idToCommand };\n242: }\n243: \n244: function commandOf(idToCommand, id) {\n245:   return idToCommand.get(id)?.command ?? null;\n246: }\n247: \n248: // The route arrives from a separate process, so a spawn that fails, times out or\n249: // prints anything unparsable yields no route: a broken read must degrade to \"no\n250: // command offered\" rather than to an invented one.\n251: function readCompiledRoute(workspaceRoot, hubId, prompt) {\n252:   try {\n253:     const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n254:       cwd: workspaceRoot,\n255:       input: prompt,\n256:       encoding: 'utf8',\n257:       timeout: COMPILED_ROUTE_TIMEOUT_MS,\n258:       stdio: ['pipe', 'pipe', 'ignore'],\n259:     });\n260:     const route = JSON.parse(stdout);\n261:     return typeof route === 'object' && route !== null ? route : undefined;\n262:   } catch {\n263:     return undefined;\n264:   }\n265: }\n266: \n267: // A bridge that outranks nothing still stays reachable: when the two leaders are\n268: // a bridge and the skill that owns it, the reader gets the command without the\n269: // bridge displacing the skill the prompt actually asked for. The order is\n270: // irrelevant because the scorer's tie-break says nothing about ownership.\n271: function isBridgeOwnerPair(idToCommand, ids, expected) {\n272:   const [first, second] = ids;\n273:   if (first === undefined || second === undefined) return false;\n274:   const leading = idToCommand.get(first);\n275:   if (leading && leading.command === expected && leading.skillId === second) return true;\n276:   const trailing = idToCommand.get(second);\n277:   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n278: }\n279: \n280: // The scorer reports ranked recommendations when the projection produced a\n281: // list, and only a top pick otherwise; both shapes have to be scorable.\n282: function recommendationIds(result) {\n283:   if (Array.isArray(result?.recommendations)) {\n284:     return result.recommendations.slice(0, 3).map((recommendation) => recommendation.skill);\n285:   }\n286:   return result?.topSkill === null || result?.topSkill === undefined ? [] : [result.topSkill];\n287: }\n288: \n289: function emptyTally() {\n290:   return { rows: 0, top1: 0, top3: 0 };\n291: }\n292: \n293: function addRow(tally, top1Hit, top3Hit) {\n294:   tally.rows += 1;\n295:   if (top1Hit) tally.top1 += 1;\n296:   if (top3Hit) tally.top3 += 1;\n297: }\n298: \n299: // Attached reach is kept apart from bridge reach and only ever counts a row the\n300: // ranked bridge did not already land, so `own` and `attached` partition the rows\n301: // and their sum is real reach rather than one row claimed twice.\n302: function emptyAttachedTally() {\n303:   return { own: 0, attached: 0, total: 0 };\n304: }\n305: \n306: function addAttachedRow(tally, ownHit, attachedHit) {\n307:   tally.total += 1;\n308:   if (ownHit) tally.own += 1;\n309:   if (attachedHit) tally.attached += 1;\n310: }\n311: \n312: function attachedTallyJson(tally) {\n313:   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n314: }\n315: \n316: // Commands are named `<namespace>:<name>`, so the namespace is the workflow\n317: // family a reach number belongs to.\n318: function commandNamespace(command) {\n319:   if (typeof command !== 'string' || !command.startsWith('/')) return null;\n320:   const colon = command.indexOf(':');\n321:   return colon > 1 ? command.slice(1, colon) : null;\n322: }\n323: \n324: // Individual rows roll up to a family only when their command names one, so a\n325: // command outside the `<namespace>:<name>` grammar still counts in the split\n326: // total without inventing a family for itself.\n327: function attachedFamilyTally(byFamily, command) {\n328:   const namespace = commandNamespace(command);\n329:   if (namespace === null) return undefined;\n330:   if (!byFamily.has(namespace)) {\n331:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n332:   }\n333:   return byFamily.get(namespace);\n334: }\n335: \n336: function readHeadSha(workspaceRoot) {\n337:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n338:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n339: }\n340: \n341: // ───────────────────────────────────────────────────────────────────\n342: // 6. CORE LOGIC\n343: // ───────────────────────────────────────────────────────────────────\n344: \n345: export async function scoreCommandCorpus(options = {}) {\n346:   const realEmbedding = options.realEmbedding === true;\n347:   const RealDate = Date;\n348:   // The projection needs an existing, empty cache directory, and that directory\n349:   // is scratch space this run owns. It is created before the `try` so a failure\n350:   // to create it has nothing left to remove, and removed in the `finally` so\n351:   // repeated captures do not leave one behind per run. A real capture reads the\n352:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n353:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n354:   try {\n355:     // Environment projection. That empty directory makes the SQLite loader\n356:     // return null, so the projection is built from committed metadata alone,\n357:     // which is the only state a clean checkout can reproduce. A real capture reads\n358:     // the operator's own skill graph and embedder instead, so the three variables\n359:     // that select the projection are exactly the three it leaves unset.\n360:     if (!realEmbedding) {\n361:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n362:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n363:       // Match the test-harness regime: the semantic-shadow lane substitutes\n364:       // deterministic fixture vectors under the harness flag (real embeddings are\n365:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n366:       // must be captured under the same regime the ratchet re-scores it in.\n367:       process.env.VITEST = 'true';\n368:     }\n369:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n370:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n371:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n372:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n374:     // Private `local-*` skills linked in through this variable live outside the\n375:     // checkout, so a baseline measured on a clean checkout must not see them.\n376:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n377: \n378:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n379:     const capturedAt = readPinnedScoringDate();\n380:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n381:     globalThis.Date = class extends RealDate {\n382:       constructor(...args) {\n383:         if (args.length === 0) super(scoringInstant);\n384:         else super(...args);\n385:       }\n386: \n387:       static now() {\n388:         return scoringInstant;\n389:       }\n390:     };\n391: \n392:     if (!existsSync(FUSION_MODULE)) {\n393:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n394:     }\n395:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE]) {\n396:       if (!existsSync(modulePath)) {\n397:         throw new Error(`built command-attach file missing: ${modulePath}`);\n398:       }\n399:     }\n400: \n401:     // Imported after the clock is pinned so the compiled scorer initializes\n402:     // against the pinned date, and only after it is known to exist so a missing\n403:     // build is reported as such rather than as a module-resolution failure.\n404:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n405:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n406:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n407:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n408:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n409: \n410:     // A missing front door would make every spawn fail and report the same zero\n411:     // as a hub with nothing to attach, so it fails the capture instead.\n412:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n413:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n414:     }\n415: \n416:     // A build older than its source scores code that no longer exists, so its\n417:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n418:     // a build whose freshness cannot be assessed.\n419:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n420:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n421:     if (freshness.status !== 'fresh') {\n422:       throw new Error(freshness.message);\n423:     }\n424: \n425:     // Real scoring is the only mode that reads this machine, so it is the only one\n426:     // that has to prove the machine can answer before walking the corpus. Without\n427:     // the flag nothing here runs and the prompt embedding is the direct call below.\n428:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n429: \n430:     const commandNames = readCommandFileNames(workspaceRoot);\n431:     const commandSet = new Set(commandNames);\n432:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n433:     const corpus = readCorpus(CORPUS_JSONL);\n434: \n435:     // A label naming a command that does not exist would silently score as a\n436:     // permanent miss, so it fails the capture instead of deflating a metric.\n437:     for (const row of corpus) {\n438:       if (row.expected_command === null || row.expected_command === undefined) continue;\n439:       if (!commandSet.has(row.expected_command)) {\n440:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n441:       }\n442:     }\n443: \n444:     const perCommand = new Map();\n445:     for (const command of commandNames) {\n446:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n447:     }\n448: \n449:     const typed = emptyTally();\n450:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n451:     let falseOfferCount = 0;\n452:     let falseOfferTotal = 0;\n453:     let slashReachedTop3 = 0;\n454:     let slashNamedTotal = 0;\n455:     let slashOfferedOnPartial = 0;\n456:     let slashPartialTotal = 0;\n457:     let agreementCorrect = 0;\n458:     let agreementTotal = 0;\n459:     // Per-row results sit beside the totals because a total can hold still\n460:     // while one row is gained and another lost, and a changed label has to\n461:     // surface under the id of the row it belongs to.\n462:     const rows = {};\n463:     // Attached reach: what a hub's own route adds on the same rows, split the\n464:     // same way, plus the rows that had to stay silent and the ties a bridge\n465:     // leaves with its own owner.\n466:     const attachedRows = {};\n467:     // A typed command reaches the reader through the recommendation that leads,\n468:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n469:     // already landed and `attached` is one delivered by the reader's own typed\n470:     // command. Its resolution follows the recommend handler exactly.\n471:     const typedAttached = emptyAttachedTally();\n472:     const typedRowResults = {};\n473:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n474:     const plainAttachedByFamily = new Map();\n475:     const sameOwnerAmbiguous = [];\n476:     let falseOfferAttached = 0;\n477: \n478:     for (const row of corpus) {\n479:       // The recommend path supplies the semantic lane's prompt vector through this\n480:       // wrapper, so a real capture threads the same path rather than scoring with\n481:       // the lane blind. Under the fixture regime the lane derives its own\n482:       // deterministic vector and the direct call is the whole behavior.\n483:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n484:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n485:       const ids = recommendationIds(result);\n486:       const landed = ids.map((id) => commandOf(idToCommand, id));\n487:       const expected = row.expected_command ?? null;\n488:       const top1Hit = expected !== null && landed[0] === expected;\n489:       const top3Hit = expected !== null && landed.includes(expected);\n490:       // True when any of the top three recommendations maps to a command bridge,\n491:       // so this is a reach measure. It is not whether a brief head offered the\n492:       // command, which the behaviour run line records as `offeredCommand`.\n493:       const offered = landed.some((command) => command !== null);\n494:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n495: \n496:       // A hub can name the slash command its route would take, which is reach a\n497:       // reader otherwise gets only by translating the workflow mode by hand.\n498:       const topId = ids[0];\n499:       const attached = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n500:         ? attachCommand(topId, readCompiledRoute(workspaceRoot, topId, row.prompt), row.prompt)\n501:         : undefined;\n502:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n503:       // A typed command is the reader's own wording, so it outranks the hub's\n504:       // route in the delivered command, the same precedence the handler applies.\n505:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n506:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n507:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n508: \n509:       if (row.row_type === 'typed') {\n510:         addRow(typed, top1Hit, top3Hit);\n511:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n512:         typedRowResults[row.id] = {\n513:           expected_command: expected,\n514:           top: ids[0] ?? null,\n515:           carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n516:           command: delivered ?? null,\n517:           policy: deliveredPolicy,\n518:         };\n519:       }\n520:       if (isPlainSplit) {\n521:         addRow(plain[row.split], top1Hit, top3Hit);\n522:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n523:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n524:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n525:       }\n526:       if (attached !== undefined) attachedRows[row.id] = attached;\n527:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n528:         sameOwnerAmbiguous.push(row.id);\n529:       }\n530: \n531:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n532:       if (commandTally) {\n533:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n534:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n535:       }\n536: \n537:       rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n538: \n539:       const isSlashVariant = row.row_type === 'slash-variant';\n540:       // Silence is the requirement for a near miss, a prompt that must not\n541:       // trigger a command, and a partial slash mention that names no command.\n542:       const wantsSilence = row.row_type === 'must-not-start'\n543:         || row.row_type === 'near-miss'\n544:         || (isSlashVariant && expected === null);\n545:       if (wantsSilence) {\n546:         falseOfferTotal += 1;\n547:         if (offered) falseOfferCount += 1;\n548:         if (attached !== undefined) falseOfferAttached += 1;\n549:       }\n550: \n551:       if (isSlashVariant) {\n552:         if (expected === null) {\n553:           slashPartialTotal += 1;\n554:           if (offered) slashOfferedOnPartial += 1;\n555:         } else {\n556:           slashNamedTotal += 1;\n557:           if (top3Hit) slashReachedTop3 += 1;\n558:         }\n559:       }\n560: \n561:       // A bridge offered below a skill is correct when the skill that outranked\n562:       // it is the bridge's own owner: the command stays reachable without the\n563:       // bridge displacing the skill the prompt actually asked for.\n564:       if (!idToCommand.has(ids[0])) {\n565:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n566:         if (laterBridgeId !== undefined) {\n567:           agreementTotal += 1;\n568:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n569:         }\n570:       }\n571:     }\n572: \n573:     const commands = {};\n574:     for (const command of [...perCommand.keys()].sort()) {\n575:       commands[command] = perCommand.get(command);\n576:     }\n577: \n578:     // Row ids are keyed in sorted order so a diff between two captures reads as\n579:     // the rows that changed rather than as reordered output.\n580:     const typedRows = {};\n581:     for (const id of Object.keys(typedRowResults).sort()) {\n582:       typedRows[id] = typedRowResults[id];\n583:     }\n584: \n585:     const reachableCommands = new Set();\n586:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n587:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n588: \n589:     const plainByFamily = {};\n590:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n591:       const family = plainAttachedByFamily.get(namespace);\n592:       plainByFamily[namespace] = {\n593:         tune: attachedTallyJson(family.tune),\n594:         holdout: attachedTallyJson(family.holdout),\n595:       };\n596:     }\n597: \n598:     return {\n599:       schemaVersion: 1,\n600:       capturedAt,\n601:       capturedAtSha: readHeadSha(workspaceRoot),\n602:       corpusSha256: sha256File(CORPUS_JSONL),\n603:       bridgeCounts,\n604:       metrics: {\n605:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n606:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n607:         plain_recall_at_1: {\n608:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n609:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n610:         },\n611:         plain_reach_top3: {\n612:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n613:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n614:         },\n615:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n616:         slash_variant: {\n617:           reached_top3: slashReachedTop3,\n618:           named_total: slashNamedTotal,\n619:           offered_on_partial: slashOfferedOnPartial,\n620:           partial_total: slashPartialTotal,\n621:         },\n622:         agreement: { correct: agreementCorrect, total: agreementTotal },\n623:       },\n624:       unreachable,\n625:       commands,\n626:       rows,\n627:       attachedMetrics: {\n628:         plain: {\n629:           tune: attachedTallyJson(plainAttached.tune),\n630:           holdout: attachedTallyJson(plainAttached.holdout),\n631:         },\n632:         plain_by_family: plainByFamily,\n633:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n634:         typed: attachedTallyJson(typedAttached),\n635:         typedRows,\n636:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n637:         attachedRows,\n638:       },\n639:     };\n640:   } finally {\n641:     globalThis.Date = RealDate;\n642:     // Removal comes last, after every read that needs the directory has\n643:     // finished; `force` keeps an already-swept directory from turning a\n644:     // completed capture into a failure.\n645:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n646:   }\n647: }\n648: \n649: // ───────────────────────────────────────────────────────────────────\n650: // 7. CLI ENTRY\n651: // ───────────────────────────────────────────────────────────────────\n652: \n653: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n654:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n655: \n656:   const realEmbedding = process.argv.includes('--real-embedding');\n657:   // The committed baseline has to be reproducible on a clean checkout, so it may\n658:   // only come from the fixture regime. A real-embedding run measures this machine's\n659:   // embedder and graph, which is a live probe rather than a ratchet.\n660:   if (realEmbedding && process.argv.includes('--write')) {\n661:     process.stderr.write('capture-command-routing-baseline.mjs: --write cannot be combined with --real-embedding; the committed baseline is captured under the fixture regime only\\n');\n662:     process.exit(2);\n663:   }\n664: \n665:   try {\n666:     const baseline = await scoreCommandCorpus({ realEmbedding });\n667:     const serialized = `${JSON.stringify(baseline, null, 2)}\\n`;\n668:     if (process.argv.includes('--write')) {\n669:       writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n670:       console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n671:     }\n672:     console.log(serialized);\n673:   } catch (error) {\n674:     process.stderr.write(`capture-command-routing-baseline.mjs: ${error.message}\\n`);\n675:     process.exit(2);\n676:   }\n677: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\"}"},"time":{"start":1794560377288,"end":1794560377757}}}}
