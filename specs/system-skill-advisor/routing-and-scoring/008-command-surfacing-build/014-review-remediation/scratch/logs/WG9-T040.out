      0\ntyped intersect:\n       0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy && jq -r '.attachedMetrics.attachedRows | keys[]' command-routing-baseline.json | sort > /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/attached-keys.txt && jq -r '.attachedMetrics.typedRows | keys[]' command-routing-baseline.json | sort > /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/typed-keys.txt && jq -r '.rows | keys[]' command-routing-baseline.json | sort > /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/row-keys.txt && sort /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/holdout-ids.txt > /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/holdout-sorted.txt && echo \\\"rows intersect:\\\" && comm -12 /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/holdout-sorted.txt /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/row-keys.txt | wc -l && echo \\\"attached intersect:\\\" && comm -12 /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/holdout-sorted.txt /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/attached-keys.txt | wc -l && echo \\\"typed intersect:\\\" && comm -12 /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/holdout-sorted.txt /private/var/folders/3c/zfqcqsts0kn19cgblj82gqhm0000gn/T/opencode/typed-keys.txt | wc -l\"}"},"time":{"start":1794560407894,"end":1794560411337}}}}
