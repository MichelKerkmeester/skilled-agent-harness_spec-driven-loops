{"type":"tool_use","timestamp":1794558641368,"sessionID":"ses_e2bf94d53ffebzXtwlVhQAwWQy","part":{"partID":"prt_1d407c49400188rpDh0MR6IbLO","sessionID":"ses_e2bf94d53ffebzXtwlVhQAwWQy","messageID":"msg_1d407ab5f001Xvi07Y6Thfe7wO","type":"tool","id":"call_01_hcfcquoro4s29fc4jqg0zkfl","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-655\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: // The composer writes the Gate 1 mirror only, so a case that reads a whole runtime-copy row\n48: // finishes the mirrors with the generator that owns them, as a repository that ran its own\n49: // generators would.\n50: const POINTER_SYNC = path.join(\n51:   REPO_ROOT,\n52:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n53: );\n54: \n55: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n56: \n57: // The rows every report carries, in the order the engine prints them.\n58: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n59: \n60: // ─────────────────────────────────────────────────────────────────────────────\n61: // 2. FIXTURE TREES\n62: // ─────────────────────────────────────────────────────────────────────────────\n63: \n64: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n65: // can read a stale copy of a document, and the tree a case runs against is always the\n66: // template that ships in this repository.\n67: function buildFixture(t, name) {\n68:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n69:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n70:   const dir = path.join(parent, name);\n71:   composeFixture(name, dir);\n72:   const documentPath = path.join(dir, manifest.root_file);\n73:   return {\n74:     dir,\n75:     recipe: loadRecipe(name),\n76:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n77:   };\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 3. RUNNERS AND READERS\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function runCheck(args) {\n85:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n86:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n87: }\n88: \n89: function runJson(args) {\n90:   const run = runCheck([...args, '--json']);\n91:   let report = null;\n92:   try {\n93:     report = JSON.parse(run.out);\n94:   } catch {\n95:     report = null;\n96:   }\n97:   return { ...run, report };\n98: }\n99: \n100: function rowOf(report, id) {\n101:   const row = report.rows.find((entry) => entry.id === id);\n102:   assert.ok(row, `the report carries row ${id}`);\n103:   return row;\n104: }\n105: \n106: // The text form prints one line per row, ending in the row's verdict, so the two\n107: // renderers can be compared without re-implementing either.\n108: function textRowStates(out) {\n109:   const states = {};\n110:   for (const line of out.split('\\n')) {\n111:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n112:     if (hit) states[hit[1]] = hit[2];\n113:   }\n114:   return states;\n115: }\n116: \n117: function listFiles(dir) {\n118:   const files = [];\n119:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n120:     const target = path.join(dir, entry.name);\n121:     if (entry.isDirectory()) files.push(...listFiles(target));\n122:     else files.push(target);\n123:   }\n124:   return files;\n125: }\n126: \n127: // A fixture's document is rewritten by a case that needs a shape no recipe describes,\n128: // so the tree a case reads is always the template the manifest ships today.\n129: function rewriteDocument(fixture, text) {\n130:   fs.writeFileSync(path.join(fixture.dir, manifest.root_file), text, 'utf8');\n131: }\n132: \n133: // A throwaway manifest: pin kinds and root file names are the two places a case needs a\n134: // declaration the shipped manifest does not carry.\n135: function writeManifest(t, patch) {\n136:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-manifest-'));\n137:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n138:   const target = path.join(dir, 'agents-md-manifest.json');\n139:   fs.writeFileSync(target, `${JSON.stringify({ ...manifest, ...patch }, null, 2)}\\n`, 'utf8');\n140:   return target;\n141: }\n142: \n143: function treeDigest(dir) {\n144:   const hash = crypto.createHash('sha256');\n145:   for (const file of listFiles(dir).sort()) {\n146:     hash.update(path.relative(dir, file));\n147:     hash.update(fs.readFileSync(file));\n148:   }\n149:   return hash.digest('hex');\n150: }\n151: \n152: // ─────────────────────────────────────────────────────────────────────────────\n153: // 4. THE FIXTURES ARE RECIPES, NOT COPIES\n154: // ─────────────────────────────────────────────────────────────────────────────\n155: \n156: // A composed tree committed beside its recipe would be a second copy of the template,\n157: // and the copy is what the repository would then have to keep: relative links would\n158: // resolve against the fixture folder, a runtime loading nested instruction files would\n159: // read it as somebody's own document, and each template edit would need a regeneration\n160: // commit. This case holds the rule the fixtures are arranged by.\n161: test('every fixture folder holds its recipe and no composed tree', () => {\n162:   const stray = [];\n163:   for (const name of fixtureNames()) {\n164:     for (const entry of fs.readdirSync(path.join(FIXTURES, name), { withFileTypes: true })) {\n165:       if (entry.name !== 'fixture.json' || entry.isDirectory()) stray.push(`${name}/${entry.name}`);\n166:     }\n167:   }\n168:   assert.deepEqual(stray, [],\n169:     'compose a fixture into a temporary folder with the suite\\'s composer instead of committing the tree it describes');\n170: });\n171: \n172: test('composer: the pure fixture rebuilds the shipped document from the manifest', (t) => {\n173:   const fixture = buildFixture(t, 'pure');\n174:   const { sections } = segment(fixture.document, manifest.markers, manifest.sections);\n175: \n176:   assert.equal(sections.length, manifest.sections.length, 'the composed document carries every shipped section');\n177:   for (const section of sections) {\n178:     assert.ok(section.id, `the composed heading ${JSON.stringify(section.heading)} matches a manifest entry`);\n179:     assert.equal(section.sha256, manifest.derived.sections[section.id].sha256,\n180:       `section ${section.id} is byte-identical to the manifest's derived body`);\n181:   }\n182:   const rootDocument = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n183:   assert.ok(rootDocument.startsWith(fixture.document),\n184:     'the composed document is the root document up to its repository block');\n185: });\n186: \n187: test('composer: each fixture declares the install state it plants', () => {\n188:   const names = fixtureNames();\n189:   assert.equal(names.length, 9, 'there are nine fixture recipes');\n190:   for (const name of names) {\n191:     const recipe = loadRecipe(name);\n192:     assert.equal(recipe.name, name, `${name} names itself`);\n193:     assert.ok(recipe.expect_state, `${name} declares its expected install state`);\n194:     assert.ok(recipe.notes, `${name} says what defect it plants`);\n195:   }\n196: });\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 5. A1 INSTALL STATE, ONE FIXTURE PER STATE\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n203:   test(`A1 install state: the ${name} fixture classifies as ${loadRecipe(name).expect_state}`, (t) => {\n204:     const fixture = buildFixture(t, name);\n205:     const run = runJson(['--root', fixture.dir]);\n206: \n207:     assert.ok(run.report, `the engine prints a JSON report for ${name}; stderr: ${run.err}`);\n208:     assert.equal(run.report.state, fixture.recipe.expect_state);\n209:     assert.match(run.out, new RegExp(`\"state\": \"${fixture.recipe.expect_state}\"`));\n210:   });\n211: }\n212: \n213: test('A1 install state: this repository is the source template and classifies as pure', () => {\n214:   const report = buildReport({ root: REPO_ROOT });\n215:   assert.equal(report.state, 'pure', 'the shipped template carries every section current and an empty block');\n216: });\n217: \n218: // ─────────────────────────────────────────────────────────────────────────────\n219: // 6. UNMARKED CONTENT AND UNMARKED EDITS\n220: // ─────────────────────────────────────────────────────────────────────────────\n221: \n222: test('forked: A8 lists the unmarked section with its byte range and A9 lists the local line', (t) => {\n223:   const fixture = buildFixture(t, 'forked');\n224:   const run = runJson(['--root', fixture.dir]);\n225: \n226:   assert.equal(run.code, 1, 'a forked repository is a finding, not a pass');\n227:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n228: \n229:   const unmarked = rowOf(run.report, 'A8');\n230:   assert.equal(unmarked.state, 'FINDING');\n231:   const section = unmarked.entries.find((entry) => entry.heading.includes('Local release checklist'));\n232:   assert.ok(section, \"A8 lists the repository's own section by heading\");\n233:   assert.ok(section.byte_start > 0 && section.byte_end > section.byte_start, 'A8 gives the section a byte range');\n234:   assert.equal(section.line_start, fixture.document.split('\\n').indexOf('## Local release checklist') + 1,\n235:     'A8 gives the section a line range that a reader can open');\n236:   assert.equal(section.in_prefix, false, 'the section sits outside the delivery prefix');\n237: \n238:   const edits = rowOf(run.report, 'A9');\n239:   assert.equal(edits.state, 'FINDING');\n240:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n241:   assert.ok(edited, 'A9 names the edited section');\n242:   assert.equal(edited.state, 'edited');\n243:   assert.deepEqual(edited.lines, ['Local rule: name the packet in the first line of every pull request.']);\n244: });\n245: \n246: // The same sentence written twice is two lines a replacement would lose, so the row\n247: // counts occurrences: a set would report one line and hide the other.\n248: test('A9 counts a repeated local line once per occurrence', (t) => {\n249:   const fixture = buildFixture(t, 'forked');\n250:   const line = 'Local rule: name the packet in the first line of every pull request.';\n251:   rewriteDocument(fixture, fixture.document.replace(line, `${line}\\n${line}`));\n252: \n253:   const run = runJson(['--root', fixture.dir]);\n254:   const edits = rowOf(run.report, 'A9');\n255:   assert.equal(edits.state, 'FINDING');\n256:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n257:   assert.deepEqual(edited.lines, [line, line], 'the repeated line is listed twice');\n258:   assert.match(edits.detail, /1 section\\(s\\) carry 2 local line\\(s\\)/);\n259: });\n260: \n261: // A repository that wrote its block between two shipped sections still carries every\n262: // shipped section, and the block is in the one place the template does not put it. Read\n263: // only above the block, the document looks like somebody else's file and the position is\n264: // never named.\n265: test('a block placed between shipped sections is reported by A7 with its position', (t) => {\n266:   const fixture = buildFixture(t, 'adopted');\n267:   const moved = moveBlockBefore(fixture.document, '#### The Four Laws');\n268:   rewriteDocument(fixture, moved);\n269: \n270:   const run = runJson(['--root', fixture.dir]);\n271:   assert.equal(rowOf(run.report, 'A1').detail, 'adopted', 'every shipped section is still current');\n272:   assert.equal(rowOf(run.report, 'A2').detail, '44/44 matched', 'the sections below the block are shipped ones');\n273:   assert.equal(rowOf(run.report, 'A8').state, 'PASS', 'nothing below the block is unmarked content');\n274: \n275:   const block = rowOf(run.report, 'A7');\n276:   assert.equal(block.state, 'FINDING');\n277:   const position = block.lines.join(' ');\n278:   // Offsets in the report are bytes, and the template carries multi-byte headings above\n279:   // the block, so the character index is not the figure to compare against.\n280:   const blockByte = Buffer.byteLength(moved.slice(0, moved.indexOf(manifest.markers.start)), 'utf8');\n281:   assert.ok(position.includes(`byte ${blockByte}`), `A7 names where the block sits: ${position}`);\n282:   assert.match(position, /The Four Laws/, 'A7 names the shipped section the block sits in front of');\n283: });\n284: \n285: // The end marker is not the end of the file: a line typed below it is the repository's\n286: // own, and a rewrite that keeps only the block would drop it without a word.\n287: test('a line after the block end marker is reported as a local edit', (t) => {\n288:   const fixture = buildFixture(t, 'adopted');\n289:   const line = 'Ship the release note in the same commit as the tag.';\n290:   rewriteDocument(fixture, `${fixture.document}${line}\\n`);\n291: \n292:   const run = runJson(['--root', fixture.dir]);\n293:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n294: \n295:   const edits = rowOf(run.report, 'A9');\n296:   assert.equal(edits.state, 'FINDING');\n297:   const carrier = edits.entries.find((entry) => entry.lines.includes(line));\n298:   assert.ok(carrier, `A9 lists the line below the end marker: ${JSON.stringify(edits.entries)}`);\n299: });\n300: \n301: // Text above the first heading belongs to no section, so it is the one piece of\n302: // repository content a heading-shaped comparison cannot see. Left unreported, a document\n303: // carrying it reads as a pure template and a rewrite drops it.\n304: test('text before the first shipped heading is reported as unmarked repository content', (t) => {\n305:   const fixture = buildFixture(t, 'pure');\n306:   const line = 'Read me first.';\n307:   rewriteDocument(fixture, `${line}\\n${fixture.document}`);\n308: \n309:   const run = runJson(['--root', fixture.dir]);\n310:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n311: \n312:   const unmarked = rowOf(run.report, 'A8');\n313:   assert.equal(unmarked.state, 'FINDING');\n314:   const prelude = unmarked.entries.find((entry) => entry.heading === null);\n315:   assert.ok(prelude, `A8 names the text above the first heading: ${JSON.stringify(unmarked.entries)}`);\n316:   assert.equal(prelude.byte_start, 0, 'the region starts at the first byte');\n317:   assert.equal(prelude.line_start, 1);\n318:   assert.match(unmarked.lines.join(' '), /before the first heading/);\n319: });\n320: \n321: // A body can carry every line the shipped body carries and still not be it: one extra\n322: // space on an indented bullet is a real difference and a rewrite replaces it. A finding\n323: // with nothing under it names no line to look at, so the row says what the difference is\n324: // and where the two bodies part company.\n325: test('A9 names a body that differs only in whitespace, by line', (t) => {\n326:   const fixture = buildFixture(t, 'pure');\n327:   const shipped = manifest.derived.sections['gate-3'].body;\n328:   const lines = shipped.split('\\n');\n329:   const indented = lines.findIndex((row) => row.startsWith('  '));\n330:   assert.notEqual(indented, -1, 'the shipped body carries an indented line');\n331:   lines[indented] = ` ${lines[indented]}`;\n332:   assert.notEqual(lines[indented], shipped.split('\\n')[indented]);\n333:   rewriteDocument(fixture, fixture.document.replace(shipped, lines.join('\\n')));\n334: \n335:   const run = runJson(['--root', fixture.dir]);\n336:   assert.equal(rowOf(run.report, 'A4').entries.find((entry) => entry.id === 'gate-3').state, 'edited', 'the body is not the shipped one');\n337: \n338:   const edits = rowOf(run.report, 'A9');\n339:   assert.equal(edits.state, 'FINDING', 'the section is not the shipped one, so the row reports it');\n340:   assert.ok(edits.lines.length > 0, 'a finding names at least one line to act on');\n341:   assert.match(edits.lines[0], /gate-3/u, 'the line names the section');\n342:   assert.match(edits.lines[0], new RegExp(`line ${indented + 1}\\\\b`, 'u'), 'and the line of the body where the two differ');\n343:   assert.match(edits.lines[0], /whitespace/u, 'and says the difference is whitespace');\n344: \n345:   const text = runCheck(['--root', fixture.dir]);\n346:   assert.match(text.out, /A9 unmarked local edits: .*\\(FINDING\\)/u);\n347:   assert.match(text.out, /gate-3: only whitespace/u, 'the text form prints the same line');\n348: });\n349: \n350: // A marker is the whole line, so a sentence that quotes both markers is prose. Counting\n351: // the bytes instead would report a document with no block as carrying two of them, which\n352: // is a finding about a file nobody can fix.\n353: test('A7 counts marker lines, not the marker text quoted inside a sentence', (t) => {\n354:   const fixture = buildFixture(t, 'pure');\n355:   const sentence = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n356:   rewriteDocument(fixture, `${fixture.document}${sentence}\\n`);\n357: \n358:   const run = runJson(['--root', fixture.dir]);\n359:   const block = rowOf(run.report, 'A7');\n360:   assert.equal(block.state, 'PASS', `a sentence quoting both markers is prose, not a block: ${block.lines.join(' | ')}`);\n361:   assert.match(block.detail, /no block/u, 'the document carries no block, because neither marker is a line of its own');\n362: });\n363: \n364: // ─────────────────────────────────────────────────────────────────────────────\n365: // 7. PINS, BUDGET AND BLOCK SHAPE\n366: // ─────────────────────────────────────────────────────────────────────────────\n367: \n368: test('shadowed-pin: A5 fails because the local lookup line comes before Gate 1', (t) => {\n369:   const fixture = buildFixture(t, 'shadowed-pin');\n370:   const run = runJson(['--root', fixture.dir]);\n371: \n372:   const pins = rowOf(run.report, 'A5');\n373:   assert.equal(pins.state, 'FINDING');\n374:   const pin = pins.entries.find((entry) => entry.id === 'gate1-lookup');\n375:   assert.ok(pin, 'A5 names the pin the local line shadows');\n376:   assert.equal(pin.state, 'FINDING');\n377:   assert.match(pin.detail, /first occurrence/i);\n378: });\n379: \n380: test('over-budget: A6 and A7 both fail', (t) => {\n381:   const fixture = buildFixture(t, 'over-budget');\n382:   const total = Buffer.byteLength(fixture.document, 'utf8');\n383:   assert.ok(total > manifest.budget.max_bytes, `the fixture is ${total} bytes, past the ${manifest.budget.max_bytes}-byte ceiling`);\n384: \n385:   const run = runJson(['--root', fixture.dir]);\n386:   assert.equal(rowOf(run.report, 'A6').state, 'FINDING');\n387:   const block = rowOf(run.report, 'A7');\n388:   assert.equal(block.state, 'FINDING');\n389:   assert.match(block.lines.join(' '), /end marker sits before the start marker/i);\n390:   assert.match(block.lines.join(' '), /exceeds the 32768-byte ceiling/);\n391: });\n392: \n393: // A pin the engine has no rule for is a pin nobody measured. Counting it as a hold is\n394: // how a manifest edit that adds a kind is reported as verified instead of unmeasured.\n395: test('a pin kind with no rule is UNKNOWN, never a hold', (t) => {\n396:   const fixture = buildFixture(t, 'pure');\n397:   const manifestPath = writeManifest(t, {\n398:     pins: [...manifest.pins, { id: 'invented-pin', kind: 'invented', texts: ['nothing'] }],\n399:   });\n400: \n401:   const run = runJson(['--root', fixture.dir, '--manifest', manifestPath]);\n402:   const pins = rowOf(run.report, 'A5');\n403:   assert.equal(pins.state, 'UNKNOWN');\n404:   const entry = pins.entries.find((candidate) => candidate.id === 'invented-pin');\n405:   assert.equal(entry.state, 'UNKNOWN', 'the entry is not recorded as a pass');\n406:   assert.match(pins.detail, /1 unmeasured/);\n407:   assert.equal(run.report.unknown, 1);\n408:   assert.match(run.out, /\"unknown\": 1/);\n409: });\n410: \n411: // An empty classification is not a verified one. The rows around it already say the\n412: // document is empty or foreign, so a PASS here reads as \"currency checked, all current\".\n413: test('A4 reports INFO when there is no matched section to classify', (t) => {\n414:   const fixture = buildFixture(t, 'foreign');\n415:   const run = runJson(['--root', fixture.dir]);\n416: \n417:   const currency = rowOf(run.report, 'A4');\n418:   assert.equal(currency.state, 'INFO');\n419:   assert.match(currency.detail, /no shipped section/i);\n420: });\n421: \n422: test('a missing canary leaves A6 UNKNOWN, never a pass, and fails the run', (t) => {\n423:   const report = buildReport({\n424:     root: REPO_ROOT,\n425:     tools: { canary: path.join(REPO_ROOT, 'no-such-canary.js') },\n426:   });\n427: \n428:   const budget = report.rows.find((row) => row.id === 'A6');\n429:   assert.equal(budget.state, 'UNKNOWN', 'an absent canary cannot be reported as a pass');\n430:   assert.match(budget.detail, /not installed|absent|missing/i);\n431:   assert.equal(report.exitCode, 1, 'a row that could not be proven keeps the run from claiming a pass');\n432:   assert.equal(report.status, 'UNKNOWN');\n433: \n434:   // Installed on a throwaway root, the same row measures instead of giving up.\n435:   const fixture = buildFixture(t, 'pure');\n436:   assert.notEqual(rowOf(runJson(['--root', fixture.dir]).report, 'A6').state, 'UNKNOWN');\n437: });\n438: \n439: // ─────────────────────────────────────────────────────────────────────────────\n440: // 8. RUNTIME COPIES\n441: // ─────────────────────────────────────────────────────────────────────────────\n442: \n443: test('a divergent CLAUDE.md fails A10 and lists the lines only it carries', (t) => {\n444:   const fixture = buildFixture(t, 'adopted');\n445:   const run = runJson(['--root', fixture.dir]);\n446: \n447:   const copies = rowOf(run.report, 'A10');\n448:   assert.equal(copies.state, 'FINDING');\n449:   const copy = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n450:   assert.ok(copy, 'A10 names the CLAUDE.md row');\n451:   assert.equal(copy.state, 'FINDING');\n452:   assert.equal(copy.kind, 'divergent copy');\n453:   assert.deepEqual(copy.lines, [\n454:     '# Project notes',\n455:     'Run `make check` before you open a pull request.',\n456:     'Update the changelog in the same commit as the code.',\n457:   ]);\n458: });\n459: \n460: test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n461:   const fixture = buildFixture(t, 'pure');\n462:   fs.writeFileSync(\n463:     path.join(fixture.dir, 'CLAUDE.md'),\n464:     '# Claude\\n\\nAll project instructions live in `AGENTS.md`.\\n',\n465:     'utf8',\n466:   );\n467:   const report = buildReport({ root: fixture.dir });\n468: \n469:   const copies = report.rows.find((row) => row.id === 'A10');\n470:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n471:   assert.equal(claude.kind, 'pointer');\n472:   assert.equal(claude.state, 'PASS');\n473:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n474:   assert.equal(codex.kind, 'absent');\n475:   assert.equal(codex.state, 'PASS');\n476: });\n477: \n478: // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n479: // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n480: // pass and the line still prints what Claude never loads.\n481: test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\n482:   const fixture = buildFixture(t, 'pure');\n483:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n484:   const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n485:   assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n486: \n487:   const report = buildReport({ root: fixture.dir });\n488:   const copies = report.rows.find((row) => row.id === 'A10');\n489:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n490:   assert.equal(claude.kind, 'pointer missing');\n491:   assert.equal(claude.state, 'INFO');\n492:   assert.equal(copies.state, 'PASS');\n493:   assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\n494:     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n495: });\n496: \n497: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n498: // prints as a pass line with no detail and leaves the run reporting unknown=0.\n499: test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n500:   const fixture = buildFixture(t, 'pure');\n501:   const report = buildReport({\n502:     root: fixture.dir,\n503:     tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n504:   });\n505: \n506:   const copies = report.rows.find((row) => row.id === 'A10');\n507:   assert.equal(copies.state, 'UNKNOWN', 'a copy that could not be checked is not a pass');\n508:   const entry = copies.entries.find((candidate) => candidate.path === '.cursor/rules/skill-routing.md');\n509:   assert.equal(entry.state, 'UNKNOWN');\n510:   assert.ok(copies.lines.some((line) => line.includes('.cursor/rules/skill-routing.md')),\n511:     `the unmeasured copy is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n512:   assert.equal(report.unknown, 1);\n513:   assert.equal(report.exitCode, 1);\n514:   assert.match(renderText(report), /unknown=1/u);\n515: });\n516: \n517: // ─────────────────────────────────────────────────────────────────────────────\n518: // 9. EXIT CODES AND THE READ-ONLY PROMISE\n519: // ─────────────────────────────────────────────────────────────────────────────\n520: \n521: test('exit codes: 0 on this repository, 1 on a finding, 2 on a failed precondition', (t) => {\n522:   const clean = runCheck([]);\n523:   assert.equal(clean.code, 0, `this repository reports no finding; output: ${clean.out}`);\n524: \n525:   const fixture = buildFixture(t, 'forked');\n526:   const finding = runCheck(['--root', fixture.dir]);\n527:   assert.equal(finding.code, 1, 'a finding exits 1');\n528: \n529:   const missingRoot = runCheck(['--root', path.join(fixture.dir, 'no-such-directory')]);\n530:   assert.equal(missingRoot.code, 2, 'a missing root is a failed precondition');\n531:   assert.match(missingRoot.err, /no-such-directory/, 'the failure names the path it could not read');\n532: \n533:   const missingManifest = runCheck(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'no-such-manifest.json')]);\n534:   assert.equal(missingManifest.code, 2, 'a missing manifest is a failed precondition');\n535:   assert.match(missingManifest.err, /no-such-manifest\\.json/);\n536: });\n537: \n538: test('exit codes: an absent instruction file is a finding, not a precondition failure', (t) => {\n539:   const fixture = buildFixture(t, 'absent');\n540:   const run = runCheck(['--root', fixture.dir]);\n541:   assert.equal(run.code, 1, 'nothing to compare is an answer about the repository, not a broken run');\n542: });\n543: \n544: // The root file's name is the manifest's to declare. Naming it here means a manifest that\n545: // moves the document leaves this precondition reading a file nobody ships.\n546: test('the readability precondition reads the manifest\\'s root file, not a fixed name', (t) => {\n547:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-root-file-'));\n548:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n549:   // A directory under the name the script used to hardcode: reading it throws, so a run\n550:   // that reads it exits 2 instead of classifying the tree.\n551:   fs.mkdirSync(path.join(root, 'AGENTS.md'));\n552:   const manifestPath = writeManifest(t, { root_file: 'GUIDE.md' });\n553: \n554:   const run = runCheck(['--root', root, '--manifest', manifestPath]);\n555:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n556:   assert.doesNotMatch(run.err, /cannot read/u);\n557: });\n558: \n559: test('the write-spy records no filesystem write while every row executes', (t) => {\n560:   const fixture = buildFixture(t, 'forked');\n561:   const watched = [\n562:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n563:     'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n564:     'writeFile', 'appendFile', 'mkdir', 'rm', 'unlink', 'copyFile', 'rename', 'openSync',\n565:   ];\n566:   const calls = [];\n567:   const originals = new Map();\n568:   for (const name of watched) {\n569:     if (typeof fs[name] !== 'function') continue;\n570:     originals.set(name, fs[name]);\n571:     fs[name] = (...args) => {\n572:       calls.push(`${name}(${String(args[0])})`);\n573:       return originals.get(name).apply(fs, args);\n574:     };\n575:   }\n576: \n577:   let report = null;\n578:   try {\n579:     report = buildReport({ root: fixture.dir });\n580:   } finally {\n581:     for (const [name, original] of originals) fs[name] = original;\n582:   }\n583: \n584:   assert.deepEqual(calls, [], 'the run wrote nothing');\n585:   assert.equal(report.rows.length, ROWS.length, 'every row ran with the spy in place');\n586: });\n587: \n588: test('every fixture run leaves its tree byte-identical', (t) => {\n589:   for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n590:     const fixture = buildFixture(t, name);\n591:     const before = treeDigest(fixture.dir);\n592:     runCheck(['--root', fixture.dir, '--json']);\n593:     runCheck(['--root', fixture.dir]);\n594:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n595:   }\n596: });\n597: \n598: // ─────────────────────────────────────────────────────────────────────────────\n599: // 10. REPORT SHAPE\n600: // ─────────────────────────────────────────────────────────────────────────────\n601: \n602: test('every row appears in the report, once, in order', (t) => {\n603:   const fixture = buildFixture(t, 'pure');\n604:   const run = runCheck(['--root', fixture.dir]);\n605:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n606:   assert.deepEqual(printed, ROWS);\n607: \n608:   const report = buildReport({ root: fixture.dir });\n609:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n610: });\n611: \n612: test('--json carries the same rows and the same state as the text form', (t) => {\n613:   const fixture = buildFixture(t, 'forked');\n614:   const text = runCheck(['--root', fixture.dir]);\n615:   const json = runJson(['--root', fixture.dir]);\n616: \n617:   assert.equal(json.code, text.code, 'the two forms agree on the exit code');\n618:   assert.equal(json.report.state, 'forked');\n619:   const fromText = textRowStates(text.out);\n620:   assert.deepEqual(Object.keys(fromText).sort(), ROWS.slice().sort());\n621:   for (const row of json.report.rows) {\n622:     assert.equal(row.state, fromText[row.id], `row ${row.id} reads the same in both forms`);\n623:   }\n624: });\n625: \n626: test('this repository reports STATUS=OK and a pure install state', () => {\n627:   const run = runCheck([]);\n628:   assert.equal(run.code, 0);\n629:   assert.match(run.out, /^STATUS=OK/m);\n630:   assert.match(run.out, /^A1 install state: pure/m);\n631: });\n632: \n633: test('A11 embeds the repo-rules checker\\'s own summary line instead of re-deriving it', () => {\n634:   const report = buildReport({ root: REPO_ROOT });\n635:   const row = report.rows.find((entry) => entry.id === 'A11');\n636:   assert.equal(row.state, 'PASS');\n637:   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n638: });\n639: \n640: test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n641:   const fixture = buildFixture(t, 'pure');\n642:   const outside = buildReport({ root: fixture.dir });\n643:   const row = outside.rows.find((entry) => entry.id === 'A12');\n644:   assert.equal(row.state, 'INFO');\n645:   assert.match(row.detail, /source repository/);\n646: \n647:   const inside = buildReport({ root: REPO_ROOT });\n648:   assert.equal(inside.rows.find((entry) => entry.id === 'A12').state, 'PASS');\n649: });\n650: \n651: test('a precondition failure exits 2 rather than printing an empty report', (t) => {\n652:   const fixture = buildFixture(t, 'pure');\n653:   const code = main(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'missing.json')]);\n654:   assert.equal(code, 2);\n655: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-655\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: // The composer writes the Gate 1 mirror only, so a case that reads a whole runtime-copy row\n48: // finishes the mirrors with the generator that owns them, as a repository that ran its own\n49: // generators would.\n50: const POINTER_SYNC = path.join(\n51:   REPO_ROOT,\n52:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n53: );\n54: \n55: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n56: \n57: // The rows every report carries, in the order the engine prints them.\n58: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n59: \n60: // ─────────────────────────────────────────────────────────────────────────────\n61: // 2. FIXTURE TREES\n62: // ─────────────────────────────────────────────────────────────────────────────\n63: \n64: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n65: // can read a stale copy of a document, and the tree a case runs against is always the\n66: // template that ships in this repository.\n67: function buildFixture(t, name) {\n68:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n69:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n70:   const dir = path.join(parent, name);\n71:   composeFixture(name, dir);\n72:   const documentPath = path.join(dir, manifest.root_file);\n73:   return {\n74:     dir,\n75:     recipe: loadRecipe(name),\n76:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n77:   };\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 3. RUNNERS AND READERS\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function runCheck(args) {\n85:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n86:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n87: }\n88: \n89: function runJson(args) {\n90:   const run = runCheck([...args, '--json']);\n91:   let report = null;\n92:   try {\n93:     report = JSON.parse(run.out);\n94:   } catch {\n95:     report = null;\n96:   }\n97:   return { ...run, report };\n98: }\n99: \n100: function rowOf(report, id) {\n101:   const row = report.rows.find((entry) => entry.id === id);\n102:   assert.ok(row, `the report carries row ${id}`);\n103:   return row;\n104: }\n105: \n106: // The text form prints one line per row, ending in the row's verdict, so the two\n107: // renderers can be compared without re-implementing either.\n108: function textRowStates(out) {\n109:   const states = {};\n110:   for (const line of out.split('\\n')) {\n111:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n112:     if (hit) states[hit[1]] = hit[2];\n113:   }\n114:   return states;\n115: }\n116: \n117: function listFiles(dir) {\n118:   const files = [];\n119:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n120:     const target = path.join(dir, entry.name);\n121:     if (entry.isDirectory()) files.push(...listFiles(target));\n122:     else files.push(target);\n123:   }\n124:   return files;\n125: }\n126: \n127: // A fixture's document is rewritten by a case that needs a shape no recipe describes,\n128: // so the tree a case reads is always the template the manifest ships today.\n129: function rewriteDocument(fixture, text) {\n130:   fs.writeFileSync(path.join(fixture.dir, manifest.root_file), text, 'utf8');\n131: }\n132: \n133: // A throwaway manifest: pin kinds and root file names are the two places a case needs a\n134: // declaration the shipped manifest does not carry.\n135: function writeManifest(t, patch) {\n136:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-manifest-'));\n137:   t.after(() => fs.rmSync(dir, { recursive: true, force: true }));\n138:   const target = path.join(dir, 'agents-md-manifest.json');\n139:   fs.writeFileSync(target, `${JSON.stringify({ ...manifest, ...patch }, null, 2)}\\n`, 'utf8');\n140:   return target;\n141: }\n142: \n143: function treeDigest(dir) {\n144:   const hash = crypto.createHash('sha256');\n145:   for (const file of listFiles(dir).sort()) {\n146:     hash.update(path.relative(dir, file));\n147:     hash.update(fs.readFileSync(file));\n148:   }\n149:   return hash.digest('hex');\n150: }\n151: \n152: // ─────────────────────────────────────────────────────────────────────────────\n153: // 4. THE FIXTURES ARE RECIPES, NOT COPIES\n154: // ─────────────────────────────────────────────────────────────────────────────\n155: \n156: // A composed tree committed beside its recipe would be a second copy of the template,\n157: // and the copy is what the repository would then have to keep: relative links would\n158: // resolve against the fixture folder, a runtime loading nested instruction files would\n159: // read it as somebody's own document, and each template edit would need a regeneration\n160: // commit. This case holds the rule the fixtures are arranged by.\n161: test('every fixture folder holds its recipe and no composed tree', () => {\n162:   const stray = [];\n163:   for (const name of fixtureNames()) {\n164:     for (const entry of fs.readdirSync(path.join(FIXTURES, name), { withFileTypes: true })) {\n165:       if (entry.name !== 'fixture.json' || entry.isDirectory()) stray.push(`${name}/${entry.name}`);\n166:     }\n167:   }\n168:   assert.deepEqual(stray, [],\n169:     'compose a fixture into a temporary folder with the suite\\'s composer instead of committing the tree it describes');\n170: });\n171: \n172: test('composer: the pure fixture rebuilds the shipped document from the manifest', (t) => {\n173:   const fixture = buildFixture(t, 'pure');\n174:   const { sections } = segment(fixture.document, manifest.markers, manifest.sections);\n175: \n176:   assert.equal(sections.length, manifest.sections.length, 'the composed document carries every shipped section');\n177:   for (const section of sections) {\n178:     assert.ok(section.id, `the composed heading ${JSON.stringify(section.heading)} matches a manifest entry`);\n179:     assert.equal(section.sha256, manifest.derived.sections[section.id].sha256,\n180:       `section ${section.id} is byte-identical to the manifest's derived body`);\n181:   }\n182:   const rootDocument = fs.readFileSync(path.join(REPO_ROOT, manifest.root_file), 'utf8');\n183:   assert.ok(rootDocument.startsWith(fixture.document),\n184:     'the composed document is the root document up to its repository block');\n185: });\n186: \n187: test('composer: each fixture declares the install state it plants', () => {\n188:   const names = fixtureNames();\n189:   assert.equal(names.length, 9, 'there are nine fixture recipes');\n190:   for (const name of names) {\n191:     const recipe = loadRecipe(name);\n192:     assert.equal(recipe.name, name, `${name} names itself`);\n193:     assert.ok(recipe.expect_state, `${name} declares its expected install state`);\n194:     assert.ok(recipe.notes, `${name} says what defect it plants`);\n195:   }\n196: });\n197: \n198: // ─────────────────────────────────────────────────────────────────────────────\n199: // 5. A1 INSTALL STATE, ONE FIXTURE PER STATE\n200: // ─────────────────────────────────────────────────────────────────────────────\n201: \n202: for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n203:   test(`A1 install state: the ${name} fixture classifies as ${loadRecipe(name).expect_state}`, (t) => {\n204:     const fixture = buildFixture(t, name);\n205:     const run = runJson(['--root', fixture.dir]);\n206: \n207:     assert.ok(run.report, `the engine prints a JSON report for ${name}; stderr: ${run.err}`);\n208:     assert.equal(run.report.state, fixture.recipe.expect_state);\n209:     assert.match(run.out, new RegExp(`\"state\": \"${fixture.recipe.expect_state}\"`));\n210:   });\n211: }\n212: \n213: test('A1 install state: this repository is the source template and classifies as pure', () => {\n214:   const report = buildReport({ root: REPO_ROOT });\n215:   assert.equal(report.state, 'pure', 'the shipped template carries every section current and an empty block');\n216: });\n217: \n218: // ─────────────────────────────────────────────────────────────────────────────\n219: // 6. UNMARKED CONTENT AND UNMARKED EDITS\n220: // ─────────────────────────────────────────────────────────────────────────────\n221: \n222: test('forked: A8 lists the unmarked section with its byte range and A9 lists the local line', (t) => {\n223:   const fixture = buildFixture(t, 'forked');\n224:   const run = runJson(['--root', fixture.dir]);\n225: \n226:   assert.equal(run.code, 1, 'a forked repository is a finding, not a pass');\n227:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n228: \n229:   const unmarked = rowOf(run.report, 'A8');\n230:   assert.equal(unmarked.state, 'FINDING');\n231:   const section = unmarked.entries.find((entry) => entry.heading.includes('Local release checklist'));\n232:   assert.ok(section, \"A8 lists the repository's own section by heading\");\n233:   assert.ok(section.byte_start > 0 && section.byte_end > section.byte_start, 'A8 gives the section a byte range');\n234:   assert.equal(section.line_start, fixture.document.split('\\n').indexOf('## Local release checklist') + 1,\n235:     'A8 gives the section a line range that a reader can open');\n236:   assert.equal(section.in_prefix, false, 'the section sits outside the delivery prefix');\n237: \n238:   const edits = rowOf(run.report, 'A9');\n239:   assert.equal(edits.state, 'FINDING');\n240:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n241:   assert.ok(edited, 'A9 names the edited section');\n242:   assert.equal(edited.state, 'edited');\n243:   assert.deepEqual(edited.lines, ['Local rule: name the packet in the first line of every pull request.']);\n244: });\n245: \n246: // The same sentence written twice is two lines a replacement would lose, so the row\n247: // counts occurrences: a set would report one line and hide the other.\n248: test('A9 counts a repeated local line once per occurrence', (t) => {\n249:   const fixture = buildFixture(t, 'forked');\n250:   const line = 'Local rule: name the packet in the first line of every pull request.';\n251:   rewriteDocument(fixture, fixture.document.replace(line, `${line}\\n${line}`));\n252: \n253:   const run = runJson(['--root', fixture.dir]);\n254:   const edits = rowOf(run.report, 'A9');\n255:   assert.equal(edits.state, 'FINDING');\n256:   const edited = edits.entries.find((entry) => entry.id === 's6-spec-folder');\n257:   assert.deepEqual(edited.lines, [line, line], 'the repeated line is listed twice');\n258:   assert.match(edits.detail, /1 section\\(s\\) carry 2 local line\\(s\\)/);\n259: });\n260: \n261: // A repository that wrote its block between two shipped sections still carries every\n262: // shipped section, and the block is in the one place the template does not put it. Read\n263: // only above the block, the document looks like somebody else's file and the position is\n264: // never named.\n265: test('a block placed between shipped sections is reported by A7 with its position', (t) => {\n266:   const fixture = buildFixture(t, 'adopted');\n267:   const moved = moveBlockBefore(fixture.document, '#### The Four Laws');\n268:   rewriteDocument(fixture, moved);\n269: \n270:   const run = runJson(['--root', fixture.dir]);\n271:   assert.equal(rowOf(run.report, 'A1').detail, 'adopted', 'every shipped section is still current');\n272:   assert.equal(rowOf(run.report, 'A2').detail, '44/44 matched', 'the sections below the block are shipped ones');\n273:   assert.equal(rowOf(run.report, 'A8').state, 'PASS', 'nothing below the block is unmarked content');\n274: \n275:   const block = rowOf(run.report, 'A7');\n276:   assert.equal(block.state, 'FINDING');\n277:   const position = block.lines.join(' ');\n278:   // Offsets in the report are bytes, and the template carries multi-byte headings above\n279:   // the block, so the character index is not the figure to compare against.\n280:   const blockByte = Buffer.byteLength(moved.slice(0, moved.indexOf(manifest.markers.start)), 'utf8');\n281:   assert.ok(position.includes(`byte ${blockByte}`), `A7 names where the block sits: ${position}`);\n282:   assert.match(position, /The Four Laws/, 'A7 names the shipped section the block sits in front of');\n283: });\n284: \n285: // The end marker is not the end of the file: a line typed below it is the repository's\n286: // own, and a rewrite that keeps only the block would drop it without a word.\n287: test('a line after the block end marker is reported as a local edit', (t) => {\n288:   const fixture = buildFixture(t, 'adopted');\n289:   const line = 'Ship the release note in the same commit as the tag.';\n290:   rewriteDocument(fixture, `${fixture.document}${line}\\n`);\n291: \n292:   const run = runJson(['--root', fixture.dir]);\n293:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n294: \n295:   const edits = rowOf(run.report, 'A9');\n296:   assert.equal(edits.state, 'FINDING');\n297:   const carrier = edits.entries.find((entry) => entry.lines.includes(line));\n298:   assert.ok(carrier, `A9 lists the line below the end marker: ${JSON.stringify(edits.entries)}`);\n299: });\n300: \n301: // Text above the first heading belongs to no section, so it is the one piece of\n302: // repository content a heading-shaped comparison cannot see. Left unreported, a document\n303: // carrying it reads as a pure template and a rewrite drops it.\n304: test('text before the first shipped heading is reported as unmarked repository content', (t) => {\n305:   const fixture = buildFixture(t, 'pure');\n306:   const line = 'Read me first.';\n307:   rewriteDocument(fixture, `${line}\\n${fixture.document}`);\n308: \n309:   const run = runJson(['--root', fixture.dir]);\n310:   assert.equal(rowOf(run.report, 'A1').detail, 'forked');\n311: \n312:   const unmarked = rowOf(run.report, 'A8');\n313:   assert.equal(unmarked.state, 'FINDING');\n314:   const prelude = unmarked.entries.find((entry) => entry.heading === null);\n315:   assert.ok(prelude, `A8 names the text above the first heading: ${JSON.stringify(unmarked.entries)}`);\n316:   assert.equal(prelude.byte_start, 0, 'the region starts at the first byte');\n317:   assert.equal(prelude.line_start, 1);\n318:   assert.match(unmarked.lines.join(' '), /before the first heading/);\n319: });\n320: \n321: // A body can carry every line the shipped body carries and still not be it: one extra\n322: // space on an indented bullet is a real difference and a rewrite replaces it. A finding\n323: // with nothing under it names no line to look at, so the row says what the difference is\n324: // and where the two bodies part company.\n325: test('A9 names a body that differs only in whitespace, by line', (t) => {\n326:   const fixture = buildFixture(t, 'pure');\n327:   const shipped = manifest.derived.sections['gate-3'].body;\n328:   const lines = shipped.split('\\n');\n329:   const indented = lines.findIndex((row) => row.startsWith('  '));\n330:   assert.notEqual(indented, -1, 'the shipped body carries an indented line');\n331:   lines[indented] = ` ${lines[indented]}`;\n332:   assert.notEqual(lines[indented], shipped.split('\\n')[indented]);\n333:   rewriteDocument(fixture, fixture.document.replace(shipped, lines.join('\\n')));\n334: \n335:   const run = runJson(['--root', fixture.dir]);\n336:   assert.equal(rowOf(run.report, 'A4').entries.find((entry) => entry.id === 'gate-3').state, 'edited', 'the body is not the shipped one');\n337: \n338:   const edits = rowOf(run.report, 'A9');\n339:   assert.equal(edits.state, 'FINDING', 'the section is not the shipped one, so the row reports it');\n340:   assert.ok(edits.lines.length > 0, 'a finding names at least one line to act on');\n341:   assert.match(edits.lines[0], /gate-3/u, 'the line names the section');\n342:   assert.match(edits.lines[0], new RegExp(`line ${indented + 1}\\\\b`, 'u'), 'and the line of the body where the two differ');\n343:   assert.match(edits.lines[0], /whitespace/u, 'and says the difference is whitespace');\n344: \n345:   const text = runCheck(['--root', fixture.dir]);\n346:   assert.match(text.out, /A9 unmarked local edits: .*\\(FINDING\\)/u);\n347:   assert.match(text.out, /gate-3: only whitespace/u, 'the text form prints the same line');\n348: });\n349: \n350: // A marker is the whole line, so a sentence that quotes both markers is prose. Counting\n351: // the bytes instead would report a document with no block as carrying two of them, which\n352: // is a finding about a file nobody can fix.\n353: test('A7 counts marker lines, not the marker text quoted inside a sentence', (t) => {\n354:   const fixture = buildFixture(t, 'pure');\n355:   const sentence = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n356:   rewriteDocument(fixture, `${fixture.document}${sentence}\\n`);\n357: \n358:   const run = runJson(['--root', fixture.dir]);\n359:   const block = rowOf(run.report, 'A7');\n360:   assert.equal(block.state, 'PASS', `a sentence quoting both markers is prose, not a block: ${block.lines.join(' | ')}`);\n361:   assert.match(block.detail, /no block/u, 'the document carries no block, because neither marker is a line of its own');\n362: });\n363: \n364: // ─────────────────────────────────────────────────────────────────────────────\n365: // 7. PINS, BUDGET AND BLOCK SHAPE\n366: // ─────────────────────────────────────────────────────────────────────────────\n367: \n368: test('shadowed-pin: A5 fails because the local lookup line comes before Gate 1', (t) => {\n369:   const fixture = buildFixture(t, 'shadowed-pin');\n370:   const run = runJson(['--root', fixture.dir]);\n371: \n372:   const pins = rowOf(run.report, 'A5');\n373:   assert.equal(pins.state, 'FINDING');\n374:   const pin = pins.entries.find((entry) => entry.id === 'gate1-lookup');\n375:   assert.ok(pin, 'A5 names the pin the local line shadows');\n376:   assert.equal(pin.state, 'FINDING');\n377:   assert.match(pin.detail, /first occurrence/i);\n378: });\n379: \n380: test('over-budget: A6 and A7 both fail', (t) => {\n381:   const fixture = buildFixture(t, 'over-budget');\n382:   const total = Buffer.byteLength(fixture.document, 'utf8');\n383:   assert.ok(total > manifest.budget.max_bytes, `the fixture is ${total} bytes, past the ${manifest.budget.max_bytes}-byte ceiling`);\n384: \n385:   const run = runJson(['--root', fixture.dir]);\n386:   assert.equal(rowOf(run.report, 'A6').state, 'FINDING');\n387:   const block = rowOf(run.report, 'A7');\n388:   assert.equal(block.state, 'FINDING');\n389:   assert.match(block.lines.join(' '), /end marker sits before the start marker/i);\n390:   assert.match(block.lines.join(' '), /exceeds the 32768-byte ceiling/);\n391: });\n392: \n393: // A pin the engine has no rule for is a pin nobody measured. Counting it as a hold is\n394: // how a manifest edit that adds a kind is reported as verified instead of unmeasured.\n395: test('a pin kind with no rule is UNKNOWN, never a hold', (t) => {\n396:   const fixture = buildFixture(t, 'pure');\n397:   const manifestPath = writeManifest(t, {\n398:     pins: [...manifest.pins, { id: 'invented-pin', kind: 'invented', texts: ['nothing'] }],\n399:   });\n400: \n401:   const run = runJson(['--root', fixture.dir, '--manifest', manifestPath]);\n402:   const pins = rowOf(run.report, 'A5');\n403:   assert.equal(pins.state, 'UNKNOWN');\n404:   const entry = pins.entries.find((candidate) => candidate.id === 'invented-pin');\n405:   assert.equal(entry.state, 'UNKNOWN', 'the entry is not recorded as a pass');\n406:   assert.match(pins.detail, /1 unmeasured/);\n407:   assert.equal(run.report.unknown, 1);\n408:   assert.match(run.out, /\"unknown\": 1/);\n409: });\n410: \n411: // An empty classification is not a verified one. The rows around it already say the\n412: // document is empty or foreign, so a PASS here reads as \"currency checked, all current\".\n413: test('A4 reports INFO when there is no matched section to classify', (t) => {\n414:   const fixture = buildFixture(t, 'foreign');\n415:   const run = runJson(['--root', fixture.dir]);\n416: \n417:   const currency = rowOf(run.report, 'A4');\n418:   assert.equal(currency.state, 'INFO');\n419:   assert.match(currency.detail, /no shipped section/i);\n420: });\n421: \n422: test('a missing canary leaves A6 UNKNOWN, never a pass, and fails the run', (t) => {\n423:   const report = buildReport({\n424:     root: REPO_ROOT,\n425:     tools: { canary: path.join(REPO_ROOT, 'no-such-canary.js') },\n426:   });\n427: \n428:   const budget = report.rows.find((row) => row.id === 'A6');\n429:   assert.equal(budget.state, 'UNKNOWN', 'an absent canary cannot be reported as a pass');\n430:   assert.match(budget.detail, /not installed|absent|missing/i);\n431:   assert.equal(report.exitCode, 1, 'a row that could not be proven keeps the run from claiming a pass');\n432:   assert.equal(report.status, 'UNKNOWN');\n433: \n434:   // Installed on a throwaway root, the same row measures instead of giving up.\n435:   const fixture = buildFixture(t, 'pure');\n436:   assert.notEqual(rowOf(runJson(['--root', fixture.dir]).report, 'A6').state, 'UNKNOWN');\n437: });\n438: \n439: // ─────────────────────────────────────────────────────────────────────────────\n440: // 8. RUNTIME COPIES\n441: // ─────────────────────────────────────────────────────────────────────────────\n442: \n443: test('a divergent CLAUDE.md fails A10 and lists the lines only it carries', (t) => {\n444:   const fixture = buildFixture(t, 'adopted');\n445:   const run = runJson(['--root', fixture.dir]);\n446: \n447:   const copies = rowOf(run.report, 'A10');\n448:   assert.equal(copies.state, 'FINDING');\n449:   const copy = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n450:   assert.ok(copy, 'A10 names the CLAUDE.md row');\n451:   assert.equal(copy.state, 'FINDING');\n452:   assert.equal(copy.kind, 'divergent copy');\n453:   assert.deepEqual(copy.lines, [\n454:     '# Project notes',\n455:     'Run `make check` before you open a pull request.',\n456:     'Update the changelog in the same commit as the code.',\n457:   ]);\n458: });\n459: \n460: test('A10 reports a pointer-only CLAUDE.md and an absent .codex/AGENTS.md without a finding', (t) => {\n461:   const fixture = buildFixture(t, 'pure');\n462:   fs.writeFileSync(\n463:     path.join(fixture.dir, 'CLAUDE.md'),\n464:     '# Claude\\n\\nAll project instructions live in `AGENTS.md`.\\n',\n465:     'utf8',\n466:   );\n467:   const report = buildReport({ root: fixture.dir });\n468: \n469:   const copies = report.rows.find((row) => row.id === 'A10');\n470:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n471:   assert.equal(claude.kind, 'pointer');\n472:   assert.equal(claude.state, 'PASS');\n473:   const codex = copies.entries.find((entry) => entry.path === '.codex/AGENTS.md');\n474:   assert.equal(codex.kind, 'absent');\n475:   assert.equal(codex.state, 'PASS');\n476: });\n477: \n478: // Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\n479: // the root document. That is a missing route, not a copy that is wrong, so the row stays a\n480: // pass and the line still prints what Claude never loads.\n481: test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\n482:   const fixture = buildFixture(t, 'pure');\n483:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\n484:   const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\n485:   assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\n486: \n487:   const report = buildReport({ root: fixture.dir });\n488:   const copies = report.rows.find((row) => row.id === 'A10');\n489:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\n490:   assert.equal(claude.kind, 'pointer missing');\n491:   assert.equal(claude.state, 'INFO');\n492:   assert.equal(copies.state, 'PASS');\n493:   assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\n494:     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n495: });\n496: \n497: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\n498: // prints as a pass line with no detail and leaves the run reporting unknown=0.\n499: test('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\n500:   const fixture = buildFixture(t, 'pure');\n501:   const report = buildReport({\n502:     root: fixture.dir,\n503:     tools: { pointerSync: path.join(fixture.dir, 'no-such-pointer-sync.cjs') },\n504:   });\n505: \n506:   const copies = report.rows.find((row) => row.id === 'A10');\n507:   assert.equal(copies.state, 'UNKNOWN', 'a copy that could not be checked is not a pass');\n508:   const entry = copies.entries.find((candidate) => candidate.path === '.cursor/rules/skill-routing.md');\n509:   assert.equal(entry.state, 'UNKNOWN');\n510:   assert.ok(copies.lines.some((line) => line.includes('.cursor/rules/skill-routing.md')),\n511:     `the unmeasured copy is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\n512:   assert.equal(report.unknown, 1);\n513:   assert.equal(report.exitCode, 1);\n514:   assert.match(renderText(report), /unknown=1/u);\n515: });\n516: \n517: // ─────────────────────────────────────────────────────────────────────────────\n518: // 9. EXIT CODES AND THE READ-ONLY PROMISE\n519: // ─────────────────────────────────────────────────────────────────────────────\n520: \n521: test('exit codes: 0 on this repository, 1 on a finding, 2 on a failed precondition', (t) => {\n522:   const clean = runCheck([]);\n523:   assert.equal(clean.code, 0, `this repository reports no finding; output: ${clean.out}`);\n524: \n525:   const fixture = buildFixture(t, 'forked');\n526:   const finding = runCheck(['--root', fixture.dir]);\n527:   assert.equal(finding.code, 1, 'a finding exits 1');\n528: \n529:   const missingRoot = runCheck(['--root', path.join(fixture.dir, 'no-such-directory')]);\n530:   assert.equal(missingRoot.code, 2, 'a missing root is a failed precondition');\n531:   assert.match(missingRoot.err, /no-such-directory/, 'the failure names the path it could not read');\n532: \n533:   const missingManifest = runCheck(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'no-such-manifest.json')]);\n534:   assert.equal(missingManifest.code, 2, 'a missing manifest is a failed precondition');\n535:   assert.match(missingManifest.err, /no-such-manifest\\.json/);\n536: });\n537: \n538: test('exit codes: an absent instruction file is a finding, not a precondition failure', (t) => {\n539:   const fixture = buildFixture(t, 'absent');\n540:   const run = runCheck(['--root', fixture.dir]);\n541:   assert.equal(run.code, 1, 'nothing to compare is an answer about the repository, not a broken run');\n542: });\n543: \n544: // The root file's name is the manifest's to declare. Naming it here means a manifest that\n545: // moves the document leaves this precondition reading a file nobody ships.\n546: test('the readability precondition reads the manifest\\'s root file, not a fixed name', (t) => {\n547:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-check-root-file-'));\n548:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n549:   // A directory under the name the script used to hardcode: reading it throws, so a run\n550:   // that reads it exits 2 instead of classifying the tree.\n551:   fs.mkdirSync(path.join(root, 'AGENTS.md'));\n552:   const manifestPath = writeManifest(t, { root_file: 'GUIDE.md' });\n553: \n554:   const run = runCheck(['--root', root, '--manifest', manifestPath]);\n555:   assert.equal(run.code, 1, `the tree is classified rather than refused: ${run.err}`);\n556:   assert.doesNotMatch(run.err, /cannot read/u);\n557: });\n558: \n559: test('the write-spy records no filesystem write while every row executes', (t) => {\n560:   const fixture = buildFixture(t, 'forked');\n561:   const watched = [\n562:     'writeFileSync', 'appendFileSync', 'mkdirSync', 'rmSync', 'rmdirSync', 'unlinkSync',\n563:     'copyFileSync', 'renameSync', 'symlinkSync', 'linkSync', 'truncateSync', 'chmodSync',\n564:     'writeFile', 'appendFile', 'mkdir', 'rm', 'unlink', 'copyFile', 'rename', 'openSync',\n565:   ];\n566:   const calls = [];\n567:   const originals = new Map();\n568:   for (const name of watched) {\n569:     if (typeof fs[name] !== 'function') continue;\n570:     originals.set(name, fs[name]);\n571:     fs[name] = (...args) => {\n572:       calls.push(`${name}(${String(args[0])})`);\n573:       return originals.get(name).apply(fs, args);\n574:     };\n575:   }\n576: \n577:   let report = null;\n578:   try {\n579:     report = buildReport({ root: fixture.dir });\n580:   } finally {\n581:     for (const [name, original] of originals) fs[name] = original;\n582:   }\n583: \n584:   assert.deepEqual(calls, [], 'the run wrote nothing');\n585:   assert.equal(report.rows.length, ROWS.length, 'every row ran with the spy in place');\n586: });\n587: \n588: test('every fixture run leaves its tree byte-identical', (t) => {\n589:   for (const name of ['pure', 'adopted', 'stale', 'forked', 'foreign', 'claude-only', 'absent', 'shadowed-pin', 'over-budget']) {\n590:     const fixture = buildFixture(t, name);\n591:     const before = treeDigest(fixture.dir);\n592:     runCheck(['--root', fixture.dir, '--json']);\n593:     runCheck(['--root', fixture.dir]);\n594:     assert.equal(treeDigest(fixture.dir), before, `the ${name} fixture was not touched`);\n595:   }\n596: });\n597: \n598: // ─────────────────────────────────────────────────────────────────────────────\n599: // 10. REPORT SHAPE\n600: // ─────────────────────────────────────────────────────────────────────────────\n601: \n602: test('every row appears in the report, once, in order', (t) => {\n603:   const fixture = buildFixture(t, 'pure');\n604:   const run = runCheck(['--root', fixture.dir]);\n605:   const printed = run.out.split('\\n').map((line) => /^(A\\d+) /.exec(line)).filter(Boolean).map((hit) => hit[1]);\n606:   assert.deepEqual(printed, ROWS);\n607: \n608:   const report = buildReport({ root: fixture.dir });\n609:   assert.deepEqual(report.rows.map((row) => row.id), ROWS);\n610: });\n611: \n612: test('--json carries the same rows and the same state as the text form', (t) => {\n613:   const fixture = buildFixture(t, 'forked');\n614:   const text = runCheck(['--root', fixture.dir]);\n615:   const json = runJson(['--root', fixture.dir]);\n616: \n617:   assert.equal(json.code, text.code, 'the two forms agree on the exit code');\n618:   assert.equal(json.report.state, 'forked');\n619:   const fromText = textRowStates(text.out);\n620:   assert.deepEqual(Object.keys(fromText).sort(), ROWS.slice().sort());\n621:   for (const row of json.report.rows) {\n622:     assert.equal(row.state, fromText[row.id], `row ${row.id} reads the same in both forms`);\n623:   }\n624: });\n625: \n626: test('this repository reports STATUS=OK and a pure install state', () => {\n627:   const run = runCheck([]);\n628:   assert.equal(run.code, 0);\n629:   assert.match(run.out, /^STATUS=OK/m);\n630:   assert.match(run.out, /^A1 install state: pure/m);\n631: });\n632: \n633: test('A11 embeds the repo-rules checker\\'s own summary line instead of re-deriving it', () => {\n634:   const report = buildReport({ root: REPO_ROOT });\n635:   const row = report.rows.find((entry) => entry.id === 'A11');\n636:   assert.equal(row.state, 'PASS');\n637:   assert.match(row.detail, /\\[repo-rules-check\\] RESULT: PASSED \\(\\d+\\/\\d+ checks\\)/);\n638: });\n639: \n640: test('A12 reports INFO outside the source repository and runs inside it', (t) => {\n641:   const fixture = buildFixture(t, 'pure');\n642:   const outside = buildReport({ root: fixture.dir });\n643:   const row = outside.rows.find((entry) => entry.id === 'A12');\n644:   assert.equal(row.state, 'INFO');\n645:   assert.match(row.detail, /source repository/);\n646: \n647:   const inside = buildReport({ root: REPO_ROOT });\n648:   assert.equal(inside.rows.find((entry) => entry.id === 'A12').state, 'PASS');\n649: });\n650: \n651: test('a precondition failure exits 2 rather than printing an empty report', (t) => {\n652:   const fixture = buildFixture(t, 'pure');\n653:   const code = main(['--root', fixture.dir, '--manifest', path.join(fixture.dir, 'missing.json')]);\n654:   assert.equal(code, 2);\n655: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\"}"},"time":{"start":1794558641300,"end":1794558641368}}}}
