MPT).toBe('0');\n38:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n39:   });\n40: });\n41: \n42: describe('startedLabel', () => {\n43:   it('labels a row from its own command and variant', () => {\n44:     const label = startedLabel('g2-x-custom', [\n45:       { id: 'g2-x-custom', command: '/speckit:plan', variant: 'typed', prompt: 'p' },\n46:     ]);\n47: \n48:     expect(label?.expected_command).toBe('/speckit:plan');\n49:     expect(label?.expected_policy).toBe('start');\n50:     expect(label?.prompt).toBe(':auto');\n51:   });\n52: \n53:   it('returns no label for an id no row carries', () => {\n54:     expect(startedLabel('g2-nope')).toBeNull();\n55:   });\n56: \n57:   it('labels every runner row with its command and only a typed row with :auto', () => {\n58:     for (const row of G2_ROWS) {\n59:       const label = startedLabel(row.id);\n60: \n61:       expect(['/deep:research', '/deep:review', '/speckit:complete']).toContain(label?.expected_command);\n62:       expect(label?.expected_command).toBe(row.command);\n63:       expect(label?.prompt).toBe(row.variant === 'typed' ? ':auto' : '');\n64:     }\n65:   });\n66: });\n67: \n68: describe('liveArmRefusal', () => {\n69:   const dirs: string[] = [];\n70: \n71:   afterEach(() => {\n72:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n73:   });\n74: \n75:   it('refuses a live arm outside a marked arena', () => {\n76:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n77:     dirs.push(dir);\n78:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n79:     expect(runGit(['init', '-q']).status).toBe(0);\n80: \n[Output truncated. Continue reading with offset: 81]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\", \"limit\": 80}"},"time":{"start":1794561574922,"end":17