T### [P?] Description (file path). Verify: <command> prints <expected output>`\\n28: \\n29: Every co...\n  Line 14: {\"type\":\"tool_use\",\"timestamp\":1794545753766,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d3431cf6001XNbHIrIY5l4gID\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d34311c2001Loxu94Lba6cR7v\",\"type\":\"tool\",\"id\":\"call_204bd3d8bb1f47e4baf22fb9\",\"tool\":\"read\",\"state\":{\"status\":\"completed\",\"input\":{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\"},\"output\":\"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs, lines 1-1045\\n1: #!/usr/bin/env node\\n2: // ───────────────────────────────────────────────────────────────────\\n3: // MODULE: Shipped Instruction Check Engine\\n4: // ───────────────────────────────────────────────────────────────────\\n5: 'use strict';\\n6: \\n7: // A repository that took the shipped instruction template can be in any of seven\\n8: // states, and nothing in it says which one. Its shipped sections may be current, one\\n9: // release behind, or edited in place; its own content may sit in the marked block or be\\n10: // scattered between shipped sections; it may have no root document at all. Without that\\n11: // answer there is nothing to plan a rewrite from, and no way to tell a safe replacement\\n12: // from one that would drop a line somebody wrote. So this engine reports, per row and\\n13: // without writing a byte, what the repository holds against the manifest.\\n14: //\\n15: // Three of the twelve rows are answers this engine must not invent. The delivery budget\\n16: // and its anchors belong to the rule-copy canary, the Cursor pointer block belongs to\\n17: // the gate 1 sync, and the router belongs to the repo-rules checker. Each already has\\n18: // tests and an owner, so each is run as a child process and its own lines are carried\\n19: // into the report; re-deriving any of them here would be a second opinion that drifts\\n20: // from the first. Th...\n  Line 25: {\"type\":\"tool_use\",\"timestamp\":1794545786243,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d34399b2001C0KlFC4SUnvw31\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d34361c20011GfjvIPbsp5QIA\",\"type\":\"tool\",\"id\":\"call_4ffa1c75149d40e2a5b98d38\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"ls -la CLAUDE.md 2>&1; echo \\\"---\\\"; node .skilled/commands/doctor/scripts/agents-md-check.cjs | tail -8\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"},\"output\":\"ls: CLAUDE.md: No such file or directory\\n---\\nA7 repo-local block: block 148 bytes, 5193 bytes of headroom   (PASS)\\nA8 unmarked repo-unique content: no section outside the block   (PASS)\\nA9 unmarked local edits: no edited section   (PASS)\\nA10 runtime copies: 6/6 copies as expected   (PASS)\\nA11 REPO RULES.md: 0 shipped row(s) missing; [repo-rules-check] RESULT: PASSED (11/11 checks)   (PASS)\\n  [repo-rules-check] RESULT: PASSED (11/11 checks)\\nA12 template purity: block empty and the derived copy is fresh   (PASS)\\nSTATUS=OK rows=12 findings=0 unknown=0\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"ls: CLAUDE.md: No such file or directory\\n---\\nA7 repo-local block: block 148 bytes, 5193 bytes of headroom   (PASS)\\nA8 unmarked repo-unique content: no section outside the block   (PASS)\\nA9 unmarked local edits: no edited section   (PASS)\\nA10 runtime copies: 6/6 copies as expected   (PASS)\\nA11 REPO RULES.md: 0 shipped row(s) missing; [repo-rules-check] RESULT: PASSED (11/11 checks)   (PASS)\\n  [repo-rules-check] RESULT: PASSED (11/11 checks)\\nA12 template purity: block empty and the derived copy is fresh   (PASS)\\nSTATUS=OK rows=12 findings=0 unknown=0\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\":\\\"ls -la CLAUDE.md 2>&1; echo \\\\\\\"---\\\\\\\"; node .skilled/commands/doctor/scripts/agents-md-check.c...\n  Line 32: {\"type\":\"tool_use\",\"timestamp\":1794545805364,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d343e42d001rIYatZ30slgSzQ\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d343db8d001Hjbiux9hicJqv6\",\"type\":\"tool\",\"id\":\"call_aaf1c39528e24b7781cc169b\",\"tool\":\"edit\",\"state\":{\"status\":\"completed\",\"input\":{\"newString\":\"    if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\\n      lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\\n    }\",\"oldString\":\"    if (verdict.state === FINDING || verdict.state === UNKNOWN) {\\n      lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\\n    }\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\"},\"output\":\"Edited .skilled/commands/doctor/scripts/agents-md-check.cjs (1 replacement)\",\"title\":\"edit\",\"metadata\":{\"metadata\":{\"files\":[{\"file\":\".skilled/commands/doctor/scripts/agents-md-check.cjs\",\"patch\":\"Index: .skilled/commands/doctor/scripts/agents-md-check.cjs\\n===================================================================\\n--- .skilled/commands/doctor/scripts/agents-md-check.cjs\\n+++ .skilled/commands/doctor/scripts/agents-md-check.cjs\\n@@ -637,9 +637,9 @@\\n     const verdict = copyVerdict(expected, context, manifest, tools);\\n     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\\n     // A copy nobody could measure is printed like a finding: a pass line with no detail\\n     // reads as a copy that was checked and found right.\\n-    if (verdict.state === FINDING || verdict.state === UNKNOWN) {\\n+    if (verdict.state === FINDING || verdict.state === UNKNOWN || verdict.kind === 'pointer missing') {\\n       lines.push(`${expected.path}: ${verdict.kind} - ${verdict.detail}`);\\n     }\\n   }\\n \\n\",\"status\":\"modified\",\"additions\":1,\"deletions\":1}],\"truncated\":false},\"content\":[{\"type...\n  Line 35: {\"type\":\"tool_use\",\"timestamp\":1794545809934,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d343f307001HbBrsOg5RM33Px\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d343ee63001O2sLbih0WJYtnk\",\"type\":\"tool\",\"id\":\"call_e51365c055a6499baafe248e\",\"tool\":\"edit\",\"state\":{\"status\":\"completed\",\"input\":{\"newString\":\"  // Claude Code reaches the root document only through this file, so its absence is a route\\n  // the runtime does not have rather than a copy that is wrong.\\n  if (expected.path === 'CLAUDE.md' && !exists && context.exists) {\\n    return {\\n      state: INFO,\\n      kind: 'pointer missing',\\n      detail: 'Claude Code reads only CLAUDE.md, so without a one-line @' + manifest.root_file + ' pointer it never loads ' + manifest.root_file,\\n    };\\n  }\\n\\n  if (!exists) {\\n    return expectsAbsent\\n      ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\\n      : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\\n  }\",\"oldString\":\"  if (!exists) {\\n    return expectsAbsent\\n      ? { state: PASS, kind: 'absent', detail: 'nothing to load twice' }\\n      : { state: PASS, kind: 'absent', detail: 'absent, which the checklist allows' };\\n  }\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\"},\"output\":\"Edited .skilled/commands/doctor/scripts/agents-md-check.cjs (1 replacement)\",\"title\":\"edit\",\"metadata\":{\"metadata\":{\"files\":[{\"file\":\".skilled/commands/doctor/scripts/agents-md-check.cjs\",\"patch\":\"Index: .skilled/commands/doctor/scripts/agents-md-check.cjs\\n===================================================================\\n--- .skilled/commands/doctor/scripts/agents-md-check.cjs\\n+++ .skilled/commands/doctor/scripts/agents-md-check.cjs\\n@@ -689,8 +689,18 @@\\n       ? { state: FINDING, kind: 'mirror of an empty block', detail: 'the block is empty and a mirror exists' }\\n       : { state: PASS, kind: 'absent...\n  Line 44: {\"type\":\"tool_use\",\"timestamp\":1794545826204,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d3442ffd002Cd16VNCn9SMaGj\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d34428c7001GG1obQL8IxeASA\",\"type\":\"tool\",\"id\":\"call_fa18b10cab154ec592b519ef\",\"tool\":\"edit\",\"state\":{\"status\":\"completed\",\"input\":{\"newString\":\"// Claude Code reads only CLAUDE.md, so a tree without one leaves Claude with no route to\\n// the root document. That is a missing route, not a copy that is wrong, so the row stays a\\n// pass and the line still prints what Claude never loads.\\ntest('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\\n  const fixture = buildFixture(t, 'pure');\\n  assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\\n\\n  const report = buildReport({ root: fixture.dir });\\n  const copies = report.rows.find((row) => row.id === 'A10');\\n  const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\\n  assert.equal(claude.kind, 'pointer missing');\\n  assert.equal(claude.state, 'INFO');\\n  assert.equal(copies.state, 'PASS');\\n  assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\\n    `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\\n});\\n\\n// A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\\n// prints as a pass line with no detail and leaves the run reporting unknown=0.\\ntest('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\",\"oldString\":\"// A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\\n// prints as a pass line with no detail and leaves the run reporting unknown=0.\\ntest('an unmeasured runtime copy makes A10 UNKNOWN and is counted in unknown=', (t) => {\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/command...\n  Line 51: {\"type\":\"tool_use\",\"timestamp\":1794545842996,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d344765f001t6ixJ5VoZRmXVh\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d3446e30001jFCILNcU0KoSeu\",\"type\":\"tool\",\"id\":\"call_fc594b1af3a940c0a57d2a9e\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"TMP=$(mktemp -d); node .skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs pure \\\"$TMP/pure\\\" >/dev/null 2>&1; node .skilled/commands/doctor/scripts/agents-md-check.cjs --root \\\"$TMP/pure\\\" --json | jq '.rows[] | select(.id==\\\"A10\\\")'; rm -rf \\\"$TMP\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"},\"output\":\"{\\n  \\\"id\\\": \\\"A10\\\",\\n  \\\"name\\\": \\\"runtime copies\\\",\\n  \\\"state\\\": \\\"FINDING\\\",\\n  \\\"detail\\\": \\\"5/6 copies as expected\\\",\\n  \\\"lines\\\": [\\n    \\\"CLAUDE.md: pointer missing - Claude Code reads only CLAUDE.md, so without a one-line @AGENTS.md pointer it never loads AGENTS.md\\\",\\n    \\\".cursor/rules/skill-routing.md: gate1 block out of sync - [gate1-pointer-sync] Drift detected:; [gate1-pointer-sync] .cursor/rules/skill-routing.md: no Gate 2 command block\\\"\\n  ],\\n 