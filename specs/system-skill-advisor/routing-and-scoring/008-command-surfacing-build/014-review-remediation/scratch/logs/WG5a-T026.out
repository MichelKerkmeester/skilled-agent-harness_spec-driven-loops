.md, so a tree without one leaves Claude with no route to\\n472: // the root document. That is a missing route, not a copy that is wrong, so the row stays a\\n473: // pass and the line still prints what Claude never loads.\\n474: test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\\n475:   const fixture = buildFixture(t, 'pure');\\n476:   assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\\n477: \\n478:   const report = buildReport({ root: fixture.dir });\\n479:   const copies = report.rows.find((row) => row.id === 'A10');\\n480:   const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\\n481:   assert.equal(claude.kind, 'pointer missing');\\n482:   assert.equal(claude.state, 'INFO');\\n483:   assert.equal(copies.state, 'PASS');\\n484:   assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\\n485:     `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\\n486: });\\n487: \\n488: // A copy whose own tool is missing was not checked. Recorded only in the JSON entries, it\\n489: // prints as a pass line with no detail and leaves the run reporting unknown=0.\\n[Output truncated. Continue re...\n  Line 84: {\"type\":\"tool_use\",\"timestamp\":1794546014537,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d3470e4b001IHErPOJjEzcIEU\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d347084000145r0mxEuhWaJ5d\",\"type\":\"tool\",\"id\":\"call_ee020f2d1475436d92f21ae0\",\"tool\":\"edit\",\"state\":{\"status\":\"completed\",\"input\":{\"newString\":\"test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\\n  const fixture = buildFixture(t, 'pure');\\n  assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\\n  const mirrors = spawnSync(process.execPath, [POINTER_SYNC, '--root', fixture.dir], { encoding: 'utf8' });\\n  assert.equal(mirrors.status, 0, `the pointer sync completes the fixture's mirrors: ${mirrors.stderr}`);\\n\\n  const report = buildReport({ root: fixture.dir });\\n  const copies = report.rows.find((row) => row.id === 'A10');\\n  const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\\n  assert.equal(claude.kind, 'pointer missing');\\n  assert.equal(claude.state, 'INFO');\\n  assert.equal(copies.state, 'PASS');\\n  assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: pointer missing')),\\n    `the missing pointer is printed, not only recorded: ${JSON.stringify(copies.lines)}`);\\n});\",\"oldString\":\"test('a pure tree with no CLAUDE.md reports a missing pointer and keeps A10 a pass', (t) => {\\n  const fixture = buildFixture(t, 'pure');\\n  assert.equal(fs.existsSync(path.join(fixture.dir, 'CLAUDE.md')), false, 'the composed template carries no CLAUDE.md');\\n\\n  const report = buildReport({ root: fixture.dir });\\n  const copies = report.rows.find((row) => row.id === 'A10');\\n  const claude = copies.entries.find((entry) => entry.path === 'CLAUDE.md');\\n  assert.equal(claude.kind, 'pointer missing');\\n  assert.equal(claude.state, 'INFO');\\n  assert.equal(copies.state, 'PASS');\\n  assert.ok(copies.lines.some((line) => line.startsWith('CLAUDE.md: ...\n  Line 90: {\"type\":\"tool_use\",\"timestamp\":1794546030595,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d347532b0016cY0Jnjd70jOQx\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d347498b001o4ZZzFurxtgH24\",\"type\":\"tool\",\"id\":\"call_05e066ec04a442768e3fd9a4\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"node .skilled/commands/doctor/scripts/agents-md-check.cjs | rg -c \\\"^STATUS=OK\\\"; echo \\\"---\\\"; node .skilled/commands/doctor/scripts/agents-md-check.cjs | rg -A3 \\\"^A10\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"},\"output\":\"1\\n---\\nA10 runtime copies: 6/6 copies as expected   (PASS)\\n  CLAUDE.md: pointer missing - Claude Code reads only CLAUDE.md, so without a one-line @AGENTS.md pointer it never loads AGENTS.md\\nA11 REPO RULES.md: 0 shipped row(s) missing; [repo-rules-check] RESULT: PASSED (11/11 checks)   (PASS)\\n  [repo-rules-check] RESULT: PASSED (11/11 checks)\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"1\\n---\\nA10 runtime copies: 6/6 copies as expected   (PASS)\\n  CLAUDE.md: pointer missing - Claude Code reads only CLAUDE.md, so without a one-line @AGENTS.md pointer it never loads AGENTS.md\\nA11 REPO RULES.md: 0 shipped row(s) missing; [repo-rules-check] RESULT: PASSED (11/11 checks)   (PASS)\\n  [repo-rules-check] RESULT: PASSED (11/11 checks)\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\":\\\"node .skilled/commands/doctor/scripts/agents-md-check.cjs | rg -c \\\\\\\"^STATUS=OK\\\\\\\"; echo \\\\\\\"---\\\\\\\"; node .skilled/commands/doctor/scripts/agents-md-check.cjs | rg -A3 \\\\\\\"^A10\\\\\\\"\\\",\\\"workdir\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\\\"}\"},\"time\":{\"start\":1794546029355,\"end\":1794546030595}}}}\n\n  Line 96: {\"type\":\"tool_use\",\"timestamp\":1794546044061,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"partID\":\"prt_1d34789fb002nlERQDYbrlC8L6\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d3477f46001g2tNHwQpirgeWO\",\"type\":\"tool\",\"id\":\"call_65a5f54238b9405cb4501eea\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/commands/doctor/scripts/agents-md-check.cjs .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"},\"output\":\"diff --git a/.skilled/commands/doctor/scripts/agents-md-check.cjs b/.skilled/commands/doctor/scripts/agents-md-check.cjs\\nindex f25a2374dd..c2e4f5f357 100644\\n--- a/.skilled/commands/doctor/scripts/agents-md-check.cjs\\n+++ b/.skilled/commands/doctor/scripts/agents-md-check.cjs\\n@@ -625,9 +625,10 @@ function rowUnmarkedEdits(context, manifest) {\\n     detail.join('; '), { lines, entries });\\n }\\n \\n-// A10. The copies each runtime loads. Claude reads the root document directly, so a full\\n-// CLAUDE.md double-loads and drifts; the Cursor rule is generated and alone carries the\\n-// gate 1 lookup to Cursor and Devin, so it is checked by its own generator.\\n+// A10. The copies each runtime loads. Claude Code reaches the root document only through\\n+// CLAUDE.md, so a missing pointer leaves Claude without it and a full copy double-loads\\n+// and drifts. The Cursor rule is generated and alone carries the gate 1 lookup to Cursor\\n+// and Devin, so it is checked by its own generator.\\n function rowRuntimeCopies(context, manifest, tools) {\\n   const entries = [];\\n   const lines = [];\\n@@ -637,7 +638,7 @@ function rowRuntimeCopies(context, manifest, tools) {\\n     entries.push({ path: expected.path, kind: verdict.kind, state: verdict.state, lines: verdict.lines || [] });\\n     // A copy nobody could measure is printed like a finding: a pass line with no detail\\n     // reads as a copy that...\n  Line 106: {\"type\":\"text\",\"timestamp\":1794546073316,\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"part\":{\"id\":\"prt_1d347f0e3002XlBnjKa1CjrebN\",\"sessionID\":\"ses_e2cbe000fffeUqJQnXGz6lLg3F\",\"messageID\":\"msg_1d347d9b60018eU0ydtDJpNQw8\",\"type\":\"text\",\"text\":\"Done. T010 is complete.\\n\\n## Files written\\n\\n**`.skilled/commands/doctor/scripts/agents-md-check.cjs`**\\n- `copyVerdict`: before the `if (!exists)` block, returns `{ state: INFO, kind: 'pointer missing', detail: 'Claude Code reads only CLAUDE.md, so without a one-line @' + manifest.root_file + ' pointer it never loads ' + manifest.root_file }` when the path is `CLAUDE.md`, it neither exists nor is a symlink, and `context.exists` is true.\\n- `rowRuntimeCopies`: also prints `${path}: ${kind} - ${detail}` when the kind is `pointer missing`. The row-state rule is untouched, so INFO still leaves A10 PASS.\\n- Rewrote the A10 comment to say Claude Code reaches the root document only through `CLAUDE.md`, so a missing pointer leaves Claude without it and a full copy double-loads and drifts.\\n\\n**`.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs`**\\n- One new case: a `pure` fixture with no `CLAUDE.md` gives the `CLAUDE.md` entry `kind` `pointer missing`, `state` `INFO`, the A10 row `state` `PASS`, and a line starting `CLAUDE.md: pointer missing`.\\n\\n## Verify output\\n\\n```\\n$ node --test .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\\nℹ tests 40\\nℹ suites 0\\nℹ pass 40\\nℹ fail 0\\n\\n$ node .skilled/commands/doctor/scripts/agents-md-check.cjs | rg -c \\\"^STATUS=OK\\\"\\n1\\n```\\n\\n`node --check` passes on both files. The diff is confined to those two files.\\n\\n## One thing worth knowing\\n\\nThe `pure` fixture alone reports A10 `FINDING`, unrelated to this change: `compose-fixture.cjs` writes only the Gate 1 mirror, while `sync-gate1-pointers.cjs --check` now also requires the Gate 2 command block. So the case runs the sync's own writer once on the temp tree (`spawnSync ... --root <fixture>`) to make the tree the...\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/013-attribution-and-install-reach/scratch/logs/w4-T026.out:\n  Line 3: {\"type\":\"tool_use\",\"timestamp\":1794546881782,\"sessionID\":\"ses_e2cad0affffeL00HGhtsGip9s0\",\"part\":{\"partID\":\"prt_1d35452d1001SZ2SAxjZyMwIFS\",\"sessio