{"type":"tool_use","timestamp":1794561550631,"sessionID":"ses_e2bccae47ffeFIXRMZ1fPQ4V4o","part":{"partID":"prt_1d43428f9001gFU6rFoxcQwRrR","sessionID":"ses_e2bccae47ffeFIXRMZ1fPQ4V4o","messageID":"msg_1d4340a10001AVf5FInJ4c1FLW","type":"tool","id":"call_aed4653fdb5746b990bf6000","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 1-181\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n8: //\n9: // WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n10: // entry a runtime fires before the model sees that prompt. A runtime folder can be\n11: // installed while its hook file is missing, its JSON is unreadable, or the entry\n12: // was never added, and then the advisor is silent with no error at session start.\n13: // This check names the runtime and the file to repair.\n14: //\n15: // Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n16: // is missing, 2 on a bad argument or a missing root.\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const USAGE = [\n30:   'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n31:   '  --root  check the checkout under <dir>.',\n32:   '  --json  print one JSON object instead of one line per runtime.',\n33: ].join('\\n');\n34: \n35: // Each entry names the runtime folder that decides whether the check applies,\n36: // the hook file inside it, the event that carries the prompt entry, and the path\n37: // fragment whose presence proves the entry is wired. A runtime folder that is\n38: // absent is skipped, because that runtime was never installed in this checkout.\n39: const RUNTIMES = [\n40:   {\n41:     id: 'claude',\n42:     dir: '.claude',\n43:     file: '.claude/settings.json',\n44:     event: 'UserPromptSubmit',\n45:     marker: 'hooks/claude/user-prompt-submit.js',\n46:   },\n47:   {\n48:     id: 'codex',\n49:     dir: '.codex',\n50:     file: '.codex/hooks.json',\n51:     event: 'UserPromptSubmit',\n52:     marker: 'hooks/codex/user-prompt-submit.js',\n53:   },\n54:   {\n55:     id: 'cursor',\n56:     dir: '.cursor',\n57:     file: '.cursor/hooks.json',\n58:     event: 'beforeSubmitPrompt',\n59:     marker: 'hooks/cursor/user-prompt-submit.js',\n60:   },\n61:   {\n62:     id: 'devin',\n63:     dir: '.devin',\n64:     file: '.devin/hooks.v1.json',\n65:     event: 'UserPromptSubmit',\n66:     marker: 'hooks/devin/user-prompt-submit.js',\n67:   },\n68: ];\n69: \n70: // ─────────────────────────────────────────────────────────────────────────────\n71: // 3. HELPERS\n72: // ─────────────────────────────────────────────────────────────────────────────\n73: \n74: function fail(message) {\n75:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n76:   process.exit(2);\n77: }\n78: \n79: function parseArgs(argv) {\n80:   const opts = { root: null, json: false };\n81:   for (let i = 0; i < argv.length; i += 1) {\n82:     const arg = argv[i];\n83:     if (arg === '--json') {\n84:       opts.json = true;\n85:     } else if (arg === '--root') {\n86:       const value = argv[i + 1];\n87:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n88:       opts.root = path.resolve(value);\n89:       i += 1;\n90:     } else {\n91:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n92:     }\n93:   }\n94:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n95:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n96:     fail(`root not found: ${opts.root}`);\n97:   }\n98:   return opts;\n99: }\n100: \n101: // Hook files either wrap their events in a `hooks` object or place them at the\n102: // top level, and the cursor file omits the nested hook array the others carry.\n103: // A mention is not a wired hook, so only a command that runs the script counts:\n104: // the event's entries and their nested hooks arrays are walked for command\n105: // entries, and a runtime is wired when one starts node on the marker path.\n106: function eventPayload(document, event) {\n107:   if (!document || typeof document !== 'object') return undefined;\n108:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n109:     return document.hooks[event];\n110:   }\n111:   if (event in document) return document[event];\n112:   return undefined;\n113: }\n114: \n115: function stripQuotes(token) {\n116:   return token.replace(/^['\"]+|['\"]+$/g, '');\n117: }\n118: \n119: function collectCommands(node, commands) {\n120:   if (Array.isArray(node)) {\n121:     for (const entry of node) collectCommands(entry, commands);\n122:   } else if (node && typeof node === 'object') {\n123:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n124:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n125:   }\n126:   return commands;\n127: }\n128: \n129: function runsMarker(command, marker) {\n130:   const tokens = command.split(/\\s+/).map(stripQuotes);\n131:   return tokens.some((token, index) => token === 'node' && (tokens[index + 1] || '').endsWith(marker));\n132: }\n133: \n134: function inspect(runtime, root) {\n135:   const file = path.join(root, runtime.file);\n136:   let document;\n137:   try {\n138:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n139:   } catch {\n140:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n141:   }\n142:   const payload = eventPayload(document, runtime.event);\n143:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n144:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n145: }\n146: \n147: // ─────────────────────────────────────────────────────────────────────────────\n148: // 4. MAIN\n149: // ─────────────────────────────────────────────────────────────────────────────\n150: \n151: function main(argv) {\n152:   const opts = parseArgs(argv);\n153:   const checks = RUNTIMES.map((runtime) => {\n154:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n155:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n156:     }\n157:     return inspect(runtime, opts.root);\n158:   });\n159: \n160:   if (opts.json) {\n161:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n162:   } else {\n163:     for (const check of checks) {\n164:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n165:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n166:     }\n167:   }\n168: \n169:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n170: }\n171: \n172: if (require.main === module) {\n173:   try {\n174:     process.exitCode = main(process.argv.slice(2));\n175:   } catch (err) {\n176:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n177:     process.exitCode = 2;\n178:   }\n179: }\n180: \n181: module.exports = { main, eventPayload };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 1-181\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n8: //\n9: // WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n10: // entry a runtime fires before the model sees that prompt. A runtime folder can be\n11: // installed while its hook file is missing, its JSON is unreadable, or the entry\n12: // was never added, and then the advisor is silent with no error at session start.\n13: // This check names the runtime and the file to repair.\n14: //\n15: // Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n16: // is missing, 2 on a bad argument or a missing root.\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const USAGE = [\n30:   'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n31:   '  --root  check the checkout under <dir>.',\n32:   '  --json  print one JSON object instead of one line per runtime.',\n33: ].join('\\n');\n34: \n35: // Each entry names the runtime folder that decides whether the check applies,\n36: // the hook file inside it, the event that carries the prompt entry, and the path\n37: // fragment whose presence proves the entry is wired. A runtime folder that is\n38: // absent is skipped, because that runtime was never installed in this checkout.\n39: const RUNTIMES = [\n40:   {\n41:     id: 'claude',\n42:     dir: '.claude',\n43:     file: '.claude/settings.json',\n44:     event: 'UserPromptSubmit',\n45:     marker: 'hooks/claude/user-prompt-submit.js',\n46:   },\n47:   {\n48:     id: 'codex',\n49:     dir: '.codex',\n50:     file: '.codex/hooks.json',\n51:     event: 'UserPromptSubmit',\n52:     marker: 'hooks/codex/user-prompt-submit.js',\n53:   },\n54:   {\n55:     id: 'cursor',\n56:     dir: '.cursor',\n57:     file: '.cursor/hooks.json',\n58:     event: 'beforeSubmitPrompt',\n59:     marker: 'hooks/cursor/user-prompt-submit.js',\n60:   },\n61:   {\n62:     id: 'devin',\n63:     dir: '.devin',\n64:     file: '.devin/hooks.v1.json',\n65:     event: 'UserPromptSubmit',\n66:     marker: 'hooks/devin/user-prompt-submit.js',\n67:   },\n68: ];\n69: \n70: // ─────────────────────────────────────────────────────────────────────────────\n71: // 3. HELPERS\n72: // ─────────────────────────────────────────────────────────────────────────────\n73: \n74: function fail(message) {\n75:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n76:   process.exit(2);\n77: }\n78: \n79: function parseArgs(argv) {\n80:   const opts = { root: null, json: false };\n81:   for (let i = 0; i < argv.length; i += 1) {\n82:     const arg = argv[i];\n83:     if (arg === '--json') {\n84:       opts.json = true;\n85:     } else if (arg === '--root') {\n86:       const value = argv[i + 1];\n87:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n88:       opts.root = path.resolve(value);\n89:       i += 1;\n90:     } else {\n91:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n92:     }\n93:   }\n94:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n95:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n96:     fail(`root not found: ${opts.root}`);\n97:   }\n98:   return opts;\n99: }\n100: \n101: // Hook files either wrap their events in a `hooks` object or place them at the\n102: // top level, and the cursor file omits the nested hook array the others carry.\n103: // A mention is not a wired hook, so only a command that runs the script counts:\n104: // the event's entries and their nested hooks arrays are walked for command\n105: // entries, and a runtime is wired when one starts node on the marker path.\n106: function eventPayload(document, event) {\n107:   if (!document || typeof document !== 'object') return undefined;\n108:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n109:     return document.hooks[event];\n110:   }\n111:   if (event in document) return document[event];\n112:   return undefined;\n113: }\n114: \n115: function stripQuotes(token) {\n116:   return token.replace(/^['\"]+|['\"]+$/g, '');\n117: }\n118: \n119: function collectCommands(node, commands) {\n120:   if (Array.isArray(node)) {\n121:     for (const entry of node) collectCommands(entry, commands);\n122:   } else if (node && typeof node === 'object') {\n123:     if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n124:     if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n125:   }\n126:   return commands;\n127: }\n128: \n129: function runsMarker(command, marker) {\n130:   const tokens = command.split(/\\s+/).map(stripQuotes);\n131:   return tokens.some((token, index) => token === 'node' && (tokens[index + 1] || '').endsWith(marker));\n132: }\n133: \n134: function inspect(runtime, root) {\n135:   const file = path.join(root, runtime.file);\n136:   let document;\n137:   try {\n138:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n139:   } catch {\n140:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n141:   }\n142:   const payload = eventPayload(document, runtime.event);\n143:   const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n144:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n145: }\n146: \n147: // ─────────────────────────────────────────────────────────────────────────────\n148: // 4. MAIN\n149: // ─────────────────────────────────────────────────────────────────────────────\n150: \n151: function main(argv) {\n152:   const opts = parseArgs(argv);\n153:   const checks = RUNTIMES.map((runtime) => {\n154:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n155:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n156:     }\n157:     return inspect(runtime, opts.root);\n158:   });\n159: \n160:   if (opts.json) {\n161:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n162:   } else {\n163:     for (const check of checks) {\n164:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n165:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n166:     }\n167:   }\n168: \n169:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n170: }\n171: \n172: if (require.main === module) {\n173:   try {\n174:     process.exitCode = main(process.argv.slice(2));\n175:   } catch (err) {\n176:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n177:     process.exitCode = 2;\n178:   }\n179: }\n180: \n181: module.exports = { main, eventPayload };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794561550585,"