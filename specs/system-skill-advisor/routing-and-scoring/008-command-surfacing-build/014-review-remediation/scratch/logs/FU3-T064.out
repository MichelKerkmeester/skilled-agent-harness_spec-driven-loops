{"type":"tool_use","timestamp":1794561563329,"sessionID":"ses_e2bccae47ffeFIXRMZ1fPQ4V4o","part":{"partID":"prt_1d4345aa4002D1dnKWXWPjjJ94","sessionID":"ses_e2bccae47ffeFIXRMZ1fPQ4V4o","messageID":"msg_1d434405d0015FKiG90Ika1uH0","type":"tool","id":"call_bd9288b28440459f912d5572","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-107\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: \n25: function fixture(t) {\n26:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n27:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n28:   const run = (...args) => {\n29:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n30:     return { code: result.status, out: result.stdout, err: result.stderr };\n31:   };\n32:   return { root, run };\n33: }\n34: \n35: function writeClaudeSettings(root, hooks) {\n36:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n37:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n38: }\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 2. TESTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: test('names a runtime whose prompt entry is absent', (t) => {\n45:   const f = fixture(t);\n46:   writeClaudeSettings(f.root, {\n47:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n48:   });\n49:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n50:   const result = f.run();\n51:   assert.equal(result.code, 1);\n52:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n53:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n54: });\n55: \n56: test('passes a runtime whose prompt entry is wired', (t) => {\n57:   const f = fixture(t);\n58:   writeClaudeSettings(f.root, {\n59:     UserPromptSubmit: [{\n60:       hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n61:     }],\n62:   });\n63:   const text = f.run();\n64:   assert.equal(text.code, 0);\n65:   assert.equal(text.out.trim(), 'ok claude');\n66:   const json = f.run('--json');\n67:   assert.equal(json.code, 0);\n68:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n69: });\n70: \n71: test('names a runtime whose entry only echoes the script path', (t) => {\n72:   const f = fixture(t);\n73:   writeClaudeSettings(f.root, {\n74:     UserPromptSubmit: [{\n75:       hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n76:     }],\n77:   });\n78:   const result = f.run();\n79:   assert.equal(result.code, 1);\n80:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n81: });\n82: \n83: test('names a runtime whose entry only describes the script', (t) => {\n84:   const f = fixture(t);\n85:   writeClaudeSettings(f.root, {\n86:     UserPromptSubmit: [{\n87:       hooks: [{\n88:         type: 'command',\n89:         command: 'node some-other-hook.js',\n90:         description: 'hooks/claude/user-prompt-submit.js',\n91:       }],\n92:     }],\n93:   });\n94:   const result = f.run();\n95:   assert.equal(result.code, 1);\n96:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n97: });\n98: \n99: test('skips a runtime whose folder is absent', (t) => {\n100:   const f = fixture(t);\n101:   const text = f.run();\n102:   assert.equal(text.code, 0);\n103:   assert.equal(text.out, '');\n104:   const json = f.run('--json');\n105:   assert.equal(json.code, 0);\n106:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n107: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-107\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: \n25: function fixture(t) {\n26:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n27:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n28:   const run = (...args) => {\n29:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n30:     return { code: result.status, out: result.stdout, err: result.stderr };\n31:   };\n32:   return { root, run };\n33: }\n34: \n35: function writeClaudeSettings(root, hooks) {\n36:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n37:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n38: }\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 2. TESTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: test('names a runtime whose prompt entry is absent', (t) => {\n45:   const f = fixture(t);\n46:   writeClaudeSettings(f.root, {\n47:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n48:   });\n49:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n50:   const result = f.run();\n51:   assert.equal(result.code, 1);\n52:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n53:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n54: });\n55: \n56: test('passes a runtime whose prompt entry is wired', (t) => {\n57:   const f = fixture(t);\n58:   writeClaudeSettings(f.root, {\n59:     UserPromptSubmit: [{\n60:       hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n61:     }],\n62:   });\n63:   const text = f.run();\n64:   assert.equal(text.code, 0);\n65:   assert.equal(text.out.trim(), 'ok claude');\n66:   const json = f.run('--json');\n67:   assert.equal(json.code, 0);\n68:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n69: });\n70: \n71: test('names a runtime whose entry only echoes the script path', (t) => {\n72:   const f = fixture(t);\n73:   writeClaudeSettings(f.root, {\n74:     UserPromptSubmit: [{\n75:       hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n76:     }],\n77:   });\n78:   const result = f.run();\n79:   assert.equal(result.code, 1);\n80:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n81: });\n82: \n83: test('names a runtime whose entry only describes the script', (t) => {\n84:   const f = fixture(t);\n85:   writeClaudeSettings(f.root, {\n86:     UserPromptSubmit: [{\n87:       hooks: [{\n88:         type: 'command',\n89:         command: 'node some-other-hook.js',\n90:         description: 'hooks/claude/user-prompt-submit.js',\n91:       }],\n92:     }],\n93:   });\n94:   const result = f.run();\n95:   assert.equal(result.code, 1);\n96:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n97: });\n98: \n99: test('skips a runtime whose folder is absent', (t) => {\n100:   const f = fixture(t);\n101:   const text = f.run();\n102:   assert.equal(text.code, 0);\n103:   assert.equal(text.out, '');\n104:   const json = f.run('--json');\n105:   assert.equal(json.code, 0);\n106:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n107: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\"}"},"time":{"start":1794561563300,"end":1794561563329}}}}
