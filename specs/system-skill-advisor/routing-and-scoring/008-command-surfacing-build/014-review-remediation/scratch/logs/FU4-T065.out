{"type":"tool_use","timestamp":1794561901809,"sessionID":"ses_e2bccb12cffeMW9EBW6csHr3DM","part":{"partID":"prt_1d43981d6001LJ8XgIeH5XjPcX","sessionID":"ses_e2bccb12cffeMW9EBW6csHr3DM","messageID":"msg_1d4396ec2001xidu8TS2yWgSEK","type":"tool","id":"call_7bb294697b5246ad8a8f5569","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/commands/doctor/scripts/agents-md-embed.cjs .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/commands/doctor/scripts/agents-md-embed.cjs b/.skilled/commands/doctor/scripts/agents-md-embed.cjs\nindex 611b28dd37..cea173292f 100644\n--- a/.skilled/commands/doctor/scripts/agents-md-embed.cjs\n+++ b/.skilled/commands/doctor/scripts/agents-md-embed.cjs\n@@ -34,7 +34,8 @@\n //\n // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n-//             2 a precondition failed or a path fell outside the allowlist\n+//             2 a precondition failed or a path fell outside the allowlist,\n+//             3 a write failed after the backup, and the run was undone or the restore said why not\n \n // ─────────────────────────────────────────────────────────────────────────────\n // 1. IMPORTS\n@@ -115,9 +116,15 @@ const USAGE = [\n   '  --dry-run                  print the plan and write nothing',\n   '  --yes                      take the restore confirmation as given',\n   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n-  '            2 a precondition failed or a path fell outside the allowlist',\n+  '            2 a precondition failed or a path fell outside the allowlist,',\n+  '            3 a write failed after the backup, and the run was undone or the restore said why not',\n ].join('\\n');\n \n+// A write that throws partway through is neither a run that wrote nothing nor a finished\n+// run, because the targets before it already hold bytes and the failed one may hold a\n+// partial one. The backup exists by then, so the failure restores it and ends on an exit\n+// of its own rather than borrowing one the usage already spends on another meaning.\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 3. ERRORS\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -648,7 +655,8 @@ function compose({ root, manifest, keepClaudeMd = false, createRouter = false })\n   const claudePointer = `@${manifest.root_file}\\n`;\n   const rootPath = path.join(root, rootFile);\n   // Writing through a link would change a file this repository does not own, and the backup\n-  // could not put the link back.\n+  // could not put the link back. The root document, the router and the Cursor mirror are the\n+  // three paths a run may write, and each is refused when it is a link.\n   if (isSymlink(rootPath)) {\n     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n   }\n@@ -813,6 +821,17 @@ function compose({ root, manifest, keepClaudeMd = false, createRouter = false })\n   } else if (mirrorExists) {\n     mirrorAction = 'remove';\n   }\n+  // The router and the mirror are both decided by now, so the same refusal covers the two\n+  // paths the root-document check above could not see yet.\n+  for (const target of [\n+    { path: manifest.router_file, action: routerAction },\n+    { path: MIRROR_FILE, action: mirrorAction },\n+  ]) {\n+    if (!['create', 'replace', 'remove'].includes(target.action)) continue;\n+    const absolute = path.join(root, target.path);\n+    if (!isSymlink(absolute)) continue;\n+    throw new PreconditionError(`${target.path} is a symlink to ${fs.readlinkSync(absolute)}, and writing through it would change the file it points at`);\n+  }\n   if (mirrorAction !== 'unchanged') {\n     files.push({\n       path: MIRROR_FILE,\n@@ -1236,6 +1255,10 @@ function renderDropped(dropped) {\n   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n }\n \n+function renderForeign(foreign) {\n+  return foreign.map((entry) => `foreign: ${entry.line} (outside the block and not a shipped line)`);\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 15. PLAN\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -1260,9 +1283,15 @@ function commandPlan(options, output, hooks) {\n \n   const plan = planFor(composition);\n   for (const line of renderPlan(composition, plan)) output.log(line);\n-  if (checked.dropped.length > 0) {\n+  if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n     for (const line of renderDropped(checked.dropped)) output.warn(line);\n-    output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n+    for (const line of renderForeign(checked.foreign)) output.warn(line);\n+    if (checked.dropped.length > 0) {\n+      output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n+    }\n+    if (checked.foreign.length > 0) {\n+      output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries, so it will not be offered for writing`);\n+    }\n     output.warn('STATUS=FAIL');\n     return 1;\n   }\n@@ -1283,6 +1312,18 @@ function runTool(script, args) {\n \n function restoreFromBackup({ root, dir, output }) {\n   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n+  // A rollback that put a damaged copy back would replace the fault it exists to undo with\n+  // one the run never made, so every entry is proved against the hash recorded beside it\n+  // before the first path moves.\n+  for (const entry of record.paths) {\n+    assertWritable(root, entry.path);\n+    if (!entry.existed) continue;\n+    const source = path.join(dir, entry.backup);\n+    if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n+      output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n+      return null;\n+    }\n+  }\n   let restored = 0;\n   const deleted = new Set();\n   for (const entry of record.paths) {\n@@ -1338,9 +1379,15 @@ function commandApply(options, output, hooks) {\n   // never reach a backup, let alone the tree.\n   const checked = preflight(composition, manifest);\n   composition.ledger.dropped = checked.dropped.length;\n-  if (checked.dropped.length > 0) {\n+  if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n     for (const line of renderDropped(checked.dropped)) output.warn(line);\n-    output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n+    for (const line of renderForeign(checked.foreign)) output.warn(line);\n+    if (checked.dropped.length > 0) {\n+      output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n+    }\n+    if (checked.foreign.length > 0) {\n+      output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries; nothing was written`);\n+    }\n     output.warn('STATUS=FAIL');\n     return 1;\n   }\n@@ -1362,15 +1409,34 @@ function commandApply(options, output, hooks) {\n   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n \n   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n-  for (const target of targets) {\n-    if (target.file.action === 'remove') {\n-      if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n-      output.log(`removed ${target.file.path} (backed up first)`);\n-      continue;\n+  let writing = null;\n+  try {\n+    for (const target of targets) {\n+      writing = target.file.path;\n+      if (target.file.action === 'remove') {\n+        if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n+        output.log(`removed ${target.file.path} (backed up first)`);\n+        continue;\n+      }\n+      fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n+      write(target.absolute, target.file.content);\n+      output.log(`wrote ${target.file.path}`);\n     }\n-    fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n-    write(target.absolute, target.file.content);\n-    output.log(`wrote ${target.file.path}`);\n+  } catch (error) {\n+    // The backup is the only copy of every target as the plan found it, so a throw here is\n+    // undone from it rather than reported as a run that never started.\n+    output.warn(`${TAG} ERROR: writing ${writing} failed: ${error.message}`);\n+    // The backup and undo lines are the operator's only way back once the restore itself\n+    // fails, so a second fault must not swallow them.\n+    try {\n+      restoreFromBackup({ root: options.root, dir: plan.dir, output });\n+    } catch (restoreError) {\n+      output.warn(`${TAG} ERROR: the restore failed: ${restoreError.message}`);\n+    }\n+    output.log(`backup: ${plan.dir}`);\n+    output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n+    output.warn('STATUS=FAIL');\n+    return 3;\n   }\n \n   // The pointer block belongs to its generator, and the router verdict to its checker.\n@@ -1392,10 +1458,25 @@ function commandApply(options, output, hooks) {\n   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n \n-  if (after.dropped.length > 0) {\n+  if (after.dropped.length > 0 || after.foreign.length > 0) {\n     for (const line of renderDropped(after.dropped)) output.warn(line);\n-    restoreFromBackup({ root: options.root, dir: plan.dir, output });\n-    output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n+    for (const line of renderForeign(after.foreign)) output.warn(line);\n+    const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n+    if (restored === null) {\n+      if (after.dropped.length > 0) {\n+        output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n+      }\n+      if (after.foreign.length > 0) {\n+        output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries and the backup could not be restored, so the tree is as the write left it`);\n+      }\n+    } else {\n+      if (after.dropped.length > 0) {\n+        output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n+      }\n+      if (after.foreign.length > 0) {\n+        output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries, so the run was undone; the backup is kept at ${plan.dir}`);\n+      }\n+    }\n     output.warn('STATUS=FAIL');\n     return 1;\n   }\ndiff --git a/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs b/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\nindex ae9439a2f6..8753a98d7a 100644\n--- a/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n@@ -612,6 +612,177 @@ test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n });\n \n+// A line the write leaves outside the block, one no shipped section carries, is a byte the\n+// template never put there. The proof has to read it as a violation and undo the run,\n+// because a document that keeps it says the write changed something the plan never showed.\n+test('a planted foreign line restores the backup and ends STATUS=FAIL', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  const original = readInside(dir, manifest.root_file);\n+  const planted = 'A line no template ships.';\n+  const out = [];\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n+      const text = bytes.toString('utf8');\n+      const written = file.endsWith(manifest.root_file) ? `${planted}\\n${text}` : text;\n+      fs.writeFileSync(file, written, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n+  const planned = out.join('\\n');\n+  const backup = field(planned, 'backup');\n+  assert.ok(backup, 'the plan prints the backup location');\n+  trackBackup(t, planned);\n+  const digest = field(planned, 'plan-digest');\n+  assert.match(digest || '', /^[0-9a-f]{64}$/u);\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n+  const text = out.join('\\n');\n+\n+  assert.equal(code, 1, `a foreign line is a failed run\\n${text}`);\n+  assert.match(text, /^foreign: A line no template ships\\. \\(outside the block and not a shipped line\\)$/mu);\n+  assert.match(text, /STATUS=FAIL/u);\n+  assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n+});\n+\n+// A backup that no longer matches the hash the run recorded is the one thing a restore must\n+// refuse: copying it over the tree would replace the fault it exists to undo with a worse\n+// one. The write hook damages the copy first, so the post-write proof has to stop before\n+// the first file goes back and leave the tree as the failed write left it.\n+test('a damaged backup copy stops the restore and leaves the tree as the write left it', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  const damaged = 'a backup copy the run did not record\\n';\n+  const out = [];\n+  let backup = null;\n+  let first = true;\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      if (first) {\n+        first = false;\n+        fs.writeFileSync(path.join(backup, 'files', manifest.root_file), damaged, 'utf8');\n+      }\n+      const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n+      const text = bytes.toString('utf8');\n+      const written = file.endsWith(manifest.root_file)\n+        ? text.replace('- Never commit a generated file.\\n', '')\n+        : text;\n+      fs.writeFileSync(file, written, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n+  const planned = out.join('\\n');\n+  backup = field(planned, 'backup');\n+  assert.ok(backup, 'the plan prints the backup location');\n+  trackBackup(t, planned);\n+  const digest = field(planned, 'plan-digest');\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n+  const text = out.join('\\n');\n+\n+  assert.equal(code, 1, 'a failed restore is still a failed run');\n+  assert.ok(\n+    text.includes(`ERROR: the backup copy of ${manifest.root_file} does not match its recorded hash, so nothing was restored. The backup is kept at ${backup}`),\n+    `the mismatch is named with the backup it kept\\n${text}`,\n+  );\n+  assert.match(text, /the write dropped 1 line\\(s\\) and the backup could not be restored, so the tree is as the write left it/u);\n+  assert.ok(!readInside(dir, manifest.root_file).includes(damaged.trim()), 'the damaged backup copy was not written over the tree');\n+});\n+\n+// A writer that throws partway through is neither a run that wrote nothing nor one that\n+// finished: the targets before it already hold bytes, and the failed target may hold a\n+// partial one. The backup exists by then, so the only ending that keeps the tree truthful\n+// is to put it back, name the backup, and report the failure on an exit of its own.\n+test('a write that throws mid-apply restores the backup and exits 3', (t) => {\n+  const dir = composeTree(t, 'claude-only');\n+  const before = treeDigest(dir);\n+  const out = [];\n+  let calls = 0;\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      calls += 1;\n+      if (calls === 2) {\n+        const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n+        error.code = 'EACCES';\n+        throw error;\n+      }\n+      fs.writeFileSync(file, content, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n+  const digest = field(out.join('\\n'), 'plan-digest');\n+  assert.match(digest || '', /^[0-9a-f]{64}$/u);\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n+  const text = out.join('\\n');\n+  trackBackup(t, text);\n+\n+  assert.equal(calls, 2, 'the second write is the one that throws');\n+  assert.equal(code, 3, `a write that throws after the backup is undone\\n${text}`);\n+  assert.match(text, /EACCES/u, 'the failure names the write it could not make');\n+  assert.match(text, /restored:/u);\n+  assert.match(text, /^backup:/mu);\n+  assert.match(text, /^undo:/mu);\n+  assert.match(text, /STATUS=FAIL/u);\n+  assert.equal(treeDigest(dir), before, 'the tree is byte for byte what it was before the apply');\n+});\n+\n+// The backup and undo lines are the operator's only way back once the restore itself fails,\n+// so a second fault in the undo must not escape the run and leave them unsaid. The write\n+// hook damages the record the restore reads, so the undo throws before it can put a file back.\n+test('a restore that throws is reported with the backup and undo lines and exits 3', (t) => {\n+  const dir = composeTree(t, 'claude-only');\n+  const out = [];\n+  let backup = null;\n+  let calls = 0;\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      calls += 1;\n+      if (calls === 2) {\n+        fs.writeFileSync(path.join(backup, 'manifest.json'), 'not json', 'utf8');\n+        const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n+        error.code = 'EACCES';\n+        throw error;\n+      }\n+      fs.writeFileSync(file, content, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n+  const planned = out.join('\\n');\n+  backup = field(planned, 'backup');\n+  assert.ok(backup, 'the plan prints the backup location');\n+  trackBackup(t, planned);\n+  const digest = field(planned, 'plan-digest');\n+  assert.match(digest || '', /^[0-9a-f]{64}$/u);\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n+  const text = out.join('\\n');\n+\n+  assert.equal(calls, 2, 'the second write is the one that throws');\n+  assert.equal(code, 3, `a failed restore does not escape the run\\n${text}`);\n+  assert.match(text, /ERROR: writing/u, 'the failure names the write it could not make');\n+  assert.match(text, /ERROR: the restore failed: /u, 'the undo failure is named');\n+  assert.match(text, /^backup:/mu);\n+  assert.match(text, /^undo:/mu);\n+  assert.match(text, /STATUS=FAIL/u);\n+  assert.doesNotMatch(text, /restored:/u, 'nothing was restored, so nothing claims it was');\n+});\n+\n test('restore puts every recorded file back byte for byte', (t) => {\n   const dir = composeTree(t, 'foreign');\n   const before = treeDigest(dir);\n@@ -769,6 +940,52 @@ test('a symlinked root document is refused', (t) => {\n   assert.equal(fs.readFileSync(target, 'utf8'), shared, 'the linked file is untouched');\n });\n \n+// The mirror is a write target too, so a link at its path is the same hazard as one at the\n+// root document: the write would land on a file this repository does not own.\n+test('a symlinked Cursor mirror is refused and its target is untouched', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  const ci = path.join(dir, '.github/ci.yml');\n+  const ciText = 'name: ci\\non: push\\n';\n+  fs.mkdirSync(path.dirname(ci), { recursive: true });\n+  fs.writeFileSync(ci, ciText, 'utf8');\n+  fs.mkdirSync(path.join(dir, '.cursor/rules'), { recursive: true });\n+  fs.symlinkSync('../../.github/ci.yml', path.join(dir, '.cursor/rules/repo-local.md'));\n+\n+  const refused = plan(dir);\n+  assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n+  assert.match(refused.err, /\\.cursor\\/rules\\/repo-local\\.md is a symlink/u, 'the refusal names the link');\n+  assert.match(refused.err, /\\.\\.\\/\\.\\.\\/\\.github\\/ci\\.yml/u, 'and the file it points at');\n+  assert.equal(fs.readFileSync(ci, 'utf8'), ciText, 'the linked CI file is untouched');\n+});\n+\n+test('a symlinked router that would gain rows is refused', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  seedRuleCorpus(dir);\n+  fs.mkdirSync(path.join(dir, 'docs'), { recursive: true });\n+  fs.writeFileSync(path.join(dir, 'docs/router.md'), partialRouter(2), 'utf8');\n+  fs.symlinkSync('docs/router.md', path.join(dir, manifest.router_file));\n+\n+  const refused = plan(dir);\n+  assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n+  assert.match(refused.err, /REPO RULES\\.md is a symlink/u, 'the refusal names the link');\n+  assert.match(refused.err, /docs\\/router\\.md/u, 'and the file it points at');\n+});\n+\n+// A link the run would leave alone is not a write, so the same tree plans as it would with a\n+// real file there: only a link the run would write through is refused.\n+test('a symlinked router the run would leave alone is not refused', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  seedRuleCorpus(dir);\n+  const count = Math.max(shippedRows().trigger_rows.length, shippedRows().index_rows.length);\n+  fs.mkdirSync(path.join(dir, 'docs'), { recursive: true });\n+  fs.writeFileSync(path.join(dir, 'docs/router.md'), partialRouter(count), 'utf8');\n+  fs.symlinkSync('docs/router.md', path.join(dir, manifest.router_file));\n+\n+  const planned = plan(dir);\n+  assert.equal(planned.code, 0, `${planned.out}${planned.err}`);\n+  assert.match(planned.out, /^target REPO RULES\\.md: unchanged$/mu);\n+});\n+\n test('.codex/AGENTS.md is folded into the block and then removed', (t) => {\n   const dir = composeTree(t, 'adopted');\n   fs.mkdirSync(path.join(dir, '.codex'), { recursive: true });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/agents-md-embed.cjs b/.skilled/commands/doctor/scripts/agents-md-embed.cjs\nindex 611b28dd37..cea173292f 100644\n--- a/.skilled/commands/doctor/scripts/agents-md-embed.cjs\n+++ b/.skilled/commands/doctor/scripts/agents-md-embed.cjs\n@@ -34,7 +34,8 @@\n //\n // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n-//             2 a precondition failed or a path fell outside the allowlist\n+//             2 a precondition failed or a path fell outside the allowlist,\n+//             3 a write failed after the backup, and the run was undone or the restore said why not\n \n // ─────────────────────────────────────────────────────────────────────────────\n // 1. IMPORTS\n@@ -115,9 +116,15 @@ const USAGE = [\n   '  --dry-run                  print the plan and write nothing',\n   '  --yes                      take the restore confirmation as given',\n   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n-  '            2 a precondition failed or a path fell outside the allowlist',\n+  '            2 a precondition failed or a path fell outside the allowlist,',\n+  '            3 a write failed after the backup, and the run was undone or the restore said why not',\n ].join('\\n');\n \n+// A write that throws partway through is neither a run that wrote nothing nor a finished\n+// run, because the targets before it already hold bytes and the failed one may hold a\n+// partial one. The backup exists by then, so the failure restores it and ends on an exit\n+// of its own rather than borrowing one the usage already spends on another meaning.\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 3. ERRORS\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -648,7 +655,8 @@ function compose({ root, manifest, keepClaudeMd = false, createRouter = false })\n   const claudePointer = `@${manifest.root_file}\\n`;\n   const rootPath = path.join(root, rootFile);\n   // Writing through a link would change a file this repository does not own, and the backup\n-  // could not put the link back.\n+  // could not put the link back. The root document, the router and the Cursor mirror are the\n+  // three paths a run may write, and each is refused when it is a link.\n   if (isSymlink(rootPath)) {\n     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n   }\n@@ -813,6 +821,17 @@ function compose({ root, manifest, keepClaudeMd = false, createRouter = false })\n   } else if (mirrorExists) {\n     mirrorAction = 'remove';\n   }\n+  // The router and the mirror are both decided by now, so the same refusal covers the two\n+  // paths the root-document check above could not see yet.\n+  for (const target of [\n+    { path: manifest.router_file, action: routerAction },\n+    { path: MIRROR_FILE, action: mirrorAction },\n+  ]) {\n+    if (!['create', 'replace', 'remove'].includes(target.action)) continue;\n+    const absolute = path.join(root, target.path);\n+    if (!isSymlink(absolute)) continue;\n+    throw new PreconditionError(`${target.path} is a symlink to ${fs.readlinkSync(absolute)}, and writing through it would change the file it points at`);\n+  }\n   if (mirrorAction !== 'unchanged') {\n     files.push({\n       path: MIRROR_FILE,\n@@ -1236,6 +1255,10 @@ function renderDropped(dropped) {\n   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n }\n \n+function renderForeign(foreign) {\n+  return foreign.map((entry) => `foreign: ${entry.line} (outside the block and not a shipped line)`);\n+}\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 15. PLAN\n // ─────────────────────────────────────────────────────────────────────────────\n@@ -1260,9 +1283,15 @@ function commandPlan(options, output, hooks) {\n \n   const plan = planFor(composition);\n   for (const line of renderPlan(composition, plan)) output.log(line);\n-  if (checked.dropped.length > 0) {\n+  if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n     for (const line of renderDropped(checked.dropped)) output.warn(line);\n-    output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n+    for (const line of renderForeign(checked.foreign)) output.warn(line);\n+    if (checked.dropped.length > 0) {\n+      output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n+    }\n+    if (checked.foreign.length > 0) {\n+      output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries, so it will not be offered for writing`);\n+    }\n     output.warn('STATUS=FAIL');\n     return 1;\n   }\n@@ -1283,6 +1312,18 @@ function runTool(script, args) {\n \n function restoreFromBackup({ root, dir, output }) {\n   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n+  // A rollback that put a damaged copy back would replace the fault it exists to undo with\n+  // one the run never made, so every entry is proved against the hash recorded beside it\n+  // before the first path moves.\n+  for (const entry of record.paths) {\n+    assertWritable(root, entry.path);\n+    if (!entry.existed) continue;\n+    const source = path.join(dir, entry.backup);\n+    if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n+      output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n+      return null;\n+    }\n+  }\n   let restored = 0;\n   const deleted = new Set();\n   for (const entry of record.paths) {\n@@ -1338,9 +1379,15 @@ function commandApply(options, output, hooks) {\n   // never reach a backup, let alone the tree.\n   const checked = preflight(composition, manifest);\n   composition.ledger.dropped = checked.dropped.length;\n-  if (checked.dropped.length > 0) {\n+  if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n     for (const line of renderDropped(checked.dropped)) output.warn(line);\n-    output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n+    for (const line of renderForeign(checked.foreign)) output.warn(line);\n+    if (checked.dropped.length > 0) {\n+      output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n+    }\n+    if (checked.foreign.length > 0) {\n+      output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries; nothing was written`);\n+    }\n     output.warn('STATUS=FAIL');\n     return 1;\n   }\n@@ -1362,15 +1409,34 @@ function commandApply(options, output, hooks) {\n   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n \n   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n-  for (const target of targets) {\n-    if (target.file.action === 'remove') {\n-      if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n-      output.log(`removed ${target.file.path} (backed up first)`);\n-      continue;\n+  let writing = null;\n+  try {\n+    for (const target of targets) {\n+      writing = target.file.path;\n+      if (target.file.action === 'remove') {\n+        if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n+        output.log(`removed ${target.file.path} (backed up first)`);\n+        continue;\n+      }\n+      fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n+      write(target.absolute, target.file.content);\n+      output.log(`wrote ${target.file.path}`);\n     }\n-    fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n-    write(target.absolute, target.file.content);\n-    output.log(`wrote ${target.file.path}`);\n+  } catch (error) {\n+    // The backup is the only copy of every target as the plan found it, so a throw here is\n+    // undone from it rather than reported as a run that never started.\n+    output.warn(`${TAG} ERROR: writing ${writing} failed: ${error.message}`);\n+    // The backup and undo lines are the operator's only way back once the restore itself\n+    // fails, so a second fault must not swallow them.\n+    try {\n+      restoreFromBackup({ root: options.root, dir: plan.dir, output });\n+    } catch (restoreError) {\n+      output.warn(`${TAG} ERROR: the restore failed: ${restoreError.message}`);\n+    }\n+    output.log(`backup: ${plan.dir}`);\n+    output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n+    output.warn('STATUS=FAIL');\n+    return 3;\n   }\n \n   // The pointer block belongs to its generator, and the router verdict to its checker.\n@@ -1392,10 +1458,25 @@ function commandApply(options, output, hooks) {\n   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n \n-  if (after.dropped.length > 0) {\n+  if (after.dropped.length > 0 || after.foreign.length > 0) {\n     for (const line of renderDropped(after.dropped)) output.warn(line);\n-    restoreFromBackup({ root: options.root, dir: plan.dir, output });\n-    output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n+    for (const line of renderForeign(after.foreign)) output.warn(line);\n+    const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n+    if (restored === null) {\n+      if (after.dropped.length > 0) {\n+        output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n+      }\n+      if (after.foreign.length > 0) {\n+        output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries and the backup could not be restored, so the tree is as the write left it`);\n+      }\n+    } else {\n+      if (after.dropped.length > 0) {\n+        output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n+      }\n+      if (after.foreign.length > 0) {\n+        output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries, so the run was undone; the backup is kept at ${plan.dir}`);\n+      }\n+    }\n     output.warn('STATUS=FAIL');\n     return 1;\n   }\ndiff --git a/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs b/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\nindex ae9439a2f6..8753a98d7a 100644\n--- a/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n@@ -612,6 +612,177 @@ test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n });\n \n+// A line the write leaves outside the block, one no shipped section carries, is a byte the\n+// template never put there. The proof has to read it as a violation and undo the run,\n+// because a document that keeps it says the write changed something the plan never showed.\n+test('a planted foreign line restores the backup and ends STATUS=FAIL', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  const original = readInside(dir, manifest.root_file);\n+  const planted = 'A line no template ships.';\n+  const out = [];\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n+      const text = bytes.toString('utf8');\n+      const written = file.endsWith(manifest.root_file) ? `${planted}\\n${text}` : text;\n+      fs.writeFileSync(file, written, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n+  const planned = out.join('\\n');\n+  const backup = field(planned, 'backup');\n+  assert.ok(backup, 'the plan prints the backup location');\n+  trackBackup(t, planned);\n+  const digest = field(planned, 'plan-digest');\n+  assert.match(digest || '', /^[0-9a-f]{64}$/u);\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n+  const text = out.join('\\n');\n+\n+  assert.equal(code, 1, `a foreign line is a failed run\\n${text}`);\n+  assert.match(text, /^foreign: A line no template ships\\. \\(outside the block and not a shipped line\\)$/mu);\n+  assert.match(text, /STATUS=FAIL/u);\n+  assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n+});\n+\n+// A backup that no longer matches the hash the run recorded is the one thing a restore must\n+// refuse: copying it over the tree would replace the fault it exists to undo with a worse\n+// one. The write hook damages the copy first, so the post-write proof has to stop before\n+// the first file goes back and leave the tree as the failed write left it.\n+test('a damaged backup copy stops the restore and leaves the tree as the write left it', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  const damaged = 'a backup copy the run did not record\\n';\n+  const out = [];\n+  let backup = null;\n+  let first = true;\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      if (first) {\n+        first = false;\n+        fs.writeFileSync(path.join(backup, 'files', manifest.root_file), damaged, 'utf8');\n+      }\n+      const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n+      const text = bytes.toString('utf8');\n+      const written = file.endsWith(manifest.root_file)\n+        ? text.replace('- Never commit a generated file.\\n', '')\n+        : text;\n+      fs.writeFileSync(file, written, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n+  const planned = out.join('\\n');\n+  backup = field(planned, 'backup');\n+  assert.ok(backup, 'the plan prints the backup location');\n+  trackBackup(t, planned);\n+  const digest = field(planned, 'plan-digest');\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n+  const text = out.join('\\n');\n+\n+  assert.equal(code, 1, 'a failed restore is still a failed run');\n+  assert.ok(\n+    text.includes(`ERROR: the backup copy of ${manifest.root_file} does not match its recorded hash, so nothing was restored. The backup is kept at ${backup}`),\n+    `the mismatch is named with the backup it kept\\n${text}`,\n+  );\n+  assert.match(text, /the write dropped 1 line\\(s\\) and the backup could not be restored, so the tree is as the write left it/u);\n+  assert.ok(!readInside(dir, manifest.root_file).includes(damaged.trim()), 'the damaged backup copy was not written over the tree');\n+});\n+\n+// A writer that throws partway through is neither a run that wrote nothing nor one that\n+// finished: the targets before it already hold bytes, and the failed target may hold a\n+// partial one. The backup exists by then, so the only ending that keeps the tree truthful\n+// is to put it back, name the backup, and report the failure on an exit of its own.\n+test('a write that throws mid-apply restores the backup and exits 3', (t) => {\n+  const dir = composeTree(t, 'claude-only');\n+  const before = treeDigest(dir);\n+  const out = [];\n+  let calls = 0;\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      calls += 1;\n+      if (calls === 2) {\n+        const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n+        error.code = 'EACCES';\n+        throw error;\n+      }\n+      fs.writeFileSync(file, content, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n+  const digest = field(out.join('\\n'), 'plan-digest');\n+  assert.match(digest || '', /^[0-9a-f]{64}$/u);\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n+  const text = out.join('\\n');\n+  trackBackup(t, text);\n+\n+  assert.equal(calls, 2, 'the second write is the one that throws');\n+  assert.equal(code, 3, `a write that throws after the backup is undone\\n${text}`);\n+  assert.match(text, /EACCES/u, 'the failure names the write it could not make');\n+  assert.match(text, /restored:/u);\n+  assert.match(text, /^backup:/mu);\n+  assert.match(text, /^undo:/mu);\n+  assert.match(text, /STATUS=FAIL/u);\n+  assert.equal(treeDigest(dir), before, 'the tree is byte for byte what it was before the apply');\n+});\n+\n+// The backup and undo lines are the operator's only way back once the restore itself fails,\n+// so a second fault in the undo must not escape the run and leave them unsaid. The write\n+// hook damages the record the restore reads, so the undo throws before it can put a file back.\n+test('a restore that throws is reported with the backup and undo lines and exits 3', (t) => {\n+  const dir = composeTree(t, 'claude-only');\n+  const out = [];\n+  let backup = null;\n+  let calls = 0;\n+  const hooks = {\n+    log: (line) => out.push(line),\n+    warn: (line) => out.push(line),\n+    write: (file, content) => {\n+      calls += 1;\n+      if (calls === 2) {\n+        fs.writeFileSync(path.join(backup, 'manifest.json'), 'not json', 'utf8');\n+        const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n+        error.code = 'EACCES';\n+        throw error;\n+      }\n+      fs.writeFileSync(file, content, 'utf8');\n+    },\n+  };\n+\n+  assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n+  const planned = out.join('\\n');\n+  backup = field(planned, 'backup');\n+  assert.ok(backup, 'the plan prints the backup location');\n+  trackBackup(t, planned);\n+  const digest = field(planned, 'plan-digest');\n+  assert.match(digest || '', /^[0-9a-f]{64}$/u);\n+  out.length = 0;\n+\n+  const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n+  const text = out.join('\\n');\n+\n+  assert.equal(calls, 2, 'the second write is the one that throws');\n+  assert.equal(code, 3, `a failed restore does not escape the run\\n${text}`);\n+  assert.match(text, /ERROR: writing/u, 'the failure names the write it could not make');\n+  assert.match(text, /ERROR: the restore failed: /u, 'the undo failure is named');\n+  assert.match(text, /^backup:/mu);\n+  assert.match(text, /^undo:/mu);\n+  assert.match(text, /STATUS=FAIL/u);\n+  assert.doesNotMatch(text, /restored:/u, 'nothing was restored, so nothing claims it was');\n+});\n+\n test('restore puts every recorded file back byte for byte', (t) => {\n   const dir = composeTree(t, 'foreign');\n   const before = treeDigest(dir);\n@@ -769,6 +940,52 @@ test('a symlinked root document is refused', (t) => {\n   assert.equal(fs.readFileSync(target, 'utf8'), shared, 'the linked file is untouched');\n });\n \n+// The mirror is a write target too, so a link at its path is the same hazard as one at the\n+// root document: the write would land on a file this repository does not own.\n+test('a symlinked Cursor mirror is refused and its target is untouched', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  const ci = path.join(dir, '.github/ci.yml');\n+  const ciText = 'name: ci\\non: push\\n';\n+  fs.mkdirSync(path.dirname(ci), { recursive: true });\n+  fs.writeFileSync(ci, ciText, 'utf8');\n+  fs.mkdirSync(path.join(dir, '.cursor/rules'), { recursive: true });\n+  fs.symlinkSync('../../.github/ci.yml', path.join(dir, '.cursor/rules/repo-local.md'));\n+\n+  const refused = plan(dir);\n+  assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n+  assert.match(refused.err, /\\.cursor\\/rules\\/repo-local\\.md is a symlink/u, 'the refusal names the link');\n+  assert.match(refused.err, /\\.\\.\\/\\.\\.\\/\\.github\\/ci\\.yml/u, 'and the file it points at');\n+  assert.equal(fs.readFileSync(ci, 'utf8'), ciText, 'the linked CI file is untouched');\n+});\n+\n+test('a symlinked router that would gain rows is refused', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  seedRuleCorpus(dir);\n+  fs.mkdirSync(path.join(dir, 'docs'), { recursive: true });\n+  fs.writeFileSync(path.join(dir, 'docs/router.md'), partialRouter(2), 'utf8');\n+  fs.symlinkSync('docs/router.md', path.join(dir, manifest.router_file));\n+\n+  const refused = plan(dir);\n+  assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n+  assert.match(refused.err, /REPO RULES\\.md is a symlink/u, 'the refusal names the link');\n+  assert.match(refused.err, /docs\\/router\\.md/u, 'and the file it points at');\n+});\n+\n+// A link the run would leave alone is not a write, so the same tree plans as it would with a\n+// real file there: only a link the run would write through is refused.\n+test('a symlinked router the run would leave alone is not refused', (t) => {\n+  const dir = composeTree(t, 'foreign');\n+  seedRuleCorpus(dir);\n+  const count = Math.max(shippedRows().trigger_rows.length, shippedRows().index_rows.length);\n+  fs.mkdirSync(path.join(dir, 'docs'), { recursive: true });\n+  fs.writeFileSync(path.join(dir, 'docs/router.md'), partialRouter(count), 'utf8');\n+  fs.symlinkSync('docs/router.md', path.join(dir, manifest.router_file));\n+\n+  const planned = plan(dir);\n+  assert.equal(planned.code, 0, `${planned.out}${planned.err}`);\n+  assert.match(planned.out, /^target REPO RULES\\.md: unchanged$/mu);\n+});\n+\n test('.codex/AGENTS.md is folded into the block and then removed', (t) => {\n   const dir = composeTree(t, 'adopted');\n   fs.mkdirSync(path.join(dir, '.codex'), { recursive: true });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/commands/doctor/scripts/agents-md-embed.cjs .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794561901014,"end":1794561901809}}}}
