 1300-1499\n1300: }\n1301: \n1302: // ─────────────────────────────────────────────────────────────────────────────\n1303: // 16. APPLY\n1304: // ─────────────────────────────────────────────────────────────────────────────\n1305: \n1306: function runTool(script, args) {\n1307:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1308:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1309:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1310:   return { code: result.status, output };\n1311: }\n1312: \n1313: function restoreFromBackup({ root, dir, output }) {\n1314:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1315:   // A rollback that put a damaged copy back would replace the fault it exists to undo with\n1316:   // one the run never made, so every entry is proved against the hash recorded beside it\n1317:   // before the first path moves.\n1318:   for (const entry of record.paths) {\n1319:     assertWritable(root, entry.path);\n1320:     if (!entry.existed) continue;\n1321:     const source = path.join(dir, entry.backup);\n1322:     if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n1323:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n1324:       return null;\n1325:     }\n1326:   }\n1327:   let restored = 0;\n1328:   const deleted = new Set();\n1329:   for (const entry of record.paths) {\n1330:     const target = path.join(root, entry.path);\n1331:     if (!entry.existed) {\n1332:       if (fs.existsSync(target)) {\n1333:         fs.rmSync(target);\n1334:         deleted.add(entry.path);\n1335:       }\n1336:       continue;\n1337:     }\n1338:     const source = path.join(dir, entry.backup);\n1339:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1340:     fs.copyFileSync(source, target);\n1341:     restored += 1;\n1342:   }\n1343:   removeCreatedDirs(root, record.paths, deleted);\n1344:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1345:   return restored;\n1346: }\n1347: \n1348: function commandApply(options, output, hooks) {\n1349:   if (!options.digest) {\n1350:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1351:     return 2;\n1352:   }\n1353: \n1354:   const manifest = loadManifest();\n1355:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1356: \n1357:   // A tree already in its target state has nothing a digest could authorise.\n1358:   if (composition.writes.length === 0) {\n1359:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1360:     output.log('NOTHING TO DO');\n1361:     return 0;\n1362:   }\n1363: \n1364:   const plan = planFor(composition);\n1365:   if (plan.digest !== options.digest) {\n1366:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1367:     // already happened gets told which directory holds those bytes instead of a claim\n1368:     // about the tree that would be false.\n1369:     const held = backupDirectoryOf(plan.base, options.digest);\n1370:     if (fs.existsSync(held)) {\n1371:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1372:       return 2;\n1373:     }\n1374:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1375:     return 2;\n1376:   }\n1377: \n1378:   // The same proof the plan ran, because a composition that already loses a line must\n1379:   // never reach a backup, let alone the tree.\n1380:   const checked = preflight(composition, manifest);\n1381:   composition.ledger.dropped = checked.dropped.length;\n1382:   if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n1383:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1384:     for (const line of renderForeign(checked.foreign)) output.warn(line);\n1385:     if (checked.dropped.length > 0) {\n1386:       output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1387:     }\n1388:     if (checked.foreign.length > 0) {\n1389:       output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries; nothing was written`);\n1390:     }\n1391:     output.warn('STATUS=FAIL');\n1392:     return 1;\n1393:   }\n1394: \n1395:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1396:   // the run before a backup exists rather than after a partial write.\n1397:   const targets = [];\n1398:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1399: \n1400:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1401:   // here, where every precondition has already passed and nothing has been created.\n1402:   if (options.dryRun) {\n1403:     for (const line of renderPlan(composition, plan)) output.log(line);\n1404:     output.log('dry-run: nothing was written');\n1405:     return 0;\n1406:   }\n1407: \n1408:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1409:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1410: \n1411:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1412:   let w