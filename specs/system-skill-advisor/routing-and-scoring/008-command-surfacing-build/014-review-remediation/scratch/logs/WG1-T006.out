121:     }\n1122:   }\n1123:   const ops = [];\n1124:   let i = 0;\n1125:   let j = 0;\n1126:   while (i < left.length && j < right.length) {\n1127:     if (left[i] === right[j]) {\n1128:       ops.push({ kind: ' ', text: left[i] });\n1129:       i += 1;\n1130:       j += 1;\n1131:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1132:       ops.push({ kind: '-', text: left[i] });\n1133:       i += 1;\n1134:     } else {\n1135:       ops.push({ kind: '+', text: right[j] });\n1136:       j += 1;\n1137:     }\n1138:   }\n1139:   while (i < left.length) {\n1140:     ops.push({ kind: '-', text: left[i] });\n1141:     i += 1;\n1142:   }\n1143:   while (j < right.length) {\n1144:     ops.push({ kind: '+', text: right[j] });\n1145:     j += 1;\n1146:   }\n1147:   return ops;\n1148: }\n1149: \n1150: /**\n1151:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1152:  *\n1153:  * @param {string|null} beforeText\n1154:  * @param {string|null} afterText\n1155:  * @param {string} relative\n1156:  * @returns {string[]}\n1157:  */\n1158: function unifiedDiff(beforeText, afterText, relative) {\n1159:   const left = diffLines(beforeText);\n1160:   const right = diffLines(afterText);\n1161:   const ops = diffOps(left, right);\n1162:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1163: \n1164:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1165:   const hunks = [];\n1166:   for (const index of changed) {\n1167:     const start = Math.max(0, index - 3);\n1168:     const end = Math.min(ops.length, index + 4);\n1169:     const last = hunks[hunks.length - 1];\n1170:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1171:     else hunks.push({ start, end });\n1172:   }\n1173: \n1174:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1175:   let consumed = 0;\n1176:   for (const hunk of hunks) {\n1177:     // A create has no left side and a removal has no right side, so their cursors start at\n1178:     // zero rather than at the first line of a file that is not there.\n1179:     let leftCursor = beforeText === null ? 0 : 1;\n1180:     let rightCursor = afterText === null ? 0 : 1;\n1181:     for (let index = 0; index < hunk.start; index += 1) {\n1182:       if (ops[index].kind !== '+') leftCursor += 1;\n1183:       if (ops[index].kind !== '-') rightCursor += 1;\n1184:     }\n1185:     const slice = ops.slice(hunk.start, hunk.end);\n1186:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1187:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1188:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1189:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1190:     consumed += slice.length;\n1191:   }\n1192:   return consumed === 0 ? [] : output;\n1193: }\n1194: \n1195: // ─────────────────────────────────────────────────────────────────────────────\n1196: // 14. THE PLAN\n1197: // ─────────────────────────────────────────────────────────────────────────────\n1198: \n1199: function renderTargets(composition) {\n1200:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1201: }\n1202: \n1203: function renderPlan(composition, plan) {\n1204:   const lines = [];\n1205:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1206:   lines.push(...renderTargets(composition));\n1207:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1208: \n1209:   for (const file of composition.writes) {\n1210:     if (file.action === 'remove') {\n1211:       lines.push(`diff ${file.path}:`);\n1212:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1213:       continue;\n1214:     }\n1215:     const diff = unifiedDiff(file.before, file.content, file.path);\n1216:     lines.push(`diff ${file.path}:`);\n1217:     if (diff.length === 0) lines.push('  (no line changes)');\n1218:     lines.push(...diff);\n1219:   }\n1220: \n1221:   lines.push('block:');\n1222:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1223:   lines.push('block-end:');\n1224: \n1225:   const { before, after, limits } = composition.budget;\n1226:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1227:   if (after.total > limits.total) {\n1228:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1229:   }\n1230:   if (after.prefix > limits.prefix) {\n1231:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1232:   }\n1233: \n1234:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1235:   lines.push(`backup: ${plan.dir}`);\n1236:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1237:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1238:   lines.push(`plan-digest: ${plan.digest}`);\n1239:   return lines;\n1240: }\n1241: \n1242: function renderDropped(dropped) {\n1243:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1244: }\n1245: \n1246: // ─────────────────────────────────────────────────────────────────────────────\n1247: // 15. PLAN\n1248: // ─────────────────────────────────────────────────────────────────────────────\n1249: \n1250: function preflight(composition, manifest) {\n1251:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1252: }\n1253: \n1254: function commandPlan(options, output, hooks) {\n1255:   const manifest = loadManifest();\n1256:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1257: \n1258:   const checked = preflight(composition, manifest);\n1259:   composition.ledger.dropped = checked.dropped.length;\n1260: \n1261:   if (composition.writes.length === 0) {\n1262:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1263:     for (const note of composition.notes) output.log(`note: ${note}`);\n1264:     output.log('NOTHING TO DO');\n1265:     return 0;\n1266:   }\n1267: \n1268:   const plan = planFor(composition);\n1269:   for (const line of renderPlan(composition, plan)) output.log(line);\n1270:   if (checked.dropped.length > 0) {\n1271:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1272:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1273:     output.warn('STATUS=FAIL');\n1274:     return 1;\n1275:   }\n1276:   if (options.dryRun) output.log('dry-run: nothing was written');\n1277:   return 0;\n1278: }\n1279: \n1280: // ─────────────────────────────────────────────────────────────────────────────\n1281: // 16. APPLY\n1282: // ─────────────────────────────────────────────────────────────────────────────\n1283: \n1284: function runTool(script, args) {\n1285:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1286:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1287:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1288:   return { code: result.status, output };\n1289: }\n1290: \n1291: function restoreFromBackup({ root, dir, output }) {\n1292:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1293:   // A rollback that put a damaged copy back would replace the fault it exists to undo with\n1294:   // one the run never made, so every entry is proved against the hash recorded beside it\n1295:   // before the first path moves.\n1296:   for (const entry of record.paths) {\n1297:     assertWritable(root, entry.path);\n1298:     if (!entry.existed) continue;\n1299:     const source = path.join(dir, entry.backup);\n1300:     if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n1301:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n1302:       return null;\n1303:     }\n1304:   }\n1305:   let restored = 0;\n1306:   const deleted = new Set();\n1307:   for (const entry of record.paths) {\n1308:     const target = path.join(root, entry.path);\n1309:     if (!entry.existed) {\n1310:       if (fs.existsSync(target)) {\n1311:         fs.rmSync(target);\n1312:         deleted.add(entry.path);\n1313:       }\n1314:       continue;\n1315:     }\n1316:     const source = path.join(dir, entry.backup);\n1317:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1318:     fs.copyFileSync(source, target);\n1319:     restored += 1;\n1320:   }\n1321:   removeCreatedDirs(root, record.paths, deleted);\n1322:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1323:   return restored;\n1324: }\n1325: \n1326: function commandApply(options, output, hooks) {\n1327:   if (!options.digest) {\n1328:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1329:     return 2;\n1330:   }\n1331: \n1332:   const manifest = loadManifest();\n1333:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1334: \n1335:   // A tree already in its target state has nothing a digest could authorise.\n1336:   if (composition.writes.length === 0) {\n1337:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1338:     output.log('NOTHING TO DO');\n1339:     return 0;\n1340:   }\n1341: \n1342:   const plan = planFor(composition);\n1343:   if (plan.digest !== options.digest) {\n1344:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1345:     // already happened gets told which directory holds those bytes instead of a claim\n1346:     // about the tree that would be false.\n1347:     const held = backupDirectoryOf(plan.base, options.digest);\n1348:     if (fs.existsSync(held)) {\n1349:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1350:       return 2;\n1351:     }\n1352:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1353:     return 2;\n1354:   }\n1355: \n1356:   // The same proof the plan ran, because a composition that already loses a line must\n1357:   // never reach a backup, let alone the tree.\n1358:   const checked = preflight(composition, manifest);\n1359:   composition.ledger.dropped = checked.dropped.length;\n1360:   if (checked.dropped.length > 0) {\n1361:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1362:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1363:     output.warn('STATUS=FAIL');\n1364:     return 1;\n1365:   }\n1366: \n1367:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1368:   // the run before a backup exists rather than after a partial write.\n1369:   const targets = [];\n1370:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1371: \n1372:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1373:   // here, where every precondition has already passed and nothing has been created.\n1374:   if (options.dryRun) {\n1375:     for (const line of renderPlan(composition, plan)) output.log(line);\n1376:     output.log('dry-run: nothing was written');\n1377:     return 0;\n1378:   }\n1379: \n1380:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1381:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1382: \n1383:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1384:   let writing = null;\n1385:   try {\n1386:     for (const target of targets) {\n1387:       writing = target.file.path;\n1388:       if (target.file.action === 'remove') {\n1389:         if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1390:         output.log(`removed ${target.file.path} (backed up first)`);\n1391:         continue;\n1392:       }\n1393:       fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1394:       write(target.absolute, target.file.content);\n1395:       output.log(`wrote ${target.file.path}`);\n1396:     }\n1397:   } catch (error) {\n1398:     // The backup is the only copy of every target as the plan found it, so a throw here is\n1399:     // undone from it rather than reported as a run that never started.\n1400:     output.warn(`${TAG} ERROR: writing ${writing} failed: ${error.message}`);\n1401:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1402:     output.log(`backup: ${plan.dir}`);\n1403:     output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1404:     output.warn('STATUS=FAIL');\n1405:     return 3;\n1406:   }\n1407: \n1408:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1409:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1410:   if (rootTouched) {\n1411:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1412:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1413:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1414:   }\n1415:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1416:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1417:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1418:     output.log(`repo-rules: ${summary}`);\n1419:   }\n1420: \n1421:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1422:   const rootPath = path.join(options.root, manifest.root_file);\n1423:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1424:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1425:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1426: \n1427:   if (after.dropped.length > 0) {\n1428:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1429:     const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1430:     if (restored === null) {\n1431:       output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n1432:     } else {\n1433:       output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1434:     }\n1435:     output.warn('STATUS=FAIL');\n1436:     return 1;\n1437:   }\n1438: \n1439:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1440:   if (report !== null) {\n1441:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1442:   }\n1443:   output.log(`backup: ${plan.dir}`);\n1444:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1445:   for (const entry of record.paths) {\n1446:     if (!entry.existed) continue;\n1447:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1448:   }\n1449:   output.log('STATUS=OK');\n1450:   return 0;\n1451: }\n1452: \n1453: // ─────────────────────────────────────────────────────────────────────────────\n1454: // 17. RESTORE\n1455: // ─────────────────────────────────────────────────────────────────────────────\n1456: \n1457: function readConfirmation() {\n1458:   try {\n1459:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1460:   } catch {\n[Output truncated. Continue reading with offset: 1461]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\",\"offset\":1061,\"limit\":400}"},"time":{"start":1794559192184,"end":1794559192725}}}}
