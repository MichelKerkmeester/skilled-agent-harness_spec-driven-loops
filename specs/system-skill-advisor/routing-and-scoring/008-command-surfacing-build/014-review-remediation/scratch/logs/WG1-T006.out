{"type":"tool_use","timestamp":1794559189112,"sessionID":"ses_e2bf03715ffe75FbNlphwYciok","part":{"partID":"prt_1d4101eb9001vt7zALm7UYVa0V","sessionID":"ses_e2bf03715ffe75FbNlphwYciok","messageID":"msg_1d4100185001l7u0VIRDqygvvY","type":"tool","id":"call_2b4167e176b04d9a8d58d5cd","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1060\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist,\n38: //             3 a write failed after the backup, and the run was undone or the restore said why not\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: const { spawnSync } = require('node:child_process');\n45: const crypto = require('node:crypto');\n46: const fs = require('node:fs');\n47: const os = require('node:os');\n48: const path = require('node:path');\n49: \n50: const { buildReport } = require('./agents-md-check.cjs');\n51: const { classifyFile } = require('./release-update.cjs');\n52: const {\n53:   deliveryAnchorEnd,\n54:   findBlock,\n55:   segment,\n56:   sha256,\n57: } = require('./lib/agents-md-sections.cjs');\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 2. CONSTANTS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: const TAG = '[agents-md-embed]';\n64: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n65: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n66: \n67: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n68: // its generator, and the router verdict belongs to the checker that ships with the skill\n69: // authoring rules.\n70: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n71: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n72: const REPO_RULES_TAG = '[repo-rules-check]';\n73: const TOOL_TIMEOUT_MS = 120000;\n74: \n75: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n76: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n77: // The digest is 64 hex characters and a path segment is better short, so the directory is\n78: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n79: // bits of it is what makes two different plans sharing one a non-event.\n80: const BACKUP_NAME_CHARS = 16;\n81: // How many of this composition's directories a plan will step past before it gives up. The\n82: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n83: // a normal one.\n84: const BACKUP_ATTEMPTS = 64;\n85: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n86: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n87: const CLAUDE_POINTER_PATH = 'CLAUDE.md';\n88: \n89: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n90: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n91: // and every removal is checked against this list by `assertWritable` before it happens.\n92: const ALLOWLIST = [\n93:   'AGENTS.md',\n94:   'CLAUDE.md',\n95:   '.codex/AGENTS.md',\n96:   '.cursor/rules/repo-local.md',\n97:   '.cursor/rules/skill-routing.md',\n98:   'REPO RULES.md',\n99: ];\n100: \n101: // A copy at one of these paths is read for its unique lines and then removed. Every other\n102: // runtime-copy row is reported by the check engine and left alone here.\n103: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n104: \n105: const USAGE = [\n106:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n107:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n108:   '                             budget, the survival ledger and the plan digest; write nothing',\n109:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n110:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n111:   'Options:',\n112:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n113:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n114:   '  --remove-claude-md         fold it and leave an @AGENTS.md pointer in its place (the default)',\n115:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n116:   '  --dry-run                  print the plan and write nothing',\n117:   '  --yes                      take the restore confirmation as given',\n118:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n119:   '            2 a precondition failed or a path fell outside the allowlist,',\n120:   '            3 a write failed after the backup, and the run was undone or the restore said why not',\n121: ].join('\\n');\n122: \n123: // A write that throws partway through is neither a run that wrote nothing nor a finished\n124: // run, because the targets before it already hold bytes and the failed one may hold a\n125: // partial one. The backup exists by then, so the failure restores it and ends on an exit\n126: // of its own rather than borrowing one the usage already spends on another meaning.\n127: \n128: // ─────────────────────────────────────────────────────────────────────────────\n129: // 3. ERRORS\n130: // ─────────────────────────────────────────────────────────────────────────────\n131: \n132: class UsageError extends Error {}\n133: class PreconditionError extends Error {}\n134: class AllowlistError extends Error {}\n135: \n136: // ─────────────────────────────────────────────────────────────────────────────\n137: // 4. ARGUMENTS\n138: // ─────────────────────────────────────────────────────────────────────────────\n139: \n140: function readValue(argv, index, flag) {\n141:   const argument = argv[index];\n142:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n143:   if (inline !== null) return { value: inline, next: index };\n144:   const value = argv[index + 1];\n145:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n146:   return { value, next: index + 1 };\n147: }\n148: \n149: function parseArgs(argv) {\n150:   const options = {\n151:     command: null,\n152:     root: REPO_ROOT,\n153:     digest: null,\n154:     run: null,\n155:     keepClaudeMd: false,\n156:     createRouter: false,\n157:     dryRun: false,\n158:     yes: false,\n159:     help: false,\n160:   };\n161: \n162:   const commands = [];\n163:   for (let index = 0; index < argv.length; index += 1) {\n164:     const argument = argv[index];\n165:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n166:     else if (argument === '--root') {\n167:       const read = readValue(argv, index, '--root');\n168:       options.root = path.resolve(read.value);\n169:       index = read.next;\n170:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n171:       const read = readValue(argv, index, '--plan-digest');\n172:       options.digest = read.value.trim();\n173:       index = read.next;\n174:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n175:       const read = readValue(argv, index, '--run');\n176:       options.run = path.resolve(read.value);\n177:       index = read.next;\n178:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n179:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n180:     else if (argument === '--create-router') options.createRouter = true;\n181:     else if (argument === '--dry-run') options.dryRun = true;\n182:     else if (argument === '--yes') options.yes = true;\n183:     else if (argument === '--help' || argument === '-h') options.help = true;\n184:     else throw new UsageError(`unknown argument: ${argument}`);\n185:   }\n186: \n187:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n188:   options.command = commands.length === 1 ? commands[0] : null;\n189:   return options;\n190: }\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 5. SMALL SHARED READERS\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: function loadManifest() {\n197:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n198:   try {\n199:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n200:   } catch (error) {\n201:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n202:   }\n203: }\n204: \n205: function isSymlink(target) {\n206:   try {\n207:     return fs.lstatSync(target).isSymbolicLink();\n208:   } catch {\n209:     return false;\n210:   }\n211: }\n212: \n213: function sameDirectory(a, b) {\n214:   try {\n215:     return fs.realpathSync(a) === fs.realpathSync(b);\n216:   } catch {\n217:     return false;\n218:   }\n219: }\n220: \n221: // The undo a run prints must work as printed. A restore runs against this engine's own\n222: // repository unless told otherwise, so the line names the root whenever it is another one.\n223: function undoCommand(dir, root) {\n224:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n225:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n226: }\n227: \n228: // A line is compared trimmed, and the two lines that carry no content of their own are\n229: // dropped, because a composition may legitimately re-place either of them.\n230: function countLines(text) {\n231:   const counts = new Map();\n232:   for (const raw of String(text).split('\\n')) {\n233:     const line = raw.trim();\n234:     if (line === '' || line === '---') continue;\n235:     counts.set(line, (counts.get(line) || 0) + 1);\n236:   }\n237:   return counts;\n238: }\n239: \n240: function lineSet(text) {\n241:   return new Set(countLines(text).keys());\n242: }\n243: \n244: function uniqueLines(text) {\n245:   return [...countLines(text).keys()];\n246: }\n247: \n248: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n249: // same sentence written twice is two lines to keep.\n250: function lineCount(text) {\n251:   let total = 0;\n252:   for (const count of countLines(text).values()) total += count;\n253:   return total;\n254: }\n255: \n256: // The lines of one body that its reference does not carry, in order and with repeats,\n257: // because the proof counts occurrences rather than membership. The comparison is trimmed\n258: // and the line comes back as it was written: the proof cares that the line survived, and\n259: // the indentation is what makes a nested bullet or a code sample read as one.\n260: function localLinesOf(body, reference) {\n261:   const known = lineSet(reference);\n262:   const lines = [];\n263:   for (const raw of String(body).split('\\n')) {\n264:     const line = raw.trim();\n265:     if (line === '' || line === '---' || known.has(line)) continue;\n266:     lines.push(raw);\n267:   }\n268:   return lines;\n269: }\n270: \n271: function chunkText(text) {\n272:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n273: }\n274: \n275: // ─────────────────────────────────────────────────────────────────────────────\n276: // 6. THE REPOSITORY BLOCK\n277: // ─────────────────────────────────────────────────────────────────────────────\n278: \n279: // What the block holds once the template's own heading and note are set aside. A block a\n280: // previous release wrote opens with both, so recognising them is what keeps a second run\n281: // from nesting one heading inside another.\n282: function blockBody(content, markers) {\n283:   let rest = String(content).replace(/^\\n+/u, '');\n284:   const heading = markers.heading.trim();\n285:   const note = markers.note.trim();\n286:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n287:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n288:   return chunkText(rest);\n289: }\n290: \n291: function renderBlock(markers, body) {\n292:   const text = chunkText(body);\n293:   const between = text === '' ? '' : `${text}\\n`;\n294:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n295: }\n296: \n297: // Devin never sees past the delivery prefix of the root document, so a repository with\n298: // something of its own gets the same block as a Cursor rule that applies always.\n299: function renderMirror(markers, body) {\n300:   const text = chunkText(body);\n301:   const between = text === '' ? '' : `${text}\\n`;\n302:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n303: }\n304: \n305: // A document carrying two blocks has no single block to carry out of, and replacing it\n306: // would have to choose one of them. Naming both positions is what makes the refusal\n307: // actionable: reporting the second block's marker bytes as repository lines the run\n308: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n309: function duplicateBlockMessage(rootFile, block) {\n310:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n311:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n312:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n313: }\n314: \n315: // ─────────────────────────────────────────────────────────────────────────────\n316: // 7. THE ROUTER\n317: // ─────────────────────────────────────────────────────────────────────────────\n318: \n319: function cellsOf(line) {\n320:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n321: }\n322: \n323: // The rule a row points at, which is the identity the checker also compares. Matching on\n324: // the resolved path rather than the whole row is what lets a repository reword a summary\n325: // without the row reading as missing.\n326: function rulePathOf(cells) {\n327:   for (const cell of cells) {\n328:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n329:     if (linked) return linked[1];\n330:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n331:     if (bare) return bare[1];\n332:   }\n333:   return null;\n334: }\n335: \n336: function rowKey(cells) {\n337:   return rulePathOf(cells) || cells.join(' | ');\n338: }\n339: \n340: /**\n341:  * The rows of one router table, with the line each sits on.\n342:  *\n343:  * @param {string} text - The router document.\n344:  * @param {string} anchor - Text that identifies the table's heading.\n345:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n346:  *   Null when the document carries no such table.\n347:  */\n348: function routerTable(text, anchor) {\n349:   const lines = text.split('\\n');\n350:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n351:   if (start === -1) return null;\n352: \n353:   const rows = [];\n354:   let separator = -1;\n355:   let lastRow = -1;\n356:   for (let index = start + 1; index < lines.length; index += 1) {\n357:     const line = lines[index].trim();\n358:     if (line.startsWith('#')) break;\n359:     if (line === '') {\n360:       if (rows.length > 0) break;\n361:       continue;\n362:     }\n363:     if (!line.startsWith('|')) continue;\n364:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n365:       separator = index;\n366:       continue;\n367:     }\n368:     rows.push({ line: index, cells: cellsOf(line) });\n369:     lastRow = index;\n370:   }\n371: \n372:   const anchorLine = rows.length > 0 ? lastRow : separator;\n373:   if (anchorLine === -1) return null;\n374:   return { lines, rows, insertAfter: anchorLine };\n375: }\n376: \n377: /**\n378:  * The router with the shipped rows it is missing, added at the end of each table.\n379:  *\n380:  * @param {string} text\n381:  * @param {Object} manifest\n382:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n383:  */\n384: function addRouterRows(text, manifest) {\n385:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n386:   const tables = [\n387:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n388:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n389:   ];\n390: \n391:   let next = text;\n392:   const added = { trigger: 0, index: 0 };\n393:   const notes = [];\n394: \n395:   for (const table of tables) {\n396:     const found = routerTable(next, table.anchor);\n397:     if (found === null) {\n398:       // A router without the table is a different document shape; appending one would\n399:       // number a second section and break the checker's own reading of the file.\n400:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n401:       continue;\n402:     }\n403:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n404:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n405:     if (missing.length === 0) continue;\n406:     const lines = found.lines.slice();\n407:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n408:     next = lines.join('\\n');\n409:     added[table.kind] = missing.length;\n410:   }\n411: \n412:   return { text: next, added, notes };\n413: }\n414: \n415: // A repository with no router loads no rule at all, so the missing file is created from\n416: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n417: function renderRouter(manifest) {\n418:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n419:   return [\n420:     '# REPO RULES',\n421:     '',\n422:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n423:     'before your first write of the session. This document then routes you to every rule',\n424:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n425:     'holds no rules of its own.',\n426:     '',\n427:     '---',\n428:     '',\n429:     '## 1. HOW TO USE THIS',\n430:     '',\n431:     '1. **Match on the action you are about to take**, not the topic of the request.',\n432:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n433:     '3. **A file already in context is not re-read.**',\n434:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n435:     '',\n436:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n437:     'the same tables, authored one rule at a time.',\n438:     '',\n439:     '---',\n440:     '',\n441:     '## 2. TRIGGER TABLE',\n442:     '',\n443:     '| You are about to… | Load | It settles |',\n444:     '|-------------------|------|-----------|',\n445:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n446:     '',\n447:     '---',\n448:     '',\n449:     '## 3. INDEX',\n450:     '',\n451:     '| Rule | Summary |',\n452:     '|------|---------|',\n453:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n454:     '',\n455:     '---',\n456:     '',\n457:     'Each file the rows name is part of the installation and is replaced by a release.',\n458:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n459:     '',\n460:   ].join('\\n');\n461: }\n462: \n463: // ─────────────────────────────────────────────────────────────────────────────\n464: // 8. THE PLAN DIGEST\n465: // ─────────────────────────────────────────────────────────────────────────────\n466: \n467: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n468: // composed for and by the backup directory the plan takes: the same plan replayed against\n469: // an edited tree composes something else and cannot match, and a plan whose directory an\n470: // earlier run already owns is a different plan, so the digest covers which one it is.\n471: function planDigest(composition, plan) {\n472:   const written = composition.files\n473:     .filter((file) => file.action === 'create' || file.action === 'replace')\n474:     .map((file) => [file.path, file.action, sha256(file.content)])\n475:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n476:   const removed = composition.files\n477:     .filter((file) => file.action === 'remove')\n478:     .map((file) => [file.path, file.action, null])\n479:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n480:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n481: }\n482: \n483: // Where each line of the old document sat, so a lost line is reported with the part it\n484: // belonged to. The block wins over the section it interrupts, because those bytes are the\n485: // repository's and not the section's.\n486: function placementOf(before) {\n487:   const places = new Map();\n488:   for (const section of before.sections) {\n489:     const place = section.id === null\n490:       ? { part: 1, from: 'unmarked section' }\n491:       : { part: 2, from: section.id };\n492:     for (const index of section.rows || []) places.set(index, place);\n493:   }\n494:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n495:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n496:   if (before.block && before.block.complete && before.block.rows) {\n497:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n498:   }\n499:   return places;\n500: }\n501: \n502: // ─────────────────────────────────────────────────────────────────────────────\n503: // 9. THE PRESERVATION PROOF\n504: // ─────────────────────────────────────────────────────────────────────────────\n505: \n506: /**\n507:  * Prove that a composition lost nothing the repository had.\n508:  *\n509:  * Four claims, one per part of the returned record: every line of the old document no\n510:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n511:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n512:  * removed runtime copy still sit in the new document; and every line of the new document\n513:  * outside the block is one the template ships. Pure by construction: same inputs, same\n514:  * answer, no file read.\n515:  *\n516:  * The claim is read from the old document's own lines, in reading order, rather than from\n517:  * the parts the segmentation produced. A proof built from those parts can require only\n518:  * what the reader managed to place, so a line it placed nowhere would be required by\n519:  * nothing and a composition that lost it would still report `dropped 0`.\n520:  *\n521:  * @param {string|null} oldText - The document as it was.\n522:  * @param {string} newText - The document as it would be, or as it now is.\n523:  * @param {Object} manifest\n524:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n525:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n526:  *   foreign: Array<{line: string}>}}\n527:  */\n528: function preservationCheck(oldText, newText, manifest, options = {}) {\n529:   const markers = manifest.markers;\n530:   const dropped = [];\n531:   const knownShipped = new Set();\n532:   for (const entry of Object.values(manifest.derived.sections || {})) {\n533:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n534:   }\n535:   for (const entry of manifest.derived.history || []) {\n536:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n537:   }\n538: \n539:   // The framework's own bytes: the two markers and the heading and note that come with\n540:   // them. The new document carries one of each whatever the old one carried, so requiring\n541:   // them would report a duplicated block as repository lines the run dropped.\n542:   const framework = new Set([\n543:     markers.start.trim(),\n544:     markers.end.trim(),\n545:     markers.heading.trim(),\n546:     markers.note.trim(),\n547:   ]);\n548: \n549:   const before = oldText === null || oldText === undefined\n550:     ? { sections: [], block: null, prelude: null }\n551:     : segment(oldText, markers, manifest.sections);\n552:   const after = segment(newText, markers, manifest.sections);\n553:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n554:   const newBlockCounts = countLines(newBlock);\n555:   const newDocumentCounts = countLines(newText);\n556: \n557:   const require = (line, part, from, need) => {\n558:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n559:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n560:   };\n561: \n562:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n563:   // the new block at least as often as it was there. Where the line sat decides only which\n564:   // part names it when it goes missing.\n565:   const places = placementOf(before);\n566:   const needed = new Map();\n567:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n568:   for (let index = 0; index < oldLines.length; index += 1) {\n569:     const line = oldLines[index].trim();\n570:     if (line === '' || line === '---') continue;\n571:     if (framework.has(line) || knownShipped.has(line)) continue;\n572:     const place = places.get(index) || { part: 1, from: 'the document' };\n573:     const entry = needed.get(line);\n574:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n575:     else entry.need += 1;\n576:   }\n577:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n578: \n579:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n580:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n581:   for (const copy of options.removed || []) {\n582:     for (const [line, count] of countLines(copy.content)) {\n583:       if (framework.has(line)) continue;\n584:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n585:       require(line, 3, copy.path, count);\n586:     }\n587:   }\n588: \n589:   // Part 4. Nothing above the block that the template does not ship.\n590:   const currentOnly = new Set();\n591:   for (const entry of Object.values(manifest.derived.sections || {})) {\n592:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n593:   }\n594:   const foreign = [];\n595:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n596:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n597:   const newBytes = Buffer.from(newText, 'utf8');\n598:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n599:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n600:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n601:   for (const line of uniqueLines(outside)) {\n602:     if (!currentOnly.has(line)) foreign.push({ line });\n603:   }\n604: \n605:   return { dropped, foreign };\n606: }\n607: \n608: // ─────────────────────────────────────────────────────────────────────────────\n609: // 10. COMPOSITION\n610: // ─────────────────────────────────────────────────────────────────────────────\n611: \n612: function rowOf(report, id) {\n613:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n614: }\n615: \n616: function fileState(text) {\n617:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n618: }\n619: \n620: function historyBodyOf(manifest, hash) {\n621:   if (!hash) return null;\n622:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n623:   return entry ? entry.body : null;\n624: }\n625: \n626: function prefixEndOf(text, manifest) {\n627:   if (text === null) return 0;\n628:   const { sections } = segment(text, manifest.markers, manifest.sections);\n629:   const byId = new Map();\n630:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n631:   let end = 0;\n632:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n633:     const section = byId.get(pin.section);\n634:     if (!section) continue;\n635:     const measured = deliveryAnchorEnd(section, pin);\n636:     if (measured !== null) end = Math.max(end, measured);\n637:   }\n638:   return end;\n639: }\n640: \n641: /**\n642:  * Build every target of one repository in memory, with the ledger and the digest.\n643:  *\n644:  * Nothing here writes; the caller decides what to do with the answer.\n645:  *\n646:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n647:  * @returns {Object} the composition\n648:  */\n649: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n650:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n651:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n652: \n653:   const markers = manifest.markers;\n654:   const rootFile = manifest.root_file;\n655:   const claudePointer = `@${manifest.root_file}\\n`;\n656:   const rootPath = path.join(root, rootFile);\n657:   // Writing through a link would change a file this repository does not own, and the backup\n658:   // could not put the link back.\n659:   if (isSymlink(rootPath)) {\n660:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n661:   }\n662:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n663: \n664:   const block = oldText === null ? null : findBlock(oldText, markers);\n665:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n666:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n667:   }\n668:   if (block !== null && block.complete === false) {\n669:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n670:   }\n671: \n672:   const oldSegmentation = oldText === null\n673:     ? { sections: [], block: null, prelude: null }\n674:     : segment(oldText, markers, manifest.sections);\n675:   const oldSections = oldSegmentation.sections;\n676:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n677:   const notes = [];\n678:   const chunks = [];\n679: \n680:   // (a) Whatever the block already held.\n681:   if (block !== null && block.complete) {\n682:     const body = blockBody(block.content, markers);\n683:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n684:   }\n685: \n686:   // Text above the first heading belongs to no section, and a replacement would drop it.\n687:   // The segmenter reports it apart from the sections because no heading covers it.\n688:   if (oldSegmentation.prelude !== null) {\n689:     const preamble = chunkText(oldSegmentation.prelude.text);\n690:     if (preamble !== '') {\n691:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n692:     }\n693:   }\n694: \n695:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n696:   // the first heading is already carried as the preamble, and its byte range would reach\n697:   // a block written above the template, so it is the one entry skipped here.\n698:   const unmarkedRow = rowOf(report, 'A8');\n699:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n700:   const unmarked = unmarkedRow.entries\n701:     .filter((entry) => entry.heading !== null)\n702:     .sort((left, right) => left.byte_start - right.byte_start);\n703:   for (const entry of unmarked) {\n704:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n705:     if (text === '') continue;\n706:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n707:   }\n708: \n709:   // (c) The local lines of a section somebody edited, each under its own id.\n710:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n711:   for (const entry of edited) {\n712:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n713:     if (!section) continue;\n714:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n715:     const lines = localLinesOf(section.body, shippedBody);\n716:     if (lines.length === 0) continue;\n717:     chunks.push({\n718:       kind: 'edited',\n719:       id: entry.id,\n720:       lines: lines.length,\n721:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n722:     });\n723: \n724:     // A clean merge would leave the section edited forever, so it is offered as a reading\n725:     // of the same bytes and never as the default.\n726:     const base = historyBodyOf(manifest, entry.base);\n727:     if (base !== null) {\n728:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n729:       if (merged.conflictKind === 'mergeable') {\n730:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n731:       }\n732:     }\n733:   }\n734: \n735:   // (d) The unique lines of a runtime copy that is folded away.\n736:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n737:   const removedCopies = [];\n738:   for (const copy of copies) {\n739:     const absolute = path.join(root, copy.path);\n740:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n741:     if (copy.state !== 'FINDING') continue;\n742:     const content = fs.readFileSync(absolute, 'utf8');\n743:     // With no root document every line of the copy is its own, and the count has to survive:\n744:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n745:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n746:     if (lines.length > 0) {\n747:       chunks.push({\n748:         kind: 'copy',\n749:         path: copy.path,\n750:         lines: lines.length,\n751:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n752:       });\n753:     }\n754:     removedCopies.push({ path: copy.path, content });\n755:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n756:       removedCopies.pop();\n757:       if (lines.length > 0) {\n758:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n759:       }\n760:     }\n761:   }\n762: \n763:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n764:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n765: \n766:   // The template with nothing of the repository's own in it gains nothing from the two\n767:   // marker lines, so that difference alone is not a reason to write: the markers appear\n768:   // with the first line worth keeping.\n769:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n770:   if (templateOnly) {\n771:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n772:   }\n773: \n774:   const files = [];\n775:   if (templateOnly || oldText === composed) {\n776:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n777:   } else {\n778:     files.push({\n779:       path: rootFile,\n780:       action: oldText === null ? 'create' : 'replace',\n781:       content: composed,\n782:       before: oldText,\n783:     });\n784:   }\n785: \n786:   // The router gains the shipped rows it is missing, or is created from them when asked.\n787:   const routerPath = path.join(root, manifest.router_file);\n788:   let routerAction = 'unchanged';\n789:   let routerText = null;\n790:   if (fs.existsSync(routerPath)) {\n791:     const current = fs.readFileSync(routerPath, 'utf8');\n792:     const result = addRouterRows(current, manifest);\n793:     notes.push(...result.notes);\n794:     if (result.text !== current) {\n795:       routerText = result.text;\n796:       routerAction = 'replace';\n797:       if (result.added.trigger > 0 || result.added.index > 0) {\n798:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n799:       }\n800:     }\n801:   } else if (createRouter) {\n802:     routerText = renderRouter(manifest);\n803:     routerAction = 'create';\n804:   } else {\n805:     routerAction = 'absent';\n806:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n807:   }\n808:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n809: \n810:   // The Cursor mirror exists exactly when the block carries something, because an empty\n811:   // block has nothing a runtime that cannot read past the prefix would miss.\n812:   const mirrorPath = path.join(root, MIRROR_FILE);\n813:   const mirrorExists = fs.existsSync(mirrorPath);\n814:   let mirrorAction = 'unchanged';\n815:   let mirrorText = null;\n816:   if (blockText !== '') {\n817:     mirrorText = renderMirror(markers, blockText);\n818:     if (!mirrorExists) mirrorAction = 'create';\n819:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n820:   } else if (mirrorExists) {\n821:     mirrorAction = 'remove';\n822:   }\n823:   if (mirrorAction !== 'unchanged') {\n824:     files.push({\n825:       path: MIRROR_FILE,\n826:       action: mirrorAction,\n827:       content: mirrorText,\n828:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n829:     });\n830:   }\n831: \n832:   for (const copy of removedCopies) {\n833:     if (copy.path === CLAUDE_POINTER_PATH) {\n834:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n835:       continue;\n836:     }\n837:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n838:   }\n839: \n840:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n841:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n842:   if (\n843:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n844:     && !fs.existsSync(claudePath)\n845:     && !isSymlink(claudePath)\n846:   ) {\n847:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n848:   }\n849: \n850:   const composition = {\n851:     root,\n852:     state: report.state,\n853:     report,\n854:     markers,\n855:     rootFile,\n856:     oldText,\n857:     composed,\n858:     block: { text: renderBlock(markers, blockText), body: blockText },\n859:     chunks,\n860:     removedCopies,\n861:     notes,\n862:     files,\n863:     budget: {\n864:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n865:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n866:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n867:     },\n868:     ledger: {\n869:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n870:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n871:       shippedReplaced: manifest.sections.length,\n872:       dropped: 0,\n873:     },\n874:   };\n875: \n876:   // What the run would put on disk, which is exactly the three actions a target can take.\n877:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n878:   return composition;\n879: }\n880: \n881: // ─────────────────────────────────────────────────────────────────────────────\n882: // 11. THE WRITE ALLOWLIST\n883: // ─────────────────────────────────────────────────────────────────────────────\n884: \n885: /**\n886:  * Resolve one path a run wants to touch, or refuse it.\n887:  *\n888:  * Containment is checked before membership, so a path that climbs out of the root is\n889:  * reported as what it is rather than as a missing allowlist entry.\n890:  *\n891:  * @param {string} root\n892:  * @param {string} relative\n893:  * @returns {string} the absolute path\n894:  */\n895: function assertWritable(root, relative) {\n896:   const base = path.resolve(root);\n897:   const normalized = String(relative).split(path.sep).join('/');\n898:   const absolute = path.resolve(base, normalized);\n899:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n900:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n901:   }\n902:   if (!ALLOWLIST.includes(normalized)) {\n903:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n904:   }\n905:   // Every path a run reaches must sit inside the root where the root really is, not only\n906:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n907:   const realBase = fs.realpathSync(base);\n908:   const realTarget = resolveThroughLinks(absolute);\n909:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n910:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n911:   }\n912:   return absolute;\n913: }\n914: \n915: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n916: // and the rest of the name is appended to it.\n917: function resolveThroughLinks(absolute) {\n918:   try {\n919:     return fs.realpathSync(absolute);\n920:   } catch {\n921:     const parent = path.dirname(absolute);\n922:     if (parent === absolute) return absolute;\n923:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n924:   }\n925: }\n926: \n927: // ─────────────────────────────────────────────────────────────────────────────\n928: // 12. BACKUPS\n929: // ─────────────────────────────────────────────────────────────────────────────\n930: \n931: function utcStamp(date = new Date()) {\n932:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n933: }\n934: \n935: /**\n936:  * The directory a plan's backup sits in, named after the plan digest.\n937:  *\n938:  * Named by the digest rather than by a clock reading because apply has to land exactly\n939:  * where the plan pointed and the digest is the only thing the operator carries across. The\n940:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n941:  * taken and moves to the next ordinal instead of writing beside it.\n942:  *\n943:  * @param {string} base\n944:  * @param {string} digest\n945:  * @returns {string}\n946:  */\n947: function backupDirectoryOf(base, digest) {\n948:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n949: }\n950: \n951: /**\n952:  * Where a run's backup goes, without creating anything.\n953:  *\n954:  * The output directory is used only when git ignores it, because a backup inside a tracked\n955:  * path is a backup the next commit publishes. Everything else leaves the repository.\n956:  *\n957:  * @param {{root: string}} input\n958:  * @returns {{dir: string, fallback: boolean, reason: string}}\n959:  */\n960: function backupBase({ root }) {\n961:   const candidate = path.join(root, BACKUP_DIR);\n962:   // The question is the one the run depends on: would a plan directory under this one be\n963:   // published by the next commit? Asking about the base alone would miss a rule written as\n964:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n965:   // the probe is a path of the same shape as the one the plan takes.\n966:   const probe = path.join(candidate, 'probe');\n967:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n968:     encoding: 'utf8',\n969:     timeout: TOOL_TIMEOUT_MS,\n970:   });\n971:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n972:   const reason = ignored.status === 1\n973:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n974:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n975:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n976: }\n977: \n978: /**\n979:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n980:  * that says both.\n981:  *\n982:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n983:  * suffixed into a second name, because the printed undo command would then point at that\n984:  * run's bytes; the next ordinal is a different plan with a different digest and a\n985:  * directory of its own.\n986:  *\n987:  * @param {Object} composition\n988:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n989:  */\n990: function planFor(composition) {\n991:   const base = backupBase({ root: composition.root });\n992:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n993:     const digest = planDigest(composition, { ordinal, base: base.dir });\n994:     const dir = backupDirectoryOf(base.dir, digest);\n995:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n996:   }\n997:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n998: }\n999: \n1000: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n1001: // only these, so on a record the run wrote, a folder that was there before the run is never\n1002: // taken away with it.\n1003: function missingParents(root, relative) {\n1004:   const missing = [];\n1005:   let dir = path.posix.dirname(relative);\n1006:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1007:     missing.push(dir);\n1008:     dir = path.posix.dirname(dir);\n1009:   }\n1010:   return missing;\n1011: }\n1012: \n1013: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1014: // entry's own allowlisted path; the list stops at the first one that is not.\n1015: function recordedCreatedDirs(entry) {\n1016:   const dirs = [];\n1017:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1018:   for (const dir of entry.createdDirs) {\n1019:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1020:     dirs.push(dir);\n1021:   }\n1022:   return dirs;\n1023: }\n1024: \n1025: // Runs after every file is back, because two new files can share one new folder. Only the\n1026: // folders above a file this restore just deleted are considered, and only an empty one is\n1027: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1028: // file the run created.\n1029: function removeCreatedDirs(root, entries, deleted) {\n1030:   const removed = [];\n1031:   for (const entry of entries) {\n1032:     if (!deleted.has(entry.path)) continue;\n1033:     for (const dir of recordedCreatedDirs(entry)) {\n1034:       const absolute = path.join(root, dir);\n1035:       let names;\n1036:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1037:       if (names.length > 0) break;\n1038:       fs.rmdirSync(absolute);\n1039:       removed.push(dir);\n1040:     }\n1041:   }\n1042:   return removed;\n1043: }\n1044: \n1045: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1046: // copy rather than a reconstruction.\n1047: function backupEntry(root, file) {\n1048:   const absolute = path.join(root, file.path);\n1049:   const exists = fs.existsSync(absolute);\n1050:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1051:   if (!exists) {\n1052:     entry.createdDirs = missingParents(root, file.path);\n1053:     return entry;\n1054:   }\n1055:   const stats = fs.lstatSync(absolute);\n1056:   entry.mode = stats.mode.toString(8).slice(-4);\n1057:   entry.symlink = stats.isSymbolicLink();\n1058:   const bytes = fs.readFileSync(absolute);\n1059:   entry.sha256 = sha256(bytes.toString('utf8'));\n1060:   entry.backup = path.posix.join('files', file.path);\n[Output truncated. Continue reading with offset: 1061]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1060\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist,\n38: //             3 a write failed after the backup, and the run was undone or the restore said why not\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: const { spawnSync } = require('node:child_process');\n45: const crypto = require('node:crypto');\n46: const fs = require('node:fs');\n47: const os = require('node:os');\n48: const path = require('node:path');\n49: \n50: const { buildReport } = require('./agents-md-check.cjs');\n51: const { classifyFile } = require('./release-update.cjs');\n52: const {\n53:   deliveryAnchorEnd,\n54:   findBlock,\n55:   segment,\n56:   sha256,\n57: } = require('./lib/agents-md-sections.cjs');\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 2. CONSTANTS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: const TAG = '[agents-md-embed]';\n64: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n65: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n66: \n67: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n68: // its generator, and the router verdict belongs to the checker that ships with the skill\n69: // authoring rules.\n70: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n71: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n72: const REPO_RULES_TAG = '[repo-rules-check]';\n73: const TOOL_TIMEOUT_MS = 120000;\n74: \n75: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n76: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n77: // The digest is 64 hex characters and a path segment is better short, so the directory is\n78: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n79: // bits of it is what makes two different plans sharing one a non-event.\n80: const BACKUP_NAME_CHARS = 16;\n81: // How many of this composition's directories a plan will step past before it gives up. The\n82: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n83: // a normal one.\n84: const BACKUP_ATTEMPTS = 64;\n85: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n86: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n87: const CLAUDE_POINTER_PATH = 'CLAUDE.md';\n88: \n89: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n90: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n91: // and every removal is checked against this list by `assertWritable` before it happens.\n92: const ALLOWLIST = [\n93:   'AGENTS.md',\n94:   'CLAUDE.md',\n95:   '.codex/AGENTS.md',\n96:   '.cursor/rules/repo-local.md',\n97:   '.cursor/rules/skill-routing.md',\n98:   'REPO RULES.md',\n99: ];\n100: \n101: // A copy at one of these paths is read for its unique lines and then removed. Every other\n102: // runtime-copy row is reported by the check engine and left alone here.\n103: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n104: \n105: const USAGE = [\n106:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n107:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n108:   '                             budget, the survival ledger and the plan digest; write nothing',\n109:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n110:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n111:   'Options:',\n112:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n113:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n114:   '  --remove-claude-md         fold it and leave an @AGENTS.md pointer in its place (the default)',\n115:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n116:   '  --dry-run                  print the plan and write nothing',\n117:   '  --yes                      take the restore confirmation as given',\n118:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n119:   '            2 a precondition failed or a path fell outside the allowlist,',\n120:   '            3 a write failed after the backup, and the run was undone or the restore said why not',\n121: ].join('\\n');\n122: \n123: // A write that throws partway through is neither a run that wrote nothing nor a finished\n124: // run, because the targets before it already hold bytes and the failed one may hold a\n125: // partial one. The backup exists by then, so the failure restores it and ends on an exit\n126: // of its own rather than borrowing one the usage already spends on another meaning.\n127: \n128: // ─────────────────────────────────────────────────────────────────────────────\n129: // 3. ERRORS\n130: // ─────────────────────────────────────────────────────────────────────────────\n131: \n132: class UsageError extends Error {}\n133: class PreconditionError extends Error {}\n134: class AllowlistError extends Error {}\n135: \n136: // ─────────────────────────────────────────────────────────────────────────────\n137: // 4. ARGUMENTS\n138: // ─────────────────────────────────────────────────────────────────────────────\n139: \n140: function readValue(argv, index, flag) {\n141:   const argument = argv[index];\n142:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n143:   if (inline !== null) return { value: inline, next: index };\n144:   const value = argv[index + 1];\n145:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n146:   return { value, next: index + 1 };\n147: }\n148: \n149: function parseArgs(argv) {\n150:   const options = {\n151:     command: null,\n152:     root: REPO_ROOT,\n153:     digest: null,\n154:     run: null,\n155:     keepClaudeMd: false,\n156:     createRouter: false,\n157:     dryRun: false,\n158:     yes: false,\n159:     help: false,\n160:   };\n161: \n162:   const commands = [];\n163:   for (let index = 0; index < argv.length; index += 1) {\n164:     const argument = argv[index];\n165:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n166:     else if (argument === '--root') {\n167:       const read = readValue(argv, index, '--root');\n168:       options.root = path.resolve(read.value);\n169:       index = read.next;\n170:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n171:       const read = readValue(argv, index, '--plan-digest');\n172:       options.digest = read.value.trim();\n173:       index = read.next;\n174:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n175:       const read = readValue(argv, index, '--run');\n176:       options.run = path.resolve(read.value);\n177:       index = read.next;\n178:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n179:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n180:     else if (argument === '--create-router') options.createRouter = true;\n181:     else if (argument === '--dry-run') options.dryRun = true;\n182:     else if (argument === '--yes') options.yes = true;\n183:     else if (argument === '--help' || argument === '-h') options.help = true;\n184:     else throw new UsageError(`unknown argument: ${argument}`);\n185:   }\n186: \n187:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n188:   options.command = commands.length === 1 ? commands[0] : null;\n189:   return options;\n190: }\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 5. SMALL SHARED READERS\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: function loadManifest() {\n197:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n198:   try {\n199:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n200:   } catch (error) {\n201:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n202:   }\n203: }\n204: \n205: function isSymlink(target) {\n206:   try {\n207:     return fs.lstatSync(target).isSymbolicLink();\n208:   } catch {\n209:     return false;\n210:   }\n211: }\n212: \n213: function sameDirectory(a, b) {\n214:   try {\n215:     return fs.realpathSync(a) === fs.realpathSync(b);\n216:   } catch {\n217:     return false;\n218:   }\n219: }\n220: \n221: // The undo a run prints must work as printed. A restore runs against this engine's own\n222: // repository unless told otherwise, so the line names the root whenever it is another one.\n223: function undoCommand(dir, root) {\n224:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n225:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n226: }\n227: \n228: // A line is compared trimmed, and the two lines that carry no content of their own are\n229: // dropped, because a composition may legitimately re-place either of them.\n230: function countLines(text) {\n231:   const counts = new Map();\n232:   for (const raw of String(text).split('\\n')) {\n233:     const line = raw.trim();\n234:     if (line === '' || line === '---') continue;\n235:     counts.set(line, (counts.get(line) || 0) + 1);\n236:   }\n237:   return counts;\n238: }\n239: \n240: function lineSet(text) {\n241:   return new Set(countLines(text).keys());\n242: }\n243: \n244: function uniqueLines(text) {\n245:   return [...countLines(text).keys()];\n246: }\n247: \n248: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n249: // same sentence written twice is two lines to keep.\n250: function lineCount(text) {\n251:   let total = 0;\n252:   for (const count of countLines(text).values()) total += count;\n253:   return total;\n254: }\n255: \n256: // The lines of one body that its reference does not carry, in order and with repeats,\n257: // because the proof counts occurrences rather than membership. The comparison is trimmed\n258: // and the line comes back as it was written: the proof cares that the line survived, and\n259: // the indentation is what makes a nested bullet or a code sample read as one.\n260: function localLinesOf(body, reference) {\n261:   const known = lineSet(reference);\n262:   const lines = [];\n263:   for (const raw of String(body).split('\\n')) {\n264:     const line = raw.trim();\n265:     if (line === '' || line === '---' || known.has(line)) continue;\n266:     lines.push(raw);\n267:   }\n268:   return lines;\n269: }\n270: \n271: function chunkText(text) {\n272:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n273: }\n274: \n275: // ─────────────────────────────────────────────────────────────────────────────\n276: // 6. THE REPOSITORY BLOCK\n277: // ─────────────────────────────────────────────────────────────────────────────\n278: \n279: // What the block holds once the template's own heading and note are set aside. A block a\n280: // previous release wrote opens with both, so recognising them is what keeps a second run\n281: // from nesting one heading inside another.\n282: function blockBody(content, markers) {\n283:   let rest = String(content).replace(/^\\n+/u, '');\n284:   const heading = markers.heading.trim();\n285:   const note = markers.note.trim();\n286:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n287:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n288:   return chunkText(rest);\n289: }\n290: \n291: function renderBlock(markers, body) {\n292:   const text = chunkText(body);\n293:   const between = text === '' ? '' : `${text}\\n`;\n294:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n295: }\n296: \n297: // Devin never sees past the delivery prefix of the root document, so a repository with\n298: // something of its own gets the same block as a Cursor rule that applies always.\n299: function renderMirror(markers, body) {\n300:   const text = chunkText(body);\n301:   const between = text === '' ? '' : `${text}\\n`;\n302:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n303: }\n304: \n305: // A document carrying two blocks has no single block to carry out of, and replacing it\n306: // would have to choose one of them. Naming both positions is what makes the refusal\n307: // actionable: reporting the second block's marker bytes as repository lines the run\n308: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n309: function duplicateBlockMessage(rootFile, block) {\n310:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n311:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n312:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n313: }\n314: \n315: // ─────────────────────────────────────────────────────────────────────────────\n316: // 7. THE ROUTER\n317: // ─────────────────────────────────────────────────────────────────────────────\n318: \n319: function cellsOf(line) {\n320:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n321: }\n322: \n323: // The rule a row points at, which is the identity the checker also compares. Matching on\n324: // the resolved path rather than the whole row is what lets a repository reword a summary\n325: // without the row reading as missing.\n326: function rulePathOf(cells) {\n327:   for (const cell of cells) {\n328:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n329:     if (linked) return linked[1];\n330:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n331:     if (bare) return bare[1];\n332:   }\n333:   return null;\n334: }\n335: \n336: function rowKey(cells) {\n337:   return rulePathOf(cells) || cells.join(' | ');\n338: }\n339: \n340: /**\n341:  * The rows of one router table, with the line each sits on.\n342:  *\n343:  * @param {string} text - The router document.\n344:  * @param {string} anchor - Text that identifies the table's heading.\n345:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n346:  *   Null when the document carries no such table.\n347:  */\n348: function routerTable(text, anchor) {\n349:   const lines = text.split('\\n');\n350:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n351:   if (start === -1) return null;\n352: \n353:   const rows = [];\n354:   let separator = -1;\n355:   let lastRow = -1;\n356:   for (let index = start + 1; index < lines.length; index += 1) {\n357:     const line = lines[index].trim();\n358:     if (line.startsWith('#')) break;\n359:     if (line === '') {\n360:       if (rows.length > 0) break;\n361:       continue;\n362:     }\n363:     if (!line.startsWith('|')) continue;\n364:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n365:       separator = index;\n366:       continue;\n367:     }\n368:     rows.push({ line: index, cells: cellsOf(line) });\n369:     lastRow = index;\n370:   }\n371: \n372:   const anchorLine = rows.length > 0 ? lastRow : separator;\n373:   if (anchorLine === -1) return null;\n374:   return { lines, rows, insertAfter: anchorLine };\n375: }\n376: \n377: /**\n378:  * The router with the shipped rows it is missing, added at the end of each table.\n379:  *\n380:  * @param {string} text\n381:  * @param {Object} manifest\n382:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n383:  */\n384: function addRouterRows(text, manifest) {\n385:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n386:   const tables = [\n387:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n388:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n389:   ];\n390: \n391:   let next = text;\n392:   const added = { trigger: 0, index: 0 };\n393:   const notes = [];\n394: \n395:   for (const table of tables) {\n396:     const found = routerTable(next, table.anchor);\n397:     if (found === null) {\n398:       // A router without the table is a different document shape; appending one would\n399:       // number a second section and break the checker's own reading of the file.\n400:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n401:       continue;\n402:     }\n403:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n404:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n405:     if (missing.length === 0) continue;\n406:     const lines = found.lines.slice();\n407:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n408:     next = lines.join('\\n');\n409:     added[table.kind] = missing.length;\n410:   }\n411: \n412:   return { text: next, added, notes };\n413: }\n414: \n415: // A repository with no router loads no rule at all, so the missing file is created from\n416: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n417: function renderRouter(manifest) {\n418:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n419:   return [\n420:     '# REPO RULES',\n421:     '',\n422:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n423:     'before your first write of the session. This document then routes you to every rule',\n424:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n425:     'holds no rules of its own.',\n426:     '',\n427:     '---',\n428:     '',\n429:     '## 1. HOW TO USE THIS',\n430:     '',\n431:     '1. **Match on the action you are about to take**, not the topic of the request.',\n432:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n433:     '3. **A file already in context is not re-read.**',\n434:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n435:     '',\n436:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n437:     'the same tables, authored one rule at a time.',\n438:     '',\n439:     '---',\n440:     '',\n441:     '## 2. TRIGGER TABLE',\n442:     '',\n443:     '| You are about to… | Load | It settles |',\n444:     '|-------------------|------|-----------|',\n445:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n446:     '',\n447:     '---',\n448:     '',\n449:     '## 3. INDEX',\n450:     '',\n451:     '| Rule | Summary |',\n452:     '|------|---------|',\n453:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n454:     '',\n455:     '---',\n456:     '',\n457:     'Each file the rows name is part of the installation and is replaced by a release.',\n458:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n459:     '',\n460:   ].join('\\n');\n461: }\n462: \n463: // ─────────────────────────────────────────────────────────────────────────────\n464: // 8. THE PLAN DIGEST\n465: // ─────────────────────────────────────────────────────────────────────────────\n466: \n467: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n468: // composed for and by the backup directory the plan takes: the same plan replayed against\n469: // an edited tree composes something else and cannot match, and a plan whose directory an\n470: // earlier run already owns is a different plan, so the digest covers which one it is.\n471: function planDigest(composition, plan) {\n472:   const written = composition.files\n473:     .filter((file) => file.action === 'create' || file.action === 'replace')\n474:     .map((file) => [file.path, file.action, sha256(file.content)])\n475:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n476:   const removed = composition.files\n477:     .filter((file) => file.action === 'remove')\n478:     .map((file) => [file.path, file.action, null])\n479:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n480:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n481: }\n482: \n483: // Where each line of the old document sat, so a lost line is reported with the part it\n484: // belonged to. The block wins over the section it interrupts, because those bytes are the\n485: // repository's and not the section's.\n486: function placementOf(before) {\n487:   const places = new Map();\n488:   for (const section of before.sections) {\n489:     const place = section.id === null\n490:       ? { part: 1, from: 'unmarked section' }\n491:       : { part: 2, from: section.id };\n492:     for (const index of section.rows || []) places.set(index, place);\n493:   }\n494:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n495:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n496:   if (before.block && before.block.complete && before.block.rows) {\n497:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n498:   }\n499:   return places;\n500: }\n501: \n502: // ─────────────────────────────────────────────────────────────────────────────\n503: // 9. THE PRESERVATION PROOF\n504: // ─────────────────────────────────────────────────────────────────────────────\n505: \n506: /**\n507:  * Prove that a composition lost nothing the repository had.\n508:  *\n509:  * Four claims, one per part of the returned record: every line of the old document no\n510:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n511:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n512:  * removed runtime copy still sit in the new document; and every line of the new document\n513:  * outside the block is one the template ships. Pure by construction: same inputs, same\n514:  * answer, no file read.\n515:  *\n516:  * The claim is read from the old document's own lines, in reading order, rather than from\n517:  * the parts the segmentation produced. A proof built from those parts can require only\n518:  * what the reader managed to place, so a line it placed nowhere would be required by\n519:  * nothing and a composition that lost it would still report `dropped 0`.\n520:  *\n521:  * @param {string|null} oldText - The document as it was.\n522:  * @param {string} newText - The document as it would be, or as it now is.\n523:  * @param {Object} manifest\n524:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n525:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n526:  *   foreign: Array<{line: string}>}}\n527:  */\n528: function preservationCheck(oldText, newText, manifest, options = {}) {\n529:   const markers = manifest.markers;\n530:   const dropped = [];\n531:   const knownShipped = new Set();\n532:   for (const entry of Object.values(manifest.derived.sections || {})) {\n533:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n534:   }\n535:   for (const entry of manifest.derived.history || []) {\n536:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n537:   }\n538: \n539:   // The framework's own bytes: the two markers and the heading and note that come with\n540:   // them. The new document carries one of each whatever the old one carried, so requiring\n541:   // them would report a duplicated block as repository lines the run dropped.\n542:   const framework = new Set([\n543:     markers.start.trim(),\n544:     markers.end.trim(),\n545:     markers.heading.trim(),\n546:     markers.note.trim(),\n547:   ]);\n548: \n549:   const before = oldText === null || oldText === undefined\n550:     ? { sections: [], block: null, prelude: null }\n551:     : segment(oldText, markers, manifest.sections);\n552:   const after = segment(newText, markers, manifest.sections);\n553:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n554:   const newBlockCounts = countLines(newBlock);\n555:   const newDocumentCounts = countLines(newText);\n556: \n557:   const require = (line, part, from, need) => {\n558:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n559:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n560:   };\n561: \n562:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n563:   // the new block at least as often as it was there. Where the line sat decides only which\n564:   // part names it when it goes missing.\n565:   const places = placementOf(before);\n566:   const needed = new Map();\n567:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n568:   for (let index = 0; index < oldLines.length; index += 1) {\n569:     const line = oldLines[index].trim();\n570:     if (line === '' || line === '---') continue;\n571:     if (framework.has(line) || knownShipped.has(line)) continue;\n572:     const place = places.get(index) || { part: 1, from: 'the document' };\n573:     const entry = needed.get(line);\n574:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n575:     else entry.need += 1;\n576:   }\n577:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n578: \n579:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n580:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n581:   for (const copy of options.removed || []) {\n582:     for (const [line, count] of countLines(copy.content)) {\n583:       if (framework.has(line)) continue;\n584:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n585:       require(line, 3, copy.path, count);\n586:     }\n587:   }\n588: \n589:   // Part 4. Nothing above the block that the template does not ship.\n590:   const currentOnly = new Set();\n591:   for (const entry of Object.values(manifest.derived.sections || {})) {\n592:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n593:   }\n594:   const foreign = [];\n595:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n596:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n597:   const newBytes = Buffer.from(newText, 'utf8');\n598:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n599:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n600:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n601:   for (const line of uniqueLines(outside)) {\n602:     if (!currentOnly.has(line)) foreign.push({ line });\n603:   }\n604: \n605:   return { dropped, foreign };\n606: }\n607: \n608: // ─────────────────────────────────────────────────────────────────────────────\n609: // 10. COMPOSITION\n610: // ─────────────────────────────────────────────────────────────────────────────\n611: \n612: function rowOf(report, id) {\n613:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n614: }\n615: \n616: function fileState(text) {\n617:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n618: }\n619: \n620: function historyBodyOf(manifest, hash) {\n621:   if (!hash) return null;\n622:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n623:   return entry ? entry.body : null;\n624: }\n625: \n626: function prefixEndOf(text, manifest) {\n627:   if (text === null) return 0;\n628:   const { sections } = segment(text, manifest.markers, manifest.sections);\n629:   const byId = new Map();\n630:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n631:   let end = 0;\n632:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n633:     const section = byId.get(pin.section);\n634:     if (!section) continue;\n635:     const measured = deliveryAnchorEnd(section, pin);\n636:     if (measured !== null) end = Math.max(end, measured);\n637:   }\n638:   return end;\n639: }\n640: \n641: /**\n642:  * Build every target of one repository in memory, with the ledger and the digest.\n643:  *\n644:  * Nothing here writes; the caller decides what to do with the answer.\n645:  *\n646:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n647:  * @returns {Object} the composition\n648:  */\n649: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n650:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n651:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n652: \n653:   const markers = manifest.markers;\n654:   const rootFile = manifest.root_file;\n655:   const claudePointer = `@${manifest.root_file}\\n`;\n656:   const rootPath = path.join(root, rootFile);\n657:   // Writing through a link would change a file this repository does not own, and the backup\n658:   // could not put the link back.\n659:   if (isSymlink(rootPath)) {\n660:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n661:   }\n662:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n663: \n664:   const block = oldText === null ? null : findBlock(oldText, markers);\n665:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n666:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n667:   }\n668:   if (block !== null && block.complete === false) {\n669:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n670:   }\n671: \n672:   const oldSegmentation = oldText === null\n673:     ? { sections: [], block: null, prelude: null }\n674:     : segment(oldText, markers, manifest.sections);\n675:   const oldSections = oldSegmentation.sections;\n676:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n677:   const notes = [];\n678:   const chunks = [];\n679: \n680:   // (a) Whatever the block already held.\n681:   if (block !== null && block.complete) {\n682:     const body = blockBody(block.content, markers);\n683:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n684:   }\n685: \n686:   // Text above the first heading belongs to no section, and a replacement would drop it.\n687:   // The segmenter reports it apart from the sections because no heading covers it.\n688:   if (oldSegmentation.prelude !== null) {\n689:     const preamble = chunkText(oldSegmentation.prelude.text);\n690:     if (preamble !== '') {\n691:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n692:     }\n693:   }\n694: \n695:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n696:   // the first heading is already carried as the preamble, and its byte range would reach\n697:   // a block written above the template, so it is the one entry skipped here.\n698:   const unmarkedRow = rowOf(report, 'A8');\n699:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n700:   const unmarked = unmarkedRow.entries\n701:     .filter((entry) => entry.heading !== null)\n702:     .sort((left, right) => left.byte_start - right.byte_start);\n703:   for (const entry of unmarked) {\n704:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n705:     if (text === '') continue;\n706:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n707:   }\n708: \n709:   // (c) The local lines of a section somebody edited, each under its own id.\n710:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n711:   for (const entry of edited) {\n712:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n713:     if (!section) continue;\n714:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n715:     const lines = localLinesOf(section.body, shippedBody);\n716:     if (lines.length === 0) continue;\n717:     chunks.push({\n718:       kind: 'edited',\n719:       id: entry.id,\n720:       lines: lines.length,\n721:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n722:     });\n723: \n724:     // A clean merge would leave the section edited forever, so it is offered as a reading\n725:     // of the same bytes and never as the default.\n726:     const base = historyBodyOf(manifest, entry.base);\n727:     if (base !== null) {\n728:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n729:       if (merged.conflictKind === 'mergeable') {\n730:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n731:       }\n732:     }\n733:   }\n734: \n735:   // (d) The unique lines of a runtime copy that is folded away.\n736:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n737:   const removedCopies = [];\n738:   for (const copy of copies) {\n739:     const absolute = path.join(root, copy.path);\n740:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n741:     if (copy.state !== 'FINDING') continue;\n742:     const content = fs.readFileSync(absolute, 'utf8');\n743:     // With no root document every line of the copy is its own, and the count has to survive:\n744:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n745:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n746:     if (lines.length > 0) {\n747:       chunks.push({\n748:         kind: 'copy',\n749:         path: copy.path,\n750:         lines: lines.length,\n751:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n752:       });\n753:     }\n754:     removedCopies.push({ path: copy.path, content });\n755:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n756:       removedCopies.pop();\n757:       if (lines.length > 0) {\n758:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n759:       }\n760:     }\n761:   }\n762: \n763:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n764:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n765: \n766:   // The template with nothing of the repository's own in it gains nothing from the two\n767:   // marker lines, so that difference alone is not a reason to write: the markers appear\n768:   // with the first line worth keeping.\n769:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n770:   if (templateOnly) {\n771:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n772:   }\n773: \n774:   const files = [];\n775:   if (templateOnly || oldText === composed) {\n776:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n777:   } else {\n778:     files.push({\n779:       path: rootFile,\n780:       action: oldText === null ? 'create' : 'replace',\n781:       content: composed,\n782:       before: oldText,\n783:     });\n784:   }\n785: \n786:   // The router gains the shipped rows it is missing, or is created from them when asked.\n787:   const routerPath = path.join(root, manifest.router_file);\n788:   let routerAction = 'unchanged';\n789:   let routerText = null;\n790:   if (fs.existsSync(routerPath)) {\n791:     const current = fs.readFileSync(routerPath, 'utf8');\n792:     const result = addRouterRows(current, manifest);\n793:     notes.push(...result.notes);\n794:     if (result.text !== current) {\n795:       routerText = result.text;\n796:       routerAction = 'replace';\n797:       if (result.added.trigger > 0 || result.added.index > 0) {\n798:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n799:       }\n800:     }\n801:   } else if (createRouter) {\n802:     routerText = renderRouter(manifest);\n803:     routerAction = 'create';\n804:   } else {\n805:     routerAction = 'absent';\n806:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n807:   }\n808:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n809: \n810:   // The Cursor mirror exists exactly when the block carries something, because an empty\n811:   // block has nothing a runtime that cannot read past the prefix would miss.\n812:   const mirrorPath = path.join(root, MIRROR_FILE);\n813:   const mirrorExists = fs.existsSync(mirrorPath);\n814:   let mirrorAction = 'unchanged';\n815:   let mirrorText = null;\n816:   if (blockText !== '') {\n817:     mirrorText = renderMirror(markers, blockText);\n818:     if (!mirrorExists) mirrorAction = 'create';\n819:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n820:   } else if (mirrorExists) {\n821:     mirrorAction = 'remove';\n822:   }\n823:   if (mirrorAction !== 'unchanged') {\n824:     files.push({\n825:       path: MIRROR_FILE,\n826:       action: mirrorAction,\n827:       content: mirrorText,\n828:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n829:     });\n830:   }\n831: \n832:   for (const copy of removedCopies) {\n833:     if (copy.path === CLAUDE_POINTER_PATH) {\n834:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n835:       continue;\n836:     }\n837:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n838:   }\n839: \n840:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n841:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n842:   if (\n843:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n844:     && !fs.existsSync(claudePath)\n845:     && !isSymlink(claudePath)\n846:   ) {\n847:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n848:   }\n849: \n850:   const composition = {\n851:     root,\n852:     state: report.state,\n853:     report,\n854:     markers,\n855:     rootFile,\n856:     oldText,\n857:     composed,\n858:     block: { text: renderBlock(markers, blockText), body: blockText },\n859:     chunks,\n860:     removedCopies,\n861:     notes,\n862:     files,\n863:     budget: {\n864:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n865:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n866:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n867:     },\n868:     ledger: {\n869:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n870:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n871:       shippedReplaced: manifest.sections.length,\n872:       dropped: 0,\n873:     },\n874:   };\n875: \n876:   // What the run would put on disk, which is exactly the three actions a target can take.\n877:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n878:   return composition;\n879: }\n880: \n881: // ─────────────────────────────────────────────────────────────────────────────\n882: // 11. THE WRITE ALLOWLIST\n883: // ─────────────────────────────────────────────────────────────────────────────\n884: \n885: /**\n886:  * Resolve one path a run wants to touch, or refuse it.\n887:  *\n888:  * Containment is checked before membership, so a path that climbs out of the root is\n889:  * reported as what it is rather than as a missing allowlist entry.\n890:  *\n891:  * @param {string} root\n892:  * @param {string} relative\n893:  * @returns {string} the absolute path\n894:  */\n895: function assertWritable(root, relative) {\n896:   const base = path.resolve(root);\n897:   const normalized = String(relative).split(path.sep).join('/');\n898:   const absolute = path.resolve(base, normalized);\n899:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n900:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n901:   }\n902:   if (!ALLOWLIST.includes(normalized)) {\n903:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n904:   }\n905:   // Every path a run reaches must sit inside the root where the root really is, not only\n906:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n907:   const realBase = fs.realpathSync(base);\n908:   const realTarget = resolveThroughLinks(absolute);\n909:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n910:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n911:   }\n912:   return absolute;\n913: }\n914: \n915: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n916: // and the rest of the name is appended to it.\n917: function resolveThroughLinks(absolute) {\n918:   try {\n919:     return fs.realpathSync(absolute);\n920:   } catch {\n921:     const parent = path.dirname(absolute);\n922:     if (parent === absolute) return absolute;\n923:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n924:   }\n925: }\n926: \n927: // ─────────────────────────────────────────────────────────────────────────────\n928: // 12. BACKUPS\n929: // ─────────────────────────────────────────────────────────────────────────────\n930: \n931: function utcStamp(date = new Date()) {\n932:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n933: }\n934: \n935: /**\n936:  * The directory a plan's backup sits in, named after the plan digest.\n937:  *\n938:  * Named by the digest rather than by a clock reading because apply has to land exactly\n939:  * where the plan pointed and the digest is the only thing the operator carries across. The\n940:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n941:  * taken and moves to the next ordinal instead of writing beside it.\n942:  *\n943:  * @param {string} base\n944:  * @param {string} digest\n945:  * @returns {string}\n946:  */\n947: function backupDirectoryOf(base, digest) {\n948:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n949: }\n950: \n951: /**\n952:  * Where a run's backup goes, without creating anything.\n953:  *\n954:  * The output directory is used only when git ignores it, because a backup inside a tracked\n955:  * path is a backup the next commit publishes. Everything else leaves the repository.\n956:  *\n957:  * @param {{root: string}} input\n958:  * @returns {{dir: string, fallback: boolean, reason: string}}\n959:  */\n960: function backupBase({ root }) {\n961:   const candidate = path.join(root, BACKUP_DIR);\n962:   // The question is the one the run depends on: would a plan directory under this one be\n963:   // published by the next commit? Asking about the base alone would miss a rule written as\n964:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n965:   // the probe is a path of the same shape as the one the plan takes.\n966:   const probe = path.join(candidate, 'probe');\n967:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n968:     encoding: 'utf8',\n969:     timeout: TOOL_TIMEOUT_MS,\n970:   });\n971:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n972:   const reason = ignored.status === 1\n973:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n974:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n975:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n976: }\n977: \n978: /**\n979:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n980:  * that says both.\n981:  *\n982:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n983:  * suffixed into a second name, because the printed undo command would then point at that\n984:  * run's bytes; the next ordinal is a different plan with a different digest and a\n985:  * directory of its own.\n986:  *\n987:  * @param {Object} composition\n988:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n989:  */\n990: function planFor(composition) {\n991:   const base = backupBase({ root: composition.root });\n992:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n993:     const digest = planDigest(composition, { ordinal, base: base.dir });\n994:     const dir = backupDirectoryOf(base.dir, digest);\n995:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n996:   }\n997:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n998: }\n999: \n1000: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n1001: // only these, so on a record the run wrote, a folder that was there before the run is never\n1002: // taken away with it.\n1003: function missingParents(root, relative) {\n1004:   const missing = [];\n1005:   let dir = path.posix.dirname(relative);\n1006:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1007:     missing.push(dir);\n1008:     dir = path.posix.dirname(dir);\n1009:   }\n1010:   return missing;\n1011: }\n1012: \n1013: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1014: // entry's own allowlisted path; the list stops at the first one that is not.\n1015: function recordedCreatedDirs(entry) {\n1016:   const dirs = [];\n1017:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1018:   for (const dir of entry.createdDirs) {\n1019:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1020:     dirs.push(dir);\n1021:   }\n1022:   return dirs;\n1023: }\n1024: \n1025: // Runs after every file is back, because two new files can share one new folder. Only the\n1026: // folders above a file this restore just deleted are considered, and only an empty one is\n1027: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1028: // file the run created.\n1029: function removeCreatedDirs(root, entries, deleted) {\n1030:   const removed = [];\n1031:   for (const entry of entries) {\n1032:     if (!deleted.has(entry.path)) continue;\n1033:     for (const dir of recordedCreatedDirs(entry)) {\n1034:       const absolute = path.join(root, dir);\n1035:       let names;\n1036:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1037:       if (names.length > 0) break;\n1038:       fs.rmdirSync(absolute);\n1039:       removed.push(dir);\n1040:     }\n1041:   }\n1042:   return removed;\n1043: }\n1044: \n1045: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1046: // copy rather than a reconstruction.\n1047: function backupEntry(root, file) {\n1048:   const absolute = path.join(root, file.path);\n1049:   const exists = fs.existsSync(absolute);\n1050:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1051:   if (!exists) {\n1052:     entry.createdDirs = missingParents(root, file.path);\n1053:     return entry;\n1054:   }\n1055:   const stats = fs.lstatSync(absolute);\n1056:   entry.mode = stats.mode.toString(8).slice(-4);\n1057:   entry.symlink = stats.isSymbolicLink();\n1058:   const bytes = fs.readFileSync(absolute);\n1059:   entry.sha256 = sha256(bytes.toString('utf8'));\n1060:   entry.backup = path.posix.join('files', file.path);\n[Output truncated. Continue reading with offset: 1061]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794559188665,"end":1794559189112}}}}
