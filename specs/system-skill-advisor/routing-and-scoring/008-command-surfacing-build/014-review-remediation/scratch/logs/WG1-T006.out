{"type":"tool_use","timestamp":1794559199456,"sessionID":"ses_e2bf03715ffe75FbNlphwYciok","part":{"partID":"prt_1d4104731001ZJzJOdfuqeDhx8","sessionID":"ses_e2bf03715ffe75FbNlphwYciok","messageID":"msg_1d41040d2001aIXul3b3CqYivy","type":"tool","id":"call_21a3dd86ca234090bb433967","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 1-1013\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The embed engine is the only part of this command that writes, and every line it\n8: // touches belongs to somebody else. Its value is therefore a property rather than an\n9: // output: what it showed is what it wrote, a backup exists before the first byte, and no\n10: // repository line survived only in the old file. This suite proves those properties\n11: // against synthetic repositories, and proves each failure path leaves the tree as it was.\n12: //\n13: // Every case runs on a tree composed for it from the manifest into a throwaway\n14: // directory, never on a committed document and never on this repository's own files. A\n15: // case that needs a real write path, a real router or a real copied rule corpus builds\n16: // it inside that directory, so the engine meets the same shapes it meets in a consumer\n17: // checkout without any of those shapes being committed here.\n18: //\n19: // The backup the engine leaves behind is the rollback, so the engine never deletes it.\n20: // These cases remove only the single run directory their own run created, and only after\n21: // proving it sits under the operating system's temporary directory.\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const { spawnSync } = require('node:child_process');\n29: const crypto = require('node:crypto');\n30: const fs = require('node:fs');\n31: const os = require('node:os');\n32: const path = require('node:path');\n33: const test = require('node:test');\n34: \n35: const embed = require('../agents-md-embed.cjs');\n36: const {\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   moveBlockBefore,\n42: } = require('./fixtures/agents-md/compose-fixture.cjs');\n43: \n44: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-embed.cjs');\n45: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n46: const SOURCE = fs.readFileSync(ENGINE, 'utf8');\n47: \n48: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 2. TREES, FILES AND DIGESTS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: // One composed tree per case, removed with the case. Composition reads the manifest, so\n55: // a case always describes the template that ships today.\n56: function composeTree(t, name) {\n57:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-embed-${name}-`));\n58:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n59:   const dir = path.join(parent, name);\n60:   composeFixture(name, dir);\n61:   return dir;\n62: }\n63: \n64: function listFiles(dir, prefix = '') {\n65:   const found = [];\n66:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n67:     const relative = prefix === '' ? entry.name : `${prefix}/${entry.name}`;\n68:     if (entry.isDirectory()) found.push(...listFiles(path.join(dir, entry.name), relative));\n69:     else found.push(relative);\n70:   }\n71:   return found.sort();\n72: }\n73: \n74: // Anything the engine leaves behind in a tree changes this number, which is what makes a\n75: // \"writes nothing\" claim checkable rather than promised.\n76: function treeDigest(dir) {\n77:   const hash = crypto.createHash('sha256');\n78:   for (const relative of listFiles(dir)) {\n79:     hash.update(relative);\n80:     hash.update('\\0');\n81:     hash.update(fs.readFileSync(path.join(dir, relative)));\n82:     hash.update('\\0');\n83:   }\n84:   return hash.digest('hex');\n85: }\n86: \n87: function readInside(dir, relative) {\n88:   return fs.readFileSync(path.join(dir, relative), 'utf8');\n89: }\n90: \n91: function existsInside(dir, relative) {\n92:   return fs.existsSync(path.join(dir, relative));\n93: }\n94: \n95: function writeInside(dir, relative, text) {\n96:   fs.writeFileSync(path.join(dir, relative), text, 'utf8');\n97: }\n98: \n99: function trimmedLines(text) {\n100:   return text.split('\\n').map((line) => line.trim()).filter((line) => line !== '' && line !== '---');\n101: }\n102: \n103: function occurrences(text, needle) {\n104:   let count = 0;\n105:   let at = text.indexOf(needle);\n106:   while (at !== -1) {\n107:     count += 1;\n108:     at = text.indexOf(needle, at + needle.length);\n109:   }\n110:   return count;\n111: }\n112: \n113: // The repository block of a composed document, with the markers stripped. The search runs\n114: // over lines, because a marker is the whole line: slicing between the first occurrences of\n115: // the two marker strings would cut a sentence that quotes them in half.\n116: function blockIn(text) {\n117:   const lines = text.split('\\n');\n118:   const from = lines.findIndex((line) => line.trim() === manifest.markers.start.trim());\n119:   const to = lines.findIndex((line) => line.trim() === manifest.markers.end.trim());\n120:   assert.ok(from !== -1 && to > from, 'the composed document carries one well-formed block');\n121:   return lines.slice(from + 1, to).join('\\n');\n122: }\n123: \n124: // A marker is the whole line, so a case counts whole lines: a sentence that quotes the\n125: // marker's bytes is prose, and counting substrings would read it as a second block.\n126: function markerLinesOf(text, marker) {\n127:   return text.split('\\n').filter((line) => line.trim() === marker.trim()).length;\n128: }\n129: \n130: // A line typed inside a shipped section is what makes that section an edit, and the way a\n131: // person plants one is ahead of the divider that closes the section.\n132: function insertInsideSection(text, id, line) {\n133:   const body = manifest.derived.sections[id].body;\n134:   const at = text.indexOf(body);\n135:   assert.ok(at !== -1, `the composed document carries the shipped body of ${id}`);\n136:   const divider = body.lastIndexOf('\\n---\\n');\n137:   const edited = divider === -1\n138:     ? `${body}${line}\\n`\n139:     : `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n140:   return `${text.slice(0, at)}${edited}${text.slice(at + body.length)}`;\n141: }\n142: \n143: // The engine prints one field per line, so a case reads the plan the way an operator\n144: // does instead of reaching into the engine's internals.\n145: function field(text, name) {\n146:   const match = new RegExp(`^${name}: (.*)$`, 'mu').exec(text);\n147:   return match === null ? null : match[1].trim();\n148: }\n149: \n150: function targetsOf(out) {\n151:   const targets = [];\n152:   for (const line of out.split('\\n')) {\n153:     const hit = /^target (\\S+): (create|replace|remove|unchanged)$/.exec(line);\n154:     if (hit !== null) targets.push({ path: hit[1], action: hit[2] });\n155:   }\n156:   return targets;\n157: }\n158: \n159: // ─────────────────────────────────────────────────────────────────────────────\n160: // 3. RUNNERS\n161: // ─────────────────────────────────────────────────────────────────────────────\n162: \n163: function run(args, options = {}) {\n164:   const result = spawnSync(process.execPath, [ENGINE, ...args], {\n165:     encoding: 'utf8',\n166:     input: options.input === undefined ? '' : options.input,\n167:   });\n168:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n169: }\n170: \n171: function plan(dir, extra = []) {\n172:   return run(['plan', '--root', dir, ...extra]);\n173: }\n174: \n175: function apply(dir, digest, extra = []) {\n176:   return run(['apply', '--root', dir, '--plan-digest', digest, ...extra]);\n177: }\n178: \n179: // A plan followed by the apply it authorises, which is the only supported write path.\n180: function planAndApply(dir, extra = []) {\n181:   const planned = plan(dir, extra);\n182:   assert.equal(planned.code, 0, `plan exits 0\\n${planned.err}`);\n183:   const digest = field(planned.out, 'plan-digest');\n184:   assert.match(digest || '', /^[0-9a-f]{64}$/u, 'the plan prints a sha256 digest');\n185:   const applied = apply(dir, digest, extra);\n186:   return { planned, applied, digest };\n187: }\n188: \n189: // The engine never deletes a backup, so the case does: exactly one directory, and only\n190: // when it sits under the temporary directory this run created it in.\n191: function trackBackup(t, text) {\n192:   const dir = field(text, 'backup');\n193:   if (dir === null) return null;\n194:   t.after(() => {\n195:     const temporary = os.tmpdir();\n196:     if (!dir.startsWith(temporary + path.sep)) return;\n197:     fs.rmSync(dir, { recursive: true, force: true });\n198:   });\n199:   return dir;\n200: }\n201: \n202: // ─────────────────────────────────────────────────────────────────────────────\n203: // 4. SCRIPTED WRITES THE ENGINE NEVER MAKES\n204: // ─────────────────────────────────────────────────────────────────────────────\n205: \n206: // A spy rather than a promise: the plan's own composition and report run inside this\n207: // window, so any write path the engine gained would be recorded here.\n208: function spyOnWrites(record) {\n209:   const names = ['writeFileSync', 'appendFileSync', 'mkdirSync', 'mkdtempSync', 'copyFileSync', 'rmSync', 'unlinkSync', 'renameSync', 'rmdirSync'];\n210:   const originals = new Map(names.map((name) => [name, fs[name]]));\n211:   for (const name of names) {\n212:     fs[name] = (...args) => {\n213:       record.push({ name, first: String(args[0]) });\n214:       return originals.get(name).apply(fs, args);\n215:     };\n216:   }\n217:   return () => {\n218:     for (const [name, original] of originals) fs[name] = original;\n219:   };\n220: }\n221: \n222: // ─────────────────────────────────────────────────────────────────────────────\n223: // 5. A REPOSITORY THAT CARRIES THE SHIPPED RULE CORPUS\n224: // ─────────────────────────────────────────────────────────────────────────────\n225: \n226: // The shipped rows point into `.skilled/repo-rules`, which arrives with the install. A\n227: // synthetic repository therefore needs that corpus for its router to be checkable at all,\n228: // so the case copies the installed rule files in rather than inventing rows for them. The\n229: // references those rules link to travel with the install too, so each one is resolved and\n230: // copied to the same relative path.\n231: function seedRuleCorpus(dir) {\n232:   const from = path.join(REPO_ROOT, '.skilled/repo-rules');\n233:   const to = path.join(dir, '.skilled/repo-rules');\n234:   fs.mkdirSync(to, { recursive: true });\n235:   const copied = [];\n236:   for (const name of fs.readdirSync(from)) {\n237:     if (!name.endsWith('.md')) continue;\n238:     fs.copyFileSync(path.join(from, name), path.join(to, name));\n239:     copied.push(name);\n240:   }\n241:   for (const name of copied) {\n242:     const text = fs.readFileSync(path.join(to, name), 'utf8');\n243:     for (const match of text.matchAll(/\\]\\(([^)\\s]+)\\)/gu)) {\n244:       const target = match[1].split('#')[0];\n245:       if (target === '' || /^[a-z][a-z0-9+.-]*:/iu.test(target)) continue;\n246:       const relative = path.posix.normalize(path.posix.join('.skilled/repo-rules', target));\n247:       if (fs.existsSync(path.join(dir, relative))) continue;\n248:       const source = path.join(REPO_ROOT, relative);\n249:       if (!fs.existsSync(source)) continue;\n250:       fs.mkdirSync(path.dirname(path.join(dir, relative)), { recursive: true });\n251:       fs.copyFileSync(source, path.join(dir, relative));\n252:     }\n253:   }\n254: }\n255: \n256: function shippedRows() {\n257:   return manifest.derived.repo_rules;\n258: }\n259: \n260: function renderRows(rows) {\n261:   return rows.map((cells) => `| ${cells.join(' | ')} |`).join('\\n');\n262: }\n263: \n264: // A router that carries only the first few shipped rows, which is the shape a repository\n265: // is left in when an install replaced the rules but not the router.\n266: function partialRouter(count) {\n267:   const { trigger_rows: trigger, index_rows: index } = shippedRows();\n268:   return [\n269:     '# REPO RULES',\n270:     '',\n271:     'Repo-local operating rules. This document routes you to the rule files.',\n272:     '',\n273:     '---',\n274:     '',\n275:     '## 2. TRIGGER TABLE',\n276:     '',\n277:     '| You are about to… | Load | It settles |',\n278:     '|-------------------|------|-----------|',\n279:     renderRows(trigger.slice(0, count)),\n280:     '',\n281:     '---',\n282:     '',\n283:     '## 3. INDEX',\n284:     '',\n285:     '| Rule | Summary |',\n286:     '|------|---------|',\n287:     renderRows(index.slice(0, count)),\n288:     '',\n289:     '---',\n290:     '',\n291:   ].join('\\n');\n292: }\n293: \n294: function tableRows(text, anchor) {\n295:   const lines = text.split('\\n');\n296:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n297:   assert.ok(start !== -1, `the router carries a ${anchor} table`);\n298:   const rows = [];\n299:   for (let index = start + 1; index < lines.length; index += 1) {\n300:     const line = lines[index].trim();\n301:     if (line.startsWith('#')) break;\n302:     if (line === '') {\n303:       if (rows.length > 0) break;\n304:       continue;\n305:     }\n306:     if (!line.startsWith('|')) continue;\n307:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) continue;\n308:     rows.push(line);\n309:   }\n310:   return rows.slice(1);\n311: }\n312: \n313: function runRepoRulesChecker(dir) {\n314:   const result = spawnSync(process.execPath, [REPO_RULES_CHECKER, '--root', dir], { encoding: 'utf8' });\n315:   return {\n316:     code: result.status,\n317:     out: `${result.stdout || ''}\\n${result.stderr || ''}`,\n318:   };\n319: }\n320: \n321: // ─────────────────────────────────────────────────────────────────────────────\n322: // 6. THE PLAN WRITES NOTHING\n323: // ─────────────────────────────────────────────────────────────────────────────\n324: \n325: test('a plan run records zero writes', (t) => {\n326:   const dir = composeTree(t, 'forked');\n327:   const before = treeDigest(dir);\n328: \n329:   const planned = plan(dir);\n330:   assert.equal(planned.code, 0, planned.err);\n331:   assert.equal(treeDigest(dir), before, 'a plan leaves the tree byte for byte');\n332:   assert.match(planned.out, /plan-digest: [0-9a-f]{64}/u);\n333: \n334:   // The plan names where the backup will go, so the location is reviewable, and the\n335:   // names a write path it did not take.\n336:   const backup = field(planned.out, 'backup');\n337:   assert.ok(backup, 'the plan prints the backup location');\n338:   assert.equal(fs.existsSync(backup), false, 'the plan creates no backup directory');\n339: \n340:   const writes = [];\n341:   const restore = spyOnWrites(writes);\n342:   let code;\n343:   try {\n344:     code = embed.main(['plan', '--root', dir], { log: () => {}, warn: () => {} });\n345:   } finally {\n346:     restore();\n347:   }\n348:   assert.equal(code, 0);\n349:   assert.deepEqual(writes, [], 'no write reached the filesystem during a plan');\n350:   assert.equal(treeDigest(dir), before, 'the tree is unchanged after the spy window');\n351: });\n352: \n353: // ─────────────────────────────────────────────────────────────────────────────\n354: // 7. APPLY IS GATED BY THE DIGEST\n355: // ─────────────────────────────────────────────────────────────────────────────\n356: \n357: test('apply without a plan digest exits 2 and writes nothing', (t) => {\n358:   const dir = composeTree(t, 'forked');\n359:   const before = treeDigest(dir);\n360: \n361:   const refused = run(['apply', '--root', dir]);\n362:   assert.equal(refused.code, 2, refused.out);\n363:   assert.match(refused.err, /plan-digest/u);\n364:   assert.equal(treeDigest(dir), before);\n365: });\n366: \n367: test('apply refuses a digest that the tree no longer produces', (t) => {\n368:   const dir = composeTree(t, 'forked');\n369:   const planned = plan(dir);\n370:   const digest = field(planned.out, 'plan-digest');\n371: \n372:   // The operator edits between the plan and the yes, so the shown bytes are stale.\n373:   fs.appendFileSync(path.join(dir, 'AGENTS.md'), '\\nOne more line typed after the plan.\\n');\n374:   const before = treeDigest(dir);\n375: \n376:   const refused = apply(dir, digest);\n377:   assert.equal(refused.code, 2, refused.out);\n378:   assert.match(refused.err, /digest/u);\n379:   assert.equal(treeDigest(dir), before, 'a refused apply writes nothing');\n380: });\n381: \n382: // ─────────────────────────────────────────────────────────────────────────────\n383: // 8. THE PRESERVATION INVARIANT\n384: // ─────────────────────────────────────────────────────────────────────────────\n385: \n386: test('preservationCheck reports each part of the invariant', () => {\n387:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n388:   const compose = (body) => {\n389:     const block = `${manifest.markers.start}\\n${manifest.markers.heading}\\n\\n${manifest.markers.note}\\n${body === '' ? '' : `${body}\\n`}${manifest.markers.end}\\n`;\n390:     return `${shipped}${block}`;\n391:   };\n392: \n393:   const clean = embed.preservationCheck(compose('One kept line.'), compose('One kept line.'), manifest);\n394:   assert.deepEqual(clean.dropped, []);\n395:   assert.deepEqual(clean.foreign, []);\n396: \n397:   // Part one: lines from outside every shipped section left the document.\n398:   const unmarked = `# Our own notes\\n\\nKeep this sentence.\\n`;\n399:   const partOne = embed.preservationCheck(compose(unmarked), compose(''), manifest);\n400:   assert.deepEqual(partOne.dropped.map((entry) => entry.line), ['# Our own notes', 'Keep this sentence.']);\n401:   assert.deepEqual(partOne.dropped.map((entry) => entry.part), [1, 1]);\n402: \n403:   // Part two: a line typed inside a shipped section, which no shipped body carries.\n404:   const sectionId = 's6-spec-folder';\n405:   const edited = manifest.derived.sections[sectionId].body.replace('\\n---\\n', '\\nA local tightening.\\n\\n---\\n');\n406:   const oldTwo = shipped.replace(manifest.derived.sections[sectionId].body, edited);\n407:   const partTwo = embed.preservationCheck(oldTwo, compose(''), manifest);\n408:   assert.equal(partTwo.dropped.length, 1);\n409:   assert.equal(partTwo.dropped[0].part, 2);\n410:   assert.equal(partTwo.dropped[0].line, 'A local tightening.');\n411: \n412:   // Part three: a line that only a removed copy carried.\n413:   const partThree = embed.preservationCheck(compose(''), compose(''), manifest, {\n414:     removed: [{ path: 'CLAUDE.md', content: '# Notes\\n\\nRun the checks first.\\n' }],\n415:   });\n416:   assert.deepEqual(partThree.dropped.map((entry) => entry.line), ['# Notes', 'Run the checks first.']);\n417: \n418:   // Part four: a line outside the block that the shipped template does not carry.\n419:   const foreign = embed.preservationCheck(compose(''), `A line above the block.\\n${compose('')}`, manifest);\n420:   assert.deepEqual(foreign.foreign.map((entry) => entry.line), ['A line above the block.']);\n421: });\n422: \n423: // ─────────────────────────────────────────────────────────────────────────────\n424: // 9. THE FOREIGN AND FORKED SHAPES\n425: // ─────────────────────────────────────────────────────────────────────────────\n426: \n427: test('the foreign shape keeps its whole original document inside the block', (t) => {\n428:   const dir = composeTree(t, 'foreign');\n429:   const original = readInside(dir, manifest.root_file);\n430: \n431:   const { planned, applied } = planAndApply(dir);\n432:   trackBackup(t, applied.out);\n433:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n434:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n435:   assert.match(applied.out, /STATUS=OK/u);\n436: \n437:   const composed = readInside(dir, manifest.root_file);\n438:   assert.ok(composed.startsWith(manifest.derived.sections.title.body), 'the shipped template arrives first');\n439:   const block = blockIn(composed);\n440:   assert.ok(block.includes(original.trim()), 'the original file sits inside the block verbatim');\n441:   for (const line of trimmedLines(original)) {\n442:     assert.equal(occurrences(block, line), occurrences(original, line), `${line} survives once per occurrence`);\n443:   }\n444: \n445:   // Part four, measured on the bytes that reached the disk rather than on the claim.\n446:   const checked = embed.preservationCheck(original, composed, manifest);\n447:   assert.deepEqual(checked.dropped, []);\n448:   assert.deepEqual(checked.foreign, []);\n449:   assert.match(planned.out, /BUDGET|budget: /u);\n450: });\n451: \n452: test('the forked shape carries its unmarked section before its edited section', (t) => {\n453:   const dir = composeTree(t, 'forked');\n454:   const original = readInside(dir, manifest.root_file);\n455:   const localLine = 'Local rule: name the packet in the first line of every pull request.';\n456: \n457:   const applied = planAndApply(dir).applied;\n458:   trackBackup(t, applied.out);\n459:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n460:   assert.match(applied.out, /preservation: kept \\d+, carried 0, shipped-replaced 44, dropped 0/u);\n461: \n462:   const composed = readInside(dir, manifest.root_file);\n463:   const block = blockIn(composed);\n464:   const unmarkedAt = block.indexOf('## Local release checklist');\n465:   const editedAt = block.indexOf('### Carried from s6-spec-folder');\n466:   assert.ok(unmarkedAt !== -1, 'the unmarked section is carried');\n467:   assert.ok(editedAt !== -1, 'the edited section is carried under its id');\n468:   assert.ok(unmarkedAt < editedAt, 'unmarked sections come before edited sections');\n469:   assert.equal(occurrences(composed, localLine), 1, 'the local line moved rather than duplicated');\n470:   assert.equal(occurrences(composed, 'Run `make verify` and post the result in the release channel before tagging.'), 1);\n471: \n472:   const checked = embed.preservationCheck(original, composed, manifest);\n473:   assert.deepEqual(checked.dropped, []);\n474:   assert.deepEqual(checked.foreign, []);\n475: });\n476: \n477: test('a released body is replaced with no carry', (t) => {\n478:   const dir = composeTree(t, 'stale');\n479:   const applied = planAndApply(dir).applied;\n480:   trackBackup(t, applied.out);\n481:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n482: \n483:   const composed = readInside(dir, manifest.root_file);\n484:   const current = manifest.derived.sections['operational-mandates'].body;\n485:   assert.ok(composed.includes(current), 'the current body replaced the released one');\n486:   assert.ok(!composed.includes('### Carried from operational-mandates'), 'nothing is carried from a released body');\n487: });\n488: \n489: // A block is the repository's block wherever it sits. Left above the point a rewrite cuts, its\n490: // content is the first thing a replacement loses, and every shipped section below it is\n491: // invisible, so the rewrite would duplicate them into the block instead of recognising them.\n492: test('a block placed between shipped sections is carried into the block at the end', (t) => {\n493:   const dir = composeTree(t, 'adopted');\n494:   const original = moveBlockBefore(readInside(dir, manifest.root_file), '#### The Four Laws');\n495:   writeInside(dir, manifest.root_file, original);\n496:   const carried = 'Our stack is Node 20 with no web framework.';\n497: \n498:   const applied = planAndApply(dir).applied;\n499:   trackBackup(t, applied.out);\n500:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n501:   assert.match(applied.out, /\\(state: adopted\\)/u, 'the sections below the block are recognised as the template\\'s');\n502:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n503: \n504:   const composed = readInside(dir, manifest.root_file);\n505:   assert.equal(occurrences(composed, manifest.markers.start), 1, 'exactly one block survives');\n506:   const block = blockIn(composed);\n507:   assert.equal(occurrences(block, carried), 1, 'the block content moved into the one block at the end');\n508:   assert.equal(occurrences(composed, carried), 1, 'it is not also left where it was');\n509:   for (const id of ['four-laws', 's2-mandatory-gates', 'operational-mandates']) {\n510:     assert.equal(occurrences(composed, manifest.derived.sections[id].body), 1, `the shipped body ${id} appears once, below the block`);\n511:   }\n512: \n513:   const checked = embed.preservationCheck(original, composed, manifest);\n514:   assert.deepEqual(checked.dropped, []);\n515:   assert.deepEqual(checked.foreign, []);\n516: });\n517: \n518: // The end marker is not the end of the file. A line typed below it is the repository's own,\n519: // and a rewrite that keeps only the block and the shipped sections drops it silently.\n520: test('a line after the end marker is carried into the block', (t) => {\n521:   const dir = composeTree(t, 'adopted');\n522:   const line = 'Ship the release note in the same commit as the tag.';\n523:   const original = `${readInside(dir, manifest.root_file)}${line}\\n`;\n524:   writeInside(dir, manifest.root_file, original);\n525: \n526:   const applied = planAndApply(dir).applied;\n527:   trackBackup(t, applied.out);\n528:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n529:   assert.match(applied.out, /dropped 0/u);\n530: \n531:   const composed = readInside(dir, manifest.root_file);\n532:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n533:   assert.equal(occurrences(composed, line), 1, 'it is not also left below the block');\n534: \n535:   const checked = embed.preservationCheck(original, composed, manifest);\n536:   assert.deepEqual(checked.dropped, []);\n537:   assert.deepEqual(checked.foreign, []);\n538: });\n539: \n540: // Text above the first heading belongs to no section, so nothing but the block can keep it.\n541: // Carried nowhere, it is gone at the first rewrite while the document still reads as pure.\n542: test('text before the first heading is carried into the block', (t) => {\n543:   const dir = composeTree(t, 'pure');\n544:   const line = 'Read me first.';\n545:   const original = `${line}\\n${readInside(dir, manifest.root_file)}`;\n546:   writeInside(dir, manifest.root_file, original);\n547: \n548:   const applied = planAndApply(dir).applied;\n549:   trackBackup(t, applied.out);\n550:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n551:   assert.match(applied.out, /\\(state: forked\\)/u, 'the text above the template is repository content, not a pure template');\n552:   assert.match(applied.out, /dropped 0/u);\n553: \n554:   const composed = readInside(dir, manifest.root_file);\n555:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n556:   assert.equal(occurrences(composed, line), 1, 'it is not also left above the template');\n557: \n558:   const checked = embed.preservationCheck(original, composed, manifest);\n559:   assert.deepEqual(checked.dropped, []);\n560:   assert.deepEqual(checked.foreign, []);\n561: \n562:   // The proof has to miss it too, or the next composition that drops the prelude ends in\n563:   // the same silence: the line is gone and nothing was named.\n564:   const lost = embed.preservationCheck(original, composed.replace(`${line}\\n`, ''), manifest);\n565:   assert.ok(lost.dropped.some((entry) => entry.line === line), `the proof counts the text above the template as repository content: ${JSON.stringify(lost.dropped)}`);\n566: });\n567: \n568: // ─────────────────────────────────────────────────────────────────────────────\n569: // 10. THE PROOF, AND WHAT HAPPENS WHEN IT FAILS\n570: // ─────────────────────────────────────────────────────────────────────────────\n571: \n572: // The seam stands in for a writer that loses a line: the composition is intact, the\n573: // digest matches, and the bytes that reach the disk are one line short. Only the\n574: // post-write proof can catch that, which is exactly what it exists for.\n575: function dropALineOnWrite(captured) {\n576:   return (file, content) => {\n577:     const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n578:     const text = bytes.toString('utf8');\n579:     const written = file.endsWith(manifest.root_file)\n580:       ? text.replace('- Never commit a generated file.\\n', '')\n581:       : text;\n582:     captured.push({ file, dropped: written !== text });\n583:     fs.writeFileSync(file, written, 'utf8');\n584:   };\n585: }\n586: \n587: test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:   const dir = composeTree(t, 'foreign');\n589:   const original = readInside(dir, manifest.root_file);\n590:   const out = [];\n591:   const written = [];\n592:   const hooks = {\n593:     log: (line) => out.push(line),\n594:     warn: (line) => out.push(line),\n595:     write: dropALineOnWrite(written),\n596:   };\n597: \n598:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n599:   const digest = field(out.join('\\n'), 'plan-digest');\n600:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n601:   out.length = 0;\n602: \n603:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n604:   const text = out.join('\\n');\n605:   trackBackup(t, text);\n606: \n607:   assert.equal(code, 1, 'a drop is a failed run');\n608:   assert.ok(written.some((entry) => entry.dropped), 'the seam lost a line on the way to the disk');\n609:   assert.match(text, /STATUS=FAIL/u);\n610:   assert.match(text, /- Never commit a generated file\\./u, 'the dropped line is printed');\n611:   assert.match(text, /restored/u);\n612:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n613: });\n614: \n615: // A backup that no longer matches the hash the run recorded is the one thing a restore must\n616: // refuse: copying it over the tree would replace the fault it exists to undo with a worse\n617: // one. The write hook damages the copy first, so the post-write proof has to stop before\n618: // the first file goes back and leave the tree as the failed write left it.\n619: test('a damaged backup copy stops the restore and leaves the tree as the write left it', (t) => {\n620:   const dir = composeTree(t, 'foreign');\n621:   const damaged = 'a backup copy the run did not record\\n';\n622:   const out = [];\n623:   let backup = null;\n624:   let first = true;\n625:   const hooks = {\n626:     log: (line) => out.push(line),\n627:     warn: (line) => out.push(line),\n628:     write: (file, content) => {\n629:       if (first) {\n630:         first = false;\n631:         fs.writeFileSync(path.join(backup, 'files', manifest.root_file), damaged, 'utf8');\n632:       }\n633:       const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n634:       const text = bytes.toString('utf8');\n635:       const written = file.endsWith(manifest.root_file)\n636:         ? text.replace('- Never commit a generated file.\\n', '')\n637:         : text;\n638:       fs.writeFileSync(file, written, 'utf8');\n639:     },\n640:   };\n641: \n642:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n643:   const planned = out.join('\\n');\n644:   backup = field(planned, 'backup');\n645:   assert.ok(backup, 'the plan prints the backup location');\n646:   trackBackup(t, planned);\n647:   const digest = field(planned, 'plan-digest');\n648:   out.length = 0;\n649: \n650:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n651:   const text = out.join('\\n');\n652: \n653:   assert.equal(code, 1, 'a failed restore is still a failed run');\n654:   assert.ok(\n655:     text.includes(`ERROR: the backup copy of ${manifest.root_file} does not match its recorded hash, so nothing was restored. The backup is kept at ${backup}`),\n656:     `the mismatch is named with the backup it kept\\n${text}`,\n657:   );\n658:   assert.match(text, /the write dropped 1 line\\(s\\) and the backup could not be restored, so the tree is as the write left it/u);\n659:   assert.ok(!readInside(dir, manifest.root_file).includes(damaged.trim()), 'the damaged backup copy was not written over the tree');\n660: });\n661: \n662: // A writer that throws partway through is neither a run that wrote nothing nor one that\n663: // finished: the targets before it already hold bytes, and the failed target may hold a\n664: // partial one. The backup exists by then, so the only ending that keeps the tree truthful\n665: // is to put it back, name the backup, and report the failure on an exit of its own.\n666: test('a write that throws mid-apply restores the backup and exits 3', (t) => {\n667:   const dir = composeTree(t, 'claude-only');\n668:   const before = treeDigest(dir);\n669:   const out = [];\n670:   let calls = 0;\n671:   const hooks = {\n672:     log: (line) => out.push(line),\n673:     warn: (line) => out.push(line),\n674:     write: (file, content) => {\n675:       calls += 1;\n676:       if (calls === 2) {\n677:         const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n678:         error.code = 'EACCES';\n679:         throw error;\n680:       }\n681:       fs.writeFileSync(file, content, 'utf8');\n682:     },\n683:   };\n684: \n685:   assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n686:   const digest = field(out.join('\\n'), 'plan-digest');\n687:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n688:   out.length = 0;\n689: \n690:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n691:   const text = out.join('\\n');\n692:   trackBackup(t, text);\n693: \n694:   assert.equal(calls, 2, 'the second write is the one that throws');\n695:   assert.equal(code, 3, `a write that throws after the backup is undone\\n${text}`);\n696:   assert.match(text, /EACCES/u, 'the failure names the write it could not make');\n697:   assert.match(text, /restored:/u);\n698:   assert.match(text, /^backup:/mu);\n699:   assert.match(text, /^undo:/mu);\n700:   assert.match(text, /STATUS=FAIL/u);\n701:   assert.equal(treeDigest(dir), before, 'the tree is byte for byte what it was before the apply');\n702: });\n703: \n704: test('restore puts every recorded file back byte for byte', (t) => {\n705:   const dir = composeTree(t, 'foreign');\n706:   const before = treeDigest(dir);\n707: \n708:   const applied = planAndApply(dir).applied;\n709:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n710:   const backup = trackBackup(t, applied.out);\n711:   assert.ok(fs.existsSync(backup), 'the backup exists after the run');\n712:   assert.ok(treeDigest(dir) !== before, 'the run changed the tree');\n713: \n714:   const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n715:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n716:   assert.match(restored.out, /restore: /u);\n717:   assert.equal(treeDigest(dir), before, 'every recorded file is byte-identical to its backup');\n718:   assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n719: });\n720: \n721: test('restore recreates a removed file and deletes a file the run created', (t) => {\n722:   const dir = composeTree(t, 'claude-only');\n723:   const claude = readInside(dir, 'CLAUDE.md');\n724:   const applied = planAndApply(dir).applied;\n725:   const backup = trackBackup(t, applied.out);\n726:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n727:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n', 'the folded copy became a pointer');\n728:   assert.equal(existsInside(dir, manifest.root_file), true, 'the root document was created');\n729: \n730:   const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n731:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n732:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n733:   assert.equal(existsInside(dir, manifest.root_file), false, 'the created file is removed again');\n734: });\n735: \n736: test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n737:   const fresh = composeTree(t, 'claude-only');\n738:   const freshApplied = planAndApply(fresh).applied;\n739:   assert.equal(freshApplied.code, 0, `${freshApplied.err}${freshApplied.out}`);\n740:   const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n741:   assert.equal(freshRestored.code, 0, `${freshRestored.err}${freshRestored.out}`);\n742:   assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n743: \n744:   const kept = composeTree(t, 'claude-only');\n745:   fs.mkdirSync(path.join(kept, '.cursor'));\n746:   const keptApplied = planAndApply(kept).applied;\n747:   assert.equal(keptApplied.code, 0, `${keptApplied.err}${keptApplied.out}`);\n748:   const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n749:   assert.equal(keptRestored.code, 0, `${keptRestored.err}${keptRestored.out}`);\n750:   assert.equal(existsInside(kept, '.cursor'), true, 'an empty folder that predates the run stays');\n751:   assert.equal(existsInside(kept, '.cursor/rules'), false, 'the folder the run made inside it is gone');\n752: });\n753: \n754: test('restore refuses a record whose root is not the one it runs against', (t) => {\n755:   const dir = composeTree(t, 'foreign');\n756:   const applied = planAndApply(dir).applied;\n757:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n758:   const backup = trackBackup(t, applied.out);\n759:   assert.match(field(applied.out, 'undo'), new RegExp(`--root ${dir.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&')}$`, 'u'), 'the printed undo names the root it needs');\n760: \n761:   const other = composeTree(t, 'foreign');\n762:   const before = treeDigest(other);\n763:   const recordPath = path.join(backup, 'manifest.json');\n764:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n765:   fs.writeFileSync(recordPath, JSON.stringify({ ...record, root: other }));\n766: \n767:   const repointed = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n768:   assert.equal(repointed.code, 2, 'a record naming another root is refused');\n769:   assert.match(repointed.err + repointed.out, /names the root/u);\n770:   assert.equal(treeDigest(other), before, 'the folder the record was repointed at is untouched');\n771: \n772:   fs.writeFileSync(recordPath, JSON.stringify(record));\n773:   const unnamed = run(['restore', `--run=${backup}`], { input: 'yes\\n' });\n774:   assert.equal(unnamed.code, 2, 'a restore of another root without --root is refused');\n775: });\n776: \n777: test('restore cancels without a yes', (t) => {\n778:   const dir = composeTree(t, 'foreign');\n779:   const applied = planAndApply(dir).applied;\n780:   const backup = trackBackup(t, applied.out);\n781:   const afterApply = treeDigest(dir);\n782: \n783:   const cancelled = run(['restore', `--run=${backup}`, '--root', dir], { input: 'no\\n' });\n784:   assert.equal(cancelled.code, 1, 'a cancelled restore is not a completed one');\n785:   assert.match(cancelled.out, /cancelled/u);\n786:   assert.equal(treeDigest(dir), afterApply, 'a cancelled restore writes nothing');\n787: });\n788: \n789: // ─────────────────────────────────────────────────────────────────────────────\n790: // 11. IDEMPOTENCE\n791: // ─────────────────────────────────────────────────────────────────────────────\n792: \n793: test('a second run prints NOTHING TO DO', (t) => {\n794:   const dir = composeTree(t, 'foreign');\n795:   const first = planAndApply(dir);\n796:   trackBackup(t, first.applied.out);\n797:   assert.equal(first.applied.code, 0, `${first.applied.err}${first.applied.out}`);\n798:   const afterApply = treeDigest(dir);\n799: \n800:   const second = plan(dir);\n801:   assert.equal(second.code, 0, second.err);\n802:   assert.match(second.out, /NOTHING TO DO/u);\n803:   assert.equal(treeDigest(dir), afterApply);\n804: \n805:   // The writing target gives the same answer: a digest from the first plan names a\n806:   // composition that no longer differs from the tree, so there is nothing to authorise.\n807:   const again = run(['apply', '--root', dir, '--plan-digest', first.digest]);\n808:   assert.equal(again.code, 0, again.err);\n809:   assert.match(again.out, /NOTHING TO DO/u);\n810:   assert.equal(treeDigest(dir), afterApply);\n811: });\n812: \n813: test('a plan on the source repository prints NOTHING TO DO', () => {\n814:   const planned = plan(REPO_ROOT);\n815:   assert.equal(planned.code, 0, planned.err);\n816:   assert.match(planned.out, /NOTHING TO DO/u);\n817: });\n818: \n819: // ─────────────────────────────────────────────────────────────────────────────\n820: // 12. THE WRITE ALLOWLIST\n821: // ─────────────────────────────────────────────────────────────────────────────\n822: \n823: test('every written path is inside the allowlist and a path outside it is refused', (t) => {\n824:   const dir = composeTree(t, 'adopted');\n825:   // A second copy of the shipped rules, so the router's rows resolve and the run has a\n826:   // mirror and a removal to perform as well as the root document.\n827:   seedRuleCorpus(dir);\n828:   fs.writeFileSync(path.join(dir, manifest.router_file), partialRouter(3), 'utf8');\n829: \n830:   const { planned, applied } = planAndApply(dir);\n831:   trackBackup(t, applied.out);\n832:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n833: \n834:   const written = targetsOf(planned.out).filter((entry) => entry.action !== 'unchanged');\n835:   assert.ok(written.length > 0, 'the plan names what it will write');\n836:   for (const entry of written) {\n837:     assert.ok(embed.ALLOWLIST.includes(entry.path), `${entry.path} is on the allowlist`);\n838:   }\n839: \n840:   assert.doesNotThrow(() => embed.assertWritable(dir, manifest.root_file));\n841:   assert.throws(() => embed.assertWritable(dir, '.skilled/repo-rules/scope-discipline.md'), /allowlist/u);\n842:   assert.throws(() => embed.assertWritable(dir, '../outside-the-root.md'), /outside/u);\n843:   assert.throws(() => embed.assertWritable(dir, '.cursorrules'), /allowlist/u);\n844: });\n845: \n846: // A root document that is a link is the one shape where writing would change a file this\n847: // repository does not own, so the run refuses before it backs anything up.\n848: test('a symlinked root document is refused', (t) => {\n849:   const dir = composeTree(t, 'absent');\n850:   const target = path.join(path.dirname(dir), 'shared-agents.md');\n851:   const shared = '# Shared instructions\\n\\nOne line of a file this tree does not own.\\n';\n852:   fs.writeFileSync(target, shared, 'utf8');\n853:   fs.symlinkSync(target, path.join(dir, manifest.root_file));\n854: \n855:   const refused = plan(dir);\n856:   assert.equal(refused.code, 2, refused.out);\n857:   assert.match(refused.err, /symlink/u);\n858:   assert.equal(fs.readFileSync(target, 'utf8'), shared, 'the linked file is untouched');\n859: });\n860: \n861: test('.codex/AGENTS.md is folded into the block and then removed', (t) => {\n862:   const dir = composeTree(t, 'adopted');\n863:   fs.mkdirSync(path.join(dir, '.codex'), { recursive: true });\n864:   fs.writeFileSync(path.join(dir, '.codex/AGENTS.md'), '# Codex notes\\n\\nAsk before regenerating the fixtures.\\n', 'utf8');\n865: \n866:   const applied = planAndApply(dir).applied;\n867:   trackBackup(t, applied.out);\n868:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n869:   assert.equal(existsInside(dir, '.codex/AGENTS.md'), false);\n870:   const block = blockIn(readInside(dir, manifest.root_file));\n871:   assert.match(block, /### Carried from \\.codex\\/AGENTS\\.md/u);\n872:   assert.match(block, /Ask before regenerating the fixtures\\./u);\n873: });\n874: \n875: // ─────────────────────────────────────────────────────────────────────────────\n876: // 13. THE BACKUP LOCATION\n877: // ─────────────────────────────────────────────────────────────────────────────\n878: \n879: test('an ignored output path holds the backup and a non-ignored one falls back', (t) => {\n880:   const dir = composeTree(t, 'forked');\n881: \n882:   // The tree is not a git checkout, so the ignore check cannot match and the backup has\n883:   // to leave the repository rather than land somewhere git would commit.\n884:   const planned = plan(dir);\n885:   const backup = field(planned.out, 'backup');\n886:   assert.ok(backup, 'the plan prints the backup location');\n887:   assert.ok(backup.startsWith(os.tmpdir() + path.sep), `${backup} is outside the tree`);\n888:   assert.match(planned.out, /backup-fallback: /u);\n889: \n890:   // This repository ignores its output directory, so the same question answers with the\n891:   // path the operator expects there, and the answer creates nothing.\n892:   const here = embed.backupBase({ root: REPO_ROOT });\n893:   assert.equal(here.fallback, false, here.reason);\n894:   assert.equal(here.dir, path.join(REPO_ROOT, '.skilled', 'output', 'doctor-agents-md'));\n895:   assert.equal(fs.existsSync(here.dir), false, 'naming a backup location creates nothing');\n896: });\n897: \n898: test('the backup survives the run and records what it holds', (t) => {\n899:   const dir = composeTree(t, 'foreign');\n900:   const original = readInside(dir, manifest.root_file);\n901:   const applied = planAndApply(dir).applied;\n902:   const backup = trackBackup(t, applied.out);\n903:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n904: \n905:   assert.ok(fs.existsSync(backup), 'the run leaves the backup in place');\n906:   const record = JSON.parse(fs.readFileSync(path.join(backup, 'manifest.json'), 'utf8'));\n907:   assert.match(record.plan_digest, /^[0-9a-f]{64}$/u);\n908:   const entry = record.paths.find((item) => item.path === manifest.root_file);\n909:   assert.equal(entry.existed, true);\n910:   assert.equal(entry.sha256, crypto.createHash('sha256').update(original, 'utf8').digest('hex'));\n911: \n912:   // The engine stages and commits nothing: the restore command is the whole undo.\n913:   assert.doesNotMatch(SOURCE, /git (add|commit|stash)\\b/u);\n914: });\n915: \n916: // ─────────────────────────────────────────────────────────────────────────────\n917: // 14. THE CLAUDE COPY\n918: // ─────────────────────────────────────────────────────────────────────────────\n919: \n920: test('claude-only creates the root document and removes the copy', (t) => {\n921:   const dir = composeTree(t, 'claude-only');\n922:   // The same sentence twice in the copy stays twice in the block, because the proof counts\n923:   // occurrences rather than membership.\n924:   fs.appendFileSync(path.join(dir, 'CLAUDE.md'), 'Run `make check` before you open a pull request.\\n');\n925:   const claude = readInside(dir, 'CLAUDE.md');\n926: \n927:   const applied = planAndApply(dir).applied;\n928:   trackBackup(t, applied.out);\n929:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n930:   assert.equal(existsInside(dir, manifest.root_file), true);\n931:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n932: \n933:   const composed = readInside(dir, manifest.root_file);\n934:   const block = blockIn(composed);\n935:   for (const line of trimmedLines(claude)) {\n936:     assert.equal(occurrences(block, line), occurrences(claude, line), `${line} survives once per occurrence`);\n937:   }\n938: });\n939: \n940: test('--keep-claude-md keeps the copy it folded', (t) => {\n941:   const dir = composeTree(t, 'claude-only');\n942:   const claude = readInside(dir, 'CLAUDE.md');\n943: \n944:   const applied = planAndApply(dir, ['--keep-claude-md']).applied;\n945:   trackBackup(t, applied.out);\n946:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n947:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the copy is untouched');\n948:   const block = blockIn(readInside(dir, manifest.root_file));\n949:   assert.ok(block.includes('Run `make check` before you open a pull request.'), 'and its lines still reached the block');\n950: });\n951: \n952: // Claude Code reads only CLAUDE.md, so a tree that has no copy at all still needs one line\n953: // pointing at the root document this run writes.\n954: test('an adopted tree with no CLAUDE.md gains the pointer', (t) => {\n955:   const dir = composeTree(t, 'adopted');\n956:   fs.rmSync(path.join(dir, 'CLAUDE.md'));\n957: \n958:   const applied = planAndApply(dir).applied;\n959:   trackBackup(t, applied.out);\n960:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n961:   assert.match(applied.out, /wrote AGENTS\\.md/u, 'the run writes the root document');\n962:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n963: });\n964: \n965: // ─────────────────────────────────────────────────────────────────────────────\n966: // 15. THE ROUTER\n967: // ─────────────────────────────────────────────────────────────────────────────\n968: \n969: test('a router missing shipped rows gains exactly those rows', (t) => {\n970:   const dir = composeTree(t, 'pure');\n971:   seedRuleCorpus(dir);\n972:   const partial = partialRouter(3);\n973:   fs.writeFileSync(path.join(dir, manifest.router_file), partial, 'utf8');\n974: \n975:   const applied = planAndApply(dir).applied;\n976:   trackBackup(t, applied.out);\n977:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n978: \n979:   const router = readInside(dir, manifest.router_file);\n980:   for (const line of partial.split('\\n').filter((entry) => entry.trim() !== '')) {\n981:     assert.ok(router.includes(line), `${line} was not touched`);\n982:   }\n983:   assert.equal(tableRows(router, 'TRIGGER TABLE').length, shippedRows().trigger_rows.length);\n984:   assert.equal(tableRows(router, 'INDEX').length, shippedRows().index_rows.length);\n985: \n986:   const checked = runRepoRulesChecker(dir);\n987:   assert.equal(checked.code, 0, checked.out);\n988:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n989: });\n990: \n991: test('a missing router is created only when asked for', (t) => {\n992:   const dir = composeTree(t, 'pure');\n993:   seedRuleCorpus(dir);\n994: \n995:   const quiet = plan(dir);\n996:   assert.equal(quiet.code, 0, quiet.err);\n997:   assert.match(quiet.out, /NOTHING TO DO/u);\n998:   assert.equal(existsInside(dir, manifest.router_file), false);\n999: \n1000:   const applied = planAndApply(dir, ['--create-router']).applied;\n1001:   trackBackup(t, applied.out);\n1002:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1003:   assert.equal(existsInside(dir, manifest.router_file), true);\n1004: \n1005:   const checked = runRepoRulesChecker(dir);\n1006:   assert.equal(checked.code, 0, checked.out);\n1007:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n1008: });\n1009: \n1010: // ─────────────────────────────────────────────────────────────────────────────\n1011: // 16. THE CURSOR MIRROR\n1012: // ─────────────────────────────────────────────────────────────────────────────\n1013: \n[Output truncated. Continue reading with offset: 1014]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 1-1013\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The embed engine is the only part of this command that writes, and every line it\n8: // touches belongs to somebody else. Its value is therefore a property rather than an\n9: // output: what it showed is what it wrote, a backup exists before the first byte, and no\n10: // repository line survived only in the old file. This suite proves those properties\n11: // against synthetic repositories, and proves each failure path leaves the tree as it was.\n12: //\n13: // Every case runs on a tree composed for it from the manifest into a throwaway\n14: // directory, never on a committed document and never on this repository's own files. A\n15: // case that needs a real write path, a real router or a real copied rule corpus builds\n16: // it inside that directory, so the engine meets the same shapes it meets in a consumer\n17: // checkout without any of those shapes being committed here.\n18: //\n19: // The backup the engine leaves behind is the rollback, so the engine never deletes it.\n20: // These cases remove only the single run directory their own run created, and only after\n21: // proving it sits under the operating system's temporary directory.\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const { spawnSync } = require('node:child_process');\n29: const crypto = require('node:crypto');\n30: const fs = require('node:fs');\n31: const os = require('node:os');\n32: const path = require('node:path');\n33: const test = require('node:test');\n34: \n35: const embed = require('../agents-md-embed.cjs');\n36: const {\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   moveBlockBefore,\n42: } = require('./fixtures/agents-md/compose-fixture.cjs');\n43: \n44: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-embed.cjs');\n45: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n46: const SOURCE = fs.readFileSync(ENGINE, 'utf8');\n47: \n48: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 2. TREES, FILES AND DIGESTS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: // One composed tree per case, removed with the case. Composition reads the manifest, so\n55: // a case always describes the template that ships today.\n56: function composeTree(t, name) {\n57:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-embed-${name}-`));\n58:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n59:   const dir = path.join(parent, name);\n60:   composeFixture(name, dir);\n61:   return dir;\n62: }\n63: \n64: function listFiles(dir, prefix = '') {\n65:   const found = [];\n66:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n67:     const relative = prefix === '' ? entry.name : `${prefix}/${entry.name}`;\n68:     if (entry.isDirectory()) found.push(...listFiles(path.join(dir, entry.name), relative));\n69:     else found.push(relative);\n70:   }\n71:   return found.sort();\n72: }\n73: \n74: // Anything the engine leaves behind in a tree changes this number, which is what makes a\n75: // \"writes nothing\" claim checkable rather than promised.\n76: function treeDigest(dir) {\n77:   const hash = crypto.createHash('sha256');\n78:   for (const relative of listFiles(dir)) {\n79:     hash.update(relative);\n80:     hash.update('\\0');\n81:     hash.update(fs.readFileSync(path.join(dir, relative)));\n82:     hash.update('\\0');\n83:   }\n84:   return hash.digest('hex');\n85: }\n86: \n87: function readInside(dir, relative) {\n88:   return fs.readFileSync(path.join(dir, relative), 'utf8');\n89: }\n90: \n91: function existsInside(dir, relative) {\n92:   return fs.existsSync(path.join(dir, relative));\n93: }\n94: \n95: function writeInside(dir, relative, text) {\n96:   fs.writeFileSync(path.join(dir, relative), text, 'utf8');\n97: }\n98: \n99: function trimmedLines(text) {\n100:   return text.split('\\n').map((line) => line.trim()).filter((line) => line !== '' && line !== '---');\n101: }\n102: \n103: function occurrences(text, needle) {\n104:   let count = 0;\n105:   let at = text.indexOf(needle);\n106:   while (at !== -1) {\n107:     count += 1;\n108:     at = text.indexOf(needle, at + needle.length);\n109:   }\n110:   return count;\n111: }\n112: \n113: // The repository block of a composed document, with the markers stripped. The search runs\n114: // over lines, because a marker is the whole line: slicing between the first occurrences of\n115: // the two marker strings would cut a sentence that quotes them in half.\n116: function blockIn(text) {\n117:   const lines = text.split('\\n');\n118:   const from = lines.findIndex((line) => line.trim() === manifest.markers.start.trim());\n119:   const to = lines.findIndex((line) => line.trim() === manifest.markers.end.trim());\n120:   assert.ok(from !== -1 && to > from, 'the composed document carries one well-formed block');\n121:   return lines.slice(from + 1, to).join('\\n');\n122: }\n123: \n124: // A marker is the whole line, so a case counts whole lines: a sentence that quotes the\n125: // marker's bytes is prose, and counting substrings would read it as a second block.\n126: function markerLinesOf(text, marker) {\n127:   return text.split('\\n').filter((line) => line.trim() === marker.trim()).length;\n128: }\n129: \n130: // A line typed inside a shipped section is what makes that section an edit, and the way a\n131: // person plants one is ahead of the divider that closes the section.\n132: function insertInsideSection(text, id, line) {\n133:   const body = manifest.derived.sections[id].body;\n134:   const at = text.indexOf(body);\n135:   assert.ok(at !== -1, `the composed document carries the shipped body of ${id}`);\n136:   const divider = body.lastIndexOf('\\n---\\n');\n137:   const edited = divider === -1\n138:     ? `${body}${line}\\n`\n139:     : `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n140:   return `${text.slice(0, at)}${edited}${text.slice(at + body.length)}`;\n141: }\n142: \n143: // The engine prints one field per line, so a case reads the plan the way an operator\n144: // does instead of reaching into the engine's internals.\n145: function field(text, name) {\n146:   const match = new RegExp(`^${name}: (.*)$`, 'mu').exec(text);\n147:   return match === null ? null : match[1].trim();\n148: }\n149: \n150: function targetsOf(out) {\n151:   const targets = [];\n152:   for (const line of out.split('\\n')) {\n153:     const hit = /^target (\\S+): (create|replace|remove|unchanged)$/.exec(line);\n154:     if (hit !== null) targets.push({ path: hit[1], action: hit[2] });\n155:   }\n156:   return targets;\n157: }\n158: \n159: // ─────────────────────────────────────────────────────────────────────────────\n160: // 3. RUNNERS\n161: // ─────────────────────────────────────────────────────────────────────────────\n162: \n163: function run(args, options = {}) {\n164:   const result = spawnSync(process.execPath, [ENGINE, ...args], {\n165:     encoding: 'utf8',\n166:     input: options.input === undefined ? '' : options.input,\n167:   });\n168:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n169: }\n170: \n171: function plan(dir, extra = []) {\n172:   return run(['plan', '--root', dir, ...extra]);\n173: }\n174: \n175: function apply(dir, digest, extra = []) {\n176:   return run(['apply', '--root', dir, '--plan-digest', digest, ...extra]);\n177: }\n178: \n179: // A plan followed by the apply it authorises, which is the only supported write path.\n180: function planAndApply(dir, extra = []) {\n181:   const planned = plan(dir, extra);\n182:   assert.equal(planned.code, 0, `plan exits 0\\n${planned.err}`);\n183:   const digest = field(planned.out, 'plan-digest');\n184:   assert.match(digest || '', /^[0-9a-f]{64}$/u, 'the plan prints a sha256 digest');\n185:   const applied = apply(dir, digest, extra);\n186:   return { planned, applied, digest };\n187: }\n188: \n189: // The engine never deletes a backup, so the case does: exactly one directory, and only\n190: // when it sits under the temporary directory this run created it in.\n191: function trackBackup(t, text) {\n192:   const dir = field(text, 'backup');\n193:   if (dir === null) return null;\n194:   t.after(() => {\n195:     const temporary = os.tmpdir();\n196:     if (!dir.startsWith(temporary + path.sep)) return;\n197:     fs.rmSync(dir, { recursive: true, force: true });\n198:   });\n199:   return dir;\n200: }\n201: \n202: // ─────────────────────────────────────────────────────────────────────────────\n203: // 4. SCRIPTED WRITES THE ENGINE NEVER MAKES\n204: // ─────────────────────────────────────────────────────────────────────────────\n205: \n206: // A spy rather than a promise: the plan's own composition and report run inside this\n207: // window, so any write path the engine gained would be recorded here.\n208: function spyOnWrites(record) {\n209:   const names = ['writeFileSync', 'appendFileSync', 'mkdirSync', 'mkdtempSync', 'copyFileSync', 'rmSync', 'unlinkSync', 'renameSync', 'rmdirSync'];\n210:   const originals = new Map(names.map((name) => [name, fs[name]]));\n211:   for (const name of names) {\n212:     fs[name] = (...args) => {\n213:       record.push({ name, first: String(args[0]) });\n214:       return originals.get(name).apply(fs, args);\n215:     };\n216:   }\n217:   return () => {\n218:     for (const [name, original] of originals) fs[name] = original;\n219:   };\n220: }\n221: \n222: // ─────────────────────────────────────────────────────────────────────────────\n223: // 5. A REPOSITORY THAT CARRIES THE SHIPPED RULE CORPUS\n224: // ─────────────────────────────────────────────────────────────────────────────\n225: \n226: // The shipped rows point into `.skilled/repo-rules`, which arrives with the install. A\n227: // synthetic repository therefore needs that corpus for its router to be checkable at all,\n228: // so the case copies the installed rule files in rather than inventing rows for them. The\n229: // references those rules link to travel with the install too, so each one is resolved and\n230: // copied to the same relative path.\n231: function seedRuleCorpus(dir) {\n232:   const from = path.join(REPO_ROOT, '.skilled/repo-rules');\n233:   const to = path.join(dir, '.skilled/repo-rules');\n234:   fs.mkdirSync(to, { recursive: true });\n235:   const copied = [];\n236:   for (const name of fs.readdirSync(from)) {\n237:     if (!name.endsWith('.md')) continue;\n238:     fs.copyFileSync(path.join(from, name), path.join(to, name));\n239:     copied.push(name);\n240:   }\n241:   for (const name of copied) {\n242:     const text = fs.readFileSync(path.join(to, name), 'utf8');\n243:     for (const match of text.matchAll(/\\]\\(([^)\\s]+)\\)/gu)) {\n244:       const target = match[1].split('#')[0];\n245:       if (target === '' || /^[a-z][a-z0-9+.-]*:/iu.test(target)) continue;\n246:       const relative = path.posix.normalize(path.posix.join('.skilled/repo-rules', target));\n247:       if (fs.existsSync(path.join(dir, relative))) continue;\n248:       const source = path.join(REPO_ROOT, relative);\n249:       if (!fs.existsSync(source)) continue;\n250:       fs.mkdirSync(path.dirname(path.join(dir, relative)), { recursive: true });\n251:       fs.copyFileSync(source, path.join(dir, relative));\n252:     }\n253:   }\n254: }\n255: \n256: function shippedRows() {\n257:   return manifest.derived.repo_rules;\n258: }\n259: \n260: function renderRows(rows) {\n261:   return rows.map((cells) => `| ${cells.join(' | ')} |`).join('\\n');\n262: }\n263: \n264: // A router that carries only the first few shipped rows, which is the shape a repository\n265: // is left in when an install replaced the rules but not the router.\n266: function partialRouter(count) {\n267:   const { trigger_rows: trigger, index_rows: index } = shippedRows();\n268:   return [\n269:     '# REPO RULES',\n270:     '',\n271:     'Repo-local operating rules. This document routes you to the rule files.',\n272:     '',\n273:     '---',\n274:     '',\n275:     '## 2. TRIGGER TABLE',\n276:     '',\n277:     '| You are about to… | Load | It settles |',\n278:     '|-------------------|------|-----------|',\n279:     renderRows(trigger.slice(0, count)),\n280:     '',\n281:     '---',\n282:     '',\n283:     '## 3. INDEX',\n284:     '',\n285:     '| Rule | Summary |',\n286:     '|------|---------|',\n287:     renderRows(index.slice(0, count)),\n288:     '',\n289:     '---',\n290:     '',\n291:   ].join('\\n');\n292: }\n293: \n294: function tableRows(text, anchor) {\n295:   const lines = text.split('\\n');\n296:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n297:   assert.ok(start !== -1, `the router carries a ${anchor} table`);\n298:   const rows = [];\n299:   for (let index = start + 1; index < lines.length; index += 1) {\n300:     const line = lines[index].trim();\n301:     if (line.startsWith('#')) break;\n302:     if (line === '') {\n303:       if (rows.length > 0) break;\n304:       continue;\n305:     }\n306:     if (!line.startsWith('|')) continue;\n307:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) continue;\n308:     rows.push(line);\n309:   }\n310:   return rows.slice(1);\n311: }\n312: \n313: function runRepoRulesChecker(dir) {\n314:   const result = spawnSync(process.execPath, [REPO_RULES_CHECKER, '--root', dir], { encoding: 'utf8' });\n315:   return {\n316:     code: result.status,\n317:     out: `${result.stdout || ''}\\n${result.stderr || ''}`,\n318:   };\n319: }\n320: \n321: // ─────────────────────────────────────────────────────────────────────────────\n322: // 6. THE PLAN WRITES NOTHING\n323: // ─────────────────────────────────────────────────────────────────────────────\n324: \n325: test('a plan run records zero writes', (t) => {\n326:   const dir = composeTree(t, 'forked');\n327:   const before = treeDigest(dir);\n328: \n329:   const planned = plan(dir);\n330:   assert.equal(planned.code, 0, planned.err);\n331:   assert.equal(treeDigest(dir), before, 'a plan leaves the tree byte for byte');\n332:   assert.match(planned.out, /plan-digest: [0-9a-f]{64}/u);\n333: \n334:   // The plan names where the backup will go, so the location is reviewable, and the\n335:   // names a write path it did not take.\n336:   const backup = field(planned.out, 'backup');\n337:   assert.ok(backup, 'the plan prints the backup location');\n338:   assert.equal(fs.existsSync(backup), false, 'the plan creates no backup directory');\n339: \n340:   const writes = [];\n341:   const restore = spyOnWrites(writes);\n342:   let code;\n343:   try {\n344:     code = embed.main(['plan', '--root', dir], { log: () => {}, warn: () => {} });\n345:   } finally {\n346:     restore();\n347:   }\n348:   assert.equal(code, 0);\n349:   assert.deepEqual(writes, [], 'no write reached the filesystem during a plan');\n350:   assert.equal(treeDigest(dir), before, 'the tree is unchanged after the spy window');\n351: });\n352: \n353: // ─────────────────────────────────────────────────────────────────────────────\n354: // 7. APPLY IS GATED BY THE DIGEST\n355: // ─────────────────────────────────────────────────────────────────────────────\n356: \n357: test('apply without a plan digest exits 2 and writes nothing', (t) => {\n358:   const dir = composeTree(t, 'forked');\n359:   const before = treeDigest(dir);\n360: \n361:   const refused = run(['apply', '--root', dir]);\n362:   assert.equal(refused.code, 2, refused.out);\n363:   assert.match(refused.err, /plan-digest/u);\n364:   assert.equal(treeDigest(dir), before);\n365: });\n366: \n367: test('apply refuses a digest that the tree no longer produces', (t) => {\n368:   const dir = composeTree(t, 'forked');\n369:   const planned = plan(dir);\n370:   const digest = field(planned.out, 'plan-digest');\n371: \n372:   // The operator edits between the plan and the yes, so the shown bytes are stale.\n373:   fs.appendFileSync(path.join(dir, 'AGENTS.md'), '\\nOne more line typed after the plan.\\n');\n374:   const before = treeDigest(dir);\n375: \n376:   const refused = apply(dir, digest);\n377:   assert.equal(refused.code, 2, refused.out);\n378:   assert.match(refused.err, /digest/u);\n379:   assert.equal(treeDigest(dir), before, 'a refused apply writes nothing');\n380: });\n381: \n382: // ─────────────────────────────────────────────────────────────────────────────\n383: // 8. THE PRESERVATION INVARIANT\n384: // ─────────────────────────────────────────────────────────────────────────────\n385: \n386: test('preservationCheck reports each part of the invariant', () => {\n387:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n388:   const compose = (body) => {\n389:     const block = `${manifest.markers.start}\\n${manifest.markers.heading}\\n\\n${manifest.markers.note}\\n${body === '' ? '' : `${body}\\n`}${manifest.markers.end}\\n`;\n390:     return `${shipped}${block}`;\n391:   };\n392: \n393:   const clean = embed.preservationCheck(compose('One kept line.'), compose('One kept line.'), manifest);\n394:   assert.deepEqual(clean.dropped, []);\n395:   assert.deepEqual(clean.foreign, []);\n396: \n397:   // Part one: lines from outside every shipped section left the document.\n398:   const unmarked = `# Our own notes\\n\\nKeep this sentence.\\n`;\n399:   const partOne = embed.preservationCheck(compose(unmarked), compose(''), manifest);\n400:   assert.deepEqual(partOne.dropped.map((entry) => entry.line), ['# Our own notes', 'Keep this sentence.']);\n401:   assert.deepEqual(partOne.dropped.map((entry) => entry.part), [1, 1]);\n402: \n403:   // Part two: a line typed inside a shipped section, which no shipped body carries.\n404:   const sectionId = 's6-spec-folder';\n405:   const edited = manifest.derived.sections[sectionId].body.replace('\\n---\\n', '\\nA local tightening.\\n\\n---\\n');\n406:   const oldTwo = shipped.replace(manifest.derived.sections[sectionId].body, edited);\n407:   const partTwo = embed.preservationCheck(oldTwo, compose(''), manifest);\n408:   assert.equal(partTwo.dropped.length, 1);\n409:   assert.equal(partTwo.dropped[0].part, 2);\n410:   assert.equal(partTwo.dropped[0].line, 'A local tightening.');\n411: \n412:   // Part three: a line that only a removed copy carried.\n413:   const partThree = embed.preservationCheck(compose(''), compose(''), manifest, {\n414:     removed: [{ path: 'CLAUDE.md', content: '# Notes\\n\\nRun the checks first.\\n' }],\n415:   });\n416:   assert.deepEqual(partThree.dropped.map((entry) => entry.line), ['# Notes', 'Run the checks first.']);\n417: \n418:   // Part four: a line outside the block that the shipped template does not carry.\n419:   const foreign = embed.preservationCheck(compose(''), `A line above the block.\\n${compose('')}`, manifest);\n420:   assert.deepEqual(foreign.foreign.map((entry) => entry.line), ['A line above the block.']);\n421: });\n422: \n423: // ─────────────────────────────────────────────────────────────────────────────\n424: // 9. THE FOREIGN AND FORKED SHAPES\n425: // ─────────────────────────────────────────────────────────────────────────────\n426: \n427: test('the foreign shape keeps its whole original document inside the block', (t) => {\n428:   const dir = composeTree(t, 'foreign');\n429:   const original = readInside(dir, manifest.root_file);\n430: \n431:   const { planned, applied } = planAndApply(dir);\n432:   trackBackup(t, applied.out);\n433:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n434:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n435:   assert.match(applied.out, /STATUS=OK/u);\n436: \n437:   const composed = readInside(dir, manifest.root_file);\n438:   assert.ok(composed.startsWith(manifest.derived.sections.title.body), 'the shipped template arrives first');\n439:   const block = blockIn(composed);\n440:   assert.ok(block.includes(original.trim()), 'the original file sits inside the block verbatim');\n441:   for (const line of trimmedLines(original)) {\n442:     assert.equal(occurrences(block, line), occurrences(original, line), `${line} survives once per occurrence`);\n443:   }\n444: \n445:   // Part four, measured on the bytes that reached the disk rather than on the claim.\n446:   const checked = embed.preservationCheck(original, composed, manifest);\n447:   assert.deepEqual(checked.dropped, []);\n448:   assert.deepEqual(checked.foreign, []);\n449:   assert.match(planned.out, /BUDGET|budget: /u);\n450: });\n451: \n452: test('the forked shape carries its unmarked section before its edited section', (t) => {\n453:   const dir = composeTree(t, 'forked');\n454:   const original = readInside(dir, manifest.root_file);\n455:   const localLine = 'Local rule: name the packet in the first line of every pull request.';\n456: \n457:   const applied = planAndApply(dir).applied;\n458:   trackBackup(t, applied.out);\n459:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n460:   assert.match(applied.out, /preservation: kept \\d+, carried 0, shipped-replaced 44, dropped 0/u);\n461: \n462:   const composed = readInside(dir, manifest.root_file);\n463:   const block = blockIn(composed);\n464:   const unmarkedAt = block.indexOf('## Local release checklist');\n465:   const editedAt = block.indexOf('### Carried from s6-spec-folder');\n466:   assert.ok(unmarkedAt !== -1, 'the unmarked section is carried');\n467:   assert.ok(editedAt !== -1, 'the edited section is carried under its id');\n468:   assert.ok(unmarkedAt < editedAt, 'unmarked sections come before edited sections');\n469:   assert.equal(occurrences(composed, localLine), 1, 'the local line moved rather than duplicated');\n470:   assert.equal(occurrences(composed, 'Run `make verify` and post the result in the release channel before tagging.'), 1);\n471: \n472:   const checked = embed.preservationCheck(original, composed, manifest);\n473:   assert.deepEqual(checked.dropped, []);\n474:   assert.deepEqual(checked.foreign, []);\n475: });\n476: \n477: test('a released body is replaced with no carry', (t) => {\n478:   const dir = composeTree(t, 'stale');\n479:   const applied = planAndApply(dir).applied;\n480:   trackBackup(t, applied.out);\n481:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n482: \n483:   const composed = readInside(dir, manifest.root_file);\n484:   const current = manifest.derived.sections['operational-mandates'].body;\n485:   assert.ok(composed.includes(current), 'the current body replaced the released one');\n486:   assert.ok(!composed.includes('### Carried from operational-mandates'), 'nothing is carried from a released body');\n487: });\n488: \n489: // A block is the repository's block wherever it sits. Left above the point a rewrite cuts, its\n490: // content is the first thing a replacement loses, and every shipped section below it is\n491: // invisible, so the rewrite would duplicate them into the block instead of recognising them.\n492: test('a block placed between shipped sections is carried into the block at the end', (t) => {\n493:   const dir = composeTree(t, 'adopted');\n494:   const original = moveBlockBefore(readInside(dir, manifest.root_file), '#### The Four Laws');\n495:   writeInside(dir, manifest.root_file, original);\n496:   const carried = 'Our stack is Node 20 with no web framework.';\n497: \n498:   const applied = planAndApply(dir).applied;\n499:   trackBackup(t, applied.out);\n500:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n501:   assert.match(applied.out, /\\(state: adopted\\)/u, 'the sections below the block are recognised as the template\\'s');\n502:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n503: \n504:   const composed = readInside(dir, manifest.root_file);\n505:   assert.equal(occurrences(composed, manifest.markers.start), 1, 'exactly one block survives');\n506:   const block = blockIn(composed);\n507:   assert.equal(occurrences(block, carried), 1, 'the block content moved into the one block at the end');\n508:   assert.equal(occurrences(composed, carried), 1, 'it is not also left where it was');\n509:   for (const id of ['four-laws', 's2-mandatory-gates', 'operational-mandates']) {\n510:     assert.equal(occurrences(composed, manifest.derived.sections[id].body), 1, `the shipped body ${id} appears once, below the block`);\n511:   }\n512: \n513:   const checked = embed.preservationCheck(original, composed, manifest);\n514:   assert.deepEqual(checked.dropped, []);\n515:   assert.deepEqual(checked.foreign, []);\n516: });\n517: \n518: // The end marker is not the end of the file. A line typed below it is the repository's own,\n519: // and a rewrite that keeps only the block and the shipped sections drops it silently.\n520: test('a line after the end marker is carried into the block', (t) => {\n521:   const dir = composeTree(t, 'adopted');\n522:   const line = 'Ship the release note in the same commit as the tag.';\n523:   const original = `${readInside(dir, manifest.root_file)}${line}\\n`;\n524:   writeInside(dir, manifest.root_file, original);\n525: \n526:   const applied = planAndApply(dir).applied;\n527:   trackBackup(t, applied.out);\n528:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n529:   assert.match(applied.out, /dropped 0/u);\n530: \n531:   const composed = readInside(dir, manifest.root_file);\n532:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n533:   assert.equal(occurrences(composed, line), 1, 'it is not also left below the block');\n534: \n535:   const checked = embed.preservationCheck(original, composed, manifest);\n536:   assert.deepEqual(checked.dropped, []);\n537:   assert.deepEqual(checked.foreign, []);\n538: });\n539: \n540: // Text above the first heading belongs to no section, so nothing but the block can keep it.\n541: // Carried nowhere, it is gone at the first rewrite while the document still reads as pure.\n542: test('text before the first heading is carried into the block', (t) => {\n543:   const dir = composeTree(t, 'pure');\n544:   const line = 'Read me first.';\n545:   const original = `${line}\\n${readInside(dir, manifest.root_file)}`;\n546:   writeInside(dir, manifest.root_file, original);\n547: \n548:   const applied = planAndApply(dir).applied;\n549:   trackBackup(t, applied.out);\n550:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n551:   assert.match(applied.out, /\\(state: forked\\)/u, 'the text above the template is repository content, not a pure template');\n552:   assert.match(applied.out, /dropped 0/u);\n553: \n554:   const composed = readInside(dir, manifest.root_file);\n555:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n556:   assert.equal(occurrences(composed, line), 1, 'it is not also left above the template');\n557: \n558:   const checked = embed.preservationCheck(original, composed, manifest);\n559:   assert.deepEqual(checked.dropped, []);\n560:   assert.deepEqual(checked.foreign, []);\n561: \n562:   // The proof has to miss it too, or the next composition that drops the prelude ends in\n563:   // the same silence: the line is gone and nothing was named.\n564:   const lost = embed.preservationCheck(original, composed.replace(`${line}\\n`, ''), manifest);\n565:   assert.ok(lost.dropped.some((entry) => entry.line === line), `the proof counts the text above the template as repository content: ${JSON.stringify(lost.dropped)}`);\n566: });\n567: \n568: // ─────────────────────────────────────────────────────────────────────────────\n569: // 10. THE PROOF, AND WHAT HAPPENS WHEN IT FAILS\n570: // ─────────────────────────────────────────────────────────────────────────────\n571: \n572: // The seam stands in for a writer that loses a line: the composition is intact, the\n573: // digest matches, and the bytes that reach the disk are one line short. Only the\n574: // post-write proof can catch that, which is exactly what it exists for.\n575: function dropALineOnWrite(captured) {\n576:   return (file, content) => {\n577:     const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n578:     const text = bytes.toString('utf8');\n579:     const written = file.endsWith(manifest.root_file)\n580:       ? text.replace('- Never commit a generated file.\\n', '')\n581:       : text;\n582:     captured.push({ file, dropped: written !== text });\n583:     fs.writeFileSync(file, written, 'utf8');\n584:   };\n585: }\n586: \n587: test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:   const dir = composeTree(t, 'foreign');\n589:   const original = readInside(dir, manifest.root_file);\n590:   const out = [];\n591:   const written = [];\n592:   const hooks = {\n593:     log: (line) => out.push(line),\n594:     warn: (line) => out.push(line),\n595:     write: dropALineOnWrite(written),\n596:   };\n597: \n598:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n599:   const digest = field(out.join('\\n'), 'plan-digest');\n600:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n601:   out.length = 0;\n602: \n603:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n604:   const text = out.join('\\n');\n605:   trackBackup(t, text);\n606: \n607:   assert.equal(code, 1, 'a drop is a failed run');\n608:   assert.ok(written.some((entry) => entry.dropped), 'the seam lost a line on the way to the disk');\n609:   assert.match(text, /STATUS=FAIL/u);\n610:   assert.match(text, /- Never commit a generated file\\./u, 'the dropped line is printed');\n611:   assert.match(text, /restored/u);\n612:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n613: });\n614: \n615: // A backup that no longer matches the hash the run recorded is the one thing a restore must\n616: // refuse: copying it over the tree would replace the fault it exists to undo with a worse\n617: // one. The write hook damages the copy first, so the post-write proof has to stop before\n618: // the first file goes back and leave the tree as the failed write left it.\n619: test('a damaged backup copy stops the restore and leaves the tree as the write left it', (t) => {\n620:   const dir = composeTree(t, 'foreign');\n621:   const damaged = 'a backup copy the run did not record\\n';\n622:   const out = [];\n623:   let backup = null;\n624:   let first = true;\n625:   const hooks = {\n626:     log: (line) => out.push(line),\n627:     warn: (line) => out.push(line),\n628:     write: (file, content) => {\n629:       if (first) {\n630:         first = false;\n631:         fs.writeFileSync(path.join(backup, 'files', manifest.root_file), damaged, 'utf8');\n632:       }\n633:       const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n634:       const text = bytes.toString('utf8');\n635:       const written = file.endsWith(manifest.root_file)\n636:         ? text.replace('- Never commit a generated file.\\n', '')\n637:         : text;\n638:       fs.writeFileSync(file, written, 'utf8');\n639:     },\n640:   };\n641: \n642:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n643:   const planned = out.join('\\n');\n644:   backup = field(planned, 'backup');\n645:   assert.ok(backup, 'the plan prints the backup location');\n646:   trackBackup(t, planned);\n647:   const digest = field(planned, 'plan-digest');\n648:   out.length = 0;\n649: \n650:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n651:   const text = out.join('\\n');\n652: \n653:   assert.equal(code, 1, 'a failed restore is still a failed run');\n654:   assert.ok(\n655:     text.includes(`ERROR: the backup copy of ${manifest.root_file} does not match its recorded hash, so nothing was restored. The backup is kept at ${backup}`),\n656:     `the mismatch is named with the backup it kept\\n${text}`,\n657:   );\n658:   assert.match(text, /the write dropped 1 line\\(s\\) and the backup could not be restored, so the tree is as the write left it/u);\n659:   assert.ok(!readInside(dir, manifest.root_file).includes(damaged.trim()), 'the damaged backup copy was not written over the tree');\n660: });\n661: \n662: // A writer that throws partway through is neither a run that wrote nothing nor one that\n663: // finished: the targets before it already hold bytes, and the failed target may hold a\n664: // partial one. The backup exists by then, so the only ending that keeps the tree truthful\n665: // is to put it back, name the backup, and report the failure on an exit of its own.\n666: test('a write that throws mid-apply restores the backup and exits 3', (t) => {\n667:   const dir = composeTree(t, 'claude-only');\n668:   const before = treeDigest(dir);\n669:   const out = [];\n670:   let calls = 0;\n671:   const hooks = {\n672:     log: (line) => out.push(line),\n673:     warn: (line) => out.push(line),\n674:     write: (file, content) => {\n675:       calls += 1;\n676:       if (calls === 2) {\n677:         const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n678:         error.code = 'EACCES';\n679:         throw error;\n680:       }\n681:       fs.writeFileSync(file, content, 'utf8');\n682:     },\n683:   };\n684: \n685:   assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n686:   const digest = field(out.join('\\n'), 'plan-digest');\n687:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n688:   out.length = 0;\n689: \n690:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n691:   const text = out.join('\\n');\n692:   trackBackup(t, text);\n693: \n694:   assert.equal(calls, 2, 'the second write is the one that throws');\n695:   assert.equal(code, 3, `a write that throws after the backup is undone\\n${text}`);\n696:   assert.match(text, /EACCES/u, 'the failure names the write it could not make');\n697:   assert.match(text, /restored:/u);\n698:   assert.match(text, /^backup:/mu);\n699:   assert.match(text, /^undo:/mu);\n700:   assert.match(text, /STATUS=FAIL/u);\n701:   assert.equal(treeDigest(dir), before, 'the tree is byte for byte what it was before the apply');\n702: });\n703: \n704: test('restore puts every recorded file back byte for byte', (t) => {\n705:   const dir = composeTree(t, 'foreign');\n706:   const before = treeDigest(dir);\n707: \n708:   const applied = planAndApply(dir).applied;\n709:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n710:   const backup = trackBackup(t, applied.out);\n711:   assert.ok(fs.existsSync(backup), 'the backup exists after the run');\n712:   assert.ok(treeDigest(dir) !== before, 'the run changed the tree');\n713: \n714:   const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n715:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n716:   assert.match(restored.out, /restore: /u);\n717:   assert.equal(treeDigest(dir), before, 'every recorded file is byte-identical to its backup');\n718:   assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n719: });\n720: \n721: test('restore recreates a removed file and deletes a file the run created', (t) => {\n722:   const dir = composeTree(t, 'claude-only');\n723:   const claude = readInside(dir, 'CLAUDE.md');\n724:   const applied = planAndApply(dir).applied;\n725:   const backup = trackBackup(t, applied.out);\n726:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n727:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n', 'the folded copy became a pointer');\n728:   assert.equal(existsInside(dir, manifest.root_file), true, 'the root document was created');\n729: \n730:   const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n731:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n732:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n733:   assert.equal(existsInside(dir, manifest.root_file), false, 'the created file is removed again');\n734: });\n735: \n736: test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n737:   const fresh = composeTree(t, 'claude-only');\n738:   const freshApplied = planAndApply(fresh).applied;\n739:   assert.equal(freshApplied.code, 0, `${freshApplied.err}${freshApplied.out}`);\n740:   const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n741:   assert.equal(freshRestored.code, 0, `${freshRestored.err}${freshRestored.out}`);\n742:   assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n743: \n744:   const kept = composeTree(t, 'claude-only');\n745:   fs.mkdirSync(path.join(kept, '.cursor'));\n746:   const keptApplied = planAndApply(kept).applied;\n747:   assert.equal(keptApplied.code, 0, `${keptApplied.err}${keptApplied.out}`);\n748:   const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n749:   assert.equal(keptRestored.code, 0, `${keptRestored.err}${keptRestored.out}`);\n750:   assert.equal(existsInside(kept, '.cursor'), true, 'an empty folder that predates the run stays');\n751:   assert.equal(existsInside(kept, '.cursor/rules'), false, 'the folder the run made inside it is gone');\n752: });\n753: \n754: test('restore refuses a record whose root is not the one it runs against', (t) => {\n755:   const dir = composeTree(t, 'foreign');\n756:   const applied = planAndApply(dir).applied;\n757:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n758:   const backup = trackBackup(t, applied.out);\n759:   assert.match(field(applied.out, 'undo'), new RegExp(`--root ${dir.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&')}$`, 'u'), 'the printed undo names the root it needs');\n760: \n761:   const other = composeTree(t, 'foreign');\n762:   const before = treeDigest(other);\n763:   const recordPath = path.join(backup, 'manifest.json');\n764:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n765:   fs.writeFileSync(recordPath, JSON.stringify({ ...record, root: other }));\n766: \n767:   const repointed = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n768:   assert.equal(repointed.code, 2, 'a record naming another root is refused');\n769:   assert.match(repointed.err + repointed.out, /names the root/u);\n770:   assert.equal(treeDigest(other), before, 'the folder the record was repointed at is untouched');\n771: \n772:   fs.writeFileSync(recordPath, JSON.stringify(record));\n773:   const unnamed = run(['restore', `--run=${backup}`], { input: 'yes\\n' });\n774:   assert.equal(unnamed.code, 2, 'a restore of another root without --root is refused');\n775: });\n776: \n777: test('restore cancels without a yes', (t) => {\n778:   const dir = composeTree(t, 'foreign');\n779:   const applied = planAndApply(dir).applied;\n780:   const backup = trackBackup(t, applied.out);\n781:   const afterApply = treeDigest(dir);\n782: \n783:   const cancelled = run(['restore', `--run=${backup}`, '--root', dir], { input: 'no\\n' });\n784:   assert.equal(cancelled.code, 1, 'a cancelled restore is not a completed one');\n785:   assert.match(cancelled.out, /cancelled/u);\n786:   assert.equal(treeDigest(dir), afterApply, 'a cancelled restore writes nothing');\n787: });\n788: \n789: // ─────────────────────────────────────────────────────────────────────────────\n790: // 11. IDEMPOTENCE\n791: // ─────────────────────────────────────────────────────────────────────────────\n792: \n793: test('a second run prints NOTHING TO DO', (t) => {\n794:   const dir = composeTree(t, 'foreign');\n795:   const first = planAndApply(dir);\n796:   trackBackup(t, first.applied.out);\n797:   assert.equal(first.applied.code, 0, `${first.applied.err}${first.applied.out}`);\n798:   const afterApply = treeDigest(dir);\n799: \n800:   const second = plan(dir);\n801:   assert.equal(second.code, 0, second.err);\n802:   assert.match(second.out, /NOTHING TO DO/u);\n803:   assert.equal(treeDigest(dir), afterApply);\n804: \n805:   // The writing target gives the same answer: a digest from the first plan names a\n806:   // composition that no longer differs from the tree, so there is nothing to authorise.\n807:   const again = run(['apply', '--root', dir, '--plan-digest', first.digest]);\n808:   assert.equal(again.code, 0, again.err);\n809:   assert.match(again.out, /NOTHING TO DO/u);\n810:   assert.equal(treeDigest(dir), afterApply);\n811: });\n812: \n813: test('a plan on the source repository prints NOTHING TO DO', () => {\n814:   const planned = plan(REPO_ROOT);\n815:   assert.equal(planned.code, 0, planned.err);\n816:   assert.match(planned.out, /NOTHING TO DO/u);\n817: });\n818: \n819: // ─────────────────────────────────────────────────────────────────────────────\n820: // 12. THE WRITE ALLOWLIST\n821: // ─────────────────────────────────────────────────────────────────────────────\n822: \n823: test('every written path is inside the allowlist and a path outside it is refused', (t) => {\n824:   const dir = composeTree(t, 'adopted');\n825:   // A second copy of the shipped rules, so the router's rows resolve and the run has a\n826:   // mirror and a removal to perform as well as the root document.\n827:   seedRuleCorpus(dir);\n828:   fs.writeFileSync(path.join(dir, manifest.router_file), partialRouter(3), 'utf8');\n829: \n830:   const { planned, applied } = planAndApply(dir);\n831:   trackBackup(t, applied.out);\n832:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n833: \n834:   const written = targetsOf(planned.out).filter((entry) => entry.action !== 'unchanged');\n835:   assert.ok(written.length > 0, 'the plan names what it will write');\n836:   for (const entry of written) {\n837:     assert.ok(embed.ALLOWLIST.includes(entry.path), `${entry.path} is on the allowlist`);\n838:   }\n839: \n840:   assert.doesNotThrow(() => embed.assertWritable(dir, manifest.root_file));\n841:   assert.throws(() => embed.assertWritable(dir, '.skilled/repo-rules/scope-discipline.md'), /allowlist/u);\n842:   assert.throws(() => embed.assertWritable(dir, '../outside-the-root.md'), /outside/u);\n843:   assert.throws(() => embed.assertWritable(dir, '.cursorrules'), /allowlist/u);\n844: });\n845: \n846: // A root document that is a link is the one shape where writing would change a file this\n847: // repository does not own, so the run refuses before it backs anything up.\n848: test('a symlinked root document is refused', (t) => {\n849:   const dir = composeTree(t, 'absent');\n850:   const target = path.join(path.dirname(dir), 'shared-agents.md');\n851:   const shared = '# Shared instructions\\n\\nOne line of a file this tree does not own.\\n';\n852:   fs.writeFileSync(target, shared, 'utf8');\n853:   fs.symlinkSync(target, path.join(dir, manifest.root_file));\n854: \n855:   const refused = plan(dir);\n856:   assert.equal(refused.code, 2, refused.out);\n857:   assert.match(refused.err, /symlink/u);\n858:   assert.equal(fs.readFileSync(target, 'utf8'), shared, 'the linked file is untouched');\n859: });\n860: \n861: test('.codex/AGENTS.md is folded into the block and then removed', (t) => {\n862:   const dir = composeTree(t, 'adopted');\n863:   fs.mkdirSync(path.join(dir, '.codex'), { recursive: true });\n864:   fs.writeFileSync(path.join(dir, '.codex/AGENTS.md'), '# Codex notes\\n\\nAsk before regenerating the fixtures.\\n', 'utf8');\n865: \n866:   const applied = planAndApply(dir).applied;\n867:   trackBackup(t, applied.out);\n868:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n869:   assert.equal(existsInside(dir, '.codex/AGENTS.md'), false);\n870:   const block = blockIn(readInside(dir, manifest.root_file));\n871:   assert.match(block, /### Carried from \\.codex\\/AGENTS\\.md/u);\n872:   assert.match(block, /Ask before regenerating the fixtures\\./u);\n873: });\n874: \n875: // ─────────────────────────────────────────────────────────────────────────────\n876: // 13. THE BACKUP LOCATION\n877: // ─────────────────────────────────────────────────────────────────────────────\n878: \n879: test('an ignored output path holds the backup and a non-ignored one falls back', (t) => {\n880:   const dir = composeTree(t, 'forked');\n881: \n882:   // The tree is not a git checkout, so the ignore check cannot match and the backup has\n883:   // to leave the repository rather than land somewhere git would commit.\n884:   const planned = plan(dir);\n885:   const backup = field(planned.out, 'backup');\n886:   assert.ok(backup, 'the plan prints the backup location');\n887:   assert.ok(backup.startsWith(os.tmpdir() + path.sep), `${backup} is outside the tree`);\n888:   assert.match(planned.out, /backup-fallback: /u);\n889: \n890:   // This repository ignores its output directory, so the same question answers with the\n891:   // path the operator expects there, and the answer creates nothing.\n892:   const here = embed.backupBase({ root: REPO_ROOT });\n893:   assert.equal(here.fallback, false, here.reason);\n894:   assert.equal(here.dir, path.join(REPO_ROOT, '.skilled', 'output', 'doctor-agents-md'));\n895:   assert.equal(fs.existsSync(here.dir), false, 'naming a backup location creates nothing');\n896: });\n897: \n898: test('the backup survives the run and records what it holds', (t) => {\n899:   const dir = composeTree(t, 'foreign');\n900:   const original = readInside(dir, manifest.root_file);\n901:   const applied = planAndApply(dir).applied;\n902:   const backup = trackBackup(t, applied.out);\n903:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n904: \n905:   assert.ok(fs.existsSync(backup), 'the run leaves the backup in place');\n906:   const record = JSON.parse(fs.readFileSync(path.join(backup, 'manifest.json'), 'utf8'));\n907:   assert.match(record.plan_digest, /^[0-9a-f]{64}$/u);\n908:   const entry = record.paths.find((item) => item.path === manifest.root_file);\n909:   assert.equal(entry.existed, true);\n910:   assert.equal(entry.sha256, crypto.createHash('sha256').update(original, 'utf8').digest('hex'));\n911: \n912:   // The engine stages and commits nothing: the restore command is the whole undo.\n913:   assert.doesNotMatch(SOURCE, /git (add|commit|stash)\\b/u);\n914: });\n915: \n916: // ─────────────────────────────────────────────────────────────────────────────\n917: // 14. THE CLAUDE COPY\n918: // ─────────────────────────────────────────────────────────────────────────────\n919: \n920: test('claude-only creates the root document and removes the copy', (t) => {\n921:   const dir = composeTree(t, 'claude-only');\n922:   // The same sentence twice in the copy stays twice in the block, because the proof counts\n923:   // occurrences rather than membership.\n924:   fs.appendFileSync(path.join(dir, 'CLAUDE.md'), 'Run `make check` before you open a pull request.\\n');\n925:   const claude = readInside(dir, 'CLAUDE.md');\n926: \n927:   const applied = planAndApply(dir).applied;\n928:   trackBackup(t, applied.out);\n929:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n930:   assert.equal(existsInside(dir, manifest.root_file), true);\n931:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n932: \n933:   const composed = readInside(dir, manifest.root_file);\n934:   const block = blockIn(composed);\n935:   for (const line of trimmedLines(claude)) {\n936:     assert.equal(occurrences(block, line), occurrences(claude, line), `${line} survives once per occurrence`);\n937:   }\n938: });\n939: \n940: test('--keep-claude-md keeps the copy it folded', (t) => {\n941:   const dir = composeTree(t, 'claude-only');\n942:   const claude = readInside(dir, 'CLAUDE.md');\n943: \n944:   const applied = planAndApply(dir, ['--keep-claude-md']).applied;\n945:   trackBackup(t, applied.out);\n946:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n947:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the copy is untouched');\n948:   const block = blockIn(readInside(dir, manifest.root_file));\n949:   assert.ok(block.includes('Run `make check` before you open a pull request.'), 'and its lines still reached the block');\n950: });\n951: \n952: // Claude Code reads only CLAUDE.md, so a tree that has no copy at all still needs one line\n953: // pointing at the root document this run writes.\n954: test('an adopted tree with no CLAUDE.md gains the pointer', (t) => {\n955:   const dir = composeTree(t, 'adopted');\n956:   fs.rmSync(path.join(dir, 'CLAUDE.md'));\n957: \n958:   const applied = planAndApply(dir).applied;\n959:   trackBackup(t, applied.out);\n960:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n961:   assert.match(applied.out, /wrote AGENTS\\.md/u, 'the run writes the root document');\n962:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n963: });\n964: \n965: // ─────────────────────────────────────────────────────────────────────────────\n966: // 15. THE ROUTER\n967: // ─────────────────────────────────────────────────────────────────────────────\n968: \n969: test('a router missing shipped rows gains exactly those rows', (t) => {\n970:   const dir = composeTree(t, 'pure');\n971:   seedRuleCorpus(dir);\n972:   const partial = partialRouter(3);\n973:   fs.writeFileSync(path.join(dir, manifest.router_file), partial, 'utf8');\n974: \n975:   const applied = planAndApply(dir).applied;\n976:   trackBackup(t, applied.out);\n977:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n978: \n979:   const router = readInside(dir, manifest.router_file);\n980:   for (const line of partial.split('\\n').filter((entry) => entry.trim() !== '')) {\n981:     assert.ok(router.includes(line), `${line} was not touched`);\n982:   }\n983:   assert.equal(tableRows(router, 'TRIGGER TABLE').length, shippedRows().trigger_rows.length);\n984:   assert.equal(tableRows(router, 'INDEX').length, shippedRows().index_rows.length);\n985: \n986:   const checked = runRepoRulesChecker(dir);\n987:   assert.equal(checked.code, 0, checked.out);\n988:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n989: });\n990: \n991: test('a missing router is created only when asked for', (t) => {\n992:   const dir = composeTree(t, 'pure');\n993:   seedRuleCorpus(dir);\n994: \n995:   const quiet = plan(dir);\n996:   assert.equal(quiet.code, 0, quiet.err);\n997:   assert.match(quiet.out, /NOTHING TO DO/u);\n998:   assert.equal(existsInside(dir, manifest.router_file), false);\n999: \n1000:   const applied = planAndApply(dir, ['--create-router']).applied;\n1001:   trackBackup(t, applied.out);\n1002:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1003:   assert.equal(existsInside(dir, manifest.router_file), true);\n1004: \n1005:   const checked = runRepoRulesChecker(dir);\n1006:   assert.equal(checked.code, 0, checked.out);\n1007:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n1008: });\n1009: \n1010: // ─────────────────────────────────────────────────────────────────────────────\n1011: // 16. THE CURSOR MIRROR\n1012: // ─────────────────────────────────────────────────────────────────────────────\n1013: \n[Output truncated. Continue reading with offset: 1014]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\"}"},"time":{"start":1794559199025,"end":1794559199456}}}}
