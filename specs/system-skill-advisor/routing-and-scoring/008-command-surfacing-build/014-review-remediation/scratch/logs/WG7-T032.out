,\n      \"token\": \"as\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"doctor\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"setup\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"yaml\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"router\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"presentation\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"symlink\"\n    },\n    {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Pin the four workflow promises in a contract test reading doctor setup yaml router presentation symlink check as a node test\\\" 2>&1 | head -40\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794558679723,"end":1794558680132}}}}
