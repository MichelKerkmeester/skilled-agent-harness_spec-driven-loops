max-query-tokens\",\n      \"token\": \"check\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"disagree\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"add\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"doctor\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"symlink\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"output\"\n    },\n    {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"say which status wins when the engine and the hook-wiring check disagree, add a doctor symlink output line and a contract assertion\\\" 2>&1 | head -40\"}"},"time":{"start":1794561563296,"end":1794561564571}}}}
