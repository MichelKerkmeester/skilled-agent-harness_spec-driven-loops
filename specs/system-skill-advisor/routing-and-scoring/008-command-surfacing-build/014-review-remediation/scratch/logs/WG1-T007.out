ldReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1442: \n1443:   if (after.dropped.length > 0 || after.foreign.length > 0) {\n1444:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1445:     for (const line of renderForeign(after.foreign)) output.warn(line);\n1446:     const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1447:     if (restored === null) {\n1448:       if (after.dropped.length > 0) {\n1449:         output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n1450:       }\n1451:       if (after.foreign.length > 0) {\n1452:         output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries and the backup could not be restored, so the tree is as the write left it`);\n1453:       }\n1454:     } else {\n1455:       if (after.dropped.length > 0) {\n1456:         output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1457:       }\n1458:       if (after.foreign.length > 0) {\n1459:         output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries, so the run was undone; the backup is kept at ${plan.dir}`);\n1460:       }\n1461:     }\n1462:     output.warn('STATUS=FAIL');\n1463:     return 1;\n1464:   }\n1465: \n1466:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1467:   if (report !== null) {\n1468:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1469:   }\n1470:   output.log(`backup: ${plan.dir}`);\n1471:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1472:   for (const entry of record.paths) {\n1473:     if (!entry.existed) continue;\n1474:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1475:   }\n1476:   output.log('STATUS=OK');\n1477:   return 0;\n1478: }\n1479: \n1480: // ─────────────────────────────────────────────────────────────────────────────\n1481: // 17. RESTORE\n1482: // ─────────────────────────────────────────────────────────────────────────────\n1483: \n1484: function readConfirmation() {\n1485:   try {\n1486:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1487:   } catch {\n1488:     return '';\n1489:   }\n1490: }\n1491: \n1492: function commandRestore(options, output, hooks) {\n1493:   if (!options.run) {\n1494:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1495:     return 2;\n1496:   }\n1497:   const recordPath = path.join(options.run, 'manifest.json');\n1498:   if (!fs.existsSync(recordPath)) {\n1499:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1500:     return 2;\n1501:   }\n1502: \n1503:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1504:   const root = record.root;\n1505:   // The record names its own root, and a record is data: it is trusted only when it names\n1506:   // the root this restore runs against, so a record repointed at another folder is refused\n1507:   // instead of written to. Restoring another folder takes --root naming that folder.\n1508:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1509:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1510:     return 2;\n1511:   }\n1512:   const steps = [];\n1513:   for (const entry of record.paths) {\n1514:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1515:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1516:     const absolute = assertWritable(root, entry.path);\n1517:     if (!entry.existed) {\n1518:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1519:       continue;\n1520:     }\n1521:     const source = path.join(options.run, entry.backup);\n1522:     if (!fs.existsSync(source)) {\n1523:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1524:       return 2;\n1525:     }\n1526:     const bytes = fs.readFileSync(source);\n1527:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1528:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1529:       return 2;\n1530:     }\n1531:     steps.push({ entry, absolute, action: 'put back', bytes });\n1532:   }\n1533: \n1534:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1535:   for (const step of steps) {\n1536:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1537:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1538:       : '';\n1539:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1540:   }\n1541:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1542:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1543: \n1544:   if (options.dryRun) {\n1545:     output.log('dry-run: nothing was written');\n1546:     return 0;\n1547:   }\n1548: \n1549:   if (!options.yes) {\n1550:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1551:     if (readConfirmation() !== 'yes') {\n1552:       output.log('cancelled: no confirmation, nothing was written');\n1553:       return 1;\n1554:     }\n1555:   }\n1556: \n1557:   let touched = 0;\n1558:   const deleted = new Set();\n1559:   for (const step of steps) {\n1560:     if (step.action === 'delete') {\n1561:       fs.rmSync(step.absolute);\n1562:       deleted.add(step.entry.path);\n1563:       touched += 1;\n1564:       continue;\n1565:     }\n1566:     if (step.action === 'absent') continue;\n1567:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1568:     fs.writeFileSync(step.absolute, step.bytes);\n1569:     touched += 1;\n1570:   }\n1571:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1572: \n1573:   // Byte equality after the write, measured against the recorded hash rather than against\n1574:   // the copy that was just read.\n1575:   for (const step of steps) {\n1576:     if (step.action === 'delete' || step.action === 'absent') continue;\n1577:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1578:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1579:       output.warn('STATUS=FAIL');\n1580:       return 1;\n1581:     }\n1582:   }\n1583: \n1584:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1585:   output.log('STATUS=OK');\n1586:   return 0;\n1587: }\n1588: \n1589: // ─────────────────────────────────────────────────────────────────────────────\n1590: // 18. MAIN\n1591: // ─────────────────────────────────────────────────────────────────────────────\n1592: \n1593: function outputOf(hooks) {\n1594:   return {\n1595:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1596:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1597:   };\n1598: }\n1599: \n1600: /**\n1601:  * @param {string[]} argv\n1602:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1603:  * @returns {number} the process exit code\n1604:  */\n1605: function main(argv, hooks = {}) {\n1606:   const options = parseArgs(argv);\n1607:   const output = outputOf(hooks);\n1608:   if (options.help) {\n1609:     output.log(USAGE);\n1610:     return 0;\n1611:   }\n1612:   if (options.command === null) {\n1613:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1614:     return 2;\n1615:   }\n1616:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1617:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1618:     return 2;\n1619:   }\n1620: \n1621:   try {\n1622:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1623:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1624:     return commandRestore(options, output, hooks);\n1625:   } catch (error) {\n1626:     if (error instanceof AllowlistError) {\n1627:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1628:       return 2;\n1629:     }\n1630:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1631:       output.warn(`${TAG} ERROR: ${error.message}`);\n1632:       if (error instanceof UsageError) output.warn(USAGE);\n1633:       return 2;\n1634:     }\n1635:     throw error;\n1636:   }\n1637: }\n1638: \n1639: if (require.main === module) {\n1640:   try {\n1641:     process.exitCode = main(process.argv.slice(2));\n1642:   } catch (error) {\n1643:     console.error(`${TAG} ERROR: ${error.message}`);\n1644:     process.exitCode = 2;\n1645:   }\n1646: }\n1647: \n1648: module.exports = {\n1649:   ALLOWLIST,\n1650:   MANIFEST_PATH,\n1651:   addRouterRows,\n1652:   assertWritable,\n1653:   backupBase,\n1654:   compose,\n1655:   main,\n1656:   planDigest,\n1657:   planFor,\n1658:   preservationCheck,\n1659:   renderBlock,\n1660:   renderMirror,\n1661:   renderRouter,\n1662: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1061-1662\n1061:   return entry;\n1062: }\n1063: \n1064: function writeBackup({ root, manifest, composition, plan }) {\n1065:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1066:   // finishing first: writing beside its record would make the undo ambiguous.\n1067:   if (fs.existsSync(plan.dir)) {\n1068:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1069:   }\n1070:   fs.mkdirSync(plan.dir, { recursive: true });\n1071: \n1072:   const entries = [];\n1073:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n1074:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1075:   // would touch it, even though this engine composes nothing for it.\n1076:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1077:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1078:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1079:   }\n1080: \n1081:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1082:   // the rollback must not share a path with the writer it exists to undo.\n1083:   for (const entry of entries) {\n1084:     if (!entry.existed) continue;\n1085:     const destination = path.join(plan.dir, entry.backup);\n1086:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1087:     fs.copyFileSync(path.join(root, entry.path), destination);\n1088:   }\n1089: \n1090:   const record = {\n1091:     schema: 1,\n1092:     root,\n1093:     created_at: utcStamp(),\n1094:     plan_digest: plan.digest,\n1095:     paths: entries,\n1096:   };\n1097:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1098:   return record;\n1099: }\n1100: \n1101: // ─────────────────────────────────────────────────────────────────────────────\n1102: // 13. THE DIFF\n1103: // ─────────────────────────────────────────────────────────────────────────────\n1104: \n1105: function diffLines(text) {\n1106:   if (text === null) return [];\n1107:   const lines = String(text).split('\\n');\n1108:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1109:   return lines;\n1110: }\n1111: \n1112: function diffOps(left, right) {\n1113:   const rows = left.length + 1;\n1114:   const columns = right.length + 1;\n1115:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1116:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1117:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1118:       table[i][j] = left[i] === right[j]\n1119:         ? table[i + 1][j + 1] + 1\n1120:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1121:     }\n1122:   }\n1123:   const ops = [];\n1124:   let i = 0;\n1125:   let j = 0;\n1126:   while (i < left.length && j < right.length) {\n1127:     if (left[i] === right[j]) {\n1128:       ops.push({ kind: ' ', text: left[i] });\n1129:       i += 1;\n1130:       j += 1;\n1131:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1132:       ops.push({ kind: '-', text: left[i] });\n1133:       i += 1;\n1134:     } else {\n1135:       ops.push({ kind: '+', text: right[j] });\n1136:       j += 1;\n1137:     }\n1138:   }\n1139:   while (i < left.length) {\n1140:     ops.push({ kind: '-', text: left[i] });\n1141:     i += 1;\n1142:   }\n1143:   while (j < right.length) {\n1144:     ops.push({ kind: '+', text: right[j] });\n1145:     j += 1;\n1146:   }\n1147:   return ops;\n1148: }\n1149: \n1150: /**\n1151:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1152:  *\n1153:  * @param {string|null} beforeText\n1154:  * @param {string|null} afterText\n1155:  * @param {string} relative\n1156:  * @returns {string[]}\n1157:  */\n1158: function unifiedDiff(beforeText, afterText, relative) {\n1159:   const left = diffLines(beforeText);\n1160:   const right = diffLines(afterText);\n1161:   const ops = diffOps(left, right);\n1162:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1163: \n1164:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1165:   const hunks = [];\n1166:   for (const index of changed) {\n1167:     const start = Math.max(0, index - 3);\n1168:     const end = Math.min(ops.length, index + 4);\n1169:     const last = hunks[hunks.length - 1];\n1170:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1171:     else hunks.push({ start, end });\n1172:   }\n1173: \n1174:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1175:   let consumed = 0;\n1176:   for (const hunk of hunks) {\n1177:     // A create has no left side and a removal has no right side, so their cursors start at\n1178:     // zero rather than at the first line of a file that is not there.\n1179:     let leftCursor = beforeText === null ? 0 : 1;\n1180:     let rightCursor = afterText === null ? 0 : 1;\n1181:     for (let index = 0; index < hunk.start; index += 1) {\n1182:       if (ops[index].kind !== '+') leftCursor += 1;\n1183:       if (ops[index].kind !== '-') rightCursor += 1;\n1184:     }\n1185:     const slice = ops.slice(hunk.start, hunk.end);\n1186:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1187:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1188:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1189:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1190:     consumed += slice.length;\n1191:   }\n1192:   return consumed === 0 ? [] : output;\n1193: }\n1194: \n1195: // ─────────────────────────────────────────────────────────────────────────────\n1196: // 14. THE PLAN\n1197: // ─────────────────────────────────────────────────────────────────────────────\n1198: \n1199: function renderTargets(composition) {\n1200:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1201: }\n1202: \n1203: function renderPlan(composition, plan) {\n1204:   const lines = [];\n1205:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1206:   lines.push(...renderTargets(composition));\n1207:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1208: \n1209:   for (const file of composition.writes) {\n1210:     if (file.action === 'remove') {\n1211:       lines.push(`diff ${file.path}:`);\n1212:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1213:       continue;\n1214:     }\n1215:     const diff = unifiedDiff(file.before, file.content, file.path);\n1216:     lines.push(`diff ${file.path}:`);\n1217:     if (diff.length === 0) lines.push('  (no line changes)');\n1218:     lines.push(...diff);\n1219:   }\n1220: \n1221:   lines.push('block:');\n1222:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1223:   lines.push('block-end:');\n1224: \n1225:   const { before, after, limits } = composition.budget;\n1226:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1227:   if (after.total > limits.total) {\n1228:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1229:   }\n1230:   if (after.prefix > limits.prefix) {\n1231:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1232:   }\n1233: \n1234:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1235:   lines.push(`backup: ${plan.dir}`);\n1236:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1237:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1238:   lines.push(`plan-digest: ${plan.digest}`);\n1239:   return lines;\n1240: }\n1241: \n1242: function renderDropped(dropped) {\n1243:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1244: }\n1245: \n1246: function renderForeign(foreign) {\n1247:   return foreign.map((entry) => `foreign: ${entry.line} (outside the block and not a shipped line)`);\n1248: }\n1249: \n1250: // ─────────────────────────────────────────────────────────────────────────────\n1251: // 15. PLAN\n1252: // ─────────────────────────────────────────────────────────────────────────────\n1253: \n1254: function preflight(composition, manifest) {\n1255:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1256: }\n1257: \n1258: function commandPlan(options, output, hooks) {\n1259:   const manifest = loadManifest();\n1260:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1261: \n1262:   const checked = preflight(composition, manifest);\n1263:   composition.ledger.dropped = checked.dropped.length;\n1264: \n1265:   if (composition.writes.length === 0) {\n1266:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1267:     for (const note of composition.notes) output.log(`note: ${note}`);\n1268:     output.log('NOTHING TO DO');\n1269:     return 0;\n1270:   }\n1271: \n1272:   const plan = planFor(composition);\n1273:   for (const line of renderPlan(composition, plan)) output.log(line);\n1274:   if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n1275:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1276:     for (const line of renderForeign(checked.foreign)) output.warn(line);\n1277:     if (checked.dropped.length > 0) {\n1278:       output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1279:     }\n1280:     if (checked.foreign.length > 0) {\n1281:       output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries, so it will not be offered for writing`);\n1282:     }\n1283:     output.warn('STATUS=FAIL');\n1284:     return 1;\n1285:   }\n1286:   if (options.dryRun) output.log('dry-run: nothing was written');\n1287:   return 0;\n1288: }\n1289: \n1290: // ─────────────────────────────────────────────────────────────────────────────\n1291: // 16. APPLY\n1292: // ─────────────────────────────────────────────────────────────────────────────\n1293: \n1294: function runTool(script, args) {\n1295:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1296:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1297:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1298:   return { code: result.status, output };\n1299: }\n1300: \n1301: function restoreFromBackup({ root, dir, output }) {\n1302:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1303:   // A rollback that put a damaged copy back would replace the fault it exists to undo with\n1304:   // one the run never made, so every entry is proved against the hash recorded beside it\n1305:   // before the first path moves.\n1306:   for (const entry of record.paths) {\n1307:     assertWritable(root, entry.path);\n1308:     if (!entry.existed) continue;\n1309:     const source = path.join(dir, entry.backup);\n1310:     if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n1311:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n1312:       return null;\n1313:     }\n1314:   }\n1315:   let restored = 0;\n1316:   const deleted = new Set();\n1317:   for (const entry of record.paths) {\n1318:     const target = path.join(root, entry.path);\n1319:     if (!entry.existed) {\n1320:       if (fs.existsSync(target)) {\n1321:         fs.rmSync(target);\n1322:         deleted.add(entry.path);\n1323:       }\n1324:       continue;\n1325:     }\n1326:     const source = path.join(dir, entry.backup);\n1327:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1328:     fs.copyFileSync(source, target);\n1329:     restored += 1;\n1330:   }\n1331:   removeCreatedDirs(root, record.paths, deleted);\n1332:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1333:   return restored;\n1334: }\n1335: \n1336: function commandApply(options, output, hooks) {\n1337:   if (!options.digest) {\n1338:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1339:     return 2;\n1340:   }\n1341: \n1342:   const manifest = loadManifest();\n1343:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1344: \n1345:   // A tree already in its target state has nothing a digest could authorise.\n1346:   if (composition.writes.length === 0) {\n1347:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1348:     output.log('NOTHING TO DO');\n1349:     return 0;\n1350:   }\n1351: \n1352:   const plan = planFor(composition);\n1353:   if (plan.digest !== options.digest) {\n1354:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1355:     // already happened gets told which directory holds those bytes instead of a claim\n1356:     // about the tree that would be false.\n1357:     const held = backupDirectoryOf(plan.base, options.digest);\n1358:     if (fs.existsSync(held)) {\n1359:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1360:       return 2;\n1361:     }\n1362:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1363:     return 2;\n1364:   }\n1365: \n1366:   // The same proof the plan ran, because a composition that already loses a line must\n1367:   // never reach a backup, let alone the tree.\n1368:   const checked = preflight(composition, manifest);\n1369:   composition.ledger.dropped = checked.dropped.length;\n1370:   if (checked.dropped.length > 0 || checked.foreign.length > 0) {\n1371:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1372:     for (const line of renderForeign(checked.foreign)) output.warn(line);\n1373:     if (checked.dropped.length > 0) {\n1374:       output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1375:     }\n1376:     if (checked.foreign.length > 0) {\n1377:       output.warn(`${TAG} the composition carries ${checked.foreign.length} line(s) outside the block that no shipped section carries; nothing was written`);\n1378:     }\n1379:     output.warn('STATUS=FAIL');\n1380:     return 1;\n1381:   }\n1382: \n1383:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1384:   // the run before a backup exists rather than after a partial write.\n1385:   const targets = [];\n1386:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1387: \n1388:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1389:   // here, where every precondition has already passed and nothing has been created.\n1390:   if (options.dryRun) {\n1391:     for (const line of renderPlan(composition, plan)) output.log(line);\n1392:     output.log('dry-run: nothing was written');\n1393:     return 0;\n1394:   }\n1395: \n1396:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1397:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1398: \n1399:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1400:   let writing = null;\n1401:   try {\n1402:     for (const target of targets) {\n1403:       writing = target.file.path;\n1404:       if (target.file.action === 'remove') {\n1405:         if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1406:         output.log(`removed ${target.file.path} (backed up first)`);\n1407:         continue;\n1408:       }\n1409:       fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1410:       write(target.absolute, target.file.content);\n1411:       output.log(`wrote ${target.file.path}`);\n1412:     }\n1413:   } catch (error) {\n1414:     // The backup is the only copy of every target as the plan found it, so a throw here is\n1415:     // undone from it rather than reported as a run that never started.\n1416:     output.warn(`${TAG} ERROR: writing ${writing} failed: ${error.message}`);\n1417:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1418:     output.log(`backup: ${plan.dir}`);\n1419:     output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1420:     output.warn('STATUS=FAIL');\n1421:     return 3;\n1422:   }\n1423: \n1424:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1425:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1426:   if (rootTouched) {\n1427:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1428:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1429:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1430:   }\n1431:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1432:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1433:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1434:     output.log(`repo-rules: ${summary}`);\n1435:   }\n1436: \n1437:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1438:   const rootPath = path.join(options.root, manifest.root_file);\n1439:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1440:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1441:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1442: \n1443:   if (after.dropped.length > 0 || after.foreign.length > 0) {\n1444:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1445:     for (const line of renderForeign(after.foreign)) output.warn(line);\n1446:     const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1447:     if (restored === null) {\n1448:       if (after.dropped.length > 0) {\n1449:         output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n1450:       }\n1451:       if (after.foreign.length > 0) {\n1452:         output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries and the backup could not be restored, so the tree is as the write left it`);\n1453:       }\n1454:     } else {\n1455:       if (after.dropped.length > 0) {\n1456:         output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1457:       }\n1458:       if (after.foreign.length > 0) {\n1459:         output.warn(`${TAG} the write left ${after.foreign.length} line(s) outside the block that no shipped section carries, so the run was undone; the backup is kept at ${plan.dir}`);\n1460:       }\n1461:     }\n1462:     output.warn('STATUS=FAIL');\n1463:     return 1;\n1464:   }\n1465: \n1466:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1467:   if (report !== null) {\n1468:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1469:   }\n1470:   output.log(`backup: ${plan.dir}`);\n1471:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1472:   for (const entry of record.paths) {\n1473:     if (!entry.existed) continue;\n1474:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1475:   }\n1476:   output.log('STATUS=OK');\n1477:   return 0;\n1478: }\n1479: \n1480: // ─────────────────────────────────────────────────────────────────────────────\n1481: // 17. RESTORE\n1482: // ─────────────────────────────────────────────────────────────────────────────\n1483: \n1484: function readConfirmation() {\n1485:   try {\n1486:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1487:   } catch {\n1488:     return '';\n1489:   }\n1490: }\n1491: \n1492: function commandRestore(options, output, hooks) {\n1493:   if (!options.run) {\n1494:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1495:     return 2;\n1496:   }\n1497:   const recordPath = path.join(options.run, 'manifest.json');\n1498:   if (!fs.existsSync(recordPath)) {\n1499:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1500:     return 2;\n1501:   }\n1502: \n1503:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1504:   const root = record.root;\n1505:   // The record names its own root, and a record is data: it is trusted only when it names\n1506:   // the root this restore runs against, so a record repointed at another folder is refused\n1507:   // instead of written to. Restoring another folder takes --root naming that folder.\n1508:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1509:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1510:     return 2;\n1511:   }\n1512:   const steps = [];\n1513:   for (const entry of record.paths) {\n1514:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1515:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1516:     const absolute = assertWritable(root, entry.path);\n1517:     if (!entry.existed) {\n1518:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1519:       continue;\n1520:     }\n1521:     const source = path.join(options.run, entry.backup);\n1522:     if (!fs.existsSync(source)) {\n1523:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1524:       return 2;\n1525:     }\n1526:     const bytes = fs.readFileSync(source);\n1527:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1528:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1529:       return 2;\n1530:     }\n1531:     steps.push({ entry, absolute, action: 'put back', bytes });\n1532:   }\n1533: \n1534:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1535:   for (const step of steps) {\n1536:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1537:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1538:       : '';\n1539:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1540:   }\n1541:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1542:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1543: \n1544:   if (options.dryRun) {\n1545:     output.log('dry-run: nothing was written');\n1546:     return 0;\n1547:   }\n1548: \n1549:   if (!options.yes) {\n1550:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1551:     if (readConfirmation() !== 'yes') {\n1552:       output.log('cancelled: no confirmation, nothing was written');\n1553:       return 1;\n1554:     }\n1555:   }\n1556: \n1557:   let touched = 0;\n1558:   const deleted = new Set();\n1559:   for (const step of steps) {\n1560:     if (step.action === 'delete') {\n1561:       fs.rmSync(step.absolute);\n1562:       deleted.add(step.entry.path);\n1563:       touched += 1;\n1564:       continue;\n1565:     }\n1566:     if (step.action === 'absent') continue;\n1567:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1568:     fs.writeFileSync(step.absolute, step.bytes);\n1569:     touched += 1;\n1570:   }\n1571:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1572: \n1573:   // Byte equality after the write, measured against the recorded hash rather than against\n1574:   // the copy that was just read.\n1575:   for (const step of steps) {\n1576:     if (step.action === 'delete' || step.action === 'absent') continue;\n1577:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1578:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1579:       output.warn('STATUS=FAIL');\n1580:       return 1;\n1581:     }\n1582:   }\n1583: \n1584:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1585:   output.log('STATUS=OK');\n1586:   return 0;\n1587: }\n1588: \n1589: // ─────────────────────────────────────────────────────────────────────────────\n1590: // 18. MAIN\n1591: // ─────────────────────────────────────────────────────────────────────────────\n1592: \n1593: function outputOf(hooks) {\n1594:   return {\n1595:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1596:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1597:   };\n1598: }\n1599: \n1600: /**\n1601:  * @param {string[]} argv\n1602:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1603:  * @returns {number} the process exit code\n1604:  */\n1605: function main(argv, hooks = {}) {\n1606:   const options = parseArgs(argv);\n1607:   const output = outputOf(hooks);\n1608:   if (options.help) {\n1609:     output.log(USAGE);\n1610:     return 0;\n1611:   }\n1612:   if (options.command === null) {\n1613:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1614:     return 2;\n1615:   }\n1616:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1617:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1618:     return 2;\n1619:   }\n1620: \n1621:   try {\n1622:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1623:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1624:     return commandRestore(options, output, hooks);\n1625:   } catch (error) {\n1626:     if (error instanceof AllowlistError) {\n1627:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1628:       return 2;\n1629:     }\n1630:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1631:       output.warn(`${TAG} ERROR: ${error.message}`);\n1632:       if (error instanceof UsageError) output.warn(USAGE);\n1633:       return 2;\n1634:     }\n1635:     throw error;\n1636:   }\n1637: }\n1638: \n1639: if (require.main === module) {\n1640:   try {\n1641:     process.exitCode = main(process.argv.slice(2));\n1642:   } catch (error) {\n1643:     console.error(`${TAG} ERROR: ${error.message}`);\n1644:     process.exitCode = 2;\n1645:   }\n1646: }\n1647: \n1648: module.exports = {\n1649:   ALLOWLIST,\n1650:   MANIFEST_PATH,\n1651:   addRouterRows,\n1652:   assertWritable,\n1653:   backupBase,\n1654:   compose,\n1655:   main,\n1656:   planDigest,\n1657:   planFor,\n1658:   preservationCheck,\n1659:   renderBlock,\n1660:   renderMirror,\n1661:   renderRouter,\n1662: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\",\"offset\":1061,\"limit\":900}"},"time":{"start":1794559632445,"end":1794559634135}}}}
{"type":"tool_use","timestamp":1794559634138,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"partID":"prt_1d416e88b001YhqAceGHMwblGe","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d416b9880010IDDDZQTUrzgcD","type":"tool","id":"call_5aad05b0752b40b09bc8a6d1","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs","offset":1017,"limit":600},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 1017-1248\n1017:   for (const line of partial.split('\\n').filter((entry) => entry.trim() !== '')) {\n1018:     assert.ok(router.includes(line), `${line} was not touched`);\n1019:   }\n1020:   assert.equal(tableRows(router, 'TRIGGER TABLE').length, shippedRows().trigger_rows.length);\n1021:   assert.equal(tableRows(router, 'INDEX').length, shippedRows().index_rows.length);\n1022: \n1023:   const checked = runRepoRulesChecker(dir);\n1024:   assert.equal(checked.code, 0, checked.out);\n1025:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n1026: });\n1027: \n1028: test('a missing router is created only when asked for', (t) => {\n1029:   const dir = composeTree(t, 'pure');\n1030:   seedRuleCorpus(dir);\n1031: \n1032:   const quiet = plan(dir);\n1033:   assert.equal(quiet.code, 0, quiet.err);\n1034:   assert.match(quiet.out, /NOTHING TO DO/u);\n1035:   assert.equal(existsInside(dir, manifest.router_file), false);\n1036: \n1037:   const applied = planAndApply(dir, ['--create-router']).applied;\n1038:   trackBackup(t, applied.out);\n1039:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1040:   assert.equal(existsInside(dir, manifest.router_file), true);\n1041: \n1042:   const checked = runRepoRulesChecker(dir);\n1043:   assert.equal(checked.code, 0, checked.out);\n1044:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n1045: });\n1046: \n1047: // ─────────────────────────────────────────────────────────────────────────────\n1048: // 16. THE CURSOR MIRROR\n1049: // ─────────────────────────────────────────────────────────────────────────────\n1050: \n1051: test('.cursor/rules/repo-local.md exists exactly when the block carries content', (t) => {\n1052:   const empty = composeTree(t, 'absent');\n1053:   const emptyApplied = planAndApply(empty).applied;\n1054:   trackBackup(t, emptyApplied.out);\n1055:   assert.equal(emptyApplied.code, 0, `${emptyApplied.err}${emptyApplied.out}`);\n1056:   assert.equal(existsInside(empty, manifest.root_file), true, 'the template arrives');\n1057:   assert.equal(existsInside(empty, '.cursor/rules/repo-local.md'), false, 'an empty block has nothing to mirror');\n1058:   assert.equal(existsInside(empty, manifest.router_file), false, 'a router nobody asked for is not created');\n1059: \n1060:   const carried = composeTree(t, 'foreign');\n1061:   const carriedApplied = planAndApply(carried).applied;\n1062:   trackBackup(t, carriedApplied.out);\n1063:   assert.equal(carriedApplied.code, 0, `${carriedApplied.err}${carriedApplied.out}`);\n1064:   const mirror = readInside(carried, '.cursor/rules/repo-local.md');\n1065:   assert.match(mirror, /^---\\nalwaysApply: true\\n---\\n/u);\n1066:   for (const line of trimmedLines(blockIn(readInside(carried, manifest.root_file)))) {\n1067:     assert.ok(mirror.includes(line), `${line} reaches the mirror`);\n1068:   }\n1069: });\n1070: \n1071: // ─────────────────────────────────────────────────────────────────────────────\n1072: // 17. THE MARKER LINE, AND THE PROOF THAT READS THE DOCUMENT'S OWN LINES\n1073: // ─────────────────────────────────────────────────────────────────────────────\n1074: \n1075: // A sentence that quotes both markers is how a repository documents the block. Reading\n1076: // those bytes as the block would put its edges in the middle of that line, and the text on\n1077: // either side belongs to no section, to no prelude and to the block's own span: a rewrite\n1078: // deletes it and no part of the proof is left that could name what went.\n1079: const QUOTED = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n1080: \n1081: test('a sentence quoting both markers is repository content, not the block', (t) => {\n1082:   const dir = composeTree(t, 'pure');\n1083:   const original = insertInsideSection(readInside(dir, manifest.root_file), 's2-mandatory-gates', QUOTED);\n1084:   writeInside(dir, manifest.root_file, original);\n1085: \n1086:   const applied = planAndApply(dir).applied;\n1087:   trackBackup(t, applied.out);\n1088:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1089:   assert.match(applied.out, /dropped 0/u, 'the run loses nothing');\n1090: \n1091:   const composed = readInside(dir, manifest.root_file);\n1092:   assert.equal(occurrences(composed, QUOTED), 1, 'the sentence survives exactly once');\n1093:   assert.ok(blockIn(composed).includes(QUOTED), 'it sits in the block as the repository content it is');\n1094:   assert.notEqual(blockIn(composed).trim(), '` and `', 'the marker literals are not read as the block edges');\n1095:   assert.equal(markerLinesOf(composed, manifest.markers.start), 1, 'the document carries one start marker line');\n1096:   assert.equal(markerLinesOf(composed, manifest.markers.end), 1, 'and one end marker line');\n1097: \n1098:   const checked = embed.preservationCheck(original, composed, manifest);\n1099:   assert.deepEqual(checked.dropped, []);\n1100:   assert.deepEqual(checked.foreign, []);\n1101: });\n1102: \n1103: // The proof has to read the old document's own lines. Built from the segmentation's\n1104: // parts instead, it would only require what the reader managed to place, and a line the\n1105: // reader cut into two fragments would be required by neither part.\n1106: test('the preservation proof requires the raw lines of the old document', () => {\n1107:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n1108:   const withBlock = (body) => `${shipped}${manifest.markers.start}\\n${manifest.markers.heading}\\n\\n${manifest.markers.note}\\n${body === '' ? '' : `${body}\\n`}${manifest.markers.end}\\n`;\n1109:   const lost = embed.preservationCheck(withBlock(`One kept line.\\n${QUOTED}`), withBlock('One kept line.'), manifest);\n1110: \n1111:   assert.deepEqual(lost.dropped.map((entry) => entry.line), [QUOTED], 'the line the composition lost is the line named');\n1112:   assert.deepEqual(lost.dropped.map((entry) => entry.part), [1], 'and the part it sat in');\n1113: });\n1114: \n1115: // The bytes are the same; the line they sit on is not. Text ahead of a marker literal is\n1116: // prose, and the same bytes alone on a line are a marker — which makes a document with an\n1117: // end marker and no start marker a half-written block, refused before anything is written.\n1118: test('a marker literal after text is content, and a lone marker line is refused', (t) => {\n1119:   const dir = composeTree(t, 'pure');\n1120:   const note = `Do not edit below this line: ${manifest.markers.start}`;\n1121:   writeInside(dir, manifest.root_file, `${readInside(dir, manifest.root_file)}${note}\\n`);\n1122: \n1123:   const applied = planAndApply(dir).applied;\n1124:   trackBackup(t, applied.out);\n1125:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1126:   const composed = readInside(dir, manifest.root_file);\n1127:   assert.equal(occurrences(composed, note), 1, 'the whole line survives, marker literal included');\n1128:   assert.equal(markerLinesOf(composed, manifest.markers.start), 1, 'the only start marker line is the one the engine wrote');\n1129: \n1130:   const half = composeTree(t, 'pure');\n1131:   writeInside(half, manifest.root_file, `${readInside(half, manifest.root_file)}${manifest.markers.end}\\n`);\n1132:   const before = treeDigest(half);\n1133:   const refused = plan(half);\n1134:   assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n1135:   assert.match(refused.err, /one of its two markers/u, 'a lone marker line is a half-written block');\n1136:   assert.equal(treeDigest(half), before, 'and the refusal writes nothing');\n1137: });\n1138: \n1139: // Two blocks have no single block to carry out of, so the run refuses. Reporting the\n1140: // second block's marker bytes as repository lines it dropped would blame the repository\n1141: // for the framework's own bytes and name nothing anybody could act on.\n1142: test('a document carrying two blocks is refused by name, not as dropped lines', (t) => {\n1143:   const dir = composeTree(t, 'adopted');\n1144:   const original = readInside(dir, manifest.root_file);\n1145:   const second = `${manifest.markers.start}\\n${blockIn(original)}\\n${manifest.markers.end}\\n`;\n1146:   writeInside(dir, manifest.root_file, `${original.trimEnd()}\\n\\n${second}`);\n1147:   const before = treeDigest(dir);\n1148: \n1149:   const refused = plan(dir);\n1150:   assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n1151:   assert.match(refused.err, /duplicated/u, 'the refusal says the block is duplicated');\n1152:   assert.doesNotMatch(refused.err, /^dropped:/mu, 'and does not read the marker bytes as lost repository lines');\n1153: \n1154:   const lines = readInside(dir, manifest.root_file).split('\\n');\n1155:   const positions = [];\n1156:   for (let index = 0; index < lines.length; index += 1) {\n1157:     const line = lines[index].trim();\n1158:     if (line === manifest.markers.start.trim() || line === manifest.markers.end.trim()) positions.push(index + 1);\n1159:   }\n1160:   assert.equal(positions.length, 4, 'the document carries two blocks');\n1161:   for (const position of positions) {\n1162:     assert.match(refused.err, new RegExp(`\\\\b${position}\\\\b`, 'u'), `the refusal names line ${position}`);\n1163:   }\n1164:   assert.equal(treeDigest(dir), before, 'a duplicated block writes nothing');\n1165: });\n1166: \n1167: // ─────────────────────────────────────────────────────────────────────────────\n1168: // 18. A CARRIED LINE IS CARRIED VERBATIM\n1169: // ─────────────────────────────────────────────────────────────────────────────\n1170: \n1171: // The proof compares lines trimmed because a composition may re-place them; the write is\n1172: // what makes a nested bullet render, so it keeps the indentation the repository typed.\n1173: test('a carried line keeps its leading whitespace', (t) => {\n1174:   const dir = composeTree(t, 'pure');\n1175:   const nested = '    - A nested local rule written four spaces in.';\n1176:   writeInside(dir, manifest.root_file, insertInsideSection(readInside(dir, manifest.root_file), 'blast-radius', nested));\n1177: \n1178:   const applied = planAndApply(dir).applied;\n1179:   trackBackup(t, applied.out);\n1180:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1181:   assert.match(applied.out, /dropped 0/u);\n1182:   assert.ok(readInside(dir, manifest.root_file).split('\\n').includes(nested), 'the nested bullet keeps its four spaces');\n1183: \n1184:   const copy = composeTree(t, 'claude-only');\n1185:   const indented = '    - An indented copy line kept in the Claude file.';\n1186:   fs.appendFileSync(path.join(copy, 'CLAUDE.md'), `${indented}\\n`);\n1187:   const copyApplied = planAndApply(copy).applied;\n1188:   trackBackup(t, copyApplied.out);\n1189:   assert.equal(copyApplied.code, 0, `${copyApplied.err}${copyApplied.out}`);\n1190:   assert.ok(readInside(copy, manifest.root_file).split('\\n').includes(indented), 'a line a folded copy hands over keeps its four spaces');\n1191: });\n1192: \n1193: // ─────────────────────────────────────────────────────────────────────────────\n1194: // 19. THE DRY RUN AND THE BACKUP DIRECTORY\n1195: // ─────────────────────────────────────────────────────────────────────────────\n1196: \n1197: // An operator passing --dry-run to stay safe gets an answer, not a write.\n1198: test('apply --dry-run prints the plan and writes nothing', (t) => {\n1199:   const dir = composeTree(t, 'forked');\n1200:   const digest = field(plan(dir).out, 'plan-digest');\n1201:   const before = treeDigest(dir);\n1202: \n1203:   const dry = apply(dir, digest, ['--dry-run']);\n1204:   assert.equal(dry.code, 0, `${dry.err}${dry.out}`);\n1205:   assert.equal(treeDigest(dir), before, 'apply --dry-run leaves the tree byte for byte');\n1206:   assert.match(dry.out, /target AGENTS\\.md: replace/u, 'it prints what it would write');\n1207:   assert.match(dry.out, new RegExp(`plan-digest: ${digest}`, 'u'), 'and the digest it accepted');\n1208:   assert.match(dry.out, /preservation: /u);\n1209:   assert.match(dry.out, /undo: node .*restore --run=/u);\n1210:   assert.doesNotMatch(dry.out, /STATUS=OK/u, 'nothing was written, so nothing claims a write');\n1211:   assert.match(dry.out, /dry-run: nothing was written/u);\n1212: \n1213:   const backup = field(dry.out, 'backup');\n1214:   assert.ok(backup, 'it names the directory it would back up into');\n1215:   assert.equal(fs.existsSync(backup), false, 'and creates none');\n1216: });\n1217: \n1218: // The plan is the artefact the yes is given against, so the directory it prints is the\n1219: // directory apply uses and the undo line it prints is the undo line apply prints. A plan\n1220: // whose directory an earlier run already owns is planned again, because a suffixed copy\n1221: // would leave the printed undo command pointing at that earlier run's bytes.\n1222: test('the plan names the backup apply uses, and a taken directory is re-planned', (t) => {\n1223:   const dir = composeTree(t, 'foreign');\n1224:   const planned = plan(dir);\n1225:   const digest = field(planned.out, 'plan-digest');\n1226:   const plannedBackup = field(planned.out, 'backup');\n1227:   assert.ok(plannedBackup, 'the plan prints the backup directory');\n1228:   assert.equal(fs.existsSync(plannedBackup), false, 'and creates none');\n1229: \n1230:   const applied = apply(dir, digest);\n1231:   trackBackup(t, applied.out);\n1232:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1233:   assert.equal(field(applied.out, 'backup'), plannedBackup, 'apply backs up into the directory the plan printed');\n1234:   assert.equal(field(applied.out, 'undo'), field(planned.out, 'undo'), 'the undo command is the one the plan printed');\n1235:   assert.ok(field(planned.out, 'undo').includes(plannedBackup), 'and it names that directory');\n1236: \n1237:   const restored = run(['restore', `--run=${plannedBackup}`, '--root', dir], { input: 'yes\\n' });\n1238:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n1239: \n1240:   const again = plan(dir);\n1241:   assert.equal(again.code, 0, again.err);\n1242:   const secondBackup = field(again.out, 'backup');\n1243:   assert.ok(secondBackup, 'the second plan prints a directory');\n1244:   assert.notEqual(secondBackup, plannedBackup, 'the taken directory is not reused');\n1245:   assert.doesNotMatch(path.basename(secondBackup), /-\\d+$/u, 'and it is not a suffixed copy of it');\n1246:   assert.equal(fs.existsSync(secondBackup), false, 'the second plan creates nothing');\n1247:   assert.notEqual(field(again.out, 'plan-digest'), digest, 'the digest covers which backup directory the plan takes');\n1248: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 1017-1248\n1017:   for (const line of partial.split('\\n').filter((entry) => entry.trim() !== '')) {\n1018:     assert.ok(router.includes(line), `${line} was not touched`);\n1019:   }\n1020:   assert.equal(tableRows(router, 'TRIGGER TABLE').length, shippedRows().trigger_rows.length);\n1021:   assert.equal(tableRows(router, 'INDEX').length, shippedRows().index_rows.length);\n1022: \n1023:   const checked = runRepoRulesChecker(dir);\n1024:   assert.equal(checked.code, 0, checked.out);\n1025:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n1026: });\n1027: \n1028: test('a missing router is created only when asked for', (t) => {\n1029:   const dir = composeTree(t, 'pure');\n1030:   seedRuleCorpus(dir);\n1031: \n1032:   const quiet = plan(dir);\n1033:   assert.equal(quiet.code, 0, quiet.err);\n1034:   assert.match(quiet.out, /NOTHING TO DO/u);\n1035:   assert.equal(existsInside(dir, manifest.router_file), false);\n1036: \n1037:   const applied = planAndApply(dir, ['--create-router']).applied;\n1038:   trackBackup(t, applied.out);\n1039:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1040:   assert.equal(existsInside(dir, manifest.router_file), true);\n1041: \n1042:   const checked = runRepoRulesChecker(dir);\n1043:   assert.equal(checked.code, 0, checked.out);\n1044:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n1045: });\n1046: \n1047: // ─────────────────────────────────────────────────────────────────────────────\n1048: // 16. THE CURSOR MIRROR\n1049: // ─────────────────────────────────────────────────────────────────────────────\n1050: \n1051: test('.cursor/rules/repo-local.md exists exactly when the block carries content', (t) => {\n1052:   const empty = composeTree(t, 'absent');\n1053:   const emptyApplied = planAndApply(empty).applied;\n1054:   trackBackup(t, emptyApplied.out);\n1055:   assert.equal(emptyApplied.code, 0, `${emptyApplied.err}${emptyApplied.out}`);\n1056:   assert.equal(existsInside(empty, manifest.root_file), true, 'the template arrives');\n1057:   assert.equal(existsInside(empty, '.cursor/rules/repo-local.md'), false, 'an empty block has nothing to mirror');\n1058:   assert.equal(existsInside(empty, manifest.router_file), false, 'a router nobody asked for is not created');\n1059: \n1060:   const carried = composeTree(t, 'foreign');\n1061:   const carriedApplied = planAndApply(carried).applied;\n1062:   trackBackup(t, carriedApplied.out);\n1063:   assert.equal(carriedApplied.code, 0, `${carriedApplied.err}${carriedApplied.out}`);\n1064:   const mirror = readInside(carried, '.cursor/rules/repo-local.md');\n1065:   assert.match(mirror, /^---\\nalwaysApply: true\\n---\\n/u);\n1066:   for (const line of trimmedLines(blockIn(readInside(carried, manifest.root_file)))) {\n1067:     assert.ok(mirror.includes(line), `${line} reaches the mirror`);\n1068:   }\n1069: });\n1070: \n1071: // ─────────────────────────────────────────────────────────────────────────────\n1072: // 17. THE MARKER LINE, AND THE PROOF THAT READS THE DOCUMENT'S OWN LINES\n1073: // ─────────────────────────────────────────────────────────────────────────────\n1074: \n1075: // A sentence that quotes both markers is how a repository documents the block. Reading\n1076: // those bytes as the block would put its edges in the middle of that line, and the text on\n1077: // either side belongs to no section, to no prelude and to the block's own span: a rewrite\n1078: // deletes it and no part of the proof is left that could name what went.\n1079: const QUOTED = 'The block is fenced by `<!-- skilled:repo-local:start -->` and `<!-- skilled:repo-local:end -->` in this framework.';\n1080: \n1081: test('a sentence quoting both markers is repository content, not the block', (t) => {\n1082:   const dir = composeTree(t, 'pure');\n1083:   const original = insertInsideSection(readInside(dir, manifest.root_file), 's2-mandatory-gates', QUOTED);\n1084:   writeInside(dir, manifest.root_file, original);\n1085: \n1086:   const applied = planAndApply(dir).applied;\n1087:   trackBackup(t, applied.out);\n1088:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1089:   assert.match(applied.out, /dropped 0/u, 'the run loses nothing');\n1090: \n1091:   const composed = readInside(dir, manifest.root_file);\n1092:   assert.equal(occurrences(composed, QUOTED), 1, 'the sentence survives exactly once');\n1093:   assert.ok(blockIn(composed).includes(QUOTED), 'it sits in the block as the repository content it is');\n1094:   assert.notEqual(blockIn(composed).trim(), '` and `', 'the marker literals are not read as the block edges');\n1095:   assert.equal(markerLinesOf(composed, manifest.markers.start), 1, 'the document carries one start marker line');\n1096:   assert.equal(markerLinesOf(composed, manifest.markers.end), 1, 'and one end marker line');\n1097: \n1098:   const checked = embed.preservationCheck(original, composed, manifest);\n1099:   assert.deepEqual(checked.dropped, []);\n1100:   assert.deepEqual(checked.foreign, []);\n1101: });\n1102: \n1103: // The proof has to read the old document's own lines. Built from the segmentation's\n1104: // parts instead, it would only require what the reader managed to place, and a line the\n1105: // reader cut into two fragments would be required by neither part.\n1106: test('the preservation proof requires the raw lines of the old document', () => {\n1107:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n1108:   const withBlock = (body) => `${shipped}${manifest.markers.start}\\n${manifest.markers.heading}\\n\\n${manifest.markers.note}\\n${body === '' ? '' : `${body}\\n`}${manifest.markers.end}\\n`;\n1109:   const lost = embed.preservationCheck(withBlock(`One kept line.\\n${QUOTED}`), withBlock('One kept line.'), manifest);\n1110: \n1111:   assert.deepEqual(lost.dropped.map((entry) => entry.line), [QUOTED], 'the line the composition lost is the line named');\n1112:   assert.deepEqual(lost.dropped.map((entry) => entry.part), [1], 'and the part it sat in');\n1113: });\n1114: \n1115: // The bytes are the same; the line they sit on is not. Text ahead of a marker literal is\n1116: // prose, and the same bytes alone on a line are a marker — which makes a document with an\n1117: // end marker and no start marker a half-written block, refused before anything is written.\n1118: test('a marker literal after text is content, and a lone marker line is refused', (t) => {\n1119:   const dir = composeTree(t, 'pure');\n1120:   const note = `Do not edit below this line: ${manifest.markers.start}`;\n1121:   writeInside(dir, manifest.root_file, `${readInside(dir, manifest.root_file)}${note}\\n`);\n1122: \n1123:   const applied = planAndApply(dir).applied;\n1124:   trackBackup(t, applied.out);\n1125:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1126:   const composed = readInside(dir, manifest.root_file);\n1127:   assert.equal(occurrences(composed, note), 1, 'the whole line survives, marker literal included');\n1128:   assert.equal(markerLinesOf(composed, manifest.markers.start), 1, 'the only start marker line is the one the engine wrote');\n1129: \n1130:   const half = composeTree(t, 'pure');\n1131:   writeInside(half, manifest.root_file, `${readInside(half, manifest.root_file)}${manifest.markers.end}\\n`);\n1132:   const before = treeDigest(half);\n1133:   const refused = plan(half);\n1134:   assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n1135:   assert.match(refused.err, /one of its two markers/u, 'a lone marker line is a half-written block');\n1136:   assert.equal(treeDigest(half), before, 'and the refusal writes nothing');\n1137: });\n1138: \n1139: // Two blocks have no single block to carry out of, so the run refuses. Reporting the\n1140: // second block's marker bytes as repository lines it dropped would blame the repository\n1141: // for the framework's own bytes and name nothing anybody could act on.\n1142: test('a document carrying two blocks is refused by name, not as dropped lines', (t) => {\n1143:   const dir = composeTree(t, 'adopted');\n1144:   const original = readInside(dir, manifest.root_file);\n1145:   const second = `${manifest.markers.start}\\n${blockIn(original)}\\n${manifest.markers.end}\\n`;\n1146:   writeInside(dir, manifest.root_file, `${original.trimEnd()}\\n\\n${second}`);\n1147:   const before = treeDigest(dir);\n1148: \n1149:   const refused = plan(dir);\n1150:   assert.equal(refused.code, 2, `${refused.out}${refused.err}`);\n1151:   assert.match(refused.err, /duplicated/u, 'the refusal says the block is duplicated');\n1152:   assert.doesNotMatch(refused.err, /^dropped:/mu, 'and does not read the marker bytes as lost repository lines');\n1153: \n1154:   const lines = readInside(dir, manifest.root_file).split('\\n');\n1155:   const positions = [];\n1156:   for (let index = 0; index < lines.length; index += 1) {\n1157:     const line = lines[index].trim();\n1158:     if (line === manifest.markers.start.trim() || line === manifest.markers.end.trim()) positions.push(index + 1);\n1159:   }\n1160:   assert.equal(positions.length, 4, 'the document carries two blocks');\n1161:   for (const position of positions) {\n1162:     assert.match(refused.err, new RegExp(`\\\\b${position}\\\\b`, 'u'), `the refusal names line ${position}`);\n1163:   }\n1164:   assert.equal(treeDigest(dir), before, 'a duplicated block writes nothing');\n1165: });\n1166: \n1167: // ─────────────────────────────────────────────────────────────────────────────\n1168: // 18. A CARRIED LINE IS CARRIED VERBATIM\n1169: // ─────────────────────────────────────────────────────────────────────────────\n1170: \n1171: // The proof compares lines trimmed because a composition may re-place them; the write is\n1172: // what makes a nested bullet render, so it keeps the indentation the repository typed.\n1173: test('a carried line keeps its leading whitespace', (t) => {\n1174:   const dir = composeTree(t, 'pure');\n1175:   const nested = '    - A nested local rule written four spaces in.';\n1176:   writeInside(dir, manifest.root_file, insertInsideSection(readInside(dir, manifest.root_file), 'blast-radius', nested));\n1177: \n1178:   const applied = planAndApply(dir).applied;\n1179:   trackBackup(t, applied.out);\n1180:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1181:   assert.match(applied.out, /dropped 0/u);\n1182:   assert.ok(readInside(dir, manifest.root_file).split('\\n').includes(nested), 'the nested bullet keeps its four spaces');\n1183: \n1184:   const copy = composeTree(t, 'claude-only');\n1185:   const indented = '    - An indented copy line kept in the Claude file.';\n1186:   fs.appendFileSync(path.join(copy, 'CLAUDE.md'), `${indented}\\n`);\n1187:   const copyApplied = planAndApply(copy).applied;\n1188:   trackBackup(t, copyApplied.out);\n1189:   assert.equal(copyApplied.code, 0, `${copyApplied.err}${copyApplied.out}`);\n1190:   assert.ok(readInside(copy, manifest.root_file).split('\\n').includes(indented), 'a line a folded copy hands over keeps its four spaces');\n1191: });\n1192: \n1193: // ─────────────────────────────────────────────────────────────────────────────\n1194: // 19. THE DRY RUN AND THE BACKUP DIRECTORY\n1195: // ─────────────────────────────────────────────────────────────────────────────\n1196: \n1197: // An operator passing --dry-run to stay safe gets an answer, not a write.\n1198: test('apply --dry-run prints the plan and writes nothing', (t) => {\n1199:   const dir = composeTree(t, 'forked');\n1200:   const digest = field(plan(dir).out, 'plan-digest');\n1201:   const before = treeDigest(dir);\n1202: \n1203:   const dry = apply(dir, digest, ['--dry-run']);\n1204:   assert.equal(dry.code, 0, `${dry.err}${dry.out}`);\n1205:   assert.equal(treeDigest(dir), before, 'apply --dry-run leaves the tree byte for byte');\n1206:   assert.match(dry.out, /target AGENTS\\.md: replace/u, 'it prints what it would write');\n1207:   assert.match(dry.out, new RegExp(`plan-digest: ${digest}`, 'u'), 'and the digest it accepted');\n1208:   assert.match(dry.out, /preservation: /u);\n1209:   assert.match(dry.out, /undo: node .*restore --run=/u);\n1210:   assert.doesNotMatch(dry.out, /STATUS=OK/u, 'nothing was written, so nothing claims a write');\n1211:   assert.match(dry.out, /dry-run: nothing was written/u);\n1212: \n1213:   const backup = field(dry.out, 'backup');\n1214:   assert.ok(backup, 'it names the directory it would back up into');\n1215:   assert.equal(fs.existsSync(backup), false, 'and creates none');\n1216: });\n1217: \n1218: // The plan is the artefact the yes is given against, so the directory it prints is the\n1219: // directory apply uses and the undo line it prints is the undo line apply prints. A plan\n1220: // whose directory an earlier run already owns is planned again, because a suffixed copy\n1221: // would leave the printed undo command pointing at that earlier run's bytes.\n1222: test('the plan names the backup apply uses, and a taken directory is re-planned', (t) => {\n1223:   const dir = composeTree(t, 'foreign');\n1224:   const planned = plan(dir);\n1225:   const digest = field(planned.out, 'plan-digest');\n1226:   const plannedBackup = field(planned.out, 'backup');\n1227:   assert.ok(plannedBackup, 'the plan prints the backup directory');\n1228:   assert.equal(fs.existsSync(plannedBackup), false, 'and creates none');\n1229: \n1230:   const applied = apply(dir, digest);\n1231:   trackBackup(t, applied.out);\n1232:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1233:   assert.equal(field(applied.out, 'backup'), plannedBackup, 'apply backs up into the directory the plan printed');\n1234:   assert.equal(field(applied.out, 'undo'), field(planned.out, 'undo'), 'the undo command is the one the plan printed');\n1235:   assert.ok(field(planned.out, 'undo').includes(plannedBackup), 'and it names that directory');\n1236: \n1237:   const restored = run(['restore', `--run=${plannedBackup}`, '--root', dir], { input: 'yes\\n' });\n1238:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n1239: \n1240:   const again = plan(dir);\n1241:   assert.equal(again.code, 0, again.err);\n1242:   const secondBackup = field(again.out, 'backup');\n1243:   assert.ok(secondBackup, 'the second plan prints a directory');\n1244:   assert.notEqual(secondBackup, plannedBackup, 'the taken directory is not reused');\n1245:   assert.doesNotMatch(path.basename(secondBackup), /-\\d+$/u, 'and it is not a suffixed copy of it');\n1246:   assert.equal(fs.existsSync(secondBackup), false, 'the second plan creates nothing');\n1247:   assert.notEqual(field(again.out, 'plan-digest'), digest, 'the digest covers which backup directory the plan takes');\n1248: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\",\"offset\":1017,\"limit\":600}"},"time":{"start":1794559633547,"end":1794559634138}}}}
{"type":"tool_use","timestamp":1794559634141,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"partID":"prt_1d416e6830018xWe12TgVrsnUS","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d416b9880010IDDDZQTUrzgcD","type":"tool","id":"call_bb446df62d514e009d8943aa","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/scratch/planning/probe-mirror-link.sh"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/scratch/planning/probe-mirror-link.sh, lines 1-19\n1: #!/bin/bash\n2: # Run from the repository root: bash <this file>\n3: # Plans and applies the foreign fixture with its Cursor mirror linked to an\n4: # in-root CI file, then prints whether the CI file changed. Removes its temp tree.\n5: S=\"$PWD/.skilled/commands/doctor/scripts\"\n6: T=$(mktemp -d \"${TMPDIR:-/tmp}/probe-mirror-link-XXXXXX\"); D=\"$T/foreign\"\n7: node \"$S/tests/fixtures/agents-md/compose-fixture.cjs\" foreign \"$D\" >/dev/null\n8: mkdir -p \"$D/.github\" \"$D/.cursor/rules\"; printf 'name: ci\\non: push\\n' > \"$D/.github/ci.yml\"\n9: ln -s ../../.github/ci.yml \"$D/.cursor/rules/repo-local.md\"\n10: sum0=$(shasum -a 256 \"$D/.github/ci.yml\" | cut -c1-12)\n11: P=$(node \"$S/agents-md-embed.cjs\" plan --root \"$D\"); echo \"plan exit=$?\"\n12: echo \"$P\" | grep '^target '\n13: DG=$(echo \"$P\" | sed -n 's/^plan-digest: //p'); BK=$(echo \"$P\" | sed -n 's/^backup: //p')\n14: if [ -n \"$DG\" ]; then\n15:   A=$(node \"$S/agents-md-embed.cjs\" apply --root \"$D\" --plan-digest \"$DG\"); echo \"apply exit=$?\"\n16:   echo \"$A\" | grep -E '^(wrote|STATUS)'\n17: fi\n18: echo \"ci.yml sha before=$sum0 after=$(shasum -a 256 \"$D/.github/ci.yml\" | cut -c1-12) link still a link: $(test -L \"$D/.cursor/rules/repo-local.md\" && echo yes || echo no)\"\n19: rm -rf \"$T\"; case \"$BK\" in \"${TMPDIR:-/tmp}\"*) rm -rf \"$BK\";; esac","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/scratch/planning/probe-mirror-link.sh, lines 1-19\n1: #!/bin/bash\n2: # Run from the repository root: bash <this file>\n3: # Plans and applies the foreign fixture with its Cursor mirror linked to an\n4: # in-root CI file, then prints whether the CI file changed. Removes its temp tree.\n5: S=\"$PWD/.skilled/commands/doctor/scripts\"\n6: T=$(mktemp -d \"${TMPDIR:-/tmp}/probe-mirror-link-XXXXXX\"); D=\"$T/foreign\"\n7: node \"$S/tests/fixtures/agents-md/compose-fixture.cjs\" foreign \"$D\" >/dev/null\n8: mkdir -p \"$D/.github\" \"$D/.cursor/rules\"; printf 'name: ci\\non: push\\n' > \"$D/.github/ci.yml\"\n9: ln -s ../../.github/ci.yml \"$D/.cursor/rules/repo-local.md\"\n10: sum0=$(shasum -a 256 \"$D/.github/ci.yml\" | cut -c1-12)\n11: P=$(node \"$S/agents-md-embed.cjs\" plan --root \"$D\"); echo \"plan exit=$?\"\n12: echo \"$P\" | grep '^target '\n13: DG=$(echo \"$P\" | sed -n 's/^plan-digest: //p'); BK=$(echo \"$P\" | sed -n 's/^backup: //p')\n14: if [ -n \"$DG\" ]; then\n15:   A=$(node \"$S/agents-md-embed.cjs\" apply --root \"$D\" --plan-digest \"$DG\"); echo \"apply exit=$?\"\n16:   echo \"$A\" | grep -E '^(wrote|STATUS)'\n17: fi\n18: echo \"ci.yml sha before=$sum0 after=$(shasum -a 256 \"$D/.github/ci.yml\" | cut -c1-12) link still a link: $(test -L \"$D/.cursor/rules/repo-local.md\" && echo yes || echo no)\"\n19: rm -rf \"$T\"; case \"$BK\" in \"${TMPDIR:-/tmp}\"*) rm -rf \"$BK\";; esac"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/scratch/planning/probe-mirror-link.sh\"}"},"time":{"start":1794559633027,"end":1794559634141}}}}
{"type":"step_finish","timestamp":1794559635263,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"id":"prt_1d416ef3f001h5R48RgKFSIrvz","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d416b9880010IDDDZQTUrzgcD","type":"step-finish","reason":"tool-calls","snapshot":"644397753ae99f6fbb8bfc9f37b1a8ab438e1d5a","cost":0,"tokens":{"input":33099,"output":292,"reasoning":334,"cache":{"read":32896,"write":0}}}}
{"type":"step_start","timestamp":1794559637474,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"id":"prt_1d416f7e2001kUCXyRzDsmp0Zt","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d416ef44001u7C16k57O58VN6","type":"step-start","snapshot":"497dc6d85c7489c31880bdfdbb5a1178c129bacd"}}
{"type":"tool_use","timestamp":1794559678841,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"partID":"prt_1d41798d4001DRPAPdkwKtYHkW","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d416ef44001u7C16k57O58VN6","type":"tool","id":"call_8b61185c145e411aaef37702","tool":"skill","state":{"status":"completed","input":{"id":"sk-code"},"output":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-code","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-code\"}"},"time":{"start":1794559678676,"end":1794559678841}}}}
{"type":"tool_use","timestamp":1794559678845,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"partID":"prt_1d41794a0002pSmIMEB8LFMTjk","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d416ef44001u7C16k57O58VN6","type":"tool","id":"call_36af2d817ded43e9b9bda4a9","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs, lines 1-260\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Fixture Composer\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A fixture is a recipe, not a tree. A committed copy of the composed tree would put the\n8: // shipped template into the repository a second time: its relative links would resolve\n9: // from the fixture folder rather than the root, a runtime that loads nested instruction\n10: // files would read it as some repository's own document, and every template edit would\n11: // force a regeneration commit. So each folder here holds only `fixture.json`, and the\n12: // tree it describes is composed on demand into a folder the caller throws away.\n13: //\n14: // Composition reads the manifest the template ships, never a stored copy of it, so a\n15: // fixture is a statement about what is shipped today. That is also why a fixture cannot\n16: // describe a template the manifest does not ship: the bodies come from the manifest's\n17: // derived sections and its release history, the block shape from the manifest's markers,\n18: // and the two runtime mirrors from the generators that own them.\n19: //\n20: // Composing by hand is supported, because \"run the check against this defect\" is the\n21: // first thing a reader wants to do with a fixture:\n22: //\n23: // Usage: compose-fixture.cjs <fixture> <empty-folder>\n24: //   <fixture>       one of the folder names beside this script\n25: //   <empty-folder>  created if absent, refused when it already holds anything\n26: // Exit codes: 0 composed, 2 bad arguments or a folder it must not write into\n27: \n28: const fs = require('node:fs');\n29: const path = require('node:path');\n30: \n31: const SCRIPTS_DIR = path.resolve(__dirname, '../../..');\n32: const REPO_ROOT = path.resolve(SCRIPTS_DIR, '../../../..');\n33: const FIXTURES = __dirname;\n34: const MANIFEST_PATH = path.join(SCRIPTS_DIR, '../assets/agents-md-manifest.json');\n35: const POINTER_SYNC = path.join(\n36:   REPO_ROOT,\n37:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n38: );\n39: \n40: const { TARGETS, applyBlock, readGateOneLine, renderBlock } = require(POINTER_SYNC);\n41: \n42: const TAG = '[compose-fixture]';\n43: const USAGE = `Usage: node ${path.relative(REPO_ROOT, __filename)} <fixture> <empty-folder>`;\n44: \n45: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n46: \n47: // ─────────────────────────────────────────────────────────────────────────────\n48: // 1. RECIPES\n49: // ─────────────────────────────────────────────────────────────────────────────\n50: \n51: // The recipe folders, not every entry beside them: this script lives in the same folder.\n52: function fixtureNames() {\n53:   return fs.readdirSync(FIXTURES, { withFileTypes: true })\n54:     .filter((entry) => entry.isDirectory())\n55:     .map((entry) => entry.name)\n56:     .sort();\n57: }\n58: \n59: function loadRecipe(name) {\n60:   return JSON.parse(fs.readFileSync(path.join(FIXTURES, name, 'fixture.json'), 'utf8'));\n61: }\n62: \n63: // ─────────────────────────────────────────────────────────────────────────────\n64: // 2. THE DOCUMENT A RECIPE DESCRIBES\n65: // ─────────────────────────────────────────────────────────────────────────────\n66: \n67: function derivedBody(id) {\n68:   const entry = manifest.derived.sections[id];\n69:   if (!entry) throw new Error(`the manifest's derived key holds no section ${id}`);\n70:   return entry.body;\n71: }\n72: \n73: // The older body the release history holds for one section, found by the heading the body\n74: // opens with rather than by a tag, so the fixture names a section and the history decides\n75: // which released wording stands in for it.\n76: function historyBody(id) {\n77:   const entry = manifest.sections.find((row) => row.id === id);\n78:   if (!entry) throw new Error(`the manifest declares no section ${id}`);\n79:   const hit = manifest.derived.history.find((row) => row.body.split('\\n')[0].includes(entry.match));\n80:   if (!hit) throw new Error(`the manifest's history holds no older body for ${id}`);\n81:   return hit.body;\n82: }\n83: \n84: // A local line belongs inside the section it was written into, ahead of the divider that\n85: // closes it, so the fixture reads like an edit somebody made rather than a line appended\n86: // after the rule.\n87: function insertIntoSection(body, line) {\n88:   const divider = body.lastIndexOf('\\n---\\n');\n89:   if (divider === -1) return `${body}${line}\\n`;\n90:   return `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n91: }\n92: \n93: function composeDocument(recipe) {\n94:   if (recipe.base === 'none') return null;\n95:   if (recipe.base === 'own') return recipe.own_document;\n96: \n97:   const parts = [];\n98:   for (const entry of manifest.sections) {\n99:     let body = (recipe.replace_with_history || []).includes(entry.id)\n100:       ? historyBody(entry.id)\n101:       : derivedBody(entry.id);\n102:     for (const line of (recipe.section_edits || {})[entry.id] || []) {\n103:       body = insertIntoSection(body, line);\n104:     }\n105:     for (const row of recipe.insert_sections || []) {\n106:       if (row.before === entry.id) parts.push(row.text);\n107:     }\n108:     parts.push(body);\n109:   }\n110:   return parts.join('');\n111: }\n112: \n113: function blockText(recipe) {\n114:   const { markers } = manifest;\n115:   return `\\n${markers.heading}\\n\\n${markers.note}\\n${recipe.block.text || ''}`.trimEnd();\n116: }\n117: \n118: function composeDocumentWithBlock(recipe) {\n119:   const shipped = composeDocument(recipe);\n120:   if (!recipe.block) return shipped;\n121: \n122:   const { markers } = manifest;\n123:   if (recipe.block.markers === 'reversed') {\n124:     const filler = Array.from(\n125:       { length: recipe.block.pad_lines || 0 },\n126:       (_, index) => `${String(index + 1).padStart(2, '0')}. A repository note kept out of the shipped sections.`,\n127:     ).join('\\n');\n128:     return `${shipped}${markers.end}\\n${filler}\\n${markers.start}\\n`;\n129:   }\n130:   return `${shipped}${markers.start}\\n${blockText(recipe)}\\n${markers.end}\\n`;\n131: }\n132: \n133: // A repository puts its block wherever it likes, and both engines have to read the same\n134: // document the same way wherever that is. Moving the one block a composed recipe already\n135: // carries is how a case plants a block that is not last, without a second template.\n136: function moveBlockBefore(text, headingPrefix) {\n137:   const { markers } = manifest;\n138:   const from = text.indexOf(markers.start);\n139:   const to = text.indexOf(markers.end);\n140:   if (from === -1 || to === -1 || to < from) {\n141:     throw new Error('moveBlockBefore: the document carries no well-formed block');\n142:   }\n143:   const block = text.slice(from, to + markers.end.length);\n144:   // The markers own their own lines, so the newline after the end marker leaves with them\n145:   // instead of surviving as a blank line at the end of the section above.\n146:   const after = to + markers.end.length;\n147:   const cut = text.startsWith('\\n', after) ? after + 1 : after;\n148:   const rest = `${text.slice(0, from)}${text.slice(cut)}`;\n149:   const at = rest.indexOf(`\\n${headingPrefix}`);\n150:   if (at === -1) throw new Error(`moveBlockBefore: no line starts with ${JSON.stringify(headingPrefix)}`);\n151:   return `${rest.slice(0, at + 1)}${block}\\n${rest.slice(at + 1)}`;\n152: }\n153: \n154: // ─────────────────────────────────────────────────────────────────────────────\n155: // 3. THE RUNTIME MIRRORS\n156: // ─────────────────────────────────────────────────────────────────────────────\n157: \n158: // The Cursor rule every runtime mirror is generated from. Writing it with the sync's own\n159: // renderer is what makes the fixture a repository that has run the generator, instead of\n160: // one carrying a hand-copied block that would only prove the copy.\n161: function writePointerMirror(dir) {\n162:   const line = readGateOneLine(dir);\n163:   if (!line) return null;\n164:   const target = path.join(dir, TARGETS[0].file);\n165:   fs.mkdirSync(path.dirname(target), { recursive: true });\n166:   fs.writeFileSync(target, applyBlock('', renderBlock(TARGETS[0].intro, line)), 'utf8');\n167:   return path.relative(dir, target).split(path.sep).join('/');\n168: }\n169: \n170: // Devin never sees past the delivery prefix of the root document, so a repository with a\n171: // non-empty block is expected to carry the generated mirror of it.\n172: function writeRepoLocalMirror(dir, recipe) {\n173:   if (!recipe.block || recipe.block.markers === 'reversed') return null;\n174:   const target = path.join(dir, '.cursor/rules/repo-local.md');\n175:   fs.mkdirSync(path.dirname(target), { recursive: true });\n176:   fs.writeFileSync(target, `---\\nalwaysApply: true\\n---\\n${blockText(recipe)}\\n`, 'utf8');\n177:   return path.relative(dir, target).split(path.sep).join('/');\n178: }\n179: \n180: // ─────────────────────────────────────────────────────────────────────────────\n181: // 4. THE TREE A RECIPE DESCRIBES\n182: // ─────────────────────────────────────────────────────────────────────────────\n183: \n184: // The root document, the files the recipe adds, and the two runtime mirrors a repository\n185: // that ran its generators would carry. Returns the relative path of every file written,\n186: // so a caller can report what it composed.\n187: function composeFixture(name, dir) {\n188:   const recipe = loadRecipe(name);\n189:   const written = [];\n190: \n191:   fs.mkdirSync(dir, { recursive: true });\n192:   const document = composeDocumentWithBlock(recipe);\n193:   if (document !== null) {\n194:     fs.writeFileSync(path.join(dir, manifest.root_file), document, 'utf8');\n195:     written.push(manifest.root_file);\n196:   }\n197:   for (const [relative, content] of Object.entries(recipe.files || {})) {\n198:     const target = path.join(dir, relative);\n199:     fs.mkdirSync(path.dirname(target), { recursive: true });\n200:     fs.writeFileSync(target, content, 'utf8');\n201:     written.push(relative);\n202:   }\n203:   for (const relative of [writePointerMirror(dir), writeRepoLocalMirror(dir, recipe)]) {\n204:     if (relative) written.push(relative);\n205:   }\n206:   return written;\n207: }\n208: \n209: // ─────────────────────────────────────────────────────────────────────────────\n210: // 5. MAIN\n211: // ─────────────────────────────────────────────────────────────────────────────\n212: \n213: function main(argv) {\n214:   if (argv.length !== 2) {\n215:     console.error(`${TAG} ERROR: expected a fixture name and an empty folder\\n${USAGE}`);\n216:     return 2;\n217:   }\n218:   const [name, target] = argv;\n219:   if (!fixtureNames().includes(name)) {\n220:     console.error(`${TAG} ERROR: no fixture named ${name}. Known: ${fixtureNames().join(', ')}`);\n221:     return 2;\n222:   }\n223: \n224:   const dir = path.resolve(target);\n225:   if (fs.existsSync(dir)) {\n226:     if (!fs.statSync(dir).isDirectory()) {\n227:       console.error(`${TAG} ERROR: ${dir} is not a directory`);\n228:       return 2;\n229:     }\n230:     if (fs.readdirSync(dir).length > 0) {\n231:       console.error(`${TAG} ERROR: ${dir} is not empty, so composing here would mix two trees`);\n232:       return 2;\n233:     }\n234:   }\n235: \n236:   const written = composeFixture(name, dir);\n237:   console.log(`${TAG} ${name} -> ${dir}`);\n238:   for (const relative of written) console.log(`  ${relative}`);\n239:   return 0;\n240: }\n241: \n242: if (require.main === module) {\n243:   try {\n244:     process.exitCode = main(process.argv.slice(2));\n245:   } catch (error) {\n246:     console.error(`${TAG} ERROR: ${error.message}`);\n247:     process.exitCode = 2;\n248:   }\n249: }\n250: \n251: module.exports = {\n252:   FIXTURES,\n253:   MANIFEST_PATH,\n254:   REPO_ROOT,\n255:   SCRIPTS_DIR,\n256:   composeFixture,\n257:   fixtureNames,\n258:   loadRecipe,\n259:   moveBlockBefore,\n260: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs, lines 1-260\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Fixture Composer\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A fixture is a recipe, not a tree. A committed copy of the composed tree would put the\n8: // shipped template into the repository a second time: its relative links would resolve\n9: // from the fixture folder rather than the root, a runtime that loads nested instruction\n10: // files would read it as some repository's own document, and every template edit would\n11: // force a regeneration commit. So each folder here holds only `fixture.json`, and the\n12: // tree it describes is composed on demand into a folder the caller throws away.\n13: //\n14: // Composition reads the manifest the template ships, never a stored copy of it, so a\n15: // fixture is a statement about what is shipped today. That is also why a fixture cannot\n16: // describe a template the manifest does not ship: the bodies come from the manifest's\n17: // derived sections and its release history, the block shape from the manifest's markers,\n18: // and the two runtime mirrors from the generators that own them.\n19: //\n20: // Composing by hand is supported, because \"run the check against this defect\" is the\n21: // first thing a reader wants to do with a fixture:\n22: //\n23: // Usage: compose-fixture.cjs <fixture> <empty-folder>\n24: //   <fixture>       one of the folder names beside this script\n25: //   <empty-folder>  created if absent, refused when it already holds anything\n26: // Exit codes: 0 composed, 2 bad arguments or a folder it must not write into\n27: \n28: const fs = require('node:fs');\n29: const path = require('node:path');\n30: \n31: const SCRIPTS_DIR = path.resolve(__dirname, '../../..');\n32: const REPO_ROOT = path.resolve(SCRIPTS_DIR, '../../../..');\n33: const FIXTURES = __dirname;\n34: const MANIFEST_PATH = path.join(SCRIPTS_DIR, '../assets/agents-md-manifest.json');\n35: const POINTER_SYNC = path.join(\n36:   REPO_ROOT,\n37:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n38: );\n39: \n40: const { TARGETS, applyBlock, readGateOneLine, renderBlock } = require(POINTER_SYNC);\n41: \n42: const TAG = '[compose-fixture]';\n43: const USAGE = `Usage: node ${path.relative(REPO_ROOT, __filename)} <fixture> <empty-folder>`;\n44: \n45: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n46: \n47: // ─────────────────────────────────────────────────────────────────────────────\n48: // 1. RECIPES\n49: // ─────────────────────────────────────────────────────────────────────────────\n50: \n51: // The recipe folders, not every entry beside them: this script lives in the same folder.\n52: function fixtureNames() {\n53:   return fs.readdirSync(FIXTURES, { withFileTypes: true })\n54:     .filter((entry) => entry.isDirectory())\n55:     .map((entry) => entry.name)\n56:     .sort();\n57: }\n58: \n59: function loadRecipe(name) {\n60:   return JSON.parse(fs.readFileSync(path.join(FIXTURES, name, 'fixture.json'), 'utf8'));\n61: }\n62: \n63: // ─────────────────────────────────────────────────────────────────────────────\n64: // 2. THE DOCUMENT A RECIPE DESCRIBES\n65: // ─────────────────────────────────────────────────────────────────────────────\n66: \n67: function derivedBody(id) {\n68:   const entry = manifest.derived.sections[id];\n69:   if (!entry) throw new Error(`the manifest's derived key holds no section ${id}`);\n70:   return entry.body;\n71: }\n72: \n73: // The older body the release history holds for one section, found by the heading the body\n74: // opens with rather than by a tag, so the fixture names a section and the history decides\n75: // which released wording stands in for it.\n76: function historyBody(id) {\n77:   const entry = manifest.sections.find((row) => row.id === id);\n78:   if (!entry) throw new Error(`the manifest declares no section ${id}`);\n79:   const hit = manifest.derived.history.find((row) => row.body.split('\\n')[0].includes(entry.match));\n80:   if (!hit) throw new Error(`the manifest's history holds no older body for ${id}`);\n81:   return hit.body;\n82: }\n83: \n84: // A local line belongs inside the section it was written into, ahead of the divider that\n85: // closes it, so the fixture reads like an edit somebody made rather than a line appended\n86: // after the rule.\n87: function insertIntoSection(body, line) {\n88:   const divider = body.lastIndexOf('\\n---\\n');\n89:   if (divider === -1) return `${body}${line}\\n`;\n90:   return `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n91: }\n92: \n93: function composeDocument(recipe) {\n94:   if (recipe.base === 'none') return null;\n95:   if (recipe.base === 'own') return recipe.own_document;\n96: \n97:   const parts = [];\n98:   for (const entry of manifest.sections) {\n99:     let body = (recipe.replace_with_history || []).includes(entry.id)\n100:       ? historyBody(entry.id)\n101:       : derivedBody(entry.id);\n102:     for (const line of (recipe.section_edits || {})[entry.id] || []) {\n103:       body = insertIntoSection(body, line);\n104:     }\n105:     for (const row of recipe.insert_sections || []) {\n106:       if (row.before === entry.id) parts.push(row.text);\n107:     }\n108:     parts.push(body);\n109:   }\n110:   return parts.join('');\n111: }\n112: \n113: function blockText(recipe) {\n114:   const { markers } = manifest;\n115:   return `\\n${markers.heading}\\n\\n${markers.note}\\n${recipe.block.text || ''}`.trimEnd();\n116: }\n117: \n118: function composeDocumentWithBlock(recipe) {\n119:   const shipped = composeDocument(recipe);\n120:   if (!recipe.block) return shipped;\n121: \n122:   const { markers } = manifest;\n123:   if (recipe.block.markers === 'reversed') {\n124:     const filler = Array.from(\n125:       { length: recipe.block.pad_lines || 0 },\n126:       (_, index) => `${String(index + 1).padStart(2, '0')}. A repository note kept out of the shipped sections.`,\n127:     ).join('\\n');\n128:     return `${shipped}${markers.end}\\n${filler}\\n${markers.start}\\n`;\n129:   }\n130:   return `${shipped}${markers.start}\\n${blockText(recipe)}\\n${markers.end}\\n`;\n131: }\n132: \n133: // A repository puts its block wherever it likes, and both engines have to read the same\n134: // document the same way wherever that is. Moving the one block a composed recipe already\n135: // carries is how a case plants a block that is not last, without a second template.\n136: function moveBlockBefore(text, headingPrefix) {\n137:   const { markers } = manifest;\n138:   const from = text.indexOf(markers.start);\n139:   const to = text.indexOf(markers.end);\n140:   if (from === -1 || to === -1 || to < from) {\n141:     throw new Error('moveBlockBefore: the document carries no well-formed block');\n142:   }\n143:   const block = text.slice(from, to + markers.end.length);\n144:   // The markers own their own lines, so the newline after the end marker leaves with them\n145:   // instead of surviving as a blank line at the end of the section above.\n146:   const after = to + markers.end.length;\n147:   const cut = text.startsWith('\\n', after) ? after + 1 : after;\n148:   const rest = `${text.slice(0, from)}${text.slice(cut)}`;\n149:   const at = rest.indexOf(`\\n${headingPrefix}`);\n150:   if (at === -1) throw new Error(`moveBlockBefore: no line starts with ${JSON.stringify(headingPrefix)}`);\n151:   return `${rest.slice(0, at + 1)}${block}\\n${rest.slice(at + 1)}`;\n152: }\n153: \n154: // ─────────────────────────────────────────────────────────────────────────────\n155: // 3. THE RUNTIME MIRRORS\n156: // ─────────────────────────────────────────────────────────────────────────────\n157: \n158: // The Cursor rule every runtime mirror is generated from. Writing it with the sync's own\n159: // renderer is what makes the fixture a repository that has run the generator, instead of\n160: // one carrying a hand-copied block that would only prove the copy.\n161: function writePointerMirror(dir) {\n162:   const line = readGateOneLine(dir);\n163:   if (!line) return null;\n164:   const target = path.join(dir, TARGETS[0].file);\n165:   fs.mkdirSync(path.dirname(target), { recursive: true });\n166:   fs.writeFileSync(target, applyBlock('', renderBlock(TARGETS[0].intro, line)), 'utf8');\n167:   return path.relative(dir, target).split(path.sep).join('/');\n168: }\n169: \n170: // Devin never sees past the delivery prefix of the root document, so a repository with a\n171: // non-empty block is expected to carry the generated mirror of it.\n172: function writeRepoLocalMirror(dir, recipe) {\n173:   if (!recipe.block || recipe.block.markers === 'reversed') return null;\n174:   const target = path.join(dir, '.cursor/rules/repo-local.md');\n175:   fs.mkdirSync(path.dirname(target), { recursive: true });\n176:   fs.writeFileSync(target, `---\\nalwaysApply: true\\n---\\n${blockText(recipe)}\\n`, 'utf8');\n177:   return path.relative(dir, target).split(path.sep).join('/');\n178: }\n179: \n180: // ─────────────────────────────────────────────────────────────────────────────\n181: // 4. THE TREE A RECIPE DESCRIBES\n182: // ─────────────────────────────────────────────────────────────────────────────\n183: \n184: // The root document, the files the recipe adds, and the two runtime mirrors a repository\n185: // that ran its generators would carry. Returns the relative path of every file written,\n186: // so a caller can report what it composed.\n187: function composeFixture(name, dir) {\n188:   const recipe = loadRecipe(name);\n189:   const written = [];\n190: \n191:   fs.mkdirSync(dir, { recursive: true });\n192:   const document = composeDocumentWithBlock(recipe);\n193:   if (document !== null) {\n194:     fs.writeFileSync(path.join(dir, manifest.root_file), document, 'utf8');\n195:     written.push(manifest.root_file);\n196:   }\n197:   for (const [relative, content] of Object.entries(recipe.files || {})) {\n198:     const target = path.join(dir, relative);\n199:     fs.mkdirSync(path.dirname(target), { recursive: true });\n200:     fs.writeFileSync(target, content, 'utf8');\n201:     written.push(relative);\n202:   }\n203:   for (const relative of [writePointerMirror(dir), writeRepoLocalMirror(dir, recipe)]) {\n204:     if (relative) written.push(relative);\n205:   }\n206:   return written;\n207: }\n208: \n209: // ─────────────────────────────────────────────────────────────────────────────\n210: // 5. MAIN\n211: // ─────────────────────────────────────────────────────────────────────────────\n212: \n213: function main(argv) {\n214:   if (argv.length !== 2) {\n215:     console.error(`${TAG} ERROR: expected a fixture name and an empty folder\\n${USAGE}`);\n216:     return 2;\n217:   }\n218:   const [name, target] = argv;\n219:   if (!fixtureNames().includes(name)) {\n220:     console.error(`${TAG} ERROR: no fixture named ${name}. Known: ${fixtureNames().join(', ')}`);\n221:     return 2;\n222:   }\n223: \n224:   const dir = path.resolve(target);\n225:   if (fs.existsSync(dir)) {\n226:     if (!fs.statSync(dir).isDirectory()) {\n227:       console.error(`${TAG} ERROR: ${dir} is not a directory`);\n228:       return 2;\n229:     }\n230:     if (fs.readdirSync(dir).length > 0) {\n231:       console.error(`${TAG} ERROR: ${dir} is not empty, so composing here would mix two trees`);\n232:       return 2;\n233:     }\n234:   }\n235: \n236:   const written = composeFixture(name, dir);\n237:   console.log(`${TAG} ${name} -> ${dir}`);\n238:   for (const relative of written) console.log(`  ${relative}`);\n239:   return 0;\n240: }\n241: \n242: if (require.main === module) {\n243:   try {\n244:     process.exitCode = main(process.argv.slice(2));\n245:   } catch (error) {\n246:     console.error(`${TAG} ERROR: ${error.message}`);\n247:     process.exitCode = 2;\n248:   }\n249: }\n250: \n251: module.exports = {\n252:   FIXTURES,\n253:   MANIFEST_PATH,\n254:   REPO_ROOT,\n255:   SCRIPTS_DIR,\n256:   composeFixture,\n257:   fixtureNames,\n258:   loadRecipe,\n259:   moveBlockBefore,\n260: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs\"}"},"time":{"start":1794559677600,"end":1794559678845}}}}
