{"type":"tool_use","timestamp":1794559620614,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"partID":"prt_1d416afbe002TTnWUKDhaFCrVj","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d41680230018aEz5z6zNlJXEY","type":"tool","id":"call_444f13a6820e4a9db9c24c7a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1060\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist,\n38: //             3 a write failed after the backup, and the run was undone or the restore said why not\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: const { spawnSync } = require('node:child_process');\n45: const crypto = require('node:crypto');\n46: const fs = require('node:fs');\n47: const os = require('node:os');\n48: const path = require('node:path');\n49: \n50: const { buildReport } = require('./agents-md-check.cjs');\n51: const { classifyFile } = require('./release-update.cjs');\n52: const {\n53:   deliveryAnchorEnd,\n54:   findBlock,\n55:   segment,\n56:   sha256,\n57: } = require('./lib/agents-md-sections.cjs');\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 2. CONSTANTS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: const TAG = '[agents-md-embed]';\n64: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n65: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n66: \n67: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n68: // its generator, and the router verdict belongs to the checker that ships with the skill\n69: // authoring rules.\n70: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n71: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n72: const REPO_RULES_TAG = '[repo-rules-check]';\n73: const TOOL_TIMEOUT_MS = 120000;\n74: \n75: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n76: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n77: // The digest is 64 hex characters and a path segment is better short, so the directory is\n78: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n79: // bits of it is what makes two different plans sharing one a non-event.\n80: const BACKUP_NAME_CHARS = 16;\n81: // How many of this composition's directories a plan will step past before it gives up. The\n82: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n83: // a normal one.\n84: const BACKUP_ATTEMPTS = 64;\n85: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n86: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n87: const CLAUDE_POINTER_PATH = 'CLAUDE.md';\n88: \n89: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n90: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n91: // and every removal is checked against this list by `assertWritable` before it happens.\n92: const ALLOWLIST = [\n93:   'AGENTS.md',\n94:   'CLAUDE.md',\n95:   '.codex/AGENTS.md',\n96:   '.cursor/rules/repo-local.md',\n97:   '.cursor/rules/skill-routing.md',\n98:   'REPO RULES.md',\n99: ];\n100: \n101: // A copy at one of these paths is read for its unique lines and then removed. Every other\n102: // runtime-copy row is reported by the check engine and left alone here.\n103: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n104: \n105: const USAGE = [\n106:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n107:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n108:   '                             budget, the survival ledger and the plan digest; write nothing',\n109:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n110:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n111:   'Options:',\n112:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n113:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n114:   '  --remove-claude-md         fold it and leave an @AGENTS.md pointer in its place (the default)',\n115:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n116:   '  --dry-run                  print the plan and write nothing',\n117:   '  --yes                      take the restore confirmation as given',\n118:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n119:   '            2 a precondition failed or a path fell outside the allowlist,',\n120:   '            3 a write failed after the backup, and the run was undone or the restore said why not',\n121: ].join('\\n');\n122: \n123: // A write that throws partway through is neither a run that wrote nothing nor a finished\n124: // run, because the targets before it already hold bytes and the failed one may hold a\n125: // partial one. The backup exists by then, so the failure restores it and ends on an exit\n126: // of its own rather than borrowing one the usage already spends on another meaning.\n127: \n128: // ─────────────────────────────────────────────────────────────────────────────\n129: // 3. ERRORS\n130: // ─────────────────────────────────────────────────────────────────────────────\n131: \n132: class UsageError extends Error {}\n133: class PreconditionError extends Error {}\n134: class AllowlistError extends Error {}\n135: \n136: // ─────────────────────────────────────────────────────────────────────────────\n137: // 4. ARGUMENTS\n138: // ─────────────────────────────────────────────────────────────────────────────\n139: \n140: function readValue(argv, index, flag) {\n141:   const argument = argv[index];\n142:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n143:   if (inline !== null) return { value: inline, next: index };\n144:   const value = argv[index + 1];\n145:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n146:   return { value, next: index + 1 };\n147: }\n148: \n149: function parseArgs(argv) {\n150:   const options = {\n151:     command: null,\n152:     root: REPO_ROOT,\n153:     digest: null,\n154:     run: null,\n155:     keepClaudeMd: false,\n156:     createRouter: false,\n157:     dryRun: false,\n158:     yes: false,\n159:     help: false,\n160:   };\n161: \n162:   const commands = [];\n163:   for (let index = 0; index < argv.length; index += 1) {\n164:     const argument = argv[index];\n165:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n166:     else if (argument === '--root') {\n167:       const read = readValue(argv, index, '--root');\n168:       options.root = path.resolve(read.value);\n169:       index = read.next;\n170:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n171:       const read = readValue(argv, index, '--plan-digest');\n172:       options.digest = read.value.trim();\n173:       index = read.next;\n174:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n175:       const read = readValue(argv, index, '--run');\n176:       options.run = path.resolve(read.value);\n177:       index = read.next;\n178:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n179:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n180:     else if (argument === '--create-router') options.createRouter = true;\n181:     else if (argument === '--dry-run') options.dryRun = true;\n182:     else if (argument === '--yes') options.yes = true;\n183:     else if (argument === '--help' || argument === '-h') options.help = true;\n184:     else throw new UsageError(`unknown argument: ${argument}`);\n185:   }\n186: \n187:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n188:   options.command = commands.length === 1 ? commands[0] : null;\n189:   return options;\n190: }\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 5. SMALL SHARED READERS\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: function loadManifest() {\n197:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n198:   try {\n199:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n200:   } catch (error) {\n201:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n202:   }\n203: }\n204: \n205: function isSymlink(target) {\n206:   try {\n207:     return fs.lstatSync(target).isSymbolicLink();\n208:   } catch {\n209:     return false;\n210:   }\n211: }\n212: \n213: function sameDirectory(a, b) {\n214:   try {\n215:     return fs.realpathSync(a) === fs.realpathSync(b);\n216:   } catch {\n217:     return false;\n218:   }\n219: }\n220: \n221: // The undo a run prints must work as printed. A restore runs against this engine's own\n222: // repository unless told otherwise, so the line names the root whenever it is another one.\n223: function undoCommand(dir, root) {\n224:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n225:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n226: }\n227: \n228: // A line is compared trimmed, and the two lines that carry no content of their own are\n229: // dropped, because a composition may legitimately re-place either of them.\n230: function countLines(text) {\n231:   const counts = new Map();\n232:   for (const raw of String(text).split('\\n')) {\n233:     const line = raw.trim();\n234:     if (line === '' || line === '---') continue;\n235:     counts.set(line, (counts.get(line) || 0) + 1);\n236:   }\n237:   return counts;\n238: }\n239: \n240: function lineSet(text) {\n241:   return new Set(countLines(text).keys());\n242: }\n243: \n244: function uniqueLines(text) {\n245:   return [...countLines(text).keys()];\n246: }\n247: \n248: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n249: // same sentence written twice is two lines to keep.\n250: function lineCount(text) {\n251:   let total = 0;\n252:   for (const count of countLines(text).values()) total += count;\n253:   return total;\n254: }\n255: \n256: // The lines of one body that its reference does not carry, in order and with repeats,\n257: // because the proof counts occurrences rather than membership. The comparison is trimmed\n258: // and the line comes back as it was written: the proof cares that the line survived, and\n259: // the indentation is what makes a nested bullet or a code sample read as one.\n260: function localLinesOf(body, reference) {\n261:   const known = lineSet(reference);\n262:   const lines = [];\n263:   for (const raw of String(body).split('\\n')) {\n264:     const line = raw.trim();\n265:     if (line === '' || line === '---' || known.has(line)) continue;\n266:     lines.push(raw);\n267:   }\n268:   return lines;\n269: }\n270: \n271: function chunkText(text) {\n272:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n273: }\n274: \n275: // ─────────────────────────────────────────────────────────────────────────────\n276: // 6. THE REPOSITORY BLOCK\n277: // ─────────────────────────────────────────────────────────────────────────────\n278: \n279: // What the block holds once the template's own heading and note are set aside. A block a\n280: // previous release wrote opens with both, so recognising them is what keeps a second run\n281: // from nesting one heading inside another.\n282: function blockBody(content, markers) {\n283:   let rest = String(content).replace(/^\\n+/u, '');\n284:   const heading = markers.heading.trim();\n285:   const note = markers.note.trim();\n286:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n287:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n288:   return chunkText(rest);\n289: }\n290: \n291: function renderBlock(markers, body) {\n292:   const text = chunkText(body);\n293:   const between = text === '' ? '' : `${text}\\n`;\n294:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n295: }\n296: \n297: // Devin never sees past the delivery prefix of the root document, so a repository with\n298: // something of its own gets the same block as a Cursor rule that applies always.\n299: function renderMirror(markers, body) {\n300:   const text = chunkText(body);\n301:   const between = text === '' ? '' : `${text}\\n`;\n302:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n303: }\n304: \n305: // A document carrying two blocks has no single block to carry out of, and replacing it\n306: // would have to choose one of them. Naming both positions is what makes the refusal\n307: // actionable: reporting the second block's marker bytes as repository lines the run\n308: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n309: function duplicateBlockMessage(rootFile, block) {\n310:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n311:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n312:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n313: }\n314: \n315: // ─────────────────────────────────────────────────────────────────────────────\n316: // 7. THE ROUTER\n317: // ─────────────────────────────────────────────────────────────────────────────\n318: \n319: function cellsOf(line) {\n320:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n321: }\n322: \n323: // The rule a row points at, which is the identity the checker also compares. Matching on\n324: // the resolved path rather than the whole row is what lets a repository reword a summary\n325: // without the row reading as missing.\n326: function rulePathOf(cells) {\n327:   for (const cell of cells) {\n328:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n329:     if (linked) return linked[1];\n330:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n331:     if (bare) return bare[1];\n332:   }\n333:   return null;\n334: }\n335: \n336: function rowKey(cells) {\n337:   return rulePathOf(cells) || cells.join(' | ');\n338: }\n339: \n340: /**\n341:  * The rows of one router table, with the line each sits on.\n342:  *\n343:  * @param {string} text - The router document.\n344:  * @param {string} anchor - Text that identifies the table's heading.\n345:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n346:  *   Null when the document carries no such table.\n347:  */\n348: function routerTable(text, anchor) {\n349:   const lines = text.split('\\n');\n350:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n351:   if (start === -1) return null;\n352: \n353:   const rows = [];\n354:   let separator = -1;\n355:   let lastRow = -1;\n356:   for (let index = start + 1; index < lines.length; index += 1) {\n357:     const line = lines[index].trim();\n358:     if (line.startsWith('#')) break;\n359:     if (line === '') {\n360:       if (rows.length > 0) break;\n361:       continue;\n362:     }\n363:     if (!line.startsWith('|')) continue;\n364:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n365:       separator = index;\n366:       continue;\n367:     }\n368:     rows.push({ line: index, cells: cellsOf(line) });\n369:     lastRow = index;\n370:   }\n371: \n372:   const anchorLine = rows.length > 0 ? lastRow : separator;\n373:   if (anchorLine === -1) return null;\n374:   return { lines, rows, insertAfter: anchorLine };\n375: }\n376: \n377: /**\n378:  * The router with the shipped rows it is missing, added at the end of each table.\n379:  *\n380:  * @param {string} text\n381:  * @param {Object} manifest\n382:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n383:  */\n384: function addRouterRows(text, manifest) {\n385:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n386:   const tables = [\n387:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n388:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n389:   ];\n390: \n391:   let next = text;\n392:   const added = { trigger: 0, index: 0 };\n393:   const notes = [];\n394: \n395:   for (const table of tables) {\n396:     const found = routerTable(next, table.anchor);\n397:     if (found === null) {\n398:       // A router without the table is a different document shape; appending one would\n399:       // number a second section and break the checker's own reading of the file.\n400:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n401:       continue;\n402:     }\n403:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n404:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n405:     if (missing.length === 0) continue;\n406:     const lines = found.lines.slice();\n407:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n408:     next = lines.join('\\n');\n409:     added[table.kind] = missing.length;\n410:   }\n411: \n412:   return { text: next, added, notes };\n413: }\n414: \n415: // A repository with no router loads no rule at all, so the missing file is created from\n416: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n417: function renderRouter(manifest) {\n418:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n419:   return [\n420:     '# REPO RULES',\n421:     '',\n422:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n423:     'before your first write of the session. This document then routes you to every rule',\n424:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n425:     'holds no rules of its own.',\n426:     '',\n427:     '---',\n428:     '',\n429:     '## 1. HOW TO USE THIS',\n430:     '',\n431:     '1. **Match on the action you are about to take**, not the topic of the request.',\n432:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n433:     '3. **A file already in context is not re-read.**',\n434:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n435:     '',\n436:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n437:     'the same tables, authored one rule at a time.',\n438:     '',\n439:     '---',\n440:     '',\n441:     '## 2. TRIGGER TABLE',\n442:     '',\n443:     '| You are about to… | Load | It settles |',\n444:     '|-------------------|------|-----------|',\n445:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n446:     '',\n447:     '---',\n448:     '',\n449:     '## 3. INDEX',\n450:     '',\n451:     '| Rule | Summary |',\n452:     '|------|---------|',\n453:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n454:     '',\n455:     '---',\n456:     '',\n457:     'Each file the rows name is part of the installation and is replaced by a release.',\n458:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n459:     '',\n460:   ].join('\\n');\n461: }\n462: \n463: // ─────────────────────────────────────────────────────────────────────────────\n464: // 8. THE PLAN DIGEST\n465: // ─────────────────────────────────────────────────────────────────────────────\n466: \n467: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n468: // composed for and by the backup directory the plan takes: the same plan replayed against\n469: // an edited tree composes something else and cannot match, and a plan whose directory an\n470: // earlier run already owns is a different plan, so the digest covers which one it is.\n471: function planDigest(composition, plan) {\n472:   const written = composition.files\n473:     .filter((file) => file.action === 'create' || file.action === 'replace')\n474:     .map((file) => [file.path, file.action, sha256(file.content)])\n475:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n476:   const removed = composition.files\n477:     .filter((file) => file.action === 'remove')\n478:     .map((file) => [file.path, file.action, null])\n479:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n480:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n481: }\n482: \n483: // Where each line of the old document sat, so a lost line is reported with the part it\n484: // belonged to. The block wins over the section it interrupts, because those bytes are the\n485: // repository's and not the section's.\n486: function placementOf(before) {\n487:   const places = new Map();\n488:   for (const section of before.sections) {\n489:     const place = section.id === null\n490:       ? { part: 1, from: 'unmarked section' }\n491:       : { part: 2, from: section.id };\n492:     for (const index of section.rows || []) places.set(index, place);\n493:   }\n494:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n495:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n496:   if (before.block && before.block.complete && before.block.rows) {\n497:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n498:   }\n499:   return places;\n500: }\n501: \n502: // ─────────────────────────────────────────────────────────────────────────────\n503: // 9. THE PRESERVATION PROOF\n504: // ─────────────────────────────────────────────────────────────────────────────\n505: \n506: /**\n507:  * Prove that a composition lost nothing the repository had.\n508:  *\n509:  * Four claims, one per part of the returned record: every line of the old document no\n510:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n511:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n512:  * removed runtime copy still sit in the new document; and every line of the new document\n513:  * outside the block is one the template ships. Pure by construction: same inputs, same\n514:  * answer, no file read.\n515:  *\n516:  * The claim is read from the old document's own lines, in reading order, rather than from\n517:  * the parts the segmentation produced. A proof built from those parts can require only\n518:  * what the reader managed to place, so a line it placed nowhere would be required by\n519:  * nothing and a composition that lost it would still report `dropped 0`.\n520:  *\n521:  * @param {string|null} oldText - The document as it was.\n522:  * @param {string} newText - The document as it would be, or as it now is.\n523:  * @param {Object} manifest\n524:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n525:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n526:  *   foreign: Array<{line: string}>}}\n527:  */\n528: function preservationCheck(oldText, newText, manifest, options = {}) {\n529:   const markers = manifest.markers;\n530:   const dropped = [];\n531:   const knownShipped = new Set();\n532:   for (const entry of Object.values(manifest.derived.sections || {})) {\n533:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n534:   }\n535:   for (const entry of manifest.derived.history || []) {\n536:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n537:   }\n538: \n539:   // The framework's own bytes: the two markers and the heading and note that come with\n540:   // them. The new document carries one of each whatever the old one carried, so requiring\n541:   // them would report a duplicated block as repository lines the run dropped.\n542:   const framework = new Set([\n543:     markers.start.trim(),\n544:     markers.end.trim(),\n545:     markers.heading.trim(),\n546:     markers.note.trim(),\n547:   ]);\n548: \n549:   const before = oldText === null || oldText === undefined\n550:     ? { sections: [], block: null, prelude: null }\n551:     : segment(oldText, markers, manifest.sections);\n552:   const after = segment(newText, markers, manifest.sections);\n553:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n554:   const newBlockCounts = countLines(newBlock);\n555:   const newDocumentCounts = countLines(newText);\n556: \n557:   const require = (line, part, from, need) => {\n558:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n559:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n560:   };\n561: \n562:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n563:   // the new block at least as often as it was there. Where the line sat decides only which\n564:   // part names it when it goes missing.\n565:   const places = placementOf(before);\n566:   const needed = new Map();\n567:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n568:   for (let index = 0; index < oldLines.length; index += 1) {\n569:     const line = oldLines[index].trim();\n570:     if (line === '' || line === '---') continue;\n571:     if (framework.has(line) || knownShipped.has(line)) continue;\n572:     const place = places.get(index) || { part: 1, from: 'the document' };\n573:     const entry = needed.get(line);\n574:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n575:     else entry.need += 1;\n576:   }\n577:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n578: \n579:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n580:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n581:   for (const copy of options.removed || []) {\n582:     for (const [line, count] of countLines(copy.content)) {\n583:       if (framework.has(line)) continue;\n584:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n585:       require(line, 3, copy.path, count);\n586:     }\n587:   }\n588: \n589:   // Part 4. Nothing above the block that the template does not ship.\n590:   const currentOnly = new Set();\n591:   for (const entry of Object.values(manifest.derived.sections || {})) {\n592:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n593:   }\n594:   const foreign = [];\n595:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n596:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n597:   const newBytes = Buffer.from(newText, 'utf8');\n598:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n599:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n600:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n601:   for (const line of uniqueLines(outside)) {\n602:     if (!currentOnly.has(line)) foreign.push({ line });\n603:   }\n604: \n605:   return { dropped, foreign };\n606: }\n607: \n608: // ─────────────────────────────────────────────────────────────────────────────\n609: // 10. COMPOSITION\n610: // ─────────────────────────────────────────────────────────────────────────────\n611: \n612: function rowOf(report, id) {\n613:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n614: }\n615: \n616: function fileState(text) {\n617:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n618: }\n619: \n620: function historyBodyOf(manifest, hash) {\n621:   if (!hash) return null;\n622:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n623:   return entry ? entry.body : null;\n624: }\n625: \n626: function prefixEndOf(text, manifest) {\n627:   if (text === null) return 0;\n628:   const { sections } = segment(text, manifest.markers, manifest.sections);\n629:   const byId = new Map();\n630:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n631:   let end = 0;\n632:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n633:     const section = byId.get(pin.section);\n634:     if (!section) continue;\n635:     const measured = deliveryAnchorEnd(section, pin);\n636:     if (measured !== null) end = Math.max(end, measured);\n637:   }\n638:   return end;\n639: }\n640: \n641: /**\n642:  * Build every target of one repository in memory, with the ledger and the digest.\n643:  *\n644:  * Nothing here writes; the caller decides what to do with the answer.\n645:  *\n646:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n647:  * @returns {Object} the composition\n648:  */\n649: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n650:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n651:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n652: \n653:   const markers = manifest.markers;\n654:   const rootFile = manifest.root_file;\n655:   const claudePointer = `@${manifest.root_file}\\n`;\n656:   const rootPath = path.join(root, rootFile);\n657:   // Writing through a link would change a file this repository does not own, and the backup\n658:   // could not put the link back.\n659:   if (isSymlink(rootPath)) {\n660:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n661:   }\n662:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n663: \n664:   const block = oldText === null ? null : findBlock(oldText, markers);\n665:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n666:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n667:   }\n668:   if (block !== null && block.complete === false) {\n669:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n670:   }\n671: \n672:   const oldSegmentation = oldText === null\n673:     ? { sections: [], block: null, prelude: null }\n674:     : segment(oldText, markers, manifest.sections);\n675:   const oldSections = oldSegmentation.sections;\n676:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n677:   const notes = [];\n678:   const chunks = [];\n679: \n680:   // (a) Whatever the block already held.\n681:   if (block !== null && block.complete) {\n682:     const body = blockBody(block.content, markers);\n683:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n684:   }\n685: \n686:   // Text above the first heading belongs to no section, and a replacement would drop it.\n687:   // The segmenter reports it apart from the sections because no heading covers it.\n688:   if (oldSegmentation.prelude !== null) {\n689:     const preamble = chunkText(oldSegmentation.prelude.text);\n690:     if (preamble !== '') {\n691:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n692:     }\n693:   }\n694: \n695:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n696:   // the first heading is already carried as the preamble, and its byte range would reach\n697:   // a block written above the template, so it is the one entry skipped here.\n698:   const unmarkedRow = rowOf(report, 'A8');\n699:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n700:   const unmarked = unmarkedRow.entries\n701:     .filter((entry) => entry.heading !== null)\n702:     .sort((left, right) => left.byte_start - right.byte_start);\n703:   for (const entry of unmarked) {\n704:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n705:     if (text === '') continue;\n706:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n707:   }\n708: \n709:   // (c) The local lines of a section somebody edited, each under its own id.\n710:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n711:   for (const entry of edited) {\n712:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n713:     if (!section) continue;\n714:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n715:     const lines = localLinesOf(section.body, shippedBody);\n716:     if (lines.length === 0) continue;\n717:     chunks.push({\n718:       kind: 'edited',\n719:       id: entry.id,\n720:       lines: lines.length,\n721:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n722:     });\n723: \n724:     // A clean merge would leave the section edited forever, so it is offered as a reading\n725:     // of the same bytes and never as the default.\n726:     const base = historyBodyOf(manifest, entry.base);\n727:     if (base !== null) {\n728:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n729:       if (merged.conflictKind === 'mergeable') {\n730:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n731:       }\n732:     }\n733:   }\n734: \n735:   // (d) The unique lines of a runtime copy that is folded away.\n736:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n737:   const removedCopies = [];\n738:   for (const copy of copies) {\n739:     const absolute = path.join(root, copy.path);\n740:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n741:     if (copy.state !== 'FINDING') continue;\n742:     const content = fs.readFileSync(absolute, 'utf8');\n743:     // With no root document every line of the copy is its own, and the count has to survive:\n744:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n745:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n746:     if (lines.length > 0) {\n747:       chunks.push({\n748:         kind: 'copy',\n749:         path: copy.path,\n750:         lines: lines.length,\n751:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n752:       });\n753:     }\n754:     removedCopies.push({ path: copy.path, content });\n755:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n756:       removedCopies.pop();\n757:       if (lines.length > 0) {\n758:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n759:       }\n760:     }\n761:   }\n762: \n763:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n764:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n765: \n766:   // The template with nothing of the repository's own in it gains nothing from the two\n767:   // marker lines, so that difference alone is not a reason to write: the markers appear\n768:   // with the first line worth keeping.\n769:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n770:   if (templateOnly) {\n771:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n772:   }\n773: \n774:   const files = [];\n775:   if (templateOnly || oldText === composed) {\n776:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n777:   } else {\n778:     files.push({\n779:       path: rootFile,\n780:       action: oldText === null ? 'create' : 'replace',\n781:       content: composed,\n782:       before: oldText,\n783:     });\n784:   }\n785: \n786:   // The router gains the shipped rows it is missing, or is created from them when asked.\n787:   const routerPath = path.join(root, manifest.router_file);\n788:   let routerAction = 'unchanged';\n789:   let routerText = null;\n790:   if (fs.existsSync(routerPath)) {\n791:     const current = fs.readFileSync(routerPath, 'utf8');\n792:     const result = addRouterRows(current, manifest);\n793:     notes.push(...result.notes);\n794:     if (result.text !== current) {\n795:       routerText = result.text;\n796:       routerAction = 'replace';\n797:       if (result.added.trigger > 0 || result.added.index > 0) {\n798:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n799:       }\n800:     }\n801:   } else if (createRouter) {\n802:     routerText = renderRouter(manifest);\n803:     routerAction = 'create';\n804:   } else {\n805:     routerAction = 'absent';\n806:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n807:   }\n808:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n809: \n810:   // The Cursor mirror exists exactly when the block carries something, because an empty\n811:   // block has nothing a runtime that cannot read past the prefix would miss.\n812:   const mirrorPath = path.join(root, MIRROR_FILE);\n813:   const mirrorExists = fs.existsSync(mirrorPath);\n814:   let mirrorAction = 'unchanged';\n815:   let mirrorText = null;\n816:   if (blockText !== '') {\n817:     mirrorText = renderMirror(markers, blockText);\n818:     if (!mirrorExists) mirrorAction = 'create';\n819:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n820:   } else if (mirrorExists) {\n821:     mirrorAction = 'remove';\n822:   }\n823:   if (mirrorAction !== 'unchanged') {\n824:     files.push({\n825:       path: MIRROR_FILE,\n826:       action: mirrorAction,\n827:       content: mirrorText,\n828:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n829:     });\n830:   }\n831: \n832:   for (const copy of removedCopies) {\n833:     if (copy.path === CLAUDE_POINTER_PATH) {\n834:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n835:       continue;\n836:     }\n837:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n838:   }\n839: \n840:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n841:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n842:   if (\n843:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n844:     && !fs.existsSync(claudePath)\n845:     && !isSymlink(claudePath)\n846:   ) {\n847:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n848:   }\n849: \n850:   const composition = {\n851:     root,\n852:     state: report.state,\n853:     report,\n854:     markers,\n855:     rootFile,\n856:     oldText,\n857:     composed,\n858:     block: { text: renderBlock(markers, blockText), body: blockText },\n859:     chunks,\n860:     removedCopies,\n861:     notes,\n862:     files,\n863:     budget: {\n864:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n865:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n866:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n867:     },\n868:     ledger: {\n869:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n870:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n871:       shippedReplaced: manifest.sections.length,\n872:       dropped: 0,\n873:     },\n874:   };\n875: \n876:   // What the run would put on disk, which is exactly the three actions a target can take.\n877:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n878:   return composition;\n879: }\n880: \n881: // ─────────────────────────────────────────────────────────────────────────────\n882: // 11. THE WRITE ALLOWLIST\n883: // ─────────────────────────────────────────────────────────────────────────────\n884: \n885: /**\n886:  * Resolve one path a run wants to touch, or refuse it.\n887:  *\n888:  * Containment is checked before membership, so a path that climbs out of the root is\n889:  * reported as what it is rather than as a missing allowlist entry.\n890:  *\n891:  * @param {string} root\n892:  * @param {string} relative\n893:  * @returns {string} the absolute path\n894:  */\n895: function assertWritable(root, relative) {\n896:   const base = path.resolve(root);\n897:   const normalized = String(relative).split(path.sep).join('/');\n898:   const absolute = path.resolve(base, normalized);\n899:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n900:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n901:   }\n902:   if (!ALLOWLIST.includes(normalized)) {\n903:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n904:   }\n905:   // Every path a run reaches must sit inside the root where the root really is, not only\n906:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n907:   const realBase = fs.realpathSync(base);\n908:   const realTarget = resolveThroughLinks(absolute);\n909:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n910:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n911:   }\n912:   return absolute;\n913: }\n914: \n915: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n916: // and the rest of the name is appended to it.\n917: function resolveThroughLinks(absolute) {\n918:   try {\n919:     return fs.realpathSync(absolute);\n920:   } catch {\n921:     const parent = path.dirname(absolute);\n922:     if (parent === absolute) return absolute;\n923:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n924:   }\n925: }\n926: \n927: // ─────────────────────────────────────────────────────────────────────────────\n928: // 12. BACKUPS\n929: // ─────────────────────────────────────────────────────────────────────────────\n930: \n931: function utcStamp(date = new Date()) {\n932:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n933: }\n934: \n935: /**\n936:  * The directory a plan's backup sits in, named after the plan digest.\n937:  *\n938:  * Named by the digest rather than by a clock reading because apply has to land exactly\n939:  * where the plan pointed and the digest is the only thing the operator carries across. The\n940:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n941:  * taken and moves to the next ordinal instead of writing beside it.\n942:  *\n943:  * @param {string} base\n944:  * @param {string} digest\n945:  * @returns {string}\n946:  */\n947: function backupDirectoryOf(base, digest) {\n948:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n949: }\n950: \n951: /**\n952:  * Where a run's backup goes, without creating anything.\n953:  *\n954:  * The output directory is used only when git ignores it, because a backup inside a tracked\n955:  * path is a backup the next commit publishes. Everything else leaves the repository.\n956:  *\n957:  * @param {{root: string}} input\n958:  * @returns {{dir: string, fallback: boolean, reason: string}}\n959:  */\n960: function backupBase({ root }) {\n961:   const candidate = path.join(root, BACKUP_DIR);\n962:   // The question is the one the run depends on: would a plan directory under this one be\n963:   // published by the next commit? Asking about the base alone would miss a rule written as\n964:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n965:   // the probe is a path of the same shape as the one the plan takes.\n966:   const probe = path.join(candidate, 'probe');\n967:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n968:     encoding: 'utf8',\n969:     timeout: TOOL_TIMEOUT_MS,\n970:   });\n971:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n972:   const reason = ignored.status === 1\n973:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n974:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n975:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n976: }\n977: \n978: /**\n979:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n980:  * that says both.\n981:  *\n982:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n983:  * suffixed into a second name, because the printed undo command would then point at that\n984:  * run's bytes; the next ordinal is a different plan with a different digest and a\n985:  * directory of its own.\n986:  *\n987:  * @param {Object} composition\n988:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n989:  */\n990: function planFor(composition) {\n991:   const base = backupBase({ root: composition.root });\n992:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n993:     const digest = planDigest(composition, { ordinal, base: base.dir });\n994:     const dir = backupDirectoryOf(base.dir, digest);\n995:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n996:   }\n997:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n998: }\n999: \n1000: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n1001: // only these, so on a record the run wrote, a folder that was there before the run is never\n1002: // taken away with it.\n1003: function missingParents(root, relative) {\n1004:   const missing = [];\n1005:   let dir = path.posix.dirname(relative);\n1006:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1007:     missing.push(dir);\n1008:     dir = path.posix.dirname(dir);\n1009:   }\n1010:   return missing;\n1011: }\n1012: \n1013: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1014: // entry's own allowlisted path; the list stops at the first one that is not.\n1015: function recordedCreatedDirs(entry) {\n1016:   const dirs = [];\n1017:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1018:   for (const dir of entry.createdDirs) {\n1019:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1020:     dirs.push(dir);\n1021:   }\n1022:   return dirs;\n1023: }\n1024: \n1025: // Runs after every file is back, because two new files can share one new folder. Only the\n1026: // folders above a file this restore just deleted are considered, and only an empty one is\n1027: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1028: // file the run created.\n1029: function removeCreatedDirs(root, entries, deleted) {\n1030:   const removed = [];\n1031:   for (const entry of entries) {\n1032:     if (!deleted.has(entry.path)) continue;\n1033:     for (const dir of recordedCreatedDirs(entry)) {\n1034:       const absolute = path.join(root, dir);\n1035:       let names;\n1036:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1037:       if (names.length > 0) break;\n1038:       fs.rmdirSync(absolute);\n1039:       removed.push(dir);\n1040:     }\n1041:   }\n1042:   return removed;\n1043: }\n1044: \n1045: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1046: // copy rather than a reconstruction.\n1047: function backupEntry(root, file) {\n1048:   const absolute = path.join(root, file.path);\n1049:   const exists = fs.existsSync(absolute);\n1050:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1051:   if (!exists) {\n1052:     entry.createdDirs = missingParents(root, file.path);\n1053:     return entry;\n1054:   }\n1055:   const stats = fs.lstatSync(absolute);\n1056:   entry.mode = stats.mode.toString(8).slice(-4);\n1057:   entry.symlink = stats.isSymbolicLink();\n1058:   const bytes = fs.readFileSync(absolute);\n1059:   entry.sha256 = sha256(bytes.toString('utf8'));\n1060:   entry.backup = path.posix.join('files', file.path);\n[Output truncated. Continue reading with offset: 1061]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1060\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist,\n38: //             3 a write failed after the backup, and the run was undone or the restore said why not\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: const { spawnSync } = require('node:child_process');\n45: const crypto = require('node:crypto');\n46: const fs = require('node:fs');\n47: const os = require('node:os');\n48: const path = require('node:path');\n49: \n50: const { buildReport } = require('./agents-md-check.cjs');\n51: const { classifyFile } = require('./release-update.cjs');\n52: const {\n53:   deliveryAnchorEnd,\n54:   findBlock,\n55:   segment,\n56:   sha256,\n57: } = require('./lib/agents-md-sections.cjs');\n58: \n59: // ─────────────────────────────────────────────────────────────────────────────\n60: // 2. CONSTANTS\n61: // ─────────────────────────────────────────────────────────────────────────────\n62: \n63: const TAG = '[agents-md-embed]';\n64: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n65: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n66: \n67: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n68: // its generator, and the router verdict belongs to the checker that ships with the skill\n69: // authoring rules.\n70: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n71: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n72: const REPO_RULES_TAG = '[repo-rules-check]';\n73: const TOOL_TIMEOUT_MS = 120000;\n74: \n75: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n76: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n77: // The digest is 64 hex characters and a path segment is better short, so the directory is\n78: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n79: // bits of it is what makes two different plans sharing one a non-event.\n80: const BACKUP_NAME_CHARS = 16;\n81: // How many of this composition's directories a plan will step past before it gives up. The\n82: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n83: // a normal one.\n84: const BACKUP_ATTEMPTS = 64;\n85: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n86: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n87: const CLAUDE_POINTER_PATH = 'CLAUDE.md';\n88: \n89: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n90: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n91: // and every removal is checked against this list by `assertWritable` before it happens.\n92: const ALLOWLIST = [\n93:   'AGENTS.md',\n94:   'CLAUDE.md',\n95:   '.codex/AGENTS.md',\n96:   '.cursor/rules/repo-local.md',\n97:   '.cursor/rules/skill-routing.md',\n98:   'REPO RULES.md',\n99: ];\n100: \n101: // A copy at one of these paths is read for its unique lines and then removed. Every other\n102: // runtime-copy row is reported by the check engine and left alone here.\n103: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n104: \n105: const USAGE = [\n106:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n107:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n108:   '                             budget, the survival ledger and the plan digest; write nothing',\n109:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n110:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n111:   'Options:',\n112:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n113:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n114:   '  --remove-claude-md         fold it and leave an @AGENTS.md pointer in its place (the default)',\n115:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n116:   '  --dry-run                  print the plan and write nothing',\n117:   '  --yes                      take the restore confirmation as given',\n118:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n119:   '            2 a precondition failed or a path fell outside the allowlist,',\n120:   '            3 a write failed after the backup, and the run was undone or the restore said why not',\n121: ].join('\\n');\n122: \n123: // A write that throws partway through is neither a run that wrote nothing nor a finished\n124: // run, because the targets before it already hold bytes and the failed one may hold a\n125: // partial one. The backup exists by then, so the failure restores it and ends on an exit\n126: // of its own rather than borrowing one the usage already spends on another meaning.\n127: \n128: // ─────────────────────────────────────────────────────────────────────────────\n129: // 3. ERRORS\n130: // ─────────────────────────────────────────────────────────────────────────────\n131: \n132: class UsageError extends Error {}\n133: class PreconditionError extends Error {}\n134: class AllowlistError extends Error {}\n135: \n136: // ─────────────────────────────────────────────────────────────────────────────\n137: // 4. ARGUMENTS\n138: // ─────────────────────────────────────────────────────────────────────────────\n139: \n140: function readValue(argv, index, flag) {\n141:   const argument = argv[index];\n142:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n143:   if (inline !== null) return { value: inline, next: index };\n144:   const value = argv[index + 1];\n145:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n146:   return { value, next: index + 1 };\n147: }\n148: \n149: function parseArgs(argv) {\n150:   const options = {\n151:     command: null,\n152:     root: REPO_ROOT,\n153:     digest: null,\n154:     run: null,\n155:     keepClaudeMd: false,\n156:     createRouter: false,\n157:     dryRun: false,\n158:     yes: false,\n159:     help: false,\n160:   };\n161: \n162:   const commands = [];\n163:   for (let index = 0; index < argv.length; index += 1) {\n164:     const argument = argv[index];\n165:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n166:     else if (argument === '--root') {\n167:       const read = readValue(argv, index, '--root');\n168:       options.root = path.resolve(read.value);\n169:       index = read.next;\n170:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n171:       const read = readValue(argv, index, '--plan-digest');\n172:       options.digest = read.value.trim();\n173:       index = read.next;\n174:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n175:       const read = readValue(argv, index, '--run');\n176:       options.run = path.resolve(read.value);\n177:       index = read.next;\n178:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n179:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n180:     else if (argument === '--create-router') options.createRouter = true;\n181:     else if (argument === '--dry-run') options.dryRun = true;\n182:     else if (argument === '--yes') options.yes = true;\n183:     else if (argument === '--help' || argument === '-h') options.help = true;\n184:     else throw new UsageError(`unknown argument: ${argument}`);\n185:   }\n186: \n187:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n188:   options.command = commands.length === 1 ? commands[0] : null;\n189:   return options;\n190: }\n191: \n192: // ─────────────────────────────────────────────────────────────────────────────\n193: // 5. SMALL SHARED READERS\n194: // ─────────────────────────────────────────────────────────────────────────────\n195: \n196: function loadManifest() {\n197:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n198:   try {\n199:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n200:   } catch (error) {\n201:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n202:   }\n203: }\n204: \n205: function isSymlink(target) {\n206:   try {\n207:     return fs.lstatSync(target).isSymbolicLink();\n208:   } catch {\n209:     return false;\n210:   }\n211: }\n212: \n213: function sameDirectory(a, b) {\n214:   try {\n215:     return fs.realpathSync(a) === fs.realpathSync(b);\n216:   } catch {\n217:     return false;\n218:   }\n219: }\n220: \n221: // The undo a run prints must work as printed. A restore runs against this engine's own\n222: // repository unless told otherwise, so the line names the root whenever it is another one.\n223: function undoCommand(dir, root) {\n224:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n225:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n226: }\n227: \n228: // A line is compared trimmed, and the two lines that carry no content of their own are\n229: // dropped, because a composition may legitimately re-place either of them.\n230: function countLines(text) {\n231:   const counts = new Map();\n232:   for (const raw of String(text).split('\\n')) {\n233:     const line = raw.trim();\n234:     if (line === '' || line === '---') continue;\n235:     counts.set(line, (counts.get(line) || 0) + 1);\n236:   }\n237:   return counts;\n238: }\n239: \n240: function lineSet(text) {\n241:   return new Set(countLines(text).keys());\n242: }\n243: \n244: function uniqueLines(text) {\n245:   return [...countLines(text).keys()];\n246: }\n247: \n248: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n249: // same sentence written twice is two lines to keep.\n250: function lineCount(text) {\n251:   let total = 0;\n252:   for (const count of countLines(text).values()) total += count;\n253:   return total;\n254: }\n255: \n256: // The lines of one body that its reference does not carry, in order and with repeats,\n257: // because the proof counts occurrences rather than membership. The comparison is trimmed\n258: // and the line comes back as it was written: the proof cares that the line survived, and\n259: // the indentation is what makes a nested bullet or a code sample read as one.\n260: function localLinesOf(body, reference) {\n261:   const known = lineSet(reference);\n262:   const lines = [];\n263:   for (const raw of String(body).split('\\n')) {\n264:     const line = raw.trim();\n265:     if (line === '' || line === '---' || known.has(line)) continue;\n266:     lines.push(raw);\n267:   }\n268:   return lines;\n269: }\n270: \n271: function chunkText(text) {\n272:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n273: }\n274: \n275: // ─────────────────────────────────────────────────────────────────────────────\n276: // 6. THE REPOSITORY BLOCK\n277: // ─────────────────────────────────────────────────────────────────────────────\n278: \n279: // What the block holds once the template's own heading and note are set aside. A block a\n280: // previous release wrote opens with both, so recognising them is what keeps a second run\n281: // from nesting one heading inside another.\n282: function blockBody(content, markers) {\n283:   let rest = String(content).replace(/^\\n+/u, '');\n284:   const heading = markers.heading.trim();\n285:   const note = markers.note.trim();\n286:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n287:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n288:   return chunkText(rest);\n289: }\n290: \n291: function renderBlock(markers, body) {\n292:   const text = chunkText(body);\n293:   const between = text === '' ? '' : `${text}\\n`;\n294:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n295: }\n296: \n297: // Devin never sees past the delivery prefix of the root document, so a repository with\n298: // something of its own gets the same block as a Cursor rule that applies always.\n299: function renderMirror(markers, body) {\n300:   const text = chunkText(body);\n301:   const between = text === '' ? '' : `${text}\\n`;\n302:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n303: }\n304: \n305: // A document carrying two blocks has no single block to carry out of, and replacing it\n306: // would have to choose one of them. Naming both positions is what makes the refusal\n307: // actionable: reporting the second block's marker bytes as repository lines the run\n308: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n309: function duplicateBlockMessage(rootFile, block) {\n310:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n311:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n312:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n313: }\n314: \n315: // ─────────────────────────────────────────────────────────────────────────────\n316: // 7. THE ROUTER\n317: // ─────────────────────────────────────────────────────────────────────────────\n318: \n319: function cellsOf(line) {\n320:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n321: }\n322: \n323: // The rule a row points at, which is the identity the checker also compares. Matching on\n324: // the resolved path rather than the whole row is what lets a repository reword a summary\n325: // without the row reading as missing.\n326: function rulePathOf(cells) {\n327:   for (const cell of cells) {\n328:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n329:     if (linked) return linked[1];\n330:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n331:     if (bare) return bare[1];\n332:   }\n333:   return null;\n334: }\n335: \n336: function rowKey(cells) {\n337:   return rulePathOf(cells) || cells.join(' | ');\n338: }\n339: \n340: /**\n341:  * The rows of one router table, with the line each sits on.\n342:  *\n343:  * @param {string} text - The router document.\n344:  * @param {string} anchor - Text that identifies the table's heading.\n345:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n346:  *   Null when the document carries no such table.\n347:  */\n348: function routerTable(text, anchor) {\n349:   const lines = text.split('\\n');\n350:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n351:   if (start === -1) return null;\n352: \n353:   const rows = [];\n354:   let separator = -1;\n355:   let lastRow = -1;\n356:   for (let index = start + 1; index < lines.length; index += 1) {\n357:     const line = lines[index].trim();\n358:     if (line.startsWith('#')) break;\n359:     if (line === '') {\n360:       if (rows.length > 0) break;\n361:       continue;\n362:     }\n363:     if (!line.startsWith('|')) continue;\n364:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n365:       separator = index;\n366:       continue;\n367:     }\n368:     rows.push({ line: index, cells: cellsOf(line) });\n369:     lastRow = index;\n370:   }\n371: \n372:   const anchorLine = rows.length > 0 ? lastRow : separator;\n373:   if (anchorLine === -1) return null;\n374:   return { lines, rows, insertAfter: anchorLine };\n375: }\n376: \n377: /**\n378:  * The router with the shipped rows it is missing, added at the end of each table.\n379:  *\n380:  * @param {string} text\n381:  * @param {Object} manifest\n382:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n383:  */\n384: function addRouterRows(text, manifest) {\n385:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n386:   const tables = [\n387:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n388:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n389:   ];\n390: \n391:   let next = text;\n392:   const added = { trigger: 0, index: 0 };\n393:   const notes = [];\n394: \n395:   for (const table of tables) {\n396:     const found = routerTable(next, table.anchor);\n397:     if (found === null) {\n398:       // A router without the table is a different document shape; appending one would\n399:       // number a second section and break the checker's own reading of the file.\n400:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n401:       continue;\n402:     }\n403:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n404:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n405:     if (missing.length === 0) continue;\n406:     const lines = found.lines.slice();\n407:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n408:     next = lines.join('\\n');\n409:     added[table.kind] = missing.length;\n410:   }\n411: \n412:   return { text: next, added, notes };\n413: }\n414: \n415: // A repository with no router loads no rule at all, so the missing file is created from\n416: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n417: function renderRouter(manifest) {\n418:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n419:   return [\n420:     '# REPO RULES',\n421:     '',\n422:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n423:     'before your first write of the session. This document then routes you to every rule',\n424:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n425:     'holds no rules of its own.',\n426:     '',\n427:     '---',\n428:     '',\n429:     '## 1. HOW TO USE THIS',\n430:     '',\n431:     '1. **Match on the action you are about to take**, not the topic of the request.',\n432:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n433:     '3. **A file already in context is not re-read.**',\n434:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n435:     '',\n436:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n437:     'the same tables, authored one rule at a time.',\n438:     '',\n439:     '---',\n440:     '',\n441:     '## 2. TRIGGER TABLE',\n442:     '',\n443:     '| You are about to… | Load | It settles |',\n444:     '|-------------------|------|-----------|',\n445:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n446:     '',\n447:     '---',\n448:     '',\n449:     '## 3. INDEX',\n450:     '',\n451:     '| Rule | Summary |',\n452:     '|------|---------|',\n453:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n454:     '',\n455:     '---',\n456:     '',\n457:     'Each file the rows name is part of the installation and is replaced by a release.',\n458:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n459:     '',\n460:   ].join('\\n');\n461: }\n462: \n463: // ─────────────────────────────────────────────────────────────────────────────\n464: // 8. THE PLAN DIGEST\n465: // ─────────────────────────────────────────────────────────────────────────────\n466: \n467: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n468: // composed for and by the backup directory the plan takes: the same plan replayed against\n469: // an edited tree composes something else and cannot match, and a plan whose directory an\n470: // earlier run already owns is a different plan, so the digest covers which one it is.\n471: function planDigest(composition, plan) {\n472:   const written = composition.files\n473:     .filter((file) => file.action === 'create' || file.action === 'replace')\n474:     .map((file) => [file.path, file.action, sha256(file.content)])\n475:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n476:   const removed = composition.files\n477:     .filter((file) => file.action === 'remove')\n478:     .map((file) => [file.path, file.action, null])\n479:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n480:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n481: }\n482: \n483: // Where each line of the old document sat, so a lost line is reported with the part it\n484: // belonged to. The block wins over the section it interrupts, because those bytes are the\n485: // repository's and not the section's.\n486: function placementOf(before) {\n487:   const places = new Map();\n488:   for (const section of before.sections) {\n489:     const place = section.id === null\n490:       ? { part: 1, from: 'unmarked section' }\n491:       : { part: 2, from: section.id };\n492:     for (const index of section.rows || []) places.set(index, place);\n493:   }\n494:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n495:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n496:   if (before.block && before.block.complete && before.block.rows) {\n497:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n498:   }\n499:   return places;\n500: }\n501: \n502: // ─────────────────────────────────────────────────────────────────────────────\n503: // 9. THE PRESERVATION PROOF\n504: // ─────────────────────────────────────────────────────────────────────────────\n505: \n506: /**\n507:  * Prove that a composition lost nothing the repository had.\n508:  *\n509:  * Four claims, one per part of the returned record: every line of the old document no\n510:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n511:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n512:  * removed runtime copy still sit in the new document; and every line of the new document\n513:  * outside the block is one the template ships. Pure by construction: same inputs, same\n514:  * answer, no file read.\n515:  *\n516:  * The claim is read from the old document's own lines, in reading order, rather than from\n517:  * the parts the segmentation produced. A proof built from those parts can require only\n518:  * what the reader managed to place, so a line it placed nowhere would be required by\n519:  * nothing and a composition that lost it would still report `dropped 0`.\n520:  *\n521:  * @param {string|null} oldText - The document as it was.\n522:  * @param {string} newText - The document as it would be, or as it now is.\n523:  * @param {Object} manifest\n524:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n525:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n526:  *   foreign: Array<{line: string}>}}\n527:  */\n528: function preservationCheck(oldText, newText, manifest, options = {}) {\n529:   const markers = manifest.markers;\n530:   const dropped = [];\n531:   const knownShipped = new Set();\n532:   for (const entry of Object.values(manifest.derived.sections || {})) {\n533:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n534:   }\n535:   for (const entry of manifest.derived.history || []) {\n536:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n537:   }\n538: \n539:   // The framework's own bytes: the two markers and the heading and note that come with\n540:   // them. The new document carries one of each whatever the old one carried, so requiring\n541:   // them would report a duplicated block as repository lines the run dropped.\n542:   const framework = new Set([\n543:     markers.start.trim(),\n544:     markers.end.trim(),\n545:     markers.heading.trim(),\n546:     markers.note.trim(),\n547:   ]);\n548: \n549:   const before = oldText === null || oldText === undefined\n550:     ? { sections: [], block: null, prelude: null }\n551:     : segment(oldText, markers, manifest.sections);\n552:   const after = segment(newText, markers, manifest.sections);\n553:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n554:   const newBlockCounts = countLines(newBlock);\n555:   const newDocumentCounts = countLines(newText);\n556: \n557:   const require = (line, part, from, need) => {\n558:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n559:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n560:   };\n561: \n562:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n563:   // the new block at least as often as it was there. Where the line sat decides only which\n564:   // part names it when it goes missing.\n565:   const places = placementOf(before);\n566:   const needed = new Map();\n567:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n568:   for (let index = 0; index < oldLines.length; index += 1) {\n569:     const line = oldLines[index].trim();\n570:     if (line === '' || line === '---') continue;\n571:     if (framework.has(line) || knownShipped.has(line)) continue;\n572:     const place = places.get(index) || { part: 1, from: 'the document' };\n573:     const entry = needed.get(line);\n574:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n575:     else entry.need += 1;\n576:   }\n577:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n578: \n579:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n580:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n581:   for (const copy of options.removed || []) {\n582:     for (const [line, count] of countLines(copy.content)) {\n583:       if (framework.has(line)) continue;\n584:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n585:       require(line, 3, copy.path, count);\n586:     }\n587:   }\n588: \n589:   // Part 4. Nothing above the block that the template does not ship.\n590:   const currentOnly = new Set();\n591:   for (const entry of Object.values(manifest.derived.sections || {})) {\n592:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n593:   }\n594:   const foreign = [];\n595:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n596:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n597:   const newBytes = Buffer.from(newText, 'utf8');\n598:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n599:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n600:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n601:   for (const line of uniqueLines(outside)) {\n602:     if (!currentOnly.has(line)) foreign.push({ line });\n603:   }\n604: \n605:   return { dropped, foreign };\n606: }\n607: \n608: // ─────────────────────────────────────────────────────────────────────────────\n609: // 10. COMPOSITION\n610: // ─────────────────────────────────────────────────────────────────────────────\n611: \n612: function rowOf(report, id) {\n613:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n614: }\n615: \n616: function fileState(text) {\n617:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n618: }\n619: \n620: function historyBodyOf(manifest, hash) {\n621:   if (!hash) return null;\n622:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n623:   return entry ? entry.body : null;\n624: }\n625: \n626: function prefixEndOf(text, manifest) {\n627:   if (text === null) return 0;\n628:   const { sections } = segment(text, manifest.markers, manifest.sections);\n629:   const byId = new Map();\n630:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n631:   let end = 0;\n632:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n633:     const section = byId.get(pin.section);\n634:     if (!section) continue;\n635:     const measured = deliveryAnchorEnd(section, pin);\n636:     if (measured !== null) end = Math.max(end, measured);\n637:   }\n638:   return end;\n639: }\n640: \n641: /**\n642:  * Build every target of one repository in memory, with the ledger and the digest.\n643:  *\n644:  * Nothing here writes; the caller decides what to do with the answer.\n645:  *\n646:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n647:  * @returns {Object} the composition\n648:  */\n649: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n650:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n651:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n652: \n653:   const markers = manifest.markers;\n654:   const rootFile = manifest.root_file;\n655:   const claudePointer = `@${manifest.root_file}\\n`;\n656:   const rootPath = path.join(root, rootFile);\n657:   // Writing through a link would change a file this repository does not own, and the backup\n658:   // could not put the link back.\n659:   if (isSymlink(rootPath)) {\n660:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n661:   }\n662:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n663: \n664:   const block = oldText === null ? null : findBlock(oldText, markers);\n665:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n666:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n667:   }\n668:   if (block !== null && block.complete === false) {\n669:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n670:   }\n671: \n672:   const oldSegmentation = oldText === null\n673:     ? { sections: [], block: null, prelude: null }\n674:     : segment(oldText, markers, manifest.sections);\n675:   const oldSections = oldSegmentation.sections;\n676:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n677:   const notes = [];\n678:   const chunks = [];\n679: \n680:   // (a) Whatever the block already held.\n681:   if (block !== null && block.complete) {\n682:     const body = blockBody(block.content, markers);\n683:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n684:   }\n685: \n686:   // Text above the first heading belongs to no section, and a replacement would drop it.\n687:   // The segmenter reports it apart from the sections because no heading covers it.\n688:   if (oldSegmentation.prelude !== null) {\n689:     const preamble = chunkText(oldSegmentation.prelude.text);\n690:     if (preamble !== '') {\n691:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n692:     }\n693:   }\n694: \n695:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n696:   // the first heading is already carried as the preamble, and its byte range would reach\n697:   // a block written above the template, so it is the one entry skipped here.\n698:   const unmarkedRow = rowOf(report, 'A8');\n699:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n700:   const unmarked = unmarkedRow.entries\n701:     .filter((entry) => entry.heading !== null)\n702:     .sort((left, right) => left.byte_start - right.byte_start);\n703:   for (const entry of unmarked) {\n704:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n705:     if (text === '') continue;\n706:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n707:   }\n708: \n709:   // (c) The local lines of a section somebody edited, each under its own id.\n710:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n711:   for (const entry of edited) {\n712:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n713:     if (!section) continue;\n714:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n715:     const lines = localLinesOf(section.body, shippedBody);\n716:     if (lines.length === 0) continue;\n717:     chunks.push({\n718:       kind: 'edited',\n719:       id: entry.id,\n720:       lines: lines.length,\n721:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n722:     });\n723: \n724:     // A clean merge would leave the section edited forever, so it is offered as a reading\n725:     // of the same bytes and never as the default.\n726:     const base = historyBodyOf(manifest, entry.base);\n727:     if (base !== null) {\n728:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n729:       if (merged.conflictKind === 'mergeable') {\n730:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n731:       }\n732:     }\n733:   }\n734: \n735:   // (d) The unique lines of a runtime copy that is folded away.\n736:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n737:   const removedCopies = [];\n738:   for (const copy of copies) {\n739:     const absolute = path.join(root, copy.path);\n740:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n741:     if (copy.state !== 'FINDING') continue;\n742:     const content = fs.readFileSync(absolute, 'utf8');\n743:     // With no root document every line of the copy is its own, and the count has to survive:\n744:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n745:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n746:     if (lines.length > 0) {\n747:       chunks.push({\n748:         kind: 'copy',\n749:         path: copy.path,\n750:         lines: lines.length,\n751:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n752:       });\n753:     }\n754:     removedCopies.push({ path: copy.path, content });\n755:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n756:       removedCopies.pop();\n757:       if (lines.length > 0) {\n758:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n759:       }\n760:     }\n761:   }\n762: \n763:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n764:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n765: \n766:   // The template with nothing of the repository's own in it gains nothing from the two\n767:   // marker lines, so that difference alone is not a reason to write: the markers appear\n768:   // with the first line worth keeping.\n769:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n770:   if (templateOnly) {\n771:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n772:   }\n773: \n774:   const files = [];\n775:   if (templateOnly || oldText === composed) {\n776:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n777:   } else {\n778:     files.push({\n779:       path: rootFile,\n780:       action: oldText === null ? 'create' : 'replace',\n781:       content: composed,\n782:       before: oldText,\n783:     });\n784:   }\n785: \n786:   // The router gains the shipped rows it is missing, or is created from them when asked.\n787:   const routerPath = path.join(root, manifest.router_file);\n788:   let routerAction = 'unchanged';\n789:   let routerText = null;\n790:   if (fs.existsSync(routerPath)) {\n791:     const current = fs.readFileSync(routerPath, 'utf8');\n792:     const result = addRouterRows(current, manifest);\n793:     notes.push(...result.notes);\n794:     if (result.text !== current) {\n795:       routerText = result.text;\n796:       routerAction = 'replace';\n797:       if (result.added.trigger > 0 || result.added.index > 0) {\n798:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n799:       }\n800:     }\n801:   } else if (createRouter) {\n802:     routerText = renderRouter(manifest);\n803:     routerAction = 'create';\n804:   } else {\n805:     routerAction = 'absent';\n806:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n807:   }\n808:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n809: \n810:   // The Cursor mirror exists exactly when the block carries something, because an empty\n811:   // block has nothing a runtime that cannot read past the prefix would miss.\n812:   const mirrorPath = path.join(root, MIRROR_FILE);\n813:   const mirrorExists = fs.existsSync(mirrorPath);\n814:   let mirrorAction = 'unchanged';\n815:   let mirrorText = null;\n816:   if (blockText !== '') {\n817:     mirrorText = renderMirror(markers, blockText);\n818:     if (!mirrorExists) mirrorAction = 'create';\n819:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n820:   } else if (mirrorExists) {\n821:     mirrorAction = 'remove';\n822:   }\n823:   if (mirrorAction !== 'unchanged') {\n824:     files.push({\n825:       path: MIRROR_FILE,\n826:       action: mirrorAction,\n827:       content: mirrorText,\n828:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n829:     });\n830:   }\n831: \n832:   for (const copy of removedCopies) {\n833:     if (copy.path === CLAUDE_POINTER_PATH) {\n834:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n835:       continue;\n836:     }\n837:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n838:   }\n839: \n840:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n841:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n842:   if (\n843:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n844:     && !fs.existsSync(claudePath)\n845:     && !isSymlink(claudePath)\n846:   ) {\n847:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n848:   }\n849: \n850:   const composition = {\n851:     root,\n852:     state: report.state,\n853:     report,\n854:     markers,\n855:     rootFile,\n856:     oldText,\n857:     composed,\n858:     block: { text: renderBlock(markers, blockText), body: blockText },\n859:     chunks,\n860:     removedCopies,\n861:     notes,\n862:     files,\n863:     budget: {\n864:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n865:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n866:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n867:     },\n868:     ledger: {\n869:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n870:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n871:       shippedReplaced: manifest.sections.length,\n872:       dropped: 0,\n873:     },\n874:   };\n875: \n876:   // What the run would put on disk, which is exactly the three actions a target can take.\n877:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n878:   return composition;\n879: }\n880: \n881: // ─────────────────────────────────────────────────────────────────────────────\n882: // 11. THE WRITE ALLOWLIST\n883: // ─────────────────────────────────────────────────────────────────────────────\n884: \n885: /**\n886:  * Resolve one path a run wants to touch, or refuse it.\n887:  *\n888:  * Containment is checked before membership, so a path that climbs out of the root is\n889:  * reported as what it is rather than as a missing allowlist entry.\n890:  *\n891:  * @param {string} root\n892:  * @param {string} relative\n893:  * @returns {string} the absolute path\n894:  */\n895: function assertWritable(root, relative) {\n896:   const base = path.resolve(root);\n897:   const normalized = String(relative).split(path.sep).join('/');\n898:   const absolute = path.resolve(base, normalized);\n899:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n900:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n901:   }\n902:   if (!ALLOWLIST.includes(normalized)) {\n903:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n904:   }\n905:   // Every path a run reaches must sit inside the root where the root really is, not only\n906:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n907:   const realBase = fs.realpathSync(base);\n908:   const realTarget = resolveThroughLinks(absolute);\n909:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n910:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n911:   }\n912:   return absolute;\n913: }\n914: \n915: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n916: // and the rest of the name is appended to it.\n917: function resolveThroughLinks(absolute) {\n918:   try {\n919:     return fs.realpathSync(absolute);\n920:   } catch {\n921:     const parent = path.dirname(absolute);\n922:     if (parent === absolute) return absolute;\n923:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n924:   }\n925: }\n926: \n927: // ─────────────────────────────────────────────────────────────────────────────\n928: // 12. BACKUPS\n929: // ─────────────────────────────────────────────────────────────────────────────\n930: \n931: function utcStamp(date = new Date()) {\n932:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n933: }\n934: \n935: /**\n936:  * The directory a plan's backup sits in, named after the plan digest.\n937:  *\n938:  * Named by the digest rather than by a clock reading because apply has to land exactly\n939:  * where the plan pointed and the digest is the only thing the operator carries across. The\n940:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n941:  * taken and moves to the next ordinal instead of writing beside it.\n942:  *\n943:  * @param {string} base\n944:  * @param {string} digest\n945:  * @returns {string}\n946:  */\n947: function backupDirectoryOf(base, digest) {\n948:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n949: }\n950: \n951: /**\n952:  * Where a run's backup goes, without creating anything.\n953:  *\n954:  * The output directory is used only when git ignores it, because a backup inside a tracked\n955:  * path is a backup the next commit publishes. Everything else leaves the repository.\n956:  *\n957:  * @param {{root: string}} input\n958:  * @returns {{dir: string, fallback: boolean, reason: string}}\n959:  */\n960: function backupBase({ root }) {\n961:   const candidate = path.join(root, BACKUP_DIR);\n962:   // The question is the one the run depends on: would a plan directory under this one be\n963:   // published by the next commit? Asking about the base alone would miss a rule written as\n964:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n965:   // the probe is a path of the same shape as the one the plan takes.\n966:   const probe = path.join(candidate, 'probe');\n967:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n968:     encoding: 'utf8',\n969:     timeout: TOOL_TIMEOUT_MS,\n970:   });\n971:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n972:   const reason = ignored.status === 1\n973:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n974:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n975:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n976: }\n977: \n978: /**\n979:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n980:  * that says both.\n981:  *\n982:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n983:  * suffixed into a second name, because the printed undo command would then point at that\n984:  * run's bytes; the next ordinal is a different plan with a different digest and a\n985:  * directory of its own.\n986:  *\n987:  * @param {Object} composition\n988:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n989:  */\n990: function planFor(composition) {\n991:   const base = backupBase({ root: composition.root });\n992:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n993:     const digest = planDigest(composition, { ordinal, base: base.dir });\n994:     const dir = backupDirectoryOf(base.dir, digest);\n995:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n996:   }\n997:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n998: }\n999: \n1000: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n1001: // only these, so on a record the run wrote, a folder that was there before the run is never\n1002: // taken away with it.\n1003: function missingParents(root, relative) {\n1004:   const missing = [];\n1005:   let dir = path.posix.dirname(relative);\n1006:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1007:     missing.push(dir);\n1008:     dir = path.posix.dirname(dir);\n1009:   }\n1010:   return missing;\n1011: }\n1012: \n1013: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1014: // entry's own allowlisted path; the list stops at the first one that is not.\n1015: function recordedCreatedDirs(entry) {\n1016:   const dirs = [];\n1017:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1018:   for (const dir of entry.createdDirs) {\n1019:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1020:     dirs.push(dir);\n1021:   }\n1022:   return dirs;\n1023: }\n1024: \n1025: // Runs after every file is back, because two new files can share one new folder. Only the\n1026: // folders above a file this restore just deleted are considered, and only an empty one is\n1027: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1028: // file the run created.\n1029: function removeCreatedDirs(root, entries, deleted) {\n1030:   const removed = [];\n1031:   for (const entry of entries) {\n1032:     if (!deleted.has(entry.path)) continue;\n1033:     for (const dir of recordedCreatedDirs(entry)) {\n1034:       const absolute = path.join(root, dir);\n1035:       let names;\n1036:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1037:       if (names.length > 0) break;\n1038:       fs.rmdirSync(absolute);\n1039:       removed.push(dir);\n1040:     }\n1041:   }\n1042:   return removed;\n1043: }\n1044: \n1045: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1046: // copy rather than a reconstruction.\n1047: function backupEntry(root, file) {\n1048:   const absolute = path.join(root, file.path);\n1049:   const exists = fs.existsSync(absolute);\n1050:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1051:   if (!exists) {\n1052:     entry.createdDirs = missingParents(root, file.path);\n1053:     return entry;\n1054:   }\n1055:   const stats = fs.lstatSync(absolute);\n1056:   entry.mode = stats.mode.toString(8).slice(-4);\n1057:   entry.symlink = stats.isSymbolicLink();\n1058:   const bytes = fs.readFileSync(absolute);\n1059:   entry.sha256 = sha256(bytes.toString('utf8'));\n1060:   entry.backup = path.posix.join('files', file.path);\n[Output truncated. Continue reading with offset: 1061]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794559619006,"end":1794559620614}}}}
{"type":"tool_use","timestamp":1794559620618,"sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","part":{"partID":"prt_1d416b192001ElvzuPDGzPTsqF","sessionID":"ses_e2be9abf0ffea6S3OJ4PZfZtpb","messageID":"msg_1d41680230018aEz5z6zNlJXEY","type":"tool","id":"call_33fee09afbff460986c25e85","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 1-1016\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The embed engine is the only part of this command that writes, and every line it\n8: // touches belongs to somebody else. Its value is therefore a property rather than an\n9: // output: what it showed is what it wrote, a backup exists before the first byte, and no\n10: // repository line survived only in the old file. This suite proves those properties\n11: // against synthetic repositories, and proves each failure path leaves the tree as it was.\n12: //\n13: // Every case runs on a tree composed for it from the manifest into a throwaway\n14: // directory, never on a committed document and never on this repository's own files. A\n15: // case that needs a real write path, a real router or a real copied rule corpus builds\n16: // it inside that directory, so the engine meets the same shapes it meets in a consumer\n17: // checkout without any of those shapes being committed here.\n18: //\n19: // The backup the engine leaves behind is the rollback, so the engine never deletes it.\n20: // These cases remove only the single run directory their own run created, and only after\n21: // proving it sits under the operating system's temporary directory.\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const { spawnSync } = require('node:child_process');\n29: const crypto = require('node:crypto');\n30: const fs = require('node:fs');\n31: const os = require('node:os');\n32: const path = require('node:path');\n33: const test = require('node:test');\n34: \n35: const embed = require('../agents-md-embed.cjs');\n36: const {\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   moveBlockBefore,\n42: } = require('./fixtures/agents-md/compose-fixture.cjs');\n43: \n44: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-embed.cjs');\n45: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n46: const SOURCE = fs.readFileSync(ENGINE, 'utf8');\n47: \n48: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 2. TREES, FILES AND DIGESTS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: // One composed tree per case, removed with the case. Composition reads the manifest, so\n55: // a case always describes the template that ships today.\n56: function composeTree(t, name) {\n57:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-embed-${name}-`));\n58:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n59:   const dir = path.join(parent, name);\n60:   composeFixture(name, dir);\n61:   return dir;\n62: }\n63: \n64: function listFiles(dir, prefix = '') {\n65:   const found = [];\n66:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n67:     const relative = prefix === '' ? entry.name : `${prefix}/${entry.name}`;\n68:     if (entry.isDirectory()) found.push(...listFiles(path.join(dir, entry.name), relative));\n69:     else found.push(relative);\n70:   }\n71:   return found.sort();\n72: }\n73: \n74: // Anything the engine leaves behind in a tree changes this number, which is what makes a\n75: // \"writes nothing\" claim checkable rather than promised.\n76: function treeDigest(dir) {\n77:   const hash = crypto.createHash('sha256');\n78:   for (const relative of listFiles(dir)) {\n79:     hash.update(relative);\n80:     hash.update('\\0');\n81:     hash.update(fs.readFileSync(path.join(dir, relative)));\n82:     hash.update('\\0');\n83:   }\n84:   return hash.digest('hex');\n85: }\n86: \n87: function readInside(dir, relative) {\n88:   return fs.readFileSync(path.join(dir, relative), 'utf8');\n89: }\n90: \n91: function existsInside(dir, relative) {\n92:   return fs.existsSync(path.join(dir, relative));\n93: }\n94: \n95: function writeInside(dir, relative, text) {\n96:   fs.writeFileSync(path.join(dir, relative), text, 'utf8');\n97: }\n98: \n99: function trimmedLines(text) {\n100:   return text.split('\\n').map((line) => line.trim()).filter((line) => line !== '' && line !== '---');\n101: }\n102: \n103: function occurrences(text, needle) {\n104:   let count = 0;\n105:   let at = text.indexOf(needle);\n106:   while (at !== -1) {\n107:     count += 1;\n108:     at = text.indexOf(needle, at + needle.length);\n109:   }\n110:   return count;\n111: }\n112: \n113: // The repository block of a composed document, with the markers stripped. The search runs\n114: // over lines, because a marker is the whole line: slicing between the first occurrences of\n115: // the two marker strings would cut a sentence that quotes them in half.\n116: function blockIn(text) {\n117:   const lines = text.split('\\n');\n118:   const from = lines.findIndex((line) => line.trim() === manifest.markers.start.trim());\n119:   const to = lines.findIndex((line) => line.trim() === manifest.markers.end.trim());\n120:   assert.ok(from !== -1 && to > from, 'the composed document carries one well-formed block');\n121:   return lines.slice(from + 1, to).join('\\n');\n122: }\n123: \n124: // A marker is the whole line, so a case counts whole lines: a sentence that quotes the\n125: // marker's bytes is prose, and counting substrings would read it as a second block.\n126: function markerLinesOf(text, marker) {\n127:   return text.split('\\n').filter((line) => line.trim() === marker.trim()).length;\n128: }\n129: \n130: // A line typed inside a shipped section is what makes that section an edit, and the way a\n131: // person plants one is ahead of the divider that closes the section.\n132: function insertInsideSection(text, id, line) {\n133:   const body = manifest.derived.sections[id].body;\n134:   const at = text.indexOf(body);\n135:   assert.ok(at !== -1, `the composed document carries the shipped body of ${id}`);\n136:   const divider = body.lastIndexOf('\\n---\\n');\n137:   const edited = divider === -1\n138:     ? `${body}${line}\\n`\n139:     : `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n140:   return `${text.slice(0, at)}${edited}${text.slice(at + body.length)}`;\n141: }\n142: \n143: // The engine prints one field per line, so a case reads the plan the way an operator\n144: // does instead of reaching into the engine's internals.\n145: function field(text, name) {\n146:   const match = new RegExp(`^${name}: (.*)$`, 'mu').exec(text);\n147:   return match === null ? null : match[1].trim();\n148: }\n149: \n150: function targetsOf(out) {\n151:   const targets = [];\n152:   for (const line of out.split('\\n')) {\n153:     const hit = /^target (\\S+): (create|replace|remove|unchanged)$/.exec(line);\n154:     if (hit !== null) targets.push({ path: hit[1], action: hit[2] });\n155:   }\n156:   return targets;\n157: }\n158: \n159: // ─────────────────────────────────────────────────────────────────────────────\n160: // 3. RUNNERS\n161: // ─────────────────────────────────────────────────────────────────────────────\n162: \n163: function run(args, options = {}) {\n164:   const result = spawnSync(process.execPath, [ENGINE, ...args], {\n165:     encoding: 'utf8',\n166:     input: options.input === undefined ? '' : options.input,\n167:   });\n168:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n169: }\n170: \n171: function plan(dir, extra = []) {\n172:   return run(['plan', '--root', dir, ...extra]);\n173: }\n174: \n175: function apply(dir, digest, extra = []) {\n176:   return run(['apply', '--root', dir, '--plan-digest', digest, ...extra]);\n177: }\n178: \n179: // A plan followed by the apply it authorises, which is the only supported write path.\n180: function planAndApply(dir, extra = []) {\n181:   const planned = plan(dir, extra);\n182:   assert.equal(planned.code, 0, `plan exits 0\\n${planned.err}`);\n183:   const digest = field(planned.out, 'plan-digest');\n184:   assert.match(digest || '', /^[0-9a-f]{64}$/u, 'the plan prints a sha256 digest');\n185:   const applied = apply(dir, digest, extra);\n186:   return { planned, applied, digest };\n187: }\n188: \n189: // The engine never deletes a backup, so the case does: exactly one directory, and only\n190: // when it sits under the temporary directory this run created it in.\n191: function trackBackup(t, text) {\n192:   const dir = field(text, 'backup');\n193:   if (dir === null) return null;\n194:   t.after(() => {\n195:     const temporary = os.tmpdir();\n196:     if (!dir.startsWith(temporary + path.sep)) return;\n197:     fs.rmSync(dir, { recursive: true, force: true });\n198:   });\n199:   return dir;\n200: }\n201: \n202: // ─────────────────────────────────────────────────────────────────────────────\n203: // 4. SCRIPTED WRITES THE ENGINE NEVER MAKES\n204: // ─────────────────────────────────────────────────────────────────────────────\n205: \n206: // A spy rather than a promise: the plan's own composition and report run inside this\n207: // window, so any write path the engine gained would be recorded here.\n208: function spyOnWrites(record) {\n209:   const names = ['writeFileSync', 'appendFileSync', 'mkdirSync', 'mkdtempSync', 'copyFileSync', 'rmSync', 'unlinkSync', 'renameSync', 'rmdirSync'];\n210:   const originals = new Map(names.map((name) => [name, fs[name]]));\n211:   for (const name of names) {\n212:     fs[name] = (...args) => {\n213:       record.push({ name, first: String(args[0]) });\n214:       return originals.get(name).apply(fs, args);\n215:     };\n216:   }\n217:   return () => {\n218:     for (const [name, original] of originals) fs[name] = original;\n219:   };\n220: }\n221: \n222: // ─────────────────────────────────────────────────────────────────────────────\n223: // 5. A REPOSITORY THAT CARRIES THE SHIPPED RULE CORPUS\n224: // ─────────────────────────────────────────────────────────────────────────────\n225: \n226: // The shipped rows point into `.skilled/repo-rules`, which arrives with the install. A\n227: // synthetic repository therefore needs that corpus for its router to be checkable at all,\n228: // so the case copies the installed rule files in rather than inventing rows for them. The\n229: // references those rules link to travel with the install too, so each one is resolved and\n230: // copied to the same relative path.\n231: function seedRuleCorpus(dir) {\n232:   const from = path.join(REPO_ROOT, '.skilled/repo-rules');\n233:   const to = path.join(dir, '.skilled/repo-rules');\n234:   fs.mkdirSync(to, { recursive: true });\n235:   const copied = [];\n236:   for (const name of fs.readdirSync(from)) {\n237:     if (!name.endsWith('.md')) continue;\n238:     fs.copyFileSync(path.join(from, name), path.join(to, name));\n239:     copied.push(name);\n240:   }\n241:   for (const name of copied) {\n242:     const text = fs.readFileSync(path.join(to, name), 'utf8');\n243:     for (const match of text.matchAll(/\\]\\(([^)\\s]+)\\)/gu)) {\n244:       const target = match[1].split('#')[0];\n245:       if (target === '' || /^[a-z][a-z0-9+.-]*:/iu.test(target)) continue;\n246:       const relative = path.posix.normalize(path.posix.join('.skilled/repo-rules', target));\n247:       if (fs.existsSync(path.join(dir, relative))) continue;\n248:       const source = path.join(REPO_ROOT, relative);\n249:       if (!fs.existsSync(source)) continue;\n250:       fs.mkdirSync(path.dirname(path.join(dir, relative)), { recursive: true });\n251:       fs.copyFileSync(source, path.join(dir, relative));\n252:     }\n253:   }\n254: }\n255: \n256: function shippedRows() {\n257:   return manifest.derived.repo_rules;\n258: }\n259: \n260: function renderRows(rows) {\n261:   return rows.map((cells) => `| ${cells.join(' | ')} |`).join('\\n');\n262: }\n263: \n264: // A router that carries only the first few shipped rows, which is the shape a repository\n265: // is left in when an install replaced the rules but not the router.\n266: function partialRouter(count) {\n267:   const { trigger_rows: trigger, index_rows: index } = shippedRows();\n268:   return [\n269:     '# REPO RULES',\n270:     '',\n271:     'Repo-local operating rules. This document routes you to the rule files.',\n272:     '',\n273:     '---',\n274:     '',\n275:     '## 2. TRIGGER TABLE',\n276:     '',\n277:     '| You are about to… | Load | It settles |',\n278:     '|-------------------|------|-----------|',\n279:     renderRows(trigger.slice(0, count)),\n280:     '',\n281:     '---',\n282:     '',\n283:     '## 3. INDEX',\n284:     '',\n285:     '| Rule | Summary |',\n286:     '|------|---------|',\n287:     renderRows(index.slice(0, count)),\n288:     '',\n289:     '---',\n290:     '',\n291:   ].join('\\n');\n292: }\n293: \n294: function tableRows(text, anchor) {\n295:   const lines = text.split('\\n');\n296:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n297:   assert.ok(start !== -1, `the router carries a ${anchor} table`);\n298:   const rows = [];\n299:   for (let index = start + 1; index < lines.length; index += 1) {\n300:     const line = lines[index].trim();\n301:     if (line.startsWith('#')) break;\n302:     if (line === '') {\n303:       if (rows.length > 0) break;\n304:       continue;\n305:     }\n306:     if (!line.startsWith('|')) continue;\n307:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) continue;\n308:     rows.push(line);\n309:   }\n310:   return rows.slice(1);\n311: }\n312: \n313: function runRepoRulesChecker(dir) {\n314:   const result = spawnSync(process.execPath, [REPO_RULES_CHECKER, '--root', dir], { encoding: 'utf8' });\n315:   return {\n316:     code: result.status,\n317:     out: `${result.stdout || ''}\\n${result.stderr || ''}`,\n318:   };\n319: }\n320: \n321: // ─────────────────────────────────────────────────────────────────────────────\n322: // 6. THE PLAN WRITES NOTHING\n323: // ─────────────────────────────────────────────────────────────────────────────\n324: \n325: test('a plan run records zero writes', (t) => {\n326:   const dir = composeTree(t, 'forked');\n327:   const before = treeDigest(dir);\n328: \n329:   const planned = plan(dir);\n330:   assert.equal(planned.code, 0, planned.err);\n331:   assert.equal(treeDigest(dir), before, 'a plan leaves the tree byte for byte');\n332:   assert.match(planned.out, /plan-digest: [0-9a-f]{64}/u);\n333: \n334:   // The plan names where the backup will go, so the location is reviewable, and the\n335:   // names a write path it did not take.\n336:   const backup = field(planned.out, 'backup');\n337:   assert.ok(backup, 'the plan prints the backup location');\n338:   assert.equal(fs.existsSync(backup), false, 'the plan creates no backup directory');\n339: \n340:   const writes = [];\n341:   const restore = spyOnWrites(writes);\n342:   let code;\n343:   try {\n344:     code = embed.main(['plan', '--root', dir], { log: () => {}, warn: () => {} });\n345:   } finally {\n346:     restore();\n347:   }\n348:   assert.equal(code, 0);\n349:   assert.deepEqual(writes, [], 'no write reached the filesystem during a plan');\n350:   assert.equal(treeDigest(dir), before, 'the tree is unchanged after the spy window');\n351: });\n352: \n353: // ─────────────────────────────────────────────────────────────────────────────\n354: // 7. APPLY IS GATED BY THE DIGEST\n355: // ─────────────────────────────────────────────────────────────────────────────\n356: \n357: test('apply without a plan digest exits 2 and writes nothing', (t) => {\n358:   const dir = composeTree(t, 'forked');\n359:   const before = treeDigest(dir);\n360: \n361:   const refused = run(['apply', '--root', dir]);\n362:   assert.equal(refused.code, 2, refused.out);\n363:   assert.match(refused.err, /plan-digest/u);\n364:   assert.equal(treeDigest(dir), before);\n365: });\n366: \n367: test('apply refuses a digest that the tree no longer produces', (t) => {\n368:   const dir = composeTree(t, 'forked');\n369:   const planned = plan(dir);\n370:   const digest = field(planned.out, 'plan-digest');\n371: \n372:   // The operator edits between the plan and the yes, so the shown bytes are stale.\n373:   fs.appendFileSync(path.join(dir, 'AGENTS.md'), '\\nOne more line typed after the plan.\\n');\n374:   const before = treeDigest(dir);\n375: \n376:   const refused = apply(dir, digest);\n377:   assert.equal(refused.code, 2, refused.out);\n378:   assert.match(refused.err, /digest/u);\n379:   assert.equal(treeDigest(dir), before, 'a refused apply writes nothing');\n380: });\n381: \n382: // ─────────────────────────────────────────────────────────────────────────────\n383: // 8. THE PRESERVATION INVARIANT\n384: // ─────────────────────────────────────────────────────────────────────────────\n385: \n386: test('preservationCheck reports each part of the invariant', () => {\n387:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n388:   const compose = (body) => {\n389:     const block = `${manifest.markers.start}\\n${manifest.markers.heading}\\n\\n${manifest.markers.note}\\n${body === '' ? '' : `${body}\\n`}${manifest.markers.end}\\n`;\n390:     return `${shipped}${block}`;\n391:   };\n392: \n393:   const clean = embed.preservationCheck(compose('One kept line.'), compose('One kept line.'), manifest);\n394:   assert.deepEqual(clean.dropped, []);\n395:   assert.deepEqual(clean.foreign, []);\n396: \n397:   // Part one: lines from outside every shipped section left the document.\n398:   const unmarked = `# Our own notes\\n\\nKeep this sentence.\\n`;\n399:   const partOne = embed.preservationCheck(compose(unmarked), compose(''), manifest);\n400:   assert.deepEqual(partOne.dropped.map((entry) => entry.line), ['# Our own notes', 'Keep this sentence.']);\n401:   assert.deepEqual(partOne.dropped.map((entry) => entry.part), [1, 1]);\n402: \n403:   // Part two: a line typed inside a shipped section, which no shipped body carries.\n404:   const sectionId = 's6-spec-folder';\n405:   const edited = manifest.derived.sections[sectionId].body.replace('\\n---\\n', '\\nA local tightening.\\n\\n---\\n');\n406:   const oldTwo = shipped.replace(manifest.derived.sections[sectionId].body, edited);\n407:   const partTwo = embed.preservationCheck(oldTwo, compose(''), manifest);\n408:   assert.equal(partTwo.dropped.length, 1);\n409:   assert.equal(partTwo.dropped[0].part, 2);\n410:   assert.equal(partTwo.dropped[0].line, 'A local tightening.');\n411: \n412:   // Part three: a line that only a removed copy carried.\n413:   const partThree = embed.preservationCheck(compose(''), compose(''), manifest, {\n414:     removed: [{ path: 'CLAUDE.md', content: '# Notes\\n\\nRun the checks first.\\n' }],\n415:   });\n416:   assert.deepEqual(partThree.dropped.map((entry) => entry.line), ['# Notes', 'Run the checks first.']);\n417: \n418:   // Part four: a line outside the block that the shipped template does not carry.\n419:   const foreign = embed.preservationCheck(compose(''), `A line above the block.\\n${compose('')}`, manifest);\n420:   assert.deepEqual(foreign.foreign.map((entry) => entry.line), ['A line above the block.']);\n421: });\n422: \n423: // ─────────────────────────────────────────────────────────────────────────────\n424: // 9. THE FOREIGN AND FORKED SHAPES\n425: // ─────────────────────────────────────────────────────────────────────────────\n426: \n427: test('the foreign shape keeps its whole original document inside the block', (t) => {\n428:   const dir = composeTree(t, 'foreign');\n429:   const original = readInside(dir, manifest.root_file);\n430: \n431:   const { planned, applied } = planAndApply(dir);\n432:   trackBackup(t, applied.out);\n433:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n434:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n435:   assert.match(applied.out, /STATUS=OK/u);\n436: \n437:   const composed = readInside(dir, manifest.root_file);\n438:   assert.ok(composed.startsWith(manifest.derived.sections.title.body), 'the shipped template arrives first');\n439:   const block = blockIn(composed);\n440:   assert.ok(block.includes(original.trim()), 'the original file sits inside the block verbatim');\n441:   for (const line of trimmedLines(original)) {\n442:     assert.equal(occurrences(block, line), occurrences(original, line), `${line} survives once per occurrence`);\n443:   }\n444: \n445:   // Part four, measured on the bytes that reached the disk rather than on the claim.\n446:   const checked = embed.preservationCheck(original, composed, manifest);\n447:   assert.deepEqual(checked.dropped, []);\n448:   assert.deepEqual(checked.foreign, []);\n449:   assert.match(planned.out, /BUDGET|budget: /u);\n450: });\n451: \n452: test('the forked shape carries its unmarked section before its edited section', (t) => {\n453:   const dir = composeTree(t, 'forked');\n454:   const original = readInside(dir, manifest.root_file);\n455:   const localLine = 'Local rule: name the packet in the first line of every pull request.';\n456: \n457:   const applied = planAndApply(dir).applied;\n458:   trackBackup(t, applied.out);\n459:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n460:   assert.match(applied.out, /preservation: kept \\d+, carried 0, shipped-replaced 44, dropped 0/u);\n461: \n462:   const composed = readInside(dir, manifest.root_file);\n463:   const block = blockIn(composed);\n464:   const unmarkedAt = block.indexOf('## Local release checklist');\n465:   const editedAt = block.indexOf('### Carried from s6-spec-folder');\n466:   assert.ok(unmarkedAt !== -1, 'the unmarked section is carried');\n467:   assert.ok(editedAt !== -1, 'the edited section is carried under its id');\n468:   assert.ok(unmarkedAt < editedAt, 'unmarked sections come before edited sections');\n469:   assert.equal(occurrences(composed, localLine), 1, 'the local line moved rather than duplicated');\n470:   assert.equal(occurrences(composed, 'Run `make verify` and post the result in the release channel before tagging.'), 1);\n471: \n472:   const checked = embed.preservationCheck(original, composed, manifest);\n473:   assert.deepEqual(checked.dropped, []);\n474:   assert.deepEqual(checked.foreign, []);\n475: });\n476: \n477: test('a released body is replaced with no carry', (t) => {\n478:   const dir = composeTree(t, 'stale');\n479:   const applied = planAndApply(dir).applied;\n480:   trackBackup(t, applied.out);\n481:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n482: \n483:   const composed = readInside(dir, manifest.root_file);\n484:   const current = manifest.derived.sections['operational-mandates'].body;\n485:   assert.ok(composed.includes(current), 'the current body replaced the released one');\n486:   assert.ok(!composed.includes('### Carried from operational-mandates'), 'nothing is carried from a released body');\n487: });\n488: \n489: // A block is the repository's block wherever it sits. Left above the point a rewrite cuts, its\n490: // content is the first thing a replacement loses, and every shipped section below it is\n491: // invisible, so the rewrite would duplicate them into the block instead of recognising them.\n492: test('a block placed between shipped sections is carried into the block at the end', (t) => {\n493:   const dir = composeTree(t, 'adopted');\n494:   const original = moveBlockBefore(readInside(dir, manifest.root_file), '#### The Four Laws');\n495:   writeInside(dir, manifest.root_file, original);\n496:   const carried = 'Our stack is Node 20 with no web framework.';\n497: \n498:   const applied = planAndApply(dir).applied;\n499:   trackBackup(t, applied.out);\n500:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n501:   assert.match(applied.out, /\\(state: adopted\\)/u, 'the sections below the block are recognised as the template\\'s');\n502:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n503: \n504:   const composed = readInside(dir, manifest.root_file);\n505:   assert.equal(occurrences(composed, manifest.markers.start), 1, 'exactly one block survives');\n506:   const block = blockIn(composed);\n507:   assert.equal(occurrences(block, carried), 1, 'the block content moved into the one block at the end');\n508:   assert.equal(occurrences(composed, carried), 1, 'it is not also left where it was');\n509:   for (const id of ['four-laws', 's2-mandatory-gates', 'operational-mandates']) {\n510:     assert.equal(occurrences(composed, manifest.derived.sections[id].body), 1, `the shipped body ${id} appears once, below the block`);\n511:   }\n512: \n513:   const checked = embed.preservationCheck(original, composed, manifest);\n514:   assert.deepEqual(checked.dropped, []);\n515:   assert.deepEqual(checked.foreign, []);\n516: });\n517: \n518: // The end marker is not the end of the file. A line typed below it is the repository's own,\n519: // and a rewrite that keeps only the block and the shipped sections drops it silently.\n520: test('a line after the end marker is carried into the block', (t) => {\n521:   const dir = composeTree(t, 'adopted');\n522:   const line = 'Ship the release note in the same commit as the tag.';\n523:   const original = `${readInside(dir, manifest.root_file)}${line}\\n`;\n524:   writeInside(dir, manifest.root_file, original);\n525: \n526:   const applied = planAndApply(dir).applied;\n527:   trackBackup(t, applied.out);\n528:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n529:   assert.match(applied.out, /dropped 0/u);\n530: \n531:   const composed = readInside(dir, manifest.root_file);\n532:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n533:   assert.equal(occurrences(composed, line), 1, 'it is not also left below the block');\n534: \n535:   const checked = embed.preservationCheck(original, composed, manifest);\n536:   assert.deepEqual(checked.dropped, []);\n537:   assert.deepEqual(checked.foreign, []);\n538: });\n539: \n540: // Text above the first heading belongs to no section, so nothing but the block can keep it.\n541: // Carried nowhere, it is gone at the first rewrite while the document still reads as pure.\n542: test('text before the first heading is carried into the block', (t) => {\n543:   const dir = composeTree(t, 'pure');\n544:   const line = 'Read me first.';\n545:   const original = `${line}\\n${readInside(dir, manifest.root_file)}`;\n546:   writeInside(dir, manifest.root_file, original);\n547: \n548:   const applied = planAndApply(dir).applied;\n549:   trackBackup(t, applied.out);\n550:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n551:   assert.match(applied.out, /\\(state: forked\\)/u, 'the text above the template is repository content, not a pure template');\n552:   assert.match(applied.out, /dropped 0/u);\n553: \n554:   const composed = readInside(dir, manifest.root_file);\n555:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n556:   assert.equal(occurrences(composed, line), 1, 'it is not also left above the template');\n557: \n558:   const checked = embed.preservationCheck(original, composed, manifest);\n559:   assert.deepEqual(checked.dropped, []);\n560:   assert.deepEqual(checked.foreign, []);\n561: \n562:   // The proof has to miss it too, or the next composition that drops the prelude ends in\n563:   // the same silence: the line is gone and nothing was named.\n564:   const lost = embed.preservationCheck(original, composed.replace(`${line}\\n`, ''), manifest);\n565:   assert.ok(lost.dropped.some((entry) => entry.line === line), `the proof counts the text above the template as repository content: ${JSON.stringify(lost.dropped)}`);\n566: });\n567: \n568: // ─────────────────────────────────────────────────────────────────────────────\n569: // 10. THE PROOF, AND WHAT HAPPENS WHEN IT FAILS\n570: // ─────────────────────────────────────────────────────────────────────────────\n571: \n572: // The seam stands in for a writer that loses a line: the composition is intact, the\n573: // digest matches, and the bytes that reach the disk are one line short. Only the\n574: // post-write proof can catch that, which is exactly what it exists for.\n575: function dropALineOnWrite(captured) {\n576:   return (file, content) => {\n577:     const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n578:     const text = bytes.toString('utf8');\n579:     const written = file.endsWith(manifest.root_file)\n580:       ? text.replace('- Never commit a generated file.\\n', '')\n581:       : text;\n582:     captured.push({ file, dropped: written !== text });\n583:     fs.writeFileSync(file, written, 'utf8');\n584:   };\n585: }\n586: \n587: test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:   const dir = composeTree(t, 'foreign');\n589:   const original = readInside(dir, manifest.root_file);\n590:   const out = [];\n591:   const written = [];\n592:   const hooks = {\n593:     log: (line) => out.push(line),\n594:     warn: (line) => out.push(line),\n595:     write: dropALineOnWrite(written),\n596:   };\n597: \n598:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n599:   const digest = field(out.join('\\n'), 'plan-digest');\n600:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n601:   out.length = 0;\n602: \n603:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n604:   const text = out.join('\\n');\n605:   trackBackup(t, text);\n606: \n607:   assert.equal(code, 1, 'a drop is a failed run');\n608:   assert.ok(written.some((entry) => entry.dropped), 'the seam lost a line on the way to the disk');\n609:   assert.match(text, /STATUS=FAIL/u);\n610:   assert.match(text, /- Never commit a generated file\\./u, 'the dropped line is printed');\n611:   assert.match(text, /restored/u);\n612:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n613: });\n614: \n615: // A line the write leaves outside the block, one no shipped section carries, is a byte the\n616: // template never put there. The proof has to read it as a violation and undo the run,\n617: // because a document that keeps it says the write changed something the plan never showed.\n618: test('a planted foreign line restores the backup and ends STATUS=FAIL', (t) => {\n619:   const dir = composeTree(t, 'foreign');\n620:   const original = readInside(dir, manifest.root_file);\n621:   const planted = 'A line no template ships.';\n622:   const out = [];\n623:   const hooks = {\n624:     log: (line) => out.push(line),\n625:     warn: (line) => out.push(line),\n626:     write: (file, content) => {\n627:       const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n628:       const text = bytes.toString('utf8');\n629:       const written = file.endsWith(manifest.root_file) ? `${planted}\\n${text}` : text;\n630:       fs.writeFileSync(file, written, 'utf8');\n631:     },\n632:   };\n633: \n634:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n635:   const planned = out.join('\\n');\n636:   const backup = field(planned, 'backup');\n637:   assert.ok(backup, 'the plan prints the backup location');\n638:   trackBackup(t, planned);\n639:   const digest = field(planned, 'plan-digest');\n640:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n641:   out.length = 0;\n642: \n643:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n644:   const text = out.join('\\n');\n645: \n646:   assert.equal(code, 1, `a foreign line is a failed run\\n${text}`);\n647:   assert.match(text, /^foreign: A line no template ships\\. \\(outside the block and not a shipped line\\)$/mu);\n648:   assert.match(text, /STATUS=FAIL/u);\n649:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n650: });\n651: \n652: // A backup that no longer matches the hash the run recorded is the one thing a restore must\n653: // refuse: copying it over the tree would replace the fault it exists to undo with a worse\n654: // one. The write hook damages the copy first, so the post-write proof has to stop before\n655: // the first file goes back and leave the tree as the failed write left it.\n656: test('a damaged backup copy stops the restore and leaves the tree as the write left it', (t) => {\n657:   const dir = composeTree(t, 'foreign');\n658:   const damaged = 'a backup copy the run did not record\\n';\n659:   const out = [];\n660:   let backup = null;\n661:   let first = true;\n662:   const hooks = {\n663:     log: (line) => out.push(line),\n664:     warn: (line) => out.push(line),\n665:     write: (file, content) => {\n666:       if (first) {\n667:         first = false;\n668:         fs.writeFileSync(path.join(backup, 'files', manifest.root_file), damaged, 'utf8');\n669:       }\n670:       const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n671:       const text = bytes.toString('utf8');\n672:       const written = file.endsWith(manifest.root_file)\n673:         ? text.replace('- Never commit a generated file.\\n', '')\n674:         : text;\n675:       fs.writeFileSync(file, written, 'utf8');\n676:     },\n677:   };\n678: \n679:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n680:   const planned = out.join('\\n');\n681:   backup = field(planned, 'backup');\n682:   assert.ok(backup, 'the plan prints the backup location');\n683:   trackBackup(t, planned);\n684:   const digest = field(planned, 'plan-digest');\n685:   out.length = 0;\n686: \n687:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n688:   const text = out.join('\\n');\n689: \n690:   assert.equal(code, 1, 'a failed restore is still a failed run');\n691:   assert.ok(\n692:     text.includes(`ERROR: the backup copy of ${manifest.root_file} does not match its recorded hash, so nothing was restored. The backup is kept at ${backup}`),\n693:     `the mismatch is named with the backup it kept\\n${text}`,\n694:   );\n695:   assert.match(text, /the write dropped 1 line\\(s\\) and the backup could not be restored, so the tree is as the write left it/u);\n696:   assert.ok(!readInside(dir, manifest.root_file).includes(damaged.trim()), 'the damaged backup copy was not written over the tree');\n697: });\n698: \n699: // A writer that throws partway through is neither a run that wrote nothing nor one that\n700: // finished: the targets before it already hold bytes, and the failed target may hold a\n701: // partial one. The backup exists by then, so the only ending that keeps the tree truthful\n702: // is to put it back, name the backup, and report the failure on an exit of its own.\n703: test('a write that throws mid-apply restores the backup and exits 3', (t) => {\n704:   const dir = composeTree(t, 'claude-only');\n705:   const before = treeDigest(dir);\n706:   const out = [];\n707:   let calls = 0;\n708:   const hooks = {\n709:     log: (line) => out.push(line),\n710:     warn: (line) => out.push(line),\n711:     write: (file, content) => {\n712:       calls += 1;\n713:       if (calls === 2) {\n714:         const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n715:         error.code = 'EACCES';\n716:         throw error;\n717:       }\n718:       fs.writeFileSync(file, content, 'utf8');\n719:     },\n720:   };\n721: \n722:   assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n723:   const digest = field(out.join('\\n'), 'plan-digest');\n724:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n725:   out.length = 0;\n726: \n727:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n728:   const text = out.join('\\n');\n729:   trackBackup(t, text);\n730: \n731:   assert.equal(calls, 2, 'the second write is the one that throws');\n732:   assert.equal(code, 3, `a write that throws after the backup is undone\\n${text}`);\n733:   assert.match(text, /EACCES/u, 'the failure names the write it could not make');\n734:   assert.match(text, /restored:/u);\n735:   assert.match(text, /^backup:/mu);\n736:   assert.match(text, /^undo:/mu);\n737:   assert.match(text, /STATUS=FAIL/u);\n738:   assert.equal(treeDigest(dir), before, 'the tree is byte for byte what it was before the apply');\n739: });\n740: \n741: test('restore puts every recorded file back byte for byte', (t) => {\n742:   const dir = composeTree(t, 'foreign');\n743:   const before = treeDigest(dir);\n744: \n745:   const applied = planAndApply(dir).applied;\n746:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n747:   const backup = trackBackup(t, applied.out);\n748:   assert.ok(fs.existsSync(backup), 'the backup exists after the run');\n749:   assert.ok(treeDigest(dir) !== before, 'the run changed the tree');\n750: \n751:   const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n752:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n753:   assert.match(restored.out, /restore: /u);\n754:   assert.equal(treeDigest(dir), before, 'every recorded file is byte-identical to its backup');\n755:   assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n756: });\n757: \n758: test('restore recreates a removed file and deletes a file the run created', (t) => {\n759:   const dir = composeTree(t, 'claude-only');\n760:   const claude = readInside(dir, 'CLAUDE.md');\n761:   const applied = planAndApply(dir).applied;\n762:   const backup = trackBackup(t, applied.out);\n763:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n764:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n', 'the folded copy became a pointer');\n765:   assert.equal(existsInside(dir, manifest.root_file), true, 'the root document was created');\n766: \n767:   const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n768:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n769:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n770:   assert.equal(existsInside(dir, manifest.root_file), false, 'the created file is removed again');\n771: });\n772: \n773: test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n774:   const fresh = composeTree(t, 'claude-only');\n775:   const freshApplied = planAndApply(fresh).applied;\n776:   assert.equal(freshApplied.code, 0, `${freshApplied.err}${freshApplied.out}`);\n777:   const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n778:   assert.equal(freshRestored.code, 0, `${freshRestored.err}${freshRestored.out}`);\n779:   assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n780: \n781:   const kept = composeTree(t, 'claude-only');\n782:   fs.mkdirSync(path.join(kept, '.cursor'));\n783:   const keptApplied = planAndApply(kept).applied;\n784:   assert.equal(keptApplied.code, 0, `${keptApplied.err}${keptApplied.out}`);\n785:   const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n786:   assert.equal(keptRestored.code, 0, `${keptRestored.err}${keptRestored.out}`);\n787:   assert.equal(existsInside(kept, '.cursor'), true, 'an empty folder that predates the run stays');\n788:   assert.equal(existsInside(kept, '.cursor/rules'), false, 'the folder the run made inside it is gone');\n789: });\n790: \n791: test('restore refuses a record whose root is not the one it runs against', (t) => {\n792:   const dir = composeTree(t, 'foreign');\n793:   const applied = planAndApply(dir).applied;\n794:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n795:   const backup = trackBackup(t, applied.out);\n796:   assert.match(field(applied.out, 'undo'), new RegExp(`--root ${dir.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&')}$`, 'u'), 'the printed undo names the root it needs');\n797: \n798:   const other = composeTree(t, 'foreign');\n799:   const before = treeDigest(other);\n800:   const recordPath = path.join(backup, 'manifest.json');\n801:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n802:   fs.writeFileSync(recordPath, JSON.stringify({ ...record, root: other }));\n803: \n804:   const repointed = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n805:   assert.equal(repointed.code, 2, 'a record naming another root is refused');\n806:   assert.match(repointed.err + repointed.out, /names the root/u);\n807:   assert.equal(treeDigest(other), before, 'the folder the record was repointed at is untouched');\n808: \n809:   fs.writeFileSync(recordPath, JSON.stringify(record));\n810:   const unnamed = run(['restore', `--run=${backup}`], { input: 'yes\\n' });\n811:   assert.equal(unnamed.code, 2, 'a restore of another root without --root is refused');\n812: });\n813: \n814: test('restore cancels without a yes', (t) => {\n815:   const dir = composeTree(t, 'foreign');\n816:   const applied = planAndApply(dir).applied;\n817:   const backup = trackBackup(t, applied.out);\n818:   const afterApply = treeDigest(dir);\n819: \n820:   const cancelled = run(['restore', `--run=${backup}`, '--root', dir], { input: 'no\\n' });\n821:   assert.equal(cancelled.code, 1, 'a cancelled restore is not a completed one');\n822:   assert.match(cancelled.out, /cancelled/u);\n823:   assert.equal(treeDigest(dir), afterApply, 'a cancelled restore writes nothing');\n824: });\n825: \n826: // ─────────────────────────────────────────────────────────────────────────────\n827: // 11. IDEMPOTENCE\n828: // ─────────────────────────────────────────────────────────────────────────────\n829: \n830: test('a second run prints NOTHING TO DO', (t) => {\n831:   const dir = composeTree(t, 'foreign');\n832:   const first = planAndApply(dir);\n833:   trackBackup(t, first.applied.out);\n834:   assert.equal(first.applied.code, 0, `${first.applied.err}${first.applied.out}`);\n835:   const afterApply = treeDigest(dir);\n836: \n837:   const second = plan(dir);\n838:   assert.equal(second.code, 0, second.err);\n839:   assert.match(second.out, /NOTHING TO DO/u);\n840:   assert.equal(treeDigest(dir), afterApply);\n841: \n842:   // The writing target gives the same answer: a digest from the first plan names a\n843:   // composition that no longer differs from the tree, so there is nothing to authorise.\n844:   const again = run(['apply', '--root', dir, '--plan-digest', first.digest]);\n845:   assert.equal(again.code, 0, again.err);\n846:   assert.match(again.out, /NOTHING TO DO/u);\n847:   assert.equal(treeDigest(dir), afterApply);\n848: });\n849: \n850: test('a plan on the source repository prints NOTHING TO DO', () => {\n851:   const planned = plan(REPO_ROOT);\n852:   assert.equal(planned.code, 0, planned.err);\n853:   assert.match(planned.out, /NOTHING TO DO/u);\n854: });\n855: \n856: // ─────────────────────────────────────────────────────────────────────────────\n857: // 12. THE WRITE ALLOWLIST\n858: // ─────────────────────────────────────────────────────────────────────────────\n859: \n860: test('every written path is inside the allowlist and a path outside it is refused', (t) => {\n861:   const dir = composeTree(t, 'adopted');\n862:   // A second copy of the shipped rules, so the router's rows resolve and the run has a\n863:   // mirror and a removal to perform as well as the root document.\n864:   seedRuleCorpus(dir);\n865:   fs.writeFileSync(path.join(dir, manifest.router_file), partialRouter(3), 'utf8');\n866: \n867:   const { planned, applied } = planAndApply(dir);\n868:   trackBackup(t, applied.out);\n869:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n870: \n871:   const written = targetsOf(planned.out).filter((entry) => entry.action !== 'unchanged');\n872:   assert.ok(written.length > 0, 'the plan names what it will write');\n873:   for (const entry of written) {\n874:     assert.ok(embed.ALLOWLIST.includes(entry.path), `${entry.path} is on the allowlist`);\n875:   }\n876: \n877:   assert.doesNotThrow(() => embed.assertWritable(dir, manifest.root_file));\n878:   assert.throws(() => embed.assertWritable(dir, '.skilled/repo-rules/scope-discipline.md'), /allowlist/u);\n879:   assert.throws(() => embed.assertWritable(dir, '../outside-the-root.md'), /outside/u);\n880:   assert.throws(() => embed.assertWritable(dir, '.cursorrules'), /allowlist/u);\n881: });\n882: \n883: // A root document that is a link is the one shape where writing would change a file this\n884: // repository does not own, so the run refuses before it backs anything up.\n885: test('a symlinked root document is refused', (t) => {\n886:   const dir = composeTree(t, 'absent');\n887:   const target = path.join(path.dirname(dir), 'shared-agents.md');\n888:   const shared = '# Shared instructions\\n\\nOne line of a file this tree does not own.\\n';\n889:   fs.writeFileSync(target, shared, 'utf8');\n890:   fs.symlinkSync(target, path.join(dir, manifest.root_file));\n891: \n892:   const refused = plan(dir);\n893:   assert.equal(refused.code, 2, refused.out);\n894:   assert.match(refused.err, /symlink/u);\n895:   assert.equal(fs.readFileSync(target, 'utf8'), shared, 'the linked file is untouched');\n896: });\n897: \n898: test('.codex/AGENTS.md is folded into the block and then removed', (t) => {\n899:   const dir = composeTree(t, 'adopted');\n900:   fs.mkdirSync(path.join(dir, '.codex'), { recursive: true });\n901:   fs.writeFileSync(path.join(dir, '.codex/AGENTS.md'), '# Codex notes\\n\\nAsk before regenerating the fixtures.\\n', 'utf8');\n902: \n903:   const applied = planAndApply(dir).applied;\n904:   trackBackup(t, applied.out);\n905:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n906:   assert.equal(existsInside(dir, '.codex/AGENTS.md'), false);\n907:   const block = blockIn(readInside(dir, manifest.root_file));\n908:   assert.match(block, /### Carried from \\.codex\\/AGENTS\\.md/u);\n909:   assert.match(block, /Ask before regenerating the fixtures\\./u);\n910: });\n911: \n912: // ─────────────────────────────────────────────────────────────────────────────\n913: // 13. THE BACKUP LOCATION\n914: // ─────────────────────────────────────────────────────────────────────────────\n915: \n916: test('an ignored output path holds the backup and a non-ignored one falls back', (t) => {\n917:   const dir = composeTree(t, 'forked');\n918: \n919:   // The tree is not a git checkout, so the ignore check cannot match and the backup has\n920:   // to leave the repository rather than land somewhere git would commit.\n921:   const planned = plan(dir);\n922:   const backup = field(planned.out, 'backup');\n923:   assert.ok(backup, 'the plan prints the backup location');\n924:   assert.ok(backup.startsWith(os.tmpdir() + path.sep), `${backup} is outside the tree`);\n925:   assert.match(planned.out, /backup-fallback: /u);\n926: \n927:   // This repository ignores its output directory, so the same question answers with the\n928:   // path the operator expects there, and the answer creates nothing.\n929:   const here = embed.backupBase({ root: REPO_ROOT });\n930:   assert.equal(here.fallback, false, here.reason);\n931:   assert.equal(here.dir, path.join(REPO_ROOT, '.skilled', 'output', 'doctor-agents-md'));\n932:   assert.equal(fs.existsSync(here.dir), false, 'naming a backup location creates nothing');\n933: });\n934: \n935: test('the backup survives the run and records what it holds', (t) => {\n936:   const dir = composeTree(t, 'foreign');\n937:   const original = readInside(dir, manifest.root_file);\n938:   const applied = planAndApply(dir).applied;\n939:   const backup = trackBackup(t, applied.out);\n940:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n941: \n942:   assert.ok(fs.existsSync(backup), 'the run leaves the backup in place');\n943:   const record = JSON.parse(fs.readFileSync(path.join(backup, 'manifest.json'), 'utf8'));\n944:   assert.match(record.plan_digest, /^[0-9a-f]{64}$/u);\n945:   const entry = record.paths.find((item) => item.path === manifest.root_file);\n946:   assert.equal(entry.existed, true);\n947:   assert.equal(entry.sha256, crypto.createHash('sha256').update(original, 'utf8').digest('hex'));\n948: \n949:   // The engine stages and commits nothing: the restore command is the whole undo.\n950:   assert.doesNotMatch(SOURCE, /git (add|commit|stash)\\b/u);\n951: });\n952: \n953: // ─────────────────────────────────────────────────────────────────────────────\n954: // 14. THE CLAUDE COPY\n955: // ─────────────────────────────────────────────────────────────────────────────\n956: \n957: test('claude-only creates the root document and removes the copy', (t) => {\n958:   const dir = composeTree(t, 'claude-only');\n959:   // The same sentence twice in the copy stays twice in the block, because the proof counts\n960:   // occurrences rather than membership.\n961:   fs.appendFileSync(path.join(dir, 'CLAUDE.md'), 'Run `make check` before you open a pull request.\\n');\n962:   const claude = readInside(dir, 'CLAUDE.md');\n963: \n964:   const applied = planAndApply(dir).applied;\n965:   trackBackup(t, applied.out);\n966:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n967:   assert.equal(existsInside(dir, manifest.root_file), true);\n968:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n969: \n970:   const composed = readInside(dir, manifest.root_file);\n971:   const block = blockIn(composed);\n972:   for (const line of trimmedLines(claude)) {\n973:     assert.equal(occurrences(block, line), occurrences(claude, line), `${line} survives once per occurrence`);\n974:   }\n975: });\n976: \n977: test('--keep-claude-md keeps the copy it folded', (t) => {\n978:   const dir = composeTree(t, 'claude-only');\n979:   const claude = readInside(dir, 'CLAUDE.md');\n980: \n981:   const applied = planAndApply(dir, ['--keep-claude-md']).applied;\n982:   trackBackup(t, applied.out);\n983:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n984:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the copy is untouched');\n985:   const block = blockIn(readInside(dir, manifest.root_file));\n986:   assert.ok(block.includes('Run `make check` before you open a pull request.'), 'and its lines still reached the block');\n987: });\n988: \n989: // Claude Code reads only CLAUDE.md, so a tree that has no copy at all still needs one line\n990: // pointing at the root document this run writes.\n991: test('an adopted tree with no CLAUDE.md gains the pointer', (t) => {\n992:   const dir = composeTree(t, 'adopted');\n993:   fs.rmSync(path.join(dir, 'CLAUDE.md'));\n994: \n995:   const applied = planAndApply(dir).applied;\n996:   trackBackup(t, applied.out);\n997:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n998:   assert.match(applied.out, /wrote AGENTS\\.md/u, 'the run writes the root document');\n999:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n1000: });\n1001: \n1002: // ─────────────────────────────────────────────────────────────────────────────\n1003: // 15. THE ROUTER\n1004: // ─────────────────────────────────────────────────────────────────────────────\n1005: \n1006: test('a router missing shipped rows gains exactly those rows', (t) => {\n1007:   const dir = composeTree(t, 'pure');\n1008:   seedRuleCorpus(dir);\n1009:   const partial = partialRouter(3);\n1010:   fs.writeFileSync(path.join(dir, manifest.router_file), partial, 'utf8');\n1011: \n1012:   const applied = planAndApply(dir).applied;\n1013:   trackBackup(t, applied.out);\n1014:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1015: \n1016:   const router = readInside(dir, manifest.router_file);\n[Output truncated. Continue reading with offset: 1017]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs, lines 1-1016\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The embed engine is the only part of this command that writes, and every line it\n8: // touches belongs to somebody else. Its value is therefore a property rather than an\n9: // output: what it showed is what it wrote, a backup exists before the first byte, and no\n10: // repository line survived only in the old file. This suite proves those properties\n11: // against synthetic repositories, and proves each failure path leaves the tree as it was.\n12: //\n13: // Every case runs on a tree composed for it from the manifest into a throwaway\n14: // directory, never on a committed document and never on this repository's own files. A\n15: // case that needs a real write path, a real router or a real copied rule corpus builds\n16: // it inside that directory, so the engine meets the same shapes it meets in a consumer\n17: // checkout without any of those shapes being committed here.\n18: //\n19: // The backup the engine leaves behind is the rollback, so the engine never deletes it.\n20: // These cases remove only the single run directory their own run created, and only after\n21: // proving it sits under the operating system's temporary directory.\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 1. IMPORTS AND PATHS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const assert = require('node:assert/strict');\n28: const { spawnSync } = require('node:child_process');\n29: const crypto = require('node:crypto');\n30: const fs = require('node:fs');\n31: const os = require('node:os');\n32: const path = require('node:path');\n33: const test = require('node:test');\n34: \n35: const embed = require('../agents-md-embed.cjs');\n36: const {\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   moveBlockBefore,\n42: } = require('./fixtures/agents-md/compose-fixture.cjs');\n43: \n44: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-embed.cjs');\n45: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n46: const SOURCE = fs.readFileSync(ENGINE, 'utf8');\n47: \n48: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 2. TREES, FILES AND DIGESTS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: // One composed tree per case, removed with the case. Composition reads the manifest, so\n55: // a case always describes the template that ships today.\n56: function composeTree(t, name) {\n57:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-embed-${name}-`));\n58:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n59:   const dir = path.join(parent, name);\n60:   composeFixture(name, dir);\n61:   return dir;\n62: }\n63: \n64: function listFiles(dir, prefix = '') {\n65:   const found = [];\n66:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n67:     const relative = prefix === '' ? entry.name : `${prefix}/${entry.name}`;\n68:     if (entry.isDirectory()) found.push(...listFiles(path.join(dir, entry.name), relative));\n69:     else found.push(relative);\n70:   }\n71:   return found.sort();\n72: }\n73: \n74: // Anything the engine leaves behind in a tree changes this number, which is what makes a\n75: // \"writes nothing\" claim checkable rather than promised.\n76: function treeDigest(dir) {\n77:   const hash = crypto.createHash('sha256');\n78:   for (const relative of listFiles(dir)) {\n79:     hash.update(relative);\n80:     hash.update('\\0');\n81:     hash.update(fs.readFileSync(path.join(dir, relative)));\n82:     hash.update('\\0');\n83:   }\n84:   return hash.digest('hex');\n85: }\n86: \n87: function readInside(dir, relative) {\n88:   return fs.readFileSync(path.join(dir, relative), 'utf8');\n89: }\n90: \n91: function existsInside(dir, relative) {\n92:   return fs.existsSync(path.join(dir, relative));\n93: }\n94: \n95: function writeInside(dir, relative, text) {\n96:   fs.writeFileSync(path.join(dir, relative), text, 'utf8');\n97: }\n98: \n99: function trimmedLines(text) {\n100:   return text.split('\\n').map((line) => line.trim()).filter((line) => line !== '' && line !== '---');\n101: }\n102: \n103: function occurrences(text, needle) {\n104:   let count = 0;\n105:   let at = text.indexOf(needle);\n106:   while (at !== -1) {\n107:     count += 1;\n108:     at = text.indexOf(needle, at + needle.length);\n109:   }\n110:   return count;\n111: }\n112: \n113: // The repository block of a composed document, with the markers stripped. The search runs\n114: // over lines, because a marker is the whole line: slicing between the first occurrences of\n115: // the two marker strings would cut a sentence that quotes them in half.\n116: function blockIn(text) {\n117:   const lines = text.split('\\n');\n118:   const from = lines.findIndex((line) => line.trim() === manifest.markers.start.trim());\n119:   const to = lines.findIndex((line) => line.trim() === manifest.markers.end.trim());\n120:   assert.ok(from !== -1 && to > from, 'the composed document carries one well-formed block');\n121:   return lines.slice(from + 1, to).join('\\n');\n122: }\n123: \n124: // A marker is the whole line, so a case counts whole lines: a sentence that quotes the\n125: // marker's bytes is prose, and counting substrings would read it as a second block.\n126: function markerLinesOf(text, marker) {\n127:   return text.split('\\n').filter((line) => line.trim() === marker.trim()).length;\n128: }\n129: \n130: // A line typed inside a shipped section is what makes that section an edit, and the way a\n131: // person plants one is ahead of the divider that closes the section.\n132: function insertInsideSection(text, id, line) {\n133:   const body = manifest.derived.sections[id].body;\n134:   const at = text.indexOf(body);\n135:   assert.ok(at !== -1, `the composed document carries the shipped body of ${id}`);\n136:   const divider = body.lastIndexOf('\\n---\\n');\n137:   const edited = divider === -1\n138:     ? `${body}${line}\\n`\n139:     : `${body.slice(0, divider)}\\n${line}\\n${body.slice(divider)}`;\n140:   return `${text.slice(0, at)}${edited}${text.slice(at + body.length)}`;\n141: }\n142: \n143: // The engine prints one field per line, so a case reads the plan the way an operator\n144: // does instead of reaching into the engine's internals.\n145: function field(text, name) {\n146:   const match = new RegExp(`^${name}: (.*)$`, 'mu').exec(text);\n147:   return match === null ? null : match[1].trim();\n148: }\n149: \n150: function targetsOf(out) {\n151:   const targets = [];\n152:   for (const line of out.split('\\n')) {\n153:     const hit = /^target (\\S+): (create|replace|remove|unchanged)$/.exec(line);\n154:     if (hit !== null) targets.push({ path: hit[1], action: hit[2] });\n155:   }\n156:   return targets;\n157: }\n158: \n159: // ─────────────────────────────────────────────────────────────────────────────\n160: // 3. RUNNERS\n161: // ─────────────────────────────────────────────────────────────────────────────\n162: \n163: function run(args, options = {}) {\n164:   const result = spawnSync(process.execPath, [ENGINE, ...args], {\n165:     encoding: 'utf8',\n166:     input: options.input === undefined ? '' : options.input,\n167:   });\n168:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n169: }\n170: \n171: function plan(dir, extra = []) {\n172:   return run(['plan', '--root', dir, ...extra]);\n173: }\n174: \n175: function apply(dir, digest, extra = []) {\n176:   return run(['apply', '--root', dir, '--plan-digest', digest, ...extra]);\n177: }\n178: \n179: // A plan followed by the apply it authorises, which is the only supported write path.\n180: function planAndApply(dir, extra = []) {\n181:   const planned = plan(dir, extra);\n182:   assert.equal(planned.code, 0, `plan exits 0\\n${planned.err}`);\n183:   const digest = field(planned.out, 'plan-digest');\n184:   assert.match(digest || '', /^[0-9a-f]{64}$/u, 'the plan prints a sha256 digest');\n185:   const applied = apply(dir, digest, extra);\n186:   return { planned, applied, digest };\n187: }\n188: \n189: // The engine never deletes a backup, so the case does: exactly one directory, and only\n190: // when it sits under the temporary directory this run created it in.\n191: function trackBackup(t, text) {\n192:   const dir = field(text, 'backup');\n193:   if (dir === null) return null;\n194:   t.after(() => {\n195:     const temporary = os.tmpdir();\n196:     if (!dir.startsWith(temporary + path.sep)) return;\n197:     fs.rmSync(dir, { recursive: true, force: true });\n198:   });\n199:   return dir;\n200: }\n201: \n202: // ─────────────────────────────────────────────────────────────────────────────\n203: // 4. SCRIPTED WRITES THE ENGINE NEVER MAKES\n204: // ─────────────────────────────────────────────────────────────────────────────\n205: \n206: // A spy rather than a promise: the plan's own composition and report run inside this\n207: // window, so any write path the engine gained would be recorded here.\n208: function spyOnWrites(record) {\n209:   const names = ['writeFileSync', 'appendFileSync', 'mkdirSync', 'mkdtempSync', 'copyFileSync', 'rmSync', 'unlinkSync', 'renameSync', 'rmdirSync'];\n210:   const originals = new Map(names.map((name) => [name, fs[name]]));\n211:   for (const name of names) {\n212:     fs[name] = (...args) => {\n213:       record.push({ name, first: String(args[0]) });\n214:       return originals.get(name).apply(fs, args);\n215:     };\n216:   }\n217:   return () => {\n218:     for (const [name, original] of originals) fs[name] = original;\n219:   };\n220: }\n221: \n222: // ─────────────────────────────────────────────────────────────────────────────\n223: // 5. A REPOSITORY THAT CARRIES THE SHIPPED RULE CORPUS\n224: // ─────────────────────────────────────────────────────────────────────────────\n225: \n226: // The shipped rows point into `.skilled/repo-rules`, which arrives with the install. A\n227: // synthetic repository therefore needs that corpus for its router to be checkable at all,\n228: // so the case copies the installed rule files in rather than inventing rows for them. The\n229: // references those rules link to travel with the install too, so each one is resolved and\n230: // copied to the same relative path.\n231: function seedRuleCorpus(dir) {\n232:   const from = path.join(REPO_ROOT, '.skilled/repo-rules');\n233:   const to = path.join(dir, '.skilled/repo-rules');\n234:   fs.mkdirSync(to, { recursive: true });\n235:   const copied = [];\n236:   for (const name of fs.readdirSync(from)) {\n237:     if (!name.endsWith('.md')) continue;\n238:     fs.copyFileSync(path.join(from, name), path.join(to, name));\n239:     copied.push(name);\n240:   }\n241:   for (const name of copied) {\n242:     const text = fs.readFileSync(path.join(to, name), 'utf8');\n243:     for (const match of text.matchAll(/\\]\\(([^)\\s]+)\\)/gu)) {\n244:       const target = match[1].split('#')[0];\n245:       if (target === '' || /^[a-z][a-z0-9+.-]*:/iu.test(target)) continue;\n246:       const relative = path.posix.normalize(path.posix.join('.skilled/repo-rules', target));\n247:       if (fs.existsSync(path.join(dir, relative))) continue;\n248:       const source = path.join(REPO_ROOT, relative);\n249:       if (!fs.existsSync(source)) continue;\n250:       fs.mkdirSync(path.dirname(path.join(dir, relative)), { recursive: true });\n251:       fs.copyFileSync(source, path.join(dir, relative));\n252:     }\n253:   }\n254: }\n255: \n256: function shippedRows() {\n257:   return manifest.derived.repo_rules;\n258: }\n259: \n260: function renderRows(rows) {\n261:   return rows.map((cells) => `| ${cells.join(' | ')} |`).join('\\n');\n262: }\n263: \n264: // A router that carries only the first few shipped rows, which is the shape a repository\n265: // is left in when an install replaced the rules but not the router.\n266: function partialRouter(count) {\n267:   const { trigger_rows: trigger, index_rows: index } = shippedRows();\n268:   return [\n269:     '# REPO RULES',\n270:     '',\n271:     'Repo-local operating rules. This document routes you to the rule files.',\n272:     '',\n273:     '---',\n274:     '',\n275:     '## 2. TRIGGER TABLE',\n276:     '',\n277:     '| You are about to… | Load | It settles |',\n278:     '|-------------------|------|-----------|',\n279:     renderRows(trigger.slice(0, count)),\n280:     '',\n281:     '---',\n282:     '',\n283:     '## 3. INDEX',\n284:     '',\n285:     '| Rule | Summary |',\n286:     '|------|---------|',\n287:     renderRows(index.slice(0, count)),\n288:     '',\n289:     '---',\n290:     '',\n291:   ].join('\\n');\n292: }\n293: \n294: function tableRows(text, anchor) {\n295:   const lines = text.split('\\n');\n296:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n297:   assert.ok(start !== -1, `the router carries a ${anchor} table`);\n298:   const rows = [];\n299:   for (let index = start + 1; index < lines.length; index += 1) {\n300:     const line = lines[index].trim();\n301:     if (line.startsWith('#')) break;\n302:     if (line === '') {\n303:       if (rows.length > 0) break;\n304:       continue;\n305:     }\n306:     if (!line.startsWith('|')) continue;\n307:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) continue;\n308:     rows.push(line);\n309:   }\n310:   return rows.slice(1);\n311: }\n312: \n313: function runRepoRulesChecker(dir) {\n314:   const result = spawnSync(process.execPath, [REPO_RULES_CHECKER, '--root', dir], { encoding: 'utf8' });\n315:   return {\n316:     code: result.status,\n317:     out: `${result.stdout || ''}\\n${result.stderr || ''}`,\n318:   };\n319: }\n320: \n321: // ─────────────────────────────────────────────────────────────────────────────\n322: // 6. THE PLAN WRITES NOTHING\n323: // ─────────────────────────────────────────────────────────────────────────────\n324: \n325: test('a plan run records zero writes', (t) => {\n326:   const dir = composeTree(t, 'forked');\n327:   const before = treeDigest(dir);\n328: \n329:   const planned = plan(dir);\n330:   assert.equal(planned.code, 0, planned.err);\n331:   assert.equal(treeDigest(dir), before, 'a plan leaves the tree byte for byte');\n332:   assert.match(planned.out, /plan-digest: [0-9a-f]{64}/u);\n333: \n334:   // The plan names where the backup will go, so the location is reviewable, and the\n335:   // names a write path it did not take.\n336:   const backup = field(planned.out, 'backup');\n337:   assert.ok(backup, 'the plan prints the backup location');\n338:   assert.equal(fs.existsSync(backup), false, 'the plan creates no backup directory');\n339: \n340:   const writes = [];\n341:   const restore = spyOnWrites(writes);\n342:   let code;\n343:   try {\n344:     code = embed.main(['plan', '--root', dir], { log: () => {}, warn: () => {} });\n345:   } finally {\n346:     restore();\n347:   }\n348:   assert.equal(code, 0);\n349:   assert.deepEqual(writes, [], 'no write reached the filesystem during a plan');\n350:   assert.equal(treeDigest(dir), before, 'the tree is unchanged after the spy window');\n351: });\n352: \n353: // ─────────────────────────────────────────────────────────────────────────────\n354: // 7. APPLY IS GATED BY THE DIGEST\n355: // ─────────────────────────────────────────────────────────────────────────────\n356: \n357: test('apply without a plan digest exits 2 and writes nothing', (t) => {\n358:   const dir = composeTree(t, 'forked');\n359:   const before = treeDigest(dir);\n360: \n361:   const refused = run(['apply', '--root', dir]);\n362:   assert.equal(refused.code, 2, refused.out);\n363:   assert.match(refused.err, /plan-digest/u);\n364:   assert.equal(treeDigest(dir), before);\n365: });\n366: \n367: test('apply refuses a digest that the tree no longer produces', (t) => {\n368:   const dir = composeTree(t, 'forked');\n369:   const planned = plan(dir);\n370:   const digest = field(planned.out, 'plan-digest');\n371: \n372:   // The operator edits between the plan and the yes, so the shown bytes are stale.\n373:   fs.appendFileSync(path.join(dir, 'AGENTS.md'), '\\nOne more line typed after the plan.\\n');\n374:   const before = treeDigest(dir);\n375: \n376:   const refused = apply(dir, digest);\n377:   assert.equal(refused.code, 2, refused.out);\n378:   assert.match(refused.err, /digest/u);\n379:   assert.equal(treeDigest(dir), before, 'a refused apply writes nothing');\n380: });\n381: \n382: // ─────────────────────────────────────────────────────────────────────────────\n383: // 8. THE PRESERVATION INVARIANT\n384: // ─────────────────────────────────────────────────────────────────────────────\n385: \n386: test('preservationCheck reports each part of the invariant', () => {\n387:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n388:   const compose = (body) => {\n389:     const block = `${manifest.markers.start}\\n${manifest.markers.heading}\\n\\n${manifest.markers.note}\\n${body === '' ? '' : `${body}\\n`}${manifest.markers.end}\\n`;\n390:     return `${shipped}${block}`;\n391:   };\n392: \n393:   const clean = embed.preservationCheck(compose('One kept line.'), compose('One kept line.'), manifest);\n394:   assert.deepEqual(clean.dropped, []);\n395:   assert.deepEqual(clean.foreign, []);\n396: \n397:   // Part one: lines from outside every shipped section left the document.\n398:   const unmarked = `# Our own notes\\n\\nKeep this sentence.\\n`;\n399:   const partOne = embed.preservationCheck(compose(unmarked), compose(''), manifest);\n400:   assert.deepEqual(partOne.dropped.map((entry) => entry.line), ['# Our own notes', 'Keep this sentence.']);\n401:   assert.deepEqual(partOne.dropped.map((entry) => entry.part), [1, 1]);\n402: \n403:   // Part two: a line typed inside a shipped section, which no shipped body carries.\n404:   const sectionId = 's6-spec-folder';\n405:   const edited = manifest.derived.sections[sectionId].body.replace('\\n---\\n', '\\nA local tightening.\\n\\n---\\n');\n406:   const oldTwo = shipped.replace(manifest.derived.sections[sectionId].body, edited);\n407:   const partTwo = embed.preservationCheck(oldTwo, compose(''), manifest);\n408:   assert.equal(partTwo.dropped.length, 1);\n409:   assert.equal(partTwo.dropped[0].part, 2);\n410:   assert.equal(partTwo.dropped[0].line, 'A local tightening.');\n411: \n412:   // Part three: a line that only a removed copy carried.\n413:   const partThree = embed.preservationCheck(compose(''), compose(''), manifest, {\n414:     removed: [{ path: 'CLAUDE.md', content: '# Notes\\n\\nRun the checks first.\\n' }],\n415:   });\n416:   assert.deepEqual(partThree.dropped.map((entry) => entry.line), ['# Notes', 'Run the checks first.']);\n417: \n418:   // Part four: a line outside the block that the shipped template does not carry.\n419:   const foreign = embed.preservationCheck(compose(''), `A line above the block.\\n${compose('')}`, manifest);\n420:   assert.deepEqual(foreign.foreign.map((entry) => entry.line), ['A line above the block.']);\n421: });\n422: \n423: // ─────────────────────────────────────────────────────────────────────────────\n424: // 9. THE FOREIGN AND FORKED SHAPES\n425: // ─────────────────────────────────────────────────────────────────────────────\n426: \n427: test('the foreign shape keeps its whole original document inside the block', (t) => {\n428:   const dir = composeTree(t, 'foreign');\n429:   const original = readInside(dir, manifest.root_file);\n430: \n431:   const { planned, applied } = planAndApply(dir);\n432:   trackBackup(t, applied.out);\n433:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n434:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n435:   assert.match(applied.out, /STATUS=OK/u);\n436: \n437:   const composed = readInside(dir, manifest.root_file);\n438:   assert.ok(composed.startsWith(manifest.derived.sections.title.body), 'the shipped template arrives first');\n439:   const block = blockIn(composed);\n440:   assert.ok(block.includes(original.trim()), 'the original file sits inside the block verbatim');\n441:   for (const line of trimmedLines(original)) {\n442:     assert.equal(occurrences(block, line), occurrences(original, line), `${line} survives once per occurrence`);\n443:   }\n444: \n445:   // Part four, measured on the bytes that reached the disk rather than on the claim.\n446:   const checked = embed.preservationCheck(original, composed, manifest);\n447:   assert.deepEqual(checked.dropped, []);\n448:   assert.deepEqual(checked.foreign, []);\n449:   assert.match(planned.out, /BUDGET|budget: /u);\n450: });\n451: \n452: test('the forked shape carries its unmarked section before its edited section', (t) => {\n453:   const dir = composeTree(t, 'forked');\n454:   const original = readInside(dir, manifest.root_file);\n455:   const localLine = 'Local rule: name the packet in the first line of every pull request.';\n456: \n457:   const applied = planAndApply(dir).applied;\n458:   trackBackup(t, applied.out);\n459:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n460:   assert.match(applied.out, /preservation: kept \\d+, carried 0, shipped-replaced 44, dropped 0/u);\n461: \n462:   const composed = readInside(dir, manifest.root_file);\n463:   const block = blockIn(composed);\n464:   const unmarkedAt = block.indexOf('## Local release checklist');\n465:   const editedAt = block.indexOf('### Carried from s6-spec-folder');\n466:   assert.ok(unmarkedAt !== -1, 'the unmarked section is carried');\n467:   assert.ok(editedAt !== -1, 'the edited section is carried under its id');\n468:   assert.ok(unmarkedAt < editedAt, 'unmarked sections come before edited sections');\n469:   assert.equal(occurrences(composed, localLine), 1, 'the local line moved rather than duplicated');\n470:   assert.equal(occurrences(composed, 'Run `make verify` and post the result in the release channel before tagging.'), 1);\n471: \n472:   const checked = embed.preservationCheck(original, composed, manifest);\n473:   assert.deepEqual(checked.dropped, []);\n474:   assert.deepEqual(checked.foreign, []);\n475: });\n476: \n477: test('a released body is replaced with no carry', (t) => {\n478:   const dir = composeTree(t, 'stale');\n479:   const applied = planAndApply(dir).applied;\n480:   trackBackup(t, applied.out);\n481:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n482: \n483:   const composed = readInside(dir, manifest.root_file);\n484:   const current = manifest.derived.sections['operational-mandates'].body;\n485:   assert.ok(composed.includes(current), 'the current body replaced the released one');\n486:   assert.ok(!composed.includes('### Carried from operational-mandates'), 'nothing is carried from a released body');\n487: });\n488: \n489: // A block is the repository's block wherever it sits. Left above the point a rewrite cuts, its\n490: // content is the first thing a replacement loses, and every shipped section below it is\n491: // invisible, so the rewrite would duplicate them into the block instead of recognising them.\n492: test('a block placed between shipped sections is carried into the block at the end', (t) => {\n493:   const dir = composeTree(t, 'adopted');\n494:   const original = moveBlockBefore(readInside(dir, manifest.root_file), '#### The Four Laws');\n495:   writeInside(dir, manifest.root_file, original);\n496:   const carried = 'Our stack is Node 20 with no web framework.';\n497: \n498:   const applied = planAndApply(dir).applied;\n499:   trackBackup(t, applied.out);\n500:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n501:   assert.match(applied.out, /\\(state: adopted\\)/u, 'the sections below the block are recognised as the template\\'s');\n502:   assert.match(applied.out, /preservation: kept \\d+, carried \\d+, shipped-replaced 44, dropped 0/u);\n503: \n504:   const composed = readInside(dir, manifest.root_file);\n505:   assert.equal(occurrences(composed, manifest.markers.start), 1, 'exactly one block survives');\n506:   const block = blockIn(composed);\n507:   assert.equal(occurrences(block, carried), 1, 'the block content moved into the one block at the end');\n508:   assert.equal(occurrences(composed, carried), 1, 'it is not also left where it was');\n509:   for (const id of ['four-laws', 's2-mandatory-gates', 'operational-mandates']) {\n510:     assert.equal(occurrences(composed, manifest.derived.sections[id].body), 1, `the shipped body ${id} appears once, below the block`);\n511:   }\n512: \n513:   const checked = embed.preservationCheck(original, composed, manifest);\n514:   assert.deepEqual(checked.dropped, []);\n515:   assert.deepEqual(checked.foreign, []);\n516: });\n517: \n518: // The end marker is not the end of the file. A line typed below it is the repository's own,\n519: // and a rewrite that keeps only the block and the shipped sections drops it silently.\n520: test('a line after the end marker is carried into the block', (t) => {\n521:   const dir = composeTree(t, 'adopted');\n522:   const line = 'Ship the release note in the same commit as the tag.';\n523:   const original = `${readInside(dir, manifest.root_file)}${line}\\n`;\n524:   writeInside(dir, manifest.root_file, original);\n525: \n526:   const applied = planAndApply(dir).applied;\n527:   trackBackup(t, applied.out);\n528:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n529:   assert.match(applied.out, /dropped 0/u);\n530: \n531:   const composed = readInside(dir, manifest.root_file);\n532:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n533:   assert.equal(occurrences(composed, line), 1, 'it is not also left below the block');\n534: \n535:   const checked = embed.preservationCheck(original, composed, manifest);\n536:   assert.deepEqual(checked.dropped, []);\n537:   assert.deepEqual(checked.foreign, []);\n538: });\n539: \n540: // Text above the first heading belongs to no section, so nothing but the block can keep it.\n541: // Carried nowhere, it is gone at the first rewrite while the document still reads as pure.\n542: test('text before the first heading is carried into the block', (t) => {\n543:   const dir = composeTree(t, 'pure');\n544:   const line = 'Read me first.';\n545:   const original = `${line}\\n${readInside(dir, manifest.root_file)}`;\n546:   writeInside(dir, manifest.root_file, original);\n547: \n548:   const applied = planAndApply(dir).applied;\n549:   trackBackup(t, applied.out);\n550:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n551:   assert.match(applied.out, /\\(state: forked\\)/u, 'the text above the template is repository content, not a pure template');\n552:   assert.match(applied.out, /dropped 0/u);\n553: \n554:   const composed = readInside(dir, manifest.root_file);\n555:   assert.equal(occurrences(blockIn(composed), line), 1, 'the line sits in the block');\n556:   assert.equal(occurrences(composed, line), 1, 'it is not also left above the template');\n557: \n558:   const checked = embed.preservationCheck(original, composed, manifest);\n559:   assert.deepEqual(checked.dropped, []);\n560:   assert.deepEqual(checked.foreign, []);\n561: \n562:   // The proof has to miss it too, or the next composition that drops the prelude ends in\n563:   // the same silence: the line is gone and nothing was named.\n564:   const lost = embed.preservationCheck(original, composed.replace(`${line}\\n`, ''), manifest);\n565:   assert.ok(lost.dropped.some((entry) => entry.line === line), `the proof counts the text above the template as repository content: ${JSON.stringify(lost.dropped)}`);\n566: });\n567: \n568: // ─────────────────────────────────────────────────────────────────────────────\n569: // 10. THE PROOF, AND WHAT HAPPENS WHEN IT FAILS\n570: // ─────────────────────────────────────────────────────────────────────────────\n571: \n572: // The seam stands in for a writer that loses a line: the composition is intact, the\n573: // digest matches, and the bytes that reach the disk are one line short. Only the\n574: // post-write proof can catch that, which is exactly what it exists for.\n575: function dropALineOnWrite(captured) {\n576:   return (file, content) => {\n577:     const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n578:     const text = bytes.toString('utf8');\n579:     const written = file.endsWith(manifest.root_file)\n580:       ? text.replace('- Never commit a generated file.\\n', '')\n581:       : text;\n582:     captured.push({ file, dropped: written !== text });\n583:     fs.writeFileSync(file, written, 'utf8');\n584:   };\n585: }\n586: \n587: test('a planted drop restores the backup and ends STATUS=FAIL', (t) => {\n588:   const dir = composeTree(t, 'foreign');\n589:   const original = readInside(dir, manifest.root_file);\n590:   const out = [];\n591:   const written = [];\n592:   const hooks = {\n593:     log: (line) => out.push(line),\n594:     warn: (line) => out.push(line),\n595:     write: dropALineOnWrite(written),\n596:   };\n597: \n598:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n599:   const digest = field(out.join('\\n'), 'plan-digest');\n600:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n601:   out.length = 0;\n602: \n603:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n604:   const text = out.join('\\n');\n605:   trackBackup(t, text);\n606: \n607:   assert.equal(code, 1, 'a drop is a failed run');\n608:   assert.ok(written.some((entry) => entry.dropped), 'the seam lost a line on the way to the disk');\n609:   assert.match(text, /STATUS=FAIL/u);\n610:   assert.match(text, /- Never commit a generated file\\./u, 'the dropped line is printed');\n611:   assert.match(text, /restored/u);\n612:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n613: });\n614: \n615: // A line the write leaves outside the block, one no shipped section carries, is a byte the\n616: // template never put there. The proof has to read it as a violation and undo the run,\n617: // because a document that keeps it says the write changed something the plan never showed.\n618: test('a planted foreign line restores the backup and ends STATUS=FAIL', (t) => {\n619:   const dir = composeTree(t, 'foreign');\n620:   const original = readInside(dir, manifest.root_file);\n621:   const planted = 'A line no template ships.';\n622:   const out = [];\n623:   const hooks = {\n624:     log: (line) => out.push(line),\n625:     warn: (line) => out.push(line),\n626:     write: (file, content) => {\n627:       const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n628:       const text = bytes.toString('utf8');\n629:       const written = file.endsWith(manifest.root_file) ? `${planted}\\n${text}` : text;\n630:       fs.writeFileSync(file, written, 'utf8');\n631:     },\n632:   };\n633: \n634:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n635:   const planned = out.join('\\n');\n636:   const backup = field(planned, 'backup');\n637:   assert.ok(backup, 'the plan prints the backup location');\n638:   trackBackup(t, planned);\n639:   const digest = field(planned, 'plan-digest');\n640:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n641:   out.length = 0;\n642: \n643:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n644:   const text = out.join('\\n');\n645: \n646:   assert.equal(code, 1, `a foreign line is a failed run\\n${text}`);\n647:   assert.match(text, /^foreign: A line no template ships\\. \\(outside the block and not a shipped line\\)$/mu);\n648:   assert.match(text, /STATUS=FAIL/u);\n649:   assert.equal(readInside(dir, manifest.root_file), original, 'the backup put the file back');\n650: });\n651: \n652: // A backup that no longer matches the hash the run recorded is the one thing a restore must\n653: // refuse: copying it over the tree would replace the fault it exists to undo with a worse\n654: // one. The write hook damages the copy first, so the post-write proof has to stop before\n655: // the first file goes back and leave the tree as the failed write left it.\n656: test('a damaged backup copy stops the restore and leaves the tree as the write left it', (t) => {\n657:   const dir = composeTree(t, 'foreign');\n658:   const damaged = 'a backup copy the run did not record\\n';\n659:   const out = [];\n660:   let backup = null;\n661:   let first = true;\n662:   const hooks = {\n663:     log: (line) => out.push(line),\n664:     warn: (line) => out.push(line),\n665:     write: (file, content) => {\n666:       if (first) {\n667:         first = false;\n668:         fs.writeFileSync(path.join(backup, 'files', manifest.root_file), damaged, 'utf8');\n669:       }\n670:       const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');\n671:       const text = bytes.toString('utf8');\n672:       const written = file.endsWith(manifest.root_file)\n673:         ? text.replace('- Never commit a generated file.\\n', '')\n674:         : text;\n675:       fs.writeFileSync(file, written, 'utf8');\n676:     },\n677:   };\n678: \n679:   assert.equal(embed.main(['plan', '--root', dir], hooks), 0);\n680:   const planned = out.join('\\n');\n681:   backup = field(planned, 'backup');\n682:   assert.ok(backup, 'the plan prints the backup location');\n683:   trackBackup(t, planned);\n684:   const digest = field(planned, 'plan-digest');\n685:   out.length = 0;\n686: \n687:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest], hooks);\n688:   const text = out.join('\\n');\n689: \n690:   assert.equal(code, 1, 'a failed restore is still a failed run');\n691:   assert.ok(\n692:     text.includes(`ERROR: the backup copy of ${manifest.root_file} does not match its recorded hash, so nothing was restored. The backup is kept at ${backup}`),\n693:     `the mismatch is named with the backup it kept\\n${text}`,\n694:   );\n695:   assert.match(text, /the write dropped 1 line\\(s\\) and the backup could not be restored, so the tree is as the write left it/u);\n696:   assert.ok(!readInside(dir, manifest.root_file).includes(damaged.trim()), 'the damaged backup copy was not written over the tree');\n697: });\n698: \n699: // A writer that throws partway through is neither a run that wrote nothing nor one that\n700: // finished: the targets before it already hold bytes, and the failed target may hold a\n701: // partial one. The backup exists by then, so the only ending that keeps the tree truthful\n702: // is to put it back, name the backup, and report the failure on an exit of its own.\n703: test('a write that throws mid-apply restores the backup and exits 3', (t) => {\n704:   const dir = composeTree(t, 'claude-only');\n705:   const before = treeDigest(dir);\n706:   const out = [];\n707:   let calls = 0;\n708:   const hooks = {\n709:     log: (line) => out.push(line),\n710:     warn: (line) => out.push(line),\n711:     write: (file, content) => {\n712:       calls += 1;\n713:       if (calls === 2) {\n714:         const error = new Error(`EACCES: permission denied, open ${path.basename(file)}`);\n715:         error.code = 'EACCES';\n716:         throw error;\n717:       }\n718:       fs.writeFileSync(file, content, 'utf8');\n719:     },\n720:   };\n721: \n722:   assert.equal(embed.main(['plan', '--root', dir, '--create-router'], hooks), 0);\n723:   const digest = field(out.join('\\n'), 'plan-digest');\n724:   assert.match(digest || '', /^[0-9a-f]{64}$/u);\n725:   out.length = 0;\n726: \n727:   const code = embed.main(['apply', '--root', dir, '--plan-digest', digest, '--create-router'], hooks);\n728:   const text = out.join('\\n');\n729:   trackBackup(t, text);\n730: \n731:   assert.equal(calls, 2, 'the second write is the one that throws');\n732:   assert.equal(code, 3, `a write that throws after the backup is undone\\n${text}`);\n733:   assert.match(text, /EACCES/u, 'the failure names the write it could not make');\n734:   assert.match(text, /restored:/u);\n735:   assert.match(text, /^backup:/mu);\n736:   assert.match(text, /^undo:/mu);\n737:   assert.match(text, /STATUS=FAIL/u);\n738:   assert.equal(treeDigest(dir), before, 'the tree is byte for byte what it was before the apply');\n739: });\n740: \n741: test('restore puts every recorded file back byte for byte', (t) => {\n742:   const dir = composeTree(t, 'foreign');\n743:   const before = treeDigest(dir);\n744: \n745:   const applied = planAndApply(dir).applied;\n746:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n747:   const backup = trackBackup(t, applied.out);\n748:   assert.ok(fs.existsSync(backup), 'the backup exists after the run');\n749:   assert.ok(treeDigest(dir) !== before, 'the run changed the tree');\n750: \n751:   const restored = run([`restore`, `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n752:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n753:   assert.match(restored.out, /restore: /u);\n754:   assert.equal(treeDigest(dir), before, 'every recorded file is byte-identical to its backup');\n755:   assert.ok(fs.existsSync(backup), 'the restore keeps the backup');\n756: });\n757: \n758: test('restore recreates a removed file and deletes a file the run created', (t) => {\n759:   const dir = composeTree(t, 'claude-only');\n760:   const claude = readInside(dir, 'CLAUDE.md');\n761:   const applied = planAndApply(dir).applied;\n762:   const backup = trackBackup(t, applied.out);\n763:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n764:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n', 'the folded copy became a pointer');\n765:   assert.equal(existsInside(dir, manifest.root_file), true, 'the root document was created');\n766: \n767:   const restored = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n768:   assert.equal(restored.code, 0, `${restored.err}${restored.out}`);\n769:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the removed file is recreated byte for byte');\n770:   assert.equal(existsInside(dir, manifest.root_file), false, 'the created file is removed again');\n771: });\n772: \n773: test('restore removes the folders a run created and keeps a folder that was already there', (t) => {\n774:   const fresh = composeTree(t, 'claude-only');\n775:   const freshApplied = planAndApply(fresh).applied;\n776:   assert.equal(freshApplied.code, 0, `${freshApplied.err}${freshApplied.out}`);\n777:   const freshRestored = run(['restore', `--run=${trackBackup(t, freshApplied.out)}`, '--root', fresh], { input: 'yes\\n' });\n778:   assert.equal(freshRestored.code, 0, `${freshRestored.err}${freshRestored.out}`);\n779:   assert.equal(existsInside(fresh, '.cursor'), false, 'a folder the run created is gone after the restore');\n780: \n781:   const kept = composeTree(t, 'claude-only');\n782:   fs.mkdirSync(path.join(kept, '.cursor'));\n783:   const keptApplied = planAndApply(kept).applied;\n784:   assert.equal(keptApplied.code, 0, `${keptApplied.err}${keptApplied.out}`);\n785:   const keptRestored = run(['restore', `--run=${trackBackup(t, keptApplied.out)}`, '--root', kept], { input: 'yes\\n' });\n786:   assert.equal(keptRestored.code, 0, `${keptRestored.err}${keptRestored.out}`);\n787:   assert.equal(existsInside(kept, '.cursor'), true, 'an empty folder that predates the run stays');\n788:   assert.equal(existsInside(kept, '.cursor/rules'), false, 'the folder the run made inside it is gone');\n789: });\n790: \n791: test('restore refuses a record whose root is not the one it runs against', (t) => {\n792:   const dir = composeTree(t, 'foreign');\n793:   const applied = planAndApply(dir).applied;\n794:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n795:   const backup = trackBackup(t, applied.out);\n796:   assert.match(field(applied.out, 'undo'), new RegExp(`--root ${dir.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&')}$`, 'u'), 'the printed undo names the root it needs');\n797: \n798:   const other = composeTree(t, 'foreign');\n799:   const before = treeDigest(other);\n800:   const recordPath = path.join(backup, 'manifest.json');\n801:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n802:   fs.writeFileSync(recordPath, JSON.stringify({ ...record, root: other }));\n803: \n804:   const repointed = run(['restore', `--run=${backup}`, '--root', dir], { input: 'yes\\n' });\n805:   assert.equal(repointed.code, 2, 'a record naming another root is refused');\n806:   assert.match(repointed.err + repointed.out, /names the root/u);\n807:   assert.equal(treeDigest(other), before, 'the folder the record was repointed at is untouched');\n808: \n809:   fs.writeFileSync(recordPath, JSON.stringify(record));\n810:   const unnamed = run(['restore', `--run=${backup}`], { input: 'yes\\n' });\n811:   assert.equal(unnamed.code, 2, 'a restore of another root without --root is refused');\n812: });\n813: \n814: test('restore cancels without a yes', (t) => {\n815:   const dir = composeTree(t, 'foreign');\n816:   const applied = planAndApply(dir).applied;\n817:   const backup = trackBackup(t, applied.out);\n818:   const afterApply = treeDigest(dir);\n819: \n820:   const cancelled = run(['restore', `--run=${backup}`, '--root', dir], { input: 'no\\n' });\n821:   assert.equal(cancelled.code, 1, 'a cancelled restore is not a completed one');\n822:   assert.match(cancelled.out, /cancelled/u);\n823:   assert.equal(treeDigest(dir), afterApply, 'a cancelled restore writes nothing');\n824: });\n825: \n826: // ─────────────────────────────────────────────────────────────────────────────\n827: // 11. IDEMPOTENCE\n828: // ─────────────────────────────────────────────────────────────────────────────\n829: \n830: test('a second run prints NOTHING TO DO', (t) => {\n831:   const dir = composeTree(t, 'foreign');\n832:   const first = planAndApply(dir);\n833:   trackBackup(t, first.applied.out);\n834:   assert.equal(first.applied.code, 0, `${first.applied.err}${first.applied.out}`);\n835:   const afterApply = treeDigest(dir);\n836: \n837:   const second = plan(dir);\n838:   assert.equal(second.code, 0, second.err);\n839:   assert.match(second.out, /NOTHING TO DO/u);\n840:   assert.equal(treeDigest(dir), afterApply);\n841: \n842:   // The writing target gives the same answer: a digest from the first plan names a\n843:   // composition that no longer differs from the tree, so there is nothing to authorise.\n844:   const again = run(['apply', '--root', dir, '--plan-digest', first.digest]);\n845:   assert.equal(again.code, 0, again.err);\n846:   assert.match(again.out, /NOTHING TO DO/u);\n847:   assert.equal(treeDigest(dir), afterApply);\n848: });\n849: \n850: test('a plan on the source repository prints NOTHING TO DO', () => {\n851:   const planned = plan(REPO_ROOT);\n852:   assert.equal(planned.code, 0, planned.err);\n853:   assert.match(planned.out, /NOTHING TO DO/u);\n854: });\n855: \n856: // ─────────────────────────────────────────────────────────────────────────────\n857: // 12. THE WRITE ALLOWLIST\n858: // ─────────────────────────────────────────────────────────────────────────────\n859: \n860: test('every written path is inside the allowlist and a path outside it is refused', (t) => {\n861:   const dir = composeTree(t, 'adopted');\n862:   // A second copy of the shipped rules, so the router's rows resolve and the run has a\n863:   // mirror and a removal to perform as well as the root document.\n864:   seedRuleCorpus(dir);\n865:   fs.writeFileSync(path.join(dir, manifest.router_file), partialRouter(3), 'utf8');\n866: \n867:   const { planned, applied } = planAndApply(dir);\n868:   trackBackup(t, applied.out);\n869:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n870: \n871:   const written = targetsOf(planned.out).filter((entry) => entry.action !== 'unchanged');\n872:   assert.ok(written.length > 0, 'the plan names what it will write');\n873:   for (const entry of written) {\n874:     assert.ok(embed.ALLOWLIST.includes(entry.path), `${entry.path} is on the allowlist`);\n875:   }\n876: \n877:   assert.doesNotThrow(() => embed.assertWritable(dir, manifest.root_file));\n878:   assert.throws(() => embed.assertWritable(dir, '.skilled/repo-rules/scope-discipline.md'), /allowlist/u);\n879:   assert.throws(() => embed.assertWritable(dir, '../outside-the-root.md'), /outside/u);\n880:   assert.throws(() => embed.assertWritable(dir, '.cursorrules'), /allowlist/u);\n881: });\n882: \n883: // A root document that is a link is the one shape where writing would change a file this\n884: // repository does not own, so the run refuses before it backs anything up.\n885: test('a symlinked root document is refused', (t) => {\n886:   const dir = composeTree(t, 'absent');\n887:   const target = path.join(path.dirname(dir), 'shared-agents.md');\n888:   const shared = '# Shared instructions\\n\\nOne line of a file this tree does not own.\\n';\n889:   fs.writeFileSync(target, shared, 'utf8');\n890:   fs.symlinkSync(target, path.join(dir, manifest.root_file));\n891: \n892:   const refused = plan(dir);\n893:   assert.equal(refused.code, 2, refused.out);\n894:   assert.match(refused.err, /symlink/u);\n895:   assert.equal(fs.readFileSync(target, 'utf8'), shared, 'the linked file is untouched');\n896: });\n897: \n898: test('.codex/AGENTS.md is folded into the block and then removed', (t) => {\n899:   const dir = composeTree(t, 'adopted');\n900:   fs.mkdirSync(path.join(dir, '.codex'), { recursive: true });\n901:   fs.writeFileSync(path.join(dir, '.codex/AGENTS.md'), '# Codex notes\\n\\nAsk before regenerating the fixtures.\\n', 'utf8');\n902: \n903:   const applied = planAndApply(dir).applied;\n904:   trackBackup(t, applied.out);\n905:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n906:   assert.equal(existsInside(dir, '.codex/AGENTS.md'), false);\n907:   const block = blockIn(readInside(dir, manifest.root_file));\n908:   assert.match(block, /### Carried from \\.codex\\/AGENTS\\.md/u);\n909:   assert.match(block, /Ask before regenerating the fixtures\\./u);\n910: });\n911: \n912: // ─────────────────────────────────────────────────────────────────────────────\n913: // 13. THE BACKUP LOCATION\n914: // ─────────────────────────────────────────────────────────────────────────────\n915: \n916: test('an ignored output path holds the backup and a non-ignored one falls back', (t) => {\n917:   const dir = composeTree(t, 'forked');\n918: \n919:   // The tree is not a git checkout, so the ignore check cannot match and the backup has\n920:   // to leave the repository rather than land somewhere git would commit.\n921:   const planned = plan(dir);\n922:   const backup = field(planned.out, 'backup');\n923:   assert.ok(backup, 'the plan prints the backup location');\n924:   assert.ok(backup.startsWith(os.tmpdir() + path.sep), `${backup} is outside the tree`);\n925:   assert.match(planned.out, /backup-fallback: /u);\n926: \n927:   // This repository ignores its output directory, so the same question answers with the\n928:   // path the operator expects there, and the answer creates nothing.\n929:   const here = embed.backupBase({ root: REPO_ROOT });\n930:   assert.equal(here.fallback, false, here.reason);\n931:   assert.equal(here.dir, path.join(REPO_ROOT, '.skilled', 'output', 'doctor-agents-md'));\n932:   assert.equal(fs.existsSync(here.dir), false, 'naming a backup location creates nothing');\n933: });\n934: \n935: test('the backup survives the run and records what it holds', (t) => {\n936:   const dir = composeTree(t, 'foreign');\n937:   const original = readInside(dir, manifest.root_file);\n938:   const applied = planAndApply(dir).applied;\n939:   const backup = trackBackup(t, applied.out);\n940:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n941: \n942:   assert.ok(fs.existsSync(backup), 'the run leaves the backup in place');\n943:   const record = JSON.parse(fs.readFileSync(path.join(backup, 'manifest.json'), 'utf8'));\n944:   assert.match(record.plan_digest, /^[0-9a-f]{64}$/u);\n945:   const entry = record.paths.find((item) => item.path === manifest.root_file);\n946:   assert.equal(entry.existed, true);\n947:   assert.equal(entry.sha256, crypto.createHash('sha256').update(original, 'utf8').digest('hex'));\n948: \n949:   // The engine stages and commits nothing: the restore command is the whole undo.\n950:   assert.doesNotMatch(SOURCE, /git (add|commit|stash)\\b/u);\n951: });\n952: \n953: // ─────────────────────────────────────────────────────────────────────────────\n954: // 14. THE CLAUDE COPY\n955: // ─────────────────────────────────────────────────────────────────────────────\n956: \n957: test('claude-only creates the root document and removes the copy', (t) => {\n958:   const dir = composeTree(t, 'claude-only');\n959:   // The same sentence twice in the copy stays twice in the block, because the proof counts\n960:   // occurrences rather than membership.\n961:   fs.appendFileSync(path.join(dir, 'CLAUDE.md'), 'Run `make check` before you open a pull request.\\n');\n962:   const claude = readInside(dir, 'CLAUDE.md');\n963: \n964:   const applied = planAndApply(dir).applied;\n965:   trackBackup(t, applied.out);\n966:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n967:   assert.equal(existsInside(dir, manifest.root_file), true);\n968:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n969: \n970:   const composed = readInside(dir, manifest.root_file);\n971:   const block = blockIn(composed);\n972:   for (const line of trimmedLines(claude)) {\n973:     assert.equal(occurrences(block, line), occurrences(claude, line), `${line} survives once per occurrence`);\n974:   }\n975: });\n976: \n977: test('--keep-claude-md keeps the copy it folded', (t) => {\n978:   const dir = composeTree(t, 'claude-only');\n979:   const claude = readInside(dir, 'CLAUDE.md');\n980: \n981:   const applied = planAndApply(dir, ['--keep-claude-md']).applied;\n982:   trackBackup(t, applied.out);\n983:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n984:   assert.equal(readInside(dir, 'CLAUDE.md'), claude, 'the copy is untouched');\n985:   const block = blockIn(readInside(dir, manifest.root_file));\n986:   assert.ok(block.includes('Run `make check` before you open a pull request.'), 'and its lines still reached the block');\n987: });\n988: \n989: // Claude Code reads only CLAUDE.md, so a tree that has no copy at all still needs one line\n990: // pointing at the root document this run writes.\n991: test('an adopted tree with no CLAUDE.md gains the pointer', (t) => {\n992:   const dir = composeTree(t, 'adopted');\n993:   fs.rmSync(path.join(dir, 'CLAUDE.md'));\n994: \n995:   const applied = planAndApply(dir).applied;\n996:   trackBackup(t, applied.out);\n997:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n998:   assert.match(applied.out, /wrote AGENTS\\.md/u, 'the run writes the root document');\n999:   assert.equal(readInside(dir, 'CLAUDE.md'), '@AGENTS.md\\n');\n1000: });\n1001: \n1002: // ─────────────────────────────────────────────────────────────────────────────\n1003: // 15. THE ROUTER\n1004: // ─────────────────────────────────────────────────────────────────────────────\n1005: \n1006: test('a router missing shipped rows gains exactly those rows', (t) => {\n1007:   const dir = composeTree(t, 'pure');\n1008:   seedRuleCorpus(dir);\n1009:   const partial = partialRouter(3);\n1010:   fs.writeFileSync(path.join(dir, manifest.router_file), partial, 'utf8');\n1011: \n1012:   const applied = planAndApply(dir).applied;\n1013:   trackBackup(t, applied.out);\n1014:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n1015: \n1016:   const router = readInside(dir, manifest.router_file);\n[Output truncated. Continue reading with offset: 1017]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\"}"},"time":{"start":1794559619474,"end":1794559620618}}}}
