 recommendation.command ?? row?.command;\n   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n   const policy = recommendation.policy ?? row?.policy;\n@@ -230,7 +232,12 @@ function commandLabel(recommendation: RenderableRecommendation, childSession: bo\n   if (!commandPart || !ownerPart) {\n     return null;\n   }\n-  const policyPart = policyWord(policy, row?.mutating, childSession);\n+  // The class belongs to the command printed, not to the skill that carried it,\n+  // so a recommendation that names another command takes that command's class.\n+  const mutating = row !== undefined && row.command === command\n+    ? row.mutating\n+    : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === command)?.mutating;\n+  const policyPart = policyWord(policy, mutating, childSession);\n   return policyPart === null\n     ? `${ownerPart} → ${commandPart}`\n     : `${ownerPart} → ${commandPart} (${policyPart})`;\n@@ -547,7 +554,7 @@ export function renderAdvisorBrief(\n \n   // A hub that withheld its command because the prompt names no single mode says\n   // so, so the reader asks for the mode instead of improvising one.\n-  const headLabel = top.needsMode === true && top.command === undefined && commandRowFor(top.skill) === undefined\n+  const headLabel = top.needsMode === true && top.command === undefined\n     ? `${topLabel} (needs a mode)`\n     : topLabel;\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts\nindex 4c1284d321..d50385337b 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts\n@@ -16,6 +16,7 @@ import {\n   HYGIENE_DIRECTIVE,\n   renderAdvisorBrief,\n } from '../lib/render.js';\n+import { isChildSession } from '../../../system-spec-kit/runtime/hooks/lib/spec-gate/spec-gate-core.mjs';\n \n type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n \n@@ -84,6 +85,28 @@ describe('child session command brief', () => {\n     ));\n   });\n \n+  it('takes the class from the row of the command it prints', () => {\n+    vi.stubEnv('AI_SESSION_CHILD', '1');\n+\n+    const rendered = renderAdvisorBrief({\n+      status: 'ok',\n+      freshness: 'live',\n+      recommendations: [{\n+        skill: 'command-speckit-search',\n+        kind: 'command',\n+        command: '/doctor:speckit',\n+        policy: 'run',\n+        confidence: 0.85,\n+        uncertainty: 0.2,\n+        passes_threshold: true,\n+      }],\n+      metrics: { tokenCap: 80 },\n+    });\n+    const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n+\n+    expect(head).toContain('/doctor:speckit (parent-named only)');\n+  });\n+\n   it('matches the non-child render when the variable is 0', () => {\n     vi.stubEnv('AI_SESSION_CHILD', '0');\n     const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n@@ -117,4 +140,15 @@ describe('child session command brief', () => {\n       'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n     ));\n   });\n+\n+  // The renderer keeps its own literal so the runtime build has no edge into\n+  // the spec kit, and this case keeps the two rules equal.\n+  it.each(['1', '0', 'true', ''])('reads AI_SESSION_CHILD=%s as the spec gate does', (value) => {\n+    vi.stubEnv('AI_SESSION_CHILD', value);\n+\n+    const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n+    const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n+\n+    expect(head.includes('(parent-named only)')).toBe(isChildSession({ AI_SESSION_CHILD: value }));\n+  });\n });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skill