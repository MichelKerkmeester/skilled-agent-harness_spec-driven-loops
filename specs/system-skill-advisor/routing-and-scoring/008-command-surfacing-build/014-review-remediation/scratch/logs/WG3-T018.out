{"type":"tool_use","timestamp":1794559122597,"sessionID":"ses_e2bf145a7ffe4CZZRU25P9R7s0","part":{"partID":"prt_1d40f1b38001WPwZBWks5AiJv4","sessionID":"ses_e2bf145a7ffe4CZZRU25P9R7s0","messageID":"msg_1d40ef5e5001KKyOWqgnzWGwg2","type":"tool","id":"call_99cc96e95e924c31a0deab7e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts, lines 1-132\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Child Session Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A dispatched child must not start a workflow its parent did not name, so the\n6: // brief swaps the policy word for a marker there and nowhere else.\n7: //\n8: // Axes, one row each:\n9: //   child variable: set to 1, set to another value (0), unset\n10: //   policy: run, start, ask\n11: //   class: read-only, not read-only (add-only)\n12: \n13: import { afterEach, describe, expect, it, vi } from 'vitest';\n14: import {\n15:   DIRECTIVES_LABEL,\n16:   HYGIENE_DIRECTIVE,\n17:   renderAdvisorBrief,\n18: } from '../lib/render.js';\n19: import { isChildSession } from '../../../system-spec-kit/runtime/hooks/lib/spec-gate/spec-gate-core.mjs';\n20: \n21: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n22: \n23: function expectedBrief(summary: string): string {\n24:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n25: }\n26: \n27: // One passing recommendation isolates the label form from threshold filtering.\n28: function advisorResult(skill: string): AdvisorBriefResult {\n29:   return {\n30:     status: 'ok',\n31:     freshness: 'live',\n32:     recommendations: [{\n33:       skill,\n34:       kind: 'command',\n35:       confidence: 0.85,\n36:       uncertainty: 0.2,\n37:       passes_threshold: true,\n38:     }],\n39:     metrics: { tokenCap: 80 },\n40:   };\n41: }\n42: \n43: describe('child session command brief', () => {\n44:   afterEach(() => {\n45:     vi.unstubAllEnvs();\n46:   });\n47: \n48:   it('renders a start command as parent-named only', () => {\n49:     vi.stubEnv('AI_SESSION_CHILD', '1');\n50: \n51:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n52: \n53:     expect(rendered).toBe(expectedBrief(\n54:       'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\n55:     ));\n56:   });\n57: \n58:   it('renders an ask command as parent-named only', () => {\n59:     vi.stubEnv('AI_SESSION_CHILD', '1');\n60: \n61:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n62: \n63:     expect(rendered).toBe(expectedBrief(\n64:       'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\n65:     ));\n66:   });\n67: \n68:   it('keeps the policy word for a read-only run', () => {\n69:     vi.stubEnv('AI_SESSION_CHILD', '1');\n70: \n71:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\n72: \n73:     expect(rendered).toBe(expectedBrief(\n74:       'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\n75:     ));\n76:   });\n77: \n78:   it('renders a run command that adds files as parent-named only', () => {\n79:     vi.stubEnv('AI_SESSION_CHILD', '1');\n80: \n81:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\n82: \n83:     expect(rendered).toBe(expectedBrief(\n84:       'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\n85:     ));\n86:   });\n87: \n88:   it('matches the non-child render when the variable is 0', () => {\n89:     vi.stubEnv('AI_SESSION_CHILD', '0');\n90:     const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n91: \n92:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n93: \n94:     expect(rendered).toBe(baseline);\n95:     expect(rendered).toBe(expectedBrief(\n96:       'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\n97:     ));\n98:   });\n99: \n100:   it('matches the non-child render when the variable is unset', () => {\n101:     vi.stubEnv('AI_SESSION_CHILD', undefined);\n102:     const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\n103: \n104:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n105: \n106:     expect(rendered).toBe(baseline);\n107:     expect(rendered).toBe(expectedBrief(\n108:       'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\n109:     ));\n110:   });\n111: \n112:   it('renders a doctor bridge at the top as parent-named only', () => {\n113:     vi.stubEnv('AI_SESSION_CHILD', '1');\n114: \n115:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\n116: \n117:     expect(rendered).toBe(expectedBrief(\n118:       'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n119:     ));\n120:   });\n121: \n122:   // The renderer keeps its own literal so the runtime build has no edge into\n123:   // the spec kit, and this case keeps the two rules equal.\n124:   it.each(['1', '0', 'true', ''])('reads AI_SESSION_CHILD=%s as the spec gate does', (value) => {\n125:     vi.stubEnv('AI_SESSION_CHILD', value);\n126: \n127:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n128:     const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n129: \n130:     expect(head.includes('(parent-named only)')).toBe(isChildSession({ AI_SESSION_CHILD: value }));\n131:   });\n132: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts, lines 1-132\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Child Session Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A dispatched child must not start a workflow its parent did not name, so the\n6: // brief swaps the policy word for a marker there and nowhere else.\n7: //\n8: // Axes, one row each:\n9: //   child variable: set to 1, set to another value (0), unset\n10: //   policy: run, start, ask\n11: //   class: read-only, not read-only (add-only)\n12: \n13: import { afterEach, describe, expect, it, vi } from 'vitest';\n14: import {\n15:   DIRECTIVES_LABEL,\n16:   HYGIENE_DIRECTIVE,\n17:   renderAdvisorBrief,\n18: } from '../lib/render.js';\n19: import { isChildSession } from '../../../system-spec-kit/runtime/hooks/lib/spec-gate/spec-gate-core.mjs';\n20: \n21: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n22: \n23: function expectedBrief(summary: string): string {\n24:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n25: }\n26: \n27: // One passing recommendation isolates the label form from threshold filtering.\n28: function advisorResult(skill: string): AdvisorBriefResult {\n29:   return {\n30:     status: 'ok',\n31:     freshness: 'live',\n32:     recommendations: [{\n33:       skill,\n34:       kind: 'command',\n35:       confidence: 0.85,\n36:       uncertainty: 0.2,\n37:       passes_threshold: true,\n38:     }],\n39:     metrics: { tokenCap: 80 },\n40:   };\n41: }\n42: \n43: describe('child session command brief', () => {\n44:   afterEach(() => {\n45:     vi.unstubAllEnvs();\n46:   });\n47: \n48:   it('renders a start command as parent-named only', () => {\n49:     vi.stubEnv('AI_SESSION_CHILD', '1');\n50: \n51:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n52: \n53:     expect(rendered).toBe(expectedBrief(\n54:       'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\n55:     ));\n56:   });\n57: \n58:   it('renders an ask command as parent-named only', () => {\n59:     vi.stubEnv('AI_SESSION_CHILD', '1');\n60: \n61:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n62: \n63:     expect(rendered).toBe(expectedBrief(\n64:       'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\n65:     ));\n66:   });\n67: \n68:   it('keeps the policy word for a read-only run', () => {\n69:     vi.stubEnv('AI_SESSION_CHILD', '1');\n70: \n71:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\n72: \n73:     expect(rendered).toBe(expectedBrief(\n74:       'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\n75:     ));\n76:   });\n77: \n78:   it('renders a run command that adds files as parent-named only', () => {\n79:     vi.stubEnv('AI_SESSION_CHILD', '1');\n80: \n81:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\n82: \n83:     expect(rendered).toBe(expectedBrief(\n84:       'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\n85:     ));\n86:   });\n87: \n88:   it('matches the non-child render when the variable is 0', () => {\n89:     vi.stubEnv('AI_SESSION_CHILD', '0');\n90:     const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n91: \n92:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n93: \n94:     expect(rendered).toBe(baseline);\n95:     expect(rendered).toBe(expectedBrief(\n96:       'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\n97:     ));\n98:   });\n99: \n100:   it('matches the non-child render when the variable is unset', () => {\n101:     vi.stubEnv('AI_SESSION_CHILD', undefined);\n102:     const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\n103: \n104:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n105: \n106:     expect(rendered).toBe(baseline);\n107:     expect(rendered).toBe(expectedBrief(\n108:       'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\n109:     ));\n110:   });\n111: \n112:   it('renders a doctor bridge at the top as parent-named only', () => {\n113:     vi.stubEnv('AI_SESSION_CHILD', '1');\n114: \n115:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\n116: \n117:     expect(rendered).toBe(expectedBrief(\n118:       'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n119:     ));\n120:   });\n121: \n122:   // The renderer keeps its own literal so the runtime build has no edge into\n123:   // the spec kit, and this case keeps the two rules equal.\n124:   it.each(['1', '0', 'true', ''])('reads AI_SESSION_CHILD=%s as the spec gate does', (value) => {\n125:     vi.stubEnv('AI_SESSION_CHILD', value);\n126: \n127:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n128:     const head = rendered.slice(0, rendered.indexOf(DIRECTIVES_LABEL));\n129: \n130:     expect(head.includes('(parent-named only)')).toBe(isChildSession({ AI_SESSION_CHILD: value }));\n131:   });\n132: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts\"}"},"time":{"start":1794559122232,"end":1794559122597}}}}
{"type":"tool_use","timestamp":1794559122600,"sessionID":"ses_e2bf145a7ffe4CZZRU25P9R7s0","part":{"partID":"prt_1d40f19710016uQna7CaWQvDk0","sessionID":"ses_e2bf145a7ffe4CZZRU25P9R7s0","messageID":"msg_1d40ef5e5001KKyOWqgnzWGwg2","type":"tool","id":"call_5506ef2973fe48bf85c8ba6c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-654\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46:   /**\n47:    * True when a dispatched child renders the brief. A child keeps the skill line\n48:    * but a command it must not start alone renders as parent-named only. Defaults\n49:    * to `AI_SESSION_CHILD === '1'`.\n50:    */\n51:   readonly childSession?: boolean;\n52: }\n53: \n54: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n55:   readonly runtime?: string;\n56:   readonly candidate?: string | null;\n57:   readonly stateMachine?: DeliveryStateMachine;\n58:   readonly deliveryConfirmed?: boolean;\n59:   readonly receipt?: DeliveryStateReceipt;\n60:   readonly transformMessageIdentity?: string | null;\n61:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n62: }\n63: \n64: export interface ShadowRouteOnlyLogRecord {\n65:   readonly shadowId: string;\n66:   readonly sessionKnown: boolean;\n67:   readonly epoch: number;\n68:   readonly policySetHash: string;\n69:   readonly routeState: DeliveryStateName | null;\n70:   readonly emittedByteCount: number;\n71:   readonly routeOnlyByteCount: number;\n72:   readonly savedBytes: number;\n73: }\n74: \n75: export interface AdvisorBriefRenderableResult {\n76:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n77:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n78:   readonly recommendations: readonly AdvisorRecommendation[];\n79:   readonly ambiguous?: boolean;\n80:   readonly metrics?: {\n81:     readonly tokenCap?: number;\n82:   } | null;\n83:   readonly sharedPayload?: {\n84:     readonly metadata?: {\n85:       readonly skillLabel?: string | null;\n86:     } | null;\n87:   } | null;\n88: }\n89: \n90: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n91: export type AdvisorFallbackClassification =\n92:   | {\n93:     readonly fallbackCase: 'outage';\n94:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n95:   }\n96:   | {\n97:     readonly fallbackCase: 'no-match' | 'skipped';\n98:   };\n99: \n100: // ───────────────────────────────────────────────────────────────\n101: // 2. CONSTANTS\n102: // ───────────────────────────────────────────────────────────────\n103: \n104: const DEFAULT_TOKEN_CAP = 80;\n105: const AMBIGUOUS_TOKEN_CAP = 120;\n106: const MAX_TOKEN_CAP = 120;\n107: const TOKEN_TO_CHAR_ESTIMATE = 4;\n108: const INSTRUCTION_LABEL_PATTERN =\n109:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n110: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n111: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n112: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n113: const PARENT_NAMED_POLICY = 'parent-named only';\n114: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n115: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n116: \n117: function directiveBlockIds(): readonly string[] {\n118:   return Object.freeze([\n119:     POLICY_COMMENT_HYGIENE_ID,\n120:   ]);\n121: }\n122: \n123: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n124: \n125: // Injected into every advisor brief so all hook-capable runtimes receive\n126: // the comment hygiene rule even when AGENTS.md is absent from session context.\n127: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n128: \n129: \n130: \n131: // Labels the directive block so injected content reads as one structured\n132: // capsule instead of loose lines.\n133: export const DIRECTIVES_LABEL = '\\nDirectives:';\n134: \n135: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n136: // reader learns the read-only overview exists without every miss paying for it.\n137: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 3. HELPERS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: function clampTokenCap(tokenCap: number | undefined): number {\n144:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n145:     return DEFAULT_TOKEN_CAP;\n146:   }\n147:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n148: }\n149: \n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   // A hub that withheld its mode must not regress to the command its generated\n225:   // row names, because that command is the mode the reader has not chosen yet.\n226:   const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n227:   const command = recommendation.command ?? row?.command;\n228:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n229:   const policy = recommendation.policy ?? row?.policy;\n230:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n231:   const ownerPart = sanitizeSkillLabel(owner);\n232:   if (!commandPart || !ownerPart) {\n233:     return null;\n234:   }\n235:   const policyPart = policyWord(policy, row?.mutating, childSession);\n236:   return policyPart === null\n237:     ? `${ownerPart} → ${commandPart}`\n238:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n239: }\n240: \n241: // A doctor bridge renders as its runnable command and never as its raw id; an\n242: // unmapped doctor id renders nothing.\n243: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n244:   return commandLabel(recommendation, childSession)\n245:     ?? (isDoctorBridgeId(recommendation.skill)\n246:       ? doctorCommandString(recommendation.skill)\n247:       : sanitizeSkillLabel(recommendation.skill));\n248: }\n249: \n250: // The companion line normally shows only the runnable command. A child gets the\n251: // downgrade marker appended because that command must not be started there.\n252: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n253:   const command = doctorCommandString(skillId);\n254:   if (command === null) {\n255:     return null;\n256:   }\n257:   const row = commandRowFor(skillId);\n258:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n259:     ? `${command} (${PARENT_NAMED_POLICY})`\n260:     : command;\n261: }\n262: \n263: function formatScore(value: number): string {\n264:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n265: }\n266: \n267: type RenderableRecommendation = AdvisorRecommendation & {\n268:   readonly score?: number;\n269:   readonly ambiguousWith?: readonly string[];\n270:   readonly heldBelow?: string;\n271: };\n272: \n273: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n274:   return {\n275:     skill: recommendation.skill,\n276:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n277:     confidence: recommendation.confidence,\n278:     uncertainty: recommendation.uncertainty,\n279:     passes_threshold: recommendation.passes_threshold ?? true,\n280:     reason: '',\n281:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n282:       ? recommendation.score\n283:       : recommendation.confidence,\n284:     laneContributions: [],\n285:     dominantLane: null,\n286:     lifecycleStatus: 'active',\n287:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n288:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n289:   };\n290: }\n291: \n292: /**\n293:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n294:  *\n295:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n296:  * scorer knows which skills a typed command held below the top and which only cleared\n297:  * a confidence floor, and serialized recommendations lose that context. Only when the\n298:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n299:  */\n300: export function hasAdvisorAmbiguitySignal(\n301:   recommendations: readonly AdvisorRecommendation[],\n302:   precomputedAmbiguous?: boolean,\n303: ): boolean {\n304:   if (typeof precomputedAmbiguous === 'boolean') {\n305:     return precomputedAmbiguous;\n306:   }\n307:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n308: }\n309: \n310: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n311:   const metadata = result.sharedPayload?.metadata;\n312:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n313: }\n314: \n315: /** Return only the advisor route block that the shadow path would retain. */\n316: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n317:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n318:     block.id === ROUTE_ADVISOR_ID\n319:   ));\n320:   return routeBlock?.content ?? null;\n321: }\n322: \n323: /** Read the append-only in-process shadow log without exposing route content. */\n324: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n325:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n326: }\n327: \n328: /** Clear shadow log entries between isolated evaluations. */\n329: export function clearShadowRouteOnlyLog(): void {\n330:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n331: }\n332: \n333: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n334:   return {\n335:     ...options,\n336:     lifecycleEvent: undefined,\n337:     scopeChanged: false,\n338:     policySetChanged: false,\n339:     goalChanged: false,\n340:   };\n341: }\n342: \n343: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n344:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n345:     SHADOW_ROUTE_ONLY_LOG.shift();\n346:   }\n347:   SHADOW_ROUTE_ONLY_LOG.push(record);\n348: }\n349: \n350: function directiveBlocksSuppressed(\n351:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n352:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n353: ): boolean {\n354:   for (const expectedId of directiveBlockIds()) {\n355:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n356:     if (blockIndex === -1) {\n357:       return false;\n358:     }\n359:     const decision = decisions[blockIndex];\n360:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n361:       return false;\n362:     }\n363:   }\n364:   return true;\n365: }\n366: \n367: function recordObservedBlockDeliveries(\n368:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n369:   shadowOptions: ShadowDeliveryRenderOptions,\n370:   machine: DeliveryStateMachine,\n371:   epoch: number,\n372: ): void {\n373:   const blockOptions = stateSignalsForBlock(shadowOptions);\n374:   for (const block of plan.blocks) {\n375:     const receipt = shadowOptions.receipt;\n376:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n377:       continue;\n378:     }\n379:     machine.recordDelivery({\n380:       ...blockOptions,\n381:       blockId: block.id,\n382:       contentHash: block.contentHash,\n383:       receipt,\n384:     });\n385:   }\n386: }\n387: \n388: function observeShadowRouteOnly(\n389:   rendered: string | null,\n390:   options: ShadowDeliveryRenderOptions | undefined,\n391: ): void {\n392:   try {\n393:     const plan = buildAdvisorRenderPlan(rendered);\n394:     const shadowOptions = options ?? {};\n395:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n396:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n397:     const blockOptions = stateSignalsForBlock(shadowOptions);\n398:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n399:       ...blockOptions,\n400:       blockId: block.id,\n401:       contentHash: block.contentHash,\n402:     }, machine));\n403: \n404:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n405: \n406:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n407:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n408:     const routeOnlyEligible = Boolean(\n409:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n410:     );\n411:     const routeOnly = routeOnlyEligible\n412:       ? renderRouteOnlyAdvisorBrief(rendered)\n413:       : null;\n414:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n415:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n416:     const savedBytes = routeOnly === null\n417:       ? 0\n418:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n419:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n420:       shadowId: ROUTE_ONLY_SHADOW_ID,\n421:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n422:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n423:       policySetHash: plan.policySetHash,\n424:       routeState: routeDecision?.state ?? null,\n425:       emittedByteCount,\n426:       routeOnlyByteCount,\n427:       savedBytes,\n428:     });\n429:     pushShadowRouteOnlyLog(record);\n430:     try {\n431:       options?.onShadowLog?.(record);\n432:     } catch {\n433:       // Observer callbacks must never affect the rendered advisor bytes.\n434:     }\n435:   } catch {\n436:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n437:   }\n438: }\n439: \n440: function observeAdvisorPolicy(\n441:   rendered: string | null,\n442:   options: AdvisorBriefRenderOptions = {},\n443: ): void {\n444:   try {\n445:     observeRenderedAdvisorPolicy(rendered);\n446:   } catch {\n447:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n448:   }\n449:   observeShadowRouteOnly(rendered, options.deliveryState);\n450: }\n451: \n452: /** Run the shadow planner for a runtime callback without changing its output. */\n453: export function observeShadowDelivery(\n454:   rendered: string | null,\n455:   deliveryState: ShadowDeliveryRenderOptions = {},\n456: ): void {\n457:   observeAdvisorPolicy(rendered, { deliveryState });\n458: }\n459: \n460: /**\n461:  * Record host-observed policy blocks after the runtime places them into the\n462:  * emitted response. Fail-open: recording errors never change emitted bytes.\n463:  */\n464: export function observeEmittedAdvisorPolicy(\n465:   rendered: string | null,\n466:   deliveryState: ShadowDeliveryRenderOptions = {},\n467: ): void {\n468:   try {\n469:     if (typeof rendered !== 'string' || rendered.length === 0) {\n470:       return;\n471:     }\n472:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n473:       ? deliveryState.runtime\n474:       : 'unknown';\n475:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n476:     const epoch = machine.currentEpoch(deliveryState);\n477:     const plan = buildAdvisorRenderPlan(rendered);\n478:     for (const block of plan.blocks) {\n479:       recordObservedPolicyDelivery({\n480:         runtime,\n481:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n482:         blockId: block.id,\n483:         content: block.content,\n484:         contentHash: block.contentHash,\n485:         lifecycleEpoch: epoch,\n486:         sessionId: deliveryState.sessionId,\n487:         sessionIdentity: deliveryState.sessionIdentity,\n488:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n489:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n490:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n491:       });\n492:     }\n493:   } catch {\n494:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n495:   }\n496: }\n497: \n498: // ───────────────────────────────────────────────────────────────\n499: // 4. CORE LOGIC\n500: // ───────────────────────────────────────────────────────────────\n501: \n502: /**\n503:  * Render the model-visible advisor brief from typed advisor output only.\n504:  *\n505:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n506:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n507:  * repository-authored skill label looks instruction-shaped after folding.\n508:  */\n509: export function renderAdvisorBrief(\n510:   result: AdvisorBriefRenderableResult,\n511:   options: AdvisorBriefRenderOptions = {},\n512: ): string | null {\n513:   if (result.status !== 'ok') {\n514:     observeAdvisorPolicy(null, options);\n515:     return null;\n516:   }\n517:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n518:     observeAdvisorPolicy(null, options);\n519:     return null;\n520:   }\n521: \n522:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n523:   const thresholdConfig = options.thresholdConfig;\n524:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n525:   const recommendations = result.recommendations.filter((recommendation) => (\n526:     recommendation.passes_threshold === true\n527:     || (\n528:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n529:       && (\n530:         thresholdConfig?.confidenceOnly === true\n531:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n532:       )\n533:     )\n534:   ));\n535:   const [top, second] = recommendations;\n536:   if (!top) {\n537:     observeAdvisorPolicy(null, options);\n538:     return null;\n539:   }\n540: \n541:   const topLabel = commandLabel(top, childSession)\n542:     ?? (isDoctorBridgeId(top.skill)\n543:       ? doctorCommandString(top.skill)\n544:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n545:   if (!topLabel) {\n546:     observeAdvisorPolicy(null, options);\n547:     return null;\n548:   }\n549: \n550:   // A hub that withheld its command because the prompt names no single mode says\n551:   // so, so the reader asks for the mode instead of improvising one.\n552:   const headLabel = top.needsMode === true && top.command === undefined\n553:     ? `${topLabel} (needs a mode)`\n554:     : topLabel;\n555: \n556:   const companion = isDoctorBridgeId(top.skill)\n557:     ? undefined\n558:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n559:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n560:   const companionLine = (shownSecond: string | undefined): string => (\n561:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n562:   );\n563:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n564:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n565:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n566:   };\n567: \n568:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n569:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n570:     // The scorer names its own tie partners, which can sit below the second passing\n571:     // entry, so prefer a named partner and fall back to the second entry.\n572:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n573:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n574:     const vs = (ambiguousWith.length > 0\n575:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n576:       : undefined) ?? second;\n577:     const vsLabel = recommendationLabel(vs, childSession);\n578:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n579:       observeAdvisorPolicy(null, options);\n580:       return null;\n581:     }\n582:     if (vsLabel) {\n583:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n584:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n585:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n586:       const rendered = capWithCompanion(\n587:         head,\n588:         companionLine(vs.skill),\n589:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n590:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n591:       observeAdvisorPolicy(rendered, options);\n592:       return rendered;\n593:     }\n594:   }\n595: \n596:   const head = `Advisor: ${result.freshness}; use ${headLabel} `\n597:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n598:   const rendered = capWithCompanion(\n599:     head,\n600:     companionLine(undefined),\n601:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n602:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n603:   observeAdvisorPolicy(rendered, options);\n604:   return rendered;\n605: }\n606: \n607: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n608: export function advisorFallbackCase(\n609:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n610: ): AdvisorFallbackClassification {\n611:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n612:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n613:     return {\n614:       fallbackCase: 'outage',\n615:       outageLabel: result?.freshness === 'absent'\n616:         ? 'absent'\n617:         : result?.status === 'degraded'\n618:           ? 'degraded'\n619:           : 'fail_open',\n620:     };\n621:   }\n622:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n623:     return { fallbackCase: 'skipped' };\n624:   }\n625:   return { fallbackCase: 'no-match' };\n626: }\n627: \n628: /** Render the fallback status and directive block when no advisor brief is available. */\n629: export function renderAdvisorFallbackDirective(\n630:   options: AdvisorBriefRenderOptions = {},\n631:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n632: ): string {\n633:   const classification = advisorFallbackCase(result);\n634:   const head = classification.fallbackCase === 'outage'\n635:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n636:     : classification.fallbackCase === 'skipped'\n637:       ? 'Advisor: prompt skipped.'\n638:       : options.setupWording === true\n639:         ? `Advisor: no skill matched.${SETUP_HINT}`\n640:         : 'Advisor: no skill matched.';\n641:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n642:   observeAdvisorPolicy(rendered, options);\n643:   return rendered;\n644: }\n645: \n646: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n647: export function renderAdvisorTimeoutFallback(\n648:   options: AdvisorBriefRenderOptions = {},\n649:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n650: ): string {\n651:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n652: }\n653: \n654: export { sanitizeSkillLabel };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 1-654\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Brief Renderer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { canonicalFold } from './shared/unicode-normalization.js';\n6: import { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n7: import {\n8:   buildAdvisorRenderPlan,\n9:   evaluateDeliveryState,\n10:   isObservedDeliveryReceipt,\n11:   observeRenderedAdvisorPolicy,\n12:   POLICY_COMMENT_HYGIENE_ID,\n13:   recordObservedPolicyDelivery,\n14:   ROUTE_ADVISOR_ID,\n15:   SHADOW_DELIVERY_STATE_MACHINE,\n16:   type DeliveryStateMachine,\n17:   type DeliveryStateReceipt,\n18:   type DeliveryStateName,\n19:   type DeliveryStateSignals,\n20: } from './policy-plan.js';\n21: import { commandRowFor } from './command-attach.js';\n22: import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n23: import type { AdvisorRecommendation } from './subprocess.js';\n24: import type { AdvisorScoredRecommendation } from './scorer/types.js';\n25: import type { AdvisorHookResult } from './skill-advisor-brief.js';\n26: \n27: // ───────────────────────────────────────────────────────────────\n28: // 1. TYPES\n29: // ───────────────────────────────────────────────────────────────\n30: \n31: export interface AdvisorBriefRenderOptions {\n32:   readonly tokenCap?: number;\n33:   readonly thresholdConfig?: {\n34:     readonly confidenceThreshold?: number;\n35:     readonly uncertaintyThreshold?: number;\n36:     readonly confidenceOnly?: boolean;\n37:   };\n38:   readonly deliveryState?: ShadowDeliveryRenderOptions;\n39:   /**\n40:    * True when prompts use set up, set-up or setup wording, install or reinstall wording\n41:    * including installation and installer, configure or configuration wording or `check`\n42:    * followed within three words by environment, env, config, hooks, tools, tooling,\n43:    * toolchain or skilled. The renderer never reads prompt text.\n44:    */\n45:   readonly setupWording?: boolean;\n46:   /**\n47:    * True when a dispatched child renders the brief. A child keeps the skill line\n48:    * but a command it must not start alone renders as parent-named only. Defaults\n49:    * to `AI_SESSION_CHILD === '1'`.\n50:    */\n51:   readonly childSession?: boolean;\n52: }\n53: \n54: export interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n55:   readonly runtime?: string;\n56:   readonly candidate?: string | null;\n57:   readonly stateMachine?: DeliveryStateMachine;\n58:   readonly deliveryConfirmed?: boolean;\n59:   readonly receipt?: DeliveryStateReceipt;\n60:   readonly transformMessageIdentity?: string | null;\n61:   readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n62: }\n63: \n64: export interface ShadowRouteOnlyLogRecord {\n65:   readonly shadowId: string;\n66:   readonly sessionKnown: boolean;\n67:   readonly epoch: number;\n68:   readonly policySetHash: string;\n69:   readonly routeState: DeliveryStateName | null;\n70:   readonly emittedByteCount: number;\n71:   readonly routeOnlyByteCount: number;\n72:   readonly savedBytes: number;\n73: }\n74: \n75: export interface AdvisorBriefRenderableResult {\n76:   readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n77:   readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n78:   readonly recommendations: readonly AdvisorRecommendation[];\n79:   readonly ambiguous?: boolean;\n80:   readonly metrics?: {\n81:     readonly tokenCap?: number;\n82:   } | null;\n83:   readonly sharedPayload?: {\n84:     readonly metadata?: {\n85:       readonly skillLabel?: string | null;\n86:     } | null;\n87:   } | null;\n88: }\n89: \n90: export type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\n91: export type AdvisorFallbackClassification =\n92:   | {\n93:     readonly fallbackCase: 'outage';\n94:     readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n95:   }\n96:   | {\n97:     readonly fallbackCase: 'no-match' | 'skipped';\n98:   };\n99: \n100: // ───────────────────────────────────────────────────────────────\n101: // 2. CONSTANTS\n102: // ───────────────────────────────────────────────────────────────\n103: \n104: const DEFAULT_TOKEN_CAP = 80;\n105: const AMBIGUOUS_TOKEN_CAP = 120;\n106: const MAX_TOKEN_CAP = 120;\n107: const TOKEN_TO_CHAR_ESTIMATE = 4;\n108: const INSTRUCTION_LABEL_PATTERN =\n109:   /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\n110: const CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\n111: const ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\n112: const OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\n113: const PARENT_NAMED_POLICY = 'parent-named only';\n114: export const ROUTE_ONLY_ESTIMATED_BYTES = 43;\n115: const MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n116: \n117: function directiveBlockIds(): readonly string[] {\n118:   return Object.freeze([\n119:     POLICY_COMMENT_HYGIENE_ID,\n120:   ]);\n121: }\n122: \n123: const SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n124: \n125: // Injected into every advisor brief so all hook-capable runtimes receive\n126: // the comment hygiene rule even when AGENTS.md is absent from session context.\n127: export const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n128: \n129: \n130: \n131: // Labels the directive block so injected content reads as one structured\n132: // capsule instead of loose lines.\n133: export const DIRECTIVES_LABEL = '\\nDirectives:';\n134: \n135: // One bounded sentence for a setup-shaped prompt that matched nothing, so the\n136: // reader learns the read-only overview exists without every miss paying for it.\n137: export const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n138: \n139: // ───────────────────────────────────────────────────────────────\n140: // 3. HELPERS\n141: // ───────────────────────────────────────────────────────────────\n142: \n143: function clampTokenCap(tokenCap: number | undefined): number {\n144:   if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n145:     return DEFAULT_TOKEN_CAP;\n146:   }\n147:   return Math.min(Math.max(1, Math.floor(tokenCap)), MAX_TOKEN_CAP);\n148: }\n149: \n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   // A hub that withheld its mode must not regress to the command its generated\n225:   // row names, because that command is the mode the reader has not chosen yet.\n226:   const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n227:   const command = recommendation.command ?? row?.command;\n228:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n229:   const policy = recommendation.policy ?? row?.policy;\n230:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n231:   const ownerPart = sanitizeSkillLabel(owner);\n232:   if (!commandPart || !ownerPart) {\n233:     return null;\n234:   }\n235:   const policyPart = policyWord(policy, row?.mutating, childSession);\n236:   return policyPart === null\n237:     ? `${ownerPart} → ${commandPart}`\n238:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n239: }\n240: \n241: // A doctor bridge renders as its runnable command and never as its raw id; an\n242: // unmapped doctor id renders nothing.\n243: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n244:   return commandLabel(recommendation, childSession)\n245:     ?? (isDoctorBridgeId(recommendation.skill)\n246:       ? doctorCommandString(recommendation.skill)\n247:       : sanitizeSkillLabel(recommendation.skill));\n248: }\n249: \n250: // The companion line normally shows only the runnable command. A child gets the\n251: // downgrade marker appended because that command must not be started there.\n252: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n253:   const command = doctorCommandString(skillId);\n254:   if (command === null) {\n255:     return null;\n256:   }\n257:   const row = commandRowFor(skillId);\n258:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n259:     ? `${command} (${PARENT_NAMED_POLICY})`\n260:     : command;\n261: }\n262: \n263: function formatScore(value: number): string {\n264:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n265: }\n266: \n267: type RenderableRecommendation = AdvisorRecommendation & {\n268:   readonly score?: number;\n269:   readonly ambiguousWith?: readonly string[];\n270:   readonly heldBelow?: string;\n271: };\n272: \n273: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n274:   return {\n275:     skill: recommendation.skill,\n276:     kind: recommendation.kind === 'command' ? 'command' : 'skill',\n277:     confidence: recommendation.confidence,\n278:     uncertainty: recommendation.uncertainty,\n279:     passes_threshold: recommendation.passes_threshold ?? true,\n280:     reason: '',\n281:     score: typeof recommendation.score === 'number' && Number.isFinite(recommendation.score)\n282:       ? recommendation.score\n283:       : recommendation.confidence,\n284:     laneContributions: [],\n285:     dominantLane: null,\n286:     lifecycleStatus: 'active',\n287:     ...(Array.isArray(recommendation.ambiguousWith) ? { ambiguousWith: recommendation.ambiguousWith } : {}),\n288:     ...(typeof recommendation.heldBelow === 'string' ? { heldBelow: recommendation.heldBelow } : {}),\n289:   };\n290: }\n291: \n292: /**\n293:  * Detect whether the renderable recommendation set carries ambiguity evidence.\n294:  *\n295:  * `precomputedAmbiguous` carries the scorer's own verdict. It wins when defined: the\n296:  * scorer knows which skills a typed command held below the top and which only cleared\n297:  * a confidence floor, and serialized recommendations lose that context. Only when the\n298:  * caller has no verdict is ambiguity re-derived from the rendered fields.\n299:  */\n300: export function hasAdvisorAmbiguitySignal(\n301:   recommendations: readonly AdvisorRecommendation[],\n302:   precomputedAmbiguous?: boolean,\n303: ): boolean {\n304:   if (typeof precomputedAmbiguous === 'boolean') {\n305:     return precomputedAmbiguous;\n306:   }\n307:   return isAmbiguousTopTwo((recommendations as readonly RenderableRecommendation[]).map(toScoredRecommendation));\n308: }\n309: \n310: function metadataSkillLabel(result: AdvisorBriefRenderableResult): string | null {\n311:   const metadata = result.sharedPayload?.metadata;\n312:   return typeof metadata?.skillLabel === 'string' ? metadata.skillLabel : null;\n313: }\n314: \n315: /** Return only the advisor route block that the shadow path would retain. */\n316: export function renderRouteOnlyAdvisorBrief(rendered: string | null): string | null {\n317:   const routeBlock = buildAdvisorRenderPlan(rendered).blocks.find((block) => (\n318:     block.id === ROUTE_ADVISOR_ID\n319:   ));\n320:   return routeBlock?.content ?? null;\n321: }\n322: \n323: /** Read the append-only in-process shadow log without exposing route content. */\n324: export function getShadowRouteOnlyLog(): readonly ShadowRouteOnlyLogRecord[] {\n325:   return Object.freeze(SHADOW_ROUTE_ONLY_LOG.map((record) => ({ ...record })));\n326: }\n327: \n328: /** Clear shadow log entries between isolated evaluations. */\n329: export function clearShadowRouteOnlyLog(): void {\n330:   SHADOW_ROUTE_ONLY_LOG.length = 0;\n331: }\n332: \n333: function stateSignalsForBlock(options: ShadowDeliveryRenderOptions): ShadowDeliveryRenderOptions {\n334:   return {\n335:     ...options,\n336:     lifecycleEvent: undefined,\n337:     scopeChanged: false,\n338:     policySetChanged: false,\n339:     goalChanged: false,\n340:   };\n341: }\n342: \n343: function pushShadowRouteOnlyLog(record: ShadowRouteOnlyLogRecord): void {\n344:   if (SHADOW_ROUTE_ONLY_LOG.length >= MAX_SHADOW_ROUTE_ONLY_LOG) {\n345:     SHADOW_ROUTE_ONLY_LOG.shift();\n346:   }\n347:   SHADOW_ROUTE_ONLY_LOG.push(record);\n348: }\n349: \n350: function directiveBlocksSuppressed(\n351:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n352:   decisions: readonly ReturnType<typeof evaluateDeliveryState>[],\n353: ): boolean {\n354:   for (const expectedId of directiveBlockIds()) {\n355:     const blockIndex = plan.blocks.findIndex((block) => block.id === expectedId);\n356:     if (blockIndex === -1) {\n357:       return false;\n358:     }\n359:     const decision = decisions[blockIndex];\n360:     if (!decision || decision.state !== 'SUPPRESSED_SAME') {\n361:       return false;\n362:     }\n363:   }\n364:   return true;\n365: }\n366: \n367: function recordObservedBlockDeliveries(\n368:   plan: ReturnType<typeof buildAdvisorRenderPlan>,\n369:   shadowOptions: ShadowDeliveryRenderOptions,\n370:   machine: DeliveryStateMachine,\n371:   epoch: number,\n372: ): void {\n373:   const blockOptions = stateSignalsForBlock(shadowOptions);\n374:   for (const block of plan.blocks) {\n375:     const receipt = shadowOptions.receipt;\n376:     if (!isObservedDeliveryReceipt(receipt, block.contentHash, epoch)) {\n377:       continue;\n378:     }\n379:     machine.recordDelivery({\n380:       ...blockOptions,\n381:       blockId: block.id,\n382:       contentHash: block.contentHash,\n383:       receipt,\n384:     });\n385:   }\n386: }\n387: \n388: function observeShadowRouteOnly(\n389:   rendered: string | null,\n390:   options: ShadowDeliveryRenderOptions | undefined,\n391: ): void {\n392:   try {\n393:     const plan = buildAdvisorRenderPlan(rendered);\n394:     const shadowOptions = options ?? {};\n395:     const machine = shadowOptions.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n396:     const epochSnapshot = machine.advanceForSignals(shadowOptions);\n397:     const blockOptions = stateSignalsForBlock(shadowOptions);\n398:     const decisions = plan.blocks.map((block) => evaluateDeliveryState({\n399:       ...blockOptions,\n400:       blockId: block.id,\n401:       contentHash: block.contentHash,\n402:     }, machine));\n403: \n404:     recordObservedBlockDeliveries(plan, shadowOptions, machine, epochSnapshot.epoch);\n405: \n406:     const routeIndex = plan.blocks.findIndex((block) => block.id === ROUTE_ADVISOR_ID);\n407:     const routeDecision = routeIndex === -1 ? null : decisions[routeIndex] ?? null;\n408:     const routeOnlyEligible = Boolean(\n409:       routeDecision?.routeOnlyEligible && directiveBlocksSuppressed(plan, decisions),\n410:     );\n411:     const routeOnly = routeOnlyEligible\n412:       ? renderRouteOnlyAdvisorBrief(rendered)\n413:       : null;\n414:     const emittedByteCount = rendered === null ? 0 : Buffer.byteLength(rendered, 'utf8');\n415:     const routeOnlyByteCount = routeOnly === null ? 0 : Buffer.byteLength(routeOnly, 'utf8');\n416:     const savedBytes = routeOnly === null\n417:       ? 0\n418:       : Math.max(0, emittedByteCount - routeOnlyByteCount);\n419:     const record: ShadowRouteOnlyLogRecord = Object.freeze({\n420:       shadowId: ROUTE_ONLY_SHADOW_ID,\n421:       sessionKnown: routeDecision?.sessionKnown ?? epochSnapshot.sessionKnown,\n422:       epoch: routeDecision?.epoch ?? epochSnapshot.epoch,\n423:       policySetHash: plan.policySetHash,\n424:       routeState: routeDecision?.state ?? null,\n425:       emittedByteCount,\n426:       routeOnlyByteCount,\n427:       savedBytes,\n428:     });\n429:     pushShadowRouteOnlyLog(record);\n430:     try {\n431:       options?.onShadowLog?.(record);\n432:     } catch {\n433:       // Observer callbacks must never affect the rendered advisor bytes.\n434:     }\n435:   } catch {\n436:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n437:   }\n438: }\n439: \n440: function observeAdvisorPolicy(\n441:   rendered: string | null,\n442:   options: AdvisorBriefRenderOptions = {},\n443: ): void {\n444:   try {\n445:     observeRenderedAdvisorPolicy(rendered);\n446:   } catch {\n447:     // Shadow measurement is fail-open so a throwing observer cannot block delivery.\n448:   }\n449:   observeShadowRouteOnly(rendered, options.deliveryState);\n450: }\n451: \n452: /** Run the shadow planner for a runtime callback without changing its output. */\n453: export function observeShadowDelivery(\n454:   rendered: string | null,\n455:   deliveryState: ShadowDeliveryRenderOptions = {},\n456: ): void {\n457:   observeAdvisorPolicy(rendered, { deliveryState });\n458: }\n459: \n460: /**\n461:  * Record host-observed policy blocks after the runtime places them into the\n462:  * emitted response. Fail-open: recording errors never change emitted bytes.\n463:  */\n464: export function observeEmittedAdvisorPolicy(\n465:   rendered: string | null,\n466:   deliveryState: ShadowDeliveryRenderOptions = {},\n467: ): void {\n468:   try {\n469:     if (typeof rendered !== 'string' || rendered.length === 0) {\n470:       return;\n471:     }\n472:     const runtime = typeof deliveryState.runtime === 'string' && deliveryState.runtime.length > 0\n473:       ? deliveryState.runtime\n474:       : 'unknown';\n475:     const machine = deliveryState.stateMachine ?? SHADOW_DELIVERY_STATE_MACHINE;\n476:     const epoch = machine.currentEpoch(deliveryState);\n477:     const plan = buildAdvisorRenderPlan(rendered);\n478:     for (const block of plan.blocks) {\n479:       recordObservedPolicyDelivery({\n480:         runtime,\n481:         candidate: deliveryState.candidate ?? OBSERVED_ADVISOR_POLICY_CANDIDATE,\n482:         blockId: block.id,\n483:         content: block.content,\n484:         contentHash: block.contentHash,\n485:         lifecycleEpoch: epoch,\n486:         sessionId: deliveryState.sessionId,\n487:         sessionIdentity: deliveryState.sessionIdentity,\n488:         sessionIdentityConfirmed: deliveryState.sessionIdentityConfirmed,\n489:         sessionIdentityAmbiguous: deliveryState.sessionIdentityAmbiguous,\n490:         transformMessageIdentity: deliveryState.transformMessageIdentity ?? null,\n491:       });\n492:     }\n493:   } catch {\n494:     // Host observation is fail-open so a throwing sink cannot affect delivery.\n495:   }\n496: }\n497: \n498: // ───────────────────────────────────────────────────────────────\n499: // 4. CORE LOGIC\n500: // ───────────────────────────────────────────────────────────────\n501: \n502: /**\n503:  * Render the model-visible advisor brief from typed advisor output only.\n504:  *\n505:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n506:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n507:  * repository-authored skill label looks instruction-shaped after folding.\n508:  */\n509: export function renderAdvisorBrief(\n510:   result: AdvisorBriefRenderableResult,\n511:   options: AdvisorBriefRenderOptions = {},\n512: ): string | null {\n513:   if (result.status !== 'ok') {\n514:     observeAdvisorPolicy(null, options);\n515:     return null;\n516:   }\n517:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n518:     observeAdvisorPolicy(null, options);\n519:     return null;\n520:   }\n521: \n522:   const tokenCap = clampTokenCap(result.metrics?.tokenCap ?? options.tokenCap);\n523:   const thresholdConfig = options.thresholdConfig;\n524:   const childSession = options.childSession ?? process.env.AI_SESSION_CHILD === '1';\n525:   const recommendations = result.recommendations.filter((recommendation) => (\n526:     recommendation.passes_threshold === true\n527:     || (\n528:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n529:       && (\n530:         thresholdConfig?.confidenceOnly === true\n531:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n532:       )\n533:     )\n534:   ));\n535:   const [top, second] = recommendations;\n536:   if (!top) {\n537:     observeAdvisorPolicy(null, options);\n538:     return null;\n539:   }\n540: \n541:   const topLabel = commandLabel(top, childSession)\n542:     ?? (isDoctorBridgeId(top.skill)\n543:       ? doctorCommandString(top.skill)\n544:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n545:   if (!topLabel) {\n546:     observeAdvisorPolicy(null, options);\n547:     return null;\n548:   }\n549: \n550:   // A hub that withheld its command because the prompt names no single mode says\n551:   // so, so the reader asks for the mode instead of improvising one.\n552:   const headLabel = top.needsMode === true && top.command === undefined\n553:     ? `${topLabel} (needs a mode)`\n554:     : topLabel;\n555: \n556:   const companion = isDoctorBridgeId(top.skill)\n557:     ? undefined\n558:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n559:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n560:   const companionLine = (shownSecond: string | undefined): string => (\n561:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n562:   );\n563:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n564:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n565:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n566:   };\n567: \n568:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n569:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n570:     // The scorer names its own tie partners, which can sit below the second passing\n571:     // entry, so prefer a named partner and fall back to the second entry.\n572:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n573:     const ambiguousWith: readonly string[] = Array.isArray(namedPartners) ? namedPartners : [];\n574:     const vs = (ambiguousWith.length > 0\n575:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n576:       : undefined) ?? second;\n577:     const vsLabel = recommendationLabel(vs, childSession);\n578:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n579:       observeAdvisorPolicy(null, options);\n580:       return null;\n581:     }\n582:     if (vsLabel) {\n583:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n584:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n585:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n586:       const rendered = capWithCompanion(\n587:         head,\n588:         companionLine(vs.skill),\n589:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n590:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n591:       observeAdvisorPolicy(rendered, options);\n592:       return rendered;\n593:     }\n594:   }\n595: \n596:   const head = `Advisor: ${result.freshness}; use ${headLabel} `\n597:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n598:   const rendered = capWithCompanion(\n599:     head,\n600:     companionLine(undefined),\n601:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n602:   ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n603:   observeAdvisorPolicy(rendered, options);\n604:   return rendered;\n605: }\n606: \n607: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n608: export function advisorFallbackCase(\n609:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n610: ): AdvisorFallbackClassification {\n611:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n612:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n613:     return {\n614:       fallbackCase: 'outage',\n615:       outageLabel: result?.freshness === 'absent'\n616:         ? 'absent'\n617:         : result?.status === 'degraded'\n618:           ? 'degraded'\n619:           : 'fail_open',\n620:     };\n621:   }\n622:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n623:     return { fallbackCase: 'skipped' };\n624:   }\n625:   return { fallbackCase: 'no-match' };\n626: }\n627: \n628: /** Render the fallback status and directive block when no advisor brief is available. */\n629: export function renderAdvisorFallbackDirective(\n630:   options: AdvisorBriefRenderOptions = {},\n631:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n632: ): string {\n633:   const classification = advisorFallbackCase(result);\n634:   const head = classification.fallbackCase === 'outage'\n635:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n636:     : classification.fallbackCase === 'skipped'\n637:       ? 'Advisor: prompt skipped.'\n638:       : options.setupWording === true\n639:         ? `Advisor: no skill matched.${SETUP_HINT}`\n640:         : 'Advisor: no skill matched.';\n641:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n642:   observeAdvisorPolicy(rendered, options);\n643:   return rendered;\n644: }\n645: \n646: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n647: export function renderAdvisorTimeoutFallback(\n648:   options: AdvisorBriefRenderOptions = {},\n649:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n650: ): string {\n651:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n652: }\n653: \n654: export { sanitizeSkillLabel };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\"}"},"time":{"start":1794559121777,"end":1794559122600}}}}
