{"type":"tool_use","timestamp":1794558756008,"sessionID":"ses_e2bf771b7ffeH0MBS4KaNsCAC0","part":{"partID":"prt_1d40982f0001aexx5XrKmvNOGh","sessionID":"ses_e2bf771b7ffeH0MBS4KaNsCAC0","messageID":"msg_1d40979f8001h0VX3OI35kvarz","type":"tool","id":"call_64e78460021e4010bfcba1f1","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/dsh/prompt-advisor.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/dsh/prompt-advisor.mjs, lines 1-186\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Prompt Advisor Adapter\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // ─────────────────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ─────────────────────────────────────────────────────────────────────────────\n8: \n9: import { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\n10: import { loadDshLlm } from '../../../../hooks/shared/dsh/dsh-llm.mjs';\n11: import { isLineageLeaf } from '../../../../hooks/shared/dsh/session-role.mjs';\n12: \n13: // ─────────────────────────────────────────────────────────────────────────────\n14: // 2. CONSTANTS\n15: // ─────────────────────────────────────────────────────────────────────────────\n16: \n17: const ADVISOR_MODULE_URL = new URL(\n18:   '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n19:   import.meta.url,\n20: ).href;\n21: \n22: // Mirrors the advisor renderer's directive label. A brief that drifts past it is\n23: // never split, so it is always delivered whole.\n24: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n25: const MAX_TRACKED_SESSIONS = 64;\n26: const RECEIPTS = Symbol.for('skilled.repo-guards.directive-receipts');\n27: \n28: export const ERROR_POLICY = 'fail-open';\n29: // The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\n30: export const ADVISOR_RUNTIME = 'dsh';\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 3. HELPERS\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: function contentText(content) {\n37:   if (typeof content === 'string') return content;\n38:   if (!Array.isArray(content)) return '';\n39:   return content.map((part) => typeof part === 'string' ? part : part?.text)\n40:     .filter((text) => typeof text === 'string').join('\\n');\n41: }\n42: \n43: // Guard advisories and runtime-context snapshots also arrive as user-role messages,\n44: // so only a message the operator typed counts as the prompt.\n45: function latestOperatorPrompt(messages) {\n46:   if (!Array.isArray(messages)) return '';\n47:   for (let index = messages.length - 1; index >= 0; index -= 1) {\n48:     const message = messages[index];\n49:     if (message?.role === 'user' && message.source?.kind === 'user') return contentText(message.content);\n50:   }\n51:   return '';\n52: }\n53: \n54: function receipts() {\n55:   globalThis[RECEIPTS] ??= new Map();\n56:   return globalThis[RECEIPTS];\n57: }\n58: \n59: function forgetReceipt(sessionId) {\n60:   if (typeof sessionId === 'string' && sessionId) receipts().delete(sessionId);\n61: }\n62: \n63: function splitBrief(context) {\n64:   const index = context.indexOf(DIRECTIVE_SEPARATOR);\n65:   if (index > 0) return { head: context.slice(0, index), directives: context.slice(index) };\n66:   const label = DIRECTIVE_SEPARATOR.slice(1);\n67:   if (context.startsWith(label)) return { head: '', directives: context };\n68:   return null;\n69: }\n70: \n71: /**\n72:  * Deliver the directive block once per lifecycle epoch: in full the first time,\n73:  * and as the routing head alone while the same block is still in context. An\n74:  * unknown session, an unsplittable brief or a changed block gets the full text.\n75:  */\n76: function deliveredContext(context, sessionId, dedupEnabled) {\n77:   const parts = splitBrief(context);\n78:   if (!dedupEnabled || !parts || typeof sessionId !== 'string' || !sessionId) return context;\n79:   const store = receipts();\n80:   if (store.get(sessionId) === parts.directives) return parts.head.trim();\n81:   if (!store.has(sessionId) && store.size >= MAX_TRACKED_SESSIONS) store.delete(store.keys().next().value);\n82:   store.set(sessionId, parts.directives);\n83:   return context;\n84: }\n85: \n86: function concernEnabled(isEnabled, concern) {\n87:   try {\n88:     return isEnabled(concern) !== false;\n89:   } catch {\n90:     return true;\n91:   }\n92: }\n93: \n94: function logFailure(ctx, error) {\n95:   try {\n96:     ctx.logger.warn(`repo-guards prompt-advisor: ${String(error)}`);\n97:   } catch {\n98:     return undefined;\n99:   }\n100:   return undefined;\n101: }\n102: \n103: async function makeNotice(text) {\n104:   const { createUserMessage } = await loadDshLlm();\n105:   return createUserMessage({\n106:     content: [{ type: 'text', text }],\n107:     source: { kind: 'repo-guards' },\n108:   });\n109: }\n110: \n111: // ─────────────────────────────────────────────────────────────────────────────\n112: // 4. CORE LOGIC\n113: // ─────────────────────────────────────────────────────────────────────────────\n114: \n115: /**\n116:  * Run the shared advisor hook for one operator prompt under the DSH runtime label.\n117:  *\n118:  * @param {Object} input - The UserPromptSubmit-shaped input.\n119:  * @param {Function} [load] - Loads the advisor module, injectable for tests.\n120:  * @returns {Promise<Object>} The advisor hook output.\n121:  */\n122: export async function runAdvisor(input, load = () => import(ADVISOR_MODULE_URL)) {\n123:   const advisor = await load();\n124:   return advisor.handleClaudeUserPromptSubmit(input, {\n125:     runtime: ADVISOR_RUNTIME,\n126:     writeDiagnostic: () => {},\n127:   });\n128: }\n129: \n130: /**\n131:  * Register the advisor brief on the DSH pre-step waterfall for interactive sessions.\n132:  *\n133:  * A fan-out leaf, marked by the lineage patch, gets no brief: its prompt is a fixed\n134:  * task, so a route suggestion is noise. The directive block follows the shared\n135:  * directive-lifecycle contract: once per session start or compaction.\n136:  *\n137:  * @param {Object} ctx - dsh plugin context with `on` and `logger`.\n138:  * @param {Object} [options] - Row flag and dependencies for deterministic tests.\n139:  */\n140: export function registerPromptAdvisor(ctx, {\n141:   enabled = false,\n142:   core = { runAdvisor },\n143:   createNotice = makeNotice,\n144:   isLeaf = isLineageLeaf,\n145:   isEnabled = isHookEnabled,\n146: } = {}) {\n147:   if (enabled !== true) return;\n148: \n149:   ctx.on('agent/created', async ({ agent }) => {\n150:     forgetReceipt(agent?.session?.id);\n151:     return undefined;\n152:   });\n153: \n154:   ctx.on('session/event', (session, event) => {\n155:     if (event?.type === 'compaction/end' && !event.data?.error) forgetReceipt(session?.id);\n156:   });\n157: \n158:   ctx.on('agent/pre-step', async (payload, next) => {\n159:     const downstream = await next();\n160:     if (downstream.kind !== 'enter' || isLeaf()) return downstream;\n161: \n162:     try {\n163:       const prompt = latestOperatorPrompt(payload.messages);\n164:       if (!prompt.trim()) return downstream;\n165: \n166:       const agent = payload.agent;\n167:       const projectDir = agent?.session?.header?.cwd ?? process.cwd();\n168:       const output = await core.runAdvisor({\n169:         prompt,\n170:         cwd: projectDir,\n171:         session_id: agent?.session?.id,\n172:         hook_event_name: 'UserPromptSubmit',\n173:       });\n174:       const context = output?.hookSpecificOutput?.additionalContext;\n175:       if (typeof context !== 'string' || !context.trim()) return downstream;\n176: \n177:       const delivered = deliveredContext(context, agent?.session?.id, concernEnabled(isEnabled, 'directive-lifecycle'));\n178:       if (!delivered) return downstream;\n179:       const notice = await createNotice(delivered);\n180:       return { ...downstream, messages: [...(downstream.messages ?? []), notice] };\n181:     } catch (error) {\n182:       logFailure(ctx, error);\n183:       return downstream;\n184:     }\n185:   });\n186: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/dsh/prompt-advisor.mjs, lines 1-186\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Prompt Advisor Adapter\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: // ─────────────────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ─────────────────────────────────────────────────────────────────────────────\n8: \n9: import { isHookEnabled } from '../../../../hooks/shared/hook-flags.mjs';\n10: import { loadDshLlm } from '../../../../hooks/shared/dsh/dsh-llm.mjs';\n11: import { isLineageLeaf } from '../../../../hooks/shared/dsh/session-role.mjs';\n12: \n13: // ─────────────────────────────────────────────────────────────────────────────\n14: // 2. CONSTANTS\n15: // ─────────────────────────────────────────────────────────────────────────────\n16: \n17: const ADVISOR_MODULE_URL = new URL(\n18:   '../../runtime/dist/hooks/claude/user-prompt-submit.js',\n19:   import.meta.url,\n20: ).href;\n21: \n22: // Mirrors the advisor renderer's directive label. A brief that drifts past it is\n23: // never split, so it is always delivered whole.\n24: const DIRECTIVE_SEPARATOR = '\\nDirectives:';\n25: const MAX_TRACKED_SESSIONS = 64;\n26: const RECEIPTS = Symbol.for('skilled.repo-guards.directive-receipts');\n27: \n28: export const ERROR_POLICY = 'fail-open';\n29: // The advisor keys its metrics and outcome records by runtime and drops a label it does not list.\n30: export const ADVISOR_RUNTIME = 'dsh';\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 3. HELPERS\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: function contentText(content) {\n37:   if (typeof content === 'string') return content;\n38:   if (!Array.isArray(content)) return '';\n39:   return content.map((part) => typeof part === 'string' ? part : part?.text)\n40:     .filter((text) => typeof text === 'string').join('\\n');\n41: }\n42: \n43: // Guard advisories and runtime-context snapshots also arrive as user-role messages,\n44: // so only a message the operator typed counts as the prompt.\n45: function latestOperatorPrompt(messages) {\n46:   if (!Array.isArray(messages)) return '';\n47:   for (let index = messages.length - 1; index >= 0; index -= 1) {\n48:     const message = messages[index];\n49:     if (message?.role === 'user' && message.source?.kind === 'user') return contentText(message.content);\n50:   }\n51:   return '';\n52: }\n53: \n54: function receipts() {\n55:   globalThis[RECEIPTS] ??= new Map();\n56:   return globalThis[RECEIPTS];\n57: }\n58: \n59: function forgetReceipt(sessionId) {\n60:   if (typeof sessionId === 'string' && sessionId) receipts().delete(sessionId);\n61: }\n62: \n63: function splitBrief(context) {\n64:   const index = context.indexOf(DIRECTIVE_SEPARATOR);\n65:   if (index > 0) return { head: context.slice(0, index), directives: context.slice(index) };\n66:   const label = DIRECTIVE_SEPARATOR.slice(1);\n67:   if (context.startsWith(label)) return { head: '', directives: context };\n68:   return null;\n69: }\n70: \n71: /**\n72:  * Deliver the directive block once per lifecycle epoch: in full the first time,\n73:  * and as the routing head alone while the same block is still in context. An\n74:  * unknown session, an unsplittable brief or a changed block gets the full text.\n75:  */\n76: function deliveredContext(context, sessionId, dedupEnabled) {\n77:   const parts = splitBrief(context);\n78:   if (!dedupEnabled || !parts || typeof sessionId !== 'string' || !sessionId) return context;\n79:   const store = receipts();\n80:   if (store.get(sessionId) === parts.directives) return parts.head.trim();\n81:   if (!store.has(sessionId) && store.size >= MAX_TRACKED_SESSIONS) store.delete(store.keys().next().value);\n82:   store.set(sessionId, parts.directives);\n83:   return context;\n84: }\n85: \n86: function concernEnabled(isEnabled, concern) {\n87:   try {\n88:     return isEnabled(concern) !== false;\n89:   } catch {\n90:     return true;\n91:   }\n92: }\n93: \n94: function logFailure(ctx, error) {\n95:   try {\n96:     ctx.logger.warn(`repo-guards prompt-advisor: ${String(error)}`);\n97:   } catch {\n98:     return undefined;\n99:   }\n100:   return undefined;\n101: }\n102: \n103: async function makeNotice(text) {\n104:   const { createUserMessage } = await loadDshLlm();\n105:   return createUserMessage({\n106:     content: [{ type: 'text', text }],\n107:     source: { kind: 'repo-guards' },\n108:   });\n109: }\n110: \n111: // ─────────────────────────────────────────────────────────────────────────────\n112: // 4. CORE LOGIC\n113: // ─────────────────────────────────────────────────────────────────────────────\n114: \n115: /**\n116:  * Run the shared advisor hook for one operator prompt under the DSH runtime label.\n117:  *\n118:  * @param {Object} input - The UserPromptSubmit-shaped input.\n119:  * @param {Function} [load] - Loads the advisor module, injectable for tests.\n120:  * @returns {Promise<Object>} The advisor hook output.\n121:  */\n122: export async function runAdvisor(input, load = () => import(ADVISOR_MODULE_URL)) {\n123:   const advisor = await load();\n124:   return advisor.handleClaudeUserPromptSubmit(input, {\n125:     runtime: ADVISOR_RUNTIME,\n126:     writeDiagnostic: () => {},\n127:   });\n128: }\n129: \n130: /**\n131:  * Register the advisor brief on the DSH pre-step waterfall for interactive sessions.\n132:  *\n133:  * A fan-out leaf, marked by the lineage patch, gets no brief: its prompt is a fixed\n134:  * task, so a route suggestion is noise. The directive block follows the shared\n135:  * directive-lifecycle contract: once per session start or compaction.\n136:  *\n137:  * @param {Object} ctx - dsh plugin context with `on` and `logger`.\n138:  * @param {Object} [options] - Row flag and dependencies for deterministic tests.\n139:  */\n140: export function registerPromptAdvisor(ctx, {\n141:   enabled = false,\n142:   core = { runAdvisor },\n143:   createNotice = makeNotice,\n144:   isLeaf = isLineageLeaf,\n145:   isEnabled = isHookEnabled,\n146: } = {}) {\n147:   if (enabled !== true) return;\n148: \n149:   ctx.on('agent/created', async ({ agent }) => {\n150:     forgetReceipt(agent?.session?.id);\n151:     return undefined;\n152:   });\n153: \n154:   ctx.on('session/event', (session, event) => {\n155:     if (event?.type === 'compaction/end' && !event.data?.error) forgetReceipt(session?.id);\n156:   });\n157: \n158:   ctx.on('agent/pre-step', async (payload, next) => {\n159:     const downstream = await next();\n160:     if (downstream.kind !== 'enter' || isLeaf()) return downstream;\n161: \n162:     try {\n163:       const prompt = latestOperatorPrompt(payload.messages);\n164:       if (!prompt.trim()) return downstream;\n165: \n166:       const agent = payload.agent;\n167:       const projectDir = agent?.session?.header?.cwd ?? process.cwd();\n168:       const output = await core.runAdvisor({\n169:         prompt,\n170:         cwd: projectDir,\n171:         session_id: agent?.session?.id,\n172:         hook_event_name: 'UserPromptSubmit',\n173:       });\n174:       const context = output?.hookSpecificOutput?.additionalContext;\n175:       if (typeof context !== 'string' || !context.trim()) return downstream;\n176: \n177:       const delivered = deliveredContext(context, agent?.session?.id, concernEnabled(isEnabled, 'directive-lifecycle'));\n178:       if (!delivered) return downstream;\n179:       const notice = await createNotice(delivered);\n180:       return { ...downstream, messages: [...(downstream.messages ?? []), notice] };\n181:     } catch (error) {\n182:       logFailure(ctx, error);\n183:       return downstream;\n184:     }\n185:   });\n186: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/hooks/dsh/prompt-advisor.mjs\"}"},"time":{"start":1794558755568,"end":1794558756008}}}}
