ts/typo-flags.vitest.ts:135:      join(SCRIPTS_DIR, 'routing-accuracy', 'build-holdout.mjs'),\n.skilled/skills/system-skill-advisor/runtime/tests/typo-flags.vitest.ts:145:        join(SCRIPTS_DIR, 'routing-accuracy', 'capture-scorer-eval-baseline.mjs'),\n---VITEST CONFIG---\n// ───────────────────────────────────────────────────────────────\n// MODULE: System Skill Advisor Vitest Config\n// ───────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\n\nconst TEST_TIMEOUT_MS = 30_000;\nconst TEARDOWN_TIMEOUT_MS = 1_000;\nconst INCLUDE_BENCHES = process.env.SPECKIT_RUN_BENCHES === 'true';\n// The stress suites are excluded from the default run because they are slow, not\n// because they are unwanted. Without a way to opt in they were unreachable: no\n// script and no pattern selected them, so 21 files sat in the tree running never.\n// Opting in REPLACES the default set rather than adding to it: these suites churn\n// the daemon, its socket and its lease, and running them beside the ordinary\n// suites fails a handful of those on shared state rather than on their own logic.\nconst INCLUDE_STRESS = process.env.SPECKIT_RUN_STRESS === 'true';\n\n// A plain object export instead of vitest's defineConfig wrapper: the config is\n// loaded by node's own module graph, where a bare `vitest` import resolves to\n// whatever node_modules sits next to this file. CI's routing job runs the suites\n// under a vitest pinned through npx, which can differ from the runtime's own\n// vitest range, so importing from the package here could load a second vitest\n// copy. defineConfig is an identity type-helper; dropping it changes nothing at\n// runtime.\nexport default ({\n  root: import.meta.dirname,\n  test: {\n    include: [\n      ...(INCLUDE_STRESS ? ['stress-test/**/*.vitest.ts'] : ['tests/**/*.vitest.ts']),\n      ...(INCLUDE_BENCHES ? ['bench/**/*.bench.ts'] : []),\n    ],\n    exclude: [\n      'node_modules',\n      'dist',\n      ...(INCLUDE_BENCHES ? [] : ['bench/**/*.bench.ts']),\n    ],\n    setupFiles: [\n      path.resolve(import.meta.dirname, '../../system-spec-kit/runtime/tests/_support/vitest-setup.ts'),\n    ],\n    fileParallelism: false,\n    globals: true,\n    environment: 'node',\n    testTimeout: TEST_TIMEOUT_MS,\n    teardownTimeout: TEARDOWN_TIMEOUT_MS,\n    alias: {\n      '@lib': path.resolve(import.meta.dirname, 'lib'),\n    },\n  },\n});\n---TSCONFIG---\n{\n  \"extends\": \"../../system-spec-kit/runtime/tsconfig.json\",\n  \"compilerOptions\": {\n    \"ignoreDeprecations\": \"5.0\",\n    \"outDir\": \"./dist\",\n    \"baseUrl\": \".\",\n    \"typeRoots\": [\n      \"../../system-spec-kit/node_modules/@types\",\n      \"../../system-spec-kit/runtime/node_modules/@types\"\n    ],\n    \"paths\": {\n      \"better-sqlite3\": [\"./types/better-sqlite3.d.ts\"],\n      \"chokidar\": [\"../../system-spec-kit/runtime/node_modules/chokidar/index.d.ts\"],\n      \"vitest/config\": [\"../../system-spec-kit/runtime/node_modules/vitest/config.d.ts\"]\n    }\n  },\n  \"include\": [\"**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\", \"bench\", \"**/__tests__\"]\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts:29:} from '../scripts/routing-accuracy/command-offer.mjs';\n.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts:16:import { scoreCommandCorpus as captureCommandCorpus } from '../scripts/routing-accuracy/capture-command-routing-baseline.mjs';\n.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts:19:const ROUTING = resolve(HERE, '../scripts/routing-accuracy');\n.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts:22:const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n.skilled/skills/system-sk