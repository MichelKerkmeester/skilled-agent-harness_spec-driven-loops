n774: });\n775: \n776: // The empty folder lives beside the run log, so a run leaves its own directory\n777: // behind instead of a path in the operator's home that the next run inherits.\n778: function ghConfigDir(outPath) {\n779:   return join(dirname(outPath), 'gh-config-empty');\n780: }\n781: \n782: export function childEnv(ghConfig) {\n783:   const env = { ...process.env };\n784:   delete env.AI_SESSION_CHILD;\n785:   for (const name of GITHUB_TOKEN_VARS) delete env[name];\n786:   env.GH_CONFIG_DIR = ghConfig;\n787:   env.GIT_TERMINAL_PROMPT = '0';\n788:   Object.assign(env, GIT_CREDENTIAL_OVERRIDES);\n789:   return env;\n790: }\n791: \n792: function spawnTurn(runtime, argv, prompt, capMs, ghConfig) {\n793:   return new Promise((settle) => {\n794:     // A CLI that reads the prompt from stdin gets a pipe to write it into. Every other\n795:     // runtime keeps stdin ignored, because an open stdin leaves that CLI waiting on\n796:     // input nobody types until the cap runs out into an empty transcript.\n797:     const child = spawn(runtime.command, argv, {\n798:       cwd: REPO_ROOT,\n799:       env: childEnv(ghConfig),\n800:       // Ignored means the child reads /dev/null rather than blocking on a terminal.\n801:       stdio: [runtime.promptOnStdin ? 'pipe' : 'ignore', 'pipe', 'inherit'],\n802:       // A chat turn still running after its cap is stuck, while a started workflow\n803:       // legitimately needs the longer one. The prompt decides which it gets.\n804:       timeout: capMs,\n805:     });\n806:     // The prompt is written and the stream closed at once, so a CLI that reads until\n807:     // the end of input sees a whole prompt. A CLI that exits before reading leaves a\n808:     // broken pipe behind, and that write error is the CLI's failure to report rather\n809:     // than an uncaught error that would end the run early.\n810:     if (child.stdin !== null) {\n811:       child.stdin.on('error', () => {});\n812:       child.stdin.end(prompt);\n813:     }\n814:     const locator = streamLocator(runtime.locator.field ?? null);\n815:     // The turn's own output is still shown, and the locator is read out of the\n816:     // same bytes, so watching a run and recording it never diverge.\n817:     child.stdout.setEncoding('utf8');\n818:     child.stdout.on('data', (chunk) => {\n819:       locator.push(chunk);\n820:       process.stdout.write(chunk);\n821:     });\n822:     child.on('error', (error) => settle({ exit: null, error, streamId: null }));\n823:     child.on('close', (exit) => settle({ exit, error: null, streamId: locator.value() }));\n824:   });\n825: }\n826: \n827: // ───────────────────────────────────────────────────────────────\n828: // CLI\n829: // ───────────────────────────────────────────────────────────────\n830: \n831: class UsageError extends Error {}\n832: \n833: const SCRIPT_NAME = 'run-command-behaviour.mjs';\n834: const SAMPLE_PROMPT = 'sample prompt for argv inspection';\n835: const SAMPLE_SESSION_ID = 'sample-session-id';\n836: \n837: // An arm label decides how a later scorer groups a whole log, so a typo would\n838: // quietly invent a third arm. The set is closed for that reason.\n839: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n[Output truncated. Continue reading with offset: 840]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\",\"offset\":740,\"limit\":100}"},"time":{"start":1794559028576,"end":1794559029169}}}}
