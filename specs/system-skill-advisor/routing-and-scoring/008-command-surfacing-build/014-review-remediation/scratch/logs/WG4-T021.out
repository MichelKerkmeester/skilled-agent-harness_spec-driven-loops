n36: `);\n37:     const result = await runAdvisorSubprocess('prompt', {\n38:       workspaceRoot,\n39:       pythonBin: process.execPath,\n40:       scriptPath,\n41:       timeoutMs: 10000,\n42:     });\n43: \n44:     expect(result.errorCode).toBe('JSON_PARSE_FAILED');\n45:   });\n46: \n47:   it('bounds stderr from a child that floods it and exits non-zero', async () => {\n48:     const scriptPath = writeScript(`\n49: process.stdin.resume();\n50: process.stdin.on('end', () => {\n51:   process.stderr.write('e'.repeat(2 * 1024 * 1024));\n52:   process.exitCode = 1;\n53: });\n54: `);\n55:     const result = await runAdvisorSubprocess('prompt', {\n56:       workspaceRoot,\n57:       pythonBin: process.execPath,\n58:       scriptPath,\n59:       timeoutMs: 10000,\n60:     });\n61: \n62:     expect((result.stderr ?? '').length).toBeLessThanOrEqual(MAX_OUTPUT_CHARS);\n63:     expect(result.ok).toBe(false);\n64:   });\n65: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts, lines 1-65\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Subprocess Output Cap Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n9: import { runAdvisorSubprocess } from '../lib/subprocess.js';\n10: \n11: const MAX_OUTPUT_CHARS = 1024 * 1024;\n12: \n13: let workspaceRoot = '';\n14: \n15: function writeScript(source: string): string {\n16:   const path = join(workspaceRoot, 'advisor-child.cjs');\n17:   writeFileSync(path, source, 'utf8');\n18:   return path;\n19: }\n20: \n21: beforeEach(() => {\n22:   works