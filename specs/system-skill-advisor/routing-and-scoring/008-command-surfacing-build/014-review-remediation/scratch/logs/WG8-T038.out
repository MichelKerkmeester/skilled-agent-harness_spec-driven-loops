utside claude, opencode, codex, cursor, devin and pi or the ones already there'));\n+  assert.ok(PRESENTATION.includes('DSH is not offered, because the link manifest has no DSH row.'));\n+  assert.match(WORKFLOW.inputs.runtimes, /DSH is not offered/);\n+});\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 4. THE READ-ONLY WORKFLOW\n // ─────────────────────────────────────────────────────────────────────────────\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/assets/doctor-install-presentation.txt b/.skilled/commands/doctor/assets/doctor-install-presentation.txt\nindex 0d6e07592e..bbc8c02f91 100644\n--- a/.skilled/commands/doctor/assets/doctor-install-presentation.txt\n+++ b/.skilled/commands/doctor/assets/doctor-install-presentation.txt\n@@ -75,7 +75,9 @@ The example carries all four answers so the shape of a full reply is visible. Ne\n | `embed` | step 2 stays | The repo keeps its own `AGENTS.md` and the shipped sections are refreshed into it |\n | `link` | step 1 gains `--link-instructions`, step 2 is dropped | `AGENTS.md`, `CLAUDE.md` and `REPO RULES.md` become links into the checkout |\n \n-A runtime name outside the seven, a shape outside the three, or an instruction word outside the two is not guessed. Ask that one question again with the accepted values. When the engine refuses a root, show its `ERROR:` line as it printed and ask question 1 again.\n+A runtime name outside claude, opencode, codex, cursor, devin and pi or the ones already there, a shape outside the three, or an instruction word outside the two is not guessed. Ask that one question again with the accepted values. When the engine refuses a root, show its `ERROR:` line as it printed and ask question 1 again.\n+\n+DSH is not offered, because the link manifest has no DSH row.\n \n ## 5. The Symlink Check\n \ndiff --git a/.skilled/commands/doctor/assets/doctor-install.yaml b/.skilled/commands/doctor/assets/doctor-install.yaml\nindex 10edf61376..8910d8f702 100644\n--- a/.skilled/commands/doctor/assets/doctor-install.yaml\n+++ b/.skilled/commands/doctor/assets/doctor-install.yaml\n@@ -43,7 +43,7 @@ upstream_assets:\n inputs:\n   target: \"The command takes no positional target. A whole argument of list, ? or menu prints the ordered install steps and stops.\"\n   root: \"The target repository's absolute path, supplied with --root or in the consolidated prompt.\"\n-  runtimes: \"The runtime list, supplied with --runtimes or in the consolidated prompt; the operator can choose the runtimes already there.\"\n+  runtimes: \"The runtime list, supplied with --runtimes or in the consolidated prompt; the operator can choose the runtimes already there. DSH is not offered, because the link manifest has no dsh row.\"\n   link_shape: \"The operator's choice of auto, whole or merge; auto is recommended.\"\n   instruction_choice: \"The operator's choice of embed or link; embed is recommended and keeps the repo's own AGENTS.md.\"\n   json_output: \"True when --json is passed; print one JSON object and nothing else.\"\ndiff --git a/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs b/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\nindex 6d6f3700de..2035026ffe 100644\n--- a/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n@@ -230,6 +230,13 @@ test('the presentation prints writing commands for the operator and closes on th\n   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n });\n \n+test('the presentation and the workflow name the accepted runtimes instead of a count', () => {\n+  assert.doesNotMatch(PRESENTATION, /outside the seven/);\n+  assert.ok(PRESENTATION.includes('outside claude, opencode, codex, cursor, devin and pi or the ones already there'));\n+  assert.ok(PRESENTATION.includes('DSH is not offered, because the link manifest has no DSH row.'));\n+  assert.match(WORKFLOW.inputs.runtimes, /DSH is not offered/);\n+});\n+\n // ─────────────────────────────────────────────────────────────────────────────\n // 4. THE READ-ONLY WORKFLOW\n // ─────────────────────────────────────────────────────────────────────────────\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -c core.fsmonitor=false diff -- .skilled/commands/doctor/assets/doctor-install-presentation.txt .skilled/commands/doctor/assets/doctor-install.yaml .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794558736517,"end":1794558739636}}}}
