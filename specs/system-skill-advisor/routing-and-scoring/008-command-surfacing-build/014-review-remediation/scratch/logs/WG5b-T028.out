e manifest, and the three child tools it runs are read-only\n\n  Line 40: const { spawnSync } = require('node:child_process');\n\n  Line 59: const GENERATOR = path.resolve(__dirname, 'agents-md-manifest.cjs');\n\n  Line 447:   const run = spawnSync(process.execPath, [tools.canary, '--root', context.root], {\n\n  Line 669:     const run = spawnSync(process.execPath, [tools.pointerSync, '--check', '--root', context.root], {\n\n  Line 783:   const run = spawnSync(process.execPath, [tools.repoRules, '--root', context.root], {\n\n  Line 875:   const run = spawnSync(process.execPath, [tools.generator, '--check', '--root', context.root, '--manifest', options.manifest], {\n\n  Line 898:     generator: GENERATOR,\n\n  Line 1002:  * @param {{tools?: Object}} [hooks] - test seams for the child tools\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\",\"pattern\":\"spawnSync|GENERATOR|CHILD|child\"}"},"time":{"start":1794560108139,"end":1794560109262}}}}
