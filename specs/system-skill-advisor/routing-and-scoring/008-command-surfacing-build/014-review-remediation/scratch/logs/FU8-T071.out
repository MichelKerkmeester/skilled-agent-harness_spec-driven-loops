{"type":"tool_use","timestamp":1794561769976,"sessionID":"ses_e2bccaea8ffeCO0Qwn6Olmcpya","part":{"partID":"prt_1d4377ca2001loE2pDYbh4AhR6","sessionID":"ses_e2bccaea8ffeCO0Qwn6Olmcpya","messageID":"msg_1d437666d0013rUygkT5Dkbyn9","type":"tool","id":"call_c3e39750804f44ec85edf797","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -U2 HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts | sed -n '1,80p'","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\nindex 774199e60b..84ae4cb058 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n@@ -19,5 +19,5 @@ import {\n   type DeliveryStateSignals,\n } from './policy-plan.js';\n-import { commandRowFor } from './command-attach.js';\n+import { COMMAND_ROWS, commandRowFor } from './command-attach.js';\n import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n import type { AdvisorRecommendation } from './subprocess.js';\n@@ -222,5 +222,7 @@ function policyWord(\n // caller that already resolved the command is never second-guessed.\n function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n-  const row = commandRowFor(recommendation.skill);\n+  // A hub that withheld its mode must not regress to the command its generated\n+  // row names, because that command is the mode the reader has not chosen yet.\n+  const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n   const command = recommendation.command ?? row?.command;\n   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n@@ -231,5 +233,10 @@ function commandLabel(recommendation: RenderableRecommendation, childSession: bo\n     return null;\n   }\n-  const policyPart = policyWord(policy, row?.mutating, childSession);\n+  // The class belongs to the command printed, not to the skill that carried it,\n+  // so a recommendation that names another command takes that command's class.\n+  const mutating = row !== undefined && row.command === commandPart\n+    ? row.mutating\n+    : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n+  const policyPart = policyWord(policy, mutating, childSession);\n   return policyPart === null\n     ? `${ownerPart} → ${commandPart}`\n@@ -537,8 +544,10 @@ export function renderAdvisorBrief(\n   }\n \n+  // A recommendation that needs a mode is named by the skill that owns its row,\n+  // because the row id is an internal key the reader cannot run.\n   const topLabel = commandLabel(top, childSession)\n     ?? (isDoctorBridgeId(top.skill)\n       ? doctorCommandString(top.skill)\n-      : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n+      : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n   if (!topLabel) {\n     observeAdvisorPolicy(null, options);\n@@ -548,5 +557,5 @@ export function renderAdvisorBrief(\n   // A hub that withheld its command because the prompt names no single mode says\n   // so, so the reader asks for the mode instead of improvising one.\n-  const headLabel = top.needsMode === true && top.command === undefined && commandRowFor(top.skill) === undefined\n+  const headLabel = top.needsMode === true && top.command === undefined\n     ? `${topLabel} (needs a mode)`\n     : topLabel;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\nindex 774199e60b..84ae4cb058 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/lib/render.ts\n@@ -19,5 +19,5 @@ import {\n   type DeliveryStateSignals,\n } from './policy-plan.js';\n-import { commandRowFor } from './command-attach.js';\n+import { COMMAND_ROWS, commandRowFor } from './command-attach.js';\n import { isAmbiguousTopTwo } from './scorer/ambiguity.js';\n import type { AdvisorRecommendation } from './subprocess.js';\n@@ -222,5 +222,7 @@ function policyWord(\n // caller that already resolved the command is never second-guessed.\n function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n-  const row = commandRowFor(recommendation.skill);\n+  // A hub that withheld its mode must not regress to the command its generated\n+  // row names, because that command is the mode the reader has not chosen yet.\n+  const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n   const command = recommendation.command ?? row?.command;\n   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n@@ -231,5 +233,10 @@ function commandLabel(recommendation: RenderableRecommendation, childSession: bo\n     return null;\n   }\n-  const policyPart = policyWord(policy, row?.mutating, childSession);\n+  // The class belongs to the command printed, not to the skill that carried it,\n+  // so a recommendation that names another command takes that command's class.\n+  const mutating = row !== undefined && row.command === commandPart\n+    ? row.mutating\n+    : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n+  const policyPart = policyWord(policy, mutating, childSession);\n   return policyPart === null\n     ? `${ownerPart} → ${commandPart}`\n@@ -537,8 +544,10 @@ export function renderAdvisorBrief(\n   }\n \n+  // A recommendation that needs a mode is named by the skill that owns its row,\n+  // because the row id is an internal key the reader cannot run.\n   const topLabel = commandLabel(top, childSession)\n     ?? (isDoctorBridgeId(top.skill)\n       ? doctorCommandString(top.skill)\n-      : sanitizeSkillLabel(metadataSkillLabel(result) ?? top.skill));\n+      : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n   if (!topLabel) {\n     observeAdvisorPolicy(null, options);\n@@ -548,5 +557,5 @@ export function renderAdvisorBrief(\n   // A hub that withheld its command because the prompt names no single mode says\n   // so, so the reader asks for the mode instead of improvising one.\n-  const headLabel = top.needsMode === true && top.command === undefined && commandRowFor(top.skill) === undefined\n+  const headLabel = top.needsMode === true && top.command === undefined\n     ? `${topLabel} (needs a mode)`\n     : topLabel;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -U2 HEAD -- .skilled/skills/system-skill-advisor/runtime/lib/render.ts | sed -n '1,80p'\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794561768610,"end":1794561769976}}}}
{"type":"tool_use","timestamp":1794561769982,"sessionID":"ses_e2bccaea8ffeCO0Qwn6Olmcpya","part":{"partID":"prt_1d4377f19001ls96CKWM1ibexq","sessionID":"ses_e2bccaea8ffeCO0Qwn6Olmcpya","messageID":"msg_1d437666d0013rUygkT5Dkbyn9","type":"tool","id":"call_a45621aa300549479bcb911c","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -U2 HEAD -- .skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts | sed -n '1,90p'","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\nindex 4c363d345e..58b48b7fb7 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\n@@ -3,5 +3,5 @@\n // ───────────────────────────────────────────────────────────────\n \n-import { describe, expect, it } from 'vitest';\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n import { renderAdvisorBrief } from '../lib/render.js';\n \n@@ -210,4 +210,14 @@ function headOf(rendered: string | null): string {\n \n describe('command brief golden heads', () => {\n+  // The expected heads are the interactive ones, so a run inside a dispatched\n+  // child must not turn them into the child form.\n+  beforeEach(() => {\n+    vi.stubEnv('AI_SESSION_CHILD', '');\n+  });\n+\n+  afterEach(() => {\n+    vi.unstubAllEnvs();\n+  });\n+\n   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n@@ -218,4 +228,20 @@ describe('command brief golden heads', () => {\n   });\n \n+  // A generated row can name a command the hub withheld because the prompt names\n+  // no single mode, so the marker wins over the row instead of printing a command\n+  // the reader never asked for.\n+  it('renders needs a mode even when the id has a command row', () => {\n+    const head = headOf(renderAdvisorBrief(advisorResult({\n+      skill: 'command-create-agent',\n+      needsMode: true,\n+      confidence: 0.95,\n+      uncertainty: 0.12,\n+    })));\n+\n+    expect(head).toContain('use sk-doc (needs a mode)');\n+    expect(head).not.toContain('command-');\n+    expect(head).not.toContain('/create:agent');\n+  });\n+\n   it('renders both command labels under an ambiguous head', () => {\n     const head = headOf(renderAdvisorBrief(AMBIGUOUS_COMMAND_RESULT));\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\nindex 4c363d345e..58b48b7fb7 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts\n@@ -3,5 +3,5 @@\n // ───────────────────────────────────────────────────────────────\n \n-import { describe, expect, it } from 'vitest';\n+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n import { renderAdvisorBrief } from '../lib/render.js';\n \n@@ -210,4 +210,14 @@ function headOf(rendered: string | null): string {\n \n describe('command brief golden heads', () => {\n+  // The expected heads are the interactive ones, so a run inside a dispatched\n+  // child must not turn them into the child form.\n+  beforeEach(() => {\n+    vi.stubEnv('AI_SESSION_CHILD', '');\n+  });\n+\n+  afterEach(() => {\n+    vi.unstubAllEnvs();\n+  });\n+\n   it.each(HEAD_CASES)('renders $name', ({ recommendation, expectedHead }) => {\n     const head = headOf(renderAdvisorBrief(advisorResult(recommendation)));\n@@ -218,4 +228,20 @@ describe('command brief golden heads', () => {\n   });\n \n+  // A generated row can name a command the hub withheld because the prompt names\n+  // no single mode, so the marker wins over the row instead of printing a command\n+  // the reader never asked for.\n+  it('renders needs a mode even when the id has a command row', () => {\n+    const head = headOf(renderAdvisorBrief(advisorResult({\n+      skill: 'command-create-agent',\n+      needsMode: true,\n+      confidence: 0.95,\n+      uncertainty: 0.12,\n+    })));\n+\n+    expect(head).toContain('use sk-doc (needs a mode)');\n+    expect(head).not.toContain('command-');\n+    expect(head).not.toContain('/create:agent');\n+  });\n+\n   it('renders both command labels under an ambiguous head', () => {\n     const head = headOf(renderAdvisorBrief(AMBIGUOUS_COMMAND_RESULT));\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -U2 HEAD -- .skilled/skills/system-skill-advisor/runtime/tests/command-brief-golden.vitest.ts | sed -n '1,90p'\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794561769241,"end":1794561769982}}}}
