olicy(rendered, options);\n609:   return rendered;\n610: }\n611: \n612: /** Classify a result with no brief; no result at all means the advisor did not answer. */\n613: export function advisorFallbackCase(\n614:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n615: ): AdvisorFallbackClassification {\n616:   if (!result || result.status === 'fail_open' || result.freshness === 'absent'\n617:     || (result.freshness === 'unavailable' && result.status !== 'skipped')) {\n618:     return {\n619:       fallbackCase: 'outage',\n620:       outageLabel: result?.freshness === 'absent'\n621:         ? 'absent'\n622:         : result?.status === 'degraded'\n623:           ? 'degraded'\n624:           : 'fail_open',\n625:     };\n626:   }\n627:   if (result.status === 'skipped' && result.freshness === 'unavailable') {\n628:     return { fallbackCase: 'skipped' };\n629:   }\n630:   return { fallbackCase: 'no-match' };\n631: }\n632: \n633: /** Render the fallback status and directive block when no advisor brief is available. */\n634: export function renderAdvisorFallbackDirective(\n635:   options: AdvisorBriefRenderOptions = {},\n636:   result?: Pick<AdvisorHookResult, 'status' | 'freshness'>,\n637: ): string {\n638:   const classification = advisorFallbackCase(result);\n639:   const head = classification.fallbackCase === 'outage'\n640:     ? `Advisor: outage (${classification.outageLabel});${options.setupWording === true ? ' for setup or health checks, run /doctor:setup;' : ''} route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\"prompt\":\"<request>\"}' --format json`\n641:     : classification.fallbackCase === 'skipped'\n642:       ? 'Advisor: prompt skipped.'\n643:       : options.setupWording === true\n644:         ? `Advisor: no skill matched.${SETUP_HINT}`\n645:         : 'Advisor: no skill matched.';\n646:   const rendered = head + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n647:   observeAdvisorPolicy(rendered, options);\n648:   return rendered;\n649: }\n650: \n651: /** Render the outage fallback used when advisor execution times out or is unavailable. */\n652: export function renderAdvisorTimeoutFallback(\n653:   options: AdvisorBriefRenderOptions = {},\n654:   status: Extract<AdvisorHookResult['status'], 'fail_open' | 'degraded'> = 'fail_open',\n655: ): string {\n656:   return renderAdvisorFallbackDirective(options, { status, freshness: 'unavailable' });\n657: }\n658: \n659: export { sanitizeSkillLabel };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 580-659\n580:       ? recommendations.find((recommendation) => ambiguousWith.includes(recommendation.skill))\n581:       : undefined) ?? second;\n582:     const vsLabel = recommendationLabel(vs, childSession);\n583:     if (!vsLabel && !isDoctorBridgeId(vs.skill)) {\n584:       observeAdvisorPolicy(null, options);\n585:       return null;\n586:     }\n587:     if (vsLabel) {\n588:       const head = `Advisor: ${result.freshness}; ambiguous: ${headLabel} `\n589:         + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} vs ${vsLabel} `\n590:         + `${formatScore(vs.confidence)}/${formatScore(vs.uncertainty)} pass.`;\n591:       const rendered = capWithCompanion(\n592:         head,\n593:         companionLine(vs.skill),\n594:         Math.min(tokenCap, AMBIGUOUS_TOKEN_CAP),\n595:       ) + DIRECTIVES_LABEL + HYGIENE_DIRECTIVE;\n596:       observeAdvisorPolicy(rendered, options);\n597:       return rendered;\n598:     }\n599:   }\n600: \n601:   const head = `Advisor: ${result.freshness}; use ${headLabel} `\n602:     + `${formatScore(top.confidence)}/${formatScore(top.uncertainty)} pass.`;\n603:   const rendered = capWithCompanion(\n604:     head,\n605:     companionLine(undefined),\n606:     Math.min(tokenCap, DEFAULT_TOKEN_CAP),\n607:   ) + 