\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   // A hub that withheld its mode must not regress to the command its generated\n225:   // row names, because that command is the mode the reader has not chosen yet.\n226:   const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n227:   const command = recommendation.command ?? row?.command;\n228:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n229:   const policy = recommendation.policy ?? row?.policy;\n230:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n231:   const ownerPart = sanitizeSkillLabel(owner);\n232:   if (!commandPart || !ownerPart) {\n233:     return null;\n234:   }\n235:   // The class belongs to the command printed, not to the skill that carried it,\n236:   // so a recommendation that names another command takes that command's class.\n237:   const mutating = row !== undefined && row.command === commandPart\n238:     ? row.mutating\n239:     : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n240:   const policyPart = policyWord(policy, mutating, childSession);\n241:   return policyPart === null\n242:     ? `${ownerPart} → ${commandPart}`\n243:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n244: }\n245: \n246: // A doctor bridge renders as its runnable command and never as its raw id; an\n247: // unmapped doctor id renders nothing.\n248: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n249:   return commandLabel(recommendation, childSession)\n250:     ?? (isDoctorBridgeId(recommendation.skill)\n251:       ? doctorCommandString(recommendation.skill)\n252:       : sanitizeSkillLabel(recommendation.skill));\n253: }\n254: \n255: // The companion line normally shows only the runnable command. A child gets the\n256: // downgrade marker appended because that command must not be started there.\n257: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n258:   const command = doctorCommandString(skillId);\n259:   if (command === null) {\n260:     return null;\n261:   }\n262:   const row = commandRowFor(skillId);\n263:   return childSession && parentNamedOnly(row?.policy, row?.mutating)\n264:     ? `${command} (${PARENT_NAMED_POLICY})`\n265:     : command;\n266: }\n267: \n268: function formatScore(value: number): string {\n269:   return Number.isFinite(value) ? value.toFixed(2) : '0.00';\n270: }\n271: \n272: type RenderableRecommendation = AdvisorRecommendation & {\n273:   readonly score?: number;\n274:   readonly ambiguousWith?: readonly string[];\n275:   readonly heldBelow?: string;\n276: };\n277: \n278: function toScoredRecommendation(recommendation: RenderableRecommendation): AdvisorScoredRecommendation {\n279:   return {\n[Output truncated. Continue reading with offset: 280]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 150-279\n150: function capText(text: string, tokenCap: number): string {\n151:   const charCap = tokenCap * TOKEN_TO_CHAR_ESTIMATE;\n152:   if (text.length <= charCap) {\n153:     return text;\n154:   }\n155:   const truncated = text.slice(0, Math.max(1, charCap - 3)).trimEnd();\n156:   return `${truncated}...`;\n157: }\n158: \n159: function sanitizeSkillLabel(skillLabel: string | null | undefined): string | null {\n160:   if (typeof skillLabel !== 'string') {\n161:     return null;\n162:   }\n163:   const folded = canonicalFold(skillLabel);\n164:   if (/[\\n\\r]/.test(folded)) {\n165:     return null;\n166:   }\n167:   const singleLine = folded\n168:     .replace(CONTROL_CHAR_PATTERN, '')\n169:     .replace(/\\s+/g, ' ')\n170:     .trim();\n171:   if (!singleLine || INSTRUCTION_LABEL_PATTERN.test(singleLine)) {\n172:     return null;\n173:   }\n174:   return singleLine;\n175: }\n176: \n177: const DOCTOR_BRIDGE_PREFIX = 'command-doctor-';\n178: \n179: function isDoctorBridgeId(skillId: string): boolean {\n180:   return skillId.startsWith(DOCTOR_BRIDGE_PREFIX);\n181: }\n182: \n183: /** Return the sanitized runnable command for a doctor bridge id, or null when unmapped. */\n184: export function doctorCommandString(skillId: string): string | null {\n185:   if (!isDoctorBridgeId(skillId)) {\n186:     return null;\n187:   }\n188:   const command = commandRowFor(skillId)?.command;\n189:   return command === undefined ? null : sanitizeSkillLabel(command);\n190: }\n191: \n192: // A dispatched child cannot ask its operator whether to start an interactive run\n193: // or one that writes, so only a read-only run stays fully visible there.\n194: function parentNamedOnly(policy: string | undefined, mutating: string | undefined): boolean {\n195:   if (policy === 'start' || policy === 'ask') {\n196:     return true;\n197:   }\n198:   return policy === 'run' && mutating !== 'read-only';\n199: }\n200: \n201: // The policy word is the only part of a command label a child replaces. The\n202: // command itself and its owner stay visible so the child can report what the\n203: // parent named.\n204: function policyWord(\n205:   policy: string | undefined,\n206:   mutating: string | undefined,\n207:   childSession: boolean,\n208: ): string | null {\n209:   if (policy === undefined) {\n210:     return null;\n211:   }\n212:   const word = sanitizeSkillLabel(policy);\n213:   if (word === null) {\n214:     return null;\n215:   }\n216:   return childSession && parentNamedOnly(policy, mutating) ? PARENT_NAMED_POLICY : word;\n217: }\n218: \n219: // A recommendation that names a command renders as the skill that owns it, the\n220: // runnable command and the policy that governs the run. The recommendation's own\n221: // fields stay authoritative and the generated row fills only what they omit, so a\n222: // caller that already resolved the command is never second-guessed.\n223: function commandLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n224:   // A hub that withheld its mode must not regress to the command its generated\n225:   // row names, because that command is the mode the reader has not chosen yet.\n226:   const row = recommendation.needsMode === true ? undefined : commandRowFor(recommendation.skill);\n227:   const command = recommendation.command ?? row?.command;\n228:   const owner = recommendation.ownerSkillId ?? row?.ownerSkillId ?? recommendation.skill;\n229:   const policy = recommendation.policy ?? row?.policy;\n230:   const commandPart = command === undefined ? null : sanitizeSkillLabel(command);\n231:   const ownerPart = sanitizeSkillLabel(owner);\n232:   if (!commandPart || !ownerPart) {\n233:     return null;\n234:   }\n235:   // The class belongs to the command printed, not to the skill that carried it,\n236:   // so a recommendation that names another command takes that command's class.\n237:   const mutating = row !== undefined && row.command === commandPart\n238:     ? row.mutating\n239:     : Object.values(COMMAND_ROWS).find((candidate) => candidate.command === commandPart)?.mutating;\n240:   const policyPart = policyWord(policy, mutating, childSession);\n241:   return policyPart === null\n242:     ? `${ownerPart} → ${commandPart}`\n243:     : `${ownerPart} → ${commandPart} (${policyPart})`;\n244: }\n245: \n246: // A doctor bridge renders as its runnable command and never as its raw id; an\n247: // unmapped doctor id renders nothing.\n248: function recommendationLabel(recommendation: RenderableRecommendation, childSession: boolean): string | null {\n249:   return commandLabel(recommendation, childSession)\n250:     ?? (isDoctorBridgeId(recommendation.skill)\n251:       ? doctorCommandString(recommendation.skill)\n252:       : sanitizeSkillLabel(recommendation.skill));\n253: }\n254: \n255: // The companion line normally shows only the runnable command. A child gets the\n256: // downgrade marker appended because that command must not be started there.\n257: function companionCommandLabel(skillId: string, childSession: boolean): string | null {\n258:   const command = doctorCommandString(skillId);\n259:   if (command === null) {\n260:     return null;\n26