mpt and its clean-up. The returned status ends the arm as soon as a guard\n1021: // fires, so a broken precondition never spends another model call.\n1022: async function runTurn(job, options, exempt, isFirst) {\n1023:   const before = { status: statusPaths(), ...gitSnapshot() };\n1024:   if (isFirst) {\n1025:     // A live turn can push, so it may only start where there is no remote to push\n1026:     // to. A dry run spawns nothing and keeps running in this checkout.\n1027:     if (!options.dryRun) {\n1028:       const remotes = remoteNames();\n1029:       if (remotes.length > 0) {\n1030:         return {\n1031:           status: EXIT_REFUSED,\n1032:           refusal: { ok: false, code: 'remote_present', remotes },\n1033:         };\n1034:       }\n1035:     }\n1036:     const dirty = dirtyPaths(before.status, exempt);\n1037:     if (dirty.length > 0) {\n1038:       return {\n1039:         status: EXIT_REFUSED,\n1040:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n1041:       };\n1042:     }\n1043:   }\n1044: \n1045:   const sessionId = randomUUID();\n1046:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1047:   // A runtime that names its session only in its own store is bracketed by a\n1048:   // listing, and the entry the turn added is the session it wrote. A dry run\n1049:   // starts no CLI, so it has nothing to list.\n1050:   const listed = !options.dryRun && listsStore(job.runtime);\n1051:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1052:   const turn = options.dryRun\n1053:     ? { exit: null, error: null, streamId: null }\n1054:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1055:   const reportedId = listed\n1056:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1057:     : turn.streamId;\n1058: \n1059:   const after = { status: statusPaths(), ...gitSnapshot() };\n1060:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1061:   const changed = changedPaths(before.status, after.status);\n1062:   // The locator is kept in hand because the brief reader opens the same session\n1063:   // the line records, and resolving it twice could name a different file.\n1064:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1065:   const line = {\n1066:     runtime: job.runtimeName,\n1067:     rowId: job.rowId,\n1068:     arm: options.arm,\n1069:     locator,\n[Output truncated. Continue reading with offset: 1070]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs, lines 990-1069\n990:   if (options.backfill !== null) {\n991:     if (options.out === null) throw new UsageError('--out is required');\n992:     return 'backfill';\n993:   }\n994:   if (options.runtime === null) throw new UsageError('--runtime is required');\n995:   if (options.set === null && options.rowIds.length === 0) {\n996:     throw new UsageError('--set or --row-id is required');\n997:   }\n998:   if (options.out === null) throw new UsageError('--out is required');\n999:   return 'run';\n1000: }\n1001: \n1002: function writeJson(value) {\n1003:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n1004: }\n1005: \n1006: function writeRowIds(rowIds) {\n1007:   process.stdout.write(rowIds.map((rowId) => `${rowId}\\n`).join(''));\n1008: }\n1009: \n1010: function writeArgv(runtimeName) {\n1011:   const runtime = resolveRuntime(runtimeName);\n1012:   const argv = runtime.buildArgv({ prompt: SAMPLE_PROMPT, sessionId: SAMPLE_SESSION_ID });\n1013:   // The prompt rides stdin, so it must not leak into the argv an operator inspects.\n1014:   if (runtime.promptOnStdin && argv.includes(SAMPLE_PROMPT)) {\n1015:     throw new Error(`${runtimeName}: prompt is on stdin but also in argv`);\n1016:   }\n1017:   writeJson(argv);\n1018: }\n1019: \n1020: // One prompt and its clean-up. The returned status ends the arm as soon as a guard\n1021: // fires, so a broken precondition never spends another model call.\n1022: async function runTurn(job, options, exempt, isFirst) {\n1023:   const before = { status: statusPaths(), ...gitSnapshot() };\n1024:   if (isFirst) {\n1025:     // A live turn can push, so it may only start where there is no remote to push\n1026:     // to. A dry run spawns nothing and keeps running in this checkout.\n1027:     if (!options.dryRun) {\n1028:       const remotes = remoteNames();\n1029:       if (remotes.length > 0) {\n1030:         return {\n1031:           status: EXIT_REFUSED,\n1032:           refusal: { ok: false, code: 'remote_present', remotes },\n1033:         };\n1034:       }\n1035:     }\n1036:     const dirty = dirtyPaths(before.status, exempt);\n1037:     if (dirty.length > 0) {\n1038:       return {\n1039:         status: EXIT_REFUSED,\n1040:         refusal: { ok: false, code: 'worktree_dirty', paths: dirty },\n1041:       };\n1042:     }\n1043:   }\n1044: \n1045:   const sessionId = randomUUID();\n1046:   const argv = job.runtime.buildArgv({ prompt: job.prompt, sessionId });\n1047:   // A runtime that names its session only in its own store is bracketed by a\n1048:   // listing, and the entry the turn added is the session it wrote. A dry run\n1049:   // starts no CLI, so it has nothing to list.\n1050:   const listed = !options.dryRun && listsStore(job.runtime);\n1051:   const listingBefore = listed ? storeIds(job.runtime, job.ghConfig) : null;\n1052:   const turn = options.dryRun\n1053:     ? { exit: null, error: null, streamId: null }\n1054:     : await spawnTurn(job.runtime, argv, job.prompt, job.cap, job.ghConfig);\n1055:   const reportedId = listed\n1056:     ? addedSessionId(listingBefore, storeIds(job.runtime, job.ghConfig))\n1057:     : turn.streamId;\n1058: \n1059:   const after = { status: statusPaths(), ...gitSnapshot() };\n1060:   const headMoved = before.head !== after.head || before.stash !== after.stash;\n1061:   const changed = changedPaths(before.status, after.status);\n1062:   // The locator is kept in hand because the brief reader opens the same session\n1063:   // the line records, and resolving it twice could name a different file.\n1064:   const locator = locatorFor(job.runtime, sessionId, reportedId);\n1065:   const line = {\n1066:     runtime: job.runtimeName,\n1067:     rowId: job.rowId,\n1068:     arm: options.arm,\n1069:     locator,\n[Output truncated. Continue reading with offset: 1070]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\",\"offset\":990,\"limit\":80}"},"time":{"start":1794559222916,"end":1794559223490}}}}
