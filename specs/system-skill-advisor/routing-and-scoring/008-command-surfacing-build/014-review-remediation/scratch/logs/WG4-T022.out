.toBeUndefined();\n31:     expect(env.AI_SESSION_CHILD).toBeUndefined();\n32:     expect(env.ANTHROPIC_API_KEY).toBe('sk-ant-example');\n33:     expect(env.PATH).toBe(process.env.PATH);\n34:     expect(env.HOME).toBe(process.env.HOME);\n35:     expect(env.GH_CONFIG_DIR).toBe('/tmp/gh-empty');\n36:     expect(env.GIT_TERMINAL_PROMPT).toBe('0');\n37:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n38:   });\n39: });\n40: \n41: describe('liveArmRefusal', () => {\n42:   const dirs: string[] = [];\n43: \n44:   afterEach(() => {\n45:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n46:   });\n47: \n48:   it('refuses a live arm outside a marked arena', () => {\n49:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n50:     dirs.push(dir);\n51:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n52:     expect(runGit(['init', '-q']).status).toBe(0);\n53: \n54:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n55: \n56:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n57:     expect(liveArmRefusal(dir)).toBeNull();\n58: \n59:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n60:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n61:   });\n62: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts, lines 1-62\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Runner Guard Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { spawnSync } from 'node:child_process';\n9: import { afterEach, describe, expect, it, vi } from 'vitest';\n10: import { childEnv, liveArmRefusal } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n11: \n12: describe('childEnv', () => {\n13:   afterEach(() => {\n14:     vi.unstubAllEnvs();\n15:   });\n16: \n17:   it('passes only the allowlisted environment to a turn', () => {\n18:     vi.stubEnv('SSH_AUTH_SOCK', '/tmp/ssh-agent.sock');\n19:     vi.stubEnv('AWS_ACCESS_KEY_ID', 'AKIAIOSFODNN7EXAMPLE');\n20:     vi.stubEnv('NPM_TOKEN', 'npm-token');\n21:     vi.stubEnv('GH_TOKEN', 'gh-token');\n22:     vi.stubEnv('AI_SESSION_CHILD', '1');\n23:     vi.stubEnv('ANTHROPIC_API_KEY', 'sk-ant-example');\n24: \n25:     const env = childEnv('/tmp/gh-empty');\n26: \n27:     expect(env.SSH_AUTH_SOCK).toBeUndefined();\n28:     expect(env.AWS_ACCESS_KEY_ID).toBeUndefined();\n29:     expect(env.NPM_TOKEN).toBeUndefined();\n30:     expect(env.GH_TOKEN).toBeUndefined();\n31:     expect(env.AI_SESSION_CHILD).toBeUndefined();\n32:     expect(env.ANTHROPIC_API_KEY).toBe('sk-ant-example');\n33:     expect(env.PATH).toBe(process.env.PATH);\n34:     expect(env.HOME).toBe(process.env.HOME);\n35:     expect(env.GH_CONFIG_DIR).toBe('/tmp/gh-empty');\n36:     expect(env.GIT_TERMINAL_PROMPT).toBe('0');\n37:     expect(env.GIT_CONFIG_KEY_0).toBe('credential.helper');\n38:   });\n39: });\n40: \n41: describe('liveArmRefusal', () => {\n42:   const dirs: string[] = [];\n43: \n44:   afterEach(() => {\n45:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n46:   });\n47: \n48:   it('refuses a live arm outside a marked arena', () => {\n49:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n50:     dirs.push(dir);\n51:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n52:     expect(runGit(['init', '-q']).status).toBe(0);\n53: \n54:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n55: \n56:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n57:     expect(liveArmRefusal(dir)).toBeNull();\n58: \n59:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n60:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n61:   });\n62: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\"}"},"time":{"start":1794559386719,"end":1794559387143}}}}
