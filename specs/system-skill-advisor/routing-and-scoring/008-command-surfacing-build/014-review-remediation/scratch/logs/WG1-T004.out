{"type":"tool_use","timestamp":1794558675068,"sessionID":"ses_e2bf9637cffehsWt94nfgLxMyQ","part":{"partID":"prt_1d408463a002QcqS4zpOxHTHve","sessionID":"ses_e2bf9637cffehsWt94nfgLxMyQ","messageID":"msg_1d407c5ee001DwOoZ0bZfFBZrV","type":"tool","id":"call_247c41ec7b784afe8781d07d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1066\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: const { spawnSync } = require('node:child_process');\n44: const crypto = require('node:crypto');\n45: const fs = require('node:fs');\n46: const os = require('node:os');\n47: const path = require('node:path');\n48: \n49: const { buildReport } = require('./agents-md-check.cjs');\n50: const { classifyFile } = require('./release-update.cjs');\n51: const {\n52:   deliveryAnchorEnd,\n53:   findBlock,\n54:   segment,\n55:   sha256,\n56: } = require('./lib/agents-md-sections.cjs');\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: const TAG = '[agents-md-embed]';\n63: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n64: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n65: \n66: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n67: // its generator, and the router verdict belongs to the checker that ships with the skill\n68: // authoring rules.\n69: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n70: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n71: const REPO_RULES_TAG = '[repo-rules-check]';\n72: const TOOL_TIMEOUT_MS = 120000;\n73: \n74: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n75: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n76: // The digest is 64 hex characters and a path segment is better short, so the directory is\n77: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n78: // bits of it is what makes two different plans sharing one a non-event.\n79: const BACKUP_NAME_CHARS = 16;\n80: // How many of this composition's directories a plan will step past before it gives up. The\n81: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n82: // a normal one.\n83: const BACKUP_ATTEMPTS = 64;\n84: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n85: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n86: const CLAUDE_POINTER_PATH = 'CLAUDE.md';\n87: \n88: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n89: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n90: // and every removal is checked against this list by `assertWritable` before it happens.\n91: const ALLOWLIST = [\n92:   'AGENTS.md',\n93:   'CLAUDE.md',\n94:   '.codex/AGENTS.md',\n95:   '.cursor/rules/repo-local.md',\n96:   '.cursor/rules/skill-routing.md',\n97:   'REPO RULES.md',\n98: ];\n99: \n100: // A copy at one of these paths is read for its unique lines and then removed. Every other\n101: // runtime-copy row is reported by the check engine and left alone here.\n102: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n103: \n104: const USAGE = [\n105:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n106:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n107:   '                             budget, the survival ledger and the plan digest; write nothing',\n108:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n109:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n110:   'Options:',\n111:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n112:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n113:   '  --remove-claude-md         fold it and leave an @AGENTS.md pointer in its place (the default)',\n114:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n115:   '  --dry-run                  print the plan and write nothing',\n116:   '  --yes                      take the restore confirmation as given',\n117:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n118:   '            2 a precondition failed or a path fell outside the allowlist',\n119: ].join('\\n');\n120: \n121: // ─────────────────────────────────────────────────────────────────────────────\n122: // 3. ERRORS\n123: // ─────────────────────────────────────────────────────────────────────────────\n124: \n125: class UsageError extends Error {}\n126: class PreconditionError extends Error {}\n127: class AllowlistError extends Error {}\n128: \n129: // ─────────────────────────────────────────────────────────────────────────────\n130: // 4. ARGUMENTS\n131: // ─────────────────────────────────────────────────────────────────────────────\n132: \n133: function readValue(argv, index, flag) {\n134:   const argument = argv[index];\n135:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n136:   if (inline !== null) return { value: inline, next: index };\n137:   const value = argv[index + 1];\n138:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n139:   return { value, next: index + 1 };\n140: }\n141: \n142: function parseArgs(argv) {\n143:   const options = {\n144:     command: null,\n145:     root: REPO_ROOT,\n146:     digest: null,\n147:     run: null,\n148:     keepClaudeMd: false,\n149:     createRouter: false,\n150:     dryRun: false,\n151:     yes: false,\n152:     help: false,\n153:   };\n154: \n155:   const commands = [];\n156:   for (let index = 0; index < argv.length; index += 1) {\n157:     const argument = argv[index];\n158:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n159:     else if (argument === '--root') {\n160:       const read = readValue(argv, index, '--root');\n161:       options.root = path.resolve(read.value);\n162:       index = read.next;\n163:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n164:       const read = readValue(argv, index, '--plan-digest');\n165:       options.digest = read.value.trim();\n166:       index = read.next;\n167:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n168:       const read = readValue(argv, index, '--run');\n169:       options.run = path.resolve(read.value);\n170:       index = read.next;\n171:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n172:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n173:     else if (argument === '--create-router') options.createRouter = true;\n174:     else if (argument === '--dry-run') options.dryRun = true;\n175:     else if (argument === '--yes') options.yes = true;\n176:     else if (argument === '--help' || argument === '-h') options.help = true;\n177:     else throw new UsageError(`unknown argument: ${argument}`);\n178:   }\n179: \n180:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n181:   options.command = commands.length === 1 ? commands[0] : null;\n182:   return options;\n183: }\n184: \n185: // ─────────────────────────────────────────────────────────────────────────────\n186: // 5. SMALL SHARED READERS\n187: // ─────────────────────────────────────────────────────────────────────────────\n188: \n189: function loadManifest() {\n190:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n191:   try {\n192:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n193:   } catch (error) {\n194:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n195:   }\n196: }\n197: \n198: function isSymlink(target) {\n199:   try {\n200:     return fs.lstatSync(target).isSymbolicLink();\n201:   } catch {\n202:     return false;\n203:   }\n204: }\n205: \n206: function sameDirectory(a, b) {\n207:   try {\n208:     return fs.realpathSync(a) === fs.realpathSync(b);\n209:   } catch {\n210:     return false;\n211:   }\n212: }\n213: \n214: // The undo a run prints must work as printed. A restore runs against this engine's own\n215: // repository unless told otherwise, so the line names the root whenever it is another one.\n216: function undoCommand(dir, root) {\n217:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n218:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n219: }\n220: \n221: // A line is compared trimmed, and the two lines that carry no content of their own are\n222: // dropped, because a composition may legitimately re-place either of them.\n223: function countLines(text) {\n224:   const counts = new Map();\n225:   for (const raw of String(text).split('\\n')) {\n226:     const line = raw.trim();\n227:     if (line === '' || line === '---') continue;\n228:     counts.set(line, (counts.get(line) || 0) + 1);\n229:   }\n230:   return counts;\n231: }\n232: \n233: function lineSet(text) {\n234:   return new Set(countLines(text).keys());\n235: }\n236: \n237: function uniqueLines(text) {\n238:   return [...countLines(text).keys()];\n239: }\n240: \n241: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n242: // same sentence written twice is two lines to keep.\n243: function lineCount(text) {\n244:   let total = 0;\n245:   for (const count of countLines(text).values()) total += count;\n246:   return total;\n247: }\n248: \n249: // The lines of one body that its reference does not carry, in order and with repeats,\n250: // because the proof counts occurrences rather than membership. The comparison is trimmed\n251: // and the line comes back as it was written: the proof cares that the line survived, and\n252: // the indentation is what makes a nested bullet or a code sample read as one.\n253: function localLinesOf(body, reference) {\n254:   const known = lineSet(reference);\n255:   const lines = [];\n256:   for (const raw of String(body).split('\\n')) {\n257:     const line = raw.trim();\n258:     if (line === '' || line === '---' || known.has(line)) continue;\n259:     lines.push(raw);\n260:   }\n261:   return lines;\n262: }\n263: \n264: function chunkText(text) {\n265:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n266: }\n267: \n268: // ─────────────────────────────────────────────────────────────────────────────\n269: // 6. THE REPOSITORY BLOCK\n270: // ─────────────────────────────────────────────────────────────────────────────\n271: \n272: // What the block holds once the template's own heading and note are set aside. A block a\n273: // previous release wrote opens with both, so recognising them is what keeps a second run\n274: // from nesting one heading inside another.\n275: function blockBody(content, markers) {\n276:   let rest = String(content).replace(/^\\n+/u, '');\n277:   const heading = markers.heading.trim();\n278:   const note = markers.note.trim();\n279:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n280:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n281:   return chunkText(rest);\n282: }\n283: \n284: function renderBlock(markers, body) {\n285:   const text = chunkText(body);\n286:   const between = text === '' ? '' : `${text}\\n`;\n287:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n288: }\n289: \n290: // Devin never sees past the delivery prefix of the root document, so a repository with\n291: // something of its own gets the same block as a Cursor rule that applies always.\n292: function renderMirror(markers, body) {\n293:   const text = chunkText(body);\n294:   const between = text === '' ? '' : `${text}\\n`;\n295:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n296: }\n297: \n298: // A document carrying two blocks has no single block to carry out of, and replacing it\n299: // would have to choose one of them. Naming both positions is what makes the refusal\n300: // actionable: reporting the second block's marker bytes as repository lines the run\n301: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n302: function duplicateBlockMessage(rootFile, block) {\n303:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n304:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n305:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n306: }\n307: \n308: // ─────────────────────────────────────────────────────────────────────────────\n309: // 7. THE ROUTER\n310: // ─────────────────────────────────────────────────────────────────────────────\n311: \n312: function cellsOf(line) {\n313:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n314: }\n315: \n316: // The rule a row points at, which is the identity the checker also compares. Matching on\n317: // the resolved path rather than the whole row is what lets a repository reword a summary\n318: // without the row reading as missing.\n319: function rulePathOf(cells) {\n320:   for (const cell of cells) {\n321:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n322:     if (linked) return linked[1];\n323:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n324:     if (bare) return bare[1];\n325:   }\n326:   return null;\n327: }\n328: \n329: function rowKey(cells) {\n330:   return rulePathOf(cells) || cells.join(' | ');\n331: }\n332: \n333: /**\n334:  * The rows of one router table, with the line each sits on.\n335:  *\n336:  * @param {string} text - The router document.\n337:  * @param {string} anchor - Text that identifies the table's heading.\n338:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n339:  *   Null when the document carries no such table.\n340:  */\n341: function routerTable(text, anchor) {\n342:   const lines = text.split('\\n');\n343:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n344:   if (start === -1) return null;\n345: \n346:   const rows = [];\n347:   let separator = -1;\n348:   let lastRow = -1;\n349:   for (let index = start + 1; index < lines.length; index += 1) {\n350:     const line = lines[index].trim();\n351:     if (line.startsWith('#')) break;\n352:     if (line === '') {\n353:       if (rows.length > 0) break;\n354:       continue;\n355:     }\n356:     if (!line.startsWith('|')) continue;\n357:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n358:       separator = index;\n359:       continue;\n360:     }\n361:     rows.push({ line: index, cells: cellsOf(line) });\n362:     lastRow = index;\n363:   }\n364: \n365:   const anchorLine = rows.length > 0 ? lastRow : separator;\n366:   if (anchorLine === -1) return null;\n367:   return { lines, rows, insertAfter: anchorLine };\n368: }\n369: \n370: /**\n371:  * The router with the shipped rows it is missing, added at the end of each table.\n372:  *\n373:  * @param {string} text\n374:  * @param {Object} manifest\n375:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n376:  */\n377: function addRouterRows(text, manifest) {\n378:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n379:   const tables = [\n380:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n381:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n382:   ];\n383: \n384:   let next = text;\n385:   const added = { trigger: 0, index: 0 };\n386:   const notes = [];\n387: \n388:   for (const table of tables) {\n389:     const found = routerTable(next, table.anchor);\n390:     if (found === null) {\n391:       // A router without the table is a different document shape; appending one would\n392:       // number a second section and break the checker's own reading of the file.\n393:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n394:       continue;\n395:     }\n396:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n397:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n398:     if (missing.length === 0) continue;\n399:     const lines = found.lines.slice();\n400:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n401:     next = lines.join('\\n');\n402:     added[table.kind] = missing.length;\n403:   }\n404: \n405:   return { text: next, added, notes };\n406: }\n407: \n408: // A repository with no router loads no rule at all, so the missing file is created from\n409: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n410: function renderRouter(manifest) {\n411:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n412:   return [\n413:     '# REPO RULES',\n414:     '',\n415:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n416:     'before your first write of the session. This document then routes you to every rule',\n417:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n418:     'holds no rules of its own.',\n419:     '',\n420:     '---',\n421:     '',\n422:     '## 1. HOW TO USE THIS',\n423:     '',\n424:     '1. **Match on the action you are about to take**, not the topic of the request.',\n425:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n426:     '3. **A file already in context is not re-read.**',\n427:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n428:     '',\n429:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n430:     'the same tables, authored one rule at a time.',\n431:     '',\n432:     '---',\n433:     '',\n434:     '## 2. TRIGGER TABLE',\n435:     '',\n436:     '| You are about to… | Load | It settles |',\n437:     '|-------------------|------|-----------|',\n438:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n439:     '',\n440:     '---',\n441:     '',\n442:     '## 3. INDEX',\n443:     '',\n444:     '| Rule | Summary |',\n445:     '|------|---------|',\n446:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n447:     '',\n448:     '---',\n449:     '',\n450:     'Each file the rows name is part of the installation and is replaced by a release.',\n451:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n452:     '',\n453:   ].join('\\n');\n454: }\n455: \n456: // ─────────────────────────────────────────────────────────────────────────────\n457: // 8. THE PLAN DIGEST\n458: // ─────────────────────────────────────────────────────────────────────────────\n459: \n460: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n461: // composed for and by the backup directory the plan takes: the same plan replayed against\n462: // an edited tree composes something else and cannot match, and a plan whose directory an\n463: // earlier run already owns is a different plan, so the digest covers which one it is.\n464: function planDigest(composition, plan) {\n465:   const written = composition.files\n466:     .filter((file) => file.action === 'create' || file.action === 'replace')\n467:     .map((file) => [file.path, file.action, sha256(file.content)])\n468:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n469:   const removed = composition.files\n470:     .filter((file) => file.action === 'remove')\n471:     .map((file) => [file.path, file.action, null])\n472:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n473:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n474: }\n475: \n476: // Where each line of the old document sat, so a lost line is reported with the part it\n477: // belonged to. The block wins over the section it interrupts, because those bytes are the\n478: // repository's and not the section's.\n479: function placementOf(before) {\n480:   const places = new Map();\n481:   for (const section of before.sections) {\n482:     const place = section.id === null\n483:       ? { part: 1, from: 'unmarked section' }\n484:       : { part: 2, from: section.id };\n485:     for (const index of section.rows || []) places.set(index, place);\n486:   }\n487:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n488:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n489:   if (before.block && before.block.complete && before.block.rows) {\n490:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n491:   }\n492:   return places;\n493: }\n494: \n495: // ─────────────────────────────────────────────────────────────────────────────\n496: // 9. THE PRESERVATION PROOF\n497: // ─────────────────────────────────────────────────────────────────────────────\n498: \n499: /**\n500:  * Prove that a composition lost nothing the repository had.\n501:  *\n502:  * Four claims, one per part of the returned record: every line of the old document no\n503:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n504:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n505:  * removed runtime copy still sit in the new document; and every line of the new document\n506:  * outside the block is one the template ships. Pure by construction: same inputs, same\n507:  * answer, no file read.\n508:  *\n509:  * The claim is read from the old document's own lines, in reading order, rather than from\n510:  * the parts the segmentation produced. A proof built from those parts can require only\n511:  * what the reader managed to place, so a line it placed nowhere would be required by\n512:  * nothing and a composition that lost it would still report `dropped 0`.\n513:  *\n514:  * @param {string|null} oldText - The document as it was.\n515:  * @param {string} newText - The document as it would be, or as it now is.\n516:  * @param {Object} manifest\n517:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n518:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n519:  *   foreign: Array<{line: string}>}}\n520:  */\n521: function preservationCheck(oldText, newText, manifest, options = {}) {\n522:   const markers = manifest.markers;\n523:   const dropped = [];\n524:   const knownShipped = new Set();\n525:   for (const entry of Object.values(manifest.derived.sections || {})) {\n526:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n527:   }\n528:   for (const entry of manifest.derived.history || []) {\n529:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n530:   }\n531: \n532:   // The framework's own bytes: the two markers and the heading and note that come with\n533:   // them. The new document carries one of each whatever the old one carried, so requiring\n534:   // them would report a duplicated block as repository lines the run dropped.\n535:   const framework = new Set([\n536:     markers.start.trim(),\n537:     markers.end.trim(),\n538:     markers.heading.trim(),\n539:     markers.note.trim(),\n540:   ]);\n541: \n542:   const before = oldText === null || oldText === undefined\n543:     ? { sections: [], block: null, prelude: null }\n544:     : segment(oldText, markers, manifest.sections);\n545:   const after = segment(newText, markers, manifest.sections);\n546:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n547:   const newBlockCounts = countLines(newBlock);\n548:   const newDocumentCounts = countLines(newText);\n549: \n550:   const require = (line, part, from, need) => {\n551:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n552:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n553:   };\n554: \n555:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n556:   // the new block at least as often as it was there. Where the line sat decides only which\n557:   // part names it when it goes missing.\n558:   const places = placementOf(before);\n559:   const needed = new Map();\n560:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n561:   for (let index = 0; index < oldLines.length; index += 1) {\n562:     const line = oldLines[index].trim();\n563:     if (line === '' || line === '---') continue;\n564:     if (framework.has(line) || knownShipped.has(line)) continue;\n565:     const place = places.get(index) || { part: 1, from: 'the document' };\n566:     const entry = needed.get(line);\n567:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n568:     else entry.need += 1;\n569:   }\n570:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n571: \n572:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n573:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n574:   for (const copy of options.removed || []) {\n575:     for (const [line, count] of countLines(copy.content)) {\n576:       if (framework.has(line)) continue;\n577:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n578:       require(line, 3, copy.path, count);\n579:     }\n580:   }\n581: \n582:   // Part 4. Nothing above the block that the template does not ship.\n583:   const currentOnly = new Set();\n584:   for (const entry of Object.values(manifest.derived.sections || {})) {\n585:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n586:   }\n587:   const foreign = [];\n588:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n589:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n590:   const newBytes = Buffer.from(newText, 'utf8');\n591:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n592:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n593:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n594:   for (const line of uniqueLines(outside)) {\n595:     if (!currentOnly.has(line)) foreign.push({ line });\n596:   }\n597: \n598:   return { dropped, foreign };\n599: }\n600: \n601: // ─────────────────────────────────────────────────────────────────────────────\n602: // 10. COMPOSITION\n603: // ─────────────────────────────────────────────────────────────────────────────\n604: \n605: function rowOf(report, id) {\n606:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n607: }\n608: \n609: function fileState(text) {\n610:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n611: }\n612: \n613: function historyBodyOf(manifest, hash) {\n614:   if (!hash) return null;\n615:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n616:   return entry ? entry.body : null;\n617: }\n618: \n619: function prefixEndOf(text, manifest) {\n620:   if (text === null) return 0;\n621:   const { sections } = segment(text, manifest.markers, manifest.sections);\n622:   const byId = new Map();\n623:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n624:   let end = 0;\n625:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n626:     const section = byId.get(pin.section);\n627:     if (!section) continue;\n628:     const measured = deliveryAnchorEnd(section, pin);\n629:     if (measured !== null) end = Math.max(end, measured);\n630:   }\n631:   return end;\n632: }\n633: \n634: /**\n635:  * Build every target of one repository in memory, with the ledger and the digest.\n636:  *\n637:  * Nothing here writes; the caller decides what to do with the answer.\n638:  *\n639:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n640:  * @returns {Object} the composition\n641:  */\n642: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n643:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n644:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n645: \n646:   const markers = manifest.markers;\n647:   const rootFile = manifest.root_file;\n648:   const claudePointer = `@${manifest.root_file}\\n`;\n649:   const rootPath = path.join(root, rootFile);\n650:   // Writing through a link would change a file this repository does not own, and the backup\n651:   // could not put the link back.\n652:   if (isSymlink(rootPath)) {\n653:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n654:   }\n655:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n656: \n657:   const block = oldText === null ? null : findBlock(oldText, markers);\n658:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n659:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n660:   }\n661:   if (block !== null && block.complete === false) {\n662:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n663:   }\n664: \n665:   const oldSegmentation = oldText === null\n666:     ? { sections: [], block: null, prelude: null }\n667:     : segment(oldText, markers, manifest.sections);\n668:   const oldSections = oldSegmentation.sections;\n669:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n670:   const notes = [];\n671:   const chunks = [];\n672: \n673:   // (a) Whatever the block already held.\n674:   if (block !== null && block.complete) {\n675:     const body = blockBody(block.content, markers);\n676:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n677:   }\n678: \n679:   // Text above the first heading belongs to no section, and a replacement would drop it.\n680:   // The segmenter reports it apart from the sections because no heading covers it.\n681:   if (oldSegmentation.prelude !== null) {\n682:     const preamble = chunkText(oldSegmentation.prelude.text);\n683:     if (preamble !== '') {\n684:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n685:     }\n686:   }\n687: \n688:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n689:   // the first heading is already carried as the preamble, and its byte range would reach\n690:   // a block written above the template, so it is the one entry skipped here.\n691:   const unmarkedRow = rowOf(report, 'A8');\n692:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n693:   const unmarked = unmarkedRow.entries\n694:     .filter((entry) => entry.heading !== null)\n695:     .sort((left, right) => left.byte_start - right.byte_start);\n696:   for (const entry of unmarked) {\n697:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n698:     if (text === '') continue;\n699:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n700:   }\n701: \n702:   // (c) The local lines of a section somebody edited, each under its own id.\n703:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n704:   for (const entry of edited) {\n705:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n706:     if (!section) continue;\n707:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n708:     const lines = localLinesOf(section.body, shippedBody);\n709:     if (lines.length === 0) continue;\n710:     chunks.push({\n711:       kind: 'edited',\n712:       id: entry.id,\n713:       lines: lines.length,\n714:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n715:     });\n716: \n717:     // A clean merge would leave the section edited forever, so it is offered as a reading\n718:     // of the same bytes and never as the default.\n719:     const base = historyBodyOf(manifest, entry.base);\n720:     if (base !== null) {\n721:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n722:       if (merged.conflictKind === 'mergeable') {\n723:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n724:       }\n725:     }\n726:   }\n727: \n728:   // (d) The unique lines of a runtime copy that is folded away.\n729:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n730:   const removedCopies = [];\n731:   for (const copy of copies) {\n732:     const absolute = path.join(root, copy.path);\n733:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n734:     if (copy.state !== 'FINDING') continue;\n735:     const content = fs.readFileSync(absolute, 'utf8');\n736:     // With no root document every line of the copy is its own, and the count has to survive:\n737:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n738:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n739:     if (lines.length > 0) {\n740:       chunks.push({\n741:         kind: 'copy',\n742:         path: copy.path,\n743:         lines: lines.length,\n744:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n745:       });\n746:     }\n747:     removedCopies.push({ path: copy.path, content });\n748:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n749:       removedCopies.pop();\n750:       if (lines.length > 0) {\n751:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n752:       }\n753:     }\n754:   }\n755: \n756:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n757:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n758: \n759:   // The template with nothing of the repository's own in it gains nothing from the two\n760:   // marker lines, so that difference alone is not a reason to write: the markers appear\n761:   // with the first line worth keeping.\n762:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n763:   if (templateOnly) {\n764:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n765:   }\n766: \n767:   const files = [];\n768:   if (templateOnly || oldText === composed) {\n769:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n770:   } else {\n771:     files.push({\n772:       path: rootFile,\n773:       action: oldText === null ? 'create' : 'replace',\n774:       content: composed,\n775:       before: oldText,\n776:     });\n777:   }\n778: \n779:   // The router gains the shipped rows it is missing, or is created from them when asked.\n780:   const routerPath = path.join(root, manifest.router_file);\n781:   let routerAction = 'unchanged';\n782:   let routerText = null;\n783:   if (fs.existsSync(routerPath)) {\n784:     const current = fs.readFileSync(routerPath, 'utf8');\n785:     const result = addRouterRows(current, manifest);\n786:     notes.push(...result.notes);\n787:     if (result.text !== current) {\n788:       routerText = result.text;\n789:       routerAction = 'replace';\n790:       if (result.added.trigger > 0 || result.added.index > 0) {\n791:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n792:       }\n793:     }\n794:   } else if (createRouter) {\n795:     routerText = renderRouter(manifest);\n796:     routerAction = 'create';\n797:   } else {\n798:     routerAction = 'absent';\n799:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n800:   }\n801:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n802: \n803:   // The Cursor mirror exists exactly when the block carries something, because an empty\n804:   // block has nothing a runtime that cannot read past the prefix would miss.\n805:   const mirrorPath = path.join(root, MIRROR_FILE);\n806:   const mirrorExists = fs.existsSync(mirrorPath);\n807:   let mirrorAction = 'unchanged';\n808:   let mirrorText = null;\n809:   if (blockText !== '') {\n810:     mirrorText = renderMirror(markers, blockText);\n811:     if (!mirrorExists) mirrorAction = 'create';\n812:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n813:   } else if (mirrorExists) {\n814:     mirrorAction = 'remove';\n815:   }\n816:   if (mirrorAction !== 'unchanged') {\n817:     files.push({\n818:       path: MIRROR_FILE,\n819:       action: mirrorAction,\n820:       content: mirrorText,\n821:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n822:     });\n823:   }\n824: \n825:   for (const copy of removedCopies) {\n826:     if (copy.path === CLAUDE_POINTER_PATH) {\n827:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n828:       continue;\n829:     }\n830:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n831:   }\n832: \n833:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n834:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n835:   if (\n836:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n837:     && !fs.existsSync(claudePath)\n838:     && !isSymlink(claudePath)\n839:   ) {\n840:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n841:   }\n842: \n843:   const composition = {\n844:     root,\n845:     state: report.state,\n846:     report,\n847:     markers,\n848:     rootFile,\n849:     oldText,\n850:     composed,\n851:     block: { text: renderBlock(markers, blockText), body: blockText },\n852:     chunks,\n853:     removedCopies,\n854:     notes,\n855:     files,\n856:     budget: {\n857:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n858:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n859:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n860:     },\n861:     ledger: {\n862:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n863:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n864:       shippedReplaced: manifest.sections.length,\n865:       dropped: 0,\n866:     },\n867:   };\n868: \n869:   // What the run would put on disk, which is exactly the three actions a target can take.\n870:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n871:   return composition;\n872: }\n873: \n874: // ─────────────────────────────────────────────────────────────────────────────\n875: // 11. THE WRITE ALLOWLIST\n876: // ─────────────────────────────────────────────────────────────────────────────\n877: \n878: /**\n879:  * Resolve one path a run wants to touch, or refuse it.\n880:  *\n881:  * Containment is checked before membership, so a path that climbs out of the root is\n882:  * reported as what it is rather than as a missing allowlist entry.\n883:  *\n884:  * @param {string} root\n885:  * @param {string} relative\n886:  * @returns {string} the absolute path\n887:  */\n888: function assertWritable(root, relative) {\n889:   const base = path.resolve(root);\n890:   const normalized = String(relative).split(path.sep).join('/');\n891:   const absolute = path.resolve(base, normalized);\n892:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n893:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n894:   }\n895:   if (!ALLOWLIST.includes(normalized)) {\n896:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n897:   }\n898:   // Every path a run reaches must sit inside the root where the root really is, not only\n899:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n900:   const realBase = fs.realpathSync(base);\n901:   const realTarget = resolveThroughLinks(absolute);\n902:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n903:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n904:   }\n905:   return absolute;\n906: }\n907: \n908: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n909: // and the rest of the name is appended to it.\n910: function resolveThroughLinks(absolute) {\n911:   try {\n912:     return fs.realpathSync(absolute);\n913:   } catch {\n914:     const parent = path.dirname(absolute);\n915:     if (parent === absolute) return absolute;\n916:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n917:   }\n918: }\n919: \n920: // ─────────────────────────────────────────────────────────────────────────────\n921: // 12. BACKUPS\n922: // ─────────────────────────────────────────────────────────────────────────────\n923: \n924: function utcStamp(date = new Date()) {\n925:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n926: }\n927: \n928: /**\n929:  * The directory a plan's backup sits in, named after the plan digest.\n930:  *\n931:  * Named by the digest rather than by a clock reading because apply has to land exactly\n932:  * where the plan pointed and the digest is the only thing the operator carries across. The\n933:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n934:  * taken and moves to the next ordinal instead of writing beside it.\n935:  *\n936:  * @param {string} base\n937:  * @param {string} digest\n938:  * @returns {string}\n939:  */\n940: function backupDirectoryOf(base, digest) {\n941:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n942: }\n943: \n944: /**\n945:  * Where a run's backup goes, without creating anything.\n946:  *\n947:  * The output directory is used only when git ignores it, because a backup inside a tracked\n948:  * path is a backup the next commit publishes. Everything else leaves the repository.\n949:  *\n950:  * @param {{root: string}} input\n951:  * @returns {{dir: string, fallback: boolean, reason: string}}\n952:  */\n953: function backupBase({ root }) {\n954:   const candidate = path.join(root, BACKUP_DIR);\n955:   // The question is the one the run depends on: would a plan directory under this one be\n956:   // published by the next commit? Asking about the base alone would miss a rule written as\n957:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n958:   // the probe is a path of the same shape as the one the plan takes.\n959:   const probe = path.join(candidate, 'probe');\n960:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n961:     encoding: 'utf8',\n962:     timeout: TOOL_TIMEOUT_MS,\n963:   });\n964:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n965:   const reason = ignored.status === 1\n966:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n967:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n968:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n969: }\n970: \n971: /**\n972:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n973:  * that says both.\n974:  *\n975:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n976:  * suffixed into a second name, because the printed undo command would then point at that\n977:  * run's bytes; the next ordinal is a different plan with a different digest and a\n978:  * directory of its own.\n979:  *\n980:  * @param {Object} composition\n981:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n982:  */\n983: function planFor(composition) {\n984:   const base = backupBase({ root: composition.root });\n985:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n986:     const digest = planDigest(composition, { ordinal, base: base.dir });\n987:     const dir = backupDirectoryOf(base.dir, digest);\n988:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n989:   }\n990:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n991: }\n992: \n993: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n994: // only these, so on a record the run wrote, a folder that was there before the run is never\n995: // taken away with it.\n996: function missingParents(root, relative) {\n997:   const missing = [];\n998:   let dir = path.posix.dirname(relative);\n999:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1000:     missing.push(dir);\n1001:     dir = path.posix.dirname(dir);\n1002:   }\n1003:   return missing;\n1004: }\n1005: \n1006: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1007: // entry's own allowlisted path; the list stops at the first one that is not.\n1008: function recordedCreatedDirs(entry) {\n1009:   const dirs = [];\n1010:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1011:   for (const dir of entry.createdDirs) {\n1012:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1013:     dirs.push(dir);\n1014:   }\n1015:   return dirs;\n1016: }\n1017: \n1018: // Runs after every file is back, because two new files can share one new folder. Only the\n1019: // folders above a file this restore just deleted are considered, and only an empty one is\n1020: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1021: // file the run created.\n1022: function removeCreatedDirs(root, entries, deleted) {\n1023:   const removed = [];\n1024:   for (const entry of entries) {\n1025:     if (!deleted.has(entry.path)) continue;\n1026:     for (const dir of recordedCreatedDirs(entry)) {\n1027:       const absolute = path.join(root, dir);\n1028:       let names;\n1029:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1030:       if (names.length > 0) break;\n1031:       fs.rmdirSync(absolute);\n1032:       removed.push(dir);\n1033:     }\n1034:   }\n1035:   return removed;\n1036: }\n1037: \n1038: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1039: // copy rather than a reconstruction.\n1040: function backupEntry(root, file) {\n1041:   const absolute = path.join(root, file.path);\n1042:   const exists = fs.existsSync(absolute);\n1043:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1044:   if (!exists) {\n1045:     entry.createdDirs = missingParents(root, file.path);\n1046:     return entry;\n1047:   }\n1048:   const stats = fs.lstatSync(absolute);\n1049:   entry.mode = stats.mode.toString(8).slice(-4);\n1050:   entry.symlink = stats.isSymbolicLink();\n1051:   const bytes = fs.readFileSync(absolute);\n1052:   entry.sha256 = sha256(bytes.toString('utf8'));\n1053:   entry.backup = path.posix.join('files', file.path);\n1054:   return entry;\n1055: }\n1056: \n1057: function writeBackup({ root, manifest, composition, plan }) {\n1058:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1059:   // finishing first: writing beside its record would make the undo ambiguous.\n1060:   if (fs.existsSync(plan.dir)) {\n1061:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1062:   }\n1063:   fs.mkdirSync(plan.dir, { recursive: true });\n1064: \n1065:   const entries = [];\n1066:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n[Output truncated. Continue reading with offset: 1067]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1-1066\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Embed Engine\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // A repository that took the shipped instruction template keeps its own lines somewhere\n8: // the template does not know about: at the top of the file, inside a section somebody\n9: // edited, in the Claude copy a previous install left behind. Replacing the file with the\n10: // current template is therefore a deletion, and it is silent, because nothing in the\n11: // repository records which of its lines belonged to it.\n12: //\n13: // So this engine never writes what it has not first shown and hashed. Composition happens\n14: // in memory and produces one new document per target; the plan prints every target, the\n15: // diff, the new block, the byte budget and the survival ledger, and hashes the composed\n16: // bytes. The backup directory is named after that digest, so apply lands exactly where the\n17: // plan pointed and the plan is the artefact the yes is given against. It backs up every\n18: // path it will touch before the first byte, then writes only inside a fixed allowlist that\n19: // is checked in code rather than described in a document.\n20: //\n21: // After the write it proves the composition against the bytes now on disk: every line the\n22: // repository had, inside or outside the template, must still be there, and every line\n23: // outside the repository block must be one the template ships. A violation restores from\n24: // the backup automatically and ends the run as a failure. The proof is a pure function so\n25: // it can also be read and driven on its own, and it requires the old document's own lines\n26: // rather than the parts the segmenter produced: a proof built from those parts can require\n27: // only what the reader managed to place, and a line it placed nowhere goes unclaimed.\n28: //\n29: // The four carry groups, in order, are the shape a repository's own text keeps: the block\n30: // it already had, the sections that match no shipped section, the local lines of a section\n31: // somebody edited, and the unique lines of a runtime copy that is folded away. A section\n32: // whose body is a released one is replaced with no carry, because every line of it is a\n33: // line the template already ships.\n34: //\n35: // Usage: agents-md-embed.cjs <plan|apply|restore> [options]\n36: // Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,\n37: //             2 a precondition failed or a path fell outside the allowlist\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: const { spawnSync } = require('node:child_process');\n44: const crypto = require('node:crypto');\n45: const fs = require('node:fs');\n46: const os = require('node:os');\n47: const path = require('node:path');\n48: \n49: const { buildReport } = require('./agents-md-check.cjs');\n50: const { classifyFile } = require('./release-update.cjs');\n51: const {\n52:   deliveryAnchorEnd,\n53:   findBlock,\n54:   segment,\n55:   sha256,\n56: } = require('./lib/agents-md-sections.cjs');\n57: \n58: // ─────────────────────────────────────────────────────────────────────────────\n59: // 2. CONSTANTS\n60: // ─────────────────────────────────────────────────────────────────────────────\n61: \n62: const TAG = '[agents-md-embed]';\n63: const REPO_ROOT = path.resolve(__dirname, '../../../..');\n64: const MANIFEST_PATH = path.resolve(__dirname, '../assets/agents-md-manifest.json');\n65: \n66: // The two tools this engine calls instead of reimplementing: the pointer block belongs to\n67: // its generator, and the router verdict belongs to the checker that ships with the skill\n68: // authoring rules.\n69: const POINTER_SYNC = path.join(REPO_ROOT, '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs');\n70: const REPO_RULES_CHECKER = path.join(REPO_ROOT, '.skilled/skills/sk-doc/sk-create-repo-rule/scripts/check-repo-rules.cjs');\n71: const REPO_RULES_TAG = '[repo-rules-check]';\n72: const TOOL_TIMEOUT_MS = 120000;\n73: \n74: const BACKUP_DIR = path.join('.skilled', 'output', 'doctor-agents-md');\n75: const BACKUP_FALLBACK_DIR = 'doctor-agents-md';\n76: // The digest is 64 hex characters and a path segment is better short, so the directory is\n77: // named by its first 16. A plan and an apply that share a digest share the directory; 64\n78: // bits of it is what makes two different plans sharing one a non-event.\n79: const BACKUP_NAME_CHARS = 16;\n80: // How many of this composition's directories a plan will step past before it gives up. The\n81: // loop only moves when a directory is taken, so the number bounds a pathological tree, not\n82: // a normal one.\n83: const BACKUP_ATTEMPTS = 64;\n84: const MIRROR_FILE = '.cursor/rules/repo-local.md';\n85: const POINTER_FILE = '.cursor/rules/skill-routing.md';\n86: const CLAUDE_POINTER_PATH = 'CLAUDE.md';\n87: \n88: // The whole write boundary, in one place. `skill-routing.md` is here because the run\n89: // invokes the generator that owns it; this engine never composes a byte of it. Every write\n90: // and every removal is checked against this list by `assertWritable` before it happens.\n91: const ALLOWLIST = [\n92:   'AGENTS.md',\n93:   'CLAUDE.md',\n94:   '.codex/AGENTS.md',\n95:   '.cursor/rules/repo-local.md',\n96:   '.cursor/rules/skill-routing.md',\n97:   'REPO RULES.md',\n98: ];\n99: \n100: // A copy at one of these paths is read for its unique lines and then removed. Every other\n101: // runtime-copy row is reported by the check engine and left alone here.\n102: const FOLDED_COPIES = ['CLAUDE.md', '.codex/AGENTS.md'];\n103: \n104: const USAGE = [\n105:   'Usage: node .skilled/commands/doctor/scripts/agents-md-embed.cjs <plan|apply|restore> [options]',\n106:   '  plan                       compose in memory, print the targets, the diff, the new block, the',\n107:   '                             budget, the survival ledger and the plan digest; write nothing',\n108:   '  apply --plan-digest <d>    recompose, refuse a different digest, back up, then write',\n109:   '  restore --run=<dir>        put back exactly the files one apply recorded',\n110:   'Options:',\n111:   '  --root <dir>               compose for this repository instead of the one this script ships in',\n112:   '  --keep-claude-md           fold a divergent CLAUDE.md into the block but keep the file',\n113:   '  --remove-claude-md         fold it and leave an @AGENTS.md pointer in its place (the default)',\n114:   '  --create-router            create REPO RULES.md from the shipped rows when it is missing',\n115:   '  --dry-run                  print the plan and write nothing',\n116:   '  --yes                      take the restore confirmation as given',\n117:   'Exit codes: 0 nothing to do or done, 1 the proof failed or the run was cancelled,',\n118:   '            2 a precondition failed or a path fell outside the allowlist',\n119: ].join('\\n');\n120: \n121: // ─────────────────────────────────────────────────────────────────────────────\n122: // 3. ERRORS\n123: // ─────────────────────────────────────────────────────────────────────────────\n124: \n125: class UsageError extends Error {}\n126: class PreconditionError extends Error {}\n127: class AllowlistError extends Error {}\n128: \n129: // ─────────────────────────────────────────────────────────────────────────────\n130: // 4. ARGUMENTS\n131: // ─────────────────────────────────────────────────────────────────────────────\n132: \n133: function readValue(argv, index, flag) {\n134:   const argument = argv[index];\n135:   const inline = argument.startsWith(`${flag}=`) ? argument.slice(flag.length + 1) : null;\n136:   if (inline !== null) return { value: inline, next: index };\n137:   const value = argv[index + 1];\n138:   if (!value || value.startsWith('--')) throw new UsageError(`${flag} needs a value`);\n139:   return { value, next: index + 1 };\n140: }\n141: \n142: function parseArgs(argv) {\n143:   const options = {\n144:     command: null,\n145:     root: REPO_ROOT,\n146:     digest: null,\n147:     run: null,\n148:     keepClaudeMd: false,\n149:     createRouter: false,\n150:     dryRun: false,\n151:     yes: false,\n152:     help: false,\n153:   };\n154: \n155:   const commands = [];\n156:   for (let index = 0; index < argv.length; index += 1) {\n157:     const argument = argv[index];\n158:     if (argument === 'plan' || argument === 'apply' || argument === 'restore') commands.push(argument);\n159:     else if (argument === '--root') {\n160:       const read = readValue(argv, index, '--root');\n161:       options.root = path.resolve(read.value);\n162:       index = read.next;\n163:     } else if (argument === '--plan-digest' || argument.startsWith('--plan-digest=')) {\n164:       const read = readValue(argv, index, '--plan-digest');\n165:       options.digest = read.value.trim();\n166:       index = read.next;\n167:     } else if (argument === '--run' || argument.startsWith('--run=')) {\n168:       const read = readValue(argv, index, '--run');\n169:       options.run = path.resolve(read.value);\n170:       index = read.next;\n171:     } else if (argument === '--keep-claude-md') options.keepClaudeMd = true;\n172:     else if (argument === '--remove-claude-md') options.keepClaudeMd = false;\n173:     else if (argument === '--create-router') options.createRouter = true;\n174:     else if (argument === '--dry-run') options.dryRun = true;\n175:     else if (argument === '--yes') options.yes = true;\n176:     else if (argument === '--help' || argument === '-h') options.help = true;\n177:     else throw new UsageError(`unknown argument: ${argument}`);\n178:   }\n179: \n180:   if (commands.length > 1) throw new UsageError(`plan, apply and restore are separate targets; got ${commands.join(', ')}`);\n181:   options.command = commands.length === 1 ? commands[0] : null;\n182:   return options;\n183: }\n184: \n185: // ─────────────────────────────────────────────────────────────────────────────\n186: // 5. SMALL SHARED READERS\n187: // ─────────────────────────────────────────────────────────────────────────────\n188: \n189: function loadManifest() {\n190:   if (!fs.existsSync(MANIFEST_PATH)) throw new PreconditionError(`the manifest is missing at ${MANIFEST_PATH}`);\n191:   try {\n192:     return JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n193:   } catch (error) {\n194:     throw new PreconditionError(`${MANIFEST_PATH} is not valid JSON: ${error.message}`);\n195:   }\n196: }\n197: \n198: function isSymlink(target) {\n199:   try {\n200:     return fs.lstatSync(target).isSymbolicLink();\n201:   } catch {\n202:     return false;\n203:   }\n204: }\n205: \n206: function sameDirectory(a, b) {\n207:   try {\n208:     return fs.realpathSync(a) === fs.realpathSync(b);\n209:   } catch {\n210:     return false;\n211:   }\n212: }\n213: \n214: // The undo a run prints must work as printed. A restore runs against this engine's own\n215: // repository unless told otherwise, so the line names the root whenever it is another one.\n216: function undoCommand(dir, root) {\n217:   const base = `node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=${dir}`;\n218:   return sameDirectory(root, REPO_ROOT) ? base : `${base} --root ${root}`;\n219: }\n220: \n221: // A line is compared trimmed, and the two lines that carry no content of their own are\n222: // dropped, because a composition may legitimately re-place either of them.\n223: function countLines(text) {\n224:   const counts = new Map();\n225:   for (const raw of String(text).split('\\n')) {\n226:     const line = raw.trim();\n227:     if (line === '' || line === '---') continue;\n228:     counts.set(line, (counts.get(line) || 0) + 1);\n229:   }\n230:   return counts;\n231: }\n232: \n233: function lineSet(text) {\n234:   return new Set(countLines(text).keys());\n235: }\n236: \n237: function uniqueLines(text) {\n238:   return [...countLines(text).keys()];\n239: }\n240: \n241: // How many lines a text holds, counting repeats: the ledger reports lines kept, and the\n242: // same sentence written twice is two lines to keep.\n243: function lineCount(text) {\n244:   let total = 0;\n245:   for (const count of countLines(text).values()) total += count;\n246:   return total;\n247: }\n248: \n249: // The lines of one body that its reference does not carry, in order and with repeats,\n250: // because the proof counts occurrences rather than membership. The comparison is trimmed\n251: // and the line comes back as it was written: the proof cares that the line survived, and\n252: // the indentation is what makes a nested bullet or a code sample read as one.\n253: function localLinesOf(body, reference) {\n254:   const known = lineSet(reference);\n255:   const lines = [];\n256:   for (const raw of String(body).split('\\n')) {\n257:     const line = raw.trim();\n258:     if (line === '' || line === '---' || known.has(line)) continue;\n259:     lines.push(raw);\n260:   }\n261:   return lines;\n262: }\n263: \n264: function chunkText(text) {\n265:   return String(text).replace(/^\\n+/u, '').replace(/\\n+$/u, '');\n266: }\n267: \n268: // ─────────────────────────────────────────────────────────────────────────────\n269: // 6. THE REPOSITORY BLOCK\n270: // ─────────────────────────────────────────────────────────────────────────────\n271: \n272: // What the block holds once the template's own heading and note are set aside. A block a\n273: // previous release wrote opens with both, so recognising them is what keeps a second run\n274: // from nesting one heading inside another.\n275: function blockBody(content, markers) {\n276:   let rest = String(content).replace(/^\\n+/u, '');\n277:   const heading = markers.heading.trim();\n278:   const note = markers.note.trim();\n279:   if (rest.startsWith(heading)) rest = rest.slice(heading.length).replace(/^\\n+/u, '');\n280:   if (rest.startsWith(note)) rest = rest.slice(note.length).replace(/^\\n+/u, '');\n281:   return chunkText(rest);\n282: }\n283: \n284: function renderBlock(markers, body) {\n285:   const text = chunkText(body);\n286:   const between = text === '' ? '' : `${text}\\n`;\n287:   return `${markers.start}\\n${markers.heading}\\n\\n${markers.note}\\n${between}${markers.end}\\n`;\n288: }\n289: \n290: // Devin never sees past the delivery prefix of the root document, so a repository with\n291: // something of its own gets the same block as a Cursor rule that applies always.\n292: function renderMirror(markers, body) {\n293:   const text = chunkText(body);\n294:   const between = text === '' ? '' : `${text}\\n`;\n295:   return `---\\nalwaysApply: true\\n---\\n\\n${markers.heading}\\n\\n${markers.note}\\n${between}`;\n296: }\n297: \n298: // A document carrying two blocks has no single block to carry out of, and replacing it\n299: // would have to choose one of them. Naming both positions is what makes the refusal\n300: // actionable: reporting the second block's marker bytes as repository lines the run\n301: // dropped would name nothing anybody could look at and hide the fault behind the proof.\n302: function duplicateBlockMessage(rootFile, block) {\n303:   const starts = block.markerLines.start.map((line) => `line ${line}`).join(' and ');\n304:   const ends = block.markerLines.end.map((line) => `line ${line}`).join(' and ');\n305:   return `the repository block in ${rootFile} is duplicated: the start marker appears on ${starts} and the end marker on ${ends}; one block is all the engine can place, so it carries nothing out of either`;\n306: }\n307: \n308: // ─────────────────────────────────────────────────────────────────────────────\n309: // 7. THE ROUTER\n310: // ─────────────────────────────────────────────────────────────────────────────\n311: \n312: function cellsOf(line) {\n313:   return line.trim().replace(/^\\|/u, '').replace(/\\|$/u, '').split('|').map((cell) => cell.trim());\n314: }\n315: \n316: // The rule a row points at, which is the identity the checker also compares. Matching on\n317: // the resolved path rather than the whole row is what lets a repository reword a summary\n318: // without the row reading as missing.\n319: function rulePathOf(cells) {\n320:   for (const cell of cells) {\n321:     const linked = /\\(([^)]+\\.md)\\)/u.exec(cell);\n322:     if (linked) return linked[1];\n323:     const bare = /`([^`]+\\.md)`/u.exec(cell);\n324:     if (bare) return bare[1];\n325:   }\n326:   return null;\n327: }\n328: \n329: function rowKey(cells) {\n330:   return rulePathOf(cells) || cells.join(' | ');\n331: }\n332: \n333: /**\n334:  * The rows of one router table, with the line each sits on.\n335:  *\n336:  * @param {string} text - The router document.\n337:  * @param {string} anchor - Text that identifies the table's heading.\n338:  * @returns {null|{lines: string[], rows: Array<{line: number, cells: string[]}>, insertAfter: number}}\n339:  *   Null when the document carries no such table.\n340:  */\n341: function routerTable(text, anchor) {\n342:   const lines = text.split('\\n');\n343:   const start = lines.findIndex((line) => line.startsWith('#') && line.includes(anchor));\n344:   if (start === -1) return null;\n345: \n346:   const rows = [];\n347:   let separator = -1;\n348:   let lastRow = -1;\n349:   for (let index = start + 1; index < lines.length; index += 1) {\n350:     const line = lines[index].trim();\n351:     if (line.startsWith('#')) break;\n352:     if (line === '') {\n353:       if (rows.length > 0) break;\n354:       continue;\n355:     }\n356:     if (!line.startsWith('|')) continue;\n357:     if (/^\\|[\\s:|-]+\\|$/u.test(line)) {\n358:       separator = index;\n359:       continue;\n360:     }\n361:     rows.push({ line: index, cells: cellsOf(line) });\n362:     lastRow = index;\n363:   }\n364: \n365:   const anchorLine = rows.length > 0 ? lastRow : separator;\n366:   if (anchorLine === -1) return null;\n367:   return { lines, rows, insertAfter: anchorLine };\n368: }\n369: \n370: /**\n371:  * The router with the shipped rows it is missing, added at the end of each table.\n372:  *\n373:  * @param {string} text\n374:  * @param {Object} manifest\n375:  * @returns {{text: string, added: {trigger: number, index: number}, notes: string[]}}\n376:  */\n377: function addRouterRows(text, manifest) {\n378:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n379:   const tables = [\n380:     { anchor: 'TRIGGER TABLE', rows: shipped.trigger_rows || [], kind: 'trigger' },\n381:     { anchor: 'INDEX', rows: shipped.index_rows || [], kind: 'index' },\n382:   ];\n383: \n384:   let next = text;\n385:   const added = { trigger: 0, index: 0 };\n386:   const notes = [];\n387: \n388:   for (const table of tables) {\n389:     const found = routerTable(next, table.anchor);\n390:     if (found === null) {\n391:       // A router without the table is a different document shape; appending one would\n392:       // number a second section and break the checker's own reading of the file.\n393:       notes.push(`router: no ${table.anchor} table in ${manifest.router_file}, so its shipped ${table.kind} rows were not added`);\n394:       continue;\n395:     }\n396:     const present = new Set(found.rows.map((row) => rowKey(row.cells)));\n397:     const missing = table.rows.filter((cells) => !present.has(rowKey(cells)));\n398:     if (missing.length === 0) continue;\n399:     const lines = found.lines.slice();\n400:     lines.splice(found.insertAfter + 1, 0, ...missing.map((cells) => `| ${cells.join(' | ')} |`));\n401:     next = lines.join('\\n');\n402:     added[table.kind] = missing.length;\n403:   }\n404: \n405:   return { text: next, added, notes };\n406: }\n407: \n408: // A repository with no router loads no rule at all, so the missing file is created from\n409: // the rows the template ships. Its prose stays short on purpose: a router holds no rules.\n410: function renderRouter(manifest) {\n411:   const shipped = (manifest.derived && manifest.derived.repo_rules) || { trigger_rows: [], index_rows: [] };\n412:   return [\n413:     '# REPO RULES',\n414:     '',\n415:     'Repo-local operating rules. `AGENTS.md` **Gate 5 (§2)** makes reading this mandatory',\n416:     'before your first write of the session. This document then routes you to every rule',\n417:     'file that governs what you are about to do. **It is a router, not a rulebook:** it',\n418:     'holds no rules of its own.',\n419:     '',\n420:     '---',\n421:     '',\n422:     '## 1. HOW TO USE THIS',\n423:     '',\n424:     '1. **Match on the action you are about to take**, not the topic of the request.',\n425:     '2. **Load before the action.** A rule read afterwards is a post-mortem.',\n426:     '3. **A file already in context is not re-read.**',\n427:     '4. **Nothing fires → `AGENTS.md` alone governs.** Do not hunt for a rule to apply.',\n428:     '',\n429:     'The rows below are the ones Skilled ships. Rows for this repository\\'s own rules go in',\n430:     'the same tables, authored one rule at a time.',\n431:     '',\n432:     '---',\n433:     '',\n434:     '## 2. TRIGGER TABLE',\n435:     '',\n436:     '| You are about to… | Load | It settles |',\n437:     '|-------------------|------|-----------|',\n438:     ...(shipped.trigger_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n439:     '',\n440:     '---',\n441:     '',\n442:     '## 3. INDEX',\n443:     '',\n444:     '| Rule | Summary |',\n445:     '|------|---------|',\n446:     ...(shipped.index_rows || []).map((cells) => `| ${cells.join(' | ')} |`),\n447:     '',\n448:     '---',\n449:     '',\n450:     'Each file the rows name is part of the installation and is replaced by a release.',\n451:     'Where a rule file appears to permit something `AGENTS.md` restricts, `AGENTS.md` wins.',\n452:     '',\n453:   ].join('\\n');\n454: }\n455: \n456: // ─────────────────────────────────────────────────────────────────────────────\n457: // 8. THE PLAN DIGEST\n458: // ─────────────────────────────────────────────────────────────────────────────\n459: \n460: // Every byte the run would put on disk, in a canonical order, keyed by the root it was\n461: // composed for and by the backup directory the plan takes: the same plan replayed against\n462: // an edited tree composes something else and cannot match, and a plan whose directory an\n463: // earlier run already owns is a different plan, so the digest covers which one it is.\n464: function planDigest(composition, plan) {\n465:   const written = composition.files\n466:     .filter((file) => file.action === 'create' || file.action === 'replace')\n467:     .map((file) => [file.path, file.action, sha256(file.content)])\n468:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n469:   const removed = composition.files\n470:     .filter((file) => file.action === 'remove')\n471:     .map((file) => [file.path, file.action, null])\n472:     .sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));\n473:   return sha256(JSON.stringify([composition.root, plan.base, plan.ordinal, ...written, ...removed]));\n474: }\n475: \n476: // Where each line of the old document sat, so a lost line is reported with the part it\n477: // belonged to. The block wins over the section it interrupts, because those bytes are the\n478: // repository's and not the section's.\n479: function placementOf(before) {\n480:   const places = new Map();\n481:   for (const section of before.sections) {\n482:     const place = section.id === null\n483:       ? { part: 1, from: 'unmarked section' }\n484:       : { part: 2, from: section.id };\n485:     for (const index of section.rows || []) places.set(index, place);\n486:   }\n487:   const preludeRows = before.prelude === null ? [] : before.prelude.rows;\n488:   for (const index of preludeRows) places.set(index, { part: 1, from: 'text before the first heading' });\n489:   if (before.block && before.block.complete && before.block.rows) {\n490:     for (let index = before.block.rows.first; index <= before.block.rows.last; index += 1) places.set(index, { part: 1, from: 'the block' });\n491:   }\n492:   return places;\n493: }\n494: \n495: // ─────────────────────────────────────────────────────────────────────────────\n496: // 9. THE PRESERVATION PROOF\n497: // ─────────────────────────────────────────────────────────────────────────────\n498: \n499: /**\n500:  * Prove that a composition lost nothing the repository had.\n501:  *\n502:  * Four claims, one per part of the returned record: every line of the old document no\n503:  * shipped body carries still sits in the new block; the local lines of a matched shipped\n504:  * section still sit there too, which the part number keeps distinct; the unique lines of a\n505:  * removed runtime copy still sit in the new document; and every line of the new document\n506:  * outside the block is one the template ships. Pure by construction: same inputs, same\n507:  * answer, no file read.\n508:  *\n509:  * The claim is read from the old document's own lines, in reading order, rather than from\n510:  * the parts the segmentation produced. A proof built from those parts can require only\n511:  * what the reader managed to place, so a line it placed nowhere would be required by\n512:  * nothing and a composition that lost it would still report `dropped 0`.\n513:  *\n514:  * @param {string|null} oldText - The document as it was.\n515:  * @param {string} newText - The document as it would be, or as it now is.\n516:  * @param {Object} manifest\n517:  * @param {{removed?: Array<{path: string, content: string}>}} [options]\n518:  * @returns {{dropped: Array<{part: number, line: string, before: number, after: number, from: string}>,\n519:  *   foreign: Array<{line: string}>}}\n520:  */\n521: function preservationCheck(oldText, newText, manifest, options = {}) {\n522:   const markers = manifest.markers;\n523:   const dropped = [];\n524:   const knownShipped = new Set();\n525:   for (const entry of Object.values(manifest.derived.sections || {})) {\n526:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n527:   }\n528:   for (const entry of manifest.derived.history || []) {\n529:     for (const line of lineSet(entry.body)) knownShipped.add(line);\n530:   }\n531: \n532:   // The framework's own bytes: the two markers and the heading and note that come with\n533:   // them. The new document carries one of each whatever the old one carried, so requiring\n534:   // them would report a duplicated block as repository lines the run dropped.\n535:   const framework = new Set([\n536:     markers.start.trim(),\n537:     markers.end.trim(),\n538:     markers.heading.trim(),\n539:     markers.note.trim(),\n540:   ]);\n541: \n542:   const before = oldText === null || oldText === undefined\n543:     ? { sections: [], block: null, prelude: null }\n544:     : segment(oldText, markers, manifest.sections);\n545:   const after = segment(newText, markers, manifest.sections);\n546:   const newBlock = after.block && after.block.complete ? after.block.content : '';\n547:   const newBlockCounts = countLines(newBlock);\n548:   const newDocumentCounts = countLines(newText);\n549: \n550:   const require = (line, part, from, need) => {\n551:     const have = part === 3 ? (newDocumentCounts.get(line) || 0) : (newBlockCounts.get(line) || 0);\n552:     if (have < need) dropped.push({ part, line, before: need, after: have, from });\n553:   };\n554: \n555:   // Parts 1 and 2. Every line of the old document that no known body carries has to be in\n556:   // the new block at least as often as it was there. Where the line sat decides only which\n557:   // part names it when it goes missing.\n558:   const places = placementOf(before);\n559:   const needed = new Map();\n560:   const oldLines = oldText === null || oldText === undefined ? [] : String(oldText).split('\\n');\n561:   for (let index = 0; index < oldLines.length; index += 1) {\n562:     const line = oldLines[index].trim();\n563:     if (line === '' || line === '---') continue;\n564:     if (framework.has(line) || knownShipped.has(line)) continue;\n565:     const place = places.get(index) || { part: 1, from: 'the document' };\n566:     const entry = needed.get(line);\n567:     if (entry === undefined) needed.set(line, { need: 1, part: place.part, from: place.from });\n568:     else entry.need += 1;\n569:   }\n570:   for (const [line, entry] of needed) require(line, entry.part, entry.from, entry.need);\n571: \n572:   // Part 3. Lines that only a runtime copy carried, counted against the whole document.\n573:   const oldDocumentCounts = oldText === null || oldText === undefined ? new Map() : countLines(oldText);\n574:   for (const copy of options.removed || []) {\n575:     for (const [line, count] of countLines(copy.content)) {\n576:       if (framework.has(line)) continue;\n577:       if ((oldDocumentCounts.get(line) || 0) > 0) continue;\n578:       require(line, 3, copy.path, count);\n579:     }\n580:   }\n581: \n582:   // Part 4. Nothing above the block that the template does not ship.\n583:   const currentOnly = new Set();\n584:   for (const entry of Object.values(manifest.derived.sections || {})) {\n585:     for (const line of lineSet(entry.body)) currentOnly.add(line);\n586:   }\n587:   const foreign = [];\n588:   // Section offsets are bytes and a JavaScript string is addressed in code units, so a\n589:   // document with any multi-byte character in it would otherwise be cut in the wrong place.\n590:   const newBytes = Buffer.from(newText, 'utf8');\n591:   const blockStart = after.block && after.block.complete ? after.block.start : newBytes.length;\n592:   const blockEnd = after.block && after.block.complete ? after.block.end : newBytes.length;\n593:   const outside = `${newBytes.subarray(0, blockStart).toString('utf8')}${newBytes.subarray(blockEnd).toString('utf8')}`;\n594:   for (const line of uniqueLines(outside)) {\n595:     if (!currentOnly.has(line)) foreign.push({ line });\n596:   }\n597: \n598:   return { dropped, foreign };\n599: }\n600: \n601: // ─────────────────────────────────────────────────────────────────────────────\n602: // 10. COMPOSITION\n603: // ─────────────────────────────────────────────────────────────────────────────\n604: \n605: function rowOf(report, id) {\n606:   return report.rows.find((row) => row.id === id) || { state: 'UNKNOWN', detail: '', lines: [], entries: [] };\n607: }\n608: \n609: function fileState(text) {\n610:   return { mode: '100644', blob: sha256(text), content: Buffer.from(text, 'utf8') };\n611: }\n612: \n613: function historyBodyOf(manifest, hash) {\n614:   if (!hash) return null;\n615:   const entry = (manifest.derived.history || []).find((row) => row.sha256 === hash);\n616:   return entry ? entry.body : null;\n617: }\n618: \n619: function prefixEndOf(text, manifest) {\n620:   if (text === null) return 0;\n621:   const { sections } = segment(text, manifest.markers, manifest.sections);\n622:   const byId = new Map();\n623:   for (const section of sections) if (section.id !== null) byId.set(section.id, section);\n624:   let end = 0;\n625:   for (const pin of (manifest.pins || []).filter((entry) => entry.kind === 'delivery-anchor')) {\n626:     const section = byId.get(pin.section);\n627:     if (!section) continue;\n628:     const measured = deliveryAnchorEnd(section, pin);\n629:     if (measured !== null) end = Math.max(end, measured);\n630:   }\n631:   return end;\n632: }\n633: \n634: /**\n635:  * Build every target of one repository in memory, with the ledger and the digest.\n636:  *\n637:  * Nothing here writes; the caller decides what to do with the answer.\n638:  *\n639:  * @param {{root: string, manifest: Object, keepClaudeMd?: boolean, createRouter?: boolean}} input\n640:  * @returns {Object} the composition\n641:  */\n642: function compose({ root, manifest, keepClaudeMd = false, createRouter = false }) {\n643:   const report = buildReport({ root, manifestPath: MANIFEST_PATH });\n644:   if (report === null) throw new PreconditionError(`cannot classify ${root}: the manifest at ${MANIFEST_PATH} produced no report`);\n645: \n646:   const markers = manifest.markers;\n647:   const rootFile = manifest.root_file;\n648:   const claudePointer = `@${manifest.root_file}\\n`;\n649:   const rootPath = path.join(root, rootFile);\n650:   // Writing through a link would change a file this repository does not own, and the backup\n651:   // could not put the link back.\n652:   if (isSymlink(rootPath)) {\n653:     throw new PreconditionError(`${rootFile} is a symlink to ${fs.readlinkSync(rootPath)}; writing through it would change a file outside this repository`);\n654:   }\n655:   const oldText = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : null;\n656: \n657:   const block = oldText === null ? null : findBlock(oldText, markers);\n658:   if (block !== null && (block.markerLines.start.length > 1 || block.markerLines.end.length > 1)) {\n659:     throw new PreconditionError(duplicateBlockMessage(rootFile, block));\n660:   }\n661:   if (block !== null && block.complete === false) {\n662:     throw new PreconditionError(`the repository block in ${rootFile} carries one of its two markers and not the other, near byte ${block.start}; the block cannot be placed, so nothing can be carried out of it`);\n663:   }\n664: \n665:   const oldSegmentation = oldText === null\n666:     ? { sections: [], block: null, prelude: null }\n667:     : segment(oldText, markers, manifest.sections);\n668:   const oldSections = oldSegmentation.sections;\n669:   const shipped = manifest.sections.map((entry) => manifest.derived.sections[entry.id].body).join('');\n670:   const notes = [];\n671:   const chunks = [];\n672: \n673:   // (a) Whatever the block already held.\n674:   if (block !== null && block.complete) {\n675:     const body = blockBody(block.content, markers);\n676:     if (body !== '') chunks.push({ kind: 'block', text: body, lines: lineCount(body) });\n677:   }\n678: \n679:   // Text above the first heading belongs to no section, and a replacement would drop it.\n680:   // The segmenter reports it apart from the sections because no heading covers it.\n681:   if (oldSegmentation.prelude !== null) {\n682:     const preamble = chunkText(oldSegmentation.prelude.text);\n683:     if (preamble !== '') {\n684:       chunks.push({ kind: 'preamble', text: preamble, lines: lineCount(preamble) });\n685:     }\n686:   }\n687: \n688:   // (b) Sections no shipped entry matches, verbatim and in document order. The text above\n689:   // the first heading is already carried as the preamble, and its byte range would reach\n690:   // a block written above the template, so it is the one entry skipped here.\n691:   const unmarkedRow = rowOf(report, 'A8');\n692:   const oldBuffer = oldText === null ? Buffer.alloc(0) : Buffer.from(oldText, 'utf8');\n693:   const unmarked = unmarkedRow.entries\n694:     .filter((entry) => entry.heading !== null)\n695:     .sort((left, right) => left.byte_start - right.byte_start);\n696:   for (const entry of unmarked) {\n697:     const text = chunkText(oldBuffer.subarray(entry.byte_start, entry.byte_end).toString('utf8'));\n698:     if (text === '') continue;\n699:     chunks.push({ kind: 'unmarked', id: entry.heading, text, lines: lineCount(text) });\n700:   }\n701: \n702:   // (c) The local lines of a section somebody edited, each under its own id.\n703:   const edited = rowOf(report, 'A4').entries.filter((entry) => entry.state === 'edited' || entry.state === 'unknown-base');\n704:   for (const entry of edited) {\n705:     const section = oldSections.find((candidate) => candidate.id === entry.id);\n706:     if (!section) continue;\n707:     const shippedBody = manifest.derived.sections[entry.id] ? manifest.derived.sections[entry.id].body : '';\n708:     const lines = localLinesOf(section.body, shippedBody);\n709:     if (lines.length === 0) continue;\n710:     chunks.push({\n711:       kind: 'edited',\n712:       id: entry.id,\n713:       lines: lines.length,\n714:       text: [`### Carried from ${entry.id}`, ...lines].join('\\n'),\n715:     });\n716: \n717:     // A clean merge would leave the section edited forever, so it is offered as a reading\n718:     // of the same bytes and never as the default.\n719:     const base = historyBodyOf(manifest, entry.base);\n720:     if (base !== null) {\n721:       const merged = classifyFile(fileState(base), fileState(section.body), fileState(shippedBody));\n722:       if (merged.conflictKind === 'mergeable') {\n723:         notes.push(`merge: ${entry.id} could be merged in place against its released body; adopt-and-carry is still the default, because a merged section stays edited for every later release`);\n724:       }\n725:     }\n726:   }\n727: \n728:   // (d) The unique lines of a runtime copy that is folded away.\n729:   const copies = rowOf(report, 'A10').entries.filter((entry) => FOLDED_COPIES.includes(entry.path));\n730:   const removedCopies = [];\n731:   for (const copy of copies) {\n732:     const absolute = path.join(root, copy.path);\n733:     if (!fs.existsSync(absolute) || isSymlink(absolute)) continue;\n734:     if (copy.state !== 'FINDING') continue;\n735:     const content = fs.readFileSync(absolute, 'utf8');\n736:     // With no root document every line of the copy is its own, and the count has to survive:\n737:     // the proof compares occurrences, not membership, so a repeated line stays repeated.\n738:     const lines = localLinesOf(content, oldText === null ? '' : oldText);\n739:     if (lines.length > 0) {\n740:       chunks.push({\n741:         kind: 'copy',\n742:         path: copy.path,\n743:         lines: lines.length,\n744:         text: [`### Carried from ${copy.path}`, ...lines].join('\\n'),\n745:       });\n746:     }\n747:     removedCopies.push({ path: copy.path, content });\n748:     if (copy.path === 'CLAUDE.md' && keepClaudeMd) {\n749:       removedCopies.pop();\n750:       if (lines.length > 0) {\n751:         notes.push(`claude: ${copy.path} carries lines no other file has; they moved into the block and the file stays because --keep-claude-md was given`);\n752:       }\n753:     }\n754:   }\n755: \n756:   const blockText = chunks.map((chunk) => chunkText(chunk.text)).filter((text) => text !== '').join('\\n\\n');\n757:   const composed = `${shipped}${renderBlock(markers, blockText)}`;\n758: \n759:   // The template with nothing of the repository's own in it gains nothing from the two\n760:   // marker lines, so that difference alone is not a reason to write: the markers appear\n761:   // with the first line worth keeping.\n762:   const templateOnly = oldText !== null && block === null && blockText === '' && oldText === shipped;\n763:   if (templateOnly) {\n764:     notes.push(`block: the template is already current and this repository carries nothing of its own, so no empty block is written`);\n765:   }\n766: \n767:   const files = [];\n768:   if (templateOnly || oldText === composed) {\n769:     files.push({ path: rootFile, action: 'unchanged', content: null, before: oldText });\n770:   } else {\n771:     files.push({\n772:       path: rootFile,\n773:       action: oldText === null ? 'create' : 'replace',\n774:       content: composed,\n775:       before: oldText,\n776:     });\n777:   }\n778: \n779:   // The router gains the shipped rows it is missing, or is created from them when asked.\n780:   const routerPath = path.join(root, manifest.router_file);\n781:   let routerAction = 'unchanged';\n782:   let routerText = null;\n783:   if (fs.existsSync(routerPath)) {\n784:     const current = fs.readFileSync(routerPath, 'utf8');\n785:     const result = addRouterRows(current, manifest);\n786:     notes.push(...result.notes);\n787:     if (result.text !== current) {\n788:       routerText = result.text;\n789:       routerAction = 'replace';\n790:       if (result.added.trigger > 0 || result.added.index > 0) {\n791:         notes.push(`router: ${result.added.trigger} trigger row(s) and ${result.added.index} index row(s) added; no other row was touched`);\n792:       }\n793:     }\n794:   } else if (createRouter) {\n795:     routerText = renderRouter(manifest);\n796:     routerAction = 'create';\n797:   } else {\n798:     routerAction = 'absent';\n799:     notes.push(`router: no ${manifest.router_file}, so no repository rule can load; pass --create-router to create one from the shipped rows`);\n800:   }\n801:   files.push({ path: manifest.router_file, action: routerAction, content: routerText, before: fs.existsSync(routerPath) ? fs.readFileSync(routerPath, 'utf8') : null });\n802: \n803:   // The Cursor mirror exists exactly when the block carries something, because an empty\n804:   // block has nothing a runtime that cannot read past the prefix would miss.\n805:   const mirrorPath = path.join(root, MIRROR_FILE);\n806:   const mirrorExists = fs.existsSync(mirrorPath);\n807:   let mirrorAction = 'unchanged';\n808:   let mirrorText = null;\n809:   if (blockText !== '') {\n810:     mirrorText = renderMirror(markers, blockText);\n811:     if (!mirrorExists) mirrorAction = 'create';\n812:     else if (fs.readFileSync(mirrorPath, 'utf8') !== mirrorText) mirrorAction = 'replace';\n813:   } else if (mirrorExists) {\n814:     mirrorAction = 'remove';\n815:   }\n816:   if (mirrorAction !== 'unchanged') {\n817:     files.push({\n818:       path: MIRROR_FILE,\n819:       action: mirrorAction,\n820:       content: mirrorText,\n821:       before: mirrorExists ? fs.readFileSync(mirrorPath, 'utf8') : null,\n822:     });\n823:   }\n824: \n825:   for (const copy of removedCopies) {\n826:     if (copy.path === CLAUDE_POINTER_PATH) {\n827:       files.push({ path: copy.path, action: 'replace', content: claudePointer, before: copy.content });\n828:       continue;\n829:     }\n830:     files.push({ path: copy.path, action: 'remove', content: null, before: copy.content });\n831:   }\n832: \n833:   // Claude Code reads only CLAUDE.md, so the pointer is its one route to the root document.\n834:   const claudePath = path.join(root, CLAUDE_POINTER_PATH);\n835:   if (\n836:     files.some((file) => ['create', 'replace', 'remove'].includes(file.action))\n837:     && !fs.existsSync(claudePath)\n838:     && !isSymlink(claudePath)\n839:   ) {\n840:     files.push({ path: CLAUDE_POINTER_PATH, action: 'create', content: claudePointer, before: null });\n841:   }\n842: \n843:   const composition = {\n844:     root,\n845:     state: report.state,\n846:     report,\n847:     markers,\n848:     rootFile,\n849:     oldText,\n850:     composed,\n851:     block: { text: renderBlock(markers, blockText), body: blockText },\n852:     chunks,\n853:     removedCopies,\n854:     notes,\n855:     files,\n856:     budget: {\n857:       before: { prefix: prefixEndOf(oldText, manifest), total: oldText === null ? 0 : Buffer.byteLength(oldText, 'utf8') },\n858:       after: { prefix: prefixEndOf(composed, manifest), total: Buffer.byteLength(composed, 'utf8') },\n859:       limits: { prefix: manifest.budget.prefix_bytes, total: manifest.budget.max_bytes },\n860:     },\n861:     ledger: {\n862:       kept: chunks.filter((chunk) => ['block', 'preamble', 'unmarked', 'edited'].includes(chunk.kind)).reduce((sum, chunk) => sum + chunk.lines, 0),\n863:       carried: chunks.filter((chunk) => chunk.kind === 'copy').reduce((sum, chunk) => sum + chunk.lines, 0),\n864:       shippedReplaced: manifest.sections.length,\n865:       dropped: 0,\n866:     },\n867:   };\n868: \n869:   // What the run would put on disk, which is exactly the three actions a target can take.\n870:   composition.writes = composition.files.filter((file) => ['create', 'replace', 'remove'].includes(file.action));\n871:   return composition;\n872: }\n873: \n874: // ─────────────────────────────────────────────────────────────────────────────\n875: // 11. THE WRITE ALLOWLIST\n876: // ─────────────────────────────────────────────────────────────────────────────\n877: \n878: /**\n879:  * Resolve one path a run wants to touch, or refuse it.\n880:  *\n881:  * Containment is checked before membership, so a path that climbs out of the root is\n882:  * reported as what it is rather than as a missing allowlist entry.\n883:  *\n884:  * @param {string} root\n885:  * @param {string} relative\n886:  * @returns {string} the absolute path\n887:  */\n888: function assertWritable(root, relative) {\n889:   const base = path.resolve(root);\n890:   const normalized = String(relative).split(path.sep).join('/');\n891:   const absolute = path.resolve(base, normalized);\n892:   if (absolute !== path.join(base, normalized) || !absolute.startsWith(base + path.sep)) {\n893:     throw new AllowlistError(`${relative} resolves outside the target root ${base}`);\n894:   }\n895:   if (!ALLOWLIST.includes(normalized)) {\n896:     throw new AllowlistError(`${relative} is not on the write allowlist (${ALLOWLIST.join(', ')})`);\n897:   }\n898:   // Every path a run reaches must sit inside the root where the root really is, not only\n899:   // under its name: a link inside the tree can aim a legal-looking path at a file outside it.\n900:   const realBase = fs.realpathSync(base);\n901:   const realTarget = resolveThroughLinks(absolute);\n902:   if (realTarget !== realBase && !realTarget.startsWith(realBase + path.sep)) {\n903:     throw new AllowlistError(`${relative} resolves outside the target root ${realBase} through a link`);\n904:   }\n905:   return absolute;\n906: }\n907: \n908: // The real path of a path that may not exist yet: the nearest existing ancestor is resolved\n909: // and the rest of the name is appended to it.\n910: function resolveThroughLinks(absolute) {\n911:   try {\n912:     return fs.realpathSync(absolute);\n913:   } catch {\n914:     const parent = path.dirname(absolute);\n915:     if (parent === absolute) return absolute;\n916:     return path.join(resolveThroughLinks(parent), path.basename(absolute));\n917:   }\n918: }\n919: \n920: // ─────────────────────────────────────────────────────────────────────────────\n921: // 12. BACKUPS\n922: // ─────────────────────────────────────────────────────────────────────────────\n923: \n924: function utcStamp(date = new Date()) {\n925:   return date.toISOString().replace(/[-:]/gu, '').replace(/\\.\\d+Z$/u, 'Z');\n926: }\n927: \n928: /**\n929:  * The directory a plan's backup sits in, named after the plan digest.\n930:  *\n931:  * Named by the digest rather than by a clock reading because apply has to land exactly\n932:  * where the plan pointed and the digest is the only thing the operator carries across. The\n933:  * consequence is that a directory is a plan's own: a second plan of the same work finds it\n934:  * taken and moves to the next ordinal instead of writing beside it.\n935:  *\n936:  * @param {string} base\n937:  * @param {string} digest\n938:  * @returns {string}\n939:  */\n940: function backupDirectoryOf(base, digest) {\n941:   return path.join(base, digest.slice(0, BACKUP_NAME_CHARS));\n942: }\n943: \n944: /**\n945:  * Where a run's backup goes, without creating anything.\n946:  *\n947:  * The output directory is used only when git ignores it, because a backup inside a tracked\n948:  * path is a backup the next commit publishes. Everything else leaves the repository.\n949:  *\n950:  * @param {{root: string}} input\n951:  * @returns {{dir: string, fallback: boolean, reason: string}}\n952:  */\n953: function backupBase({ root }) {\n954:   const candidate = path.join(root, BACKUP_DIR);\n955:   // The question is the one the run depends on: would a plan directory under this one be\n956:   // published by the next commit? Asking about the base alone would miss a rule written as\n957:   // `.skilled/output/*`, which ignores the per-plan directories and not their parent, so\n958:   // the probe is a path of the same shape as the one the plan takes.\n959:   const probe = path.join(candidate, 'probe');\n960:   const ignored = spawnSync('git', ['-C', root, '-c', 'core.fsmonitor=false', 'check-ignore', '-q', probe], {\n961:     encoding: 'utf8',\n962:     timeout: TOOL_TIMEOUT_MS,\n963:   });\n964:   if (ignored.status === 0) return { dir: candidate, fallback: false, reason: '' };\n965:   const reason = ignored.status === 1\n966:     ? `git does not ignore ${BACKUP_DIR} under ${root}`\n967:     : `git cannot answer whether ${BACKUP_DIR} is ignored under ${root} (exit ${ignored.status})`;\n968:   return { dir: path.join(os.tmpdir(), BACKUP_FALLBACK_DIR), fallback: true, reason };\n969: }\n970: \n971: /**\n972:  * The plan a run stands on: the composition, plus where its backup goes and the digest\n973:  * that says both.\n974:  *\n975:  * The loop is what makes a re-plan honest. A directory an earlier run already holds is not\n976:  * suffixed into a second name, because the printed undo command would then point at that\n977:  * run's bytes; the next ordinal is a different plan with a different digest and a\n978:  * directory of its own.\n979:  *\n980:  * @param {Object} composition\n981:  * @returns {{dir: string, fallback: boolean, reason: string, digest: string, ordinal: number, base: string}}\n982:  */\n983: function planFor(composition) {\n984:   const base = backupBase({ root: composition.root });\n985:   for (let ordinal = 0; ordinal < BACKUP_ATTEMPTS; ordinal += 1) {\n986:     const digest = planDigest(composition, { ordinal, base: base.dir });\n987:     const dir = backupDirectoryOf(base.dir, digest);\n988:     if (!fs.existsSync(dir)) return { dir, fallback: base.fallback, reason: base.reason, digest, ordinal, base: base.dir };\n989:   }\n990:   throw new PreconditionError(`every backup directory for this composition under ${base.dir} is taken, so nothing was written`);\n991: }\n992: \n993: // The folders a new file needs that do not exist yet, deepest first. A restore removes\n994: // only these, so on a record the run wrote, a folder that was there before the run is never\n995: // taken away with it.\n996: function missingParents(root, relative) {\n997:   const missing = [];\n998:   let dir = path.posix.dirname(relative);\n999:   while (dir !== '.' && dir !== '' && !fs.existsSync(path.join(root, dir))) {\n1000:     missing.push(dir);\n1001:     dir = path.posix.dirname(dir);\n1002:   }\n1003:   return missing;\n1004: }\n1005: \n1006: // A record is data, so a recorded folder counts only while it is a proper ancestor of the\n1007: // entry's own allowlisted path; the list stops at the first one that is not.\n1008: function recordedCreatedDirs(entry) {\n1009:   const dirs = [];\n1010:   if (entry.existed || !Array.isArray(entry.createdDirs)) return dirs;\n1011:   for (const dir of entry.createdDirs) {\n1012:     if (typeof dir !== 'string' || dir === '' || dir.split('/').includes('..') || !entry.path.startsWith(`${dir}/`)) break;\n1013:     dirs.push(dir);\n1014:   }\n1015:   return dirs;\n1016: }\n1017: \n1018: // Runs after every file is back, because two new files can share one new folder. Only the\n1019: // folders above a file this restore just deleted are considered, and only an empty one is\n1020: // removed, so a hand-edited record can at most take away an empty folder on the path to a\n1021: // file the run created.\n1022: function removeCreatedDirs(root, entries, deleted) {\n1023:   const removed = [];\n1024:   for (const entry of entries) {\n1025:     if (!deleted.has(entry.path)) continue;\n1026:     for (const dir of recordedCreatedDirs(entry)) {\n1027:       const absolute = path.join(root, dir);\n1028:       let names;\n1029:       try { names = fs.readdirSync(absolute); } catch { continue; }\n1030:       if (names.length > 0) break;\n1031:       fs.rmdirSync(absolute);\n1032:       removed.push(dir);\n1033:     }\n1034:   }\n1035:   return removed;\n1036: }\n1037: \n1038: // What one path looked like before the run, kept beside a copy of it so a restore is a\n1039: // copy rather than a reconstruction.\n1040: function backupEntry(root, file) {\n1041:   const absolute = path.join(root, file.path);\n1042:   const exists = fs.existsSync(absolute);\n1043:   const entry = { path: file.path, action: file.action, existed: exists, sha256: null, backup: null, mode: null, symlink: false };\n1044:   if (!exists) {\n1045:     entry.createdDirs = missingParents(root, file.path);\n1046:     return entry;\n1047:   }\n1048:   const stats = fs.lstatSync(absolute);\n1049:   entry.mode = stats.mode.toString(8).slice(-4);\n1050:   entry.symlink = stats.isSymbolicLink();\n1051:   const bytes = fs.readFileSync(absolute);\n1052:   entry.sha256 = sha256(bytes.toString('utf8'));\n1053:   entry.backup = path.posix.join('files', file.path);\n1054:   return entry;\n1055: }\n1056: \n1057: function writeBackup({ root, manifest, composition, plan }) {\n1058:   // The plan chose a directory nothing owned, so a directory here is somebody else's run\n1059:   // finishing first: writing beside its record would make the undo ambiguous.\n1060:   if (fs.existsSync(plan.dir)) {\n1061:     throw new PreconditionError(`the backup directory ${plan.dir} already exists; nothing was written`);\n1062:   }\n1063:   fs.mkdirSync(plan.dir, { recursive: true });\n1064: \n1065:   const entries = [];\n1066:   for (const file of composition.writes) entries.push(backupEntry(root, file));\n[Output truncated. Continue reading with offset: 1067]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\"}"},"time":{"start":1794558674490,"end":1794558675068}}}}
