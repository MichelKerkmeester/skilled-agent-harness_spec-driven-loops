{"type":"tool_use","timestamp":1794558713973,"sessionID":"ses_e2bf9637cffehsWt94nfgLxMyQ","part":{"partID":"prt_1d408dd83002pbEWFmNJ0UIp0J","sessionID":"ses_e2bf9637cffehsWt94nfgLxMyQ","messageID":"msg_1d4084dcc001vuP66XWCu87As7","type":"tool","id":"call_1c9a2034268b43dab5a3204c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs","offset":1067,"limit":600},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1067-1599\n1067:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1068:   // would touch it, even though this engine composes nothing for it.\n1069:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1070:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1071:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1072:   }\n1073: \n1074:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1075:   // the rollback must not share a path with the writer it exists to undo.\n1076:   for (const entry of entries) {\n1077:     if (!entry.existed) continue;\n1078:     const destination = path.join(plan.dir, entry.backup);\n1079:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1080:     fs.copyFileSync(path.join(root, entry.path), destination);\n1081:   }\n1082: \n1083:   const record = {\n1084:     schema: 1,\n1085:     root,\n1086:     created_at: utcStamp(),\n1087:     plan_digest: plan.digest,\n1088:     paths: entries,\n1089:   };\n1090:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1091:   return record;\n1092: }\n1093: \n1094: // ─────────────────────────────────────────────────────────────────────────────\n1095: // 13. THE DIFF\n1096: // ─────────────────────────────────────────────────────────────────────────────\n1097: \n1098: function diffLines(text) {\n1099:   if (text === null) return [];\n1100:   const lines = String(text).split('\\n');\n1101:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1102:   return lines;\n1103: }\n1104: \n1105: function diffOps(left, right) {\n1106:   const rows = left.length + 1;\n1107:   const columns = right.length + 1;\n1108:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1109:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1110:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1111:       table[i][j] = left[i] === right[j]\n1112:         ? table[i + 1][j + 1] + 1\n1113:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1114:     }\n1115:   }\n1116:   const ops = [];\n1117:   let i = 0;\n1118:   let j = 0;\n1119:   while (i < left.length && j < right.length) {\n1120:     if (left[i] === right[j]) {\n1121:       ops.push({ kind: ' ', text: left[i] });\n1122:       i += 1;\n1123:       j += 1;\n1124:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1125:       ops.push({ kind: '-', text: left[i] });\n1126:       i += 1;\n1127:     } else {\n1128:       ops.push({ kind: '+', text: right[j] });\n1129:       j += 1;\n1130:     }\n1131:   }\n1132:   while (i < left.length) {\n1133:     ops.push({ kind: '-', text: left[i] });\n1134:     i += 1;\n1135:   }\n1136:   while (j < right.length) {\n1137:     ops.push({ kind: '+', text: right[j] });\n1138:     j += 1;\n1139:   }\n1140:   return ops;\n1141: }\n1142: \n1143: /**\n1144:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1145:  *\n1146:  * @param {string|null} beforeText\n1147:  * @param {string|null} afterText\n1148:  * @param {string} relative\n1149:  * @returns {string[]}\n1150:  */\n1151: function unifiedDiff(beforeText, afterText, relative) {\n1152:   const left = diffLines(beforeText);\n1153:   const right = diffLines(afterText);\n1154:   const ops = diffOps(left, right);\n1155:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1156: \n1157:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1158:   const hunks = [];\n1159:   for (const index of changed) {\n1160:     const start = Math.max(0, index - 3);\n1161:     const end = Math.min(ops.length, index + 4);\n1162:     const last = hunks[hunks.length - 1];\n1163:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1164:     else hunks.push({ start, end });\n1165:   }\n1166: \n1167:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1168:   let consumed = 0;\n1169:   for (const hunk of hunks) {\n1170:     // A create has no left side and a removal has no right side, so their cursors start at\n1171:     // zero rather than at the first line of a file that is not there.\n1172:     let leftCursor = beforeText === null ? 0 : 1;\n1173:     let rightCursor = afterText === null ? 0 : 1;\n1174:     for (let index = 0; index < hunk.start; index += 1) {\n1175:       if (ops[index].kind !== '+') leftCursor += 1;\n1176:       if (ops[index].kind !== '-') rightCursor += 1;\n1177:     }\n1178:     const slice = ops.slice(hunk.start, hunk.end);\n1179:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1180:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1181:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1182:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1183:     consumed += slice.length;\n1184:   }\n1185:   return consumed === 0 ? [] : output;\n1186: }\n1187: \n1188: // ─────────────────────────────────────────────────────────────────────────────\n1189: // 14. THE PLAN\n1190: // ─────────────────────────────────────────────────────────────────────────────\n1191: \n1192: function renderTargets(composition) {\n1193:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1194: }\n1195: \n1196: function renderPlan(composition, plan) {\n1197:   const lines = [];\n1198:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1199:   lines.push(...renderTargets(composition));\n1200:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1201: \n1202:   for (const file of composition.writes) {\n1203:     if (file.action === 'remove') {\n1204:       lines.push(`diff ${file.path}:`);\n1205:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1206:       continue;\n1207:     }\n1208:     const diff = unifiedDiff(file.before, file.content, file.path);\n1209:     lines.push(`diff ${file.path}:`);\n1210:     if (diff.length === 0) lines.push('  (no line changes)');\n1211:     lines.push(...diff);\n1212:   }\n1213: \n1214:   lines.push('block:');\n1215:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1216:   lines.push('block-end:');\n1217: \n1218:   const { before, after, limits } = composition.budget;\n1219:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1220:   if (after.total > limits.total) {\n1221:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1222:   }\n1223:   if (after.prefix > limits.prefix) {\n1224:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1225:   }\n1226: \n1227:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1228:   lines.push(`backup: ${plan.dir}`);\n1229:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1230:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1231:   lines.push(`plan-digest: ${plan.digest}`);\n1232:   return lines;\n1233: }\n1234: \n1235: function renderDropped(dropped) {\n1236:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1237: }\n1238: \n1239: // ─────────────────────────────────────────────────────────────────────────────\n1240: // 15. PLAN\n1241: // ─────────────────────────────────────────────────────────────────────────────\n1242: \n1243: function preflight(composition, manifest) {\n1244:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1245: }\n1246: \n1247: function commandPlan(options, output, hooks) {\n1248:   const manifest = loadManifest();\n1249:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1250: \n1251:   const checked = preflight(composition, manifest);\n1252:   composition.ledger.dropped = checked.dropped.length;\n1253: \n1254:   if (composition.writes.length === 0) {\n1255:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1256:     for (const note of composition.notes) output.log(`note: ${note}`);\n1257:     output.log('NOTHING TO DO');\n1258:     return 0;\n1259:   }\n1260: \n1261:   const plan = planFor(composition);\n1262:   for (const line of renderPlan(composition, plan)) output.log(line);\n1263:   if (checked.dropped.length > 0) {\n1264:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1265:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1266:     output.warn('STATUS=FAIL');\n1267:     return 1;\n1268:   }\n1269:   if (options.dryRun) output.log('dry-run: nothing was written');\n1270:   return 0;\n1271: }\n1272: \n1273: // ─────────────────────────────────────────────────────────────────────────────\n1274: // 16. APPLY\n1275: // ─────────────────────────────────────────────────────────────────────────────\n1276: \n1277: function runTool(script, args) {\n1278:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1279:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1280:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1281:   return { code: result.status, output };\n1282: }\n1283: \n1284: function restoreFromBackup({ root, dir, output }) {\n1285:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1286:   let restored = 0;\n1287:   const deleted = new Set();\n1288:   for (const entry of record.paths) {\n1289:     const target = path.join(root, entry.path);\n1290:     if (!entry.existed) {\n1291:       if (fs.existsSync(target)) {\n1292:         fs.rmSync(target);\n1293:         deleted.add(entry.path);\n1294:       }\n1295:       continue;\n1296:     }\n1297:     const source = path.join(dir, entry.backup);\n1298:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1299:     fs.copyFileSync(source, target);\n1300:     restored += 1;\n1301:   }\n1302:   removeCreatedDirs(root, record.paths, deleted);\n1303:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1304:   return restored;\n1305: }\n1306: \n1307: function commandApply(options, output, hooks) {\n1308:   if (!options.digest) {\n1309:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1310:     return 2;\n1311:   }\n1312: \n1313:   const manifest = loadManifest();\n1314:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1315: \n1316:   // A tree already in its target state has nothing a digest could authorise.\n1317:   if (composition.writes.length === 0) {\n1318:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1319:     output.log('NOTHING TO DO');\n1320:     return 0;\n1321:   }\n1322: \n1323:   const plan = planFor(composition);\n1324:   if (plan.digest !== options.digest) {\n1325:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1326:     // already happened gets told which directory holds those bytes instead of a claim\n1327:     // about the tree that would be false.\n1328:     const held = backupDirectoryOf(plan.base, options.digest);\n1329:     if (fs.existsSync(held)) {\n1330:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1331:       return 2;\n1332:     }\n1333:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1334:     return 2;\n1335:   }\n1336: \n1337:   // The same proof the plan ran, because a composition that already loses a line must\n1338:   // never reach a backup, let alone the tree.\n1339:   const checked = preflight(composition, manifest);\n1340:   composition.ledger.dropped = checked.dropped.length;\n1341:   if (checked.dropped.length > 0) {\n1342:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1343:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1344:     output.warn('STATUS=FAIL');\n1345:     return 1;\n1346:   }\n1347: \n1348:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1349:   // the run before a backup exists rather than after a partial write.\n1350:   const targets = [];\n1351:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1352: \n1353:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1354:   // here, where every precondition has already passed and nothing has been created.\n1355:   if (options.dryRun) {\n1356:     for (const line of renderPlan(composition, plan)) output.log(line);\n1357:     output.log('dry-run: nothing was written');\n1358:     return 0;\n1359:   }\n1360: \n1361:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1362:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1363: \n1364:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1365:   for (const target of targets) {\n1366:     if (target.file.action === 'remove') {\n1367:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1368:       output.log(`removed ${target.file.path} (backed up first)`);\n1369:       continue;\n1370:     }\n1371:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1372:     write(target.absolute, target.file.content);\n1373:     output.log(`wrote ${target.file.path}`);\n1374:   }\n1375: \n1376:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1377:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1378:   if (rootTouched) {\n1379:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1380:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1381:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1382:   }\n1383:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1384:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1385:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1386:     output.log(`repo-rules: ${summary}`);\n1387:   }\n1388: \n1389:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1390:   const rootPath = path.join(options.root, manifest.root_file);\n1391:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1392:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1393:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1394: \n1395:   if (after.dropped.length > 0) {\n1396:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1397:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1398:     output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1399:     output.warn('STATUS=FAIL');\n1400:     return 1;\n1401:   }\n1402: \n1403:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1404:   if (report !== null) {\n1405:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1406:   }\n1407:   output.log(`backup: ${plan.dir}`);\n1408:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1409:   for (const entry of record.paths) {\n1410:     if (!entry.existed) continue;\n1411:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1412:   }\n1413:   output.log('STATUS=OK');\n1414:   return 0;\n1415: }\n1416: \n1417: // ─────────────────────────────────────────────────────────────────────────────\n1418: // 17. RESTORE\n1419: // ─────────────────────────────────────────────────────────────────────────────\n1420: \n1421: function readConfirmation() {\n1422:   try {\n1423:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1424:   } catch {\n1425:     return '';\n1426:   }\n1427: }\n1428: \n1429: function commandRestore(options, output, hooks) {\n1430:   if (!options.run) {\n1431:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1432:     return 2;\n1433:   }\n1434:   const recordPath = path.join(options.run, 'manifest.json');\n1435:   if (!fs.existsSync(recordPath)) {\n1436:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1437:     return 2;\n1438:   }\n1439: \n1440:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1441:   const root = record.root;\n1442:   // The record names its own root, and a record is data: it is trusted only when it names\n1443:   // the root this restore runs against, so a record repointed at another folder is refused\n1444:   // instead of written to. Restoring another folder takes --root naming that folder.\n1445:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1446:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1447:     return 2;\n1448:   }\n1449:   const steps = [];\n1450:   for (const entry of record.paths) {\n1451:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1452:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1453:     const absolute = assertWritable(root, entry.path);\n1454:     if (!entry.existed) {\n1455:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1456:       continue;\n1457:     }\n1458:     const source = path.join(options.run, entry.backup);\n1459:     if (!fs.existsSync(source)) {\n1460:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1461:       return 2;\n1462:     }\n1463:     const bytes = fs.readFileSync(source);\n1464:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1465:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1466:       return 2;\n1467:     }\n1468:     steps.push({ entry, absolute, action: 'put back', bytes });\n1469:   }\n1470: \n1471:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1472:   for (const step of steps) {\n1473:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1474:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1475:       : '';\n1476:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1477:   }\n1478:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1479:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1480: \n1481:   if (options.dryRun) {\n1482:     output.log('dry-run: nothing was written');\n1483:     return 0;\n1484:   }\n1485: \n1486:   if (!options.yes) {\n1487:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1488:     if (readConfirmation() !== 'yes') {\n1489:       output.log('cancelled: no confirmation, nothing was written');\n1490:       return 1;\n1491:     }\n1492:   }\n1493: \n1494:   let touched = 0;\n1495:   const deleted = new Set();\n1496:   for (const step of steps) {\n1497:     if (step.action === 'delete') {\n1498:       fs.rmSync(step.absolute);\n1499:       deleted.add(step.entry.path);\n1500:       touched += 1;\n1501:       continue;\n1502:     }\n1503:     if (step.action === 'absent') continue;\n1504:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1505:     fs.writeFileSync(step.absolute, step.bytes);\n1506:     touched += 1;\n1507:   }\n1508:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1509: \n1510:   // Byte equality after the write, measured against the recorded hash rather than against\n1511:   // the copy that was just read.\n1512:   for (const step of steps) {\n1513:     if (step.action === 'delete' || step.action === 'absent') continue;\n1514:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1515:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1516:       output.warn('STATUS=FAIL');\n1517:       return 1;\n1518:     }\n1519:   }\n1520: \n1521:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1522:   output.log('STATUS=OK');\n1523:   return 0;\n1524: }\n1525: \n1526: // ─────────────────────────────────────────────────────────────────────────────\n1527: // 18. MAIN\n1528: // ─────────────────────────────────────────────────────────────────────────────\n1529: \n1530: function outputOf(hooks) {\n1531:   return {\n1532:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1533:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1534:   };\n1535: }\n1536: \n1537: /**\n1538:  * @param {string[]} argv\n1539:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1540:  * @returns {number} the process exit code\n1541:  */\n1542: function main(argv, hooks = {}) {\n1543:   const options = parseArgs(argv);\n1544:   const output = outputOf(hooks);\n1545:   if (options.help) {\n1546:     output.log(USAGE);\n1547:     return 0;\n1548:   }\n1549:   if (options.command === null) {\n1550:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1551:     return 2;\n1552:   }\n1553:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1554:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1555:     return 2;\n1556:   }\n1557: \n1558:   try {\n1559:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1560:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1561:     return commandRestore(options, output, hooks);\n1562:   } catch (error) {\n1563:     if (error instanceof AllowlistError) {\n1564:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1565:       return 2;\n1566:     }\n1567:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1568:       output.warn(`${TAG} ERROR: ${error.message}`);\n1569:       if (error instanceof UsageError) output.warn(USAGE);\n1570:       return 2;\n1571:     }\n1572:     throw error;\n1573:   }\n1574: }\n1575: \n1576: if (require.main === module) {\n1577:   try {\n1578:     process.exitCode = main(process.argv.slice(2));\n1579:   } catch (error) {\n1580:     console.error(`${TAG} ERROR: ${error.message}`);\n1581:     process.exitCode = 2;\n1582:   }\n1583: }\n1584: \n1585: module.exports = {\n1586:   ALLOWLIST,\n1587:   MANIFEST_PATH,\n1588:   addRouterRows,\n1589:   assertWritable,\n1590:   backupBase,\n1591:   compose,\n1592:   main,\n1593:   planDigest,\n1594:   planFor,\n1595:   preservationCheck,\n1596:   renderBlock,\n1597:   renderMirror,\n1598:   renderRouter,\n1599: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1067-1599\n1067:   // The pointer block is regenerated by its own tool, so it is backed up whenever the run\n1068:   // would touch it, even though this engine composes nothing for it.\n1069:   const pointerAbsolute = path.join(root, POINTER_FILE);\n1070:   if (composition.writes.some((file) => file.path === manifest.root_file) && fs.existsSync(pointerAbsolute) && !isSymlink(pointerAbsolute)) {\n1071:     entries.push(backupEntry(root, { path: POINTER_FILE, action: 'regenerated' }));\n1072:   }\n1073: \n1074:   // The backup and its record are written by plain fs, never by the caller's write hook:\n1075:   // the rollback must not share a path with the writer it exists to undo.\n1076:   for (const entry of entries) {\n1077:     if (!entry.existed) continue;\n1078:     const destination = path.join(plan.dir, entry.backup);\n1079:     fs.mkdirSync(path.dirname(destination), { recursive: true });\n1080:     fs.copyFileSync(path.join(root, entry.path), destination);\n1081:   }\n1082: \n1083:   const record = {\n1084:     schema: 1,\n1085:     root,\n1086:     created_at: utcStamp(),\n1087:     plan_digest: plan.digest,\n1088:     paths: entries,\n1089:   };\n1090:   fs.writeFileSync(path.join(plan.dir, 'manifest.json'), `${JSON.stringify(record, null, 2)}\\n`, 'utf8');\n1091:   return record;\n1092: }\n1093: \n1094: // ─────────────────────────────────────────────────────────────────────────────\n1095: // 13. THE DIFF\n1096: // ─────────────────────────────────────────────────────────────────────────────\n1097: \n1098: function diffLines(text) {\n1099:   if (text === null) return [];\n1100:   const lines = String(text).split('\\n');\n1101:   if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();\n1102:   return lines;\n1103: }\n1104: \n1105: function diffOps(left, right) {\n1106:   const rows = left.length + 1;\n1107:   const columns = right.length + 1;\n1108:   const table = Array.from({ length: rows }, () => new Uint32Array(columns));\n1109:   for (let i = left.length - 1; i >= 0; i -= 1) {\n1110:     for (let j = right.length - 1; j >= 0; j -= 1) {\n1111:       table[i][j] = left[i] === right[j]\n1112:         ? table[i + 1][j + 1] + 1\n1113:         : Math.max(table[i + 1][j], table[i][j + 1]);\n1114:     }\n1115:   }\n1116:   const ops = [];\n1117:   let i = 0;\n1118:   let j = 0;\n1119:   while (i < left.length && j < right.length) {\n1120:     if (left[i] === right[j]) {\n1121:       ops.push({ kind: ' ', text: left[i] });\n1122:       i += 1;\n1123:       j += 1;\n1124:     } else if (table[i + 1][j] >= table[i][j + 1]) {\n1125:       ops.push({ kind: '-', text: left[i] });\n1126:       i += 1;\n1127:     } else {\n1128:       ops.push({ kind: '+', text: right[j] });\n1129:       j += 1;\n1130:     }\n1131:   }\n1132:   while (i < left.length) {\n1133:     ops.push({ kind: '-', text: left[i] });\n1134:     i += 1;\n1135:   }\n1136:   while (j < right.length) {\n1137:     ops.push({ kind: '+', text: right[j] });\n1138:     j += 1;\n1139:   }\n1140:   return ops;\n1141: }\n1142: \n1143: /**\n1144:  * A unified diff with three lines of context, which is what makes a plan reviewable.\n1145:  *\n1146:  * @param {string|null} beforeText\n1147:  * @param {string|null} afterText\n1148:  * @param {string} relative\n1149:  * @returns {string[]}\n1150:  */\n1151: function unifiedDiff(beforeText, afterText, relative) {\n1152:   const left = diffLines(beforeText);\n1153:   const right = diffLines(afterText);\n1154:   const ops = diffOps(left, right);\n1155:   if (!ops.some((op) => op.kind !== ' ')) return [];\n1156: \n1157:   const changed = ops.map((op, index) => (op.kind === ' ' ? -1 : index)).filter((index) => index !== -1);\n1158:   const hunks = [];\n1159:   for (const index of changed) {\n1160:     const start = Math.max(0, index - 3);\n1161:     const end = Math.min(ops.length, index + 4);\n1162:     const last = hunks[hunks.length - 1];\n1163:     if (last && start <= last.end) last.end = Math.max(last.end, end);\n1164:     else hunks.push({ start, end });\n1165:   }\n1166: \n1167:   const output = [`--- ${beforeText === null ? '/dev/null' : `a/${relative}`}`, `+++ ${afterText === null ? '/dev/null' : `b/${relative}`}`];\n1168:   let consumed = 0;\n1169:   for (const hunk of hunks) {\n1170:     // A create has no left side and a removal has no right side, so their cursors start at\n1171:     // zero rather than at the first line of a file that is not there.\n1172:     let leftCursor = beforeText === null ? 0 : 1;\n1173:     let rightCursor = afterText === null ? 0 : 1;\n1174:     for (let index = 0; index < hunk.start; index += 1) {\n1175:       if (ops[index].kind !== '+') leftCursor += 1;\n1176:       if (ops[index].kind !== '-') rightCursor += 1;\n1177:     }\n1178:     const slice = ops.slice(hunk.start, hunk.end);\n1179:     const leftCount = slice.filter((op) => op.kind !== '+').length;\n1180:     const rightCount = slice.filter((op) => op.kind !== '-').length;\n1181:     output.push(`@@ -${leftCursor},${leftCount} +${rightCursor},${rightCount} @@`);\n1182:     for (const op of slice) output.push(`${op.kind}${op.text}`);\n1183:     consumed += slice.length;\n1184:   }\n1185:   return consumed === 0 ? [] : output;\n1186: }\n1187: \n1188: // ─────────────────────────────────────────────────────────────────────────────\n1189: // 14. THE PLAN\n1190: // ─────────────────────────────────────────────────────────────────────────────\n1191: \n1192: function renderTargets(composition) {\n1193:   return composition.files.map((file) => `target ${file.path}: ${file.action}`);\n1194: }\n1195: \n1196: function renderPlan(composition, plan) {\n1197:   const lines = [];\n1198:   lines.push(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1199:   lines.push(...renderTargets(composition));\n1200:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1201: \n1202:   for (const file of composition.writes) {\n1203:     if (file.action === 'remove') {\n1204:       lines.push(`diff ${file.path}:`);\n1205:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1206:       continue;\n1207:     }\n1208:     const diff = unifiedDiff(file.before, file.content, file.path);\n1209:     lines.push(`diff ${file.path}:`);\n1210:     if (diff.length === 0) lines.push('  (no line changes)');\n1211:     lines.push(...diff);\n1212:   }\n1213: \n1214:   lines.push('block:');\n1215:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1216:   lines.push('block-end:');\n1217: \n1218:   const { before, after, limits } = composition.budget;\n1219:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1220:   if (after.total > limits.total) {\n1221:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1222:   }\n1223:   if (after.prefix > limits.prefix) {\n1224:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1225:   }\n1226: \n1227:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1228:   lines.push(`backup: ${plan.dir}`);\n1229:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1230:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1231:   lines.push(`plan-digest: ${plan.digest}`);\n1232:   return lines;\n1233: }\n1234: \n1235: function renderDropped(dropped) {\n1236:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1237: }\n1238: \n1239: // ─────────────────────────────────────────────────────────────────────────────\n1240: // 15. PLAN\n1241: // ─────────────────────────────────────────────────────────────────────────────\n1242: \n1243: function preflight(composition, manifest) {\n1244:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1245: }\n1246: \n1247: function commandPlan(options, output, hooks) {\n1248:   const manifest = loadManifest();\n1249:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1250: \n1251:   const checked = preflight(composition, manifest);\n1252:   composition.ledger.dropped = checked.dropped.length;\n1253: \n1254:   if (composition.writes.length === 0) {\n1255:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1256:     for (const note of composition.notes) output.log(`note: ${note}`);\n1257:     output.log('NOTHING TO DO');\n1258:     return 0;\n1259:   }\n1260: \n1261:   const plan = planFor(composition);\n1262:   for (const line of renderPlan(composition, plan)) output.log(line);\n1263:   if (checked.dropped.length > 0) {\n1264:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1265:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1266:     output.warn('STATUS=FAIL');\n1267:     return 1;\n1268:   }\n1269:   if (options.dryRun) output.log('dry-run: nothing was written');\n1270:   return 0;\n1271: }\n1272: \n1273: // ─────────────────────────────────────────────────────────────────────────────\n1274: // 16. APPLY\n1275: // ─────────────────────────────────────────────────────────────────────────────\n1276: \n1277: function runTool(script, args) {\n1278:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1279:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1280:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1281:   return { code: result.status, output };\n1282: }\n1283: \n1284: function restoreFromBackup({ root, dir, output }) {\n1285:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1286:   let restored = 0;\n1287:   const deleted = new Set();\n1288:   for (const entry of record.paths) {\n1289:     const target = path.join(root, entry.path);\n1290:     if (!entry.existed) {\n1291:       if (fs.existsSync(target)) {\n1292:         fs.rmSync(target);\n1293:         deleted.add(entry.path);\n1294:       }\n1295:       continue;\n1296:     }\n1297:     const source = path.join(dir, entry.backup);\n1298:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1299:     fs.copyFileSync(source, target);\n1300:     restored += 1;\n1301:   }\n1302:   removeCreatedDirs(root, record.paths, deleted);\n1303:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1304:   return restored;\n1305: }\n1306: \n1307: function commandApply(options, output, hooks) {\n1308:   if (!options.digest) {\n1309:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1310:     return 2;\n1311:   }\n1312: \n1313:   const manifest = loadManifest();\n1314:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1315: \n1316:   // A tree already in its target state has nothing a digest could authorise.\n1317:   if (composition.writes.length === 0) {\n1318:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1319:     output.log('NOTHING TO DO');\n1320:     return 0;\n1321:   }\n1322: \n1323:   const plan = planFor(composition);\n1324:   if (plan.digest !== options.digest) {\n1325:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1326:     // already happened gets told which directory holds those bytes instead of a claim\n1327:     // about the tree that would be false.\n1328:     const held = backupDirectoryOf(plan.base, options.digest);\n1329:     if (fs.existsSync(held)) {\n1330:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1331:       return 2;\n1332:     }\n1333:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1334:     return 2;\n1335:   }\n1336: \n1337:   // The same proof the plan ran, because a composition that already loses a line must\n1338:   // never reach a backup, let alone the tree.\n1339:   const checked = preflight(composition, manifest);\n1340:   composition.ledger.dropped = checked.dropped.length;\n1341:   if (checked.dropped.length > 0) {\n1342:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1343:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1344:     output.warn('STATUS=FAIL');\n1345:     return 1;\n1346:   }\n1347: \n1348:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1349:   // the run before a backup exists rather than after a partial write.\n1350:   const targets = [];\n1351:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1352: \n1353:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1354:   // here, where every precondition has already passed and nothing has been created.\n1355:   if (options.dryRun) {\n1356:     for (const line of renderPlan(composition, plan)) output.log(line);\n1357:     output.log('dry-run: nothing was written');\n1358:     return 0;\n1359:   }\n1360: \n1361:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1362:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1363: \n1364:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1365:   for (const target of targets) {\n1366:     if (target.file.action === 'remove') {\n1367:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1368:       output.log(`removed ${target.file.path} (backed up first)`);\n1369:       continue;\n1370:     }\n1371:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1372:     write(target.absolute, target.file.content);\n1373:     output.log(`wrote ${target.file.path}`);\n1374:   }\n1375: \n1376:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1377:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1378:   if (rootTouched) {\n1379:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1380:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1381:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1382:   }\n1383:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1384:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1385:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1386:     output.log(`repo-rules: ${summary}`);\n1387:   }\n1388: \n1389:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1390:   const rootPath = path.join(options.root, manifest.root_file);\n1391:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1392:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1393:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1394: \n1395:   if (after.dropped.length > 0) {\n1396:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1397:     restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1398:     output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1399:     output.warn('STATUS=FAIL');\n1400:     return 1;\n1401:   }\n1402: \n1403:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1404:   if (report !== null) {\n1405:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1406:   }\n1407:   output.log(`backup: ${plan.dir}`);\n1408:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1409:   for (const entry of record.paths) {\n1410:     if (!entry.existed) continue;\n1411:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1412:   }\n1413:   output.log('STATUS=OK');\n1414:   return 0;\n1415: }\n1416: \n1417: // ─────────────────────────────────────────────────────────────────────────────\n1418: // 17. RESTORE\n1419: // ─────────────────────────────────────────────────────────────────────────────\n1420: \n1421: function readConfirmation() {\n1422:   try {\n1423:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1424:   } catch {\n1425:     return '';\n1426:   }\n1427: }\n1428: \n1429: function commandRestore(options, output, hooks) {\n1430:   if (!options.run) {\n1431:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1432:     return 2;\n1433:   }\n1434:   const recordPath = path.join(options.run, 'manifest.json');\n1435:   if (!fs.existsSync(recordPath)) {\n1436:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1437:     return 2;\n1438:   }\n1439: \n1440:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1441:   const root = record.root;\n1442:   // The record names its own root, and a record is data: it is trusted only when it names\n1443:   // the root this restore runs against, so a record repointed at another folder is refused\n1444:   // instead of written to. Restoring another folder takes --root naming that folder.\n1445:   if (typeof root !== 'string' || !sameDirectory(root, options.root)) {\n1446:     output.warn(`${TAG} ERROR: the record names the root ${root}, and this restore runs against ${options.root}; pass --root ${root} to restore that folder. Nothing was written`);\n1447:     return 2;\n1448:   }\n1449:   const steps = [];\n1450:   for (const entry of record.paths) {\n1451:     // A record is data, and data can be wrong: the same allowlist decides what it may\n1452:     // touch, so a hand-edited record cannot turn a restore into an arbitrary write.\n1453:     const absolute = assertWritable(root, entry.path);\n1454:     if (!entry.existed) {\n1455:       steps.push({ entry, absolute, action: fs.existsSync(absolute) ? 'delete' : 'absent' });\n1456:       continue;\n1457:     }\n1458:     const source = path.join(options.run, entry.backup);\n1459:     if (!fs.existsSync(source)) {\n1460:       output.warn(`${TAG} ERROR: the backup of ${entry.path} is missing at ${source}; nothing was written`);\n1461:       return 2;\n1462:     }\n1463:     const bytes = fs.readFileSync(source);\n1464:     if (sha256(bytes.toString('utf8')) !== entry.sha256) {\n1465:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash; nothing was written`);\n1466:       return 2;\n1467:     }\n1468:     steps.push({ entry, absolute, action: 'put back', bytes });\n1469:   }\n1470: \n1471:   output.log(`${TAG} restore plan for ${root} from ${options.run}`);\n1472:   for (const step of steps) {\n1473:     const note = step.action === 'delete' && step.entry.path === 'AGENTS.md'\n1474:       ? ' (this run created it; without it Gate 3 no longer detects this directory as a workspace root)'\n1475:       : '';\n1476:     output.log(`restore ${step.entry.path}: ${step.action}${note}`);\n1477:   }\n1478:   const createdDirs = new Set(steps.flatMap((step) => (step.action === 'delete' ? recordedCreatedDirs(step.entry) : [])));\n1479:   for (const dir of createdDirs) output.log(`restore ${dir}/: remove if empty (this run created it)`);\n1480: \n1481:   if (options.dryRun) {\n1482:     output.log('dry-run: nothing was written');\n1483:     return 0;\n1484:   }\n1485: \n1486:   if (!options.yes) {\n1487:     output.log(`type yes to put ${steps.length} path(s) back:`);\n1488:     if (readConfirmation() !== 'yes') {\n1489:       output.log('cancelled: no confirmation, nothing was written');\n1490:       return 1;\n1491:     }\n1492:   }\n1493: \n1494:   let touched = 0;\n1495:   const deleted = new Set();\n1496:   for (const step of steps) {\n1497:     if (step.action === 'delete') {\n1498:       fs.rmSync(step.absolute);\n1499:       deleted.add(step.entry.path);\n1500:       touched += 1;\n1501:       continue;\n1502:     }\n1503:     if (step.action === 'absent') continue;\n1504:     fs.mkdirSync(path.dirname(step.absolute), { recursive: true });\n1505:     fs.writeFileSync(step.absolute, step.bytes);\n1506:     touched += 1;\n1507:   }\n1508:   for (const dir of removeCreatedDirs(root, record.paths, deleted)) output.log(`restore ${dir}/: removed the empty folder this run created`);\n1509: \n1510:   // Byte equality after the write, measured against the recorded hash rather than against\n1511:   // the copy that was just read.\n1512:   for (const step of steps) {\n1513:     if (step.action === 'delete' || step.action === 'absent') continue;\n1514:     if (sha256(fs.readFileSync(step.absolute, 'utf8')) !== step.entry.sha256) {\n1515:       output.warn(`${TAG} ERROR: ${step.entry.path} does not match its recorded hash after the restore`);\n1516:       output.warn('STATUS=FAIL');\n1517:       return 1;\n1518:     }\n1519:   }\n1520: \n1521:   output.log(`restore: ${touched} path(s) put back, the backup at ${options.run} is kept`);\n1522:   output.log('STATUS=OK');\n1523:   return 0;\n1524: }\n1525: \n1526: // ─────────────────────────────────────────────────────────────────────────────\n1527: // 18. MAIN\n1528: // ─────────────────────────────────────────────────────────────────────────────\n1529: \n1530: function outputOf(hooks) {\n1531:   return {\n1532:     log: typeof hooks.log === 'function' ? hooks.log : (line) => console.log(line),\n1533:     warn: typeof hooks.warn === 'function' ? hooks.warn : (line) => console.error(line),\n1534:   };\n1535: }\n1536: \n1537: /**\n1538:  * @param {string[]} argv\n1539:  * @param {{log?: Function, warn?: Function, write?: Function}} [hooks]\n1540:  * @returns {number} the process exit code\n1541:  */\n1542: function main(argv, hooks = {}) {\n1543:   const options = parseArgs(argv);\n1544:   const output = outputOf(hooks);\n1545:   if (options.help) {\n1546:     output.log(USAGE);\n1547:     return 0;\n1548:   }\n1549:   if (options.command === null) {\n1550:     output.warn(`${TAG} ERROR: one of plan, apply or restore is required\\n${USAGE}`);\n1551:     return 2;\n1552:   }\n1553:   if (!fs.existsSync(options.root) || !fs.statSync(options.root).isDirectory()) {\n1554:     output.warn(`${TAG} ERROR: the target root is not a directory: ${options.root}`);\n1555:     return 2;\n1556:   }\n1557: \n1558:   try {\n1559:     if (options.command === 'plan') return commandPlan(options, output, hooks);\n1560:     if (options.command === 'apply') return commandApply(options, output, hooks);\n1561:     return commandRestore(options, output, hooks);\n1562:   } catch (error) {\n1563:     if (error instanceof AllowlistError) {\n1564:       output.warn(`${TAG} ERROR: ${error.message}; nothing was written`);\n1565:       return 2;\n1566:     }\n1567:     if (error instanceof PreconditionError || error instanceof UsageError) {\n1568:       output.warn(`${TAG} ERROR: ${error.message}`);\n1569:       if (error instanceof UsageError) output.warn(USAGE);\n1570:       return 2;\n1571:     }\n1572:     throw error;\n1573:   }\n1574: }\n1575: \n1576: if (require.main === module) {\n1577:   try {\n1578:     process.exitCode = main(process.argv.slice(2));\n1579:   } catch (error) {\n1580:     console.error(`${TAG} ERROR: ${error.message}`);\n1581:     process.exitCode = 2;\n1582:   }\n1583: }\n1584: \n1585: module.exports = {\n1586:   ALLOWLIST,\n1587:   MANIFEST_PATH,\n1588:   addRouterRows,\n1589:   assertWritable,\n1590:   backupBase,\n1591:   compose,\n1592:   main,\n1593:   planDigest,\n1594:   planFor,\n1595:   preservationCheck,\n1596:   renderBlock,\n1597:   renderMirror,\n1598:   renderRouter,\n1599: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs\",\"offset\":1067,\"limit\":600}"},"time":{"start":1794558713219,"end":1794558713973}}}}
