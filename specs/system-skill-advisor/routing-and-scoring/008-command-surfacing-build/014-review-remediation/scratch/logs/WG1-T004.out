olds\": {\n      \"confidenceThreshold\": 0.8,\n      \"uncertaintyThreshold\": 0.35,\n      \"confidenceOnly\": false\n    },\n    \"recommendations\": [\n      {\n        \"skillId\": \"sk-code\",\n        \"score\": 0.560862,\n        \"confidence\": 0.8215,\n        \"uncertainty\": 0.16,\n        \"dominantLane\": \"explicit_author\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-code\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\n          \"generation\": 2\n        },\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-doc\",\n        \"score\": 0.155215,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.22,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"defer\",\n          \"selectionKind\": null,\n          \"targets\": [],\n          \"effectivePolicyHash\": \"c0ef88b811d75969ee726921ac8797265388fe009069d3af3fae5647da09298d\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\",\n        \"needsMode\": true\n      },\n      {\n        \"skillId\": \"system-spec-kit\",\n        \"score\": 0.090803,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.22,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"kind\": \"skill\"\n      }\n    ],\n    \"ambiguous\": false,\n    \"freshness\": \"live\",\n    \"trustState\": {\n      \"state\": \"live\",\n      \"reason\": null,\n      \"generation\": 186,\n      \"checkedAt\": \"2026-11-13T08:33:14.778Z\",\n      \"lastLiveAt\": \"2026-11-13T08:30:26.818Z\"\n    },\n    \"generatedAt\": \"2026-11-13T08:33:14.793Z\",\n    \"cache\": {\n      \"hit\": false,\n      \"sourceSignaturePresent\": true\n    },\n    \"warnings\": [\n      \"semantic_lane_off:prompt_embedding_unreachable\"\n    ],\n    \"_shadow\": {\n      \"model\": \"advisor-shadow-learned-weights-v1\",\n      \"liveWeightsFrozen\": true,\n      \"recommendations\": [\n        {\n          \"skillId\": \"sk-code\",\n          \"liveScore\": 0.560862,\n          \"shadowScore\": 0.518269,\n          \"delta\": -0.042593,\n          \"dominantShadowLane\": \"explicit_author\"\n        },\n        {\n          \"skillId\": \"sk-doc\",\n          \"liveScore\": 0.155215,\n          \"shadowScore\": 0.142846,\n          \"delta\": -0.012369,\n          \"dominantShadowLane\": \"lexical\"\n        },\n        {\n          \"skillId\": \"system-spec-kit\",\n          \"liveScore\": 0.090803,\n          \"shadowScore\": 0.092895,\n          \"delta\": 0.002092,\n          \"dominantShadowLane\": \"lexical\"\n        }\n      ]\n    }\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/skill-advisor.cjs advisor_recommend --json '{\\\"prompt\\\":\\\"add a failing test then verify every backup entry in restoreFromBackup before restoring, in a Node .cjs script\\\"}' --format json\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794558793861,"end":1794558794889}}}}
