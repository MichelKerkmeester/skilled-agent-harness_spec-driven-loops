 child.emit('close', 0, null);\n77:     const result = await promise;\n78: \n79:     expect(result.ok).toBe(true);\n80:     expect(result.recommendations[0]?.skill).toBe('sk-code');\n81:     expect(spawnMock.mock.calls[0]?.[1]).not.toContain('implement feature X');\n82:     expect(spawnMock.mock.calls[0]?.[1]).toContain('--stdin');\n83:     expect(child.stdin.write).toHaveBeenCalledWith('implement feature X');\n84:     expect(child.stdin.end).toHaveBeenCalled();\n85:   });\n86: \n87:   it('fails open on JSON parse failure', async () => {\n88:     const spawnMock = await importSpawnMock();\n89:     const child = mockChild();\n90:     spawnMock.mockReturnValue(child as never);\n91: \n92:     const promise = runAdvisorSubprocess('implement feature X', { workspaceRoot, scriptPath });\n93:     child.stdout.emit('data', '{not-json');\n94:     child.emit('close', 0, null);\n95:     const result = await promise;\n96: \n97:     expect(result.ok).toBe(false);\n98:     expect(result.errorCode).toBe('JSON_PARSE_FAILED');\n99:   });\n100: \n101:   it('fails open on schema-invalid JSON stdout', async () => {\n102:     const spawnMock = await importSpawnMock();\n103:     const child = mockChild();\n104:     spawnMock.mockReturnValue(child as never);\n105: \n106:     const promise = runAdvisorSubprocess('implement feature X', { workspaceRoot, scriptPath });\n107:     child.stdout.emit('data', '[{\"skill\":\"sk-code\",\"confidence\":\"high\",\"uncertainty\":0.1}]');\n108:     child.emit('close', 0, null);\n109:     const result = await promise;\n110: \n111:     expect(result.ok).toBe(false);\n112:     expect(result.errorCode).toBe('INVALID_JSON_SHAPE');\n113:   });\n114: \n115:   it('fails open on non-busy nonzero exit codes', async () => {\n116:     const spawnMock = await importSpawnMock();\n117:     const child = mockChild();\n118:     spawnMock.mockReturnValue(child as never);\n119: \n120:     const promise = runAdvisorSubprocess('implement feature X', { workspaceRoot, scriptPath });\n121:     child.stderr.emit('data', 'ordinary failure');\n122:     child.emit('close', 2, null);\n123:     const result = await promise;\n124: \n125:     expect(result.ok).toBe(false);\n126:     expect(result.errorCode).toBe('NON_ZERO_EXIT');\n127:     expect(result.exitCode).toBe(2);\n128:     expect(result.stderr).toBe('ordinary failure');\n129:   });\n130: \n131:   it('kills the child on timeout and reports TIMEOUT', async () => {\n132:     vi.useFakeTimers();\n133:     const spawnMock = await importSpawnMock();\n134:     const child = mockChild();\n135:     spawnMock.mockReturnValue(child as never);\n136: \n137:     const promise = runAdvisorSubprocess('implement feature X', {\n138:       workspaceRoot,\n139:       scriptPath,\n140:       timeoutMs: 5,\n141:     });\n142:     await vi.advanceTimersByTimeAsync(10);\n143:     const result = await promise;\n144: \n145:     expect(child.kill).toHaveBeenCalledWith('SIGKILL');\n146:     expect(result.ok).toBe(false);\n147:     expect(result.errorCode).toBe('TIMEOUT');\n148:   });\n149: \n150:   it('retries SQLITE_BUSY once when timeout budget remains', async () => {\n151:     const spawnMock = await importSpawnMock();\n152:     const first = mockChild();\n153:     const second = mockChild();\n154:     spawnMock.mockReturnValueOnce(first as never).mockReturnValueOnce(second as never);\n155: \n156:     const promise = runAdvisorSubprocess('implement feature X', {\n157:       workspaceRoot,\n158:       scriptPath,\n159:       timeoutMs: 1000,\n160:       retryJitterMs: () => 75,\n161:     });\n162:     first.stderr.emit('data', 'SQLITE_BUSY database is locked');\n163:     first.emit('close', 1, null);\n164:     setTimeout(() => {\n165:       second.stdout.emit('data', '[{\"skill\":\"sk-code\",\"confidence\":0.91,\"uncertainty\":0.1}]');\n166:       second.emit('close', 0, null);\n167:     }, 90);\n168:     const result = await promise;\n169: \n170:     expect(result.ok).toBe(true);\n171:     expect(result.retriesAttempted).toBe(1);\n172:     expect(spawnMock).toHaveBeenCalledTimes(2);\n173:   });\n174: \n175:   it('reports SQLITE_BUSY retry exhaustion after the retry budget is spent', async () => {\n176:     const spawnMock = await importSpawnMock();\n177:     const first = mockChild();\n178:     const second = mockChild();\n179:     spawnMock.mockReturnValueOnce(first as never).mockReturnValueOnce(second as never);\n180: \n181:     const promise = runAdvisorSubprocess('implement feature X', {\n182:       workspaceRoot,\n183:       scriptPath,\n184:       timeoutMs: 1000,\n185:       retryJitterMs: () => 1,\n186:     });\n187:     first.stderr.emit('data', 'SQLITE_BUSY database is locked');\n188:     first.emit('close', 1, null);\n189:     setTimeout(() => {\n190:       second.stderr.emit('data', 'database is locked');\n191:       second.emit('close', 1, null);\n192:     }, 5);\n193:     const result = await promise;\n194: \n195:     expect(result.ok).toBe(false);\n196:     expect(result.errorCode).toBe('SQLITE_BUSY_EXHAUSTED');\n197:     expect(result.retriesAttempted).toBe(1);\n198:     expect(spawnMock).toHaveBeenCalledTimes(2);\n199:   });\n200: \n201:   it('classifies child-process spawn errors for missing and non-executable runtimes', async () => {\n202:     const spawnMock = await importSpawnMock();\n203:     const missingRuntime = mockChild();\n204:     const nonExecutableRuntime = mockChild();\n205:     spawnMock\n206:       .mockReturnValueOnce(missingRuntime as never)\n207:       .mockReturnValueOnce(nonExecutableRuntime as never);\n208: \n209:     const missingRuntimePromise = runAdvisorSubprocess('implement feature X', { workspaceRoot, scriptPath });\n210:     missingRuntime.emit(\n211:       'error',\n212:       Object.assign(new Error('spawn python3 ENOENT'), { code: 'ENOENT' }) as NodeJS.ErrnoException,\n213:     );\n214:     const missingRuntimeResult = await missingRuntimePromise;\n215: \n216:     const nonExecutableRuntimePromise = runAdvisorSubprocess('implement feature X', { workspaceRoot, scriptPath });\n217:     nonExecutableRuntime.emit(\n218:       'error',\n219:       Object.assign(new Error('spawn python3 EACCES'), { code: 'EACCES' }) as NodeJS.ErrnoException,\n220:     );\n221:     const nonExecutableRuntimeResult = await nonExecutableRuntimePromise;\n222: \n223:     expect(missingRuntimeResult.ok).toBe(false);\n224:     expect(missingRuntimeResult.errorCode).toBe('PYTHON_MISSING');\n225:     expect(missingRuntimeResult.exitCode).toBeNull();\n226:     expect(missingRuntimeResult.signal).toBeNull();\n227:     expect(missingRuntimeResult.stderr).toBe('spawn python3 ENOENT');\n228: \n229:     expect(nonExecutableRuntimeResult.ok).toBe(false);\n230:     expect(nonExecutableRuntimeResult.errorCode).toBe('SPAWN_ERROR');\n231:     expect(nonExecutableRuntimeResult.exitCode).toBeNull();\n232:     expect(nonExecutableRuntimeResult.signal).toBeNull();\n233:     expect(nonExecutableRuntimeResult.stderr).toBe('spawn python3 EACCES');\n234:   });\n235: \n236:   it('returns SCRIPT_MISSING before spawning when target is absent', async () => {\n237:     const spawnMock = await importSpawnMock();\n238:     const result = await runAdvisorSubprocess('implement feature X', {\n239:       workspaceRoot,\n240:       scriptPath: join(workspaceRoot, 'missing.py'),\n241:     });\n242: \n243:     expect(result.ok).toBe(false);\n244:     expect(result.errorCode).toBe('SCRIPT_MISSING');\n245:     expect(spawnMock).not.toHaveBeenCalled();\n246:   });\n247: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/legacy/advisor-subprocess.vitest.ts\"}"},"time":{"start":1794558685338,"end":1794558685831}}}}
