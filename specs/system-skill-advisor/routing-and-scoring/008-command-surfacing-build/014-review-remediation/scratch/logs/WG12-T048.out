{"type":"tool_use","timestamp":1794558647649,"sessionID":"ses_e2bf94c4bffeq3wW7wXHtAV6en","part":{"partID":"prt_1d407d971001hB10gDGWxRsQZE","sessionID":"ses_e2bf94c4bffeq3wW7wXHtAV6en","messageID":"msg_1d407bd00001AGY9GAd60WcT59","type":"tool","id":"call_b853acde79cd4ba5940851e6","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts, lines 1-398\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Subprocess Runner\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { spawn } from 'node:child_process';\n10: import { existsSync } from 'node:fs';\n11: import { join } from 'node:path';\n12: import { performance } from 'node:perf_hooks';\n13: \n14: import { isRecord } from './utils/json-guard.js';\n15: \n16: import type { ChildProcess } from 'node:child_process';\n17: import type { AdvisorThresholds } from './prompt-cache.js';\n18: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n19: \n20: // ───────────────────────────────────────────────────────────────────\n21: // 2. TYPE DEFINITIONS\n22: // ───────────────────────────────────────────────────────────────────\n23: \n24: /**\n25:  * Compact summary of a compiled routing decision, small enough to cross the\n26:  * brief boundary without carrying the full internal decision object. The served\n27:  * outcome is one of route/clarify/defer/reject; the fingerprint is the manifest\n28:  * serving-state hash used to invalidate a stale cached brief.\n29:  */\n30: export interface CompiledRouteSummary {\n31:   readonly outcome: string;\n32:   readonly hubId: string | null;\n33:   readonly targets: readonly string[];\n34:   readonly servingAuthority: string;\n35:   readonly fingerprint: string | null;\n36:   readonly generation: number | null;\n37: }\n38: \n39: export interface AdvisorRecommendation {\n40:   readonly skill: string;\n41:   readonly kind?: string;\n42:   readonly command?: string;\n43:   readonly policy?: string;\n44:   readonly ownerSkillId?: string;\n45:   // True when a hub held back its command because the prompt names no single mode.\n46:   readonly needsMode?: boolean;\n47:   readonly confidence: number;\n48:   readonly uncertainty: number;\n49:   readonly passes_threshold?: boolean;\n50:   readonly reason?: string;\n51:   // Additive: the compiled decision summary when a hub is compiled-serving. This\n52:   // path parses the Python advisor stdout, which does not emit it today, but the\n53:   // interface must not structurally drop it so a compiled decision reaching this\n54:   // brief path survives instead of being silently stripped.\n55:   readonly compiledRouteSummary?: CompiledRouteSummary;\n56: }\n57: \n58: export type AdvisorSubprocessErrorCode =\n59:   | 'PYTHON_MISSING'\n60:   | 'SCRIPT_MISSING'\n61:   | 'SIGNAL_KILLED'\n62:   | 'TIMEOUT'\n63:   | 'JSON_PARSE_FAILED'\n64:   | 'INVALID_JSON_SHAPE'\n65:   | 'NON_ZERO_EXIT'\n66:   | 'SQLITE_BUSY_EXHAUSTED'\n67:   | 'SPAWN_ERROR';\n68: \n69: export interface AdvisorSubprocessResult {\n70:   readonly ok: boolean;\n71:   readonly recommendations: AdvisorRecommendation[];\n72:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n73:   readonly exitCode: number | null;\n74:   readonly signal: NodeJS.Signals | null;\n75:   readonly stderr: string | null;\n76:   readonly durationMs: number;\n77:   readonly retriesAttempted: number;\n78: }\n79: \n80: export interface AdvisorSubprocessOptions {\n81:   readonly workspaceRoot: string;\n82:   readonly timeoutMs?: number;\n83:   readonly thresholdConfig?: AdvisorThresholds;\n84:   readonly pythonBin?: string;\n85:   readonly scriptPath?: string;\n86:   readonly retryJitterMs?: () => number;\n87: }\n88: \n89: interface SpawnAttemptResult {\n90:   readonly ok: boolean;\n91:   readonly stdout: string;\n92:   readonly stderr: string;\n93:   readonly exitCode: number | null;\n94:   readonly signal: NodeJS.Signals | null;\n95:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n96:   readonly durationMs: number;\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────────\n100: // 3. CONSTANTS\n101: // ───────────────────────────────────────────────────────────────────\n102: \n103: const DEFAULT_TIMEOUT_MS = 3000;\n104: const SQLITE_BUSY_PATTERN = /\\bSQLITE_BUSY\\b|database is locked/i;\n105: \n106: // ───────────────────────────────────────────────────────────────────\n107: // 4. HELPERS\n108: // ───────────────────────────────────────────────────────────────────\n109: \n110: function parsePositiveInt(value: string | undefined, fallback: number): number {\n111:   if (typeof value !== 'string' || value.trim().length === 0) {\n112:     return fallback;\n113:   }\n114:   const parsed = Number.parseInt(value, 10);\n115:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n116: }\n117: \n118: function defaultTimeoutMs(): number {\n119:   return parsePositiveInt(process.env.SPECKIT_OPENCODE_HOOK_TIMEOUT_MS, DEFAULT_TIMEOUT_MS);\n120: }\n121: \n122: function thresholdArgs(thresholdConfig: AdvisorThresholds | undefined): string[] {\n123:   const confidenceThreshold = String(thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold());\n124:   const uncertaintyThreshold = String(thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold());\n125:   const args = ['--threshold', confidenceThreshold, '--uncertainty', uncertaintyThreshold];\n126:   if (thresholdConfig?.confidenceOnly) {\n127:     args.push('--confidence-only');\n128:   }\n129:   if (thresholdConfig?.showRejections) {\n130:     args.push('--show-rejections');\n131:   }\n132:   return args;\n133: }\n134: \n135: function sanitizeStderr(stderr: string): string | null {\n136:   const compact = stderr.replace(/\\s+/g, ' ').trim();\n137:   if (!compact) {\n138:     return null;\n139:   }\n140:   return compact.slice(0, 240);\n141: }\n142: \n143: function coerceCompiledRouteSummary(value: unknown): CompiledRouteSummary | undefined {\n144:   if (!isRecord(value)) return undefined;\n145:   if (typeof value.outcome !== 'string' || value.outcome.length === 0) return undefined;\n146:   const targets = Array.isArray(value.targets)\n147:     ? value.targets.filter((target): target is string => typeof target === 'string')\n148:     : [];\n149:   return {\n150:     outcome: value.outcome,\n151:     hubId: typeof value.hubId === 'string' ? value.hubId : null,\n152:     targets,\n153:     servingAuthority: typeof value.servingAuthority === 'string' ? value.servingAuthority : 'compiled',\n154:     fingerprint: typeof value.fingerprint === 'string' ? value.fingerprint : null,\n155:     generation: typeof value.generation === 'number' ? value.generation : null,\n156:   };\n157: }\n158: \n159: // ───────────────────────────────────────────────────────────────────\n160: // 5. CORE LOGIC\n161: // ───────────────────────────────────────────────────────────────────\n162: \n163: function parseRecommendations(stdout: string): AdvisorRecommendation[] {\n164:   const parsed: unknown = JSON.parse(stdout);\n165:   if (!Array.isArray(parsed)) {\n166:     throw new Error(`advisor stdout: expected JSON array; actual ${typeof parsed}.`);\n167:   }\n168:   return parsed.map((item, index) => {\n169:     const path = `advisor stdout[${index}]`;\n170:     if (!isRecord(item)) {\n171:       throw new Error(`${path}: expected object recommendation; actual ${typeof item}.`);\n172:     }\n173:     if (typeof item.skill !== 'string' || item.skill.trim().length === 0) {\n174:       throw new Error(`${path}.skill: expected non-empty string; actual ${typeof item.skill}.`);\n175:     }\n176:     if (typeof item.confidence !== 'number' || Number.isNaN(item.confidence)) {\n177:       throw new Error(`${path}.confidence: expected finite number; actual ${typeof item.confidence}.`);\n178:     }\n179:     if (typeof item.uncertainty !== 'number' || Number.isNaN(item.uncertainty)) {\n180:       throw new Error(`${path}.uncertainty: expected finite number; actual ${typeof item.uncertainty}.`);\n181:     }\n182:     const compiledRouteSummary = coerceCompiledRouteSummary(item.compiledRouteSummary);\n183:     return {\n184:       skill: item.skill,\n185:       ...(typeof item.kind === 'string' ? { kind: item.kind } : {}),\n186:       confidence: item.confidence,\n187:       uncertainty: item.uncertainty,\n188:       ...(typeof item.passes_threshold === 'boolean' ? { passes_threshold: item.passes_threshold } : {}),\n189:       ...(typeof item.reason === 'string' ? { reason: item.reason } : {}),\n190:       ...(compiledRouteSummary ? { compiledRouteSummary } : {}),\n191:     };\n192:   });\n193: }\n194: \n195: function runSpawnAttempt(args: {\n196:   command: string;\n197:   commandArgs: readonly string[];\n198:   prompt: string;\n199:   cwd: string;\n200:   timeoutMs: number;\n201: }): Promise<SpawnAttemptResult> {\n202:   const startedAt = performance.now();\n203:   return new Promise((resolve) => {\n204:     let stdout = '';\n205:     let stderr = '';\n206:     let settled = false;\n207:     let timedOut = false;\n208:     let child: ChildProcess;\n209: \n210:     try {\n211:       child = spawn(args.command, args.commandArgs, {\n212:         cwd: args.cwd,\n213:         env: process.env,\n214:         stdio: ['pipe', 'pipe', 'pipe'],\n215:       });\n216:     } catch (error: unknown) {\n217:       resolve({\n218:         ok: false,\n219:         stdout,\n220:         stderr: error instanceof Error ? error.message : 'spawn failed',\n221:         exitCode: null,\n222:         signal: null,\n223:         errorCode: 'SPAWN_ERROR',\n224:         durationMs: performance.now() - startedAt,\n225:       });\n226:       return;\n227:     }\n228: \n229:     child.stdin?.write(args.prompt);\n230:     child.stdin?.end();\n231:     const timer = setTimeout(() => {\n232:       timedOut = true;\n233:       child.kill('SIGKILL');\n234:     }, args.timeoutMs);\n235: \n236:     child.stdout?.setEncoding('utf8');\n237:     child.stderr?.setEncoding('utf8');\n238:     child.stdout?.on('data', (chunk: string) => {\n239:       stdout += chunk;\n240:     });\n241:     child.stderr?.on('data', (chunk: string) => {\n242:       stderr += chunk;\n243:     });\n244:     child.on('error', (error: NodeJS.ErrnoException) => {\n245:       if (settled) {\n246:         return;\n247:       }\n248:       settled = true;\n249:       clearTimeout(timer);\n250:       resolve({\n251:         ok: false,\n252:         stdout,\n253:         stderr: error.message,\n254:         exitCode: null,\n255:         signal: null,\n256:         errorCode: error.code === 'ENOENT' ? 'PYTHON_MISSING' : 'SPAWN_ERROR',\n257:         durationMs: performance.now() - startedAt,\n258:       });\n259:     });\n260:     child.on('close', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n261:       if (settled) {\n262:         return;\n263:       }\n264:       settled = true;\n265:       clearTimeout(timer);\n266:       resolve({\n267:         ok: exitCode === 0 && signal === null && !timedOut,\n268:         stdout,\n269:         stderr,\n270:         exitCode,\n271:         signal,\n272:         errorCode: timedOut || performance.now() - startedAt >= args.timeoutMs\n273:           ? 'TIMEOUT'\n274:           : signal === 'SIGKILL'\n275:             ? 'SIGNAL_KILLED'\n276:             : null,\n277:         durationMs: performance.now() - startedAt,\n278:       });\n279:     });\n280:   });\n281: }\n282: \n283: async function delay(ms: number): Promise<void> {\n284:   await new Promise((resolve) => {\n285:     setTimeout(resolve, ms);\n286:   });\n287: }\n288: \n289: // ───────────────────────────────────────────────────────────────────\n290: // 6. EXPORTS\n291: // ───────────────────────────────────────────────────────────────────\n292: \n293: /** Run the Python skill advisor with prompt input carried over stdin. */\n294: export async function runAdvisorSubprocess(\n295:   prompt: string,\n296:   options: AdvisorSubprocessOptions,\n297: ): Promise<AdvisorSubprocessResult> {\n298:   const timeoutMs = options.timeoutMs ?? defaultTimeoutMs();\n299:   const scriptPath = options.scriptPath\n300:     ?? join(\n301:       options.workspaceRoot,\n302:       '.skilled',\n303:       'skills',\n304:       'system-skill-advisor',\n305:       'runtime',\n306:       'scripts',\n307:       'skill_advisor.py',\n308:     );\n309:   const startedAt = performance.now();\n310:   let retriesAttempted = 0;\n311: \n312:   if (!existsSync(scriptPath)) {\n313:     return {\n314:       ok: false,\n315:       recommendations: [],\n316:       errorCode: 'SCRIPT_MISSING',\n317:       exitCode: null,\n318:       signal: null,\n319:       stderr: null,\n320:       durationMs: performance.now() - startedAt,\n321:       retriesAttempted,\n322:     };\n323:   }\n324: \n325:   const commandArgs = [\n326:     scriptPath,\n327:     ...thresholdArgs(options.thresholdConfig),\n328:     '--stdin',\n329:   ];\n330:   const command = options.pythonBin ?? 'python3';\n331: \n332:   for (let attempt = 0; attempt < 2; attempt += 1) {\n333:     const elapsedMs = performance.now() - startedAt;\n334:     const remainingMs = Math.max(0, timeoutMs - elapsedMs);\n335:     const attemptResult = await runSpawnAttempt({\n336:       command,\n337:       commandArgs,\n338:       prompt,\n339:       cwd: options.workspaceRoot,\n340:       timeoutMs: Math.max(1, remainingMs),\n341:     });\n342: \n343:     if (!attemptResult.ok) {\n344:       const busy = SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n345:       const budgetRemaining = timeoutMs - (performance.now() - startedAt);\n346:       if (busy && attempt === 0 && budgetRemaining >= 500) {\n347:         retriesAttempted = 1;\n348:         await delay(options.retryJitterMs?.() ?? 75 + Math.floor(Math.random() * 51));\n349:         continue;\n350:       }\n351:       return {\n352:         ok: false,\n353:         recommendations: [],\n354:         errorCode: busy ? 'SQLITE_BUSY_EXHAUSTED' : attemptResult.errorCode ?? 'NON_ZERO_EXIT',\n355:         exitCode: attemptResult.exitCode,\n356:         signal: attemptResult.signal,\n357:         stderr: sanitizeStderr(attemptResult.stderr),\n358:         durationMs: performance.now() - startedAt,\n359:         retriesAttempted,\n360:       };\n361:     }\n362: \n363:     try {\n364:       return {\n365:         ok: true,\n366:         recommendations: parseRecommendations(attemptResult.stdout),\n367:         errorCode: null,\n368:         exitCode: attemptResult.exitCode,\n369:         signal: attemptResult.signal,\n370:         stderr: sanitizeStderr(attemptResult.stderr),\n371:         durationMs: performance.now() - startedAt,\n372:         retriesAttempted,\n373:       };\n374:     } catch (error: unknown) {\n375:       return {\n376:         ok: false,\n377:         recommendations: [],\n378:         errorCode: error instanceof SyntaxError ? 'JSON_PARSE_FAILED' : 'INVALID_JSON_SHAPE',\n379:         exitCode: attemptResult.exitCode,\n380:         signal: attemptResult.signal,\n381:         stderr: null,\n382:         durationMs: performance.now() - startedAt,\n383:         retriesAttempted,\n384:       };\n385:     }\n386:   }\n387: \n388:   return {\n389:     ok: false,\n390:     recommendations: [],\n391:     errorCode: 'SQLITE_BUSY_EXHAUSTED',\n392:     exitCode: null,\n393:     signal: null,\n394:     stderr: null,\n395:     durationMs: performance.now() - startedAt,\n396:     retriesAttempted,\n397:   };\n398: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts, lines 1-398\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Subprocess Runner\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { spawn } from 'node:child_process';\n10: import { existsSync } from 'node:fs';\n11: import { join } from 'node:path';\n12: import { performance } from 'node:perf_hooks';\n13: \n14: import { isRecord } from './utils/json-guard.js';\n15: \n16: import type { ChildProcess } from 'node:child_process';\n17: import type { AdvisorThresholds } from './prompt-cache.js';\n18: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n19: \n20: // ───────────────────────────────────────────────────────────────────\n21: // 2. TYPE DEFINITIONS\n22: // ───────────────────────────────────────────────────────────────────\n23: \n24: /**\n25:  * Compact summary of a compiled routing decision, small enough to cross the\n26:  * brief boundary without carrying the full internal decision object. The served\n27:  * outcome is one of route/clarify/defer/reject; the fingerprint is the manifest\n28:  * serving-state hash used to invalidate a stale cached brief.\n29:  */\n30: export interface CompiledRouteSummary {\n31:   readonly outcome: string;\n32:   readonly hubId: string | null;\n33:   readonly targets: readonly string[];\n34:   readonly servingAuthority: string;\n35:   readonly fingerprint: string | null;\n36:   readonly generation: number | null;\n37: }\n38: \n39: export interface AdvisorRecommendation {\n40:   readonly skill: string;\n41:   readonly kind?: string;\n42:   readonly command?: string;\n43:   readonly policy?: string;\n44:   readonly ownerSkillId?: string;\n45:   // True when a hub held back its command because the prompt names no single mode.\n46:   readonly needsMode?: boolean;\n47:   readonly confidence: number;\n48:   readonly uncertainty: number;\n49:   readonly passes_threshold?: boolean;\n50:   readonly reason?: string;\n51:   // Additive: the compiled decision summary when a hub is compiled-serving. This\n52:   // path parses the Python advisor stdout, which does not emit it today, but the\n53:   // interface must not structurally drop it so a compiled decision reaching this\n54:   // brief path survives instead of being silently stripped.\n55:   readonly compiledRouteSummary?: CompiledRouteSummary;\n56: }\n57: \n58: export type AdvisorSubprocessErrorCode =\n59:   | 'PYTHON_MISSING'\n60:   | 'SCRIPT_MISSING'\n61:   | 'SIGNAL_KILLED'\n62:   | 'TIMEOUT'\n63:   | 'JSON_PARSE_FAILED'\n64:   | 'INVALID_JSON_SHAPE'\n65:   | 'NON_ZERO_EXIT'\n66:   | 'SQLITE_BUSY_EXHAUSTED'\n67:   | 'SPAWN_ERROR';\n68: \n69: export interface AdvisorSubprocessResult {\n70:   readonly ok: boolean;\n71:   readonly recommendations: AdvisorRecommendation[];\n72:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n73:   readonly exitCode: number | null;\n74:   readonly signal: NodeJS.Signals | null;\n75:   readonly stderr: string | null;\n76:   readonly durationMs: number;\n77:   readonly retriesAttempted: number;\n78: }\n79: \n80: export interface AdvisorSubprocessOptions {\n81:   readonly workspaceRoot: string;\n82:   readonly timeoutMs?: number;\n83:   readonly thresholdConfig?: AdvisorThresholds;\n84:   readonly pythonBin?: string;\n85:   readonly scriptPath?: string;\n86:   readonly retryJitterMs?: () => number;\n87: }\n88: \n89: interface SpawnAttemptResult {\n90:   readonly ok: boolean;\n91:   readonly stdout: string;\n92:   readonly stderr: string;\n93:   readonly exitCode: number | null;\n94:   readonly signal: NodeJS.Signals | null;\n95:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n96:   readonly durationMs: number;\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────────\n100: // 3. CONSTANTS\n101: // ───────────────────────────────────────────────────────────────────\n102: \n103: const DEFAULT_TIMEOUT_MS = 3000;\n104: const SQLITE_BUSY_PATTERN = /\\bSQLITE_BUSY\\b|database is locked/i;\n105: \n106: // ───────────────────────────────────────────────────────────────────\n107: // 4. HELPERS\n108: // ───────────────────────────────────────────────────────────────────\n109: \n110: function parsePositiveInt(value: string | undefined, fallback: number): number {\n111:   if (typeof value !== 'string' || value.trim().length === 0) {\n112:     return fallback;\n113:   }\n114:   const parsed = Number.parseInt(value, 10);\n115:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n116: }\n117: \n118: function defaultTimeoutMs(): number {\n119:   return parsePositiveInt(process.env.SPECKIT_OPENCODE_HOOK_TIMEOUT_MS, DEFAULT_TIMEOUT_MS);\n120: }\n121: \n122: function thresholdArgs(thresholdConfig: AdvisorThresholds | undefined): string[] {\n123:   const confidenceThreshold = String(thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold());\n124:   const uncertaintyThreshold = String(thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold());\n125:   const args = ['--threshold', confidenceThreshold, '--uncertainty', uncertaintyThreshold];\n126:   if (thresholdConfig?.confidenceOnly) {\n127:     args.push('--confidence-only');\n128:   }\n129:   if (thresholdConfig?.showRejections) {\n130:     args.push('--show-rejections');\n131:   }\n132:   return args;\n133: }\n134: \n135: function sanitizeStderr(stderr: string): string | null {\n136:   const compact = stderr.replace(/\\s+/g, ' ').trim();\n137:   if (!compact) {\n138:     return null;\n139:   }\n140:   return compact.slice(0, 240);\n141: }\n142: \n143: function coerceCompiledRouteSummary(value: unknown): CompiledRouteSummary | undefined {\n144:   if (!isRecord(value)) return undefined;\n145:   if (typeof value.outcome !== 'string' || value.outcome.length === 0) return undefined;\n146:   const targets = Array.isArray(value.targets)\n147:     ? value.targets.filter((target): target is string => typeof target === 'string')\n148:     : [];\n149:   return {\n150:     outcome: value.outcome,\n151:     hubId: typeof value.hubId === 'string' ? value.hubId : null,\n152:     targets,\n153:     servingAuthority: typeof value.servingAuthority === 'string' ? value.servingAuthority : 'compiled',\n154:     fingerprint: typeof value.fingerprint === 'string' ? value.fingerprint : null,\n155:     generation: typeof value.generation === 'number' ? value.generation : null,\n156:   };\n157: }\n158: \n159: // ───────────────────────────────────────────────────────────────────\n160: // 5. CORE LOGIC\n161: // ───────────────────────────────────────────────────────────────────\n162: \n163: function parseRecommendations(stdout: string): AdvisorRecommendation[] {\n164:   const parsed: unknown = JSON.parse(stdout);\n165:   if (!Array.isArray(parsed)) {\n166:     throw new Error(`advisor stdout: expected JSON array; actual ${typeof parsed}.`);\n167:   }\n168:   return parsed.map((item, index) => {\n169:     const path = `advisor stdout[${index}]`;\n170:     if (!isRecord(item)) {\n171:       throw new Error(`${path}: expected object recommendation; actual ${typeof item}.`);\n172:     }\n173:     if (typeof item.skill !== 'string' || item.skill.trim().length === 0) {\n174:       throw new Error(`${path}.skill: expected non-empty string; actual ${typeof item.skill}.`);\n175:     }\n176:     if (typeof item.confidence !== 'number' || Number.isNaN(item.confidence)) {\n177:       throw new Error(`${path}.confidence: expected finite number; actual ${typeof item.confidence}.`);\n178:     }\n179:     if (typeof item.uncertainty !== 'number' || Number.isNaN(item.uncertainty)) {\n180:       throw new Error(`${path}.uncertainty: expected finite number; actual ${typeof item.uncertainty}.`);\n181:     }\n182:     const compiledRouteSummary = coerceCompiledRouteSummary(item.compiledRouteSummary);\n183:     return {\n184:       skill: item.skill,\n185:       ...(typeof item.kind === 'string' ? { kind: item.kind } : {}),\n186:       confidence: item.confidence,\n187:       uncertainty: item.uncertainty,\n188:       ...(typeof item.passes_threshold === 'boolean' ? { passes_threshold: item.passes_threshold } : {}),\n189:       ...(typeof item.reason === 'string' ? { reason: item.reason } : {}),\n190:       ...(compiledRouteSummary ? { compiledRouteSummary } : {}),\n191:     };\n192:   });\n193: }\n194: \n195: function runSpawnAttempt(args: {\n196:   command: string;\n197:   commandArgs: readonly string[];\n198:   prompt: string;\n199:   cwd: string;\n200:   timeoutMs: number;\n201: }): Promise<SpawnAttemptResult> {\n202:   const startedAt = performance.now();\n203:   return new Promise((resolve) => {\n204:     let stdout = '';\n205:     let stderr = '';\n206:     let settled = false;\n207:     let timedOut = false;\n208:     let child: ChildProcess;\n209: \n210:     try {\n211:       child = spawn(args.command, args.commandArgs, {\n212:         cwd: args.cwd,\n213:         env: process.env,\n214:         stdio: ['pipe', 'pipe', 'pipe'],\n215:       });\n216:     } catch (error: unknown) {\n217:       resolve({\n218:         ok: false,\n219:         stdout,\n220:         stderr: error instanceof Error ? error.message : 'spawn failed',\n221:         exitCode: null,\n222:         signal: null,\n223:         errorCode: 'SPAWN_ERROR',\n224:         durationMs: performance.now() - startedAt,\n225:       });\n226:       return;\n227:     }\n228: \n229:     child.stdin?.write(args.prompt);\n230:     child.stdin?.end();\n231:     const timer = setTimeout(() => {\n232:       timedOut = true;\n233:       child.kill('SIGKILL');\n234:     }, args.timeoutMs);\n235: \n236:     child.stdout?.setEncoding('utf8');\n237:     child.stderr?.setEncoding('utf8');\n238:     child.stdout?.on('data', (chunk: string) => {\n239:       stdout += chunk;\n240:     });\n241:     child.stderr?.on('data', (chunk: string) => {\n242:       stderr += chunk;\n243:     });\n244:     child.on('error', (error: NodeJS.ErrnoException) => {\n245:       if (settled) {\n246:         return;\n247:       }\n248:       settled = true;\n249:       clearTimeout(timer);\n250:       resolve({\n251:         ok: false,\n252:         stdout,\n253:         stderr: error.message,\n254:         exitCode: null,\n255:         signal: null,\n256:         errorCode: error.code === 'ENOENT' ? 'PYTHON_MISSING' : 'SPAWN_ERROR',\n257:         durationMs: performance.now() - startedAt,\n258:       });\n259:     });\n260:     child.on('close', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n261:       if (settled) {\n262:         return;\n263:       }\n264:       settled = true;\n265:       clearTimeout(timer);\n266:       resolve({\n267:         ok: exitCode === 0 && signal === null && !timedOut,\n268:         stdout,\n269:         stderr,\n270:         exitCode,\n271:         signal,\n272:         errorCode: timedOut || performance.now() - startedAt >= args.timeoutMs\n273:           ? 'TIMEOUT'\n274:           : signal === 'SIGKILL'\n275:             ? 'SIGNAL_KILLED'\n276:             : null,\n277:         durationMs: performance.now() - startedAt,\n278:       });\n279:     });\n280:   });\n281: }\n282: \n283: async function delay(ms: number): Promise<void> {\n284:   await new Promise((resolve) => {\n285:     setTimeout(resolve, ms);\n286:   });\n287: }\n288: \n289: // ───────────────────────────────────────────────────────────────────\n290: // 6. EXPORTS\n291: // ───────────────────────────────────────────────────────────────────\n292: \n293: /** Run the Python skill advisor with prompt input carried over stdin. */\n294: export async function runAdvisorSubprocess(\n295:   prompt: string,\n296:   options: AdvisorSubprocessOptions,\n297: ): Promise<AdvisorSubprocessResult> {\n298:   const timeoutMs = options.timeoutMs ?? defaultTimeoutMs();\n299:   const scriptPath = options.scriptPath\n300:     ?? join(\n301:       options.workspaceRoot,\n302:       '.skilled',\n303:       'skills',\n304:       'system-skill-advisor',\n305:       'runtime',\n306:       'scripts',\n307:       'skill_advisor.py',\n308:     );\n309:   const startedAt = performance.now();\n310:   let retriesAttempted = 0;\n311: \n312:   if (!existsSync(scriptPath)) {\n313:     return {\n314:       ok: false,\n315:       recommendations: [],\n316:       errorCode: 'SCRIPT_MISSING',\n317:       exitCode: null,\n318:       signal: null,\n319:       stderr: null,\n320:       durationMs: performance.now() - startedAt,\n321:       retriesAttempted,\n322:     };\n323:   }\n324: \n325:   const commandArgs = [\n326:     scriptPath,\n327:     ...thresholdArgs(options.thresholdConfig),\n328:     '--stdin',\n329:   ];\n330:   const command = options.pythonBin ?? 'python3';\n331: \n332:   for (let attempt = 0; attempt < 2; attempt += 1) {\n333:     const elapsedMs = performance.now() - startedAt;\n334:     const remainingMs = Math.max(0, timeoutMs - elapsedMs);\n335:     const attemptResult = await runSpawnAttempt({\n336:       command,\n337:       commandArgs,\n338:       prompt,\n339:       cwd: options.workspaceRoot,\n340:       timeoutMs: Math.max(1, remainingMs),\n341:     });\n342: \n343:     if (!attemptResult.ok) {\n344:       const busy = SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n345:       const budgetRemaining = timeoutMs - (performance.now() - startedAt);\n346:       if (busy && attempt === 0 && budgetRemaining >= 500) {\n347:         retriesAttempted = 1;\n348:         await delay(options.retryJitterMs?.() ?? 75 + Math.floor(Math.random() * 51));\n349:         continue;\n350:       }\n351:       return {\n352:         ok: false,\n353:         recommendations: [],\n354:         errorCode: busy ? 'SQLITE_BUSY_EXHAUSTED' : attemptResult.errorCode ?? 'NON_ZERO_EXIT',\n355:         exitCode: attemptResult.exitCode,\n356:         signal: attemptResult.signal,\n357:         stderr: sanitizeStderr(attemptResult.stderr),\n358:         durationMs: performance.now() - startedAt,\n359:         retriesAttempted,\n360:       };\n361:     }\n362: \n363:     try {\n364:       return {\n365:         ok: true,\n366:         recommendations: parseRecommendations(attemptResult.stdout),\n367:         errorCode: null,\n368:         exitCode: attemptResult.exitCode,\n369:         signal: attemptResult.signal,\n370:         stderr: sanitizeStderr(attemptResult.stderr),\n371:         durationMs: performance.now() - startedAt,\n372:         retriesAttempted,\n373:       };\n374:     } catch (error: unknown) {\n375:       return {\n376:         ok: false,\n377:         recommendations: [],\n378:         errorCode: error instanceof SyntaxError ? 'JSON_PARSE_FAILED' : 'INVALID_JSON_SHAPE',\n379:         exitCode: attemptResult.exitCode,\n380:         signal: attemptResult.signal,\n381:         stderr: null,\n382:         durationMs: performance.now() - startedAt,\n383:         retriesAttempted,\n384:       };\n385:     }\n386:   }\n387: \n388:   return {\n389:     ok: false,\n390:     recommendations: [],\n391:     errorCode: 'SQLITE_BUSY_EXHAUSTED',\n392:     exitCode: null,\n393:     signal: null,\n394:     stderr: null,\n395:     durationMs: performance.now() - startedAt,\n396:     retriesAttempted,\n397:   };\n398: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts\"}"},"time":{"start":1794558646641,"en