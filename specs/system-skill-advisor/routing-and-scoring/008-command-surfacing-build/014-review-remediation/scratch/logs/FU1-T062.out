{"type":"tool_use","timestamp":1794561550611,"sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","part":{"partID":"prt_1d43428e6002o2Snb09AopV46h","sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","messageID":"msg_1d4340a15001rKyL0nR3xSKjkx","type":"tool","id":"call_cc895d5b073d46c388eb874e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts, lines 1-65\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Subprocess Output Cap Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n9: import { runAdvisorSubprocess } from '../lib/subprocess.js';\n10: \n11: const MAX_OUTPUT_CHARS = 1024 * 1024;\n12: \n13: let workspaceRoot = '';\n14: \n15: function writeScript(source: string): string {\n16:   const path = join(workspaceRoot, 'advisor-child.cjs');\n17:   writeFileSync(path, source, 'utf8');\n18:   return path;\n19: }\n20: \n21: beforeEach(() => {\n22:   workspaceRoot = mkdtempSync(join(tmpdir(), 'subprocess-output-cap-'));\n23: });\n24: \n25: afterEach(() => {\n26:   rmSync(workspaceRoot, { recursive: true, force: true });\n27: });\n28: \n29: describe('runAdvisorSubprocess output cap', () => {\n30:   it('reports a parse failure when a large array is cut short', async () => {\n31:     const scriptPath = writeScript(`\n32: process.stdin.resume();\n33: process.stdin.on('end', () => {\n34:   process.stdout.write(JSON.stringify(['x'.repeat(2 * 1024 * 1024)]));\n35: });\n36: `);\n37:     const result = await runAdvisorSubprocess('prompt', {\n38:       workspaceRoot,\n39:       pythonBin: process.execPath,\n40:       scriptPath,\n41:       timeoutMs: 10000,\n42:     });\n43: \n44:     expect(result.errorCode).toBe('JSON_PARSE_FAILED');\n45:   });\n46: \n47:   it('bounds stderr from a child that floods it and exits non-zero', async () => {\n48:     const scriptPath = writeScript(`\n49: process.stdin.resume();\n50: process.stdin.on('end', () => {\n51:   process.stderr.write('e'.repeat(2 * 1024 * 1024));\n52:   process.exitCode = 1;\n53: });\n54: `);\n55:     const result = await runAdvisorSubprocess('prompt', {\n56:       workspaceRoot,\n57:       pythonBin: process.execPath,\n58:       scriptPath,\n59:       timeoutMs: 10000,\n60:     });\n61: \n62:     expect((result.stderr ?? '').length).toBeLessThanOrEqual(MAX_OUTPUT_CHARS);\n63:     expect(result.ok).toBe(false);\n64:   });\n65: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts, lines 1-65\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Subprocess Output Cap Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n9: import { runAdvisorSubprocess } from '../lib/subprocess.js';\n10: \n11: const MAX_OUTPUT_CHARS = 1024 * 1024;\n12: \n13: let workspaceRoot = '';\n14: \n15: function writeScript(source: string): string {\n16:   const path = join(workspaceRoot, 'advisor-child.cjs');\n17:   writeFileSync(path, source, 'utf8');\n18:   return path;\n19: }\n20: \n21: beforeEach(() => {\n22:   workspaceRoot = mkdtempSync(join(tmpdir(), 'subprocess-output-cap-'));\n23: });\n24: \n25: afterEach(() => {\n26:   rmSync(workspaceRoot, { recursive: true, force: true });\n27: });\n28: \n29: describe('runAdvisorSubprocess output cap', () => {\n30:   it('reports a parse failure when a large array is cut short', async () => {\n31:     const scriptPath = writeScript(`\n32: process.stdin.resume();\n33: process.stdin.on('end', () => {\n34:   process.stdout.write(JSON.stringify(['x'.repeat(2 * 1024 * 1024)]));\n35: });\n36: `);\n37:     const result = await runAdvisorSubprocess('prompt', {\n38:       workspaceRoot,\n39:       pythonBin: process.execPath,\n40:       scriptPath,\n41:       timeoutMs: 10000,\n42:     });\n43: \n44:     expect(result.errorCode).toBe('JSON_PARSE_FAILED');\n45:   });\n46: \n47:   it('bounds stderr from a child that floods it and exits non-zero', async () => {\n48:     const scriptPath = writeScript(`\n49: process.stdin.resume();\n50: process.stdin.on('end', () => {\n51:   process.stderr.write('e'.repeat(2 * 1024 * 1024));\n52:   process.exitCode = 1;\n53: });\n54: `);\n55:     const result = await runAdvisorSubprocess('prompt', {\n56:       workspaceRoot,\n57:       pythonBin: process.execPath,\n58:       scriptPath,\n59:       timeoutMs: 10000,\n60:     });\n61: \n62:     expect((result.stderr ?? '').length).toBeLessThanOrEqual(MAX_OUTPUT_CHARS);\n63:     expect(result.ok).toBe(false);\n64:   });\n65: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts\"}"},"time":{"start":1794561550566,"end":1794561550611}}}}
{"type":"tool_use","timestamp":1794561550629,"sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","part":{"partID":"prt_1d43428e9001Q7iZgWr2Yvf83Q","sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","messageID":"msg_1d4340a15001rKyL0nR3xSKjkx","type":"tool","id":"call_58f2966ef91e4a728b529ea2","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts, lines 1-409\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Subprocess Runner\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { spawn } from 'node:child_process';\n10: import { existsSync } from 'node:fs';\n11: import { join } from 'node:path';\n12: import { performance } from 'node:perf_hooks';\n13: \n14: import { isRecord } from './utils/json-guard.js';\n15: \n16: import type { ChildProcess } from 'node:child_process';\n17: import type { AdvisorThresholds } from './prompt-cache.js';\n18: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n19: \n20: // ───────────────────────────────────────────────────────────────────\n21: // 2. TYPE DEFINITIONS\n22: // ───────────────────────────────────────────────────────────────────\n23: \n24: /**\n25:  * Compact summary of a compiled routing decision, small enough to cross the\n26:  * brief boundary without carrying the full internal decision object. The served\n27:  * outcome is one of route/clarify/defer/reject; the fingerprint is the manifest\n28:  * serving-state hash used to invalidate a stale cached brief.\n29:  */\n30: export interface CompiledRouteSummary {\n31:   readonly outcome: string;\n32:   readonly hubId: string | null;\n33:   readonly targets: readonly string[];\n34:   readonly servingAuthority: string;\n35:   readonly fingerprint: string | null;\n36:   readonly generation: number | null;\n37: }\n38: \n39: export interface AdvisorRecommendation {\n40:   readonly skill: string;\n41:   readonly kind?: string;\n42:   readonly command?: string;\n43:   readonly policy?: string;\n44:   readonly ownerSkillId?: string;\n45:   // True when a hub held back its command because the prompt names no single mode.\n46:   readonly needsMode?: boolean;\n47:   readonly confidence: number;\n48:   readonly uncertainty: number;\n49:   readonly passes_threshold?: boolean;\n50:   readonly reason?: string;\n51:   // Additive: the compiled decision summary when a hub is compiled-serving. This\n52:   // path parses the Python advisor stdout, which does not emit it today, but the\n53:   // interface must not structurally drop it so a compiled decision reaching this\n54:   // brief path survives instead of being silently stripped.\n55:   readonly compiledRouteSummary?: CompiledRouteSummary;\n56: }\n57: \n58: export type AdvisorSubprocessErrorCode =\n59:   | 'PYTHON_MISSING'\n60:   | 'SCRIPT_MISSING'\n61:   | 'SIGNAL_KILLED'\n62:   | 'TIMEOUT'\n63:   | 'JSON_PARSE_FAILED'\n64:   | 'INVALID_JSON_SHAPE'\n65:   | 'NON_ZERO_EXIT'\n66:   | 'SQLITE_BUSY_EXHAUSTED'\n67:   | 'SPAWN_ERROR';\n68: \n69: export interface AdvisorSubprocessResult {\n70:   readonly ok: boolean;\n71:   readonly recommendations: AdvisorRecommendation[];\n72:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n73:   readonly exitCode: number | null;\n74:   readonly signal: NodeJS.Signals | null;\n75:   readonly stderr: string | null;\n76:   readonly durationMs: number;\n77:   readonly retriesAttempted: number;\n78: }\n79: \n80: export interface AdvisorSubprocessOptions {\n81:   readonly workspaceRoot: string;\n82:   readonly timeoutMs?: number;\n83:   readonly thresholdConfig?: AdvisorThresholds;\n84:   readonly pythonBin?: string;\n85:   readonly scriptPath?: string;\n86:   readonly retryJitterMs?: () => number;\n87: }\n88: \n89: interface SpawnAttemptResult {\n90:   readonly ok: boolean;\n91:   readonly stdout: string;\n92:   readonly stderr: string;\n93:   readonly exitCode: number | null;\n94:   readonly signal: NodeJS.Signals | null;\n95:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n96:   readonly durationMs: number;\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────────\n100: // 3. CONSTANTS\n101: // ───────────────────────────────────────────────────────────────────\n102: \n103: const DEFAULT_TIMEOUT_MS = 3000;\n104: const MAX_OUTPUT_CHARS = 1024 * 1024;\n105: const SQLITE_BUSY_PATTERN = /\\bSQLITE_BUSY\\b|database is locked/i;\n106: \n107: // ───────────────────────────────────────────────────────────────────\n108: // 4. HELPERS\n109: // ───────────────────────────────────────────────────────────────────\n110: \n111: function parsePositiveInt(value: string | undefined, fallback: number): number {\n112:   if (typeof value !== 'string' || value.trim().length === 0) {\n113:     return fallback;\n114:   }\n115:   const parsed = Number.parseInt(value, 10);\n116:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n117: }\n118: \n119: function defaultTimeoutMs(): number {\n120:   return parsePositiveInt(process.env.SPECKIT_OPENCODE_HOOK_TIMEOUT_MS, DEFAULT_TIMEOUT_MS);\n121: }\n122: \n123: function thresholdArgs(thresholdConfig: AdvisorThresholds | undefined): string[] {\n124:   const confidenceThreshold = String(thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold());\n125:   const uncertaintyThreshold = String(thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold());\n126:   const args = ['--threshold', confidenceThreshold, '--uncertainty', uncertaintyThreshold];\n127:   if (thresholdConfig?.confidenceOnly) {\n128:     args.push('--confidence-only');\n129:   }\n130:   if (thresholdConfig?.showRejections) {\n131:     args.push('--show-rejections');\n132:   }\n133:   return args;\n134: }\n135: \n136: function sanitizeStderr(stderr: string): string | null {\n137:   const compact = stderr.replace(/\\s+/g, ' ').trim();\n138:   if (!compact) {\n139:     return null;\n140:   }\n141:   return compact.slice(0, 240);\n142: }\n143: \n144: // Only the timeout bounded the child's output before, so a runaway child could\n145: // hold the hook's memory until it was killed. Both streams stop growing at the\n146: // cap instead.\n147: function capOutput(current: string, chunk: string): string {\n148:   if (current.length >= MAX_OUTPUT_CHARS) {\n149:     return current;\n150:   }\n151:   return (current + chunk).slice(0, MAX_OUTPUT_CHARS);\n152: }\n153: \n154: function coerceCompiledRouteSummary(value: unknown): CompiledRouteSummary | undefined {\n155:   if (!isRecord(value)) return undefined;\n156:   if (typeof value.outcome !== 'string' || value.outcome.length === 0) return undefined;\n157:   const targets = Array.isArray(value.targets)\n158:     ? value.targets.filter((target): target is string => typeof target === 'string')\n159:     : [];\n160:   return {\n161:     outcome: value.outcome,\n162:     hubId: typeof value.hubId === 'string' ? value.hubId : null,\n163:     targets,\n164:     servingAuthority: typeof value.servingAuthority === 'string' ? value.servingAuthority : 'compiled',\n165:     fingerprint: typeof value.fingerprint === 'string' ? value.fingerprint : null,\n166:     generation: typeof value.generation === 'number' ? value.generation : null,\n167:   };\n168: }\n169: \n170: // ───────────────────────────────────────────────────────────────────\n171: // 5. CORE LOGIC\n172: // ───────────────────────────────────────────────────────────────────\n173: \n174: function parseRecommendations(stdout: string): AdvisorRecommendation[] {\n175:   const parsed: unknown = JSON.parse(stdout);\n176:   if (!Array.isArray(parsed)) {\n177:     throw new Error(`advisor stdout: expected JSON array; actual ${typeof parsed}.`);\n178:   }\n179:   return parsed.map((item, index) => {\n180:     const path = `advisor stdout[${index}]`;\n181:     if (!isRecord(item)) {\n182:       throw new Error(`${path}: expected object recommendation; actual ${typeof item}.`);\n183:     }\n184:     if (typeof item.skill !== 'string' || item.skill.trim().length === 0) {\n185:       throw new Error(`${path}.skill: expected non-empty string; actual ${typeof item.skill}.`);\n186:     }\n187:     if (typeof item.confidence !== 'number' || Number.isNaN(item.confidence)) {\n188:       throw new Error(`${path}.confidence: expected finite number; actual ${typeof item.confidence}.`);\n189:     }\n190:     if (typeof item.uncertainty !== 'number' || Number.isNaN(item.uncertainty)) {\n191:       throw new Error(`${path}.uncertainty: expected finite number; actual ${typeof item.uncertainty}.`);\n192:     }\n193:     const compiledRouteSummary = coerceCompiledRouteSummary(item.compiledRouteSummary);\n194:     return {\n195:       skill: item.skill,\n196:       ...(typeof item.kind === 'string' ? { kind: item.kind } : {}),\n197:       confidence: item.confidence,\n198:       uncertainty: item.uncertainty,\n199:       ...(typeof item.passes_threshold === 'boolean' ? { passes_threshold: item.passes_threshold } : {}),\n200:       ...(typeof item.reason === 'string' ? { reason: item.reason } : {}),\n201:       ...(compiledRouteSummary ? { compiledRouteSummary } : {}),\n202:     };\n203:   });\n204: }\n205: \n206: function runSpawnAttempt(args: {\n207:   command: string;\n208:   commandArgs: readonly string[];\n209:   prompt: string;\n210:   cwd: string;\n211:   timeoutMs: number;\n212: }): Promise<SpawnAttemptResult> {\n213:   const startedAt = performance.now();\n214:   return new Promise((resolve) => {\n215:     let stdout = '';\n216:     let stderr = '';\n217:     let settled = false;\n218:     let timedOut = false;\n219:     let child: ChildProcess;\n220: \n221:     try {\n222:       child = spawn(args.command, args.commandArgs, {\n223:         cwd: args.cwd,\n224:         env: process.env,\n225:         stdio: ['pipe', 'pipe', 'pipe'],\n226:       });\n227:     } catch (error: unknown) {\n228:       resolve({\n229:         ok: false,\n230:         stdout,\n231:         stderr: error instanceof Error ? error.message : 'spawn failed',\n232:         exitCode: null,\n233:         signal: null,\n234:         errorCode: 'SPAWN_ERROR',\n235:         durationMs: performance.now() - startedAt,\n236:       });\n237:       return;\n238:     }\n239: \n240:     child.stdin?.write(args.prompt);\n241:     child.stdin?.end();\n242:     const timer = setTimeout(() => {\n243:       timedOut = true;\n244:       child.kill('SIGKILL');\n245:     }, args.timeoutMs);\n246: \n247:     child.stdout?.setEncoding('utf8');\n248:     child.stderr?.setEncoding('utf8');\n249:     child.stdout?.on('data', (chunk: string) => {\n250:       stdout = capOutput(stdout, chunk);\n251:     });\n252:     child.stderr?.on('data', (chunk: string) => {\n253:       stderr = capOutput(stderr, chunk);\n254:     });\n255:     child.on('error', (error: NodeJS.ErrnoException) => {\n256:       if (settled) {\n257:         return;\n258:       }\n259:       settled = true;\n260:       clearTimeout(timer);\n261:       resolve({\n262:         ok: false,\n263:         stdout,\n264:         stderr: error.message,\n265:         exitCode: null,\n266:         signal: null,\n267:         errorCode: error.code === 'ENOENT' ? 'PYTHON_MISSING' : 'SPAWN_ERROR',\n268:         durationMs: performance.now() - startedAt,\n269:       });\n270:     });\n271:     child.on('close', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n272:       if (settled) {\n273:         return;\n274:       }\n275:       settled = true;\n276:       clearTimeout(timer);\n277:       resolve({\n278:         ok: exitCode === 0 && signal === null && !timedOut,\n279:         stdout,\n280:         stderr,\n281:         exitCode,\n282:         signal,\n283:         errorCode: timedOut || performance.now() - startedAt >= args.timeoutMs\n284:           ? 'TIMEOUT'\n285:           : signal === 'SIGKILL'\n286:             ? 'SIGNAL_KILLED'\n287:             : null,\n288:         durationMs: performance.now() - startedAt,\n289:       });\n290:     });\n291:   });\n292: }\n293: \n294: async function delay(ms: number): Promise<void> {\n295:   await new Promise((resolve) => {\n296:     setTimeout(resolve, ms);\n297:   });\n298: }\n299: \n300: // ───────────────────────────────────────────────────────────────────\n301: // 6. EXPORTS\n302: // ───────────────────────────────────────────────────────────────────\n303: \n304: /** Run the Python skill advisor with prompt input carried over stdin. */\n305: export async function runAdvisorSubprocess(\n306:   prompt: string,\n307:   options: AdvisorSubprocessOptions,\n308: ): Promise<AdvisorSubprocessResult> {\n309:   const timeoutMs = options.timeoutMs ?? defaultTimeoutMs();\n310:   const scriptPath = options.scriptPath\n311:     ?? join(\n312:       options.workspaceRoot,\n313:       '.skilled',\n314:       'skills',\n315:       'system-skill-advisor',\n316:       'runtime',\n317:       'scripts',\n318:       'skill_advisor.py',\n319:     );\n320:   const startedAt = performance.now();\n321:   let retriesAttempted = 0;\n322: \n323:   if (!existsSync(scriptPath)) {\n324:     return {\n325:       ok: false,\n326:       recommendations: [],\n327:       errorCode: 'SCRIPT_MISSING',\n328:       exitCode: null,\n329:       signal: null,\n330:       stderr: null,\n331:       durationMs: performance.now() - startedAt,\n332:       retriesAttempted,\n333:     };\n334:   }\n335: \n336:   const commandArgs = [\n337:     scriptPath,\n338:     ...thresholdArgs(options.thresholdConfig),\n339:     '--stdin',\n340:   ];\n341:   const command = options.pythonBin ?? 'python3';\n342: \n343:   for (let attempt = 0; attempt < 2; attempt += 1) {\n344:     const elapsedMs = performance.now() - startedAt;\n345:     const remainingMs = Math.max(0, timeoutMs - elapsedMs);\n346:     const attemptResult = await runSpawnAttempt({\n347:       command,\n348:       commandArgs,\n349:       prompt,\n350:       cwd: options.workspaceRoot,\n351:       timeoutMs: Math.max(1, remainingMs),\n352:     });\n353: \n354:     if (!attemptResult.ok) {\n355:       const busy = SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n356:       const budgetRemaining = timeoutMs - (performance.now() - startedAt);\n357:       if (busy && attempt === 0 && budgetRemaining >= 500) {\n358:         retriesAttempted = 1;\n359:         await delay(options.retryJitterMs?.() ?? 75 + Math.floor(Math.random() * 51));\n360:         continue;\n361:       }\n362:       return {\n363:         ok: false,\n364:         recommendations: [],\n365:         errorCode: busy ? 'SQLITE_BUSY_EXHAUSTED' : attemptResult.errorCode ?? 'NON_ZERO_EXIT',\n366:         exitCode: attemptResult.exitCode,\n367:         signal: attemptResult.signal,\n368:         stderr: sanitizeStderr(attemptResult.stderr),\n369:         durationMs: performance.now() - startedAt,\n370:         retriesAttempted,\n371:       };\n372:     }\n373: \n374:     try {\n375:       return {\n376:         ok: true,\n377:         recommendations: parseRecommendations(attemptResult.stdout),\n378:         errorCode: null,\n379:         exitCode: attemptResult.exitCode,\n380:         signal: attemptResult.signal,\n381:         stderr: sanitizeStderr(attemptResult.stderr),\n382:         durationMs: performance.now() - startedAt,\n383:         retriesAttempted,\n384:       };\n385:     } catch (error: unknown) {\n386:       return {\n387:         ok: false,\n388:         recommendations: [],\n389:         errorCode: error instanceof SyntaxError ? 'JSON_PARSE_FAILED' : 'INVALID_JSON_SHAPE',\n390:         exitCode: attemptResult.exitCode,\n391:         signal: attemptResult.signal,\n392:         stderr: null,\n393:         durationMs: performance.now() - startedAt,\n394:         retriesAttempted,\n395:       };\n396:     }\n397:   }\n398: \n399:   return {\n400:     ok: false,\n401:     recommendations: [],\n402:     errorCode: 'SQLITE_BUSY_EXHAUSTED',\n403:     exitCode: null,\n404:     signal: null,\n405:     stderr: null,\n406:     durationMs: performance.now() - startedAt,\n407:     retriesAttempted,\n408:   };\n409: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts, lines 1-409\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Advisor Subprocess Runner\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { spawn } from 'node:child_process';\n10: import { existsSync } from 'node:fs';\n11: import { join } from 'node:path';\n12: import { performance } from 'node:perf_hooks';\n13: \n14: import { isRecord } from './utils/json-guard.js';\n15: \n16: import type { ChildProcess } from 'node:child_process';\n17: import type { AdvisorThresholds } from './prompt-cache.js';\n18: import { SKILL_ADVISOR_COMPAT_CONTRACT, resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\n19: \n20: // ───────────────────────────────────────────────────────────────────\n21: // 2. TYPE DEFINITIONS\n22: // ───────────────────────────────────────────────────────────────────\n23: \n24: /**\n25:  * Compact summary of a compiled routing decision, small enough to cross the\n26:  * brief boundary without carrying the full internal decision object. The served\n27:  * outcome is one of route/clarify/defer/reject; the fingerprint is the manifest\n28:  * serving-state hash used to invalidate a stale cached brief.\n29:  */\n30: export interface CompiledRouteSummary {\n31:   readonly outcome: string;\n32:   readonly hubId: string | null;\n33:   readonly targets: readonly string[];\n34:   readonly servingAuthority: string;\n35:   readonly fingerprint: string | null;\n36:   readonly generation: number | null;\n37: }\n38: \n39: export interface AdvisorRecommendation {\n40:   readonly skill: string;\n41:   readonly kind?: string;\n42:   readonly command?: string;\n43:   readonly policy?: string;\n44:   readonly ownerSkillId?: string;\n45:   // True when a hub held back its command because the prompt names no single mode.\n46:   readonly needsMode?: boolean;\n47:   readonly confidence: number;\n48:   readonly uncertainty: number;\n49:   readonly passes_threshold?: boolean;\n50:   readonly reason?: string;\n51:   // Additive: the compiled decision summary when a hub is compiled-serving. This\n52:   // path parses the Python advisor stdout, which does not emit it today, but the\n53:   // interface must not structurally drop it so a compiled decision reaching this\n54:   // brief path survives instead of being silently stripped.\n55:   readonly compiledRouteSummary?: CompiledRouteSummary;\n56: }\n57: \n58: export type AdvisorSubprocessErrorCode =\n59:   | 'PYTHON_MISSING'\n60:   | 'SCRIPT_MISSING'\n61:   | 'SIGNAL_KILLED'\n62:   | 'TIMEOUT'\n63:   | 'JSON_PARSE_FAILED'\n64:   | 'INVALID_JSON_SHAPE'\n65:   | 'NON_ZERO_EXIT'\n66:   | 'SQLITE_BUSY_EXHAUSTED'\n67:   | 'SPAWN_ERROR';\n68: \n69: export interface AdvisorSubprocessResult {\n70:   readonly ok: boolean;\n71:   readonly recommendations: AdvisorRecommendation[];\n72:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n73:   readonly exitCode: number | null;\n74:   readonly signal: NodeJS.Signals | null;\n75:   readonly stderr: string | null;\n76:   readonly durationMs: number;\n77:   readonly retriesAttempted: number;\n78: }\n79: \n80: export interface AdvisorSubprocessOptions {\n81:   readonly workspaceRoot: string;\n82:   readonly timeoutMs?: number;\n83:   readonly thresholdConfig?: AdvisorThresholds;\n84:   readonly pythonBin?: string;\n85:   readonly scriptPath?: string;\n86:   readonly retryJitterMs?: () => number;\n87: }\n88: \n89: interface SpawnAttemptResult {\n90:   readonly ok: boolean;\n91:   readonly stdout: string;\n92:   readonly stderr: string;\n93:   readonly exitCode: number | null;\n94:   readonly signal: NodeJS.Signals | null;\n95:   readonly errorCode: AdvisorSubprocessErrorCode | null;\n96:   readonly durationMs: number;\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────────\n100: // 3. CONSTANTS\n101: // ───────────────────────────────────────────────────────────────────\n102: \n103: const DEFAULT_TIMEOUT_MS = 3000;\n104: const MAX_OUTPUT_CHARS = 1024 * 1024;\n105: const SQLITE_BUSY_PATTERN = /\\bSQLITE_BUSY\\b|database is locked/i;\n106: \n107: // ───────────────────────────────────────────────────────────────────\n108: // 4. HELPERS\n109: // ───────────────────────────────────────────────────────────────────\n110: \n111: function parsePositiveInt(value: string | undefined, fallback: number): number {\n112:   if (typeof value !== 'string' || value.trim().length === 0) {\n113:     return fallback;\n114:   }\n115:   const parsed = Number.parseInt(value, 10);\n116:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n117: }\n118: \n119: function defaultTimeoutMs(): number {\n120:   return parsePositiveInt(process.env.SPECKIT_OPENCODE_HOOK_TIMEOUT_MS, DEFAULT_TIMEOUT_MS);\n121: }\n122: \n123: function thresholdArgs(thresholdConfig: AdvisorThresholds | undefined): string[] {\n124:   const confidenceThreshold = String(thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold());\n125:   const uncertaintyThreshold = String(thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold());\n126:   const args = ['--threshold', confidenceThreshold, '--uncertainty', uncertaintyThreshold];\n127:   if (thresholdConfig?.confidenceOnly) {\n128:     args.push('--confidence-only');\n129:   }\n130:   if (thresholdConfig?.showRejections) {\n131:     args.push('--show-rejections');\n132:   }\n133:   return args;\n134: }\n135: \n136: function sanitizeStderr(stderr: string): string | null {\n137:   const compact = stderr.replace(/\\s+/g, ' ').trim();\n138:   if (!compact) {\n139:     return null;\n140:   }\n141:   return compact.slice(0, 240);\n142: }\n143: \n144: // Only the timeout bounded the child's output before, so a runaway child could\n145: // hold the hook's memory until it was killed. Both streams stop growing at the\n146: // cap instead.\n147: function capOutput(current: string, chunk: string): string {\n148:   if (current.length >= MAX_OUTPUT_CHARS) {\n149:     return current;\n150:   }\n151:   return (current + chunk).slice(0, MAX_OUTPUT_CHARS);\n152: }\n153: \n154: function coerceCompiledRouteSummary(value: unknown): CompiledRouteSummary | undefined {\n155:   if (!isRecord(value)) return undefined;\n156:   if (typeof value.outcome !== 'string' || value.outcome.length === 0) return undefined;\n157:   const targets = Array.isArray(value.targets)\n158:     ? value.targets.filter((target): target is string => typeof target === 'string')\n159:     : [];\n160:   return {\n161:     outcome: value.outcome,\n162:     hubId: typeof value.hubId === 'string' ? value.hubId : null,\n163:     targets,\n164:     servingAuthority: typeof value.servingAuthority === 'string' ? value.servingAuthority : 'compiled',\n165:     fingerprint: typeof value.fingerprint === 'string' ? value.fingerprint : null,\n166:     generation: typeof value.generation === 'number' ? value.generation : null,\n167:   };\n168: }\n169: \n170: // ───────────────────────────────────────────────────────────────────\n171: // 5. CORE LOGIC\n172: // ───────────────────────────────────────────────────────────────────\n173: \n174: function parseRecommendations(stdout: string): AdvisorRecommendation[] {\n175:   const parsed: unknown = JSON.parse(stdout);\n176:   if (!Array.isArray(parsed)) {\n177:     throw new Error(`advisor stdout: expected JSON array; actual ${typeof parsed}.`);\n178:   }\n179:   return parsed.map((item, index) => {\n180:     const path = `advisor stdout[${index}]`;\n181:     if (!isRecord(item)) {\n182:       throw new Error(`${path}: expected object recommendation; actual ${typeof item}.`);\n183:     }\n184:     if (typeof item.skill !== 'string' || item.skill.trim().length === 0) {\n185:       throw new Error(`${path}.skill: expected non-empty string; actual ${typeof item.skill}.`);\n186:     }\n187:     if (typeof item.confidence !== 'number' || Number.isNaN(item.confidence)) {\n188:       throw new Error(`${path}.confidence: expected finite number; actual ${typeof item.confidence}.`);\n189:     }\n190:     if (typeof item.uncertainty !== 'number' || Number.isNaN(item.uncertainty)) {\n191:       throw new Error(`${path}.uncertainty: expected finite number; actual ${typeof item.uncertainty}.`);\n192:     }\n193:     const compiledRouteSummary = coerceCompiledRouteSummary(item.compiledRouteSummary);\n194:     return {\n195:       skill: item.skill,\n196:       ...(typeof item.kind === 'string' ? { kind: item.kind } : {}),\n197:       confidence: item.confidence,\n198:       uncertainty: item.uncertainty,\n199:       ...(typeof item.passes_threshold === 'boolean' ? { passes_threshold: item.passes_threshold } : {}),\n200:       ...(typeof item.reason === 'string' ? { reason: item.reason } : {}),\n201:       ...(compiledRouteSummary ? { compiledRouteSummary } : {}),\n202:     };\n203:   });\n204: }\n205: \n206: function runSpawnAttempt(args: {\n207:   command: string;\n208:   commandArgs: readonly string[];\n209:   prompt: string;\n210:   cwd: string;\n211:   timeoutMs: number;\n212: }): Promise<SpawnAttemptResult> {\n213:   const startedAt = performance.now();\n214:   return new Promise((resolve) => {\n215:     let stdout = '';\n216:     let stderr = '';\n217:     let settled = false;\n218:     let timedOut = false;\n219:     let child: ChildProcess;\n220: \n221:     try {\n222:       child = spawn(args.command, args.commandArgs, {\n223:         cwd: args.cwd,\n224:         env: process.env,\n225:         stdio: ['pipe', 'pipe', 'pipe'],\n226:       });\n227:     } catch (error: unknown) {\n228:       resolve({\n229:         ok: false,\n230:         stdout,\n231:         stderr: error instanceof Error ? error.message : 'spawn failed',\n232:         exitCode: null,\n233:         signal: null,\n234:         errorCode: 'SPAWN_ERROR',\n235:         durationMs: performance.now() - startedAt,\n236:       });\n237:       return;\n238:     }\n239: \n240:     child.stdin?.write(args.prompt);\n241:     child.stdin?.end();\n242:     const timer = setTimeout(() => {\n243:       timedOut = true;\n244:       child.kill('SIGKILL');\n245:     }, args.timeoutMs);\n246: \n247:     child.stdout?.setEncoding('utf8');\n248:     child.stderr?.setEncoding('utf8');\n249:     child.stdout?.on('data', (chunk: string) => {\n250:       stdout = capOutput(stdout, chunk);\n251:     });\n252:     child.stderr?.on('data', (chunk: string) => {\n253:       stderr = capOutput(stderr, chunk);\n254:     });\n255:     child.on('error', (error: NodeJS.ErrnoException) => {\n256:       if (settled) {\n257:         return;\n258:       }\n259:       settled = true;\n260:       clearTimeout(timer);\n261:       resolve({\n262:         ok: false,\n263:         stdout,\n264:         stderr: error.message,\n265:         exitCode: null,\n266:         signal: null,\n267:         errorCode: error.code === 'ENOENT' ? 'PYTHON_MISSING' : 'SPAWN_ERROR',\n268:         durationMs: performance.now() - startedAt,\n269:       });\n270:     });\n271:     child.on('close', (exitCode: number | null, signal: NodeJS.Signals | null) => {\n272:       if (settled) {\n273:         return;\n274:       }\n275:       settled = true;\n276:       clearTimeout(timer);\n277:       resolve({\n278:         ok: exitCode === 0 && signal === null && !timedOut,\n279:         stdout,\n280:         stderr,\n281:         exitCode,\n282:         signal,\n283:         errorCode: timedOut || performance.now() - startedAt >= args.timeoutMs\n284:           ? 'TIMEOUT'\n285:           : signal === 'SIGKILL'\n286:             ? 'SIGNAL_KILLED'\n287:             : null,\n288:         durationMs: performance.now() - startedAt,\n289:       });\n290:     });\n291:   });\n292: }\n293: \n294: async function delay(ms: number): Promise<void> {\n295:   await new Promise((resolve) => {\n296:     setTimeout(resolve, ms);\n297:   });\n298: }\n299: \n300: // ───────────────────────────────────────────────────────────────────\n301: // 6. EXPORTS\n302: // ───────────────────────────────────────────────────────────────────\n303: \n304: /** Run the Python skill advisor with prompt input carried over stdin. */\n305: export async function runAdvisorSubprocess(\n306:   prompt: string,\n307:   options: AdvisorSubprocessOptions,\n308: ): Promise<AdvisorSubprocessResult> {\n309:   const timeoutMs = options.timeoutMs ?? defaultTimeoutMs();\n310:   const scriptPath = options.scriptPath\n311:     ?? join(\n312:       options.workspaceRoot,\n313:       '.skilled',\n314:       'skills',\n315:       'system-skill-advisor',\n316:       'runtime',\n317:       'scripts',\n318:       'skill_advisor.py',\n319:     );\n320:   const startedAt = performance.now();\n321:   let retriesAttempted = 0;\n322: \n323:   if (!existsSync(scriptPath)) {\n324:     return {\n325:       ok: false,\n326:       recommendations: [],\n327:       errorCode: 'SCRIPT_MISSING',\n328:       exitCode: null,\n329:       signal: null,\n330:       stderr: null,\n331:       durationMs: performance.now() - startedAt,\n332:       retriesAttempted,\n333:     };\n334:   }\n335: \n336:   const commandArgs = [\n337:     scriptPath,\n338:     ...thresholdArgs(options.thresholdConfig),\n339:     '--stdin',\n340:   ];\n341:   const command = options.pythonBin ?? 'python3';\n342: \n343:   for (let attempt = 0; attempt < 2; attempt += 1) {\n344:     const elapsedMs = performance.now() - startedAt;\n345:     const remainingMs = Math.max(0, timeoutMs - elapsedMs);\n346:     const attemptResult = await runSpawnAttempt({\n347:       command,\n348:       commandArgs,\n349:       prompt,\n350:       cwd: options.workspaceRoot,\n351:       timeoutMs: Math.max(1, remainingMs),\n352:     });\n353: \n354:     if (!attemptResult.ok) {\n355:       const busy = SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n356:       const budgetRemaining = timeoutMs - (performance.now() - startedAt);\n357:       if (busy && attempt === 0 && budgetRemaining >= 500) {\n358:         retriesAttempted = 1;\n359:         await delay(options.retryJitterMs?.() ?? 75 + Math.floor(Math.random() * 51));\n360:         continue;\n361:       }\n362:       return {\n363:         ok: false,\n364:         recommendations: [],\n365:         errorCode: busy ? 'SQLITE_BUSY_EXHAUSTED' : attemptResult.errorCode ?? 'NON_ZERO_EXIT',\n366:         exitCode: attemptResult.exitCode,\n367:         signal: attemptResult.signal,\n368:         stderr: sanitizeStderr(attemptResult.stderr),\n369:         durationMs: performance.now() - startedAt,\n370:         retriesAttempted,\n371:       };\n372:     }\n373: \n374:     try {\n375:       return {\n376:         ok: true,\n377:         recommendations: parseRecommendations(attemptResult.stdout),\n378:         errorCode: null,\n379:         exitCode: attemptResult.exitCode,\n380:         signal: attemptResult.signal,\n381:         stderr: sanitizeStderr(attemptResult.stderr),\n382:         durationMs: performance.now() - startedAt,\n383:         retriesAttempted,\n384:       };\n385:     } catch (error: unknown) {\n386:       return {\n387:         ok: false,\n388:         recommendations: [],\n389:         errorCode: error instanceof SyntaxError ? 'JSON_PARSE_FAILED' : 'INVALID_JSON_SHAPE',\n390:         exitCode: attemptResult.exitCode,\n391:         signal: attemptResult.signal,\n392:         stderr: null,\n393:         durationMs: performance.now() - startedAt,\n394:         retriesAttempted,\n395:       };\n396:     }\n397:   }\n398: \n399:   return {\n400:     ok: false,\n401:     recommendations: [],\n402:     errorCode: 'SQLITE_BUSY_EXHAUSTED',\n403:     exitCode: null,\n404:     signal: null,\n405:     stderr: null,\n406:     durationMs: performance.now() - startedAt,\n407:     retriesAttempted,\n408:   };\n409: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts\"}"},"time":{"start":1794561550569,"end":1794561550629}}}}
{"type":"step_finish","timestamp":1794561556557,"sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","part":{"id":"prt_1d434404d0013nmfc2E8J9qhF3","sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","messageID":"msg_1d4340a15001rKyL0nR3xSKjkx","type":"step-finish","reason":"tool-calls","snapshot":"add2f25bea4785af3b51f24ff580256b6ad6a20c","cost":0,"tokens":{"input":6600,"output":145,"reasoning":51,"cache":{"read":33152,"write":0}}}}
{"type":"step_start","timestamp":1794561563288,"sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","part":{"id":"prt_1d4345a980019AHhXO8pwHH9Z3","sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","messageID":"msg_1d4344059001U1hG4t5XleehNc","type":"step-start","snapshot":"91e7ac01422bba08da1d71e328bb2eb81f594680"}}
{"type":"tool_use","timestamp":1794561571091,"sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","part":{"partID":"prt_1d43478520015dDHVTiUB0Lrv7","sessionID":"ses_e2bccad09ffe2W451DarRh6OXK","messageID":"msg_1d4344059001U1hG4t5XleehNc","type":"tool","id":"call_94a4eb5f6b5e48439c3ecf58","tool":"skill","state":{"status":"completed","input":{"id":"sk-code"},"output":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-code","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-code\"}"},"time":{"start":1794561570898,"end":1794561571091}}}}
