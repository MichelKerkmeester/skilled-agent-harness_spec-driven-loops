Subprocess('prompt', {\n36:       workspaceRoot,\n37:       pythonBin: process.execPath,\n38:       scriptPath,\n39:       timeoutMs: 10000,\n40:     });\n41: \n42:     expect(result.errorCode).toBe('JSON_PARSE_FAILED');\n43:   });\n44: \n45:   // The returned stderr is cut short whatever the cap, so the retry decision is\n46:   // the one reading that shows where collection stopped.\n47:   it('stops reading stderr at the cap, so a busy marker past it is not seen', async () => {\n48:     const scriptPath = writeScript(`\n49: process.stdin.resume();\n50: process.stdin.on('end', () => {\n51:   process.stderr.write('e'.repeat(1024 * 1024));\n52:   process.stderr.write('\\\\ndatabase is locked\\\\n');\n53:   process.exitCode = 1;\n54: });\n55: `);\n56:     const result = await runAdvisorSubprocess('prompt', {\n57:       workspaceRoot,\n58:       pythonBin: process.execPath,\n59:       scriptPath,\n60:       timeoutMs: 10000,\n61:     });\n62: \n63:     expect(result.ok).toBe(false);\n64:     expect(result.errorCode).toBe('NON_ZERO_EXIT');\n65:     expect(result.retriesAttempted).toBe(0);\n66:   });\n67: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts, lines 1-67\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Subprocess Output Cap Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n9: import { runAdvisorSubprocess } from '../lib/subprocess.js';\n10: \n11: let workspaceRoot = '';\n12: \n13: function writeScript(source: string): string {\n14:   const path = join(workspaceRo