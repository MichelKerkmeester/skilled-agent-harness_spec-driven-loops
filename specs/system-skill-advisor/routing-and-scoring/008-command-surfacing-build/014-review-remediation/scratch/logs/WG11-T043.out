\"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"test\"\n    }\n  ],\n  \"indexHash\": \"5069fc64e90403be8084b1daebc6506961222ed1377c36915b78c90e658b1108\",\n  \"manifestHash\": \"6c56dc075a672ad457f5a60f86ef4ad3b7f334987d327271f365568a027e9e45\",\n  \"normalizedQuery\": \"pin the sourceless dsh message rule in the session readers test\",\n  \"results\": [\n    {\n      \"matchClass\": \"query-containment\",\n      \"path\": \".skilled/hooks/shared/session-readers/README.md\",\n      \"phrases\": [\n        \"exact session id reader\",\n        \"read session history\",\n        \"session reader capabilities\",\n        \"session readers\"\n      ],\n      \"score\": 0.88\n    }\n  ],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"pin\",\n    \"the\",\n    \"sourceless\",\n    \"dsh\",\n    \"message\",\n    \"rule\",\n    \"session\",\n    \"readers\"\n  ],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Pin the sourceless DSH message rule in the session readers test\\\" 2>&1 | head -40\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794558793658,"end":1794558794228}}}}
