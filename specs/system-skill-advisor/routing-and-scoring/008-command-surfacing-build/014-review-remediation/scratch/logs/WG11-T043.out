{"type":"tool_use","timestamp":1794558794109,"sessionID":"ses_e2bf67522ffeXDCV6Z2AUOqOyV","part":{"partID":"prt_1d40a17b9002DSARgwTvyMyn5R","sessionID":"ses_e2bf67522ffeXDCV6Z2AUOqOyV","messageID":"msg_1d409e512001edGlI0bSBDm2X6","type":"tool","id":"call_67f923119d6b4c5eaec8347b","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs, lines 1-217\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: DSH Reader Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // The session directory is named by the exact id, so a missing id never scans a\n5: // newer sibling. Because the project key collapses separators, the header cwd\n6: // is checked before any event is trusted. Logs may be compressed frame chains.\n7: \n8: import assert from 'node:assert/strict';\n9: import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs';\n10: import { join } from 'node:path';\n11: import { test } from 'node:test';\n12: import { zstdCompressSync } from 'node:zlib';\n13: \n14: import { readSession } from '../../session-readers/index.mjs';\n15: import { dshProjectKey, loadDshSession } from '../../session-readers/dsh.mjs';\n16: import { DECOY, dshSession, NOW, SESSION } from './fixtures.mjs';\n17: import { trackFileOpens, withTempAsync, writeJsonl } from './helpers.mjs';\n18: \n19: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n20: \n21: // The fixtures build store folders with the reader's own key helper, so this\n22: // pins the helper to a folder name a real DSH install wrote.\n23: test('the project key matches the folder name DSH writes', () => {\n24:   assert.equal(\n25:     dshProjectKey('/Users/michelkerkmeester/Documents/deepseek-harness/default-workspace'),\n26:     '--Users-michelkerkmeester-Documents-deepseek-harness-default-workspace--',\n27:   );\n28: });\n29: \n30: test('a session log resolves by header id and matching cwd', async () => {\n31:   await withTempAsync('dsh-reader', async (root) => {\n32:     const projectDir = join(root, 'project');\n33:     mkdirSync(projectDir, { recursive: true });\n34:     const fixture = dshSession({ root, projectDir });\n35:     const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n36:     assert.equal(result.ok, true);\n37:     assert.equal(result.source.locatorKind, 'session_log');\n38:     assert.deepEqual(result.items.map((item) => item.role), ['user', 'assistant', 'toolResult', 'assistant']);\n39:     assert.equal(result.items[2].toolCallId, 'dsh-call-1');\n40:   });\n41: });\n42: \n43: test('an injected notice is returned apart from the records', async () => {\n44:   await withTempAsync('dsh-injected', async (root) => {\n45:     const projectDir = join(root, 'project');\n46:     mkdirSync(projectDir, { recursive: true });\n47:     const fixture = dshSession({ root, projectDir });\n48:     appendFileSync(fixture.filePath, `${JSON.stringify({\n49:       type: 'user/message',\n50:       seq: 5,\n51:       data: {\n52:         role: 'user',\n53:         id: 'dsh-injected-1',\n54:         source: { kind: 'repo-guards' },\n55:         content: [{ type: 'text', text: BRIEF }],\n56:       },\n57:     })}\\n`);\n58: \n59:     const result = await loadDshSession({ sessionId: SESSION, ...fixture.options });\n60:     assert.equal(result.ok, true);\n61:     assert.deepEqual(result.injected, [{ source: 'repo-guards', text: BRIEF }]);\n62:   });\n63: });\n64: \n65: test('a session path outside the store is refused without reading it', async () => {\n66:   await withTempAsync('dsh-outside', async (root) => {\n67:     const projectDir = join(root, 'project');\n68:     mkdirSync(projectDir, { recursive: true });\n69:     const fixture = dshSession({ root, projectDir });\n70:     const outside = writeJsonl(join(root, 'outside-dsh.jsonl'), [\n71:       { type: 'session', version: 4, id: SESSION, timestamp: NOW, cwd: projectDir },\n72:       {\n73:         type: 'user/message',\n74:         seq: 1,\n75:         data: { role: 'user', id: 'outside-u1', source: { kind: 'user' }, content: [{ type: 'text', text: 'outside the store' }] },\n76:       },\n77:     ]);\n78: \n79:     const tracker = trackFileOpens();\n80:     try {\n81:       const result = await readSession({\n82:         runtime: 'dsh',\n83:         sessionId: SESSION,\n84:         ...fixture.options,\n85:         sessionPath: outside,\n86:       });\n87:       assert.equal(result.ok, false);\n88:       assert.equal(result.code, 'session_mismatch');\n89:       assert.equal(tracker.opened.includes(outside), false, 'the outside path was opened before the refusal');\n90:     } finally {\n91:       tracker.restore();\n92:     }\n93:   });\n94: });\n95: \n96: test('a project-key collision is rejected by the header cwd', async () => {\n97:   await withTempAsync('dsh-collision', async (root) => {\n98:     const projectDir = join(root, 'a', 'b');\n99:     const otherDir = join(root, 'a-b');\n100:     mkdirSync(projectDir, { recursive: true });\n101:     mkdirSync(otherDir, { recursive: true });\n102: \n103:     const fixture = dshSession({ root, projectDir, headerCwd: otherDir });\n104:     const result = await readSession({ runtime: 'dsh', sessionId: SESSION, ...fixture.options });\n105:     assert.equal(result.ok, false);\n106:     assert.equal(result.code, 'session_mismatch');\n107:   });\n108: });\n109: \n110: test('an absent id is a session_not_found even when a newer session exists', async () => {\n111:   await withTempAsync('dsh-absent', async (root) => {\n112:     const projectDir = join(root, 'project');\n113:     mkdirSync(projectDir, { recursive: true });\n114:     dshSession({ root, projectDir, sessionId: DECOY });\n115:     const result = await readSession({\n116:       runtime: 'dsh',\n117:       sessionId: SESSION,\n118:       dshRoot: join(root, 'dsh', 'sessions'),\n119:       projectDir,\n120:     });\n121:     assert.equal(result.ok, false);\n122:     assert.equal(result.code, 'session_not_found');\n123:   });\n124: });\n125: \n126: test('a missing store is a store_unreadable', async () => {\n127:   await withTempAsync('dsh-unreadable', async (root) => {\n128:     const projectDir = join(root, 'project');\n129:     mkdirSync(projectDir, { recursive: true });\n130:     const result = await readSession({\n131:       runtime: 'dsh',\n132:       sessionId: SESSION,\n133:       dshRoot: join(root, 'missing-dsh-store'),\n134:       projectDir,\n135:     });\n136:     assert.equal(result.ok, false);\n137:     assert.equal(result.code, 'store_unreadable');\n138:   });\n139: });\n140: \n141: test('a compressed log is decoded through its frame chain', async () => {\n142:   await withTempAsync('dsh-zstd', async (root) => {\n143:     const projectDir = join(root, 'project');\n144:     mkdirSync(projectDir, { recursive: true });\n145:     const directory = join(root, 'dsh', 'sessions', dshProjectKey(projectDir), SESSION);\n146:     const lines = [\n147:       { type: 'session', version: 4, id: SESSION, timestamp: '2026-11-07T12:00:00.000Z', cwd: projectDir },\n148:       { type: 'user/message', seq: 1, data: { role: 'user', id: 'u1', source: { kind: 'user' }, content: [{ type: 'text', text: 'Hello.' }] } },\n149:     ];\n150:     const text = lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n';\n151:     const cut = text.indexOf('\\n', Math.floor(text.length / 2)) + 1;\n152: \n153:     mkdirSync(directory, { recursive: true });\n154:     const filePath = join(directory, 'session.v4.jsonl.zstd');\n155:     writeFileSync(filePath, Buffer.concat([\n156:       zstdCompressSync(Buffer.from(text.slice(0, cut))),\n157:       zstdCompressSync(Buffer.from(text.slice(cut))),\n158:     ]));\n159: \n160:     const result = await readSession({\n161:       runtime: 'dsh',\n162:       sessionId: SESSION,\n163:       dshRoot: join(root, 'dsh', 'sessions'),\n164:       projectDir,\n165:     });\n166:     assert.equal(result.ok, true);\n167:     assert.equal(result.items.length, 1);\n168:   });\n169: });\n170: \n171: test('a torn plain log still yields its complete entries', async () => {\n172:   await withTempAsync('dsh-torn', async (root) => {\n173:     const projectDir = join(root, 'project');\n174:     mkdirSync(projectDir, { recursive: true });\n175:     const directory = join(root, 'dsh', 'sessions', dshProjectKey(projectDir), SESSION);\n176:     const filePath = join(directory, 'session.v2.jsonl');\n177:     const complete = [\n178:       { type: 'session', version: 4, id: SESSION, cwd: projectDir },\n179:       { type: 'user/message', seq: 1, data: { role: 'user', id: 'u1', source: { kind: 'user' }, content: [{ type: 'text', text: 'Hello.' }] } },\n180:     ];\n181:     mkdirSync(directory, { recursive: true });\n182:     writeFileSync(filePath, complete.map((line) => JSON.stringify(line)).join('\\n') + '\\n{\"type\":\"assistant/mess');\n183: \n184:     const result = await readSession({\n185:       runtime: 'dsh',\n186:       sessionId: SESSION,\n187:       dshRoot: join(root, 'dsh', 'sessions'),\n188:       projectDir,\n189:     });\n190:     assert.equal(result.ok, true);\n191:     assert.equal(result.items.length, 1);\n192:   });\n193: });\n194: \n195: test('a pruned tool result keeps its full first copy and the event time', async () => {\n196:   await withTempAsync('dsh-prune', async (root) => {\n197:     const projectDir = join(root, 'project');\n198:     mkdirSync(projectDir, { recursive: true });\n199:     const directory = join(root, 'dsh', 'sessions', dshProjectKey(projectDir), SESSION);\n200:     const time = Date.parse('2026-11-07T12:00:00.000Z');\n201:     writeJsonl(join(directory, 'session.v4.jsonl'), [\n202:       { type: 'session', version: 4, id: SESSION, cwd: projectDir },\n203:       { type: 'user/message', seq: 1, time, data: { role: 'user', id: 'u1', source: { kind: 'user' }, content: [{ type: 'text', text: 'Read it.' }] } },\n204:       { type: 'assistant/message', seq: 2, time, data: { message: { role: 'assistant', id: 'a1', content: [{ type: 'tool-call', id: 'call-1', name: 'read', arguments: '{}' }] } } },\n205:       { type: 'tool/result', seq: 3, time, data: { message: { role: 'tool', id: 'r1', toolCallId: 'call-1', content: [{ type: 'text', text: 'full output' }] } } },\n206:       { type: 'compaction/prune', seq: 4, time, data: { shadowedSeqs: [3] } },\n207:       { type: 'tool/result', seq: 5, time, data: { message: { role: 'tool', id: 'r1', toolCallId: 'call-1', content: [{ type: 'text', text: '[pruned]' }] } } },\n208:     ]);\n209: \n210:     const result = await readSession({ runtime: 'dsh', sessionId: SESSION, dshRoot: join(root, 'dsh', 'sessions'), projectDir });\n211:     assert.equal(result.ok, true);\n212:     const results = result.items.filter((item) => item.role === 'toolResult');\n213:     assert.equal(results.length, 1);\n214:     assert.match(JSON.stringify(results[0]), /full output/);\n215:     assert.equal(result.items[0].timestamp, '2026-11-07T12:00:00.000Z');\n216:   });\n217: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/tests/session-readers/dsh.test.mjs, lines 1-217\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: DSH Reader Tests\n3: // ───────────────────────────────────────────────────────────────────\n4: // The session directory is named by the exact id, so a missing id never scans a\n5: // newer sibling. Because the project key collapses separators, the header cwd\n6: // is checked before any event is trusted. Logs may