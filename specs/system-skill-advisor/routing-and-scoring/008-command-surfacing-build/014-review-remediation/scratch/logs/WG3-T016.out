{"type":"tool_use","timestamp":1794558894687,"sessionID":"ses_e2bf657d9ffeZor0bLpbFpOui5","part":{"partID":"prt_1d40b9ff400255qjfj63R7CQo9","sessionID":"ses_e2bf657d9ffeZor0bLpbFpOui5","messageID":"msg_1d409dc8600146TOBnVqhB6bEC","type":"tool","id":"call_8dcfe9c930cf46f7a63f48d0","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts, lines 1-120\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Child Session Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A dispatched child must not start a workflow its parent did not name, so the\n6: // brief swaps the policy word for a marker there and nowhere else.\n7: //\n8: // Axes, one row each:\n9: //   child variable: set to 1, set to another value (0), unset\n10: //   policy: run, start, ask\n11: //   class: read-only, not read-only (add-only)\n12: \n13: import { afterEach, describe, expect, it, vi } from 'vitest';\n14: import {\n15:   DIRECTIVES_LABEL,\n16:   HYGIENE_DIRECTIVE,\n17:   renderAdvisorBrief,\n18: } from '../lib/render.js';\n19: \n20: type AdvisorBriefResult = Parameters<typeof renderAdvisorBrief>[0];\n21: \n22: function expectedBrief(summary: string): string {\n23:   return `${summary}${DIRECTIVES_LABEL}${HYGIENE_DIRECTIVE}`;\n24: }\n25: \n26: // One passing recommendation isolates the label form from threshold filtering.\n27: function advisorResult(skill: string): AdvisorBriefResult {\n28:   return {\n29:     status: 'ok',\n30:     freshness: 'live',\n31:     recommendations: [{\n32:       skill,\n33:       kind: 'command',\n34:       confidence: 0.85,\n35:       uncertainty: 0.2,\n36:       passes_threshold: true,\n37:     }],\n38:     metrics: { tokenCap: 80 },\n39:   };\n40: }\n41: \n42: describe('child session command brief', () => {\n43:   afterEach(() => {\n44:     vi.unstubAllEnvs();\n45:   });\n46: \n47:   it('renders a start command as parent-named only', () => {\n48:     vi.stubEnv('AI_SESSION_CHILD', '1');\n49: \n50:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n51: \n52:     expect(rendered).toBe(expectedBrief(\n53:       'Advisor: live; use sk-doc → /create:readme (parent-named only) 0.85/0.20 pass.',\n54:     ));\n55:   });\n56: \n57:   it('renders an ask command as parent-named only', () => {\n58:     vi.stubEnv('AI_SESSION_CHILD', '1');\n59: \n60:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n61: \n62:     expect(rendered).toBe(expectedBrief(\n63:       'Advisor: live; use system-deep-loop → /deep:research (parent-named only) 0.85/0.20 pass.',\n64:     ));\n65:   });\n66: \n67:   it('keeps the policy word for a read-only run', () => {\n68:     vi.stubEnv('AI_SESSION_CHILD', '1');\n69: \n70:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-setup'));\n71: \n72:     expect(rendered).toBe(expectedBrief(\n73:       'Advisor: live; use sk-git → /doctor:git setup (run) 0.85/0.20 pass.',\n74:     ));\n75:   });\n76: \n77:   it('renders a run command that adds files as parent-named only', () => {\n78:     vi.stubEnv('AI_SESSION_CHILD', '1');\n79: \n80:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-speckit'));\n81: \n82:     expect(rendered).toBe(expectedBrief(\n83:       'Advisor: live; use system-skilled-doctor → /doctor:speckit (parent-named only) 0.85/0.20 pass.',\n84:     ));\n85:   });\n86: \n87:   it('matches the non-child render when the variable is 0', () => {\n88:     vi.stubEnv('AI_SESSION_CHILD', '0');\n89:     const baseline = renderAdvisorBrief(advisorResult('command-create-readme'), { childSession: false });\n90: \n91:     const rendered = renderAdvisorBrief(advisorResult('command-create-readme'));\n92: \n93:     expect(rendered).toBe(baseline);\n94:     expect(rendered).toBe(expectedBrief(\n95:       'Advisor: live; use sk-doc → /create:readme (start) 0.85/0.20 pass.',\n96:     ));\n97:   });\n98: \n99:   it('matches the non-child render when the variable is unset', () => {\n100:     vi.stubEnv('AI_SESSION_CHILD', undefined);\n101:     const baseline = renderAdvisorBrief(advisorResult('command-deep-research'), { childSession: false });\n102: \n103:     const rendered = renderAdvisorBrief(advisorResult('command-deep-research'));\n104: \n105:     expect(rendered).toBe(baseline);\n106:     expect(rendered).toBe(expectedBrief(\n107:       'Advisor: live; use system-deep-loop → /deep:research (ask) 0.85/0.20 pass.',\n108:     ));\n109:   });\n110: \n111:   it('renders a doctor bridge at the top as parent-named only', () => {\n112:     vi.stubEnv('AI_SESSION_CHILD', '1');\n113: \n114:     const rendered = renderAdvisorBrief(advisorResult('command-doctor-git-hooks'));\n115: \n116:     expect(rendered).toBe(expectedBrief(\n117:       'Advisor: live; use sk-git → /doctor:git hooks (parent-named only) 0.85/0.20 pass.',\n118:     ));\n119:   });\n120: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/render-child-session.vitest.ts, lines 1-120\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Child Session Brief Render Tests\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A dispatched child must not start a workflow its parent did not name, so the\n6: // brief swaps the policy word for a marker there and nowhere else.\n7: //\n8: // Axes, one row each:\n9: //   child variable: set to 1, set to another value (0), unset\n10: //   po