or:update compat, then rerun this check$/m);\n\n  Line 302:   assert.match(out, /^ {6}repair: chmod \\+x \\.skilled\\/skills\\/sk-code\\/sk-code-quality\\/scripts\\/check-comment-hygiene\\.sh$/m);\n\n  Line 314:   assert.match(out, /^ {6}repair: node --test \\.skilled\\/skills\\/sk-code\\/sk-code-quality\\/scripts\\/tests\\/\\*\\.test\\.cjs, then fix each failing test$/m);\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/git-setup-check.test.cjs:\n  Line 174:   check.run = () => ({ result: results[i], source: 'stub', details: [], repair: results[i] === 'FAIL' || results[i] === 'DEGRADED' ? 'stub repair' : null });\n\n  Line 246:   const expectedRulesRepair = `      repair: mkdir -p ${path.dirname(rulesFile)}`\n\n  Line 262:   const repairLines = lines.filter((line) => line.startsWith('      repair: '));\n\n  Line 264:     `      repair: git config core.hooksPath ${HOOKS_SOURCE}`,\n\n  Line 265:     '      repair: /doctor:git hooks',\n\n  Line 267:     '      repair: unset SYSTEM_HOOKS_DISABLED',\n\n  Line 268:     '      repair: register git-preflight-advisory in .codex/hooks.json (see .skilled/skills/sk-git/scripts/hooks/README.md section 3)',\n\n  Line 305:     { rows: rowsFor([[2, 'DEGRADED']]), status: 'DEGRADED', code: 3, line: 'STATUS=DEGRADED degraded=1 skipped=0 unknown=0', repair: 'stub repair' },\n\n  Line 319:       assert.ok(human.stdout.includes(`      repair: ${c.repair}`), `${c.line}: repair line`);\n\n  Line 591:   assert.ok(humanLines.includes('      repair: unset SK_GIT_PREFLIGHT_DISABLED'));\n\n\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/lib/quality-config-source.cjs:\n  Line 69:     return { checks: 'none', reason, repair: null };\n\n  Line 74:   return { ...trust, repair: trust.checks === 'untrusted' ? TRUST_REPAIR : null };\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"pattern\":\"repair:\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts\",\"include\":\"*.cjs\"}"},"time":{"start":1794558844192,"end":1794558844797}}}}
