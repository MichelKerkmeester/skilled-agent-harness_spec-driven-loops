{"type":"tool_use","timestamp":1794558828055,"sessionID":"ses_e2bf5cb73ffeyTurLwJkKK3EkO","part":{"partID":"prt_1d40a9a77001Ae9p3cg70boSs9","sessionID":"ses_e2bf5cb73ffeyTurLwJkKK3EkO","messageID":"msg_1d40a6475001WxfGrk3Ta21Geq","type":"tool","id":"call_a7d0a38389eb40c8a505da44","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs, lines 1-216\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Codex runs a project hook only after the operator approves that exact entry.\n8: // The approval lives in config.toml under a hooks.state key as a trusted_hash,\n9: // and an unapproved entry is skipped without a warning. A wired advisor hook can\n10: // therefore be present in .codex/hooks.json and still never deliver a brief,\n11: // which no diff can tell apart from a hook that was never wired.\n12: //\n13: // This check is read-only on purpose. The approval belongs to the /hooks review\n14: // in a Codex session, so the repair line names that step instead of offering to\n15: // copy a hash. The hash value stays out of every output because echoing a\n16: // credential serves no diagnostic purpose.\n17: //\n18: // Exit codes:\n19: //   0  the project has no hooks file, or the advisor entry is approved\n20: //   1  the advisor entry is absent, or present and unapproved\n21: //   2  bad argument\n22: //\n23: // Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n24: //   --root    project root whose .codex/hooks.json is read, defaults to the cwd\n25: //   --config  Codex config file, defaults to $CODEX_HOME/config.toml\n26: //   --json    print one JSON object instead of the text lines\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: const fs = require('node:fs');\n33: const os = require('node:os');\n34: const path = require('node:path');\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const ADVISOR_MARKER = 'hooks/codex/user-prompt-submit.js';\n41: const EVENT_KEY = 'user_prompt_submit';\n42: const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n43: \n44: // ─────────────────────────────────────────────────────────────────────────────\n45: // 3. HELPERS\n46: // ─────────────────────────────────────────────────────────────────────────────\n47: \n48: // A misspelled or value-less flag must fail loudly rather than read another root,\n49: // and a value that is itself a flag means the value was left out, so taking it\n50: // would swallow the next option and read a root nobody named.\n51: function parseArgs(argv) {\n52:   const options = { root: process.cwd(), config: null, json: false };\n53:   for (let index = 0; index < argv.length; index += 1) {\n54:     const arg = argv[index];\n55:     if (arg === '--json') {\n56:       options.json = true;\n57:       continue;\n58:     }\n59:     if (arg === '--root' || arg === '--config') {\n60:       const value = argv[index + 1];\n61:       if (value === undefined || value === '' || value.startsWith('-')) return null;\n62:       options[arg.slice(2)] = value;\n63:       index += 1;\n64:       continue;\n65:     }\n66:     return null;\n67:   }\n68:   return options;\n69: }\n70: \n71: function defaultConfigFile() {\n72:   const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');\n73:   return path.join(codexHome, 'config.toml');\n74: }\n75: \n76: function trimSeparators(value) {\n77:   const trimmed = value.replace(/[\\\\/]+$/, '');\n78:   return trimmed === '' ? value : trimmed;\n79: }\n80: \n81: // Codex keys an approval by the hooks file, the event, the group and the hook\n82: // index, so any edit that moves the advisor entry needs a fresh approval. The\n83: // caller may pass a relative or symlinked root while Codex recorded the real\n84: // path, so both forms are tried.\n85: function hookStateKeys(root, group, index) {\n86:   const roots = [trimSeparators(root)];\n87:   try {\n88:     roots.push(trimSeparators(fs.realpathSync(root)));\n89:   } catch {\n90:     // A root that cannot be resolved has only the form the caller gave.\n91:   }\n92:   const keys = [];\n93:   for (const base of roots) {\n94:     const key = `${base}/.codex/hooks.json:${EVENT_KEY}:${group}:${index}`;\n95:     if (!keys.includes(key)) keys.push(key);\n96:   }\n97:   return keys;\n98: }\n99: \n100: // An unparseable hooks file cannot hold a findable entry, so it takes the same\n101: // verdict as a file that lacks the entry. Either way the hook cannot run.\n102: function findAdvisorEntry(hooksFile) {\n103:   if (!fs.existsSync(hooksFile)) return { kind: 'skip' };\n104:   let document;\n105:   try {\n106:     document = JSON.parse(fs.readFileSync(hooksFile, 'utf8'));\n107:   } catch {\n108:     return { kind: 'absent' };\n109:   }\n110:   const groups = document?.hooks?.UserPromptSubmit;\n111:   if (!Array.isArray(groups)) return { kind: 'absent' };\n112:   for (const [groupIndex, group] of groups.entries()) {\n113:     const hooks = Array.isArray(group?.hooks) ? group.hooks : [];\n114:     for (const [hookIndex, hook] of hooks.entries()) {\n115:       if (typeof hook?.command === 'string' && hook.command.includes(ADVISOR_MARKER)) {\n116:         return { kind: 'present', group: groupIndex, index: hookIndex };\n117:       }\n118:     }\n119:   }\n120:   return { kind: 'absent' };\n121: }\n122: \n123: // The approval block ends at the next TOML header, so a trusted_hash recorded\n124: // under a different hooks.state key must not count for this entry.\n125: function approvalFound(configFile, keys) {\n126:   let text;\n127:   try {\n128:     text = fs.readFileSync(configFile, 'utf8');\n129:   } catch {\n130:     return false;\n131:   }\n132:   const lines = text.split(/\\r?\\n/);\n133:   const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n134:   for (let index = 0; index < lines.length; index += 1) {\n135:     if (!headers.has(lines[index].trim())) continue;\n136:     for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n137:       const line = lines[cursor].trim();\n138:       if (line.startsWith('[')) break;\n139:       if (/^trusted_hash\\s*=/.test(line)) return true;\n140:     }\n141:   }\n142:   return false;\n143: }\n144: \n145: function report(options, verdict, lines) {\n146:   if (options.json) {\n147:     process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n148:     return;\n149:   }\n150:   for (const line of lines) process.stdout.write(`${line}\\n`);\n151: }\n152: \n153: // ─────────────────────────────────────────────────────────────────────────────\n154: // 4. CORE LOGIC\n155: // ─────────────────────────────────────────────────────────────────────────────\n156: \n157: function main(argv) {\n158:   const options = parseArgs(argv);\n159:   if (options === null) {\n160:     process.stderr.write(USAGE);\n161:     return 2;\n162:   }\n163: \n164:   const root = options.root;\n165:   const hooksFile = path.join(root, '.codex', 'hooks.json');\n166:   const entry = findAdvisorEntry(hooksFile);\n167: \n168:   if (entry.kind === 'skip') {\n169:     report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n170:     return 0;\n171:   }\n172: \n173:   if (entry.kind === 'absent') {\n174:     report(options, {\n175:       status: 'warn',\n176:       code: 'codex-advisor-hook-absent',\n177:       root,\n178:       hooksFile,\n179:     }, ['WARN codex-advisor-hook-absent']);\n180:     return 1;\n181:   }\n182: \n183:   const configFile = options.config || defaultConfigFile();\n184:   const keys = hookStateKeys(root, entry.group, entry.index);\n185:   if (approvalFound(configFile, keys)) {\n186:     report(options, {\n187:       status: 'pass',\n188:       code: 'codex-hooks-approved',\n189:       root,\n190:       group: entry.group,\n191:       index: entry.index,\n192:       config: configFile,\n193:     }, ['PASS codex-hooks-approved']);\n194:     return 0;\n195:   }\n196: \n197:   const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n198:   report(options, {\n199:     status: 'warn',\n200:     code: 'codex-hooks-unapproved',\n201:     root,\n202:     group: entry.group,\n203:     index: entry.index,\n204:     config: configFile,\n205:     repair,\n206:   }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n207:   return 1;\n208: }\n209: \n210: // ─────────────────────────────────────────────────────────────────────────────\n211: // 5. ENTRY POINT\n212: // ─────────────────────────────────────────────────────────────────────────────\n213: \n214: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n215: \n216: module.exports = { main, findAdvisorEntry, approvalFound };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs, lines 1-216\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Codex runs a project hook only after the operator approves that exact entry.\n8: // The approval lives in config.toml under a hooks.state key as a trusted_hash,\n9: // and an unapproved entry is skipped without a warning. A wired advisor hook can\n10: // therefore be present in .codex/hooks.json and still never deliver a brief,\n11: // which no diff can tell apart from a hook that was never wired.\n12: //\n13: // This check is read-only on purpose. The approval belongs to the /hooks review\n14: // in a Codex session, so the repair line names that step instead of offering to\n15: // copy a hash. The hash value stays out of every output because echoing a\n16: // credential serves no diagnostic purpose.\n17: //\n18: // Exit codes:\n19: //   0  the project has no hooks file, or the advisor entry is approved\n20: //   1  the advisor entry is absent, or present and unapproved\n21: //   2  bad argument\n22: //\n23: // Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\n24: //   --root    project root whose .codex/hooks.json is read, defaults to the cwd\n25: //   --config  Codex config file, defaults to $CODEX_HOME/config.toml\n26: //   --json    print one JSON object instead of the text lines\n27: \n28: // ─────────────────────────────────────────────────────────────────────────────\n29: // 1. IMPORTS\n30: // ─────────────────────────────────────────────────────────────────────────────\n31: \n32: const fs = require('node:fs');\n33: const os = require('node:os');\n34: const path = require('node:path');\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const ADVISOR_MARKER = 'hooks/codex/user-prompt-submit.js';\n41: const EVENT_KEY = 'user_prompt_submit';\n42: const USAGE = 'Usage: codex-hook-approval-check.cjs [--root <dir>] [--config <path>] [--json]\\n';\n43: \n44: // ─────────────────────────────────────────────────────────────────────────────\n45: // 3. HELPERS\n46: // ─────────────────────────────────────────────────────────────────────────────\n47: \n48: // A misspelled or value-less flag must fail loudly rather than read another root,\n49: // and a value that is itself a flag means the value was left out, so taking it\n50: // would swallow the next option and read a root nobody named.\n51: function parseArgs(argv) {\n52:   const options = { root: process.cwd(), config: null, json: false };\n53:   for (let index = 0; index < argv.length; index += 1) {\n54:     const arg = argv[index];\n55:     if (arg === '--json') {\n56:       options.json = true;\n57:       continue;\n58:     }\n59:     if (arg === '--root' || arg === '--config') {\n60:       const value = argv[index + 1];\n61:       if (value === undefined || value === '' || value.startsWith('-')) return null;\n62:       options[arg.slice(2)] = value;\n63:       index += 1;\n64:       continue;\n65:     }\n66:     return null;\n67:   }\n68:   return options;\n69: }\n70: \n71: function defaultConfigFile() {\n72:   const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');\n73:   return path.join(codexHome, 'config.toml');\n74: }\n75: \n76: function trimSeparators(value) {\n77:   const trimmed = value.replace(/[\\\\/]+$/, '');\n78:   return trimmed === '' ? value : trimmed;\n79: }\n80: \n81: // Codex keys an approval by the hooks file, the event, the group and the hook\n82: // index, so any edit that moves the advisor entry needs a fresh approval. The\n83: // caller may pass a relative or symlinked root while Codex recorded the real\n84: // path, so both forms are tried.\n85: function hookStateKeys(root, group, index) {\n86:   const roots = [trimSeparators(root)];\n87:   try {\n88:     roots.push(trimSeparators(fs.realpathSync(root)));\n89:   } catch {\n90:     // A root that cannot be resolved has only the form the caller gave.\n91:   }\n92:   const keys = [];\n93:   for (const base of roots) {\n94:     const key = `${base}/.codex/hooks.json:${EVENT_KEY}:${group}:${index}`;\n95:     if (!keys.includes(key)) keys.push(key);\n96:   }\n97:   return keys;\n98: }\n99: \n100: // An unparseable hooks file cannot hold a findable entry, so it takes the same\n101: // verdict as a file that lacks the entry. Either way the hook cannot run.\n102: function findAdvisorEntry(hooksFile) {\n103:   if (!fs.existsSync(hooksFile)) return { kind: 'skip' };\n104:   let document;\n105:   try {\n106:     document = JSON.parse(fs.readFileSync(hooksFile, 'utf8'));\n107:   } catch {\n108:     return { kind: 'absent' };\n109:   }\n110:   const groups = document?.hooks?.UserPromptSubmit;\n111:   if (!Array.isArray(groups)) return { kind: 'absent' };\n112:   for (const [groupIndex, group] of groups.entries()) {\n113:     const hooks = Array.isArray(group?.hooks) ? group.hooks : [];\n114:     for (const [hookIndex, hook] of hooks.entries()) {\n115:       if (typeof hook?.command === 'string' && hook.command.includes(ADVISOR_MARKER)) {\n116:         return { kind: 'present', group: groupIndex, index: hookIndex };\n117:       }\n118:     }\n119:   }\n120:   return { kind: 'absent' };\n121: }\n122: \n123: // The approval block ends at the next TOML header, so a trusted_hash recorded\n124: // under a different hooks.state key must not count for this entry.\n125: function approvalFound(configFile, keys) {\n126:   let text;\n127:   try {\n128:     text = fs.readFileSync(configFile, 'utf8');\n129:   } catch {\n130:     return false;\n131:   }\n132:   const lines = text.split(/\\r?\\n/);\n133:   const headers = new Set(keys.map((key) => `[hooks.state.\"${key}\"]`));\n134:   for (let index = 0; index < lines.length; index += 1) {\n135:     if (!headers.has(lines[index].trim())) continue;\n136:     for (let cursor = index + 1; cursor < lines.length; cursor += 1) {\n137:       const line = lines[cursor].trim();\n138:       if (line.startsWith('[')) break;\n139:       if (/^trusted_hash\\s*=/.test(line)) return true;\n140:     }\n141:   }\n142:   return false;\n143: }\n144: \n145: function report(options, verdict, lines) {\n146:   if (options.json) {\n147:     process.stdout.write(`${JSON.stringify(verdict, null, 2)}\\n`);\n148:     return;\n149:   }\n150:   for (const line of lines) process.stdout.write(`${line}\\n`);\n151: }\n152: \n153: // ─────────────────────────────────────────────────────────────────────────────\n154: // 4. CORE LOGIC\n155: // ─────────────────────────────────────────────────────────────────────────────\n156: \n157: function main(argv) {\n158:   const options = parseArgs(argv);\n159:   if (options === null) {\n160:     process.stderr.write(USAGE);\n161:     return 2;\n162:   }\n163: \n164:   const root = options.root;\n165:   const hooksFile = path.join(root, '.codex', 'hooks.json');\n166:   const entry = findAdvisorEntry(hooksFile);\n167: \n168:   if (entry.kind === 'skip') {\n169:     report(options, { status: 'skip', code: 'no-codex-hooks', root }, ['SKIP no-codex-hooks']);\n170:     return 0;\n171:   }\n172: \n173:   if (entry.kind === 'absent') {\n174:     report(options, {\n175:       status: 'warn',\n176:       code: 'codex-advisor-hook-absent',\n177:       root,\n178:       hooksFile,\n179:     }, ['WARN codex-advisor-hook-absent']);\n180:     return 1;\n181:   }\n182: \n183:   const configFile = options.config || defaultConfigFile();\n184:   const keys = hookStateKeys(root, entry.group, entry.index);\n185:   if (approvalFound(configFile, keys)) {\n186:     report(options, {\n187:       status: 'pass',\n188:       code: 'codex-hooks-approved',\n189:       root,\n190:       group: entry.group,\n191:       index: entry.index,\n192:       config: configFile,\n193:     }, ['PASS codex-hooks-approved']);\n194:     return 0;\n195:   }\n196: \n197:   const repair = `repair: open /hooks in a Codex session at ${root} and approve each entry`;\n198:   report(options, {\n199:     status: 'warn',\n200:     code: 'codex-hooks-unapproved',\n201:     root,\n202:     group: entry.group,\n203:     index: entry.index,\n204:     config: configFile,\n205:     repair,\n206:   }, [`WARN codex-hooks-unapproved ${root}`, repair]);\n207:   return 1;\n208: }\n209: \n210: // ─────────────────────────────────────────────────────────────────────────────\n211: // 5. ENTRY POINT\n212: // ─────────────────────────────────────────────────────────────────────────────\n213: \n214: if (require.main === module) process.exitCode = main(process.argv.slice(2));\n215: \n216: module.exports = { main, findAdvisorEntry, approvalFound };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\"}"},"time":{"start":1794558827127,"end":1794558828055}}}}
{"type":"tool_use","timestamp":1794558828061,"sessionID":"ses_e2bf5cb73ffeyTurLwJkKK3EkO","part":{"partID":"prt_1d40a9c700011bE47LgEEgBpeg","sessionID":"ses_e2bf5cb73ffeyTurLwJkKK3EkO","messageID":"msg_1d40a6475001WxfGrk3Ta21Geq","type":"tool","id":"call_59973e010a1e4e6585c787af","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs, lines 1-124\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Codex Hook Approval Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the check as a process against throwaway project and config fixtures,\n8: // so each verdict is observed through its exit code and output exactly as a\n9: // doctor route sees it.\n10: \n11: // ─────────────────────────────────────────────────────────────────────────────\n12: // 1. IMPORTS AND FIXTURES\n13: // ─────────────────────────────────────────────────────────────────────────────\n14: \n15: const assert = require('node:assert/strict');\n16: const { spawnSync } = require('node:child_process');\n17: const fs = require('node:fs');\n18: const os = require('node:os');\n19: const path = require('node:path');\n20: const test = require('node:test');\n21: \n22: const SCRIPT = path.resolve(__dirname, '..', 'codex-hook-approval-check.cjs');\n23: const HOOKS_FILE = path.join('.codex', 'hooks.json');\n24: const CONFIG_FILE = 'config.toml';\n25: \n26: // The advisor entry sits at group 1, hook 1, so the verdict has to derive both\n27: // indices from the file rather than assume the first slot.\n28: const HOOKS_DOCUMENT = JSON.stringify({\n29:   hooks: {\n30:     UserPromptSubmit: [\n31:       { hooks: [{ type: 'command', command: 'node other-prompt-hook.js' }] },\n32:       {\n33:         hooks: [\n34:           { type: 'command', command: 'node spec-gate-classify.mjs' },\n35:           {\n36:             type: 'command',\n37:             command: \"bash -c 'node .skilled/skills/system-spec-kit/runtime/dist/hooks/codex/user-prompt-submit.js'\",\n38:           },\n39:         ],\n40:       },\n41:     ],\n42:   },\n43: });\n44: \n45: function fixture(t) {\n46:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'codex-hook-approval-'));\n47:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n48:   return root;\n49: }\n50: \n51: function writeFile(file, body) {\n52:   fs.mkdirSync(path.dirname(file), { recursive: true });\n53:   fs.writeFileSync(file, body);\n54: }\n55: \n56: function run(root, config) {\n57:   return spawnSync(process.execPath, [SCRIPT, '--root', root, '--config', config], { encoding: 'utf8' });\n58: }\n59: \n60: function stateKey(root, group, index) {\n61:   return `[hooks.state.\"${path.join(root, HOOKS_FILE)}:user_prompt_submit:${group}:${index}\"]`;\n62: }\n63: \n64: // ─────────────────────────────────────────────────────────────────────────────\n65: // 2. TESTS\n66: // ─────────────────────────────────────────────────────────────────────────────\n67: \n68: test('an approved advisor entry passes', (t) => {\n69:   const root = fixture(t);\n70:   const config = path.join(root, CONFIG_FILE);\n71:   writeFile(path.join(root, HOOKS_FILE), HOOKS_DOCUMENT);\n72:   writeFile(config, [\n73:     stateKey(root, 0, 0),\n74:     'trusted_hash = \"sha256:other\"',\n75:     stateKey(root, 1, 1),\n76:     'trusted_hash = \"sha256:advisor\"',\n77:     '',\n78:   ].join('\\n'));\n79: \n80:   const result = run(root, config);\n81:   assert.equal(result.status, 0, result.stderr);\n82:   assert.equal(result.stdout, 'PASS codex-hooks-approved\\n');\n83:   assert.doesNotMatch(result.stdout, /sha256/);\n84: });\n85: \n86: test('an entry with no approval warns and names the repair', (t) => {\n87:   const root = fixture(t);\n88:   const config = path.join(root, CONFIG_FILE);\n89:   writeFile(path.join(root, HOOKS_FILE), HOOKS_DOCUMENT);\n90: \n91:   // The advisor's key exists but holds no trusted_hash, and the one approval in\n92:   // the file belongs to another group.\n93:   writeFile(config, [\n94:     stateKey(root, 0, 0),\n95:     'trusted_hash = \"sha256:other\"',\n96:     stateKey(root, 1, 1),\n97:     'trusted = \"not a hash\"',\n98:     '',\n99:   ].join('\\n'));\n100: \n101:   const result = run(root, config);\n102:   assert.equal(result.status, 1, result.stderr);\n103:   assert.equal(result.stdout, [\n104:     `WARN codex-hooks-unapproved ${root}`,\n105:     `repair: open /hooks in a Codex session at ${root} and approve each entry`,\n106:     '',\n107:   ].join('\\n'));\n108:   assert.doesNotMatch(result.stdout, /sha256/);\n109: });\n110: \n111: test('a project without .codex is skipped', (t) => {\n112:   const root = fixture(t);\n113:   const result = run(root, path.join(root, CONFIG_FILE));\n114:   assert.equal(result.status, 0, result.stderr);\n115:   assert.equal(result.stdout, 'SKIP no-codex-hooks\\n');\n116: });\n117: \n118: // A flag standing where a value belongs leaves the option without a value. The run\n119: // must refuse the arguments rather than read a root the operator never named.\n120: test('a flag standing where a value belongs is refused', () => {\n121:   const result = spawnSync(process.execPath, [SCRIPT, '--root', '--json'], { encoding: 'utf8' });\n122:   assert.equal(result.status, 2, result.stderr);\n123:   assert.match(result.stderr, /Usage: codex-hook-approval-check\\.cjs/);\n124: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs, li