48:   return root;\n49: }\n50: \n51: function writeFile(file, body) {\n52:   fs.mkdirSync(path.dirname(file), { recursive: true });\n53:   fs.writeFileSync(file, body);\n54: }\n55: \n56: function run(root, config) {\n57:   return spawnSync(process.execPath, [SCRIPT, '--root', root, '--config', config], { encoding: 'utf8' });\n58: }\n59: \n60: function stateKey(root, group, index) {\n61:   return `[hooks.state.\"${path.join(root, HOOKS_FILE)}:user_prompt_submit:${group}:${index}\"]`;\n62: }\n63: \n64: // ─────────────────────────────────────────────────────────────────────────────\n65: // 2. TESTS\n66: // ─────────────────────────────────────────────────────────────────────────────\n67: \n68: test('an approved advisor entry passes', (t) => {\n69:   const root = fixture(t);\n70:   const config = path.join(root, CONFIG_FILE);\n71:   writeFile(path.join(root, HOOKS_FILE), HOOKS_DOCUMENT);\n72:   writeFile(config, [\n73:     stateKey(root, 0, 0),\n74:     'trusted_hash = \"sha256:other\"',\n75:     stateKey(root, 1, 1),\n76:     'trusted_hash = \"sha256:advisor\"',\n77:     '',\n78:   ].join('\\n'));\n79: \n80:   const result = run(root, config);\n81:   assert.equal(result.status, 0, result.stderr);\n82:   assert.equal(result.stdout, 'PASS codex-hooks-approved\\n');\n83:   assert.doesNotMatch(result.stdout, /sha256/);\n84: });\n85: \n86: test('an entry with no approval warns and names the repair', (t) => {\n87:   const root = fixture(t);\n88:   const config = path.join(root, CONFIG_FILE);\n89:   writeFile(path.join(root, HOOKS_FILE), HOOKS_DOCUMENT);\n90: \n91:   // The advisor's key exists but holds no trusted_hash, and the one approval in\n92:   // the file belongs to another group.\n93:   writeFile(config, [\n94:     stateKey(root, 0, 0),\n95:     'trusted_hash = \"sha256:other\"',\n96:     stateKey(root, 1, 1),\n97:     'trusted = \"not a hash\"',\n98:     '',\n99:   ].join('\\n'));\n100: \n101:   const result = run(root, config);\n102:   assert.equal(result.status, 1, result.stderr);\n103:   assert.equal(result.stdout, [\n104:     `WARN codex-hooks-unapproved ${root}`,\n105:     `repair: open /hooks in a Codex session at ${root} and approve each entry`,\n106:     '',\n107:   ].join('\\n'));\n108:   assert.doesNotMatch(result.stdout, /sha256/);\n109: });\n110: \n111: test('a project without .codex is skipped', (t) => {\n112:   const root = fixture(t);\n113:   const result = run(root, path.join(root, CONFIG_FILE));\n114:   assert.equal(result.status, 0, result.stderr);\n115:   assert.equal(result.stdout, 'SKIP no-codex-hooks\\n');\n116: });\n117: \n118: // A flag standing where a value belongs leaves the option without a value. The run\n119: // must refuse the arguments rather than read a root the operator never named.\n120: test('a flag standing where a value belongs is refused', () => {\n121:   const result = spawnSync(process.execPath, [SCRIPT, '--root', '--json'], { encoding: 'utf8' });\n122:   assert.equal(result.status, 2, result.stderr);\n123:   assert.match(result.stderr, /Usage: codex-hook-approval-check\\.cjs/);\n124: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\"}"},"time":{"start":1794558827632,"end":1794558828061}}}}
