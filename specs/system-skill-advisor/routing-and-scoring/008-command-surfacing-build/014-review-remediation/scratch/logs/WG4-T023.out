ichelkerkmeester  staff    544 Nov 13 06:59 handlers\ndrwxr-xr-x@   4 michelkerkmeester  staff    128 Nov 12 10:24 helpers\ndrwxr-xr-x@  13 michelkerkmeester  staff    416 Nov 13 06:59 hooks\n-rw-r--r--@   1 michelkerkmeester  staff   2633 Nov 12 10:24 lane-attribution.test.ts\n-rw-r--r--@   1 michelkerkmeester  staff  24337 Nov 12 10:24 launcher-bootstrap.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   3325 Nov 12 10:24 launcher-idle-timeout.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   6974 Nov 12 10:24 launcher-install-guard.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff  18715 Nov 12 10:24 launcher-lease.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   7153 Nov 12 10:24 launcher-model-server-default.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff  10920 Nov 12 10:24 launcher-reap-pid-reuse.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   5036 Nov 12 10:24 launcher-stale-build-recycle.vitest.ts\ndrwxr-xr-x@  17 michelkerkmeester  staff    544 Nov 13 06:59 legacy\n-rw-r--r--@   1 michelkerkmeester  staff  22143 Nov 12 10:24 lifecycle-derived-metadata.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   2685 Nov 13 06:58 manual-testing-playbook.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   2417 Nov 12 10:24 metadata-sanitizer-entities-guard.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   4156 Nov 12 10:24 metrics-file-permissions.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   9784 Nov 12 10:24 migration-lineage-identity.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   6216 Nov 12 10:24 name-mention-scoring.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   5876 Nov 12 10:24 parent-skill-check-fixtures.vitest.ts\ndrwxr-xr-x@  12 michelkerkmeester  staff    384 Nov 13 06:58 parity\n-rw-r--r--@   1 michelkerkmeester  staff   7005 Nov 12 10:24 policy-observation-sink.vitest.ts\n-rw-r--r--@   1 michelkerkmeester  staff   9486 Nov 12 10:24 policy-plan-negative-controls.vitest.ts\n---\n.skilled/skills/system-s