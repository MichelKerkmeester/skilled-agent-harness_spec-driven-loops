oadSharedSession } from '../../../../../hooks/shared/session-readers/index.mjs';\n---\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:20://   node score-command-transcripts.mjs --summary <run-log> [<run-log>...] [--row-id <id>] [--json]\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:21://   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--row-id <id>] [--json]\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs:36:const SCRIPT_NAME = 'score-command-transcripts.mjs';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"^import|from '\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs | head -20; echo \\\"---\\\"; rg -n \\\"score-command-transcripts\\\" .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/*.mjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794559615052,"end":1794559616761}}}}
