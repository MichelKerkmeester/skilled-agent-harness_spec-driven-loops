doctor-skill-advisor-embedder.yaml\n M .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n M .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n M .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n?? .skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && git -c core.fsmonitor=false status --short -- specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/014-review-remediation/tasks.md && git -c core.fsmonitor=false status --short --untracked-files=all -- .skilled/commands/doctor/assets .skilled/commands/doctor/scripts/tests | head -20\"}"},"time":{"start":1794558918212,"end":1794558919033}}}}
