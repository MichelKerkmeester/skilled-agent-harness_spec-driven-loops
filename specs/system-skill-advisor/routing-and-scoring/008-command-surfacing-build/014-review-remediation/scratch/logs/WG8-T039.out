{"type":"step_start","timestamp":1794558788049,"sessionID":"ses_e2bf6571fffehC4jAi27gzqHQX","part":{"id":"prt_1d40a01d10016nZF2DusUV0T4f","sessionID":"ses_e2bf6571fffehC4jAi27gzqHQX","messageID":"msg_1d409fb01001Uz2dgAn78I95kz","type":"step-start","snapshot":"f3b81d373df9fc5a2f18f36a2da9b7b2fef90770"}}
{"type":"tool_use","timestamp":1794558790313,"sessionID":"ses_e2bf6571fffehC4jAi27gzqHQX","part":{"partID":"prt_1d40a08ed002tXic3qokBjNKa0","sessionID":"ses_e2bf6571fffehC4jAi27gzqHQX","messageID":"msg_1d409fb01001Uz2dgAn78I95kz","type":"tool","id":"call_00_KujzPVCvQm6f68Pr4Q6q8861","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml, lines 1-173\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: SKILL-ADVISOR EMBEDDER SETUP WORKFLOW (INTERACTIVE MUTATING MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator setting up local meaning matching for the skill advisor in interactive mode\n5: purpose: Find what is missing for local meaning matching, show every missing step with its cost and its undo, ask once, run only the approved steps and prove the semantic lane is on\n6: action: Probe Ollama, the model and the advisor -> print the plan with a cost and an undo per missing step -> approval -> start the server and pull the model -> skill graph scan -> probe again -> final result\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential_with_single_approval\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: one_before_first_step\n16:   dry_run: print_the_plan_then_status_ok\n17:   tracking: phase_by_phase\n18:   validation: rerun_the_probe_after_the_scan\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # EMBEDDER SETUP INVARIANT\n22: # ─────────────────────────────────────────────────────────────────\n23: embedder_setup_invariant: |\n24:   Meaning matching needs four things: Ollama installed, the server answering, the\n25:   nomic-embed-text:v1.5 model pulled and a skill graph scan that writes the command\n26:   vectors. This route never installs or upgrades Ollama. It prints the install\n27:   command for the operator to run, because a system package install is theirs to\n28:   make and the install guide owns its cost. It starts the server and pulls the\n29:   model only after the one approval, and only for a step the probe found missing.\n30:   The scan writes only skill-graph.sqlite, which is derived state. Nothing is\n31:   pulled, started or written before the approval, and a dry run stops after the\n32:   plan. A no stops with STATUS=CANCELLED and changes nothing.\n33: \n34: # ─────────────────────────────────────────────────────────────────\n35: # UPSTREAM ASSETS\n36: # ─────────────────────────────────────────────────────────────────\n37: upstream_assets:\n38:   contract: \"local command design contract\"\n39:   advisor_cli: \".skilled/bin/skill-advisor.cjs\"\n40:   advisor_status_command: \"node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only\"\n41:   scan_command: \"node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json\"\n42:   cost_script: \".skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs\"\n43:   sqlite_graph: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite\"\n44:   install_guide: \".skilled/skills/system-skill-advisor/INSTALL-GUIDE.md\"\n45:   install_overview: \"INSTALL-SKILLED.md\"\n46:   presentation: \".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\"\n47: \n48: # ─────────────────────────────────────────────────────────────────\n49: # INPUTS\n50: # ─────────────────────────────────────────────────────────────────\n51: inputs:\n52:   execution_mode: \"INTERACTIVE\"\n53:   dry_run: \"--dry-run prints the plan with each missing step's cost and undo, then stops with STATUS=OK before the approval. Nothing is pulled, started or written (default false).\"\n54: \n55: # ─────────────────────────────────────────────────────────────────\n56: # FIELD HANDLING\n57: # ─────────────────────────────────────────────────────────────────\n58: field_handling:\n59:   defaults:\n60:     dry_run: false\n61:   validation:\n62:     execution_mode_must_be: INTERACTIVE\n63: \n64: # ─────────────────────────────────────────────────────────────────\n65: # MUTATION BOUNDARIES\n66: # ─────────────────────────────────────────────────────────────────\n67: mutation_boundaries:\n68:   read_only: false\n69:   allowed_targets:\n70:     - \"the Ollama model store, one pulled copy of nomic-embed-text:v1.5 only\"\n71:     - \"a background ollama serve process, only when the probe found no server answering\"\n72:     - \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only\"\n73:   forbidden_targets:\n74:     - \"the Ollama install or upgrade itself, which this route prints and never runs\"\n75:     - \".skilled/skills/*/graph-metadata.json\"\n76:     - \".skilled/skills/*/SKILL.md\"\n77:     - \".skilled/skills/system-skill-advisor/runtime/lib/**\"\n78:     - \"any second model pull and any model removal\"\n79:   invariant: \"Only the steps the plan printed are run, and only after the approval. skill_graph_scan is the only writer inside the repository, and it writes derived state.\"\n80: \n81: # ─────────────────────────────────────────────────────────────────\n82: # WORKFLOW\n83: # ─────────────────────────────────────────────────────────────────\n84: workflow:\n85:   phase_1_probe:\n86:     purpose: \"Find what is missing without changing anything\"\n87:     activities:\n88:       - \"Run `command -v ollama` and record whether it printed a path. An empty result is the missing install step, not a failure of the route.\"\n89:       - \"Resolve the server URL from `OLLAMA_BASE_URL`, defaulting to `http://127.0.0.1:11434`. Run `curl -sS --max-time 5 <url>/api/version`. A failure is the missing start step, not a failure of the route.\"\n90:       - \"When the version answers, run `curl -sS --max-time 5 <url>/api/tags` and look for `nomic-embed-text:v1.5`. A missing tag is the missing pull step.\"\n91:       - \"Run `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only`. Exit 75 means no daemon is running, so record daemon=absent and the semantic health as unread. Never start a daemon to make this probe succeed.\"\n92:       - \"Read `semanticLaneHealth.laneEnabled`, `semanticLaneHealth.activeEmbedder` and `semanticLaneHealth.commandVectorCoverage` to decide whether the scan step is still missing. A null active embedder or an embedded count of zero is the missing scan step.\"\n93:       - \"Keep every probe result as it printed. Never upgrade an unread probe to a pass.\"\n94:     outputs:\n95:       - ollama_binary: \"present|missing\"\n96:       - server: \"answering|absent\"\n97:       - model: \"present|missing\"\n98:       - daemon: \"present|absent\"\n99:       - active_embedder: \"object|null|unread\"\n100:       - command_vector_coverage: \"object|unread\"\n101: \n102:   phase_2_plan:\n103:     purpose: \"Print one line per missing step with its cost and its undo, through the presentation contract\"\n104:     activities:\n105:       - \"Read .skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt for the probe dashboard, the plan table, the approval prompt, the dry-run result and the final result wording. Every visible line comes from there.\"\n106:       - \"Run `node .skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs` when `/api/version` answered, and keep its JSON. Exit 2 means the server stopped answering after the probe, so take the cost from the install guide and say the live measurement was unavailable.\"\n107:       - \"Render the presentation contract's probe dashboard with the binary, the server version, the model tag and the advisor's lane state.\"\n108:       - \"For each missing step, print one plan row through the presentation contract's plan table with columns step, cost and undo. Install Ollama is printed for the operator with the install guide's cost and the package manager's own uninstall as its undo. Start `ollama serve` in the background costs `.memory.serveRssKb` resident and undoes by stopping the pid this run started. Pull `nomic-embed-text:v1.5` costs `.model.sizeBytes` on disk and undoes with `ollama rm nomic-embed-text:v1.5`. `skill_graph_scan` costs the scan's own runtime plus `.warm.medianMs` per embedded prompt and needs no undo because the database is derived state and a rerun rewrites it.\"\n109:       - \"Never print a cost the measurement or the install guide did not produce. Never offer an undo the operator cannot run.\"\n110:       - \"When the probe found no missing step, render the presentation contract's final result as already set up, ask nothing, run nothing and stop with STATUS=OK.\"\n111: \n112:   phase_3_approval:\n113:     purpose: \"Ask once against the plan on screen, and run phase 4 only after its approve\"\n114:     activities:\n115:       - \"If dry_run is true, render the presentation contract's dry-run result from the plan's own rows and stop with STATUS=OK. A dry run asks nothing, pulls nothing, starts nothing and writes nothing.\"\n116:       - \"Ask the presentation contract's approval prompt once, naming the model pull, the background server start when it is listed and the database the scan writes.\"\n117:       - \"Approve is the only answer that proceeds. Anything else is a no: render the presentation contract's cancelled result, state that nothing was pulled, started or written, and stop with STATUS=CANCELLED ACTION=cancelled.\"\n118:       - \"Never default an answer, never carry an approval from another run and never accept an approval for a plan that has changed.\"\n119: \n120:   phase_4_approved_steps:\n121:     purpose: \"Run only the steps the approved plan listed, in dependency order\"\n122:     runs_when: \"phase_3_approval approved\"\n123:     activities:\n124:       - \"When the install step is missing, print the Ollama install command the install guide prints and stop with STATUS=FAIL, naming that command as the next step. Never install or upgrade Ollama from this route.\"\n125:       - \"When the start step is missing, run `ollama serve` in the background with a readable log, record the pid this run started and poll `/api/version` until it answers or a short deadline passes. A server that never answers is STATUS=FAIL naming the start and the log path, and the pull and scan steps do not run.\"\n126:       - \"When the pull step is missing, run `ollama pull nomic-embed-text:v1.5` only once the server answers. A non-zero exit is STATUS=FAIL naming the pull, and the scan step does not run.\"\n127:       - \"Never pull a model the plan did not list, never remove a model and never restart a server this run did not start.\"\n128: \n129:   phase_5_scan:\n130:     purpose: \"Write the command vectors the scan owns\"\n131:     runs_when: \"phase_4_approved_steps succeeded\"\n132:     activities:\n133:       - \"Run `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json`.\"\n134:       - \"A non-zero exit is STATUS=FAIL naming the scan and quoting its output. Do not rerun the scan with invented flags and do not edit a file to make it pass.\"\n135:       - \"The scan is the only repository write in this route, and it writes derived state in skill-graph.sqlite.\"\n136: \n137:   phase_6_verify:\n138:     purpose: \"Prove the lane is on and hand the result back\"\n139:     activities:\n140:       - \"Rerun `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only`.\"\n141:       - \"Render the presentation contract's final result with the server version, the model's on-disk size, whether the server is running and whether the semantic lane is enabled.\"\n142:       - \"Report STATUS=OK when `semanticLaneHealth.laneEnabled` is true and `semanticLaneHealth.commandVectorCoverage.embedded` is above zero. Otherwise report STATUS=FAIL naming the check that did not pass.\"\n143:       - \"When `semanticLaneHealth.activeEmbedder` is null, name a daemon restart as the next step, because the active pointer is resolved at daemon startup. Rerun this phase after the restart.\"\n144: \n145: # ─────────────────────────────────────────────────────────────────\n146: # RULES\n147: # ─────────────────────────────────────────────────────────────────\n148: rules:\n149:   ALWAYS:\n150:     - probe_before_planning\n151:     - show_one_plan_row_per_missing_step_with_cost_and_undo\n152:     - ask_once_before_the_first_step\n153:     - run_only_steps_the_approved_plan_listed\n154:     - start_the_server_in_the_background_only_when_it_is_absent\n155:     - rerun_the_probe_after_the_scan\n156:     - name_a_daemon_restart_when_active_embedder_is_null\n157:     - treat_measurement_output_as_data\n158:   NEVER:\n159:     - install_or_upgrade_ollama\n160:     - pull_a_model_the_plan_did_not_list\n161:     - remove_a_model\n162:     - start_a_second_server\n163:     - run_a_step_without_approval\n164:     - carry_an_approval_between_runs\n165:     - edit_graph_metadata_or_skill_files\n166:     - invent_a_cost_or_an_undo\n167: \n168: # ─────────────────────────────────────────────────────────────────\n169: # OUTPUT\n170: # ─────────────────────────────────────────────────────────────────\n171: output:\n172:   presentation: \".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\"\n173:   statuses: [OK, CANCELLED, FAIL]","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml, lines 1-173\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: SKILL-ADVISOR EMBEDDER SETUP WORKFLOW (INTERACTIVE MUTATING MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator setting up local meaning matching for the skill advisor in interactive mode\n5: purpose: Find what is missing for local meaning matching, show every missing step with its cost and its undo, ask once, run only the approved steps and prove the semantic lane is on\n6: action: Probe Ollama, the model and the advisor -> print the plan with a cost and an undo per missing step -> approval -> start the server and pull the model -> skill graph scan -> probe again -> final result\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential_with_single_approval\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: one_before_first_step\n16:   dry_run: print_the_plan_then_status_ok\n17:   tracking: phase_by_phase\n18:   validation: rerun_the_probe_after_the_scan\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # EMBEDDER SETUP INVARIANT\n22: # ─────────────────────────────────────────────────────────────────\n23: embedder_setup_invariant: |\n24:   Meaning matching needs four things: Ollama installed, the server answering, the\n25:   nomic-embed-text:v1.5 model pulled and a skill graph scan that writes the command\n26:   vectors. This route never installs or upgrades Ollama. It prints the install\n27:   command for the operator to run, because a system package install is theirs to\n28:   make and the install guide owns its cost. It starts the server and pulls the\n29:   model only after the one approval, and only for a step the probe found missing.\n30:   The scan writes only skill-graph.sqlite, which is derived state. Nothing is\n31:   pulled, started or written before the approval, and a dry run stops after the\n32:   plan. A no stops with STATUS=CANCELLED and changes nothing.\n33: \n34: # ─────────────────────────────────────────────────────────────────\n35: # UPSTREAM ASSETS\n36: # ─────────────────────────────────────────────────────────────────\n37: upstream_assets:\n38:   contract: \"local command design contract\"\n39:   advisor_cli: \".skilled/bin/skill-advisor.cjs\"\n40:   advisor_status_command: \"node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only\"\n41:   scan_command: \"node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json\"\n42:   cost_script: \".skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs\"\n43:   sqlite_graph: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite\"\n44:   install_guide: \".skilled/skills/system-skill-advisor/INSTALL-GUIDE.md\"\n45:   install_overview: \"INSTALL-SKILLED.md\"\n46:   presentation: \".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\"\n47: \n48: # ─────────────────────────────────────────────────────────────────\n49: # INPUTS\n50: # ─────────────────────────────────────────────────────────────────\n51: inputs:\n52:   execution_mode: \"INTERACTIVE\"\n53:   dry_run: \"--dry-run prints the plan with each missing step's cost and undo, then stops with STATUS=OK before the approval. Nothing is pulled, started or written (default false).\"\n54: \n55: # ─────────────────────────────────────────────────────────────────\n56: # FIELD HANDLING\n57: # ─────────────────────────────────────────────────────────────────\n58: field_handling:\n59:   defaults:\n60:     dry_run: false\n61:   validation:\n62:     execution_mode_must_be: INTERACTIVE\n63: \n64: # ─────────────────────────────────────────────────────────────────\n65: # MUTATION BOUNDARIES\n66: # ─────────────────────────────────────────────────────────────────\n67: mutation_boundaries:\n68:   read_only: false\n69:   allowed_targets:\n70:     - \"the Ollama model store, one pulled copy of nomic-embed-text:v1.5 only\"\n71:     - \"a background ollama serve process, only when the probe found no server answering\"\n72:     - \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only\"\n73:   forbidden_targets:\n74:     - \"the Ollama install or upgrade itself, which this route prints and never runs\"\n75:     - \".skilled/skills/*/graph-metadata.json\"\n76:     - \".skilled/skills/*/SKILL.md\"\n77:     - \".skilled/skills/system-skill-advisor/runtime/lib/**\"\n78:     - \"any second model pull and any model removal\"\n79:   invariant: \"Only the steps the plan printed are run, and only after the approval. skill_graph_scan is the only writer inside the repository, and it writes derived state.\"\n80: \n81: # ─────────────────────────────────────────────────────────────────\n82: # WORKFLOW\n83: # ─────────────────────────────────────────────────────────────────\n84: workflow:\n85:   phase_1_probe:\n86:     purpose: \"Find what is missing without changing anything\"\n87:     activities:\n88:       - \"Run `command -v ollama` and record whether it printed a path. An empty result is the missing install step, not a failure of the route.\"\n89:       - \"Resolve the server URL from `OLLAMA_BASE_URL`, defaulting to `http://127.0.0.1:11434`. Run `curl -sS --max-time 5 <url>/api/version`. A failure is the missing start step, not a failure of the route.\"\n90:       - \"When the version answers, run `curl -sS --max-time 5 <url>/api/tags` and look for `nomic-embed-text:v1.5`. A missing tag is the missing pull step.\"\n91:       - \"Run `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only`. Exit 75 means no daemon is running, so record daemon=absent and the semantic health as unread. Never start a daemon to make this probe succeed.\"\n92:       - \"Read `semanticLaneHealth.laneEnabled`, `semanticLaneHealth.activeEmbedder` and `semanticLaneHealth.commandVectorCoverage` to decide whether the scan step is still missing. A null active embedder or an embedded count of zero is the missing scan step.\"\n93:       - \"Keep every probe result as it printed. Never upgrade an unread probe to a pass.\"\n94:     outputs:\n95:       - ollama_binary: \"present|missing\"\n96:       - server: \"answering|absent\"\n97:       - model: \"present|missing\"\n98:       - daemon: \"present|absent\"\n99:       - active_embedder: \"object|null|unread\"\n100:       - command_vector_coverage: \"object|unread\"\n101: \n102:   phase_2_plan:\n103:     purpose: \"Print one line per missing step with its cost and its undo, through the presentation contract\"\n104:     activities:\n105:       - \"Read .skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt for the probe dashboard, the plan table, the approval prompt, the dry-run result and the final result wording. Every visible line comes from there.\"\n106:       - \"Run `node .skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs` when `/api/version` answered, and keep its JSON. Exit 2 means the server stopped answering after the probe, so take the cost from the install guide and say the live measurement was unavailable.\"\n107:       - \"Render the presentation contract's probe dashboard with the binary, the server version, the model tag and the advisor's lane state.\"\n108:       - \"For each missing step, print one plan row through the presentation contract's plan table with columns step, cost and undo. Install Ollama is printed for the operator with the install guide's cost and the package manager's own uninstall as its undo. Start `ollama serve` in the background costs `.memory.serveRssKb` resident and undoes by stopping the pid this run started. Pull `nomic-embed-text:v1.5` costs `.model.sizeBytes` on disk and undoes with `ollama rm nomic-embed-text:v1.5`. `skill_graph_scan` costs the scan's own runtime plus `.warm.medianMs` per embedded prompt and needs no undo because the database is derived state and a rerun rewrites it.\"\n109:       - \"Never print a cost the measurement or the install guide did not produce. Never offer an undo the operator cannot run.\"\n110:       - \"When the probe found no missing step, render the presentation contract's final result as already set up, ask nothing, run nothing and stop with STATUS=OK.\"\n111: \n112:   phase_3_approval:\n113:     purpose: \"Ask once against the plan on screen, and run phase 4 only after its approve\"\n114:     activities:\n115:       - \"If dry_run is true, render the presentation contract's dry-run result from the plan's own rows and stop with STATUS=OK. A dry run asks nothing, pulls nothing, starts nothing and writes nothing.\"\n116:       - \"Ask the presentation contract's approval prompt once, naming the model pull, the background server start when it is listed and the database the scan writes.\"\n117:       - \"Approve is the only answer that proceeds. Anything else is a no: render the presentation contract's cancelled result, state that nothing was pulled, started or written, and stop with STATUS=CANCELLED ACTION=cancelled.\"\n118:       - \"Never default an answer, never carry an approval from another run and never accept an approval for a plan that has changed.\"\n119: \n120:   phase_4_approved_steps:\n121:     purpose: \"Run only the steps the approved plan listed, in dependency order\"\n122:     runs_when: \"phase_3_approval approved\"\n123:     activities:\n124:       - \"When the install step is missing, print the Ollama install command the install guide prints and stop with STATUS=FAIL, naming that command as the next step. Never install or upgrade Ollama from this route.\"\n125:       - \"When the start step is missing, run `ollama serve` in the background with a readable log, record the pid this run started and poll `/api/version` until it answers or a short deadline passes. A server that never answers is STATUS=FAIL naming the start and the log path, and the pull and scan steps do not run.\"\n126:       - \"When the pull step is missing, run `ollama pull nomic-embed-text:v1.5` only once the server answers. A non-zero exit is STATUS=FAIL naming the pull, and the scan step does not run.\"\n127:       - \"Never pull a model the plan did not list, never remove a model and never restart a server this run did not start.\"\n128: \n129:   phase_5_scan:\n130:     purpose: \"Write the command vectors the scan owns\"\n131:     runs_when: \"phase_4_approved_steps succeeded\"\n132:     activities:\n133:       - \"Run `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json`.\"\n134:       - \"A non-zero exit is STATUS=FAIL naming the scan and quoting its output. Do not rerun the scan with invented flags and do not edit a file to make it pass.\"\n135:       - \"The scan is the only repository write in this route, and it writes derived state in skill-graph.sqlite.\"\n136: \n137:   phase_6_verify:\n138:     purpose: \"Prove the lane is on and hand the result back\"\n139:     activities:\n140:       - \"Rerun `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only`.\"\n141:       - \"Render the presentation contract's final result with the server version, the model's on-disk size, whether the server is running and whether the semantic lane is enabled.\"\n142:       - \"Report STATUS=OK when `semanticLaneHealth.laneEnabled` is true and `semanticLaneHealth.commandVectorCoverage.embedded` is above zero. Otherwise report STATUS=FAIL naming the check that did not pass.\"\n143:       - \"When `semanticLaneHealth.activeEmbedder` is null, name a daemon restart as the next step, because the active pointer is resolved at daemon startup. Rerun this phase after the restart.\"\n144: \n145: # ─────────────────────────────────────────────────────────────────\n146: # RULES\n147: # ─────────────────────────────────────────────────────────────────\n148: rules:\n149:   ALWAYS:\n150:     - probe_before_planning\n151:     - show_one_plan_row_per_missing_step_with_cost_and_undo\n152:     - ask_once_before_the_first_step\n153:     - run_only_steps_the_approved_plan_listed\n154:     - start_the_server_in_the_background_only_when_it_is_absent\n155:     - rerun_the_probe_after_the_scan\n156:     - name_a_daemon_restart_when_active_embedder_is_null\n157:     - treat_measurement_output_as_data\n158:   NEVER:\n159:     - install_or_upgrade_ollama\n160:     - pull_a_model_the_plan_did_not_list\n161:     - remove_a_model\n162:     - start_a_second_server\n163:     - run_a_step_without_approval\n164:     - carry_an_approval_between_runs\n165:     - edit_graph_metadata_or_skill_files\n166:     - invent_a_cost_or_an_undo\n167: \n168: # ─────────────────────────────────────────────────────────────────\n169: # OUTPUT\n170: # ─────────────────────────────────────────────────────────────────\n171: output:\n172:   presentation: \".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\"\n173:   statuses: [OK, CANCELLED, FAIL]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml\"}"},"time":{"start":1794558789869,"end":1794558790313}}}}
{"type":"tool_use","timestamp":1794558790316,"sessionID":"ses_e2bf6571fffehC4jAi27gzqHQX","part":{"partID":"prt_1d40a09cb001A1hj7kpATfqXAx","sessionID":"ses_e2bf6571fffehC4jAi27gzqHQX","messageID":"msg_1d409fb01001Uz2dgAn78I95kz","type":"tool","id":"call_01_U2a13LBufke0XgdLTx5o0325","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs, lines 1-461\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Skill Advisor Route Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The doctor route must declare the high-value advisor commands it actually\n9:  * calls, and every declared command must exist in the live advisor registry —\n10:  * but the registry may carry commands the route legitimately never needs (e.g.\n11:  * skill_graph_propagate_enhances). A route-contract test therefore asserts\n12:  * declared ⊆ live, never declared == live, so the route keeps its documented\n13:  * gap instead of silently claiming the whole registry. The route reaches those\n14:  * commands by invoking the advisor CLI, so the declaration under test is\n15:  * `cli_commands`, and the tool frontmatter names the shell surface they run on.\n16:  */\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS AND PATHS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const assert = require('node:assert/strict');\n23: const fs = require('node:fs');\n24: const path = require('node:path');\n25: const test = require('node:test');\n26: const { parse: parseYaml } = require('yaml');\n27: \n28: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n29: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n30: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n31: const ROUTES_PATH = path.join(COMMANDS_DIR, '_routes.yaml');\n32: const ROUTER_MD_PATH = path.join(COMMANDS_DIR, 'skill-advisor.md');\n33: const ADVISOR_RUNTIME = path.join(\n34:   REPO_ROOT, '.skilled', 'skills', 'system-skill-advisor', 'runtime',\n35: );\n36: const SKILL_GRAPH_TOOLS_PATH = path.join(ADVISOR_RUNTIME, 'tools', 'skill-graph-tools.ts');\n37: const ADVISOR_SCHEMAS_PATH = path.join(ADVISOR_RUNTIME, 'schemas', 'advisor-tool-schemas.ts');\n38: \n39: // The invocation every cli_commands entry is expected to name.\n40: const ADVISOR_CLI_RELATIVE_PATH = '.skilled/bin/skill-advisor.cjs';\n41: // The router grants the shell surface the advisor CLI commands run through.\n42: const REQUIRED_ROUTER_TOOL = 'Bash';\n43: // The advisor registry ships nine commands: five skill-graph tools and four\n44: // advisor tools. A change here is a registry change and should be deliberate.\n45: const LIVE_REGISTRY_SIZE = 9;\n46: \n47: // Commands doctor's skill-advisor route must declare — the researched\n48: // high-value subset, not the full nine-command registry.\n49: const REQUIRED_ADVISOR_COMMANDS = [\n50:   'advisor_recommend',\n51:   'advisor_status',\n52:   'advisor_validate',\n53:   'advisor_rebuild',\n54:   'skill_graph_scan',\n55:   'skill_graph_validate',\n56:   'skill_graph_query',\n57:   'skill_graph_status',\n58: ];\n59: \n60: // Flags a declared invocation cannot drop without changing what it does. The\n61: // advisor CLI refuses advisor_rebuild and skill_graph_scan without --trusted,\n62: // rejects advisor_validate without the heavy-run acknowledgement, and the\n63: // read-only probes rely on --warm-only to never start a daemon.\n64: const REQUIRED_COMMAND_FLAGS = {\n65:   advisor_recommend: ['--warm-only'],\n66:   advisor_status: ['--warm-only'],\n67:   advisor_validate: ['--confirm-heavy-run'],\n68:   advisor_rebuild: ['--trusted'],\n69:   skill_graph_scan: ['--trusted'],\n70:   skill_graph_validate: ['--warm-only'],\n71:   skill_graph_status: ['--warm-only'],\n72: };\n73: \n74: // /doctor:skill-advisor is a multi-target command, so every embedder lookup pins\n75: // the target as well as the command and can never resolve the tune or rebuild\n76: // route by accident.\n77: const EMBEDDER_TARGET = 'embedder';\n78: const EMBEDDER_ASSET = 'doctor-skill-advisor-embedder.yaml';\n79: const EMBEDDER_APPROVAL_PHASE = 'phase_3_approval';\n80: // The three steps the route may take only after the operator approves the plan.\n81: const EMBEDDER_APPROVED_COMMANDS = ['ollama pull', 'ollama serve', 'skill_graph_scan'];\n82: \n83: // ─────────────────────────────────────────────────────────────────────────────\n84: // 2. HELPERS\n85: // ─────────────────────────────────────────────────────────────────────────────\n86: \n87: function read(absolutePath) {\n88:   return fs.readFileSync(absolutePath, 'utf8');\n89: }\n90: \n91: // Skill-graph command names, read only from the tool definitions the exported\n92: // registry array lists. Scanning every `name: '...'` in the file would let an\n93: // unrelated object literal pad the live set and hide a missing command.\n94: function registeredSkillGraphNames(source) {\n95:   const registryRe = /skillGraphToolDefinitions\\s*:\\s*ToolDefinition\\[\\]\\s*=\\s*\\[([\\s\\S]*?)\\]/u;\n96:   const registry = registryRe.exec(source);\n97:   assert.ok(registry, 'skillGraphToolDefinitions array must be present in skill-graph-tools.ts');\n98:   const members = registry[1].split(',').map((member) => member.trim()).filter(Boolean);\n99:   return members.map((member) => {\n100:     const definitionRe = new RegExp(\n101:       `const\\\\s+${member}\\\\s*:\\\\s*ToolDefinition\\\\s*=\\\\s*\\\\{\\\\s*name:\\\\s*'([a-z_]+)'`,\n102:       'u',\n103:     );\n104:     const definition = definitionRe.exec(source);\n105:     assert.ok(\n106:       definition,\n107:       `registry member ${member} must be a ToolDefinition whose first field is name`,\n108:     );\n109:     return definition[1];\n110:   });\n111: }\n112: \n113: // Statically extracts registered advisor command names from the two TS source\n114: // files that define the live advisor registry, without spawning the advisor\n115: // daemon — keeps this test runnable when the advisor IPC socket is cold (a\n116: // reproducible state, where a live probe reports UNAVAILABLE (retryable)).\n117: function liveAdvisorCommandNames() {\n118:   const skillGraphNames = registeredSkillGraphNames(read(SKILL_GRAPH_TOOLS_PATH));\n119: \n120:   const schemasSource = read(ADVISOR_SCHEMAS_PATH);\n121:   const schemasBlockRe = /AdvisorToolInputSchemas\\s*=\\s*\\{([\\s\\S]*?)\\}\\s*as const/u;\n122:   const advisorToolSchemasBlock = schemasBlockRe.exec(schemasSource);\n123:   assert.ok(\n124:     advisorToolSchemasBlock,\n125:     'AdvisorToolInputSchemas block must be present in advisor-tool-schemas.ts',\n126:   );\n127:   const advisorNames = [...advisorToolSchemasBlock[1].matchAll(/^\\s*([a-z_]+):/gmu)]\n128:     .map((match) => match[1]);\n129: \n130:   return new Set([...skillGraphNames, ...advisorNames]);\n131: }\n132: \n133: // The advisor command named by one cli_commands entry: the first non-flag token\n134: // after the CLI shim path.\n135: function cliCommandName(entry) {\n136:   const tokens = String(entry).split(/\\s+/u).filter(Boolean);\n137:   const shimIndex = tokens.indexOf(ADVISOR_CLI_RELATIVE_PATH);\n138:   assert.notStrictEqual(\n139:     shimIndex,\n140:     -1,\n141:     `skill-advisor route cli_commands entry must invoke ${ADVISOR_CLI_RELATIVE_PATH}: ${entry}`,\n142:   );\n143:   const command = tokens.slice(shimIndex + 1).find((token) => !token.startsWith('-'));\n144:   assert.ok(\n145:     command,\n146:     `skill-advisor route cli_commands entry must name an advisor command: ${entry}`,\n147:   );\n148:   return command;\n149: }\n150: \n151: function skillAdvisorRoute(target) {\n152:   const routes = parseYaml(read(ROUTES_PATH));\n153:   return routes.routes.find(\n154:     (entry) => entry.command === '/doctor:skill-advisor' && entry.target === target,\n155:   );\n156: }\n157: \n158: function skillAdvisorRouteCliCommands() {\n159:   const route = skillAdvisorRoute('tune');\n160:   assert.ok(route, '_routes.yaml must declare the /doctor:skill-advisor tune route');\n161:   assert.ok(\n162:     Array.isArray(route.cli_commands),\n163:     'skill-advisor route must declare cli_commands as an array',\n164:   );\n165:   assert.ok(\n166:     route.cli_commands.length > 0,\n167:     'skill-advisor route must declare at least one advisor CLI command',\n168:   );\n169:   return route.cli_commands;\n170: }\n171: \n172: function declaredAdvisorCommands() {\n173:   return skillAdvisorRouteCliCommands().map(cliCommandName);\n174: }\n175: \n176: function filesIn(dir, extension) {\n177:   return fs.readdirSync(dir, { withFileTypes: true })\n178:     .filter((entry) => entry.isFile() && entry.name.endsWith(extension))\n179:     .map((entry) => path.join(dir, entry.name));\n180: }\n181: \n182: // The tools a command grants, from its YAML frontmatter, whether written as a\n183: // comma-separated string or as a YAML list.\n184: function allowedTools(markdown) {\n185:   const block = /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/u.exec(markdown);\n186:   assert.ok(block, 'command doc must open with a frontmatter block');\n187:   const value = parseYaml(block[1])['allowed-tools'];\n188:   if (Array.isArray(value)) return value.map((tool) => String(tool).trim());\n189:   if (typeof value === 'string') return value.split(',').map((tool) => tool.trim()).filter(Boolean);\n190:   return [];\n191: }\n192: \n193: function embedderRoute() {\n194:   const route = skillAdvisorRoute(EMBEDDER_TARGET);\n195:   assert.ok(\n196:     route,\n197:     `_routes.yaml must declare the /doctor:skill-advisor ${EMBEDDER_TARGET} route`,\n198:   );\n199:   return route;\n200: }\n201: \n202: function embedderWorkflow() {\n203:   const route = embedderRoute();\n204:   const workflowPath = path.join(ASSETS_DIR, route.yaml);\n205:   assert.ok(fs.existsSync(workflowPath), `${route.yaml} must exist`);\n206:   return parseYaml(read(workflowPath));\n207: }\n208: \n209: // Every string a phase carries, so a command is found whether the workflow\n210: // states it in the purpose, an activity or an output.\n211: function yamlStrings(node, out = []) {\n212:   if (Array.isArray(node)) {\n213:     for (const value of node) yamlStrings(value, out);\n214:   } else if (node && typeof node === 'object') {\n215:     for (const [key, value] of Object.entries(node)) {\n216:       out.push(key);\n217:       yamlStrings(value, out);\n218:     }\n219:   } else if (typeof node === 'string') {\n220:     out.push(node);\n221:   }\n222:   return out;\n223: }\n224: \n225: function phaseText(workflow, phase) {\n226:   return yamlStrings(workflow.workflow[phase]).join('\\n');\n227: }\n228: \n229: // ─────────────────────────────────────────────────────────────────────────────\n230: // 3. TESTS\n231: // ─────────────────────────────────────────────────────────────────────────────\n232: \n233: test('every advisor command declared on the skill-advisor route exists in the live registry (subset, not equality)', () => {\n234:   const liveNames = liveAdvisorCommandNames();\n235:   assert.equal(\n236:     liveNames.size,\n237:     LIVE_REGISTRY_SIZE,\n238:     `expected ${LIVE_REGISTRY_SIZE} live advisor commands, found ${liveNames.size}: `\n239:       + [...liveNames].join(', '),\n240:   );\n241: \n242:   for (const command of declaredAdvisorCommands()) {\n243:     assert.ok(\n244:       liveNames.has(command),\n245:       `\"${command}\" is declared on the skill-advisor route but is not in the live advisor registry`,\n246:     );\n247:   }\n248: });\n249: \n250: test('the registry reader ignores name fields outside the exported tool list', () => {\n251:   const source = [\n252:     \"export const aTool: ToolDefinition = {\\n  name: 'skill_graph_a',\\n};\",\n253:     \"const unrelated = { name: 'not_a_command' };\",\n254:     'export const skillGraphToolDefinitions: ToolDefinition[] = [\\n  aTool,\\n];',\n255:   ].join('\\n');\n256:   assert.deepEqual(registeredSkillGraphNames(source), ['skill_graph_a']);\n257: });\n258: \n259: test('the researched high-value command subset is declared on the skill-advisor route, including skill_graph_validate', () => {\n260:   const declaredCommands = new Set(declaredAdvisorCommands());\n261: \n262:   for (const requiredCommand of REQUIRED_ADVISOR_COMMANDS) {\n263:     assert.ok(\n264:       declaredCommands.has(requiredCommand),\n265:       `skill-advisor route cli_commands must declare ${requiredCommand}`,\n266:     );\n267:   }\n268: });\n269: \n270: test('each declared invocation keeps the flags its command needs', () => {\n271:   for (const entry of skillAdvisorRouteCliCommands()) {\n272:     const command = cliCommandName(entry);\n273:     const tokens = String(entry).split(/\\s+/u);\n274:     for (const flag of REQUIRED_COMMAND_FLAGS[command] || []) {\n275:       assert.ok(\n276:         tokens.includes(flag),\n277:         `skill-advisor route invocation of ${command} must pass ${flag}: ${entry}`,\n278:       );\n279:     }\n280:   }\n281: });\n282: \n283: test('the doctor command docs and workflow assets reach the advisor through the CLI and name no advisor MCP tool id', () => {\n284:   const docs = [...filesIn(COMMANDS_DIR, '.md'), ...filesIn(ASSETS_DIR, '.yaml')];\n285:   assert.ok(docs.some((doc) => doc.endsWith('.md')), 'doctor command docs must exist');\n286:   assert.ok(docs.some((doc) => doc.endsWith('.yaml')), 'doctor workflow assets must exist');\n287: \n288:   for (const docPath of docs) {\n289:     assert.ok(\n290:       !read(docPath).includes('mcp__system_skill_advisor__'),\n291:       `${path.relative(REPO_ROOT, docPath)} must not name an advisor MCP tool id`,\n292:     );\n293:   }\n294: \n295:   assert.ok(\n296:     allowedTools(read(ROUTER_MD_PATH)).includes(REQUIRED_ROUTER_TOOL),\n297:     `doctor/skill-advisor.md allowed-tools must include ${REQUIRED_ROUTER_TOOL}, `\n298:       + 'the surface its advisor CLI commands run through',\n299:   );\n300: });\n301: \n302: test('the allowed-tools reader finds the first listed tool and the YAML list form', () => {\n303:   assert.deepEqual(allowedTools('---\\nallowed-tools: Bash, Read\\n---\\n'), ['Bash', 'Read']);\n304:   assert.deepEqual(allowedTools('---\\nallowed-tools: [Read, Bash]\\n---\\n'), ['Read', 'Bash']);\n305: });\n306: \n307: test('the route does not silently claim full-registry equality — this stays a documented subset', () => {\n308:   const liveNames = liveAdvisorCommandNames();\n309:   const declaredCommands = new Set(declaredAdvisorCommands());\n310: \n311:   // A live-only command such as skill_graph_propagate_enhances is legal to omit;\n312:   // this test fails only if the declared set and live set were EXACTLY\n313:   // equal-by-construction with no documented gap, which would silently\n314:   // reintroduce the ruled-out full-equality assumption. Assert the live\n315:   // registry legitimately contains at least one command the route does not\n316:   // require today.\n317:   const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n318:   assert.ok(\n319:     undeclaredLiveCommands.length > 0,\n320:     'expected the live registry to contain at least one command the doctor route '\n321:       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n322:   );\n323: });\n324: \n325: // ─────────────────────────────────────────────────────────────────────────────\n326: // 4. THE EMBEDDER SETUP ROUTE\n327: // ─────────────────────────────────────────────────────────────────────────────\n328: \n329: test('the embedder setup route is in the manifest with its own workflow asset and dry run', () => {\n330:   const routes = parseYaml(read(ROUTES_PATH)).routes.filter(\n331:     (entry) => entry.command === '/doctor:skill-advisor' && entry.target === EMBEDDER_TARGET,\n332:   );\n333:   assert.equal(routes.length, 1, '/doctor:skill-advisor must own exactly one embedder route');\n334: \n335:   const route = routes[0];\n336:   assert.equal(route.yaml, EMBEDDER_ASSET);\n337:   assert.ok(fs.existsSync(path.join(ASSETS_DIR, route.yaml)), route.yaml);\n338:   assert.deepEqual(route.setup_vars, ['execution_mode', 'dry_run']);\n339:   assert.deepEqual(route.allowed_flags, ['--dry-run']);\n340:   assert.equal(route.mutating, 'mutates');\n341:   assert.equal(route.default_target, undefined);\n342:   assert.deepEqual(route.mcp_tools, []);\n343:   assert.match(route.gate3_location, /skill-graph\\.sqlite/u);\n344:   assert.match(route.gate3_location, /Ollama model store/u);\n345: \n346:   assert.ok(Array.isArray(route.cli_commands));\n347:   assert.ok(\n348:     route.cli_commands.some((entry) => entry.includes('advisor_status')\n349:       && entry.includes('--include-semantic-health true')\n350:       && entry.includes('--warm-only')),\n351:     'the embedder route must probe the semantic lane without starting a daemon',\n352:   );\n353:   assert.ok(\n354:     route.cli_commands.some((entry) => entry.includes('skill_graph_scan')\n355:       && entry.includes('--trusted')),\n356:     'the embedder route must declare the scan and its --trusted flag',\n357:   );\n358: \n359:   assert.ok(route.trigger_phrases.length >= 3, 'the embedder route needs at least three phrases');\n360:   for (const phrase of route.trigger_phrases) {\n361:     assert.ok(\n362:       String(phrase).trim().split(/\\s+/u).length >= 3,\n363:       `an embedder trigger phrase must name three or more words: ${phrase}`,\n364:     );\n365:   }\n366: });\n367: \n368: test('the embedder workflow stops at one approval before any pull, server start or scan', () => {\n369:   const workflow = embedderWorkflow();\n370:   const phases = Object.keys(workflow.workflow);\n371:   assert.deepEqual(phases, [\n372:     'phase_1_probe',\n373:     'phase_2_plan',\n374:     'phase_3_approval',\n375:     'phase_4_approved_steps',\n376:     'phase_5_scan',\n377:     'phase_6_verify',\n378:   ]);\n379:   assert.equal(workflow.operating_mode.approvals, 'one_before_first_step');\n380: \n381:   const approvalIndex = phases.indexOf(EMBEDDER_APPROVAL_PHASE);\n382:   const approvedPhases = [];\n383:   for (const [name, phase] of Object.entries(workflow.workflow)) {\n384:     if (!phase.runs_when) continue;\n385:     approvedPhases.push(name);\n386:     assert.ok(\n387:       phases.indexOf(name) > approvalIndex,\n388:       `${name} declares runs_when before ${EMBEDDER_APPROVAL_PHASE}`,\n389:     );\n390:   }\n391:   assert.ok(approvedPhases.length > 0, 'the embedder workflow must declare its gated phases');\n392:   assert.match(\n393:     workflow.workflow[approvedPhases[0]].runs_when,\n394:     new RegExp(`${EMBEDDER_APPROVAL_PHASE} approved`, 'u'),\n395:   );\n396: \n397:   // Each step that changes the machine lives in a phase gated behind the\n398:   // approval, so the plan can be read and refused before any of them runs.\n399:   const gatedText = approvedPhases.map((name) => phaseText(workflow, name)).join('\\n');\n400:   for (const command of EMBEDDER_APPROVED_COMMANDS) {\n401:     assert.ok(\n402:       gatedText.includes(command),\n403:       `${command} must run only in a phase gated after ${EMBEDDER_APPROVAL_PHASE}`,\n404:     );\n405:   }\n406: \n407:   const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n408:   assert.match(approval, /Approve is the only answer that proceeds/u);\n409:   assert.match(approval, /STATUS=CANCELLED/u);\n410: });\n411: \n412: test('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\n413:   const workflow = embedderWorkflow();\n414:   assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\n415:   assert.match(workflow.inputs.dry_run, /STATUS=OK/u);\n416:   assert.match(workflow.inputs.dry_run, /before the approval/u);\n417: \n418:   const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n419:   assert.match(approval, /If dry_run is true/u);\n420:   assert.match(approval, /STATUS=OK/u);\n421:   assert.match(approval, /pulls nothing, starts nothing and writes nothing/u);\n422: \n423:   const phases = Object.keys(workflow.workflow);\n424:   assert.ok(\n425:     phases.indexOf(EMBEDDER_APPROVAL_PHASE) < phases.indexOf('phase_4_approved_steps'),\n426:     'the dry-run decision must sit before the first gated phase',\n427:   );\n428: });\n429: \n430: test('no embedder step installs Ollama, which the route only prints for the operator', () => {\n431:   const workflow = embedderWorkflow();\n432:   assert.ok(\n433:     workflow.rules.NEVER.includes('install_or_upgrade_ollama'),\n434:     'the embedder workflow must forbid installing or upgrading Ollama',\n435:   );\n436:   assert.match(\n437:     workflow.mutation_boundaries.forbidden_targets.join('\\n'),\n438:     /the Ollama install or upgrade itself, which this route prints and never runs/u,\n439:   );\n440:   assert.match(\n441:     phaseText(workflow, 'phase_4_approved_steps'),\n442:     /Never install or upgrade Ollama from this route/u,\n443:   );\n444: \n445:   const activities = Object.values(workflow.workflow)\n446:     .flatMap((phase) => (Array.isArray(phase.activities) ? phase.activities : []))\n447:     .map(String);\n448:   for (const activity of activities) {\n449:     if (!/install/iu.test(activity) || !/ollama/iu.test(activity)) continue;\n450:     assert.match(\n451:       activity,\n452:       /\\bprint/iu,\n453:       `an Ollama install mention must be a print step: ${activity}`,\n454:     );\n455:     assert.doesNotMatch(\n456:       activity,\n457:       /\\b(?:run|execute)\\b[^.]*\\binstall|install[^.]*\\b(?:run|execute)\\b|\\bbrew install\\b|\\bcurl\\b[^\\n]*\\|\\s*(?:ba)?sh\\b/iu,\n458:       `no step may run an Ollama install: ${activity}`,\n459:     );\n460:   }\n461: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs, lines 1-461\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Skill Advisor Route Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The doctor route must declare the high-value advisor commands it actually\n9:  * calls, and every declared command must exist in the live advisor registry —\n10:  * but the registry may carry commands the route legitimately never needs (e.g.\n11:  * skill_graph_propagate_enhances). A route-contract test therefore asserts\n12:  * declared ⊆ live, never declared == live, so the route keeps its documented\n13:  * gap instead of silently claiming the whole registry. The route reaches those\n14:  * commands by invoking the advisor CLI, so the declaration under test is\n15:  * `cli_commands`, and the tool frontmatter names the shell surface they run on.\n16:  */\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS AND PATHS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const assert = require('node:assert/strict');\n23: const fs = require('node:fs');\n24: const path = require('node:path');\n25: const test = require('node:test');\n26: const { parse: parseYaml } = require('yaml');\n27: \n28: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n29: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n30: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n31: const ROUTES_PATH = path.join(COMMANDS_DIR, '_routes.yaml');\n32: const ROUTER_MD_PATH = path.join(COMMANDS_DIR, 'skill-advisor.md');\n33: const ADVISOR_RUNTIME = path.join(\n34:   REPO_ROOT, '.skilled', 'skills', 'system-skill-advisor', 'runtime',\n35: );\n36: const SKILL_GRAPH_TOOLS_PATH = path.join(ADVISOR_RUNTIME, 'tools', 'skill-graph-tools.ts');\n37: const ADVISOR_SCHEMAS_PATH = path.join(ADVISOR_RUNTIME, 'schemas', 'advisor-tool-schemas.ts');\n38: \n39: // The invocation every cli_commands entry is expected to name.\n40: const ADVISOR_CLI_RELATIVE_PATH = '.skilled/bin/skill-advisor.cjs';\n41: // The router grants the shell surface the advisor CLI commands run through.\n42: const REQUIRED_ROUTER_TOOL = 'Bash';\n43: // The advisor registry ships nine commands: five skill-graph tools and four\n44: // advisor tools. A change here is a registry change and should be deliberate.\n45: const LIVE_REGISTRY_SIZE = 9;\n46: \n47: // Commands doctor's skill-advisor route must declare — the researched\n48: // high-value subset, not the full nine-command registry.\n49: const REQUIRED_ADVISOR_COMMANDS = [\n50:   'advisor_recommend',\n51:   'advisor_status',\n52:   'advisor_validate',\n53:   'advisor_rebuild',\n54:   'skill_graph_scan',\n55:   'skill_graph_validate',\n56:   'skill_graph_query',\n57:   'skill_graph_status',\n58: ];\n59: \n60: // Flags a declared invocation cannot drop without changing what it does. The\n61: // advisor CLI refuses advisor_rebuild and skill_graph_scan without --trusted,\n62: // rejects advisor_validate without the heavy-run acknowledgement, and the\n63: // read-only probes rely on --warm-only to never start a daemon.\n64: const REQUIRED_COMMAND_FLAGS = {\n65:   advisor_recommend: ['--warm-only'],\n66:   advisor_status: ['--warm-only'],\n67:   advisor_validate: ['--confirm-heavy-run'],\n68:   advisor_rebuild: ['--trusted'],\n69:   skill_graph_scan: ['--trusted'],\n70:   skill_graph_validate: ['--warm-only'],\n71:   skill_graph_status: ['--warm-only'],\n72: };\n73: \n74: // /doctor:skill-advisor is a multi-target command, so every embedder lookup pins\n75: // the target as well as the command and can never resolve the tune or rebuild\n76: // route by accident.\n77: const EMBEDDER_TARGET = 'embedder';\n78: const EMBEDDER_ASSET = 'doctor-skill-advisor-embedder.yaml';\n79: const EMBEDDER_APPROVAL_PHASE = 'phase_3_approval';\n80: // The three steps the route may take only after the operator approves the plan.\n81: const EMBEDDER_APPROVED_COMMANDS = ['ollama pull', 'ollama serve', 'skill_graph_scan'];\n82: \n83: // ─────────────────────────────────────────────────────────────────────────────\n84: // 2. HELPERS\n85: // ─────────────────────────────────────────────────────────────────────────────\n86: \n87: function read(absolutePath) {\n88:   return fs.readFileSync(absolutePath, 'utf8');\n89: }\n90: \n91: // Skill-graph command names, read only from the tool definitions the exported\n92: // registry array lists. Scanning every `name: '...'` in the file would let an\n93: // unrelated object literal pad the live set and hide a missing command.\n94: function registeredSkillGraphNames(source) {\n95:   const registryRe = /skillGraphToolDefinitions\\s*:\\s*ToolDefinition\\[\\]\\s*=\\s*\\[([\\s\\S]*?)\\]/u;\n96:   const registry = registryRe.exec(source);\n97:   assert.ok(registry, 'skillGraphToolDefinitions array must be present in skill-graph-tools.ts');\n98:   const members = registry[1].split(',').map((member) => member.trim()).filter(Boolean);\n99:   return members.map((member) => {\n100:     const definitionRe = new RegExp(\n101:       `const\\\\s+${member}\\\\s*:\\\\s*ToolDefinition\\\\s*=\\\\s*\\\\{\\\\s*name:\\\\s*'([a-z_]+)'`,\n102:       'u',\n103:     );\n104:     const definition = definitionRe.exec(source);\n105:     assert.ok(\n106:       definition,\n107:       `registry member ${member} must be a ToolDefinition whose first field is name`,\n108:     );\n109:     return definition[1];\n110:   });\n111: }\n112: \n113: // Statically extracts registered advisor command names from the two TS source\n114: // files that define the live advisor registry, without spawning the advisor\n115: // daemon — keeps this test runnable when the advisor IPC socket is cold (a\n116: // reproducible state, where a live probe reports UNAVAILABLE (retryable)).\n117: function liveAdvisorCommandNames() {\n118:   const skillGraphNames = registeredSkillGraphNames(read(SKILL_GRAPH_TOOLS_PATH));\n119: \n120:   const schemasSource = read(ADVISOR_SCHEMAS_PATH);\n121:   const schemasBlockRe = /AdvisorToolInputSchemas\\s*=\\s*\\{([\\s\\S]*?)\\}\\s*as const/u;\n122:   const advisorToolSchemasBlock = schemasBlockRe.exec(schemasSource);\n123:   assert.ok(\n124:     advisorToolSchemasBlock,\n125:     'AdvisorToolInputSchemas block must be present in advisor-tool-schemas.ts',\n126:   );\n127:   const advisorNames = [...advisorToolSchemasBlock[1].matchAll(/^\\s*([a-z_]+):/gmu)]\n128:     .map((match) => match[1]);\n129: \n130:   return new Set([...skillGraphNames, ...advisorNames]);\n131: }\n132: \n133: // The advisor command named by one cli_commands entry: the first non-flag token\n134: // after the CLI shim path.\n135: function cliCommandName(entry) {\n136:   const tokens = String(entry).split(/\\s+/u).filter(Boolean);\n137:   const shimIndex = tokens.indexOf(ADVISOR_CLI_RELATIVE_PATH);\n138:   assert.notStrictEqual(\n139:     shimIndex,\n140:     -1,\n141:     `skill-advisor route cli_commands entry must invoke ${ADVISOR_CLI_RELATIVE_PATH}: ${entry}`,\n142:   );\n143:   const command = tokens.slice(shimIndex + 1).find((token) => !token.startsWith('-'));\n144:   assert.ok(\n145:     command,\n146:     `skill-advisor route cli_commands entry must name an advisor command: ${entry}`,\n147:   );\n148:   return command;\n149: }\n150: \n151: function skillAdvisorRoute(target) {\n152:   const routes = parseYaml(read(ROUTES_PATH));\n153:   return routes.routes.find(\n154:     (entry) => entry.command === '/doctor:skill-advisor' && entry.target === target,\n155:   );\n156: }\n157: \n158: function skillAdvisorRouteCliCommands() {\n159:   const route = skillAdvisorRoute('tune');\n160:   assert.ok(route, '_routes.yaml must declare the /doctor:skill-advisor tune route');\n161:   assert.ok(\n162:     Array.isArray(route.cli_commands),\n163:     'skill-advisor route must declare cli_commands as an array',\n164:   );\n165:   assert.ok(\n166:     route.cli_commands.length > 0,\n167:     'skill-advisor route must declare at least one advisor CLI command',\n168:   );\n169:   return route.cli_commands;\n170: }\n171: \n172: function declaredAdvisorCommands() {\n173:   return skillAdvisorRouteCliCommands().map(cliCommandName);\n174: }\n175: \n176: function filesIn(dir, extension) {\n177:   return fs.readdirSync(dir, { withFileTypes: true })\n178:     .filter((entry) => entry.isFile() && entry.name.endsWith(extension))\n179:     .map((entry) => path.join(dir, entry.name));\n180: }\n181: \n182: // The tools a command grants, from its YAML frontmatter, whether written as a\n183: // comma-separated string or as a YAML list.\n184: function allowedTools(markdown) {\n185:   const block = /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/u.exec(markdown);\n186:   assert.ok(block, 'command doc must open with a frontmatter block');\n187:   const value = parseYaml(block[1])['allowed-tools'];\n188:   if (Array.isArray(value)) return value.map((tool) => String(tool).trim());\n189:   if (typeof value === 'string') return value.split(',').map((tool) => tool.trim()).filter(Boolean);\n190:   return [];\n191: }\n192: \n193: function embedderRoute() {\n194:   const route = skillAdvisorRoute(EMBEDDER_TARGET);\n195:   assert.ok(\n196:     route,\n197:     `_routes.yaml must declare the /doctor:skill-advisor ${EMBEDDER_TARGET} route`,\n198:   );\n199:   return route;\n200: }\n201: \n202: function embedderWorkflow() {\n203:   const route = embedderRoute();\n204:   const workflowPath = path.join(ASSETS_DIR, route.yaml);\n205:   assert.ok(fs.existsSync(workflowPath), `${route.yaml} must exist`);\n206:   return parseYaml(read(workflowPath));\n207: }\n208: \n209: // Every string a phase carries, so a command is found whether the workflow\n210: // states it in the purpose, an activity or an output.\n211: function yamlStrings(node, out = []) {\n212:   if (Array.isArray(node)) {\n213:     for (const value of node) yamlStrings(value, out);\n214:   } else if (node && typeof node === 'object') {\n215:     for (const [key, value] of Object.entries(node)) {\n216:       out.push(key);\n217:       yamlStrings(value, out);\n218:     }\n219:   } else if (typeof node === 'string') {\n220:     out.push(node);\n221:   }\n222:   return out;\n223: }\n224: \n225: function phaseText(workflow, phase) {\n226:   return yamlStrings(workflow.workflow[phase]).join('\\n');\n227: }\n228: \n229: // ─────────────────────────────────────────────────────────────────────────────\n230: // 3. TESTS\n231: // ─────────────────────────────────────────────────────────────────────────────\n232: \n233: test('every advisor command declared on the skill-advisor route exists in the live registry (subset, not equality)', () => {\n234:   const liveNames = liveAdvisorCommandNames();\n235:   assert.equal(\n236:     liveNames.size,\n237:     LIVE_REGISTRY_SIZE,\n238:     `expected ${LIVE_REGISTRY_SIZE} live advisor commands, found ${liveNames.size}: `\n239:       + [...liveNames].join(', '),\n240:   );\n241: \n242:   for (const command of declaredAdvisorCommands()) {\n243:     assert.ok(\n244:       liveNames.has(command),\n245:       `\"${command}\" is declared on the skill-advisor route but is not in the live advisor registry`,\n246:     );\n247:   }\n248: });\n249: \n250: test('the registry reader ignores name fields outside the exported tool list', () => {\n251:   const source = [\n252:     \"export const aTool: ToolDefinition = {\\n  name: 'skill_graph_a',\\n};\",\n253:     \"const unrelated = { name: 'not_a_command' };\",\n254:     'export const skillGraphToolDefinitions: ToolDefinition[] = [\\n  aTool,\\n];',\n255:   ].join('\\n');\n256:   assert.deepEqual(registeredSkillGraphNames(source), ['skill_graph_a']);\n257: });\n258: \n259: test('the researched high-value command subset is declared on the skill-advisor route, including skill_graph_validate', () => {\n260:   const declaredCommands = new Set(declaredAdvisorCommands());\n261: \n262:   for (const requiredCommand of REQUIRED_ADVISOR_COMMANDS) {\n263:     assert.ok(\n264:       declaredCommands.has(requiredCommand),\n265:       `skill-advisor route cli_commands must declare ${requiredCommand}`,\n266:     );\n267:   }\n268: });\n269: \n270: test('each declared invocation keeps the flags its command needs', () => {\n271:   for (const entry of skillAdvisorRouteCliCommands()) {\n272:     const command = cliCommandName(entry);\n273:     const tokens = String(entry).split(/\\s+/u);\n274:     for (const flag of REQUIRED_COMMAND_FLAGS[command] || []) {\n275:       assert.ok(\n276:         tokens.includes(flag),\n277:         `skill-advisor route invocation of ${command} must pass ${flag}: ${entry}`,\n278:       );\n279:     }\n280:   }\n281: });\n282: \n283: test('the doctor command docs and workflow assets reach the advisor through the CLI and name no advisor MCP tool id', () => {\n284:   const docs = [...filesIn(COMMANDS_DIR, '.md'), ...filesIn(ASSETS_DIR, '.yaml')];\n285:   assert.ok(docs.some((doc) => doc.endsWith('.md')), 'doctor command docs must exist');\n286:   assert.ok(docs.some((doc) => doc.endsWith('.yaml')), 'doctor workflow assets must exist');\n287: \n288:   for (const docPath of docs) {\n289:     assert.ok(\n290:       !read(docPath).includes('mcp__system_skill_advisor__'),\n291:       `${path.relative(REPO_ROOT, docPath)} must not name an advisor MCP tool id`,\n292:     );\n293:   }\n294: \n295:   assert.ok(\n296:     allowedTools(read(ROUTER_MD_PATH)).includes(REQUIRED_ROUTER_TOOL),\n297:     `doctor/skill-advisor.md allowed-tools must include ${REQUIRED_ROUTER_TOOL}, `\n298:       + 'the surface its advisor CLI commands run through',\n299:   );\n300: });\n301: \n302: test('the allowed-tools reader finds the first listed tool and the YAML list form', () => {\n303:   assert.deepEqual(allowedTools('---\\nallowed-tools: Bash, Read\\n---\\n'), ['Bash', 'Read']);\n304:   assert.deepEqual(allowedTools('---\\nallowed-tools: [Read, Bash]\\n---\\n'), ['Read', 'Bash']);\n305: });\n306: \n307: test('the route does not silently claim full-registry equality — this stays a documented subset', () => {\n308:   const liveNames = liveAdvisorCommandNames();\n309:   const declaredCommands = new Set(declaredAdvisorCommands());\n310: \n311:   // A live-only command such as skill_graph_propagate_enhances is legal to omit;\n312:   // this test fails only if the declared set and live set were EXACTLY\n313:   // equal-by-construction with no documented gap, which would silently\n314:   // reintroduce the ruled-out full-equality assumption. Assert the live\n315:   // registry legitimately contains at least one command the route does not\n316:   // require today.\n317:   const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n318:   assert.ok(\n319:     undeclaredLiveCommands.length > 0,\n320:     'expected the live registry to contain at least one command the doctor route '\n321:       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n322:   );\n323: });\n324: \n325: // ─────────────────────────────────────────────────────────────────────────────\n326: // 4. THE EMBEDDER SETUP ROUTE\n327: // ─────────────────────────────────────────────────────────────────────────────\n328: \n329: test('the embedder setup route is in the manifest with its own workflow asset and dry run', () => {\n330:   const routes = parseYaml(read(ROUTES_PATH)).routes.filter(\n331:     (entry) => entry.command === '/doctor:skill-advisor' && entry.target === EMBEDDER_TARGET,\n332:   );\n333:   assert.equal(routes.length, 1, '/doctor:skill-advisor must own exactly one embedder route');\n334: \n335:   const route = routes[0];\n336:   assert.equal(route.yaml, EMBEDDER_ASSET);\n337:   assert.ok(fs.existsSync(path.join(ASSETS_DIR, route.yaml)), route.yaml);\n338:   assert.deepEqual(route.setup_vars, ['execution_mode', 'dry_run']);\n339:   assert.deepEqual(route.allowed_flags, ['--dry-run']);\n340:   assert.equal(route.mutating, 'mutates');\n341:   assert.equal(route.default_target, undefined);\n342:   assert.deepEqual(route.mcp_tools, []);\n343:   assert.match(route.gate3_location, /skill-graph\\.sqlite/u);\n344:   assert.match(route.gate3_location, /Ollama model store/u);\n345: \n346:   assert.ok(Array.isArray(route.cli_commands));\n347:   assert.ok(\n348:     route.cli_commands.some((entry) => entry.includes('advisor_status')\n349:       && entry.includes('--include-semantic-health true')\n350:       && entry.includes('--warm-only')),\n351:     'the embedder route must probe the semantic lane without starting a daemon',\n352:   );\n353:   assert.ok(\n354:     route.cli_commands.some((entry) => entry.includes('skill_graph_scan')\n355:       && entry.includes('--trusted')),\n356:     'the embedder route must declare the scan and its --trusted flag',\n357:   );\n358: \n359:   assert.ok(route.trigger_phrases.length >= 3, 'the embedder route needs at least three phrases');\n360:   for (const phrase of route.trigger_phrases) {\n361:     assert.ok(\n362:       String(phrase).trim().split(/\\s+/u).length >= 3,\n363:       `an embedder trigger phrase must name three or more words: ${phrase}`,\n364:     );\n365:   }\n366: });\n367: \n368: test('the embedder workflow stops at one approval before any pull, server start or scan', () => {\n369:   const workflow = embedderWorkflow();\n370:   const phases = Object.keys(workflow.workflow);\n371:   assert.deepEqual(phases, [\n372:     'phase_1_probe',\n373:     'phase_2_plan',\n374:     'phase_3_approval',\n375:     'phase_4_approved_steps',\n376:     'phase_5_scan',\n377:     'phase_6_verify',\n378:   ]);\n379:   assert.equal(workflow.operating_mode.approvals, 'one_before_first_step');\n380: \n381:   const approvalIndex = phases.indexOf(EMBEDDER_APPROVAL_PHASE);\n382:   const approvedPhases = [];\n383:   for (const [name, phase] of Object.entries(workflow.workflow)) {\n384:     if (!phase.runs_when) continue;\n385:     approvedPhases.push(name);\n386:     assert.ok(\n387:       phases.indexOf(name) > approvalIndex,\n388:       `${name} declares runs_when before ${EMBEDDER_APPROVAL_PHASE}`,\n389:     );\n390:   }\n391:   assert.ok(approvedPhases.length > 0, 'the embedder workflow must declare its gated phases');\n392:   assert.match(\n393:     workflow.workflow[approvedPhases[0]].runs_when,\n394:     new RegExp(`${EMBEDDER_APPROVAL_PHASE} approved`, 'u'),\n395:   );\n396: \n397:   // Each step that changes the machine lives in a phase gated behind the\n398:   // approval, so the plan can be read and refused before any of them runs.\n399:   const gatedText = approvedPhases.map((name) => phaseText(workflow, name)).join('\\n');\n400:   for (const command of EMBEDDER_APPROVED_COMMANDS) {\n401:     assert.ok(\n402:       gatedText.includes(command),\n403:       `${command} must run only in a phase gated after ${EMBEDDER_APPROVAL_PHASE}`,\n404:     );\n405:   }\n406: \n407:   const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n408:   assert.match(approval, /Approve is the only answer that proceeds/u);\n409:   assert.match(approval, /STATUS=CANCELLED/u);\n410: });\n411: \n412: test('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\n413:   const workflow = embedderWorkflow();\n414:   assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\n415:   assert.match(workflow.inputs.dry_run, /STATUS=OK/u);\n416:   assert.match(workflow.inputs.dry_run, /before the approval/u);\n417: \n418:   const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n419:   assert.match(approval, /If dry_run is true/u);\n420:   assert.match(approval, /STATUS=OK/u);\n421:   assert.match(approval, /pulls nothing, starts nothing and writes nothing/u);\n422: \n423:   const phases = Object.keys(workflow.workflow);\n424:   assert.ok(\n425:     phases.indexOf(EMBEDDER_APPROVAL_PHASE) < phases.indexOf('phase_4_approved_steps'),\n426:     'the dry-run decision must sit before the first gated phase',\n427:   );\n428: });\n429: \n430: test('no embedder step installs Ollama, which the route only prints for the operator', () => {\n431:   const workflow = embedderWorkflow();\n432:   assert.ok(\n433:     workflow.rules.NEVER.includes('install_or_upgrade_ollama'),\n434:     'the embedder workflow must forbid installing or upgrading Ollama',\n435:   );\n436:   assert.match(\n437:     workflow.mutation_boundaries.forbidden_targets.join('\\n'),\n438:     /the Ollama install or upgrade itself, which this route prints and never runs/u,\n439:   );\n440:   assert.match(\n441:     phaseText(workflow, 'phase_4_approved_steps'),\n442:     /Never install or upgrade Ollama from this route/u,\n443:   );\n444: \n445:   const activities = Object.values(workflow.workflow)\n446:     .flatMap((phase) => (Array.isArray(phase.activities) ? phase.activities : []))\n447:     .map(String);\n448:   for (const activity of activities) {\n449:     if (!/install/iu.test(activity) || !/ollama/iu.test(activity)) continue;\n450:     assert.match(\n451:       activity,\n452:       /\\bprint/iu,\n453:       `an Ollama install mention must be a print step: ${activity}`,\n454:     );\n455:     assert.doesNotMatch(\n456:       activity,\n457:       /\\b(?:run|execute)\\b[^.]*\\binstall|install[^.]*\\b(?:run|execute)\\b|\\bbrew install\\b|\\bcurl\\b[^\\n]*\\|\\s*(?:ba)?sh\\b/iu,\n458:       `no step may run an Ollama install: ${activity}`,\n459:     );\n460:   }\n461: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\"}"},"time":{"start":1794558790091,"end":1794558790316}}}}
