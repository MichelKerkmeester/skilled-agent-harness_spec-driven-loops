 \"5069fc64e90403be8084b1daebc6506961222ed1377c36915b78c90e658b1108\",\n  \"manifestHash\": \"6c56dc075a672ad457f5a60f86ef4ad3b7f334987d327271f365568a027e9e45\",\n  \"normalizedQuery\": \"bind the embedder s start and pull to the resolved host dem and sarc ollama host test\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"bind\",\n    \"the\",\n    \"embedder\",\n    \"start\",\n    \"and\",\n    \"pull\",\n    \"resolved\",\n    \"host\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 176,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Bind the embedder's start and pull to the resolved host, DEM and SARC, OLLAMA_HOST test\\\" 2>&1 | tail -40\"}"},"time":{"start":1794558784245,"end":1794558785311}}}}
