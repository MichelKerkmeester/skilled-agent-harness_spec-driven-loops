{"type":"tool_use","timestamp":1794558888155,"sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","part":{"partID":"prt_1d40b85b50014irbhHv0ka3UeX","sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","messageID":"msg_1d40b4cbb001ivSsJYtOmiUHOk","type":"tool","id":"call_ad69d60b10e947c1ad0ffbc3","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-337\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where it cannot reach anything outside its own\n6: // checkout, and where the advisor it measures is built the way a user gets it.\n7: // A clone of the branch tip in a directory git does not own gives both. The\n8: // clone has no remote to push to and no outer repository whose hooks or\n9: // credentials it could borrow, and its tracked tree is exactly the commit under\n10: // test, so a per-turn restore has a clean baseline to put back.\n11: //\n12: // A clone also leaves out every ignored build output. The advisor under test\n13: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n14: // copied in afterwards. Building them inside the clone instead would measure a\n15: // bundle nobody reviewed, and would need the network while an arena is meant to\n16: // be offline.\n17: //\n18: // A copy also has to look like a build. The freshness guard each CLI shim runs\n19: // falls back to comparing the newest watched source against the build's own\n20: // timestamp, and a checkout stamps every source with the clone time while the\n21: // copied build keeps the moment it was compiled. Left alone, that order says\n22: // every copied package is stale and every shim exits before running. The copied\n23: // build is the same commit's build, so its timestamp is set to the copy time,\n24: // which is what a build in this checkout would carry.\n25: //\n26: // Nothing is copied before the destination is checked. A destination inside a\n27: // repository would inherit that repository's hooks and ignore rules, and a\n28: // destination that already exists may hold another arm's log, so both are\n29: // refused rather than merged into.\n30: //\n31: // The copy reads the source worktree, so the one thing it must never carry\n32: // across is a dotenv file. A model reads and writes an arena, so a secret that\n33: // followed the build output in would sit where a run can print it. Every file\n34: // whose name begins with `.env` is skipped while copying, at every depth.\n35: //\n36: // Usage:\n37: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n38: \n39: // ───────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ───────────────────────────────────────────────────────────────\n42: \n43: import { existsSync, lstatSync, lutimesSync, mkdirSync, readdirSync, rmSync, utimesSync } from 'node:fs';\n44: import { spawnSync } from 'node:child_process';\n45: import { basename, dirname, join, resolve } from 'node:path';\n46: import { fileURLToPath } from 'node:url';\n47: \n48: // ───────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────\n51: \n52: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n53: const EXIT_REFUSED = 2;\n54: \n55: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n56: \n57: // A filesystem monitor that decides a path is unchanged makes the clone and the\n58: // clean-tree check disagree about what the checkout holds.\n59: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n60: \n61: // The two ignored trees a build writes and a clone never carries.\n62: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n63: \n64: const SQLITE_SUFFIX = '.sqlite';\n65: const SKILLED_PREFIX = '.skilled/';\n66: const DOTENV_PATTERN = /^\\.env/;\n67: \n68: // ───────────────────────────────────────────────────────────────\n69: // 3. FAILURE SHAPES\n70: // ───────────────────────────────────────────────────────────────\n71: \n72: // A refusal is a precondition the caller can act on, so it carries a code on\n73: // stdout. A step failure leaves no usable arena behind, so it reports the code\n74: // and the failing command on stderr instead.\n75: class StepFailure extends Error {\n76:   constructor(code, detail) {\n77:     super(detail === '' ? code : `${code}: ${detail}`);\n78:     this.code = code;\n79:   }\n80: }\n81: \n82: function writeJson(value) {\n83:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n84: }\n85: \n86: function refuse(code, extra = {}) {\n87:   writeJson({ ok: false, code, ...extra });\n88:   process.exit(EXIT_REFUSED);\n89: }\n90: \n91: function abort(code, detail = '') {\n92:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n93:   writeJson({ ok: false, code });\n94:   process.exit(1);\n95: }\n96: \n97: // ───────────────────────────────────────────────────────────────\n98: // 4. ARGUMENT PARSING\n99: // ───────────────────────────────────────────────────────────────\n100: \n101: function valueAfter(argv, index, flag) {\n102:   const value = argv[index];\n103:   if (value === undefined || value.startsWith('--')) {\n104:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n105:     process.exit(EXIT_REFUSED);\n106:   }\n107:   return value;\n108: }\n109: \n110: function parseOptions(argv) {\n111:   const options = { source: null, dest: null };\n112:   for (let index = 0; index < argv.length; index += 1) {\n113:     const token = argv[index];\n114:     if (token === '--source') {\n115:       index += 1;\n116:       options.source = valueAfter(argv, index, '--source');\n117:     } else if (token === '--dest') {\n118:       index += 1;\n119:       options.dest = valueAfter(argv, index, '--dest');\n120:     } else {\n121:       process.stderr.write(`${SCRIPT_NAME}: unknown option: ${token}\\n${USAGE}\\n`);\n122:       process.exit(EXIT_REFUSED);\n123:     }\n124:   }\n125:   if (options.source === null || options.dest === null) {\n126:     process.stderr.write(`${SCRIPT_NAME}: --source and --dest are required\\n${USAGE}\\n`);\n127:     process.exit(EXIT_REFUSED);\n128:   }\n129:   return options;\n130: }\n131: \n132: // ───────────────────────────────────────────────────────────────\n133: // 5. GIT HELPERS\n134: // ───────────────────────────────────────────────────────────────\n135: \n136: function git(args, cwd) {\n137:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n138:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n139:   return result;\n140: }\n141: \n142: function gitText(args, cwd, code) {\n143:   const result = git(args, cwd);\n144:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n145:   return result.stdout;\n146: }\n147: \n148: function headOf(cwd, code) {\n149:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n150:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n151:   return head;\n152: }\n153: \n154: // Whether git would leave a path out of a checkout decides whether a clone\n155: // already holds it, so ignore rules are asked rather than guessed from a name.\n156: function isIgnored(cwd, relPath) {\n157:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n158: }\n159: \n160: // ───────────────────────────────────────────────────────────────\n161: // 6. DESTINATION CHECKS\n162: // ───────────────────────────────────────────────────────────────\n163: \n164: function pathExists(path) {\n165:   try {\n166:     lstatSync(path);\n167:     return true;\n168:   } catch {\n169:     return false;\n170:   }\n171: }\n172: \n173: function nearestExistingAncestor(path) {\n174:   let current = path;\n175:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n176:   return current;\n177: }\n178: \n179: function isInsideRepository(path) {\n180:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n181: }\n182: \n183: // ───────────────────────────────────────────────────────────────\n184: // 7. COPY PLAN\n185: // ───────────────────────────────────────────────────────────────\n186: \n187: // One walk of the source decides what a clone is missing. A build directory is\n188: // recorded and not descended into, so anything inside it travels with the tree.\n189: // The SQLite files searched for sit under the tooling root only, because that is\n190: // where the advisor keeps its graph.\n191: function copyPlan(source) {\n192:   const trees = [];\n193:   const sqlite = [];\n194:   const walk = (relPath) => {\n195:     const absPath = relPath === '' ? source : join(source, relPath);\n196:     for (const entry of readdirSync(absPath, { withFileTypes: true })) {\n197:       if (entry.name === '.git') continue;\n198:       const childRel = relPath === '' ? entry.name : `${relPath}/${entry.name}`;\n199:       if (entry.isDirectory()) {\n200:         if (BUILD_DIR_NAMES.has(entry.name)) {\n201:           trees.push(childRel);\n202:           continue;\n203:         }\n204:         walk(childRel);\n205:         continue;\n206:       }\n207:       if (entry.isFile() && entry.name.endsWith(SQLITE_SUFFIX) && childRel.startsWith(SKILLED_PREFIX)) {\n208:         sqlite.push(childRel);\n209:       }\n210:     }\n211:   };\n212:   walk('');\n213:   return [...trees, ...sqlite].filter((relPath) => isIgnored(source, relPath)).sort();\n214: }\n215: \n216: function holdsDotenv(dirPath) {\n217:   for (const entry of readdirSync(dirPath, { withFileTypes: true })) {\n218:     if (DOTENV_PATTERN.test(entry.name)) return true;\n219:     if (entry.isDirectory() && holdsDotenv(join(dirPath, entry.name))) return true;\n220:   }\n221:   return false;\n222: }\n223: \n224: function runCp(sourcePath, destParent) {\n225:   const result = spawnSync('cp', ['-Rc', sourcePath, destParent], { encoding: 'utf8' });\n226:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n227:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n228: }\n229: \n230: // A symlink is stamped through the link itself, because its target may live\n231: // outside the arena and is not this copy's to change.\n232: function stampPath(path, time) {\n233:   if (lstatSync(path).isSymbolicLink()) {\n234:     lutimesSync(path, time, time);\n235:     return;\n236:   }\n237:   utimesSync(path, time, time);\n238: }\n239: \n240: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n241: // and neither a dependency tree nor a database file is watched.\n242: function stampBuildTree(path) {\n243:   const time = new Date();\n244:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n245:     const child = join(path, entry.name);\n246:     if (entry.isDirectory()) stampBuildTree(child);\n247:     else stampPath(child, time);\n248:   }\n249:   stampPath(path, time);\n250: }\n251: \n252: // The clonefile flag keeps the copy cheap on the same volume, and the walk only\n253: // happens where a dotenv file is actually present, so the common tree is one\n254: // `cp` call rather than one call per file.\n255: function copyPath(sourcePath, destPath) {\n256:   const isDirectory = lstatSync(sourcePath).isDirectory();\n257:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n258:     mkdirSync(dirname(destPath), { recursive: true });\n259:     runCp(sourcePath, dirname(destPath));\n260:     return;\n261:   }\n262:   mkdirSync(destPath, { recursive: true });\n263:   for (const entry of readdirSync(sourcePath, { withFileTypes: true })) {\n264:     if (DOTENV_PATTERN.test(entry.name)) continue;\n265:     copyPath(join(sourcePath, entry.name), join(destPath, entry.name));\n266:   }\n267: }\n268: \n269: // ───────────────────────────────────────────────────────────────\n270: // 8. ARENA BUILD\n271: // ───────────────────────────────────────────────────────────────\n272: \n273: function cloneInto(source, dest) {\n274:   const result = git(['clone', '--no-hardlinks', source, dest], process.cwd());\n275:   if (result.status !== 0) throw new StepFailure('clone_failed', (result.stderr ?? '').trim());\n276: }\n277: \n278: function checkoutDetached(dest, head) {\n279:   const result = git(['checkout', '--quiet', '--detach', head], dest);\n280:   if (result.status !== 0) throw new StepFailure('checkout_failed', (result.stderr ?? '').trim());\n281: }\n282: \n283: // A remote is the one piece of git state a turn could use to reach outside the\n284: // checkout, so every one the clone inherits is removed rather than left dormant.\n285: function removeRemotes(dest) {\n286:   const names = gitText(['remote'], dest, 'remote_unreadable')\n287:     .split('\\n')\n288:     .map((name) => name.trim())\n289:     .filter((name) => name !== '');\n290:   for (const name of names) gitText(['remote', 'remove', name], dest, 'remote_unreadable');\n291: }\n292: \n293: function assertHead(dest, head) {\n294:   const cloned = gitText(['rev-parse', 'HEAD'], dest, 'head_unreadable').trim();\n295:   if (cloned !== head) throw new StepFailure('head_mismatch', `expected ${head}, got ${cloned}`);\n296: }\n297: \n298: function buildArena(source, dest, head) {\n299:   cloneInto(source, dest);\n300:   checkoutDetached(dest, head);\n301:   removeRemotes(dest);\n302:   const copied = copyPlan(source);\n303:   for (const relPath of copied) {\n304:     const destPath = join(dest, relPath);\n305:     copyPath(join(source, relPath), destPath);\n306:     if (basename(relPath) === 'dist') stampBuildTree(destPath);\n307:   }\n308:   assertHead(dest, head);\n309:   return copied;\n310: }\n311: \n312: // ───────────────────────────────────────────────────────────────\n313: // 9. ENTRY POINT\n314: // ───────────────────────────────────────────────────────────────\n315: \n316: function main(argv) {\n317:   const options = parseOptions(argv);\n318:   const source = resolve(options.source);\n319:   const dest = resolve(options.dest);\n320:   const head = headOf(source, 'source_not_repo');\n321: \n322:   if (pathExists(dest)) refuse('dest_exists', { dest });\n323:   if (isInsideRepository(nearestExistingAncestor(dirname(dest)))) refuse('dest_in_repo', { dest });\n324: \n325:   mkdirSync(dirname(dest), { recursive: true });\n326:   try {\n327:     const copied = buildArena(source, dest, head);\n328:     writeJson({ ok: true, dest, head, copied });\n329:   } catch (error) {\n330:     // A half-built arena would answer the next call with `dest_exists` while\n331:     // holding a checkout nobody finished, so the failed attempt removes itself.\n332:     rmSync(dest, { recursive: true, force: true });\n333:     abort(error.code ?? 'arena_failed', error.message);\n334:   }\n335: }\n336: \n337: main(process.argv.slice(2));","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs, lines 1-337\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Behaviour Arena Builder\n3: // ───────────────────────────────────────────────────────────────\n4: //\n5: // A live turn has to run where it cannot reach anything outside its own\n6: // checkout, and where the advisor it measures is built the way a user gets it.\n7: // A clone of the branch tip in a directory git does not own gives both. The\n8: // clone has no remote to push to and no outer repository whose hooks or\n9: // credentials it could borrow, and its tracked tree is exactly the commit under\n10: // test, so a per-turn restore has a clean baseline to put back.\n11: //\n12: // A clone also leaves out every ignored build output. The advisor under test\n13: // runs from compiled JavaScript and its SQLite skill graph, so those trees are\n14: // copied in afterwards. Building them inside the clone instead would measure a\n15: // bundle nobody reviewed, and would need the network while an arena is meant to\n16: // be offline.\n17: //\n18: // A copy also has to look like a build. The freshness guard each CLI shim runs\n19: // falls back to comparing the newest watched source against the build's own\n20: // timestamp, and a checkout stamps every source with the clone time while the\n21: // copied build keeps the moment it was compiled. Left alone, that order says\n22: // every copied package is stale and every shim exits before running. The copied\n23: // build is the same commit's build, so its timestamp is set to the copy time,\n24: // which is what a build in this checkout would carry.\n25: //\n26: // Nothing is copied before the destination is checked. A destination inside a\n27: // repository would inherit that repository's hooks and ignore rules, and a\n28: // destination that already exists may hold another arm's log, so both are\n29: // refused rather than merged into.\n30: //\n31: // The copy reads the source worktree, so the one thing it must never carry\n32: // across is a dotenv file. A model reads and writes an arena, so a secret that\n33: // followed the build output in would sit where a run can print it. Every file\n34: // whose name begins with `.env` is skipped while copying, at every depth.\n35: //\n36: // Usage:\n37: //   node prepare-behaviour-arena.mjs --source <repo root> --dest <dir>\n38: \n39: // ───────────────────────────────────────────────────────────────\n40: // 1. IMPORTS\n41: // ───────────────────────────────────────────────────────────────\n42: \n43: import { existsSync, lstatSync, lutimesSync, mkdirSync, readdirSync, rmSync, utimesSync } from 'node:fs';\n44: import { spawnSync } from 'node:child_process';\n45: import { basename, dirname, join, resolve } from 'node:path';\n46: import { fileURLToPath } from 'node:url';\n47: \n48: // ───────────────────────────────────────────────────────────────\n49: // 2. CONSTANTS\n50: // ───────────────────────────────────────────────────────────────\n51: \n52: const SCRIPT_NAME = basename(fileURLToPath(import.meta.url));\n53: const EXIT_REFUSED = 2;\n54: \n55: const USAGE = `usage: node ${SCRIPT_NAME} --source <repo root> --dest <dir>`;\n56: \n57: // A filesystem monitor that decides a path is unchanged makes the clone and the\n58: // clean-tree check disagree about what the checkout holds.\n59: const GIT_PREFIX = ['-c', 'core.fsmonitor=false'];\n60: \n61: // The two ignored trees a build writes and a clone never carries.\n62: const BUILD_DIR_NAMES = new Set(['dist', 'node_modules']);\n63: \n64: const SQLITE_SUFFIX = '.sqlite';\n65: const SKILLED_PREFIX = '.skilled/';\n66: const DOTENV_PATTERN = /^\\.env/;\n67: \n68: // ───────────────────────────────────────────────────────────────\n69: // 3. FAILURE SHAPES\n70: // ───────────────────────────────────────────────────────────────\n71: \n72: // A refusal is a precondition the caller can act on, so it carries a code on\n73: // stdout. A step failure leaves no usable arena behind, so it reports the code\n74: // and the failing command on stderr instead.\n75: class StepFailure extends Error {\n76:   constructor(code, detail) {\n77:     super(detail === '' ? code : `${code}: ${detail}`);\n78:     this.code = code;\n79:   }\n80: }\n81: \n82: function writeJson(value) {\n83:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n84: }\n85: \n86: function refuse(code, extra = {}) {\n87:   writeJson({ ok: false, code, ...extra });\n88:   process.exit(EXIT_REFUSED);\n89: }\n90: \n91: function abort(code, detail = '') {\n92:   process.stderr.write(`${SCRIPT_NAME}: ${detail === '' ? code : `${code}: ${detail}`}\\n`);\n93:   writeJson({ ok: false, code });\n94:   process.exit(1);\n95: }\n96: \n97: // ───────────────────────────────────────────────────────────────\n98: // 4. ARGUMENT PARSING\n99: // ───────────────────────────────────────────────────────────────\n100: \n101: function valueAfter(argv, index, flag) {\n102:   const value = argv[index];\n103:   if (value === undefined || value.startsWith('--')) {\n104:     process.stderr.write(`${SCRIPT_NAME}: ${flag} needs a value\\n${USAGE}\\n`);\n105:     process.exit(EXIT_REFUSED);\n106:   }\n107:   return value;\n108: }\n109: \n110: function parseOptions(argv) {\n111:   const options = { source: null, dest: null };\n112:   for (let index = 0; index < argv.length; index += 1) {\n113:     const token = argv[index];\n114:     if (token === '--source') {\n115:       index += 1;\n116:       options.source = valueAfter(argv, index, '--source');\n117:     } else if (token === '--dest') {\n118:       index += 1;\n119:       options.dest = valueAfter(argv, index, '--dest');\n120:     } else {\n121:       process.stderr.write(`${SCRIPT_NAME}: unknown option: ${token}\\n${USAGE}\\n`);\n122:       process.exit(EXIT_REFUSED);\n123:     }\n124:   }\n125:   if (options.source === null || options.dest === null) {\n126:     process.stderr.write(`${SCRIPT_NAME}: --source and --dest are required\\n${USAGE}\\n`);\n127:     process.exit(EXIT_REFUSED);\n128:   }\n129:   return options;\n130: }\n131: \n132: // ───────────────────────────────────────────────────────────────\n133: // 5. GIT HELPERS\n134: // ───────────────────────────────────────────────────────────────\n135: \n136: function git(args, cwd) {\n137:   const result = spawnSync('git', [...GIT_PREFIX, ...args], { cwd, encoding: 'utf8' });\n138:   if (result.error) throw new StepFailure('spawn_failed', result.error.message);\n139:   return result;\n140: }\n141: \n142: function gitText(args, cwd, code) {\n143:   const result = git(args, cwd);\n144:   if (result.status !== 0) throw new StepFailure(code, (result.stderr ?? '').trim());\n145:   return result.stdout;\n146: }\n147: \n148: function headOf(cwd, code) {\n149:   const head = gitText(['rev-parse', 'HEAD'], cwd, code).trim();\n150:   if (head === '') throw new StepFailure(code, `no HEAD in ${cwd}`);\n151:   return head;\n152: }\n153: \n154: // Whether git would leave a path out of a checkout decides whether a clone\n155: // already holds it, so ignore rules are asked rather than guessed from a name.\n156: function isIgnored(cwd, relPath) {\n157:   return git(['check-ignore', '-q', '--', relPath], cwd).status === 0;\n158: }\n159: \n160: // ───────────────────────────────────────────────────────────────\n161: // 6. DESTINATION CHECKS\n162: // ───────────────────────────────────────────────────────────────\n163: \n164: function pathExists(path) {\n165:   try {\n166:     lstatSync(path);\n167:     return true;\n168:   } catch {\n169:     return false;\n170:   }\n171: }\n172: \n173: function nearestExistingAncestor(path) {\n174:   let current = path;\n175:   while (!existsSync(current) && dirname(current) !== current) current = dirname(current);\n176:   return current;\n177: }\n178: \n179: function isInsideRepository(path) {\n180:   return git(['rev-parse', '--show-toplevel'], path).status === 0;\n181: }\n182: \n183: // ───────────────────────────────────────────────────────────────\n184: // 7. COPY PLAN\n185: // ───────────────────────────────────────────────────────────────\n186: \n187: // One walk of the source decides what a clone is missing. A build directory is\n188: // recorded and not descended into, so anything inside it travels with the tree.\n189: // The SQLite files searched for sit under the tooling root only, because that is\n190: // where the advisor keeps its graph.\n191: function copyPlan(source) {\n192:   const trees = [];\n193:   const sqlite = [];\n194:   const walk = (relPath) => {\n195:     const absPath = relPath === '' ? source : join(source, relPath);\n196:     for (const entry of readdirSync(absPath, { withFileTypes: true })) {\n197:       if (entry.name === '.git') continue;\n198:       const childRel = relPath === '' ? entry.name : `${relPath}/${entry.name}`;\n199:       if (entry.isDirectory()) {\n200:         if (BUILD_DIR_NAMES.has(entry.name)) {\n201:           trees.push(childRel);\n202:           continue;\n203:         }\n204:         walk(childRel);\n205:         continue;\n206:       }\n207:       if (entry.isFile() && entry.name.endsWith(SQLITE_SUFFIX) && childRel.startsWith(SKILLED_PREFIX)) {\n208:         sqlite.push(childRel);\n209:       }\n210:     }\n211:   };\n212:   walk('');\n213:   return [...trees, ...sqlite].filter((relPath) => isIgnored(source, relPath)).sort();\n214: }\n215: \n216: function holdsDotenv(dirPath) {\n217:   for (const entry of readdirSync(dirPath, { withFileTypes: true })) {\n218:     if (DOTENV_PATTERN.test(entry.name)) return true;\n219:     if (entry.isDirectory() && holdsDotenv(join(dirPath, entry.name))) return true;\n220:   }\n221:   return false;\n222: }\n223: \n224: function runCp(sourcePath, destParent) {\n225:   const result = spawnSync('cp', ['-Rc', sourcePath, destParent], { encoding: 'utf8' });\n226:   if (result.error) throw new StepFailure('copy_failed', `${sourcePath}: ${result.error.message}`);\n227:   if (result.status !== 0) throw new StepFailure('copy_failed', `${sourcePath}: ${(result.stderr ?? '').trim()}`);\n228: }\n229: \n230: // A symlink is stamped through the link itself, because its target may live\n231: // outside the arena and is not this copy's to change.\n232: function stampPath(path, time) {\n233:   if (lstatSync(path).isSymbolicLink()) {\n234:     lutimesSync(path, time, time);\n235:     return;\n236:   }\n237:   utimesSync(path, time, time);\n238: }\n239: \n240: // Only a build tree is stamped. The guard reads the timestamp of a dist entry,\n241: // and neither a dependency tree nor a database file is watched.\n242: function stampBuildTree(path) {\n243:   const time = new Date();\n244:   for (const entry of readdirSync(path, { withFileTypes: true })) {\n245:     const child = join(path, entry.name);\n246:     if (entry.isDirectory()) stampBuildTree(child);\n247:     else stampPath(child, time);\n248:   }\n249:   stampPath(path, time);\n250: }\n251: \n252: // The clonefile flag keeps the copy cheap on the same volume, and the walk only\n253: // happens where a dotenv file is actually present, so the common tree is one\n254: // `cp` call rather than one call per file.\n255: function copyPath(sourcePath, destPath) {\n256:   const isDirectory = lstatSync(sourcePath).isDirectory();\n257:   if (!isDirectory || !holdsDotenv(sourcePath)) {\n258:     mkdirSync(dirname(destPath), { recursive: true });\n259:     runCp(sourcePath, dirname(destPath));\n260:     return;\n261:   }\n262:   mkdirSync(destPath, { recursive: true });\n263:   for (const entry of readdirSync(sourcePath, { withFileTypes: true })) {\n264:     if (DOTENV_PATTERN.test(entry.name)) continue;\n265:     copyPath(join(sourcePath, entry.name), join(destPath, entry.name));\n266:   }\n267: }\n268: \n269: // ───────────────────────────────────────────────────────────────\n270: // 8. ARENA BUILD\n271: // ───────────────────────────────────────────────────────────────\n272: \n273: function cloneInto(source, dest) {\n274:   const result = git(['clone', '--no-hardlinks', source, dest], process.cwd());\n275:   if (result.status !== 0) throw new StepFailure('clone_failed', (result.stderr ?? '').trim());\n276: }\n277: \n278: function checkoutDetached(dest, head) {\n279:   const result = git(['checkout', '--quiet', '--detach', head], dest);\n280:   if (result.status !== 0) throw new StepFailure('checkout_failed', (result.stderr ?? '').trim());\n281: }\n282: \n283: // A remote is the one piece of git state a turn could use to reach outside the\n284: // checkout, so every one the clone inherits is removed rather than left dormant.\n285: function removeRemotes(dest) {\n286:   const names = gitText(['remote'], dest, 'remote_unreadable')\n287:     .split('\\n')\n288:     .map((name) => name.trim())\n289:     .filter((name) => name !== '');\n290:   for (const name of names) gitText(['remote', 'remove', name], dest, 'remote_unreadable');\n291: }\n292: \n293: function assertHead(dest, head) {\n294:   const cloned = gitText(['rev-parse', 'HEAD'], dest, 'head_unreadable').trim();\n295:   if (cloned !== head) throw new StepFailure('head_mismatch', `expected ${head}, got ${cloned}`);\n296: }\n297: \n298: function buildArena(source, dest, head) {\n299:   cloneInto(source, dest);\n300:   checkoutDetached(dest, head);\n301:   removeRemotes(dest);\n302:   const copied = copyPlan(source);\n303:   for (const relPath of copied) {\n304:     const destPath = join(dest, relPath);\n305:     copyPath(join(source, relPath), destPath);\n306:     if (basename(relPath) === 'dist') stampBuildTree(destPath);\n307:   }\n308:   assertHead(dest, head);\n309:   return copied;\n310: }\n311: \n312: // ───────────────────────────────────────────────────────────────\n313: // 9. ENTRY POINT\n314: // ───────────────────────────────────────────────────────────────\n315: \n316: function main(argv) {\n317:   const options = parseOptions(argv);\n318:   const source = resolve(options.source);\n319:   const dest = resolve(options.dest);\n320:   const head = headOf(source, 'source_not_repo');\n321: \n322:   if (pathExists(dest)) refuse('dest_exists', { dest });\n323:   if (isInsideRepository(nearestExistingAncestor(dirname(dest)))) refuse('dest_in_repo', { dest });\n324: \n325:   mkdirSync(dirname(dest), { recursive: true });\n326:   try {\n327:     const copied = buildArena(source, dest, head);\n328:     writeJson({ ok: true, dest, head, copied });\n329:   } catch (error) {\n330:     // A half-built arena would answer the next call with `dest_exists` while\n331:     // holding a checkout nobody finished, so the failed attempt removes itself.\n332:     rmSync(dest, { recursive: true, force: true });\n333:     abort(error.code ?? 'arena_failed', error.message);\n334:   }\n335: }\n336: \n337: main(process.argv.slice(2));"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/prepare-behaviour-arena.mjs\"}"},"time":{"start":1794558887349,"end":1794558888155}}}}
{"type":"step_finish","timestamp":1794558890207,"sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","part":{"id":"prt_1d40b90df001O3TCogo8HOfJjg","sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","messageID":"msg_1d40b4cbb001ivSsJYtOmiUHOk","type":"step-finish","reason":"tool-calls","snapshot":"809a009edc0126450ef7eb584451f2232b389de3","cost":0,"tokens":{"input":32680,"output":138,"reasoning":412,"cache":{"read":384,"write":0}}}}
{"type":"step_start","timestamp":1794558892162,"sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","part":{"id":"prt_1d40b98820010GRAgn3Tv5cmbw","sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","messageID":"msg_1d40b90e30015zpgleuz7b0r3J","type":"step-start","snapshot":"8c3f96a7ea15e57cf4415e7b23aa6ef73b1ca8ee"}}
{"type":"tool_use","timestamp":1794558895980,"sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","part":{"partID":"prt_1d40ba5fc0013G7V3QMQHe0JSE","sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","messageID":"msg_1d40b90e30015zpgleuz7b0r3J","type":"tool","id":"call_1abee3c59b524482b053a4af","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md, lines 1-176\n1: ---\n2: name: sk-code\n3: description: \"Implement, debug and verify code: TypeScript, Python, shell, JSON; quality and review workflow modes with stack surface packets.\"\n4: allowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\n5: version: 3.11.6.0\n6: metadata:\n7:   family: sk-code\n8: ---\n9: \n10: <!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n11: \n12: # Code Family Hub (sk-code)\n13: \n14: One skill has two axes, one shared surface-detection router and one advisor identity.\n15: The **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\n16: The **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\n17: Each packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\n18: This hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n19: \n20: **Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n21: `description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n22: `ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\n23: The authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\n24: A packet version is independent of this one by design, so a gap between them is not drift.\n25: \n26: ---\n27: \n28: ## 1. WHEN TO USE\n29: \n30: Use this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n31: \n32: **Workflow axis** (modes that act, one of them chosen as primary):\n33: \n34: | Mode | Use it for | Packet |\n35: |------|------------|--------|\n36: | **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n37: | **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n38: \n39: **Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n40: \n41: | Surface | Carries | Packet |\n42: |---------|---------|--------|\n43: | **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n44: | **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n45: | **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n46: \n47: **Surface list.** The hub has exactly three surfaces:\n48: - SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n49: - CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n50: - Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n51: \n52: The hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\n53: Any other sk-code doc that counts surfaces points to this sentence.\n54: \n55: ### When NOT to Use\n56: - Documentation-only changes with no code-work contract - use `sk-doc`.\n57: - Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n58: - Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n59: - For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n60: - When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n61: - Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n62: \n63: ---\n64: \n65: ## 2. SMART ROUTING\n66: \n67: Routing is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\n68: Stage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\n69: Stage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\n70: Both files point back here instead of restating the split.\n71: \n72: The advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\n73: Compiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n74: \n75: A bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\n76: Run the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n77: \n78: ---\n79: \n80: ## 3. HOW IT WORKS\n81: \n82: ### Terms\n83: \n84: - **`workflowMode`**: the public mode or surface key a request resolves to.\n85: - **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n86: - **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n87: - **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n88: - **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n89: - **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n90: - **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n91: - **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n92: - **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n93: - **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n94: - **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n95: - **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n96: \n97: ### Layout\n98: ```\n99: sk-code/\n100:   SKILL.md               # this routing hub (no per-mode code logic)\n101:   README.md              # human-facing front page for the hub\n102:   ROUTER.md              # active stage-two surface router and shared-control declaration\n103:   mode-registry.json     # the two-axis discriminator + advisorRouting contract\n104:   hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n105:   description.json       # hub advisor descriptor\n106:   graph-metadata.json    # the ONE advisor identity for the whole skill\n107:   leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n108:   changelog/             # hub release notes, one v<version>.md per hub release\n109:   feature-catalog/       # current-state inventory of the hub's routing capabilities\n110:   manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n111:   benchmark/             # historical routing benchmark inputs and reports\n112:   sk-code-quality/       # quality mode packet     (workflow)\n113:   sk-code-review/        # review mode packet      (workflow)\n114:   sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n115:   sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n116:   sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n117:   shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n118: ```\n119: \n120: Each mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n121: \n122: ### Backend\n123: The `surface-router` backend is the shared surface-detection router under `shared/`.\n124: It centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\n125: It carries the shared implement → debug → verify workflow doctrine consumed by each surface.\n126: The `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\n127: The `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\n128: The packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\n129: Shared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\n130: It must never gain per-mode workflow contracts.\n131: \n132: The **implement → debug → verify** phases are not standalone modes.\n133: Their surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\n134: Those files are symlinked into each surface, so the active surface carries the full workflow.\n135: A request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\n136: The acting agent applies that doctrine.\n137: \n138: ### Maintenance\n139: \n140: After adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n141: \n142: ---\n143: \n144: ## 4. RULES\n145: \n146: ### ✅ ALWAYS\n147: - **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n148: - **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n149: - **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n150: - **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n151: - **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n152: - **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n153: - **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n154: \n155: ### ⛔ NEVER\n156: - **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n157: - **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n158: - **NEVER** hardcode a router mapping outside `mode-registry.json`.\n159: - **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n160: \n161: ### ⚠️ ESCALATE IF\n162: - A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n163: - Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n164: \n165: ---\n166: \n167: ## 5. REFERENCES\n168: \n169: - Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n170: - Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n171: - Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n172: - Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n173: - Hub router signals + surface bundling: `hub-router.json`.\n174: - Surface router and shared controls: `ROUTER.md`.\n175: - Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n176: - Sibling example: `.skilled/skills/sk-prompt/`.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md, lines 1-176\n1: ---\n2: name: sk-code\n3: description: \"Implement, debug and verify code: TypeScript, Python, shell, JSON; quality and review workflow modes with stack surface packets.\"\n4: allowed-tools: [Read, Write, Edit, Bash, Grep, Glob]\n5: version: 3.11.6.0\n6: metadata:\n7:   family: sk-code\n8: ---\n9: \n10: <!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n11: \n12: # Code Family Hub (sk-code)\n13: \n14: One skill has two axes, one shared surface-detection router and one advisor identity.\n15: The **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\n16: The **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\n17: Each packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\n18: This hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n19: \n20: **Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n21: `description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n22: `ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\n23: The authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\n24: A packet version is independent of this one by design, so a gap between them is not drift.\n25: \n26: ---\n27: \n28: ## 1. WHEN TO USE\n29: \n30: Use this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n31: \n32: **Workflow axis** (modes that act, one of them chosen as primary):\n33: \n34: | Mode | Use it for | Packet |\n35: |------|------------|--------|\n36: | **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n37: | **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n38: \n39: **Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n40: \n41: | Surface | Carries | Packet |\n42: |---------|---------|--------|\n43: | **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n44: | **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n45: | **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n46: \n47: **Surface list.** The hub has exactly three surfaces:\n48: - SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n49: - CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n50: - Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n51: \n52: The hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\n53: Any other sk-code doc that counts surfaces points to this sentence.\n54: \n55: ### When NOT to Use\n56: - Documentation-only changes with no code-work contract - use `sk-doc`.\n57: - Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n58: - Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n59: - For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n60: - When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n61: - Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n62: \n63: ---\n64: \n65: ## 2. SMART ROUTING\n66: \n67: Routing is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\n68: Stage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\n69: Stage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\n70: Both files point back here instead of restating the split.\n71: \n72: The advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\n73: Compiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n74: \n75: A bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\n76: Run the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n77: \n78: ---\n79: \n80: ## 3. HOW IT WORKS\n81: \n82: ### Terms\n83: \n84: - **`workflowMode`**: the public mode or surface key a request resolves to.\n85: - **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n86: - **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n87: - **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n88: - **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n89: - **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n90: - **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n91: - **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n92: - **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n93: - **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n94: - **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n95: - **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n96: \n97: ### Layout\n98: ```\n99: sk-code/\n100:   SKILL.md               # this routing hub (no per-mode code logic)\n101:   README.md              # human-facing front page for the hub\n102:   ROUTER.md              # active stage-two surface router and shared-control declaration\n103:   mode-registry.json     # the two-axis discriminator + advisorRouting contract\n104:   hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n105:   description.json       # hub advisor descriptor\n106:   graph-metadata.json    # the ONE advisor identity for the whole skill\n107:   leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n108:   changelog/             # hub release notes, one v<version>.md per hub release\n109:   feature-catalog/       # current-state inventory of the hub's routing capabilities\n110:   manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n111:   benchmark/             # historical routing benchmark inputs and reports\n112:   sk-code-quality/       # quality mode packet     (workflow)\n113:   sk-code-review/        # review mode packet      (workflow)\n114:   sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n115:   sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n116:   sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n117:   shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n118: ```\n119: \n120: Each mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n121: \n122: ### Backend\n123: The `surface-router` backend is the shared surface-detection router under `shared/`.\n124: It centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\n125: It carries the shared implement → debug → verify workflow doctrine consumed by each surface.\n126: The `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\n127: The `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\n128: The packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\n129: Shared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\n130: It must never gain per-mode workflow contracts.\n131: \n132: The **implement → debug → verify** phases are not standalone modes.\n133: Their surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\n134: Those files are symlinked into each surface, so the active surface carries the full workflow.\n135: A request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\n136: The acting agent applies that doctrine.\n137: \n138: ### Maintenance\n139: \n140: After adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n141: \n142: ---\n143: \n144: ## 4. RULES\n145: \n146: ### ✅ ALWAYS\n147: - **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n148: - **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n149: - **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n150: - **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n151: - **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n152: - **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n153: - **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n154: \n155: ### ⛔ NEVER\n156: - **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n157: - **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n158: - **NEVER** hardcode a router mapping outside `mode-registry.json`.\n159: - **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n160: \n161: ### ⚠️ ESCALATE IF\n162: - A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n163: - Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n164: \n165: ---\n166: \n167: ## 5. REFERENCES\n168: \n169: - Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n170: - Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n171: - Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n172: - Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n173: - Hub router signals + surface bundling: `hub-router.json`.\n174: - Surface router and shared controls: `ROUTER.md`.\n175: - Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n176: - Sibling example: `.skilled/skills/sk-prompt/`."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/sk-code/SKILL.md\"}"},"time":{"start":1794558895612,"end":1794558895980}}}}
{"type":"tool_use","timestamp":1794558896356,"sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","part":{"partID":"prt_1d40ba20500140BbymjuzQsE36","sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","messageID":"msg_1d40b90e30015zpgleuz7b0r3J","type":"tool","id":"call_35f24377537c4c62b5e2623e","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \"T020 Mark an arena the builder made ARB prepare-behaviour-arena.mjs buildArena assertHead writeFileSync MARK skilled-behaviour-arena\" 2>&1 | head -40"},"output":"{\n  \"candidatePhraseCount\": 1327,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"an\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"behaviour\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"mjs\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"buildarena\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"asserthead\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"writefilesync\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"skilled\"\n    }\n  ],\n  \"indexHash\": \"5069fc64e90403be8084b1daebc6506961222ed1377c36915b78c90e658b1108\",\n  \"manifestHash\": \"6c56dc075a672ad457f5a60f86ef4ad3b7f334987d327271f365568a027e9e45\",\n  \"normalizedQuery\": \"t020 mark an arena the builder made arb prepare behaviour arena mjs buildarena asserthead writefilesync mark skilled behaviour arena\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"t020\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"candidatePhraseCount\": 1327,\n  \"discardedTokens\": [\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"an\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"behaviour\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"mjs\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"buildarena\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"asserthead\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"writefilesync\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"skilled\"\n    }\n  ],\n  \"indexHash\": \"5069fc64e90403be8084b1daebc6506961222ed1377c36915b78c90e658b1108\",\n  \"manifestHash\": \"6c56dc075a672ad457f5a60f86ef4ad3b7f334987d327271f365568a027e9e45\",\n  \"normalizedQuery\": \"t020 mark an arena the builder made arb prepare behaviour arena mjs buildarena asserthead writefilesync mark skilled behaviour arena\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"t020\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research && node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"T020 Mark an arena the builder made ARB prepare-behaviour-arena.mjs buildArena assertHead writeFileSync MARK skilled-behaviour-arena\\\" 2>&1 | head -40\"}"},"time":{"start":1794558894597,"end":1794558896356}}}}
{"type":"step_finish","timestamp":1794558898932,"sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","part":{"id":"prt_1d40bb2f4001TYKJ1Qsny6v4GV","sessionID":"ses_e2bf4dbfdffeNwEoi6rDcbop5B","messageID":"msg_1d40b90e30015zpgleuz7b0r3J","type":"step-finish","reason":"tool-calls","snapshot":"5de9a5e0bd5d9cad177daa77b211cc37f62c1252","cost":0,"tokens":{"input":7548,"output":196,"reasoning":234,"cache":{"read":33024,"write":0}}}}
