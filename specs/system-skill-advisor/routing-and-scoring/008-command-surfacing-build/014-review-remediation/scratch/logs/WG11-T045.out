{"type":"tool_use","timestamp":1794559037559,"sessionID":"ses_e2bf2816cffeGpkXLORrbflLE9","part":{"partID":"prt_1d40dcef8001VU3EAsHM4CZYNW","sessionID":"ses_e2bf2816cffeGpkXLORrbflLE9","messageID":"msg_1d40dc062001ULfxASZFWnRD2I","type":"tool","id":"call_4cd68cf143f64d6099358490","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/dsh.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/dsh.mjs, lines 1-333\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: DeepSeek Harness Session Log Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // The harness writes a session log under a project key that collapses path\n5: // separators, so two projects can share one directory name. The session id is\n6: // the directory name and the log's own header is checked against both the id\n7: // and the caller's cwd before any event becomes an entry. Logs may be written\n8: // as a chain of Zstandard frames, one per append batch.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: import { readFileSync, readdirSync, statSync } from 'node:fs';\n15: import { join } from 'node:path';\n16: import { zstdDecompressSync } from 'node:zlib';\n17: import {\n18:   envOf,\n19:   homeDir,\n20:   isSafeSessionId,\n21:   resolveInside,\n22:   samePath,\n23: } from './identity.mjs';\n24: import {\n25:   contentText,\n26:   parseJsonObject,\n27:   textBlock,\n28:   thinkingBlock,\n29:   toolCallBlock,\n30: } from './project.mjs';\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 2. CONSTANTS\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: const RUNTIME = 'dsh';\n37: const LOCATOR_KIND = 'session_log';\n38: const OPERATOR_SOURCE = 'user';\n39: const SESSION_LOG_NAME = /^session(?:\\.v([1-9]\\d*))?\\.jsonl(\\.zstd)?$/;\n40: \n41: const ZSTD_FRAME_MAGIC = 0xfd2fb528;\n42: const SKIPPABLE_MAGIC_MASK = 0xfffffff0;\n43: const SKIPPABLE_MAGIC = 0x184d2a50;\n44: \n45: // ─────────────────────────────────────────────────────────────────────────────\n46: // 3. LOG DECODING\n47: // ─────────────────────────────────────────────────────────────────────────────\n48: \n49: // Length of one Zstandard frame from its header and block headers (RFC 8878\n50: // §3.1.1). Node decodes only the first frame of a buffer, so the frames are cut\n51: // out and decoded one by one.\n52: function zstdFrameLength(buffer, start) {\n53:   let offset = start + 4;\n54:   const descriptor = buffer[offset];\n55:   if (descriptor === undefined) throw new Error('truncated Zstandard frame header');\n56:   offset += 1;\n57: \n58:   const contentSizeFlag = descriptor >> 6;\n59:   const singleSegment = (descriptor >> 5) & 1;\n60:   const hasChecksum = (descriptor >> 2) & 1;\n61:   const dictionaryIdFlag = descriptor & 3;\n62:   if (!singleSegment) offset += 1;\n63:   offset += [0, 1, 2, 4][dictionaryIdFlag];\n64:   offset += [singleSegment ? 1 : 0, 2, 4, 8][contentSizeFlag];\n65: \n66:   for (;;) {\n67:     if (offset + 3 > buffer.length) throw new Error('truncated Zstandard block header');\n68:     const header = buffer[offset] | (buffer[offset + 1] << 8) | (buffer[offset + 2] << 16);\n69:     offset += 3;\n70:     const lastBlock = header & 1;\n71:     const blockType = (header >> 1) & 3;\n72:     const blockSize = header >>> 3;\n73:     if (blockType === 3) throw new Error('reserved Zstandard block type');\n74:     offset += blockType === 1 ? 1 : blockSize;\n75:     if (lastBlock) break;\n76:   }\n77:   if (hasChecksum) offset += 4;\n78:   if (offset > buffer.length) throw new Error('truncated Zstandard frame');\n79:   return offset - start;\n80: }\n81: \n82: export function decodeSessionLog(buffer, fileName) {\n83:   if (!fileName.endsWith('.zstd')) return buffer.toString('utf8');\n84: \n85:   const parts = [];\n86:   let offset = 0;\n87:   while (offset + 4 <= buffer.length) {\n88:     const magic = buffer.readUInt32LE(offset);\n89:     if ((magic & SKIPPABLE_MAGIC_MASK) >>> 0 === SKIPPABLE_MAGIC) {\n90:       if (offset + 8 > buffer.length) throw new Error('truncated skippable frame');\n91:       offset += 8 + buffer.readUInt32LE(offset + 4);\n92:       continue;\n93:     }\n94:     if (magic !== ZSTD_FRAME_MAGIC) throw new Error(`unknown frame at byte ${offset}`);\n95:     const length = zstdFrameLength(buffer, offset);\n96:     parts.push(zstdDecompressSync(buffer.subarray(offset, offset + length)));\n97:     offset += length;\n98:   }\n99:   return Buffer.concat(parts).toString('utf8');\n100: }\n101: \n102: function parseEvents(text) {\n103:   const events = [];\n104:   for (const line of text.split('\\n')) {\n105:     if (!line.trim()) continue;\n106:     const parsed = parseJsonObject(line);\n107:     if (parsed) events.push(parsed);\n108:   }\n109:   return events;\n110: }\n111: \n112: // ─────────────────────────────────────────────────────────────────────────────\n113: // 4. STORE\n114: // ─────────────────────────────────────────────────────────────────────────────\n115: \n116: export function dshStoreRoot(options = {}) {\n117:   if (options.dshRoot) return options.dshRoot;\n118:   return join(envOf(options).DSH_HOME || join(homeDir(options), '.dsh'), 'sessions');\n119: }\n120: \n121: // The harness's own project-directory key: separators collapse to one `-`, and\n122: // any other unsafe code unit becomes a `~XXXX` escape.\n123: export function dshProjectKey(cwd) {\n124:   let readable = '';\n125:   let separatorRun = false;\n126:   for (let index = 0; index < cwd.length; index += 1) {\n127:     const code = cwd.charCodeAt(index);\n128:     const ch = String.fromCharCode(code);\n129:     if (ch === '/' || ch === '\\\\' || ch === ':') {\n130:       if (!separatorRun) readable += '-';\n131:       separatorRun = true;\n132:     } else if (ch !== '~' && /^[A-Za-z0-9._-]$/.test(ch)) {\n133:       readable += ch;\n134:       separatorRun = false;\n135:     } else {\n136:       readable += '~' + code.toString(16).toUpperCase().padStart(4, '0');\n137:       separatorRun = false;\n138:     }\n139:   }\n140:   return `--${(readable.replace(/^-+/, '') || 'root').slice(0, 251)}--`;\n141: }\n142: \n143: function sessionLogIn(directory) {\n144:   let best = null;\n145:   for (const fileName of readdirSync(directory)) {\n146:     const match = SESSION_LOG_NAME.exec(fileName);\n147:     if (!match) continue;\n148:     const version = Number(match[1] ?? 0);\n149:     if (!best || version > best.version) best = { version, path: join(directory, fileName) };\n150:   }\n151:   return best?.path ?? null;\n152: }\n153: \n154: // ─────────────────────────────────────────────────────────────────────────────\n155: // 5. ENTRY MAPPING\n156: // ─────────────────────────────────────────────────────────────────────────────\n157: \n158: function assistantBlocks(content) {\n159:   const blocks = [];\n160:   for (const item of Array.isArray(content) ? content : []) {\n161:     if (!item || typeof item !== 'object') continue;\n162:     if (item.type === 'text' && typeof item.text === 'string') {\n163:       blocks.push(textBlock(item.text));\n164:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n165:       blocks.push(thinkingBlock(item.thinking));\n166:     } else if (item.type === 'tool-call' && typeof item.id === 'string' && typeof item.name === 'string') {\n167:       blocks.push(toolCallBlock({\n168:         id: item.id,\n169:         name: item.name,\n170:         arguments: parseJsonObject(item.arguments) ?? item.arguments,\n171:       }));\n172:     }\n173:   }\n174:   return blocks;\n175: }\n176: \n177: function recordsFromEvents(events) {\n178:   const records = [];\n179:   const seenIds = new Set();\n180:   const keepFirst = (record) => {\n181:     // A compaction prune re-emits a shortened tool result under the same\n182:     // message id. The first copy holds the full output, which is what a\n183:     // lookup after compaction is for, so a repeated id is dropped.\n184:     if (seenIds.has(record.id)) return;\n185:     seenIds.add(record.id);\n186:     records.push(record);\n187:   };\n188: \n189:   events.forEach((event, index) => {\n190:     const data = event?.data;\n191:     if (!data || typeof data !== 'object') return;\n192:     // DSH stamps each event with `time` in epoch milliseconds.\n193:     const timestamp = event.time ?? event.timestamp ?? data.timestamp;\n194: \n195:     if (event.type === 'user/message' && data.source?.kind === OPERATOR_SOURCE) {\n196:       // Injected notices carry a non-operator source kind, so this text is\n197:       // operator content even when it opens with '<'.\n198:       const text = contentText(data.content);\n199:       if (!text) return;\n200:       keepFirst({\n201:         id: String(data.id ?? `dsh-user-${index}`).slice(0, 128),\n202:         role: 'user',\n203:         timestamp,\n204:         content: [textBlock(text)],\n205:       });\n206:       return;\n207:     }\n208: \n209:     if (event.type === 'assistant/message') {\n210:       const message = data.message;\n211:       const blocks = assistantBlocks(message?.content);\n212:       if (blocks.length === 0) return;\n213:       keepFirst({\n214:         id: String(message?.id ?? data.id ?? `dsh-assistant-${index}`).slice(0, 128),\n215:         role: 'assistant',\n216:         timestamp,\n217:         content: blocks,\n218:       });\n219:       return;\n220:     }\n221: \n222:     if (event.type === 'tool/result') {\n223:       const message = data.message;\n224:       if (typeof message?.toolCallId !== 'string' || !message.toolCallId) return;\n225:       const text = contentText(message.content);\n226:       const record = {\n227:         id: String(message.id ?? `dsh-result-${index}`).slice(0, 128),\n228:         role: 'toolResult',\n229:         timestamp,\n230:         content: [textBlock(text)],\n231:         toolCallId: message.toolCallId,\n232:       };\n233:       if (message.isError === true) record.isError = true;\n234:       keepFirst(record);\n235:     }\n236:   });\n237: \n238:   return records;\n239: }\n240: \n241: // A hook notice arrives as a user-role message whose source is not the operator.\n242: // It never becomes a record, because the operator did not write it, and the text\n243: // is kept here so a caller can still tell what the harness put into the turn.\n244: function injectedFromEvents(events) {\n245:   const injected = [];\n246:   for (const event of events) {\n247:     if (event?.type !== 'user/message') continue;\n248:     const data = event.data;\n249:     if (!data || typeof data !== 'object') continue;\n250:     if (data.source?.kind === OPERATOR_SOURCE) continue;\n251:     const text = contentText(data.content);\n252:     if (!text) continue;\n253:     injected.push({ source: data.source?.kind ?? 'unknown', text });\n254:   }\n255:   return injected;\n256: }\n257: \n258: // ─────────────────────────────────────────────────────────────────────────────\n259: // 6. LOADER\n260: // ─────────────────────────────────────────────────────────────────────────────\n261: \n262: export function loadDshSession({ sessionId, projectDir, sessionPath, ...options } = {}) {\n263:   if (!isSafeSessionId(sessionId)) {\n264:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n265:   }\n266:   if (typeof projectDir !== 'string' || !projectDir.trim()) {\n267:     return { ok: false, code: 'locator_unavailable' };\n268:   }\n269: \n270:   const root = dshStoreRoot(options);\n271:   let logPath = sessionPath;\n272: \n273:   if (!logPath) {\n274:     const projectRoot = join(root, dshProjectKey(projectDir));\n275:     try {\n276:       statSync(root);\n277:     } catch {\n278:       return { ok: false, code: 'store_unreadable' };\n279:     }\n280:     try {\n281:       statSync(projectRoot);\n282:     } catch {\n283:       return { ok: false, code: 'session_not_found' };\n284:     }\n285: \n286:     // The session directory is named by the exact id, so a newer decoy session\n287:     // is never opened while the requested one is missing.\n288:     const sessionDirectory = join(projectRoot, sessionId);\n289:     try {\n290:       statSync(sessionDirectory);\n291:     } catch {\n292:       return { ok: false, code: 'session_not_found' };\n293:     }\n294:     try {\n295:       logPath = sessionLogIn(sessionDirectory);\n296:     } catch {\n297:       return { ok: false, code: 'store_unreadable' };\n298:     }\n299:     if (!logPath) return { ok: false, code: 'session_not_found' };\n300:   }\n301: \n302:   // Containment is decided before the file is opened, so a path outside the\n303:   // store is refused without its content ever being read.\n304:   const containment = resolveInside({ path: logPath, root });\n305:   if (!containment.ok) return containment;\n306:   const storePath = containment.path;\n307: \n308:   let events;\n309:   try {\n310:     events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n311:   } catch {\n312:     return { ok: false, code: 'store_unreadable' };\n313:   }\n314: \n315:   const header = events[0]?.type === 'session' ? events[0] : null;\n316:   if (typeof header?.id !== 'string' || !header.id) {\n317:     return { ok: false, code: 'store_unreadable' };\n318:   }\n319:   if (header.id !== sessionId) return { ok: false, code: 'session_mismatch' };\n320:   if (!samePath(header.cwd, projectDir)) return { ok: false, code: 'session_mismatch' };\n321: \n322:   return {\n323:     ok: true,\n324:     source: {\n325:       runtime: RUNTIME,\n326:       sessionId,\n327:       locatorKind: LOCATOR_KIND,\n328:       storePath,\n329:     },\n330:     records: recordsFromEvents(events),\n331:     injected: injectedFromEvents(events),\n332:   };\n333: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/dsh.mjs, lines 1-333\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: DeepSeek Harness Session Log Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // The harness writes a session log under a project key that collapses path\n5: // separators, so two projects can share one directory name. The session id is\n6: // the directory name and the log's own header is checked against both the id\n7: // and the caller's cwd before any event becomes an entry. Logs may be written\n8: // as a chain of Zstandard frames, one per append batch.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: import { readFileSync, readdirSync, statSync } from 'node:fs';\n15: import { join } from 'node:path';\n16: import { zstdDecompressSync } from 'node:zlib';\n17: import {\n18:   envOf,\n19:   homeDir,\n20:   isSafeSessionId,\n21:   resolveInside,\n22:   samePath,\n23: } from './identity.mjs';\n24: import {\n25:   contentText,\n26:   parseJsonObject,\n27:   textBlock,\n28:   thinkingBlock,\n29:   toolCallBlock,\n30: } from './project.mjs';\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 2. CONSTANTS\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: const RUNTIME = 'dsh';\n37: const LOCATOR_KIND = 'session_log';\n38: const OPERATOR_SOURCE = 'user';\n39: const SESSION_LOG_NAME = /^session(?:\\.v([1-9]\\d*))?\\.jsonl(\\.zstd)?$/;\n40: \n41: const ZSTD_FRAME_MAGIC = 0xfd2fb528;\n42: const SKIPPABLE_MAGIC_MASK = 0xfffffff0;\n43: const SKIPPABLE_MAGIC = 0x184d2a50;\n44: \n45: // ─────────────────────────────────────────────────────────────────────────────\n46: // 3. LOG DECODING\n47: // ─────────────────────────────────────────────────────────────────────────────\n48: \n49: // Length of one Zstandard frame from its header and block headers (RFC 8878\n50: // §3.1.1). Node decodes only the first frame of a buffer, so the frames are cut\n51: // out and decoded one by one.\n52: function zstdFrameLength(buffer, start) {\n53:   let offset = start + 4;\n54:   const descriptor = buffer[offset];\n55:   if (descriptor === undefined) throw new Error('truncated Zstandard frame header');\n56:   offset += 1;\n57: \n58:   const contentSizeFlag = descriptor >> 6;\n59:   const singleSegment = (descriptor >> 5) & 1;\n60:   const hasChecksum = (descriptor >> 2) & 1;\n61:   const dictionaryIdFlag = descriptor & 3;\n62:   if (!singleSegment) offset += 1;\n63:   offset += [0, 1, 2, 4][dictionaryIdFlag];\n64:   offset += [singleSegment ? 1 : 0, 2, 4, 8][contentSizeFlag];\n65: \n66:   for (;;) {\n67:     if (offset + 3 > buffer.length) throw new Error('truncated Zstandard block header');\n68:     const header = buffer[offset] | (buffer[offset + 1] << 8) | (buffer[offset + 2] << 16);\n69:     offset += 3;\n70:     const lastBlock = header & 1;\n71:     const blockType = (header >> 1) & 3;\n72:     const blockSize = header >>> 3;\n73:     if (blockType === 3) throw new Error('reserved Zstandard block type');\n74:     offset += blockType === 1 ? 1 : blockSize;\n75:     if (lastBlock) break;\n76:   }\n77:   if (hasChecksum) offset += 4;\n78:   if (offset > buffer.length) throw new Error('truncated Zstandard frame');\n79:   return offset - start;\n80: }\n81: \n82: export function decodeSessionLog(buffer, fileName) {\n83:   if (!fileName.endsWith('.zstd')) return buffer.toString('utf8');\n84: \n85:   const parts = [];\n86:   let offset = 0;\n87:   while (offset + 4 <= buffer.length) {\n88:     const magic = buffer.readUInt32LE(offset);\n89:     if ((magic & SKIPPABLE_MAGIC_MASK) >>> 0 === SKIPPABLE_MAGIC) {\n90:       if (offset + 8 > buffer.length) throw new Error('truncated skippable frame');\n91:       offset += 8 + buffer.readUInt32LE(offset + 4);\n92:       continue;\n93:     }\n94:     if (magic !== ZSTD_FRAME_MAGIC) throw new Error(`unknown frame at byte ${offset}`);\n95:     const length = zstdFrameLength(buffer, offset);\n96:     parts.push(zstdDecompressSync(buffer.subarray(offset, offset + length)));\n97:     offset += length;\n98:   }\n99:   return Buffer.concat(parts).toString('utf8');\n100: }\n101: \n102: function parseEvents(text) {\n103:   const events = [];\n104:   for (const line of text.split('\\n')) {\n105:     if (!line.trim()) continue;\n106:     const parsed = parseJsonObject(line);\n107:     if (parsed) events.push(parsed);\n108:   }\n109:   return events;\n110: }\n111: \n112: // ─────────────────────────────────────────────────────────────────────────────\n113: // 4. STORE\n114: // ─────────────────────────────────────────────────────────────────────────────\n115: \n116: export function dshStoreRoot(options = {}) {\n117:   if (options.dshRoot) return options.dshRoot;\n118:   return join(envOf(options).DSH_HOME || join(homeDir(options), '.dsh'), 'sessions');\n119: }\n120: \n121: // The harness's own project-directory key: separators collapse to one `-`, and\n122: // any other unsafe code unit becomes a `~XXXX` escape.\n123: export function dshProjectKey(cwd) {\n124:   let readable = '';\n125:   let separatorRun = false;\n126:   for (let index = 0; index < cwd.length; index += 1) {\n127:     const code = cwd.charCodeAt(index);\n128:     const ch = String.fromCharCode(code);\n129:     if (ch === '/' || ch === '\\\\' || ch === ':') {\n130:       if (!separatorRun) readable += '-';\n131:       separatorRun = true;\n132:     } else if (ch !== '~' && /^[A-Za-z0-9._-]$/.test(ch)) {\n133:       readable += ch;\n134:       separatorRun = false;\n135:     } else {\n136:       readable += '~' + code.toString(16).toUpperCase().padStart(4, '0');\n137:       separatorRun = false;\n138:     }\n139:   }\n140:   return `--${(readable.replace(/^-+/, '') || 'root').slice(0, 251)}--`;\n141: }\n142: \n143: function sessionLogIn(directory) {\n144:   let best = null;\n145:   for (const fileName of readdirSync(directory)) {\n146:     const match = SESSION_LOG_NAME.exec(fileName);\n147:     if (!match) continue;\n148:     const version = Number(match[1] ?? 0);\n149:     if (!best || version > best.version) best = { version, path: join(directory, fileName) };\n150:   }\n151:   return best?.path ?? null;\n152: }\n153: \n154: // ─────────────────────────────────────────────────────────────────────────────\n155: // 5. ENTRY MAPPING\n156: // ─────────────────────────────────────────────────────────────────────────────\n157: \n158: function assistantBlocks(content) {\n159:   const blocks = [];\n160:   for (const item of Array.isArray(content) ? content : []) {\n161:     if (!item || typeof item !== 'object') continue;\n162:     if (item.type === 'text' && typeof item.text === 'string') {\n163:       blocks.push(textBlock(item.text));\n164:     } else if (item.type === 'thinking' && typeof item.thinking === 'string') {\n165:       blocks.push(thinkingBlock(item.thinking));\n166:     } else if (item.type === 'tool-call' && typeof item.id === 'string' && typeof item.name === 'string') {\n167:       blocks.push(toolCallBlock({\n168:         id: item.id,\n169:         name: item.name,\n170:         arguments: parseJsonObject(item.arguments) ?? item.arguments,\n171:       }));\n172:     }\n173:   }\n174:   return blocks;\n175: }\n176: \n177: function recordsFromEvents(events) {\n178:   const records = [];\n179:   const seenIds = new Set();\n180:   const keepFirst = (record) => {\n181:     // A compaction prune re-emits a shortened tool result under the same\n182:     // message id. The first copy holds the full output, which is what a\n183:     // lookup after compaction is for, so a repeated id is dropped.\n184:     if (seenIds.has(record.id)) return;\n185:     seenIds.add(record.id);\n186:     records.push(record);\n187:   };\n188: \n189:   events.forEach((event, index) => {\n190:     const data = event?.data;\n191:     if (!data || typeof data !== 'object') return;\n192:     // DSH stamps each event with `time` in epoch milliseconds.\n193:     const timestamp = event.time ?? event.timestamp ?? data.timestamp;\n194: \n195:     if (event.type === 'user/message' && data.source?.kind === OPERATOR_SOURCE) {\n196:       // Injected notices carry a non-operator source kind, so this text is\n197:       // operator content even when it opens with '<'.\n198:       const text = contentText(data.content);\n199:       if (!text) return;\n200:       keepFirst({\n201:         id: String(data.id ?? `dsh-user-${index}`).slice(0, 128),\n202:         role: 'user',\n203:         timestamp,\n204:         content: [textBlock(text)],\n205:       });\n206:       return;\n207:     }\n208: \n209:     if (event.type === 'assistant/message') {\n210:       const message = data.message;\n211:       const blocks = assistantBlocks(message?.content);\n212:       if (blocks.length === 0) return;\n213:       keepFirst({\n214:         id: String(message?.id ?? data.id ?? `dsh-assistant-${index}`).slice(0, 128),\n215:         role: 'assistant',\n216:         timestamp,\n217:         content: blocks,\n218:       });\n219:       return;\n220:     }\n221: \n222:     if (event.type === 'tool/result') {\n223:       const message = data.message;\n224:       if (typeof message?.toolCallId !== 'string' || !message.toolCallId) return;\n225:       const text = contentText(message.content);\n226:       const record = {\n227:         id: String(message.id ?? `dsh-result-${index}`).slice(0, 128),\n228:         role: 'toolResult',\n229:         timestamp,\n230:         content: [textBlock(text)],\n231:         toolCallId: message.toolCallId,\n232:       };\n233:       if (message.isError === true) record.isError = true;\n234:       keepFirst(record);\n235:     }\n236:   });\n237: \n238:   return records;\n239: }\n240: \n241: // A hook notice arrives as a user-role message whose source is not the operator.\n242: // It never becomes a record, because the operator did not write it, and the text\n243: // is kept here so a caller can still tell what the harness put into the turn.\n244: function injectedFromEvents(events) {\n245:   const injected = [];\n246:   for (const event of events) {\n247:     if (event?.type !== 'user/message') continue;\n248:     const data = event.data;\n249:     if (!data || typeof data !== 'object') continue;\n250:     if (data.source?.kind === OPERATOR_SOURCE) continue;\n251:     const text = contentText(data.content);\n252:     if (!text) continue;\n253:     injected.push({ source: data.source?.kind ?? 'unknown', text });\n254:   }\n255:   return injected;\n256: }\n257: \n258: // ─────────────────────────────────────────────────────────────────────────────\n259: // 6. LOADER\n260: // ─────────────────────────────────────────────────────────────────────────────\n261: \n262: export function loadDshSession({ sessionId, projectDir, sessionPath, ...options } = {}) {\n263:   if (!isSafeSessionId(sessionId)) {\n264:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n265:   }\n266:   if (typeof projectDir !== 'string' || !projectDir.trim()) {\n267:     return { ok: false, code: 'locator_unavailable' };\n268:   }\n269: \n270:   const root = dshStoreRoot(options);\n271:   let logPath = sessionPath;\n272: \n273:   if (!logPath) {\n274:     const projectRoot = join(root, dshProjectKey(projectDir));\n275:     try {\n276:       statSync(root);\n277:     } catch {\n278:       return { ok: false, code: 'store_unreadable' };\n279:     }\n280:     try {\n281:       statSync(projectRoot);\n282:     } catch {\n283:       return { ok: false, code: 'session_not_found' };\n284:     }\n285: \n286:     // The session directory is named by the exact id, so a newer decoy session\n287:     // is never opened while the requested one is missing.\n288:     const sessionDirectory = join(projectRoot, sessionId);\n289:     try {\n290:       statSync(sessionDirectory);\n291:     } catch {\n292:       return { ok: false, code: 'session_not_found' };\n293:     }\n294:     try {\n295:       logPath = sessionLogIn(sessionDirectory);\n296:     } catch {\n297:       return { ok: false, code: 'store_unreadable' };\n298:     }\n299:     if (!logPath) return { ok: false, code: 'session_not_found' };\n300:   }\n301: \n302:   // Containment is decided before the file is opened, so a path outside the\n303:   // store is refused without its content ever being read.\n304:   const containment = resolveInside({ path: logPath, root });\n305:   if (!containment.ok) return containment;\n306:   const storePath = containment.path;\n307: \n308:   let events;\n309:   try {\n310:     events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n311:   } catch {\n312:     return { ok: false, code: 'store_unreadable' };\n313:   }\n314: \n315:   const header = events[0]?.type === 'session' ? events[0] : null;\n316:   if (typeof header?.id !== 'string' || !header.id) {\n317:     return { ok: false, code: 'store_unreadable' };\n318:   }\n319:   if (header.id !== sessionId) return { ok: false, code: 'session_mismatch' };\n320:   if (!samePath(header.cwd, projectDir)) return { ok: false, code: 'session_mismatch' };\n321: \n322:   return {\n323:     ok: true,\n324:     source: {\n325:       runtime: RUNTIME,\n326:       sessionId,\n327:       locatorKind: LOCATOR_KIND,\n328:       storePath,\n329:     },\n330:     records: recordsFromEvents(events),\n331:     injected: injectedFromEvents(events),\n332:   };\n333: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/dsh.mjs\"}"},"time":{"start":1794559037176,"end":1794559037559}}}}
{"type":"tool_use","timestamp":1794559037563,"sessionID":"ses_e2bf2816cffeGpkXLORrbflLE9","part":{"partID":"prt_1d40dcd99001EVI60haHwsJw4q","sessionID":"ses_e2bf2816cffeGpkXLORrbflLE9","messageID":"msg_1d40dc062001ULfxASZFWnRD2I","type":"tool","id":"call_6c6bd3e0d9a341db82e5a845","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/devin.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/devin.mjs, lines 1-458\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Devin CLI Session Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // Devin writes its history to a SQLite sessions database, with one row per\n5: // session and one message row per node of that session's conversation tree.\n6: // Older builds named a JSON transcript after the session instead, so the file\n7: // remains a fallback for a store that has no database record. A read is accepted\n8: // only when the session's own row agrees with the request and its recorded\n9: // working directory is the caller's project; either disagreement means the\n10: // record describes another session.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: import { createRequire } from 'node:module';\n17: import { existsSync, readFileSync, statSync } from 'node:fs';\n18: import { join } from 'node:path';\n19: import {\n20:   envOf,\n21:   homeDir,\n22:   isSafeSessionId,\n23:   resolveInside,\n24:   atOrBelow,\n25:   samePath,\n26: } from './identity.mjs';\n27: import {\n28:   isoOr,\n29:   parseJsonObject,\n30:   textBlock,\n31:   toolCallBlock,\n32: } from './project.mjs';\n33: \n34: const require = createRequire(import.meta.url);\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const RUNTIME = 'devin';\n41: const DATABASE_LOCATOR_KIND = 'session_id';\n42: const TRANSCRIPT_LOCATOR_KIND = 'transcript_file';\n43: const DATABASE_FILE = 'sessions.db';\n44: const TRANSCRIPT_EXT = '.json';\n45: \n46: // ─────────────────────────────────────────────────────────────────────────────\n47: // 3. STORE\n48: // ─────────────────────────────────────────────────────────────────────────────\n49: \n50: export function devinDataDirectory(options = {}) {\n51:   if (options.devinDataHome) return options.devinDataHome;\n52:   const dataHome = envOf(options).XDG_DATA_HOME || join(homeDir(options), '.local', 'share');\n53:   return join(dataHome, 'devin', 'cli');\n54: }\n55: \n56: export function devinTranscriptRoot(options = {}) {\n57:   return join(devinDataDirectory(options), 'transcripts');\n58: }\n59: \n60: export function devinDatabasePath(options = {}) {\n61:   return options.dbPath ?? join(devinDataDirectory(options), DATABASE_FILE);\n62: }\n63: \n64: function openDatabase(dbPath) {\n65:   const { DatabaseSync } = require('node:sqlite');\n66:   return new DatabaseSync(dbPath, { readOnly: true });\n67: }\n68: \n69: function tableColumns(database, table) {\n70:   return new Set(database.prepare(`PRAGMA table_info('${table}')`).all().map((row) => row.name));\n71: }\n72: \n73: function sessionRow(database, sessionId) {\n74:   const columns = tableColumns(database, 'sessions');\n75:   if (!columns.has('id')) return null;\n76: \n77:   // A store that predates a column still names the session, so each optional\n78:   // column is selected only when the table has it.\n79:   const selected = ['id'];\n80:   for (const name of ['working_directory', 'main_chain_id']) {\n81:     if (columns.has(name)) selected.push(name);\n82:   }\n83: \n84:   const row = database.prepare(`SELECT ${selected.join(', ')} FROM sessions WHERE id = ?`).get(sessionId);\n85:   return row && row.id === sessionId ? row : null;\n86: }\n87: \n88: // ─────────────────────────────────────────────────────────────────────────────\n89: // 4. DATABASE PROJECTION\n90: // ─────────────────────────────────────────────────────────────────────────────\n91: \n92: function nodeTimestamp(node, message) {\n93:   const recorded = message.metadata?.created_at;\n94:   if (recorded !== undefined && recorded !== null) return isoOr(recorded);\n95:   // The node clock is stored in whole seconds, while the shared normalizer\n96:   // expects milliseconds.\n97:   return isoOr(typeof node.created_at === 'number' ? node.created_at * 1000 : undefined);\n98: }\n99: \n100: function nodeIdentifier(node, message) {\n101:   const stored = typeof message.message_id === 'string' && message.message_id\n102:     ? message.message_id\n103:     : String(node.node_id);\n104:   return `devin-${stored}`.slice(0, 128);\n105: }\n106: \n107: // The message store is a forest: every request re-records the prompt it was\n108: // built from, so a plain row scan would repeat messages. The session's main\n109: // chain names the live path, and walking it back to its root yields each node\n110: // once in conversation order.\n111: function chainFromHead(nodes, headId) {\n112:   if (headId == null) return null;\n113: \n114:   const byNodeId = new Map(nodes.map((node) => [node.node_id, node]));\n115:   const chain = [];\n116:   const seen = new Set();\n117:   let cursor = byNodeId.get(headId);\n118: \n119:   while (cursor) {\n120:     if (seen.has(cursor.node_id)) return null;\n121:     seen.add(cursor.node_id);\n122:     chain.push(cursor);\n123: \n124:     if (cursor.parent_node_id == null) break;\n125:     const parent = byNodeId.get(cursor.parent_node_id);\n126:     if (!parent) return null;\n127:     cursor = parent;\n128:   }\n129: \n130:   return chain.reverse();\n131: }\n132: \n133: function recordsFromChain(chain) {\n134:   const records = [];\n135: \n136:   for (const node of chain) {\n137:     const message = parseJsonObject(node.chat_message);\n138:     if (!message) continue;\n139: \n140:     const timestamp = nodeTimestamp(node, message);\n141:     const id = nodeIdentifier(node, message);\n142:     const text = typeof message.content === 'string' ? message.content : '';\n143: \n144:     if (message.role === 'user') {\n145:       // Synthetic prompt context is also stored as a user row; only content the\n146:       // operator typed carries the input flag, so an unflagged row is skipped.\n147:       const isInput = message.metadata?.is_user_input;\n148:       if (isInput !== true && isInput !== 1) continue;\n149:       if (!text) continue;\n150:       records.push({ id, role: 'user', timestamp, content: [textBlock(text)] });\n151:       continue;\n152:     }\n153: \n154:     if (message.role === 'assistant') {\n155:       const blocks = [];\n156:       if (text) blocks.push(textBlock(text));\n157:       for (const call of Array.isArray(message.tool_calls) ? message.tool_calls : []) {\n158:         if (typeof call?.id !== 'string' || typeof call.name !== 'string') continue;\n159:         blocks.push(toolCallBlock({\n160:           id: call.id,\n161:           name: call.name,\n162:           arguments: call.arguments,\n163:         }));\n164:       }\n165:       if (blocks.length > 0) {\n166:         records.push({ id, role: 'assistant', timestamp, content: blocks });\n167:       }\n168:       continue;\n169:     }\n170: \n171:     if (message.role === 'tool' && typeof message.tool_call_id === 'string') {\n172:       records.push({\n173:         id,\n174:         role: 'toolResult',\n175:         timestamp,\n176:         content: [textBlock(text)],\n177:         toolCallId: message.tool_call_id,\n178:       });\n179:     }\n180:   }\n181: \n182:   return records;\n183: }\n184: \n185: // A system node carries the harness context a compaction or a session start\n186: // injected. A user node without the input flag is prompt context the harness\n187: // wrote, not text the operator typed, so it is injected context too and never\n188: // a conversation record.\n189: function injectedFromChain(chain) {\n190:   const injected = [];\n191: \n192:   for (const node of chain) {\n193:     const message = parseJsonObject(node.chat_message);\n194:     if (!message) continue;\n195: \n196:     const text = typeof message.content === 'string' ? message.content : '';\n197:     if (!text) continue;\n198: \n199:     if (message.role === 'system') {\n200:       injected.push({ source: message.role, text });\n201:       continue;\n202:     }\n203: \n204:     if (message.role === 'user') {\n205:       const isInput = message.metadata?.is_user_input;\n206:       if (isInput === true || isInput === 1) continue;\n207:       injected.push({ source: 'unflagged-user', text });\n208:     }\n209:   }\n210: \n211:   return injected;\n212: }\n213: \n214: function summarizedFrom(node) {\n215:   const value = parseJsonObject(node.metadata)?.summarized_from;\n216:   return Number.isInteger(value) ? value : null;\n217: }\n218: \n219: // A compaction starts a new thread whose root has no parent, so the live chain\n220: // alone holds only the turns after it. The thread's continuation node names\n221: // the last node of the thread it summarized, and following that link back,\n222: // once per compaction, restores the turns the compaction dropped.\n223: function chainWithEarlierThreads(nodes, headId) {\n224:   const threads = [];\n225:   const visited = new Set();\n226:   let head = headId;\n227:   while (head != null) {\n228:     if (visited.has(head)) return null;\n229:     visited.add(head);\n230:     const thread = chainFromHead(nodes, head);\n231:     if (!thread) return null;\n232:     threads.unshift(thread);\n233:     const link = thread.find((node) => summarizedFrom(node) !== null);\n234:     head = link ? summarizedFrom(link) : null;\n235:   }\n236:   return threads.flat();\n237: }\n238: \n239: function recordsFromDatabase(database, sessionId, headId) {\n240:   const nodes = database\n241:     .prepare('SELECT node_id, parent_node_id, chat_message, metadata, created_at FROM message_nodes WHERE session_id = ? ORDER BY node_id')\n242:     .all(sessionId);\n243: \n244:   if (nodes.length === 0) return { records: [], injected: [] };\n245: \n246:   const chain = chainWithEarlierThreads(nodes, headId);\n247:   return chain ? { records: recordsFromChain(chain), injected: injectedFromChain(chain) } : null;\n248: }\n249: \n250: // ─────────────────────────────────────────────────────────────────────────────\n251: // 5. TRANSCRIPT MAPPING\n252: // ─────────────────────────────────────────────────────────────────────────────\n253: \n254: function recordsFromSteps(steps) {\n255:   const records = [];\n256: \n257:   steps.forEach((step, stepIndex) => {\n258:     if (!step || typeof step !== 'object') return;\n259:     const stepId = step.step_id ?? stepIndex;\n260:     const timestamp = step.timestamp;\n261:     const message = typeof step.message === 'string' ? step.message : '';\n262: \n263:     if (step.source === 'user') {\n264:       // Harness and system content arrives under a different `source` value, so\n265:       // a user step is operator content even when it opens with '<'.\n266:       if (!message) return;\n267:       records.push({\n268:         id: `devin-${stepId}`.slice(0, 128),\n269:         role: 'user',\n270:         timestamp,\n271:         content: [textBlock(message)],\n272:       });\n273:       return;\n274:     }\n275: \n276:     if (step.source !== 'agent') return;\n277: \n278:     const toolCalls = Array.isArray(step.tool_calls) ? step.tool_calls : [];\n279:     const blocks = [];\n280:     if (message) blocks.push(textBlock(message));\n281:     for (const call of toolCalls) {\n282:       if (typeof call?.tool_call_id !== 'string' || typeof call.function_name !== 'string') continue;\n283:       blocks.push(toolCallBlock({\n284:         id: call.tool_call_id,\n285:         name: call.function_name,\n286:         arguments: call.arguments,\n287:       }));\n288:     }\n289:     if (blocks.length > 0) {\n290:       records.push({\n291:         id: `devin-${stepId}`.slice(0, 128),\n292:         role: 'assistant',\n293:         timestamp,\n294:         content: blocks,\n295:       });\n296:     }\n297: \n298:     const results = Array.isArray(step.observation?.results) ? step.observation.results : [];\n299:     results.forEach((result, resultIndex) => {\n300:       if (typeof result?.source_call_id !== 'string') return;\n301:       const content = typeof result.content === 'string' ? result.content : '';\n302:       records.push({\n303:         id: `devin-${stepId}-result-${resultIndex}`.slice(0, 128),\n304:         role: 'toolResult',\n305:         timestamp,\n306:         content: [textBlock(content)],\n307:         toolCallId: result.source_call_id,\n308:       });\n309:     });\n310:   });\n311: \n312:   return records;\n313: }\n314: \n315: // Harness and system steps are not conversation records, but they are context\n316: // the next turn saw, kept apart so a caller can tell what the operator typed.\n317: function injectedFromSteps(steps) {\n318:   const injected = [];\n319: \n320:   for (const step of steps) {\n321:     if (!step || typeof step !== 'object') continue;\n322:     if (step.source === 'user' || step.source === 'agent') continue;\n323:     if (typeof step.message !== 'string' || !step.message) continue;\n324:     injected.push({ source: step.source, text: step.message });\n325:   }\n326: \n327:   return injected;\n328: }\n329: \n330: // ─────────────────────────────────────────────────────────────────────────────\n331: // 6. LOADER\n332: // ─────────────────────────────────────────────────────────────────────────────\n333: \n334: function loadTranscript(sessionId, dataDirectory, options) {\n335:   const root = devinTranscriptRoot(options);\n336:   const transcriptPath = options.transcriptPath ?? join(root, `${sessionId}${TRANSCRIPT_EXT}`);\n337: \n338:   // Containment is decided before the file is opened, so a path outside the\n339:   // store is refused without its content ever being read.\n340:   const containment = resolveInside({ path: transcriptPath, root });\n341:   if (!containment.ok) {\n342:     if (containment.code === 'session_mismatch') return containment;\n343:     try {\n344:       statSync(dataDirectory);\n345:       return { ok: false, code: 'session_not_found' };\n346:     } catch {\n347:       return { ok: false, code: 'store_unreadable' };\n348:     }\n349:   }\n350:   const storePath = containment.path;\n351: \n352:   let raw;\n353:   try {\n354:     raw = readFileSync(transcriptPath, 'utf8');\n355:   } catch {\n356:     try {\n357:       statSync(dataDirectory);\n358:       return { ok: false, code: 'session_not_found' };\n359:     } catch {\n360:       return { ok: false, code: 'store_unreadable' };\n361:     }\n362:   }\n363: \n364:   const transcript = parseJsonObject(raw);\n365:   if (!transcript) return { ok: false, code: 'store_unreadable' };\n366:   if (typeof transcript.session_id === 'string' && transcript.session_id !== sessionId) {\n367:     return { ok: false, code: 'session_mismatch' };\n368:   }\n369: \n370:   const steps = Array.isArray(transcript.steps) ? transcript.steps : [];\n371:   return {\n372:     ok: true,\n373:     source: {\n374:       runtime: RUNTIME,\n375:       sessionId,\n376:       locatorKind: TRANSCRIPT_LOCATOR_KIND,\n377:       storePath,\n378:     },\n379:     records: recordsFromSteps(steps),\n380:     injected: injectedFromSteps(steps),\n381:   };\n382: }\n383: \n384: export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n385:   if (!isSafeSessionId(sessionId)) {\n386:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n387:   }\n388:   if (typeof projectDir !== 'string' || !projectDir.trim()) {\n389:     return { ok: false, code: 'locator_unavailable' };\n390:   }\n391: \n392:   const dataDirectory = devinDataDirectory(options);\n393:   const dbPath = devinDatabasePath(options);\n394: \n395:   // A damaged or older database must not hide a transcript the store still\n396:   // holds, so a failure here falls back to the file. A transcript that also\n397:   // fails keeps the store unreadable.\n398:   const transcriptFallback = () => {\n399:     const transcript = loadTranscript(sessionId, dataDirectory, options);\n400:     return transcript.ok || transcript.code === 'session_mismatch'\n401:       ? transcript\n402:       : { ok: false, code: 'store_unreadable' };\n403:   };\n404: \n405:   if (existsSync(dbPath)) {\n406:     const dbContainment = resolveInside({ path: dbPath, root: dataDirectory });\n407:     if (!dbContainment.ok) return dbContainment;\n408: \n409:     let database;\n410:     try {\n411:       database = openDatabase(dbContainment.path);\n412:     } catch {\n413:       return transcriptFallback();\n414:     }\n415: \n416:     try {\n417:       const row = sessionRow(database, sessionId);\n418:       if (row) {\n419:         // Devin's hooks receive the project root, while the row records the\n420:         // folder the session ran in, which may sit below that root.\n421:         if (Object.hasOwn(row, 'working_directory') && !atOrBelow(row.working_directory, projectDir)) {\n422:           return { ok: false, code: 'session_mismatch' };\n423:         }\n424: \n425:         // An older store names its sessions but keeps their turns only in\n426:         // transcript files, so a database with no message rows for this\n427:         // session, or no chain head to walk, falls through.\n428:         if (tableColumns(database, 'message_nodes').size > 0) {\n429:           const projection = recordsFromDatabase(database, sessionId, row.main_chain_id);\n430:           if (!projection) return transcriptFallback();\n431: \n432:           const { records, injected } = projection;\n433:           if (records.length > 0) {\n434:             return {\n435:               ok: true,\n436:               source: {\n437:                 runtime: RUNTIME,\n438:                 sessionId,\n439:                 locatorKind: DATABASE_LOCATOR_KIND,\n440:                 storePath: dbContainment.path,\n441:               },\n442:               records,\n443:               injected,\n444:             };\n445:           }\n446:         }\n447:       }\n448:     } catch {\n449:       return transcriptFallback();\n450:     } finally {\n451:       database.close();\n452:     }\n453:   }\n454: \n455:   // The database has no turns for this id, so the store is either an older\n456:   // transcript-only install or a request for a session it never held.\n457:   return loadTranscript(sessionId, dataDirectory, options);\n458: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/devin.mjs, lines 1-458\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Devin CLI Session Reader\n3: // ───────────────────────────────────────────────────────────────────\n4: // Devin writes its history to a SQLite sessions database, with one row per\n5: // session and one message row per node of that session's conversation tree.\n6: // Older builds named a JSON transcript after the session instead, so the file\n7: // remains a fallback for a store that has no database record. A read is accepted\n8: // only when the session's own row agrees with the request and its recorded\n9: // working directory is the caller's project; either disagreement means the\n10: // record describes another session.\n11: \n12: // ─────────────────────────────────────────────────────────────────────────────\n13: // 1. IMPORTS\n14: // ─────────────────────────────────────────────────────────────────────────────\n15: \n16: import { createRequire } from 'node:module';\n17: import { existsSync, readFileSync, statSync } from 'node:fs';\n18: import { join } from 'node:path';\n19: import {\n20:   envOf,\n21:   homeDir,\n22:   isSafeSessionId,\n23:   resolveInside,\n24:   atOrBelow,\n25:   samePath,\n26: } from './identity.mjs';\n27: import {\n28:   isoOr,\n29:   parseJsonObject,\n30:   textBlock,\n31:   toolCallBlock,\n32: } from './project.mjs';\n33: \n34: const require = createRequire(import.meta.url);\n35: \n36: // ─────────────────────────────────────────────────────────────────────────────\n37: // 2. CONSTANTS\n38: // ─────────────────────────────────────────────────────────────────────────────\n39: \n40: const RUNTIME = 'devin';\n41: const DATABASE_LOCATOR_KIND = 'session_id';\n42: const TRANSCRIPT_LOCATOR_KIND = 'transcript_file';\n43: const DATABASE_FILE = 'sessions.db';\n44: const TRANSCRIPT_EXT = '.json';\n45: \n46: // ─────────────────────────────────────────────────────────────────────────────\n47: // 3. STORE\n48: // ─────────────────────────────────────────────────────────────────────────────\n49: \n50: export function devinDataDirectory(options = {}) {\n51:   if (options.devinDataHome) return options.devinDataHome;\n52:   const dataHome = envOf(options).XDG_DATA_HOME || join(homeDir(options), '.local', 'share');\n53:   return join(dataHome, 'devin', 'cli');\n54: }\n55: \n56: export function devinTranscriptRoot(options = {}) {\n57:   return join(devinDataDirectory(options), 'transcripts');\n58: }\n59: \n60: export function devinDatabasePath(options = {}) {\n61:   return options.dbPath ?? join(devinDataDirectory(options), DATABASE_FILE);\n62: }\n63: \n64: function openDatabase(dbPath) {\n65:   const { DatabaseSync } = require('node:sqlite');\n66:   return new DatabaseSync(dbPath, { readOnly: true });\n67: }\n68: \n69: function tableColumns(database, table) {\n70:   return new Set(database.prepare(`PRAGMA table_info('${table}')`).all().map((row) => row.name));\n71: }\n72: \n73: function sessionRow(database, sessionId) {\n74:   const columns = tableColumns(database, 'sessions');\n75:   if (!columns.has('id')) return null;\n76: \n77:   // A store that predates a column still names the session, so each optional\n78:   // column is selected only when the table has it.\n79:   const selected = ['id'];\n80:   for (const name of ['working_directory', 'main_chain_id']) {\n81:     if (columns.has(name)) selected.push(name);\n82:   }\n83: \n84:   const row = database.prepare(`SELECT ${selected.join(', ')} FROM sessions WHERE id = ?`).get(sessionId);\n85:   return row && row.id === sessionId ? row : null;\n86: }\n87: \n88: // ─────────────────────────────────────────────────────────────────────────────\n89: // 4. DATABASE PROJECTION\n90: // ─────────────────────────────────────────────────────────────────────────────\n91: \n92: function nodeTimestamp(node, message) {\n93:   const recorded = message.metadata?.created_at;\n94:   if (recorded !== undefined && recorded !== null) return isoOr(recorded);\n95:   // The node clock is stored in whole seconds, while the shared normalizer\n96:   // expects milliseconds.\n97:   return isoOr(typeof node.created_at === 'number' ? node.created_at * 1000 : undefined);\n98: }\n99: \n100: function nodeIdentifier(node, message) {\n101:   const stored = typeof message.message_id === 'string' && message.message_id\n102:     ? message.message_id\n103:     : String(node.node_id);\n104:   return `devin-${stored}`.slice(0, 128);\n105: }\n106: \n107: // The message store is a forest: every request re-records the prompt it was\n108: // built from, so a plain row scan would repeat messages. The session's main\n109: // chain names the live path, and walking it back to its root yields each node\n110: // once in conversation order.\n111: function chainFromHead(nodes, headId) {\n112:   if (headId == null) return null;\n113: \n114:   const byNodeId = new Map(nodes.map((node) => [node.node_id, node]));\n115:   const chain = [];\n116:   const seen = new Set();\n117:   let cursor = byNodeId.get(headId);\n118: \n119:   while (cursor) {\n120:     if (seen.has(cursor.node_id)) return null;\n121:     seen.add(cursor.node_id);\n122:     chain.push(cursor);\n123: \n124:     if (cursor.parent_node_id == null) break;\n125:     const parent = byNodeId.get(cursor.parent_node_id);\n126:     if (!parent) return null;\n127:     cursor = parent;\n128:   }\n129: \n130:   return chain.reverse();\n131: }\n132: \n133: function recordsFromChain(chain) {\n134:   const records = [];\n135: \n136:   for (const node of chain) {\n137:     const message = parseJsonObject(node.chat_message);\n138:     if (!message) continue;\n139: \n140:     const timestamp = nodeTimestamp(node, message);\n141:     const id = nodeIdentifier(node, message);\n142:     const text = typeof message.content === 'string' ? message.content : '';\n143: \n144:     if (message.role === 'user') {\n145:       // Synthetic prompt context is also stored as a user row; only content the\n146:       // operator typed carries the input flag, so an unflagged row is skipped.\n147:       const isInput = message.metadata?.is_user_input;\n148:       if (isInput !== true && isInput !== 1) continue;\n149:       if (!text) continue;\n150:       records.push({ id, role: 'user', timestamp, content: [textBlock(text)] });\n151:       continue;\n152:     }\n153: \n154:     if (message.role === 'assistant') {\n155:       const blocks = [];\n156:       if (text) blocks.push(textBlock(text));\n157:       for (const call of Array.isArray(message.tool_calls) ? message.tool_calls : []) {\n158:         if (typeof call?.id !== 'string' || typeof call.name !== 'string') continue;\n159:         blocks.push(toolCallBlock({\n160:           id: call.id,\n161:           name: call.name,\n162:           arguments: call.arguments,\n163:         }));\n164:       }\n165:       if (blocks.length > 0) {\n166:         records.push({ id, role: 'assistant', timestamp, content: blocks });\n167:       }\n168:       continue;\n169:     }\n170: \n171:     if (message.role === 'tool' && typeof message.tool_call_id === 'string') {\n172:       records.push({\n173:         id,\n174:         role: 'toolResult',\n175:         timestamp,\n176:         content: [textBlock(text)],\n177:         toolCallId: message.tool_call_id,\n178:       });\n179:     }\n180:   }\n181: \n182:   return records;\n183: }\n184: \n185: // A system node carries the harness context a compaction or a session start\n186: // injected. A user node without the input flag is prompt context the harness\n187: // wrote, not text the operator typed, so it is injected context too and never\n188: // a conversation record.\n189: function injectedFromChain(chain) {\n190:   const injected = [];\n191: \n192:   for (const node of chain) {\n193:     const message = parseJsonObject(node.chat_message);\n194:     if (!message) continue;\n195: \n196:     const text = typeof message.content === 'string' ? message.content : '';\n197:     if (!text) continue;\n198: \n199:     if (message.role === 'system') {\n200:       injected.push({ source: message.role, text });\n201:       continue;\n202:     }\n203: \n204:     if (message.role === 'user') {\n205:       const isInput = message.metadata?.is_user_input;\n206:       if (isInput === true || isInput === 1) continue;\n207:       injected.push({ source: 'unflagged-user', text });\n208:     }\n209:   }\n210: \n211:   return injected;\n212: }\n213: \n214: function summarizedFrom(node) {\n215:   const value = parseJsonObject(node.metadata)?.summarized_from;\n216:   return Number.isInteger(value) ? value : null;\n217: }\n218: \n219: // A compaction starts a new thread whose root has no parent, so the live chain\n220: // alone holds only the turns after it. The thread's continuation node names\n221: // the last node of the thread it summarized, and following that link back,\n222: // once per compaction, restores the turns the compaction dropped.\n223: function chainWithEarlierThreads(nodes, headId) {\n224:   const threads = [];\n225:   const visited = new Set();\n226:   let head = headId;\n227:   while (head != null) {\n228:     if (visited.has(head)) return null;\n229:     visited.add(head);\n230:     const thread = chainFromHead(nodes, head);\n231:     if (!thread) return null;\n232:     threads.unshift(thread);\n233:     const link = thread.find((node) => summarizedFrom(node) !== null);\n234:     head = link ? summarizedFrom(link) : null;\n235:   }\n236:   return threads.flat();\n237: }\n238: \n239: function recordsFromDatabase(database, sessionId, headId) {\n240:   const nodes = database\n241:     .prepare('SELECT node_id, parent_node_id, chat_message, metadata, created_at FROM message_nodes WHERE session_id = ? ORDER BY node_id')\n242:     .all(sessionId);\n243: \n244:   if (nodes.length === 0) return { records: [], injected: [] };\n245: \n246:   const chain = chainWithEarlierThreads(nodes, headId);\n247:   return chain ? { records: recordsFromChain(chain), injected: injectedFromChain(chain) } : null;\n248: }\n249: \n250: // ─────────────────────────────────────────────────────────────────────────────\n251: // 5. TRANSCRIPT MAPPING\n252: // ─────────────────────────────────────────────────────────────────────────────\n253: \n254: function recordsFromSteps(steps) {\n255:   const records = [];\n256: \n257:   steps.forEach((step, stepIndex) => {\n258:     if (!step || typeof step !== 'object') return;\n259:     const stepId = step.step_id ?? stepIndex;\n260:     const timestamp = step.timestamp;\n261:     const message = typeof step.message === 'string' ? step.message : '';\n262: \n263:     if (step.source === 'user') {\n264:       // Harness and system content arrives under a different `source` value, so\n265:       // a user step is operator content even when it opens with '<'.\n266:       if (!message) return;\n267:       records.push({\n268:         id: `devin-${stepId}`.slice(0, 128),\n269:         role: 'user',\n270:         timestamp,\n271:         content: [textBlock(message)],\n272:       });\n273:       return;\n274:     }\n275: \n276:     if (step.source !== 'agent') return;\n277: \n278:     const toolCalls = Array.isArray(step.tool_calls) ? step.tool_calls : [];\n279:     const blocks = [];\n280:     if (message) blocks.push(textBlock(message));\n281:     for (const call of toolCalls) {\n282:       if (typeof call?.tool_call_id !== 'string' || typeof call.function_name !== 'string') continue;\n283:       blocks.push(toolCallBlock({\n284:         id: call.tool_call_id,\n285:         name: call.function_name,\n286:         arguments: call.arguments,\n287:       }));\n288:     }\n289:     if (blocks.length > 0) {\n290:       records.push({\n291:         id: `devin-${stepId}`.slice(0, 128),\n292:         role: 'assistant',\n293:         timestamp,\n294:         content: blocks,\n295:       });\n296:     }\n297: \n298:     const results = Array.isArray(step.observation?.results) ? step.observation.results : [];\n299:     results.forEach((result, resultIndex) => {\n300:       if (typeof result?.source_call_id !== 'string') return;\n301:       const content = typeof result.content === 'string' ? result.content : '';\n302:       records.push({\n303:         id: `devin-${stepId}-result-${resultIndex}`.slice(0, 128),\n304:         role: 'toolResult',\n305:         timestamp,\n306:         content: [textBlock(content)],\n307:         toolCallId: result.source_call_id,\n308:       });\n309:     });\n310:   });\n311: \n312:   return records;\n313: }\n314: \n315: // Harness and system steps are not conversation records, but they are context\n316: // the next turn saw, kept apart so a caller can tell what the operator typed.\n317: function injectedFromSteps(steps) {\n318:   const injected = [];\n319: \n320:   for (const step of steps) {\n321:     if (!step || typeof step !== 'object') continue;\n322:     if (step.source === 'user' || step.source === 'agent') continue;\n323:     if (typeof step.message !== 'string' || !step.message) continue;\n324:     injected.push({ source: step.source, text: step.message });\n325:   }\n326: \n327:   return injected;\n328: }\n329: \n330: // ─────────────────────────────────────────────────────────────────────────────\n331: // 6. LOADER\n332: // ─────────────────────────────────────────────────────────────────────────────\n333: \n334: function loadTranscript(sessionId, dataDirectory, options) {\n335:   const root = devinTranscriptRoot(options);\n336:   const transcriptPath = options.transcriptPath ?? join(root, `${sessionId}${TRANSCRIPT_EXT}`);\n337: \n338:   // Containment is decided before the file is opened, so a path outside the\n339:   // store is refused without its content ever being read.\n340:   const containment = resolveInside({ path: transcriptPath, root });\n341:   if (!containment.ok) {\n342:     if (containment.code === 'session_mismatch') return containment;\n343:     try {\n344:       statSync(dataDirectory);\n345:       return { ok: false, code: 'session_not_found' };\n346:     } catch {\n347:       return { ok: false, code: 'store_unreadable' };\n348:     }\n349:   }\n350:   const storePath = containment.path;\n351: \n352:   let raw;\n353:   try {\n354:     raw = readFileSync(transcriptPath, 'utf8');\n355:   } catch {\n356:     try {\n357:       statSync(dataDirectory);\n358:       return { ok: false, code: 'session_not_found' };\n359:     } catch {\n360:       return { ok: false, code: 'store_unreadable' };\n361:     }\n362:   }\n363: \n364:   const transcript = parseJsonObject(raw);\n365:   if (!transcript) return { ok: false, code: 'store_unreadable' };\n366:   if (typeof transcript.session_id === 'string' && transcript.session_id !== sessionId) {\n367:     return { ok: false, code: 'session_mismatch' };\n368:   }\n369: \n370:   const steps = Array.isArray(transcript.steps) ? transcript.steps : [];\n371:   return {\n372:     ok: true,\n373:     source: {\n374:       runtime: RUNTIME,\n375:       sessionId,\n376:       locatorKind: TRANSCRIPT_LOCATOR_KIND,\n377:       storePath,\n378:     },\n379:     records: recordsFromSteps(steps),\n380:     injected: injectedFromSteps(steps),\n381:   };\n382: }\n383: \n384: export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n385:   if (!isSafeSessionId(sessionId)) {\n386:     return { ok: false, code: sessionId ? 'session_mismatch' : 'locator_unavailable' };\n387:   }\n388:   if (typeof projectDir !== 'string' || !projectDir.trim()) {\n389:     return { ok: false, code: 'locator_unavailable' };\n390:   }\n391: \n392:   const dataDirectory = devinDataDirectory(options);\n393:   const dbPath = devinDatabasePath(options);\n394: \n395:   // A damaged or older database must not hide a transcript the store still\n396:   // holds, so a failure here falls back to the file. A transcript that also\n397:   // fails keeps the store unreadable.\n398:   const transcriptFallback = () => {\n399:     const transcript = loadTranscript(sessionId, dataDirectory, options);\n400:     return transcript.ok || transcript.code === 'session_mismatch'\n401:       ? transcript\n402:       : { ok: false, code: 'store_unreadable' };\n403:   };\n404: \n405:   if (existsSync(dbPath)) {\n406:     const dbContainment = resolveInside({ path: dbPath, root: dataDirectory });\n407:     if (!dbContainment.ok) return dbContainment;\n408: \n409:     let database;\n410:     try {\n411:       database = openDatabase(dbContainment.path);\n412:     } catch {\n413:       return transcriptFallback();\n414:     }\n415: \n416:     try {\n417:       const row = sessionRow(database, sessionId);\n418:       if (row) {\n419:         // Devin's hooks receive the project root, while the row records the\n420:         // folder the session ran in, which may sit below that root.\n421:         if (Object.hasOwn(row, 'working_directory') && !atOrBelow(row.working_directory, projectDir)) {\n422:           return { ok: false, code: 'session_mismatch' };\n423:         }\n424: \n425:         // An older store names its sessions but keeps their turns only in\n426:         // transcript files, so a database with no message rows for this\n427:         // session, or no chain head to walk, falls through.\n428:         if (tableColumns(database, 'message_nodes').size > 0) {\n429:           const projection = recordsFromDatabase(database, sessionId, row.main_chain_id);\n430:           if (!projection) return transcriptFallback();\n431: \n432:           const { records, injected } = projection;\n433:           if (records.length > 0) {\n434:             return {\n435:               ok: true,\n436:               source: {\n437:                 runtime: RUNTIME,\n438:                 sessionId,\n439:                 locatorKind: DATABASE_LOCATOR_KIND,\n440:                 storePath: dbContainment.path,\n441:               },\n442:               records,\n443:               injected,\n444:             };\n445:           }\n446:         }\n447:       }\n448:     } catch {\n449:       return transcriptFallback();\n450:     } finally {\n451:       database.close();\n452:     }\n453:   }\n454: \n455:   // The database has no turns for this id, so the store is either an older\n456:   // transcript-only install or a request for a session it never held.\n457:   return loadTranscript(sessionId, dataDirectory, options);\n458: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-readers/devin.mjs\"}"},"time":{"start":1794559036825,"end":1794559037563}}}}
