{"type":"tool_use","timestamp":1794559079541,"sessionID":"ses_e2bf2816cffeGpkXLORrbflLE9","part":{"partID":"prt_1d40e7161002luE0TcpY5bqCdG","sessionID":"ses_e2bf2816cffeGpkXLORrbflLE9","messageID":"msg_1d40e50b6001UZCeNLNf8et7z0","type":"tool","id":"call_60da07fd3ac341698de91430","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-reader-declarations.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-reader-declarations.mjs, lines 1-127\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Session Reader Declarations\n4: // ───────────────────────────────────────────────────────────────────\n5: // Regenerates or checks the committed `.d.mts` declarations beside the session\n6: // readers. TypeScript callers read the declaration, not the JavaScript, so a\n7: // declaration left behind after a reader change hides the new shape. The\n8: // compiler also refuses to overwrite an existing declaration in place, so a\n9: // plain rebuild never refreshes one; this script deletes them first.\n10: //\n11: // A development tool only: no hook loads it, and it borrows the TypeScript\n12: // compiler and Node types that the spec-kit skill installs.\n13: //\n14: // Usage: node session-reader-declarations.mjs [--check]\n15: // Exit 0 current or rewritten, 1 a declaration is stale (with --check),\n16: // 2 the compiler failed, 3 the compiler or Node types are not installed.\n17: \n18: import { spawnSync } from 'node:child_process';\n19: import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, unlinkSync } from 'node:fs';\n20: import { tmpdir } from 'node:os';\n21: import { dirname, join } from 'node:path';\n22: import { fileURLToPath } from 'node:url';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 1. CONSTANTS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: const HERE = dirname(fileURLToPath(import.meta.url));\n29: const READERS_DIR = join(HERE, 'session-readers');\n30: const SPEC_KIT_MODULES = join(HERE, '..', '..', 'skills', 'system-spec-kit', 'node_modules');\n31: const TSC = join(SPEC_KIT_MODULES, 'typescript', 'bin', 'tsc');\n32: const TYPE_ROOTS = join(SPEC_KIT_MODULES, '@types');\n33: \n34: // The flags the committed declarations were built with. Strict mode keeps\n35: // `string | undefined` where a value can be missing.\n36: const TSC_FLAGS = [\n37:   '--strict', '--allowJs', '--declaration', '--emitDeclarationOnly', '--declarationMap',\n38:   '--module', 'nodenext', '--moduleResolution', 'nodenext', '--target', 'es2022',\n39:   '--skipLibCheck', '--typeRoots', TYPE_ROOTS, '--types', 'node',\n40: ];\n41: \n42: // ─────────────────────────────────────────────────────────────────────────────\n43: // 2. HELPERS\n44: // ─────────────────────────────────────────────────────────────────────────────\n45: \n46: function sources(dir) {\n47:   return readdirSync(dir).filter((name) => name.endsWith('.mjs')).sort();\n48: }\n49: \n50: function declarations(dir) {\n51:   return readdirSync(dir).filter((name) => name.endsWith('.d.mts') || name.endsWith('.d.mts.map')).sort();\n52: }\n53: \n54: // Relative names keep each source map's `sources` entry the bare file name, so\n55: // a build in a temporary copy matches a build in place.\n56: function emit(dir) {\n57:   const result = spawnSync(process.execPath, [TSC, ...TSC_FLAGS, ...sources(dir)], { cwd: dir, encoding: 'utf8' });\n58:   if (result.status !== 0) {\n59:     process.stderr.write(`${result.stdout}${result.stderr}`);\n60:     console.log('STATUS=ERROR session-reader-declarations: the compiler failed');\n61:     process.exit(2);\n62:   }\n63: }\n64: \n65: // Builds in a temporary copy so the compiler never writes declarations for the\n66: // helpers beside this folder into the checkout. A reader may require such a\n67: // helper, like the Cursor reader's `../hook-flags.cjs`, so the copy keeps that\n68: // layout. Returns the temporary root and the folder holding the declarations.\n69: function build() {\n70:   const root = mkdtempSync(join(tmpdir(), 'session-reader-declarations-'));\n71:   const scratch = join(root, 'session-readers');\n72:   mkdirSync(scratch);\n73:   for (const name of readdirSync(HERE).filter((entry) => /\\.(c|m)?js$/.test(entry))) {\n74:     copyFileSync(join(HERE, name), join(root, name));\n75:   }\n76:   for (const name of sources(READERS_DIR)) copyFileSync(join(READERS_DIR, name), join(scratch, name));\n77:   emit(scratch);\n78:   return { root, scratch };\n79: }\n80: \n81: function check() {\n82:   const { root, scratch } = build();\n83:   try {\n84:     const expected = declarations(scratch);\n85:     const committed = new Set(declarations(READERS_DIR));\n86:     const problems = [];\n87:     for (const name of expected) {\n88:       if (!committed.has(name)) problems.push(`MISSING ${name}`);\n89:       else if (readFileSync(join(scratch, name), 'utf8') !== readFileSync(join(READERS_DIR, name), 'utf8')) problems.push(`STALE ${name}`);\n90:       committed.delete(name);\n91:     }\n92:     for (const name of committed) problems.push(`EXTRA ${name}`);\n93: \n94:     for (const line of problems) console.log(line);\n95:     if (problems.length > 0) {\n96:       console.log(`STATUS=STALE session-reader-declarations: ${problems.length} file(s); run node .skilled/hooks/shared/session-reader-declarations.mjs`);\n97:       process.exit(1);\n98:     }\n99:     console.log(`STATUS=OK session-reader-declarations: ${expected.length} file(s) current`);\n100:   } finally {\n101:     rmSync(root, { recursive: true, force: true });\n102:   }\n103: }\n104: \n105: function write() {\n106:   const { root, scratch } = build();\n107:   try {\n108:     for (const name of declarations(READERS_DIR)) unlinkSync(join(READERS_DIR, name));\n109:     const built = declarations(scratch);\n110:     for (const name of built) copyFileSync(join(scratch, name), join(READERS_DIR, name));\n111:     console.log(`STATUS=OK session-reader-declarations: wrote ${built.length} file(s)`);\n112:   } finally {\n113:     rmSync(root, { recursive: true, force: true });\n114:   }\n115: }\n116: \n117: // ─────────────────────────────────────────────────────────────────────────────\n118: // 3. MAIN\n119: // ─────────────────────────────────────────────────────────────────────────────\n120: \n121: if (!existsSync(TSC) || !existsSync(join(TYPE_ROOTS, 'node'))) {\n122:   console.log('STATUS=CANNOT_RUN session-reader-declarations: install the system-spec-kit dependencies first');\n123:   process.exit(3);\n124: }\n125: \n126: if (process.argv.includes('--check')) check();\n127: else write();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-reader-declarations.mjs, lines 1-127\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Session Reader Declarations\n4: // ───────────────────────────────────────────────────────────────────\n5: // Regenerates or checks the committed `.d.mts` declarations beside the session\n6: // readers. TypeScript callers read the declaration, not the JavaScript, so a\n7: // declaration left behind after a reader change hides the new shape. The\n8: // compiler also refuses to overwrite an existing declaration in place, so a\n9: // plain rebuild never refreshes one; this script deletes them first.\n10: //\n11: // A development tool only: no hook loads it, and it borrows the TypeScript\n12: // compiler and Node types that the spec-kit skill installs.\n13: //\n14: // Usage: node session-reader-declarations.mjs [--check]\n15: // Exit 0 current or rewritten, 1 a declaration is stale (with --check),\n16: // 2 the compiler failed, 3 the compiler or Node types are not installed.\n17: \n18: import { spawnSync } from 'node:child_process';\n19: import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, unlinkSync } from 'node:fs';\n20: import { tmpdir } from 'node:os';\n21: import { dirname, join } from 'node:path';\n22: import { fileURLToPath } from 'node:url';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 1. CONSTANTS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: const HERE = dirname(fileURLToPath(import.meta.url));\n29: const READERS_DIR = join(HERE, 'session-readers');\n30: const SPEC_KIT_MODULES = join(HERE, '..', '..', 'skills', 'system-spec-kit', 'node_modules');\n31: const TSC = join(SPEC_KIT_MODULES, 'typescript', 'bin', 'tsc');\n32: const TYPE_ROOTS = join(SPEC_KIT_MODULES, '@types');\n33: \n34: // The flags the committed declarations were built with. Strict mode keeps\n35: // `string | undefined` where a value can be missing.\n36: const TSC_FLAGS = [\n37:   '--strict', '--allowJs', '--declaration', '--emitDeclarationOnly', '--declarationMap',\n38:   '--module', 'nodenext', '--moduleResolution', 'nodenext', '--target', 'es2022',\n39:   '--skipLibCheck', '--typeRoots', TYPE_ROOTS, '--types', 'node',\n40: ];\n41: \n42: // ─────────────────────────────────────────────────────────────────────────────\n43: // 2. HELPERS\n44: // ─────────────────────────────────────────────────────────────────────────────\n45: \n46: function sources(dir) {\n47:   return readdirSync(dir).filter((name) => name.endsWith('.mjs')).sort();\n48: }\n49: \n50: function declarations(dir) {\n51:   return readdirSync(dir).filter((name) => name.endsWith('.d.mts') || name.endsWith('.d.mts.map')).sort();\n52: }\n53: \n54: // Relative names keep each source map's `sources` entry the bare file name, so\n55: // a build in a temporary copy matches a build in place.\n56: function emit(dir) {\n57:   const result = spawnSync(process.execPath, [TSC, ...TSC_FLAGS, ...sources(dir)], { cwd: dir, encoding: 'utf8' });\n58:   if (result.status !== 0) {\n59:     process.stderr.write(`${result.stdout}${result.stderr}`);\n60:     console.log('STATUS=ERROR session-reader-declarations: the compiler failed');\n61:     process.exit(2);\n62:   }\n63: }\n64: \n65: // Builds in a temporary copy so the compiler never writes declarations for the\n66: // helpers beside this folder into the checkout. A reader may require such a\n67: // helper, like the Cursor reader's `../hook-flags.cjs`, so the copy keeps that\n68: // layout. Returns the temporary root and the folder holding the declarations.\n69: function build() {\n70:   const root = mkdtempSync(join(tmpdir(), 'session-reader-declarations-'));\n71:   const scratch = join(root, 'session-readers');\n72:   mkdirSync(scratch);\n73:   for (const name of readdirSync(HERE).filter((entry) => /\\.(c|m)?js$/.test(entry))) {\n74:     copyFileSync(join(HERE, name), join(root, name));\n75:   }\n76:   for (const name of sources(READERS_DIR)) copyFileSync(join(READERS_DIR, name), join(scratch, name));\n77:   emit(scratch);\n78:   return { root, scratch };\n79: }\n80: \n81: function check() {\n82:   const { root, scratch } = build();\n83:   try {\n84:     const expected = declarations(scratch);\n85:     const committed = new Set(declarations(READERS_DIR));\n86:     const problems = [];\n87:     for (const name of expected) {\n88:       if (!committed.has(name)) problems.push(`MISSING ${name}`);\n89:       else if (readFileSync(join(scratch, name), 'utf8') !== readFileSync(join(READERS_DIR, name), 'utf8')) problems.push(`STALE ${name}`);\n90:       committed.delete(name);\n91:     }\n92:     for (const name of committed) problems.push(`EXTRA ${name}`);\n93: \n94:     for (const line of problems) console.log(line);\n95:     if (problems.length > 0) {\n96:       console.log(`STATUS=STALE session-reader-declarations: ${problems.length} file(s); run node .skilled/hooks/shared/session-reader-declarations.mjs`);\n97:       process.exit(1);\n98:     }\n99:     console.log(`STATUS=OK session-reader-declarations: ${expected.length} file(s) current`);\n100:   } finally {\n101:     rmSync(root, { recursive: true, force: true });\n102:   }\n103: }\n104: \n105: function write() {\n106:   const { root, scratch } = build();\n107:   try {\n108:     for (const name of declarations(READERS_DIR)) unlinkSync(join(READERS_DIR, name));\n109:     const built = declarations(scratch);\n110:     for (const name of built) copyFileSync(join(scratch, name), join(READERS_DIR, name));\n111:     console.log(`STATUS=OK session-reader-declarations: wrote ${built.length} file(s)`);\n112:   } finally {\n113:     rmSync(root, { recursive: true, force: true });\n114:   }\n115: }\n116: \n117: // ─────────────────────────────────────────────────────────────────────────────\n118: // 3. MAIN\n119: // ─────────────────────────────────────────────────────────────────────────────\n120: \n121: if (!existsSync(TSC) || !existsSync(join(TYPE_ROOTS, 'node'))) {\n122:   console.log('STATUS=CANNOT_RUN session-reader-declarations: install the system-spec-kit dependencies first');\n123:   process.exit(3);\n124: }\n125: \n126: if (process.argv.includes('--check')) check();\n127: else write();"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/hooks/shared/session-reader-declarations.mjs\"}"},"time":{"start":1794559078753,"end":1794559079541}}}}
