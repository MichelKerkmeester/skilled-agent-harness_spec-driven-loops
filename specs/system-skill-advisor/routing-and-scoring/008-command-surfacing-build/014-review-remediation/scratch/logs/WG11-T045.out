st dataDirectory = devinDataDirectory(options);\n   const dbPath = devinDatabasePath(options);\n \n+  // A damaged or older database must not hide a transcript the store still\n+  // holds, so a failure here falls back to the file. A transcript that also\n+  // fails keeps the store unreadable.\n+  const transcriptFallback = () => {\n+    const transcript = loadTranscript(sessionId, dataDirectory, options);\n+    return transcript.ok || transcript.code === 'session_mismatch'\n+      ? transcript\n+      : { ok: false, code: 'store_unreadable' };\n+  };\n+\n   if (existsSync(dbPath)) {\n     const dbContainment = resolveInside({ path: dbPath, root: dataDirectory });\n     if (!dbContainment.ok) return dbContainment;\n@@ -400,7 +412,7 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n     try {\n       database = openDatabase(dbContainment.path);\n     } catch {\n-      return { ok: false, code: 'store_unreadable' };\n+      return transcriptFallback();\n     }\n \n     try {\n@@ -417,7 +429,7 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n         // session, or no chain head to walk, falls through.\n         if (tableColumns(database, 'message_nodes').size > 0) {\n           const projection = recordsFromDatabase(database, sessionId, row.main_chain_id);\n-          if (!projection) return { ok: false, code: 'store_unreadable' };\n+          if (!projection) return transcriptFallback();\n \n           const { records, injected } = projection;\n           if (records.length > 0) {\n@@ -436,7 +448,7 @@ export function loadDevinSession({ sessionId, projectDir, ...options } = {}) {\n         }\n       }\n     } catch {\n-      return { ok: false, code: 'store_unreadable' };\n+      return transcriptFallback();\n     } finally {\n       database.close();\n     }\ndiff --git a/.skilled/hooks/shared/session-readers/dsh.mjs b/.skilled/hooks/shared/session-readers/dsh.mjs\nindex f97bc57e91..c2877301cc 100644\n--- a/.skilled/hooks/shared/session-readers/dsh.mjs\n+++ b/.skilled/hooks/shared/session-readers/dsh.mjs\n@@ -307,7 +307,10 @@ export function loadDshSession({ sessionId, projectDir, sessionPath, ...options\n \n   let events;\n   try {\n-    events = parseEvents(decodeSessionLog(readFileSync(logPath), logPath));\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed. The decoder still takes the\n+    // locator name, because it picks the format from the extension.\n+    events = parseEvents(decodeSessionLog(readFileSync(storePath), logPath));\n   } catch {\n     return { ok: false, code: 'store_unreadable' };\n   }\ndiff --git a/.skilled/hooks/shared/session-readers/pi.mjs b/.skilled/hooks/shared/session-readers/pi.mjs\nindex 97d8fe32ba..9488105db5 100644\n--- a/.skilled/hooks/shared/session-readers/pi.mjs\n+++ b/.skilled/hooks/shared/session-readers/pi.mjs\n@@ -253,7 +253,9 @@ function diskResult({ sessionId, projectDir, options }) {\n \n   let raw;\n   try {\n-    raw = readFileSync(filePath, 'utf8');\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped after the check is not followed.\n+    raw = readFileSync(guard.path, 'utf8');\n   } catch {\n     return { ok: false, code: 'store_unreadable' };\n   }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/hooks/shared/session-readers/claude.mjs b/.skilled/hooks/shared/session-readers/claude.mjs\nindex 246a011755..a2b3dde14e 100644\n--- a/.skilled/hooks/shared/session-readers/claude.mjs\n+++ b/.skilled/hooks/shared/session-readers/claude.mjs\n@@ -214,7 +214,9 @@ export function loadClaudeSession({ sessionId, transcriptPath, ...options } = {}\n \n   let raw;\n   try {\n-    raw = readFileSync(transcriptPath, 'utf8');\n+    // The file read is the path the containment check resolved, so a path\n+    // swapped a