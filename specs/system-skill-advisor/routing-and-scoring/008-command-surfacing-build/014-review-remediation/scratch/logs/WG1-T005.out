{"type":"tool_use","timestamp":1794558983044,"sessionID":"ses_e2bf38506ffeNcdxLsVq4pRFDx","part":{"partID":"prt_1d40cf95a001i5kMHEZJxSYgDy","sessionID":"ses_e2bf38506ffeNcdxLsVq4pRFDx","messageID":"msg_1d40cecff001xU3gmUEXTN6YwU","type":"tool","id":"call_7be53f18f1c346fc8b706469","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs","offset":1200,"limit":260},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1200-1459\n1200:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1201: \n1202:   for (const file of composition.writes) {\n1203:     if (file.action === 'remove') {\n1204:       lines.push(`diff ${file.path}:`);\n1205:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1206:       continue;\n1207:     }\n1208:     const diff = unifiedDiff(file.before, file.content, file.path);\n1209:     lines.push(`diff ${file.path}:`);\n1210:     if (diff.length === 0) lines.push('  (no line changes)');\n1211:     lines.push(...diff);\n1212:   }\n1213: \n1214:   lines.push('block:');\n1215:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1216:   lines.push('block-end:');\n1217: \n1218:   const { before, after, limits } = composition.budget;\n1219:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1220:   if (after.total > limits.total) {\n1221:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1222:   }\n1223:   if (after.prefix > limits.prefix) {\n1224:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1225:   }\n1226: \n1227:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1228:   lines.push(`backup: ${plan.dir}`);\n1229:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1230:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1231:   lines.push(`plan-digest: ${plan.digest}`);\n1232:   return lines;\n1233: }\n1234: \n1235: function renderDropped(dropped) {\n1236:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1237: }\n1238: \n1239: // ─────────────────────────────────────────────────────────────────────────────\n1240: // 15. PLAN\n1241: // ─────────────────────────────────────────────────────────────────────────────\n1242: \n1243: function preflight(composition, manifest) {\n1244:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1245: }\n1246: \n1247: function commandPlan(options, output, hooks) {\n1248:   const manifest = loadManifest();\n1249:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1250: \n1251:   const checked = preflight(composition, manifest);\n1252:   composition.ledger.dropped = checked.dropped.length;\n1253: \n1254:   if (composition.writes.length === 0) {\n1255:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1256:     for (const note of composition.notes) output.log(`note: ${note}`);\n1257:     output.log('NOTHING TO DO');\n1258:     return 0;\n1259:   }\n1260: \n1261:   const plan = planFor(composition);\n1262:   for (const line of renderPlan(composition, plan)) output.log(line);\n1263:   if (checked.dropped.length > 0) {\n1264:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1265:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1266:     output.warn('STATUS=FAIL');\n1267:     return 1;\n1268:   }\n1269:   if (options.dryRun) output.log('dry-run: nothing was written');\n1270:   return 0;\n1271: }\n1272: \n1273: // ─────────────────────────────────────────────────────────────────────────────\n1274: // 16. APPLY\n1275: // ─────────────────────────────────────────────────────────────────────────────\n1276: \n1277: function runTool(script, args) {\n1278:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1279:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1280:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1281:   return { code: result.status, output };\n1282: }\n1283: \n1284: function restoreFromBackup({ root, dir, output }) {\n1285:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1286:   // A rollback that put a damaged copy back would replace the fault it exists to undo with\n1287:   // one the run never made, so every entry is proved against the hash recorded beside it\n1288:   // before the first path moves.\n1289:   for (const entry of record.paths) {\n1290:     assertWritable(root, entry.path);\n1291:     if (!entry.existed) continue;\n1292:     const source = path.join(dir, entry.backup);\n1293:     if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n1294:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n1295:       return null;\n1296:     }\n1297:   }\n1298:   let restored = 0;\n1299:   const deleted = new Set();\n1300:   for (const entry of record.paths) {\n1301:     const target = path.join(root, entry.path);\n1302:     if (!entry.existed) {\n1303:       if (fs.existsSync(target)) {\n1304:         fs.rmSync(target);\n1305:         deleted.add(entry.path);\n1306:       }\n1307:       continue;\n1308:     }\n1309:     const source = path.join(dir, entry.backup);\n1310:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1311:     fs.copyFileSync(source, target);\n1312:     restored += 1;\n1313:   }\n1314:   removeCreatedDirs(root, record.paths, deleted);\n1315:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1316:   return restored;\n1317: }\n1318: \n1319: function commandApply(options, output, hooks) {\n1320:   if (!options.digest) {\n1321:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1322:     return 2;\n1323:   }\n1324: \n1325:   const manifest = loadManifest();\n1326:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1327: \n1328:   // A tree already in its target state has nothing a digest could authorise.\n1329:   if (composition.writes.length === 0) {\n1330:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1331:     output.log('NOTHING TO DO');\n1332:     return 0;\n1333:   }\n1334: \n1335:   const plan = planFor(composition);\n1336:   if (plan.digest !== options.digest) {\n1337:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1338:     // already happened gets told which directory holds those bytes instead of a claim\n1339:     // about the tree that would be false.\n1340:     const held = backupDirectoryOf(plan.base, options.digest);\n1341:     if (fs.existsSync(held)) {\n1342:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1343:       return 2;\n1344:     }\n1345:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1346:     return 2;\n1347:   }\n1348: \n1349:   // The same proof the plan ran, because a composition that already loses a line must\n1350:   // never reach a backup, let alone the tree.\n1351:   const checked = preflight(composition, manifest);\n1352:   composition.ledger.dropped = checked.dropped.length;\n1353:   if (checked.dropped.length > 0) {\n1354:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1355:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1356:     output.warn('STATUS=FAIL');\n1357:     return 1;\n1358:   }\n1359: \n1360:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1361:   // the run before a backup exists rather than after a partial write.\n1362:   const targets = [];\n1363:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1364: \n1365:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1366:   // here, where every precondition has already passed and nothing has been created.\n1367:   if (options.dryRun) {\n1368:     for (const line of renderPlan(composition, plan)) output.log(line);\n1369:     output.log('dry-run: nothing was written');\n1370:     return 0;\n1371:   }\n1372: \n1373:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1374:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1375: \n1376:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1377:   for (const target of targets) {\n1378:     if (target.file.action === 'remove') {\n1379:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1380:       output.log(`removed ${target.file.path} (backed up first)`);\n1381:       continue;\n1382:     }\n1383:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1384:     write(target.absolute, target.file.content);\n1385:     output.log(`wrote ${target.file.path}`);\n1386:   }\n1387: \n1388:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1389:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1390:   if (rootTouched) {\n1391:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1392:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1393:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1394:   }\n1395:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1396:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1397:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1398:     output.log(`repo-rules: ${summary}`);\n1399:   }\n1400: \n1401:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1402:   const rootPath = path.join(options.root, manifest.root_file);\n1403:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1404:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1405:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1406: \n1407:   if (after.dropped.length > 0) {\n1408:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1409:     const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1410:     if (restored === null) {\n1411:       output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n1412:     } else {\n1413:       output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1414:     }\n1415:     output.warn('STATUS=FAIL');\n1416:     return 1;\n1417:   }\n1418: \n1419:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1420:   if (report !== null) {\n1421:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1422:   }\n1423:   output.log(`backup: ${plan.dir}`);\n1424:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1425:   for (const entry of record.paths) {\n1426:     if (!entry.existed) continue;\n1427:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1428:   }\n1429:   output.log('STATUS=OK');\n1430:   return 0;\n1431: }\n1432: \n1433: // ─────────────────────────────────────────────────────────────────────────────\n1434: // 17. RESTORE\n1435: // ─────────────────────────────────────────────────────────────────────────────\n1436: \n1437: function readConfirmation() {\n1438:   try {\n1439:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1440:   } catch {\n1441:     return '';\n1442:   }\n1443: }\n1444: \n1445: function commandRestore(options, output, hooks) {\n1446:   if (!options.run) {\n1447:     output.warn(`${TAG} ERROR: restore needs --run=<dir>, the backup directory a run printed`);\n1448:     return 2;\n1449:   }\n1450:   const recordPath = path.join(options.run, 'manifest.json');\n1451:   if (!fs.existsSync(recordPath)) {\n1452:     output.warn(`${TAG} ERROR: no manifest.json under ${options.run}, so there is nothing recorded to put back`);\n1453:     return 2;\n1454:   }\n1455: \n1456:   const record = JSON.parse(fs.readFileSync(recordPath, 'utf8'));\n1457:   const root = record.root;\n1458:   // The record names its own root, and a record is data: it is trusted only when it names\n1459:   // the root this restore runs against, so a record repointed at another folder is refused\n[Output truncated. Continue reading with offset: 1460]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-embed.cjs, lines 1200-1459\n1200:   for (const note of composition.notes) lines.push(`note: ${note}`);\n1201: \n1202:   for (const file of composition.writes) {\n1203:     if (file.action === 'remove') {\n1204:       lines.push(`diff ${file.path}:`);\n1205:       for (const line of unifiedDiff(file.before, null, file.path)) lines.push(line);\n1206:       continue;\n1207:     }\n1208:     const diff = unifiedDiff(file.before, file.content, file.path);\n1209:     lines.push(`diff ${file.path}:`);\n1210:     if (diff.length === 0) lines.push('  (no line changes)');\n1211:     lines.push(...diff);\n1212:   }\n1213: \n1214:   lines.push('block:');\n1215:   lines.push(...composition.block.text.replace(/\\n$/u, '').split('\\n'));\n1216:   lines.push('block-end:');\n1217: \n1218:   const { before, after, limits } = composition.budget;\n1219:   lines.push(`budget: ${before.prefix} -> ${after.prefix} of ${limits.prefix} bytes to the last anchor, ${before.total} -> ${after.total} of ${limits.total} bytes total, ${limits.total - after.total} bytes headroom`);\n1220:   if (after.total > limits.total) {\n1221:     lines.push(`finding: the composed document is ${after.total} bytes, past the ${limits.total}-byte ceiling the truncating runtimes stop at; every carried line is still kept, because preservation outranks the budget`);\n1222:   }\n1223:   if (after.prefix > limits.prefix) {\n1224:     lines.push(`finding: the last delivery anchor now ends at byte ${after.prefix}, past the ${limits.prefix}-byte prefix`);\n1225:   }\n1226: \n1227:   lines.push(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${composition.ledger.dropped}`);\n1228:   lines.push(`backup: ${plan.dir}`);\n1229:   if (plan.fallback) lines.push(`backup-fallback: ${plan.reason}`);\n1230:   lines.push(`undo: ${undoCommand(plan.dir, composition.root)}`);\n1231:   lines.push(`plan-digest: ${plan.digest}`);\n1232:   return lines;\n1233: }\n1234: \n1235: function renderDropped(dropped) {\n1236:   return dropped.map((entry) => `dropped: ${entry.line} (part ${entry.part}, from ${entry.from}: ${entry.after} of ${entry.before} kept)`);\n1237: }\n1238: \n1239: // ─────────────────────────────────────────────────────────────────────────────\n1240: // 15. PLAN\n1241: // ─────────────────────────────────────────────────────────────────────────────\n1242: \n1243: function preflight(composition, manifest) {\n1244:   return preservationCheck(composition.oldText, composition.composed, manifest, { removed: composition.removedCopies });\n1245: }\n1246: \n1247: function commandPlan(options, output, hooks) {\n1248:   const manifest = loadManifest();\n1249:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1250: \n1251:   const checked = preflight(composition, manifest);\n1252:   composition.ledger.dropped = checked.dropped.length;\n1253: \n1254:   if (composition.writes.length === 0) {\n1255:     output.log(`${TAG} plan for ${composition.root} (state: ${composition.state})`);\n1256:     for (const note of composition.notes) output.log(`note: ${note}`);\n1257:     output.log('NOTHING TO DO');\n1258:     return 0;\n1259:   }\n1260: \n1261:   const plan = planFor(composition);\n1262:   for (const line of renderPlan(composition, plan)) output.log(line);\n1263:   if (checked.dropped.length > 0) {\n1264:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1265:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s), so it will not be offered for writing`);\n1266:     output.warn('STATUS=FAIL');\n1267:     return 1;\n1268:   }\n1269:   if (options.dryRun) output.log('dry-run: nothing was written');\n1270:   return 0;\n1271: }\n1272: \n1273: // ─────────────────────────────────────────────────────────────────────────────\n1274: // 16. APPLY\n1275: // ─────────────────────────────────────────────────────────────────────────────\n1276: \n1277: function runTool(script, args) {\n1278:   if (!fs.existsSync(script)) return { code: null, output: `the tool is not installed at ${script}` };\n1279:   const result = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', timeout: TOOL_TIMEOUT_MS });\n1280:   const output = `${result.stdout || ''}\\n${result.stderr || ''}`.split('\\n').map((line) => line.trim()).filter((line) => line !== '');\n1281:   return { code: result.status, output };\n1282: }\n1283: \n1284: function restoreFromBackup({ root, dir, output }) {\n1285:   const record = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8'));\n1286:   // A rollback that put a damaged copy back would replace the fault it exists to undo with\n1287:   // one the run never made, so every entry is proved against the hash recorded beside it\n1288:   // before the first path moves.\n1289:   for (const entry of record.paths) {\n1290:     assertWritable(root, entry.path);\n1291:     if (!entry.existed) continue;\n1292:     const source = path.join(dir, entry.backup);\n1293:     if (!fs.existsSync(source) || sha256(fs.readFileSync(source, 'utf8')) !== entry.sha256) {\n1294:       output.warn(`${TAG} ERROR: the backup copy of ${entry.path} does not match its recorded hash, so nothing was restored. The backup is kept at ${dir}`);\n1295:       return null;\n1296:     }\n1297:   }\n1298:   let restored = 0;\n1299:   const deleted = new Set();\n1300:   for (const entry of record.paths) {\n1301:     const target = path.join(root, entry.path);\n1302:     if (!entry.existed) {\n1303:       if (fs.existsSync(target)) {\n1304:         fs.rmSync(target);\n1305:         deleted.add(entry.path);\n1306:       }\n1307:       continue;\n1308:     }\n1309:     const source = path.join(dir, entry.backup);\n1310:     fs.mkdirSync(path.dirname(target), { recursive: true });\n1311:     fs.copyFileSync(source, target);\n1312:     restored += 1;\n1313:   }\n1314:   removeCreatedDirs(root, record.paths, deleted);\n1315:   output.warn(`${TAG} restored: ${restored} file(s) from ${dir}`);\n1316:   return restored;\n1317: }\n1318: \n1319: function commandApply(options, output, hooks) {\n1320:   if (!options.digest) {\n1321:     output.warn(`${TAG} ERROR: apply needs --plan-digest, the digest the plan printed; nothing was written`);\n1322:     return 2;\n1323:   }\n1324: \n1325:   const manifest = loadManifest();\n1326:   const composition = compose({ root: options.root, manifest, keepClaudeMd: options.keepClaudeMd, createRouter: options.createRouter });\n1327: \n1328:   // A tree already in its target state has nothing a digest could authorise.\n1329:   if (composition.writes.length === 0) {\n1330:     output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1331:     output.log('NOTHING TO DO');\n1332:     return 0;\n1333:   }\n1334: \n1335:   const plan = planFor(composition);\n1336:   if (plan.digest !== options.digest) {\n1337:     // The digest also names the backup directory, so an operator replaying a plan whose run\n1338:     // already happened gets told which directory holds those bytes instead of a claim\n1339:     // about the tree that would be false.\n1340:     const held = backupDirectoryOf(plan.base, options.digest);\n1341:     if (fs.existsSync(held)) {\n1342:       output.warn(`${TAG} ERROR: the plan digest ${options.digest} names the backup ${held}, which an earlier run already holds; nothing was written. Plan again for a directory of its own`);\n1343:       return 2;\n1344:     }\n1345:     output.warn(`${TAG} ERROR: the plan digest ${options.digest} does not match the composition now (${plan.digest}); the tree changed since the plan, so nothing was written`);\n1346:     return 2;\n1347:   }\n1348: \n1349:   // The same proof the plan ran, because a composition that already loses a line must\n1350:   // never reach a backup, let alone the tree.\n1351:   const checked = preflight(composition, manifest);\n1352:   composition.ledger.dropped = checked.dropped.length;\n1353:   if (checked.dropped.length > 0) {\n1354:     for (const line of renderDropped(checked.dropped)) output.warn(line);\n1355:     output.warn(`${TAG} the composition drops ${checked.dropped.length} line(s); nothing was written`);\n1356:     output.warn('STATUS=FAIL');\n1357:     return 1;\n1358:   }\n1359: \n1360:   // Every path is resolved before the first byte, so a path outside the allowlist stops\n1361:   // the run before a backup exists rather than after a partial write.\n1362:   const targets = [];\n1363:   for (const file of composition.writes) targets.push({ file, absolute: assertWritable(options.root, file.path) });\n1364: \n1365:   // A dry run is the same plan the operator would give a yes to, minus the write: it stops\n1366:   // here, where every precondition has already passed and nothing has been created.\n1367:   if (options.dryRun) {\n1368:     for (const line of renderPlan(composition, plan)) output.log(line);\n1369:     output.log('dry-run: nothing was written');\n1370:     return 0;\n1371:   }\n1372: \n1373:   const record = writeBackup({ root: options.root, manifest, composition, plan });\n1374:   output.log(`${TAG} apply on ${composition.root} (state: ${composition.state})`);\n1375: \n1376:   const write = hooks.write || ((file, content) => fs.writeFileSync(file, content, 'utf8'));\n1377:   for (const target of targets) {\n1378:     if (target.file.action === 'remove') {\n1379:       if (fs.existsSync(target.absolute)) fs.rmSync(target.absolute);\n1380:       output.log(`removed ${target.file.path} (backed up first)`);\n1381:       continue;\n1382:     }\n1383:     fs.mkdirSync(path.dirname(target.absolute), { recursive: true });\n1384:     write(target.absolute, target.file.content);\n1385:     output.log(`wrote ${target.file.path}`);\n1386:   }\n1387: \n1388:   // The pointer block belongs to its generator, and the router verdict to its checker.\n1389:   const rootTouched = composition.writes.some((file) => file.path === manifest.root_file);\n1390:   if (rootTouched) {\n1391:     const wrote = runTool(POINTER_SYNC, ['--root', options.root]);\n1392:     const checkedPointer = runTool(POINTER_SYNC, ['--check', '--root', options.root]);\n1393:     output.log(`pointer-sync: ${checkedPointer.code === 0 ? 'in sync' : `exit ${checkedPointer.code}`}${wrote.output.length > 0 ? ` (${wrote.output.join('; ')})` : ''}`);\n1394:   }\n1395:   if (composition.writes.some((file) => file.path === manifest.router_file)) {\n1396:     const router = runTool(REPO_RULES_CHECKER, ['--root', options.root]);\n1397:     const summary = router.output.find((line) => line.includes(REPO_RULES_TAG) && line.includes('RESULT:')) || router.output[router.output.length - 1] || '';\n1398:     output.log(`repo-rules: ${summary}`);\n1399:   }\n1400: \n1401:   // The proof runs against the bytes on disk, never against the bytes still in memory.\n1402:   const rootPath = path.join(options.root, manifest.root_file);\n1403:   const onDisk = fs.existsSync(rootPath) ? fs.readFileSync(rootPath, 'utf8') : '';\n1404:   const after = preservationCheck(composition.oldText, onDisk, manifest, { removed: composition.removedCopies });\n1405:   const report = buildReport({ root: options.root, manifestPath: MANIFEST_PATH });\n1406: \n1407:   if (after.dropped.length > 0) {\n1408:     for (const line of renderDropped(after.dropped)) output.warn(line);\n1409:     const restored = restoreFromBackup({ root: options.root, dir: plan.dir, output });\n1410:     if (restored === null) {\n1411:       output.warn(`${TAG} the write dropped ${after.dropped.length} line(s) and the backup could not be restored, so the tree is as the write left it`);\n1412:     } else {\n1413:       output.warn(`${TAG} the write dropped ${after.dropped.length} line(s), so the run was undone; the backup is kept at ${plan.dir}`);\n1414:     }\n1415:     output.warn('STATUS=FAIL');\n1416:     return 1;\n1417:   }\n1418: \n1419:   output.log(`preservation: kept ${composition.ledger.kept}, carried ${composition.ledger.carried}, shipped-replaced ${composition.ledger.shippedReplaced}, dropped ${after.dropped.length}`);\n1420:   if (report !== null) {\n1421:     output.log(`check-after: state=${report.state} findings=${report.findings} unknown=${report.unknown}`);\n1422:   }\n1423:   output.log(`backup: ${plan.dir}`);\n1424:   output.log(`undo: ${undoCommand(plan.dir, options.root)}`);\n1425:   for (const entry of record.paths) {\n1426:     if (!entry.existed) continue;\n1427:     output.log(`cp ${path.join(plan.dir, entry.backup)} ${entry.path}`);\n1428:   }\n1429:   output.log('STATUS=OK');\n1430:   return 0;\n1431: }\n1432: \n1433: // ─────────────────────────────────────────────────────────────────────────────\n1434: // 17. RESTORE\n1435: // ─────────────────────────────────────────────────────────────────────────────\n1436: \n1437: function readConfirmation() {\n1438:   try {\n1439:     return fs.readFileSync(0, 'utf8').split('\\n')[0].trim();\n1440:   } catch {\n1441:     return '';\n1442:   }\n1443: }\n1444: \n1445: function