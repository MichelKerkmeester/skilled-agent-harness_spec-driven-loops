@AGENTS.md\\n');\n921: });\n922: \n923: // ─────────────────────────────────────────────────────────────────────────────\n924: // 15. THE ROUTER\n925: // ─────────────────────────────────────────────────────────────────────────────\n926: \n927: test('a router missing shipped rows gains exactly those rows', (t) => {\n928:   const dir = composeTree(t, 'pure');\n929:   seedRuleCorpus(dir);\n930:   const partial = partialRouter(3);\n931:   fs.writeFileSync(path.join(dir, manifest.router_file), partial, 'utf8');\n932: \n933:   const applied = planAndApply(dir).applied;\n934:   trackBackup(t, applied.out);\n935:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n936: \n937:   const router = readInside(dir, manifest.router_file);\n938:   for (const line of partial.split('\\n').filter((entry) => entry.trim() !== '')) {\n939:     assert.ok(router.includes(line), `${line} was not touched`);\n940:   }\n941:   assert.equal(tableRows(router, 'TRIGGER TABLE').length, shippedRows().trigger_rows.length);\n942:   assert.equal(tableRows(router, 'INDEX').length, shippedRows().index_rows.length);\n943: \n944:   const checked = runRepoRulesChecker(dir);\n945:   assert.equal(checked.code, 0, checked.out);\n946:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n947: });\n948: \n949: test('a missing router is created only when asked for', (t) => {\n950:   const dir = composeTree(t, 'pure');\n951:   seedRuleCorpus(dir);\n952: \n953:   const quiet = plan(dir);\n954:   assert.equal(quiet.code, 0, quiet.err);\n955:   assert.match(quiet.out, /NOTHING TO DO/u);\n956:   assert.equal(existsInside(dir, manifest.router_file), false);\n957: \n958:   const applied = planAndApply(dir, ['--create-router']).applied;\n959:   trackBackup(t, applied.out);\n960:   assert.equal(applied.code, 0, `${applied.err}${applied.out}`);\n961:   assert.equal(existsInside(dir, manifest.router_file), true);\n962: \n963:   const checked = runRepoRulesChecker(dir);\n964:   assert.equal(checked.code, 0, checked.out);\n965:   assert.match(checked.out, /RESULT: PASSED \\(11\\/11 checks\\)/u);\n966: });\n967: \n968: // ─────────────────────────────────────────────────────────────────────────────\n969: // 16. THE CURSOR MIRROR\n970: // ─────────────────────────────────────────────────────────────────────────────\n971: \n972: test('.cursor/rules/repo-local.md exists exactly when the block carries content', (t) => {\n973:   const empty = composeTree(t, 'absent');\n974:   const emptyApplied = planAndApply(empty).applied;\n975:   trackBackup(t, emptyApplied.out);\n976:   assert.equal(emptyApplied.code, 0, `${emptyApplied.err}${emptyApplied.out}`);\n977:   assert.equal(existsInside(empty, manifest.root_file), true, 'the template arrives');\n978:   assert.equal(existsInside(empty, '.cursor/rules/repo-local.md'), false, 'an empty block has nothing to mirror');\n979:   assert.equal(existsInside(empty, manifest.router_file), false, 'a router nobody asked for is not created');\n980: \n981:   const carried = composeTree(t, 'foreign');\n982:   const carriedApplied = planAndApply(carried).applied;\n983:   trackBackup(t, carriedApplied.out);\n984:   assert.equal(carriedApplied.code, 0, `${carriedApplied.err}${carriedApplied.out}`);\n985:   const mirror = readInside(carried, '.cursor/rules/repo-local.md');\n986:   assert.match(mirror, /^---\\nalwaysApply: true\\n---\\n/u);\n987:   for (const line of trimmedLines(blockIn(readInside(carried, manifest.root_file)))) {\n988:     assert.ok(mirror.includes(line), `${line} reaches the mirror`);\n989:   }\n[Output truncated. Continue reading with offset: 990]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":120,\"offset\":870,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\"}"},"time":{"start":1794559007383,"end":1794559008801}}}}
{"type":"tool_use","timestamp":1794559008809,"sessionID":"ses_e2bf38506ffeNcdxLsVq4pRFDx","part":{"partID":"prt_1d40d5d6e001O53VOYUUEdKGS1","sessionID":"ses_e2bf38506ffeNcdxLsVq4pRFDx","messageID":"msg_1d40d4bd6001Fq45jaq0AFb7Li","type":"tool","id":"call_8cfca8aeb1db4a0bb3bc1322","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,60p' .skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs; ls .skilled/commands/doctor/scripts/tests/fixtures/agents-md","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Shipped Instruction Fixture Composer\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// A fixture is a recipe, not a tree. A committed copy of the composed tree would put the\n// shipped template into the repository a second time: its relative links would resolve\n// from the fixture folder rather than the root, a runtime that loads nested instruction\n// files would read it as some repository's own document, and every template edit would\n// force a regeneration commit. So each folder here holds only `fixture.json`, and the\n// tree it describes is composed on demand into a folder the caller throws away.\n//\n// Composition reads the manifest the template ships, never a stored copy of it, so a\n// fixture is a statement about what is shipped today. That is also why a fixture cannot\n// describe a template the manifest does not ship: the bodies come from the manifest's\n// derived sections and its release history, the block shape from the manifest's markers,\n// and the two runtime mirrors from the generators that own them.\n//\n// Composing by hand is supported, because \"run the check against this defect\" is the\n// first thing a reader wants to do with a fixture:\n//\n// Usage: compose-fixture.cjs <fixture> <empty-folder>\n//   <fixture>       one of the folder names beside this script\n//   <empty-folder>  created if absent, refused when it already holds anything\n// Exit codes: 0 composed, 2 bad arguments or a folder it must not write into\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst SCRIPTS_DIR = path.resolve(__dirname, '../../..');\nconst REPO_ROOT = path.resolve(SCRIPTS_DIR, '../../../..');\nconst FIXTURES = __dirname;\nconst MANIFEST_PATH = path.join(SCRIPTS_DIR, '../assets/agents-md-manifest.json');\nconst POINTER_SYNC = path.join(\n  REPO_ROOT,\n  '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n);\n\nconst { TARGETS, applyBlock, readGateOneLine, renderBlock } = require(POINTER_SYNC);\n\nconst TAG = '[compose-fixture]';\nconst USAGE = `Usage: node ${path.relative(REPO_ROOT, __filename)} <fixture> <empty-folder>`;\n\nconst manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. RECIPES\n// ─────────────────────────────────────────────────────────────────────────────\n\n// The recipe folders, not every entry beside them: this script lives in the same folder.\nfunction fixtureNames() {\n  return fs.readdirSync(FIXTURES, { withFileTypes: true })\n    .filter((entry) => entry.isDirectory())\n    .map((entry) => entry.name)\n    .sort();\n}\n\nfunction loadRecipe(name) {\n  return JSON.parse(fs.readFileSync(path.join(FIXTURES, name, 'fixture.json'), 'utf8'));\nabsent\nadopted\nclaude-only\ncompose-fixture.cjs\nforeign\nforked\nover-budget\npure\nshadowed-pin\nstale\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env node\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Shipped Instruction Fixture Composer\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// A fixture is a recipe, not a tree. A committed copy of the composed tree would put the\n// shipped template into the repository a second time: its relative links would resolve\n// from the fixture folder rather than the root, a runtime that loads nested instruction\n// files would read it as some repository's own document, and every template edit would\n// force a regeneration commit. So each folder here holds only `fixture.json`, and the\n// tree it describes is composed on demand into a folder the caller throws away.\n//\n// Composition reads the manifest the template ships, never a stored copy of it, so a\n// fixture is a statement about what is shipped today. That is also why a fixture cannot\n// describe a template the manifest does not ship: the bodies come from the manifest's\n// derived sections and its release history, the block shape from the manifest's markers,\n// and the two runtime mirrors from the generators that own them.\n//\n// Composing by hand is supported, because \"run the check against this defect\" is the\n// first thing a reader wants to do with a fixture:\n//\n// Usage: compose-fixture.cjs <fixture> <empty-folder>\n//   <fixture>       one of the folder names beside this script\n//   <empty-folder>  created if absent, refused when it already holds anything\n// Exit codes: 0 composed, 2 bad arguments or a folder it must not write into\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst SCRIPTS_DIR = path.resolve(__dirname, '../../..');\nconst REPO_ROOT = path.resolve(SCRIPTS_DIR, '../../../..');\nconst FIXTURES = __dirname;\nconst MANIFEST_PATH = path.join(SCRIPTS_DIR, '../assets/agents-md-manifest.json');\nconst POINTER_SYNC = path.join(\n  REPO_ROOT,\n  '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n);\n\nconst { TARGETS, applyBlock, readGateOneLine, renderBlock } = require(POINTER_SYNC);\n\nconst TAG = '[compose-fixture]';\nconst USAGE = `Usage: node ${path.relative(REPO_ROOT, __filename)} <fixture> <empty-folder>`;\n\nconst manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. RECIPES\n// ─────────────────────────────────────────────────────────────────────────────\n\n// The recipe folders, not every entry beside them: this script lives in the same folder.\nfunction fixtureNames() {\n  return fs.readdirSync(FIXTURES, { withFileTypes: true })\n    .filter((entry) => entry.isDirectory())\n    .map((entry) => entry.name)\n    .sort();\n}\n\nfunction loadRecipe(name) {\n  return JSON.parse(fs.readFileSync(path.join(FIXTURES, name, 'fixture.json'), 'utf8'));\nabsent\nadopted\nclaude-only\ncompose-fixture.cjs\nforeign\nforked\nover-budget\npure\nshadowed-pin\nstale\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,60p' .skilled/commands/doctor/scripts/tests/fixtures/agents-md/compose-fixture.cjs; ls .skilled/commands/doctor/scripts/tests/fixtures/agents-md\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794559008110,"end":1794559008809}}}}
