onst payload = eventPayloadFrom(input);\n./.opencode/plugins/system-dist-freshness-guard.js:82:  const payload = eventPayloadFrom(input);\n./.opencode/plugins/opencode-goal.js:703:function eventPayloadFrom(event) {\n./.opencode/plugins/opencode-goal.js:709:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:714:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:719:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:741:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:762:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:776:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:970:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:997:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:1122:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:1141:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/codex-hooks-watchdog.js:31:function eventPayloadFrom(input) {\n./.opencode/plugins/codex-hooks-watchdog.js:38:  const payload = eventPayloadFrom(input);\n./.opencode/plugins/codex-hooks-watchdog.js:43:  const payload = eventPayloadFrom(input);\n./specs/hooks-plugins-extensions/hook-injection-pipeline/002-injection-bloat-reduction/018-fix-code-review-p0-p3-findings-for-directive-lifecycle-delivery/evidence/inventory/lifecycle-producers-consumers.txt:8:.opencode/plugins/mk-skill-advisor.js:1259:          state.directiveDedupBySession.delete(sessionIdFrom(eventPayload));\n./specs/system-deep-loop/loop-architecture/001-deep-loop-innovation/006-runtime-docs-and-integrity-hardening/003-artifact-certificate-binding/t001-disposition.md:47:| **F-007-02** | `deep-improvement-common-certificates.ts:630` (`assertArtifactOrigin`, 630-644) | **CONFIRMED-REAL** (exact binding target is a minor design choice) | `const origin = verified.material.originEvent; const event = findEvent(ledgerEvents, origin.eventId); const payload = eventPayload(event); if (payload.stem !== origin.eventStem \\|\\| payload.payloadDigest !== origin.payloadDigest) throw`. Binding type is `{eventStem,eventId,payloadDigest}` (`sealed-artifact-types.ts:68-72`) — no scope. The check resolves a named event by id + stem + self-reported `payloadDigest`, but never binds the origin event to **this artifact's own identity** (`verified.binding.reference.qualified_digest`) nor verifies the event actually sealed this artifact. **Decoy:** artifact A names `originEvent = {eventId: E_b, stem: S, payloadDigest: D_b}` where `E_b` is a *different* artifact B's event (same stem/payloadDigest in range) → A's origin \"validates\" against B's event. `findEvent` confines it to the covered range (cross-run blocked), but cross-artifact within the run is not. |\n./.skilled/commands/doctor/assets/doctor-symlink-check.yaml:37:  hook_wiring: \".skilled/commands/doctor/scripts/hook-wiring-check.cjs\"\n./.skilled/commands/doctor/assets/doctor-symlink-check.yaml:60:    - 'After the engine report, run node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \"{root}\" to read the prompt hook entry each installed runtime loads. It skips a runtime whose folder is absent. Show every hook-missing <runtime> line as printed. Exit 0 leaves the status unchanged. Exit 1 ends the run with STATUS=WARN and names the repair: copy the prompt hook entry from the matching file in the Skilled checkout into the target file for that runtime. Exit 2 means the check was refused: quote its message and end with STATUS=FAIL.'\n./.skilled/commands/doctor/assets/doctor-setup.yaml:40:  hook_wiring_check: \".skilled/commands/doctor/scripts/hook-wiring-check.cjs\"\n./.skilled/commands/doctor/assets/doctor-setup.yaml:61:    - \"Leg delivery: run node .skilled/commands/doctor/scripts/hook-wiring-check.cjs --root \\\"$PWD\\\" and node .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs --root \\\"$PWD\\\", and show each line they print under the leg. Both exit 0 is PASS. A hook-missing line is DEGRADED, with repair /doctor:runtime-mirrors in a Skilled checkout or /doctor:symlink check in a linked project. WARN codex-hooks-unapproved is DEGRADED, with the repair line the check printed. WARN codex-advisor-hook-absent is DEGRADED, with the repair line the check printed. Exit 2 from either check is ERROR. This leg is never FAIL, because a hook that is not wired or not approved stops the brief, not the install.\"\n./.skilled/commands/doctor/scripts/README.markdown:48:+-- hook-wiring-check.cjs\n./.skilled/commands/doctor/scripts/README.markdown:112:| `hook-wiring-check.cjs` | The read-only hook-wiring check: it reads `.claude/settings.json`, `.codex/hooks.json`, `.cursor/hooks.json` and `.devin/hooks.v1.json`, and reports whether the prompt hook entry is present for each runtime folder it finds. `--root <dir>` is required and `--json` prints one object. It prints `ok <runtime>` or `hook-missing <runtime> <file>`, skips a runtime whose folder is absent and never writes. It exits 0 when every installed runtime is wired, 1 when one is missing and 2 on a bad argument or a missing root. |\n./.skilled/commands/doctor/scripts/README.markdown:235:| `hook-wiring-check.cjs` | Read-only over any root. It writes no file and runs no installer, and its JSON form reports the same readings as its lines. It exits 0 when every installed runtime carries its entry, 1 when one is missing and 2 on a bad argument or a missing root. |\n./.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs:21:const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"./.opencode/plugins/system-spec-gate.js:123:function eventPayloadFrom(input) {\n./.opencode/plugins/system-spec-gate.js:130:  const payload = eventPayloadFrom(input);\n./.opencode/plugins/system-spec-gate.js:135:  const payload = eventPayloadFrom(input);\n./.opencode/plugins/system-skill-advisor.js:893:function eventPayloadFrom(event) {\n./.opencode/plugins/system-skill-advisor.js:901:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/system-skill-advisor.js:1634:      const eventPayload = eventPayloadFrom(event);\n./.opencode/plugins/system-skill-advisor.js:1641:          const identity = advanceOpenCodeDirectiveBoundary(state, eventPayload);\n./.opencode/plugins/system-skill-advisor.js:1644:            eventPayload,\n./.opencode/plugins/system-skill-advisor.js:1656:        const identity = advanceOpenCodeDirectiveBoundary(state, eventPayload);\n./.opencode/plugins/system-skill-advisor.js:1662:            eventPayload,\n./.opencode/plugins/system-skill-advisor.js:1664:            lifecycleEventFrom(eventPayload, eventType),\n./.opencode/plugins/system-skill-advisor.js:1672:        const identity = advanceOpenCodeDirectiveBoundary(state, eventPayload);\n./.opencode/plugins/system-skill-advisor.js:1679:          await observeShadowDeliveryForRuntime(null, eventPayload, sessionID, 'compact', false);\n./.opencode/plugins/system-dist-freshness-guard.js:70:function eventPayloadFrom(input) {\n./.opencode/plugins/system-dist-freshness-guard.js:77:  const payload = eventPayloadFrom(input);\n./.opencode/plugins/system-dist-freshness-guard.js:82:  const payload = eventPayloadFrom(input);\n./.opencode/plugins/opencode-goal.js:703:function eventPayloadFrom(event) {\n./.opencode/plugins/opencode-goal.js:709:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:714:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:719:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:741:  const payload = eventPayloadFrom(event);\n./.opencode/plugins/opencode-goal.js:762:  const payload = eventPayloadFrom(event);\n./.opencode/plugin