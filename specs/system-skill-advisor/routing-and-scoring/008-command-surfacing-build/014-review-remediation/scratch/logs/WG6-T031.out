{"type":"tool_use","timestamp":1794558961337,"sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","part":{"partID":"prt_1d40ca4c8002sj5TU9rWvr0Pf2","sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","messageID":"msg_1d40c9d35001muiw8krSMPfJFy","type":"tool","id":"call_491e523b02cd4320859e3275","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-79\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: \n25: function fixture(t) {\n26:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n27:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n28:   const run = (...args) => {\n29:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n30:     return { code: result.status, out: result.stdout, err: result.stderr };\n31:   };\n32:   return { root, run };\n33: }\n34: \n35: function writeClaudeSettings(root, hooks) {\n36:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n37:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n38: }\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 2. TESTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: test('names a runtime whose prompt entry is absent', (t) => {\n45:   const f = fixture(t);\n46:   writeClaudeSettings(f.root, {\n47:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n48:   });\n49:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n50:   const result = f.run();\n51:   assert.equal(result.code, 1);\n52:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n53:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n54: });\n55: \n56: test('passes a runtime whose prompt entry is wired', (t) => {\n57:   const f = fixture(t);\n58:   writeClaudeSettings(f.root, {\n59:     UserPromptSubmit: [{\n60:       hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n61:     }],\n62:   });\n63:   const text = f.run();\n64:   assert.equal(text.code, 0);\n65:   assert.equal(text.out.trim(), 'ok claude');\n66:   const json = f.run('--json');\n67:   assert.equal(json.code, 0);\n68:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n69: });\n70: \n71: test('skips a runtime whose folder is absent', (t) => {\n72:   const f = fixture(t);\n73:   const text = f.run();\n74:   assert.equal(text.code, 0);\n75:   assert.equal(text.out, '');\n76:   const json = f.run('--json');\n77:   assert.equal(json.code, 0);\n78:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n79: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs, lines 1-79\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Drives the hook wiring check as a process against throwaway checkouts. The\n8: // cases pin both verdicts and the checkout that has no runtime folder at all.\n9: \n10: // ─────────────────────────────────────────────────────────────────────────────\n11: // 1. IMPORTS AND FIXTURES\n12: // ─────────────────────────────────────────────────────────────────────────────\n13: \n14: const assert = require('node:assert/strict');\n15: const { spawnSync } = require('node:child_process');\n16: const fs = require('node:fs');\n17: const os = require('node:os');\n18: const path = require('node:path');\n19: const test = require('node:test');\n20: \n21: const SCRIPT = path.resolve(__dirname, '..', 'hook-wiring-check.cjs');\n22: const CLAUDE_FILE = '.claude/settings.json';\n23: const CLAUDE_MARKER = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n24: \n25: function fixture(t) {\n26:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hook-wiring-check-'));\n27:   t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n28:   const run = (...args) => {\n29:     const result = spawnSync(process.execPath, [SCRIPT, '--root', root, ...args], { encoding: 'utf8' });\n30:     return { code: result.status, out: result.stdout, err: result.stderr };\n31:   };\n32:   return { root, run };\n33: }\n34: \n35: function writeClaudeSettings(root, hooks) {\n36:   fs.mkdirSync(path.join(root, '.claude'), { recursive: true });\n37:   fs.writeFileSync(path.join(root, CLAUDE_FILE), JSON.stringify({ hooks }, null, 2));\n38: }\n39: \n40: // ─────────────────────────────────────────────────────────────────────────────\n41: // 2. TESTS\n42: // ─────────────────────────────────────────────────────────────────────────────\n43: \n44: test('names a runtime whose prompt entry is absent', (t) => {\n45:   const f = fixture(t);\n46:   writeClaudeSettings(f.root, {\n47:     UserPromptSubmit: [{ hooks: [{ type: 'command', command: 'node some-other-hook.js' }] }],\n48:   });\n49:   const before = fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8');\n50:   const result = f.run();\n51:   assert.equal(result.code, 1);\n52:   assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n53:   assert.equal(fs.readFileSync(path.join(f.root, CLAUDE_FILE), 'utf8'), before, 'check changed the hook file');\n54: });\n55: \n56: test('passes a runtime whose prompt entry is wired', (t) => {\n57:   const f = fixture(t);\n58:   writeClaudeSettings(f.root, {\n59:     UserPromptSubmit: [{\n60:       hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n61:     }],\n62:   });\n63:   const text = f.run();\n64:   assert.equal(text.code, 0);\n65:   assert.equal(text.out.trim(), 'ok claude');\n66:   const json = f.run('--json');\n67:   assert.equal(json.code, 0);\n68:   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n69: });\n70: \n71: test('skips a runtime whose folder is absent', (t) => {\n72:   const f = fixture(t);\n73:   const text = f.run();\n74:   assert.equal(text.code, 0);\n75:   assert.equal(text.out, '');\n76:   const json = f.run('--json');\n77:   assert.equal(json.code, 0);\n78:   assert.deepEqual(JSON.parse(json.out).checks.map((check) => check.status), ['skipped', 'skipped', 'skipped', 'skipped']);\n79: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\"}"},"time":{"start":1794558960840,"end":1794558961337}}}}
