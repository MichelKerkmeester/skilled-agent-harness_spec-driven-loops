\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"it\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"in\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"check\"\n    }\n  ],\n  \"indexHash\": \"5069fc64e90403be8084b1daebc6506961222ed1377c36915b78c90e658b1108\",\n  \"manifestHash\": \"6c56dc075a672ad457f5a60f86ef4ad3b7f334987d327271f365568a027e9e45\",\n  \"normalizedQuery\": \"count a hook as wired only when a command runs it in hook wiring check\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"count\",\n    \"hook\",\n    \"wired\",\n    \"only\",\n    \"when\",\n    \"command\",\n    \"runs\",\n    \"wiring\"\n  ],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"count a hook as wired only when a command runs it in hook-wiring-check\\\" 2>&1 | head -40\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794558955494,"end":1794558956961}}}}
