{"type":"tool_use","timestamp":1794559076738,"sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","part":{"partID":"prt_1d40e63bb001sM20TaPpTygGJz","sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","messageID":"msg_1d40e4ca00011iK7LIR4ebLs9Z","type":"tool","id":"call_4295ef36f6754e818ae2e20f","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/commands/doctor/scripts/hook-wiring-check.cjs .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\nindex ab63923ef3..caf1a297b1 100644\n--- a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n+++ b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n@@ -100,8 +100,9 @@ function parseArgs(argv) {\n \n // Hook files either wrap their events in a `hooks` object or place them at the\n // top level, and the cursor file omits the nested hook array the others carry.\n-// Searching the event payload's JSON text covers all three shapes without\n-// teaching this check each dialect.\n+// A mention is not a wired hook, so only a command that runs the script counts:\n+// the event's entries and their nested hooks arrays are walked for command\n+// entries, and a runtime is wired when one starts node on the marker path.\n function eventPayload(document, event) {\n   if (!document || typeof document !== 'object') return undefined;\n   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n@@ -111,6 +112,25 @@ function eventPayload(document, event) {\n   return undefined;\n }\n \n+function stripQuotes(token) {\n+  return token.replace(/^['\"]+|['\"]+$/g, '');\n+}\n+\n+function collectCommands(node, commands) {\n+  if (Array.isArray(node)) {\n+    for (const entry of node) collectCommands(entry, commands);\n+  } else if (node && typeof node === 'object') {\n+    if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n+    if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n+  }\n+  return commands;\n+}\n+\n+function runsMarker(command, marker) {\n+  const tokens = command.split(/\\s+/).map(stripQuotes);\n+  return tokens.some((token, index) => token === 'node' && (tokens[index + 1] || '').endsWith(marker));\n+}\n+\n function inspect(runtime, root) {\n   const file = path.join(root, runtime.file);\n   let document;\n@@ -120,7 +140,7 @@ function inspect(runtime, root) {\n     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n   }\n   const payload = eventPayload(document, runtime.event);\n-  const wired = payload !== undefined && JSON.stringify(payload).includes(runtime.marker);\n+  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n }\n \ndiff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex 13bb2db895..f3c16d3e09 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -57,7 +57,7 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   const f = fixture(t);\n   writeClaudeSettings(f.root, {\n     UserPromptSubmit: [{\n-      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n+      hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n     }],\n   });\n   const text = f.run();\n@@ -68,6 +68,34 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n });\n \n+test('names a runtime whose entry only echoes the script path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n+test('names a runtime whose entry only describes the script', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{\n+        type: 'command',\n+        command: 'node some-other-hook.js',\n+        description: 'hooks/claude/user-prompt-submit.js',\n+      }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n test('skips a runtime whose folder is absent', (t) => {\n   const f = fixture(t);\n   const text = f.run();\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\nindex ab63923ef3..caf1a297b1 100644\n--- a/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n+++ b/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\n@@ -100,8 +100,9 @@ function parseArgs(argv) {\n \n // Hook files either wrap their events in a `hooks` object or place them at the\n // top level, and the cursor file omits the nested hook array the others carry.\n-// Searching the event payload's JSON text covers all three shapes without\n-// teaching this check each dialect.\n+// A mention is not a wired hook, so only a command that runs the script counts:\n+// the event's entries and their nested hooks arrays are walked for command\n+// entries, and a runtime is wired when one starts node on the marker path.\n function eventPayload(document, event) {\n   if (!document || typeof document !== 'object') return undefined;\n   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n@@ -111,6 +112,25 @@ function eventPayload(document, event) {\n   return undefined;\n }\n \n+function stripQuotes(token) {\n+  return token.replace(/^['\"]+|['\"]+$/g, '');\n+}\n+\n+function collectCommands(node, commands) {\n+  if (Array.isArray(node)) {\n+    for (const entry of node) collectCommands(entry, commands);\n+  } else if (node && typeof node === 'object') {\n+    if (node.type === 'command' && typeof node.command === 'string') commands.push(node.command);\n+    if (Array.isArray(node.hooks)) collectCommands(node.hooks, commands);\n+  }\n+  return commands;\n+}\n+\n+function runsMarker(command, marker) {\n+  const tokens = command.split(/\\s+/).map(stripQuotes);\n+  return tokens.some((token, index) => token === 'node' && (tokens[index + 1] || '').endsWith(marker));\n+}\n+\n function inspect(runtime, root) {\n   const file = path.join(root, runtime.file);\n   let document;\n@@ -120,7 +140,7 @@ function inspect(runtime, root) {\n     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n   }\n   const payload = eventPayload(document, runtime.event);\n-  const wired = payload !== undefined && JSON.stringify(payload).includes(runtime.marker);\n+  const wired = collectCommands(payload, []).some((command) => runsMarker(command, runtime.marker));\n   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n }\n \ndiff --git a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\nindex 13bb2db895..f3c16d3e09 100644\n--- a/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n+++ b/.skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n@@ -57,7 +57,7 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   const f = fixture(t);\n   writeClaudeSettings(f.root, {\n     UserPromptSubmit: [{\n-      hooks: [{ type: 'command', command: `node ${CLAUDE_MARKER}` }],\n+      hooks: [{ type: 'command', command: `bash -c 'cd \"$PWD\" && node ${CLAUDE_MARKER}'` }],\n     }],\n   });\n   const text = f.run();\n@@ -68,6 +68,34 @@ test('passes a runtime whose prompt entry is wired', (t) => {\n   assert.equal(JSON.parse(json.out).checks.find((check) => check.runtime === 'claude').status, 'ok');\n });\n \n+test('names a runtime whose entry only echoes the script path', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{ type: 'command', command: 'echo hooks/claude/user-prompt-submit.js' }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n+test('names a runtime whose entry only describes the script', (t) => {\n+  const f = fixture(t);\n+  writeClaudeSettings(f.root, {\n+    UserPromptSubmit: [{\n+      hooks: [{\n+        type: 'command',\n+        command: 'node some-other-hook.js',\n+        description: 'hooks/claude/user-prompt-submit.js',\n+      }],\n+    }],\n+  });\n+  const result = f.run();\n+  assert.equal(result.code, 1);\n+  assert.match(result.out, /^hook-missing claude \\.claude\\/settings\\.json$/m);\n+});\n+\n test('skips a runtime whose folder is absent', (t) => {\n   const f = fixture(t);\n   const text = f.run();\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/commands/doctor/scripts/hook-wiring-check.cjs .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794559075259,"end":1794559076738}}}}
{"type":"tool_use","timestamp":1794559076765,"sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","part":{"partID":"prt_1d40e664b001IoVCfDWyDtrf6o","sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","messageID":"msg_1d40e4ca00011iK7LIR4ebLs9Z","type":"tool","id":"call_cf77ef332e1f42b38376d72e","tool":"shell","state":{"status":"completed","input":{"command":"node --check .skilled/commands/doctor/scripts/hook-wiring-check.cjs && echo \"check ok\"; git -c core.fsmonitor=false status --short -- .skilled/commands/doctor/scripts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"check ok\n M .skilled/commands/doctor/scripts/agents-md-check.cjs\n M .skilled/commands/doctor/scripts/agents-md-embed.cjs\n M .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n M .skilled/commands/doctor/scripts/hook-wiring-check.cjs\n M .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n M .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n M .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n?? .skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"check ok\n M .skilled/commands/doctor/scripts/agents-md-check.cjs\n M .skilled/commands/doctor/scripts/agents-md-embed.cjs\n M .skilled/commands/doctor/scripts/codex-hook-approval-check.cjs\n M .skilled/commands/doctor/scripts/hook-wiring-check.cjs\n M .skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/agents-md-embed.test.cjs\n M .skilled/commands/doctor/scripts/tests/codex-hook-approval-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\n M .skilled/commands/doctor/scripts/tests/hook-wiring-check.test.cjs\n M .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n?? .skilled/commands/doctor/scripts/tests/doctor-setup-contract.test.cjs\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node --check .skilled/commands/doctor/scripts/hook-wiring-check.cjs && echo \\\"check ok\\\"; git -c core.fsmonitor=false status --short -- .skilled/commands/doctor/scripts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794559075915,"end":1794559076765}}}}
