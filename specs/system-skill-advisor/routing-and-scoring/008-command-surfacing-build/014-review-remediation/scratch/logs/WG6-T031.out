{"type":"tool_use","timestamp":1794558956726,"sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","part":{"partID":"prt_1d40c932e001xG0hFPqvBgo4XP","sessionID":"ses_e2bf3ca40ffeo8xe1K4g3dtqVO","messageID":"msg_1d40c6df50010z2bIL24adrlDC","type":"tool","id":"call_850267eef1d6490fb2f091c8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 1-161\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n8: //\n9: // WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n10: // entry a runtime fires before the model sees that prompt. A runtime folder can be\n11: // installed while its hook file is missing, its JSON is unreadable, or the entry\n12: // was never added, and then the advisor is silent with no error at session start.\n13: // This check names the runtime and the file to repair.\n14: //\n15: // Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n16: // is missing, 2 on a bad argument or a missing root.\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const USAGE = [\n30:   'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n31:   '  --root  check the checkout under <dir>.',\n32:   '  --json  print one JSON object instead of one line per runtime.',\n33: ].join('\\n');\n34: \n35: // Each entry names the runtime folder that decides whether the check applies,\n36: // the hook file inside it, the event that carries the prompt entry, and the path\n37: // fragment whose presence proves the entry is wired. A runtime folder that is\n38: // absent is skipped, because that runtime was never installed in this checkout.\n39: const RUNTIMES = [\n40:   {\n41:     id: 'claude',\n42:     dir: '.claude',\n43:     file: '.claude/settings.json',\n44:     event: 'UserPromptSubmit',\n45:     marker: 'hooks/claude/user-prompt-submit.js',\n46:   },\n47:   {\n48:     id: 'codex',\n49:     dir: '.codex',\n50:     file: '.codex/hooks.json',\n51:     event: 'UserPromptSubmit',\n52:     marker: 'hooks/codex/user-prompt-submit.js',\n53:   },\n54:   {\n55:     id: 'cursor',\n56:     dir: '.cursor',\n57:     file: '.cursor/hooks.json',\n58:     event: 'beforeSubmitPrompt',\n59:     marker: 'hooks/cursor/user-prompt-submit.js',\n60:   },\n61:   {\n62:     id: 'devin',\n63:     dir: '.devin',\n64:     file: '.devin/hooks.v1.json',\n65:     event: 'UserPromptSubmit',\n66:     marker: 'hooks/devin/user-prompt-submit.js',\n67:   },\n68: ];\n69: \n70: // ─────────────────────────────────────────────────────────────────────────────\n71: // 3. HELPERS\n72: // ─────────────────────────────────────────────────────────────────────────────\n73: \n74: function fail(message) {\n75:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n76:   process.exit(2);\n77: }\n78: \n79: function parseArgs(argv) {\n80:   const opts = { root: null, json: false };\n81:   for (let i = 0; i < argv.length; i += 1) {\n82:     const arg = argv[i];\n83:     if (arg === '--json') {\n84:       opts.json = true;\n85:     } else if (arg === '--root') {\n86:       const value = argv[i + 1];\n87:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n88:       opts.root = path.resolve(value);\n89:       i += 1;\n90:     } else {\n91:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n92:     }\n93:   }\n94:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n95:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n96:     fail(`root not found: ${opts.root}`);\n97:   }\n98:   return opts;\n99: }\n100: \n101: // Hook files either wrap their events in a `hooks` object or place them at the\n102: // top level, and the cursor file omits the nested hook array the others carry.\n103: // Searching the event payload's JSON text covers all three shapes without\n104: // teaching this check each dialect.\n105: function eventPayload(document, event) {\n106:   if (!document || typeof document !== 'object') return undefined;\n107:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n108:     return document.hooks[event];\n109:   }\n110:   if (event in document) return document[event];\n111:   return undefined;\n112: }\n113: \n114: function inspect(runtime, root) {\n115:   const file = path.join(root, runtime.file);\n116:   let document;\n117:   try {\n118:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n119:   } catch {\n120:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n121:   }\n122:   const payload = eventPayload(document, runtime.event);\n123:   const wired = payload !== undefined && JSON.stringify(payload).includes(runtime.marker);\n124:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n125: }\n126: \n127: // ─────────────────────────────────────────────────────────────────────────────\n128: // 4. MAIN\n129: // ─────────────────────────────────────────────────────────────────────────────\n130: \n131: function main(argv) {\n132:   const opts = parseArgs(argv);\n133:   const checks = RUNTIMES.map((runtime) => {\n134:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n135:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n136:     }\n137:     return inspect(runtime, opts.root);\n138:   });\n139: \n140:   if (opts.json) {\n141:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n142:   } else {\n143:     for (const check of checks) {\n144:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n145:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n146:     }\n147:   }\n148: \n149:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n150: }\n151: \n152: if (require.main === module) {\n153:   try {\n154:     process.exitCode = main(process.argv.slice(2));\n155:   } catch (err) {\n156:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n157:     process.exitCode = 2;\n158:   }\n159: }\n160: \n161: module.exports = { main, eventPayload };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs, lines 1-161\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Hook Wiring Check\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // Read-only /doctor diagnostic for the prompt hook entry each runtime loads.\n8: //\n9: // WHY THIS EXISTS: the skill advisor reaches a first prompt only through the hook\n10: // entry a runtime fires before the model sees that prompt. A runtime folder can be\n11: // installed while its hook file is missing, its JSON is unreadable, or the entry\n12: // was never added, and then the advisor is silent with no error at session start.\n13: // This check names the runtime and the file to repair.\n14: //\n15: // Never writes. Exit 0 when every installed runtime carries its entry, 1 when one\n16: // is missing, 2 on a bad argument or a missing root.\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const fs = require('node:fs');\n23: const path = require('node:path');\n24: \n25: // ─────────────────────────────────────────────────────────────────────────────\n26: // 2. CONSTANTS\n27: // ─────────────────────────────────────────────────────────────────────────────\n28: \n29: const USAGE = [\n30:   'Usage: hook-wiring-check.cjs --root <dir> [--json]',\n31:   '  --root  check the checkout under <dir>.',\n32:   '  --json  print one JSON object instead of one line per runtime.',\n33: ].join('\\n');\n34: \n35: // Each entry names the runtime folder that decides whether the check applies,\n36: // the hook file inside it, the event that carries the prompt entry, and the path\n37: // fragment whose presence proves the entry is wired. A runtime folder that is\n38: // absent is skipped, because that runtime was never installed in this checkout.\n39: const RUNTIMES = [\n40:   {\n41:     id: 'claude',\n42:     dir: '.claude',\n43:     file: '.claude/settings.json',\n44:     event: 'UserPromptSubmit',\n45:     marker: 'hooks/claude/user-prompt-submit.js',\n46:   },\n47:   {\n48:     id: 'codex',\n49:     dir: '.codex',\n50:     file: '.codex/hooks.json',\n51:     event: 'UserPromptSubmit',\n52:     marker: 'hooks/codex/user-prompt-submit.js',\n53:   },\n54:   {\n55:     id: 'cursor',\n56:     dir: '.cursor',\n57:     file: '.cursor/hooks.json',\n58:     event: 'beforeSubmitPrompt',\n59:     marker: 'hooks/cursor/user-prompt-submit.js',\n60:   },\n61:   {\n62:     id: 'devin',\n63:     dir: '.devin',\n64:     file: '.devin/hooks.v1.json',\n65:     event: 'UserPromptSubmit',\n66:     marker: 'hooks/devin/user-prompt-submit.js',\n67:   },\n68: ];\n69: \n70: // ─────────────────────────────────────────────────────────────────────────────\n71: // 3. HELPERS\n72: // ─────────────────────────────────────────────────────────────────────────────\n73: \n74: function fail(message) {\n75:   process.stderr.write(`hook-wiring-check: ${message}\\n`);\n76:   process.exit(2);\n77: }\n78: \n79: function parseArgs(argv) {\n80:   const opts = { root: null, json: false };\n81:   for (let i = 0; i < argv.length; i += 1) {\n82:     const arg = argv[i];\n83:     if (arg === '--json') {\n84:       opts.json = true;\n85:     } else if (arg === '--root') {\n86:       const value = argv[i + 1];\n87:       if (!value || value.startsWith('-')) fail(`--root needs a directory\\n${USAGE}`);\n88:       opts.root = path.resolve(value);\n89:       i += 1;\n90:     } else {\n91:       fail(`unknown argument: ${arg}\\n${USAGE}`);\n92:     }\n93:   }\n94:   if (!opts.root) fail(`--root is required\\n${USAGE}`);\n95:   if (!fs.existsSync(opts.root) || !fs.statSync(opts.root).isDirectory()) {\n96:     fail(`root not found: ${opts.root}`);\n97:   }\n98:   return opts;\n99: }\n100: \n101: // Hook files either wrap their events in a `hooks` object or place them at the\n102: // top level, and the cursor file omits the nested hook array the others carry.\n103: // Searching the event payload's JSON text covers all three shapes without\n104: // teaching this check each dialect.\n105: function eventPayload(document, event) {\n106:   if (!document || typeof document !== 'object') return undefined;\n107:   if (document.hooks && typeof document.hooks === 'object' && event in document.hooks) {\n108:     return document.hooks[event];\n109:   }\n110:   if (event in document) return document[event];\n111:   return undefined;\n112: }\n113: \n114: function inspect(runtime, root) {\n115:   const file = path.join(root, runtime.file);\n116:   let document;\n117:   try {\n118:     document = JSON.parse(fs.readFileSync(file, 'utf8'));\n119:   } catch {\n120:     return { runtime: runtime.id, file: runtime.file, status: 'hook-missing' };\n121:   }\n122:   const payload = eventPayload(document, runtime.event);\n123:   const wired = payload !== undefined && JSON.stringify(payload).includes(runtime.marker);\n124:   return { runtime: runtime.id, file: runtime.file, status: wired ? 'ok' : 'hook-missing' };\n125: }\n126: \n127: // ─────────────────────────────────────────────────────────────────────────────\n128: // 4. MAIN\n129: // ─────────────────────────────────────────────────────────────────────────────\n130: \n131: function main(argv) {\n132:   const opts = parseArgs(argv);\n133:   const checks = RUNTIMES.map((runtime) => {\n134:     if (!fs.existsSync(path.join(opts.root, runtime.dir))) {\n135:       return { runtime: runtime.id, file: runtime.file, status: 'skipped' };\n136:     }\n137:     return inspect(runtime, opts.root);\n138:   });\n139: \n140:   if (opts.json) {\n141:     process.stdout.write(`${JSON.stringify({ root: opts.root, checks }, null, 2)}\\n`);\n142:   } else {\n143:     for (const check of checks) {\n144:       if (check.status === 'ok') process.stdout.write(`ok ${check.runtime}\\n`);\n145:       else if (check.status === 'hook-missing') process.stdout.write(`hook-missing ${check.runtime} ${check.file}\\n`);\n146:     }\n147:   }\n148: \n149:   return checks.some((check) => check.status === 'hook-missing') ? 1 : 0;\n150: }\n151: \n152: if (require.main === module) {\n153:   try {\n154:     process.exitCode = main(process.argv.slice(2));\n155:   } catch (err) {\n156:     process.stderr.write(`hook-wiring-check: ${err && err.message ? err.message : String(err)}\\n`);\n157:     process.exitCode = 2;\n158:   }\n159: }\n160: \n161: module.exports = { main, eventPayload };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/hook-wiring-check.cjs\"}"},"time":{"start":1794558956334,"end":1794558956726}}}}
